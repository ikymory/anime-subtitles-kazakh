Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.97,0:00:16.89,Default,,0,0,0,,(құрылғы жұмысының дыбысы)
Dialogue: 0,0:00:49.29,0:00:50.59,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:56.01,0:00:56.93,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:57.51,0:00:58.43,Default,,0,0,0,,Осымен
Dialogue: 0,0:00:59.01,0:01:00.81,Default,,0,0,0,,Жұмыс үстеліңізден алыстап, қолыңызды көтеріңіз.
Dialogue: 0,0:01:03.22,0:01:06.81,Default,,0,0,0,,Ааа, мен сенің қимылыңды көріп тұрмын.
Dialogue: 0,0:01:15.70,0:01:16.70,Default,,0,0,0,,Ha
Dialogue: 0,0:01:20.20,0:01:21.49,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:21.58,0:01:23.62,Default,,0,0,0,,Иә! Таааа
Dialogue: 0,0:01:28.42,0:01:29.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:31.42,0:01:33.05,Default,,0,0,0,,Фуруя мырза, амансыз ба?
Dialogue: 0,0:01:33.13,0:01:34.01,Default,,0,0,0,,О
Dialogue: 0,0:01:34.09,0:01:36.59,Default,,0,0,0,,Хехехе... хахахаха
Dialogue: 0,0:01:36.67,0:01:38.26,Default,,0,0,0,,Бұл көздер, мүмкін емес
Dialogue: 0,0:01:38.34,0:01:39.59,Default,,0,0,0,,Фуруя-сан, ауысым.
Dialogue: 0,0:01:39.68,0:01:40.51,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:01:40.60,0:01:41.68,Default,,0,0,0,,Иә
Dialogue: 0,0:01:42.39,0:01:43.31,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:01:53.23,0:01:54.90,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,0:01:57.99,0:01:59.66,Default,,0,0,0,,Уау (тежегіш дыбысы)
Dialogue: 0,0:01:59.74,0:02:00.99,Default,,0,0,0,,Тоқта
Dialogue: 0,0:02:01.07,0:02:02.66,Default,,0,0,0,,Бұл қауіпті болуы мүмкін, бірақ... Уф.
Dialogue: 0,0:02:04.62,0:02:05.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:05.87,0:02:07.41,Default,,0,0,0,,Ал оған он алты жасында, Римде…
Dialogue: 0,0:02:13.13,0:02:14.46,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:02:18.51,0:02:19.34,Default,,0,0,0,,Цк
Dialogue: 0,0:02:19.43,0:02:21.39,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:02:24.97,0:02:27.31,Default,,0,0,0,,- (Күзетші) Уау - (Күзетші) Уау!
Dialogue: 0,0:02:30.77,0:02:32.06,Default,,0,0,0,,Не?
Dialogue: 0,0:02:32.61,0:02:33.52,Default,,0,0,0,,Сәлем
Dialogue: 0,0:02:51.83,0:02:52.96,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:04.18,0:03:05.35,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:03:05.97,0:03:06.93,Default,,0,0,0,,Цк
Dialogue: 0,0:03:15.73,0:03:17.15,Default,,0,0,0,,Гррр…
Dialogue: 0,0:03:22.74,0:03:23.57,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:03:25.58,0:03:26.41,Default,,0,0,0,,Ақай!
Dialogue: 0,0:03:36.92,0:03:38.17,Default,,0,0,0,,Ақай түс
Dialogue: 0,0:03:38.25,0:03:40.42,Default,,0,0,0,,Ол қоғамдық қауіпсіздікке жатады.
Dialogue: 0,0:03:51.27,0:03:52.60,Default,,0,0,0,,Ах... Уф
Dialogue: 0,0:04:01.15,0:04:02.90,Default,,0,0,0,,Ай…
Dialogue: 0,0:04:16.29,0:04:17.13,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:04:17.79,0:04:18.71,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:35.60,0:04:36.44,Default,,0,0,0,,Не!
Dialogue: 0,0:04:41.28,0:04:42.11,Default,,0,0,0,,Уф
Dialogue: 0,0:04:53.08,0:04:54.62,Default,,0,0,0,,Цк, қашып кетейін бе?
Dialogue: 0,0:04:58.88,0:04:59.79,Default,,0,0,0,,Иә
Dialogue: 0,0:05:05.09,0:05:06.09,Default,,0,0,0,,Қат!
Dialogue: 0,0:05:14.48,0:05:15.31,Default,,0,0,0,,Иә
Dialogue: 0,0:05:17.81,0:05:21.40,Default,,0,0,0,,Олар қашып құтылса, бүкіл әлем дүр сілкіндіреді.
Dialogue: 0,0:05:26.36,0:05:27.66,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:28.32,0:05:29.45,Default,,0,0,0,,(Кавабуки) Керо (Цукуёми) Хмм
Dialogue: 0,0:05:54.35,0:05:55.68,Default,,0,0,0,,Рай
Dialogue: 0,0:05:57.31,0:05:59.98,Default,,0,0,0,,Қызық, мен сені жеңемін.
Dialogue: 0,0:06:19.96,0:06:21.79,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:25.42,0:06:26.71,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:34.10,0:06:35.18,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:41.94,0:06:42.77,Default,,0,0,0,,Әй
Dialogue: 0,0:06:47.32,0:06:50.66,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:06:59.08,0:06:59.91,Default,,0,0,0,,Уф
Dialogue: 0,0:07:17.52,0:07:18.35,Default,,0,0,0,,Ах
Dialogue: 0,0:07:22.02,0:07:22.85,Default,,0,0,0,,Ақай
Dialogue: 0,0:07:23.69,0:07:24.86,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:07:25.52,0:07:28.99,Default,,0,0,0,,(Төтенше көлік сиренасы)
Dialogue: 0,0:07:29.07,0:07:29.99,Default,,0,0,0,,Ах
Dialogue: 0,0:07:41.62,0:07:42.50,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:07:43.71,0:07:45.04,Default,,0,0,0,,Екі күн бұрын банк тонаған жігіт енді автобусты ұрлап кетті.
Dialogue: 0,0:07:45.13,0:07:48.09,Default,,0,0,0,,Мен оны сағындым. Мен сізден кейін тазалауды сұраймын.
Dialogue: 0,0:07:48.17,0:07:49.01,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:07:51.59,0:07:54.18,Default,,0,0,0,,Хаха...
Dialogue: 0,0:08:06.73,0:08:12.65,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:08:15.99,0:08:16.82,Default,,0,0,0,,Ах
Dialogue: 0,0:08:17.95,0:08:20.70,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:08:20.79,0:08:24.33,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:08:24.42,0:08:30.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:32.13,0:08:37.14,Default,,0,0,0,,♪～
Dialogue: 0,0:08:51.82,0:08:54.45,Default,,0,0,0,,Мен орта мектептің детективімін, Шиничи Кудо
Dialogue: 0,0:08:54.53,0:08:56.70,Default,,0,0,0,,Бала күнгі досы және сыныптасы Ран Моримен
Dialogue: 0,0:08:56.78,0:08:58.45,Default,,0,0,0,,Ойын-сауық саябағына барыңыз
Dialogue: 0,0:08:58.53,0:08:59.91,Default,,0,0,0,,Қара киінген адам
Dialogue: 0,0:08:59.99,0:09:02.75,Default,,0,0,0,,Мен күдікті транзакцияның куәсі болдым.
Dialogue: 0,0:09:04.66,0:09:06.79,Default,,0,0,0,,Мен мәмілені қарауға берілгенмін.
Dialogue: 0,0:09:06.87,0:09:08.92,Default,,0,0,0,,Артынан келе жатқан басқа серікке.
Dialogue: 0,0:09:09.00,0:09:10.34,Default,,0,0,0,,Байқамадым
Dialogue: 0,0:09:12.55,0:09:15.38,Default,,0,0,0,,Ол кісі маған у ішті.
Dialogue: 0,0:09:15.47,0:09:17.01,Default,,0,0,0,,Мен оянғанда...
Dialogue: 0,0:09:20.81,0:09:23.14,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:09:26.19,0:09:28.81,Default,,0,0,0,,Егер олар Шиничи Кудоның тірі екенін білсе ше?
Dialogue: 0,0:09:28.90,0:09:30.31,Default,,0,0,0,,Менің өміріме жасалған тағы бір әрекет
Dialogue: 0,0:09:30.40,0:09:32.73,Default,,0,0,0,,Айналаңыздағылар үшін қауіпті
Dialogue: 0,0:09:34.57,0:09:35.53,Default,,0,0,0,,Доктор Агасаның кеңесі бойынша
Dialogue: 0,0:09:35.61,0:09:37.70,Default,,0,0,0,,Мен өзімнің шынайы тұлғамды жасыруды шештім.
Dialogue: 0,0:09:37.78,0:09:40.58,Default,,0,0,0,,Ран менің атымды сұрағанда, мен бірден
Dialogue: 0,0:09:40.66,0:09:42.83,Default,,0,0,0,,Конан Эдогава деп аталды
Dialogue: 0,0:09:42.91,0:09:44.66,Default,,0,0,0,,Өз мәліметтерін алу
Dialogue: 0,0:09:44.75,0:09:48.29,Default,,0,0,0,,Ранның үйіне көшіп келді, оның әкесі детектив болып жұмыс істейді.
Dialogue: 0,0:09:50.17,0:09:53.42,Default,,0,0,0,,Айтпақшы, менің шынайы болмысымды біреу біледі.
Dialogue: 0,0:09:53.50,0:09:55.30,Default,,0,0,0,,Дәрігерден басқалары бар.
Dialogue: 0,0:09:56.01,0:09:59.30,Default,,0,0,0,,Ай Хайбара Шын аты Шихо Мияно
Dialogue: 0,0:09:59.39,0:10:00.55,Default,,0,0,0,,Ол бастапқыда болды
Dialogue: 0,0:10:00.64,0:10:03.06,Default,,0,0,0,,Қара киінген кісілердің досы еді.
Dialogue: 0,0:10:03.14,0:10:06.73,Default,,0,0,0,,Ұйымнан қашу кезінде өз өмірін қиюға әрекеттену
Dialogue: 0,0:10:06.81,0:10:10.10,Default,,0,0,0,,Мен сияқты дәрі ішіп, денең тарылып қалды.
Dialogue: 0,0:10:18.36,0:10:20.99,Default,,0,0,0,,Қара киінген жұмбақ ұйым
Dialogue: 0,0:10:21.07,0:10:23.62,Default,,0,0,0,,Біз тек кодтық атау екенін білеміз
Dialogue: 0,0:10:23.70,0:10:26.33,Default,,0,0,0,,Бұл жай ғана спирттің атымен аталған.
Dialogue: 0,0:10:26.41,0:10:28.58,Default,,0,0,0,,Мұндай адамдардың шынайы болмысын ашу
Dialogue: 0,0:10:28.66,0:10:32.79,Default,,0,0,0,,Ұйымға өздері мүше болған жасырын тергеушілер бар.
Dialogue: 0,0:10:32.88,0:10:36.01,Default,,0,0,0,,Орталық барлау басқармасының ЦРУ агенті
Dialogue: 0,0:10:36.09,0:10:38.13,Default,,0,0,0,,Рейна Мизунаши ака Киль
Dialogue: 0,0:10:38.88,0:10:42.05,Default,,0,0,0,,Ұлттық полиция агенттігінің қауіпсіздікті жоспарлау бөліміне жатады, әдетте нөл ретінде белгілі.
Dialogue: 0,0:10:42.14,0:10:44.22,Default,,0,0,0,,Бұл Бурбон деген атпен белгілі Тоору Амуро.
Dialogue: 0,0:10:45.22,0:10:48.35,Default,,0,0,0,,Басқа көзқараспен қара киімді жасырын қуу...
Dialogue: 0,0:10:48.43,0:10:51.02,Default,,0,0,0,,Федералдық тергеу бюросы ФБР
Dialogue: 0,0:10:51.10,0:10:52.27,Default,,0,0,0,,Джеймс Блэк
Dialogue: 0,0:10:52.36,0:10:53.65,Default,,0,0,0,,Андре Камел
Dialogue: 0,0:10:53.73,0:10:55.11,Default,,0,0,0,,Джоди Стерлинг
Dialogue: 0,0:10:55.19,0:10:58.11,Default,,0,0,0,,Және Шуйчи Акай
Dialogue: 0,0:10:58.19,0:11:01.53,Default,,0,0,0,,Ол ФБР-дегі ең өткір адам және сарапшы мерген.
Dialogue: 0,0:11:01.61,0:11:03.49,Default,,0,0,0,,Шамасы, Амуро екеуінің арасында
Dialogue: 0,0:11:03.57,0:11:05.79,Default,,0,0,0,,Әдеттен тыс байланыс бар сияқты.
Dialogue: 0,0:11:06.58,0:11:08.45,Default,,0,0,0,,Кішірейсең де, миың сол күйінде қалады
Dialogue: 0,0:11:08.54,0:11:10.58,Default,,0,0,0,,Лабиринті жоқ детектив
Dialogue: 0,0:11:10.66,0:11:11.62,Default,,0,0,0,,～♪
Dialogue: 0,0:11:11.62,0:11:15.67,Default,,0,0,0,,～♪ Әрқашан бір шындық бар!
Dialogue: 0,0:11:27.10,0:11:28.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:29.23,0:11:32.44,Default,,0,0,0,,Дәрігер, бізде кәмпит таусылды.
Dialogue: 0,0:11:32.52,0:11:34.40,Default,,0,0,0,,О, сен әлі тамақ жедің бе?
Dialogue: 0,0:11:34.48,0:11:35.82,Default,,0,0,0,,Біз үшін де солай ма?
Dialogue: 0,0:11:35.90,0:11:38.03,Default,,0,0,0,,Хаха жаман жаман
Dialogue: 0,0:11:38.11,0:11:39.32,Default,,0,0,0,,Тіпті барлығы үшін
Dialogue: 0,0:11:38.11,0:11:39.32,Default,,0,0,0,,Сіз нені мұқият қарап отырсыз?
Dialogue: 0,0:11:39.32,0:11:39.40,Default,,0,0,0,,Сіз нені мұқият қарап отырсыз?
Dialogue: 0,0:11:39.40,0:11:40.74,Default,,0,0,0,,Сіз нені мұқият қарап отырсыз?
Dialogue: 0,0:11:39.40,0:11:40.74,Default,,0,0,0,,Мен саған айттым.
Dialogue: 0,0:11:40.74,0:11:40.82,Default,,0,0,0,,Сіз нені мұқият қарап отырсыз?
Dialogue: 0,0:11:40.82,0:11:41.99,Default,,0,0,0,,Сіз нені мұқият қарап отырсыз?
Dialogue: 0,0:11:40.82,0:11:41.99,Default,,0,0,0,,Біз жақында келеміз.
Dialogue: 0,0:11:42.07,0:11:42.49,Default,,0,0,0,,Бұлай ашуланба.
Dialogue: 0,0:11:42.49,0:11:43.82,Default,,0,0,0,,Бұлай ашуланба.
Dialogue: 0,0:11:42.49,0:11:43.82,Default,,0,0,0,,Юбедегі ауқымды электр қуатын өшіру себебі әлі жарияланған жоқ.
Dialogue: 0,0:11:43.82,0:11:45.78,Default,,0,0,0,,Юбедегі ауқымды электр қуатын өшіру себебі әлі жарияланған жоқ.
Dialogue: 0,0:11:45.87,0:11:47.58,Default,,0,0,0,,Жаңалықты естігенде біртүрлі екен деп ойладым.
Dialogue: 0,0:11:47.66,0:11:48.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:48.83,0:11:51.79,Default,,0,0,0,,Біз баратын аквариумдарға арнайы мүмкіндік жасап жатырмыз.
Dialogue: 0,0:11:51.87,0:11:54.63,Default,,0,0,0,,Не? Маған көрсетіңіз, Конан-кун.
Dialogue: 0,0:11:54.71,0:11:56.92,Default,,0,0,0,,-Ах - (Гента) Маған да көрсетші...
Dialogue: 0,0:11:56.92,0:11:57.59,Default,,0,0,0,,-Ах - (Гента) Маған да көрсетші...
Dialogue: 0,0:11:56.92,0:11:57.59,Default,,0,0,0,,Тото аквариумы
Dialogue: 0,0:11:57.59,0:11:57.67,Default,,0,0,0,,Тото аквариумы
Dialogue: 0,0:11:57.67,0:11:58.63,Default,,0,0,0,,Бұл Тото аквариумы.
Dialogue: 0,0:11:57.67,0:11:58.63,Default,,0,0,0,,Бұл белбеу кедергі.
Dialogue: 0,0:11:58.63,0:11:59.30,Default,,0,0,0,,Бұл белдік жолда тұр.
Dialogue: 0,0:11:59.38,0:12:01.13,Default,,0,0,0,,Толық жаңартуға байланысты
Dialogue: 0,0:11:59.38,0:12:01.13,Default,,0,0,0,,Көлік жүргізу кезінде бұны алып тастамаңыз.
Dialogue: 0,0:12:01.13,0:12:01.22,Default,,0,0,0,,Көлік жүргізу кезінде бұны алып тастамаңыз.
Dialogue: 0,0:12:01.22,0:12:02.26,Default,,0,0,0,,Көлік жүргізу кезінде бұны алып тастамаңыз.
Dialogue: 0,0:12:01.22,0:12:02.26,Default,,0,0,0,,Мен былтырдан бері жабылдым.
Dialogue: 0,0:12:02.26,0:12:02.34,Default,,0,0,0,,Мен былтырдан бері жабылдым.
Dialogue: 0,0:12:02.34,0:12:03.01,Default,,0,0,0,,Өткен жылдан бастап жабылды.
Dialogue: 0,0:12:02.34,0:12:03.01,Default,,0,0,0,,Тексеріңіз, бұл қызықсыз.
Dialogue: 0,0:12:03.01,0:12:03.09,Default,,0,0,0,,Тексеріңіз, бұл қызықсыз.
Dialogue: 0,0:12:03.09,0:12:04.26,Default,,0,0,0,,Тексеріңіз, бұл қызықсыз.
Dialogue: 0,0:12:03.09,0:12:04.26,Default,,0,0,0,,Бүгіннен бастап ашылады дейді.
Dialogue: 0,0:12:04.26,0:12:04.34,Default,,0,0,0,,Бүгіннен бастап ашылады.
Dialogue: 0,0:12:04.34,0:12:05.18,Default,,0,0,0,,Бүгіннен бастап ашылады дейді.
Dialogue: 0,0:12:04.34,0:12:05.18,Default,,0,0,0,,Біз жақында келеміз, сондықтан шыдамды болыңыз, Гента-кун.
Dialogue: 0,0:12:05.18,0:12:05.26,Default,,0,0,0,,Біз жақында келеміз, сондықтан шыдамды болыңыз, Гента-кун.
Dialogue: 0,0:12:05.26,0:12:08.39,Default,,0,0,0,,Біз жақында келеміз, сондықтан шыдамды болыңыз, Гента-кун.
Dialogue: 0,0:12:05.26,0:12:08.39,Default,,0,0,0,,Біз сізге соңғы ақпаратты береміз
Dialogue: 0,0:12:08.47,0:12:08.97,Default,,0,0,0,,А, басталды.
Dialogue: 0,0:12:08.97,0:12:10.22,Default,,0,0,0,,А, басталды.
Dialogue: 0,0:12:08.97,0:12:10.22,Default,,0,0,0,,Сонымен, бұл жолы
Dialogue: 0,0:12:10.22,0:12:10.31,Default,,0,0,0,,А, басталды.
Dialogue: 0,0:12:10.31,0:12:10.85,Default,,0,0,0,,А, басталды.
Dialogue: 0,0:12:10.31,0:12:10.85,Default,,0,0,0,,Қайта ашылғанда
Dialogue: 0,0:12:10.85,0:12:11.52,Default,,0,0,0,,Қайта ашылғанда
Dialogue: 0,0:12:11.60,0:12:13.60,Default,,0,0,0,,Елеулі өзгерген ерекшеліктер
Dialogue: 0,0:12:13.69,0:12:15.77,Default,,0,0,0,,Бейнеролик арқылы таныстырайық
Dialogue: 0,0:12:16.69,0:12:20.86,Default,,0,0,0,,Осы жаңарумен бірге дамыған үш тармақ бар.
Dialogue: 0,0:12:20.94,0:12:22.78,Default,,0,0,0,,Ең алдымен назар аударғаныңызды қалаймын
Dialogue: 0,0:12:22.86,0:12:27.87,Default,,0,0,0,,Барлық ойын-сауық орындары мен әртүрлі дүкендер жабық жерде орналастырылды.
Dialogue: 0,0:12:27.95,0:12:30.75,Default,,0,0,0,,Осылайша ауа-райы туралы алаңдамайсыз.
Dialogue: 0,0:12:30.83,0:12:33.33,Default,,0,0,0,,Ашылғаннан жабылғанға дейінгі барлық нысандар
Dialogue: 0,0:12:33.41,0:12:36.63,Default,,0,0,0,,Енді сіз оны қанағаттанарлықтай аласыз.
Dialogue: 0,0:12:37.13,0:12:39.42,Default,,0,0,0,,Келесі ескерте кететін мәселе
Dialogue: 0,0:12:39.50,0:12:41.71,Default,,0,0,0,,Бұл аквариумның ең жақсы сатылатын жері:
Dialogue: 0,0:12:41.80,0:12:44.63,Default,,0,0,0,,Дельфиндердің керемет шоуы
Dialogue: 0,0:12:45.09,0:12:47.26,Default,,0,0,0,,Бұл біраз уақыттан бері танымал аттракцион болды.
Dialogue: 0,0:12:47.34,0:12:49.51,Default,,0,0,0,,Жаңа шоу мазмұны
Dialogue: 0,0:12:49.60,0:12:52.52,Default,,0,0,0,,Дельфиндер өз өнерлерін одан әрі жетілдіріп, бізге береді
Dialogue: 0,0:12:52.60,0:12:55.77,Default,,0,0,0,,Бұл сізді таң қалдыратын және толғандыратын уақыт береді.
Dialogue: 0,0:12:55.85,0:12:57.15,Default,,0,0,0,,Ол айналып өткеннен кейін әлсіз жақтарымнан шағын соққылар береді.
Dialogue: 0,0:12:57.23,0:12:58.11,Default,,0,0,0,,Уау, бұл жақсы.
Dialogue: 0,0:12:58.19,0:13:00.15,Default,,0,0,0,,Мен ең соңғы таныстырғым келетін нәрсе
Dialogue: 0,0:13:00.23,0:13:03.24,Default,,0,0,0,,Бұл жаңартудың ең үлкен сату нүктесі -
Dialogue: 0,0:13:03.32,0:13:06.16,Default,,0,0,0,,Дүние жүзіндегі алғашқы екі доңғалақты айналма доңғалақ
Dialogue: 0,0:13:07.53,0:13:11.66,Default,,0,0,0,,Солтүстік және оңтүстік жақтардың әрқайсысы үшін солтүстік дөңгелекті және оңтүстік дөңгелекті дайындаңыз.
Dialogue: 0,0:13:11.74,0:13:15.62,Default,,0,0,0,,Ұшаққа мінетін бағытқа байланысты әртүрлі пейзаждарды көре аласыз.
Dialogue: 0,0:13:15.71,0:13:18.58,Default,,0,0,0,,Сондай-ақ, паром дөңгелегі айналасында орналасқан субұрқақтардан,
Dialogue: 0,0:13:18.67,0:13:21.34,Default,,0,0,0,,Арнайы су мен жарық шоуы өтеді.
Dialogue: 0,0:13:21.42,0:13:22.84,Default,,0,0,0,,Жер бетінен 100 метр биіктіктен
Dialogue: 0,0:13:22.92,0:13:26.01,Default,,0,0,0,,Керемет көріністермен ынтымақтастықтан ләззат алыңыз
Dialogue: 0,0:13:26.09,0:13:28.34,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:13:28.43,0:13:29.93,Default,,0,0,0,,Мына айналма дөңгелекке мінейік
Dialogue: 0,0:13:30.01,0:13:30.97,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:13:31.06,0:13:33.56,Default,,0,0,0,,Сіз аквариумға барған жоқсыз ба?
Dialogue: 0,0:13:33.64,0:13:36.77,Default,,0,0,0,,Екеуіне де бару керек, солай ма?
Dialogue: 0,0:13:36.85,0:13:38.90,Default,,0,0,0,,Жарайды, жарайды, екеуміз барайық.
Dialogue: 0,0:13:38.98,0:13:39.81,Default,,0,0,0,,Dr.
Dialogue: 0,0:13:40.40,0:13:41.90,Default,,0,0,0,,Билет құны Құрметпен
Dialogue: 0,0:13:41.98,0:13:43.19,Default,,0,0,0,,Иә...
Dialogue: 0,0:13:43.28,0:13:46.11,Default,,0,0,0,,Уау, мен үлкен нәрсені көріп тұрмын.
Dialogue: 0,0:13:46.20,0:13:48.28,Default,,0,0,0,,- (Мицухико) Бұл рас - (Аюми) Бұл керемет.
Dialogue: 0,0:13:48.36,0:13:50.20,Default,,0,0,0,,Біз сонда бес минуттан аз уақыт ішінде боламыз.
Dialogue: 0,0:13:59.17,0:14:00.04,Default,,0,0,0,,Ах
Dialogue: 0,0:14:19.19,0:14:21.02,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:14:21.69,0:14:24.02,Default,,0,0,0,,Хахаха, кеттік
Dialogue: 0,0:14:24.11,0:14:25.15,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:14:25.23,0:14:26.65,Default,,0,0,0,,Күте тұрыңыз, Гента-кун.
Dialogue: 0,0:14:26.74,0:14:28.57,Default,,0,0,0,,Дәрігер, тез, тез
Dialogue: 0,0:14:28.65,0:14:31.91,Default,,0,0,0,,Хайбара-сан, Конан-кун, сен де тез келші.
Dialogue: 0,0:14:32.70,0:14:36.41,Default,,0,0,0,,Сонымен, сіз қайсысына баруды шештіңіз, аквариумға ма, әлде паромға ма?
Dialogue: 0,0:14:36.50,0:14:38.54,Default,,0,0,0,,- (Аюми) Иә - (Гента) Сіз не айтып тұрсыз, доктор?
Dialogue: 0,0:14:38.62,0:14:40.67,Default,,0,0,0,,Әрине екеуі де, солай ма?
Dialogue: 0,0:14:40.75,0:14:42.67,Default,,0,0,0,,Хехе, жарысайық.
Dialogue: 0,0:14:42.75,0:14:45.21,Default,,0,0,0,,Егер мен сізге беретін сұраққа жауап бере алсаңыз
Dialogue: 0,0:14:45.30,0:14:47.42,Default,,0,0,0,,Екеуін де алайық.
Dialogue: 0,0:14:47.51,0:14:48.88,Default,,0,0,0,,Мен—
Dialogue: 0,0:14:48.97,0:14:52.01,Default,,0,0,0,,Түсті араластырмай қолданғанда
Dialogue: 0,0:14:52.09,0:14:56.18,Default,,0,0,0,,Төмендегі төрт нәрсенің қайсысын түрлендіруге болады?
Dialogue: 0,0:14:56.27,0:14:58.27,Default,,0,0,0,,1 Қызыл
Dialogue: 0,0:14:58.35,0:14:59.69,Default,,0,0,0,,2 Көк
Dialogue: 0,0:14:59.77,0:15:01.23,Default,,0,0,0,,3 қоңыр
Dialogue: 0,0:15:01.31,0:15:02.69,Default,,0,0,0,,4 Қара
Dialogue: 0,0:15:02.77,0:15:04.77,Default,,0,0,0,,Таза
Dialogue: 0,0:15:04.86,0:15:07.07,Default,,0,0,0,,Оны қолданған кезде түрленетін түс пе?
Dialogue: 0,0:15:07.15,0:15:10.11,Default,,0,0,0,,О, қазірдің өзінде! Мен мүлде түсінбеймін
Dialogue: 0,0:15:10.20,0:15:11.41,Default,,0,0,0,,Dr.
Dialogue: 0,0:15:11.49,0:15:13.28,Default,,0,0,0,,Сіз жетілмегенсіз.
Dialogue: 0,0:15:13.37,0:15:14.78,Default,,0,0,0,,Түсті өзгерту
Dialogue: 0,0:15:14.87,0:15:17.49,Default,,0,0,0,,Менің ойымша, оны түсіну оңайырақ.
Dialogue: 0,0:15:17.58,0:15:19.66,Default,,0,0,0,,Сіз оны қайталап айтасыз ба?
Dialogue: 0,0:15:17.58,0:15:19.66,Default,,0,0,0,,Мынау, мынау, Конан, сен қатыса алмайсың.
Dialogue: 0,0:15:19.66,0:15:20.46,Default,,0,0,0,,Мынау, мынау, Конан, сен қатыса алмайсың.
Dialogue: 0,0:15:21.00,0:15:23.71,Default,,0,0,0,,Мысалы, қызыл түс ашық қызыл
Dialogue: 0,0:15:23.79,0:15:24.79,Default,,0,0,0,,Көк түс – қою көк
Dialogue: 0,0:15:24.88,0:15:26.25,Default,,0,0,0,,Ай-кун, олай айтпа...
Dialogue: 0,0:15:26.34,0:15:27.80,Default,,0,0,0,,- (Мицухико) Түсінікті - (Агаса) Иә?
Dialogue: 0,0:15:27.88,0:15:30.17,Default,,0,0,0,,Қоңыр түс сіріңкені білдіреді.
Dialogue: 0,0:15:30.26,0:15:32.59,Default,,0,0,0,,- (Аюми) А, мен өзгердім! -(Мицухико) Иә.
Dialogue: 0,0:15:32.68,0:15:34.47,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:15:34.97,0:15:37.68,Default,,0,0,0,,Қызыл – ашық қызыл, көк – ашық көк
Dialogue: 0,0:15:37.77,0:15:38.93,Default,,0,0,0,,Шай таза қоңыр түсті
Dialogue: 0,0:15:39.02,0:15:40.43,Default,,0,0,0,,Қара - қою қара
Dialogue: 0,0:15:40.52,0:15:43.44,Default,,0,0,0,,Қоңыр түске назар аударыңыз, Гента-кун.
Dialogue: 0,0:15:43.52,0:15:46.07,Default,,0,0,0,,Тек қоңыр түсті ғана сіріңке, солай ма?
Dialogue: 0,0:15:46.15,0:15:48.90,Default,,0,0,0,,А, рас, шай болып кетті.
Dialogue: 0,0:15:48.98,0:15:51.57,Default,,0,0,0,,Бір минут күте тұрыңыз, бұл түсінік беру өте қулық.
Dialogue: 0,0:15:51.65,0:15:53.91,Default,,0,0,0,,Жарайды, билет сатып алайық.
Dialogue: 0,0:15:53.99,0:15:56.08,Default,,0,0,0,,- (Мицухикочи) О! -(Ағаса) О, мынау.
Dialogue: 0,0:15:56.16,0:15:58.33,Default,,0,0,0,,Алдымен, айналмалы дөңгелектен бастайық.
Dialogue: 0,0:15:58.41,0:16:00.16,Default,,0,0,0,,Сізде екеуі де болуы мүмкін емес. Екеуі де бола алмайды.
Dialogue: 0,0:16:00.25,0:16:01.46,Default,,0,0,0,,Мені күт~
Dialogue: 0,0:16:01.54,0:16:03.29,Default,,0,0,0,,Барлығың осында келіңдер.
Dialogue: 0,0:16:03.37,0:16:04.92,Default,,0,0,0,,Дөңгелегі адам көп, солай емес пе?
Dialogue: 0,0:16:05.00,0:16:06.38,Default,,0,0,0,,Бір сағат күтуім керек шығар.
Dialogue: 0,0:16:06.46,0:16:08.67,Default,,0,0,0,,Доңғалақ шынымен үлкен.
Dialogue: 0,0:16:08.75,0:16:10.63,Default,,0,0,0,,Біздің үйді көре аласыз ба?
Dialogue: 0,0:16:10.71,0:16:13.76,Default,,0,0,0,,Не болды? А... бір сәт
Dialogue: 0,0:16:15.22,0:16:18.60,Default,,0,0,0,,Эй, жақсысың ба? үлкен әпке
Dialogue: 0,0:16:18.68,0:16:19.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:20.43,0:16:21.73,Default,,0,0,0,,Бетіңіз лас.
Dialogue: 0,0:16:21.81,0:16:22.89,Default,,0,0,0,,Ах
Dialogue: 0,0:16:22.98,0:16:24.02,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:16:24.10,0:16:27.82,Default,,0,0,0,,Әпкеңнің сол және оң көзінің түсі әртүрлі, солай ма?
Dialogue: 0,0:16:27.90,0:16:29.78,Default,,0,0,0,,Жапон тілі Сіз оны шынымен түсінбейсіз, солай ма?
Dialogue: 0,0:16:29.86,0:16:31.65,Default,,0,0,0,,Түсіндім, түсінемін.
Dialogue: 0,0:16:31.74,0:16:34.41,Default,,0,0,0,,Не болды? Мұндай жерде жалғыз
Dialogue: 0,0:16:34.49,0:16:37.28,Default,,0,0,0,,Достарыңыз жоқ сияқты, және
Dialogue: 0,0:16:37.37,0:16:40.54,Default,,0,0,0,,Менің қолым мен тізем жарақаттанған.
Dialogue: 0,0:16:40.62,0:16:43.16,Default,,0,0,0,,Менің смартфоным да бұзылған сияқты.
Dialogue: 0,0:16:43.25,0:16:44.87,Default,,0,0,0,,Маған мынаны көрсет
Dialogue: 0,0:16:44.96,0:16:46.13,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:16:46.21,0:16:48.63,Default,,0,0,0,,Сенің әпкең қашаннан бері келеді?
Dialogue: 0,0:16:48.71,0:16:50.05,Default,,0,0,0,,Ал...
Dialogue: 0,0:16:50.96,0:16:52.92,Default,,0,0,0,,Сонда сен қайдан келдің?
Dialogue: 0,0:16:53.47,0:16:54.30,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:16:54.38,0:16:55.34,Default,,0,0,0,,Ах
Dialogue: 0,0:16:57.01,0:16:58.30,Default,,0,0,0,,Әпкеңнің аты кім?
Dialogue: 0,0:16:59.01,0:17:00.18,Default,,0,0,0,,Сол түнде толық ай болды
Dialogue: 0,0:17:01.27,0:17:02.93,Default,,0,0,0,,Кешіріңіз, мен түсінбеймін.
Dialogue: 0,0:17:03.85,0:17:05.19,Default,,0,0,0,,Маған басыңды көрсет.
Dialogue: 0,0:17:05.27,0:17:07.06,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:17:08.65,0:17:11.28,Default,,0,0,0,,Бұл үлкен сызат емес, бірақ жақында болды.
Dialogue: 0,0:17:11.36,0:17:14.78,Default,,0,0,0,,Мүмкін сіз көлікте болып, апатқа ұшырап, басыңызды жарақаттап алған шығарсыз.
Dialogue: 0,0:17:14.86,0:17:18.62,Default,,0,0,0,,Олай болса, травматикалық ретроградтық амнезия...
Dialogue: 0,0:17:18.70,0:17:21.83,Default,,0,0,0,,...Оның көлікте болғанын қайдан білесің?
Dialogue: 0,0:17:21.91,0:17:23.79,Default,,0,0,0,,Бұл смартфон
Dialogue: 0,0:17:23.87,0:17:26.58,Default,,0,0,0,,Ол қатты соққы алғаны сонша, ол толығымен сынды.
Dialogue: 0,0:17:27.42,0:17:30.21,Default,,0,0,0,,Қараңдаршы, бұл көліктің алдыңғы әйнегінің бір бөлігі.
Dialogue: 0,0:17:31.04,0:17:33.21,Default,,0,0,0,,Сонда сіз көлік жүргізіп келе жатып басыңызды соқтыңыз ба?
Dialogue: 0,0:17:33.30,0:17:36.63,Default,,0,0,0,,Бұл көлік салыстырмалы түрде ескі үлгі болуы керек.
Dialogue: 0,0:17:36.72,0:17:39.64,Default,,0,0,0,,Қазіргі машиналарда сынбайтын шыны бар.
Dialogue: 0,0:17:39.72,0:17:41.35,Default,,0,0,0,,Фильм сонда жабысып қалды.
Dialogue: 0,0:17:42.14,0:17:46.27,Default,,0,0,0,,Оның денесінен бензиннің иісі шамалы.
Dialogue: 0,0:17:46.35,0:17:47.31,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:17:47.39,0:17:48.23,Default,,0,0,0,,Рас
Dialogue: 0,0:17:48.31,0:17:51.40,Default,,0,0,0,,Әпке, сізде басқа нәрсе бар ма?
Dialogue: 0,0:17:51.48,0:17:53.57,Default,,0,0,0,,Олар болашақта бізден тағы да көп нәрсені тартып алады.
Dialogue: 0,0:17:58.28,0:18:00.49,Default,,0,0,0,,- (Кюрасао) Бұл... - Апа, көрсетіңізші.
Dialogue: 0,0:18:00.57,0:18:01.70,Default,,0,0,0,,Иә
Dialogue: 0,0:18:01.78,0:18:02.99,Default,,0,0,0,,Қорқамын, ол қайтып келмейді.
Dialogue: 0,0:18:03.08,0:18:05.29,Default,,0,0,0,,Не? Бұл сөздік кітапқа ұқсайды
Dialogue: 0,0:18:06.50,0:18:08.25,Default,,0,0,0,,Карточканың мөлдір түсі бар
Dialogue: 0,0:18:08.92,0:18:09.96,Default,,0,0,0,,Бұл қандай карта?
Dialogue: 0,0:18:10.04,0:18:11.00,Default,,0,0,0,,Эй
Dialogue: 0,0:18:11.08,0:18:13.50,Default,,0,0,0,,-Ах - (Гента) Конан Хайбара
Dialogue: 0,0:18:13.59,0:18:16.09,Default,,0,0,0,,Мен де екі адамға билет алдым.
Dialogue: 0,0:18:16.17,0:18:18.59,Default,,0,0,0,,Ябе, қиыншылық қайтып келді.
Dialogue: 0,0:18:16.17,0:18:18.59,Default,,0,0,0,,Жақында серуендеуге барайық.
Dialogue: 0,0:18:19.22,0:18:21.72,Default,,0,0,0,,Бұл кім? сол әйел
Dialogue: 0,0:18:21.80,0:18:26.23,Default,,0,0,0,,Ой, апаңның көзі оңы мен солы әртүрлі, әдемі.
Dialogue: 0,0:18:26.31,0:18:28.56,Default,,0,0,0,,Сізде жасанды көздер бар ма?
Dialogue: 0,0:18:28.64,0:18:30.06,Default,,0,0,0,,Бұл дұрыс емес, Гента-кун.
Dialogue: 0,0:18:30.15,0:18:32.23,Default,,0,0,0,,Менің ойымша, сіздің апаңыздың көздері біртүрлі.
Dialogue: 0,0:18:32.31,0:18:33.61,Default,,0,0,0,,Од көз?
Dialogue: 0,0:18:33.69,0:18:36.74,Default,,0,0,0,,Біртүрлі есім екен, апа.
Dialogue: 0,0:18:37.44,0:18:39.28,Default,,0,0,0,,Бұл адамның аты емес
Dialogue: 0,0:18:39.36,0:18:41.74,Default,,0,0,0,,Жарайды, итбалықтың көзін айтып тұрсың.
Dialogue: 0,0:18:41.82,0:18:43.78,Default,,0,0,0,,Тері мөрі?
Dialogue: 0,0:18:44.58,0:18:46.25,Default,,0,0,0,,Бұл көз туралы, Конан-кун.
Dialogue: 0,0:18:46.33,0:18:48.71,Default,,0,0,0,,- (Кюрасао) Хэхе хехе хехе -Ах... ах
Dialogue: 0,0:18:48.79,0:18:50.46,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:18:50.54,0:18:53.25,Default,,0,0,0,,Әпкең маған күлді.
Dialogue: 0,0:18:53.96,0:18:57.34,Default,,0,0,0,,Айтпақшы, балалар, мұндай жерде не істеп жүрсіңдер?
Dialogue: 0,0:18:57.42,0:18:59.09,Default,,0,0,0,,Дұрыс, доктор.
Dialogue: 0,0:18:59.17,0:19:01.34,Default,,0,0,0,,Бұл үлкен апа апатқа ұшырады.
Dialogue: 0,0:19:01.43,0:19:04.01,Default,,0,0,0,,Есте сақтау қабілетін жоғалтқан сияқты.
Dialogue: 0,0:19:04.10,0:19:05.39,Default,,0,0,0,,Бұл рас па? Жаңа...
Dialogue: 0,0:19:05.47,0:19:07.31,Default,,0,0,0,,Жоқ, жоқ, Конан-кун.
Dialogue: 0,0:19:07.39,0:19:08.85,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:19:08.93,0:19:10.73,Default,,0,0,0,,Юбе апатына қатысты...
Dialogue: 0,0:19:10.81,0:19:12.44,Default,,0,0,0,,Дереу полиция шақырыңыз
Dialogue: 0,0:19:12.52,0:19:13.36,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:19:13.44,0:19:15.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:15.44,0:19:18.86,Default,,0,0,0,,Әпке, полицияға бара алмауыңыздың себебі бар ма?
Dialogue: 0,0:19:18.94,0:19:20.45,Default,,0,0,0,,Мен... білмеймін.
Dialogue: 0,0:19:21.03,0:19:23.41,Default,,0,0,0,,Мені қорғағаныңды қалаймын.
Dialogue: 0,0:19:23.49,0:19:25.33,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:19:25.41,0:19:26.24,Default,,0,0,0,,Мынау және анау
Dialogue: 0,0:19:26.33,0:19:28.04,Default,,0,0,0,,Мен кенеттен қалай суретке түсіруге болады?
Dialogue: 0,0:19:28.12,0:19:31.21,Default,,0,0,0,,Күте тұрыңыз, апа, мен полиция шақырмаймын.
Dialogue: 0,0:19:32.29,0:19:36.42,Default,,0,0,0,,Әпкем танитын адамды табу үшін маған фото керек болды.
Dialogue: 0,0:19:36.50,0:19:37.84,Default,,0,0,0,,Мен білетін адам бар ма?
Dialogue: 0,0:19:37.92,0:19:41.13,Default,,0,0,0,,Иә, мен сізге естеліктеріңізді қайтаруға көмектесуге рұқсат етіңіз.
Dialogue: 0,0:19:41.22,0:19:42.59,Default,,0,0,0,,Сіз байсалдысыз ба, Конан?
Dialogue: 0,0:19:42.68,0:19:44.34,Default,,0,0,0,,Біз де сізге көмектесейік
Dialogue: 0,0:19:45.10,0:19:46.05,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:19:46.14,0:19:47.31,Default,,0,0,0,,-(Мицухико) Біз -(Аюми) Бізбіз
Dialogue: 0,0:19:46.14,0:19:47.31,Default,,0,0,0,,Уф! Аах!
Dialogue: 0,0:19:47.39,0:19:50.23,Default,,0,0,0,,- (Мицухико) Себебі бұл ұлдардың детектив тобы - (Аюми) Себебі бұл ұлдардың детектив тобы
Dialogue: 0,0:19:47.39,0:19:50.23,Default,,0,0,0,,Балалардың детектив тобы дегеніміз не?
Dialogue: 0,0:19:50.31,0:19:51.35,Default,,0,0,0,,Я...
Dialogue: 0,0:19:51.44,0:19:54.10,Default,,0,0,0,,Біз сіздің әпкеңіздің досын іздейміз.
Dialogue: 0,0:19:54.19,0:19:56.11,Default,,0,0,0,,Олай болса мен сіздің жадыңызды қалпына келтіремін.
Dialogue: 0,0:19:56.19,0:19:58.94,Default,,0,0,0,,Өзіңізді үлкен қайықта отырғандай етіп көрсетіңіз.
Dialogue: 0,0:20:00.11,0:20:01.11,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:01.20,0:20:04.66,Default,,0,0,0,,Ал, алдымен апаңды танитын адамды тауып алайық.
Dialogue: 0,0:20:04.74,0:20:06.87,Default,,0,0,0,,Балалар, сендер дөңгелекті не істеулерің керек?
Dialogue: 0,0:20:06.95,0:20:08.83,Default,,0,0,0,,Сіз не туралы айтып тұрсыз, дәрігер?
Dialogue: 0,0:20:08.91,0:20:11.33,Default,,0,0,0,,Бұлай мінетін уақыт емес.
Dialogue: 0,0:20:11.41,0:20:11.91,Default,,0,0,0,,Біріншіден, сол дельфинге.
Dialogue: 0,0:20:11.91,0:20:12.79,Default,,0,0,0,,Біріншіден, сол дельфинге.
Dialogue: 0,0:20:11.91,0:20:12.79,Default,,0,0,0,,Болды... Сатып алудың басына кеттім.
Dialogue: 0,0:20:12.79,0:20:12.87,Default,,0,0,0,,Болды... Сатып алудың қиналуына бардым.
Dialogue: 0,0:20:12.87,0:20:13.83,Default,,0,0,0,,Болды... Сатып алудың басына кеттім.
Dialogue: 0,0:20:12.87,0:20:13.83,Default,,0,0,0,,Тыңдап көрейік
Dialogue: 0,0:20:13.92,0:20:15.75,Default,,0,0,0,,Дәрігердің бұзылуы
Dialogue: 0,0:20:15.83,0:20:17.84,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:20:17.92,0:20:18.96,Default,,0,0,0,,Мен оны іздеймін.
Dialogue: 0,0:20:19.05,0:20:21.30,Default,,0,0,0,,Эхехехе, жүр, тез, тез.
Dialogue: 0,0:20:21.38,0:20:25.51,Default,,0,0,0,,Ей, балалар, мұны жай ғана көңіл көтеру үшін жасамаңдар.
Dialogue: 0,0:20:25.59,0:20:28.26,Default,,0,0,0,,Сіз бұл туралы полицияға хабарламайтыныңызға сенімдісіз бе?
Dialogue: 0,0:20:28.35,0:20:29.68,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:20:32.77,0:20:35.69,Default,,0,0,0,,(Когороның қорылдауы)
Dialogue: 0,0:20:32.77,0:20:35.69,Default,,0,0,0,,Кеше түнде №11 Метрополитен экспресс жолында келе жатқан көлік
Dialogue: 0,0:20:35.69,0:20:35.77,Default,,0,0,0,,Кеше түнде №11 Метрополитен экспресс жолымен келе жатқан көлік
Dialogue: 0,0:20:35.77,0:20:36.86,Default,,0,0,0,,Кеше түнде №11 Метрополитен экспресс жолымен келе жатқан көлік
Dialogue: 0,0:20:35.77,0:20:36.86,Default,,0,0,0,,(ұйқыда сөйлесу)
Dialogue: 0,0:20:36.86,0:20:36.94,Default,,0,0,0,,(ұйқыда сөйлесу)
Dialogue: 0,0:20:36.94,0:20:38.32,Default,,0,0,0,,(ұйқыда сөйлесу)
Dialogue: 0,0:20:36.94,0:20:38.32,Default,,0,0,0,,Биік темір жол астындағы қойма ауданында жарылыс және өрт болды.
Dialogue: 0,0:20:38.32,0:20:38.40,Default,,0,0,0,,Биік темір жол астындағы қойма ауданында жарылыс және өрт болды.
Dialogue: 0,0:20:38.40,0:20:41.19,Default,,0,0,0,,Биік темір жол астындағы қойма ауданында жарылыс және өрт болды.
Dialogue: 0,0:20:41.28,0:20:42.65,Default,,0,0,0,,Әкем
Dialogue: 0,0:20:41.28,0:20:42.65,Default,,0,0,0,,Осы апаттан зардап шеккендер
Dialogue: 0,0:20:42.74,0:20:43.82,Default,,0,0,0,,Керемет, олай болмады.
Dialogue: 0,0:20:43.90,0:20:45.53,Default,,0,0,0,,Көлік жүргізушісі
Dialogue: 0,0:20:43.90,0:20:45.53,Default,,0,0,0,,Сәлем Йоко-чан
Dialogue: 0,0:20:45.53,0:20:45.61,Default,,0,0,0,,Сәлем Йоко-чан
Dialogue: 0,0:20:45.61,0:20:46.32,Default,,0,0,0,,Сәлем Йоко-чан
Dialogue: 0,0:20:45.61,0:20:46.32,Default,,0,0,0,,Ол оқиға орнынан кетіп қалған сияқты.
Dialogue: 0,0:20:46.32,0:20:47.24,Default,,0,0,0,,Ол оқиға орнынан кетіп қалған сияқты.
Dialogue: 0,0:20:47.32,0:20:48.83,Default,,0,0,0,,Полиция оны іздеп жатыр.
Dialogue: 0,0:20:48.91,0:20:51.12,Default,,0,0,0,,(Когороның ұйқы туралы әңгімесі)
Dialogue: 0,0:20:51.20,0:20:52.91,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:20:53.00,0:20:54.83,Default,,0,0,0,,- (Жүгіріп) Әкем - (Когоро) Уау!
Dialogue: 0,0:20:55.50,0:20:58.00,Default,,0,0,0,,Жұмыста бос жүрсеңіз, қанша уақыт ұйықтайсыз?
Dialogue: 0,0:20:58.09,0:20:59.75,Default,,0,0,0,,Шулы
Dialogue: 0,0:20:59.84,0:21:03.34,Default,,0,0,0,,Детективтерге психикалық демалыс қажет.
Dialogue: 0,0:21:03.42,0:21:06.59,Default,,0,0,0,,Басқаша айтқанда, көп ішуден бас ауырады.
Dialogue: 0,0:21:06.68,0:21:08.76,Default,,0,0,0,,Не... неге... жоқ, ешкім.
Dialogue: 0,0:21:08.85,0:21:11.64,Default,,0,0,0,,Айт... ананы айт... Уау.
Dialogue: 0,0:21:11.72,0:21:13.35,Default,,0,0,0,,Бұл Конан-куннан.
Dialogue: 0,0:21:13.43,0:21:17.02,Default,,0,0,0,,Мен амнезиясы бар адамға қамқорлық жасадым, сондықтан олардан полицияға хабарлауын өтіндім.
Dialogue: 0,0:21:17.10,0:21:19.27,Default,,0,0,0,,Әзірше мен детектив Такагиге айттым.
Dialogue: 0,0:21:19.36,0:21:21.90,Default,,0,0,0,,Әкеңе де көмектес.
Dialogue: 0,0:21:21.98,0:21:23.03,Default,,0,0,0,,Әдемі~
Dialogue: 0,0:21:23.11,0:21:24.78,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:21:24.86,0:21:27.45,Default,,0,0,0,,Бұл ханым қазір қайда?
Dialogue: 0,0:21:27.53,0:21:29.70,Default,,0,0,0,,Және… Тото аквариумы.
Dialogue: 0,0:21:29.78,0:21:32.04,Default,,0,0,0,,- (Когоро) Түсінікті. - (Жүгіріп) Ой, күте тұрыңыз, әке.
Dialogue: 0,0:21:32.12,0:21:35.83,Default,,0,0,0,,Өтінішті осы ұлы детектив қабылдады.
Dialogue: 0,0:21:35.91,0:21:37.08,Default,,0,0,0,,Жоқ, бұл сұрау емес.
Dialogue: 0,0:21:38.00,0:21:39.58,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:21:41.25,0:21:43.38,Default,,0,0,0,,Инспектор, бұл бұрын болған оқиға.
Dialogue: 0,0:21:43.46,0:21:45.55,Default,,0,0,0,,Бұл Ран жіберген фотосурет.
Dialogue: 0,0:21:45.63,0:21:46.76,Default,,0,0,0,,Иә
Dialogue: 0,0:21:46.84,0:21:48.01,Default,,0,0,0,,Баяндама бойынша
Dialogue: 0,0:21:48.09,0:21:50.47,Default,,0,0,0,,Жол-көлік оқиғасына ұшырау мүмкіндігіңіз бар.
Dialogue: 0,0:21:50.55,0:21:52.97,Default,,0,0,0,,Жол-көлік оқиғасы?
Dialogue: 0,0:21:53.06,0:21:54.73,Default,,0,0,0,,Үлкені болды.
Dialogue: 0,0:21:55.31,0:21:57.73,Default,,0,0,0,,Егер есімде дұрыс болса, жүргізуші жоқ.
Dialogue: 0,0:21:57.81,0:22:00.90,Default,,0,0,0,,Бұқаралық ақпарат құралдарын былай қойғанда, мұндай оқыс оқиға болса да.
Dialogue: 0,0:22:00.98,0:22:03.44,Default,,0,0,0,,Біз де нақты ақпарат алған жоқпыз.
Dialogue: 0,0:22:04.03,0:22:05.61,Default,,0,0,0,,Бұл...
Dialogue: 0,0:22:05.69,0:22:07.57,Default,,0,0,0,,Мен оны қарастыруым керек деп ойлаймын.
Dialogue: 0,0:22:08.70,0:22:09.70,Default,,0,0,0,,- (Чиба) Инспектор Мегуре - (Мегуре) Иә?
Dialogue: 0,0:22:09.78,0:22:11.41,Default,,0,0,0,,Қалай болды?
Dialogue: 0,0:22:12.33,0:22:15.66,Default,,0,0,0,,3-ші тергеу бөлімі нақты ақпарат алған жоқ.
Dialogue: 0,0:22:15.75,0:22:16.96,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:17.66,0:22:18.92,Default,,0,0,0,,Бірақ мен Юлий деген адам емеспін.
Dialogue: 0,0:22:19.00,0:22:20.58,Default,,0,0,0,,Кеше түнде Ұлттық полиция агенттігінде.
Dialogue: 0,0:22:20.67,0:22:23.55,Default,,0,0,0,,Біреу кіріп кетті деген қауесетті естідім.
Dialogue: 0,0:22:23.63,0:22:24.71,Default,,0,0,0,,Ұлттық полиция агенттігіне?
Dialogue: 0,0:22:24.80,0:22:28.76,Default,,0,0,0,,Бірақ қалалық полиция департаменті бұл ақпаратты алмайды.
Dialogue: 0,0:22:29.59,0:22:30.72,Default,,0,0,0,,Ал әйелім ше? Әйелім мен ұлым? Екеуі де аман ба?
Dialogue: 0,0:22:30.80,0:22:32.22,Default,,0,0,0,,Хмм.
Dialogue: 0,0:22:32.30,0:22:36.93,Default,,0,0,0,,Мүмкін қандай да бір үлкен күш жұмыс істеп жатқан шығар.
Dialogue: 0,0:22:41.52,0:22:45.44,Default,,0,0,0,,Toto Aquarium сауда орталығына бару
Dialogue: 0,0:22:45.53,0:22:48.36,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:22:48.45,0:22:52.70,Default,,0,0,0,,Уақытыңызды бөліп, сатып алудан ләззат алыңыз.
Dialogue: 0,0:22:55.04,0:22:56.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:58.08,0:22:58.96,Default,,0,0,0,,болды
Dialogue: 0,0:23:01.04,0:23:02.46,Default,,0,0,0,,Мен таптым, Джин.
Dialogue: 0,0:23:03.09,0:23:03.96,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:23:04.04,0:23:05.13,Default,,0,0,0,,Тото аквариумы
Dialogue: 0,0:23:05.21,0:23:06.34,Default,,0,0,0,,Аквариум?
Dialogue: 0,0:23:06.42,0:23:07.46,Default,,0,0,0,,Иә
Dialogue: 0,0:23:07.55,0:23:10.93,Default,,0,0,0,,Уайымдама, мен сені бірден үйге апарамын.
Dialogue: 0,0:23:12.93,0:23:15.35,Default,,0,0,0,,Бүгін келгендеріңізге рахмет.
Dialogue: 0,0:23:15.43,0:23:18.14,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:23:18.23,0:23:22.73,Default,,0,0,0,,Жақында дельфиндердің арнайы шоуы басталады.
Dialogue: 0,0:23:22.81,0:23:25.82,Default,,0,0,0,,Ол шынымен де осында болды ма?
Dialogue: 0,0:23:25.90,0:23:30.40,Default,,0,0,0,,Аа, олардың шаштары мен көздерінің түсі ерекше.
Dialogue: 0,0:23:30.49,0:23:33.62,Default,,0,0,0,,Бір қызығы, ешкімнің есінде жоқ.
Dialogue: 0,0:23:34.49,0:23:37.12,Default,,0,0,0,,Енді қайда баруды жоспарлап отырсыз?
Dialogue: 0,0:23:37.20,0:23:39.41,Default,,0,0,0,,Жердің көп бөлігі бұрылды.
Dialogue: 0,0:23:39.50,0:23:40.91,Default,,0,0,0,,- (Гента) Қолыңнан келгенін істе, әпке - А?
Dialogue: 0,0:23:41.00,0:23:43.83,Default,,0,0,0,,Бұл соңғысы. Мұқият жалғастырыңыз.
Dialogue: 0,0:23:43.92,0:23:45.59,Default,,0,0,0,,Бұл солтүстік-батырдағы қала ма?
Dialogue: 0,0:23:50.38,0:23:51.93,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:23:52.01,0:23:54.09,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:23:54.18,0:23:55.93,Default,,0,0,0,,- (Мицухико/Аюми) Уау - (Гента) О, бұл керемет
Dialogue: 0,0:23:56.01,0:23:57.68,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:23:57.76,0:24:00.27,Default,,0,0,0,,Бүгінгі ең жоғары балл
Dialogue: 0,0:24:01.60,0:24:02.77,Default,,0,0,0,,Қараңдаршы, менің әпкем де.
Dialogue: 0,0:24:02.85,0:24:05.31,Default,,0,0,0,,Қолдарыңызды шығарыңыз
Dialogue: 0,0:24:05.40,0:24:06.82,Default,,0,0,0,,Иә! ...Мен тоқтадым.
Dialogue: 0,0:24:06.90,0:24:09.19,Default,,0,0,0,,- (Мицухико) Менімен бірге жасайық - (Аюми) Мен де
Dialogue: 0,0:24:09.28,0:24:10.40,Default,,0,0,0,,Иә
Dialogue: 0,0:24:10.49,0:24:12.32,Default,,0,0,0,,- (Мицухико) Ия! -(Аюми) Келесі мен
Dialogue: 0,0:24:12.40,0:24:15.53,Default,,0,0,0,,А, апа тағы да күлді.
Dialogue: 0,0:24:15.62,0:24:18.74,Default,,0,0,0,,Әпкеңнің күлгені жақсы деп ойлаймын.
Dialogue: 0,0:24:18.83,0:24:20.41,Default,,0,0,0,,-(Аюми) Иә -(Мицухико) Дұрыс.
Dialogue: 0,0:24:20.50,0:24:21.58,Default,,0,0,0,,Кітапханада жәндіктер ұяласып жатыр ма? Бұл өте қорқынышты.
Dialogue: 0,0:24:21.66,0:24:22.71,Default,,0,0,0,,Мүлдем иә
Dialogue: 0,0:24:23.25,0:24:25.96,Default,,0,0,0,,Енді жүлде ретінде үш салпыншақ таңдаңыз.
Dialogue: 0,0:24:26.04,0:24:28.46,Default,,0,0,0,,-(Гента) О~ -(Аюми) Ия!
Dialogue: 0,0:24:28.55,0:24:29.80,Default,,0,0,0,,Үш болған дұрыс па?
Dialogue: 0,0:24:29.88,0:24:31.38,Default,,0,0,0,,- (Аюми) Мен, анау - (Гента) Мен, мынау
Dialogue: 0,0:24:31.47,0:24:32.88,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:24:32.97,0:24:34.30,Default,,0,0,0,,Иә, бұл сенсің.
Dialogue: 0,0:24:34.38,0:24:36.18,Default,,0,0,0,,Сіздің әпкеңіз ше?
Dialogue: 0,0:24:36.26,0:24:39.06,Default,,0,0,0,,Менде бәрі жақсы, уайымдама
Dialogue: 0,0:24:39.14,0:24:40.06,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:24:40.14,0:24:42.18,Default,,0,0,0,,Оны маған апам берді.
Dialogue: 0,0:24:42.27,0:24:43.81,Default,,0,0,0,,Сәлем балалар
Dialogue: 0,0:24:43.89,0:24:46.15,Default,,0,0,0,,Ах, Конан-кун, Ай-чан.
Dialogue: 0,0:24:46.23,0:24:47.98,Default,,0,0,0,,Мен онымен көп ойнадым.
Dialogue: 0,0:24:48.06,0:24:50.69,Default,,0,0,0,,Сіз әпкеңіздің естеліктерін қалпына келтірмек болған жоқсыз ба?
Dialogue: 0,0:24:50.78,0:24:51.94,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:24:52.03,0:24:54.70,Default,,0,0,0,,Мен осы ойынды ойнағаннан кейін бастаймын деп ойлаймын.
Dialogue: 0,0:24:54.78,0:24:58.07,Default,,0,0,0,,Сосын әпкем мұны маған алды.
Dialogue: 0,0:24:58.78,0:25:00.74,Default,,0,0,0,,Әй, енді ше?
Dialogue: 0,0:25:00.83,0:25:03.75,Default,,0,0,0,,Біз де осы саламен айналысуымыз керек сияқты.
Dialogue: 0,0:25:03.83,0:25:05.25,Default,,0,0,0,,Эй
Dialogue: 0,0:25:05.33,0:25:07.96,Default,,0,0,0,,Эй, міне, міне!
Dialogue: 0,0:25:08.04,0:25:09.96,Default,,0,0,0,,Ол сіздің дәрігеріңіз.
Dialogue: 0,0:25:10.05,0:25:11.46,Default,,0,0,0,,- (Аюми) Аа, доктор - (Агаса) Міне.
Dialogue: 0,0:25:11.55,0:25:14.05,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:25:14.13,0:25:16.80,Default,,0,0,0,,Доңғалақ жақындап келеді.
Dialogue: 0,0:25:16.89,0:25:19.18,Default,,0,0,0,,Егер сіз мінгіңіз келсе, қазір сіздің мүмкіндігіңіз
Dialogue: 0,0:25:19.26,0:25:20.68,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:25:20.76,0:25:23.10,Default,,0,0,0,,Олай болса, доңғалақты мінуден бастайық.
Dialogue: 0,0:25:23.18,0:25:24.18,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:25:24.27,0:25:27.15,Default,,0,0,0,,Пейзажға қарасаң, бірдеңе есіңе түсуі мүмкін.
Dialogue: 0,0:25:27.23,0:25:28.19,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:25:28.27,0:25:30.94,Default,,0,0,0,,Әпке, жүре береміз дөңгелекке.
Dialogue: 0,0:25:31.02,0:25:32.69,Default,,0,0,0,,- (Аюми) Тез, тез - (Мицухико) Кеттік...
Dialogue: 0,0:25:32.78,0:25:34.19,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:25:34.28,0:25:37.82,Default,,0,0,0,,Олай болса, айналмалы дөңгелектерді жақсы көретін дәрігермен танысайық.
Dialogue: 0,0:25:39.66,0:25:42.74,Default,,0,0,0,,Сонда кім бірінші мінгісі келеді, ол дәрігер?
Dialogue: 0,0:25:42.83,0:25:44.75,Default,,0,0,0,,Хехехехе, бұл хит.
Dialogue: 0,0:25:44.83,0:25:46.12,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:25:46.21,0:25:49.33,Default,,0,0,0,,Бұрын дартс ойнаған әйелді танисың ба?
Dialogue: 0,0:25:49.42,0:25:52.71,Default,,0,0,0,,Не? Бұрынғы күміс шашты әйелді айтасыз ба?
Dialogue: 0,0:25:52.80,0:25:54.92,Default,,0,0,0,,Иә, аға, білмейсіз бе?
Dialogue: 0,0:25:55.01,0:25:57.63,Default,,0,0,0,,А, мен сені танымаймын.
Dialogue: 0,0:25:57.72,0:26:01.47,Default,,0,0,0,,Мұндай шеберлік деңгейі бар тұтынушыны ұмыту мүмкін емес.
Dialogue: 0,0:26:01.55,0:26:02.43,Default,,0,0,0,,Ha
Dialogue: 0,0:26:02.51,0:26:04.47,Default,,0,0,0,,Барлығы қос бұқада
Dialogue: 0,0:26:04.56,0:26:06.60,Default,,0,0,0,,Бұл жай ғана кездейсоқ болуы мүмкін емес.
Dialogue: 0,0:26:07.06,0:26:08.52,Default,,0,0,0,,Рахмет, аға.
Dialogue: 0,0:26:08.60,0:26:10.19,Default,,0,0,0,,-Аа, солай ғой -Иә?
Dialogue: 0,0:26:10.27,0:26:13.86,Default,,0,0,0,,Сіз мұны бұрынғы досыңызға бере аласыз ба?
Dialogue: 0,0:26:13.94,0:26:15.03,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:26:15.74,0:26:18.03,Default,,0,0,0,,Мен оны боямас бұрын менде прототип қалды.
Dialogue: 0,0:26:18.11,0:26:20.49,Default,,0,0,0,,Себебі менде сол апаға жетпей қалды.
Dialogue: 0,0:26:20.57,0:26:21.99,Default,,0,0,0,,Бұл жақсы деп үміттенемін.
Dialogue: 0,0:26:22.08,0:26:26.12,Default,,0,0,0,,Ол әлі боялған жоқ, сондықтан оны сүйікті түстеріңізбен бояңыз және көңіл көтеріңіз.
Dialogue: 0,0:26:26.20,0:26:30.21,Default,,0,0,0,,Иә, сізге ұнайтынына сенімдімін. Рахмет аға.
Dialogue: 0,0:26:30.29,0:26:32.71,Default,,0,0,0,,Иә, ләззат алыңыз.
Dialogue: 0,0:26:32.79,0:26:33.75,Default,,0,0,0,,Кеттік, Хайбара.
Dialogue: 0,0:26:33.84,0:26:36.67,Default,,0,0,0,,Не? Иә... әрі қарай қайда?
Dialogue: 0,0:26:37.30,0:26:40.22,Default,,0,0,0,,Салынып жатқан қалған аумақтармен сұхбаттан кейін
Dialogue: 0,0:26:40.30,0:26:41.80,Default,,0,0,0,,Даналарға қосыл
Dialogue: 0,0:26:42.68,0:26:45.56,Default,,0,0,0,,Заманауи дарттар сияқты, із іздеуден гөрі.
Dialogue: 0,0:26:45.64,0:26:49.02,Default,,0,0,0,,Менің ойымша, онымен бірге барған дұрыс.
Dialogue: 0,0:26:58.32,0:27:00.99,Default,,0,0,0,,(Мицухико және басқалардың күлкісі)
Dialogue: 0,0:27:05.66,0:27:07.66,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:27:07.75,0:27:09.75,Default,,0,0,0,,Жоғары Ол жерге барғанда не көремін?
Dialogue: 0,0:27:09.83,0:27:11.29,Default,,0,0,0,,Қоңырау мұнарасын көре алатыныңызға сенімдімін.
Dialogue: 0,0:27:11.37,0:27:13.84,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:27:13.92,0:27:15.13,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:27:15.84,0:27:17.21,Default,,0,0,0,,Сәлем әпке
Dialogue: 0,0:27:17.30,0:27:20.09,Default,,0,0,0,,Есі кетсең, мен сені тастап кетемін.
Dialogue: 0,0:27:20.18,0:27:21.72,Default,,0,0,0,,- (Кюрасао) Кешіріңіз - Иә?
Dialogue: 0,0:27:21.80,0:27:23.93,Default,,0,0,0,,Мені біреу шақырып жатқандай сезіндім.
Dialogue: 0,0:27:24.01,0:27:26.10,Default,,0,0,0,,Не? Сіз тіпті бір-біріңізді таныдыңыз ба?
Dialogue: 0,0:27:26.18,0:27:28.93,Default,,0,0,0,,Жоқ, мен қателестім деп ойлаймын.
Dialogue: 0,0:27:29.02,0:27:30.94,Default,,0,0,0,,Олай болса, бәріңе.
Dialogue: 0,0:27:31.02,0:27:32.15,Default,,0,0,0,,- (Гента) О! -(Аюми) Иә!
Dialogue: 0,0:27:32.23,0:27:33.61,Default,,0,0,0,,Мұнда басыңыз
Dialogue: 0,0:27:34.69,0:27:38.32,Default,,0,0,0,,Жоспарларды өзгерту. Біраз қиындық бар сияқты.
Dialogue: 0,0:27:38.40,0:27:41.95,Default,,0,0,0,,Асығыңыз, мен сізді жалғыз қалдыра алмаймын.
Dialogue: 0,0:27:42.03,0:27:43.49,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:27:46.08,0:27:47.41,Default,,0,0,0,,Мама, күте тұрыңыз.
Dialogue: 0,0:27:47.49,0:27:50.71,Default,,0,0,0,,Соңында салынып жатқан аумақта егін болмайды.
Dialogue: 0,0:27:50.79,0:27:54.21,Default,,0,0,0,,Тезірек дәрігерге хабарласа аласыз ба, Хайбара?
Dialogue: 0,0:27:54.29,0:27:55.17,Default,,0,0,0,,Не?
Dialogue: 0,0:27:55.88,0:27:58.13,Default,,0,0,0,,Не болды? Біраз уақыттан бері аң-таң болып жүрмін
Dialogue: 0,0:27:58.21,0:27:59.05,Default,,0,0,0,,Кітапханада жәндіктер ұяласып жатыр ма? Бұл өте қорқынышты.
Dialogue: 0,0:27:59.13,0:28:02.01,Default,,0,0,0,,Сәлем Конан Хайбара!
Dialogue: 0,0:28:02.09,0:28:03.51,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:28:03.59,0:28:04.97,Default,,0,0,0,,Бұл жоғарыда. Ол жоғарыда.
Dialogue: 0,0:28:05.60,0:28:09.77,Default,,0,0,0,,Міне, келдіңіз. Сіз оны көре аласыз ба?
Dialogue: 0,0:28:09.85,0:28:11.02,Default,,0,0,0,,- (Хайбара) Бұл қауіпті! - Гента қайт!
Dialogue: 0,0:28:11.10,0:28:13.44,Default,,0,0,0,,Иә? Неліктен? Уау
Dialogue: 0,0:28:13.52,0:28:15.11,Default,,0,0,0,,- (Ағаса) О, жоқ! - (Мицухико) Жоқ!
Dialogue: 0,0:28:15.90,0:28:17.07,Default,,0,0,0,,Гента!
Dialogue: 0,0:28:17.15,0:28:18.69,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:28:18.78,0:28:20.28,Default,,0,0,0,,Гента-кун!
Dialogue: 0,0:28:20.36,0:28:21.36,Default,,0,0,0,,Бұл не болып жатыр өзі?!
Dialogue: 0,0:28:21.44,0:28:22.61,Default,,0,0,0,,Бұл жерде мүмкін емес пе?
Dialogue: 0,0:28:22.70,0:28:24.99,Default,,0,0,0,,Артық емес... енді жоқ
Dialogue: 0,0:28:25.07,0:28:26.99,Default,,0,0,0,,Гента-кун!
Dialogue: 0,0:28:31.29,0:28:32.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:33.33,0:28:35.46,Default,,0,0,0,,- (Кюрасао) Ху - (Хайбара/Конан) Ах!
Dialogue: 0,0:28:35.54,0:28:37.13,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:28:52.39,0:28:53.73,Default,,0,0,0,,Амансың ба? Гента
Dialogue: 0,0:28:53.81,0:28:56.52,Default,,0,0,0,,Гента-кун, жақсысың ба? Мықты болыңыз
Dialogue: 0,0:28:57.27,0:29:01.48,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:29:02.74,0:29:05.82,Default,,0,0,0,,Ух... а... Иә? Неге менің әпкем?
Dialogue: 0,0:29:05.91,0:29:06.91,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:29:07.49,0:29:10.20,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:29:11.16,0:29:12.50,Default,,0,0,0,,Бұрын… пышақ еді.
Dialogue: 0,0:29:13.08,0:29:16.00,Default,,0,0,0,,Мен жоғарыдан құладым.
Dialogue: 0,0:29:16.08,0:29:18.33,Default,,0,0,0,,Амансың ба? Сіз жарақат алдыңыз ба?
Dialogue: 0,0:29:18.42,0:29:21.21,Default,,0,0,0,,Жарайды, себебі апам көмектесті.
Dialogue: 0,0:29:21.30,0:29:22.17,Default,,0,0,0,,Жақсы
Dialogue: 0,0:29:22.26,0:29:24.92,Default,,0,0,0,,Қауіпсіз болу үшін емханаға келіңіз.
Dialogue: 0,0:29:30.35,0:29:31.85,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:29:33.02,0:29:33.85,Default,,0,0,0,,Иә
Dialogue: 0,0:29:34.43,0:29:36.02,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:29:36.10,0:29:38.31,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:29:38.40,0:29:39.94,Default,,0,0,0,,Йоккорасето
Dialogue: 0,0:29:40.02,0:29:41.11,Default,,0,0,0,,Ататата...
Dialogue: 0,0:29:41.19,0:29:44.44,Default,,0,0,0,,Дәрігер неліктен қатты ауырады?
Dialogue: 0,0:29:44.53,0:29:45.90,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:29:45.99,0:29:47.53,Default,,0,0,0,,Бала сияқты
Dialogue: 0,0:29:47.61,0:29:50.07,Default,,0,0,0,,Жасы ұлғайған сайын түсінесің.
Dialogue: 0,0:29:50.16,0:29:52.16,Default,,0,0,0,,Дәрігердің де жағдайы жақсы сияқты.
Dialogue: 0,0:29:52.24,0:29:53.87,Default,,0,0,0,,Дөңгелекке мінейік
Dialogue: 0,0:29:53.95,0:29:55.91,Default,,0,0,0,,- (Гента) Рахмет, әпке - (Аюми) Олай болса кеттік.
Dialogue: 0,0:29:56.00,0:29:57.08,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:29:57.17,0:29:59.13,Default,,0,0,0,,Не? Иә, бірақ
Dialogue: 0,0:30:00.04,0:30:01.88,Default,,0,0,0,,Менің ойымша, бұл ыңғайсыздық туғызады.
Dialogue: 0,0:30:01.96,0:30:04.26,Default,,0,0,0,,Сіз қазір не туралы айтып отырсыз?
Dialogue: 0,0:30:04.34,0:30:06.88,Default,,0,0,0,,Менің әпкем менің құтқарушым.
Dialogue: 0,0:30:06.97,0:30:09.39,Default,,0,0,0,,-(Аюми) Иә. -Онда серуендеуге барайық.
Dialogue: 0,0:30:09.47,0:30:12.97,Default,,0,0,0,,Күте тұрыңыз, Эдогава-кун, мен сізге бірдеңе айтайын.
Dialogue: 0,0:30:13.06,0:30:13.89,Default,,0,0,0,,О
Dialogue: 0,0:30:13.97,0:30:15.98,Default,,0,0,0,,Ал, алдымен орындайық.
Dialogue: 0,0:30:16.06,0:30:16.89,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:30:17.73,0:30:18.77,Default,,0,0,0,,Күте тұрыңыз, доктор.
Dialogue: 0,0:30:18.85,0:30:19.90,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:30:19.98,0:30:21.48,Default,,0,0,0,,Е...
Dialogue: 0,0:30:21.56,0:30:22.77,Default,,0,0,0,,Не болды?
Dialogue: 0,0:30:22.86,0:30:24.28,Default,,0,0,0,,Қызық
Dialogue: 0,0:30:31.57,0:30:33.12,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:30:33.20,0:30:35.58,Default,,0,0,0,,Сіз сенімдісіз бе? Конан-кун мен Хайбара-сан
Dialogue: 0,0:30:35.66,0:30:38.37,Default,,0,0,0,,Әңгімеге бой алдырғанша...
Dialogue: 0,0:30:38.46,0:30:41.08,Default,,0,0,0,,О, сен сенімдісің бе?
Dialogue: 0,0:30:41.17,0:30:43.34,Default,,0,0,0,,Ол олардың достарының бірі.
Dialogue: 0,0:30:43.42,0:30:45.67,Default,,0,0,0,,Мен мұны мүлдем айта алмаймын, бірақ
Dialogue: 0,0:30:45.76,0:30:48.05,Default,,0,0,0,,Бірақ сен де сездің.
Dialogue: 0,0:30:49.43,0:30:50.93,Default,,0,0,0,,Сол оң көз
Dialogue: 0,0:30:51.01,0:30:53.14,Default,,0,0,0,,Қазір ойлап қарасам, ойдан шығарылған нәрсе сияқты.
Dialogue: 0,0:30:53.93,0:30:55.77,Default,,0,0,0,,Мен мұны ойдан шығарылған нәрсе сияқты деп ойламадым.
Dialogue: 0,0:30:55.85,0:30:58.27,Default,,0,0,0,,Сонымен сіз айтасыз -
Dialogue: 0,0:30:58.35,0:31:00.85,Default,,0,0,0,,Қара ұйымның №2
Dialogue: 0,0:31:04.19,0:31:05.11,Default,,0,0,0,,Шытыр, сытыр, шырыл, шапыр, шапыр, шытыр, шатыр, шашыра!
Dialogue: 0,0:31:10.28,0:31:12.45,Default,,0,0,0,,Аға апа
Dialogue: 0,0:31:12.53,0:31:13.74,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:31:13.83,0:31:15.62,Default,,0,0,0,,Тыныш
Dialogue: 0,0:31:18.91,0:31:20.04,Default,,0,0,0,,Тағы бір… үкі ме?
Dialogue: 0,0:31:21.50,0:31:23.04,Default,,0,0,0,,Егер ол Рам болса ше?
Dialogue: 0,0:31:23.88,0:31:26.55,Default,,0,0,0,,Мен оның шынымен амнезия бар-жоғына күмәнданамын.
Dialogue: 0,0:31:26.63,0:31:30.13,Default,,0,0,0,,Егер есімде дұрыс болса, Рамның жынысы да, жасы да белгісіз еді.
Dialogue: 0,0:31:30.68,0:31:35.68,Default,,0,0,0,,Иә, мен ұйымда жүргенде өсек-аяң арқылы естіген адамым сол еді
Dialogue: 0,0:31:35.76,0:31:37.18,Default,,0,0,0,,Күшті үлкен адам
Dialogue: 0,0:31:37.68,0:31:39.43,Default,,0,0,0,,Ер адам әйел сияқты
Dialogue: 0,0:31:39.52,0:31:42.90,Default,,0,0,0,,Әр түрлі қарттар, және
Dialogue: 0,0:31:44.65,0:31:49.24,Default,,0,0,0,,Менің көзім қандай да бір апаттан жарақат алды, сол немесе оң көз алмасы протездік көз.
Dialogue: 0,0:31:51.15,0:31:54.57,Default,,0,0,0,,Егер сол әйелдің көзі тақ көздің орнына жасанды болса ше?
Dialogue: 0,0:31:54.66,0:31:58.70,Default,,0,0,0,,Мен көремін. Амнезия да ойын.
Dialogue: 0,0:31:59.75,0:32:03.21,Default,,0,0,0,,Бірақ бізге жақындау үшін неге олай әрекет ету керек?
Dialogue: 0,0:32:04.25,0:32:05.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:32:05.17,0:32:08.59,Default,,0,0,0,,Шынында да, оның физикалық мүмкіндіктеріне қарасаңыз,
Dialogue: 0,0:32:08.67,0:32:11.09,Default,,0,0,0,,Ұйымдағы адам ретінде мен абай болуым керек.
Dialogue: 0,0:32:11.97,0:32:14.68,Default,,0,0,0,,Егер менде шынымен амнезия болса ше?
Dialogue: 0,0:32:14.76,0:32:16.10,Default,,0,0,0,,Керісінше...
Dialogue: 0,0:32:16.18,0:32:19.85,Default,,0,0,0,,Жоқ! Ешқашан естеліктерді қайтармаңыз
Dialogue: 0,0:32:19.93,0:32:22.98,Default,,0,0,0,,Сене алар емеспін, егер әлгі әйелдің жады қайта оралса.
Dialogue: 0,0:32:23.06,0:32:24.48,Default,,0,0,0,,Ұйымдастыру ақпараты қолжетімді
Dialogue: 0,0:32:25.15,0:32:27.32,Default,,0,0,0,,Бұл сіз ойлағандай емес.
Dialogue: 0,0:32:27.94,0:32:31.28,Default,,0,0,0,,Егер сіз мұны істесеңіз, бұл тек мен немесе сіз емес.
Dialogue: 0,0:32:31.36,0:32:33.91,Default,,0,0,0,,Тіпті сол балалар да өшірілуі мүмкін.
Dialogue: 0,0:32:33.99,0:32:34.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:35.99,0:32:36.82,Default,,0,0,0,,Онда жоқ!
Dialogue: 0,0:32:36.91,0:32:38.33,Default,,0,0,0,,Сіз не істеп жатырсыз, доктор?
Dialogue: 0,0:32:38.41,0:32:40.75,Default,,0,0,0,,Хахаха сүйкімді
Dialogue: 0,0:32:40.83,0:32:42.33,Default,,0,0,0,,- Дәрігер! -(Ағаса) А?
Dialogue: 0,0:32:43.92,0:32:44.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:45.00,0:32:47.13,Default,,0,0,0,,Көгершін поппо
Dialogue: 0,0:32:47.21,0:32:49.17,Default,,0,0,0,,Бұл жерде емес, доктор.
Dialogue: 0,0:32:49.25,0:32:51.34,Default,,0,0,0,,Балалар қайда кетті?
Dialogue: 0,0:32:51.42,0:32:52.76,Default,,0,0,0,,А... А?
Dialogue: 0,0:32:52.84,0:32:54.97,Default,,0,0,0,,Сәлем, бұл Конан.
Dialogue: 0,0:32:55.05,0:32:57.14,Default,,0,0,0,,Бұлай шықпағаның дұрыс.
Dialogue: 0,0:32:57.22,0:32:59.14,Default,,0,0,0,,Сіз бәрібір ашуланасыз.
Dialogue: 0,0:32:59.22,0:33:00.35,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:33:00.43,0:33:01.56,Default,,0,0,0,,О, қараңдаршы
Dialogue: 0,0:33:01.64,0:33:03.85,Default,,0,0,0,,Көгершін ұшып кетті.
Dialogue: 0,0:33:03.94,0:33:05.02,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:33:05.10,0:33:06.44,Default,,0,0,0,,Менің әпкемді де көре аласыз ба?
Dialogue: 0,0:33:06.52,0:33:07.94,Default,,0,0,0,,Бұл үлкен сома.
Dialogue: 0,0:33:08.02,0:33:09.94,Default,,0,0,0,,Мен қазір телефонға жауап бере алмаймын.
Dialogue: 0,0:33:10.02,0:33:11.44,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:33:11.53,0:33:15.53,Default,,0,0,0,,Дөңгелегі шығар. Бұл балалар оны мінгісі келді.
Dialogue: 0,0:33:15.61,0:33:16.78,Default,,0,0,0,,Осындай кеш келу—
Dialogue: 0,0:33:16.86,0:33:19.45,Default,,0,0,0,,Мен жаңа ғана айттым, күте тұрыңыз.
Dialogue: 0,0:33:20.54,0:33:24.46,Default,,0,0,0,,Мүмкін сіздің әпкеңіз спорттың бір түрімен айналысқан шығар.
Dialogue: 0,0:33:24.54,0:33:25.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:25.58,0:33:27.92,Default,,0,0,0,,Әйтпесе, мен Гентаға солай қарайтын едім.
Dialogue: 0,0:33:28.00,0:33:29.42,Default,,0,0,0,,Мен сізге көмектесе алмаймын.
Dialogue: 0,0:33:29.50,0:33:32.42,Default,,0,0,0,,Мүмкін солай шығар, өйткені сенің әпкеңнің стилі жақсы.
Dialogue: 0,0:33:32.51,0:33:35.76,Default,,0,0,0,,Стиль? Менің ойымша, солай
Dialogue: 0,0:33:35.84,0:33:38.68,Default,,0,0,0,,Иә, ол супермодельге ұқсайды.
Dialogue: 0,0:33:38.76,0:33:41.76,Default,,0,0,0,,Уау, фонтан үлкенірек!
Dialogue: 0,0:33:41.85,0:33:43.68,Default,,0,0,0,,Ах, ол көтеріле береді.
Dialogue: 0,0:33:43.77,0:33:45.39,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:33:45.48,0:33:46.77,Default,,0,0,0,,Менің әпкемді де көре аласыз ба?
Dialogue: 0,0:33:46.85,0:33:48.19,Default,,0,0,0,,Иә, әдемі.
Dialogue: 0,0:33:48.86,0:33:51.98,Default,,0,0,0,,Әй, бәрі, төменге қараңдар.
Dialogue: 0,0:33:52.07,0:33:54.69,Default,,0,0,0,,Кемпірқосақ бар. Қараңызшы, апа, сіз де алдыға келіңіз.
Dialogue: 0,0:33:54.78,0:33:56.86,Default,,0,0,0,,Не? Иә
Dialogue: 0,0:33:56.95,0:33:58.61,Default,,0,0,0,,Уау...
Dialogue: 0,0:34:01.45,0:34:03.58,Default,,0,0,0,,А...
Dialogue: 0,0:34:05.25,0:34:06.91,Default,,0,0,0,,А, әпке, жақсы ма?
Dialogue: 0,0:34:07.00,0:34:08.12,Default,,0,0,0,,Не болды?
Dialogue: 0,0:34:08.21,0:34:10.79,Default,,0,0,0,,А... жарайды, басым айналып кетті.
Dialogue: 0,0:34:10.88,0:34:14.63,Default,,0,0,0,,Менің ойымша, сіз биіктікте жақсы емессіз.
Dialogue: 0,0:34:14.71,0:34:18.43,Default,,0,0,0,,Ой... ой, біз шыңға жетіп қалдық.
Dialogue: 0,0:34:18.51,0:34:19.89,Default,,0,0,0,,А, бұл рас.
Dialogue: 0,0:34:19.97,0:34:22.64,Default,,0,0,0,,О, мен көптен күттім!
Dialogue: 0,0:34:22.72,0:34:25.18,Default,,0,0,0,,Жоғарғы жағы, солай ма?
Dialogue: 0,0:34:26.02,0:34:27.69,Default,,0,0,0,,Керемет көрініс Керемет көрініс!
Dialogue: 0,0:34:27.77,0:34:29.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:30.52,0:34:33.65,Default,,0,0,0,,(Кюрасаоның ыңырануы)
Dialogue: 0,0:34:33.73,0:34:34.86,Default,,0,0,0,,Амансың ба, апа?
Dialogue: 0,0:34:35.49,0:34:37.20,Default,,0,0,0,,Әй, өзіңді дайында.
Dialogue: 0,0:34:37.28,0:34:38.53,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:34:38.61,0:34:40.62,Default,,0,0,0,,Күте тұрыңыз. Қазір көмек алыңыз.
Dialogue: 0,0:34:40.70,0:34:42.45,Default,,0,0,0,,- (Кюрасао) Тоқ... - (Гента) Аюми Мицухико!
Dialogue: 0,0:34:42.53,0:34:46.25,Default,,0,0,0,,Мен не істеуім керек? Әпкем біртүрлі нәрсе айтты.
Dialogue: 0,0:34:46.33,0:34:48.71,Default,,0,0,0,,- (Мицухико) Мүмкін бірдеңе есіңе түскен шығар - (Кюрасао) Тақыл...
Dialogue: 0,0:34:48.79,0:34:51.67,Default,,0,0,0,,Аюми-чан, қазір Конан-кунға қоңырау шалыңыз.
Dialogue: 0,0:34:51.75,0:34:52.59,Default,,0,0,0,,Иә
Dialogue: 0,0:34:52.67,0:34:54.96,Default,,0,0,0,,- (Мицухико) Гента-кун, сенің әпкең кім? -(Гента) А?
Dialogue: 0,0:34:55.05,0:34:57.51,Default,,0,0,0,,Есікті қағу
Dialogue: 0,0:34:57.59,0:35:00.09,Default,,0,0,0,,- (Мицухико) Бұл есік пе? - (Кюрасао) Киль Бурбон
Dialogue: 0,0:35:00.18,0:35:02.39,Default,,0,0,0,,Жүр, тағы бірдеңе айт.
Dialogue: 0,0:35:02.47,0:35:04.43,Default,,0,0,0,,Тынш, тыныш болшы, Гента-кун.
Dialogue: 0,0:35:04.51,0:35:06.72,Default,,0,0,0,,Стоут Аквавит…
Dialogue: 0,0:35:06.81,0:35:08.64,Default,,0,0,0,,Рислинг
Dialogue: 0,0:35:10.06,0:35:12.48,Default,,0,0,0,,Асығыңыз
Dialogue: 0,0:35:12.56,0:35:14.40,Default,,0,0,0,,Бұл қажет болды!
Dialogue: 0,0:35:14.48,0:35:17.07,Default,,0,0,0,,Ах
Dialogue: 0,0:35:17.15,0:35:18.11,Default,,0,0,0,,Не болды?
Dialogue: 0,0:35:18.19,0:35:20.15,Default,,0,0,0,,Бұл телефон қоңырауы. Мүмкін...
Dialogue: 0,0:35:20.24,0:35:21.41,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:35:22.37,0:35:23.74,Default,,0,0,0,,Мицухико Сен!
Dialogue: 0,0:35:23.83,0:35:26.04,Default,,0,0,0,,Конан-кун, маған көмектес
Dialogue: 0,0:35:26.12,0:35:27.20,Default,,0,0,0,,Аюми, не болды?
Dialogue: 0,0:35:27.29,0:35:31.37,Default,,0,0,0,,Дөңгелекті айдап келе жатқанда үлкен әпкем сырқаттанып қалды.
Dialogue: 0,0:35:31.46,0:35:33.58,Default,,0,0,0,,Не? Сонда оның жағдайы қандай?
Dialogue: 0,0:35:33.67,0:35:34.71,Default,,0,0,0,,Не? Ал...
Dialogue: 0,0:35:35.50,0:35:37.42,Default,,0,0,0,,Ауырсынып басымды ұстап тұрмын.
Dialogue: 0,0:35:37.51,0:35:40.01,Default,,0,0,0,,Ол бірдеңе айтып жатыр, бірақ мен оның не айтқысы келгенін түсінбеймін.
Dialogue: 0,0:35:40.09,0:35:41.47,Default,,0,0,0,,Мен жазып жатырмын.
Dialogue: 0,0:35:41.55,0:35:43.43,Default,,0,0,0,,Мицухико жазып жатыр.
Dialogue: 0,0:35:43.51,0:35:44.35,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:35:44.43,0:35:47.85,Default,,0,0,0,,Конан-кун, маған тез көмектесіңізші.
Dialogue: 0,0:35:54.52,0:35:57.11,Default,,0,0,0,,Конан-кун, ол әйел кім?
Dialogue: 0,0:35:57.19,0:35:59.07,Default,,0,0,0,,Қазір емханадан жеткізіледі.
Dialogue: 0,0:35:59.15,0:36:01.74,Default,,0,0,0,,- (Сато) Такаги-кун, кеттік - (Такаги) Иә.
Dialogue: 0,0:36:01.82,0:36:04.95,Default,,0,0,0,,Доктор Хайбара, өтінемін
Dialogue: 0,0:36:05.03,0:36:06.33,Default,,0,0,0,,Сонда біз де.
Dialogue: 0,0:36:06.41,0:36:09.00,Default,,0,0,0,,Жоқ, мүлдем жоқ
Dialogue: 0,0:36:18.59,0:36:20.21,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:36:20.30,0:36:22.47,Default,,0,0,0,,О, мұнда келші.
Dialogue: 0,0:36:22.55,0:36:24.39,Default,,0,0,0,,Жоғарыда айтқанымдай
Dialogue: 0,0:36:24.47,0:36:28.06,Default,,0,0,0,,Біз, полиция, оны қамқорлыққа аламыз.
Dialogue: 0,0:36:28.14,0:36:30.06,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:36:30.14,0:36:33.39,Default,,0,0,0,,Оны бұдан былай апаратын полиция ауруханасына.
Dialogue: 0,0:36:33.48,0:36:35.23,Default,,0,0,0,,Мен сізге бір нәрсе айтқым келеді.
Dialogue: 0,0:36:35.90,0:36:37.65,Default,,0,0,0,,Кім есте сақтау қабілетін жоғалтты?
Dialogue: 0,0:36:37.73,0:36:42.19,Default,,0,0,0,,Себеп басына қатты соққы болғаны даусыз.
Dialogue: 0,0:36:42.28,0:36:43.28,Default,,0,0,0,,Жоспар
Dialogue: 0,0:36:43.36,0:36:47.99,Default,,0,0,0,,Форниксте өте ерекше жарақат табылды.
Dialogue: 0,0:36:48.08,0:36:49.54,Default,,0,0,0,,Тек осы бөлім
Dialogue: 0,0:36:49.62,0:36:52.04,Default,,0,0,0,,Бұл Юбе апатынан алған жарақат емес пе?
Dialogue: 0,0:36:52.12,0:36:55.75,Default,,0,0,0,,Иә, бұл тумысынан туған нәрсе шығар.
Dialogue: 0,0:36:55.83,0:36:57.67,Default,,0,0,0,,Бұл шабуылмен қандай байланыс бар?
Dialogue: 0,0:36:57.75,0:37:00.96,Default,,0,0,0,,Әй, бұл күнделікті өмірге кедергі болатын нәрсе емес.
Dialogue: 0,0:37:01.05,0:37:02.80,Default,,0,0,0,,Менің ойымша, бұл маңызды емес.
Dialogue: 0,0:37:02.88,0:37:05.80,Default,,0,0,0,,Түсіндім, мен сізге хабарлаймын.
Dialogue: 0,0:37:05.89,0:37:08.01,Default,,0,0,0,,- (Сато) Сонымен - (Дәрігер) Ой, күте тұрыңыз.
Dialogue: 0,0:37:08.10,0:37:09.56,Default,,0,0,0,,Тағы бір нәрсе.
Dialogue: 0,0:37:09.64,0:37:14.31,Default,,0,0,0,,Тексеру кезінде оның оң көзінде екенін білдік.
Dialogue: 0,0:37:14.98,0:37:16.77,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:37:16.85,0:37:17.98,Default,,0,0,0,,Бұл түсті контактілі линзаларға ұқсайды
Dialogue: 0,0:37:18.06,0:37:21.53,Default,,0,0,0,,Иә, көзді қара етіп көрсету үшін.
Dialogue: 0,0:37:21.61,0:37:23.36,Default,,0,0,0,,Бұл түсті контактілі линза.
Dialogue: 0,0:37:23.44,0:37:24.20,Default,,0,0,0,,Бұл туралы
Dialogue: 0,0:37:24.20,0:37:25.78,Default,,0,0,0,,Бұл туралы
Dialogue: 0,0:37:24.20,0:37:25.78,Default,,0,0,0,,...Сондықтан мен бұл біртүрлі көз немесе протездік көз деп ойладым.
Dialogue: 0,0:37:25.78,0:37:25.86,Default,,0,0,0,,...Сондықтан мен бұл біртүрлі көз немесе протездік көз деп ойладым.
Dialogue: 0,0:37:25.86,0:37:27.57,Default,,0,0,0,,...Сондықтан мен бұл біртүрлі көз немесе протездік көз деп ойладым.
Dialogue: 0,0:37:25.86,0:37:27.57,Default,,0,0,0,,Есте сақтау қабілетінің төмендеуі және талма дегеніміз не?
Dialogue: 0,0:37:27.66,0:37:29.37,Default,,0,0,0,,Бұл біздің түсінбеуіміз болды ма?
Dialogue: 0,0:37:27.66,0:37:29.37,Default,,0,0,0,,Бұл мүлдем қатысы жоқ.
Dialogue: 0,0:37:29.45,0:37:32.20,Default,,0,0,0,,Мен жай ғана сізге хабарлауды жөн көрдім.
Dialogue: 0,0:37:32.29,0:37:33.54,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:37:33.62,0:37:34.66,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:37:34.75,0:37:37.50,Default,,0,0,0,,Тасымалдауға дайын
Dialogue: 0,0:37:37.58,0:37:40.00,Default,,0,0,0,,- (Сато) Ендеше, біз мұны да істей аламыз - (Дәрігер) Иә.
Dialogue: 0,0:37:40.80,0:37:42.55,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:37:43.97,0:37:47.80,Default,,0,0,0,,Иә? Мен сенімен баруым керек пе?
Dialogue: 0,0:37:47.89,0:37:48.97,Default,,0,0,0,,Мұғалімге иә
Dialogue: 0,0:37:49.05,0:37:51.10,Default,,0,0,0,,Мен сізден тағы бір сұрағым келеді.
Dialogue: 0,0:37:51.18,0:37:52.18,Default,,0,0,0,,Хаха не?
Dialogue: 0,0:37:52.26,0:37:55.39,Default,,0,0,0,,Мен жоғарыда айтқан түрлі-түсті контактілер туралы айтып отырмын.
Dialogue: 0,0:37:55.48,0:37:58.23,Default,,0,0,0,,Тек бір жағы қара болып көрінетіні
Dialogue: 0,0:37:58.31,0:38:01.19,Default,,0,0,0,,Әпкеңнің көзі бастапқыда көгілдір болған, солай ма?
Dialogue: 0,0:38:01.27,0:38:04.40,Default,,0,0,0,,Иә, сондықтан оң көз ғана мөлдір болды.
Dialogue: 0,0:38:04.49,0:38:05.32,Default,,0,0,0,,Мөлдір?
Dialogue: 0,0:38:05.40,0:38:09.66,Default,,0,0,0,,Жоқ, мөлдір көрінеді деу дұрысырақ болар еді.
Dialogue: 0,0:38:09.74,0:38:11.70,Default,,0,0,0,,Бұл өте сирек.
Dialogue: 0,0:38:11.78,0:38:15.58,Default,,0,0,0,,Өйткені ирис склераның түсімен дерлік бірдей.
Dialogue: 0,0:38:15.66,0:38:17.83,Default,,0,0,0,,Ол мөлдір көрінетін адам деп ойлаймын.
Dialogue: 0,0:38:17.92,0:38:18.92,Default,,0,0,0,,Секір!!
Dialogue: 0,0:38:18.92,0:38:19.54,Default,,0,0,0,,Секір!!
Dialogue: 0,0:38:18.92,0:38:19.54,Default,,0,0,0,,Хаха, бұл біраз қиын болды деп ойлаймын.
Dialogue: 0,0:38:19.54,0:38:19.63,Default,,0,0,0,,Хаха, бұл біраз қиын болды деп ойлаймын.
Dialogue: 0,0:38:19.63,0:38:21.84,Default,,0,0,0,,Хаха, бұл біраз қиын болды деп ойлаймын.
Dialogue: 0,0:38:19.63,0:38:21.84,Default,,0,0,0,,Сол және оң көздің түсі әртүрлі болуының айырмашылығы бар ма?
Dialogue: 0,0:38:21.84,0:38:21.92,Default,,0,0,0,,Сол және оң көздің түсі әртүрлі болуының айырмашылығы бар ма?
Dialogue: 0,0:38:21.92,0:38:23.55,Default,,0,0,0,,Сол және оң көздің түсі әртүрлі болуының айырмашылығы бар ма?
Dialogue: 0,0:38:21.92,0:38:23.55,Default,,0,0,0,,Оны аздап нақтырақ түсіндірейін...
Dialogue: 0,0:38:23.55,0:38:24.26,Default,,0,0,0,,Оны аздап нақтырақ түсіндірейін...
Dialogue: 0,0:38:24.34,0:38:28.43,Default,,0,0,0,,Мұғалім, бүгінгі күн үшін барлығы үшін көп рахмет.
Dialogue: 0,0:38:28.51,0:38:29.72,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:38:29.80,0:38:32.01,Default,,0,0,0,,Иә, сау болыңыз
Dialogue: 0,0:38:32.10,0:38:33.22,Default,,0,0,0,,Иә, абай болыңыз.
Dialogue: 0,0:38:33.31,0:38:34.97,Default,,0,0,0,,- (Когоро) Міне! - (Конан/Дәрігер) Иә?
Dialogue: 0,0:38:35.06,0:38:38.39,Default,,0,0,0,,Менің клиентім... Иә?
Dialogue: 0,0:38:38.48,0:38:41.69,Default,,0,0,0,,Тұтынушы Бұл аймаққа қатысы барлардан басқа ешкімге тыйым салынады.
Dialogue: 0,0:38:41.77,0:38:45.69,Default,,0,0,0,,Сол себепті мен туыспын деп отырсыз.
Dialogue: 0,0:38:45.78,0:38:47.90,Default,,0,0,0,,- Когороның ағасы - (Когоро) А?
Dialogue: 0,0:38:47.99,0:38:49.57,Default,,0,0,0,,Не істеп жүрсің?
Dialogue: 0,0:38:49.66,0:38:51.41,Default,,0,0,0,,Бала, бұл дұрыс болды.
Dialogue: 0,0:38:52.07,0:38:54.70,Default,,0,0,0,,Менің сұлу клиентім қайда?
Dialogue: 0,0:38:54.79,0:38:56.50,Default,,0,0,0,,Ол кетті
Dialogue: 0,0:38:57.33,0:39:00.62,Default,,0,0,0,,Оны жаңа ғана полиция ауруханасына жеткізді.
Dialogue: 0,0:39:00.71,0:39:03.04,Default,,0,0,0,,Оның үстіне сіздің әпкеңіз клиент емес.
Dialogue: 0,0:39:03.13,0:39:04.09,Default,,0,0,0,,Не?
Dialogue: 0,0:39:04.17,0:39:08.17,Default,,0,0,0,,Сен Ранни Чанның айтқанын тыңдамадың.
Dialogue: 0,0:39:08.26,0:39:10.51,Default,,0,0,0,,Сіз әлі осындасыз ба?
Dialogue: 0,0:39:10.59,0:39:12.01,Default,,0,0,0,,Біраздан соң—
Dialogue: 0,0:39:19.52,0:39:20.73,Default,,0,0,0,,Чип! Чип, чип, чип, чип!
Dialogue: 0,0:39:20.81,0:39:21.90,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:39:22.48,0:39:26.94,Default,,0,0,0,,Мен бірдеңе дұрыс емес деп ойладым, бірақ ол есте сақтау қабілетін жоғалтқан сияқты.
Dialogue: 0,0:39:27.03,0:39:29.90,Default,,0,0,0,,Енді қайдасың?
Dialogue: 0,0:39:29.99,0:39:32.53,Default,,0,0,0,,Мені полиция ауруханасына жеткізді.
Dialogue: 0,0:39:32.62,0:39:34.95,Default,,0,0,0,,Сонда полиция да қозғала бастады ма?
Dialogue: 0,0:39:35.53,0:39:38.41,Default,,0,0,0,,Иә, мені тағы бір нәрсе қызықтырды.
Dialogue: 0,0:39:38.50,0:39:39.58,Default,,0,0,0,,Не?
Dialogue: 0,0:39:39.66,0:39:44.17,Default,,0,0,0,,Дөңгелекті айдап келе жатқанда талмасы бар болса керек.
Dialogue: 0,0:39:44.25,0:39:45.71,Default,,0,0,0,,-Ұстама? -Иә
Dialogue: 0,0:39:45.80,0:39:49.51,Default,,0,0,0,,Жарайды, сіз бақылауды жалғастырасыз.
Dialogue: 0,0:39:49.59,0:39:50.97,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:39:51.55,0:39:55.05,Default,,0,0,0,,Дөңгелектегі ұстама... Әйтеуір.
Dialogue: 0,0:39:56.18,0:39:59.77,Default,,0,0,0,,Хайбара апасын неге сонша жек көреді?
Dialogue: 0,0:39:59.85,0:40:03.06,Default,,0,0,0,,Мен бұрынғыдан да ашуландым.
Dialogue: 0,0:40:03.81,0:40:06.61,Default,,0,0,0,,Дәрігердің неге ашуланғанын білмейсің бе?
Dialogue: 0,0:40:06.69,0:40:08.61,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:40:08.69,0:40:12.49,Default,,0,0,0,,Оның себебін сұрағанымда, ол жай ғана көңіл-күйінің жоқтығын айтып, үйіне кетті.
Dialogue: 0,0:40:12.57,0:40:15.91,Default,,0,0,0,,Аюми-чан, дәрігерден сұраудың қажеті жоқ.
Dialogue: 0,0:40:15.99,0:40:19.91,Default,,0,0,0,,Дұрыс, дәрігер үнемі ашулы.
Dialogue: 0,0:40:20.00,0:40:21.16,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:40:21.25,0:40:22.29,Default,,0,0,0,,Тохохохо
Dialogue: 0,0:40:22.37,0:40:26.79,Default,,0,0,0,,Дұрыс, мен мұны Конан-куннан алдым.
Dialogue: 0,0:40:26.88,0:40:29.00,Default,,0,0,0,,- (Аюми/Гента) Ах! -(Мицухико) Бұл...
Dialogue: 0,0:40:29.09,0:40:31.63,Default,,0,0,0,,Бұл қуыршақты дартс дүкенінен алуға болады.
Dialogue: 0,0:40:32.51,0:40:34.89,Default,,0,0,0,,Бірақ неге бұл түсті емес?
Dialogue: 0,0:40:34.97,0:40:38.72,Default,,0,0,0,,А, Конан-кун бірдеңе деді, бірақ ұмытып кетіппін.
Dialogue: 0,0:40:38.81,0:40:39.72,Default,,0,0,0,,Иә~
Dialogue: 0,0:40:39.81,0:40:42.10,Default,,0,0,0,,Жетеді, тіке сұрайын.
Dialogue: 0,0:40:42.18,0:40:44.98,Default,,0,0,0,,Иә? Ол кім?
Dialogue: 0,0:40:45.06,0:40:47.82,Default,,0,0,0,,Әй, өсек айтсаң, бұл Конан-кун.
Dialogue: 0,0:40:48.69,0:40:49.53,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:40:49.61,0:40:52.53,Default,,0,0,0,,Дәрігер, сіз әлі балалармен біргесіз бе?
Dialogue: 0,0:40:52.61,0:40:55.78,Default,,0,0,0,,А, мен жаңа ғана Пуарода шай ішіп алдым.
Dialogue: 0,0:40:55.87,0:40:58.78,Default,,0,0,0,,Жарайды, сізден сұрайын дегенім дәрігердің өтініші.
Dialogue: 0,0:40:58.87,0:41:01.29,Default,,0,0,0,,Ең бастысы, бұл әйел жақсы ма?
Dialogue: 0,0:41:01.37,0:41:05.54,Default,,0,0,0,,А, мені жаңа ғана полиция ауруханасына алып кетті.
Dialogue: 0,0:41:06.25,0:41:07.29,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:41:07.38,0:41:08.63,Default,,0,0,0,,Жақсы
Dialogue: 0,0:41:08.71,0:41:10.63,Default,,0,0,0,,Бәріміз бір-бірімізді көруге баруымыз керек.
Dialogue: 0,0:41:08.71,0:41:10.63,Default,,0,0,0,,Сонда сіз менен жақсылық сұрадыңыз ба?
Dialogue: 0,0:41:10.63,0:41:10.71,Default,,0,0,0,,Сонда сіз менен жақсылық сұрадыңыз ба?
Dialogue: 0,0:41:10.71,0:41:11.34,Default,,0,0,0,,Сонда сіз менен жақсылық сұрадыңыз ба?
Dialogue: 0,0:41:10.71,0:41:11.34,Default,,0,0,0,,Иә
Dialogue: 0,0:41:11.34,0:41:11.42,Default,,0,0,0,,Иә
Dialogue: 0,0:41:11.42,0:41:11.92,Default,,0,0,0,,Иә
Dialogue: 0,0:41:11.42,0:41:11.92,Default,,0,0,0,,Қолындағы смартфон
Dialogue: 0,0:41:11.92,0:41:12.88,Default,,0,0,0,,Қолында болған смартфон
Dialogue: 0,0:41:12.97,0:41:15.38,Default,,0,0,0,,Ішкі деректерді жөндегеніңізді қалаймын.
Dialogue: 0,0:41:15.47,0:41:19.89,Default,,0,0,0,,Бұл дұрыс, бірақ бұл оны толығымен жөндеуге болатынын білдірмейді.
Dialogue: 0,0:41:19.97,0:41:21.93,Default,,0,0,0,,О, және
Dialogue: 0,0:41:22.02,0:41:26.48,Default,,0,0,0,,Менің ойымша, ол айналмалы дөңгелегі ұстағанда бірдеңе деді.
Dialogue: 0,0:41:26.56,0:41:28.06,Default,,0,0,0,,Мазмұнын білгім келеді.
Dialogue: 0,0:41:28.15,0:41:30.48,Default,,0,0,0,,А, онда ортасынан бастайық.
Dialogue: 0,0:41:30.57,0:41:32.48,Default,,0,0,0,,Мен тиісті жазбаларды алдым.
Dialogue: 0,0:41:32.57,0:41:36.36,Default,,0,0,0,,Ал, «қатты акваит»
Dialogue: 0,0:41:36.45,0:41:39.87,Default,,0,0,0,,Және ол «Рислинг» деп аталды.
Dialogue: 0,0:41:39.95,0:41:40.62,Default,,0,0,0,,Сакенің аты не? Амал жоқ
Dialogue: 0,0:41:40.62,0:41:42.29,Default,,0,0,0,,Сакенің аты не? Амал жоқ
Dialogue: 0,0:41:40.62,0:41:42.29,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:41:42.29,0:41:42.37,Default,,0,0,0,,Сакенің аты қандай? Амал жоқ
Dialogue: 0,0:41:42.37,0:41:44.04,Default,,0,0,0,,Сакенің аты не? Амал жоқ
Dialogue: 0,0:41:42.37,0:41:44.04,Default,,0,0,0,,Түсіндің бе? Конан-кун
Dialogue: 0,0:41:44.12,0:41:46.00,Default,,0,0,0,,Дәрігер, сіз Пуарода болдыңыз.
Dialogue: 0,0:41:46.08,0:41:48.17,Default,,0,0,0,,Иә? О
Dialogue: 0,0:41:48.25,0:41:49.96,Default,,0,0,0,,Олай болса Амуро-санның орнына отырыңыз.
Dialogue: 0,0:41:50.04,0:41:50.88,Default,,0,0,0,,Ах
Dialogue: 0,0:41:50.96,0:41:55.34,Default,,0,0,0,,Амуро-сан? Ойлап қарасам, бүгін көрмеймін.
Dialogue: 0,0:41:55.42,0:41:57.38,Default,,0,0,0,,Егер сіз Амуро мырза болсаңыз, бүгін сіздің демалысыңыз.
Dialogue: 0,0:41:57.47,0:41:58.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:59.09,0:42:02.93,Default,,0,0,0,,Бүгін таңертең маған кенет телефон қоңырауы келіп, үзіліс жасауымды өтінді, міне, солай болды.
Dialogue: 0,0:42:03.68,0:42:07.52,Default,,0,0,0,,Мен бірнеше рет қайта қоңырау шалуға тырыстым, бірақ хабарласа алмадым, сондықтан мен уайымдадым.
Dialogue: 0,0:42:08.31,0:42:09.73,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:42:09.81,0:42:13.57,Default,,0,0,0,,Мен бұл ештеңе емес деп үміттенемін, бірақ мен алаңдаймын.
Dialogue: 0,0:42:15.28,0:42:17.61,Default,,0,0,0,,Амуро мырза, болмайды...
Dialogue: 0,0:42:22.03,0:42:25.75,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:42:34.46,0:42:36.84,Default,,0,0,0,,(ағылшынша "қатты" деген сөз)
Dialogue: 0,0:42:36.92,0:42:39.09,Default,,0,0,0,,(Жүгері ағылшын тілі)
Dialogue: 0,0:42:39.18,0:42:40.39,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:42:44.18,0:42:45.22,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:42:49.85,0:42:55.65,Default,,0,0,0,,Мен саған сендім. Әттең.
Dialogue: 0,0:42:57.74,0:42:59.24,Default,,0,0,0,,Өлді
Dialogue: 0,0:42:59.32,0:43:01.28,Default,,0,0,0,,Жарайды, тезірек орал.
Dialogue: 0,0:43:01.37,0:43:02.45,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:43:03.83,0:43:07.08,Default,,0,0,0,,(Тікұшақ роторының дыбысы)
Dialogue: 0,0:43:09.00,0:43:14.55,Default,,0,0,0,,(ағылшын тілінде Aquavit)
Dialogue: 0,0:43:26.77,0:43:27.89,Default,,0,0,0,,(Қонақтың ағылшын тілі)
Dialogue: 0,0:43:29.85,0:43:32.56,Default,,0,0,0,,(ағылшынша)
Dialogue: 0,0:43:32.65,0:43:33.48,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:43:36.23,0:43:37.78,Default,,0,0,0,,Бұл жалықтырады, кішкентай бүлікші.
Dialogue: 0,0:43:40.90,0:43:41.99,Default,,0,0,0,,(Қонақтар қолдайды)
Dialogue: 0,0:43:44.07,0:43:45.99,Default,,0,0,0,,(Тікұшақ роторының дыбысы)
Dialogue: 0,0:43:46.08,0:43:48.50,Default,,0,0,0,,Хмф, еш қиындық жоқ.
Dialogue: 0,0:43:48.58,0:43:51.54,Default,,0,0,0,,Барлаушыға лайықты өлім.
Dialogue: 0,0:43:52.42,0:43:54.25,Default,,0,0,0,,Мен Аквавитті өлтірдім.
Dialogue: 0,0:43:54.34,0:43:56.63,Default,,0,0,0,,Күтілгендей, тезірек оралыңыз.
Dialogue: 0,0:43:56.71,0:43:59.97,Default,,0,0,0,,Цк, сен айтпасаң да істеймін.
Dialogue: 0,0:44:03.72,0:44:06.51,Default,,0,0,0,,(Рислинг ауыр тыныс алу)
Dialogue: 0,0:44:06.60,0:44:08.02,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:44:08.10,0:44:10.77,Default,,0,0,0,,Ей, сен қаншаға барасың?
Dialogue: 0,0:44:10.85,0:44:13.69,Default,,0,0,0,,Сізге бір минут уақытыңыз бар екенін айтуым керек еді.
Dialogue: 0,0:44:13.77,0:44:16.69,Default,,0,0,0,,Мен қаққан жоқпын дедім
Dialogue: 0,0:44:16.77,0:44:19.65,Default,,0,0,0,,Олай болса неге оны ақ-қара етіп жасамасқа?
Dialogue: 0,0:44:22.99,0:44:25.91,Default,,0,0,0,,Сәлем, Рислинг
Dialogue: 0,0:44:25.99,0:44:27.24,Default,,0,0,0,,Джин
Dialogue: 0,0:44:28.12,0:44:32.04,Default,,0,0,0,,Қарсы жақ пен осы жақтың позицияларын нақтылау керек пе?
Dialogue: 0,0:44:32.12,0:44:33.29,Default,,0,0,0,,Ha
Dialogue: 0,0:44:33.37,0:44:38.09,Default,,0,0,0,,Сізбен араласқан егеуқұйрықты атаңыз.
Dialogue: 0,0:44:39.09,0:44:41.63,Default,,0,0,0,,Тек қазір құсыңыз. Сіз қиналғыңыз келмейді, солай ма?
Dialogue: 0,0:44:42.30,0:44:43.88,Default,,0,0,0,,Мені қайта-қайта айтуға мәжбүрлеме
Dialogue: 0,0:44:43.97,0:44:45.26,Default,,0,0,0,,Мен қағып жатқан жоқпын
Dialogue: 0,0:44:45.34,0:44:46.64,Default,,0,0,0,,Джин сені қорқытудың қажеті жоқ.
Dialogue: 0,0:44:47.60,0:44:51.73,Default,,0,0,0,,Қауіп? Қалай ойлайсың, мен осындай сүйкімді нәрсе жасаймын ба?
Dialogue: 0,0:44:52.81,0:44:55.65,Default,,0,0,0,,５… ４…
Dialogue: 0,0:44:56.31,0:44:57.56,Default,,0,0,0,,３…
Dialogue: 0,0:44:58.07,0:44:59.40,Default,,0,0,0,,２…
Dialogue: 0,0:45:00.32,0:45:01.36,Default,,0,0,0,,１…
Dialogue: 0,0:45:01.82,0:45:03.11,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:45:03.82,0:45:05.53,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:45:06.45,0:45:08.87,Default,,0,0,0,,(Өзенге құлау дыбысы)
Dialogue: 0,0:45:21.09,0:45:23.09,Default,,0,0,0,,Кеттік, тез!
Dialogue: 0,0:45:23.17,0:45:24.80,Default,,0,0,0,,А... қай жолмен?
Dialogue: 0,0:45:24.88,0:45:27.01,Default,,0,0,0,,-Жапония. -Хмм? Амал жоқ...
Dialogue: 0,0:45:28.01,0:45:31.81,Default,,0,0,0,,Бар болғаны екі адам қалды.
Dialogue: 0,0:45:37.15,0:45:41.19,Default,,0,0,0,,Британдық MI6 Канадалық CSIS
Dialogue: 0,0:45:41.28,0:45:42.28,Default,,0,0,0,,Неміс BND
Dialogue: 0,0:45:42.94,0:45:46.20,Default,,0,0,0,,Әртүрлі елдердің барлау қызметкерлері бірінен соң бірі өлтірілді.
Dialogue: 0,0:45:46.28,0:45:47.32,Default,,0,0,0,,Аа, мүмкін емес...
Dialogue: 0,0:45:47.41,0:45:49.78,Default,,0,0,0,,Иә, олардың ортақтығы бар
Dialogue: 0,0:45:49.87,0:45:52.24,Default,,0,0,0,,Қарастырылып отырған ұйымға ену
Dialogue: 0,0:45:52.33,0:45:55.21,Default,,0,0,0,,Сонда қара киімді жігіттер ше?
Dialogue: 0,0:45:55.29,0:45:57.00,Default,,0,0,0,,Ұйымның агенті
Dialogue: 0,0:45:57.08,0:46:00.09,Default,,0,0,0,,Ұлттық полиция агенттігінен деректер ұрланды деген күдік бар.
Dialogue: 0,0:46:00.17,0:46:02.63,Default,,0,0,0,,Ақай мырзадан хабар алдым.
Dialogue: 0,0:46:03.67,0:46:05.67,Default,,0,0,0,,Ұйымның агенттері
Dialogue: 0,0:46:06.30,0:46:07.63,Default,,0,0,0,,Мұғалім Джоди
Dialogue: 0,0:46:07.72,0:46:09.01,Default,,0,0,0,,Мені шақырған адам
Dialogue: 0,0:46:09.09,0:46:12.76,Default,,0,0,0,,Себебі сіз агент болып көрінетін адаммен байланыста болдыңыз, солай ма?
Dialogue: 0,0:46:12.85,0:46:13.68,Default,,0,0,0,,Иә
Dialogue: 0,0:46:13.77,0:46:15.10,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:46:15.18,0:46:17.35,Default,,0,0,0,,Бірақ оның амнезиясы бар.
Dialogue: 0,0:46:17.44,0:46:20.06,Default,,0,0,0,,Сақтау құралы ретінде пайдалануға болатын смартфоным да бұзылды.
Dialogue: 0,0:46:20.15,0:46:23.44,Default,,0,0,0,,Смартфон? Ол болды ма?
Dialogue: 0,0:46:23.53,0:46:26.95,Default,,0,0,0,,Иә, мен оны орындықта қалдырдым, сондықтан мен оны ұстадым.
Dialogue: 0,0:46:27.03,0:46:30.70,Default,,0,0,0,,Бұл жағдайда сіз оны ФБР штаб-пәтеріне талдау үшін жіберуіңіз керек.
Dialogue: 0,0:46:30.78,0:46:31.91,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:46:31.99,0:46:32.91,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:46:32.99,0:46:35.62,Default,,0,0,0,,Дәрігер жақын арада қалпына келетінін айтты.
Dialogue: 0,0:46:35.70,0:46:37.75,Default,,0,0,0,,Осылай жалғастырсаңыз, жылдамырақ болар еді.
Dialogue: 0,0:46:37.83,0:46:41.17,Default,,0,0,0,,Енді оны талдай алсаңыз, маған хабарлаңыз.
Dialogue: 0,0:46:41.25,0:46:45.42,Default,,0,0,0,,Біз мүмкіндігінше тезірек қанша ақпараттың ағып кеткенін анықтауымыз керек.
Dialogue: 0,0:46:45.51,0:46:48.01,Default,,0,0,0,,Дүние дүрбелеңде
Dialogue: 0,0:46:48.09,0:46:51.22,Default,,0,0,0,,Не, қандай деректер ұрланды?
Dialogue: 0,0:46:51.30,0:46:53.06,Default,,0,0,0,,Ресми емес мұқаба
Dialogue: 0,0:46:53.72,0:46:54.56,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:46:54.64,0:46:56.93,Default,,0,0,0,,Иә, Noklist.
Dialogue: 0,0:46:57.02,0:47:00.40,Default,,0,0,0,,Бұл Ұлттық полиция агенттігінде бар дүние жүзіндегі барлаушылардың тізімі.
Dialogue: 0,0:47:00.48,0:47:05.69,Default,,0,0,0,,...Бұл ұйымға енген барлық тыңшылар жойылады деген сөз.
Dialogue: 0,0:47:05.78,0:47:07.03,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:47:07.61,0:47:09.57,Default,,0,0,0,,Тапсырмалар тізімі жарияланғаннан кейін
Dialogue: 0,0:47:09.66,0:47:12.87,Default,,0,0,0,,Дүние жүзіндегі барлау агенттіктері күйреуі мүмкін.
Dialogue: 0,0:47:12.95,0:47:18.04,Default,,0,0,0,,Бұл олардың барлау соғысының кілті екенін білдіре ме?
Dialogue: 0,0:47:18.12,0:47:20.25,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:47:20.33,0:47:22.75,Default,,0,0,0,,Бұл үш қастандық
Dialogue: 0,0:47:22.84,0:47:26.26,Default,,0,0,0,,Мүмкін бұл тек бастамасы шығар
Dialogue: 0,0:47:35.47,0:47:37.27,Default,,0,0,0,,Сіз шынымен келдіңіз.
Dialogue: 0,0:47:37.35,0:47:41.31,Default,,0,0,0,,Бірақ оны Ай Чан мен Конан Куннан құпия ұстаған дұрыс шығар.
Dialogue: 0,0:47:41.40,0:47:45.48,Default,,0,0,0,,Жақсы, егер оларға айтсаң, олар жоқ деп жауап береді.
Dialogue: 0,0:47:45.57,0:47:48.90,Default,,0,0,0,,Әзірше, кеттік. Кездесе аламыз ба білмеймін.
Dialogue: 0,0:47:48.99,0:47:49.90,Default,,0,0,0,,Иә
Dialogue: 0,0:47:50.49,0:47:54.78,Default,,0,0,0,,Иә, Тото полициясының ауруханасы.
Dialogue: 0,0:47:55.49,0:47:59.00,Default,,0,0,0,,Бірдеңе болса қарсы емеспін, деп Казамиден сұрадым.
Dialogue: 0,0:47:59.08,0:48:00.12,Default,,0,0,0,,Иә
Dialogue: 0,0:48:00.21,0:48:01.04,Default,,0,0,0,,Я...
Dialogue: 0,0:48:07.92,0:48:10.84,Default,,0,0,0,,Бурбон мұнда не үшін келдің?
Dialogue: 0,0:48:10.92,0:48:13.84,Default,,0,0,0,,Әрине, оны қайтару үшін.
Dialogue: 0,0:48:13.93,0:48:19.22,Default,,0,0,0,,Әй, есіңіз оралмай тұрып, ол кісінің аузын жабуға келдім деп ойладым.
Dialogue: 0,0:48:19.98,0:48:21.73,Default,,0,0,0,,Неліктен мен мұны істеймін?
Dialogue: 0,0:48:22.31,0:48:24.73,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:48:24.81,0:48:27.65,Default,,0,0,0,,Сонымен, сіз менімен қалай байланысуды жоспарлайсыз?
Dialogue: 0,0:48:27.73,0:48:31.32,Default,,0,0,0,,Бұл адамға қатаң қауіпсіздік жағдайында сізбен кездесуге рұқсат етілмейді.
Dialogue: 0,0:48:31.40,0:48:34.99,Default,,0,0,0,,Немесе сіз оны оңай кездестіре аласыз ба?
Dialogue: 0,0:48:35.07,0:48:39.12,Default,,0,0,0,,Мысалы, полициямен арнайы байланысыңыз болса да.
Dialogue: 0,0:48:39.20,0:48:42.62,Default,,0,0,0,,Сіз біраз уақыттан бері не туралы айттыңыз?
Dialogue: 0,0:48:42.71,0:48:43.87,Default,,0,0,0,,Толық түсінгенім жоқ, бірақ—
Dialogue: 0,0:48:43.96,0:48:47.50,Default,,0,0,0,,Тұрып сөйлеудің не керегі бар? Орындарды ауыстырайық.
Dialogue: 0,0:48:49.09,0:48:53.26,Default,,0,0,0,,Егер бұл ұйымның бұйрығы болса, оған көмектесу мүмкін емес.
Dialogue: 0,0:48:57.35,0:48:58.39,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:48:58.47,0:49:01.27,Default,,0,0,0,,Жоқ, мен ешкімді кездестіре алмаймын.
Dialogue: 0,0:49:01.35,0:49:02.64,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:49:02.73,0:49:04.69,Default,,0,0,0,,Сіз шынымен де ауырып жатырсыз ба?
Dialogue: 0,0:49:04.77,0:49:07.61,Default,,0,0,0,,Мұны растау қажет.
Dialogue: 0,0:49:07.69,0:49:09.78,Default,,0,0,0,,Не? Бірақ қалай?
Dialogue: 0,0:49:09.86,0:49:11.07,Default,,0,0,0,,- (Мицухико) Бұл - (Гента) Уау!
Dialogue: 0,0:49:11.15,0:49:12.03,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:49:12.11,0:49:15.03,Default,,0,0,0,,Иә, ол біздің мықты одақтасымыз.
Dialogue: 0,0:49:18.66,0:49:22.04,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:49:22.12,0:49:23.33,Default,,0,0,0,,-Доктор-(Агаса) Иә?
Dialogue: 0,0:49:23.41,0:49:25.33,Default,,0,0,0,,Деректерді қалпына келтіру туралы не деуге болады?
Dialogue: 0,0:49:25.42,0:49:29.34,Default,,0,0,0,,Егер сізде тек соңғы жіберілген деректер болса, оны қандай да бір жолмен жөндеуге болатын сияқты.
Dialogue: 0,0:49:29.42,0:49:31.09,Default,,0,0,0,,Өтінемін, тезірек.
Dialogue: 0,0:49:31.17,0:49:32.26,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:49:32.88,0:49:35.01,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:49:35.09,0:49:37.76,Default,,0,0,0,,Гента-кун, оны ол жерге қоюға болмайды.
Dialogue: 0,0:49:37.84,0:49:39.81,Default,,0,0,0,,Түсіндім, қателестім.
Dialogue: 0,0:49:39.89,0:49:41.26,Default,,0,0,0,,Детектив Такаги
Dialogue: 0,0:49:41.35,0:49:43.52,Default,,0,0,0,,Бұл рас, мен ақыры оралдым.
Dialogue: 0,0:49:43.60,0:49:45.19,Default,,0,0,0,,- (Гента) Әпкең ше? -(Мицухико) Кездесеміз деп ойлайсың ба?
Dialogue: 0,0:49:45.27,0:49:47.48,Default,,0,0,0,,Тынш, тыныш бол
Dialogue: 0,0:49:47.56,0:49:49.77,Default,,0,0,0,,Балалар сендер жасырын кіресіңдер.
Dialogue: 0,0:49:49.86,0:49:51.61,Default,,0,0,0,,Ешкімге айтпайсың ба?
Dialogue: 0,0:49:51.69,0:49:54.53,Default,,0,0,0,,Аа... Кешіріңіз, әдеттегі ағын.
Dialogue: 0,0:49:54.61,0:49:56.15,Default,,0,0,0,,Әй, әпке
Dialogue: 0,0:49:56.24,0:49:58.53,Default,,0,0,0,,Жақсы, сен жақсы көрінесің.
Dialogue: 0,0:49:58.62,0:50:00.41,Default,,0,0,0,,Басыңыз енді ауырмайды ма?
Dialogue: 0,0:50:00.49,0:50:04.33,Default,,0,0,0,,Иә, қазір бәрі жақсы, рахмет.
Dialogue: 0,0:50:04.41,0:50:07.92,Default,,0,0,0,,Бастапқыда мен сені кездестіре алмадым.
Dialogue: 0,0:50:08.00,0:50:11.38,Default,,0,0,0,,Ол да саған ашық сияқты.
Dialogue: 0,0:50:11.46,0:50:14.30,Default,,0,0,0,,Бұл жадыңызды қалпына келтіруге көмектесуі мүмкін.
Dialogue: 0,0:50:14.38,0:50:16.59,Default,,0,0,0,,- (Гента) Шынымен бе? - (Мицухико) Рахмет
Dialogue: 0,0:50:16.68,0:50:20.39,Default,,0,0,0,,Бірақ келесі жауап алу басталғанша ғана.
Dialogue: 0,0:50:20.47,0:50:22.60,Default,,0,0,0,,- (Гента және т.б.) Иә - (Такаги) Иә...
Dialogue: 0,0:50:23.52,0:50:24.39,Default,,0,0,0,,Иә
Dialogue: 0,0:50:25.52,0:50:27.94,Default,,0,0,0,,Әрі қарай қайда баруым керек?
Dialogue: 0,0:50:28.02,0:50:30.48,Default,,0,0,0,,Ал, мұнда ше?
Dialogue: 0,0:50:31.06,0:50:32.23,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:50:33.15,0:50:33.98,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,0:50:34.07,0:50:36.11,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:50:36.19,0:50:37.36,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:50:37.95,0:50:39.36,Default,,0,0,0,,Жарайсың әпке
Dialogue: 0,0:50:39.45,0:50:40.37,Default,,0,0,0,,Иә.
Dialogue: 0,0:50:40.45,0:50:42.12,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:50:42.95,0:50:45.08,Default,,0,0,0,,Иә, мен мұны апама беремін.
Dialogue: 0,0:50:46.04,0:50:46.87,Default,,0,0,0,,Бұл...
Dialogue: 0,0:50:46.96,0:50:49.83,Default,,0,0,0,,Дартшы оны маған кейін берді.
Dialogue: 0,0:50:49.92,0:50:52.00,Default,,0,0,0,,Оны өзіңізге ұнайтын түске бояңыз
Dialogue: 0,0:50:52.09,0:50:54.59,Default,,0,0,0,,Жарайды ма? Мен шынымен түсіндім
Dialogue: 0,0:50:54.67,0:50:58.68,Default,,0,0,0,,Әй, өйткені менің әпкем құтқарушы.
Dialogue: 0,0:50:58.76,0:51:00.01,Default,,0,0,0,,Үлкен апа
Dialogue: 0,0:51:00.09,0:51:02.30,Default,,0,0,0,,Енді барлығына сәйкес келеді.
Dialogue: 0,0:51:02.39,0:51:05.43,Default,,0,0,0,,Әпке, оның қандай түсті болғанын қалайсыз?
Dialogue: 0,0:51:05.52,0:51:06.85,Default,,0,0,0,,Қызыл қызғылт?
Dialogue: 0,0:51:06.93,0:51:09.69,Default,,0,0,0,,Мен оны қара түске бояп, өлтіруші китке ұқсатар едім.
Dialogue: 0,0:51:09.77,0:51:13.27,Default,,0,0,0,,Менің ойымша ақ түс сізге қараға қарағанда жақсырақ жарасады.
Dialogue: 0,0:51:13.36,0:51:14.94,Default,,0,0,0,,Оның шашы да аппақ.
Dialogue: 0,0:51:15.03,0:51:18.20,Default,,0,0,0,,Ақ болса, сол қалпында қалдыруға болады, бұл мәміле.
Dialogue: 0,0:51:18.28,0:51:20.36,Default,,0,0,0,,Гента-кун, бұл дұрыс емес.
Dialogue: 0,0:51:20.45,0:51:22.45,Default,,0,0,0,,Сауда-саттыққа ұқсайды
Dialogue: 0,0:51:22.53,0:51:24.49,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:51:24.58,0:51:26.87,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:51:26.95,0:51:28.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:28.46,0:51:29.62,Default,,0,0,0,,Жарайсың ба, Гента-кун?
Dialogue: 0,0:51:29.71,0:51:32.17,Default,,0,0,0,,Ах, кешір, кешір
Dialogue: 0,0:51:32.25,0:51:34.84,Default,,0,0,0,,- (Сато) Бәрі жақсы ма? -(Мицухико) Иә.
Dialogue: 0,0:51:34.92,0:51:37.84,Default,,0,0,0,,Ах! Мен жеңген болсам да
Dialogue: 0,0:51:37.92,0:51:39.63,Default,,0,0,0,,Бәрі де апаңның арқасы.
Dialogue: 0,0:51:39.72,0:51:40.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:40.63,0:51:43.93,Default,,0,0,0,,Гента жай ғана нұсқауларды орындаған жоқ па?
Dialogue: 0,0:51:44.01,0:51:46.18,Default,,0,0,0,,Жақсы... жақсы.
Dialogue: 0,0:51:47.06,0:51:48.68,Default,,0,0,0,,- (Казами) Кешіріңіз - (Гента және басқалар) Иә?
Dialogue: 0,0:51:50.10,0:51:52.23,Default,,0,0,0,,Қоғамдық қауіпсіздікті қамтамасыз ететін флюгер
Dialogue: 0,0:51:52.31,0:51:55.07,Default,,0,0,0,,Мен бұл жерде жауапты адам инспектор Мегуре екенін естідім.
Dialogue: 0,0:51:56.07,0:51:57.86,Default,,0,0,0,,Сіз Мегур инспекторсыз ба?
Dialogue: 0,0:51:57.94,0:52:00.74,Default,,0,0,0,,Мен Мегурмін.
Dialogue: 0,0:52:00.82,0:52:04.12,Default,,0,0,0,,Әйелді тез арада сол жерге тапсыруыңызды сұраймын.
Dialogue: 0,0:52:04.20,0:52:08.37,Default,,0,0,0,,Неліктен, біздің тергеуге құқығымыз жоқ па?
Dialogue: 0,0:52:08.45,0:52:11.75,Default,,0,0,0,,Бұл әйел Ұлттық полиция агенттігіне басып кірген күдікті.
Dialogue: 0,0:52:11.83,0:52:15.50,Default,,0,0,0,,Мақсатты дереу естуіміз керек.
Dialogue: 0,0:52:15.59,0:52:17.63,Default,,0,0,0,,Түсінсеңіз
Dialogue: 0,0:52:17.71,0:52:21.01,Default,,0,0,0,,Мен экстрадициялау процесінің дереу басталғанын қалаймын.
Dialogue: 0,0:52:21.09,0:52:24.85,Default,,0,0,0,,Бұдан бас тартуға құқығыңыз жоқ.
Dialogue: 0,0:52:26.60,0:52:28.01,Default,,0,0,0,,- (Мегуре) Түсіндім - (Сато және т.б.) Ах.
Dialogue: 0,0:52:28.77,0:52:32.35,Default,,0,0,0,,Өтініш формасы үшін осы жерді басыңыз.
Dialogue: 0,0:52:33.48,0:52:35.98,Default,,0,0,0,,Менің әпкем не болады?
Dialogue: 0,0:52:36.06,0:52:36.90,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:52:36.98,0:52:39.78,Default,,0,0,0,,Осымен менің онымен кездесуім аяқталды.
Dialogue: 0,0:52:39.86,0:52:40.90,Default,,0,0,0,,Бәріміз де үйге қайтайық
Dialogue: 0,0:52:40.99,0:52:42.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:42.45,0:52:45.12,Default,,0,0,0,,Енді аурухана бөлмесіне оралайық.
Dialogue: 0,0:52:45.20,0:52:46.03,Default,,0,0,0,,Иә
Dialogue: 0,0:52:46.12,0:52:47.33,Default,,0,0,0,,Әй, әпке
Dialogue: 0,0:52:47.41,0:52:48.62,Default,,0,0,0,,Сіз барасыз ба?
Dialogue: 0,0:52:48.70,0:52:50.91,Default,,0,0,0,,Аа, сәл күте тұрыңыз... Апа
Dialogue: 0,0:52:52.54,0:52:55.79,Default,,0,0,0,,Барлығыңызға рахмет, мен мұны бағалаймын.
Dialogue: 0,0:52:56.71,0:52:58.21,Default,,0,0,0,,- (Гента/Аюми) Иә - (Мицухико) Иә.
Dialogue: 0,0:52:58.30,0:53:01.30,Default,,0,0,0,,Бір күні бәріміз қайтадан айналмалы дөңгелекті мінейік.
Dialogue: 0,0:53:01.84,0:53:03.30,Default,,0,0,0,,- (Мицухико) Мүлдем - (Гента) Атқа мінейік.
Dialogue: 0,0:53:04.13,0:53:05.89,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:53:12.60,0:53:14.69,Default,,0,0,0,,Әпке, амансыз ба?
Dialogue: 0,0:53:14.77,0:53:16.65,Default,,0,0,0,,Иә, мен уайымдап тұрмын.
Dialogue: 0,0:53:16.73,0:53:17.56,Default,,0,0,0,,О
Dialogue: 0,0:53:19.77,0:53:23.28,Default,,0,0,0,,Ой, Шиничи, талдау аяқталды.
Dialogue: 0,0:53:23.36,0:53:24.36,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:53:24.45,0:53:25.78,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:53:26.87,0:53:30.12,Default,,0,0,0,,«Ноку Стайт Аквавит Рислинг»
Dialogue: 0,0:53:30.20,0:53:31.79,Default,,0,0,0,,«Сізге қамқор болдыңыз...»
Dialogue: 0,0:53:31.87,0:53:33.58,Default,,0,0,0,,«Бурбон мен Киль»
Dialogue: 0,0:53:33.66,0:53:35.62,Default,,0,0,0,,Боқ, күткендей.
Dialogue: 0,0:53:35.71,0:53:39.04,Default,,0,0,0,,Дәрігер, мен сізден осы электрондық поштаның баратын жерін талдауыңызды сұраймын.
Dialogue: 0,0:53:39.13,0:53:39.96,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:53:40.05,0:53:41.71,Default,,0,0,0,,Білсеңіз, дереу маған хабарласыңыз.
Dialogue: 0,0:53:47.18,0:53:48.18,Default,,0,0,0,,Хайбара
Dialogue: 0,0:53:49.26,0:53:50.10,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:53:51.06,0:53:52.27,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:53:54.06,0:53:56.10,Default,,0,0,0,,Мен сізге бұрын айтқанмын.
Dialogue: 0,0:53:56.19,0:53:58.56,Default,,0,0,0,,Тағдырыңнан қашпа
Dialogue: 0,0:53:59.90,0:54:01.48,Default,,0,0,0,,Менің де қашқым келмейді.
Dialogue: 0,0:54:11.24,0:54:12.58,Default,,0,0,0,,Кудо-кун
Dialogue: 0,0:54:12.66,0:54:14.96,Default,,0,0,0,,Детектив Такаги, рахмет
Dialogue: 0,0:54:15.04,0:54:17.08,Default,,0,0,0,,Бұл мүмкін емес деп айтқаным үшін кешіріңіз.
Dialogue: 0,0:54:17.17,0:54:19.75,Default,,0,0,0,,А, онда үйге бара жатқанда абай бол.
Dialogue: 0,0:54:19.83,0:54:21.21,Default,,0,0,0,,Иә
Dialogue: 0,0:54:21.29,0:54:22.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:22.71,0:54:24.88,Default,,0,0,0,,Гента-кун, көңіл-күйіңді көтер.
Dialogue: 0,0:54:24.97,0:54:27.09,Default,,0,0,0,,Біз тағы кездесетінімізге сенімдімін.
Dialogue: 0,0:54:27.18,0:54:28.22,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:54:28.30,0:54:32.14,Default,,0,0,0,,Дұрыс. Сіз қазір айналу дөңгелегін мінгіңіз келе ме?
Dialogue: 0,0:54:32.22,0:54:35.73,Default,,0,0,0,,Иә, апаң да атқа мінгісі келді.
Dialogue: 0,0:54:35.81,0:54:38.02,Default,,0,0,0,,Декорацияны суретке түсіріп, сендерге жіберейік.
Dialogue: 0,0:54:38.10,0:54:41.06,Default,,0,0,0,,Қазір барсам, түн болады.
Dialogue: 0,0:54:41.15,0:54:43.78,Default,,0,0,0,,Адамдар көп, сондықтан жүре алмауыңыз мүмкін.
Dialogue: 0,0:54:43.86,0:54:45.53,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:54:45.61,0:54:49.53,Default,,0,0,0,,Тото аквариумының капиталы Сузуки Зайбатсудан болуы керек еді.
Dialogue: 0,0:54:49.61,0:54:51.45,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:54:51.53,0:54:52.91,Default,,0,0,0,,- (Гента) Ах - (Аюми) Түсіндім!
Dialogue: 0,0:54:52.99,0:54:56.66,Default,,0,0,0,,Иә, тағы бір мықты одақтас.
Dialogue: 0,0:54:58.54,0:55:01.29,Default,,0,0,0,,Бізді қағып кетті деп күдіктенетін сияқты.
Dialogue: 0,0:55:02.13,0:55:05.05,Default,,0,0,0,,Кюрасао маған жіберген нокаулар тізіміне
Dialogue: 0,0:55:05.76,0:55:08.51,Default,,0,0,0,,Сенің есімдеріңді сонда естідім.
Dialogue: 0,0:55:08.59,0:55:11.68,Default,,0,0,0,,Кюрасао? Рамның сенімді адамы ма?
Dialogue: 0,0:55:11.76,0:55:14.68,Default,,0,0,0,,Иә, ақпарат жинау маманы.
Dialogue: 0,0:55:14.76,0:55:16.27,Default,,0,0,0,,Сіз білетін сияқтысыз
Dialogue: 0,0:55:16.98,0:55:20.98,Default,,0,0,0,,Оның сыртқы келбеті біртүрлі көздерімен ерекшеленеді, олардың оң және сол жақтары әртүрлі.
Dialogue: 0,0:55:21.06,0:55:23.27,Default,,0,0,0,,Бұл ұйымдардағы әйгілі оқиға.
Dialogue: 0,0:55:23.36,0:55:26.07,Default,,0,0,0,,Адал түкіріп қойсаң, өткеннің жақсылығы
Dialogue: 0,0:55:26.15,0:55:28.15,Default,,0,0,0,,Мен сені қиналмай өлуге рұқсат етемін.
Dialogue: 0,0:55:28.24,0:55:31.49,Default,,0,0,0,,Әй, сен бізге қастандық жасамадың, ұрладың.
Dialogue: 0,0:55:31.57,0:55:34.91,Default,,0,0,0,,Өйткені Кюрасао туралы ақпарат мінсіз емес еді.
Dialogue: 0,0:55:34.99,0:55:36.33,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:55:36.41,0:55:39.71,Default,,0,0,0,,Га, Бурбон күткендей.
Dialogue: 0,0:55:39.79,0:55:42.17,Default,,0,0,0,,Мен нокауттар тізімін ұрлағанша жақсы болды.
Dialogue: 0,0:55:42.88,0:55:46.30,Default,,0,0,0,,Мені полиция байқап қалып, қашып бара жатып жол апатына ұшырадым.
Dialogue: 0,0:55:46.38,0:55:48.92,Default,,0,0,0,,Ақырында, мен есте сақтау қабілетінен зардап шектім.
Dialogue: 0,0:55:49.80,0:55:51.76,Default,,0,0,0,,Содан кейін Кюрасаоды қайтарыңыз.
Dialogue: 0,0:55:51.84,0:55:53.89,Default,,0,0,0,,Сізге соққылар тізімін алу керек емес пе?
Dialogue: 0,0:55:53.97,0:55:56.72,Default,,0,0,0,,Джин Біз шынымен қағып жатырмыз ба?
Dialogue: 0,0:55:56.81,0:55:59.77,Default,,0,0,0,,Мұны растауға әлі де кеш емес.
Dialogue: 0,0:56:00.35,0:56:03.44,Default,,0,0,0,,Әрине, бірақ
Dialogue: 0,0:56:07.44,0:56:08.74,Default,,0,0,0,,- Джин - ағасы
Dialogue: 0,0:56:09.49,0:56:10.99,Default,,0,0,0,,Күмәндансаңыз, жазалаңыз
Dialogue: 0,0:56:11.78,0:56:13.99,Default,,0,0,0,,Мен осылай істеймін
Dialogue: 0,0:56:14.07,0:56:15.49,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:56:16.62,0:56:19.91,Default,,0,0,0,,Сатқынның үкімін шығаратын кез келді.
Dialogue: 0,0:56:20.71,0:56:22.21,Default,,0,0,0,,Доктор Мадака
Dialogue: 0,0:56:22.29,0:56:25.63,Default,,0,0,0,,Асықпаңыз, талдау 30 секундта аяқталады.
Dialogue: 0,0:56:25.71,0:56:26.54,Default,,0,0,0,,Жарайды
Dialogue: 0,0:56:26.63,0:56:30.05,Default,,0,0,0,,Мекенжайды білген соң, менің жоғарыда айтқанымды орындаңыз.
Dialogue: 0,0:56:30.13,0:56:30.97,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:56:31.05,0:56:34.01,Default,,0,0,0,,Осы сынған смартфоннан жіберілген
Dialogue: 0,0:56:34.09,0:56:35.47,Default,,0,0,0,,Оны жасырыңыз.
Dialogue: 0,0:56:35.55,0:56:38.39,Default,,0,0,0,,Ой, тезірек, бізде уақыт жоқ.
Dialogue: 0,0:56:38.47,0:56:41.14,Default,,0,0,0,,О, бітті (қоңырауды ажырату дыбысы)
Dialogue: 0,0:56:41.23,0:56:42.52,Default,,0,0,0,,...Мен оны кесіп алдым.
Dialogue: 0,0:56:48.69,0:56:50.11,Default,,0,0,0,,Міне, әдемі бала.
Dialogue: 0,0:56:51.65,0:56:53.49,Default,,0,0,0,,Қалай болғанда да, мұны оқыңыз
Dialogue: 0,0:56:54.07,0:56:55.57,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:56:55.66,0:56:56.99,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:56:57.08,0:56:58.49,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:57:00.83,0:57:01.66,Default,,0,0,0,,Кил!
Dialogue: 0,0:57:01.75,0:57:02.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:57:03.87,0:57:06.88,Default,,0,0,0,,Эй, не болып жатыр? Кел, жүре бер.
Dialogue: 0,0:57:08.38,0:57:09.88,Default,,0,0,0,,Сіз кісендерді шеше аласыз ба?
Dialogue: 0,0:57:09.96,0:57:12.38,Default,,0,0,0,,Әлі күдікті ретінде
Dialogue: 0,0:57:13.51,0:57:16.64,Default,,0,0,0,,Екеуміздің доспыз ба, доспыз ба, бұл сізге байланысты емес.
Dialogue: 0,0:57:17.47,0:57:19.89,Default,,0,0,0,,Соңында мен саған бір минут беремін.
Dialogue: 0,0:57:19.97,0:57:23.89,Default,,0,0,0,,Мен басқаны бірінші сататын адамға ғана табынамын.
Dialogue: 0,0:57:23.98,0:57:26.73,Default,,0,0,0,,Егеуқұйрықтардың қалай жеңіліп жатқанын қараңыз.
Dialogue: 0,0:57:28.19,0:57:30.19,Default,,0,0,0,,Арақ санау
Dialogue: 0,0:57:30.28,0:57:31.78,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:57:32.57,0:57:33.44,Default,,0,0,0,,60 секунд
Dialogue: 0,0:57:36.32,0:57:37.95,Default,,0,0,0,,Сіз мұндай қорқытуды қабылдайсыз ба?
Dialogue: 0,0:57:38.78,0:57:42.70,Default,,0,0,0,,Егер сіз оны тықылдатсаңыз, сіз өзіңізді қағып жатырсыз.
Dialogue: 0,0:57:42.79,0:57:45.17,Default,,0,0,0,,Мұндай нәрсені жіберіп алудың жолы жоқ.
Dialogue: 0,0:57:45.25,0:57:48.88,Default,,0,0,0,,-50 секунд -Ха, ол ше?
Dialogue: 0,0:57:48.96,0:57:52.96,Default,,0,0,0,,Мен таң қаларлықтай мейірімдімін, Киль.
Dialogue: 0,0:57:54.22,0:57:55.47,Default,,0,0,0,,Миса☆-ның «Жеңімпаздар» ружы – іске қосылды
Dialogue: 0,0:57:57.76,0:58:00.72,Default,,0,0,0,,Бұл олардың жақсы араласып, бір-бірін қорғайтынын білдіре ме?
Dialogue: 0,0:58:00.81,0:58:02.64,Default,,0,0,0,,Ештеңе жабуға болмайды
Dialogue: 0,0:58:02.72,0:58:05.39,Default,,0,0,0,,Ол ұрды ма, соқты ма, білмеймін.
Dialogue: 0,0:58:05.48,0:58:06.90,Default,,0,0,0,,- (Мизунаши) Мен де -30 секунд
Dialogue: 0,0:58:06.98,0:58:09.73,Default,,0,0,0,,Бірақ мен сізге мынаны айта аламын: мен қағып жатқан жоқпын.
Dialogue: 0,0:58:09.81,0:58:11.82,Default,,0,0,0,,Бұл менің жолым.
Dialogue: 0,0:58:11.90,0:58:12.73,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:58:12.82,0:58:14.24,Default,,0,0,0,,20 секунд
Dialogue: 0,0:58:14.32,0:58:15.74,Default,,0,0,0,,Тышқан қайсысы?
Dialogue: 0,0:58:15.82,0:58:17.99,Default,,0,0,0,,Джин, рас па?
Dialogue: 0,0:58:18.07,0:58:20.99,Default,,0,0,0,,Қайсысы бірінші жылайды?
Dialogue: 0,0:58:21.08,0:58:22.49,Default,,0,0,0,,10 секунд 9...
Dialogue: 0,0:58:22.58,0:58:24.00,Default,,0,0,0,,８…
Dialogue: 0,0:58:24.08,0:58:25.75,Default,,0,0,0,,Енді, бурбон?
Dialogue: 0,0:58:25.83,0:58:26.75,Default,,0,0,0,,Кил?
Dialogue: 0,0:58:26.83,0:58:29.42,Default,,0,0,0,,４ ３ ２…
Dialogue: 0,0:58:29.50,0:58:31.00,Default,,0,0,0,,Ең алдымен, сіз.
Dialogue: 0,0:58:31.09,0:58:32.30,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:58:32.38,0:58:33.25,Default,,0,0,0,,Бурбон
Dialogue: 0,0:58:40.43,0:58:41.35,Default,,0,0,0,,Ha
Dialogue: 0,0:58:46.35,0:58:47.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:48.39,0:58:50.40,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:58:50.48,0:58:52.36,Default,,0,0,0,,-Не? Не болды? -Ла...жарық
Dialogue: 0,0:58:52.44,0:58:55.15,Default,,0,0,0,,Киль Бурбон Қозғалма
Dialogue: 0,0:58:55.99,0:58:56.82,Default,,0,0,0,,Ах
Dialogue: 0,0:58:57.53,0:58:58.82,Default,,0,0,0,,Бурбон жоқ.
Dialogue: 0,0:58:58.91,0:59:00.07,Default,,0,0,0,,Мен қашып кеттім
Dialogue: 0,0:59:00.16,0:59:02.24,Default,,0,0,0,,Қалай?
Dialogue: 0,0:59:03.79,0:59:06.00,Default,,0,0,0,,Қарғыс атқыр... менің артымнан жүр
Dialogue: 0,0:59:07.71,0:59:10.67,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:59:11.79,0:59:15.92,Default,,0,0,0,,Өкінішті, Киль, мен саған өлі егеуқұйрықты көрсете алмадым.
Dialogue: 0,0:59:16.59,0:59:18.47,Default,,0,0,0,,Бірақ мен жалғыз қалмаймын
Dialogue: 0,0:59:18.55,0:59:22.18,Default,,0,0,0,,Жақында мен сізге бурбон жіберемін.
Dialogue: 0,0:59:22.26,0:59:23.35,Default,,0,0,0,,Абайо Киль
Dialogue: 0,0:59:23.43,0:59:24.60,Default,,0,0,0,,Джин Күтеді
Dialogue: 0,0:59:24.68,0:59:27.23,Default,,0,0,0,,Атпаңыз. Бұл Рамның тапсырысы.
Dialogue: 0,0:59:27.31,0:59:28.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:28.43,0:59:30.65,Default,,0,0,0,,Сонымен не істейміз?
Dialogue: 0,0:59:31.10,0:59:32.31,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:59:32.40,0:59:33.23,Default,,0,0,0,,Цк
Dialogue: 0,0:59:34.77,0:59:37.11,Default,,0,0,0,,Сізге Кюрасаодан электрондық хат келгенін естідім.
Dialogue: 0,0:59:38.19,0:59:40.24,Default,,0,0,0,,Екеуі туыс емес еді.
Dialogue: 0,0:59:40.78,0:59:42.53,Default,,0,0,0,,Сіздің жадыңыз қалпына келді ме?
Dialogue: 0,0:59:42.62,0:59:47.04,Default,,0,0,0,,Бұл сіздің бізге деген күмәніңізді тазартатын сияқты.
Dialogue: 0,0:59:47.12,0:59:50.87,Default,,0,0,0,,Мына кісендерді тез алып тастай аласыз ба?
Dialogue: 0,0:59:50.96,0:59:52.29,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:59:52.92,0:59:54.67,Default,,0,0,0,,Рамның командасы жалғасуда.
Dialogue: 0,0:59:55.46,0:59:58.38,Default,,0,0,0,,Маған хат шынымен Кюрасаодан келді ме?
Dialogue: 0,0:59:58.46,1:00:00.68,Default,,0,0,0,,Растау қажет
Dialogue: 0,1:00:00.76,1:00:03.55,Default,,0,0,0,,Полиция ауруханасынан қайтарып алуға келгенде
Dialogue: 0,1:00:03.64,1:00:05.93,Default,,0,0,0,,Бұл өте қиын болатын сияқты.
Dialogue: 0,1:00:06.01,1:00:08.27,Default,,0,0,0,,- Уайымдама - А?
Dialogue: 0,1:00:08.35,1:00:11.94,Default,,0,0,0,,Егер мен дұрыс оқып жатсам, жақын арада қозғалыс болуы керек.
Dialogue: 0,1:00:12.02,1:00:13.44,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,1:00:13.52,1:00:16.61,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:00:16.69,1:00:18.32,Default,,0,0,0,,Жақсы уақыт, Джин.
Dialogue: 0,1:00:18.90,1:00:22.28,Default,,0,0,0,,Қоғамдық қауіпсіздіктің бейбақтары ақыры әрекет ете бастады.
Dialogue: 0,1:00:22.36,1:00:23.20,Default,,0,0,0,,Күтілгендей
Dialogue: 0,1:00:23.91,1:00:26.70,Default,,0,0,0,,Сіз телефоныңызды тыңдап жатқанын да білмейтін ақымақсыз.
Dialogue: 0,1:00:27.24,1:00:28.83,Default,,0,0,0,,Сонымен, баратын жер қандай?
Dialogue: 0,1:00:28.91,1:00:31.96,Default,,0,0,0,,Хмф, дәл сіз күткендей болды.
Dialogue: 0,1:00:32.75,1:00:35.54,Default,,0,0,0,,Мені жаңа ғана көлік қағып кетті.
Dialogue: 0,1:00:35.63,1:00:36.71,Default,,0,0,0,,Ұшақ үлгісін дайындаңыз.
Dialogue: 0,1:00:36.79,1:00:38.50,Default,,0,0,0,,Иә? Амал жоқ
Dialogue: 0,1:00:39.67,1:00:44.05,Default,,0,0,0,,Бұл оның өнімділігін тексерудің жақсы мүмкіндігі.
Dialogue: 0,1:00:44.14,1:00:45.01,Default,,0,0,0,,Тіпті соғыста
Dialogue: 0,1:00:45.09,1:00:47.26,Default,,0,0,0,,О, менің ойымша, сіз бастауға тырыспайсыз.
Dialogue: 0,1:00:47.35,1:00:49.56,Default,,0,0,0,,Бұл Рамның бұйрығы.
Dialogue: 0,1:00:50.18,1:00:52.60,Default,,0,0,0,,Біз өз миссиямызды мүлтіксіз орындауымыз керек.
Dialogue: 0,1:00:52.69,1:00:53.52,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:00:53.60,1:00:54.65,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,1:00:55.81,1:00:57.02,Default,,0,0,0,,Қауіпті Қауіпті
Dialogue: 0,1:00:57.11,1:00:59.90,Default,,0,0,0,,Бұл өте қызық болады
Dialogue: 0,1:00:59.98,1:01:01.32,Default,,0,0,0,,Мен де жындымын
Dialogue: 0,1:01:01.40,1:01:04.49,Default,,0,0,0,,Джин, сенің оны пайдалануды жоспарлап жатқаныңа сенбеймін...
Dialogue: 0,1:01:04.57,1:01:05.74,Default,,0,0,0,,Аға, жоқ.
Dialogue: 0,1:01:05.82,1:01:07.78,Default,,0,0,0,,Мен қашып құтыла алдым
Dialogue: 0,1:01:07.87,1:01:08.74,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,1:01:10.29,1:01:12.87,Default,,0,0,0,,Бурбон мен Киль артта қалды.
Dialogue: 0,1:01:12.96,1:01:14.75,Default,,0,0,0,,Алдымен Кюрасаоды қайтарыңыз
Dialogue: 0,1:01:14.83,1:01:17.75,Default,,0,0,0,,Алайда ауруханада полиция мен қоғамдық қауіпсіздік қызметкерлері бар.
Dialogue: 0,1:01:17.84,1:01:20.59,Default,,0,0,0,,Кюрасао ауруханадан шығып кетті.
Dialogue: 0,1:01:20.67,1:01:21.76,Default,,0,0,0,,Сонда қайда?
Dialogue: 0,1:01:22.34,1:01:25.89,Default,,0,0,0,,Баратын жері - Тото аквариумы
Dialogue: 0,1:01:25.97,1:01:27.51,Default,,0,0,0,,Джин саған болмайды
Dialogue: 0,1:01:28.22,1:01:30.35,Default,,0,0,0,,Осыны оқығаннан кейін, бұл қулық ше?
Dialogue: 0,1:01:30.43,1:01:32.64,Default,,0,0,0,,Хмф, арақ, кеттік.
Dialogue: 0,1:01:33.23,1:01:35.19,Default,,0,0,0,,-Машинаны бұрыңыз -Иә
Dialogue: 0,1:01:37.90,1:01:41.03,Default,,0,0,0,,Түсіндім. Сіз дереу сол жаққа баруыңыз керек.
Dialogue: 0,1:01:41.86,1:01:43.69,Default,,0,0,0,,Біз құтқаруды жасаймыз.
Dialogue: 0,1:01:43.78,1:01:44.78,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:01:44.86,1:01:46.49,Default,,0,0,0,,Екеуі қиын жағдайдан құтылған сияқты.
Dialogue: 0,1:01:46.57,1:01:47.41,Default,,0,0,0,,Ах
Dialogue: 0,1:01:47.49,1:01:48.87,Default,,0,0,0,,Жақсы
Dialogue: 0,1:01:48.95,1:01:52.29,Default,,0,0,0,,Бұл таңқаларлық. Баланың стратегиясы үлкен жетістік болмады.
Dialogue: 0,1:01:52.37,1:01:54.58,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,1:01:54.66,1:01:57.21,Default,,0,0,0,,Себебі сол электрондық поштаның мәтіні жарты жолда тоқтап қалды.
Dialogue: 0,1:01:57.29,1:01:58.96,Default,,0,0,0,,Жалғасы
Dialogue: 0,1:01:59.04,1:02:01.25,Default,,0,0,0,,«Екеуміздің бір-бірімізге ешқандай қатысымыз жоқ, уайымдама».
Dialogue: 0,1:02:01.34,1:02:03.21,Default,,0,0,0,,Мен оны жаңа ғана қосып, жібердім.
Dialogue: 0,1:02:03.30,1:02:05.34,Default,,0,0,0,,Жарайды, енді бізде екі адам бар.
Dialogue: 0,1:02:05.43,1:02:06.47,Default,,0,0,0,,-Иә -Жоқ
Dialogue: 0,1:02:07.14,1:02:09.47,Default,,0,0,0,,Бұл тек үзіліс
Dialogue: 0,1:02:09.55,1:02:11.81,Default,,0,0,0,,Қарсылас жедел қызметкерді қайтарып алуға басымдық береді.
Dialogue: 0,1:02:11.89,1:02:15.06,Default,,0,0,0,,Ол Тото аквариумына бара жатқан сияқты.
Dialogue: 0,1:02:15.14,1:02:16.48,Default,,0,0,0,,Бұл полиция ауруханасы емес пе?
Dialogue: 0,1:02:16.56,1:02:20.73,Default,,0,0,0,,Аа, мен оларды қоғамдық қауіпсіздік қызметкерлері аквариумға алып кеткенін естідім.
Dialogue: 0,1:02:20.82,1:02:22.19,Default,,0,0,0,,Aquarium?
Dialogue: 0,1:02:22.28,1:02:23.73,Default,,0,0,0,,-Then we too -No.
Dialogue: 0,1:02:24.40,1:02:27.11,Default,,0,0,0,,Ақай-күн ол жаққа кетіп қалды.
Dialogue: 0,1:02:27.20,1:02:30.95,Default,,0,0,0,,Біз қойма ауданында қалған барлау агентін құтқаруымыз керек.
Dialogue: 0,1:02:31.03,1:02:32.49,Default,,0,0,0,,Тығыздау тізімін іздеу
Dialogue: 0,1:02:32.58,1:02:33.41,Default,,0,0,0,,Иә
Dialogue: 0,1:02:33.49,1:02:36.41,Default,,0,0,0,,Конан-кун, сен түсесің.
Dialogue: 0,1:02:36.50,1:02:39.08,Default,,0,0,0,,Бұдан әрі не болатынын білмеймін.
Dialogue: 0,1:02:39.17,1:02:40.17,Default,,0,0,0,,Бірақ
Dialogue: 0,1:02:40.25,1:02:41.25,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,1:02:41.92,1:02:44.26,Default,,0,0,0,,ФБР міндетті түрде мәселені шешеді.
Dialogue: 0,1:02:45.38,1:02:46.26,Default,,0,0,0,,Иә
Dialogue: 0,1:02:48.22,1:02:49.43,Default,,0,0,0,,Жарайды, мен оны сұрадым.
Dialogue: 0,1:02:49.51,1:02:52.43,Default,,0,0,0,,Аа, шешілген кезде мен сізге хабарласамын.
Dialogue: 0,1:02:52.51,1:02:55.18,Default,,0,0,0,,Иә, қазір ойлап қарасам
Dialogue: 0,1:02:55.81,1:02:59.56,Default,,0,0,0,,Ақай-сан бұл агент туралы қаншалықты білді?
Dialogue: 0,1:02:59.65,1:03:01.19,Default,,0,0,0,,Ол егжей-тегжейлі білмейтін сияқты.
Dialogue: 0,1:03:01.27,1:03:04.69,Default,,0,0,0,,Біз білетін жалғыз нәрсе - Рамның сенімді адамы.
Dialogue: 0,1:03:04.78,1:03:07.20,Default,,0,0,0,,Код атауы Кюрасао болса керек.
Dialogue: 0,1:03:07.28,1:03:09.28,Default,,0,0,0,,Рахмет және қамқор бол
Dialogue: 0,1:03:13.62,1:03:16.20,Default,,0,0,0,,Ол Кюрасао, Рам емес
Dialogue: 0,1:03:17.21,1:03:21.04,Default,,0,0,0,,What is Curacao? Апельсин қабығынан жасалған алкоголь
Dialogue: 0,1:03:21.13,1:03:25.25,Default,,0,0,0,,Негізгі түрлері - ақ куракао және қызғылт сары кюрасао.
Dialogue: 0,1:03:25.34,1:03:28.13,Default,,0,0,0,,Көк Кюрасао Жасыл Кюрасао
Dialogue: 0,1:03:28.22,1:03:29.93,Default,,0,0,0,,And Red Curacao
Dialogue: 0,1:03:33.55,1:03:35.56,Default,,0,0,0,,А, мүмкін
Dialogue: 0,1:03:36.85,1:03:38.52,Default,,0,0,0,,5 түс
Dialogue: 0,1:03:39.10,1:03:42.86,Default,,0,0,0,,Бұл түс схемасы бір жерде... қайда?
Dialogue: 0,1:03:42.94,1:03:44.32,Default,,0,0,0,,Операция ертеңгі күні таңертең өтеді.
Dialogue: 0,1:03:45.65,1:03:48.32,Default,,0,0,0,,Ах, егер бұл кілт болса.
Dialogue: 0,1:03:49.07,1:03:52.37,Default,,0,0,0,,Форниксте өте ерекше жарақат табылды.
Dialogue: 0,1:03:52.45,1:03:54.33,Default,,0,0,0,,Ауырсынып басын ұстау
Dialogue: 0,1:03:54.41,1:03:56.66,Default,,0,0,0,,Ол бірдеңе айтып жатыр, бірақ мен оның не айтқысы келгенін түсінбеймін.
Dialogue: 0,1:03:56.74,1:03:58.79,Default,,0,0,0,,«Қадірлі Аквавит»
Dialogue: 0,1:03:58.87,1:04:01.83,Default,,0,0,0,,«Рислинг» деп жазылған.
Dialogue: 0,1:04:02.67,1:04:05.21,Default,,0,0,0,,Мен түсінемін, егер бұл пайымдау дұрыс болса.
Dialogue: 0,1:04:05.29,1:04:07.67,Default,,0,0,0,,Ұйымдардың қозғалысына және қоғамдық қауіпсіздікке түсініктеме беруге болады.
Dialogue: 0,1:04:07.76,1:04:08.59,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:08.67,1:04:10.30,Default,,0,0,0,,...That's crazy.
Dialogue: 0,1:04:10.38,1:04:11.97,Default,,0,0,0,,Асығу керек
Dialogue: 0,1:04:12.59,1:04:14.89,Default,,0,0,0,,Noklist ұйымның қолында
Dialogue: 0,1:04:19.56,1:04:20.43,Default,,0,0,0,,Иә
Dialogue: 0,1:04:20.52,1:04:22.98,Default,,0,0,0,,Иә, нұсқау бойынша қорғалған
Dialogue: 0,1:04:23.06,1:04:26.11,Default,,0,0,0,,Не? Сіз маған айналу дөңгелегін мінуді айтасыз ба?
Dialogue: 0,1:04:26.73,1:04:30.86,Default,,0,0,0,,Аа, мен сенімді емеспін, бірақ әзірге бұл әдіске бәс тігуден басқа амалым жоқ.
Dialogue: 0,1:04:31.45,1:04:32.61,Default,,0,0,0,,Will you do it?
Dialogue: 0,1:04:32.70,1:04:35.28,Default,,0,0,0,,Иә, тезірек кездесейік.
Dialogue: 0,1:04:35.37,1:04:38.95,Default,,0,0,0,,Жоқ, ұйымның көзі қайда жарқырап тұрғанын білмеймін.
Dialogue: 0,1:04:39.04,1:04:41.62,Default,,0,0,0,,Мен айналу доңғалағына дейін осылай жүремін. Сонда кездескенше.
Dialogue: 0,1:04:41.71,1:04:43.67,Default,,0,0,0,,Күте тұрыңыз, Фуруя мырза.
Dialogue: 0,1:04:50.88,1:04:53.80,Default,,0,0,0,,...Бұл тіпті Алтын апта!
Dialogue: 0,1:04:53.88,1:04:56.76,Default,,0,0,0,,Неліктен мен аквариумға келуім керек?
Dialogue: 0,1:04:56.85,1:05:00.18,Default,,0,0,0,,Бұл да балалармен болды, хаха.
Dialogue: 0,1:05:00.27,1:05:01.48,Default,,0,0,0,,Каэдэ, мен келдім…
Dialogue: 0,1:05:01.56,1:05:02.94,Default,,0,0,0,,- (Мицухико) Мен көптен күттім - (Аюми) Ия!
Dialogue: 0,1:05:03.02,1:05:04.27,Default,,0,0,0,,Кеттік
Dialogue: 0,1:05:04.35,1:05:05.52,Default,,0,0,0,,Бір минут күтіңіздер, бәріңіз.
Dialogue: 0,1:05:05.61,1:05:07.11,Default,,0,0,0,,Бар болыңыз
Dialogue: 0,1:05:07.19,1:05:08.40,Default,,0,0,0,,Иә
Dialogue: 0,1:05:08.48,1:05:09.94,Default,,0,0,0,,Сенің әкең не істейді?
Dialogue: 0,1:05:10.03,1:05:12.65,Default,,0,0,0,,Мен бүгін балық сияқты емеспін.
Dialogue: 0,1:05:13.57,1:05:15.99,Default,,0,0,0,,Мен осында ұйықтаймын, ол үшін барыңыз.
Dialogue: 0,1:05:16.07,1:05:18.08,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,1:05:27.63,1:05:29.75,Default,,0,0,0,,- (Казами) Мен сенімен сөйлесемін - (Бағыныңқы) Иә.
Dialogue: 0,1:05:31.92,1:05:33.67,Default,,0,0,0,,Сондай-ақ аквариумда
Dialogue: 0,1:05:33.76,1:05:36.89,Default,,0,0,0,,Мен оны жол-көлік оқиғасы болған жерге апарсам, ол мені басып қалды.
Dialogue: 0,1:05:36.97,1:05:39.85,Default,,0,0,0,,Бұл әйелдің айналма дөңгелегі ұстамасы болды.
Dialogue: 0,1:05:40.47,1:05:43.64,Default,,0,0,0,,Мүмкін бұл жерде бір құпия бар шығар
Dialogue: 0,1:05:43.73,1:05:46.44,Default,,0,0,0,,Әзірге осы жердегі жағдайға біраз уақыт көз жүгіртейік.
Dialogue: 0,1:05:46.52,1:05:47.36,Default,,0,0,0,,Иә
Dialogue: 0,1:05:47.44,1:05:50.23,Default,,0,0,0,,Соноко-ни-чан, жақсы.
Dialogue: 0,1:05:50.32,1:05:52.28,Default,,0,0,0,,Иә, менің ойымша, келер кез келді.
Dialogue: 0,1:05:52.36,1:05:53.99,Default,,0,0,0,,Мен айналмалы доңғалақпен мінгім келеді.
Dialogue: 0,1:05:54.07,1:05:55.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:05:55.53,1:05:58.87,Default,,0,0,0,,Бүгінгі билеттер сатылымы аяқталды.
Dialogue: 0,1:05:58.95,1:06:01.95,Default,,0,0,0,,Енді осы жердегі жауапты адамға айтқым келеді.
Dialogue: 0,1:06:02.04,1:06:04.62,Default,,0,0,0,,Егер қоғамдық қауіпсіздік қызметкері ынтымақтастықты сұраса.
Dialogue: 0,1:06:04.71,1:06:05.71,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,1:06:04.71,1:06:05.71,Default,,0,0,0,,Орхидея Кочи Кокчи
Dialogue: 0,1:06:05.71,1:06:05.79,Default,,0,0,0,,Орхидея Кочи Кокчи
Dialogue: 0,1:06:05.79,1:06:07.12,Default,,0,0,0,,Орхидея Кочи Кокчи
Dialogue: 0,1:06:05.79,1:06:07.12,Default,,0,0,0,,Сәл күте тұрыңыз
Dialogue: 0,1:06:07.12,1:06:08.21,Default,,0,0,0,,Орхидея Кочи Кокчи
Dialogue: 0,1:06:08.29,1:06:10.21,Default,,0,0,0,,Ах, міне, келді!
Dialogue: 0,1:06:10.29,1:06:11.42,Default,,0,0,0,,Соноко
Dialogue: 0,1:06:11.50,1:06:13.84,Default,,0,0,0,,Күткеніңізге рахмет. Процедура ұзақ уақыт алады.
Dialogue: 0,1:06:13.92,1:06:15.47,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,1:06:15.55,1:06:17.59,Default,,0,0,0,,Соноко-сан күткендей
Dialogue: 0,1:06:17.68,1:06:20.51,Default,,0,0,0,,Балалар сендер алғыс айтуларың керек.
Dialogue: 0,1:06:20.60,1:06:21.68,Default,,0,0,0,,Иә
Dialogue: 0,1:06:21.76,1:06:24.60,Default,,0,0,0,,Мені пайдаланып қалуға рұқсат бергенім үшін кешірім сұраймын.
Dialogue: 0,1:06:24.68,1:06:27.02,Default,,0,0,0,,Жоқ, жақсы, күш бірдей.
Dialogue: 0,1:06:27.10,1:06:29.44,Default,,0,0,0,,Олай болса, мына балаларға қамқор болыңыз.
Dialogue: 0,1:06:29.52,1:06:30.52,Default,,0,0,0,,Иә
Dialogue: 0,1:06:30.61,1:06:32.61,Default,,0,0,0,,Олай болса, мен сені айналмалы дөңгелекке апарамын.
Dialogue: 0,1:06:32.69,1:06:34.07,Default,,0,0,0,,Барлығыңыз, менің артымнан еріңіздер.
Dialogue: 0,1:06:34.15,1:06:35.07,Default,,0,0,0,,Иә
Dialogue: 0,1:06:35.15,1:06:36.20,Default,,0,0,0,,О
Dialogue: 0,1:06:37.66,1:06:39.70,Default,,0,0,0,,Жарайды ма? Маған қалдырыңыз
Dialogue: 0,1:06:39.78,1:06:43.08,Default,,0,0,0,,Иә, ол мұнда экскурсовод, сондықтан жақсы.
Dialogue: 0,1:06:43.66,1:06:46.41,Default,,0,0,0,,Оның үстіне Шиничи-кун, оны шақыру керек емес пе еді?
Dialogue: 0,1:06:46.50,1:06:47.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:47.42,1:06:48.25,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,1:06:48.33,1:06:50.33,Default,,0,0,0,,Жоқ, жақсырақ күзетші.
Dialogue: 0,1:06:51.29,1:06:52.34,Default,,0,0,0,,Не болды, таныс?
Dialogue: 0,1:06:52.42,1:06:55.17,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,1:06:55.26,1:06:58.84,Default,,0,0,0,,Әлгі қоғамдық қауіпсіздік қызметкері бар әйел мен оны бұрын бір жерден көрген сияқтымын.
Dialogue: 0,1:06:59.47,1:07:01.76,Default,,0,0,0,,Қоғамдық қауіпсіздік? Сол адамдар?
Dialogue: 0,1:07:01.85,1:07:04.10,Default,,0,0,0,,Иә, қандай да бір оқиға болды деп ойлаймын.
Dialogue: 0,1:07:06.68,1:07:09.02,Default,,0,0,0,,Бұл не? Бұл жиіркенішті сезінеді.
Dialogue: 0,1:07:09.10,1:07:10.10,Default,,0,0,0,,- (Соноко) Кеттік - (Жүгіріп) Иә.
Dialogue: 0,1:07:12.36,1:07:14.07,Default,,0,0,0,,Кешіріңіз Соноко
Dialogue: 0,1:07:14.15,1:07:16.40,Default,,0,0,0,,Бұрынғы адамдар маған қызық.
Dialogue: 0,1:07:16.49,1:07:19.95,Default,,0,0,0,,Маған қоңырау шалу керек.
Dialogue: 0,1:07:29.54,1:07:30.67,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:07:30.75,1:07:33.50,Default,,0,0,0,,Әй, тозақ, бұл жерде шырылдап жатыр деген сөз.
Dialogue: 0,1:07:34.30,1:07:35.25,Default,,0,0,0,,Күтілгендей
Dialogue: 0,1:07:35.34,1:07:36.71,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,1:07:36.80,1:07:37.80,Default,,0,0,0,,Не болды? Орхидея
Dialogue: 0,1:07:37.88,1:07:41.05,Default,,0,0,0,,О, Шиничи? Менің айтатын нәрсем бар.
Dialogue: 0,1:07:41.14,1:07:43.14,Default,,0,0,0,,Не, тез болыңыз.
Dialogue: 0,1:07:43.22,1:07:44.60,Default,,0,0,0,,А... Қазір бос емессің бе?
Dialogue: 0,1:07:44.68,1:07:46.18,Default,,0,0,0,,Жақсы
Dialogue: 0,1:07:44.68,1:07:46.18,Default,,0,0,0,,Не?
Dialogue: 0,1:07:46.27,1:07:47.10,Default,,0,0,0,,Сәлем Соноко
Dialogue: 0,1:07:47.18,1:07:48.39,Default,,0,0,0,,Егер ол орхидея болса...
Dialogue: 0,1:07:48.48,1:07:49.89,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,1:07:49.98,1:07:50.90,Default,,0,0,0,,Тыңдап тұрсың ба, Ран?
Dialogue: 0,1:07:50.98,1:07:52.77,Default,,0,0,0,,Кешіріңіз, бірақ мен қазір қиындыққа тап болдым.
Dialogue: 0,1:07:52.86,1:07:53.90,Default,,0,0,0,,Оны кесіп алайық
Dialogue: 0,1:07:53.98,1:07:54.52,Default,,0,0,0,,А, күте тұр, Шиничи.
Dialogue: 0,1:07:54.52,1:07:55.98,Default,,0,0,0,,А, күте тұр, Шиничи.
Dialogue: 0,1:07:54.52,1:07:55.98,Default,,0,0,0,,Бүгін де Тото аквариумында
Dialogue: 0,1:07:55.98,1:07:56.07,Default,,0,0,0,,Бүгін де Тото аквариумында
Dialogue: 0,1:07:56.07,1:07:56.44,Default,,0,0,0,,Бүгін де Тото аквариумында
Dialogue: 0,1:07:56.07,1:07:56.44,Default,,0,0,0,,Сіз тынышталған кезде мен сізге хабарласамын.
Dialogue: 0,1:07:56.44,1:07:56.53,Default,,0,0,0,,Сіз тынышталған кезде мен сізге хабарласамын.
Dialogue: 0,1:07:56.53,1:07:57.69,Default,,0,0,0,,Сіз тынышталған кезде мен сізге хабарласамын.
Dialogue: 0,1:07:56.53,1:07:57.69,Default,,0,0,0,,Келгеніңізге рахмет...
Dialogue: 0,1:07:57.69,1:07:57.78,Default,,0,0,0,,Келгеніңізге рахмет...
Dialogue: 0,1:07:57.78,1:07:58.44,Default,,0,0,0,,Келгеніңізге рахмет...
Dialogue: 0,1:07:57.78,1:07:58.44,Default,,0,0,0,,Әй, мүмкін... Әй, қазір қайдасың?
Dialogue: 0,1:07:58.44,1:07:58.53,Default,,0,0,0,,Әй, мүмкін... Әй, қазір қайдасың?
Dialogue: 0,1:07:58.53,1:08:00.53,Default,,0,0,0,,Әй, мүмкін... Әй, қазір қайдасың?
Dialogue: 0,1:07:58.53,1:08:00.53,Default,,0,0,0,,Оны кесіп алайық
Dialogue: 0,1:08:01.45,1:08:05.20,Default,,0,0,0,,Ол бос емес екенін айтты да, қайтадан трубканы қойды.
Dialogue: 0,1:08:05.28,1:08:06.16,Default,,0,0,0,,Иә
Dialogue: 0,1:08:06.24,1:08:08.66,Default,,0,0,0,,Сіз қайда және не істеп жатырсыз?
Dialogue: 0,1:08:08.75,1:08:10.54,Default,,0,0,0,,Осы жерде сияқты.
Dialogue: 0,1:08:10.62,1:08:12.42,Default,,0,0,0,,Иә?Не айтқың келеді?
Dialogue: 0,1:08:12.50,1:08:16.38,Default,,0,0,0,,Мен Шиничидің телефонынан ішкі хабарды естимін.
Dialogue: 0,1:08:16.46,1:08:17.38,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:08:18.09,1:08:19.63,Default,,0,0,0,,Сұрақ: сіз кіммен біргесіз?
Dialogue: 0,1:08:19.72,1:08:20.76,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:20.84,1:08:24.80,Default,,0,0,0,,Ей, ақымақ, мұндай жерге адам жалғыз келеді деп ойлайсың ба?
Dialogue: 0,1:08:24.89,1:08:27.39,Default,,0,0,0,,Енді алдау оқиғасын ұстайық.
Dialogue: 0,1:08:27.47,1:08:29.81,Default,,0,0,0,,Не? Күте тұрыңыз... Соноко
Dialogue: 0,1:08:30.98,1:08:33.81,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:08:33.90,1:08:38.03,Default,,0,0,0,,Ток көзі бір жерде емес сияқты.
Dialogue: 0,1:08:38.11,1:08:40.32,Default,,0,0,0,,Ұзақ уақыт бойы жұмыс істеп тұрған нысан жеке желі ме?
Dialogue: 0,1:08:40.40,1:08:42.53,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,1:08:42.61,1:08:44.16,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,1:08:49.12,1:08:50.16,Default,,0,0,0,,Бітті.
Dialogue: 0,1:08:50.25,1:08:51.71,Default,,0,0,0,,Енді сіз көрінсеңіз де
Dialogue: 0,1:08:51.79,1:08:53.62,Default,,0,0,0,,Оңай табылмайды
Dialogue: 0,1:08:53.71,1:08:54.88,Default,,0,0,0,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,1:08:56.63,1:08:59.26,Default,,0,0,0,,Асығыңыз, 15 минуттан кейін әрекетті бастаңыз
Dialogue: 0,1:08:59.34,1:09:00.84,Default,,0,0,0,,Әй, ұшайық
Dialogue: 0,1:09:00.92,1:09:05.59,Default,,0,0,0,,(Оспрей роторының дыбысы)
Dialogue: 0,1:09:05.68,1:09:10.22,Default,,0,0,0,,Бүгін біз Toto Aquarium Ferris дөңгелегін мінеміз.
Dialogue: 0,1:09:10.31,1:09:12.60,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:09:12.69,1:09:16.69,Default,,0,0,0,,Су мен жарықтың ерекше шоуының уақыты жақындап қалды.
Dialogue: 0,1:09:16.77,1:09:19.11,Default,,0,0,0,,Солтүстік дөңгелекті тексеру үшін
Dialogue: 0,1:09:19.19,1:09:20.69,Default,,0,0,0,,Болашақ рейстер үшін
Dialogue: 0,1:09:20.78,1:09:23.61,Default,,0,0,0,,Тек оңтүстік дөңгелек жағында
Dialogue: 0,1:09:25.24,1:09:26.95,Default,,0,0,0,,Ақыры оларға бақыт келді
Dialogue: 0,1:09:27.03,1:09:28.33,Default,,0,0,0,,- (Гента) Уау - (Аюми) Ия!
Dialogue: 0,1:09:28.41,1:09:29.62,Default,,0,0,0,,Таңбаша
Dialogue: 0,1:09:29.70,1:09:32.04,Default,,0,0,0,,Иә, сәл күтіңдер, балалар.
Dialogue: 0,1:09:32.12,1:09:33.41,Default,,0,0,0,,Бұл тұтынушылар кімдер?
Dialogue: 0,1:09:33.50,1:09:35.50,Default,,0,0,0,,Мен Сузуки мырзаның серігімін.
Dialogue: 0,1:09:35.58,1:09:36.75,Default,,0,0,0,,Тұр! Бір сәт!
Dialogue: 0,1:09:36.83,1:09:39.42,Default,,0,0,0,,Осы балаларға бір жағын қалдыра аламыз ба?
Dialogue: 0,1:09:39.50,1:09:41.09,Default,,0,0,0,,Шамасы солай.
Dialogue: 0,1:09:41.17,1:09:42.17,Default,,0,0,0,,Хм
Dialogue: 0,1:09:42.76,1:09:44.43,Default,,0,0,0,,Ханымдар мен мырзалар, біз сіздерді күтеміз.
Dialogue: 0,1:09:44.51,1:09:45.76,Default,,0,0,0,,Жарық пен судың арнайы көрсетілімі
Dialogue: 0,1:09:45.76,1:09:46.55,Default,,0,0,0,,Жарық пен судың арнайы көрсетілімі
Dialogue: 0,1:09:45.76,1:09:46.55,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,1:09:46.55,1:09:46.64,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,1:09:46.64,1:09:48.47,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,1:09:46.64,1:09:48.47,Default,,0,0,0,,Басталуға 30 минут қалды
Dialogue: 0,1:09:48.47,1:09:48.55,Default,,0,0,0,,Басталуға 30 минут қалды
Dialogue: 0,1:09:48.55,1:09:50.31,Default,,0,0,0,,Басталуға 30 минут қалды
Dialogue: 0,1:09:48.55,1:09:50.31,Default,,0,0,0,,Ей, бұны табу мүмкін емес.
Dialogue: 0,1:09:50.31,1:09:51.06,Default,,0,0,0,,Ей, бұны табу мүмкін емес.
Dialogue: 0,1:09:51.06,1:09:51.93,Default,,0,0,0,,Ей, бұны табу мүмкін емес.
Dialogue: 0,1:09:51.06,1:09:51.93,Default,,0,0,0,,Тото аквариумындағы түнгі аспанды бояу —
Dialogue: 0,1:09:51.93,1:09:52.02,Default,,0,0,0,,Тото аквариумындағы түнгі аспанды бояу —
Dialogue: 0,1:09:52.02,1:09:53.93,Default,,0,0,0,,Тото аквариумындағы түнгі аспанды бояу —
Dialogue: 0,1:09:52.02,1:09:53.93,Default,,0,0,0,,Мен оған кірмес бұрын оны қалай да тоқтатуым керек.
Dialogue: 0,1:09:54.02,1:09:55.56,Default,,0,0,0,,Жарқын жарық және
Dialogue: 0,1:09:55.64,1:09:57.90,Default,,0,0,0,,Судың динамикалық өнімділігі
Dialogue: 0,1:09:57.98,1:09:59.94,Default,,0,0,0,,Оны асыға күтіңіз.
Dialogue: 0,1:10:01.11,1:10:04.28,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,1:10:06.36,1:10:08.78,Default,,0,0,0,,Қоғамдық қауіпсіздік қызметкерлері не істеп жатыр?
Dialogue: 0,1:10:13.62,1:10:16.62,Default,,0,0,0,,Әй, бір сұмдық болып жатыр.
Dialogue: 0,1:10:16.71,1:10:18.21,Default,,0,0,0,,Бірдеңе болды ма деп ойлаймын.
Dialogue: 0,1:10:18.29,1:10:19.79,Default,,0,0,0,,Бұл...
Dialogue: 0,1:10:20.50,1:10:23.21,Default,,0,0,0,,Кудо-кун, сен қайдасың... а?
Dialogue: 0,1:10:23.84,1:10:25.01,Default,,0,0,0,,Күтілгендей
Dialogue: 0,1:10:25.97,1:10:27.22,Default,,0,0,0,,Мына айналма дөңгелек...
Dialogue: 0,1:10:28.26,1:10:30.22,Default,,0,0,0,,Мен өзіммен бірге қоғамдық қауіпсіздік қызметкерлерін алып келдім.
Dialogue: 0,1:10:30.30,1:10:33.10,Default,,0,0,0,,Е, ол сақталған шығар...
Dialogue: 0,1:10:33.18,1:10:34.98,Default,,0,0,0,,Иә, бұл біздің өтінішіміз.
Dialogue: 0,1:10:35.06,1:10:37.48,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,1:10:37.56,1:10:39.65,Default,,0,0,0,,Мен шамамен 10 минут бұрын қателік жібердім.
Dialogue: 0,1:10:39.73,1:10:42.15,Default,,0,0,0,,Мен қонағымның балаларын бортқа әкелдім.
Dialogue: 0,1:10:42.23,1:10:43.28,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:43.36,1:10:45.86,Default,,0,0,0,,Сіз не істейсіз? Қайтып келгенше күткіңіз келе ме?
Dialogue: 0,1:10:45.95,1:10:47.99,Default,,0,0,0,,Жоқ, бала болса да қарсы емеспін.
Dialogue: 0,1:10:48.07,1:10:52.12,Default,,0,0,0,,Бұдан басқа, біз паром дөңгелегі қауіпсіздігін қамтамасыз ете алдық.
Dialogue: 0,1:10:52.20,1:10:53.66,Default,,0,0,0,,Олар не істемекші
Dialogue: 0,1:10:53.74,1:10:56.83,Default,,0,0,0,,Бұл мен жерге қайта оралғанда болуы керек.
Dialogue: 0,1:10:56.91,1:10:58.33,Default,,0,0,0,,Сақтықпен күзет
Dialogue: 0,1:10:58.42,1:10:59.25,Default,,0,0,0,,Иә
Dialogue: 0,1:10:59.33,1:11:00.83,Default,,0,0,0,,Мен бәрін айтқандай дәл орындадым
Dialogue: 0,1:11:02.88,1:11:05.63,Default,,0,0,0,,Кешіріңіз, мен достарымнан айырылдым.
Dialogue: 0,1:11:05.71,1:11:08.30,Default,,0,0,0,,Кешіріңіз. Ах.
Dialogue: 0,1:11:09.30,1:11:11.14,Default,,0,0,0,,Күте тұрыңыз, мінбеңіз.
Dialogue: 0,1:11:11.22,1:11:13.47,Default,,0,0,0,,Ой, бұл жерге кіруге тыйым салынған.
Dialogue: 0,1:11:13.56,1:11:16.73,Default,,0,0,0,,Шүкір, мен сәл кешігіп қалдым.
Dialogue: 0,1:11:22.06,1:11:23.69,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:11:31.49,1:11:33.74,Default,,0,0,0,,Егер олар орнатса
Dialogue: 0,1:11:33.83,1:11:38.25,Default,,0,0,0,,Бұл айналма дөңгелектің ішінде болуы керек, мұнда адамдар оны көре алмайды және сақтықты сақтай алмайды.
Dialogue: 0,1:11:38.91,1:11:41.75,Default,,0,0,0,,Жоспарды мүмкіндігінше тезірек ашыңыз
Dialogue: 0,1:11:41.83,1:11:43.63,Default,,0,0,0,,Мен қоғамдық қауіпсіздік пен ФБР-ге айтуым керек.
Dialogue: 0,1:11:43.71,1:11:44.55,Default,,0,0,0,,Ах
Dialogue: 0,1:11:45.50,1:11:46.92,Default,,0,0,0,,Бұл Ақай-сан ба?
Dialogue: 0,1:11:48.13,1:11:50.97,Default,,0,0,0,,Не? Бұл сансыз кодтар ...
Dialogue: 0,1:11:51.55,1:11:53.47,Default,,0,0,0,,Ал егер...
Dialogue: 0,1:11:54.14,1:11:56.47,Default,,0,0,0,,Қарғыс атсын, мен оны дереу тексеруім керек.
Dialogue: 0,1:11:59.23,1:12:01.23,Default,,0,0,0,,Иә, жоспарланғандай.
Dialogue: 0,1:12:02.73,1:12:06.40,Default,,0,0,0,,Кюрасао гондола ретінде расталды. Қоғамдық қауіпсіздіктен бір жолаушы болған.
Dialogue: 0,1:12:06.48,1:12:10.11,Default,,0,0,0,,Шыңға жету үшін шамамен 10 минут қажет болуы мүмкін.
Dialogue: 0,1:12:10.20,1:12:12.57,Default,,0,0,0,,10 минут, арақ ше?
Dialogue: 0,1:12:12.66,1:12:13.91,Default,,0,0,0,,Кез келген уақытта бара аласыз.
Dialogue: 0,1:12:15.28,1:12:16.66,Default,,0,0,0,,Басқа қоғамдық қауіпсіздік қызметкерлері туралы не деуге болады?
Dialogue: 0,1:12:16.74,1:12:20.04,Default,,0,0,0,,Әр бөлімде бірнеше адам бар сияқты.
Dialogue: 0,1:12:20.12,1:12:22.12,Default,,0,0,0,,Жоспарда проблема жоқ, солай ма?
Dialogue: 0,1:12:22.21,1:12:23.04,Default,,0,0,0,,Хун
Dialogue: 0,1:12:23.83,1:12:25.84,Default,,0,0,0,,Олай болса, сіздің сигналыңыз бойынша біз жалғастырамыз.
Dialogue: 0,1:12:25.92,1:12:26.75,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:12:27.76,1:12:29.01,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,1:12:29.09,1:12:32.09,Default,,0,0,0,,Мені есіңде сақтамағаныңа сенімдісің бе?
Dialogue: 0,1:12:32.18,1:12:33.01,Default,,0,0,0,,Иә
Dialogue: 0,1:12:33.59,1:12:35.18,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:12:35.26,1:12:38.35,Default,,0,0,0,,Есіңді жиып алсаң, жанымды жарала.
Dialogue: 0,1:12:38.43,1:12:40.68,Default,,0,0,0,,Ноклисті жасыратын орын
Dialogue: 0,1:12:40.77,1:12:43.85,Default,,0,0,0,,Ұйым ақпаратын сыртқа шығару.
Dialogue: 0,1:12:47.86,1:12:50.44,Default,,0,0,0,,Бұл бізге қисық сызықтан озып кетуге мүмкіндік беруі керек еді.
Dialogue: 0,1:12:59.29,1:13:00.37,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,1:13:05.38,1:13:08.55,Default,,0,0,0,,Хмм, сіз қашып үлгерген сияқтысыз.
Dialogue: 0,1:13:08.63,1:13:11.97,Default,,0,0,0,,Оның осында болуы оның бар екенін білдіреді
Dialogue: 0,1:13:12.88,1:13:13.72,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:13:14.72,1:13:15.76,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:17.64,1:13:19.18,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,1:13:19.26,1:13:20.81,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,1:13:20.89,1:13:22.68,Default,,0,0,0,,Шамдарды сөндіріңіз
Dialogue: 0,1:13:22.77,1:13:25.19,Default,,0,0,0,,Сіз олардың көздерін ұрлап алдыңыз...
Dialogue: 0,1:13:25.27,1:13:26.52,Default,,0,0,0,,Киль Бурбон
Dialogue: 0,1:13:26.61,1:13:29.86,Default,,0,0,0,,Мен әлі де қойманың ішінде қалып қойғанымды түсіндім...
Dialogue: 0,1:13:29.94,1:13:31.11,Default,,0,0,0,,Жеңіс
Dialogue: 0,1:13:31.19,1:13:34.15,Default,,0,0,0,,Қашып кеткендей бүркемелеу
Dialogue: 0,1:13:34.24,1:13:37.28,Default,,0,0,0,,Мен есікті ашып, оларды алдадым.
Dialogue: 0,1:13:37.95,1:13:39.28,Default,,0,0,0,,Нашар Киль
Dialogue: 0,1:13:39.37,1:13:42.20,Default,,0,0,0,,Сенің арқаңда мен көлеңкеде тығылып қалдым.
Dialogue: 0,1:13:42.66,1:13:45.71,Default,,0,0,0,,Мен олардың қимыл-қозғалысын осыдан кейін біле алдым.
Dialogue: 0,1:13:48.34,1:13:50.42,Default,,0,0,0,,Егер бұл сіздің әрекетіңіз болса
Dialogue: 0,1:13:50.50,1:13:52.88,Default,,0,0,0,,Мен бәрібір мұнда келетінімді білдім.
Dialogue: 0,1:13:52.97,1:13:56.89,Default,,0,0,0,,Маған хабарлай аласыз ба? Бізге көмектескен түсінік
Dialogue: 0,1:13:56.97,1:13:59.43,Default,,0,0,0,,Бұл тәуекелге барудың қажеті жоқ
Dialogue: 0,1:13:59.51,1:14:02.89,Default,,0,0,0,,Сіз олардың ақпаратын тыңдауыңыз мүмкін еді, солай ма?
Dialogue: 0,1:14:02.98,1:14:06.65,Default,,0,0,0,,Сіз осы жерге дейін сөйлесу үшін келдіңіз бе?
Dialogue: 0,1:14:07.27,1:14:11.40,Default,,0,0,0,,Иә, мен ФБР-ге кері кетуді айту үшін келдім.
Dialogue: 0,1:14:11.48,1:14:14.40,Default,,0,0,0,,Кюрасаоға біз қоғамдық қауіпсіздікті қамтамасыз етеміз.
Dialogue: 0,1:14:15.03,1:14:16.91,Default,,0,0,0,,Маған ұнамайды десем ше?
Dialogue: 0,1:14:17.57,1:14:20.08,Default,,0,0,0,,Күшпен алынғанға дейін
Dialogue: 0,1:14:20.16,1:14:21.20,Default,,0,0,0,,Хун
Dialogue: 0,1:14:21.29,1:14:23.83,Default,,0,0,0,,Шуичи Акайды жабыңыз!
Dialogue: 0,1:14:27.37,1:14:28.83,Default,,0,0,0,,Шай
Dialogue: 0,1:14:33.63,1:14:36.26,Default,,0,0,0,,Өрт сөндіру гидрантына неше электр сымы қосылған?
Dialogue: 0,1:14:36.97,1:14:38.26,Default,,0,0,0,,Қалай ойласаң да, біртүрлі.
Dialogue: 0,1:14:38.97,1:14:40.89,Default,,0,0,0,,Мен оны абайсызда ашуға мүмкіндік жоқ.
Dialogue: 0,1:14:40.97,1:14:42.18,Default,,0,0,0,,А, осы жерден
Dialogue: 0,1:14:45.48,1:14:47.94,Default,,0,0,0,,О, бұл детонатор ма?
Dialogue: 0,1:14:48.85,1:14:50.02,Default,,0,0,0,,...Бұл дегеніміз
Dialogue: 0,1:14:50.77,1:14:54.86,Default,,0,0,0,,Осьті айналдыра керілген баудың ұшына не бекітіледі?
Dialogue: 0,1:14:54.94,1:14:56.20,Default,,0,0,0,,Жарылғыш заттар болуы мүмкін
Dialogue: 0,1:14:56.28,1:14:57.82,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,1:14:57.91,1:15:00.28,Default,,0,0,0,,Бұл қашықтан басқарылатын детонатор.
Dialogue: 0,1:15:00.37,1:15:02.74,Default,,0,0,0,,Егер сіз жаман дыбыс шығарсаңыз және олар сізді байқаса
Dialogue: 0,1:15:02.83,1:15:04.24,Default,,0,0,0,,1-томның соңы
Dialogue: 0,1:15:04.87,1:15:05.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:15:06.04,1:15:07.29,Default,,0,0,0,,Ол адам осында
Dialogue: 0,1:15:10.33,1:15:11.59,Default,,0,0,0,,Мен де, әпкем де осы жерде күтеміз.
Dialogue: 0,1:15:11.67,1:15:13.13,Default,,0,0,0,,Сізді ұзақ күттіргенім үшін кешіріңіз.
Dialogue: 0,1:15:13.13,1:15:14.67,Default,,0,0,0,,Сізді ұзақ күттіргенім үшін кешіріңіз.
Dialogue: 0,1:15:13.13,1:15:14.67,Default,,0,0,0,,Бұл нені білдіреді? бортында ешкім жоқ
Dialogue: 0,1:15:14.67,1:15:14.76,Default,,0,0,0,,Сіз нені айтасыз? бортында ешкім жоқ
Dialogue: 0,1:15:14.76,1:15:15.80,Default,,0,0,0,,Сіз нені айтасыз? бортында ешкім жоқ
Dialogue: 0,1:15:14.76,1:15:15.80,Default,,0,0,0,,Енді су мен жарықтың ерекше көрсетілімі.
Dialogue: 0,1:15:15.80,1:15:16.59,Default,,0,0,0,,Енді су мен жарықтың ерекше көрсетілімі.
Dialogue: 0,1:15:16.59,1:15:17.42,Default,,0,0,0,,Енді су мен жарықтың ерекше көрсетілімі.
Dialogue: 0,1:15:16.59,1:15:17.42,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:15:17.42,1:15:18.09,Default,,0,0,0,,Енді су мен жарықтың ерекше көрсетілімі.
Dialogue: 0,1:15:18.18,1:15:19.13,Default,,0,0,0,,Түнгі бағдарлама басталады
Dialogue: 0,1:15:19.13,1:15:21.18,Default,,0,0,0,,Түнгі бағдарлама басталады
Dialogue: 0,1:15:19.13,1:15:21.18,Default,,0,0,0,,Неге бұл балалар!
Dialogue: 0,1:15:21.26,1:15:24.18,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,1:15:24.26,1:15:26.56,Default,,0,0,0,,Уау...
Dialogue: 0,1:15:29.14,1:15:30.40,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:15:39.61,1:15:41.45,Default,,0,0,0,,Мен саған айтуым керек еді, Амуро-кун.
Dialogue: 0,1:15:41.53,1:15:44.58,Default,,0,0,0,,Кімге аң аулау керек екенін қате бағаламаңыз.
Dialogue: 0,1:15:44.66,1:15:47.54,Default,,0,0,0,,О, олар ұйымды аңдырады.
Dialogue: 0,1:15:47.62,1:15:50.00,Default,,0,0,0,,Мен сені бағындырғаннан кейін.
Dialogue: 0,1:15:53.17,1:15:54.13,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:03.10,1:16:04.81,Default,,0,0,0,,Охххх
Dialogue: 0,1:16:09.06,1:16:10.73,Default,,0,0,0,,Осыны орындау кезінде
Dialogue: 0,1:16:10.81,1:16:14.23,Default,,0,0,0,,Кюрасаоның жады қайта оралса және олар шабуыл жасаса ше?
Dialogue: 0,1:16:14.31,1:16:16.28,Default,,0,0,0,,Егер мен шынымды айтсам, ол қандай болар еді?
Dialogue: 0,1:16:16.36,1:16:20.15,Default,,0,0,0,,Ақпараты ұрланған жапон полициясына сене алмаймын.
Dialogue: 0,1:16:20.24,1:16:21.15,Default,,0,0,0,,Уау
Dialogue: 0,1:16:22.66,1:16:25.37,Default,,0,0,0,,Ей, Ақай-сан қайда кетті?
Dialogue: 0,1:16:25.45,1:16:27.62,Default,,0,0,0,,Шығуыңызды өтінемін.
Dialogue: 0,1:16:27.70,1:16:29.54,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:30.62,1:16:31.46,Default,,0,0,0,,(ДжоДжо) Х… Ол менің киімімді жыртып, тікелей теріме еніп барады.
Dialogue: 0,1:16:34.21,1:16:35.38,Default,,0,0,0,,- (Ақай) Уау - (Амуро) Уау...
Dialogue: 0,1:16:35.46,1:16:36.75,Default,,0,0,0,,Тайтер айтты
Dialogue: 0,1:16:41.47,1:16:42.76,Default,,0,0,0,,ол немесе сенімге толы қуғыншы,
Dialogue: 0,1:16:43.72,1:16:44.68,Default,,0,0,0,,(Адам) Мен айтып алмай тұра алмаймын, Әке
Dialogue: 0,1:16:46.51,1:16:48.14,Default,,0,0,0,,- (Ақай) Ия! - (Амуро) Гуаа
Dialogue: 0,1:16:50.39,1:16:51.81,Default,,0,0,0,,Ашуымды келтіргенің – мен тағы да дәл тигіздім деген сөз ғой, иә? Ақымақ патшаның немересі сияқты.
Dialogue: 0,1:16:54.81,1:16:55.73,Default,,0,0,0,,Иә
Dialogue: 0,1:16:55.81,1:16:56.94,Default,,0,0,0,,Уау
Dialogue: 0,1:17:01.11,1:17:02.61,Default,,0,0,0,,Ой, жаңбыр жауып тұр—
Dialogue: 0,1:17:04.53,1:17:05.37,Default,,0,0,0,,Кеттік
Dialogue: 0,1:17:05.95,1:17:07.24,Default,,0,0,0,,Гуах
Dialogue: 0,1:17:08.29,1:17:09.37,Default,,0,0,0,,Сіз қазір берілесіз бе?
Dialogue: 0,1:17:12.16,1:17:14.37,Default,,0,0,0,,Енді екінші айналымға көшейік.
Dialogue: 0,1:17:14.46,1:17:15.46,Default,,0,0,0,,Цк
Dialogue: 0,1:17:15.54,1:17:18.63,Default,,0,0,0,,Ақай-сан! Сен ондасың ба?
Dialogue: 0,1:17:18.71,1:17:20.71,Default,,0,0,0,,Қиындыққа ұшырадым, маған күш-қуатыңды берші!
Dialogue: 0,1:17:21.42,1:17:23.84,Default,,0,0,0,,Егер олар Кюрасаоды қайтарып ала алмаса
Dialogue: 0,1:17:23.93,1:17:26.97,Default,,0,0,0,,Мен бәрін, соның ішінде мына айналма дөңгелекті де бомбамен жарып жіберемін.
Dialogue: 0,1:17:27.05,1:17:29.97,Default,,0,0,0,,Өтінемін, егер сіз сонда болсаңыз, маған қол ұшын беріңіз.
Dialogue: 0,1:17:30.06,1:17:33.35,Default,,0,0,0,,Біз бомбаны қоймас бұрын оны залалсыздандыруымыз керек.
Dialogue: 0,1:17:33.44,1:17:34.73,Default,,0,0,0,,Қандай үлкен мәселе!
Dialogue: 0,1:17:34.81,1:17:35.85,Default,,0,0,0,,Бұл рас па? Конан-кун
Dialogue: 0,1:17:35.94,1:17:37.90,Default,,0,0,0,,Амуро мырза, мұнда қалай келдіңіз?
Dialogue: 0,1:17:37.98,1:17:41.15,Default,,0,0,0,,Мен мұны кейін түсіндіремін. Оның үстіне бомба қайда?
Dialogue: 0,1:17:41.23,1:17:44.03,Default,,0,0,0,,Ось пен доңғалақтың арасында сансыз құрылғылар бар.
Dialogue: 0,1:17:44.11,1:17:47.45,Default,,0,0,0,,Қашықтан басқару пульті арқылы оның қашан жарылатынын білмейсіз.
Dialogue: 0,1:17:47.53,1:17:49.28,Default,,0,0,0,,Мүмкіндігінше тезірек көтеру керек
Dialogue: 0,1:17:49.91,1:17:50.79,Default,,0,0,0,,Иә
Dialogue: 0,1:17:51.91,1:17:54.50,Default,,0,0,0,,Жарайды, мен бірден ФБР-ге барамын.
Dialogue: 0,1:17:56.67,1:17:57.50,Default,,0,0,0,,Иә
Dialogue: 0,1:17:57.58,1:18:00.21,Default,,0,0,0,,Әдемі болды.
Dialogue: 0,1:18:00.30,1:18:01.76,Default,,0,0,0,,… …
Dialogue: 0,1:18:02.76,1:18:06.51,Default,,0,0,0,,Көңіліңді көтер, Ран, мен сені міндетті түрде тауып беремін.
Dialogue: 0,1:18:07.09,1:18:09.18,Default,,0,0,0,,А... олай емес.
Dialogue: 0,1:18:09.26,1:18:12.27,Default,,0,0,0,,Егер біз тергеуде болсақ, біз қиындық тудырамыз.
Dialogue: 0,1:18:12.35,1:18:15.64,Default,,0,0,0,,Сіз қаншалықты мейірімдісіз?
Dialogue: 0,1:18:15.73,1:18:19.48,Default,,0,0,0,,Жарайсың ба? Мен алдау сахнасын міндетті түрде түсіремін.
Dialogue: 0,1:18:19.56,1:18:21.69,Default,,0,0,0,,Жетеді, Соноко.
Dialogue: 0,1:18:21.78,1:18:22.69,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:18:22.78,1:18:25.32,Default,,0,0,0,,Мен әлі арнайы орынды зерттеген жоқпын.
Dialogue: 0,1:18:25.90,1:18:27.53,Default,,0,0,0,,Ерекше орын?
Dialogue: 0,1:18:27.61,1:18:29.91,Default,,0,0,0,,Иә, сол жерде.
Dialogue: 0,1:18:29.99,1:18:30.83,Default,,0,0,0,,Ах
Dialogue: 0,1:18:31.45,1:18:32.74,Default,,0,0,0,,Аквариум
Dialogue: 0,1:18:32.83,1:18:34.08,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:18:38.67,1:18:40.50,Default,,0,0,0,,Сіз қалай ойлайсыз? Амуро мырза
Dialogue: 0,1:18:40.59,1:18:42.59,Default,,0,0,0,,Дәл дерлік, а
Dialogue: 0,1:18:42.67,1:18:43.59,Default,,0,0,0,,Тағы 500 рет!
Dialogue: 0,1:18:46.80,1:18:48.30,Default,,0,0,0,,тамырларың жарылып кетеді.
Dialogue: 0,1:18:48.39,1:18:49.59,Default,,0,0,0,,Я...
Dialogue: 0,1:18:49.68,1:18:51.85,Default,,0,0,0,,Менің ойымша, тұзақ құрылды.
Dialogue: 0,1:18:51.93,1:18:56.60,Default,,0,0,0,,Аа, мен оны оңай ашпау үшін дұрыс шешім қабылдадым.
Dialogue: 0,1:18:57.19,1:18:59.23,Default,,0,0,0,,Ақай мырза, жарылғыш заттар ше?
Dialogue: 0,1:18:59.31,1:19:02.69,Default,,0,0,0,,Бұл әлі C4. Өте жақсы орналастырылған.
Dialogue: 0,1:19:03.32,1:19:05.65,Default,,0,0,0,,Егер бәрі бір уақытта жарылып кетсе
Dialogue: 0,1:19:05.74,1:19:09.70,Default,,0,0,0,,Ось жүкке төтеп бере алмай, шынжыр үзіледі.
Dialogue: 0,1:19:10.49,1:19:11.37,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:19:11.45,1:19:14.24,Default,,0,0,0,,Менің уайымдайтын уақытым жоқ сияқты.
Dialogue: 0,1:19:15.20,1:19:16.25,Default,,0,0,0,,Шинигаминің көздерін алу үшін,
Dialogue: 0,1:19:16.33,1:19:18.96,Default,,0,0,0,,Оны қалай жоюға болады?
Dialogue: 0,1:19:19.04,1:19:21.50,Default,,0,0,0,,Мәселе жоқ, бұл қарапайым түрі.
Dialogue: 0,1:19:21.59,1:19:23.42,Default,,0,0,0,,Мен оны қалай жою керектігін білемін.
Dialogue: 0,1:19:23.50,1:19:26.13,Default,,0,0,0,,Эй, сен бомбалар туралы көп білесің, Амуро-сан.
Dialogue: 0,1:19:26.72,1:19:30.68,Default,,0,0,0,,Полиция академиясында оқитын досым маған көп нәрсені үйретті.
Dialogue: 0,1:19:31.80,1:19:35.22,Default,,0,0,0,,Кейін жарылғыш заттарды залалсыздандыру отрядының эйсі болған адам.
Dialogue: 0,1:19:35.77,1:19:37.48,Default,,0,0,0,,Әйтеуір, анау
Dialogue: 0,1:19:37.56,1:19:41.35,Default,,0,0,0,,Ол айналмалы доңғалаққа орнатылған бомбаны залалсыздандыру кезінде жарылыстан қаза тапты.
Dialogue: 0,1:19:41.94,1:19:44.19,Default,,0,0,0,,Дөңгелектегі бомбаны бөлшектеу кезінде...
Dialogue: 0,1:19:44.27,1:19:47.74,Default,,0,0,0,,Уайымдамаңыз, оның техникасы тамаша болды.
Dialogue: 0,1:19:47.82,1:19:49.36,Default,,0,0,0,,Мен саған дәлелдеймін.
Dialogue: 0,1:19:49.45,1:19:51.28,Default,,0,0,0,,Біз тез әрекет етуіміз керек
Dialogue: 0,1:19:53.20,1:19:57.20,Default,,0,0,0,,Онда құралдар бар. Мен бөлшектеуді сізге қалдырамын.
Dialogue: 0,1:19:57.29,1:19:58.12,Default,,0,0,0,,Ақай мырза ше?
Dialogue: 0,1:19:58.21,1:20:00.04,Default,,0,0,0,,Бомба болғаны
Dialogue: 0,1:20:00.12,1:20:03.13,Default,,0,0,0,,Олар бізді алдау үшін әрқашан осы паромды пайдаланады.
Dialogue: 0,1:20:03.88,1:20:06.80,Default,,0,0,0,,Міне, бомба соқпай-ақ жеттік.
Dialogue: 0,1:20:06.88,1:20:10.68,Default,,0,0,0,,Кюрасаоды қайтарудың жалғыз жолы –...
Dialogue: 0,1:20:10.76,1:20:12.14,Default,,0,0,0,,Аспаннан
Dialogue: 0,1:20:12.22,1:20:13.35,Default,,0,0,0,,Иә.
Dialogue: 0,1:20:13.43,1:20:15.89,Default,,0,0,0,,Мен бастапқы орныма оралып, уақытты сатып аламын.
Dialogue: 0,1:20:16.64,1:20:19.31,Default,,0,0,0,,Бомбаны кез келген жағдайда залалсыздандырыңыз.
Dialogue: 0,1:20:19.39,1:20:22.15,Default,,0,0,0,,Хмф, айтуға оңай.
Dialogue: 0,1:20:22.23,1:20:23.52,Default,,0,0,0,,Амуро мырза, бұл
Dialogue: 0,1:20:24.23,1:20:25.73,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,1:20:25.82,1:20:30.03,Default,,0,0,0,,Енді бұл затты бөлшектеуге қанша уақыт керек.
Dialogue: 0,1:20:30.11,1:20:33.99,Default,,0,0,0,,Қашан жарылып кететінін білмейсің рас...
Dialogue: 0,1:20:34.07,1:20:35.66,Default,,0,0,0,,Жоқ, күте тұрыңыз.
Dialogue: 0,1:20:35.74,1:20:37.37,Default,,0,0,0,,Олар не істемекші...
Dialogue: 0,1:20:37.45,1:20:38.41,Default,,0,0,0,,Ах
Dialogue: 0,1:20:39.54,1:20:40.58,Default,,0,0,0,,Не болды, Конан-кун?
Dialogue: 0,1:20:40.66,1:20:42.83,Default,,0,0,0,,Егер сіз соққылар тізімін орындамасаңыз
Dialogue: 0,1:20:42.92,1:20:45.09,Default,,0,0,0,,...Бұл жігіт кім?
Dialogue: 0,1:20:55.43,1:20:56.51,Default,,0,0,0,,Міне, осы
Dialogue: 0,1:20:56.60,1:20:57.81,Default,,0,0,0,,Бұл назар аударарлық
Dialogue: 0,1:20:57.89,1:21:01.02,Default,,0,0,0,,Кюрасаодағы бес түсті пленкадағы түстер саны бірдей.
Dialogue: 0,1:21:01.10,1:21:04.98,Default,,0,0,0,,Ал күндізгіден айырмашылығы, айқындық бірдей дерлік.
Dialogue: 0,1:21:05.77,1:21:07.36,Default,,0,0,0,,Менің пікірім дұрыс болса
Dialogue: 0,1:21:07.44,1:21:09.82,Default,,0,0,0,,Кюрасао бұл түс схемасы мен тығыздығын көргенде
Dialogue: 0,1:21:09.90,1:21:11.86,Default,,0,0,0,,Тығыздау тізімін есте сақтаңыз
Dialogue: 0,1:21:11.95,1:21:15.45,Default,,0,0,0,,Басқаша айтқанда, оның миы сақтау ортасы болып табылады
Dialogue: 0,1:21:15.53,1:21:16.70,Default,,0,0,0,,Содан кейін
Dialogue: 0,1:21:16.78,1:21:21.75,Default,,0,0,0,,Жад есігі ашылатын нүкте - гондоланың шыңына жеткен кезде.
Dialogue: 0,1:21:21.83,1:21:27.25,Default,,0,0,0,,Осы тамаша түс схемасы мен тығыздықты көргенде, сіздің жадыңыз бұл жолы толығымен қалпына келтіріледі.
Dialogue: 0,1:21:27.34,1:21:28.63,Default,,0,0,0,,Уақыт келді.
Dialogue: 0,1:21:34.38,1:21:37.85,Default,,0,0,0,,Джин, соңғы растау. 3 минуттан кейін бастаймыз.
Dialogue: 0,1:21:37.93,1:21:39.26,Default,,0,0,0,,Ханым?
Dialogue: 0,1:21:39.35,1:21:41.85,Default,,0,0,0,,Кез келген уақытта бастауға болады.
Dialogue: 0,1:21:42.52,1:21:43.35,Default,,0,0,0,,Чианти
Dialogue: 0,1:21:43.89,1:21:48.11,Default,,0,0,0,,Альфа нүктесінде күтіңіз. Бұдан былай дыбыссыз режимге өтіңіз
Dialogue: 0,1:21:48.19,1:21:49.36,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:21:53.61,1:21:56.87,Default,,0,0,0,,Мен оны мүмкіндігінше тезірек босатып, Казамиге қосылуым керек.
Dialogue: 0,1:21:57.99,1:21:59.87,Default,,0,0,0,,Келесі жолы мен мұны істейтініме сенімдімін
Dialogue: 0,1:22:02.16,1:22:03.00,Default,,0,0,0,,Ой
Dialogue: 0,1:22:03.08,1:22:05.92,Default,,0,0,0,,А... Қауіпті Қауіпті
Dialogue: 0,1:22:06.00,1:22:07.83,Default,,0,0,0,,Уф
Dialogue: 0,1:22:08.38,1:22:10.00,Default,,0,0,0,,Мына жігіт жанса, сен өшіп қалдың.
Dialogue: 0,1:22:11.42,1:22:15.51,Default,,0,0,0,,Сабырсыздық ең үлкен тұзақ болды, Мацуда.
Dialogue: 0,1:22:15.59,1:22:19.01,Default,,0,0,0,,Бұл нені білдіреді? Жолдың жартысы қалды
Dialogue: 0,1:22:19.72,1:22:22.02,Default,,0,0,0,,Бұрынғы отшашу болмаса
Dialogue: 0,1:22:22.10,1:22:25.39,Default,,0,0,0,,Фуруя мырзаның ақпараты дұрыс емес.
Dialogue: 0,1:22:33.61,1:22:37.53,Default,,0,0,0,,Ууууууууууууууу...
Dialogue: 0,1:22:38.49,1:22:39.41,Default,,0,0,0,,Ей, не болып жатыр?
Dialogue: 0,1:22:39.49,1:22:41.74,Default,,0,0,0,,(Кюрасаоның ыңырануы)
Dialogue: 0,1:22:41.83,1:22:43.45,Default,,0,0,0,,Жүр, тыныштал.
Dialogue: 0,1:22:43.54,1:22:45.91,Default,,0,0,0,,(Кюрасаоның ыңырануы)
Dialogue: 0,1:22:46.00,1:22:47.46,Default,,0,0,0,,Ах!
Dialogue: 0,1:22:49.54,1:22:51.63,Default,,0,0,0,,Иә?Не айтқың келеді?
Dialogue: 0,1:22:51.71,1:22:54.13,Default,,0,0,0,,Сіздің жадыңыз қалпына келмеді ме?
Dialogue: 0,1:22:54.21,1:22:57.63,Default,,0,0,0,,Рам алған электрондық пошта...
Dialogue: 0,1:22:57.72,1:22:59.51,Default,,0,0,0,,Сабырланыңыз, отырыңыз.
Dialogue: 0,1:22:59.59,1:23:01.76,Default,,0,0,0,,О, келіңдер!
Dialogue: 0,1:23:01.85,1:23:03.31,Default,,0,0,0,,Ах!
Dialogue: 0,1:23:09.60,1:23:12.77,Default,,0,0,0,,Хехе, сен кінәлісің, Кюрасао.
Dialogue: 0,1:23:13.44,1:23:16.65,Default,,0,0,0,,Арнайы миы арқылы ұйымға ыңғайсыз фактілерді анықтай алады.
Dialogue: 0,1:23:16.74,1:23:18.28,Default,,0,0,0,,Мен оны жаттап алдым.
Dialogue: 0,1:23:19.11,1:23:21.24,Default,,0,0,0,,Сіздің қабілеттеріңіз керемет.
Dialogue: 0,1:23:21.91,1:23:26.04,Default,,0,0,0,,Бірақ егер дұрыс пайдаланылмаса, ол үлкен қауіпке айналуы мүмкін.
Dialogue: 0,1:23:27.04,1:23:28.79,Default,,0,0,0,,Сондықтан мен түсіндім.
Dialogue: 0,1:23:29.67,1:23:34.05,Default,,0,0,0,,Бұл сіздің тағдырыңыз болды.
Dialogue: 0,1:23:34.13,1:23:37.55,Default,,0,0,0,,Қош бол Кюрасао
Dialogue: 0,1:23:39.01,1:23:40.09,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,1:23:40.18,1:23:42.10,Default,,0,0,0,,(Стефани) Сол сөзіңді қайтарып ал. (Сора) Ә?
Dialogue: 0,1:23:44.18,1:23:45.81,Default,,0,0,0,,- (Кюрасао) Ха... -На
Dialogue: 0,1:23:45.89,1:23:47.60,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,1:23:47.68,1:23:50.10,Default,,0,0,0,,Вермутқа түсіңіз
Dialogue: 0,1:23:58.70,1:24:01.61,Default,,0,0,0,,Кюрасао Сізде түс жоқ
Dialogue: 0,1:24:01.70,1:24:04.37,Default,,0,0,0,,Тек таза қара қараңғылық бар.
Dialogue: 0,1:24:04.45,1:24:05.87,Default,,0,0,0,,Ла… Лам
Dialogue: 0,1:24:06.70,1:24:09.87,Default,,0,0,0,,Сол қараңғылық сізді азаптап жатса
Dialogue: 0,1:24:09.96,1:24:11.88,Default,,0,0,0,,Оны басқа түске бояңыз
Dialogue: 0,1:24:11.96,1:24:16.38,Default,,0,0,0,,Өзіңіздің ерекше қабілеттеріңізді тек мен үшін пайдаланыңыз.
Dialogue: 0,1:24:16.46,1:24:19.63,Default,,0,0,0,,Енгізу және шығару
Dialogue: 0,1:24:19.72,1:24:24.35,Default,,0,0,0,,Менің оң қолым бол, Кюрасао
Dialogue: 0,1:24:27.47,1:24:29.48,Default,,0,0,0,,Эй, жақсысың ба? Мықты бол
Dialogue: 0,1:24:30.44,1:24:34.98,Default,,0,0,0,,Мүлдем... Күте тұрыңыз, мен дереу жедел жәрдем шақырамын.
Dialogue: 0,1:24:35.06,1:24:36.07,Default,,0,0,0,,Уедди.
Dialogue: 0,1:24:36.15,1:24:37.98,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,1:24:45.45,1:24:47.04,Default,,0,0,0,,Бұл қайтып келді.
Dialogue: 0,1:24:48.50,1:24:51.00,Default,,0,0,0,,Кюрасао оқшаулау аймағына кірді.
Dialogue: 0,1:24:52.83,1:24:55.04,Default,,0,0,0,,Шыңға жетуге 2 минут қалды
Dialogue: 0,1:24:55.13,1:24:57.71,Default,,0,0,0,,Бастау уақыты келді.
Dialogue: 0,1:24:58.38,1:24:59.92,Default,,0,0,0,,Арақтың қолын шығарыңыз.
Dialogue: 0,1:25:00.01,1:25:00.84,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:25:02.93,1:25:04.72,Default,,0,0,0,,Люк ашық
Dialogue: 0,1:25:16.31,1:25:19.73,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:25:19.82,1:25:23.36,Default,,0,0,0,,Бұл ротордың дыбысы... ол жақын жерде болуы керек.
Dialogue: 0,1:25:23.45,1:25:24.95,Default,,0,0,0,,Хмм
Dialogue: 0,1:25:30.87,1:25:34.46,Default,,0,0,0,,Олар неден бастауды жоспарлап отыр?
Dialogue: 0,1:25:42.97,1:25:44.51,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:25:44.59,1:25:46.68,Default,,0,0,0,,Иә? Амал жоқ
Dialogue: 0,1:25:49.10,1:25:50.64,Default,,0,0,0,,Кім?
Dialogue: 0,1:25:50.72,1:25:53.18,Default,,0,0,0,,Көптен бері көрмедім, вермут
Dialogue: 0,1:25:53.27,1:25:55.40,Default,,0,0,0,,Жадыңыз күткендей қайтарылған сияқты.
Dialogue: 0,1:25:55.48,1:25:58.65,Default,,0,0,0,,Иә, бұдан басқа, мені алып кетуге қашан келесің?
Dialogue: 0,1:25:58.73,1:26:01.99,Default,,0,0,0,,Сыртта қоғамдық қауіпсіздіктің тауы бар сияқты.
Dialogue: 0,1:26:02.07,1:26:05.11,Default,,0,0,0,,Ештеңе жоқ, жақында сені Джин алып кетуге келеді.
Dialogue: 0,1:26:05.20,1:26:06.03,Default,,0,0,0,,Джин?
Dialogue: 0,1:26:06.11,1:26:09.62,Default,,0,0,0,,Иә. Айтпақшы, жадыңызды қашан қалпына келтірдіңіз?
Dialogue: 0,1:26:09.70,1:26:13.25,Default,,0,0,0,,Мен Рамның сізбен смартфон арқылы байланысқанын естідім.
Dialogue: 0,1:26:13.87,1:26:17.46,Default,,0,0,0,,Бұл сіз жіберген электрондық пошта болмаса ше?
Dialogue: 0,1:26:18.84,1:26:22.17,Default,,0,0,0,,Бұл электрондық пошта? Әрине, мен жіберушімін
Dialogue: 0,1:26:22.26,1:26:23.34,Default,,0,0,0,,Мәселе бар ма?
Dialogue: 0,1:26:23.42,1:26:24.59,Default,,0,0,0,,Иә
Dialogue: 0,1:26:24.67,1:26:27.43,Default,,0,0,0,,Олай болса, кир мен бурбон ақ түсті.
Dialogue: 0,1:26:27.51,1:26:30.56,Default,,0,0,0,,Менің ойымша, сіз себепсіз өлтіргіңіз келмегендіктен қашып кеттіңіз.
Dialogue: 0,1:26:30.64,1:26:31.47,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:31.56,1:26:33.85,Default,,0,0,0,,Уақыт та қалды, Золушка
Dialogue: 0,1:26:34.43,1:26:36.90,Default,,0,0,0,,Асқабақ арбасын сонда күтіңіз.
Dialogue: 0,1:26:36.98,1:26:38.10,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,1:26:38.77,1:26:39.73,Default,,0,0,0,,сол себепті мені өзінің батлері ретінде қасында ұстады.
Dialogue: 0,1:26:39.81,1:26:43.99,Default,,0,0,0,,3 2 1 нөл
Dialogue: 0,1:26:44.82,1:26:46.24,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:26:52.33,1:26:53.41,Default,,0,0,0,,(Қонақтардың шуы)
Dialogue: 0,1:26:54.08,1:26:54.91,Default,,0,0,0,,Иә
Dialogue: 0,1:26:57.00,1:26:57.92,Default,,0,0,0,,Не?
Dialogue: 0,1:26:58.00,1:26:58.83,Default,,0,0,0,,Цк
Dialogue: 0,1:26:58.92,1:27:00.38,Default,,0,0,0,,Тәтті, мен бастадым.
Dialogue: 0,1:27:01.50,1:27:03.13,Default,,0,0,0,,Вермуттан келген сигналды тексеріңіз
Dialogue: 0,1:27:03.21,1:27:05.63,Default,,0,0,0,,Жерді қараңғылық басып қалды.
Dialogue: 0,1:27:05.72,1:27:08.59,Default,,0,0,0,,Жарайды, бірден түсуді бастаңыз.
Dialogue: 0,1:27:08.68,1:27:10.47,Default,,0,0,0,,Кюрасаоды қорғаңыз
Dialogue: 0,1:27:10.55,1:27:11.39,Default,,0,0,0,,Айо
Dialogue: 0,1:27:13.97,1:27:15.81,Default,,0,0,0,,Тынышталыңыз, бәрі жақсы.
Dialogue: 0,1:27:15.89,1:27:18.81,Default,,0,0,0,,Бұл қауіпті, сондықтан қозғалмаңыз.
Dialogue: 0,1:27:18.90,1:27:22.94,Default,,0,0,0,,Эй, мынаны қарашы. Аквариумда шамдар жанып тұр, солай ма?
Dialogue: 0,1:27:23.02,1:27:25.03,Default,,0,0,0,,- (Әйел) Әй, ана жаққа барайық - (Ер) Әй.
Dialogue: 0,1:27:25.11,1:27:26.49,Default,,0,0,0,,Әй, бәріміз кеттік.
Dialogue: 0,1:27:26.57,1:27:29.07,Default,,0,0,0,,Жоқ, бұл қауіпті, қозғалмаңыз.
Dialogue: 0,1:27:37.54,1:27:41.21,Default,,0,0,0,,Менде жағымсыз сезім бар. Мен бұл балаларды тезірек шығаруым керек.
Dialogue: 0,1:27:41.29,1:27:44.21,Default,,0,0,0,,Не болып жатыр? Мұндай жерде электр қуаты өшіп қала ма?
Dialogue: 0,1:27:44.30,1:27:45.88,Default,,0,0,0,,Сіз твиттер жазбағансыз.
Dialogue: 0,1:27:45.96,1:27:47.97,Default,,0,0,0,,Мен түсе жаздадым.
Dialogue: 0,1:27:48.05,1:27:49.26,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,1:27:49.34,1:27:50.76,Default,,0,0,0,,Жоқ, ол қосылмайды.
Dialogue: 0,1:27:50.84,1:27:52.72,Default,,0,0,0,,Сіз не істеп жатырсыз, Казами мырза?
Dialogue: 0,1:27:54.31,1:27:56.22,Default,,0,0,0,,Сато мырза, Такаги мырза
Dialogue: 0,1:27:56.85,1:28:00.48,Default,,0,0,0,,Бұл жағдайды қоғамдық қауіпсіздік қызметкерлері де білмейтін сияқты.
Dialogue: 0,1:28:00.56,1:28:02.65,Default,,0,0,0,,-(Сато) Күткендей -(Такаги)...Сонымен не істейсің?
Dialogue: 0,1:28:03.27,1:28:04.77,Default,,0,0,0,,Ынтымақтастықты ұсыну
Dialogue: 0,1:28:04.86,1:28:06.36,Default,,0,0,0,,Бірақ олар...
Dialogue: 0,1:28:06.44,1:28:09.78,Default,,0,0,0,,Осындай кездерде ұйымдық келіспеушіліктерге байланысты бір-бірімізбен соғыспауымыз керек.
Dialogue: 0,1:28:10.53,1:28:11.78,Default,,0,0,0,,- (Мегуре) Жақсы - (Сато/Такаги) Иә.
Dialogue: 0,1:28:12.41,1:28:14.58,Default,,0,0,0,,Ол тіпті мұнда да жоқ сияқты.
Dialogue: 0,1:28:14.66,1:28:17.12,Default,,0,0,0,,Иә, кешіріңіз, Соноко.
Dialogue: 0,1:28:17.20,1:28:19.46,Default,,0,0,0,,Мүмкін мен қателескен шығармын.
Dialogue: 0,1:28:19.54,1:28:22.29,Default,,0,0,0,,Әй, сыртқа қара! Сыртта бір қорқынышты нәрсе болып жатыр.
Dialogue: 0,1:28:24.88,1:28:25.80,Default,,0,0,0,,Сәл артқа шегініңіз.
Dialogue: 0,1:28:25.88,1:28:27.55,Default,,0,0,0,,Кешіріңіз, көрсетіңізші.
Dialogue: 0,1:28:27.63,1:28:29.34,Default,,0,0,0,,Ах, бұл...
Dialogue: 0,1:28:29.42,1:28:30.43,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:28:30.51,1:28:33.93,Default,,0,0,0,,Қарғыс атсын... Мына қараңғыда сымдарды ажырата алмаймын.
Dialogue: 0,1:28:34.64,1:28:36.68,Default,,0,0,0,,Жақында оны көтеруге болатын болса да.
Dialogue: 0,1:28:36.76,1:28:39.56,Default,,0,0,0,,Менің көзқарасым шешуші сәтте жойылды.
Dialogue: 0,1:28:47.65,1:28:51.82,Default,,0,0,0,,Мен осылай отырсам, мен ұйымға қайта орала аламын...немесе...
Dialogue: 0,1:28:58.24,1:29:00.96,Default,,0,0,0,,Жоқ, бұл бүкіл гондола
Dialogue: 0,1:29:03.88,1:29:05.42,Default,,0,0,0,,Ха, бұл не?
Dialogue: 0,1:29:08.00,1:29:09.92,Default,,0,0,0,,Ұшақты жақсы басқару
Dialogue: 0,1:29:10.01,1:29:11.42,Default,,0,0,0,,Нысанаға футамал
Dialogue: 0,1:29:11.51,1:29:12.97,Default,,0,0,0,,Мен осылай жалғастырамын.
Dialogue: 0,1:29:17.47,1:29:18.81,Default,,0,0,0,,Қоғамдық қауіпсіздік тергеушісі
Dialogue: 0,1:29:18.89,1:29:19.77,Default,,0,0,0,,...Бұл дегеніміз
Dialogue: 0,1:29:19.85,1:29:22.94,Default,,0,0,0,,Кюрасао ертерек секірді.
Dialogue: 0,1:29:23.02,1:29:24.19,Default,,0,0,0,,Яби
Dialogue: 0,1:29:26.69,1:29:29.03,Default,,0,0,0,,Ағай, ояныңыз, аға!
Dialogue: 0,1:29:31.36,1:29:34.78,Default,,0,0,0,,Хмф, бұл мылтық маған қарсы тұра алмайды деп ойлаймын...
Dialogue: 0,1:29:35.45,1:29:37.87,Default,,0,0,0,,Бір жерде әлсіз жер болуы керек
Dialogue: 0,1:29:39.24,1:29:40.54,Default,,0,0,0,,Құт
Dialogue: 0,1:29:44.12,1:29:46.54,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:29:49.63,1:29:51.42,Default,,0,0,0,,Аххххх
Dialogue: 0,1:29:57.39,1:29:59.31,Default,,0,0,0,,Бұл қашықтықта мүмкін емес пе?
Dialogue: 0,1:29:59.39,1:30:01.52,Default,,0,0,0,,Жарайды, ауыс.
Dialogue: 0,1:30:01.60,1:30:02.43,Default,,0,0,0,,Айо
Dialogue: 0,1:30:02.52,1:30:03.56,Default,,0,0,0,,8 сағат бағыты
Dialogue: 0,1:30:03.64,1:30:06.69,Default,,0,0,0,,Дөңгелекте бір нәрсе қозғалды.
Dialogue: 0,1:30:07.27,1:30:08.61,Default,,0,0,0,,Қоғамдық қауіпсіздік қашып кетті ме?
Dialogue: 0,1:30:08.69,1:30:11.28,Default,,0,0,0,,-Гондоланы жылумен ізде -Түсінікті
Dialogue: 0,1:30:13.32,1:30:15.49,Default,,0,0,0,,Бұл... бұл форма еркек пе?
Dialogue: 0,1:30:15.57,1:30:17.99,Default,,0,0,0,,Ал бортта бір бала бар.
Dialogue: 0,1:30:18.07,1:30:19.87,Default,,0,0,0,,Үлкен аға, Кюрасао бортта жоқ.
Dialogue: 0,1:30:19.95,1:30:20.79,Default,,0,0,0,,Не!
Dialogue: 0,1:30:22.25,1:30:23.79,Default,,0,0,0,,Кюрасао!
Dialogue: 0,1:30:23.87,1:30:25.08,Default,,0,0,0,,Годоланы тастаңыз
Dialogue: 0,1:30:25.16,1:30:26.12,Default,,0,0,0,,У… у… Құдай-ай!
Dialogue: 0,1:30:27.17,1:30:28.00,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,1:30:29.00,1:30:31.00,Default,,0,0,0,,Бұл өтірік, уау.
Dialogue: 0,1:30:34.63,1:30:35.55,Default,,0,0,0,,Уау
Dialogue: 0,1:30:38.14,1:30:41.06,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,1:30:41.14,1:30:42.14,Default,,0,0,0,,Ha
Dialogue: 0,1:30:43.52,1:30:45.18,Default,,0,0,0,,Джин Сіз нені айтып тұрсыз?
Dialogue: 0,1:30:45.27,1:30:46.44,Default,,0,0,0,,Кюрасао жоғалып кетті
Dialogue: 0,1:30:46.52,1:30:47.56,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:47.65,1:30:50.11,Default,,0,0,0,,Стратегияны өзгерту. Кюрасаодан құтылыңыз.
Dialogue: 0,1:30:50.19,1:30:51.23,Default,,0,0,0,,Сабырсыз
Dialogue: 0,1:30:51.32,1:30:53.61,Default,,0,0,0,,Ол маған әлі де опасыздық жасады...
Dialogue: 0,1:30:53.69,1:30:58.28,Default,,0,0,0,,Сіз гондоланы тастап кетуге қашудан басқа қандай да бір себеп ойлап таба аласыз ба?
Dialogue: 0,1:30:58.36,1:30:59.78,Default,,0,0,0,,Кюрасаоды қазір табыңыз
Dialogue: 0,1:30:59.87,1:31:01.12,Default,,0,0,0,,-Түсінікті -Чианти
Dialogue: 0,1:31:01.20,1:31:02.95,Default,,0,0,0,,Дөңгелектен арақашықтықты сақтаңыз
Dialogue: 0,1:31:03.04,1:31:03.87,Default,,0,0,0,,Айо
Dialogue: 0,1:31:03.95,1:31:06.37,Default,,0,0,0,,Корн IDWS дайындаңыз
Dialogue: 0,1:31:06.46,1:31:07.46,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:31:13.84,1:31:14.92,Default,,0,0,0,,Ха…
Dialogue: 0,1:31:22.43,1:31:24.27,Default,,0,0,0,,Олай емес
Dialogue: 0,1:31:24.35,1:31:25.27,Default,,0,0,0,,Не? мысық
Dialogue: 0,1:31:26.23,1:31:27.27,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:31:29.44,1:31:30.40,Default,,0,0,0,,Уф
Dialogue: 0,1:31:33.11,1:31:36.61,Default,,0,0,0,,Не? Мені соларға қайтарасың ба?
Dialogue: 0,1:31:36.69,1:31:39.24,Default,,0,0,0,,Олар ұйым ма?
Dialogue: 0,1:31:39.32,1:31:41.62,Default,,0,0,0,,Менің есте сақтау қабілетім қайта оралды.
Dialogue: 0,1:31:42.37,1:31:43.62,Default,,0,0,0,,Мүмкін сіз
Dialogue: 0,1:31:43.70,1:31:45.95,Default,,0,0,0,,Шерри ұйымға опасыздық жасады...
Dialogue: 0,1:31:47.62,1:31:49.12,Default,,0,0,0,,Жүр, қашайық.
Dialogue: 0,1:31:49.21,1:31:50.67,Default,,0,0,0,,Бұл жерде қалу қауіпті.
Dialogue: 0,1:31:50.75,1:31:52.42,Default,,0,0,0,,Қашып кету дегенді қалай түсінесіңдер?
Dialogue: 0,1:31:52.50,1:31:54.25,Default,,0,0,0,,Егер бұл жаман әзіл болса, оны тоқтата аласыз ба?
Dialogue: 0,1:31:54.34,1:31:55.84,Default,,0,0,0,,Джин келе жатыр
Dialogue: 0,1:31:55.92,1:31:58.34,Default,,0,0,0,,Бұл нені білдіретінін білесіз.
Dialogue: 0,1:31:59.43,1:32:00.84,Default,,0,0,0,,Бірақ неге мен?
Dialogue: 0,1:32:00.93,1:32:05.06,Default,,0,0,0,,Мен білмеймін. Саған не үшін көмектескенімді білмеймін.
Dialogue: 0,1:32:05.77,1:32:08.77,Default,,0,0,0,,Бірақ мен Кюрасаоның кез келген түсі бола аламын
Dialogue: 0,1:32:09.64,1:32:13.11,Default,,0,0,0,,Мен өзімді бұрынғыға қарағанда жақсы сезінемін.
Dialogue: 0,1:32:13.94,1:32:15.61,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,1:32:18.82,1:32:20.95,Default,,0,0,0,,Жүр, кеттік, Шерри-чан.
Dialogue: 0,1:32:21.03,1:32:21.86,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,1:32:22.66,1:32:24.74,Default,,0,0,0,,Гондолада әлі де балалар бар.
Dialogue: 0,1:32:24.83,1:32:26.83,Default,,0,0,0,,Оны тез арада құтқармасақ
Dialogue: 0,1:32:26.91,1:32:27.75,Default,,0,0,0,,Құт
Dialogue: 0,1:32:29.83,1:32:33.13,Default,,0,0,0,,Мен не болғанын білмеймін, бірақ бұл...
Dialogue: 0,1:32:33.21,1:32:36.00,Default,,0,0,0,,Жарайды, мен сым мен детонаторды анықтай аламын.
Dialogue: 0,1:32:36.09,1:32:38.13,Default,,0,0,0,,Егер солай істесем…
Dialogue: 0,1:32:38.21,1:32:41.01,Default,,0,0,0,,Асықпаңыз, сақ болыңыз және асығыңыз
Dialogue: 0,1:32:41.63,1:32:42.93,Default,,0,0,0,,Ух... а
Dialogue: 0,1:32:43.72,1:32:44.85,Default,,0,0,0,,Ағай
Dialogue: 0,1:32:45.93,1:32:47.72,Default,,0,0,0,,Ағай, мықты болыңыз.
Dialogue: 0,1:32:47.81,1:32:48.77,Default,,0,0,0,,- (Казами) Ух... -Ха.
Dialogue: 0,1:32:50.10,1:32:51.27,Default,,0,0,0,,Жарайды, біраз уақыт патша болып, өз жерімді қайтарып алайын!
Dialogue: 0,1:32:55.94,1:32:56.77,Default,,0,0,0,,ол немесе сенімге толы қуғыншы,
Dialogue: 0,1:32:56.86,1:32:59.28,Default,,0,0,0,,Кюрасаоды әлі таппадың ба?
Dialogue: 0,1:32:59.36,1:33:01.95,Default,,0,0,0,,Доңғалақтың ішінде қозғалатын көлеңке
Dialogue: 0,1:33:02.45,1:33:04.28,Default,,0,0,0,,Екі бала және бір ересек
Dialogue: 0,1:33:04.37,1:33:06.20,Default,,0,0,0,,Мына жігіт жынды екен, ағайын.
Dialogue: 0,1:33:06.87,1:33:08.49,Default,,0,0,0,,Детонатордың жанында біреу бар ма?
Dialogue: 0,1:33:08.58,1:33:09.41,Default,,0,0,0,,Не?
Dialogue: 0,1:33:09.50,1:33:11.29,Default,,0,0,0,,Мұнда қараңыз.
Dialogue: 0,1:33:11.37,1:33:14.17,Default,,0,0,0,,Егер есімде дұрыс болса, ол осы өрт сөндіру кранына орнатылуы керек еді.
Dialogue: 0,1:33:14.25,1:33:15.59,Default,,0,0,0,,Цк
Dialogue: 0,1:33:16.17,1:33:18.59,Default,,0,0,0,,Оны қоғамдық қауіпсіздік байқады ма?
Dialogue: 0,1:33:18.67,1:33:21.92,Default,,0,0,0,,Осы екі сымды детонаторға қосу ғана қалды.
Dialogue: 0,1:33:25.34,1:33:27.26,Default,,0,0,0,,Жарайды, мынаны кесіп таста, бітті.
Dialogue: 0,1:33:28.60,1:33:29.43,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:33:29.52,1:33:31.93,Default,,0,0,0,,Жоқ! иә?
Dialogue: 0,1:33:32.02,1:33:34.98,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:33:35.60,1:33:37.94,Default,,0,0,0,,Ия ха...
Dialogue: 0,1:33:38.82,1:33:40.44,Default,,0,0,0,,Жақын болды.
Dialogue: 0,1:33:40.53,1:33:42.70,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,1:33:45.36,1:33:46.20,Default,,0,0,0,,Хун
Dialogue: 0,1:33:50.79,1:33:52.66,Default,,0,0,0,,Маған душ беріңіз, Колн.
Dialogue: 0,1:33:52.75,1:33:54.04,Default,,0,0,0,,Оқ жаңбыры
Dialogue: 0,1:33:55.17,1:33:56.96,Default,,0,0,0,,Уфуфуфуфуфу
Dialogue: 0,1:33:57.67,1:33:59.09,Default,,0,0,0,,Ол осылай болуы керек
Dialogue: 0,1:33:59.17,1:34:00.34,Default,,0,0,0,,Мұны жасама, Колн.
Dialogue: 0,1:34:00.42,1:34:01.84,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:34:01.92,1:34:04.34,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:34:05.22,1:34:08.64,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,1:34:08.72,1:34:10.64,Default,,0,0,0,,Бұл неден басталды?
Dialogue: 0,1:34:13.31,1:34:14.89,Default,,0,0,0,,Шүкір, мен бірдеңе істеуім керек.
Dialogue: 0,1:34:19.61,1:34:21.36,Default,,0,0,0,,Бұл жаман. Бізге асығу керек.
Dialogue: 0,1:34:23.32,1:34:24.74,Default,,0,0,0,,Оны жоғарыдан орындау мүмкін емес пе?
Dialogue: 0,1:34:28.20,1:34:29.58,Default,,0,0,0,,Әлі де жақсы емес
Dialogue: 0,1:34:29.66,1:34:32.29,Default,,0,0,0,,Оны барлығы пайдаланып жатқан сияқты және қосылу қиындап бара жатқан сияқты.
Dialogue: 0,1:34:33.04,1:34:35.29,Default,,0,0,0,,Бұл балалар жақсы ма?
Dialogue: 0,1:34:35.37,1:34:37.79,Default,,0,0,0,,Асығыңыз! ұшып кету
Dialogue: 0,1:34:37.88,1:34:39.79,Default,,0,0,0,,Телефон қоңырау шалуда! Телефон...
Dialogue: 0,1:34:41.88,1:34:43.09,Default,,0,0,0,,Құт
Dialogue: 0,1:34:45.47,1:34:46.30,Default,,0,0,0,,Цк
Dialogue: 0,1:34:55.06,1:34:57.85,Default,,0,0,0,,Шүкір, көшсең бірден нысанаға түсесің.
Dialogue: 0,1:34:57.94,1:34:59.48,Default,,0,0,0,,Сіз бұлай ештеңе істей алмайсыз.
Dialogue: 0,1:35:00.56,1:35:02.73,Default,,0,0,0,,Олар менің артымнан келе жатыр
Dialogue: 0,1:35:02.82,1:35:06.15,Default,,0,0,0,,Ха... Мен сені алдамшы болады деп күтпедім.
Dialogue: 0,1:35:06.24,1:35:08.24,Default,,0,0,0,,Мен ол балаларды сұрадым.
Dialogue: 0,1:35:08.32,1:35:09.99,Default,,0,0,0,,Жоқ, сені өлтіреді.
Dialogue: 0,1:35:14.41,1:35:16.96,Default,,0,0,0,,Ха... мына қозғалыс, мына форма
Dialogue: 0,1:35:17.04,1:35:18.46,Default,,0,0,0,,Қате болмаңыз, бұл Кюрасао.
Dialogue: 0,1:35:23.46,1:35:26.01,Default,,0,0,0,,Шабуылдар бір жерге шоғырланған
Dialogue: 0,1:35:26.84,1:35:28.22,Default,,0,0,0,,Біреу нысанаға алынған
Dialogue: 0,1:35:28.30,1:35:30.18,Default,,0,0,0,,Егер сіз қозғалғыңыз келсе, дәл қазір
Dialogue: 0,1:35:32.39,1:35:33.47,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,1:35:33.56,1:35:34.97,Default,,0,0,0,,Өлме, Кюрасао
Dialogue: 0,1:35:36.89,1:35:37.73,Default,,0,0,0,,Ha
Dialogue: 0,1:35:47.11,1:35:48.86,Default,,0,0,0,,Уф...
Dialogue: 0,1:35:58.21,1:35:59.33,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,1:36:02.42,1:36:04.34,Default,,0,0,0,,Кюрасао реакциясы жоғалып кетті.
Dialogue: 0,1:36:04.42,1:36:06.21,Default,,0,0,0,,Тапсырма аяқталды.
Dialogue: 0,1:36:06.30,1:36:07.26,Default,,0,0,0,,-Жоқ -О...
Dialogue: 0,1:36:07.34,1:36:08.76,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,1:36:08.84,1:36:11.34,Default,,0,0,0,,Егеуқұйрықтармен күресу керек.
Dialogue: 0,1:36:11.43,1:36:13.10,Default,,0,0,0,,Осьтік бомбаны көздеңіз
Dialogue: 0,1:36:13.18,1:36:15.72,Default,,0,0,0,,Ша... Бұл ось ме?
Dialogue: 0,1:36:15.81,1:36:18.52,Default,,0,0,0,,Аа, егер бұл Кюрасао болса.
Dialogue: 0,1:36:18.60,1:36:23.11,Default,,0,0,0,,Олар айналма дөңгелегі құлаған кездегі дүрбелеңді пайдаланып, қашып кетуі мүмкін деген қауіп болды.
Dialogue: 0,1:36:23.19,1:36:25.86,Default,,0,0,0,,Бұл жай ғана қоғамдық қауіпсіздік болса, бұл жеткілікті.
Dialogue: 0,1:36:25.94,1:36:29.53,Default,,0,0,0,,Корн, оқ-дәрілеріңізді тез толтырып, осьті үрлеңіз.
Dialogue: 0,1:36:30.24,1:36:32.28,Default,,0,0,0,,Мұны ASDF келмей тұрып орындаңыз.
Dialogue: 0,1:36:32.36,1:36:34.03,Default,,0,0,0,,Түсінді, орындалды
Dialogue: 0,1:36:36.54,1:36:37.37,Default,,0,0,0,,Хайбара мырза!
Dialogue: 0,1:36:38.70,1:36:40.16,Default,,0,0,0,,Барлығы жарақат алды ма?
Dialogue: 0,1:36:40.25,1:36:41.33,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,1:36:41.42,1:36:44.04,Default,,0,0,0,,Ай Чан, не болды?
Dialogue: 0,1:36:44.13,1:36:45.80,Default,,0,0,0,,Мен оны кейінірек түсіндіремін.
Dialogue: 0,1:36:45.88,1:36:47.76,Default,,0,0,0,,Қазір тыныш болыңыз
Dialogue: 0,1:36:47.84,1:36:48.80,Default,,0,0,0,,- (Гента) Ах - (Мицухико) Иә
Dialogue: 0,1:36:48.88,1:36:50.84,Default,,0,0,0,,Ақай мырза
Dialogue: 0,1:36:51.34,1:36:52.59,Default,,0,0,0,,Амуро мырза
Dialogue: 0,1:36:52.68,1:36:53.55,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,1:36:54.22,1:36:55.05,Default,,0,0,0,,Ақай мырза
Dialogue: 0,1:36:58.10,1:36:59.39,Default,,0,0,0,,Сен ауырып қалдың ба, бала?
Dialogue: 0,1:36:59.48,1:37:00.31,Default,,0,0,0,,Иә
Dialogue: 0,1:37:00.39,1:37:03.65,Default,,0,0,0,,Жасыру, мен ротордың дыбысын әлі естіп тұрмын.
Dialogue: 0,1:37:05.06,1:37:06.15,Default,,0,0,0,,Амуро мырза ше?
Dialogue: 0,1:37:06.77,1:37:10.78,Default,,0,0,0,,Білмеймін, бірақ олар тура шабуыл жасады деген сөз.
Dialogue: 0,1:37:10.86,1:37:13.70,Default,,0,0,0,,Бұл бомбаны залалсыздандырғанымызды білдіреді.
Dialogue: 0,1:37:13.78,1:37:15.45,Default,,0,0,0,,Енді олармен не істеу керек...
Dialogue: 0,1:37:15.53,1:37:17.28,Default,,0,0,0,,Бұл мылтық әшекей ме?
Dialogue: 0,1:37:19.45,1:37:20.29,Default,,0,0,0,,Амуро мырза
Dialogue: 0,1:37:20.37,1:37:24.04,Default,,0,0,0,,Қарсы күресудің жолы бар ма? FBI
Dialogue: 0,1:37:24.12,1:37:26.21,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,1:37:26.29,1:37:28.42,Default,,0,0,0,,Түнгі көру аймағы дірілдеп кетті.
Dialogue: 0,1:37:28.50,1:37:33.05,Default,,0,0,0,,Мен резервте болған осы тұрақты ауқымды ғана пайдалана аламын.
Dialogue: 0,1:37:33.13,1:37:36.18,Default,,0,0,0,,Бұл үлкен темір түн қарғасын құлатуға жетпейді.
Dialogue: 0,1:37:36.85,1:37:38.60,Default,,0,0,0,,Көріп тұрсам, тастай аламын ба?
Dialogue: 0,1:37:38.68,1:37:39.60,Default,,0,0,0,,О
Dialogue: 0,1:37:39.68,1:37:40.68,Default,,0,0,0,,Бірақ қалай?
Dialogue: 0,1:37:40.77,1:37:43.85,Default,,0,0,0,,Егер сіз ротордың түйінін көздесеңіз, сіз...
Dialogue: 0,1:37:43.94,1:37:45.90,Default,,0,0,0,,Мен буынды көре алмадым.
Dialogue: 0,1:37:45.98,1:37:48.19,Default,,0,0,0,,Онымен бетпе-бет келу мүмкін емес.
Dialogue: 0,1:37:48.27,1:37:50.65,Default,,0,0,0,,Әйтеуір оның қалпын бұзып алдым.
Dialogue: 0,1:37:50.73,1:37:54.07,Default,,0,0,0,,Сонымен қатар, егер ротордың айналасындағы аумақты 5 секундқа жарықтандыру мүмкін болса
Dialogue: 0,1:37:54.86,1:37:56.99,Default,,0,0,0,,Мен оны жарықтандыруға болады деп ойлаймын.
Dialogue: 0,1:37:57.07,1:37:59.66,Default,,0,0,0,,Жалпы пішінді білмесеңіз, ротордың айналасы...
Dialogue: 0,1:37:59.74,1:38:00.58,Default,,0,0,0,,Ах
Dialogue: 0,1:38:07.38,1:38:10.00,Default,,0,0,0,,Мен олар осьті жарып жібереді деп ешқашан ойламадым...
Dialogue: 0,1:38:10.09,1:38:13.01,Default,,0,0,0,,Сіз осы айналуды толығымен жоюды жоспарлап отырсыз ба?
Dialogue: 0,1:38:14.55,1:38:18.47,Default,,0,0,0,,Өкініштісі, осьте әлі жарты бомба қалды.
Dialogue: 0,1:38:19.14,1:38:22.02,Default,,0,0,0,,Ахахаха Ату, ату, ату
Dialogue: 0,1:38:22.10,1:38:22.93,Default,,0,0,0,,Иә
Dialogue: 0,1:38:23.02,1:38:24.10,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,1:38:24.18,1:38:26.19,Default,,0,0,0,,Мен оқтың қай жақтан келетінін білсем де
Dialogue: 0,1:38:26.27,1:38:28.36,Default,,0,0,0,,Мен ротордың қайда екенін білмеймін.
Dialogue: 0,1:38:28.44,1:38:31.19,Default,,0,0,0,,Маған жалпы пішінді анықтау ғана қалды.
Dialogue: 0,1:38:32.15,1:38:33.19,Default,,0,0,0,,Жарайды
Dialogue: 0,1:38:35.32,1:38:37.11,Default,,0,0,0,,Оны жіберіп алмаңыз
Dialogue: 0,1:38:40.37,1:38:41.79,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:38:41.87,1:38:43.29,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:38:44.12,1:38:45.96,Default,,0,0,0,,-Мм? -Мен көрдім
Dialogue: 0,1:38:52.55,1:38:55.34,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,1:39:01.10,1:39:02.43,Default,,0,0,0,,Иә?
Dialogue: 0,1:39:09.61,1:39:10.52,Default,,0,0,0,,Ах!
Dialogue: 0,1:39:12.36,1:39:13.28,Default,,0,0,0,,Сол жарық
Dialogue: 0,1:39:13.36,1:39:14.99,Default,,0,0,0,,-(Ер) Отшашу -(Мегуре) Не?
Dialogue: 0,1:39:15.07,1:39:16.49,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:39:16.57,1:39:17.66,Default,,0,0,0,,Отшашу
Dialogue: 0,1:39:17.74,1:39:18.61,Default,,0,0,0,,Шабуыл жасау
Dialogue: 0,1:39:18.70,1:39:20.28,Default,,0,0,0,,Бұл қайдан пайда болды?
Dialogue: 0,1:39:24.29,1:39:25.16,Default,,0,0,0,,Құлау.
Dialogue: 0,1:39:25.25,1:39:26.54,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:39:33.42,1:39:34.25,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,1:39:34.34,1:39:35.17,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:39:41.26,1:39:42.85,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:39:42.93,1:39:44.14,Default,,0,0,0,,Бұл қауіпті, бұл қауіпті
Dialogue: 0,1:39:44.22,1:39:46.14,Default,,0,0,0,,Осылай жалғастыра берсек, құлап қаламыз.
Dialogue: 0,1:39:46.23,1:39:47.39,Default,,0,0,0,,Колн жою
Dialogue: 0,1:39:47.48,1:39:50.44,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:39:50.98,1:39:51.86,Default,,0,0,0,,Цк
Dialogue: 0,1:39:51.94,1:39:52.94,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,1:39:55.11,1:39:57.57,Default,,0,0,0,,Егер ось бұзылса, ол апат болады.
Dialogue: 0,1:39:57.65,1:40:00.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:40:11.79,1:40:12.63,Default,,0,0,0,,Уау
Dialogue: 0,1:40:13.42,1:40:15.38,Default,,0,0,0,,Уау
Dialogue: 0,1:40:20.47,1:40:21.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:26.77,1:40:30.23,Default,,0,0,0,,Бұл жалықтырады, кішкентай бүлікші.
Dialogue: 0,1:40:32.31,1:40:33.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:36.32,1:40:37.28,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:40:37.36,1:40:38.86,Default,,0,0,0,,Мен енді мұны істей алмаймын. Бұл тым қиын.
Dialogue: 0,1:40:42.20,1:40:43.78,Default,,0,0,0,,Қаш!
Dialogue: 0,1:40:43.87,1:40:46.58,Default,,0,0,0,,Қаш! аквариумнан алыс
Dialogue: 0,1:40:50.66,1:40:52.04,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,1:40:52.12,1:40:54.38,Default,,0,0,0,,Осылай дөңгелене берсең, аквариумға түсесің.
Dialogue: 0,1:40:59.72,1:41:02.63,Default,,0,0,0,,Бірақ олар кімдер?
Dialogue: 0,1:41:02.72,1:41:06.26,Default,,0,0,0,,Хмф, өліп жатқандар ше?
Dialogue: 0,1:41:06.35,1:41:07.64,Default,,0,0,0,,Мені қызықтырмайды.
Dialogue: 0,1:41:08.77,1:41:09.60,Default,,0,0,0,,Тұтынушы
Dialogue: 0,1:41:09.68,1:41:12.48,Default,,0,0,0,,Дереу дельфин шоу стадионына көшіңіз.
Dialogue: 0,1:41:12.56,1:41:13.65,Default,,0,0,0,,Бұл жерде қауіпті
Dialogue: 0,1:41:13.73,1:41:14.69,Default,,0,0,0,,Доңғалақ
Dialogue: 0,1:41:14.77,1:41:16.94,Default,,0,0,0,,Жүгірдім Мен қашуым керек.
Dialogue: 0,1:41:21.61,1:41:23.20,Default,,0,0,0,,- (Аюми) Кя - (Мицухико) Ах...
Dialogue: 0,1:41:30.12,1:41:32.33,Default,,0,0,0,,Еңістегі үдетілген
Dialogue: 0,1:41:32.41,1:41:33.46,Default,,0,0,0,,Конан-кун
Dialogue: 0,1:41:35.54,1:41:36.38,Default,,0,0,0,,Амуро мырза
Dialogue: 0,1:41:36.46,1:41:37.80,Default,,0,0,0,,Оны тоқтатуға бола ма?
Dialogue: 0,1:41:37.88,1:41:39.96,Default,,0,0,0,,Мен білмеймін, бірақ мен тырысуым керек.
Dialogue: 0,1:41:42.80,1:41:44.01,Default,,0,0,0,,Уф
Dialogue: 0,1:41:45.64,1:41:47.10,Default,,0,0,0,,- (Амуро) Гуах - Амуро-сан
Dialogue: 0,1:41:47.18,1:41:48.60,Default,,0,0,0,,Жарайды, зейініңді жина.
Dialogue: 0,1:41:51.23,1:41:52.52,Default,,0,0,0,,- (Амуро) Кеттік - Иә.
Dialogue: 0,1:41:53.44,1:41:55.44,Default,,0,0,0,,Ол өмір энергиясына толы—
Dialogue: 0,1:41:57.61,1:41:59.32,Default,,0,0,0,,ал екіншісі – «бар күшіңді салу»!
Dialogue: 0,1:42:00.15,1:42:04.40,Default,,0,0,0,,Жеткізу!
Dialogue: 0,1:42:08.95,1:42:10.08,Default,,0,0,0,,Ақай мырза!
Dialogue: 0,1:42:10.16,1:42:11.70,Default,,0,0,0,,Жоспар бар ма?
Dialogue: 0,1:42:16.54,1:42:17.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:42:18.79,1:42:20.21,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,1:42:30.60,1:42:31.93,Default,,0,0,0,,Маған да біреуін оқып бер
Dialogue: 0,1:42:34.14,1:42:35.48,Default,,0,0,0,,Жарайды
Dialogue: 0,1:42:35.56,1:42:36.48,Default,,0,0,0,,Жоқ, әлі емес пе?
Dialogue: 0,1:42:37.98,1:42:39.57,Default,,0,0,0,,- (Ер) Жоқ, тоқтама - (Жүгіріп) Соноко Тезірек
Dialogue: 0,1:42:39.65,1:42:40.98,Default,,0,0,0,,Телефон қоңырау шалуда! Телефон...
Dialogue: 0,1:42:41.07,1:42:42.69,Default,,0,0,0,,Бұл тоқтамайды.
Dialogue: 0,1:42:42.78,1:42:44.36,Default,,0,0,0,,Жарайды, әлі уақыт бар.
Dialogue: 0,1:42:47.91,1:42:48.74,Default,,0,0,0,,Кудо-кун…
Dialogue: 0,1:42:51.33,1:42:53.75,Default,,0,0,0,,Шүкір, бұлай уақытында үлгере алмаймыз.
Dialogue: 0,1:42:55.58,1:42:56.62,Default,,0,0,0,,Асықпаңыз.
Dialogue: 0,1:42:57.71,1:42:59.59,Default,,0,0,0,,Ақай мырза!
Dialogue: 0,1:43:08.26,1:43:10.39,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,1:43:13.22,1:43:14.39,Default,,0,0,0,,Орхидея?
Dialogue: 0,1:43:14.47,1:43:16.14,Default,,0,0,0,,Бұл доп?
Dialogue: 0,1:43:16.23,1:43:19.56,Default,,0,0,0,,Жылдамырақ үрлеңіз
Dialogue: 0,1:43:19.65,1:43:21.44,Default,,0,0,0,,Үлкенірек!
Dialogue: 0,1:43:21.52,1:43:23.07,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,1:43:25.82,1:43:27.82,Default,,0,0,0,,Жоқ, тоқтамаңыз.
Dialogue: 0,1:43:27.91,1:43:29.70,Default,,0,0,0,,(Кранның жүк көлігінің ескерту дыбысы)
Dialogue: 0,1:43:30.82,1:43:31.87,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:43:35.00,1:43:36.41,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,1:43:46.05,1:43:46.88,Default,,0,0,0,,Ha
Dialogue: 0,1:43:48.63,1:43:49.64,Default,,0,0,0,,Ах
Dialogue: 0,1:43:52.05,1:43:53.97,Default,,0,0,0,,Барлығына! Уф
Dialogue: 0,1:43:58.56,1:44:02.61,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,1:44:19.58,1:44:21.21,Default,,0,0,0,,Тоқтаған жоқ па?
Dialogue: 0,1:44:21.29,1:44:23.34,Default,,0,0,0,,Ия, тоқтады.
Dialogue: 0,1:44:23.42,1:44:25.46,Default,,0,0,0,,Конан-кун мені тоқтатқанына сенімдімін.
Dialogue: 0,1:44:25.55,1:44:27.97,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,1:44:33.30,1:44:34.26,Default,,0,0,0,,Қандай бала
Dialogue: 0,1:44:35.26,1:44:38.02,Default,,0,0,0,,Сіз шынымен де осы алып айналма доңғалақты тоқтатқыңыз келе ме?
Dialogue: 0,1:44:39.56,1:44:42.77,Default,,0,0,0,,Бұл кран көлігі кім болды?
Dialogue: 0,1:44:42.85,1:44:46.02,Default,,0,0,0,,Жарайсың, балам.
Dialogue: 0,1:44:46.90,1:44:48.53,Default,,0,0,0,,А... иә
Dialogue: 0,1:44:58.33,1:45:01.21,Default,,0,0,0,,Күте тұрыңыз, мен мәйітті анықтағым келеді.
Dialogue: 0,1:45:01.29,1:45:03.29,Default,,0,0,0,,А... Мен қарсы емеспін.
Dialogue: 0,1:45:03.38,1:45:06.21,Default,,0,0,0,,Сіздің жеке басыңызды анықтауға болатын жағдайда емессіз.
Dialogue: 0,1:45:06.30,1:45:09.21,Default,,0,0,0,,Түсіндім, өтінемін.
Dialogue: 0,1:45:12.13,1:45:13.80,Default,,0,0,0,,-(Хайбара) Болды -Ой.
Dialogue: 0,1:45:15.18,1:45:18.77,Default,,0,0,0,,Сіз маған не тапқаныңызды көрсете аласыз ба?
Dialogue: 0,1:45:20.02,1:45:21.48,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,1:45:21.56,1:45:24.02,Default,,0,0,0,,- (Қазами) Амал жоқ, сақтаушы - (Бағыныңқы) Ах!
Dialogue: 0,1:45:24.10,1:45:25.23,Default,,0,0,0,,Жоқ
Dialogue: 0,1:45:25.98,1:45:28.23,Default,,0,0,0,,Бұл естелік емес, бұл естелік
Dialogue: 0,1:45:28.90,1:45:31.53,Default,,0,0,0,,♪～
Dialogue: 0,1:45:31.61,1:45:33.82,Default,,0,0,0,,Ол қара түсті болса да.
Dialogue: 0,1:49:47.08,1:49:52.08,Default,,0,0,0,,～♪
Dialogue: 0,1:49:53.33,1:49:54.67,Default,,0,0,0,,Кеше түнде Тото аквариумында болған оқиға—
Dialogue: 0,1:49:54.67,1:49:55.33,Default,,0,0,0,,Кеше түнде Тото аквариумында болған оқиға—
Dialogue: 0,1:49:54.67,1:49:55.33,Default,,0,0,0,,Ах...
Dialogue: 0,1:49:55.33,1:49:55.42,Default,,0,0,0,,Ах...
Dialogue: 0,1:49:55.42,1:49:56.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:49:55.42,1:49:56.46,Default,,0,0,0,,Террористік жарылыс туралы кейінгі есеп.
Dialogue: 0,1:49:56.46,1:49:56.54,Default,,0,0,0,,Террористік жарылыс туралы кейінгі есеп.
Dialogue: 0,1:49:56.54,1:49:58.04,Default,,0,0,0,,Террористік жарылыс туралы кейінгі есеп.
Dialogue: 0,1:49:56.54,1:49:58.04,Default,,0,0,0,,Бұл сәл көбірек болды
Dialogue: 0,1:49:58.04,1:49:58.13,Default,,0,0,0,,Бұл сәл көбірек болды
Dialogue: 0,1:49:58.13,1:49:58.75,Default,,0,0,0,,Бұл сәл көбірек болды
Dialogue: 0,1:49:58.13,1:49:58.75,Default,,0,0,0,,Елордалық полиция департаменті қылмыскерді тергейді.
Dialogue: 0,1:49:58.75,1:49:58.84,Default,,0,0,0,,Елордалық полиция департаменті қылмыскерді тергейді.
Dialogue: 0,1:49:58.84,1:49:59.71,Default,,0,0,0,,Елордалық полиция департаменті қылмыскерді тергейді.
Dialogue: 0,1:49:58.84,1:49:59.71,Default,,0,0,0,,Жоқ, бұл жаман.
Dialogue: 0,1:49:59.71,1:49:59.80,Default,,0,0,0,,Жоқ, бұл жаман.
Dialogue: 0,1:49:59.80,1:50:00.88,Default,,0,0,0,,Жоқ, бұл жаман.
Dialogue: 0,1:49:59.80,1:50:00.88,Default,,0,0,0,,Белгісіз шетелдік әйел деп жарияланды.
Dialogue: 0,1:50:00.88,1:50:00.96,Default,,0,0,0,,Белгісіз шетелдік әйел деп жарияланды.
Dialogue: 0,1:50:00.96,1:50:03.17,Default,,0,0,0,,Белгісіз шетелдік әйел деп жарияланды.
Dialogue: 0,1:50:00.96,1:50:03.17,Default,,0,0,0,,О, онда Гента-кун келесі жолы сынап көруі керек.
Dialogue: 0,1:50:03.17,1:50:03.72,Default,,0,0,0,,О, онда Гента-кун келесі жолы сынап көруі керек.
Dialogue: 0,1:50:03.72,1:50:04.22,Default,,0,0,0,,О, онда Гента-кун келесі жолы сынап көруі керек.
Dialogue: 0,1:50:03.72,1:50:04.22,Default,,0,0,0,,Куәгерлердің айтуынша, кінәлі...
Dialogue: 0,1:50:04.22,1:50:04.30,Default,,0,0,0,,Куәгерлердің айтуынша, кінәлі...
Dialogue: 0,1:50:04.30,1:50:05.97,Default,,0,0,0,,Куәгерлердің айтуынша, кінәлі...
Dialogue: 0,1:50:04.30,1:50:05.97,Default,,0,0,0,,Жақсы, маған қалдырыңыз.
Dialogue: 0,1:50:06.05,1:50:07.60,Default,,0,0,0,,Ол бізге көмектескісі келеді...
Dialogue: 0,1:50:07.60,1:50:08.68,Default,,0,0,0,,Ол бізге көмектескісі келеді...
Dialogue: 0,1:50:07.60,1:50:08.68,Default,,0,0,0,,…Осылайша мен осы сұмдыққа ат қойдым
Dialogue: 0,1:50:08.68,1:50:08.76,Default,,0,0,0,,Ол бізге көмектескісі келеді...
Dialogue: 0,1:50:08.76,1:50:11.14,Default,,0,0,0,,Ол бізге көмектескісі келеді...
Dialogue: 0,1:50:08.76,1:50:11.14,Default,,0,0,0,,Мен де сол үлкен апа сияқты жақсы болғым келеді.
Dialogue: 0,1:50:11.22,1:50:12.39,Default,,0,0,0,,Ах...
Dialogue: 0,1:50:11.22,1:50:12.39,Default,,0,0,0,,Айтпақшы, анау апа
Dialogue: 0,1:50:12.39,1:50:13.06,Default,,0,0,0,,Дұрыс, анау апа.
Dialogue: 0,1:50:13.14,1:50:15.02,Default,,0,0,0,,Қызық, қайда кетті?
Dialogue: 0,1:50:13.14,1:50:15.02,Default,,0,0,0,,Әйтпесе, өлейін деп тұрғанда ол қуыршақты алып кетпес едім.
Dialogue: 0,1:50:15.02,1:50:15.10,Default,,0,0,0,,Әйтпесе, мен өлейін деп тұрғанда ол қуыршақты алып кетпес едім.
Dialogue: 0,1:50:15.10,1:50:17.23,Default,,0,0,0,,Әйтпесе, мен өлейін деп тұрғанда ол қуыршақты алып кетпес едім.
Dialogue: 0,1:50:15.10,1:50:17.23,Default,,0,0,0,,Жарайды, сенің жақсы болатыныңа сенімдімін.
Dialogue: 0,1:50:17.31,1:50:19.69,Default,,0,0,0,,Мен ол адамды аквариумда кездестірдім.
Dialogue: 0,1:50:17.31,1:50:19.69,Default,,0,0,0,,Бірақ ол неге...
Dialogue: 0,1:50:19.69,1:50:19.77,Default,,0,0,0,,Бірақ ол неге...
Dialogue: 0,1:50:19.77,1:50:20.98,Default,,0,0,0,,Бірақ ол неге...
Dialogue: 0,1:50:19.77,1:50:20.98,Default,,0,0,0,,Амнезия?
Dialogue: 0,1:50:21.07,1:50:23.90,Default,,0,0,0,,Иә, біз ауруханада ойын ойнадық.
Dialogue: 0,1:50:23.99,1:50:27.78,Default,,0,0,0,,Мен саған қуыршақ бердім. Ол шынымен бақытты болды.
Dialogue: 0,1:50:27.87,1:50:28.78,Default,,0,0,0,,Эй
Dialogue: 0,1:50:28.87,1:50:32.00,Default,,0,0,0,,Иә, олардың барлығы бірдей қуыршақ, солай ма?
Dialogue: 0,1:50:32.08,1:50:33.83,Default,,0,0,0,,- (Аюми) Міне, бұл - (Гента) Міне.
Dialogue: 0,1:50:33.91,1:50:35.04,Default,,0,0,0,,Иә
Dialogue: 0,1:50:35.12,1:50:38.00,Default,,0,0,0,,Бірақ ол кетіп қалды.
Dialogue: 0,1:50:38.08,1:50:42.09,Default,,0,0,0,,Сіздің жадыңыз қайта оралды ма, сіз өзіңіз тұрған жеріңізге оралдыңыз ба?
Dialogue: 0,1:50:42.17,1:50:45.59,Default,,0,0,0,,Мен достасамыз деп ойладым.
Dialogue: 0,1:50:45.68,1:50:46.51,Default,,0,0,0,,Эй
Dialogue: 0,1:50:47.18,1:50:50.72,Default,,0,0,0,,Бірақ біз қазірдің өзінде дос емеспіз бе?
Dialogue: 0,1:50:50.81,1:50:53.43,Default,,0,0,0,,Өйткені бәрі мен туралы көп ойлайды
Dialogue: 0,1:50:53.52,1:50:54.39,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:50:54.48,1:50:56.27,Default,,0,0,0,,- (Мицухико) Дұрыс - (Гента) Ой!
Dialogue: 0,1:50:56.35,1:51:00.36,Default,,0,0,0,,Мүмкін олар оны өзгертті.
Dialogue: 0,1:51:00.44,1:51:01.27,Default,,0,0,0,,Иә
Dialogue: 0,1:51:02.15,1:51:05.57,Default,,0,0,0,,Ең соңында оның түсі
Dialogue: 0,1:51:07.07,1:51:13.07,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory