Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.42,0:00:07.92,Default,,0,0,0,,Бұл кітап «идеал» туралы.
Dialogue: 0,0:00:08.00,0:00:09.59,Default,,0,0,0,,Идеал
Dialogue: 0,0:00:09.67,0:00:15.68,Default,,0,0,0,,Иә, армандар, тілектер, сіз нені көбірек қалайсыз?
Dialogue: 0,0:00:16.14,0:00:17.93,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:18.76,0:00:20.52,Default,,0,0,0,,Эноның идеалы қандай?
Dialogue: 0,0:00:20.60,0:00:22.18,Default,,0,0,0,,Мен?
Dialogue: 0,0:00:22.27,0:00:25.56,Default,,0,0,0,,Эно нені көбірек қалайды?
Dialogue: 0,0:00:28.23,0:00:33.20,Default,,0,0,0,,Мен ән айтқым келеді
Dialogue: 0,0:00:33.28,0:00:36.74,Default,,0,0,0,,Ән? Бұл тамаша! Маған тыңдауға рұқсат етіңіз!
Dialogue: 0,0:00:36.82,0:00:39.33,Default,,0,0,0,,Келесі жолы
Dialogue: 0,0:00:40.95,0:00:43.79,Default,,0,0,0,,... Үйге кететін уақыт келді...
Dialogue: 0,0:00:49.00,0:00:50.00,Default,,0,0,0,,Ее Соно!!
Dialogue: 0,0:00:50.88,0:00:54.01,Default,,0,0,0,,Әкең сені тағы ұрса, айтшы.
Dialogue: 0,0:00:54.88,0:00:58.39,Default,,0,0,0,,Эноны ренжіткен адам жазаланады.
Dialogue: 0,0:01:01.64,0:01:03.02,Default,,0,0,0,,... Сәлем Саша
Dialogue: 0,0:01:03.73,0:01:06.94,Default,,0,0,0,,Сашаның идеалы қандай?
Dialogue: 0,0:01:08.31,0:01:09.65,Default,,0,0,0,,бап /...
Dialogue: 0,0:01:09.73,0:01:10.36,Default,,0,0,0,,...
Dialogue: 0,0:01:10.44,0:01:12.90,Default,,0,0,0,,Қарғыс атсын! Қарғыс атсын! Қарғыс атсын! Қарғыс атсын! Қарғыс атсын! Қарғыс атсын! Қарғыс атсын! Қарғыс атсын! Қарғыс атсын!!
Dialogue: 0,0:01:12.99,0:01:15.40,Default,,0,0,0,,Біз неге...! Боқ...
Dialogue: 0,0:01:15.49,0:01:16.82,Default,,0,0,0,,Чику... ШУРИ! RI |!
Dialogue: 0,0:01:17.74,0:01:20.62,Default,,0,0,0,,Сол жігіттер... Мен оларды өлтіремін...
Dialogue: 0,0:01:20.70,0:01:24.91,Default,,0,0,0,,Барлығына! Барлығы!! Мен сені өлтіремін!
Dialogue: 0,0:02:58.97,0:03:02.22,Default,,0,0,0,,Фауст әрбір шегіну жолын растады, бірақ...
Dialogue: 0,0:03:03.10,0:03:06.10,Default,,0,0,0,,Шынымды айтсам, бәрі қауіпсіз емес.
Dialogue: 0,0:03:07.14,0:03:09.85,Default,,0,0,0,,Байланыс үзілген бөлімшелердің шегі жоқ...
Dialogue: 0,0:03:10.64,0:03:14.69,Default,,0,0,0,,Түсіндім... Барлау миссиясына баруға дайындал.
Dialogue: 0,0:03:14.77,0:03:15.98,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:03:17.48,0:03:18.61,Default,,0,0,0,,Фауст
Dialogue: 0,0:03:19.49,0:03:22.70,Default,,0,0,0,,… Біз сізге сенеміз.
Dialogue: 0,0:03:32.37,0:03:36.25,Default,,0,0,0,,Бұл қалада әлі де бірдеңе бар ма?
Dialogue: 0,0:03:39.30,0:03:43.09,Default,,0,0,0,,...... Рюмон Рюмон эй, эй...
Dialogue: 0,0:03:43.18,0:03:46.30,Default,,0,0,0,,Ауру жұқтырғандар жұқтырмаған адамдармен ынтымақтасуға рұқсат етіңіз
Dialogue: 0,0:03:46.39,0:03:49.27,Default,,0,0,0,,Басқа жұқтырған адамға шабуыл жасауға мүмкіндік беру...
Dialogue: 0,0:03:49.89,0:03:52.14,Default,,0,0,0,,Мен бұл туралы онша жақсы сезінбеймін.
Dialogue: 0,0:03:52.73,0:03:58.36,Default,,0,0,0,,Бұл туралы ойлаудың қажеті жоқ, бұл жаңадан басталған нәрсе емес.
Dialogue: 0,0:04:00.03,0:04:00.90,Default,,0,0,0,,Өте өкінішті!
Dialogue: 0,0:04:00.99,0:04:02.53,Default,,0,0,0,,Міне, сіз үшін!
Dialogue: 0,0:04:02.61,0:04:03.99,Default,,0,0,0,,! 7?
Dialogue: 0,0:04:04.91,0:04:07.95,Default,,0,0,0,,Менің ойымша, сіз достарыңызды сол жерде кездестірдіңіз, бірақ...
Dialogue: 0,0:04:08.03,0:04:10.37,Default,,0,0,0,,Қаруыңызды қойып, берілесіз бе?
Dialogue: 0,0:04:10.45,0:04:11.29,Default,,0,0,0,,Не...
Dialogue: 0,0:04:11.37,0:04:14.79,Default,,0,0,0,,Аты немесе бір нәрсе бар... оны жылжытыңыз.
Dialogue: 0,0:04:14.88,0:04:16.42,Default,,0,0,0,,...
Dialogue: 0,0:04:17.71,0:04:18.63,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:04:19.38,0:04:21.67,Default,,0,0,0,,...
Dialogue: 0,0:04:21.76,0:04:25.80,Default,,0,0,0,,Сол кезде мен өкпемді екіге бөліп аламын.
Dialogue: 0,0:04:26.47,0:04:27.93,Default,,0,0,0,,Көріңіз бе?
Dialogue: 0,0:04:31.81,0:04:35.60,Default,,0,0,0,,Иә, иә, түсінсеңіз жақсы.
Dialogue: 0,0:04:41.07,0:04:42.44,Default,,0,0,0,,!
Dialogue: 0,0:04:42.94,0:04:45.61,Default,,0,0,0,,Сол оқиға...
Dialogue: 0,0:04:45.70,0:04:47.62,Default,,0,0,0,,Қоян Чаааааааааааан!!!
Dialogue: 0,0:04:48.20,0:04:53.12,Default,,0,0,0,,Ммм! Неге қоянның беті жұмсақ!?
Dialogue: 0,0:04:53.21,0:04:55.83,Default,,0,0,0,,- Өтінемін, тоқтат, Блэз-сан.
Dialogue: 0,0:04:55.92,0:04:59.34,Default,,0,0,0,,Оның азаюы мүмкін емес.
Dialogue: 0,0:04:59.42,0:05:03.63,Default,,0,0,0,,- Міне...
Dialogue: 0,0:05:03.72,0:05:06.05,Default,,0,0,0,,Хмм, мен көмектесе алмаймын.
Dialogue: 0,0:05:09.05,0:05:13.35,Default,,0,0,0,,Әй, жарайды, дәрігер, әдеттегідей.
Dialogue: 0,0:05:13.43,0:05:14.94,Default,,0,0,0,,Әрқашан...
Dialogue: 0,0:05:19.15,0:05:23.44,Default,,0,0,0,,Бұл жолы мен Грейс Рот ханымнан еріп жүруін өтіндім.
Dialogue: 0,0:05:24.03,0:05:26.82,Default,,0,0,0,,...
Dialogue: 0,0:05:26.91,0:05:28.32,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:05:31.37,0:05:32.79,Default,,0,0,0,,Айналаңызға қараңыз
Dialogue: 0,0:05:32.87,0:05:36.16,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:05:37.75,0:05:40.50,Default,,0,0,0,,Бұл екеуіне не болды?
Dialogue: 0,0:05:41.42,0:05:44.26,Default,,0,0,0,,Дәрігер, кешіріңіз.
Dialogue: 0,0:05:44.34,0:05:46.97,Default,,0,0,0,,Блэйз мырзаның соңынан ергенімді қалайсыз ба?
Dialogue: 0,0:05:47.05,0:05:47.84,Default,,0,0,0,,Не?
Dialogue: 0,0:05:49.64,0:05:53.60,Default,,0,0,0,,Мен сізден Блэйз мырзаның соңынан еруіңізді өтінемін.
Dialogue: 0,0:06:01.40,0:06:02.90,Default,,0,0,0,,Екі қолды көтеріңіз
Dialogue: 0,0:06:07.03,0:06:08.11,Default,,0,0,0,,Міне, сым
Dialogue: 0,0:06:08.20,0:06:12.66,Default,,0,0,0,,Мерген взвод % 2 84 Сіз күзетіңізді боса аласыз.
Dialogue: 0,0:06:12.74,0:06:14.91,Default,,0,0,0,,Келесі нүктеге өту
Dialogue: 0,0:06:17.50,0:06:21.38,Default,,0,0,0,,Екеуміз бірге соғысқанымыз қашан болды деп ойлаймын.
Dialogue: 0,0:06:21.46,0:06:24.09,Default,,0,0,0,,Бұл тоқтаусыз бірлескен үкімет.
Dialogue: 0,0:06:24.17,0:06:27.09,Default,,0,0,0,,Свит - Мен осы жерден кетемін.
Dialogue: 0,0:06:27.17,0:06:29.72,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:06:29.80,0:06:34.31,Default,,0,0,0,,Қараңғы қалаға барыңыз. Онда әлі көп жасырыну керек.
Dialogue: 0,0:06:34.39,0:06:36.98,Default,,0,0,0,,Біріктірмес бұрын басыңыз
Dialogue: 0,0:06:37.06,0:06:41.48,Default,,0,0,0,,Иә, иә, егер сізді қараңғы аудандар толғандырса, шынын айтыңыз.
Dialogue: 0,0:06:41.98,0:06:45.44,Default,,0,0,0,,Қалғанын сізге қалдырамын, мисс Сью.
Dialogue: 0,0:06:45.53,0:06:48.61,Default,,0,0,0,,Жоқ! Сен, мені олай атама!
Dialogue: 0,0:06:48.70,0:06:51.45,Default,,0,0,0,,Айналаңыздағы заттарды қиратпаңыз.
Dialogue: 0,0:06:51.53,0:06:52.78,Default,,0,0,0,,Grrrrr
Dialogue: 0,0:06:53.62,0:06:58.75,Default,,0,0,0,,Мен сендерді ренжіттім демеймін, бірақ кешіріңдер.
Dialogue: 0,0:06:59.75,0:07:03.08,Default,,0,0,0,,Енді сол жақтағы Рюмон халқы.
Dialogue: 0,0:07:03.17,0:07:04.84,Default,,0,0,0,,Yamato Jo...
Dialogue: 0,0:07:04.92,0:07:08.88,Default,,0,0,0,,Тоқтамаңыз......! Сіз де жұқтырған шығарсыз!?
Dialogue: 0,0:07:08.97,0:07:13.09,Default,,0,0,0,,Кімді жұқтырған адам құтқарды?
Dialogue: 0,0:07:13.18,0:07:15.85,Default,,0,0,0,,?
Dialogue: 0,0:07:15.93,0:07:19.31,Default,,0,0,0,,Жұқтырған адам өз ойын өзгертпес бұрын...
Dialogue: 0,0:07:19.39,0:07:21.06,Default,,0,0,0,,Жоғалып кету.
Dialogue: 0,0:07:27.28,0:07:28.23,Default,,0,0,0,,Ха...
Dialogue: 0,0:07:30.95,0:07:34.12,Default,,0,0,0,,Бұл жай ғана болды.
Dialogue: 0,0:07:34.20,0:07:35.91,Default,,0,0,0,,Амияның өтініші бойынша
Dialogue: 0,0:07:35.99,0:07:40.58,Default,,0,0,0,,...
Dialogue: 0,0:07:41.16,0:07:42.50,Default,,0,0,0,,Дәрігер де
Dialogue: 0,0:07:42.58,0:07:47.50,Default,,0,0,0,,«Мен мұнда сені уайымдағандықтан келдім» деп айта алмаймын.
Dialogue: 0,0:07:48.76,0:07:49.76,Default,,0,0,0,,… Кешіріңіз.
Dialogue: 0,0:07:49.84,0:07:52.18,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:07:52.26,0:07:55.72,Default,,0,0,0,,Иә, біз де осы жаққа бара жатырмыз.
Dialogue: 0,0:07:55.80,0:07:59.93,Default,,0,0,0,,...
Dialogue: 0,0:08:00.02,0:08:04.94,Default,,0,0,0,,Онда біз тағы бір мергендік топпен кездесіп, тапсырманы орындаймыз.
Dialogue: 0,0:08:05.02,0:08:09.53,Default,,0,0,0,,?
Dialogue: 0,0:08:13.57,0:08:14.99,Default,,0,0,0,,Грейс Рот мырза
Dialogue: 0,0:08:15.07,0:08:20.37,Default,,0,0,0,,Ұрыс даласында амалсыз қалатын кездер болатынын түсінемін.
Dialogue: 0,0:08:20.45,0:08:26.67,Default,,0,0,0,,Бірақ шындық, мен ешкімнің ешкімді ренжіткенін қаламаймын.
Dialogue: 0,0:08:27.92,0:08:29.17,Default,,0,0,0,,... Түсіндім.
Dialogue: 0,0:08:30.13,0:08:31.17,Default,,0,0,0,,... дәл қазір
Dialogue: 0,0:08:31.26,0:08:32.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:32.30,0:08:35.47,Default,,0,0,0,,Оған бірдеңе болды ма?
Dialogue: 0,0:08:35.55,0:08:38.89,Default,,0,0,0,,…        ?
Dialogue: 0,0:08:38.97,0:08:42.31,Default,,0,0,0,,Кешіріңіз, бұл жай ғана алаңдаушылық, сондықтан бұл туралы алаңдамаңыз.
Dialogue: 0,0:08:43.94,0:08:50.32,Default,,0,0,0,,...
Dialogue: 0,0:08:52.82,0:08:54.03,Default,,0,0,0,,Гяааааа
Dialogue: 0,0:08:54.11,0:08:55.28,Default,,0,0,0,,Айқай
Dialogue: 0,0:08:55.78,0:08:56.91,Default,,0,0,0,,Міне.
Dialogue: 0,0:08:56.99,0:08:58.24,Default,,0,0,0,,Кеттік, доктор!
Dialogue: 0,0:08:58.32,0:08:59.78,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:09:00.41,0:09:03.62,Default,,0,0,0,,-         -       …
Dialogue: 0,0:09:09.21,0:09:11.30,Default,,0,0,0,,...
Dialogue: 0,0:09:12.09,0:09:14.34,Default,,0,0,0,,Барлығыңыз дайын болыңыздар!
Dialogue: 0,0:09:19.51,0:09:20.93,Default,,0,0,0,,?
Dialogue: 0,0:09:21.01,0:09:23.73,Default,,0,0,0,,Маған көмектесіңізші.
Dialogue: 0,0:09:25.14,0:09:26.10,Default,,0,0,0,,Не?!
Dialogue: 0,0:09:26.69,0:09:29.44,Default,,0,0,0,,Бұл...! Мефистоның...!
Dialogue: 0,0:09:29.52,0:09:31.94,Default,,0,0,0,,Уо оо ооо~
Dialogue: 0,0:09:32.53,0:09:34.19,Default,,0,0,0,,Аа аа а
Dialogue: 0,0:09:34.82,0:09:36.78,Default,,0,0,0,,Дәмі нашар өнер...!!
Dialogue: 0,0:09:37.53,0:09:40.28,Default,,0,0,0,,Әй... эй Иван...?
Dialogue: 0,0:09:41.24,0:09:44.12,Default,,0,0,0,,Тоқта... Иван...1 Тоқта...
Dialogue: 0,0:09:44.20,0:09:46.71,Default,,0,0,0,,Га a aa aa thea
Dialogue: 0,0:09:48.54,0:09:49.54,Default,,0,0,0,,…… мефувист
Dialogue: 0,0:09:50.54,0:09:53.17,Default,,0,0,0,,Сырттағы бұл не болды?
Dialogue: 0,0:09:53.25,0:09:55.17,Default,,0,0,0,,А, мен көрдім.
Dialogue: 0,0:09:55.26,0:10:01.64,Default,,0,0,0,,Еккен тұқымым ақыры гүлдеп, Малым көбейді.
Dialogue: 0,0:10:01.72,0:10:06.23,Default,,0,0,0,,Мен олардың бәрін, соның ішінде Родос пен Корольдік гвардия бюросын да өлтіремін!
Dialogue: 0,0:10:06.31,0:10:08.60,Default,,0,0,0,,... Барлығының ақыл-парасаты жоғалды.
Dialogue: 0,0:10:08.69,0:10:14.03,Default,,0,0,0,,Кешіріңіз, егер бұлай болса, мен оны басқара алмаймын және мен депрессияға ұшыраймын.
Dialogue: 0,0:10:14.11,0:10:15.99,Default,,0,0,0,,Менің достарым да қатал болды.
Dialogue: 0,0:10:16.07,0:10:17.74,Default,,0,0,0,,Уайымдама, Фауст!
Dialogue: 0,0:10:17.82,0:10:20.66,Default,,0,0,0,,Біз сізге бәрібір.
Dialogue: 0,0:10:20.74,0:10:21.74,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін!?
Dialogue: 0,0:10:22.45,0:10:25.50,Default,,0,0,0,,Олар азап шегуде!! Енді тоқтатыңыз!!
Dialogue: 0,0:10:26.25,0:10:28.58,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:10:28.67,0:10:31.21,Default,,0,0,0,,Олар енді тірі емес.
Dialogue: 0,0:10:31.29,0:10:35.55,Default,,0,0,0,,Қолдануға болатын бөліктерді сынғанша пайдаланыңыз...
Dialogue: 0,0:10:37.76,0:10:38.93,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:10:39.01,0:10:42.18,Default,,0,0,0,,Бұны істемесең, қашып құтыла алмайсың!!
Dialogue: 0,0:10:42.26,0:10:44.89,Default,,0,0,0,,Менің айналамда жаулар бар, сондықтан маған қосымша күштер қажет емес!
Dialogue: 0,0:10:44.97,0:10:47.64,Default,,0,0,0,,Осылай кете берсек, өлтіреміз!!
Dialogue: 0,0:10:47.73,0:10:50.44,Default,,0,0,0,,Аяз Нова міндетті түрде сізге асығып келеді.
Dialogue: 0,0:10:50.52,0:10:52.19,Default,,0,0,0,,Оған дейін шыдасаңыз...!
Dialogue: 0,0:10:52.27,0:10:54.02,Default,,0,0,0,,Фрост Нова А?
Dialogue: 0,0:10:54.11,0:10:57.53,Default,,0,0,0,,Осыншама күтіп, келмесең, мені сататыныңа сенімдімін.
Dialogue: 0,0:10:57.61,0:10:58.53,Default,,0,0,0,,Бұл шындық болуы мүмкін емес!
Dialogue: 0,0:10:58.61,0:11:02.45,Default,,0,0,0,,Мен Фауст пен Таллаға ғана сенемін!
Dialogue: 0,0:11:02.53,0:11:04.99,Default,,0,0,0,,Тірі қалсақ не істер едік!!
Dialogue: 0,0:11:06.33,0:11:07.66,Default,,0,0,0,,Мефува жұдырық...
Dialogue: 0,0:11:09.96,0:11:13.25,Default,,0,0,0,,Фауст!? Күте тұрыңыз, қайда барасыз!?
Dialogue: 0,0:11:13.33,0:11:15.50,Default,,0,0,0,,Фауст!!
Dialogue: 0,0:11:16.50,0:11:17.51,Default,,0,0,0,,Гусо……!1!
Dialogue: 0,0:11:17.59,0:11:20.01,Default,,0,0,0,,Неліктен мұнда ешкім жоқ?
Dialogue: 0,0:11:20.09,0:11:23.64,Default,,0,0,0,,Қашуға кешігіп келгендер көп болса керек...!
Dialogue: 0,0:11:27.72,0:11:31.23,Default,,0,0,0,,Капитан Чен! Мен мұнда да тұрғындарды көрмеймін!
Dialogue: 0,0:11:31.31,0:11:34.40,Default,,0,0,0,,Не болып жатыр және кім...!
Dialogue: 0,0:11:38.69,0:11:39.74,Default,,0,0,0,,... сәл қашықтықта
Dialogue: 0,0:11:39.82,0:11:41.95,Default,,0,0,0,,Не? Капитан!!
Dialogue: 0,0:12:01.59,0:12:02.84,Default,,0,0,0,,... Сіз кімсіз?
Dialogue: 0,0:12:13.69,0:12:16.11,Default,,0,0,0,,… Маған жауап беріңіз. Сіз мұнда не істеп жүрсіз?
Dialogue: 0,0:12:16.69,0:12:19.15,Default,,0,0,0,,Түсіндіру міндетті емес
Dialogue: 0,0:12:20.24,0:12:22.24,Default,,0,0,0,,...Саған мұнда кел деп кім айтты?
Dialogue: 0,0:12:22.32,0:12:27.74,Default,,0,0,0,,Чиен: Бұл кезеңде біз бір-бірімізбен келіссөздер жүргізбеуіміз керек.
Dialogue: 0,0:12:27.83,0:12:33.58,Default,,0,0,0,,Біз енді жаңа инфекциялар тудыратын қауіпті жоямыз.
Dialogue: 0,0:12:33.67,0:12:38.00,Default,,0,0,0,,Императорлық гвардия бюросы Реюнионның негізгі күштерін мүмкіндігінше тезірек жоюы керек.
Dialogue: 0,0:12:38.88,0:12:41.84,Default,,0,0,0,,... Бұдан әрі кірмеңіз.
Dialogue: 0,0:12:43.05,0:12:43.93,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:12:51.60,0:12:55.35,Default,,0,0,0,,Бұл ақымақ айдаһар! Қашаннан бері осылай жүресің?
Dialogue: 0,0:12:55.44,0:12:56.10,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,0:12:56.19,0:13:00.11,Default,,0,0,0,,Қара киім киген жігіттерді танисың ба?
Dialogue: 0,0:13:00.19,0:13:01.78,Default,,0,0,0,,2 Медициналық ұсыныс Қызыл З
Dialogue: 0,0:13:02.40,0:13:05.41,Default,,0,0,0,,Белгілі бір дағдысы мен пәрмені бар.
Dialogue: 0,0:13:05.49,0:13:07.78,Default,,0,0,0,,Сол дүниенің қасіреті 2
Dialogue: 0,0:13:07.87,0:13:11.16,Default,,0,0,0,,Түсінбесеңіз де бақылаусыз қалатын нәрсе емес.
Dialogue: 0,0:13:12.04,0:13:14.79,Default,,0,0,0,,Біз білмейтін арнайы жасақ...
Dialogue: 0,0:13:15.67,0:13:17.38,Default,,0,0,0,,72
Dialogue: 0,0:13:17.46,0:13:20.75,Default,,0,0,0,,Арнайы жасақ... Мама, маған біраз уақыт беріңіз.
Dialogue: 0,0:13:21.42,0:13:22.71,Default,,0,0,0,,Оны тексеріңіз
Dialogue: 0,0:13:30.97,0:13:32.18,Default,,0,0,0,,Қаруыңызды түсіріңіз
Dialogue: 0,0:13:34.39,0:13:35.44,Default,,0,0,0,,Беру
Dialogue: 0,0:13:36.98,0:13:40.57,Default,,0,0,0,,...Неге атпадың? Мүмкіндік болған болуы керек.
Dialogue: 0,0:13:41.27,0:13:45.49,Default,,0,0,0,,Сіздің денеңіз бұл күйде ұзаққа бармайды.
Dialogue: 0,0:13:45.57,0:13:51.58,Default,,0,0,0,,Мен осында келгенге дейін көп адамға көмектескен өнерімді теріс пайдаландым...
Dialogue: 0,0:13:52.49,0:13:55.46,Default,,0,0,0,,Егер ауру адам өнерді тым көп пайдаланса не болады?
Dialogue: 0,0:13:55.54,0:13:57.33,Default,,0,0,0,,Мен мұны көп білемін.
Dialogue: 0,0:13:57.42,0:14:01.34,Default,,0,0,0,,Мен сені басқа Реюниондардан ерекше деп ойладым.
Dialogue: 0,0:14:02.09,0:14:04.59,Default,,0,0,0,,Енді мені атуға тырыспа.
Dialogue: 0,0:14:05.72,0:14:09.30,Default,,0,0,0,,... Сен атпадың, сондықтан мен де атпадым.
Dialogue: 0,0:14:09.89,0:14:14.60,Default,,0,0,0,,Бірақ мені өлтірмейінше келесі жолы олай болмайды.
Dialogue: 0,0:14:14.68,0:14:16.56,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:14:17.64,0:14:21.56,Default,,0,0,0,,Өлтіру және өлтіру... Мен ол жерден шыға алмаймын.
Dialogue: 0,0:14:22.61,0:14:24.90,Default,,0,0,0,,Сіз және мен...
Dialogue: 0,0:14:27.28,0:14:27.90,Default,,0,0,0,,Шиджишимата!
Dialogue: 0,0:14:32.33,0:14:33.99,Default,,0,0,0,,Глюси Тин Құрт мырза
Dialogue: 0,0:14:34.08,0:14:36.50,Default,,0,0,0,,Атқарушы биліктің Фауст екені даусыз.
Dialogue: 0,0:14:37.46,0:14:39.29,Default,,0,0,0,,… Қысқа үзіліс жасаңыз.
Dialogue: 0,0:14:39.79,0:14:40.63,Default,,0,0,0,,Цун...
Dialogue: 0,0:14:44.13,0:14:45.46,Default,,0,0,0,,Брамның 2 шебері қайда кетті?
Dialogue: 0,0:14:45.55,0:14:49.84,Default,,0,0,0,,Незу мырза, сіз жасырын түрде ештеңе істеп жатқан жоқсыз, солай ма?
Dialogue: 0,0:14:49.93,0:14:51.55,Default,,0,0,0,,Riki na guku me 2
Dialogue: 0,0:14:51.64,0:14:56.10,Default,,0,0,0,,Айтуларынша, Чен түкпір-түкпірде әбден сырқаттанған кейбір адамдарды кездестірді.
Dialogue: 0,0:14:56.18,0:14:57.52,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:14:58.68,0:15:01.35,Default,,0,0,0,,Ештеңе білмейтін сияқтысың.
Dialogue: 0,0:15:01.44,0:15:03.40,Default,,0,0,0,,Қосымшаны қалай жабуға болады?
Dialogue: 0,0:15:03.48,0:15:04.11,Default,,0,0,0,,!
Dialogue: 0,0:15:06.69,0:15:12.37,Default,,0,0,0,,Бұл ауруды жұқтырған адамның арқасын кесу, олардың айтқан қаупін жою арқылы ма?
Dialogue: 0,0:15:12.45,0:15:15.87,Default,,0,0,0,,Олар не айтқысы келеді...1!!
Dialogue: 0,0:15:15.95,0:15:18.25,Default,,0,0,0,,Жердің тікенді жетелеушісі /2
Dialogue: 0,0:15:18.33,0:15:21.17,Default,,0,0,0,,7
Dialogue: 0,0:15:21.25,0:15:23.67,Default,,0,0,0,,Қызыл 7 Гунсифазия 7/
Dialogue: 0,0:15:23.75,0:15:25.09,Default,,0,0,0,,Мен ештеңе білмеймін
Dialogue: 0,0:15:25.17,0:15:25.80,Default,,0,0,0,,Naa Z〆
Dialogue: 0,0:15:25.88,0:15:30.59,Default,,0,0,0,,Азаматтардың неден қорқатынын білесіз бе?
Dialogue: 0,0:15:30.68,0:15:32.51,Default,,0,0,0,,Жұқтырған адам
Dialogue: 0,0:15:32.59,0:15:35.97,Default,,0,0,0,,Кездесу немесе жоқ
Dialogue: 0,0:15:36.06,0:15:39.06,Default,,0,0,0,,Барлық қауіптерді жою керек...
Dialogue: 0,0:15:39.73,0:15:43.98,Default,,0,0,0,,Сонымен қатар, біз Корольдік гвардия бюросының қолдарын ластауға жол бере алмаймыз, солай ма?»
Dialogue: 0,0:15:44.06,0:15:46.40,Default,,0,0,0,,Сіз шалғайдағы барлық жұқтырған адамдарды жоюды жоспарлап отырсыз ба!?
Dialogue: 0,0:15:46.48,0:15:49.32,Default,,0,0,0,,Толқын көтеріледі деп қорықпа.
Dialogue: 0,0:15:49.40,0:15:51.86,Default,,0,0,0,,Қараңғы қала - сенің әкең тұрған жер.
Dialogue: 0,0:15:51.95,0:15:54.95,Default,,0,0,0,,Өз ойыңмен жасаған нәрсе емес пе?! Мынадай нәрсе...
Dialogue: 0,0:15:55.03,0:15:58.41,Default,,0,0,0,,Енді @ және Фунибункудің зейнетке шығуы ақыры аяқталды.
Dialogue: 0,0:15:58.49,0:16:00.54,Default,,0,0,0,,Мисан деру бу дабу миру но
Dialogue: 0,0:16:00.62,0:16:01.41,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:16:01.50,0:16:02.58,Default,,0,0,0,,Цвай Пуи Ах
Dialogue: 0,0:16:02.67,0:16:05.33,Default,,0,0,0,,Мәсіхтің өліміне байланысты
Dialogue: 0,0:16:05.96,0:16:07.38,Default,,0,0,0,,Әйелдің...
Dialogue: 0,0:16:09.55,0:16:10.80,Default,,0,0,0,,Хаба хаа...
Dialogue: 0,0:16:10.88,0:16:13.26,Default,,0,0,0,,Ал егер!? Лорд Незу!?
Dialogue: 0,0:16:16.93,0:16:19.93,Default,,0,0,0,,Жарайды, телефонымды қойдыңыз...!!
Dialogue: 0,0:16:23.90,0:16:25.81,Default,,0,0,0,,… Дренаж жүйесі?
Dialogue: 0,0:16:26.40,0:16:28.32,Default,,0,0,0,,Мал итеріле бастады
Dialogue: 0,0:16:28.94,0:16:33.20,Default,,0,0,0,,Кенеттен қара киім киген жігіттер пайда болып, жан-жақтан адамдарды өлтіріп жатқан сияқты.
Dialogue: 0,0:16:33.28,0:16:34.32,Default,,0,0,0,,бұл...?
Dialogue: 0,0:16:34.41,0:16:35.87,Default,,0,0,0,,Бұл жерден дереу кетіңіз
Dialogue: 0,0:16:35.95,0:16:38.12,Default,,0,0,0,,Слэм әскерлерімен қосылыңыз.
Dialogue: 0,0:16:40.12,0:16:41.50,Default,,0,0,0,,Фауст?
Dialogue: 0,0:16:41.58,0:16:43.21,Default,,0,0,0,,- Сіз жарақат алдыңыз ба? - Сіз қозғала аласыз ба?
Dialogue: 0,0:16:43.29,0:16:45.92,Default,,0,0,0,,- А... жарайды... - Неге мені тастап жалғыз кеттің!?
Dialogue: 0,0:16:46.00,0:16:48.84,Default,,0,0,0,,Мұның ашылуына аз ғана уақыт қалды. Асығыңыз...
Dialogue: 0,0:16:48.92,0:16:49.96,Default,,0,0,0,,Шулы!!
Dialogue: 0,0:16:50.67,0:16:51.96,Default,,0,0,0,,Фауст! Уайымдама!
Dialogue: 0,0:16:52.67,0:16:54.88,Default,,0,0,0,,Сізге енді қауіпті ештеңе істеудің қажеті жоқ деп үміттенемін.
Dialogue: 0,0:16:54.97,0:16:58.64,Default,,0,0,0,,1 өйткені мықты мал басын көбейтеміз!
Dialogue: 0,0:17:01.06,0:17:03.39,Default,,0,0,0,,Бұл өнерді енді қолданбаңыз.
Dialogue: 0,0:17:03.48,0:17:04.77,Default,,0,0,0,,тіпті ішінде
Dialogue: 0,0:17:09.44,0:17:11.69,Default,,0,0,0,,Мефистоны ұстаңыз.
Dialogue: 0,0:17:11.78,0:17:12.49,Default,,0,0,0,,Казунобу…a
Dialogue: 0,0:17:13.61,0:17:15.03,Default,,0,0,0,,… Шығарылу мүмкіндігі
Dialogue: 0,0:17:15.82,0:17:17.20,Default,,0,0,0,,Мен жасаймын
Dialogue: 0,0:17:20.54,0:17:22.58,Default,,0,0,0,,Бұл қорқынышты жағдай...
Dialogue: 0,0:17:24.79,0:17:25.92,Default,,0,0,0,,Армия
Dialogue: 0,0:17:26.00,0:17:30.71,Default,,0,0,0,,Бұл дұрыс. Келесі нүктеге өтіңіз.
Dialogue: 0,0:17:31.67,0:17:33.71,Default,,0,0,0,,Жатқан жеріңіз жайлы болсын...
Dialogue: 0,0:17:36.76,0:17:37.76,Default,,0,0,0,,! 7?
Dialogue: 0,0:17:37.84,0:17:38.84,Default,,0,0,0,,Ах Миа 7
Dialogue: 0,0:17:38.93,0:17:43.39,Default,,0,0,0,,Янаги Такумидің арман билеті, ``Бізді өз отанына апарған қытай халқы //
Dialogue: 0,0:17:43.47,0:17:46.23,Default,,0,0,0,,Қатысудан аулақ болыңыз! Ол сан...
Dialogue: 0,0:17:46.31,0:17:47.44,Default,,0,0,0,,Аку Гу…
Dialogue: 0,0:17:47.52,0:17:51.27,Default,,0,0,0,,Ашуым өшкенде, Құдайдың құдіретіне жүгінемін.
Dialogue: 0,0:17:51.36,0:17:53.23,Default,,0,0,0,,У га а ааа
Dialogue: 0,0:17:55.95,0:17:56.61,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:17:58.57,0:18:00.20,Default,,0,0,0,,Бүйірлік көшеге! Асығыңыз!
Dialogue: 0,0:18:04.79,0:18:08.54,Default,,0,0,0,,Бізді жеңдер, зомбилер!
Dialogue: 0,0:18:12.71,0:18:13.63,Default,,0,0,0,,Жүгіру!!
Dialogue: 0,0:18:14.46,0:18:17.01,Default,,0,0,0,,Енді маңызды емес
Dialogue: 0,0:18:25.43,0:18:27.77,Default,,0,0,0,,...... Цу 1
Dialogue: 0,0:18:39.20,0:18:40.36,Default,,0,0,0,,Фауст…
Dialogue: 0,0:18:41.57,0:18:45.37,Default,,0,0,0,,Барлық нұсқауларды орындаңыз _ Жол ашсам
Dialogue: 0,0:18:45.45,0:18:49.00,Default,,0,0,0,,Қараңғы жерге барыңыз және Аяз Нованы күтіңіз.
Dialogue: 0,0:18:49.08,0:18:53.63,Default,,0,0,0,,Менің бұл өнерім сізді міндетті түрде қорғайды.
Dialogue: 0,0:18:53.71,0:18:59.38,Default,,0,0,0,,Коное бюросынан, сия костюмдерінен, сөзсіз.
Dialogue: 0,0:19:00.93,0:19:03.14,Default,,0,0,0,,... Түсіндім.
Dialogue: 0,0:19:05.56,0:19:08.23,Default,,0,0,0,,Жоқ, жоқ, жоқ!! Тоқта!
Dialogue: 0,0:19:09.35,0:19:12.90,Default,,0,0,0,,Бұл дұрыс емес!! Енді тоқтатыңыз!!
Dialogue: 0,0:19:13.77,0:19:14.90,Default,,0,0,0,,Саша
Dialogue: 0,0:19:15.61,0:19:16.90,Default,,0,0,0,,Мен айттым ғой!!
Dialogue: 0,0:19:16.98,0:19:19.15,Default,,0,0,0,,Біз әрқашан бірге боламыз!
Dialogue: 0,0:19:19.82,0:19:21.95,Default,,0,0,0,,Талла-ни-санның орнына қайтайық!
Dialogue: 0,0:19:22.03,0:19:27.16,Default,,0,0,0,,Ей, үйге бірге барайық!! Саша!!
Dialogue: 0,0:19:28.20,0:19:30.41,Default,,0,0,0,,Мефисто үшін
Dialogue: 0,0:19:30.50,0:19:35.00,Default,,0,0,0,,Сіз бәрін лақтырып тастай аласыз ба? Фауст
Dialogue: 0,0:19:37.17,0:19:41.01,Default,,0,0,0,,Ено біз ол кезде болатынбыз
Dialogue: 0,0:19:41.72,0:19:45.39,Default,,0,0,0,,Мүмкін бәрін лақтырып, қашып кетуім керек пе еді.
Dialogue: 0,0:19:46.51,0:19:53.02,Default,,0,0,0,,Біреу ренжіп қалса, біреу ренжісе ән айту қиын.
Dialogue: 0,0:19:55.11,0:19:55.90,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:57.69,0:20:00.44,Default,,0,0,0,,Ондай сөздерді айтпа...!
Dialogue: 0,0:20:00.53,0:20:05.32,Default,,0,0,0,,Баяғыда сіз менің идеалым қандай деп сұрадыңыз.
Dialogue: 0,0:20:06.28,0:20:10.33,Default,,0,0,0,,Мен сенің күліп, өмір сүргеніңді қалаймын
Dialogue: 0,0:20:11.00,0:20:14.58,Default,,0,0,0,,Жалғыз болсаң да аман қалғаныңды қалаймын.
Dialogue: 0,0:20:16.63,0:20:19.42,Default,,0,0,0,,Айтыңызшы, Эно.
Dialogue: 0,0:20:20.67,0:20:24.80,Default,,0,0,0,,Жоқ... мен оны қаламаймын...
Dialogue: 0,0:20:24.89,0:20:26.80,Default,,0,0,0,,Са Ша!
Dialogue: 0,0:20:26.89,0:20:30.64,Default,,0,0,0,,Саша аааааааааа...
Dialogue: 0,0:20:48.95,0:20:49.83,Default,,0,0,0,,… Мынау...
Dialogue: 0,0:20:50.58,0:20:53.12,Default,,0,0,0,,Менің бұлай асығу ойым жоқ...
Dialogue: 0,0:20:55.58,0:21:01.80,Default,,0,0,0,,Біртүрлі тас... Мені ішуге... анау әйел...
Dialogue: 0,0:21:01.88,0:21:03.26,Default,,0,0,0,,Тамақ...
Dialogue: 0,0:21:03.34,0:21:05.38,Default,,0,0,0,,Гейджді қайшы...
Dialogue: 0,0:21:06.09,0:21:08.51,Default,,0,0,0,,Шынымен істегіңіз келетін нәрсені жасаңыз!
Dialogue: 0,0:21:09.22,0:21:12.56,Default,,0,0,0,,Сіз мұндай нәрселерді жек көруіңіз керек!
Dialogue: 0,0:21:12.64,0:21:14.56,Default,,0,0,0,,Саша
Dialogue: 0,0:21:14.64,0:21:19.27,Default,,0,0,0,,Мен ән айттым ба...
Dialogue: 0,0:21:22.36,0:21:26.28,Default,,0,0,0,,Қазір мен де жұқтырған адаммын.
Dialogue: 0,0:21:27.74,0:21:30.62,Default,,0,0,0,,Бірге өмір сүрейік
Dialogue: 0,0:21:32.24,0:21:35.12,Default,,0,0,0,,Бірде-бір кездесудің қашып кетуіне жол бермеңіз!!
Dialogue: 0,0:21:35.21,0:21:41.13,Default,,0,0,0,,Коное бюросының атынан! Олардың озбырлығын тоқтатыңыз! Ааааа!
Dialogue: 0,0:21:41.21,0:21:43.80,Default,,0,0,0,,Дайындық Иә Иә Иә!!
Dialogue: 0,0:21:44.97,0:21:48.22,Default,,0,0,0,,Ату, а!
Dialogue: 0,0:21:49.72,0:21:55.72,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory