Dialogue: 0,0:07:13.03,0:07:16.03,Rubi,,0000,0000,0000,,Рикон
Dialogue: 0,0:07:13.03,0:07:16.03,Rubi,,0000,0000,0000,,Рикон
Dialogue: 0,0:07:13.03,0:07:16.03,Default,,0000,0000,0000,,Ажырасу - ажырасу!
Dialogue: 0,0:07:13.03,0:07:16.03,Default,,0000,0000,0000,,Белгісіз себеппен, тіпті бір-біріңіздің шынайы кім екеніңізді білмесеңіз де—
Dialogue: 0,0:07:16.03,0:07:19.67,Default,,0000,0000,0000,,Ух... ықылық...
Dialogue: 0,0:07:16.03,0:07:19.67,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:07:19.67,0:07:22.57,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:19.67,0:07:22.57,Default,,0000,0000,0000,,Жарайды, Маруко...
Dialogue: 0,0:07:19.67,0:07:22.57,Rubi,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:07:19.67,0:07:22.57,Default,,0000,0000,0000,,Ал Кира
Dialogue: 0,0:07:22.57,0:07:25.54,Rubi,,0000,0000,0000,,Екі адам
Dialogue: 0,0:07:22.57,0:07:25.54,Rubi,,0000,0000,0000,,Джудан
Dialogue: 0,0:07:22.57,0:07:25.54,Default,,0000,0000,0000,,Тіпті бұл екеуі әзілдеді.
Dialogue: 0,0:07:22.57,0:07:25.54,Rubi,,0000,0000,0000,,Фуфуфу
Dialogue: 0,0:07:22.57,0:07:25.54,Default,,0000,0000,0000,,Екеуміз жұп болып кеткендей емеспіз.
Dialogue: 0,0:07:25.54,0:07:27.54,Default,,0000,0000,0000,,Оны жай қалдырыңыз.
Dialogue: 0,0:07:27.54,0:07:31.18,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:07:27.54,0:07:31.18,Rubi,,0000,0000,0000,,Ичидайдзи
Dialogue: 0,0:07:27.54,0:07:31.18,Default,,0000,0000,0000,,Сіз үйде үлкен мәселесіз.
Dialogue: 0,0:07:27.54,0:07:31.18,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:27.54,0:07:31.18,Default,,0000,0000,0000,,Сіз мұны жиі айта аласыз.
Dialogue: 0,0:07:31.18,0:07:32.68,Default,,0000,0000,0000,,Ах. Қалай болғанда да
Dialogue: 0,0:07:32.68,0:07:36.55,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:32.68,0:07:36.55,Rubi,,0000,0000,0000,,Шинпай
Dialogue: 0,0:07:32.68,0:07:36.55,Default,,0000,0000,0000,,Маруко не нәрсеге алаңдайды
Dialogue: 0,0:07:32.68,0:07:36.55,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:07:32.68,0:07:36.55,Default,,0000,0000,0000,,Ол жоқ деп жылама.
Dialogue: 0,0:07:36.55,0:07:38.55,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:07:36.55,0:07:38.55,Rubi,,0000,0000,0000,,Каоара
Dialogue: 0,0:07:36.55,0:07:38.55,Default,,0000,0000,0000,,Ал, мен бетімді жуайын.
Dialogue: 0,0:07:36.55,0:07:38.55,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:39.55,0:07:41.69,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:07:39.55,0:07:41.69,Default,,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,0:07:41.69,0:07:44.19,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:07:41.69,0:07:44.19,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:07:41.69,0:07:44.19,Default,,0000,0000,0000,,Мен кетемін
Dialogue: 0,0:07:41.69,0:07:44.19,Rubi,,0000,0000,0000,,Бір рет
Dialogue: 0,0:07:41.69,0:07:44.19,Default,,0000,0000,0000,,Қалағаныңды істе
Dialogue: 0,0:07:44.19,0:07:47.09,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:07:44.19,0:07:47.09,Default,,0000,0000,0000,,《Е... мен кетемін...》
Dialogue: 0,0:07:47.09,0:07:50.70,Default,,0000,0000,0000,,Маған ұнамайды!
Dialogue: 0,0:07:47.09,0:07:50.70,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:07:47.09,0:07:50.70,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:07:47.09,0:07:50.70,Default,,0000,0000,0000,,Мама, өтінемін, кетпеңіз!
