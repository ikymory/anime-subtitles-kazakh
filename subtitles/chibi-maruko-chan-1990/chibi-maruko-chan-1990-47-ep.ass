Dialogue: 0,0:07:52.63,0:07:55.53,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:52.63,0:07:55.53,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:07:52.63,0:07:55.53,Default,,0000,0000,0000,,Маруко қайтып келгенше
Dialogue: 0,0:07:52.63,0:07:55.53,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:07:52.63,0:07:55.53,Default,,0000,0000,0000,,Мен күтемін.
Dialogue: 0,0:07:55.53,0:07:58.53,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:07:55.53,0:07:58.53,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:07:55.53,0:07:58.53,Default,,0000,0000,0000,,Кешкі асты тез ішіңіз
Dialogue: 0,0:07:55.53,0:07:58.53,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:07:55.53,0:07:58.53,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:55.53,0:07:58.53,Default,,0000,0000,0000,,Мектепке бар!
