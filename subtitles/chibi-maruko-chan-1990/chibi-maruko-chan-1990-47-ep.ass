Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:05.66,0:01:16.16,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:45.72,0:03:48.22,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:45.72,0:03:48.22,Default,,0000,0000,0000,,《Ой!
Dialogue: 0,0:03:45.72,0:03:48.22,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:45.72,0:03:48.22,Default,,0000,0000,0000,,Монитор Лизард мырза, қайда барасыз? 》
Dialogue: 0,0:03:48.22,0:03:51.12,Default,,0000,0000,0000,,《Уау
Dialogue: 0,0:03:48.22,0:03:51.12,Rubi,,0000,0000,0000,,Мурасаки
Dialogue: 0,0:03:48.22,0:03:51.12,Rubi,,0000,0000,0000,,Гейген
Dialogue: 0,0:03:48.22,0:03:51.12,Default,,0000,0000,0000,,Тек күлгін жазықтарға дейін
Dialogue: 0,0:03:51.12,0:03:53.09,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:03:51.12,0:03:53.09,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:03:51.12,0:03:53.09,Default,,0000,0000,0000,,Саяхатқа шығыңыз, уау.
Dialogue: 0,0:03:53.09,0:03:56.03,Default,,0000,0000,0000,,《Кесіртке балық мырза ше?
Dialogue: 0,0:03:53.09,0:03:56.03,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:03:53.09,0:03:56.03,Default,,0000,0000,0000,,Біз әрқашан біргеміз, солай ма? 》
Dialogue: 0,0:03:56.03,0:03:59.16,Default,,0000,0000,0000,,《Уау уау уау》
Dialogue: 0,0:03:56.03,0:03:59.16,Default,,0000,0000,0000,,《А...》
Dialogue: 0,0:03:59.16,0:04:02.07,Default,,0000,0000,0000,,《Уау! 》
Dialogue: 0,0:03:59.16,0:04:02.07,Default,,0000,0000,0000,,《Құбыжық кесіртке! 》
Dialogue: 0,0:04:02.07,0:04:06.04,Default,,0000,0000,0000,,《Мистер Лизард балық
Dialogue: 0,0:04:02.07,0:04:06.04,Default,,0000,0000,0000,,Лизард балық мырза қайда? 》
Dialogue: 0,0:04:06.04,0:04:08.17,Rubi,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:04:06.04,0:04:08.17,Default,,0000,0000,0000,,《Мен осындамын~》
Dialogue: 0,0:04:08.17,0:04:10.11,Default,,0000,0000,0000,,《Уау! 》
Dialogue: 0,0:04:10.11,0:04:11.68,Default,,0000,0000,0000,,《Әй, кесіртке балық мырза
Dialogue: 0,0:04:11.68,0:04:14.58,Default,,0000,0000,0000,,Неліктен Уолл Лизард мырзамен?
Dialogue: 0,0:04:11.68,0:04:14.58,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:04:11.68,0:04:14.58,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:11.68,0:04:14.58,Default,,0000,0000,0000,,Менімен бармайсың ба? 》
Dialogue: 0,0:04:14.58,0:04:17.55,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:14.58,0:04:17.55,Default,,0000,0000,0000,,《Бұл Ну~ Маруко - Ну~
Dialogue: 0,0:04:17.55,0:04:21.69,Rubi,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:04:17.55,0:04:21.69,Rubi,,0000,0000,0000,,Сенака
Dialogue: 0,0:04:17.55,0:04:21.69,Default,,0000,0000,0000,,Менің арқамда
Dialogue: 0,0:04:17.55,0:04:21.69,Rubi,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:04:17.55,0:04:21.69,Default,,0000,0000,0000,,Себебі мен оны мініп жүрмін.
Dialogue: 0,0:04:21.69,0:04:25.19,Default,,0000,0000,0000,,《Иә? Бұл менмін
Dialogue: 0,0:04:21.69,0:04:25.19,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:04:21.69,0:04:25.19,Default,,0000,0000,0000,,Мүмкін мен түсуім керек.》
Dialogue: 0,0:04:25.19,0:04:26.69,Default,,0000,0000,0000,,《NU～》
Dialogue: 0,0:04:28.09,0:04:29.06,Default,,0000,0000,0000,,《А... А? 》
Dialogue: 0,0:04:29.06,0:04:31.70,Default,,0000,0000,0000,,《Мен не істеуім керек?
Dialogue: 0,0:04:29.06,0:04:31.70,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:04:29.06,0:04:31.70,Default,,0000,0000,0000,,Бұлай төмен түсуге болмайды! 》
Dialogue: 0,0:04:31.70,0:04:34.60,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:04:31.70,0:04:34.60,Default,,0000,0000,0000,,《А, бірақ мен түсуім керек.
Dialogue: 0,0:04:31.70,0:04:34.60,Default,,0000,0000,0000,,Лизард балық мырза...》
Dialogue: 0,0:04:34.60,0:04:39.20,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:04:34.60,0:04:39.20,Default,,0000,0000,0000,,《А, бірақ мен төмен түскенде
Dialogue: 0,0:04:34.60,0:04:39.20,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:04:34.60,0:04:39.20,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:04:34.60,0:04:39.20,Default,,0000,0000,0000,,Мен суға батып бара жатырмын! Мен түсе алмаймын! 》
Dialogue: 0,0:04:39.20,0:04:44.70,Default,,0000,0000,0000,,《Ой, мен не істеуім керек?
Dialogue: 0,0:04:39.20,0:04:44.70,Default,,0000,0000,0000,,Уау Уау Уау! 》
Dialogue: 0,0:04:47.08,0:04:48.71,Default,,0000,0000,0000,,Жақсы! Хаха...
Dialogue: 0,0:04:48.71,0:04:52.58,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:04:48.71,0:04:52.58,Rubi,,0000,0000,0000,,Екі
Dialogue: 0,0:04:48.71,0:04:52.58,Default,,0000,0000,0000,,(қатты тыныс алу)
Dialogue: 0,0:04:52.58,0:04:55.15,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:04:52.58,0:04:55.15,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:04:52.58,0:04:55.15,Default,,0000,0000,0000,,＜Сол күні таңертең мен неге
Dialogue: 0,0:04:55.15,0:04:59.02,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:04:55.15,0:04:59.02,Default,,0000,0000,0000,,Әдеттегіден әлдеқайда ертерек
Dialogue: 0,0:04:55.15,0:04:59.02,Rubi,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:04:55.15,0:04:59.02,Rubi,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:04:55.15,0:04:59.02,Default,,0000,0000,0000,,Мен ояндым>
Dialogue: 0,0:04:59.02,0:05:01.52,Rubi,,0000,0000,0000,,Тауық
Dialogue: 0,0:04:59.02,0:05:01.52,Rubi,,0000,0000,0000,,Арман
Dialogue: 0,0:04:59.02,0:05:01.52,Default,,0000,0000,0000,,Хмм, бұл біртүрлі түс болды...
Dialogue: 0,0:05:03.66,0:05:05.60,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:05:03.66,0:05:05.60,Default,,0000,0000,0000,,(Тікұшақ роторының дыбысы)
Dialogue: 0,0:05:03.66,0:05:05.60,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:05.60,0:05:10.17,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:05:05.60,0:05:10.17,Default,,0000,0000,0000,,(Тікұшақ роторының дыбысы)
Dialogue: 0,0:05:10.17,0:05:13.17,Default,,0000,0000,0000,,Хмм? Бұл қайда?
Dialogue: 0,0:05:10.17,0:05:13.17,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:05:10.17,0:05:13.17,Default,,0000,0000,0000,,Мен оны көрмеймін...
Dialogue: 0,0:05:15.04,0:05:18.68,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:05:15.04,0:05:18.68,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:05:15.04,0:05:18.68,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:05:15.04,0:05:18.68,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:05:15.04,0:05:18.68,Default,,0000,0000,0000,,Дыбыс шықты, бірақ мен ештеңе көрмедім.
Dialogue: 0,0:05:18.68,0:05:21.18,Rubi,,0000,0000,0000,,Көресіңдер әлі
Dialogue: 0,0:05:18.68,0:05:21.18,Default,,0000,0000,0000,,Бұл шынында да осырық сияқты...
Dialogue: 0,0:05:23.55,0:05:26.55,Default,,0000,0000,0000,,Қайырлы таң. иә?
Dialogue: 0,0:05:26.55,0:05:29.05,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:26.55,0:05:29.05,Rubi,,0000,0000,0000,,Дайдокоро
Dialogue: 0,0:05:26.55,0:05:29.05,Default,,0000,0000,0000,,Иә? Анаң ас үйде ме?
Dialogue: 0,0:05:31.19,0:05:34.69,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:31.19,0:05:34.69,Default,,0000,0000,0000,,Қайырлы таң, анашым. Ах...
Dialogue: 0,0:05:37.06,0:05:38.56,Default,,0000,0000,0000,,Мұнда емес.
Dialogue: 0,0:05:40.20,0:05:41.70,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:40.20,0:05:41.70,Default,,0000,0000,0000,,Ана?
Dialogue: 0,0:05:43.10,0:05:45.07,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:43.10,0:05:45.07,Default,,0000,0000,0000,,Қайырлы таң анашым
Dialogue: 0,0:05:45.07,0:05:46.57,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:49.21,0:05:53.08,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:05:49.21,0:05:53.08,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:49.21,0:05:53.08,Default,,0000,0000,0000,,《Ой... Анам мен әкем.
Dialogue: 0,0:05:49.21,0:05:53.08,Default,,0000,0000,0000,,Олар төбелесіп жатқан сияқты...》
Dialogue: 0,0:05:53.08,0:05:55.58,Default,,0000,0000,0000,,《Бұл үлкен мәселе емес деп үміттенемін》
Dialogue: 0,0:05:56.65,0:05:58.15,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:56.65,0:05:58.15,Default,,0000,0000,0000,,Сәлем анашым
Dialogue: 0,0:05:58.15,0:06:01.05,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:05:58.15,0:06:01.05,Rubi,,0000,0000,0000,,Юушоку
Dialogue: 0,0:05:58.15,0:06:01.05,Default,,0000,0000,0000,,Бүгін кешкі асқа суши жасайық.
Dialogue: 0,0:05:58.15,0:06:01.05,Rubi,,0000,0000,0000,,Теріс
Dialogue: 0,0:05:58.15,0:06:01.05,Default,,0000,0000,0000,,Өтінемін, сәлем~
Dialogue: 0,0:06:01.05,0:06:04.02,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:06:01.05,0:06:04.02,Default,,0000,0000,0000,,<Осылайша балалар
Dialogue: 0,0:06:01.05,0:06:04.02,Rubi,,0000,0000,0000,,Мизука
Dialogue: 0,0:06:01.05,0:06:04.02,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:06:01.05,0:06:04.02,Default,,0000,0000,0000,,Өзіңіздің лакмус қағазыңыз болыңыз
Dialogue: 0,0:06:04.02,0:06:07.16,Rubi,,0000,0000,0000,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:06:04.02,0:06:07.16,Rubi,,0000,0000,0000,,Шинкоку
Dialogue: 0,0:06:04.02,0:06:07.16,Default,,0000,0000,0000,,Ата-анаңыздың ұрыс-керістерінің маңыздылығын анықтаңыз.
Dialogue: 0,0:06:04.02,0:06:07.16,Rubi,,0000,0000,0000,,Шира
Dialogue: 0,0:06:04.02,0:06:07.16,Default,,0000,0000,0000,,Менде бір нәрсе бар.＞
Dialogue: 0,0:06:07.16,0:06:08.66,Default,,0000,0000,0000,,Эй, эй, эй~
Dialogue: 0,0:06:08.66,0:06:10.60,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:06:08.66,0:06:10.60,Default,,0000,0000,0000,,Таңертеңнен бері шу болды.
Dialogue: 0,0:06:10.60,0:06:12.53,Default,,0000,0000,0000,,А...
Dialogue: 0,0:06:12.53,0:06:16.53,Rubi,,0000,0000,0000,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:06:12.53,0:06:16.53,Rubi,,0000,0000,0000,,Тайдо
Dialogue: 0,0:06:12.53,0:06:16.53,Default,,0000,0000,0000,,Сіздің ата-анаңыздан осындай көзқарас бар.
Dialogue: 0,0:06:12.53,0:06:16.53,Rubi,,0000,0000,0000,,Ұшақ
Dialogue: 0,0:06:12.53,0:06:16.53,Rubi,,0000,0000,0000,,Қорқынышты түс көрдің бе?
Dialogue: 0,0:06:12.53,0:06:16.53,Default,,0000,0000,0000,,Құқық бұзуға шақырады.
Dialogue: 0,0:06:17.67,0:06:20.17,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:06:17.67,0:06:20.17,Default,,0000,0000,0000,,Әкем
Dialogue: 0,0:06:17.67,0:06:20.17,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:06:17.67,0:06:20.17,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:06:17.67,0:06:20.17,Default,,0000,0000,0000,,Әкең кешкі ас ішпейді ме?
Dialogue: 0,0:06:20.17,0:06:22.17,Default,,0000,0000,0000,,Қажет емес
Dialogue: 0,0:06:20.17,0:06:22.17,Default,,0000,0000,0000,,А...
Dialogue: 0,0:06:31.18,0:06:32.18,Rubi,,0000,0000,0000,,Екі
Dialogue: 0,0:06:31.18,0:06:32.18,Default,,0000,0000,0000,,(Хироси күрсінуі)
Dialogue: 0,0:06:35.05,0:06:38.06,Default,,0000,0000,0000,,《Бұл солай
Dialogue: 0,0:06:35.05,0:06:38.06,Rubi,,0000,0000,0000,,Ханпа
Dialogue: 0,0:06:35.05,0:06:38.06,Default,,0000,0000,0000,,Бұл біртүрлі жекпе-жек емес》
Dialogue: 0,0:06:38.06,0:06:40.56,Default,,0000,0000,0000,,《Ол аздап кетті...》
Dialogue: 0,0:06:51.20,0:06:52.20,Default,,0000,0000,0000,,Тс!
Dialogue: 0,0:06:53.14,0:06:55.64,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:06:53.14,0:06:55.64,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:06:53.14,0:06:55.64,Default,,0000,0000,0000,,Әйтеуір, мен сенің әкеңмін
Dialogue: 0,0:06:55.64,0:06:58.54,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:06:55.64,0:06:58.54,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:06:55.64,0:06:58.54,Default,,0000,0000,0000,,Ақылсыз ойлау тәсілі
Dialogue: 0,0:06:55.64,0:06:58.54,Default,,0000,0000,0000,,Мен үлгере алмаймын.
Dialogue: 0,0:06:58.54,0:07:00.51,Rubi,,0000,0000,0000,,Рикон
Dialogue: 0,0:06:58.54,0:07:00.51,Default,,0000,0000,0000,,Содан кейін ажырасу.
Dialogue: 0,0:06:58.54,0:07:00.51,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:00.51,0:07:01.51,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:07:01.51,0:07:05.65,Default,,0000,0000,0000,,А... сен
Dialogue: 0,0:07:01.51,0:07:05.65,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:07:01.51,0:07:05.65,Rubi,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:07:01.51,0:07:05.65,Default,,0000,0000,0000,,Тек тынышталыңыз.
Dialogue: 0,0:07:05.65,0:07:08.15,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:07:05.65,0:07:08.15,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:07:05.65,0:07:08.15,Default,,0000,0000,0000,,Мен оның не екенін білмеймін, бірақ
Dialogue: 0,0:07:08.15,0:07:11.06,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:07:08.15,0:07:11.06,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:07:08.15,0:07:11.06,Default,,0000,0000,0000,,Әпке
Dialogue: 0,0:07:11.06,0:07:13.03,Rubi,,0000,0000,0000,,Өте
Dialogue: 0,0:07:11.06,0:07:13.03,Default,,0000,0000,0000,,Бұл қиын!
