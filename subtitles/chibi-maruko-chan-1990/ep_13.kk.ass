Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.32,0:01:14.82,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:10.71,0:03:12.72,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:10.71,0:03:12.72,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:03:12.72,0:03:15.35,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:12.72,0:03:15.35,Default,,0000,0000,0000,,Қайырлы таң анашым
Dialogue: 0,0:03:15.35,0:03:18.25,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:15.35,0:03:18.25,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:03:15.35,0:03:18.25,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:03:15.35,0:03:18.25,Default,,0000,0000,0000,,Қазірдің өзінде "қайырлы таң"
Dialogue: 0,0:03:18.25,0:03:20.86,Rubi,,0000,0000,0000,,Қалаймын
Dialogue: 0,0:03:18.25,0:03:20.86,Rubi,,0000,0000,0000,,Энсуку
Dialogue: 0,0:03:18.25,0:03:20.86,Default,,0000,0000,0000,,Экскурсияға тез дайындалыңыз.
Dialogue: 0,0:03:20.86,0:03:24.29,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:20.86,0:03:24.29,Rubi,,0000,0000,0000,,Энсуку
Dialogue: 0,0:03:20.86,0:03:24.29,Rubi,,0000,0000,0000,,Яманобо
Dialogue: 0,0:03:20.86,0:03:24.29,Default,,0000,0000,0000,,Экскурсия десең де, тауға шығу.
Dialogue: 0,0:03:24.29,0:03:28.80,Default,,0000,0000,0000,,Бұл азап.
Dialogue: 0,0:03:24.29,0:03:28.80,Rubi,,0000,0000,0000,,Жеңіл
Dialogue: 0,0:03:24.29,0:03:28.80,Rubi,,0000,0000,0000,,Жеңіл
Dialogue: 0,0:03:24.29,0:03:28.80,Default,,0000,0000,0000,,Мен демалғым келеді Демалғым келеді
Dialogue: 0,0:03:28.80,0:03:32.67,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:03:28.80,0:03:32.67,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:03:28.80,0:03:32.67,Default,,0000,0000,0000,,Тамағыңызды тез жеңіз.
Dialogue: 0,0:03:28.80,0:03:32.67,Rubi,,0000,0000,0000,,Бенто
Dialogue: 0,0:03:28.80,0:03:32.67,Rubi,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:03:28.80,0:03:32.67,Default,,0000,0000,0000,,Менің түскі ас қорабымның қалдықтары ғана.
Dialogue: 0,0:03:32.67,0:03:36.31,Default,,0000,0000,0000,,Ааа! Күріш шары!
Dialogue: 0,0:03:36.31,0:03:38.81,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:36.31,0:03:38.81,Default,,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:03:36.31,0:03:38.81,Default,,0000,0000,0000,,Неліктен күріш шарлары?
Dialogue: 0,0:03:38.81,0:03:40.31,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:38.81,0:03:40.31,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:03:40.31,0:03:42.81,Default,,0000,0000,0000,,Оны сэндвичке айналдырыңыз
Dialogue: 0,0:03:40.31,0:03:42.81,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:40.31,0:03:42.81,Default,,0000,0000,0000,,Мен айттым ғой!
Dialogue: 0,0:03:42.81,0:03:45.31,Default,,0000,0000,0000,,Идиот!
Dialogue: 0,0:03:46.68,0:03:48.69,Default,,0000,0000,0000,,Сэндвичтер жақсырақ
Dialogue: 0,0:03:46.68,0:03:48.69,Default,,0000,0000,0000,,Бұл керемет~
Dialogue: 0,0:03:48.69,0:03:49.69,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:48.69,0:03:49.69,Default,,0000,0000,0000,,Маруко
Dialogue: 0,0:03:49.69,0:03:52.82,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:49.69,0:03:52.82,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:03:49.69,0:03:52.82,Rubi,,0000,0000,0000,,Энсуку
Dialogue: 0,0:03:49.69,0:03:52.82,Default,,0000,0000,0000,,Менің енді экскурсияға барғым келмейді.
Dialogue: 0,0:03:49.69,0:03:52.82,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:49.69,0:03:52.82,Default,,0000,0000,0000,,Бұл сенің анаңның кінәсі.
Dialogue: 0,0:03:52.82,0:03:56.33,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:03:52.82,0:03:56.33,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:52.82,0:03:56.33,Default,,0000,0000,0000,,Оның орнына барыңыз.
Dialogue: 0,0:03:56.33,0:03:57.83,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:03:56.33,0:03:57.83,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:03:56.33,0:03:57.83,Default,,0000,0000,0000,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:03:57.83,0:03:59.76,Rubi,,0000,0000,0000,,Энсуку
Dialogue: 0,0:03:57.83,0:03:59.76,Rubi,,0000,0000,0000,,Кира
Dialogue: 0,0:03:57.83,0:03:59.76,Default,,0000,0000,0000,,Неліктен далалық саяхаттарды жек көресіз?
Dialogue: 0,0:03:59.76,0:04:02.33,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:03:59.76,0:04:02.33,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:03:59.76,0:04:02.33,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:03:59.76,0:04:02.33,Rubi,,0000,0000,0000,,Ойроко
Dialogue: 0,0:03:59.76,0:04:02.33,Default,,0000,0000,0000,,Мен үлкен қуанышпен шықтым.
Dialogue: 0,0:04:02.33,0:04:08.20,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:04:02.33,0:04:08.20,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:04:02.33,0:04:08.20,Rubi,,0000,0000,0000,,Теңіз
Dialogue: 0,0:04:02.33,0:04:08.20,Default,,0000,0000,0000,,Менің әпкемнің бағасы - Уми!
Dialogue: 0,0:04:02.33,0:04:08.20,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:02.33,0:04:08.20,Rubi,,0000,0000,0000,,Яма
Dialogue: 0,0:04:02.33,0:04:08.20,Default,,0000,0000,0000,,Маруко – тау
Dialogue: 0,0:04:08.20,0:04:12.70,Rubi,,0000,0000,0000,,Кел
Dialogue: 0,0:04:08.20,0:04:12.70,Rubi,,0000,0000,0000,,Яма
Dialogue: 0,0:04:08.20,0:04:12.70,Default,,0000,0000,0000,,Қиын да азапты тау.
Dialogue: 0,0:04:08.20,0:04:12.70,Default,,0000,0000,0000,,Маған ұнамайды.
Dialogue: 0,0:04:14.84,0:04:17.35,Default,,0000,0000,0000,,Хмм... Міне, солай.
Dialogue: 0,0:04:17.35,0:04:20.25,Rubi,,0000,0000,0000,,Яма
Dialogue: 0,0:04:17.35,0:04:20.25,Rubi,,0000,0000,0000,,Бенжо
Dialogue: 0,0:04:17.35,0:04:20.25,Default,,0000,0000,0000,,Тауда дәретхана жоқ.
Dialogue: 0,0:04:20.25,0:04:22.85,Default,,0000,0000,0000,,<Бұл Мару-чан
Dialogue: 0,0:04:20.25,0:04:22.85,Default,,0000,0000,0000,,Сыртқы өмір
Dialogue: 0,0:04:22.85,0:04:25.76,Default,,0000,0000,0000,,Ләззат алу мүмкін емес
Dialogue: 0,0:04:22.85,0:04:25.76,Rubi,,0000,0000,0000,,Риюу
Dialogue: 0,0:04:22.85,0:04:25.76,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:04:22.85,0:04:25.76,Default,,0000,0000,0000,,Себептердің бірі＞
Dialogue: 0,0:04:25.76,0:04:29.66,Default,,0000,0000,0000,,Зәр туралы не деуге болады?
Dialogue: 0,0:04:25.76,0:04:29.66,Rubi,,0000,0000,0000,,Шөп
Dialogue: 0,0:04:25.76,0:04:29.66,Default,,0000,0000,0000,,Шөпте болса, жарайды.
Dialogue: 0,0:04:29.66,0:04:32.66,Default,,0000,0000,0000,,《Ой, ұнамайды, ұнамайды.
Dialogue: 0,0:04:29.66,0:04:32.66,Rubi,,0000,0000,0000,,Әйел
Dialogue: 0,0:04:29.66,0:04:32.66,Default,,0000,0000,0000,,Аяқ ұшы ғана бар әйел
Dialogue: 0,0:04:32.66,0:04:36.30,Rubi,,0000,0000,0000,,болып табылады
Dialogue: 0,0:04:32.66,0:04:36.30,Default,,0000,0000,0000,,Бұл ұят
Dialogue: 0,0:04:32.66,0:04:36.30,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:04:32.66,0:04:36.30,Default,,0000,0000,0000,,Себебі мен білмеймін.
Dialogue: 0,0:04:36.30,0:04:38.80,Default,,0000,0000,0000,,Келіңдер, келіңдер.
Dialogue: 0,0:04:43.31,0:04:45.81,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:04:43.31,0:04:45.81,Default,,0000,0000,0000,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,0:04:43.31,0:04:45.81,Rubi,,0000,0000,0000,,Емен
Dialogue: 0,0:04:43.31,0:04:45.81,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:43.31,0:04:45.81,Default,,0000,0000,0000,,Қандай тәттілер сатып алдың?
Dialogue: 0,0:04:45.81,0:04:48.31,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:04:45.81,0:04:48.31,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:04:45.81,0:04:48.31,Rubi,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:04:45.81,0:04:48.31,Rubi,,0000,0000,0000,,Мугича
Dialogue: 0,0:04:45.81,0:04:48.31,Default,,0000,0000,0000,,Мен, су құтысындағы арпа шайы.
Dialogue: 0,0:04:49.31,0:04:50.81,Default,,0000,0000,0000,,Мен, Кальпис
Dialogue: 0,0:04:51.81,0:04:55.69,Rubi,,0000,0000,0000,,Кочо
Dialogue: 0,0:04:51.81,0:04:55.69,Rubi,,0000,0000,0000,,Медбике
Dialogue: 0,0:04:51.81,0:04:55.69,Rubi,,0000,0000,0000,,Мина
Dialogue: 0,0:04:51.81,0:04:55.69,Default,,0000,0000,0000,,Үшінші курс студенттері
Dialogue: 0,0:04:51.81,0:04:55.69,Rubi,,0000,0000,0000,,Шизу
Dialogue: 0,0:04:51.81,0:04:55.69,Default,,0000,0000,0000,,Иә, иә, тыныш бол.
Dialogue: 0,0:04:55.69,0:05:01.32,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:04:55.69,0:05:01.32,Rubi,,0000,0000,0000,,Медбике
Dialogue: 0,0:04:55.69,0:05:01.32,Rubi,,0000,0000,0000,,Мина
Dialogue: 0,0:04:55.69,0:05:01.32,Rubi,,0000,0000,0000,,Хонджитсу
Dialogue: 0,0:04:55.69,0:05:01.32,Default,,0000,0000,0000,,Бүгін мен де үшінші курс студенттерімен біргемін.
Dialogue: 0,0:04:55.69,0:05:01.32,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:04:55.69,0:05:01.32,Rubi,,0000,0000,0000,,Яманобо
Dialogue: 0,0:04:55.69,0:05:01.32,Default,,0000,0000,0000,,Ендеше бірге тауға шығамыз
Dialogue: 0,0:05:01.32,0:05:05.19,Rubi,,0000,0000,0000,,Хонджитсу
Dialogue: 0,0:05:01.32,0:05:05.19,Default,,0000,0000,0000,,Хохо, бірақ бүгін
Dialogue: 0,0:05:01.32,0:05:05.19,Rubi,,0000,0000,0000,,болып табылады
Dialogue: 0,0:05:01.32,0:05:05.19,Default,,0000,0000,0000,,Күннің ашық болғанына қуаныштымын.
Dialogue: 0,0:05:05.19,0:05:08.83,Rubi,,0000,0000,0000,,болып табылады
Dialogue: 0,0:05:05.19,0:05:08.83,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:05:05.19,0:05:08.83,Default,,0000,0000,0000,,《Күн ашық болса да
Dialogue: 0,0:05:05.19,0:05:08.83,Rubi,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:05:05.19,0:05:08.83,Rubi,,0000,0000,0000,,Кочо
Dialogue: 0,0:05:05.19,0:05:08.83,Default,,0000,0000,0000,,Директор келе жатыр...》
Dialogue: 0,0:05:08.83,0:05:13.70,Rubi,,0000,0000,0000,,Яма
Dialogue: 0,0:05:08.83,0:05:13.70,Default,,0000,0000,0000,,...Тауда еркелік ойнағанда, сондықтан
Dialogue: 0,0:05:08.83,0:05:13.70,Rubi,,0000,0000,0000,,Яма
Dialogue: 0,0:05:08.83,0:05:13.70,Rubi,,0000,0000,0000,,Құдай
Dialogue: 0,0:05:08.83,0:05:13.70,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:05:08.83,0:05:13.70,Rubi,,0000,0000,0000,,♬ Құдайлардың мұнда алданған бейнелері
Dialogue: 0,0:05:08.83,0:05:13.70,Default,,0000,0000,0000,,Тау құдайы: «Ауырып тұр!» деп айғайлайды.
Dialogue: 0,0:05:13.70,0:05:18.34,Default,,0000,0000,0000,,Бұдан кейін не болды...
Dialogue: 0,0:05:13.70,0:05:18.34,Rubi,,0000,0000,0000,,Кочо
Dialogue: 0,0:05:13.70,0:05:18.34,Rubi,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:05:13.70,0:05:18.34,Rubi,,0000,0000,0000,,Енен
Dialogue: 0,0:05:13.70,0:05:18.34,Rubi,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:05:13.70,0:05:18.34,Default,,0000,0000,0000,,<Директордың әңгімесі әрі қарай жалғасады.>
Dialogue: 0,0:05:18.34,0:05:21.24,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:18.34,0:05:21.24,Rubi,,0000,0000,0000,,Кочо
Dialogue: 0,0:05:18.34,0:05:21.24,Default,,0000,0000,0000,,Бұзықтық жасаған бала
Dialogue: 0,0:05:18.34,0:05:21.24,Rubi,,0000,0000,0000,,Құдай
Dialogue: 0,0:05:18.34,0:05:21.24,Default,,0000,0000,0000,,Құдай сені ұрлап әкетеді
Dialogue: 0,0:05:21.24,0:05:24.15,Rubi,,0000,0000,0000,,Аю
Dialogue: 0,0:05:21.24,0:05:24.15,Default,,0000,0000,0000,,Сондай-ақ, аюлар үшін т.б.
Dialogue: 0,0:05:21.24,0:05:24.15,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:05:21.24,0:05:24.15,Default,,0000,0000,0000,,Мен Баттеримен кездескен кезде...
Dialogue: 0,0:05:24.15,0:05:28.15,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:24.15,0:05:28.15,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:05:24.15,0:05:28.15,Rubi,,0000,0000,0000,,Сеито
Dialogue: 0,0:05:24.15,0:05:28.15,Rubi,,0000,0000,0000,,Энсуку
Dialogue: 0,0:05:24.15,0:05:28.15,Default,,0000,0000,0000,,＜Оқушылар саяхатқа шықпас бұрын дайындалуы керек.
Dialogue: 0,0:05:24.15,0:05:28.15,Rubi,,0000,0000,0000,,Хиро
Dialogue: 0,0:05:24.15,0:05:28.15,Default,,0000,0000,0000,,Мен өзімді әбден шаршадым>
Dialogue: 0,0:05:29.29,0:05:34.79,Rubi,,0000,0000,0000,,Сеито
Dialogue: 0,0:05:29.29,0:05:34.79,Rubi,,0000,0000,0000,,Дыбыс
