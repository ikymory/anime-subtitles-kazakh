Dialogue: 0,0:09:49.40,0:09:50.97,Default,,0000,0000,0000,,Маруко
Dialogue: 0,0:09:50.97,0:09:53.47,Default,,0000,0000,0000,,Аа, мен өте қуаныштымын.
Dialogue: 0,0:09:50.97,0:09:53.47,Default,,0000,0000,0000,,Мен қуаныштымын
Dialogue: 0,0:09:53.47,0:09:56.37,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:09:53.47,0:09:56.37,Default,,0000,0000,0000,,Оның орнына, қатты
Dialogue: 0,0:09:53.47,0:09:56.37,Rubi,,0000,0000,0000,,Ақаулық
Dialogue: 0,0:09:53.47,0:09:56.37,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:09:53.47,0:09:56.37,Default,,0000,0000,0000,,Маған қамқор бол, жарай ма?
