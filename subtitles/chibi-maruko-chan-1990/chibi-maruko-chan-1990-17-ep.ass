Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.97,0:01:15.47,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:10.43,0:03:13.43,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:10.43,0:03:13.43,Default,,0000,0000,0000,,Ха, сүйкімді
Dialogue: 0,0:03:15.40,0:03:19.54,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:15.40,0:03:19.54,Default,,0000,0000,0000,,Ха, Маруко да.
Dialogue: 0,0:03:15.40,0:03:19.54,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:03:15.40,0:03:19.54,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:03:15.40,0:03:19.54,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:03:15.40,0:03:19.54,Default,,0000,0000,0000,,Маған қол мінген торғай керек.
Dialogue: 0,0:03:19.54,0:03:22.45,Default,,0000,0000,0000,,<Мару-чан бұл
Dialogue: 0,0:03:19.54,0:03:22.45,Rubi,,0000,0000,0000,,Шизуока
Dialogue: 0,0:03:19.54,0:03:22.45,Default,,0000,0000,0000,,Сидзуокадағы әжемнің үйінде
Dialogue: 0,0:03:22.45,0:03:24.38,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:03:22.45,0:03:24.38,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:03:22.45,0:03:24.38,Rubi,,0000,0000,0000,,Тітіркену
Dialogue: 0,0:03:22.45,0:03:24.38,Default,,0000,0000,0000,,Торғайдың балапанын көргеннен бері
Dialogue: 0,0:03:24.38,0:03:26.88,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:03:24.38,0:03:26.88,Default,,0000,0000,0000,,Торғайлардың тұтқыны
Dialogue: 0,0:03:24.38,0:03:26.88,Default,,0000,0000,0000,,Бұл> айналды
Dialogue: 0,0:03:27.98,0:03:31.85,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:03:27.98,0:03:31.85,Default,,0000,0000,0000,,Торғай, сен туралы
Dialogue: 0,0:03:27.98,0:03:31.85,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:03:27.98,0:03:31.85,Default,,0000,0000,0000,,Ұмытылмас
Dialogue: 0,0:03:31.85,0:03:33.86,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:03:31.85,0:03:33.86,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:03:31.85,0:03:33.86,Default,,0000,0000,0000,,Ей, торғай ұстайық.
Dialogue: 0,0:03:33.86,0:03:36.49,Default,,0000,0000,0000,,Ах, шыдай алмаймын—аузым суы ағып тұр, ззззз
Dialogue: 0,0:03:33.86,0:03:36.49,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:03:33.86,0:03:36.49,Default,,0000,0000,0000,,Жарайды, сатып ал.
Dialogue: 0,0:03:36.49,0:03:39.40,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:03:36.49,0:03:39.40,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:03:39.40,0:03:43.37,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:03:39.40,0:03:43.37,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:39.40,0:03:43.37,Default,,0000,0000,0000,,Әкесі де, анасы да
Dialogue: 0,0:03:39.40,0:03:43.37,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:39.40,0:03:43.37,Rubi,,0000,0000,0000,,Сева
Dialogue: 0,0:03:39.40,0:03:43.37,Rubi,,0000,0000,0000,,Фалко!!
Dialogue: 0,0:03:39.40,0:03:43.37,Default,,0000,0000,0000,,Менің қолдарым Марукоға қамқорлық жасауда.
Dialogue: 0,0:03:43.37,0:03:45.50,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:03:43.37,0:03:45.50,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:43.37,0:03:45.50,Default,,0000,0000,0000,,Неге олай дейсің?
Dialogue: 0,0:03:45.50,0:03:48.40,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:45.50,0:03:48.40,Rubi,,0000,0000,0000,,Жоғарғы
Dialogue: 0,0:03:45.50,0:03:48.40,Default,,0000,0000,0000,,Маруко көбірек мазасызданады
Dialogue: 0,0:03:45.50,0:03:48.40,Default,,0000,0000,0000,,Мен мұны істеймін!
Dialogue: 0,0:03:48.40,0:03:50.37,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:03:48.40,0:03:50.37,Rubi,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:03:48.40,0:03:50.37,Rubi,,0000,0000,0000,,Оаба
Dialogue: 0,0:03:48.40,0:03:50.37,Default,,0000,0000,0000,,Үйдегі шабуыл
Dialogue: 0,0:03:50.37,0:03:53.38,Rubi,,0000,0000,0000,,Фурё
Dialogue: 0,0:03:50.37,0:03:53.38,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:03:50.37,0:03:53.38,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:03:50.37,0:03:53.38,Default,,0000,0000,0000,,Құқық бұзушы болып, жаман адамдармен бірге бол
Dialogue: 0,0:03:50.37,0:03:53.38,Default,,0000,0000,0000,,Біз араласамыз!
Dialogue: 0,0:03:53.38,0:03:55.01,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:53.38,0:03:55.01,Default,,0000,0000,0000,,Осындай кездерде Марукомен
Dialogue: 0,0:03:55.01,0:03:57.51,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:03:55.01,0:03:57.51,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:55.01,0:03:57.51,Default,,0000,0000,0000,,Маруко қазіргідей
Dialogue: 0,0:03:55.01,0:03:57.51,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:03:55.01,0:03:57.51,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:03:55.01,0:03:57.51,Default,,0000,0000,0000,,Мен торғай сатып аламын.
Dialogue: 0,0:03:57.51,0:04:00.02,Rubi,,0000,0000,0000,,Сева
Dialogue: 0,0:03:57.51,0:04:00.02,Rubi,,0000,0000,0000,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:03:57.51,0:04:00.02,Default,,0000,0000,0000,,Саған кім қамқор болады?
Dialogue: 0,0:03:57.51,0:04:00.02,Rubi,,0000,0000,0000,,Өте
Dialogue: 0,0:03:57.51,0:04:00.02,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:03:57.51,0:04:00.02,Default,,0000,0000,0000,,Менің ойымша, бұл қиын.
Dialogue: 0,0:04:00.02,0:04:02.52,Default,,0000,0000,0000,,Бұл күлкілі.
Dialogue: 0,0:04:00.02,0:04:02.52,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:04:00.02,0:04:02.52,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:04:00.02,0:04:02.52,Default,,0000,0000,0000,,Сіздің ұқсастығыңыз
Dialogue: 0,0:04:02.52,0:04:05.42,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:04:02.52,0:04:05.42,Rubi,,0000,0000,0000,,Кота
Dialogue: 0,0:04:02.52,0:04:05.42,Default,,0000,0000,0000,,Қалай жауап бере алмайсың?
Dialogue: 0,0:04:02.52,0:04:05.42,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:04:02.52,0:04:05.42,Default,,0000,0000,0000,,Haunt!
Dialogue: 0,0:04:05.42,0:04:06.39,Default,,0000,0000,0000,,Босап шыққан адам –…
Dialogue: 0,0:04:06.39,0:04:08.39,Default,,0000,0000,0000,,Оны ұмытып қалдың ба?
Dialogue: 0,0:04:06.39,0:04:08.39,Default,,0000,0000,0000,,Сіз кездейсоқсыз ба?
Dialogue: 0,0:04:08.39,0:04:11.03,Default,,0000,0000,0000,,«Сакура, Зуру, Хироси»
Dialogue: 0,0:04:08.39,0:04:11.03,Default,,0000,0000,0000,,емес пе?
Dialogue: 0,0:04:11.03,0:04:13.53,Default,,0000,0000,0000,,《Жағымсыз әкесінің аты
Dialogue: 0,0:04:11.03,0:04:13.53,Rubi,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:04:11.03,0:04:13.53,Default,,0000,0000,0000,,Уақыты келгенде》
Dialogue: 0,0:04:13.53,0:04:18.03,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:04:13.53,0:04:18.03,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:04:13.53,0:04:18.03,Rubi,,0000,0000,0000,,Сейкацу
Dialogue: 0,0:04:13.53,0:04:18.03,Default,,0000,0000,0000,,Ана: Торғайлардың өмірі қандай?
Dialogue: 0,0:04:13.53,0:04:18.03,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:04:13.53,0:04:18.03,Default,,0000,0000,0000,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:04:18.03,0:04:20.54,Default,,0000,0000,0000,,Сіз қашаннан берісіз?
Dialogue: 0,0:04:18.03,0:04:20.54,Rubi,,0000,0000,0000,,Гёша
Dialogue: 0,0:04:18.03,0:04:20.54,Default,,0000,0000,0000,,Мен бизнесмен болдым.
Dialogue: 0,0:04:20.54,0:04:24.97,Default,,0000,0000,0000,,Бұл сүйкімді~ Чончон
Dialogue: 0,0:04:20.54,0:04:24.97,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:04:20.54,0:04:24.97,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:04:20.54,0:04:24.97,Default,,0000,0000,0000,,Ол кейде иығында тоқтайды.
Dialogue: 0,0:04:24.97,0:04:27.48,Rubi,,0000,0000,0000,,Сева
Dialogue: 0,0:04:24.97,0:04:27.48,Default,,0000,0000,0000,,Бірақ мен саған қамқор болуым керек.
Dialogue: 0,0:04:24.97,0:04:27.48,Default,,0000,0000,0000,,Ондай нәрсе жоқ.
Dialogue: 0,0:04:27.48,0:04:31.35,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:27.48,0:04:31.35,Rubi,,0000,0000,0000,,Мака
Dialogue: 0,0:04:27.48,0:04:31.35,Default,,0000,0000,0000,,Мұны Марукоға қалдырыңыз.
Dialogue: 0,0:04:27.48,0:04:31.35,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:04:27.48,0:04:31.35,Default,,0000,0000,0000,,Сіз оған сене алмайсыз.
Dialogue: 0,0:04:31.35,0:04:35.35,Rubi,,0000,0000,0000,,Kotori
Dialogue: 0,0:04:31.35,0:04:35.35,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:04:31.35,0:04:35.35,Default,,0000,0000,0000,,Ұсақ құстарға бір күн болса да қорек қажет.
Dialogue: 0,0:04:31.35,0:04:35.35,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:04:31.35,0:04:35.35,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:04:31.35,0:04:35.35,Default,,0000,0000,0000,,Егер сіз мұны ұмытып қалсаңыз, сіз өлесіз.
Dialogue: 0,0:04:35.35,0:04:39.49,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:04:35.35,0:04:39.49,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:04:35.35,0:04:39.49,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:35.35,0:04:39.49,Default,,0000,0000,0000,,Үйге тапсырма Ұмытсаң да өмір сүре аласың
Dialogue: 0,0:04:35.35,0:04:39.49,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:35.35,0:04:39.49,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:04:35.35,0:04:39.49,Default,,0000,0000,0000,,Бұл Марукодан өзгеше.
Dialogue: 0,0:04:39.49,0:04:42.39,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:04:39.49,0:04:42.39,Default,,0000,0000,0000,,《Бұл сәл басқаша...》
Dialogue: 0,0:04:42.39,0:04:44.36,Default,,0000,0000,0000,,Сіз сияқты
Dialogue: 0,0:04:42.39,0:04:44.36,Rubi,,0000,0000,0000,,Күн сайын
Dialogue: 0,0:04:42.39,0:04:44.36,Rubi,,0000,0000,0000,,Шинрай
Dialogue: 0,0:04:42.39,0:04:44.36,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:42.39,0:04:44.36,Default,,0000,0000,0000,,Күнделікті сенімсіз бала
Dialogue: 0,0:04:44.36,0:04:46.00,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:44.36,0:04:46.00,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:04:44.36,0:04:46.00,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:44.36,0:04:46.00,Default,,0000,0000,0000,,Ешбір тірі затты сақтай алмайсың.
Dialogue: 0,0:04:46.00,0:04:49.50,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:04:46.00,0:04:49.50,Rubi,,0000,0000,0000,,Kotori
Dialogue: 0,0:04:46.00,0:04:49.50,Default,,0000,0000,0000,,Онда маған кішкентай құс керек емес.
Dialogue: 0,0:04:49.50,0:04:51.43,Rubi,,0000,0000,0000,,En
Dialogue: 0,0:04:49.50,0:04:51.43,Default,,0000,0000,0000,,1500 иен беріңізші
Dialogue: 0,0:04:51.43,0:04:53.37,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:04:51.43,0:04:53.37,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:04:51.43,0:04:53.37,Default,,0000,0000,0000,,Бұл көп екен, иә?
Dialogue: 0,0:04:53.37,0:04:55.00,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:04:53.37,0:04:55.00,Default,,0000,0000,0000,,Торғай...
Dialogue: 0,0:04:55.00,0:04:56.51,Default,,0000,0000,0000,,Хмм
Dialogue: 0,0:04:56.51,0:05:00.01,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:04:56.51,0:05:00.01,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:56.51,0:05:00.01,Rubi,,0000,0000,0000,,Конган
Dialogue: 0,0:04:56.51,0:05:00.01,Default,,0000,0000,0000,,<Үмітсіз өтініш
Dialogue: 0,0:04:56.51,0:05:00.01,Rubi,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:04:56.51,0:05:00.01,Rubi,,0000,0000,0000,,Суку
Dialogue: 0,0:04:56.51,0:05:00.01,Default,,0000,0000,0000,,Осы нүктеге жеткенде, оны сақтаудың жолы жоқ>
Dialogue: 0,0:05:01.01,0:05:02.95,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:05:01.01,0:05:02.95,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:05:01.01,0:05:02.95,Rubi,,0000,0000,0000,,Шокин
Dialogue: 0,0:05:01.01,0:05:02.95,Default,,0000,0000,0000,,Сізде қанша жинақ бар?
Dialogue: 0,0:05:02.95,0:05:06.88,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:05:02.95,0:05:06.88,Rubi,,0000,0000,0000,,Танин
Dialogue: 0,0:05:02.95,0:05:06.88,Rubi,,0000,0000,0000,,Құпия
Dialogue: 0,0:05:02.95,0:05:06.88,Default,,0000,0000,0000,,Бұл басқалардан жасыратын нәрсе.
Dialogue: 0,0:05:06.88,0:05:08.52,Rubi,,0000,0000,0000,,Әне
Dialogue: 0,0:05:06.88,0:05:08.52,Rubi,,0000,0000,0000,,Ересек
Dialogue: 0,0:05:06.88,0:05:08.52,Default,,0000,0000,0000,,<Менің әпкем ересек адам>
Dialogue: 0,0:05:08.52,0:05:10.45,Rubi,,0000,0000,0000,,Танин
Dialogue: 0,0:05:08.52,0:05:10.45,Default,,0000,0000,0000,,Мен бейтаныс болғанды ұнатпаймын.
Dialogue: 0,0:05:10.45,0:05:13.39,Default,,0000,0000,0000,,Басқасы жоқ
Dialogue: 0,0:05:10.45,0:05:13.39,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:10.45,0:05:13.39,Rubi,,0000,0000,0000,,Оши
Dialogue: 0,0:05:10.45,0:05:13.39,Default,,0000,0000,0000,,Бұл Маруко, айтпа.
Dialogue: 0,0:05:13.39,0:05:16.03,Default,,0000,0000,0000,,Маған ұнамайды, себебі бұл сенсің.
Dialogue: 0,0:05:16.03,0:05:18.53,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:05:16.03,0:05:18.53,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:05:16.03,0:05:18.53,Default,,0000,0000,0000,,Әй, мен торғай ұстағым келеді.
Dialogue: 0,0:05:16.03,0:05:18.53,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:05:16.03,0:05:18.53,Default,,0000,0000,0000,,Сіз олай ойламайсыз ба?
Dialogue: 0,0:05:18.53,0:05:21.43,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:05:18.53,0:05:21.43,Default,,0000,0000,0000,,Торғай? Хмм...
Dialogue: 0,0:05:21.43,0:05:23.03,Default,,0000,0000,0000,,Бұл сүйкімді болуы мүмкін
Dialogue: 0,0:05:23.03,0:05:25.94,Default,,0000,0000,0000,,Әй
Dialogue: 0,0:05:23.03,0:05:25.94,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:05:23.03,0:05:25.94,Default,,0000,0000,0000,,Олай болса, сатып алайық.
Dialogue: 0,0:05:25.94,0:05:28.47,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:25.94,0:05:28.47,Rubi,,0000,0000,0000,,Зенцай-сан
Dialogue: 0,0:05:25.94,0:05:28.47,Rubi,,0000,0000,0000,,En
Dialogue: 0,0:05:25.94,0:05:28.47,Default,,0000,0000,0000,,Маруконың бүкіл мүлкі 300 иен және
Dialogue: 0,0:05:28.47,0:05:32.34,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:05:28.47,0:05:32.34,Rubi,,0000,0000,0000,,Шокин
Dialogue: 0,0:05:28.47,0:05:32.34,Default,,0000,0000,0000,,Әпкеңнің жинаған ақшасынан
Dialogue: 0,0:05:28.47,0:05:32.34,Rubi,,0000,0000,0000,,En
Dialogue: 0,0:05:28.47,0:05:32.34,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:05:28.47,0:05:32.34,Default,,0000,0000,0000,,1500 иен бірге.
Dialogue: 0,0:05:32.34,0:05:35.84,Rubi,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:05:32.34,0:05:35.84,Rubi,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:05:32.34,0:05:35.84,Rubi,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:05:32.34,0:05:35.84,Default,,0000,0000,0000,,<Бұл, әрине, мен мінгім келмейтін нәрсе.
Dialogue: 0,0:05:32.34,0:05:35.84,Rubi,,0000,0000,0000,,Әне
Dialogue: 0,0:05:32.34,0:05:35.84,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:05:32.34,0:05:35.84,Default,,0000,0000,0000,,Менің әпкем ойлады＞
Dialogue: 0,0:05:37.98,0:05:41.85,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:05:37.98,0:05:41.85,Rubi,,0000,0000,0000,,Kotori
Dialogue: 0,0:05:37.98,0:05:41.85,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:05:37.98,0:05:41.85,Default,,0000,0000,0000,,Хаа... Бүгін мен тағы да кішкентай құстар туралы айтамын.
Dialogue: 0,0:05:37.98,0:05:41.85,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:05:37.98,0:05:41.85,Rubi,,0000,0000,0000,,Шинтен
Dialogue: 0,0:05:37.98,0:05:41.85,Default,,0000,0000,0000,,Ешқандай прогресс жоқ
Dialogue: 0,0:05:41.85,0:05:45.49,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:05:41.85,0:05:45.49,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:05:41.85,0:05:45.49,Default,,0000,0000,0000,,Күн аяқталды
Dialogue: 0,0:05:41.85,0:05:45.49,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:05:45.49,0:05:49.36,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:05:45.49,0:05:49.36,Rubi,,0000,0000,0000,,Kotori
Dialogue: 0,0:05:45.49,0:05:49.36,Default,,0000,0000,0000,,Әйтеуір кішкентай құстардың ғажайыптары
Dialogue: 0,0:05:45.49,0:05:49.36,Rubi,,0000,0000,0000,,Отбасы
Dialogue: 0,0:05:45.49,0:05:49.36,Rubi,,0000,0000,0000,,Юта
Dialogue: 0,0:05:45.49,0:05:49.36,Default,,0000,0000,0000,,Мен отбасыма арыздануым керек...
Dialogue: 0,0:05:49.36,0:05:53.00,Rubi,,0000,0000,0000,,Kotori
Dialogue: 0,0:05:49.36,0:05:53.00,Default,,0000,0000,0000,,Иә! Кішкентай құстардың ғажайыптары
Dialogue: 0,0:05:49.36,0:05:53.00,Rubi,,0000,0000,0000,,Сакубун
Dialogue: 0,0:05:49.36,0:05:53.00,Default,,0000,0000,0000,,Эссе жаз
Dialogue: 0,0:05:53.00,0:05:56.00,Rubi,,0000,0000,0000,,Сүт безі
Dialogue: 0,0:05:53.00,0:05:56.00,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:05:53.00,0:05:56.00,Default,,0000,0000,0000,,Бұл жүректі сыздатады.
Dialogue: 0,0:05:57.50,0:06:01.00,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:57.50,0:06:01.00,Default,,0000,0000,0000,,《Хо~ Маруко осындай
Dialogue: 0,0:05:57.50,0:06:01.00,Rubi,,0000,0000,0000,,Kotori
Dialogue: 0,0:05:57.50,0:06:01.00,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:05:57.50,0:06:01.00,Default,,0000,0000,0000,,Сізге кішкентай құс керек.
Dialogue: 0,0:06:01.00,0:06:04.51,Default,,0000,0000,0000,,《Сүйкімді заттар
Dialogue: 0,0:06:01.00,0:06:04.51,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:06:01.00,0:06:04.51,Default,,0000,0000,0000,,Мен жазып алдым. Ухуху》
Dialogue: 0,0:06:04.51,0:06:08.51,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:06:04.51,0:06:08.51,Rubi,,0000,0000,0000,,Жүрек
Dialogue: 0,0:06:04.51,0:06:08.51,Default,,0000,0000,0000,,Әр адамда осындай бала жүрегі бар
Dialogue: 0,0:06:04.51,0:06:08.51,Default,,0000,0000,0000,,Түсінетіндеріңізге сенімдімін.
Dialogue: 0,0:06:10.01,0:06:13.01,Default,,0000,0000,0000,,А, орындалды.
Dialogue: 0,0:06:10.01,0:06:13.01,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:06:10.01,0:06:13.01,Default,,0000,0000,0000,,Жақсы жазылған
Dialogue: 0,0:06:15.89,0:06:17.89,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:06:15.89,0:06:17.89,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:06:17.89,0:06:21.52,Default,,0000,0000,0000,,《Коториде шашырау бар
Dialogue: 0,0:06:17.89,0:06:21.52,Default,,0000,0000,0000,,Оның тұмсығы бар. Күшті.
Dialogue: 0,0:06:21.52,0:06:24.02,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:06:21.52,0:06:24.02,Default,,0000,0000,0000,,Адамдарда мұндай нәрсе жоқ.
Dialogue: 0,0:06:21.52,0:06:24.02,Default,,0000,0000,0000,,Мен қызғанамын》
Dialogue: 0,0:06:25.39,0:06:26.96,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:06:25.39,0:06:26.96,Default,,0000,0000,0000,,Сәлем Маруко
Dialogue: 0,0:06:26.96,0:06:28.90,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:06:26.96,0:06:28.90,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:26.96,0:06:28.90,Rubi,,0000,0000,0000,,«және күн сайын күрсінемін.»
Dialogue: 0,0:06:26.96,0:06:28.90,Default,,0000,0000,0000,,Әке, сізге бірдеңе керек пе?
Dialogue: 0,0:06:28.90,0:06:32.84,Rubi,,0000,0000,0000,,Сакубун
Dialogue: 0,0:06:28.90,0:06:32.84,Default,,0000,0000,0000,,《Менің шығармама Шимешиме
Dialogue: 0,0:06:28.90,0:06:32.84,Rubi,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:06:28.90,0:06:32.84,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:06:28.90,0:06:32.84,Default,,0000,0000,0000,,Бұл менің жүрегіме әсер етті~》
Dialogue: 0,0:06:32.84,0:06:35.47,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:06:32.84,0:06:35.47,Rubi,,0000,0000,0000,,Тори
Dialogue: 0,0:06:32.84,0:06:35.47,Default,,0000,0000,0000,,Құс болғың келетін сияқты.
Dialogue: 0,0:06:35.47,0:06:37.41,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:06:35.47,0:06:37.41,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:06:35.47,0:06:37.41,Default,,0000,0000,0000,,Адам болып туылғандар
Dialogue: 0,0:06:35.47,0:06:37.41,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:06:37.41,0:06:39.98,Rubi,,0000,0000,0000,,Акира
Dialogue: 0,0:06:37.41,0:06:39.98,Default,,0000,0000,0000,,Беріңіз!
Dialogue: 0,0:06:37.41,0:06:39.98,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:06:39.98,0:06:41.91,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:06:39.98,0:06:41.91,Default,,0000,0000,0000,,Бұл үй тапсырмасы, солай ма?
Dialogue: 0,0:06:41.91,0:06:44.48,Default,,0000,0000,0000,,Қараңдар, берік болыңдар.
Dialogue: 0,0:06:41.91,0:06:44.48,Rubi,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:06:41.91,0:06:44.48,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:06:41.91,0:06:44.48,Default,,0000,0000,0000,,Оны сөмкеңізге салыңыз.
Dialogue: 0,0:06:44.48,0:06:46.98,Default,,0000,0000,0000,,А, бұл... иә, дұрыс.
Dialogue: 0,0:06:46.98,0:06:49.49,Rubi,,0000,0000,0000,,Сакубун
Dialogue: 0,0:06:46.98,0:06:49.49,Default,,0000,0000,0000,,Солай болса да, эссе
Dialogue: 0,0:06:46.98,0:06:49.49,Default,,0000,0000,0000,,Өйткені өте ыстық
Dialogue: 0,0:06:49.49,0:06:52.39,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:06:49.49,0:06:52.39,Rubi,,0000,0000,0000,,Ескертпе
Dialogue: 0,0:06:49.49,0:06:52.39,Default,,0000,0000,0000,,Қайтадан жазған дұрыс
Dialogue: 0,0:06:49.49,0:06:52.39,Default,,0000,0000,0000,,Жақсы, ахаха~
Dialogue: 0,0:06:52.39,0:06:56.89,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:06:52.39,0:06:56.89,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:06:52.39,0:06:56.89,Default,,0000,0000,0000,,《Түннің бір уағына дейін жаздым.
Dialogue: 0,0:06:52.39,0:06:56.89,Rubi,,0000,0000,0000,,Сакубун
Dialogue: 0,0:06:52.39,0:06:56.89,Default,,0000,0000,0000,,Бұл эссе не туралы...》
Dialogue: 0,0:06:58.49,0:07:01.40,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:06:58.49,0:07:01.40,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:06:58.49,0:07:01.40,Default,,0000,0000,0000,,Маруко Торғайлар туралы енді жоқ
Dialogue: 0,0:06:58.49,0:07:01.40,Rubi,,0000,0000,0000,,Акира
Dialogue: 0,0:06:58.49,0:07:01.40,Default,,0000,0000,0000,,Бас тарту
Dialogue: 0,0:07:01.40,0:07:02.37,Default,,0000,0000,0000,,Маған ұнамайды!
Dialogue: 0,0:07:02.37,0:07:05.37,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:02.37,0:07:05.37,Rubi,,0000,0000,0000,,Чугакусей
Dialogue: 0,0:07:02.37,0:07:05.37,Default,,0000,0000,0000,,Маруко орта мектеп оқушысы болған кезде
Dialogue: 0,0:07:02.37,0:07:05.37,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:07:02.37,0:07:05.37,Default,,0000,0000,0000,,Сіз оны сақтай аласыз.
Dialogue: 0,0:07:05.37,0:07:09.51,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:07:05.37,0:07:09.51,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:05.37,0:07:09.51,Default,,0000,0000,0000,,Мен Маруконы күте алмаймын
Dialogue: 0,0:07:05.37,0:07:09.51,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:07:05.37,0:07:09.51,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:07:05.37,0:07:09.51,Rubi,,0000,0000,0000,,Асо
Dialogue: 0,0:07:05.37,0:07:09.51,Default,,0000,0000,0000,,Мен дәл қазір торғайлармен ойнағым келеді!
Dialogue: 0,0:07:09.51,0:07:12.01,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:07:09.51,0:07:12.01,Rubi,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:07:09.51,0:07:12.01,Default,,0000,0000,0000,,Мені сыртқа шығарыңыз
Dialogue: 0,0:07:09.51,0:07:12.01,Default,,0000,0000,0000,,Мен қалаймын
Dialogue: 0,0:07:12.01,0:07:13.94,Rubi,,0000,0000,0000,,Kotori
Dialogue: 0,0:07:12.01,0:07:13.94,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:07:12.01,0:07:13.94,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:07:12.01,0:07:13.94,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:07:13.94,0:07:17.51,Rubi,,0000,0000,0000,,Қалыпты
Dialogue: 0,0:07:13.94,0:07:17.51,Default,,0000,0000,0000,,Қараңыз~ Әдетте осылай болады.
Dialogue: 0,0:07:13.94,0:07:17.51,Rubi,,0000,0000,0000,,Така
Dialogue: 0,0:07:13.94,0:07:17.51,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:07:13.94,0:07:17.51,Rubi,,0000,0000,0000,,Kotori
Dialogue: 0,0:07:13.94,0:07:17.51,Default,,0000,0000,0000,,Биік жерде кішкентай құс
Dialogue: 0,0:07:17.51,0:07:20.42,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:17.51,0:07:20.42,Rubi,,0000,0000,0000,,Фалко!!
Dialogue: 0,0:07:17.51,0:07:20.42,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:07:17.51,0:07:20.42,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:07:17.51,0:07:20.42,Default,,0000,0000,0000,,Маруконың қолына немесе иығына тоқтаңыз
Dialogue: 0,0:07:17.51,0:07:20.42,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:07:17.51,0:07:20.42,Default,,0000,0000,0000,,Ол шырылдап тұр
Dialogue: 0,0:07:20.42,0:07:24.95,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:07:20.42,0:07:24.95,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:07:20.42,0:07:24.95,Default,,0000,0000,0000,,Тамақ алғысы келгенде жылайды.
Dialogue: 0,0:07:20.42,0:07:24.95,Default,,0000,0000,0000,,Өте сүйкімді
Dialogue: 0,0:07:26.89,0:07:30.46,Rubi,,0000,0000,0000,,Анықтама
Dialogue: 0,0:07:26.89,0:07:30.46,Default,,0000,0000,0000,,Менің құсым
Dialogue: 0,0:07:26.89,0:07:30.46,Default,,0000,0000,0000,,«Тама-чан Тама-чан»
Dialogue: 0,0:07:30.46,0:07:32.96,Default,,0000,0000,0000,,«Кю-чан, Кю-чан»
Dialogue: 0,0:07:30.46,0:07:32.96,Default,,0000,0000,0000,,Бір нәрсе айтыңыз
Dialogue: 0,0:07:32.96,0:07:36.47,Rubi,,0000,0000,0000,,Тори
Dialogue: 0,0:07:32.96,0:07:36.47,Default,,0000,0000,0000,,Өтірік! Құс болса да
Dialogue: 0,0:07:32.96,0:07:36.47,Default,,0000,0000,0000,,Неге сөйлеп тұрсың?
Dialogue: 0,0:07:36.47,0:07:37.97,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:07:36.47,0:07:37.97,Default,,0000,0000,0000,,()
Dialogue: 0,0:07:37.97,0:07:42.84,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:07:37.97,0:07:42.84,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:37.97,0:07:42.84,Default,,0000,0000,0000,,Оның өмір сүргеніне 20 жыл болды.
Dialogue: 0,0:07:37.97,0:07:42.84,Rubi,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,0:07:37.97,0:07:42.84,Default,,0000,0000,0000,,Ағылшын тілін еркін меңгерген.
Dialogue: 0,0:07:42.84,0:07:47.48,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:07:42.84,0:07:47.48,Rubi,,0000,0000,0000,,Бір сызықты арқан
Dialogue: 0,0:07:42.84,0:07:47.48,Default,,0000,0000,0000,,《Ханава-кун күткендей, мұны істеу оңай.
Dialogue: 0,0:07:42.84,0:07:47.48,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:07:42.84,0:07:47.48,Default,,0000,0000,0000,,Сізде жұмыс істемейтін үй жануарыңыз бар...》
Dialogue: 0,0:07:47.48,0:07:50.98,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:07:47.48,0:07:50.98,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:07:47.48,0:07:50.98,Rubi,,0000,0000,0000,,Миккамае
Dialogue: 0,0:07:47.48,0:07:50.98,Default,,0000,0000,0000,,Мен, 3 күн бұрын
Dialogue: 0,0:07:47.48,0:07:50.98,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:07:47.48,0:07:50.98,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:07:47.48,0:07:50.98,Default,,0000,0000,0000,,Мен торғай балапан сатып алдым.
Dialogue: 0,0:07:50.98,0:07:52.48,Default,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:07:50.98,0:07:52.48,Default,,0000,0000,0000,,өтіңіз
Dialogue: 0,0:07:52.48,0:07:53.98,Default,,0000,0000,0000,,Сүйкімді және сүйкімді
Dialogue: 0,0:07:53.98,0:07:56.89,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:07:53.98,0:07:56.89,Default,,0000,0000,0000,,Оларды тамақтандыру да қызық.
Dialogue: 0,0:07:53.98,0:07:56.89,Default,,0000,0000,0000,,Мен бақыттымын.
Dialogue: 0,0:07:56.89,0:07:58.85,Default,,0000,0000,0000,,Қалай?
Dialogue: 0,0:07:56.89,0:07:58.85,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:07:56.89,0:07:58.85,Default,,0000,0000,0000,,Сіз оны сатып алдыңыз ба?
Dialogue: 0,0:07:58.85,0:07:59.86,Default,,0000,0000,0000,,Дада илеген?
Dialogue: 0,0:07:59.86,0:08:02.99,Rubi,,0000,0000,0000,,Мына мұз жігітке қарашы—
Dialogue: 0,0:07:59.86,0:08:02.99,Default,,0000,0000,0000,,<Басқа әдістер
Dialogue: 0,0:07:59.86,0:08:02.99,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:07:59.86,0:08:02.99,Default,,0000,0000,0000,,Ширанумару-чан＞
Dialogue: 0,0:08:02.99,0:08:06.50,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:08:02.99,0:08:06.50,Rubi,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:08:02.99,0:08:06.50,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:08:02.99,0:08:06.50,Default,,0000,0000,0000,,Білесің бе, мен жалғыз баламын.
Dialogue: 0,0:08:02.99,0:08:06.50,Rubi,,0000,0000,0000,,Кинджо
Dialogue: 0,0:08:02.99,0:08:06.50,Rubi,,0000,0000,0000,,Достар
Dialogue: 0,0:08:02.99,0:08:06.50,Default,,0000,0000,0000,,Менің жақын жерде достарым жоқ.
Dialogue: 0,0:08:06.50,0:08:10.00,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:06.50,0:08:10.00,Default,,0000,0000,0000,,Жалғызсың десең
Dialogue: 0,0:08:06.50,0:08:10.00,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:08:06.50,0:08:10.00,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:08:06.50,0:08:10.00,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:08:06.50,0:08:10.00,Default,,0000,0000,0000,,Анам маған торғай сатып берді.
Dialogue: 0,0:08:10.00,0:08:11.93,Default,,0000,0000,0000,,~ «Мен өзімді жалғыз сезінемін»
Dialogue: 0,0:08:10.00,0:08:11.93,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:10.00,0:08:11.93,Default,,0000,0000,0000,,Жаңа ғана айттыңыз ба?
Dialogue: 0,0:08:11.93,0:08:14.87,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:08:11.93,0:08:14.87,Default,,0000,0000,0000,,Сенің анаң кім?
Dialogue: 0,0:08:11.93,0:08:14.87,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:08:11.93,0:08:14.87,Default,,0000,0000,0000,,Сіз кездейсоқ жақсы адамсыз ба?
Dialogue: 0,0:08:14.87,0:08:19.37,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:14.87,0:08:19.37,Default,,0000,0000,0000,,Түсіндім, соны айтып көріңіз.
Dialogue: 0,0:08:14.87,0:08:19.37,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:08:14.87,0:08:19.37,Rubi,,0000,0000,0000,,Мына мұз жігітке қарашы—
Dialogue: 0,0:08:14.87,0:08:19.37,Default,,0000,0000,0000,,Бұл бір жол болуы мүмкін.
Dialogue: 0,0:08:20.51,0:08:23.01,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:08:20.51,0:08:23.01,Default,,0000,0000,0000,,Сәлем анашым...
Dialogue: 0,0:08:23.01,0:08:24.95,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:08:23.01,0:08:24.95,Default,,0000,0000,0000,,Маруко жалғыз
Dialogue: 0,0:08:24.95,0:08:26.88,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:08:24.95,0:08:26.88,Default,,0000,0000,0000,,ше? Не?
Dialogue: 0,0:08:26.88,0:08:28.88,Default,,0000,0000,0000,,Себебі мен өзімді жалғыз сезінемін...
Dialogue: 0,0:08:30.82,0:08:32.46,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:08:30.82,0:08:32.46,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:08:30.82,0:08:32.46,Default,,0000,0000,0000,,Торғай сатып ал.
Dialogue: 0,0:08:32.46,0:08:34.96,Rubi,,0000,0000,0000,,Кимо
Dialogue: 0,0:08:32.46,0:08:34.96,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:08:32.46,0:08:34.96,Default,,0000,0000,0000,,Тоқта, бұл жиіркенішті
Dialogue: 0,0:08:34.96,0:08:37.86,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:08:34.96,0:08:37.86,Rubi,,0000,0000,0000,,Исшо
Dialogue: 0,0:08:34.96,0:08:37.86,Rubi,,0000,0000,0000,,Теріс
Dialogue: 0,0:08:34.96,0:08:37.86,Default,,0000,0000,0000,,Әке, менің өмірлік тілегім
Dialogue: 0,0:08:34.96,0:08:37.86,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:08:34.96,0:08:37.86,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:08:34.96,0:08:37.86,Default,,0000,0000,0000,,Торғай сатып ал
Dialogue: 0,0:08:37.86,0:08:39.46,Default,,0000,0000,0000,,Хмф, сіз табандысыз.
Dialogue: 0,0:08:39.46,0:08:44.33,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:08:39.46,0:08:44.33,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:08:39.46,0:08:44.33,Default,,0000,0000,0000,,Маған торғай сатып алсаңыз
Dialogue: 0,0:08:39.46,0:08:44.33,Rubi,,0000,0000,0000,,Рого
Dialogue: 0,0:08:39.46,0:08:44.33,Rubi,,0000,0000,0000,,Ақаулық
Dialogue: 0,0:08:39.46,0:08:44.33,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:08:39.46,0:08:44.33,Default,,0000,0000,0000,,Қартайған кезде мен сені асыраймын.
Dialogue: 0,0:08:44.33,0:08:45.33,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:08:44.33,0:08:45.33,Default,,0000,0000,0000,,Сіз...
Dialogue: 0,0:08:45.33,0:08:47.97,Rubi,,0000,0000,0000,,Хьяккаджитен
Dialogue: 0,0:08:45.33,0:08:47.97,Rubi,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:08:45.33,0:08:47.97,Default,,0000,0000,0000,,Ах, немесе энциклопедияда.
Dialogue: 0,0:08:45.33,0:08:47.97,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:08:45.33,0:08:47.97,Default,,0000,0000,0000,,Жасырын
Dialogue: 0,0:08:47.97,0:08:50.87,Default,,0000,0000,0000,,Іш қуысы туралы
Dialogue: 0,0:08:47.97,0:08:50.87,Rubi,,0000,0000,0000,,Отбасы
Dialogue: 0,0:08:47.97,0:08:50.87,Default,,0000,0000,0000,,Сіз оны отбасыңызға бересіз бе?
Dialogue: 0,0:08:50.87,0:08:53.84,Default,,0000,0000,0000,,Қалай... неге олай істедің?
Dialogue: 0,0:08:50.87,0:08:53.84,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:08:50.87,0:08:53.84,Default,,0000,0000,0000,,Мен көрдім.
Dialogue: 0,0:08:53.84,0:08:56.98,Rubi,,0000,0000,0000,,Мезура
Dialogue: 0,0:08:53.84,0:08:56.98,Rubi,,0000,0000,0000,,Тренинг
Dialogue: 0,0:08:53.84,0:08:56.98,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:08:53.84,0:08:56.98,Default,,0000,0000,0000,,Мен әдеттен тыс оқуды шештім.
Dialogue: 0,0:08:53.84,0:08:56.98,Rubi,,0000,0000,0000,,Хьяккаджитен
Dialogue: 0,0:08:53.84,0:08:56.98,Rubi,,0000,0000,0000,,Хира
Dialogue: 0,0:08:53.84,0:08:56.98,Default,,0000,0000,0000,,Энциклопедияны ашыңыз
Dialogue: 0,0:08:56.98,0:08:58.91,Rubi,,0000,0000,0000,,Тосын
Dialogue: 0,0:08:56.98,0:08:58.91,Default,,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:08:58.91,0:09:01.85,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:08:58.91,0:09:01.85,Default,,0000,0000,0000,,Идиот! сен сондайсың
Dialogue: 0,0:08:58.91,0:09:01.85,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:08:58.91,0:09:01.85,Default,,0000,0000,0000,,Ол қу бала болды ма?
Dialogue: 0,0:09:01.85,0:09:04.49,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:01.85,0:09:04.49,Rubi,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:09:01.85,0:09:04.49,Default,,0000,0000,0000,,Неге, өзім?
Dialogue: 0,0:09:01.85,0:09:04.49,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:09:01.85,0:09:04.49,Default,,0000,0000,0000,,Біраз нашар болса да
Dialogue: 0,0:09:04.49,0:09:07.39,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:09:04.49,0:09:07.39,Rubi,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:09:04.49,0:09:07.39,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:09:04.49,0:09:07.39,Default,,0000,0000,0000,,Бұл басқа әңгіме.
Dialogue: 0,0:09:07.39,0:09:11.36,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:09:07.39,0:09:11.36,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:09:07.39,0:09:11.36,Default,,0000,0000,0000,,А, мен оны қалаймын, мен оны қалаймын.
Dialogue: 0,0:09:07.39,0:09:11.36,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:09:07.39,0:09:11.36,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:09:07.39,0:09:11.36,Default,,0000,0000,0000,,Маруко жақсы қыз болады!
Dialogue: 0,0:09:11.36,0:09:13.50,Rubi,,0000,0000,0000,,Нандо
Dialogue: 0,0:09:11.36,0:09:13.50,Default,,0000,0000,0000,,<Баяғыда
Dialogue: 0,0:09:11.36,0:09:13.50,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:09:11.36,0:09:13.50,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:09:11.36,0:09:13.50,Default,,0000,0000,0000,,Мен саған жақсы қыз боламын дедім.
Dialogue: 0,0:09:13.50,0:09:16.00,Default,,0000,0000,0000,,...
Dialogue: 0,0:09:13.50,0:09:16.00,Rubi,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:09:13.50,0:09:16.00,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:09:13.50,0:09:16.00,Default,,0000,0000,0000,,Әкесі біледі>
Dialogue: 0,0:09:16.00,0:09:18.50,Rubi,,0000,0000,0000,,Фурё
Dialogue: 0,0:09:16.00,0:09:18.50,Default,,0000,0000,0000,,Әй, мен құқық бұзушы боламын!
Dialogue: 0,0:09:18.50,0:09:21.50,Rubi,,0000,0000,0000,,Фурё
Dialogue: 0,0:09:18.50,0:09:21.50,Default,,0000,0000,0000,,<Кейде сіз қылмыскер бола алмайсыз
Dialogue: 0,0:09:18.50,0:09:21.50,Rubi,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:09:18.50,0:09:21.50,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:09:18.50,0:09:21.50,Default,,0000,0000,0000,,Әке біледі>
Dialogue: 0,0:09:23.37,0:09:26.94,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:09:23.37,0:09:26.94,Default,,0000,0000,0000,,Маруко ше?
Dialogue: 0,0:09:23.37,0:09:26.94,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:09:23.37,0:09:26.94,Rubi,,0000,0000,0000,,Ванна
Dialogue: 0,0:09:23.37,0:09:26.94,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:09:23.37,0:09:26.94,Default,,0000,0000,0000,,Мен қазір шомылып жатырмын.
Dialogue: 0,0:09:26.94,0:09:29.45,Default,,0000,0000,0000,,Ол өте жақсы
Dialogue: 0,0:09:26.94,0:09:29.45,Rubi,,0000,0000,0000,,Бунчо
Dialogue: 0,0:09:26.94,0:09:29.45,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:09:26.94,0:09:29.45,Default,,0000,0000,0000,,Сізге торғай керек сияқты.
Dialogue: 0,0:09:29.45,0:09:33.95,Rubi,,0000,0000,0000,,Қоңқай
Dialogue: 0,0:09:29.45,0:09:33.95,Default,,0000,0000,0000,,Эй, сен бұл жолы табандысың.
Dialogue: 0,0:09:29.45,0:09:33.95,Rubi,,0000,0000,0000,,Конджо
Dialogue: 0,0:09:29.45,0:09:33.95,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:09:29.45,0:09:33.95,Default,,0000,0000,0000,,Сол батыл Маруко үшін
Dialogue: 0,0:09:33.95,0:09:37.45,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:33.95,0:09:37.45,Default,,0000,0000,0000,,Тек бір нәрсені сұрағанда
Dialogue: 0,0:09:33.95,0:09:37.45,Default,,0000,0000,0000,,Ол әрқашан табанды.
Dialogue: 0,0:09:37.45,0:09:38.42,Rubi,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:09:37.45,0:09:38.42,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:09:37.45,0:09:38.42,Default,,0000,0000,0000,,(Хироси/Сумиренің күлкісі)
Dialogue: 0,0:09:38.42,0:09:41.96,Rubi,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:09:38.42,0:09:41.96,Rubi,,0000,0000,0000,,бойынша
Dialogue: 0,0:09:38.42,0:09:41.96,Default,,0000,0000,0000,,《Бұл күлкі емес.
Dialogue: 0,0:09:38.42,0:09:41.96,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:09:38.42,0:09:41.96,Default,,0000,0000,0000,,Бұл сіздің балаңыз》
Dialogue: 0,0:09:41.96,0:09:44.86,Rubi,,0000,0000,0000,,Суко
Dialogue: 0,0:09:41.96,0:09:44.86,Rubi,,0000,0000,0000,,Секининкан
Dialogue: 0,0:09:41.96,0:09:44.86,Default,,0000,0000,0000,,Бұл сізді біршама жауапкершілікті сезінуі мүмкін.
Dialogue: 0,0:09:41.96,0:09:44.86,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:09:41.96,0:09:44.86,Default,,0000,0000,0000,,Мен оны сатып алуым керек пе?
Dialogue: 0,0:09:44.86,0:09:47.46,Default,,0000,0000,0000,,《Аа~ Иә! 》
Dialogue: 0,0:09:47.46,0:09:49.40,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:09:47.46,0:09:49.40,Rubi,,0000,0000,0000,,Сөздер
Dialogue: 0,0:09:47.46,0:09:49.40,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
