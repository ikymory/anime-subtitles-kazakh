Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.91,0:01:15.41,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:10.37,0:03:12.97,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:10.37,0:03:12.97,Default,,0000,0000,0000,,Ммммммм...
Dialogue: 0,0:03:10.37,0:03:12.97,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:10.37,0:03:12.97,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:12.97,0:03:15.87,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:12.97,0:03:15.87,Default,,0000,0000,0000,,Маруко!
Dialogue: 0,0:03:12.97,0:03:15.87,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:03:15.87,0:03:17.47,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:15.87,0:03:17.47,Default,,0000,0000,0000,,Анашым
Dialogue: 0,0:03:17.47,0:03:19.41,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:03:17.47,0:03:19.41,Default,,0000,0000,0000,,Сіз қанша уақыт ұйықтадыңыз?
Dialogue: 0,0:03:19.41,0:03:21.98,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:03:19.41,0:03:21.98,Default,,0000,0000,0000,,Мен тез оянуым керек
Dialogue: 0,0:03:19.41,0:03:21.98,Rubi,,0000,0000,0000,,Чикоку
Dialogue: 0,0:03:19.41,0:03:21.98,Default,,0000,0000,0000,,Мен кешігіп барамын.
Dialogue: 0,0:03:21.98,0:03:24.41,Default,,0000,0000,0000,,Мен білемін, хехе...
Dialogue: 0,0:03:24.41,0:03:27.32,Default,,0000,0000,0000,,Мен мүлде түсінбеймін!
Dialogue: 0,0:03:24.41,0:03:27.32,Default,,0000,0000,0000,,Уф! Саму!
Dialogue: 0,0:03:27.32,0:03:32.92,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:03:27.32,0:03:32.92,Rubi,,0000,0000,0000,,Арман
Dialogue: 0,0:03:27.32,0:03:32.92,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:03:27.32,0:03:32.92,Default,,0000,0000,0000,,Бірақ мен бүгін жаман түс көрдім.
Dialogue: 0,0:03:27.32,0:03:32.92,Rubi,,0000,0000,0000,,Суко
Dialogue: 0,0:03:27.32,0:03:32.92,Default,,0000,0000,0000,,Олай болса тағы да~
Dialogue: 0,0:03:32.92,0:03:33.89,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:03:33.89,0:03:36.79,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:03:33.89,0:03:36.79,Default,,0000,0000,0000,,Өйткені ол менің әпкем.
Dialogue: 0,0:03:33.89,0:03:36.79,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:03:33.89,0:03:36.79,Default,,0000,0000,0000,,Сіз ұйықтап жатырсыз.
Dialogue: 0,0:03:36.79,0:03:39.79,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:03:36.79,0:03:39.79,Default,,0000,0000,0000,,Әпкеңнің жағдайы жақсы ма?
Dialogue: 0,0:03:36.79,0:03:39.79,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:03:36.79,0:03:39.79,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:03:36.79,0:03:39.79,Default,,0000,0000,0000,,Менің басым ауырып тұр.
Dialogue: 0,0:03:39.79,0:03:40.79,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:41.93,0:03:43.87,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:41.93,0:03:43.87,Rubi,,0000,0000,0000,,Дыбыс
Dialogue: 0,0:03:41.93,0:03:43.87,Default,,0000,0000,0000,,(Сакиконың жөтел дауысы)
Dialogue: 0,0:03:43.87,0:03:47.87,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:43.87,0:03:47.87,Default,,0000,0000,0000,,Ах, Маруко да.
Dialogue: 0,0:03:43.87,0:03:47.87,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:03:43.87,0:03:47.87,Default,,0000,0000,0000,,Ах, менің басым...
Dialogue: 0,0:03:48.80,0:03:50.94,Default,,0000,0000,0000,,Иә, қайсысы?
Dialogue: 0,0:03:50.94,0:03:52.87,Default,,0000,0000,0000,,Өтірікші!
Dialogue: 0,0:03:50.94,0:03:52.87,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:03:50.94,0:03:52.87,Default,,0000,0000,0000,,Бұл ештеңе емес.
Dialogue: 0,0:03:52.87,0:03:53.84,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:03:53.84,0:03:57.45,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:03:53.84,0:03:57.45,Default,,0000,0000,0000,,О! Бұл ауырады!
Dialogue: 0,0:03:53.84,0:03:57.45,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:03:53.84,0:03:57.45,Default,,0000,0000,0000,,Бұл ауырмайды.
Dialogue: 0,0:03:57.45,0:03:58.95,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:57.45,0:03:58.95,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:57.45,0:03:58.95,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:58.95,0:04:01.45,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:58.95,0:04:01.45,Default,,0000,0000,0000,,А... Анашым.
Dialogue: 0,0:03:58.95,0:04:01.45,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:58.95,0:04:01.45,Rubi,,0000,0000,0000,,Дыбыс
Dialogue: 0,0:03:58.95,0:04:01.45,Default,,0000,0000,0000,,(жөтел дауысы)
Dialogue: 0,0:04:01.45,0:04:06.32,Rubi,,0000,0000,0000,,Ханаджи
Dialogue: 0,0:04:01.45,0:04:06.32,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:04:01.45,0:04:06.32,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:04:01.45,0:04:06.32,Default,,0000,0000,0000,,Мұрным қанып жатыр, мама.
Dialogue: 0,0:04:01.45,0:04:06.32,Rubi,,0000,0000,0000,,Өте
Dialogue: 0,0:04:01.45,0:04:06.32,Default,,0000,0000,0000,,Жоқ, бұл қорқынышты!
Dialogue: 0,0:04:06.32,0:04:08.32,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:04:06.32,0:04:08.32,Rubi,,0000,0000,0000,,Дыбыс
Dialogue: 0,0:04:06.32,0:04:08.32,Default,,0000,0000,0000,,(Сакиконың жылаған дауысы)
Dialogue: 0,0:04:06.32,0:04:08.32,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:04:06.32,0:04:08.32,Default,,0000,0000,0000,,Қара, жылама.
Dialogue: 0,0:04:08.32,0:04:10.96,Rubi,,0000,0000,0000,,Жарайды, жарайды
Dialogue: 0,0:04:08.32,0:04:10.96,Default,,0000,0000,0000,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,0:04:10.96,0:04:13.86,Default,,0000,0000,0000,,Қараңдаршы, егер сен осылай тұра берсең
Dialogue: 0,0:04:10.96,0:04:13.86,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:04:10.96,0:04:13.86,Default,,0000,0000,0000,,Жақында тоқтайды.
Dialogue: 0,0:04:13.86,0:04:16.83,Default,,0000,0000,0000,,Хехе, осындай нәрсе
Dialogue: 0,0:04:13.86,0:04:16.83,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:04:13.86,0:04:16.83,Default,,0000,0000,0000,,Бұл тамаша емес.
Dialogue: 0,0:04:16.83,0:04:20.47,Default,,0000,0000,0000,,Мұнда және мұнда
Dialogue: 0,0:04:16.83,0:04:20.47,Rubi,,0000,0000,0000,,Не?
Dialogue: 0,0:04:16.83,0:04:20.47,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:16.83,0:04:20.47,Default,,0000,0000,0000,,Не айтып тұрсың, бала?
Dialogue: 0,0:04:20.47,0:04:23.91,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:20.47,0:04:23.91,Default,,0000,0000,0000,,Қараңдар! Маруко
Dialogue: 0,0:04:20.47,0:04:23.91,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:04:20.47,0:04:23.91,Rubi,,0000,0000,0000,,Каоара
Dialogue: 0,0:04:20.47,0:04:23.91,Rubi,,0000,0000,0000,,Кига
Dialogue: 0,0:04:20.47,0:04:23.91,Default,,0000,0000,0000,,Бетіңізді жуып, киіміңізді тез ауыстырыңыз.
Dialogue: 0,0:04:23.91,0:04:25.41,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:04:26.41,0:04:28.34,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:04:26.41,0:04:28.34,Rubi,,0000,0000,0000,,Гуай
Dialogue: 0,0:04:26.41,0:04:28.34,Default,,0000,0000,0000,,Әпкеңнің көңіл-күйі қалай?
Dialogue: 0,0:04:26.41,0:04:28.34,Default,,0000,0000,0000,,Ей! Естисің бе!? Польнареф!?
Dialogue: 0,0:04:28.34,0:04:32.28,Rubi,,0000,0000,0000,,Ханаджи
Dialogue: 0,0:04:28.34,0:04:32.28,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:04:28.34,0:04:32.28,Default,,0000,0000,0000,,Иә, мұрыннан қан кетті.
Dialogue: 0,0:04:28.34,0:04:32.28,Rubi,,0000,0000,0000,,Шинпай
Dialogue: 0,0:04:28.34,0:04:32.28,Default,,0000,0000,0000,,Мен аздап уайымдап тұрмын
Dialogue: 0,0:04:32.28,0:04:34.28,Default,,0000,0000,0000,,Шынымен салқын ба?
Dialogue: 0,0:04:34.28,0:04:36.92,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:04:34.28,0:04:36.92,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:34.28,0:04:36.92,Default,,0000,0000,0000,,Дәрігерге бару керек.
Dialogue: 0,0:04:34.28,0:04:36.92,Default,,0000,0000,0000,,Менің ойымша, бәрі жақсы.
Dialogue: 0,0:04:36.92,0:04:39.42,Rubi,,0000,0000,0000,,Мен қалаймын
Dialogue: 0,0:04:36.92,0:04:39.42,Default,,0000,0000,0000,,Бұл үлкен мәселе емес.
Dialogue: 0,0:04:36.92,0:04:39.42,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:04:36.92,0:04:39.42,Default,,0000,0000,0000,,«Маған бұл ұнамайды» деп ойладым,
Dialogue: 0,0:04:39.42,0:04:40.92,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:04:39.42,0:04:40.92,Default,,0000,0000,0000,,Сенің апаң нәзік болғандықтан.
Dialogue: 0,0:04:40.92,0:04:45.43,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:04:40.92,0:04:45.43,Default,,0000,0000,0000,,Ана
Dialogue: 0,0:04:40.92,0:04:45.43,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:40.92,0:04:45.43,Rubi,,0000,0000,0000,,Матадан жасалған сөмке
Dialogue: 0,0:04:40.92,0:04:45.43,Default,,0000,0000,0000,,Маруконың мектептегі түскі сөмкесі ше?
Dialogue: 0,0:04:45.43,0:04:48.33,Default,,0000,0000,0000,,Бұл туралы
Dialogue: 0,0:04:45.43,0:04:48.33,Rubi,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:04:45.43,0:04:48.33,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:04:45.43,0:04:48.33,Default,,0000,0000,0000,,Оны өзіңіз іздеңіз!
Dialogue: 0,0:04:48.33,0:04:50.30,Default,,0000,0000,0000,,Өзіңізді жалқау сезінгенде
Dialogue: 0,0:04:48.33,0:04:50.30,Rubi,,0000,0000,0000,,Чикоку
Dialogue: 0,0:04:48.33,0:04:50.30,Default,,0000,0000,0000,,Сіз кешігіп қаласыз!
Dialogue: 0,0:04:50.30,0:04:52.30,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:04:52.30,0:04:54.94,Rubi,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:04:52.30,0:04:54.94,Default,,0000,0000,0000,,Жүр, ішіп ал.
Dialogue: 0,0:04:54.94,0:04:57.84,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:04:54.94,0:04:57.84,Rubi,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:04:54.94,0:04:57.84,Default,,0000,0000,0000,,Тыныштанғаннан кейін
Dialogue: 0,0:04:54.94,0:04:57.84,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:04:54.94,0:04:57.84,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:04:54.94,0:04:57.84,Rubi,,0000,0000,0000,,Бюен
Dialogue: 0,0:04:54.94,0:04:57.84,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:54.94,0:04:57.84,Default,,0000,0000,0000,,Анаммен ауруханаға барайық.
Dialogue: 0,0:04:57.84,0:04:59.44,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:04:59.44,0:05:01.94,Default,,0000,0000,0000,,Енді, енді.
Dialogue: 0,0:04:59.44,0:05:01.94,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:04:59.44,0:05:01.94,Rubi,,0000,0000,0000,,Тәтті
Dialogue: 0,0:04:59.44,0:05:01.94,Default,,0000,0000,0000,,Аға болсаң, бұзылғансың.
Dialogue: 0,0:05:02.94,0:05:04.44,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:05:07.82,0:05:09.82,Default,,0000,0000,0000,,Тексеріңіз, бұл жақсы.
Dialogue: 0,0:05:11.95,0:05:15.46,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:11.95,0:05:15.46,Rubi,,0000,0000,0000,,Ханаджи
Dialogue: 0,0:05:11.95,0:05:15.46,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:05:11.95,0:05:15.46,Default,,0000,0000,0000,,《Маруко мұрнынан қан кетеді ме екен...
Dialogue: 0,0:05:11.95,0:05:15.46,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:11.95,0:05:15.46,Default,,0000,0000,0000,,Сонда сенің анаң да.
Dialogue: 0,0:05:15.46,0:05:18.36,Default,,0000,0000,0000,,Мен туралы
Dialogue: 0,0:05:15.46,0:05:18.36,Rubi,,0000,0000,0000,,Шинпай
Dialogue: 0,0:05:15.46,0:05:18.36,Default,,0000,0000,0000,,Сен маған қамқорсың》
Dialogue: 0,0:05:18.36,0:05:21.33,Rubi,,0000,0000,0000,,Данши
Dialogue: 0,0:05:18.36,0:05:21.33,Rubi,,0000,0000,0000,,Сайто
Dialogue: 0,0:05:18.36,0:05:21.33,Default,,0000,0000,0000,,Сәлем Сайто
Dialogue: 0,0:05:18.36,0:05:21.33,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:05:18.36,0:05:21.33,Rubi,,0000,0000,0000,,Қызыл
Dialogue: 0,0:05:18.36,0:05:21.33,Default,,0000,0000,0000,,Не болды? Бетіңіз қызарған
Dialogue: 0,0:05:21.33,0:05:23.90,Rubi,,0000,0000,0000,,Сайто
Dialogue: 0,0:05:21.33,0:05:23.90,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:05:23.90,0:05:25.83,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:05:23.90,0:05:25.83,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:25.83,0:05:27.77,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:25.83,0:05:27.77,Default,,0000,0000,0000,,О!
Dialogue: 0,0:05:27.77,0:05:30.41,Rubi,,0000,0000,0000,,Секигучи
Dialogue: 0,0:05:27.77,0:05:30.41,Default,,0000,0000,0000,,Не? Не?
Dialogue: 0,0:05:27.77,0:05:30.41,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:05:30.41,0:05:31.91,Rubi,,0000,0000,0000,,Тогава
Dialogue: 0,0:05:30.41,0:05:31.91,Default,,0000,0000,0000,,(Тогава)
Dialogue: 0,0:05:30.41,0:05:31.91,Rubi,,0000,0000,0000,,Сайто-кун
Dialogue: 0,0:05:30.41,0:05:31.91,Default,,0000,0000,0000,,Не болды? Сайто мырза
Dialogue: 0,0:05:31.91,0:05:33.84,Rubi,,0000,0000,0000,,Сайто
Dialogue: 0,0:05:31.91,0:05:33.84,Rubi,,0000,0000,0000,,Ханаджи
Dialogue: 0,0:05:31.91,0:05:33.84,Default,,0000,0000,0000,,мұрыннан қан кеткен...
Dialogue: 0,0:05:33.84,0:05:35.34,Rubi,,0000,0000,0000,,Тогава
Dialogue: 0,0:05:33.84,0:05:35.34,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:05:33.84,0:05:35.34,Default,,0000,0000,0000,,Маған қайсысын көрсетіңіз.
Dialogue: 0,0:05:36.41,0:05:38.91,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:05:36.41,0:05:38.91,Rubi,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:05:36.41,0:05:38.91,Default,,0000,0000,0000,,Енді жоғары қарап, бір орында тұр.
Dialogue: 0,0:05:38.91,0:05:41.42,Rubi,,0000,0000,0000,,Қазір
Dialogue: 0,0:05:38.91,0:05:41.42,Rubi,,0000,0000,0000,,Гами
Dialogue: 0,0:05:38.91,0:05:41.42,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:05:38.91,0:05:41.42,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:05:38.91,0:05:41.42,Default,,0000,0000,0000,,Кімде қағаз бар?
Dialogue: 0,0:05:38.91,0:05:41.42,Default,,0000,0000,0000,,Сіз сондасыз ба?
Dialogue: 0,0:05:41.42,0:05:44.92,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:05:41.42,0:05:44.92,Default,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:05:41.42,0:05:44.92,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:05:41.42,0:05:44.92,Rubi,,0000,0000,0000,,Гами
Dialogue: 0,0:05:41.42,0:05:44.92,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:05:41.42,0:05:44.92,Default,,0000,0000,0000,,Менің қағазымды пайдаланыңыз
Dialogue: 0,0:05:44.92,0:05:48.42,Rubi,,0000,0000,0000,,Тогава
Dialogue: 0,0:05:44.92,0:05:48.42,Default,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:05:44.92,0:05:48.42,Rubi,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:05:44.92,0:05:48.42,Default,,0000,0000,0000,,Эй, қозғалма.
Dialogue: 0,0:05:48.42,0:05:52.29,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:05:48.42,0:05:52.29,Rubi,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:05:48.42,0:05:52.29,Default,,0000,0000,0000,,О, жақсысың ба?
Dialogue: 0,0:05:48.42,0:05:52.29,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:05:48.42,0:05:52.29,Rubi,,0000,0000,0000,,Сайто-кун
Dialogue: 0,0:05:48.42,0:05:52.29,Default,,0000,0000,0000,,Бейшара Сайто-кун
Dialogue: 0,0:05:52.29,0:05:53.29,Rubi,,0000,0000,0000,,Данши
Dialogue: 0,0:05:52.29,0:05:53.29,Rubi,,0000,0000,0000,,Ханаджи
Dialogue: 0,0:05:52.29,0:05:53.29,Default,,0000,0000,0000,,Мұрыннан қан кету дегеніміз не?
Dialogue: 0,0:05:53.29,0:05:56.30,Default,,0000,0000,0000,,Бұл шынымен де.
Dialogue: 0,0:05:53.29,0:05:56.30,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:05:53.29,0:05:56.30,Default,,0000,0000,0000,,Бұл мені ұшырды.
Dialogue: 0,0:05:56.30,0:05:58.43,Rubi,,0000,0000,0000,,Данши
Dialogue: 0,0:05:56.30,0:05:58.43,Rubi,,0000,0000,0000,,Минао
Dialogue: 0,0:05:56.30,0:05:58.43,Rubi,,0000,0000,0000,,Сайто
Dialogue: 0,0:05:56.30,0:05:58.43,Default,,0000,0000,0000,,А, мен оны қарап шықтым, Сайто.
Dialogue: 0,0:05:58.43,0:06:02.93,Rubi,,0000,0000,0000,,Данши
Dialogue: 0,0:05:58.43,0:06:02.93,Rubi,,0000,0000,0000,,Сайто
Dialogue: 0,0:05:58.43,0:06:02.93,Rubi,,0000,0000,0000,,Ганба
Dialogue: 0,0:05:58.43,0:06:02.93,Default,,0000,0000,0000,,Сәттілік Саито
Dialogue: 0,0:05:58.43,0:06:02.93,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:05:58.43,0:06:02.93,Rubi,,0000,0000,0000,,Ганба
Dialogue: 0,0:05:58.43,0:06:02.93,Rubi,,0000,0000,0000,,Сайто-кун
Dialogue: 0,0:05:58.43,0:06:02.93,Default,,0000,0000,0000,,Сәттілік Сайто-кун
Dialogue: 0,0:06:04.31,0:06:06.94,Default,,0000,0000,0000,,《Мф! Қандай жігіт》
Dialogue: 0,0:06:06.94,0:06:09.44,Rubi,,0000,0000,0000,,Хумма
Dialogue: 0,0:06:06.94,0:06:09.44,Default,,0000,0000,0000,,《Бар болғаны 5 минут бұрын
Dialogue: 0,0:06:06.94,0:06:09.44,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:06:06.94,0:06:09.44,Default,,0000,0000,0000,,Удатсу көтерілмейді
Dialogue: 0,0:06:09.44,0:06:11.38,Rubi,,0000,0000,0000,,Хейбон
Dialogue: 0,0:06:09.44,0:06:11.38,Rubi,,0000,0000,0000,,Сеито
Dialogue: 0,0:06:09.44,0:06:11.38,Default,,0000,0000,0000,,Мен орташа оқушы болсам да...
Dialogue: 0,0:06:11.38,0:06:13.31,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:06:11.38,0:06:13.31,Rubi,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:06:11.38,0:06:13.31,Rubi,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:06:11.38,0:06:13.31,Default,,0000,0000,0000,,Тұтынушының жүрегін ұстаңыз және ешқашан жібермеңіз
Dialogue: 0,0:06:13.31,0:06:17.81,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:06:13.31,0:06:17.81,Rubi,,0000,0000,0000,,Ники
Dialogue: 0,0:06:13.31,0:06:17.81,Default,,0000,0000,0000,,Қазір ол өз сыныбында танымал жұлдыз.
Dialogue: 0,0:06:13.31,0:06:17.81,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:06:13.31,0:06:17.81,Default,,0000,0000,0000,,Толығымен бортта》
Dialogue: 0,0:06:18.95,0:06:20.89,Default,,0000,0000,0000,,《Тексер! 》
Dialogue: 0,0:06:20.89,0:06:22.46,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:06:20.89,0:06:22.46,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:06:20.89,0:06:22.46,Default,,0000,0000,0000,,Ұстаз!
Dialogue: 0,0:06:20.89,0:06:22.46,Default,,0000,0000,0000,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,0:06:22.46,0:06:26.89,Default,,0000,0000,0000,,Мұнда бір ғана орын бар
Dialogue: 0,0:06:22.46,0:06:26.89,Rubi,,0000,0000,0000,,Сайто-кун
Dialogue: 0,0:06:22.46,0:06:26.89,Rubi,,0000,0000,0000,,Хокеншицу
Dialogue: 0,0:06:22.46,0:06:26.89,Rubi,,0000,0000,0000,,Қауіпсіздік
Dialogue: 0,0:06:22.46,0:06:26.89,Default,,0000,0000,0000,,Сайто емханада демалып жатыр...
Dialogue: 0,0:06:26.89,0:06:28.40,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:06:28.40,0:06:30.33,Default,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:06:30.33,0:06:31.90,Default,,0000,0000,0000,,Олай болса, Сакура-сан.
Dialogue: 0,0:06:31.90,0:06:33.84,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:06:31.90,0:06:33.84,Default,,0000,0000,0000,,Ары қарай жүріңіз
Dialogue: 0,0:06:31.90,0:06:33.84,Default,,0000,0000,0000,,беріңізші
Dialogue: 0,0:06:33.84,0:06:35.34,Default,,0000,0000,0000,,Иә! Иә...
Dialogue: 0,0:06:36.77,0:06:40.91,Rubi,,0000,0000,0000,,Хокен
Dialogue: 0,0:06:36.77,0:06:40.91,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:06:36.77,0:06:40.91,Rubi,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:06:36.77,0:06:40.91,Default,,0000,0000,0000,,мен шынымен құрмет сезіндім.
Dialogue: 0,0:06:36.77,0:06:40.91,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:06:36.77,0:06:40.91,Default,,0000,0000,0000,,Егер сіз мұны істесеңіз, ол тоқтайды.
Dialogue: 0,0:06:40.91,0:06:43.81,Default,,0000,0000,0000,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:06:40.91,0:06:43.81,Rubi,,0000,0000,0000,,Қара
Dialogue: 0,0:06:40.91,0:06:43.81,Default,,0000,0000,0000,,Еңбектеріңіз үшін де рахмет.
Dialogue: 0,0:06:43.81,0:06:46.78,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:06:43.81,0:06:46.78,Rubi,,0000,0000,0000,,Қосымша
Dialogue: 0,0:06:43.81,0:06:46.78,Default,,0000,0000,0000,,Сіз қазір сыныпқа орала аласыз.
Dialogue: 0,0:06:46.78,0:06:49.42,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:46.78,0:06:49.42,Rubi,,0000,0000,0000,,Хокен
Dialogue: 0,0:06:46.78,0:06:49.42,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:06:46.78,0:06:49.42,Default,,0000,0000,0000,,()
Dialogue: 0,0:06:49.42,0:06:52.32,Default,,0000,0000,0000,,Бір сәт...
Dialogue: 0,0:06:49.42,0:06:52.32,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:06:49.42,0:06:52.32,Default,,0000,0000,0000,,Бір сәт ояныңыз.
Dialogue: 0,0:06:52.32,0:06:53.29,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:53.29,0:06:56.92,Rubi,,0000,0000,0000,,Ханаджи
Dialogue: 0,0:06:53.29,0:06:56.92,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:06:53.29,0:06:56.92,Default,,0000,0000,0000,,Мұрыннан қалай қан кетуге болады?
Dialogue: 0,0:06:53.29,0:06:56.92,Rubi,,0000,0000,0000,,Оши
Dialogue: 0,0:06:53.29,0:06:56.92,Default,,0000,0000,0000,,Айтыңызшы
Dialogue: 0,0:06:56.92,0:07:00.43,Default,,0000,0000,0000,,Иә, білмеймін.
Dialogue: 0,0:06:56.92,0:07:00.43,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:07:00.43,0:07:02.36,Default,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:07:02.36,0:07:05.93,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:02.36,0:07:05.93,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:07:02.36,0:07:05.93,Default,,0000,0000,0000,,Бұл рас, анық.
Dialogue: 0,0:07:05.93,0:07:07.87,Default,,0000,0000,0000,,Хмф...
Dialogue: 0,0:07:07.87,0:07:09.80,Default,,0000,0000,0000,,《Маған
Dialogue: 0,0:07:07.87,0:07:09.80,Rubi,,0000,0000,0000,,Шуяку
Dialogue: 0,0:07:07.87,0:07:09.80,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:07:07.87,0:07:09.80,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:07:07.87,0:07:09.80,Default,,0000,0000,0000,,Мен орталық сахнаға шыққанды ұнатпаймын.
Dialogue: 0,0:07:09.80,0:07:12.44,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:07:09.80,0:07:12.44,Rubi,,0000,0000,0000,,Оши
Dialogue: 0,0:07:09.80,0:07:12.44,Default,,0000,0000,0000,,Маған сырды айтпайсың.
Dialogue: 0,0:07:12.44,0:07:15.94,Rubi,,0000,0000,0000,,Шуяку
Dialogue: 0,0:07:12.44,0:07:15.94,Rubi,,0000,0000,0000,,Сайто-кун
Dialogue: 0,0:07:12.44,0:07:15.94,Default,,0000,0000,0000,,<Мұндай жетекші рөл үшін Сайто мырза,
Dialogue: 0,0:07:12.44,0:07:15.94,Rubi,,0000,0000,0000,,Теріс
Dialogue: 0,0:07:12.44,0:07:15.94,Rubi,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:07:12.44,0:07:15.94,Default,,0000,0000,0000,,Бұл тілек＞
Dialogue: 0,0:07:17.95,0:07:20.45,Rubi,,0000,0000,0000,,Даидзи
Dialogue: 0,0:07:17.95,0:07:20.45,Default,,0000,0000,0000,,Абайлаңыз.
Dialogue: 0,0:07:20.45,0:07:22.95,Default,,0000,0000,0000,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:07:22.95,0:07:28.39,Rubi,,0000,0000,0000,,Ханаджи
Dialogue: 0,0:07:22.95,0:07:28.39,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:07:22.95,0:07:28.39,Default,,0000,0000,0000,,Жарайды! Мұрным қанды
Dialogue: 0,0:07:22.95,0:07:28.39,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:07:22.95,0:07:28.39,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:07:22.95,0:07:28.39,Default,,0000,0000,0000,,Уақыт адамы болудан басқа амалың жоқ, хехе
Dialogue: 0,0:07:28.39,0:07:31.39,Rubi,,0000,0000,0000,,Мейвакку
Dialogue: 0,0:07:28.39,0:07:31.39,Default,,0000,0000,0000,,<Бұл өте тітіркендіргіш.
Dialogue: 0,0:07:28.39,0:07:31.39,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:07:28.39,0:07:31.39,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:07:28.39,0:07:31.39,Default,,0000,0000,0000,,Уақыт адамы＞
Dialogue: 0,0:07:32.26,0:07:34.90,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:32.26,0:07:34.90,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:32.26,0:07:34.90,Rubi,,0000,0000,0000,,Ханаджи
Dialogue: 0,0:07:32.26,0:07:34.90,Default,,0000,0000,0000,,Мұрыннан қан кету?
Dialogue: 0,0:07:34.90,0:07:38.40,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:34.90,0:07:38.40,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:07:34.90,0:07:38.40,Default,,0000,0000,0000,,Оны қалай шығаруға болады?
Dialogue: 0,0:07:38.40,0:07:41.90,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:07:38.40,0:07:41.90,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:38.40,0:07:41.90,Default,,0000,0000,0000,,Хмм, иә...
Dialogue: 0,0:07:41.90,0:07:44.41,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:07:41.90,0:07:44.41,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:07:41.90,0:07:44.41,Default,,0000,0000,0000,,Шоколадты көп жесеңіз
Dialogue: 0,0:07:41.90,0:07:44.41,Rubi,,0000,0000,0000,,Ханаджи
Dialogue: 0,0:07:41.90,0:07:44.41,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:07:41.90,0:07:44.41,Default,,0000,0000,0000,,Мұрыннан қан кету
Dialogue: 0,0:07:44.41,0:07:46.91,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:07:44.41,0:07:46.91,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:44.41,0:07:46.91,Default,,0000,0000,0000,,Анам үнемі солай айтады.
Dialogue: 0,0:07:46.91,0:07:48.84,Default,,0000,0000,0000,,Иә! шоколад
Dialogue: 0,0:07:48.84,0:07:52.34,Default,,0000,0000,0000,,《Түсіндім, шоколад...》
Dialogue: 0,0:07:57.42,0:07:59.92,Default,,0000,0000,0000,,Жоқ, жоқ...
Dialogue: 0,0:07:59.92,0:08:02.42,Rubi,,0000,0000,0000,,Ханаджи
Dialogue: 0,0:07:59.92,0:08:02.42,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:07:59.92,0:08:02.42,Default,,0000,0000,0000,,Мұрнымнан қан кеткені сонша
Dialogue: 0,0:07:59.92,0:08:02.42,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:07:59.92,0:08:02.42,Default,,0000,0000,0000,,Шоколад жеу
Dialogue: 0,0:08:02.42,0:08:06.29,Default,,0000,0000,0000,,Мұндай сән-салтанат
Dialogue: 0,0:08:02.42,0:08:06.29,Default,,0000,0000,0000,,Мен мұны істей алмаймын.
Dialogue: 0,0:08:06.29,0:08:08.93,Default,,0000,0000,0000,,Эй, эй, Мару-чан...
Dialogue: 0,0:08:08.93,0:08:11.43,Rubi,,0000,0000,0000,,Мына мұз жігітке қарашы—
Dialogue: 0,0:08:08.93,0:08:11.43,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:08:08.93,0:08:11.43,Default,,0000,0000,0000,,Жоқ, басқа әдісті ойлап көрейік.
Dialogue: 0,0:08:12.43,0:08:15.94,Rubi,,0000,0000,0000,,Ханаджи
Dialogue: 0,0:08:12.43,0:08:15.94,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:08:12.43,0:08:15.94,Default,,0000,0000,0000,,Ей, мұрыннан қан ағып жатыр!
