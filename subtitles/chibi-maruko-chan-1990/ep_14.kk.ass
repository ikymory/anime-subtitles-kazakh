Dialogue: 0,0:20:28.77,0:20:30.77,Default,,0000,0000,0000,,Тек шыдамды болыңыз.
Dialogue: 0,0:20:30.77,0:20:32.91,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:20:30.77,0:20:32.91,Rubi,,0000,0000,0000,,Құны
Dialogue: 0,0:20:30.77,0:20:32.91,Default,,0000,0000,0000,,Маруко, картопқа жауапты адам жақсы.
Dialogue: 0,0:20:32.91,0:20:35.81,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:20:32.91,0:20:35.81,Rubi,,0000,0000,0000,,Хочо
Dialogue: 0,0:20:32.91,0:20:35.81,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:20:32.91,0:20:35.81,Default,,0000,0000,0000,,Сіз пышақты пайдалана алмайсыз, солай ма?
Dialogue: 0,0:20:35.81,0:20:38.78,Rubi,,0000,0000,0000,,Нику
Dialogue: 0,0:20:35.81,0:20:38.78,Default,,0000,0000,0000,,Ой, етке барайық.
Dialogue: 0,0:20:35.81,0:20:38.78,Rubi,,0000,0000,0000,,Шио
Dialogue: 0,0:20:35.81,0:20:38.78,Default,,0000,0000,0000,,Тұз бен бұрыш беріңізші.
Dialogue: 0,0:20:38.78,0:20:40.78,Rubi,,0000,0000,0000,,Нику
Dialogue: 0,0:20:38.78,0:20:40.78,Default,,0000,0000,0000,,Е! ет
Dialogue: 0,0:20:40.78,0:20:43.92,Default,,0000,0000,0000,,Жоқ, сіз шуылдап жатырсыз
Dialogue: 0,0:20:40.78,0:20:43.92,Rubi,,0000,0000,0000,,Кимо
Dialogue: 0,0:20:40.78,0:20:43.92,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:20:40.78,0:20:43.92,Default,,0000,0000,0000,,Бұл жиіркенішті
Dialogue: 0,0:20:43.92,0:20:47.42,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:20:43.92,0:20:47.42,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:20:43.92,0:20:47.42,Default,,0000,0000,0000,,Біз есімізді жоғалтқан болармыз, иә?
Dialogue: 0,0:20:43.92,0:20:47.42,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:20:43.92,0:20:47.42,Default,,0000,0000,0000,,Сіз етті жақсы көресіз.
Dialogue: 0,0:20:47.42,0:20:48.92,Rubi,,0000,0000,0000,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:20:47.42,0:20:48.92,Default,,0000,0000,0000,,Пісірілген!
Dialogue: 0,0:20:48.92,0:20:52.43,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:20:48.92,0:20:52.43,Default,,0000,0000,0000,,Ах! Менің әпкем де
Dialogue: 0,0:20:48.92,0:20:52.43,Rubi,,0000,0000,0000,,Нику
Dialogue: 0,0:20:48.92,0:20:52.43,Rubi,,0000,0000,0000,,Сава
Dialogue: 0,0:20:48.92,0:20:52.43,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:20:48.92,0:20:52.43,Default,,0000,0000,0000,,Менің ойымша, сіз ет ұстағанды ұнатпайсыз.
Dialogue: 0,0:20:52.43,0:20:53.93,Default,,0000,0000,0000,,Иә? Хехе
Dialogue: 0,0:20:53.93,0:20:56.43,Default,,0000,0000,0000,,Жарайсыңдар! Жарайды онда
Dialogue: 0,0:20:53.93,0:20:56.43,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:20:53.93,0:20:56.43,Default,,0000,0000,0000,,Тас, қағаз, қайшымен шешейік
Dialogue: 0,0:20:56.43,0:20:58.93,Default,,0000,0000,0000,,Джан Каен…
Dialogue: 0,0:20:56.43,0:20:58.93,Default,,0000,0000,0000,,Ядатеба
Dialogue: 0,0:20:58.93,0:21:00.43,Default,,0000,0000,0000,,Жұмысқа бара жатқан кеңсе қызметкерлерінің «жасырын фотосуретін» түсіріп жүрмін.
Dialogue: 0,0:20:58.93,0:21:00.43,Default,,0000,0000,0000,,Қамшы
Dialogue: 0,0:21:00.43,0:21:01.94,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:21:01.94,0:21:03.87,Default,,0000,0000,0000,,Uh... ah!
Dialogue: 0,0:21:03.87,0:21:06.81,Default,,0000,0000,0000,,дюймдік кілт!
Dialogue: 0,0:21:03.87,0:21:06.81,Rubi,,0000,0000,0000,,Нику
Dialogue: 0,0:21:03.87,0:21:06.81,Default,,0000,0000,0000,,Жоқ, бұл ет.
Dialogue: 0,0:21:06.81,0:21:08.81,Default,,0000,0000,0000,,Буёбуйо...
Dialogue: 0,0:21:06.81,0:21:08.81,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:21:06.81,0:21:08.81,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:21:08.81,0:21:11.45,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:21:08.81,0:21:11.45,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:21:08.81,0:21:11.45,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:21:08.81,0:21:11.45,Rubi,,0000,0000,0000,,Никугакари
Dialogue: 0,0:21:08.81,0:21:11.45,Default,,0000,0000,0000,,Тоқта, күт, етші!
Dialogue: 0,0:21:11.45,0:21:13.45,Default,,0000,0000,0000,,Хехехе
Dialogue: 0,0:21:11.45,0:21:13.45,Default,,0000,0000,0000,,Ядатеба!
Dialogue: 0,0:21:15.32,0:21:17.95,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:21:17.95,0:21:19.89,Rubi,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:21:17.95,0:21:19.89,Default,,0000,0000,0000,,Жақсы пісірілген.
Dialogue: 0,0:21:19.89,0:21:22.79,Default,,0000,0000,0000,,Менің қарным ашты... әлі?
Dialogue: 0,0:21:22.79,0:21:24.39,Default,,0000,0000,0000,,Тағы да
Dialogue: 0,0:21:24.39,0:21:25.89,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:21:25.89,0:21:28.80,Default,,0000,0000,0000,,Тіпті нан да
Dialogue: 0,0:21:25.89,0:21:28.80,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:21:25.89,0:21:28.80,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:21:25.89,0:21:28.80,Default,,0000,0000,0000,,Мен дүкенге баруым керек еді.
Dialogue: 0,0:21:28.80,0:21:30.40,Default,,0000,0000,0000,,Кішкене ғана
Dialogue: 0,0:21:30.40,0:21:34.27,Default,,0000,0000,0000,,Кілегей нан
Dialogue: 0,0:21:30.40,0:21:34.27,Default,,0000,0000,0000,,Анпан қауын наны
Dialogue: 0,0:21:34.27,0:21:37.27,Default,,0000,0000,0000,,А, шоколад тәжі
Dialogue: 0,0:21:37.27,0:21:40.41,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:37.27,0:21:40.41,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:21:37.27,0:21:40.41,Default,,0000,0000,0000,,Сәлем Янако
Dialogue: 0,0:21:40.41,0:21:41.41,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:21:42.34,0:21:45.34,Rubi,,0000,0000,0000,,Умебо
Dialogue: 0,0:21:42.34,0:21:45.34,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:21:42.34,0:21:45.34,Default,,0000,0000,0000,,Ең болмаса маринадталған қара өрік жеймін.
Dialogue: 0,0:21:46.28,0:21:48.92,Default,,0000,0000,0000,,Ах! Қышқыл!
Dialogue: 0,0:21:48.92,0:21:50.85,Default,,0000,0000,0000,,Әрине!
Dialogue: 0,0:21:50.85,0:21:52.79,Default,,0000,0000,0000,,Жақында карри мен күріш келеді
Dialogue: 0,0:21:50.85,0:21:52.79,Default,,0000,0000,0000,,Менің қолымнан келсе де.
Dialogue: 0,0:21:52.79,0:21:54.79,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:21:52.79,0:21:54.79,Default,,0000,0000,0000,,Бұлардың бәрін жеме!
Dialogue: 0,0:21:54.79,0:21:56.42,Default,,0000,0000,0000,,Өйткені...
Dialogue: 0,0:21:56.42,0:21:58.36,Rubi,,0000,0000,0000,,Сохо
Dialogue: 0,0:21:56.42,0:21:58.36,Rubi,,0000,0000,0000,,Көкүгенжотай
Dialogue: 0,0:21:56.42,0:21:58.36,Default,,0000,0000,0000,,<Екеуі де төтенше жағдайда>
Dialogue: 0,0:21:58.36,0:22:00.29,Default,,0000,0000,0000,,
Dialogue: 0,0:21:58.36,0:22:00.29,Default,,0000,0000,0000,,Кокекко»
Dialogue: 0,0:22:00.29,0:22:04.30,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:22:00.29,0:22:04.30,Default,,0000,0000,0000,,...
Dialogue: 0,0:22:00.29,0:22:04.30,Default,,0000,0000,0000,,Жұмыртқа Рамен Фу! »
Dialogue: 0,0:22:04.30,0:22:07.80,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:04.30,0:22:07.80,Rubi,,0000,0000,0000,,Келгеніңе қуаныштымын.
Dialogue: 0,0:22:04.30,0:22:07.80,Default,,0000,0000,0000,,Бұл карри мен күріштің иісі.
Dialogue: 0,0:22:09.94,0:22:12.84,Default,,0000,0000,0000,,Сонымен шектелелік.
Dialogue: 0,0:22:09.94,0:22:12.84,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:22:09.94,0:22:12.84,Default,,0000,0000,0000,,Күте тұрыңыз.
Dialogue: 0,0:22:12.84,0:22:16.44,Default,,0000,0000,0000,,Тағы да
Dialogue: 0,0:22:12.84,0:22:16.44,Default,,0000,0000,0000,,Ол қазірдің өзінде аяқталды.
Dialogue: 0,0:22:16.44,0:22:20.31,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:22:16.44,0:22:20.31,Default,,0000,0000,0000,,Сіз карри роусын қосқаннан кейін білесіз.
Dialogue: 0,0:22:16.44,0:22:20.31,Rubi,,0000,0000,0000,,Суко
Dialogue: 0,0:22:16.44,0:22:20.31,Rubi,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:22:16.44,0:22:20.31,Default,,0000,0000,0000,,Аздап қайнатыңыз.
Dialogue: 0,0:22:20.31,0:22:22.88,Rubi,,0000,0000,0000,,Цуку
Dialogue: 0,0:22:20.31,0:22:22.88,Default,,0000,0000,0000,,Дәмді карри мен күрішті дайында
Dialogue: 0,0:22:20.31,0:22:22.88,Default,,0000,0000,0000,,Мәселе мынада.
Dialogue: 0,0:22:22.88,0:22:24.82,Default,,0000,0000,0000,,Қандай нүктелер бар?
Dialogue: 0,0:22:22.88,0:22:24.82,Default,,0000,0000,0000,,Маған бәрібір
Dialogue: 0,0:22:24.82,0:22:27.75,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:22:24.82,0:22:27.75,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:22:24.82,0:22:27.75,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:22:24.82,0:22:27.75,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:22:24.82,0:22:27.75,Default,,0000,0000,0000,,Мен оны тез жегім келеді! Мен оны тезірек жегім келеді!
Dialogue: 0,0:22:24.82,0:22:27.75,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:22:24.82,0:22:27.75,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:22:24.82,0:22:27.75,Default,,0000,0000,0000,,Мен оны тез жедім!
Dialogue: 0,0:22:27.75,0:22:29.39,Default,,0000,0000,0000,,О, мен көмектесе алмаймын.
Dialogue: 0,0:22:27.75,0:22:29.39,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:22:27.75,0:22:29.39,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:22:27.75,0:22:29.39,Default,,0000,0000,0000,,Тез, тез…
Dialogue: 0,0:22:29.39,0:22:31.33,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:22:29.39,0:22:31.33,Default,,0000,0000,0000,,Әйтеуір, сәл ертерек.
Dialogue: 0,0:22:29.39,0:22:31.33,Rubi,,0000,0000,0000,,Сара
Dialogue: 0,0:22:29.39,0:22:31.33,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:22:29.39,0:22:31.33,Default,,0000,0000,0000,,Маған табақ әкел.
Dialogue: 0,0:22:31.33,0:22:33.89,Default,,0000,0000,0000,,Уау, мен жасадым!
Dialogue: 0,0:22:31.33,0:22:33.89,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:22:33.89,0:22:36.40,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:22:33.89,0:22:36.40,Default,,0000,0000,0000,,Увааах! Уф!
Dialogue: 0,0:22:36.40,0:22:37.90,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:22:36.40,0:22:37.90,Default,,0000,0000,0000,,Мен ұмытып қалдым...
Dialogue: 0,0:22:37.90,0:22:39.83,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:22:37.90,0:22:39.83,Default,,0000,0000,0000,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:22:39.83,0:22:41.40,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:22:39.83,0:22:41.40,Default,,0000,0000,0000,,Күріш пісіру...
Dialogue: 0,0:22:41.40,0:22:43.90,Default,,0000,0000,0000,,Иә! Болды...
Dialogue: 0,0:22:43.90,0:22:45.84,Default,,0000,0000,0000,,Күріш жоқ
Dialogue: 0,0:22:43.90,0:22:45.84,Default,,0000,0000,0000,,Карри мен күріш?
Dialogue: 0,0:22:45.84,0:22:49.78,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:22:45.84,0:22:49.78,Default,,0000,0000,0000,,Кілегей қоспаңыз
Dialogue: 0,0:22:45.84,0:22:49.78,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:22:45.84,0:22:49.78,Default,,0000,0000,0000,,Оның кофеден айырмашылығы.
Dialogue: 0,0:22:49.78,0:22:52.41,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:22:49.78,0:22:52.41,Rubi,,0000,0000,0000,,Сабыр
Dialogue: 0,0:22:49.78,0:22:52.41,Default,,0000,0000,0000,,Тамақ болмаса да шыдаймын.
Dialogue: 0,0:22:52.41,0:22:54.35,Rubi,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:22:52.41,0:22:54.35,Rubi,,0000,0000,0000,,Хара
Dialogue: 0,0:22:52.41,0:22:54.35,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:22:52.41,0:22:54.35,Default,,0000,0000,0000,,Асқазанды арқаға ауыстыра алмайсыз.
Dialogue: 0,0:22:54.35,0:22:56.92,Rubi,,0000,0000,0000,,Сентаку
Dialogue: 0,0:22:54.35,0:22:56.92,Rubi,,0000,0000,0000,,Балақай
Dialogue: 0,0:22:54.35,0:22:56.92,Default,,0000,0000,0000,,<Басқа таңдау жоқ>
Dialogue: 0,0:22:56.92,0:22:59.92,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:22:56.92,0:22:59.92,Default,,0000,0000,0000,,Иә? Бұл жаман
Dialogue: 0,0:22:56.92,0:22:59.92,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:22:56.92,0:22:59.92,Default,,0000,0000,0000,,《Жаман...》
Dialogue: 0,0:23:02.42,0:23:04.42,Default,,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:23:07.29,0:23:09.30,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:23:07.29,0:23:09.30,Default,,0000,0000,0000,,Сулы.
Dialogue: 0,0:23:09.30,0:23:11.93,Default,,0000,0000,0000,,Осыған ұқсас нәрсе
Dialogue: 0,0:23:09.30,0:23:11.93,Default,,0000,0000,0000,,Бұл карри мен күріш емес.
Dialogue: 0,0:23:11.93,0:23:13.87,Rubi,,0000,0000,0000,,Цуку
Dialogue: 0,0:23:11.93,0:23:13.87,Default,,0000,0000,0000,,Ақыр соңында, мен оны орындадым!
Dialogue: 0,0:23:13.87,0:23:15.37,Default,,0000,0000,0000,,Өйткені...
Dialogue: 0,0:23:17.80,0:23:19.44,Default,,0000,0000,0000,,《Уф, тұзды...
Dialogue: 0,0:23:19.44,0:23:21.38,Default,,0000,0000,0000,,Бұл карри мен күріш.
Dialogue: 0,0:23:19.44,0:23:21.38,Default,,0000,0000,0000,,Бұл өтірік》
Dialogue: 0,0:23:21.38,0:23:24.31,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:23:21.38,0:23:24.31,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:23:21.38,0:23:24.31,Default,,0000,0000,0000,,Дәмі жақсы, солай ма?
Dialogue: 0,0:23:24.31,0:23:26.95,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:23:24.31,0:23:26.95,Default,,0000,0000,0000,,Бұл қалай дәмді?
Dialogue: 0,0:23:26.95,0:23:28.88,Default,,0000,0000,0000,,Әй, болмасаң, эй.
Dialogue: 0,0:23:28.88,0:23:30.82,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:28.88,0:23:30.82,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:23:28.88,0:23:30.82,Default,,0000,0000,0000,,Бұл менің анам!
Dialogue: 0,0:23:30.82,0:23:32.45,Rubi,,0000,0000,0000,,Он
Dialogue: 0,0:23:30.82,0:23:32.45,Rubi,,0000,0000,0000,,Келу
Dialogue: 0,0:23:30.82,0:23:32.45,Default,,0000,0000,0000,,《Аспаннан келген көмек! 》
Dialogue: 0,0:23:32.45,0:23:34.96,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:23:32.45,0:23:34.96,Default,,0000,0000,0000,,Мен көптен күттім.
Dialogue: 0,0:23:32.45,0:23:34.96,Default,,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:23:34.96,0:23:37.86,Default,,0000,0000,0000,,О, құдай!
Dialogue: 0,0:23:34.96,0:23:37.86,Rubi,,0000,0000,0000,,Футабая
Dialogue: 0,0:23:34.96,0:23:37.86,Rubi,,0000,0000,0000,,Жеңіл
Dialogue: 0,0:23:34.96,0:23:37.86,Default,,0000,0000,0000,,Футаба-сан, сен жабылдың ба?
Dialogue: 0,0:23:37.86,0:23:40.83,Rubi,,0000,0000,0000,,Хиру
Dialogue: 0,0:23:37.86,0:23:40.83,Default,,0000,0000,0000,,Сонымен түскі ас ше?
Dialogue: 0,0:23:37.86,0:23:40.83,Default,,0000,0000,0000,,Әлі емес пе?
Dialogue: 0,0:23:40.83,0:23:43.96,Default,,0000,0000,0000,,Рас, солай ма?
Dialogue: 0,0:23:40.83,0:23:43.96,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:23:40.83,0:23:43.96,Default,,0000,0000,0000,,Иә, бұл кәдесый.
Dialogue: 0,0:23:43.96,0:23:48.46,Default,,0000,0000,0000,,Уау Уау
Dialogue: 0,0:23:43.96,0:23:48.46,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:23:43.96,0:23:48.46,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:23:43.96,0:23:48.46,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:23:43.96,0:23:48.46,Default,,0000,0000,0000,,Сенің анаңның кәдесыйы қандай?
Dialogue: 0,0:23:50.47,0:23:54.34,Default,,0000,0000,0000,,Уау, торт!
Dialogue: 0,0:23:50.47,0:23:54.34,Default,,0000,0000,0000,,Дәмді!
Dialogue: 0,0:23:54.34,0:23:56.34,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:23:54.34,0:23:56.34,Default,,0000,0000,0000,,Маруко, карри мен күріш ше?
Dialogue: 0,0:23:56.34,0:23:58.98,Default,,0000,0000,0000,,Жарайды, қазір.
Dialogue: 0,0:23:56.34,0:23:58.98,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:23:56.34,0:23:58.98,Default,,0000,0000,0000,,Сіздің әпкеңіз кім?
Dialogue: 0,0:23:58.98,0:24:02.48,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:23:58.98,0:24:02.48,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:23:58.98,0:24:02.48,Default,,0000,0000,0000,,«Анам маған торт сатып алмайды».
Dialogue: 0,0:23:58.98,0:24:02.48,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:23:58.98,0:24:02.48,Default,,0000,0000,0000,,Сіз не айтып тұрсыз?
Dialogue: 0,0:24:02.48,0:24:04.48,Default,,0000,0000,0000,,Хехе, жақсы.
Dialogue: 0,0:24:06.35,0:24:07.99,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:06.35,0:24:07.99,Default,,0000,0000,0000,,Маруконың идиоты
Dialogue: 0,0:24:07.99,0:24:11.49,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:24:07.99,0:24:11.49,Default,,0000,0000,0000,,Ауырды
Dialogue: 0,0:24:11.49,0:24:12.99,Rubi,,0000,0000,0000,,Гокюу
Dialogue: 0,0:24:11.49,0:24:12.99,Default,,0000,0000,0000,,(жылау)
Dialogue: 0,0:24:12.99,0:24:14.49,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:24:14.49,0:24:18.00,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:24:14.49,0:24:18.00,Rubi,,0000,0000,0000,,Цуку
Dialogue: 0,0:24:14.49,0:24:18.00,Default,,0000,0000,0000,,Себебі карриді апам жасады.
Dialogue: 0,0:24:14.49,0:24:18.00,Default,,0000,0000,0000,,Бұл жаман!
Dialogue: 0,0:24:18.00,0:24:21.44,Default,,0000,0000,0000,,О, құдай!
Dialogue: 0,0:24:18.00,0:24:21.44,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:18.00,0:24:21.44,Default,,0000,0000,0000,,Маруко жақсы емес.
Dialogue: 0,0:24:21.44,0:24:22.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:24:22.94,0:24:25.84,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:24:22.94,0:24:25.84,Rubi,,0000,0000,0000,,Исшо Кенмей
Dialogue: 0,0:24:22.94,0:24:25.84,Default,,0000,0000,0000,,Әпке, еңбектеніңіз
Dialogue: 0,0:24:22.94,0:24:25.84,Rubi,,0000,0000,0000,,Цуку
Dialogue: 0,0:24:22.94,0:24:25.84,Default,,0000,0000,0000,,Себебі мен оны жасадым
Dialogue: 0,0:24:25.84,0:24:27.81,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:25.84,0:24:27.81,Default,,0000,0000,0000,,Маруко үшін
Dialogue: 0,0:24:25.84,0:24:27.81,Default,,0000,0000,0000,,Иә, жақсы...
Dialogue: 0,0:24:27.81,0:24:31.81,Rubi,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:24:27.81,0:24:31.81,Default,,0000,0000,0000,,Мен көп нәрсені артқа тастадым.
Dialogue: 0,0:24:27.81,0:24:31.81,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:24:27.81,0:24:31.81,Rubi,,0000,0000,0000,,Тістеу
Dialogue: 0,0:24:27.81,0:24:31.81,Default,,0000,0000,0000,,Анам тістеп алады
Dialogue: 0,0:24:32.95,0:24:33.91,Default,,0000,0000,0000,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:24:33.91,0:24:35.85,Rubi,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:24:33.91,0:24:35.85,Rubi,,0000,0000,0000,,Тістеу
Dialogue: 0,0:24:33.91,0:24:35.85,Default,,0000,0000,0000,,<Бір тістегеннен кейін шынымен де тоқтадым>
Dialogue: 0,0:24:35.85,0:24:39.35,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:35.85,0:24:39.35,Default,,0000,0000,0000,,Маруко қазірдің өзінде
Dialogue: 0,0:24:35.85,0:24:39.35,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:24:41.96,0:24:43.96,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:24:41.96,0:24:43.96,Default,,0000,0000,0000,,Уф, бұл не...
Dialogue: 0,0:24:44.86,0:24:46.36,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:24:44.86,0:24:46.36,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:24:47.46,0:24:50.36,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:24:47.46,0:24:50.36,Default,,0000,0000,0000,,Карри мен күріш үшін рахмет
Dialogue: 0,0:24:50.36,0:24:52.33,Default,,0000,0000,0000,,Бірақ бәрібір
Dialogue: 0,0:24:50.36,0:24:52.33,Default,,0000,0000,0000,,Бұл жаман болды.
Dialogue: 0,0:24:52.33,0:24:54.33,Default,,0000,0000,0000,,Жаман болды...
Dialogue: 0,0:24:52.33,0:24:54.33,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:52.33,0:24:54.33,Default,,0000,0000,0000,,Аха…
Dialogue: 0,0:24:54.33,0:24:56.97,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:24:54.33,0:24:56.97,Default,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:24:54.33,0:24:56.97,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:54.33,0:24:56.97,Default,,0000,0000,0000,,Қайтадан қош келдіңіз
Dialogue: 0,0:24:56.97,0:24:58.47,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:24:56.97,0:24:58.47,Default,,0000,0000,0000,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:24:56.97,0:24:58.47,Rubi,,0000,0000,0000,,Келгеніңе қуаныштымын.
Dialogue: 0,0:24:56.97,0:24:58.47,Default,,0000,0000,0000,,Жақсы иіс шығады.
Dialogue: 0,0:24:58.47,0:25:00.97,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:24:58.47,0:25:00.97,Default,,0000,0000,0000,,Менің әпкем
Dialogue: 0,0:24:58.47,0:25:00.97,Rubi,,0000,0000,0000,,Цуку
Dialogue: 0,0:24:58.47,0:25:00.97,Default,,0000,0000,0000,,Мен карри мен күріш жасадым.
Dialogue: 0,0:25:00.97,0:25:02.91,Rubi,,0000,0000,0000,,Толық
Dialogue: 0,0:25:00.97,0:25:02.91,Default,,0000,0000,0000,,Бірақ мен сәтсіздікке ұшырадым.
Dialogue: 0,0:25:02.91,0:25:05.85,Rubi,,0000,0000,0000,,Толық
Dialogue: 0,0:25:02.91,0:25:05.85,Default,,0000,0000,0000,,Сәтсіздік?
Dialogue: 0,0:25:02.91,0:25:05.85,Rubi,,0000,0000,0000,,Келгеніңе қуаныштымын.
Dialogue: 0,0:25:02.91,0:25:05.85,Default,,0000,0000,0000,,Бірақ оның иісі жақсы.
Dialogue: 0,0:25:05.85,0:25:08.85,Rubi,,0000,0000,0000,,Тоқаш
Dialogue: 0,0:25:05.85,0:25:08.85,Default,,0000,0000,0000,,Атаға да бірдеңе бар, солай ма?
Dialogue: 0,0:25:05.85,0:25:08.85,Default,,0000,0000,0000,,Иә, бірақ...
Dialogue: 0,0:25:08.85,0:25:12.49,Default,,0000,0000,0000,,Ата
Dialogue: 0,0:25:08.85,0:25:12.49,Default,,0000,0000,0000,,Тоқтау керек, эй.
Dialogue: 0,0:25:12.49,0:25:13.45,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:25:13.45,0:25:16.36,Rubi,,0000,0000,0000,,Жақсы
Dialogue: 0,0:25:13.45,0:25:16.36,Default,,0000,0000,0000,,Оны дайындаңыз.
Dialogue: 0,0:25:13.45,0:25:16.36,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:25:13.45,0:25:16.36,Default,,0000,0000,0000,,Өйткені мен оны жеймін.
Dialogue: 0,0:25:16.36,0:25:18.36,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:25:16.36,0:25:18.36,Default,,0000,0000,0000,,Бізде кәдесыйлар да бар
Dialogue: 0,0:25:19.29,0:25:22.30,Default,,0000,0000,0000,,Әлгі қарт
Dialogue: 0,0:25:19.29,0:25:22.30,Rubi,,0000,0000,0000,,Дзётаро
Dialogue: 0,0:25:19.29,0:25:22.30,Default,,0000,0000,0000,,Өзіңізді қатты итермеңіз.
Dialogue: 0,0:25:22.30,0:25:23.80,Default,,0000,0000,0000,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:25:26.93,0:25:28.44,Default,,0000,0000,0000,,Ах~
Dialogue: 0,0:25:28.44,0:25:30.94,Default,,0000,0000,0000,,А, міне, солай.
Dialogue: 0,0:25:28.44,0:25:30.94,Default,,0000,0000,0000,,Бұл дәмді карри мен күріш.
Dialogue: 0,0:25:30.94,0:25:32.44,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:25:30.94,0:25:32.44,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:25:32.44,0:25:34.44,Default,,0000,0000,0000,,Хмм иә иә
Dialogue: 0,0:25:39.31,0:25:42.95,Default,,0000,0000,0000,,Бұл шынымен жақсы карри мен күріш.
Dialogue: 0,0:25:39.31,0:25:42.95,Default,,0000,0000,0000,,Дәмді Дәмді
Dialogue: 0,0:25:42.95,0:25:46.45,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:25:42.95,0:25:46.45,Default,,0000,0000,0000,,Жоқ, әпке.
Dialogue: 0,0:25:42.95,0:25:46.45,Rubi,,0000,0000,0000,,Білім
Dialogue: 0,0:25:42.95,0:25:46.45,Default,,0000,0000,0000,,Сіз мұны өте жақсы білесіз.
Dialogue: 0,0:25:46.45,0:25:50.96,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:25:46.45,0:25:50.96,Rubi,,0000,0000,0000,,Онсен Риоко
Dialogue: 0,0:25:46.45,0:25:50.96,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:25:46.45,0:25:50.96,Default,,0000,0000,0000,,<Сол күні ыстық бұлақ саяхатынан естелік
Dialogue: 0,0:25:46.45,0:25:50.96,Rubi,,0000,0000,0000,,Маго
Dialogue: 0,0:25:46.45,0:25:50.96,Rubi,,0000,0000,0000,,Фалко!!
Dialogue: 0,0:25:46.45,0:25:50.96,Default,,0000,0000,0000,,Мару-чан немеремнің қолы
Dialogue: 0,0:25:50.96,0:25:53.96,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:25:50.96,0:25:53.96,Default,,0000,0000,0000,,Менің әпкем
Dialogue: 0,0:25:50.96,0:25:53.96,Rubi,,0000,0000,0000,,Онсен
Dialogue: 0,0:25:50.96,0:25:53.96,Default,,0000,0000,0000,,Бұл ыстық бұлақ вымпелі болды＞
Dialogue: 0,0:26:39.94,0:26:42.44,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:26:39.94,0:26:42.44,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:26:39.94,0:26:42.44,Rubi,,0000,0000,0000,,Сенкио
Dialogue: 0,0:26:39.94,0:26:42.44,Default,,0000,0000,0000,,Келесі жолы сынып өкіліне сайлау болады.
Dialogue: 0,0:26:42.44,0:26:45.35,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:26:42.44,0:26:45.35,Default,,0000,0000,0000,,Тіпті Маруко
Dialogue: 0,0:26:42.44,0:26:45.35,Rubi,,0000,0000,0000,,Нарғызгүл
Dialogue: 0,0:26:42.44,0:26:45.35,Default,,0000,0000,0000,,Мен ұсынылады.
Dialogue: 0,0:26:45.35,0:26:47.88,Default,,0000,0000,0000,,Егер бұл орын алса, мен не істеуім керек?
Dialogue: 0,0:26:47.88,0:26:50.88,Rubi,,0000,0000,0000,,Айнала
Dialogue: 0,0:26:47.88,0:26:50.88,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:26:47.88,0:26:50.88,Default,,0000,0000,0000,,Келесі «Чиби Маруко-чан»...
Dialogue: 0,0:26:58.39,0:27:11.89,Default,,0000,0000,0000,,Сен
