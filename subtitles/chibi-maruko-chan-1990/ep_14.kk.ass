Dialogue: 0,0:16:01.47,0:16:05.97,Rubi,,0000,0000,0000,,Екі адам
Dialogue: 0,0:16:01.47,0:16:05.97,Default,,0000,0000,0000,,《Екеуіңде жақсы ма?
Dialogue: 0,0:16:01.47,0:16:05.97,Rubi,,0000,0000,0000,,Русубан
Dialogue: 0,0:16:01.47,0:16:05.97,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:16:01.47,0:16:05.97,Default,,0000,0000,0000,,Мен сенен үйде қалуыңды өтіндім.
Dialogue: 0,0:16:05.97,0:16:08.48,Rubi,,0000,0000,0000,,Хиру
Dialogue: 0,0:16:05.97,0:16:08.48,Rubi,,0000,0000,0000,,Футабая
Dialogue: 0,0:16:05.97,0:16:08.48,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:16:05.97,0:16:08.48,Default,,0000,0000,0000,,Футабаяда түскі ас ішіңіз.》
Dialogue: 0,0:16:05.97,0:16:08.48,Default,,0000,0000,0000,,Жоқ, ол емес. Жасырынған орын. Жасырынған орын ба?
Dialogue: 0,0:16:08.48,0:16:11.38,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:16:08.48,0:16:11.38,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:16:08.48,0:16:11.38,Default,,0000,0000,0000,,《Өрттен абай бол
Dialogue: 0,0:16:08.48,0:16:11.38,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:16:08.48,0:16:11.38,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:16:08.48,0:16:11.38,Default,,0000,0000,0000,,Мен мүмкіндігінше тезірек ораламын》
Dialogue: 0,0:16:11.38,0:16:13.35,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:16:11.38,0:16:13.35,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:16:11.38,0:16:13.35,Default,,0000,0000,0000,,《Маған кәдесый сатып алшы》
Dialogue: 0,0:16:13.35,0:16:15.35,Default,,0000,0000,0000,,《Иә, иә》
Dialogue: 0,0:16:16.98,0:16:19.42,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:16:16.98,0:16:19.42,Default,,0000,0000,0000,,Хе, анашым
Dialogue: 0,0:16:16.98,0:16:19.42,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:16:16.98,0:16:19.42,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:16:16.98,0:16:19.42,Default,,0000,0000,0000,,Маған не сатып алуға болады?
Dialogue: 0,0:16:19.42,0:16:22.32,Default,,0000,0000,0000,,Бұл ірімшік пе?
Dialogue: 0,0:16:19.42,0:16:22.32,Default,,0000,0000,0000,,Немесе печенье болуы мүмкін бе?
Dialogue: 0,0:16:22.32,0:16:24.93,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:16:22.32,0:16:24.93,Default,,0000,0000,0000,,Бар болғаны тамақ ішу
Dialogue: 0,0:16:24.93,0:16:26.86,Rubi,,0000,0000,0000,,Ekimae
Dialogue: 0,0:16:24.93,0:16:26.86,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:16:24.93,0:16:26.86,Default,,0000,0000,0000,,Мен оны вокзалдың алдынан сатып алғаныма сенімдімін.
Dialogue: 0,0:16:24.93,0:16:26.86,Rubi,,0000,0000,0000,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:16:24.93,0:16:26.86,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:16:24.93,0:16:26.86,Default,,0000,0000,0000,,Тайяки немесе бір нәрсе ме?
Dialogue: 0,0:16:26.86,0:16:28.43,Default,,0000,0000,0000,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:16:26.86,0:16:28.43,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:16:26.86,0:16:28.43,Default,,0000,0000,0000,,Бұл шешілді, солай ма?
Dialogue: 0,0:16:28.43,0:16:30.93,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:16:28.43,0:16:30.93,Default,,0000,0000,0000,,Мен саудаласуға бардым.
Dialogue: 0,0:16:30.93,0:16:32.87,Rubi,,0000,0000,0000,,Орын
Dialogue: 0,0:16:30.93,0:16:32.87,Default,,0000,0000,0000,,Менің жүгім толы.
Dialogue: 0,0:16:32.87,0:16:35.80,Rubi,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:16:32.87,0:16:35.80,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:16:32.87,0:16:35.80,Default,,0000,0000,0000,,(дауыс ырғағын өзгерту)
Dialogue: 0,0:16:32.87,0:16:35.80,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:16:32.87,0:16:35.80,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:16:32.87,0:16:35.80,Rubi,,0000,0000,0000,,Ақаулық
Dialogue: 0,0:16:32.87,0:16:35.80,Default,,0000,0000,0000,,«Кәдесый таңдау азап.
Dialogue: 0,0:16:32.87,0:16:35.80,Default,,0000,0000,0000,,Торт көлемді
Dialogue: 0,0:16:35.80,0:16:38.81,Rubi,,0000,0000,0000,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:16:35.80,0:16:38.81,Default,,0000,0000,0000,,Ей, оны тайяки жасайық! »
Dialogue: 0,0:16:38.81,0:16:41.44,Default,,0000,0000,0000,,Мен сенімдімін
Dialogue: 0,0:16:41.44,0:16:45.95,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:16:41.44,0:16:45.95,Rubi,,0000,0000,0000,,Русубан
Dialogue: 0,0:16:41.44,0:16:45.95,Default,,0000,0000,0000,,Ей, сен неге үйде отырсың?
Dialogue: 0,0:16:41.44,0:16:45.95,Default,,0000,0000,0000,,Түсінбедім, тексеріңіз!
Dialogue: 0,0:16:45.95,0:16:49.45,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:16:45.95,0:16:49.45,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:16:45.95,0:16:49.45,Default,,0000,0000,0000,,<Ештеңе бекер емес
Dialogue: 0,0:16:45.95,0:16:49.45,Rubi,,0000,0000,0000,,Русубан
Dialogue: 0,0:16:45.95,0:16:49.45,Rubi,,0000,0000,0000,,Russ
Dialogue: 0,0:16:45.95,0:16:49.45,Rubi,,0000,0000,0000,,Жарылыс
Dialogue: 0,0:16:45.95,0:16:49.45,Default,,0000,0000,0000,,Үйде отыру – «үйдегі адам»＞
Dialogue: 0,0:16:49.45,0:16:50.42,Default,,0000,0000,0000,,Олай болса.
Dialogue: 0,0:16:50.42,0:16:53.32,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:16:50.42,0:16:53.32,Default,,0000,0000,0000,,Ата мен әжеге кәдесый ретінде
Dialogue: 0,0:16:50.42,0:16:53.32,Rubi,,0000,0000,0000,,Орын
Dialogue: 0,0:16:50.42,0:16:53.32,Default,,0000,0000,0000,,Үміттенейік
Dialogue: 0,0:16:53.32,0:16:56.32,Rubi,,0000,0000,0000,,Кеше
Dialogue: 0,0:16:53.32,0:16:56.32,Default,,0000,0000,0000,,<Кеше аталар
Dialogue: 0,0:16:53.32,0:16:56.32,Rubi,,0000,0000,0000,,Маған біраз уақыт бере аласыз ба?
Dialogue: 0,0:16:53.32,0:16:56.32,Rubi,,0000,0000,0000,,Риоко
Dialogue: 0,0:16:53.32,0:16:56.32,Default,,0000,0000,0000,,Көршілес бірлестігінің саяхатында
Dialogue: 0,0:16:56.32,0:16:59.46,Rubi,,0000,0000,0000,,Онсен
Dialogue: 0,0:16:56.32,0:16:59.46,Rubi,,0000,0000,0000,,Иппаку Риоко
Dialogue: 0,0:16:56.32,0:16:59.46,Default,,0000,0000,0000,,Түнгі саяхатқа арналған ыстық бұлақтар
Dialogue: 0,0:16:56.32,0:16:59.46,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:16:56.32,0:16:59.46,Default,,0000,0000,0000,,Мен шықтым>
Dialogue: 0,0:16:59.46,0:17:01.96,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:16:59.46,0:17:01.96,Default,,0000,0000,0000,,《Сувенир! 》
Dialogue: 0,0:17:01.96,0:17:03.90,Default,,0000,0000,0000,,Хаа…
Dialogue: 0,0:17:01.96,0:17:03.90,Rubi,,0000,0000,0000,,Онсен
Dialogue: 0,0:17:01.96,0:17:03.90,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:17:01.96,0:17:03.90,Default,,0000,0000,0000,,Өйткені мен ыстық бұлаққа бардым
Dialogue: 0,0:17:03.90,0:17:06.47,Rubi,,0000,0000,0000,,Онсен
Dialogue: 0,0:17:03.90,0:17:06.47,Default,,0000,0000,0000,,Ыстық бумен пісірілген тоқаш болуы керек.
Dialogue: 0,0:17:03.90,0:17:06.47,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:17:03.90,0:17:06.47,Default,,0000,0000,0000,,Бір нәрсе
Dialogue: 0,0:17:06.47,0:17:08.40,Rubi,,0000,0000,0000,,Онсен
Dialogue: 0,0:17:06.47,0:17:08.40,Default,,0000,0000,0000,,Неліктен ыстық көктемгі торт?
Dialogue: 0,0:17:08.40,0:17:10.34,Rubi,,0000,0000,0000,,Онсен
Dialogue: 0,0:17:08.40,0:17:10.34,Default,,0000,0000,0000,,Ыстық көктемгі печенье ше?
Dialogue: 0,0:17:08.40,0:17:10.34,Default,,0000,0000,0000,,Мүмкін емес пе?
Dialogue: 0,0:17:10.34,0:17:12.34,Default,,0000,0000,0000,,Жақсы, тіпті егер
Dialogue: 0,0:17:10.34,0:17:12.34,Rubi,,0000,0000,0000,,Екі адам
Dialogue: 0,0:17:10.34,0:17:12.34,Rubi,,0000,0000,0000,,Дзётаро
Dialogue: 0,0:17:10.34,0:17:12.34,Default,,0000,0000,0000,,Менің ойымша, бұл екі адаммен бұл мүмкін емес.
Dialogue: 0,0:17:12.34,0:17:14.98,Default,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:17:12.34,0:17:14.98,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:17:12.34,0:17:14.98,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:17:12.34,0:17:14.98,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:17:12.34,0:17:14.98,Default,,0000,0000,0000,,Бұл тамақ емес деп ойлаймын.
Dialogue: 0,0:17:14.98,0:17:16.91,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:17:14.98,0:17:16.91,Rubi,,0000,0000,0000,,Кибо
Dialogue: 0,0:17:14.98,0:17:16.91,Rubi,,0000,0000,0000,,Ningyou
Dialogue: 0,0:17:14.98,0:17:16.91,Default,,0000,0000,0000,,Ағаш қуыршақтар т.б.
Dialogue: 0,0:17:16.91,0:17:19.41,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:17:16.91,0:17:19.41,Rubi,,0000,0000,0000,,Окимоно
Dialogue: 0,0:17:16.91,0:17:19.41,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:17:16.91,0:17:19.41,Default,,0000,0000,0000,,Мен кішкентай мүсінше сатып алайын деп жатырмын.
Dialogue: 0,0:17:16.91,0:17:19.41,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:17:16.91,0:17:19.41,Default,,0000,0000,0000,,Мен сені жақсы көремін
Dialogue: 0,0:17:19.41,0:17:22.32,Rubi,,0000,0000,0000,,Бөтелке
Dialogue: 0,0:17:19.41,0:17:22.32,Default,,0000,0000,0000,,<Кедей болса
Dialogue: 0,0:17:19.41,0:17:22.32,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:17:19.41,0:17:22.32,Default,,0000,0000,0000,,Осы сияқты нәрселерге толы＞
Dialogue: 0,0:17:22.32,0:17:24.29,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:22.32,0:17:24.29,Default,,0000,0000,0000,,Ал ата
Dialogue: 0,0:17:24.29,0:17:26.92,Rubi,,0000,0000,0000,,Тауық
Dialogue: 0,0:17:24.29,0:17:26.92,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:17:24.29,0:17:26.92,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:17:24.29,0:17:26.92,Default,,0000,0000,0000,,Мен оның біртүрлі нәрсе сатып алатынына сенімдімін.
Dialogue: 0,0:17:26.92,0:17:29.82,Default,,0000,0000,0000,,Бір күні
Dialogue: 0,0:17:26.92,0:17:29.82,Rubi,,0000,0000,0000,,О
Dialogue: 0,0:17:26.92,0:17:29.82,Rubi,,0000,0000,0000,,Қарындаш
Dialogue: 0,0:17:26.92,0:17:29.82,Default,,0000,0000,0000,,Осындай үлкен қарындаш
Dialogue: 0,0:17:29.82,0:17:30.79,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:17:30.79,0:17:33.43,Default,,0000,0000,0000,,Мен оны алған кезде
Dialogue: 0,0:17:30.79,0:17:33.43,Default,,0000,0000,0000,,Мен қуаныштымын.
Dialogue: 0,0:17:33.43,0:17:35.93,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:17:33.43,0:17:35.93,Default,,0000,0000,0000,,Жазу біраз қиын, солай емес пе?
Dialogue: 0,0:17:37.93,0:17:40.43,Default,,0000,0000,0000,,Сіз оны алған кезде
Dialogue: 0,0:17:37.93,0:17:40.43,Default,,0000,0000,0000,,Сіз бақытты болдыңыз ба?
Dialogue: 0,0:17:40.43,0:17:42.37,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:40.43,0:17:42.37,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:17:42.37,0:17:44.31,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:17:42.37,0:17:44.31,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:17:44.31,0:17:47.94,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:17:44.31,0:17:47.94,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:17:44.31,0:17:47.94,Default,,0000,0000,0000,,Сонымен, кәдесыйлар жоқ па?
Dialogue: 0,0:17:47.94,0:17:49.88,Default,,0000,0000,0000,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,0:17:47.94,0:17:49.88,Rubi,,0000,0000,0000,,Хиру
Dialogue: 0,0:17:47.94,0:17:49.88,Default,,0000,0000,0000,,Кем дегенде түскі ас
Dialogue: 0,0:17:49.88,0:17:51.81,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:17:49.88,0:17:51.81,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:17:49.88,0:17:51.81,Default,,0000,0000,0000,,Өзіңізге ұнайтын нәрсені жеңіз.
Dialogue: 0,0:17:49.88,0:17:51.81,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:17:51.81,0:17:53.81,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:17:51.81,0:17:53.81,Default,,0000,0000,0000,,Әй, әпке
Dialogue: 0,0:17:51.81,0:17:53.81,Rubi,,0000,0000,0000,,Хиру
Dialogue: 0,0:17:51.81,0:17:53.81,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:17:51.81,0:17:53.81,Default,,0000,0000,0000,,Түскі асқа не жеу керек?
Dialogue: 0,0:17:53.81,0:17:56.81,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:53.81,0:17:56.81,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:17:53.81,0:17:56.81,Default,,0000,0000,0000,,Аа, осыншама ұзақ болды ма?
Dialogue: 0,0:17:58.45,0:18:00.39,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:17:58.45,0:18:00.39,Default,,0000,0000,0000,,Ал, біз не істеуіміз керек?
Dialogue: 0,0:18:00.39,0:18:02.96,Default,,0000,0000,0000,,Осымен
Dialogue: 0,0:18:00.39,0:18:02.96,Rubi,,0000,0000,0000,,Қақпақ
Dialogue: 0,0:18:00.39,0:18:02.96,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:18:00.39,0:18:02.96,Default,,0000,0000,0000,,Мен екі нәрсені ғана сұраймын.
Dialogue: 0,0:18:02.96,0:18:05.86,Default,,0000,0000,0000,,Мен оны «зару соба» деп атайды деп ойламаппын
Dialogue: 0,0:18:02.96,0:18:05.86,Rubi,,0000,0000,0000,,Сенпо
Dialogue: 0,0:18:02.96,0:18:05.86,Rubi,,0000,0000,0000,,Шицурей
