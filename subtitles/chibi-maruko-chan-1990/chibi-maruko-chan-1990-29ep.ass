Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.90,0:01:15.40,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:13.30,0:03:14.93,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:13.30,0:03:14.93,Default,,0000,0000,0000,,Мен үйдемін~
Dialogue: 0,0:03:14.93,0:03:15.90,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:03:14.93,0:03:15.90,Rubi,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:03:14.93,0:03:15.90,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:03:14.93,0:03:15.90,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:03:14.93,0:03:15.90,Default,,0000,0000,0000,,()
Dialogue: 0,0:03:14.93,0:03:15.90,Default,,0000,0000,0000,,Иә Иә
Dialogue: 0,0:03:15.90,0:03:18.80,Rubi,,0000,0000,0000,,Теріс
Dialogue: 0,0:03:15.90,0:03:18.80,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:03:18.80,0:03:21.81,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:03:18.80,0:03:21.81,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:18.80,0:03:21.81,Default,,0000,0000,0000,,Қош келдіңіз, Маруко
Dialogue: 0,0:03:21.81,0:03:24.74,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:03:21.81,0:03:24.74,Rubi,,0000,0000,0000,,Ванна
Dialogue: 0,0:03:21.81,0:03:24.74,Default,,0000,0000,0000,,Бүгіннен бастап біраз уақытқа менің ваннам
Dialogue: 0,0:03:21.81,0:03:24.74,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:03:21.81,0:03:24.74,Default,,0000,0000,0000,,Өйткені мен енді кіре алмаймын.
Dialogue: 0,0:03:24.74,0:03:25.88,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:25.88,0:03:28.38,Rubi,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:03:25.88,0:03:28.38,Rubi,,0000,0000,0000,,Ванна
Dialogue: 0,0:03:25.88,0:03:28.38,Default,,0000,0000,0000,,Монша бұзылды.
Dialogue: 0,0:03:28.38,0:03:33.89,Default,,0000,0000,0000,,Ал... онда біз
Dialogue: 0,0:03:28.38,0:03:33.89,Rubi,,0000,0000,0000,,Ванна
Dialogue: 0,0:03:28.38,0:03:33.89,Rubi,,0000,0000,0000,,Сейкацу
Dialogue: 0,0:03:28.38,0:03:33.89,Default,,0000,0000,0000,,Ваннасыз өмір сүру
Dialogue: 0,0:03:33.89,0:03:37.76,Rubi,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:03:33.89,0:03:37.76,Default,,0000,0000,0000,,(Шыбындардың дыбысы)
Dialogue: 0,0:03:33.89,0:03:37.76,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:03:33.89,0:03:37.76,Rubi,,0000,0000,0000,,Гецу
Dialogue: 0,0:03:33.89,0:03:37.76,Default,,0000,0000,0000,,《Бүгін бір ай...》
Dialogue: 0,0:03:37.76,0:03:41.39,Rubi,,0000,0000,0000,,Сенто
Dialogue: 0,0:03:37.76,0:03:41.39,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:37.76,0:03:41.39,Default,,0000,0000,0000,,Ақымақ, моншаға бар.
Dialogue: 0,0:03:37.76,0:03:41.39,Default,,0000,0000,0000,,Сенто?
Dialogue: 0,0:03:41.39,0:03:45.90,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:41.39,0:03:45.90,Rubi,,0000,0000,0000,,Сенто
Dialogue: 0,0:03:41.39,0:03:45.90,Default,,0000,0000,0000,,Ах, аха, Маруко қоғамдық моншада
Dialogue: 0,0:03:41.39,0:03:45.90,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:41.39,0:03:45.90,Default,,0000,0000,0000,,Менің ойымша, сіз ол жерде ешқашан болған емессіз.
Dialogue: 0,0:03:45.90,0:03:47.40,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:03:47.40,0:03:49.33,Rubi,,0000,0000,0000,,Фуроя
Dialogue: 0,0:03:47.40,0:03:49.33,Default,,0000,0000,0000,,Монша дүкені
Dialogue: 0,0:03:49.33,0:03:53.91,Rubi,,0000,0000,0000,,О
Dialogue: 0,0:03:49.33,0:03:53.91,Rubi,,0000,0000,0000,,Юбуне
Dialogue: 0,0:03:49.33,0:03:53.91,Default,,0000,0000,0000,,Үлкен ванна бар.
Dialogue: 0,0:03:49.33,0:03:53.91,Rubi,,0000,0000,0000,,Кимо
Dialogue: 0,0:03:49.33,0:03:53.91,Default,,0000,0000,0000,,Жақсы сезінеді~
Dialogue: 0,0:03:53.91,0:03:55.84,Default,,0000,0000,0000,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:03:55.84,0:03:58.78,Rubi,,0000,0000,0000,,Музыка
Dialogue: 0,0:03:55.84,0:03:58.78,Default,,0000,0000,0000,, (Аниме музыкасы)
Dialogue: 0,0:03:58.78,0:04:01.41,Default,,0000,0000,0000,,Қырықша… әрине!
Dialogue: 0,0:04:01.41,0:04:03.92,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:01.41,0:04:03.92,Default,,0000,0000,0000,,Маруко
Dialogue: 0,0:04:01.41,0:04:03.92,Rubi,,0000,0000,0000,,Фуроя
Dialogue: 0,0:04:01.41,0:04:03.92,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:01.41,0:04:03.92,Default,,0000,0000,0000,,Мен монша дүкеніне барамын.
Dialogue: 0,0:04:03.92,0:04:06.42,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:04:03.92,0:04:06.42,Rubi,,0000,0000,0000,,Кейінірек
Dialogue: 0,0:04:03.92,0:04:06.42,Default,,0000,0000,0000,,Оны сәл кейінірек жасайық.
Dialogue: 0,0:04:06.42,0:04:07.39,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:04:07.39,0:04:09.32,Rubi,,0000,0000,0000,,Бангими
Dialogue: 0,0:04:07.39,0:04:09.32,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:07.39,0:04:09.32,Default,,0000,0000,0000,,Осы бағдарламаны көргеннен кейін
Dialogue: 0,0:04:09.32,0:04:11.29,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:04:09.32,0:04:11.29,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:09.32,0:04:11.29,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:09.32,0:04:11.29,Default,,0000,0000,0000,,Мына бала, қандай ақымақ айтып тұрсың?
Dialogue: 0,0:04:11.29,0:04:13.29,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:11.29,0:04:13.29,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:04:11.29,0:04:13.29,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:04:11.29,0:04:13.29,Default,,0000,0000,0000,,Бұл қашан аяқталады
Dialogue: 0,0:04:13.29,0:04:16.43,Rubi,,0000,0000,0000,,Фуроя
Dialogue: 0,0:04:13.29,0:04:16.43,Default,,0000,0000,0000,,Ванна дүкені
Dialogue: 0,0:04:13.29,0:04:16.43,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:13.29,0:04:16.43,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:04:13.29,0:04:16.43,Default,,0000,0000,0000,,Бұл ең қарбалас уақыт.
Dialogue: 0,0:04:16.43,0:04:19.93,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:16.43,0:04:19.93,Default,,0000,0000,0000,,Жүр, қазір барайық.
Dialogue: 0,0:04:16.43,0:04:19.93,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:16.43,0:04:19.93,Default,,0000,0000,0000,,Жоқ, мынаны қараңыз~
Dialogue: 0,0:04:19.93,0:04:22.43,Rubi,,0000,0000,0000,,Фуроя
Dialogue: 0,0:04:19.93,0:04:22.43,Default,,0000,0000,0000,,Монша дүкені
Dialogue: 0,0:04:19.93,0:04:22.43,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:19.93,0:04:22.43,Default,,0000,0000,0000,,Сіз адам көп дедіңіз.
Dialogue: 0,0:04:22.43,0:04:24.87,Rubi,,0000,0000,0000,,Манинденша
Dialogue: 0,0:04:22.43,0:04:24.87,Default,,0000,0000,0000,,Толып жатқан пойыз
Dialogue: 0,0:04:22.43,0:04:24.87,Default,,0000,0000,0000,,Ол енді жоқ...
Dialogue: 0,0:04:24.87,0:04:26.81,Rubi,,0000,0000,0000,,Сеттокурёку
Dialogue: 0,0:04:24.87,0:04:26.81,Rubi,,0000,0000,0000,,Ханрон
Dialogue: 0,0:04:24.87,0:04:26.81,Default,,0000,0000,0000,,<Бұл сенімсіз қарсы аргумент>
Dialogue: 0,0:04:26.81,0:04:30.38,Default,,0000,0000,0000,,Жоқ, жоқ!
Dialogue: 0,0:04:26.81,0:04:30.38,Rubi,,0000,0000,0000,,Оуджогива
Dialogue: 0,0:04:26.81,0:04:30.38,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:04:26.81,0:04:30.38,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:26.81,0:04:30.38,Default,,0000,0000,0000,,Өлім алдында тұрған жаман бала.
Dialogue: 0,0:04:30.38,0:04:32.31,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:30.38,0:04:32.31,Default,,0000,0000,0000,,Маған осы теледидарды көру керек
Dialogue: 0,0:04:32.31,0:04:35.88,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:04:32.31,0:04:35.88,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:32.31,0:04:35.88,Default,,0000,0000,0000,,Ертең мектепке бар
Dialogue: 0,0:04:32.31,0:04:35.88,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:04:32.31,0:04:35.88,Default,,0000,0000,0000,,Ол бәрінен шеттетілген.
Dialogue: 0,0:04:35.88,0:04:39.38,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:35.88,0:04:39.38,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:35.88,0:04:39.38,Default,,0000,0000,0000,,Қараңдар, қараңдар.
Dialogue: 0,0:04:35.88,0:04:39.38,Default,,0000,0000,0000,,Тек осы теледидар...
