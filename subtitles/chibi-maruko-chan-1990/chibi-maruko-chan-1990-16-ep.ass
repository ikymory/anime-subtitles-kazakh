Dialogue: 0,0:18:09.37,0:18:12.27,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:18:09.37,0:18:12.27,Default,,0000,0000,0000,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:18:12.27,0:18:14.24,Default,,0000,0000,0000,,О, бұл дұрыс емес.
Dialogue: 0,0:18:14.24,0:18:17.88,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:18:14.24,0:18:17.88,Default,,0000,0000,0000,,Дұрыс, Маруко.
Dialogue: 0,0:18:14.24,0:18:17.88,Rubi,,0000,0000,0000,,Артқа
Dialogue: 0,0:18:14.24,0:18:17.88,Default,,0000,0000,0000,,Тағдырыңды да айт.
Dialogue: 0,0:18:17.88,0:18:21.75,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:18:17.88,0:18:21.75,Default,,0000,0000,0000,,Сіз мұны жиі айтасыз.
Dialogue: 0,0:18:17.88,0:18:21.75,Rubi,,0000,0000,0000,,сәйкес
Dialogue: 0,0:18:17.88,0:18:21.75,Rubi,,0000,0000,0000,,Фью
Dialogue: 0,0:18:17.88,0:18:21.75,Rubi,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:18:17.88,0:18:21.75,Rubi,,0000,0000,0000,,Жылан
Dialogue: 0,0:18:17.88,0:18:21.75,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:18:17.88,0:18:21.75,Default,,0000,0000,0000,,«Түнде сыбызғы тартсаң, жыландар шығады».
Dialogue: 0,0:18:21.75,0:18:24.68,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:18:21.75,0:18:24.68,Default,,0000,0000,0000,,Бұл рас, кихихи!
Dialogue: 0,0:18:24.68,0:18:28.82,Default,,0000,0000,0000,,Әже
Dialogue: 0,0:18:24.68,0:18:28.82,Rubi,,0000,0000,0000,,Мейшин
Dialogue: 0,0:18:24.68,0:18:28.82,Rubi,,0000,0000,0000,,Мейшин
Dialogue: 0,0:18:24.68,0:18:28.82,Default,,0000,0000,0000,,Бұл ырым, ырым
Dialogue: 0,0:18:28.82,0:18:32.32,Rubi,,0000,0000,0000,,Широто
Dialogue: 0,0:18:28.82,0:18:32.32,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:18:28.82,0:18:32.32,Rubi,,0000,0000,0000,,Артқа
Dialogue: 0,0:18:28.82,0:18:32.32,Default,,0000,0000,0000,,Әуесқой апаның болжауы
Dialogue: 0,0:18:28.82,0:18:32.32,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:18:28.82,0:18:32.32,Default,,0000,0000,0000,,Егер сіз помпон ұтып алсаңыз
Dialogue: 0,0:18:32.32,0:18:34.83,Rubi,,0000,0000,0000,,Артқа
Dialogue: 0,0:18:32.32,0:18:34.83,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:18:32.32,0:18:34.83,Default,,0000,0000,0000,,Кәсіби болжаушы
Dialogue: 0,0:18:32.32,0:18:34.83,Rubi,,0000,0000,0000,,Кейрин Кейба
Dialogue: 0,0:18:32.32,0:18:34.83,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:18:32.32,0:18:34.83,Default,,0000,0000,0000,,Велосипед жарысында жеңіске жету
Dialogue: 0,0:18:34.83,0:18:37.33,Rubi,,0000,0000,0000,,Қазір туралы
Dialogue: 0,0:18:34.83,0:18:37.33,Rubi,,0000,0000,0000,,Оганемо
Dialogue: 0,0:18:34.83,0:18:37.33,Default,,0000,0000,0000,,Ол қазір миллионер.
Dialogue: 0,0:18:34.83,0:18:37.33,Default,,0000,0000,0000,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:18:37.33,0:18:39.83,Rubi,,0000,0000,0000,,Хассо
Dialogue: 0,0:18:37.33,0:18:39.83,Default,,0000,0000,0000,,<Якузаның идеясы>
Dialogue: 0,0:18:39.83,0:18:42.33,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:18:39.83,0:18:42.33,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:18:39.83,0:18:42.33,Default,,0000,0000,0000,,Сіз мұны айттыңыз.
Dialogue: 0,0:18:42.33,0:18:44.27,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:18:42.33,0:18:44.27,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:18:42.33,0:18:44.27,Default,,0000,0000,0000,,Жаман нәрсе болған кезде
Dialogue: 0,0:18:42.33,0:18:44.27,Rubi,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:18:42.33,0:18:44.27,Default,,0000,0000,0000,,Қорқынышты болуы керек
Dialogue: 0,0:18:44.27,0:18:45.84,Default,,0000,0000,0000,,《Доки》
Dialogue: 0,0:18:45.84,0:18:48.34,Rubi,,0000,0000,0000,,Мину
Dialogue: 0,0:18:45.84,0:18:48.34,Rubi,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:18:45.84,0:18:48.34,Default,,0000,0000,0000,,<Сонымен сіз оны көрдіңіз бе? Хироши әке>
Dialogue: 0,0:18:48.34,0:18:51.24,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:18:48.34,0:18:51.24,Rubi,,0000,0000,0000,,Шошинмоно
Dialogue: 0,0:18:48.34,0:18:51.24,Default,,0000,0000,0000,,Өйткені Маруко ұялшақ.
Dialogue: 0,0:18:48.34,0:18:51.24,Default,,0000,0000,0000,,Хаха...
Dialogue: 0,0:18:51.24,0:18:53.21,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:18:51.24,0:18:53.21,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:18:53.21,0:18:56.85,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:18:53.21,0:18:56.85,Default,,0000,0000,0000,,Жарайды, көп айтпасаң.
Dialogue: 0,0:18:53.21,0:18:56.85,Rubi,,0000,0000,0000,,Артқа
Dialogue: 0,0:18:53.21,0:18:56.85,Default,,0000,0000,0000,,Неліктен байлығыңызды айтпайсыз?
Dialogue: 0,0:18:56.85,0:18:59.75,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:18:56.85,0:18:59.75,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:18:59.75,0:19:01.75,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:19:04.72,0:19:09.36,Default,,0000,0000,0000,,Төрт күрек Ерм...
Dialogue: 0,0:19:04.72,0:19:09.36,Rubi,,0000,0000,0000,,Достар
Dialogue: 0,0:19:04.72,0:19:09.36,Default,,0000,0000,0000,,«Досының өсек сөзінен
Dialogue: 0,0:19:09.36,0:19:13.23,Default,,0000,0000,0000,,Жаман нәрселер
Dialogue: 0,0:19:09.36,0:19:13.23,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:19:09.36,0:19:13.23,Default,,0000,0000,0000,,Бұл болады».
Dialogue: 0,0:19:13.23,0:19:14.87,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:19:13.23,0:19:14.87,Default,,0000,0000,0000,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:19:14.87,0:19:17.77,Rubi,,0000,0000,0000,,Өте
Dialogue: 0,0:19:14.87,0:19:17.77,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:19:14.87,0:19:17.77,Default,,0000,0000,0000,,Хахаха... Бұл қиын, Маруко.
Dialogue: 0,0:19:17.77,0:19:20.67,Rubi,,0000,0000,0000,,Достар
Dialogue: 0,0:19:17.77,0:19:20.67,Rubi,,0000,0000,0000,,Накайо
Dialogue: 0,0:19:17.77,0:19:20.67,Default,,0000,0000,0000,,Достарыңмен тіл табысу керек.
Dialogue: 0,0:19:20.67,0:19:26.31,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:19:20.67,0:19:26.31,Rubi,,0000,0000,0000,,Накайо
Dialogue: 0,0:19:20.67,0:19:26.31,Default,,0000,0000,0000,,Маруко, біз әрқашан жақсы араласамыз.
Dialogue: 0,0:19:20.67,0:19:26.31,Rubi,,0000,0000,0000,,Қанкей
Dialogue: 0,0:19:20.67,0:19:26.31,Default,,0000,0000,0000,,Бастарыңызды иіп, төбеге табыныңыздар.
Dialogue: 0,0:19:26.31,0:19:28.81,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:19:26.31,0:19:28.81,Default,,0000,0000,0000,,～
Dialogue: 0,0:19:30.18,0:19:32.82,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:19:32.82,0:19:36.32,Default,,0000,0000,0000,,《Ха, осындай нәрсе
Dialogue: 0,0:19:32.82,0:19:36.32,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:32.82,0:19:36.32,Default,,0000,0000,0000,,Әркім оны дұрыс түсінбейді.
Dialogue: 0,0:19:38.32,0:19:41.22,Rubi,,0000,0000,0000,,Кинун
Dialogue: 0,0:19:38.32,0:19:41.22,Rubi,,0000,0000,0000,,Артқа
Dialogue: 0,0:19:38.32,0:19:41.22,Default,,0000,0000,0000,,《Не? Бұл сіздің қаржылық сәттіліктеріңізді арттыратын болжам.
Dialogue: 0,0:19:41.22,0:19:43.19,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:19:41.22,0:19:43.19,Default,,0000,0000,0000,,Сіздің әпкеңіз де ақымақ.
Dialogue: 0,0:19:43.19,0:19:47.33,Default,,0000,0000,0000,,Егер сіз мұны бәрібір орындайтын болсаңыз
Dialogue: 0,0:19:43.19,0:19:47.33,Default,,0000,0000,0000,,Мынадай болуы керек》
Dialogue: 0,0:19:47.33,0:19:48.83,Default,,0000,0000,0000,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:19:54.84,0:19:59.71,Rubi,,0000,0000,0000,,Тренинг
Dialogue: 0,0:19:54.84,0:19:59.71,Rubi,,0000,0000,0000,,Ганба
Dialogue: 0,0:19:54.84,0:19:59.71,Default,,0000,0000,0000,,Ал, «Тынымсыз оқы.
Dialogue: 0,0:19:54.84,0:19:59.71,Rubi,,0000,0000,0000,,Сейсеки
Dialogue: 0,0:19:54.84,0:19:59.71,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:54.84,0:19:59.71,Default,,0000,0000,0000,,Егер сіз бағаларыңызды күрт жақсартсаңыз
Dialogue: 0,0:19:59.71,0:20:03.35,Rubi,,0000,0000,0000,,Козука
Dialogue: 0,0:19:59.71,0:20:03.35,Rubi,,0000,0000,0000,,Қате
Dialogue: 0,0:19:59.71,0:20:03.35,Default,,0000,0000,0000,,Сіздің қалтаңыз міндетті түрде көбейеді».
Dialogue: 0,0:20:03.35,0:20:06.25,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:20:03.35,0:20:06.25,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:20:03.35,0:20:06.25,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:20:03.35,0:20:06.25,Default,,0000,0000,0000,,<Әрине>
Dialogue: 0,0:20:08.85,0:20:11.36,Rubi,,0000,0000,0000,,Кеше
Dialogue: 0,0:20:08.85,0:20:11.36,Default,,0000,0000,0000,,Сіз кеше Акко-чанды көрдіңіз бе?
Dialogue: 0,0:20:08.85,0:20:11.36,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:20:11.36,0:20:13.29,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:20:11.36,0:20:13.29,Default,,0000,0000,0000,,Э~?
Dialogue: 0,0:20:11.36,0:20:13.29,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:20:11.36,0:20:13.29,Default,,0000,0000,0000,,Менің арнамды алып тастады
Dialogue: 0,0:20:13.29,0:20:16.23,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:20:13.29,0:20:16.23,Default,,0000,0000,0000,,Мен оны көре алмадым.
Dialogue: 0,0:20:13.29,0:20:16.23,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:20:13.29,0:20:16.23,Default,,0000,0000,0000,,Онда неге мені көруге келмейсің?
Dialogue: 0,0:20:16.23,0:20:18.23,Default,,0000,0000,0000,,Уау! Жарайды онда
Dialogue: 0,0:20:16.23,0:20:18.23,Rubi,,0000,0000,0000,,Емен
Dialogue: 0,0:20:16.23,0:20:18.23,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:20:16.23,0:20:18.23,Default,,0000,0000,0000,,Мен тәттілер әкелемін.
Dialogue: 0,0:20:18.23,0:20:20.16,Default,,0000,0000,0000,,Иә! алақай!
Dialogue: 0,0:20:18.23,0:20:20.16,Default,,0000,0000,0000,,Хехехе
Dialogue: 0,0:20:20.16,0:20:22.30,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:20:20.16,0:20:22.30,Default,,0000,0000,0000,,()
Dialogue: 0,0:20:20.16,0:20:22.30,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:22.30,0:20:24.23,Rubi,,0000,0000,0000,,Артқа
Dialogue: 0,0:20:22.30,0:20:24.23,Default,,0000,0000,0000,,Әй, мен саған байлығыңды айта аламын ба?
Dialogue: 0,0:20:24.23,0:20:26.80,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:20:24.23,0:20:26.80,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:20:24.23,0:20:26.80,Default,,0000,0000,0000,,Е, сенде бұл неге бар?
Dialogue: 0,0:20:26.80,0:20:29.71,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:20:26.80,0:20:29.71,Default,,0000,0000,0000,,Мен қазір істеп жатырмын
Dialogue: 0,0:20:26.80,0:20:29.71,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:20:29.71,0:20:31.31,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:20:29.71,0:20:31.31,Default,,0000,0000,0000,,Оны да жасайық Мару-чан
Dialogue: 0,0:20:31.31,0:20:33.81,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:20:31.31,0:20:33.81,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:20:31.31,0:20:33.81,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:20:31.31,0:20:33.81,Default,,0000,0000,0000,,Сіз уақытындасыз.
Dialogue: 0,0:20:33.81,0:20:36.71,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:20:33.81,0:20:36.71,Default,,0000,0000,0000,,Неліктен? Бұл күлкілі болса да
Dialogue: 0,0:20:36.71,0:20:39.32,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:20:36.71,0:20:39.32,Default,,0000,0000,0000,,Тоқтат. Жетті. Іздерме оны.
Dialogue: 0,0:20:36.71,0:20:39.32,Default,,0000,0000,0000,,Бірақ қарсы болмасаңыз жақсы.
Dialogue: 0,0:20:39.32,0:20:42.32,Rubi,,0000,0000,0000,,Достар
Dialogue: 0,0:20:39.32,0:20:42.32,Default,,0000,0000,0000,,《Достардың өсектерінен
Dialogue: 0,0:20:39.32,0:20:42.32,Default,,0000,0000,0000,,Жаман нәрселер...》
Dialogue: 0,0:20:43.82,0:20:45.76,Default,,0000,0000,0000,,Көріп көрейік.
Dialogue: 0,0:20:45.76,0:20:47.69,Rubi,,0000,0000,0000,,Не болды?
Dialogue: 0,0:20:45.76,0:20:47.69,Default,,0000,0000,0000,,Сіз болжау үшін не қолданасыз?
Dialogue: 0,0:20:47.69,0:20:49.69,Rubi,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:20:47.69,0:20:49.69,Default,,0000,0000,0000,,...
Dialogue: 0,0:20:49.69,0:20:52.33,Rubi,,0000,0000,0000,,Оқиға
Dialogue: 0,0:20:49.69,0:20:52.33,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:20:52.33,0:20:55.23,Rubi,,0000,0000,0000,,Теріс
Dialogue: 0,0:20:52.33,0:20:55.23,Default,,0000,0000,0000,,Мен сізге бір жақсылық сұрасам болады ма?
Dialogue: 0,0:20:52.33,0:20:55.23,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:20:52.33,0:20:55.23,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:20:55.23,0:20:57.83,Rubi,,0000,0000,0000,,Айшуура
Dialogue: 0,0:20:55.23,0:20:57.83,Default,,0000,0000,0000,,Үйлесімділік болжау
Dialogue: 0,0:20:57.83,0:20:58.80,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:20:57.83,0:20:58.80,Rubi,,0000,0000,0000,,Қазір
Dialogue: 0,0:20:57.83,0:20:58.80,Default,,0000,0000,0000,,Кіммен?
Dialogue: 0,0:20:58.80,0:21:02.71,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:20:58.80,0:21:02.71,Default,,0000,0000,0000,,О, жоқ~ Әрине, бұл Ханава-кун.
Dialogue: 0,0:21:02.71,0:21:04.71,Rubi,,0000,0000,0000,,Теріс
Dialogue: 0,0:21:02.71,0:21:04.71,Default,,0000,0000,0000,,Өтінемін.
Dialogue: 0,0:21:04.71,0:21:07.34,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:21:04.71,0:21:07.34,Default,,0000,0000,0000,,А, дұрыс. Мен қалаған DVD бүгін шықты.
