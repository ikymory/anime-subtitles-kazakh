Dialogue: 0,0:23:46.87,0:23:50.37,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:23:46.87,0:23:50.37,Default,,0000,0000,0000,,Сол бала
Dialogue: 0,0:23:46.87,0:23:50.37,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:23:46.87,0:23:50.37,Default,,0000,0000,0000,,Саған Мару-чан ұнайды, солай ма?
Dialogue: 0,0:23:50.37,0:23:53.87,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:23:50.37,0:23:53.87,Default,,0000,0000,0000,,《Ух... Т-бұл дұрыс емес!
Dialogue: 0,0:23:50.37,0:23:53.87,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:23:50.37,0:23:53.87,Default,,0000,0000,0000,,T-бұл дұрыс емес! 》
Dialogue: 0,0:23:54.88,0:23:57.78,Default,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:23:54.88,0:23:57.78,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:23:54.88,0:23:57.78,Default,,0000,0000,0000,,Қайтадан қош келдіңіз
Dialogue: 0,0:23:57.78,0:24:01.38,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:23:57.78,0:24:01.38,Default,,0000,0000,0000,,Маруко кейінірек
Dialogue: 0,0:23:57.78,0:24:01.38,Rubi,,0000,0000,0000,,Бөлме
Dialogue: 0,0:23:57.78,0:24:01.38,Default,,0000,0000,0000,,Атаның бөлмесіне кел
Dialogue: 0,0:24:01.38,0:24:03.89,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:24:01.38,0:24:03.89,Default,,0000,0000,0000,,Ал, мен күтемін.
Dialogue: 0,0:24:03.89,0:24:04.85,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:24:04.85,0:24:09.76,Default,,0000,0000,0000,,《Уау, мен жасадым! ата
Dialogue: 0,0:24:04.85,0:24:09.76,Rubi,,0000,0000,0000,,Козука
Dialogue: 0,0:24:04.85,0:24:09.76,Default,,0000,0000,0000,,Маған қалта ақшасын бере ме деп ойлаймын》
Dialogue: 0,0:24:09.76,0:24:12.90,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:24:09.76,0:24:12.90,Default,,0000,0000,0000,,(Томозо)
Dialogue: 0,0:24:09.76,0:24:12.90,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:24:09.76,0:24:12.90,Default,,0000,0000,0000,,Ал, мынаны аударыңыз.
Dialogue: 0,0:24:12.90,0:24:16.40,Rubi,,0000,0000,0000,,Келесі
Dialogue: 0,0:24:12.90,0:24:16.40,Default,,0000,0000,0000,,Келесі карта, erm.
Dialogue: 0,0:24:12.90,0:24:16.40,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:24:12.90,0:24:16.40,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:24:12.90,0:24:16.40,Default,,0000,0000,0000,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:24:16.40,0:24:19.84,Default,,0000,0000,0000,,Иә! алақай!
Dialogue: 0,0:24:16.40,0:24:19.84,Rubi,,0000,0000,0000,,Козука
Dialogue: 0,0:24:16.40,0:24:19.84,Rubi,,0000,0000,0000,,Козука
Dialogue: 0,0:24:16.40,0:24:19.84,Default,,0000,0000,0000,,Қалта ақшасы Қалтадағы ақша
Dialogue: 0,0:24:19.84,0:24:22.74,Default,,0000,0000,0000,,Ата
Dialogue: 0,0:24:19.84,0:24:22.74,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:19.84,0:24:22.74,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:24:19.84,0:24:22.74,Default,,0000,0000,0000,,Ах, Маруко, мен сені күттім.
Dialogue: 0,0:24:22.74,0:24:24.34,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:24:22.74,0:24:24.34,Default,,0000,0000,0000,,Сен онда не істеп жүрсің?
Dialogue: 0,0:24:24.34,0:24:27.24,Default,,0000,0000,0000,,Ойын карталарымен
Dialogue: 0,0:24:24.34,0:24:27.24,Rubi,,0000,0000,0000,,Денсаулық
Dialogue: 0,0:24:24.34,0:24:27.24,Rubi,,0000,0000,0000,,Артқа
Dialogue: 0,0:24:24.34,0:24:27.24,Default,,0000,0000,0000,,Мен сіздің денсаулығыңыздың сәттілігін болжайтынмын.
Dialogue: 0,0:24:27.24,0:24:28.21,Default,,0000,0000,0000,,А, иә...
Dialogue: 0,0:24:28.21,0:24:32.22,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:28.21,0:24:32.22,Default,,0000,0000,0000,,Маруко Момо
Dialogue: 0,0:24:28.21,0:24:32.22,Rubi,,0000,0000,0000,,Артқа
Dialogue: 0,0:24:28.21,0:24:32.22,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:24:28.21,0:24:32.22,Default,,0000,0000,0000,,Мен саған өз байлығымды айтайын деп едім.
Dialogue: 0,0:24:32.22,0:24:33.35,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,0:24:33.35,0:24:38.22,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:24:33.35,0:24:38.22,Default,,0000,0000,0000,,Ал, олай айтпа.
Dialogue: 0,0:24:33.35,0:24:38.22,Default,,0000,0000,0000,,Ах-ах-ах
Dialogue: 0,0:24:38.22,0:24:42.86,Default,,0000,0000,0000,,Әй... Атаның ақымақ!
Dialogue: 0,0:24:38.22,0:24:42.86,Default,,0000,0000,0000,,(Каэдэ) Қайтып келдіңіз, аға.
Dialogue: 0,0:24:42.86,0:24:45.86,Default,,0000,0000,0000,,Иә? Жек көру?
Dialogue: 0,0:24:48.37,0:24:49.33,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:24:49.33,0:24:51.87,Default,,0000,0000,0000,,Сакура-сан хохохо...
Dialogue: 0,0:24:51.87,0:24:54.37,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:24:51.87,0:24:54.37,Default,,0000,0000,0000,,Мен білмедім
Dialogue: 0,0:24:51.87,0:24:54.37,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:24:54.37,0:24:57.27,Rubi,,0000,0000,0000,,Ямамото-кун
Dialogue: 0,0:24:54.37,0:24:57.27,Default,,0000,0000,0000,,Сіз туралы Ямамото-кун
Dialogue: 0,0:24:54.37,0:24:57.27,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:24:54.37,0:24:57.27,Default,,0000,0000,0000,,Сізге ұнады ма?
Dialogue: 0,0:24:57.27,0:24:58.88,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:24:57.27,0:24:58.88,Default,,0000,0000,0000,,Иә! Бұл не?
Dialogue: 0,0:24:58.88,0:25:01.38,Rubi,,0000,0000,0000,,Кеше
Dialogue: 0,0:24:58.88,0:25:01.38,Rubi,,0000,0000,0000,,Артқа
Dialogue: 0,0:24:58.88,0:25:01.38,Rubi,,0000,0000,0000,,Кекка
Dialogue: 0,0:24:58.88,0:25:01.38,Default,,0000,0000,0000,,Мару-чан, кешегі сәуегейліктің нәтижесі
Dialogue: 0,0:25:01.38,0:25:03.31,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:25:01.38,0:25:03.31,Rubi,,0000,0000,0000,,Хиро
Dialogue: 0,0:25:01.38,0:25:03.31,Default,,0000,0000,0000,,Ол тез тарады
Dialogue: 0,0:25:03.31,0:25:05.25,Default,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:25:05.25,0:25:07.25,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:25:09.25,0:25:11.39,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:25:09.25,0:25:11.39,Default,,0000,0000,0000,,<Жұрттың да өсек-аяңы
Dialogue: 0,0:25:09.25,0:25:11.39,Rubi,,0000,0000,0000,,Шичижугоничи
Dialogue: 0,0:25:09.25,0:25:11.39,Default,,0000,0000,0000,,Жетпіс бес күн дейді.
Dialogue: 0,0:25:11.39,0:25:14.29,Rubi,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:25:11.39,0:25:14.29,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:25:11.39,0:25:14.29,Default,,0000,0000,0000,,Жарты күн болса да мұндай өсек естігім келмейді>
Dialogue: 0,0:25:11.39,0:25:14.29,Rubi,,0000,0000,0000,,Ямамото
Dialogue: 0,0:25:11.39,0:25:14.29,Default,,0000,0000,0000,,Сәлем Сакура!
Dialogue: 0,0:25:14.29,0:25:16.26,Default,,0000,0000,0000,,Хмм! Уа!
Dialogue: 0,0:25:16.26,0:25:20.20,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:25:16.26,0:25:20.20,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:25:16.26,0:25:20.20,Default,,0000,0000,0000,,О! Мен саған бәрібір
Dialogue: 0,0:25:16.26,0:25:20.20,Rubi,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:25:16.26,0:25:20.20,Rubi,,0000,0000,0000,,Кира
Dialogue: 0,0:25:16.26,0:25:20.20,Default,,0000,0000,0000,,Өйткені мен оны жек көремін Hmph!
Dialogue: 0,0:25:20.20,0:25:23.33,Default,,0000,0000,0000,,Жоқ, мен де.
Dialogue: 0,0:25:20.20,0:25:23.33,Default,,0000,0000,0000,,Сіз туралы
Dialogue: 0,0:25:23.33,0:25:25.84,Rubi,,0000,0000,0000,,Дакира
Dialogue: 0,0:25:23.33,0:25:25.84,Default,,0000,0000,0000,,Мен сені жек көремін, ақымақ.
Dialogue: 0,0:25:25.84,0:25:31.34,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:25:25.84,0:25:31.34,Default,,0000,0000,0000,,Сакура-сан, дәл солай.
Dialogue: 0,0:25:25.84,0:25:31.34,Rubi,,0000,0000,0000,,Айджо
Dialogue: 0,0:25:25.84,0:25:31.34,Rubi,,0000,0000,0000,,Урага
Dialogue: 0,0:25:25.84,0:25:31.34,Default,,0000,0000,0000,,Махаббаттың екінші жағы болса керек.
Dialogue: 0,0:25:31.34,0:25:32.84,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:25:31.34,0:25:32.84,Rubi,,0000,0000,0000,,Кун
Dialogue: 0,0:25:31.34,0:25:32.84,Default,,0000,0000,0000,,()
Dialogue: 0,0:25:32.84,0:25:35.75,Default,,0000,0000,0000,,(Жан) Абдулға артынан қатыгездікпен пышақ сұқылды
Dialogue: 0,0:25:32.84,0:25:35.75,Rubi,,0000,0000,0000,,Сунао
Dialogue: 0,0:25:32.84,0:25:35.75,Default,,0000,0000,0000,,Сіз шыншыл болуыңыз керек.
Dialogue: 0,0:25:35.75,0:25:37.71,Rubi,,0000,0000,0000,,Артқа
Dialogue: 0,0:25:35.75,0:25:37.71,Rubi,,0000,0000,0000,,Синпи
Dialogue: 0,0:25:35.75,0:25:37.71,Rubi,,0000,0000,0000,,Қуат
Dialogue: 0,0:25:35.75,0:25:37.71,Default,,0000,0000,0000,,Көріпкелдік – тылсым күш
Dialogue: 0,0:25:37.71,0:25:40.35,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:25:37.71,0:25:40.35,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:25:37.71,0:25:40.35,Default,,0000,0000,0000,,Балалар, не айтқыларың келеді?
Dialogue: 0,0:25:40.35,0:25:42.29,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:25:42.29,0:25:45.22,Rubi,,0000,0000,0000,,Шин
Dialogue: 0,0:25:42.29,0:25:45.22,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:25:42.29,0:25:45.22,Rubi,,0000,0000,0000,,Суку
Dialogue: 0,0:25:42.29,0:25:45.22,Default,,0000,0000,0000,,Сенген адам құтқарылады
Dialogue: 0,0:25:45.22,0:25:46.86,Default,,0000,0000,0000,,<Осылайша, Мару-чан
Dialogue: 0,0:25:46.86,0:25:51.36,Rubi,,0000,0000,0000,,Мусекинин
Dialogue: 0,0:25:46.86,0:25:51.36,Rubi,,0000,0000,0000,,Артқа
Dialogue: 0,0:25:46.86,0:25:51.36,Rubi,,0000,0000,0000,,Кекка
Dialogue: 0,0:25:46.86,0:25:51.36,Default,,0000,0000,0000,,Жауапсыз болжау нәтижесінде
Dialogue: 0,0:25:46.86,0:25:51.36,Rubi,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:25:46.86,0:25:51.36,Rubi,,0000,0000,0000,,Мауах
Dialogue: 0,0:25:46.86,0:25:51.36,Default,,0000,0000,0000,,Мені теңселтіп жатты>
Dialogue: 0,0:25:53.36,0:25:56.36,Rubi,,0000,0000,0000,,Ура
Dialogue: 0,0:25:53.36,0:25:56.36,Rubi,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:25:53.36,0:25:56.36,Rubi,,0000,0000,0000,,Кира
Dialogue: 0,0:25:53.36,0:25:56.36,Default,,0000,0000,0000,,Мен болжауды жек көремін.
Dialogue: 0,0:26:39.88,0:26:42.38,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:26:39.88,0:26:42.38,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:26:39.88,0:26:42.38,Default,,0000,0000,0000,,Келесі жолы Маруко
Dialogue: 0,0:26:39.88,0:26:42.38,Rubi,,0000,0000,0000,,Танжукай
Dialogue: 0,0:26:39.88,0:26:42.38,Default,,0000,0000,0000,,Мен туған күн кешін өткізіп жатырмын.
Dialogue: 0,0:26:42.38,0:26:44.81,Default,,0000,0000,0000,,Айтпақшы
Dialogue: 0,0:26:42.38,0:26:44.81,Rubi,,0000,0000,0000,,Йошикава
Dialogue: 0,0:26:42.38,0:26:44.81,Default,,0000,0000,0000,,Мидори Йошикава деген кім?
Dialogue: 0,0:26:44.81,0:26:46.75,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:26:44.81,0:26:46.75,Rubi,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:26:44.81,0:26:46.75,Default,,0000,0000,0000,,Бір керемет балалар да келе жатыр.
Dialogue: 0,0:26:46.75,0:26:48.75,Rubi,,0000,0000,0000,,Айнала
Dialogue: 0,0:26:46.75,0:26:48.75,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:26:46.75,0:26:48.75,Default,,0000,0000,0000,,Келесі «Чиби Маруко-чан»...
Dialogue: 0,0:26:57.83,0:27:11.83,Default,,0000,0000,0000,,Сен
