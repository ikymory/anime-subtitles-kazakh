Dialogue: 0,0:01:04.84,0:01:15.34,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:14.87,0:03:17.38,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:03:14.87,0:03:17.38,Rubi,,0000,0000,0000,,Бірден
Dialogue: 0,0:03:14.87,0:03:17.38,Default,,0000,0000,0000,,<Сол күні, бір минут бұрын
Dialogue: 0,0:03:17.38,0:03:20.28,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:03:17.38,0:03:20.28,Default,,0000,0000,0000,,Осы сияқты
Dialogue: 0,0:03:17.38,0:03:20.28,Rubi,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:03:17.38,0:03:20.28,Default,,0000,0000,0000,,Мару-чан тыныштықта болды
Dialogue: 0,0:03:20.28,0:03:21.88,Default,,0000,0000,0000,,Алайда...＞
Dialogue: 0,0:03:20.28,0:03:21.88,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:20.28,0:03:21.88,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:03:21.88,0:03:24.32,Rubi,,0000,0000,0000,,Kodo
Dialogue: 0,0:03:21.88,0:03:24.32,Rubi,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:03:21.88,0:03:24.32,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:03:21.88,0:03:24.32,Default,,0000,0000,0000,,(Жүректің соғуына ұқсас дыбыс: пульс)
Dialogue: 0,0:03:24.32,0:03:27.32,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:03:24.32,0:03:27.32,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:24.32,0:03:27.32,Default,,0000,0000,0000,,(дыбыс: шаншып соғу)
Dialogue: 0,0:03:32.82,0:03:36.33,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:03:32.82,0:03:36.33,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:32.82,0:03:36.33,Default,,0000,0000,0000,,(дыбыс: шаншып соғу)
Dialogue: 0,0:03:36.33,0:03:38.83,Rubi,,0000,0000,0000,,Хара
Dialogue: 0,0:03:36.33,0:03:38.83,Default,,0000,0000,0000,,《Мен қатты ашуландым.
Dialogue: 0,0:03:36.33,0:03:38.83,Default,,0000,0000,0000,,Жиі
Dialogue: 0,0:03:38.83,0:03:41.33,Rubi,,0000,0000,0000,,Ескертпе
Dialogue: 0,0:03:38.83,0:03:41.33,Default,,0000,0000,0000,,Күрессең, жазыларсың.
Dialogue: 0,0:03:41.33,0:03:43.27,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:03:41.33,0:03:43.27,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:03:41.33,0:03:43.27,Default,,0000,0000,0000,,(жылдамдық дыбысы: шаншып соғу)
Dialogue: 0,0:03:43.27,0:03:45.20,Default,,0000,0000,0000,,Ооо
Dialogue: 0,0:03:45.20,0:03:47.21,Default,,0000,0000,0000,,О!
Dialogue: 0,0:03:47.21,0:03:51.84,Default,,0000,0000,0000,,О, ой, ой!
Dialogue: 0,0:03:51.84,0:03:54.75,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:03:51.84,0:03:54.75,Default,,0000,0000,0000,,Уа... бұл не?
Dialogue: 0,0:03:51.84,0:03:54.75,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:03:51.84,0:03:54.75,Default,,0000,0000,0000,,Бұл не деген...\NБұл
Dialogue: 0,0:03:54.75,0:03:57.35,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:54.75,0:03:57.35,Rubi,,0000,0000,0000,,Жағдайда
Dialogue: 0,0:03:54.75,0:03:57.35,Default,,0000,0000,0000,,сияқты нәрселерді айтатын уақыт емес.
Dialogue: 0,0:03:57.35,0:03:59.85,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:57.35,0:03:59.85,Default,,0000,0000,0000,,Анашым...
Dialogue: 0,0:03:57.35,0:03:59.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:59.85,0:04:03.35,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:03:59.85,0:04:03.35,Default,,0000,0000,0000,,Менің ішім ауырады...
Dialogue: 0,0:03:59.85,0:04:03.35,Rubi,,0000,0000,0000,,Бенжо
Dialogue: 0,0:03:59.85,0:04:03.35,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:59.85,0:04:03.35,Default,,0000,0000,0000,,Дәретханаға барыңыз.
Dialogue: 0,0:04:03.35,0:04:04.86,Rubi,,0000,0000,0000,,Ескертпе
Dialogue: 0,0:04:03.35,0:04:04.86,Default,,0000,0000,0000,,Жақында сауығып кетеді.
Dialogue: 0,0:04:03.35,0:04:04.86,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:04:04.86,0:04:06.79,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:04:04.86,0:04:06.79,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:04.86,0:04:06.79,Default,,0000,0000,0000,,Бұл не, Маруко?
Dialogue: 0,0:04:04.86,0:04:06.79,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:04:04.86,0:04:06.79,Default,,0000,0000,0000,,Асқазаныңыз ауырады ма?
Dialogue: 0,0:04:06.79,0:04:09.73,Default,,0000,0000,0000,,Асшаяндардың біркелкі құйрықтары
Dialogue: 0,0:04:06.79,0:04:09.73,Rubi,,0000,0000,0000,,Хиро
Dialogue: 0,0:04:06.79,0:04:09.73,Rubi,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:04:06.79,0:04:09.73,Default,,0000,0000,0000,,Сен оны алып жедің бе? Хахаха
Dialogue: 0,0:04:09.73,0:04:11.73,Rubi,,0000,0000,0000,,Мыс
Dialogue: 0,0:04:09.73,0:04:11.73,Default,,0000,0000,0000,,Мен мысық емеспін
Dialogue: 0,0:04:11.73,0:04:13.36,Default,,0000,0000,0000,,Біз қауіпсіз жердеміз, сондықтан…
Dialogue: 0,0:04:13.36,0:04:17.87,Rubi,,0000,0000,0000,,Қоңқай
Dialogue: 0,0:04:13.36,0:04:17.87,Rubi,,0000,0000,0000,,Фукуцуу
Dialogue: 0,0:04:13.36,0:04:17.87,Rubi,,0000,0000,0000,,Фукуцуу
Dialogue: 0,0:04:13.36,0:04:17.87,Default,,0000,0000,0000,,<Бұл іштің ауыруы әдеттегі іштің ауырсынуынан ерекшеленеді.
Dialogue: 0,0:04:13.36,0:04:17.87,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:04:13.36,0:04:17.87,Default,,0000,0000,0000,,Бұл мүлдем басқа түрі.
Dialogue: 0,0:04:17.87,0:04:21.74,Rubi,,0000,0000,0000,,Фукуцуу
Dialogue: 0,0:04:17.87,0:04:21.74,Rubi,,0000,0000,0000,,Жапон тілі
Dialogue: 0,0:04:17.87,0:04:21.74,Default,,0000,0000,0000,,Егер сіздің әдеттегі ішіңіз жапон биі болса
Dialogue: 0,0:04:17.87,0:04:21.74,Rubi,,0000,0000,0000,,Қоңқай
Dialogue: 0,0:04:17.87,0:04:21.74,Rubi,,0000,0000,0000,,Фукуцу
Dialogue: 0,0:04:17.87,0:04:21.74,Default,,0000,0000,0000,,Бұл іштің ауыруы фламенко>
Dialogue: 0,0:04:21.74,0:04:23.67,Default,,0000,0000,0000,,О... мен!
Dialogue: 0,0:04:23.67,0:04:25.68,Rubi,,0000,0000,0000,,Джонцутеги
Dialogue: 0,0:04:23.67,0:04:25.68,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:04:23.67,0:04:25.68,Default,,0000,0000,0000,,<Ол құмарлықпен ауырады>
Dialogue: 0,0:04:25.68,0:04:28.81,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:04:25.68,0:04:28.81,Rubi,,0000,0000,0000,,Биоки
Dialogue: 0,0:04:25.68,0:04:28.81,Default,,0000,0000,0000,,Қандай да бір қорқынышты ауру сияқты.
Dialogue: 0,0:04:25.68,0:04:28.81,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:04:25.68,0:04:28.81,Default,,0000,0000,0000,,Мен өзімді...
Dialogue: 0,0:04:28.81,0:04:33.68,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:04:28.81,0:04:33.68,Rubi,,0000,0000,0000,,Ямай
Dialogue: 0,0:04:28.81,0:04:33.68,Default,,0000,0000,0000,,Мен ауырып тұрмын
Dialogue: 0,0:04:28.81,0:04:33.68,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:28.81,0:04:33.68,Rubi,,0000,0000,0000,,Ескертпе
Dialogue: 0,0:04:28.81,0:04:33.68,Default,,0000,0000,0000,,Теледидар көріп емдейді дейді.
Dialogue: 0,0:04:33.68,0:04:36.32,Default,,0000,0000,0000,,Менің ойымша?
Dialogue: 0,0:04:33.68,0:04:36.32,Default,,0000,0000,0000,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:04:36.32,0:04:41.19,Rubi,,0000,0000,0000,,Дансей
Dialogue: 0,0:04:36.32,0:04:41.19,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:04:36.32,0:04:41.19,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:04:36.32,0:04:41.19,Default,,0000,0000,0000,, (Ер) Эй, шықты. Ол шықты.
Dialogue: 0,0:04:36.32,0:04:41.19,Rubi,,0000,0000,0000,,Іс жүзінде
Dialogue: 0,0:04:36.32,0:04:41.19,Rubi,,0000,0000,0000,,Тұқым
Dialogue: 0,0:04:36.32,0:04:41.19,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:04:36.32,0:04:41.19,Default,,0000,0000,0000,,Негізінде тұқымдар мен механизмдер бар.
Dialogue: 0,0:04:41.19,0:04:42.83,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:04:42.83,0:04:47.33,Default,,0000,0000,0000,,<Бірақ менің ішімдегі фламенко
Dialogue: 0,0:04:42.83,0:04:47.33,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:04:42.83,0:04:47.33,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:04:42.83,0:04:47.33,Default,,0000,0000,0000,,Барған сайын құмарлану>
Dialogue: 0,0:04:47.33,0:04:51.20,Default,,0000,0000,0000,,Эй, мен мұны білдім.
Dialogue: 0,0:04:47.33,0:04:51.20,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:04:47.33,0:04:51.20,Default,,0000,0000,0000,,Менің ішім әлі ауырады...
Dialogue: 0,0:04:51.20,0:04:53.20,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:04:51.20,0:04:53.20,Default,,0000,0000,0000,,Иә? Қандай жолмен?
Dialogue: 0,0:04:53.20,0:04:56.34,Rubi,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:04:53.20,0:04:56.34,Default,,0000,0000,0000,,Иә, менің ішімде.
Dialogue: 0,0:04:53.20,0:04:56.34,Rubi,,0000,0000,0000,,Тера
Dialogue: 0,0:04:53.20,0:04:56.34,Rubi,,0000,0000,0000,,Ошо
Dialogue: 0,0:04:53.20,0:04:56.34,Default,,0000,0000,0000,,Ғибадатхананың діни қызметкері
Dialogue: 0,0:04:56.34,0:05:00.85,Rubi,,0000,0000,0000,,Чоши
Dialogue: 0,0:04:56.34,0:05:00.85,Rubi,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:04:56.34,0:05:00.85,Default,,0000,0000,0000,,Ырғақты күйде
Dialogue: 0,0:04:56.34,0:05:00.85,Rubi,,0000,0000,0000,,Ақша
Dialogue: 0,0:04:56.34,0:05:00.85,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:04:56.34,0:05:00.85,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:04:56.34,0:05:00.85,Default,,0000,0000,0000,,Қоңырау соққан сияқты.
Dialogue: 0,0:05:00.85,0:05:02.78,Default,,0000,0000,0000,,Күлкілі
Dialogue: 0,0:05:02.78,0:05:04.72,Default,,0000,0000,0000,,Аташа
Dialogue: 0,0:05:02.78,0:05:04.72,Rubi,,0000,0000,0000,,Сентакумоно
Dialogue: 0,0:05:02.78,0:05:04.72,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:05:02.78,0:05:04.72,Default,,0000,0000,0000,,Кірді қойыңыз.
Dialogue: 0,0:05:04.72,0:05:08.72,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:05:04.72,0:05:08.72,Default,,0000,0000,0000,,О, күте тұрыңыз!
Dialogue: 0,0:05:04.72,0:05:08.72,Rubi,,0000,0000,0000,,Шин
Dialogue: 0,0:05:04.72,0:05:08.72,Default,,0000,0000,0000,,А... сеніңізші!
Dialogue: 0,0:05:08.72,0:05:10.86,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:05:10.86,0:05:14.36,Default,,0000,0000,0000,,《Егер жағдай осылай жалғаса берсе мен не істеуім керек?
Dialogue: 0,0:05:10.86,0:05:14.36,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:05:10.86,0:05:14.36,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:05:10.86,0:05:14.36,Default,,0000,0000,0000,,Үйде өлу
Dialogue: 0,0:05:14.36,0:05:17.26,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:05:14.36,0:05:17.26,Default,,0000,0000,0000,,Уф, ауырып тұр.
Dialogue: 0,0:05:14.36,0:05:17.26,Default,,0000,0000,0000,,Қалсам да тұра алмаймын
Dialogue: 0,0:05:17.26,0:05:20.23,Rubi,,0000,0000,0000,,Құдай
Dialogue: 0,0:05:17.26,0:05:20.23,Default,,0000,0000,0000,,Ей, Құдай, бірдеңе істе.
Dialogue: 0,0:05:17.26,0:05:20.23,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:05:17.26,0:05:20.23,Default,,0000,0000,0000,,Бір жақсылық, өтінемін》
Dialogue: 0,0:05:20.23,0:05:23.80,Rubi,,0000,0000,0000,,Құдай
Dialogue: 0,0:05:20.23,0:05:23.80,Default,,0000,0000,0000,,<Құдайға да
Dialogue: 0,0:05:20.23,0:05:23.80,Rubi,,0000,0000,0000,,Рейги
Dialogue: 0,0:05:20.23,0:05:23.80,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:05:20.23,0:05:23.80,Rubi,,0000,0000,0000,,Кел
Dialogue: 0,0:05:20.23,0:05:23.80,Default,,0000,0000,0000,,Қасиетсіздігі соншалықты азапты>
Dialogue: 0,0:05:23.80,0:05:26.70,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:23.80,0:05:26.70,Default,,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:05:23.80,0:05:26.70,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:05:23.80,0:05:26.70,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:23.80,0:05:26.70,Default,,0000,0000,0000,,Мен дәрігерге барғым келеді.
Dialogue: 0,0:05:26.70,0:05:29.31,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:05:26.70,0:05:29.31,Default,,0000,0000,0000,,Не? дәрігер?
