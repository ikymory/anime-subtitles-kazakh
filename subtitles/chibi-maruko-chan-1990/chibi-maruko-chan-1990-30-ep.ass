Dialogue: 0,0:22:30.61,0:22:34.61,Default,,0000,0000,0000,,Мару-чан жалғыз
Dialogue: 0,0:22:30.61,0:22:34.61,Rubi,,0000,0000,0000,,Гойя
Dialogue: 0,0:22:30.61,0:22:34.61,Rubi,,0000,0000,0000,,Тазалау
Dialogue: 0,0:22:30.61,0:22:34.61,Default,,0000,0000,0000,,Қоянның қорасын тазалады＞
Dialogue: 0,0:22:35.48,0:22:37.48,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:22:35.48,0:22:37.48,Default,,0000,0000,0000,,Қараңыз, тамақтаныңыз.
Dialogue: 0,0:22:44.62,0:22:46.56,Default,,0000,0000,0000,,<және
Dialogue: 0,0:22:44.62,0:22:46.56,Default,,0000,0000,0000,,Ақырында Мару-чан
