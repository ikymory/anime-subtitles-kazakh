Dialogue: 0,0:20:19.01,0:20:20.61,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:20:20.61,0:20:23.11,Rubi,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:20:20.61,0:20:23.11,Default,,0000,0000,0000,,Амансың ба? Мару-чан
Dialogue: 0,0:20:24.48,0:20:27.48,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:20:24.48,0:20:27.48,Default,,0000,0000,0000,,Ал, көзіңді жұм.
Dialogue: 0,0:20:24.48,0:20:27.48,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:20:24.48,0:20:27.48,Rubi,,0000,0000,0000,,Джи
Dialogue: 0,0:20:24.48,0:20:27.48,Default,,0000,0000,0000,,Мен аштан өлмеймін.
Dialogue: 0,0:20:27.48,0:20:30.48,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:20:27.48,0:20:30.48,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:20:27.48,0:20:30.48,Default,,0000,0000,0000,,<Оны артық жеу деп атайды.
Dialogue: 0,0:20:27.48,0:20:30.48,Rubi,,0000,0000,0000,,Шиин
Dialogue: 0,0:20:27.48,0:20:30.48,Default,,0000,0000,0000,,Өлім себебі де бар...>
Dialogue: 0,0:20:37.63,0:20:42.13,Default,,0000,0000,0000,,Қояндар осындай
Dialogue: 0,0:20:37.63,0:20:42.13,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:20:37.63,0:20:42.13,Default,,0000,0000,0000,,Мен оны сүйкімді деп ойламадым
Dialogue: 0,0:20:42.13,0:20:46.00,Rubi,,0000,0000,0000,,Маэба
Dialogue: 0,0:20:42.13,0:20:46.00,Default,,0000,0000,0000,,Алдыңғы тістері бар тағам
Dialogue: 0,0:20:42.13,0:20:46.00,Default,,0000,0000,0000,,Қатты.
Dialogue: 0,0:20:46.00,0:20:49.01,Rubi,,0000,0000,0000,,Гучи
Dialogue: 0,0:20:46.00,0:20:49.01,Default,,0000,0000,0000,,Аузыңда мынаны айтасың
Dialogue: 0,0:20:46.00,0:20:49.01,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:20:46.00,0:20:49.01,Default,,0000,0000,0000,,Жеңдер.
Dialogue: 0,0:20:49.01,0:20:50.01,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:20:49.01,0:20:50.01,Default,,0000,0000,0000,,Хо
Dialogue: 0,0:20:50.01,0:20:52.64,Default,,0000,0000,0000,,Бұл сүйкімді, солай емес пе?
Dialogue: 0,0:20:52.64,0:20:57.64,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:20:52.64,0:20:57.64,Rubi,,0000,0000,0000,,Гойя
Dialogue: 0,0:20:52.64,0:20:57.64,Default,,0000,0000,0000,,Маруко осындай қоянның қорасында болар еді
Dialogue: 0,0:20:52.64,0:20:57.64,Rubi,,0000,0000,0000,,Тазалау
Dialogue: 0,0:20:52.64,0:20:57.64,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:20:52.64,0:20:57.64,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:20:52.64,0:20:57.64,Default,,0000,0000,0000,,Тазалыққа баруды жек көрсем де.
Dialogue: 0,0:20:58.52,0:20:59.52,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:20:59.52,0:21:02.45,Default,,0000,0000,0000,,Барлық қояндар
Dialogue: 0,0:20:59.52,0:21:02.45,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:20:59.52,0:21:02.45,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:20:59.52,0:21:02.45,Default,,0000,0000,0000,,Сен оған ғашық болып қалған сияқтысың.
Dialogue: 0,0:21:02.45,0:21:04.59,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:21:02.45,0:21:04.59,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:21:02.45,0:21:04.59,Default,,0000,0000,0000,,Иә, маған ұнады.
Dialogue: 0,0:21:04.59,0:21:08.09,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:21:04.59,0:21:08.09,Default,,0000,0000,0000,,Хун тағы сүйкімді
Dialogue: 0,0:21:08.09,0:21:12.60,Default,,0000,0000,0000,,Осылай.
Dialogue: 0,0:21:08.09,0:21:12.60,Default,,0000,0000,0000,,Мен айналамын
Dialogue: 0,0:21:12.60,0:21:16.47,Rubi,,0000,0000,0000,,Оқиға
Dialogue: 0,0:21:12.60,0:21:16.47,Default,,0000,0000,0000,,Бүгін қылыш айналдыру жаттығуын жасадым
Dialogue: 0,0:21:12.60,0:21:16.47,Default,,0000,0000,0000,,Тек тоқтаңыз.
Dialogue: 0,0:21:16.47,0:21:18.47,Default,,0000,0000,0000,,Аа, кешіріңіз.
Dialogue: 0,0:21:18.47,0:21:23.11,Default,,0000,0000,0000,,Сондықтан мен
Dialogue: 0,0:21:18.47,0:21:23.11,Rubi,,0000,0000,0000,,Ганба
Dialogue: 0,0:21:18.47,0:21:23.11,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:21:18.47,0:21:23.11,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:21:18.47,0:21:23.11,Default,,0000,0000,0000,,Мен де бар күшімді саламын, ертең де мектепке барамын.
Dialogue: 0,0:21:23.11,0:21:25.61,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:21:23.11,0:21:25.61,Default,,0000,0000,0000,,Мен Уса-чанмен танысқым келеді~
Dialogue: 0,0:21:25.61,0:21:30.11,Rubi,,0000,0000,0000,,Көлік департаменті
Dialogue: 0,0:21:25.61,0:21:30.11,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:21:25.61,0:21:30.11,Default,,0000,0000,0000,,<Оны мектеп қызметкерлері бөлмесіне апарыңыз.
Dialogue: 0,0:21:25.61,0:21:30.11,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:21:25.61,0:21:30.11,Default,,0000,0000,0000,,Маған шырын мен печенье ұнаса да＞
Dialogue: 0,0:21:35.12,0:21:38.12,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:21:35.12,0:21:38.12,Default,,0000,0000,0000,,《Ұйықтадың ба, Уса-чан? 》
Dialogue: 0,0:21:46.13,0:21:48.63,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:21:46.13,0:21:48.63,Default,,0000,0000,0000,,《Ге... білмеймін! 》
Dialogue: 0,0:21:48.63,0:21:50.13,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:21:50.13,0:21:54.00,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:21:50.13,0:21:54.00,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:21:50.13,0:21:54.00,Default,,0000,0000,0000,,(цикаданың шырылдауы)
