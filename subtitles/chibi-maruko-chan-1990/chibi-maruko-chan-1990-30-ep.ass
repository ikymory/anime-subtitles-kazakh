Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:03.09,0:01:13.59,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:08.15,0:03:10.65,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:03:08.15,0:03:10.65,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:03:08.15,0:03:10.65,Default,,0000,0000,0000,,(цикаданың шырылдауы)
Dialogue: 0,0:03:10.65,0:03:15.52,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:10.65,0:03:15.52,Default,,0000,0000,0000,,(Маруко)
Dialogue: 0,0:03:10.65,0:03:15.52,Rubi,,0000,0000,0000,,Өрмекші
Dialogue: 0,0:03:10.65,0:03:15.52,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:03:10.65,0:03:15.52,Default,,0000,0000,0000,,А, бұлттар қалқып тұр...
Dialogue: 0,0:03:15.52,0:03:19.16,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:03:15.52,0:03:19.16,Default,,0000,0000,0000,,Ах, цикадалар шырылдап жатыр...
Dialogue: 0,0:03:19.16,0:03:22.06,Rubi,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:03:19.16,0:03:22.06,Default,,0000,0000,0000,,Күнбағыс та гүлдеп жатыр...
Dialogue: 0,0:03:22.06,0:03:25.06,Rubi,,0000,0000,0000,,Жаз
Dialogue: 0,0:03:22.06,0:03:25.06,Default,,0000,0000,0000,,Аа, жаз ғой, солай емес пе?
Dialogue: 0,0:03:26.96,0:03:30.10,Default,,0000,0000,0000,,Ах~аа йо~ах~а...
Dialogue: 0,0:03:30.10,0:03:34.97,Rubi,,0000,0000,0000,,Нацуба
Dialogue: 0,0:03:30.10,0:03:34.97,Default,,0000,0000,0000,,Керемет. Жазда
Dialogue: 0,0:03:30.10,0:03:34.97,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:03:30.10,0:03:34.97,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:03:30.10,0:03:34.97,Rubi,,0000,0000,0000,,Көпшілігі
Dialogue: 0,0:03:30.10,0:03:34.97,Default,,0000,0000,0000,,Ең жақсы орын - тақталар арасы.
Dialogue: 0,0:03:34.97,0:03:39.11,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:34.97,0:03:39.11,Default,,0000,0000,0000,,Маруко! Сіз
Dialogue: 0,0:03:34.97,0:03:39.11,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:03:34.97,0:03:39.11,Default,,0000,0000,0000,,Тағы да сондай жерде былғау!
Dialogue: 0,0:03:39.11,0:03:41.05,Rubi,,0000,0000,0000,,Жазғы демалыс
Dialogue: 0,0:03:39.11,0:03:41.05,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:03:39.11,0:03:41.05,Default,,0000,0000,0000,,Жалпы, жазғы демалыс басталғаннан бері.
Dialogue: 0,0:03:41.05,0:03:42.98,Default,,0000,0000,0000,,Әрқашан солай
Dialogue: 0,0:03:41.05,0:03:42.98,Default,,0000,0000,0000,,Дала дара дара хула
Dialogue: 0,0:03:42.98,0:03:45.62,Default,,0000,0000,0000,,Иә, иә, иә…
Dialogue: 0,0:03:42.98,0:03:45.62,Default,,0000,0000,0000,,Керіскерлер тобы
Dialogue: 0,0:03:45.62,0:03:49.49,Rubi,,0000,0000,0000,,Гозенчу
Dialogue: 0,0:03:45.62,0:03:49.49,Rubi,,0000,0000,0000,,Қалайы
Dialogue: 0,0:03:45.62,0:03:49.49,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:03:45.62,0:03:49.49,Default,,0000,0000,0000,,«Таңертең салқын кезде үй тапсырмасын орында.
Dialogue: 0,0:03:45.62,0:03:49.49,Default,,0000,0000,0000,,Жаса, солай ма?
Dialogue: 0,0:03:49.49,0:03:52.12,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:03:49.49,0:03:52.12,Default,,0000,0000,0000,,Иә, кеттік...
Dialogue: 0,0:03:52.12,0:03:54.63,Default,,0000,0000,0000,,Иә иә иә иә
Dialogue: 0,0:03:54.63,0:03:56.13,Default,,0000,0000,0000,,Бұл жәндік емес.
Dialogue: 0,0:03:56.13,0:03:59.63,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:56.13,0:03:59.63,Default,,0000,0000,0000,,Сенің анаң болса
Dialogue: 0,0:03:56.13,0:03:59.63,Rubi,,0000,0000,0000,,Жазғы демалыс
Dialogue: 0,0:03:56.13,0:03:59.63,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:03:56.13,0:03:59.63,Default,,0000,0000,0000,,Жазғы демалысқа шыққаннан кейін
Dialogue: 0,0:03:59.63,0:04:03.13,Rubi,,0000,0000,0000,,Око
Dialogue: 0,0:03:59.63,0:04:03.13,Default,,0000,0000,0000,,Тек ашулы
Dialogue: 0,0:03:59.63,0:04:03.13,Default,,0000,0000,0000,,Басқа істейтін ісіңіз жоқ па?
Dialogue: 0,0:04:03.13,0:04:07.00,Rubi,,0000,0000,0000,,Ересек
Dialogue: 0,0:04:03.13,0:04:07.00,Default,,0000,0000,0000,,Шынымен ересектер
Dialogue: 0,0:04:03.13,0:04:07.00,Rubi,,0000,0000,0000,,Кираку
Dialogue: 0,0:04:03.13,0:04:07.00,Default,,0000,0000,0000,,Жеңіл деп қызғанамын.
Dialogue: 0,0:04:07.00,0:04:12.14,Default,,0000,0000,0000,,Жарайды, менің шаруам жоқ.
Dialogue: 0,0:04:07.00,0:04:12.14,Rubi,,0000,0000,0000,,Эникки
Dialogue: 0,0:04:07.00,0:04:12.14,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:07.00,0:04:12.14,Default,,0000,0000,0000,,Мүмкін суретті күнделік жазу керек шығар
Dialogue: 0,0:04:12.14,0:04:17.01,Rubi,,0000,0000,0000,,Жазғы демалыс
Dialogue: 0,0:04:12.14,0:04:17.01,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:04:12.14,0:04:17.01,Default,,0000,0000,0000,,Иә? иә? Жазғы демалысқа кіру
Dialogue: 0,0:04:12.14,0:04:17.01,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:04:12.14,0:04:17.01,Default,,0000,0000,0000,,Екі апта болды ма?
Dialogue: 0,0:04:17.01,0:04:19.65,Rubi,,0000,0000,0000,,Цукихи
Dialogue: 0,0:04:17.01,0:04:19.65,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:04:17.01,0:04:19.65,Default,,0000,0000,0000,,Күндер өте тез өтеді.
Dialogue: 0,0:04:19.65,0:04:24.49,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:04:19.65,0:04:24.49,Default,,0000,0000,0000,,Хмм, соңғы екі апта.
Dialogue: 0,0:04:19.65,0:04:24.49,Default,,0000,0000,0000,,Менің істегенім...
Dialogue: 0,0:04:24.49,0:04:28.46,Default,,0000,0000,0000,,<Мару-чанның
Dialogue: 0,0:04:24.49,0:04:28.46,Rubi,,0000,0000,0000,,Жазғы демалыс
Dialogue: 0,0:04:24.49,0:04:28.46,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:04:24.49,0:04:28.46,Rubi,,0000,0000,0000,,Сейкацу
Dialogue: 0,0:04:24.49,0:04:28.46,Default,,0000,0000,0000,,Жазғы демалыстан кейінгі өмір...＞
Dialogue: 0,0:04:28.46,0:04:32.10,Rubi,,0000,0000,0000,,Хиручика
Dialogue: 0,0:04:28.46,0:04:32.10,Default,,0000,0000,0000,,＜Түске жақын болды
Dialogue: 0,0:04:28.46,0:04:32.10,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:04:28.46,0:04:32.10,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:04:28.46,0:04:32.10,Default,,0000,0000,0000,,Ақыры тұрды>
Dialogue: 0,0:04:32.10,0:04:36.10,Rubi,,0000,0000,0000,,Асахиру денсаулығы
Dialogue: 0,0:04:32.10,0:04:36.10,Rubi,,0000,0000,0000,,Шокуджи
Dialogue: 0,0:04:32.10,0:04:36.10,Default,,0000,0000,0000,,<Таңғы және түскі асқа арналған тағамдар
Dialogue: 0,0:04:32.10,0:04:36.10,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:04:32.10,0:04:36.10,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:04:32.10,0:04:36.10,Default,,0000,0000,0000,,Бір сағаттан артық тамақтаныңыз＞
Dialogue: 0,0:04:41.11,0:04:44.11,Default,,0000,0000,0000,,<Сол әдет
Dialogue: 0,0:04:41.11,0:04:44.11,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:04:41.11,0:04:44.11,Default,,0000,0000,0000,,Жеткілікті тағамдар жеңіз＞
Dialogue: 0,0:04:47.61,0:04:49.61,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:47.61,0:04:49.61,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:04:47.61,0:04:49.61,Default,,0000,0000,0000,,＜Сатып алыңыз және жақсы тамақтаныңыз＞
Dialogue: 0,0:04:50.51,0:04:55.01,Rubi,,0000,0000,0000,,сәйкес
Dialogue: 0,0:04:50.51,0:04:55.01,Rubi,,0000,0000,0000,,сәйкес
Dialogue: 0,0:04:50.51,0:04:55.01,Rubi,,0000,0000,0000,,Сағат он бір
Dialogue: 0,0:04:50.51,0:04:55.01,Default,,0000,0000,0000,,<Түн түн және «23:00»
Dialogue: 0,0:04:50.51,0:04:55.01,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:04:50.51,0:04:55.01,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:04:50.51,0:04:55.01,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:50.51,0:04:55.01,Default,,0000,0000,0000,,Теледидарды ол басталғанша қараңыз >
Dialogue: 0,0:04:56.62,0:05:01.12,Rubi,,0000,0000,0000,,Хиру
Dialogue: 0,0:04:56.62,0:05:01.12,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:04:56.62,0:05:01.12,Default,,0000,0000,0000,,<Тағы түске дейін ұйықта...
Dialogue: 0,0:04:56.62,0:05:01.12,Rubi,,0000,0000,0000,,Күнделікті
Dialogue: 0,0:04:56.62,0:05:01.12,Default,,0000,0000,0000,,Әр күн солай＞
Dialogue: 0,0:05:02.49,0:05:04.49,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:05:06.63,0:05:10.50,Rubi,,0000,0000,0000,,Гецу
Dialogue: 0,0:05:06.63,0:05:10.50,Default,,0000,0000,0000,,Бұл әлі бір ай қалғанын білдіреді.
Dialogue: 0,0:05:06.63,0:05:10.50,Rubi,,0000,0000,0000,,Сейкацу
Dialogue: 0,0:05:06.63,0:05:10.50,Default,,0000,0000,0000,,Сіз осылай өмір сүре аласыз.
Dialogue: 0,0:05:10.50,0:05:15.64,Rubi,,0000,0000,0000,,Арман
Dialogue: 0,0:05:10.50,0:05:15.64,Rubi,,0000,0000,0000,,Күн сайын
Dialogue: 0,0:05:10.50,0:05:15.64,Default,,0000,0000,0000,,Хехехе... Әр күнім түс сияқты өтті.
Dialogue: 0,0:05:10.50,0:05:15.64,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:10.50,0:05:15.64,Default,,0000,0000,0000,,Мынаны айтасыз.
Dialogue: 0,0:05:15.64,0:05:18.14,Default,,0000,0000,0000,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:05:18.14,0:05:21.65,Rubi,,0000,0000,0000,,Арман
Dialogue: 0,0:05:18.14,0:05:21.65,Default,,0000,0000,0000,,<Бірақ арман
Dialogue: 0,0:05:18.14,0:05:21.65,Rubi,,0000,0000,0000,,Ұзын
Dialogue: 0,0:05:18.14,0:05:21.65,Rubi,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:05:18.14,0:05:21.65,Default,,0000,0000,0000,,Бұл ұзаққа созылмайды＞
Dialogue: 0,0:05:21.65,0:05:25.08,Rubi,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:05:21.65,0:05:25.08,Rubi,,0000,0000,0000,,Бангими
Dialogue: 0,0:05:21.65,0:05:25.08,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:05:21.65,0:05:25.08,Default,,0000,0000,0000,,《Мен бүгін кешке анау-мынау бағдарламаны көрдім.
Dialogue: 0,0:05:25.08,0:05:27.02,Default,,0000,0000,0000,,Ах! Кейбір дрейфтер де бар
Dialogue: 0,0:05:27.02,0:05:30.96,Rubi,,0000,0000,0000,,Минога
Dialogue: 0,0:05:27.02,0:05:30.96,Default,,0000,0000,0000,,Сіз мұны жіберіп алмайсыз
Dialogue: 0,0:05:27.02,0:05:30.96,Rubi,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:05:27.02,0:05:30.96,Default,,0000,0000,0000,,Мүлдем! Иә》
Dialogue: 0,0:05:30.96,0:05:34.09,Default,,0000,0000,0000,,...
Dialogue: 0,0:05:30.96,0:05:34.09,Default,,0000,0000,0000,,Оның бибанононы»
Dialogue: 0,0:05:34.09,0:05:36.59,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:34.09,0:05:36.59,Default,,0000,0000,0000,,Олай болса, анашым.
Dialogue: 0,0:05:34.09,0:05:36.59,Rubi,,0000,0000,0000,,Джихан
Dialogue: 0,0:05:34.09,0:05:36.59,Default,,0000,0000,0000,,Ертең 7:30.
Dialogue: 0,0:05:36.59,0:05:39.10,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:05:36.59,0:05:39.10,Default,,0000,0000,0000,,Мен оятқышты орнатамын.
Dialogue: 0,0:05:36.59,0:05:39.10,Rubi,,0000,0000,0000,,Сөздік
Dialogue: 0,0:05:36.59,0:05:39.10,Default,,0000,0000,0000,,Себебі менде сенім жоқ
Dialogue: 0,0:05:39.10,0:05:41.03,Default,,0000,0000,0000,,Иә, иә, түсіндім.
Dialogue: 0,0:05:41.03,0:05:42.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:43.97,0:05:46.97,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:05:43.97,0:05:46.97,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:43.97,0:05:46.97,Default,,0000,0000,0000,,Әпке, ертең бірдеңе бола ма?
Dialogue: 0,0:05:43.97,0:05:46.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:46.97,0:05:50.11,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:46.97,0:05:50.11,Default,,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:05:46.97,0:05:50.11,Rubi,,0000,0000,0000,,Шимин
Dialogue: 0,0:05:46.97,0:05:50.11,Default,,0000,0000,0000,,Әй, қоғамдық бассейн?
Dialogue: 0,0:05:50.11,0:05:53.61,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:50.11,0:05:53.61,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:50.11,0:05:53.61,Default,,0000,0000,0000,,Эй, Маруко да барғысы келеді.
Dialogue: 0,0:05:50.11,0:05:53.61,Rubi,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:05:50.11,0:05:53.61,Default,,0000,0000,0000,,Мені өзіңізбен бірге алыңыз~
Dialogue: 0,0:05:53.61,0:05:55.55,Default,,0000,0000,0000,,Сен ақымақсың.
Dialogue: 0,0:05:53.61,0:05:55.55,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:55.55,0:05:59.12,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:05:55.55,0:05:59.12,Default,,0000,0000,0000,,Мектеп
Dialogue: 0,0:05:55.55,0:05:59.12,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:55.55,0:05:59.12,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:55.55,0:05:59.12,Default,,0000,0000,0000,,Тіпті Маруко да барады, солай ма?
Dialogue: 0,0:05:59.12,0:06:01.62,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:05:59.12,0:06:01.62,Default,,0000,0000,0000,,Мектеп
Dialogue: 0,0:06:01.62,0:06:05.12,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:06:01.62,0:06:05.12,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:01.62,0:06:05.12,Default,,0000,0000,0000,,Әй, мектеп деген не?
Dialogue: 0,0:06:01.62,0:06:05.12,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:06:01.62,0:06:05.12,Default,,0000,0000,0000,,Неге бара жатырсың?
Dialogue: 0,0:06:05.12,0:06:08.03,Rubi,,0000,0000,0000,,Жүгері
Dialogue: 0,0:06:05.12,0:06:08.03,Default,,0000,0000,0000,,Ертең мектептегі бірінші күнің, солай ма?
Dialogue: 0,0:06:08.03,0:06:10.63,Rubi,,0000,0000,0000,,Жүгері
Dialogue: 0,0:06:08.03,0:06:10.63,Default,,0000,0000,0000,,Мектеп күні…
Dialogue: 0,0:06:10.63,0:06:13.13,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:06:10.63,0:06:13.13,Default,,0000,0000,0000,,Сіз ұмыттыңыз.
Dialogue: 0,0:06:13.13,0:06:14.63,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:16.03,0:06:19.64,Rubi,,0000,0000,0000,,Джи
Dialogue: 0,0:06:16.03,0:06:19.64,Default,,0000,0000,0000,,Ха... осы күндері сағат 8-ге дейін.
Dialogue: 0,0:06:16.03,0:06:19.64,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:06:16.03,0:06:19.64,Rubi,,0000,0000,0000,,О
Dialogue: 0,0:06:16.03,0:06:19.64,Default,,0000,0000,0000,,Себебі мен көп ұйықтадым
Dialogue: 0,0:06:19.64,0:06:22.54,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:06:19.64,0:06:22.54,Default,,0000,0000,0000,,Жай ғана оятқыш
Dialogue: 0,0:06:19.64,0:06:22.54,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:06:19.64,0:06:22.54,Rubi,,0000,0000,0000,,Сөздік
Dialogue: 0,0:06:19.64,0:06:22.54,Default,,0000,0000,0000,,Менің оянуға сенімім жоқ.
Dialogue: 0,0:06:22.54,0:06:25.04,Rubi,,0000,0000,0000,,Электр энергиясы
Dialogue: 0,0:06:22.54,0:06:25.04,Rubi,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:06:22.54,0:06:25.04,Default,,0000,0000,0000,,Шамдарды өшіріңіз.
Dialogue: 0,0:06:22.54,0:06:25.04,Default,,0000,0000,0000,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:06:27.08,0:06:29.58,Default,,0000,0000,0000,,О...
Dialogue: 0,0:06:29.58,0:06:32.48,Rubi,,0000,0000,0000,,Күнделікті
Dialogue: 0,0:06:29.58,0:06:32.48,Default,,0000,0000,0000,,<Содан кейін күн сайын
Dialogue: 0,0:06:29.58,0:06:32.48,Rubi,,0000,0000,0000,,Хиру
Dialogue: 0,0:06:29.58,0:06:32.48,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:06:29.58,0:06:32.48,Default,,0000,0000,0000,,Мару-чан түске дейін ұйықтайды
Dialogue: 0,0:06:32.48,0:06:34.98,Default,,0000,0000,0000,,Жер бетінде қалай?
Dialogue: 0,0:06:32.48,0:06:34.98,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:06:32.48,0:06:34.98,Default,,0000,0000,0000,,Жай ғана ояныңыз>
Dialogue: 0,0:06:37.46,0:06:42.09,Rubi,,0000,0000,0000,,Нейки
Dialogue: 0,0:06:37.46,0:06:42.09,Default,,0000,0000,0000,,(Сакиконың ұйқысы)
Dialogue: 0,0:06:42.09,0:06:44.09,Rubi,,0000,0000,0000,,Даиичи
Dialogue: 0,0:06:42.09,0:06:44.09,Rubi,,0000,0000,0000,,Нему
Dialogue: 0,0:06:42.09,0:06:44.09,Default,,0000,0000,0000,,<Бірінші: Мен ұйықтай алмаймын...>
Dialogue: 0,0:06:45.60,0:06:49.47,Rubi,,0000,0000,0000,,Жоғарғы
Dialogue: 0,0:06:45.60,0:06:49.47,Default,,0000,0000,0000,,Мен қиындыққа тап болдым.
Dialogue: 0,0:06:45.60,0:06:49.47,Rubi,,0000,0000,0000,,Нему
Dialogue: 0,0:06:45.60,0:06:49.47,Default,,0000,0000,0000,,Мен мүлдем ұйықтамаймын...
Dialogue: 0,0:06:49.47,0:06:53.47,Rubi,,0000,0000,0000,,Басы
Dialogue: 0,0:06:49.47,0:06:53.47,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:06:49.47,0:06:53.47,Default,,0000,0000,0000,,Мен жақында сағат 11-ге дейін ұйықтадым.
Dialogue: 0,0:06:49.47,0:06:53.47,Default,,0000,0000,0000,,Өйткені ол жоқ еді.
Dialogue: 0,0:06:54.61,0:06:59.48,Default,,0000,0000,0000,,Иа... Хмм ой...
Dialogue: 0,0:06:59.48,0:07:04.11,Rubi,,0000,0000,0000,,Қой
Dialogue: 0,0:06:59.48,0:07:04.11,Rubi,,0000,0000,0000,,Пики
Dialogue: 0,0:06:59.48,0:07:04.11,Default,,0000,0000,0000,,Міне, бір қой... да бар.
Dialogue: 0,0:06:59.48,0:07:04.11,Default,,0000,0000,0000,,Ол жерде жоқ.
Dialogue: 0,0:07:04.11,0:07:08.99,Default,,0000,0000,0000,,Ооо... ха...
Dialogue: 0,0:07:08.99,0:07:12.62,Default,,0000,0000,0000,,Мен-мен... Иә, сие!
Dialogue: 0,0:07:12.62,0:07:16.13,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:12.62,0:07:16.13,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:07:12.62,0:07:16.13,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:12.62,0:07:16.13,Default,,0000,0000,0000,,Маруко, оян. Маруко
Dialogue: 0,0:07:16.13,0:07:19.03,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:07:16.13,0:07:19.03,Default,,0000,0000,0000,,Таң болды ма?
Dialogue: 0,0:07:16.13,0:07:19.03,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:07:16.13,0:07:19.03,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:07:16.13,0:07:19.03,Default,,0000,0000,0000,,Мен сені ұйықтап қалды деп ойладым
Dialogue: 0,0:07:19.03,0:07:23.57,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:19.03,0:07:23.57,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:19.03,0:07:23.57,Default,,0000,0000,0000,,Не айтып тұрсың! Жалқау
Dialogue: 0,0:07:19.03,0:07:23.57,Rubi,,0000,0000,0000,,Сейкацу
Dialogue: 0,0:07:19.03,0:07:23.57,Default,,0000,0000,0000,,Өз өміріңмен өмір сүретіндіктен солай болады!
Dialogue: 0,0:07:23.57,0:07:27.07,Rubi,,0000,0000,0000,,Жүгері
Dialogue: 0,0:07:23.57,0:07:27.07,Default,,0000,0000,0000,,Хмм, неге мектеп күні?
Dialogue: 0,0:07:23.57,0:07:27.07,Default,,0000,0000,0000,,Менің ойымша...
Dialogue: 0,0:07:27.07,0:07:30.57,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:27.07,0:07:30.57,Default,,0000,0000,0000,,Сіз сияқты балаларға арналған
Dialogue: 0,0:07:27.07,0:07:30.57,Default,,0000,0000,0000,,Менде бар. мен барамын.
Dialogue: 0,0:07:30.57,0:07:32.57,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:07:30.57,0:07:32.57,Default,,0000,0000,0000,,Бұл уақыт әлдеқашан
Dialogue: 0,0:07:35.45,0:07:41.09,Default,,0000,0000,0000,,Ха ха ха ха... Жақсы.
Dialogue: 0,0:07:35.45,0:07:41.09,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:07:35.45,0:07:41.09,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:35.45,0:07:41.09,Default,,0000,0000,0000,,Мен оны уақытында орындадым
Dialogue: 0,0:07:41.09,0:07:42.59,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:07:42.59,0:07:43.59,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:44.52,0:07:48.09,Rubi,,0000,0000,0000,,Уваба
Dialogue: 0,0:07:44.52,0:07:48.09,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:07:44.52,0:07:48.09,Default,,0000,0000,0000,,Жоқ, мен жабық аяқ киімімді ұмытып кетіппін.
Dialogue: 0,0:07:48.09,0:07:51.96,Rubi,,0000,0000,0000,,Шугёшики
Dialogue: 0,0:07:48.09,0:07:51.96,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:07:48.09,0:07:51.96,Default,,0000,0000,0000,,Жабылу салтанаты күні
Dialogue: 0,0:07:48.09,0:07:51.96,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:07:48.09,0:07:51.96,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:07:48.09,0:07:51.96,Default,,0000,0000,0000,,Үйге әкелгенім үшін...
Dialogue: 0,0:07:51.96,0:07:54.60,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:07:51.96,0:07:54.60,Default,,0000,0000,0000,,Сакура-сан!
Dialogue: 0,0:07:51.96,0:07:54.60,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:54.60,0:07:59.10,Rubi,,0000,0000,0000,,Уваба
Dialogue: 0,0:07:54.60,0:07:59.10,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:07:54.60,0:07:59.10,Default,,0000,0000,0000,,Сіз ішкі аяқ киіміңізді ұмытып қалдыңыз.
Dialogue: 0,0:07:54.60,0:07:59.10,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:07:59.10,0:08:03.61,Default,,0000,0000,0000,,Иә, дәл солай.
Dialogue: 0,0:07:59.10,0:08:03.61,Rubi,,0000,0000,0000,,Жоғарғы
Dialogue: 0,0:07:59.10,0:08:03.61,Default,,0000,0000,0000,,Мен қиындыққа тап болдым.
Dialogue: 0,0:08:03.61,0:08:07.48,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:08:03.61,0:08:07.48,Default,,0000,0000,0000,,Түсінікті. Сынып өкілі ретінде.
Dialogue: 0,0:08:03.61,0:08:07.48,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:08:03.61,0:08:07.48,Default,,0000,0000,0000,,Мен мұғаліммін
Dialogue: 0,0:08:07.48,0:08:10.11,Default,,0000,0000,0000,,тәпішкелер
Dialogue: 0,0:08:07.48,0:08:10.11,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:08:07.48,0:08:10.11,Default,,0000,0000,0000,,Оны сізге қарызға алуға рұқсат етіңіз.
Dialogue: 0,0:08:10.11,0:08:14.62,Default,,0000,0000,0000,,Уау, шынымен бе?
Dialogue: 0,0:08:10.11,0:08:14.62,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:08:10.11,0:08:14.62,Default,,0000,0000,0000,,Иә! Жарайды онда
Dialogue: 0,0:08:14.62,0:08:18.12,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:08:14.62,0:08:18.12,Rubi,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:08:14.62,0:08:18.12,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:08:14.62,0:08:18.12,Default,,0000,0000,0000,,Не, сен де өзіңді ұмыттың ба?
Dialogue: 0,0:08:18.12,0:08:20.06,Rubi,,0000,0000,0000,,Сеито
Dialogue: 0,0:08:18.12,0:08:20.06,Rubi,,0000,0000,0000,,Дыбыс
Dialogue: 0,0:08:18.12,0:08:20.06,Default,,0000,0000,0000,,(оқушылардың қатты дауыстары)
Dialogue: 0,0:08:20.06,0:08:24.56,Rubi,,0000,0000,0000,,Маруо
Dialogue: 0,0:08:20.06,0:08:24.56,Rubi,,0000,0000,0000,,Орихара-кун
Dialogue: 0,0:08:20.06,0:08:24.56,Default,,0000,0000,0000,,Шынымды айтсам, Орихара-кун.
Dialogue: 0,0:08:20.06,0:08:24.56,Rubi,,0000,0000,0000,,Ненджу
Dialogue: 0,0:08:20.06,0:08:24.56,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:08:20.06,0:08:24.56,Rubi,,0000,0000,0000,,Қара
Dialogue: 0,0:08:20.06,0:08:24.56,Default,,0000,0000,0000,,Жыл бойы тас қараңғы.
Dialogue: 0,0:08:24.56,0:08:27.46,Default,,0000,0000,0000,,Я~
Dialogue: 0,0:08:24.56,0:08:27.46,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:08:24.56,0:08:27.46,Rubi,,0000,0000,0000,,Инака
Dialogue: 0,0:08:24.56,0:08:27.46,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:24.56,0:08:27.46,Default,,0000,0000,0000,,Сен анаңның ауылына бардың ба?
Dialogue: 0,0:08:27.46,0:08:29.43,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:08:27.46,0:08:29.43,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:08:27.46,0:08:29.43,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:08:27.46,0:08:29.43,Default,,0000,0000,0000,,Менің көптеген нағашыларым да келді.
Dialogue: 0,0:08:29.43,0:08:31.07,Default,,0000,0000,0000,,Бұл қызықты болды.
Dialogue: 0,0:08:31.07,0:08:34.94,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:08:31.07,0:08:34.94,Rubi,,0000,0000,0000,,Хаманако
Dialogue: 0,0:08:31.07,0:08:34.94,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:31.07,0:08:34.94,Default,,0000,0000,0000,,Мен Хамана көліне бардым.
Dialogue: 0,0:08:31.07,0:08:34.94,Rubi,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,0:08:31.07,0:08:34.94,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:31.07,0:08:34.94,Default,,0000,0000,0000,,Манга фильміне бару
Dialogue: 0,0:08:34.94,0:08:37.58,Default,,0000,0000,0000,,Я~｡ Эй, Мару-чан ше?
Dialogue: 0,0:08:37.58,0:08:42.08,Default,,0000,0000,0000,,Иә! О мен?
Dialogue: 0,0:08:37.58,0:08:42.08,Default,,0000,0000,0000,,Ал, бұл...
Dialogue: 0,0:08:42.08,0:08:45.95,Default,,0000,0000,0000,,<Мару-чан әлі ешқайда кетпейді.
Dialogue: 0,0:08:42.08,0:08:45.95,Rubi,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:08:42.08,0:08:45.95,Default,,0000,0000,0000,,Мені сізбен бірге алып кеткен жоқпын＞
Dialogue: 0,0:08:45.95,0:08:46.95,Rubi,,0000,0000,0000,,Хамазаки
Dialogue: 0,0:08:45.95,0:08:46.95,Default,,0000,0000,0000,,Сакура
Dialogue: 0,0:08:46.95,0:08:49.95,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:08:46.95,0:08:49.95,Rubi,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:08:46.95,0:08:49.95,Default,,0000,0000,0000,,Мені әлі ешқайда апарудың қажеті жоқ.
Dialogue: 0,0:08:46.95,0:08:49.95,Default,,0000,0000,0000,,Сіз оны алған жоқсыз, солай ма?
Dialogue: 0,0:08:49.95,0:08:51.09,Default,,0000,0000,0000,,Гикутсу…
Dialogue: 0,0:08:51.09,0:08:55.96,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:08:51.09,0:08:55.96,Rubi,,0000,0000,0000,,Кеше
Dialogue: 0,0:08:51.09,0:08:55.96,Default,,0000,0000,0000,,Мен, кеше
Dialogue: 0,0:08:51.09,0:08:55.96,Rubi,,0000,0000,0000,,Омаэзаки
Dialogue: 0,0:08:51.09,0:08:55.96,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:08:51.09,0:08:55.96,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:51.09,0:08:55.96,Default,,0000,0000,0000,,Мен Омаезаки маякына бардым.
Dialogue: 0,0:08:55.96,0:08:56.96,Default,,0000,0000,0000,,Я~
Dialogue: 0,0:08:56.96,0:09:01.10,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:08:56.96,0:09:01.10,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:08:56.96,0:09:01.10,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:08:56.96,0:09:01.10,Default,,0000,0000,0000,,Не болды!
