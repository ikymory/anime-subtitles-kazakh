Dialogue: 0,0:11:32.98,0:11:35.99,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:11:32.98,0:11:35.99,Default,,0000,0000,0000,,Мен сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:11:35.99,0:11:37.49,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:11:35.99,0:11:37.49,Default,,0000,0000,0000,,Не ол?
Dialogue: 0,0:11:38.62,0:11:40.12,Rubi,,0000,0000,0000,,Іс жүзінде
Dialogue: 0,0:11:38.62,0:11:40.12,Default,,0000,0000,0000,,Шындығында, қараңыз,
Dialogue: 0,0:11:40.12,0:11:43.63,Rubi,,0000,0000,0000,,Рейшу
Dialogue: 0,0:11:40.12,0:11:43.63,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:11:40.12,0:11:43.63,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:11:40.12,0:11:43.63,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:11:40.12,0:11:43.63,Default,,0000,0000,0000,,Менің үй жануарым келесі аптада мектепте бір апта болады.
Dialogue: 0,0:11:40.12,0:11:43.63,Rubi,,0000,0000,0000,,Коя
Dialogue: 0,0:11:40.12,0:11:43.63,Default,,0000,0000,0000,,Қоянның қорасы
Dialogue: 0,0:11:43.63,0:11:46.53,Rubi,,0000,0000,0000,,Тазалау және тазалау
Dialogue: 0,0:11:43.63,0:11:46.53,Default,,0000,0000,0000,,Тазалық міндеті
Dialogue: 0,0:11:43.63,0:11:46.53,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:11:43.63,0:11:46.53,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:11:43.63,0:11:46.53,Default,,0000,0000,0000,,Мен оны қабылдағаныңызды қалаймын.
Dialogue: 0,0:11:46.53,0:11:47.50,Default,,0000,0000,0000,,және келісім-шарт аяқталады
Dialogue: 0,0:11:47.50,0:11:50.13,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:47.50,0:11:50.13,Rubi,,0000,0000,0000,,Йотей
Dialogue: 0,0:11:47.50,0:11:50.13,Default,,0000,0000,0000,,Сіздің жоспарыңыз бар ма?
Dialogue: 0,0:11:50.13,0:11:53.04,Default,,0000,0000,0000,,Ах... иә... у...
Dialogue: 0,0:11:53.04,0:11:55.64,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:11:53.04,0:11:55.64,Default,,0000,0000,0000,,<Ойланудың қажеті жоқ>
Dialogue: 0,0:11:55.64,0:11:57.14,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:11:55.64,0:11:57.14,Default,,0000,0000,0000,,Арнайы емес
Dialogue: 0,0:11:57.14,0:12:00.64,Rubi,,0000,0000,0000,,Өте
Dialogue: 0,0:11:57.14,0:12:00.64,Default,,0000,0000,0000,,Бұл аздап қиын.
Dialogue: 0,0:11:57.14,0:12:00.64,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:11:57.14,0:12:00.64,Default,,0000,0000,0000,,Мен… алдымен сені өлтіремін… Буга…ратти…
Dialogue: 0,0:12:00.64,0:12:05.15,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:12:00.64,0:12:05.15,Rubi,,0000,0000,0000,,Риоко
Dialogue: 0,0:12:00.64,0:12:05.15,Rubi,,0000,0000,0000,,Йотей
Dialogue: 0,0:12:00.64,0:12:05.15,Default,,0000,0000,0000,,Ханава-кунның саяхаттау жоспары бар.
Dialogue: 0,0:12:00.64,0:12:05.15,Rubi,,0000,0000,0000,,Тукоу
Dialogue: 0,0:12:00.64,0:12:05.15,Default,,0000,0000,0000,,Мен мектепке бара алмайтын сияқтымын.
Dialogue: 0,0:12:05.15,0:12:07.08,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:12:05.15,0:12:07.08,Default,,0000,0000,0000,,А, Ханава-кун бар емес пе?
Dialogue: 0,0:12:07.08,0:12:08.65,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:12:08.65,0:12:11.16,Default,,0000,0000,0000,,Ол кезде бұл жай ғана
Dialogue: 0,0:12:08.65,0:12:11.16,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:12:08.65,0:12:11.16,Rubi,,0000,0000,0000,,Russ
Dialogue: 0,0:12:08.65,0:12:11.16,Default,,0000,0000,0000,,Мен Гавайиге бардым және жоқ болдым.
Dialogue: 0,0:12:11.16,0:12:14.06,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:12:11.16,0:12:14.06,Default,,0000,0000,0000,,Гавайи
Dialogue: 0,0:12:11.16,0:12:14.06,Default,,0000,0000,0000,,Мүмкін Гавайи...
Dialogue: 0,0:12:14.06,0:12:16.06,Default,,0000,0000,0000,,Бұл Гавайи?
Dialogue: 0,0:12:17.03,0:12:20.66,Rubi,,0000,0000,0000,,Жаз
Dialogue: 0,0:12:17.03,0:12:20.66,Default,,0000,0000,0000,,Иә. Жаз әрқашан
Dialogue: 0,0:12:17.03,0:12:20.66,Default,,0000,0000,0000,,Гавайидегі Вайкики жағажайында
Dialogue: 0,0:12:20.66,0:12:25.66,Default,,0000,0000,0000,,Теңіз спортынан ләззат алу
Dialogue: 0,0:12:20.66,0:12:25.66,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:12:20.66,0:12:25.66,Default,,0000,0000,0000,,Мен шештім, балақай.
Dialogue: 0,0:12:26.47,0:12:28.11,Default,,0000,0000,0000,,А...
Dialogue: 0,0:12:28.11,0:12:32.61,Rubi,,0000,0000,0000,,Рейшу
Dialogue: 0,0:12:28.11,0:12:32.61,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:12:28.11,0:12:32.61,Rubi,,0000,0000,0000,,Точоку
Dialogue: 0,0:12:28.11,0:12:32.61,Default,,0000,0000,0000,,Мұғалім де келесі аптада кезекшілікте болады.
Dialogue: 0,0:12:28.11,0:12:32.61,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:12:28.11,0:12:32.61,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:12:28.11,0:12:32.61,Default,,0000,0000,0000,,Мектепке келу
Dialogue: 0,0:12:32.61,0:12:35.11,Rubi,,0000,0000,0000,,Өте
Dialogue: 0,0:12:32.61,0:12:35.11,Default,,0000,0000,0000,,Бұл біраз қиын
Dialogue: 0,0:12:32.61,0:12:35.11,Rubi,,0000,0000,0000,,Ганба
Dialogue: 0,0:12:32.61,0:12:35.11,Default,,0000,0000,0000,,Қолымыздан келгеннің бәрін жасайық
Dialogue: 0,0:12:35.11,0:12:38.11,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:12:35.11,0:12:38.11,Default,,0000,0000,0000,,Мару-чан...
Dialogue: 0,0:12:38.98,0:12:40.98,Default,,0000,0000,0000,,Дұрыс, Шогена-сан.
Dialogue: 0,0:12:38.98,0:12:40.98,Default,,0000,0000,0000,,Мару-чан
Dialogue: 0,0:12:40.98,0:12:44.12,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:12:40.98,0:12:44.12,Default,,0000,0000,0000,,Мен де
Dialogue: 0,0:12:40.98,0:12:44.12,Default,,0000,0000,0000,,Өйткені біз бірге шығамыз
Dialogue: 0,0:12:44.12,0:12:46.12,Default,,0000,0000,0000,,Иә. Бұл мен Окаға… яғни, Кёма-санға берген уәдем.
Dialogue: 0,0:12:47.62,0:12:48.59,Default,,0000,0000,0000,,(Жан) Абдулға артынан қатыгездікпен пышақ сұқылды
Dialogue: 0,0:12:48.59,0:12:52.50,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:12:48.59,0:12:52.50,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:12:48.59,0:12:52.50,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:12:48.59,0:12:52.50,Default,,0000,0000,0000,,Бір апта, мектепке келген адам
Dialogue: 0,0:12:48.59,0:12:52.50,Default,,0000,0000,0000,,Бұл шынымен де қиын ба?
Dialogue: 0,0:12:52.50,0:12:56.13,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:12:52.50,0:12:56.13,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:12:56.13,0:13:00.00,Default,,0000,0000,0000,,Иә! Жақсы, кешірім сұраймын.
Dialogue: 0,0:12:56.13,0:13:00.00,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:12:56.13,0:13:00.00,Default,,0000,0000,0000,,Гавайиден кәдесый сыйла
Dialogue: 0,0:13:00.00,0:13:02.01,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:13:00.00,0:13:02.01,Default,,0000,0000,0000,,Сувенирлер!
Dialogue: 0,0:13:02.01,0:13:03.01,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:13:02.01,0:13:03.01,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:13:03.01,0:13:07.14,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:13:03.01,0:13:07.14,Default,,0000,0000,0000,,Гавайидегі Вайкики жағажайындағы құм
Dialogue: 0,0:13:03.01,0:13:07.14,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:13:03.01,0:13:07.14,Default,,0000,0000,0000,,Мен оны саған әкелемін.
Dialogue: 0,0:13:07.14,0:13:10.05,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:13:07.14,0:13:10.05,Default,,0000,0000,0000,,Құм?
Dialogue: 0,0:13:07.14,0:13:10.05,Default,,0000,0000,0000,,Хмм, романтикалық!
Dialogue: 0,0:13:10.05,0:13:12.02,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:13:10.05,0:13:12.02,Default,,0000,0000,0000,,Кеттік, Тама-чан
Dialogue: 0,0:13:10.05,0:13:12.02,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:13:12.02,0:13:13.65,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:13:13.65,0:13:17.52,Rubi,,0000,0000,0000,,Кушиен
Dialogue: 0,0:13:13.65,0:13:17.52,Default,,0000,0000,0000,,Кошиенде емес.
Dialogue: 0,0:13:13.65,0:13:17.52,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:13:13.65,0:13:17.52,Default,,0000,0000,0000,,Маған құм керек емес!
Dialogue: 0,0:13:17.52,0:13:20.16,Rubi,,0000,0000,0000,,Кохан
Dialogue: 0,0:13:17.52,0:13:20.16,Rubi,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:13:17.52,0:13:20.16,Default,,0000,0000,0000,,<Екінші жартыжылдықтың жалғасы>
Dialogue: 0,0:13:17.52,0:13:20.16,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:13:17.52,0:13:20.16,Default,,0000,0000,0000,,Бұл не өзі? Бұл кішкентай ит
Dialogue: 0,0:13:20.16,0:13:23.16,Default,,0000,0000,0000,,Не болды? ханымдар
Dialogue: 0,0:13:20.16,0:13:23.16,Default,,0000,0000,0000,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:15:22.15,0:15:24.08,Default,,0000,0000,0000,,Дәл қазір...
Dialogue: 0,0:15:24.08,0:15:28.65,Default,,0000,0000,0000,,Маған жеңіл қарама
Dialogue: 0,0:15:24.08,0:15:28.65,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:15:24.08,0:15:28.65,Rubi,,0000,0000,0000,,Сева
Dialogue: 0,0:15:24.08,0:15:28.65,Default,,0000,0000,0000,,Қояндарды бір апта бойы күту...
Dialogue: 0,0:15:28.65,0:15:30.59,Rubi,,0000,0000,0000,,Фуко
Dialogue: 0,0:15:28.65,0:15:30.59,Default,,0000,0000,0000,,Сіз бақытсызсыз.
Dialogue: 0,0:15:30.59,0:15:34.16,Rubi,,0000,0000,0000,,Дүние
Dialogue: 0,0:15:30.59,0:15:34.16,Default,,0000,0000,0000,,Дүниеде мен сияқты
Dialogue: 0,0:15:30.59,0:15:34.16,Rubi,,0000,0000,0000,,Фуко
Dialogue: 0,0:15:30.59,0:15:34.16,Rubi,,0000,0000,0000,,Әйел
Dialogue: 0,0:15:30.59,0:15:34.16,Default,,0000,0000,0000,,Бақытсыз әйелдер бар ма?
Dialogue: 0,0:15:34.16,0:15:38.66,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:15:34.16,0:15:38.66,Rubi,,0000,0000,0000,,Жаз
Dialogue: 0,0:15:34.16,0:15:38.66,Default,,0000,0000,0000,,Ыстық... жаз сияқты.
Dialogue: 0,0:15:34.16,0:15:38.66,Rubi,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:15:34.16,0:15:38.66,Rubi,,0000,0000,0000,,Кира
Dialogue: 0,0:15:34.16,0:15:38.66,Default,,0000,0000,0000,,Мен сені қазірдің өзінде жек көремін!
Dialogue: 0,0:15:38.66,0:15:42.17,Rubi,,0000,0000,0000,,Фуко
Dialogue: 0,0:15:38.66,0:15:42.17,Rubi,,0000,0000,0000,,Зоко
Dialogue: 0,0:15:38.66,0:15:42.17,Default,,0000,0000,0000,,Әй, бақытсыздықтың түбі.
Dialogue: 0,0:15:42.17,0:15:46.04,Rubi,,0000,0000,0000,,Фуко
Dialogue: 0,0:15:42.17,0:15:46.04,Rubi,,0000,0000,0000,,Зоко
Dialogue: 0,0:15:42.17,0:15:46.04,Default,,0000,0000,0000,,<Тіпті бақытсыздықтың түбінде
Dialogue: 0,0:15:42.17,0:15:46.04,Rubi,,0000,0000,0000,,Нему
Dialogue: 0,0:15:42.17,0:15:46.04,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:15:42.17,0:15:46.04,Default,,0000,0000,0000,,Ұйықтауды ұмытпаңыз>
Dialogue: 0,0:15:46.04,0:15:48.67,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:15:46.04,0:15:48.67,Rubi,,0000,0000,0000,,Хиру
Dialogue: 0,0:15:46.04,0:15:48.67,Default,,0000,0000,0000,,Маруко, түскі ас.
Dialogue: 0,0:15:48.67,0:15:53.18,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:15:48.67,0:15:53.18,Default,,0000,0000,0000,,Иә? Маруко!
Dialogue: 0,0:15:48.67,0:15:53.18,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:15:48.67,0:15:53.18,Default,,0000,0000,0000,,Сіз мені естімейсіз бе?
Dialogue: 0,0:15:53.18,0:15:55.11,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:15:53.18,0:15:55.11,Default,,0000,0000,0000,,А, ұйықтап жатырсың ба?
Dialogue: 0,0:15:55.11,0:15:58.68,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:15:55.11,0:15:58.68,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:15:55.11,0:15:58.68,Default,,0000,0000,0000,,Маруконың сүйіктісі
Dialogue: 0,0:15:55.11,0:15:58.68,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:15:55.11,0:15:58.68,Rubi,,0000,0000,0000,,Чука
Dialogue: 0,0:15:55.11,0:15:58.68,Default,,0000,0000,0000,,Хияши чука болса да...
Dialogue: 0,0:15:58.68,0:16:02.12,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:15:58.68,0:16:02.12,Default,,0000,0000,0000,,Хехе, сосын мен
Dialogue: 0,0:15:58.68,0:16:02.12,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:15:58.68,0:16:02.12,Default,,0000,0000,0000,,Сіз оны жеуге қорқасыз ба?
Dialogue: 0,0:16:02.12,0:16:03.62,Default,,0000,0000,0000,,Ааа?
Dialogue: 0,0:16:03.62,0:16:06.12,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:16:03.62,0:16:06.12,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:16:03.62,0:16:06.12,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:16:03.62,0:16:06.12,Default,,0000,0000,0000,,Мен жеймін... Қазір барамын.
Dialogue: 0,0:16:06.12,0:16:09.03,Default,,0000,0000,0000,,Хмф...
Dialogue: 0,0:16:09.03,0:16:10.63,Default,,0000,0000,0000,,Ах! Ақымақ!
Dialogue: 0,0:16:10.63,0:16:12.13,Default,,0000,0000,0000,,Әй
Dialogue: 0,0:16:12.13,0:16:15.13,Rubi,,0000,0000,0000,,Фуко
Dialogue: 0,0:16:12.13,0:16:15.13,Rubi,,0000,0000,0000,,Зоко
Dialogue: 0,0:16:12.13,0:16:15.13,Default,,0000,0000,0000,,<Тіпті бақытсыздықтың түбінде
Dialogue: 0,0:16:12.13,0:16:15.13,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:16:12.13,0:16:15.13,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:16:12.13,0:16:15.13,Default,,0000,0000,0000,,Тамақтануды ұмытпаңыз >
Dialogue: 0,0:16:18.00,0:16:19.64,Rubi,,0000,0000,0000,,Келесі
Dialogue: 0,0:16:18.00,0:16:19.64,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:16:18.00,0:16:19.64,Default,,0000,0000,0000,,<Ал келесі аптадан бастап
Dialogue: 0,0:16:19.64,0:16:22.54,Rubi,,0000,0000,0000,,Гойя
Dialogue: 0,0:16:19.64,0:16:22.54,Default,,0000,0000,0000,,Мару-чанның қоян қорасы
Dialogue: 0,0:16:19.64,0:16:22.54,Rubi,,0000,0000,0000,,Дәретхананы тазалау
Dialogue: 0,0:16:19.64,0:16:22.54,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:16:19.64,0:16:22.54,Default,,0000,0000,0000,,Тазалау міндеті басталды＞
Dialogue: 0,0:16:22.54,0:16:25.51,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:16:22.54,0:16:25.51,Default,,0000,0000,0000,,Ху... Күткеніңізге рахмет, Тама-чан.
Dialogue: 0,0:16:25.51,0:16:28.65,Default,,0000,0000,0000,,Сізбен кездесе бастағаным үшін кешіріңіз.
Dialogue: 0,0:16:28.65,0:16:31.15,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:16:28.65,0:16:31.15,Default,,0000,0000,0000,,Жарайды, кеттік.
Dialogue: 0,0:16:28.65,0:16:31.15,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:16:39.16,0:16:42.66,Rubi,,0000,0000,0000,,Його
Dialogue: 0,0:16:39.16,0:16:42.66,Default,,0000,0000,0000,,Ача, әбден лас екен.
Dialogue: 0,0:16:42.66,0:16:47.53,Rubi,,0000,0000,0000,,Орындалды
Dialogue: 0,0:16:42.66,0:16:47.53,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:16:42.66,0:16:47.53,Rubi,,0000,0000,0000,,Синбунши
Dialogue: 0,0:16:42.66,0:16:47.53,Default,,0000,0000,0000,,Иә, астындағы газет
Dialogue: 0,0:16:42.66,0:16:47.53,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:16:42.66,0:16:47.53,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:16:42.66,0:16:47.53,Default,,0000,0000,0000,,Тек тағамды ауыстырыңыз, солай ма?
Dialogue: 0,0:16:47.53,0:16:50.53,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:16:47.53,0:16:50.53,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:16:47.53,0:16:50.53,Default,,0000,0000,0000,,Олай болса, бастайық па?
Dialogue: 0,0:16:50.53,0:16:51.53,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:16:57.17,0:16:58.68,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:16:57.17,0:16:58.68,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:58.68,0:17:01.58,Rubi,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:16:58.68,0:17:01.58,Default,,0000,0000,0000,,Мен қорқамын
Dialogue: 0,0:17:01.58,0:17:06.48,Rubi,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:17:01.58,0:17:06.48,Default,,0000,0000,0000,,Қашуға болмайды.
Dialogue: 0,0:17:06.48,0:17:08.49,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:17:06.48,0:17:08.49,Default,,0000,0000,0000,,Қараңыз, тамақтаныңыз.
Dialogue: 0,0:17:08.49,0:17:11.62,Default,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:17:11.62,0:17:17.13,Default,,0000,0000,0000,,Қара, қара, қоян
Dialogue: 0,0:17:17.13,0:17:19.63,Default,,0000,0000,0000,,Ах... жоқ...
Dialogue: 0,0:17:19.63,0:17:23.13,Default,,0000,0000,0000,,Қоян дегеніміз не?
Dialogue: 0,0:17:19.63,0:17:23.13,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:17:19.63,0:17:23.13,Default,,0000,0000,0000,,Адамдарға бауыр басып қалу қиын.
Dialogue: 0,0:17:23.13,0:17:24.63,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:17:31.64,0:17:37.15,Default,,0000,0000,0000,,Ахаха Қоянның тезегі
Dialogue: 0,0:17:31.64,0:17:37.15,Default,,0000,0000,0000,,Айналып жүргенің сүйкімді.
Dialogue: 0,0:17:37.15,0:17:41.02,Default,,0000,0000,0000,,Хехехе, бұл рас.
Dialogue: 0,0:17:41.02,0:17:43.65,Rubi,,0000,0000,0000,,Шөп
Dialogue: 0,0:17:41.02,0:17:43.65,Default,,0000,0000,0000,,Бірақ... бәрібір сасық.
Dialogue: 0,0:17:43.65,0:17:45.65,Rubi,,0000,0000,0000,,Шөп
Dialogue: 0,0:17:43.65,0:17:45.65,Default,,0000,0000,0000,,Иә, сасық...
Dialogue: 0,0:17:50.16,0:17:52.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:52.66,0:17:55.57,Default,,0000,0000,0000,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:17:52.66,0:17:55.57,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:17:52.66,0:17:55.57,Default,,0000,0000,0000,,Сіз тамақтанып жатырсыз.
Dialogue: 0,0:17:55.57,0:17:56.53,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:17:56.53,0:17:58.53,Default,,0000,0000,0000,,Сіз аш болуыңыз керек.
Dialogue: 0,0:18:00.54,0:18:02.11,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:18:02.11,0:18:04.61,Default,,0000,0000,0000,,О, қазір таза.
Dialogue: 0,0:18:04.61,0:18:06.54,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:18:04.61,0:18:06.54,Default,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:18:06.54,0:18:09.11,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:18:06.54,0:18:09.11,Default,,0000,0000,0000,,Күн ыстық болса да
Dialogue: 0,0:18:06.54,0:18:09.11,Rubi,,0000,0000,0000,,Хонами
Dialogue: 0,0:18:06.54,0:18:09.11,Default,,0000,0000,0000,,Сакура-сан да, Хонами-сан да
Dialogue: 0,0:18:09.11,0:18:11.05,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:18:11.05,0:18:13.62,Default,,0000,0000,0000,,Жоқ, онша емес.
Dialogue: 0,0:18:13.62,0:18:16.12,Rubi,,0000,0000,0000,,Аздап
Dialogue: 0,0:18:13.62,0:18:16.12,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:18:13.62,0:18:16.12,Default,,0000,0000,0000,,Бұл өте қызықты болды, профессор.
Dialogue: 0,0:18:16.12,0:18:17.09,Rubi,,0000,0000,0000,,Тогава
Dialogue: 0,0:18:16.12,0:18:17.09,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:18:17.09,0:18:20.62,Rubi,,0000,0000,0000,,Сүйкімді
Dialogue: 0,0:18:17.09,0:18:20.62,Default,,0000,0000,0000,,Жүр, шөлдедің, солай ма?
Dialogue: 0,0:18:17.09,0:18:20.62,Default,,0000,0000,0000,,Мұнда келіңіз
Dialogue: 0,0:18:20.62,0:18:21.62,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:18:20.62,0:18:21.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:23.13,0:18:26.63,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:18:23.13,0:18:26.63,Default,,0000,0000,0000,,Тек бір-екі жастағы бала үшін
Dialogue: 0,0:18:23.13,0:18:26.63,Rubi,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:18:23.13,0:18:26.63,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:18:23.13,0:18:26.63,Default,,0000,0000,0000,,Келіңіздер, рахат алыңыз!
Dialogue: 0,0:18:26.63,0:18:28.57,Default,,0000,0000,0000,,Уау~ Итадакимасу
Dialogue: 0,0:18:28.57,0:18:30.07,Default,,0000,0000,0000,,О~
Dialogue: 0,0:18:32.14,0:18:33.64,Default,,0000,0000,0000,,Итадакимасу
Dialogue: 0,0:18:36.01,0:18:37.01,Default,,0000,0000,0000,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:18:37.01,0:18:40.01,Default,,0000,0000,0000,,Жүр, печенье де ал.
Dialogue: 0,0:18:40.01,0:18:41.14,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:18:40.01,0:18:41.14,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:18:41.14,0:18:45.02,Default,,0000,0000,0000,,《Хахаха, сен істедің.
Dialogue: 0,0:18:41.14,0:18:45.02,Rubi,,0000,0000,0000,,Емен
Dialogue: 0,0:18:41.14,0:18:45.02,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:18:41.14,0:18:45.02,Default,,0000,0000,0000,,Шырын мен тәттілер берілсе
Dialogue: 0,0:18:45.02,0:18:48.02,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:18:45.02,0:18:48.02,Rubi,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:18:45.02,0:18:48.02,Default,,0000,0000,0000,,Сондықтан мен мектепке келемін
Dialogue: 0,0:18:45.02,0:18:48.02,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:18:45.02,0:18:48.02,Default,,0000,0000,0000,,Жаман емес》
Dialogue: 0,0:18:51.15,0:18:54.06,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:18:51.15,0:18:54.06,Default,,0000,0000,0000,,Әй, мұғалім, қоян деген не?
Dialogue: 0,0:18:51.15,0:18:54.06,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:18:51.15,0:18:54.06,Default,,0000,0000,0000,,Адамдармен тіл табыспайсың ба?
Dialogue: 0,0:18:54.06,0:18:58.03,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:18:54.06,0:18:58.03,Rubi,,0000,0000,0000,,Фалко!!
Dialogue: 0,0:18:54.06,0:18:58.03,Default,,0000,0000,0000,,Қызық, мен оны қолмен тамақтандырмаймын ба?
Dialogue: 0,0:18:58.03,0:18:59.66,Rubi,,0000,0000,0000,,Конвульсия
Dialogue: 0,0:18:58.03,0:18:59.66,Default,,0000,0000,0000,,Өйткені мен өте қорқақпын
Dialogue: 0,0:18:59.66,0:19:02.57,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:18:59.66,0:19:02.57,Default,,0000,0000,0000,,Тамақ адамнан келеді.
Dialogue: 0,0:18:59.66,0:19:02.57,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:18:59.66,0:19:02.57,Default,,0000,0000,0000,,Мен оны жемеймін.
Dialogue: 0,0:19:02.57,0:19:05.10,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:19:02.57,0:19:05.10,Default,,0000,0000,0000,,Я~
Dialogue: 0,0:19:05.10,0:19:07.04,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:19:05.10,0:19:07.04,Default,,0000,0000,0000,,Ал мен тазалықты жақсы көремін.
Dialogue: 0,0:19:07.04,0:19:10.61,Rubi,,0000,0000,0000,,Коя
Dialogue: 0,0:19:07.04,0:19:10.61,Rubi,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:19:07.04,0:19:10.61,Default,,0000,0000,0000,,Әрқашан саятшылықтың ішінде
Dialogue: 0,0:19:07.04,0:19:10.61,Default,,0000,0000,0000,,Тазалықты сақтау керек
Dialogue: 0,0:19:10.61,0:19:12.11,Default,,0000,0000,0000,,Хун
Dialogue: 0,0:19:12.11,0:19:15.01,Rubi,,0000,0000,0000,,Суко
Dialogue: 0,0:19:12.11,0:19:15.01,Rubi,,0000,0000,0000,,Минара
Dialogue: 0,0:19:12.11,0:19:15.01,Default,,0000,0000,0000,,<Қояннан аздап үлгі алу керек>
Dialogue: 0,0:19:15.01,0:19:18.62,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:19:15.01,0:19:18.62,Default,,0000,0000,0000,,Әй, мектепте басқа да заттар бар.
Dialogue: 0,0:19:15.01,0:19:18.62,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:19:15.01,0:19:18.62,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:19:15.01,0:19:18.62,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:19:15.01,0:19:18.62,Default,,0000,0000,0000,,Тірі тіршілік иелерін ұстайсың ба?
Dialogue: 0,0:19:18.62,0:19:20.55,Default,,0000,0000,0000,,Э? (Танихара) Шиндэ! Менімен бірге Макдоналдсқа бар.
Dialogue: 0,0:19:20.55,0:19:24.49,Rubi,,0000,0000,0000,,Кочошицу
Dialogue: 0,0:19:20.55,0:19:24.49,Rubi,,0000,0000,0000,,♬ Соғылуы тиіс толық нүкте
Dialogue: 0,0:19:20.55,0:19:24.49,Rubi,,0000,0000,0000,,Ято өледі
Dialogue: 0,0:19:20.55,0:19:24.49,Default,,0000,0000,0000,,Қалғандары директор кабинетінің артындағы тоғанда.
Dialogue: 0,0:19:20.55,0:19:24.49,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:19:20.55,0:19:24.49,Default,,0000,0000,0000,,Мен сазан балығын ұстаймын.
Dialogue: 0,0:19:24.49,0:19:28.12,Default,,0000,0000,0000,,Сазан... Уау~
Dialogue: 0,0:19:24.49,0:19:28.12,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:19:24.49,0:19:28.12,Default,,0000,0000,0000,,Маруко мен сені тамақтандырғым келеді
Dialogue: 0,0:19:28.12,0:19:30.06,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:19:28.12,0:19:30.06,Default,,0000,0000,0000,,Мен де!
Dialogue: 0,0:19:28.12,0:19:30.06,Rubi,,0000,0000,0000,,Тогава
Dialogue: 0,0:19:28.12,0:19:30.06,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:19:30.06,0:19:32.63,Rubi,,0000,0000,0000,,Сіз
Dialogue: 0,0:19:30.06,0:19:32.63,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:19:30.06,0:19:32.63,Default,,0000,0000,0000,,Ал, мен сендерден сұрайын деп ойлаймын.
Dialogue: 0,0:19:32.63,0:19:34.56,Default,,0000,0000,0000,,Вахаха
Dialogue: 0,0:19:34.56,0:19:36.56,Default,,0000,0000,0000,,Итайта!
Dialogue: 0,0:19:38.50,0:19:41.64,Rubi,,0000,0000,0000,,Ято өледі
Dialogue: 0,0:19:38.50,0:19:41.64,Default,,0000,0000,0000,,Мен мұндай тоғанда сазан болғанына сене алар емеспін.
Dialogue: 0,0:19:41.64,0:19:44.14,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:19:41.64,0:19:44.14,Default,,0000,0000,0000,,Иә, мен мұны білмедім.
Dialogue: 0,0:19:44.14,0:19:47.64,Default,,0000,0000,0000,,Мм.
Dialogue: 0,0:19:44.14,0:19:47.64,Default,,0000,0000,0000,,Сіз қанша бересіз?
Dialogue: 0,0:19:47.64,0:19:50.55,Default,,0000,0000,0000,,Оны жай ғана аударып тастаған дұрыс
Dialogue: 0,0:19:47.64,0:19:50.55,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:19:47.64,0:19:50.55,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:19:47.64,0:19:50.55,Default,,0000,0000,0000,,Мұғалім айтты
Dialogue: 0,0:19:50.55,0:19:52.15,Default,,0000,0000,0000,,Парапаран Пара…
Dialogue: 0,0:19:52.15,0:19:53.65,Default,,0000,0000,0000,,О!
Dialogue: 0,0:19:52.15,0:19:53.65,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:19:53.65,0:19:55.15,Default,,0000,0000,0000,,О!
Dialogue: 0,0:19:55.15,0:19:57.65,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:19:55.15,0:19:57.65,Default,,0000,0000,0000,,Жоқ... сіз тым көп салып жатырсыз, Мару-чан.
Dialogue: 0,0:19:57.65,0:19:59.15,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:20:01.16,0:20:04.59,Default,,0000,0000,0000,,А, жоқ, Мару-чан!
Dialogue: 0,0:20:01.16,0:20:04.59,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:20:01.16,0:20:04.59,Default,,0000,0000,0000,,Жем ериді!
Dialogue: 0,0:20:04.59,0:20:06.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:20:09.10,0:20:11.03,Rubi,,0000,0000,0000,,Тогава
Dialogue: 0,0:20:09.10,0:20:11.03,Default,,0000,0000,0000,,Сакура-сан және т.б
Dialogue: 0,0:20:11.03,0:20:12.60,Default,,0000,0000,0000,,О!
Dialogue: 0,0:20:12.60,0:20:16.11,Rubi,,0000,0000,0000,,Түпнұсқа
Dialogue: 0,0:20:12.60,0:20:16.11,Rubi,,0000,0000,0000,,Уақыт
