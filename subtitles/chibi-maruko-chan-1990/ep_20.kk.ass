Dialogue: 0,0:09:56.87,0:09:59.48,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:09:56.87,0:09:59.48,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:09:56.87,0:09:59.48,Default,,0000,0000,0000,,Жиренішті нәрсе туралы ойланыңыз
Dialogue: 0,0:09:59.48,0:10:02.98,Rubi,,0000,0000,0000,,Сашими
Dialogue: 0,0:09:59.48,0:10:02.98,Default,,0000,0000,0000,,Сашими үшін.
Dialogue: 0,0:09:59.48,0:10:02.98,Rubi,,0000,0000,0000,,Жынға қалай сенуге болады!!
