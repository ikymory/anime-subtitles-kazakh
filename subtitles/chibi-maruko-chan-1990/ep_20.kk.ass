Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.97,0:01:15.47,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:10.03,0:03:12.54,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:10.03,0:03:12.54,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:10.03,0:03:12.54,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:12.54,0:03:15.44,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:12.54,0:03:15.44,Default,,0000,0000,0000,,《Жоқ!
Dialogue: 0,0:03:12.54,0:03:15.44,Default,,0000,0000,0000,,Сіз мына күріш крекерін айтып тұрсыз деп ойлаймын》
Dialogue: 0,0:03:15.44,0:03:17.41,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:15.44,0:03:17.41,Default,,0000,0000,0000,,Маруко
Dialogue: 0,0:03:17.41,0:03:19.04,Rubi,,0000,0000,0000,,Санканби
Dialogue: 0,0:03:17.41,0:03:19.04,Default,,0000,0000,0000,,Сіз, ертеңгі келу күні туралы.
Dialogue: 0,0:03:19.04,0:03:21.54,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:19.04,0:03:21.54,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:03:19.04,0:03:21.54,Default,,0000,0000,0000,,Мен анама айтуым керек.
Dialogue: 0,0:03:19.04,0:03:21.54,Default,,0000,0000,0000,,Жаман емес
Dialogue: 0,0:03:21.54,0:03:24.98,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:21.54,0:03:24.98,Default,,0000,0000,0000,,Иә! анам
Dialogue: 0,0:03:21.54,0:03:24.98,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:03:21.54,0:03:24.98,Default,,0000,0000,0000,,Мұны қайдан білдіңіз?
Dialogue: 0,0:03:24.98,0:03:27.88,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:24.98,0:03:27.88,Default,,0000,0000,0000,,Тама-чанның анасынан
Dialogue: 0,0:03:24.98,0:03:27.88,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:03:24.98,0:03:27.88,Default,,0000,0000,0000,,Мен оны дұрыс естідім.
Dialogue: 0,0:03:27.88,0:03:30.49,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:27.88,0:03:30.49,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:27.88,0:03:30.49,Default,,0000,0000,0000,,Мама, сізге келудің қажеті жоқ.
Dialogue: 0,0:03:30.49,0:03:31.99,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:03:30.49,0:03:31.99,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:30.49,0:03:31.99,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:30.49,0:03:31.99,Default,,0000,0000,0000,,Мына бала не дейсің?
Dialogue: 0,0:03:31.99,0:03:35.49,Rubi,,0000,0000,0000,,Математика
Dialogue: 0,0:03:31.99,0:03:35.49,Default,,0000,0000,0000,,Өйткені, бұл арифметика.
Dialogue: 0,0:03:31.99,0:03:35.49,Rubi,,0000,0000,0000,,Катсуяку
Dialogue: 0,0:03:31.99,0:03:35.49,Default,,0000,0000,0000,,Маруко белсенді бола алмайды.
Dialogue: 0,0:03:35.49,0:03:37.99,Rubi,,0000,0000,0000,,Йосуу
Dialogue: 0,0:03:35.49,0:03:37.99,Default,,0000,0000,0000,,Жақсы дайындалсаң
Dialogue: 0,0:03:35.49,0:03:37.99,Default,,0000,0000,0000,,Мырза, кенет қозғалмаңыз.
Dialogue: 0,0:03:37.99,0:03:39.93,Rubi,,0000,0000,0000,,Йосуу
Dialogue: 0,0:03:37.99,0:03:39.93,Default,,0000,0000,0000,,Алдын ала оқығаннан жақсы
Dialogue: 0,0:03:37.99,0:03:39.93,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:37.99,0:03:39.93,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:37.99,0:03:39.93,Default,,0000,0000,0000,,Анаң келмесе жақсы
Dialogue: 0,0:03:39.93,0:03:42.50,Rubi,,0000,0000,0000,,Құрсау
Dialogue: 0,0:03:39.93,0:03:42.50,Default,,0000,0000,0000,,Бұл бір-бірімізге арналған.
Dialogue: 0,0:03:42.50,0:03:44.43,Rubi,,0000,0000,0000,,Йосуу
Dialogue: 0,0:03:42.50,0:03:44.43,Default,,0000,0000,0000,,Ал дайындық ше?
Dialogue: 0,0:03:42.50,0:03:44.43,Default,,0000,0000,0000,,Бұл әділ емес
Dialogue: 0,0:03:44.43,0:03:48.00,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:03:44.43,0:03:48.00,Default,,0000,0000,0000,,Нені оқытады?
Dialogue: 0,0:03:44.43,0:03:48.00,Rubi,,0000,0000,0000,,Дуджи
Dialogue: 0,0:03:44.43,0:03:48.00,Default,,0000,0000,0000,,Барлығы бір уақытта болуы керек
Dialogue: 0,0:03:48.00,0:03:49.94,Default,,0000,0000,0000,,Әлде бұл—
Dialogue: 0,0:03:48.00,0:03:49.94,Default,,0000,0000,0000,,О!
Dialogue: 0,0:03:49.94,0:03:51.88,Default,,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,0:03:49.94,0:03:51.88,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:49.94,0:03:51.88,Rubi,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:03:49.94,0:03:51.88,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:49.94,0:03:51.88,Default,,0000,0000,0000,,Анам міндетті түрде барады.
Dialogue: 0,0:03:51.88,0:03:54.51,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:03:51.88,0:03:54.51,Rubi,,0000,0000,0000,,Жапон үйеңкі
Dialogue: 0,0:03:51.88,0:03:54.51,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:03:51.88,0:03:54.51,Default,,0000,0000,0000,,Келсең де, өзіңді аянышты сезінесің.
Dialogue: 0,0:03:54.51,0:03:56.45,Rubi,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:03:54.51,0:03:56.45,Default,,0000,0000,0000,,Мен жалғызбын
Dialogue: 0,0:03:54.51,0:03:56.45,Default,,0000,0000,0000,,Мен өте жақсы түсінемін.
Dialogue: 0,0:03:56.45,0:03:59.38,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:03:56.45,0:03:59.38,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:56.45,0:03:59.38,Default,,0000,0000,0000,,Маруко, бұл күріш крекер
Dialogue: 0,0:03:59.38,0:04:02.39,Rubi,,0000,0000,0000,,Емен
Dialogue: 0,0:03:59.38,0:04:02.39,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:03:59.38,0:04:02.39,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:03:59.38,0:04:02.39,Default,,0000,0000,0000,,Басқа тәттілерді жеп болғанша
Dialogue: 0,0:03:59.38,0:04:02.39,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:03:59.38,0:04:02.39,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:03:59.38,0:04:02.39,Default,,0000,0000,0000,,Мен саған ашпа дедім ғой.
Dialogue: 0,0:04:02.39,0:04:05.52,Rubi,,0000,0000,0000,,Триангуляция
Dialogue: 0,0:04:02.39,0:04:05.52,Rubi,,0000,0000,0000,,иудей
Dialogue: 0,0:04:02.39,0:04:05.52,Rubi,,0000,0000,0000,,Кура
Dialogue: 0,0:04:02.39,0:04:05.52,Default,,0000,0000,0000,,Сапар кешінің маңыздылығымен салыстырғанда
Dialogue: 0,0:04:05.52,0:04:08.42,Default,,0000,0000,0000,,Күріш крекерлері ше?
Dialogue: 0,0:04:05.52,0:04:08.42,Rubi,,0000,0000,0000,,Чи
Dialogue: 0,0:04:05.52,0:04:08.42,Rubi,,0000,0000,0000,,Чи
Dialogue: 0,0:04:05.52,0:04:08.42,Default,,0000,0000,0000,,Ол қазірдің өзінде кішкентай Ол кішкентай
Dialogue: 0,0:04:08.42,0:04:10.39,Default,,0000,0000,0000,,Ахаха…
Dialogue: 0,0:04:08.42,0:04:10.39,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:04:08.42,0:04:10.39,Default,,0000,0000,0000,,Сәлем әке!
Dialogue: 0,0:04:10.39,0:04:11.39,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:04:10.39,0:04:11.39,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:04:11.39,0:04:13.03,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:04:11.39,0:04:13.03,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:04:11.39,0:04:13.03,Default,,0000,0000,0000,,Мама, тоқтатыңызшы.
Dialogue: 0,0:04:13.03,0:04:16.53,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:13.03,0:04:16.53,Rubi,,0000,0000,0000,,Үшбұрыш
Dialogue: 0,0:04:13.03,0:04:16.53,Rubi,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:04:13.03,0:04:16.53,Default,,0000,0000,0000,,Ол Маруконың көру кешіне келетінін айтты.
Dialogue: 0,0:04:13.03,0:04:16.53,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:13.03,0:04:16.53,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:04:13.03,0:04:16.53,Default,,0000,0000,0000,,Ол кісі айтты
Dialogue: 0,0:04:16.53,0:04:18.47,Default,,0000,0000,0000,,Неге жасырып жатырсың?
Dialogue: 0,0:04:16.53,0:04:18.47,Default,,0000,0000,0000,,Жақсы емес
Dialogue: 0,0:04:18.47,0:04:22.41,Rubi,,0000,0000,0000,,Триангуляция
Dialogue: 0,0:04:18.47,0:04:22.41,Default,,0000,0000,0000,,Көру кешіне рұқсат алу
Dialogue: 0,0:04:18.47,0:04:22.41,Rubi,,0000,0000,0000,,Фуку
Dialogue: 0,0:04:18.47,0:04:22.41,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:18.47,0:04:22.41,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:04:18.47,0:04:22.41,Default,,0000,0000,0000,,Киім алуға ақша жұмсаймын.
Dialogue: 0,0:04:22.41,0:04:23.97,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:04:23.97,0:04:27.48,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:04:23.97,0:04:27.48,Rubi,,0000,0000,0000,,Үшбұрыш
Dialogue: 0,0:04:23.97,0:04:27.48,Default,,0000,0000,0000,,Сонымен қатар, бару жиналысында
Dialogue: 0,0:04:23.97,0:04:27.48,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:23.97,0:04:27.48,Rubi,,0000,0000,0000,,НАСА
Dialogue: 0,0:04:23.97,0:04:27.48,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:04:23.97,0:04:27.48,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:23.97,0:04:27.48,Default,,0000,0000,0000,,Мен Маруконың аянышты түрін көргенде
Dialogue: 0,0:04:27.48,0:04:31.35,Rubi,,0000,0000,0000,,Юхан
Dialogue: 0,0:04:27.48,0:04:31.35,Rubi,,0000,0000,0000,,Цуку
Dialogue: 0,0:04:27.48,0:04:31.35,Default,,0000,0000,0000,,Мен енді кешкі ас дайындамаймын.
Dialogue: 0,0:04:27.48,0:04:31.35,Default,,0000,0000,0000,,Бұл әлі де жақсы ма?
Dialogue: 0,0:04:31.35,0:04:33.98,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:31.35,0:04:33.98,Rubi,,0000,0000,0000,,Гата
Dialogue: 0,0:04:31.35,0:04:33.98,Default,,0000,0000,0000,,Маруко сізге
Dialogue: 0,0:04:31.35,0:04:33.98,Rubi,,0000,0000,0000,,Мейвакку
Dialogue: 0,0:04:31.35,0:04:33.98,Default,,0000,0000,0000,,Мен қиындық тудырғым келмейді.
Dialogue: 0,0:04:33.98,0:04:35.92,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:04:33.98,0:04:35.92,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:04:33.98,0:04:35.92,Default,,0000,0000,0000,,Анашым тоқтаңыз!
Dialogue: 0,0:04:35.92,0:04:40.49,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:04:35.92,0:04:40.49,Rubi,,0000,0000,0000,,НАСА
Dialogue: 0,0:04:35.92,0:04:40.49,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:04:35.92,0:04:40.49,Default,,0000,0000,0000,,Басқаша айтқанда, тіпті сіздің аянышты түріңіз
Dialogue: 0,0:04:35.92,0:04:40.49,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:35.92,0:04:40.49,Default,,0000,0000,0000,,Мен көрсетуім керек, бұл жақсы.
Dialogue: 0,0:04:40.49,0:04:42.43,Rubi,,0000,0000,0000,,Йосуу
Dialogue: 0,0:04:40.49,0:04:42.43,Rubi,,0000,0000,0000,,Йосуу
Dialogue: 0,0:04:40.49,0:04:42.43,Default,,0000,0000,0000,,Үй тапсырмасын орында! Үй тапсырмасын орында!
Dialogue: 0,0:04:42.43,0:04:44.99,Default,,0000,0000,0000,,Қазірдің өзінде
Dialogue: 0,0:04:42.43,0:04:44.99,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:04:42.43,0:04:44.99,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:04:42.43,0:04:44.99,Default,,0000,0000,0000,,Әкесі де, анасы да
Dialogue: 0,0:04:44.99,0:04:47.50,Rubi,,0000,0000,0000,,Йосуу
Dialogue: 0,0:04:44.99,0:04:47.50,Rubi,,0000,0000,0000,,Йосуу
Dialogue: 0,0:04:44.99,0:04:47.50,Default,,0000,0000,0000,,Дайындыққа дайындық жақсы емес.
Dialogue: 0,0:04:47.50,0:04:51.37,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:47.50,0:04:51.37,Default,,0000,0000,0000,,О, Маруко
Dialogue: 0,0:04:47.50,0:04:51.37,Rubi,,0000,0000,0000,,Үшбұрыш
Dialogue: 0,0:04:47.50,0:04:51.37,Rubi,,0000,0000,0000,,Нанжиканме
Dialogue: 0,0:04:47.50,0:04:51.37,Default,,0000,0000,0000,,Ертең сапар сағат нешеде болады?
Dialogue: 0,0:04:51.37,0:04:53.00,Rubi,,0000,0000,0000,,Кезең
Dialogue: 0,0:04:51.37,0:04:53.00,Default,,0000,0000,0000,,Қазір бесінші сағат.
Dialogue: 0,0:04:53.00,0:04:57.87,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:04:53.00,0:04:57.87,Rubi,,0000,0000,0000,,Әйел
Dialogue: 0,0:04:53.00,0:04:57.87,Default,,0000,0000,0000,,Е, мен сияқты.
