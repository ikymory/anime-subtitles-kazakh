Dialogue: 0,0:06:49.99,0:06:53.86,Rubi,,0000,0000,0000,,Шонен
Dialogue: 0,0:06:49.99,0:06:53.86,Rubi,,0000,0000,0000,,Өсімдіктер
Dialogue: 0,0:06:49.99,0:06:53.86,Default,,0000,0000,0000,,Күріш алған баланың мейірімділігі болды
Dialogue: 0,0:06:49.99,0:06:53.86,Rubi,,0000,0000,0000,,Жалған
Dialogue: 0,0:06:49.99,0:06:53.86,Default,,0000,0000,0000,,Бұл жалған＞
Dialogue: 0,0:06:57.86,0:07:00.50,Default,,0000,0000,0000,,Ах, ақырында
Dialogue: 0,0:06:57.86,0:07:00.50,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:06:57.86,0:07:00.50,Default,,0000,0000,0000,,Бұл басталды
Dialogue: 0,0:07:00.50,0:07:03.00,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:07:00.50,0:07:03.00,Default,,0000,0000,0000,,Менің анам
Dialogue: 0,0:07:00.50,0:07:03.00,Default,,0000,0000,0000,,Әлі жоқ сияқты.
Dialogue: 0,0:07:03.00,0:07:05.50,Default,,0000,0000,0000,,《Біраз уақытқа
Dialogue: 0,0:07:03.00,0:07:05.50,Default,,0000,0000,0000,,Сабыр етіңіз》
Dialogue: 0,0:07:06.87,0:07:10.87,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:07:06.87,0:07:10.87,Default,,0000,0000,0000,,《Ах! Артында емес
Dialogue: 0,0:07:06.87,0:07:10.87,Rubi,,0000,0000,0000,,Саңырау?
Dialogue: 0,0:07:06.87,0:07:10.87,Default,,0000,0000,0000,,Бұл дәліз жағында болды!
Dialogue: 0,0:07:10.87,0:07:14.01,Rubi,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:07:10.87,0:07:14.01,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:07:10.87,0:07:14.01,Default,,0000,0000,0000,,Сіз қорқынышты сияқтысыз.
Dialogue: 0,0:07:10.87,0:07:14.01,Default,,0000,0000,0000,,Чип! Чип, чип, чип, чип!
Dialogue: 0,0:07:14.01,0:07:16.51,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:14.01,0:07:16.51,Rubi,,0000,0000,0000,,Орындалды
Dialogue: 0,0:07:14.01,0:07:16.51,Default,,0000,0000,0000,,Иә? не? астында? 》
Dialogue: 0,0:07:17.51,0:07:21.02,Default,,0000,0000,0000,,О, жоқ!
Dialogue: 0,0:07:17.51,0:07:21.02,Rubi,,0000,0000,0000,,Өзара әрекеттесу
Dialogue: 0,0:07:17.51,0:07:21.02,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:07:17.51,0:07:21.02,Default,,0000,0000,0000,,Бұл қоғамтану оқулығы болды.
Dialogue: 0,0:07:21.02,0:07:23.52,Default,,0000,0000,0000,,《А... иә, жарайды.
Dialogue: 0,0:07:23.52,0:07:26.42,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:23.52,0:07:26.42,Default,,0000,0000,0000,,А, мені ақымақ деп айт.
Dialogue: 0,0:07:23.52,0:07:26.42,Rubi,,0000,0000,0000,,Око
Dialogue: 0,0:07:23.52,0:07:26.42,Default,,0000,0000,0000,,Мен ашуландым》
Dialogue: 0,0:07:26.42,0:07:29.96,Default,,0000,0000,0000,,《Жаман... Осылай қалса...
Dialogue: 0,0:07:26.42,0:07:29.96,Rubi,,0000,0000,0000,,Око
Dialogue: 0,0:07:26.42,0:07:29.96,Default,,0000,0000,0000,,Менің үйімде ұрысасың.
Dialogue: 0,0:07:29.96,0:07:32.46,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:29.96,0:07:32.46,Rubi,,0000,0000,0000,,Тегара
Dialogue: 0,0:07:29.96,0:07:32.46,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:07:29.96,0:07:32.46,Default,,0000,0000,0000,,Мен несие алуым керек.
Dialogue: 0,0:07:32.46,0:07:34.96,Rubi,,0000,0000,0000,,Тогава
Dialogue: 0,0:07:32.46,0:07:34.96,Default,,0000,0000,0000,,Иә, онда
Dialogue: 0,0:07:32.46,0:07:34.96,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:07:32.46,0:07:34.96,Default,,0000,0000,0000,,Мұны кім түсінеді?
Dialogue: 0,0:07:34.96,0:07:38.47,Rubi,,0000,0000,0000,,Сеито
Dialogue: 0,0:07:34.96,0:07:38.47,Default,,0000,0000,0000,,(Оқушылар)
Dialogue: 0,0:07:34.96,0:07:38.47,Default,,0000,0000,0000,,Иә! Иә!
Dialogue: 0,0:07:38.47,0:07:39.44,Default,,0000,0000,0000,,《Жарайды.
Dialogue: 0,0:07:39.44,0:07:42.97,Rubi,,0000,0000,0000,,Фалко!!
Dialogue: 0,0:07:39.44,0:07:42.97,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:39.44,0:07:42.97,Default,,0000,0000,0000,,Қолдарын қанша рет көтеріп тұр.
Dialogue: 0,0:07:39.44,0:07:42.97,Rubi,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:07:39.44,0:07:42.97,Default,,0000,0000,0000,,Ол көрсетілмейді.
Dialogue: 0,0:07:42.97,0:07:45.48,Rubi,,0000,0000,0000,,Ичиу
Dialogue: 0,0:07:42.97,0:07:45.48,Rubi,,0000,0000,0000,,Фалко!!
Dialogue: 0,0:07:42.97,0:07:45.48,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:42.97,0:07:45.48,Default,,0000,0000,0000,,Қолыңызды көтеріңіз.
Dialogue: 0,0:07:42.97,0:07:45.48,Rubi,,0000,0000,0000,,Каппацу
Dialogue: 0,0:07:42.97,0:07:45.48,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:07:42.97,0:07:45.48,Default,,0000,0000,0000,,Сіз белсенді сияқтысыз》
Dialogue: 0,0:07:45.48,0:07:46.98,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:46.98,0:07:49.48,Rubi,,0000,0000,0000,,Сузуки-кун
Dialogue: 0,0:07:46.98,0:07:49.48,Default,,0000,0000,0000,,Олай болса, Судзуки-кун.
Dialogue: 0,0:07:46.98,0:07:49.48,Rubi,,0000,0000,0000,,Сузуки
Dialogue: 0,0:07:46.98,0:07:49.48,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:49.48,0:07:52.98,Rubi,,0000,0000,0000,,Келу
Dialogue: 0,0:07:49.48,0:07:52.98,Default,,0000,0000,0000,,《А, бұл көмектесті.
Dialogue: 0,0:07:49.48,0:07:52.98,Default,,0000,0000,0000,,Бөлшек》
Dialogue: 0,0:07:52.98,0:07:55.98,Default,,0000,0000,0000,,<Шамасы, тағы да
Dialogue: 0,0:07:52.98,0:07:55.98,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:07:52.98,0:07:55.98,Default,,0000,0000,0000,,Ол «ақымақ» деп тұрған сияқты>
Dialogue: 0,0:07:57.49,0:07:59.99,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:07:57.49,0:07:59.99,Default,,0000,0000,0000,,Ал, келесі жолы
Dialogue: 0,0:07:57.49,0:07:59.99,Default,,0000,0000,0000,,Мен сізге осыны сынап көруге рұқсат ете аламын ба?
Dialogue: 0,0:07:59.99,0:08:02.49,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:07:59.99,0:08:02.49,Default,,0000,0000,0000,,Түсінетін адамдар
Dialogue: 0,0:07:59.99,0:08:02.49,Rubi,,0000,0000,0000,,Сеито
Dialogue: 0,0:07:59.99,0:08:02.49,Default,,0000,0000,0000,,Уа!
Dialogue: 0,0:08:02.49,0:08:05.39,Rubi,,0000,0000,0000,,Сеито
Dialogue: 0,0:08:02.49,0:08:05.39,Rubi,,0000,0000,0000,,Генки
Dialogue: 0,0:08:02.49,0:08:05.39,Rubi,,0000,0000,0000,,Дыбыс
Dialogue: 0,0:08:02.49,0:08:05.39,Default,,0000,0000,0000,,(Оқушылардың жігерлі дауыстары)
Dialogue: 0,0:08:05.39,0:08:06.36,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:06.36,0:08:08.00,Rubi,,0000,0000,0000,,Тогава
Dialogue: 0,0:08:06.36,0:08:08.00,Default,,0000,0000,0000,,Олай болса, Сакура-сан.
Dialogue: 0,0:08:06.36,0:08:08.00,Default,,0000,0000,0000,,Кеттік
Dialogue: 0,0:08:08.00,0:08:10.90,Default,,0000,0000,0000,,《О...》
Dialogue: 0,0:08:10.90,0:08:13.50,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:08:10.90,0:08:13.50,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:08:10.90,0:08:13.50,Default,,0000,0000,0000,,Иә, алға шықшы.
Dialogue: 0,0:08:13.50,0:08:14.47,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:08:13.50,0:08:14.47,Default,,0000,0000,0000,,Маруко…
Dialogue: 0,0:08:14.47,0:08:15.44,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:08:15.44,0:08:19.01,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:08:15.44,0:08:19.01,Rubi,,0000,0000,0000,,Сөздік
Dialogue: 0,0:08:15.44,0:08:19.01,Default,,0000,0000,0000,,《Мұғалім, сізде онша сенімділік жоқ сияқты.
Dialogue: 0,0:08:15.44,0:08:19.01,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:08:15.44,0:08:19.01,Default,,0000,0000,0000,,Мені болжауға қалай батылы бардың?
Dialogue: 0,0:08:19.01,0:08:21.91,Rubi,,0000,0000,0000,,Өсімдіктер
Dialogue: 0,0:08:19.01,0:08:21.91,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:08:19.01,0:08:21.91,Rubi,,0000,0000,0000,,Орындалды
Dialogue: 0,0:08:19.01,0:08:21.91,Rubi,,0000,0000,0000,,Хання
Dialogue: 0,0:08:19.01,0:08:21.91,Default,,0000,0000,0000,,Сол мейірімді жүздің астында Хання тұр.
Dialogue: 0,0:08:21.91,0:08:24.81,Default,,0000,0000,0000,,《Ал,
Dialogue: 0,0:08:21.91,0:08:24.81,Rubi,,0000,0000,0000,,Якубун
Dialogue: 0,0:08:21.91,0:08:24.81,Default,,0000,0000,0000,,Өйткені 3 және 3-ті азайтуға болады...
Dialogue: 0,0:08:24.81,0:08:26.31,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:08:24.81,0:08:26.31,Default,,0000,0000,0000,,Бұл оңай》
Dialogue: 0,0:08:28.45,0:08:32.32,Default,,0000,0000,0000,,Дайын
Dialogue: 0,0:08:28.45,0:08:32.32,Rubi,,0000,0000,0000,,сенімді жігіт болып көрінуге тырысып жүрсің…
Dialogue: 0,0:08:28.45,0:08:32.32,Rubi,,0000,0000,0000,,Қосымша
Dialogue: 0,0:08:28.45,0:08:32.32,Default,,0000,0000,0000,,Иә, сіз өз орныңызға орала аласыз.
Dialogue: 0,0:08:32.32,0:08:34.96,Default,,0000,0000,0000,,《Иә? Бірден бастайық
Dialogue: 0,0:08:32.32,0:08:34.96,Rubi,,0000,0000,0000,,Қазір
Dialogue: 0,0:08:32.32,0:08:34.96,Default,,0000,0000,0000,,Сіз «ақымақ» дейсіз
Dialogue: 0,0:08:34.96,0:08:35.93,Default,,0000,0000,0000,,Не? Неліктен? 》
Dialogue: 0,0:08:35.93,0:08:38.83,Rubi,,0000,0000,0000,,Тогава
Dialogue: 0,0:08:35.93,0:08:38.83,Default,,0000,0000,0000,,(Тогава)
Dialogue: 0,0:08:35.93,0:08:38.83,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:08:35.93,0:08:38.83,Default,,0000,0000,0000,,Ах, Сакура-сан, қандай ұят.
Dialogue: 0,0:08:38.83,0:08:40.83,Rubi,,0000,0000,0000,,Иккай
Dialogue: 0,0:08:38.83,0:08:40.83,Rubi,,0000,0000,0000,,Якубун
Dialogue: 0,0:08:38.83,0:08:40.83,Default,,0000,0000,0000,,Оны тағы бір рет азайтуға болады.
Dialogue: 0,0:08:40.83,0:08:43.83,Rubi,,0000,0000,0000,,Қате
Dialogue: 0,0:08:40.83,0:08:43.83,Default,,0000,0000,0000,,《Ол кетті! Мен қателестім》
Dialogue: 0,0:08:45.97,0:08:47.97,Default,,0000,0000,0000,,《Бұл жігіт өте қауіпті》
Dialogue: 0,0:08:49.47,0:08:51.47,Rubi,,0000,0000,0000,,Келесі
Dialogue: 0,0:08:49.47,0:08:51.47,Rubi,,0000,0000,0000,,Вакабаяши-кун
Dialogue: 0,0:08:49.47,0:08:51.47,Default,,0000,0000,0000,,Ал, келесі кезекте Вакабаяси-кун.
Dialogue: 0,0:08:49.47,0:08:51.47,Rubi,,0000,0000,0000,,Вакабаяши
Dialogue: 0,0:08:49.47,0:08:51.47,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:52.38,0:08:54.34,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:08:52.38,0:08:54.34,Default,,0000,0000,0000,,О, бүгін.
Dialogue: 0,0:08:52.38,0:08:54.34,Default,,0000,0000,0000,,Бұл тамаша
Dialogue: 0,0:08:54.34,0:08:55.34,Default,,0000,0000,0000,,Эхехе…
Dialogue: 0,0:08:55.34,0:08:57.98,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:08:55.34,0:08:57.98,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:08:55.34,0:08:57.98,Rubi,,0000,0000,0000,,Коби
Dialogue: 0,0:08:55.34,0:08:57.98,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:08:55.34,0:08:57.98,Default,,0000,0000,0000,,Мұғалім де бүгін Кобеден бірдеңе сатып алды.
Dialogue: 0,0:08:57.98,0:09:00.48,Default,,0000,0000,0000,,Сәнді галстук
Dialogue: 0,0:08:57.98,0:09:00.48,Default,,0000,0000,0000,,Мен орындадым
Dialogue: 0,0:09:00.48,0:09:02.99,Default,,0000,0000,0000,,Осыған ұқсас нәрсе
Dialogue: 0,0:09:00.48,0:09:02.99,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:09:00.48,0:09:02.99,Default,,0000,0000,0000,,Шалекөбе деп аталады.
Dialogue: 0,0:09:02.99,0:09:05.49,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:09:02.99,0:09:05.49,Rubi,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:09:02.99,0:09:05.49,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:09:02.99,0:09:05.49,Default,,0000,0000,0000,,(Ананың күлкісі)
Dialogue: 0,0:09:05.49,0:09:09.36,Default,,0000,0000,0000,,《Аа...
Dialogue: 0,0:09:05.49,0:09:09.36,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:09:05.49,0:09:09.36,Default,,0000,0000,0000,,Мұғалім, жарайды.
Dialogue: 0,0:09:09.36,0:09:12.36,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:09:09.36,0:09:12.36,Default,,0000,0000,0000,,Көбірек сөз тіркесін айт
Dialogue: 0,0:09:09.36,0:09:12.36,Rubi,,0000,0000,0000,,Наго
Dialogue: 0,0:09:09.36,0:09:12.36,Default,,0000,0000,0000,,Маған тыныштық беріңіз.
Dialogue: 0,0:09:12.36,0:09:15.00,Rubi,,0000,0000,0000,,Келесі
Dialogue: 0,0:09:12.36,0:09:15.00,Default,,0000,0000,0000,,Олай болса, келесіге барайық!
Dialogue: 0,0:09:15.00,0:09:17.50,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:09:15.00,0:09:17.50,Default,,0000,0000,0000,,Мұғалімдікі
Dialogue: 0,0:09:15.00,0:09:17.50,Rubi,,0000,0000,0000,,Келесі
Dialogue: 0,0:09:15.00,0:09:17.50,Default,,0000,0000,0000,,«Келесі жолы барайық»
Dialogue: 0,0:09:17.50,0:09:19.44,Rubi,,0000,0000,0000,,Кин
Dialogue: 0,0:09:17.50,0:09:19.44,Rubi,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:09:17.50,0:09:19.44,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:09:17.50,0:09:19.44,Default,,0000,0000,0000,,Ол Кин Чанға ұқсамайды деп ойлайсың ба?
Dialogue: 0,0:09:19.44,0:09:22.00,Default,,0000,0000,0000,,Иә, кукуку...
Dialogue: 0,0:09:22.00,0:09:25.44,Default,,0000,0000,0000,,Міне, міне, Сакура-сан
Dialogue: 0,0:09:22.00,0:09:25.44,Default,,0000,0000,0000,,Сөйлеме
Dialogue: 0,0:09:25.44,0:09:27.44,Default,,0000,0000,0000,,《Аха... аа...》
Dialogue: 0,0:09:28.95,0:09:31.85,Default,,0000,0000,0000,,《Мен оны енді «ақымақ» деп те айта алмаймын.
Dialogue: 0,0:09:28.95,0:09:31.85,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:09:28.95,0:09:31.85,Default,,0000,0000,0000,,Маған айтпа
Dialogue: 0,0:09:31.85,0:09:35.45,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:09:31.85,0:09:35.45,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:09:31.85,0:09:35.45,Default,,0000,0000,0000,,Сіз мені «ақымақ» деп атағаныңызда
Dialogue: 0,0:09:31.85,0:09:35.45,Default,,0000,0000,0000,,Мен ностальгия сезінемін...》
Dialogue: 0,0:09:35.45,0:09:38.35,Rubi,,0000,0000,0000,,Данши
Dialogue: 0,0:09:35.45,0:09:38.35,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:09:35.45,0:09:38.35,Default,,0000,0000,0000,,Ұстаз!
Dialogue: 0,0:09:35.45,0:09:38.35,Rubi,,0000,0000,0000,,Ямамото
