Dialogue: 0,0:21:30.44,0:21:32.37,Default,,0000,0000,0000,,Аяғын батпаққа тығып алып, осы жардан құлап кеткен бе? ➡
Dialogue: 0,0:21:32.37,0:21:36.31,Rubi,,0000,0000,0000,,Кенгю
Dialogue: 0,0:21:32.37,0:21:36.31,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:21:32.37,0:21:36.31,Default,,0000,0000,0000,,Әкем сияқты мал айдау
Dialogue: 0,0:21:32.37,0:21:36.31,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:21:32.37,0:21:36.31,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:21:32.37,0:21:36.31,Default,,0000,0000,0000,,Мүмкін сіз шалбарыңызды ауыстыруды ұмытып кеткен шығарсыз.
Dialogue: 0,0:21:36.31,0:21:38.94,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:21:36.31,0:21:38.94,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:21:36.31,0:21:38.94,Default,,0000,0000,0000,,Ақымақ!
Dialogue: 0,0:21:38.94,0:21:41.45,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:21:38.94,0:21:41.45,Default,,0000,0000,0000,,Ах! Чойто ана
Dialogue: 0,0:21:41.45,0:21:44.35,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:21:41.45,0:21:44.35,Default,,0000,0000,0000,,Маған қарбыз әкел.
Dialogue: 0,0:21:41.45,0:21:44.35,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:21:41.45,0:21:44.35,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:21:41.45,0:21:44.35,Default,,0000,0000,0000,,Маруко осында тамақтанады
Dialogue: 0,0:21:44.35,0:21:46.95,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:21:44.35,0:21:46.95,Rubi,,0000,0000,0000,,Эдамаме
Dialogue: 0,0:21:44.35,0:21:46.95,Default,,0000,0000,0000,,Менде де сыра мен эдамам бар.
Dialogue: 0,0:21:44.35,0:21:46.95,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:21:44.35,0:21:46.95,Default,,0000,0000,0000,,Оны маған әкеліңіз.
Dialogue: 0,0:21:46.95,0:21:49.46,Default,,0000,0000,0000,,О, және
Dialogue: 0,0:21:46.95,0:21:49.46,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:21:46.95,0:21:49.46,Rubi,,0000,0000,0000,,Сашими
Dialogue: 0,0:21:46.95,0:21:49.46,Default,,0000,0000,0000,,Салқындатылған якитори мен сашими
Dialogue: 0,0:21:49.46,0:21:52.36,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:21:49.46,0:21:52.36,Default,,0000,0000,0000,,Сіз не туралы ойлайсыз?
Dialogue: 0,0:21:49.46,0:21:52.36,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:21:49.46,0:21:52.36,Default,,0000,0000,0000,,Егер сіз осындай жерде тамақтансаңыз ше?
Dialogue: 0,0:21:52.36,0:21:54.86,Rubi,,0000,0000,0000,,Цуукоунин
Dialogue: 0,0:21:52.36,0:21:54.86,Rubi,,0000,0000,0000,,Маруми
Dialogue: 0,0:21:52.36,0:21:54.86,Default,,0000,0000,0000,,Өтіп бара жатқандардың көз алдында
Dialogue: 0,0:21:52.36,0:21:54.86,Default,,0000,0000,0000,,шіркін, солай емес пе?
Dialogue: 0,0:21:56.33,0:21:58.46,Default,,0000,0000,0000,,Менің ойымша, бұл жақсы емес ...
Dialogue: 0,0:21:56.33,0:21:58.46,Default,,0000,0000,0000,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:21:58.46,0:22:00.40,Default,,0000,0000,0000,,…Осылайша мен осы сұмдыққа ат қойдым
Dialogue: 0,0:21:58.46,0:22:00.40,Default,,0000,0000,0000,,Ах...
