Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:07.95,0:01:18.45,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:15.38,0:03:19.51,Rubi,,0000,0000,0000,,Орихим
Dialogue: 0,0:03:15.38,0:03:19.51,Rubi,,0000,0000,0000,,Кенгю
Dialogue: 0,0:03:15.38,0:03:19.51,Default,,0000,0000,0000,,Орихиме және сиыр
Dialogue: 0,0:03:15.38,0:03:19.51,Rubi,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:03:15.38,0:03:19.51,Rubi,,0000,0000,0000,,Фуфуфу
Dialogue: 0,0:03:15.38,0:03:19.51,Default,,0000,0000,0000,,Олар өте жақын жұп болды.
Dialogue: 0,0:03:19.51,0:03:23.02,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,0:03:19.51,0:03:23.02,Rubi,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:03:19.51,0:03:23.02,Default,,0000,0000,0000,,Біз бір-бірімізге тым жақынбыз.
Dialogue: 0,0:03:23.02,0:03:26.52,Rubi,,0000,0000,0000,,Орихим
Dialogue: 0,0:03:23.02,0:03:26.52,Rubi,,0000,0000,0000,,Кенгю
Dialogue: 0,0:03:23.02,0:03:26.52,Rubi,,0000,0000,0000,,Жұмыс
Dialogue: 0,0:03:23.02,0:03:26.52,Default,,0000,0000,0000,,Орихиме де, Кенгю да жұмыс істейді
Dialogue: 0,0:03:23.02,0:03:26.52,Default,,0000,0000,0000,,Мен мұны тоқтаттым.
Dialogue: 0,0:03:26.52,0:03:28.96,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:26.52,0:03:28.96,Default,,0000,0000,0000,,(Маруко)
Dialogue: 0,0:03:26.52,0:03:28.96,Rubi,,0000,0000,0000,,Кимо
Dialogue: 0,0:03:26.52,0:03:28.96,Default,,0000,0000,0000,,Иә, мен бұл сезімді түсінемін.
Dialogue: 0,0:03:28.96,0:03:32.46,Rubi,,0000,0000,0000,,Хатара
Dialogue: 0,0:03:28.96,0:03:32.46,Rubi,,0000,0000,0000,,Асо
Dialogue: 0,0:03:28.96,0:03:32.46,Default,,0000,0000,0000,,Жұмыс істегеннен гөрі ойнаған жақсы
Dialogue: 0,0:03:28.96,0:03:32.46,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:03:28.96,0:03:32.46,Default,,0000,0000,0000,,Мен оның жақсы екеніне сенімдімін.
Dialogue: 0,0:03:32.46,0:03:34.39,Rubi,,0000,0000,0000,,Құдай
Dialogue: 0,0:03:32.46,0:03:34.39,Rubi,,0000,0000,0000,,Екі адам
Dialogue: 0,0:03:32.46,0:03:34.39,Default,,0000,0000,0000,,Құдай оларды біріктірді.
Dialogue: 0,0:03:34.39,0:03:37.96,Rubi,,0000,0000,0000,,Тәтті
Dialogue: 0,0:03:34.39,0:03:37.96,Rubi,,0000,0000,0000,,Гава
Dialogue: 0,0:03:34.39,0:03:37.96,Default,,0000,0000,0000,,Құс жолы арқылы
Dialogue: 0,0:03:34.39,0:03:37.96,Rubi,,0000,0000,0000,,Вака
Dialogue: 0,0:03:34.39,0:03:37.96,Default,,0000,0000,0000,,Қоштасуға рұқсат етіңіз
Dialogue: 0,0:03:37.96,0:03:41.47,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:03:37.96,0:03:41.47,Default,,0000,0000,0000,,Жылына бір рет қана
Dialogue: 0,0:03:37.96,0:03:41.47,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:03:37.96,0:03:41.47,Default,,0000,0000,0000,,Мен сені көруге мүмкіндік бермедім.
Dialogue: 0,0:03:41.47,0:03:43.97,Rubi,,0000,0000,0000,,Екі адам
Dialogue: 0,0:03:41.47,0:03:43.97,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:03:41.47,0:03:43.97,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:03:41.47,0:03:43.97,Default,,0000,0000,0000,,Сонда кездесетін күн
Dialogue: 0,0:03:41.47,0:03:43.97,Rubi,,0000,0000,0000,,Танабата
Dialogue: 0,0:03:41.47,0:03:43.97,Default,,0000,0000,0000,,Бұл Танабата
Dialogue: 0,0:03:43.97,0:03:46.87,Rubi,,0000,0000,0000,,Екі адам
Dialogue: 0,0:03:43.97,0:03:46.87,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:03:43.97,0:03:46.87,Rubi,,0000,0000,0000,,Асо
Dialogue: 0,0:03:43.97,0:03:46.87,Default,,0000,0000,0000,,Екеуің бірге не ойнадыңдар?
Dialogue: 0,0:03:46.87,0:03:51.48,Rubi,,0000,0000,0000,,Құдай
Dialogue: 0,0:03:46.87,0:03:51.48,Rubi,,0000,0000,0000,,Око
Dialogue: 0,0:03:46.87,0:03:51.48,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:03:46.87,0:03:51.48,Default,,0000,0000,0000,,Құдай ашуланбас бұрын
Dialogue: 0,0:03:46.87,0:03:51.48,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:03:46.87,0:03:51.48,Default,,0000,0000,0000,,Сіз байқамаған шығарсыз.
Dialogue: 0,0:03:51.48,0:03:52.98,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:51.48,0:03:52.98,Default,,0000,0000,0000,,Маруко…
Dialogue: 0,0:03:53.98,0:03:57.85,Rubi,,0000,0000,0000,,Қорытынды
Dialogue: 0,0:03:53.98,0:03:57.85,Default,,0000,0000,0000,,Бұл басынан бастап менмін.
Dialogue: 0,0:03:53.98,0:03:57.85,Rubi,,0000,0000,0000,,Кенгю
Dialogue: 0,0:03:53.98,0:03:57.85,Rubi,,0000,0000,0000,,Орын
Dialogue: 0,0:03:53.98,0:03:57.85,Default,,0000,0000,0000,,Мал айдаған адам
Dialogue: 0,0:03:57.85,0:04:01.49,Rubi,,0000,0000,0000,,Әйел
Dialogue: 0,0:03:57.85,0:04:01.49,Default,,0000,0000,0000,,Егер сіз әйел болсаңыз жұмыс істемейтін тип болсаңыз.
Dialogue: 0,0:03:57.85,0:04:01.49,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:03:57.85,0:04:01.49,Default,,0000,0000,0000,,Мен ойладым
Dialogue: 0,0:04:01.49,0:04:03.42,Rubi,,0000,0000,0000,,Орихим
Dialogue: 0,0:04:01.49,0:04:03.42,Default,,0000,0000,0000,,Бұл Орихиме шығар...
Dialogue: 0,0:04:03.42,0:04:06.36,Default,,0000,0000,0000,,Әлде бұл—
Dialogue: 0,0:04:03.42,0:04:06.36,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:03.42,0:04:06.36,Rubi,,0000,0000,0000,,НАСА
Dialogue: 0,0:04:03.42,0:04:06.36,Default,,0000,0000,0000,,Бұл бала шынымен аянышты.
Dialogue: 0,0:04:06.36,0:04:08.36,Rubi,,0000,0000,0000,,Танабата
Dialogue: 0,0:04:06.36,0:04:08.36,Rubi,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:04:06.36,0:04:08.36,Default,,0000,0000,0000,,Енді Танабата туралы айтпай-ақ қояйын
Dialogue: 0,0:04:08.36,0:04:10.50,Default,,0000,0000,0000,,Аа, кешіріңіз, кешіріңіз.
Dialogue: 0,0:04:10.50,0:04:12.00,Default,,0000,0000,0000,,Мен мүлде таң қалдым.
Dialogue: 0,0:04:12.00,0:04:16.87,Rubi,,0000,0000,0000,,Танзаку
Dialogue: 0,0:04:12.00,0:04:16.87,Rubi,,0000,0000,0000,,Теріс
Dialogue: 0,0:04:12.00,0:04:16.87,Default,,0000,0000,0000,,Бірақ неге қағаз жолағында тілек айттыңыз?
Dialogue: 0,0:04:12.00,0:04:16.87,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:12.00,0:04:16.87,Default,,0000,0000,0000,,Жазсам, орындала ма?
Dialogue: 0,0:04:16.87,0:04:19.51,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:04:16.87,0:04:19.51,Rubi,,0000,0000,0000,,Иккай
Dialogue: 0,0:04:16.87,0:04:19.51,Default,,0000,0000,0000,,Жылына бір рет.
Dialogue: 0,0:04:19.51,0:04:23.38,Rubi,,0000,0000,0000,,Орихим
Dialogue: 0,0:04:19.51,0:04:23.38,Rubi,,0000,0000,0000,,Кенгю
Dialogue: 0,0:04:19.51,0:04:23.38,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:04:19.51,0:04:23.38,Default,,0000,0000,0000,,Орихиме мен Кенгю кездесе алады
Dialogue: 0,0:04:19.51,0:04:23.38,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:04:19.51,0:04:23.38,Default,,0000,0000,0000,,Бұл сіз бақытты болғандықтан шешілді, солай ма?
Dialogue: 0,0:04:23.38,0:04:27.95,Rubi,,0000,0000,0000,,Танин
Dialogue: 0,0:04:23.38,0:04:27.95,Default,,0000,0000,0000,,Біреудің бақыты
Dialogue: 0,0:04:23.38,0:04:27.95,Rubi,,0000,0000,0000,,Теріс
Dialogue: 0,0:04:23.38,0:04:27.95,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:04:23.38,0:04:27.95,Default,,0000,0000,0000,,Менің тілегімді тыңдайсыз ба?
Dialogue: 0,0:04:27.95,0:04:31.82,Rubi,,0000,0000,0000,,Чосимоно
Dialogue: 0,0:04:27.95,0:04:31.82,Default,,0000,0000,0000,,Сіз ақкөңіл адамсыз, солай емес пе?
Dialogue: 0,0:04:27.95,0:04:31.82,Rubi,,0000,0000,0000,,Екі адам
Dialogue: 0,0:04:27.95,0:04:31.82,Default,,0000,0000,0000,,Олардың екеуі
Dialogue: 0,0:04:31.82,0:04:32.82,Default,,0000,0000,0000,,Сіз...
Dialogue: 0,0:04:32.82,0:04:35.46,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:04:32.82,0:04:35.46,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:32.82,0:04:35.46,Default,,0000,0000,0000,,Ах, Маруко
Dialogue: 0,0:04:32.82,0:04:35.46,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:04:32.82,0:04:35.46,Default,,0000,0000,0000,,Атаммен
Dialogue: 0,0:04:35.46,0:04:37.96,Rubi,,0000,0000,0000,,Таматсу Танабата
Dialogue: 0,0:04:35.46,0:04:37.96,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:35.46,0:04:37.96,Default,,0000,0000,0000,,Танабата фестиваліне барғыңыз келе ме?
Dialogue: 0,0:04:37.96,0:04:40.86,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:04:37.96,0:04:40.86,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:37.96,0:04:40.86,Default,,0000,0000,0000,,Әй, ата, бүгін барасыз ба?
Dialogue: 0,0:04:40.86,0:04:42.46,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:04:40.86,0:04:42.46,Rubi,,0000,0000,0000,,Муика
Dialogue: 0,0:04:40.86,0:04:42.46,Default,,0000,0000,0000,,Бүгін небәрі 6-шы.
Dialogue: 0,0:04:42.46,0:04:45.97,Rubi,,0000,0000,0000,,Бұл солай ма?
Dialogue: 0,0:04:42.46,0:04:45.97,Default,,0000,0000,0000,,Ah 5 6 7 күн және
Dialogue: 0,0:04:42.46,0:04:45.97,Default,,0000,0000,0000,,Бұл аяқталды
Dialogue: 0,0:04:45.97,0:04:47.90,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:04:45.97,0:04:47.90,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:45.97,0:04:47.90,Default,,0000,0000,0000,,Бүгін баруға болады ма?
Dialogue: 0,0:04:47.90,0:04:50.84,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:04:47.90,0:04:50.84,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:47.90,0:04:50.84,Default,,0000,0000,0000,,Мен ертең баруым керек.
Dialogue: 0,0:04:50.84,0:04:53.47,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:50.84,0:04:53.47,Default,,0000,0000,0000,,Мен саған кез келген нәрсені сатып аламын.
Dialogue: 0,0:04:53.47,0:04:58.35,Rubi,,0000,0000,0000,,Танабата
Dialogue: 0,0:04:53.47,0:04:58.35,Default,,0000,0000,0000,,Хмм, бірақ Танабата
Dialogue: 0,0:04:53.47,0:04:58.35,Rubi,,0000,0000,0000,,Бұл солай ма?
Dialogue: 0,0:04:53.47,0:04:58.35,Rubi,,0000,0000,0000,,Югата
Dialogue: 0,0:04:53.47,0:04:58.35,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:53.47,0:04:58.35,Default,,0000,0000,0000,,Тек 7-ші күні кешке барыңыз.
Dialogue: 0,0:04:58.35,0:05:00.35,Rubi,,0000,0000,0000,,Фузей
Dialogue: 0,0:04:58.35,0:05:00.35,Default,,0000,0000,0000,,Атмосфера туралы бірдеңе бар.
Dialogue: 0,0:05:00.35,0:05:01.98,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:00.35,0:05:01.98,Default,,0000,0000,0000,,Маруко
Dialogue: 0,0:05:01.98,0:05:03.92,Rubi,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:05:01.98,0:05:03.92,Default,,0000,0000,0000,,Мені атама апарыңыз
Dialogue: 0,0:05:01.98,0:05:03.92,Default,,0000,0000,0000,,Тек оны алыңыз.\NБұл
Dialogue: 0,0:05:03.92,0:05:06.49,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:03.92,0:05:06.49,Rubi,,0000,0000,0000,,ма?
Dialogue: 0,0:05:03.92,0:05:06.49,Default,,0000,0000,0000,,7 күн болмаса да...
Dialogue: 0,0:05:06.49,0:05:08.99,Default,,0000,0000,0000,,Жоқ, ертең істеймін.
Dialogue: 0,0:05:08.99,0:05:12.49,Rubi,,0000,0000,0000,,Нихонджин
Dialogue: 0,0:05:08.99,0:05:12.49,Default,,0000,0000,0000,,Міне, бізді жапон етеді.
Dialogue: 0,0:05:12.49,0:05:15.49,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:12.49,0:05:15.49,Default,,0000,0000,0000,,<Не қызықсыз?
Dialogue: 0,0:05:12.49,0:05:15.49,Rubi,,0000,0000,0000,,Әшекейлеу
Dialogue: 0,0:05:12.49,0:05:15.49,Default,,0000,0000,0000,,Сіз талап қоясыз ба＞
