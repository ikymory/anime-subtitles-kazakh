Dialogue: 0,0:24:21.22,0:24:24.72,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:21.22,0:24:24.72,Default,,0000,0000,0000,,Иә, сен жақсы қызсың.
Dialogue: 0,0:24:24.72,0:24:27.22,Default,,0000,0000,0000,,Бұл үшін рахмет, хаха
Dialogue: 0,0:24:28.23,0:24:30.73,Rubi,,0000,0000,0000,,Нейки
Dialogue: 0,0:24:28.23,0:24:30.73,Default,,0000,0000,0000,,(Ұйқыда)
Dialogue: 0,0:24:32.73,0:24:34.23,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:32.73,0:24:34.23,Default,,0000,0000,0000,,...
Dialogue: 0,0:24:34.23,0:24:35.73,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:34.23,0:24:35.73,Default,,0000,0000,0000,,Маруко!
Dialogue: 0,0:24:38.10,0:24:39.74,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:24:38.10,0:24:39.74,Default,,0000,0000,0000,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:24:39.74,0:24:43.24,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:24:39.74,0:24:43.24,Default,,0000,0000,0000,,Ояну керек.
Dialogue: 0,0:24:39.74,0:24:43.24,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:24:39.74,0:24:43.24,Rubi,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:24:39.74,0:24:43.24,Default,,0000,0000,0000,,Сіз қанша уақыт ұйықтадыңыз?
Dialogue: 0,0:24:43.24,0:24:44.74,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:24:43.24,0:24:44.74,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:24:43.24,0:24:44.74,Default,,0000,0000,0000,,Сағатқа қараңдар!
Dialogue: 0,0:24:44.74,0:24:49.25,Rubi,,0000,0000,0000,,Джи
Dialogue: 0,0:24:44.74,0:24:49.25,Default,,0000,0000,0000,,Ха 1 сағат
Dialogue: 0,0:24:44.74,0:24:49.25,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:24:44.74,0:24:49.25,Default,,0000,0000,0000,,Бірақ неге анаң?
Dialogue: 0,0:24:49.25,0:24:51.18,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:24:49.25,0:24:51.18,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:24:49.25,0:24:51.18,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:24:49.25,0:24:51.18,Default,,0000,0000,0000,,Мен анаммен үйге бара жатырмын.
Dialogue: 0,0:24:51.18,0:24:53.12,Rubi,,0000,0000,0000,,Шинпай
Dialogue: 0,0:24:51.18,0:24:53.12,Default,,0000,0000,0000,,Сіз мені қатты алаңдатып отырсыз.
Dialogue: 0,0:24:53.12,0:24:54.75,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:24:54.75,0:24:58.26,Default,,0000,0000,0000,,Әже әже
Dialogue: 0,0:24:54.75,0:24:58.26,Rubi,,0000,0000,0000,,Сева
Dialogue: 0,0:24:54.75,0:24:58.26,Default,,0000,0000,0000,,Көмегің үшін көп рахмет.
Dialogue: 0,0:24:58.26,0:25:00.76,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:24:58.26,0:25:00.76,Default,,0000,0000,0000,,Бұл өте көңілді болды.
Dialogue: 0,0:25:00.76,0:25:04.26,Default,,0000,0000,0000,,Ах! Иә
Dialogue: 0,0:25:00.76,0:25:04.26,Rubi,,0000,0000,0000,,Козука
Dialogue: 0,0:25:00.76,0:25:04.26,Default,,0000,0000,0000,,Мару-чанға қалталы ақша берейік.
Dialogue: 0,0:25:04.26,0:25:06.76,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:25:04.26,0:25:06.76,Rubi,,0000,0000,0000,,Игай
Dialogue: 0,0:25:04.26,0:25:06.76,Rubi,,0000,0000,0000,,Тосын
Dialogue: 0,0:25:04.26,0:25:06.76,Default,,0000,0000,0000,,＜Мен таң қалдым, бірақ
Dialogue: 0,0:25:06.76,0:25:09.27,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:25:06.76,0:25:09.27,Rubi,,0000,0000,0000,,Іс жүзінде
Dialogue: 0,0:25:06.76,0:25:09.27,Default,,0000,0000,0000,,Негізінде, «Мен күттім».
Dialogue: 0,0:25:06.76,0:25:09.27,Rubi,,0000,0000,0000,,Шинкио
Dialogue: 0,0:25:06.76,0:25:09.27,Default,,0000,0000,0000,,Бұл көңіл күйі＞
Dialogue: 0,0:25:09.27,0:25:11.77,Default,,0000,0000,0000,,Ой, жарайды, әже.
Dialogue: 0,0:25:09.27,0:25:11.77,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:25:11.77,0:25:13.27,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:25:11.77,0:25:13.27,Default,,0000,0000,0000,,《Ана?
Dialogue: 0,0:25:11.77,0:25:13.27,Default,,0000,0000,0000,,Жаман нәрсе
Dialogue: 0,0:25:13.27,0:25:15.21,Default,,0000,0000,0000,,Ол маған беремін деді.
Dialogue: 0,0:25:13.27,0:25:15.21,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:25:13.27,0:25:15.21,Default,,0000,0000,0000,,Мен мұны айттым.
Dialogue: 0,0:25:15.21,0:25:18.11,Default,,0000,0000,0000,,Бірақ бұл жақсы емес пе?
Dialogue: 0,0:25:15.21,0:25:18.11,Default,,0000,0000,0000,,Тама жоқ Кодаши
Dialogue: 0,0:25:18.11,0:25:21.08,Default,,0000,0000,0000,,Жоқ! Жарайды
Dialogue: 0,0:25:18.11,0:25:21.08,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:25:18.11,0:25:21.08,Default,,0000,0000,0000,,Ештеңе етпейді, бұл балаға шынымен де дұрыс.
Dialogue: 0,0:25:21.08,0:25:24.21,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:25:21.08,0:25:24.21,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:25:21.08,0:25:24.21,Default,,0000,0000,0000,,《Не десең де,
Dialogue: 0,0:25:21.08,0:25:24.21,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:25:21.08,0:25:24.21,Default,,0000,0000,0000,,Соңында сіз оны әрқашан аласыз.
Dialogue: 0,0:25:24.21,0:25:26.72,Rubi,,0000,0000,0000,,Қайдан бастарын білмеймін.
Dialogue: 0,0:25:24.21,0:25:26.72,Default,,0000,0000,0000,,Олай болса үндеме
Dialogue: 0,0:25:24.21,0:25:26.72,Default,,0000,0000,0000,,Мен оны алғым келеді》
Dialogue: 0,0:25:26.72,0:25:30.59,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:25:26.72,0:25:30.59,Default,,0000,0000,0000,,Шынымен бе? Бұлай көп айтпа
Dialogue: 0,0:25:26.72,0:25:30.59,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:25:26.72,0:25:30.59,Rubi,,0000,0000,0000,,Келесі
Dialogue: 0,0:25:26.72,0:25:30.59,Default,,0000,0000,0000,,Мен мұны келесі жолы осында болғанымда жасаймын.
Dialogue: 0,0:25:30.59,0:25:33.22,Default,,0000,0000,0000,,《Не! Амал жоқ…》
Dialogue: 0,0:25:33.22,0:25:35.16,Rubi,,0000,0000,0000,,Госан
Dialogue: 0,0:25:33.22,0:25:35.16,Default,,0000,0000,0000,,<Бұл өрескел қате есептеу>
Dialogue: 0,0:25:35.16,0:25:38.73,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:25:35.16,0:25:38.73,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:25:35.16,0:25:38.73,Default,,0000,0000,0000,,<Мару-чанның келесі сапары
Dialogue: 0,0:25:35.16,0:25:38.73,Rubi,,0000,0000,0000,,Көпшілігі
Dialogue: 0,0:25:35.16,0:25:38.73,Default,,0000,0000,0000,,Негізгі тақырып
Dialogue: 0,0:25:38.73,0:25:41.23,Rubi,,0000,0000,0000,,Козука
Dialogue: 0,0:25:38.73,0:25:41.23,Default,,0000,0000,0000,,Тіпті «қалта ақшасын алу» болса да＞
Dialogue: 0,0:25:41.23,0:25:43.73,Rubi,,0000,0000,0000,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:25:41.23,0:25:43.73,Default,,0000,0000,0000,,Көріскенше, мен тағы келемін.
Dialogue: 0,0:25:41.23,0:25:43.73,Default,,0000,0000,0000,,Қош бол
Dialogue: 0,0:25:43.73,0:25:45.67,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:25:43.73,0:25:45.67,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:25:43.73,0:25:45.67,Default,,0000,0000,0000,,Маруко! Мен оны сонда қалдырамын.
Dialogue: 0,0:25:45.67,0:25:48.61,Rubi,,0000,0000,0000,,Жол
Dialogue: 0,0:25:45.67,0:25:48.61,Rubi,,0000,0000,0000,,Майо
Dialogue: 0,0:25:45.67,0:25:48.61,Default,,0000,0000,0000,,＜Жолдан адасқан
Dialogue: 0,0:25:45.67,0:25:48.61,Default,,0000,0000,0000,,Сағыныш сезімі
Dialogue: 0,0:25:48.61,0:25:52.24,Rubi,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:25:48.61,0:25:52.24,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:25:48.61,0:25:52.24,Default,,0000,0000,0000,,Мен өзім де әжетханаға бара алмаймын.
Dialogue: 0,0:25:48.61,0:25:52.24,Rubi,,0000,0000,0000,,Өтен
Dialogue: 0,0:25:48.61,0:25:52.24,Rubi,,0000,0000,0000,,Казуказу
Dialogue: 0,0:25:48.61,0:25:52.24,Rubi,,0000,0000,0000,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:25:48.61,0:25:52.24,Default,,0000,0000,0000,,Көп дақтарды қалдырып
Dialogue: 0,0:25:52.24,0:25:56.24,Rubi,,0000,0000,0000,,Хитотаби
Dialogue: 0,0:25:52.24,0:25:56.24,Default,,0000,0000,0000,,Мару-чанның жеке сапары
Dialogue: 0,0:25:52.24,0:25:56.24,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:25:52.24,0:25:56.24,Rubi,,0000,0000,0000,,Егіс
Dialogue: 0,0:25:52.24,0:25:56.24,Default,,0000,0000,0000,,Перде жабылды>
Dialogue: 0,0:26:40.22,0:26:42.73,Rubi,,0000,0000,0000,,Сөздік
Dialogue: 0,0:26:40.22,0:26:42.73,Rubi,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:26:40.22,0:26:42.73,Default,,0000,0000,0000,,Барлығы, жер сілкінісі қорқынышты, солай ма?
Dialogue: 0,0:26:42.73,0:26:44.66,Rubi,,0000,0000,0000,,Сона
Dialogue: 0,0:26:42.73,0:26:44.66,Rubi,,0000,0000,0000,,және тек үшеуміз – анам, әкем және мен – бірге өмір сүремін…
Dialogue: 0,0:26:42.73,0:26:44.66,Default,,0000,0000,0000,,Бірақ «Егер сіз дайын болсаңыз, алаңдаудың қажеті жоқ».
Dialogue: 0,0:26:44.66,0:26:47.56,Rubi,,0000,0000,0000,,Хинан
Dialogue: 0,0:26:44.66,0:26:47.56,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:26:44.66,0:26:47.56,Rubi,,0000,0000,0000,,Мектеп
Dialogue: 0,0:26:44.66,0:26:47.56,Rubi,,0000,0000,0000,,Кунрен
Dialogue: 0,0:26:44.66,0:26:47.56,Default,,0000,0000,0000,,Келесі жолы мектепте эвакуациялау жаттығуы болады.
Dialogue: 0,0:26:47.56,0:26:50.56,Rubi,,0000,0000,0000,,Айнала
Dialogue: 0,0:26:47.56,0:26:50.56,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:26:47.56,0:26:50.56,Default,,0000,0000,0000,,Келесі «Чиби Маруко-чан»...
Dialogue: 0,0:26:58.18,0:27:12.18,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:13.68,0:27:19.68,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory