Dialogue: 0,0:19:28.19,0:19:30.13,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:19:28.19,0:19:30.13,Default,,0000,0000,0000,,Бұл менің анамнан
Dialogue: 0,0:19:28.19,0:19:30.13,Rubi,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:19:28.19,0:19:30.13,Default,,0000,0000,0000,,Тіпті цукудани
Dialogue: 0,0:19:30.13,0:19:33.06,Default,,0000,0000,0000,,Енді, енді.
Dialogue: 0,0:19:30.13,0:19:33.06,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:19:30.13,0:19:33.06,Default,,0000,0000,0000,,Бұл Марукодан
Dialogue: 0,0:19:33.06,0:19:35.07,Default,,0000,0000,0000,,Бұл печенье.
Dialogue: 0,0:19:33.06,0:19:35.07,Default,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:19:35.07,0:19:37.20,Rubi,,0000,0000,0000,,Ұрланған
Dialogue: 0,0:19:35.07,0:19:37.20,Default,,0000,0000,0000,,Мен екеуін де жақсы көремін.
Dialogue: 0,0:19:37.20,0:19:40.70,Default,,0000,0000,0000,,Бұл жақсы болды.
Dialogue: 0,0:19:37.20,0:19:40.70,Default,,0000,0000,0000,,Печенье дәмді.
Dialogue: 0,0:19:40.70,0:19:43.21,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:19:40.70,0:19:43.21,Rubi,,0000,0000,0000,,Сәлемдесу
