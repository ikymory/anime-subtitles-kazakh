Dialogue: 0,0:19:48.71,0:19:52.22,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:19:48.71,0:19:52.22,Default,,0000,0000,0000,,Неліктен қарттар үйі деп аталады?
Dialogue: 0,0:19:48.71,0:19:52.22,Rubi,,0000,0000,0000,,Гораку
Dialogue: 0,0:19:48.71,0:19:52.22,Default,,0000,0000,0000,,Менің ойымша, мұндай ойын-сауық жоқ.
Dialogue: 0,0:19:52.22,0:19:55.72,Rubi,,0000,0000,0000,,Юкай
Dialogue: 0,0:19:52.22,0:19:55.72,Default,,0000,0000,0000,,Кем дегенде теледидар сияқты қызықты нәрсе.
Dialogue: 0,0:19:52.22,0:19:55.72,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:19:52.22,0:19:55.72,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:19:52.22,0:19:55.72,Default,,0000,0000,0000,,Мен оны көргім келеді.
Dialogue: 0,0:19:55.72,0:20:00.22,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:19:55.72,0:20:00.22,Default,,0000,0000,0000,,Өйткені бұл бейтаныс адамның үйі
Dialogue: 0,0:19:55.72,0:20:00.22,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:19:55.72,0:20:00.22,Rubi,,0000,0000,0000,,Бір рет
Dialogue: 0,0:19:55.72,0:20:00.22,Default,,0000,0000,0000,,Ерікті түрде өзгертуге болмайды＞
Dialogue: 0,0:20:00.22,0:20:02.16,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:20:00.22,0:20:02.16,Rubi,,0000,0000,0000,,Джихоу
Dialogue: 0,0:20:00.22,0:20:02.16,Default,,0000,0000,0000,,(Сағат уақыты сигналы)
Dialogue: 0,0:20:00.22,0:20:02.16,Rubi,,0000,0000,0000,,Джи
Dialogue: 0,0:20:00.22,0:20:02.16,Default,,0000,0000,0000,,《сағат 4?
Dialogue: 0,0:20:02.16,0:20:04.09,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:20:02.16,0:20:04.09,Default,,0000,0000,0000,,Мен “Акко-чанды” көргім келеді》
Dialogue: 0,0:20:04.09,0:20:08.10,Default,,0000,0000,0000,,О? О, бұл мүмкін емес
Dialogue: 0,0:20:04.09,0:20:08.10,Rubi,,0000,0000,0000,,Таку
Dialogue: 0,0:20:04.09,0:20:08.10,Default,,0000,0000,0000,,Мару-чан, жалықтырып алған шығарсың.
Dialogue: 0,0:20:08.10,0:20:11.24,Default,,0000,0000,0000,,Е, жоқ, олай емес.
Dialogue: 0,0:20:11.24,0:20:15.74,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:20:11.24,0:20:15.74,Default,,0000,0000,0000,,Дұрыс, мен саған жақсы нәрсе көрсетемін.
Dialogue: 0,0:20:11.24,0:20:15.74,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:20:11.24,0:20:15.74,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:20:11.24,0:20:15.74,Default,,0000,0000,0000,,Иә! не? не?
Dialogue: 0,0:20:15.74,0:20:18.24,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:20:15.74,0:20:18.24,Default,,0000,0000,0000,,Мені күт. Жарайды.
Dialogue: 0,0:20:20.58,0:20:23.18,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:20:20.58,0:20:23.18,Rubi,,0000,0000,0000,,Иә
Dialogue: 0,0:20:20.58,0:20:23.18,Default,,0000,0000,0000,,Онда не бар?
Dialogue: 0,0:20:20.58,0:20:23.18,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:20:20.58,0:20:23.18,Default,,0000,0000,0000,,Сол эмоциясыз қыз –
Dialogue: 0,0:20:23.18,0:20:24.15,Default,,0000,0000,0000,,Хехе
