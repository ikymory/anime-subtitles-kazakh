Dialogue: 0,0:01:04.19,0:01:14.69,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:09.61,0:03:12.58,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:09.61,0:03:12.58,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:09.61,0:03:12.58,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:12.58,0:03:15.22,Rubi,,0000,0000,0000,,Чи
Dialogue: 0,0:03:12.58,0:03:15.22,Default,,0000,0000,0000,,Ешқандай бос орын қалдырмаңыз
Dialogue: 0,0:03:15.22,0:03:18.22,Rubi,,0000,0000,0000,,Ningyou
Dialogue: 0,0:03:15.22,0:03:18.22,Rubi,,0000,0000,0000,,Асо
Dialogue: 0,0:03:15.22,0:03:18.22,Default,,0000,0000,0000,,Қуыршақтармен ойнағаннан кейін
Dialogue: 0,0:03:15.22,0:03:18.22,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:03:15.22,0:03:18.22,Default,,0000,0000,0000,,Оны тазалау керек!
Dialogue: 0,0:03:19.72,0:03:22.63,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:19.72,0:03:22.63,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:03:19.72,0:03:22.63,Default,,0000,0000,0000,,Маруко! Мен сені ести алмаймын
Dialogue: 0,0:03:22.63,0:03:24.16,Default,,0000,0000,0000,,О...
Dialogue: 0,0:03:24.16,0:03:26.10,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:03:24.16,0:03:26.10,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:03:24.16,0:03:26.10,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:24.16,0:03:26.10,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:03:24.16,0:03:26.10,Default,,0000,0000,0000,,Маруконы көрмедің бе?
Dialogue: 0,0:03:26.10,0:03:29.67,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:26.10,0:03:29.67,Default,,0000,0000,0000,,Не? Егер бұл Маруко болса
Dialogue: 0,0:03:26.10,0:03:29.67,Rubi,,0000,0000,0000,,Тауық
Dialogue: 0,0:03:26.10,0:03:29.67,Default,,0000,0000,0000,,Дәл осы уақытқа дейін
Dialogue: 0,0:03:29.67,0:03:32.17,Rubi,,0000,0000,0000,,Ән
Dialogue: 0,0:03:29.67,0:03:32.17,Rubi,,0000,0000,0000,,Одо
Dialogue: 0,0:03:29.67,0:03:32.17,Default,,0000,0000,0000,,Мен ән айтып, би биледім.
Dialogue: 0,0:03:32.17,0:03:34.67,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:03:32.17,0:03:34.67,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:03:32.17,0:03:34.67,Default,,0000,0000,0000,,(Жапон айқайы)
Dialogue: 0,0:03:34.67,0:03:36.61,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:34.67,0:03:36.61,Rubi,,0000,0000,0000,,Нейки
Dialogue: 0,0:03:34.67,0:03:36.61,Default,,0000,0000,0000,,(Маруконың ұйқысы)
Dialogue: 0,0:03:36.61,0:03:38.18,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:36.61,0:03:38.18,Default,,0000,0000,0000,,Маруко!
Dialogue: 0,0:03:38.18,0:03:41.18,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:03:38.18,0:03:41.18,Default,,0000,0000,0000,,Осындай жерде
Dialogue: 0,0:03:38.18,0:03:41.18,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:03:38.18,0:03:41.18,Default,,0000,0000,0000,,Мен ұйықтамаймын!
Dialogue: 0,0:03:42.05,0:03:44.05,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:42.05,0:03:44.05,Default,,0000,0000,0000,,Мм... Анашым...
Dialogue: 0,0:03:44.05,0:03:48.69,Rubi,,0000,0000,0000,,Кимо
Dialogue: 0,0:03:44.05,0:03:48.69,Default,,0000,0000,0000,,Аа, бұл жақсы сезінеді
Dialogue: 0,0:03:44.05,0:03:48.69,Rubi,,0000,0000,0000,,Нему
Dialogue: 0,0:03:44.05,0:03:48.69,Default,,0000,0000,0000,,Мен қайтадан ұйықтай бастадым.
Dialogue: 0,0:03:48.69,0:03:50.62,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:03:48.69,0:03:50.62,Default,,0000,0000,0000,,Сәлем! ояну
Dialogue: 0,0:03:50.62,0:03:53.56,Rubi,,0000,0000,0000,,Харуясу
Dialogue: 0,0:03:50.62,0:03:53.56,Default,,0000,0000,0000,,Көктемгі демалысқа шыққанда
Dialogue: 0,0:03:50.62,0:03:53.56,Rubi,,0000,0000,0000,,Күн сайын
Dialogue: 0,0:03:50.62,0:03:53.56,Rubi,,0000,0000,0000,,Күн сайын
Dialogue: 0,0:03:50.62,0:03:53.56,Default,,0000,0000,0000,,Күн сайын Гутара Гутара
Dialogue: 0,0:03:53.56,0:03:57.06,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:03:53.56,0:03:57.06,Rubi,,0000,0000,0000,,Асо
Dialogue: 0,0:03:53.56,0:03:57.06,Rubi,,0000,0000,0000,,Ән
Dialogue: 0,0:03:53.56,0:03:57.06,Default,,0000,0000,0000,,Ойна, ән айт, тамақ іш
Dialogue: 0,0:03:53.56,0:03:57.06,Rubi,,0000,0000,0000,,Нему
Dialogue: 0,0:03:53.56,0:03:57.06,Default,,0000,0000,0000,,Ол үнемі ұйықтап жатыр!
Dialogue: 0,0:03:58.20,0:04:00.13,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:03:58.20,0:04:00.13,Default,,0000,0000,0000,,Бұл жақсы, шынымен емес...
Dialogue: 0,0:04:00.13,0:04:03.07,Rubi,,0000,0000,0000,,Охара Шосуке
Dialogue: 0,0:04:00.13,0:04:03.07,Default,,0000,0000,0000,,<Шосуке Охара сияқты
Dialogue: 0,0:04:00.13,0:04:03.07,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:00.13,0:04:03.07,Default,,0000,0000,0000,,Бала болу＞
Dialogue: 0,0:04:03.07,0:04:06.07,Default,,0000,0000,0000,,Бұл жақсы болуы мүмкін емес!
Dialogue: 0,0:04:06.07,0:04:09.21,Rubi,,0000,0000,0000,,Юкоу
Dialogue: 0,0:04:06.07,0:04:09.21,Default,,0000,0000,0000,,тиімдірек
Dialogue: 0,0:04:06.07,0:04:09.21,Rubi,,0000,0000,0000,,Рио
Dialogue: 0,0:04:06.07,0:04:09.21,Rubi,,0000,0000,0000,,Жеңіл
Dialogue: 0,0:04:06.07,0:04:09.21,Default,,0000,0000,0000,,Мерекелерді тиімді пайдаланыңыз
Dialogue: 0,0:04:09.21,0:04:11.14,Rubi,,0000,0000,0000,,Ақша
Dialogue: 0,0:04:09.21,0:04:11.14,Default,,0000,0000,0000,,Ал, маған ақшаны бер.
Dialogue: 0,0:04:11.14,0:04:12.71,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:11.14,0:04:12.71,Rubi,,0000,0000,0000,,Ақша
Dialogue: 0,0:04:11.14,0:04:12.71,Rubi,,0000,0000,0000,,Құрметті.
Dialogue: 0,0:04:11.14,0:04:12.71,Default,,0000,0000,0000,,Ақша? Кітап сатып алғыңыз келе ме?
Dialogue: 0,0:04:12.71,0:04:14.65,Rubi,,0000,0000,0000,,Емен
Dialogue: 0,0:04:12.71,0:04:14.65,Default,,0000,0000,0000,,Тәттілер жоқ
Dialogue: 0,0:04:14.65,0:04:18.22,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:14.65,0:04:18.22,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:04:14.65,0:04:18.22,Default,,0000,0000,0000,,Анаң не дейді
Dialogue: 0,0:04:14.65,0:04:18.22,Default,,0000,0000,0000,,Сіз түсінбейсіз!
Dialogue: 0,0:04:18.22,0:04:20.15,Rubi,,0000,0000,0000,,НАСА
Dialogue: 0,0:04:18.22,0:04:20.15,Default,,0000,0000,0000,,Бұл аянышты, мен...
Dialogue: 0,0:04:20.15,0:04:22.15,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:04:25.02,0:04:27.66,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:04:25.02,0:04:27.66,Default,,0000,0000,0000,,Сәлем анашым
Dialogue: 0,0:04:25.02,0:04:27.66,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:04:25.02,0:04:27.66,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:04:27.66,0:04:29.59,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:04:27.66,0:04:29.59,Rubi,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:04:27.66,0:04:29.59,Default,,0000,0000,0000,,Мені бір жерге апарыңыз!
Dialogue: 0,0:04:29.59,0:04:31.53,Rubi,,0000,0000,0000,,Изога
Dialogue: 0,0:04:29.59,0:04:31.53,Default,,0000,0000,0000,,Барлығы бос емес.
Dialogue: 0,0:04:31.53,0:04:35.17,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:04:31.53,0:04:35.17,Default,,0000,0000,0000,,Жарайды, шамамен бір күн.
Dialogue: 0,0:04:31.53,0:04:35.17,Rubi,,0000,0000,0000,,Юэнчи
Dialogue: 0,0:04:31.53,0:04:35.17,Default,,0000,0000,0000,,Ойын-сауық саябағы немесе әмбебап дүкен
Dialogue: 0,0:04:35.17,0:04:38.67,Rubi,,0000,0000,0000,,Канджи
Dialogue: 0,0:04:35.17,0:04:38.67,Rubi,,0000,0000,0000,,Тренинг
Dialogue: 0,0:04:35.17,0:04:38.67,Default,,0000,0000,0000,,Жоқ! Кандзиді жаттықтырыңыз.
Dialogue: 0,0:04:38.67,0:04:41.17,Default,,0000,0000,0000,,Фу-да
Dialogue: 0,0:04:38.67,0:04:41.17,Default,,0000,0000,0000,,Ол соншалықты керемет пианист болса да—
Dialogue: 0,0:04:41.17,0:04:44.68,Rubi,,0000,0000,0000,,Ән
Dialogue: 0,0:04:41.17,0:04:44.68,Rubi,,0000,0000,0000,,Одо
Dialogue: 0,0:04:41.17,0:04:44.68,Rubi,,0000,0000,0000,,Асо
Dialogue: 0,0:04:41.17,0:04:44.68,Default,,0000,0000,0000,,Сіз ән айтасыз, билейсіз бе, ойнайсыз ба?
Dialogue: 0,0:04:41.17,0:04:44.68,Rubi,,0000,0000,0000,,Нему
Dialogue: 0,0:04:41.17,0:04:44.68,Default,,0000,0000,0000,,Менің ұйықтаудан басқа амалым жоқ.
Dialogue: 0,0:04:44.68,0:04:48.55,Rubi,,0000,0000,0000,,Ән
Dialogue: 0,0:04:44.68,0:04:48.55,Default,,0000,0000,0000,,Мен ән айтайын деп жатырмын
Dialogue: 0,0:04:44.68,0:04:48.55,Rubi,,0000,0000,0000,,Одо
Dialogue: 0,0:04:44.68,0:04:48.55,Default,,0000,0000,0000,,Мен билеймін.
Dialogue: 0,0:04:48.55,0:04:54.19,Rubi,,0000,0000,0000,,Әйел
Dialogue: 0,0:04:48.55,0:04:54.19,Rubi,,0000,0000,0000,,Кисецу
Dialogue: 0,0:04:48.55,0:04:54.19,Rubi,,0000,0000,0000,,Хару
Dialogue: 0,0:04:48.55,0:04:54.19,Default,,0000,0000,0000,,…
Dialogue: 0,0:04:54.19,0:04:56.69,Default,,0000,0000,0000,,Бұл күлкілі...
Dialogue: 0,0:04:57.69,0:04:59.19,Default,,0000,0000,0000,,Сәлем әже
Dialogue: 0,0:04:57.69,0:04:59.19,Default,,0000,0000,0000,,Осыны орындайық
Dialogue: 0,0:04:59.19,0:05:01.69,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:04:59.19,0:05:01.69,Default,,0000,0000,0000,,Иә? Бұл не?
Dialogue: 0,0:05:01.69,0:05:04.60,Default,,0000,0000,0000,,Иә? Осегучи
Dialogue: 0,0:05:04.60,0:05:08.20,Default,,0000,0000,0000,,Бұл биік жағалы, солай емес пе?
Dialogue: 0,0:05:04.60,0:05:08.20,Default,,0000,0000,0000,,Сонымен, сіз не істейсіз?
Dialogue: 0,0:05:08.20,0:05:09.70,Default,,0000,0000,0000,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,0:05:09.70,0:05:12.60,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:09.70,0:05:12.60,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:05:09.70,0:05:12.60,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:05:09.70,0:05:12.60,Default,,0000,0000,0000,,Ой, мына бала өте жылдам.
Dialogue: 0,0:05:12.60,0:05:18.21,Rubi,,0000,0000,0000,,Жалаңаш
Dialogue: 0,0:05:12.60,0:05:18.21,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:05:12.60,0:05:18.21,Rubi,,0000,0000,0000,,Харуясу
Dialogue: 0,0:05:12.60,0:05:18.21,Default,,0000,0000,0000,,Хаа... жарқыраған көктемгі демалыс сияқты
Dialogue: 0,0:05:12.60,0:05:18.21,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:05:12.60,0:05:18.21,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:05:12.60,0:05:18.21,Default,,0000,0000,0000,,Уақытыңызды өткізудің қандай да бір жолы бар ма?
Dialogue: 0,0:05:18.21,0:05:20.71,Rubi,,0000,0000,0000,,Хиторитаби
Dialogue: 0,0:05:18.21,0:05:20.71,Default,,0000,0000,0000,,Жалғыз саяхаттау...
Dialogue: 0,0:05:20.71,0:05:23.62,Rubi,,0000,0000,0000,,Шизуока
Dialogue: 0,0:05:20.71,0:05:23.62,Default,,0000,0000,0000,,Иә! Шизуоканыкі
Dialogue: 0,0:05:20.71,0:05:23.62,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:20.71,0:05:23.62,Default,,0000,0000,0000,,Әженің үйіне барайық!
Dialogue: 0,0:05:23.62,0:05:25.55,Rubi,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:05:23.62,0:05:25.55,Default,,0000,0000,0000,,Бұл да жалғыз
Dialogue: 0,0:05:25.55,0:05:28.15,Rubi,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:05:25.55,0:05:28.15,Rubi,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:05:25.55,0:05:28.15,Rubi,,0000,0000,0000,,Қала
Dialogue: 0,0:05:25.55,0:05:28.15,Default,,0000,0000,0000,,Алыстағы қалада жалғыз
Dialogue: 0,0:05:25.55,0:05:28.15,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:25.55,0:05:28.15,Default,,0000,0000,0000,,Мен барамын
Dialogue: 0,0:05:28.15,0:05:29.65,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:05:28.15,0:05:29.65,Default,,0000,0000,0000,,Бұл үшін мені мақтайды.
Dialogue: 0,0:05:29.65,0:05:32.56,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:29.65,0:05:32.56,Default,,0000,0000,0000,,《Е, Маруко
Dialogue: 0,0:05:29.65,0:05:32.56,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:05:29.65,0:05:32.56,Default,,0000,0000,0000,,Бұл тамаша~》
Dialogue: 0,0:05:32.56,0:05:36.06,Rubi,,0000,0000,0000,,Кенже
