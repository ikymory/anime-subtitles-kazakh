Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:00.93,0:01:11.43,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:35.95,0:03:38.86,Rubi,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:03:35.95,0:03:38.86,Rubi,,0000,0000,0000,,Жел
Dialogue: 0,0:03:35.95,0:03:38.86,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:03:35.95,0:03:38.86,Default,,0000,0000,0000,,(Соққан желдің дыбысы)
Dialogue: 0,0:03:38.86,0:03:43.46,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:38.86,0:03:43.46,Rubi,,0000,0000,0000,,Саму
Dialogue: 0,0:03:38.86,0:03:43.46,Rubi,,0000,0000,0000,,Саму
Dialogue: 0,0:03:38.86,0:03:43.46,Default,,0000,0000,0000,,Уф, суық, суық.
Dialogue: 0,0:03:43.46,0:03:45.40,Default,,0000,0000,0000,,А, мен үйдемін. ау.
Dialogue: 0,0:03:45.40,0:03:47.33,Default,,0000,0000,0000,,Қайтадан қош келдіңіз
Dialogue: 0,0:03:45.40,0:03:47.33,Rubi,,0000,0000,0000,,Саму
Dialogue: 0,0:03:45.40,0:03:47.33,Default,,0000,0000,0000,,Суық болды емес пе?
Dialogue: 0,0:03:47.33,0:03:51.27,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:47.33,0:03:51.27,Default,,0000,0000,0000,,Сәлем анашым
Dialogue: 0,0:03:47.33,0:03:51.27,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:03:47.33,0:03:51.27,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:03:47.33,0:03:51.27,Default,,0000,0000,0000,,Маған жылы нәрсе беріңіз.
Dialogue: 0,0:03:51.27,0:03:54.41,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:03:51.27,0:03:54.41,Rubi,,0000,0000,0000,,Цуку
Dialogue: 0,0:03:51.27,0:03:54.41,Default,,0000,0000,0000,,Мен саған какао пісіремін.
Dialogue: 0,0:03:54.41,0:03:55.91,Default,,0000,0000,0000,,Мектеп сөмкесі
Dialogue: 0,0:03:54.41,0:03:55.91,Rubi,,0000,0000,0000,,Бөлме
Dialogue: 0,0:03:54.41,0:03:55.91,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:03:54.41,0:03:55.91,Default,,0000,0000,0000,,Бөлмеңізде қалдырыңыз.
Dialogue: 0,0:03:55.91,0:03:57.84,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:03:57.84,0:03:59.84,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:03:57.84,0:03:59.84,Default,,0000,0000,0000,,Оны қыздырыңыз
Dialogue: 0,0:03:57.84,0:03:59.84,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:04:02.78,0:04:04.28,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:04:02.78,0:04:04.28,Default,,0000,0000,0000,,Күткеніңізге рахмет
Dialogue: 0,0:04:02.78,0:04:04.28,Default,,0000,0000,0000,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:04:06.92,0:04:09.42,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:04:06.92,0:04:09.42,Default,,0000,0000,0000,,Күн ыстық, күйіп қалмаңыз
Dialogue: 0,0:04:06.92,0:04:09.42,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:04:06.92,0:04:09.42,Default,,0000,0000,0000,,Абайлаңыз
Dialogue: 0,0:04:09.42,0:04:11.42,Default,,0000,0000,0000,,Иә. Ха~
Dialogue: 0,0:04:14.29,0:04:15.29,Default,,0000,0000,0000,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:04:17.93,0:04:20.43,Default,,0000,0000,0000,,А, дәмді
Dialogue: 0,0:04:17.93,0:04:20.43,Default,,0000,0000,0000,,Какао дәмді.
Dialogue: 0,0:04:20.43,0:04:24.43,Rubi,,0000,0000,0000,,Қазір
Dialogue: 0,0:04:20.43,0:04:24.43,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:04:20.43,0:04:24.43,Default,,0000,0000,0000,,Қызық, кім ойлады?
Dialogue: 0,0:04:20.43,0:04:24.43,Default,,0000,0000,0000,,Бұл өте дәмді
Dialogue: 0,0:04:26.30,0:04:28.94,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:04:26.30,0:04:28.94,Rubi,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:04:26.30,0:04:28.94,Default,,0000,0000,0000,,Сіздің әпкеңіз де какао іше ме?
Dialogue: 0,0:04:28.94,0:04:31.84,Default,,0000,0000,0000,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,0:04:28.94,0:04:31.84,Rubi,,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:04:28.94,0:04:31.84,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:28.94,0:04:31.84,Default,,0000,0000,0000,,Эй, сен сол жаққа баруың керек.
Dialogue: 0,0:04:31.84,0:04:36.34,Default,,0000,0000,0000,,Ммм, мен мұны істей алмаймын.
Dialogue: 0,0:04:31.84,0:04:36.34,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:04:31.84,0:04:36.34,Default,,0000,0000,0000,,Сіз өте қызықсыз
Dialogue: 0,0:04:39.45,0:04:42.35,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:04:39.45,0:04:42.35,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:39.45,0:04:42.35,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:04:39.45,0:04:42.35,Default,,0000,0000,0000,,Маған аздап көрсетіңіз~
Dialogue: 0,0:04:42.35,0:04:45.96,Default,,0000,0000,0000,,Шулы.
Dialogue: 0,0:04:42.35,0:04:45.96,Rubi,,0000,0000,0000,,Ненгахо
Dialogue: 0,0:04:42.35,0:04:45.96,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:04:42.35,0:04:45.96,Default,,0000,0000,0000,,Сіз жаңа жылдық ашықхат жазып жатырсыз ба?
Dialogue: 0,0:04:45.96,0:04:47.46,Rubi,,0000,0000,0000,,Ненгахо
Dialogue: 0,0:04:45.96,0:04:47.46,Default,,0000,0000,0000,,Жаңа жылдық карта…
Dialogue: 0,0:04:47.46,0:04:50.90,Default,,0000,0000,0000,,Леви… бұл сенің кінәң.
Dialogue: 0,0:04:47.46,0:04:50.90,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:04:47.46,0:04:50.90,Default,,0000,0000,0000,,Оны шығару уақыты келді.
Dialogue: 0,0:04:50.90,0:04:52.40,Default,,0000,0000,0000,,Қайсысы...
Dialogue: 0,0:04:52.40,0:04:56.90,Default,,0000,0000,0000,,«Жаңа жыл құтты болсын
Dialogue: 0,0:04:52.40,0:04:56.90,Rubi,,0000,0000,0000,,Биыл
Dialogue: 0,0:04:52.40,0:04:56.90,Default,,0000,0000,0000,,Мен сені осы жылы тағы көремін деп үміттенемін».
Dialogue: 0,0:04:56.90,0:05:01.41,Default,,0000,0000,0000,,Хмм…
Dialogue: 0,0:04:56.90,0:05:01.41,Rubi,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:04:56.90,0:05:01.41,Rubi,,0000,0000,0000,,Зацу
Dialogue: 0,0:04:56.90,0:05:01.41,Default,,0000,0000,0000,,Бұл кәдімгі және суреттер ұқыпсыз.
Dialogue: 0,0:05:01.41,0:05:05.28,Rubi,,0000,0000,0000,,қою
Dialogue: 0,0:05:01.41,0:05:05.28,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:05:01.41,0:05:05.28,Default,,0000,0000,0000,,Жіберілген адамның жүрегінде
Dialogue: 0,0:05:01.41,0:05:05.28,Rubi,,0000,0000,0000,,Юта
Dialogue: 0,0:05:01.41,0:05:05.28,Default,,0000,0000,0000,,Джинді қызықтыратын ештеңе жоқ.
Dialogue: 0,0:05:05.28,0:05:07.28,Rubi,,0000,0000,0000,,Шицурей
Dialogue: 0,0:05:05.28,0:05:07.28,Default,,0000,0000,0000,,Ммм, кешіріңіз!
Dialogue: 0,0:05:07.28,0:05:10.92,Rubi,,0000,0000,0000,,Манга
Dialogue: 0,0:05:07.28,0:05:10.92,Default,,0000,0000,0000,,«Манга мектебі»
Dialogue: 0,0:05:07.28,0:05:10.92,Rubi,,0000,0000,0000,,Барыс
Dialogue: 0,0:05:07.28,0:05:10.92,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:07.28,0:05:10.92,Default,,0000,0000,0000,,Сын сияқты сөздерді айтпа.
Dialogue: 0,0:05:10.92,0:05:13.42,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:05:10.92,0:05:13.42,Rubi,,0000,0000,0000,,Go
Dialogue: 0,0:05:10.92,0:05:13.42,Rubi,,0000,0000,0000,,Сунао
Dialogue: 0,0:05:10.92,0:05:13.42,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:05:10.92,0:05:13.42,Default,,0000,0000,0000,,Адамдардың пікірін шынайы тыңдау.
Dialogue: 0,0:05:13.42,0:05:15.92,Default,,0000,0000,0000,,Сендер тым шулысыңдар.
Dialogue: 0,0:05:13.42,0:05:15.92,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:13.42,0:05:15.92,Default,,0000,0000,0000,,Кетіңіз.
Dialogue: 0,0:05:15.92,0:05:18.42,Default,,0000,0000,0000,,Енді, енді.
Dialogue: 0,0:05:18.42,0:05:21.93,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:18.42,0:05:21.93,Rubi,,0000,0000,0000,,Ненгахо
Dialogue: 0,0:05:18.42,0:05:21.93,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:05:18.42,0:05:21.93,Default,,0000,0000,0000,,Эй, Марукоға да жаңа жылдық ашықхат жіберші.
Dialogue: 0,0:05:18.42,0:05:21.93,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:21.93,0:05:25.43,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:05:21.93,0:05:25.43,Rubi,,0000,0000,0000,,Зімбір
Dialogue: 0,0:05:21.93,0:05:25.43,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:05:21.93,0:05:25.43,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:05:21.93,0:05:25.43,Default,,0000,0000,0000,,Жаңа жылдан бері мен сенің жүзіңді неге көрдім?
Dialogue: 0,0:05:21.93,0:05:25.43,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:05:21.93,0:05:25.43,Default,,0000,0000,0000,,Мен оны жұмсауым керек
Dialogue: 0,0:05:25.43,0:05:27.93,Default,,0000,0000,0000,,Сонымен қатар
Dialogue: 0,0:05:25.43,0:05:27.93,Rubi,,0000,0000,0000,,Джо
Dialogue: 0,0:05:25.43,0:05:27.93,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:05:25.43,0:05:27.93,Default,,0000,0000,0000,,Сіз тіпті құттықтау қағазын жібересіз бе?
Dialogue: 0,0:05:27.93,0:05:29.43,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:05:27.93,0:05:29.43,Default,,0000,0000,0000,,Қандай мақсатта?
Dialogue: 0,0:05:29.43,0:05:33.43,Rubi,,0000,0000,0000,,Орындалды
Dialogue: 0,0:05:29.43,0:05:33.43,Rubi,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:05:29.43,0:05:33.43,Rubi,,0000,0000,0000,,Рейги
Dialogue: 0,0:05:29.43,0:05:33.43,Default,,0000,0000,0000,,«Жақын достардың арасында да сыпайылық бар»
Dialogue: 0,0:05:29.43,0:05:33.43,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:29.43,0:05:33.43,Default,,0000,0000,0000,,Айтпайсың ба?
Dialogue: 0,0:05:34.31,0:05:35.94,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:05:35.94,0:05:37.88,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:05:35.94,0:05:37.88,Default,,0000,0000,0000,,(жұтатын дыбыс)
Dialogue: 0,0:05:37.88,0:05:41.45,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:37.88,0:05:41.45,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:05:37.88,0:05:41.45,Default,,0000,0000,0000,,А Маруко да жазады.
Dialogue: 0,0:05:37.88,0:05:41.45,Default,,0000,0000,0000,,Маған ашықхат беріңіз
Dialogue: 0,0:05:41.45,0:05:45.95,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:05:41.45,0:05:45.95,Rubi,,0000,0000,0000,,Тоқаш
Dialogue: 0,0:05:41.45,0:05:45.95,Default,,0000,0000,0000,,Жоқ, бұл менікі.
Dialogue: 0,0:05:41.45,0:05:45.95,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:41.45,0:05:45.95,Default,,0000,0000,0000,,Оны анаңа бер.
Dialogue: 0,0:05:45.95,0:05:49.45,Default,,0000,0000,0000,,А, мен түсіндім...
Dialogue: 0,0:05:45.95,0:05:49.45,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:45.95,0:05:49.45,Default,,0000,0000,0000,,Маруко да ашықхат алады.
Dialogue: 0,0:05:50.79,0:05:52.29,Default,,0000,0000,0000,,Әй... О, менің...
Dialogue: 0,0:05:53.76,0:05:56.90,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:53.76,0:05:56.90,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:05:53.76,0:05:56.90,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:05:53.76,0:05:56.90,Default,,0000,0000,0000,,Аздап~
Dialogue: 0,0:05:56.90,0:05:58.40,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:05:56.90,0:05:58.40,Default,,0000,0000,0000,,Эй, сен тағы да келдің бе?
Dialogue: 0,0:05:58.40,0:06:00.90,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:58.40,0:06:00.90,Default,,0000,0000,0000,,Сәлем, Маруко да.
Dialogue: 0,0:05:58.40,0:06:00.90,Rubi,,0000,0000,0000,,Кірпіш
Dialogue: 0,0:05:58.40,0:06:00.90,Default,,0000,0000,0000,,Маған жаңа жылдық ашықхат беріңіз
Dialogue: 0,0:06:00.90,0:06:02.83,Rubi,,0000,0000,0000,,Нанмай
Dialogue: 0,0:06:00.90,0:06:02.83,Default,,0000,0000,0000,,Неше бөлік бар?
Dialogue: 0,0:06:02.83,0:06:04.77,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:06:02.83,0:06:04.77,Default,,0000,0000,0000,,50 дана
Dialogue: 0,0:06:04.77,0:06:06.77,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:06:04.77,0:06:06.77,Default,,0000,0000,0000,,Неліктен адамдар көп?
Dialogue: 0,0:06:06.77,0:06:09.91,Default,,0000,0000,0000,,Тіпті мен үшін
Dialogue: 0,0:06:06.77,0:06:09.91,Rubi,,0000,0000,0000,,Гири
Dialogue: 0,0:06:06.77,0:06:09.91,Default,,0000,0000,0000,,Әртүрлі міндеттер бар, солай ма?
Dialogue: 0,0:06:09.91,0:06:12.41,Default,,0000,0000,0000,,Ақымақ нәрсе
Dialogue: 0,0:06:09.91,0:06:12.41,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:06:09.91,0:06:12.41,Default,,0000,0000,0000,,Мен мұны айтып тұрған жоқпын.
Dialogue: 0,0:06:12.41,0:06:16.92,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:06:12.41,0:06:16.92,Default,,0000,0000,0000,,Иә. Сізде шамамен 25 бөлік бар.
Dialogue: 0,0:06:12.41,0:06:16.92,Default,,0000,0000,0000,,Мен оны сізге бере алмаймын.
Dialogue: 0,0:06:16.92,0:06:18.85,Default,,0000,0000,0000,,Е!
Dialogue: 0,0:06:18.85,0:06:23.42,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:06:18.85,0:06:23.42,Default,,0000,0000,0000,,Хмм, тек 25 дана ма?
Dialogue: 0,0:06:18.85,0:06:23.42,Rubi,,0000,0000,0000,,Жоғарғы
Dialogue: 0,0:06:18.85,0:06:23.42,Default,,0000,0000,0000,,Мен қазір қиындыққа тап болдым.
Dialogue: 0,0:06:23.42,0:06:25.36,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:06:23.42,0:06:25.36,Rubi,,0000,0000,0000,,Шибу
Dialogue: 0,0:06:23.42,0:06:25.36,Default,,0000,0000,0000,,Анамның Шибучині!
Dialogue: 0,0:06:25.36,0:06:28.93,Rubi,,0000,0000,0000,,Кірпіш
Dialogue: 0,0:06:25.36,0:06:28.93,Default,,0000,0000,0000,,Егер солай болса, бұл жаңа жылдық ашықхат емес.
Dialogue: 0,0:06:25.36,0:06:28.93,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:06:25.36,0:06:28.93,Default,,0000,0000,0000,,Сіз оны жай ғана жіберуіңіз керек.
Dialogue: 0,0:06:28.93,0:06:32.80,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:06:28.93,0:06:32.80,Rubi,,0000,0000,0000,,Тошидама
Dialogue: 0,0:06:28.93,0:06:32.80,Default,,0000,0000,0000,,«Жаңа жылдық сыйлық» туралы мәлімет
Dialogue: 0,0:06:32.80,0:06:36.43,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:06:32.80,0:06:36.43,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:06:32.80,0:06:36.43,Rubi,,0000,0000,0000,,О
Dialogue: 0,0:06:32.80,0:06:36.43,Default,,0000,0000,0000,,Жыл басындағы үлкен бакучиде
Dialogue: 0,0:06:32.80,0:06:36.43,Default,,0000,0000,0000,,Себебі бұл қызықты~
Dialogue: 0,0:06:36.43,0:06:37.93,Rubi,,0000,0000,0000,,Бір рет
Dialogue: 0,0:06:36.43,0:06:37.93,Default,,0000,0000,0000,,Олай болса өз қалауыңызша жасаңыз.
Dialogue: 0,0:06:39.34,0:06:41.94,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:06:41.94,0:06:44.84,Default,,0000,0000,0000,,Ха~а мен көмектесе алмаймын.
Dialogue: 0,0:06:41.94,0:06:44.84,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:06:41.94,0:06:44.84,Rubi,,0000,0000,0000,,Тоқаш
Dialogue: 0,0:06:41.94,0:06:44.84,Default,,0000,0000,0000,,Не жетіспейді?
Dialogue: 0,0:06:44.84,0:06:48.34,Rubi,,0000,0000,0000,,Қалыпты
Dialogue: 0,0:06:44.84,0:06:48.34,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:06:44.84,0:06:48.34,Default,,0000,0000,0000,,Кәдімгі ашық хат немесе сурет қағазы
Dialogue: 0,0:06:44.84,0:06:48.34,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:06:44.84,0:06:48.34,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:06:44.84,0:06:48.34,Default,,0000,0000,0000,,Мен оны кесіп тастауым керек пе?
Dialogue: 0,0:06:49.75,0:06:53.38,Default,,0000,0000,0000,,Әзірше, ата
Dialogue: 0,0:06:49.75,0:06:53.38,Rubi,,0000,0000,0000,,Бұрыш
Dialogue: 0,0:06:49.75,0:06:53.38,Rubi,,0000,0000,0000,,Фуде
Dialogue: 0,0:06:49.75,0:06:53.38,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:06:49.75,0:06:53.38,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:06:49.75,0:06:53.38,Default,,0000,0000,0000,,Сия мен қылқаламды қарызға алып, жаз
Dialogue: 0,0:06:53.38,0:06:56.29,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:06:53.38,0:06:56.29,Rubi,,0000,0000,0000,,Ханаута
Dialogue: 0,0:06:53.38,0:06:56.29,Default,,0000,0000,0000,,()
Dialogue: 0,0:06:53.38,0:06:56.29,Default,,0000,0000,0000,,Ата
Dialogue: 0,0:06:56.29,0:06:58.26,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:06:56.29,0:06:58.26,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:06:56.29,0:06:58.26,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:06:56.29,0:06:58.26,Rubi,,0000,0000,0000,,«және күн сайын күрсінемін.»
Dialogue: 0,0:06:56.29,0:06:58.26,Default,,0000,0000,0000,,О, не? Саған не керек?
Dialogue: 0,0:06:58.26,0:07:01.89,Rubi,,0000,0000,0000,,Бұрыш
Dialogue: 0,0:06:58.26,0:07:01.89,Rubi,,0000,0000,0000,,Фуде
Dialogue: 0,0:06:58.26,0:07:01.89,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:06:58.26,0:07:01.89,Default,,0000,0000,0000,,Маған сия мен қылқаламды қарызға бер
Dialogue: 0,0:06:58.26,0:07:01.89,Rubi,,0000,0000,0000,,Шуджи
Dialogue: 0,0:06:58.26,0:07:01.89,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:06:58.26,0:07:01.89,Default,,0000,0000,0000,,Ой, бұл каллиграфиядан үй тапсырмасы ма?
Dialogue: 0,0:07:01.89,0:07:03.83,Default,,0000,0000,0000,,Міне, бұл туралы.
Dialogue: 0,0:07:03.83,0:07:06.76,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:03.83,0:07:06.76,Default,,0000,0000,0000,,Хой, міне Маруко
Dialogue: 0,0:07:06.76,0:07:09.77,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:07:06.76,0:07:09.77,Default,,0000,0000,0000,,Жарайды, мен оны қарызға аламын.
Dialogue: 0,0:07:09.77,0:07:12.90,Rubi,,0000,0000,0000,,Бокуджу
Dialogue: 0,0:07:09.77,0:07:12.90,Rubi,,0000,0000,0000,,Його
Dialogue: 0,0:07:09.77,0:07:12.90,Default,,0000,0000,0000,,Әй, оны сиямен боямаңыз
Dialogue: 0,0:07:09.77,0:07:12.90,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:07:09.77,0:07:12.90,Default,,0000,0000,0000,,Абайлаңыз
Dialogue: 0,0:07:12.90,0:07:15.40,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:07:12.90,0:07:15.40,Default,,0000,0000,0000,,Сізге үлкен рахмет~
Dialogue: 0,0:07:18.41,0:07:20.91,Rubi,,0000,0000,0000,,Фуде
Dialogue: 0,0:07:18.41,0:07:20.91,Rubi,,0000,0000,0000,,Кинчо
Dialogue: 0,0:07:18.41,0:07:20.91,Default,,0000,0000,0000,,Ақыр соңында, щеткамен тазалау мені қобалжытады~
Dialogue: 0,0:07:20.91,0:07:24.42,Rubi,,0000,0000,0000,,Шинкокюу
Dialogue: 0,0:07:20.91,0:07:24.42,Default,,0000,0000,0000,,бір айдан да аз уақыт ішінде жойылып кетеді…
Dialogue: 0,0:07:24.42,0:07:25.38,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:07:25.38,0:07:27.88,Default,,0000,0000,0000,,«Жаңа жылыңызбен»
Dialogue: 0,0:07:25.38,0:07:27.88,Default,,0000,0000,0000,,Кеттік
Dialogue: 0,0:07:29.92,0:07:31.42,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:07:31.42,0:07:33.36,Default,,0000,0000,0000,,Мен тамшылап жатырмын...
Dialogue: 0,0:07:33.36,0:07:38.93,Rubi,,0000,0000,0000,,Бұрыш
Dialogue: 0,0:07:33.36,0:07:38.93,Rubi,,0000,0000,0000,,Конджо
Dialogue: 0,0:07:33.36,0:07:38.93,Default,,0000,0000,0000,,Әй, жоқ, Суми... жігері жоқ.
Dialogue: 0,0:07:38.93,0:07:43.80,Default,,0000,0000,0000,,Жоқ, ілулі тұрған жері осы.
Dialogue: 0,0:07:38.93,0:07:43.80,Default,,0000,0000,0000,,Осылай алдау
Dialogue: 0,0:07:43.80,0:07:46.44,Default,,0000,0000,0000,,Бұл жерде осылай жасау керек.
Dialogue: 0,0:07:46.44,0:07:49.87,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:07:46.44,0:07:49.87,Default,,0000,0000,0000,,Хаха әйтеуір сәтті болды
Dialogue: 0,0:07:46.44,0:07:49.87,Default,,0000,0000,0000,,Бұл жұмыс істейтін сияқты...
Dialogue: 0,0:07:49.87,0:07:51.37,Default,,0000,0000,0000,,Дайын!
Dialogue: 0,0:07:54.75,0:07:58.88,Default,,0000,0000,0000,,Хахаха...｡ әйтеуір
Dialogue: 0,0:07:54.75,0:07:58.88,Default,,0000,0000,0000,,Жақсы өткеніне қуаныштымын.
Dialogue: 0,0:07:58.88,0:08:01.38,Default,,0000,0000,0000,,<Бұл жақсы емес.
Dialogue: 0,0:07:58.88,0:08:01.38,Default,,0000,0000,0000,,Сіз＞
Dialogue: 0,0:08:02.39,0:08:05.89,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:08:02.39,0:08:05.89,Default,,0000,0000,0000,,Бұл жолы
Dialogue: 0,0:08:02.39,0:08:05.89,Rubi,,0000,0000,0000,,Толық
Dialogue: 0,0:08:02.39,0:08:05.89,Default,,0000,0000,0000,,Сіз сәтсіздікке ұшырамағаныңызға көз жеткізуіңіз керек.
Dialogue: 0,0:08:05.89,0:08:07.83,Default,,0000,0000,0000,,«Жаңа жыл құтты болсын»
Dialogue: 0,0:08:07.83,0:08:10.40,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:08:07.83,0:08:10.40,Default,,0000,0000,0000,,Қоянның суретін салайық
Dialogue: 0,0:08:07.83,0:08:10.40,Default,,0000,0000,0000,,Хойхойтто
Dialogue: 0,0:08:10.40,0:08:12.33,Default,,0000,0000,0000,,Дайын!
Dialogue: 0,0:08:12.33,0:08:16.90,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:08:12.33,0:08:16.90,Default,,0000,0000,0000,,«Құттықтаймыз» болды…
Dialogue: 0,0:08:16.90,0:08:21.41,Default,,0000,0000,0000,,Ал, жоқ, мұны істейік.
Dialogue: 0,0:08:16.90,0:08:21.41,Default,,0000,0000,0000,,Хаха... хахаха...
Dialogue: 0,0:08:21.41,0:08:22.41,Default,,0000,0000,0000,,Дайын~
Dialogue: 0,0:08:23.34,0:08:24.91,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:08:24.91,0:08:27.41,Default,,0000,0000,0000,,Мен қайтадан тамшылап жатырмын...
Dialogue: 0,0:08:27.41,0:08:30.92,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес...
Dialogue: 0,0:08:27.41,0:08:30.92,Default,,0000,0000,0000,,Бұл да алдау...
Dialogue: 0,0:08:30.92,0:08:32.42,Default,,0000,0000,0000,,Дайын
Dialogue: 0,0:08:35.42,0:08:37.36,Default,,0000,0000,0000,,Сол сөзге шебер, жалған мейірімді жігіт➡
Dialogue: 0,0:08:37.36,0:08:41.93,Rubi,,0000,0000,0000,,Фуде
Dialogue: 0,0:08:37.36,0:08:41.93,Default,,0000,0000,0000,,Мен қылқаламмен жақсы жаза алмаймын.
Dialogue: 0,0:08:37.36,0:08:41.93,Rubi,,0000,0000,0000,,Тауық
Dialogue: 0,0:08:37.36,0:08:41.93,Default,,0000,0000,0000,,Біртүрлі болады.
