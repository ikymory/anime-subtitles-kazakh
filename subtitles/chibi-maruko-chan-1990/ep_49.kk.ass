Dialogue: 0,0:09:08.32,0:09:12.89,Rubi,,0000,0000,0000,,Ненгахо
Dialogue: 0,0:09:08.32,0:09:12.89,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:09:08.32,0:09:12.89,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:09:08.32,0:09:12.89,Default,,0000,0000,0000,,Қызықты жаңа жылдық ашықхаттарды қалай жазуға болады
Dialogue: 0,0:09:08.32,0:09:12.89,Rubi,,0000,0000,0000,,Оши
Dialogue: 0,0:09:08.32,0:09:12.89,Default,,0000,0000,0000,,Маған айтқаныңызды қалаймын.
Dialogue: 0,0:09:12.89,0:09:15.39,Rubi,,0000,0000,0000,,Ненгахо
Dialogue: 0,0:09:12.89,0:09:15.39,Default,,0000,0000,0000,,Мм, қызықты жаңа жылдық ашықхат?
Dialogue: 0,0:09:15.39,0:09:16.39,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:17.33,0:09:20.90,Default,,0000,0000,0000,,Аа~ ата да
Dialogue: 0,0:09:17.33,0:09:20.90,Rubi,,0000,0000,0000,,Ненгахо
Dialogue: 0,0:09:17.33,0:09:20.90,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:09:17.33,0:09:20.90,Default,,0000,0000,0000,,Мен жаңа жылдық ашықхат жазып отырдым.
Dialogue: 0,0:09:20.90,0:09:26.40,Rubi,,0000,0000,0000,,Білім
Dialogue: 0,0:09:20.90,0:09:26.40,Default,,0000,0000,0000,,Уау~ Сіз мұны өте жақсы білесіз!
Dialogue: 0,0:09:20.90,0:09:26.40,Default,,0000,0000,0000,,Жарайсың, ата!
Dialogue: 0,0:09:26.40,0:09:29.40,Default,,0000,0000,0000,,Иә? Солай ма?
Dialogue: 0,0:09:31.28,0:09:35.41,Rubi,,0000,0000,0000,,Ненго
Dialogue: 0,0:09:31.28,0:09:35.41,Default,,0000,0000,0000,,Хмм? Бірақ биыл
Dialogue: 0,0:09:31.28,0:09:35.41,Rubi,,0000,0000,0000,,Биыл
Dialogue: 0,0:09:31.28,0:09:35.41,Default,,0000,0000,0000,,Биылғы
Dialogue: 0,0:09:35.41,0:09:38.91,Rubi,,0000,0000,0000,,Зығыр мата
Dialogue: 0,0:09:35.41,0:09:38.91,Rubi,,0000,0000,0000,,Шоу
Dialogue: 0,0:09:35.41,0:09:38.91,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:09:35.41,0:09:38.91,Default,,0000,0000,0000,,Келесі жыл 1975 жыл.
Dialogue: 0,0:09:39.92,0:09:41.92,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:09:39.92,0:09:41.92,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:09:44.42,0:09:48.93,Default,,0000,0000,0000,,Аа, дұрыс...
Dialogue: 0,0:09:44.42,0:09:48.93,Rubi,,0000,0000,0000,,НАСА
Dialogue: 0,0:09:44.42,0:09:48.93,Default,,0000,0000,0000,,Мен өзімді аянышты сезінемін...
Dialogue: 0,0:09:48.93,0:09:51.36,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:09:48.93,0:09:51.36,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:09:48.93,0:09:51.36,Default,,0000,0000,0000,,Иә, түңілудің қажеті жоқ.
Dialogue: 0,0:09:51.36,0:09:54.27,Rubi,,0000,0000,0000,,Ненгахо
Dialogue: 0,0:09:51.36,0:09:54.27,Default,,0000,0000,0000,,Қызықты жаңа жылдық карталар
Dialogue: 0,0:09:51.36,0:09:54.27,Default,,0000,0000,0000,,Идеяларыңыз жоқ па?
Dialogue: 0,0:09:54.27,0:09:57.87,Default,,0000,0000,0000,,Бар
Dialogue: 0,0:09:54.27,0:09:57.87,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:09:54.27,0:09:57.87,Default,,0000,0000,0000,,Олай болса, «Абуридаши» жақсырақ.
Dialogue: 0,0:09:57.87,0:10:01.37,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:09:57.87,0:10:01.37,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:57.87,0:10:01.37,Rubi,,0000,0000,0000,,Майдың қысымы
Dialogue: 0,0:09:57.87,0:10:01.37,Default,,0000,0000,0000,,Қуыру? Бұл не? Қуырылған тофу?
Dialogue: 0,0:10:01.37,0:10:05.24,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:10:01.37,0:10:05.24,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:10:01.37,0:10:05.24,Rubi,,0000,0000,0000,,Белгі
Dialogue: 0,0:10:01.37,0:10:05.24,Default,,0000,0000,0000,,Жоқ, жоқ, алма мен мандарин шырынымен
Dialogue: 0,0:10:01.37,0:10:05.24,Rubi,,0000,0000,0000,,Джи
Dialogue: 0,0:10:01.37,0:10:05.24,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:10:01.37,0:10:05.24,Default,,0000,0000,0000,,Әріптерді жаз
Dialogue: 0,0:10:05.24,0:10:08.25,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:10:05.24,0:10:08.25,Default,,0000,0000,0000,,Отпен қуырғанда
Dialogue: 0,0:10:05.24,0:10:08.25,Rubi,,0000,0000,0000,,Джи
Dialogue: 0,0:10:05.24,0:10:08.25,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:10:05.24,0:10:08.25,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:10:05.24,0:10:08.25,Default,,0000,0000,0000,,Әріптерді ерекше етіп көрсететін
Dialogue: 0,0:10:08.25,0:10:13.38,Default,,0000,0000,0000,,Ху~ Жарайды, жасайық.
Dialogue: 0,0:10:08.25,0:10:13.38,Default,,0000,0000,0000,,Бұл қуырғыш
Dialogue: 0,0:10:13.38,0:10:16.29,Default,,0000,0000,0000,,Ата деген не?
Dialogue: 0,0:10:13.38,0:10:16.29,Default,,0000,0000,0000,,Өте жылы!
Dialogue: 0,0:10:16.29,0:10:20.26,Default,,0000,0000,0000,,Ия, эй, эй!
Dialogue: 0,0:10:20.26,0:10:22.89,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:10:20.26,0:10:22.89,Default,,0000,0000,0000,,Ана
Dialogue: 0,0:10:22.89,0:10:24.40,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:10:22.89,0:10:24.40,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:10:22.89,0:10:24.40,Rubi,,0000,0000,0000,,«және күн сайын күрсінемін.»
Dialogue: 0,0:10:22.89,0:10:24.40,Default,,0000,0000,0000,,Бұл уақыт не үшін қажет?
Dialogue: 0,0:10:24.40,0:10:27.30,Default,,0000,0000,0000,,Алма мен апельсин
Dialogue: 0,0:10:24.40,0:10:27.30,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:10:24.40,0:10:27.30,Default,,0000,0000,0000,,О, қуырылған ба?
Dialogue: 0,0:10:27.30,0:10:31.27,Default,,0000,0000,0000,,О, керемет
Dialogue: 0,0:10:27.30,0:10:31.27,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:10:27.30,0:10:31.27,Rubi,,0000,0000,0000,,Юмэй
Dialogue: 0,0:10:27.30,0:10:31.27,Default,,0000,0000,0000,,Абуридаши атақты, солай емес пе?
Dialogue: 0,0:10:31.27,0:10:36.91,Rubi,,0000,0000,0000,,Юмэй
Dialogue: 0,0:10:31.27,0:10:36.91,Default,,0000,0000,0000,,Не? А... «атақты»
Dialogue: 0,0:10:31.27,0:10:36.91,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:10:31.27,0:10:36.91,Rubi,,0000,0000,0000,,Жағдайда
Dialogue: 0,0:10:31.27,0:10:36.91,Default,,0000,0000,0000,,Бұл жағдайда...
Dialogue: 0,0:10:36.91,0:10:44.78,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:10:36.91,0:10:44.78,Rubi,,0000,0000,0000,,Бу
Dialogue: 0,0:10:36.91,0:10:44.78,Default,,0000,0000,0000,,～
Dialogue: 0,0:10:36.91,0:10:44.78,Rubi,,0000,0000,0000,,Зімбір
Dialogue: 0,0:10:36.91,0:10:44.78,Default,,0000,0000,0000,,Екі доспен жаңа жыл
Dialogue: 0,0:10:44.78,0:10:46.92,Default,,0000,0000,0000,,Ата
Dialogue: 0,0:10:44.78,0:10:46.92,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:10:44.78,0:10:46.92,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:46.92,0:10:48.85,Default,,0000,0000,0000,,Хехе, түсіндім.
Dialogue: 0,0:10:48.85,0:10:51.76,Rubi,,0000,0000,0000,,Қалаймын
Dialogue: 0,0:10:48.85,0:10:51.76,Default,,0000,0000,0000,,О, мен де дайынмын.
Dialogue: 0,0:10:51.76,0:10:54.73,Default,,0000,0000,0000,,Сіз мұны үккіштен өткізесіз бе?
Dialogue: 0,0:10:51.76,0:10:54.73,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:10:54.73,0:10:58.36,Rubi,,0000,0000,0000,,Белгі
Dialogue: 0,0:10:54.73,0:10:58.36,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:10:54.73,0:10:58.36,Default,,0000,0000,0000,,Осының шырыны керек.
Dialogue: 0,0:10:54.73,0:10:58.36,Default,,0000,0000,0000,,Саса, маған алманы бер.
Dialogue: 0,0:10:58.36,0:11:01.86,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:10:58.36,0:11:01.86,Default,,0000,0000,0000,,Бір минут күтіңіз~
Dialogue: 0,0:10:58.36,0:11:01.86,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
