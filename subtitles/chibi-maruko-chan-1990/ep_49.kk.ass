Dialogue: 0,0:10:58.36,0:11:01.86,Default,,0000,0000,0000,,Маруко тістеп ал
Dialogue: 0,0:11:02.87,0:11:05.37,Default,,0000,0000,0000,,Оо хо хо хо хо
Dialogue: 0,0:11:05.37,0:11:06.34,Default,,0000,0000,0000,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:11:06.34,0:11:08.27,Default,,0000,0000,0000,,Жарайды, атам да тістейді.
Dialogue: 0,0:11:06.34,0:11:08.27,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:11:08.27,0:11:09.87,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:11:09.87,0:11:12.78,Default,,0000,0000,0000,,Хмм~ Ах~
Dialogue: 0,0:11:12.78,0:11:14.78,Default,,0000,0000,0000,,Ооо~
Dialogue: 0,0:11:15.75,0:11:20.25,Default,,0000,0000,0000,,Ммммммм~ Ах~
Dialogue: 0,0:11:21.39,0:11:25.89,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:11:21.39,0:11:25.89,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:11:21.39,0:11:25.89,Default,,0000,0000,0000,,･･･
Dialogue: 0,0:11:27.26,0:11:28.89,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:11:27.26,0:11:28.89,Default,,0000,0000,0000,,(Томозо)
Dialogue: 0,0:11:27.26,0:11:28.89,Rubi,,0000,0000,0000,,Тістеу
Dialogue: 0,0:11:27.26,0:11:28.89,Default,,0000,0000,0000,,О, тағы бір нәрсе...
Dialogue: 0,0:11:28.89,0:11:31.40,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:11:28.89,0:11:31.40,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:11:28.89,0:11:31.40,Default,,0000,0000,0000,,Мен оны тез үккіштен өткізуім керек.
Dialogue: 0,0:11:31.40,0:11:32.90,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:11:31.40,0:11:32.90,Default,,0000,0000,0000,,Аха, дұрыс.
Dialogue: 0,0:11:35.90,0:11:39.40,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:11:35.90,0:11:39.40,Default,,0000,0000,0000,,Жарайды, Маруко
Dialogue: 0,0:11:35.90,0:11:39.40,Rubi,,0000,0000,0000,,үшін
Dialogue: 0,0:11:35.90,0:11:39.40,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:11:35.90,0:11:39.40,Default,,0000,0000,0000,,Мандаринмен сурет салып көрейік.
Dialogue: 0,0:11:39.40,0:11:42.90,Default,,0000,0000,0000,,Мм, ата?
Dialogue: 0,0:11:39.40,0:11:42.90,Default,,0000,0000,0000,,Алмамен жасап көрейік~
Dialogue: 0,0:11:46.91,0:11:48.41,Default,,0000,0000,0000,,Ммм
Dialogue: 0,0:11:48.41,0:11:51.32,Default,,0000,0000,0000,,Күрсін, жақсы иіс шығады.
Dialogue: 0,0:11:51.32,0:11:55.29,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:11:51.32,0:11:55.29,Default,,0000,0000,0000,,Не болса да
Dialogue: 0,0:11:51.32,0:11:55.29,Rubi,,0000,0000,0000,,Каджу
Dialogue: 0,0:11:51.32,0:11:55.29,Default,,0000,0000,0000,,100% жеміс шырыны
Dialogue: 0,0:11:55.29,0:11:56.29,Default,,0000,0000,0000,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:11:56.29,0:11:58.42,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:56.29,0:11:58.42,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:11:56.29,0:11:58.42,Default,,0000,0000,0000,,Ата ненің суретін салады?
Dialogue: 0,0:11:58.42,0:12:01.33,Default,,0000,0000,0000,,Мен бе? Яғни
Dialogue: 0,0:12:01.33,0:12:03.29,Default,,0000,0000,0000,,･･
Dialogue: 0,0:12:03.29,0:12:07.43,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:12:03.29,0:12:07.43,Default,,0000,0000,0000,,Атамның Икезу~
Dialogue: 0,0:12:07.43,0:12:10.94,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:12:07.43,0:12:10.94,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:12:07.43,0:12:10.94,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:12:07.43,0:12:10.94,Default,,0000,0000,0000,,Маруко нені салуы керек?
Dialogue: 0,0:12:07.43,0:12:10.94,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:12:07.43,0:12:10.94,Default,,0000,0000,0000,,Дайкоку-сан!
Dialogue: 0,0:12:10.94,0:12:13.94,Default,,0000,0000,0000,,Хмм, мен мұны істей алмаймын.
Dialogue: 0,0:12:10.94,0:12:13.94,Default,,0000,0000,0000,,Эй...
Dialogue: 0,0:12:15.44,0:12:19.94,Rubi,,0000,0000,0000,,Ишия
Dialogue: 0,0:12:15.44,0:12:19.94,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:12:15.44,0:12:19.94,Default,,0000,0000,0000,,(Тас пісірілген картоп сатушы)
Dialogue: 0,0:12:15.44,0:12:19.94,Rubi,,0000,0000,0000,,Ишия
Dialogue: 0,0:12:15.44,0:12:19.94,Default,,0000,0000,0000,,～～ ～
Dialogue: 0,0:12:20.95,0:12:22.45,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:12:20.95,0:12:22.45,Default,,0000,0000,0000,,Мен оны сыза алдым!
Dialogue: 0,0:12:22.45,0:12:24.95,Default,,0000,0000,0000,,Ха, ата да~
Dialogue: 0,0:12:24.95,0:12:26.45,Default,,0000,0000,0000,,Хмм? Бірақ келіңіз ...
Dialogue: 0,0:12:26.45,0:12:29.35,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:12:26.45,0:12:29.35,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:12:26.45,0:12:29.35,Default,,0000,0000,0000,,Майсыз да бозарып көрінеді.
Dialogue: 0,0:12:29.35,0:12:32.32,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:12:29.35,0:12:32.32,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:12:29.35,0:12:32.32,Default,,0000,0000,0000,,Оған қарамаңыз
Dialogue: 0,0:12:32.32,0:12:35.46,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:12:32.32,0:12:35.46,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:12:32.32,0:12:35.46,Default,,0000,0000,0000,,Көрмегендей кейіп таныту
Dialogue: 0,0:12:32.32,0:12:35.46,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:12:32.32,0:12:35.46,Default,,0000,0000,0000,,Оны жалынға шығару
Dialogue: 0,0:12:35.46,0:12:37.96,Default,,0000,0000,0000,,Ей, бастайық.
Dialogue: 0,0:12:35.46,0:12:37.96,Rubi,,0000,0000,0000,,Дайдокоро
Dialogue: 0,0:12:35.46,0:12:37.96,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:12:35.46,0:12:37.96,Default,,0000,0000,0000,,Ас үйге барыңыз
Dialogue: 0,0:12:37.96,0:12:40.87,Default,,0000,0000,0000,,Қуырамыз ба?
Dialogue: 0,0:12:37.96,0:12:40.87,Default,,0000,0000,0000,,Уау, бұл қызық.
Dialogue: 0,0:12:40.87,0:12:42.37,Default,,0000,0000,0000,,Иә. Уфуфу
Dialogue: 0,0:12:43.84,0:12:45.84,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:12:43.84,0:12:45.84,Default,,0000,0000,0000,,...
Dialogue: 0,0:12:45.84,0:12:48.47,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:12:45.84,0:12:48.47,Default,,0000,0000,0000,,Анашым эй эй эй
Dialogue: 0,0:12:48.47,0:12:50.97,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:12:48.47,0:12:50.97,Default,,0000,0000,0000,,Мен тағы да осындамын.
Dialogue: 0,0:12:51.91,0:12:55.41,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:12:51.91,0:12:55.41,Default,,0000,0000,0000,,Анашым!
Dialogue: 0,0:12:51.91,0:12:55.41,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:12:55.41,0:12:58.32,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:12:55.41,0:12:58.32,Default,,0000,0000,0000,,Ана
Dialogue: 0,0:12:55.41,0:12:58.32,Default,,0000,0000,0000,,Ааа аа...
Dialogue: 0,0:12:58.32,0:13:01.92,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:12:58.32,0:13:01.92,Default,,0000,0000,0000,,Мама, мен оны пеште қуырайын.
Dialogue: 0,0:12:58.32,0:13:01.92,Default,,0000,0000,0000,,рұқсат етіңіз
Dialogue: 0,0:13:01.92,0:13:03.86,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:13:03.86,0:13:04.86,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:13:03.86,0:13:04.86,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:13:03.86,0:13:04.86,Default,,0000,0000,0000,,(дыбысты өшіру)
Dialogue: 0,0:13:06.42,0:13:09.33,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:13:06.42,0:13:09.33,Default,,0000,0000,0000,,Бірақ өрт
Dialogue: 0,0:13:06.42,0:13:09.33,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:13:06.42,0:13:09.33,Default,,0000,0000,0000,,Абайлаңыз
Dialogue: 0,0:13:09.33,0:13:10.33,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:13:09.33,0:13:10.33,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:13:09.33,0:13:10.33,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:13:11.30,0:13:12.80,Default,,0000,0000,0000,,Сен Риппелді қалағанша басқара алатындайша жаттығу жасауың керек—
Dialogue: 0,0:13:13.93,0:13:18.44,Default,,0000,0000,0000,,Әй, мен оны қуырсам ше?
Dialogue: 0,0:13:13.93,0:13:18.44,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:13:13.93,0:13:18.44,Default,,0000,0000,0000,,Шыға ма деп ойлаймын. Мен сондай қуаныштымын.
Dialogue: 0,0:13:18.44,0:13:19.94,Default,,0000,0000,0000,,Тоқтат. Жетті. Іздерме оны.
Dialogue: 0,0:13:19.94,0:13:23.44,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:13:19.94,0:13:23.44,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:13:19.94,0:13:23.44,Default,,0000,0000,0000,,<Осылай емес сияқты
Dialogue: 0,0:13:19.94,0:13:23.44,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:13:19.94,0:13:23.44,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:13:19.94,0:13:23.44,Default,,0000,0000,0000,,Ол шығады деп ойлаймын...＞
Dialogue: 0,0:13:23.44,0:13:24.94,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:13:23.44,0:13:24.94,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:13:23.44,0:13:24.94,Default,,0000,0000,0000,,(дыбысты қосу)
Dialogue: 0,0:13:24.94,0:13:26.44,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:13:24.94,0:13:26.44,Default,,0000,0000,0000,,Иә~
Dialogue: 0,0:13:26.44,0:13:27.95,Default,,0000,0000,0000,,Атадан, істе!
Dialogue: 0,0:13:26.44,0:13:27.95,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:13:27.95,0:13:30.95,Default,,0000,0000,0000,,Ах~ Бұл өте алдау
Dialogue: 0,0:13:27.95,0:13:30.95,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:13:27.95,0:13:30.95,Default,,0000,0000,0000,,Өзгеріс күштері!
Dialogue: 0,0:13:33.45,0:13:35.95,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:13:33.45,0:13:35.95,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:13:33.45,0:13:35.95,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:13:33.45,0:13:35.95,Default,,0000,0000,0000,,Ол әлсіз көріне бастады
Dialogue: 0,0:13:35.95,0:13:37.89,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:13:35.95,0:13:37.89,Default,,0000,0000,0000,,О...хехехе
Dialogue: 0,0:13:37.89,0:13:39.89,Rubi,,0000,0000,0000,,Кохан
Dialogue: 0,0:13:37.89,0:13:39.89,Rubi,,0000,0000,0000,,Жалғастыру
Dialogue: 0,0:13:37.89,0:13:39.89,Default,,0000,0000,0000,,<Екінші жартыжылдықтың жалғасы>
Dialogue: 0,0:13:40.83,0:13:43.83,Default,,0000,0000,0000,,...
Dialogue: 0,0:13:40.83,0:13:43.83,Default,,0000,0000,0000,,Удавуда дадах»
Dialogue: 0,0:15:52.46,0:15:53.96,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:15:52.46,0:15:53.96,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:15:53.96,0:15:58.46,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:15:53.96,0:15:58.46,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:15:53.96,0:15:58.46,Default,,0000,0000,0000,,Ой~ Шықты, шықты
Dialogue: 0,0:15:53.96,0:15:58.46,Default,,0000,0000,0000,,Бұл рас, бұл рас.
Dialogue: 0,0:15:58.46,0:16:01.97,Default,,0000,0000,0000,,Уау~ Ааа аа...
Dialogue: 0,0:15:58.46,0:16:01.97,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:15:58.46,0:16:01.97,Default,,0000,0000,0000,,О...
Dialogue: 0,0:16:01.97,0:16:05.84,Rubi,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:16:01.97,0:16:05.84,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:16:01.97,0:16:05.84,Rubi,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:16:01.97,0:16:05.84,Rubi,,0000,0000,0000,,Жұмбақ
Dialogue: 0,0:16:01.97,0:16:05.84,Default,,0000,0000,0000,,Суреттің көзге түсетіні біртүрлі емес пе?
Dialogue: 0,0:16:01.97,0:16:05.84,Default,,0000,0000,0000,,Тоқтат. Жетті. Іздерме оны.
Dialogue: 0,0:16:05.84,0:16:08.84,Default,,0000,0000,0000,,Жарайды, тағы біраз.
Dialogue: 0,0:16:05.84,0:16:08.84,Default,,0000,0000,0000,,Қуырамыз ба? Хаха
Dialogue: 0,0:16:08.84,0:16:12.48,Default,,0000,0000,0000,,«Окаме-сан»
Dialogue: 0,0:16:08.84,0:16:12.48,Rubi,,0000,0000,0000,,Түс
Dialogue: 0,0:16:08.84,0:16:12.48,Default,,0000,0000,0000,,Бұл жақсы түске ие болды~
Dialogue: 0,0:16:12.48,0:16:14.41,Default,,0000,0000,0000,,Хе... Иә?
Dialogue: 0,0:16:14.41,0:16:16.35,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:16:14.41,0:16:16.35,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:16:14.41,0:16:16.35,Rubi,,0000,0000,0000,,Шөп
Dialogue: 0,0:16:14.41,0:16:16.35,Default,,0000,0000,0000,,Бір нәрсенің күйген иісі бар.
Dialogue: 0,0:16:16.35,0:16:19.35,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:16:16.35,0:16:19.35,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:16:16.35,0:16:19.35,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:16:16.35,0:16:19.35,Default,,0000,0000,0000,,Өртеніп жатыр!
Dialogue: 0,0:16:19.35,0:16:21.49,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:16:19.35,0:16:21.49,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:16:21.49,0:16:22.99,Default,,0000,0000,0000,,Құнды заттың бәрін аламын!
Dialogue: 0,0:16:22.99,0:16:26.86,Rubi,,0000,0000,0000,,Руль
Dialogue: 0,0:16:22.99,0:16:26.86,Default,,0000,0000,0000,,Өрт шығып жатыр!
Dialogue: 0,0:16:22.99,0:16:26.86,Rubi,,0000,0000,0000,,Өте
Dialogue: 0,0:16:22.99,0:16:26.86,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:16:22.99,0:16:26.86,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:16:22.99,0:16:26.86,Default,,0000,0000,0000,,Бұл үлкен мәселе. Тез су алыңыз!
Dialogue: 0,0:16:26.86,0:16:29.49,Rubi,,0000,0000,0000,,Руль
Dialogue: 0,0:16:26.86,0:16:29.49,Rubi,,0000,0000,0000,,Руль
Dialogue: 0,0:16:26.86,0:16:29.49,Default,,0000,0000,0000,,Ха, бұл от, бұл от!
Dialogue: 0,0:16:26.86,0:16:29.49,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:16:26.86,0:16:29.49,Default,,0000,0000,0000,,Уау, ата! тез!
Dialogue: 0,0:16:29.49,0:16:32.40,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:16:29.49,0:16:32.40,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:16:29.49,0:16:32.40,Default,,0000,0000,0000,,Тезірек, су!
Dialogue: 0,0:16:29.49,0:16:32.40,Default,,0000,0000,0000,,Уау! Уау!
Dialogue: 0,0:16:32.40,0:16:34.37,Rubi,,0000,0000,0000,,Руль
Dialogue: 0,0:16:32.40,0:16:34.37,Default,,0000,0000,0000,,Өрт шығып жатыр! Ахх!
Dialogue: 0,0:16:32.40,0:16:34.37,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:16:32.40,0:16:34.37,Default,,0000,0000,0000,,Су~!
Dialogue: 0,0:16:34.37,0:16:36.37,Default,,0000,0000,0000,,Ата!
Dialogue: 0,0:16:36.37,0:16:39.50,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:16:36.37,0:16:39.50,Default,,0000,0000,0000,,Әй, не істеп жатырсың!
Dialogue: 0,0:16:36.37,0:16:39.50,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:16:36.37,0:16:39.50,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:16:36.37,0:16:39.50,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:39.50,0:16:42.00,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:16:39.50,0:16:42.00,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:16:39.50,0:16:42.00,Default,,0000,0000,0000,,(открыткалар жанып жатқан дыбыс)
Dialogue: 0,0:16:39.50,0:16:42.00,Default,,0000,0000,0000,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:16:46.94,0:16:49.85,Rubi,,0000,0000,0000,,Руль
Dialogue: 0,0:16:46.94,0:16:49.85,Default,,0000,0000,0000,,Өрт тұтанғалы тұр.
Dialogue: 0,0:16:46.94,0:16:49.85,Default,,0000,0000,0000,,Бұл болды!
Dialogue: 0,0:16:49.85,0:16:52.82,Default,,0000,0000,0000,,«Окаме-сан»
Dialogue: 0,0:16:49.85,0:16:52.82,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:16:49.85,0:16:52.82,Default,,0000,0000,0000,,Ол өртеніп кетті.
Dialogue: 0,0:16:52.82,0:16:55.45,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:16:52.82,0:16:55.45,Default,,0000,0000,0000,,Мокумоку, мен күйіп тұрмын
Dialogue: 0,0:16:55.45,0:16:59.45,Rubi,,0000,0000,0000,,Хачимоку
Dialogue: 0,0:16:55.45,0:16:59.45,Default,,0000,0000,0000,,Бұл нағыз «Окаме сегіз көз»
Dialogue: 0,0:16:55.45,0:16:59.45,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:04.46,0:17:05.96,Default,,0000,0000,0000,,Сәлем...
Dialogue: 0,0:17:05.96,0:17:08.47,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:17:05.96,0:17:08.47,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:17:05.96,0:17:08.47,Default,,0000,0000,0000,,Енді өрт болмайды!
Dialogue: 0,0:17:08.47,0:17:10.97,Rubi,,0000,0000,0000,,Хачимоку
Dialogue: 0,0:17:08.47,0:17:10.97,Default,,0000,0000,0000,,«Окаме сегіз көз» болса да?
Dialogue: 0,0:17:10.97,0:17:17.84,Rubi,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:17:10.97,0:17:17.84,Rubi,,0000,0000,0000,,Жел
Dialogue: 0,0:17:10.97,0:17:17.84,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:17:10.97,0:17:17.84,Default,,0000,0000,0000,,(Желдің дыбысы)
Dialogue: 0,0:17:10.97,0:17:17.84,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:17:10.97,0:17:17.84,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:17:10.97,0:17:17.84,Default,,0000,0000,0000,,･･･…
Dialogue: 0,0:17:17.84,0:17:22.98,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:17:17.84,0:17:22.98,Default,,0000,0000,0000,,А, бұл қызықсыз. Не?
Dialogue: 0,0:17:17.84,0:17:22.98,Default,,0000,0000,0000,,Сізде қызықты идеялар бар ма?
Dialogue: 0,0:17:22.98,0:17:25.48,Rubi,,0000,0000,0000,,Шигеки
Dialogue: 0,0:17:22.98,0:17:25.48,Rubi,,0000,0000,0000,,Түпнұсқа
Dialogue: 0,0:17:22.98,0:17:25.48,Rubi,,0000,0000,0000,,Әйел
Dialogue: 0,0:17:22.98,0:17:25.48,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:17:22.98,0:17:25.48,Default,,0000,0000,0000,,<Маруко, ынталандыруды іздеген әйел>
Dialogue: 0,0:17:26.48,0:17:29.39,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:17:26.48,0:17:29.39,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:17:26.48,0:17:29.39,Default,,0000,0000,0000,,Эй... Марукоя
Dialogue: 0,0:17:29.39,0:17:32.99,Default,,0000,0000,0000,,Картоп ше? Ал картоп ше?
Dialogue: 0,0:17:29.39,0:17:32.99,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:17:29.39,0:17:32.99,Default,,0000,0000,0000,,Мен жеймін, өтінемін.
Dialogue: 0,0:17:32.99,0:17:34.93,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:17:32.99,0:17:34.93,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:17:32.99,0:17:34.93,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:17:32.99,0:17:34.93,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ
Dialogue: 0,0:17:34.93,0:17:37.43,Rubi,,0000,0000,0000,,Жарылыс
Dialogue: 0,0:17:34.93,0:17:37.43,Default,,0000,0000,0000,,«Картоп нұсқасы ше?»
Dialogue: 0,0:17:34.93,0:17:37.43,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:17:38.50,0:17:42.37,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:17:38.50,0:17:42.37,Default,,0000,0000,0000,,Қарашы, анаңа айтпа
Dialogue: 0,0:17:38.50,0:17:42.37,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:17:38.50,0:17:42.37,Default,,0000,0000,0000,,Мен картоп әкелдім.
Dialogue: 0,0:17:42.37,0:17:43.87,Default,,0000,0000,0000,,Бұл рас!
Dialogue: 0,0:17:47.30,0:17:51.94,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:17:47.30,0:17:51.94,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:17:47.30,0:17:51.94,Default,,0000,0000,0000,,Ва-ку-ва-ку
Dialogue: 0,0:17:51.94,0:17:54.45,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:17:51.94,0:17:54.45,Rubi,,0000,0000,0000,,Ханбун
Dialogue: 0,0:17:51.94,0:17:54.45,Default,,0000,0000,0000,,Ия... иә, жартысы.
Dialogue: 0,0:17:54.45,0:17:57.35,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:17:54.45,0:17:57.35,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:17:54.45,0:17:57.35,Default,,0000,0000,0000,,Нені ою керек?
Dialogue: 0,0:17:54.45,0:17:57.35,Default,,0000,0000,0000,,А, мен түсіндім...
Dialogue: 0,0:17:57.35,0:18:04.46,Default,,0000,0000,0000,,Мм, мм... мм...
Dialogue: 0,0:17:57.35,0:18:04.46,Default,,0000,0000,0000,,Ата бұл...
Dialogue: 0,0:18:04.46,0:18:06.39,Rubi,,0000,0000,0000,,Денем өзгерді
Dialogue: 0,0:18:04.46,0:18:06.39,Default,,0000,0000,0000,,Зодиак белгілері!
Dialogue: 0,0:18:04.46,0:18:06.39,Default,,0000,0000,0000,,Уау ата
Dialogue: 0,0:18:06.39,0:18:08.96,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:18:06.39,0:18:08.96,Default,,0000,0000,0000,,Мен әзіл айттым! Сатеру!
Dialogue: 0,0:18:08.96,0:18:10.96,Default,,0000,0000,0000,,Тұр... мен қайдамын?
Dialogue: 0,0:18:08.96,0:18:10.96,Default,,0000,0000,0000,,Хэхе…
Dialogue: 0,0:18:13.83,0:18:16.47,Default,,0000,0000,0000,,Ишо
Dialogue: 0,0:18:13.83,0:18:16.47,Default,,0000,0000,0000,,Ол…
Dialogue: 0,0:18:16.47,0:18:18.40,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:18:16.47,0:18:18.40,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:18:16.47,0:18:18.40,Default,,0000,0000,0000,,Маруко да
Dialogue: 0,0:18:18.40,0:18:20.97,Default,,0000,0000,0000,,Жарайды, бастайық.
Dialogue: 0,0:18:18.40,0:18:20.97,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:18:18.40,0:18:20.97,Default,,0000,0000,0000,,Оны ашықхатқа басайық
Dialogue: 0,0:18:20.97,0:18:22.47,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:18:22.47,0:18:24.98,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:18:22.47,0:18:24.98,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:18:22.47,0:18:24.98,Default,,0000,0000,0000,,Қоянды ойып алдың ба?
Dialogue: 0,0:18:24.98,0:18:28.85,Rubi,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:18:24.98,0:18:28.85,Rubi,,0000,0000,0000,,Күрделі
Dialogue: 0,0:18:24.98,0:18:28.85,Default,,0000,0000,0000,,Жоқ, сурет салу қиын, сондықтан жақсы.
Dialogue: 0,0:18:24.98,0:18:28.85,Default,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:18:28.85,0:18:29.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:28.85,0:18:29.85,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:18:31.48,0:18:33.98,Default,,0000,0000,0000,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:18:31.48,0:18:33.98,Default,,0000,0000,0000,,Ата...
Dialogue: 0,0:18:33.98,0:18:36.48,Default,,0000,0000,0000,,Уф... бұл ақымақ болды...
Dialogue: 0,0:18:38.49,0:18:42.36,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:18:38.49,0:18:42.36,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:18:38.49,0:18:42.36,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:18:38.49,0:18:42.36,Default,,0000,0000,0000,,Жарайды, енді Марукоға қарайық.
Dialogue: 0,0:18:38.49,0:18:42.36,Default,,0000,0000,0000,,Аа, дұрыс, дұрыс.
Dialogue: 0,0:18:42.36,0:18:43.36,Default,,0000,0000,0000,,Титан шабуылына ұшыраған Трост ауданында,
Dialogue: 0,0:18:46.30,0:18:48.93,Default,,0000,0000,0000,,Бұл болды...
Dialogue: 0,0:18:48.93,0:18:51.84,Rubi,,0000,0000,0000,,Тауық
Dialogue: 0,0:18:48.93,0:18:51.84,Default,,0000,0000,0000,,Біртүрлі...
Dialogue: 0,0:18:48.93,0:18:51.84,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:18:48.93,0:18:51.84,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:18:51.84,0:18:53.80,Rubi,,0000,0000,0000,,Босдық
Dialogue: 0,0:18:51.84,0:18:53.80,Default,,0000,0000,0000,,Кагами мочи…
Dialogue: 0,0:18:53.80,0:18:58.94,Default,,0000,0000,0000,,Ах— Ах—
Dialogue: 0,0:18:53.80,0:18:58.94,Default,,0000,0000,0000,,Көрдім, бұл дәмді, бұл дәмді.
Dialogue: 0,0:18:58.94,0:19:00.88,Default,,0000,0000,0000,,Ах... хаха...
Dialogue: 0,0:18:58.94,0:19:00.88,Rubi,,0000,0000,0000,,Джодеки
Dialogue: 0,0:18:58.94,0:19:00.88,Default,,0000,0000,0000,,Жақсы жұмыс!
Dialogue: 0,0:19:00.88,0:19:03.81,Default,,0000,0000,0000,,<Ата
Dialogue: 0,0:19:00.88,0:19:03.81,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:19:00.88,0:19:03.81,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:19:00.88,0:19:03.81,Default,,0000,0000,0000,,Бұл не деп ойладың?＞
Dialogue: 0,0:19:03.81,0:19:06.82,Default,,0000,0000,0000,,О, бұл да «Отеян»
Dialogue: 0,0:19:03.81,0:19:06.82,Default,,0000,0000,0000,,Мен солай болады деп ойлаймын.
Dialogue: 0,0:19:06.82,0:19:10.45,Default,,0000,0000,0000,,«Өтеян»?
Dialogue: 0,0:19:06.82,0:19:10.45,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:19:06.82,0:19:10.45,Default,,0000,0000,0000,,Бұл не, тоқаш?
Dialogue: 0,0:19:10.45,0:19:14.33,Default,,0000,0000,0000,,Міне, осылай...
Dialogue: 0,0:19:14.33,0:19:16.83,Rubi,,0000,0000,0000,,Тауық
Dialogue: 0,0:19:14.33,0:19:16.83,Default,,0000,0000,0000,,Біртүрлі етпеңіз
Dialogue: 0,0:19:14.33,0:19:16.83,Default,,0000,0000,0000,,Жарайсың!
Dialogue: 0,0:19:19.96,0:19:21.96,Rubi,,0000,0000,0000,,Томозу
Dialogue: 0,0:19:19.96,0:19:21.96,Default,,0000,0000,0000,,Қараңыз, «Отеян».
Dialogue: 0,0:19:23.47,0:19:25.97,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:23.47,0:19:25.97,Rubi,,0000,0000,0000,,Джодеки
Dialogue: 0,0:19:23.47,0:19:25.97,Rubi,,0000,0000,0000,,Джодеки
Dialogue: 0,0:19:23.47,0:19:25.97,Default,,0000,0000,0000,,Иә, жақсы жұмыс, жақсы жұмыс.
Dialogue: 0,0:19:25.97,0:19:28.47,Default,,0000,0000,0000,,Яхахахаха
Dialogue: 0,0:19:25.97,0:19:28.47,Default,,0000,0000,0000,,Шизуку Каваками, Курона Анку, Наширо
Dialogue: 0,0:19:29.84,0:19:34.48,Default,,0000,0000,0000,,Ммм~ Атамдікі
Dialogue: 0,0:19:29.84,0:19:34.48,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:19:29.84,0:19:34.48,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:19:29.84,0:19:34.48,Default,,0000,0000,0000,,Менің айтқанымды тыңдасаң, жақсы естімейді.
Dialogue: 0,0:19:34.48,0:19:36.98,Rubi,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:19:34.48,0:19:36.98,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:19:34.48,0:19:36.98,Default,,0000,0000,0000,,Оны өзіңіз жазуыңыз керек
Dialogue: 0,0:19:36.98,0:19:38.92,Rubi,,0000,0000,0000,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:19:36.98,0:19:38.92,Rubi,,0000,0000,0000,,Жел
Dialogue: 0,0:19:36.98,0:19:38.92,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:19:36.98,0:19:38.92,Default,,0000,0000,0000,,(Желдің дыбысы)
Dialogue: 0,0:19:38.92,0:19:43.92,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:19:38.92,0:19:43.92,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:19:38.92,0:19:43.92,Default,,0000,0000,0000,,(күріш крекерін жеу дыбысы)
Dialogue: 0,0:19:45.79,0:19:50.93,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:19:45.79,0:19:50.93,Default,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:19:45.79,0:19:50.93,Rubi,,0000,0000,0000,,Ақаулық
Dialogue: 0,0:19:45.79,0:19:50.93,Default,,0000,0000,0000,,Шаршап барады.
Dialogue: 0,0:19:50.93,0:19:54.43,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:19:50.93,0:19:54.43,Rubi,,0000,0000,0000,,Ненгахо
Dialogue: 0,0:19:50.93,0:19:54.43,Default,,0000,0000,0000,,Жаңа жылдық карталар ше?
Dialogue: 0,0:19:50.93,0:19:54.43,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:19:50.93,0:19:54.43,Default,,0000,0000,0000,,Оны жазудың қажеті жоқ.
Dialogue: 0,0:19:54.43,0:19:57.94,Rubi,,0000,0000,0000,,Зімбір
Dialogue: 0,0:19:54.43,0:19:57.94,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:19:54.43,0:19:57.94,Default,,0000,0000,0000,,Жаңа жылдық құттықтауларымды ұмытып кете жаздадым.
Dialogue: 0,0:19:54.43,0:19:57.94,Rubi,,0000,0000,0000,,Око
Dialogue: 0,0:19:54.43,0:19:57.94,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:19:54.43,0:19:57.94,Default,,0000,0000,0000,,Кім ашуланады?
Dialogue: 0,0:19:57.94,0:19:59.44,Rubi,,0000,0000,0000,,Достар
Dialogue: 0,0:19:57.94,0:19:59.44,Default,,0000,0000,0000,,Біз дос емеспіз
Dialogue: 0,0:19:59.44,0:20:01.94,Default,,0000,0000,0000,,<О, иә, солай болса да>
Dialogue: 0,0:20:03.31,0:20:07.31,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:20:03.31,0:20:07.31,Default,,0000,0000,0000,,Маруко, сен тағы жалқаусың!
