Dialogue: 0,0:20:03.31,0:20:07.31,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:20:03.31,0:20:07.31,Default,,0000,0000,0000,,Жаңа жылдық ашықхат жаздыңыз ба?
Dialogue: 0,0:20:07.31,0:20:12.95,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:20:07.31,0:20:12.95,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:20:07.31,0:20:12.95,Rubi,,0000,0000,0000,,Исшокенмейканга
Dialogue: 0,0:20:07.31,0:20:12.95,Default,,0000,0000,0000,,Мен қазір қатты ойланып жүрмін.
Dialogue: 0,0:20:12.95,0:20:15.45,Default,,0000,0000,0000,,Осылайша
Dialogue: 0,0:20:12.95,0:20:15.45,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:20:12.95,0:20:15.45,Default,,0000,0000,0000,,Мен оны көре алмадым.
Dialogue: 0,0:20:15.45,0:20:18.96,Default,,0000,0000,0000,,Шынымен айтамын, рас.
Dialogue: 0,0:20:15.45,0:20:18.96,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:20:18.96,0:20:20.89,Default,,0000,0000,0000,,(5-сынып оқушысы 5) Сүтсіз. (4-сынып оқушысы 4) Жырт.
Dialogue: 0,0:20:18.96,0:20:20.89,Default,,0000,0000,0000,,Иә, онда.
Dialogue: 0,0:20:20.89,0:20:22.83,Rubi,,0000,0000,0000,,Ненгахо
Dialogue: 0,0:20:20.89,0:20:22.83,Default,,0000,0000,0000,,Сіздің жаңа жылдық картаңыз
Dialogue: 0,0:20:20.89,0:20:22.83,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:20:20.89,0:20:22.83,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:20:20.89,0:20:22.83,Default,,0000,0000,0000,,Сіз оны алып кетуге бара жатқанда.
Dialogue: 0,0:20:22.83,0:20:25.46,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:20:22.83,0:20:25.46,Rubi,,0000,0000,0000,,Ненгахо
Dialogue: 0,0:20:22.83,0:20:25.46,Default,,0000,0000,0000,,Сондай-ақ, анамның жаңа жылдық картасы.
Dialogue: 0,0:20:22.83,0:20:25.46,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:20:22.83,0:20:25.46,Default,,0000,0000,0000,,Оны шығарыңыз.
Dialogue: 0,0:20:25.46,0:20:27.96,Default,,0000,0000,0000,,Иә, жарайды.
Dialogue: 0,0:20:25.46,0:20:27.96,Rubi,,0000,0000,0000,,Қызыл
Dialogue: 0,0:20:25.46,0:20:27.96,Rubi,,0000,0000,0000,,Теса
Dialogue: 0,0:20:25.46,0:20:27.96,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:20:25.46,0:20:27.96,Default,,0000,0000,0000,,Оны қызыл сөмкеде сақтаңыз
Dialogue: 0,0:20:30.97,0:20:35.84,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:20:30.97,0:20:35.84,Default,,0000,0000,0000,,Ұмытпаңыз
Dialogue: 0,0:20:30.97,0:20:35.84,Default,,0000,0000,0000,,Иә, иә, түсіндім.
Dialogue: 0,0:20:35.84,0:20:38.84,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:20:35.84,0:20:38.84,Rubi,,0000,0000,0000,,Ненгахо
Dialogue: 0,0:20:35.84,0:20:38.84,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:20:35.84,0:20:38.84,Default,,0000,0000,0000,,Жаңа жылдық ашықхатыңызды тез жазыңыз!
Dialogue: 0,0:20:35.84,0:20:38.84,Default,,0000,0000,0000,,Хаа…
Dialogue: 0,0:20:40.48,0:20:44.92,Default,,0000,0000,0000,,Сіз мұны істесеңіз де
Dialogue: 0,0:20:40.48,0:20:44.92,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:20:40.48,0:20:44.92,Rubi,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:20:40.48,0:20:44.92,Rubi,,0000,0000,0000,,Кайтен
Dialogue: 0,0:20:40.48,0:20:44.92,Default,,0000,0000,0000,,Менің басым бар жылдамдықпен айналып жатса да
Dialogue: 0,0:20:44.92,0:20:46.85,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:20:44.92,0:20:46.85,Default,,0000,0000,0000,,(шайнаған күріш крекерінің дыбысы)
Dialogue: 0,0:20:46.85,0:20:51.35,Rubi,,0000,0000,0000,,Изога
Dialogue: 0,0:20:46.85,0:20:51.35,Rubi,,0000,0000,0000,,Пішін
Dialogue: 0,0:20:46.85,0:20:51.35,Default,,0000,0000,0000,,Қолым бос болса да, пішінін беремін
Dialogue: 0,0:20:46.85,0:20:51.35,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:20:46.85,0:20:51.35,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:20:46.85,0:20:51.35,Default,,0000,0000,0000,,Саған көрсете алмағаным өкінішті.
Dialogue: 0,0:20:52.42,0:20:57.29,Rubi,,0000,0000,0000,,Нейки
Dialogue: 0,0:20:52.42,0:20:57.29,Default,,0000,0000,0000,,(Ұйқыда)
Dialogue: 0,0:20:57.29,0:21:00.93,Default,,0000,0000,0000,,Мм.
Dialogue: 0,0:20:57.29,0:21:00.93,Default,,0000,0000,0000,,Жоқ, жоқ...
Dialogue: 0,0:21:00.93,0:21:03.93,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:21:00.93,0:21:03.93,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:21:00.93,0:21:03.93,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:21:00.93,0:21:03.93,Default,,0000,0000,0000,,Маған жақын арада бірдеңе ойлану керек.
Dialogue: 0,0:21:04.80,0:21:06.80,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:21:04.80,0:21:06.80,Default,,0000,0000,0000,,Иә! Мен жақсы нәрсе ойладым
Dialogue: 0,0:21:06.80,0:21:08.30,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:21:09.44,0:21:11.94,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:21:09.44,0:21:11.94,Default,,0000,0000,0000,,Сәлем әпке
Dialogue: 0,0:21:09.44,0:21:11.94,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:21:11.94,0:21:13.88,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:21:11.94,0:21:13.88,Default,,0000,0000,0000,,Маған фломастеріңізді бере аласыз ба?
Dialogue: 0,0:21:13.88,0:21:16.81,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:21:13.88,0:21:16.81,Default,,0000,0000,0000,,Жоқ, Маруко
Dialogue: 0,0:21:13.88,0:21:16.81,Rubi,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын. Нацуки Субару қайтадан әрекетке кірісті!
Dialogue: 0,0:21:13.88,0:21:16.81,Default,,0000,0000,0000,,Оны бірден ластаңыз.
Dialogue: 0,0:21:16.81,0:21:21.45,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:21:16.81,0:21:21.45,Rubi,,0000,0000,0000,,Ненгахо
Dialogue: 0,0:21:16.81,0:21:21.45,Default,,0000,0000,0000,,Өтінемін. Жаңа жылдық ашықхат қандай тамаша.
Dialogue: 0,0:21:16.81,0:21:21.45,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:21:16.81,0:21:21.45,Default,,0000,0000,0000,,Менде бір идея болды.
Dialogue: 0,0:21:21.45,0:21:24.36,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:21:21.45,0:21:24.36,Default,,0000,0000,0000,,Маған қарызға берсеңіз
Dialogue: 0,0:21:21.45,0:21:24.36,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:21:21.45,0:21:24.36,Rubi,,0000,0000,0000,,Оши
Dialogue: 0,0:21:21.45,0:21:24.36,Default,,0000,0000,0000,,Мен сенің апаңа да айтамын.
Dialogue: 0,0:21:24.36,0:21:27.96,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:21:24.36,0:21:27.96,Default,,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:21:24.36,0:21:27.96,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:21:24.36,0:21:27.96,Default,,0000,0000,0000,,Мен саған фломастерімді қарызға беремін.
Dialogue: 0,0:21:27.96,0:21:30.46,Rubi,,0000,0000,0000,,Тыныштық
Dialogue: 0,0:21:27.96,0:21:30.46,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:21:27.96,0:21:30.46,Default,,0000,0000,0000,,Шынымен бе? Мен саған риза боламын
Dialogue: 0,0:21:30.46,0:21:32.96,Rubi,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын. Нацуки Субару қайтадан әрекетке кірісті!
Dialogue: 0,0:21:30.46,0:21:32.96,Default,,0000,0000,0000,,Оны ластамаңыз!
Dialogue: 0,0:21:30.46,0:21:32.96,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:32.96,0:21:37.96,Default,,0000,0000,0000,,Бұл жақсы идея.
Dialogue: 0,0:21:32.96,0:21:37.96,Rubi,,0000,0000,0000,,Кайджин Нижуменсо
Dialogue: 0,0:21:32.96,0:21:37.96,Default,,0000,0000,0000,,Тіпті 20 беті бар құбыжық та таң қалады.
Dialogue: 0,0:21:38.84,0:21:40.47,Default,,0000,0000,0000,,<Жоқ
Dialogue: 0,0:21:38.84,0:21:40.47,Rubi,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:21:38.84,0:21:40.47,Rubi,,0000,0000,0000,,Фалко!!
Dialogue: 0,0:21:38.84,0:21:40.47,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:21:38.84,0:21:40.47,Default,,0000,0000,0000,,Көздер мен қолдардың суретін сал
Dialogue: 0,0:21:40.47,0:21:43.37,Default,,0000,0000,0000,,«Құттықтаймыз»
Dialogue: 0,0:21:40.47,0:21:43.37,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:21:40.47,0:21:43.37,Default,,0000,0000,0000,,Менің ойымша, сіз бұлай айтпас едіңіз>
Dialogue: 0,0:21:43.37,0:21:44.87,Default,,0000,0000,0000,,Орындалды!
Dialogue: 0,0:21:47.28,0:21:49.28,Rubi,,0000,0000,0000,,Банчи
Dialogue: 0,0:21:47.28,0:21:49.28,Default,,0000,0000,0000,,«№14»
Dialogue: 0,0:21:49.28,0:21:52.92,Default,,0000,0000,0000,,«Хонами Тамае»
Dialogue: 0,0:21:52.92,0:21:56.79,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:21:52.92,0:21:56.79,Default,,0000,0000,0000,,Мм... «Мырза» Хмф~
Dialogue: 0,0:21:56.79,0:22:00.79,Default,,0000,0000,0000,,Ха, мен жасадым. Бұл.
Dialogue: 0,0:21:56.79,0:22:00.79,Rubi,,0000,0000,0000,,Тошидама
Dialogue: 0,0:21:56.79,0:22:00.79,Rubi,,0000,0000,0000,,Кірпіш
Dialogue: 0,0:21:56.79,0:22:00.79,Default,,0000,0000,0000,,Жаңа жылдық сыйлық бар жаңа жылдық ашықхат
Dialogue: 0,0:22:00.79,0:22:03.43,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:22:00.79,0:22:03.43,Rubi,,0000,0000,0000,,Достар
Dialogue: 0,0:22:00.79,0:22:03.43,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:22:00.79,0:22:03.43,Default,,0000,0000,0000,,Бұл әйелдер достары мен мұғалімдеріне арналған.
Dialogue: 0,0:22:03.43,0:22:07.30,Rubi,,0000,0000,0000,,Қалыпты
Dialogue: 0,0:22:03.43,0:22:07.30,Default,,0000,0000,0000,,Бұл кәдімгі ашықхат
Dialogue: 0,0:22:03.43,0:22:07.30,Rubi,,0000,0000,0000,,Би
Dialogue: 0,0:22:03.43,0:22:07.30,Default,,0000,0000,0000,,Ұлдарға арналған
Dialogue: 0,0:22:07.30,0:22:11.30,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:22:07.30,0:22:11.30,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:22:07.30,0:22:11.30,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:22:07.30,0:22:11.30,Default,,0000,0000,0000,,Мен оны тезірек шығаруым керек.
Dialogue: 0,0:22:07.30,0:22:11.30,Rubi,,0000,0000,0000,,Мықты
Dialogue: 0,0:22:07.30,0:22:11.30,Default,,0000,0000,0000,,Қазірдің өзінде 20 желтоқсан.
Dialogue: 0,0:22:12.94,0:22:15.44,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:22:12.94,0:22:15.44,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:22:12.94,0:22:15.44,Default,,0000,0000,0000,,Қолтаңба қалам көп рахмет
Dialogue: 0,0:22:15.44,0:22:17.94,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:22:15.44,0:22:17.94,Default,,0000,0000,0000,,Иә, жақсы жаздыңыз ба?
Dialogue: 0,0:22:15.44,0:22:17.94,Default,,0000,0000,0000,,Енді, енді.
Dialogue: 0,0:22:17.94,0:22:20.84,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:22:17.94,0:22:20.84,Rubi,,0000,0000,0000,,Толық
Dialogue: 0,0:22:17.94,0:22:20.84,Default,,0000,0000,0000,,Бірақ мен сәтсіздікке ұшыраған бірінші нәрсе болды
Dialogue: 0,0:22:17.94,0:22:20.84,Default,,0000,0000,0000,,Иә, бірақ
Dialogue: 0,0:22:20.84,0:22:22.45,Rubi,,0000,0000,0000,,Толық
Dialogue: 0,0:22:20.84,0:22:22.45,Default,,0000,0000,0000,,Уху… Сәтсіз ашықхат
Dialogue: 0,0:22:22.45,0:22:24.95,Rubi,,0000,0000,0000,,Юбинкиоку
Dialogue: 0,0:22:22.45,0:22:24.95,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:22:22.45,0:22:24.95,Default,,0000,0000,0000,,Поштаға апарсаңыз
Dialogue: 0,0:22:22.45,0:22:24.95,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:22:22.45,0:22:24.95,Default,,0000,0000,0000,,Мен оны сізге ауыстырамын.
Dialogue: 0,0:22:24.95,0:22:28.45,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:22:24.95,0:22:28.45,Default,,0000,0000,0000,,А, онда мен мұны істеймін.
Dialogue: 0,0:22:28.45,0:22:29.95,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:22:31.36,0:22:34.96,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:22:31.36,0:22:34.96,Rubi,,0000,0000,0000,,Джушо
Dialogue: 0,0:22:31.36,0:22:34.96,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:22:31.36,0:22:34.96,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:22:31.36,0:22:34.96,Default,,0000,0000,0000,,Мекен-жайыңызды жазуды ұмытпаңыз.
Dialogue: 0,0:22:34.96,0:22:38.46,Rubi,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:22:34.96,0:22:38.46,Default,,0000,0000,0000,,Аа, мұғалімнің ашық хаты
Dialogue: 0,0:22:34.96,0:22:38.46,Rubi,,0000,0000,0000,,Білім
Dialogue: 0,0:22:34.96,0:22:38.46,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:22:34.96,0:22:38.46,Default,,0000,0000,0000,,Мен оны жақсы сала алмадым.
Dialogue: 0,0:22:38.46,0:22:40.40,Rubi,,0000,0000,0000,,Фудзи-сан
Dialogue: 0,0:22:38.46,0:22:40.40,Rubi,,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:22:38.46,0:22:40.40,Default,,0000,0000,0000,,Фудзи тауының суреті. Бір...
Dialogue: 0,0:22:40.40,0:22:44.33,Default,,0000,0000,0000,,Бірақ Икка
Dialogue: 0,0:22:40.40,0:22:44.33,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:40.40,0:22:44.33,Default,,0000,0000,0000,,Оны бала кезінде көргенде жүрегің жылытады.
Dialogue: 0,0:22:44.33,0:22:46.27,Rubi,,0000,0000,0000,,Білім
Dialogue: 0,0:22:44.33,0:22:46.27,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:22:44.33,0:22:46.27,Default,,0000,0000,0000,,Егер сіз тым жақсы сурет салсаңыз
Dialogue: 0,0:22:46.27,0:22:48.91,Rubi,,0000,0000,0000,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:22:46.27,0:22:48.91,Rubi,,0000,0000,0000,,Тецуда
Dialogue: 0,0:22:46.27,0:22:48.91,Default,,0000,0000,0000,,«Ата-анам көмектесті»
Dialogue: 0,0:22:46.27,0:22:48.91,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:22:46.27,0:22:48.91,Default,,0000,0000,0000,,Меніңше
Dialogue: 0,0:22:48.91,0:22:52.78,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:22:48.91,0:22:52.78,Default,,0000,0000,0000,,Сонымен қатар үй тапсырмасы туралы.
Dialogue: 0,0:22:48.91,0:22:52.78,Rubi,,0000,0000,0000,,Ая
Dialogue: 0,0:22:48.91,0:22:52.78,Rubi,,0000,0000,0000,,Сонымен
Dialogue: 0,0:22:48.91,0:22:52.78,Default,,0000,0000,0000,,Егер сіз күдіктенсеңіз, бұл шығын болар еді.
Dialogue: 0,0:22:52.78,0:22:54.78,Rubi,,0000,0000,0000,,Фукайо
Dialogue: 0,0:22:52.78,0:22:54.78,Default,,0000,0000,0000,,<Сіз оны тым көп оқып жатырсыз>
Dialogue: 0,0:23:02.42,0:23:03.42,Default,,0000,0000,0000,,Оишо
Dialogue: 0,0:23:08.29,0:23:15.93,Rubi,,0000,0000,0000,,Анықтама
Dialogue: 0,0:23:08.29,0:23:15.93,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:23:08.29,0:23:15.93,Rubi,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:23:08.29,0:23:15.93,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:23:08.29,0:23:15.93,Default,,0000,0000,0000,,(станция қызметкерлері мен тұтынушылардың дауыстары)
Dialogue: 0,0:23:15.93,0:23:19.80,Rubi,,0000,0000,0000,,Толық
Dialogue: 0,0:23:15.93,0:23:19.80,Default,,0000,0000,0000,,Ал... сәтсіз ашықхат.
Dialogue: 0,0:23:15.93,0:23:19.80,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:23:15.93,0:23:19.80,Default,,0000,0000,0000,,ауыстырыңыз
Dialogue: 0,0:23:19.80,0:23:22.81,Rubi,,0000,0000,0000,,Анықтама
Dialogue: 0,0:23:19.80,0:23:22.81,Default,,0000,0000,0000,,Иә, жақсы.
Dialogue: 0,0:23:19.80,0:23:22.81,Default,,0000,0000,0000,,А, міне, солай.
Dialogue: 0,0:23:22.81,0:23:24.31,Default,,0000,0000,0000,,Иә, рахмет. Ах...
Dialogue: 0,0:23:26.44,0:23:28.95,Rubi,,0000,0000,0000,,Анықтама
Dialogue: 0,0:23:26.44,0:23:28.95,Default,,0000,0000,0000,,(бюро қызметкері)
Dialogue: 0,0:23:26.44,0:23:28.95,Default,,0000,0000,0000,,Көкек... Кукукукукуку...
Dialogue: 0,0:23:28.95,0:23:31.45,Rubi,,0000,0000,0000,,Анықтама
Dialogue: 0,0:23:28.95,0:23:31.45,Default,,0000,0000,0000,,《Хяхахахаха
Dialogue: 0,0:23:31.45,0:23:38.32,Default,,0000,0000,0000,,Ахахахха!
Dialogue: 0,0:23:31.45,0:23:38.32,Default,,0000,0000,0000,,Ахахаха Ахахахаха!
Dialogue: 0,0:23:38.32,0:23:41.46,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:23:38.32,0:23:41.46,Default,,0000,0000,0000,,Эй, эй, бұл не?
Dialogue: 0,0:23:38.32,0:23:41.46,Default,,0000,0000,0000,,Міне! Ахахха! 》
Dialogue: 0,0:23:41.46,0:23:43.96,Rubi,,0000,0000,0000,,Кокуин
Dialogue: 0,0:23:41.46,0:23:43.96,Rubi,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:23:41.46,0:23:43.96,Rubi,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:23:41.46,0:23:43.96,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:23:41.46,0:23:43.96,Default,,0000,0000,0000,,《Күлме, күлме, бұл менмін...》
Dialogue: 0,0:23:43.96,0:23:46.46,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:23:43.96,0:23:46.46,Rubi,,0000,0000,0000,,En
Dialogue: 0,0:23:43.96,0:23:46.46,Default,,0000,0000,0000,,Айырбастау комиссиясы 2 иенді құрайды...
Dialogue: 0,0:23:46.46,0:23:49.97,Rubi,,0000,0000,0000,,Ақша
Dialogue: 0,0:23:46.46,0:23:49.97,Default,,0000,0000,0000,,Не, саған ақша керек пе?
Dialogue: 0,0:23:46.46,0:23:49.97,Rubi,,0000,0000,0000,,En
Dialogue: 0,0:23:46.46,0:23:49.97,Default,,0000,0000,0000,,2 иен?
Dialogue: 0,0:23:49.97,0:23:52.87,Rubi,,0000,0000,0000,,Анықтама
Dialogue: 0,0:23:49.97,0:23:52.87,Default,,0000,0000,0000,,《Гяхахахаха! 》
Dialogue: 0,0:23:49.97,0:23:52.87,Default,,0000,0000,0000,,Мен әкелген жоқпын.
Dialogue: 0,0:23:52.87,0:23:55.84,Rubi,,0000,0000,0000,,Сұрау
