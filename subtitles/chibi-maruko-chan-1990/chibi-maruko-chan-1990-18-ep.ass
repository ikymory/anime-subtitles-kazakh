Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:06.82,0:01:17.32,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:12.25,0:03:15.22,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:12.25,0:03:15.22,Default,,0000,0000,0000,,(Балалар шуы)
Dialogue: 0,0:03:15.22,0:03:18.35,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:15.22,0:03:18.35,Default,,0000,0000,0000,,Эх!
Dialogue: 0,0:03:15.22,0:03:18.35,Rubi,,0000,0000,0000,,Йонака
Dialogue: 0,0:03:15.22,0:03:18.35,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:03:15.22,0:03:18.35,Default,,0000,0000,0000,,Түн ортасында торт жедің бе?
Dialogue: 0,0:03:18.35,0:03:22.22,Rubi,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:03:18.35,0:03:22.22,Rubi,,0000,0000,0000,,Арман
Dialogue: 0,0:03:18.35,0:03:22.22,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:03:18.35,0:03:22.22,Default,,0000,0000,0000,,Иә, қорқынышты түс көр.
Dialogue: 0,0:03:18.35,0:03:22.22,Rubi,,0000,0000,0000,,Йонака
Dialogue: 0,0:03:18.35,0:03:22.22,Rubi,,0000,0000,0000,,Гузен
Dialogue: 0,0:03:18.35,0:03:22.22,Rubi,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:03:18.35,0:03:22.22,Rubi,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:03:18.35,0:03:22.22,Default,,0000,0000,0000,,Түн ортасында кездейсоқ ояндым.
Dialogue: 0,0:03:22.22,0:03:25.23,Default,,0000,0000,0000,,Және торт
Dialogue: 0,0:03:22.22,0:03:25.23,Rubi,,0000,0000,0000,,Қанкей
Dialogue: 0,0:03:22.22,0:03:25.23,Default,,0000,0000,0000,,Қандай байланыс бар?
Dialogue: 0,0:03:25.23,0:03:28.16,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:03:25.23,0:03:28.16,Rubi,,0000,0000,0000,,Достар
Dialogue: 0,0:03:25.23,0:03:28.16,Default,,0000,0000,0000,,Анамның досы
Dialogue: 0,0:03:25.23,0:03:28.16,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:03:25.23,0:03:28.16,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:03:25.23,0:03:28.16,Default,,0000,0000,0000,,Мен түнеуге келдім.
Dialogue: 0,0:03:28.16,0:03:30.80,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:03:28.16,0:03:30.80,Default,,0000,0000,0000,,Сувенирлік торт
Dialogue: 0,0:03:28.16,0:03:30.80,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:03:28.16,0:03:30.80,Default,,0000,0000,0000,,Оны жеуге болады.
Dialogue: 0,0:03:30.80,0:03:32.30,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:03:32.30,0:03:36.81,Rubi,,0000,0000,0000,,Ересек
Dialogue: 0,0:03:32.30,0:03:36.81,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:03:32.30,0:03:36.81,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:03:32.30,0:03:36.81,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:03:32.30,0:03:36.81,Rubi,,0000,0000,0000,,болып табылады
Dialogue: 0,0:03:32.30,0:03:36.81,Default,,0000,0000,0000,,Біреу келе жатқанда үлкендер қадағалайды.
Dialogue: 0,0:03:32.30,0:03:36.81,Rubi,,0000,0000,0000,,Өсімдіктер
Dialogue: 0,0:03:32.30,0:03:36.81,Default,,0000,0000,0000,,Бұл сізді мейірімді етеді.
Dialogue: 0,0:03:36.81,0:03:38.74,Default,,0000,0000,0000,,Торт, жақсы.
Dialogue: 0,0:03:38.74,0:03:41.68,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:03:38.74,0:03:41.68,Default,,0000,0000,0000,,Мару-чан дегеніміз не?
Dialogue: 0,0:03:38.74,0:03:41.68,Rubi,,0000,0000,0000,,Кейкен
Dialogue: 0,0:03:38.74,0:03:41.68,Default,,0000,0000,0000,,Сізде мұндай тәжірибе жоқ па?
Dialogue: 0,0:03:41.68,0:03:43.68,Default,,0000,0000,0000,,Жоқ, оның болуы мүмкін емес.
Dialogue: 0,0:03:43.68,0:03:45.31,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:03:43.68,0:03:45.31,Default,,0000,0000,0000,,Менде бар
Dialogue: 0,0:03:45.31,0:03:47.25,Default,,0000,0000,0000,,Бұл әлі торт па?
Dialogue: 0,0:03:47.25,0:03:49.82,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:03:47.25,0:03:49.82,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:03:47.25,0:03:49.82,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:03:47.25,0:03:49.82,Default,,0000,0000,0000,,Әкесі үйге келгенде
Dialogue: 0,0:03:49.82,0:03:52.72,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:03:49.82,0:03:52.72,Default,,0000,0000,0000,,Сувенирлік суши
Dialogue: 0,0:03:49.82,0:03:52.72,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:03:49.82,0:03:52.72,Default,,0000,0000,0000,,Бәріміз тамақтандық
Dialogue: 0,0:03:52.72,0:03:54.32,Default,,0000,0000,0000,,Бұл дәмді болды.
Dialogue: 0,0:03:54.32,0:03:55.82,Default,,0000,0000,0000,,О, суши!
Dialogue: 0,0:03:55.82,0:03:57.76,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:03:55.82,0:03:57.76,Default,,0000,0000,0000,,- (Гүл шоқ) Ханымдар!
Dialogue: 0,0:03:57.76,0:04:01.33,Default,,0000,0000,0000,,Тек суши мен торт
Dialogue: 0,0:03:57.76,0:04:01.33,Rubi,,0000,0000,0000,,Қангеки
Dialogue: 0,0:03:57.76,0:04:01.33,Default,,0000,0000,0000,,Тым таңданбаңыз
Dialogue: 0,0:04:01.33,0:04:04.83,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:04:01.33,0:04:04.83,Default,,0000,0000,0000,,Ханава-кун суши мен торттан жақсы
Dialogue: 0,0:04:01.33,0:04:04.83,Rubi,,0000,0000,0000,,Кейкен
Dialogue: 0,0:04:01.33,0:04:04.83,Default,,0000,0000,0000,,Сізде керемет тәжірибе бар ма?
Dialogue: 0,0:04:04.83,0:04:06.34,Default,,0000,0000,0000,,Әрине
Dialogue: 0,0:04:06.34,0:04:09.84,Rubi,,0000,0000,0000,,Таши
Dialogue: 0,0:04:06.34,0:04:09.84,Default,,0000,0000,0000,,Бұл сөзсіз
Dialogue: 0,0:04:06.34,0:04:09.84,Rubi,,0000,0000,0000,,Ұстағыш
Dialogue: 0,0:04:06.34,0:04:09.84,Default,,0000,0000,0000,,Менің ойымша, бұл жарты ай бұрын болды.
Dialogue: 0,0:04:09.84,0:04:11.34,Rubi,,0000,0000,0000,,♬ Әлі ұрланған уақытқа
Dialogue: 0,0:04:09.84,0:04:11.34,Default,,0000,0000,0000,,Мен нәзікпін
Dialogue: 0,0:04:11.34,0:04:14.84,Rubi,,0000,0000,0000,,Жарылыс
Dialogue: 0,0:04:11.34,0:04:14.84,Rubi,,0000,0000,0000,,Бал түймесі
Dialogue: 0,0:04:11.34,0:04:14.84,Rubi,,0000,0000,0000,,көп еңбектенгеніңді байқауға болады…
Dialogue: 0,0:04:11.34,0:04:14.84,Default,,0000,0000,0000,,Бір түн көрпеде
Dialogue: 0,0:04:11.34,0:04:14.84,Rubi,,0000,0000,0000,,Кенеттен
Dialogue: 0,0:04:11.34,0:04:14.84,Rubi,,0000,0000,0000,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:04:11.34,0:04:14.84,Rubi,,0000,0000,0000,,Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:04:11.34,0:04:14.84,Default,,0000,0000,0000,,Егер сіз кенеттен оянсаңыз...
Dialogue: 0,0:04:14.84,0:04:16.78,Default,,0000,0000,0000,,...
Dialogue: 0,0:04:16.78,0:04:19.35,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:04:16.78,0:04:19.35,Default,,0000,0000,0000,,Бұл маңызды емес
Dialogue: 0,0:04:19.35,0:04:22.85,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:04:19.35,0:04:22.85,Default,,0000,0000,0000,,Сіз бәрібір оянсаңыз
Dialogue: 0,0:04:19.35,0:04:22.85,Rubi,,0000,0000,0000,,Көптеген
Dialogue: 0,0:04:19.35,0:04:22.85,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:04:19.35,0:04:22.85,Rubi,,0000,0000,0000,,Бұл – дарынды балалар «Екінші L» болу үшін жиналатын орын.
Dialogue: 0,0:04:19.35,0:04:22.85,Default,,0000,0000,0000,,Анам мен әкем көп қонақтарды шақырды.
Dialogue: 0,0:04:22.85,0:04:24.35,Rubi,,0000,0000,0000,,Хира
Dialogue: 0,0:04:22.85,0:04:24.35,Default,,0000,0000,0000,,Біз кеш өткізіп жатқан едік.
Dialogue: 0,0:04:24.35,0:04:26.79,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:04:24.35,0:04:26.79,Default,,0000,0000,0000,,Сізде үлкен той болды ма?
Dialogue: 0,0:04:26.79,0:04:29.29,Rubi,,0000,0000,0000,,Мен қалаймын
Dialogue: 0,0:04:26.79,0:04:29.29,Default,,0000,0000,0000,,Уау, бұл соншалықты үлкен мәміле емес.
Dialogue: 0,0:04:26.79,0:04:29.29,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:04:29.29,0:04:31.79,Rubi,,0000,0000,0000,,Сары
Dialogue: 0,0:04:29.29,0:04:31.79,Default,,0000,0000,0000,,жай
Dialogue: 0,0:04:29.29,0:04:31.79,Rubi,,0000,0000,0000,,Риори
Dialogue: 0,0:04:29.29,0:04:31.79,Default,,0000,0000,0000,,Француз асханасының толық курсы
Dialogue: 0,0:04:31.79,0:04:34.70,Rubi,,0000,0000,0000,,Риори
Dialogue: 0,0:04:31.79,0:04:34.70,Default,,0000,0000,0000,,Үйдегі француз тағамдары!
Dialogue: 0,0:04:34.70,0:04:37.30,Default,,0000,0000,0000,,Филе стейк
Dialogue: 0,0:04:34.70,0:04:37.30,Default,,0000,0000,0000,,Фуа гра соусы және
Dialogue: 0,0:04:37.30,0:04:41.17,Rubi,,0000,0000,0000,,Кару
Dialogue: 0,0:04:37.30,0:04:41.17,Rubi,,0000,0000,0000,,Тек
Dialogue: 0,0:04:37.30,0:04:41.17,Default,,0000,0000,0000,,Жеңіл десерт немесе басқа нәрсе алыңыз.
Dialogue: 0,0:04:37.30,0:04:41.17,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:04:37.30,0:04:41.17,Default,,0000,0000,0000,,Мен бірден ұйықтап қалдым
Dialogue: 0,0:04:41.17,0:04:44.17,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:41.17,0:04:44.17,Rubi,,0000,0000,0000,,Ханава
Dialogue: 0,0:04:41.17,0:04:44.17,Default,,0000,0000,0000,,Ханава-кун күткендей
Dialogue: 0,0:04:41.17,0:04:44.17,Default,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:04:44.17,0:04:47.31,Default,,0000,0000,0000,,А, торт пен суши
Dialogue: 0,0:04:44.17,0:04:47.31,Rubi,,0000,0000,0000,,Риори
Dialogue: 0,0:04:44.17,0:04:47.31,Default,,0000,0000,0000,,Француз тағамдары…
Dialogue: 0,0:04:47.31,0:04:50.81,Rubi,,0000,0000,0000,,Ересек
Dialogue: 0,0:04:47.31,0:04:50.81,Default,,0000,0000,0000,,Мүмкін ересектер
Dialogue: 0,0:04:47.31,0:04:50.81,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:04:47.31,0:04:50.81,Rubi,,0000,0000,0000,,Михака
Dialogue: 0,0:04:47.31,0:04:50.81,Default,,0000,0000,0000,,Бала төсекке кеткеннен кейін
Dialogue: 0,0:04:50.81,0:04:52.75,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:04:50.81,0:04:52.75,Default,,0000,0000,0000,,Ас ішу
Dialogue: 0,0:04:50.81,0:04:52.75,Rubi,,0000,0000,0000,,Сава
Dialogue: 0,0:04:50.81,0:04:52.75,Default,,0000,0000,0000,,Дау-дамай жасау
Dialogue: 0,0:04:52.75,0:04:56.32,Rubi,,0000,0000,0000,,Асо
Dialogue: 0,0:04:52.75,0:04:56.32,Default,,0000,0000,0000,,Сіз ойнамайсыз ба?
Dialogue: 0,0:04:52.75,0:04:56.32,Default,,0000,0000,0000,,Бұл жасырын.
Dialogue: 0,0:04:56.32,0:04:58.82,Rubi,,0000,0000,0000,,Бастама
Dialogue: 0,0:04:56.32,0:04:58.82,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:04:56.32,0:04:58.82,Default,,0000,0000,0000,,Түсіндім! Енді жұмбақ шешілді
Dialogue: 0,0:04:58.82,0:05:02.82,Rubi,,0000,0000,0000,,Ересек
Dialogue: 0,0:04:58.82,0:05:02.82,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:04:58.82,0:05:02.82,Default,,0000,0000,0000,,Не болса да, үлкендер балаға айналады.
Dialogue: 0,0:04:58.82,0:05:02.82,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:04:58.82,0:05:02.82,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:04:58.82,0:05:02.82,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:04:58.82,0:05:02.82,Default,,0000,0000,0000,,«Ерте жат» дегеніңіз осы.
Dialogue: 0,0:05:04.33,0:05:07.23,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:05:04.33,0:05:07.23,Default,,0000,0000,0000,,《Бұл адам болмайды
Dialogue: 0,0:05:04.33,0:05:07.23,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:04.33,0:05:07.23,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:05:04.33,0:05:07.23,Default,,0000,0000,0000,,Балалар ұйықтап болғаннан кейін
Dialogue: 0,0:05:07.23,0:05:09.20,Default,,0000,0000,0000,,Сіз кеш өткізіп жатырсыз ба? 》
Dialogue: 0,0:05:09.20,0:05:12.84,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:05:09.20,0:05:12.84,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:09.20,0:05:12.84,Default,,0000,0000,0000,,Бұл қандай бала?
Dialogue: 0,0:05:09.20,0:05:12.84,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:05:09.20,0:05:12.84,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:05:09.20,0:05:12.84,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:05:09.20,0:05:12.84,Default,,0000,0000,0000,,Біреудің бетіне қарау
Dialogue: 0,0:05:12.84,0:05:14.34,Default,,0000,0000,0000,,Б-бұл қызық екен, иә?
Dialogue: 0,0:05:14.34,0:05:16.27,Rubi,,0000,0000,0000,,Кимо
Dialogue: 0,0:05:14.34,0:05:16.27,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:05:14.34,0:05:16.27,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:14.34,0:05:16.27,Default,,0000,0000,0000,,Сен жиіркенішті бала.
Dialogue: 0,0:05:16.27,0:05:19.21,Default,,0000,0000,0000,,《Сәлеметсіз бе, суши.
Dialogue: 0,0:05:16.27,0:05:19.21,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:05:16.27,0:05:19.21,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:05:16.27,0:05:19.21,Default,,0000,0000,0000,,Кәдесый ретінде не сатып алу керек
Dialogue: 0,0:05:19.21,0:05:21.84,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:05:19.21,0:05:21.84,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:05:19.21,0:05:21.84,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:05:19.21,0:05:21.84,Default,,0000,0000,0000,,Сіз ақылды емессіз.》
Dialogue: 0,0:05:25.35,0:05:28.25,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:05:25.35,0:05:28.25,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:25.35,0:05:28.25,Default,,0000,0000,0000,,Не? Маруко
Dialogue: 0,0:05:25.35,0:05:28.25,Rubi,,0000,0000,0000,,Шукудай
Dialogue: 0,0:05:25.35,0:05:28.25,Rubi,,0000,0000,0000,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:05:25.35,0:05:28.25,Default,,0000,0000,0000,,Үй тапсырмасын өз бетінше орында
Dialogue: 0,0:05:28.25,0:05:30.19,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:05:28.25,0:05:30.19,Default,,0000,0000,0000,,Е! Менің әпкем де
Dialogue: 0,0:05:30.19,0:05:32.79,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:05:30.19,0:05:32.79,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:05:30.19,0:05:32.79,Default,,0000,0000,0000,,Мүмкін мен Маруконың жасында болған шығармын.
Dialogue: 0,0:05:32.79,0:05:35.69,Rubi,,0000,0000,0000,,Йонака
Dialogue: 0,0:05:32.79,0:05:35.69,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:32.79,0:05:35.69,Default,,0000,0000,0000,,Түн ортасында дәретханаға барғым келеді
Dialogue: 0,0:05:32.79,0:05:35.69,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:05:32.79,0:05:35.69,Default,,0000,0000,0000,,Оянғанда
Dialogue: 0,0:05:35.69,0:05:38.66,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:05:35.69,0:05:38.66,Rubi,,0000,0000,0000,,Достар
Dialogue: 0,0:05:35.69,0:05:38.66,Default,,0000,0000,0000,,Менің әкем мен атамның достары
Dialogue: 0,0:05:35.69,0:05:38.66,Rubi,,0000,0000,0000,,Көптеген
Dialogue: 0,0:05:35.69,0:05:38.66,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:05:35.69,0:05:38.66,Default,,0000,0000,0000,,Көп адам келді
Dialogue: 0,0:05:38.66,0:05:41.30,Rubi,,0000,0000,0000,,Энкай
Dialogue: 0,0:05:38.66,0:05:41.30,Default,,0000,0000,0000,,Барлығымыз той жасап жатыр едік.
Dialogue: 0,0:05:41.30,0:05:43.23,Default,,0000,0000,0000,,Сонымен не болды?
Dialogue: 0,0:05:43.23,0:05:45.17,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:05:43.23,0:05:45.17,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:05:43.23,0:05:45.17,Default,,0000,0000,0000,,Сіздің апаңыз да той жасады ма?
Dialogue: 0,0:05:45.17,0:05:48.17,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:05:45.17,0:05:48.17,Default,,0000,0000,0000,,Иә! Ояу болғаны дұрыс
Dialogue: 0,0:05:45.17,0:05:48.17,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:05:45.17,0:05:48.17,Default,,0000,0000,0000,,Маған айтты
Dialogue: 0,0:05:48.17,0:05:50.31,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:05:48.17,0:05:50.31,Default,,0000,0000,0000,,Менің де тойым болды.
Dialogue: 0,0:05:50.31,0:05:53.21,Rubi,,0000,0000,0000,,Козука
Dialogue: 0,0:05:50.31,0:05:53.21,Default,,0000,0000,0000,,Тіпті қалта ақшасы
Dialogue: 0,0:05:50.31,0:05:53.21,Default,,0000,0000,0000,,Себебі мен оны алдым.
Dialogue: 0,0:05:53.21,0:05:56.81,Rubi,,0000,0000,0000,,Ағымдағы жағдай
Dialogue: 0,0:05:53.21,0:05:56.81,Default,,0000,0000,0000,,Қазір ойлап қарасам да
Dialogue: 0,0:05:53.21,0:05:56.81,Default,,0000,0000,0000,,Бұл сәттілік болды.
Dialogue: 0,0:05:56.81,0:05:58.31,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:05:56.81,0:05:58.31,Default,,0000,0000,0000,,Керемет екен, әпке.
Dialogue: 0,0:05:58.31,0:06:01.22,Default,,0000,0000,0000,,Тіпті үйде
Dialogue: 0,0:05:58.31,0:06:01.22,Default,,0000,0000,0000,,Осындай жақсылық болды ма?
Dialogue: 0,0:06:01.22,0:06:03.19,Rubi,,0000,0000,0000,,Кілт
Dialogue: 0,0:06:01.22,0:06:03.19,Default,,0000,0000,0000,,Тек біз үшін
Dialogue: 0,0:06:01.22,0:06:03.19,Default,,0000,0000,0000,,Қандай әзіл
Dialogue: 0,0:06:03.19,0:06:05.82,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:06:03.19,0:06:05.82,Default,,0000,0000,0000,,Амал жоқ деп ойладым
Dialogue: 0,0:06:05.82,0:06:09.32,Rubi,,0000,0000,0000,,Ересек
Dialogue: 0,0:06:05.82,0:06:09.32,Default,,0000,0000,0000,,Дұрыс, үлкендер
Dialogue: 0,0:06:05.82,0:06:09.32,Rubi,,0000,0000,0000,,Менің тобым
Dialogue: 0,0:06:05.82,0:06:09.32,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:06:05.82,0:06:09.32,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:06:05.82,0:06:09.32,Default,,0000,0000,0000,,Әр түнде бала ұйықтағаннан кейін
Dialogue: 0,0:06:09.32,0:06:10.83,Rubi,,0000,0000,0000,,Аздап
Dialogue: 0,0:06:09.32,0:06:10.83,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:06:09.32,0:06:10.83,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:06:09.32,0:06:10.83,Default,,0000,0000,0000,,Мен сүйікті теледидарымды жиі қараймын.
Dialogue: 0,0:06:10.83,0:06:13.73,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:06:10.83,0:06:13.73,Default,,0000,0000,0000,,Дәмді тағамды жеу
Dialogue: 0,0:06:10.83,0:06:13.73,Default,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:06:13.73,0:06:18.33,Rubi,,0000,0000,0000,,Йонака
Dialogue: 0,0:06:13.73,0:06:18.33,Rubi,,0000,0000,0000,,Гузен
Dialogue: 0,0:06:13.73,0:06:18.33,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:06:13.73,0:06:18.33,Default,,0000,0000,0000,,Мен де кездейсоқ түн ортасында оянып кеттім.
Dialogue: 0,0:06:13.73,0:06:18.33,Rubi,,0000,0000,0000,,Тәйкен
Dialogue: 0,0:06:13.73,0:06:18.33,Default,,0000,0000,0000,,Мен осындай керемет тәжірибе алғым келеді
Dialogue: 0,0:06:18.33,0:06:20.84,Rubi,,0000,0000,0000,,Дзётаро
Dialogue: 0,0:06:18.33,0:06:20.84,Default,,0000,0000,0000,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:06:18.33,0:06:20.84,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:06:20.84,0:06:23.34,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:06:20.84,0:06:23.34,Rubi,,0000,0000,0000,,Арнайы
Dialogue: 0,0:06:20.84,0:06:23.34,Rubi,,0000,0000,0000,,Небу
Dialogue: 0,0:06:20.84,0:06:23.34,Default,,0000,0000,0000,,Маруко ерекше, өйткені ол артық ұйықтады.
Dialogue: 0,0:06:23.34,0:06:25.27,Rubi,,0000,0000,0000,,Бір рет
Dialogue: 0,0:06:23.34,0:06:25.27,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:06:23.34,0:06:25.27,Default,,0000,0000,0000,,Ұйықтаған кезде
Dialogue: 0,0:06:23.34,0:06:25.27,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:06:23.34,0:06:25.27,Rubi,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:06:23.34,0:06:25.27,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:06:23.34,0:06:25.27,Default,,0000,0000,0000,,Таңертеңге дейін оянбайсың.
Dialogue: 0,0:06:25.27,0:06:27.21,Rubi,,0000,0000,0000,,Исшо
Dialogue: 0,0:06:25.27,0:06:27.21,Rubi,,0000,0000,0000,,Дзётаро
Dialogue: 0,0:06:25.27,0:06:27.21,Default,,0000,0000,0000,,Демек өмір бойы мүмкін емес.
Dialogue: 0,0:06:27.21,0:06:28.78,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:06:28.78,0:06:30.71,Rubi,,0000,0000,0000,,Жағдайда
Dialogue: 0,0:06:28.78,0:06:30.71,Default,,0000,0000,0000,,<Егер сіз бас изесеңіз>
Dialogue: 0,0:06:30.71,0:06:32.28,Rubi,,0000,0000,0000,,Майонака
Dialogue: 0,0:06:30.71,0:06:32.28,Rubi,,0000,0000,0000,,Сөздік
Dialogue: 0,0:06:30.71,0:06:32.28,Default,,0000,0000,0000,,<Түн ортасында жер сілкінсе де
Dialogue: 0,0:06:32.28,0:06:34.78,Rubi,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:06:32.28,0:06:34.78,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:06:32.28,0:06:34.78,Default,,0000,0000,0000,,1 адам байқамайды
Dialogue: 0,0:06:32.28,0:06:34.78,Default,,0000,0000,0000,,Мару-чанның әдеттері＞
Dialogue: 0,0:06:34.78,0:06:36.29,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:06:34.78,0:06:36.29,Default,,0000,0000,0000,,Осылай туылған
Dialogue: 0,0:06:36.29,0:06:39.79,Rubi,,0000,0000,0000,,Бірдеңе дұрыс емес
Dialogue: 0,0:06:36.29,0:06:39.79,Rubi,,0000,0000,0000,,Энкай
Dialogue: 0,0:06:36.29,0:06:39.79,Default,,0000,0000,0000,,Сіз түнгі кешке неше рет бардыңыз?
Dialogue: 0,0:06:36.29,0:06:39.79,Rubi,,0000,0000,0000,,Шуссеки
Dialogue: 0,0:06:36.29,0:06:39.79,Rubi,,0000,0000,0000,,Онда
Dialogue: 0,0:06:36.29,0:06:39.79,Default,,0000,0000,0000,,Сіз баруды өткізіп алған шығарсыз...
Dialogue: 0,0:06:39.79,0:06:41.29,Rubi,,0000,0000,0000,,Куя
Dialogue: 0,0:06:39.79,0:06:41.29,Default,,0000,0000,0000,,Ха... Менің көңілім қалды!
Dialogue: 0,0:06:42.69,0:06:43.66,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:06:43.66,0:06:45.66,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:06:43.66,0:06:45.66,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:06:43.66,0:06:45.66,Default,,0000,0000,0000,,Маруко, сен әлі ұйықтаған жоқсың ба?
Dialogue: 0,0:06:45.66,0:06:48.30,Rubi,,0000,0000,0000,,Суко
Dialogue: 0,0:06:45.66,0:06:48.30,Default,,0000,0000,0000,,Иә, сәл көбірек
Dialogue: 0,0:06:48.30,0:06:52.17,Rubi,,0000,0000,0000,,Йонака
Dialogue: 0,0:06:48.30,0:06:52.17,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:06:48.30,0:06:52.17,Default,,0000,0000,0000,,《Бірақ түн ортасына дейін тұру үшін
Dialogue: 0,0:06:48.30,0:06:52.17,Default,,0000,0000,0000,,Мен не істеуім керек деп ойлаймын...》
Dialogue: 0,0:06:52.17,0:06:53.80,Default,,0000,0000,0000,,《Иә! 》
Dialogue: 0,0:06:53.80,0:06:55.30,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:06:53.80,0:06:55.30,Rubi,,0000,0000,0000,,Жолдан
Dialogue: 0,0:06:53.80,0:06:55.30,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:06:53.80,0:06:55.30,Default,,0000,0000,0000,,(Оятқыш дыбысы)
Dialogue: 0,0:06:55.30,0:06:58.21,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:55.30,0:06:58.21,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:06:58.21,0:06:59.71,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:01.18,0:07:04.31,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:01.18,0:07:04.31,Rubi,,0000,0000,0000,,Джи
Dialogue: 0,0:07:01.18,0:07:04.31,Default,,0000,0000,0000,,Не? Әлі сағат 3 те емес!
Dialogue: 0,0:07:04.31,0:07:06.25,Rubi,,0000,0000,0000,,Не
Dialogue: 0,0:07:04.31,0:07:06.25,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:07:04.31,0:07:06.25,Default,,0000,0000,0000,,Не болып жатыр? Осындай уақытта
Dialogue: 0,0:07:06.25,0:07:08.18,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:06.25,0:07:08.18,Default,,0000,0000,0000,,Бұл мен емес, Маруко.
Dialogue: 0,0:07:08.18,0:07:11.19,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:08.18,0:07:11.19,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:07:08.18,0:07:11.19,Default,,0000,0000,0000,,Эй Маруко, оян!
Dialogue: 0,0:07:11.19,0:07:13.19,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:11.19,0:07:13.19,Default,,0000,0000,0000,,Хмм, не...
Dialogue: 0,0:07:14.82,0:07:19.33,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:07:14.82,0:07:19.33,Default,,0000,0000,0000,,Ах! әке
Dialogue: 0,0:07:14.82,0:07:19.33,Rubi,,0000,0000,0000,,Энкай
Dialogue: 0,0:07:14.82,0:07:19.33,Default,,0000,0000,0000,,Мүмкін той болып жатқан шығар?
Dialogue: 0,0:07:19.33,0:07:21.26,Rubi,,0000,0000,0000,,Не?
Dialogue: 0,0:07:19.33,0:07:21.26,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:07:19.33,0:07:21.26,Default,,0000,0000,0000,,Не айтып тұрсың, бала?
Dialogue: 0,0:07:21.26,0:07:24.26,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:21.26,0:07:24.26,Rubi,,0000,0000,0000,,Энкай
Dialogue: 0,0:07:21.26,0:07:24.26,Default,,0000,0000,0000,,Банкет дегеніміз не?
Dialogue: 0,0:07:21.26,0:07:24.26,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:07:21.26,0:07:24.26,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:07:21.26,0:07:24.26,Default,,0000,0000,0000,,Мені осы сағатта оятпа, ақымақ!
Dialogue: 0,0:07:26.77,0:07:31.27,Rubi,,0000,0000,0000,,Толық
Dialogue: 0,0:07:26.77,0:07:31.27,Default,,0000,0000,0000,,Юбе сәтсіз болды.
Dialogue: 0,0:07:26.77,0:07:31.27,Rubi,,0000,0000,0000,,Джи
Dialogue: 0,0:07:26.77,0:07:31.27,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:07:26.77,0:07:31.27,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:07:26.77,0:07:31.27,Default,,0000,0000,0000,,3 те жаман уақыт болды.
Dialogue: 0,0:07:31.27,0:07:33.78,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:07:31.27,0:07:33.78,Default,,0000,0000,0000,,Сол кезде
Dialogue: 0,0:07:31.27,0:07:33.78,Rubi,,0000,0000,0000,,Ересек
Dialogue: 0,0:07:31.27,0:07:33.78,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:07:31.27,0:07:33.78,Default,,0000,0000,0000,,Тіпті ересектер де ұйықтайды.
Dialogue: 0,0:07:33.78,0:07:38.28,Default,,0000,0000,0000,,А, жоқ!
Dialogue: 0,0:07:33.78,0:07:38.28,Rubi,,0000,0000,0000,,Кюушокухи
Dialogue: 0,0:07:33.78,0:07:38.28,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:07:33.78,0:07:38.28,Default,,0000,0000,0000,,Мен мектептегі түскі асқа ақша алуды ұмытып кетіппін.
Dialogue: 0,0:07:39.65,0:07:41.65,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:07:39.65,0:07:41.65,Default,,0000,0000,0000,,Ә? (Кения) Сен➡
Dialogue: 0,0:07:41.65,0:07:44.79,Rubi,,0000,0000,0000,,Ядзима
Dialogue: 0,0:07:41.65,0:07:44.79,Rubi,,0000,0000,0000,,Сувенир
Dialogue: 0,0:07:41.65,0:07:44.79,Default,,0000,0000,0000,,Ядзима мырзадан алынған кәдесый
Dialogue: 0,0:07:41.65,0:07:44.79,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:07:44.79,0:07:49.29,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:07:44.79,0:07:49.29,Default,,0000,0000,0000,,О, не? бәрі төсекке кеткеннен кейін
Dialogue: 0,0:07:44.79,0:07:49.29,Rubi,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:07:44.79,0:07:49.29,Rubi,,0000,0000,0000,,Тек
Dialogue: 0,0:07:44.79,0:07:49.29,Default,,0000,0000,0000,,Оны бүгін кешке алғыңыз келе ме?
Dialogue: 0,0:07:49.29,0:07:50.29,Default,,0000,0000,0000,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:07:51.23,0:07:53.16,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:07:51.23,0:07:53.16,Default,,0000,0000,0000,,Мен естідім, хи хи хи...
Dialogue: 0,0:07:53.16,0:07:58.30,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:07:53.16,0:07:58.30,Rubi,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:07:53.16,0:07:58.30,Rubi,,0000,0000,0000,,Энкай
Dialogue: 0,0:07:53.16,0:07:58.30,Default,,0000,0000,0000,,<Бұл жолы міндетті түрде кеш!
Dialogue: 0,0:07:53.16,0:07:58.30,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:53.16,0:07:58.30,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:07:53.16,0:07:58.30,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:07:53.16,0:07:58.30,Default,,0000,0000,0000,,Егер ештеңе болмаса>
Dialogue: 0,0:07:58.30,0:08:00.24,Rubi,,0000,0000,0000,,Кюушокухи
Dialogue: 0,0:07:58.30,0:08:00.24,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:07:58.30,0:08:00.24,Default,,0000,0000,0000,,<Мектептегі түскі асқа ақша алуды ұмытпаңыз.
Dialogue: 0,0:08:00.24,0:08:03.17,Rubi,,0000,0000,0000,,Кейцу
Dialogue: 0,0:08:00.24,0:08:03.17,Rubi,,0000,0000,0000,,Арата
Dialogue: 0,0:08:00.24,0:08:03.17,Default,,0000,0000,0000,,Шешіміңізді жаңартыңыз
Dialogue: 0,0:08:00.24,0:08:03.17,Default,,0000,0000,0000,,Бұл Мару-чан болды>
Dialogue: 0,0:08:03.17,0:08:05.81,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:08:03.17,0:08:05.81,Rubi,,0000,0000,0000,,Дыбыс
Dialogue: 0,0:08:03.17,0:08:05.81,Default,,0000,0000,0000,,(Балалардың қозу дыбыстары)
Dialogue: 0,0:08:05.81,0:08:08.31,Rubi,,0000,0000,0000,,Йонака
Dialogue: 0,0:08:05.81,0:08:08.31,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:08:05.81,0:08:08.31,Rubi,,0000,0000,0000,,Мына мұз жігітке қарашы—
Dialogue: 0,0:08:05.81,0:08:08.31,Default,,0000,0000,0000,,Түн ортасына дейін қалай тұруға болады?
Dialogue: 0,0:08:08.31,0:08:10.25,Rubi,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:08:08.31,0:08:10.25,Default,,0000,0000,0000,,Иә! Бүгін кешке Маруко
Dialogue: 0,0:08:10.25,0:08:12.81,Default,,0000,0000,0000,,Не болса да
Dialogue: 0,0:08:10.25,0:08:12.81,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:08:10.25,0:08:12.81,Default,,0000,0000,0000,,Мен сергек болғым келеді
Dialogue: 0,0:08:12.81,0:08:14.75,Rubi,,0000,0000,0000,,Күрделі
Dialogue: 0,0:08:12.81,0:08:14.75,Default,,0000,0000,0000,,Бұл қиын.
Dialogue: 0,0:08:14.75,0:08:18.69,Default,,0000,0000,0000,,Егер бұл жұмыс істемесе
Dialogue: 0,0:08:14.75,0:08:18.69,Rubi,,0000,0000,0000,,Йонака
Dialogue: 0,0:08:14.75,0:08:18.69,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:08:14.75,0:08:18.69,Rubi,,0000,0000,0000,,Мына мұз жігітке қарашы—
Dialogue: 0,0:08:14.75,0:08:18.69,Default,,0000,0000,0000,,Түн ортасында оянуға да болады
Dialogue: 0,0:08:18.69,0:08:22.32,Rubi,,0000,0000,0000,,Йонака
Dialogue: 0,0:08:18.69,0:08:22.32,Default,,0000,0000,0000,,Мару-чан түн ортасында дәретханаға барады
Dialogue: 0,0:08:18.69,0:08:22.32,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:18.69,0:08:22.32,Default,,0000,0000,0000,,Сіз ешқашан барғыңыз келмейді ме?
Dialogue: 0,0:08:22.32,0:08:25.23,Rubi,,0000,0000,0000,,Нему
Dialogue: 0,0:08:22.32,0:08:25.23,Default,,0000,0000,0000,,Жоқ, ұйықтап қалсаңыз
Dialogue: 0,0:08:22.32,0:08:25.23,Rubi,,0000,0000,0000,,Таң
Dialogue: 0,0:08:22.32,0:08:25.23,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:08:22.32,0:08:25.23,Default,,0000,0000,0000,,Таң атқанша тұрмаймын
Dialogue: 0,0:08:25.23,0:08:26.76,Rubi,,0000,0000,0000,,Йонака
Dialogue: 0,0:08:25.23,0:08:26.76,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:08:25.23,0:08:26.76,Default,,0000,0000,0000,,Түн ортасында қалай тұруға болады
Dialogue: 0,0:08:26.76,0:08:30.27,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:26.76,0:08:30.27,Default,,0000,0000,0000,,Дәретханаға барғысы келетін сезім
Dialogue: 0,0:08:26.76,0:08:30.27,Rubi,,0000,0000,0000,,Көпшілігі
Dialogue: 0,0:08:26.76,0:08:30.27,Default,,0000,0000,0000,,Бұл ең жақсы...
Dialogue: 0,0:08:30.27,0:08:32.77,Default,,0000,0000,0000,,Қалай
Dialogue: 0,0:08:30.27,0:08:32.77,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:30.27,0:08:32.77,Default,,0000,0000,0000,,Дәретханаға барғыңыз келе ме?
Dialogue: 0,0:08:32.77,0:08:35.27,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:08:32.77,0:08:35.27,Rubi,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:08:32.77,0:08:35.27,Default,,0000,0000,0000,,Егер сіз суды көп ішсеңіз
Dialogue: 0,0:08:32.77,0:08:35.27,Default,,0000,0000,0000,,тырыспайсың?
Dialogue: 0,0:08:35.27,0:08:36.77,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:08:35.27,0:08:36.77,Default,,0000,0000,0000,,Әй, су!
Dialogue: 0,0:08:36.77,0:08:38.77,Default,,0000,0000,0000,,Ах! Ахаха
Dialogue: 0,0:08:40.28,0:08:41.78,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:41.78,0:08:43.28,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:08:41.78,0:08:43.28,Rubi,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:08:41.78,0:08:43.28,Default,,0000,0000,0000,,Мару-чан, қазір ішуді баста.
Dialogue: 0,0:08:43.28,0:08:46.28,Rubi,,0000,0000,0000,,Джугёчуу
Dialogue: 0,0:08:43.28,0:08:46.28,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:08:43.28,0:08:46.28,Default,,0000,0000,0000,,Сабақ кезінде ваннаға баруды шештім.
Dialogue: 0,0:08:43.28,0:08:46.28,Default,,0000,0000,0000,,Бұл болады.
Dialogue: 0,0:08:47.15,0:08:49.15,Default,,0000,0000,0000,,Көріп тұрмын... өктем!
Dialogue: 0,0:08:52.79,0:08:55.29,Default,,0000,0000,0000,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:08:52.79,0:08:55.29,Rubi,,0000,0000,0000,,♬ Крестшілер жүре береді
Dialogue: 0,0:08:52.79,0:08:55.29,Rubi,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:08:52.79,0:08:55.29,Default,,0000,0000,0000,,Суды көп іш
Dialogue: 0,0:08:55.29,0:08:56.26,Default,,0000,0000,0000,,Хаа~
Dialogue: 0,0:08:56.26,0:09:00.26,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:08:56.26,0:09:00.26,Rubi,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:08:56.26,0:09:00.26,Default,,0000,0000,0000,,Әпке, мүмкін бүгін кешке.
Dialogue: 0,0:08:56.26,0:09:00.26,Default,,0000,0000,0000,,Жақсы нәрсе болуы мүмкін
Dialogue: 0,0:09:01.16,0:09:03.17,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:01.16,0:09:03.17,Default,,0000,0000,0000,,«Жақсы» деген не?
Dialogue: 0,0:09:03.17,0:09:06.80,Rubi,,0000,0000,0000,,Шинья
Dialogue: 0,0:09:03.17,0:09:06.80,Default,,0000,0000,0000,,Түнгі еңкай!
Dialogue: 0,0:09:06.80,0:09:09.30,Default,,0000,0000,0000,,Осыған ұқсас нәрсе
Dialogue: 0,0:09:06.80,0:09:09.30,Default,,0000,0000,0000,,Бұл барлық уақытта бола бермейді.
Dialogue: 0,0:09:09.30,0:09:13.80,Rubi,,0000,0000,0000,,Тауық
Dialogue: 0,0:09:09.30,0:09:13.80,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:09:09.30,0:09:13.80,Default,,0000,0000,0000,,Біртүрлі уақытта
Dialogue: 0,0:09:09.30,0:09:13.80,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:09:09.30,0:09:13.80,Default,,0000,0000,0000,,Дабылды орнатуды тоқтатыңыз.
Dialogue: 0,0:09:15.18,0:09:18.81,Default,,0000,0000,0000,,Мен сізге енді қоңырау шалмаймын
Dialogue: 0,0:09:15.18,0:09:18.81,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:09:15.18,0:09:18.81,Default,,0000,0000,0000,,Жарайды, әпке.
Dialogue: 0,0:09:18.81,0:09:22.32,Rubi,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:09:18.81,0:09:22.32,Default,,0000,0000,0000,,Бүгін түнде жақсы нәрселер болды.
Dialogue: 0,0:09:18.81,0:09:22.32,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:09:18.81,0:09:22.32,Default,,0000,0000,0000,,Мен сені оятпаймын.
Dialogue: 0,0:09:22.32,0:09:26.76,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:09:22.32,0:09:26.76,Rubi,,0000,0000,0000,,Аздап
Dialogue: 0,0:09:22.32,0:09:26.76,Default,,0000,0000,0000,,Мені оятудың қажеті жоқ.
Dialogue: 0,0:09:22.32,0:09:26.76,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:09:22.32,0:09:26.76,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:09:22.32,0:09:26.76,Default,,0000,0000,0000,,Маруконың оянуы мүмкін емес.
Dialogue: 0,0:09:26.76,0:09:27.72,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:09:27.72,0:09:30.63,Default,,0000,0000,0000,,Тексеріңіз!
Dialogue: 0,0:09:27.72,0:09:30.63,Rubi,,0000,0000,0000,,Нику
Dialogue: 0,0:09:27.72,0:09:30.63,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:09:27.72,0:09:30.63,Default,,0000,0000,0000,,Ол сондай жек көретін апа.
Dialogue: 0,0:09:30.63,0:09:34.26,Rubi,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:09:30.63,0:09:34.26,Default,,0000,0000,0000,,Егер бұл орын алса, мен жалғыз қаламын
Dialogue: 0,0:09:30.63,0:09:34.26,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:09:30.63,0:09:34.26,Default,,0000,0000,0000,,Мен саған той беремін.
Dialogue: 0,0:09:34.26,0:09:36.26,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:09:34.26,0:09:36.26,Default,,0000,0000,0000,,Неге мені оятып, бірдеңе істемейсің?
Dialogue: 0,0:09:37.77,0:09:40.67,Rubi,,0000,0000,0000,,Намида
Dialogue: 0,0:09:37.77,0:09:40.67,Rubi,,0000,0000,0000,,Дорёку
Dialogue: 0,0:09:37.77,0:09:40.67,Default,,0000,0000,0000,,<Көз жасын төгу
Dialogue: 0,0:09:37.77,0:09:40.67,Default,,0000,0000,0000,,Мару-чан болса да
Dialogue: 0,0:09:40.67,0:09:43.27,Rubi,,0000,0000,0000,,болып табылады
Dialogue: 0,0:09:40.67,0:09:43.27,Default,,0000,0000,0000,,Бұл шынымен солай ма?
Dialogue: 0,0:09:40.67,0:09:43.27,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:09:40.67,0:09:43.27,Default,,0000,0000,0000,,Сіз ояна аласыз ба...＞
Dialogue: 0,0:09:43.27,0:09:44.27,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:09:48.14,0:09:52.28,Default,,0000,0000,0000,,Уф, осындай нәрсе.
Dialogue: 0,0:09:48.14,0:09:52.28,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:09:48.14,0:09:52.28,Default,,0000,0000,0000,,Менің дәретханаға барғым келеді...
Dialogue: 0,0:09:52.28,0:09:55.18,Rubi,,0000,0000,0000,,Нему
Dialogue: 0,0:09:52.28,0:09:55.18,Default,,0000,0000,0000,,Хмм, мен ұйықтап жатырмын.
Dialogue: 0,0:09:52.28,0:09:55.18,Default,,0000,0000,0000,,Бұл ауыртпалық...
Dialogue: 0,0:09:55.18,0:09:59.15,Rubi,,0000,0000,0000,,Немесе
