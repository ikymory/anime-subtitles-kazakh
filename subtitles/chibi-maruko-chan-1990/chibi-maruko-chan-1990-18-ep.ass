Dialogue: 0,0:12:07.35,0:12:09.28,Rubi,,0000,0000,0000,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:12:07.35,0:12:09.28,Default,,0000,0000,0000,,Себебі әкең сені ұнататын шығар.
Dialogue: 0,0:12:09.28,0:12:11.85,Rubi,,0000,0000,0000,,Ядзима
Dialogue: 0,0:12:09.28,0:12:11.85,Default,,0000,0000,0000,,Ядзима мырза жолдан шығып кетті
Dialogue: 0,0:12:09.28,0:12:11.85,Rubi,,0000,0000,0000,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:12:09.28,0:12:11.85,Default,,0000,0000,0000,,Оны маған әкелді.
Dialogue: 0,0:12:11.85,0:12:15.72,Default,,0000,0000,0000,,Ата мен әже
Dialogue: 0,0:12:11.85,0:12:15.72,Rubi,,0000,0000,0000,,Кира
Dialogue: 0,0:12:11.85,0:12:15.72,Default,,0000,0000,0000,,Құсаяны бәрі жек көреді.
Dialogue: 0,0:12:15.72,0:12:18.36,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:12:15.72,0:12:18.36,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:12:15.72,0:12:18.36,Default,,0000,0000,0000,,(иіскеу дыбысы)
Dialogue: 0,0:12:15.72,0:12:18.36,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:12:15.72,0:12:18.36,Default,,0000,0000,0000,,Маған бұл иіс ұнамайды
Dialogue: 0,0:12:18.36,0:12:20.30,Rubi,,0000,0000,0000,,Энрио
Dialogue: 0,0:12:18.36,0:12:20.30,Default,,0000,0000,0000,,Дұрыс, олай істеуден аулақ болыңыз.
Dialogue: 0,0:12:20.30,0:12:23.23,Rubi,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:12:20.30,0:12:23.23,Default,,0000,0000,0000,,Барлығы ұйықтаған соң
Dialogue: 0,0:12:20.30,0:12:23.23,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:12:20.30,0:12:23.23,Default,,0000,0000,0000,,Мен оны жеймін деп шештім.
Dialogue: 0,0:12:23.23,0:12:26.80,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:12:23.23,0:12:26.80,Default,,0000,0000,0000,,Бұл өте ақымақ...
Dialogue: 0,0:12:26.80,0:12:28.30,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:12:26.80,0:12:28.30,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:12:26.80,0:12:28.30,Default,,0000,0000,0000,,Маруко, сен енді ғана ояндың.
Dialogue: 0,0:12:28.30,0:12:30.81,Rubi,,0000,0000,0000,,Тістеу
Dialogue: 0,0:12:28.30,0:12:30.81,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:12:28.30,0:12:30.81,Default,,0000,0000,0000,,Міне, тістеп ал. иә?
Dialogue: 0,0:12:28.30,0:12:30.81,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:12:30.81,0:12:32.31,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:12:30.81,0:12:32.31,Rubi,,0000,0000,0000,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:12:30.81,0:12:32.31,Default,,0000,0000,0000,,Үйреніп алсаң, құмарлыққа айналады.
Dialogue: 0,0:12:32.31,0:12:34.81,Default,,0000,0000,0000,,Құсая деген не?
Dialogue: 0,0:12:32.31,0:12:34.81,Default,,0000,0000,0000,,Міне, солай. Ха!
Dialogue: 0,0:12:34.81,0:12:38.31,Default,,0000,0000,0000,,<Осылайша
Dialogue: 0,0:12:34.81,0:12:38.31,Rubi,,0000,0000,0000,,Шинья
Dialogue: 0,0:12:34.81,0:12:38.31,Rubi,,0000,0000,0000,,Энкай
Dialogue: 0,0:12:34.81,0:12:38.31,Rubi,,0000,0000,0000,,Арман
Dialogue: 0,0:12:34.81,0:12:38.31,Rubi,,0000,0000,0000,,Чи
Dialogue: 0,0:12:34.81,0:12:38.31,Default,,0000,0000,0000,,Түнгі кеш арман болды>
Dialogue: 0,0:12:40.82,0:12:43.32,Default,,0000,0000,0000,,Мару-чан! Мару-чан!
Dialogue: 0,0:12:43.32,0:12:44.82,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:12:43.32,0:12:44.82,Default,,0000,0000,0000,,Бірнеше ауыр естеліктер қайтадан оралды, иә?
Dialogue: 0,0:12:44.82,0:12:47.32,Rubi,,0000,0000,0000,,Қорқынышты
Dialogue: 0,0:12:44.82,0:12:47.32,Rubi,,0000,0000,0000,,Мақсат
Dialogue: 0,0:12:44.82,0:12:47.32,Default,,0000,0000,0000,,Жоқ, сіз қорқынышты көрінесіз.
Dialogue: 0,0:12:47.32,0:12:50.83,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:12:47.32,0:12:50.83,Rubi,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,0:12:47.32,0:12:50.83,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:12:47.32,0:12:50.83,Default,,0000,0000,0000,,Мен бүгінгі кино кешін асыға күтемін.
Dialogue: 0,0:12:47.32,0:12:50.83,Default,,0000,0000,0000,,Бұл аниме
Dialogue: 0,0:12:50.83,0:12:53.33,Default,,0000,0000,0000,,Хмм, дұрыс.
Dialogue: 0,0:12:53.33,0:12:57.33,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:12:53.33,0:12:57.33,Default,,0000,0000,0000,,《Иә! Бүгін
Dialogue: 0,0:12:53.33,0:12:57.33,Rubi,,0000,0000,0000,,Ағылшын тілін оқыту
Dialogue: 0,0:12:53.33,0:12:57.33,Default,,0000,0000,0000,,Кино көру кеші болды》
Dialogue: 0,0:12:58.83,0:13:00.34,Rubi,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,0:12:58.83,0:13:00.34,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:12:58.83,0:13:00.34,Rubi,,0000,0000,0000,,На
Dialogue: 0,0:12:58.83,0:13:00.34,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:12:58.83,0:13:00.34,Default,,0000,0000,0000,,(фильм: ит үруі)
Dialogue: 0,0:13:00.34,0:13:02.84,Default,,0000,0000,0000,,<Мару-чан бұл
Dialogue: 0,0:13:00.34,0:13:02.84,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:13:00.34,0:13:02.84,Rubi,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,0:13:00.34,0:13:02.84,Default,,0000,0000,0000,,Мен асыға күткен кино кеші
Dialogue: 0,0:13:02.84,0:13:05.34,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:13:02.84,0:13:05.34,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:13:02.84,0:13:05.34,Default,,0000,0000,0000,,Бүгінгі күнді мүлде ұмыттым.
Dialogue: 0,0:13:05.34,0:13:08.84,Rubi,,0000,0000,0000,,Йофу
Dialogue: 0,0:13:05.34,0:13:08.84,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:13:05.34,0:13:08.84,Default,,0000,0000,0000,,Мен Юбеде кеш тұрғаныма өкінемін.
Dialogue: 0,0:13:05.34,0:13:08.84,Rubi,,0000,0000,0000,,Мацу
Dialogue: 0,0:13:05.34,0:13:08.84,Default,,0000,0000,0000,,Кейінірек фестивальде
Dialogue: 0,0:13:08.84,0:13:13.72,Rubi,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,0:13:08.84,0:13:13.72,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:13:08.84,0:13:13.72,Rubi,,0000,0000,0000,,Әдетте адамдар өз-өзімен
Dialogue: 0,0:13:08.84,0:13:13.72,Rubi,,0000,0000,0000,,Шабуыл
Dialogue: 0,0:13:08.84,0:13:13.72,Default,,0000,0000,0000,,Киноның үні және күлкі
Dialogue: 0,0:13:08.84,0:13:13.72,Rubi,,0000,0000,0000,,Комори әні
Dialogue: 0,0:13:08.84,0:13:13.72,Default,,0000,0000,0000,,Олардың барлығы бесік жыры болды＞
Dialogue: 0,0:13:13.72,0:13:17.85,Default,,0000,0000,0000,,Жетер, Құсая жақсы...
Dialogue: 0,0:13:13.72,0:13:17.85,Default,,0000,0000,0000,,Құсая жақсы
Dialogue: 0,0:13:17.85,0:13:19.79,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:13:17.85,0:13:19.79,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:19.79,0:13:22.72,Rubi,,0000,0000,0000,,Ағылшын тілі
Dialogue: 0,0:13:19.79,0:13:22.72,Default,,0000,0000,0000,,<Кино кеші
Dialogue: 0,0:13:19.79,0:13:22.72,Rubi,,0000,0000,0000,,Акум
Dialogue: 0,0:13:19.79,0:13:22.72,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:13:19.79,0:13:22.72,Default,,0000,0000,0000,,Құсаяның түнгі түнімен айырбасталды
Dialogue: 0,0:13:22.72,0:13:24.73,Default,,0000,0000,0000,,Бұл Мару-чан＞ болды
Dialogue: 0,0:13:24.73,0:13:26.73,Default,,0000,0000,0000,,Құсая жақсы!
Dialogue: 0,0:15:42.86,0:15:45.77,Rubi,,0000,0000,0000,,Юбива
Dialogue: 0,0:15:42.86,0:15:45.77,Default,,0000,0000,0000,,<Бұл сақина
Dialogue: 0,0:15:42.86,0:15:45.77,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:15:42.86,0:15:45.77,Default,,0000,0000,0000,,Мару-чанның анасы
Dialogue: 0,0:15:45.77,0:15:48.37,Rubi,,0000,0000,0000,,Мусумеджидай
Dialogue: 0,0:15:45.77,0:15:48.37,Default,,0000,0000,0000,,Қыз кезімде
Dialogue: 0,0:15:45.77,0:15:48.37,Rubi,,0000,0000,0000,,Жеңіл
Dialogue: 0,0:15:45.77,0:15:48.37,Rubi,,0000,0000,0000,,Недан
Dialogue: 0,0:15:45.77,0:15:48.37,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:15:45.77,0:15:48.37,Default,,0000,0000,0000,,Мен оны арзан бағаға сатып алдым.
Dialogue: 0,0:15:48.37,0:15:52.87,Rubi,,0000,0000,0000,,Басымдық
Dialogue: 0,0:15:48.37,0:15:52.87,Rubi,,0000,0000,0000,,Игай
Dialogue: 0,0:15:48.37,0:15:52.87,Default,,0000,0000,0000,,Соңғы уақытта бұл таңқаларлық болды
Dialogue: 0,0:15:48.37,0:15:52.87,Rubi,,0000,0000,0000,,...
Dialogue: 0,0:15:48.37,0:15:52.87,Rubi,,0000,0000,0000,,Ханмей
Dialogue: 0,0:15:48.37,0:15:52.87,Default,,0000,0000,0000,,Қымбат болып шықты
Dialogue: 0,0:15:52.87,0:15:57.75,Rubi,,0000,0000,0000,,кенеттен маңызды
Dialogue: 0,0:15:52.87,0:15:57.75,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:15:52.87,0:15:57.75,Default,,0000,0000,0000,,Кенеттен адамдар оларды бағалай бастады.
Dialogue: 0,0:15:52.87,0:15:57.75,Rubi,,0000,0000,0000,,Тана
Dialogue: 0,0:15:52.87,0:15:57.75,Rubi,,0000,0000,0000,,Мочи
Dialogue: 0,0:15:52.87,0:15:57.75,Default,,0000,0000,0000,,«Сөредегі ботамочи сақинасы»＞
Dialogue: 0,0:15:57.75,0:16:00.38,Default,,0000,0000,0000,,Бұл өте әдемі.
Dialogue: 0,0:16:00.38,0:16:03.28,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:16:00.38,0:16:03.28,Default,,0000,0000,0000,,Ол опал деп аталады.
Dialogue: 0,0:16:00.38,0:16:03.28,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:16:03.28,0:16:07.26,Rubi,,0000,0000,0000,,Жарық
Dialogue: 0,0:16:03.28,0:16:07.26,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:16:03.28,0:16:07.26,Default,,0000,0000,0000,,Осылай жарық әсер еткенде
Dialogue: 0,0:16:03.28,0:16:07.26,Rubi,,0000,0000,0000,,Түс
Dialogue: 0,0:16:03.28,0:16:07.26,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:16:03.28,0:16:07.26,Default,,0000,0000,0000,,Түрлі түстерге ұқсайды
Dialogue: 0,0:16:07.26,0:16:08.89,Rubi,,0000,0000,0000,,Арман
Dialogue: 0,0:16:07.26,0:16:08.89,Default,,0000,0000,0000,,Бұл арман сияқты
Dialogue: 0,0:16:08.89,0:16:10.39,Default,,0000,0000,0000,,Хехехе
Dialogue: 0,0:16:10.39,0:16:13.29,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:16:10.39,0:16:13.29,Rubi,,0000,0000,0000,,Көпшілігі
Dialogue: 0,0:16:10.39,0:16:13.29,Rubi,,0000,0000,0000,,Қазына
Dialogue: 0,0:16:10.39,0:16:13.29,Default,,0000,0000,0000,,Бұл сіздің анаңыздың ең үлкен қазынасы, солай ма?
Dialogue: 0,0:16:13.29,0:16:15.90,Default,,0000,0000,0000,,Хехехе солай деп ойлаймын~
Dialogue: 0,0:16:15.90,0:16:18.80,Rubi,,0000,0000,0000,,Көпшілігі
Dialogue: 0,0:16:15.90,0:16:18.80,Rubi,,0000,0000,0000,,Қазына
Dialogue: 0,0:16:15.90,0:16:18.80,Default,,0000,0000,0000,,Ең үлкен қазына
Dialogue: 0,0:16:15.90,0:16:18.80,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:16:15.90,0:16:18.80,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:16:15.90,0:16:18.80,Default,,0000,0000,0000,,Маруко және оның әпкесі
Dialogue: 0,0:16:18.80,0:16:22.34,Default,,0000,0000,0000,,Рас! Уау мен сондай бақыттымын
Dialogue: 0,0:16:18.80,0:16:22.34,Rubi,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:16:18.80,0:16:22.34,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:16:18.80,0:16:22.34,Default,,0000,0000,0000,,Мені есіңде бар ғой, иә?
Dialogue: 0,0:16:22.34,0:16:24.84,Rubi,,0000,0000,0000,,Тайсецу
Dialogue: 0,0:16:22.34,0:16:24.84,Rubi,,0000,0000,0000,,Юбива
Dialogue: 0,0:16:22.34,0:16:24.84,Default,,0000,0000,0000,,Енді сол қымбат сақина.
Dialogue: 0,0:16:22.34,0:16:24.84,Default,,0000,0000,0000,,Оны қояйық.
Dialogue: 0,0:16:24.84,0:16:27.34,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:16:24.84,0:16:27.34,Default,,0000,0000,0000,,Иә, бұл жақсы.
Dialogue: 0,0:16:27.34,0:16:29.84,Rubi,,0000,0000,0000,,Даидзи
Dialogue: 0,0:16:27.34,0:16:29.84,Default,,0000,0000,0000,,Дұрыс, біз оған қамқорлық жасауымыз керек.
Dialogue: 0,0:16:29.84,0:16:32.75,Rubi,,0000,0000,0000,,Бөтелке
Dialogue: 0,0:16:29.84,0:16:32.75,Default,,0000,0000,0000,,Біз кедейленіп барамыз
Dialogue: 0,0:16:29.84,0:16:32.75,Rubi,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:16:29.84,0:16:32.75,Rubi,,0000,0000,0000,,Жоғарғы
Dialogue: 0,0:16:29.84,0:16:32.75,Default,,0000,0000,0000,,Тамақтану қиын болса
Dialogue: 0,0:16:32.75,0:16:35.72,Rubi,,0000,0000,0000,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:16:32.75,0:16:35.72,Rubi,,0000,0000,0000,,Қауіпсіздік
Dialogue: 0,0:16:32.75,0:16:35.72,Default,,0000,0000,0000,,Бұл затты сату туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:16:35.72,0:16:39.85,Rubi,,0000,0000,0000,,Ылғау
Dialogue: 0,0:16:35.72,0:16:39.85,Default,,0000,0000,0000,,Хехехе, бұл оңай емес.
Dialogue: 0,0:16:35.72,0:16:39.85,Rubi,,0000,0000,0000,,Генкин
Dialogue: 0,0:16:35.72,0:16:39.85,Default,,0000,0000,0000,,Оны қолма-қол ақшаға айналдыру мүмкін болмаса да.
Dialogue: 0,0:16:39.85,0:16:43.73,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:16:39.85,0:16:43.73,Rubi,,0000,0000,0000,,Йоме
Dialogue: 0,0:16:39.85,0:16:43.73,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:16:39.85,0:16:43.73,Default,,0000,0000,0000,,Эй, Маруко үйленуге кеткенде
Dialogue: 0,0:16:39.85,0:16:43.73,Rubi,,0000,0000,0000,,Юбива
Dialogue: 0,0:16:39.85,0:16:43.73,Default,,0000,0000,0000,,Мына сақинаны маған беріңіз
Dialogue: 0,0:16:43.73,0:16:47.73,Default,,0000,0000,0000,,Хм, мен не істеуім керек?
Dialogue: 0,0:16:43.73,0:16:47.73,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:16:43.73,0:16:47.73,Default,,0000,0000,0000,,Менің де үлкен әпкем бар.
Dialogue: 0,0:16:47.73,0:16:50.37,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:16:47.73,0:16:50.37,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:16:47.73,0:16:50.37,Default,,0000,0000,0000,,Оны Марукоға беріңіз
Dialogue: 0,0:16:50.37,0:16:52.30,Rubi,,0000,0000,0000,,Эй
Dialogue: 0,0:16:50.37,0:16:52.30,Default,,0000,0000,0000,,Әпкеңе олай жасама!
Dialogue: 0,0:16:52.30,0:16:54.87,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
