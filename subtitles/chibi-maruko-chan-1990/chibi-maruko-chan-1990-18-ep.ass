Dialogue: 0,0:19:23.18,0:19:25.82,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:19:23.18,0:19:25.82,Default,,0000,0000,0000,,Хехе, сен не істейсің?
Dialogue: 0,0:19:25.82,0:19:28.32,Rubi,,0000,0000,0000,,Әке
Dialogue: 0,0:19:25.82,0:19:28.32,Default,,0000,0000,0000,,Әйелді ойнаймыз ба?
Dialogue: 0,0:19:25.82,0:19:28.32,Default,,0000,0000,0000,,Мынаны істейік Мынаны істейік
Dialogue: 0,0:19:28.32,0:19:31.23,Default,,0000,0000,0000,,Мен және Тама-чан
Dialogue: 0,0:19:28.32,0:19:31.23,Rubi,,0000,0000,0000,,Канемо
Dialogue: 0,0:19:28.32,0:19:31.23,Rubi,,0000,0000,0000,,Әке
Dialogue: 0,0:19:28.32,0:19:31.23,Default,,0000,0000,0000,,Ол байдың әйелі.
Dialogue: 0,0:19:31.23,0:19:34.20,Rubi,,0000,0000,0000,,Әке
Dialogue: 0,0:19:31.23,0:19:34.20,Default,,0000,0000,0000,,<Әйелі ойнау ше?
Dialogue: 0,0:19:31.23,0:19:34.20,Rubi,,0000,0000,0000,,Юукан
Dialogue: 0,0:19:31.23,0:19:34.20,Rubi,,0000,0000,0000,,Ничихо
Dialogue: 0,0:19:31.23,0:19:34.20,Default,,0000,0000,0000,,Жайбарақат ханымның күнделікті өмірі
Dialogue: 0,0:19:34.20,0:19:37.83,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:19:34.20,0:19:37.83,Rubi,,0000,0000,0000,,Жасау
Dialogue: 0,0:19:34.20,0:19:37.83,Default,,0000,0000,0000,,Баланың көзқарасы бойынша
Dialogue: 0,0:19:34.20,0:19:37.83,Rubi,,0000,0000,0000,,Бір рет
Dialogue: 0,0:19:34.20,0:19:37.83,Rubi,,0000,0000,0000,,Асо
Dialogue: 0,0:19:34.20,0:19:37.83,Default,,0000,0000,0000,,Бұл менің өз қолыммен түсірген пьеса ғана.＞
Dialogue: 0,0:19:37.83,0:19:39.33,Default,,0000,0000,0000,,Хохохохохо
Dialogue: 0,0:19:39.33,0:19:42.24,Default,,0000,0000,0000,,Охохохо
Dialogue: 0,0:19:42.24,0:19:45.84,Rubi,,0000,0000,0000,,Әке
Dialogue: 0,0:19:42.24,0:19:45.84,Default,,0000,0000,0000,,Сәлем, ханым
Dialogue: 0,0:19:42.24,0:19:45.84,Rubi,,0000,0000,0000,,Шудзин
Dialogue: 0,0:19:42.24,0:19:45.84,Default,,0000,0000,0000,,Менің қожайыным
Dialogue: 0,0:19:45.84,0:19:48.74,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:19:45.84,0:19:48.74,Default,,0000,0000,0000,,Шалбарыңызды дереу ауыстырыңыз
Dialogue: 0,0:19:45.84,0:19:48.74,Rubi,,0000,0000,0000,,Васу
Dialogue: 0,0:19:45.84,0:19:48.74,Default,,0000,0000,0000,,Ұмытпа
Dialogue: 0,0:19:48.74,0:19:53.72,Rubi,,0000,0000,0000,,Она
Dialogue: 0,0:19:48.74,0:19:53.72,Default,,0000,0000,0000,,Барлық жерде бірдей.
Dialogue: 0,0:19:48.74,0:19:53.72,Rubi,,0000,0000,0000,,Жоқ
Dialogue: 0,0:19:48.74,0:19:53.72,Default,,0000,0000,0000,,Охохохо... Маған ұнамайды.
Dialogue: 0,0:19:53.72,0:19:58.35,Rubi,,0000,0000,0000,,Әке
Dialogue: 0,0:19:53.72,0:19:58.35,Default,,0000,0000,0000,,＜Егер сіз әйелді ойнауға тырыссаңыз да,
Dialogue: 0,0:19:53.72,0:19:58.35,Rubi,,0000,0000,0000,,Сейкацу Суиджун
Dialogue: 0,0:19:53.72,0:19:58.35,Rubi,,0000,0000,0000,,Алу
Dialogue: 0,0:19:53.72,0:19:58.35,Default,,0000,0000,0000,,Өйткені өмір сүру деңгейі төмен
Dialogue: 0,0:19:58.35,0:20:00.35,Rubi,,0000,0000,0000,,Кайва
Dialogue: 0,0:19:58.35,0:20:00.35,Rubi,,0000,0000,0000,,Тейзоку
Dialogue: 0,0:19:58.35,0:20:00.35,Default,,0000,0000,0000,,Әңгімелесу де дөрекі>
Dialogue: 0,0:20:01.26,0:20:04.23,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:20:01.26,0:20:04.23,Default,,0000,0000,0000,,Менің балам ше?
Dialogue: 0,0:20:01.26,0:20:04.23,Rubi,,0000,0000,0000,,Жынға қалай сенуге болады!!
Dialogue: 0,0:20:01.26,0:20:04.23,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:20:01.26,0:20:04.23,Default,,0000,0000,0000,,ебедейсіз және жалқау
Dialogue: 0,0:20:04.23,0:20:06.23,Default,,0000,0000,0000,,Менің мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:20:06.23,0:20:08.36,Default,,0000,0000,0000,,О, мен өте өтірік айтамын
Dialogue: 0,0:20:08.36,0:20:12.23,Default,,0000,0000,0000,,Себебі, мұны нервтердің қолынан келеді.
Dialogue: 0,0:20:08.36,0:20:12.23,Rubi,,0000,0000,0000,,Урая
Dialogue: 0,0:20:08.36,0:20:12.23,Default,,0000,0000,0000,,Мен қызғанамын
Dialogue: 0,0:20:12.23,0:20:15.87,Default,,0000,0000,0000,,Уфуфу иә.
Dialogue: 0,0:20:12.23,0:20:15.87,Rubi,,0000,0000,0000,,Әке
Dialogue: 0,0:20:12.23,0:20:15.87,Default,,0000,0000,0000,,Әйеліңіз туралы аздап
Dialogue: 0,0:20:15.87,0:20:18.77,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:20:15.87,0:20:18.77,Default,,0000,0000,0000,,Нені көру керек
Dialogue: 0,0:20:15.87,0:20:18.77,Default,,0000,0000,0000,,Бірдеңе болып жатыр.
Dialogue: 0,0:20:18.77,0:20:22.31,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:20:18.77,0:20:22.31,Default,,0000,0000,0000,,Әй, не болып жатыр?
Dialogue: 0,0:20:18.77,0:20:22.31,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:20:18.77,0:20:22.31,Default,,0000,0000,0000,,Мен оны асыға күтемін.
Dialogue: 0,0:20:22.31,0:20:24.25,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:20:24.25,0:20:28.18,Rubi,,0000,0000,0000,,Хауски
Dialogue: 0,0:20:24.25,0:20:28.18,Default,,0000,0000,0000,,О, қандай керемет асыл тас.
Dialogue: 0,0:20:24.25,0:20:28.18,Rubi,,0000,0000,0000,,Така
Dialogue: 0,0:20:24.25,0:20:28.18,Default,,0000,0000,0000,,Қымбат емес пе еді?
Dialogue: 0,0:20:28.18,0:20:29.82,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:20:28.18,0:20:29.82,Rubi,,0000,0000,0000,,Па
Dialogue: 0,0:20:28.18,0:20:29.82,Default,,0000,0000,0000,,Аа, бұл аздап ұят болды.
Dialogue: 0,0:20:29.82,0:20:33.69,Rubi,,0000,0000,0000,,Шудзин
Dialogue: 0,0:20:29.82,0:20:33.69,Rubi,,0000,0000,0000,,Гонконг
Dialogue: 0,0:20:29.82,0:20:33.69,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:20:29.82,0:20:33.69,Default,,0000,0000,0000,,Менің күйеуім оны Гонконгтан сатып алды.
Dialogue: 0,0:20:29.82,0:20:33.69,Rubi,,0000,0000,0000,,Ясумоно
Dialogue: 0,0:20:29.82,0:20:33.69,Default,,0000,0000,0000,,Бұл арзан.
Dialogue: 0,0:20:33.69,0:20:36.32,Rubi,,0000,0000,0000,,Манен
Dialogue: 0,0:20:33.69,0:20:36.32,Default,,0000,0000,0000,,Бар болғаны 5 миллион иен
Dialogue: 0,0:20:36.32,0:20:37.83,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:37.83,0:20:39.76,Default,,0000,0000,0000,,Охохохо
Dialogue: 0,0:20:39.76,0:20:43.33,Rubi,,0000,0000,0000,,Әке
Dialogue: 0,0:20:39.76,0:20:43.33,Rubi,,0000,0000,0000,,Шудзин
Dialogue: 0,0:20:39.76,0:20:43.33,Default,,0000,0000,0000,,Әйелі де күйеуінен сұрайды
Dialogue: 0,0:20:39.76,0:20:43.33,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:20:39.76,0:20:43.33,Default,,0000,0000,0000,,Сатып алыңыз.
Dialogue: 0,0:20:43.33,0:20:44.83,Default,,0000,0000,0000,,Біз мұны істейміз бе?
Dialogue: 0,0:20:44.83,0:20:46.33,Default,,0000,0000,0000,,Охохохо
Dialogue: 0,0:20:44.83,0:20:46.33,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:20:44.83,0:20:46.33,Default,,0000,0000,0000,,...
Dialogue: 0,0:20:46.33,0:20:47.30,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:47.30,0:20:49.24,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:20:47.30,0:20:49.24,Rubi,,0000,0000,0000,,Юбива
Dialogue: 0,0:20:47.30,0:20:49.24,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:20:47.30,0:20:49.24,Default,,0000,0000,0000,,Бұл сенің анаң. Сақинаны жасыр!
Dialogue: 0,0:20:49.24,0:20:50.84,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:20:50.84,0:20:52.34,Default,,0000,0000,0000,,Тағам
Dialogue: 0,0:20:52.34,0:20:55.84,Rubi,,0000,0000,0000,,Genmu
Dialogue: 0,0:20:52.34,0:20:55.84,Rubi,,0000,0000,0000,,Әке
Dialogue: 0,0:20:52.34,0:20:55.84,Default,,0000,0000,0000,,Әй, әйел үш үй төмен.
Dialogue: 0,0:20:55.84,0:20:59.35,Rubi,,0000,0000,0000,,Шуджин
Dialogue: 0,0:20:55.84,0:20:59.35,Default,,0000,0000,0000,,Отакудың күйеуі Хироши
Dialogue: 0,0:20:55.84,0:20:59.35,Default,,0000,0000,0000,,Сіз сондай бейқам көрінесіз.
Dialogue: 0,0:20:59.35,0:21:00.85,Rubi,,0000,0000,0000,,Сева
Dialogue: 0,0:20:59.35,0:21:00.85,Default,,0000,0000,0000,,Көмегің үшін көп рахмет.
Dialogue: 0,0:21:02.25,0:21:05.22,Default,,0000,0000,0000,,Бұл дәмді
Dialogue: 0,0:21:05.22,0:21:08.86,Rubi,,0000,0000,0000,,Genmu
Dialogue: 0,0:21:05.22,0:21:08.86,Rubi,,0000,0000,0000,,Әке
Dialogue: 0,0:21:05.22,0:21:08.86,Default,,0000,0000,0000,,Әйел үш үй ғана қалды!
Dialogue: 0,0:21:08.86,0:21:11.36,Default,,0000,0000,0000,,Қосымша
Dialogue: 0,0:21:08.86,0:21:11.36,Default,,0000,0000,0000,,Мен той алғым келеді.
Dialogue: 0,0:21:11.36,0:21:15.86,Default,,0000,0000,0000,,Мен қазір кеттім
Dialogue: 0,0:21:11.36,0:21:15.86,Default,,0000,0000,0000,,Хмм, Икезузамасу
Dialogue: 0,0:21:15.86,0:21:20.37,Rubi,,0000,0000,0000,,Өте
Dialogue: 0,0:21:15.86,0:21:20.37,Default,,0000,0000,0000,,О, бұл қорқынышты!
Dialogue: 0,0:21:15.86,0:21:20.37,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:21:15.86,0:21:20.37,Rubi,,0000,0000,0000,,Мукка
Dialogue: 0,0:21:15.86,0:21:20.37,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:21:15.86,0:21:20.37,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:21:15.86,0:21:20.37,Default,,0000,0000,0000,,Баланы алып кететін кез келді.
Dialogue: 0,0:21:20.37,0:21:24.24,Default,,0000,0000,0000,,Охохохохо, біз ше?
Dialogue: 0,0:21:20.37,0:21:24.24,Default,,0000,0000,0000,,Үйдегі көмекші Себастьянға
Dialogue: 0,0:21:24.24,0:21:27.18,Rubi,,0000,0000,0000,,Барлығы
Dialogue: 0,0:21:24.24,0:21:27.18,Rubi,,0000,0000,0000,,Мака
Dialogue: 0,0:21:24.24,0:21:27.18,Default,,0000,0000,0000,,Барлығы өзіңізге байланысты.
Dialogue: 0,0:21:24.24,0:21:27.18,Rubi,,0000,0000,0000,,Қауіпсіздік
Dialogue: 0,0:21:24.24,0:21:27.18,Default,,0000,0000,0000,,Мен өзімді қауіпсіз сезінемін.
Dialogue: 0,0:21:27.18,0:21:29.18,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:21:27.18,0:21:29.18,Default,,0000,0000,0000,,<Бұл кім?>
Dialogue: 0,0:21:27.18,0:21:29.18,Default,,0000,0000,0000,,Охохохо
Dialogue: 0,0:21:31.81,0:21:33.75,Rubi,,0000,0000,0000,,Бүгін
Dialogue: 0,0:21:31.81,0:21:33.75,Default,,0000,0000,0000,,Аа, бүгінгі күн қызық болды.
Dialogue: 0,0:21:33.75,0:21:36.68,Rubi,,0000,0000,0000,,Асо
Dialogue: 0,0:21:33.75,0:21:36.68,Default,,0000,0000,0000,,Иә, тағы да ойнайық.
Dialogue: 0,0:21:33.75,0:21:36.68,Default,,0000,0000,0000,,Иә, сау болыңыз
Dialogue: 0,0:21:36.68,0:21:39.32,Default,,0000,0000,0000,,Ол айналып өткеннен кейін әлсіз жақтарымнан шағын соққылар береді.
Dialogue: 0,0:21:36.68,0:21:39.32,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:21:36.68,0:21:39.32,Rubi,,0000,0000,0000,,Хира
Dialogue: 0,0:21:36.68,0:21:39.32,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:21:36.68,0:21:39.32,Default,,0000,0000,0000,,()
Dialogue: 0,0:21:39.32,0:21:41.82,Default,,0000,0000,0000,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:21:39.32,0:21:41.82,Default,,0000,0000,0000,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:21:41.82,0:21:44.73,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:21:41.82,0:21:44.73,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:21:41.82,0:21:44.73,Rubi,,0000,0000,0000,,Бөлме
Dialogue: 0,0:21:41.82,0:21:44.73,Default,,0000,0000,0000,,Маруконың анасының бөлмесі
Dialogue: 0,0:21:41.82,0:21:44.73,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:21:41.82,0:21:44.73,Default,,0000,0000,0000,,Тазалау.
Dialogue: 0,0:21:44.73,0:21:46.69,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:44.73,0:21:46.69,Rubi,,0000,0000,0000,,♬ Іздейтін жеріміз қандай?
Dialogue: 0,0:21:44.73,0:21:46.69,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:21:44.73,0:21:46.69,Default,,0000,0000,0000,,Оны өзіңіз тазалаңыз.
Dialogue: 0,0:21:46.69,0:21:49.33,Rubi,,0000,0000,0000,,Нику
Dialogue: 0,0:21:46.69,0:21:49.33,Rubi,,0000,0000,0000,,Құдайлар
Dialogue: 0,0:21:46.69,0:21:49.33,Default,,0000,0000,0000,,Хмм, мен сені жек көремін.
Dialogue: 0,0:21:49.33,0:21:52.23,Rubi,,0000,0000,0000,,Жалаңаш
Dialogue: 0,0:21:49.33,0:21:52.23,Rubi,,0000,0000,0000,,Чи
Dialogue: 0,0:21:49.33,0:21:52.23,Default,,0000,0000,0000,,Сіз үлкен тәртіпсіздік жасадыңыз.
Dialogue: 0,0:21:49.33,0:21:52.23,Default,,0000,0000,0000,,Міне, осы
Dialogue: 0,0:21:52.23,0:21:54.20,Default,,0000,0000,0000,,Бұл азап.
Dialogue: 0,0:21:54.20,0:21:58.34,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:21:54.20,0:21:58.34,Rubi,,0000,0000,0000,,Юбива
Dialogue: 0,0:21:54.20,0:21:58.34,Default,,0000,0000,0000,,Ах! ананың сақинасы
Dialogue: 0,0:21:54.20,0:21:58.34,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:21:54.20,0:21:58.34,Default,,0000,0000,0000,,Мен оны тезірек тастауым керек.
Dialogue: 0,0:21:58.34,0:22:00.84,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:21:58.34,0:22:00.84,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:21:58.34,0:22:00.84,Default,,0000,0000,0000,,Есіңе түскеніне қуаныштымын.
Dialogue: 0,0:22:00.84,0:22:05.35,Rubi,,0000,0000,0000,,Таши
Dialogue: 0,0:22:00.84,0:22:05.35,Rubi,,0000,0000,0000,,Тауық
Dialogue: 0,0:22:00.84,0:22:05.35,Default,,0000,0000,0000,,Менің ойымша, бұл осы жерде...
Dialogue: 0,0:22:00.84,0:22:05.35,Default,,0000,0000,0000,,Бұл жерде жоқ.
Dialogue: 0,0:22:05.35,0:22:07.28,Default,,0000,0000,0000,,Бұл біртүрлі...
Dialogue: 0,0:22:07.28,0:22:09.85,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:22:09.85,0:22:12.35,Default,,0000,0000,0000,,А... жоқ!
Dialogue: 0,0:22:12.35,0:22:15.85,Default,,0000,0000,0000,,Жоқ, жоқ! иә?
Dialogue: 0,0:22:16.86,0:22:18.79,Default,,0000,0000,0000,,Мен саған кір жудым.
Dialogue: 0,0:22:18.79,0:22:20.79,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:22:21.70,0:22:23.66,Rubi,,0000,0000,0000,,О.
Dialogue: 0,0:22:21.70,0:22:23.66,Rubi,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:22:21.70,0:22:23.66,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:22:21.70,0:22:23.66,Default,,0000,0000,0000,,Тыныштанып, ойланып көрейік
Dialogue: 0,0:22:23.66,0:22:25.30,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:22:23.66,0:22:25.30,Default,,0000,0000,0000,,Бір нәрсені жоғалтқанда
Dialogue: 0,0:22:25.30,0:22:28.80,Rubi,,0000,0000,0000,,Бір көршім айтып еді…
Dialogue: 0,0:22:25.30,0:22:28.80,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:22:25.30,0:22:28.80,Default,,0000,0000,0000,,Қайшыға жіпті орау кезінде
Dialogue: 0,0:22:25.30,0:22:28.80,Rubi,,0000,0000,0000,,Суару
Dialogue: 0,0:22:25.30,0:22:28.80,Rubi,,0000,0000,0000,,Бүгін той күні болады.
Dialogue: 0,0:22:25.30,0:22:28.80,Rubi,,0000,0000,0000,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:22:25.30,0:22:28.80,Default,,0000,0000,0000,,Осыны ойласам есіме түседі.
Dialogue: 0,0:22:28.80,0:22:30.30,Rubi,,0000,0000,0000,,Қазір
Dialogue: 0,0:22:28.80,0:22:30.30,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:22:28.80,0:22:30.30,Default,,0000,0000,0000,,Біреуден сұрады
Dialogue: 0,0:22:30.30,0:22:33.81,Rubi,,0000,0000,0000,,Қазір
Dialogue: 0,0:22:30.30,0:22:33.81,Default,,0000,0000,0000,,<Осындай ақымақтықты кім жасайды?
Dialogue: 0,0:22:30.30,0:22:33.81,Rubi,,0000,0000,0000,,Оши
Dialogue: 0,0:22:30.30,0:22:33.81,Default,,0000,0000,0000,,Сіз маған үйреткен шығарсыз>
Dialogue: 0,0:22:33.81,0:22:35.31,Default,,0000,0000,0000,,Спорттық костюмім мен кроссовкаларым мінсіз күйде, бір жыртығы да жоқ.
Dialogue: 0,0:22:35.31,0:22:38.81,Rubi,,0000,0000,0000,,Көрініс
Dialogue: 0,0:22:35.31,0:22:38.81,Rubi,,0000,0000,0000,,Мына мұз жігітке қарашы—
Dialogue: 0,0:22:35.31,0:22:38.81,Default,,0000,0000,0000,,<Әрине, осылай
Dialogue: 0,0:22:35.31,0:22:38.81,Rubi,,0000,0000,0000,,Сынықтар
Dialogue: 0,0:22:35.31,0:22:38.81,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:22:35.31,0:22:38.81,Default,,0000,0000,0000,,Жоғалған заттар табылды
Dialogue: 0,0:22:38.81,0:22:40.31,Rubi,,0000,0000,0000,,Бір рет
Dialogue: 0,0:22:38.81,0:22:40.31,Default,,0000,0000,0000,,Бұрын-соңды болмаған>
Dialogue: 0,0:22:40.31,0:22:41.82,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:40.31,0:22:41.82,Default,,0000,0000,0000,,...
Dialogue: 0,0:22:40.31,0:22:41.82,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:22:41.82,0:22:44.32,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:22:41.82,0:22:44.32,Default,,0000,0000,0000,,Не істеп жүрсің?
Dialogue: 0,0:22:41.82,0:22:44.32,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:22:41.82,0:22:44.32,Default,,0000,0000,0000,,Анашым
Dialogue: 0,0:22:44.32,0:22:48.19,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:22:44.32,0:22:48.19,Rubi,,0000,0000,0000,,Ең маңыздысы
Dialogue: 0,0:22:44.32,0:22:48.19,Rubi,,0000,0000,0000,,Қазына
Dialogue: 0,0:22:44.32,0:22:48.19,Default,,0000,0000,0000,,Сенің анаңның ең басты байлығы қандай?
Dialogue: 0,0:22:44.32,0:22:48.19,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:44.32,0:22:48.19,Default,,0000,0000,0000,,Ол менің балам, солай ма?
Dialogue: 0,0:22:48.19,0:22:50.19,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:22:48.19,0:22:50.19,Default,,0000,0000,0000,,Иә, неге?
Dialogue: 0,0:22:50.19,0:22:51.83,Default,,0000,0000,0000,,(Экипаж мүшесі 1) Жұмысты жалғастырып, қазынаны көрсекші.
Dialogue: 0,0:22:51.83,0:22:54.33,Rubi,,0000,0000,0000,,Нибанме
Dialogue: 0,0:22:51.83,0:22:54.33,Default,,0000,0000,0000,,Екіншісі кетсе де
Dialogue: 0,0:22:51.83,0:22:54.33,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:22:51.83,0:22:54.33,Default,,0000,0000,0000,,Жарайды, солай ма?
Dialogue: 0,0:22:54.33,0:22:56.26,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:56.26,0:22:57.83,Default,,0000,0000,0000,,Жоқ, ол жоғалды.
Dialogue: 0,0:22:57.83,0:23:00.33,Rubi,,0000,0000,0000,,Юбива
Dialogue: 0,0:22:57.83,0:23:00.33,Rubi,,0000,0000,0000,,Асо
Dialogue: 0,0:22:57.83,0:23:00.33,Default,,0000,0000,0000,,Мен сақинамен ойнаған кезім
Dialogue: 0,0:22:57.83,0:23:00.33,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:23:00.33,0:23:02.27,Default,,0000,0000,0000,,Не, ақымақ!
Dialogue: 0,0:23:02.27,0:23:03.84,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:23:03.84,0:23:05.77,Rubi,,0000,0000,0000,,Юбива
Dialogue: 0,0:23:03.84,0:23:05.77,Rubi,,0000,0000,0000,,Асо
Dialogue: 0,0:23:03.84,0:23:05.77,Default,,0000,0000,0000,,Неге сақинамен ойнадың!
Dialogue: 0,0:23:05.77,0:23:07.34,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:23:05.77,0:23:07.34,Default,,0000,0000,0000,,Ақымақ!
Dialogue: 0,0:23:07.34,0:23:08.84,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:23:07.34,0:23:08.84,Default,,0000,0000,0000,,(тықылдаған дыбыс)
Dialogue: 0,0:23:07.34,0:23:08.84,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:23:08.84,0:23:11.75,Rubi,,0000,0000,0000,,Чика
Dialogue: 0,0:23:08.84,0:23:11.75,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:23:08.84,0:23:11.75,Default,,0000,0000,0000,,Асығыңыз және мұқият іздеңіз!
Dialogue: 0,0:23:11.75,0:23:14.72,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:23:11.75,0:23:14.72,Rubi,,0000,0000,0000,,болды
Dialogue: 0,0:23:11.75,0:23:14.72,Default,,0000,0000,0000,,А... ауырады, ауырады
Dialogue: 0,0:23:14.72,0:23:16.72,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:23:14.72,0:23:16.72,Default,,0000,0000,0000,,Сен бұған жақсылап қарадың ба?
Dialogue: 0,0:23:16.72,0:23:17.85,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:17.85,0:23:20.35,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:23:17.85,0:23:20.35,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:17.85,0:23:20.35,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:23:17.85,0:23:20.35,Rubi,,0000,0000,0000,,Тецуда
Dialogue: 0,0:23:17.85,0:23:20.35,Default,,0000,0000,0000,,Маған оны іздеуге көмектесіңізші.
Dialogue: 0,0:23:20.35,0:23:22.86,Rubi,,0000,0000,0000,,♬ Қорқынышсыз кенже ылғалайды
Dialogue: 0,0:23:20.35,0:23:22.86,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:22.86,0:23:25.76,Rubi,,0000,0000,0000,,Қол жұдырық
Dialogue: 0,0:23:22.86,0:23:25.76,Default,,0000,0000,0000,,Сіз тіпті көп іздеген жоқсыз.
Dialogue: 0,0:23:22.86,0:23:25.76,Rubi,,0000,0000,0000,,Акира
Dialogue: 0,0:23:22.86,0:23:25.76,Default,,0000,0000,0000,,Менің бас тартудан басқа амалым жоқ.
Dialogue: 0,0:23:25.76,0:23:26.73,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:23:26.73,0:23:29.73,Rubi,,0000,0000,0000,,Генкин
Dialogue: 0,0:23:26.73,0:23:29.73,Default,,0000,0000,0000,,Қолма-қол ақша бәрібір
Dialogue: 0,0:23:26.73,0:23:29.73,Default,,0000,0000,0000,,Сіз мұны істей алмайсыз, солай ма?
Dialogue: 0,0:23:29.73,0:23:32.37,Rubi,,0000,0000,0000,,En
Dialogue: 0,0:23:29.73,0:23:32.37,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:23:29.73,0:23:32.37,Default,,0000,0000,0000,,100 иенге картоп чипсы сатып алсаңыз да
Dialogue: 0,0:23:32.37,0:23:36.87,Rubi,,0000,0000,0000,,En
Dialogue: 0,0:23:32.37,0:23:36.87,Default,,0000,0000,0000,,Картоп чипсы 100 иен тұрады.
Dialogue: 0,0:23:32.37,0:23:36.87,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:23:32.37,0:23:36.87,Rubi,,0000,0000,0000,,Әйел
Dialogue: 0,0:23:32.37,0:23:36.87,Default,,0000,0000,0000,,Сатып ала алмаумен бірдей.
Dialogue: 0,0:23:37.87,0:23:40.37,Rubi,,0000,0000,0000,,Не?
Dialogue: 0,0:23:37.87,0:23:40.37,Default,,0000,0000,0000,,Не туралы айтып тұрсың!
Dialogue: 0,0:23:37.87,0:23:40.37,Rubi,,0000,0000,0000,,Шешуші шайқас
Dialogue: 0,0:23:37.87,0:23:40.37,Default,,0000,0000,0000,,Бұл сен кінәлісің!
Dialogue: 0,0:23:40.37,0:23:45.88,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:23:40.37,0:23:45.88,Rubi,,0000,0000,0000,,Оқыңыз
Dialogue: 0,0:23:40.37,0:23:45.88,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:23:40.37,0:23:45.88,Default,,0000,0000,0000,,А, мен үйленуге барғанда.
Dialogue: 0,0:23:40.37,0:23:45.88,Default,,0000,0000,0000,,Мен оны алғым келді, ақымақ!
Dialogue: 0,0:23:45.88,0:23:48.38,Rubi,,0000,0000,0000,,Уақыт
Dialogue: 0,0:23:45.88,0:23:48.38,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:23:45.88,0:23:48.38,Default,,0000,0000,0000,,Жоқ! Бұл Маруко
Dialogue: 0,0:23:45.88,0:23:48.38,Default,,0000,0000,0000,,Мен мұны қалаймын!
Dialogue: 0,0:23:48.38,0:23:51.29,Rubi,,0000,0000,0000,,Кенже
Dialogue: 0,0:23:48.38,0:23:51.29,Default,,0000,0000,0000,,Бұл менмін!
Dialogue: 0,0:23:48.38,0:23:51.29,Rubi,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:23:48.38,0:23:51.29,Default,,0000,0000,0000,,Енді ше?
Dialogue: 0,0:23:51.29,0:23:53.89,Default,,0000,0000,0000,,...
Dialogue: 0,0:23:53.89,0:23:57.39,Rubi,,0000,0000,0000,,Ләуһит
Dialogue: 0,0:23:53.89,0:23:57.39,Default,,0000,0000,0000,,Не емес
Dialogue: 0,0:23:53.89,0:23:57.39,Default,,0000,0000,0000,,Төбелеспе!
Dialogue: 0,0:23:57.39,0:23:59.89,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:23:57.39,0:23:59.89,Default,,0000,0000,0000,,Сен, бұлай көңіліңді түсірме.
Dialogue: 0,0:23:59.89,0:24:02.40,Default,,0000,0000,0000,,Иә, жақсырақ.
Dialogue: 0,0:23:59.89,0:24:02.40,Rubi,,0000,0000,0000,,Тоу
Dialogue: 0,0:23:59.89,0:24:02.40,Rubi,,0000,0000,0000,,Немесе
Dialogue: 0,0:23:59.89,0:24:02.40,Default,,0000,0000,0000,,Әкеңнен оны саған сатып алуын сұра.
Dialogue: 0,0:24:02.40,0:24:05.90,Rubi,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:24:02.40,0:24:05.90,Rubi,,0000,0000,0000,,Беншо
Dialogue: 0,0:24:02.40,0:24:05.90,Default,,0000,0000,0000,,Ба... ақымақ! Сіз оны төлейсіз!
Dialogue: 0,0:24:05.90,0:24:08.80,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:05.90,0:24:08.80,Rubi,,0000,0000,0000,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:24:05.90,0:24:08.80,Rubi,,0000,0000,0000,,Кира
Dialogue: 0,0:24:05.90,0:24:08.80,Default,,0000,0000,0000,,Мен Маруконы жек көремін!
Dialogue: 0,0:24:08.80,0:24:10.40,Default,,0000,0000,0000,,《…》
Dialogue: 0,0:24:10.40,0:24:15.28,Rubi,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:24:10.40,0:24:15.28,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:24:10.40,0:24:15.28,Default,,0000,0000,0000,,Күте тұрыңыз, анашым.
Dialogue: 0,0:24:10.40,0:24:15.28,Rubi,,0000,0000,0000,,Кира
Dialogue: 0,0:24:10.40,0:24:15.28,Default,,0000,0000,0000,,Кешіріңіз, мені жек көрмеңіз.
Dialogue: 0,0:24:15.28,0:24:16.28,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:24:17.28,0:24:20.28,Rubi,,0000,0000,0000,,Қазір
Dialogue: 0,0:24:17.28,0:24:20.28,Rubi,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:24:17.28,0:24:20.28,Default,,0000,0000,0000,,А... ол менімен сөйлеспейді де.
Dialogue: 0,0:24:21.85,0:24:23.78,Rubi,,0000,0000,0000,,♬ Бұрыннан басталған оқиғаға
Dialogue: 0,0:24:21.85,0:24:23.78,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:24:21.85,0:24:23.78,Rubi,,0000,0000,0000,,Жотай
Dialogue: 0,0:24:21.85,0:24:23.78,Default,,0000,0000,0000,,Анасының қазіргі жағдайы
Dialogue: 0,0:24:23.78,0:24:27.36,Rubi,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:24:23.78,0:24:27.36,Rubi,,0000,0000,0000,,Аралдың мұңын әркім біраз айтып алады ғой!!
Dialogue: 0,0:24:23.78,0:24:27.36,Rubi,,0000,0000,0000,,Шима
Dialogue: 0,0:24:23.78,0:24:27.36,Rubi,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:24:23.78,0:24:27.36,Default,,0000,0000,0000,,Олар: «Байланатын арал жоқ» дейді.
Dialogue: 0,0:24:27.36,0:24:29.86,Rubi,,0000,0000,0000,,Рику
Dialogue: 0,0:24:27.36,0:24:29.86,Default,,0000,0000,0000,,Ақылды нәрсе болып шықты...
Dialogue: 0,0:24:29.86,0:24:31.36,Default,,0000,0000,0000,,<Сөздік
Dialogue: 0,0:24:29.86,0:24:31.36,Default,,0000,0000,0000,,Бірінен соң бірі
Dialogue: 0,0:24:31.36,0:24:34.26,Rubi,,0000,0000,0000,,Дірілдер
Dialogue: 0,0:24:31.36,0:24:34.26,Default,,0000,0000,0000,,Практикалық тәжірибе арқылы
Dialogue: 0,0:24:31.36,0:24:34.26,Rubi,,0000,0000,0000,,Тайтоку
Dialogue: 0,0:24:31.36,0:24:34.26,Default,,0000,0000,0000,,Мару-чан оқыту
Dialogue: 0,0:24:34.26,0:24:37.26,Rubi,,0000,0000,0000,,О-
Dialogue: 0,0:24:34.26,0:24:37.26,Default,,0000,0000,0000,,Бір күні
Dialogue: 0,0:24:34.26,0:24:37.26,Rubi,,0000,0000,0000,,Жүз түрлі бет-әлпет киіп, оның миссиясы
Dialogue: 0,0:24:34.26,0:24:37.26,Default,,0000,0000,0000,,Сіз аман қала алмайсыз＞
Dialogue: 0,0:24:40.87,0:24:44.74,Rubi,,0000,0000,0000,,Каа
Dialogue: 0,0:24:40.87,0:24:44.74,Rubi,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:24:40.87,0:24:44.74,Rubi,,0000,0000,0000,,О
Dialogue: 0,0:24:40.87,0:24:44.74,Default,,0000,0000,0000,,Ана Маруко есейгенде
Dialogue: 0,0:24:40.87,0:24:44.74,Rubi,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:24:40.87,0:24:44.74,Rubi,,0000,0000,0000,,Юбива
Dialogue: 0,0:24:40.87,0:24:44.74,Rubi,,0000,0000,0000,,♬ Шешуші шайқас уақыты жақындап келеді
Dialogue: 0,0:24:40.87,0:24:44.74,Default,,0000,0000,0000,,Мен есейіп, сақинаны қайтарамын.
Dialogue: 0,0:24:44.74,0:24:47.74,Rubi,,0000,0000,0000,,Шуссебара
Dialogue: 0,0:24:44.74,0:24:47.74,Default,,0000,0000,0000,,Еңбек жолын өтеу арқылы
Dialogue: 0,0:24:44.74,0:24:47.74,Rubi,,0000,0000,0000,,Фалко!!
