Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.30,0:00:14.11,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:00:14.18,0:00:15.78,Default,,0,0,0,,(Ұшақ винтінің дыбысы)
Dialogue: 0,0:00:18.41,0:00:20.38,Default,,0,0,0,,Ммм
Dialogue: 0,0:00:21.42,0:00:22.48,Default,,0,0,0,,Уф
Dialogue: 0,0:00:22.58,0:00:25.02,Default,,0,0,0,,Джет Джет
Dialogue: 0,0:00:27.02,0:00:28.36,Default,,0,0,0,,Джет пен Игараши ше?
Dialogue: 0,0:00:29.16,0:00:31.16,Default,,0,0,0,,Ол өте жоғары жылдамдықпен қозғалды...
Dialogue: 0,0:00:32.29,0:00:35.16,Default,,0,0,0,,52-ші көшенің жанында жарылыс болған сияқты.
Dialogue: 0,0:00:35.66,0:00:36.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:37.13,0:00:38.73,Default,,0,0,0,,Дәрігер, мен барамын.
Dialogue: 0,0:00:39.67,0:00:41.40,Default,,0,0,0,,003 күтпеңіз
Dialogue: 0,0:00:41.50,0:00:45.34,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:00:59.82,0:01:01.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:02.56,0:01:03.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:04.46,0:01:05.76,Default,,0,0,0,,Ағын…
Dialogue: 0,0:02:56.27,0:02:58.21,Default,,0,0,0,,Жанна д'Арк қайда?
Dialogue: 0,0:02:58.31,0:02:59.74,Default,,0,0,0,,Абайлаңыз Al
Dialogue: 0,0:03:00.28,0:03:00.78,Default,,0,0,0,,Иә
Dialogue: 0,0:03:04.71,0:03:06.92,Default,,0,0,0,,(Мотоциклдің жүгіру дыбысы)
Dialogue: 0,0:03:14.32,0:03:15.22,Default,,0,0,0,,Ах
Dialogue: 0,0:03:18.43,0:03:19.96,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:03:20.23,0:03:22.56,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:03:28.57,0:03:29.44,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:03:32.27,0:03:34.54,Default,,0,0,0,,Кешіріңіз, мен асығып тұрмын.
Dialogue: 0,0:03:37.55,0:03:39.35,Default,,0,0,0,,Ммм...
Dialogue: 0,0:03:41.48,0:03:42.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:43.28,0:03:44.55,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:03:48.29,0:03:50.29,Default,,0,0,0,,Ха, неге...
Dialogue: 0,0:03:54.76,0:03:55.96,Default,,0,0,0,,(Императордың күрсінуі)
Dialogue: 0,0:03:56.80,0:04:00.57,Default,,0,0,0,,Бұл енді пайдалы Linker емес сияқты
Dialogue: 0,0:04:01.74,0:04:02.87,Default,,0,0,0,,Ах
Dialogue: 0,0:04:04.44,0:04:07.48,Default,,0,0,0,,Барлығын ұмыт
Dialogue: 0,0:04:09.98,0:04:12.68,Default,,0,0,0,,(Кэтринаның ыңырсыуы)
Dialogue: 0,0:04:13.28,0:04:16.55,Default,,0,0,0,,(Катаринаның тыныс алуы)
Dialogue: 0,0:04:16.65,0:04:17.69,Default,,0,0,0,,Катарина!
Dialogue: 0,0:04:17.95,0:04:20.02,Default,,0,0,0,,Ах ха... уф
Dialogue: 0,0:04:20.86,0:04:21.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:23.83,0:04:24.96,Default,,0,0,0,,(009 тыныс алуы)
Dialogue: 0,0:04:27.36,0:04:31.30,Default,,0,0,0,,Оның миынан тілдің бар болуы да өшірілді.
Dialogue: 0,0:04:32.67,0:04:37.31,Default,,0,0,0,,Біздің биологиялық инстинктіміз ғана қалады.
Dialogue: 0,0:04:37.64,0:04:38.84,Default,,0,0,0,,(Рей) Уу-хуу! (Эмма) Уау!
Dialogue: 0,0:04:39.51,0:04:42.34,Default,,0,0,0,,Оның өткені мен естеліктері...
Dialogue: 0,0:04:42.74,0:04:45.31,Default,,0,0,0,,Тіпті сенің адамдық қадіріңді кетірді ме?
Dialogue: 0,0:04:45.81,0:04:48.38,Default,,0,0,0,,Денесінде бірде-бір жара жоқ.
Dialogue: 0,0:04:48.88,0:04:50.35,Default,,0,0,0,,Мәселе неде?
Dialogue: 0,0:04:50.69,0:04:51.55,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:04:51.89,0:04:54.92,Default,,0,0,0,,Біреудің жадын алып тастасаң, өлтіргенмен бірдей.
Dialogue: 0,0:04:55.72,0:04:56.99,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:57.86,0:05:00.53,Default,,0,0,0,,Бұл шынымен де бейкүнә және сүйкімді емес пе?
Dialogue: 0,0:05:01.03,0:05:05.53,Default,,0,0,0,,Бұл уақытты алады, бірақ егер барлық адамдар осы жерден басталса...
Dialogue: 0,0:05:05.90,0:05:07.90,Default,,0,0,0,,Әлем міндетті түрде өзгереді
Dialogue: 0,0:05:08.37,0:05:11.57,Default,,0,0,0,,Бұл адамзаттың инициализацияланатынын білдіре ме?
Dialogue: 0,0:05:16.31,0:05:20.72,Default,,0,0,0,,Адамзат Бабыл мұнарасын жасап, қатты шатасуда.
Dialogue: 0,0:05:21.58,0:05:23.99,Default,,0,0,0,,Бізге бір рет негізгі мәліметтерге оралу керек.
Dialogue: 0,0:05:24.89,0:05:26.09,Default,,0,0,0,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:05:27.02,0:05:29.36,Default,,0,0,0,,Мен оны қамқорлықпен өсірдім
Dialogue: 0,0:05:29.46,0:05:32.56,Default,,0,0,0,,Маған сіздерді жаңа адамнан тыс әлемге апаруға рұқсат етіңіздер.
Dialogue: 0,0:05:33.39,0:05:35.76,Default,,0,0,0,,Сіз құдай болуға тырысасыз ба?
Dialogue: 0,0:05:36.40,0:05:38.63,Default,,0,0,0,,Құдай Ол емес.
Dialogue: 0,0:05:39.00,0:05:44.44,Default,,0,0,0,,Бірақ жаңа адамдар мені осылай атайтын күн...
Dialogue: 0,0:05:44.71,0:05:45.77,Default,,0,0,0,,Бұл алыс болмайды.
Dialogue: 0,0:05:48.11,0:05:48.98,Default,,0,0,0,,Мен шештім
Dialogue: 0,0:05:51.65,0:05:53.85,Default,,0,0,0,,Мен сені ешқашан кешірмеймін
Dialogue: 0,0:05:54.45,0:05:55.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:57.69,0:05:58.49,Default,,0,0,0,,Ха...
Dialogue: 0,0:05:58.59,0:05:59.89,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:06:03.59,0:06:04.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:05.79,0:06:06.76,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:06.99,0:06:08.50,Default,,0,0,0,,Уф аххх
Dialogue: 0,0:06:09.96,0:06:11.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:13.03,0:06:15.60,Default,,0,0,0,,Сен де бәрін ұмытасың.
Dialogue: 0,0:06:16.64,0:06:17.57,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:17.64,0:06:18.47,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:06:18.54,0:06:19.41,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:19.47,0:06:20.78,Default,,0,0,0,,Хмм... мм...
Dialogue: 0,0:06:29.52,0:06:31.89,Default,,0,0,0,,(күн күркіреуі)
Dialogue: 0,0:06:32.42,0:06:33.62,Default,,0,0,0,,(009 ыңырсыған)
Dialogue: 0,0:06:36.02,0:06:38.63,Default,,0,0,0,,Егер сіз бәрін сабырмен ұмытсаңыз...
Dialogue: 0,0:06:39.89,0:06:41.63,Default,,0,0,0,,Өзіңізді жайлы сезінетін нәрсе...
Dialogue: 0,0:06:43.60,0:06:44.83,Default,,0,0,0,,Мен... иә...
Dialogue: 0,0:06:45.60,0:06:47.47,Default,,0,0,0,,Жараланған және құлаған жолдас...
Dialogue: 0,0:06:48.50,0:06:50.04,Default,,0,0,0,,Жоғалтқандар...
Dialogue: 0,0:06:51.11,0:06:53.14,Default,,0,0,0,,Мен ұмыта алмаймын!
Dialogue: 0,0:06:55.54,0:06:57.15,Default,,0,0,0,,Дәрігер
Dialogue: 0,0:06:57.81,0:06:59.55,Default,,0,0,0,,Не болды? 003
Dialogue: 0,0:07:00.72,0:07:03.15,Default,,0,0,0,,Джеттің ми толқындарын анықтау мүмкін емес.
Dialogue: 0,0:07:03.62,0:07:06.89,Default,,0,0,0,,Петрді жеңу керек еді...
Dialogue: 0,0:07:08.62,0:07:09.56,Default,,0,0,0,,Уф
Dialogue: 0,0:07:17.06,0:07:19.57,Default,,0,0,0,,Джет, сен қайдасың?
Dialogue: 0,0:07:19.67,0:07:20.57,Default,,0,0,0,,Ағын
Dialogue: 0,0:07:20.97,0:07:22.00,Default,,0,0,0,,Джет!
Dialogue: 0,0:07:22.10,0:07:23.00,Default,,0,0,0,,Құт
Dialogue: 0,0:07:24.51,0:07:25.61,Default,,0,0,0,,Уууу… Уф!
Dialogue: 0,0:07:26.07,0:07:29.71,Default,,0,0,0,,003 Егер жағдай осылай жалғаса берсе, 009-ға да қауіп төнеді.
Dialogue: 0,0:07:30.45,0:07:31.68,Default,,0,0,0,,Маған көмектесуіңізді өтінемін.
Dialogue: 0,0:07:33.45,0:07:34.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:36.02,0:07:36.92,Default,,0,0,0,,Иә
Dialogue: 0,0:07:46.76,0:07:47.46,Default,,0,0,0,,Ах
Dialogue: 0,0:08:06.51,0:08:08.52,Default,,0,0,0,,Джо, біз жақын арада боламыз.
Dialogue: 0,0:08:10.15,0:08:11.92,Default,,0,0,0,,Уф
Dialogue: 0,0:08:12.02,0:08:13.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:13.92,0:08:15.02,Default,,0,0,0,,Қамалға асығыңыз!
Dialogue: 0,0:08:16.22,0:08:16.96,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:17.69,0:08:21.13,Default,,0,0,0,,Иванды қарсы алаң ұстап алып, қозғала алмай қалды.
Dialogue: 0,0:08:21.80,0:08:23.53,Default,,0,0,0,,Катарина да сол бөлмеде.
Dialogue: 0,0:08:23.80,0:08:24.67,Default,,0,0,0,,Ах
Dialogue: 0,0:08:25.73,0:08:26.70,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:08:28.70,0:08:29.77,Default,,0,0,0,,Біз де асығайық.
Dialogue: 0,0:08:30.10,0:08:32.21,Default,,0,0,0,,Хмм, мен оны қалай да жеңемін деп ойлаймын.
Dialogue: 0,0:08:32.84,0:08:33.84,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:33.91,0:08:36.21,Default,,0,0,0,,(зымыран дыбысы)
Dialogue: 0,0:08:36.98,0:08:38.08,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:08:44.19,0:08:44.99,Default,,0,0,0,,«Мен ашулымын», «қаным қайнап тұр»
Dialogue: 0,0:08:45.05,0:08:46.15,Default,,0,0,0,,Айя
Dialogue: 0,0:08:46.29,0:08:48.66,Default,,0,0,0,,Ууууууууууууууууууууууууууууууу (007)
Dialogue: 0,0:08:49.22,0:08:51.93,Default,,0,0,0,,Мен өз шегіме жеттім
Dialogue: 0,0:08:52.23,0:08:54.93,Default,,0,0,0,,Қозғалтқыштың зақымдануы әрі қарай ұша алмайды
Dialogue: 0,0:08:55.93,0:08:57.93,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:08:58.80,0:09:00.70,Default,,0,0,0,,Сол жерде 008
Dialogue: 0,0:09:06.87,0:09:10.31,Default,,0,0,0,,(суға соқтығысқан дыбыс)
Dialogue: 0,0:09:21.06,0:09:24.66,Default,,0,0,0,,Бұл қону емес, апат.
Dialogue: 0,0:09:25.23,0:09:29.03,Default,,0,0,0,,Пюнманың жігіті сені өте бұзық түрде қайтарады.
Dialogue: 0,0:09:29.73,0:09:32.03,Default,,0,0,0,,Бұл одан да қарқынды болуы мүмкін еді.
Dialogue: 0,0:09:35.04,0:09:36.04,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,0:09:36.74,0:09:37.77,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:09:46.08,0:09:46.78,Default,,0,0,0,,Иван
Dialogue: 0,0:09:47.78,0:09:49.75,Default,,0,0,0,,003 Катарина...
Dialogue: 0,0:09:55.82,0:09:56.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:57.76,0:09:58.66,Default,,0,0,0,,Ха...
Dialogue: 0,0:09:59.16,0:10:00.19,Default,,0,0,0,,Императорға?
Dialogue: 0,0:10:01.00,0:10:01.80,Default,,0,0,0,,Иә
Dialogue: 0,0:10:02.96,0:10:04.10,Default,,0,0,0,,Не...
Dialogue: 0,0:10:04.20,0:10:05.87,Default,,0,0,0,,Иә, осындай жерде…
Dialogue: 0,0:10:05.97,0:10:07.60,Default,,0,0,0,,Не болды? Катарина\NОл
Dialogue: 0,0:10:07.70,0:10:08.60,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:10:11.64,0:10:13.98,Default,,0,0,0,,009-ға сәйкес болуы мүмкін.
Dialogue: 0,0:10:14.71,0:10:15.38,Default,,0,0,0,,Га
Dialogue: 0,0:10:15.81,0:10:16.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:19.61,0:10:20.28,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:10:22.75,0:10:24.95,Default,,0,0,0,,Қыңыр 009
Dialogue: 0,0:10:25.25,0:10:27.15,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:10:27.69,0:10:30.29,Default,,0,0,0,,(Тыныс алу жалынының дыбысы)
Dialogue: 0,0:10:30.99,0:10:31.89,Default,,0,0,0,,006
Dialogue: 0,0:10:32.73,0:10:33.73,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:10:34.80,0:10:36.30,Default,,0,0,0,,Мұзды Әлге қалдырыңыз
Dialogue: 0,0:10:36.90,0:10:38.90,Default,,0,0,0,,008 Сол жаққа бұрылыңыз.
Dialogue: 0,0:10:39.17,0:10:40.17,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:10:41.24,0:10:42.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:43.80,0:10:47.01,Default,,0,0,0,,Соңында, киборгтар!
Dialogue: 0,0:10:47.98,0:10:48.71,Default,,0,0,0,,Уау
Dialogue: 0,0:10:48.78,0:10:49.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:50.21,0:10:50.91,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:10:50.98,0:10:55.85,Default,,0,0,0,,Осы аянышты басшымен бірге өміріңді тастау керек.
Dialogue: 0,0:10:56.12,0:10:56.82,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:57.02,0:10:57.72,Default,,0,0,0,,Құт
Dialogue: 0,0:10:59.19,0:10:59.89,Default,,0,0,0,,Уф
Dialogue: 0,0:10:59.99,0:11:01.92,Default,,0,0,0,,Ақымақ киборгтар
Dialogue: 0,0:11:02.76,0:11:04.09,Default,,0,0,0,,Ауызша көп емес
Dialogue: 0,0:11:04.66,0:11:07.13,Default,,0,0,0,,(005 дауысы)
Dialogue: 0,0:11:08.83,0:11:09.96,Default,,0,0,0,,(009 тыныс алуы)
Dialogue: 0,0:11:10.73,0:11:11.37,Default,,0,0,0,,Га Геронимо
Dialogue: 0,0:11:11.73,0:11:15.94,Default,,0,0,0,,(005 тыныс алуы)
Dialogue: 0,0:11:16.14,0:11:19.24,Default,,0,0,0,,Джо, сол кездегі үдеу.
Dialogue: 0,0:11:19.81,0:11:20.44,Default,,0,0,0,,Ах
Dialogue: 0,0:11:21.94,0:11:24.05,Default,,0,0,0,,Соғыс жағдайы өте қауіпті болып көрінеді.
Dialogue: 0,0:11:24.95,0:11:27.18,Default,,0,0,0,,Сіз үдеткіштер жұмыс істемейді дейсіз бе?
Dialogue: 0,0:11:27.82,0:11:30.79,Default,,0,0,0,,Императордың ойлау жылдамдығы 009-дан асады.
Dialogue: 0,0:11:30.92,0:11:32.42,Default,,0,0,0,,Алға қарап әрекет ету
Dialogue: 0,0:11:32.89,0:11:33.92,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:11:34.22,0:11:36.72,Default,,0,0,0,,Ағымдағы үдеумен жеңу мүмкін емес
Dialogue: 0,0:11:37.06,0:11:37.99,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:38.29,0:11:39.96,Default,,0,0,0,,Біз не істей аламыз -
Dialogue: 0,0:11:40.16,0:11:43.96,Default,,0,0,0,,Сізге тек 009-ға сену және күресуді жалғастыру жеткілікті.
Dialogue: 0,0:11:45.73,0:11:46.23,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:11:47.33,0:11:48.70,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:11:49.17,0:11:49.87,Default,,0,0,0,,Әрине.
Dialogue: 0,0:11:50.30,0:11:51.44,Default,,0,0,0,,Әрине Al
Dialogue: 0,0:11:51.91,0:11:52.94,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:11:53.37,0:11:55.88,Default,,0,0,0,,Біз сол үшін келдік.
Dialogue: 0,0:11:56.41,0:11:57.45,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:11:58.75,0:12:02.25,Default,,0,0,0,,Балалар сендер жай ғана кездейсоқсыңдар.
Dialogue: 0,0:12:02.72,0:12:05.75,Default,,0,0,0,,Санның сәйкестігі? Superior Al
Dialogue: 0,0:12:05.85,0:12:06.92,Default,,0,0,0,,Пуууууу
Dialogue: 0,0:12:07.35,0:12:09.96,Default,,0,0,0,,Мен саған қосалқы кейіпкердің жанын көрсетемін.
Dialogue: 0,0:12:10.36,0:12:13.76,Default,,0,0,0,,(005 дауысы)
Dialogue: 0,0:12:15.46,0:12:16.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:18.50,0:12:19.87,Default,,0,0,0,,Үдеткіш
Dialogue: 0,0:12:23.34,0:12:24.37,Default,,0,0,0,,Уау
Dialogue: 0,0:12:26.01,0:12:26.87,Default,,0,0,0,,Уф
Dialogue: 0,0:12:28.28,0:12:30.85,Default,,0,0,0,,Неліктен мен оны тездете алмаймын?
Dialogue: 0,0:12:31.01,0:12:32.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:34.32,0:12:35.32,Default,,0,0,0,,Джо
Dialogue: 0,0:12:36.25,0:12:36.95,Default,,0,0,0,,Га
Dialogue: 0,0:12:37.22,0:12:39.25,Default,,0,0,0,,Уф үдеткіш
Dialogue: 0,0:13:01.11,0:13:03.11,Default,,0,0,0,,Ммм.
Dialogue: 0,0:13:19.23,0:13:21.46,Default,,0,0,0,,Күрсіну... Иә.
Dialogue: 0,0:13:21.56,0:13:22.53,Default,,0,0,0,,Катарина
Dialogue: 0,0:13:23.33,0:13:25.07,Default,,0,0,0,,Уххххх (003) Ахх...
Dialogue: 0,0:13:25.47,0:13:28.10,Default,,0,0,0,,(Катаринаның тыныс алуы)
Dialogue: 0,0:13:28.20,0:13:28.97,Default,,0,0,0,,Иван?
Dialogue: 0,0:13:31.21,0:13:32.81,Default,,0,0,0,,Бұл көрініс...
Dialogue: 0,0:13:42.92,0:13:44.89,Default,,0,0,0,,(Императордың ыңырануы)
Dialogue: 0,0:13:46.29,0:13:48.52,Default,,0,0,0,,(Императордың ыңырануы)
Dialogue: 0,0:13:49.09,0:13:51.06,Default,,0,0,0,,Бұл қандай көрініс?
Dialogue: 0,0:13:52.33,0:13:53.29,Default,,0,0,0,,(қағу дыбысы)
Dialogue: 0,0:13:53.39,0:13:54.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:56.23,0:13:59.30,Default,,0,0,0,,Мен нақты не көрдім?
Dialogue: 0,0:14:00.50,0:14:02.44,Default,,0,0,0,,Ол қай жер?
Dialogue: 0,0:14:02.97,0:14:04.37,Default,,0,0,0,,Бұл көрініс...
Dialogue: 0,0:14:09.21,0:14:10.11,Default,,0,0,0,,Тек таңдаулы бірнешеуге ғана тән делінген күш—
Dialogue: 0,0:14:10.95,0:14:13.48,Default,,0,0,0,,Бұл 009 үдеу кезінде көретін көрініс.
Dialogue: 0,0:14:14.45,0:14:16.52,Default,,0,0,0,,Император да дәл осылай көрген сияқты.
Dialogue: 0,0:14:17.35,0:14:18.52,Default,,0,0,0,,Бұл қалай болуы мүмкін?
Dialogue: 0,0:14:18.62,0:14:20.35,Default,,0,0,0,,Уф хах
Dialogue: 0,0:14:20.45,0:14:21.56,Default,,0,0,0,,Катарина
Dialogue: 0,0:14:21.86,0:14:24.12,Default,,0,0,0,,(Кэтринаның ыңырануы)
Dialogue: 0,0:14:24.59,0:14:27.39,Default,,0,0,0,,009 қарап тұрған пейзаж ше?
Dialogue: 0,0:14:27.86,0:14:29.50,Default,,0,0,0,,Көремін, байланыстырушы
Dialogue: 0,0:14:30.26,0:14:34.54,Default,,0,0,0,,Сіз менің миымды 009-мен байланыстырдыңыз ба?
Dialogue: 0,0:14:36.94,0:14:39.04,Default,,0,0,0,,Қосымша нәрсе жасаңыз!
Dialogue: 0,0:14:40.44,0:14:41.34,Default,,0,0,0,,Уф
Dialogue: 0,0:14:41.44,0:14:42.54,Default,,0,0,0,,Уф
Dialogue: 0,0:14:43.18,0:14:44.55,Default,,0,0,0,,Әй, Катарина!
Dialogue: 0,0:14:45.15,0:14:49.12,Default,,0,0,0,,(Катаринаның ыңырсыуы)
Dialogue: 0,0:14:51.42,0:14:52.32,Default,,0,0,0,,Катарина!
Dialogue: 0,0:14:52.39,0:14:56.09,Default,,0,0,0,,(Катаринаның ыңырсыуы)
Dialogue: 0,0:14:56.16,0:14:57.16,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:14:57.26,0:14:59.29,Default,,0,0,0,,Ах! Ха...
Dialogue: 0,0:14:59.36,0:15:00.49,Default,,0,0,0,,Катарина!
Dialogue: 0,0:15:03.66,0:15:05.17,Default,,0,0,0,,Ха Катарина
Dialogue: 0,0:15:06.00,0:15:06.90,Default,,0,0,0,,Катарина
Dialogue: 0,0:15:07.20,0:15:08.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:08.50,0:15:09.50,Default,,0,0,0,,Га
Dialogue: 0,0:15:10.47,0:15:12.54,Default,,0,0,0,,Ұмыту... жоқ
Dialogue: 0,0:15:13.31,0:15:14.68,Default,,0,0,0,,Сіз...
Dialogue: 0,0:15:16.04,0:15:17.11,Default,,0,0,0,,Джо
Dialogue: 0,0:15:19.11,0:15:21.58,Default,,0,0,0,,Катарина!
Dialogue: 0,0:15:24.55,0:15:26.95,Default,,0,0,0,,Барлық естеліктерді алып тастау керек еді
Dialogue: 0,0:15:27.39,0:15:29.19,Default,,0,0,0,,Неліктен бұл атау?
Dialogue: 0,0:15:29.49,0:15:32.46,Default,,0,0,0,,Адамдар үшін ең маңыздысы...
Dialogue: 0,0:15:33.06,0:15:34.43,Default,,0,0,0,,Мен ешқашан ұмытпаймын
Dialogue: 0,0:15:35.36,0:15:38.03,Default,,0,0,0,,Құнсыз аяушылыққа алданып қалу...
Dialogue: 0,0:15:38.17,0:15:39.37,Default,,0,0,0,,Сен ақымақ әйелсің.
Dialogue: 0,0:15:40.13,0:15:42.00,Default,,0,0,0,,Сізде жүрек жоқ па?
Dialogue: 0,0:15:42.37,0:15:46.17,Default,,0,0,0,,Әу бастан жүрек деген жоқ.
Dialogue: 0,0:15:47.07,0:15:51.41,Default,,0,0,0,,Адамдар әлсіз, өйткені олар осындай белгісіздікке сенеді.
Dialogue: 0,0:15:52.65,0:15:53.95,Default,,0,0,0,,Олай емес
Dialogue: 0,0:15:54.95,0:15:58.19,Default,,0,0,0,,Жүрексіз күш нағыз күш емес
Dialogue: 0,0:16:08.06,0:16:09.06,Default,,0,0,0,,(күн күркіреуі)
Dialogue: 0,0:16:09.33,0:16:10.26,Default,,0,0,0,,Ммм
Dialogue: 0,0:16:14.27,0:16:15.47,Default,,0,0,0,,Неліктен жоқ?
Dialogue: 0,0:16:16.17,0:16:18.04,Default,,0,0,0,,Сіз де соны сезіп отырған боларсыз.
Dialogue: 0,0:16:18.64,0:16:22.18,Default,,0,0,0,,009 жеделдету деңгейі өсті.
Dialogue: 0,0:16:23.48,0:16:26.71,Default,,0,0,0,,Адамдарды күлдіріңіз Жай үдеумен не істей аласыз?
Dialogue: 0,0:16:27.58,0:16:29.28,Default,,0,0,0,,Әлі түсінбедіңіз бе?
Dialogue: 0,0:16:30.05,0:16:32.62,Default,,0,0,0,,009 үдеткішті пайдаланған сайын-
Dialogue: 0,0:16:32.72,0:16:35.16,Default,,0,0,0,,Мен бұл көріністі өзім көрдім.
Dialogue: 0,0:16:35.26,0:16:36.46,Default,,0,0,0,,Тыныш, Иван.
Dialogue: 0,0:16:36.56,0:16:37.73,Default,,0,0,0,,(001-нің ыңырсыуы)
Dialogue: 0,0:16:44.10,0:16:46.33,Default,,0,0,0,,Уууу
Dialogue: 0,0:16:46.63,0:16:49.10,Default,,0,0,0,,Сіз жылдамдатқан сайын? ақымақ
Dialogue: 0,0:16:49.70,0:16:51.34,Default,,0,0,0,,Мынадай жас жігіт...
Dialogue: 0,0:16:51.71,0:16:54.58,Default,,0,0,0,,Мен бұл жалғыздыққа шыдай алмаймын.
Dialogue: 0,0:16:55.14,0:16:57.01,Default,,0,0,0,,(Слақ еткен дыбыс)
Dialogue: 0,0:16:58.58,0:17:00.45,Default,,0,0,0,,Сіз мұнда үш мың жыл болдыңыз -
Dialogue: 0,0:17:00.71,0:17:04.32,Default,,0,0,0,,Адамдарға менсінбей қарап, өзін-өзі ақтайтын.
Dialogue: 0,0:17:04.79,0:17:07.62,Default,,0,0,0,,Бірақ 009 жылдамдатады...
Dialogue: 0,0:17:08.12,0:17:10.46,Default,,0,0,0,,Осынша көп уақыт өмір сүрген кезде...
Dialogue: 0,0:17:10.56,0:17:13.13,Default,,0,0,0,,Мен әркімнің ойын қабылдадым.
Dialogue: 0,0:17:13.59,0:17:16.63,Default,,0,0,0,,Бұл 009-ның күші.
Dialogue: 0,0:17:17.56,0:17:22.04,Default,,0,0,0,,Сіз бұл киборгты менен күшті деп айтасыз ба?
Dialogue: 0,0:17:22.10,0:17:22.60,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:17:23.70,0:17:27.27,Default,,0,0,0,,Неліктен? Уақыт неге кері қайтарылмайды?
Dialogue: 0,0:17:28.24,0:17:32.61,Default,,0,0,0,,009 Жарық жылдамдығынан асып кетсеңіз де...
Dialogue: 0,0:17:33.05,0:17:35.32,Default,,0,0,0,,Анықталған оқиғаларды өзгерту мүмкін емес.
Dialogue: 0,0:17:36.15,0:17:37.72,Default,,0,0,0,,Сосын, Катарина...
Dialogue: 0,0:17:38.52,0:17:39.42,Default,,0,0,0,,Иә
Dialogue: 0,0:17:42.12,0:17:44.76,Default,,0,0,0,,Қарғыс атсын... Қызық бітті!
Dialogue: 0,0:17:45.06,0:17:46.46,Default,,0,0,0,,(барлығы ыңылдап)
Dialogue: 0,0:17:49.26,0:17:49.76,Default,,0,0,0,,Иван
Dialogue: 0,0:17:50.20,0:17:54.74,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:55.14,0:17:55.80,Default,,0,0,0,,Уф
Dialogue: 0,0:18:00.81,0:18:01.74,Default,,0,0,0,,Иван
Dialogue: 0,0:18:03.71,0:18:06.15,Default,,0,0,0,,Сіз сол соққы толқынын тудыруға тырысасыз ба?
Dialogue: 0,0:18:06.78,0:18:12.19,Default,,0,0,0,,Жерді бір рет талқандасақ, екеумізге қызық болар еді.
Dialogue: 0,0:18:12.79,0:18:13.59,Default,,0,0,0,,Иван
Dialogue: 0,0:18:14.22,0:18:15.49,Default,,0,0,0,,Уайымдаудың қажеті жоқ
Dialogue: 0,0:18:15.79,0:18:19.23,Default,,0,0,0,,Қарсы келмесем, күйреуден аулақ болады.
Dialogue: 0,0:18:19.33,0:18:21.13,Default,,0,0,0,,Бірақ содан кейін сіз...
Dialogue: 0,0:18:21.23,0:18:23.56,Default,,0,0,0,,009 Барлығынан сұраңыз
Dialogue: 0,0:18:27.40,0:18:28.74,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:18:37.34,0:18:38.51,Default,,0,0,0,,Үдеткіш
Dialogue: 0,0:18:41.78,0:18:45.32,Default,,0,0,0,,Қашып кетіп, достарыңды тастап кеттің бе? 009
Dialogue: 0,0:18:45.79,0:18:46.82,Default,,0,0,0,,Киборгтар
Dialogue: 0,0:18:47.49,0:18:52.36,Default,,0,0,0,,Сізді жеңіп, бұл жерді шөл далаға айналдыратын уақыт жеткен сияқты.
Dialogue: 0,0:18:58.27,0:18:59.60,Default,,0,0,0,,Пайдасы жоқ, император.
Dialogue: 0,0:19:00.23,0:19:01.90,Default,,0,0,0,,Сіздің үмітіңіз орындалмайды.
Dialogue: 0,0:19:02.20,0:19:02.70,Default,,0,0,0,,Не?
Dialogue: 0,0:19:03.40,0:19:08.51,Default,,0,0,0,,Мен енді жарықтан асып, жалғыз болашағыңды көрдім.
Dialogue: 0,0:19:14.18,0:19:14.92,Default,,0,0,0,,Джо!
Dialogue: 0,0:19:30.80,0:19:34.70,Default,,0,0,0,,(Императордың үрейлі дауысы)
Dialogue: 0,0:19:35.74,0:19:41.31,Default,,0,0,0,,(Императордың үрейлі дауысы)
Dialogue: 0,0:19:43.58,0:19:46.25,Default,,0,0,0,,Мені бұл жерден шығарыңыз...
Dialogue: 0,0:19:46.35,0:19:47.81,Default,,0,0,0,,Мені шығарыңыз!
Dialogue: 0,0:19:47.88,0:19:48.68,Default,,0,0,0,,Ол L-дің атын білген бойда мен тергеу штабын түгел жоямын.
Dialogue: 0,0:19:49.18,0:19:49.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:50.38,0:19:52.25,Default,,0,0,0,,Бұған қоса, олар сені аянышты қарсылас ретінде ғана көреді.
Dialogue: 0,0:19:53.29,0:19:56.36,Default,,0,0,0,,Неліктен? Неге сонша тынышсыз?
Dialogue: 0,0:19:56.79,0:20:01.73,Default,,0,0,0,,Үш мың жыл өмір сүрген мен де осы жалғыздықтан қорқамын...
Dialogue: 0,0:20:01.83,0:20:04.36,Default,,0,0,0,,Оған неге шыдай аласың?
Dialogue: 0,0:20:05.83,0:20:06.87,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:20:07.63,0:20:08.34,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:20:08.60,0:20:09.30,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:20:09.77,0:20:11.47,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:20:19.58,0:20:21.65,Default,,0,0,0,,Өйткені бұл менің миссиям.
Dialogue: 0,0:20:30.86,0:20:31.73,Default,,0,0,0,,Джо
Dialogue: 0,0:20:32.39,0:20:34.49,Default,,0,0,0,,Иван Джо қайда кетті?
Dialogue: 0,0:20:35.30,0:20:39.53,Default,,0,0,0,,Сіз императормен бірге оқиға көкжиегін кесіп өткен сияқтысыз.
Dialogue: 0,0:20:40.27,0:20:41.27,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:42.70,0:20:46.64,Default,,0,0,0,,Бұл біздің қолымыз жетпейтін басқа өлшемдегі орын.
Dialogue: 0,0:20:47.87,0:20:48.94,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:50.68,0:20:51.68,Default,,0,0,0,,Джо
Dialogue: 0,0:20:58.72,0:21:02.46,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:21:09.66,0:21:13.67,Default,,0,0,0,,Мен әлі де 009-ның қатысуын сезінемін
Dialogue: 0,0:21:14.67,0:21:16.50,Default,,0,0,0,,Оның жағдайы жақсы
Dialogue: 0,0:21:27.65,0:21:31.02,Default,,0,0,0,,Үш ай бұрын Нью-Йоркте болған оқиға...
Dialogue: 0,0:21:31.29,0:21:35.46,Default,,0,0,0,,Біріккен Ұлттар Ұйымының күштері оны қауіпсіз түрде басып тастағаны туралы жұртшылыққа хабарланды.
Dialogue: 0,0:21:37.92,0:21:39.93,Default,,0,0,0,,Нөлдік нөлдік киборг не істеді...
Dialogue: 0,0:21:39.99,0:21:41.50,Default,,0,0,0,,Ешкім білмеді...
Dialogue: 0,0:21:42.76,0:21:45.63,Default,,0,0,0,,Берекелі деп аталатын бейтаныс адам жоспарлап отыр...
Dialogue: 0,0:21:46.00,0:21:47.87,Default,,0,0,0,,Тудыруға бағытталған қауіп -
Dialogue: 0,0:21:48.94,0:21:51.47,Default,,0,0,0,,Оны тоқтату үшін басын қатерге тіккен батырлар...
Dialogue: 0,0:21:52.47,0:21:54.04,Default,,0,0,0,,Ол сөзсіз болған
Dialogue: 0,0:21:57.08,0:22:00.38,Default,,0,0,0,,Мен шынайы әділеттілікке ұмтыламын.
Dialogue: 0,0:22:01.65,0:22:04.52,Default,,0,0,0,,Адамзат үшін күрескен тоғыз адамның батыр тұлғалары.
Dialogue: 0,0:22:06.02,0:22:09.02,Default,,0,0,0,,Ешқашан ұмытпа
Dialogue: 0,0:22:18.43,0:22:19.90,Default,,0,0,0,,Біз бұл жерден қайда барамыз?
Dialogue: 0,0:22:20.57,0:22:21.84,Default,,0,0,0,,«Каталина Канетти»
Dialogue: 0,0:22:21.84,0:22:23.57,Default,,0,0,0,,«Каталина Канетти»
Dialogue: 0,0:22:21.84,0:22:23.57,Default,,0,0,0,,Менің қол астындағы қызметкерімді жерлеу рәсімі болды.
Dialogue: 0,0:22:23.57,0:22:24.34,Default,,0,0,0,,Менің қол астындағы қызметкерімді жерлеу рәсімі болды.
Dialogue: 0,0:22:25.07,0:22:26.91,Default,,0,0,0,,Ауылда егістікпен айналысасыз ба?
Dialogue: 0,0:22:28.44,0:22:29.44,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:22:30.34,0:22:31.68,Default,,0,0,0,,Хмм, шын мәнінде...
Dialogue: 0,0:22:32.55,0:22:35.38,Default,,0,0,0,,Киборгтармен күрестегі жетістіктері үшін танылған.
Dialogue: 0,0:22:35.45,0:22:36.78,Default,,0,0,0,,Директор қызметіне көтерілді
Dialogue: 0,0:22:38.05,0:22:39.99,Default,,0,0,0,,Мен әлі жұмыстан шыға алмаймын деп ойлаймын.
Dialogue: 0,0:22:41.46,0:22:42.36,Default,,0,0,0,,Иә
Dialogue: 0,0:22:43.02,0:22:45.76,Default,,0,0,0,,Енді сіз олардың өсиетін мұра етесіз бе?
Dialogue: 0,0:22:47.06,0:22:49.90,Default,,0,0,0,,Бұл ауыр жүк, бірақ мен қолымнан келгенін істеймін.
Dialogue: 0,0:22:51.00,0:22:53.03,Default,,0,0,0,,Олар жақсы демалу үшін
Dialogue: 0,0:22:54.53,0:23:00.53,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory