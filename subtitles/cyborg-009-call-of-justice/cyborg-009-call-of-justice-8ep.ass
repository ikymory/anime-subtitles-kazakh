Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:34.52,0:01:35.22,Default,,0,0,0,,Кеттік
Dialogue: 0,0:01:47.20,0:01:47.87,Default,,0,0,0,,(қону дыбысы)
Dialogue: 0,0:01:55.18,0:01:58.51,Default,,0,0,0,,Біз зертханада ешқандай биологиялық реакцияларды растай алмаймыз.
Dialogue: 0,0:01:59.85,0:02:03.18,Default,,0,0,0,,Айта Бүгін әдеттегі мереке ме?
Dialogue: 0,0:02:03.42,0:02:06.59,Default,,0,0,0,,Зауыттың роботтарға толы болуы мүмкін.
Dialogue: 0,0:02:06.65,0:02:07.69,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:02:08.16,0:02:10.33,Default,,0,0,0,,Алдында кіреберіс болуы керек.
Dialogue: 0,0:02:26.61,0:02:27.54,Default,,0,0,0,,Оны ашыңыз.
Dialogue: 0,0:02:28.24,0:02:33.31,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:33.45,0:02:34.85,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:02:35.48,0:02:37.59,Default,,0,0,0,,Ештеңе жоқ
Dialogue: 0,0:02:43.79,0:02:45.16,Default,,0,0,0,,Сіз қашып кеттіңіз бе?
Dialogue: 0,0:02:45.26,0:02:46.49,Default,,0,0,0,,Иванның ми толқындары ше?
Dialogue: 0,0:02:46.63,0:02:48.66,Default,,0,0,0,,Ах... жоқ.
Dialogue: 0,0:02:48.90,0:02:51.73,Default,,0,0,0,,Бір жерде ми толқындарын блоктайтын жер болуы мүмкін.
Dialogue: 0,0:02:52.70,0:02:54.57,Default,,0,0,0,,Жарайды, мен іздеймін.
Dialogue: 0,0:02:55.24,0:02:57.57,Default,,0,0,0,,Уақыт шегі 20 минут.
Dialogue: 0,0:02:57.67,0:02:59.44,Default,,0,0,0,,Осы өлшеммен...
Dialogue: 0,0:02:59.84,0:03:01.88,Default,,0,0,0,,Тапсырмаларды бөлген дұрыс болар еді.
Dialogue: 0,0:03:03.18,0:03:04.35,Default,,0,0,0,,Екі адамдық камераға барыңыз
Dialogue: 0,0:03:10.18,0:03:11.59,Default,,0,0,0,,(Мылтық көтеріліп жатқан дыбыс)
Dialogue: 0,0:03:12.55,0:03:15.49,Default,,0,0,0,,Катарина, сен менімен кел.
Dialogue: 0,0:03:20.19,0:03:20.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:21.56,0:03:24.63,Default,,0,0,0,,Ал... бізде мұндай рөл бар.
Dialogue: 0,0:03:24.83,0:03:27.37,Default,,0,0,0,,Көптен бері істеп жүрсеңіз, түсінесіз.
Dialogue: 0,0:03:38.95,0:03:45.95,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:56.46,0:03:58.57,Default,,0,0,0,,Қош келдіңіз Иван Виски
Dialogue: 0,0:03:59.40,0:04:02.87,Default,,0,0,0,,Сіздің достарыңыз келген сияқты.
Dialogue: 0,0:04:03.84,0:04:06.81,Default,,0,0,0,,Тым болмаса қоштаса аламын деп үміттенемін.
Dialogue: 0,0:04:25.93,0:04:26.83,Default,,0,0,0,,(Мылтық көтеріліп жатқан дыбыс)
Dialogue: 0,0:04:37.77,0:04:38.64,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:41.31,0:04:42.54,Default,,0,0,0,,Ах (Игараши) Иә?
Dialogue: 0,0:04:43.58,0:04:44.88,Default,,0,0,0,,Капитан Игараши-
Dialogue: 0,0:04:44.95,0:04:47.95,Default,,0,0,0,,Сіз Zero Zero Number Cyborg-ті ұстай алдыңыз ба?
Dialogue: 0,0:04:48.58,0:04:51.42,Default,,0,0,0,,Жоқ, жағдай айтарлықтай өзгерді.
Dialogue: 0,0:04:52.45,0:04:54.36,Default,,0,0,0,,Біз кіммен күресуіміз керек?
Dialogue: 0,0:04:54.69,0:04:56.96,Default,,0,0,0,,Олар емес, Жаратушы.
Dialogue: 0,0:04:57.76,0:04:59.03,Default,,0,0,0,,Құтты болсын?
Dialogue: 0,0:05:00.63,0:05:03.33,Default,,0,0,0,,Нөлдік нөл саны киборгтарды бағындырғанда-
Dialogue: 0,0:05:03.40,0:05:06.50,Default,,0,0,0,,Біз кездестірген бейтаныс адам.
Dialogue: 0,0:05:07.00,0:05:10.37,Default,,0,0,0,,Бір мүше өзінің ерекше қабілетіне байланысты қызметтік міндетін атқару кезінде қаза тапты.
Dialogue: 0,0:05:10.84,0:05:13.57,Default,,0,0,0,,Біз оларды бұлай қалдыра алмаймыз.
Dialogue: 0,0:05:14.04,0:05:16.44,Default,,0,0,0,,Берекелі біздер үшін...
Dialogue: 0,0:05:16.68,0:05:19.05,Default,,0,0,0,,Оның қандай да бір қауіпті сюжеті бар.
Dialogue: 0,0:05:19.55,0:05:23.05,Default,,0,0,0,,Олар туралы заттай дәлелдер мен зерттеу материалдарын әкелдім.
Dialogue: 0,0:05:24.59,0:05:25.49,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:05:26.59,0:05:29.59,Default,,0,0,0,,Бұл Люси Дэвенпорт, ақпарат беруші.
Dialogue: 0,0:05:30.33,0:05:31.79,Default,,0,0,0,,Оның айғақтарының негізінде -
Dialogue: 0,0:05:31.89,0:05:34.66,Default,,0,0,0,,Тергеу құпия түрде жүргізілуі керек.
Dialogue: 0,0:05:35.10,0:05:36.80,Default,,0,0,0,,Мен шын жүректен өкінемін -
Dialogue: 0,0:05:37.40,0:05:40.00,Default,,0,0,0,,Біріккен Ұлттар Ұйымында күдікті адамдар бар.
Dialogue: 0,0:05:40.57,0:05:41.80,Default,,0,0,0,,Күдікті адам?
Dialogue: 0,0:05:42.50,0:05:43.40,Default,,0,0,0,,(Игараши күрсінуі)
Dialogue: 0,0:05:44.91,0:05:46.57,Default,,0,0,0,,Бұл директор Питер.
Dialogue: 0,0:05:47.51,0:05:49.54,Default,,0,0,0,,Ол бізді шебер басқарады
Dialogue: 0,0:05:49.61,0:05:52.75,Default,,0,0,0,,Киборгтарды жойып, Бақыттылардың күшіне ие болыңыз...
Dialogue: 0,0:05:53.41,0:05:54.55,Default,,0,0,0,,Игараши мырза-
Dialogue: 0,0:05:54.72,0:05:57.62,Default,,0,0,0,,Сіз біраз уақыттан бері не туралы айтып жүрсіз?
Dialogue: 0,0:05:57.92,0:05:58.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:58.99,0:06:01.69,Default,,0,0,0,,Директоры Женевада Шмидт болады.
Dialogue: 0,0:06:01.96,0:06:04.73,Default,,0,0,0,,Мен Петр есімді ешкімді білмеймін.
Dialogue: 0,0:06:05.86,0:06:07.66,Default,,0,0,0,,О... не?
Dialogue: 0,0:06:08.56,0:06:10.03,Default,,0,0,0,,Біз, Солтүстік Америка бірлігі...
Dialogue: 0,0:06:10.77,0:06:12.63,Default,,0,0,0,,Оның нұсқауы бойынша жұмыс істеді!
Dialogue: 0,0:06:13.87,0:06:17.00,Default,,0,0,0,,Солтүстік Америка бөлімшесіне жауапты адам - ​​Игараши-кун.
Dialogue: 0,0:06:17.47,0:06:18.64,Default,,0,0,0,,Сіз емессіз бе?
Dialogue: 0,0:06:19.11,0:06:19.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:20.71,0:06:21.91,Default,,0,0,0,,Не...
Dialogue: 0,0:06:26.45,0:06:27.12,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:27.98,0:06:28.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:30.08,0:06:33.72,Default,,0,0,0,,Сізге біраз демалу керек сияқты.
Dialogue: 0,0:06:41.16,0:06:42.50,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:06:43.87,0:06:44.87,Default,,0,0,0,,Хмм…
Dialogue: 0,0:07:07.59,0:07:08.52,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:07:11.63,0:07:14.46,Default,,0,0,0,,Біраз бұрын біреудің болғаны туралы деректер бар.
Dialogue: 0,0:07:16.80,0:07:17.70,Default,,0,0,0,,009
Dialogue: 0,0:07:18.67,0:07:21.14,Default,,0,0,0,,Мен Миннесотада болған оқиға үшін кешірім сұрағым келеді.
Dialogue: 0,0:07:21.57,0:07:22.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:23.10,0:07:24.51,Default,,0,0,0,,Бұл миссия болса да...
Dialogue: 0,0:07:24.77,0:07:26.91,Default,,0,0,0,,Сіздің өміріңізді алуға тырысты
Dialogue: 0,0:07:27.64,0:07:29.71,Default,,0,0,0,,Мен өкінемін.
Dialogue: 0,0:07:30.14,0:07:32.48,Default,,0,0,0,,Түсінбеушілік шешілсе, жақсы.
Dialogue: 0,0:07:33.15,0:07:36.58,Default,,0,0,0,,Бірге жұмыс жасасақ, Батаға қарсы тұрарымыз сөзсіз.
Dialogue: 0,0:07:42.72,0:07:45.23,Default,,0,0,0,,Уақытты басқаруға мүмкіндігіңіз бар ма?
Dialogue: 0,0:07:47.66,0:07:50.57,Default,,0,0,0,,Сол уақытта сіз уақытты қайтарасыз.
Dialogue: 0,0:07:54.80,0:07:55.67,Default,,0,0,0,,Катарина
Dialogue: 0,0:07:57.10,0:07:59.84,Default,,0,0,0,,Сіз де көрдіңіз бе? Бұл...
Dialogue: 0,0:08:01.68,0:08:03.14,Default,,0,0,0,,Джо, сен мені естисің бе?
Dialogue: 0,0:08:03.54,0:08:05.15,Default,,0,0,0,,А, Франсуаза?
Dialogue: 0,0:08:06.11,0:08:08.72,Default,,0,0,0,,Мен ескі сызба деректерін таптым.
Dialogue: 0,0:08:08.92,0:08:11.02,Default,,0,0,0,,Мұндай бөлме табылмады.
Dialogue: 0,0:08:11.75,0:08:13.22,Default,,0,0,0,,Бірақ мен оны қараған кезде...
Dialogue: 0,0:08:13.59,0:08:15.76,Default,,0,0,0,,Құрылыста тым көп материалдар пайдаланылды.
Dialogue: 0,0:08:16.82,0:08:18.86,Default,,0,0,0,,Сыртынан білмесең...
Dialogue: 0,0:08:19.09,0:08:21.76,Default,,0,0,0,,Олардың жертөле салу ықтималдығы жоғары.
Dialogue: 0,0:08:22.13,0:08:23.16,Default,,0,0,0,,Егер ол жер астында болса...
Dialogue: 0,0:08:23.60,0:08:26.23,Default,,0,0,0,,Сонымен қатар Иванның ми толқындарының неліктен бітеліп қалғанын түсіндіреді.
Dialogue: 0,0:08:26.73,0:08:29.04,Default,,0,0,0,,Бір жерде жер астында өткел болуы керек.
Dialogue: 0,0:08:29.74,0:08:31.57,Default,,0,0,0,,Түсіндім рахмет
Dialogue: 0,0:08:31.97,0:08:33.24,Default,,0,0,0,,Кеттік Катарина
Dialogue: 0,0:08:33.61,0:08:34.11,Default,,0,0,0,,Иә
Dialogue: 0,0:08:36.61,0:08:39.95,Default,,0,0,0,,Эй, жертөле қорқынышты болып барады.
Dialogue: 0,0:08:40.05,0:08:42.22,Default,,0,0,0,,Аруақтардан бас тартпа
Dialogue: 0,0:08:42.98,0:08:45.55,Default,,0,0,0,,Бұл С командасы, Блэссед пайда болды.
Dialogue: 0,0:08:45.65,0:08:46.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:50.26,0:08:54.66,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:08:54.86,0:08:56.56,Default,,0,0,0,,Ол пайда болды ма?
Dialogue: 0,0:08:58.17,0:09:00.30,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:00.77,0:09:01.74,Default,,0,0,0,,Хмм (006) Нгга
Dialogue: 0,0:09:01.80,0:09:05.17,Default,,0,0,0,,Хехе, біз сәл ерекше киборгпыз ғой, солай емес пе?
Dialogue: 0,0:09:05.57,0:09:06.91,Default,,0,0,0,,(оттың тыныс алу дыбысы)
Dialogue: 0,0:09:33.87,0:09:36.80,Default,,0,0,0,,Ей, эй, эй, сен енді берілесің бе?
Dialogue: 0,0:09:37.57,0:09:40.31,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:09:46.78,0:09:47.32,Default,,0,0,0,,Ммм
Dialogue: 0,0:09:54.22,0:09:56.36,Default,,0,0,0,,Бұл жігіт... тұзақ.
Dialogue: 0,0:09:58.33,0:10:00.83,Default,,0,0,0,,Не болды? 006 007
Dialogue: 0,0:10:01.23,0:10:02.90,Default,,0,0,0,,Тұтқындалған Al
Dialogue: 0,0:10:03.23,0:10:03.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:04.60,0:10:05.70,Default,,0,0,0,,Мен бірінші барамын.
Dialogue: 0,0:10:14.18,0:10:17.78,Default,,0,0,0,,Бір тозған киборгты жеңу үшін...
Dialogue: 0,0:10:17.85,0:10:19.98,Default,,0,0,0,,Бұл көп уақытты алатын сияқты.
Dialogue: 0,0:10:20.88,0:10:23.72,Default,,0,0,0,,009 қарапайым киборг емес
Dialogue: 0,0:10:24.09,0:10:27.02,Default,,0,0,0,,Хмм, бұл нені білдіреді?
Dialogue: 0,0:10:27.69,0:10:30.29,Default,,0,0,0,,Оның күші тек жеделдетуден де артық сияқты.
Dialogue: 0,0:10:31.09,0:10:33.93,Default,,0,0,0,,Мен Миннесота штатында уақыттың кері қайтқанын көрдім.
Dialogue: 0,0:10:34.26,0:10:35.16,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:10:35.86,0:10:40.17,Default,,0,0,0,,Сіз оның санасына үңіліп, жай ғана галлюцинация көрдіңіз.
Dialogue: 0,0:10:40.37,0:10:42.84,Default,,0,0,0,,Жоқ, бұл сөзсіз...
Dialogue: 0,0:10:43.10,0:10:45.97,Default,,0,0,0,,Сондықтан оны тірі қалдырасың ба?
Dialogue: 0,0:10:46.34,0:10:48.81,Default,,0,0,0,,Оның миына киборг операциясы жасалды...
Dialogue: 0,0:10:48.88,0:10:50.28,Default,,0,0,0,,Сағат
Dialogue: 0,0:10:50.85,0:10:51.75,Default,,0,0,0,,Жаман адамдар жоқ, және бұл оның басқа ерліктерімен салыстырғанда біршама қарапайым—
Dialogue: 0,0:10:52.05,0:10:54.72,Default,,0,0,0,,Тіпті сағаттары бізбен белгіленген адамдар да...
Dialogue: 0,0:10:55.02,0:10:57.99,Default,,0,0,0,,Күтпеген күшке ие болу мүмкіндігі бар.
Dialogue: 0,0:10:58.32,0:10:59.99,Default,,0,0,0,,Не айтпақшысың?
Dialogue: 0,0:11:00.72,0:11:02.19,Default,,0,0,0,,Үдемелі эволюция жоспары -
Dialogue: 0,0:11:02.69,0:11:06.39,Default,,0,0,0,,Бұл бізге қауіп төндіретін адамдарды жасай алатынымызды білдіреді.
Dialogue: 0,0:11:07.06,0:11:09.80,Default,,0,0,0,,Сағатты сәтті аяқтағандар...
Dialogue: 0,0:11:09.93,0:11:13.23,Default,,0,0,0,,Мойынсұнушылық адамды жақсы адам ететіні дәлелденді.
Dialogue: 0,0:11:14.00,0:11:14.97,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:11:15.40,0:11:19.01,Default,,0,0,0,,Сіз білетін кейбір адамдардың табысқа жету тарихы бар.
Dialogue: 0,0:11:21.81,0:11:23.14,Default,,0,0,0,,Жақында білеміз.
Dialogue: 0,0:11:23.84,0:11:26.75,Default,,0,0,0,,(ұшып бара жатқан дыбыс)
Dialogue: 0,0:11:32.19,0:11:33.69,Default,,0,0,0,,Хмм, ах…
Dialogue: 0,0:11:42.70,0:11:45.77,Default,,0,0,0,,Сен ояндың ба, Иван Виски?
Dialogue: 0,0:11:46.30,0:11:47.23,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:11:47.97,0:11:50.47,Default,,0,0,0,,Қазір император деп аталады
Dialogue: 0,0:11:51.44,0:11:53.94,Default,,0,0,0,,Бұл өте әдемі есім.
Dialogue: 0,0:11:54.91,0:11:57.45,Default,,0,0,0,,Бұл өткен деректерге негізделген атау.
Dialogue: 0,0:11:58.48,0:12:01.05,Default,,0,0,0,,Сонда меннен не керек?
Dialogue: 0,0:12:02.18,0:12:03.95,Default,,0,0,0,,Мен сендермен топтасқым келеді.
Dialogue: 0,0:12:05.32,0:12:07.25,Default,,0,0,0,,Сізде үлкен күш бар
Dialogue: 0,0:12:08.22,0:12:11.36,Default,,0,0,0,,Бұл ескірген киборгтар үшін тым көп болады.
Dialogue: 0,0:12:12.19,0:12:15.43,Default,,0,0,0,,Егер сіз бізбен бірігсеңіз, бұл қуатты тиімдірек пайдалана аласыз.
Dialogue: 0,0:12:16.33,0:12:17.90,Default,,0,0,0,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:12:19.07,0:12:21.07,Default,,0,0,0,,Ол не үшін қолданылады?
Dialogue: 0,0:12:21.94,0:12:23.00,Default,,0,0,0,,Біз қазір-
Dialogue: 0,0:12:23.34,0:12:26.24,Default,,0,0,0,,Адамзатты дамуға мәжбүрлеуге тырысу
Dialogue: 0,0:12:26.74,0:12:27.84,Default,,0,0,0,,Эволюция?
Dialogue: 0,0:12:28.94,0:12:32.91,Default,,0,0,0,,Біз бұдан былай ақымақ адамдарды елеусіз қалдыра алмаймыз.
Dialogue: 0,0:12:33.31,0:12:35.38,Default,,0,0,0,,Қайталанатын мағынасыз ұрыстар -
Dialogue: 0,0:12:35.45,0:12:37.75,Default,,0,0,0,,Білмей апат жасау-
Dialogue: 0,0:12:37.82,0:12:40.05,Default,,0,0,0,,Жоюға қарай тұрақты
Dialogue: 0,0:12:41.39,0:12:42.99,Default,,0,0,0,,Оны қалай тоқтатуға болады-
Dialogue: 0,0:12:43.96,0:12:46.43,Default,,0,0,0,,Біз оларды түбегейлі өзгертуіміз керек.
Dialogue: 0,0:12:47.50,0:12:48.83,Default,,0,0,0,,Уақыты келгенде айтамын.
Dialogue: 0,0:12:48.96,0:12:51.20,Default,,0,0,0,,Үдемелі эволюция дегеніміз...
Dialogue: 0,0:12:51.30,0:12:53.03,Default,,0,0,0,,Бұл тым өрескел емес пе?
Dialogue: 0,0:12:53.87,0:12:56.17,Default,,0,0,0,,Егер сіз адамзат үшін күрескен болсаңыз...
Dialogue: 0,0:12:56.24,0:12:58.07,Default,,0,0,0,,Сіз байқаған боларсыз.
Dialogue: 0,0:12:59.17,0:13:00.51,Default,,0,0,0,,Олар енді...
Dialogue: 0,0:13:00.98,0:13:03.38,Default,,0,0,0,,Қорғайтын құндылықтардың жоқтығы.
Dialogue: 0,0:13:04.51,0:13:05.45,Default,,0,0,0,,Шынында-
Dialogue: 0,0:13:05.91,0:13:09.38,Default,,0,0,0,,Мен адамзат эволюциялық тұйыққа тірелгенімен келісемін.
Dialogue: 0,0:13:10.99,0:13:14.26,Default,,0,0,0,,Сондықтан біз оны өз қолымызбен өзгертеміз.
Dialogue: 0,0:13:14.36,0:13:16.22,Default,,0,0,0,,Бұл адамзат үшін ме?
Dialogue: 0,0:13:17.12,0:13:18.86,Default,,0,0,0,,Дұрыс, Иван.
Dialogue: 0,0:13:26.53,0:13:27.84,Default,,0,0,0,,(Люси күрсінуі)
Dialogue: 0,0:13:28.00,0:13:29.54,Default,,0,0,0,,Амансың ба? Люси
Dialogue: 0,0:13:30.07,0:13:30.94,Default,,0,0,0,,Иә
Dialogue: 0,0:13:31.97,0:13:32.97,Default,,0,0,0,,Мен жеңілдім.
Dialogue: 0,0:13:33.54,0:13:35.94,Default,,0,0,0,,Тіпті директордың бар болуы да өшірілді...
Dialogue: 0,0:13:36.58,0:13:38.08,Default,,0,0,0,,Айналаңыздағы адамдар...
Dialogue: 0,0:13:38.15,0:13:40.41,Default,,0,0,0,,Менің жадымды басқарған болуы мүмкін
Dialogue: 0,0:13:41.58,0:13:44.55,Default,,0,0,0,,Мен бұл Блэксеннің құдіретінің бірі екеніне сенімдімін.
Dialogue: 0,0:13:45.82,0:13:46.82,Default,,0,0,0,,(Игараши күрсінуі)
Dialogue: 0,0:13:48.06,0:13:50.99,Default,,0,0,0,,Берекелі әлемді сахнадан басқарады...
Dialogue: 0,0:13:51.06,0:13:52.23,Default,,0,0,0,,Рас сияқты
Dialogue: 0,0:13:53.39,0:13:56.53,Default,,0,0,0,,Біз олардың бар екенін мүмкіндігінше тезірек жария етуіміз керек.
Dialogue: 0,0:13:57.30,0:13:58.47,Default,,0,0,0,,Бұл үлкен мәміле болады
Dialogue: 0,0:14:01.54,0:14:03.20,Default,,0,0,0,,ГБ! Чжантан көлі!
Dialogue: 0,0:14:04.10,0:14:05.47,Default,,0,0,0,,Кешіріңіз Джо
Dialogue: 0,0:14:05.97,0:14:08.01,Default,,0,0,0,,Тышқан қақпанына түсіп қалды
Dialogue: 0,0:14:08.08,0:14:09.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:09.18,0:14:10.14,Default,,0,0,0,,Уф
Dialogue: 0,0:14:10.21,0:14:15.22,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:15.32,0:14:16.35,Default,,0,0,0,,Куу
Dialogue: 0,0:14:17.15,0:14:18.99,Default,,0,0,0,,Al мінсіз!
Dialogue: 0,0:14:19.25,0:14:22.42,Default,,0,0,0,,Өзіңді осындай жерге қамап не істейсің?
Dialogue: 0,0:14:22.49,0:14:23.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:23.26,0:14:26.16,Default,,0,0,0,,(ұшқан ордалардың дыбысы)
Dialogue: 0,0:14:26.63,0:14:27.53,Default,,0,0,0,,Не?
Dialogue: 0,0:14:28.03,0:14:29.60,Default,,0,0,0,,Жүйке газы Al?
Dialogue: 0,0:14:35.24,0:14:36.10,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:36.20,0:14:37.94,Default,,0,0,0,,Бұл микро дрон!
Dialogue: 0,0:14:38.47,0:14:41.14,Default,,0,0,0,,Сізді шағып алсаңыз, бұл мәселе!
Dialogue: 0,0:14:42.01,0:14:43.24,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:43.31,0:14:45.05,Default,,0,0,0,,(есік қағу дыбысы)
Dialogue: 0,0:14:46.25,0:14:46.95,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:47.05,0:14:48.28,Default,,0,0,0,,Ммм.
Dialogue: 0,0:14:49.88,0:14:51.09,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:14:53.65,0:14:55.59,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:14:56.06,0:14:56.66,Default,,0,0,0,,Уф
Dialogue: 0,0:14:59.03,0:14:59.63,Default,,0,0,0,,Катарина!
Dialogue: 0,0:15:00.13,0:15:02.13,Default,,0,0,0,,009 Берекені қуу!
Dialogue: 0,0:15:02.63,0:15:03.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:04.13,0:15:06.90,Default,,0,0,0,,Мұны маған қалдырыңыз. Оның артынан жүр.
Dialogue: 0,0:15:09.97,0:15:11.64,Default,,0,0,0,,Барлығың, Аль, төмен түсіңдер.
Dialogue: 0,0:15:12.14,0:15:13.14,Default,,0,0,0,,(Тыныс алу жалынының дыбысы)
Dialogue: 0,0:15:18.61,0:15:21.12,Default,,0,0,0,,Жарайды, жарайды Аль.
Dialogue: 0,0:15:22.08,0:15:23.08,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:24.95,0:15:27.59,Default,,0,0,0,,(мүшелердің құлаған дыбысы)
Dialogue: 0,0:15:33.06,0:15:35.16,Default,,0,0,0,,Мен сіздің көзқарасыңызды түсінемін.
Dialogue: 0,0:15:35.46,0:15:38.30,Default,,0,0,0,,Бірақ егер организмдерді эволюцияға мәжбүрлесек...
Dialogue: 0,0:15:38.40,0:15:40.43,Default,,0,0,0,,Сөзсіз бұрмалану болады.
Dialogue: 0,0:15:41.17,0:15:43.57,Default,,0,0,0,,Біз бұған дейін қостық.
Dialogue: 0,0:15:44.00,0:15:46.37,Default,,0,0,0,,Тәжірибе нәтижесі 5%.
Dialogue: 0,0:15:47.44,0:15:49.98,Default,,0,0,0,,Сіздің ойыңызша, 5% құрбандық міндетті емес пе?
Dialogue: 0,0:15:50.11,0:15:54.05,Default,,0,0,0,,Жоқ, бұл «тірі қалу...» дегенді білдіреді.
Dialogue: 0,0:15:57.38,0:15:59.02,Default,,0,0,0,,фирма Al
Dialogue: 0,0:15:59.45,0:16:01.69,Default,,0,0,0,,(ұшқышсыз ұшақтың дыбысы)
Dialogue: 0,0:16:01.99,0:16:03.02,Default,,0,0,0,,Аха
Dialogue: 0,0:16:03.59,0:16:05.63,Default,,0,0,0,,Әл кірген жері ме?
Dialogue: 0,0:16:06.19,0:16:08.23,Default,,0,0,0,,Ауа сорғыштан -
Dialogue: 0,0:16:08.43,0:16:10.56,Default,,0,0,0,,Ол сүзгіден өтті ме?
Dialogue: 0,0:16:11.17,0:16:12.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:12.27,0:16:13.67,Default,,0,0,0,,500 метр радиустағы тұрғындар да көшірілді.
Dialogue: 0,0:16:14.37,0:16:16.64,Default,,0,0,0,,Сіз мұны естідіңіз бе? Дауыс...
Dialogue: 0,0:16:17.50,0:16:19.97,Default,,0,0,0,,О, мен естідім.
Dialogue: 0,0:16:20.57,0:16:22.04,Default,,0,0,0,,Не естідің?
Dialogue: 0,0:16:22.71,0:16:26.25,Default,,0,0,0,,(Айналада ұшып бара жатқан мүшелердің дыбысы)
Dialogue: 0,0:16:26.98,0:16:27.98,Default,,0,0,0,,Al соқтығысады!
Dialogue: 0,0:16:28.08,0:16:29.72,Default,,0,0,0,,Сізді тағы да басқарып жатыр ма?
Dialogue: 0,0:16:30.32,0:16:31.19,Default,,0,0,0,,Жоқ
Dialogue: 0,0:16:31.72,0:16:33.29,Default,,0,0,0,,Ах, бірақ-
Dialogue: 0,0:16:33.49,0:16:36.46,Default,,0,0,0,,Олардың ми толқындары мен қан қысымында ауытқулар бар.
Dialogue: 0,0:16:36.76,0:16:38.16,Default,,0,0,0,,Не?
Dialogue: 0,0:16:38.59,0:16:40.49,Default,,0,0,0,,Ей эй эй эй эй эй
Dialogue: 0,0:16:40.59,0:16:42.36,Default,,0,0,0,,Асықпа, Әл.
Dialogue: 0,0:16:43.03,0:16:46.17,Default,,0,0,0,,(007-нің ыңырануы)
Dialogue: 0,0:16:46.23,0:16:47.60,Default,,0,0,0,,(007-нің ыңырсыуы)
Dialogue: 0,0:16:47.70,0:16:49.20,Default,,0,0,0,,Иә
Dialogue: 0,0:16:49.57,0:16:51.07,Default,,0,0,0,,Сен не істеп жатырсың, Әл?
Dialogue: 0,0:16:53.27,0:16:55.38,Default,,0,0,0,,Қарғыс атсын, бұл жігіттер...
Dialogue: 0,0:16:55.74,0:16:57.41,Default,,0,0,0,,Әл Джоға ұқсайды!
Dialogue: 0,0:17:16.26,0:17:18.27,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:17:25.37,0:17:26.31,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:17:26.71,0:17:27.31,Default,,0,0,0,,«Реакция жоқ»
Dialogue: 0,0:17:27.31,0:17:28.11,Default,,0,0,0,,«Реакция жоқ»
Dialogue: 0,0:17:27.31,0:17:28.11,Default,,0,0,0,,Джо
Dialogue: 0,0:17:28.11,0:17:29.41,Default,,0,0,0,,«Реакция жоқ»
Dialogue: 0,0:17:37.38,0:17:38.19,Default,,0,0,0,,Ах
Dialogue: 0,0:17:41.52,0:17:42.26,Default,,0,0,0,,Иван!
Dialogue: 0,0:17:47.13,0:17:48.56,Default,,0,0,0,,Иванды не істейсің?
Dialogue: 0,0:17:52.57,0:17:55.47,Default,,0,0,0,,Балалар, сендер не ойлап жатырсыңдар?
Dialogue: 0,0:17:59.17,0:17:59.81,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:18:00.07,0:18:00.74,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:18:00.81,0:18:02.81,Default,,0,0,0,,(009-ның мұңды дауысы)
Dialogue: 0,0:18:05.18,0:18:06.41,Default,,0,0,0,,009
Dialogue: 0,0:18:06.85,0:18:09.38,Default,,0,0,0,,Құдіретіңді көрсетейін
Dialogue: 0,0:18:10.15,0:18:12.39,Default,,0,0,0,,Питер, сен неге мұндасың?
Dialogue: 0,0:18:12.55,0:18:14.72,Default,,0,0,0,,Баяу байланыстырғыш
Dialogue: 0,0:18:15.29,0:18:16.09,Default,,0,0,0,,(009-ның ентігу дауысы)
Dialogue: 0,0:18:20.73,0:18:22.46,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:18:22.63,0:18:24.83,Default,,0,0,0,,Ол жетістік тарихы
Dialogue: 0,0:18:25.57,0:18:26.70,Default,,0,0,0,,Петр...
Dialogue: 0,0:18:27.37,0:18:28.57,Default,,0,0,0,,Адамдар ше?
Dialogue: 0,0:18:29.87,0:18:31.27,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:18:31.84,0:18:32.81,Default,,0,0,0,,Катарина
Dialogue: 0,0:18:33.41,0:18:35.21,Default,,0,0,0,,Сіз де Батабансыз ба?
Dialogue: 0,0:18:36.34,0:18:37.41,Default,,0,0,0,,(ұшып бара жатқан дыбыс)
Dialogue: 0,0:18:38.68,0:18:39.55,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:18:43.22,0:18:43.82,Default,,0,0,0,,(Джоның тыныс алуы)
Dialogue: 0,0:18:44.49,0:18:45.19,Default,,0,0,0,,Катарина!
Dialogue: 0,0:18:48.69,0:18:53.36,Default,,0,0,0,,(кездейсоқ ату дыбысы)
Dialogue: 0,0:18:53.43,0:18:54.63,Default,,0,0,0,,003！
Dialogue: 0,0:18:54.73,0:18:57.20,Default,,0,0,0,,Мүшелердің медициналық деректерін тексеру
Dialogue: 0,0:18:57.60,0:18:58.87,Default,,0,0,0,,(003 тыныс алуы)
Dialogue: 0,0:18:59.40,0:19:01.24,Default,,0,0,0,,Не болды? 003
Dialogue: 0,0:19:01.47,0:19:04.24,Default,,0,0,0,,Мүшелердің қан қысымы қалыптан тыс жоғары.
Dialogue: 0,0:19:04.61,0:19:05.81,Default,,0,0,0,,Ал менің миымда...
Dialogue: 0,0:19:05.87,0:19:08.34,Default,,0,0,0,,Мен адреналиннің өлімге әкелетін дозасын шығарамын.
Dialogue: 0,0:19:08.48,0:19:09.71,Default,,0,0,0,,Қауіпті жағдай
Dialogue: 0,0:19:10.28,0:19:11.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:11.88,0:19:13.81,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:19:14.65,0:19:16.65,Default,,0,0,0,,Қан қысымы 250-ден асты!
Dialogue: 0,0:19:16.92,0:19:18.79,Default,,0,0,0,,Дене қызуы да тез көтеріледі.
Dialogue: 0,0:19:19.32,0:19:20.19,Default,,0,0,0,,Мен үшін алғаш рет!
Dialogue: 0,0:19:20.75,0:19:22.42,Default,,0,0,0,,Тезірек тоқтатыңыз!
Dialogue: 0,0:19:22.59,0:19:24.26,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:19:24.76,0:19:26.33,Default,,0,0,0,,Маска ішінде-
Dialogue: 0,0:19:26.56,0:19:28.80,Default,,0,0,0,,Көзімнен, құлағымнан қан кетті.
Dialogue: 0,0:19:29.36,0:19:30.56,Default,,0,0,0,,(1-мүшенің жылаған дауысы)
Dialogue: 0,0:19:32.50,0:19:33.53,Default,,0,0,0,,Жарық...
Dialogue: 0,0:19:33.80,0:19:35.34,Default,,0,0,0,,Мен жарықты көремін
Dialogue: 0,0:19:35.60,0:19:38.81,Default,,0,0,0,,Әлем енді менікі!
Dialogue: 0,0:19:39.87,0:19:41.64,Default,,0,0,0,,Жо-жоқ… мүмкін емес… осы сөмкенің ішінде не бар!
Dialogue: 0,0:19:44.44,0:19:46.38,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:19:47.48,0:19:49.22,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:49.52,0:19:51.19,Default,,0,0,0,,Жүрек-өкпенің тоқтауы…
Dialogue: 0,0:19:56.72,0:19:58.39,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:20:04.80,0:20:06.63,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:20:07.77,0:20:09.67,Default,,0,0,0,,(төбелестің дыбысы)
Dialogue: 0,0:20:10.60,0:20:13.47,Default,,0,0,0,,Сіз қалай ойлайсыз? Сағат жинаған адамдар ше?
Dialogue: 0,0:20:14.27,0:20:16.81,Default,,0,0,0,,Сіздің физикалық қабілеттеріңіз айтарлықтай жақсарған сияқты.
Dialogue: 0,0:20:17.81,0:20:19.21,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:20:19.95,0:20:22.38,Default,,0,0,0,,Олар тамаша және ұтымды...
Dialogue: 0,0:20:22.68,0:20:24.35,Default,,0,0,0,,Ол мойынсұнғыш адам.
Dialogue: 0,0:20:25.39,0:20:26.32,Default,,0,0,0,,(Рион) Егер сұраса, олар әлемнің кез келген түкпіріне барады —
Dialogue: 0,0:20:26.59,0:20:29.62,Default,,0,0,0,,Менің досым деп атайтын адамым бар.
Dialogue: 0,0:20:31.56,0:20:33.49,Default,,0,0,0,,Тарихи көшбасшылар
Dialogue: 0,0:20:33.59,0:20:35.96,Default,,0,0,0,,Жалғыздықтан мен таныстар іздедім.
Dialogue: 0,0:20:36.70,0:20:38.00,Default,,0,0,0,,Таныс – бұл...
Dialogue: 0,0:20:38.83,0:20:41.27,Default,,0,0,0,,Бұл қатынас тең болғанда қолданылатын сөз.
Dialogue: 0,0:20:41.97,0:20:43.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:44.57,0:20:45.37,Default,,0,0,0,,Ммм
Dialogue: 0,0:20:47.64,0:20:48.34,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:20:48.71,0:20:50.31,Default,,0,0,0,,Уау...
Dialogue: 0,0:20:53.45,0:20:55.42,Default,,0,0,0,,Баяу киборг
Dialogue: 0,0:20:56.25,0:20:57.78,Default,,0,0,0,,Ол жеделдету керек
Dialogue: 0,0:20:58.89,0:21:01.46,Default,,0,0,0,,Сіздің қорқынышыңыз негізсіз болған сияқты, Линкер.
Dialogue: 0,0:21:01.89,0:21:04.86,Default,,0,0,0,,Сағаты бар адаммен ешкім бәсекелесе алмайды...
Dialogue: 0,0:21:05.26,0:21:06.99,Default,,0,0,0,,Бұл болмашы қоқыс.
Dialogue: 0,0:21:07.83,0:21:09.70,Default,,0,0,0,,Неліктен ол одан әрі жылдамдамайды?
Dialogue: 0,0:21:10.73,0:21:12.47,Default,,0,0,0,,Неліктен уақытты кері айналдыруға болмайды?
Dialogue: 0,0:21:12.63,0:21:14.03,Default,,0,0,0,,(009 тыныс алуы)
Dialogue: 0,0:21:27.38,0:21:27.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:29.62,0:21:32.39,Default,,0,0,0,,Сіздің рөліңіз осы жерде аяқталады.
Dialogue: 0,0:21:38.06,0:21:40.63,Default,,0,0,0,,Сен де, Джо Шимамура
Dialogue: 0,0:21:40.76,0:21:41.86,Default,,0,0,0,,Уау
Dialogue: 0,0:21:41.93,0:21:42.83,Default,,0,0,0,,Уф
Dialogue: 0,0:21:44.30,0:21:46.33,Default,,0,0,0,,(009 тыныс алуы)
Dialogue: 0,0:21:47.07,0:21:49.00,Default,,0,0,0,,Оны тоқтату 009
Dialogue: 0,0:21:50.77,0:21:52.57,Default,,0,0,0,,Иван Неге?
Dialogue: 0,0:21:53.94,0:21:57.41,Default,,0,0,0,,Олардың бар екендігі мені қызықтырды.
Dialogue: 0,0:21:57.88,0:21:59.45,Default,,0,0,0,,Сіз не туралы айтып тұрсыз?
Dialogue: 0,0:21:59.81,0:22:02.75,Default,,0,0,0,,Are you by any chance being manipulated by them too?
Dialogue: 0,0:22:03.68,0:22:04.75,Default,,0,0,0,,Мұнда келіңіз
Dialogue: 0,0:22:04.82,0:22:05.72,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:22:06.99,0:22:07.75,Default,,0,0,0,,Иван!
Dialogue: 0,0:22:08.32,0:22:09.36,Default,,0,0,0,,(009 тыныс алуы)
Dialogue: 0,0:22:10.39,0:22:11.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:15.00,0:22:16.96,Default,,0,0,0,,Не деп тұрсың, Иван?
Dialogue: 0,0:22:18.00,0:22:20.63,Default,,0,0,0,,Беттердің телепортациясы?
Dialogue: 0,0:22:21.37,0:22:22.90,Default,,0,0,0,,3000 жыл өмір сүру...
Dialogue: 0,0:22:22.97,0:22:26.37,Default,,0,0,0,,There are still things I can experience for the first time.
Dialogue: 0,0:22:26.74,0:22:28.04,Default,,0,0,0,,Күте тұрыңыз, Иван!
Dialogue: 0,0:22:28.58,0:22:29.54,Default,,0,0,0,,Иә.
Dialogue: 0,0:22:29.64,0:22:30.48,Default,,0,0,0,,Иван!
Dialogue: 0,0:22:31.48,0:22:32.68,Default,,0,0,0,,Мен үшін алаңдама
Dialogue: 0,0:22:33.81,0:22:35.82,Default,,0,0,0,,Сізде бір нәрсе істеу керек.
Dialogue: 0,0:22:37.12,0:22:38.39,Default,,0,0,0,,Иван!
Dialogue: 0,0:22:44.59,0:22:46.49,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:22:52.67,0:22:56.40,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:22:57.04,0:22:59.11,Default,,0,0,0,,Эй, бірдеңе естіп тұрсың ба?
Dialogue: 0,0:22:59.57,0:23:00.91,Default,,0,0,0,,Жарылғыш Al?
Dialogue: 0,0:23:02.14,0:23:03.44,Default,,0,0,0,,Нашар Аль
Dialogue: 0,0:23:03.58,0:23:04.95,Default,,0,0,0,,Асығыңыз, осы жаққа.
Dialogue: 0,0:23:10.95,0:23:11.85,Default,,0,0,0,,Сіз де келесіз
Dialogue: 0,0:23:16.12,0:23:18.96,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:23:20.46,0:23:26.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory