Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.33,0:00:08.60,Default,,0,0,0,,(бұршақтың жауған дыбысы)
Dialogue: 0,0:00:18.78,0:00:21.62,Default,,0,0,0,,Ей, жау қайда?
Dialogue: 0,0:00:23.05,0:00:26.65,Default,,0,0,0,,002 003 Асығыңыз!
Dialogue: 0,0:00:26.76,0:00:28.09,Default,,0,0,0,,Уау (Чжанху: 006) Ия!
Dialogue: 0,0:00:38.60,0:00:40.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:40.50,0:00:41.64,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:00:43.14,0:00:44.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:57.69,0:01:01.69,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:01:01.76,0:01:03.29,Default,,0,0,0,,Иә, мен қазір сонда барамын.
Dialogue: 0,0:01:03.43,0:01:05.39,Default,,0,0,0,,Айя!
Dialogue: 0,0:01:08.73,0:01:09.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:10.67,0:01:11.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:11.50,0:01:13.50,Default,,0,0,0,,(құлаған дыбыс)
Dialogue: 0,0:01:13.60,0:01:15.44,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:16.74,0:01:17.57,Default,,0,0,0,,Джо!
Dialogue: 0,0:03:06.61,0:03:10.55,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:03:18.53,0:03:20.56,Default,,0,0,0,,(Ішінде қозғалатын заттардың дыбысы)
Dialogue: 0,0:03:41.92,0:03:42.95,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:45.92,0:03:46.82,Default,,0,0,0,,Айтпақшы, сіз кімсіз өзі?
Dialogue: 0,0:04:05.61,0:04:07.81,Default,,0,0,0,,Иван, Ал іш.
Dialogue: 0,0:04:08.58,0:04:09.61,Default,,0,0,0,,Уху…
Dialogue: 0,0:04:15.98,0:04:19.02,Default,,0,0,0,,Барлығы өзін жақсы ұстайды.
Dialogue: 0,0:04:19.82,0:04:21.02,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:04:21.92,0:04:22.79,Default,,0,0,0,,Хмм…
Dialogue: 0,0:04:24.66,0:04:25.69,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:04:33.64,0:04:38.27,Default,,0,0,0,,Сіз бізге не айтқыңыз келеді, Дэвенпорт мырза?
Dialogue: 0,0:04:38.64,0:04:41.44,Default,,0,0,0,,Сіздің өткеніңіз туралы, әрине.
Dialogue: 0,0:04:42.04,0:04:42.91,Default,,0,0,0,,Өткен?
Dialogue: 0,0:04:44.01,0:04:45.38,Default,,0,0,0,,Алданбаңыз!
Dialogue: 0,0:04:45.88,0:04:48.85,Default,,0,0,0,,Біріккен Ұлттар Ұйымы мен үкіметтері осы уақытқа дейін нені жасырып келді...
Dialogue: 0,0:04:49.02,0:04:51.45,Default,,0,0,0,,Сіздің әскери әрекеттеріңізге қатысты.
Dialogue: 0,0:04:51.75,0:04:52.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:53.42,0:04:54.99,Default,,0,0,0,,Әскери әрекет? !
Dialogue: 0,0:04:55.56,0:04:56.46,Default,,0,0,0,,Доктор…
Dialogue: 0,0:04:56.56,0:04:58.29,Default,,0,0,0,,Дұшпанды жариялауға адамды қате таңдамаң!
Dialogue: 0,0:04:58.43,0:05:00.86,Default,,0,0,0,,Түсінбеушілік бар сияқты.
Dialogue: 0,0:05:01.33,0:05:02.63,Default,,0,0,0,,Бұл түсінбеушілік пе?
Dialogue: 0,0:05:05.03,0:05:09.64,Default,,0,0,0,,Бұл 1965 жыл, Токиода алып робот пайда болды...
Dialogue: 0,0:05:09.70,0:05:11.61,Default,,0,0,0,,Бұл үлкен шу болған кездегі фото.
Dialogue: 0,0:05:12.71,0:05:16.41,Default,,0,0,0,,Мына суреттегі адам сізге ұқсайды, солай ма? !
Dialogue: 0,0:05:17.38,0:05:21.38,Default,,0,0,0,,Бұл келесі жылы, 1966 жылы Вьетнамда түсірілген фотосурет.
Dialogue: 0,0:05:21.95,0:05:24.99,Default,,0,0,0,,Мына біртүрлі қара қарудың қасында кім тұр?
Dialogue: 0,0:05:25.32,0:05:25.92,Default,,0,0,0,,Сіз емессіз бе?
Dialogue: 0,0:05:27.69,0:05:32.43,Default,,0,0,0,,Және сол жылы Магма аралы кенеттен жарылып, Эгей теңізіне батып кетті.
Dialogue: 0,0:05:33.53,0:05:37.63,Default,,0,0,0,,Атқылаудың жанында ұшып бара жатқан бұл адам сіз бе?
Dialogue: 0,0:05:38.40,0:05:38.93,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:05:40.67,0:05:43.04,Default,,0,0,0,,Балалар, әлі де суреттерің бар.
Dialogue: 0,0:05:43.47,0:05:46.94,Default,,0,0,0,,1967 Таяу Шығыс 75 Боливия
Dialogue: 0,0:05:47.68,0:05:51.68,Default,,0,0,0,,76 Венесуэла 79 Оңтүстік-Шығыс Азия
Dialogue: 0,0:05:51.78,0:05:53.55,Default,,0,0,0,,85 Нью-Йорк
Dialogue: 0,0:05:54.08,0:05:56.82,Default,,0,0,0,,Қандай да бір жанжал немесе оқиға болған жерде-
Dialogue: 0,0:05:57.42,0:05:59.95,Default,,0,0,0,,Сізді көп рет көрдіңіз.
Dialogue: 0,0:06:00.42,0:06:03.39,Default,,0,0,0,,Әрқашан қазіргідей қалыңыз.
Dialogue: 0,0:06:05.53,0:06:07.53,Default,,0,0,0,,Мұны қалай түсіндіресіз?
Dialogue: 0,0:06:08.36,0:06:10.53,Default,,0,0,0,,Балалар, сендер киборгсыңдар, солай ма?
Dialogue: 0,0:06:11.00,0:06:12.90,Default,,0,0,0,,Доктор Гилмор ... жасады.
Dialogue: 0,0:06:19.41,0:06:20.07,Default,,0,0,0,,(қастрөлді қою дыбысы)
Dialogue: 0,0:06:21.01,0:06:21.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:23.71,0:06:26.68,Default,,0,0,0,,Сіз бізді шынымен жақсы түсінесіз бе?
Dialogue: 0,0:06:29.68,0:06:30.85,Default,,0,0,0,,Әрине!
Dialogue: 0,0:06:33.72,0:06:37.69,Default,,0,0,0,,Код атауы 001 Иван Виски Орысша-
Dialogue: 0,0:06:38.56,0:06:40.96,Default,,0,0,0,,Кемеңгер ақыл мен табиғаттан тыс күштері бар
Dialogue: 0,0:06:42.60,0:06:46.70,Default,,0,0,0,,Сондай-ақ 002 Джет Link American-
Dialogue: 0,0:06:47.14,0:06:49.50,Default,,0,0,0,,Дыбыстан жоғары жылдамдықпен ұшуға қабілетті
Dialogue: 0,0:06:50.81,0:06:55.11,Default,,0,0,0,,003 Франсуа Арнеур Француз-
Dialogue: 0,0:06:55.54,0:06:57.81,Default,,0,0,0,,Адамнан тыс есту және көру қабілеті бар
Dialogue: 0,0:06:59.01,0:07:03.05,Default,,0,0,0,,004 Альберт Генрих Герман-
Dialogue: 0,0:07:04.02,0:07:05.99,Default,,0,0,0,,Бүкіл денеге кіріктірілген қарулар
Dialogue: 0,0:07:07.62,0:07:11.13,Default,,0,0,0,,005 Джеронимо кіші американдық-
Dialogue: 0,0:07:12.06,0:07:14.73,Default,,0,0,0,,Денесі болаттан жасалған және адамдық күшке ие
Dialogue: 0,0:07:15.76,0:07:19.13,Default,,0,0,0,,006 Чжанху қытай -
Dialogue: 0,0:07:19.67,0:07:21.54,Default,,0,0,0,,Ондаған мың градустық жылу сәулелерімен тыныс алады
Dialogue: 0,0:07:21.84,0:07:23.50,Default,,0,0,0,,Айя
Dialogue: 0,0:07:24.97,0:07:28.58,Default,,0,0,0,,007 Ұлыбритания Британдық -
Dialogue: 0,0:07:28.91,0:07:31.68,Default,,0,0,0,,Молекулалық түрлену арқылы кез келген затқа айнала алады
Dialogue: 0,0:07:32.85,0:07:34.22,Default,,0,0,0,,Хэ-хэ-хэ!
Dialogue: 0,0:07:34.92,0:07:38.05,Default,,0,0,0,,008 Пюмма Кения-
Dialogue: 0,0:07:38.65,0:07:40.92,Default,,0,0,0,,Терең теңіз әрекеттеріне қабілетті
Dialogue: 0,0:07:41.89,0:07:45.63,Default,,0,0,0,,және 009 Джо Шимамура жапондық-
Dialogue: 0,0:07:46.53,0:07:48.66,Default,,0,0,0,,Өте жоғары жылдамдықты қозғалыс мүмкіндігіне ие
Dialogue: 0,0:07:50.50,0:07:52.53,Default,,0,0,0,,1960 жылдары -
Dialogue: 0,0:07:52.93,0:07:55.07,Default,,0,0,0,,Жоғары өнімді киборг технологиясы болды...
Dialogue: 0,0:07:55.17,0:07:56.97,Default,,0,0,0,,Сену қиын...
Dialogue: 0,0:07:57.67,0:08:00.17,Default,,0,0,0,,Сіз шынымен осылай өмір сүресіз.
Dialogue: 0,0:08:02.81,0:08:05.78,Default,,0,0,0,,Дұрыс айтасың, біз киборгпыз.
Dialogue: 0,0:08:06.78,0:08:09.72,Default,,0,0,0,,Бірақ мен оны ұнатпадым...
Dialogue: 0,0:08:10.12,0:08:12.92,Default,,0,0,0,,Мен ұрысқан жоқпын, өйткені біреу маған...
Dialogue: 0,0:08:13.49,0:08:13.99,Default,,0,0,0,,А...? !
Dialogue: 0,0:08:23.97,0:08:25.17,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:08:27.84,0:08:28.67,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:08:29.04,0:08:32.84,Default,,0,0,0,,Уф, уф, сен не істейсің...?
Dialogue: 0,0:08:43.22,0:08:45.15,Default,,0,0,0,,А... бұл қайда?
Dialogue: 0,0:08:46.12,0:08:47.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:50.99,0:08:51.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:52.06,0:08:53.56,Default,,0,0,0,,(шабуыл дыбысы)
Dialogue: 0,0:08:53.93,0:08:54.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:55.00,0:08:56.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:56.16,0:08:57.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:58.73,0:09:00.94,Default,,0,0,0,,(еденде домалап жатқан дыбыс)
Dialogue: 0,0:09:04.07,0:09:07.14,Default,,0,0,0,,Мен... тірімін бе?
Dialogue: 0,0:09:09.01,0:09:10.18,Default,,0,0,0,,Каир өте үлкен
Dialogue: 0,0:09:12.05,0:09:12.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:14.28,0:09:15.58,Default,,0,0,0,,(бомба дыбысы)
Dialogue: 0,0:09:15.92,0:09:18.09,Default,,0,0,0,,Уф... уау
Dialogue: 0,0:09:19.85,0:09:21.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:26.16,0:09:27.23,Default,,0,0,0,,Уф
Dialogue: 0,0:09:27.86,0:09:28.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:30.03,0:09:35.00,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:09:35.30,0:09:36.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:37.91,0:09:40.11,Default,,0,0,0,,Мен қандаймын...
Dialogue: 0,0:09:41.58,0:09:45.81,Default,,0,0,0,,Жарайсың 009 Тест өте сәтті өтті.
Dialogue: 0,0:09:54.02,0:09:57.66,Default,,0,0,0,,Бізді ұрлап кеткен және өзгерткен...
Dialogue: 0,0:09:58.06,0:10:01.33,Default,,0,0,0,,Бұл өзін Black Ghost деп атаған жұмбақ ұйым болды.
Dialogue: 0,0:10:02.20,0:10:06.00,Default,,0,0,0,,Біз ядролық соғыс дәуіріндегі жаңа сарбаздармыз.
Dialogue: 0,0:10:06.87,0:10:09.27,Default,,0,0,0,,Дүние жүзіне үстемдік ету мақсатында құрылған.
Dialogue: 0,0:10:10.10,0:10:13.17,Default,,0,0,0,,Сіз ештеңе білмей өтінішті қабылдадыңыз ба?
Dialogue: 0,0:10:13.81,0:10:18.65,Default,,0,0,0,,Кибернетика арқылы адамның функцияларын кеңейтемін.
Dialogue: 0,0:10:18.75,0:10:20.88,Default,,0,0,0,,Мен мұны зерттеу үшін деп ойладым.
Dialogue: 0,0:10:21.92,0:10:23.32,Default,,0,0,0,,Пәндер сонымен қатар...
Dialogue: 0,0:10:23.62,0:10:27.19,Default,,0,0,0,,Маған оның ерікті донор екенін айтты.
Dialogue: 0,0:10:27.72,0:10:32.23,Default,,0,0,0,,Дәрігер Қара Елестің зұлым ұйым екенін түсінді.
Dialogue: 0,0:10:32.96,0:10:37.23,Default,,0,0,0,,Ол бізді басқарып, оларға қарсы күресуді ұйғарды.
Dialogue: 0,0:10:37.80,0:10:38.73,Default,,0,0,0,,Сондықтан-
Dialogue: 0,0:10:38.90,0:10:41.84,Default,,0,0,0,,Қара елес деп аталатын ұйымға не болды?
Dialogue: 0,0:10:46.87,0:10:50.11,Default,,0,0,0,,Ұзақ шайқастан кейін біз...
Dialogue: 0,0:10:50.68,0:10:54.25,Default,,0,0,0,,Ақыры біз Қара Елесті жойып үлгердік.
Dialogue: 0,0:11:07.16,0:11:10.26,Default,,0,0,0,,Ол заттардың маған пайдасы жоқ.
Dialogue: 0,0:11:11.00,0:11:15.87,Default,,0,0,0,,Ешбір күш мені жоя алмайды.
Dialogue: 0,0:11:16.04,0:11:17.14,Default,,0,0,0,,Не? !
Dialogue: 0,0:11:17.30,0:11:19.84,Default,,0,0,0,,Сіз мені жойсаңыз да,
Dialogue: 0,0:11:19.97,0:11:23.28,Default,,0,0,0,,Ол Қара Елесті жоймайды.
Dialogue: 0,0:11:23.68,0:11:24.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:24.28,0:11:30.28,Default,,0,0,0,,Өйткені мен де Қара Елес жасушаларының бірі ғанамын.
Dialogue: 0,0:11:31.92,0:11:34.42,Default,,0,0,0,,Ха... уф...
Dialogue: 0,0:11:34.96,0:11:38.89,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:11:38.96,0:11:40.13,Default,,0,0,0,,Электромагниттік тосқауыл!
Dialogue: 0,0:11:40.26,0:11:42.10,Default,,0,0,0,,Пайдасыз заттар
Dialogue: 0,0:11:42.26,0:11:43.20,Default,,0,0,0,,Сонда!
Dialogue: 0,0:11:43.80,0:11:44.30,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:11:48.84,0:11:50.07,Default,,0,0,0,,Мен бас тартуым керек пе?
Dialogue: 0,0:11:51.01,0:11:52.24,Default,,0,0,0,,Қандай ысырап!
Dialogue: 0,0:11:53.17,0:11:56.08,Default,,0,0,0,,Егер сіз жай ғана ұяшық болсаңыз...
Dialogue: 0,0:11:56.38,0:12:00.18,Default,,0,0,0,,Мен әрбір ұяшықты соңғысына дейін жоямын!
Dialogue: 0,0:12:02.78,0:12:05.22,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:12:05.79,0:12:09.19,Default,,0,0,0,,Себебі Қара Елесті өлтіру үшін...
Dialogue: 0,0:12:09.32,0:12:14.26,Default,,0,0,0,,Жер бетіндегі барлық адамдар өлтірілуі керек.
Dialogue: 0,0:12:15.03,0:12:16.16,Default,,0,0,0,,Бұл нені білдіреді? !
Dialogue: 0,0:12:16.86,0:12:20.30,Default,,0,0,0,,Қара елес дегеніміз не? Адамдардың жүрегінен...
Dialogue: 0,0:12:20.40,0:12:22.10,Default,,0,0,0,,Өйткені ол дүниеге келді.
Dialogue: 0,0:12:22.44,0:12:27.17,Default,,0,0,0,,Адамның зұлымдығы, шіркін қалауы жаралған...
Dialogue: 0,0:12:27.27,0:12:29.08,Default,,0,0,0,,Өйткені бұл құбыжық
Dialogue: 0,0:12:29.98,0:12:31.15,Default,,0,0,0,,Ха...
Dialogue: 0,0:12:31.75,0:12:34.12,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:37.45,0:12:41.12,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:43.42,0:12:44.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:45.39,0:12:50.87,Default,,0,0,0,,Қараңызшы, 009 Black Ghost аяқталды!
Dialogue: 0,0:12:56.87,0:13:01.24,Default,,0,0,0,,Ах... бұл фантастика сияқты.
Dialogue: 0,0:13:01.84,0:13:03.98,Default,,0,0,0,,Бұл солай болуы мүмкін.
Dialogue: 0,0:13:04.35,0:13:08.48,Default,,0,0,0,,Содан кейін, содан кейін Қара елес және басқалар жойылады ...
Dialogue: 0,0:13:08.85,0:13:11.22,Default,,0,0,0,,Балалар, неге төбелестіңдер?
Dialogue: 0,0:13:11.35,0:13:15.56,Default,,0,0,0,,Олардың кетуі соғыстың жойылғанын білдірмейді.
Dialogue: 0,0:13:15.96,0:13:19.13,Default,,0,0,0,,Содан бері біз халықаралық қақтығыстарға...
Dialogue: 0,0:13:19.19,0:13:23.16,Default,,0,0,0,,Мен күдікті әрекет жасаған адамдарға қарсы күресуді жалғастырдым.
Dialogue: 0,0:13:24.23,0:13:27.57,Default,,0,0,0,,Ал сіз Гилмор қорын құрдыңыз...
Dialogue: 0,0:13:27.87,0:13:29.00,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:13:29.54,0:13:34.18,Default,,0,0,0,,Алайда олардың барлығы қырғи-қабақ соғыстың аяқталуымен аяқталды.
Dialogue: 0,0:13:36.11,0:13:41.42,Default,,0,0,0,,Бұл АҚШ-Кеңес тарихи саммитінен бірнеше апта өткен соң болды.
Dialogue: 0,0:13:42.25,0:13:45.02,Default,,0,0,0,,Біріккен Ұлттар Ұйымының Нью-Йорктегі штаб-пәтерінде.
Dialogue: 0,0:13:45.12,0:13:49.59,Default,,0,0,0,,Көшбасшылар арасында қарусыздану конференциясы өтті.
Dialogue: 0,0:13:50.26,0:13:52.49,Default,,0,0,0,,Мәселе содан кейін пайда болды.
Dialogue: 0,0:13:54.06,0:13:59.20,Default,,0,0,0,,Қырғи қабақ соғыстың аяқталуымен бейбітшілік дәуірі басталады.
Dialogue: 0,0:13:59.37,0:14:03.97,Default,,0,0,0,,Доктор Гилмор: Социализм біздің жалғыз жауымыз емес.
Dialogue: 0,0:14:04.57,0:14:08.61,Default,,0,0,0,,Жаңа жаудың шығуы әбден мүмкін.
Dialogue: 0,0:14:09.34,0:14:11.15,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,0:14:11.25,0:14:14.01,Default,,0,0,0,,Менің нөлдік нөлдік киборгым бар...
Dialogue: 0,0:14:14.11,0:14:16.08,Default,,0,0,0,,Мен іздеп жүрмін
Dialogue: 0,0:14:16.38,0:14:20.19,Default,,0,0,0,,Олардың жұмысына байланысты «Біріккен Ұлттар Ұйымының шағын күші» деп атауға болады.
Dialogue: 0,0:14:20.29,0:14:23.32,Default,,0,0,0,,Әлемде бейбітшілікті болашақта сақтауға болады
Dialogue: 0,0:14:23.42,0:14:26.99,Default,,0,0,0,,Сондықтан мен баршаңызды осы мүмкіндікті пайдаланып, қарусыздануға бет бұруға шақырамын...
Dialogue: 0,0:14:27.09,0:14:28.63,Default,,0,0,0,,Мәселе мынада!
Dialogue: 0,0:14:29.20,0:14:33.40,Default,,0,0,0,,Мен олардың мүмкіндіктерін бір шағын елдің әскери қуатымен салыстыруға болатынын естідім.
Dialogue: 0,0:14:34.07,0:14:36.17,Default,,0,0,0,,Сол күшті киборгтарды басқарыңыз.
Dialogue: 0,0:14:36.27,0:14:38.27,Default,,0,0,0,,Егер сіз жаңа қауіпке айналмайынша...
Dialogue: 0,0:14:38.34,0:14:40.44,Default,,0,0,0,,Оған кім кепілдік бере алады? !
Dialogue: 0,0:14:40.94,0:14:42.61,Default,,0,0,0,,Сіз нені айтасыз? !
Dialogue: 0,0:14:43.24,0:14:44.51,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:48.32,0:14:51.65,Default,,0,0,0,,Осы уақытқа дейін біз сізге көп көмектесіп келдік...
Dialogue: 0,0:14:51.95,0:14:53.49,Default,,0,0,0,,Суық болды.
Dialogue: 0,0:14:53.62,0:14:55.96,Default,,0,0,0,,Ол өзінің өлмейтін екенін сенімді түрде жариялады.
Dialogue: 0,0:14:56.06,0:14:58.66,Default,,0,0,0,,Өйткені қара елес де ғайып болды.
Dialogue: 0,0:14:59.49,0:15:02.40,Default,,0,0,0,,Бәрі жаман болған жоқ, доктор.
Dialogue: 0,0:15:03.06,0:15:04.06,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:15:05.07,0:15:07.97,Default,,0,0,0,,Қырғи қабақ соғыстан пайда көрген ұйымдар...
Dialogue: 0,0:15:08.07,0:15:11.37,Default,,0,0,0,,Егер ол жоғалып кетсе, ол өзін-өзі жояды.
Dialogue: 0,0:15:11.64,0:15:15.68,Default,,0,0,0,,Өйткені, 21 ғасырда әлем бұрынғыдан да жақсы...
Dialogue: 0,0:15:15.94,0:15:19.08,Default,,0,0,0,,Тұрақсыз және қауіпті жерге айналғанымен.
Dialogue: 0,0:15:19.18,0:15:20.45,Default,,0,0,0,,Бұл дұрыс болды.
Dialogue: 0,0:15:20.51,0:15:21.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:22.32,0:15:24.65,Default,,0,0,0,,Біз де қалыпты өмір сүргіміз келеді.
Dialogue: 0,0:15:25.45,0:15:28.16,Default,,0,0,0,,Әлемнің тыныштығын басқаларға қалдыр.
Dialogue: 0,0:15:35.50,0:15:38.40,Default,,0,0,0,,Соңында, Біріккен Ұлттар Ұйымы терроризмге қарсы шаралармен де айналысады.
Dialogue: 0,0:15:38.47,0:15:41.60,Default,,0,0,0,,Енді өзіміздің тұрақты әскеріміз бар.
Dialogue: 0,0:15:42.27,0:15:43.70,Default,,0,0,0,,Сіз қамқоршылар деп айттыңыз ба?
Dialogue: 0,0:15:44.67,0:15:47.68,Default,,0,0,0,,Бұл Сақшыларды құруға әкелді.
Dialogue: 0,0:15:48.14,0:15:50.71,Default,,0,0,0,,Бірнеше жыл бұрын болған халықаралық лаңкестік оқиға туралы не деуге болады?
Dialogue: 0,0:15:51.15,0:15:54.45,Default,,0,0,0,,Бұған сіздердің де қатысыңыз бар екендігі туралы әлі де дәлелдер бар.
Dialogue: 0,0:16:00.12,0:16:04.36,Default,,0,0,0,,Дубайдағы ядролық шабуылда қанша адам қаза тапты? !
Dialogue: 0,0:16:05.13,0:16:07.29,Default,,0,0,0,,А... келіңдер!
Dialogue: 0,0:16:07.56,0:16:10.03,Default,,0,0,0,,Егер сіз сенімді болсаңыз...
Dialogue: 0,0:16:10.13,0:16:12.33,Default,,0,0,0,,Бізді көруге неге келдің?
Dialogue: 0,0:16:13.00,0:16:14.57,Default,,0,0,0,,Қалағаныңызша хабарлауға болады.
Dialogue: 0,0:16:15.30,0:16:17.44,Default,,0,0,0,,Неге мені жалғыз қалдырмайсың? !
Dialogue: 0,0:16:20.44,0:16:24.21,Default,,0,0,0,,Сол кезде ядролық шабуыл күтіп тұрғанда...
Dialogue: 0,0:16:24.58,0:16:26.48,Default,,0,0,0,,Оны тоқтата алмағанымыз рас.
Dialogue: 0,0:16:27.41,0:16:31.22,Default,,0,0,0,,Соғыс бастағанымызға жарты ғасырдан асты.
Dialogue: 0,0:16:32.15,0:16:34.19,Default,,0,0,0,,Мен жай ғана тыныш өмір сүргім келеді
Dialogue: 0,0:16:35.29,0:16:38.19,Default,,0,0,0,,Біздің айтқанымызға сенбесеңіз...
Dialogue: 0,0:16:38.33,0:16:41.40,Default,,0,0,0,,Мақаланы қалауыңызша жаза аласыз.
Dialogue: 0,0:16:42.03,0:16:45.10,Default,,0,0,0,,Мен қателескен жоқпын.
Dialogue: 0,0:16:45.47,0:16:46.47,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:49.07,0:16:50.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:50.54,0:16:53.71,Default,,0,0,0,,Негізі мен мұнда басқа нәрсе туралы айтқым келгендіктен келдім.
Dialogue: 0,0:16:54.27,0:16:55.34,Default,,0,0,0,,Иә? (009) А...
Dialogue: 0,0:16:57.48,0:17:00.15,Default,,0,0,0,,Қазір олардан әлемді құтқара алатын жалғыз адам...
Dialogue: 0,0:17:00.31,0:17:02.75,Default,,0,0,0,,Мен әкемнен естідім, бұл тек сендер екенсіңдер...
Dialogue: 0,0:17:03.45,0:17:06.19,Default,,0,0,0,,Сондықтан мен сендерді қатты зерттедім.
Dialogue: 0,0:17:07.76,0:17:10.02,Default,,0,0,0,,Бірақ әкем айтқандай...
Dialogue: 0,0:17:10.19,0:17:13.03,Default,,0,0,0,,Білмеймін, сендер әділдік жағындасыңдар ма...
Dialogue: 0,0:17:13.46,0:17:15.43,Default,,0,0,0,,Мен оны өзім тексергім келді
Dialogue: 0,0:17:16.50,0:17:17.53,Default,,0,0,0,,Жарайды, мен кеттім. Қош бол.
Dialogue: 0,0:17:18.23,0:17:20.77,Default,,0,0,0,,Бұрынғыдай әлем бейбітшілігі үшін
Dialogue: 0,0:17:21.10,0:17:23.04,Default,,0,0,0,,Өтінемін, менімен тағы ұрыса аласыз ба?
Dialogue: 0,0:17:23.37,0:17:24.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:26.17,0:17:29.34,Default,,0,0,0,,Сенің әкең кім?
Dialogue: 0,0:17:29.61,0:17:33.31,Default,,0,0,0,,Тимоти Дэвенпорт молекулалық генетик болды.
Dialogue: 0,0:17:33.41,0:17:35.68,Default,,0,0,0,,Ах, доктор Дэвенпорт.
Dialogue: 0,0:17:35.78,0:17:39.22,Default,,0,0,0,,Мен бірнеше құжаттарды оқыдым, бірақ...
Dialogue: 0,0:17:39.32,0:17:41.76,Default,,0,0,0,,Сіз мені танымауыңыз керек...
Dialogue: 0,0:17:42.06,0:17:44.53,Default,,0,0,0,,Менің әкем саған табынатын.
Dialogue: 0,0:17:45.39,0:17:47.69,Default,,0,0,0,,Оларды қараңғылықтан шығарыңыз...
Dialogue: 0,0:17:47.80,0:17:50.30,Default,,0,0,0,,Оларды тек сен ғана жеңе аласың дейді.
Dialogue: 0,0:17:50.66,0:17:51.53,Default,,0,0,0,,Олар?
Dialogue: 0,0:18:02.34,0:18:04.58,Default,,0,0,0,,Бұл фотоға не болды?
Dialogue: 0,0:18:06.18,0:18:08.65,Default,,0,0,0,,Бұл фотосуреттердің нағыз проблемасы...
Dialogue: 0,0:18:08.78,0:18:10.72,Default,,0,0,0,,Сіздің кім екеніңіз маңызды емес.
Dialogue: 0,0:18:11.55,0:18:12.55,Default,,0,0,0,,Мұқият қараңыз
Dialogue: 0,0:18:12.82,0:18:13.79,Default,,0,0,0,,Хмм?
Dialogue: 0,0:18:18.13,0:18:19.16,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:19.39,0:18:20.56,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:18:27.13,0:18:30.70,Default,,0,0,0,,Сақал мен шаш үлгісі әртүрлі, бірақ олар бір адам.
Dialogue: 0,0:18:31.54,0:18:34.78,Default,,0,0,0,,Не? ! Әй, менен сұрасаң...
Dialogue: 0,0:18:35.24,0:18:36.88,Default,,0,0,0,,Картоп, сен сондай ақымақсың.
Dialogue: 0,0:18:37.68,0:18:41.68,Default,,0,0,0,,Бұл сіз айтқан жігіт пе?
Dialogue: 0,0:18:41.88,0:18:45.32,Default,,0,0,0,,Жоқ, олар бүкіл әлемде.
Dialogue: 0,0:18:45.45,0:18:50.19,Default,,0,0,0,,Әртүрлі нәсілдер мен ұлттар бар, бірақ бәрімізге ортақ бір нәрсе бар.
Dialogue: 0,0:18:50.76,0:18:51.76,Default,,0,0,0,,Өлмейтіндік
Dialogue: 0,0:18:53.16,0:18:57.36,Default,,0,0,0,,Жоқ, ең болмағанда қорқынышты ұзақ өмір. Әкем осылай жазған.
Dialogue: 0,0:18:57.46,0:19:01.70,Default,,0,0,0,,Бұл... олар да біз сияқты киборгтар дегенді білдіре ме?
Dialogue: 0,0:19:02.40,0:19:03.57,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:19:03.87,0:19:06.54,Default,,0,0,0,,Өйткені олар мұны жүздеген жылдар бойы істеп келеді...
Dialogue: 0,0:19:06.64,0:19:08.48,Default,,0,0,0,,Бұл жер бетінде не бар?
Dialogue: 0,0:19:08.88,0:19:12.31,Default,,0,0,0,,Жүздеген жылдар... Мен вампир емеспін.
Dialogue: 0,0:19:12.85,0:19:13.78,Default,,0,0,0,,ＧＢ！
Dialogue: 0,0:19:14.21,0:19:16.45,Default,,0,0,0,,Үшеуі де тату.
Dialogue: 0,0:19:17.35,0:19:18.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:19.19,0:19:22.36,Default,,0,0,0,,Мен саған өзіңді ұста деп айттым.
Dialogue: 0,0:19:22.42,0:19:25.49,Default,,0,0,0,,Мына бала көлікке отырды...
Dialogue: 0,0:19:25.63,0:19:27.79,Default,,0,0,0,,Оның ешқандай айласы болған жоқ.
Dialogue: 0,0:19:28.20,0:19:29.36,Default,,0,0,0,,Бұл жай ғана жалға алынған көлік.
Dialogue: 0,0:19:29.76,0:19:31.23,Default,,0,0,0,,Бұдан артық -
Dialogue: 0,0:19:31.43,0:19:34.77,Default,,0,0,0,,Мен өлместік туралы әңгіменің жалғасын тыңдағым келеді.
Dialogue: 0,0:19:35.24,0:19:38.57,Default,,0,0,0,,Олар бір жағынан вампирлер сияқты.
Dialogue: 0,0:19:38.67,0:19:43.74,Default,,0,0,0,,Ол сондай-ақ «Дракула» романынан гөрі нәзік және адамгершілікке жатпайды...
Dialogue: 0,0:19:43.84,0:19:46.78,Default,,0,0,0,,Эй, бұл ақылсыз қастандық теориясы.
Dialogue: 0,0:19:46.95,0:19:51.59,Default,,0,0,0,,Өлмейтін топ жүздеген жылдар бойы адамдарды басқарып келеді?
Dialogue: 0,0:19:51.92,0:19:53.52,Default,,0,0,0,,Маған сенбейсіз бе?
Dialogue: 0,0:19:54.25,0:19:58.59,Default,,0,0,0,,Қалай ойлайсың, MI6 күйеуі? Сіз мұндай нәрсе туралы естідіңіз бе?
Dialogue: 0,0:19:58.69,0:19:59.73,Default,,0,0,0,,Тек күте тұр, сен, қарғыған Деку.
Dialogue: 0,0:19:59.83,0:20:02.33,Default,,0,0,0,,Тіпті ЦРУ да сұрамады.
Dialogue: 0,0:20:02.46,0:20:03.80,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:20:03.96,0:20:06.67,Default,,0,0,0,,Біз өз іс-әрекетімізді тоқтатқаннан кейін-
Dialogue: 0,0:20:06.77,0:20:10.37,Default,,0,0,0,,Олардың әрқайсысы өз елдерінің барлау органдары мен арнайы күштерінде жұмыс істейді.
Dialogue: 0,0:20:10.44,0:20:12.41,Default,,0,0,0,,Мен сонда жұмыс істедім.
Dialogue: 0,0:20:12.74,0:20:15.68,Default,,0,0,0,,Дүние жүзіндегі барлау агенттіктері не білмейді...
Dialogue: 0,0:20:15.78,0:20:17.54,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:20:18.38,0:20:20.85,Default,,0,0,0,,Бұл қорқынышты, өйткені ешкім байқамайды.
Dialogue: 0,0:20:21.62,0:20:24.25,Default,,0,0,0,,Білген мен емес, әкем.
Dialogue: 0,0:20:24.99,0:20:27.65,Default,,0,0,0,,Менің әкем, доктор Тимоти Дэвенпорт...
Dialogue: 0,0:20:27.75,0:20:30.82,Default,,0,0,0,,Ол олардың бар екенін әшкерелеу үшін өлтірілді.
Dialogue: 0,0:20:33.73,0:20:34.73,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:20:36.43,0:20:40.83,Default,,0,0,0,,Әкем сені көргенде саған бер деп бұйырған.
Dialogue: 0,0:20:41.34,0:20:42.60,Default,,0,0,0,,Ішінде не бар?
Dialogue: 0,0:20:42.97,0:20:46.27,Default,,0,0,0,,Түсінбедім, аша алмаймын.
Dialogue: 0,0:20:46.74,0:20:49.58,Default,,0,0,0,,Тек доктор Гилмор мен Иван Виски...
Dialogue: 0,0:20:49.64,0:20:52.58,Default,,0,0,0,,Бұл менің қолымнан келмейтін сұмдық.
Dialogue: 0,0:20:57.25,0:20:59.32,Default,,0,0,0,,Хмм? Хмм...
Dialogue: 0,0:20:59.92,0:21:02.99,Default,,0,0,0,,Жәндіктер? Жоқ. Бұл робот па?
Dialogue: 0,0:21:03.89,0:21:07.76,Default,,0,0,0,,Ах... Дәрігер, бұл зат радиотолқындар шығарады.
Dialogue: 0,0:21:07.83,0:21:09.66,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:21:10.36,0:21:11.47,Default,,0,0,0,,Ой!
Dialogue: 0,0:21:12.87,0:21:13.70,Default,,0,0,0,,Не?
Dialogue: 0,0:21:17.80,0:21:21.91,Default,,0,0,0,,(бұршақтың дыбысы)
Dialogue: 0,0:21:25.48,0:21:30.75,Default,,0,0,0,,Бұл біртүрлі. Температура мен қысым дәл осы ферманың айналасында тез төмендейді.
Dialogue: 0,0:21:30.88,0:21:34.99,Default,,0,0,0,,Иә? Техастың ортасында боран?
Dialogue: 0,0:21:35.76,0:21:36.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:37.32,0:21:39.56,Default,,0,0,0,,Бұл не туралы?
Dialogue: 0,0:21:39.76,0:21:43.76,Default,,0,0,0,,Олар! Олар мені тапты! Мүмкін емес!
Dialogue: 0,0:21:45.03,0:21:46.07,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:21:46.77,0:21:49.37,Default,,0,0,0,,Джеронимо, оны тоқтат.
Dialogue: 0,0:21:49.54,0:21:50.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:51.84,0:21:53.67,Default,,0,0,0,,Ах ха ха...
Dialogue: 0,0:21:55.88,0:21:56.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:57.51,0:21:58.78,Default,,0,0,0,,Жібер!
Dialogue: 0,0:21:58.98,0:22:01.38,Default,,0,0,0,,Жібер! Өтінемін, мені жіберіңізші!
Dialogue: 0,0:22:02.05,0:22:04.55,Default,,0,0,0,,Көлікте маңызды құжаттар бар...
Dialogue: 0,0:22:04.82,0:22:05.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:10.59,0:22:11.49,Default,,0,0,0,,004！
Dialogue: 0,0:22:11.59,0:22:12.39,Default,,0,0,0,,Ха...
Dialogue: 0,0:22:17.63,0:22:19.07,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:22:22.34,0:22:23.54,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:22:24.34,0:22:26.91,Default,,0,0,0,,Франсуа Сіз бірдеңені түсіндіңіз бе?
Dialogue: 0,0:22:26.97,0:22:30.51,Default,,0,0,0,,Жоқ, боран соғып тұрғандықтан мен көрмеймін, естімеймін.
Dialogue: 0,0:22:33.41,0:22:34.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:36.52,0:22:37.42,Default,,0,0,0,,Кя!
Dialogue: 0,0:22:37.95,0:22:38.85,Default,,0,0,0,,Маған қалдыр!
Dialogue: 0,0:22:38.92,0:22:41.52,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:22:41.72,0:22:42.96,Default,,0,0,0,,Қауіпті Al!
Dialogue: 0,0:22:43.06,0:22:45.93,Default,,0,0,0,,(Тыныс алу жалынының дыбысы)
Dialogue: 0,0:22:46.86,0:22:48.06,Default,,0,0,0,,Иә, сіз...
Dialogue: 0,0:22:48.43,0:22:51.57,Default,,0,0,0,,Біздің денеміз ерекше күшті.
Dialogue: 0,0:22:52.63,0:22:54.00,Default,,0,0,0,,Барлық бағыттар бойынша? !
Dialogue: 0,0:22:54.94,0:22:56.10,Default,,0,0,0,,үдеткіш!
Dialogue: 0,0:23:15.49,0:23:18.93,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:23:21.83,0:23:24.46,Default,,0,0,0,,(Найзағайдың гүрсілі)
Dialogue: 0,0:23:25.96,0:23:31.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory