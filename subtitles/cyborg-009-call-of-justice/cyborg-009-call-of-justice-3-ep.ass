Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:36.26,0:01:38.26,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:01:46.53,0:01:48.50,Default,,0,0,0,,Ковбой өлді ме?
Dialogue: 0,0:01:48.80,0:01:50.21,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:01:50.57,0:01:51.57,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:01:52.34,0:01:53.21,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:01:53.64,0:01:56.24,Default,,0,0,0,,Нөлдік нөл саны киборг
Dialogue: 0,0:01:56.88,0:01:58.25,Default,,0,0,0,,Олар...
Dialogue: 0,0:01:59.68,0:02:02.45,Default,,0,0,0,,Мен оның алдыма жүгіргенін білдім, бірақ...
Dialogue: 0,0:02:03.32,0:02:04.72,Default,,0,0,0,,Оны кәдеге жарату керек емес пе?
Dialogue: 0,0:02:05.65,0:02:06.65,Default,,0,0,0,,Қарсылық жоқ
Dialogue: 0,0:02:07.56,0:02:11.26,Default,,0,0,0,,Хмм... Сенсей, мен сенен бір жақсылық сұрасам болады ма?
Dialogue: 0,0:02:12.53,0:02:13.46,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:02:14.46,0:02:15.60,Default,,0,0,0,,(Ұялы телефон жұмысының дыбысы)
Dialogue: 0,0:02:15.66,0:02:19.47,Default,,0,0,0,,(Ұялы қоңырау үні)
Dialogue: 0,0:02:22.74,0:02:23.87,Default,,0,0,0,,Менің шұғыл жұмысым бар еді.
Dialogue: 0,0:02:24.74,0:02:28.34,Default,,0,0,0,,Студенттерге түстен кейінгі сабақтардың тоқтатылатынын хабарлауыңызды сұраймыз.
Dialogue: 0,0:02:30.48,0:02:33.72,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:02:35.72,0:02:39.25,Default,,0,0,0,,(Кенеттен басталған дыбыс)
Dialogue: 0,0:02:57.94,0:02:59.51,Default,,0,0,0,,Дэвенпорт мырза
Dialogue: 0,0:03:00.54,0:03:03.81,Default,,0,0,0,,Сіздің айтқаныңызға сенуден басқа амалым жоқ сияқты.
Dialogue: 0,0:03:04.58,0:03:05.81,Default,,0,0,0,,Люси жақсы.
Dialogue: 0,0:03:06.35,0:03:07.32,Default,,0,0,0,,Люси
Dialogue: 0,0:03:07.88,0:03:11.35,Default,,0,0,0,,Әкең оны өлтіргенін айтты...
Dialogue: 0,0:03:11.49,0:03:13.49,Default,,0,0,0,,Сіз олардың қатысуын байқағаныңыз үшін...
Dialogue: 0,0:03:13.59,0:03:15.26,Default,,0,0,0,,Оның өлтірілгенін елестету қиын...
Dialogue: 0,0:03:16.26,0:03:17.53,Default,,0,0,0,,Жалпы алғанда -
Dialogue: 0,0:03:17.66,0:03:21.46,Default,,0,0,0,,Өлмейтін, әлемді сахна сыртынан басқаратын адамдар бар.
Dialogue: 0,0:03:21.66,0:03:23.23,Default,,0,0,0,,Саған ешкім сенбейді, солай ма?
Dialogue: 0,0:03:24.60,0:03:27.87,Default,,0,0,0,,Бұл оның кінәсі емес пе?
Dialogue: 0,0:03:28.54,0:03:29.87,Default,,0,0,0,,онда...
Dialogue: 0,0:03:30.51,0:03:34.48,Default,,0,0,0,,Мен бұл не екенін бірден анықтауым керек.
Dialogue: 0,0:03:39.38,0:03:41.88,Default,,0,0,0,,Баланың шпиондық дәптері сияқты.
Dialogue: 0,0:03:42.55,0:03:43.82,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:03:44.29,0:03:45.75,Default,,0,0,0,,Бақытты болды
Dialogue: 0,0:03:46.69,0:03:51.26,Default,,0,0,0,,Бірақ шын мәнінде біз қарсы күресуіміз керек пе?
Dialogue: 0,0:03:52.59,0:03:55.73,Default,,0,0,0,,Жау ойланбастан бізге шабуыл жасады, солай ма?
Dialogue: 0,0:03:56.33,0:03:57.67,Default,,0,0,0,,Бұл шайқас-
Dialogue: 0,0:03:58.30,0:04:01.34,Default,,0,0,0,,Мен өзіме түскен ұшқындарды жаңа ғана өшірдім.
Dialogue: 0,0:04:01.84,0:04:04.97,Default,,0,0,0,,Дүниенің жауы деп шын мойындамаса...
Dialogue: 0,0:04:05.57,0:04:08.34,Default,,0,0,0,,Менің ойымша, біз қозғалмауымыз керек.
Dialogue: 0,0:04:08.98,0:04:11.31,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:04:12.65,0:04:14.48,Default,,0,0,0,,Қозғалу біз үшін нені білдіреді...
Dialogue: 0,0:04:14.82,0:04:18.32,Default,,0,0,0,,Бұл әлем назардан тыс қалдырмайтын оқиғаға айналады дегенді білдіреді.
Dialogue: 0,0:04:19.65,0:04:22.86,Default,,0,0,0,,Сіз әрқашан әділдік үшін күресіп келесіз, солай емес пе?
Dialogue: 0,0:04:23.59,0:04:25.63,Default,,0,0,0,,Оны оқшаулаңыз. (Полиция қызметкері) Иә, мырза.
Dialogue: 0,0:04:28.43,0:04:32.00,Default,,0,0,0,,Сіз айтқан әділдік – біз ойлаған әділдік...
Dialogue: 0,0:04:32.30,0:04:33.33,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:04:34.47,0:04:35.70,Default,,0,0,0,,Бәрінен бұрын-
Dialogue: 0,0:04:35.80,0:04:38.34,Default,,0,0,0,,Дәл қазір мен қарапайым адам ретінде өмір сүргім келеді.
Dialogue: 0,0:04:41.04,0:04:41.78,Default,,0,0,0,,(Люси күрсінуі)
Dialogue: 0,0:04:41.94,0:04:44.75,Default,,0,0,0,,Қорытындыға келген сияқтымыз.
Dialogue: 0,0:04:45.61,0:04:48.82,Default,,0,0,0,,Біз оңай қозғала алмаймыз.
Dialogue: 0,0:04:49.42,0:04:53.59,Default,,0,0,0,,Сондай-ақ қазір Біріккен Ұлттар Ұйымында қамқоршылар бар.
Dialogue: 0,0:04:54.02,0:04:54.96,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:04:56.59,0:04:59.79,Default,,0,0,0,,Тіпті Біріккен Ұлттар Ұйымын да Бата басқара алады.
Dialogue: 0,0:05:00.56,0:05:03.40,Default,,0,0,0,,Мен мұны мүмкіндік деп түсінемін, бірақ...
Dialogue: 0,0:05:03.93,0:05:07.87,Default,,0,0,0,,Біріккен Ұлттар Ұйымының Бейбітшілікті бақылау комиссиясында менің ескі достарым бар.
Dialogue: 0,0:05:08.30,0:05:09.30,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:09.90,0:05:11.31,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:05:11.64,0:05:13.84,Default,,0,0,0,,Сіз бізді алып кетуге келгенше біз сізді қорғаймыз.
Dialogue: 0,0:05:15.38,0:05:17.68,Default,,0,0,0,,Қамқоршылар мұнда келе жатқан жоқ па?
Dialogue: 0,0:05:18.35,0:05:18.88,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:05:20.08,0:05:22.62,Default,,0,0,0,,Адамдардың бұл жер туралы білгенін қаламайсыз.
Dialogue: 0,0:05:26.99,0:05:28.36,Default,,0,0,0,,Дэвенпорт ханым
Dialogue: 0,0:05:29.52,0:05:30.69,Default,,0,0,0,,Бір сәтке бола аламын ба?
Dialogue: 0,0:05:31.09,0:05:32.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:35.53,0:05:36.80,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:05:48.68,0:05:49.54,Default,,0,0,0,,Маған мін.
Dialogue: 0,0:05:54.52,0:05:56.72,Default,,0,0,0,,(Көліктің кетіп бара жатқан дыбысы)
Dialogue: 0,0:06:06.43,0:06:08.86,Default,,0,0,0,,Сақшылар екі сағаттан кейін келеді.
Dialogue: 0,0:06:09.53,0:06:10.36,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:06:10.77,0:06:11.70,Default,,0,0,0,,Тіпті Патраш те мені осылай өліп қалсам жалғыз тастап кетпес еді.
Dialogue: 0,0:06:11.90,0:06:15.60,Default,,0,0,0,,Бізге шабуыл жасаған адамды зерттедім...
Dialogue: 0,0:06:15.74,0:06:17.14,Default,,0,0,0,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:06:17.61,0:06:18.87,Default,,0,0,0,,Арнольд Нокс
Dialogue: 0,0:06:19.51,0:06:22.68,Default,,0,0,0,,Оның Техастағы ең бай адам екеніне күмән жоқ.
Dialogue: 0,0:06:23.14,0:06:26.78,Default,,0,0,0,,«Миллионердің шынайы тұлғасы құбыжық болды»?
Dialogue: 0,0:06:27.42,0:06:31.09,Default,,0,0,0,,Бұл Азамат соғысына дейін тұрған ескі үйге ұқсайды.
Dialogue: 0,0:06:31.59,0:06:33.76,Default,,0,0,0,,Қазіргі отағасы Арнольд Нокс...
Dialogue: 0,0:06:33.86,0:06:34.99,Default,,0,0,0,,7-ші ұрпаққа ұқсайды
Dialogue: 0,0:06:35.49,0:06:38.63,Default,,0,0,0,,Хмм, дәл солай дәстүрлі ковбой.
Dialogue: 0,0:06:38.89,0:06:39.79,Default,,0,0,0,,Мен аш емеспін. Хүү…
Dialogue: 0,0:06:40.76,0:06:43.50,Default,,0,0,0,,Ол Арнольд Ноксқа дейін отағасы болған.
Dialogue: 0,0:06:44.90,0:06:46.47,Default,,0,0,0,,Бұл қазіргі отағасы
Dialogue: 0,0:06:46.80,0:06:48.97,Default,,0,0,0,,Ал бұрынғы отағасы
Dialogue: 0,0:06:49.64,0:06:51.47,Default,,0,0,0,,Сонымен қатар, бұрынғы отағасы
Dialogue: 0,0:06:54.54,0:06:56.51,Default,,0,0,0,,Демек, бұл бір адам!
Dialogue: 0,0:06:57.15,0:07:00.01,Default,,0,0,0,,Оның аты кіші болғанымен...
Dialogue: 0,0:07:00.11,0:07:01.58,Default,,0,0,0,,Иә (004) Хамф
Dialogue: 0,0:07:31.98,0:07:34.15,Default,,0,0,0,,Рахмет, бәрі жақсы.
Dialogue: 0,0:07:34.85,0:07:35.75,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:43.62,0:07:44.69,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:54.67,0:07:56.50,Default,,0,0,0,,Жарайды, кіріңіз.
Dialogue: 0,0:08:00.07,0:08:01.98,Default,,0,0,0,,Әзірше осында болыңыз.
Dialogue: 0,0:08:03.58,0:08:05.81,Default,,0,0,0,,Мүмкіндігінше терезелерден алыс болыңыз
Dialogue: 0,0:08:08.22,0:08:09.15,Default,,0,0,0,,Иә
Dialogue: 0,0:08:11.09,0:08:13.12,Default,,0,0,0,,Мен оны кеше сезбедім...
Dialogue: 0,0:08:13.62,0:08:16.22,Default,,0,0,0,,Қазір біреу телепатияны пайдаланып жатыр.
Dialogue: 0,0:08:17.56,0:08:18.76,Default,,0,0,0,,Бұл жиіркенішті сезіледі.
Dialogue: 0,0:08:36.91,0:08:38.11,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:08:38.25,0:08:39.85,Default,,0,0,0,,(004･008 айқайы)
Dialogue: 0,0:08:41.25,0:08:43.89,Default,,0,0,0,,Ух, а, а...
Dialogue: 0,0:08:54.06,0:08:56.10,Default,,0,0,0,,Бұл не екенін білесің бе?
Dialogue: 0,0:08:57.16,0:08:57.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:02.20,0:09:03.20,Default,,0,0,0,,Люси!
Dialogue: 0,0:09:10.75,0:09:12.98,Default,,0,0,0,,Бұл не...? ?
Dialogue: 0,0:09:24.69,0:09:26.76,Default,,0,0,0,,Хмм, қайдан?
Dialogue: 0,0:09:27.63,0:09:30.60,Default,,0,0,0,,Жақын жерде бір ғана жалпы көлік бар.
Dialogue: 0,0:09:31.83,0:09:32.63,Default,,0,0,0,,Уф (008) Уф
Dialogue: 0,0:09:35.24,0:09:36.77,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:09:36.90,0:09:37.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:41.21,0:09:42.11,Default,,0,0,0,,(Йошимура) Коузен туралы сыбыстар кең тарала бастады—
Dialogue: 0,0:09:42.18,0:09:42.88,Default,,0,0,0,,Жүріңіз!
Dialogue: 0,0:09:43.31,0:09:44.28,Default,,0,0,0,,Ммм
Dialogue: 0,0:09:46.81,0:09:47.92,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:09:56.59,0:09:57.09,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:09:57.89,0:09:59.09,Default,,0,0,0,,Люси жеңілді
Dialogue: 0,0:10:02.23,0:10:05.67,Default,,0,0,0,,Саған кездесу орнын тек Сақшылар ғана айтты, солай ма?
Dialogue: 0,0:10:06.07,0:10:07.00,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:07.80,0:10:10.00,Default,,0,0,0,,Ақпарат бір жерден шығып кеткен сияқты.
Dialogue: 0,0:10:10.71,0:10:11.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:12.04,0:10:15.28,Default,,0,0,0,,Люсидің айтқандары шындыққа айналады.
Dialogue: 0,0:10:15.84,0:10:17.78,Default,,0,0,0,,Бірақ баталар...
Dialogue: 0,0:10:17.85,0:10:19.98,Default,,0,0,0,,Біз қалай ынтымақтастық жасаймыз?
Dialogue: 0,0:10:20.82,0:10:22.85,Default,,0,0,0,,Деректер жетіспегендіктен ештеңе айта алмаймын.
Dialogue: 0,0:10:23.28,0:10:26.05,Default,,0,0,0,,Олар ұйымдасқан түрде әрекет етіп жатқан сияқты.
Dialogue: 0,0:10:29.69,0:10:31.93,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:10:39.97,0:10:41.20,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:10:41.37,0:10:42.10,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:42.97,0:10:44.01,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:44.37,0:10:45.31,Default,,0,0,0,,007！
Dialogue: 0,0:10:48.71,0:10:51.11,Default,,0,0,0,,Мен ұзақ айналып өтсем де, сен менің артымнан келе жатырсың.
Dialogue: 0,0:10:54.65,0:10:58.09,Default,,0,0,0,,Біз сені осылай өз үйімізге апара алмаймыз ғой?
Dialogue: 0,0:11:01.96,0:11:03.66,Default,,0,0,0,,Менің айтқым келгені осы еді.
Dialogue: 0,0:11:04.19,0:11:05.69,Default,,0,0,0,,(кенеттен тежеу дыбысы)
Dialogue: 0,0:11:08.40,0:11:09.33,Default,,0,0,0,,(Сатушы) Жарайды, онда мен сата алатын зат та осы ғана болар.
Dialogue: 0,0:11:17.37,0:11:18.34,Default,,0,0,0,,(Мылтық көтеріліп жатқан дыбыс)
Dialogue: 0,0:11:20.81,0:11:22.74,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:11:25.11,0:11:26.15,Default,,0,0,0,,Ммм
Dialogue: 0,0:11:27.08,0:11:31.12,Default,,0,0,0,,(Оқтардың қайтарылған дыбысы)
Dialogue: 0,0:11:35.09,0:11:39.16,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:11:45.40,0:11:48.34,Default,,0,0,0,,004 008 Жауап беріңіз!
Dialogue: 0,0:11:48.44,0:11:49.37,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:49.47,0:11:51.07,Default,,0,0,0,,Оларға бірдеңе болған сияқты!
Dialogue: 0,0:11:51.17,0:11:52.27,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:11:55.84,0:11:57.81,Default,,0,0,0,,(ұшып бара жатқан дыбыс)
Dialogue: 0,0:12:08.82,0:12:09.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:17.80,0:12:18.80,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:12:20.50,0:12:21.20,Default,,0,0,0,,Ах
Dialogue: 0,0:12:22.07,0:12:22.84,Default,,0,0,0,,Уау
Dialogue: 0,0:12:29.11,0:12:30.78,Default,,0,0,0,,А... не! ?
Dialogue: 0,0:12:31.18,0:12:32.35,Default,,0,0,0,,Аһ!
Dialogue: 0,0:12:33.48,0:12:35.35,Default,,0,0,0,,Уф, уау...
Dialogue: 0,0:12:37.25,0:12:38.22,Default,,0,0,0,,002！
Dialogue: 0,0:12:38.75,0:12:39.79,Default,,0,0,0,,002！
Dialogue: 0,0:12:39.85,0:12:41.49,Default,,0,0,0,,(Көліктің кетіп бара жатқан дыбысы)
Dialogue: 0,0:12:44.96,0:12:47.50,Default,,0,0,0,,002 Джет Link
Dialogue: 0,0:12:48.00,0:12:50.23,Default,,0,0,0,,Сіз ұшуға тым көп сенесіз.
Dialogue: 0,0:12:51.30,0:12:53.03,Default,,0,0,0,,Не болып жатыр, Әл?
Dialogue: 0,0:12:56.10,0:12:57.00,Default,,0,0,0,,(көліктің тоқтаған дыбысы)
Dialogue: 0,0:13:05.11,0:13:06.35,Default,,0,0,0,,Хмм!
Dialogue: 0,0:13:10.89,0:13:12.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:13.32,0:13:15.09,Default,,0,0,0,,Ммм...
Dialogue: 0,0:13:15.89,0:13:17.53,Default,,0,0,0,,Тікелей жақындамаңыз
Dialogue: 0,0:13:25.10,0:13:26.17,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:30.07,0:13:34.28,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:13:35.38,0:13:36.44,Default,,0,0,0,,Иілген! ?
Dialogue: 0,0:13:37.28,0:13:40.51,Default,,0,0,0,,Олар ауаның тығыздығын өзгертіп, оның иілуіне себепші болды.
Dialogue: 0,0:13:43.18,0:13:44.02,Default,,0,0,0,,Аһ!
Dialogue: 0,0:13:44.32,0:13:45.32,Default,,0,0,0,,Уф
Dialogue: 0,0:13:46.82,0:13:47.56,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:49.49,0:13:50.49,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:13:51.93,0:13:52.83,Default,,0,0,0,,Уф
Dialogue: 0,0:13:55.40,0:13:57.46,Default,,0,0,0,,Ммм!
Dialogue: 0,0:13:59.03,0:14:00.97,Default,,0,0,0,,А... О, жоқ!
Dialogue: 0,0:14:01.04,0:14:02.40,Default,,0,0,0,,Мен ЖоЖомен шайқасуға оралдым!
Dialogue: 0,0:14:02.50,0:14:03.34,Default,,0,0,0,,Ой
Dialogue: 0,0:14:04.07,0:14:07.98,Default,,0,0,0,,(005-тің ыңырануы)
Dialogue: 0,0:14:09.04,0:14:10.98,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:14:11.28,0:14:14.11,Default,,0,0,0,,(005-тің ыңырануы)
Dialogue: 0,0:14:15.18,0:14:16.25,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:14:16.35,0:14:18.09,Default,,0,0,0,,Бұл шектен шыққан, құбыжық.
Dialogue: 0,0:14:18.32,0:14:21.39,Default,,0,0,0,,Қол қимылдарымен ауырлық күшін басқарады.
Dialogue: 0,0:14:22.12,0:14:24.99,Default,,0,0,0,,Шабуыл жасамас бұрын әрқашан қарсыласқа қараңыз
Dialogue: 0,0:14:25.49,0:14:27.60,Default,,0,0,0,,Бұл көзілдірік осы мақсатқа арналған жабдық.
Dialogue: 0,0:14:28.20,0:14:30.50,Default,,0,0,0,,Сондай-ақ қашықтыққа байланысты күштің әлсіреуін көруге болады.
Dialogue: 0,0:14:31.30,0:14:34.60,Default,,0,0,0,,Жарық сияқты қашықтықтың квадратына қарай әлсірейтін сияқты.
Dialogue: 0,0:14:35.07,0:14:38.14,Default,,0,0,0,,Бірақ мен саған жақындай алмасам, сені үрлей алмаймын!
Dialogue: 0,0:14:38.94,0:14:41.28,Default,,0,0,0,,Олай болса көзге түспесе жарайды.
Dialogue: 0,0:14:41.34,0:14:42.04,Default,,0,0,0,,Ах
Dialogue: 0,0:14:42.48,0:14:44.25,Default,,0,0,0,,Джо, сен не істедің?
Dialogue: 0,0:14:44.35,0:14:45.21,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:45.55,0:14:47.41,Default,,0,0,0,,Мен оларды қауіпсіз жерге көшірдім.
Dialogue: 0,0:14:50.12,0:14:51.22,Default,,0,0,0,,Үдеткіш!
Dialogue: 0,0:14:51.35,0:14:55.46,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:15:00.03,0:15:00.63,Default,,0,0,0,,Осы жауды жоюымыз керек, әйтпесе алға жылжи алмаймыз!
Dialogue: 0,0:15:00.90,0:15:01.90,Default,,0,0,0,,Хмм!
Dialogue: 0,0:15:02.66,0:15:03.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:04.57,0:15:05.90,Default,,0,0,0,,Денеге тию...
Dialogue: 0,0:15:14.38,0:15:15.18,Default,,0,0,0,,Ха...
Dialogue: 0,0:15:15.24,0:15:16.28,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:15:21.28,0:15:23.65,Default,,0,0,0,,009 Джо Шимамура
Dialogue: 0,0:15:24.39,0:15:28.99,Default,,0,0,0,,Әлемді ядролық қыстан құтқарған киборгтардың бір ерекшелігі бар.
Dialogue: 0,0:15:29.32,0:15:31.39,Default,,0,0,0,,Сіз бізді білесіз бе?
Dialogue: 0,0:15:31.96,0:15:32.66,Default,,0,0,0,,О
Dialogue: 0,0:15:33.39,0:15:35.13,Default,,0,0,0,,Мен өте жақсы білемін.
Dialogue: 0,0:15:35.26,0:15:37.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:38.10,0:15:39.67,Default,,0,0,0,,Абайлаңыз 009
Dialogue: 0,0:15:40.20,0:15:41.70,Default,,0,0,0,,Ойлары күшейе түсті
Dialogue: 0,0:15:44.20,0:15:45.41,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:50.04,0:15:50.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:52.01,0:15:55.58,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:15:58.29,0:15:59.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:59.59,0:16:01.32,Default,,0,0,0,,Бұдан жалтару
Dialogue: 0,0:16:02.02,0:16:03.49,Default,,0,0,0,,Бірақ бұл күтілетін ауқымда.
Dialogue: 0,0:16:04.02,0:16:06.19,Default,,0,0,0,,Мен сіздің көшіңізден бас тарттым.
Dialogue: 0,0:16:06.26,0:16:08.56,Default,,0,0,0,,күрсіну... уф...
Dialogue: 0,0:16:09.06,0:16:09.96,Default,,0,0,0,,Джо
Dialogue: 0,0:16:10.16,0:16:13.27,Default,,0,0,0,,003 Мені сыртқа шығарыңыз
Dialogue: 0,0:16:13.37,0:16:14.17,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:16:14.60,0:16:17.07,Default,,0,0,0,,Соғысатындар қауіптірек.
Dialogue: 0,0:16:18.24,0:16:20.04,Default,,0,0,0,,Иә? Ол кім?
Dialogue: 0,0:16:20.67,0:16:22.51,Default,,0,0,0,,Басқа біреу келе ме?
Dialogue: 0,0:16:28.32,0:16:32.19,Default,,0,0,0,,Бұл сезім... бұл мен бұрын сезінген телепатия.
Dialogue: 0,0:16:32.55,0:16:34.19,Default,,0,0,0,,003 001！
Dialogue: 0,0:16:35.26,0:16:37.16,Default,,0,0,0,,Иван виски?
Dialogue: 0,0:16:37.46,0:16:40.19,Default,,0,0,0,,Мен бірінші рет телепатиялық түрде осылай сөйлеп тұрмын.
Dialogue: 0,0:16:41.06,0:16:45.00,Default,,0,0,0,,Мен сізді механикалық экстрасенс деп ойладым...
Dialogue: 0,0:16:45.13,0:16:46.30,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:16:47.47,0:16:49.14,Default,,0,0,0,,Бұл бір текті ме?
Dialogue: 0,0:16:50.07,0:16:51.01,Default,,0,0,0,,Мен?
Dialogue: 0,0:16:52.47,0:16:53.21,Default,,0,0,0,,Әй
Dialogue: 0,0:16:53.71,0:16:56.48,Default,,0,0,0,,Көп уақыттан бері бірінші рет қызығушылық таныттым.
Dialogue: 0,0:16:56.54,0:16:57.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:57.48,0:16:58.31,Default,,0,0,0,,Ах
Dialogue: 0,0:16:58.61,0:16:59.48,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:16:59.71,0:17:04.72,Default,,0,0,0,,…бұл Цезарь әлі білмейтін нәрсе.
Dialogue: 0,0:17:04.79,0:17:05.62,Default,,0,0,0,,Хмм!
Dialogue: 0,0:17:09.02,0:17:10.19,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:17:10.69,0:17:12.19,Default,,0,0,0,,(Жерге құлаған дыбыс)
Dialogue: 0,0:17:13.23,0:17:14.63,Default,,0,0,0,,Қоқыстардың пайдасы жоқ
Dialogue: 0,0:17:14.70,0:17:15.60,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:17:15.66,0:17:16.63,Default,,0,0,0,,Ха...
Dialogue: 0,0:17:19.37,0:17:20.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:20.77,0:17:22.67,Default,,0,0,0,,Уф, аа...
Dialogue: 0,0:17:31.71,0:17:33.25,Default,,0,0,0,,(001 тыныс алуы)
Dialogue: 0,0:17:35.68,0:17:36.55,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:41.56,0:17:43.39,Default,,0,0,0,,(001 айқайлау)
Dialogue: 0,0:17:46.66,0:17:48.40,Default,,0,0,0,,Ммм
Dialogue: 0,0:17:51.60,0:17:54.23,Default,,0,0,0,,(энергия соқтығысқан дыбыс)
Dialogue: 0,0:17:54.60,0:17:56.37,Default,,0,0,0,,(001 айқайлау)
Dialogue: 0,0:18:00.44,0:18:02.24,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:18:02.31,0:18:03.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:03.71,0:18:06.48,Default,,0,0,0,,Қазір! оның гравитация өрісін бейтараптандырды
Dialogue: 0,0:18:11.32,0:18:14.35,Default,,0,0,0,,Ммм!
Dialogue: 0,0:18:14.59,0:18:15.49,Default,,0,0,0,,'Бұл не?'
Dialogue: 0,0:18:16.56,0:18:18.46,Default,,0,0,0,,(005･006 айқайы)
Dialogue: 0,0:18:19.56,0:18:22.30,Default,,0,0,0,,Ммм, қандай қабілет!
Dialogue: 0,0:18:23.13,0:18:25.70,Default,,0,0,0,,Маған жақындауға мүмкіндік бермесең, мен ештеңе істей алмаймын, Аль.
Dialogue: 0,0:18:26.30,0:18:27.33,Default,,0,0,0,,Мен берілмеймін!
Dialogue: 0,0:18:28.20,0:18:30.30,Default,,0,0,0,,Шабуыл әдісі монотонды.
Dialogue: 0,0:18:30.84,0:18:31.67,Default,,0,0,0,,Уау
Dialogue: 0,0:18:32.64,0:18:33.34,Default,,0,0,0,,Уф
Dialogue: 0,0:18:34.34,0:18:35.24,Default,,0,0,0,,Гуах
Dialogue: 0,0:18:36.44,0:18:38.31,Default,,0,0,0,,Ой-а-а...
Dialogue: 0,0:18:39.11,0:18:40.55,Default,,0,0,0,,(тастың көтерілу дыбысы)
Dialogue: 0,0:18:42.58,0:18:44.52,Default,,0,0,0,,(тастардың құлаған дыбысы)
Dialogue: 0,0:18:44.72,0:18:45.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:46.29,0:18:48.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:49.19,0:18:50.19,Default,,0,0,0,,005！
Dialogue: 0,0:18:51.59,0:18:52.43,Default,,0,0,0,,Хун
Dialogue: 0,0:18:57.20,0:18:58.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:00.50,0:19:04.34,Default,,0,0,0,,(005 айқайлау)
Dialogue: 0,0:19:05.64,0:19:06.34,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:06.71,0:19:07.74,Default,,0,0,0,,008！
Dialogue: 0,0:19:08.48,0:19:09.51,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:19:10.41,0:19:12.75,Default,,0,0,0,,(Зымырандардың ұшып бара жатқан дыбысы)
Dialogue: 0,0:19:14.25,0:19:16.52,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:18.35,0:19:19.39,Default,,0,0,0,,Ой…
Dialogue: 0,0:19:22.29,0:19:24.22,Default,,0,0,0,,Тосын шабуылдар жұмыс істемейді.
Dialogue: 0,0:19:24.89,0:19:26.23,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:19:29.76,0:19:31.67,Default,,0,0,0,,Иә, ол әлі тірі.
Dialogue: 0,0:19:31.77,0:19:32.77,Default,,0,0,0,,Гухаа
Dialogue: 0,0:19:33.60,0:19:34.54,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:19:34.60,0:19:38.74,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:19:40.51,0:19:41.78,Default,,0,0,0,,Ол қатал жігіт.
Dialogue: 0,0:19:42.34,0:19:43.64,Default,,0,0,0,,Эй! Бугер!
Dialogue: 0,0:19:43.71,0:19:46.41,Default,,0,0,0,,Алдымен қоқыстардан құтылуым керек пе?
Dialogue: 0,0:19:49.92,0:19:50.62,Default,,0,0,0,,Ах
Dialogue: 0,0:19:51.32,0:19:51.82,Default,,0,0,0,,Уау
Dialogue: 0,0:19:51.89,0:19:52.59,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:52.92,0:19:53.79,Default,,0,0,0,,009
Dialogue: 0,0:19:54.45,0:19:55.32,Default,,0,0,0,,Ах
Dialogue: 0,0:20:02.63,0:20:04.77,Default,,0,0,0,,Иә? Гравитациялық өрістің ішінде! ?
Dialogue: 0,0:20:06.87,0:20:07.57,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:09.84,0:20:10.67,Default,,0,0,0,,Уау
Dialogue: 0,0:20:11.64,0:20:13.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:14.41,0:20:15.24,Default,,0,0,0,,Ах
Dialogue: 0,0:20:23.72,0:20:24.65,Default,,0,0,0,,Ох… ол маған ашулы қарап тұр
Dialogue: 0,0:20:38.30,0:20:39.90,Default,,0,0,0,,А...
Dialogue: 0,0:20:52.98,0:20:56.92,Default,,0,0,0,,Әй, бетперде киген актер кім?
Dialogue: 0,0:20:59.35,0:21:00.45,Default,,0,0,0,,Сен сол ойында есіңдегі естеліктеріңді маған сеніп тапсырсаң—
Dialogue: 0,0:21:01.92,0:21:03.46,Default,,0,0,0,,Бұл суреттегі адам!
Dialogue: 0,0:21:06.86,0:21:10.26,Default,,0,0,0,,Сонымен, сіз біз туралы көп білетінсіз бе?
Dialogue: 0,0:21:10.73,0:21:15.67,Default,,0,0,0,,Олар табиғаттан тыс тіршілік иелері, әрқайсысының өз қабілеті бар...
Dialogue: 0,0:21:15.94,0:21:16.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:17.70,0:21:20.27,Default,,0,0,0,,Иван? Сіз ұйықтадыңыз ба?
Dialogue: 0,0:21:20.47,0:21:22.84,Default,,0,0,0,,(001 ұйқысы)
Dialogue: 0,0:21:22.94,0:21:24.88,Default,,0,0,0,,Сіз телепортацияны қолдандыңыз.
Dialogue: 0,0:21:25.51,0:21:27.28,Default,,0,0,0,,Ол біраз уақыт ояу болады.
Dialogue: 0,0:21:27.45,0:21:28.28,Default,,0,0,0,,О...
Dialogue: 0,0:21:28.75,0:21:29.82,Default,,0,0,0,,Люси! ?
Dialogue: 0,0:21:31.02,0:21:31.89,Default,,0,0,0,,О!
Dialogue: 0,0:21:32.02,0:21:35.39,Default,,0,0,0,,Бұл дүние – сахна, әркім – актер
Dialogue: 0,0:21:36.76,0:21:38.73,Default,,0,0,0,,Хмм, солай ма?
Dialogue: 0,0:21:40.49,0:21:41.70,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:42.40,0:21:44.97,Default,,0,0,0,,Ынтымақтастық үшін рахмет, жас ханым.
Dialogue: 0,0:21:45.57,0:21:46.73,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:21:46.90,0:21:49.60,Default,,0,0,0,,Мен жауды бақылауды жоспарладым, бірақ...
Dialogue: 0,0:21:50.04,0:21:53.41,Default,,0,0,0,,Жарайды, тамыры мен ойлағаннан да тереңірек.
Dialogue: 0,0:21:54.31,0:21:56.51,Default,,0,0,0,,Барлығыңызға рахмет, біз құтқарылдық.
Dialogue: 0,0:21:57.98,0:21:58.91,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:00.05,0:22:00.91,Default,,0,0,0,,Бірақ-
Dialogue: 0,0:22:01.72,0:22:04.02,Default,,0,0,0,,Мен шынымен де қатыстым.
Dialogue: 0,0:22:09.52,0:22:16.10,Default,,0,0,0,,(төбеден ұшып бара жатқан ұшақтың дыбысы)
Dialogue: 0,0:22:16.36,0:22:20.10,Default,,0,0,0,,«Біріккен Ұлттар Ұйымының қамқоршылары»
Dialogue: 0,0:22:21.60,0:22:27.60,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory