Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.00,0:00:23.69,Default,,0,0,0,,♬～
Dialogue: 0,0:00:23.69,0:00:26.19,Default,,0,0,0,,Мектепте бір нәрсе қалқып тұр!
Dialogue: 0,0:00:26.19,0:00:28.52,Default,,0,0,0,,Ертең Рождество мерекесі.
Dialogue: 0,0:00:28.52,0:00:32.53,Default,,0,0,0,,Біз жабылу салтанатынан кейін кеш өткізу туралы айтып жатырмыз.
Dialogue: 0,0:00:32.53,0:00:36.03,Default,,0,0,0,,Алаңсыз, жақын арада болатын ойраннан бейхабар...
Dialogue: 0,0:00:36.03,0:00:40.87,Default,,0,0,0,,Жоқ, тіпті бұл біз жойылудың болашағы қандай болатынын білмейміз➨
Dialogue: 0,0:00:40.87,0:00:44.54,Default,,0,0,0,,Парадоксальды түрде, бұл алаңсыз жүруге болады дегенді білдіре ме?
Dialogue: 0,0:00:44.54,0:00:46.54,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:00:46.54,0:00:49.88,Default,,0,0,0,,Кішкене болсаң да, мен сенімен бірге боламын...
Dialogue: 0,0:00:49.88,0:00:52.88,Default,,0,0,0,,Хахахаха! Соңғы кезден бері көп уақыт өтті➨
Dialogue: 0,0:00:52.88,0:00:55.22,Default,,0,0,0,,Сүйкімді сөздер айта бастадыңыз, Ю.
Dialogue: 0,0:00:55.22,0:00:57.55,Default,,0,0,0,,Иә, тоқтаңыз!
Dialogue: 0,0:00:57.55,0:00:59.72,Default,,0,0,0,,《Думеки: Иә, жерді жаулап ал➨
Dialogue: 0,0:00:59.72,0:01:02.82,Default,,0,0,0,,Біздің міндетіміз – болашақ жойылудың алдын алу.
Dialogue: 0,0:01:02.82,0:01:05.66,Default,,0,0,0,,Жолыма түскендердің бәрін жеңуге бел байладым.
Dialogue: 0,0:01:05.66,0:01:08.16,Default,,0,0,0,,Мен... бірақ...》
Dialogue: 0,0:01:11.33,0:01:13.34,Default,,0,0,0,,《Оны жасауға бола ма?
Dialogue: 0,0:01:13.34,0:01:17.84,Default,,0,0,0,,Игі іс үшін мен ол кісіні қолыма аламын...
Dialogue: 0,0:01:17.84,0:01:22.34,Default,,0,0,0,,Иә...жоспар жоспарланғандай орындалуда➨
Dialogue: 0,0:01:22.34,0:01:25.35,Default,,0,0,0,,Менің бастығым...
Dialogue: 0,0:01:25.35,0:01:27.68,Default,,0,0,0,,Міне, осында.
Dialogue: 0,0:01:27.68,0:01:31.02,Default,,0,0,0,,Қираудың болашағын өзгертетін уәде етілген күн...
Dialogue: 0,0:01:31.02,0:01:33.02,Default,,0,0,0,,Көкек!
Dialogue: 0,0:03:19.10,0:03:25.17,Default,,0,0,0,,Уау, мектептегі Рождестволық кеш көңілді және стильді өтті!
Dialogue: 0,0:03:25.17,0:03:28.00,Default,,0,0,0,,Күтпеген партияның барлық қысқартулары! ?
Dialogue: 0,0:03:28.00,0:03:30.01,Default,,0,0,0,,Аванда сонша шайқаңыз! ?
Dialogue: 0,0:03:30.01,0:03:32.01,Default,,0,0,0,,Өзіміз ойланайық➨
Dialogue: 0,0:03:32.01,0:03:35.68,Default,,0,0,0,,Олар мектептегі анимедегі стандартты мектеп оқиғаларының көбін жасамайтын сияқты ма?
Dialogue: 0,0:03:35.68,0:03:39.18,Default,,0,0,0,,Өйткені Куродама жатақханасында тұру оңай.
Dialogue: 0,0:03:39.18,0:03:42.35,Default,,0,0,0,,Шығарманың атауында өтірік тым көп.
Dialogue: 0,0:03:42.35,0:03:44.35,Default,,0,0,0,,Нұррулуру.
Dialogue: 0,0:03:44.35,0:03:47.19,Default,,0,0,0,,Егер болашақта болса, JARO-ның маған ашулану мүмкіндігі жоқ.
Dialogue: 0,0:03:47.19,0:03:50.19,Default,,0,0,0,,Нұру-чанның болашақ туралы айтуы сирек.
Dialogue: 0,0:03:50.19,0:03:53.03,Default,,0,0,0,,Болашақ әдемі ғой, солай ма?
Dialogue: 0,0:03:53.03,0:03:56.36,Default,,0,0,0,,Дұрыс... Жануарлардың интеллект деңгейі жоғары➨
Dialogue: 0,0:03:56.36,0:04:00.20,Default,,0,0,0,,Өмір сүруге қолайлы әлем құру және адамдарды қолдау...➨
Dialogue: 0,0:04:00.20,0:04:02.64,Default,,0,0,0,,Бейбіт өмір сүріп, манул.
Dialogue: 0,0:04:02.64,0:04:05.64,Default,,0,0,0,,Мен «бақылау» деп айтайын деп едім, бұл дөңгелек нәрсе.
Dialogue: 0,0:04:05.64,0:04:09.31,Default,,0,0,0,,Міне, мысықтарды адамдардан артық дейді...
Dialogue: 0,0:04:09.31,0:04:11.31,Default,,0,0,0,,Нұррулуру.
Dialogue: 0,0:04:11.31,0:04:13.82,Default,,0,0,0,,Рождествода да Манул әлі де қалады.
Dialogue: 0,0:04:13.82,0:04:16.49,Default,,0,0,0,,О! Болашақта жалғасатынына сенбеймін➨
Dialogue: 0,0:04:16.49,0:04:18.65,Default,,0,0,0,,Күтілгендей, Рождество өте сәнді!
Dialogue: 0,0:04:18.65,0:04:20.66,Default,,0,0,0,,Тағы, тағы!
Dialogue: 0,0:04:23.33,0:04:26.16,Default,,0,0,0,,Мен неге мұндамын?
Dialogue: 0,0:04:26.16,0:04:29.16,Default,,0,0,0,,《Думеки: Сіз шынымен де татуласуға тырысып жатырсыз ба?
Dialogue: 0,0:04:29.16,0:04:32.17,Default,,0,0,0,,Өткен реніштерді ұмытыңыз➨
Dialogue: 0,0:04:32.17,0:04:36.17,Default,,0,0,0,,Сол уақытты қайтару үшін мен…》
Dialogue: 0,0:04:38.34,0:04:42.01,Default,,0,0,0,,Бүгін кешке Куродама жатақханасында сәнді Рождество кешін өткізейік!
Dialogue: 0,0:04:42.01,0:04:44.01,Default,,0,0,0,,Иә? (құлап түскен дыбыс)
Dialogue: 0,0:04:44.01,0:04:46.01,Default,,0,0,0,,Иә? null?
Dialogue: 0,0:04:46.01,0:04:49.18,Default,,0,0,0,,Не? Қазір дыбыс қандай? Бұл егеуқұйрық емес пе?
Dialogue: 0,0:04:49.18,0:04:52.85,Default,,0,0,0,,Егер бұл Рождестволық кеш болса, біз оны жаңа ғана өткіздік.
Dialogue: 0,0:04:52.85,0:04:55.36,Default,,0,0,0,,Бұл толық кесілген болатын.
Dialogue: 0,0:04:55.36,0:04:58.03,Default,,0,0,0,,Қанша рет сынасаң да биік жаға!
Dialogue: 0,0:04:58.03,0:05:01.96,Default,,0,0,0,,Әдемі нәрсені қанша рет жасасаң да әдемі болатыны рас.
Dialogue: 0,0:05:01.96,0:05:03.97,Default,,0,0,0,,Мен келісемін!
Dialogue: 0,0:05:03.97,0:05:05.97,Default,,0,0,0,,Той болса, мен де!
Dialogue: 0,0:05:05.97,0:05:09.14,Default,,0,0,0,,Ук-кунның жауабы қажет емес пе? (Ошаманбе) А?
Dialogue: 0,0:05:09.14,0:05:12.14,Default,,0,0,0,,Бәрібір асқазаннан қуат алады.
Dialogue: 0,0:05:12.14,0:05:16.14,Default,,0,0,0,,Мияу! Мен де Юруфинмен махаббатымды бөліскім келеді!
Dialogue: 0,0:05:16.14,0:05:18.65,Default,,0,0,0,,Бұл тым асығыс.
Dialogue: 0,0:05:18.65,0:05:21.32,Default,,0,0,0,,Ас әзірлеу қанша күш жұмсайды деп ойлайсыз?
Dialogue: 0,0:05:21.32,0:05:23.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:23.32,0:05:26.32,Default,,0,0,0,,Менің қолым жақсарып келеді!
Dialogue: 0,0:05:26.32,0:05:29.82,Default,,0,0,0,,Тор-чан жанып жатыр... Бұл менің анамның жаны...
Dialogue: 0,0:05:29.82,0:05:34.00,Default,,0,0,0,,Кууу! Мен Куродама жатақханасының Рождестволық кешін асыға күтемін!
Dialogue: 0,0:05:34.00,0:05:36.00,Default,,0,0,0,,Ах... (соққы дыбысы)
Dialogue: 0,0:05:36.00,0:05:38.00,Default,,0,0,0,,Не?
Dialogue: 0,0:05:38.00,0:05:42.30,Default,,0,0,0,,Хаха... Шинкуро Унзен! !
Dialogue: 0,0:05:44.51,0:05:50.51,Default,,0,0,0,,Егер бұлай болса, мен оны осы жерде және қазір таң қалдырамын... Қарғыс атсын!
Dialogue: 0,0:05:50.51,0:05:54.52,Default,,0,0,0,,Төбелессең, әділ, шаршы алаңға...
Dialogue: 0,0:05:54.52,0:05:59.62,Default,,0,0,0,,Асыл адам құмарлыққа берілсе, соңына дейін ұят болады!
Dialogue: 0,0:06:02.29,0:06:05.99,Default,,0,0,0,,Тағы бір итеру... Менің ойымша.
Dialogue: 0,0:06:08.30,0:06:13.13,Default,,0,0,0,,Уф... Рождество қарсаңында шомылу өте керемет.
Dialogue: 0,0:06:13.13,0:06:17.14,Default,,0,0,0,,Аа, дайындық үстінде өзімізді тазартайық. (2 адам) Иә.
Dialogue: 0,0:06:17.14,0:06:20.64,Default,,0,0,0,,Жоқ Кешке дайындалар алдында тазару дегенді қалай түсінесіңдер?
Dialogue: 0,0:06:20.64,0:06:22.64,Default,,0,0,0,,Күтесіз бе?
Dialogue: 0,0:06:22.64,0:06:25.65,Default,,0,0,0,,Тазарту дегеніміз – оны әдемі ету...
Dialogue: 0,0:06:25.65,0:06:29.48,Default,,0,0,0,,Не? Әдемі болғанша, оның еш жамандығы жоқ!
Dialogue: 0,0:06:29.48,0:06:32.99,Default,,0,0,0,,Сенің байқағыштығың өте жақсы. (Койшикава) Хехехе.
Dialogue: 0,0:06:32.99,0:06:36.49,Default,,0,0,0,,Кішкентай құстардың ойнағанын көру әрқашан қызықты.
Dialogue: 0,0:06:36.49,0:06:39.33,Default,,0,0,0,,Сіз сонда болдыңыз ба? Коишикава Сенпай.
Dialogue: 0,0:06:39.33,0:06:42.50,Default,,0,0,0,,Синкуро мені кешке шақырды.
Dialogue: 0,0:06:42.50,0:06:44.67,Default,,0,0,0,,Сіз мені кенет мазаладыңыз ба?
Dialogue: 0,0:06:44.67,0:06:46.67,Default,,0,0,0,,Жоқ, проблема жоқ.
Dialogue: 0,0:06:46.67,0:06:49.00,Default,,0,0,0,,Тойға жетер тамағым бар.
Dialogue: 0,0:06:49.00,0:06:51.51,Default,,0,0,0,,Рождество туралы ойлағанда, күркетауық елестейді! ?
Dialogue: 0,0:06:51.51,0:06:55.34,Default,,0,0,0,,Ой, бұл керемет ингредиенттер!
Dialogue: 0,0:06:55.34,0:06:58.18,Default,,0,0,0,,Жоқ, өкінішке орай мен күркетауық ала алмадым.
Dialogue: 0,0:06:58.18,0:07:00.18,Default,,0,0,0,,Сондықтан орнына➨
Dialogue: 0,0:07:00.18,0:07:03.29,Default,,0,0,0,,Мен тауықты дайындадым, кейін сығып аламын.
Dialogue: 0,0:07:03.29,0:07:07.62,Default,,0,0,0,,Ах, міне, өзіңді тазарту деген осы...
Dialogue: 0,0:07:07.62,0:07:12.29,Default,,0,0,0,,Рождество туралы айтатын болсақ, бәрі қуырылған құстар туралы! ?
Dialogue: 0,0:07:12.29,0:07:15.96,Default,,0,0,0,,Жоқ, жоқ, таза ақ тартар да әдемі тауық нанбан!
Dialogue: 0,0:07:15.96,0:07:19.63,Default,,0,0,0,,Маған якитори ұнайды, өйткені сіз әртүрлі бөліктерден ләззат ала аласыз!
Dialogue: 0,0:07:19.63,0:07:22.14,Default,,0,0,0,,Жоқ, бұл қуырылған!
Dialogue: 0,0:07:22.14,0:07:25.47,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым! (5 адам) Хахаха!
Dialogue: 0,0:07:25.47,0:07:27.64,Default,,0,0,0,,Раку мырза ше? Койшикава ше? Ал Койшикава-сенпай ше?
Dialogue: 0,0:07:27.64,0:07:29.98,Default,,0,0,0,,Ха! ? (Унана) Дұрыс➨
Dialogue: 0,0:07:29.98,0:07:31.98,Default,,0,0,0,,Койсикаваның пікірін де тыңдайық.
Dialogue: 0,0:07:31.98,0:07:35.32,Default,,0,0,0,,Уф….
Dialogue: 0,0:07:35.32,0:07:37.65,Default,,0,0,0,,Рождествоға арналған тауық еті➨
Dialogue: 0,0:07:37.65,0:07:40.82,Default,,0,0,0,,Бұндай тұрақты ойдың жетегінде кету дұрыс па?
Dialogue: 0,0:07:40.82,0:07:42.82,Default,,0,0,0,,Ойымызды өзгертейік.
Dialogue: 0,0:07:42.82,0:07:45.16,Default,,0,0,0,,Тауық емес, балық➨
Dialogue: 0,0:07:45.16,0:07:48.16,Default,,0,0,0,,Иә, масса керемет емес пе?
Dialogue: 0,0:07:48.16,0:07:50.33,Default,,0,0,0,,Тек Рождествоға арналған.
Dialogue: 0,0:07:50.33,0:07:54.00,Default,,0,0,0,,Киініп, кешке дайындал! (4 адам) О!
Dialogue: 0,0:07:54.00,0:07:56.00,Default,,0,0,0,,♬ “Тори~” ♬ “Қуырылған тұтас~”
Dialogue: 0,0:07:56.00,0:07:58.01,Default,,0,0,0,,♬ «Тори~» Қарғыс атсын!
Dialogue: 0,0:08:01.94,0:08:04.95,Default,,0,0,0,,Мырза, бұл...
Dialogue: 0,0:08:04.95,0:08:08.28,Default,,0,0,0,,Синкуро Унзен, Менің ойымша, бұл сіз...
Dialogue: 0,0:08:08.28,0:08:11.62,Default,,0,0,0,,О, Сью және басқалары, қош келдіңіздер!
Dialogue: 0,0:08:11.62,0:08:14.12,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:14.12,0:08:16.62,Default,,0,0,0,,Бұл Аяз ата!
Dialogue: 0,0:08:16.62,0:08:18.63,Default,,0,0,0,,Сората маған тігіп берді.
Dialogue: 0,0:08:18.63,0:08:20.63,Default,,0,0,0,,Жарайсың ба? Бұл жоғары жағалы!
Dialogue: 0,0:08:20.63,0:08:23.47,Default,,0,0,0,,Жарайды, бұрынғыдай.
Dialogue: 0,0:08:23.47,0:08:25.47,Default,,0,0,0,,Бізге бәрібір...
Dialogue: 0,0:08:25.47,0:08:29.64,Default,,0,0,0,,Иә! Рождестволық кешті бірге өткізейік!
Dialogue: 0,0:08:29.64,0:08:32.31,Default,,0,0,0,,Өзіңізді алдамаңыз! Неге олай?
Dialogue: 0,0:08:32.31,0:08:35.98,Default,,0,0,0,,Осындай көңілді костюм киіп, қолында тауық еті бар ол рождестволық әндерді ынтамен айтты➨
Dialogue: 0,0:08:35.98,0:08:39.15,Default,,0,0,0,,Аяз ата келгенше түн ортасына дейін күтуіміз керек!
Dialogue: 0,0:08:39.15,0:08:42.15,Default,,0,0,0,,Сен басқаларға қарағанда қатты толқыдың! ?
Dialogue: 0,0:08:42.15,0:08:44.15,Default,,0,0,0,,Менде әлі күнге дейін костюмдер бар.
Dialogue: 0,0:08:44.15,0:08:47.49,Default,,0,0,0,,Мен сен сияқты әдемі киінемін деп ойламаймын.
Dialogue: 0,0:08:47.49,0:08:51.49,Default,,0,0,0,,Пісіруге тамақ көп, сондықтан тағы үш адам болса да қиындық тудырмайды.
Dialogue: 0,0:08:51.49,0:08:54.33,Default,,0,0,0,,Бізге қосылыңыз!
Dialogue: 0,0:08:54.33,0:08:57.17,Default,,0,0,0,,Жарайды, жарайды, жарайды, көз жасын төгетіндей түрі бар➨
Dialogue: 0,0:08:57.17,0:08:59.17,Default,,0,0,0,,Сіз жақсы шыдамды болдыңыз.
Dialogue: 0,0:08:59.17,0:09:01.67,Default,,0,0,0,,Мырза…. төраға!
Dialogue: 0,0:09:01.67,0:09:06.94,Default,,0,0,0,,Рождество бірге өте қызықты болады, Сью!
Dialogue: 0,0:09:06.94,0:09:09.78,Default,,0,0,0,,Сіз... әрқашан жасайсыз!
Dialogue: 0,0:09:09.78,0:09:12.78,Default,,0,0,0,,Иә? Әрқашан әрқашан➨
Dialogue: 0,0:09:12.78,0:09:15.95,Default,,0,0,0,,Сіз бұл сияқты бірдеңені қаншалықты төмен айта аласыз!
Dialogue: 0,0:09:15.95,0:09:18.29,Default,,0,0,0,,Қарғыс атсын! ⸨Үнзен: Рождестволық кеш пе?
Dialogue: 0,0:09:18.29,0:09:20.46,Default,,0,0,0,,Не? сол.
Dialogue: 0,0:09:20.46,0:09:23.63,Default,,0,0,0,,Уму Үш ұлының сапары құтты болсын➨
Dialogue: 0,0:09:23.63,0:09:27.13,Default,,0,0,0,,Бұл жақын адамдарыңызбен ән айтуды ұнататын батыстық оқиға.
Dialogue: 0,0:09:27.13,0:09:29.13,Default,,0,0,0,,О!
Dialogue: 0,0:09:29.13,0:09:31.30,Default,,0,0,0,,Мм, биік жаға? Дұрыс!
Dialogue: 0,0:09:31.30,0:09:34.64,Default,,0,0,0,,Әнде барлығы ән айтып, би билеп, дәмді тағамнан дәм татады➨
Dialogue: 0,0:09:34.64,0:09:37.47,Default,,0,0,0,,Сыйлықтармен алмасады.
Dialogue: 0,0:09:37.47,0:09:40.64,Default,,0,0,0,,Шинкуро талап етсе➨
Dialogue: 0,0:09:40.64,0:09:43.48,Default,,0,0,0,,Мен сізді шақыруға қарсы емеспін, бірақ...
Dialogue: 0,0:09:43.48,0:09:45.98,Default,,0,0,0,,Бар! Мен де бұталы маса емеспін!
Dialogue: 0,0:09:45.98,0:09:48.98,Default,,0,0,0,,Хехе, асыға күтемін, Сью!
Dialogue: 0,0:09:48.98,0:09:51.29,Default,,0,0,0,,О, мен де!
Dialogue: 0,0:09:54.66,0:09:56.66,Default,,0,0,0,,Хе хехе.
Dialogue: 0,0:09:56.66,0:10:27.19,Default,,0,0,0,,♬～
Dialogue: 0,0:10:27.19,0:10:29.69,Default,,0,0,0,,Хаха….
Dialogue: 0,0:10:29.69,0:10:31.69,Default,,0,0,0,,Қайырлы таң Сью!
Dialogue: 0,0:10:31.69,0:10:34.03,Default,,0,0,0,,Кешегі күн үшін кешіріңіз! Сонымен...
Dialogue: 0,0:10:34.03,0:10:37.03,Default,,0,0,0,,Үйге қайт! иә?
Dialogue: 0,0:10:37.03,0:10:39.03,Default,,0,0,0,,Мен саған үйіңе қайт дедім! ⸩
Dialogue: 0,0:10:41.70,0:10:44.04,Default,,0,0,0,,Шинкуро Унзен➨
Dialogue: 0,0:10:44.04,0:10:47.71,Default,,0,0,0,,Жоқ, жоғары түсті романтикалық топ! Жарқын қызыл!
Dialogue: 0,0:10:47.71,0:10:50.38,Default,,0,0,0,,Иә? (Ниппель/Некома) Не! ?
Dialogue: 0,0:10:50.38,0:10:52.38,Default,,0,0,0,,Е! ?
Dialogue: 0,0:10:52.38,0:10:54.38,Default,,0,0,0,,Самон! Ю! (2 адам) Ха!
Dialogue: 0,0:10:54.38,0:10:56.38,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:10:56.38,0:10:58.69,Default,,0,0,0,,Банкараның өзгеруі!
Dialogue: 0,0:11:03.49,0:11:06.10,Default,,0,0,0,,Муракумо, Толық желдің қылышы!
Dialogue: 0,0:11:06.10,0:11:12.00,Default,,0,0,0,,Сегіз қырлы айна Шинкейцу!
Dialogue: 0,0:11:12.00,0:11:17.01,Default,,0,0,0,,Құдайдың есебі жынның сюжеттік добы Хасшаку Ционг!
Dialogue: 0,0:11:17.01,0:11:20.68,Default,,0,0,0,,Біз тәртіп пен тәртіп сақшыларымыз!
Dialogue: 0,0:11:20.68,0:11:23.68,Default,,0,0,0,,Банкара жаңа командасы!
Dialogue: 0,0:11:23.68,0:11:25.68,Default,,0,0,0,,Аа...
Dialogue: 0,0:11:25.68,0:11:29.85,Default,,0,0,0,,Бүгін мен сенімен байланысымды өз қолыммен аяқтаймын!
Dialogue: 0,0:11:29.85,0:11:32.05,Default,,0,0,0,,Міне...
Dialogue: 0,0:11:34.02,0:11:36.02,Default,,0,0,0,,Міне...
Dialogue: 0,0:11:36.02,0:11:39.19,Default,,0,0,0,,Бүгін мен сенімен байланысымды өз қолыммен аяқтаймын!
Dialogue: 0,0:11:39.19,0:11:42.20,Default,,0,0,0,,Әйтеуір, бөтен жүз, бөтен дауыс.
Dialogue: 0,0:11:42.20,0:11:44.20,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:11:44.20,0:11:48.37,Default,,0,0,0,,Бәрін ашатын кез келген сияқты.
Dialogue: 0,0:11:48.37,0:11:51.07,Default,,0,0,0,,Тануды тежеуді жою науқаны!
Dialogue: 0,0:11:54.88,0:11:57.38,Default,,0,0,0,,Думеки және басқалары - Банкара Шин-Эй-тай...
Dialogue: 0,0:11:57.38,0:12:01.88,Default,,0,0,0,,Оның соншалықты әдемі жасырылғанына сене алар емеспін...
Dialogue: 0,0:12:01.88,0:12:03.82,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:12:03.82,0:12:06.15,Default,,0,0,0,,Неліктен ол өзінің шынайы болмысын ашуды шешті➨
Dialogue: 0,0:12:06.15,0:12:08.66,Default,,0,0,0,,Мен бәрін түсінбеймін, бірақ бәрібір!
Dialogue: 0,0:12:08.66,0:12:11.49,Default,,0,0,0,,Хикара романтикалық тобының шынайы тұлғасын көру нені білдіреді➨
Dialogue: 0,0:12:11.49,0:12:14.16,Default,,0,0,0,,Өйткені, қожайынымызға лайық!
Dialogue: 0,0:12:14.16,0:12:17.83,Default,,0,0,0,,Сіз нені айтып тұрсыз, Сью? Неліктен жерді жаулап алу керек? ?
Dialogue: 0,0:12:17.83,0:12:21.17,Default,,0,0,0,,Енді сенімен сөйлесуге сөз жоқ!
Dialogue: 0,0:12:21.17,0:12:23.17,Default,,0,0,0,,2-раунд, 1-жекпе-жек
Dialogue: 0,0:12:23.17,0:12:25.51,Default,,0,0,0,,Егер бұл орын алса, біз де өзгереміз!
Dialogue: 0,0:12:25.51,0:12:27.51,Default,,0,0,0,,Nuruluru Сондай-ақ мынаны қараңыз➨
Dialogue: 0,0:12:27.51,0:12:29.68,Default,,0,0,0,,Когнитивті тежелуді жояды және манулға айналады.
Dialogue: 0,0:12:29.68,0:12:32.18,Default,,0,0,0,,Хмм? Иә, сен де!
Dialogue: 0,0:12:32.18,0:12:35.02,Default,,0,0,0,,Иә, бірақ жерді жаулау деген жоқ➨
Dialogue: 0,0:12:35.02,0:12:37.52,Default,,0,0,0,,Мені ақымақ схемаларыңыз үшін кешіріңіз➨
Dialogue: 0,0:12:37.52,0:12:39.52,Default,,0,0,0,,Бұл адамдар...
Dialogue: 0,0:12:39.52,0:12:42.52,Default,,0,0,0,,Сіз өз міндеттеріңізден үнемі қашып кетесіз...
Dialogue: 0,0:12:42.52,0:12:46.03,Default,,0,0,0,,Кеттік! Романтикалық революция гүлдейді!
Dialogue: 0,0:12:46.03,0:13:03.81,Default,,0,0,0,,♬～
Dialogue: 0,0:13:03.81,0:13:06.48,Default,,0,0,0,,Тұрсаң, сенде пион болады. Отырсаң пион болады➨
Dialogue: 0,0:13:06.48,0:13:11.32,Default,,0,0,0,,Қызыл жүзді биік жағалы бала Бриллиант Қызыл!
Dialogue: 0,0:13:11.32,0:13:13.99,Default,,0,0,0,,Романтикалық революция гүлдейді!
Dialogue: 0,0:13:13.99,0:13:19.49,Default,,0,0,0,,♬～
Dialogue: 0,0:13:19.49,0:13:22.83,Default,,0,0,0,,Әдемі қасы, суы тамшылаған биік жағалы бала➨
Dialogue: 0,0:13:22.83,0:13:25.83,Default,,0,0,0,,Меланхолик флот!
Dialogue: 0,0:13:25.83,0:13:28.50,Default,,0,0,0,,Романтикалық революция гүлдейді!
Dialogue: 0,0:13:28.50,0:13:33.68,Default,,0,0,0,,♬～
Dialogue: 0,0:13:33.68,0:13:37.35,Default,,0,0,0,,Yamashisuimei Талғампаз және әдемі биік жағалы бала➨
Dialogue: 0,0:13:37.35,0:13:40.18,Default,,0,0,0,,Ностальгиялық жасыл!
Dialogue: 0,0:13:40.18,0:13:42.85,Default,,0,0,0,,Романтикалық революция гүлдейді!
Dialogue: 0,0:13:42.85,0:13:47.69,Default,,0,0,0,,♬～
Dialogue: 0,0:13:47.69,0:13:51.36,Default,,0,0,0,,Харуки Уки Табиғи материалдан жасалған биік жағалы бала➨
Dialogue: 0,0:13:51.36,0:13:53.86,Default,,0,0,0,,Қазіргі сары!
Dialogue: 0,0:13:53.86,0:13:56.53,Default,,0,0,0,,Романтикалық революция гүлдейді!
Dialogue: 0,0:13:56.53,0:14:02.30,Default,,0,0,0,,♬～
Dialogue: 0,0:14:02.30,0:14:05.81,Default,,0,0,0,,Шіденнің жарқылы, биік жағалы баланың жарқылы➨
Dialogue: 0,0:14:05.81,0:14:08.64,Default,,0,0,0,,Эмоциялық күлгін!
Dialogue: 0,0:14:08.64,0:14:11.31,Default,,0,0,0,,Гүлдердің романтикалық иісімен толтырылған!
Dialogue: 0,0:14:11.31,0:14:14.15,Default,,0,0,0,,Адамдардың жүрегінің мейірімін түсін!
Dialogue: 0,0:14:14.15,0:14:16.98,Default,,0,0,0,,Жаңа дүниенің құйынында!
Dialogue: 0,0:14:16.98,0:14:19.49,Default,,0,0,0,,Ескі логиканы бұзыңыз!
Dialogue: 0,0:14:19.49,0:14:22.49,Default,,0,0,0,,Жұлдыздармен жарқыра, заманның баласы!
Dialogue: 0,0:14:22.49,0:14:25.33,Default,,0,0,0,,Аты-жөні Хикара Романдан!
Dialogue: 0,0:14:25.33,0:14:28.83,Default,,0,0,0,,Мен болашақты оңай өзгертемін!
Dialogue: 0,0:14:28.83,0:14:34.67,Default,,0,0,0,,Әй, бұлар шынында да жоғары деңгейдегі романтикалық топ еді!
Dialogue: 0,0:14:34.67,0:14:37.51,Default,,0,0,0,,Мен Унзен Шинкуромен айналысамын.
Dialogue: 0,0:14:37.51,0:14:40.68,Default,,0,0,0,,Ю Самон Басқалары сұрады!
Dialogue: 0,0:14:40.68,0:14:42.68,Default,,0,0,0,,Джо Гоин!
Dialogue: 0,0:14:42.68,0:14:45.01,Default,,0,0,0,,Шинкуро Унзен! !
Dialogue: 0,0:14:45.01,0:14:47.35,Default,,0,0,0,,Қарғыс атсын! Мистер Сью...
Dialogue: 0,0:14:47.35,0:14:49.35,Default,,0,0,0,,Куу... Ха!
Dialogue: 0,0:14:49.35,0:14:52.52,Default,,0,0,0,,Уау! (Сукаю) Шин-чан!
Dialogue: 0,0:14:52.52,0:14:54.52,Default,,0,0,0,,Сіз бізбен айналысып жатырсыз.
Dialogue: 0,0:14:54.52,0:14:56.52,Default,,0,0,0,,Мен саған жол бермеймін!
Dialogue: 0,0:14:56.52,0:14:58.53,Default,,0,0,0,,Ой! (Унана) Хмм!
Dialogue: 0,0:14:58.53,0:15:02.63,Default,,0,0,0,,Ха ха ха... Менің жүзім саған жете алмайды...
Dialogue: 0,0:15:02.63,0:15:05.63,Default,,0,0,0,,Мен сізді өте пайдаланушы ретінде көрдім.
Dialogue: 0,0:15:05.63,0:15:09.14,Default,,0,0,0,,Бұлай айту өте әдемі емес, бірақ...
Dialogue: 0,0:15:09.14,0:15:11.14,Default,,0,0,0,,Менің ойымша, сіз мұны жақсы емессіз.
Dialogue: 0,0:15:11.14,0:15:13.14,Default,,0,0,0,,Гаан!
Dialogue: 0,0:15:13.14,0:15:16.64,Default,,0,0,0,,Құла, Катомбо! (2 адам) Уау!
Dialogue: 0,0:15:16.64,0:15:19.65,Default,,0,0,0,,Не! ? Не болып жатыр! ?
Dialogue: 0,0:15:19.65,0:15:24.32,Default,,0,0,0,,Осындай уақытта осы Куродама жатақханасының жатақхана меңгерушісі ретінде не істеу керек:➨
Dialogue: 0,0:15:24.32,0:15:27.32,Default,,0,0,0,,Маки мен Ононы қорғаңыз!
Dialogue: 0,0:15:27.32,0:15:29.32,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:15:29.32,0:15:31.66,Default,,0,0,0,,Амансың ба, Ю...?
Dialogue: 0,0:15:31.66,0:15:33.66,Default,,0,0,0,,Бұл қалай көрінеді?
Dialogue: 0,0:15:33.66,0:15:36.66,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:15:36.66,0:15:39.33,Default,,0,0,0,,Неткен кескілескен шайқас! ?
Dialogue: 0,0:15:39.33,0:15:42.34,Default,,0,0,0,,Аа, бұл өте қатты болды...
Dialogue: 0,0:15:42.34,0:15:45.51,Default,,0,0,0,,Барлық қателіктерді жасау да талант.
Dialogue: 0,0:15:45.51,0:15:47.68,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:47.68,0:15:50.34,Default,,0,0,0,,Бірақ мен саған жақындауыңа мүмкіндік бермедім!
Dialogue: 0,0:15:50.34,0:15:52.35,Default,,0,0,0,,Тым көп салдарлық.
Dialogue: 0,0:15:52.35,0:15:56.68,Default,,0,0,0,,Жерді қорғау үшін мен де өз денемді желіге қояйын ба?
Dialogue: 0,0:15:56.68,0:15:58.69,Default,,0,0,0,,Енді Мануру кел!
Dialogue: 0,0:15:58.69,0:16:01.36,Default,,0,0,0,,Қожайыным аманат еткен жерді жаулап алу➨
Dialogue: 0,0:16:01.36,0:16:03.29,Default,,0,0,0,,Мен сізге кедергі келтірмеймін!
Dialogue: 0,0:16:03.29,0:16:07.30,Default,,0,0,0,,...
Dialogue: 0,0:16:07.30,0:16:10.30,Default,,0,0,0,,Өте сүйкімді.
Dialogue: 0,0:16:10.30,0:16:14.30,Default,,0,0,0,,Айтпақшы, сен неге Жерді жаулап алмақсың?
Dialogue: 0,0:16:14.30,0:16:17.14,Default,,0,0,0,,Мен не білдім! Болашақтың жойылуын қалай болдырмауға болады➨
Dialogue: 0,0:16:17.14,0:16:20.31,Default,,0,0,0,,Күшті адам жерді басқаруы керек!
Dialogue: 0,0:16:20.31,0:16:23.64,Default,,0,0,0,,Бұл біздің тамырымызда асыл қан ағып жатқан миссиямыз!
Dialogue: 0,0:16:23.64,0:16:26.98,Default,,0,0,0,,Болашақ жойылу? Бұл не...?
Dialogue: 0,0:16:26.98,0:16:28.98,Default,,0,0,0,,(ырылдаған дыбыс)
Dialogue: 0,0:16:28.98,0:16:31.99,Default,,0,0,0,,А... Мен оның не екенін де білмеймін.
Dialogue: 0,0:16:31.99,0:16:34.49,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:16:34.49,0:16:39.66,Default,,0,0,0,,Өйткені сізге Master Can да, Master x Master да айтпайды.
Dialogue: 0,0:16:39.66,0:16:42.66,Default,,0,0,0,,Ендеше, бұл не себепті қаншық?
Dialogue: 0,0:16:42.66,0:16:44.67,Default,,0,0,0,,О!
Dialogue: 0,0:16:44.67,0:16:47.17,Default,,0,0,0,,Қарғыс атсын! Қарғыс атсын!
Dialogue: 0,0:16:47.17,0:16:49.17,Default,,0,0,0,,Тоқта, Сью!
Dialogue: 0,0:16:49.17,0:16:51.51,Default,,0,0,0,,Біздің ұрысуға себеп жоқ...
Dialogue: 0,0:16:51.51,0:16:56.18,Default,,0,0,0,,Ол жоқ деп шындап ойлағаныңды кешіре алмаймын~!
Dialogue: 0,0:16:56.18,0:16:59.01,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:59.01,0:17:02.62,Default,,0,0,0,,Кішкентай кезімізден солай істеп келеміз...
Dialogue: 0,0:17:02.62,0:17:04.79,Default,,0,0,0,,Иә! Мәңгі, мәңгілік➨
Dialogue: 0,0:17:04.79,0:17:07.29,Default,,0,0,0,,Маған опасыздық жасалды!
Dialogue: 0,0:17:07.29,0:17:09.29,Default,,0,0,0,,Дұрыс, болды!
Dialogue: 0,0:17:09.29,0:17:12.13,Default,,0,0,0,,Мен... Сью мырзаға опасыздық жасадым ба?
Dialogue: 0,0:17:12.13,0:17:14.30,Default,,0,0,0,,Сене алмайтын сияқтысың!
Dialogue: 0,0:17:14.30,0:17:17.80,Default,,0,0,0,,Онда мен саған сенің істеген қылмысыңды айтамын!
Dialogue: 0,0:17:17.80,0:17:22.30,Default,,0,0,0,,Ұзақ қашықтыққа жүзуден балалар жарысында сіз бірге мәреге жетеміз деп айттыңыз➨
Dialogue: 0,0:17:22.30,0:17:24.97,Default,,0,0,0,,Мені артта қалдырып, мақсатқа жалғыз жеттіңіз!
Dialogue: 0,0:17:24.97,0:17:27.31,Default,,0,0,0,,Шаянды бірге жеген кезде➨
Dialogue: 0,0:17:27.31,0:17:31.15,Default,,0,0,0,,Ол бүйірден мен қопсытқан шаянның етін жұлып алды!
Dialogue: 0,0:17:31.15,0:17:35.15,Default,,0,0,0,,Біз бірге кәмпит сататын дүкенге барғанымызда, мен әмиянымды ұмытып қалыппын➨
Dialogue: 0,0:17:35.15,0:17:37.15,Default,,0,0,0,,Мен барып аламын дедім де, дүкеннен жүгіріп шықтым➨
Dialogue: 0,0:17:37.15,0:17:39.55,Default,,0,0,0,,Ақырында ол қайтып келмеді!
Dialogue: 0,0:17:41.99,0:17:44.49,Default,,0,0,0,,Осындай нәрсе болды ма?
Dialogue: 0,0:17:44.49,0:17:46.99,Default,,0,0,0,,Бұл әлі олай емес!
Dialogue: 0,0:17:46.99,0:17:51.33,Default,,0,0,0,,Жасырынбақ, мені ұмытып, үйге жалғыз қайттың!
Dialogue: 0,0:17:51.33,0:17:53.50,Default,,0,0,0,,Қоғамдық моншада іш киімді ауыстыруды ұмытып қалдым➨
Dialogue: 0,0:17:53.50,0:17:56.34,Default,,0,0,0,,Ол менің іш киімімді рұқсатсыз киіп алған!
Dialogue: 0,0:17:56.34,0:17:59.34,Default,,0,0,0,,Бөлмеде қалдырған манты жұмыртқасы шықты➨
Dialogue: 0,0:17:59.34,0:18:01.84,Default,,0,0,0,,Үй тозаққа айналды!
Dialogue: 0,0:18:04.28,0:18:07.45,Default,,0,0,0,,Әрине, осындай нәрсе болған сияқты...
Dialogue: 0,0:18:07.45,0:18:09.95,Default,,0,0,0,,Міне болды! Кешірім және Сонтаку➨
Dialogue: 0,0:18:09.95,0:18:12.12,Default,,0,0,0,,Оның көп болғаны сонша, маған мүлдем қажет емес!
Dialogue: 0,0:18:12.12,0:18:15.62,Default,,0,0,0,,Бірақ мұның бәрі менің бала кезімнен қалған оқиға емес пе?
Dialogue: 0,0:18:15.62,0:18:17.79,Default,,0,0,0,,Барлығы да солай ойлайды, солай ма?
Dialogue: 0,0:18:17.79,0:18:20.63,Default,,0,0,0,,Бәріне сен кінәлісің.
Dialogue: 0,0:18:20.63,0:18:23.80,Default,,0,0,0,,Дұшпандар мен одақтастардың жүректері енді бір! ?
Dialogue: 0,0:18:23.80,0:18:26.13,Default,,0,0,0,,Бұл әдемі емес...
Dialogue: 0,0:18:26.13,0:18:28.30,Default,,0,0,0,,Шынымды айтсам, мен оны қорғай алмаймын.
Dialogue: 0,0:18:28.30,0:18:30.97,Default,,0,0,0,,Шаянды тонау әдетте өлім жазасына кесіледі.
Dialogue: 0,0:18:30.97,0:18:35.48,Default,,0,0,0,,Керісінше, осыншама шыдаған президент әулие ме, әлде басқа ма?
Dialogue: 0,0:18:35.48,0:18:37.81,Default,,0,0,0,,Қарғыс атсын... Раббым!
Dialogue: 0,0:18:37.81,0:18:40.31,Default,,0,0,0,,Бір сөзбен айтқанда...
Dialogue: 0,0:18:40.31,0:18:42.82,Default,,0,0,0,,Бұл Кусаре Гедо!
Dialogue: 0,0:18:42.82,0:18:45.99,Default,,0,0,0,,Дұшпандар мен одақтастардың жүректері толығымен бір! ?
Dialogue: 0,0:18:45.99,0:18:50.49,Default,,0,0,0,,Барлығын шешкен сол Рождество кеші болды!
Dialogue: 0,0:18:50.49,0:18:52.83,Default,,0,0,0,,Рождество түні?
Dialogue: 0,0:18:52.83,0:18:55.66,Default,,0,0,0,,Ха, күте тұрыңыз, Сью мырза, болды! ауызыңды жап!
Dialogue: 0,0:18:55.66,0:18:58.83,Default,,0,0,0,,Самон! Ю! Маған күш бер!
Dialogue: 0,0:18:58.83,0:19:01.67,Default,,0,0,0,,Ерік!
Dialogue: 0,0:19:01.67,0:19:03.94,Default,,0,0,0,,О! !
Dialogue: 0,0:19:03.94,0:19:05.94,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:19:05.94,0:19:07.94,Default,,0,0,0,,Барлығы келді ме! ?
Dialogue: 0,0:19:07.94,0:19:11.28,Default,,0,0,0,,Ал, эмоционалды түрде бұл біраз күрделі...
Dialogue: 0,0:19:11.28,0:19:14.78,Default,,0,0,0,,Шабуыл жасайық! Біздің жүрегіміз бір болады!
Dialogue: 0,0:19:14.78,0:19:17.95,Default,,0,0,0,,Бір болу туралы айтқанда, мен...
Dialogue: 0,0:19:17.95,0:19:22.46,Default,,0,0,0,,Бұл Шинкуро-сенпайдың жаман мінезінен...
Dialogue: 0,0:19:22.46,0:19:25.96,Default,,0,0,0,,Барлығыңызға рахмет! Сьюді бірге тоқтатайық!
Dialogue: 0,0:19:25.96,0:19:27.96,Default,,0,0,0,,Рефлексия!
Dialogue: 0,0:19:27.96,0:19:31.63,Default,,0,0,0,,Кеттік! (5 адам) Уау!
Dialogue: 0,0:19:31.63,0:19:33.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:33.97,0:19:36.97,Default,,0,0,0,,Енді бұл тағдырға нүкте қоятын кез келді!
Dialogue: 0,0:19:36.97,0:19:38.97,Default,,0,0,0,,Қош бол, Унзен Шинкуро!
Dialogue: 0,0:19:38.97,0:19:40.98,Default,,0,0,0,,О!
Dialogue: 0,0:19:40.98,0:19:43.31,Default,,0,0,0,,О!
Dialogue: 0,0:19:43.31,0:19:45.81,Default,,0,0,0,,Мені тыңда, Сью!
Dialogue: 0,0:19:45.81,0:19:47.82,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:19:47.82,0:19:49.82,Default,,0,0,0,,Қалай! !
Dialogue: 0,0:19:49.82,0:19:52.32,Default,,0,0,0,,Таа! !
Dialogue: 0,0:19:52.32,0:19:54.82,Default,,0,0,0,,Уау! !
Dialogue: 0,0:19:54.82,0:19:57.83,Default,,0,0,0,,Уау! !
Dialogue: 0,0:20:07.33,0:20:09.67,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,0:20:09.67,0:20:11.67,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,0:20:11.67,0:20:14.51,Default,,0,0,0,,Хмм, мен қозғала алмаймын...
Dialogue: 0,0:20:14.51,0:20:17.51,Default,,0,0,0,,Мен бар күшімді, сұлулығымды сарп еттім...
Dialogue: 0,0:20:17.51,0:20:20.01,Default,,0,0,0,,Мен де биік мойын жігітпін...
Dialogue: 0,0:20:20.01,0:20:22.68,Default,,0,0,0,,Мен күш-қуатымды толықтыруым керек...
Dialogue: 0,0:20:22.68,0:20:25.52,Default,,0,0,0,,Маған жыртқыштың көзімен қарама!
Dialogue: 0,0:20:25.52,0:20:27.52,Default,,0,0,0,,Көзілдірік Көзілдірік….
Dialogue: 0,0:20:27.52,0:20:29.69,Default,,0,0,0,,Нуо, сэр! Мырза - Изуко!
Dialogue: 0,0:20:29.69,0:20:31.69,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:20:31.69,0:20:35.36,Default,,0,0,0,,Синкуро Унзенді жеңіп, болашақ жойылудың алдын алыңыз...
Dialogue: 0,0:20:35.36,0:20:37.53,Default,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 0,0:20:37.53,0:20:39.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:39.53,0:20:42.87,Default,,0,0,0,,Бұл дауыс... Өйткені сен келдің! ?
Dialogue: 0,0:20:42.87,0:20:45.71,Default,,0,0,0,,Менің бастығым! Менің қожайыным! (2 адам) Иә?
Dialogue: 0,0:20:45.71,0:20:48.21,Default,,0,0,0,,Жарайсың➨
Dialogue: 0,0:20:48.21,0:20:51.88,Default,,0,0,0,,Банкара Шин-Эйтай және ашық түсті романтикалық труппа мүшелері.
Dialogue: 0,0:20:51.88,0:20:54.72,Default,,0,0,0,,Ынтымақтастықпен➨
Dialogue: 0,0:20:54.72,0:20:56.72,Default,,0,0,0,,Болашақ жойылудың алдын алады.
Dialogue: 0,0:20:56.72,0:20:58.72,Default,,0,0,0,,Раку мырза?
Dialogue: 0,0:20:58.72,0:21:01.72,Default,,0,0,0,,Ракуаи Коишикава Сіз кімсіз...?
Dialogue: 0,0:21:01.72,0:21:05.63,Default,,0,0,0,,Енді уәде етілген күн де ​​келді!
Dialogue: 0,0:21:11.67,0:21:15.34,Default,,0,0,0,,Не? Бұл. Аспанда үлкен тесік бар ...
Dialogue: 0,0:21:15.34,0:21:18.51,Default,,0,0,0,,Бұл... құрт тесігі.
Dialogue: 0,0:21:18.51,0:21:20.84,Default,,0,0,0,,Болашақ пен өткенді байланыстыратын науқан! ?
Dialogue: 0,0:21:20.84,0:21:22.84,Default,,0,0,0,,Ха! ?
Dialogue: 0,0:21:26.35,0:21:28.35,Default,,0,0,0,,Уау хаха.
Dialogue: 0,0:21:31.52,0:21:34.32,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:21:39.19,0:21:41.20,Default,,0,0,0,,Куродама жатақханасы...
Dialogue: 0,0:21:41.20,0:21:43.86,Default,,0,0,0,,Біздің үй...
Dialogue: 0,0:21:43.86,0:21:49.54,Default,,0,0,0,,Коккоккоккоккок! Коккоккоккокко!
Dialogue: 0,0:21:49.54,0:21:52.71,Default,,0,0,0,,Раку-сан... сен несің...?
Dialogue: 0,0:21:52.71,0:21:55.61,Default,,0,0,0,,Ой, ұмытып кетіппін.
Dialogue: 0,0:22:00.71,0:22:02.72,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:22:07.49,0:22:09.82,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:22:09.82,0:22:12.16,Default,,0,0,0,,Менің атым Фридли.
Dialogue: 0,0:22:12.16,0:22:15.83,Default,,0,0,0,,Тауық асыл герцог Фридли!
Dialogue: 0,0:22:15.83,0:22:17.83,Default,,0,0,0,,Не... сонда?
Dialogue: 0,0:22:17.83,0:22:20.84,Default,,0,0,0,,Болашақ жойылудан аулақ болғаннан кейін➨
Dialogue: 0,0:22:20.84,0:22:23.50,Default,,0,0,0,,Ол тамаша болашақты билейді.
Dialogue: 0,0:22:23.50,0:22:26.01,Default,,0,0,0,,Коко коко!
Dialogue: 0,0:22:27.51,0:22:33.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
