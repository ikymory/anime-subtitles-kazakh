Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.00,0:00:05.00,Default,,0,0,0,,<Уақыт Тайшо...
Dialogue: 0,0:00:05.00,0:00:07.67,Default,,0,0,0,,Романтикаға толы➨
Dialogue: 0,0:00:07.67,0:00:13.84,Default,,0,0,0,,Адамдардың жүрегі жанашырлықты әлі біледі＞
Dialogue: 0,0:00:13.84,0:00:16.18,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:00:16.18,0:00:18.18,Default,,0,0,0,,Жаңа➨
Dialogue: 0,0:00:18.18,0:00:21.02,Default,,0,0,0,,Таң атты!
Dialogue: 0,0:00:21.02,0:00:23.02,Default,,0,0,0,,Бүгін де Майя қаласында таң атты➨
Dialogue: 0,0:00:23.02,0:00:25.02,Default,,0,0,0,,Биік жаға!
Dialogue: 0,0:02:19.00,0:02:25.34,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:02:25.34,0:02:28.34,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:02:28.34,0:02:30.55,Default,,0,0,0,,Сәлем! (Тістеген дыбысы)
Dialogue: 0,0:02:30.55,0:02:32.55,Default,,0,0,0,,Гах! !
Dialogue: 0,0:02:32.55,0:02:35.72,Default,,0,0,0,,Itte-te-te-te! Ук-кун! ?
Dialogue: 0,0:02:35.72,0:02:37.72,Default,,0,0,0,,Мен тағы да жартылай ұйықтап жатырмын...
Dialogue: 0,0:02:37.72,0:02:39.89,Default,,0,0,0,,Иә? Сората, иә?
Dialogue: 0,0:02:39.89,0:02:42.06,Default,,0,0,0,,Міне болды! Жоқ, сен енді ғана ояндың! ?
Dialogue: 0,0:02:42.06,0:02:44.06,Default,,0,0,0,,Неге мені тағы тістейсің?
Dialogue: 0,0:02:44.06,0:02:47.90,Default,,0,0,0,,Мен оянсам, кешкі асымның бәрі жеп қойған...
Dialogue: 0,0:02:47.90,0:02:51.73,Default,,0,0,0,,Сонда менің алдымда үлкендігі ыңғайлы шалғам тұрды...
Dialogue: 0,0:02:51.73,0:02:54.07,Default,,0,0,0,,Мен...
Dialogue: 0,0:02:54.07,0:02:57.41,Default,,0,0,0,,Аяқтары өте қысқа Аджи Шусай Дайкон деген кім?
Dialogue: 0,0:02:57.41,0:02:59.41,Default,,0,0,0,,Менің сүйкімді аяқтарым➨
Dialogue: 0,0:02:59.41,0:03:01.98,Default,,0,0,0,,Қалай қарасаң да, жіңішке шалғам!
Dialogue: 0,0:03:01.98,0:03:05.15,Default,,0,0,0,,Бұл жақсы. Екі кітап бар, сондықтан екіге жуық.
Dialogue: 0,0:03:05.15,0:03:07.15,Default,,0,0,0,,Сен тым сараңсың! ?
Dialogue: 0,0:03:07.15,0:03:10.32,Default,,0,0,0,,Жаңа таң, толқын! Сората! (жылжымалы есіктің ашылған дыбысы)
Dialogue: 0,0:03:10.32,0:03:12.32,Default,,0,0,0,,Ах... Кружка....
Dialogue: 0,0:03:14.32,0:03:16.83,Default,,0,0,0,,Эй, Со Чан. (Унана) Бұл не, Ай Руши?
Dialogue: 0,0:03:16.83,0:03:19.49,Default,,0,0,0,,Йокан жақында танымал кастелла тортының арасында сэндвичтенді➨
Dialogue: 0,0:03:19.49,0:03:22.16,Default,,0,0,0,,Сібір бар, солай ма? Оны Сібір деп те атайды.
Dialogue: 0,0:03:22.16,0:03:24.17,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:03:24.17,0:03:26.67,Default,,0,0,0,,Сіз йоканның орнына қызыл бұршақ пастасын қолданасыз ба?
Dialogue: 0,0:03:26.67,0:03:29.84,Default,,0,0,0,,Екеуі де бірдей шығар, тек жазуы басқа.
Dialogue: 0,0:03:29.84,0:03:32.67,Default,,0,0,0,,Сондай-ақ, йокан қызыл бұршақ пастасын агар➨мен қатайту арқылы жасалады
Dialogue: 0,0:03:32.67,0:03:34.68,Default,,0,0,0,,Бұл жай ғана Анко. иә? Олай болса ➨
Dialogue: 0,0:03:34.68,0:03:37.51,Default,,0,0,0,,Оның орнына Уироды қойсақ та, бұл Сібір дегенді білдіре ме?
Dialogue: 0,0:03:37.51,0:03:40.52,Default,,0,0,0,,Қызыл бұршақ пастасы қызыл бұршақтан, ал уйро күріш ұнынан жасалған➨
Dialogue: 0,0:03:40.52,0:03:43.52,Default,,0,0,0,,Олар ұқсас, бірақ әртүрлі. Шынайы! ?
Dialogue: 0,0:03:49.19,0:03:51.19,Default,,0,0,0,,Ni.
Dialogue: 0,0:03:51.19,0:03:54.53,Default,,0,0,0,,Хмм, мен де бүгін таңертең әдемімін!
Dialogue: 0,0:03:54.53,0:03:56.53,Default,,0,0,0,,Сен де солай ойламайсың ба, Тор-чан?
Dialogue: 0,0:03:56.53,0:03:58.53,Default,,0,0,0,,Расымен де, Ай Руши әдемі.
Dialogue: 0,0:03:58.53,0:04:01.47,Default,,0,0,0,,Рахмет, Со Чан да әдемі.
Dialogue: 0,0:04:01.47,0:04:03.81,Default,,0,0,0,,Бұл мәселе. Не болды?
Dialogue: 0,0:04:03.81,0:04:06.81,Default,,0,0,0,,Жоқ, мен Ай Руши ➨ сұлулық байқауын жеңемін
Dialogue: 0,0:04:06.81,0:04:09.31,Default,,0,0,0,,Бұған жол бермеуге болады.
Dialogue: 0,0:04:09.31,0:04:11.81,Default,,0,0,0,,Бұл шынымен әдемі және шын мәнінде салмақты.
Dialogue: 0,0:04:11.81,0:04:13.85,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:04:13.85,0:04:16.35,Default,,0,0,0,,Өйткені мен әдемімін!
Dialogue: 0,0:04:16.35,0:04:18.32,Default,,0,0,0,,Міне! (жылжымалы есіктің ашылған дыбысы)
Dialogue: 0,0:04:18.32,0:04:21.32,Default,,0,0,0,,Уау! Таңертеңгілік ваннаны жоғары жағамен қабылдаңыз!
Dialogue: 0,0:04:23.33,0:04:27.53,Default,,0,0,0,,Қазірдің өзінде! Неліктен мені таңертең мұны істеуге мәжбүр етеді?
Dialogue: 0,0:04:27.53,0:04:29.53,Default,,0,0,0,,Сізді ваннаға тастайды!
Dialogue: 0,0:04:29.53,0:04:32.03,Default,,0,0,0,,Сората Ванна - кірер алдында киіміңізді шешетін нәрсе.
Dialogue: 0,0:04:32.03,0:04:35.87,Default,,0,0,0,,Менің айтайын дегенім осы емес пе, Торкун?
Dialogue: 0,0:04:35.87,0:04:39.04,Default,,0,0,0,,Бірақ бұл Куродама жатақханасының ережесі.
Dialogue: 0,0:04:39.04,0:04:42.38,Default,,0,0,0,,Күн шомылумен басталып, аяқталады.
Dialogue: 0,0:04:42.38,0:04:45.05,Default,,0,0,0,,Готемба жатақханасының директоры осылай деді.
Dialogue: 0,0:04:45.05,0:04:47.88,Default,,0,0,0,,Иә, сондықтан ол адам➨
Dialogue: 0,0:04:47.88,0:04:50.89,Default,,0,0,0,,Күн сайын Таңнан кешке дейін➨
Dialogue: 0,0:04:50.89,0:04:54.06,Default,,0,0,0,,Ол моншаға ағаш жаруды жалғастырады.
Dialogue: 0,0:04:56.86,0:04:59.53,Default,,0,0,0,,Біз келгеннен бері.
Dialogue: 0,0:04:59.53,0:05:01.96,Default,,0,0,0,,Құрметке лайық сұлу. (2 адам) Иә, иә!
Dialogue: 0,0:05:01.96,0:05:04.63,Default,,0,0,0,,Жоқ, мен жатақхананың басқа жұмысын істеймін.
Dialogue: 0,0:05:04.63,0:05:08.97,Default,,0,0,0,,Жаңа таң, жаңа ванна! Бұл өте стильді!
Dialogue: 0,0:05:08.97,0:05:10.97,Default,,0,0,0,,Қайтадан басталды.
Dialogue: 0,0:05:10.97,0:05:14.64,Default,,0,0,0,,Жаңа нәрселерді қаншалықты жақсы көрсең де, бәрі сәнді.
Dialogue: 0,0:05:14.64,0:05:17.31,Default,,0,0,0,,Сората да ваннаны жақсы көреді.
Dialogue: 0,0:05:17.31,0:05:19.65,Default,,0,0,0,,Мен де, маған бәрібір.
Dialogue: 0,0:05:19.65,0:05:22.65,Default,,0,0,0,,Мен аштықты қысқа уақытқа ұмытқанды жөн көремін.
Dialogue: 0,0:05:22.65,0:05:25.32,Default,,0,0,0,,Соны айтып жатып, мен тағы тамақтанып көрдім➨
Dialogue: 0,0:05:25.32,0:05:27.32,Default,,0,0,0,,Ол менің аяғыма тиіп тұр...
Dialogue: 0,0:05:27.32,0:05:30.33,Default,,0,0,0,,Мен өзім ештеңе істеген жоқпын. иә?
Dialogue: 0,0:05:30.33,0:05:33.50,Default,,0,0,0,,Қазірдің өзінде менің аяғым...
Dialogue: 0,0:05:33.50,0:05:36.00,Default,,0,0,0,,Гах! Мен қазір жалаңашпын!
Dialogue: 0,0:05:36.00,0:05:38.50,Default,,0,0,0,,Ваннада былғары нәрсе бар! ?
Dialogue: 0,0:05:38.50,0:05:41.00,Default,,0,0,0,,Не? (Унана) Нуру?
Dialogue: 0,0:05:44.34,0:05:47.01,Default,,0,0,0,,Нурухё! Міндетті түрде бірдеңе бар!
Dialogue: 0,0:05:47.01,0:05:50.68,Default,,0,0,0,,Не! ? иә?
Dialogue: 0,0:05:50.68,0:05:52.68,Default,,0,0,0,,Тірі зат... балық?
Dialogue: 0,0:05:52.68,0:05:54.68,Default,,0,0,0,,Ол күтпеген жерден сол жақ қорғаныстан тік соққымен жауап қайтарды
Dialogue: 0,0:05:54.68,0:05:56.85,Default,,0,0,0,,Қарғыс атсын, қандай әдемі қимыл! (Асо) Кет!
Dialogue: 0,0:05:56.85,0:05:59.19,Default,,0,0,0,,Мен бұл жігітті ұстаймын ба?
Dialogue: 0,0:05:59.19,0:06:02.16,Default,,0,0,0,,Нухья! ? Маған қалдырыңыз!
Dialogue: 0,0:06:02.16,0:06:06.10,Default,,0,0,0,,Міне! Әзірше емес!
Dialogue: 0,0:06:06.10,0:06:08.96,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:08.96,0:06:10.97,Default,,0,0,0,,Алда әлі көп нәрсе бар!
Dialogue: 0,0:06:10.97,0:06:12.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:12.97,0:06:14.97,Default,,0,0,0,,Әлі көп жол бар!
Dialogue: 0,0:06:14.97,0:06:17.97,Default,,0,0,0,,Уф... бұл қызық!
Dialogue: 0,0:06:17.97,0:06:21.64,Default,,0,0,0,,Иә, бар. Мақсатқа емес, құралдарға тәуелді болу.
Dialogue: 0,0:06:21.64,0:06:24.98,Default,,0,0,0,,Иә, иә! Спортшылар, жекпе-жек шеберлері және т.б.
Dialogue: 0,0:06:24.98,0:06:26.98,Default,,0,0,0,,Күшті болудан күштірек болу қиын➨
Dialogue: 0,0:06:26.98,0:06:28.98,Default,,0,0,0,,Жақсы сезіледі, сен бұзықсың!
Dialogue: 0,0:06:28.98,0:06:30.99,Default,,0,0,0,,Ал егер Шин Чан бақытты болып көрінсе➨
Dialogue: 0,0:06:30.99,0:06:32.99,Default,,0,0,0,,Ол саған бар күшімен секіретін бала.
Dialogue: 0,0:06:32.99,0:06:35.32,Default,,0,0,0,,Иә? null?
Dialogue: 0,0:06:35.32,0:06:38.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:38.03,0:06:40.16,Default,,0,0,0,,О~ Тор мырза, бұл керемет!
Dialogue: 0,0:06:40.16,0:06:42.83,Default,,0,0,0,,Керемет! (Сукаю) Хехе, әдемі екен.
Dialogue: 0,0:06:42.83,0:06:46.87,Default,,0,0,0,,Жоқ, бұл жай ғана жыланбалықты қалай ұстау керектігі туралы қосымша.
Dialogue: 0,0:06:46.87,0:06:48.87,Default,,0,0,0,,Жыланбалық...?
Dialogue: 0,0:06:48.87,0:06:52.01,Default,,0,0,0,,А, бұл сөзсіз былғары, бірақ... Нұрруффун!
Dialogue: 0,0:06:52.01,0:06:54.38,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:54.38,0:06:57.71,Default,,0,0,0,,Мен шомылу мәдениетімен байланыста болғанымда, біртүрлі болып кеттім...
Dialogue: 0,0:06:57.71,0:07:00.65,Default,,0,0,0,,Ол сөйледі! ? Итачи! Құмырсқа! ?
Dialogue: 0,0:07:00.65,0:07:03.32,Default,,0,0,0,,Перет! Жоқ, мен➨
Dialogue: 0,0:07:03.32,0:07:06.66,Default,,0,0,0,,Нурутто на... Мынадай нәрсе.
Dialogue: 0,0:07:06.66,0:07:10.33,Default,,0,0,0,,Бұл үлпілдек мысық! Бұл Моконеко! (Асо) Бұл манул мысық!
Dialogue: 0,0:07:10.33,0:07:13.16,Default,,0,0,0,,көремін. Мысықтың шырышты болуы табиғи нәрсе.
Dialogue: 0,0:07:13.16,0:07:16.00,Default,,0,0,0,,Өйткені мысықтар сұйық. (3 адам) Әрине!
Dialogue: 0,0:07:16.00,0:07:20.17,Default,,0,0,0,,Қазір... Негізі мен алыс, шалғай дүниеденмін➨
Dialogue: 0,0:07:20.17,0:07:22.80,Default,,0,0,0,,Мен маңызды тапсырмамен миссияда болдым.
Dialogue: 0,0:07:22.80,0:07:25.81,Default,,0,0,0,,Бұл мысық болу қиын болса керек.
Dialogue: 0,0:07:25.81,0:07:28.81,Default,,0,0,0,,Неге екенін білмеймін, бірақ бұл азап.
Dialogue: 0,0:07:28.81,0:07:30.81,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:30.81,0:07:34.48,Default,,0,0,0,,Тағдырдың арқасында мен барлығын осылай кездестірдім.
Dialogue: 0,0:07:34.48,0:07:37.69,Default,,0,0,0,,Мына мысықтың әңгімесін тыңда...
Dialogue: 0,0:07:37.69,0:07:39.99,Default,,0,0,0,,Сәлем У Чан! ? Жоқ...
Dialogue: 0,0:07:39.99,0:07:42.32,Default,,0,0,0,,Енді айырмашылығы неде?
Dialogue: 0,0:07:42.32,0:07:44.83,Default,,0,0,0,,Сен мысық емессің... сен жыланбалығысың!
Dialogue: 0,0:07:44.83,0:07:46.83,Default,,0,0,0,,Басқаша айтқанда, бұл дәмді!
Dialogue: 0,0:07:46.83,0:07:51.50,Default,,0,0,0,,Жоқ! Менің аштығым шегінен асып кетті және мен Жабайы Вуға айналдым!
Dialogue: 0,0:07:51.50,0:07:53.54,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:07:53.54,0:07:56.04,Default,,0,0,0,,Бұл билейтін жыланбалық! Тоқта, Ушио!
Dialogue: 0,0:07:56.04,0:08:00.11,Default,,0,0,0,,Жыланбалықтың қаны улы, оны жеу үшін оны дұрыс пісіру керек!
Dialogue: 0,0:08:00.11,0:08:02.11,Default,,0,0,0,,Жоқ, мәселе бұл емес.
Dialogue: 0,0:08:02.11,0:08:06.11,Default,,0,0,0,,Нурулуру Мен осы жерден басынан бастаймын.
Dialogue: 0,0:08:06.11,0:08:10.12,Default,,0,0,0,,Нурунттона. Нуру...
Dialogue: 0,0:08:10.12,0:08:14.29,Default,,0,0,0,,Ах…. Өйткені, мысықтар сұйық.
Dialogue: 0,0:08:14.29,0:08:16.96,Default,,0,0,0,,Бұл дегеніміз... биік жаға!
Dialogue: 0,0:08:16.96,0:08:18.96,Default,,0,0,0,,Менің ойымша, бұл басқаша ...
Dialogue: 0,0:08:18.96,0:08:21.63,Default,,0,0,0,,Жақында көтеріле ме? Мен кешігіп қаламын.
Dialogue: 0,0:08:21.63,0:08:25.03,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:08:34.48,0:08:38.65,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:08:38.65,0:08:40.65,Default,,0,0,0,,Қауіпсіз!
Dialogue: 0,0:08:40.65,0:08:42.65,Default,,0,0,0,,Киіну уақыты келді!
Dialogue: 0,0:08:42.65,0:08:45.65,Default,,0,0,0,,Мынау, мынау қарапайым халық.
Dialogue: 0,0:08:45.65,0:08:49.99,Default,,0,0,0,,Бұл адамдар Эдо дәуірінің домендік мектептерінен шыққан➨
Dialogue: 0,0:08:49.99,0:08:53.50,Default,,0,0,0,,Кионан орта мектебіндегі дәстүрлі студенттер кеңесі!
Dialogue: 0,0:08:53.50,0:08:56.16,Default,,0,0,0,,үшін ақсүйектердің беделді әулетінен шыққан сияқты.
Dialogue: 0,0:08:56.16,0:09:00.14,Default,,0,0,0,,Некома Барон отбасының хатшысы Некомаю➨
Dialogue: 0,0:09:00.14,0:09:04.97,Default,,0,0,0,,Нюто Эрл отбасы төрағасының орынбасары Нюто Самон➨
Dialogue: 0,0:09:04.97,0:09:08.64,Default,,0,0,0,,Және Думеки Дюк отбасының үлкен ұлы және студенттік кеңестің президенті➨
Dialogue: 0,0:09:08.64,0:09:10.98,Default,,0,0,0,,Думеки Джуто Рейто!
Dialogue: 0,0:09:10.98,0:09:13.48,Default,,0,0,0,,《үшін: Қандай тамаша отбасы! 》
Dialogue: 0,0:09:13.48,0:09:17.32,Default,,0,0,0,,Иә... Мен бұл жерден бір тас лақтым жерде тұрсам да➨
Dialogue: 0,0:09:17.32,0:09:19.65,Default,,0,0,0,,Тонда Тоносама мектепке барады.
Dialogue: 0,0:09:19.65,0:09:22.32,Default,,0,0,0,,Ю, сен не айтып тұрсың?
Dialogue: 0,0:09:22.32,0:09:24.33,Default,,0,0,0,,Бұл жігіттердің лорд болуы мүмкін емес.
Dialogue: 0,0:09:24.33,0:09:28.00,Default,,0,0,0,,Бұл жай ғана мысқыл! Мына вице-президенттен құтылыңыз!
Dialogue: 0,0:09:28.00,0:09:31.00,Default,,0,0,0,,Қайырлы таң, Сью! Мон-санда мысық жын да бар.
Dialogue: 0,0:09:31.00,0:09:34.00,Default,,0,0,0,,Мен де бүгін биік жаға киюді шештім!
Dialogue: 0,0:09:34.00,0:09:36.50,Default,,0,0,0,,Шинкуро Унзен….
Dialogue: 0,0:09:36.50,0:09:40.01,Default,,0,0,0,,Мені сыйлама! Және қайырлы таң!
Dialogue: 0,0:09:40.01,0:09:42.51,Default,,0,0,0,,Әй... Төраға Думекидің құрметті есімі➨
Dialogue: 0,0:09:42.51,0:09:44.51,Default,,0,0,0,,Біреуді қарапайым адам сияқты кездейсоқ шақыру - ➨
Dialogue: 0,0:09:44.51,0:09:46.51,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:09:46.51,0:09:49.02,Default,,0,0,0,,Бірақ мен қарапайым адаммын, жағасы биік...
Dialogue: 0,0:09:49.02,0:09:51.52,Default,,0,0,0,,Қарапайым адам болсаңыз да, ұстануға тиісті ережелер бар.
Dialogue: 0,0:09:51.52,0:09:53.52,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:09:53.52,0:09:56.02,Default,,0,0,0,,Алдымен, қылышпен тыйым салу туралы жарлықты ұстанайық.
Dialogue: 0,0:09:56.02,0:09:58.53,Default,,0,0,0,,Шинкуро Унзен және тағы 5 адам. (үшін) иә?
Dialogue: 0,0:09:58.53,0:10:01.03,Default,,0,0,0,,Мектепте бір бөлмені қорғаным етіп ұстап жүргенімде➨
Dialogue: 0,0:10:01.03,0:10:03.53,Default,,0,0,0,,Әрекет туралы мәліметтерге өтінім әлі жіберілмеді.
Dialogue: 0,0:10:03.53,0:10:05.50,Default,,0,0,0,,Аа, қазір ойлап қарасам...
Dialogue: 0,0:10:05.50,0:10:10.00,Default,,0,0,0,,Асығыңыз. Тәртіпсіз бостандықты ешқашан қабылдамаймын.
Dialogue: 0,0:10:12.51,0:10:14.51,Default,,0,0,0,,Ол әлі салмақты жігіт.
Dialogue: 0,0:10:14.51,0:10:17.35,Default,,0,0,0,,Бірақ ол жағы да әдемі. (Іштің ырғағы)
Dialogue: 0,0:10:17.35,0:10:22.18,Default,,0,0,0,,Қарғыс атсын, жоқ... Менің қарным ашқандықтан, шегім жетті...
Dialogue: 0,0:10:22.18,0:10:24.22,Default,,0,0,0,,Құдай-ай!
Dialogue: 0,0:10:24.22,0:10:26.22,Default,,0,0,0,,А... сонда тоқтаңыз...
Dialogue: 0,0:10:26.22,0:10:28.72,Default,,0,0,0,,Сью мырза….
Dialogue: 0,0:10:28.72,0:10:34.73,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:10:34.73,0:10:37.20,Default,,0,0,0,,Фува~ Мен оны жедім!
Dialogue: 0,0:10:37.20,0:10:40.87,Default,,0,0,0,,Тор жасаған бенто шынымен стильді және дәмді!
Dialogue: 0,0:10:40.87,0:10:43.20,Default,,0,0,0,,Шынайы әсерлер Көңіл көтеру.
Dialogue: 0,0:10:43.20,0:10:45.21,Default,,0,0,0,,Ас үшін рахмет.
Dialogue: 0,0:10:45.21,0:10:48.04,Default,,0,0,0,,Нурунт. (үшін) Ха! ?
Dialogue: 0,0:10:48.04,0:10:51.38,Default,,0,0,0,,Ха! үшін, бүгін таңертең болды.
Dialogue: 0,0:10:51.38,0:10:53.88,Default,,0,0,0,,Нөл мырза! Аты бар!
Dialogue: 0,0:10:53.88,0:10:56.05,Default,,0,0,0,,Сонымен қатар, ешқандай ерекше бұралу жоқ! (Іштің ырғағы)
Dialogue: 0,0:10:56.05,0:10:59.55,Default,,0,0,0,,Бүгін таң... жыланбалық... Жоқ, сондықтан басқаша.
Dialogue: 0,0:10:59.55,0:11:02.16,Default,,0,0,0,,Жыланбалық та, сұйық та емес.
Dialogue: 0,0:11:02.16,0:11:06.16,Default,,0,0,0,,үшін өте дамыған мысықтар туралы ғылымға негізделген.
Dialogue: 0,0:11:06.16,0:11:08.16,Default,,0,0,0,,(ырылдаған дыбыс)
Dialogue: 0,0:11:08.16,0:11:11.17,Default,,0,0,0,,Мысықтар туралы ғылым... Бұл жаңа және керемет естіледі!
Dialogue: 0,0:11:11.17,0:11:13.50,Default,,0,0,0,,Бұл жай ғана мысық емес! ?
Dialogue: 0,0:11:13.50,0:11:16.67,Default,,0,0,0,,Сөйлейтін мысық жай ғана мысық бола алмайды.
Dialogue: 0,0:11:16.67,0:11:20.68,Default,,0,0,0,,Мен бұл жерге дағдарыс жақындап келе жатқанына сенімдімін➨
Dialogue: 0,0:11:20.68,0:11:22.68,Default,,0,0,0,,Мен саған айтуға тым жалқау болдым.
Dialogue: 0,0:11:22.68,0:11:25.01,Default,,0,0,0,,Жер... дағдарысы? иә.
Dialogue: 0,0:11:25.01,0:11:30.35,Default,,0,0,0,,Бұл жер зұлым жындардың қолынан жойылды.
Dialogue: 0,0:11:30.35,0:11:33.02,Default,,0,0,0,,Бұл не?! ?
Dialogue: 0,0:11:33.02,0:11:35.52,Default,,0,0,0,,Мысықтың адалдығы...
Dialogue: 0,0:11:35.52,0:11:39.03,Default,,0,0,0,,Сүйікті адамзаттың дағдарысын бақылап, үнсіз қала алмаймыз.
Dialogue: 0,0:11:39.03,0:11:41.53,Default,,0,0,0,,Қазір «шимо» сияқты нәрсе ме?
Dialogue: 0,0:11:41.53,0:11:45.37,Default,,0,0,0,,Мен бұл жерді қорғағым келеді! Мен адамзатты қорғағым келеді!
Dialogue: 0,0:11:45.37,0:11:49.04,Default,,0,0,0,,Иә, мысықтану ғылымы осы үшін!
Dialogue: 0,0:11:49.04,0:11:51.37,Default,,0,0,0,,Түсіндім! Басқаша айтқанда, Нуру-сан➨
Dialogue: 0,0:11:51.37,0:11:54.54,Default,,0,0,0,,Бізге мына жерді қорғайық дегің келеді!
Dialogue: 0,0:11:54.54,0:11:58.55,Default,,0,0,0,,Мысық ғылымымен стильді көрініңіз!
Dialogue: 0,0:11:58.55,0:12:00.82,Default,,0,0,0,,Жоқ, мен жай ғана➨
Dialogue: 0,0:12:00.82,0:12:02.98,Default,,0,0,0,,Мен барлығына дағдарыс туралы хабарлауға келдім, сондықтан мен мүлде ақымақпын.
Dialogue: 0,0:12:02.98,0:12:04.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:06.99,0:12:09.66,Default,,0,0,0,,Әлі емес пе? Түскі үзіліс аяқталуға жақын.
Dialogue: 0,0:12:09.66,0:12:11.66,Default,,0,0,0,,Мен сенің артыңда қалдым.
Dialogue: 0,0:12:11.66,0:12:13.10,Default,,0,0,0,,《Менің атым Тошики Фува.
Dialogue: 0,0:12:13.10,0:12:17.83,Default,,0,0,0,,Осы дәуірде өзін депрессияға ұшыратқан Ямато орта мектебінің оқушысы.
Dialogue: 0,0:12:17.83,0:12:22.50,Default,,0,0,0,,Мен қазір өмірімнің қиылысында тұрмын!
Dialogue: 0,0:12:22.50,0:12:25.01,Default,,0,0,0,,Бұл шынымен «онигири» ме, әлде «күріш шары» ма?➨
Dialogue: 0,0:12:25.01,0:12:27.51,Default,,0,0,0,,Бұл «сэндвич» бе, әлде «сэндвич» ма➨
Dialogue: 0,0:12:27.51,0:12:31.51,Default,,0,0,0,,Неге... Баға белгісіне тауар атын неге дұрыс жазбайсыз? ? 》
Dialogue: 0,0:12:31.51,0:12:34.35,Default,,0,0,0,,Сэндвич беріңізші. иә.
Dialogue: 0,0:12:34.35,0:12:36.52,Default,,0,0,0,,《Фува: Уау, “сэндвич” – “сэндвич”➨
Dialogue: 0,0:12:36.52,0:12:38.52,Default,,0,0,0,,Сіз өте сыпайы көрінесіз!
Dialogue: 0,0:12:38.52,0:12:41.52,Default,,0,0,0,,Бұл жігіт мафи...》
Dialogue: 0,0:12:41.52,0:12:45.53,Default,,0,0,0,,Өкінішті болмаңыз! Олай болса, өнімнің атын дұрыстап жазыңыз!
Dialogue: 0,0:12:45.53,0:12:49.03,Default,,0,0,0,,Біріншіден, бұл сэндвич! Сіздің пішініңіз «Сібір» ме?
Dialogue: 0,0:12:49.03,0:12:51.20,Default,,0,0,0,,Жоқ, «Сібірге» ұқсайды!
Dialogue: 0,0:12:51.20,0:12:54.20,Default,,0,0,0,,Бұл да түсініксіз, бейбақ!
Dialogue: 0,0:12:54.20,0:12:56.70,Default,,0,0,0,,Дұрыс шешім қабылдаңыз! Оны жария етейік!
Dialogue: 0,0:12:56.70,0:12:58.71,Default,,0,0,0,,Оны жұмсақ қалдырмаңыз!
Dialogue: 0,0:12:58.71,0:13:03.18,Default,,0,0,0,,Жаныңның зарын алдым. иә?
Dialogue: 0,0:13:03.18,0:13:05.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:05.18,0:13:08.35,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:13:08.35,0:13:10.35,Default,,0,0,0,,Сіз нені айтасыз, Нул мырза? ?
Dialogue: 0,0:13:10.35,0:13:12.52,Default,,0,0,0,,Жер Сізге оны қорғаудың қажеті жоқ! ?
Dialogue: 0,0:13:12.52,0:13:15.02,Default,,0,0,0,,Слайм... дұрысырақ...
Dialogue: 0,0:13:15.02,0:13:17.53,Default,,0,0,0,,Хмм, әрине солай...
Dialogue: 0,0:13:17.53,0:13:21.53,Default,,0,0,0,,Сен жерді қорғайсың! Менің ойымша, бұл солай болады.
Dialogue: 0,0:13:21.53,0:13:23.87,Default,,0,0,0,,Біз еркіндікті жақсы көреміз, манулмыз.
Dialogue: 0,0:13:23.87,0:13:26.53,Default,,0,0,0,,Біз де барлығының еркін болғанын қалаймыз.
Dialogue: 0,0:13:26.53,0:13:29.70,Default,,0,0,0,,Сіз жерді қорғай аласыз, немесе қажет емес.
Dialogue: 0,0:13:29.70,0:13:31.71,Default,,0,0,0,,Бостандық деген осы.
Dialogue: 0,0:13:31.71,0:13:35.54,Default,,0,0,0,,Сондықтан мен әркім өзі шешкенін қалаймын.
Dialogue: 0,0:13:35.54,0:13:37.71,Default,,0,0,0,,Біз... өзіміз бе?
Dialogue: 0,0:13:37.71,0:13:41.05,Default,,0,0,0,,Иә, ол оны ешқашан мәжбүрлемегенін айтты➨
Dialogue: 0,0:13:41.05,0:13:44.05,Default,,0,0,0,,Бұл міндеттеме маңызды.
Dialogue: 0,0:13:44.05,0:13:46.05,Default,,0,0,0,,Дәл сол кезде бірдеңе болады➨
Dialogue: 0,0:13:46.05,0:13:48.06,Default,,0,0,0,,Сізді сотқа алғыңыз келмегендіктен емес пе?
Dialogue: 0,0:13:48.06,0:13:50.06,Default,,0,0,0,,Үлкендердің өз міндеттерінен қашуы Лас.
Dialogue: 0,0:13:50.06,0:13:52.56,Default,,0,0,0,,Нуру? (қоңырау дыбысы)
Dialogue: 0,0:13:52.56,0:13:56.56,Default,,0,0,0,,Жерді жаулап алуды мақсат еткен құбыжық жаңа ғана дүниеге келді.
Dialogue: 0,0:13:56.56,0:13:59.23,Default,,0,0,0,,Басқаша айтқанда, Жер дағдарыста! ?
Dialogue: 0,0:13:59.23,0:14:01.30,Default,,0,0,0,,Маңызды болмаса, мен оны қорғаймын!
Dialogue: 0,0:14:01.30,0:14:03.81,Default,,0,0,0,,Бұл стильдірек!
Dialogue: 0,0:14:03.81,0:14:05.81,Default,,0,0,0,,Иә? Мен оны көрдім.
Dialogue: 0,0:14:05.81,0:14:08.98,Default,,0,0,0,,Еркін жүрекпен күресуге шешім қабылдаған қайраткер.
Dialogue: 0,0:14:08.98,0:14:11.31,Default,,0,0,0,,Сіз күресуді қалай шештіңіз.
Dialogue: 0,0:14:11.31,0:14:14.32,Default,,0,0,0,,Әй, сен неге екі рет айттың? Жауапкершіліктен қашып жүрмін ғой...
Dialogue: 0,0:14:14.32,0:14:18.12,Default,,0,0,0,,Баршаңызға, маған күресуге күш беріңіз.
Dialogue: 0,0:14:22.16,0:14:25.66,Default,,0,0,0,,Бұл жігіт... Жоқ, тіпті біз де! ?
Dialogue: 0,0:14:25.66,0:14:28.00,Default,,0,0,0,,Бұл мүлдем өшпейді, бірақ бұл! ?
Dialogue: 0,0:14:28.00,0:14:31.83,Default,,0,0,0,,Кір жуу немесе күрішті сүрту қиын. (Ошаманбе) Е, күріш! ?
Dialogue: 0,0:14:31.83,0:14:35.34,Default,,0,0,0,,Бұл мысықтану ғылымының үздіктерін біріктіретін элемент. Атауы...
Dialogue: 0,0:14:35.34,0:14:38.34,Default,,0,0,0,,Бұл жоғары түсті білезік!
Dialogue: 0,0:14:38.34,0:14:40.34,Default,,0,0,0,,Дұрыс, нөл... Жарайды.
Dialogue: 0,0:14:40.34,0:14:44.68,Default,,0,0,0,,Жарайды, жоғары жағалы жүрейік!
Dialogue: 0,0:14:44.68,0:14:46.68,Default,,0,0,0,,Сәлем Шин Чан! ?
Dialogue: 0,0:14:46.68,0:14:49.18,Default,,0,0,0,,Күрсіну~ Мен бұған көмектесе алмаймын, аға.
Dialogue: 0,0:14:49.18,0:14:51.19,Default,,0,0,0,,Шлам….
Dialogue: 0,0:14:51.19,0:14:53.19,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:14:53.19,0:14:56.86,Default,,0,0,0,,Ааа? Бұл Хамасаки! ? Иә!
Dialogue: 0,0:14:56.86,0:15:00.46,Default,,0,0,0,,Бұл Йокогамадағы "Хамаса" және Омаезакидің "Сакиіндегі" Хамасаки!
Dialogue: 0,0:15:00.46,0:15:03.66,Default,,0,0,0,,Бұл Жерді жаулап алуды мақсат еткен құбыжық па?
Dialogue: 0,0:15:03.66,0:15:06.33,Default,,0,0,0,,«Зәки» «Сәкиге» айналатыны түсініксіз!
Dialogue: 0,0:15:06.33,0:15:09.50,Default,,0,0,0,,Сіз Хамазакисіз! Эх! ?
Dialogue: 0,0:15:09.50,0:15:12.34,Default,,0,0,0,,Уау~ мен байланып қалдым!
Dialogue: 0,0:15:12.34,0:15:15.81,Default,,0,0,0,,Құбыжық па, әлде сібірлік пе? Тәттілерден?
Dialogue: 0,0:15:15.81,0:15:17.81,Default,,0,0,0,,Жоқ, мен сенімдімін Сібір➨
Dialogue: 0,0:15:17.81,0:15:20.65,Default,,0,0,0,,Ах~ Менің ойымша, екеуі де жақсы.
Dialogue: 0,0:15:20.65,0:15:23.32,Default,,0,0,0,,Екеуі де жақсы! ?
Dialogue: 0,0:15:23.32,0:15:26.02,Default,,0,0,0,,үшін сондай үлпілдек➨
Dialogue: 0,0:15:26.02,0:15:29.19,Default,,0,0,0,,Адамдар әрқашан өмірдің қиылысында адасып қалады!
Dialogue: 0,0:15:29.19,0:15:31.16,Default,,0,0,0,,Иә? Бұл соншалықты үлкен мәміле ме?
Dialogue: 0,0:15:31.16,0:15:34.50,Default,,0,0,0,,Сондықтан біз әлемді барлық түсініксіз нәрселерді біріктіретін боламыз!
Dialogue: 0,0:15:34.50,0:15:36.83,Default,,0,0,0,,Егер сіз мұны жасасаңыз, сізде күріш шарлары мен күріш шарлары болады➨
Dialogue: 0,0:15:36.83,0:15:40.00,Default,,0,0,0,,Сэндвичтер немесе оларды қалай атауға болатыны туралы енді шатасу болмайды➨
Dialogue: 0,0:15:40.00,0:15:43.17,Default,,0,0,0,,Сатып алуды күту уақыты қысқарады!
Dialogue: 0,0:15:43.17,0:15:45.17,Default,,0,0,0,,Оны «күріш шары» деп те атайды?
Dialogue: 0,0:15:45.17,0:15:48.01,Default,,0,0,0,,Жаңа опцияларды ұсынуды тоқтату керек пе?
Dialogue: 0,0:15:48.01,0:15:51.68,Default,,0,0,0,,Сатып алуды күту уақыты қысқа болғаны жақсы нәрсе.
Dialogue: 0,0:15:51.68,0:15:55.68,Default,,0,0,0,,Бірақ сол себепті әлемді жаулап алу жоғары дәрежелі нәрсе емес!
Dialogue: 0,0:15:55.68,0:15:58.05,Default,,0,0,0,,Мен бұл сөздерді естігім келді!
Dialogue: 0,0:15:58.05,0:16:00.15,Default,,0,0,0,,Енді өзіңізді манулға айналдырыңыз!
Dialogue: 0,0:16:00.15,0:16:02.99,Default,,0,0,0,,Романтикалық революция гүлдейді!
Dialogue: 0,0:16:02.99,0:16:20.34,Default,,0,0,0,,♬～
Dialogue: 0,0:16:20.34,0:16:23.01,Default,,0,0,0,,Тұрсаң, пион болады. Сіз отырсаңыз, сізде пион болады.
Dialogue: 0,0:16:23.01,0:16:27.85,Default,,0,0,0,,Қызыл жүзді биік жағалы бала Бриллиант Қызыл!
Dialogue: 0,0:16:27.85,0:16:30.52,Default,,0,0,0,,Романтикалық революция гүлдейді!
Dialogue: 0,0:16:30.52,0:16:36.02,Default,,0,0,0,,♬～
Dialogue: 0,0:16:36.02,0:16:39.36,Default,,0,0,0,,Биік жағалы, қасы әдемі, суы тамшылаған бала➨
Dialogue: 0,0:16:39.36,0:16:42.36,Default,,0,0,0,,Меланхолик флот!
Dialogue: 0,0:16:42.36,0:16:45.03,Default,,0,0,0,,Романтикалық революция гүлдейді!
Dialogue: 0,0:16:45.03,0:16:50.71,Default,,0,0,0,,♬～
Dialogue: 0,0:16:50.71,0:16:54.04,Default,,0,0,0,,Yamashisuimei Талғампаз және әдемі биік жағалы бала➨
Dialogue: 0,0:16:54.04,0:16:56.71,Default,,0,0,0,,Ностальгиялық жасыл!
Dialogue: 0,0:16:56.71,0:17:00.11,Default,,0,0,0,,Романтикалық революция гүлдейді!
Dialogue: 0,0:17:00.11,0:17:04.45,Default,,0,0,0,,♬～
Dialogue: 0,0:17:04.45,0:17:07.79,Default,,0,0,0,,Харуки Уки Табиғи материалдан жасалған биік жағалы бала➨
Dialogue: 0,0:17:07.79,0:17:10.63,Default,,0,0,0,,Қазіргі сары!
Dialogue: 0,0:17:10.63,0:17:12.96,Default,,0,0,0,,Романтикалық революция гүлдейді!
Dialogue: 0,0:17:12.96,0:17:18.80,Default,,0,0,0,,♬～
Dialogue: 0,0:17:18.80,0:17:22.30,Default,,0,0,0,,Шіденнің жарқылы, биік жағалы баланың жарқылы➨
Dialogue: 0,0:17:22.30,0:17:25.14,Default,,0,0,0,,Эмоциялық күлгін!
Dialogue: 0,0:17:25.14,0:17:27.98,Default,,0,0,0,,Гүлдердің романтикалық иісімен толтырылған!
Dialogue: 0,0:17:27.98,0:17:30.65,Default,,0,0,0,,Адамдардың жүрегіндегі жанашырлықты ұғын!
Dialogue: 0,0:17:30.65,0:17:33.48,Default,,0,0,0,,Жаңа дүниенің құйынында!
Dialogue: 0,0:17:33.48,0:17:36.32,Default,,0,0,0,,Ескі логиканы бұзыңыз!
Dialogue: 0,0:17:36.32,0:17:38.99,Default,,0,0,0,,Жұлдыздармен жарқыра, заманның баласы!
Dialogue: 0,0:17:38.99,0:17:41.99,Default,,0,0,0,,Есімі Хикара Романдан!
Dialogue: 0,0:17:41.99,0:17:45.49,Default,,0,0,0,,Мен болашақты өзгертемін!
Dialogue: 0,0:17:45.49,0:17:47.66,Default,,0,0,0,,Өте жоғары жағалы!
Dialogue: 0,0:17:47.66,0:17:50.16,Default,,0,0,0,,Сұлу болмысым одан да әдемі!
Dialogue: 0,0:17:50.16,0:17:52.50,Default,,0,0,0,,Бұны қолмен жууға болады ма?
Dialogue: 0,0:17:52.50,0:17:56.67,Default,,0,0,0,,Бұл ебедейсіз костюм, бірақ мен оны кигенде, ол әлдеқайда жақсы.
Dialogue: 0,0:17:56.67,0:17:59.07,Default,,0,0,0,,Эй Ук-кун! иә?
Dialogue: 0,0:18:00.94,0:18:05.11,Default,,0,0,0,,Кешіріңіз... Мен... Мен бұл адамды қорғағым келеді!
Dialogue: 0,0:18:05.11,0:18:08.12,Default,,0,0,0,,Не? Маған сені қорғағым келетінін айтып жатқандай сезінемін➨
Dialogue: 0,0:18:08.12,0:18:10.15,Default,,0,0,0,,Бұл келе жатқан дағдарыс сезімі?
Dialogue: 0,0:18:10.15,0:18:12.49,Default,,0,0,0,,Әділдік батыр кенеттен опасыздық жасады! ?
Dialogue: 0,0:18:12.49,0:18:15.66,Default,,0,0,0,,Ойлап қарасам, Сібірде рак ауруын көптен бері көріп жүрмін.
Dialogue: 0,0:18:15.66,0:18:17.99,Default,,0,0,0,,Егер сенің еркің болса, мен оны қабылдаймын.
Dialogue: 0,0:18:17.99,0:18:19.99,Default,,0,0,0,,А, бұл биік жаға!
Dialogue: 0,0:18:19.99,0:18:22.50,Default,,0,0,0,,Nurulurul Бұл да тегін.
Dialogue: 0,0:18:22.50,0:18:25.30,Default,,0,0,0,,Неліктен оны соншалықты бей-жай қабылдайсың? ? қорқады!
Dialogue: 0,0:18:25.30,0:18:28.84,Default,,0,0,0,,Ей, же!
Dialogue: 0,0:18:28.84,0:18:32.34,Default,,0,0,0,,Енді мысық туралы ғылымның күшін толық пайдаланыңыз!
Dialogue: 0,0:18:32.34,0:18:35.51,Default,,0,0,0,,Биік жағалы таяқ!
Dialogue: 0,0:18:35.51,0:18:38.51,Default,,0,0,0,,Уау! Ах! ?
Dialogue: 0,0:18:38.51,0:18:41.68,Default,,0,0,0,,Ах! Хамф!
Dialogue: 0,0:18:41.68,0:18:44.02,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:44.02,0:18:47.32,Default,,0,0,0,,Могумогу…. Оны жеме!
Dialogue: 0,0:18:47.32,0:18:51.36,Default,,0,0,0,,Қазір! Әдемі меланхолик Blaster!
Dialogue: 0,0:18:51.36,0:18:53.69,Default,,0,0,0,,Қазіргі электр сәулесі!
Dialogue: 0,0:18:53.69,0:18:57.03,Default,,0,0,0,,О, мысық ғылым, биік жаға, ғажап!
Dialogue: 0,0:18:57.03,0:18:59.03,Default,,0,0,0,,Екінші адам да мысықтанушы.
Dialogue: 0,0:18:59.03,0:19:04.77,Default,,0,0,0,,Сонда мен де эмоционалды ағынмын! Сізге мұны істеуге рұқсат етемін бе?
Dialogue: 0,0:19:04.77,0:19:06.94,Default,,0,0,0,,Керемет от!
Dialogue: 0,0:19:06.94,0:19:09.28,Default,,0,0,0,,Ностальгиялық бомбалаушы!
Dialogue: 0,0:19:09.28,0:19:14.28,Default,,0,0,0,,Гунунуну….
Dialogue: 0,0:19:14.28,0:19:16.28,Default,,0,0,0,,Уау! қауіпті!
Dialogue: 0,0:19:16.28,0:19:19.59,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:19:21.62,0:19:24.46,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:19:24.46,0:19:27.29,Default,,0,0,0,,Жоқ, мүмкіндігім болса қуана отырар едім, бірақ олар Стэнд қолданушылары емес.
Dialogue: 0,0:19:27.29,0:19:30.97,Default,,0,0,0,,Хе... Қызық Сібір.
Dialogue: 0,0:19:30.97,0:19:32.97,Default,,0,0,0,,Тунку….
Dialogue: 0,0:19:32.97,0:19:35.97,Default,,0,0,0,,Эй... Менікі бол. иә? Жоқ, менмін➨
Dialogue: 0,0:19:35.97,0:19:37.97,Default,,0,0,0,,Ол жай Сібірге айналады...
Dialogue: 0,0:19:37.97,0:19:39.97,Default,,0,0,0,,Бұл сурет➨
Dialogue: 0,0:19:39.97,0:19:42.14,Default,,0,0,0,,Көңілді... Әдемі?
Dialogue: 0,0:19:42.14,0:19:44.15,Default,,0,0,0,,Өзіңізді қатты итермеңіз.
Dialogue: 0,0:19:44.15,0:19:46.98,Default,,0,0,0,,Сіз болашақты болжайтындай сезінесіз бе?
Dialogue: 0,0:19:46.98,0:19:50.48,Default,,0,0,0,,Басқаша айтқанда, биік жаға! ? Иә, солай.
Dialogue: 0,0:19:50.48,0:19:53.49,Default,,0,0,0,,Оның орнына не істеуіміз керек? Егер мен оны осылай жалғыз қалдырсам ...
Dialogue: 0,0:19:53.49,0:19:55.82,Default,,0,0,0,,Жоқ, қантқа толып жатыр...
Dialogue: 0,0:19:55.82,0:19:58.16,Default,,0,0,0,,Бұл әлдеқайда қызықты болады, солай емес пе?
Dialogue: 0,0:19:58.16,0:20:00.10,Default,,0,0,0,,Бұл әдемі, бірақ тым ынталандырады.
Dialogue: 0,0:20:00.10,0:20:03.00,Default,,0,0,0,,Мұнда бір нәрсе бар...
Dialogue: 0,0:20:03.00,0:20:05.83,Default,,0,0,0,,Сәлем! Бүгін кешке сиыр еті бар!
Dialogue: 0,0:20:05.83,0:20:08.50,Default,,0,0,0,,Тым көп тамақтансаңыз, бұл ысырап!
Dialogue: 0,0:20:08.50,0:20:10.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:12.84,0:20:15.34,Default,,0,0,0,,Сиырлар... жер үшін➨
Dialogue: 0,0:20:15.34,0:20:17.85,Default,,0,0,0,,Біз күресеміз!
Dialogue: 0,0:20:17.85,0:20:21.18,Default,,0,0,0,,Өйткені, біз жеңуіміз керек!
Dialogue: 0,0:20:21.18,0:20:24.69,Default,,0,0,0,,Енді мысықтар туралы ғылымның мәнін көрсететін кез келді.
Dialogue: 0,0:20:24.69,0:20:28.02,Default,,0,0,0,,Бос жүректеріңізді біріктіріп, босатыңыз!
Dialogue: 0,0:20:28.02,0:20:31.19,Default,,0,0,0,,Түсіндім! үшінмыз кеттік! (үшін) Иә!
Dialogue: 0,0:20:31.19,0:20:33.59,Default,,0,0,0,,Тазартылған букет!
Dialogue: 0,0:20:38.53,0:20:42.70,Default,,0,0,0,,Мен бостандық нұрымен байлаулы, адасқан жандарды босатамын!
Dialogue: 0,0:20:42.70,0:20:54.72,Default,,0,0,0,,♬～
Dialogue: 0,0:20:54.72,0:21:00.02,Default,,0,0,0,,Өлімге әкелетін Хикара демократиясы!
Dialogue: 0,0:21:00.02,0:21:02.29,Default,,0,0,0,,Уау! !
Dialogue: 0,0:21:06.86,0:21:08.86,Default,,0,0,0,,Уау.
Dialogue: 0,0:21:08.86,0:21:12.03,Default,,0,0,0,,Тазалау аяқталды!
Dialogue: 0,0:21:14.00,0:21:16.34,Default,,0,0,0,,Бұл анық емес немесе түсініксіз болса да➨
Dialogue: 0,0:21:16.34,0:21:18.51,Default,,0,0,0,,Үлпілдек болса, жарайды!
Dialogue: 0,0:21:18.51,0:21:21.71,Default,,0,0,0,,Өйткені биік жағалы болу деген осы!
Dialogue: 0,0:21:21.71,0:21:23.88,Default,,0,0,0,,Бұл еркіндік емес пе?
Dialogue: 0,0:21:26.01,0:21:28.68,Default,,0,0,0,,Ханымдар мен мырзалар, бұл тамаша бірінші қойылым болды.
Dialogue: 0,0:21:28.68,0:21:31.69,Default,,0,0,0,,Менде ештеңе болмаған сияқты.
Dialogue: 0,0:21:31.69,0:21:34.89,Default,,0,0,0,,Жоқ, біз кездейсоқ кездескендей болдық емес пе?
Dialogue: 0,0:21:34.89,0:21:37.22,Default,,0,0,0,,Сонымен қатар, сіз мұны дұрыс шеше аласыз ба?
Dialogue: 0,0:21:37.22,0:21:42.06,Default,,0,0,0,,Бүгінгі гю-набе шынымен сиыр еті ме? Тауық емес пе?
Dialogue: 0,0:21:42.06,0:21:44.23,Default,,0,0,0,,Мектеп бітуге жақын.
Dialogue: 0,0:21:44.23,0:21:46.23,Default,,0,0,0,,Неге басыңды бұрасың?
Dialogue: 0,0:21:46.23,0:21:48.70,Default,,0,0,0,,Хмм, жоғары жаға...
Dialogue: 0,0:21:48.70,0:21:52.07,Default,,0,0,0,,Бостандық... Керемет сөз екен.
Dialogue: 0,0:21:52.07,0:21:56.08,Default,,0,0,0,,Алайда тым көп еркіндік тәртіпсіздікке айналады.
Dialogue: 0,0:21:56.08,0:21:58.05,Default,,0,0,0,,Сіз кімсіз! ?
Dialogue: 0,0:21:58.05,0:22:00.68,Default,,0,0,0,,Біз тәртіп пен тәртіп сақшыларымыз➨
Dialogue: 0,0:22:00.68,0:22:05.05,Default,,0,0,0,,Жерді бағындыру клубы Банкара Шиньэй-тай!
Dialogue: 0,0:22:08.99,0:22:11.49,Default,,0,0,0,,Хикара романтикалық тобы➨
Dialogue: 0,0:22:11.49,0:22:13.99,Default,,0,0,0,,Біз сізді кедергілер деп білеміз!
Dialogue: 0,0:22:13.99,0:22:16.00,Default,,0,0,0,,Болады!
Dialogue: 0,0:22:16.00,0:22:19.00,Default,,0,0,0,,Хехе... бұл жаңа!
Dialogue: 0,0:22:20.50,0:22:26.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
