Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.18,0:00:16.89,Default,,0,0,0,,Оны бір елдің ханшайымы десе де болады...
Dialogue: 0,0:00:16.89,0:00:17.89,Default,,0,0,0,,Оны бір елдің ханшайымы десе де болады...
Dialogue: 0,0:00:16.89,0:00:17.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:17.89,0:00:18.56,Default,,0,0,0,,Оны бір елдің ханшайымы десе де болады...
Dialogue: 0,0:00:18.56,0:00:19.39,Default,,0,0,0,,Оны бір елдің ханшайымы десе де болады...
Dialogue: 0,0:00:18.56,0:00:19.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:19.47,0:00:21.02,Default,,0,0,0,,Әй аға
Dialogue: 0,0:00:21.10,0:00:22.27,Default,,0,0,0,,Хаха
Dialogue: 0,0:00:22.35,0:00:26.60,Default,,0,0,0,,Мен сенен әлі көйлек киіп, рұқсатсыз ұрыс алаңына секіреді деп ойламадым.
Dialogue: 0,0:00:26.69,0:00:29.07,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,0:00:30.57,0:00:33.61,Default,,0,0,0,,Өйткені, «автоойнату» жақсы емес.
Dialogue: 0,0:00:33.70,0:00:36.45,Default,,0,0,0,,Бұл сізді менмен және немқұрайлы етеді.
Dialogue: 0,0:00:36.53,0:00:38.78,Default,,0,0,0,,А... бұл дұрыс емес...
Dialogue: 0,0:00:40.79,0:00:42.45,Default,,0,0,0,,Шайқас басталғаннан кейін
Dialogue: 0,0:00:42.54,0:00:44.96,Default,,0,0,0,,Сізді әрең демаласыз деп естідім.
Dialogue: 0,0:00:45.54,0:00:47.63,Default,,0,0,0,,Неге демалмайсың?
Dialogue: 0,0:00:48.50,0:00:49.54,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:00:49.63,0:00:50.67,Default,,0,0,0,,Я...
Dialogue: 0,0:00:51.17,0:00:52.63,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:00:52.71,0:00:55.38,Default,,0,0,0,,Олай болса, көп уайымдамаңыз.
Dialogue: 0,0:00:55.88,0:00:57.01,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:00:57.09,0:00:59.51,Default,,0,0,0,,Сондай-ақ, ұрыс даласына шыққанда
Dialogue: 0,0:00:59.60,0:01:01.06,Default,,0,0,0,,Дұрыс киіну
Dialogue: 0,0:01:01.14,0:01:02.77,Default,,0,0,0,,Иә, ағай.
Dialogue: 0,0:01:02.85,0:01:04.02,Default,,0,0,0,,Иә
Dialogue: 0,0:01:04.10,0:01:08.02,Default,,0,0,0,,Менің ұлы мәртебеліге есеп беруім керек, ендеше сарайға қайтайық.
Dialogue: 0,0:01:08.10,0:01:09.40,Default,,0,0,0,,Аретия
Dialogue: 0,0:01:09.48,0:01:10.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:10.48,0:01:14.19,Default,,0,0,0,,Олай болса, ағаңның пісіргенін тағы жегім келеді!
Dialogue: 0,0:01:14.99,0:01:19.99,Default,,0,0,0,,♪～
Dialogue: 0,0:02:39.95,0:02:44.95,Default,,0,0,0,,～♪
Dialogue: 0,0:02:49.00,0:02:49.96,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:02:56.75,0:02:58.92,Default,,0,0,0,,Мен саған өткеннің көрінісін берсем де.
Dialogue: 0,0:02:59.01,0:03:00.63,Default,,0,0,0,,Бұл өте жабысқақ.
Dialogue: 0,0:03:01.30,0:03:03.60,Default,,0,0,0,,Сөйлегенің жиіркенішті
Dialogue: 0,0:03:03.68,0:03:07.06,Default,,0,0,0,,Бұл сіздің үніңіз бе? Аретия
Dialogue: 0,0:03:07.14,0:03:08.85,Default,,0,0,0,,Мені бұл атпен атама!
Dialogue: 0,0:03:08.93,0:03:10.31,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,0:03:10.39,0:03:12.44,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:03:17.69,0:03:21.15,Default,,0,0,0,,Мен сен екенімді ұмытпа.
Dialogue: 0,0:03:21.24,0:03:22.57,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:23.53,0:03:27.37,Default,,0,0,0,,Бұл дүниеде сенім жоқ
Dialogue: 0,0:03:27.45,0:03:32.79,Default,,0,0,0,,Дәлел, мен қатты сенген ағамның мені сатып кеткені.
Dialogue: 0,0:03:32.87,0:03:34.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:34.46,0:03:37.34,Default,,0,0,0,,Жекпе-жек, күрес, күресу
Dialogue: 0,0:03:37.42,0:03:39.63,Default,,0,0,0,,Еліме қызмет ете берсем де
Dialogue: 0,0:03:44.97,0:03:46.30,Default,,0,0,0,,Олай болса, Мәртебелі.
Dialogue: 0,0:03:47.35,0:03:50.89,Default,,0,0,0,,Мен өңдеуді сізге тапсырғаныма қуаныштымын.
Dialogue: 0,0:03:50.98,0:03:52.73,Default,,0,0,0,,Иә солай
Dialogue: 0,0:03:52.81,0:03:55.94,Default,,0,0,0,,Түсіндім, онда мен мұны істеймін.
Dialogue: 0,0:03:56.02,0:03:56.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:56.98,0:03:58.82,Default,,0,0,0,,Аға аға
Dialogue: 0,0:03:58.90,0:04:00.44,Default,,0,0,0,,Не?
Dialogue: 0,0:04:00.53,0:04:01.86,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:04:03.57,0:04:05.91,Default,,0,0,0,,Біраз уақыттан кейін бірінші рет бірге кешкі ас ішу
Dialogue: 0,0:04:05.99,0:04:08.49,Default,,0,0,0,,Біз де сіздің пікіріңізді алғымыз келеді.
Dialogue: 0,0:04:08.58,0:04:10.75,Default,,0,0,0,,Бұл сіздің тапсырысыңыз ба?
Dialogue: 0,0:04:10.83,0:04:14.42,Default,,0,0,0,,Не? А, жоқ, олай емес.
Dialogue: 0,0:04:14.50,0:04:17.25,Default,,0,0,0,,Олай болса, кешіріңіз.
Dialogue: 0,0:04:17.34,0:04:19.59,Default,,0,0,0,,Мен сұраудан бас тартқым келеді.
Dialogue: 0,0:04:19.67,0:04:22.76,Default,,0,0,0,,Шешуді қажет ететін мәселе бар.
Dialogue: 0,0:04:22.84,0:04:24.59,Default,,0,0,0,,Солай ма...?
Dialogue: 0,0:04:24.68,0:04:26.39,Default,,0,0,0,,Иә, онда.
Dialogue: 0,0:04:28.93,0:04:30.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:32.48,0:04:34.98,Default,,0,0,0,,Менің тәтті қызым
Dialogue: 0,0:04:35.06,0:04:37.19,Default,,0,0,0,,Бұл шек шығар
Dialogue: 0,0:04:37.81,0:04:40.11,Default,,0,0,0,,Патша ретінде шешім қабылдаңыз
Dialogue: 0,0:04:40.73,0:04:42.69,Default,,0,0,0,,Бұл амбициялы адам.
Dialogue: 0,0:04:42.78,0:04:46.03,Default,,0,0,0,,Менің тағымды ұрлап алдың деп ойлаймын.
Dialogue: 0,0:04:46.11,0:04:48.03,Default,,0,0,0,,Өте қауіпті
Dialogue: 0,0:04:52.87,0:04:53.83,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:04:58.84,0:04:59.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:00.59,0:05:01.67,Default,,0,0,0,,Ағай
Dialogue: 0,0:05:01.75,0:05:02.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:01.75,0:05:02.59,Default,,0,0,0,,(қылыштың қағу дыбысы)
Dialogue: 0,0:05:04.05,0:05:06.59,Default,,0,0,0,,Уф... неге...
Dialogue: 0,0:05:07.72,0:05:11.06,Default,,0,0,0,,Ағай маған жауап бермеді.
Dialogue: 0,0:05:11.14,0:05:12.72,Default,,0,0,0,,Сонымен қатар, дәптерге қол тимейінше Шinigami-ді көре алмайсың – онда қалай…
Dialogue: 0,0:05:16.69,0:05:18.65,Default,,0,0,0,,Өте қиын!
Dialogue: 0,0:05:20.23,0:05:22.07,Default,,0,0,0,,Мен сенсем де
Dialogue: 0,0:05:23.32,0:05:25.95,Default,,0,0,0,,Сатқындық Мен опасыздық жасадым!
Dialogue: 0,0:05:26.03,0:05:26.86,Default,,0,0,0,,Ммм
Dialogue: 0,0:05:29.07,0:05:31.58,Default,,0,0,0,,Саған қатты сенсем де
Dialogue: 0,0:05:31.66,0:05:33.95,Default,,0,0,0,,Бізде сондай берік байланыс болды!
Dialogue: 0,0:05:38.42,0:05:40.79,Default,,0,0,0,,Адамдар адамдарды сатады
Dialogue: 0,0:05:40.88,0:05:42.30,Default,,0,0,0,,Өз ашкөздігі үшін
Dialogue: 0,0:05:43.42,0:05:46.88,Default,,0,0,0,,Тіпті сүйікті адам немесе қымбатты дос
Dialogue: 0,0:05:46.97,0:05:49.22,Default,,0,0,0,,Саған бәрі опасыздық жасайды!
Dialogue: 0,0:05:51.26,0:05:53.56,Default,,0,0,0,,Қара тарих тас-талқан болды!
Dialogue: 0,0:05:53.64,0:05:54.93,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:05:55.85,0:05:57.81,Default,,0,0,0,,Әлі де құлайсың ба?
Dialogue: 0,0:05:57.89,0:06:01.23,Default,,0,0,0,,Мен оның әлсірейтінін білдім.
Dialogue: 0,0:06:01.31,0:06:03.32,Default,,0,0,0,,Әрине!
Dialogue: 0,0:06:03.40,0:06:05.40,Default,,0,0,0,,Өйткені Юэ-сан сүйікті кейіпкер
Dialogue: 0,0:06:05.99,0:06:09.16,Default,,0,0,0,,Алайда әлсіреу өте біртіндеп жүреді.
Dialogue: 0,0:06:09.24,0:06:11.20,Default,,0,0,0,,Бұл сенің жүрегің
Dialogue: 0,0:06:11.28,0:06:14.79,Default,,0,0,0,,Сатқындықтан толық құтылмағаныңызды дәлелдеу
Dialogue: 0,0:06:14.87,0:06:15.83,Default,,0,0,0,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:06:15.91,0:06:19.75,Default,,0,0,0,,Өйткені менің өткен сатқындығым мен үшін маңызды.
Dialogue: 0,0:06:19.83,0:06:21.17,Default,,0,0,0,,Осындайша тәж кигізу рәсіміне кедергі келтіру…
Dialogue: 0,0:06:21.92,0:06:25.05,Default,,0,0,0,,Ағам мені сатып кетпесе ғой.
Dialogue: 0,0:06:25.13,0:06:29.34,Default,,0,0,0,,Мені тұңғиыққа мөр баспасаң, мен...
Dialogue: 0,0:06:30.05,0:06:34.39,Default,,0,0,0,,Сатқындықтың өткені болмаса, ол адаммен кездесе алмас едіңіз.
Dialogue: 0,0:06:34.47,0:06:40.27,Default,,0,0,0,,Өткенді жоя алсам да, сол жолды қайта-қайта таңдар едім.
Dialogue: 0,0:06:40.35,0:06:44.32,Default,,0,0,0,,Мен сені қайта-қайта бірдей азаптауға мәжбүр етемін.
Dialogue: 0,0:06:46.28,0:06:49.03,Default,,0,0,0,,Нақты не...
Dialogue: 0,0:06:49.11,0:06:50.91,Default,,0,0,0,,Ұқсас адамдар ше?
Dialogue: 0,0:06:51.82,0:06:53.78,Default,,0,0,0,,Оны аяқтау уақыты келді
Dialogue: 0,0:06:56.37,0:06:57.66,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:57.75,0:07:02.79,Default,,0,0,0,,Бұл Хаджиме Нагумо сіз үшін бәрінің тамыры дегенді білдіре ме?
Dialogue: 0,0:07:02.88,0:07:04.50,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:07:07.55,0:07:09.80,Default,,0,0,0,,Қарама-қайшылықтан алыстап
Dialogue: 0,0:07:09.80,0:07:10.47,Default,,0,0,0,,Қарама-қайшылықтан алыстап бара жатып, а...
Dialogue: 0,0:07:10.47,0:07:10.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:10.55,0:07:11.01,Default,,0,0,0,,А... Мен кім екенімді ойламадым.
Dialogue: 0,0:07:11.01,0:07:13.93,Default,,0,0,0,,Кім екеніңді ойламай
Dialogue: 0,0:07:14.01,0:07:15.30,Default,,0,0,0,,(Присцилла) Сол тәрбиесіз шлюхаға—
Dialogue: 0,0:07:15.39,0:07:18.14,Default,,0,0,0,,Оның қасында мәңгі қалсам екен.
Dialogue: 0,0:07:18.22,0:07:20.43,Default,,0,0,0,,Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:07:21.39,0:07:22.23,Default,,0,0,0,,Басыңыз!
Dialogue: 0,0:07:28.90,0:07:29.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:29.82,0:07:31.65,Default,,0,0,0,,Тым жылдам!
Dialogue: 0,0:07:31.74,0:07:33.07,Default,,0,0,0,,тым кеш!
Dialogue: 0,0:07:34.49,0:07:37.29,Default,,0,0,0,,Мұның бәрі сенің туылғаның үшін.
Dialogue: 0,0:07:37.79,0:07:40.75,Default,,0,0,0,,Отбасы жасырынып тұруға мәжбүр болды
Dialogue: 0,0:07:40.83,0:07:44.54,Default,,0,0,0,,Тіпті бір қоян тұқымының адамдары да маған аппақ көздерімен қарады.
Dialogue: 0,0:07:44.63,0:07:48.80,Default,,0,0,0,,Осынау ұлан-ғайыр ағаш теңізінде жалғыз менмін.
Dialogue: 0,0:07:48.88,0:07:51.72,Default,,0,0,0,,Тіпті менің отбасым да менен ерекше.
Dialogue: 0,0:07:51.80,0:07:53.59,Default,,0,0,0,,Мен қашуым керек еді.
Dialogue: 0,0:07:53.68,0:07:56.10,Default,,0,0,0,,Жалғыз, отбасынан жырақта
Dialogue: 0,0:07:56.18,0:07:59.31,Default,,0,0,0,,Егер мен мұны істегенімде, бұлай өлмес едім.
Dialogue: 0,0:07:59.39,0:08:01.68,Default,,0,0,0,,Бәрі әлсіз болғандықтан
Dialogue: 0,0:08:01.77,0:08:03.64,Default,,0,0,0,,Өйткені жаным мен тәнім әлсіз болды!
Dialogue: 0,0:08:04.77,0:08:05.61,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:09.32,0:08:10.78,Default,,0,0,0,,Өте ащы!
Dialogue: 0,0:08:10.78,0:08:11.99,Default,,0,0,0,,Өте ащы! (Виртуалды сурет Шиа) Ах...
Dialogue: 0,0:08:11.99,0:08:12.24,Default,,0,0,0,,Өте ащы!
Dialogue: 0,0:08:13.40,0:08:14.36,Default,,0,0,0,,Гаха!
Dialogue: 0,0:08:22.46,0:08:24.21,Default,,0,0,0,,Ахаха
Dialogue: 0,0:08:24.29,0:08:26.50,Default,,0,0,0,,Жарайсың, бұл
Dialogue: 0,0:08:26.58,0:08:28.88,Default,,0,0,0,,Бұл ақырында шек.
Dialogue: 0,0:08:28.96,0:08:31.92,Default,,0,0,0,,Сіздің шектеулеріңіз алыс сияқты.
Dialogue: 0,0:08:32.42,0:08:35.47,Default,,0,0,0,,Шынымен, мен түк те қозғалмаймын.
Dialogue: 0,0:08:35.55,0:08:39.06,Default,,0,0,0,,Бұл, әрине, мен көтеріп жүрген қараңғылық.
Dialogue: 0,0:08:40.31,0:08:44.14,Default,,0,0,0,,Өткенді өзгерте алмайсың, тек арқаңда алып жүруге болады.
Dialogue: 0,0:08:44.23,0:08:48.94,Default,,0,0,0,,Сонда да сіз болашақ үшін бар күшіңізді салуға ант еттіңіз ғой, солай ма?
Dialogue: 0,0:08:49.02,0:08:50.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:50.36,0:08:52.15,Default,,0,0,0,,Жақындарын алып кету әрекеті—
Dialogue: 0,0:08:52.24,0:08:56.61,Default,,0,0,0,,Бәріне қарсы тұрып, бәрін қорғай алатын адам
Dialogue: 0,0:08:56.70,0:09:01.04,Default,,0,0,0,,Сол адам боламын деп өзіңе сөз берген жоқсың ба?
Dialogue: 0,0:09:02.70,0:09:06.54,Default,,0,0,0,,Мен қазір жеңілмейтінімді мәлімдеймін.
Dialogue: 0,0:09:06.62,0:09:09.42,Default,,0,0,0,,Ешбір жаудан жеңілгім келмейді.
Dialogue: 0,0:09:09.50,0:09:10.88,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:10.96,0:09:14.05,Default,,0,0,0,,Бұл өзіңізді жеңу сынағы
Dialogue: 0,0:09:14.13,0:09:16.84,Default,,0,0,0,,Сіз оны баяғыда тазаладыңыз, солай ма?
Dialogue: 0,0:09:16.93,0:09:18.89,Default,,0,0,0,,Бұл сізге де, маған да тиімді мәміле, иә?
Dialogue: 0,0:09:18.97,0:09:21.97,Default,,0,0,0,,Мені жақындарым күтіп отыр.
Dialogue: 0,0:09:22.06,0:09:23.89,Default,,0,0,0,,Мен сізге өтуге рұқсат етемін.
Dialogue: 0,0:09:23.98,0:09:26.39,Default,,0,0,0,,Хехехе, жарайды.
Dialogue: 0,0:09:26.48,0:09:29.27,Default,,0,0,0,,Ең соңғы соққы
Dialogue: 0,0:09:29.36,0:09:31.19,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:09:31.27,0:09:32.53,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:34.28,0:09:37.74,Default,,0,0,0,,Ағаң сені неге өлтірмеді?
Dialogue: 0,0:09:38.49,0:09:40.03,Default,,0,0,0,,Білу керек
Dialogue: 0,0:09:40.62,0:09:43.12,Default,,0,0,0,,Сіздің өлмейтіндігіңіз абсолютті емес.
Dialogue: 0,0:09:43.20,0:09:45.71,Default,,0,0,0,,Өлтірмеу мүмкін емес.
Dialogue: 0,0:09:45.79,0:09:51.13,Default,,0,0,0,,Ол кісі мені әу бастан өлтірмекші болған жоқ па?
Dialogue: 0,0:09:51.21,0:09:54.55,Default,,0,0,0,,Иә, мөр басты мақсат болды.
Dialogue: 0,0:09:54.63,0:10:00.22,Default,,0,0,0,,Маған мөр басуға тура келген себебі бар еді...
Dialogue: 0,0:10:00.22,0:10:00.80,Default,,0,0,0,,Маған мөр басудың себебі бар еді...
Dialogue: 0,0:10:00.22,0:10:00.80,Default,,0,0,0,,(Сиқырлы дыбыс қосулы)
Dialogue: 0,0:10:00.80,0:10:00.89,Default,,0,0,0,,(Сиқырлы дыбыс қосулы)
Dialogue: 0,0:10:00.89,0:10:01.72,Default,,0,0,0,,(Сиқырлы дыбыс қосулы)
Dialogue: 0,0:10:00.89,0:10:01.72,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:04.35,0:10:05.81,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:07.64,0:10:10.56,Default,,0,0,0,,Сіз кімсіз? Мен кіммін?
Dialogue: 0,0:10:10.65,0:10:12.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:12.19,0:10:15.99,Default,,0,0,0,,Кім екеніңді ойламай
Dialogue: 0,0:10:16.07,0:10:17.36,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:17.86,0:10:20.53,Default,,0,0,0,,Мәңгілік қасында бола білу
Dialogue: 0,0:10:20.62,0:10:22.28,Default,,0,0,0,,Сіз шынымен солай ойлайсыз ба?
Dialogue: 0,0:10:23.03,0:10:26.75,Default,,0,0,0,,Мен... қате есімде қалдым ба?
Dialogue: 0,0:10:28.33,0:10:29.96,Default,,0,0,0,,Бірақ неге...
Dialogue: 0,0:10:33.96,0:10:35.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:35.46,0:10:38.17,Default,,0,0,0,,Сонда да мен жалғыз қалмаймын
Dialogue: 0,0:10:38.26,0:10:39.30,Default,,0,0,0,,Жоқ. Сіз...
Dialogue: 0,0:10:39.38,0:10:42.68,Default,,0,0,0,,Шиа Хаджименің қасында, Тио да сонда.
Dialogue: 0,0:10:42.76,0:10:45.31,Default,,0,0,0,,Тоқтамаса да, Каори де
Dialogue: 0,0:10:45.39,0:10:47.22,Default,,0,0,0,,Хехехе
Dialogue: 0,0:10:48.31,0:10:51.65,Default,,0,0,0,,Сіздің әлеміңіздің орталығы мәңгі
Dialogue: 0,0:10:51.73,0:10:53.48,Default,,0,0,0,,Бұл Хаджиме Нагумо.
Dialogue: 0,0:10:53.56,0:10:54.73,Default,,0,0,0,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:10:54.82,0:10:57.36,Default,,0,0,0,,Шынымен, бұл ұқсас адамдар
Dialogue: 0,0:10:57.44,0:10:59.86,Default,,0,0,0,,Өзіңізге басқа сұрақ қоюдың қажеті жоқ.
Dialogue: 0,0:10:59.95,0:11:00.95,Default,,0,0,0,,Иә
Dialogue: 0,0:11:04.87,0:11:06.20,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:11:06.29,0:11:08.70,Default,,0,0,0,,Ең болмағанда осы жерде ұтылып қалсақ
Dialogue: 0,0:11:08.79,0:11:10.41,Default,,0,0,0,,Хаджимен кездесе алмаймын
Dialogue: 0,0:11:10.50,0:11:12.00,Default,,0,0,0,,Менің жолыма кедергі болма!
Dialogue: 0,0:11:12.08,0:11:14.04,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:11:14.92,0:11:15.75,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:11:33.31,0:11:34.56,Default,,0,0,0,,-Юэ-сан! -Хмм...
Dialogue: 0,0:11:34.65,0:11:35.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:35.77,0:11:36.98,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:11:37.07,0:11:39.94,Default,,0,0,0,,Ештеңе емес, мен оны жеңе алдым.
Dialogue: 0,0:11:40.03,0:11:41.40,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:41.90,0:11:43.66,Default,,0,0,0,,Мен басымдықпен жеңдім!
Dialogue: 0,0:11:45.28,0:11:46.12,Default,,0,0,0,,Ши
Dialogue: 0,0:11:46.20,0:11:48.29,Default,,0,0,0,,SERN уақыт машинасын әзірлеуде сәттілікке жеткен себебі
Dialogue: 0,0:11:49.62,0:11:52.58,Default,,0,0,0,,Маған бірдеңе болса
Dialogue: 0,0:11:53.08,0:11:54.21,Default,,0,0,0,,Хаджима, өтінемін
Dialogue: 0,0:11:54.29,0:11:55.63,Default,,0,0,0,,Ха, ха, ха!
Dialogue: 0,0:11:58.46,0:12:00.05,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:12:00.13,0:12:01.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:01.13,0:12:05.01,Default,,0,0,0,,Мен қалжыңдамаймын. Мен мұны өз түсінігіммен айтып отырмын.
Dialogue: 0,0:12:05.64,0:12:06.97,Default,,0,0,0,,Дайын ба?
Dialogue: 0,0:12:07.05,0:12:08.26,Default,,0,0,0,,Ммм
Dialogue: 0,0:12:09.35,0:12:10.52,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:11.77,0:12:14.40,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:12:15.35,0:12:16.31,Default,,0,0,0,,Ши?
Dialogue: 0,0:12:17.36,0:12:18.90,Default,,0,0,0,,Шығарыңыз
Dialogue: 0,0:12:18.98,0:12:19.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:19.90,0:12:23.11,Default,,0,0,0,,Хаджиме-санға сеніп тапсыру деген сондай ақымақ сөз.
Dialogue: 0,0:12:23.20,0:12:24.99,Default,,0,0,0,,Қазір бас тартыңыз!
Dialogue: 0,0:12:25.07,0:12:27.37,Default,,0,0,0,,А... менің сенімім...
Dialogue: 0,0:12:27.45,0:12:28.95,Default,,0,0,0,,«Әзіл сөздер» дейсіз бе?
Dialogue: 0,0:12:29.03,0:12:31.04,Default,,0,0,0,,Тағы не айта аламын?
Dialogue: 0,0:12:31.70,0:12:34.96,Default,,0,0,0,,Мен сен туралы алдамшы ретінде не айтылғанын білмеймін.
Dialogue: 0,0:12:35.04,0:12:36.42,Default,,0,0,0,,Бұл өте қызықсыз.
Dialogue: 0,0:12:36.50,0:12:37.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:37.54,0:12:40.59,Default,,0,0,0,,Қандай жеңілмейтін вампир ханшайым!
Dialogue: 0,0:12:40.67,0:12:44.76,Default,,0,0,0,,Мен сенің жаман қылықтарыңды түзетемін!
Dialogue: 0,0:12:44.84,0:12:46.05,Default,,0,0,0,,Ши! асылу!
Dialogue: 0,0:12:51.56,0:12:53.77,Default,,0,0,0,,Шиа Бұл тым көп әзіл.
Dialogue: 0,0:12:53.85,0:12:56.10,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба? Осы кезеңде...
Dialogue: 0,0:12:56.19,0:12:59.06,Default,,0,0,0,,Әлі де осылай бос сөз айтып тұрсың ба?
Dialogue: 0,0:12:59.15,0:13:02.57,Default,,0,0,0,,Ашық айтайын: мен байыптымын.
Dialogue: 0,0:13:03.07,0:13:04.86,Default,,0,0,0,,Шиа Неліктен?
Dialogue: 0,0:13:04.95,0:13:07.74,Default,,0,0,0,,«Неге» дегенге шыдай алмаймын!
Dialogue: 0,0:13:07.82,0:13:09.87,Default,,0,0,0,,Кәдімгі Юэ-сан!
Dialogue: 0,0:13:09.95,0:13:11.41,Default,,0,0,0,,Менің Юэ-саным!
Dialogue: 0,0:13:12.20,0:13:14.83,Default,,0,0,0,,Мен мұны ешқашан айтпас едім!
Dialogue: 0,0:13:14.91,0:13:16.62,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:13:16.71,0:13:19.25,Default,,0,0,0,,Мен сұрауға қаншалықты дайын болдым!
Dialogue: 0,0:13:19.34,0:13:20.59,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:21.75,0:13:22.71,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:23.38,0:13:25.01,Default,,0,0,0,,Ммммммм!
Dialogue: 0,0:13:25.09,0:13:27.13,Default,,0,0,0,,Осындай нәрсе!
Dialogue: 0,0:13:27.22,0:13:29.26,Default,,0,0,0,,Сіз шешімді айтасыз ба? Десу!
Dialogue: 0,0:13:30.35,0:13:31.64,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:34.18,0:13:35.64,Default,,0,0,0,,Ши! Уайымдама...
Dialogue: 0,0:13:35.73,0:13:37.85,Default,,0,0,0,,Бұл менің жолым!
Dialogue: 0,0:13:37.94,0:13:41.02,Default,,0,0,0,,Сіз бұл туралы аздап ойландыңыз ба және кері кетуге дайынсыз ба?
Dialogue: 0,0:13:41.61,0:13:42.65,Default,,0,0,0,,Неге...
Dialogue: 0,0:13:42.73,0:13:44.07,Default,,0,0,0,,«Неге»?
Dialogue: 0,0:13:44.15,0:13:46.07,Default,,0,0,0,,Білмейтініңізге сенімдісіз бе?
Dialogue: 0,0:13:50.24,0:13:51.37,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:51.45,0:13:52.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:54.04,0:13:55.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:55.29,0:13:57.54,Default,,0,0,0,,Сеніп тапсыру деген нені білдіреді
Dialogue: 0,0:13:57.62,0:14:02.88,Default,,0,0,0,,Бұл Юэ-санның болашақта одан әрі өмір сүрмейтінін білдірмейді ме?
Dialogue: 0,0:14:04.55,0:14:05.63,Default,,0,0,0,,Ши…
Dialogue: 0,0:14:08.43,0:14:13.68,Default,,0,0,0,,Мен осындай болашақты құптаймын деп ойладың ба?
Dialogue: 0,0:14:13.76,0:14:16.48,Default,,0,0,0,,Мен жай ғана «иә» деп айтамын деп ойладың ба?
Dialogue: 0,0:14:17.69,0:14:20.40,Default,,0,0,0,,Мен кез келген жағдайға дайын болғым келеді...
Dialogue: 0,0:14:20.48,0:14:23.52,Default,,0,0,0,,Сіз мұны білесіз бе? болып табылады!
Dialogue: 0,0:14:23.61,0:14:25.44,Default,,0,0,0,,Ах... хмм
Dialogue: 0,0:14:32.62,0:14:36.20,Default,,0,0,0,,Уәде берсем де Хажиме-кунды қорғай алмадым.
Dialogue: 0,0:14:36.79,0:14:38.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:38.12,0:14:40.96,Default,,0,0,0,,Мен Юэді дәрменсіз қызғандым.
Dialogue: 0,0:14:41.04,0:14:43.54,Default,,0,0,0,,Төмендік сезімімен қиналған
Dialogue: 0,0:14:43.63,0:14:46.38,Default,,0,0,0,,Мен неге «ерекше» емеспін?
Dialogue: 0,0:14:46.46,0:14:48.88,Default,,0,0,0,,Мен неге сонша әлсізмін?
Dialogue: 0,0:14:48.97,0:14:52.14,Default,,0,0,0,,Бастапқы денемді беру арқылы билікке ие болғанмен.
Dialogue: 0,0:14:52.22,0:14:55.06,Default,,0,0,0,,Неліктен шиа? Неліктен?
Dialogue: 0,0:14:55.14,0:14:57.73,Default,,0,0,0,,Міне, мен тиесілімін!
Dialogue: 0,0:14:58.23,0:15:00.23,Default,,0,0,0,,Мен сені бәрінен де жақсы көрсем де
Dialogue: 0,0:15:00.23,0:15:01.06,Default,,0,0,0,,Мен сені бәрінен де жақсы көрсем де
Dialogue: 0,0:15:00.23,0:15:01.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:01.15,0:15:04.73,Default,,0,0,0,,Менің жақын адамдарымды алмаңыз!
Dialogue: 0,0:15:04.82,0:15:06.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:06.23,0:15:07.07,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:15:10.61,0:15:12.78,Default,,0,0,0,,Яаааа!
Dialogue: 0,0:15:13.45,0:15:14.99,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:15.08,0:15:16.79,Default,,0,0,0,,Жылдамдық қайтадан артты.
Dialogue: 0,0:15:19.66,0:15:20.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:23.08,0:15:27.84,Default,,0,0,0,,Ішіңіздегі қызғаныш, тітіркену, шыдамсыздық және кемшілік кешені.
Dialogue: 0,0:15:27.92,0:15:29.67,Default,,0,0,0,,Ештеңе жоғалған жоқ!
Dialogue: 0,0:15:30.34,0:15:34.60,Default,,0,0,0,,Дәл осы сәтте де сен жараланып, қиналып жүрсің!
Dialogue: 0,0:15:34.68,0:15:36.85,Default,,0,0,0,,Сіз әлі де өсе аласыз
Dialogue: 0,0:15:36.93,0:15:38.27,Default,,0,0,0,,Ах
Dialogue: 0,0:15:43.40,0:15:44.23,Default,,0,0,0,,Найзағай!
Dialogue: 0,0:15:45.94,0:15:47.82,Default,,0,0,0,,Қашықтан белсендіру?
Dialogue: 0,0:15:48.61,0:15:50.82,Default,,0,0,0,,Ахх...
Dialogue: 0,0:15:50.90,0:15:53.28,Default,,0,0,0,,Арматура тоқтады ма?
Dialogue: 0,0:15:53.36,0:15:57.03,Default,,0,0,0,,Мен шынымен де өзім туралымын, солай емес пе?
Dialogue: 0,0:15:57.12,0:15:58.79,Default,,0,0,0,,Мектепте де
Dialogue: 0,0:15:58.87,0:16:01.25,Default,,0,0,0,,Мен де Шидзуку-чаннан және басқалардан бөлініп шықтым.
Dialogue: 0,0:16:01.33,0:16:04.71,Default,,0,0,0,,Дұрыс, түсіну қиын.
Dialogue: 0,0:16:04.79,0:16:07.25,Default,,0,0,0,,Сіз өте өзімшілсіз.
Dialogue: 0,0:16:07.34,0:16:09.67,Default,,0,0,0,,Сіз әдемі адамнан алыссыз!
Dialogue: 0,0:16:09.76,0:16:11.13,Default,,0,0,0,,- (Виртуалды Каори) Иә! -(Каори) Хмм...
Dialogue: 0,0:16:17.39,0:16:19.06,Default,,0,0,0,,Мен өзгерткім келеді
Dialogue: 0,0:16:19.14,0:16:21.31,Default,,0,0,0,,Мен Юэ сияқты мейірімді болғым келеді
Dialogue: 0,0:16:21.39,0:16:23.64,Default,,0,0,0,,Шиа сияқты күшті болғым келеді
Dialogue: 0,0:16:23.73,0:16:25.85,Default,,0,0,0,,Мен Тио сияқты ақылды болғым келеді
Dialogue: 0,0:16:25.94,0:16:28.23,Default,,0,0,0,,Мен Шидзуку-чан сияқты сүйкімді болғым келеді
Dialogue: 0,0:16:28.32,0:16:29.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:30.15,0:16:31.57,Default,,0,0,0,,Жағымсыз эмоцияларды қалдырыңыз
Dialogue: 0,0:16:31.65,0:16:34.66,Default,,0,0,0,,Сонда да мен әлсірей бастадым.
Dialogue: 0,0:16:34.74,0:16:36.24,Default,,0,0,0,,Сіз дәл осы сәтте
Dialogue: 0,0:16:36.32,0:16:38.53,Default,,0,0,0,,Себебі біз алға жылжып келеміз.
Dialogue: 0,0:16:38.62,0:16:40.70,Default,,0,0,0,,Мен Шиадан қызғандым
Dialogue: 0,0:16:40.79,0:16:44.33,Default,,0,0,0,,Бірақ мен де сондай бақытты сезіндім.
Dialogue: 0,0:16:44.42,0:16:46.54,Default,,0,0,0,,Мен Юэді жек көремін.
Dialogue: 0,0:16:46.63,0:16:50.17,Default,,0,0,0,,Бірақ мен сенсіз жалғыздықты сезіндім.
Dialogue: 0,0:16:50.25,0:16:52.34,Default,,0,0,0,,Мен де Шидзуку-чанның сезімін байқадым!
Dialogue: 0,0:16:52.42,0:16:53.26,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,0:16:55.38,0:16:57.76,Default,,0,0,0,,Мен өз шіркіннен қорқамын
Dialogue: 0,0:16:57.85,0:17:00.18,Default,,0,0,0,,Бірақ мен енді қарамаймын!
Dialogue: 0,0:17:00.26,0:17:04.23,Default,,0,0,0,,Мен ешкімнен артық өзімді жоғалтпаймын
Dialogue: 0,0:17:04.31,0:17:06.10,Default,,0,0,0,,Қорғағыңыз келетін адамдарды қорғаңыз
Dialogue: 0,0:17:06.19,0:17:08.77,Default,,0,0,0,,Мен барлығымен Жапонияға қайтамын!
Dialogue: 0,0:17:16.20,0:17:17.49,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:17.57,0:17:18.41,Default,,0,0,0,,Я...
Dialogue: 0,0:17:18.99,0:17:21.62,Default,,0,0,0,,Енді ешқандай сөз қажет емес.
Dialogue: 0,0:17:22.12,0:17:24.83,Default,,0,0,0,,Арматура толығымен алынып тасталды.
Dialogue: 0,0:17:24.91,0:17:27.42,Default,,0,0,0,,Бұл соңғы рет.
Dialogue: 0,0:17:27.50,0:17:30.00,Default,,0,0,0,,Жақсы, қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:17:30.09,0:17:33.13,Default,,0,0,0,,Тағы бір нәрсе: әлсіздігіңізді кесіңіз
Dialogue: 0,0:17:38.47,0:17:39.30,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:17:40.10,0:17:41.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:41.47,0:17:43.93,Default,,0,0,0,,Ой! Ау!
Dialogue: 0,0:17:44.56,0:17:45.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:45.89,0:17:47.85,Default,,0,0,0,,​​Не? Бұл не?
Dialogue: 0,0:17:50.44,0:17:53.53,Default,,0,0,0,,Еске саламын, Юэ-сан.
Dialogue: 0,0:17:55.82,0:17:58.32,Default,,0,0,0,,Шынайы анықтау дегеніміз не?
Dialogue: 0,0:18:00.78,0:18:04.20,Default,,0,0,0,,Ах... Ум, Юэ? Ши? Жер бетінде не ...
Dialogue: 0,0:18:04.29,0:18:06.83,Default,,0,0,0,,Шиа, тыңда! қате есімде...
Dialogue: 0,0:18:06.91,0:18:08.58,Default,,0,0,0,,Бұл тітіркендіргіш!
Dialogue: 0,0:18:08.67,0:18:12.25,Default,,0,0,0,,Мен Хажиме-сан тапқан «ерекшеден» бас тартпаймын!
Dialogue: 0,0:18:12.34,0:18:13.75,Default,,0,0,0,,«Жағдайда» деген не?
Dialogue: 0,0:18:13.84,0:18:15.67,Default,,0,0,0,,-Сен сондай жалқаусың! -(Каори) А... аа... аа...
Dialogue: 0,0:18:15.76,0:18:18.18,Default,,0,0,0,,Мен мөрлендім
Dialogue: 0,0:18:18.26,0:18:19.43,Default,,0,0,0,,Тағы бір себеп бар
Dialogue: 0,0:18:19.51,0:18:21.51,Default,,0,0,0,,Сіз бірдеңе білесіз бе? болып табылады!
Dialogue: 0,0:18:21.60,0:18:24.10,Default,,0,0,0,,-Аа... -Жаумен кездессем, өлтіремін!
Dialogue: 0,0:18:24.18,0:18:26.02,Default,,0,0,0,,Алға ұмтылыңыз!
Dialogue: 0,0:18:26.10,0:18:27.85,Default,,0,0,0,,Бұл біз, солай ма?
Dialogue: 0,0:18:27.94,0:18:30.81,Default,,0,0,0,,Кез келген жағдайда бұған дайын болыңыз.
Dialogue: 0,0:18:30.90,0:18:34.53,Default,,0,0,0,,О, қазірдің өзінде! Бұл бейшара вампир ханшайымы!
Dialogue: 0,0:18:34.61,0:18:36.78,Default,,0,0,0,,Баннен Очиби! Жарты кеуде!
Dialogue: 0,0:18:36.86,0:18:38.95,Default,,0,0,0,,Жартылай тақ сүт Жартылай тақ сүт Жартылай тақ сүт...
Dialogue: 0,0:18:39.03,0:18:42.78,Default,,0,0,0,,Чи… чи… чиби? Жарты кеуде...
Dialogue: 0,0:18:43.53,0:18:46.20,Default,,0,0,0,,Хе... хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе
Dialogue: 0,0:18:47.04,0:18:49.62,Default,,0,0,0,,Айтуға болмайтын нәрселер!
Dialogue: 0,0:18:50.21,0:18:53.29,Default,,0,0,0,,Шығаратын болсаң, қазір уақыт, байғұс қоян!
Dialogue: 0,0:18:53.38,0:18:57.05,Default,,0,0,0,,Бұл менің желісім, кішкентай бала!
Dialogue: 0,0:18:57.13,0:19:01.34,Default,,0,0,0,,Мен саған қоңыр қуырылған қоян жасап, бағалардың айырмашылығын үйретемін.
Dialogue: 0,0:19:01.43,0:19:05.47,Default,,0,0,0,,Ха! Мен мына кішкентай кеуделі жігітке шыдай алмаймын!
Dialogue: 0,0:19:05.56,0:19:07.68,Default,,0,0,0,,Бүгін - Гекокудзо!
Dialogue: 0,0:19:09.35,0:19:10.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:10.56,0:19:13.77,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:19:15.77,0:19:16.78,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:21.78,0:19:22.61,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:23.53,0:19:24.62,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:25.99,0:19:29.91,Default,,0,0,0,,Дұрыс, екеуі жақсы дос.
Dialogue: 0,0:19:30.00,0:19:33.46,Default,,0,0,0,,Ой... бәлкім мен жаман бала шығармын.
Dialogue: 0,0:19:33.54,0:19:36.96,Default,,0,0,0,,А... Иә? Менің күшім артып жатыр ма?
Dialogue: 0,0:19:37.05,0:19:40.09,Default,,0,0,0,,Жоқ... Жоқ, сен! Өз-өзіңді күт!
Dialogue: 0,0:19:40.17,0:19:43.09,Default,,0,0,0,,Мен жақсы емеспін ғой...
Dialogue: 0,0:19:43.18,0:19:44.93,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:19:45.01,0:19:46.93,Default,,0,0,0,,Өйткені сен жаман емессің
Dialogue: 0,0:19:47.01,0:19:51.89,Default,,0,0,0,,Өзіңізге рефлексия жасаңыз! Бұл мәңгі құмар вампир ханшайымы!
Dialogue: 0,0:19:51.98,0:19:55.48,Default,,0,0,0,,Сен адамдар туралы айта аласың ба, шұбар қоян?
Dialogue: 0,0:19:55.56,0:19:57.32,Default,,0,0,0,,Шұңқыр кім?
Dialogue: 0,0:19:57.40,0:20:00.11,Default,,0,0,0,,Қай жерде болсаңыз да, Хаджиме-санға шабуыл жасайсыз!
Dialogue: 0,0:20:00.19,0:20:01.65,Default,,0,0,0,,Сен бұзық!
Dialogue: 0,0:20:03.70,0:20:05.12,Default,,0,0,0,,Тио деген кім!
Dialogue: 0,0:20:05.20,0:20:08.54,Default,,0,0,0,,Ылғалданатын қоян, мен сені тағы да ұстай алмаймын!
Dialogue: 0,0:20:08.62,0:20:11.29,Default,,0,0,0,,Жоқ! Болжам бойынша, оның жасы 300-ден асты
Dialogue: 0,0:20:11.37,0:20:14.46,Default,,0,0,0,,Әже атанғанда сұмдық боласың ба?
Dialogue: 0,0:20:14.54,0:20:16.46,Default,,0,0,0,,Буккоро! Буккоро!
Dialogue: 0,0:20:16.54,0:20:19.09,Default,,0,0,0,,Мен сендерге тартылыс сиқырының қаупі туралы айтып беремін.
Dialogue: 0,0:20:19.17,0:20:21.88,Default,,0,0,0,,Салбырап тұрған кеудеңді жылат!
Dialogue: 0,0:20:36.94,0:20:39.98,Default,,0,0,0,,(Юэ мен Шианың ауыр тыныс алуы)
Dialogue: 0,0:20:40.07,0:20:42.82,Default,,0,0,0,,Өтінемін, қайғылы сөздер айтпаңыз.
Dialogue: 0,0:20:43.32,0:20:47.37,Default,,0,0,0,,Егер сізде қандай да бір алаңдаушылық болса, оларды бірге жойайық.
Dialogue: 0,0:20:48.20,0:20:49.95,Default,,0,0,0,,Маған сеніп тапсырмаңыз.
Dialogue: 0,0:20:50.04,0:20:51.75,Default,,0,0,0,,Мені тартуыңызды өтінемін.
Dialogue: 0,0:20:51.83,0:20:55.58,Default,,0,0,0,,Айтыңызшы, болашақ үшін бірге күресейік!
Dialogue: 0,0:20:55.67,0:20:57.79,Default,,0,0,0,,Мен сені ешқашан тыңдамаймын!
Dialogue: 0,0:20:57.88,0:21:00.25,Default,,0,0,0,,Бұл қандай ақымақ өтініш
Dialogue: 0,0:21:00.34,0:21:03.09,Default,,0,0,0,,Тыңдайтыныңызға сенімдісіз бе?
Dialogue: 0,0:21:03.17,0:21:08.26,Default,,0,0,0,,(шиалардың айқайы)
Dialogue: 0,0:21:08.35,0:21:09.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:12.22,0:21:13.43,Default,,0,0,0,,Ши
Dialogue: 0,0:21:13.52,0:21:14.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:16.48,0:21:17.65,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:17.73,0:21:19.82,Default,,0,0,0,,А... Юэ-сан?
Dialogue: 0,0:21:19.90,0:21:22.23,Default,,0,0,0,,Шиа айтқандай
Dialogue: 0,0:21:22.32,0:21:26.03,Default,,0,0,0,,Өткенім қандай болса да, қандай болсам да
Dialogue: 0,0:21:26.11,0:21:28.16,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:21:29.07,0:21:33.29,Default,,0,0,0,,Мен Хаджиме мен Шиамен бірге болғым келеді.
Dialogue: 0,0:21:33.83,0:21:35.46,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:21:35.54,0:21:37.75,Default,,0,0,0,,Сонымен не кедергі болады
Dialogue: 0,0:21:37.83,0:21:40.17,Default,,0,0,0,,Еш нәрсеге қарамастан оны нокаутқа түсіріңіз.
Dialogue: 0,0:21:40.25,0:21:42.42,Default,,0,0,0,,Барлығы осы болды.
Dialogue: 0,0:21:42.50,0:21:45.42,Default,,0,0,0,,Уф... бұл дұрыс.
Dialogue: 0,0:21:45.51,0:21:46.34,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:21:46.43,0:21:50.68,Default,,0,0,0,,(шиалардың айқайы)
Dialogue: 0,0:21:50.76,0:21:52.60,Default,,0,0,0,,Ей, екеуің де.
Dialogue: 0,0:21:52.68,0:21:53.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:53.60,0:21:56.94,Default,,0,0,0,,Сот өтетін жер шатастырылды
Dialogue: 0,0:21:57.52,0:22:00.40,Default,,0,0,0,,Сіз мұны шынымен түсіндіңіз бе?
Dialogue: 0,0:22:01.90,0:22:03.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:03.98,0:22:08.99,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.90,0:23:33.91,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.95,0:23:38.95,Default,,0,0,0,,Келесі жолы «Батырдың тамыры»
Dialogue: 0,0:23:40.45,0:23:46.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
