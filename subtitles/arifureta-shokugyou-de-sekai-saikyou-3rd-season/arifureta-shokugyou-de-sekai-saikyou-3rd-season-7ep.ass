Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.50,0:00:12.72,Default,,0,0,0,,Ол әлі тірі сияқты.
Dialogue: 0,0:00:14.18,0:00:18.05,Default,,0,0,0,,Юэдің де, Тионың да бастапқы пішініне оралғаны тамаша.
Dialogue: 0,0:00:18.89,0:00:22.23,Default,,0,0,0,,Өздігінен қайту ғана қалды...
Dialogue: 0,0:00:26.02,0:00:28.57,Default,,0,0,0,,А... Мәселе бар ма?
Dialogue: 0,0:00:36.53,0:00:39.37,Default,,0,0,0,,Тезірек орал, Юэ.
Dialogue: 0,0:00:40.37,0:00:43.37,Default,,0,0,0,,Мен сіздің дауысыңызды дәл қазір естігім келеді.
Dialogue: 0,0:00:44.46,0:00:45.29,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:03.93,0:01:05.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:05.64,0:01:07.90,Default,,0,0,0,,Юэ қош келдіңіз
Dialogue: 0,0:01:07.98,0:01:12.98,Default,,0,0,0,,♪～
Dialogue: 0,0:02:32.94,0:02:37.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:46.08,0:02:47.29,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:02:47.37,0:02:49.54,Default,,0,0,0,,Хмм... Хаджиме?
Dialogue: 0,0:02:49.62,0:02:51.42,Default,,0,0,0,,О, менмін.
Dialogue: 0,0:02:51.50,0:02:53.21,Default,,0,0,0,,Нағыз Хаджиме?
Dialogue: 0,0:02:53.29,0:02:55.67,Default,,0,0,0,,Неліктен бұлай сұрайсыз?
Dialogue: 0,0:02:55.75,0:02:57.67,Default,,0,0,0,,Мен себебін түсіндім, бірақ...
Dialogue: 0,0:02:59.67,0:03:02.18,Default,,0,0,0,,Мұны Юэ шешсін.
Dialogue: 0,0:03:02.68,0:03:06.14,Default,,0,0,0,,Мен Юэнің алдындағы нағыз адаммын ба?
Dialogue: 0,0:03:06.22,0:03:07.77,Default,,0,0,0,,Әлде бұл жалған ба?
Dialogue: 0,0:03:07.85,0:03:09.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:10.31,0:03:12.27,Default,,0,0,0,,Айтпақшы, мен қазір
Dialogue: 0,0:03:12.35,0:03:18.19,Default,,0,0,0,,Құшағымдағы юэдің нағыз юэ екеніне көзім жетті.
Dialogue: 0,0:03:19.28,0:03:20.11,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:23.62,0:03:26.33,Default,,0,0,0,,Мен сонда қалай болдым?
Dialogue: 0,0:03:26.41,0:03:27.83,Default,,0,0,0,,Менің мектеп формасы
Dialogue: 0,0:03:27.91,0:03:29.54,Default,,0,0,0,,Бұл маған өлімге лайық болды.
Dialogue: 0,0:03:29.62,0:03:30.46,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:31.21,0:03:33.63,Default,,0,0,0,,Мен оны бір күні киемін.
Dialogue: 0,0:03:33.71,0:03:35.34,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:03:35.84,0:03:36.92,Default,,0,0,0,,Юэ ше?
Dialogue: 0,0:03:37.00,0:03:38.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:38.34,0:03:41.26,Default,,0,0,0,,Ресми киім мен тақ өлімге сәйкес келді.
Dialogue: 0,0:03:41.34,0:03:44.76,Default,,0,0,0,,Кешіріңіз, мен салтанатты киімді кие алмаймын, бірақ тақты кие алмаймын.
Dialogue: 0,0:03:44.84,0:03:47.06,Default,,0,0,0,,Тоқта, неге тақ?
Dialogue: 0,0:03:48.10,0:03:49.68,Default,,0,0,0,,Патшайым бастады
Dialogue: 0,0:03:49.77,0:03:52.48,Default,,0,0,0,,Қазірдің өзінде 11 бала болды
Dialogue: 0,0:03:52.56,0:03:53.85,Default,,0,0,0,,Үлкен отбасы!
Dialogue: 0,0:03:53.94,0:03:55.27,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:56.31,0:03:56.61,Default,,0,0,0,,-Мм -Ааа...
Dialogue: 0,0:03:56.61,0:03:57.94,Default,,0,0,0,,-Мм -Ааа...
Dialogue: 0,0:03:56.61,0:03:57.94,Default,,0,0,0,,Гохо Эхон!
Dialogue: 0,0:03:57.94,0:03:58.65,Default,,0,0,0,,Гохо Эхон!
Dialogue: 0,0:03:58.73,0:04:00.49,Default,,0,0,0,,Уго Ечен
Dialogue: 0,0:04:00.57,0:04:01.90,Default,,0,0,0,,Гохоггахат!
Dialogue: 0,0:04:01.99,0:04:03.91,Default,,0,0,0,,Буекшой!
Dialogue: 0,0:04:04.41,0:04:05.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:05.78,0:04:06.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:07.33,0:04:09.66,Default,,0,0,0,,(шиалардың айқайы)
Dialogue: 0,0:04:09.74,0:04:12.41,Default,,0,0,0,,Мен бәрібір қажетсіз баламын.
Dialogue: 0,0:04:12.50,0:04:16.13,Default,,0,0,0,,Мен шындыққа оралуға бар күшімді салдым, бірақ кенет өзімді бос сезіндім.
Dialogue: 0,0:04:16.21,0:04:20.09,Default,,0,0,0,,Мен бар екенімді жөтелмен көрсетуге тырыссам да...
Dialogue: 0,0:04:20.17,0:04:21.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:22.80,0:04:23.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:23.72,0:04:28.01,Default,,0,0,0,,Иә, менің ойымша, Шианың қоян құлағы жоқ.
Dialogue: 0,0:04:28.10,0:04:29.93,Default,,0,0,0,,Қоян құлақты шиа
Dialogue: 0,0:04:30.01,0:04:32.39,Default,,0,0,0,,Қоян құлағы жоқ шиа жоқ.
Dialogue: 0,0:04:32.48,0:04:34.23,Default,,0,0,0,,Керісінше, қоянның құлағы шиа.
Dialogue: 0,0:04:34.31,0:04:36.19,Default,,0,0,0,,Мен бұл нені білдіретінін түсінбеймін
Dialogue: 0,0:04:36.27,0:04:39.65,Default,,0,0,0,,Қоянның құлағы сөзсіз негізгі дене емес.
Dialogue: 0,0:04:39.73,0:04:41.48,Default,,0,0,0,,Шиа қандай түс көрді?
Dialogue: 0,0:04:41.57,0:04:42.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:43.03,0:04:45.74,Default,,0,0,0,,Мені бұл дүниеге шақырған жоқ
Dialogue: 0,0:04:45.82,0:04:49.53,Default,,0,0,0,,Бейбіт күнделікті өмірде Юэ, Шиа және басқалармен бірге уақыт өткізу
Dialogue: 0,0:04:49.62,0:04:51.16,Default,,0,0,0,,Бұл арман болды
Dialogue: 0,0:04:51.24,0:04:56.29,Default,,0,0,0,,Түсімде отбасымды қуып жібермес бұрын мен Хаджиме-санды және басқаларды кездестірдім.
Dialogue: 0,0:04:56.37,0:04:58.58,Default,,0,0,0,,Біз бірге тұруымыз керек еді.
Dialogue: 0,0:04:59.29,0:05:02.76,Default,,0,0,0,,Мен қорғалғаныма қуаныштымын.
Dialogue: 0,0:05:03.26,0:05:04.76,Default,,0,0,0,,Бірақ олай емес.
Dialogue: 0,0:05:04.84,0:05:06.51,Default,,0,0,0,,Жүрегім жылайды
Dialogue: 0,0:05:07.14,0:05:10.60,Default,,0,0,0,,Мен мұны білмей тұрып, күресуді таңдадым.
Dialogue: 0,0:05:10.68,0:05:12.97,Default,,0,0,0,,Хаджиме-санның және басқалардың қасында
Dialogue: 0,0:05:13.06,0:05:15.14,Default,,0,0,0,,Сол үшін қайтып келдің бе?
Dialogue: 0,0:05:15.23,0:05:16.35,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:16.44,0:05:19.86,Default,,0,0,0,,Бұдан былай мен Хаджиме-сан мен Юэ-санның қасында боламын.
Dialogue: 0,0:05:19.94,0:05:21.65,Default,,0,0,0,,Мен кезекке тұрғым келеді.
Dialogue: 0,0:05:21.73,0:05:26.20,Default,,0,0,0,,Жол азап пен қасірет болса да
Dialogue: 0,0:05:26.28,0:05:27.86,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:28.78,0:05:29.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:30.20,0:05:32.99,Default,,0,0,0,,А... иә, Хаджиме-сан?
Dialogue: 0,0:05:33.08,0:05:34.87,Default,,0,0,0,,Ал, не...
Dialogue: 0,0:05:34.95,0:05:38.21,Default,,0,0,0,,Қош келдіңіз, Шиа, қайтып келгеніме қуаныштымын.
Dialogue: 0,0:05:38.29,0:05:41.79,Default,,0,0,0,,Иә! Мен үйдемін!
Dialogue: 0,0:05:43.34,0:05:44.17,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:44.26,0:05:45.42,Default,,0,0,0,,Хаджиме
Dialogue: 0,0:05:45.51,0:05:46.55,Default,,0,0,0,,-Мм? -Хмм
Dialogue: 0,0:05:48.68,0:05:49.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:50.35,0:05:52.10,Default,,0,0,0,,Нуга~!
Dialogue: 0,0:05:52.18,0:05:55.48,Default,,0,0,0,,Қожаның жазасы онша жылы емес!
Dialogue: 0,0:05:55.56,0:05:57.89,Default,,0,0,0,,Сіз нөлден бастайсыз!
Dialogue: 0,0:05:57.98,0:05:59.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:59.27,0:06:01.94,Default,,0,0,0,,Ұстаз~!
Dialogue: 0,0:06:02.02,0:06:03.98,Default,,0,0,0,,Сіз қайтып келдіңіз!
Dialogue: 0,0:06:04.07,0:06:06.40,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:06:06.49,0:06:07.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:09.61,0:06:13.33,Default,,0,0,0,,Иә? Не? Мастер
Dialogue: 0,0:06:13.41,0:06:16.45,Default,,0,0,0,,Сен маған қарап тұрсың ба? Нуфуфу
Dialogue: 0,0:06:23.21,0:06:25.92,Default,,0,0,0,,Адамдардың сізге қарағанын қаласаңыз, өзіңізді күлуге мәжбүрлемеңіз.
Dialogue: 0,0:06:26.01,0:06:29.43,Default,,0,0,0,,Ондайда кәдімгі бұзық бет әлдеқайда жақсырақ.
Dialogue: 0,0:06:29.51,0:06:30.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:31.97,0:06:33.51,Default,,0,0,0,,Не болса да...
Dialogue: 0,0:06:34.14,0:06:35.77,Default,,0,0,0,,Тиоға қош келдіңіз
Dialogue: 0,0:06:37.98,0:06:41.19,Default,,0,0,0,,Хмм, мен қазір үйдемін, шебер.
Dialogue: 0,0:06:41.27,0:06:42.56,Default,,0,0,0,,Беха!
Dialogue: 0,0:06:42.65,0:06:43.73,Default,,0,0,0,,Жоқ... жоқ! Хаджиме!
Dialogue: 0,0:06:43.73,0:06:45.23,Default,,0,0,0,,Жоқ... жоқ! Хаджиме!
Dialogue: 0,0:06:43.73,0:06:45.23,Default,,0,0,0,,Хмм?
Dialogue: 0,0:06:45.82,0:06:48.19,Default,,0,0,0,,А... аа... мен... Енді бұл...
Dialogue: 0,0:06:48.28,0:06:51.07,Default,,0,0,0,,Эй... хмм... Не айтарымды білмеймін...
Dialogue: 0,0:06:51.16,0:06:52.66,Default,,0,0,0,,Басқаша!
Dialogue: 0,0:06:52.74,0:06:54.91,Default,,0,0,0,,Мен одан құтылғандай емеспін!
Dialogue: 0,0:06:54.99,0:06:57.62,Default,,0,0,0,,Жоқ, мен қарсы емеспін...
Dialogue: 0,0:06:57.70,0:07:00.12,Default,,0,0,0,,Қалай болғанда да, армандардың оған қатысы бар емес пе?
Dialogue: 0,0:07:00.21,0:07:01.83,Default,,0,0,0,,Қандай түс көрдіңіз?
Dialogue: 0,0:07:01.92,0:07:04.71,Default,,0,0,0,,Ал, бұл не...
Dialogue: 0,0:07:04.79,0:07:06.50,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:06.59,0:07:08.97,Default,,0,0,0,,Ах~аа~!
Dialogue: 0,0:07:10.47,0:07:12.43,Default,,0,0,0,,Каоридің көңіл-күйді бұзғаны
Dialogue: 0,0:07:12.51,0:07:15.35,Default,,0,0,0,,Мм... Мен мұңайған азғын адам емеспін!
Dialogue: 0,0:07:16.68,0:07:20.02,Default,,0,0,0,,Енді бәріміз үйге орала аламыз...
Dialogue: 0,0:07:20.10,0:07:22.15,Default,,0,0,0,,Батырлар не істейді?
Dialogue: 0,0:07:22.23,0:07:23.69,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:07:23.77,0:07:26.77,Default,,0,0,0,,Мен өз бетіммен қашып құтыла алатынымды күтуім керек пе?
Dialogue: 0,0:07:26.86,0:07:29.19,Default,,0,0,0,,Қанша уақыт күтуім керек?
Dialogue: 0,0:07:29.28,0:07:31.45,Default,,0,0,0,,Тамақ ішуге және үзіліс жасауға жеткілікті уақыт.
Dialogue: 0,0:07:31.53,0:07:32.95,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:07:33.03,0:07:36.03,Default,,0,0,0,,Мен де қашу кезінде сиқырлы күшті көп пайдаландым.
Dialogue: 0,0:07:36.12,0:07:37.70,Default,,0,0,0,,Мен кішкене үзіліс алғым келеді
Dialogue: 0,0:07:43.62,0:07:45.88,Default,,0,0,0,,Мүмкін уақыт келді
Dialogue: 0,0:07:45.96,0:07:47.63,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:07:47.71,0:07:48.67,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:07:48.75,0:07:51.30,Default,,0,0,0,,Үзіліс қоспасаңыз, оның шегі жоқ.
Dialogue: 0,0:07:52.63,0:07:53.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:53.55,0:07:56.64,Default,,0,0,0,,Ах... бұл Кохаку - Шидзуку-чан!
Dialogue: 0,0:07:57.39,0:07:59.97,Default,,0,0,0,,Яэгаши ең жылдам болды.
Dialogue: 0,0:08:00.06,0:08:02.94,Default,,0,0,0,,Хмм, Шидзуку тұрақты адам.
Dialogue: 0,0:08:03.02,0:08:05.06,Default,,0,0,0,,Қалыпты дегенде, қалыпты деген сөз.
Dialogue: 0,0:08:06.40,0:08:08.02,Default,,0,0,0,,Шизуку Каваками, Курона Анку, Наширо
Dialogue: 0,0:08:09.53,0:08:10.69,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:08:11.19,0:08:12.36,Default,,0,0,0,,Каори?
Dialogue: 0,0:08:12.45,0:08:14.99,Default,,0,0,0,,Иә, бұл менмін, Шидзуку-чан.
Dialogue: 0,0:08:15.66,0:08:16.99,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:08:17.87,0:08:21.12,Default,,0,0,0,,Иә, қайтып келдіңіз.
Dialogue: 0,0:08:21.20,0:08:24.00,Default,,0,0,0,,Ха... Мен қатты шаршадым.
Dialogue: 0,0:08:24.08,0:08:25.58,Default,,0,0,0,,Сіз көп ұйықтадыңыз.
Dialogue: 0,0:08:25.67,0:08:26.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:26.58,0:08:29.42,Default,,0,0,0,,Бірақ сенің бұл тапсырманы орындағаныңа қуаныштымын.
Dialogue: 0,0:08:29.50,0:08:33.55,Default,,0,0,0,,үшін? Ах... Нагумо-кун...
Dialogue: 0,0:08:33.63,0:08:36.72,Default,,0,0,0,,Дұрыс... бәрінен де артық...
Dialogue: 0,0:08:38.22,0:08:40.89,Default,,0,0,0,,Шидзуку Бұл қандай арман болды?
Dialogue: 0,0:08:40.97,0:08:43.73,Default,,0,0,0,,Не? Жоқ...
Dialogue: 0,0:08:43.81,0:08:46.60,Default,,0,0,0,,Қарапайым арман, ерекше ештеңе жоқ.
Dialogue: 0,0:08:46.69,0:08:49.32,Default,,0,0,0,,Иә, бұл кәдімгі түс болатын.
Dialogue: 0,0:08:49.40,0:08:51.98,Default,,0,0,0,,Қалыпты? Кім шықты?
Dialogue: 0,0:08:52.07,0:08:53.19,Default,,0,0,0,,Гррр…
Dialogue: 0,0:08:53.69,0:08:55.49,Default,,0,0,0,,Бұл кім... бәрі!
Dialogue: 0,0:08:55.57,0:08:57.41,Default,,0,0,0,,үшін шықты!
Dialogue: 0,0:08:58.37,0:08:59.62,Default,,0,0,0,,Иә
Dialogue: 0,0:09:01.49,0:09:02.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:03.00,0:09:05.75,Default,,0,0,0,,Менің ханшайым болуым мүмкін емес.
Dialogue: 0,0:09:05.83,0:09:08.75,Default,,0,0,0,,Жалпы айтқанда, ол неге ханзада рөлін ойнайды...
Dialogue: 0,0:09:10.71,0:09:12.26,Default,,0,0,0,,Мен оны сұрадым, Каори.
Dialogue: 0,0:09:12.34,0:09:15.22,Default,,0,0,0,,Бүкіл денені бөлшектемеңіз.
Dialogue: 0,0:09:15.30,0:09:16.68,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:09:17.30,0:09:21.76,Default,,0,0,0,,Егер сіз нақты шайқаста болмасаңыз, бақылауды бұзу туралы алаңдамаудың қажеті жоқ.
Dialogue: 0,0:09:23.22,0:09:24.35,Default,,0,0,0,,Декомпозиция
Dialogue: 0,0:09:28.73,0:09:30.61,Default,,0,0,0,,Хмм... аа... Иә?
Dialogue: 0,0:09:30.69,0:09:34.90,Default,,0,0,0,,Каори? тастау? Мен екі бар екеніне сенімдімін ...
Dialogue: 0,0:09:34.99,0:09:37.91,Default,,0,0,0,,Хмм, бұл қайда?
Dialogue: 0,0:09:37.99,0:09:39.20,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:09:39.91,0:09:41.08,Default,,0,0,0,,Эри!
Dialogue: 0,0:09:41.16,0:09:45.71,Default,,0,0,0,,А...? Әй, солай... Эри ше?
Dialogue: 0,0:09:46.75,0:09:47.87,Default,,0,0,0,,Сузу-чан...
Dialogue: 0,0:09:48.83,0:09:51.29,Default,,0,0,0,,Ал... Меніңше, солай.
Dialogue: 0,0:09:52.75,0:09:53.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:53.67,0:09:55.30,Default,,0,0,0,,Үшеуіңіз жақсы ма?
Dialogue: 0,0:09:55.80,0:09:58.09,Default,,0,0,0,,Аманогава Танигучи
Dialogue: 0,0:09:58.18,0:09:59.89,Default,,0,0,0,,Уайымдауға уақыт жоқ
Dialogue: 0,0:09:59.97,0:10:01.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:02.26,0:10:03.39,Default,,0,0,0,,Дайын болыңыз
Dialogue: 0,0:10:03.47,0:10:05.39,Default,,0,0,0,,Әйтпесе сіздің үмітіңіз
Dialogue: 0,0:10:05.47,0:10:07.56,Default,,0,0,0,,Сөздің шын мағынасында жойылады.
Dialogue: 0,0:10:07.64,0:10:11.23,Default,,0,0,0,,А... аа, мен білемін.
Dialogue: 0,0:10:11.31,0:10:13.15,Default,,0,0,0,,-(Сузу) Иә, дұрыс. -(Рютаро) Иә.
Dialogue: 0,0:10:28.58,0:10:30.62,Default,,0,0,0,,Бұл жолы барлығы осында сияқты.
Dialogue: 0,0:10:30.71,0:10:32.42,Default,,0,0,0,,Хажиме, өтірікші кім?
Dialogue: 0,0:10:33.09,0:10:35.09,Default,,0,0,0,,Жоқ, жақсы сияқты.
Dialogue: 0,0:10:35.67,0:10:39.09,Default,,0,0,0,,Хмм, бұл шынымен жағымсыз сезім.
Dialogue: 0,0:10:39.18,0:10:43.01,Default,,0,0,0,,Иә, мен Оркус Ұлы лабиринтінде тұтқынға түскен кездегідей.
Dialogue: 0,0:10:43.10,0:10:46.39,Default,,0,0,0,,Шынында да, құбыжықтың белгісі мүлде жоқ.
Dialogue: 0,0:10:46.47,0:10:48.60,Default,,0,0,0,,Мен ештеңе бұлай жалғасады деп күтпедім.
Dialogue: 0,0:10:48.68,0:10:50.60,Default,,0,0,0,,Бұл жұмыс істемейді деп ойлаймын...
Dialogue: 0,0:10:51.56,0:10:53.65,Default,,0,0,0,,Иә? Жаңбыр жауып жатыр ма?
Dialogue: 0,0:10:53.73,0:10:56.61,Default,,0,0,0,,Бұл рас, ол пайда болады.
Dialogue: 0,0:10:57.11,0:10:58.78,Default,,0,0,0,,- (Сузу) Үлкен ағаштың ішінде болса да? -(Коуки) Бұл ағаштың ішінде!
Dialogue: 0,0:10:58.86,0:11:00.32,Default,,0,0,0,,Чит Юэ!
Dialogue: 0,0:11:00.40,0:11:01.99,Default,,0,0,0,,Хмм, Қасиетті Зецу!
Dialogue: 0,0:11:10.12,0:11:11.71,Default,,0,0,0,,Нагумо-кун, айнала...
Dialogue: 0,0:11:11.79,0:11:13.42,Default,,0,0,0,,Шлам?
Dialogue: 0,0:11:13.50,0:11:17.13,Default,,0,0,0,,Сиқырлы көздің тасы да байқай алмайтыны неткен жасырындық!
Dialogue: 0,0:11:18.13,0:11:20.05,Default,,0,0,0,,Нагумо! Бұл менің аяғымның астынан келді!
Dialogue: 0,0:11:20.13,0:11:21.34,Default,,0,0,0,,Хмм… Дегенмен, егер сол лас—
Dialogue: 0,0:11:21.43,0:11:23.68,Default,,0,0,0,,Бұл... бөлшектеу!
Dialogue: 0,0:11:24.47,0:11:25.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:25.51,0:11:28.68,Default,,0,0,0,,О! Ұстап қалмаңыз!
Dialogue: 0,0:11:29.77,0:11:30.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:30.89,0:11:32.56,Default,,0,0,0,,Эй, ақымақ Рютаро!
Dialogue: 0,0:11:32.65,0:11:33.81,Default,,0,0,0,,Бұл көп күш жұмсады.
Dialogue: 0,0:11:33.90,0:11:34.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:34.86,0:11:36.07,Default,,0,0,0,,- (қоңырау) Кяаа! -(Коуки/Шидзуку) Ах...
Dialogue: 0,0:11:36.15,0:11:39.65,Default,,0,0,0,,Уф... менің бүкіл денем дымқыл
Dialogue: 0,0:11:39.74,0:11:41.86,Default,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:11:41.95,0:11:43.74,Default,,0,0,0,,-(Сузу) Ху~ -(Рюутаро) Ммм...
Dialogue: 0,0:11:46.87,0:11:48.91,Default,,0,0,0,,Хмф!
Dialogue: 0,0:11:49.41,0:11:50.87,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:11:50.96,0:11:53.50,Default,,0,0,0,,Жақсысың ба? Шизу… Ку…
Dialogue: 0,0:11:53.58,0:11:56.34,Default,,0,0,0,,Иә, бәрібір, Коуки.
Dialogue: 0,0:11:56.42,0:11:58.75,Default,,0,0,0,,Бұл балалар таңқаларлық оңай өледі.
Dialogue: 0,0:11:58.84,0:12:00.42,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:00.51,0:12:02.97,Default,,0,0,0,,Не? жоқ?
Dialogue: 0,0:12:03.05,0:12:04.18,Default,,0,0,0,,Бұл ештеңе емес!
Dialogue: 0,0:12:04.26,0:12:06.35,Default,,0,0,0,,- (Коуки) О, ештеңе! -(Сидзуку) А?
Dialogue: 0,0:12:19.73,0:12:20.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:20.99,0:12:21.82,Default,,0,0,0,,Ах
Dialogue: 0,0:12:25.91,0:12:26.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:34.29,0:12:36.58,Default,,0,0,0,,Ммм... мм
Dialogue: 0,0:12:36.67,0:12:38.13,Default,,0,0,0,,- (Коуки) Ха... хааа - (Рюутаро) А... хмм...
Dialogue: 0,0:12:39.84,0:12:43.05,Default,,0,0,0,,Цк, сол балалар, кейінірек естеліктерді өткізіп жіберейік.
Dialogue: 0,0:12:47.05,0:12:49.22,Default,,0,0,0,,Юэ, мен тосқауыл сұраймын.
Dialogue: 0,0:12:49.31,0:12:51.93,Default,,0,0,0,,Төбеден бәрін өртеп жібер
Dialogue: 0,0:12:52.02,0:12:53.39,Default,,0,0,0,,Хмм, оны маған қалдырыңыз.
Dialogue: 0,0:12:57.40,0:12:59.73,Default,,0,0,0,,Ал, жақсы, жақсы.
Dialogue: 0,0:12:59.82,0:13:03.44,Default,,0,0,0,,Юэге де, басқаларға да лас трюк жасадыңыз!
Dialogue: 0,0:13:05.40,0:13:07.99,Default,,0,0,0,,Мен үшін бұл жақсы пісірілген.
Dialogue: 0,0:13:08.07,0:13:09.83,Default,,0,0,0,,Мен тосқауылды енді бұза аламын ба?
Dialogue: 0,0:13:09.91,0:13:12.24,Default,,0,0,0,,Жоқ, оны сәл ұзағырақ ұстаңыз.
Dialogue: 0,0:13:13.95,0:13:15.92,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:13:19.92,0:13:22.25,Default,,0,0,0,,-(Тамшылау) Ха ха... -(Қоңырау) Ух...
Dialogue: 0,0:13:24.76,0:13:25.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:28.68,0:13:29.60,Default,,0,0,0,,Иә, Юэ?
Dialogue: 0,0:13:29.68,0:13:31.93,Default,,0,0,0,,(Юэнің қатты тыныс алуы)
Dialogue: 0,0:13:32.01,0:13:33.27,Default,,0,0,0,,Хажиме...
Dialogue: 0,0:13:33.85,0:13:34.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:36.73,0:13:39.48,Default,,0,0,0,,Хаджиме Бірдеңе дұрыс емес...
Dialogue: 0,0:13:39.56,0:13:42.65,Default,,0,0,0,,Мен Хаджиманы қатты қалаймын...
Dialogue: 0,0:13:42.73,0:13:43.57,Default,,0,0,0,,О...
Dialogue: 0,0:13:43.65,0:13:45.90,Default,,0,0,0,,Әй... Эй Юэ? (Юэ ауыр тыныс алды)
Dialogue: 0,0:13:45.90,0:13:45.99,Default,,0,0,0,,(Юэнің қатты тыныс алуы)
Dialogue: 0,0:13:45.99,0:13:48.07,Default,,0,0,0,,Осындай жағдайда не айту керек?
Dialogue: 0,0:13:48.07,0:13:48.16,Default,,0,0,0,,(Юэнің қатты тыныс алуы)
Dialogue: 0,0:13:48.16,0:13:48.95,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:48.95,0:13:49.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:49.03,0:13:49.95,Default,,0,0,0,,Не болды? (киімдерді тартып алған дыбыс)
Dialogue: 0,0:13:50.03,0:13:51.58,Default,,0,0,0,,Ах! Хмм...
Dialogue: 0,0:13:51.66,0:13:54.20,Default,,0,0,0,,Ху... Хаджиме-сан
Dialogue: 0,0:13:54.29,0:13:57.12,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:13:57.21,0:13:59.08,Default,,0,0,0,,Е, сәл күте тұрыңыз.
Dialogue: 0,0:13:59.58,0:14:00.54,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:14:00.63,0:14:03.75,Default,,0,0,0,,(Каоридің ауыр тыныс алуы)
Dialogue: 0,0:14:03.84,0:14:06.26,Default,,0,0,0,,Хаджиме-кун, мен...
Dialogue: 0,0:14:06.34,0:14:08.01,Default,,0,0,0,,Ах... хмм
Dialogue: 0,0:14:08.09,0:14:09.55,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:14:09.64,0:14:12.60,Default,,0,0,0,,Фу фу…
Dialogue: 0,0:14:12.68,0:14:15.39,Default,,0,0,0,,Жоғалту... оған тұрарлық па?
Dialogue: 0,0:14:16.48,0:14:17.89,Default,,0,0,0,,(Цезарь) Не… Не болып жатыр? Бұл жігіттердің айналасындағы атмосфера…
Dialogue: 0,0:14:16.48,0:14:17.89,Default,,0,0,0,,А... а...
Dialogue: 0,0:14:17.89,0:14:17.98,Default,,0,0,0,,А... а...
Dialogue: 0,0:14:17.98,0:14:18.69,Default,,0,0,0,,А... а...
Dialogue: 0,0:14:17.98,0:14:18.69,Default,,0,0,0,,Сол шламның мәні осы ма?
Dialogue: 0,0:14:18.69,0:14:19.81,Default,,0,0,0,,Сол шламның мәні осы ма?
Dialogue: 0,0:14:20.52,0:14:21.90,Default,,0,0,0,,-Te! -(Рютаро) Уф!
Dialogue: 0,0:14:25.11,0:14:27.24,Default,,0,0,0,,Ұстаз, жақсысыз ба?
Dialogue: 0,0:14:27.32,0:14:29.24,Default,,0,0,0,,Әлгі құбыжықтың шламы болса керек
Dialogue: 0,0:14:29.32,0:14:31.41,Default,,0,0,0,,Ол күшті афродизиакқа айналған сияқты.
Dialogue: 0,0:14:31.49,0:14:32.32,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:32.41,0:14:36.58,Default,,0,0,0,,Ол тіпті сиқырды қолдануды тежейтін күшті ләззат әсері бар.
Dialogue: 0,0:14:36.66,0:14:41.83,Default,,0,0,0,,Ең қиыны - бұл шырыш арқылы болатын физикалық әсер емес.
Dialogue: 0,0:14:41.92,0:14:44.38,Default,,0,0,0,,Бұл психикалық әсер.
Dialogue: 0,0:14:44.46,0:14:46.01,Default,,0,0,0,,Біраз уақыт керек, бірақ
Dialogue: 0,0:14:46.09,0:14:48.80,Default,,0,0,0,,Мен мұны ақыл-ой күшіммен жеңе алатыныма сенімдімін.
Dialogue: 0,0:14:48.88,0:14:51.84,Default,,0,0,0,,Әй, сен неге сабырлысың?
Dialogue: 0,0:14:51.93,0:14:52.85,Default,,0,0,0,,Хмм?
Dialogue: 0,0:14:52.93,0:14:54.47,Default,,0,0,0,,Егер есімде дұрыс болса
Dialogue: 0,0:14:54.56,0:14:56.85,Default,,0,0,0,,Менің ойымша, сіз ең көп шомылған адамсыз...
Dialogue: 0,0:14:57.43,0:14:58.98,Default,,0,0,0,,Скит сияқты
Dialogue: 0,0:14:59.06,0:15:02.23,Default,,0,0,0,,Шырыштың әсері сабан адамның денесіне де әсер етеді.
Dialogue: 0,0:15:02.31,0:15:04.77,Default,,0,0,0,,Шындығында, мені денемді айналып өтіп жатқан ләззат мазалайды.
Dialogue: 0,0:15:04.86,0:15:07.61,Default,,0,0,0,,Өйткені мен сиқырды дұрыс пайдалана алмаймын.
Dialogue: 0,0:15:07.69,0:15:11.32,Default,,0,0,0,,Мені көп ренжітпеңіз, ұстаз.
Dialogue: 0,0:15:11.41,0:15:13.37,Default,,0,0,0,,Варава кім деп ойлайсың?
Dialogue: 0,0:15:13.45,0:15:14.53,Default,,0,0,0,,Ах... Тио!
Dialogue: 0,0:15:14.62,0:15:17.45,Default,,0,0,0,,Варава сіздің қожайыныңыздың қызметшісі!
Dialogue: 0,0:15:17.54,0:15:18.50,Default,,0,0,0,,Бұл ләззат дәрежесі
Dialogue: 0,0:15:18.58,0:15:22.67,Default,,0,0,0,,Қожаның маған берген азап деп аталатын ләззатымен салыстырғанда.
Dialogue: 0,0:15:22.75,0:15:25.88,Default,,0,0,0,,Жылы болудың да шегі бар!
Dialogue: 0,0:15:25.96,0:15:27.50,Default,,0,0,0,,Мен көрдім.
Dialogue: 0,0:15:27.59,0:15:31.09,Default,,0,0,0,,Тио-сан күткендей... Жоқ, бұл Кларус-сан.
Dialogue: 0,0:15:31.18,0:15:32.51,Default,,0,0,0,,Шынымды айтсам, менде жоқ.
Dialogue: 0,0:15:32.59,0:15:35.05,Default,,0,0,0,,Әзірше жақынырақ келмеуіңізді өтінемін?
Dialogue: 0,0:15:35.14,0:15:36.72,Default,,0,0,0,,Ке... Ардақты сөз ғой!
Dialogue: 0,0:15:36.81,0:15:38.35,Default,,0,0,0,,Және ол өз тегімен аталды ма?
Dialogue: 0,0:15:38.43,0:15:40.73,Default,,0,0,0,,Бұл керемет қашықтық сезімі!
Dialogue: 0,0:15:41.39,0:15:44.98,Default,,0,0,0,,Осы уақытта маған бейтаныс адамдай қарайтыныңызға сене алар емеспін!
Dialogue: 0,0:15:45.06,0:15:46.19,Default,,0,0,0,,Ах... Ма... Жаман.
Dialogue: 0,0:15:46.27,0:15:47.40,Default,,0,0,0,,Мен ләззатқа батып бара жатқандай сезінемін
Dialogue: 0,0:15:47.40,0:15:48.40,Default,,0,0,0,,Мен ләззатқа батып бара жатқандай сезінемін
Dialogue: 0,0:15:47.40,0:15:48.40,Default,,0,0,0,,Юэ Шиа Каори
Dialogue: 0,0:15:48.40,0:15:48.48,Default,,0,0,0,,Юэ Шиа Каори
Dialogue: 0,0:15:48.48,0:15:49.44,Default,,0,0,0,,Юэ Шиа Каори
Dialogue: 0,0:15:48.48,0:15:49.44,Default,,0,0,0,,Ах... аа~
Dialogue: 0,0:15:49.44,0:15:49.53,Default,,0,0,0,,Ах... Ах~
Dialogue: 0,0:15:49.53,0:15:50.61,Default,,0,0,0,,Ах... аа~
Dialogue: 0,0:15:49.53,0:15:50.61,Default,,0,0,0,,Балалар, сендер осы деңгейдегі құбыжықтарсыңдар.
Dialogue: 0,0:15:50.61,0:15:51.32,Default,,0,0,0,,Балалар, сендер осы деңгейдегі құбыжықтарсыңдар.
Dialogue: 0,0:15:51.40,0:15:53.16,Default,,0,0,0,,Олардың жақсылық жасауға мүмкіндігі жоқ.
Dialogue: 0,0:15:53.78,0:15:56.91,Default,,0,0,0,,Сіз әлі де есі дұрыс болуыңыз керек, солай ма?
Dialogue: 0,0:15:56.99,0:15:58.70,Default,,0,0,0,,Әрине
Dialogue: 0,0:15:58.79,0:16:01.33,Default,,0,0,0,,Ух... әрине.
Dialogue: 0,0:16:01.41,0:16:04.25,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:16:05.00,0:16:08.50,Default,,0,0,0,,Бұл жолы да сиқырмен шешу қиын шығар.
Dialogue: 0,0:16:08.59,0:16:11.76,Default,,0,0,0,,Бірақ бізде құдайдың суы бар.
Dialogue: 0,0:16:11.84,0:16:13.09,Default,,0,0,0,,Оны қолданып көргіңіз келе ме?
Dialogue: 0,0:16:13.18,0:16:14.89,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:16:14.97,0:16:15.84,Default,,0,0,0,,Міндетті емес
Dialogue: 0,0:16:15.93,0:16:17.05,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:16:17.55,0:16:18.51,Default,,0,0,0,,Иә
Dialogue: 0,0:16:24.14,0:16:26.36,Default,,0,0,0,,Соңында шыдай алдым.
Dialogue: 0,0:16:26.44,0:16:31.32,Default,,0,0,0,,Алтауымыз - мен, Юэ, Ся, Тио, Каори және Йэгаши.
Dialogue: 0,0:16:31.40,0:16:34.66,Default,,0,0,0,,Қарғыс атсын... Нагумо Бұл...
Dialogue: 0,0:16:35.16,0:16:36.66,Default,,0,0,0,,Ақаулық тудырды
Dialogue: 0,0:16:37.16,0:16:38.87,Default,,0,0,0,,Көмегің үшін рахмет, Нагумо.
Dialogue: 0,0:16:38.95,0:16:40.37,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:16:40.95,0:16:42.04,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:42.12,0:16:43.12,Default,,0,0,0,,(Жылау қоңырауы)
Dialogue: 0,0:16:43.12,0:16:44.96,Default,,0,0,0,,(Жылау қоңырауы)
Dialogue: 0,0:16:43.12,0:16:44.96,Default,,0,0,0,,Сузу Оны ұмытайық.
Dialogue: 0,0:16:44.96,0:16:45.04,Default,,0,0,0,,(Жылау қоңырауы)
Dialogue: 0,0:16:45.04,0:16:47.00,Default,,0,0,0,,(Жылау қоңырауы)
Dialogue: 0,0:16:45.04,0:16:47.00,Default,,0,0,0,,Көңілін қалдыру мүмкін емес.
Dialogue: 0,0:16:47.08,0:16:48.84,Default,,0,0,0,,Шизу Шизу ~
Dialogue: 0,0:16:48.92,0:16:51.21,Default,,0,0,0,,Жер асты кеңістігі...
Dialogue: 0,0:16:51.30,0:16:53.09,Default,,0,0,0,,Оған күмән жоқ...
Dialogue: 0,0:16:53.17,0:16:54.05,Default,,0,0,0,,Үлкен ағаш?
Dialogue: 0,0:16:54.13,0:16:56.26,Default,,0,0,0,,Дәл солай болады, солай емес пе?
Dialogue: 0,0:16:56.34,0:16:59.76,Default,,0,0,0,,Бұл үлкен ағаштың астындағы кеңістікті білдіреді ме?
Dialogue: 0,0:16:59.85,0:17:01.01,Default,,0,0,0,,Бірақ содан кейін
Dialogue: 0,0:17:01.10,0:17:03.27,Default,,0,0,0,,Жерде көрінген үлкен ағаш...
Dialogue: 0,0:17:03.35,0:17:06.56,Default,,0,0,0,,Хмм, бұл Ұлы ағаш Уа Альто.
Dialogue: 0,0:17:06.65,0:17:08.15,Default,,0,0,0,,Оған күмән жоқ
Dialogue: 0,0:17:08.23,0:17:10.98,Default,,0,0,0,,Жер асты діңінен өсетін бұтақтар
Dialogue: 0,0:17:11.07,0:17:13.94,Default,,0,0,0,,Бұл нағыз тамырлардың жер астында тереңірек екенін білдіреді.
Dialogue: 0,0:17:14.86,0:17:17.28,Default,,0,0,0,,Сонда жерде көрінетін бөлік болады
Dialogue: 0,0:17:17.36,0:17:22.12,Default,,0,0,0,,Бұл үлкен ағаштың ұшы ғана болған сияқты.
Dialogue: 0,0:17:22.12,0:17:23.29,Default,,0,0,0,,Бұл үлкен ағаштың ұшы ғана болған сияқты.
Dialogue: 0,0:17:22.12,0:17:23.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:23.87,0:17:27.21,Default,,0,0,0,,Мен мұны оның бір бөлігі деп ешқашан ойламадым.
Dialogue: 0,0:17:27.79,0:17:31.25,Default,,0,0,0,,Хмм... ол қаншалықты үлкен?
Dialogue: 0,0:17:31.34,0:17:33.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:33.76,0:17:34.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:35.55,0:17:37.51,Default,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,0:17:41.64,0:17:45.23,Default,,0,0,0,,Хм, қараңғы, мен жақсы көрмеймін.
Dialogue: 0,0:17:45.31,0:17:48.69,Default,,0,0,0,,Денеңізді нығайту арқылы көру қабілетін арттырыңыз...
Dialogue: 0,0:17:49.19,0:17:50.86,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:17:50.94,0:17:53.03,Default,,0,0,0,,Иә? ше? Ши
Dialogue: 0,0:17:53.11,0:17:56.45,Default,,0,0,0,,(шианың дірілдеген дауысы)
Dialogue: 0,0:17:56.45,0:17:57.28,Default,,0,0,0,,(шианың дірілдеген дауысы)
Dialogue: 0,0:17:56.45,0:17:57.28,Default,,0,0,0,,Хмм?
Dialogue: 0,0:17:57.28,0:17:59.24,Default,,0,0,0,,(шианың дірілдеген дауысы)
Dialogue: 0,0:18:00.37,0:18:01.33,Default,,0,0,0,,Хмм…
Dialogue: 0,0:18:08.17,0:18:09.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:08.17,0:18:09.17,Default,,0,0,0,,Джижи… Джи… Джи…
Dialogue: 0,0:18:09.17,0:18:09.25,Default,,0,0,0,,Джижи… Джи… Джи…
Dialogue: 0,0:18:09.25,0:18:11.50,Default,,0,0,0,,Джижи… Джи… Джи…
Dialogue: 0,0:18:09.25,0:18:11.50,Default,,0,0,0,,Ааа
Dialogue: 0,0:18:11.59,0:18:14.25,Default,,0,0,0,,Джи… Джижи… Джи… Г
Dialogue: 0,0:18:14.34,0:18:16.22,Default,,0,0,0,,Хажиме? не болды?
Dialogue: 0,0:18:16.30,0:18:17.38,Default,,0,0,0,,Хаджиме-кун?
Dialogue: 0,0:18:17.47,0:18:19.80,Default,,0,0,0,,Ұстаз, жақсысыз ба?
Dialogue: 0,0:18:21.55,0:18:22.72,Default,,0,0,0,,Ібіліс…
Dialogue: 0,0:18:22.81,0:18:24.35,Default,,0,0,0,,Ібіліс?
Dialogue: 0,0:18:24.43,0:18:27.27,Default,,0,0,0,,Мұнда шайтан бар. Шайтан бар.
Dialogue: 0,0:18:27.35,0:18:28.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:29.02,0:18:32.65,Default,,0,0,0,,Мм... бұл шайтан ба?
Dialogue: 0,0:18:33.23,0:18:36.36,Default,,0,0,0,,Жоқ... ол қатыгезірек.
Dialogue: 0,0:18:36.44,0:18:38.82,Default,,0,0,0,,Тозақ шайтаны көз емес.
Dialogue: 0,0:18:39.53,0:18:41.62,Default,,0,0,0,,Балалар сендер мұны жақсы білесіңдер.
Dialogue: 0,0:18:41.70,0:18:43.03,Default,,0,0,0,,Фалько…
Dialogue: 0,0:18:43.95,0:18:46.16,Default,,0,0,0,,Бұл асханадағы шайтан.
Dialogue: 0,0:18:52.50,0:18:53.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:53.67,0:18:54.55,Default,,0,0,0,,Маған не, не, не көрсетпексің?
Dialogue: 0,0:18:54.55,0:18:56.63,Default,,0,0,0,,Маған не, не, не көрсетпексің?
Dialogue: 0,0:18:54.55,0:18:56.63,Default,,0,0,0,,- (Коуки) Міне! -(Судзу) Г әрпі өте көп!
Dialogue: 0,0:18:56.63,0:18:58.01,Default,,0,0,0,,- (Коуки) Міне! -(Судзу) Г әрпі өте көп!
Dialogue: 0,0:18:58.09,0:19:02.18,Default,,0,0,0,,Сонымен... миллиондар, жоқ, ондаған миллиондар сан емес. Эй.
Dialogue: 0,0:19:02.26,0:19:03.51,Default,,0,0,0,,- (түсіру) Уау! -(Коуки) Эй!
Dialogue: 0,0:19:04.10,0:19:05.68,Default,,0,0,0,,Хаджиме Өртеп жіберейік!
Dialogue: 0,0:19:05.76,0:19:06.60,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:06.68,0:19:08.89,Default,,0,0,0,,Тек тоқтаған дұрыс емес пе?
Dialogue: 0,0:19:08.98,0:19:10.19,Default,,0,0,0,,Бұл сан.
Dialogue: 0,0:19:10.27,0:19:12.77,Default,,0,0,0,,Егер сізге көп жіберіп алған оқтар ұшып келсе, не істеу керек?
Dialogue: 0,0:19:12.86,0:19:13.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:16.98,0:19:18.11,Default,,0,0,0,,(Хане)
Dialogue: 0,0:19:18.11,0:19:18.94,Default,,0,0,0,,(Хане)
Dialogue: 0,0:19:18.11,0:19:18.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:19.03,0:19:25.28,Default,,0,0,0,,(Хане)
Dialogue: 0,0:19:26.70,0:19:29.00,Default,,0,0,0,,(Каоридің айқайы)
Dialogue: 0,0:19:29.08,0:19:30.50,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:33.38,0:19:34.79,Default,,0,0,0,,Найзағай айдаһар!
Dialogue: 0,0:19:35.50,0:19:38.34,Default,,0,0,0,,Мен оны жек көремін! Ұшып кетіңіз!
Dialogue: 0,0:19:38.42,0:19:41.26,Default,,0,0,0,,Сәлем! Бөлшектеу! Бөлшектеу!
Dialogue: 0,0:19:41.34,0:19:43.68,Default,,0,0,0,,Ку...ол келмейді!
Dialogue: 0,0:19:43.76,0:19:45.22,Default,,0,0,0,,Немесе... маған қоңырау шалыңыз!
Dialogue: 0,0:19:45.30,0:19:47.22,Default,,0,0,0,,Теттет... Тенсхаун!
Dialogue: 0,0:19:48.56,0:19:49.64,Default,,0,0,0,,Фуми…
Dialogue: 0,0:19:49.73,0:19:51.98,Default,,0,0,0,,Бұл... бұл киелі орын.
Dialogue: 0,0:19:52.06,0:19:54.98,Default,,0,0,0,,Ши... Шиши... Мен құдайдың жауынан өтемін~
Dialogue: 0,0:19:55.06,0:19:56.57,Default,,0,0,0,,Қасиетті Цетсу~
Dialogue: 0,0:20:07.74,0:20:09.54,Default,,0,0,0,,...
Dialogue: 0,0:20:09.62,0:20:12.33,Default,,0,0,0,,Қоңырау! Ұйықтама! Ұйықтасаң өлесің!
Dialogue: 0,0:20:12.41,0:20:14.88,Default,,0,0,0,,Біздің рухымыз!
Dialogue: 0,0:20:15.92,0:20:18.05,Default,,0,0,0,,Юэ, тағы да қорғауды сұра.
Dialogue: 0,0:20:18.13,0:20:20.26,Default,,0,0,0,,Хмм, мен оны бұзуға ешқашан жол бермеймін!
Dialogue: 0,0:20:23.26,0:20:27.18,Default,,0,0,0,,Әйтеуір, мен осы лабиринтке кіргеннен бері осындай жағдайлар болып жатыр.
Dialogue: 0,0:20:27.26,0:20:31.48,Default,,0,0,0,,Өйткені, ол басқа ұлы лабиринттерді бағындыру алғышарттарына негізделген.
Dialogue: 0,0:20:31.56,0:20:34.31,Default,,0,0,0,,Қиындық деңгейі бірнеше қадам жоғары орнатылған болуы мүмкін.
Dialogue: 0,0:20:34.39,0:20:37.98,Default,,0,0,0,,Rere... Сабырмен талдамаңыз. Біз бірдеңе істеуіміз керек!
Dialogue: 0,0:20:38.07,0:20:39.61,Default,,0,0,0,,Каори, жарайды.
Dialogue: 0,0:20:39.69,0:20:40.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:40.61,0:20:42.15,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:20:42.24,0:20:44.28,Default,,0,0,0,,Бұл қара күнжіт тұқымдары ғана.
Dialogue: 0,0:20:44.36,0:20:46.62,Default,,0,0,0,,Маған қара күнжіт пудингі қатты ұнайды...
Dialogue: 0,0:20:46.70,0:20:50.74,Default,,0,0,0,,Мен не істеуім керек? Шидзуку-чан қазірдің өзінде бұзылудың алдында тұр!
Dialogue: 0,0:20:51.25,0:20:54.00,Default,,0,0,0,,Шидзуку-чан! Шидзуку-чан!
Dialogue: 0,0:20:54.71,0:20:55.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:59.54,0:21:00.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:03.67,0:21:05.05,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:21:05.13,0:21:06.84,Default,,0,0,0,,Эй, эй, болмайды
Dialogue: 0,0:21:07.55,0:21:10.64,Default,,0,0,0,,Сиқырлы шеңбер құру...?
Dialogue: 0,0:21:13.98,0:21:15.06,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:18.81,0:21:24.74,Default,,0,0,0,,Гичичичи...
Dialogue: 0,0:21:25.24,0:21:27.03,Default,,0,0,0,,Tsk! Маған істеуге рұқсат етіңіз!
Dialogue: 0,0:21:27.11,0:21:27.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:28.03,0:21:28.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:31.45,0:21:34.29,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:21:37.96,0:21:39.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:39.88,0:21:41.55,Default,,0,0,0,,Хмм… Уф
Dialogue: 0,0:21:42.13,0:21:43.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:43.59,0:21:45.97,Default,,0,0,0,,Бірдеңе...
Dialogue: 0,0:21:46.68,0:21:47.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:49.93,0:21:50.97,Default,,0,0,0,,Юе
Dialogue: 0,0:21:52.01,0:21:53.06,Default,,0,0,0,,Хаджиме
Dialogue: 0,0:21:54.06,0:21:55.77,Default,,0,0,0,,Сіз туралы
Dialogue: 0,0:21:55.85,0:21:57.98,Default,,0,0,0,,Мен сені қатты жек көремін
Dialogue: 0,0:21:58.77,0:22:00.56,Default,,0,0,0,,Сіз туралы
Dialogue: 0,0:22:00.65,0:22:02.77,Default,,0,0,0,,Мен сені жек көретінім сонша, өлтіргім келеді.
Dialogue: 0,0:22:04.03,0:22:09.03,Default,,0,0,0,,♪～
Dialogue: 0,0:23:28.94,0:23:33.95,Default,,0,0,0,,～♪
Dialogue: 0,0:23:35.08,0:23:38.16,Default,,0,0,0,,Келесі жолы «Үміт менің қолымда»
Dialogue: 0,0:23:39.66,0:23:45.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
