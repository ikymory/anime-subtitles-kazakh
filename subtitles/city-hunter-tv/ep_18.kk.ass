Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:48.49,0:01:50.72,Default,,0,0,0,,Менің өмірімді мақсат еткен адамдар бар.
Dialogue: 0,0:01:51.39,0:01:53.02,Default,,0,0,0,,Бірақ сен уайымдама, Сенжуин
Dialogue: 0,0:01:53.72,0:01:56.62,Default,,0,0,0,,Құдай сізге сенімді қорғаушы жібереді.
Dialogue: 0,0:01:57.82,0:01:59.49,Default,,0,0,0,,Қамқоршы құдай дегеніміз не?
Dialogue: 0,0:02:00.19,0:02:04.52,Default,,0,0,0,,Белінде қалың қылыш бар, абыройлы жас жауынгер болып көрініңіз
Dialogue: 0,0:02:04.82,0:02:07.42,Default,,0,0,0,,А... құрметті жас жауынгер...
Dialogue: 0,0:02:16.66,0:02:17.92,Default,,0,0,0,,«Sun City қонақ үйі
Dialogue: 0,0:02:18.22,0:02:21.59,Default,,0,0,0,,Мен сені Мияби кафесінде күтемін»?
Dialogue: 0,0:02:23.62,0:02:25.56,Default,,0,0,0,,Бұл өте ескірген қолданба.
Dialogue: 0,0:02:30.09,0:02:32.56,Default,,0,0,0,,Je t'aime Мадмуазель
Dialogue: 0,0:02:32.69,0:02:34.32,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:02:35.79,0:02:36.36,Default,,0,0,0,,Рио
Dialogue: 0,0:02:36.82,0:02:38.92,Default,,0,0,0,,Хм, хош иісті хош иісті хош иісті
Dialogue: 0,0:02:39.12,0:02:41.42,Default,,0,0,0,,Бұл талғампаз Ямато Надешиконың өтініші.
Dialogue: 0,0:02:41.76,0:02:43.36,Default,,0,0,0,,Иә? Бұл
Dialogue: 0,0:02:43.82,0:02:46.69,Default,,0,0,0,,Моккори Оно Комачи-чан! Nngggung
Dialogue: 0,0:02:48.26,0:02:51.09,Default,,0,0,0,,Куууууууууууу қыздың алдында
Dialogue: 0,0:02:51.46,0:02:54.02,Default,,0,0,0,,Уау... бұл үлкен мәселе
Dialogue: 0,0:03:01.09,0:03:01.76,Default,,0,0,0,,Хехехе
Dialogue: 0,0:03:02.36,0:03:03.96,Default,,0,0,0,,Saateto
Dialogue: 0,0:03:04.59,0:03:06.79,Default,,0,0,0,,Әдемі Оно Комачи...
Dialogue: 0,0:03:07.56,0:03:09.49,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:03:09.56,0:03:10.15,Default,,0,0,0,,-хмм - дейін...
Dialogue: 0,0:03:10.52,0:03:11.42,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:03:11.59,0:03:12.19,Default,,0,0,0,,Ммм
Dialogue: 0,0:03:12.46,0:03:13.09,Default,,0,0,0,,Ng…
Dialogue: 0,0:03:13.32,0:03:15.02,Default,,0,0,0,,Нихихихичи…
Dialogue: 0,0:03:15.36,0:03:15.96,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:20.09,0:03:21.89,Default,,0,0,0,,Гех, қазіргі таңқаларлық
Dialogue: 0,0:03:22.39,0:03:24.72,Default,,0,0,0,,Хэйан дәуірінен бері өмір сүрген Онокомачи
Dialogue: 0,0:03:24.79,0:03:27.56,Default,,0,0,0,,Әй, әже, бұл дұрыс емес адам.
Dialogue: 0,0:03:27.89,0:03:29.19,Default,,0,0,0,,Мен сыпырушы емеспін
Dialogue: 0,0:03:29.52,0:03:31.62,Default,,0,0,0,,Мен ештеңе айтпаймын
Dialogue: 0,0:03:31.79,0:03:34.22,Default,,0,0,0,,Жоқ болды... Әй?
Dialogue: 0,0:03:34.29,0:03:37.12,Default,,0,0,0,,Белінде қалың қылыш бар жас жігіт
Dialogue: 0,0:03:38.99,0:03:40.96,Default,,0,0,0,,Алланың елшісі!
Dialogue: 0,0:03:41.02,0:03:42.99,Default,,0,0,0,,үшін? Аа, сен білесің бе?
Dialogue: 0,0:03:43.29,0:03:45.46,Default,,0,0,0,,Ей, эй, эй, эй, әже.
Dialogue: 0,0:03:45.72,0:03:46.52,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:03:46.86,0:03:49.29,Default,,0,0,0,,Әй, сен әлгі қарттың бетінен тізерлеп отырасың ба?
Dialogue: 0,0:03:49.36,0:03:50.26,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:50.29,0:03:51.66,Default,,0,0,0,,Ол бұзық.
Dialogue: 0,0:03:51.72,0:03:54.72,Default,,0,0,0,,Ахахахахахахахахахахахахә әже, кешіріңіз.
Dialogue: 0,0:03:54.99,0:03:55.52,Default,,0,0,0,,Ех
Dialogue: 0,0:03:55.76,0:03:57.26,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааа!
Dialogue: 0,0:03:57.32,0:03:58.42,Default,,0,0,0,,Зорлық – жұқпалы!
Dialogue: 0,0:03:58.52,0:03:59.46,Default,,0,0,0,,Не? Иә
Dialogue: 0,0:03:59.52,0:04:00.62,Default,,0,0,0,,Хикьяку емес пе?
Dialogue: 0,0:04:08.32,0:04:10.09,Default,,0,0,0,,Рио-сама, күте тұрыңыз!
Dialogue: 0,0:04:10.29,0:04:12.05,Default,,0,0,0,,Рио-сама, сәл күте тұрыңыз!
Dialogue: 0,0:04:12.29,0:04:15.96,Default,,0,0,0,,Өтінемін, менің жас сұлу ханшайымымды қорғаңыз.
Dialogue: 0,0:04:17.26,0:04:17.96,Default,,0,0,0,,Вакахиме…
Dialogue: 0,0:04:18.69,0:04:21.79,Default,,0,0,0,,Анықтама үшін, бұл жас ханшайым нешеде? бойдақ?
Dialogue: 0,0:04:22.12,0:04:22.89,Default,,0,0,0,,Охон
Dialogue: 0,0:04:23.39,0:04:25.15,Default,,0,0,0,,Ханшайым он жаста және сегізде.
Dialogue: 0,0:04:25.26,0:04:27.89,Default,,0,0,0,,Арамды білмейтін қызбын.
Dialogue: 0,0:04:29.05,0:04:30.92,Default,,0,0,0,,Мокко өзені Гене!
Dialogue: 0,0:04:33.82,0:04:37.66,Default,,0,0,0,,Бұл басқа адамдарды ханшайымнан аулақ ұстау үшін арнайы лифт.
Dialogue: 0,0:04:37.82,0:04:40.39,Default,,0,0,0,,Түсіндім, қораптағы қызды айтып тұрсың ба?
Dialogue: 0,0:04:40.56,0:04:43.49,Default,,0,0,0,,Жас ханшайым бала кезінен Құдайдың даусын естіген.
Dialogue: 0,0:04:43.52,0:04:46.39,Default,,0,0,0,,Қасиетті қыздың рухани күші оянды.
Dialogue: 0,0:04:46.42,0:04:50.02,Default,,0,0,0,,Қасиетті қыз? Қазіргі Жапонияда мұндай дүниелер әлі бар ма деп ойлаймын.
Dialogue: 0,0:04:50.39,0:04:52.12,Default,,0,0,0,,Саясаттағы министр класы
Dialogue: 0,0:04:52.29,0:04:55.62,Default,,0,0,0,,Бизнес әлемінен, бірінші дәрежелі листингілік компанияның президенті
Dialogue: 0,0:04:55.72,0:04:58.19,Default,,0,0,0,,Барлығы ханшайымның пайғамбарлығына сүйенеді.
Dialogue: 0,0:04:58.29,0:05:00.05,Default,,0,0,0,,Мен Жапонияның болашағына алаңдаймын
Dialogue: 0,0:05:03.46,0:05:04.62,Default,,0,0,0,,Хооо...
Dialogue: 0,0:05:05.66,0:05:07.62,Default,,0,0,0,,Мен ғимаратта мұндай жиын болады деп ойламаппын.
Dialogue: 0,0:05:23.72,0:05:25.79,Default,,0,0,0,,Сіз суық тиіп қаласыз ба? жас ханым
Dialogue: 0,0:05:28.22,0:05:29.05,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:05:29.82,0:05:30.39,Default,,0,0,0,,Уфу
Dialogue: 0,0:05:36.32,0:05:39.32,Default,,0,0,0,,Оооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооууууууууууууууоооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооо!
Dialogue: 0,0:05:39.49,0:05:41.66,Default,,0,0,0,,Тым таза
Dialogue: 0,0:05:42.79,0:05:44.52,Default,,0,0,0,,Сенжуин Бұл?
Dialogue: 0,0:05:44.92,0:05:49.76,Default,,0,0,0,,Иә, мен Рио Саебамын, Құдайдан жіберілген қамқоршы құдаймын.
Dialogue: 0,0:05:50.69,0:05:53.76,Default,,0,0,0,,Рахмет, Рио Саеба.
Dialogue: 0,0:05:54.12,0:05:56.22,Default,,0,0,0,,Жоқ, ахахахахаха
Dialogue: 0,0:05:56.79,0:05:59.69,Default,,0,0,0,,Әй, мен күй кешкенім сонша, босаңсымаймын.
Dialogue: 0,0:06:00.42,0:06:01.02,Default,,0,0,0,,Хмм?
Dialogue: 0,0:06:01.69,0:06:02.36,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:06:02.66,0:06:03.82,Default,,0,0,0,,Сарқырамадан аулақ болыңыз!
Dialogue: 0,0:06:14.92,0:06:16.02,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:06:16.15,0:06:18.12,Default,,0,0,0,,Біреу сарқырама арқылы электр тогын өткізді.
Dialogue: 0,0:06:18.52,0:06:19.46,Default,,0,0,0,,Бұл жерден қозғалма!
Dialogue: 0,0:06:30.49,0:06:32.72,Default,,0,0,0,,Эй... мынау епті егеуқұйрық.
Dialogue: 0,0:06:32.96,0:06:34.19,Default,,0,0,0,,Егеуқұйрық кім?
Dialogue: 0,0:06:34.26,0:06:35.92,Default,,0,0,0,,Бұл не екенін білесің бе?
Dialogue: 0,0:06:36.72,0:06:37.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:37.72,0:06:39.46,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:06:39.79,0:06:42.15,Default,,0,0,0,,Сәлем! Wow!
Dialogue: 0,0:06:42.36,0:06:44.56,Default,,0,0,0,,Дуоооооо
Dialogue: 0,0:06:44.79,0:06:46.96,Default,,0,0,0,,Ти аукккккккккккккккккккккккккк
Dialogue: 0,0:06:47.36,0:06:48.49,Default,,0,0,0,,Тегаа!
Dialogue: 0,0:06:52.62,0:06:55.05,Default,,0,0,0,,...
Dialogue: 0,0:06:56.66,0:06:57.66,Default,,0,0,0,,Хэ-хэ
Dialogue: 0,0:07:01.52,0:07:02.56,Default,,0,0,0,,Күту
Dialogue: 0,0:07:02.76,0:07:03.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:06.96,0:07:09.59,Default,,0,0,0,,Осындай ұсақ-түйек заттарды лақтыруға болмайды.
Dialogue: 0,0:07:10.02,0:07:11.36,Default,,0,0,0,,Бақыланады
Dialogue: 0,0:07:19.49,0:07:23.86,Default,,0,0,0,,Вакахимені нысанаға алған Диет мүшесі Канеда шығар.
Dialogue: 0,0:07:24.59,0:07:26.86,Default,,0,0,0,,Канеда? Бұл Q қоры?
Dialogue: 0,0:07:27.19,0:07:28.09,Default,,0,0,0,,Жарайды, бірінші кім?
Dialogue: 0,0:07:29.02,0:07:32.29,Default,,0,0,0,,Өздеріңіз білетіндей, екі жыл бұрын Queen Flight
Dialogue: 0,0:07:32.76,0:07:35.39,Default,,0,0,0,,Өзіміздің жойғыш ұшақтарымыз қабылдансын
Dialogue: 0,0:07:35.46,0:07:40.09,Default,,0,0,0,,Астрономиялық көлемдегі ақша министрлік деңгейінде әртүрлі тараптарға бөлінді.
Dialogue: 0,0:07:41.09,0:07:43.56,Default,,0,0,0,,Міне, биыл шу шығарды.
Dialogue: 0,0:07:43.59,0:07:47.05,Default,,0,0,0,,Королеваның ұшу күдігі Q қоры
Dialogue: 0,0:07:47.12,0:07:47.62,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:07:47.79,0:07:51.29,Default,,0,0,0,,Хмм Шындығында, күдік ашылғанға дейін, Канеда
Dialogue: 0,0:07:51.32,0:07:54.72,Default,,0,0,0,,Бірде мен бәрін жас ханшайымның қолына тапсырдым.
Dialogue: 0,0:08:04.15,0:08:06.76,Default,,0,0,0,,Ақ, нәзік шыңдардың тереңінде
Dialogue: 0,0:08:07.12,0:08:09.36,Default,,0,0,0,,Сіз мұздатылған алтын кесектерін көре аласыз
Dialogue: 0,0:08:09.79,0:08:11.15,Default,,0,0,0,,дейсіз бе?
Dialogue: 0,0:08:11.19,0:08:12.79,Default,,0,0,0,,Мм Канеда мырза
Dialogue: 0,0:08:13.05,0:08:15.52,Default,,0,0,0,,Ақ таояна шыңы - Альпі.
Dialogue: 0,0:08:15.82,0:08:18.29,Default,,0,0,0,,Басқаша айтқанда, Швейцария банкінде шот ашыңыз.
Dialogue: 0,0:08:18.52,0:08:21.99,Default,,0,0,0,,Q қорларын біраз уақытқа қатырып тастау оңай.
Dialogue: 0,0:08:22.26,0:08:23.52,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:23.92,0:08:25.26,Default,,0,0,0,,Құдай сөзі!
Dialogue: 0,0:08:25.56,0:08:27.76,Default,,0,0,0,,Юме Юмеге күмәнданба!
Dialogue: 0,0:08:28.39,0:08:28.96,Default,,0,0,0,,Хаха
Dialogue: 0,0:08:30.05,0:08:33.46,Default,,0,0,0,,Мен көремін. Сот скальпелі Q қорына енген кезде.
Dialogue: 0,0:08:33.86,0:08:36.86,Default,,0,0,0,,Құйрығынан жалғыз Қанеда ғана ұсталған жоқ па?
Dialogue: 0,0:08:37.32,0:08:39.89,Default,,0,0,0,,Жас ханшайым, былайша айтқанда, құтқарушы.
Dialogue: 0,0:08:40.02,0:08:44.49,Default,,0,0,0,,Осы кезеңде ашылып қала ма деп қорқып, жақсылығын жаумен өтеу...
Dialogue: 0,0:08:44.59,0:08:46.05,Default,,0,0,0,,Бұл қорқынышты дүние
Dialogue: 0,0:08:46.49,0:08:49.76,Default,,0,0,0,,Дұрыс, мойынымды сыртқа шығару ойыма да келмеді.
Dialogue: 0,0:08:53.46,0:08:54.19,Default,,0,0,0,,Рио-доно!
Dialogue: 0,0:08:54.86,0:08:55.89,Default,,0,0,0,,Бүркіттер шетке
Dialogue: 0,0:08:56.09,0:09:00.19,Default,,0,0,0,,Сол бейкүнә жас ханшайым жаудың улы азу тістерінің құрбаны болады.
Dialogue: 0,0:09:00.29,0:09:03.29,Default,,0,0,0,,Оны елемеуге болмайды.
Dialogue: 0,0:09:03.72,0:09:06.42,Default,,0,0,0,,Куаааа, адамдардың осал тұстары!
Dialogue: 0,0:09:11.39,0:09:14.66,Default,,0,0,0,,Мен құралдарды таңдамаймын, мен оны кейінірек кез келген жолмен сүртемін
Dialogue: 0,0:09:15.39,0:09:15.99,Default,,0,0,0,,Өшіру
Dialogue: 0,0:09:17.59,0:09:19.46,Default,,0,0,0,,Амансың ба? Кошинума
Dialogue: 0,0:09:20.32,0:09:21.42,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:09:21.92,0:09:23.99,Default,,0,0,0,,Жарайды, бірақ басқа адам Құдай, солай ма?
Dialogue: 0,0:09:24.15,0:09:28.26,Default,,0,0,0,,Хехе, 21 ғасыр жақындап қалған шақта не дейсіз?
Dialogue: 0,0:09:29.56,0:09:33.59,Default,,0,0,0,,Сіз мені Q қорынан не үшін жібергенімді ұмыттыңыз ба?
Dialogue: 0,0:09:33.99,0:09:34.79,Default,,0,0,0,,Ум...
Dialogue: 0,0:09:35.26,0:09:40.39,Default,,0,0,0,,Мен сені премьер-министрдің креслосына отырғызамын.
Dialogue: 0,0:09:40.79,0:09:42.46,Default,,0,0,0,,Өтінемін, Кошинума.
Dialogue: 0,0:09:43.26,0:09:44.82,Default,,0,0,0,,Хехехехехе
Dialogue: 0,0:09:53.69,0:09:56.82,Default,,0,0,0,,Ханшайым трансқа түседі.
Dialogue: 0,0:09:57.19,0:09:59.32,Default,,0,0,0,,Ах, бірақ екінші тарап өте нашар.
Dialogue: 0,0:09:59.69,0:10:01.66,Default,,0,0,0,,Неге дүкеніңді жауып, шетелге жүгірмейсің?
Dialogue: 0,0:10:02.05,0:10:05.52,Default,,0,0,0,,Рио-доно, мен сенетін жалғыз адамсың, жас ханшайым.
Dialogue: 0,0:10:05.99,0:10:07.76,Default,,0,0,0,,Құдайдың Құдайына сенбе
Dialogue: 0,0:10:08.29,0:10:08.89,Default,,0,0,0,,Га
Dialogue: 0,0:10:09.46,0:10:10.46,Default,,0,0,0,,Қауіпті! Жинап қою!
Dialogue: 0,0:10:10.72,0:10:11.29,Default,,0,0,0,,-ха -ху?
Dialogue: 0,0:10:11.39,0:10:11.96,Default,,0,0,0,,Сен сәл күдікті көрінесің, білесің бе.
Dialogue: 0,0:10:36.42,0:10:39.12,Default,,0,0,0,,Хе хе хе хе хе хе ешнәрсе қалмады
Dialogue: 0,0:10:39.46,0:10:41.22,Default,,0,0,0,,Бұл тікұшақта жылу датчигі бар.
Dialogue: 0,0:10:43.26,0:10:46.82,Default,,0,0,0,,Мен қабырғадан өтсем де, сенің қайда екеніңді көремін.
Dialogue: 0,0:10:56.32,0:10:57.56,Default,,0,0,0,,Хе хе хе
Dialogue: 0,0:11:05.86,0:11:08.19,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууу...
Dialogue: 0,0:11:16.15,0:11:18.69,Default,,0,0,0,,Олар не қажет болса да жасайды дейсіз бе?
Dialogue: 0,0:11:44.73,0:11:45.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:46.16,0:11:47.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:49.73,0:11:51.63,Default,,0,0,0,,Бұл жерде біраз уақыт өзіңізді қауіпсіз сезінесіз.
Dialogue: 0,0:11:53.16,0:11:55.49,Default,,0,0,0,,Бұл өте пайдалы, Рио-доно.
Dialogue: 0,0:11:56.39,0:11:59.19,Default,,0,0,0,,Олай болса да, Ойтавашия, жас ханшайым
Dialogue: 0,0:12:00.16,0:12:02.39,Default,,0,0,0,,Бала кезінен Алла жолына арналады
Dialogue: 0,0:12:02.46,0:12:05.73,Default,,0,0,0,,Сіз әлем үшін және адамдар үшін бәрін жасадыңыз.
Dialogue: 0,0:12:05.86,0:12:08.49,Default,,0,0,0,,Уф! Оны тым көп айту тым көп!
Dialogue: 0,0:12:08.59,0:12:10.19,Default,,0,0,0,,Ба-ба-чан
Dialogue: 0,0:12:10.76,0:12:11.39,Default,,0,0,0,,Сонда не?
Dialogue: 0,0:12:11.56,0:12:15.26,Default,,0,0,0,,Ендеше, кішкентай кезіңізден неге сонша еңбек еттіңіз? Чихиме-чан
Dialogue: 0,0:12:15.56,0:12:18.46,Default,,0,0,0,,Иә! Бұл менің бала кезімнен
Dialogue: 0,0:12:18.66,0:12:22.86,Default,,0,0,0,,Мен 3 жасымда зорлық-зомбылығымен танымал киелі таудың басына шықтым.
Dialogue: 0,0:12:23.49,0:12:26.26,Default,,0,0,0,,Ендеше, бұл қандай махаббат?
Dialogue: 0,0:12:26.33,0:12:28.23,Default,,0,0,0,,Хмм! Өлімге мүмкіндік жоқ!
Dialogue: 0,0:12:28.46,0:12:31.83,Default,,0,0,0,,Тәңірлерге қызмет ететін ғибадатхана қыз үшін ер адамдар шектен шығады!
Dialogue: 0,0:12:31.89,0:12:33.46,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:37.03,0:12:38.66,Default,,0,0,0,,Бірақ келіңіз, әже.
Dialogue: 0,0:12:38.69,0:12:39.99,Default,,0,0,0,,Бұл Сенжуин!
Dialogue: 0,0:12:40.36,0:12:41.93,Default,,0,0,0,,Олай болса, Сенжуин әже.
Dialogue: 0,0:12:41.96,0:12:43.23,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:12:43.39,0:12:47.83,Default,,0,0,0,,Жарайды, 18 жаста болсаң, сенің бір-екі жігітің бар шығар.
Dialogue: 0,0:12:47.86,0:12:49.59,Default,,0,0,0,,Сәлем! Бұл болмайды
Dialogue: 0,0:12:49.66,0:12:52.36,Default,,0,0,0,,Қасиетті қыздың ең үлкен дұшпаны – махаббат.
Dialogue: 0,0:12:52.63,0:12:55.06,Default,,0,0,0,,Мен мырзаға ғашық болған күнім,
Dialogue: 0,0:12:55.13,0:12:57.83,Default,,0,0,0,,Ол да ғибадатхана қыз ретінде өзінің рухани күшін жоғалтады!
Dialogue: 0,0:12:59.66,0:13:00.63,Default,,0,0,0,,Моттайнай...
Dialogue: 0,0:13:02.03,0:13:03.96,Default,,0,0,0,,Рио-сама? Сүлгіні қайда қою керек?
Dialogue: 0,0:13:04.19,0:13:04.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:04.93,0:13:05.66,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:05.73,0:13:07.43,Default,,0,0,0,,Кааааа!
Dialogue: 0,0:13:07.46,0:13:08.99,Default,,0,0,0,,-Шөлдеу, шөлдеу, шөлдеу! -Adaadaadaadaadaadaa
Dialogue: 0,0:13:10.63,0:13:11.59,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:14.29,0:13:15.26,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:15.66,0:13:20.03,Default,,0,0,0,,Тұрмысқа шықпаған қыз ешқашан күйеуіне терісін көрсетпеуі керек.
Dialogue: 0,0:13:20.09,0:13:21.13,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:13:21.89,0:13:23.33,Default,,0,0,0,,Ах... Иә...
Dialogue: 0,0:13:37.29,0:13:38.53,Default,,0,0,0,,Әй, Рё-сама!
Dialogue: 0,0:13:40.39,0:13:40.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:40.99,0:13:42.93,Default,,0,0,0,,-Ааа! -Ааа!
Dialogue: 0,0:13:44.09,0:13:44.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:47.09,0:13:47.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:49.69,0:13:51.63,Default,,0,0,0,,-Хаа… -мммммммммммм
Dialogue: 0,0:13:52.43,0:13:57.43,Default,,0,0,0,,Фунифуунифуун фугага фуиуфу фуиуфу фуиуфу
Dialogue: 0,0:14:03.36,0:14:03.93,Default,,0,0,0,,Хмм?
Dialogue: 0,0:14:05.49,0:14:06.13,Default,,0,0,0,,Не?
Dialogue: 0,0:14:09.49,0:14:09.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:10.23,0:14:12.73,Default,,0,0,0,,Құрметті Рё, мен қорқынышты түс көрдім.
Dialogue: 0,0:14:13.26,0:14:14.53,Default,,0,0,0,,Маған жаныңда ұйықтауға рұқсат етіңіз.
Dialogue: 0,0:14:14.56,0:14:15.09,Default,,0,0,0,,О...
Dialogue: 0,0:14:16.39,0:14:16.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:17.33,0:14:17.83,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:18.29,0:14:18.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:19.36,0:14:20.16,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:14:20.66,0:14:21.63,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:14:22.93,0:14:24.93,Default,,0,0,0,,Ах хааа...
Dialogue: 0,0:14:25.79,0:14:29.79,Default,,0,0,0,,Эй, Вакахиме-чан, бұл еркектерге жақындамау керек дегеннен айырмашылығы жоқ па?
Dialogue: 0,0:14:30.46,0:14:31.83,Default,,0,0,0,,Рио-сама ерекше.
Dialogue: 0,0:14:32.39,0:14:33.96,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:14:33.99,0:14:35.29,Default,,0,0,0,,Құдайдың елшісі
Dialogue: 0,0:14:35.46,0:14:37.16,Default,,0,0,0,,Уф, мен оны білдім...
Dialogue: 0,0:14:45.06,0:14:46.89,Default,,0,0,0,,күрсіну... Мм.
Dialogue: 0,0:14:48.09,0:14:50.16,Default,,0,0,0,,Хмм, а?
Dialogue: 0,0:14:54.93,0:14:56.36,Default,,0,0,0,,Ол жақсы ұйықтайды.
Dialogue: 0,0:15:02.59,0:15:06.76,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:15:08.09,0:15:10.99,Default,,0,0,0,,А... жыланды өлтіру...
Dialogue: 0,0:15:11.03,0:15:13.43,Default,,0,0,0,,Қайырлы таң Рё... Ах!
Dialogue: 0,0:15:14.56,0:15:16.26,Default,,0,0,0,,Уууунннннн!
Dialogue: 0,0:15:17.09,0:15:18.83,Default,,0,0,0,,Рё! Сен кімсің!
Dialogue: 0,0:15:18.89,0:15:20.83,Default,,0,0,0,,Бұл түсінбеушілік! Бұл түсінбеушілік!
Dialogue: 0,0:15:23.26,0:15:27.06,Default,,0,0,0,,Әй, Райо Құдайдың елшісі.
Dialogue: 0,0:15:27.59,0:15:30.16,Default,,0,0,0,,А, иә, бұл Құдайдан келген хабар.
Dialogue: 0,0:15:34.46,0:15:35.43,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:15:35.93,0:15:39.03,Default,,0,0,0,,Кеше ғимаратты жарып жіберген тікұшақ туралы еш жерде ештеңе жоқ.
Dialogue: 0,0:15:39.89,0:15:41.46,Default,,0,0,0,,дейсіз бе?
Dialogue: 0,0:15:41.53,0:15:43.79,Default,,0,0,0,,Тіпті полиция да көмектесе алмайды.
Dialogue: 0,0:15:43.96,0:15:44.79,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:44.89,0:15:47.66,Default,,0,0,0,,Олай болса, Құдайға ең көп арқа сүйейтін жер осы ма?
Dialogue: 0,0:15:47.83,0:15:50.43,Default,,0,0,0,,Рё: қалжыңдасаң ше? о?
Dialogue: 0,0:15:50.89,0:15:54.73,Default,,0,0,0,,Қаншалықты ұлы қызметші болсаң да, Құдайдың алдында тұра алмайсың.
Dialogue: 0,0:15:55.26,0:15:57.93,Default,,0,0,0,,Әй, солай емес пе? Чихиме-чан
Dialogue: 0,0:15:58.26,0:15:58.79,Default,,0,0,0,,Иә
Dialogue: 0,0:15:59.73,0:16:01.59,Default,,0,0,0,,Сенгендер құтқарылады
Dialogue: 0,0:16:07.09,0:16:10.23,Default,,0,0,0,,Кем дегенде қайталап көріңіз! Тағы бір мүмкіндік!
Dialogue: 0,0:16:10.56,0:16:11.36,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:16:11.53,0:16:15.53,Default,,0,0,0,,Сіз соншалықты қабілетсіз екенсіз, соншалықты керемет нәрсе жасап, жас ханшайымның қашып кетуіне мүмкіндік бере аласыз!
Dialogue: 0,0:16:15.59,0:16:16.26,Default,,0,0,0,,Сіз жұмыстан босатылдыңыз!
Dialogue: 0,0:16:19.23,0:16:22.66,Default,,0,0,0,,Егер Q қоры туралы факт Вакахимеден ағып кетсе ше?
Dialogue: 0,0:16:22.73,0:16:25.19,Default,,0,0,0,,Премьер-министр Премьер-министрдің де арманы орындалмай қалады
Dialogue: 0,0:16:25.36,0:16:28.39,Default,,0,0,0,,Уайымдамаңыз, сіз әлі де жасай алатын нәрселер бар.
Dialogue: 0,0:16:29.26,0:16:32.46,Default,,0,0,0,,Канеда мырза, сіз бұл елді басқаратын адамсыз, солай ма?
Dialogue: 0,0:16:43.73,0:16:46.69,Default,,0,0,0,,Иә, иә, иә, сәл күте тұрыңыз.
Dialogue: 0,0:16:47.73,0:16:48.49,Default,,0,0,0,,Канеда мырза
Dialogue: 0,0:16:49.33,0:16:50.13,Default,,0,0,0,,Канеда, бірақ...
Dialogue: 0,0:16:52.16,0:16:53.49,Default,,0,0,0,,Сәлеметсіз бе, Канеда?
Dialogue: 0,0:16:53.86,0:16:55.19,Default,,0,0,0,,Мен жас ханшайыммын.
Dialogue: 0,0:16:55.49,0:16:56.66,Default,,0,0,0,,Не?
Dialogue: 0,0:16:56.93,0:16:59.86,Default,,0,0,0,,Ұстазымның бақытын айтып жүргенімде, жолы болмайтын триграмма таптым...
Dialogue: 0,0:17:00.36,0:17:02.93,Default,,0,0,0,,Қаласаңыз, бізге бір рет келіңіз.
Dialogue: 0,0:17:03.16,0:17:05.36,Default,,0,0,0,,Мен қазір бос емеспін, сондықтан бара алмаймын.
Dialogue: 0,0:17:05.96,0:17:08.19,Default,,0,0,0,,Әйел апаты, су апаты, өрт апаты
Dialogue: 0,0:17:09.03,0:17:10.19,Default,,0,0,0,,Және жойылу
Dialogue: 0,0:17:10.89,0:17:13.59,Default,,0,0,0,,Армандаңыз және ешқашан сеніміңізді елемеңіз...
Dialogue: 0,0:17:15.36,0:17:16.59,Default,,0,0,0,,Не болды? Эй...
Dialogue: 0,0:17:17.56,0:17:18.96,Default,,0,0,0,,Моши Моши Моши Моши
Dialogue: 0,0:17:33.56,0:17:34.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:39.96,0:17:42.46,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:17:43.86,0:17:44.56,Default,,0,0,0,,Ой...
Dialogue: 0,0:17:46.13,0:17:46.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:46.99,0:17:48.33,Default,,0,0,0,,Кяаа!
Dialogue: 0,0:17:48.36,0:17:50.59,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:50.99,0:17:52.19,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:53.06,0:17:54.36,Default,,0,0,0,,Сіз оны қанша уақыттан бері қарайсыз?
Dialogue: 0,0:17:54.39,0:17:56.33,Default,,0,0,0,,Не? Шығу!
Dialogue: 0,0:17:56.49,0:17:57.93,Default,,0,0,0,,Мен сенен менің артымнан тазалауды өтіндім!
Dialogue: 0,0:17:57.96,0:17:59.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:05.76,0:18:08.69,Default,,0,0,0,,Қалай ойлайсыз, бұл әйелдердің проблемасы ма? Бұл ақымақ...
Dialogue: 0,0:18:18.39,0:18:19.96,Default,,0,0,0,,Бұл судың зақымдануы ма?
Dialogue: 0,0:18:22.66,0:18:25.03,Default,,0,0,0,,Құдайдың хабарын мойынсұнып тыңда.
Dialogue: 0,0:18:25.49,0:18:27.96,Default,,0,0,0,,А-а-а-а-а...
Dialogue: 0,0:18:29.29,0:18:30.53,Default,,0,0,0,,Ха-хэ
Dialogue: 0,0:18:33.33,0:18:37.46,Default,,0,0,0,,Ах, хехе? Бұл Құдайдың хабары ма? Ақымақ...
Dialogue: 0,0:18:44.39,0:18:46.63,Default,,0,0,0,,Мен қатты қорқамын...
Dialogue: 0,0:18:47.19,0:18:51.33,Default,,0,0,0,,Әлде өрт апаты... және қирау ма? Уф...
Dialogue: 0,0:18:54.99,0:18:58.43,Default,,0,0,0,,Хе хе хи хи хи хи...
Dialogue: 0,0:18:58.63,0:19:01.16,Default,,0,0,0,,Иә? а? Сенсей Канеда... Ах...
Dialogue: 0,0:19:01.49,0:19:02.86,Default,,0,0,0,,Ух-хэ-хэ-хэ
Dialogue: 0,0:19:10.53,0:19:13.99,Default,,0,0,0,,Уа хи хи хи хи хи хи
Dialogue: 0,0:19:14.36,0:19:15.99,Default,,0,0,0,,Қош келдіңіз, келгеніңізге рахмет.
Dialogue: 0,0:19:16.13,0:19:18.59,Default,,0,0,0,,Жүр, сені ханшайым күтіп тұр.
Dialogue: 0,0:19:18.79,0:19:19.66,Default,,0,0,0,,Ааа...
Dialogue: 0,0:19:27.79,0:19:32.93,Default,,0,0,0,,Әй, жас ханшайым, бұл шынымен де менің күйрегенім бе? Өтінемін, айтыңызшы...
Dialogue: 0,0:19:33.19,0:19:35.29,Default,,0,0,0,,Біз неден қорқуымыз керек?
Dialogue: 0,0:19:35.69,0:19:39.59,Default,,0,0,0,,Құдайды құрметтеп, айтқанымды орындасаң,
Dialogue: 0,0:19:39.93,0:19:41.06,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:19:41.39,0:19:42.46,Default,,0,0,0,,Юю, мені кешіріңіз
Dialogue: 0,0:19:42.89,0:19:45.69,Default,,0,0,0,,Мен Құдайдың еркіне бағынбадым...
Dialogue: 0,0:19:45.76,0:19:47.23,Default,,0,0,0,,Міне, осылай!
Dialogue: 0,0:19:48.06,0:19:48.76,Default,,0,0,0,,Мұғалім!
Dialogue: 0,0:19:49.19,0:19:49.76,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:50.66,0:19:52.26,Default,,0,0,0,,Бұл жерде болды ма?
Dialogue: 0,0:19:52.86,0:19:53.93,Default,,0,0,0,,Ко Кошинума!
Dialogue: 0,0:19:54.29,0:19:56.56,Default,,0,0,0,,Бүркіт Құдайдың қаһарына ұшырады.
Dialogue: 0,0:19:56.93,0:19:58.66,Default,,0,0,0,,Өзі де мұғалім болған адам
Dialogue: 0,0:19:58.83,0:20:01.19,Default,,0,0,0,,Мен бұл кішкентай қыздың айласына түсіп қаламын деп ойламаппын!
Dialogue: 0,0:20:01.23,0:20:02.76,Default,,0,0,0,,Бұл сіздің ойыңызды қалдырады!
Dialogue: 0,0:20:03.39,0:20:03.93,Default,,0,0,0,,Хун
Dialogue: 0,0:20:04.46,0:20:05.03,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:05.69,0:20:08.76,Default,,0,0,0,,Хмм, бұл Құдайдан келген хабар ма? кішкентай
Dialogue: 0,0:20:09.29,0:20:12.26,Default,,0,0,0,,Мұны жасамаңыз. Өкінсеңіз де, білмейсіз.
Dialogue: 0,0:20:12.73,0:20:13.73,Default,,0,0,0,,Құдайдың жазасы?
Dialogue: 0,0:20:14.69,0:20:16.26,Default,,0,0,0,,Қолыңнан келсе, істе!
Dialogue: 0,0:20:18.63,0:20:19.19,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:20:20.66,0:20:21.43,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:20:26.66,0:20:27.19,Default,,0,0,0,,Әй
Dialogue: 0,0:20:37.23,0:20:39.19,Default,,0,0,0,,Уа, ау!
Dialogue: 0,0:20:39.23,0:20:42.29,Default,,0,0,0,,Ой-о-о…
Dialogue: 0,0:20:42.46,0:20:43.29,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:20:44.16,0:20:46.96,Default,,0,0,0,,О, өтінемін, мені кешіріңіз!
Dialogue: 0,0:20:51.53,0:20:53.93,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу болуыма көмектес
Dialogue: 0,0:20:53.99,0:20:56.96,Default,,0,0,0,,Өтінемін, маған көмектесіңізші!
Dialogue: 0,0:20:57.83,0:21:02.13,Default,,0,0,0,,Құдайды бұрынғыдай құрметтеңіз және қажетсіз нәрселерге алаңдамаңыз.
Dialogue: 0,0:21:02.63,0:21:04.83,Default,,0,0,0,,Сосын барлығын суға жіберіңіз.
Dialogue: 0,0:21:05.19,0:21:06.66,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:07.26,0:21:09.03,Default,,0,0,0,,Құдай жомарт
Dialogue: 0,0:21:09.29,0:21:11.49,Default,,0,0,0,,Аа, жылы сөздеріңізге рахмет!
Dialogue: 0,0:21:14.96,0:21:17.09,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:21:17.26,0:21:18.99,Default,,0,0,0,,Хмм, не болды? Әже
Dialogue: 0,0:21:19.03,0:21:20.66,Default,,0,0,0,,Менің артымнан жүр!
Dialogue: 0,0:21:20.69,0:21:21.96,Default,,0,0,0,,-Асығыңыз! -Не?
Dialogue: 0,0:21:25.63,0:21:27.59,Default,,0,0,0,,Такуу Таңертең ерте
Dialogue: 0,0:21:27.63,0:21:29.33,Default,,0,0,0,,Осыны оқыңыз
Dialogue: 0,0:21:29.46,0:21:30.03,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:31.86,0:21:32.43,Default,,0,0,0,,Хун
Dialogue: 0,0:21:33.66,0:21:37.63,Default,,0,0,0,,Сенжуин, сен бізге көптен бері жақсы қызмет еттің.
Dialogue: 0,0:21:38.26,0:21:41.33,Default,,0,0,0,,Қасиетті қыз ретінде менің күшім жоқ.
Dialogue: 0,0:21:42.19,0:21:45.63,Default,,0,0,0,,Көзімді жұмсам да, Рио-саманың жүзі ғана көрінеді.
Dialogue: 0,0:21:48.99,0:21:53.49,Default,,0,0,0,,Мен... Мен өз өмірімді қайтадан табуға тырысамын деп ойлаймын.
Dialogue: 0,0:21:54.43,0:21:58.59,Default,,0,0,0,,Сенжуин Сенің де өз өмірің бар...
Dialogue: 0,0:21:59.19,0:22:02.13,Default,,0,0,0,,Aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaah, I guess I’m in time...
Dialogue: 0,0:22:02.16,0:22:05.09,Default,,0,0,0,,Керемет емес пе? Мен әйел ретінде осылай бақыттымын.
Dialogue: 0,0:22:05.13,0:22:06.16,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:22:06.39,0:22:09.93,Default,,0,0,0,,Жапонияның болашағын кім болжауы керек?
Dialogue: 0,0:22:10.09,0:22:11.93,Default,,0,0,0,,Жарайды, жарайды, әже.
Dialogue: 0,0:22:12.16,0:22:15.49,Default,,0,0,0,,Хмм? сен! Бұл бала қолы
Dialogue: 0,0:22:15.56,0:22:18.43,Default,,0,0,0,,Сол бет-әлпет пен дене әйелге тән әсер қалдырмайды.
Dialogue: 0,0:22:18.46,0:22:22.03,Default,,0,0,0,,Одан да бұл атмосфераның ер адамдармен байланысы жоқ сияқты!
Dialogue: 0,0:22:22.06,0:22:23.36,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:22:23.39,0:22:26.19,Default,,0,0,0,,Сіз! Пожалуйста, ғибадатхананың қызын жаттықтырыңыз!
Dialogue: 0,0:22:26.36,0:22:27.56,Default,,0,0,0,,Бұл сұмдық!
Dialogue: 0,0:22:30.26,0:22:32.36,Default,,0,0,0,,Кәрі қаңбақ көзінде жамандық жоқ!
Dialogue: 0,0:22:32.39,0:22:34.19,Default,,0,0,0,,Солай етіңіз!
Dialogue: 0,0:22:34.23,0:22:36.13,Default,,0,0,0,,-Мм! -Апыр-ай! Райо Рё!
Dialogue: 0,0:22:36.16,0:22:37.19,Default,,0,0,0,,Мен сені жібермеймін!
Dialogue: 0,0:22:37.49,0:22:40.43,Default,,0,0,0,,Сіз өз қоңырауыңызды таптыңыз ба?
Dialogue: 0,0:22:40.63,0:22:41.19,Default,,0,0,0,,Джу!
Dialogue: 0,0:22:42.09,0:22:43.63,Default,,0,0,0,,Рионың ақымақ!
Dialogue: 0,0:24:09.39,0:24:10.89,Default,,0,0,0,,Қанша қорқытатын хат алсам да,
Dialogue: 0,0:24:11.13,0:24:14.13,Default,,0,0,0,,Тыңдауға жақын қыздармен оқу-жаттығу жиыны! Қандай өтініш!
Dialogue: 0,0:24:14.19,0:24:17.79,Default,,0,0,0,,Бұл жағажайда тек білетіндер ғана кездеседі, менде қатты махаббат сезімі бар.
Dialogue: 0,0:24:17.99,0:24:19.29,Default,,0,0,0,,Есіңізде болсын, бұл бизнес.
Dialogue: 0,0:24:19.33,0:24:22.93,Default,,0,0,0,,Әйелдер неғұрлым әдемі болса, соғұрлым ұлан күшті болады! Мына жанып тұрған көздерге қара!
Dialogue: 0,0:24:22.96,0:24:24.26,Default,,0,0,0,,Тек қыздар көрсетіледі!
Dialogue: 0,0:24:24.29,0:24:26.89,Default,,0,0,0,,Жарайды, 20 сұлу әйел болғанда, мен абдырап қаламын.
Dialogue: 0,0:24:26.93,0:24:29.13,Default,,0,0,0,,Күтілгендей... 20 100 тонналық балға әкеліңіз.
Dialogue: 0,0:24:29.16,0:24:29.96,Default,,0,0,0,,Қалалық аңшы
Dialogue: 0,0:24:30.03,0:24:33.03,Default,,0,0,0,,«Естеліктер жағажайы - тыңдаулар қауіпке толы»
Dialogue: 0,0:24:33.16,0:24:34.09,Default,,0,0,0,,Көру керек
Dialogue: 0,0:24:35.59,0:24:41.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory