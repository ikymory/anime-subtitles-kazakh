Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:30.78,0:00:37.41,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:37.49,0:00:41.58,Default,,0,0,0,,Оның қашықтығы уақытқа қуат береді
Dialogue: 0,0:00:42.95,0:00:44.25,Default,,0,0,0,,Қашықтық
Dialogue: 0,0:00:45.25,0:00:47.29,Default,,0,0,0,,Адамның құндылығын анықтау
Dialogue: 0,0:00:48.29,0:00:52.26,Default,,0,0,0,,Мен сол қашықтық үшін өз өмірімді қатерге тігідім
Dialogue: 0,0:00:53.84,0:00:54.97,Default,,0,0,0,,Қашықтық
Dialogue: 0,0:00:56.01,0:00:57.59,Default,,0,0,0,,100 метр
Dialogue: 0,0:01:03.60,0:01:04.73,Default,,0,0,0,,Жиын
Dialogue: 0,0:01:05.60,0:01:06.77,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:01:10.36,0:01:12.78,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,0:01:12.86,0:01:16.78,Default,,0,0,0,,(Оқушылар ауыр тыныс алады)
Dialogue: 0,0:01:16.86,0:01:22.12,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,0:01:38.30,0:01:42.22,Default,,0,0,0,,Тоғашы, сен енді дүниені мақсат етпейсің ғой?
Dialogue: 0,0:01:42.31,0:01:43.56,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:01:43.64,0:01:46.27,Default,,0,0,0,,Бізбен жүгіру қызық болмас еді, солай ма?
Dialogue: 0,0:01:46.35,0:01:47.31,Default,,0,0,0,,Кіммен жүгірсең де
Dialogue: 0,0:01:47.39,0:01:49.85,Default,,0,0,0,,Мен мұны ешқашан қызық деп ойлаған емеспін...
Dialogue: 0,0:01:49.94,0:01:51.69,Default,,0,0,0,,Бастауыш сынып оқушылары арасында республика бойынша №1 орын.
Dialogue: 0,0:01:51.69,0:01:53.15,Default,,0,0,0,,Бастауыш сынып оқушылары арасында республика бойынша №1 орын.
Dialogue: 0,0:01:51.69,0:01:53.15,Default,,0,0,0,,Уау, бұл қауіпті.
Dialogue: 0,0:01:53.23,0:01:55.57,Default,,0,0,0,,Тоғашыда бірдеңе салқын.
Dialogue: 0,0:01:55.65,0:01:56.90,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:07.71,0:02:09.17,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:02:09.17,0:02:10.04,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:02:09.17,0:02:10.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:10.04,0:02:12.34,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:02:12.42,0:02:13.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:13.34,0:02:17.84,Default,,0,0,0,,(Комияның жөтелі)
Dialogue: 0,0:02:19.38,0:02:20.34,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:02:21.26,0:02:22.60,Default,,0,0,0,,Бұл... Бұл...
Dialogue: 0,0:02:22.68,0:02:24.39,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:02:25.35,0:02:27.85,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:27.93,0:02:30.85,Default,,0,0,0,,Мен өлетін сияқтымын.
Dialogue: 0,0:02:31.52,0:02:34.07,Default,,0,0,0,,Бұл соншалықты... солай...
Dialogue: 0,0:02:34.15,0:02:35.90,Default,,0,0,0,,Жарайсыз, оттегі жетіспейді.
Dialogue: 0,0:02:35.98,0:02:37.86,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:37.94,0:02:40.99,Default,,0,0,0,,Әдеттегідей... Сонымен...
Dialogue: 0,0:02:42.53,0:02:43.49,Default,,0,0,0,,Әрқашан?
Dialogue: 0,0:02:43.58,0:02:47.37,Default,,0,0,0,,(Комияның жөтелі)
Dialogue: 0,0:02:47.45,0:02:53.38,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:02:55.00,0:02:55.84,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:55.92,0:02:57.01,Default,,0,0,0,,О
Dialogue: 0,0:02:57.09,0:03:01.34,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:03:01.43,0:03:04.35,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:03:12.19,0:03:16.15,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,0:03:16.23,0:03:17.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:17.44,0:03:19.86,Default,,0,0,0,,Әй, тыныш бол.
Dialogue: 0,0:03:19.94,0:03:22.11,Default,,0,0,0,,Бұл мен кеше айтқан ауыспалы студент.
Dialogue: 0,0:03:22.20,0:03:23.91,Default,,0,0,0,,Кеше...
Dialogue: 0,0:03:23.99,0:03:24.87,Default,,0,0,0,,(Ақ) Адамнан тыс қабілеттері бар данышпан қыз
Dialogue: 0,0:03:24.95,0:03:28.62,Default,,0,0,0,,Комия-кун бүгіннен бастап барлығының сыныптасы болады.
Dialogue: 0,0:03:28.70,0:03:31.04,Default,,0,0,0,,Барлығы жақсы араласуы керек.
Dialogue: 0,0:03:31.12,0:03:33.17,Default,,0,0,0,,Ха... мм... мм...
Dialogue: 0,0:03:33.25,0:03:36.38,Default,,0,0,0,,Иә? Хаха Сәлем Сәлем
Dialogue: 0,0:03:39.76,0:03:42.47,Default,,0,0,0,,Сен ақымақсың ба, аянышты?
Dialogue: 0,0:03:42.55,0:03:44.89,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Комиямын.
Dialogue: 0,0:03:44.97,0:03:46.80,Default,,0,0,0,,Мен сізді естімеймін.
Dialogue: 0,0:03:46.89,0:03:49.64,Default,,0,0,0,,Иә, әрекетті қайталаңыз.
Dialogue: 0,0:03:49.72,0:03:53.19,Default,,0,0,0,,Балалар... Мен сендерге жаңа ғана тіл табысыңдар дедім.
Dialogue: 0,0:03:53.27,0:03:56.90,Default,,0,0,0,,Иә, біз жақсы араласамыз, сондықтан атыңызды қайталаңыз.
Dialogue: 0,0:03:56.98,0:03:59.15,Default,,0,0,0,,-Хахахахаха - (Үй мұғалімі) Сен табандысың, Гента.
Dialogue: 0,0:03:59.23,0:04:02.15,Default,,0,0,0,,Қарап отырмасаң, байқамайсың.
Dialogue: 0,0:04:02.24,0:04:04.16,Default,,0,0,0,,Үшбұрыштың ішкі бұрыштарының қосындысы тең
Dialogue: 0,0:04:04.24,0:04:06.16,Default,,0,0,0,,Бұл 180 градус.
Dialogue: 0,0:04:06.24,0:04:09.16,Default,,0,0,0,,Көптеген адамдар 360 градусты дұрыс түсінбейді, сондықтан абай болыңыз.
Dialogue: 0,0:04:09.74,0:04:11.66,Default,,0,0,0,,Параллелограммдар біршама қиын.
Dialogue: 0,0:04:11.75,0:04:13.16,Default,,0,0,0,,Мұқият тыңдаңыз.
Dialogue: 0,0:04:13.25,0:04:15.17,Default,,0,0,0,,(Оқушылар ауыр тыныс алады)
Dialogue: 0,0:04:15.25,0:04:16.67,Default,,0,0,0,,Сәлем, келесі!
Dialogue: 0,0:04:16.75,0:04:19.13,Default,,0,0,0,,Жоқ, жеңіліп қалсам не істеуім керек?
Dialogue: 0,0:04:19.21,0:04:20.67,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:21.34,0:04:22.17,Default,,0,0,0,,（）
Dialogue: 0,0:04:25.01,0:04:31.06,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:04:36.15,0:04:37.11,Default,,0,0,0,,（）
Dialogue: 0,0:04:37.19,0:04:40.94,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,0:04:43.49,0:04:44.90,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:05:08.59,0:05:09.80,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:05:09.80,0:05:10.64,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:05:09.80,0:05:10.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:10.64,0:05:15.56,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:05:18.06,0:05:18.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:19.56,0:05:20.73,Default,,0,0,0,,Комия-кун!
Dialogue: 0,0:05:22.32,0:05:25.07,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:05:25.15,0:05:25.99,Default,,0,0,0,,О...
Dialogue: 0,0:05:26.86,0:05:27.78,Default,,0,0,0,,Комия-кун
Dialogue: 0,0:05:28.87,0:05:29.78,Default,,0,0,0,,Комия-кун
Dialogue: 0,0:05:30.62,0:05:31.91,Default,,0,0,0,,Комия-кун!
Dialogue: 0,0:05:31.99,0:05:33.66,Default,,0,0,0,,Хаха...
Dialogue: 0,0:05:33.75,0:05:35.54,Default,,0,0,0,,Ху... Тоғаши-күн...
Dialogue: 0,0:05:36.12,0:05:37.54,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,0:05:37.62,0:05:39.54,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:05:39.63,0:05:41.54,Default,,0,0,0,,Бұл менің көршім.
Dialogue: 0,0:05:42.63,0:05:45.17,Default,,0,0,0,,Мен сені кешегі өзен арнасына апарамын.
Dialogue: 0,0:05:46.88,0:05:48.55,Default,,0,0,0,,Сізге жүгіру ұнайды ма?
Dialogue: 0,0:05:49.09,0:05:50.93,Default,,0,0,0,,Жоқ, бұл қиын.
Dialogue: 0,0:05:51.51,0:05:53.68,Default,,0,0,0,,Онда неге жүгіріп жүрсің?
Dialogue: 0,0:05:55.10,0:05:56.52,Default,,0,0,0,,Өйткені бұлыңғыр болады
Dialogue: 0,0:05:57.02,0:05:59.19,Default,,0,0,0,,Бұлыңғыр? Не?
Dialogue: 0,0:05:59.73,0:06:00.90,Default,,0,0,0,,Шындық
Dialogue: 0,0:06:01.48,0:06:05.74,Default,,0,0,0,,Мен шындықтан гөрі азапты істермен айналысқанда алаңдаймын.
Dialogue: 0,0:06:06.40,0:06:07.45,Default,,0,0,0,,Олай болса
Dialogue: 0,0:06:08.07,0:06:09.20,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:06:10.03,0:06:13.70,Default,,0,0,0,,Бір нәрсе ысырап емес пе? Сондықтан мен жүгіремін
Dialogue: 0,0:06:19.17,0:06:20.71,Default,,0,0,0,,Моттайнай?
Dialogue: 0,0:06:21.54,0:06:25.21,Default,,0,0,0,,А... жоқ, не айтайын...
Dialogue: 0,0:06:25.84,0:06:28.22,Default,,0,0,0,,Өйткені менде ештеңе жоқ
Dialogue: 0,0:06:28.30,0:06:29.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:30.38,0:06:33.97,Default,,0,0,0,,Адамдармен жақсы сөйлесе алмаймын.
Dialogue: 0,0:06:34.64,0:06:37.23,Default,,0,0,0,,Себебі мен есепті шешу жолын білмеймін
Dialogue: 0,0:06:37.31,0:06:39.10,Default,,0,0,0,,Мен қашып кетсем екен
Dialogue: 0,0:06:39.73,0:06:41.98,Default,,0,0,0,,Тіпті уақытша түрде
Dialogue: 0,0:06:44.69,0:06:47.32,Default,,0,0,0,,Сондықтан менде бұдан артық себеп жоқ.
Dialogue: 0,0:06:49.57,0:06:50.74,Default,,0,0,0,,Тек жүгіріңіз
Dialogue: 0,0:06:50.82,0:06:52.70,Default,,0,0,0,,Нені шешпейді
Dialogue: 0,0:06:52.78,0:06:53.74,Default,,0,0,0,,Мен білемін, бірақ
Dialogue: 0,0:06:54.62,0:06:56.74,Default,,0,0,0,,Бұл дұрыс емес, Комия-кун.
Dialogue: 0,0:06:57.33,0:06:58.25,Default,,0,0,0,,Е...
Dialogue: 0,0:06:58.83,0:07:02.42,Default,,0,0,0,,Әрине, жай жүгіру ештеңені шешпейді.
Dialogue: 0,0:07:03.04,0:07:04.34,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:07:05.34,0:07:06.25,Default,,0,0,0,,Қый!
Dialogue: 0,0:07:06.34,0:07:09.84,Default,,0,0,0,,Бұл дүниеде өте қарапайым ережелер бар.
Dialogue: 0,0:07:10.84,0:07:12.01,Default,,0,0,0,,Көбінесе
Dialogue: 0,0:07:12.09,0:07:15.30,Default,,0,0,0,,Егер сіз басқалардан 100 метрге жылдам жүгірсеңіз
Dialogue: 0,0:07:15.39,0:07:17.27,Default,,0,0,0,,Барлығы шешілді
Dialogue: 0,0:07:18.43,0:07:20.69,Default,,0,0,0,,Барлығы шешілді…
Dialogue: 0,0:07:20.77,0:07:22.94,Default,,0,0,0,,Мұны қалай айта аласыз?
Dialogue: 0,0:07:23.65,0:07:26.52,Default,,0,0,0,,Неге... Мен.
Dialogue: 0,0:07:27.28,0:07:28.90,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:07:30.07,0:07:31.40,Default,,0,0,0,,Қазір де...
Dialogue: 0,0:07:32.36,0:07:34.07,Default,,0,0,0,,Қазірдің өзінде
Dialogue: 0,0:07:35.32,0:07:37.08,Default,,0,0,0,,Сіз жылдамырақ бола аласыз ба?
Dialogue: 0,0:07:37.16,0:07:38.24,Default,,0,0,0,,♪～
Dialogue: 0,0:07:38.24,0:07:40.41,Default,,0,0,0,,♪～
Dialogue: 0,0:07:38.24,0:07:40.41,Default,,0,0,0,,Мұны өзіңіз шешесіз.
Dialogue: 0,0:07:40.41,0:07:42.17,Default,,0,0,0,,♪～
Dialogue: 0,0:07:46.25,0:07:48.55,Default,,0,0,0,,Мен шешемін...
Dialogue: 0,0:09:05.37,0:09:10.38,Default,,0,0,0,,～♪
Dialogue: 0,0:09:13.05,0:09:13.88,Default,,0,0,0,,Ол айналып өткеннен кейін әлсіз жақтарымнан шағын соққылар береді.
Dialogue: 0,0:09:13.97,0:09:15.05,Default,,0,0,0,,Қош бол ұстаз
Dialogue: 0,0:09:16.47,0:09:18.05,Default,,0,0,0,,Тоғашы
Dialogue: 0,0:09:18.14,0:09:20.47,Default,,0,0,0,,Бүгін Каванончиде ойын ойнайық.
Dialogue: 0,0:09:21.14,0:09:23.72,Default,,0,0,0,,Кешіріңіз, менде бүгін тағы бір нәрсе істеу керек.
Dialogue: 0,0:09:23.81,0:09:24.85,Default,,0,0,0,,Келесі кездескенше
Dialogue: 0,0:09:27.65,0:09:28.69,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:09:28.77,0:09:29.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:29.69,0:09:32.07,Default,,0,0,0,,Не? Бұл қызықсыз.
Dialogue: 0,0:09:32.73,0:09:38.66,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:09:39.78,0:09:41.41,Default,,0,0,0,,Қолдарыңызды көбірек шайқаңыздар!
Dialogue: 0,0:09:42.95,0:09:45.25,Default,,0,0,0,,Жерді мүмкіндігінше қатты тепкеніңізді елестетіңіз!
Dialogue: 0,0:09:47.25,0:09:48.46,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:09:48.46,0:09:49.67,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:09:48.46,0:09:49.67,Default,,0,0,0,,Әй, жанымнан кетпе!
Dialogue: 0,0:09:49.67,0:09:53.17,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:09:55.76,0:09:57.05,Default,,0,0,0,,Жоғары!
Dialogue: 0,0:10:00.26,0:10:01.18,Default,,0,0,0,,Цк
Dialogue: 0,0:10:01.26,0:10:03.68,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:10:20.57,0:10:23.87,Default,,0,0,0,,Тоғашы, бүгін менің үйімде ойын ойнайық.
Dialogue: 0,0:10:23.95,0:10:26.91,Default,,0,0,0,,А... кешіріңіз, менің де бүгін жоспарым бар.
Dialogue: 0,0:10:27.00,0:10:28.75,Default,,0,0,0,,Ал, бүгін де шығар?
Dialogue: 0,0:10:28.83,0:10:30.08,Default,,0,0,0,,Сіз, Басшының орынбасары, қазір тергеу штабында қанша адам қалғанын білесіз ғой.
Dialogue: 0,0:10:30.75,0:10:33.50,Default,,0,0,0,,Тоғашы, соңғы кездері жақсы араласпай жүрміз.
Dialogue: 0,0:10:36.05,0:10:40.68,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:10:40.76,0:10:42.47,Default,,0,0,0,,Жақсырақ
Dialogue: 0,0:10:42.55,0:10:44.97,Default,,0,0,0,,Шаршамайсың ба? күнде жүгіру
Dialogue: 0,0:10:46.14,0:10:47.22,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:47.31,0:10:50.48,Default,,0,0,0,,Мен жүгірген сайын аяғым жеңілдей түседі
Dialogue: 0,0:10:50.56,0:10:51.98,Default,,0,0,0,,Мен өте жақсы жұмыс істеп жатырмын.
Dialogue: 0,0:10:52.06,0:10:55.73,Default,,0,0,0,,Жақында спорт күні, сондықтан ертең демалу керек.
Dialogue: 0,0:10:55.82,0:10:57.44,Default,,0,0,0,,Мен үзіліс алсам босқа кетеді
Dialogue: 0,0:10:57.53,0:11:00.11,Default,,0,0,0,,Маған одан да көп нәрсені айтқым келеді.
Dialogue: 0,0:11:00.20,0:11:02.49,Default,,0,0,0,,Демалу – тәжірибенің бір бөлігі.
Dialogue: 0,0:11:02.57,0:11:06.37,Default,,0,0,0,,А... Мен де сол аяқ киімді ауыстыруым керек.
Dialogue: 0,0:11:06.45,0:11:08.45,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:11:14.96,0:11:17.88,Default,,0,0,0,,Бұл тамаша болды, өйткені мен оны өзіммен бірге сәндік-қолданбалы өнер үшін алып келдім.
Dialogue: 0,0:11:18.46,0:11:19.30,Default,,0,0,0,,Осылай орындаңыз...
Dialogue: 0,0:11:19.30,0:11:20.13,Default,,0,0,0,,Осылай орындаңыз...
Dialogue: 0,0:11:19.30,0:11:20.13,Default,,0,0,0,,(Орауыш таспаның дыбысы)
Dialogue: 0,0:11:20.13,0:11:21.01,Default,,0,0,0,,(Орауыш таспаның дыбысы)
Dialogue: 0,0:11:21.01,0:11:23.64,Default,,0,0,0,,(Орауыш таспаның дыбысы)
Dialogue: 0,0:11:21.01,0:11:23.64,Default,,0,0,0,,Эй, Комия-кун, бұл біраз...
Dialogue: 0,0:11:25.22,0:11:27.39,Default,,0,0,0,,Жарайды, бұл жақсы деп ойлаймын.
Dialogue: 0,0:11:27.47,0:11:30.85,Default,,0,0,0,,Жоқ, бұл жақсы емес. Бұл жаман емес пе?
Dialogue: 0,0:11:30.94,0:11:32.56,Default,,0,0,0,,Бірақ оларды киюге болмайды.
Dialogue: 0,0:11:32.65,0:11:34.40,Default,,0,0,0,,Бұл өте аз емес пе?
Dialogue: 0,0:11:35.65,0:11:38.69,Default,,0,0,0,,А... мүмкін сатып ала алмайсың ба?
Dialogue: 0,0:11:39.28,0:11:41.40,Default,,0,0,0,,Жоқ, ата-анамнан.
Dialogue: 0,0:11:41.49,0:11:44.07,Default,,0,0,0,,Маған жаңасына ауысу керектігін айтып жатыр.
Dialogue: 0,0:11:44.66,0:11:49.37,Default,,0,0,0,,Мен бұл аяқ киіммен көптен бері жаттығып жүрмін, өмірде де солармен жүгіргім келеді.
Dialogue: 0,0:11:50.25,0:11:51.08,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:11:51.79,0:11:55.58,Default,,0,0,0,,100 метрге жүгіруде бірінші болсаңыз, алтын медаль аласыз, солай ма?
Dialogue: 0,0:11:55.67,0:11:56.75,Default,,0,0,0,,Е...
Dialogue: 0,0:11:57.25,0:11:59.59,Default,,0,0,0,,Ах, Хякуйендікі.
Dialogue: 0,0:12:00.80,0:12:02.17,Default,,0,0,0,,(Шинсо) Егер сен шын жүректен берілген болашағың болса, сыртқы көрініске алаңдауға уақытың жоқ
Dialogue: 0,0:12:02.72,0:12:05.43,Default,,0,0,0,,Мен бірінші болғым келеді, бір рет қана.
Dialogue: 0,0:12:08.72,0:12:10.43,Default,,0,0,0,,Мен жеңгім келеді
Dialogue: 0,0:12:12.81,0:12:16.36,Default,,0,0,0,,(Оқушылар қолдау көрсету)
Dialogue: 0,0:12:16.44,0:12:20.19,Default,,0,0,0,,Келесі кезекте ерлер арасында 100 метрге жүгіру басталады.
Dialogue: 0,0:12:20.69,0:12:22.11,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:12:20.69,0:12:22.11,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:12:22.19,0:12:25.11,Default,,0,0,0,,(Ата-аналардың шулары)
Dialogue: 0,0:12:25.20,0:12:26.74,Default,,0,0,0,,Бұл жылдам.
Dialogue: 0,0:12:26.82,0:12:28.78,Default,,0,0,0,,Әлгі бала Тоғаши-кун ба?
Dialogue: 0,0:12:28.87,0:12:31.79,Default,,0,0,0,,Иә, бұл жүгіруді аяқтаған адам.
Dialogue: 0,0:12:31.87,0:12:34.00,Default,,0,0,0,,Тоғашымен жүгірудің пайдасы бар ма?
Dialogue: 0,0:12:34.08,0:12:35.62,Default,,0,0,0,,Міне, бұл спорт күні.
Dialogue: 0,0:12:35.71,0:12:37.79,Default,,0,0,0,,Иә? Тоғашыға не болды?
Dialogue: 0,0:12:39.71,0:12:41.30,Default,,0,0,0,,Сіз студентті ауыстырасыз
Dialogue: 0,0:12:41.38,0:12:44.05,Default,,0,0,0,,Сіз ең болмағанда қазір жүгіре аласыз ба?
Dialogue: 0,0:12:44.55,0:12:46.93,Default,,0,0,0,,Хехе, сен ол аяқ киіммен жүгіресің бе?
Dialogue: 0,0:12:49.89,0:12:51.43,Default,,0,0,0,,Цк, сен мені елемейсің бе?
Dialogue: 0,0:12:51.52,0:12:53.18,Default,,0,0,0,,Сәлем Тоғаши
Dialogue: 0,0:12:53.27,0:12:54.94,Default,,0,0,0,,- (Мұғалім 1) Осы жерде сапқа тұрыңыз - (2 мұғалім) Лауазымы туралы
Dialogue: 0,0:12:55.52,0:12:56.60,Default,,0,0,0,,Жақсы
Dialogue: 0,0:13:01.53,0:13:02.53,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:13:03.19,0:13:04.28,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:13:04.36,0:13:05.36,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:13:09.78,0:13:12.37,Default,,0,0,0,,Қарғыс атсын, Комия-кун!
Dialogue: 0,0:13:12.45,0:13:14.25,Default,,0,0,0,,Сіз жылдамсыз!
Dialogue: 0,0:13:17.17,0:13:21.59,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:13:26.13,0:13:28.01,Default,,0,0,0,,Уф! Ха...
Dialogue: 0,0:13:28.09,0:13:29.01,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:13:29.09,0:13:30.51,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:13:30.60,0:13:36.02,Default,,0,0,0,,(Гентаның ауыр тыныс алуы)
Dialogue: 0,0:13:42.98,0:13:46.65,Default,,0,0,0,,Одан кейін 100м марапаттау рәсімі өтеді.
Dialogue: 0,0:13:47.53,0:13:48.66,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:14:03.38,0:14:04.67,Default,,0,0,0,,Бұл кеше жасалды —
Dialogue: 0,0:14:04.76,0:14:08.18,Default,,0,0,0,,100 метрге жеңіл атлетикадан жасөспірімдер арасындағы ұлттық турнир
Dialogue: 0,0:14:08.26,0:14:13.76,Default,,0,0,0,,Чемпионатта Жапонияның бұрынғы өкілі Ютака Ниджиннің үлкен ұлы Такеру Ниджин жеңіске жетті.
Dialogue: 0,0:14:14.27,0:14:17.85,Default,,0,0,0,,Екінші курс студенті ретінде чемпионатты жеңіп алудың үлкен жетістігі жеңіл атлетика әлемімен ғана шектелмейді.
Dialogue: 0,0:14:17.94,0:14:20.19,Default,,0,0,0,,Жалпы спорт әлеміндегі үлкен тақырып...
Dialogue: 0,0:14:21.81,0:14:22.77,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:22.86,0:14:23.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:24.78,0:14:26.44,Default,,0,0,0,,О, Тоғашы
Dialogue: 0,0:14:26.53,0:14:28.57,Default,,0,0,0,,Түскі асқа жарамсыз
Dialogue: 0,0:14:29.07,0:14:30.03,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:30.11,0:14:31.20,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:14:31.28,0:14:32.87,Default,,0,0,0,,Міне.
Dialogue: 0,0:14:33.62,0:14:36.45,Default,,0,0,0,,«Ай елі»?
Dialogue: 0,0:14:38.87,0:14:40.79,Default,,0,0,0,,Бұл керемет, Тогаши-кун.
Dialogue: 0,0:14:40.87,0:14:43.92,Default,,0,0,0,,Иә, түскі ас кезінде Тани маған ертерек айтты.
Dialogue: 0,0:14:44.00,0:14:45.30,Default,,0,0,0,,Журналды жоспарлау
Dialogue: 0,0:14:46.63,0:14:50.09,Default,,0,0,0,,Джинджинмен әңгімелесу керемет болды.
Dialogue: 0,0:14:50.18,0:14:52.80,Default,,0,0,0,,Ойлап қарасам, мектеп те осы маңайда екен ғой?
Dialogue: 0,0:14:53.60,0:14:54.81,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:55.60,0:14:58.23,Default,,0,0,0,,Кім жылдам, Тоғашы-күн?
Dialogue: 0,0:14:58.31,0:15:00.81,Default,,0,0,0,,А... бұл Джинджин ғой, солай ма?
Dialogue: 0,0:15:01.40,0:15:03.02,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:15:04.57,0:15:06.65,Default,,0,0,0,,Қалай болғанда да, бұл әңгіме емес.
Dialogue: 0,0:15:06.73,0:15:09.90,Default,,0,0,0,,100 метр Нағыз жарыс болса екен.
Dialogue: 0,0:15:10.49,0:15:13.41,Default,,0,0,0,,Жоқ... бұл мүмкін емес.
Dialogue: 0,0:15:17.33,0:15:18.75,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:15:26.67,0:15:28.88,Default,,0,0,0,,Тогаши мен Джинджиннің жүгіріп жүргені рас па?
Dialogue: 0,0:15:28.96,0:15:31.38,Default,,0,0,0,,Адамдардың атын атаған дұрыс емес.
Dialogue: 0,0:15:31.47,0:15:34.05,Default,,0,0,0,,Джинджинге кіріңіз
Dialogue: 0,0:15:34.14,0:15:35.72,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:15:36.22,0:15:37.85,Default,,0,0,0,,Ах... сол күйінде қалдырыңыз.
Dialogue: 0,0:15:37.93,0:15:38.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:40.35,0:15:42.60,Default,,0,0,0,,Танысқаныма қуаныштымын, Тогаши-кун
Dialogue: 0,0:15:42.69,0:15:44.90,Default,,0,0,0,,Менің атым Джинджин. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:15:44.98,0:15:46.73,Default,,0,0,0,,О~ Джинджин келді~
Dialogue: 0,0:15:46.82,0:15:48.82,Default,,0,0,0,,Сондықтан адамдардың атын атаған дұрыс емес.
Dialogue: 0,0:15:50.95,0:15:52.45,Default,,0,0,0,,Ол дайын сияқты.
Dialogue: 0,0:15:52.53,0:15:53.57,Default,,0,0,0,,бастайық
Dialogue: 0,0:15:54.16,0:15:55.49,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:15:55.57,0:15:57.16,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:15:58.37,0:16:01.21,Default,,0,0,0,,Тоғаши-кунның сұрағынан бастайық.
Dialogue: 0,0:16:01.29,0:16:03.00,Default,,0,0,0,,А... иә
Dialogue: 0,0:16:03.50,0:16:05.75,Default,,0,0,0,,Ал...
Dialogue: 0,0:16:07.67,0:16:11.22,Default,,0,0,0,,Джиндзин не үшін жүгіреді?
Dialogue: 0,0:16:11.76,0:16:15.26,Default,,0,0,0,,Иә, әрине, бірінші орын алу үшін.
Dialogue: 0,0:16:15.34,0:16:16.55,Default,,0,0,0,,Тогаши-кун қалай?
Dialogue: 0,0:16:17.68,0:16:20.64,Default,,0,0,0,,Сіз басқаларға қарағанда тезірек туылғаныңызды түсінгенде
Dialogue: 0,0:16:20.72,0:16:22.06,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:16:22.14,0:16:23.31,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:23.89,0:16:27.56,Default,,0,0,0,,Бірақ бірінші орынды жеңіп алсаңыз, жай ғана көңіл көтеруге қайта орала алмайсыз.
Dialogue: 0,0:16:28.19,0:16:30.82,Default,,0,0,0,,Бір жерден түсінген шығарсың, Тоғашы-күн.
Dialogue: 0,0:16:31.53,0:16:36.45,Default,,0,0,0,,Енді сіз бұл қашықтықта өмір сүруге шешім қабылдадыңыз, не болғанына қарамастан, берілмеңіз және жүгіріңіз.
Dialogue: 0,0:16:37.07,0:16:38.12,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:38.20,0:16:41.12,Default,,0,0,0,,Күнделікті жарыстар сіздің өміріңізге әсер етеді
Dialogue: 0,0:16:41.91,0:16:44.29,Default,,0,0,0,,Өйткені жүгіру оңай
Dialogue: 0,0:16:44.79,0:16:48.63,Default,,0,0,0,,Ол жерден орын тапқыңыз келсе... Онда қалғыңыз келсе
Dialogue: 0,0:16:48.71,0:16:51.96,Default,,0,0,0,,Әрқашан абсолютті болуы керек
Dialogue: 0,0:16:57.51,0:17:00.39,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:17:07.56,0:17:08.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:27.71,0:17:31.25,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,0:17:31.34,0:17:33.59,Default,,0,0,0,,Жақсы Тогаши-кун
Dialogue: 0,0:17:33.67,0:17:35.26,Default,,0,0,0,,Джинджин-кунның көзқарасы бойынша не ойлайсың?
Dialogue: 0,0:17:36.26,0:17:40.14,Default,,0,0,0,,Қадам жылдамдығы Баланс ырғағы Ауырлық қозғалыс орталығы
Dialogue: 0,0:17:40.22,0:17:41.76,Default,,0,0,0,,Мен оның бастауыш сынып оқушысы екеніне сене алар емеспін.
Dialogue: 0,0:17:43.14,0:17:44.35,Default,,0,0,0,,50 рет
Dialogue: 0,0:17:45.35,0:17:46.85,Default,,0,0,0,,Тогаши-кун
Dialogue: 0,0:17:46.94,0:17:50.27,Default,,0,0,0,,Сіз ойлағаннан 50 есе дарындысыз.
Dialogue: 0,0:17:50.36,0:17:53.11,Default,,0,0,0,,- (Редактор) Әй, 50 рет пе? - Аа... Аа...
Dialogue: 0,0:17:53.19,0:17:54.61,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:57.36,0:18:00.28,Default,,0,0,0,,Эй, ол басталатын сияқты.
Dialogue: 0,0:18:01.91,0:18:03.29,Default,,0,0,0,,Мен және фотограф
Dialogue: 0,0:18:03.37,0:18:05.08,Default,,0,0,0,,Ол шамамен 40 метр жерде.
Dialogue: 0,0:18:05.16,0:18:07.29,Default,,0,0,0,,Осы нүктеден өткеннен кейін оны ақырын шайыңыз.
Dialogue: 0,0:18:07.37,0:18:08.58,Default,,0,0,0,,Иә
Dialogue: 0,0:18:08.67,0:18:10.75,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:18:17.76,0:18:19.68,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:18:20.64,0:18:22.10,Default,,0,0,0,,Орналасуға қатысты
Dialogue: 0,0:18:26.23,0:18:27.68,Default,,0,0,0,,Жақсы
Dialogue: 0,0:18:35.03,0:18:36.49,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:18:42.57,0:18:44.20,Default,,0,0,0,,Хмм... ха ха ха ха...
Dialogue: 0,0:18:44.28,0:18:47.70,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:18:47.79,0:18:49.58,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,0:18:51.04,0:18:52.58,Default,,0,0,0,,Тоғаши жеңді ме?
Dialogue: 0,0:18:52.67,0:18:54.59,Default,,0,0,0,,Жоқ, ол бастапқыда фотоға түсіру үшін болды.
Dialogue: 0,0:18:54.67,0:18:57.59,Default,,0,0,0,,Джинджиннің жүгірмегені ғана емес пе?
Dialogue: 0,0:18:58.17,0:19:00.47,Default,,0,0,0,,Джинджин-кун, еңбегің үшін рахмет
Dialogue: 0,0:19:01.47,0:19:03.10,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:19:03.18,0:19:05.60,Default,,0,0,0,,Мен өте әдемі суреттерді түсіре алдым.
Dialogue: 0,0:19:05.68,0:19:08.10,Default,,0,0,0,,Салиқалы жарыс дегендей, асығыс сезіммен.
Dialogue: 0,0:19:08.18,0:19:11.44,Default,,0,0,0,,Толқып, соңына дейін жүгіретінмін.
Dialogue: 0,0:19:11.52,0:19:14.11,Default,,0,0,0,,Сізге рахмет, мен жақсы мақала жаза аламын деп ойлаймын.
Dialogue: 0,0:19:15.65,0:19:18.94,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:19.03,0:19:22.11,Default,,0,0,0,,Джинджин жарты жолда жүгіруді тоқтатпаса
Dialogue: 0,0:19:22.82,0:19:25.28,Default,,0,0,0,,Менің ойымша, Тогаши-кун жеңетін еді.
Dialogue: 0,0:19:25.37,0:19:26.66,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:19:26.74,0:19:29.25,Default,,0,0,0,,Мен жаңа ғана фотосессияға жүгірдім.
Dialogue: 0,0:19:29.33,0:19:32.08,Default,,0,0,0,,Тоғаши-куннан жеңілемін деп тастаған жоқсың ба?
Dialogue: 0,0:19:32.17,0:19:34.04,Default,,0,0,0,,Бұл дұрыс емес, солай емес пе?
Dialogue: 0,0:19:34.13,0:19:37.17,Default,,0,0,0,,Екеуі де маған байсалды болып көрінді.
Dialogue: 0,0:19:37.67,0:19:40.76,Default,,0,0,0,,Тоғашы-күн дегенде байсалды.
Dialogue: 0,0:19:40.84,0:19:43.47,Default,,0,0,0,,Мен бұрыштарды қия алмаймын.
Dialogue: 0,0:19:43.55,0:19:44.51,Default,,0,0,0,,Кез келген уақытта
Dialogue: 0,0:19:44.60,0:19:47.64,Default,,0,0,0,,Сіздің қолыңыздан келгеннің бәрі әрқашан мүмкіндігінше жүгіру, солай ма?
Dialogue: 0,0:19:48.35,0:19:50.56,Default,,0,0,0,,Бірақ бүгін мен Джинджин мырзамен таныстым.
Dialogue: 0,0:19:51.10,0:19:54.10,Default,,0,0,0,,Мен себебін түсіндім.
Dialogue: 0,0:19:56.77,0:19:58.82,Default,,0,0,0,,Тоғашы-күн бір күні
Dialogue: 0,0:19:58.90,0:20:01.95,Default,,0,0,0,,Менің ойымша, Зайцудың рекорды да жаңартылады.
Dialogue: 0,0:20:02.91,0:20:06.07,Default,,0,0,0,,Жоқ, бұл мүмкін емес деп ойлаймын.
Dialogue: 0,0:20:12.25,0:20:13.62,Default,,0,0,0,,Тоғаши-кун
Dialogue: 0,0:20:15.79,0:20:18.13,Default,,0,0,0,,Менің бір өтінішім бар.
Dialogue: 0,0:20:19.25,0:20:20.09,Default,,0,0,0,,Не?
Dialogue: 0,0:20:21.72,0:20:24.59,Default,,0,0,0,,Мен сенің менімен 100 метрге жүгіруіңді қалаймын.
Dialogue: 0,0:20:26.01,0:20:26.85,Default,,0,0,0,,Енді?
Dialogue: 0,0:20:27.51,0:20:29.97,Default,,0,0,0,,Иә, шындап.
Dialogue: 0,0:20:36.69,0:20:38.36,Default,,0,0,0,,100 метр
Dialogue: 0,0:20:39.07,0:20:40.36,Default,,0,0,0,,Сол ағашта
Dialogue: 0,0:20:40.44,0:20:41.74,Default,,0,0,0,,Иә
Dialogue: 0,0:20:41.82,0:20:42.86,Default,,0,0,0,,Бастау сигналы
Dialogue: 0,0:20:42.95,0:20:45.49,Default,,0,0,0,,Дәл осы жерден пойыз өтіп бара жатқанда
Dialogue: 0,0:20:45.57,0:20:47.37,Default,,0,0,0,,Рельс түйіспелерінің дыбысы
Dialogue: 0,0:20:47.45,0:20:48.78,Default,,0,0,0,,(рельс буындарының дыбысы)
Dialogue: 0,0:20:48.87,0:20:50.62,Default,,0,0,0,,Бірінші дыбыс – сигнал.
Dialogue: 0,0:21:00.21,0:21:05.13,Default,,0,0,0,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:21:12.18,0:21:13.39,Default,,0,0,0,,(Рельс буындарының дыбысы)
Dialogue: 0,0:21:13.48,0:21:17.40,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:21:30.99,0:21:31.99,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:32.49,0:21:34.50,Default,,0,0,0,,Хаха...
Dialogue: 0,0:21:34.58,0:21:37.42,Default,,0,0,0,,Бұл... Жақсысың ба? Комия-кун
Dialogue: 0,0:21:37.50,0:21:40.42,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:21:41.88,0:21:43.13,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:43.71,0:21:46.43,Default,,0,0,0,,Сіз бұрыштарды кесіп алдыңыз ба? Тогаши-кун
Dialogue: 0,0:21:47.38,0:21:51.18,Default,,0,0,0,,Жоқ, мен айттым ғой, мен әрқашан барымды беремін.
Dialogue: 0,0:21:52.68,0:21:54.18,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:54.81,0:21:57.39,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:22:08.32,0:22:10.70,Default,,0,0,0,,Олай болса, Тоғаши-кун.
Dialogue: 0,0:22:12.45,0:22:15.25,Default,,0,0,0,,Иә, ертең кездескенше.
Dialogue: 0,0:22:18.71,0:22:19.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:39.98,0:22:44.44,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,0:22:44.52,0:22:46.28,Default,,0,0,0,,Ал, бүгін.
Dialogue: 0,0:22:46.36,0:22:48.95,Default,,0,0,0,,Менде бір өкінішті жаңалық бар.
Dialogue: 0,0:22:49.03,0:22:53.03,Default,,0,0,0,,Мен Комиямын, отбасылық жағдайға байланысты шұғыл.
Dialogue: 0,0:22:53.12,0:22:55.91,Default,,0,0,0,,Мен кеше көшіп, жаңа мектепке ауысуды шештім.
Dialogue: 0,0:22:56.54,0:22:59.04,Default,,0,0,0,,Барлығы жаңа ғана дос болып кетсе де.
Dialogue: 0,0:22:59.12,0:23:00.83,Default,,0,0,0,,Өкінішке орай...
Dialogue: 0,0:23:00.92,0:23:03.13,Default,,0,0,0,,Толығырақ мәліметтерді білгенде сізге хабарлаймын.
Dialogue: 0,0:23:03.21,0:23:04.67,Default,,0,0,0,,Бәріміз хат жазайық...
Dialogue: 0,0:23:14.97,0:23:18.23,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,0:23:27.28,0:23:32.95,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,0:23:35.87,0:23:38.37,Default,,0,0,0,,Тоғашының басым жеңісі
Dialogue: 0,0:23:38.45,0:23:40.91,Default,,0,0,0,,Іріктеу кезеңінен соңына дейін өтетін стиль
Dialogue: 0,0:23:41.00,0:23:42.71,Default,,0,0,0,,Бүгінгі күн басқаша емес.
Dialogue: 0,0:23:43.96,0:23:46.75,Default,,0,0,0,,3-жолақ Минами Дайсан орта мектебі
Dialogue: 0,0:23:47.38,0:23:48.05,Default,,0,0,0,,Сакагучи
Dialogue: 0,0:23:48.05,0:23:49.01,Default,,0,0,0,,Ойыншы Сакагучи
Dialogue: 0,0:23:48.05,0:23:49.01,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:23:49.01,0:23:49.09,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:23:49.09,0:23:52.55,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:23:49.09,0:23:52.55,Default,,0,0,0,,Жеңіл атлетикадан жасөспірімдер арасындағы ұлттық турнир 100 метрге финал
Dialogue: 0,0:23:52.55,0:23:52.63,Default,,0,0,0,,Жеңіл атлетикадан жасөспірімдер арасындағы ұлттық турнир 100 метрге финал
Dialogue: 0,0:23:52.63,0:23:53.14,Default,,0,0,0,,Жеңіл атлетикадан жасөспірімдер арасындағы ұлттық турнир 100 метрге финал
Dialogue: 0,0:23:52.63,0:23:53.14,Default,,0,0,0,,4-жол
Dialogue: 0,0:23:53.14,0:23:53.22,Default,,0,0,0,,4-жол
Dialogue: 0,0:23:53.22,0:23:54.01,Default,,0,0,0,,4-жол
Dialogue: 0,0:23:53.22,0:23:54.01,Default,,0,0,0,,Турнирлерде қатарынан жеңіске жеткен Тоғашиға назар аудару керек.
Dialogue: 0,0:23:54.01,0:23:54.09,Default,,0,0,0,,Турнирлерде қатарынан жеңіске жеткен Тоғашиға назар аудару керек.
Dialogue: 0,0:23:54.09,0:23:57.26,Default,,0,0,0,,Турнирлерде қатарынан жеңіске жеткен Тоғашиға назар аудару керек.
Dialogue: 0,0:23:54.09,0:23:57.26,Default,,0,0,0,,Хигаши Даиичи орта мектебінің Тогаши ойыншысы
Dialogue: 0,0:23:57.35,0:24:00.02,Default,,0,0,0,,Екі жыл бұрын мен сол кезде бірінші курс студенті ретінде чемпионатты жеңіп алдым.
Dialogue: 0,0:23:57.35,0:24:00.02,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:24:00.10,0:24:03.10,Default,,0,0,0,,Оның аты елге кенеттен тарағалы бері.
Dialogue: 0,0:24:03.19,0:24:06.52,Default,,0,0,0,,Мен қатысқан турнирлердегі барлық жеңістермен осы уақытқа дейін келдім.
Dialogue: 0,0:24:07.11,0:24:08.78,Default,,0,0,0,,Тоғаши-күнге қарап
Dialogue: 0,0:24:08.86,0:24:12.61,Default,,0,0,0,,Қазіргі жапондық рекордсмен Зайцудың кіші орта мектептегі күндері
Dialogue: 0,0:24:12.70,0:24:14.45,Default,,0,0,0,,Бұл маған еске түсіреді
Dialogue: 0,0:24:14.53,0:24:18.99,Default,,0,0,0,,Ал, Тоғашы қанша биікке көтеріледі?
Dialogue: 0,0:24:19.08,0:24:22.00,Default,,0,0,0,,Жеңіл атлетика әлеміне де қызығушылық артып келеді.
Dialogue: 0,0:24:22.08,0:24:22.75,Default,,0,0,0,,Сіздің белгілеріңіз туралы
Dialogue: 0,0:24:22.75,0:24:23.58,Default,,0,0,0,,Сіздің белгілеріңізде
Dialogue: 0,0:24:22.75,0:24:23.58,Default,,0,0,0,,Міне, ерлер арасындағы 100 метрге жүгіру финалы.
Dialogue: 0,0:24:23.58,0:24:25.75,Default,,0,0,0,,Міне, ерлер арасындағы 100 метрге жүгіру финалы.
Dialogue: 0,0:24:25.83,0:24:27.50,Default,,0,0,0,,Бастау
Dialogue: 0,0:24:29.42,0:24:30.51,Default,,0,0,0,,Жиын
Dialogue: 0,0:24:33.38,0:24:34.26,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:24:35.43,0:24:41.64,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,0:24:49.65,0:24:51.53,Default,,0,0,0,,(Бейсбол клубы мүшелерінің айқайы)
Dialogue: 0,0:24:51.53,0:24:52.69,Default,,0,0,0,,(Бейсбол клубы мүшелерінің айқайы)
Dialogue: 0,0:24:51.53,0:24:52.69,Default,,0,0,0,,(доп соғу дыбысы)
Dialogue: 0,0:24:52.69,0:24:56.32,Default,,0,0,0,,(Бейсбол клубы мүшелерінің айқайы)
Dialogue: 0,0:24:56.41,0:24:57.82,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:24:59.66,0:25:02.62,Default,,0,0,0,,Алаңды тек бейсбол командасы пайдаланады.
Dialogue: 0,0:25:02.70,0:25:04.08,Default,,0,0,0,,Бұл Тогаши-кун, солай ма?
Dialogue: 0,0:25:04.16,0:25:05.92,Default,,0,0,0,,Не? Хмм, қызық...
Dialogue: 0,0:25:06.00,0:25:06.92,Default,,0,0,0,,Ах... Аой
Dialogue: 0,0:25:07.67,0:25:08.84,Default,,0,0,0,,Тогаши-кун!
Dialogue: 0,0:25:08.92,0:25:11.17,Default,,0,0,0,,Бұл Тогаши-кун ғой, солай ма?
Dialogue: 0,0:25:11.25,0:25:13.26,Default,,0,0,0,,-Иә - (Асакуса) Үйірме жұмысын әлі шештіңіз бе?
Dialogue: 0,0:25:13.34,0:25:14.97,Default,,0,0,0,,Үйірмеге қосылғыңыз келмейді ме?
Dialogue: 0,0:25:15.05,0:25:18.14,Default,,0,0,0,,Мүмкін ол басқа жерде жаттығатын шығар?
Dialogue: 0,0:25:18.72,0:25:20.39,Default,,0,0,0,,Аа, кешіріңіз, мен кенет таң қалдым.
Dialogue: 0,0:25:20.47,0:25:23.64,Default,,0,0,0,,Мен қауесетті естідім, бірақ ол шынымен де оқуға түсті деп ойлаймын.
Dialogue: 0,0:25:23.73,0:25:25.31,Default,,0,0,0,,Бірақ сен менің үйіме не үшін келдің?
Dialogue: 0,0:25:25.39,0:25:27.23,Default,,0,0,0,,Беделді мектептерден барлаушылар көп болды, солай ма?
Dialogue: 0,0:25:27.31,0:25:28.86,Default,,0,0,0,,Менің үйіме жақын болды.
Dialogue: 0,0:25:28.94,0:25:30.40,Default,,0,0,0,,- (Асакуса) А? Бұл себеп пе? -Жақсы
Dialogue: 0,0:25:30.48,0:25:32.57,Default,,0,0,0,,А... Саған мұндай сұрақ қойғаным үшін кешір.
Dialogue: 0,0:25:32.65,0:25:33.69,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:25:33.78,0:25:35.15,Default,,0,0,0,,Аа, мен сізге сұрақ қойып жатқанда менің бір өтінішім бар...
Dialogue: 0,0:25:35.24,0:25:36.07,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,0:25:36.15,0:25:37.28,Default,,0,0,0,,Не? Әлі ештеңе...
Dialogue: 0,0:25:37.36,0:25:39.07,Default,,0,0,0,,Маған ұнамсыз нәрсені талап еткендей болдым.
Dialogue: 0,0:25:39.16,0:25:41.58,Default,,0,0,0,,Жоқ, жоқ, бұл таңқаларлық емес.
Dialogue: 0,0:25:41.66,0:25:43.04,Default,,0,0,0,,Жеңіл атлетика клубына қосылу...
Dialogue: 0,0:25:41.66,0:25:43.04,Default,,0,0,0,,Белгіге тигенім үшін кешіріңіз.
Dialogue: 0,0:25:43.04,0:25:43.83,Default,,0,0,0,,Белгіге тигенім үшін кешіріңіз.
Dialogue: 0,0:25:44.58,0:25:47.58,Default,,0,0,0,,Ах... у... Менің атым Аои Асакуса.
Dialogue: 0,0:25:48.63,0:25:49.46,Default,,0,0,0,,Бұл Тоғаши.
Dialogue: 0,0:25:49.54,0:25:51.09,Default,,0,0,0,,Хе, мен білемін.
Dialogue: 0,0:25:51.17,0:25:53.76,Default,,0,0,0,,Әй, сен неге жеңіл атлетика клубына қатыспайсың?
Dialogue: 0,0:25:53.84,0:25:56.84,Default,,0,0,0,,Учиса, қазір тек үш мүше бар.
Dialogue: 0,0:25:56.93,0:25:59.84,Default,,0,0,0,,Қазіргі уақытта жеңіл атлетикамен айналысқысы келетін балалар көп емес...
Dialogue: 0,0:25:59.93,0:26:01.85,Default,,0,0,0,,- (Асакуса) Уау! -Кешіріңіз.
Dialogue: 0,0:26:02.97,0:26:03.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:03.93,0:26:05.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:26:05.77,0:26:07.48,Default,,0,0,0,,Аой!
Dialogue: 0,0:26:08.94,0:26:11.56,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:26:26.45,0:26:27.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:27.96,0:26:28.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:26:30.25,0:26:31.08,Default,,0,0,0,,Бұл тест
Dialogue: 0,0:26:31.17,0:26:32.59,Default,,0,0,0,,Тогаши-кун.
Dialogue: 0,0:26:32.67,0:26:34.21,Default,,0,0,0,,Сен неге жасырынып жүрсің?
Dialogue: 0,0:26:34.30,0:26:36.63,Default,,0,0,0,,Атақты адамдардың түрлері көп.
Dialogue: 0,0:26:37.88,0:26:41.39,Default,,0,0,0,,Мм... Шектеулі нан бүгін де сатылып кетті ме?
Dialogue: 0,0:26:41.47,0:26:43.64,Default,,0,0,0,,Негізі, ол сатылып кеткен...
Dialogue: 0,0:26:43.72,0:26:44.93,Default,,0,0,0,,Хехехе
Dialogue: 0,0:26:45.02,0:26:46.31,Default,,0,0,0,,Уа... о...
Dialogue: 0,0:26:46.89,0:26:48.69,Default,,0,0,0,,Иә, соңғысы
Dialogue: 0,0:26:48.77,0:26:51.69,Default,,0,0,0,,Иә, жақсы ма? Сізге көп рахмет
Dialogue: 0,0:26:51.77,0:26:54.61,Default,,0,0,0,,Сіз Тогаши-кунсыз ба? Құрлықта 100 метр
Dialogue: 0,0:26:54.69,0:26:55.82,Default,,0,0,0,,Иә...
Dialogue: 0,0:26:55.90,0:26:57.49,Default,,0,0,0,,Ол атақты болғандықтан, мен оны оған арнадым.
Dialogue: 0,0:26:57.49,0:26:57.90,Default,,0,0,0,,Ол атақты болғандықтан, мен оны арнайы оған арнадым.
Dialogue: 0,0:26:57.49,0:26:57.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:57.90,0:26:57.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:57.99,0:26:58.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:57.99,0:26:58.65,Default,,0,0,0,,Иә! Ах...
Dialogue: 0,0:26:58.65,0:26:59.61,Default,,0,0,0,,Иә! Ах...
Dialogue: 0,0:26:59.70,0:27:00.91,Default,,0,0,0,,Асакуса мырза
Dialogue: 0,0:27:00.99,0:27:03.62,Default,,0,0,0,,Мені еске алғаныңызға рахмет.
Dialogue: 0,0:27:04.28,0:27:07.08,Default,,0,0,0,,Керемет~ Бұл дәмді.
Dialogue: 0,0:27:07.16,0:27:08.96,Default,,0,0,0,,А... бұл сізге керек пе?
Dialogue: 0,0:27:09.04,0:27:10.87,Default,,0,0,0,,О, жарайды, жарайды.
Dialogue: 0,0:27:10.96,0:27:12.33,Default,,0,0,0,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:27:12.42,0:27:15.55,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:27:16.13,0:27:17.92,Default,,0,0,0,,Апай, сізде Ивакоропан бар ма?
Dialogue: 0,0:27:16.13,0:27:17.92,Default,,0,0,0,,А... не?
Dialogue: 0,0:27:17.92,0:27:18.01,Default,,0,0,0,,А... не?
Dialogue: 0,0:27:18.01,0:27:18.63,Default,,0,0,0,,А... не?
Dialogue: 0,0:27:18.01,0:27:18.63,Default,,0,0,0,,Ол қазірдің өзінде сатылып кетті!
Dialogue: 0,0:27:18.63,0:27:20.05,Default,,0,0,0,,Ол қазірдің өзінде сатылып кетті!
Dialogue: 0,0:27:20.68,0:27:22.01,Default,,0,0,0,,Оның іске қосылғанын көргіңіз келе ме?
Dialogue: 0,0:27:22.09,0:27:22.93,Default,,0,0,0,,Иә
Dialogue: 0,0:27:23.01,0:27:24.64,Default,,0,0,0,,​​Не үшін?
Dialogue: 0,0:27:24.72,0:27:25.97,Default,,0,0,0,,Жылдамырақ болу үшін
Dialogue: 0,0:27:26.06,0:27:28.89,Default,,0,0,0,,Мен өлшемдердің тым әртүрлі екенін білемін, бірақ
Dialogue: 0,0:27:28.98,0:27:30.85,Default,,0,0,0,,Сонда да мен бас тарта алмаймын
Dialogue: 0,0:27:30.94,0:27:32.31,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:27:32.40,0:27:34.61,Default,,0,0,0,,Мен бұл әділ сауда емес деп ойлаймын...
Dialogue: 0,0:27:34.69,0:27:37.65,Default,,0,0,0,,Егер сіз біреуін іске қоссаңыз, мені енді сұрамаңыз.
Dialogue: 0,0:27:37.73,0:27:39.65,Default,,0,0,0,,Түсіндім, уәде беремін
Dialogue: 0,0:27:43.66,0:27:44.32,Default,,0,0,0,,Тұрақты бастау жақсы...
Dialogue: 0,0:27:44.32,0:27:44.91,Default,,0,0,0,,Тұрақты түрде бастау жақсы...
Dialogue: 0,0:27:44.32,0:27:44.91,Default,,0,0,0,,(Шыңғырлау дыбысы)
Dialogue: 0,0:27:44.91,0:27:44.99,Default,,0,0,0,,(пинг дыбысы)
Dialogue: 0,0:27:44.99,0:27:47.16,Default,,0,0,0,,(Шыңғырлау дыбысы)
Dialogue: 0,0:27:44.99,0:27:47.16,Default,,0,0,0,,Мүмкін болса, бүгуді бастаңыз
Dialogue: 0,0:27:47.16,0:27:47.66,Default,,0,0,0,,(пинг дыбысы)
Dialogue: 0,0:27:47.66,0:27:48.50,Default,,0,0,0,,(Шыңғырлау дыбысы)
Dialogue: 0,0:27:47.66,0:27:48.50,Default,,0,0,0,,Иә
Dialogue: 0,0:27:54.54,0:27:55.71,Default,,0,0,0,,Кеттік
Dialogue: 0,0:27:56.38,0:27:57.63,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:28:11.02,0:28:12.56,Default,,0,0,0,,Я...
Dialogue: 0,0:28:13.81,0:28:15.73,Default,,0,0,0,,Я...
Dialogue: 0,0:28:17.48,0:28:23.32,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:28:33.33,0:28:35.75,Default,,0,0,0,,Қазір не...
Dialogue: 0,0:28:36.58,0:28:38.17,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:28:41.72,0:28:43.17,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:28:50.64,0:28:52.64,Default,,0,0,0,,Бұл өте қауіпті, Тогаши-кун.
Dialogue: 0,0:28:52.73,0:28:55.56,Default,,0,0,0,,Оны сілтеме ретінде пайдалану менмендік болды.
Dialogue: 0,0:28:55.65,0:28:57.31,Default,,0,0,0,,Деңгей тым басқаша болды
Dialogue: 0,0:28:58.36,0:29:00.40,Default,,0,0,0,,Бірақ рахмет
Dialogue: 0,0:29:02.40,0:29:03.45,Default,,0,0,0,,Сәлем
Dialogue: 0,0:29:04.03,0:29:05.28,Default,,0,0,0,,Бірақ бұл жақсы болды.
Dialogue: 0,0:29:05.36,0:29:07.99,Default,,0,0,0,,Мен саған бірдеңе болды ма деп ойладым.
Dialogue: 0,0:29:08.07,0:29:09.74,Default,,0,0,0,,Осындай қауесеттер де болды.
Dialogue: 0,0:29:10.33,0:29:12.25,Default,,0,0,0,,Ах... хаха... а...
Dialogue: 0,0:29:13.00,0:29:15.37,Default,,0,0,0,,Менің қабілетім жоқ.
Dialogue: 0,0:29:15.46,0:29:18.04,Default,,0,0,0,,Неге олай ойлайтыныңды білмеймін...
Dialogue: 0,0:29:18.67,0:29:21.50,Default,,0,0,0,,Бірақ мен мұны шынымен айтқым келеді.
Dialogue: 0,0:29:21.59,0:29:23.67,Default,,0,0,0,,«Жеңіл атлетика жақсы»
Dialogue: 0,0:29:24.92,0:29:29.60,Default,,0,0,0,,Тоғашы-күн бізден бөлек, оның қолынан бәрі келетініне сенімдімін.
Dialogue: 0,0:29:29.68,0:29:32.77,Default,,0,0,0,,Сондықтан бұл да қызық болатынына сенімдімін
Dialogue: 0,0:29:32.85,0:29:34.98,Default,,0,0,0,,Бұл жақсы, жеңіл атлетика.
Dialogue: 0,0:29:35.52,0:29:37.94,Default,,0,0,0,,А... мынау
Dialogue: 0,0:29:38.56,0:29:40.36,Default,,0,0,0,,Бұл өтініш емес.
Dialogue: 0,0:29:41.23,0:29:42.11,Default,,0,0,0,,Хехе
Dialogue: 0,0:29:59.46,0:30:00.29,Default,,0,0,0,,А...
Dialogue: 0,0:30:01.25,0:30:04.96,Default,,0,0,0,,Мен бірде-бір жаңа мүше келеді деп күтпедім.
Dialogue: 0,0:30:05.05,0:30:08.30,Default,,0,0,0,,Ал, жеңіл атлетика танымал емес.
Dialogue: 0,0:30:11.18,0:30:12.31,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:30:12.39,0:30:13.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:15.31,0:30:16.89,Default,,0,0,0,,Тогаши-кун
Dialogue: 0,0:30:16.98,0:30:17.94,Default,,0,0,0,,Сәлем
Dialogue: 0,0:30:19.56,0:30:21.15,Default,,0,0,0,,Бұл туралы маған бұрын да айтқан болатын.
Dialogue: 0,0:30:21.23,0:30:23.94,Default,,0,0,0,,Мен сабақтан тыс жаттығатынмын.
Dialogue: 0,0:30:24.57,0:30:26.11,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:30:27.82,0:30:29.07,Default,,0,0,0,,Бұл жеткіліксіз
Dialogue: 0,0:30:29.16,0:30:32.70,Default,,0,0,0,,Кемінде 5 адам болса, ол клубтық іс-әрекет ретінде танылмайды.
Dialogue: 0,0:30:32.78,0:30:34.24,Default,,0,0,0,,5 адам...
Dialogue: 0,0:30:35.29,0:30:37.91,Default,,0,0,0,,Ендеше мен қосылсам да жетпейді, солай ма?
Dialogue: 0,0:30:38.87,0:30:41.33,Default,,0,0,0,,Тоғаши-күн, қазір не істеп жатырсың?
Dialogue: 0,0:30:41.42,0:30:43.13,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:30:43.84,0:30:47.01,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,0:30:47.09,0:30:50.68,Default,,0,0,0,,Сіз «кірсем де» дедіңіз
Dialogue: 0,0:30:51.89,0:30:53.05,Default,,0,0,0,,деді
Dialogue: 0,0:30:53.93,0:30:55.35,Default,,0,0,0,,Сіз шынымен кіргіңіз келе ме?
Dialogue: 0,0:30:55.43,0:30:56.39,Default,,0,0,0,,Иә
Dialogue: 0,0:30:56.47,0:30:58.94,Default,,0,0,0,,Бірақ менің денем жарақат алды немесе бірдеңе болды...
Dialogue: 0,0:30:59.02,0:31:00.06,Default,,0,0,0,,Ах~
Dialogue: 0,0:31:00.14,0:31:02.11,Default,,0,0,0,,Бұл жай ғана қауесет
Dialogue: 0,0:31:02.19,0:31:03.23,Default,,0,0,0,,Оны қызартып жіберген мен едім.
Dialogue: 0,0:31:03.31,0:31:04.69,Default,,0,0,0,,- (Мұғалім) А? -Ой жоқ.
Dialogue: 0,0:31:04.77,0:31:06.23,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:31:06.32,0:31:07.78,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:31:07.86,0:31:10.66,Default,,0,0,0,,5 немесе одан да көп мүше болуы керек деген ереже бар...
Dialogue: 0,0:31:10.74,0:31:14.62,Default,,0,0,0,,Мен не айтарымды білмеймін, бірақ мен.
Dialogue: 0,0:31:14.70,0:31:16.70,Default,,0,0,0,,Арнайы ережелермен бірдеңе жасауға бола ма?
Dialogue: 0,0:31:17.33,0:31:19.75,Default,,0,0,0,,Жарайды, бірақ мен сенімдімін...
Dialogue: 0,0:31:20.71,0:31:22.92,Default,,0,0,0,,Бірақ белгілі бір мәселе бар.
Dialogue: 0,0:31:23.50,0:31:24.84,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:31:24.92,0:31:26.13,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:31:26.21,0:31:29.22,Default,,0,0,0,,Жойылған бөлім қандай да бір жолмен өседі, сондықтан бөлім нәтиже шығаруы керек.
Dialogue: 0,0:31:29.30,0:31:31.80,Default,,0,0,0,,Егер сіз мұны жасасаңыз, мүмкін емес нәрсені жеңе білуіңіз керек.
Dialogue: 0,0:31:31.89,0:31:33.09,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:31:33.18,0:31:34.05,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:31:34.14,0:31:36.39,Default,,0,0,0,,Ең соңғы турнир қашан болды?
Dialogue: 0,0:31:37.14,0:31:39.60,Default,,0,0,0,,Көрші мектептер арасында бәсекелестік бар ма?
Dialogue: 0,0:31:39.68,0:31:41.69,Default,,0,0,0,,Ендеше оған кірісейік.
Dialogue: 0,0:31:41.77,0:31:43.02,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:31:43.10,0:31:43.94,Default,,0,0,0,,Бірақ мен Юлий деген адам емеспін.
Dialogue: 0,0:31:44.02,0:31:46.77,Default,,0,0,0,,Аралас 800 метрлік эстафета бар.
Dialogue: 0,0:31:46.86,0:31:48.90,Default,,0,0,0,,Реле осы уақытта өтсе де,
Dialogue: 0,0:31:48.99,0:31:51.11,Default,,0,0,0,,Бұл турнир, 8-ші басылым
Dialogue: 0,0:31:51.20,0:31:53.45,Default,,0,0,0,,Ол негізгі оқиға сияқты орналастырылған, солай емес пе?
Dialogue: 0,0:31:53.53,0:31:57.04,Default,,0,0,0,,Онда жеңіске жету кез келген басқа оқиғаға қарағанда маңыздырақ сияқты.
Dialogue: 0,0:31:57.12,0:31:58.75,Default,,0,0,0,,Жасырын атмосфера...
Dialogue: 0,0:31:58.83,0:32:01.62,Default,,0,0,0,,Мен сенімдімін... Мен бірінші курста қатыстым.
Dialogue: 0,0:32:01.71,0:32:03.92,Default,,0,0,0,,8-ші маусымның қызуы керемет болды.
Dialogue: 0,0:32:04.50,0:32:05.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:32:05.59,0:32:06.71,Default,,0,0,0,,Жеңіске жететін болсақ, бөлімше
Dialogue: 0,0:32:06.79,0:32:08.76,Default,,0,0,0,,Бұл айтарлықтай әсер етеді.
Dialogue: 0,0:32:08.84,0:32:11.51,Default,,0,0,0,,Сонда тағы бір бала бар.
Dialogue: 0,0:32:11.59,0:32:15.05,Default,,0,0,0,,Ойлап қарасам, жеңіл атлетика клубында үш адам бар дедіңіз.
Dialogue: 0,0:32:15.14,0:32:17.26,Default,,0,0,0,,Сіз елес мүшесіз бе?
Dialogue: 0,0:32:18.01,0:32:21.10,Default,,0,0,0,,Жарайды, бұл пайдалы болады деп ойлаймын, бірақ...
Dialogue: 0,0:32:21.18,0:32:22.02,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:32:22.10,0:32:24.19,Default,,0,0,0,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,0:32:25.61,0:32:28.40,Default,,0,0,0,,Ым... Тоғаши-күн
Dialogue: 0,0:32:28.48,0:32:29.48,Default,,0,0,0,,Иә
Dialogue: 0,0:32:30.19,0:32:33.49,Default,,0,0,0,,Сіздің клубқа қосылғаныңызға өте қуаныштымын, бірақ...
Dialogue: 0,0:32:34.41,0:32:35.57,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:32:36.16,0:32:38.58,Default,,0,0,0,,Көріп тұрғаныңыздай, Асакуса-сан.
Dialogue: 0,0:32:38.66,0:32:41.37,Default,,0,0,0,,Мен жеңіл атлетикадан кетуді ойладым.
Dialogue: 0,0:32:41.96,0:32:44.67,Default,,0,0,0,,Дәлірек айтсам, мен мүлде қозғала алмадым.
Dialogue: 0,0:32:44.75,0:32:48.21,Default,,0,0,0,,Орта мектептегі үш жыл бойы рекордтарым мен күткендей жақсармады.
Dialogue: 0,0:32:48.29,0:32:50.67,Default,,0,0,0,,Мен жүгіруге немесе тоқтауға қорқамын.
Dialogue: 0,0:32:50.76,0:32:52.51,Default,,0,0,0,,Айналмалы жолмен
Dialogue: 0,0:32:52.59,0:32:57.72,Default,,0,0,0,,Бірақ кеше Асакуса-сан маған біраз уақыттан кейін бірінші рет мүмкіндігінше жүгіруімді өтінді.
Dialogue: 0,0:32:58.30,0:33:01.27,Default,,0,0,0,,Не айтайын, сездім.
Dialogue: 0,0:33:01.85,0:33:03.35,Default,,0,0,0,,Мен жылдаммын
Dialogue: 0,0:33:03.43,0:33:04.89,Default,,0,0,0,,Назар аударыңыз
Dialogue: 0,0:33:04.98,0:33:07.02,Default,,0,0,0,,Мен қайтадан жүгіруді шештім.
Dialogue: 0,0:33:07.11,0:33:09.77,Default,,0,0,0,,Рахмет айту керек адаммын.
Dialogue: 0,0:33:09.86,0:33:11.28,Default,,0,0,0,,Рахмет
Dialogue: 0,0:33:11.36,0:33:12.61,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:33:12.69,0:33:16.24,Default,,0,0,0,,Мм... Мен жай ғана Тоғашидың жүгіргенін көргім келді.
Dialogue: 0,0:33:17.12,0:33:19.62,Default,,0,0,0,,Маған жеңіл атлетика клубына қосылуға рұқсат етіңіз.
Dialogue: 0,0:33:21.16,0:33:25.42,Default,,0,0,0,,Иә, жеңіл атлетика клубына қош келдіңіз, Тогаши-кун.
Dialogue: 0,0:33:31.96,0:33:34.76,Default,,0,0,0,,Ол мотивация алады деп үміттенемін...
Dialogue: 0,0:33:34.84,0:33:36.59,Default,,0,0,0,,Бұл керемет пе?
Dialogue: 0,0:33:36.68,0:33:39.35,Default,,0,0,0,,Мен клубқа мүлдем келмеймін.
Dialogue: 0,0:33:39.43,0:33:44.02,Default,,0,0,0,,Мен үлкен үміт күтпеймін, бірақ ертең сізбен сөйлесуім мүмкін.
Dialogue: 0,0:33:44.10,0:33:46.85,Default,,0,0,0,,Жоқ, қазір барайық.
Dialogue: 0,0:33:51.94,0:33:54.49,Default,,0,0,0,,Бұл жоғарғы жағындағы пәтер.
Dialogue: 0,0:33:54.57,0:33:55.40,Default,,0,0,0,,Иә
Dialogue: 0,0:34:04.00,0:34:04.83,Default,,0,0,0,,Иә
Dialogue: 0,0:34:04.91,0:34:06.54,Default,,0,0,0,,Асакуса
Dialogue: 0,0:34:06.62,0:34:08.04,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:34:08.12,0:34:09.79,Default,,0,0,0,,Бір сәт сөйлесе аламыз ба?
Dialogue: 0,0:34:13.80,0:34:14.96,Default,,0,0,0,,А...
Dialogue: 0,0:34:15.59,0:34:17.01,Default,,0,0,0,,Джинджин мырза?
Dialogue: 0,0:34:17.09,0:34:18.26,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:34:18.34,0:34:20.76,Default,,0,0,0,,Жарайды, мен сен осылай айтасың деп ойладым.
Dialogue: 0,0:34:20.85,0:34:23.39,Default,,0,0,0,,Мм... неге Джинджин мырза біріншіден солай істеді?
Dialogue: 0,0:34:23.47,0:34:25.85,Default,,0,0,0,,Жеңіл атлетикадан беделді мектеп те емес. Менің мектебімде?
Dialogue: 0,0:34:25.93,0:34:29.94,Default,,0,0,0,,Мен сіздің айтқаныңызды дәл айта аламын ба?
Dialogue: 0,0:34:30.02,0:34:31.90,Default,,0,0,0,,А... жоқ, бұл...
Dialogue: 0,0:34:31.98,0:34:35.90,Default,,0,0,0,,Мен өзімді-өзім ауыртып, арқамды ауыртып алдым.
Dialogue: 0,0:34:35.99,0:34:38.36,Default,,0,0,0,,Сондықтан мен жеңіл атлетикамен айналыса алмадым.
Dialogue: 0,0:34:38.45,0:34:39.99,Default,,0,0,0,,Жаңа ғана жергілікті аймаққа қосылды
Dialogue: 0,0:34:40.07,0:34:43.37,Default,,0,0,0,,Неліктен сіз әлі күнге дейін жеңіл атлетика клубының мүшесісіз?
Dialogue: 0,0:34:43.95,0:34:47.08,Default,,0,0,0,,Үйірмеге кіру керек деген ереже болды.
Dialogue: 0,0:34:47.66,0:34:50.50,Default,,0,0,0,,Асакуса табанды болды, сондықтан мен оған атымды бердім.
Dialogue: 0,0:34:50.58,0:34:52.17,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:34:53.54,0:34:57.38,Default,,0,0,0,,Сіздің арқаңыз әлі ауыр ма? Мен жүгіре алмайтыным сонша
Dialogue: 0,0:34:57.97,0:35:00.18,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:35:00.26,0:35:02.09,Default,,0,0,0,,Қайта жүгіріп көргіңіз келе ме?
Dialogue: 0,0:35:02.18,0:35:04.18,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:35:04.26,0:35:06.22,Default,,0,0,0,,Оны осылай қалдыру шынымен дұрыс па?
Dialogue: 0,0:35:06.31,0:35:08.35,Default,,0,0,0,,Бұл дүниеде жоқ
Dialogue: 0,0:35:09.94,0:35:11.15,Default,,0,0,0,,Бар болғаны 100 метр
Dialogue: 0,0:35:11.23,0:35:14.23,Default,,0,0,0,,Кейбір адамдардың өмірі бұзылған.
Dialogue: 0,0:35:17.74,0:35:19.32,Default,,0,0,0,,-Мм... -(Джинджин) Ммм...
Dialogue: 0,0:35:19.90,0:35:22.53,Default,,0,0,0,,Менімен біраз уақыт араласа аласыз ба?
Dialogue: 0,0:35:22.62,0:35:25.03,Default,,0,0,0,,Аз неше минут?
Dialogue: 0,0:35:25.91,0:35:26.95,Default,,0,0,0,,10 секунд
Dialogue: 0,0:35:27.04,0:35:29.37,Default,,0,0,0,,98 99…
Dialogue: 0,0:35:29.46,0:35:30.96,Default,,0,0,0,,100…
Dialogue: 0,0:35:34.46,0:35:35.88,Default,,0,0,0,,Міне!
Dialogue: 0,0:35:35.96,0:35:37.30,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:35:38.21,0:35:40.97,Default,,0,0,0,,Мен жарты жыл бойы араласып, мүлде жүгірген жоқпын.
Dialogue: 0,0:35:40.97,0:35:41.80,Default,,0,0,0,,Мен жарты жыл бойы араласып, мүлде жүгірген жоқпын.
Dialogue: 0,0:35:40.97,0:35:41.80,Default,,0,0,0,,Асакуса мырза
Dialogue: 0,0:35:41.88,0:35:43.18,Default,,0,0,0,,Сигнал беріңізші
Dialogue: 0,0:35:43.26,0:35:44.10,Default,,0,0,0,,Жарайды
Dialogue: 0,0:35:44.18,0:35:46.39,Default,,0,0,0,,Әй, сен мұны естімедің.
Dialogue: 0,0:35:46.97,0:35:50.23,Default,,0,0,0,,Сіз қаншалықты жылдам екеніңізді түсінбейтін сияқтысыз.
Dialogue: 0,0:35:50.31,0:35:51.44,Default,,0,0,0,,50 рет
Dialogue: 0,0:35:52.19,0:35:54.52,Default,,0,0,0,,Бұл мен ойлағаннан 50 есе көп.
Dialogue: 0,0:35:54.61,0:35:55.82,Default,,0,0,0,,Иә.
Dialogue: 0,0:35:56.57,0:35:58.78,Default,,0,0,0,,Нәтижесі анық.
Dialogue: 0,0:35:58.86,0:36:00.95,Default,,0,0,0,,Екеуің дайынсыңдар ма?
Dialogue: 0,0:36:01.45,0:36:02.86,Default,,0,0,0,,- (Джинджин) А - Жарайды.
Dialogue: 0,0:36:02.95,0:36:04.37,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:36:04.45,0:36:06.49,Default,,0,0,0,,Орналасуға қатысты
Dialogue: 0,0:36:06.58,0:36:08.04,Default,,0,0,0,,Жақсы
Dialogue: 0,0:36:11.62,0:36:12.54,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:36:16.92,0:36:19.63,Default,,0,0,0,,(Джиндзиннің дөрекі тынысы)
Dialogue: 0,0:36:19.71,0:36:20.88,Default,,0,0,0,,Я...
Dialogue: 0,0:36:21.55,0:36:22.38,Default,,0,0,0,,Я...
Dialogue: 0,0:36:23.51,0:36:24.34,Default,,0,0,0,,Я...
Dialogue: 0,0:36:25.55,0:36:26.51,Default,,0,0,0,,Я...
Dialogue: 0,0:36:27.22,0:36:28.51,Default,,0,0,0,,Я...
Dialogue: 0,0:36:29.39,0:36:30.39,Default,,0,0,0,,Я...
Dialogue: 0,0:36:31.23,0:36:32.06,Default,,0,0,0,,Я...
Dialogue: 0,0:36:32.94,0:36:34.19,Default,,0,0,0,,Жылдам
Dialogue: 0,0:36:36.81,0:36:43.78,Default,,0,0,0,,(Джиндзиннің дөрекі тынысы)
Dialogue: 0,0:36:56.67,0:36:57.67,Default,,0,0,0,,Уақыт қанша?
Dialogue: 0,0:36:59.21,0:37:00.96,Default,,0,0,0,,12 секунд 13
Dialogue: 0,0:37:02.01,0:37:03.76,Default,,0,0,0,,12 секунд…
Dialogue: 0,0:37:07.18,0:37:08.22,Default,,0,0,0,,Иә
Dialogue: 0,0:37:30.28,0:37:32.54,Default,,0,0,0,,Турнирге небәрі 3 апта қалды
Dialogue: 0,0:37:32.62,0:37:34.96,Default,,0,0,0,,Мүмкіндігінше тиімді жаттығу
Dialogue: 0,0:37:35.04,0:37:37.00,Default,,0,0,0,,Мен жүгіру ретін алдын ала шешемін деп ойлаймын.
Dialogue: 0,0:37:37.08,0:37:38.46,Default,,0,0,0,,1-ші жүгіру Асакуса
Dialogue: 0,0:37:38.54,0:37:39.38,Default,,0,0,0,,Иә
Dialogue: 0,0:37:39.46,0:37:41.34,Default,,0,0,0,,- (Джинджин) 2-ші жүгіру Шиина - (Шиина) Иә
Dialogue: 0,0:37:41.42,0:37:44.05,Default,,0,0,0,,Мен олардың бірінші таймда барын салғанын қалаймын.
Dialogue: 0,0:37:44.84,0:37:47.05,Default,,0,0,0,,3-ші жүгіру Тогаши-кун
Dialogue: 0,0:37:47.13,0:37:48.05,Default,,0,0,0,,Иә
Dialogue: 0,0:37:48.14,0:37:51.31,Default,,0,0,0,,Мен зәкірді маған қалдырғаныңызды қалаймын.
Dialogue: 0,0:37:51.39,0:37:54.14,Default,,0,0,0,,Мен якорьді Тоғаши-кунға қалдырсам қалай болады?
Dialogue: 0,0:37:54.23,0:37:55.31,Default,,0,0,0,,Иә.
Dialogue: 0,0:37:55.39,0:37:58.73,Default,,0,0,0,,Бастапқыда бұл жақсы идея болуы мүмкін, бірақ
Dialogue: 0,0:37:59.31,0:38:02.15,Default,,0,0,0,,Гүлдену кезеңіне жақын күйге оралу
Dialogue: 0,0:38:02.23,0:38:03.36,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:38:03.44,0:38:06.99,Default,,0,0,0,,Сондай-ақ, мен эстафеталық жолдама үшін төмен сыпыруды қолданамын деп ойлаймын.
Dialogue: 0,0:38:07.07,0:38:09.20,Default,,0,0,0,,Дауыс...
Dialogue: 0,0:38:09.28,0:38:12.95,Default,,0,0,0,,Басуға қарағанда көбірек қашықтыққа жетуге болады, бірақ...
Dialogue: 0,0:38:13.04,0:38:15.08,Default,,0,0,0,,Көзбен көру қиын
Dialogue: 0,0:38:15.87,0:38:17.87,Default,,0,0,0,,Оқты өткізіп алу қаупі де бар.
Dialogue: 0,0:38:17.96,0:38:21.09,Default,,0,0,0,,Бірақ байқап көруге тұрарлық.
Dialogue: 0,0:38:21.17,0:38:24.17,Default,,0,0,0,,Әрине, мен тәуекелдердің жоғары екенін білемін.
Dialogue: 0,0:38:24.26,0:38:26.67,Default,,0,0,0,,Мен Кацуонишиге қарсы жеңіске жетуім керек.
Dialogue: 0,0:38:26.76,0:38:27.80,Default,,0,0,0,,Кацуониши?
Dialogue: 0,0:38:27.88,0:38:30.39,Default,,0,0,0,,Иә, Джинджин-кунның ескі ұясы.
Dialogue: 0,0:38:32.05,0:38:34.18,Default,,0,0,0,,Бұл жеңуге тұрарлық.
Dialogue: 0,0:38:34.27,0:38:37.69,Default,,0,0,0,,Әй, қарсы жаққа ештеңе жетпейді.
Dialogue: 0,0:38:37.77,0:38:40.06,Default,,0,0,0,,(Асакусаның ауыр тыныс алуы)
Dialogue: 0,0:38:40.90,0:38:41.81,Default,,0,0,0,,Ха… а…
Dialogue: 0,0:38:41.90,0:38:45.48,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:38:45.57,0:38:47.07,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:38:47.15,0:38:50.61,Default,,0,0,0,,Даунсвеп мен ойлағаннан да қиын.
Dialogue: 0,0:38:50.70,0:38:53.20,Default,,0,0,0,,Мүмкін менің бастамам сәл ерте болған шығар.
Dialogue: 0,0:38:53.28,0:38:54.79,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,0:38:54.87,0:38:56.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:38:54.87,0:38:56.08,Default,,0,0,0,,(Джиндзиннің дөрекі тынысы)
Dialogue: 0,0:38:57.91,0:38:58.75,Default,,0,0,0,,Жылдам
Dialogue: 0,0:38:58.83,0:39:02.29,Default,,0,0,0,,Бұл екеуі басқа деңгейде, сондықтан біз де бар күшімізді салайық.
Dialogue: 0,0:39:02.38,0:39:03.63,Default,,0,0,0,,Тек жаттығу.
Dialogue: 0,0:39:03.71,0:39:04.55,Default,,0,0,0,,Иә
Dialogue: 0,0:39:05.71,0:39:07.72,Default,,0,0,0,,Тәжірибенің бірінші күнінен кейін қалу?
Dialogue: 0,0:39:07.80,0:39:10.72,Default,,0,0,0,,Жақсысың ба, Джинджин-кун, кенет мені осылай итеріп жіберді?
Dialogue: 0,0:39:10.80,0:39:12.64,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:39:13.85,0:39:15.22,Default,,0,0,0,,Дайындаманы қалпына келтіру үшін
Dialogue: 0,0:39:15.31,0:39:17.81,Default,,0,0,0,,Аздап дөрекілеуден басқа амалым болмаса да
Dialogue: 0,0:39:17.89,0:39:21.02,Default,,0,0,0,,Бұл сіздің жамбаңызда бомба алып жүргеніңізді өзгертпейді.
Dialogue: 0,0:39:21.10,0:39:22.90,Default,,0,0,0,,Дұрыс~
Dialogue: 0,0:39:22.98,0:39:26.07,Default,,0,0,0,,Асакуса мырза, бүгін көңілді болатын сияқты.
Dialogue: 0,0:39:26.15,0:39:28.86,Default,,0,0,0,,Хехехе, бұл қызық.
Dialogue: 0,0:39:28.94,0:39:31.41,Default,,0,0,0,,Өйткені сол Тоғаши-кун
Dialogue: 0,0:39:31.49,0:39:33.87,Default,,0,0,0,,Сол Джинджин-кунмен жүгіруге болады.
Dialogue: 0,0:39:33.95,0:39:36.62,Default,,0,0,0,,Торғай Біз керемет мүшеміз.
Dialogue: 0,0:39:36.70,0:39:38.08,Default,,0,0,0,,Мен реле жүргізіп жатырмын.
Dialogue: 0,0:39:38.16,0:39:40.00,Default,,0,0,0,,Клуб жойылу алдында тұрды.
Dialogue: 0,0:39:40.08,0:39:43.25,Default,,0,0,0,,Жарайды, менен сұрасаңыз, бұл рас.
Dialogue: 0,0:39:43.33,0:39:47.17,Default,,0,0,0,,Неге екені белгісіз, мен Джинджин-кунды осал күйде ғана көрдім.
Dialogue: 0,0:39:47.25,0:39:50.13,Default,,0,0,0,,Мен Тоғаши-кунмен кездескенде ол кәдімгі бала еді.
Dialogue: 0,0:39:50.22,0:39:52.30,Default,,0,0,0,,Мен мұны мүлдем сезбедім.
Dialogue: 0,0:39:52.38,0:39:55.51,Default,,0,0,0,,Шиина-сан, сен мені қандай адам деп ойладың?
Dialogue: 0,0:39:55.60,0:39:57.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:39:57.93,0:40:00.02,Default,,0,0,0,,Міне, мен ойлағандай болды деп ойлаймын.
Dialogue: 0,0:40:00.10,0:40:01.52,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:40:01.60,0:40:05.40,Default,,0,0,0,,Бұл клубтың жойылу алдында тұрғанын өзгертпейді.
Dialogue: 0,0:40:06.02,0:40:07.69,Default,,0,0,0,,Мен саған рұқсат бермеймін.
Dialogue: 0,0:40:49.90,0:40:56.03,Default,,0,0,0,,(Джиндзиннің дөрекі тынысы)
Dialogue: 0,0:41:08.96,0:41:10.17,Default,,0,0,0,,Сіз бір нәрсені ұмыттыңыз ба?
Dialogue: 0,0:41:11.13,0:41:13.17,Default,,0,0,0,,Мен көп жұмыс істеуге алаңдаймын.
Dialogue: 0,0:41:13.26,0:41:14.63,Default,,0,0,0,,Мен не болып жатқанын көру үшін келдім.
Dialogue: 0,0:41:14.72,0:41:16.39,Default,,0,0,0,,А, жоқ... Айтайын дегенім... Мен уайымдап отырмын.
Dialogue: 0,0:41:16.47,0:41:18.89,Default,,0,0,0,,Әрине, Джинджин-сан түзетулер енгізіп жатыр, бірақ...
Dialogue: 0,0:41:18.97,0:41:20.47,Default,,0,0,0,,Тек сенімді болу үшін...
Dialogue: 0,0:41:20.56,0:41:22.27,Default,,0,0,0,,Біраз уақыттан кейін бірінші рет жаттығу жасағанда, бәріңіз толқып кетесіз.
Dialogue: 0,0:41:22.35,0:41:24.02,Default,,0,0,0,,Бос орындар бар...
Dialogue: 0,0:41:25.02,0:41:28.06,Default,,0,0,0,,Хмм... Мен сенің соңынан ерген жоқпын.
Dialogue: 0,0:41:28.94,0:41:31.65,Default,,0,0,0,,Нақты орындауға екі күн қалды. Мен ештеңе істемеймін.
Dialogue: 0,0:41:31.73,0:41:33.49,Default,,0,0,0,,Солай етіңіз.
Dialogue: 0,0:41:33.57,0:41:35.91,Default,,0,0,0,,Олай болса, алдымен кешірім сұраймын.
Dialogue: 0,0:41:36.61,0:41:38.03,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:41:39.58,0:41:43.00,Default,,0,0,0,,Неліктен бұл жерді таңдадыңыз? Әр жерден шақырулар болды.
Dialogue: 0,0:41:47.04,0:41:48.42,Default,,0,0,0,,Қысым?
Dialogue: 0,0:41:50.29,0:41:52.67,Default,,0,0,0,,Мен мұны білмей тұрып, оған тәуелді болдым.
Dialogue: 0,0:41:53.30,0:41:54.88,Default,,0,0,0,,Мен үшін жүгіру
Dialogue: 0,0:41:54.97,0:41:58.05,Default,,0,0,0,,Бұл өмірдегі ең оңай нұсқа болды.
Dialogue: 0,0:41:58.80,0:42:01.93,Default,,0,0,0,,Сұранысқа ие болу және бағалану
Dialogue: 0,0:42:02.01,0:42:04.02,Default,,0,0,0,,Жалғыз емес
Dialogue: 0,0:42:04.10,0:42:07.44,Default,,0,0,0,,Мен туа біттім.
Dialogue: 0,0:42:10.11,0:42:11.86,Default,,0,0,0,,Мен де ұқсаспын.
Dialogue: 0,0:42:18.24,0:42:21.49,Default,,0,0,0,,Жапониядан келген бұрынғы 100 метрлік өкіл әкенің басшылығымен
Dialogue: 0,0:42:21.58,0:42:24.25,Default,,0,0,0,,Мен мұны білмей тұрып, мен жеңіске лайықты жағдайда болдым.
Dialogue: 0,0:42:31.25,0:42:35.26,Default,,0,0,0,,Әкемнің сыйы деп бір күні айттым ғой.
Dialogue: 0,0:42:35.92,0:42:40.84,Default,,0,0,0,,«Егер сіз сонда қалғыңыз келсе, сіз әрқашан абсолютті болуыңыз керек».
Dialogue: 0,0:42:41.64,0:42:43.31,Default,,0,0,0,,Мен өзімді жаншып бара жатқандай сезіндім.
Dialogue: 0,0:42:43.81,0:42:45.31,Default,,0,0,0,,Өзіңізді физикалық тұрғыдан нашар сезінсеңіз де
Dialogue: 0,0:42:45.39,0:42:47.43,Default,,0,0,0,,Мен оны итеріп, орындаудан басқа амалым қалмады.
Dialogue: 0,0:42:48.02,0:42:51.27,Default,,0,0,0,,Құрлықта ұтқаннан ұтқаның, құрлықта ұтылғаның.
Dialogue: 0,0:42:51.86,0:42:56.44,Default,,0,0,0,,Одан қорқатын болсаңыз, 0,001 секунд болса да жеңе беруден басқа амалыңыз жоқ.
Dialogue: 0,0:42:58.49,0:43:01.07,Default,,0,0,0,,Оған қайта оралудан басқа амалымыз жоқ.
Dialogue: 0,0:43:11.54,0:43:14.30,Default,,0,0,0,,Тогаши мен Джинджин жеңіл атлетиканы тастамады ма?
Dialogue: 0,0:43:14.38,0:43:15.63,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:43:16.42,0:43:18.76,Default,,0,0,0,,Мен біреудің маған қарап тұрғанын сеземін.
Dialogue: 0,0:43:18.84,0:43:22.22,Default,,0,0,0,,Егер бұл екеуі бірге көрінсе.
Dialogue: 0,0:43:22.30,0:43:23.22,Default,,0,0,0,,Йо
Dialogue: 0,0:43:24.76,0:43:26.85,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:43:26.93,0:43:30.14,Default,,0,0,0,,Шығару мерзімі аяқталды ма? Джинджин
Dialogue: 0,0:43:30.23,0:43:33.65,Default,,0,0,0,,Менің ойымша, бұл сәл жылдамырақ, Ономичи.
Dialogue: 0,0:43:33.73,0:43:36.86,Default,,0,0,0,,Ей, енді мықты болатын кез келді.
Dialogue: 0,0:43:37.44,0:43:37.78,Default,,0,0,0,,3 сағаттан кейін
Dialogue: 0,0:43:37.78,0:43:38.61,Default,,0,0,0,,3 сағаттан кейін
Dialogue: 0,0:43:37.78,0:43:38.61,Default,,0,0,0,,Жоқ, бұл тек қана тәжірибе.
Dialogue: 0,0:43:38.69,0:43:40.07,Default,,0,0,0,,Коичи Ономичи
Dialogue: 0,0:43:38.69,0:43:40.07,Default,,0,0,0,,Сіз менің арқама табынатын боласыз.
Dialogue: 0,0:43:40.07,0:43:40.15,Default,,0,0,0,,Сіз менің арқама табынатын боласыз.
Dialogue: 0,0:43:40.15,0:43:41.07,Default,,0,0,0,,Сіз менің арқама табынатын боласыз.
Dialogue: 0,0:43:40.15,0:43:41.07,Default,,0,0,0,,Конака мен Джинджин-кунның артына жасырынған өзін қарсылас санайтын адам.
Dialogue: 0,0:43:41.07,0:43:41.16,Default,,0,0,0,,Конака мен Джинджин-кунның артына жасырынған өзін қарсылас санайтын адам.
Dialogue: 0,0:43:41.16,0:43:42.74,Default,,0,0,0,,Конака мен Джинджин-кунның артына жасырынған өзін қарсылас деп атаған.
Dialogue: 0,0:43:41.16,0:43:42.74,Default,,0,0,0,,Айза мен Игава мырзамен бәсекелесуден туған дыбыс—
Dialogue: 0,0:43:42.74,0:43:43.32,Default,,0,0,0,,Конака мен Джинджин-кунның артына жасырынған өзін қарсылас деп атаған.
Dialogue: 0,0:43:43.41,0:43:45.66,Default,,0,0,0,,Сәлем! Мен сені ести алмаймын
Dialogue: 0,0:43:45.74,0:43:48.37,Default,,0,0,0,,Мені жеңе алмаған себебің ерте туылғансың.
Dialogue: 0,0:43:48.45,0:43:49.66,Default,,0,0,0,,Сіз жеңілгеніңізге ренжідім дедіңіз.
Dialogue: 0,0:43:49.75,0:43:52.50,Default,,0,0,0,,Мен наурызмын, сен сәуірсің
Dialogue: 0,0:43:52.58,0:43:55.17,Default,,0,0,0,,Толық жыл айырмашылығы кемшілік екені анық, солай емес пе?
Dialogue: 0,0:43:55.25,0:43:57.55,Default,,0,0,0,,Қабілетіңіз болса, бәрібір.
Dialogue: 0,0:43:57.63,0:44:00.42,Default,,0,0,0,,Мен 29 наурыз деп ойлаймын?
Dialogue: 0,0:44:00.51,0:44:02.47,Default,,0,0,0,,Бүгін сіз үшін 2 сәуір.
Dialogue: 0,0:44:03.05,0:44:06.22,Default,,0,0,0,,Жарайды, мен сенен жеңілгім келмейді, тұйық.
Dialogue: 0,0:44:06.31,0:44:08.14,Default,,0,0,0,,- (Режиссер Кацуониши) Не істеп жатырсың, Ономичи - (Ономичи) Ху...
Dialogue: 0,0:44:08.22,0:44:09.68,Default,,0,0,0,,Қадағалау!
Dialogue: 0,0:44:11.35,0:44:12.48,Default,,0,0,0,,Ойын алдында.
Dialogue: 0,0:44:12.56,0:44:14.44,Default,,0,0,0,,Иә! Кешіріңіз
Dialogue: 0,0:44:15.40,0:44:17.52,Default,,0,0,0,,Сіз де Иваджиде болдыңыз ба?
Dialogue: 0,0:44:18.23,0:44:19.19,Default,,0,0,0,,Сәлем
Dialogue: 0,0:44:23.24,0:44:25.16,Default,,0,0,0,,Шындық осында.
Dialogue: 0,0:44:25.24,0:44:28.87,Default,,0,0,0,,Мен соңғы үш аптада қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:44:29.54,0:44:32.12,Default,,0,0,0,,Басқа мектептер үшін биылғы жазғы турнирге дайындық...
Dialogue: 0,0:44:32.21,0:44:34.12,Default,,0,0,0,,Бұл құрғақ жүгіру сияқты.
Dialogue: 0,0:44:34.21,0:44:37.50,Default,,0,0,0,,Бірақ бұл шайқаста міндетті түрде абырой бар.
Dialogue: 0,0:44:37.59,0:44:38.75,Default,,0,0,0,,800 метр…
Dialogue: 0,0:44:38.84,0:44:41.05,Default,,0,0,0,,Күндерімізді дәлелдеу
Dialogue: 0,0:44:47.55,0:44:51.02,Default,,0,0,0,,(Ономичидің ауыр тыныс алуы)
Dialogue: 0,0:44:51.10,0:44:52.31,Default,,0,0,0,,Мен мұны аздап істеймін.
Dialogue: 0,0:44:52.39,0:44:53.48,Default,,0,0,0,,Қарсылас күткендей
Dialogue: 0,0:44:53.56,0:44:54.52,Default,,0,0,0,,Өзін-өзі жариялады
Dialogue: 0,0:44:54.60,0:44:55.73,Default,,0,0,0,,Сәлем Джинджин!
Dialogue: 0,0:44:55.81,0:44:57.69,Default,,0,0,0,,Неліктен мен 100 ала алмаймын?
Dialogue: 0,0:44:57.77,0:45:00.44,Default,,0,0,0,,100 алу туралы бір ауыз сөз де айтпа.
Dialogue: 0,0:45:00.53,0:45:02.24,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:45:02.32,0:45:05.82,Default,,0,0,0,,Сонымен, сіз оны аралас 800-ге дейін қысқарттыңыз.
Dialogue: 0,0:45:05.91,0:45:08.33,Default,,0,0,0,,Қызық! Хаха...
Dialogue: 0,0:45:08.41,0:45:09.45,Default,,0,0,0,,Ол көңілді адам.
Dialogue: 0,0:45:09.45,0:45:09.79,Default,,0,0,0,,Ол көңілді адам.
Dialogue: 0,0:45:09.45,0:45:09.79,Default,,0,0,0,,...Сша!
Dialogue: 0,0:45:09.79,0:45:09.87,Default,,0,0,0,,...Сша!
Dialogue: 0,0:45:09.87,0:45:10.91,Default,,0,0,0,,...Сша!
Dialogue: 0,0:45:09.87,0:45:10.91,Default,,0,0,0,,Жай ғана ақымақ
Dialogue: 0,0:45:10.91,0:45:11.20,Default,,0,0,0,,Жай ғана ақымақ
Dialogue: 0,0:45:11.29,0:45:12.37,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:45:12.45,0:45:15.83,Default,,0,0,0,,Аралас 800 метрге эстафеталық жүгіру
Dialogue: 0,0:45:15.92,0:45:18.04,Default,,0,0,0,,- (Басқа мектеп оқушысы 1) Тоғаши сонда ғой - (Басқа мектеп оқушысы 2) Бұл Джинджин.
Dialogue: 0,0:45:18.13,0:45:20.21,Default,,0,0,0,,Бұл екеуінің бір командада болуы ғажап.
Dialogue: 0,0:45:30.47,0:45:31.97,Default,,0,0,0,,Сіздің белгілеріңіз туралы
Dialogue: 0,0:45:33.73,0:45:34.89,Default,,0,0,0,,Жиын
Dialogue: 0,0:45:36.10,0:45:37.19,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:45:38.19,0:45:42.82,Default,,0,0,0,,(Асакусаның ауыр тыныс алуы)
Dialogue: 0,0:45:49.62,0:45:50.53,Default,,0,0,0,,Әй!
Dialogue: 0,0:45:50.62,0:45:51.79,Default,,0,0,0,,Торғай!
Dialogue: 0,0:45:51.87,0:45:53.54,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:45:54.41,0:45:55.33,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:45:55.41,0:45:57.08,Default,,0,0,0,,Ха... Иә!
Dialogue: 0,0:45:57.17,0:46:00.50,Default,,0,0,0,,(Шинаның ауыр тыныс алуы)
Dialogue: 0,0:46:01.38,0:46:04.26,Default,,0,0,0,,Эй, эй, барыңды істе, Идака
Dialogue: 0,0:46:07.34,0:46:10.01,Default,,0,0,0,,(Шинаның ауыр тыныс алуы)
Dialogue: 0,0:46:10.10,0:46:10.97,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:46:11.05,0:46:12.85,Default,,0,0,0,,Мен әлі де жете аламын.
Dialogue: 0,0:46:12.93,0:46:14.56,Default,,0,0,0,,Ха ха ха... аа!
Dialogue: 0,0:46:21.61,0:46:23.03,Default,,0,0,0,,О...
Dialogue: 0,0:46:23.90,0:46:26.40,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,0:46:26.49,0:46:28.86,Default,,0,0,0,,Олар маған жарысуға рұқсат беретін сияқты.
Dialogue: 0,0:46:29.74,0:46:32.20,Default,,0,0,0,,Кешіріңіз, бірақ менің қарсыласым
Dialogue: 0,0:46:32.28,0:46:33.12,Default,,0,0,0,,Сіз емес
Dialogue: 0,0:46:33.20,0:46:34.12,Default,,0,0,0,,Джинджин мырза
Dialogue: 0,0:46:47.76,0:46:52.26,Default,,0,0,0,,(Джиндзиннің дөрекі тынысы)
Dialogue: 0,0:46:52.35,0:46:54.26,Default,,0,0,0,,(Ономичидің ауыр тыныс алуы)
Dialogue: 0,0:47:10.45,0:47:11.91,Default,,0,0,0,,Е, тоқтатылған клуб емес пе?
Dialogue: 0,0:47:11.99,0:47:16.50,Default,,0,0,0,,Іс-әрекеттеріңізді жалғастырыңыз және жазғы турнирлерге қатысыңыз.
Dialogue: 0,0:47:16.58,0:47:18.54,Default,,0,0,0,,Директордың орынбасары осылай деді.
Dialogue: 0,0:47:18.62,0:47:20.12,Default,,0,0,0,,Неліктен директордың орынбасары?
Dialogue: 0,0:47:20.21,0:47:24.67,Default,,0,0,0,,Есімде болса, менің директордың орынбасары жеңіл атлетикадан жүгіретін.
Dialogue: 0,0:47:24.75,0:47:27.59,Default,,0,0,0,,Ол Кацуонишидің кіші директоры болды, солай ма?
Dialogue: 0,0:47:28.17,0:47:30.26,Default,,0,0,0,,А, солай шығар.
Dialogue: 0,0:47:31.43,0:47:33.76,Default,,0,0,0,,Қалай болғанда да, бұл керемет болды.
Dialogue: 0,0:47:33.85,0:47:34.68,Default,,0,0,0,,Иә
Dialogue: 0,0:47:34.76,0:47:35.85,Default,,0,0,0,,Иә.
Dialogue: 0,0:47:36.35,0:47:38.64,Default,,0,0,0,,Мен толық сенімді емеспін, бірақ...
Dialogue: 0,0:47:39.85,0:47:40.73,Default,,0,0,0,,Сіз жүгіресіз бе?
Dialogue: 0,0:47:40.81,0:47:41.69,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:47:47.86,0:47:50.74,Default,,0,0,0,,Тогаши Минамиканда жаңа турнир рекордын орнатты.
Dialogue: 0,0:47:50.82,0:47:53.03,Default,,0,0,0,,Республикалық турнирде де Тоғашы басым болады.
Dialogue: 0,0:47:53.12,0:47:55.83,Default,,0,0,0,,Шынымды айтсам, қарсылас жоқ.
Dialogue: 0,0:47:55.91,0:47:56.74,Default,,0,0,0,,Джинджин ше?
Dialogue: 0,0:47:56.83,0:47:58.70,Default,,0,0,0,,Джинджин сол жарыста үшінші болып келді.
Dialogue: 0,0:47:58.79,0:48:01.54,Default,,0,0,0,,Сіз бүкіл ел бойынша қатыса аласыз, бірақ бұл сәтсіздік, сондықтан қиын.
Dialogue: 0,0:48:01.62,0:48:02.92,Default,,0,0,0,,Кюсюдегі Кейда
Dialogue: 0,0:48:03.00,0:48:06.75,Default,,0,0,0,,Кейда да жақсы сияқты, бірақ мен оны Тогашидың қарсыласы деп ойламаймын.
Dialogue: 0,0:48:06.84,0:48:09.72,Default,,0,0,0,,Тоғашы біраз уақыт тығырыққа тіреліп, ілгері жылжи қоймаған сияқты.
Dialogue: 0,0:48:09.80,0:48:11.97,Default,,0,0,0,,Соңғы кездері мен жүгірген сайын өзімнің ең жақсы нәтижемді көрсетіп жүрмін.
Dialogue: 0,0:48:12.05,0:48:12.97,Default,,0,0,0,,Бұл құбыжық, солай ма?
Dialogue: 0,0:48:13.05,0:48:15.01,Default,,0,0,0,,Zaitsu жазбалары жаңартылуы мүмкін
Dialogue: 0,0:48:15.10,0:48:16.18,Default,,0,0,0,,А, бұл қызық болар еді...
Dialogue: 0,0:48:16.26,0:48:17.18,Default,,0,0,0,,Ахх!
Dialogue: 0,0:48:17.26,0:48:20.89,Default,,0,0,0,,Енді Китакюсюде Зайцудың турнир рекорды теңестірілді.
Dialogue: 0,0:48:20.98,0:48:22.60,Default,,0,0,0,,- (3-репортёр) А? Өтірік? - (Репортер 1) Китакюсю Кейда ма?
Dialogue: 0,0:48:22.69,0:48:24.98,Default,,0,0,0,,Жоқ, білмеймін, бір жыл болды.
Dialogue: 0,0:48:25.06,0:48:26.36,Default,,0,0,0,,Сіз кімсіз? Сенің атың кім?
Dialogue: 0,0:48:28.57,0:48:29.44,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:48:29.53,0:48:32.61,Default,,0,0,0,,Бұл беделді отбасынан күткендей таңғажайып адамдар саны.
Dialogue: 0,0:48:32.70,0:48:33.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:34.24,0:48:35.07,Default,,0,0,0,,Иә
Dialogue: 0,0:48:36.95,0:48:39.08,Default,,0,0,0,,Мен Нумано Дайто орта мектебімін
Dialogue: 0,0:48:39.16,0:48:41.50,Default,,0,0,0,,Жеңіл атлетикамен қай жерде айналыстыңыз?
Dialogue: 0,0:48:41.58,0:48:42.92,Default,,0,0,0,,Мен Комиямын
Dialogue: 0,0:48:43.00,0:48:44.96,Default,,0,0,0,,Мен орта мектепте жеңіл атлетика үйірмесіне қатысқан жоқпын.
Dialogue: 0,0:48:45.04,0:48:46.29,Default,,0,0,0,,Иә!
Dialogue: 0,0:48:46.38,0:48:48.63,Default,,0,0,0,,Сонымен, сіз орта мектептен бастайсыз ба?
Dialogue: 0,0:48:48.71,0:48:51.21,Default,,0,0,0,,Ал осындай қуатты мектепте?
Dialogue: 0,0:48:51.30,0:48:52.13,Default,,0,0,0,,Иә
Dialogue: 0,0:48:52.22,0:48:55.55,Default,,0,0,0,,Мен осы жерге кіруді мақсат етіп, ұзақ уақыт бойы жеке жаттығып жүрмін.
Dialogue: 0,0:48:55.64,0:48:57.93,Default,,0,0,0,,Е, сен қайда тұрасың?
Dialogue: 0,0:48:58.01,0:48:59.39,Default,,0,0,0,,Накатсу таулары
Dialogue: 0,0:48:59.47,0:49:02.85,Default,,0,0,0,,Пойызбен осы аймаққа жету ыңғайсыз емес пе?
Dialogue: 0,0:49:02.94,0:49:04.44,Default,,0,0,0,,Иә, сондықтан да велосипед
Dialogue: 0,0:49:04.52,0:49:06.52,Default,,0,0,0,,Иә! Оған қанша уақыт кетеді?
Dialogue: 0,0:49:06.61,0:49:07.94,Default,,0,0,0,,Бұл оның әр жерде кенеттен пайда болып жүруін түсіндірер еді, иә?
Dialogue: 0,0:49:46.23,0:49:47.44,Default,,0,0,0,,Жақсы
Dialogue: 0,0:49:48.06,0:49:48.90,Default,,0,0,0,,（）
Dialogue: 0,0:49:50.27,0:49:52.82,Default,,0,0,0,,(Кейданың ауыр тыныс алуы)
Dialogue: 0,0:49:52.90,0:49:54.40,Default,,0,0,0,,Уау...
Dialogue: 0,0:49:54.49,0:49:57.91,Default,,0,0,0,,Өйткені Кейда мырза арнайы сыныпта оқиды.
Dialogue: 0,0:50:00.83,0:50:02.49,Default,,0,0,0,,Е...
Dialogue: 0,0:50:02.58,0:50:06.00,Default,,0,0,0,,Бәріне сәлем, мен Кейда, менеджермін.
Dialogue: 0,0:50:06.08,0:50:06.96,Default,,0,0,0,,Өздеріңіз білетіндей, біздің мектеп қуатты мектеп деп аталатын.
Dialogue: 0,0:50:06.96,0:50:09.79,Default,,0,0,0,,Өздеріңіз білетіндей, біздің мектеп қуатты мектеп деп аталады.
Dialogue: 0,0:50:06.96,0:50:09.79,Default,,0,0,0,,Екі жыл ғана болды, әлгі жігіт.
Dialogue: 0,0:50:09.88,0:50:13.51,Default,,0,0,0,,Сонымен қатар, қабылдау емтиханы туралы естігенде, қобалжуыңыз мүмкін.
Dialogue: 0,0:50:14.09,0:50:16.17,Default,,0,0,0,,Қай жерде жүгірсең де 100 метр қашықтық
Dialogue: 0,0:50:16.26,0:50:17.63,Default,,0,0,0,,Өзгеріс жоқ
Dialogue: 0,0:50:21.43,0:50:22.56,Default,,0,0,0,,Жақсы
Dialogue: 0,0:50:24.39,0:50:25.23,Default,,0,0,0,,（）
Dialogue: 0,0:50:25.31,0:50:27.48,Default,,0,0,0,,(мүшелердің ауыр тыныс алуы)
Dialogue: 0,0:50:28.06,0:50:31.19,Default,,0,0,0,,Бала саны 23 өте жақсы орындайды.
Dialogue: 0,0:50:34.48,0:50:37.49,Default,,0,0,0,,Ой, басталуы жақсы болды.
Dialogue: 0,0:50:37.57,0:50:40.53,Default,,0,0,0,,Сол жылдың басы ессіз болды.
Dialogue: 0,0:50:37.57,0:50:40.53,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:50:40.53,0:50:40.62,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:50:40.62,0:50:42.78,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:50:40.62,0:50:42.78,Default,,0,0,0,,Менің ойымша, ол майданнан қашатын түрі.
Dialogue: 0,0:50:43.87,0:50:44.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:45.37,0:50:46.54,Default,,0,0,0,,Комия-кун!
Dialogue: 0,0:50:46.62,0:50:47.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:50.46,0:50:52.59,Default,,0,0,0,,Мен оның қаншалықты жылдам екеніне таң қалдым.
Dialogue: 0,0:50:53.30,0:50:57.67,Default,,0,0,0,,Соңында ол кенет тоқтап қалды, бірақ оған бірдеңе бар ма?
Dialogue: 0,0:50:57.76,0:51:00.09,Default,,0,0,0,,Бастапқы сызық өте жақсы болды.
Dialogue: 0,0:51:00.18,0:51:01.18,Default,,0,0,0,,Пішіндері әртүрлі болғанымен
Dialogue: 0,0:51:01.76,0:51:04.06,Default,,0,0,0,,Сізде тепе-теңдікті жақсы сезінесіз.
Dialogue: 0,0:51:04.14,0:51:10.52,Default,,0,0,0,,Ха ха ха ха ха ха...
Dialogue: 0,0:51:13.73,0:51:18.61,Default,,0,0,0,,Аа, Комия-кун екінші жартысында күйреді.
Dialogue: 0,0:51:18.70,0:51:20.03,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:51:22.57,0:51:29.54,Default,,0,0,0,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:51:38.17,0:51:40.88,Default,,0,0,0,,Директор, ертеңгі сұрақтарды ойланыңыз.
Dialogue: 0,0:51:40.97,0:51:43.43,Default,,0,0,0,,Ертең? О, лекция?
Dialogue: 0,0:51:43.51,0:51:47.22,Default,,0,0,0,,Уау, Зайцумен сұрақ-жауап керемет.
Dialogue: 0,0:51:47.31,0:51:49.35,Default,,0,0,0,,Бұл өте жақсы емес.
Dialogue: 0,0:51:49.43,0:51:53.31,Default,,0,0,0,,Біріншіден, мен менеджер болғандықтан сұрақты кім қойғаны маңызды емес.
Dialogue: 0,0:51:53.40,0:51:55.94,Default,,0,0,0,,Жоқ, мен бас тартпаймын.
Dialogue: 0,0:51:56.02,0:51:59.44,Default,,0,0,0,,Мен талай рет айтқанымдай, жоғары мектеп өмірі
Dialogue: 0,0:51:59.53,0:52:04.37,Default,,0,0,0,,Бұл әр адам үшін өз өмірінің бағытын анықтайтын өте маңызды кезең.
Dialogue: 0,0:52:04.45,0:52:08.29,Default,,0,0,0,,Осы уақытта біз бес жыл қатарынан Жапония чемпионатында жеңіске жеттік.
Dialogue: 0,0:52:08.37,0:52:12.00,Default,,0,0,0,,Біздің мектептің түлегі Зайцу мырзаның сөзін ести аласыз.
Dialogue: 0,0:52:12.08,0:52:14.04,Default,,0,0,0,,Бұл өте құнды мүмкіндік.
Dialogue: 0,0:52:14.13,0:52:17.30,Default,,0,0,0,,Мұқият ойлаңыз, зейініңізді жинаңыз және тыныш тыңдаңыз.
Dialogue: 0,0:52:17.38,0:52:19.46,Default,,0,0,0,,Олай болса, Зайцу мырза, өтінемін.
Dialogue: 0,0:52:31.81,0:52:34.48,Default,,0,0,0,,Таяз ойла, дүниені елемеу.
Dialogue: 0,0:52:34.56,0:52:38.40,Default,,0,0,0,,Өзіңізді қорғауға тырыспаңыз, жеңсеңіз де шабуыл жасаңыз
Dialogue: 0,0:52:39.07,0:52:40.44,Default,,0,0,0,,Сұрақтарыңыз болса, қойыңыздар.
Dialogue: 0,0:52:45.62,0:52:46.53,Default,,0,0,0,,Иә
Dialogue: 0,0:52:47.62,0:52:48.83,Default,,0,0,0,,Иә, сіз
Dialogue: 0,0:52:50.37,0:52:52.96,Default,,0,0,0,,Менің атым Кейда, мен жеңіл атлетика клубының директорымын.
Dialogue: 0,0:52:53.04,0:52:55.29,Default,,0,0,0,,Зайцу көптеген...
Dialogue: 0,0:52:55.38,0:52:57.04,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:52:58.67,0:52:59.92,Default,,0,0,0,,Зайцу болды
Dialogue: 0,0:53:00.01,0:53:02.84,Default,,0,0,0,,Көптеген тамаша жазбалар артта қалды.
Dialogue: 0,0:53:03.43,0:53:05.01,Default,,0,0,0,,Ұзақ уақыт бойы шыңда тұрыңыз
Dialogue: 0,0:53:05.09,0:53:08.01,Default,,0,0,0,,Байқауды жалғастырудың себебі неде?
Dialogue: 0,0:53:08.56,0:53:10.14,Default,,0,0,0,,Мен тірі жанмын
Dialogue: 0,0:53:10.22,0:53:13.39,Default,,0,0,0,,Бір күні өлесің, енді қайта туылмайсың.
Dialogue: 0,0:53:13.48,0:53:15.27,Default,,0,0,0,,Бұл жалғыз себеп
Dialogue: 0,0:53:15.90,0:53:17.02,Default,,0,0,0,,Е...
Dialogue: 0,0:53:17.61,0:53:19.90,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,0:53:20.57,0:53:22.28,Default,,0,0,0,,Тағы бір нәрсе ала аламын ба?
Dialogue: 0,0:53:22.78,0:53:24.32,Default,,0,0,0,,Ірі турнирлердің финалы және т.б.
Dialogue: 0,0:53:24.40,0:53:26.57,Default,,0,0,0,,Үлкен сахнада қандай психикалық күйдесіз?
Dialogue: 0,0:53:26.66,0:53:28.49,Default,,0,0,0,,Сіз матчқа дайынсыз ба?
Dialogue: 0,0:53:29.45,0:53:33.75,Default,,0,0,0,,Кез келген матчта жеңілуден қорықпаңыз және мазмұнға назар аударыңыз
Dialogue: 0,0:53:33.83,0:53:36.54,Default,,0,0,0,,Сонымен бірге мен жеңілгеннен қалтырап, нәтиже қалаймын.
Dialogue: 0,0:53:36.63,0:53:38.25,Default,,0,0,0,,Ойлан 50/50
Dialogue: 0,0:53:38.34,0:53:40.80,Default,,0,0,0,,Бұл көңіл-күйді ауыстыруды жеңілдетеді дейсіз бе?
Dialogue: 0,0:53:40.88,0:53:43.88,Default,,0,0,0,,Жоқ, мен бір уақытта 100% ләззат аламын.
Dialogue: 0,0:53:43.97,0:53:47.22,Default,,0,0,0,,Ешбір жағдайда қобалжымас үшін бе?
Dialogue: 0,0:53:47.30,0:53:50.14,Default,,0,0,0,,Қалай болғанда да, шиеленістерден ләззат алу.
Dialogue: 0,0:53:51.06,0:53:52.77,Default,,0,0,0,,Ал...
Dialogue: 0,0:53:54.56,0:53:55.77,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:53:55.85,0:53:58.06,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:53:58.81,0:53:59.73,Default,,0,0,0,,Басқалар
Dialogue: 0,0:54:00.73,0:54:01.90,Default,,0,0,0,,Иә
Dialogue: 0,0:54:02.53,0:54:03.99,Default,,0,0,0,,Иә, сіз
Dialogue: 0,0:54:05.90,0:54:07.45,Default,,0,0,0,,Менің атым Комия.
Dialogue: 0,0:54:07.95,0:54:10.78,Default,,0,0,0,,Зайтсу бұл...
Dialogue: 0,0:54:12.20,0:54:14.66,Default,,0,0,0,,Психикалық көмекті қалай көрсетесіз?
Dialogue: 0,0:54:16.25,0:54:17.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:17.92,0:54:21.50,Default,,0,0,0,,Ал, мен жеңіл атлетика клубында спринтермін.
Dialogue: 0,0:54:21.59,0:54:23.55,Default,,0,0,0,,Мазасыздықпен қалай күресуге болады...
Dialogue: 0,0:54:24.13,0:54:26.88,Default,,0,0,0,,Негізі мен баяғыда жарақат алғанмын.
Dialogue: 0,0:54:26.97,0:54:29.09,Default,,0,0,0,,Жарақат толығымен жазылды.
Dialogue: 0,0:54:29.18,0:54:32.64,Default,,0,0,0,,Ең жоғары жылдамдыққа жеткенде, аяғыңыз автоматты түрде тежеледі.
Dialogue: 0,0:54:32.72,0:54:34.31,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:54:34.81,0:54:37.27,Default,,0,0,0,,Шешімі болғанын қалаймын.
Dialogue: 0,0:54:39.10,0:54:42.61,Default,,0,0,0,,Қорытындылай келе, алаңдаушылықпен күресуге болмайды.
Dialogue: 0,0:54:43.53,0:54:46.49,Default,,0,0,0,,Өмір әрқашан жоғалту мүмкіндігіне толы.
Dialogue: 0,0:54:46.57,0:54:49.45,Default,,0,0,0,,Өмірдің нағыз рахаты осында жатыр.
Dialogue: 0,0:54:50.07,0:54:51.57,Default,,0,0,0,,Қорқыныш жағымсыз емес
Dialogue: 0,0:54:51.66,0:54:53.49,Default,,0,0,0,,Қауіпсіздік қызық емес
Dialogue: 0,0:54:53.58,0:54:57.37,Default,,0,0,0,,Мазасыздық - бұл өзіңізді сынаған кездегі сезім.
Dialogue: 0,0:54:58.16,0:55:00.88,Default,,0,0,0,,Даңқ алдында баға ұсынар кезде
Dialogue: 0,0:55:01.46,0:55:04.25,Default,,0,0,0,,Тіршілік – ұсақ жасушалардың жиынтығы.
Dialogue: 0,0:55:04.34,0:55:05.59,Default,,0,0,0,,Маған берші.
Dialogue: 0,0:55:09.59,0:55:11.97,Default,,0,0,0,,Сіз не істегіңіз келеді?
Dialogue: 0,0:55:13.64,0:55:14.68,Default,,0,0,0,,Жазу...
Dialogue: 0,0:55:15.72,0:55:17.81,Default,,0,0,0,,Жаңа жапон рекордын орнату
Dialogue: 0,0:55:19.02,0:55:20.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:19.02,0:55:20.35,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:55:20.35,0:55:21.35,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:55:21.35,0:55:23.52,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:55:21.35,0:55:23.52,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:55:25.15,0:55:26.32,Default,,0,0,0,,Бұл Комия.
Dialogue: 0,0:55:29.15,0:55:32.12,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:55:32.95,0:55:34.24,Default,,0,0,0,,Я...
Dialogue: 0,0:55:35.79,0:55:37.00,Default,,0,0,0,,（）
Dialogue: 0,0:55:38.71,0:55:41.79,Default,,0,0,0,,(Комияның ауыр тыныс алуы)
Dialogue: 0,0:55:44.46,0:55:47.76,Default,,0,0,0,,Хаха...
Dialogue: 0,0:55:52.59,0:55:53.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:53.80,0:56:00.60,Default,,0,0,0,,Ха ха ха ха ха ха...
Dialogue: 0,0:56:03.06,0:56:05.27,Default,,0,0,0,,Өткен жыл керемет болды.
Dialogue: 0,0:56:05.36,0:56:06.52,Default,,0,0,0,,О
Dialogue: 0,0:56:08.28,0:56:09.74,Default,,0,0,0,,Бүгінгі күн үшін рахмет, Зайцу.
Dialogue: 0,0:56:11.20,0:56:12.78,Default,,0,0,0,,Сіз дөрекі болдыңыз ба?
Dialogue: 0,0:56:13.28,0:56:14.16,Default,,0,0,0,,Жоқ
Dialogue: 0,0:56:14.24,0:56:15.99,Default,,0,0,0,,Кофе жақсы болды ма?
Dialogue: 0,0:56:16.08,0:56:17.16,Default,,0,0,0,,Рахмет
Dialogue: 0,0:56:19.04,0:56:20.96,Default,,0,0,0,,Ол келе жатыр.
Dialogue: 0,0:56:21.04,0:56:22.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:22.83,0:56:23.92,Default,,0,0,0,,О
Dialogue: 0,0:56:24.67,0:56:26.09,Default,,0,0,0,,Кейда?
Dialogue: 0,0:56:26.17,0:56:28.76,Default,,0,0,0,,Бар болғаны екі жыл болды, бірақ ол Кюсюда бірінші орында.
Dialogue: 0,0:56:29.51,0:56:32.88,Default,,0,0,0,,Бұл туралы биылғы In-High-те бүкіл Жапония біледі.
Dialogue: 0,0:56:34.18,0:56:35.51,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:56:36.10,0:56:37.76,Default,,0,0,0,,Ақырында түсінесіз.
Dialogue: 0,0:56:38.93,0:56:40.06,Default,,0,0,0,,Нақты нәрсе
Dialogue: 0,0:56:42.60,0:56:44.02,Default,,0,0,0,,Ах... ха...
Dialogue: 0,0:56:45.23,0:56:47.98,Default,,0,0,0,,Хаха...
Dialogue: 0,0:56:54.03,0:56:56.20,Default,,0,0,0,,Мүмкіндік тапқан сияқтысыз.
Dialogue: 0,0:56:56.28,0:56:57.95,Default,,0,0,0,,Екінші таймда енді тоқтамайды
Dialogue: 0,0:56:58.03,0:56:59.12,Default,,0,0,0,,Иә
Dialogue: 0,0:56:59.20,0:57:01.33,Default,,0,0,0,,Бірақ шамадан тыс жұмыс жаман
Dialogue: 0,0:57:01.41,0:57:02.83,Default,,0,0,0,,Бүгін тұрғаным дұрыс.
Dialogue: 0,0:57:02.91,0:57:05.75,Default,,0,0,0,,Мен жақсы сезіммен жүгіріп келемін.
Dialogue: 0,0:57:05.83,0:57:07.88,Default,,0,0,0,,Мен тағы біраз жүгіремін, сосын үйге барамын.
Dialogue: 0,0:57:07.96,0:57:12.42,Default,,0,0,0,,Мен сенің жүгіріп бара жатқаныңды алғаш көргенде оң аяғыңнан бірдеңені байқадым.
Dialogue: 0,0:57:13.13,0:57:15.39,Default,,0,0,0,,Зайцудың сөзі жүрегімді елжіретіп жіберді
Dialogue: 0,0:57:15.47,0:57:17.05,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:57:18.76,0:57:21.06,Default,,0,0,0,,Осыны айтайын ба деп ойладым.
Dialogue: 0,0:57:22.14,0:57:23.39,Default,,0,0,0,,Сен…
Dialogue: 0,0:57:23.48,0:57:25.44,Default,,0,0,0,,Сізге жеңіл атлетикадан бас тарту керек
Dialogue: 0,0:57:28.02,0:57:29.86,Default,,0,0,0,,Пішін біртіндеп құлайды.
Dialogue: 0,0:57:29.94,0:57:32.36,Default,,0,0,0,,Тепе-теңдіктің нашарлап бара жатқанын білесіз бе?
Dialogue: 0,0:57:33.15,0:57:36.49,Default,,0,0,0,,Бірақ мен жүгірген сайын жылдамырақ келемін.
Dialogue: 0,0:57:37.70,0:57:41.16,Default,,0,0,0,,Осындай жүргізу стилімен максималды өнімді шығарудың бір себебі бар.
Dialogue: 0,0:57:41.24,0:57:42.58,Default,,0,0,0,,Менде тек сезім бар!
Dialogue: 0,0:57:42.66,0:57:44.16,Default,,0,0,0,,Бұл қызыл жалау.
Dialogue: 0,0:57:44.25,0:57:46.67,Default,,0,0,0,,Шектеуді алып тастап, эмоциямен жүгіре алатын адам болыңыз
Dialogue: 0,0:57:46.75,0:57:48.38,Default,,0,0,0,,Тежегіштермен жабдықталмаған
Dialogue: 0,0:57:48.46,0:57:50.84,Default,,0,0,0,,Даңқты бір сәтке түсірсем де
Dialogue: 0,0:57:50.92,0:57:52.88,Default,,0,0,0,,Жойылғанша жүгіре беріңіз
Dialogue: 0,0:57:52.96,0:57:56.89,Default,,0,0,0,,Сіздің иістеріңіз денеңіздің соңғы қарсылығы болды.
Dialogue: 0,0:57:57.47,0:58:01.10,Default,,0,0,0,,Бір күні құрлықта өлесің
Dialogue: 0,0:58:05.48,0:58:06.73,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:58:06.81,0:58:09.69,Default,,0,0,0,,Сонымен, мен даңқты бір сәтке ұстай аламын.
Dialogue: 0,0:58:10.40,0:58:13.36,Default,,0,0,0,,Не? Сіз тыңдамадыңыз ба?
Dialogue: 0,0:58:14.11,0:58:15.49,Default,,0,0,0,,Рахмет
Dialogue: 0,0:58:16.36,0:58:17.57,Default,,0,0,0,,Мені жайбарақаттармен бірге қоспа
Dialogue: 0,0:58:25.62,0:58:28.54,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:58:28.63,0:58:30.38,Default,,0,0,0,,Уау...
Dialogue: 0,0:58:30.46,0:58:31.54,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:58:31.63,0:58:33.59,Default,,0,0,0,,Мен Кейданың жазбасын алып тастадым.
Dialogue: 0,0:58:34.71,0:58:38.09,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:58:43.85,0:58:44.97,Default,,0,0,0,,Комия-кун
Dialogue: 0,0:58:45.06,0:58:47.81,Default,,0,0,0,,Алдын ала кезеңде барлық ойыншылардың алға шыққаны таң қалдырады.
Dialogue: 0,0:58:47.89,0:58:50.19,Default,,0,0,0,,Бұл өте жылдам болды, Комия-кун.
Dialogue: 0,0:58:50.27,0:58:52.82,Default,,0,0,0,,Финал Кейдамен жеке-жеке жекпе-жек болады.
Dialogue: 0,0:58:52.90,0:58:55.99,Default,,0,0,0,,Ондай жағдайда қай тарапты қолдайтынымды білмеймін...
Dialogue: 0,0:58:56.07,0:58:58.15,Default,,0,0,0,,Екеуін де қолдау керек, солай ма?
Dialogue: 0,0:58:58.24,0:58:59.41,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:58:59.49,0:59:00.70,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:59:01.62,0:59:03.12,Default,,0,0,0,,Ой, сені ұстап қалғаным үшін кешір.
Dialogue: 0,0:59:03.79,0:59:04.62,Default,,0,0,0,,Жоқ
Dialogue: 0,0:59:05.29,0:59:06.12,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:59:06.20,0:59:08.33,Default,,0,0,0,,Финалда сәттілік!
Dialogue: 0,0:59:09.42,0:59:10.58,Default,,0,0,0,,Сіздің белгілеріңіз туралы
Dialogue: 0,0:59:26.10,0:59:27.18,Default,,0,0,0,,Жиын
Dialogue: 0,0:59:33.82,0:59:34.73,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,0:59:34.82,0:59:40.66,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:59:40.74,0:59:44.20,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:59:44.28,0:59:46.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:46.83,0:59:52.00,Default,,0,0,0,,(Көрермендердің шуы)
Dialogue: 0,0:59:57.38,0:59:58.51,Default,,0,0,0,,Джиндзин мырза
Dialogue: 0,0:59:59.01,0:59:59.84,Default,,0,0,0,,О
Dialogue: 0,1:00:02.18,1:00:04.72,Default,,0,0,0,,Алдымен біз алдын ала кезеңдерден өтуіміз керек.
Dialogue: 0,1:00:04.80,1:00:05.85,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,1:00:07.22,1:00:09.35,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,1:00:09.43,1:00:11.56,Default,,0,0,0,,Ах~ Қалай болғанда да
Dialogue: 0,1:00:13.27,1:00:15.52,Default,,0,0,0,,Сен маған бүгінге дейін жақсы қарадың.
Dialogue: 0,1:00:15.61,1:00:17.82,Default,,0,0,0,,Мен бәрібір бар күшімді саламын.
Dialogue: 0,1:00:17.90,1:00:18.82,Default,,0,0,0,,Иә
Dialogue: 0,1:00:18.90,1:00:20.53,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,1:00:20.61,1:00:21.45,Default,,0,0,0,,Иә
Dialogue: 0,1:00:23.95,1:00:25.37,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:00:28.41,1:00:30.54,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:00:43.34,1:00:44.51,Default,,0,0,0,,Сіздің белгілеріңіз туралы
Dialogue: 0,1:01:12.66,1:01:13.79,Default,,0,0,0,,Жиын
Dialogue: 0,1:01:18.38,1:01:19.46,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,1:01:19.55,1:01:22.42,Default,,0,0,0,,(Ойыншылар ауыр тыныс алады)
Dialogue: 0,1:01:31.02,1:01:37.98,Default,,0,0,0,,(Джиндзиннің дөрекі тынысы)
Dialogue: 0,1:01:49.24,1:01:50.58,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,1:01:50.66,1:01:57.17,Default,,0,0,0,,(Тоғашының ауыр тыныс алуы)
Dialogue: 0,1:01:59.42,1:02:00.88,Default,,0,0,0,,Джинджин-кун, еңбегің үшін рахмет
Dialogue: 0,1:02:00.96,1:02:02.21,Default,,0,0,0,,Демек, ойлағанымдай…
Dialogue: 0,1:02:02.80,1:02:04.92,Default,,0,0,0,,Жоқ, бұл толық жеңіліс.
Dialogue: 0,1:02:05.01,1:02:06.68,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,1:02:06.76,1:02:08.26,Default,,0,0,0,,Еңбек еткенің үшін рахмет, Тоғашы-күн
Dialogue: 0,1:02:08.34,1:02:10.68,Default,,0,0,0,,Керемет! Жаңа турнир рекорды
Dialogue: 0,1:02:10.76,1:02:14.43,Default,,0,0,0,,Бұл артқы желдің анықтамасы, бірақ мен жақсы жұмыс істеп жатырмын.
Dialogue: 0,1:02:14.52,1:02:17.35,Default,,0,0,0,,Ақыры мен сенімен бірге жүгіргім келді
Dialogue: 0,1:02:17.44,1:02:19.61,Default,,0,0,0,,Әлі де керемет
Dialogue: 0,1:02:20.61,1:02:22.98,Default,,0,0,0,,Джинджин мырза, еңбегіңіз үшін рахмет
Dialogue: 0,1:02:23.07,1:02:25.86,Default,,0,0,0,,Комия деген кісі
Dialogue: 0,1:02:27.70,1:02:29.32,Default,,0,0,0,,Бұл күлкілі жылдам.
Dialogue: 0,1:02:30.32,1:02:31.58,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:02:32.20,1:02:34.75,Default,,0,0,0,,Соңғы бөлімді ойнамаған болсаңыз, бұл...
Dialogue: 0,1:02:59.27,1:03:00.86,Default,,0,0,0,,Комия-кун, көптен бері көрмегелі
Dialogue: 0,1:03:01.90,1:03:03.07,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,1:03:04.98,1:03:06.78,Default,,0,0,0,,Жеңіл атлетика жалғасын тапты.
Dialogue: 0,1:03:07.28,1:03:08.15,Default,,0,0,0,,Иә
Dialogue: 0,1:03:09.61,1:03:12.16,Default,,0,0,0,,Мен сенімен бірге жүгіргеніме қанша жыл болды?
Dialogue: 0,1:03:13.16,1:03:14.83,Default,,0,0,0,,Бүгін де жеңіске жетуге рұқсат етемін.
Dialogue: 0,1:03:16.12,1:03:17.08,Default,,0,0,0,,Иә
Dialogue: 0,1:03:17.83,1:03:19.21,Default,,0,0,0,,Сәттілік
Dialogue: 0,1:04:37.33,1:04:44.29,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:05:17.62,1:05:24.17,Default,,0,0,0,,(ойыншыны таныстыру туралы хабарландыру)
Dialogue: 0,1:05:42.02,1:05:44.64,Default,,0,0,0,,4-жолақ Комия-кун
Dialogue: 0,1:05:45.19,1:05:48.52,Default,,0,0,0,,Нишизава орта мектебі Оита
Dialogue: 0,1:05:49.90,1:05:52.86,Default,,0,0,0,,5 жолақ Тоғаши-кун
Dialogue: 0,1:05:52.94,1:05:56.28,Default,,0,0,0,,Сардин Дайни орта мектебі Токио
Dialogue: 0,1:06:41.24,1:06:42.54,Default,,0,0,0,,Сіздің белгілеріңіз туралы
Dialogue: 0,1:07:18.99,1:07:20.16,Default,,0,0,0,,Жиын
Dialogue: 0,1:07:51.31,1:07:58.28,Default,,0,0,0,,Ха ха ха ха ха ха...
Dialogue: 0,1:08:03.32,1:08:08.16,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:08:38.36,1:08:39.44,Default,,0,0,0,,Тоғаши-кун
Dialogue: 0,1:08:40.36,1:08:41.95,Default,,0,0,0,,Жүгіру тәсілі өзгерді.
Dialogue: 0,1:09:29.16,1:09:30.33,Default,,0,0,0,,Сонымен
Dialogue: 0,1:09:30.41,1:09:32.91,Default,,0,0,0,,Жоғарыда келтірілген нәтижелерді ескере отырып...
Dialogue: 0,1:09:33.79,1:09:35.21,Default,,0,0,0,,(Тоғашының сілекей жұтқан дыбысы)
Dialogue: 0,1:09:35.79,1:09:38.34,Default,,0,0,0,,Келісімшарт жаңартылады
Dialogue: 0,1:09:38.42,1:09:41.80,Default,,0,0,0,,Жоқ, бұл жақсы болды.
Dialogue: 0,1:09:42.55,1:09:43.72,Default,,0,0,0,,Бұл маған жан тыныштығын береді.
Dialogue: 0,1:09:43.80,1:09:45.89,Default,,0,0,0,,Ах... Бірақ Тоғаши-сан
Dialogue: 0,1:09:45.97,1:09:47.64,Default,,0,0,0,,Мұны айту қиын.
Dialogue: 0,1:09:47.72,1:09:51.43,Default,,0,0,0,,Шынымды айтсам, бұл жолы да соңғы минут болды, сондықтан биылғы жыл маңызды.
Dialogue: 0,1:09:51.52,1:09:55.02,Default,,0,0,0,,Иә, мен мұны есте сақтаймын. Иә.
Dialogue: 0,1:09:55.10,1:09:56.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:10:01.82,1:10:03.44,Default,,0,0,0,,Фу…
Dialogue: 0,1:10:04.86,1:10:05.70,Default,,0,0,0,,Я...
Dialogue: 0,1:10:05.78,1:10:07.41,Default,,0,0,0,,- (Кадрлар) А, Тоғаши-сан - Иә.
Dialogue: 0,1:10:07.49,1:10:09.03,Default,,0,0,0,,Мен мұны ұмытып қалдым
Dialogue: 0,1:10:09.62,1:10:12.33,Default,,0,0,0,,Келесі айда біреуі болады, сондықтан қаласаңыз қосылыңыз.
Dialogue: 0,1:10:14.37,1:10:15.71,Default,,0,0,0,,Қоғамдық жиын?
Dialogue: 0,1:10:15.79,1:10:19.08,Default,,0,0,0,,Иә, Кайто мырза мен Кабаги мырза да келеді.
Dialogue: 0,1:10:19.17,1:10:21.55,Default,,0,0,0,,Егер мен сізден кеңес алсам ше?
Dialogue: 0,1:10:22.17,1:10:23.63,Default,,0,0,0,,Кеңес?
Dialogue: 0,1:10:23.71,1:10:26.63,Default,,0,0,0,,Иә, бұрынғыдан басқаша.
Dialogue: 0,1:10:27.22,1:10:30.05,Default,,0,0,0,,Бұл сізге көріну мүмкіндігі болуы мүмкін.
Dialogue: 0,1:10:30.14,1:10:31.43,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,1:10:32.01,1:10:32.85,Default,,0,0,0,,Иә
Dialogue: 0,1:10:38.48,1:10:40.27,Default,,0,0,0,,Қайырлы таң, Кабаки-кун
Dialogue: 0,1:10:40.36,1:10:43.03,Default,,0,0,0,,Қайырлы таң, Тоғаши-сан.
Dialogue: 0,1:10:43.53,1:10:46.32,Default,,0,0,0,,Мен келісім-шартты кеше жаңарттым.
Dialogue: 0,1:10:46.40,1:10:48.49,Default,,0,0,0,,Биыл да шетте қалды.
Dialogue: 0,1:10:48.57,1:10:50.16,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:10:51.95,1:10:53.12,Default,,0,0,0,,- (Қабағи) Тоғаши-сан - А?
Dialogue: 0,1:10:53.20,1:10:55.12,Default,,0,0,0,,Ол өзгерді.
Dialogue: 0,1:10:55.79,1:10:56.62,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:56.71,1:10:59.38,Default,,0,0,0,,Бала кезімде көретін Тоғаши-сан.
Dialogue: 0,1:10:59.46,1:11:01.29,Default,,0,0,0,,Атмосфера мүлдем басқаша.
Dialogue: 0,1:11:01.38,1:11:02.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:02.84,1:11:06.17,Default,,0,0,0,,Енді мен аздап шындықпен бетпе-бет келдім.
Dialogue: 0,1:11:06.26,1:11:08.76,Default,,0,0,0,,Осы жыл менің соңғы жылымдай барымды саламын.
Dialogue: 0,1:11:16.52,1:11:23.36,Default,,0,0,0,,Ха ха ха ха ха ха...
Dialogue: 0,1:11:56.06,1:11:56.56,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,1:11:56.56,1:11:57.06,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,1:11:56.56,1:11:57.06,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,1:11:57.06,1:12:00.48,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,1:12:14.49,1:12:16.79,Default,,0,0,0,,Мен бүгін өзімді жақсы сезінбедім.
Dialogue: 0,1:12:16.87,1:12:19.62,Default,,0,0,0,,Маусым енді ғана басталды.
Dialogue: 0,1:12:19.71,1:12:22.42,Default,,0,0,0,,Мен осы жерден біртіндеп арттырғым келеді.
Dialogue: 0,1:12:37.35,1:12:40.52,Default,,0,0,0,,Жеңіл атлетика жарыстары жылдан жылға танымал бола түсуде
Dialogue: 0,1:12:40.60,1:12:44.23,Default,,0,0,0,,Біздің компанияда біз де көп жылдар бойы алдыңғы шепте жүрген спортшыларды құрметтейміз.
Dialogue: 0,1:12:44.31,1:12:46.23,Default,,0,0,0,,Біз қолдадық
Dialogue: 0,1:12:46.77,1:12:47.90,Default,,0,0,0,,Олардың ішінде
Dialogue: 0,1:12:47.98,1:12:52.07,Default,,0,0,0,,15 жыл бойы мен қысқа қашықтықтағы әлемде алдыңғы қатарда күресіп келемін.
Dialogue: 0,1:12:52.15,1:12:56.53,Default,,0,0,0,,Біздің жеңіл атлетика клубының ойыншысы Кайтодан сәлем.
Dialogue: 0,1:12:57.08,1:12:59.91,Default,,0,0,0,,Олай болса, Кайто, өтінемін.
Dialogue: 0,1:13:00.00,1:13:03.17,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:13:03.25,1:13:05.08,Default,,0,0,0,,Сәлем, бұл Кайто.
Dialogue: 0,1:13:07.29,1:13:09.96,Default,,0,0,0,,Мен біраз уақыттан бері белсенді қызметте болдым.
Dialogue: 0,1:13:10.05,1:13:12.09,Default,,0,0,0,,Мен әлі шыңға жеткен жоқпыз деп ойлаймын.
Dialogue: 0,1:13:12.76,1:13:14.76,Default,,0,0,0,,Жыл сайын жеке жетістіктерімді жаңарту ниетімен
Dialogue: 0,1:13:14.84,1:13:16.51,Default,,0,0,0,,Маусымға шақыру
Dialogue: 0,1:13:17.14,1:13:19.26,Default,,0,0,0,,Ал... бір нәрсе анық.
Dialogue: 0,1:13:19.35,1:13:21.93,Default,,0,0,0,,Шындық өздігінен жойылмайды
Dialogue: 0,1:13:22.43,1:13:23.98,Default,,0,0,0,,Неге, жақсы, биыл
Dialogue: 0,1:13:24.06,1:13:27.73,Default,,0,0,0,,Біз Зайцу сияқты осында қалуды жалғастыратын шындықпен айналысамыз.
Dialogue: 0,1:13:27.82,1:13:29.69,Default,,0,0,0,,Бұл Кайто
Dialogue: 0,1:13:30.90,1:13:31.86,Default,,0,0,0,,Кайто ойыншысы
Dialogue: 0,1:13:31.94,1:13:34.24,Default,,0,0,0,,Керемет әңгіме, көп рахмет
Dialogue: 0,1:13:34.32,1:13:40.12,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:13:40.20,1:13:41.91,Default,,0,0,0,,Шындықпен қалай күресуге болады?
Dialogue: 0,1:13:42.00,1:13:43.33,Default,,0,0,0,,Иә
Dialogue: 0,1:13:43.41,1:13:47.33,Default,,0,0,0,,Бұл бір нәрсе. Оны жеңудің жалғыз жолы - оны жазу.
Dialogue: 0,1:13:48.25,1:13:49.46,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:13:49.96,1:13:53.38,Default,,0,0,0,,Бірақ... бұл қиын...
Dialogue: 0,1:13:54.05,1:13:57.22,Default,,0,0,0,,Не болды, Тоғашы, сен әбден аю екенсің ғой?
Dialogue: 0,1:13:57.97,1:13:59.26,Default,,0,0,0,,Э-э…
Dialogue: 0,1:13:59.35,1:14:02.02,Default,,0,0,0,,Соңғы уақытта сәл төмендеп кетті.
Dialogue: 0,1:14:02.10,1:14:03.98,Default,,0,0,0,,Түсіндім.
Dialogue: 0,1:14:04.06,1:14:06.48,Default,,0,0,0,,Жарайды, оны лақтырып тастасаң да, оның өнері жоқ.
Dialogue: 0,1:14:07.19,1:14:08.98,Default,,0,0,0,,Мен сендерге өзім туралы әңгіме айтып беремін.
Dialogue: 0,1:14:09.06,1:14:13.24,Default,,0,0,0,,Алдымен айтайын, менде табиғи талант бар.
Dialogue: 0,1:14:13.32,1:14:15.70,Default,,0,0,0,,Әрине, бұл жүгіру таланты.
Dialogue: 0,1:14:15.78,1:14:18.20,Default,,0,0,0,,Сондай-ақ қысқа қашықтыққа маманданған.
Dialogue: 0,1:14:18.28,1:14:22.49,Default,,0,0,0,,Кішкентай кезімде мен туған қаламда болсын, префектурада болсын, ешқашан жеңілген емеспін.
Dialogue: 0,1:14:23.00,1:14:25.75,Default,,0,0,0,,Бүкіл елге шыққан соң, тіпті мұрным да сынған.
Dialogue: 0,1:14:25.83,1:14:28.25,Default,,0,0,0,,Мен күш салып, одан да жылдам болдым.
Dialogue: 0,1:14:28.33,1:14:31.09,Default,,0,0,0,,Мен In-High-те бірінші жеңісімді көздей алатын сияқты болдым.
Dialogue: 0,1:14:31.17,1:14:33.05,Default,,0,0,0,,Орта мектептің 3 курсының жазы
Dialogue: 0,1:14:33.13,1:14:35.97,Default,,0,0,0,,15 жасар Зайцу пайда болды
Dialogue: 0,1:14:36.05,1:14:38.14,Default,,0,0,0,,Содан бері 15 жыл
Dialogue: 0,1:14:38.22,1:14:41.51,Default,,0,0,0,,Маған шындықты көрсетуді жалғастыруда.
Dialogue: 0,1:14:41.60,1:14:44.52,Default,,0,0,0,,Шындық ол әрқашан бір қадам алда.
Dialogue: 0,1:14:44.60,1:14:47.77,Default,,0,0,0,,Әрқашан соңғы минутта жеңілу ақиқаты
Dialogue: 0,1:14:47.85,1:14:50.52,Default,,0,0,0,,Мәңгілік 2-орын атануының шындығы
Dialogue: 0,1:14:50.61,1:14:53.11,Default,,0,0,0,,Әр секунд сайын қартаюдың ақиқаты
Dialogue: 0,1:14:53.19,1:14:56.24,Default,,0,0,0,,Комия сияқты жастардың өрлеу шындығы
Dialogue: 0,1:14:56.32,1:14:59.07,Default,,0,0,0,,Ха, сен енді жас емессің.
Dialogue: 0,1:14:59.16,1:15:00.57,Default,,0,0,0,,Аха…
Dialogue: 0,1:15:00.66,1:15:04.58,Default,,0,0,0,,Маған көп айтқаны сонша, мен басқа заманда туылғанымды қалаймын.
Dialogue: 0,1:15:04.66,1:15:08.79,Default,,0,0,0,,Бір қызығы, бұл әлем мен жеңе алмайтын шындықтарға толы.
Dialogue: 0,1:15:08.87,1:15:11.29,Default,,0,0,0,,...Бірақ, бір қызығы, И
Dialogue: 0,1:15:11.38,1:15:14.51,Default,,0,0,0,,Келесі жолы жеңетініме толық сенемін.
Dialogue: 0,1:15:14.59,1:15:15.92,Default,,0,0,0,,Қош келдің үйге.
Dialogue: 0,1:15:16.01,1:15:17.09,Default,,0,0,0,,Жоқ
Dialogue: 0,1:15:17.17,1:15:19.55,Default,,0,0,0,,Өйткені шындықтан құтылуға болады.
Dialogue: 0,1:15:19.64,1:15:20.51,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:20.59,1:15:23.26,Default,,0,0,0,,Менің жеңісім шындыққа жанаспаса
Dialogue: 0,1:15:23.35,1:15:25.93,Default,,0,0,0,,Мен шындықтан қашу үшін бар күшімді саламын.
Dialogue: 0,1:15:26.02,1:15:28.52,Default,,0,0,0,,Шындықтан қашу – менің өзімнен күткенім.
Dialogue: 0,1:15:28.60,1:15:30.56,Default,,0,0,0,,Мен өзімнен бас тартқан жоқпын.
Dialogue: 0,1:15:30.65,1:15:31.81,Default,,0,0,0,,Қалып
Dialogue: 0,1:15:31.90,1:15:34.78,Default,,0,0,0,,Айнала қандай болса да, шындық қандай?
Dialogue: 0,1:15:34.86,1:15:37.49,Default,,0,0,0,,Ақиқат пен ағартушылықты тарату
Dialogue: 0,1:15:37.57,1:15:39.45,Default,,0,0,0,,Мен өзімді танимын
Dialogue: 0,1:15:40.07,1:15:44.66,Default,,0,0,0,,Бұл менің миссиям, менің жұмысым, өмірдің мәні, жүгіру себебім
Dialogue: 0,1:15:46.08,1:15:47.41,Default,,0,0,0,,Тыңда, Тоғаши.
Dialogue: 0,1:15:47.50,1:15:49.67,Default,,0,0,0,,Егер сіз не үшін жүгіріп жатқаныңызды білсеңіз
Dialogue: 0,1:15:49.75,1:15:52.63,Default,,0,0,0,,Сіз шындықтан қалағаныңызша қаша аласыз.
Dialogue: 0,1:15:53.79,1:15:55.55,Default,,0,0,0,,- (Қатысушы) Кайто мырза - (Каито) О, сәлем.
Dialogue: 0,1:15:55.63,1:15:58.05,Default,,0,0,0,,Бұл Секигучи, жаңа мүше.
Dialogue: 0,1:15:58.13,1:16:00.93,Default,,0,0,0,,- (Кайто) Сәлем - (Секигучи) Танысқаныма қуаныштымын, мен Секигучимін.
Dialogue: 0,1:16:01.01,1:16:03.64,Default,,0,0,0,,Кайдомен кездесу үлкен мәртебе.
Dialogue: 0,1:16:10.39,1:16:11.81,Default,,0,0,0,,Бұл әлі алда көп жол бар екенін білдіреді.
Dialogue: 0,1:16:11.90,1:16:13.69,Default,,0,0,0,,Сіз жұмысты жалғастырасыз ба?
Dialogue: 0,1:16:13.77,1:16:15.15,Default,,0,0,0,,Иә
Dialogue: 0,1:16:15.23,1:16:16.78,Default,,0,0,0,,Өткенді ұмыту
Dialogue: 0,1:16:16.86,1:16:18.07,Default,,0,0,0,,Енді не істей аласыз
Dialogue: 0,1:16:18.15,1:16:20.20,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасауға тырысамын.
Dialogue: 0,1:16:20.28,1:16:21.86,Default,,0,0,0,,Бір жастағы Комия ойыншысы
Dialogue: 0,1:16:21.95,1:16:23.45,Default,,0,0,0,,Әлі де тоқтаусыз
Dialogue: 0,1:16:23.53,1:16:25.58,Default,,0,0,0,,Алдыңғы қатарда болу туралы
Dialogue: 0,1:16:25.66,1:16:26.87,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,1:16:27.66,1:16:29.87,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:16:29.96,1:16:32.79,Default,,0,0,0,,Мен тағы да сол сахнада өнер көрсеткім келеді.
Dialogue: 0,1:16:32.87,1:16:34.17,Default,,0,0,0,,Соңында
Dialogue: 0,1:16:34.25,1:16:37.80,Default,,0,0,0,,Тоғаши неге жүгіре береді?
Dialogue: 0,1:16:38.71,1:16:40.30,Default,,0,0,0,,Сен осы уақыт бойы мұнда болдың ба? Кофе жарай ма?
Dialogue: 0,1:16:41.38,1:16:42.76,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,1:17:00.44,1:17:02.78,Default,,0,0,0,,Мм... бұл Тоғаши, солай ма?
Dialogue: 0,1:17:03.28,1:17:04.11,Default,,0,0,0,,Иә
Dialogue: 0,1:17:04.20,1:17:05.45,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,1:17:05.53,1:17:06.58,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:06.66,1:17:07.78,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,1:17:07.87,1:17:09.16,Default,,0,0,0,,Сізбен танысқаныма қуаныштымын.
Dialogue: 0,1:17:09.24,1:17:11.20,Default,,0,0,0,,Менің атым Морикава.
Dialogue: 0,1:17:11.29,1:17:12.54,Default,,0,0,0,,Морикава мырза?
Dialogue: 0,1:17:12.62,1:17:15.25,Default,,0,0,0,,Егер есімде дұрыс болса, мен өткен жылы орта мектепте жаңа турнир рекордын орнаттым...
Dialogue: 0,1:17:15.33,1:17:17.84,Default,,0,0,0,,Иә Сіз білесіз бе?
Dialogue: 0,1:17:17.92,1:17:19.71,Default,,0,0,0,,Рохан, келгеніңе қуаныштымын. Сені күтіп жүр едім. Дәл уақытында келдің.
Dialogue: 0,1:17:19.80,1:17:23.47,Default,,0,0,0,,Мен жеңіл атлетикамен айналыса бастадым, себебі Тоғашидың жүгіруіне сүйсіндім.
Dialogue: 0,1:17:23.55,1:17:27.05,Default,,0,0,0,,Мм... қолыңды қыссам болады ма?
Dialogue: 0,1:17:27.14,1:17:29.35,Default,,0,0,0,,А... әрине
Dialogue: 0,1:17:29.43,1:17:30.35,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:17:30.43,1:17:31.35,Default,,0,0,0,,Хаха
Dialogue: 0,1:17:32.85,1:17:35.27,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,1:17:37.02,1:17:38.48,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:17:41.28,1:17:42.86,Default,,0,0,0,,Йо Тогаши
Dialogue: 0,1:17:42.94,1:17:44.70,Default,,0,0,0,,Ах, Кайто-сан.
Dialogue: 0,1:17:46.57,1:17:48.99,Default,,0,0,0,,Өткен күн үшін рахмет.
Dialogue: 0,1:17:49.08,1:17:50.91,Default,,0,0,0,,Сіз қалай ойлайсыз? Қалыңыз қалай?
Dialogue: 0,1:17:51.87,1:17:53.87,Default,,0,0,0,,Содан бері жағдай біршама жақсарды.
Dialogue: 0,1:17:53.96,1:17:55.58,Default,,0,0,0,,Бұл әлі анық емес.
Dialogue: 0,1:17:55.67,1:17:59.04,Default,,0,0,0,,Жеңіс немесе жеңіліс үшін емес, басқа біреу үшін жүгіріңіз
Dialogue: 0,1:17:59.13,1:18:00.84,Default,,0,0,0,,Бұл менің жүгіру себебім...
Dialogue: 0,1:18:00.92,1:18:03.88,Default,,0,0,0,,Мүмкін бұл шындықтан қашудың жолы шығар
Dialogue: 0,1:18:03.97,1:18:05.09,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:18:08.51,1:18:11.60,Default,,0,0,0,,Иә, жауап әр адамда әртүрлі.
Dialogue: 0,1:18:11.68,1:18:13.89,Default,,0,0,0,,Бірақ мен де осылай ойлаймын.
Dialogue: 0,1:18:13.98,1:18:18.81,Default,,0,0,0,,Шындықтың не екенін білмейінше, шындықтан қашып құтыла алмайсың.
Dialogue: 0,1:18:18.90,1:18:21.82,Default,,0,0,0,,Тоқтап, шындыққа көзіңізді жұмыңыз
Dialogue: 0,1:18:21.90,1:18:24.86,Default,,0,0,0,,Көзді ашып, қашып кетуден мүлде басқа.
Dialogue: 0,1:18:24.95,1:18:28.87,Default,,0,0,0,,Шындықпен бетпе-бет келу қорқынышты, бұл керемет.
Dialogue: 0,1:18:29.66,1:18:32.20,Default,,0,0,0,,Сіз мойындағыңыз келмейтін нәрселерді мойындауыңыз керек.
Dialogue: 0,1:18:36.12,1:18:38.63,Default,,0,0,0,,Бірақ шындықты өзгерткіңіз келсе...
Dialogue: 0,1:18:38.71,1:18:40.04,Default,,0,0,0,,Егер сіз оны жоққа шығарсаңыз
Dialogue: 0,1:18:40.13,1:18:42.13,Default,,0,0,0,,Мұны жасамас бұрын онымен бетпе-бет келу керек.
Dialogue: 0,1:18:42.71,1:18:45.17,Default,,0,0,0,,Көзіңді жұмысаң ешқайда қашып құтыла алмайсың
Dialogue: 0,1:18:45.26,1:18:47.43,Default,,0,0,0,,Сізге ұзақ уақыт бір орында тұруға тура келеді
Dialogue: 0,1:18:48.34,1:18:50.14,Default,,0,0,0,,Сау бол, Тоғашы
Dialogue: 0,1:18:51.14,1:18:51.97,Default,,0,0,0,,Иә
Dialogue: 0,1:19:45.61,1:19:47.49,Default,,0,0,0,,Әй... Тоғашы-сан!
Dialogue: 0,1:19:47.57,1:19:49.28,Default,,0,0,0,,-Ой... -(Кадр) Тоғашы-сан
Dialogue: 0,1:19:49.36,1:19:52.87,Default,,0,0,0,,Күтпеген жерден 2-ші орын, Қабағымен бірдей дерлік
Dialogue: 0,1:19:52.95,1:19:55.95,Default,,0,0,0,,Мұнда келіңіз және стандартты B рекордын бұзыңыз...
Dialogue: 0,1:19:56.04,1:19:58.04,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,1:19:56.04,1:19:58.04,Default,,0,0,0,,Хахахахахаха
Dialogue: 0,1:19:58.12,1:20:00.50,Default,,0,0,0,,Шынымды айтсам, күтпеген жағдай болды.
Dialogue: 0,1:20:00.58,1:20:01.96,Default,,0,0,0,,А... хахаха...
Dialogue: 0,1:20:02.54,1:20:03.88,Default,,0,0,0,,Шынымды айтсам, мен де.
Dialogue: 0,1:20:03.96,1:20:06.96,Default,,0,0,0,,Дұрыс? Хахахаха
Dialogue: 0,1:20:07.05,1:20:11.30,Default,,0,0,0,,Енді мен биылғы Жапония чемпионатына қатысуға құқығым бар.
Dialogue: 0,1:20:11.38,1:20:14.64,Default,,0,0,0,,Мен осы жерден үлкен камбэк күтемін.
Dialogue: 0,1:20:14.72,1:20:15.81,Default,,0,0,0,,Увааах! Оох…
Dialogue: 0,1:20:15.89,1:20:18.35,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,1:20:27.07,1:20:27.94,Default,,0,0,0,,Фу…
Dialogue: 0,1:20:28.03,1:20:29.82,Default,,0,0,0,,А, Тоғаши-сан.
Dialogue: 0,1:20:29.90,1:20:31.15,Default,,0,0,0,,Бүгін тағы кездескеніме қуаныштымын
Dialogue: 0,1:20:33.74,1:20:34.70,Default,,0,0,0,,Қалайсың?
Dialogue: 0,1:20:34.78,1:20:36.37,Default,,0,0,0,,О, бұл жаман емес.
Dialogue: 0,1:20:40.12,1:20:41.41,Default,,0,0,0,,Жақсы
Dialogue: 0,1:20:42.29,1:20:43.12,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,1:20:43.21,1:20:50.17,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:21:02.14,1:21:03.60,Default,,0,0,0,,Бұл еттен үзіліс.
Dialogue: 0,1:21:04.19,1:21:05.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:05.98,1:21:09.23,Default,,0,0,0,,Осы жылы матчқа қатысудан бас тартқан дұрыс.
Dialogue: 0,1:21:10.11,1:21:13.32,Default,,0,0,0,,Я... Бірақ Жапония чемпионаты бір аптадан кейін...
Dialogue: 0,1:21:13.41,1:21:16.70,Default,,0,0,0,,Тогаши мырза, бұлшық еттердің жоғалуын бағаламаңыз.
Dialogue: 0,1:21:16.78,1:21:17.87,Default,,0,0,0,,Мен қазір қозғалсам да
Dialogue: 0,1:21:17.95,1:21:20.25,Default,,0,0,0,,Егер сіз жүктемені түсіре берсеңіз және ол толығымен жойылып кетсе,
Dialogue: 0,1:21:20.33,1:21:22.46,Default,,0,0,0,,Мен зейнетке шығамын.
Dialogue: 0,1:21:23.37,1:21:26.33,Default,,0,0,0,,Бірақ мен жүгіруім керек
Dialogue: 0,1:21:26.96,1:21:29.00,Default,,0,0,0,,Болашақты ойласаң, кем дегенде жарты жыл.
Dialogue: 0,1:21:29.09,1:21:31.30,Default,,0,0,0,,Емдеуге көңіл бөлу керек
Dialogue: 0,1:21:31.38,1:21:35.05,Default,,0,0,0,,Сіз жақсы емделіп, келесі жылы қайталап көріңіз.
Dialogue: 0,1:21:39.47,1:21:40.22,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:40.22,1:21:40.72,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:40.22,1:21:40.72,Default,,0,0,0,,Менің ойымша, бұл жай ғана сәтсіз жарақат, бірақ мен турнирге қатыса алмаймын ба деп қорқамын.
Dialogue: 0,1:21:40.72,1:21:44.52,Default,,0,0,0,,Менің ойымша, бұл бақытсыз жарақат, бірақ мен турнирге қатыса алмаймын ба деп қорқамын.
Dialogue: 0,1:21:44.60,1:21:46.19,Default,,0,0,0,,Келісімшарт жойылады.
Dialogue: 0,1:21:47.02,1:21:48.02,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:21:48.11,1:21:49.57,Default,,0,0,0,,Бұл рас
Dialogue: 0,1:21:49.65,1:21:53.03,Default,,0,0,0,,Бұл келісім-шартта көрсетілген.
Dialogue: 0,1:21:53.95,1:21:55.70,Default,,0,0,0,,Дегенмен, компания ретінде
Dialogue: 0,1:21:55.78,1:21:58.24,Default,,0,0,0,,Еңбек сіңірген Тоғашы мырзаға.
Dialogue: 0,1:21:58.33,1:22:01.83,Default,,0,0,0,,Мен жаттықтырушы ретінде жеңіл атлетика командамызды дамытуды жалғастырамын.
Dialogue: 0,1:22:01.91,1:22:04.79,Default,,0,0,0,,Осыған біраз күш саласыз деп үміттенемін.
Dialogue: 0,1:22:04.87,1:22:07.54,Default,,0,0,0,,Осы құжатты оқып шығыңыз.
Dialogue: 0,1:22:07.63,1:22:08.67,Default,,0,0,0,,Егер келісесіз...
Dialogue: 0,1:22:11.46,1:22:14.05,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,1:22:14.13,1:22:15.59,Default,,0,0,0,,Қазір өзімді жақсы сезінемін
Dialogue: 0,1:22:17.51,1:22:19.97,Default,,0,0,0,,Осымен 4-топты жеңе аламын ба?
Dialogue: 0,1:22:20.06,1:22:22.97,Default,,0,0,0,,Хмм, қадамды ұзартып көрейік.
Dialogue: 0,1:22:23.06,1:22:24.52,Default,,0,0,0,,Бұл тезірек болуы мүмкін.
Dialogue: 0,1:22:24.60,1:22:25.94,Default,,0,0,0,,Бұл керісінше.
Dialogue: 0,1:22:26.02,1:22:26.98,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:33.23,1:22:36.40,Default,,0,0,0,,Сіздің қадамыңыз тым кең және тепе-теңдігіңіз бұзылған.
Dialogue: 0,1:22:36.49,1:22:37.78,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:38.57,1:22:40.41,Default,,0,0,0,,Кешіріңіз, мен сіздің сөзіңізді бөлдім.
Dialogue: 0,1:22:40.49,1:22:42.99,Default,,0,0,0,,Мм... қадам дегеніміз не?
Dialogue: 0,1:22:43.08,1:22:44.37,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:45.46,1:22:48.08,Default,,0,0,0,,Аяғыңызды тым алға қоюдың орнына
Dialogue: 0,1:22:48.17,1:22:50.84,Default,,0,0,0,,Менің ойымша, жерді бірте-бірте итеру жақсы.
Dialogue: 0,1:22:50.92,1:22:52.34,Default,,0,0,0,,Ішке кіру сезімімен
Dialogue: 0,1:22:52.42,1:22:53.92,Default,,0,0,0,,Ішке кіру...
Dialogue: 0,1:22:54.71,1:22:56.72,Default,,0,0,0,,Иә, солай
Dialogue: 0,1:22:56.80,1:22:59.30,Default,,0,0,0,,-(1-бала) Жарайды, байқап көрейік. -(2-бала) Жарайды.
Dialogue: 0,1:22:59.89,1:23:01.30,Default,,0,0,0,,Мұны мұқият тексерейік
Dialogue: 0,1:23:01.39,1:23:02.60,Default,,0,0,0,,Рахмет
Dialogue: 0,1:23:02.68,1:23:04.35,Default,,0,0,0,,Спорт күні немесе бір нәрсе ме?
Dialogue: 0,1:23:04.43,1:23:05.27,Default,,0,0,0,,Иә
Dialogue: 0,1:23:05.35,1:23:07.35,Default,,0,0,0,,Мына жігіт зәкір, мен оның алдында тұрмын.
Dialogue: 0,1:23:07.44,1:23:09.23,Default,,0,0,0,,4-топты жеңгім келеді
Dialogue: 0,1:23:09.31,1:23:12.27,Default,,0,0,0,,Түсіндім, 4-топта қарсылас бар.
Dialogue: 0,1:23:12.94,1:23:16.07,Default,,0,0,0,,Бірақ бүгінгі технологиядан маңыздысы
Dialogue: 0,1:23:16.15,1:23:18.41,Default,,0,0,0,,Бұл сіз жоғалтқан кезде болуы мүмкін.
Dialogue: 0,1:23:18.49,1:23:19.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:20.78,1:23:23.37,Default,,0,0,0,,Бар күшіңмен күрессең де, жеңіліп қалуың мүмкін.
Dialogue: 0,1:23:23.45,1:23:24.74,Default,,0,0,0,,Бірақ бұл күйзеліс туралы емес.
Dialogue: 0,1:23:24.83,1:23:27.04,Default,,0,0,0,,Өміріңді алатындай емес.
Dialogue: 0,1:23:27.58,1:23:29.17,Default,,0,0,0,,Жоғалтқан дұрыс сияқты сезінген дұрыс
Dialogue: 0,1:23:29.25,1:23:30.58,Default,,0,0,0,,Бұл азырақ соққы.
Dialogue: 0,1:23:31.46,1:23:34.38,Default,,0,0,0,,Мен шынымен де жақсы өнер көрсете алатын кездер болады.
Dialogue: 0,1:23:35.34,1:23:36.55,Default,,0,0,0,,Жылдамдық бәрі емес
Dialogue: 0,1:23:36.63,1:23:37.76,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:37.84,1:23:38.68,Default,,0,0,0,,Ештеңе етпейді.
Dialogue: 0,1:23:38.76,1:23:39.84,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,1:23:39.93,1:23:42.30,Default,,0,0,0,,Өз өміріңізге қауіп төндірмесеңіз де...
Dialogue: 0,1:23:42.39,1:23:43.22,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,1:23:45.52,1:23:47.14,Default,,0,0,0,,Өмір дегеніміз...
Dialogue: 0,1:23:52.56,1:23:59.20,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:24:10.25,1:24:12.67,Default,,0,0,0,,Оны қолға түсірсек, біз жеңеміз
Dialogue: 0,1:24:12.75,1:24:13.67,Default,,0,0,0,,Иә
Dialogue: 0,1:24:17.96,1:24:21.68,Default,,0,0,0,,(Ұлдардың қатты тыныс алуы)
Dialogue: 0,1:24:24.89,1:24:28.81,Default,,0,0,0,,(Тогашидың жылағаны)
Dialogue: 0,1:25:12.77,1:25:14.27,Default,,0,0,0,,Тоғаши-кун
Dialogue: 0,1:25:14.35,1:25:15.19,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:15.77,1:25:16.65,Default,,0,0,0,,Джиндзин мырза
Dialogue: 0,1:25:16.73,1:25:18.07,Default,,0,0,0,,Мен оны сізге жіберемін.
Dialogue: 0,1:25:20.86,1:25:24.11,Default,,0,0,0,,Рахмет, жақсы ұстаз, мені таныстырғаныңыз үшін.
Dialogue: 0,1:25:24.20,1:25:27.70,Default,,0,0,0,,Әй, қалай болғанда да, бір аптадан кейін болады.
Dialogue: 0,1:25:27.78,1:25:32.00,Default,,0,0,0,,Маған мүмкіндігінше тезірек тағы үш 100 метр жүгіру керек.
Dialogue: 0,1:25:32.08,1:25:34.79,Default,,0,0,0,,Орта мектептегі өзімді еске түсіреді
Dialogue: 0,1:25:35.42,1:25:38.46,Default,,0,0,0,,Мен қатты қорқып қалсам да, сол сәт...
Dialogue: 0,1:25:38.55,1:25:43.01,Default,,0,0,0,,Мен сол кішкентай сәт үшін өз өмірімді құрбан ете алатындай сезінемін.
Dialogue: 0,1:25:43.68,1:25:47.68,Default,,0,0,0,,Мен мұны білмей тұрып, ертең өмір сүру үшін өлдім.
Dialogue: 0,1:25:50.18,1:25:52.85,Default,,0,0,0,,Келесі жарыс менің 25 жыл
Dialogue: 0,1:25:52.93,1:25:54.39,Default,,0,0,0,,Ал қазір
Dialogue: 0,1:25:55.23,1:25:59.27,Default,,0,0,0,,Мен кешегі күннің жалғасы ретінде өмір сүргім келеді
Dialogue: 0,1:26:00.23,1:26:03.53,Default,,0,0,0,,Енді мен тез жүгіре алмаймын.
Dialogue: 0,1:26:04.86,1:26:06.57,Default,,0,0,0,,Қалайсың? Кабаки-кун
Dialogue: 0,1:26:06.66,1:26:08.45,Default,,0,0,0,,Бұл біраз әбігерге түсті, солай емес пе?
Dialogue: 0,1:26:08.53,1:26:10.33,Default,,0,0,0,,Алдын ала дайындық жаттығулары ғана.
Dialogue: 0,1:26:10.41,1:26:12.50,Default,,0,0,0,,Ертеңгі финалды күтеміз...
Dialogue: 0,1:26:16.33,1:26:18.08,Default,,0,0,0,,Қайырлы таң, Кабаки-кун
Dialogue: 0,1:26:18.71,1:26:20.34,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:26:21.21,1:26:23.84,Default,,0,0,0,,Тоғаши-сан, мен сені жараланған деп естідім.
Dialogue: 0,1:26:26.47,1:26:29.60,Default,,0,0,0,,Әйтеуір, көңілім босамай тұр.
Dialogue: 0,1:26:29.68,1:26:31.18,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:26:32.27,1:26:33.81,Default,,0,0,0,,Содан кейін жүк көлігінде.
Dialogue: 0,1:26:34.56,1:26:35.64,Default,,0,0,0,,Иә
Dialogue: 0,1:26:36.81,1:26:37.73,Default,,0,0,0,,Тоғаши деген кім?
Dialogue: 0,1:26:37.81,1:26:39.81,Default,,0,0,0,,Алдын ала кезеңде бір топтамыз, солай ма?
Dialogue: 0,1:26:39.90,1:26:41.36,Default,,0,0,0,,Ал, Кабаки-кун, ертең...
Dialogue: 0,1:26:41.44,1:26:42.94,Default,,0,0,0,,Жағдайлар өзгерді
Dialogue: 0,1:26:44.11,1:26:45.53,Default,,0,0,0,,Тартыңыз
Dialogue: 0,1:26:56.41,1:26:58.21,Default,,0,0,0,,О...
Dialogue: 0,1:26:58.29,1:27:01.17,Default,,0,0,0,,1 орын Кабаки, Тоғаши 2 орын
Dialogue: 0,1:27:01.25,1:27:04.26,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:27:04.34,1:27:07.34,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:27:10.93,1:27:11.85,Default,,0,0,0,,Иә
Dialogue: 0,1:27:16.98,1:27:19.90,Default,,0,0,0,,Сіз әрқашан дайынсыз.
Dialogue: 0,1:27:20.69,1:27:21.61,Default,,0,0,0,,Зайцу мырза
Dialogue: 0,1:27:26.99,1:27:29.78,Default,,0,0,0,,Алдын ала кезеңдерді өткізіп, 1-орынға ыңғайлы кіресіз бе?
Dialogue: 0,1:27:30.45,1:27:31.70,Default,,0,0,0,,Зайцу мырза да
Dialogue: 0,1:27:35.58,1:27:37.75,Default,,0,0,0,,Мазасыздықпен күресу және т.б.
Dialogue: 0,1:27:37.83,1:27:41.17,Default,,0,0,0,,Психикалық күтім дейтін күндерді сағындым.
Dialogue: 0,1:27:41.79,1:27:43.92,Default,,0,0,0,,Бұл бөлім үшін рахмет.
Dialogue: 0,1:27:44.42,1:27:46.97,Default,,0,0,0,,Сіздің арқаңызда мен қазір өз мақсатымды көріп тұрмын.
Dialogue: 0,1:27:47.67,1:27:48.93,Default,,0,0,0,,Бұл мақсат па?
Dialogue: 0,1:27:49.01,1:27:49.97,Default,,0,0,0,,Иә
Dialogue: 0,1:27:50.68,1:27:53.60,Default,,0,0,0,,Ықтималдық және есептеу Трендтер және қарсы шаралар
Dialogue: 0,1:27:53.68,1:27:57.14,Default,,0,0,0,,Менің жалғыз мақсатым – алда тұрған ұлы рекорд.
Dialogue: 0,1:27:57.23,1:27:58.48,Default,,0,0,0,,Келесі жолы мен жеңемін
Dialogue: 0,1:28:01.65,1:28:05.78,Default,,0,0,0,,Мен бүкіл өмірімді жазып алуға қорықтым.
Dialogue: 0,1:28:05.86,1:28:07.49,Default,,0,0,0,,Бұл комплимент пе?
Dialogue: 0,1:28:07.57,1:28:09.53,Default,,0,0,0,,Әрине, өкінішті.
Dialogue: 0,1:28:10.78,1:28:14.70,Default,,0,0,0,,Абсолюттік король атағының орнына И
Dialogue: 0,1:28:14.78,1:28:16.74,Default,,0,0,0,,Жауынгерлік рухты жоғалтты
Dialogue: 0,1:28:16.83,1:28:19.62,Default,,0,0,0,,Неғұрлым жылдамдасаңыз, соғұрлым бір-бірінен алшақтайсыз.
Dialogue: 0,1:28:20.29,1:28:22.54,Default,,0,0,0,,Жан жағына қарасам ешкім жоқ
Dialogue: 0,1:28:22.63,1:28:26.30,Default,,0,0,0,,Ол жақтан көрініс төменгі жағындағымен бірдей.
Dialogue: 0,1:28:27.13,1:28:29.09,Default,,0,0,0,,Ешқашан қызықсыз болған емес
Dialogue: 0,1:28:29.84,1:28:33.43,Default,,0,0,0,,Нағыз жеңіс... Бізге қуаныш сыйлайтын нәрсе
Dialogue: 0,1:28:33.51,1:28:35.60,Default,,0,0,0,,Рекорд немесе медаль емес
Dialogue: 0,1:28:35.68,1:28:37.22,Default,,0,0,0,,Тек қарсылас
Dialogue: 0,1:28:37.89,1:28:39.89,Default,,0,0,0,,Бірінші орын басқа біреумен жарысып жеңіп алды
Dialogue: 0,1:28:39.98,1:28:41.56,Default,,0,0,0,,- (Зайцу) Бұл солай... - (Комия) Мен үшін.
Dialogue: 0,1:28:42.48,1:28:44.36,Default,,0,0,0,,Менің өз жолым бар.
Dialogue: 0,1:28:45.36,1:28:46.19,Default,,0,0,0,,О
Dialogue: 0,1:28:46.90,1:28:48.07,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:28:53.24,1:28:54.66,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,1:29:01.25,1:29:03.75,Default,,0,0,0,,Ерлер арасында 100 метрге жартылай финал 1-топ
Dialogue: 0,1:29:03.83,1:29:04.88,Default,,0,0,0,,Сіздің белгілеріңіз туралы
Dialogue: 0,1:29:04.96,1:29:07.88,Default,,0,0,0,,Назар аударыңыз Кабаки және...
Dialogue: 0,1:29:07.96,1:29:09.63,Default,,0,0,0,,Тоғашы шығар
Dialogue: 0,1:29:09.71,1:29:14.84,Default,,0,0,0,,17 жасар жұлдыз Морикава қаншалықты алыс жүре алады?
Dialogue: 0,1:29:16.80,1:29:17.64,Default,,0,0,0,,Жиын
Dialogue: 0,1:29:21.23,1:29:22.14,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,1:29:30.65,1:29:32.57,Default,,0,0,0,,(Қабағидың ауыр тыныс алуы)
Dialogue: 0,1:29:32.65,1:29:34.57,Default,,0,0,0,,(Тоғашидың ауыр тыныс алуы)
Dialogue: 0,1:29:35.95,1:29:36.62,Default,,0,0,0,,О!
Dialogue: 0,1:29:36.62,1:29:37.03,Default,,0,0,0,,О!
Dialogue: 0,1:29:36.62,1:29:37.03,Default,,0,0,0,,1-орын Тоғашы, 2-орын Кабаки
Dialogue: 0,1:29:37.03,1:29:39.49,Default,,0,0,0,,1-орын Тоғашы, 2-орын Кабаки
Dialogue: 0,1:29:39.58,1:29:44.04,Default,,0,0,0,,Осы турнирдің ең жасы Морикава жақсы өнер көрсетіп, 3-ші орынға ие болды.
Dialogue: 0,1:29:51.34,1:29:53.42,Default,,0,0,0,,Кайто Зайцу Комия
Dialogue: 0,1:29:53.51,1:29:56.55,Default,,0,0,0,,Жапониядағы қазіргі үздік үштіктің барлығы өз жолында ма?
Dialogue: 0,1:29:56.64,1:29:58.18,Default,,0,0,0,,Бұл шын мәнінде финал.
Dialogue: 0,1:29:58.26,1:30:01.77,Default,,0,0,0,,Зайцу соңғы кездері азайып бара жатқан сияқты.
Dialogue: 0,1:30:01.85,1:30:04.56,Default,,0,0,0,,Менің ойымша, Комия биыл барады.
Dialogue: 0,1:30:04.64,1:30:07.15,Default,,0,0,0,,Зайцу өзінің жас кезінде әдеттен тыс болды.
Dialogue: 0,1:30:07.23,1:30:09.36,Default,,0,0,0,,Мен мұны әлі де істей аламын деп ойлаймын.
Dialogue: 0,1:30:09.44,1:30:12.49,Default,,0,0,0,,Қалай болғанда да, Зайцу немесе Комия.
Dialogue: 0,1:30:12.57,1:30:14.53,Default,,0,0,0,,Иә, Зайцу немесе Комия.
Dialogue: 0,1:30:14.61,1:30:16.11,Default,,0,0,0,,Бұл Зайцу немесе Комия ма?
Dialogue: 0,1:30:16.20,1:30:17.20,Default,,0,0,0,,Зайцу немесе Комия?
Dialogue: 0,1:30:17.28,1:30:18.41,Default,,0,0,0,,Зайцу немесе Комия.
Dialogue: 0,1:30:18.49,1:30:19.49,Default,,0,0,0,,Зайцу немесе Комия!
Dialogue: 0,1:30:19.58,1:30:21.04,Default,,0,0,0,,Бұл Зайцу немесе Комия!
Dialogue: 0,1:30:21.12,1:30:22.45,Default,,0,0,0,,Зайцу немесе Комия.
Dialogue: 0,1:30:23.83,1:30:25.04,Default,,0,0,0,,Зайцу… Комия
Dialogue: 0,1:30:25.12,1:30:26.37,Default,,0,0,0,,Зайцу немесе Комия.
Dialogue: 0,1:30:26.46,1:30:29.84,Default,,0,0,0,,Зайцу немесе Комия Зайцу немесе Комия
Dialogue: 0,1:30:29.92,1:30:30.92,Default,,0,0,0,,Иә
Dialogue: 0,1:30:31.75,1:30:33.71,Default,,0,0,0,,Мен москит торының сыртындамын ба?
Dialogue: 0,1:30:34.67,1:30:38.59,Default,,0,0,0,,Жақында 2-ші жартылай финалдық топ басталады.
Dialogue: 0,1:30:38.68,1:30:41.68,Default,,0,0,0,,Кайтоның Зайцу мен Комияға қалай шабуыл жасағанын көру қызықты болады.
Dialogue: 0,1:30:41.68,1:30:43.77,Default,,0,0,0,,Кайтоның Зайцу мен Комияға қалай шабуыл жасағанын көру қызықты болады.
Dialogue: 0,1:30:41.68,1:30:43.77,Default,,0,0,0,,Сіздің белгілеріңіз туралы
Dialogue: 0,1:30:52.78,1:30:53.61,Default,,0,0,0,,Жиын
Dialogue: 0,1:30:57.41,1:30:58.74,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,1:31:08.04,1:31:09.79,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,1:31:09.88,1:31:12.42,Default,,0,0,0,,Шындық дегеніміз не?
Dialogue: 0,1:31:14.01,1:31:15.30,Default,,0,0,0,,Иә
Dialogue: 0,1:31:16.09,1:31:18.13,Default,,0,0,0,,Енді бастайық.
Dialogue: 0,1:31:18.22,1:31:20.89,Default,,0,0,0,,Біз шындықтан қашамыз ба?
Dialogue: 0,1:31:23.89,1:31:24.72,Default,,0,0,0,,1-орын Кайто, 2-орын Комия
Dialogue: 0,1:31:24.72,1:31:27.02,Default,,0,0,0,,1 орын Кайто, 2 орын Комия
Dialogue: 0,1:31:24.72,1:31:27.02,Default,,0,0,0,,(Көрермендердің шуы)
Dialogue: 0,1:31:27.02,1:31:27.10,Default,,0,0,0,,(Көрермендердің шуы)
Dialogue: 0,1:31:27.10,1:31:29.19,Default,,0,0,0,,(Көрермендердің шуы)
Dialogue: 0,1:31:27.10,1:31:29.19,Default,,0,0,0,,Зайцу 5-ші орында
Dialogue: 0,1:31:29.19,1:31:29.27,Default,,0,0,0,,(Көрермендердің шуы)
Dialogue: 0,1:31:29.27,1:31:30.81,Default,,0,0,0,,(Көрермендердің шуы)
Dialogue: 0,1:31:29.27,1:31:30.81,Default,,0,0,0,,Зайцу күтпеген апаттың салдарынан жартылай финалда жеңілді
Dialogue: 0,1:31:30.81,1:31:33.32,Default,,0,0,0,,Зайцу жартылай финалда жеңілді, күтпеген апат
Dialogue: 0,1:31:33.40,1:31:36.49,Default,,0,0,0,,Кайто ақыры Зайцуды жеңді
Dialogue: 0,1:31:36.57,1:31:41.53,Default,,0,0,0,,Ал Кайтоның қазіргі рекорды Жапония тарихындағы екінші ең жоғары көрсеткіш.
Dialogue: 0,1:31:48.33,1:31:49.42,Default,,0,0,0,,Комия-кун
Dialogue: 0,1:31:51.63,1:31:53.25,Default,,0,0,0,,Тағы да көп уақыт өтті.
Dialogue: 0,1:31:54.05,1:31:55.05,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,1:31:56.13,1:31:57.84,Default,,0,0,0,,Инхайдан бері 10 жыл
Dialogue: 0,1:31:57.92,1:32:00.34,Default,,0,0,0,,Мен сенімен бірге осында жүгіре аламын.
Dialogue: 0,1:32:01.43,1:32:02.26,Default,,0,0,0,,Иә
Dialogue: 0,1:32:03.26,1:32:06.52,Default,,0,0,0,,Тоғаши-күн, сен бұл туралы ойладың ба?
Dialogue: 0,1:32:06.60,1:32:10.02,Default,,0,0,0,,Бұл қашықтықты күнде қайталаудың бостығы
Dialogue: 0,1:32:11.40,1:32:13.02,Default,,0,0,0,,Мен осында соңғы 10 жыл болдым.
Dialogue: 0,1:32:13.11,1:32:15.98,Default,,0,0,0,,Менің бар ойым – рекорд жасау.
Dialogue: 0,1:32:16.48,1:32:19.28,Default,,0,0,0,,Керісінше, мен басқа ештеңені ойламадым.
Dialogue: 0,1:32:19.95,1:32:21.66,Default,,0,0,0,,Бірақ дәл қазір
Dialogue: 0,1:32:21.74,1:32:24.87,Default,,0,0,0,,Мен рекордыма мән бермеген адамға рекордым үшін жеңілдім.
Dialogue: 0,1:32:25.53,1:32:27.12,Default,,0,0,0,,Есептеу жоқ
Dialogue: 0,1:32:27.20,1:32:29.04,Default,,0,0,0,,Трендтер мен қарсы шаралар жоқ
Dialogue: 0,1:32:29.12,1:32:31.58,Default,,0,0,0,,Тек қайсарлықтан қашқан адамға.
Dialogue: 0,1:32:32.83,1:32:34.09,Default,,0,0,0,,Егер мен қайтадан
Dialogue: 0,1:32:34.17,1:32:36.46,Default,,0,0,0,,Рекордтарды бұзу үшін
Dialogue: 0,1:32:36.55,1:32:38.59,Default,,0,0,0,,Бұдан басқа не бар?
Dialogue: 0,1:32:40.68,1:32:43.80,Default,,0,0,0,,Жылдам болудан не ұтасың, баяу болудан не ұтасың
Dialogue: 0,1:32:43.89,1:32:45.81,Default,,0,0,0,,Шынында да ештеңе жоқ, солай ма?
Dialogue: 0,1:32:46.72,1:32:48.39,Default,,0,0,0,,Егер солай болса ше?
Dialogue: 0,1:32:49.14,1:32:51.10,Default,,0,0,0,,Бұл сәт не үшін қажет?
Dialogue: 0,1:32:51.89,1:32:53.81,Default,,0,0,0,,Бұл сайыс не үшін?
Dialogue: 0,1:32:55.73,1:32:59.40,Default,,0,0,0,,Біз не үшін жүгіреміз?
Dialogue: 0,1:33:00.11,1:33:01.11,Default,,0,0,0,,Хмм...
Dialogue: 0,1:33:04.28,1:33:05.87,Default,,0,0,0,,Бұл табиғи нәрсе.
Dialogue: 0,1:33:06.95,1:33:08.62,Default,,0,0,0,,Байыпты болу
Dialogue: 0,1:33:08.70,1:33:10.04,Default,,0,0,0,,Бұдан басқа талап етілмейді
Dialogue: 0,1:33:12.46,1:33:16.63,Default,,0,0,0,,Өткеніме қарасам, өмірім әйтеуір қуатқа толы болды.
Dialogue: 0,1:33:17.38,1:33:19.80,Default,,0,0,0,,Жоғалтудан немесе оқшауланудан қорқу
Dialogue: 0,1:33:19.88,1:33:21.88,Default,,0,0,0,,Мен жеңілмеуге бел байладым
Dialogue: 0,1:33:22.68,1:33:25.18,Default,,0,0,0,,Соның кесірінен жеңілістен көзімді тайдырдым.
Dialogue: 0,1:33:25.80,1:33:29.06,Default,,0,0,0,,Мені біреу бақылап тұрғандай біртүрлі сенім сезіндім.
Dialogue: 0,1:33:30.06,1:33:32.60,Default,,0,0,0,,Бірақ соның арқасында мен ақыры жеттім.
Dialogue: 0,1:33:33.39,1:33:36.73,Default,,0,0,0,,Адамдар өз ақылынан басқа ештеңені түсіне алмайды.
Dialogue: 0,1:33:36.81,1:33:38.82,Default,,0,0,0,,Ешкімге де, ешқайда да орын жоқ.
Dialogue: 0,1:33:38.90,1:33:43.03,Default,,0,0,0,,Ынтымақтастық, эмпатия және сүйіспеншілік - бұл біздің болжамдарымыз.
Dialogue: 0,1:33:43.11,1:33:46.37,Default,,0,0,0,,Бұл дүниеде бәрі бізді алаңдатады.
Dialogue: 0,1:33:46.95,1:33:49.58,Default,,0,0,0,,Ал соңында бәрі өледі.
Dialogue: 0,1:33:50.49,1:33:53.54,Default,,0,0,0,,Сабырмен ойласаңыз, онша қауіпті оқиға емес.
Dialogue: 0,1:33:54.25,1:33:55.75,Default,,0,0,0,,Бірақ мұндай нәрселер үшін
Dialogue: 0,1:33:56.96,1:33:58.79,Default,,0,0,0,,Біз байсалдымыз...
Dialogue: 0,1:33:58.88,1:34:00.34,Default,,0,0,0,,Салиқалы болу бақыты
Dialogue: 0,1:34:00.42,1:34:01.92,Default,,0,0,0,,Бір миллиметрді де алып кете алмаймын.
Dialogue: 0,1:34:02.76,1:34:03.92,Default,,0,0,0,,Енді ойлап отырсам
Dialogue: 0,1:34:04.01,1:34:06.80,Default,,0,0,0,,Мен мұны талай рет көрдім.
Dialogue: 0,1:34:06.89,1:34:08.60,Default,,0,0,0,,Мен талай рет дәмін татқанмын.
Dialogue: 0,1:34:09.68,1:34:13.27,Default,,0,0,0,,Өкінішке орай, мен бұрын мұндайды көрген емеспін.
Dialogue: 0,1:34:13.35,1:34:15.31,Default,,0,0,0,,Дәмін татқаным есімде жоқ.
Dialogue: 0,1:34:15.39,1:34:18.40,Default,,0,0,0,,Бұл қуыстың шешімі жоқ.
Dialogue: 0,1:34:19.44,1:34:22.11,Default,,0,0,0,,Комия-кун, ұмытып кеткен сияқтысың.
Dialogue: 0,1:34:22.19,1:34:24.53,Default,,0,0,0,,Бұл дүниеде қарапайым ережелер болуы керек еді.
Dialogue: 0,1:34:25.45,1:34:26.53,Default,,0,0,0,,Соған сәйкес
Dialogue: 0,1:34:27.28,1:34:29.87,Default,,0,0,0,,Егер сіз басқалардан 100 метрге жылдам жүгіре алсаңыз
Dialogue: 0,1:34:29.95,1:34:31.58,Default,,0,0,0,,Барлығын шеш
Dialogue: 0,1:34:32.70,1:34:34.12,Default,,0,0,0,,Хмм...
Dialogue: 0,1:34:34.21,1:34:37.92,Default,,0,0,0,,Сіз оны табасыз, соған ұмтыласыз ...
Dialogue: 0,1:34:38.00,1:34:40.63,Default,,0,0,0,,Сіз бұл жылдамдықты арттырдыңыз
Dialogue: 0,1:34:41.50,1:34:43.05,Default,,0,0,0,,Бұл бекер деп ойлайсың ба?
Dialogue: 0,1:34:43.13,1:34:45.17,Default,,0,0,0,,Шындап жүгірсең, бәрі ұшып кетеді
Dialogue: 0,1:34:45.26,1:34:47.89,Default,,0,0,0,,Жарқыраған дүние жарқырап тұр
Dialogue: 0,1:34:48.76,1:34:51.10,Default,,0,0,0,,Мұндай көріністі көрмеген болсаңыз
Dialogue: 0,1:34:51.72,1:34:53.52,Default,,0,0,0,,Тек осы 100 метр үшін
Dialogue: 0,1:34:53.60,1:34:55.43,Default,,0,0,0,,Осындай көріністі көрейік
Dialogue: 0,1:35:03.82,1:35:06.70,Default,,0,0,0,,Zaitsu Кенеттен дүңгіршек бұрын болды
Dialogue: 0,1:35:06.78,1:35:08.78,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,1:35:08.86,1:35:09.82,Default,,0,0,0,,Бұл жазатайым оқиға болды ма?
Dialogue: 0,1:35:19.54,1:35:23.05,Default,,0,0,0,,Бәріңе айтарым бар.
Dialogue: 0,1:35:25.72,1:35:27.51,Default,,0,0,0,,Бүгінгі күні I
Dialogue: 0,1:35:28.51,1:35:30.39,Default,,0,0,0,,Белсенді қызметтен кету
Dialogue: 0,1:35:31.18,1:35:33.26,Default,,0,0,0,,Не? Қазір...
Dialogue: 0,1:35:33.76,1:35:35.64,Default,,0,0,0,,Сіз зейнеткерлікке шығамын дедіңіз бе?
Dialogue: 0,1:35:40.10,1:35:42.73,Default,,0,0,0,,(Репортерлердің үрейлі дауыстары)
Dialogue: 0,1:35:42.82,1:35:45.69,Default,,0,0,0,,Сәлем! Zaitsu ойыншысы зейнетке шықты!
Dialogue: 0,1:35:45.78,1:35:47.99,Default,,0,0,0,,Жартылай финалда жеңілу зейнетке шығуыңызға себеп болды ма?
Dialogue: 0,1:35:48.07,1:35:50.03,Default,,0,0,0,,Бұл әлі де жарақат па?
Dialogue: 0,1:35:53.20,1:35:56.95,Default,,0,0,0,,Дәл қазір, дәл осы сәтте менің спортшы ретіндегі мансабым аяқталды.
Dialogue: 0,1:35:57.75,1:35:59.17,Default,,0,0,0,,Мен мұны айта аламын
Dialogue: 0,1:35:59.96,1:36:04.17,Default,,0,0,0,,100 метр өмірді бір сәтке қысқартады
Dialogue: 0,1:36:04.88,1:36:09.18,Default,,0,0,0,,Сантиметрдегі айырмашылық апатқа әкелуі мүмкін. Грамдардағы айырмашылық апатқа әкелуі мүмкін.
Dialogue: 0,1:36:09.26,1:36:10.34,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:36:11.68,1:36:14.22,Default,,0,0,0,,Сондықтан эйфория сезімі пайда болады
Dialogue: 0,1:36:15.43,1:36:19.19,Default,,0,0,0,,Сол қашықтықта ғана рұқсат етілген байлық бар.
Dialogue: 0,1:36:20.23,1:36:21.15,Default,,0,0,0,,Зайцу ойыншысы
Dialogue: 0,1:36:21.23,1:36:23.19,Default,,0,0,0,,Өйткені ол кенеттен зейнетке шығатынын хабарлады.
Dialogue: 0,1:36:23.27,1:36:24.98,Default,,0,0,0,,Біз де оқиға орнындамыз
Dialogue: 0,1:36:25.07,1:36:26.07,Default,,0,0,0,,Ах!
Dialogue: 0,1:36:26.15,1:36:26.98,Default,,0,0,0,,Соңында!
Dialogue: 0,1:36:28.86,1:36:34.20,Default,,0,0,0,,Ертеңгі финалда жүгіретін спортшыларға бірнеше сөз бере аласыз ба?
Dialogue: 0,1:36:38.20,1:36:39.41,Default,,0,0,0,,Үміт
Dialogue: 0,1:36:40.16,1:36:41.33,Default,,0,0,0,,Көңілсіздік
Dialogue: 0,1:36:43.04,1:36:44.21,Default,,0,0,0,,Даңқ
Dialogue: 0,1:36:44.88,1:36:46.05,Default,,0,0,0,,Сәтсіздіктер
Dialogue: 0,1:36:46.71,1:36:48.13,Default,,0,0,0,,Шаршау
Dialogue: 0,1:36:48.21,1:36:49.55,Default,,0,0,0,,Қанағаттану
Dialogue: 0,1:36:49.63,1:36:50.97,Default,,0,0,0,,шыдамсыздық
Dialogue: 0,1:36:51.05,1:36:52.47,Default,,0,0,0,,Жетістік
Dialogue: 0,1:36:53.47,1:36:55.39,Default,,0,0,0,,Ал қуаныш, ашу, қайғы, қуаныш
Dialogue: 0,1:36:56.26,1:36:59.06,Default,,0,0,0,,Барлығын 100 метрге жинаңыз
Dialogue: 0,1:36:59.68,1:37:02.19,Default,,0,0,0,,Ең жақсы 10 секундтан ләззат алыңыз
Dialogue: 0,1:37:02.85,1:37:06.19,Default,,0,0,0,,(Репортерлердің қоңыраулары)
Dialogue: 0,1:38:36.66,1:38:38.53,Default,,0,0,0,,Жапония чемпионатының 2-ші күні
Dialogue: 0,1:38:38.62,1:38:41.58,Default,,0,0,0,,Ақырында ерлер арасында 100 метрге жүгіру финалы өтеді.
Dialogue: 0,1:38:41.66,1:38:45.00,Default,,0,0,0,,Чемпион Зайцу жартылай финалда жеңілді
Dialogue: 0,1:38:45.08,1:38:49.34,Default,,0,0,0,,Ал бүгін, Денгекінің зейнеткерлікке шыққаны туралы хабардан кейін бір күн өткен соң,
Dialogue: 0,1:38:49.42,1:38:52.13,Default,,0,0,0,,Жеңіл атлетика тарихы өзгеруге жақын.
Dialogue: 0,1:39:16.53,1:39:21.49,Default,,0,0,0,,Бүгін кеште біз жаңа тарихтың куәсі боламыз.
Dialogue: 0,1:39:22.03,1:39:24.45,Default,,0,0,0,,Ең жылдам адам ақыры анықталды
Dialogue: 0,1:39:25.04,1:39:27.54,Default,,0,0,0,,Жапония чемпионаты ерлер арасындағы 100 м
Dialogue: 0,1:39:27.62,1:39:29.00,Default,,0,0,0,,Қорытынды
Dialogue: 0,1:39:46.35,1:39:48.06,Default,,0,0,0,,Сіздің белгілеріңіз туралы
Dialogue: 0,1:39:58.36,1:39:59.61,Default,,0,0,0,,Жиын
Dialogue: 0,1:40:02.49,1:40:03.33,Default,,0,0,0,,(Сигнал тапаншасы)
Dialogue: 0,1:40:03.41,1:40:07.83,Default,,0,0,0,,(Ойыншылар ауыр тыныс алады)
Dialogue: 0,1:40:29.94,1:40:32.40,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:40:36.36,1:40:42.03,Default,,0,0,0,,(Комия мен Тогашидың ауыр тыныс алуы)
Dialogue: 0,1:40:47.91,1:40:54.88,Default,,0,0,0,,(Комия мен Тогашидың ауыр тыныс алуы)
Dialogue: 0,1:41:00.47,1:41:06.26,Default,,0,0,0,,(қатты тыныс алу)
