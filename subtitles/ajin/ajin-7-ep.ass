Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.20,0:00:08.10,Default,,0,0,0,,Бұл соңғы кезең, Нагай-кун.
Dialogue: 0,0:00:10.54,0:00:13.31,Default,,0,0,0,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:00:13.41,0:00:15.01,Default,,0,0,0,,Қара елес!
Dialogue: 0,0:00:15.51,0:00:17.71,Default,,0,0,0,,Сіз басқаларға қалай қамқорлық жасай аласыз?
Dialogue: 0,0:00:17.78,0:00:19.11,Default,,0,0,0,,Қаш...
Dialogue: 0,0:00:19.61,0:00:22.05,Default,,0,0,0,,Жоқ, мен сізге көмектескім келеді.
Dialogue: 0,0:00:25.05,0:00:25.55,Default,,0,0,0,,Хмф!
Dialogue: 0,0:00:26.25,0:00:27.32,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:00:28.12,0:00:32.06,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:00:32.16,0:00:34.50,Default,,0,0,0,,Ах! Кей Нагай өзенге барады!
Dialogue: 0,0:00:34.60,0:00:36.36,Default,,0,0,0,,Өзі өзенге секірді!
Dialogue: 0,0:00:38.33,0:00:39.20,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:39.47,0:00:40.14,Default,,0,0,0,,Хмф!
Dialogue: 0,0:00:40.27,0:00:41.64,Default,,0,0,0,,Сіз нені айтасыз...
Dialogue: 0,0:00:41.70,0:00:45.07,Default,,0,0,0,,Үйге қайтайық. Үлгі қашып кетті.
Dialogue: 0,0:00:46.44,0:00:48.24,Default,,0,0,0,,Шляпа ше?
Dialogue: 0,0:00:48.71,0:00:52.31,Default,,0,0,0,,А... Мен оны ешбір бақылау камерасынан көре алмаймын.
Dialogue: 0,0:00:52.45,0:00:55.22,Default,,0,0,0,,Оның мақсаты Кей Нағайды қолға түсіру болса, ол әлдеқашан кетіп қалған шығар...
Dialogue: 0,0:00:55.28,0:00:56.72,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:00:56.79,0:00:57.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:58.05,0:00:59.39,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:00:59.45,0:01:00.49,Default,,0,0,0,,Тозаки мырза...
Dialogue: 0,0:01:00.82,0:01:02.36,Default,,0,0,0,,Сіз осында қаласыз.
Dialogue: 0,0:01:05.69,0:01:07.50,Default,,0,0,0,,Иә, бұл Тозаки.
Dialogue: 0,0:01:08.06,0:01:09.40,Default,,0,0,0,,Мен сені министрмен байланыстырамын.
Dialogue: 0,0:01:12.20,0:01:14.84,Default,,0,0,0,,Президенттер ашулы, Тозаки.
Dialogue: 0,0:01:15.37,0:01:16.64,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:17.24,0:01:21.48,Default,,0,0,0,,Осы қарқынмен сіз өзіңіздің рөліңізді қайта қарауыңыз керек.
Dialogue: 0,0:01:21.54,0:01:22.28,Default,,0,0,0,,Иә
Dialogue: 0,0:01:22.81,0:01:26.25,Default,,0,0,0,,Жоқ, бұл жеткіліксіз.
Dialogue: 0,0:01:26.78,0:01:27.62,Default,,0,0,0,,О, Құдай-ай…➡
Dialogue: 0,0:01:27.68,0:01:28.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:30.49,0:01:31.39,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:39.56,0:01:41.60,Default,,0,0,0,,Ей, сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:01:41.73,0:01:43.73,Default,,0,0,0,,Кеш болды, Сато мырза.
Dialogue: 0,0:01:45.17,0:01:49.77,Default,,0,0,0,,Нагай-кун қызық қозғалады, сондықтан мен онымен ойнадым.
Dialogue: 0,0:01:50.84,0:01:53.24,Default,,0,0,0,,Өзіңізді ашулы етіп көрсетуге тырысыңыз.
Dialogue: 0,0:01:53.81,0:01:55.64,Default,,0,0,0,,Мен көп нәрсе жасадым...
Dialogue: 0,0:01:57.58,0:01:59.81,Default,,0,0,0,,Енді негізгі түйін келеді.
Dialogue: 0,0:02:26.31,0:02:29.44,Default,,0,0,0,,♪Терең ұйықтай аласыз ба? Сіз жараларыңызды емдедіңіз бе? ♪
Dialogue: 0,0:02:29.74,0:02:31.48,Default,,0,0,0,,♪Себебі түн жалғыз♪
Dialogue: 0,0:02:31.55,0:02:33.21,Default,,0,0,0,,♪Өзіңізді біреуді сүюге мәжбүрлеме♪
Dialogue: 0,0:02:33.48,0:02:36.78,Default,,0,0,0,,♪Тіпті армандап, жылау♪
Dialogue: 0,0:02:36.85,0:02:41.66,Default,,0,0,0,,♪Ештеңені білмей өлуге тырыстым♪
Dialogue: 0,0:02:42.49,0:02:45.89,Default,,0,0,0,,♪Сен оны жақсы жасырдың ба? Сіз деміңізді ұстадыңыз ба? ♪
Dialogue: 0,0:02:46.53,0:02:47.80,Default,,0,0,0,,♪Қазір ауыратындықтан♪
Dialogue: 0,0:02:48.20,0:02:49.70,Default,,0,0,0,,♪Өзіңізді өзгертуге мәжбүрлеме♪
Dialogue: 0,0:02:50.30,0:02:53.74,Default,,0,0,0,,♪Тіпті батыл варвар, тіпті қиналған қозы♪
Dialogue: 0,0:02:53.84,0:02:56.91,Default,,0,0,0,,♪Айналма жолдармен өмір сүріп жатырмын♪
Dialogue: 0,0:02:59.34,0:03:01.38,Default,,0,0,0,,♪Көзге түспеу♪
Dialogue: 0,0:03:03.18,0:03:05.48,Default,,0,0,0,,♪ Шыдай алатындай етіп ♪
Dialogue: 0,0:03:06.68,0:03:11.49,Default,,0,0,0,,♪Ойлау процесін әлі тоқтатпа♪
Dialogue: 0,0:03:11.65,0:03:13.66,Default,,0,0,0,,♪Бүгін түнде ЖОЛДА ЖҮРГІЗ♪
Dialogue: 0,0:03:13.72,0:03:15.69,Default,,0,0,0,,♪Өтірік сияқты♪
Dialogue: 0,0:03:15.79,0:03:19.29,Default,,0,0,0,,♪Біреу менің қолымнан ұсташы♪
Dialogue: 0,0:03:19.53,0:03:24.67,Default,,0,0,0,,♪Сіз көре алмайтын ертеңгі күннің келуі міндетті емес♪
Dialogue: 0,0:03:25.20,0:03:29.47,Default,,0,0,0,,♪Дәл қазір мен жай ғана ұйықтағым келеді♪
Dialogue: 0,0:03:41.95,0:03:42.68,Default,,0,0,0,,А...
Dialogue: 0,0:03:44.52,0:03:46.45,Default,,0,0,0,,Бұл жеткіліксіз
Dialogue: 0,0:03:46.92,0:03:48.39,Default,,0,0,0,,О, Құдай-ай…➡
Dialogue: 0,0:03:49.82,0:03:50.96,Default,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:03:52.63,0:03:55.33,Default,,0,0,0,,Осы жолға не үшін келді деп ойлайсың?
Dialogue: 0,0:03:56.66,0:03:58.30,Default,,0,0,0,,Сен осы уақыт бойы мұнда болдың ба? Кофе жарай ма?
Dialogue: 0,0:03:58.90,0:04:00.80,Default,,0,0,0,,Қарғыс атсын... Қарғыс атсын...
Dialogue: 0,0:04:02.00,0:04:03.94,Default,,0,0,0,,Сізге телефон соғуға бола ма, министр?
Dialogue: 0,0:04:05.74,0:04:08.98,Default,,0,0,0,,Тосаки-кун, мен сенің айтқаныңды естідім.
Dialogue: 0,0:04:09.34,0:04:10.71,Default,,0,0,0,,Мен сізді талантты деп естідім.
Dialogue: 0,0:04:10.98,0:04:13.72,Default,,0,0,0,,Жоқ, олай емес... әлі жоқ.
Dialogue: 0,0:04:14.42,0:04:17.49,Default,,0,0,0,,Сондай-ақ «қатты»
Dialogue: 0,0:04:20.86,0:04:23.73,Default,,0,0,0,,Сіз Аджин басқару комитеті туралы білесіз бе?
Dialogue: 0,0:04:24.86,0:04:27.40,Default,,0,0,0,,Бұл лауазымда бос орын бар.
Dialogue: 0,0:04:28.60,0:04:29.60,Default,,0,0,0,,Тозаки мырза
Dialogue: 0,0:04:30.90,0:04:32.43,Default,,0,0,0,,Сізге ақша ұнайды ма?
Dialogue: 0,0:04:42.94,0:04:45.71,Default,,0,0,0,,Бұл мылтық шын ба?
Dialogue: 0,0:04:45.78,0:04:47.72,Default,,0,0,0,,А? Ах...
Dialogue: 0,0:04:48.72,0:04:51.69,Default,,0,0,0,,Ақшаң бар болса, көп нәрсені істей аласың.
Dialogue: 0,0:04:53.62,0:04:58.39,Default,,0,0,0,,Мақсаты демиадамдарды зерттеу және басқару болып табылатын ұйым ақшамен қалай байланысады?
Dialogue: 0,0:05:01.53,0:05:03.97,Default,,0,0,0,,А... тезірек түсінесіз.
Dialogue: 0,0:05:26.92,0:05:27.99,Default,,0,0,0,,(Электрокардиограф дабылы)
Dialogue: 0,0:05:28.56,0:05:30.02,Default,,0,0,0,,А, а...
Dialogue: 0,0:05:30.86,0:05:32.96,Default,,0,0,0,,№ 002 Лезде өлім.
Dialogue: 0,0:05:33.46,0:05:37.73,Default,,0,0,0,,Қазіргі уақытта жүргізіліп жатқан нәрсе - әскери қарудың өнімділігін тексеру.
Dialogue: 0,0:05:38.87,0:05:41.64,Default,,0,0,0,,Демек, сіз деми-адамдарды жалға бересіз...
Dialogue: 0,0:05:41.77,0:05:44.71,Default,,0,0,0,,Күтілгендей, сізде қалай алға ұмтылу туралы жақсы идея бар.
Dialogue: 0,0:05:45.04,0:05:50.41,Default,,0,0,0,,Иә, жапондық атақты компанияның бізбен арадағы келісімшарты бар.
Dialogue: 0,0:05:50.78,0:05:54.55,Default,,0,0,0,,Белгілі бір фармацевтикалық компания деми-адамдарға бірнеше рет клиникалық эксперименттер жүргізді.
Dialogue: 0,0:05:54.75,0:05:57.79,Default,,0,0,0,,Мен жасаған жаңа дәріден үлкен пайда таптым.
Dialogue: 0,0:05:58.45,0:06:02.56,Default,,0,0,0,,Басқалар Қорғаныс құралдарын өндірушілер Медициналық жабдық өндірушілері Әскери өнеркәсіп
Dialogue: 0,0:06:03.36,0:06:05.59,Default,,0,0,0,,Деми-адамдардың көптеген қолданулары бар.
Dialogue: 0,0:06:07.13,0:06:08.93,Default,,0,0,0,,Шаруашылық жануар?
Dialogue: 0,0:06:09.50,0:06:12.67,Default,,0,0,0,,Әй, сен де жақсы басқарсаң...
Dialogue: 0,0:06:12.87,0:06:14.54,Default,,0,0,0,,Сіз үлкен ақша ала аласыз
Dialogue: 0,0:06:20.71,0:06:24.11,Default,,0,0,0,,Үлкен ақша... иә?
Dialogue: 0,0:06:27.78,0:06:28.48,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:31.52,0:06:32.42,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,0:06:35.46,0:06:40.39,Default,,0,0,0,,Не істеу керек? Егер бәрі осылай жалғаса берсе, сіз жасай алатын ең жаман нәрсе - олардан құтылу.
Dialogue: 0,0:06:43.10,0:06:43.97,Default,,0,0,0,,Қашып кеткіңіз келе ме?
Dialogue: 0,0:06:56.98,0:06:59.48,Default,,0,0,0,,Жоқ, күте тұрыңыз, әлі мүмкіндік бар.
Dialogue: 0,0:06:59.55,0:07:01.12,Default,,0,0,0,,Әрқашан мүмкіндік бар...
Dialogue: 0,0:07:06.02,0:07:06.85,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,0:07:19.00,0:07:19.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:33.01,0:07:36.18,Default,,0,0,0,,Мен осылай киінсем не істеуім керек? Сато мырза
Dialogue: 0,0:07:36.68,0:07:39.55,Default,,0,0,0,,Ұйықтап жатқан кейіп таныту керек.
Dialogue: 0,0:07:39.95,0:07:40.89,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:07:41.96,0:07:43.49,Default,,0,0,0,,Тыңда, Танака-кун.
Dialogue: 0,0:07:43.56,0:07:47.70,Default,,0,0,0,,Стратегиялар жағдайға ең қолайлы...
Dialogue: 0,0:07:48.13,0:07:48.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:49.03,0:07:50.80,Default,,0,0,0,,Мәселе бар ма?
Dialogue: 0,0:07:51.83,0:07:54.74,Default,,0,0,0,,Мен өзімді Ганнибал сияқты сезіне бастадым.
Dialogue: 0,0:07:54.80,0:07:55.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:56.17,0:07:59.87,Default,,0,0,0,,Егер мен Ганнибал болсам, сен...
Dialogue: 0,0:08:01.01,0:08:02.58,Default,,0,0,0,,Бұл Кларис па?
Dialogue: 0,0:08:02.68,0:08:06.25,Default,,0,0,0,,Жоқ, бұл Мердок. Бір қарағанда...
Dialogue: 0,0:08:07.08,0:08:08.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:09.82,0:08:12.65,Default,,0,0,0,,Олай болса, бастайық.
Dialogue: 0,0:08:14.52,0:08:17.76,Default,,0,0,0,,«Стратегиялар біртүрлі болуы керек».
Dialogue: 0,0:08:20.63,0:08:23.83,Default,,0,0,0,,Доктор Огура, көлікке қайта оралу әлі де қауіпті.
Dialogue: 0,0:08:24.17,0:08:26.60,Default,,0,0,0,,Менің қосалқы темекім - менің көлігім.
Dialogue: 0,0:08:26.67,0:08:28.54,Default,,0,0,0,,Сіз темекіні ішінен сатып ала аласыз, солай ма?
Dialogue: 0,0:08:28.60,0:08:30.91,Default,,0,0,0,,Бұл тоқтатылған бренд.
Dialogue: 0,0:08:31.11,0:08:32.77,Default,,0,0,0,,Сондықтан менің көлігімде ол бар...
Dialogue: 0,0:08:32.84,0:08:33.54,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:08:33.94,0:08:34.68,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:35.84,0:08:38.85,Default,,0,0,0,,Тізерлеп, қолдар бастың артында.
Dialogue: 0,0:08:41.78,0:08:44.05,Default,,0,0,0,,Күш қатынасын түсінесің бе?
Dialogue: 0,0:08:44.59,0:08:50.22,Default,,0,0,0,,Бізді жау қылсаң, бастық екеуің құтылмайсыңдар.
Dialogue: 0,0:08:50.89,0:08:51.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:53.56,0:08:54.53,Default,,0,0,0,,О...
Dialogue: 0,0:08:56.60,0:08:58.07,Default,,0,0,0,,Мен саған қозғалма дедім.
Dialogue: 0,0:08:58.23,0:09:00.23,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:01.30,0:09:04.01,Default,,0,0,0,,Ақпарат беруге соншалықты құлықсыз болғаныма сене алмадым.
Dialogue: 0,0:09:04.07,0:09:05.54,Default,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,0:09:08.94,0:09:12.78,Default,,0,0,0,,Маған бәрібір. Бұл дүниеде өкініш жоқ.
Dialogue: 0,0:09:13.21,0:09:15.78,Default,,0,0,0,,Соңғы рет темекі шеге алсам ғой
Dialogue: 0,0:09:16.62,0:09:19.65,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:09:25.66,0:09:27.23,Default,,0,0,0,,Шынымен тыныштық орнады...
Dialogue: 0,0:09:27.56,0:09:29.56,Default,,0,0,0,,Қауіпсіздік қызметкері! Не болды?
Dialogue: 0,0:09:30.26,0:09:31.97,Default,,0,0,0,,Мен ішке кіре алмаймын.
Dialogue: 0,0:09:32.03,0:09:33.00,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:09:33.67,0:09:35.60,Default,,0,0,0,,Қалай болғанда да, мен нұсқаулар алғанша күтуім керек...
Dialogue: 0,0:09:35.70,0:09:36.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:40.21,0:09:40.98,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:09:44.88,0:09:46.21,Default,,0,0,0,,Не?
Dialogue: 0,0:09:46.28,0:09:49.35,Default,,0,0,0,,Лабораториядан арбаны итеріп бара жатқан адам шықты!
Dialogue: 0,0:09:49.72,0:09:50.92,Default,,0,0,0,,Сіз туыссыз ба? ?
Dialogue: 0,0:09:52.32,0:09:56.29,Default,,0,0,0,,Бұл жақсы емес... БАҚ өкілдері, бұл қауіпті.
Dialogue: 0,0:09:58.09,0:10:00.76,Default,,0,0,0,,Эй, сен мүгедектер арбасында отырған Танака емессің бе?
Dialogue: 0,0:10:00.83,0:10:02.60,Default,,0,0,0,,Танака! ? Бұл Жапониядағы екінші жағдай ма?
Dialogue: 0,0:10:02.66,0:10:04.70,Default,,0,0,0,,Сөзсіз! Бір сәтке бола ма?
Dialogue: 0,0:10:05.30,0:10:06.80,Default,,0,0,0,,Ей, кірме! (Тілшілер) Бізге өз оқиғаңызды айтып беріңізші!
Dialogue: 0,0:10:06.87,0:10:07.87,Default,,0,0,0,,Артқа тұрыңыз! (Күзетші) Түсіңіз!
Dialogue: 0,0:10:07.94,0:10:09.84,Default,,0,0,0,,Әй... (Күзетші) Әй, мен біраз қиналдым.
Dialogue: 0,0:10:10.37,0:10:11.97,Default,,0,0,0,,Танака мырза! Кешіріңіз
Dialogue: 0,0:10:14.08,0:10:16.84,Default,,0,0,0,,Уақыт маңызды болды
Dialogue: 0,0:10:17.85,0:10:22.38,Default,,0,0,0,,Кей Нагайдың тұтқынға алынуы және Огура Икуяның Жапонияға келуі
Dialogue: 0,0:10:23.05,0:10:25.89,Default,,0,0,0,,Көптеген БАҚ бір жерге жиналады.
Dialogue: 0,0:10:27.92,0:10:29.96,Default,,0,0,0,,Бүгінгі күннің уақыты
Dialogue: 0,0:10:32.96,0:10:34.06,Default,,0,0,0,,Бүгін...
Dialogue: 0,0:10:36.40,0:10:40.64,Default,,0,0,0,,Бүгін мен жалпы жұртшылық білгім келетін нәрсе бар...
Dialogue: 0,0:10:41.27,0:10:42.40,Default,,0,0,0,,Мен мұнда келдім
Dialogue: 0,0:10:43.67,0:10:46.81,Default,,0,0,0,,Тек екі нәрсе, мені тыңдаңыз.
Dialogue: 0,0:10:48.74,0:10:51.78,Default,,0,0,0,,Сіз не істемексіз? Сато мырза
Dialogue: 0,0:10:53.31,0:10:55.25,Default,,0,0,0,,Менің атым Сато
Dialogue: 0,0:10:57.69,0:10:58.65,Default,,0,0,0,,Бұл жарты адам
Dialogue: 0,0:10:58.72,0:11:00.89,Default,,0,0,0,,Иә! ? (Тілшілер) Ажин?
Dialogue: 0,0:11:00.96,0:11:01.96,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:11:02.02,0:11:04.33,Default,,0,0,0,,Үкімет қамауға алудан қорықпайсыз ба?
Dialogue: 0,0:11:04.39,0:11:06.99,Default,,0,0,0,,Қақпақ... Екі әңгіме дегенді қалай түсінесіңдер?
Dialogue: 0,0:11:09.13,0:11:10.30,Default,,0,0,0,,Біріншісі -
Dialogue: 0,0:11:11.20,0:11:15.67,Default,,0,0,0,,Мен сіздің маңызды емес ақпаратқа ергеніңізді қаламаймын.
Dialogue: 0,0:11:16.77,0:11:20.31,Default,,0,0,0,,2000 жылдардың басында бір жаңалық жұртшылықты дүрліктірді
Dialogue: 0,0:11:20.41,0:11:22.14,Default,,0,0,0,,Баршаңызға белгілі...
Dialogue: 0,0:11:23.21,0:11:27.92,Default,,0,0,0,,Осы жерде Коджи Танака мырза туралы жаңалықтар.
Dialogue: 0,0:11:28.32,0:11:31.72,Default,,0,0,0,,Коджи... Сәлем Коджи
Dialogue: 0,0:11:32.82,0:11:34.39,Default,,0,0,0,,Не болды? көк жүзімен
Dialogue: 0,0:11:34.99,0:11:39.29,Default,,0,0,0,,Әкем... Мен... жарты адам болдым.
Dialogue: 0,0:11:39.96,0:11:42.26,Default,,0,0,0,,Қателік бар емес пе?
Dialogue: 0,0:11:42.40,0:11:44.87,Default,,0,0,0,,Бұл не? Бұл таңқаларлық емес пе?
Dialogue: 0,0:11:44.97,0:11:46.87,Default,,0,0,0,,Егер сен жарты адам болсаң... не істер едің?
Dialogue: 0,0:11:47.87,0:11:48.90,Default,,0,0,0,,Кешіріңіз—
Dialogue: 0,0:11:49.00,0:11:49.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:50.84,0:11:51.97,Default,,0,0,0,,Бар емес пе? Өтінемін
Dialogue: 0,0:11:52.04,0:11:54.28,Default,,0,0,0,,Танака мырза! Маған өз оқиғаңызды айтып беріңізші
Dialogue: 0,0:11:54.34,0:11:55.28,Default,,0,0,0,,Танака-сан!
Dialogue: 0,0:11:56.01,0:11:57.78,Default,,0,0,0,,Жапониядағы деми-адамның екінші жағдайы
Dialogue: 0,0:11:57.85,0:12:00.78,Default,,0,0,0,,Коджи Танака мырзаның жоғалып кеткеніне үш күн болды...
Dialogue: 0,0:12:00.85,0:12:04.45,Default,,0,0,0,,Бұл бағдарлама Коджи Танакаға ақшалай сыйлық беру туралы шешім қабылдады!
Dialogue: 0,0:12:04.85,0:12:07.22,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:08.86,0:12:13.06,Default,,0,0,0,,Хабардың қызып кеткені сонша, тіпті ақшалай сыйлықтарды ұсынатын шоу да болды.
Dialogue: 0,0:12:14.23,0:12:17.40,Default,,0,0,0,,Ал Кей Нагайдың бұл ісі де осыған ұқсас.
Dialogue: 0,0:12:17.93,0:12:20.30,Default,,0,0,0,,Оқиға ретінде қарастырылды...
Dialogue: 0,0:12:20.40,0:12:23.84,Default,,0,0,0,,Мұны жігерлендіретін көптеген есептер де болды.
Dialogue: 0,0:12:25.17,0:12:27.51,Default,,0,0,0,,Бұдан ары не күтіп тұрғанын білмеу
Dialogue: 0,0:12:27.81,0:12:29.24,Default,,0,0,0,,Әрине, мен білемін!
Dialogue: 0,0:12:29.31,0:12:30.98,Default,,0,0,0,,Бұнда қандай мәселе бар?
Dialogue: 0,0:12:31.18,0:12:34.45,Default,,0,0,0,,Кейбіреулер мұны аздап аянышты деп айтатыны рас.
Dialogue: 0,0:12:34.52,0:12:38.09,Default,,0,0,0,,Деми-адам екені анықталғандарды үкімет қорғайды...
Dialogue: 0,0:12:38.19,0:12:41.12,Default,,0,0,0,,Оның бақылауында өмір сүру керек.
Dialogue: 0,0:12:41.52,0:12:44.86,Default,,0,0,0,,Үкімет бұл туралы ресми түрде хабарлағанын білемін.
Dialogue: 0,0:12:44.93,0:12:48.00,Default,,0,0,0,,Бірақ бұл... өтірік.
Dialogue: 0,0:12:48.43,0:12:53.20,Default,,0,0,0,,Үкімет деми-адамдарға адамгершілікке жатпайтын эксперименттер жүргізуде.
Dialogue: 0,0:12:54.03,0:12:56.10,Default,,0,0,0,,Бұл екінші оқиға.
Dialogue: 0,0:12:56.37,0:12:58.11,Default,,0,0,0,,Сіз не туралы айтып отырсыз? (Репортер) Бұл қалалық аңыз.
Dialogue: 0,0:12:58.17,0:13:02.28,Default,,0,0,0,,2005 жылы американдық әскерилердің деми-адамдарға эксперименттер жүргізгені туралы бейнежазбалар тарап кетті.
Dialogue: 0,0:13:02.34,0:13:03.54,Default,,0,0,0,,проблемаға айналды
Dialogue: 0,0:13:03.81,0:13:07.01,Default,,0,0,0,,Мұндай жағдай Жапонияда да болуы мүмкін деп ойлайтындар көп.
Dialogue: 0,0:13:07.08,0:13:08.78,Default,,0,0,0,,Бірақ... (Тілшілер) Бірақ, Сато мырза.
Dialogue: 0,0:13:09.05,0:13:11.95,Default,,0,0,0,,Сіз бұл жалғандыққа сеніп, шекара бұзғансыз.
Dialogue: 0,0:13:12.02,0:13:13.09,Default,,0,0,0,,Сіз Танака мырзаны шығарып салдыңыз ба?
Dialogue: 0,0:13:13.15,0:13:14.86,Default,,0,0,0,,Бұл қылмыстық әрекет екені анық!
Dialogue: 0,0:13:14.92,0:13:15.92,Default,,0,0,0,,Дәлел бар
Dialogue: 0,0:13:15.99,0:13:17.26,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:13:17.86,0:13:22.10,Default,,0,0,0,,Интернетке жүктеп салынған
Dialogue: 0,0:13:23.13,0:13:25.50,Default,,0,0,0,,Қазір тексеріңіз! (Тілшілер) Мен оны онлайн көре аламын ба?
Dialogue: 0,0:13:28.54,0:13:30.97,Default,,0,0,0,,Ах... жүктеп салынды.
Dialogue: 0,0:13:31.07,0:13:32.01,Default,,0,0,0,,Лейденшафтличтің солтүстік-шығысында—
Dialogue: 0,0:13:33.07,0:13:34.38,Default,,0,0,0,,Бейне-
Dialogue: 0,0:13:35.08,0:13:39.25,Default,,0,0,0,,Демиадам зерттеушінің үй компьютерінен алынған өте құпия деректер!
Dialogue: 0,0:13:39.31,0:13:41.02,Default,,0,0,0,,Уау (тілшілер) Бұл өте жақсы.
Dialogue: 0,0:13:41.08,0:13:42.95,Default,,0,0,0,,Бұл CG. Бұрын да ұқсас нәрсе болған.
Dialogue: 0,0:13:43.02,0:13:43.98,Default,,0,0,0,,Бұл ақпаратты жазу
Dialogue: 0,0:13:44.49,0:13:47.59,Default,,0,0,0,,Бұған жол беруге болмайды!
Dialogue: 0,0:13:48.42,0:13:50.12,Default,,0,0,0,,Дұрыс? барлығы!
Dialogue: 0,0:13:50.49,0:13:52.83,Default,,0,0,0,,Даусыңызды бірге көтеріңіз!
Dialogue: 0,0:13:54.46,0:14:01.10,Default,,0,0,0,,2 күннен кейін мен наразылық білдіремін! Орналасқан жері Денсаулық сақтау, еңбек және әл-ауқат министрлігінің алдында!
Dialogue: 0,0:14:03.04,0:14:05.34,Default,,0,0,0,,Бірге күресіңіздер!
Dialogue: 0,0:14:06.17,0:14:11.15,Default,,0,0,0,,Мен жарты адам болған кезде...
Dialogue: 0,0:14:15.02,0:14:16.02,Default,,0,0,0,,Және…
Dialogue: 0,0:14:18.52,0:14:23.39,Default,,0,0,0,,Әр адамның бақыты үшін
Dialogue: 0,0:14:31.50,0:14:32.23,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:32.30,0:14:33.43,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:14:34.30,0:14:35.94,Default,,0,0,0,,Ой…
Dialogue: 0,0:14:36.87,0:14:38.17,Default,,0,0,0,,Жоқ! Түсіңіз!
Dialogue: 0,0:14:45.98,0:14:49.42,Default,,0,0,0,,Қазір бұл не? Сато-сан, бұл да сенікі еді...
Dialogue: 0,0:14:49.88,0:14:50.92,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:14:55.62,0:14:59.03,Default,,0,0,0,,Күні кеше ғылыми-зерттеу институтында болған оқиғаға қатысты...
Dialogue: 0,0:14:59.09,0:15:03.56,Default,,0,0,0,,Өзін Сато деп атаған адамның мәлімдемесі мүлдем негізсіз.
Dialogue: 0,0:15:03.93,0:15:07.50,Default,,0,0,0,,Сондай-ақ көптеген күзетшілер, зерттеушілер және-
Dialogue: 0,0:15:07.60,0:15:11.21,Default,,0,0,0,,Жапонияға келген Икуя Огура мырзаның өлімі де расталды...
Dialogue: 0,0:15:15.64,0:15:17.48,Default,,0,0,0,,Бүгін... дұрыс па?
Dialogue: 0,0:15:21.98,0:15:26.49,Default,,0,0,0,,Сіз не істемексіз? Тозаки мырза, Шозен үшін бұл үлкен мәселе болады.
Dialogue: 0,0:15:27.99,0:15:31.33,Default,,0,0,0,,Маған не болады?
Dialogue: 0,0:15:32.69,0:15:36.16,Default,,0,0,0,,Не айтасыз... ештеңе өзгермейді.
Dialogue: 0,0:15:41.64,0:15:43.50,Default,,0,0,0,,А? Ештеңе
Dialogue: 0,0:15:44.61,0:15:46.07,Default,,0,0,0,,Сіз мені теледидардан көрмейсіз бе?
Dialogue: 0,0:15:47.04,0:15:49.98,Default,,0,0,0,,Сіз демонстрация жасаймын дедіңіз.
Dialogue: 0,0:15:50.44,0:15:51.51,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:15:52.18,0:15:54.95,Default,,0,0,0,,Мүмкін мен кірістірілген суретке түсіруім керек шығар.
Dialogue: 0,0:15:55.65,0:15:58.05,Default,,0,0,0,,Осындай нәрселерге байланысты адамдар қозғалмайды.
Dialogue: 0,0:15:58.45,0:16:00.65,Default,,0,0,0,,Мұны көп тарих дәлелдеген
Dialogue: 0,0:16:01.69,0:16:04.26,Default,,0,0,0,,Ұшқындар сізге тимегенше...
Dialogue: 0,0:16:04.56,0:16:06.59,Default,,0,0,0,,Сіз мәңгілікке бей-жай қала аласыз
Dialogue: 0,0:16:07.16,0:16:09.00,Default,,0,0,0,,Бұл біздің болмысымыз
Dialogue: 0,0:16:11.00,0:16:12.60,Default,,0,0,0,,Біріншіден, интернетте-
Dialogue: 0,0:16:13.07,0:16:15.44,Default,,0,0,0,,Көптеген жалған эксперименттік бейнелер бар.
Dialogue: 0,0:16:16.64,0:16:20.24,Default,,0,0,0,,Шынайы мен жалғанды ​​ешкім ажырата алмайды.
Dialogue: 0,0:16:21.18,0:16:22.74,Default,,0,0,0,,Ойланып қарашы, көрдің бе? Бейне
Dialogue: 0,0:16:23.01,0:16:24.71,Default,,0,0,0,,Әй, құлайтыны ма?
Dialogue: 0,0:16:25.15,0:16:30.62,Default,,0,0,0,,Бүгін түнде Жапониядағы деми-адамдарға қатысты жағдай күрт өзгереді.
Dialogue: 0,0:16:32.69,0:16:35.22,Default,,0,0,0,,«Айтарлықтай көлеңкеленген» деген не?
Dialogue: 0,0:16:35.76,0:16:38.43,Default,,0,0,0,,Мен қашып кеткендердің бәрін табамын.
Dialogue: 0,0:16:38.99,0:16:42.13,Default,,0,0,0,,Және оны жасыруды ұмытпаңыз
Dialogue: 0,0:16:44.13,0:16:45.17,Default,,0,0,0,,Кеттік (Изуми) А...
Dialogue: 0,0:16:45.53,0:16:47.00,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:17:02.25,0:17:03.22,Default,,0,0,0,,Фуфуфу…
Dialogue: 0,0:17:04.02,0:17:07.72,Default,,0,0,0,,Бұл операция адамдарды тартуға арналмаған.
Dialogue: 0,0:17:10.06,0:17:12.43,Default,,0,0,0,,Бұл деми-адамдарды жинауға арналған.
Dialogue: 0,0:17:12.63,0:17:13.49,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:17:14.43,0:17:18.33,Default,,0,0,0,,Деми-адам бейненің шынайы екенін айта алады.
Dialogue: 0,0:17:19.53,0:17:24.14,Default,,0,0,0,,Мәселе «қалай ойнау керек» Сапасы жалғаннан бөлек
Dialogue: 0,0:17:24.57,0:17:25.71,Default,,0,0,0,,Және-
Dialogue: 0,0:17:26.41,0:17:31.55,Default,,0,0,0,,Нагай-кун екеуміз қашып кеткен көріністі эфирге беруге мәжбүр болдық.
Dialogue: 0,0:17:32.31,0:17:34.38,Default,,0,0,0,,Мен ұсталсам да қашып құтылдым.
Dialogue: 0,0:17:34.78,0:17:39.42,Default,,0,0,0,,Бұл мысал деми-адамдарға қауіпсіздік сезімін береді және олардың алға шығуын жеңілдетеді.
Dialogue: 0,0:17:40.39,0:17:42.79,Default,,0,0,0,,Ал маған сенетін болады
Dialogue: 0,0:17:45.09,0:17:47.29,Default,,0,0,0,,Мм... Уау.
Dialogue: 0,0:17:47.43,0:17:53.20,Default,,0,0,0,,Бұл бастапқы нүкте. Елді өзгертейік, Танака-кун.
Dialogue: 0,0:17:54.60,0:17:56.50,Default,,0,0,0,,Фуфуфу…
Dialogue: 0,0:17:57.47,0:18:01.41,Default,,0,0,0,,Сіздің жоспарыңыз дәл жоспарланғандай, Сато мырза.
Dialogue: 0,0:18:04.38,0:18:09.35,Default,,0,0,0,,Келгендеріңізге рахмет. Мен сізге нақты кездесу орнын айтамын.
Dialogue: 0,0:18:10.08,0:18:11.65,Default,,0,0,0,,Ертең сағат 14.00-де...
Dialogue: 0,0:18:13.59,0:18:15.19,Default,,0,0,0,,Мен сенің сонда болғаныңды қалаймын
Dialogue: 0,0:18:30.64,0:18:32.67,Default,,0,0,0,,Ах... өлді.
Dialogue: 0,0:18:34.14,0:18:35.78,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:18:37.48,0:18:38.41,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:18:40.41,0:18:42.48,Default,,0,0,0,,Бұл мен...
Dialogue: 0,0:18:43.82,0:18:47.25,Default,,0,0,0,,Мм... Тозаки мырза?
Dialogue: 0,0:18:48.49,0:18:49.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:51.49,0:18:53.29,Default,,0,0,0,,Бұл... бұл?
Dialogue: 0,0:18:53.83,0:18:56.53,Default,,0,0,0,,Сіз айып соққысын жасадыңыз деп ойлаймын?
Dialogue: 0,0:18:57.13,0:18:59.70,Default,,0,0,0,,Тозаки мырза, бұл шынымен жаман емес пе?
Dialogue: 0,0:18:59.80,0:19:03.47,Default,,0,0,0,,Мәселе жоқ, оққағарды атқан қалпақтағы мылтық болды.
Dialogue: 0,0:19:03.57,0:19:05.57,Default,,0,0,0,,Мен күдіктенбеймін
Dialogue: 0,0:19:08.18,0:19:12.18,Default,,0,0,0,,Бұл адам өзінің бастапқы түрі танылмайтындай етіп жыртылып кеткен зерттеуші.
Dialogue: 0,0:19:12.25,0:19:14.21,Default,,0,0,0,,Мені мәйітпен алмастырды.
Dialogue: 0,0:19:14.28,0:19:16.62,Default,,0,0,0,,Тіс емдеу жазбаларын бұзу
Dialogue: 0,0:19:16.82,0:19:17.78,Default,,0,0,0,,бірақ онымен бәсекеге түсер ешкім қалмады ма?
Dialogue: 0,0:19:17.85,0:19:20.72,Default,,0,0,0,,Сол күні мен тағы да растадым
Dialogue: 0,0:19:21.69,0:19:26.23,Default,,0,0,0,,«Басқаларды қаншалықты бақытсыз етсе де, мақсатыңызға жетіңіз».
Dialogue: 0,0:19:27.93,0:19:32.67,Default,,0,0,0,,Мен саған бәрін беремін, сен ұстағанның бәрін.
Dialogue: 0,0:19:33.57,0:19:35.60,Default,,0,0,0,,Егер мен айып соққысын әкелсем ше?
Dialogue: 0,0:19:36.50,0:19:39.21,Default,,0,0,0,,Қағаз сияқты ол да әзілқой.
Dialogue: 0,0:19:39.31,0:19:41.84,Default,,0,0,0,,Жапон зерттеушілерінің бұлай айтқанын түсінемін.
Dialogue: 0,0:19:42.28,0:19:45.65,Default,,0,0,0,,Бұл елде қабылданғаны таңқаларлық емес.
Dialogue: 0,0:19:46.58,0:19:48.62,Default,,0,0,0,,Ол данышпан.
Dialogue: 0,0:20:01.66,0:20:03.93,Default,,0,0,0,,Ой...
Dialogue: 0,0:20:05.60,0:20:06.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:09.47,0:20:11.21,Default,,0,0,0,,Иә? Сіз адасып қалдыңыз ба?
Dialogue: 0,0:20:15.44,0:20:17.41,Default,,0,0,0,,Ол адамға не болды?
Dialogue: 0,0:20:19.25,0:20:21.25,Default,,0,0,0,,Мен апатқа байланысты оянбаймын.
Dialogue: 0,0:20:21.88,0:20:24.65,Default,,0,0,0,,Әй, бейшара.
Dialogue: 0,0:20:25.75,0:20:29.26,Default,,0,0,0,,Иә, ол аянышты адам еді.
Dialogue: 0,0:20:30.46,0:20:33.33,Default,,0,0,0,,«Әрқашан қайталап көруге мүмкіндік болуы керек»
Dialogue: 0,0:20:34.29,0:20:36.50,Default,,0,0,0,,Ол кісі осылай айтатын.
Dialogue: 0,0:20:37.83,0:20:39.70,Default,,0,0,0,,Бірақ солай болды
Dialogue: 0,0:20:40.93,0:20:43.74,Default,,0,0,0,,Ата-анамнан қалған қарызбен өмір сүру...
Dialogue: 0,0:20:44.77,0:20:48.88,Default,,0,0,0,,Осыған байланысты мен медициналық сақтандыруды да төлей алмадым.
Dialogue: 0,0:20:50.01,0:20:51.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:52.98,0:20:57.55,Default,,0,0,0,,Оны емдеу үшін бізге көп ақша керек деген сөз.
Dialogue: 0,0:20:58.72,0:21:01.66,Default,,0,0,0,,Бауырым, сен ол кісінің досысың ба?
Dialogue: 0,0:21:03.02,0:21:04.29,Default,,0,0,0,,Менің күйеуім
Dialogue: 0,0:21:04.89,0:21:06.29,Default,,0,0,0,,Жақсырақ болады деп үміттенемін.
Dialogue: 0,0:21:06.79,0:21:07.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:08.66,0:21:10.93,Default,,0,0,0,,Мен оны ғана бақытты етемін
Dialogue: 0,0:21:15.34,0:21:18.87,Default,,0,0,0,,Дүниедегі кез келген адамды тозаққа жіберуге болады
Dialogue: 0,0:21:29.65,0:21:30.42,Default,,0,0,0,,А...
Dialogue: 0,0:21:33.55,0:21:35.59,Default,,0,0,0,,А... Аа...
Dialogue: 0,0:21:36.49,0:21:39.33,Default,,0,0,0,,Мен ауырсынуға үйрендім, бірақ...
Dialogue: 0,0:21:40.33,0:21:44.56,Default,,0,0,0,,Суға батып кету... иә... бұл өте ауыр.
Dialogue: 0,0:21:45.47,0:21:48.57,Default,,0,0,0,,Уф... Уф... А...
Dialogue: 0,0:21:49.34,0:21:53.41,Default,,0,0,0,,Уф... Өйткені, адамдарға көмектесу...
Dialogue: 0,0:21:54.84,0:21:58.01,Default,,0,0,0,,Ах... иә...
Dialogue: 0,0:21:58.71,0:22:01.45,Default,,0,0,0,,Бұл істеу керек нәрсе емес.
Dialogue: 0,0:22:02.05,0:22:04.82,Default,,0,0,0,,Ах... иә...
Dialogue: 0,0:22:13.66,0:22:14.36,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:22:15.93,0:22:17.93,Default,,0,0,0,,Бұл бәрі ме?
Dialogue: 0,0:22:19.37,0:22:20.77,Default,,0,0,0,,Кел!
Dialogue: 0,0:22:31.58,0:22:37.08,Default,,0,0,0,,♪Егер тілегім орындалса, тағы да♪
Dialogue: 0,0:22:37.72,0:22:43.02,Default,,0,0,0,,♪Мен сенің жүрегіңді қозғағым келеді♪
Dialogue: 0,0:22:43.66,0:22:48.96,Default,,0,0,0,,♪Қанша қараңғы болса да, іздеймін♪
Dialogue: 0,0:22:49.73,0:22:54.13,Default,,0,0,0,,♪Бір ғана шам♪
Dialogue: 0,0:22:55.64,0:22:58.97,Default,,0,0,0,,♪Жұлдыздарға қарағанымда♪
Dialogue: 0,0:22:59.54,0:23:01.41,Default,,0,0,0,,♪Алыс болса да♪
Dialogue: 0,0:23:01.71,0:23:06.98,Default,,0,0,0,,♪Сол бір жұлдызды аспанға қарап♪
Dialogue: 0,0:23:07.58,0:23:12.99,Default,,0,0,0,,♪Жүрегімнің аспанына түсетін сияқты♪
Dialogue: 0,0:23:13.65,0:23:17.76,Default,,0,0,0,,♪Сіздің күлкіңіз бен жылуыңыз♪
Dialogue: 0,0:23:18.09,0:23:19.46,Default,,0,0,0,,♪Мені тыңда♪
Dialogue: 0,0:23:19.56,0:23:24.50,Default,,0,0,0,,♪Кетіп, Жалғыз күндерді көргенше♪
Dialogue: 0,0:23:24.56,0:23:27.73,Default,,0,0,0,,♪Сүйу деген нені білдіреді?♪
Dialogue: 0,0:23:27.93,0:23:30.94,Default,,0,0,0,,♪Мен білемін деп ойладым♪
Dialogue: 0,0:23:31.71,0:23:36.41,Default,,0,0,0,,♪Менің алдымда болғанның бәрін сезіну♪
Dialogue: 0,0:23:36.48,0:23:39.71,Default,,0,0,0,,♪Мен маңызды нәрсені жоғалтып алдым♪
Dialogue: 0,0:23:39.85,0:23:44.02,Default,,0,0,0,,♪Шынайы махаббатты тану♪
Dialogue: 0,0:23:45.62,0:23:49.72,Default,,0,0,0,,♪Айтайын енді, Қаншалықты жақынсың♪
Dialogue: 0,0:23:51.22,0:23:57.22,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory