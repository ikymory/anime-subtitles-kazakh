Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:25.16,0:01:27.08,Default,,0,0,0,,Эй, клоун-кун
Dialogue: 0,0:01:27.08,0:01:31.09,Default,,0,0,0,,Сізге жаңа үй ұнай ма?
Dialogue: 0,0:01:31.09,0:01:34.09,Default,,0,0,0,,Ей, эй, соншалықты көңілі толмаңдар.
Dialogue: 0,0:01:34.09,0:01:36.09,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:01:36.09,0:01:39.10,Default,,0,0,0,,Әкеңнің ауысуы қалыпты жағдай емес пе?
Dialogue: 0,0:01:39.10,0:01:43.08,Default,,0,0,0,,Мен де ертең жаңа мектеп ашамын.
Dialogue: 0,0:01:43.08,0:01:45.08,Default,,0,0,0,,Жоқ, мен дос бола алмаймын.
Dialogue: 0,0:01:45.08,0:01:47.09,Default,,0,0,0,,Барлық жерде бірдей
Dialogue: 0,0:01:47.09,0:01:49.09,Default,,0,0,0,,Мені жұбатпасаң да, жарайды.
Dialogue: 0,0:01:49.09,0:01:52.09,Default,,0,0,0,,Өйткені сен мендесің
Dialogue: 0,0:01:52.09,0:01:55.09,Default,,0,0,0,,Мен кез келген нәрсе туралы сөйлесе алатын жалғыз адамсың.
Dialogue: 0,0:01:55.09,0:01:57.10,Default,,0,0,0,,Сен менің нағыз досымсың
Dialogue: 0,0:01:57.10,0:01:59.10,Default,,0,0,0,,Клоун-кун
Dialogue: 0,0:02:02.09,0:02:04.09,Default,,0,0,0,,Иә
Dialogue: 0,0:02:04.09,0:02:07.09,Default,,0,0,0,,Сіздің досыңыз...
Dialogue: 0,0:02:07.09,0:02:09.09,Default,,0,0,0,,Тек мен
Dialogue: 0,0:02:13.10,0:02:15.10,Default,,0,0,0,,Бұл дүниеде
Dialogue: 0,0:02:15.10,0:02:19.09,Default,,0,0,0,,Қарапайым көзге көрінбейтін қараңғылықта өмір сүретін адамдар бар.
Dialogue: 0,0:02:19.09,0:02:22.09,Default,,0,0,0,,Кейде азу тістерін жалаңаштады
Dialogue: 0,0:02:22.09,0:02:26.09,Default,,0,0,0,,Сізге келе жатыр
Dialogue: 0,0:02:26.09,0:02:31.10,Default,,0,0,0,,Ол сені сол жігіттерден қорғау үшін келді.
Dialogue: 0,0:02:31.10,0:02:36.09,Default,,0,0,0,,Тозақ түбінен келген әділет елшісі\NМүмкін
Dialogue: 0,0:02:36.09,0:02:39.09,Default,,0,0,0,,...
Dialogue: 0,0:02:43.09,0:02:45.09,Default,,0,0,0,,Нубе!
Dialogue: 0,0:03:00.09,0:03:03.09,Default,,0,0,0,,Қайырлы таң Қайырлы таң
Dialogue: 0,0:03:13.09,0:03:15.09,Default,,0,0,0,,О, асығыңыз! Күте тұрыңыз!
Dialogue: 0,0:03:43.10,0:03:46.09,Default,,0,0,0,,Хмм, бұл тәтті, хехехехе
Dialogue: 0,0:03:46.09,0:03:48.09,Default,,0,0,0,,Хе-хе-хе-хе. Міне, 1-курстың үшеуіміз ақыры бірге жиналдық
Dialogue: 0,0:03:48.09,0:03:51.09,Default,,0,0,0,,Хахаха... Бұл тәтті.
Dialogue: 0,0:03:55.10,0:03:57.10,Default,,0,0,0,,Мм.
Dialogue: 0,0:03:57.10,0:03:59.10,Default,,0,0,0,,Иә
Dialogue: 0,0:04:07.09,0:04:09.09,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:11.10,0:04:13.10,Default,,0,0,0,,Дұрыс, дұрыс.
Dialogue: 0,0:04:13.10,0:04:16.10,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:04:16.10,0:04:18.09,Default,,0,0,0,,Бұл Джун Кагами.
Dialogue: 0,0:04:18.09,0:04:20.09,Default,,0,0,0,,Джун-кун әкесінің жағдайына байланысты бүгін басталады.
Dialogue: 0,0:04:20.09,0:04:24.09,Default,,0,0,0,,Мен біраз уақыт осы сыныптың мүшесі боламын.
Dialogue: 0,0:04:24.09,0:04:27.09,Default,,0,0,0,,Барлығыңыз жақсы араласыңыз.
Dialogue: 0,0:04:30.10,0:04:32.10,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:04:35.10,0:04:37.09,Default,,0,0,0,,Ей, эй, жүгірме!
Dialogue: 0,0:04:37.09,0:04:39.09,Default,,0,0,0,,Егер сіз атсаңыз
Dialogue: 0,0:04:39.09,0:04:41.09,Default,,0,0,0,,Ол қақпашының бетінен соқты.
Dialogue: 0,0:04:41.09,0:04:44.10,Default,,0,0,0,,Менің мұрыннан қан кетті. О, жоқ.
Dialogue: 0,0:04:44.10,0:04:46.10,Default,,0,0,0,,Сәлем, қалайсың?
Dialogue: 0,0:04:49.10,0:04:52.11,Default,,0,0,0,,Хехе, сен жақсы белгі тағып жүрсің, көрсетші.
Dialogue: 0,0:04:52.11,0:04:54.09,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:04:54.09,0:04:56.09,Default,,0,0,0,,Маған аздап көрсетсеңіз жақсы емес пе?
Dialogue: 0,0:04:56.09,0:04:59.10,Default,,0,0,0,,Жоқ, жоқ, бұл маңызды.
Dialogue: 0,0:04:59.10,0:05:02.10,Default,,0,0,0,,Не? Көрсетсем де азаймайды.
Dialogue: 0,0:05:02.10,0:05:05.10,Default,,0,0,0,,Осылай айтсаң, дос бола алмайсың.
Dialogue: 0,0:05:05.10,0:05:07.10,Default,,0,0,0,,Бұл аз ғана, ау
Dialogue: 0,0:05:09.11,0:05:11.09,Default,,0,0,0,,Хехе, бұл керемет.
Dialogue: 0,0:05:11.09,0:05:14.09,Default,,0,0,0,,Жеңіс! Уайымдама! Джун-кун, сен оны жек көресің, солай ма?
Dialogue: 0,0:05:14.09,0:05:17.10,Default,,0,0,0,,Біртүрлі сөздер айтуды доғар.
Dialogue: 0,0:05:17.10,0:05:21.10,Default,,0,0,0,,Мен бұл жігіттің досы болуға тырысамын.
Dialogue: 0,0:05:23.10,0:05:25.10,Default,,0,0,0,,Эй Джун, солай емес пе?
Dialogue: 0,0:05:25.10,0:05:27.10,Default,,0,0,0,,Біз доспыз, солай ма?
Dialogue: 0,0:05:29.09,0:05:32.09,Default,,0,0,0,,Ух... Иә, хехе, осыны біраз уақытқа қарызға алайыншы.
Dialogue: 0,0:05:37.10,0:05:39.10,Default,,0,0,0,,Олар сапқа тұрады.
Dialogue: 0,0:05:39.10,0:05:41.10,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:05:41.10,0:05:44.10,Default,,0,0,0,,Иә, онда мен оған көп сәбіз саламын...
Dialogue: 0,0:05:45.09,0:05:47.09,Default,,0,0,0,,Иә, мұғалім үшін.
Dialogue: 0,0:05:47.09,0:05:50.10,Default,,0,0,0,,Ой! Дәмді көрінеді Ах!
Dialogue: 0,0:05:50.10,0:05:53.10,Default,,0,0,0,,Мен мұғалімге арнайы үлкен үлес қостым.
Dialogue: 0,0:05:53.10,0:05:56.10,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:59.11,0:06:01.11,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:06:14.10,0:06:16.10,Default,,0,0,0,,Ах
Dialogue: 0,0:06:19.09,0:06:22.09,Default,,0,0,0,,Эй, сен қазір үйге барасың ба?
Dialogue: 0,0:06:22.09,0:06:25.10,Default,,0,0,0,,Катсу өзімен бірге алып кеткен белгі
Dialogue: 0,0:06:25.10,0:06:28.10,Default,,0,0,0,,Ертең қайтаратыныңызға сенімдімін.
Dialogue: 0,0:06:28.10,0:06:30.12,Default,,0,0,0,,Бұл оның қолынан келетін жалғыз әдіс.
Dialogue: 0,0:06:30.12,0:06:32.10,Default,,0,0,0,,Мені кешіріңіз...
Dialogue: 0,0:06:32.10,0:06:34.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:34.11,0:06:36.11,Default,,0,0,0,,Эй!
Dialogue: 0,0:06:50.11,0:06:52.11,Default,,0,0,0,,Ах ха ха...
Dialogue: 0,0:06:57.10,0:06:59.10,Default,,0,0,0,,Ықылық…
Dialogue: 0,0:06:59.10,0:07:03.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:05.10,0:07:08.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:08.11,0:07:10.11,Default,,0,0,0,,Не? Ха!
Dialogue: 0,0:07:14.10,0:07:16.10,Default,,0,0,0,,Не?
Dialogue: 0,0:07:22.10,0:07:25.10,Default,,0,0,0,,Не? Сізде осындай клоун маскасы болды ма?
Dialogue: 0,0:07:29.10,0:07:32.10,Default,,0,0,0,,Оны саған анаң сатып алды ма?
Dialogue: 0,0:07:32.10,0:07:34.10,Default,,0,0,0,,Ха! аа!
Dialogue: 0,0:07:34.10,0:07:36.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:36.10,0:07:38.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:38.10,0:07:41.10,Default,,0,0,0,,Уф... аа!
Dialogue: 0,0:07:44.11,0:07:46.10,Default,,0,0,0,,Аха!
Dialogue: 0,0:07:46.10,0:07:48.10,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:07:58.11,0:08:03.10,Default,,0,0,0,,Уау ха ха ха ха!
Dialogue: 0,0:08:03.10,0:08:08.10,Default,,0,0,0,,Сәлем, Ю, мен сенің айнадағы көлеңкеңмін.
Dialogue: 0,0:08:08.10,0:08:10.10,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:08:10.10,0:08:14.11,Default,,0,0,0,,Ол маска менің сыйлығым хахахаха...
Dialogue: 0,0:08:14.11,0:08:17.11,Default,,0,0,0,,Бұл сізге батылдық береді
Dialogue: 0,0:08:17.11,0:08:19.11,Default,,0,0,0,,Сіз өзіңіз қалаған нәрсені жасай аласыз.
Dialogue: 0,0:08:19.11,0:08:22.10,Default,,0,0,0,,Сенім артады
Dialogue: 0,0:08:22.10,0:08:24.10,Default,,0,0,0,,Сіз өз сыныбыңызда танымалсыз
Dialogue: 0,0:08:24.10,0:08:27.10,Default,,0,0,0,,Мен сыныптағы ең танымал адаммын ба?
Dialogue: 0,0:08:27.10,0:08:29.10,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:08:40.10,0:08:42.10,Default,,0,0,0,,Хэхехе
Dialogue: 0,0:08:42.10,0:08:44.10,Default,,0,0,0,,Йо июн
Dialogue: 0,0:08:44.10,0:08:46.11,Default,,0,0,0,,Сіз кешігіп қалдыңыз.
Dialogue: 0,0:08:46.11,0:08:48.11,Default,,0,0,0,,О? ау
Dialogue: 0,0:08:48.11,0:08:50.11,Default,,0,0,0,,Бүгін клоун маскасын әкелдің бе?
Dialogue: 0,0:08:50.11,0:08:53.11,Default,,0,0,0,,Сізде көп жақсылықтар бар, хехе.
Dialogue: 0,0:08:53.11,0:08:56.10,Default,,0,0,0,,Сізге көрсетейін... Уф!
Dialogue: 0,0:08:56.10,0:08:59.10,Default,,0,0,0,,Жоқ, не?
Dialogue: 0,0:09:01.10,0:09:04.11,Default,,0,0,0,,Бұл Ах!
Dialogue: 0,0:09:04.11,0:09:06.11,Default,,0,0,0,,Бұл не, Джун?
Dialogue: 0,0:09:06.11,0:09:09.11,Default,,0,0,0,,Біз доспыз, солай ма? Эй
Dialogue: 0,0:09:11.11,0:09:13.11,Default,,0,0,0,,Хехе, мен сонда баруым керек.
Dialogue: 0,0:09:16.10,0:09:18.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:20.11,0:09:22.11,Default,,0,0,0,,Эй... аа
Dialogue: 0,0:09:22.11,0:09:24.11,Default,,0,0,0,,Катсу-кун? Катсу-кун?
Dialogue: 0,0:09:24.11,0:09:26.11,Default,,0,0,0,,Не болды? Катсу-кун
Dialogue: 0,0:09:26.11,0:09:28.11,Default,,0,0,0,,Таңқаларлық
Dialogue: 0,0:09:28.11,0:09:30.10,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:09:30.10,0:09:32.10,Default,,0,0,0,,Мен мұны қайтарамын.
Dialogue: 0,0:09:41.11,0:09:43.11,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:09:43.11,0:09:45.11,Default,,0,0,0,,О, хмф
Dialogue: 0,0:09:49.10,0:09:51.10,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:09:51.10,0:09:55.11,Default,,0,0,0,,Қараңдаршы, аспан бұлтты, күн күркіреді.
Dialogue: 0,0:09:55.11,0:09:57.11,Default,,0,0,0,,Жақында судың балалары түседі
Dialogue: 0,0:09:57.11,0:09:59.11,Default,,0,0,0,,Судың баласы?
Dialogue: 0,0:09:59.11,0:10:01.11,Default,,0,0,0,,Бұл жаңбыр жауады дегенді білдіре ме? Амал жоқ
Dialogue: 0,0:10:01.11,0:10:04.11,Default,,0,0,0,,Олар бүгін жаңбырдың нөл пайыздық ықтималдығы бар екенін айтты.
Dialogue: 0,0:10:09.11,0:10:11.11,Default,,0,0,0,,Эй, жоқ, кешігіп қалдың.
Dialogue: 0,0:10:11.11,0:10:13.11,Default,,0,0,0,,Маған не енгізгендерін ешкім білмейді.
Dialogue: 0,0:10:17.11,0:10:19.11,Default,,0,0,0,,Не?
Dialogue: 0,0:10:25.10,0:10:28.11,Default,,0,0,0,,Хе хе хе...
Dialogue: 0,0:10:28.11,0:10:30.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:34.11,0:10:37.11,Default,,0,0,0,,Мен оның шынымен ол екеніне сене алар емеспін...
Dialogue: 0,0:10:41.10,0:10:45.10,Default,,0,0,0,,Жоқ, кешіріңіз. Кенет құйып жатыр.
Dialogue: 0,0:10:47.11,0:10:50.11,Default,,0,0,0,,О? Нуу
Dialogue: 0,0:10:50.11,0:10:52.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:52.11,0:10:55.10,Default,,0,0,0,,Әй, ұстаз, қайырлы таң!
Dialogue: 0,0:10:55.10,0:10:57.10,Default,,0,0,0,,Ах
Dialogue: 0,0:10:57.10,0:10:59.10,Default,,0,0,0,,Қайырлы таң...
Dialogue: 0,0:11:09.11,0:11:11.12,Default,,0,0,0,,Жалпы солай
Dialogue: 0,0:11:11.12,0:11:13.10,Default,,0,0,0,,Оны болжау қабілеті деп те атайды.
Dialogue: 0,0:11:13.10,0:11:15.10,Default,,0,0,0,,Алдын ала білу?
Dialogue: 0,0:11:15.10,0:11:19.11,Default,,0,0,0,,Басқаша айтқанда, бұл болашақты білу қабілеті.
Dialogue: 0,0:11:19.11,0:11:22.11,Default,,0,0,0,,Мики
Dialogue: 0,0:11:22.11,0:11:25.11,Default,,0,0,0,,Бұл Мистер Тозақтың артықшылықты теріс пайдалануы.
Dialogue: 0,0:11:25.11,0:11:28.12,Default,,0,0,0,,Бұл... «В»
Dialogue: 0,0:11:28.12,0:11:31.10,Default,,0,0,0,,Эй, бірақ мен ауа-райын ертерек болжадым.
Dialogue: 0,0:11:31.10,0:11:33.11,Default,,0,0,0,,Бұл шынымен де кездейсоқтық па?
Dialogue: 0,0:11:33.11,0:11:35.11,Default,,0,0,0,,Жоқ, бұл кездейсоқтық емес.
Dialogue: 0,0:11:35.11,0:11:37.11,Default,,0,0,0,,Амансың ба? Бұл клоун маскасы
Dialogue: 0,0:11:37.11,0:11:42.11,Default,,0,0,0,,Осыны кигенде ойыма неше түрлі нәрсе келеді.
Dialogue: 0,0:11:42.11,0:11:44.11,Default,,0,0,0,,Осылайша...
Dialogue: 0,0:11:50.11,0:11:52.11,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:11:55.11,0:11:57.11,Default,,0,0,0,,Хиро
Dialogue: 0,0:11:57.11,0:11:59.11,Default,,0,0,0,,О, не? Нубе~
Dialogue: 0,0:11:59.11,0:12:01.12,Default,,0,0,0,,Мен бүгін жұмыста бос емеспін.
Dialogue: 0,0:12:01.12,0:12:04.12,Default,,0,0,0,,Мектеп түскі асын қызметкерлер бөлмесіне әкеле аласыз ба?
Dialogue: 0,0:12:04.12,0:12:07.11,Default,,0,0,0,,Иә, жақсы, бірақ гарнирлер өте үлкен және...
Dialogue: 0,0:12:07.11,0:12:10.11,Default,,0,0,0,,Жарайды, барлық қалдықтар әдеттегідей, солай ма?
Dialogue: 0,0:12:10.11,0:12:12.11,Default,,0,0,0,,Эй, мен оны сұрадым.
Dialogue: 0,0:12:13.11,0:12:15.11,Default,,0,0,0,,Эй, эй, біреуді болжап көріңіз.
Dialogue: 0,0:12:15.11,0:12:17.12,Default,,0,0,0,,А, жарайды.
Dialogue: 0,0:12:17.12,0:12:19.12,Default,,0,0,0,,Алдымен маған қарағаныңды қалаймын... Тоқта, жүр.
Dialogue: 0,0:12:19.12,0:12:21.10,Default,,0,0,0,,1-сыныптың сұлу қыз
Dialogue: 0,0:12:21.10,0:12:24.11,Default,,0,0,0,,Мики-чан бірінші нөмір, мен түсінемін.
Dialogue: 0,0:12:24.11,0:12:26.11,Default,,0,0,0,,Тәртіп бойынша бір-бірден.
Dialogue: 0,0:12:35.12,0:12:37.12,Default,,0,0,0,,Кең?
Dialogue: 0,0:12:37.12,0:12:39.10,Default,,0,0,0,,О, маусым
Dialogue: 0,0:12:39.10,0:12:41.11,Default,,0,0,0,,Дәретхана болса, қазір су болмас еді.
Dialogue: 0,0:12:41.11,0:12:43.11,Default,,0,0,0,,Сіз түбіне дейін барғаныңыз жөн.
Dialogue: 0,0:12:43.11,0:12:45.11,Default,,0,0,0,,Рахмет, мм...
Dialogue: 0,0:12:45.11,0:12:49.13,Default,,0,0,0,,Хиро-кун туралы мені қызықтыратын бір нәрсе бар.
Dialogue: 0,0:12:49.13,0:12:51.12,Default,,0,0,0,,Не?
Dialogue: 0,0:12:51.12,0:12:54.12,Default,,0,0,0,,Мен сені ертерек маска кигенде көрмедім бе?
Dialogue: 0,0:12:54.12,0:12:57.11,Default,,0,0,0,,Сол сәтте мен кең болашақты көрдім.
Dialogue: 0,0:12:57.11,0:12:59.11,Default,,0,0,0,,Менің болашағым?
Dialogue: 0,0:12:59.11,0:13:01.11,Default,,0,0,0,,Иә, мен шынымен түсінбеймін.
Dialogue: 0,0:13:01.11,0:13:04.11,Default,,0,0,0,,Бірдеңе болады, ол сізді құмарлықпен сезінеді.
Dialogue: 0,0:13:04.11,0:13:07.12,Default,,0,0,0,,Құмарлық сезімдер?
Dialogue: 0,0:13:07.12,0:13:09.12,Default,,0,0,0,,Пайғамбарлық? Иә.
Dialogue: 0,0:13:09.12,0:13:11.12,Default,,0,0,0,,Рахмет, мен абай боламын.
Dialogue: 0,0:13:11.12,0:13:14.11,Default,,0,0,0,,Ах, сабақтан кейін жаңбыр тоқтаса.
Dialogue: 0,0:13:14.11,0:13:16.11,Default,,0,0,0,,Бәріміз бірге футбол ойнайық, рахмет
Dialogue: 0,0:13:16.11,0:13:18.11,Default,,0,0,0,,Мен... Мен ондай жігіттерді шын жек көремін!
Dialogue: 0,0:13:24.12,0:13:27.12,Default,,0,0,0,,Хехе, енді қорқатын ештеңе жоқ.
Dialogue: 0,0:13:27.12,0:13:30.12,Default,,0,0,0,,Солай емес пе? Клоун-кун
Dialogue: 0,0:13:30.12,0:13:32.11,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:13:32.11,0:13:35.11,Default,,0,0,0,,Иә, дұрыс!
Dialogue: 0,0:13:35.11,0:13:37.11,Default,,0,0,0,,Барлығы сіздің күшіңіз
Dialogue: 0,0:13:37.11,0:13:39.11,Default,,0,0,0,,Сіз өз сыныбыңызда танымалсыз
Dialogue: 0,0:13:39.11,0:13:42.12,Default,,0,0,0,,Бәрі сенің қолыңда, бәрі өзің қалағандай.
Dialogue: 0,0:13:42.12,0:13:45.12,Default,,0,0,0,,Қалауымша...
Dialogue: 0,0:13:45.12,0:13:47.12,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:13:47.12,0:13:50.11,Default,,0,0,0,,Сіз ойлағандай.
Dialogue: 0,0:13:50.11,0:13:52.11,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:56.12,0:13:59.12,Default,,0,0,0,,Сенің күшің менің күшім
Dialogue: 0,0:13:59.12,0:14:01.12,Default,,0,0,0,,Менің қабілетім
Dialogue: 0,0:14:06.11,0:14:08.11,Default,,0,0,0,,Кола-кола! Ой...
Dialogue: 0,0:14:08.11,0:14:11.11,Default,,0,0,0,,Бұл не? Менің аяғыма қауіп төніп тұр. Мен қауіп төніп тұрмын.
Dialogue: 0,0:14:13.12,0:14:15.12,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:15.12,0:14:17.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:17.12,0:14:20.12,Default,,0,0,0,,Ei
Dialogue: 0,0:14:20.12,0:14:22.11,Default,,0,0,0,,Сіз кешігіп қалдыңыз, Хиро!
Dialogue: 0,0:14:22.11,0:14:24.11,Default,,0,0,0,,Өйткені ол өте үлкен.
Dialogue: 0,0:14:24.11,0:14:27.11,Default,,0,0,0,,Ауыр, ыстық, сәл кеш.
Dialogue: 0,0:14:27.11,0:14:30.12,Default,,0,0,0,,Не? Бұл әдеттегіден жылдамырақ.
Dialogue: 0,0:14:30.12,0:14:32.12,Default,,0,0,0,,Таку қазірдің өзінде...
Dialogue: 0,0:14:32.12,0:14:34.12,Default,,0,0,0,,Сіз өте әдемісіз. Хмм…
Dialogue: 0,0:14:38.12,0:14:40.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:42.11,0:14:44.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:44.11,0:14:48.12,Default,,0,0,0,,Ах! Қандай ысырап! Ах!
Dialogue: 0,0:14:48.12,0:14:51.12,Default,,0,0,0,,Уау! Мұнда...
Dialogue: 0,0:14:51.12,0:14:53.12,Default,,0,0,0,,Кең!
Dialogue: 0,0:14:53.12,0:14:56.13,Default,,0,0,0,,Сөз жоқ, Нуэно мырза... кетіңізші!
Dialogue: 0,0:14:56.13,0:14:58.13,Default,,0,0,0,,Кола! Нуэно мырза!
Dialogue: 0,0:15:00.11,0:15:02.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:02.11,0:15:04.12,Default,,0,0,0,,Неге сонша абдырап қалдың?
Dialogue: 0,0:15:04.12,0:15:08.12,Default,,0,0,0,,Кешіріңіз... Мен айнадан сайқымазаққа ұқсайтын нәрсені көріп тұрмын.
Dialogue: 0,0:15:08.12,0:15:10.12,Default,,0,0,0,,Айнада сайқымазақ бар ма?
Dialogue: 0,0:15:10.12,0:15:12.12,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:15:12.12,0:15:14.13,Default,,0,0,0,,Ол мектептегі түскі асқа біртүрлі нәрсе қойды.
Dialogue: 0,0:15:14.13,0:15:17.13,Default,,0,0,0,,Мен қарасам, онда көптеген ақылсыз заттар бар екен.
Dialogue: 0,0:15:23.12,0:15:27.12,Default,,0,0,0,,Күрсін... Джун-кун маған біртүрлі болжам айтты.
Dialogue: 0,0:15:27.12,0:15:30.13,Default,,0,0,0,,Менің мақтанған ұзын шашым қысқарып қалды.
Dialogue: 0,0:15:30.13,0:15:32.13,Default,,0,0,0,,Иә, хехе
Dialogue: 0,0:15:32.13,0:15:35.11,Default,,0,0,0,,Не, Гоконың беті сиядан әбден қара?
Dialogue: 0,0:15:35.11,0:15:38.12,Default,,0,0,0,,Не? шын? Эххе
Dialogue: 0,0:15:38.12,0:15:42.12,Default,,0,0,0,,Иә? не? сайқымазақ?
Dialogue: 0,0:15:42.12,0:15:44.12,Default,,0,0,0,,А, а... а!
Dialogue: 0,0:15:44.12,0:15:46.13,Default,,0,0,0,,Мен... Маған ұнамайды! Бұл не?
Dialogue: 0,0:15:46.13,0:15:48.13,Default,,0,0,0,,Ки... Гоко-чан?
Dialogue: 0,0:15:48.13,0:15:50.11,Default,,0,0,0,,Сонымен... қуатты қосыңыз! Баспа машинасын өшіріңіз!
Dialogue: 0,0:15:50.11,0:15:52.11,Default,,0,0,0,,Асығыңыз! аа! Қайда... қайда?
Dialogue: 0,0:15:52.11,0:15:54.12,Default,,0,0,0,,Мен розеткадан ажыратамын, күте тұрыңыз, Гоко-чан!
Dialogue: 0,0:15:54.12,0:15:56.12,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:16:02.12,0:16:06.13,Default,,0,0,0,,Сондықтан мен құс үйін тазалауды ұнатпаймын.
Dialogue: 0,0:16:06.13,0:16:09.13,Default,,0,0,0,,Алдын ала айтылғандай, құстың сізді шағуына жол бермеңіз.
Dialogue: 0,0:16:15.12,0:16:18.12,Default,,0,0,0,,Бұл кім? Сіз оны қазір аша алмайсыз.
Dialogue: 0,0:16:20.13,0:16:23.13,Default,,0,0,0,,О... сен сонда емессің бе?
Dialogue: 0,0:16:23.13,0:16:25.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:25.11,0:16:28.12,Default,,0,0,0,,Бұл кім? Онда біреу бар ма?
Dialogue: 0,0:16:28.12,0:16:30.12,Default,,0,0,0,,Тоқта! Апыр-ай!
Dialogue: 0,0:16:30.12,0:16:33.12,Default,,0,0,0,,Маған көмектесіңізші!
Dialogue: 0,0:16:38.13,0:16:41.13,Default,,0,0,0,,Джун-кун саған бірдеңе болжады ма?
Dialogue: 0,0:16:41.13,0:16:43.12,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:16:43.12,0:16:45.12,Default,,0,0,0,,Мен сенің сүйіктіңмін
Dialogue: 0,0:16:45.12,0:16:47.12,Default,,0,0,0,,Мына киімдер бұзылады.
Dialogue: 0,0:16:47.12,0:16:50.12,Default,,0,0,0,,Бұл әкеңнің туған күніңе сыйлығы емес пе?
Dialogue: 0,0:16:50.12,0:16:52.12,Default,,0,0,0,,Маңызды болса да
Dialogue: 0,0:16:52.12,0:16:54.13,Default,,0,0,0,,Олай болса, Мики, бірінші бар.
Dialogue: 0,0:16:54.13,0:16:57.13,Default,,0,0,0,,Иә, бұл бала!
Dialogue: 0,0:16:57.13,0:17:00.12,Default,,0,0,0,,Сіз тағы да қарап тұрдыңыз ғой, солай ма? Мүлдем емес...
Dialogue: 0,0:17:00.12,0:17:04.12,Default,,0,0,0,,Хехе, мен сенің не көргің келетінін түсіндім.
Dialogue: 0,0:17:04.12,0:17:07.12,Default,,0,0,0,,Ха! ДДСҰ?
Dialogue: 0,0:17:07.12,0:17:09.12,Default,,0,0,0,,Ах! иә?
Dialogue: 0,0:17:09.12,0:17:12.13,Default,,0,0,0,,Сайқымазақ?
Dialogue: 0,0:17:12.13,0:17:14.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:14.13,0:17:16.11,Default,,0,0,0,,Ааа!
Dialogue: 0,0:17:16.11,0:17:18.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:18.12,0:17:21.12,Default,,0,0,0,,Кешіріңіз... Кешіріңіз, бұл жай ғана кездейсоқтық болды...
Dialogue: 0,0:17:21.12,0:17:23.12,Default,,0,0,0,,​​О?
Dialogue: 0,0:17:23.12,0:17:25.12,Default,,0,0,0,,Не... не болды?
Dialogue: 0,0:17:25.12,0:17:27.12,Default,,0,0,0,,Сайқымазақ айнада...
Dialogue: 0,0:17:36.12,0:17:38.12,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:17:38.12,0:17:40.12,Default,,0,0,0,,Сіз мұны қалай жасайсыз?
Dialogue: 0,0:17:40.12,0:17:44.13,Default,,0,0,0,,Қасықты бүгіп сындыруға болмайды ма?
Dialogue: 0,0:17:44.13,0:17:47.13,Default,,0,0,0,,О, бәрі мүмкін.
Dialogue: 0,0:17:47.13,0:17:49.13,Default,,0,0,0,,Қажет болса
Dialogue: 0,0:17:49.13,0:17:52.12,Default,,0,0,0,,Осы құдіретпен мен кез келген залымды басамын.
Dialogue: 0,0:17:52.12,0:17:55.12,Default,,0,0,0,,Уау, Джун-кун сондай сенімді.
Dialogue: 0,0:17:55.12,0:17:57.12,Default,,0,0,0,,Мен саған бәрін істей аламын дедім ғой, солай ма?
Dialogue: 0,0:17:57.12,0:17:59.12,Default,,0,0,0,,Иә?О
Dialogue: 0,0:17:59.12,0:18:02.13,Default,,0,0,0,,Сіз тіпті айнаға кіресіз бе?
Dialogue: 0,0:18:02.13,0:18:04.13,Default,,0,0,0,,Не? Не... не дейсіз?
Dialogue: 0,0:18:04.13,0:18:06.13,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:18:06.13,0:18:09.12,Default,,0,0,0,,Болжағандай қымбат киімім бұзылды.
Dialogue: 0,0:18:09.12,0:18:12.12,Default,,0,0,0,,Менің сүйікті құсым менің де бетімді шұқыды!
Dialogue: 0,0:18:12.12,0:18:16.12,Default,,0,0,0,,Менің шашым түсіп қала жаздады!
Dialogue: 0,0:18:16.12,0:18:18.13,Default,,0,0,0,,Тек болжау, солай емес пе?
Dialogue: 0,0:18:18.13,0:18:20.13,Default,,0,0,0,,Өз баламды ешқашан қателеспес едім.
Dialogue: 0,0:18:20.13,0:18:22.13,Default,,0,0,0,,Менің алтын оң аяғым
Dialogue: 0,0:18:22.13,0:18:26.12,Default,,0,0,0,,Сіз болжағандай, күйіп кете жаздадым.
Dialogue: 0,0:18:26.12,0:18:29.12,Default,,0,0,0,,Менің ойымша, бұл оңай болды, өйткені пайғамбарлық болды.
Dialogue: 0,0:18:29.12,0:18:31.12,Default,,0,0,0,,(Рюи) Неге сен өртеніп жатқан жоқсың?
Dialogue: 0,0:18:31.12,0:18:35.13,Default,,0,0,0,,Жарайсың ба? Барлығы апатқа ұшыраса, айнадан сайқымазақ көреді.
Dialogue: 0,0:18:35.13,0:18:37.13,Default,,0,0,0,,Саған мектепте сайқымазақтар ұнайды ма?
Dialogue: 0,0:18:37.13,0:18:39.13,Default,,0,0,0,,Сен жалғызсың!
Dialogue: 0,0:18:39.13,0:18:42.13,Default,,0,0,0,,Мен оның сол оғаш күшін еркелік ойнау үшін пайдаланғанына сенімдімін.
Dialogue: 0,0:18:42.13,0:18:44.12,Default,,0,0,0,,Кола! Не үшін ұрысып жатырсың?
Dialogue: 0,0:18:44.12,0:18:46.12,Default,,0,0,0,,Нубе
Dialogue: 0,0:18:46.12,0:18:49.12,Default,,0,0,0,,Не болды? Бүгінде барлығында жарақат көп сияқты.
Dialogue: 0,0:18:49.12,0:18:51.13,Default,,0,0,0,,Мұның бұған қатысы бар ма?
Dialogue: 0,0:18:51.13,0:18:53.13,Default,,0,0,0,,А... Білмеймін.
Dialogue: 0,0:18:53.13,0:18:55.13,Default,,0,0,0,,Төзімді бол, көмекші!
Dialogue: 0,0:18:55.13,0:18:57.13,Default,,0,0,0,,Бұл... бұл менің кінәм...
Dialogue: 0,0:18:57.13,0:18:59.12,Default,,0,0,0,,Сәлем
Dialogue: 0,0:18:59.12,0:19:01.12,Default,,0,0,0,,Бұл менің кінәм емес!
Dialogue: 0,0:19:03.12,0:19:05.12,Default,,0,0,0,,Ха! Бұл...
Dialogue: 0,0:19:05.12,0:19:09.13,Default,,0,0,0,,Күйіп қалғанда айнадан сайқымазақ костюмін көрдім
Dialogue: 0,0:19:09.13,0:19:13.13,Default,,0,0,0,,Мен де дәл осындай киім киген сайқымазақты көрдім.
Dialogue: 0,0:19:13.13,0:19:15.13,Default,,0,0,0,,Бұл, әрине!
Dialogue: 0,0:19:15.13,0:19:17.12,Default,,0,0,0,,Менің көргенім мына сайқымазақтың киімі болды.
Dialogue: 0,0:19:17.12,0:19:21.12,Default,,0,0,0,,маусым Нені меңзеп тұрғаныңызды түсіндіріңіз. Эй!
Dialogue: 0,0:19:21.12,0:19:25.13,Default,,0,0,0,,Бас тарту туралы уайымдамаңыз.
Dialogue: 0,0:19:25.13,0:19:29.13,Default,,0,0,0,,Мен білмеймін... Мен ештеңе білмеймін
Dialogue: 0,0:19:32.13,0:19:34.13,Default,,0,0,0,,Мен… Мен
Dialogue: 0,0:19:36.12,0:19:38.12,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:19:38.12,0:19:40.13,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:40.13,0:19:42.13,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:19:42.13,0:19:44.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:49.13,0:19:51.12,Default,,0,0,0,,Ах
Dialogue: 0,0:19:51.12,0:19:53.12,Default,,0,0,0,,маусым!
Dialogue: 0,0:19:53.12,0:19:55.12,Default,,0,0,0,,Га
Dialogue: 0,0:20:01.13,0:20:03.13,Default,,0,0,0,,Ах! жібер
Dialogue: 0,0:20:03.13,0:20:06.13,Default,,0,0,0,,Мені жібер! мен ештеңе білмеймін
Dialogue: 0,0:20:06.13,0:20:08.12,Default,,0,0,0,,Мен ештеңе істеген жоқпын.
Dialogue: 0,0:20:08.12,0:20:10.12,Default,,0,0,0,,Сенесің бе?
Dialogue: 0,0:20:10.12,0:20:13.13,Default,,0,0,0,,Білмеймін десең
Dialogue: 0,0:20:13.13,0:20:16.13,Default,,0,0,0,,Бірақ... мені қызықтыратын бір нәрсе бар.
Dialogue: 0,0:20:16.13,0:20:19.13,Default,,0,0,0,,Бұл сіздің тылсым күшіңіз бен сол маскаңыз туралы.
Dialogue: 0,0:20:19.13,0:20:21.13,Default,,0,0,0,,Маска?
Dialogue: 0,0:20:21.13,0:20:23.13,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:26.12,0:20:28.12,Default,,0,0,0,,Жын... Жын!
Dialogue: 0,0:20:28.12,0:20:30.13,Default,,0,0,0,,Не?
Dialogue: 0,0:20:30.13,0:20:32.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:34.13,0:20:36.13,Default,,0,0,0,,Уф Джун!
Dialogue: 0,0:20:43.12,0:20:46.12,Default,,0,0,0,,А, мен сусабынмен жусам, бұл өшеді ме?
Dialogue: 0,0:20:46.12,0:20:48.13,Default,,0,0,0,,Сіздікі әлі де жақсы.
Dialogue: 0,0:20:48.13,0:20:50.13,Default,,0,0,0,,Мен бас тарттым.
Dialogue: 0,0:20:50.13,0:20:54.13,Default,,0,0,0,,Ол сабақтан кейін футбол ойнауды асыға күткен сияқты.
Dialogue: 0,0:20:54.13,0:20:57.14,Default,,0,0,0,,Хехе, бұл аянышты.
Dialogue: 0,0:20:57.14,0:21:00.12,Default,,0,0,0,,Катсу... Мектепке ауысқаннан кейін бірден
Dialogue: 0,0:21:00.12,0:21:03.13,Default,,0,0,0,,Барлығы маған қарап тұр.
Dialogue: 0,0:21:03.13,0:21:06.13,Default,,0,0,0,,Не? Мен не айта аламын?
Dialogue: 0,0:21:06.13,0:21:08.13,Default,,0,0,0,,Кеше мен Джунның белгісін алдым.
Dialogue: 0,0:21:08.13,0:21:11.13,Default,,0,0,0,,Аяқ киіміме құм салып, мені қорлағаныңмен.
Dialogue: 0,0:21:11.13,0:21:14.14,Default,,0,0,0,,Құм? Әй, құм.
Dialogue: 0,0:21:14.14,0:21:16.14,Default,,0,0,0,,Джун үйіне барғанда аяқ киім
Dialogue: 0,0:21:16.14,0:21:18.14,Default,,0,0,0,,Мен оның құмға толы екенін көрдім.
Dialogue: 0,0:21:20.13,0:21:22.13,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:21:22.13,0:21:24.13,Default,,0,0,0,,Мен оның аяқ киіміне құм құймаймын.
Dialogue: 0,0:21:24.13,0:21:27.13,Default,,0,0,0,,Не? Сіз тіпті өтірікшісіз бе?
Dialogue: 0,0:21:27.13,0:21:29.13,Default,,0,0,0,,Бұл өтірік емес.
Dialogue: 0,0:21:29.13,0:21:31.14,Default,,0,0,0,,Жарайсың ба? мен жай
Dialogue: 0,0:21:31.14,0:21:34.12,Default,,0,0,0,,Ешкіммен сөйлеспе Ешкіммен сөйлеспе
Dialogue: 0,0:21:34.12,0:21:37.13,Default,,0,0,0,,Маған оның көзқарасы ұнамады.
Dialogue: 0,0:21:37.13,0:21:40.13,Default,,0,0,0,,Сондықтан мен онымен бірінші айналыстым.
Dialogue: 0,0:21:40.13,0:21:42.13,Default,,0,0,0,,Сәлем? Кең
Dialogue: 0,0:21:42.13,0:21:45.13,Default,,0,0,0,,Біз көрген сайқымазақ
Dialogue: 0,0:21:45.13,0:21:48.14,Default,,0,0,0,,Бұл шынымен де ылғалдандырды ма?
Dialogue: 0,0:21:48.14,0:21:51.14,Default,,0,0,0,,Егер олай болмаса ше?
Dialogue: 0,0:21:51.14,0:21:53.14,Default,,0,0,0,,Егер бұл біреудің жұмысы болса...
Dialogue: 0,0:22:00.13,0:22:02.13,Default,,0,0,0,,Джун бар ма?
Dialogue: 0,0:22:02.13,0:22:04.14,Default,,0,0,0,,Уф
Dialogue: 0,0:22:04.14,0:22:07.14,Default,,0,0,0,,Себебі мен мектептегі түскі асымды сағындым.
Dialogue: 0,0:22:07.14,0:22:11.13,Default,,0,0,0,,Бірақ Джунның жігіті де үйге келмеді.
Dialogue: 0,0:22:11.13,0:22:14.13,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,0:22:14.13,0:22:16.13,Default,,0,0,0,,маусым?
Dialogue: 0,0:22:16.13,0:22:21.14,Default,,0,0,0,,Сәлем, балалар, егер Джунды көрсеңіздер, маған хабарлаңыздар.
Dialogue: 0,0:22:21.14,0:22:23.14,Default,,0,0,0,,Қасиетті көрініс, мақтанышпен тұр
Dialogue: 0,0:22:23.14,0:22:26.12,Default,,0,0,0,,маусым?
Dialogue: 0,0:22:26.12,0:22:28.13,Default,,0,0,0,,Га
Dialogue: 0,0:22:28.13,0:22:30.13,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:22:30.13,0:22:32.13,Default,,0,0,0,,Уф
Dialogue: 0,0:22:32.13,0:22:34.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:38.14,0:22:41.14,Default,,0,0,0,,Хехехе... Сен риясыз адамсың.
Dialogue: 0,0:22:41.14,0:22:43.12,Default,,0,0,0,,Сол жерде ұйықтаңыз.
Dialogue: 0,0:22:43.12,0:22:46.13,Default,,0,0,0,,Хехе, менің юкиім максималды деңгейге жетті
Dialogue: 0,0:22:46.13,0:22:48.13,Default,,0,0,0,,Бала уақыты 00:00
Dialogue: 0,0:22:48.13,0:22:51.13,Default,,0,0,0,,Сіздің орындауыңыздың уақыты келді.
Dialogue: 0,0:22:53.13,0:22:56.13,Default,,0,0,0,,Мен бұл жараның кекін толығымен тазартамын.
Dialogue: 0,0:23:03.13,0:23:06.13,Default,,0,0,0,,Не болды? Джун, өзіңді жақсы сезінбейсің бе?
Dialogue: 0,0:23:06.13,0:23:08.13,Default,,0,0,0,,Га
Dialogue: 0,0:23:08.13,0:23:12.14,Default,,0,0,0,,Барлығы сізді дұрыс түсінбейді.
Dialogue: 0,0:23:12.14,0:23:14.14,Default,,0,0,0,,Шынымен бе? О
Dialogue: 0,0:23:14.14,0:23:16.14,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:23:16.14,0:23:18.13,Default,,0,0,0,,Бірақ бір ғана адам
Dialogue: 0,0:23:18.13,0:23:22.13,Default,,0,0,0,,Сіздің танымал болғаныңызды қызық көрмейтіндер бар сияқты.
Dialogue: 0,0:23:22.13,0:23:24.13,Default,,0,0,0,,Да... кім?
Dialogue: 0,0:23:24.13,0:23:26.13,Default,,0,0,0,,Мұны кім жасайды?
Dialogue: 0,0:23:26.13,0:23:28.14,Default,,0,0,0,,Бұл мұғалім.
Dialogue: 0,0:23:28.14,0:23:31.14,Default,,0,0,0,,Сіз оны көрдіңіз бе? Жын-шайтанға ұқсайтын адамның шынайы табиғаты
Dialogue: 0,0:23:31.14,0:23:33.14,Default,,0,0,0,,Ол бәрін алдап, сені бұл мектептен шығарып алды.
Dialogue: 0,0:23:33.14,0:23:35.14,Default,,0,0,0,,Мен сені қуып жіберейін деп жатырмын.
Dialogue: 0,0:23:37.13,0:23:39.13,Default,,0,0,0,,Сіз мені қуып жібергіңіз келе ме?
Dialogue: 0,0:23:39.13,0:23:42.13,Default,,0,0,0,,Эй Джун, менде бір идея бар.
Dialogue: 0,0:23:44.14,0:23:47.14,Default,,0,0,0,,Қарсы болмасаңыз...
Dialogue: 0,0:23:47.14,0:23:49.14,Default,,0,0,0,,Не... қандай зат?
Dialogue: 0,0:23:49.14,0:23:53.13,Default,,0,0,0,,Көріп тұрғандай мен айнадан шыға алмаймын.
Dialogue: 0,0:23:53.13,0:23:55.13,Default,,0,0,0,,Егер сіз онымен жақсы болсаңыз, аз уақытқа ғана.
Dialogue: 0,0:23:55.13,0:23:57.13,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,0:23:57.13,0:24:00.14,Default,,0,0,0,,Егер сіз айнаға кірсеңіз
Dialogue: 0,0:24:00.14,0:24:03.14,Default,,0,0,0,,Онда мен далаға шыға аламын.
Dialogue: 0,0:24:03.14,0:24:06.14,Default,,0,0,0,,Олай болса мен сені қайтадан алып кетемін
Dialogue: 0,0:24:06.14,0:24:09.13,Default,,0,0,0,,Мен сені сыныпта танымал ете алсам ғой.
Dialogue: 0,0:24:09.13,0:24:12.13,Default,,0,0,0,,Мен қайтадан сыныпта танымал боламын ба?
Dialogue: 0,0:24:12.13,0:24:14.13,Default,,0,0,0,,Иә
Dialogue: 0,0:24:14.13,0:24:17.14,Default,,0,0,0,,Менің орнымды біраз уақытқа бассаңыз...
Dialogue: 0,0:24:17.14,0:24:19.14,Default,,0,0,0,,Жүр, қолыңды берші.
Dialogue: 0,0:24:19.14,0:24:23.14,Default,,0,0,0,,Маған сен, күшіме сен
Dialogue: 0,0:24:23.14,0:24:26.14,Default,,0,0,0,,Өзіңіз үшін
Dialogue: 0,0:24:47.13,0:24:49.13,Default,,0,0,0,,Джунның жігіті еш жерде жоқ.
Dialogue: 0,0:24:49.13,0:24:52.14,Default,,0,0,0,,Сіз үйде емессіз бе?
Dialogue: 0,0:24:52.14,0:24:55.14,Default,,0,0,0,,Есік жақын арада құлыпталады.
Dialogue: 0,0:24:55.14,0:24:58.14,Default,,0,0,0,,Жарайды. Бүгінгі түнгі ауысым - Нубедамон.
Dialogue: 0,0:24:58.14,0:25:00.15,Default,,0,0,0,,Уау! Не?
Dialogue: 0,0:25:00.15,0:25:02.15,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:25:08.14,0:25:11.14,Default,,0,0,0,,маусым? Біреу бар ма?
Dialogue: 0,0:25:11.14,0:25:13.14,Default,,0,0,0,,Джун-кун!
Dialogue: 0,0:25:25.14,0:25:27.14,Default,,0,0,0,,Әй?
Dialogue: 0,0:25:27.14,0:25:29.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:25:29.14,0:25:33.14,Default,,0,0,0,,Айнадағы жарты аяқ киім...
Dialogue: 0,0:25:33.14,0:25:35.14,Default,,0,0,0,,Әй?
Dialogue: 0,0:25:37.13,0:25:39.13,Default,,0,0,0,,Ха!
Dialogue: 0,0:25:39.13,0:25:43.14,Default,,0,0,0,,А? ше? Бірдеңе болды ма?
Dialogue: 0,0:25:43.14,0:25:45.14,Default,,0,0,0,,Әй?
Dialogue: 0,0:25:45.14,0:25:47.14,Default,,0,0,0,,Ха...
Dialogue: 0,0:25:47.14,0:25:49.14,Default,,0,0,0,,Маусым... Айнада Юн
Dialogue: 0,0:25:49.14,0:25:52.14,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:25:55.13,0:25:59.14,Default,,0,0,0,,Иә! Дұрыс, бұл ылғалдандырады
Dialogue: 0,0:25:59.14,0:26:03.14,Default,,0,0,0,,Мен сенен менің орныма айнаға кіруіңді өтіндім.
Dialogue: 0,0:26:03.14,0:26:05.14,Default,,0,0,0,,Сізге рахмет, мен босмын.
Dialogue: 0,0:26:05.14,0:26:07.15,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:26:07.15,0:26:09.15,Default,,0,0,0,,Сәлем, балалар.
Dialogue: 0,0:26:09.15,0:26:12.15,Default,,0,0,0,,Келесі жолы сен менің досым боласың, солай ма?
Dialogue: 0,0:26:14.14,0:26:17.14,Default,,0,0,0,,А... сен Джун туралы айтып тұрсың...
Dialogue: 0,0:26:19.14,0:26:21.14,Default,,0,0,0,,Уау! Ка...
Dialogue: 0,0:26:21.14,0:26:23.14,Default,,0,0,0,,Сәлем! Апыр-ай!
Dialogue: 0,0:26:23.14,0:26:26.15,Default,,0,0,0,,Екеуің қашанға дейін сырласасыңдар...
Dialogue: 0,0:26:26.15,0:26:30.14,Default,,0,0,0,,Ахахха! Сіз әлі сонда болдыңыз ба?
Dialogue: 0,0:26:30.14,0:26:33.14,Default,,0,0,0,,Сіз де дос болғыңыз келе ме?
Dialogue: 0,0:26:36.14,0:26:38.14,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:26:51.14,0:26:53.14,Default,,0,0,0,,Хихихихи Күттіңіз бе?
Dialogue: 0,0:26:59.15,0:27:02.15,Default,,0,0,0,,Уақыт келді, өлетін кезің.
Dialogue: 0,0:27:12.14,0:27:15.14,Default,,0,0,0,,Не болды...
Dialogue: 0,0:27:17.15,0:27:19.13,Default,,0,0,0,,О! ДДСҰ? Сіз!
Dialogue: 0,0:27:19.13,0:27:21.14,Default,,0,0,0,,Қандай... манекен?
Dialogue: 0,0:27:21.14,0:27:23.14,Default,,0,0,0,,Б-бірақ… сәби аман.
Dialogue: 0,0:27:28.14,0:27:30.14,Default,,0,0,0,,Бұл әлсіз, бірақ әлі де елес қуат бар
Dialogue: 0,0:27:43.14,0:27:46.14,Default,,0,0,0,,Құбыжық пайда болды!
Dialogue: 0,0:27:46.14,0:27:48.14,Default,,0,0,0,,Ха!
Dialogue: 0,0:27:52.15,0:27:55.14,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:27:55.14,0:27:57.14,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:27:57.14,0:27:59.14,Default,,0,0,0,,Уф!
Dialogue: 0,0:27:59.14,0:28:01.14,Default,,0,0,0,,Бүгін «Роллинг фестивалі»
Dialogue: 0,0:28:06.15,0:28:08.15,Default,,0,0,0,,Бұл жұмыс істеді...
Dialogue: 0,0:28:08.15,0:28:10.15,Default,,0,0,0,,Әй
Dialogue: 0,0:28:10.15,0:28:12.14,Default,,0,0,0,,Иә! Та!
Dialogue: 0,0:28:12.14,0:28:15.14,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:28:15.14,0:28:18.14,Default,,0,0,0,,Уф! Қандай мақсатпен!
Dialogue: 0,0:28:18.14,0:28:20.14,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:28:20.14,0:28:22.15,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:28:22.15,0:28:24.15,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:28:24.15,0:28:26.15,Default,,0,0,0,,Аһ!
Dialogue: 0,0:28:26.15,0:28:29.14,Default,,0,0,0,,Гуо! Хамф!
Dialogue: 0,0:28:29.14,0:28:31.14,Default,,0,0,0,,Балалар...
Dialogue: 0,0:28:41.15,0:28:43.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:28:43.15,0:28:45.14,Default,,0,0,0,,Мен оны қажетсіз өлуіне жол бермеймін!
Dialogue: 0,0:28:45.14,0:28:48.14,Default,,0,0,0,,Маған шабуыл жасаудағы мақсатың не?
Dialogue: 0,0:28:48.14,0:28:51.14,Default,,0,0,0,,Кейбір жағдайларда біз бұған шыдамаймыз.
Dialogue: 0,0:28:51.14,0:28:53.14,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:28:53.14,0:28:55.15,Default,,0,0,0,,Айт! Мақсаты не?
Dialogue: 0,0:28:55.15,0:28:57.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:59.15,0:29:01.15,Default,,0,0,0,,Жеңіс... Иә Иә Иә
Dialogue: 0,0:29:02.15,0:29:05.14,Default,,0,0,0,,Гуо!
Dialogue: 0,0:29:05.14,0:29:07.14,Default,,0,0,0,,о!
Dialogue: 0,0:29:09.14,0:29:13.15,Default,,0,0,0,,Ау, ауырып тұр! Айтыңызшы...
Dialogue: 0,0:29:13.15,0:29:15.15,Default,,0,0,0,,Бұл – тұзақ екенінің дәлелі.
Dialogue: 0,0:29:17.15,0:29:19.15,Default,,0,0,0,,Балалар!
Dialogue: 0,0:29:22.14,0:29:25.14,Default,,0,0,0,,Балалар, сендерді бірдеңе басқарып жатыр ма?
Dialogue: 0,0:29:25.14,0:29:27.15,Default,,0,0,0,,Кең! Гоко!
Dialogue: 0,0:29:27.15,0:29:30.15,Default,,0,0,0,,Мики! Жең!
Dialogue: 0,0:29:30.15,0:29:32.15,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:29:36.15,0:29:38.15,Default,,0,0,0,,Енді мені өлтіріңіз.
Dialogue: 0,0:29:40.14,0:29:42.14,Default,,0,0,0,,Хмф! Ха!
Dialogue: 0,0:29:49.15,0:29:51.15,Default,,0,0,0,,Бүгін «Роллинг фестивалі»
Dialogue: 0,0:29:51.15,0:29:54.15,Default,,0,0,0,,Дегенмен, мен жаралансам да, өлуге әлі біраз уақыт бар.
Dialogue: 0,0:30:24.15,0:30:26.15,Default,,0,0,0,,Ей, не істеуіміз керек?
Dialogue: 0,0:30:26.15,0:30:28.16,Default,,0,0,0,,Қалған кештер менің асыл шәкірттерім.
Dialogue: 0,0:30:28.16,0:30:31.14,Default,,0,0,0,,Ұрысуға себеп жоқ...
Dialogue: 0,0:30:31.14,0:30:34.15,Default,,0,0,0,,Мен бірден осындай жерге жүгірдім.
Dialogue: 0,0:30:34.15,0:30:37.15,Default,,0,0,0,,Осымен ешқайда қашып құтыла алмайсың.
Dialogue: 0,0:30:39.15,0:30:41.15,Default,,0,0,0,,Ха...
Dialogue: 0,0:31:01.16,0:31:03.14,Default,,0,0,0,,Бұл – тұзақ екенінің дәлелі.
Dialogue: 0,0:31:03.14,0:31:05.14,Default,,0,0,0,,Ха! Хамф!
Dialogue: 0,0:31:19.16,0:31:21.14,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:31:21.14,0:31:23.14,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:31:23.14,0:31:25.14,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:31:35.16,0:31:37.16,Default,,0,0,0,,Ах ха ха ха!
Dialogue: 0,0:31:39.14,0:31:43.15,Default,,0,0,0,,Қандай күлкілі, күлгенімді тыя алмаймын.
Dialogue: 0,0:31:43.15,0:31:45.15,Default,,0,0,0,,Бұл тек бізге арналған дүние
Dialogue: 0,0:31:45.15,0:31:47.15,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:31:47.15,0:31:50.15,Default,,0,0,0,,Бұдан былай бұл біздің бос уақытымыз
Dialogue: 0,0:31:50.15,0:31:52.16,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:31:52.16,0:31:54.16,Default,,0,0,0,,жағымды жағымды
Dialogue: 0,0:31:54.16,0:31:59.15,Default,,0,0,0,,Бізді енді ешкім тоқтата алмайды!
Dialogue: 0,0:31:59.15,0:32:02.15,Default,,0,0,0,,Сәлем Джункун, қалыңыз қалай?
Dialogue: 0,0:32:02.15,0:32:04.15,Default,,0,0,0,,Сіз мені айнадан алып шыққанда
Dialogue: 0,0:32:04.15,0:32:07.16,Default,,0,0,0,,Мен уәдемді орындау үшін келдім. Ой...
Dialogue: 0,0:32:07.16,0:32:10.16,Default,,0,0,0,,Сіз далаға шыға алмайсыз.
Dialogue: 0,0:32:10.16,0:32:12.16,Default,,0,0,0,,Бірақ... қараңызшы.
Dialogue: 0,0:32:14.15,0:32:16.15,Default,,0,0,0,,Көрсетілгендей
Dialogue: 0,0:32:16.15,0:32:19.15,Default,,0,0,0,,Жолыңа түскен мұғалім өлді.
Dialogue: 0,0:32:19.15,0:32:21.15,Default,,0,0,0,,Қандай аянышты нәрсе, солай емес пе?
Dialogue: 0,0:32:23.15,0:32:27.16,Default,,0,0,0,,Қарашы, Джун, мен досымды алып келдім.
Dialogue: 0,0:32:27.16,0:32:29.16,Default,,0,0,0,,Мен және сен доспыз.
Dialogue: 0,0:32:31.15,0:32:34.15,Default,,0,0,0,,Сіз қалай ойлайсыз? сен бәрінің сүйіктісісің
Dialogue: 0,0:32:34.15,0:32:37.15,Default,,0,0,0,,Дегенмен, айнадағы менің көлеңкем сияқты.
Dialogue: 0,0:32:37.15,0:32:40.15,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:32:40.15,0:32:43.16,Default,,0,0,0,,Не болды? Балалар, сендер де күлулерің керек.
Dialogue: 0,0:32:43.16,0:32:45.16,Default,,0,0,0,,Келіңіздер... Иә?
Dialogue: 0,0:32:45.16,0:32:47.16,Default,,0,0,0,,Хэ-хэ…
Dialogue: 0,0:32:50.15,0:32:52.15,Default,,0,0,0,,Не... не болды? Бірге
Dialogue: 0,0:32:57.16,0:32:59.16,Default,,0,0,0,,Мұғалім...
Dialogue: 0,0:32:59.16,0:33:01.16,Default,,0,0,0,,Мұғалім қайтыс болса да
Dialogue: 0,0:33:01.16,0:33:04.15,Default,,0,0,0,,Маған күле аласың ба деп ойлаймын!
Dialogue: 0,0:33:04.15,0:33:06.15,Default,,0,0,0,,Балалар...
Dialogue: 0,0:33:06.15,0:33:08.15,Default,,0,0,0,,Сайқымазақ шешілді дейсіз бе?
Dialogue: 0,0:33:10.15,0:33:12.15,Default,,0,0,0,,Мен қолданған техника...
Dialogue: 0,0:33:12.15,0:33:14.16,Default,,0,0,0,,(Цезарь) Оны «Лиза Лиза» деп атайды.
Dialogue: 0,0:33:14.16,0:33:16.16,Default,,0,0,0,,Сен Джунды айнаға түсірдің
Dialogue: 0,0:33:16.16,0:33:19.16,Default,,0,0,0,,Тіпті мұғалімді де бізден тартып алды!
Dialogue: 0,0:33:19.16,0:33:22.15,Default,,0,0,0,,Мен сені ешқашан кешірмеймін! Ал... күте тұрыңыз.
Dialogue: 0,0:33:22.15,0:33:24.15,Default,,0,0,0,,Балалар сендер мұғалімнің рөлін сомдадыңдар.
Dialogue: 0,0:33:24.15,0:33:26.15,Default,,0,0,0,,Оны сендер өлтірдіңдер.
Dialogue: 0,0:33:26.15,0:33:28.15,Default,,0,0,0,,Солай дегің келе ме? Кешір мені.
Dialogue: 0,0:33:28.15,0:33:30.15,Default,,0,0,0,,Jun Сіз мені ести аласыз ба?
Dialogue: 0,0:33:30.15,0:33:33.16,Default,,0,0,0,,Біз сізді дұрыс түсінбедік деп ойлаймын.
Dialogue: 0,0:33:33.16,0:33:36.16,Default,,0,0,0,,Біртүрлі сәуегейлік танытқан
Dialogue: 0,0:33:36.16,0:33:38.16,Default,,0,0,0,,Ол да көлеңкеде істеді.
Dialogue: 0,0:33:38.16,0:33:40.15,Default,,0,0,0,,Міне!
Dialogue: 0,0:33:40.15,0:33:43.15,Default,,0,0,0,,Мұның бәрі осы сайқымазақтың жұмысы болды!
Dialogue: 0,0:33:43.15,0:33:45.15,Default,,0,0,0,,маусым...
Dialogue: 0,0:33:45.15,0:33:47.16,Default,,0,0,0,,Мені топтан қалдырған сен едің.
Dialogue: 0,0:33:47.16,0:33:50.16,Default,,0,0,0,,Бұл тітіркендіргіш!
Dialogue: 0,0:33:50.16,0:33:52.16,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,0:33:55.16,0:33:58.15,Default,,0,0,0,,Сіз мұны жасадыңыз ...
Dialogue: 0,0:33:58.15,0:34:00.15,Default,,0,0,0,,Балалар!
Dialogue: 0,0:34:00.15,0:34:02.15,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:34:02.15,0:34:04.15,Default,,0,0,0,,Ки!
Dialogue: 0,0:34:06.16,0:34:08.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:08.16,0:34:11.16,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:34:11.16,0:34:14.15,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:34:14.15,0:34:16.15,Default,,0,0,0,,Қарғыс атсын... сендерге.
Dialogue: 0,0:34:16.15,0:34:19.15,Default,,0,0,0,,Ұстазыңды қатты сағынсаң
Dialogue: 0,0:34:19.15,0:34:23.16,Default,,0,0,0,,Мен сені тозақта кездестіремін.
Dialogue: 0,0:34:23.16,0:34:25.16,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:34:31.15,0:34:33.15,Default,,0,0,0,,Жотароның Стар Платинумы шынымен де тамаша көру қабілетіне ие болуы мүмкін.
Dialogue: 0,0:34:37.15,0:34:41.16,Default,,0,0,0,,Қымбатты шәкіртіме тиісуге жол бермеймін.
Dialogue: 0,0:34:41.16,0:34:43.16,Default,,0,0,0,,Сіз...
Dialogue: 0,0:34:43.16,0:34:46.16,Default,,0,0,0,,Мен? Мен сені жеңу үшін келдім
Dialogue: 0,0:34:46.16,0:34:49.15,Default,,0,0,0,,Мен тозақтың түбінен көтерілдім.
Dialogue: 0,0:34:49.15,0:34:53.15,Default,,0,0,0,,Сол қолында жын қолы бар адам
Dialogue: 0,0:34:58.16,0:35:00.16,Default,,0,0,0,,Маған қоңырау шалыңыз, Тозақ мырза
Dialogue: 0,0:35:00.16,0:35:02.16,Default,,0,0,0,,Нубе!
Dialogue: 0,0:35:04.17,0:35:06.15,Default,,0,0,0,,Мен... сен аман қалдың ба?
Dialogue: 0,0:35:06.15,0:35:08.15,Default,,0,0,0,,Куууу…
Dialogue: 0,0:35:08.15,0:35:10.15,Default,,0,0,0,,Әй
Dialogue: 0,0:35:10.15,0:35:12.16,Default,,0,0,0,,Бұл жігіт – тайғақ
Dialogue: 0,0:35:12.16,0:35:14.16,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:35:18.16,0:35:21.17,Default,,0,0,0,,Рухани күш-қуатыммен біраз уақыт маған айналдың.
Dialogue: 0,0:35:21.17,0:35:23.15,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:35:23.15,0:35:25.15,Default,,0,0,0,,Бұл манекен.
Dialogue: 0,0:35:25.15,0:35:27.15,Default,,0,0,0,,Жотароның Стар Платинумы шынымен де тамаша көру қабілетіне ие болуы мүмкін.
Dialogue: 0,0:35:27.15,0:35:30.15,Default,,0,0,0,,Мұқият қараңдар Уау!
Dialogue: 0,0:35:35.16,0:35:38.17,Default,,0,0,0,,Дайын бол, құбыжық!
Dialogue: 0,0:35:38.17,0:35:40.17,Default,,0,0,0,,Nuo…
Dialogue: 0,0:35:40.17,0:35:42.15,Default,,0,0,0,,Ал... күте тұрыңыз.
Dialogue: 0,0:35:42.15,0:35:44.16,Default,,0,0,0,,Күте тұрыңыз, сэр.
Dialogue: 0,0:35:44.16,0:35:46.16,Default,,0,0,0,,Мен...
Dialogue: 0,0:35:48.16,0:35:51.16,Default,,0,0,0,,Мен Джун, мұғаліммін.
Dialogue: 0,0:35:51.16,0:35:54.17,Default,,0,0,0,,Не?
Dialogue: 0,0:35:54.17,0:35:57.15,Default,,0,0,0,,Сонымен айнадағы Джун ше?
Dialogue: 0,0:35:57.15,0:35:59.15,Default,,0,0,0,,маусым
Dialogue: 0,0:35:59.15,0:36:02.16,Default,,0,0,0,,Бірақ бұл менің көлеңкем ғана
Dialogue: 0,0:36:02.16,0:36:04.16,Default,,0,0,0,,Куууу!
Dialogue: 0,0:36:04.16,0:36:06.16,Default,,0,0,0,,Жоқ! Гуо!
Dialogue: 0,0:36:06.16,0:36:09.16,Default,,0,0,0,,Сондықтан мені ренжітпе
Dialogue: 0,0:36:09.16,0:36:11.17,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:36:11.17,0:36:13.17,Default,,0,0,0,,Арх! Мен өлсем
Dialogue: 0,0:36:13.17,0:36:16.15,Default,,0,0,0,,Айнадағы су да өледі.
Dialogue: 0,0:36:16.15,0:36:18.16,Default,,0,0,0,,Нубе...
Dialogue: 0,0:36:18.16,0:36:20.16,Default,,0,0,0,,Маун ояну
Dialogue: 0,0:36:20.16,0:36:23.16,Default,,0,0,0,,Сен оның көлеңкесі емессің.
Dialogue: 0,0:36:23.16,0:36:25.16,Default,,0,0,0,,Сен нағыз Юнсың.
Dialogue: 0,0:36:25.16,0:36:27.16,Default,,0,0,0,,Оян
Dialogue: 0,0:36:27.16,0:36:29.17,Default,,0,0,0,,Оянып, Нубеге көмектес!
Dialogue: 0,0:36:29.17,0:36:31.17,Default,,0,0,0,,маусым!
Dialogue: 0,0:36:36.16,0:36:39.16,Default,,0,0,0,,Тозаққа қайтып оралма
Dialogue: 0,0:36:39.16,0:36:41.16,Default,,0,0,0,,Хамф!
Dialogue: 0,0:36:41.16,0:36:43.16,Default,,0,0,0,,Жоқ... Жоқ!
Dialogue: 0,0:36:45.17,0:36:47.17,Default,,0,0,0,,Не? Сен бе...
Dialogue: 0,0:36:47.17,0:36:49.15,Default,,0,0,0,,№.
Dialogue: 0,0:36:49.15,0:36:51.16,Default,,0,0,0,,Барлығын одан артық ренжітпе.
Dialogue: 0,0:36:51.16,0:36:54.16,Default,,0,0,0,,Мен сені сайқымазаққа айналады деп күтпедім...
Dialogue: 0,0:36:54.16,0:36:56.16,Default,,0,0,0,,Мен мұны істей алмаймын! сен менің көлеңкемсің
Dialogue: 0,0:36:56.16,0:36:58.16,Default,,0,0,0,,Бұл менің қуыршақ!
Dialogue: 0,0:36:58.16,0:37:01.17,Default,,0,0,0,,Мен... Менің досым бар...
Dialogue: 0,0:37:01.17,0:37:03.17,Default,,0,0,0,,Мен жай ғана дос тапқым келді
Dialogue: 0,0:37:03.17,0:37:05.17,Default,,0,0,0,,маусым…
Dialogue: 0,0:37:05.17,0:37:07.15,Default,,0,0,0,,Ал сіз...
Dialogue: 0,0:37:07.15,0:37:09.15,Default,,0,0,0,,Сен!
Dialogue: 0,0:37:14.16,0:37:16.16,Default,,0,0,0,,Нуах! Ба... ақымақ
Dialogue: 0,0:37:16.16,0:37:19.17,Default,,0,0,0,,Сенің қолымнан келер емес, көлеңкем...
Dialogue: 0,0:37:19.17,0:37:21.17,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:37:21.17,0:37:24.16,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:37:24.16,0:37:26.16,Default,,0,0,0,,Құт
Dialogue: 0,0:37:26.16,0:37:28.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:28.16,0:37:30.16,Default,,0,0,0,,маусым…
Dialogue: 0,0:37:33.16,0:37:35.17,Default,,0,0,0,,маусым!
Dialogue: 0,0:37:35.17,0:37:39.17,Default,,0,0,0,,А-а, жоқ!
Dialogue: 0,0:37:39.17,0:37:41.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:41.16,0:37:43.16,Default,,0,0,0,,маусым!
Dialogue: 0,0:37:49.16,0:37:53.16,Default,,0,0,0,,Джун айнаға қарайды Джун-кун...
Dialogue: 0,0:37:58.16,0:38:01.16,Default,,0,0,0,,Нубе~ Сіз не істемексіз?
Dialogue: 0,0:38:03.16,0:38:05.16,Default,,0,0,0,,Жынның қолы – рухани дене
Dialogue: 0,0:38:05.16,0:38:08.17,Default,,0,0,0,,Кез келген затқа еніңіз
Dialogue: 0,0:38:08.17,0:38:11.17,Default,,0,0,0,,Айна болса да
Dialogue: 0,0:38:11.17,0:38:13.17,Default,,0,0,0,,Гррр…
Dialogue: 0,0:38:13.17,0:38:15.17,Default,,0,0,0,,Уау!
Dialogue: 0,0:38:21.16,0:38:23.16,Default,,0,0,0,,Жынның қолы
Dialogue: 0,0:38:23.16,0:38:26.17,Default,,0,0,0,,Енді сол қуатты пайдаланатын кез келді.
Dialogue: 0,0:38:26.17,0:38:29.17,Default,,0,0,0,,Көрсет!
Dialogue: 0,0:38:34.16,0:38:36.16,Default,,0,0,0,,Күте тұрыңыз, маусым.
Dialogue: 0,0:38:36.16,0:38:38.16,Default,,0,0,0,,Мен сізге міндетті түрде көмектесемін!
Dialogue: 0,0:38:43.17,0:38:46.17,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:38:46.17,0:38:48.17,Default,,0,0,0,,Нубе!
Dialogue: 0,0:39:03.17,0:39:06.17,Default,,0,0,0,,Қараңдаршы, айна әлемі құлап жатыр.
Dialogue: 0,0:39:09.16,0:39:11.16,Default,,0,0,0,,Әртүрлі әлемде болғандар
Dialogue: 0,0:39:11.16,0:39:13.16,Default,,0,0,0,,Бір әлемге кіргенде не болады?
Dialogue: 0,0:39:13.16,0:39:15.17,Default,,0,0,0,,Дүние ыдырап жатыр
Dialogue: 0,0:39:15.17,0:39:17.17,Default,,0,0,0,,Ақырында ол қараңғыда жабылады
Dialogue: 0,0:39:17.17,0:39:19.17,Default,,0,0,0,,Қараңғылық әлемі
Dialogue: 0,0:39:19.17,0:39:23.17,Default,,0,0,0,,Біз енді ешқашан көшеге шыға алмаймыз.
Dialogue: 0,0:39:23.17,0:39:26.17,Default,,0,0,0,,Хаха...хахаха!
Dialogue: 0,0:39:29.16,0:39:31.17,Default,,0,0,0,,Эй... ол келді.
Dialogue: 0,0:39:31.17,0:39:33.17,Default,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 0,0:39:46.16,0:39:48.17,Default,,0,0,0,,Ооо...
Dialogue: 0,0:39:48.17,0:39:50.17,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:39:50.17,0:39:52.17,Default,,0,0,0,,жеді
Dialogue: 0,0:39:52.17,0:39:54.17,Default,,0,0,0,,Бізді ол жеп қояды!
Dialogue: 0,0:39:54.17,0:39:56.17,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:39:56.17,0:39:58.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:58.18,0:40:01.16,Default,,0,0,0,,Жоқ, бұл жын емес.
Dialogue: 0,0:40:01.16,0:40:04.16,Default,,0,0,0,,Мұғалім!
Dialogue: 0,0:40:04.16,0:40:07.17,Default,,0,0,0,,Маған көмектесуге мұғалімім келді.
Dialogue: 0,0:40:07.17,0:40:10.17,Default,,0,0,0,,Жоқ! Сіз жейсіз
Dialogue: 0,0:40:10.17,0:40:12.17,Default,,0,0,0,,Уф
Dialogue: 0,0:40:12.17,0:40:15.18,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,0:40:15.18,0:40:17.16,Default,,0,0,0,,Рем ше?
Dialogue: 0,0:40:17.16,0:40:19.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:19.16,0:40:22.16,Default,,0,0,0,,Мен мұғалімге сенемін
Dialogue: 0,0:40:27.17,0:40:30.17,Default,,0,0,0,,Әй, ұстаз!
Dialogue: 0,0:40:30.17,0:40:32.17,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:40:34.16,0:40:36.16,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,0:40:36.16,0:40:39.17,Default,,0,0,0,,Сен бастапқыда Джунның көлеңкесі болдың.
Dialogue: 0,0:40:39.17,0:40:42.17,Default,,0,0,0,,Ештікке оралу
Dialogue: 0,0:40:42.17,0:40:44.17,Default,,0,0,0,,Ал... күте тұрыңыз.
Dialogue: 0,0:40:44.17,0:40:46.17,Default,,0,0,0,,Мен...
Dialogue: 0,0:40:46.17,0:40:48.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:40:48.18,0:40:50.18,Default,,0,0,0,,Не дедің, жауыз бала! (Киришима & Серо) Қайтып келдік.
Dialogue: 0,0:40:52.16,0:40:54.16,Default,,0,0,0,,Сіз сондайсыз
Dialogue: 0,0:40:54.16,0:40:58.17,Default,,0,0,0,,Сен Джунның жоғалған жүрегінен жаралған құбыжықсың.
Dialogue: 0,0:40:58.17,0:41:01.17,Default,,0,0,0,,Әу бастан ештеңенің бар болуы
Dialogue: 0,0:41:08.16,0:41:10.16,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,0:41:10.16,0:41:13.17,Default,,0,0,0,,Мен түсіндім деп ойлаймын.
Dialogue: 0,0:41:13.17,0:41:17.17,Default,,0,0,0,,Осы уақытқа дейін мен тек өзімді ойлап жүрдім.
Dialogue: 0,0:41:17.17,0:41:21.18,Default,,0,0,0,,Сондықтан осындай құбыжық дүниеге келген.
Dialogue: 0,0:41:21.18,0:41:24.18,Default,,0,0,0,,Біз әркім туралы көбірек ойлауымыз керек.
Dialogue: 0,0:41:24.18,0:41:26.16,Default,,0,0,0,,Дос болу деген нені білдіреді?
Dialogue: 0,0:41:26.16,0:41:29.17,Default,,0,0,0,,Бұл достарың туралы ойлауды білдіреді.
Dialogue: 0,0:41:29.17,0:41:32.17,Default,,0,0,0,,Енді мен білемін
Dialogue: 0,0:41:34.17,0:41:37.17,Default,,0,0,0,,Бұл қандай керемет сезім...
Dialogue: 0,0:41:41.18,0:41:45.17,Default,,0,0,0,,Бұл сезімді ұмытпа
Dialogue: 0,0:41:45.17,0:41:47.17,Default,,0,0,0,,Иә
Dialogue: 0,0:41:47.17,0:41:50.17,Default,,0,0,0,,Жүр, үйге қайтайық.
Dialogue: 0,0:41:50.17,0:41:52.17,Default,,0,0,0,,Барлығы күткен әлемге
Dialogue: 0,0:41:59.16,0:42:02.17,Default,,0,0,0,,Нубе
Dialogue: 0,0:42:02.17,0:42:04.17,Default,,0,0,0,,Қызық, қайда кетті?
Dialogue: 0,0:42:04.17,0:42:08.17,Default,,0,0,0,,Мүмкін ол ешқашан қайтып келмейтін шығар.
Dialogue: 0,0:42:14.18,0:42:16.18,Default,,0,0,0,,Не... не? Не?
Dialogue: 0,0:42:16.18,0:42:18.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:42:29.18,0:42:32.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:32.18,0:42:34.18,Default,,0,0,0,,Уф, оқ-дәрі астында қалып қоюдың өзі бір әлем екен
Dialogue: 0,0:42:36.17,0:42:39.17,Default,,0,0,0,,Нубе!
Dialogue: 0,0:42:39.17,0:42:41.17,Default,,0,0,0,,Йо
Dialogue: 0,0:42:44.17,0:42:47.17,Default,,0,0,0,,Ах... маусым!
Dialogue: 0,0:42:51.17,0:42:53.17,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:42:53.17,0:42:57.17,Default,,0,0,0,,Мына бейбақ әлі тірі ме? Ақымақ, сен оны алаңдаттың.
Dialogue: 0,0:42:57.17,0:43:00.17,Default,,0,0,0,,Дұрыс, көптен күттік.
Dialogue: 0,0:43:00.17,0:43:03.18,Default,,0,0,0,,Сен жердің қай жерінде қыдырдың?
Dialogue: 0,0:43:03.18,0:43:05.18,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:43:05.18,0:43:08.17,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:43:08.17,0:43:10.17,Default,,0,0,0,,Қайта кездескенше
Dialogue: 0,0:43:10.17,0:43:12.17,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:43:14.17,0:43:16.17,Default,,0,0,0,,Барлығы күтіп тұрды.
Dialogue: 0,0:43:19.19,0:43:21.18,Default,,0,0,0,,Сіз туралы
Dialogue: 0,0:43:21.18,0:43:23.18,Default,,0,0,0,,Досың ретінде
Dialogue: 0,0:43:23.18,0:43:25.18,Default,,0,0,0,,Маусымға қараңыз
Dialogue: 0,0:43:27.17,0:43:30.17,Default,,0,0,0,,Айнадағы көріністі қараңыз
Dialogue: 0,0:43:34.17,0:43:36.18,Default,,0,0,0,,Қазір көрсетілген нәрсе
Dialogue: 0,0:43:36.18,0:43:38.18,Default,,0,0,0,,Сіздің шынайы пішініңіз
Dialogue: 0,0:43:38.18,0:43:42.18,Default,,0,0,0,,Ал сіздің шынайы достарыңыз
Dialogue: 0,0:43:42.18,0:43:44.17,Default,,0,0,0,,Сіздің батылдығыңыз және барлығына деген сезіміңіз
Dialogue: 0,0:43:44.17,0:43:47.17,Default,,0,0,0,,Осылайша саған бәрі ғашық болды.
Dialogue: 0,0:43:49.17,0:43:52.18,Default,,0,0,0,,Сен де бәріне осылай ғашық боласың.
Dialogue: 0,0:43:52.18,0:43:54.18,Default,,0,0,0,,Досың ретінде
Dialogue: 0,0:43:54.18,0:43:56.18,Default,,0,0,0,,Иә... Иә?
Dialogue: 0,0:43:56.18,0:43:59.18,Default,,0,0,0,,Не болды? Даусыңыз кішкентай
Dialogue: 0,0:43:59.18,0:44:01.17,Default,,0,0,0,,Көңіл көтеріңіз!
Dialogue: 0,0:44:01.17,0:44:04.17,Default,,0,0,0,,Ха...
Dialogue: 0,0:44:04.17,0:44:06.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:44:06.17,0:44:08.18,Default,,0,0,0,,Хахахаха... Жарайды.
Dialogue: 0,0:44:08.18,0:44:10.18,Default,,0,0,0,,Бүгін кеш болды. Осы жерде қал.
Dialogue: 0,0:44:10.18,0:44:12.18,Default,,0,0,0,,Оның орнына...
Dialogue: 0,0:44:21.14,0:44:23.14,Default,,0,0,0,,Нубе
Dialogue: 0,0:44:24.64,0:44:30.64,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory