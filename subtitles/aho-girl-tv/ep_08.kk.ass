Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:30.00,0:00:36.00,Default,,0,0,0,,Ғашық болған кездегі келешегі бар жазғы демалыс
Dialogue: 0,0:00:36.00,0:00:39.00,Default,,0,0,0,,Толық шомылу
Dialogue: 0,0:00:39.00,0:00:42.00,Default,,0,0,0,,Мана-сама еңбегіңіз үшін рахмет
Dialogue: 0,0:00:42.00,0:00:47.00,Default,,0,0,0,,Сізге керемет көрінбейтін қызықты соңғы тегін
Dialogue: 0,0:00:47.00,0:00:50.00,Default,,0,0,0,,Дайхравив
Dialogue: 0,0:00:51.00,0:00:54.00,Default,,0,0,0,,Басталғалы тұрған таң қалдыратын аниме үлкен толқуларға толы болады.
Dialogue: 0,0:00:54.00,0:00:59.00,Default,,0,0,0,,Мама Уэйя Шок
Dialogue: 0,0:01:01.00,0:01:06.00,Default,,0,0,0,,Қыздар, көңіл көтерейік
Dialogue: 0,0:01:06.00,0:01:09.00,Default,,0,0,0,,Құлап қалма, ақымақ
Dialogue: 0,0:01:09.00,0:01:10.00,Default,,0,0,0,,Сіз кімге электрондық хат жібересіз?
Dialogue: 0,0:01:10.00,0:01:12.00,Default,,0,0,0,,Мүмкін сіздің жігітіңізбен?
Dialogue: 0,0:01:12.00,0:01:14.00,Default,,0,0,0,,Оның Демейге қатысы жоқ.
Dialogue: 0,0:01:14.00,0:01:18.00,Default,,0,0,0,,Әй, жігітсіз-ау мынау.
Dialogue: 0,0:01:18.00,0:01:19.00,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,0:01:19.00,0:01:22.00,Default,,0,0,0,,Менің жігітім бар ма, жоқ па бәрібір.
Dialogue: 0,0:01:22.00,0:01:24.00,Default,,0,0,0,,Мен қыздың махаббат хикаясын тыңдағым келеді
Dialogue: 0,0:01:24.00,0:01:26.00,Default,,0,0,0,,Олай болса, мына жігіттен сұраңыз.
Dialogue: 0,0:01:26.00,0:01:27.00,Default,,0,0,0,,Не?
Dialogue: 0,0:01:27.00,0:01:28.00,Default,,0,0,0,,Не?
Dialogue: 0,0:01:28.00,0:01:29.00,Default,,0,0,0,,Сенің жігітің бар ма?
Dialogue: 0,0:01:29.00,0:01:31.00,Default,,0,0,0,,Қанша уақыт бірге болдыңыз?
Dialogue: 0,0:01:33.00,0:01:35.00,Default,,0,0,0,,Міне, 3 ай ғана болды.
Dialogue: 0,0:01:35.00,0:01:37.00,Default,,0,0,0,,Қазір мен сені ең жақсы көретін кезім
Dialogue: 0,0:01:37.00,0:01:39.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:01:39.00,0:01:41.00,Default,,0,0,0,,Сізге не ұнайды? Сізге не себеп болды?
Dialogue: 0,0:01:41.00,0:01:42.00,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:01:42.00,0:01:44.00,Default,,0,0,0,,Сізге қызық па?
Dialogue: 0,0:01:44.00,0:01:46.00,Default,,0,0,0,,Мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:01:46.00,0:01:47.00,Default,,0,0,0,,Эй
Dialogue: 0,0:01:49.00,0:01:51.00,Default,,0,0,0,,Жарайды, мәселені шешейік.
Dialogue: 0,0:01:51.00,0:01:52.00,Default,,0,0,0,,Иә
Dialogue: 0,0:01:53.00,0:01:55.00,Default,,0,0,0,,Келіңіздер, сағаттап.
Dialogue: 0,0:01:57.00,0:02:00.00,Default,,0,0,0,,Оны басқа жақтан ұрлап кеткен.
Dialogue: 0,0:02:00.00,0:02:01.00,Default,,0,0,0,,Нақты не?
Dialogue: 0,0:02:01.00,0:02:05.00,Default,,0,0,0,,Мен сені көптен бері жақсы көремін.
Dialogue: 0,0:02:05.00,0:02:07.00,Default,,0,0,0,,Менімен бірге келіңізші
Dialogue: 0,0:02:07.00,0:02:09.00,Default,,0,0,0,,Шешілді, бастысы.
Dialogue: 0,0:02:09.00,0:02:12.00,Default,,0,0,0,,Мен әрқашан суреттерді ұнататынмын.
Dialogue: 0,0:02:12.00,0:02:14.00,Default,,0,0,0,,Бұл өте қызық
Dialogue: 0,0:02:14.00,0:02:16.00,Default,,0,0,0,,Иә? Сіз қайтадан жауап бердіңіз бе?
Dialogue: 0,0:02:16.00,0:02:19.00,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:02:19.00,0:02:21.00,Default,,0,0,0,,Жігітіңіздің ерлігіне осылай жауап бердіңіз бе?
Dialogue: 0,0:02:21.00,0:02:24.00,Default,,0,0,0,,Мен де сені әрқашан ұнататынмын және таң қалдым.
Dialogue: 0,0:02:24.00,0:02:26.00,Default,,0,0,0,,Джанжан
Dialogue: 0,0:02:26.00,0:02:28.00,Default,,0,0,0,,О
Dialogue: 0,0:02:28.00,0:02:30.00,Default,,0,0,0,,Чуа? Сіз мұны жасадыңыз ба?
Dialogue: 0,0:02:30.00,0:02:33.00,Default,,0,0,0,,Т-бұлай істеуге ешқандай мүмкіндік жоқ.
Dialogue: 0,0:02:33.00,0:02:35.00,Default,,0,0,0,,Біз әлі де қол ұстасып жүрміз бе?
Dialogue: 0,0:02:35.00,0:02:37.00,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:02:37.00,0:02:38.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:38.00,0:02:41.00,Default,,0,0,0,,Сіз мені сүйетініңізді айттыңыз ба?
Dialogue: 0,0:02:41.00,0:02:44.00,Default,,0,0,0,,Хашиши
Dialogue: 0,0:02:44.00,0:02:47.00,Default,,0,0,0,,Күрделі режимдер бар.
Dialogue: 0,0:02:47.00,0:02:49.00,Default,,0,0,0,,Иә
Dialogue: 0,0:02:49.00,0:02:52.00,Default,,0,0,0,,Сіз тіпті шайнамайсыз, қол ұстамайсыз, тіпті көңіл күйіңізді де айтпайсыз.
Dialogue: 0,0:02:52.00,0:02:55.00,Default,,0,0,0,,Бірақ мен мойындадым.
Dialogue: 0,0:02:55.00,0:02:59.00,Default,,0,0,0,,Ұлдар бұл туралы айтпаса, мазасызданады
Dialogue: 0,0:02:59.00,0:03:02.00,Default,,0,0,0,,Оның табиғи жойылу үлгісі бар.
Dialogue: 0,0:03:02.00,0:03:03.00,Default,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:03:03.00,0:03:06.00,Default,,0,0,0,,Тіпті менің көзқарасым бойынша, мен ол кісіге жаным ашиды.
Dialogue: 0,0:03:06.00,0:03:08.00,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:03:08.00,0:03:09.00,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:03:09.00,0:03:12.00,Default,,0,0,0,,Сондықтан мен сізге қазір айтуым керек.
Dialogue: 0,0:03:12.00,0:03:13.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:03:13.00,0:03:15.00,Default,,0,0,0,,Жедел жеткізу арқылы махаббат
Dialogue: 0,0:03:15.00,0:03:18.00,Default,,0,0,0,,Соны айтсаң да
Dialogue: 0,0:03:18.00,0:03:20.00,Default,,0,0,0,,Бұл Гарги қойындысы.
Dialogue: 0,0:03:20.00,0:03:22.00,Default,,0,0,0,,Рақмет, директор.
Dialogue: 0,0:03:22.00,0:03:24.00,Default,,0,0,0,,Рақмет, директор.
Dialogue: 0,0:03:24.00,0:03:25.00,Default,,0,0,0,,Фалко!!
Dialogue: 0,0:03:25.00,0:03:28.00,Default,,0,0,0,,Бұл жерде айтудың қажеті жоқ.
Dialogue: 0,0:03:28.00,0:03:30.00,Default,,0,0,0,,Фалко!!
Dialogue: 0,0:03:30.00,0:03:32.00,Default,,0,0,0,,Фалко!!
Dialogue: 0,0:03:32.00,0:03:34.00,Default,,0,0,0,,Иә
Dialogue: 0,0:03:34.00,0:03:36.00,Default,,0,0,0,,Иә
Dialogue: 0,0:03:36.00,0:03:40.00,Default,,0,0,0,,А-а, бұл менмін.
Dialogue: 0,0:03:40.00,0:03:42.00,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:03:42.00,0:03:45.00,Default,,0,0,0,,Маған ұнайды.
Dialogue: 0,0:03:45.00,0:03:47.00,Default,,0,0,0,,Өйткені мен де сені әрқашан жақсы көрдім
Dialogue: 0,0:03:47.00,0:03:49.00,Default,,0,0,0,,Бірге болуды жалғастырыңыз.
Dialogue: 0,0:03:49.00,0:03:51.00,Default,,0,0,0,,Иә
Dialogue: 0,0:03:51.00,0:03:54.00,Default,,0,0,0,,Айта алады
Dialogue: 0,0:03:54.00,0:03:55.00,Default,,0,0,0,,Га
Dialogue: 0,0:03:55.00,0:03:57.00,Default,,0,0,0,,Жұмсақ
Dialogue: 0,0:03:57.00,0:04:00.00,Default,,0,0,0,,Ол өзін қызмын десе де, іштей қыз.
Dialogue: 0,0:04:00.00,0:04:03.00,Default,,0,0,0,,Өйткені мен де сені әрқашан жақсы көрдім
Dialogue: 0,0:04:03.00,0:04:04.00,Default,,0,0,0,,Эй
Dialogue: 0,0:04:04.00,0:04:08.00,Default,,0,0,0,,Бірге болуды өтінемін.
Dialogue: 0,0:04:08.00,0:04:10.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:04:10.00,0:04:13.00,Default,,0,0,0,,Бірге болуды өтінемін.
Dialogue: 0,0:04:13.00,0:04:15.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:04:23.00,0:04:24.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:24.00,0:04:26.00,Default,,0,0,0,,Экскурсияға көп тағамдар сатып алайық.
Dialogue: 0,0:04:26.00,0:04:27.00,Default,,0,0,0,,Макуро
Dialogue: 0,0:04:27.00,0:04:30.00,Default,,0,0,0,,Жоқ, бұл біздің мектептің саяхаты.
Dialogue: 0,0:04:30.00,0:04:31.00,Default,,0,0,0,,Жетеді ме?
Dialogue: 0,0:04:31.00,0:04:32.00,Default,,0,0,0,,Не сатып алу керек?
Dialogue: 0,0:04:32.00,0:04:33.00,Default,,0,0,0,,That's right.
Dialogue: 0,0:04:33.00,0:04:34.00,Default,,0,0,0,,Шоколад және картоп
Dialogue: 0,0:04:34.00,0:04:35.00,Default,,0,0,0,,(Саяма) Ой! (Джунпей) Уф...
Dialogue: 0,0:04:35.00,0:04:38.00,Default,,0,0,0,,Экскурсиялардағы жеңіл тағамдарды бағаламау.
Dialogue: 0,0:04:38.00,0:04:39.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:04:39.00,0:04:40.00,Default,,0,0,0,,Менен кешірім сұрасаңыз
Dialogue: 0,0:04:40.00,0:04:42.00,Default,,0,0,0,,Бұл жаман болады.
Dialogue: 0,0:04:42.00,0:04:43.00,Default,,0,0,0,,Жарайды, екеу болсын.
Dialogue: 0,0:04:43.00,0:04:44.00,Default,,0,0,0,,Не болады?
Dialogue: 0,0:04:44.00,0:04:45.00,Default,,0,0,0,,Өте
Dialogue: 0,0:04:45.00,0:04:47.00,Default,,0,0,0,,Қайғылы сезім
Dialogue: 0,0:04:47.00,0:04:48.00,Default,,0,0,0,,Жоқ, білмеймін.
Dialogue: 0,0:04:48.00,0:04:49.00,Default,,0,0,0,,Қабылдау
Dialogue: 0,0:04:49.00,0:04:52.00,Default,,0,0,0,,Сөмкеңізде шоколад ериді және картоп сынды.
Dialogue: 0,0:04:52.00,0:04:54.00,Default,,0,0,0,,Көп нәрсе қалмаса
Dialogue: 0,0:04:54.00,0:04:56.00,Default,,0,0,0,,Мен тамақты бірден жеп қойдым.
Dialogue: 0,0:04:56.00,0:04:58.00,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:04:58.00,0:05:03.00,Default,,0,0,0,,Басқаша айтқанда, экскурсияға арналған 300 иен қалта ақшасының ішіндегі сапа мен сан арасындағы тепе-теңдік және панорамалау кезіндегі соққы дәрежесі.
Dialogue: 0,0:05:03.00,0:05:07.00,Default,,0,0,0,,Бұл күндегі ауа райы жағдайын ескеру маңызды дегенді білдіре ме?
Dialogue: 0,0:05:07.00,0:05:08.00,Default,,0,0,0,,Кішкене анық
Dialogue: 0,0:05:08.00,0:05:09.00,Default,,0,0,0,,Бөлек
Dialogue: 0,0:05:09.00,0:05:12.00,Default,,0,0,0,,Йошико ақымақ, бірақ мен сенің не айтқың келіп тұрғаныңды түсінемін.
Dialogue: 0,0:05:12.00,0:05:14.00,Default,,0,0,0,,Бұл сатып алудан бұрын мұқият ойлану керек дегенді білдіре ме?
Dialogue: 0,0:05:14.00,0:05:16.00,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:05:16.00,0:05:19.00,Default,,0,0,0,,Бұл дүкенде арзандарымен араласып кеткен қымбаттары бар.
Dialogue: 0,0:05:19.00,0:05:24.00,Default,,0,0,0,,Бұл бадам ұнтақталған Potchy Deluxe 300 иен
Dialogue: 0,0:05:24.00,0:05:27.00,Default,,0,0,0,,Егер сіз осындай нәрсені сатып алсаңыз, басқа ештеңе сатып ала алмайсыз.
Dialogue: 0,0:05:27.00,0:05:31.00,Default,,0,0,0,,Арзанмен салыстырғанда ғажайып көрінетін тұзақ.
Dialogue: 0,0:05:31.00,0:05:32.00,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:05:32.00,0:05:33.00,Default,,0,0,0,,Кіші
Dialogue: 0,0:05:33.00,0:05:36.00,Default,,0,0,0,,Балалардан ақшаны сығу арқылы жеткізілген бір ақшыл
Dialogue: 0,0:05:36.00,0:05:38.00,Default,,0,0,0,,Қандай сұмдық кемпір.
Dialogue: 0,0:05:38.00,0:05:42.00,Default,,0,0,0,,Бірақ мен кемпірдің тұзағына түстім
Dialogue: 0,0:05:42.00,0:05:45.00,Default,,0,0,0,,Тәтті сөйлеу, т.б.
Dialogue: 0,0:05:45.00,0:05:46.00,Default,,0,0,0,,Бірақ жақсы ма?
Dialogue: 0,0:05:46.00,0:05:47.00,Default,,0,0,0,,Иә
Dialogue: 0,0:05:49.00,0:05:51.00,Default,,0,0,0,,Оны қайда апаруға болады?
Dialogue: 0,0:05:51.00,0:05:53.00,Default,,0,0,0,,Сіз шынымен мектеп оқушысысыз ба?
Dialogue: 0,0:05:53.00,0:05:55.00,Default,,0,0,0,,Текайошиді жалғыз қалдырыңыз
Dialogue: 0,0:05:55.00,0:05:56.00,Default,,0,0,0,,That's right.
Dialogue: 0,0:05:56.00,0:06:00.00,Default,,0,0,0,,Жарайды, менің негізгі аффирмациям ұзақ уақыт жеуге болатын сағыз.
Dialogue: 0,0:06:00.00,0:06:01.00,Default,,0,0,0,,Онда мен кәмпитпін
Dialogue: 0,0:06:01.00,0:06:02.00,Default,,0,0,0,,Нотоби
Dialogue: 0,0:06:02.00,0:06:03.00,Default,,0,0,0,,Нотоби
Dialogue: 0,0:06:03.00,0:06:04.00,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:06:04.00,0:06:07.00,Default,,0,0,0,,Бадам ұнтақталған құмыра Deluxe
Dialogue: 0,0:06:07.00,0:06:09.00,Default,,0,0,0,,Мен оны Нотоби-чаннан сатып алдым.
Dialogue: 0,0:06:09.00,0:06:11.00,Default,,0,0,0,,Өйткені ол дәмді көрінеді
Dialogue: 0,0:06:11.00,0:06:12.00,Default,,0,0,0,,Үлпілдек
Dialogue: 0,0:06:12.00,0:06:13.00,Default,,0,0,0,,Бұл жерде
Dialogue: 0,0:06:19.00,0:06:21.00,Default,,0,0,0,,Тәттілер жеткіліксіз
Dialogue: 0,0:06:21.00,0:06:24.00,Default,,0,0,0,,Тоби-чанның саяхаты қайғыға толы.
Dialogue: 0,0:06:25.00,0:06:28.00,Default,,0,0,0,,Нотоби-чанның тәттілері дәмді көрінеді
Dialogue: 0,0:06:28.00,0:06:31.00,Default,,0,0,0,,Біреуін менікі
Dialogue: 0,0:06:31.00,0:06:32.00,Default,,0,0,0,,Күтпеген жерден
Dialogue: 0,0:06:32.00,0:06:34.00,Default,,0,0,0,,Сауда-саттықты мақсат етесіз бе?
Dialogue: 0,0:06:34.00,0:06:35.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:35.00,0:06:37.00,Default,,0,0,0,,Балалар алатын арзан кәмпитте
Dialogue: 0,0:06:37.00,0:06:40.00,Default,,0,0,0,,Almond Crush Poochie Deluxe ерекше ерекшеленеді
Dialogue: 0,0:06:40.00,0:06:44.00,Default,,0,0,0,,Егер сіз барлық адамдармен Almond Crush Potchy Deluxe айырбастасаңыз, сіз көп нәрсені жасай аласыз.
Dialogue: 0,0:06:45.00,0:06:46.00,Default,,0,0,0,,Төзуге болады
Dialogue: 0,0:06:46.00,0:06:48.00,Default,,0,0,0,,Бадам ұнтақталған құмыра Deluxe
Dialogue: 0,0:06:48.00,0:06:49.00,Default,,0,0,0,,5 бамбук ауылдары және
Dialogue: 0,0:06:49.00,0:06:52.00,Default,,0,0,0,,Жоқ, 10 данаға айырбастау мүмкін емес.
Dialogue: 0,0:06:52.00,0:06:54.00,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:06:55.00,0:06:56.00,Default,,0,0,0,,қорқынышты
Dialogue: 0,0:06:56.00,0:06:57.00,Default,,0,0,0,,Дәл
Dialogue: 0,0:06:57.00,0:06:59.00,Default,,0,0,0,,Жынмен емдеу
Dialogue: 0,0:06:59.00,0:07:02.00,Default,,0,0,0,,Мен тамақ таңдаудың соншалықты терең екенін білмедім.
Dialogue: 0,0:07:02.00,0:07:05.00,Default,,0,0,0,,Сіз өзіңіз қалаған нәрсені толығымен бағаламадыңыз.
Dialogue: 0,0:07:05.00,0:07:08.00,Default,,0,0,0,,Мұны бәрі де қалайды ма?
Dialogue: 0,0:07:08.00,0:07:10.00,Default,,0,0,0,,Не түсінікті?
Dialogue: 0,0:07:10.00,0:07:13.00,Default,,0,0,0,,Олай болса мен әрқайсысына бір бөтелке беремін.
Dialogue: 0,0:07:13.00,0:07:15.00,Default,,0,0,0,,Иә
Dialogue: 0,0:07:15.00,0:07:17.00,Default,,0,0,0,,Екеуің ше?
Dialogue: 0,0:07:17.00,0:07:18.00,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:07:18.00,0:07:19.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:19.00,0:07:20.00,Default,,0,0,0,,Періште?
Dialogue: 0,0:07:30.00,0:07:31.00,Default,,0,0,0,,Акутсу-кун
Dialogue: 0,0:07:31.00,0:07:33.00,Default,,0,0,0,,Менің қасымда болу мені тыныштандырады.
Dialogue: 0,0:07:33.00,0:07:36.00,Default,,0,0,0,,Мен осылай мәңгі қалғым келеді
Dialogue: 0,0:07:39.00,0:07:42.00,Default,,0,0,0,,Шай дәмді, Акуру-сан.
Dialogue: 0,0:07:42.00,0:07:44.00,Default,,0,0,0,,Шай да жақсы.
Dialogue: 0,0:07:45.00,0:07:46.00,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:07:46.00,0:07:49.00,Default,,0,0,0,,Сіздің денеңіз әлемдегі ең жақсы дене
Dialogue: 0,0:07:49.00,0:07:52.00,Default,,0,0,0,,Мәңгі тым жігерлі
Dialogue: 0,0:07:55.00,0:07:57.00,Default,,0,0,0,,Әңгіме дегеніміз не?
Dialogue: 0,0:07:57.00,0:08:01.00,Default,,0,0,0,,Сіз бұл аңдуды тоқтатуыңыз керек.
Dialogue: 0,0:08:01.00,0:08:05.00,Default,,0,0,0,,Мен жай ғана Акутсу-кунның атмосферасын бұзбау үшін оны бақылап отырмын.
Dialogue: 0,0:08:05.00,0:08:08.00,Default,,0,0,0,,Ең алдымен аңдуға ешқандай себеп жоқ.
Dialogue: 0,0:08:08.00,0:08:11.00,Default,,0,0,0,,Сізге Акун ұнайды, солай ма?
Dialogue: 0,0:08:12.00,0:08:14.00,Default,,0,0,0,,Неліктен білдің?
Dialogue: 0,0:08:14.00,0:08:16.00,Default,,0,0,0,,Ал, оны көрген адам
Dialogue: 0,0:08:16.00,0:08:17.00,Default,,0,0,0,,А, осы ма?
Dialogue: 0,0:08:17.00,0:08:20.00,Default,,0,0,0,,Акутсу-кун кейде мейірімді.
Dialogue: 0,0:08:20.00,0:08:23.00,Default,,0,0,0,,Сырт келбеті жаман, дос емес, күдікті
Dialogue: 0,0:08:23.00,0:08:25.00,Default,,0,0,0,,Бірақ мұндай нәрсе
Dialogue: 0,0:08:25.00,0:08:27.00,Default,,0,0,0,,Бұл құны жоқ
Dialogue: 0,0:08:27.00,0:08:29.00,Default,,0,0,0,,Жақтау
Dialogue: 0,0:08:29.00,0:08:30.00,Default,,0,0,0,,Жақсы көңіл-күй
Dialogue: 0,0:08:30.00,0:08:35.00,Default,,0,0,0,,Меніңше, Акун-санның байсалды, сабырлы болғаны дұрыс болар еді.
Dialogue: 0,0:08:35.00,0:08:39.00,Default,,0,0,0,,Иә? Бұл менің мінсіз екенімді білдіреді ме?
Dialogue: 0,0:08:41.00,0:08:44.00,Default,,0,0,0,,Төраға мырза, сіз үнемі бақылаудан шығасыз.
Dialogue: 0,0:08:44.00,0:08:46.00,Default,,0,0,0,,Акун мырзаның футонына жасырын кіру
Dialogue: 0,0:08:46.00,0:08:49.00,Default,,0,0,0,,Акутсу-кунды Ханабатаке-саннан қорғау үшін.
Dialogue: 0,0:08:49.00,0:08:51.00,Default,,0,0,0,,Ваннаға қарау
Dialogue: 0,0:08:51.00,0:08:54.00,Default,,0,0,0,,Сіздің ұнамдылығыңыз артқан болуы керек, өйткені сіз оны ескере отырып әрекет еттіңіз.
Dialogue: 0,0:08:55.00,0:08:56.00,Default,,0,0,0,,Кешіктірілуі мүмкін
Dialogue: 0,0:08:56.00,0:08:57.00,Default,,0,0,0,,Бұл қандай көздер?
Dialogue: 0,0:08:57.00,0:09:00.00,Default,,0,0,0,,Маған бірдеңе болды ма?
Dialogue: 0,0:09:00.00,0:09:04.00,Default,,0,0,0,,Сонымен Акун мырза сізді қалай көреді деп ойлайсыз?
Dialogue: 0,0:09:04.00,0:09:07.00,Default,,0,0,0,,Сіз мен сүйетін әдемі ағасыз, солай ма?
Dialogue: 0,0:09:07.00,0:09:10.00,Default,,0,0,0,,Сізде сол позитивтілік бар болса, сіз бақытты бола бересіз.
Dialogue: 0,0:09:10.00,0:09:12.00,Default,,0,0,0,,Сонда бұл көздер қандай?
Dialogue: 0,0:09:13.00,0:09:16.00,Default,,0,0,0,,Мені қалай көретініңді айт
Dialogue: 0,0:09:16.00,0:09:20.00,Default,,0,0,0,,Мен ең болмағанда шындықты қабылдай аламын.
Dialogue: 0,0:09:21.00,0:09:25.00,Default,,0,0,0,,Тәртіптік комитеттің төрағасы дерлік эксцентрик.
Dialogue: 0,0:09:27.00,0:09:29.00,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:09:29.00,0:09:31.00,Default,,0,0,0,,Мен оны мүлде қабылдамаймын.
Dialogue: 0,0:09:31.00,0:09:34.00,Default,,0,0,0,,Жоқ, бірақ бұл жақсы
Dialogue: 0,0:09:34.00,0:09:38.00,Default,,0,0,0,,Не? Не? Сен қалжыңдап тұрсың ба?
Dialogue: 0,0:09:40.00,0:09:42.00,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:09:44.00,0:09:47.00,Default,,0,0,0,,Сонымен, сен футонға немен кірдің?
Dialogue: 0,0:09:47.00,0:09:48.00,Default,,0,0,0,,Бұл бұрмаланған әрекет.
Dialogue: 0,0:09:48.00,0:09:49.00,Default,,0,0,0,,Мен де жуынатын бөлмеге қарадым.
Dialogue: 0,0:09:49.00,0:09:51.00,Default,,0,0,0,,Бұл қылмыстық әрекет.
Dialogue: 0,0:09:51.00,0:09:52.00,Default,,0,0,0,,Сен өлесің бе?
Dialogue: 0,0:09:53.00,0:09:57.00,Default,,0,0,0,,Хмм, сен әйел болып өліп қалдың ба?
Dialogue: 0,0:09:58.00,0:09:59.00,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:10:00.00,0:10:03.00,Default,,0,0,0,,Жоқ, жоқ, бұл жай әзіл.
Dialogue: 0,0:10:03.00,0:10:05.00,Default,,0,0,0,,Иә? Шынымен бе?
Dialogue: 0,0:10:05.00,0:10:07.00,Default,,0,0,0,,Сонда сендер мен туралы айтып отырсыңдар.
Dialogue: 0,0:10:07.00,0:10:09.00,Default,,0,0,0,,Біз шетте тұрмыз ба?
Dialogue: 0,0:10:09.00,0:10:11.00,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:10:14.00,0:10:16.00,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:10:19.00,0:10:21.00,Default,,0,0,0,,Сәлем ит
Dialogue: 0,0:10:22.00,0:10:24.00,Default,,0,0,0,,Саяқаның иті жоқ па?
Dialogue: 0,0:10:24.00,0:10:26.00,Default,,0,0,0,,Бізде де померандық бар.
Dialogue: 0,0:10:26.00,0:10:28.00,Default,,0,0,0,,Шынайы ма? Маған мінуге рұқсат етіңіз
Dialogue: 0,0:10:28.00,0:10:30.00,Default,,0,0,0,,Ал, міну мүмкін емес.
Dialogue: 0,0:10:31.00,0:10:33.00,Default,,0,0,0,,Олай болса оны неге сақтайсың?
Dialogue: 0,0:10:33.00,0:10:35.00,Default,,0,0,0,,Бұл сүйкімді
Dialogue: 0,0:10:36.00,0:10:37.00,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:10:37.00,0:10:38.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:10:40.00,0:10:42.00,Default,,0,0,0,,Қарашы, бұл қыз менің Помечаным.
Dialogue: 0,0:10:42.00,0:10:44.00,Default,,0,0,0,,О, Поме-чан
Dialogue: 0,0:10:44.00,0:10:45.00,Default,,0,0,0,,Сүйкімді емес пе?
Dialogue: 0,0:10:45.00,0:10:46.00,Default,,0,0,0,,Өте әлсіз көрінеді
Dialogue: 0,0:10:46.00,0:10:47.00,Default,,0,0,0,,Сүйкімді емес пе?
Dialogue: 0,0:10:47.00,0:10:50.00,Default,,0,0,0,,Қоғамның қаталдығын білмейтін сияқтысың.
Dialogue: 0,0:10:50.00,0:10:52.00,Default,,0,0,0,,Йошико-чан осылай дейді
Dialogue: 0,0:10:57.00,0:10:59.00,Default,,0,0,0,,Бұл ынталы жүздің несі бар?
Dialogue: 0,0:10:59.00,0:11:01.00,Default,,0,0,0,,Сіз мұны шынымен орындағыңыз келе ме?
Dialogue: 0,0:11:01.00,0:11:02.00,Default,,0,0,0,,Не
Dialogue: 0,0:11:08.00,0:11:09.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:09.00,0:11:10.00,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:11:10.00,0:11:11.00,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:11:11.00,0:11:13.00,Default,,0,0,0,,Қорқыныштан қалтырап жатсаңыз
Dialogue: 0,0:11:15.00,0:11:17.00,Default,,0,0,0,,Күтпеген жас ұсыныс
Dialogue: 0,0:11:21.00,0:11:23.00,Default,,0,0,0,,Және бас тартты
Dialogue: 0,0:11:23.00,0:11:27.00,Default,,0,0,0,,Оның орнына Помечан мұны істей ме?
Dialogue: 0,0:11:27.00,0:11:29.00,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:11:29.00,0:11:31.00,Default,,0,0,0,,Ал, бұл шынымен күшті ме?
Dialogue: 0,0:11:33.00,0:11:34.00,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:11:34.00,0:11:35.00,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:11:35.00,0:11:36.00,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:11:36.00,0:11:37.00,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:11:37.00,0:11:38.00,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:11:38.00,0:11:39.00,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:11:39.00,0:11:40.00,Default,,0,0,0,,Ол күшті ме?
Dialogue: 0,0:11:41.00,0:11:43.00,Default,,0,0,0,,Байқа, ит!
Dialogue: 0,0:11:43.00,0:11:45.00,Default,,0,0,0,,Сақтансаң, өлесің.
Dialogue: 0,0:11:53.00,0:11:54.00,Default,,0,0,0,,Маған сен!
Dialogue: 0,0:11:54.00,0:11:56.00,Default,,0,0,0,,Не істеді?
Dialogue: 0,0:11:57.00,0:11:58.00,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:11:59.00,0:12:01.00,Default,,0,0,0,,Ко, Косада
Dialogue: 0,0:12:02.00,0:12:06.00,Default,,0,0,0,,Итім жеңіледі деп ойламаппын.
Dialogue: 0,0:12:06.00,0:12:08.00,Default,,0,0,0,,Поме-чанмен дос болыңыз.
Dialogue: 0,0:12:09.00,0:12:10.00,Default,,0,0,0,,Кешіріңіз Саяга-чан
Dialogue: 0,0:12:10.00,0:12:12.00,Default,,0,0,0,,Мен қателестім
Dialogue: 0,0:12:12.00,0:12:13.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:12:13.00,0:12:15.00,Default,,0,0,0,,Поме-чан - таңғажайып ит
Dialogue: 0,0:12:16.00,0:12:17.00,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:12:18.00,0:12:20.00,Default,,0,0,0,,Джинджо
Dialogue: 0,0:12:27.00,0:12:29.00,Default,,0,0,0,,Келесі мерекелік идиот қыз
Dialogue: 0,0:12:30.50,0:12:36.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory