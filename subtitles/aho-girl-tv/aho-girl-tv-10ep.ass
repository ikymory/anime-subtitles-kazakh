Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:30.00,0:00:36.00,Default,,0,0,0,,Ғашық болған кездегі келешегі бар жазғы демалыс
Dialogue: 0,0:00:36.00,0:00:39.00,Default,,0,0,0,,Бар күшіңмен тыныштық
Dialogue: 0,0:00:39.00,0:00:42.00,Default,,0,0,0,,Марусама еңбегіңіз үшін рахмет
Dialogue: 0,0:00:42.00,0:00:47.00,Default,,0,0,0,,Қызықты соңғы тегін
Dialogue: 0,0:00:47.00,0:00:50.00,Default,,0,0,0,,Дарлинг Хирабибу
Dialogue: 0,0:00:50.00,0:00:51.00,Default,,0,0,0,,Ховахова
Dialogue: 0,0:00:51.00,0:00:54.00,Default,,0,0,0,,Басталғалы тұрған таң қалдыратын аниме сізді мәңгі күлдіретін кездейсоқтық.
Dialogue: 0,0:00:54.00,0:00:59.00,Default,,0,0,0,,Мамавая Шоку
Dialogue: 0,0:01:01.00,0:01:04.00,Default,,0,0,0,,Бейбітшілік Хана
Dialogue: 0,0:01:04.00,0:01:05.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:05.00,0:01:06.00,Default,,0,0,0,,Жасайық
Dialogue: 0,0:01:06.00,0:01:08.00,Default,,0,0,0,,Бейбітшілік ашылады
Dialogue: 0,0:01:08.00,0:01:10.00,Default,,0,0,0,,Бүгін жасайық
Dialogue: 0,0:01:10.00,0:01:13.00,Default,,0,0,0,,Қазір орындаңыз
Dialogue: 0,0:01:14.00,0:01:15.00,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:01:15.00,0:01:18.00,Default,,0,0,0,,Нені басу керек?
Dialogue: 0,0:01:18.00,0:01:19.00,Default,,0,0,0,,Өлтірейік
Dialogue: 0,0:01:19.00,0:01:21.00,Default,,0,0,0,,Мені соғып кете жаздады, солай емес пе?
Dialogue: 0,0:01:21.00,0:01:22.00,Default,,0,0,0,,Ува инесі
Dialogue: 0,0:01:22.00,0:01:25.00,Default,,0,0,0,,Ол затты құлағыңызға дейін не істедіңіз?
Dialogue: 0,0:01:25.00,0:01:26.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:01:26.00,0:01:29.00,Default,,0,0,0,,Жоқ, мен сені пышақтап жібере жаздадым.
Dialogue: 0,0:01:29.00,0:01:31.00,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:01:31.00,0:01:36.00,Default,,0,0,0,,Құлағымды инемен тескенімде көп қан шықты.
Dialogue: 0,0:01:36.00,0:01:39.00,Default,,0,0,0,,Вакуум жара арқылы енеді.
Dialogue: 0,0:01:39.00,0:01:43.00,Default,,0,0,0,,Ауырып, қиналып, өл
Dialogue: 0,0:01:43.00,0:01:44.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:01:44.00,0:01:46.00,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:01:46.00,0:01:48.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:48.00,0:01:50.00,Default,,0,0,0,,Сіз өлмейсіз.
Dialogue: 0,0:01:50.00,0:01:52.00,Default,,0,0,0,,Әйтеуір, оның қандай жақсылығы бар?
Dialogue: 0,0:01:52.00,0:01:54.00,Default,,0,0,0,,Ол жаққа да бара алмайсың.
Dialogue: 0,0:01:54.00,0:01:55.00,Default,,0,0,0,,Ол шығады.
Dialogue: 0,0:01:55.00,0:01:59.00,Default,,0,0,0,,Мен жай ғана сүйкімді Пиасотты кигім келеді
Dialogue: 0,0:01:59.00,0:02:00.00,Default,,0,0,0,,Оны асыра алмаңыз
Dialogue: 0,0:02:00.00,0:02:02.00,Default,,0,0,0,,Неге сонша?
Dialogue: 0,0:02:02.00,0:02:04.00,Default,,0,0,0,,Оны алғыңыз келе ме?
Dialogue: 0,0:02:04.00,0:02:06.00,Default,,0,0,0,,Менің кетуім керек…
Dialogue: 0,0:02:06.00,0:02:10.00,Default,,0,0,0,,Сәнді және сүйкімді болыңыз
Dialogue: 0,0:02:10.00,0:02:12.00,Default,,0,0,0,,Менің де жігітім керек
Dialogue: 0,0:02:12.00,0:02:15.00,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:02:15.00,0:02:17.00,Default,,0,0,0,,Хиераги кейде сәл шатасатын сияқты.
Dialogue: 0,0:02:17.00,0:02:20.00,Default,,0,0,0,,Шинаның сүйетін жігіті бар.
Dialogue: 0,0:02:20.00,0:02:21.00,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:02:21.00,0:02:25.00,Default,,0,0,0,,Тек сырға тағый білу керек.
Dialogue: 0,0:02:25.00,0:02:29.00,Default,,0,0,0,,Сондықтан қазір тоқтамаңыз
Dialogue: 0,0:02:29.00,0:02:31.00,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:02:31.00,0:02:34.00,Default,,0,0,0,,Бірақ мұндай дірілдеген қолдармен істесең, сәтсіздікке ұшырайсың.
Dialogue: 0,0:02:34.00,0:02:36.00,Default,,0,0,0,,Шулы
Dialogue: 0,0:02:36.00,0:02:39.00,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:02:39.00,0:02:41.00,Default,,0,0,0,,Мен сені қолдаймын
Dialogue: 0,0:02:41.00,0:02:43.00,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:02:43.00,0:02:45.00,Default,,0,0,0,,Енді орындайық
Dialogue: 0,0:02:45.00,0:02:46.00,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын
Dialogue: 0,0:02:46.00,0:02:47.00,Default,,0,0,0,,Ешкім нәтижелерге сәйкес келмейді.
Dialogue: 0,0:02:47.00,0:02:49.00,Default,,0,0,0,,Сырғаларыңызды ашыңыз.
Dialogue: 0,0:02:49.00,0:02:52.00,Default,,0,0,0,,Алдымен тынышталыңыз
Dialogue: 0,0:02:52.00,0:02:55.00,Default,,0,0,0,,Open the door to a new life
Dialogue: 0,0:02:55.00,0:02:57.00,Default,,0,0,0,,Атта апай күш салды.
Dialogue: 0,0:02:57.00,0:02:59.00,Default,,0,0,0,,Ято өледі
Dialogue: 0,0:02:59.00,0:03:03.00,Default,,0,0,0,,I'm still mentally prepared to let go.
Dialogue: 0,0:03:03.00,0:03:07.00,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:03:07.00,0:03:09.00,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасадыңыз.
Dialogue: 0,0:03:09.00,0:03:11.00,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:03:11.00,0:03:13.00,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:03:14.00,0:03:15.00,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасадыңыз.
Dialogue: 0,0:03:21.00,0:03:24.00,Default,,0,0,0,,But it wouldn't have hurt that much.
Dialogue: 0,0:03:24.00,0:03:27.00,Default,,0,0,0,,Бұл туралы
Dialogue: 0,0:03:27.00,0:03:30.00,Default,,0,0,0,,Then open the other one too.
Dialogue: 0,0:03:31.00,0:03:33.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:03:33.00,0:03:36.00,Default,,0,0,0,,That's another time.
Dialogue: 0,0:03:36.00,0:03:38.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:43.00,0:03:44.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:44.00,0:03:46.00,Default,,0,0,0,,Let's go for a walk
Dialogue: 0,0:03:50.00,0:03:53.00,Default,,0,0,0,,You're more energetic than usual.
Dialogue: 0,0:03:53.00,0:03:55.00,Default,,0,0,0,,Мен бүгін біраз алысқа барамын.
Dialogue: 0,0:04:07.00,0:04:11.00,Default,,0,0,0,,Осы биік асуды қыздыратын адам қалмады ма?
Dialogue: 0,0:04:13.00,0:04:15.00,Default,,0,0,0,,What are these guys?
Dialogue: 0,0:04:19.00,0:04:23.00,Default,,0,0,0,,Ит пен бәйшешек өз әрекеттерімен маған қарсы шығады.
Dialogue: 0,0:04:24.00,0:04:26.00,Default,,0,0,0,,Сіз оны жалайсыз.
Dialogue: 0,0:04:28.00,0:04:30.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:04:30.00,0:04:32.00,Default,,0,0,0,,How absurd is this ring?
Dialogue: 0,0:04:32.00,0:04:34.00,Default,,0,0,0,,Өміріңе өкінбейтін ақымақсың ба?
Dialogue: 0,0:04:34.00,0:04:38.00,Default,,0,0,0,,Do you really trust machines that much?
Dialogue: 0,0:04:39.00,0:04:41.00,Default,,0,0,0,,But if the straight line ahead is
Dialogue: 0,0:04:41.00,0:04:43.00,Default,,0,0,0,,Машинаның өнімділігінде айырмашылық болуы керек
Dialogue: 0,0:04:44.00,0:04:46.00,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:04:47.00,0:04:49.00,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:04:49.00,0:04:53.00,Default,,0,0,0,,Денені толығымен еңкейту арқылы ауа кедергісін барынша азайтуға болады.
Dialogue: 0,0:04:54.00,0:04:55.00,Default,,0,0,0,,Even if it's a dog
Dialogue: 0,0:04:55.00,0:04:57.00,Default,,0,0,0,,Мен аң сияқтымын
Dialogue: 0,0:04:57.00,0:04:59.00,Default,,0,0,0,,Мен
Dialogue: 0,0:05:01.00,0:05:03.00,Default,,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:05:09.00,0:05:12.00,Default,,0,0,0,,Bananas taste even better after exercise
Dialogue: 0,0:05:18.00,0:05:20.00,Default,,0,0,0,,Okay, I helped you now.
Dialogue: 0,0:05:21.00,0:05:23.00,Default,,0,0,0,,Бәріміз ойнайық
Dialogue: 0,0:05:23.00,0:05:25.00,Default,,0,0,0,,А Йошико
Dialogue: 0,0:05:25.00,0:05:28.00,Default,,0,0,0,,That reminds me of Mika-chan
Dialogue: 0,0:05:28.00,0:05:30.00,Default,,0,0,0,,Yoshiko-neechan can go now.
Dialogue: 0,0:05:31.00,0:05:33.00,Default,,0,0,0,,Маған Мика-чан ұнайды
Dialogue: 0,0:05:33.00,0:05:34.00,Default,,0,0,0,,Бала?
Dialogue: 0,0:05:34.00,0:05:35.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:35.00,0:05:36.00,Default,,0,0,0,,Ересек
Dialogue: 0,0:05:37.00,0:05:38.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:38.00,0:05:39.00,Default,,0,0,0,,Майкл
Dialogue: 0,0:05:39.00,0:05:40.00,Default,,0,0,0,,Мика-чан
Dialogue: 0,0:05:40.00,0:05:42.00,Default,,0,0,0,,Бүгін де сүйкімді көрінесің
Dialogue: 0,0:05:42.00,0:05:43.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:43.00,0:05:46.00,Default,,0,0,0,,Михайды мұндай сөздермен азғырудың мақсаты не?
Dialogue: 0,0:05:46.00,0:05:47.00,Default,,0,0,0,,Ақша
Dialogue: 0,0:05:47.00,0:05:49.00,Default,,0,0,0,,Миханың денесі
Dialogue: 0,0:05:49.00,0:05:50.00,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:05:50.00,0:05:52.00,Default,,0,0,0,,Мақсаты маңызды емес
Dialogue: 0,0:05:52.00,0:05:54.00,Default,,0,0,0,,Әлі де Миха
Dialogue: 0,0:05:54.00,0:05:56.00,Default,,0,0,0,,Енді менің сүйікті болғым келеді
Dialogue: 0,0:05:56.00,0:05:58.00,Default,,0,0,0,,Мика-чанға не болды?
Dialogue: 0,0:05:58.00,0:06:00.00,Default,,0,0,0,,Мен сені шын сүйемін
Dialogue: 0,0:06:00.00,0:06:01.00,Default,,0,0,0,,Ах.
Dialogue: 0,0:06:01.00,0:06:04.00,Default,,0,0,0,,Миканың қандай әйел екенін білесіз бе?
Dialogue: 0,0:06:04.00,0:06:06.00,Default,,0,0,0,,Мика-чан, мен білмеймін.
Dialogue: 0,0:06:06.00,0:06:08.00,Default,,0,0,0,,Мен түсінбеймін, бірақ бәрібір
Dialogue: 0,0:06:08.00,0:06:10.00,Default,,0,0,0,,Майкл орынды.
Dialogue: 0,0:06:10.00,0:06:12.00,Default,,0,0,0,,Майкл
Dialogue: 0,0:06:12.00,0:06:14.00,Default,,0,0,0,,Шорои Мика-чан
Dialogue: 0,0:06:14.00,0:06:16.00,Default,,0,0,0,,Мика ақыры бақытты бола алады
Dialogue: 0,0:06:16.00,0:06:18.00,Default,,0,0,0,,Мика-чан
Dialogue: 0,0:06:18.00,0:06:20.00,Default,,0,0,0,,Сол жерде ойнайық
Dialogue: 0,0:06:20.00,0:06:22.00,Default,,0,0,0,,That's right.
Dialogue: 0,0:06:24.00,0:06:26.00,Default,,0,0,0,,Майкл
Dialogue: 0,0:06:26.00,0:06:28.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:28.00,0:06:30.00,Default,,0,0,0,,Майклға жауап беріңіз
Dialogue: 0,0:06:30.00,0:06:32.00,Default,,0,0,0,,Рөл
Dialogue: 0,0:06:32.00,0:06:34.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:34.00,0:06:36.00,Default,,0,0,0,,Кел
Dialogue: 0,0:06:36.00,0:06:38.00,Default,,0,0,0,,...
Dialogue: 0,0:06:38.00,0:06:40.00,Default,,0,0,0,,Жасаңыз
Dialogue: 0,0:06:40.00,0:06:42.00,Default,,0,0,0,,Ичизаки мырза
Dialogue: 0,0:06:42.00,0:06:44.00,Default,,0,0,0,,Мен оны Яцузаки жасаймын.
Dialogue: 0,0:06:44.00,0:06:46.00,Default,,0,0,0,,Мика-чан, мұнда кел.
Dialogue: 0,0:06:46.00,0:06:48.00,Default,,0,0,0,,Тозаққа түсу
Dialogue: 0,0:06:50.00,0:06:52.00,Default,,0,0,0,,Хисацу Мика-чан өлтіруші
Dialogue: 0,0:06:52.00,0:06:54.00,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:06:58.00,0:07:00.00,Default,,0,0,0,,Ия
Dialogue: 0,0:07:00.00,0:07:02.00,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:07:02.00,0:07:04.00,Default,,0,0,0,,Мен Мика осылай болғанша интернетті пайдалана бергеніме сене алар емеспін.
Dialogue: 0,0:07:04.00,0:07:06.00,Default,,0,0,0,,Жоқ, мен шешіп тастадым.
Dialogue: 0,0:07:06.00,0:07:08.00,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:07:08.00,0:07:10.00,Default,,0,0,0,,Не?
Dialogue: 0,0:07:10.00,0:07:12.00,Default,,0,0,0,,Бірақ сен менің денемді жақсы көрсең де
Dialogue: 0,0:07:12.00,0:07:14.00,Default,,0,0,0,,Жүрек бұл
Dialogue: 0,0:07:14.00,0:07:16.00,Default,,0,0,0,,Өйткені ол Майклға тиесілі болды
Dialogue: 0,0:07:16.00,0:07:18.00,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:07:18.00,0:07:20.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:20.00,0:07:22.00,Default,,0,0,0,,Майкл
Dialogue: 0,0:07:22.00,0:07:24.00,Default,,0,0,0,,Оны жайына қалдырайық
Dialogue: 0,0:07:24.00,0:07:26.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:26.00,0:07:28.00,Default,,0,0,0,,Сен неге Миканың денесіне де қызықпайсың?
Dialogue: 0,0:07:28.00,0:07:30.00,Default,,0,0,0,,Мазасыз Мика Чан
Dialogue: 0,0:07:30.00,0:07:32.00,Default,,0,0,0,,Енді бітті
Dialogue: 0,0:07:32.00,0:07:34.00,Default,,0,0,0,,Барлығы
Dialogue: 0,0:07:34.00,0:07:36.00,Default,,0,0,0,,Әйел ретінде
Dialogue: 0,0:07:36.00,0:07:38.00,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:07:38.00,0:07:40.00,Default,,0,0,0,,Ашсың ба? Міне, Майкл мен Принс
Dialogue: 0,0:07:42.00,0:07:44.00,Default,,0,0,0,,Майкл
Dialogue: 0,0:07:44.00,0:07:46.00,Default,,0,0,0,,Менімен бірге тұрайық
Dialogue: 0,0:07:46.00,0:07:48.00,Default,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:07:48.00,0:07:50.00,Default,,0,0,0,,Неліктен сіз өлі болуыңыз керек?
Dialogue: 0,0:07:52.00,0:07:54.00,Default,,0,0,0,,Сіз неше рет оралдыңыз?
Dialogue: 0,0:07:54.00,0:07:56.00,Default,,0,0,0,,Майкл
Dialogue: 0,0:07:56.00,0:07:58.00,Default,,0,0,0,,Тиісті.
Dialogue: 0,0:08:12.00,0:08:14.00,Default,,0,0,0,,Жаман адаммен қалай тереңірек қарым-қатынаста болу керек
Dialogue: 0,0:08:14.00,0:08:16.00,Default,,0,0,0,,Біріншіден, сіз отбасыңызбен тіл табысуыңыз керек.
Dialogue: 0,0:08:18.00,0:08:20.00,Default,,0,0,0,,Мен әпкемді жақсы көремін
Dialogue: 0,0:08:20.00,0:08:22.00,Default,,0,0,0,,Бауырыңа үйлен
Dialogue: 0,0:08:22.00,0:08:24.00,Default,,0,0,0,,Нағыз әпке бол
Dialogue: 0,0:08:24.00,0:08:26.00,Default,,0,0,0,,Қазір әлі ерте.
Dialogue: 0,0:08:28.00,0:08:30.00,Default,,0,0,0,,Тұрмысқа қашан шығу керек
Dialogue: 0,0:08:30.00,0:08:32.00,Default,,0,0,0,,Қазір
Dialogue: 0,0:08:32.00,0:08:34.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:34.00,0:08:36.00,Default,,0,0,0,,Мен 0 ұпаймен күйзеліп жүрген сіңілімді ақырын жігерлендіремін.
Dialogue: 0,0:08:36.00,0:08:38.00,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:08:38.00,0:08:40.00,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:40.00,0:08:42.00,Default,,0,0,0,,Сіз Ханабатәке-санның нағашысысыз.
Dialogue: 0,0:08:42.00,0:08:44.00,Default,,0,0,0,,Менің көкірекшем әп-сәтте шешілді.
Dialogue: 0,0:08:44.00,0:08:46.00,Default,,0,0,0,,Қандай күш
Dialogue: 0,0:08:46.00,0:08:48.00,Default,,0,0,0,,Менің ойымша, сен ол қызбен араласуға тырысып жатырсың.
Dialogue: 0,0:08:48.00,0:08:50.00,Default,,0,0,0,,Сен
Dialogue: 0,0:08:50.00,0:08:52.00,Default,,0,0,0,,Сен
Dialogue: 0,0:08:52.00,0:08:54.00,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:54.00,0:08:56.00,Default,,0,0,0,,Менің ойымша, сіз оған бірден кірісуді жоспарлап отырсыз.
Dialogue: 0,0:08:56.00,0:08:58.00,Default,,0,0,0,,Менің ойымша, сіз оған бірден кірісуді жоспарлап отырсыз.
Dialogue: 0,0:08:58.00,0:09:00.00,Default,,0,0,0,,Менің ойымша, сіз оны бірден пайдалануды жоспарлап отырсыз.
Dialogue: 0,0:09:00.00,0:09:02.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:02.00,0:09:04.00,Default,,0,0,0,,Апай
Dialogue: 0,0:09:04.00,0:09:06.00,Default,,0,0,0,,О, Рури-чан
Dialogue: 0,0:09:06.00,0:09:08.00,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:09:08.00,0:09:10.00,Default,,0,0,0,,Сондай-ақ 0 ұпаймен
Dialogue: 0,0:09:10.00,0:09:12.00,Default,,0,0,0,,Мен мұны үнемі айтамын.
Dialogue: 0,0:09:12.00,0:09:14.00,Default,,0,0,0,,Сіз мұны міндетті түрде орындай аласыз.
Dialogue: 0,0:09:14.00,0:09:16.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:16.00,0:09:18.00,Default,,0,0,0,,Апай әрқашан мейірімді
Dialogue: 0,0:09:18.00,0:09:20.00,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:09:20.00,0:09:22.00,Default,,0,0,0,,Ол шынымен қорқынышты адам.
Dialogue: 0,0:09:22.00,0:09:24.00,Default,,0,0,0,,Е, сенің әпкең кім?
Dialogue: 0,0:09:24.00,0:09:26.00,Default,,0,0,0,,Бұл сіздің зұлым аңдыушы.
Dialogue: 0,0:09:26.00,0:09:28.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:09:28.00,0:09:30.00,Default,,0,0,0,,Сондай нәзік ағайынға
Dialogue: 0,0:09:30.00,0:09:32.00,Default,,0,0,0,,Неліктен мұндай адам бар?
Dialogue: 0,0:09:32.00,0:09:34.00,Default,,0,0,0,,Агуцукун біртүрлі екен
Dialogue: 0,0:09:34.00,0:09:36.00,Default,,0,0,0,,Бұл дос емес, суық
Dialogue: 0,0:09:36.00,0:09:38.00,Default,,0,0,0,,Бұл адам қауіпті көрінеді
Dialogue: 0,0:09:38.00,0:09:40.00,Default,,0,0,0,,Түсінбеушілік, шын мәнінде қауіпті нәрсе
Dialogue: 0,0:09:40.00,0:09:42.00,Default,,0,0,0,,Бұл ханым
Dialogue: 0,0:09:44.00,0:09:46.00,Default,,0,0,0,,Ақылға қонымды экспозицияшы сөзі
Dialogue: 0,0:09:46.00,0:09:48.00,Default,,0,0,0,,Рури-чан бұған сене ме?
Dialogue: 0,0:09:48.00,0:09:50.00,Default,,0,0,0,,Менің астымда
Dialogue: 0,0:09:50.00,0:09:52.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:52.00,0:09:54.00,Default,,0,0,0,,Бюстгалтер ілмегін қалай алып тастау керек
Dialogue: 0,0:09:54.00,0:09:56.00,Default,,0,0,0,,Жинақтамау
Dialogue: 0,0:09:56.00,0:09:58.00,Default,,0,0,0,,Менің назарым дененің жоғарғы бөлігіне ауды.
Dialogue: 0,0:09:58.00,0:10:00.00,Default,,0,0,0,,Аз сергек төменгі денеден
Dialogue: 0,0:10:00.00,0:10:02.00,Default,,0,0,0,,Сен менің трусигімді ұрладың.
Dialogue: 0,0:10:02.00,0:10:04.00,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:10:04.00,0:10:06.00,Default,,0,0,0,,Аңдалу салдарынан болатын әсер ету
Dialogue: 0,0:10:06.00,0:10:08.00,Default,,0,0,0,,Мен әлі күнге дейін миым ашылды
Dialogue: 0,0:10:08.00,0:10:10.00,Default,,0,0,0,,Бір сәтте алып кеттің.
Dialogue: 0,0:10:10.00,0:10:12.00,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:10:12.00,0:10:14.00,Default,,0,0,0,,Мына ақымақ
Dialogue: 0,0:10:14.00,0:10:16.00,Default,,0,0,0,,Менен аулақ жүр бұзық
Dialogue: 0,0:10:16.00,0:10:18.00,Default,,0,0,0,,Маған шалбарымды қайтар
Dialogue: 0,0:10:18.00,0:10:20.00,Default,,0,0,0,,Бұл сұмдық
Dialogue: 0,0:10:20.00,0:10:22.00,Default,,0,0,0,,Ол өзгерді.
Dialogue: 0,0:10:32.00,0:10:34.00,Default,,0,0,0,,Бұл екеуі кім?
Dialogue: 0,0:10:34.00,0:10:36.00,Default,,0,0,0,,Менің жазам
Dialogue: 0,0:10:36.00,0:10:38.00,Default,,0,0,0,,Жирендіңіз бе?
Dialogue: 0,0:10:38.00,0:10:40.00,Default,,0,0,0,,Өйткені
Dialogue: 0,0:10:40.00,0:10:42.00,Default,,0,0,0,,Мен сенің махаббатыңды қалаймын
Dialogue: 0,0:10:42.00,0:10:44.00,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:10:44.00,0:10:46.00,Default,,0,0,0,,Камусумега
Dialogue: 0,0:10:48.00,0:10:50.00,Default,,0,0,0,,Жүр, Рури-чанға қара.
Dialogue: 0,0:10:50.00,0:10:52.00,Default,,0,0,0,,Бұл жігіт труси кимейтін көрмеші.
Dialogue: 0,0:10:52.00,0:10:54.00,Default,,0,0,0,,Дәлелдемелер
Dialogue: 0,0:10:54.00,0:10:56.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:10:56.00,0:10:58.00,Default,,0,0,0,,Міне!
Dialogue: 0,0:10:58.00,0:11:00.00,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:11:00.00,0:11:02.00,Default,,0,0,0,,Ноаааааааааааааааааааааа
Dialogue: 0,0:11:02.00,0:11:04.00,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:11:04.00,0:11:06.00,Default,,0,0,0,,Yes
Dialogue: 0,0:11:12.00,0:11:14.00,Default,,0,0,0,,Шалбарыңызды кигеніңізге көз жеткізіңіз
Dialogue: 0,0:11:14.00,0:11:16.00,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:11:16.00,0:11:18.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:18.00,0:11:20.00,Default,,0,0,0,,Солай болуы керек.
Dialogue: 0,0:11:22.00,0:11:24.00,Default,,0,0,0,,кию
Dialogue: 0,0:11:24.00,0:11:26.00,Default,,0,0,0,,Неліктен жер бетінде?
Dialogue: 0,0:11:26.00,0:11:28.00,Default,,0,0,0,,Менің бөксем өте тегіс.
Dialogue: 0,0:11:28.00,0:11:30.00,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:30.00,0:11:32.00,Default,,0,0,0,,Жоқ, сен
Dialogue: 0,0:11:34.00,0:11:36.00,Default,,0,0,0,,Руридің трусисын аяғыңмен жұлып ал
Dialogue: 0,0:11:36.00,0:11:38.00,Default,,0,0,0,,Ал егер сіз оны кисеңіз де, оны шешуге болады.
Dialogue: 0,0:11:38.00,0:11:40.00,Default,,0,0,0,,айтасыз ба
Dialogue: 0,0:11:40.00,0:11:42.00,Default,,0,0,0,,Мені байқаған сәтте
Dialogue: 0,0:11:46.00,0:11:48.00,Default,,0,0,0,,Мен де
Dialogue: 0,0:11:48.00,0:11:50.00,Default,,0,0,0,,Маған аздап қайта даярлау керек.
Dialogue: 0,0:11:50.00,0:11:52.00,Default,,0,0,0,,Есеп айырысу
Dialogue: 0,0:11:52.00,0:11:54.00,Default,,0,0,0,,Мен оны бір күні қоямын
Dialogue: 0,0:12:00.00,0:12:02.00,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:12:02.00,0:12:04.00,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:12:04.00,0:12:06.00,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:12:06.00,0:12:08.00,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:12:08.00,0:12:10.00,Default,,0,0,0,,Тақырып
Dialogue: 0,0:12:10.00,0:12:12.00,Default,,0,0,0,,Тақырып
Dialogue: 0,0:12:12.00,0:12:14.00,Default,,0,0,0,,Тақырып
Dialogue: 0,0:12:14.00,0:12:16.00,Default,,0,0,0,,Тақырып
Dialogue: 0,0:12:16.00,0:12:18.00,Default,,0,0,0,,Тақырып
Dialogue: 0,0:12:18.00,0:12:20.00,Default,,0,0,0,,Тақырып
Dialogue: 0,0:12:20.00,0:12:22.00,Default,,0,0,0,,Тай тілі
Dialogue: 0,0:12:22.00,0:12:24.00,Default,,0,0,0,,Тайланд
Dialogue: 0,0:12:24.00,0:12:26.00,Default,,0,0,0,,Мен қалаймын
Dialogue: 0,0:12:26.00,0:12:28.00,Default,,0,0,0,,Тайланд
Dialogue: 0,0:12:28.00,0:12:30.00,Default,,0,0,0,,Мен бәрібір жақсы боламын. Бар күшімді саламын
Dialogue: 0,0:12:30.00,0:12:32.00,Default,,0,0,0,,Тайланд
Dialogue: 0,0:12:32.00,0:12:34.00,Default,,0,0,0,,Бай
Dialogue: 0,0:12:34.00,0:12:36.00,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:12:37.50,0:12:43.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory