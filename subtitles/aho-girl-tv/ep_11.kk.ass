Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:30.00,0:00:36.00,Default,,0,0,0,,Махаббатты аңсайтын келешегі бар жазғы демалыс
Dialogue: 0,0:00:36.00,0:00:39.00,Default,,0,0,0,,Толық күшке жүгіну
Dialogue: 0,0:00:39.00,0:00:42.00,Default,,0,0,0,,Еңбегіңізге рахмет, анашым
Dialogue: 0,0:00:42.00,0:00:47.00,Default,,0,0,0,,Сұлу болып көрінбейтін баурап алатын махаббат хикаясы
Dialogue: 0,0:00:47.00,0:00:50.00,Default,,0,0,0,,Darling High Love
Dialogue: 0,0:00:51.00,0:00:54.00,Default,,0,0,0,,Басталғалы тұрған таң қалдыратын аниме таң қалдырады.
Dialogue: 0,0:00:54.00,0:00:59.00,Default,,0,0,0,,Анам - Яшон
Dialogue: 0,0:01:01.00,0:01:07.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:07.00,0:01:11.00,Default,,0,0,0,,Мама Мама – Яшон
Dialogue: 0,0:01:11.00,0:01:12.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:12.00,0:01:14.00,Default,,0,0,0,,Ри-чан көңіл-күйіңізді көтереді!
Dialogue: 0,0:01:14.00,0:01:18.00,Default,,0,0,0,,Йошико! Сіз оқуда жақсы болмасаңыз да, сіз әлі де көп нәрсе жасай аласыз!
Dialogue: 0,0:01:18.00,0:01:20.00,Default,,0,0,0,,Мысалы, не?
Dialogue: 0,0:01:20.00,0:01:22.00,Default,,0,0,0,,Мама – Яшон
Dialogue: 0,0:01:22.00,0:01:23.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:23.00,0:01:25.00,Default,,0,0,0,,Бұл туралы ойланыңыз!
Dialogue: 0,0:01:25.00,0:01:27.00,Default,,0,0,0,,Сонымен, сіз не істей аласыз?
Dialogue: 0,0:01:27.00,0:01:29.00,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:01:29.00,0:01:32.00,Default,,0,0,0,,Мен оқудан басқа көп нәрсе істеген жоқпын...
Dialogue: 0,0:01:32.00,0:01:34.00,Default,,0,0,0,,Бірақ мен оқи алмаймын ба?
Dialogue: 0,0:01:36.00,0:01:38.00,Default,,0,0,0,,Не? Мен қиыншылыққа тап болдым ба?
Dialogue: 0,0:01:38.00,0:01:40.00,Default,,0,0,0,,Әртүрлі нәрселерді қолданып көрейік!
Dialogue: 0,0:01:40.00,0:01:41.00,Default,,0,0,0,,Ас әзірлеу!
Dialogue: 0,0:01:41.00,0:01:42.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:42.00,0:01:43.00,Default,,0,0,0,,Ең жақсы!
Dialogue: 0,0:01:43.00,0:01:44.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:44.00,0:01:45.00,Default,,0,0,0,,Сурет!
Dialogue: 0,0:01:45.00,0:01:46.00,Default,,0,0,0,,Темір шыбық!
Dialogue: 0,0:01:46.00,0:01:47.00,Default,,0,0,0,,Тірі ұшу!
Dialogue: 0,0:01:47.00,0:01:49.00,Default,,0,0,0,,Велосипед!
Dialogue: 0,0:01:51.00,0:01:53.00,Default,,0,0,0,,Бұл көзқарасты тоқтатыңыз!
Dialogue: 0,0:01:54.00,0:01:56.00,Default,,0,0,0,,Дәлірек айтсам, мен...
Dialogue: 0,0:01:56.00,0:01:58.00,Default,,0,0,0,,Сіз мұндай ештеңе жасай алмадыңыз ба?
Dialogue: 0,0:01:58.00,0:02:01.00,Default,,0,0,0,,Менің тірі жүргеніме 11 жыл болды...ештеңе...
Dialogue: 0,0:02:03.00,0:02:05.00,Default,,0,0,0,,Сурья!
Dialogue: 0,0:02:05.00,0:02:07.00,Default,,0,0,0,,Мен оған түстім!
Dialogue: 0,0:02:07.00,0:02:09.00,Default,,0,0,0,,Кез келген адам міне алады!
Dialogue: 0,0:02:10.00,0:02:12.00,Default,,0,0,0,,Кем дегенде бір нәрсе!
Dialogue: 0,0:02:12.00,0:02:14.00,Default,,0,0,0,,Мен жарайды, Йошико дегенше сөйлеме!
Dialogue: 0,0:02:14.00,0:02:16.00,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:02:16.00,0:02:18.00,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:02:18.00,0:02:20.00,Default,,0,0,0,,Ах, Донбо...
Dialogue: 0,0:02:21.00,0:02:22.00,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,0:02:22.00,0:02:24.00,Default,,0,0,0,,Тоқта, күт!
Dialogue: 0,0:02:25.00,0:02:27.00,Default,,0,0,0,,Енді біз бұдан былай сөйлесе алмаймыз!
Dialogue: 0,0:02:27.00,0:02:28.00,Default,,0,0,0,,О!
Dialogue: 0,0:02:28.00,0:02:30.00,Default,,0,0,0,,Ахахахаха!
Dialogue: 0,0:02:31.00,0:02:34.00,Default,,0,0,0,,Иә, бұл жақсы сезінеді!
Dialogue: 0,0:02:39.00,0:02:41.00,Default,,0,0,0,,Маған қара!
Dialogue: 0,0:02:41.00,0:02:43.00,Default,,0,0,0,,Милли-чан тоз-тоз болып қалды!
Dialogue: 0,0:02:43.00,0:02:44.00,Default,,0,0,0,,Бұл сен кінәлісің!
Dialogue: 0,0:02:44.00,0:02:46.00,Default,,0,0,0,,Мен мұны жалғыз істей аламын!
Dialogue: 0,0:02:46.00,0:02:47.00,Default,,0,0,0,,Бұл өте ақылға қонымсыз!
Dialogue: 0,0:02:47.00,0:02:49.00,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:02:49.00,0:02:51.00,Default,,0,0,0,,Жеңсек те, шашырамаймыз!
Dialogue: 0,0:02:51.00,0:02:53.00,Default,,0,0,0,,Милли-чан!
Dialogue: 0,0:02:53.00,0:02:55.00,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:02:56.00,0:02:58.00,Default,,0,0,0,,Алдымен...
Dialogue: 0,0:02:58.00,0:03:00.00,Default,,0,0,0,,Қолыңнан келмесе де, жеңесің.
Dialogue: 0,0:03:03.00,0:03:05.00,Default,,0,0,0,,Қанша рет сәтсіздікке ұшырасам да...
Dialogue: 0,0:03:05.00,0:03:07.00,Default,,0,0,0,,Егер сіз мұны істей берсеңіз...
Dialogue: 0,0:03:07.00,0:03:08.00,Default,,0,0,0,,Бір күні!
Dialogue: 0,0:03:08.00,0:03:09.00,Default,,0,0,0,,Сөзсіз!
Dialogue: 0,0:03:09.00,0:03:11.00,Default,,0,0,0,,Сіз де оқыңыз!
Dialogue: 0,0:03:11.00,0:03:13.00,Default,,0,0,0,,Мен мұны бір күні істей аламын!
Dialogue: 0,0:03:19.00,0:03:21.00,Default,,0,0,0,,Мен жүздеген рет құладым...
Dialogue: 0,0:03:21.00,0:03:23.00,Default,,0,0,0,,Қандай батылдық!
Dialogue: 0,0:03:23.00,0:03:25.00,Default,,0,0,0,,Ештеңе істей алмай...
Dialogue: 0,0:03:25.00,0:03:27.00,Default,,0,0,0,,Бұл бітпейді!
Dialogue: 0,0:03:27.00,0:03:29.00,Default,,0,0,0,,Мен байсалдымын!
Dialogue: 0,0:03:29.00,0:03:31.00,Default,,0,0,0,,Мен саған көрсетемін!
Dialogue: 0,0:03:34.00,0:03:35.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:35.00,0:03:37.00,Default,,0,0,0,,Рури-чан!
Dialogue: 0,0:03:39.00,0:03:41.00,Default,,0,0,0,,Мен тіпті велосипед тете алмаймын...
Dialogue: 0,0:03:41.00,0:03:43.00,Default,,0,0,0,,Мен күлуім керек...
Dialogue: 0,0:03:44.00,0:03:45.00,Default,,0,0,0,,Күлме!
Dialogue: 0,0:03:45.00,0:03:47.00,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:03:47.00,0:03:48.00,Default,,0,0,0,,Мүлдем...
Dialogue: 0,0:03:48.00,0:03:51.00,Default,,0,0,0,,Мен үйге мүлдем бармайынша бармаймын!
Dialogue: 0,0:03:51.00,0:03:53.00,Default,,0,0,0,,О! Бұл керемет!
Dialogue: 0,0:03:54.00,0:03:55.00,Default,,0,0,0,,Рури-чан...
Dialogue: 0,0:03:55.00,0:03:58.00,Default,,0,0,0,,Сіз әлемдегі ең еңбекқорсыз!
Dialogue: 0,0:04:01.00,0:04:02.00,Default,,0,0,0,,Йошико…
Dialogue: 0,0:04:02.00,0:04:04.00,Default,,0,0,0,,Ешқандай салдары болмаса да!
Dialogue: 0,0:04:04.00,0:04:05.00,Default,,0,0,0,,Шулы!
Dialogue: 0,0:04:06.00,0:04:08.00,Default,,0,0,0,,Йошико ешқашан жеңілмейді!
Dialogue: 0,0:04:10.00,0:04:11.00,Default,,0,0,0,,Бұл — бір сәт бұрынғы Итадори ешқашан жасамайтын қимыл
Dialogue: 0,0:04:11.00,0:04:13.00,Default,,0,0,0,,Сенің қолыңнан келетініне сенімдімін...
Dialogue: 0,0:04:17.00,0:04:18.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:18.00,0:04:19.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:19.00,0:04:21.00,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:04:22.00,0:04:24.00,Default,,0,0,0,,Не болды? Бұл...
Dialogue: 0,0:04:24.00,0:04:28.00,Default,,0,0,0,,Тұтас банан мен самбо қолданылған жаңадан шығарылған өнім
Dialogue: 0,0:04:28.00,0:04:31.00,Default,,0,0,0,,Банан фропучино люкс...
Dialogue: 0,0:04:31.00,0:04:34.00,Default,,0,0,0,,Барлық жерде сатылып кеткен...
Dialogue: 0,0:04:34.00,0:04:36.00,Default,,0,0,0,,Олай болса мені де тап! Мен саған көмектесемін!
Dialogue: 0,0:04:36.00,0:04:37.00,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:04:37.00,0:04:38.00,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:04:38.00,0:04:39.00,Default,,0,0,0,,Бейтаныс!
Dialogue: 0,0:04:39.00,0:04:41.00,Default,,0,0,0,,Бұл – қоғамның саласы!
Dialogue: 0,0:04:48.00,0:04:51.00,Default,,0,0,0,,А, мұнда да жақсы емес...
Dialogue: 0,0:04:51.00,0:04:53.00,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:53.00,0:04:55.00,Default,,0,0,0,,Рюичи?!
Dialogue: 0,0:04:56.00,0:04:58.00,Default,,0,0,0,,Не болды!?
Dialogue: 0,0:04:58.00,0:04:59.00,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:04:59.00,0:05:02.00,Default,,0,0,0,,Келесі қаладағы банан фропучино люксі
Dialogue: 0,0:05:02.00,0:05:04.00,Default,,0,0,0,,Мен көп нәрсені таптым...
Dialogue: 0,0:05:04.00,0:05:05.00,Default,,0,0,0,,Не!?
Dialogue: 0,0:05:05.00,0:05:09.00,Default,,0,0,0,,Сол аймақты басқаратын көп адамдар да іздеген сияқты.
Dialogue: 0,0:05:09.00,0:05:12.00,Default,,0,0,0,,Мен қатты қарсы тұрдым...
Dialogue: 0,0:05:12.00,0:05:14.00,Default,,0,0,0,,Олар да сондай жақсы...
Dialogue: 0,0:05:14.00,0:05:15.00,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:05:15.00,0:05:18.00,Default,,0,0,0,,Мен ағамның бақытты болуын қаладым...
Dialogue: 0,0:05:18.00,0:05:20.00,Default,,0,0,0,,Өте өкінішті!
Dialogue: 0,0:05:20.00,0:05:22.00,Default,,0,0,0,,Олар бір жұтым алды.
Dialogue: 0,0:05:22.00,0:05:25.00,Default,,0,0,0,,Бұл жай ғана банан, оның дәмі соншалықты керемет емес.
Dialogue: 0,0:05:25.00,0:05:28.00,Default,,0,0,0,,Оны менің алдымда лақтыр!
Dialogue: 0,0:05:29.00,0:05:30.00,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:05:30.00,0:05:33.00,Default,,0,0,0,,Мен бұл өкінішті түсінемін ...
Dialogue: 0,0:05:33.00,0:05:36.00,Default,,0,0,0,,Біздің сүйікті банандарымызды мазақ етті...
Dialogue: 0,0:05:36.00,0:05:37.00,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:05:37.00,0:05:40.00,Default,,0,0,0,,Тәтті тағам, мысалы, оның дәмін көрмей, лақтырып тастау.
Dialogue: 0,0:05:40.00,0:05:42.00,Default,,0,0,0,,Мен сені кешіре алмаймын...
Dialogue: 0,0:05:42.00,0:05:43.00,Default,,0,0,0,,Ум...
Dialogue: 0,0:05:43.00,0:05:46.00,Default,,0,0,0,,Рюичи-кунның кеудесін міндетті түрде төлеңіз...
Dialogue: 0,0:05:46.00,0:05:48.00,Default,,0,0,0,,Эй, күте тұрыңыз...
Dialogue: 0,0:05:49.00,0:05:51.00,Default,,0,0,0,,Ол жоғалып кетті...
Dialogue: 0,0:05:52.00,0:05:53.00,Default,,0,0,0,,А, бұл!?
Dialogue: 0,0:05:53.00,0:05:57.00,Default,,0,0,0,,Мен банандарға мүлдем мән бермеймін...
Dialogue: 0,0:06:04.00,0:06:06.00,Default,,0,0,0,,Бұрынғы жігіт шынымен де мұны істей алады!
Dialogue: 0,0:06:06.00,0:06:09.00,Default,,0,0,0,,Мен Судо мырзаға қарсы шықтым, өйткені мен сол банан шырынын алғым келді.
Dialogue: 0,0:06:09.00,0:06:11.00,Default,,0,0,0,,Судо Теме және басқалардың басшысы ма?
Dialogue: 0,0:06:11.00,0:06:12.00,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:06:12.00,0:06:13.00,Default,,0,0,0,,Не деген...
Dialogue: 0,0:06:16.00,0:06:18.00,Default,,0,0,0,,У және дәм...
Dialogue: 0,0:06:20.00,0:06:21.00,Default,,0,0,0,,Сәлем, Теме!
Dialogue: 0,0:06:22.00,0:06:24.00,Default,,0,0,0,,Sudo бұл...
Dialogue: 0,0:06:24.00,0:06:25.00,Default,,0,0,0,,Ол қайда!?
Dialogue: 0,0:06:28.00,0:06:29.00,Default,,0,0,0,,Судо мырза!
Dialogue: 0,0:06:29.00,0:06:30.00,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:06:30.00,0:06:33.00,Default,,0,0,0,,Ертерек ұрған жігіттің досы кек алып жатыр!
Dialogue: 0,0:06:33.00,0:06:34.00,Default,,0,0,0,,Не?
Dialogue: 0,0:06:34.00,0:06:35.00,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:35.00,0:06:36.00,Default,,0,0,0,,Тақырып...
Dialogue: 0,0:06:36.00,0:06:38.00,Default,,0,0,0,,Sudo...
Dialogue: 0,0:06:38.00,0:06:39.00,Default,,0,0,0,,не үшін шайқасып жүрсің?
Dialogue: 0,0:06:39.00,0:06:42.00,Default,,0,0,0,,Мен сол жігіттерді жеңгенім үшін өзімді жақсы сезінемін.
Dialogue: 0,0:06:42.00,0:06:43.00,Default,,0,0,0,,Әйел…
Dialogue: 0,0:06:43.00,0:06:44.00,Default,,0,0,0,,Бұл жігіттер...
Dialogue: 0,0:06:44.00,0:06:47.00,Default,,0,0,0,,Геспо Шитен күшті.
Dialogue: 0,0:06:48.00,0:06:49.00,Default,,0,0,0,,Уақытты босқа кетіру
Dialogue: 0,0:06:50.00,0:06:52.00,Default,,0,0,0,,Барлығыңызды күтіңіз.
Dialogue: 0,0:06:52.00,0:06:54.00,Default,,0,0,0,,Балалар...
Dialogue: 0,0:06:54.00,0:06:56.00,Default,,0,0,0,,Балалар...
Dialogue: 0,0:06:56.00,0:06:58.00,Default,,0,0,0,,Балалар...
Dialogue: 0,0:06:58.00,0:07:00.00,Default,,0,0,0,,Балалар...
Dialogue: 0,0:07:00.00,0:07:02.00,Default,,0,0,0,,Балалар...
Dialogue: 0,0:07:02.00,0:07:04.00,Default,,0,0,0,,Барлығы жиналады.
Dialogue: 0,0:07:05.00,0:07:06.00,Default,,0,0,0,,Алкоголь!
Dialogue: 0,0:07:32.00,0:07:33.00,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,0:07:33.00,0:07:34.00,Default,,0,0,0,,Бананның дәмділігі!
Dialogue: 0,0:07:34.00,0:07:36.00,Default,,0,0,0,,Есте сақта!
Dialogue: 0,0:07:40.00,0:07:41.00,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:07:41.00,0:07:42.00,Default,,0,0,0,,Қандай жігіт...
Dialogue: 0,0:07:42.00,0:07:44.00,Default,,0,0,0,,Теме ғана қалды
Dialogue: 0,0:07:46.00,0:07:48.00,Default,,0,0,0,,Ах! Мына жерде банан бар!
Dialogue: 0,0:07:48.00,0:07:49.00,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:07:50.00,0:07:51.00,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:07:51.00,0:07:52.00,Default,,0,0,0,,Өл!
Dialogue: 0,0:07:55.00,0:07:56.00,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:07:56.00,0:07:58.00,Default,,0,0,0,,Сіз дәл қазір не істедіңіз?
Dialogue: 0,0:08:02.00,0:08:04.00,Default,,0,0,0,,Аккунның соққысы...
Dialogue: 0,0:08:04.00,0:08:06.00,Default,,0,0,0,,Бұл бұдан 100 есе тиімді.
Dialogue: 0,0:08:16.00,0:08:17.00,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:08:17.00,0:08:19.00,Default,,0,0,0,,Баяу ләззат алыңыз
Dialogue: 0,0:08:26.00,0:08:28.00,Default,,0,0,0,,Мен кек алдым...
Dialogue: 0,0:08:29.00,0:08:31.00,Default,,0,0,0,,Банан фропучино люкс…
Dialogue: 0,0:08:33.00,0:08:34.00,Default,,0,0,0,,Сонымен!
Dialogue: 0,0:08:34.00,0:08:38.00,Default,,0,0,0,,Мен банандарға мүлдем мән бермеймін!
Dialogue: 0,0:08:45.00,0:08:46.00,Default,,0,0,0,,Қайырлы таң ит!
Dialogue: 0,0:08:47.00,0:08:51.00,Default,,0,0,0,,Ауа-райы жақсы, сондықтан мұндай күні мен мектепке бармай, серуендеуге шығуым мүмкін!
Dialogue: 0,0:08:51.00,0:08:54.00,Default,,0,0,0,,Мен мектепке барамын
Dialogue: 0,0:09:21.00,0:09:22.00,Default,,0,0,0,,Unarn!
Dialogue: 0,0:09:23.00,0:09:24.00,Default,,0,0,0,,Анан!
Dialogue: 0,0:09:38.00,0:09:39.00,Default,,0,0,0,,Сәлем, балақай!
Dialogue: 0,0:09:40.00,0:09:41.00,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:09:41.00,0:09:43.00,Default,,0,0,0,,Көмектесіңіз!
Dialogue: 0,0:09:43.00,0:09:45.00,Default,,0,0,0,,Жоқ! Осы қарқынмен сіз сыпырылып кетесіз!
Dialogue: 0,0:09:52.00,0:09:55.00,Default,,0,0,0,,Керемет! Сол ит! Сол қияр!
Dialogue: 0,0:09:58.00,0:09:59.00,Default,,0,0,0,,Мен саған көмектестім!
Dialogue: 0,0:10:01.00,0:10:02.00,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:10:11.00,0:10:12.00,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:10:21.00,0:10:23.00,Default,,0,0,0,,Балама ит шабуыл жасап жатыр!
Dialogue: 0,0:10:24.00,0:10:26.00,Default,,0,0,0,,Бұл ит біреуде бар!
Dialogue: 0,0:10:46.00,0:10:47.00,Default,,0,0,0,,Маған ақшаны беріңіз!
Dialogue: 0,0:10:51.00,0:10:52.00,Default,,0,0,0,,Саори, тыныш бол...
Dialogue: 0,0:10:53.00,0:10:54.00,Default,,0,0,0,,Шу шығармаңыз!
Dialogue: 0,0:10:57.00,0:10:58.00,Default,,0,0,0,,Мен сені бөлек өлтіремін.
Dialogue: 0,0:11:05.00,0:11:07.00,Default,,0,0,0,,Эй, ит! Сен не істеп жатырсың!
Dialogue: 0,0:11:12.00,0:11:13.00,Default,,0,0,0,,Не!?
Dialogue: 0,0:11:22.00,0:11:23.00,Default,,0,0,0,,Мен оны жеңдім!
Dialogue: 0,0:11:23.00,0:11:25.00,Default,,0,0,0,,Бұл ит керемет!
Dialogue: 0,0:11:30.00,0:11:32.00,Default,,0,0,0,,Саори, Лоу, бәрібір.
Dialogue: 0,0:11:40.00,0:11:42.00,Default,,0,0,0,,Маған сол гүлдерді бере аласыз ба?
Dialogue: 0,0:11:52.00,0:11:54.00,Default,,0,0,0,,Рахмет! Анн-чан!
Dialogue: 0,0:12:06.00,0:12:08.00,Default,,0,0,0,,Эй, мен білемін!
Dialogue: 0,0:12:08.00,0:12:11.00,Default,,0,0,0,,Кеше жақын жерде банк тонау болған сияқты!
Dialogue: 0,0:12:11.00,0:12:13.00,Default,,0,0,0,,Шынымды айтсам, бұл алаңдатады.
Dialogue: 0,0:12:13.00,0:12:16.00,Default,,0,0,0,,Бірақ олар тастап кеткен иттен жеңілді дейді!
Dialogue: 0,0:12:16.00,0:12:18.00,Default,,0,0,0,,Бұл сөзсіз өтірік
Dialogue: 0,0:12:21.00,0:12:25.00,Default,,0,0,0,,Келесі жолы кездесеміз! Ал ақымақ бар!
Dialogue: 0,0:12:26.50,0:12:32.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory