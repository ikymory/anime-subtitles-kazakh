Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:30.37,0:00:33.37,Default,,0,0,0,,Жылы үмітпен жазғы демалыс
Dialogue: 0,0:00:33.37,0:00:36.37,Default,,0,0,0,,Ғашық болсаң
Dialogue: 0,0:00:36.37,0:00:39.37,Default,,0,0,0,,Толық күшке жүгіну
Dialogue: 0,0:00:39.37,0:00:42.37,Default,,0,0,0,,Наносама еңбегіңіз үшін рахмет
Dialogue: 0,0:00:42.37,0:00:45.37,Default,,0,0,0,,Салқын және сиқырлы
Dialogue: 0,0:00:45.37,0:00:47.37,Default,,0,0,0,,Махаббат хикаясы
Dialogue: 0,0:00:47.37,0:00:50.37,Default,,0,0,0,,Қымбаттым мен сені сүйемін
Dialogue: 0,0:00:51.50,0:00:54.50,Default,,0,0,0,,Басталғалы тұрған таң қалдыратын аниме таң қалдырады.
Dialogue: 0,0:00:54.50,0:00:59.50,Default,,0,0,0,,Ма-ма-ма-ва-ясшоку
Dialogue: 0,0:01:03.50,0:01:05.50,Default,,0,0,0,,Жеңілген адам жын ба?
Dialogue: 0,0:01:05.50,0:01:06.50,Default,,0,0,0,,Джанкин
Dialogue: 0,0:01:06.50,0:01:07.50,Default,,0,0,0,,Поп!
Dialogue: 0,0:01:07.50,0:01:10.50,Default,,0,0,0,,А, мен жын ба?
Dialogue: 0,0:01:10.86,0:01:12.86,Default,,0,0,0,,Міне! Йошико!
Dialogue: 0,0:01:12.86,0:01:13.86,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:01:13.86,0:01:16.86,Default,,0,0,0,,Енді сені жын ұстайды!
Dialogue: 0,0:01:16.86,0:01:18.86,Default,,0,0,0,,Тек қаш!
Dialogue: 0,0:01:18.86,0:01:20.86,Default,,0,0,0,,Тоқта, күт!
Dialogue: 0,0:01:23.86,0:01:25.86,Default,,0,0,0,,Керемет! Жындар ше?
Dialogue: 0,0:01:26.86,0:01:28.86,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:01:28.86,0:01:31.86,Default,,0,0,0,,Фу, егер мен оны түсіндіруім керек болса.
Dialogue: 0,0:01:31.86,0:01:35.86,Default,,0,0,0,,Ол ойнауда шебер! Мен оны шынымен түсінбеймін, бірақ бұл керемет!
Dialogue: 0,0:01:35.86,0:01:38.86,Default,,0,0,0,,Бірақ сіз ересек болсаңыз да, жай ойнауға бола ма?
Dialogue: 0,0:01:38.86,0:01:40.86,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:01:41.86,0:01:44.86,Default,,0,0,0,,Сен мұнда не істеп жүрсің, ақымақ?
Dialogue: 0,0:01:44.86,0:01:47.86,Default,,0,0,0,,Өте өкінішті! Жаман шайтан осында!
Dialogue: 0,0:01:47.86,0:01:49.86,Default,,0,0,0,,Ібіліс? Барлығы қашады!
Dialogue: 0,0:01:49.86,0:01:51.86,Default,,0,0,0,,Сәлем! Мұнда!
Dialogue: 0,0:01:55.86,0:01:58.86,Default,,0,0,0,,Егер бұл жігіттің өміріне қауіп төніп тұрса, дереу жариялаңыз.
Dialogue: 0,0:01:58.86,0:02:00.86,Default,,0,0,0,,Осылай болыңыз!
Dialogue: 0,0:02:00.86,0:02:03.86,Default,,0,0,0,,Қарғыс атқыр, егер бұл орын алса, кері тесуге қарсы әрекет ету үшін бұрылысты пайдаланыңыз.
Dialogue: 0,0:02:03.86,0:02:06.86,Default,,0,0,0,,Оны секіру арқылы жеңіңіз!
Dialogue: 0,0:02:08.86,0:02:09.68,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,0:02:09.68,0:02:13.18,Default,,0,0,0,,Вааааааааааааааааааааааааааа
Dialogue: 0,0:02:13.18,0:02:15.68,Default,,0,0,0,,Жоқ, бұл қызық!
Dialogue: 0,0:02:15.68,0:02:17.48,Default,,0,0,0,,Сәлем, құдайдо!
Dialogue: 0,0:02:17.48,0:02:18.58,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:02:20.56,0:02:21.90,Default,,0,0,0,,Сю өте қорқынышты!
Dialogue: 0,0:02:21.90,0:02:24.40,Default,,0,0,0,,Уильям басынан соққы алды!
Dialogue: 0,0:02:24.40,0:02:26.40,Default,,0,0,0,,Бетіңіз қорқынышты көрінеді.
Dialogue: 0,0:02:26.40,0:02:28.40,Default,,0,0,0,,Шалбар толығымен көрінеді!
Dialogue: 0,0:02:28.40,0:02:28.90,Default,,0,0,0,,Не?
Dialogue: 0,0:02:28.90,0:02:30.90,Default,,0,0,0,,Жаман кешірім сұрау!
Dialogue: 0,0:02:30.90,0:02:32.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:32.00,0:02:33.72,Default,,0,0,0,,Бірақ мен жамандық көргім келеді.
Dialogue: 0,0:02:33.72,0:02:35.22,Default,,0,0,0,,Қараңызшы!
Dialogue: 0,0:02:35.22,0:02:37.80,Default,,0,0,0,,Даулар Хартиясы d'Augure!
Dialogue: 0,0:02:37.86,0:02:38.86,Default,,0,0,0,,Дискриминация туралы ызылдау
Dialogue: 0,0:02:38.88,0:02:40.88,Default,,0,0,0,,Йошико!
Dialogue: 0,0:02:41.88,0:02:43.88,Default,,0,0,0,,Шайтан! Йошиконы қорламаңыз!
Dialogue: 0,0:02:44.88,0:02:46.88,Default,,0,0,0,,Біз сенің қарсыласың боламыз!
Dialogue: 0,0:02:47.88,0:02:48.88,Default,,0,0,0,,Балалар, қашыңдар!
Dialogue: 0,0:02:49.88,0:02:50.88,Default,,0,0,0,,Ей, ақымақтар! Біз!
Dialogue: 0,0:02:51.88,0:02:52.88,Default,,0,0,0,,Қазірдің өзінде! Біз доспыз!
Dialogue: 0,0:02:53.88,0:02:54.88,Default,,0,0,0,,Балалар!
Dialogue: 0,0:02:58.88,0:03:01.88,Default,,0,0,0,,Жарайды! Күштерді біріктіріп, Акусораны жеңейік!
Dialogue: 0,0:03:03.09,0:03:11.09,Default,,0,0,0,,Мен сізге айтамын, бұл жігіт өлімші ақымақ, мен оны үйренуге тырысамын.
Dialogue: 0,0:03:11.09,0:03:13.09,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:03:14.04,0:03:17.04,Default,,0,0,0,,Тесттер әрқашан 0 ұпай алады!
Dialogue: 0,0:03:19.04,0:03:22.04,Default,,0,0,0,,Бұл шынымен әрқашан 0 ұпай ма?
Dialogue: 0,0:03:22.04,0:03:23.04,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:23.04,0:03:25.04,Default,,0,0,0,,Сіз жай ғана ойнап жүрсіз бе?
Dialogue: 0,0:03:25.04,0:03:27.04,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:03:27.04,0:03:30.04,Default,,0,0,0,,Тамақтану, ұйықтау және ойнау!
Dialogue: 0,0:03:30.04,0:03:32.04,Default,,0,0,0,,Жоқ, ересектер!
Dialogue: 0,0:03:32.04,0:03:34.04,Default,,0,0,0,,Бұл бізбен ойнайтын уақыт емес!
Dialogue: 0,0:03:34.04,0:03:36.04,Default,,0,0,0,,Үлкен маржа!
Dialogue: 0,0:03:36.04,0:03:39.04,Default,,0,0,0,,Сіз оны төлей алмайсыз! Шындыққа қараңызшы!
Dialogue: 0,0:03:39.04,0:03:40.04,Default,,0,0,0,,Не!
Dialogue: 0,0:03:40.04,0:03:42.04,Default,,0,0,0,,Бұл!
Dialogue: 0,0:03:42.04,0:03:44.04,Default,,0,0,0,,Арманымнан, үмітімнен айырылдым!
Dialogue: 0,0:03:44.04,0:03:47.04,Default,,0,0,0,,Префектураның сыртынан келген балалар!
Dialogue: 0,0:03:48.04,0:03:49.04,Default,,0,0,0,,Бонус!
Dialogue: 0,0:03:50.04,0:03:53.04,Default,,0,0,0,,Армансыз, үмітсіз сенсің!
Dialogue: 0,0:03:53.04,0:03:57.04,Default,,0,0,0,,Осындай үлкендер елді құртып жатыр.
Dialogue: 0,0:03:57.04,0:04:00.04,Default,,0,0,0,,Біз барынша тырысуымыз керек.
Dialogue: 0,0:04:01.64,0:04:06.64,Default,,0,0,0,,Мына балаға қараңдар. Мен оны ұнатпаймын.
Dialogue: 0,0:04:06.64,0:04:09.64,Default,,0,0,0,,Үйге келген соң ойнайық, Ақкүн!
Dialogue: 0,0:04:09.64,0:04:13.64,Default,,0,0,0,,Үйге келгенде сабақ оқимын. Менің жолыма шықсаң, мен сені өлтіремін.
Dialogue: 0,0:04:13.64,0:04:16.64,Default,,0,0,0,,Түсіндім! Ойнайық!
Dialogue: 0,0:04:18.64,0:04:21.64,Default,,0,0,0,,Ум...
Dialogue: 0,0:04:23.56,0:04:24.56,Default,,0,0,0,,О
Dialogue: 0,0:04:24.56,0:04:27.56,Default,,0,0,0,,Осылай отырсаң, тезек болады.
Dialogue: 0,0:04:27.56,0:04:28.56,Default,,0,0,0,,Шықпа!
Dialogue: 0,0:04:28.56,0:04:29.56,Default,,0,0,0,,Сіз мені жалап жатырсыз ба?
Dialogue: 0,0:04:29.56,0:04:30.56,Default,,0,0,0,,Мен байсалдымын!
Dialogue: 0,0:04:30.56,0:04:31.56,Default,,0,0,0,,Сәлем, Йошико!
Dialogue: 0,0:04:31.56,0:04:33.56,Default,,0,0,0,,Не, Теме және т.б.
Dialogue: 0,0:04:35.56,0:04:36.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:36.56,0:04:38.56,Default,,0,0,0,,Жарайды, күте тұр, айтсаң түсінемін.
Dialogue: 0,0:04:38.56,0:04:40.56,Default,,0,0,0,,Акун, бұл тамаша емес.
Dialogue: 0,0:04:40.56,0:04:41.56,Default,,0,0,0,,Шулы!
Dialogue: 0,0:04:42.56,0:04:44.56,Default,,0,0,0,,Мұқият қарасаң, сүйкімдісің.
Dialogue: 0,0:04:44.56,0:04:45.56,Default,,0,0,0,,Хо!
Dialogue: 0,0:04:47.56,0:04:48.56,Default,,0,0,0,,Бұл сен емессің!
Dialogue: 0,0:04:48.56,0:04:50.56,Default,,0,0,0,,Мен сенімен ойнаймын.
Dialogue: 0,0:04:50.56,0:04:52.56,Default,,0,0,0,,Мен-мен қиыншылыққа ұшырадым!
Dialogue: 0,0:04:53.56,0:04:54.56,Default,,0,0,0,,Йошико-чан?
Dialogue: 0,0:04:54.56,0:04:58.56,Default,,0,0,0,,Егер сонша ойнағың келсе, мен сенімен ойнаймын!
Dialogue: 0,0:04:59.56,0:05:01.56,Default,,0,0,0,,Мен ойнағым келеді!
Dialogue: 0,0:05:01.56,0:05:02.56,Default,,0,0,0,,Сен менің жолымдасың, Ахозора!
Dialogue: 0,0:05:02.56,0:05:04.56,Default,,0,0,0,,Жақсы айтылған.
Dialogue: 0,0:05:04.56,0:05:05.56,Default,,0,0,0,,Оны алыңыз!
Dialogue: 0,0:05:07.56,0:05:08.56,Default,,0,0,0,,Йошико-чан!
Dialogue: 0,0:05:08.56,0:05:10.56,Default,,0,0,0,,Хехе, келіңдер.
Dialogue: 0,0:05:10.56,0:05:12.56,Default,,0,0,0,,Жоқ, түсінемін.
Dialogue: 0,0:05:13.84,0:05:16.84,Default,,0,0,0,,Сізде көптен бері ойнайтын ешкім болмады.
Dialogue: 0,0:05:17.84,0:05:19.84,Default,,0,0,0,,Мен енді шыншыл бола алмаймын деп ойлаймын.
Dialogue: 0,0:05:21.84,0:05:22.84,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:05:22.84,0:05:25.84,Default,,0,0,0,,Ойнағың келсе де, ойнай алмасаң ауырады!
Dialogue: 0,0:05:25.84,0:05:26.84,Default,,0,0,0,,Бірақ бәрібір!
Dialogue: 0,0:05:26.84,0:05:28.84,Default,,0,0,0,,Мен сенімен ойнаймын!
Dialogue: 0,0:05:28.84,0:05:30.84,Default,,0,0,0,,Эй, жібер!
Dialogue: 0,0:05:31.84,0:05:32.84,Default,,0,0,0,,Мен мұны түсінбеймін!
Dialogue: 0,0:05:34.84,0:05:37.84,Default,,0,0,0,,Жақсы, жарайды, ойнайық!
Dialogue: 0,0:05:38.84,0:05:42.84,Default,,0,0,0,,Осы уақытқа дейін маған ешкім бұлай қараған емес...
Dialogue: 0,0:05:43.84,0:05:44.73,Default,,0,0,0,,(жылау)
Dialogue: 0,0:05:44.73,0:05:53.99,Default,,0,0,0,,Кім... менің бұл... ондай ақымақ болғаным дұрыс па!?
Dialogue: 0,0:05:53.99,0:05:57.11,Default,,0,0,0,,Жарайды! Мен де ақымақпын!
Dialogue: 0,0:05:57.11,0:06:05.89,Default,,0,0,0,,Бұл менмін! Бұл мен! Бұл мен!
Dialogue: 0,0:06:11.32,0:06:14.32,Default,,0,0,0,,Аққан-санның бауырлары бар ма?
Dialogue: 0,0:06:14.32,0:06:16.32,Default,,0,0,0,,О, менің бір әпкем бар.
Dialogue: 0,0:06:16.32,0:06:17.32,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:06:17.32,0:06:22.32,Default,,0,0,0,,Мен ең сүйкімдімін.
Dialogue: 0,0:06:23.32,0:06:26.32,Default,,0,0,0,,Мен сұлурақпын.
Dialogue: 0,0:06:28.22,0:06:30.22,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:06:30.22,0:06:32.22,Default,,0,0,0,,О, рахмет, аға.
Dialogue: 0,0:06:32.22,0:06:34.22,Default,,0,0,0,,Эй, эй, Лури-чан
Dialogue: 0,0:06:34.22,0:06:36.22,Default,,0,0,0,,Ге, Йошико
Dialogue: 0,0:06:36.22,0:06:38.22,Default,,0,0,0,,А, тым жақындама, өйткені суреттен ақымақты көресің.
Dialogue: 0,0:06:38.22,0:06:40.22,Default,,0,0,0,,Хэхе, қандай сүйкімді.
Dialogue: 0,0:06:40.22,0:06:42.22,Default,,0,0,0,,Лори-чан!
Dialogue: 0,0:06:42.22,0:06:44.22,Default,,0,0,0,,Бірақ мен бас тартамын!
Dialogue: 0,0:06:44.22,0:06:46.22,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:06:46.22,0:06:48.22,Default,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:06:48.22,0:06:50.22,Default,,0,0,0,,Түсіндірейін, нені жасыруым керек?
Dialogue: 0,0:06:50.22,0:06:52.22,Default,,0,0,0,,Бұл бала зұлым ханзаданың қарындасы.
Dialogue: 0,0:06:52.22,0:06:54.22,Default,,0,0,0,,Мен мүлдем оқи алмаймын.
Dialogue: 0,0:06:54.22,0:06:56.22,Default,,0,0,0,,Ол ақымақ.
Dialogue: 0,0:06:56.22,0:06:58.22,Default,,0,0,0,,Е, мен ақымақ емеспін.
Dialogue: 0,0:06:58.22,0:07:00.22,Default,,0,0,0,,Сәлем, аға.
Dialogue: 0,0:07:00.22,0:07:02.22,Default,,0,0,0,,Әрине, ол Йошикодан әлдеқайда байсалды.
Dialogue: 0,0:07:02.22,0:07:04.22,Default,,0,0,0,,Мен бақытты емеспін.
Dialogue: 0,0:07:04.22,0:07:05.50,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:07:05.50,0:07:09.00,Default,,0,0,0,,Ақымақтармен тіл табысайық.
Dialogue: 0,0:07:09.00,0:07:11.00,Default,,0,0,0,,Мұны бірге жасамаңыз!
Dialogue: 0,0:07:11.00,0:07:16.00,Default,,0,0,0,,Йошикодан айырмашылығы, мен оқуда жақсы болмасам да, күн сайын қатты жұмыс істеймін!
Dialogue: 0,0:07:16.00,0:07:18.00,Default,,0,0,0,,А? Бірдеңе құлады.
Dialogue: 0,0:07:18.00,0:07:20.00,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:07:22.25,0:07:26.25,Default,,0,0,0,,Өйткені сен көп жұмыс істеп жатырсың, Фубин!
Dialogue: 0,0:07:26.25,0:07:28.25,Default,,0,0,0,,Тоқта, ағайын!
Dialogue: 0,0:07:28.25,0:07:32.25,Default,,0,0,0,,6 дана 7...мм...
Dialogue: 0,0:07:32.25,0:07:33.25,Default,,0,0,0,,Хохо?
Dialogue: 0,0:07:33.25,0:07:36.25,Default,,0,0,0,,Көбейту де қиын
Dialogue: 0,0:07:36.25,0:07:40.25,Default,,0,0,0,,Ал...егер 7 6 болса...
Dialogue: 0,0:07:40.25,0:07:41.25,Default,,0,0,0,,Би!
Dialogue: 0,0:07:41.25,0:07:42.25,Default,,0,0,0,,Билеме!
Dialogue: 0,0:07:42.25,0:07:43.25,Default,,0,0,0,,Егер бір 6...
Dialogue: 0,0:07:43.25,0:07:44.25,Default,,0,0,0,,Дәл солай!
Dialogue: 0,0:07:44.25,0:07:45.25,Default,,0,0,0,,Егер ол бірдей болса...
Dialogue: 0,0:07:45.25,0:07:46.25,Default,,0,0,0,,Билеме, ұлым!
Dialogue: 0,0:07:46.25,0:07:47.25,Default,,0,0,0,,Балам!
Dialogue: 0,0:07:47.25,0:07:48.25,Default,,0,0,0,,Йошико мені мазалайды!
Dialogue: 0,0:07:48.25,0:07:51.25,Default,,0,0,0,,Оны мойындау керек!
Dialogue: 0,0:07:51.25,0:07:52.25,Default,,0,0,0,,Иә
Dialogue: 0,0:07:52.25,0:07:55.25,Default,,0,0,0,,Идиоттар өлсе де емделмейді!
Dialogue: 0,0:07:55.25,0:07:57.25,Default,,0,0,0,,О, бұл...
Dialogue: 0,0:07:57.25,0:07:59.25,Default,,0,0,0,,Жүр, тез беріл.
Dialogue: 0,0:07:59.25,0:08:03.25,Default,,0,0,0,,Ақымақ өмірді бірге тамашалайық!
Dialogue: 0,0:08:03.25,0:08:07.25,Default,,0,0,0,,Жоқ, тіпті мүмкіндік өте төмен болса да
Dialogue: 0,0:08:07.25,0:08:10.25,Default,,0,0,0,,Мен, мен...
Dialogue: 0,0:08:10.25,0:08:12.25,Default,,0,0,0,,Жарайды, Рури!
Dialogue: 0,0:08:12.25,0:08:13.25,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,0:08:13.25,0:08:16.25,Default,,0,0,0,,Рури мәңгі ақымақ болса да
Dialogue: 0,0:08:16.25,0:08:18.80,Default,,0,0,0,,Менің ағам саған қамқор болады.
Dialogue: 0,0:08:18.80,0:08:20.80,Default,,0,0,0,,Рури?
Dialogue: 0,0:08:20.80,0:08:23.80,Default,,0,0,0,,Тіпті менің ағам. Ол менің ағам!
Dialogue: 0,0:08:23.80,0:08:26.80,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:08:26.80,0:08:27.80,Default,,0,0,0,,Мен Йошиконы одан сайын жек көремін!
Dialogue: 0,0:08:37.80,0:08:38.80,Default,,0,0,0,,Сонымен, жақсысың ба?
Dialogue: 0,0:08:39.80,0:08:41.80,Default,,0,0,0,,Ә? Жоқ, мен ештеңе істеген жоқпын…
Dialogue: 0,0:08:41.80,0:08:44.80,Default,,0,0,0,,Менің әпкем екеуіміз де бұл жақсы емес деп ойлаймын.
Dialogue: 0,0:08:44.80,0:08:46.80,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:08:47.36,0:08:49.36,Default,,0,0,0,,Мен тіпті ақымақтарды да емдеуге болатынына сенімдімін!
Dialogue: 0,0:08:50.36,0:08:52.36,Default,,0,0,0,,Ол үлкен әпке!
Dialogue: 0,0:08:53.36,0:08:55.36,Default,,0,0,0,,Мына бала қиналатын сияқты.
Dialogue: 0,0:09:04.28,0:09:11.26,Default,,0,0,0,,Акутсу Акуру-кун, 1/2 сынып, жоғарғы деңгейдегі бағалар
Dialogue: 0,0:09:11.26,0:09:20.68,Default,,0,0,0,,Бұл махаббат болуы мүмкін бе? Бірақ, мен қоғамдық мораль комитетінің басшысымын, ал ол мектепке тентек заттарды әкелетін.
Dialogue: 0,0:09:21.45,0:09:24.45,Default,,0,0,0,,Мен сенің адамгершілігіңді ашқым келеді.
Dialogue: 0,0:09:24.45,0:09:28.45,Default,,0,0,0,,Сіз менің моральдық кодексімді таптыңыз!
Dialogue: 0,0:09:28.45,0:09:30.45,Default,,0,0,0,,Бөлімшенің төрағасы!
Dialogue: 0,0:09:30.45,0:09:34.45,Default,,0,0,0,,Ол кезде сен ақымақ едің! Маған бұл оғаш есімді атама!
Dialogue: 0,0:09:34.45,0:09:36.45,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:36.45,0:09:38.45,Default,,0,0,0,,Әй, Ақкун!
Dialogue: 0,0:09:38.45,0:09:41.45,Default,,0,0,0,,Тәртіп комиссиясының төрағасы
Dialogue: 0,0:09:41.45,0:09:44.45,Default,,0,0,0,,А, есіңе түсті.
Dialogue: 0,0:09:44.45,0:09:47.45,Default,,0,0,0,,Сіз нені айтасыз? Сіз бұған ризасыз ба?
Dialogue: 0,0:09:47.45,0:09:49.45,Default,,0,0,0,,Мен ақымақпын!
Dialogue: 0,0:09:49.45,0:09:52.45,Default,,0,0,0,,Мүмкін жүкті тағы бір тексеру керек пе?
Dialogue: 0,0:09:52.45,0:09:54.45,Default,,0,0,0,,А, солай.
Dialogue: 0,0:09:54.45,0:09:57.45,Default,,0,0,0,,Ол тағы біреуді тентек әкелуі мүмкін.
Dialogue: 0,0:09:57.45,0:09:59.45,Default,,0,0,0,,Осылайша
Dialogue: 0,0:09:59.45,0:10:01.45,Default,,0,0,0,,Га, онда
Dialogue: 0,0:10:01.45,0:10:04.45,Default,,0,0,0,,Менің киімімді немесе сөмкемді қалауыңызша іздеңіз.
Dialogue: 0,0:10:06.45,0:10:09.45,Default,,0,0,0,,Қарғыс атқыр, бәрі жақсы ма?
Dialogue: 0,0:10:09.45,0:10:12.45,Default,,0,0,0,,Жүкті тексеру нені білдіреді?
Dialogue: 0,0:10:12.45,0:10:15.45,Default,,0,0,0,,Менің денем арық
Dialogue: 0,0:10:15.45,0:10:18.45,Default,,0,0,0,,Шексіз түрту
Dialogue: 0,0:10:18.45,0:10:21.45,Default,,0,0,0,,Әдептілік комитетінің төрағасы!
Dialogue: 0,0:10:21.45,0:10:24.45,Default,,0,0,0,,Жарайды, онда бастайық.
Dialogue: 0,0:10:24.45,0:10:27.45,Default,,0,0,0,,Аккун! Мына жігіттің көздері сондай эротикалық!
Dialogue: 0,0:10:27.45,0:10:28.45,Default,,0,0,0,,Күдікті!
Dialogue: 0,0:10:28.45,0:10:31.45,Default,,0,0,0,,Эй, менің сексуалды болуым мүмкін емес, солай ма?
Dialogue: 0,0:10:31.45,0:10:34.45,Default,,0,0,0,,Мен қоғамдық мораль комитетінің басшысымын!
Dialogue: 0,0:10:34.45,0:10:35.45,Default,,0,0,0,,Мұрнымнан қан кетіп жатыр.
Dialogue: 0,0:10:35.45,0:10:38.45,Default,,0,0,0,,Бұл жігіт күткендей қорқынышты түс көруді көздеп отыр.
Dialogue: 0,0:10:38.45,0:10:41.45,Default,,0,0,0,,Қандай мазасыз ақымақ
Dialogue: 0,0:10:41.45,0:10:45.45,Default,,0,0,0,,А, аа! Мына жерде үлкен банан бар!
Dialogue: 0,0:10:45.45,0:10:47.45,Default,,0,0,0,,Қайда?
Dialogue: 0,0:10:47.45,0:10:49.36,Default,,0,0,0,,Accha!
Dialogue: 0,0:10:49.36,0:10:52.36,Default,,0,0,0,,Қарғыс атсын, ол жұмыс істемейді!
Dialogue: 0,0:10:52.36,0:10:54.36,Default,,0,0,0,,Бұл жеткілікті!
Dialogue: 0,0:10:54.36,0:10:56.36,Default,,0,0,0,,Бір техника екі рет жұмыс істемейді!
Dialogue: 0,0:10:56.36,0:10:58.36,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:10:58.36,0:11:02.36,Default,,0,0,0,,Қара, қара, қара, қара!
Dialogue: 0,0:11:02.36,0:11:06.36,Default,,0,0,0,,Мына бала бұрынғыдан да ашулы, а!
Dialogue: 0,0:11:06.36,0:11:09.36,Default,,0,0,0,,Бұл жігіт бұрынғыдан да үлкен!
Dialogue: 0,0:11:09.36,0:11:14.36,Default,,0,0,0,,Қарғыс атсын, мен күштімін, бірақ мен бұл шайқаста жеңіле алмаймын!
Dialogue: 0,0:11:14.36,0:11:18.36,Default,,0,0,0,,Өз заттарыңызды тексеруге кедергі жасамаңыз!
Dialogue: 0,0:11:18.36,0:11:20.36,Default,,0,0,0,,Мен жеңілмеймін!
Dialogue: 0,0:11:23.19,0:11:24.19,Default,,0,0,0,,(Уф, уф...)
Dialogue: 0,0:11:24.19,0:11:26.19,Default,,0,0,0,,(Gee-kat)
Dialogue: 0,0:11:26.39,0:11:29.69,Default,,0,0,0,,(Енді кедергілер жоқ)
Dialogue: 0,0:11:29.69,0:11:33.69,Default,,0,0,0,,(Шынымды айтсам, Зомбун, мен оны қараймын!)
Dialogue: 0,0:11:35.69,0:11:36.69,Default,,0,0,0,,(Неге сіз одан аулақ жүрсіз!)
Dialogue: 0,0:11:36.69,0:11:38.69,Default,,0,0,0,,(Жоқ, бұл қорқынышты...)
Dialogue: 0,0:11:40.19,0:11:42.19,Default,,0,0,0,,(Не туралы айтып тұрсыз!)
Dialogue: 0,0:11:42.19,0:11:46.19,Default,,0,0,0,,(Мен жай ғана атмосфера комитетінің төрағасы ретіндегі миссиямды өшіргім келді!)
Dialogue: 0,0:11:47.69,0:11:51.19,Default,,0,0,0,,(Ха, ха, не ...)
Dialogue: 0,0:11:51.19,0:11:53.39,Default,,0,0,0,,Тыныш болыңыз!
Dialogue: 0,0:11:53.40,0:11:57.70,Default,,0,0,0,,Шункамен тоқтап, халықты құшақтап ал.
Dialogue: 0,0:11:57.70,0:12:00.90,Default,,0,0,0,,Тек сананың позициясы
Dialogue: 0,0:12:00.90,0:12:10.20,Default,,0,0,0,,Бор
Dialogue: 0,0:12:15.10,0:12:19.40,Default,,0,0,0,,Қазір айналдыру
Dialogue: 0,0:12:19.89,0:12:22.89,Default,,0,0,0,,Мен тағы келемін
Dialogue: 0,0:12:22.89,0:12:24.89,Default,,0,0,0,,Га, га.
Dialogue: 0,0:12:25.89,0:12:29.89,Default,,0,0,0,,Келесі жолы қартайған шақта өзіңізді қауіпсіз сезініңіз! Ақымақ қыз!
Dialogue: 0,0:12:31.39,0:12:37.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory