Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.00,Default,,0,0,0,,см
Dialogue: 0,0:00:02.00,0:00:03.00,Default,,0,0,0,,Иә
Dialogue: 0,0:00:03.00,0:00:07.00,Default,,0,0,0,,Бұл дегеніміз, байланыс жоқ.
Dialogue: 0,0:00:07.00,0:00:12.00,Default,,0,0,0,,Вуду
Dialogue: 0,0:00:15.00,0:00:20.00,Default,,0,0,0,,Содан бері маңызды болды ма?
Dialogue: 0,0:00:20.00,0:00:26.00,Default,,0,0,0,,Менің атым Ханабатаке, бүгіннен бері көрші тұрамын. Бұл Акутсу. рақмет сізге.
Dialogue: 0,0:00:26.00,0:00:27.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:27.00,0:00:29.00,Default,,0,0,0,,Йошико Ханабатэке! Ол 4 жаста!
Dialogue: 0,0:00:29.00,0:00:31.00,Default,,0,0,0,,Йошико? Сіз 5 жастасыз, солай ма?
Dialogue: 0,0:00:31.00,0:00:33.00,Default,,0,0,0,,Шынымен!? 5 жас деген нені білдіреді?
Dialogue: 0,0:00:33.00,0:00:35.00,Default,,0,0,0,,4 жастан кейін 5 жас, солай ма?
Dialogue: 0,0:00:35.00,0:00:36.00,Default,,0,0,0,,Кім шешті?
Dialogue: 0,0:00:36.00,0:00:37.00,Default,,0,0,0,,Құдай.
Dialogue: 0,0:00:37.00,0:00:39.00,Default,,0,0,0,,Сонымен құдай!?
Dialogue: 0,0:00:39.00,0:00:40.00,Default,,0,0,0,,Біртүрлі жігіт.
Dialogue: 0,0:00:40.00,0:00:41.00,Default,,0,0,0,,Сонымен!?
Dialogue: 0,0:00:41.00,0:00:42.00,Default,,0,0,0,,О, сен ше?
Dialogue: 0,0:00:42.00,0:00:43.00,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:00:43.00,0:00:44.00,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:00:44.00,0:00:45.00,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:00:45.00,0:00:46.00,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:00:46.00,0:00:47.00,Default,,0,0,0,,Сіз трагедиясыз.
Dialogue: 0,0:00:47.00,0:00:48.00,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:00:48.00,0:00:49.00,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:00:49.00,0:00:50.00,Default,,0,0,0,,-да?
Dialogue: 0,0:00:50.00,0:00:51.00,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:00:51.00,0:00:53.00,Default,,0,0,0,,Ах, актуакуру.
Dialogue: 0,0:00:53.00,0:00:54.00,Default,,0,0,0,,Акун!
Dialogue: 0,0:00:54.00,0:00:55.00,Default,,0,0,0,,Ойнайық!
Dialogue: 0,0:00:55.00,0:00:58.00,Default,,0,0,0,,Жоқ, мен қазір оқуға барамын.
Dialogue: 0,0:00:58.00,0:00:59.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:59.00,0:01:01.00,Default,,0,0,0,,Сонымен немен ойнамақшысың?
Dialogue: 0,0:01:01.00,0:01:02.00,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:01:05.00,0:01:07.00,Default,,0,0,0,,Ол жігітпен шаруамыз болмасын.
Dialogue: 0,0:01:10.00,0:01:12.00,Default,,0,0,0,,Сен қайдан келдің?
Dialogue: 0,0:01:12.00,0:01:14.00,Default,,0,0,0,,Терезеден ұшып кетті!
Dialogue: 0,0:01:16.00,0:01:17.00,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:01:17.00,0:01:19.00,Default,,0,0,0,,Енді не ойнаймыз!?
Dialogue: 0,0:01:19.00,0:01:21.00,Default,,0,0,0,,Сен оқимын дедің ғой, солай ма?
Dialogue: 0,0:01:21.00,0:01:23.00,Default,,0,0,0,,Нені зерттейді? Қызық па?
Dialogue: 0,0:01:23.00,0:01:25.00,Default,,0,0,0,,Жоқ, бұл соншалықты қызық емес.
Dialogue: 0,0:01:25.00,0:01:27.00,Default,,0,0,0,,Е!?Олай болса неге олай істейсің!?
Dialogue: 0,0:01:27.00,0:01:29.00,Default,,0,0,0,,Бұл болашаққа арналған.
Dialogue: 0,0:01:29.00,0:01:31.00,Default,,0,0,0,,Енді әнді аяқтаңыз!
Dialogue: 0,0:01:31.00,0:01:33.00,Default,,0,0,0,,Бұл тітіркендіргіш!
Dialogue: 0,0:01:34.00,0:01:36.00,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:01:36.00,0:01:38.00,Default,,0,0,0,,Маған дәмді нәрсе беріңізші!
Dialogue: 0,0:01:38.00,0:01:40.00,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:01:41.00,0:01:43.00,Default,,0,0,0,,Мынаны жеп ал да, үйге қайт!
Dialogue: 0,0:01:43.00,0:01:44.00,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:01:44.00,0:01:45.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:46.00,0:01:48.00,Default,,0,0,0,,Сары шымшық!?
Dialogue: 0,0:01:48.00,0:01:49.00,Default,,0,0,0,,Бұл банан!
Dialogue: 0,0:01:50.00,0:01:52.00,Default,,0,0,0,,Мен сары шымшық аламын!
Dialogue: 0,0:01:52.00,0:01:53.00,Default,,0,0,0,,Адамдарды тыңда!
Dialogue: 0,0:01:53.00,0:01:54.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:57.00,0:01:59.00,Default,,0,0,0,,Дәмді қызғылт
Dialogue: 0,0:01:59.00,0:02:00.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:00.00,0:02:03.00,Default,,0,0,0,,4 жыл және әлемнің түкпір-түкпірінен келген адамдар!
Dialogue: 0,0:02:03.00,0:02:04.00,Default,,0,0,0,,Соншама!?
Dialogue: 0,0:02:05.00,0:02:07.00,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:02:08.00,0:02:09.00,Default,,0,0,0,,Қашан.
Dialogue: 0,0:02:09.00,0:02:11.00,Default,,0,0,0,,Хааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:02:11.00,0:02:14.00,Default,,0,0,0,,Мен мұндай дәмді нәрсе жіберемін деп ешқашан ойламадым.
Dialogue: 0,0:02:14.00,0:02:15.00,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:15.00,0:02:17.00,Default,,0,0,0,,Мен саған ұнайсың!
Dialogue: 0,0:02:17.00,0:02:19.00,Default,,0,0,0,,Хааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:02:19.00,0:02:21.00,Default,,0,0,0,,Арық киім киіп, назар аудара алмайсың.
Dialogue: 0,0:02:21.00,0:02:23.00,Default,,0,0,0,,U, ma, se, so.
Dialogue: 0,0:02:23.00,0:02:25.00,Default,,0,0,0,,Не, не туралы айтып тұрсың?
Dialogue: 0,0:02:25.00,0:02:26.00,Default,,0,0,0,,(Хироко) Дегенмен, мен өзімді сәл жалғыз сезінемін.
Dialogue: 0,0:02:26.00,0:02:28.00,Default,,0,0,0,,Бет.
Dialogue: 0,0:02:28.00,0:02:30.00,Default,,0,0,0,,Алмасу нашар ма?
Dialogue: 0,0:02:30.00,0:02:31.00,Default,,0,0,0,,Эй, ол келе жатыр!
Dialogue: 0,0:02:31.00,0:02:33.00,Default,,0,0,0,,Сіз бұл махаббатты қабылдайсыз ба?
Dialogue: 0,0:02:34.00,0:02:35.00,Default,,0,0,0,,Сен маған ұнамайсың!
Dialogue: 0,0:02:35.00,0:02:37.00,Default,,0,0,0,,Сізге кетудің қажеті жоқ!
Dialogue: 0,0:02:37.00,0:02:38.00,Default,,0,0,0,,Ұялмаңыз!
Dialogue: 0,0:02:38.00,0:02:39.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:39.00,0:02:40.00,Default,,0,0,0,,Жақсы сезінемін!
Dialogue: 0,0:02:43.00,0:02:47.00,Default,,0,0,0,,Сіз оны осы жерден таба алмайсыз.
Dialogue: 0,0:02:47.00,0:02:48.00,Default,,0,0,0,,Табылды
Dialogue: 0,0:02:53.00,0:02:55.00,Default,,0,0,0,,Терея өзінің шегіне жетті.
Dialogue: 0,0:02:56.00,0:02:58.00,Default,,0,0,0,,Мен де сені сүйем Арқа
Dialogue: 0,0:02:59.00,0:03:00.00,Default,,0,0,0,,Келме.
Dialogue: 0,0:03:01.00,0:03:03.00,Default,,0,0,0,,Эй, не?
Dialogue: 0,0:03:04.00,0:03:06.00,Default,,0,0,0,,Жоқ, тоқтат!
Dialogue: 0,0:03:06.00,0:03:10.00,Default,,0,0,0,,Жоқ, тоқта, тоқта!
Dialogue: 0,0:03:25.00,0:03:28.00,Default,,0,0,0,,Мен өскенде саған үйленемін.
Dialogue: 0,0:03:28.00,0:03:29.00,Default,,0,0,0,,Болу
Dialogue: 0,0:03:34.00,0:03:38.00,Default,,0,0,0,,Менің ренжігенімді көргің келмесе, енді менің алдымда шықпа.
Dialogue: 0,0:03:41.00,0:03:43.00,Default,,0,0,0,,Онда
Dialogue: 0,0:03:47.00,0:03:48.00,Default,,0,0,0,,Мен бұл жігітті кездестіргенде
Dialogue: 0,0:03:49.00,0:03:52.00,Default,,0,0,0,,Өмірімде бірінші рет жүрегімде бір сезім пайда болды.
Dialogue: 0,0:03:53.00,0:03:54.00,Default,,0,0,0,,Ах, Аркун-сан.
Dialogue: 0,0:03:54.00,0:03:55.00,Default,,0,0,0,,Аркун мырза
Dialogue: 0,0:03:56.00,0:03:58.00,Default,,0,0,0,,Эй, Аркун Аркун
Dialogue: 0,0:03:58.00,0:03:59.00,Default,,0,0,0,,Ойнайық
Dialogue: 0,0:03:59.00,0:04:01.00,Default,,0,0,0,,Шулы! Бұл оқуға кедергі келтіреді.
Dialogue: 0,0:04:01.00,0:04:03.00,Default,,0,0,0,,Мен өзім жақсы көретін адаммен ойнағым келеді
Dialogue: 0,0:04:03.00,0:04:05.00,Default,,0,0,0,,Мен сені жек көремін
Dialogue: 0,0:04:05.00,0:04:08.00,Default,,0,0,0,,Сен мені құмарта сүйсең де
Dialogue: 0,0:04:10.00,0:04:13.00,Default,,0,0,0,,Менің ойымша, сіз мәжбүрледіңіз.
Dialogue: 0,0:04:16.00,0:04:18.00,Default,,0,0,0,,Осындай шамадағы соққы оң қолмен жасалған.
Dialogue: 0,0:04:19.00,0:04:20.00,Default,,0,0,0,,Ал, ойнайық
Dialogue: 0,0:04:20.00,0:04:21.00,Default,,0,0,0,,Жібер!
Dialogue: 0,0:04:24.00,0:04:25.00,Default,,0,0,0,,Жетті, Конни
Dialogue: 0,0:04:26.00,0:04:27.00,Default,,0,0,0,,Уме
Dialogue: 0,0:04:27.00,0:04:28.00,Default,,0,0,0,,Тамақ ішуге келме
Dialogue: 0,0:04:28.00,0:04:29.00,Default,,0,0,0,,Чичи сүйкімді
Dialogue: 0,0:04:29.00,0:04:31.00,Default,,0,0,0,,Ваннаға қарамаңыз
Dialogue: 0,0:04:32.00,0:04:37.00,Default,,0,0,0,,Менің футоным осылай қалса, өмірім аласапыран болады.
Dialogue: 0,0:04:41.00,0:04:42.00,Default,,0,0,0,,Мен сені жеңемін
Dialogue: 0,0:04:44.00,0:04:45.00,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:04:46.00,0:04:47.00,Default,,0,0,0,,Оны қайтарыңыз
Dialogue: 0,0:04:48.00,0:04:49.00,Default,,0,0,0,,Бейбіт өмір сүріңіз
Dialogue: 0,0:04:50.00,0:04:53.00,Default,,0,0,0,,Денеңізді мұқият жаттықтырыңыз
Dialogue: 0,0:04:54.00,0:04:56.00,Default,,0,0,0,,Билікті алыңыз
Dialogue: 0,0:04:59.00,0:05:00.00,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:05:00.00,0:05:02.00,Default,,0,0,0,,Міндетті түрде орындаңыз
Dialogue: 0,0:05:03.00,0:05:05.00,Default,,0,0,0,,Жігітті өлтіріңіз
Dialogue: 0,0:05:15.00,0:05:16.00,Default,,0,0,0,,Бұл не? Мен байланғанмын.
Dialogue: 0,0:05:16.00,0:05:19.00,Default,,0,0,0,,Бұл жұдырық оны өлтіруі мүмкін.
Dialogue: 0,0:05:20.00,0:05:22.00,Default,,0,0,0,,Сол кәмпит
Dialogue: 0,0:05:24.00,0:05:25.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:05:28.00,0:05:30.00,Default,,0,0,0,,Акуасобо
Dialogue: 0,0:05:30.00,0:05:31.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:05:33.00,0:05:34.00,Default,,0,0,0,,Қараңғы?
Dialogue: 0,0:05:41.00,0:05:44.00,Default,,0,0,0,,Ятоны таптың ба?
Dialogue: 0,0:05:45.00,0:05:46.00,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:48.00,0:05:50.00,Default,,0,0,0,,О, қазір өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:05:50.00,0:05:51.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:05:51.00,0:05:54.00,Default,,0,0,0,,Суық тиіп, төсекте бір тәуліктен артық жаттың.
Dialogue: 0,0:05:55.00,0:05:56.00,Default,,0,0,0,,Соншама?
Dialogue: 0,0:05:56.00,0:05:59.00,Default,,0,0,0,,Йошико-чан, мен оған ай сайын қамқорлық жасап келемін.
Dialogue: 0,0:05:59.00,0:06:00.00,Default,,0,0,0,,Иә? Өтірік?
Dialogue: 0,0:06:01.00,0:06:02.00,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:06:02.00,0:06:03.00,Default,,0,0,0,,Осы уақытта Джозеф пен басқалар—
Dialogue: 0,0:06:05.00,0:06:07.00,Default,,0,0,0,,Менің ойымша, ол жаман адам емес.
Dialogue: 0,0:06:08.00,0:06:11.00,Default,,0,0,0,,Бірақ сен сондай ақымаққа қамқор бола алдың.
Dialogue: 0,0:06:11.00,0:06:14.00,Default,,0,0,0,,Иә, бұл сүйкімді
Dialogue: 0,0:06:15.00,0:06:17.00,Default,,0,0,0,,Маған берсең жазылады деді.
Dialogue: 0,0:06:17.00,0:06:20.00,Default,,0,0,0,,Мен түні бойы шайнадым.
Dialogue: 0,0:06:24.00,0:06:26.00,Default,,0,0,0,,Сіз жазылдыңыз ба?
Dialogue: 0,0:06:27.00,0:06:28.00,Default,,0,0,0,,Біздің
Dialogue: 0,0:06:29.00,0:06:30.00,Default,,0,0,0,,Махаббат күші.
Dialogue: 0,0:06:32.00,0:06:33.00,Default,,0,0,0,,Жылау
Dialogue: 0,0:06:33.00,0:06:35.00,Default,,0,0,0,,Менің күшім
Dialogue: 0,0:06:43.00,0:06:44.00,Default,,0,0,0,,Соқыңыз!
Dialogue: 0,0:06:48.00,0:06:51.00,Default,,0,0,0,,Йошикомен кездескеннен кейін жақсы нәрсе болса
Dialogue: 0,0:06:51.00,0:06:54.00,Default,,0,0,0,,Мен сені кездестіргенім шығар.
Dialogue: 0,0:06:57.00,0:06:59.00,Default,,0,0,0,,Бүгін оны ұшырып жіберейік!
Dialogue: 0,0:06:59.00,0:07:01.00,Default,,0,0,0,,Өл!
Dialogue: 0,0:07:02.00,0:07:03.00,Default,,0,0,0,,Омай
Dialogue: 0,0:07:03.00,0:07:05.00,Default,,0,0,0,,Мен де бүгін күні бойы ойнағым келеді.
Dialogue: 0,0:07:05.00,0:07:07.00,Default,,0,0,0,,Жібер!
Dialogue: 0,0:07:11.00,0:07:13.00,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:07:13.00,0:07:14.00,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:07:14.00,0:07:16.00,Default,,0,0,0,,Ах, балалар семинар тесті
Dialogue: 0,0:07:16.00,0:07:17.00,Default,,0,0,0,,Ол қайтып келді.
Dialogue: 0,0:07:17.00,0:07:18.00,Default,,0,0,0,,А, иә
Dialogue: 0,0:07:22.00,0:07:25.00,Default,,0,0,0,,Менің бағаларым аздап төмендеді.
Dialogue: 0,0:07:25.00,0:07:30.00,Default,,0,0,0,,Меніңше, анам Йошикомен бірге далада ойнап жүргендіктен, қазір дені сау.
Dialogue: 0,0:07:30.00,0:07:31.00,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:31.00,0:07:32.00,Default,,0,0,0,,Ақұл?
Dialogue: 0,0:07:32.00,0:07:34.00,Default,,0,0,0,,Егер біз осылай істей берсек,
Dialogue: 0,0:07:34.00,0:07:37.00,Default,,0,0,0,,Бағаларым төмендей берді, мен жақсы университетке немесе жақсы компанияға бара алмадым.
Dialogue: 0,0:07:37.00,0:07:39.00,Default,,0,0,0,,Менің өмірім тым-тырыс
Dialogue: 0,0:07:39.00,0:07:41.00,Default,,0,0,0,,Ха, ең нашар жағдай сценарийі.
Dialogue: 0,0:07:41.00,0:07:44.00,Default,,0,0,0,,Сүйіспеншілікке байланысты біреуге мәжбүрлі түрде некеге тұру мүмкіндігі
Dialogue: 0,0:07:46.00,0:07:47.00,Default,,0,0,0,,Сіздің балаңыз
Dialogue: 0,0:07:51.00,0:07:53.00,Default,,0,0,0,,А, мен бірдеңе істеуім керек.
Dialogue: 0,0:07:53.00,0:07:56.00,Default,,0,0,0,,Бірақ менің қазіргі күшіммен қашан екені маңызды емес.
Dialogue: 0,0:07:56.00,0:07:57.00,Default,,0,0,0,,Қат!
Dialogue: 0,0:07:57.00,0:08:00.00,Default,,0,0,0,,Ол маған бірінші кезекте не үшін келеді?
Dialogue: 0,0:08:00.00,0:08:02.00,Default,,0,0,0,,Себебі мен сені жақсы көремін.
Dialogue: 0,0:08:02.00,0:08:03.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:03.00,0:08:04.00,Default,,0,0,0,,Эй, сен мұнда неге келдің?
Dialogue: 0,0:08:04.00,0:08:05.00,Default,,0,0,0,,Мені шақырып жатқандай сезінемін
Dialogue: 0,0:08:05.00,0:08:06.00,Default,,0,0,0,,Маған қоңырау шалмаңыз
Dialogue: 0,0:08:06.00,0:08:08.00,Default,,0,0,0,,Сіз нені жақсы көресіз?
Dialogue: 0,0:08:08.00,0:08:09.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:09.00,0:08:12.00,Default,,0,0,0,,Мәселе мынада, егер бұл жігіт сені жек көрсе, бәрібір.
Dialogue: 0,0:08:13.00,0:08:14.00,Default,,0,0,0,,Эй
Dialogue: 0,0:08:14.00,0:08:16.00,Default,,0,0,0,,Сіз қандай адамды жек көресіз?
Dialogue: 0,0:08:16.00,0:08:17.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:08:17.00,0:08:20.00,Default,,0,0,0,,Сіз мұндай адаммен жақын болғыңыз келмейтініне сенімдісіз бе?
Dialogue: 0,0:08:20.00,0:08:22.00,Default,,0,0,0,,Кімнен аулақ болғың келеді?
Dialogue: 0,0:08:22.00,0:08:24.00,Default,,0,0,0,,Бүкіл денесі тезекпен жабылған адам?
Dialogue: 0,0:08:24.00,0:08:26.00,Default,,0,0,0,,Тағы не бар?
Dialogue: 0,0:08:26.00,0:08:27.00,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:27.00,0:08:30.00,Default,,0,0,0,,О, мен уақытты ұнатпаймын.
Dialogue: 0,0:08:30.00,0:08:32.00,Default,,0,0,0,,Мен әйел болғандықтан кешіре алмаймын.
Dialogue: 0,0:08:32.00,0:08:33.00,Default,,0,0,0,,Уақыт?
Dialogue: 0,0:08:33.00,0:08:35.00,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:08:35.00,0:08:36.00,Default,,0,0,0,,Егер
Dialogue: 0,0:08:36.00,0:08:38.00,Default,,0,0,0,,Мен сізге уақыт бөлемін.
Dialogue: 0,0:08:38.00,0:08:39.00,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:39.00,0:08:40.00,Default,,0,0,0,,Нашар өмір
Dialogue: 0,0:08:41.00,0:08:42.00,Default,,0,0,0,,Хехехе
Dialogue: 0,0:08:42.00,0:08:44.00,Default,,0,0,0,,Эй, мен небәрі 5 жастамын
Dialogue: 0,0:08:44.00,0:08:46.00,Default,,0,0,0,,Бұл соншалықты үлкен мәселе емес.
Dialogue: 0,0:08:46.00,0:08:50.00,Default,,0,0,0,,Жарайды, ата-ананың көзқарасы сәл өзгеретін шығар.
Dialogue: 0,0:08:50.00,0:08:53.00,Default,,0,0,0,,Бұл жігіт мені жек көрсе, ол арзан нысана.
Dialogue: 0,0:08:53.00,0:08:55.00,Default,,0,0,0,,Сәлем! Маған көбірек көрсет!
Dialogue: 0,0:08:55.00,0:08:58.00,Default,,0,0,0,,Жоқ! Не болды?
Dialogue: 0,0:08:58.00,0:08:59.00,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:08:59.00,0:09:01.00,Default,,0,0,0,,Мен мұндай нәрсені істегенді жақсы көремін.
Dialogue: 0,0:09:01.00,0:09:03.00,Default,,0,0,0,,Саған не болды?
Dialogue: 0,0:09:03.00,0:09:04.00,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:09:04.00,0:09:06.00,Default,,0,0,0,,Мен мұны істегенді жақсы көремін!
Dialogue: 0,0:09:06.00,0:09:08.00,Default,,0,0,0,,Сәлем! Маған көбірек көрсет!
Dialogue: 0,0:09:08.00,0:09:10.00,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:14.00,0:09:17.00,Default,,0,0,0,,Жүр, бізге трусиларыңды көбірек көрсет!
Dialogue: 0,0:09:17.00,0:09:22.00,Default,,0,0,0,,Ууууууууууууууууууу
Dialogue: 0,0:09:25.00,0:09:27.00,Default,,0,0,0,,Бұл тым көп болды.
Dialogue: 0,0:09:28.00,0:09:30.00,Default,,0,0,0,,Кешіріңіз, Паккун.
Dialogue: 0,0:09:30.00,0:09:32.00,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:09:32.00,0:09:35.00,Default,,0,0,0,,Эй, сен неге кешірім сұрайсың?
Dialogue: 0,0:09:35.00,0:09:38.00,Default,,0,0,0,,Өйткені, өйткені
Dialogue: 0,0:09:39.00,0:09:41.00,Default,,0,0,0,,Осы сүйкімді менімен күнде болсаң
Dialogue: 0,0:09:41.00,0:09:44.00,Default,,0,0,0,,Бұзықтық жасағысы келетіні табиғи нәрсе, солай емес пе?
Dialogue: 0,0:09:46.00,0:09:49.00,Default,,0,0,0,,Мен білемін! Сені шыдатқаным үшін кінәлімін.
Dialogue: 0,0:09:49.00,0:09:50.00,Default,,0,0,0,,Жамандық жаман емес
Dialogue: 0,0:09:50.00,0:09:52.00,Default,,0,0,0,,Әй, сен не айтып тұрсың?
Dialogue: 0,0:09:52.00,0:09:54.00,Default,,0,0,0,,Сіз тентектік жасайтын адамдарды ұнатпайсыз деп ойлаймын.
Dialogue: 0,0:09:54.00,0:09:57.00,Default,,0,0,0,,Бір-бірін жақсы көретін екі адамның арасында көмектесуге болмайтын нәрселер
Dialogue: 0,0:09:57.00,0:10:00.00,Default,,0,0,0,,Рас, мен әлі дайын емес едім.
Dialogue: 0,0:10:00.00,0:10:02.00,Default,,0,0,0,,Бірақ мен бар күшімді саламын!
Dialogue: 0,0:10:02.00,0:10:05.00,Default,,0,0,0,,Кел, жамандыққа шалбар!
Dialogue: 0,0:10:07.00,0:10:09.00,Default,,0,0,0,,Алдымен алыңыз!
Dialogue: 0,0:10:23.00,0:10:26.00,Default,,0,0,0,,Жауапкершілікті алыңыз.
Dialogue: 0,0:10:27.00,0:10:31.00,Default,,0,0,0,,Міне, менің Йошикоға деген сезімім.
Dialogue: 0,0:10:31.00,0:10:35.00,Default,,0,0,0,,10 жыл өтсе де мүлде өзгерген жоқ.
Dialogue: 0,0:10:35.00,0:10:37.00,Default,,0,0,0,,Күлімсіреу шын мәнінде қорқынышты
Dialogue: 0,0:10:37.00,0:10:38.00,Default,,0,0,0,,не үшін шайқасып жүрсің?
Dialogue: 0,0:10:38.00,0:10:40.00,Default,,0,0,0,,Мен апельсиндерді ұмытып кетіппін!
Dialogue: 0,0:10:40.00,0:10:44.00,Default,,0,0,0,,Негізі бүгін, баяғыда, Ақкүн
Dialogue: 0,0:10:44.00,0:10:48.00,Default,,0,0,0,,Өзіңнің қалауыңа беріліп, маған қол көтергенде киген шалбарың осы!
Dialogue: 0,0:10:48.00,0:10:51.00,Default,,0,0,0,,Иә? Мен 5 жасымда да солай ма?
Dialogue: 0,0:10:51.00,0:10:54.00,Default,,0,0,0,,Бұл ұят, бірақ маған көрсет!
Dialogue: 0,0:10:54.00,0:10:58.00,Default,,0,0,0,,Бұл ұят, бірақ мен саған көрсетемін!
Dialogue: 0,0:11:02.00,0:11:03.00,Default,,0,0,0,,Енді қараңыз!
Dialogue: 0,0:11:03.00,0:11:04.00,Default,,0,0,0,,Аккун!
Dialogue: 0,0:11:04.00,0:11:06.00,Default,,0,0,0,,Шалбар туралы естеліктер!
Dialogue: 0,0:11:06.00,0:11:11.00,Default,,0,0,0,,Сіз ол кездегідей аңға жасай аласыз!
Dialogue: 0,0:11:11.00,0:11:12.00,Default,,0,0,0,,Жүріңдер, қараңдар! Кәне!
Dialogue: 0,0:11:12.00,0:11:13.00,Default,,0,0,0,,Кәне, қараңдар!
Dialogue: 0,0:11:13.00,0:11:14.00,Default,,0,0,0,,That's right.
Dialogue: 0,0:11:14.00,0:11:16.00,Default,,0,0,0,,Мен сені сол кездегідей ұрамын.
Dialogue: 0,0:11:16.00,0:11:17.00,Default,,0,0,0,,Кел, келе бер!
Dialogue: 0,0:11:17.00,0:11:20.00,Default,,0,0,0,,Бұл сезім ешқашан өзгермейді
Dialogue: 0,0:11:20.00,0:11:23.00,Default,,0,0,0,,Земені өлтір!
Dialogue: 0,0:11:50.00,0:11:53.00,Default,,0,0,0,,Шынайы сезімдерімді жасыру
Dialogue: 0,0:11:53.00,0:11:56.00,Default,,0,0,0,,Мені көрмедім деп жүрме, маған қара
Dialogue: 0,0:11:56.00,0:12:00.00,Default,,0,0,0,,Ой, көңілді болайық!
Dialogue: 0,0:12:00.00,0:12:01.00,Default,,0,0,0,,Сунга Сунга!
Dialogue: 0,0:12:01.00,0:12:03.00,Default,,0,0,0,,Қол ұстасып
Dialogue: 0,0:12:03.00,0:12:06.00,Default,,0,0,0,,Сана шыңында
Dialogue: 0,0:12:06.00,0:12:10.00,Default,,0,0,0,,Біраз уақыт қолыңнан келмесе де
Dialogue: 0,0:12:10.00,0:12:13.00,Default,,0,0,0,,Маған ұнайсың
Dialogue: 0,0:12:13.00,0:12:14.00,Default,,0,0,0,,Сунга Сунга!
Dialogue: 0,0:12:14.00,0:12:16.00,Default,,0,0,0,,Ояну болды
Dialogue: 0,0:12:16.00,0:12:19.00,Default,,0,0,0,,Мен өз шегімнен асып кетемін
Dialogue: 0,0:12:19.00,0:12:23.00,Default,,0,0,0,,Түйсік – ең жоғарғы.
Dialogue: 0,0:12:23.00,0:12:26.00,Default,,0,0,0,,Сіз қарсы тұра алмайсыз, солай ма?
Dialogue: 0,0:12:26.00,0:12:27.00,Default,,0,0,0,,Дәл!
Dialogue: 0,0:12:28.50,0:12:34.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory