Dialogue: 0,0:02:14.07,0:02:16.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:19.11,0:02:20.64,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:02:19.11,0:02:20.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:20.64,0:02:24.08,Default,,0000,0000,0000,,Оның болғаны өте өкінішті.
Dialogue: 0,0:02:20.64,0:02:24.08,Default,,0000,0000,0000,,Киіміңді ауыстыра аласың ба?
Dialogue: 0,0:02:24.08,0:02:27.08,Default,,0000,0000,0000,,Мен бәріңді әкелемін.
Dialogue: 0,0:02:24.08,0:02:27.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:27.08,0:02:29.58,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:02:27.08,0:02:29.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:29.58,0:02:31.58,Default,,0000,0000,0000,,Бәсен
Dialogue: 0,0:02:29.58,0:02:31.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:29.58,0:02:31.58,Default,,0000,0000,0000,,Масен
Dialogue: 0,0:02:29.58,0:02:31.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:29.58,0:02:31.58,Default,,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:02:31.58,0:02:34.59,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:02:31.58,0:02:34.59,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:31.58,0:02:34.59,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:02:31.58,0:02:34.59,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:31.58,0:02:34.59,Default,,0000,0000,0000,,Масен
Dialogue: 0,0:02:31.58,0:02:34.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:31.58,0:02:34.59,Default,,0000,0000,0000,,Tsk
Dialogue: 0,0:02:31.58,0:02:34.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:34.59,0:02:38.56,Default,,0000,0000,0000,,《Әрине
Dialogue: 0,0:02:34.59,0:02:38.56,Default,,0000,0000,0000,,Менің қожайыныма қауіп төнсе》
Dialogue: 0,0:02:38.56,0:02:42.56,Default,,0000,0000,0000,,《Сол себепті
Dialogue: 0,0:02:38.56,0:02:42.56,Default,,0000,0000,0000,,Айқайлауға еш себеп жоқ.
Dialogue: 0,0:02:44.66,0:02:46.60,Default,,0000,0000,0000,,Әдепсіздікпен
Dialogue: 0,0:02:44.66,0:02:46.60,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:02:44.66,0:02:46.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:46.60,0:02:48.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:46.60,0:02:48.57,Default,,0000,0000,0000,,Джинши
Dialogue: 0,0:02:46.60,0:02:48.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:46.60,0:02:48.57,Default,,0000,0000,0000,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:02:46.60,0:02:48.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:48.57,0:02:52.07,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:02:48.57,0:02:52.07,Default,,0000,0000,0000,,Қандай жолмен?
Dialogue: 0,0:02:48.57,0:02:52.07,Default,,0000,0000,0000,,Сіз сол жерге келдіңіз бе➡
Dialogue: 0,0:02:52.07,0:02:56.58,Default,,0000,0000,0000,,Бұл сенсің ғой, иә?
Dialogue: 0,0:02:52.07,0:02:56.58,Default,,0000,0000,0000,,Бағананың құлап бара жатқанын байқадыңыз ба?
Dialogue: 0,0:02:52.07,0:02:56.58,Default,,0000,0000,0000,,Түсіндіре аласыз ба?
Dialogue: 0,0:02:52.07,0:02:56.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:56.58,0:03:01.11,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:02:56.58,0:03:01.11,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:02:56.58,0:03:01.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:01.11,0:03:05.15,Default,,0000,0000,0000,,Яғни
Dialogue: 0,0:03:01.11,0:03:05.15,Default,,0000,0000,0000,,Бұл кездейсоқтықтардың қосындысынан болған апат болды.
Dialogue: 0,0:03:01.11,0:03:05.15,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:05.15,0:03:09.59,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,0:03:05.15,0:03:09.59,Default,,0000,0000,0000,,Бұл сәйкестік әдейі жасалғандай болды.
Dialogue: 0,0:03:05.15,0:03:09.59,Default,,0000,0000,0000,,Мен оған тартылғандай болдым.
Dialogue: 0,0:03:05.15,0:03:09.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:09.59,0:03:14.13,Default,,0000,0000,0000,,Осы мағынада
Dialogue: 0,0:03:09.59,0:03:14.13,Default,,0000,0000,0000,,Кездейсоқ емес
Dialogue: 0,0:03:09.59,0:03:14.13,Default,,0000,0000,0000,,Мұны оқиға деп атауға болады.
Dialogue: 0,0:03:09.59,0:03:14.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:14.13,0:03:15.60,Default,,0000,0000,0000,,Бірінші сәйкестік ➡
Dialogue: 0,0:03:15.60,0:03:20.60,Default,,0000,0000,0000,,Өткен жылы
Dialogue: 0,0:03:15.60,0:03:20.60,Default,,0000,0000,0000,,Азаматтық қоғамдағы жоғары лауазымды тұлға
Dialogue: 0,0:03:15.60,0:03:20.60,Default,,0000,0000,0000,,Кунен
Dialogue: 0,0:03:15.60,0:03:20.60,Default,,0000,0000,0000,,Құран-сама дүниеден өтті.
Dialogue: 0,0:03:15.60,0:03:20.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:23.10,0:03:26.14,Default,,0000,0000,0000,,Екінші,
Dialogue: 0,0:03:23.10,0:03:26.14,Default,,0000,0000,0000,,Қоймада мазасыздық орын алды➡
Dialogue: 0,0:03:26.14,0:03:29.61,Default,,0000,0000,0000,,Сонымен бірге
Dialogue: 0,0:03:26.14,0:03:29.61,Default,,0000,0000,0000,,Басқа жерде
Dialogue: 0,0:03:26.14,0:03:29.61,Default,,0000,0000,0000,,Салттық ыдыстар ұрланған.
Dialogue: 0,0:03:26.14,0:03:29.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:32.21,0:03:34.11,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:03:32.21,0:03:34.11,Default,,0000,0000,0000,,Үшіншісі - ➡
Dialogue: 0,0:03:34.11,0:03:38.59,Default,,0000,0000,0000,,Шамамен сол уақытта
Dialogue: 0,0:03:34.11,0:03:38.59,Default,,0000,0000,0000,,Салттық ыдыстарға жауапты адам
Dialogue: 0,0:03:34.11,0:03:38.59,Default,,0000,0000,0000,,Тамақтан уланып құладым.
Dialogue: 0,0:03:34.11,0:03:38.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:42.09,0:03:46.09,Default,,0000,0000,0000,,Олардың ешқайсысы
Dialogue: 0,0:03:42.09,0:03:46.09,Default,,0000,0000,0000,,Бұл біреудің ниетімен болды ма?
Dialogue: 0,0:03:46.09,0:03:48.13,Default,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:03:46.09,0:03:48.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:48.13,0:03:51.70,Default,,0000,0000,0000,,Әлі емес.
Dialogue: 0,0:03:48.13,0:03:51.70,Default,,0000,0000,0000,,Тағы бір нәрсе
Dialogue: 0,0:03:48.13,0:03:51.70,Default,,0000,0000,0000,,Маңызды нәрсе
Dialogue: 0,0:03:48.13,0:03:51.70,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:51.70,0:03:53.13,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:03:53.13,0:03:55.10,Default,,0000,0000,0000,,Ұрланған ғұрыптық ыдыстар
Dialogue: 0,0:03:53.13,0:03:55.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:55.10,0:03:59.57,Default,,0000,0000,0000,,Фестивальдарда
Dialogue: 0,0:03:55.10,0:03:59.57,Default,,0000,0000,0000,,Құрбандық үстелінің тіректері
Dialogue: 0,0:03:55.10,0:03:59.57,Default,,0000,0000,0000,,Металл сыммен көтеру➡
Dialogue: 0,0:03:59.57,0:04:02.58,Default,,0000,0000,0000,,Ол едендегі металл арматураға бекітілді.
Dialogue: 0,0:03:59.57,0:04:02.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:02.58,0:04:08.65,Default,,0000,0000,0000,,Егер сіз оны апатқа ұқсатқыңыз келсе
Dialogue: 0,0:04:02.58,0:04:08.65,Default,,0000,0000,0000,,Сіз негізгі нүкте болып табылатын металл арматураны мақсат етесіз.
Dialogue: 0,0:04:02.58,0:04:08.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:08.65,0:04:12.62,Default,,0000,0000,0000,,Егер осындай нәрсе ұрланса ше?
Dialogue: 0,0:04:08.65,0:04:12.62,Default,,0000,0000,0000,,Оны қайта жасамауға ешқандай себеп жоқ!
Dialogue: 0,0:04:12.62,0:04:15.59,Default,,0000,0000,0000,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:04:12.62,0:04:15.59,Default,,0000,0000,0000,,Сіз оны қайта жасаған шығарсыз.
Dialogue: 0,0:04:12.62,0:04:15.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:15.59,0:04:20.09,Default,,0000,0000,0000,,Фестивальдерге жарамды
Dialogue: 0,0:04:15.59,0:04:20.09,Default,,0000,0000,0000,,Ол әсем безендірілген деп есептеледі.
Dialogue: 0,0:04:15.59,0:04:20.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:20.09,0:04:23.60,Default,,0000,0000,0000,,Мен шеберді таныдым.
Dialogue: 0,0:04:20.09,0:04:23.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:20.09,0:04:23.60,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:20.09,0:04:23.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:23.60,0:04:26.10,Default,,0000,0000,0000,,Қайтыс болған металл оюшы?
Dialogue: 0,0:04:26.10,0:04:28.67,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:04:26.10,0:04:28.67,Default,,0000,0000,0000,,Ұрланған металл фитингтер ➡
Dialogue: 0,0:04:28.67,0:04:33.11,Default,,0000,0000,0000,,Оюшы арқылы
Dialogue: 0,0:04:28.67,0:04:33.11,Default,,0000,0000,0000,,Ол қайта жасалды.
Dialogue: 0,0:04:28.67,0:04:33.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:33.11,0:04:38.18,Default,,0000,0000,0000,,Егер
Dialogue: 0,0:04:33.11,0:04:38.18,Default,,0000,0000,0000,,Бұл металл арматура қызып кетуден бұзылады.
Dialogue: 0,0:04:33.11,0:04:38.18,Default,,0000,0000,0000,,Егер олай болса ше?
Dialogue: 0,0:04:38.18,0:04:40.18,Default,,0000,0000,0000,,｟Металл дыбыс｠
Dialogue: 0,0:04:41.58,0:04:46.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:04:41.58,0:04:46.09,Default,,0000,0000,0000,,Масен
Dialogue: 0,0:04:41.58,0:04:46.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:04:41.58,0:04:46.09,Default,,0000,0000,0000,,Идиот!
Dialogue: 0,0:04:41.58,0:04:46.09,Default,,0000,0000,0000,,Бұл металл.
Dialogue: 0,0:04:41.58,0:04:46.09,Default,,0000,0000,0000,,Осындай қызбамен...
Dialogue: 0,0:04:41.58,0:04:46.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:41.58,0:04:46.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:48.59,0:04:52.66,Default,,0000,0000,0000,,Қайтыс болған металл оюшы
Dialogue: 0,0:04:48.59,0:04:52.66,Default,,0000,0000,0000,,Егер сіз құпия техниканы қолдансаңыз➡
Dialogue: 0,0:04:52.66,0:04:56.16,Default,,0000,0000,0000,,Дәл оттың жанында
Dialogue: 0,0:04:52.66,0:04:56.16,Default,,0000,0000,0000,,Ол ериді.
Dialogue: 0,0:04:52.66,0:04:56.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:58.10,0:05:01.60,Default,,0000,0000,0000,,Сондай-ақ металл оюшы
Dialogue: 0,0:04:58.10,0:05:01.60,Default,,0000,0000,0000,,Мен бұл жоспарды жасадым.
Dialogue: 0,0:04:58.10,0:05:01.60,Default,,0000,0000,0000,,Бұл банда екенін білдіре ме?
Dialogue: 0,0:05:01.60,0:05:04.57,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:05:01.60,0:05:04.57,Default,,0000,0000,0000,,Ештеңені білмейтін шығар➡
Dialogue: 0,0:05:04.57,0:05:08.61,Default,,0000,0000,0000,,Сұралғандай
Dialogue: 0,0:05:04.57,0:05:08.61,Default,,0000,0000,0000,,Менің ойымша, ол металл арматураны жасады.
Dialogue: 0,0:05:04.57,0:05:08.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:08.61,0:05:12.61,Default,,0000,0000,0000,,Осы сияқты
Dialogue: 0,0:05:08.61,0:05:12.61,Default,,0000,0000,0000,,Оны арнайы металдан жасаңыз➡
Dialogue: 0,0:05:12.61,0:05:14.65,Default,,0000,0000,0000,,Маған...
Dialogue: 0,0:05:12.61,0:05:14.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:14.65,0:05:19.62,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,0:05:14.65,0:05:19.62,Default,,0000,0000,0000,,Фестивальде оқыс оқиға орын алса
Dialogue: 0,0:05:14.65,0:05:19.62,Default,,0000,0000,0000,,Шебер де күдіктенеді.
Dialogue: 0,0:05:14.65,0:05:19.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:19.62,0:05:22.09,Default,,0000,0000,0000,,Егер оны одан бұрын жойсаңыз➡
Dialogue: 0,0:05:22.09,0:05:25.09,Default,,0000,0000,0000,,Сондай-ақ клиенттің аты
Dialogue: 0,0:05:22.09,0:05:25.09,Default,,0000,0000,0000,,Төмен температурада балқитын металдарға арналған технология➡
Dialogue: 0,0:05:25.09,0:05:29.60,Default,,0000,0000,0000,,Қараңғыда жерленген
Dialogue: 0,0:05:25.09,0:05:29.60,Default,,0000,0000,0000,,Бұл өте ыңғайлы болар еді.
Dialogue: 0,0:05:25.09,0:05:29.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:29.60,0:05:32.10,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:05:29.60,0:05:32.10,Default,,0000,0000,0000,,Ол өлтірілді ме?
Dialogue: 0,0:05:32.10,0:05:34.63,Default,,0000,0000,0000,,Мен мұны түсінбеймін…
Dialogue: 0,0:05:32.10,0:05:34.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:34.63,0:05:39.21,Default,,0000,0000,0000,,Мұнда рух бар.
Dialogue: 0,0:05:34.63,0:05:39.21,Default,,0000,0000,0000,,Оқиға осылай етіп жасалған.
Dialogue: 0,0:05:34.63,0:05:39.21,Default,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:05:34.63,0:05:39.21,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:39.21,0:05:44.58,Default,,0000,0000,0000,,Кем дегенде
Dialogue: 0,0:05:39.21,0:05:44.58,Default,,0000,0000,0000,,Өлген шеберге
Dialogue: 0,0:05:39.21,0:05:44.58,Default,,0000,0000,0000,,Менен металл арматура жасауды сұраған адам ➡ болды
Dialogue: 0,0:05:44.58,0:05:48.08,Default,,0000,0000,0000,,Мен технологияның не екенін білдім.
Dialogue: 0,0:05:44.58,0:05:48.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:48.08,0:05:51.08,Default,,0000,0000,0000,,Мен айта аламын
Dialogue: 0,0:05:48.08,0:05:51.08,Default,,0000,0000,0000,,Барлығы осы
Dialogue: 0,0:05:48.08,0:05:51.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:51.08,0:05:53.09,Default,,0000,0000,0000,,Түсіндім
Dialogue: 0,0:05:51.08,0:05:53.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:53.09,0:05:58.09,Default,,0000,0000,0000,,《Солай болса да,
Dialogue: 0,0:05:53.09,0:05:58.09,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:05:53.09,0:05:58.09,Default,,0000,0000,0000,,Мен Джинджи-саманың сонда болады деп күтпедім.
Dialogue: 0,0:05:58.09,0:06:02.66,Default,,0000,0000,0000,,《Қалай болса
Dialogue: 0,0:05:58.09,0:06:02.66,Default,,0000,0000,0000,,Фестиваль жалғасатын болса...》
Dialogue: 0,0:06:02.66,0:06:05.70,Default,,0000,0000,0000,,《Сіз кімсіз?
Dialogue: 0,0:06:02.66,0:06:05.70,Default,,0000,0000,0000,,Бұл жігіт》
Dialogue: 0,0:06:05.70,0:06:11.67,Default,,0000,0000,0000,,《Осындай ауқымды оқиғада
Dialogue: 0,0:06:05.70,0:06:11.67,Default,,0000,0000,0000,,Өмірі нысанаға алынуға лайық адам…》
Dialogue: 0,0:06:13.11,0:06:16.08,Default,,0000,0000,0000,,《Білсем де, бұл жай ғана қиын болар еді.》
Dialogue: 0,0:06:22.08,0:06:25.08,Default,,0000,0000,0000,,《Бұл енді маған маңызды емес》
Dialogue: 0,0:06:31.69,0:06:34.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:31.69,0:06:34.09,Default,,0000,0000,0000,,Қақ
Dialogue: 0,0:06:31.69,0:06:34.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:34.09,0:06:37.10,Default,,0000,0000,0000,,Сяомао
Dialogue: 0,0:06:34.09,0:06:37.10,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:34.09,0:06:37.10,Default,,0000,0000,0000,,Су лалагүлі
Dialogue: 0,0:06:34.09,0:06:37.10,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:34.09,0:06:37.10,Default,,0000,0000,0000,,⚟Конеко⚞
Dialogue: 0,0:06:34.09,0:06:37.10,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:34.09,0:06:37.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:37.10,0:06:40.07,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:37.10,0:06:40.07,Default,,0000,0000,0000,,Есіктің ашылған дыбысы
Dialogue: 0,0:06:37.10,0:06:40.07,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:37.10,0:06:40.07,Default,,0000,0000,0000,,Құрметті тұтынушылар
Dialogue: 0,0:06:37.10,0:06:40.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:42.60,0:06:46.57,Default,,0000,0000,0000,,Рехаку
Dialogue: 0,0:06:42.60,0:06:46.57,Default,,0000,0000,0000,,Су лалагүлі
Dialogue: 0,0:06:42.60,0:06:46.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:42.60,0:06:46.57,Default,,0000,0000,0000,,Ли Бай
Dialogue: 0,0:06:42.60,0:06:46.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:42.60,0:06:46.57,Default,,0000,0000,0000,,Оқиғаның мысалы
Dialogue: 0,0:06:42.60,0:06:46.57,Default,,0000,0000,0000,,Суирей деп аталады
Dialogue: 0,0:06:42.60,0:06:46.57,Default,,0000,0000,0000,,Үкімет ханымы қатысты...
Dialogue: 0,0:06:42.60,0:06:46.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:46.57,0:06:49.08,Default,,0000,0000,0000,,《Сөйтсе де Суирей》
Dialogue: 0,0:06:49.08,0:06:51.08,Default,,0000,0000,0000,,Өлі табылды
Dialogue: 0,0:06:49.08,0:06:51.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:52.11,0:06:53.71,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:53.71,0:06:55.65,Default,,0000,0000,0000,,｟Есіктің тарс ашылған дыбысы｜
Dialogue: 0,0:06:55.65,0:06:58.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:55.65,0:06:58.08,Default,,0000,0000,0000,,Ли Бай
Dialogue: 0,0:06:55.65,0:06:58.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:55.65,0:06:58.08,Default,,0000,0000,0000,,Джёбу бөлмеге кірген кезде➡
Dialogue: 0,0:06:58.08,0:07:01.09,Default,,0000,0000,0000,,Ол уланып, құлап қалған сияқты.
Dialogue: 0,0:06:58.08,0:07:01.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:01.09,0:07:05.59,Default,,0000,0000,0000,,Медициналық сарапшы аутопсияны аяқтады.
Dialogue: 0,0:07:01.09,0:07:05.59,Default,,0000,0000,0000,,Өлгені де расталды.
Dialogue: 0,0:07:01.09,0:07:05.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:05.59,0:07:07.56,Default,,0000,0000,0000,,Не болады?
Dialogue: 0,0:07:07.56,0:07:11.56,Default,,0000,0000,0000,,Табыт
Dialogue: 0,0:07:07.56,0:07:11.56,Default,,0000,0000,0000,,Ертең ол табытта қалады.
Dialogue: 0,0:07:07.56,0:07:11.56,Default,,0000,0000,0000,,Өртеп жібермейсің бе?
Dialogue: 0,0:07:11.56,0:07:14.10,Default,,0000,0000,0000,,Басқа мүдделі тараптар кімдер?
Dialogue: 0,0:07:14.10,0:07:17.10,Default,,0000,0000,0000,,Басқасы жоқ
Dialogue: 0,0:07:14.10,0:07:17.10,Default,,0000,0000,0000,,Бір ғана Сүйрей бар.
Dialogue: 0,0:07:14.10,0:07:17.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:18.67,0:07:22.61,Default,,0000,0000,0000,,《Осылай
Dialogue: 0,0:07:18.67,0:07:22.61,Default,,0000,0000,0000,,Кішкентай мәліметтер
Dialogue: 0,0:07:18.67,0:07:22.61,Default,,0000,0000,0000,,Жалғыз өзің бе? 》
Dialogue: 0,0:07:22.61,0:07:26.58,Default,,0000,0000,0000,,Қалай болғанда да, мәселе шешілді.
Dialogue: 0,0:07:22.61,0:07:26.58,Default,,0000,0000,0000,,Олай болса
Dialogue: 0,0:07:22.61,0:07:26.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:29.08,0:07:32.05,Default,,0000,0000,0000,,《Ол уланып өлді ме? 》
Dialogue: 0,0:07:32.05,0:07:34.59,Default,,0000,0000,0000,,《Шынымен
Dialogue: 0,0:07:32.05,0:07:34.59,Default,,0000,0000,0000,,Бұл соңы ма? 》
Dialogue: 0,0:07:34.59,0:07:37.09,Default,,0000,0000,0000,,《Жоқ
Dialogue: 0,0:07:34.59,0:07:37.09,Default,,0000,0000,0000,,Бұған дейін➡
Dialogue: 0,0:07:37.09,0:07:41.16,Default,,0000,0000,0000,,Суирей
Dialogue: 0,0:07:37.09,0:07:41.16,Default,,0000,0000,0000,,Ол өз-өзіне қол жұмсайтын әйел ме? 》
Dialogue: 0,0:07:41.16,0:07:44.06,Default,,0000,0000,0000,,《Лтаргиялық бет
Dialogue: 0,0:07:41.16,0:07:44.06,Default,,0000,0000,0000,,Абайсыз көзқарас – ➡
Dialogue: 0,0:07:44.06,0:07:47.60,Default,,0000,0000,0000,,Баратын жер жоқ
Dialogue: 0,0:07:44.06,0:07:47.60,Default,,0000,0000,0000,,Себебі сіз білесіз бе? 》
Dialogue: 0,0:07:47.60,0:07:51.67,Default,,0000,0000,0000,,《Бірақ
Dialogue: 0,0:07:47.60,0:07:51.67,Default,,0000,0000,0000,,Бұл сынақ үні...》
Dialogue: 0,0:07:51.67,0:07:54.67,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:51.67,0:07:54.67,Default,,0000,0000,0000,,Суирей
Dialogue: 0,0:07:51.67,0:07:54.67,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:51.67,0:07:54.67,Default,,0000,0000,0000,,｜Мен мұнда таңғы даңқтарды отырғызамын｠
Dialogue: 0,0:07:59.58,0:08:02.05,Default,,0000,0000,0000,,Жаңғыру
Dialogue: 0,0:07:59.58,0:08:02.05,Default,,0000,0000,0000,,Қайта тірілу медицинасы
Dialogue: 0,0:07:59.58,0:08:02.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:04.65,0:08:06.19,Default,,0000,0000,0000,,(
Dialogue: 0,0:08:04.65,0:08:06.19,Default,,0000,0000,0000,,Есікті ашу дыбысы
Dialogue: 0,0:08:04.65,0:08:06.19,Default,,0000,0000,0000,,)
Dialogue: 0,0:08:06.19,0:08:07.55,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:08:06.19,0:08:07.55,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:08:06.19,0:08:07.55,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:08:06.19,0:08:07.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:07.55,0:08:10.59,Default,,0000,0000,0000,,《Ойлану жақсы емес.
Dialogue: 0,0:08:07.55,0:08:10.59,Default,,0000,0000,0000,,Мен нақты айта алмаймын.
Dialogue: 0,0:08:10.59,0:08:13.06,Default,,0000,0000,0000,,(
Dialogue: 0,0:08:10.59,0:08:13.06,Default,,0000,0000,0000,,Есікті ашу дыбысы
Dialogue: 0,0:08:10.59,0:08:13.06,Default,,0000,0000,0000,,)
Dialogue: 0,0:08:10.59,0:08:13.06,Default,,0000,0000,0000,,Джиндзи мырза!
Dialogue: 0,0:08:10.59,0:08:13.06,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:08:10.59,0:08:13.06,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:08:10.59,0:08:13.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:13.06,0:08:15.06,Default,,0000,0000,0000,,Менің сенен сұрайтыным бар!
Dialogue: 0,0:08:13.06,0:08:15.06,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:08:13.06,0:08:15.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:15.06,0:08:17.10,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:08:15.06,0:08:17.10,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:08:17.10,0:08:20.10,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:08:17.10,0:08:20.10,Default,,0000,0000,0000,,А...
Dialogue: 0,0:08:17.10,0:08:20.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:20.10,0:08:24.14,Default,,0000,0000,0000,,Суйрейге сараптама жасаған медициналық қызметкермен
Dialogue: 0,0:08:20.10,0:08:24.14,Default,,0000,0000,0000,,Мен сенімен сөйлескім келеді.
Dialogue: 0,0:08:20.10,0:08:24.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:24.14,0:08:26.17,Default,,0000,0000,0000,,Мәйітханада
Dialogue: 0,0:08:24.14,0:08:26.17,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:26.17,0:08:28.71,Default,,0000,0000,0000,,Неге күлесің?
Dialogue: 0,0:08:26.17,0:08:28.71,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:26.17,0:08:28.71,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:28.71,0:08:31.08,Default,,0000,0000,0000,,《Қызығушылығым басым болды》
Dialogue: 0,0:08:37.58,0:08:41.05,Default,,0000,0000,0000,,Джинджи мырзаға ештеңе
Dialogue: 0,0:08:37.58,0:08:41.05,Default,,0000,0000,0000,,Ішке кірмесеңіз де...
Dialogue: 0,0:08:37.58,0:08:41.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:41.05,0:08:44.06,Default,,0000,0000,0000,,Дәріхана кірсе
Dialogue: 0,0:08:41.05,0:08:44.06,Default,,0000,0000,0000,,Мен де барамын
Dialogue: 0,0:08:41.05,0:08:44.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:44.06,0:08:47.09,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:08:44.06,0:08:47.09,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:08:44.06,0:08:47.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:47.09,0:08:48.56,Default,,0000,0000,0000,,Хаха...
Dialogue: 0,0:08:47.09,0:08:48.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:54.10,0:08:56.64,Default,,0000,0000,0000,,Конеко
Dialogue: 0,0:08:54.10,0:08:56.64,Default,,0000,0000,0000,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:08:54.10,0:08:56.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:56.64,0:08:59.07,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:08:56.64,0:08:59.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:59.07,0:09:02.07,Default,,0000,0000,0000,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:08:59.07,0:09:02.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:02.07,0:09:05.58,Default,,0000,0000,0000,,《Күтілгендей
Dialogue: 0,0:09:02.07,0:09:05.58,Default,,0000,0000,0000,,Бұл медициналық қызметкер аутопсия жасайды...》
Dialogue: 0,0:09:05.58,0:09:08.58,Default,,0000,0000,0000,,《Жақсы сөйлеп тұрған шенеунік
Dialogue: 0,0:09:05.58,0:09:08.58,Default,,0000,0000,0000,,Өлген➡
Dialogue: 0,0:09:08.58,0:09:13.05,Default,,0000,0000,0000,,Наокатсу
Dialogue: 0,0:09:08.58,0:09:13.05,Default,,0000,0000,0000,,Өйткені мені күнәкар адамдай қарады.
Dialogue: 0,0:09:08.58,0:09:13.05,Default,,0000,0000,0000,,Сіз де арық боласыз》
Dialogue: 0,0:09:13.05,0:09:16.12,Default,,0000,0000,0000,,《Бірақ
Dialogue: 0,0:09:13.05,0:09:16.12,Default,,0000,0000,0000,,Барлығы осы ма? 》
Dialogue: 0,0:09:16.12,0:09:19.66,Default,,0000,0000,0000,,Тікелей сұраңыз
Dialogue: 0,0:09:16.12,0:09:19.66,Default,,0000,0000,0000,,Сот ханымы ішкен уға➡
Dialogue: 0,0:09:19.66,0:09:22.56,Default,,0000,0000,0000,,Мандараке
Dialogue: 0,0:09:19.66,0:09:22.56,Default,,0000,0000,0000,,Мандала гүлі
Dialogue: 0,0:09:19.66,0:09:22.56,Default,,0000,0000,0000,,Ол пайдаланылмады ма?
Dialogue: 0,0:09:22.56,0:09:24.56,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:09:22.56,0:09:24.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:24.56,0:09:27.57,Default,,0000,0000,0000,,Умая➡ үстіндегі шағын төбе
Dialogue: 0,0:09:27.57,0:09:31.57,Default,,0000,0000,0000,,Мандала гүлдері сол жерде
Dialogue: 0,0:09:27.57,0:09:31.57,Default,,0000,0000,0000,,Оны сен отырғызбадың ба?
Dialogue: 0,0:09:31.57,0:09:33.57,Default,,0000,0000,0000,,Өте улы болғанымен➡
Dialogue: 0,0:09:33.57,0:09:36.58,Default,,0000,0000,0000,,Тиісті дозаларда ол анестетик ретінде әрекет етеді.
Dialogue: 0,0:09:33.57,0:09:36.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:36.58,0:09:40.68,Default,,0000,0000,0000,,Дәрігер кабинетіне
Dialogue: 0,0:09:36.58,0:09:40.68,Default,,0000,0000,0000,,Мен мұның жоқтығын елестете алмаймын.
Dialogue: 0,0:09:36.58,0:09:40.68,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:40.68,0:09:45.59,Default,,0000,0000,0000,,《Мандала гүлі
Dialogue: 0,0:09:40.68,0:09:45.59,Default,,0000,0000,0000,,Ол ақ таңғы даңқ гүліне ұқсайды.
Dialogue: 0,0:09:45.59,0:09:47.62,Default,,0000,0000,0000,,Мен нақты айта алмаймын...
Dialogue: 0,0:09:45.59,0:09:47.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:47.62,0:09:52.59,Default,,0000,0000,0000,,Симптомдары бойынша
Dialogue: 0,0:09:47.62,0:09:52.59,Default,,0000,0000,0000,,Бұл өте ықтимал болса да
Dialogue: 0,0:09:47.62,0:09:52.59,Default,,0000,0000,0000,,Көрсетілмейді
Dialogue: 0,0:09:47.62,0:09:52.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:52.59,0:09:56.06,Default,,0000,0000,0000,,Оны шынымен тексеріп көрейік.
Dialogue: 0,0:09:52.59,0:09:56.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:04.64,0:10:06.17,Default,,0000,0000,0000,,Hmph
Dialogue: 0,0:10:04.64,0:10:06.17,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:10:06.17,0:10:08.21,Default,,0000,0000,0000,,Хмм…
Dialogue: 0,0:10:06.17,0:10:08.21,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:08.21,0:10:10.61,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:10:08.21,0:10:10.61,Default,,0000,0000,0000,,Сіз не істейсіз?
Dialogue: 0,0:10:10.61,0:10:12.61,Default,,0000,0000,0000,,Өтінемін, үндемеңіз және қараңыз!
Dialogue: 0,0:10:12.61,0:10:16.12,Default,,0000,0000,0000,,Эй, сен келгеннен бері бәрі осылай болып тұр, иә?
Dialogue: 0,0:10:12.61,0:10:16.12,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:10:12.61,0:10:16.12,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:12.61,0:10:16.12,Default,,0000,0000,0000,,Табыттың қақпағының ашылған дыбысы
Dialogue: 0,0:10:12.61,0:10:16.12,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:16.12,0:10:18.58,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:10:16.12,0:10:18.58,Default,,0000,0000,0000,,Ашылды
Dialogue: 0,0:10:16.12,0:10:18.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:21.59,0:10:23.09,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:21.59,0:10:23.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:23.09,0:10:27.09,Default,,0000,0000,0000,,Суирейя
Dialogue: 0,0:10:23.09,0:10:27.09,Default,,0000,0000,0000,,Жоқ?
Dialogue: 0,0:10:27.09,0:10:30.13,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:10:27.09,0:10:30.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:30.13,0:10:34.10,Default,,0000,0000,0000,,Шынында да…
Dialogue: 0,0:10:30.13,0:10:34.10,Default,,0000,0000,0000,,Бұл сөзсіз Суирей болды.
Dialogue: 0,0:10:30.13,0:10:34.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:34.10,0:10:36.60,Default,,0000,0000,0000,,Бұл шынымен де Суйрей болды ма?
Dialogue: 0,0:10:36.60,0:10:40.57,Default,,0000,0000,0000,,​​Суйрейді қателесуім мүмкін емес.
Dialogue: 0,0:10:36.60,0:10:40.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:42.07,0:10:45.54,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:42.07,0:10:45.54,Default,,0000,0000,0000,,Медицина қызметкерінің дауысы
Dialogue: 0,0:10:42.07,0:10:45.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:42.07,0:10:45.54,Default,,0000,0000,0000,,Оның тамыр соғысы да, жүрегі де қозғалмады.
Dialogue: 0,0:10:42.07,0:10:45.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:45.54,0:10:48.11,Default,,0000,0000,0000,,Бұл әдемі болды.
Dialogue: 0,0:10:45.54,0:10:48.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:48.11,0:10:51.68,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,0:10:48.11,0:10:51.68,Default,,0000,0000,0000,,Ол жақсы пайдаланылды.
Dialogue: 0,0:10:48.11,0:10:51.68,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:51.68,0:10:54.59,Default,,0000,0000,0000,,Удың шынайы табиғатын түсіндіру үшін➡
Dialogue: 0,0:10:54.59,0:10:58.09,Default,,0000,0000,0000,,Мәйітті кесу
Dialogue: 0,0:10:54.59,0:10:58.09,Default,,0000,0000,0000,,ойыма да келмеген
Dialogue: 0,0:10:54.59,0:10:58.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:58.09,0:11:00.59,Default,,0000,0000,0000,,Суирей де
Dialogue: 0,0:10:58.09,0:11:00.59,Default,,0000,0000,0000,,Мен мұны күттім.
Dialogue: 0,0:10:58.09,0:11:00.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:00.59,0:11:02.09,Default,,0000,0000,0000,,Сіз!!
Dialogue: 0,0:11:02.09,0:11:06.10,Default,,0000,0000,0000,,Суирей пайдаланған нәрсе болды
Dialogue: 0,0:11:02.09,0:11:06.10,Default,,0000,0000,0000,,Мандала гүлдері ғана емес
Dialogue: 0,0:11:02.09,0:11:06.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:06.10,0:11:12.10,Default,,0000,0000,0000,,Егер сіз дәрігерлік кеңседе қоймадағы дәрілердің санын тексерсеңіз,
Dialogue: 0,0:11:06.10,0:11:12.10,Default,,0000,0000,0000,,Менің не пайдаланғанымды білесіз деп ойлаймын.
Dialogue: 0,0:11:06.10,0:11:12.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:12.10,0:11:14.17,Default,,0000,0000,0000,,《Егер мен осы медицина қызметкерін кінәлайтын болсам➡
Dialogue: 0,0:11:14.17,0:11:17.58,Default,,0000,0000,0000,,Дәрілік заттарды басқару
Dialogue: 0,0:11:14.17,0:11:17.58,Default,,0000,0000,0000,,Бұл жеткіліксіз болды ма?
Dialogue: 0,0:11:17.58,0:11:20.08,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:11:17.58,0:11:20.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:20.08,0:11:22.58,Default,,0000,0000,0000,,Денелердің айырмашылығы неде?
Dialogue: 0,0:11:20.08,0:11:22.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:22.58,0:11:26.59,Default,,0000,0000,0000,,Каноке
Dialogue: 0,0:11:22.58,0:11:26.59,Default,,0000,0000,0000,,Табытты өртеп жіберсек те
Dialogue: 0,0:11:22.58,0:11:26.59,Default,,0000,0000,0000,,Мазмұны бос болса, адамдар күдіктене бастайды.
Dialogue: 0,0:11:22.58,0:11:26.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:26.59,0:11:30.59,Default,,0000,0000,0000,,Жаңа табыттың ішінде
Dialogue: 0,0:11:26.59,0:11:30.59,Default,,0000,0000,0000,,Ауыстырылатын мәйітті әкеліңіз➡
Dialogue: 0,0:11:30.59,0:11:32.56,Default,,0000,0000,0000,,Менің ойымша, олар оны өзгертті.
Dialogue: 0,0:11:30.59,0:11:32.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:32.56,0:11:37.13,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:11:32.56,0:11:37.13,Default,,0000,0000,0000,,Сүйрейдің денесі не болады?
Dialogue: 0,0:11:32.56,0:11:37.13,Default,,0000,0000,0000,,Шығарсаң да көзге түседі.
Dialogue: 0,0:11:32.56,0:11:37.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:37.13,0:11:39.57,Default,,0000,0000,0000,,Оны шығарудың қажеті жоқ.
Dialogue: 0,0:11:37.13,0:11:39.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:39.57,0:11:41.57,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:11:48.57,0:11:52.11,Default,,0000,0000,0000,,Үйге өзім жаяу бардым.
Dialogue: 0,0:11:48.57,0:11:52.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:48.57,0:11:52.11,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:11:48.57,0:11:52.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:52.11,0:11:54.61,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:52.11,0:11:54.61,Default,,0000,0000,0000,,Ол өлген жоқ па?
Dialogue: 0,0:11:54.61,0:11:58.12,Default,,0000,0000,0000,,Біреу өлгендей
Dialogue: 0,0:11:54.61,0:11:58.12,Default,,0000,0000,0000,,Саған көрсететін дәрім бар.
Dialogue: 0,0:11:54.61,0:11:58.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:58.12,0:11:59.65,Default,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:11:59.65,0:12:03.59,Default,,0000,0000,0000,,Мен ол туралы естідім.
Dialogue: 0,0:11:59.65,0:12:03.59,Default,,0000,0000,0000,,Бұл елес
Dialogue: 0,0:11:59.65,0:12:03.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:03.59,0:12:05.09,Default,,0000,0000,0000,,Бұл қандай нәрсе?
Dialogue: 0,0:12:05.09,0:12:07.59,Default,,0000,0000,0000,,Алыс шет елде дейді.
Dialogue: 0,0:12:05.09,0:12:07.59,Default,,0000,0000,0000,,Дәрі ➡
Dialogue: 0,0:12:07.59,0:12:12.60,Default,,0000,0000,0000,,Біреуді бір рет өлтіріңіз
Dialogue: 0,0:12:07.59,0:12:12.60,Default,,0000,0000,0000,,Біраз уақыттан кейін
Dialogue: 0,0:12:07.59,0:12:12.60,Default,,0000,0000,0000,,Қайта жаңғыртуға болады дейді.
Dialogue: 0,0:12:07.59,0:12:12.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:12.60,0:12:15.10,Default,,0000,0000,0000,,Мәліметтерді білмеймін, бірақ➡
Dialogue: 0,0:12:15.10,0:12:19.07,Default,,0000,0000,0000,,Мандала гүлдері мен материалдары
Dialogue: 0,0:12:15.10,0:12:19.07,Default,,0000,0000,0000,,Қапшық балық пайдаланылады деп естідім.
Dialogue: 0,0:12:15.10,0:12:19.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:21.67,0:12:22.68,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:12:21.67,0:12:22.68,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:22.68,0:12:24.11,Default,,0000,0000,0000,,Конеко?
Dialogue: 0,0:12:24.11,0:12:28.11,Default,,0000,0000,0000,,Гаошун мырза
Dialogue: 0,0:12:24.11,0:12:28.11,Default,,0000,0000,0000,,Бос табыт
Dialogue: 0,0:12:24.11,0:12:28.11,Default,,0000,0000,0000,,Сіз оны қарастыра аласыз ба?
Dialogue: 0,0:12:28.11,0:12:29.58,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:12:28.11,0:12:29.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:35.59,0:12:39.09,Default,,0000,0000,0000,,Тырнақ
Dialogue: 0,0:12:35.59,0:12:39.09,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:12:35.59,0:12:39.09,Default,,0000,0000,0000,,Тырнақ белгілері
Dialogue: 0,0:12:35.59,0:12:39.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:39.09,0:12:43.16,Default,,0000,0000,0000,,Мүмкін өлі Суирей
Dialogue: 0,0:12:39.09,0:12:43.16,Default,,0000,0000,0000,,Менің ойымша, ол сонда болды.
Dialogue: 0,0:12:39.09,0:12:43.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:43.16,0:12:47.60,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:12:43.16,0:12:47.60,Default,,0000,0000,0000,,Біреу көмекке келді
Dialogue: 0,0:12:43.16,0:12:47.60,Default,,0000,0000,0000,,Табыт ашылған кезде➡
Dialogue: 0,0:12:47.60,0:12:50.10,Default,,0000,0000,0000,,Дем алды
Dialogue: 0,0:12:47.60,0:12:50.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:50.10,0:12:53.11,Default,,0000,0000,0000,,Басқа мәйіт бар табыт.
Dialogue: 0,0:12:50.10,0:12:53.11,Default,,0000,0000,0000,,Оның орнына қойыңыз➡
Dialogue: 0,0:12:53.11,0:12:57.08,Default,,0000,0000,0000,,Кәсіпкер атын жамылып, кетіп қалды.
Dialogue: 0,0:12:53.11,0:12:57.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:59.08,0:13:02.62,Default,,0000,0000,0000,,Мұндай дәлелденбеген әдіс
Dialogue: 0,0:12:59.08,0:13:02.62,Default,,0000,0000,0000,,Сіз оны алдыңыз ба?
Dialogue: 0,0:13:02.62,0:13:05.65,Default,,0000,0000,0000,,Кез келген жағдайда
Dialogue: 0,0:13:02.62,0:13:05.65,Default,,0000,0000,0000,,Егер табылса
Dialogue: 0,0:13:02.62,0:13:05.65,Default,,0000,0000,0000,,Бұл өлім жазасы бола ма?
Dialogue: 0,0:13:05.65,0:13:08.19,Default,,0000,0000,0000,,Мен бәс тігуге дайын едім
Dialogue: 0,0:13:05.65,0:13:08.19,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:08.19,0:13:11.09,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:13:08.19,0:13:11.09,Default,,0000,0000,0000,,Сіздің жағдайда
Dialogue: 0,0:13:08.19,0:13:11.09,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:13:08.19,0:13:11.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:11.09,0:13:13.59,Default,,0000,0000,0000,,Бұл жерде дененің жоқтығы ➡ дегенді білдіреді
Dialogue: 0,0:13:13.59,0:13:16.10,Default,,0000,0000,0000,,Суирей бұл
Dialogue: 0,0:13:13.59,0:13:16.10,Default,,0000,0000,0000,,Бұл бәс тігуде ұтқаныңызды білдіреді.
Dialogue: 0,0:13:13.59,0:13:16.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:16.10,0:13:21.10,Default,,0000,0000,0000,,Ауыстырылған мәйіт өртенгеннен кейін
Dialogue: 0,0:13:16.10,0:13:21.10,Default,,0000,0000,0000,,Бұл толық жеңіс болуы керек еді...
Dialogue: 0,0:13:16.10,0:13:21.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:21.10,0:13:24.60,Default,,0000,0000,0000,,Хехе…
Dialogue: 0,0:13:21.10,0:13:24.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:21.10,0:13:24.60,Default,,0000,0000,0000,,《Мұндай еліктеу
Dialogue: 0,0:13:21.10,0:13:24.60,Default,,0000,0000,0000,,Бұған жол бермеу》
Dialogue: 0,0:13:24.60,0:13:29.18,Default,,0000,0000,0000,,Хи хи хи...
Dialogue: 0,0:13:24.60,0:13:29.18,Default,,0000,0000,0000,,Тірі болсаң, сенімен танысқым келеді.
Dialogue: 0,0:13:24.60,0:13:29.18,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:29.18,0:13:31.24,Default,,0000,0000,0000,,``Бұл мені ұстау үшін.''
Dialogue: 0,0:13:29.18,0:13:31.24,Default,,0000,0000,0000,,Жоқ》
Dialogue: 0,0:13:31.24,0:13:34.58,Default,,0000,0000,0000,,《Көптеген оқиғалар
Dialogue: 0,0:13:31.24,0:13:34.58,Default,,0000,0000,0000,,Жазатайым оқиға ретінде жасырылған білім➡
Dialogue: 0,0:13:34.58,0:13:37.08,Default,,0000,0000,0000,,Оны алып тастау батылдық》
Dialogue: 0,0:13:37.08,0:13:40.59,Default,,0000,0000,0000,,《Менің өмірім бәрінен де жоғары
Dialogue: 0,0:13:37.08,0:13:40.59,Default,,0000,0000,0000,,Тіпті бәс тігу бағасымен➡
Dialogue: 0,0:13:40.59,0:13:43.56,Default,,0000,0000,0000,,Барлығын алдауға тырысты
Dialogue: 0,0:13:40.59,0:13:43.56,Default,,0000,0000,0000,,Такаса》
Dialogue: 0,0:13:45.59,0:13:48.09,Default,,0000,0000,0000,,《Осындай адам
Dialogue: 0,0:13:45.59,0:13:48.09,Default,,0000,0000,0000,,Тез
Dialogue: 0,0:13:45.59,0:13:48.09,Default,,0000,0000,0000,,Білсін➡
Dialogue: 0,0:13:48.09,0:13:50.06,Default,,0000,0000,0000,,Бұл қызық болмас еді! 》
Dialogue: 0,0:13:50.06,0:13:52.10,Default,,0000,0000,0000,,Хаха...
Dialogue: 0,0:13:50.06,0:13:52.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:52.10,0:13:56.57,Default,,0000,0000,0000,,《Қайта тірілу эликсирі!
Dialogue: 0,0:13:52.10,0:13:56.57,Default,,0000,0000,0000,,Мен сізге оны жасауды міндетті түрде үйретемін! 》
Dialogue: 0,0:13:56.57,0:14:00.57,Default,,0000,0000,0000,,Хаха...
Dialogue: 0,0:13:56.57,0:14:00.57,Default,,0000,0000,0000,,《Жоғалып кетті ме!?》
Dialogue: 0,0:14:00.57,0:14:04.58,Default,,0000,0000,0000,,Аа…
Dialogue: 0,0:14:00.57,0:14:04.58,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:14:00.57,0:14:04.58,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:14:00.57,0:14:04.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:04.58,0:14:06.58,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:14:04.58,0:14:06.58,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:14:06.58,0:14:11.58,Default,,0000,0000,0000,,Менің аяғымды тігіп бере аласыз ба?
Dialogue: 0,0:14:06.58,0:14:11.58,Default,,0000,0000,0000,,Бұл жара ашылғандай.
Dialogue: 0,0:14:06.58,0:14:11.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:11.58,0:14:14.05,Default,,0000,0000,0000,,Тез айт!
Dialogue: 0,0:14:19.69,0:14:21.66,Default,,0000,0000,0000,,Луран
Dialogue: 0,0:14:19.69,0:14:21.66,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:19.69,0:14:21.66,Default,,0000,0000,0000,,Қызметші
Dialogue: 0,0:14:19.69,0:14:21.66,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:19.69,0:14:21.66,Default,,0000,0000,0000,,Лоуран-сама
Dialogue: 0,0:14:19.69,0:14:21.66,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:37.58,0:14:42.58,Default,,0000,0000,0000,,《Соңында
Dialogue: 0,0:14:37.58,0:14:42.58,Default,,0000,0000,0000,,Суирей туралы
Dialogue: 0,0:14:37.58,0:14:42.58,Default,,0000,0000,0000,,Жасырын түрде аяқталды》
Dialogue: 0,0:14:42.58,0:14:47.55,Default,,0000,0000,0000,,Сүйрей есімді сарай ханымы туралы
Dialogue: 0,0:14:42.58,0:14:47.55,Default,,0000,0000,0000,,Көп түсініксіз нүктелер бар》
Dialogue: 0,0:14:47.55,0:14:52.09,Default,,0000,0000,0000,,《Медицина қызметкерінің айтуы бойынша
Dialogue: 0,0:14:47.55,0:14:52.09,Default,,0000,0000,0000,,Оның ұстазы
Dialogue: 0,0:14:47.55,0:14:52.09,Default,,0000,0000,0000,,Ол оның қамқоршысы болды.
Dialogue: 0,0:14:52.09,0:14:57.56,Default,,0000,0000,0000,,《Бірнеше жыл бұрын
Dialogue: 0,0:14:52.09,0:14:57.56,Default,,0000,0000,0000,,Оның талантын байқады
Dialogue: 0,0:14:52.09,0:14:57.56,Default,,0000,0000,0000,,Оны асырап алған қызы ретінде қабылдаған көрінеді➡
Dialogue: 0,0:14:57.56,0:15:00.57,Default,,0000,0000,0000,,Бұған дейін
Dialogue: 0,0:14:57.56,0:15:00.57,Default,,0000,0000,0000,,Ол шынымен түсінбейтінін айтады.
Dialogue: 0,0:15:00.57,0:15:03.57,Default,,0000,0000,0000,,Бұл ұзақ шайқас болатын сияқты.
Dialogue: 0,0:15:00.57,0:15:03.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:03.57,0:15:06.07,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:03.57,0:15:06.07,Default,,0000,0000,0000,,Аяқ дыбыстары
Dialogue: 0,0:15:03.57,0:15:06.07,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:06.07,0:15:08.54,Default,,0000,0000,0000,,Мен Конеконы шығарып жібердім.
Dialogue: 0,0:15:06.07,0:15:08.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:08.54,0:15:10.54,Default,,0000,0000,0000,,Әрқашан жаман
Dialogue: 0,0:15:08.54,0:15:10.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:10.54,0:15:14.61,Default,,0000,0000,0000,,Жараның қайтадан ашылуына жол бермеңіз.
Dialogue: 0,0:15:10.54,0:15:14.61,Default,,0000,0000,0000,,Мұны істеуге болмайды.
Dialogue: 0,0:15:10.54,0:15:14.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:14.61,0:15:16.65,Default,,0000,0000,0000,,О
Dialogue: 0,0:15:14.61,0:15:16.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:16.65,0:15:20.05,Default,,0000,0000,0000,,《Алайда
Dialogue: 0,0:15:16.65,0:15:20.05,Default,,0000,0000,0000,,Жарақат тек алаңдататын нәрсе емес.
Dialogue: 0,0:15:20.05,0:15:23.06,Default,,0000,0000,0000,,Лакан
Dialogue: 0,0:15:20.05,0:15:23.06,Default,,0000,0000,0000,,《Біртүрлі
Dialogue: 0,0:15:20.05,0:15:23.06,Default,,0000,0000,0000,,Архат деп те аталады》
Dialogue: 0,0:15:25.09,0:15:28.06,Default,,0000,0000,0000,,«Әке болу
Dialogue: 0,0:15:25.09,0:15:28.06,Default,,0000,0000,0000,,Бұл анық➡
Dialogue: 0,0:15:28.06,0:15:31.53,Default,,0000,0000,0000,,Фармацевттің көзқарасына қарағанда
Dialogue: 0,0:15:28.06,0:15:31.53,Default,,0000,0000,0000,,Қандай да бір себеп болуы керек.
Dialogue: 0,0:15:34.57,0:15:36.60,Default,,0000,0000,0000,,Ертең ішкі сарай, солай ма?
Dialogue: 0,0:15:36.60,0:15:38.57,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:15:36.60,0:15:38.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:41.17,0:15:44.58,Default,,0000,0000,0000,,Мәселе бар ма?
Dialogue: 0,0:15:41.17,0:15:44.58,Default,,0000,0000,0000,,Әдеттегідей
Dialogue: 0,0:15:41.17,0:15:44.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:44.58,0:15:47.55,Default,,0000,0000,0000,,Яғни
Dialogue: 0,0:15:44.58,0:15:47.55,Default,,0000,0000,0000,,Оның нәзік дәмі бар.
Dialogue: 0,0:15:44.58,0:15:47.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:51.05,0:15:53.55,Default,,0000,0000,0000,,Егер сізге ұнамаса
Dialogue: 0,0:15:51.05,0:15:53.55,Default,,0000,0000,0000,,Тіпті ішпесеңіз де
Dialogue: 0,0:15:51.05,0:15:53.55,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:15:51.05,0:15:53.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:53.55,0:15:56.56,Default,,0000,0000,0000,,Канган
Dialogue: 0,0:15:53.55,0:15:56.56,Default,,0000,0000,0000,,Бұл жай ғана масқара.
Dialogue: 0,0:15:53.55,0:15:56.56,Default,,0000,0000,0000,,Евнух ретінде
Dialogue: 0,0:15:53.55,0:15:56.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:56.56,0:16:01.09,Default,,0000,0000,0000,,Қоғамдық орындарда мұрныңызды қыспаңыз.
Dialogue: 0,0:15:56.56,0:16:01.09,Default,,0000,0000,0000,,Менің ойымша, мұны істемеген дұрыс.
Dialogue: 0,0:15:56.56,0:16:01.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:01.09,0:16:03.63,Default,,0000,0000,0000,,біршама
Dialogue: 0,0:16:01.09,0:16:03.63,Default,,0000,0000,0000,,Жас көрінеді
Dialogue: 0,0:16:01.09,0:16:03.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:03.63,0:16:05.66,Default,,0000,0000,0000,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:16:03.63,0:16:05.66,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:05.66,0:16:10.57,Default,,0000,0000,0000,,《Күрделі мінез-құлық
Dialogue: 0,0:16:05.66,0:16:10.57,Default,,0000,0000,0000,,Аспан қызының күлкісі
Dialogue: 0,0:16:05.66,0:16:10.57,Default,,0000,0000,0000,,Балдың дауысы》
Dialogue: 0,0:16:10.57,0:16:15.07,Default,,0000,0000,0000,,《Ішкі сарай қазіргі императордың меншігіне айналды.
Dialogue: 0,0:16:10.57,0:16:15.07,Default,,0000,0000,0000,,5 жыл бұрын уәзір атанған➡
Dialogue: 0,0:16:15.07,0:16:19.58,Default,,0000,0000,0000,,Жиырма төрт адам
Dialogue: 0,0:16:15.07,0:16:19.58,Default,,0000,0000,0000,,Бұл Джинши.
Dialogue: 0,0:16:19.58,0:16:22.58,Default,,0000,0000,0000,,《Джинши маскасын киген кезде
Dialogue: 0,0:16:19.58,0:16:22.58,Default,,0000,0000,0000,,Шешім қабылдағаннан кейін➡
Dialogue: 0,0:16:22.58,0:16:27.12,Default,,0000,0000,0000,,Күнде осылай
Dialogue: 0,0:16:22.58,0:16:27.12,Default,,0000,0000,0000,,Мен ерлігімді жоғалтатын дәрі ішемін》
Dialogue: 0,0:16:27.12,0:16:30.16,Default,,0000,0000,0000,,Ақырында
Dialogue: 0,0:16:27.12,0:16:30.16,Default,,0000,0000,0000,,Бұл шынымен мүмкін емес болады.
Dialogue: 0,0:16:27.12,0:16:30.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:30.16,0:16:31.56,Default,,0000,0000,0000,,Боу!
Dialogue: 0,0:16:31.56,0:16:34.59,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:31.56,0:16:34.59,Default,,0000,0000,0000,,Жөтел
Dialogue: 0,0:16:31.56,0:16:34.59,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:31.56,0:16:34.59,Default,,0000,0000,0000,,Бұл сізге де қатысты!
Dialogue: 0,0:16:34.59,0:16:37.06,Default,,0000,0000,0000,,Бала
Dialogue: 0,0:16:34.59,0:16:37.06,Default,,0000,0000,0000,,Мен қазірдің өзінде ересекпін➡
Dialogue: 0,0:16:37.06,0:16:40.57,Default,,0000,0000,0000,,Капипа
Dialogue: 0,0:16:37.06,0:16:40.57,Default,,0000,0000,0000,,Немересі
Dialogue: 0,0:16:37.06,0:16:40.57,Default,,0000,0000,0000,,Тағы бір адам
Dialogue: 0,0:16:37.06,0:16:40.57,Default,,0000,0000,0000,,Туған
Dialogue: 0,0:16:37.06,0:16:40.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:40.57,0:16:44.57,Default,,0000,0000,0000,,Немересі
Dialogue: 0,0:16:40.57,0:16:44.57,Default,,0000,0000,0000,,Бұл сіздің үлкен ұлыңыз ба?
Dialogue: 0,0:16:40.57,0:16:44.57,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:16:40.57,0:16:44.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:44.57,0:16:48.64,Default,,0000,0000,0000,,Менің кіші ұлым да
Dialogue: 0,0:16:44.57,0:16:48.64,Default,,0000,0000,0000,,Уақыт келді
Dialogue: 0,0:16:44.57,0:16:48.64,Default,,0000,0000,0000,,Мен әйел алғым келеді...
Dialogue: 0,0:16:44.57,0:16:48.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:48.64,0:16:52.58,Default,,0000,0000,0000,,Ең кіші бала - Мәсен, солай ма?
Dialogue: 0,0:16:48.64,0:16:52.58,Default,,0000,0000,0000,,Ол небәрі он тоғызда емес пе?
Dialogue: 0,0:16:48.64,0:16:52.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:52.58,0:16:58.05,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:16:52.58,0:16:58.05,Default,,0000,0000,0000,,Мен де сен сияқты он тоғыздамын.
Dialogue: 0,0:16:52.58,0:16:58.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:58.05,0:17:02.55,Default,,0000,0000,0000,,Евнух
Dialogue: 0,0:16:58.05,0:17:02.55,Default,,0000,0000,0000,,Джинжи жиырма төрт пе?
Dialogue: 0,0:16:58.05,0:17:02.55,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:16:58.05,0:17:02.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:02.55,0:17:05.56,Default,,0000,0000,0000,,Тез
Dialogue: 0,0:17:02.55,0:17:05.56,Default,,0000,0000,0000,,Шарттар жасаңыз➡
Dialogue: 0,0:17:05.56,0:17:09.13,Default,,0000,0000,0000,,Бұл жұмыс түрі
Dialogue: 0,0:17:05.56,0:17:09.13,Default,,0000,0000,0000,,Мен саған мұны аяқта десем де
Dialogue: 0,0:17:05.56,0:17:09.13,Default,,0000,0000,0000,,Мен дәл осылай дедім.
Dialogue: 0,0:17:05.56,0:17:09.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:09.13,0:17:12.16,Default,,0000,0000,0000,,Жақында немеремді қолыма алуға рұқсат етіңіз.
Dialogue: 0,0:17:09.13,0:17:12.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:12.16,0:17:14.13,Default,,0000,0000,0000,,Күш салыңыз
Dialogue: 0,0:17:12.16,0:17:14.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:27.05,0:17:30.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:27.05,0:17:30.05,Default,,0000,0000,0000,,Луланфей
Dialogue: 0,0:17:27.05,0:17:30.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:27.05,0:17:30.05,Default,,0000,0000,0000,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:17:27.05,0:17:30.05,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:17:27.05,0:17:30.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:30.05,0:17:33.05,Default,,0000,0000,0000,,Бүгін тағы бір тамаша костюм.
Dialogue: 0,0:17:30.05,0:17:33.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:33.05,0:17:36.06,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:17:33.05,0:17:36.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:36.06,0:17:39.56,Default,,0000,0000,0000,,«Иеміз
Dialogue: 0,0:17:36.06,0:17:39.56,Default,,0000,0000,0000,,Ол Лу Ланфэй➡ көруге барса да
Dialogue: 0,0:17:39.56,0:17:42.09,Default,,0000,0000,0000,,Сұқ саусағын көп қозғалта алмайтынын айтады.
Dialogue: 0,0:17:42.09,0:17:47.67,Default,,0000,0000,0000,,《Лулан ханшайымы
Dialogue: 0,0:17:42.09,0:17:47.67,Default,,0000,0000,0000,,Өте әзілқой.
Dialogue: 0,0:17:42.09,0:17:47.67,Default,,0000,0000,0000,,Шаш пен макияж үнемі өзгеріп отырады.
Dialogue: 0,0:17:47.67,0:17:50.57,Default,,0000,0000,0000,,Кисаки
Dialogue: 0,0:17:47.67,0:17:50.57,Default,,0000,0000,0000,,《Мен барған сайын
Dialogue: 0,0:17:47.67,0:17:50.57,Default,,0000,0000,0000,,Ханшайым кім?
Dialogue: 0,0:17:47.67,0:17:50.57,Default,,0000,0000,0000,,Мен түсінбеймін➡
Dialogue: 0,0:17:50.57,0:17:52.57,Default,,0000,0000,0000,,Шатасып жатқан сияқты》
Dialogue: 0,0:17:52.57,0:17:56.58,Default,,0000,0000,0000,,《Бәрі 10 күнде бір рет
Dialogue: 0,0:17:52.57,0:17:56.58,Default,,0000,0000,0000,,Ол қатысуды жоспарлап отырған сияқты.
Dialogue: 0,0:17:56.58,0:17:59.08,Default,,0000,0000,0000,,《Лулан ханшайымның әкесі➡
Dialogue: 0,0:17:59.08,0:18:02.08,Default,,0000,0000,0000,,Бұрынғы императрица Довагерге
Dialogue: 0,0:17:59.08,0:18:02.08,Default,,0000,0000,0000,,Ол жақсы көретін аға вассал➡ болды
Dialogue: 0,0:18:02.08,0:18:05.05,Default,,0000,0000,0000,,Мен оны нашар ұстай алмаймын
Dialogue: 0,0:18:02.08,0:18:05.05,Default,,0000,0000,0000,,Өйткені ол жұмыс істемейді.
Dialogue: 0,0:18:06.59,0:18:10.16,Default,,0000,0000,0000,,《Қарықсыздық туралы айту
Dialogue: 0,0:18:06.59,0:18:10.16,Default,,0000,0000,0000,,Лиеш
Dialogue: 0,0:18:06.59,0:18:10.16,Default,,0000,0000,0000,,Риджу ханшайым үшін де солай》
Dialogue: 0,0:18:10.16,0:18:14.56,Default,,0000,0000,0000,,Микадо
Dialogue: 0,0:18:10.16,0:18:14.56,Default,,0000,0000,0000,,«Бұрынғы императордың балалық шақтағы хоббиі»
Dialogue: 0,0:18:10.16,0:18:14.56,Default,,0000,0000,0000,,Мен жек көретін қазіргі император –➡
Dialogue: 0,0:18:14.56,0:18:17.56,Default,,0000,0000,0000,,Риджу ханшайымға
Dialogue: 0,0:18:14.56,0:18:17.56,Default,,0000,0000,0000,,Оның араласуға ниеті жоқ сияқты.
Dialogue: 0,0:18:17.56,0:18:21.07,Default,,0000,0000,0000,,《Қыз кезімде
Dialogue: 0,0:18:17.56,0:18:21.07,Default,,0000,0000,0000,,Қазіргі императорды дүниеге әкелген императрица ➡
Dialogue: 0,0:18:21.07,0:18:25.57,Default,,0000,0000,0000,,Он жылдан кейін
Dialogue: 0,0:18:21.07,0:18:25.57,Default,,0000,0000,0000,,Тағы бір адам
Dialogue: 0,0:18:21.07,0:18:25.57,Default,,0000,0000,0000,,Баланы дүниеге әкелу》
Dialogue: 0,0:18:25.57,0:18:30.08,Default,,0000,0000,0000,,《Ол кезде
Dialogue: 0,0:18:25.57,0:18:30.08,Default,,0000,0000,0000,,Медицина қызметкері
Dialogue: 0,0:18:25.57,0:18:30.08,Default,,0000,0000,0000,,Императрицаның тұрақты ізбасарына айналады➡
Dialogue: 0,0:18:30.08,0:18:34.15,Default,,0000,0000,0000,,Ештеңе болған жоқ
Dialogue: 0,0:18:30.08,0:18:34.15,Default,,0000,0000,0000,,Босану сәтті аяқталды》
Dialogue: 0,0:18:34.15,0:18:37.05,Default,,0000,0000,0000,,Ардуохи
Dialogue: 0,0:18:34.15,0:18:37.05,Default,,0000,0000,0000,,《Бірақ
Dialogue: 0,0:18:34.15,0:18:37.05,Default,,0000,0000,0000,,Consort Ah Duo ➡ дүниеге келген
Dialogue: 0,0:18:37.05,0:18:40.59,Default,,0000,0000,0000,,Өйткені ол императрица Довагердің туған күнімен тұспа-тұс келді
Dialogue: 0,0:18:37.05,0:18:40.59,Default,,0000,0000,0000,,Елеусіз➡
Dialogue: 0,0:18:40.59,0:18:43.62,Default,,0000,0000,0000,,Нәтижелер
Dialogue: 0,0:18:40.59,0:18:43.62,Default,,0000,0000,0000,,Consort Ah Duo жатырынан айырылды➡
Dialogue: 0,0:18:43.62,0:18:48.56,Default,,0000,0000,0000,,Мико
Dialogue: 0,0:18:43.62,0:18:48.56,Default,,0000,0000,0000,,Сондай-ақ қазіргі императордың бірінші князі.
Dialogue: 0,0:18:43.62,0:18:48.56,Default,,0000,0000,0000,,Ол көп ұзамай қайтыс болды.
Dialogue: 0,0:18:48.56,0:18:52.56,Default,,0000,0000,0000,,《Егер
Dialogue: 0,0:18:48.56,0:18:52.56,Default,,0000,0000,0000,,Сол кездегі бала
Dialogue: 0,0:18:48.56,0:18:52.56,Default,,0000,0000,0000,,Көп емес екен, иә?
Dialogue: 0,0:18:48.56,0:18:52.56,Default,,0000,0000,0000,,Егер мен тірі болсам...》
Dialogue: 0,0:18:54.63,0:18:56.60,Default,,0000,0000,0000,,《Бұл ақымақ адасу》
Dialogue: 0,0:18:59.57,0:19:04.58,Default,,0000,0000,0000,,«Келесі Тоғу храмына тез барыңыз»
Dialogue: 0,0:18:59.57,0:19:04.58,Default,,0000,0000,0000,,Сізге тек оны жасау керек.
Dialogue: 0,0:19:04.58,0:19:07.58,Default,,0000,0000,0000,,Гёкуюхи
Dialogue: 0,0:19:04.58,0:19:07.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:19:04.58,0:19:07.58,Default,,0000,0000,0000,,Гёкуйо ханшайымы
Dialogue: 0,0:19:04.58,0:19:07.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:19:04.58,0:19:07.58,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:19:04.58,0:19:07.58,Default,,0000,0000,0000,,Сіз келдіңіз...
Dialogue: 0,0:19:04.58,0:19:07.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:07.58,0:19:10.08,Default,,0000,0000,0000,,Сіз өте шаршаған сияқтысыз...
Dialogue: 0,0:19:07.58,0:19:10.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:10.08,0:19:13.59,Default,,0000,0000,0000,,Хонгнянг
Dialogue: 0,0:19:10.08,0:19:13.59,Default,,0000,0000,0000,,(
Dialogue: 0,0:19:10.08,0:19:13.59,Default,,0000,0000,0000,,Бени Мусуме
Dialogue: 0,0:19:10.08,0:19:13.59,Default,,0000,0000,0000,,)
Dialogue: 0,0:19:10.08,0:19:13.59,Default,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:19:10.08,0:19:13.59,Default,,0000,0000,0000,,Балалар
Dialogue: 0,0:19:10.08,0:19:13.59,Default,,0000,0000,0000,,Жұмысқа оралу
Dialogue: 0,0:19:10.08,0:19:13.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:13.59,0:19:16.62,Default,,0000,0000,0000,,(
Dialogue: 0,0:19:13.59,0:19:16.62,Default,,0000,0000,0000,,Күңдер
Dialogue: 0,0:19:13.59,0:19:16.62,Default,,0000,0000,0000,,)
Dialogue: 0,0:19:13.59,0:19:16.62,Default,,0000,0000,0000,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:19:13.59,0:19:16.62,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:19:13.59,0:19:16.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:16.62,0:19:18.59,Default,,0000,0000,0000,,Мегуми Фушигуро.
Dialogue: 0,0:19:16.62,0:19:18.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:21.66,0:19:23.53,Default,,0000,0000,0000,,Серальио?
Dialogue: 0,0:19:23.53,0:19:27.53,Default,,0000,0000,0000,,О
Dialogue: 0,0:19:23.53,0:19:27.53,Default,,0000,0000,0000,,Гёкуйо ханшайымы
Dialogue: 0,0:19:23.53,0:19:27.53,Default,,0000,0000,0000,,Айға жол біткен сияқты.
Dialogue: 0,0:19:23.53,0:19:27.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:27.53,0:19:32.54,Default,,0000,0000,0000,,《Ай жолы
Dialogue: 0,0:19:27.53,0:19:32.54,Default,,0000,0000,0000,,Яғни
Dialogue: 0,0:19:27.53,0:19:32.54,Default,,0000,0000,0000,,Жүкті болу мүмкіндігі болса...》
Dialogue: 0,0:19:32.54,0:19:34.54,Default,,0000,0000,0000,,Қашаннан бері?
Dialogue: 0,0:19:34.54,0:19:37.54,Default,,0000,0000,0000,,Бүгіннен бастап кете аламыз ба?
Dialogue: 0,0:19:34.54,0:19:37.54,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:19:34.54,0:19:37.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:37.54,0:19:39.55,Default,,0000,0000,0000,,Мен де солай ойладым, бірақ бұл шешімді талқылаудың қажеті жоқ
Dialogue: 0,0:19:37.54,0:19:39.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:41.08,0:19:43.12,Default,,0000,0000,0000,,《Дәлірек
Dialogue: 0,0:19:41.08,0:19:43.12,Default,,0000,0000,0000,,Ыңғайлы》
Dialogue: 0,0:19:43.12,0:19:46.05,Default,,0000,0000,0000,,《Ерлерге ішкі сарайда тыйым салынған》
Dialogue: 0,0:19:46.05,0:19:51.06,Default,,0000,0000,0000,,«Мен сенің атыңды естігім де келмейді».
Dialogue: 0,0:19:46.05,0:19:51.06,Default,,0000,0000,0000,,Біз ешқашан бетпе-бет кездеспейміз.
Dialogue: 0,0:19:51.06,0:19:54.53,Default,,0000,0000,0000,,《Мүмкін
Dialogue: 0,0:19:51.06,0:19:54.53,Default,,0000,0000,0000,,Олар саған қамқор болды ма? 》
Dialogue: 0,0:19:54.53,0:19:58.06,Default,,0000,0000,0000,,《Қалай болса да
Dialogue: 0,0:19:54.53,0:19:58.06,Default,,0000,0000,0000,,Улар бойынша инспектор》
Dialogue: 0,0:19:54.53,0:19:58.06,Default,,0000,0000,0000,,Бабун~
Dialogue: 0,0:19:54.53,0:19:58.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:58.06,0:20:00.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:19:58.06,0:20:00.03,Default,,0000,0000,0000,,Су лалагүлі
Dialogue: 0,0:19:58.06,0:20:00.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:19:58.06,0:20:00.03,Default,,0000,0000,0000,,О.
Dialogue: 0,0:19:58.06,0:20:00.03,Default,,0000,0000,0000,,Көңіл-күйіңіз жақсы, солай емес пе?
Dialogue: 0,0:19:58.06,0:20:00.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:00.03,0:20:02.60,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:00.03,0:20:02.60,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:20:00.03,0:20:02.60,Default,,0000,0000,0000,,Бұл дұрыс емес...
Dialogue: 0,0:20:00.03,0:20:02.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:02.60,0:20:04.64,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:20:02.60,0:20:04.64,Default,,0000,0000,0000,,Бұл ұят.
Dialogue: 0,0:20:02.60,0:20:04.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:04.64,0:20:08.54,Default,,0000,0000,0000,,Оқуға лайық бала
Dialogue: 0,0:20:04.64,0:20:08.54,Default,,0000,0000,0000,,Мен сені кірді деп ойладым.
Dialogue: 0,0:20:04.64,0:20:08.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:08.54,0:20:10.04,Default,,0000,0000,0000,,Эй?
Dialogue: 0,0:20:13.05,0:20:17.55,Default,,0000,0000,0000,,《Мен соңғы рет ішкі сарайда тұрғаныма көп уақыт болды.
Dialogue: 0,0:20:13.05,0:20:17.55,Default,,0000,0000,0000,,Бұрынғыдай➡
Dialogue: 0,0:20:17.55,0:20:20.55,Default,,0000,0000,0000,,Күнімді у ішумен өткіземін.
Dialogue: 0,0:20:20.55,0:20:22.55,Default,,0000,0000,0000,,Мәселе жоқ
Dialogue: 0,0:20:20.55,0:20:22.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:22.55,0:20:26.09,Default,,0000,0000,0000,,《Етеккір келмеуден басқа
Dialogue: 0,0:20:22.55,0:20:26.09,Default,,0000,0000,0000,,Бұған нақты дәлел жоқ.
Dialogue: 0,0:20:26.09,0:20:30.16,Default,,0000,0000,0000,,Линлей Химе
Dialogue: 0,0:20:26.09,0:20:30.16,Default,,0000,0000,0000,,(
Dialogue: 0,0:20:26.09,0:20:30.16,Default,,0000,0000,0000,,Сузурей ханшайымы
Dialogue: 0,0:20:26.09,0:20:30.16,Default,,0000,0000,0000,,)
Dialogue: 0,0:20:26.09,0:20:30.16,Default,,0000,0000,0000,,Хаха
Dialogue: 0,0:20:26.09,0:20:30.16,Default,,0000,0000,0000,,Хаха…
Dialogue: 0,0:20:26.09,0:20:30.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:30.16,0:20:32.56,Default,,0000,0000,0000,,《Мен Consort Ah Duo➡ оқиғасы туралы ойладым
Dialogue: 0,0:20:32.56,0:20:36.03,Default,,0000,0000,0000,,Жай ғана азғын қарт
Dialogue: 0,0:20:32.56,0:20:36.03,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:20:39.54,0:20:43.54,Default,,0000,0000,0000,,《Ол кеңесші ретінде өте сенімді болды.
Dialogue: 0,0:20:39.54,0:20:43.54,Default,,0000,0000,0000,,Consort Ата кетеді➡
Dialogue: 0,0:20:43.54,0:20:46.04,Default,,0000,0000,0000,,Яһудей
Dialogue: 0,0:20:43.54,0:20:46.04,Default,,0000,0000,0000,,Оның орнына компанияға қосылған адам ➡ болды
Dialogue: 0,0:20:46.04,0:20:50.12,Default,,0000,0000,0000,,Бұл тіпті императорлық сотқа да әсер етуі мүмкін.
Dialogue: 0,0:20:46.04,0:20:50.12,Default,,0000,0000,0000,,Біртүрлі қыз》
Dialogue: 0,0:20:50.12,0:20:52.15,Default,,0000,0000,0000,,《Мен көмектесе алмаймын➡
Dialogue: 0,0:20:52.15,0:20:55.05,Default,,0000,0000,0000,,Себебі
Dialogue: 0,0:20:52.15,0:20:55.05,Default,,0000,0000,0000,,Балалы болу қиын》
Dialogue: 0,0:20:55.05,0:20:58.02,Default,,0000,0000,0000,,《Бұл бас ауруы болса керек.》
Dialogue: 0,0:20:58.02,0:21:00.56,Default,,0000,0000,0000,,Камуро
Dialogue: 0,0:20:58.02,0:21:00.56,Default,,0000,0000,0000,,(
Dialogue: 0,0:20:58.02,0:21:00.56,Default,,0000,0000,0000,,Таз Б
Dialogue: 0,0:20:58.02,0:21:00.56,Default,,0000,0000,0000,,)
Dialogue: 0,0:20:58.02,0:21:00.56,Default,,0000,0000,0000,,Құрметпен айтсам, Басшының орынбасары,
Dialogue: 0,0:20:58.02,0:21:00.56,Default,,0000,0000,0000,,Сіз естідіңіз бе?
Dialogue: 0,0:21:00.56,0:21:03.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:21:00.56,0:21:03.03,Default,,0000,0000,0000,,Таз А
Dialogue: 0,0:21:00.56,0:21:03.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:21:00.56,0:21:03.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:00.56,0:21:03.03,Default,,0000,0000,0000,,Үш ханшайымның бірі ме?
Dialogue: 0,0:21:03.03,0:21:05.56,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:21:03.03,0:21:05.56,Default,,0000,0000,0000,,Маған өтеу болатынын айтты.
Dialogue: 0,0:21:03.03,0:21:05.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:05.56,0:21:09.03,Default,,0000,0000,0000,,Төлем...?
