Dialogue: 0,0:10:54.05,0:10:56.02,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:10:54.05,0:10:56.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:56.02,0:10:58.06,Default,,0000,0000,0000,,Мен дәретханада жасырынып жатқанда…
Dialogue: 0,0:10:56.02,0:10:58.06,Default,,0000,0000,0000,,Кездесу орны –➡
Dialogue: 0,0:10:58.06,0:11:01.03,Default,,0000,0000,0000,,Ханамачи
Dialogue: 0,0:10:58.06,0:11:01.03,Default,,0000,0000,0000,,Қызыл жарық ауданы сияқты ойын-сауық
Dialogue: 0,0:10:58.06,0:11:01.03,Default,,0000,0000,0000,,Сіз не істедіңіз…》
Dialogue: 0,0:11:01.03,0:11:04.53,Default,,0000,0000,0000,,《Осындай нәрселер
Dialogue: 0,0:11:01.03,0:11:04.53,Default,,0000,0000,0000,,Мен оны сатып алған жоқпын.
Dialogue: 0,0:11:08.53,0:11:12.54,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:08.53,0:11:12.54,Default,,0000,0000,0000,,Терең тыныс алу дыбысы
Dialogue: 0,0:11:08.53,0:11:12.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:18.01,0:11:20.55,Default,,0000,0000,0000,,Фармация
Dialogue: 0,0:11:18.01,0:11:20.55,Default,,0000,0000,0000,,Жарайды ма?
Dialogue: 0,0:11:20.55,0:11:22.55,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:11:20.55,0:11:22.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:22.55,0:11:26.52,Default,,0000,0000,0000,,Су лалагүлі
Dialogue: 0,0:11:22.55,0:11:26.52,Default,,0000,0000,0000,,Су лалагүлімен бірге ішіңіз
Dialogue: 0,0:11:22.55,0:11:26.52,Default,,0000,0000,0000,,Бұл оғаш адамның кәдесыйы.
Dialogue: 0,0:11:22.55,0:11:26.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:28.02,0:11:30.06,Default,,0000,0000,0000,,Бұл біртүрлі адамнан ба?
Dialogue: 0,0:11:30.06,0:11:32.56,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:11:30.06,0:11:32.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:30.06,0:11:32.56,Default,,0000,0000,0000,,О
Dialogue: 0,0:11:30.06,0:11:32.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:32.56,0:11:35.53,Default,,0000,0000,0000,,Енді жұмысқа қайта оралайық.
Dialogue: 0,0:11:32.56,0:11:35.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:44.04,0:11:46.54,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:44.04,0:11:46.54,Default,,0000,0000,0000,,Су лотосу
Dialogue: 0,0:11:44.04,0:11:46.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:44.04,0:11:46.54,Default,,0000,0000,0000,,О, құдай!
Dialogue: 0,0:11:44.04,0:11:46.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:48.57,0:11:51.08,Default,,0000,0000,0000,,Бүгін кешкі вегетариандық тағамдар➡
Dialogue: 0,0:11:51.08,0:11:55.05,Default,,0000,0000,0000,,Сяомао
Dialogue: 0,0:11:51.08,0:11:55.05,Default,,0000,0000,0000,,Конеко да
Dialogue: 0,0:11:51.08,0:11:55.05,Default,,0000,0000,0000,,Етті немесе балықты қыспаңыз.
Dialogue: 0,0:11:51.08,0:11:55.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:57.05,0:12:01.09,Default,,0000,0000,0000,,Мен үзілісте болғандықтан
Dialogue: 0,0:11:57.05,0:12:01.09,Default,,0000,0000,0000,,Тым ұзақ болмаңыз
Dialogue: 0,0:11:57.05,0:12:01.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:01.09,0:12:04.12,Default,,0000,0000,0000,,Ха…
Dialogue: 0,0:12:01.09,0:12:04.12,Default,,0000,0000,0000,,Бұл вегетариандық тағамдар, солай ма?
Dialogue: 0,0:12:01.09,0:12:04.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:04.12,0:12:06.16,Default,,0000,0000,0000,,《Ол жоғалды
Dialogue: 0,0:12:04.12,0:12:06.16,Default,,0000,0000,0000,,Мен жұмыс істесем➡
Dialogue: 0,0:12:06.16,0:12:10.56,Default,,0000,0000,0000,,Басыңнан бірден шықсаң
Dialogue: 0,0:12:06.16,0:12:10.56,Default,,0000,0000,0000,,Мен ойладым》
Dialogue: 0,0:12:10.56,0:12:12.06,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:12:10.56,0:12:12.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:12.06,0:12:15.07,Default,,0000,0000,0000,,Және…
Dialogue: 0,0:12:12.06,0:12:15.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:12.06,0:12:15.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:15.07,0:12:18.04,Default,,0000,0000,0000,,Сарайшыққа да бөтен шөптерді жасырмаңыз.
Dialogue: 0,0:12:15.07,0:12:18.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:18.04,0:12:21.54,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:12:18.04,0:12:21.54,Default,,0000,0000,0000,,《Мм…
Dialogue: 0,0:12:18.04,0:12:21.54,Default,,0000,0000,0000,,Мен босаңсуға болмайды》
Dialogue: 0,0:12:21.54,0:12:24.58,Default,,0000,0000,0000,,Оны қоятын жерің болмаса
Dialogue: 0,0:12:21.54,0:12:24.58,Default,,0000,0000,0000,,Джинджи мырзадан сұраңыз➡
Dialogue: 0,0:12:24.58,0:12:27.61,Default,,0000,0000,0000,,Қосымша бөлме
Dialogue: 0,0:12:24.58,0:12:27.61,Default,,0000,0000,0000,,Егер мен оны пайдалануға рұқсат етсем ше?
Dialogue: 0,0:12:27.61,0:12:32.55,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:12:27.61,0:12:32.55,Default,,0000,0000,0000,,Сіз тұратын жер
Dialogue: 0,0:12:27.61,0:12:32.55,Default,,0000,0000,0000,,Дәрілік шкаф ретінде қарастыруға болмайды
Dialogue: 0,0:12:27.61,0:12:32.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:32.55,0:12:35.55,Default,,0000,0000,0000,,Конеко
Dialogue: 0,0:12:32.55,0:12:35.55,Default,,0000,0000,0000,,Сізге бәрібір сияқты➡
Dialogue: 0,0:12:35.55,0:12:38.56,Default,,0000,0000,0000,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:12:35.55,0:12:38.56,Default,,0000,0000,0000,,Бөлінген, солай ма?
Dialogue: 0,0:12:35.55,0:12:38.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:38.56,0:12:41.56,Default,,0000,0000,0000,,Мен аз туылған қызбын.
Dialogue: 0,0:12:38.56,0:12:41.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:41.56,0:12:44.56,Default,,0000,0000,0000,,Тіпті осында
Dialogue: 0,0:12:41.56,0:12:44.56,Default,,0000,0000,0000,,Бұл шынымен де біртүрлі байланыс.
Dialogue: 0,0:12:41.56,0:12:44.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:44.56,0:12:46.53,Default,,0000,0000,0000,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,0:12:44.56,0:12:46.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:46.53,0:12:50.10,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:12:46.53,0:12:50.10,Default,,0000,0000,0000,,Сіз текті болып туылғаныңыз үшін➡
Dialogue: 0,0:12:50.10,0:12:54.04,Default,,0000,0000,0000,,Олар басынан бастап ерекшеленеді деп ойламаңыз
Dialogue: 0,0:12:50.10,0:12:54.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:54.04,0:12:56.04,Default,,0000,0000,0000,,Не
Dialogue: 0,0:12:54.04,0:12:56.04,Default,,0000,0000,0000,,Ол қалай айналады➡
Dialogue: 0,0:12:56.04,0:12:59.04,Default,,0000,0000,0000,,Өмір қандай болады екен деп ойлаймын
Dialogue: 0,0:12:56.04,0:12:59.04,Default,,0000,0000,0000,,Нені түсінбеймін
Dialogue: 0,0:12:56.04,0:12:59.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:59.04,0:13:03.55,Default,,0000,0000,0000,,Барлығын тек мәртебеге қарай бөлу дұрыс па?
Dialogue: 0,0:12:59.04,0:13:03.55,Default,,0000,0000,0000,,Бұл ысырап
Dialogue: 0,0:12:59.04,0:13:03.55,Default,,0000,0000,0000,,. [жиырма төрт] .
Dialogue: 0,0:13:03.55,0:13:05.55,Default,,0000,0000,0000,,Шынында ма?
Dialogue: 0,0:13:05.55,0:13:07.55,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:13:05.55,0:13:07.55,Default,,0000,0000,0000,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:13:05.55,0:13:07.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:07.55,0:13:12.09,Default,,0000,0000,0000,,♪ Ка-та-на
Dialogue: 0,0:13:07.55,0:13:12.09,Default,,0000,0000,0000,,Бұл сіздің жұмысыңыз.
Dialogue: 0,0:13:07.55,0:13:12.09,Default,,0000,0000,0000,,Мен сізге тапсырма бере аламын ба?
Dialogue: 0,0:13:12.09,0:13:16.16,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:13:12.09,0:13:16.16,Default,,0000,0000,0000,,Мен дәрі алуға келдім!
Dialogue: 0,0:13:16.16,0:13:18.56,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:16.16,0:13:18.56,Default,,0000,0000,0000,,Медицина қызметкері
Dialogue: 0,0:13:16.16,0:13:18.56,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:16.16,0:13:18.56,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:13:16.16,0:13:18.56,Default,,0000,0000,0000,,Бір минут күтіңіз.
Dialogue: 0,0:13:16.16,0:13:18.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:18.56,0:13:21.57,Default,,0000,0000,0000,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:13:18.56,0:13:21.57,Default,,0000,0000,0000,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:13:18.56,0:13:21.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:21.57,0:13:24.57,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:13:21.57,0:13:24.57,Default,,0000,0000,0000,,Ол да солардың бірі ғана ғой, иә?
Dialogue: 0,0:13:21.57,0:13:24.57,Default,,0000,0000,0000,,Аха…
Dialogue: 0,0:13:21.57,0:13:24.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:24.57,0:13:29.04,Default,,0000,0000,0000,,《Ябу докторы басқарады
Dialogue: 0,0:13:24.57,0:13:29.04,Default,,0000,0000,0000,,Ол ішкі сарайдағы медициналық кабинеттен мүлдем өзгеше.
Dialogue: 0,0:13:29.04,0:13:33.05,Default,,0000,0000,0000,,《Бұл жерде әскер жақын.
Dialogue: 0,0:13:29.04,0:13:33.05,Default,,0000,0000,0000,,Жарақат алған адамдар көп.
Dialogue: 0,0:13:33.05,0:13:34.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:33.05,0:13:34.58,Default,,0000,0000,0000,,Соратын ауаның дыбысы
Dialogue: 0,0:13:33.05,0:13:34.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:34.58,0:13:38.65,Default,,0000,0000,0000,,《Ах
Dialogue: 0,0:13:34.58,0:13:38.65,Default,,0000,0000,0000,,Бұл ащылық
Dialogue: 0,0:13:34.58,0:13:38.65,Default,,0000,0000,0000,,Аузыңа тарайтын иіс...》
Dialogue: 0,0:13:38.65,0:13:42.05,Default,,0000,0000,0000,,《Дәрілік шкафта
Dialogue: 0,0:13:38.65,0:13:42.05,Default,,0000,0000,0000,,Мен оның ішінде не бар деп ойлаймын》
Dialogue: 0,0:13:42.05,0:13:46.06,Default,,0000,0000,0000,,《Мен дәрігердің кабинетін аралағым келеді.
Dialogue: 0,0:13:42.05,0:13:46.06,Default,,0000,0000,0000,,Уфуфу~》
Dialogue: 0,0:13:46.06,0:13:48.56,Default,,0000,0000,0000,,《Жоқ
Dialogue: 0,0:13:46.06,0:13:48.56,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:13:46.06,0:13:48.56,Default,,0000,0000,0000,,Күте тұрыңыз~》
Dialogue: 0,0:13:48.56,0:13:51.03,Default,,0000,0000,0000,,Су лалагүлі
Dialogue: 0,0:13:48.56,0:13:51.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:48.56,0:13:51.03,Default,,0000,0000,0000,,Суирей
Dialogue: 0,0:13:48.56,0:13:51.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:48.56,0:13:51.03,Default,,0000,0000,0000,,⚟Не істеп жатырсыз? ⚞
Dialogue: 0,0:13:48.56,0:13:51.03,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:13:53.57,0:13:57.10,Default,,0000,0000,0000,,《Ол кезде...》
Dialogue: 0,0:13:57.10,0:14:01.14,Default,,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:13:57.10,0:14:01.14,Default,,0000,0000,0000,,Мен тек дәрі күтіп тұрдым.
Dialogue: 0,0:13:57.10,0:14:01.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:01.14,0:14:03.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:01.14,0:14:03.08,Default,,0000,0000,0000,,Медицина қызметкері
Dialogue: 0,0:14:01.14,0:14:03.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:01.14,0:14:03.08,Default,,0000,0000,0000,,⚟Суирей! ⚞
Dialogue: 0,0:14:03.08,0:14:06.05,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:14:03.08,0:14:06.05,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:14:03.08,0:14:06.05,Default,,0000,0000,0000,,Келдіңіз бе?
Dialogue: 0,0:14:03.08,0:14:06.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:06.05,0:14:10.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:06.05,0:14:10.05,Default,,0000,0000,0000,,Суирей
Dialogue: 0,0:14:06.05,0:14:10.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:06.05,0:14:10.05,Default,,0000,0000,0000,,Тұрақты дәрі-дәрмекті станциядан алу үшін
Dialogue: 0,0:14:06.05,0:14:10.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:06.05,0:14:10.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:06.05,0:14:10.05,Default,,0000,0000,0000,,Медицина қызметкері
Dialogue: 0,0:14:06.05,0:14:10.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:06.05,0:14:10.05,Default,,0000,0000,0000,,О
Dialogue: 0,0:14:06.05,0:14:10.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:13.59,0:14:16.09,Default,,0000,0000,0000,,《Қызметкерлер бөлмесі? 》
Dialogue: 0,0:14:16.09,0:14:20.63,Default,,0000,0000,0000,,《Ойланып көріңізші
Dialogue: 0,0:14:16.09,0:14:20.63,Default,,0000,0000,0000,,Біз бұрын кездескен болатынбыз
Dialogue: 0,0:14:16.09,0:14:20.63,Default,,0000,0000,0000,,Ол әскерилердің жанында болды.
Dialogue: 0,0:14:20.63,0:14:25.60,Default,,0000,0000,0000,,《Дәрілік шөптердің иісі шықты.
Dialogue: 0,0:14:20.63,0:14:25.60,Default,,0000,0000,0000,,Әскери қызметте жұмыс істегендіктен бе?
Dialogue: 0,0:14:28.57,0:14:32.07,Default,,0000,0000,0000,,《Мені біртүрлі түрде ұнатпайтындай сезінемін.》
Dialogue: 0,0:14:32.07,0:14:36.08,Default,,0000,0000,0000,,Сізге тағы бір нәрсе керек пе?
Dialogue: 0,0:14:32.07,0:14:36.08,Default,,0000,0000,0000,,Атап айтқанда, ештеңе жоқ
Dialogue: 0,0:14:32.07,0:14:36.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:38.08,0:14:42.08,Default,,0000,0000,0000,,Бастапқыда ол үкімет ханымы болды.
Dialogue: 0,0:14:38.08,0:14:42.08,Default,,0000,0000,0000,,Мен мұны істеуге міндетті емеспін.
Dialogue: 0,0:14:38.08,0:14:42.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:42.08,0:14:46.05,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:14:42.08,0:14:46.05,Default,,0000,0000,0000,,Пыс, пыс… Э?
Dialogue: 0,0:14:42.08,0:14:46.05,Default,,0000,0000,0000,,Бұл медицинаға көбірек ұқсайды!?
Dialogue: 0,0:14:51.66,0:14:54.13,Default,,0000,0000,0000,,《Бұл қандай дәрі?》
Dialogue: 0,0:14:58.06,0:15:00.07,Default,,0000,0000,0000,,Перори
Dialogue: 0,0:14:58.06,0:15:00.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:00.07,0:15:05.07,Default,,0000,0000,0000,,《Бұл картоп ұны ма?
Dialogue: 0,0:15:00.07,0:15:05.07,Default,,0000,0000,0000,,Бұл Джиндзи-саманың дәрісі, солай ма? 》
Dialogue: 0,0:15:05.07,0:15:09.07,Default,,0000,0000,0000,,《Мен бұл туралы ойлаған кезде
Dialogue: 0,0:15:05.07,0:15:09.07,Default,,0000,0000,0000,,Джинджи туралы көптеген жұмбақ нәрселер бар.
Dialogue: 0,0:15:09.07,0:15:14.58,Default,,0000,0000,0000,,《Шамамен жарты жылда бір рет
Dialogue: 0,0:15:09.07,0:15:14.58,Default,,0000,0000,0000,,Үнемі
Dialogue: 0,0:15:09.07,0:15:14.58,Default,,0000,0000,0000,,Бұл менің жолымнан келетін жұмыстарға да қатысты➡
Dialogue: 0,0:15:14.58,0:15:19.55,Default,,0000,0000,0000,,Алдыңғы күннен
Dialogue: 0,0:15:14.58,0:15:19.55,Default,,0000,0000,0000,,Ақырын шомылыңыз
Dialogue: 0,0:15:14.58,0:15:19.55,Default,,0000,0000,0000,,Хош иісті зат түтетіп, өшіңіз...》
Dialogue: 0,0:15:19.55,0:15:23.56,Default,,0000,0000,0000,,《Шоджин риори де
Dialogue: 0,0:15:19.55,0:15:23.56,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:15:19.55,0:15:23.56,Default,,0000,0000,0000,,Мисо
Dialogue: 0,0:15:19.55,0:15:23.56,Default,,0000,0000,0000,,Бұл тазарту сияқты.
Dialogue: 0,0:15:23.56,0:15:27.06,Default,,0000,0000,0000,,Сайши
Dialogue: 0,0:15:23.56,0:15:27.06,Default,,0000,0000,0000,,《Уақыттар да ырым-тыйымдар жасаған.
Dialogue: 0,0:15:23.56,0:15:27.06,Default,,0000,0000,0000,,Мен мұны істеуге болады ма деп ойлаймын》
Dialogue: 0,0:15:27.06,0:15:30.56,Default,,0000,0000,0000,,《Егер асыл адам болса
Dialogue: 0,0:15:27.06,0:15:30.56,Default,,0000,0000,0000,,Бұл таңқаларлық емес➡
Dialogue: 0,0:15:30.56,0:15:33.53,Default,,0000,0000,0000,,Мұндай адам
Dialogue: 0,0:15:30.56,0:15:33.53,Default,,0000,0000,0000,,Неліктен евнух болу керек? 》
Dialogue: 0,0:15:33.53,0:15:38.10,Default,,0000,0000,0000,,《Джиндзи-сама да
Dialogue: 0,0:15:33.53,0:15:38.10,Default,,0000,0000,0000,,Бұрынғы императрица Довагер
Dialogue: 0,0:15:33.53,0:15:38.10,Default,,0000,0000,0000,,Императрицаның қалауы бойынша➡
Dialogue: 0,0:15:38.10,0:15:41.04,Default,,0000,0000,0000,,Евнухқа
Dialogue: 0,0:15:38.10,0:15:41.04,Default,,0000,0000,0000,,Бұл орындалды ма деп ойлаймын》
Dialogue: 0,0:15:41.04,0:15:44.04,Default,,0000,0000,0000,,《Кәрі адам сияқты》
Dialogue: 0,0:15:44.04,0:15:48.55,Default,,0000,0000,0000,,Сол қыздың асырап алған әкесі
Dialogue: 0,0:15:44.04,0:15:48.55,Default,,0000,0000,0000,,Ол бұрынғы евнух және медициналық қызметкер болса керек.
Dialogue: 0,0:15:44.04,0:15:48.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:48.55,0:15:53.09,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:15:48.55,0:15:53.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:48.55,0:15:53.09,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:15:48.55,0:15:53.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:48.55,0:15:53.09,Default,,0000,0000,0000,,Егер сіз бұрынғы медицина қызметкерінен үйренсеңіз
Dialogue: 0,0:15:48.55,0:15:53.09,Default,,0000,0000,0000,,Бұл білім мағынасы бар, бірақ➡
Dialogue: 0,0:15:53.09,0:15:56.59,Default,,0000,0000,0000,,Сіз бұрынғы уәзірсіз бе?
Dialogue: 0,0:15:53.09,0:15:56.59,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:15:53.09,0:15:56.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:56.59,0:16:01.96,Default,,0000,0000,0000,,Сондай тамаша медицина қызметкері
Dialogue: 0,0:15:56.59,0:16:01.96,Default,,0000,0000,0000,,Ол евнухтардың арасында болды ма?
Dialogue: 0,0:15:56.59,0:16:01.96,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:05.06,0:16:07.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:05.06,0:16:07.57,Default,,0000,0000,0000,,Қақ
Dialogue: 0,0:16:05.06,0:16:07.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:05.06,0:16:07.57,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:07.57,0:16:10.07,Default,,0000,0000,0000,,Лакан
Dialogue: 0,0:16:07.57,0:16:10.07,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:07.57,0:16:10.07,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:16:07.57,0:16:10.07,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:07.57,0:16:10.07,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:16:07.57,0:16:10.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:12.07,0:16:16.04,Default,,0000,0000,0000,,Өткен күні айтқанымызды жалғастырамыз ба?
Dialogue: 0,0:16:17.58,0:16:19.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:17.58,0:16:19.58,Default,,0000,0000,0000,,Орындыққа отыру дыбысы
Dialogue: 0,0:16:17.58,0:16:19.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:23.08,0:16:27.55,Default,,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:16:23.08,0:16:27.55,Default,,0000,0000,0000,,Өте қауіпті нәрсе
Dialogue: 0,0:16:23.08,0:16:27.55,Default,,0000,0000,0000,,Бұл орындалған сияқты.
Dialogue: 0,0:16:23.08,0:16:27.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:27.55,0:16:32.02,Default,,0000,0000,0000,,Дөрекі...
Dialogue: 0,0:16:27.55,0:16:32.02,Default,,0000,0000,0000,,Томбиге
Dialogue: 0,0:16:27.55,0:16:32.02,Default,,0000,0000,0000,,Мен мұны естігім келмейді.
Dialogue: 0,0:16:27.55,0:16:32.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:32.02,0:16:37.03,Default,,0000,0000,0000,,10 жылдан астам
Dialogue: 0,0:16:32.02,0:16:37.03,Default,,0000,0000,0000,,Соңында
Dialogue: 0,0:16:32.02,0:16:37.03,Default,,0000,0000,0000,,Ятебабаны сендірсем де
Dialogue: 0,0:16:32.02,0:16:37.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:37.03,0:16:41.03,Default,,0000,0000,0000,,Бүйірден
Dialogue: 0,0:16:37.03,0:16:41.03,Default,,0000,0000,0000,,Тіпті мені ұрлап әкеткен кезде де
Dialogue: 0,0:16:37.03,0:16:41.03,Default,,0000,0000,0000,,Нарутой
Dialogue: 0,0:16:37.03,0:16:41.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:41.03,0:16:43.54,Default,,0000,0000,0000,,Сізге қуырылған тофуды қайтарғанымды қалайсыз ба?
Dialogue: 0,0:16:43.54,0:16:47.11,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:16:43.54,0:16:47.11,Default,,0000,0000,0000,,Қалағаныңызша беріңіз
Dialogue: 0,0:16:43.54,0:16:47.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:47.11,0:16:51.04,Default,,0000,0000,0000,,Тецу
Dialogue: 0,0:16:47.11,0:16:51.04,Default,,0000,0000,0000,,Бұрынғы жолды қайталағым келмейді.
Dialogue: 0,0:16:47.11,0:16:51.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:51.04,0:16:53.05,Default,,0000,0000,0000,,Егер мен оны ұнатпаймын десем ше?
Dialogue: 0,0:16:53.05,0:16:57.02,Default,,0000,0000,0000,,Сіз бұлай айтқанда мен ештеңе айта алмаймын.
Dialogue: 0,0:16:53.05,0:16:57.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:57.02,0:17:03.52,Default,,0000,0000,0000,,Саған қарсы шыға алатын адамдар жоқ.
Dialogue: 0,0:16:57.02,0:17:03.52,Default,,0000,0000,0000,,Бір қолдың саусақтарынан артық емес.
Dialogue: 0,0:16:57.02,0:17:03.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:03.52,0:17:07.09,Default,,0000,0000,0000,,《Күтілгендей
Dialogue: 0,0:17:03.52,0:17:07.09,Default,,0000,0000,0000,,Мен өзімнің шынайы болмысымды білемін》
Dialogue: 0,0:17:07.09,0:17:12.60,Default,,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:17:07.09,0:17:12.60,Default,,0000,0000,0000,,Менің қызым
Dialogue: 0,0:17:07.09,0:17:12.60,Default,,0000,0000,0000,,Сіз не ойлайсыз деп ойлаймын.
Dialogue: 0,0:17:07.09,0:17:12.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:14.03,0:17:20.04,Default,,0000,0000,0000,,《Ах
Dialogue: 0,0:17:14.03,0:17:20.04,Default,,0000,0000,0000,,Маған ұнамайды
Dialogue: 0,0:17:14.03,0:17:20.04,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,0:17:14.03,0:17:20.04,Default,,0000,0000,0000,,Осымен.
Dialogue: 0,0:17:20.04,0:17:23.04,Default,,0000,0000,0000,,《Мойындауды жек көремін, бірақ➡
Dialogue: 0,0:17:23.04,0:17:28.01,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:17:23.04,0:17:28.01,Default,,0000,0000,0000,,Ол Маомаконың биологиялық әкесі.
Dialogue: 0,0:17:35.59,0:17:40.53,Default,,0000,0000,0000,,Қызыма
Dialogue: 0,0:17:35.59,0:17:40.53,Default,,0000,0000,0000,,Бір күні сені көруге барғанда
Dialogue: 0,0:17:35.59,0:17:40.53,Default,,0000,0000,0000,,Маған айтып бере аласыз ба?
Dialogue: 0,0:17:40.53,0:17:43.03,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:17:40.53,0:17:43.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:43.03,0:17:46.50,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:43.03,0:17:46.50,Default,,0000,0000,0000,,Есіктің жабылу дыбысы
Dialogue: 0,0:17:43.03,0:17:46.50,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:50.07,0:17:54.07,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:17:50.07,0:17:54.07,Default,,0000,0000,0000,,Фармация
Dialogue: 0,0:17:50.07,0:17:54.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:50.07,0:17:54.07,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:17:50.07,0:17:54.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:54.07,0:17:58.08,Default,,0000,0000,0000,,Келесі жолы
Dialogue: 0,0:17:54.07,0:17:58.08,Default,,0000,0000,0000,,Мен сенімен танысқым келеді
Dialogue: 0,0:17:54.07,0:17:58.08,Default,,0000,0000,0000,,Мемлекеттік қызметкер бар.
Dialogue: 0,0:17:54.07,0:17:58.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:58.08,0:18:00.65,Default,,0000,0000,0000,,Сіз қандай адамсыз?
Dialogue: 0,0:18:00.65,0:18:05.62,Default,,0000,0000,0000,,Бұл мен біраз уақыттан бері айтып жүрген оғаш нәрсе.
Dialogue: 0,0:18:00.65,0:18:05.62,Default,,0000,0000,0000,,Оның есімі Архат...
Dialogue: 0,0:18:00.65,0:18:05.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:09.05,0:18:11.06,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:09.05,0:18:11.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:11.06,0:18:13.56,Default,,0000,0000,0000,,Мен әйтеуір жоқ деп айтамын
Dialogue: 0,0:18:11.06,0:18:13.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:13.56,0:18:15.56,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:18:13.56,0:18:15.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:15.56,0:18:19.06,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:18:15.56,0:18:19.06,Default,,0000,0000,0000,,Мен жұмысқа қайта барамын.
Dialogue: 0,0:18:15.56,0:18:19.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:22.07,0:18:25.64,Default,,0000,0000,0000,,Мен мұндай бетті бұрын ешқашан көрген емеспін.
Dialogue: 0,0:18:22.07,0:18:25.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:25.64,0:18:30.04,Default,,0000,0000,0000,,Мен оны қайта көргім келмейді
Dialogue: 0,0:18:25.64,0:18:30.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:30.04,0:18:33.55,Default,,0000,0000,0000,,《Ха~
Dialogue: 0,0:18:30.04,0:18:33.55,Default,,0000,0000,0000,,Күтілгендей
Dialogue: 0,0:18:30.04,0:18:33.55,Default,,0000,0000,0000,,Байқадыңыз ба?
Dialogue: 0,0:18:48.59,0:18:51.66,Default,,0000,0000,0000,,(
Dialogue: 0,0:18:48.59,0:18:51.66,Default,,0000,0000,0000,,Иіскеу дыбысы
Dialogue: 0,0:18:48.59,0:18:51.66,Default,,0000,0000,0000,,)
Dialogue: 0,0:18:48.59,0:18:51.66,Default,,0000,0000,0000,,Мен бұны шешемін.
Dialogue: 0,0:18:48.59,0:18:51.66,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:51.66,0:18:53.57,Default,,0000,0000,0000,,Бұл емдік шөп алқабы!
Dialogue: 0,0:18:53.57,0:18:56.54,Default,,0000,0000,0000,,Мұнда да!
Dialogue: 0,0:18:53.57,0:18:56.54,Default,,0000,0000,0000,,Онда да!
Dialogue: 0,0:18:53.57,0:18:56.54,Default,,0000,0000,0000,,Онда да!
Dialogue: 0,0:18:56.54,0:18:58.07,Default,,0000,0000,0000,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:18:56.54,0:18:58.07,Default,,0000,0000,0000,,Аа…
Dialogue: 0,0:18:56.54,0:18:58.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:58.07,0:19:01.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:18:58.07,0:19:01.57,Default,,0000,0000,0000,,Суирей
Dialogue: 0,0:18:58.07,0:19:01.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:18:58.07,0:19:01.57,Default,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:18:58.07,0:19:01.57,Default,,0000,0000,0000,,Сіз бе?
Dialogue: 0,0:18:58.07,0:19:01.57,Default,,0000,0000,0000,,О!
Dialogue: 0,0:19:01.57,0:19:04.54,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:01.57,0:19:04.54,Default,,0000,0000,0000,,А...
Dialogue: 0,0:19:01.57,0:19:04.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:04.54,0:19:08.58,Default,,0000,0000,0000,,《Мен қаламаймын
Dialogue: 0,0:19:04.54,0:19:08.58,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:19:04.54,0:19:08.58,Default,,0000,0000,0000,,Қалай қарасаңыз да, бұл тым күдікті》
Dialogue: 0,0:19:08.58,0:19:11.62,Default,,0000,0000,0000,,Дәл ойлағанымдай
Dialogue: 0,0:19:08.58,0:19:11.62,Default,,0000,0000,0000,,Мен әлі ештеңе таңдаған жоқпын.
Dialogue: 0,0:19:08.58,0:19:11.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:11.62,0:19:13.15,Default,,0000,0000,0000,,Бұл қолдар кір➡
Dialogue: 0,0:19:13.15,0:19:17.06,Default,,0000,0000,0000,,Мен оны алып кете жаздадым.
Dialogue: 0,0:19:13.15,0:19:17.06,Default,,0000,0000,0000,,Сізді тануға бола ма?
Dialogue: 0,0:19:17.06,0:19:19.09,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:19:19.09,0:19:20.53,Default,,0000,0000,0000,,А...
Dialogue: 0,0:19:19.09,0:19:20.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:20.53,0:19:26.06,Default,,0000,0000,0000,,Бөлек
Dialogue: 0,0:19:20.53,0:19:26.06,Default,,0000,0000,0000,,Мен сені кінәламаймын.
Dialogue: 0,0:19:20.53,0:19:26.06,Default,,0000,0000,0000,,Бұл бейресми өріс.
Dialogue: 0,0:19:20.53,0:19:26.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:26.06,0:19:32.07,Default,,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:19:26.06,0:19:32.07,Default,,0000,0000,0000,,Бұл жерді тіпті медицина қызметкерлері де біледі.
Dialogue: 0,0:19:26.06,0:19:32.07,Default,,0000,0000,0000,,Артық кіріп-шықпаған дұрыс.
Dialogue: 0,0:19:26.06,0:19:32.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:32.07,0:19:36.14,Default,,0000,0000,0000,,Бұл жерге сіз жауаптысыз ба?
Dialogue: 0,0:19:32.07,0:19:36.14,Default,,0000,0000,0000,,Қақпаны жабасың дедің бе?
Dialogue: 0,0:19:32.07,0:19:36.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:36.14,0:19:40.05,Default,,0000,0000,0000,,Маған да ұнайтын нәрсе
Dialogue: 0,0:19:36.14,0:19:40.05,Default,,0000,0000,0000,,Мен сізге оны отырғызуға рұқсат етемін.
Dialogue: 0,0:19:36.14,0:19:40.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:40.05,0:19:43.55,Default,,0000,0000,0000,,《Тек арамшөптер таңдалып, жұлынады》
Dialogue: 0,0:19:43.55,0:19:47.05,Default,,0000,0000,0000,,《Әрине
Dialogue: 0,0:19:43.55,0:19:47.05,Default,,0000,0000,0000,,Ол Суирей деп аталды》
Dialogue: 0,0:19:47.05,0:19:49.56,Default,,0000,0000,0000,,《Мен адамдардың атынан сөйлей алмаймын➡
Dialogue: 0,0:19:49.56,0:19:53.56,Default,,0000,0000,0000,,Өте жігерлі тұлға емес
Dialogue: 0,0:19:49.56,0:19:53.56,Default,,0000,0000,0000,,Бұл екіталай көрінеді》
Dialogue: 0,0:19:53.56,0:19:56.06,Default,,0000,0000,0000,,Сіз не отырғызып жатырсыз?
Dialogue: 0,0:19:57.60,0:20:01.17,Default,,0000,0000,0000,,(
Dialogue: 0,0:19:57.60,0:20:01.17,Default,,0000,0000,0000,,Желдің дыбысы
Dialogue: 0,0:19:57.60,0:20:01.17,Default,,0000,0000,0000,,)
Dialogue: 0,0:20:01.17,0:20:03.54,Default,,0000,0000,0000,,Жаңғыру
Dialogue: 0,0:20:01.17,0:20:03.54,Default,,0000,0000,0000,,Қайта тірілу медицинасы
Dialogue: 0,0:20:01.17,0:20:03.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:03.54,0:20:05.54,Default,,0000,0000,0000,,Ha
Dialogue: 0,0:20:03.54,0:20:05.54,Default,,0000,0000,0000,,Бұл...
