Dialogue: 0,0:09:23.63,0:09:27.63,Default,,0000,0000,0000,,Бұл жақсы жыл
Dialogue: 0,0:09:23.63,0:09:27.63,Default,,0000,0000,0000,,Мен бұл туралы дұрыс ойлауым керек.
Dialogue: 0,0:09:23.63,0:09:27.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:27.63,0:09:29.64,Default,,0000,0000,0000,,Мисодзи
Dialogue: 0,0:09:27.63,0:09:29.64,Default,,0000,0000,0000,,《Мен әлі 30 жастамын➡
Dialogue: 0,0:09:29.64,0:09:33.71,Default,,0000,0000,0000,,Жезөкше ретінде
Dialogue: 0,0:09:29.64,0:09:33.71,Default,,0000,0000,0000,,Бұл зейнеткерлік жас.
Dialogue: 0,0:09:33.71,0:09:36.24,Default,,0000,0000,0000,,Тәуелсіз болсақ ше?
Dialogue: 0,0:09:33.71,0:09:36.24,Default,,0000,0000,0000,,Хаха
Dialogue: 0,0:09:33.71,0:09:36.24,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:36.24,0:09:39.25,Default,,0000,0000,0000,,Тағы да
Dialogue: 0,0:09:36.24,0:09:39.25,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:44.62,0:09:49.62,Default,,0000,0000,0000,,Тағы біраз
Dialogue: 0,0:09:44.62,0:09:49.62,Default,,0000,0000,0000,,Мен бұл жұмысты жалғастырамын.
Dialogue: 0,0:09:44.62,0:09:49.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:49.62,0:09:54.63,Default,,0000,0000,0000,,Не-чан
