Dialogue: 0,0:20:05.54,0:20:08.57,Default,,0000,0000,0000,,《Өлгендерді тірілтетін дәрі》
Dialogue: 0,0:20:08.57,0:20:14.55,Default,,0000,0000,0000,,《Егер мұндай нәрсе бар болса
Dialogue: 0,0:20:08.57,0:20:14.55,Default,,0000,0000,0000,,Менің тамағымнан шыққанын қалаймын! 》
Dialogue: 0,0:20:14.55,0:20:17.02,Default,,0000,0000,0000,,Жай әзіл.
Dialogue: 0,0:20:14.55,0:20:17.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:17.02,0:20:18.55,Default,,0000,0000,0000,,Жай әзіл...
Dialogue: 0,0:20:17.02,0:20:18.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:18.55,0:20:21.65,Default,,0000,0000,0000,,Кусуши
Dialogue: 0,0:20:18.55,0:20:21.65,Default,,0000,0000,0000,,Не керек, Крюгер мырза?
Dialogue: 0,0:20:18.55,0:20:21.65,Default,,0000,0000,0000,,Мен Якуши➡ туралы естідім
Dialogue: 0,0:20:21.65,0:20:25.56,Default,,0000,0000,0000,,Оның қаншалықты шебер екеніне таңғаламын.
Dialogue: 0,0:20:21.65,0:20:25.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:25.56,0:20:27.56,Default,,0000,0000,0000,,Цукуёми, тез бол, тез бол
Dialogue: 0,0:20:25.56,0:20:27.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:32.06,0:20:37.57,Default,,0000,0000,0000,,Бұл сәл алыс.
Dialogue: 0,0:20:32.06,0:20:37.57,Default,,0000,0000,0000,,Мен мұнда таңғы даңқтарды отырғызамын.
Dialogue: 0,0:20:32.06,0:20:37.57,Default,,0000,0000,0000,,. [жиырма екі] .
