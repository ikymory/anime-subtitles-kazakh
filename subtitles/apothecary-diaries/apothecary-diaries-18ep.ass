Dialogue: 0,0:08:28.14,0:08:31.64,Default,,0000,0000,0000,,)
Dialogue: 0,0:08:28.14,0:08:31.64,Default,,0000,0000,0000,,Жақсы жұмыс~
Dialogue: 0,0:08:28.14,0:08:31.64,Default,,0000,0000,0000,,Сол тұтынушы
Dialogue: 0,0:08:28.14,0:08:31.64,Default,,0000,0000,0000,,Мен қазірдің өзінде үйдемін
Dialogue: 0,0:08:28.14,0:08:31.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:31.64,0:08:34.65,Default,,0000,0000,0000,,Не-чан
Dialogue: 0,0:08:31.64,0:08:34.65,Default,,0000,0000,0000,,Сізбен қарым-қатынас жасаған Мэй Мэй Сяодзи болды ма?
Dialogue: 0,0:08:31.64,0:08:34.65,Default,,0000,0000,0000,,(
Dialogue: 0,0:08:31.64,0:08:34.65,Default,,0000,0000,0000,,Есіктің жабылу дыбысы
Dialogue: 0,0:08:31.64,0:08:34.65,Default,,0000,0000,0000,,)
Dialogue: 0,0:08:34.65,0:08:36.65,Default,,0000,0000,0000,,Басқа ешкім жоқ, солай ма?
Dialogue: 0,0:08:34.65,0:08:36.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:36.65,0:08:41.12,Default,,0000,0000,0000,,Не-сан
Dialogue: 0,0:08:36.65,0:08:41.12,Default,,0000,0000,0000,,Жақсы...
Dialogue: 0,0:08:36.65,0:08:41.12,Default,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:08:36.65,0:08:41.12,Default,,0000,0000,0000,,Сіз бүгін өзіңізді жақсы сезінетін сияқтысыз.
Dialogue: 0,0:08:36.65,0:08:41.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:41.12,0:08:44.19,Default,,0000,0000,0000,,Мысық мысық
Dialogue: 0,0:08:41.12,0:08:44.19,Default,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:08:41.12,0:08:44.19,Default,,0000,0000,0000,,Бұл оқиға келді.
Dialogue: 0,0:08:41.12,0:08:44.19,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:44.19,0:08:46.73,Default,,0000,0000,0000,,А...
Dialogue: 0,0:08:44.19,0:08:46.73,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:46.73,0:08:50.63,Default,,0000,0000,0000,,Не-чан
Dialogue: 0,0:08:46.73,0:08:50.63,Default,,0000,0000,0000,,Кішкентай әпке
Dialogue: 0,0:08:46.73,0:08:50.63,Default,,0000,0000,0000,,Біз жақсы араласамыз.
Dialogue: 0,0:08:46.73,0:08:50.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:46.73,0:08:50.63,Default,,0000,0000,0000,,(
Dialogue: 0,0:08:46.73,0:08:50.63,Default,,0000,0000,0000,,Умеуме
Dialogue: 0,0:08:46.73,0:08:50.63,Default,,0000,0000,0000,,)
Dialogue: 0,0:08:46.73,0:08:50.63,Default,,0000,0000,0000,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,0:08:50.63,0:08:54.10,Default,,0000,0000,0000,,Ақшаны әже төлегенше,
Dialogue: 0,0:08:50.63,0:08:54.10,Default,,0000,0000,0000,,Ештеңе айтпа
Dialogue: 0,0:08:50.63,0:08:54.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:54.10,0:08:58.64,Default,,0000,0000,0000,,Әжем жезөкше болғанымды қалайды.
Dialogue: 0,0:08:54.10,0:08:58.64,Default,,0000,0000,0000,,Менің ойымша, солай.
Dialogue: 0,0:08:54.10,0:08:58.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:58.64,0:09:02.61,Default,,0000,0000,0000,,Жұмыссыз болса
Dialogue: 0,0:08:58.64,0:09:02.61,Default,,0000,0000,0000,,Қазір туралы
Dialogue: 0,0:08:58.64,0:09:02.61,Default,,0000,0000,0000,,Ол сатылған болуы мүмкін.
Dialogue: 0,0:08:58.64,0:09:02.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:02.61,0:09:05.65,Default,,0000,0000,0000,,Басқа тұрғыдан
Dialogue: 0,0:09:02.61,0:09:05.65,Default,,0000,0000,0000,,Бұл өмірде бір рет болатын мүмкіндік.
Dialogue: 0,0:09:02.61,0:09:05.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:05.65,0:09:10.72,Default,,0000,0000,0000,,Тілеу және қалау
Dialogue: 0,0:09:05.65,0:09:10.72,Default,,0000,0000,0000,,Орындайтын сыпайы
Dialogue: 0,0:09:05.65,0:09:10.72,Default,,0000,0000,0000,,Оның қаншалықты аз екенін білесің бе?
Dialogue: 0,0:09:10.72,0:09:14.62,Default,,0000,0000,0000,,Күміс салмағы бар кемпір
Dialogue: 0,0:09:10.72,0:09:14.62,Default,,0000,0000,0000,,Осымен
Dialogue: 0,0:09:10.72,0:09:14.62,Default,,0000,0000,0000,,Мен сені қуып жіберемін.
Dialogue: 0,0:09:10.72,0:09:14.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:14.62,0:09:16.12,Default,,0000,0000,0000,,Хехехе…
Dialogue: 0,0:09:14.62,0:09:16.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:16.12,0:09:20.63,Default,,0000,0000,0000,,Жұмаққа бару
Dialogue: 0,0:09:16.12,0:09:20.63,Default,,0000,0000,0000,,Өйткені мен оны жинап жатырмын
Dialogue: 0,0:09:16.12,0:09:20.63,Default,,0000,0000,0000,,Мен бұған көмектесе алмаймын.
Dialogue: 0,0:09:16.12,0:09:20.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:23.63,0:09:27.63,Default,,0000,0000,0000,,Мен де
