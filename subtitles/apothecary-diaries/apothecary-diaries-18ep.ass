Dialogue: 0,0:01:38.13,0:01:41.60,Default,,0000,0000,0000,,Джинши
Dialogue: 0,0:01:38.13,0:01:41.60,Default,,0000,0000,0000,,Джиджо
Dialogue: 0,0:01:38.13,0:01:41.60,Default,,0000,0000,0000,,(
Dialogue: 0,0:01:38.13,0:01:41.60,Default,,0000,0000,0000,,Джинши
Dialogue: 0,0:01:38.13,0:01:41.60,Default,,0000,0000,0000,,)
Dialogue: 0,0:01:38.13,0:01:41.60,Default,,0000,0000,0000,,Жезөкшелердің құнын түсіру
Dialogue: 0,0:01:38.13,0:01:41.60,Default,,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,0:01:41.60,0:01:46.11,Default,,0000,0000,0000,,Мао Мао
Dialogue: 0,0:01:41.60,0:01:46.11,Default,,0000,0000,0000,,(
Dialogue: 0,0:01:41.60,0:01:46.11,Default,,0000,0000,0000,,Мысық мысық
Dialogue: 0,0:01:41.60,0:01:46.11,Default,,0000,0000,0000,,)
Dialogue: 0,0:01:41.60,0:01:46.11,Default,,0000,0000,0000,,Егер сіз бала көтерсеңіз
Dialogue: 0,0:01:41.60,0:01:46.11,Default,,0000,0000,0000,,Оның құндылығы жоқ.
Dialogue: 0,0:01:41.60,0:01:46.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:01:52.61,0:01:54.18,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:01:52.61,0:01:54.18,Default,,0000,0000,0000,,.
Dialogue: 0,0:01:54.18,0:01:56.72,Default,,0000,0000,0000,,Мақсатты дүкен
Dialogue: 0,0:01:54.18,0:01:56.72,Default,,0000,0000,0000,,Бұл солай емес пе?
Dialogue: 0,0:01:54.18,0:01:56.72,Default,,0000,0000,0000,,.
Dialogue: 0,0:01:56.72,0:01:58.22,Default,,0000,0000,0000,,Ха…
Dialogue: 0,0:01:56.72,0:01:58.22,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:01.62,0:02:04.62,Default,,0000,0000,0000,,Олай болса, кешіріңіз.
Dialogue: 0,0:02:01.62,0:02:04.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:10.63,0:02:12.63,Default,,0000,0000,0000,,Мұнда?
Dialogue: 0,0:02:12.63,0:02:17.64,Default,,0000,0000,0000,,Мен бетперде үшін қиналсам да.
Dialogue: 0,0:02:12.63,0:02:17.64,Default,,0000,0000,0000,,Ішке кіруім жақсы болмас еді.
Dialogue: 0,0:02:12.63,0:02:17.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:17.64,0:02:19.67,Default,,0000,0000,0000,,А...
Dialogue: 0,0:02:17.64,0:02:19.67,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:19.67,0:02:21.14,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:02:19.67,0:02:21.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:28.15,0:02:30.15,Default,,0000,0000,0000,,《Жарайды》
Dialogue: 0,0:02:30.15,0:02:33.52,Default,,0000,0000,0000,,《Ешбір эмоциясыз
Dialogue: 0,0:02:30.15,0:02:33.52,Default,,0000,0000,0000,,Мен мұны айтуым керек еді.
Dialogue: 0,0:02:41.63,0:02:45.13,Default,,0000,0000,0000,,Марсельдің естеліктерін көрдің бе?
Dialogue: 0,0:02:41.63,0:02:45.13,Default,,0000,0000,0000,,Бүгін түнде
Dialogue: 0,0:02:41.63,0:02:45.13,Default,,0000,0000,0000,,Ләззат алыңыз
Dialogue: 0,0:02:41.63,0:02:45.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:52.71,0:02:59.18,Default,,0000,0000,0000,,｜Сәбидің жылауы｠
Dialogue: 0,0:03:02.12,0:03:06.15,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:03:02.12,0:03:06.15,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:03:02.12,0:03:06.15,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:03:02.12,0:03:06.15,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:03:02.12,0:03:06.15,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:06.15,0:03:08.69,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:03:06.15,0:03:08.69,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:03:06.15,0:03:08.69,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:08.69,0:03:13.19,Default,,0000,0000,0000,,《Ескі армандар...
Dialogue: 0,0:03:08.69,0:03:13.19,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:03:08.69,0:03:13.19,Default,,0000,0000,0000,,Сәби кезімдегі арманым?
Dialogue: 0,0:03:16.60,0:03:19.60,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:03:16.60,0:03:19.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:16.60,0:03:19.60,Default,,0000,0000,0000,,《Мүмкін мен осылай сөйлегендіктен шығар》
Dialogue: 0,0:03:19.60,0:03:22.60,Default,,0000,0000,0000,,Луомен
Dialogue: 0,0:03:19.60,0:03:22.60,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:19.60,0:03:22.60,Default,,0000,0000,0000,,Рамон
Dialogue: 0,0:03:19.60,0:03:22.60,Default,,0000,0000,0000,,)
Dialogue: 0,0:03:19.60,0:03:22.60,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:03:19.60,0:03:22.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:19.60,0:03:22.60,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:19.60,0:03:22.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:22.60,0:03:25.61,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:03:22.60,0:03:25.61,Default,,0000,0000,0000,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:03:22.60,0:03:25.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:27.61,0:03:31.11,Default,,0000,0000,0000,,Он соққылы қарғыс техникасы: Тайл құлау, Тайл құлау!
Dialogue: 0,0:03:27.61,0:03:31.11,Default,,0000,0000,0000,,​​Біз не істеуіміз керек?
Dialogue: 0,0:03:27.61,0:03:31.11,Default,,0000,0000,0000,,Бөлек
Dialogue: 0,0:03:27.61,0:03:31.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:31.11,0:03:36.18,Default,,0000,0000,0000,,Егер арнайы пайдалану болмаса
Dialogue: 0,0:03:31.11,0:03:36.18,Default,,0000,0000,0000,,Рокушокан
Dialogue: 0,0:03:31.11,0:03:36.18,Default,,0000,0000,0000,,Жасыл үйге бара аласыз ба?
Dialogue: 0,0:03:36.18,0:03:38.15,Default,,0000,0000,0000,,Жарайды, бірақ
Dialogue: 0,0:03:36.18,0:03:38.15,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:41.62,0:03:45.63,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:41.62,0:03:45.63,Default,,0000,0000,0000,,Есіктің ашылу/жабылу дыбысы
Dialogue: 0,0:03:41.62,0:03:45.63,Default,,0000,0000,0000,,)
Dialogue: 0,0:03:41.62,0:03:45.63,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:41.62,0:03:45.63,Default,,0000,0000,0000,,Дұрыс жылау
Dialogue: 0,0:03:41.62,0:03:45.63,Default,,0000,0000,0000,,)
Dialogue: 0,0:03:41.62,0:03:45.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:41.62,0:03:45.63,Default,,0000,0000,0000,,«және күн сайын күрсінемін.»
Dialogue: 0,0:03:41.62,0:03:45.63,Default,,0000,0000,0000,,Мысық мысық
Dialogue: 0,0:03:41.62,0:03:45.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:45.63,0:03:47.66,Default,,0000,0000,0000,,Жұмысыңыз жақсы ма?
Dialogue: 0,0:03:47.66,0:03:50.13,Default,,0000,0000,0000,,Because I got a day off.
Dialogue: 0,0:03:47.66,0:03:50.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:52.13,0:03:55.64,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:52.13,0:03:55.64,Default,,0000,0000,0000,,Оң жақ айқай
Dialogue: 0,0:03:52.13,0:03:55.64,Default,,0000,0000,0000,,)
Dialogue: 0,0:03:52.13,0:03:55.64,Default,,0000,0000,0000,,Демалыс күні болса да
Dialogue: 0,0:03:52.13,0:03:55.64,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:03:52.13,0:03:55.64,Default,,0000,0000,0000,,Сіз дәріханаға келдіңіз.
Dialogue: 0,0:03:52.13,0:03:55.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:55.64,0:03:59.17,Default,,0000,0000,0000,,Айтпақшы...
Dialogue: 0,0:03:55.64,0:03:59.17,Default,,0000,0000,0000,,Мен келген себебім емес.
Dialogue: 0,0:03:55.64,0:03:59.17,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:59.17,0:04:01.21,Default,,0000,0000,0000,,Хаг
Dialogue: 0,0:03:59.17,0:04:01.21,Default,,0000,0000,0000,,Пейлин
Dialogue: 0,0:03:59.17,0:04:01.21,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:59.17,0:04:01.21,Default,,0000,0000,0000,,Яри Теба
Dialogue: 0,0:03:59.17,0:04:01.21,Default,,0000,0000,0000,,)
Dialogue: 0,0:03:59.17,0:04:01.21,Default,,0000,0000,0000,,⚟Күтіңіз.
Dialogue: 0,0:03:59.17,0:04:01.21,Default,,0000,0000,0000,,Ақ қоңырау! ⚞
Dialogue: 0,0:03:59.17,0:04:01.21,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:59.17,0:04:01.21,Default,,0000,0000,0000,,2 адам
Dialogue: 0,0:03:59.17,0:04:01.21,Default,,0000,0000,0000,,)
Dialogue: 0,0:03:59.17,0:04:01.21,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:01.21,0:04:03.64,Default,,0000,0000,0000,,(
Dialogue: 0,0:04:01.21,0:04:03.64,Default,,0000,0000,0000,,Ақ қоңырау
Dialogue: 0,0:04:01.21,0:04:03.64,Default,,0000,0000,0000,,)
Dialogue: 0,0:04:01.21,0:04:03.64,Default,,0000,0000,0000,,Бұл оқиға
Dialogue: 0,0:04:01.21,0:04:03.64,Default,,0000,0000,0000,,Бұл жеткілікті
Dialogue: 0,0:04:01.21,0:04:03.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:03.64,0:04:06.15,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:04:03.64,0:04:06.15,Default,,0000,0000,0000,,Мысық мысық!
Dialogue: 0,0:04:06.15,0:04:07.61,Default,,0000,0000,0000,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:04:06.15,0:04:07.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:10.12,0:04:13.12,Default,,0000,0000,0000,,Ахха~
Dialogue: 0,0:04:10.12,0:04:13.12,Default,,0000,0000,0000,,Қайтадан қош келдіңіз~
Dialogue: 0,0:04:10.12,0:04:13.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:13.12,0:04:15.12,Default,,0000,0000,0000,,Не-чан
Dialogue: 0,0:04:13.12,0:04:15.12,Default,,0000,0000,0000,,Күн ыстық
Dialogue: 0,0:04:13.12,0:04:15.12,Default,,0000,0000,0000,,Байзузукоджи
Dialogue: 0,0:04:13.12,0:04:15.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:15.12,0:04:18.16,Default,,0000,0000,0000,,Мен суықпын
Dialogue: 0,0:04:15.12,0:04:18.16,Default,,0000,0000,0000,,Әжемнің ренішімен
Dialogue: 0,0:04:15.12,0:04:18.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:18.16,0:04:20.19,Default,,0000,0000,0000,,(
Dialogue: 0,0:04:18.16,0:04:20.19,Default,,0000,0000,0000,,Яри Теба
Dialogue: 0,0:04:18.16,0:04:20.19,Default,,0000,0000,0000,,)
Dialogue: 0,0:04:18.16,0:04:20.19,Default,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:04:18.16,0:04:20.19,Default,,0000,0000,0000,,Бұл әлі аяқталған жоқ!
Dialogue: 0,0:04:20.19,0:04:23.13,Default,,0000,0000,0000,,Цукуёми, тез бол, тез бол
Dialogue: 0,0:04:20.19,0:04:23.13,Default,,0000,0000,0000,,Мен қайсысын таңдауым керек?
Dialogue: 0,0:04:20.19,0:04:23.13,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:04:20.19,0:04:23.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:23.13,0:04:28.10,Default,,0000,0000,0000,,《Мен шынымен түсінбеймін.
Dialogue: 0,0:04:23.13,0:04:28.10,Default,,0000,0000,0000,,Не-чан
Dialogue: 0,0:04:23.13,0:04:28.10,Default,,0000,0000,0000,,Кішкентай сіңлісі Байсузуға да қиын болған сияқты.
Dialogue: 0,0:04:28.10,0:04:30.14,Default,,0000,0000,0000,,Жалпы
Dialogue: 0,0:04:28.10,0:04:30.14,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:04:28.10,0:04:30.14,Default,,0000,0000,0000,,Өйткені мен мәңгілік қаламын➡
Dialogue: 0,0:04:30.14,0:04:32.14,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:04:30.14,0:04:32.14,Default,,0000,0000,0000,,Әңгімеге сіз жауаптысыз!
Dialogue: 0,0:04:32.14,0:04:35.14,Default,,0000,0000,0000,,Мен мұны сұраған жоқпын!
Dialogue: 0,0:04:32.14,0:04:35.14,Default,,0000,0000,0000,,Апай
Dialogue: 0,0:04:32.14,0:04:35.14,Default,,0000,0000,0000,,Бұл әрқашан маған байланысты!
Dialogue: 0,0:04:35.14,0:04:38.14,Default,,0000,0000,0000,,(
Dialogue: 0,0:04:35.14,0:04:38.14,Default,,0000,0000,0000,,Яри Теба
Dialogue: 0,0:04:35.14,0:04:38.14,Default,,0000,0000,0000,,)
Dialogue: 0,0:04:35.14,0:04:38.14,Default,,0000,0000,0000,,Ха~
Dialogue: 0,0:04:35.14,0:04:38.14,Default,,0000,0000,0000,,Эгоизм дегеніміз не?
Dialogue: 0,0:04:35.14,0:04:38.14,Default,,0000,0000,0000,,Не деген өзімшілдік!
Dialogue: 0,0:04:35.14,0:04:38.14,Default,,0000,0000,0000,,Сасаса…
Dialogue: 0,0:04:35.14,0:04:38.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:38.14,0:04:41.18,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:38.14,0:04:41.18,Default,,0000,0000,0000,,Мысық мысық
Dialogue: 0,0:04:38.14,0:04:41.18,Default,,0000,0000,0000,,Келдің бе?
Dialogue: 0,0:04:41.18,0:04:43.22,Default,,0000,0000,0000,,Біраз уақыттан бері
Dialogue: 0,0:04:41.18,0:04:43.22,Default,,0000,0000,0000,,Мен сонда болдым.
Dialogue: 0,0:04:41.18,0:04:43.22,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:43.22,0:04:45.65,Default,,0000,0000,0000,,Сен кетесің бе?
Dialogue: 0,0:04:45.65,0:04:48.12,Default,,0000,0000,0000,,(
Dialogue: 0,0:04:45.65,0:04:48.12,Default,,0000,0000,0000,,Яри Теба
Dialogue: 0,0:04:45.65,0:04:48.12,Default,,0000,0000,0000,,)
Dialogue: 0,0:04:45.65,0:04:48.12,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:04:45.65,0:04:48.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:01.67,0:05:03.14,Default,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:05:01.67,0:05:03.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:05.20,0:05:08.61,Default,,0000,0000,0000,,《Бұрын мені адамдар жек көретін.
Dialogue: 0,0:05:05.20,0:05:08.61,Default,,0000,0000,0000,,Мені қуып жіберді➡
Dialogue: 0,0:05:08.61,0:05:11.64,Default,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:05:08.61,0:05:11.64,Default,,0000,0000,0000,,Сізде мұндай қуат жоқ па?
Dialogue: 0,0:05:11.64,0:05:16.12,Default,,0000,0000,0000,,Немесе
Dialogue: 0,0:05:11.64,0:05:16.12,Default,,0000,0000,0000,,Сөздерді ұмытып қалдыңыз ба?
Dialogue: 0,0:05:16.12,0:05:21.12,Default,,0000,0000,0000,,《Ауру асқынып кетті
Dialogue: 0,0:05:16.12,0:05:21.12,Default,,0000,0000,0000,,Сондай-ақ естеліктер
Dialogue: 0,0:05:16.12,0:05:21.12,Default,,0000,0000,0000,,Жыртылған》
Dialogue: 0,0:05:27.16,0:05:30.23,Default,,0000,0000,0000,,《Ояджидің дәрісі
Dialogue: 0,0:05:27.16,0:05:30.23,Default,,0000,0000,0000,,Бұл жақсы жұмыс істейді➡
Dialogue: 0,0:05:30.23,0:05:33.13,Default,,0000,0000,0000,,Бұл не болады?
Dialogue: 0,0:05:30.23,0:05:33.13,Default,,0000,0000,0000,,Бұл тіпті босаңсытпайды》
Dialogue: 0,0:05:33.13,0:05:38.14,Default,,0000,0000,0000,,《Әлі
Dialogue: 0,0:05:33.13,0:05:38.14,Default,,0000,0000,0000,,Менің беруден басқа амалым жоқ
Dialogue: 0,0:05:33.13,0:05:38.14,Default,,0000,0000,0000,,Мен емдеуді білмеймін》
Dialogue: 0,0:05:38.14,0:05:41.14,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:38.14,0:05:41.14,Default,,0000,0000,0000,,Қақ
Dialogue: 0,0:05:38.14,0:05:41.14,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:38.14,0:05:41.14,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:38.14,0:05:41.14,Default,,0000,0000,0000,,Есіктің ашылған дыбысы
Dialogue: 0,0:05:38.14,0:05:41.14,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:41.14,0:05:46.11,Default,,0000,0000,0000,,Сол тұтынушы
Dialogue: 0,0:05:41.14,0:05:46.11,Default,,0000,0000,0000,,Мен қайта ораламын.
Dialogue: 0,0:05:41.14,0:05:46.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:41.14,0:05:46.11,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:41.14,0:05:46.11,Default,,0000,0000,0000,,Яри Теба
Dialogue: 0,0:05:41.14,0:05:46.11,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:41.14,0:05:46.11,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:05:41.14,0:05:46.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:46.11,0:05:51.12,Default,,0000,0000,0000,,Мүлдем емес
Dialogue: 0,0:05:46.11,0:05:51.12,Default,,0000,0000,0000,,Менің мұрным өте жақсы емес...
Dialogue: 0,0:05:46.11,0:05:51.12,Default,,0000,0000,0000,,Меймей
Dialogue: 0,0:05:46.11,0:05:51.12,Default,,0000,0000,0000,,Умеумге қоңырау шалыңыз
Dialogue: 0,0:05:46.11,0:05:51.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:52.69,0:05:56.62,Default,,0000,0000,0000,,《Гокусейкан
Dialogue: 0,0:05:52.69,0:05:56.62,Default,,0000,0000,0000,,Джиро
Dialogue: 0,0:05:52.69,0:05:56.62,Default,,0000,0000,0000,,Қазіргі уақытта бұл беделді сот ғимараты➡
Dialogue: 0,0:05:56.62,0:06:01.63,Default,,0000,0000,0000,,Он жыл бұрын
Dialogue: 0,0:05:56.62,0:06:01.63,Default,,0000,0000,0000,,Балшықпен жабылған белгі
Dialogue: 0,0:05:56.62,0:06:01.63,Default,,0000,0000,0000,,Мен болған кез болды
Dialogue: 0,0:06:01.63,0:06:04.63,Default,,0000,0000,0000,,《Бұл жезөкше
Dialogue: 0,0:06:01.63,0:06:04.63,Default,,0000,0000,0000,,Осы бірнеше жыл ішінде тұтынушылар жинады➡
Dialogue: 0,0:06:04.63,0:06:07.60,Default,,0000,0000,0000,,Өкінішке орай, мен мерезбен ауырдым.
Dialogue: 0,0:06:11.64,0:06:14.71,Default,,0000,0000,0000,,《Әкем Рёкусейканға барғанда➡
Dialogue: 0,0:06:14.71,0:06:17.61,Default,,0000,0000,0000,,Мен жаңа ғана ауырып қалдым.
Dialogue: 0,0:06:14.71,0:06:17.61,Default,,0000,0000,0000,,Ол инкубациялық кезеңде болған сияқты》
Dialogue: 0,0:06:17.61,0:06:21.15,Default,,0000,0000,0000,,《Егер мен оларға жағдайымды айтсам.
Dialogue: 0,0:06:17.61,0:06:21.15,Default,,0000,0000,0000,,Мен онымен айналыса алар едім➡
Dialogue: 0,0:06:21.15,0:06:24.65,Default,,0000,0000,0000,,Канган
Dialogue: 0,0:06:21.15,0:06:24.65,Default,,0000,0000,0000,,Кенеттен бұрынғы уәзір пайда болды➡
Dialogue: 0,0:06:24.65,0:06:28.62,Default,,0000,0000,0000,,Барлығы адал
Dialogue: 0,0:06:24.65,0:06:28.62,Default,,0000,0000,0000,,Мен бұған сену мүмкін емес еді.
Dialogue: 0,0:06:30.62,0:06:33.13,Default,,0000,0000,0000,,《Тұтынушы таппасаң, жей алмайсың.》
Dialogue: 0,0:06:33.13,0:06:36.16,Default,,0000,0000,0000,,Ояныңыз
Dialogue: 0,0:06:33.13,0:06:36.16,Default,,0000,0000,0000,,《Бұл гарнизонның заңы.》
Dialogue: 0,0:06:36.16,0:06:39.70,Default,,0000,0000,0000,,《Бірнеше жылдан кейін
Dialogue: 0,0:06:36.16,0:06:39.70,Default,,0000,0000,0000,,Бөртпе қайтадан пайда бола бастағанда➡
Dialogue: 0,0:06:39.70,0:06:43.20,Default,,0000,0000,0000,,Ісік тез таралады》
Dialogue: 0,0:06:46.14,0:06:48.11,Default,,0000,0000,0000,,《Содан бері
