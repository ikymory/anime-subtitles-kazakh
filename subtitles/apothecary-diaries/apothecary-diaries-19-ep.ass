Dialogue: 0,0:01:53.65,0:01:57.22,Default,,0000,0000,0000,,Жұмыс туралы ұмытпаңыз
Dialogue: 0,0:01:53.65,0:01:57.22,Default,,0000,0000,0000,,.
Dialogue: 0,0:01:57.22,0:01:59.19,Default,,0000,0000,0000,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:01:57.22,0:01:59.19,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:02.09,0:02:04.62,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:02.09,0:02:04.62,Default,,0000,0000,0000,,Жүгіру қадамдары
Dialogue: 0,0:02:02.09,0:02:04.62,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:04.62,0:02:07.59,Default,,0000,0000,0000,,Мао Мао
Dialogue: 0,0:02:04.62,0:02:07.59,Default,,0000,0000,0000,,Рехаку
Dialogue: 0,0:02:04.62,0:02:07.59,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:04.62,0:02:07.59,Default,,0000,0000,0000,,Мысық мысық
Dialogue: 0,0:02:04.62,0:02:07.59,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:04.62,0:02:07.59,Default,,0000,0000,0000,,Ли Бай мырза
Dialogue: 0,0:02:04.62,0:02:07.59,Default,,0000,0000,0000,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:02:07.59,0:02:09.60,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:07.59,0:02:09.60,Default,,0000,0000,0000,,Ли Бай
Dialogue: 0,0:02:07.59,0:02:09.60,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:07.59,0:02:09.60,Default,,0000,0000,0000,,Бірдеңе ақаулық орын алды.
Dialogue: 0,0:02:07.59,0:02:09.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:09.60,0:02:12.07,Default,,0000,0000,0000,,Қиындыққа тап болдыңыз ба?
Dialogue: 0,0:02:12.07,0:02:14.60,Default,,0000,0000,0000,,Бұрын қоймада шағым болған.
Dialogue: 0,0:02:12.07,0:02:14.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:14.60,0:02:16.10,Default,,0000,0000,0000,,А...
Dialogue: 0,0:02:14.60,0:02:16.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:16.10,0:02:20.71,Default,,0000,0000,0000,,Сол күні
Dialogue: 0,0:02:16.10,0:02:20.71,Default,,0000,0000,0000,,Басқа қоймада
Dialogue: 0,0:02:16.10,0:02:20.71,Default,,0000,0000,0000,,Ұрлық болған сияқты.
Dialogue: 0,0:02:16.10,0:02:20.71,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:20.71,0:02:24.58,Default,,0000,0000,0000,,Сол кездегі дүрбелеңде
Dialogue: 0,0:02:20.71,0:02:24.58,Default,,0000,0000,0000,,Мен оны көбейтті деп ойлаймын.
Dialogue: 0,0:02:20.71,0:02:24.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:24.58,0:02:29.08,Default,,0000,0000,0000,,Сіз отты ұрысыз ба?
Dialogue: 0,0:02:24.58,0:02:29.08,Default,,0000,0000,0000,,Не ұрланды?
Dialogue: 0,0:02:29.08,0:02:30.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:31.62,0:02:34.59,Default,,0000,0000,0000,,《Бұл көпшіліктің назарынан тыс қалуы керек тақырып па?》
Dialogue: 0,0:02:34.59,0:02:36.09,Default,,0000,0000,0000,,《Қарау…》
Dialogue: 0,0:02:39.59,0:02:44.16,Default,,0000,0000,0000,,Салттық ыдыстар жоғалып кетті.
Dialogue: 0,0:02:39.59,0:02:44.16,Default,,0000,0000,0000,,Манга салмас бұрын жаттығулар
Dialogue: 0,0:02:39.59,0:02:44.16,Default,,0000,0000,0000,,​​Біреуден көп болса керек.
Dialogue: 0,0:02:39.59,0:02:44.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:44.16,0:02:46.60,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:02:44.16,0:02:46.60,Default,,0000,0000,0000,,Бұл ұқыпсыз басқару болды ма?
Dialogue: 0,0:02:46.60,0:02:50.10,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:02:46.60,0:02:50.10,Default,,0000,0000,0000,,Мен де түсінбеймін.
Dialogue: 0,0:02:46.60,0:02:50.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:50.10,0:02:53.11,Default,,0000,0000,0000,,Дәл қазір
Dialogue: 0,0:02:50.10,0:02:53.11,Default,,0000,0000,0000,,Егжей-тегжейлі әкімші жоқ.
Dialogue: 0,0:02:50.10,0:02:53.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:53.11,0:02:55.58,Default,,0000,0000,0000,,Өткен жылы
Dialogue: 0,0:02:53.11,0:02:55.58,Default,,0000,0000,0000,,Шамасы ол дүниеден өтті.
Dialogue: 0,0:02:53.11,0:02:55.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:55.58,0:02:59.08,Default,,0000,0000,0000,,Қазіргі әкімші кім?
Dialogue: 0,0:02:55.58,0:02:59.08,Default,,0000,0000,0000,,Do you understand the basics?
Dialogue: 0,0:02:59.08,0:03:03.62,Default,,0000,0000,0000,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:02:59.08,0:03:03.62,Default,,0000,0000,0000,,Біраз бұрын
Dialogue: 0,0:02:59.08,0:03:03.62,Default,,0000,0000,0000,,I think I got food poisoning.
Dialogue: 0,0:02:59.08,0:03:03.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:03.62,0:03:05.69,Default,,0000,0000,0000,,Тамақтан улану?
Dialogue: 0,0:03:05.69,0:03:09.59,Default,,0000,0000,0000,,Just like my favorite seaweed
Dialogue: 0,0:03:05.69,0:03:09.59,Default,,0000,0000,0000,,I haven’t regained consciousness➡
Dialogue: 0,0:03:09.59,0:03:13.56,Default,,0000,0000,0000,,Because I am unable to return to work.
Dialogue: 0,0:03:09.59,0:03:13.56,Default,,0000,0000,0000,,Мен қиындыққа тап болдым
Dialogue: 0,0:03:09.59,0:03:13.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:13.56,0:03:16.60,Default,,0000,0000,0000,,《I heard it somewhere》
Dialogue: 0,0:03:16.60,0:03:21.07,Default,,0000,0000,0000,,Бұл дегеніміз…
Dialogue: 0,0:03:16.60,0:03:21.07,Default,,0000,0000,0000,,Жер
Dialogue: 0,0:03:16.60,0:03:21.07,Default,,0000,0000,0000,,Is this a story about a government official who loves delicacies?
Dialogue: 0,0:03:21.07,0:03:23.10,Default,,0000,0000,0000,,Сіз қайдан білесіз?
Dialogue: 0,0:03:23.10,0:03:25.10,Default,,0000,0000,0000,,There are various things.
Dialogue: 0,0:03:23.10,0:03:25.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:25.10,0:03:28.14,Default,,0000,0000,0000,,《Theft that occurred at the same time as the voyage》
Dialogue: 0,0:03:28.14,0:03:32.58,Default,,0000,0000,0000,,《The warehouse manager is
Dialogue: 0,0:03:28.14,0:03:32.58,Default,,0000,0000,0000,,Absent due to food poisoning at the same time》
Dialogue: 0,0:03:32.58,0:03:35.58,Default,,0000,0000,0000,,《It is incomprehensible that it is a coincidence》
Dialogue: 0,0:03:35.58,0:03:39.59,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:03:35.58,0:03:39.59,Default,,0000,0000,0000,,Өткен жылы
Dialogue: 0,0:03:35.58,0:03:39.59,Default,,0000,0000,0000,,The deceased administrator
Dialogue: 0,0:03:35.58,0:03:39.59,Default,,0000,0000,0000,,What kind of person was he?
Dialogue: 0,0:03:39.59,0:03:41.09,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:03:39.59,0:03:41.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:41.09,0:03:44.59,Default,,0000,0000,0000,,He was a famously straight-laced man.
Dialogue: 0,0:03:41.09,0:03:44.59,Default,,0000,0000,0000,,Бұл есімде➡
Dialogue: 0,0:03:44.59,0:03:46.59,Default,,0000,0000,0000,,Аты көрсетілмейді
Dialogue: 0,0:03:44.59,0:03:46.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:46.59,0:03:50.66,Default,,0000,0000,0000,,He said he had a sweet tooth.
Dialogue: 0,0:03:46.59,0:03:50.66,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:03:46.59,0:03:50.66,Default,,0000,0000,0000,,Менің есімде...
Dialogue: 0,0:03:46.59,0:03:50.66,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:50.66,0:03:54.10,Default,,0000,0000,0000,,Жер
Dialogue: 0,0:03:50.66,0:03:54.10,Default,,0000,0000,0000,,Кунен
Dialogue: 0,0:03:50.66,0:03:54.10,Default,,0000,0000,0000,,Isn't it Koran-sama?
Dialogue: 0,0:03:50.66,0:03:54.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:54.10,0:03:56.10,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:54.10,0:03:56.10,Default,,0000,0000,0000,,Sound of snapping fingers
Dialogue: 0,0:03:54.10,0:03:56.10,Default,,0000,0000,0000,,)
Dialogue: 0,0:03:54.10,0:03:56.10,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:03:54.10,0:03:56.10,Default,,0000,0000,0000,,Зұлымдар Альянсы мен Шие Хачисай-кай арасында жақсы ынтымақтастық жоқ —
Dialogue: 0,0:03:54.10,0:03:56.10,Default,,0000,0000,0000,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:03:56.10,0:03:59.11,Default,,0000,0000,0000,,...
Dialogue: 0,0:03:56.10,0:03:59.11,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:03:56.10,0:03:59.11,Default,,0000,0000,0000,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:03:56.10,0:03:59.11,Default,,0000,0000,0000,,Алып тасташы, өтінемін...?
Dialogue: 0,0:03:56.10,0:03:59.11,Default,,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:03:56.10,0:03:59.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:59.11,0:04:01.11,Default,,0000,0000,0000,,There are various things.
Dialogue: 0,0:03:59.11,0:04:01.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:01.11,0:04:06.11,Default,,0000,0000,0000,,《Бұрын
Dialogue: 0,0:04:01.11,0:04:06.11,Default,,0000,0000,0000,,Джинджи мырзадан естіген
Dialogue: 0,0:04:01.11,0:04:06.11,Default,,0000,0000,0000,,Тәтті тіккен шенеунік➡
Dialogue: 0,0:04:06.11,0:04:09.12,Default,,0000,0000,0000,,Тұзды шамадан тыс ішіп өлген адам.
Dialogue: 0,0:04:09.12,0:04:12.15,Default,,0000,0000,0000,,《Бәрі осы
Dialogue: 0,0:04:09.12,0:04:12.15,Default,,0000,0000,0000,,Кездейсоқтық па? 》
Dialogue: 0,0:04:12.15,0:04:16.72,Default,,0000,0000,0000,,《Әрқайсысы апат сияқты көрінсе де,
Dialogue: 0,0:04:12.15,0:04:16.72,Default,,0000,0000,0000,,Егер
Dialogue: 0,0:04:12.15,0:04:16.72,Default,,0000,0000,0000,,Кейбір мақсат үшін➡
Dialogue: 0,0:04:16.72,0:04:20.09,Default,,0000,0000,0000,,Әдейі себеп болған
Dialogue: 0,0:04:16.72,0:04:20.09,Default,,0000,0000,0000,,Егер бұл бір нәрсе болса...》
Dialogue: 0,0:04:20.09,0:04:23.10,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:04:20.09,0:04:23.10,Default,,0000,0000,0000,,Менен бір нәрсе керек пе?
Dialogue: 0,0:04:23.10,0:04:24.60,Default,,0000,0000,0000,,Міне, солай!
Dialogue: 0,0:04:23.10,0:04:24.60,Default,,0000,0000,0000,,Негізгі тақырып
Dialogue: 0,0:04:23.10,0:04:24.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:24.60,0:04:28.10,Default,,0000,0000,0000,,Мен оны Мисс-чаннан сақтадым.
Dialogue: 0,0:04:24.60,0:04:28.10,Default,,0000,0000,0000,,Міне, осы.
Dialogue: 0,0:04:24.60,0:04:28.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:28.10,0:04:30.60,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:04:28.10,0:04:30.60,Default,,0000,0000,0000,,Боя уақыты
Dialogue: 0,0:04:28.10,0:04:30.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:30.60,0:04:34.61,Default,,0000,0000,0000,,Мен оны қайтаруға тырысқанда
Dialogue: 0,0:04:30.60,0:04:34.61,Default,,0000,0000,0000,,Иесіне
Dialogue: 0,0:04:30.60,0:04:34.61,Default,,0000,0000,0000,,Мені артқа итеріп жіберді
Dialogue: 0,0:04:30.60,0:04:34.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:34.61,0:04:36.11,Default,,0000,0000,0000,,Бұл маған қажет емес
Dialogue: 0,0:04:34.61,0:04:36.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:36.11,0:04:40.71,Default,,0000,0000,0000,,Өйткені бұл жоғары сапалы өнім
Dialogue: 0,0:04:36.11,0:04:40.71,Default,,0000,0000,0000,,Мен мұны маңызды нәрсе деп ойладым.
Dialogue: 0,0:04:36.11,0:04:40.71,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:40.71,0:04:43.62,Default,,0000,0000,0000,,Мен бәрібір жақсы боламын. Бар күшімді саламын
Dialogue: 0,0:04:40.71,0:04:43.62,Default,,0000,0000,0000,,Кейбір ресми ханымға
Dialogue: 0,0:04:40.71,0:04:43.62,Default,,0000,0000,0000,,Шамасы, оны алды.
Dialogue: 0,0:04:40.71,0:04:43.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:43.62,0:04:45.62,Default,,0000,0000,0000,,Үкімет ханымына ма?
Dialogue: 0,0:04:45.62,0:04:47.62,Default,,0000,0000,0000,,Сіз бұл біртүрлі деп ойламайсыз ба?
Dialogue: 0,0:04:47.62,0:04:51.59,Default,,0000,0000,0000,,Неліктен сокобан болдыңыз?
Dialogue: 0,0:04:47.62,0:04:51.59,Default,,0000,0000,0000,,Жолыңнан кет
Dialogue: 0,0:04:47.62,0:04:51.59,Default,,0000,0000,0000,,Осыған ұқсас әрекет жасаңыз
Dialogue: 0,0:04:47.62,0:04:51.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:53.13,0:04:57.60,Default,,0000,0000,0000,,(
Dialogue: 0,0:04:53.13,0:04:57.60,Default,,0000,0000,0000,,Ли Бай
Dialogue: 0,0:04:53.13,0:04:57.60,Default,,0000,0000,0000,,)
Dialogue: 0,0:04:53.13,0:04:57.60,Default,,0000,0000,0000,,Кез келген нәрсе Сокобанға барады.
Dialogue: 0,0:04:53.13,0:04:57.60,Default,,0000,0000,0000,,Қараңғыда
Dialogue: 0,0:04:53.13,0:04:57.60,Default,,0000,0000,0000,,Жалғыз серуендеп жүрген сот ханымы➡
Dialogue: 0,0:04:57.60,0:05:00.67,Default,,0000,0000,0000,,Мен оны қамал сыртына алып шықтым.
Dialogue: 0,0:04:57.60,0:05:00.67,Default,,0000,0000,0000,,Шамасы
Dialogue: 0,0:04:57.60,0:05:00.67,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:00.67,0:05:04.60,Default,,0000,0000,0000,,Бұл кисель
Dialogue: 0,0:05:00.67,0:05:04.60,Default,,0000,0000,0000,,Ол оны сол кезде алғыс ретінде алғанын айтты.
Dialogue: 0,0:05:00.67,0:05:04.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:04.60,0:05:07.11,Default,,0000,0000,0000,,Егер сіз осындай керемет нәрсені алсаңыз➡
Dialogue: 0,0:05:07.11,0:05:10.61,Default,,0000,0000,0000,,Оны қамауға алу үшін дереу келіңіз.
Dialogue: 0,0:05:07.11,0:05:10.61,Default,,0000,0000,0000,,Оны пайдаланғыңыз келуі мүмкін.
Dialogue: 0,0:05:07.11,0:05:10.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:10.61,0:05:13.58,Default,,0000,0000,0000,,《Шуды оят
Dialogue: 0,0:05:10.61,0:05:13.58,Default,,0000,0000,0000,,Қауіпсіздік ➡ жұқа болғанда
Dialogue: 0,0:05:13.58,0:05:15.62,Default,,0000,0000,0000,,Басқа қоймаға жасырын кіру》
Dialogue: 0,0:05:15.62,0:05:17.58,Default,,0000,0000,0000,,《Басынан бастап
Dialogue: 0,0:05:15.62,0:05:17.58,Default,,0000,0000,0000,,Мақсат қойыңыз➡
Dialogue: 0,0:05:17.58,0:05:21.65,Default,,0000,0000,0000,,Сот әйелі қоймашы болады
Dialogue: 0,0:05:17.58,0:05:21.65,Default,,0000,0000,0000,,Егер мен саған Киссельді берсем...》
Dialogue: 0,0:05:21.65,0:05:24.19,Default,,0000,0000,0000,,Ли Бай мырза
Dialogue: 0,0:05:21.65,0:05:24.19,Default,,0000,0000,0000,,Бұл сот ханымы...
Dialogue: 0,0:05:21.65,0:05:24.19,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:24.19,0:05:26.63,Default,,0000,0000,0000,,О
Dialogue: 0,0:05:24.19,0:05:26.63,Default,,0000,0000,0000,,Тек жағдайда
Dialogue: 0,0:05:24.19,0:05:26.63,Default,,0000,0000,0000,,Мен мәліметтерді сұрадым➡
Dialogue: 0,0:05:26.63,0:05:31.10,Default,,0000,0000,0000,,Мойынды мойныңа ора.
Dialogue: 0,0:05:26.63,0:05:31.10,Default,,0000,0000,0000,,Оның беті жасырылған сияқты.
Dialogue: 0,0:05:26.63,0:05:31.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:31.10,0:05:33.60,Default,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:05:31.10,0:05:33.60,Default,,0000,0000,0000,,Алдын ала бетке қараңыз➡
Dialogue: 0,0:05:33.60,0:05:36.57,Default,,0000,0000,0000,,Мүмкін ол оны жасырған болар.
Dialogue: 0,0:05:33.60,0:05:36.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:33.60,0:05:36.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:33.60,0:05:36.57,Default,,0000,0000,0000,,Ли Бай
Dialogue: 0,0:05:33.60,0:05:36.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:33.60,0:05:36.57,Default,,0000,0000,0000,,О
Dialogue: 0,0:05:33.60,0:05:36.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:36.57,0:05:41.61,Default,,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:05:36.57,0:05:41.61,Default,,0000,0000,0000,,Ол әйел үшін ұзын.
Dialogue: 0,0:05:36.57,0:05:41.61,Default,,0000,0000,0000,,Дәрінің иісі шыққан сияқты.
Dialogue: 0,0:05:36.57,0:05:41.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:41.61,0:05:43.14,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:41.61,0:05:43.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:43.14,0:05:46.71,Default,,0000,0000,0000,,Оның бойын ескере отырып
Dialogue: 0,0:05:43.14,0:05:46.71,Default,,0000,0000,0000,,Бұл сен емессің
Dialogue: 0,0:05:43.14,0:05:46.71,Default,,0000,0000,0000,,Мен білемін, бірақ➡
Dialogue: 0,0:05:46.71,0:05:48.68,Default,,0000,0000,0000,,Сіздің ойыңыз бар ма?
Dialogue: 0,0:05:50.12,0:05:54.69,Default,,0000,0000,0000,,《Дәрі иісі
Dialogue: 0,0:05:50.12,0:05:54.69,Default,,0000,0000,0000,,Ұзын бойлы сот ханымы…》
Dialogue: 0,0:05:54.69,0:05:58.59,Default,,0000,0000,0000,,Луомен
Dialogue: 0,0:05:54.69,0:05:58.59,Default,,0000,0000,0000,,(
Dialogue: 0,0:05:54.69,0:05:58.59,Default,,0000,0000,0000,,Рамон
Dialogue: 0,0:05:54.69,0:05:58.59,Default,,0000,0000,0000,,)
Dialogue: 0,0:05:54.69,0:05:58.59,Default,,0000,0000,0000,,｟Жорамал
Dialogue: 0,0:05:54.69,0:05:58.59,Default,,0000,0000,0000,,Бірдеңе айтпа｠
Dialogue: 0,0:05:58.59,0:06:01.59,Default,,0000,0000,0000,,Бұрын айтылған апаттар мен оқиғаларға қосымша➡
Dialogue: 0,0:06:01.59,0:06:04.63,Default,,0000,0000,0000,,Жұмбақ нәрсе
Dialogue: 0,0:06:01.59,0:06:04.63,Default,,0000,0000,0000,,Онда емес пе?
Dialogue: 0,0:06:04.63,0:06:08.17,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:06:04.63,0:06:08.17,Default,,0000,0000,0000,,Тіпті егер солай десең де.
Dialogue: 0,0:06:04.63,0:06:08.17,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:08.17,0:06:11.10,Default,,0000,0000,0000,,Егер мен оны зерттесем, мен бірдеңе табамын ба?
Dialogue: 0,0:06:11.10,0:06:13.64,Default,,0000,0000,0000,,Бірдеңе болуы мүмкін
Dialogue: 0,0:06:11.10,0:06:13.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:13.64,0:06:16.14,Default,,0000,0000,0000,,Ештеңе болмауы мүмкін
Dialogue: 0,0:06:13.64,0:06:16.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:16.14,0:06:18.11,Default,,0000,0000,0000,,​​Қайсысы?
Dialogue: 0,0:06:16.14,0:06:18.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:20.58,0:06:24.08,Default,,0000,0000,0000,,Екі сәйкестік
Dialogue: 0,0:06:20.58,0:06:24.08,Default,,0000,0000,0000,,Жиі
Dialogue: 0,0:06:20.58,0:06:24.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:24.08,0:06:27.65,Default,,0000,0000,0000,,Үш қабаттасу болуы мүмкін.
Dialogue: 0,0:06:24.08,0:06:27.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:27.65,0:06:31.19,Default,,0000,0000,0000,,Осындай көптеген сәйкестіктер жиналды➡
Dialogue: 0,0:06:31.19,0:06:34.09,Default,,0000,0000,0000,,Соңында бұл сөзсіз болған кезде➡
Dialogue: 0,0:06:34.09,0:06:37.60,Default,,0000,0000,0000,,Мұнда
Dialogue: 0,0:06:34.09,0:06:37.60,Default,,0000,0000,0000,,Ұзын бойлы сот ханымына
Dialogue: 0,0:06:34.09,0:06:37.60,Default,,0000,0000,0000,,Ұқсас біреу болса➡
Dialogue: 0,0:06:37.60,0:06:39.60,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:06:39.60,0:06:41.10,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:39.60,0:06:41.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:41.10,0:06:44.60,Default,,0000,0000,0000,,Су лалагүлі
Dialogue: 0,0:06:41.10,0:06:44.60,Default,,0000,0000,0000,,《Мұнымен Сүйрей деген сарай әйелі
Dialogue: 0,0:06:41.10,0:06:44.60,Default,,0000,0000,0000,,Ол пайда болған кезде➡
Dialogue: 0,0:06:44.60,0:06:46.61,Default,,0000,0000,0000,,Бұл байланыссыз.
Dialogue: 0,0:06:46.61,0:06:48.61,Default,,0000,0000,0000,,Хахаха...!
Dialogue: 0,0:06:46.61,0:06:48.61,Default,,0000,0000,0000,,Түсіндім!
Dialogue: 0,0:06:48.61,0:06:51.64,Default,,0000,0000,0000,,Сіз сыртқы түріңізге қарамастан ақылдысыз!
Dialogue: 0,0:06:51.64,0:06:53.21,Default,,0000,0000,0000,,Хехе...
Dialogue: 0,0:06:51.64,0:06:53.21,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:53.21,0:06:56.12,Default,,0000,0000,0000,,Ли Бай-сама
Dialogue: 0,0:06:53.21,0:06:56.12,Default,,0000,0000,0000,,Көрінгендей
Dialogue: 0,0:06:53.21,0:06:56.12,Default,,0000,0000,0000,,Өйткені бұл ақымақ күш➡
Dialogue: 0,0:06:56.12,0:06:58.58,Default,,0000,0000,0000,,Кішкене жұмсақ болыңыз.
Dialogue: 0,0:06:56.12,0:06:58.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:58.58,0:07:01.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:58.58,0:07:01.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:58.58,0:07:01.62,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:07:01.62,0:07:04.62,Default,,0000,0000,0000,,Көңілді сияқты...
Dialogue: 0,0:07:01.62,0:07:04.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:04.62,0:07:07.13,Default,,0000,0000,0000,,Көңілді сияқты...
Dialogue: 0,0:07:04.62,0:07:07.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:07.13,0:07:10.13,Default,,0000,0000,0000,,Бұл әсіресе қызық емес.
Dialogue: 0,0:07:07.13,0:07:10.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:10.13,0:07:12.60,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:07:10.13,0:07:12.60,Default,,0000,0000,0000,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:07:10.13,0:07:12.60,Default,,0000,0000,0000,,Қазір!
Dialogue: 0,0:07:16.70,0:07:19.61,Default,,0000,0000,0000,,Бұл әскери офицер кім?
Dialogue: 0,0:07:16.70,0:07:19.61,Default,,0000,0000,0000,,біршама
Dialogue: 0,0:07:16.70,0:07:19.61,Default,,0000,0000,0000,,Олар жақсы араласатын сияқты.
Dialogue: 0,0:07:16.70,0:07:19.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:19.61,0:07:22.61,Default,,0000,0000,0000,,Бұл дәл өткен жолымен бірдей, кішкентай сорлы!
Dialogue: 0,0:07:19.61,0:07:22.61,Default,,0000,0000,0000,,Менде алаңдаушылық бар еді➡
Dialogue: 0,0:07:22.61,0:07:26.61,Default,,0000,0000,0000,,Маған
Dialogue: 0,0:07:22.61,0:07:26.61,Default,,0000,0000,0000,,Сіз жай ғана тыңдауға келген сияқтысыз.
Dialogue: 0,0:07:22.61,0:07:26.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:26.61,0:07:32.12,Default,,0000,0000,0000,,《Бұл оқиға
Dialogue: 0,0:07:26.61,0:07:32.12,Default,,0000,0000,0000,,Сондай-ақ Джинджи мырзаға
Dialogue: 0,0:07:26.61,0:07:32.12,Default,,0000,0000,0000,,Қарым-қатынас жоқ деп айтуға болмайды.
Dialogue: 0,0:07:32.12,0:07:33.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:33.62,0:07:37.09,Default,,0000,0000,0000,,Бұл туралы егжей-тегжейлі айтсам да,
Dialogue: 0,0:07:33.62,0:07:37.09,Default,,0000,0000,0000,,(Норияки Какёин) 500 сингапур доллары.
Dialogue: 0,0:07:39.19,0:07:43.10,Default,,0000,0000,0000,,Біртүрлі
Dialogue: 0,0:07:39.19,0:07:43.10,Default,,0000,0000,0000,,Байланыс болды.
Dialogue: 0,0:07:39.19,0:07:43.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:39.19,0:07:43.10,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:39.19,0:07:43.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:43.10,0:07:47.10,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:07:43.10,0:07:47.10,Default,,0000,0000,0000,,Бізде не бар деп ойлайсыз?
Dialogue: 0,0:07:43.10,0:07:47.10,Default,,0000,0000,0000,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:07:43.10,0:07:47.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:47.10,0:07:51.10,Default,,0000,0000,0000,,Сенімділікпен бір оқиғадан гөрі
Dialogue: 0,0:07:47.10,0:07:51.10,Default,,0000,0000,0000,,біз алғаш рет шетелдік жоғары лауазымды тұлғаны қарсы аламыз…
Dialogue: 0,0:07:47.10,0:07:51.10,Default,,0000,0000,0000,,Кейбір тұзақтарды орнатыңыз➡
Dialogue: 0,0:07:51.10,0:07:55.11,Default,,0000,0000,0000,,Біреуі сәтті болса жеткілікті.
Dialogue: 0,0:07:51.10,0:07:55.11,Default,,0000,0000,0000,,Ол да ұқсайды
Dialogue: 0,0:07:51.10,0:07:55.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:55.11,0:07:59.11,Default,,0000,0000,0000,,Одан кейін басқалары бар
Dialogue: 0,0:07:55.11,0:07:59.11,Default,,0000,0000,0000,,Оны орнату мүмкіндігі бар.
Dialogue: 0,0:07:55.11,0:07:59.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:59.11,0:08:01.68,Default,,0000,0000,0000,,Мен нақты айта алмаймын, бірақ➡
Dialogue: 0,0:08:01.68,0:08:06.25,Default,,0000,0000,0000,,Олардың барлығы оқиғалар ма, әлде апаттар ма?
Dialogue: 0,0:08:01.68,0:08:06.25,Default,,0000,0000,0000,,Шешім қабылдауға болмайтын жағдайлар көп.
Dialogue: 0,0:08:01.68,0:08:06.25,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:06.25,0:08:10.76,Default,,0000,0000,0000,,Бұл жай ғана кездейсоқтық
Dialogue: 0,0:08:06.25,0:08:10.76,Default,,0000,0000,0000,,Біз бұл мүмкіндікті жоққа шығара алмаймыз
Dialogue: 0,0:08:06.25,0:08:10.76,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:13.09,0:08:15.60,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:13.09,0:08:15.60,Default,,0000,0000,0000,,Сіз құлықсыз ба?
Dialogue: 0,0:08:15.60,0:08:17.60,Default,,0000,0000,0000,,Ынтасыз ба?
Dialogue: 0,0:08:17.60,0:08:20.10,Default,,0000,0000,0000,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:08:17.60,0:08:20.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:20.10,0:08:24.60,Default,,0000,0000,0000,,Мен жай ғана қызметші қызбын.
Dialogue: 0,0:08:20.10,0:08:24.60,Default,,0000,0000,0000,,Сізге айтылған жұмысты орындаңыз.
Dialogue: 0,0:08:20.10,0:08:24.60,Default,,0000,0000,0000,,. [жиырма екі] .
Dialogue: 0,0:08:24.60,0:08:27.11,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:08:24.60,0:08:27.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:27.11,0:08:31.21,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:27.11,0:08:31.21,Default,,0000,0000,0000,,Егер
Dialogue: 0,0:08:27.11,0:08:31.21,Default,,0000,0000,0000,,Coil, біз не істеп жатқанымызды соншалықты терең зерттеген… Ақыры ол қабілетті ғой
Dialogue: 0,0:08:31.21,0:08:35.11,Default,,0000,0000,0000,,Капипа
Dialogue: 0,0:08:31.21,0:08:35.11,Default,,0000,0000,0000,,Трейдерге барған кезде➡
Dialogue: 0,0:08:35.11,0:08:38.12,Default,,0000,0000,0000,,Бір қызық нәрсе шығып жатыр деп естідім.
Dialogue: 0,0:08:35.11,0:08:38.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:40.09,0:08:42.62,Default,,0000,0000,0000,,Ол осылай аталды.
Dialogue: 0,0:08:40.09,0:08:42.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:42.62,0:08:43.59,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:08:43.59,0:08:46.09,Default,,0000,0000,0000,,Гу
Dialogue: 0,0:08:43.59,0:08:46.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:08:43.59,0:08:46.09,Default,,0000,0000,0000,,Біраз жылдам сөйлеңіз
Dialogue: 0,0:08:43.59,0:08:46.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:08:43.59,0:08:46.09,Default,,0000,0000,0000,,《Сиыр етінің сарысы дегеніміз не?
Dialogue: 0,0:08:43.59,0:08:46.09,Default,,0000,0000,0000,,Дәрінің бір түрі.
Dialogue: 0,0:08:43.59,0:08:46.09,Default,,0000,0000,0000,,Сиырдың өт тастары》
Dialogue: 0,0:08:46.09,0:08:50.13,Default,,0000,0000,0000,,《1000-нан біреуі ғана
Dialogue: 0,0:08:46.09,0:08:50.13,Default,,0000,0000,0000,,Сирек кездесетін ең жоғары сапалы дәрі! 》
Dialogue: 0,0:08:50.13,0:08:53.20,Default,,0000,0000,0000,,Жер
Dialogue: 0,0:08:50.13,0:08:53.20,Default,,0000,0000,0000,,Оны маған бересің бе?
Dialogue: 0,0:08:53.20,0:08:55.60,Default,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:08:53.20,0:08:55.60,Default,,0000,0000,0000,,Бұл өтірік емес, солай ма?
Dialogue: 0,0:08:55.60,0:08:58.10,Default,,0000,0000,0000,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:08:55.60,0:08:58.10,Default,,0000,0000,0000,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:08:55.60,0:08:58.10,Default,,0000,0000,0000,,А...
Dialogue: 0,0:08:55.60,0:08:58.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:58.10,0:09:00.11,Default,,0000,0000,0000,,Бұл сізге керек пе?
Dialogue: 0,0:08:58.10,0:09:00.11,Default,,0000,0000,0000,,Маған керек!!
Dialogue: 0,0:09:00.11,0:09:02.11,Default,,0000,0000,0000,,Сяомао
Dialogue: 0,0:09:00.11,0:09:02.11,Default,,0000,0000,0000,,Конеко
Dialogue: 0,0:09:00.11,0:09:02.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:02.11,0:09:03.61,Default,,0000,0000,0000,,Ха…
Dialogue: 0,0:09:02.11,0:09:03.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:08.65,0:09:10.65,Default,,0000,0000,0000,,Уф! Босат! Мені босат!
Dialogue: 0,0:09:08.65,0:09:10.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:10.65,0:09:12.69,Default,,0000,0000,0000,,​​Мотивацияланған сияқтысыз.
Dialogue: 0,0:09:10.65,0:09:12.69,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:12.69,0:09:15.09,Default,,0000,0000,0000,,Мен оны шынымен ала аламын ба?
Dialogue: 0,0:09:15.09,0:09:18.09,Default,,0000,0000,0000,,Бұл жұмысқа байланысты.
Dialogue: 0,0:09:15.09,0:09:18.09,Default,,0000,0000,0000,,Ақпаратты бір-бірлеп қарастырайық.
Dialogue: 0,0:09:15.09,0:09:18.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:18.09,0:09:20.59,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:09:18.09,0:09:20.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:20.59,0:09:23.10,Default,,0000,0000,0000,,Джинджи мырзаның қалауы бойынша!
Dialogue: 0,0:09:23.10,0:09:26.63,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:09:23.10,0:09:26.63,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:09:23.10,0:09:26.63,Default,,0000,0000,0000,,Шарттарды сұраңыз
Dialogue: 0,0:09:23.10,0:09:26.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:26.63,0:09:29.10,Default,,0000,0000,0000,,Хмф
Dialogue: 0,0:09:26.63,0:09:29.10,Default,,0000,0000,0000,,Фу~фу...
Dialogue: 0,0:09:26.63,0:09:29.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:26.63,0:09:29.10,Default,,0000,0000,0000,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:09:26.63,0:09:29.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:31.04,0:09:33.54,Default,,0000,0000,0000,,《Бұл өткен күні болды》
Dialogue: 0,0:09:33.54,0:09:37.58,Default,,0000,0000,0000,,《Тамақтан уланған үкімет қызметкері
Dialogue: 0,0:09:33.54,0:09:37.58,Default,,0000,0000,0000,,Ол Рейбу мектебінің мүшесі болды ма?
Dialogue: 0,0:09:37.58,0:09:39.05,Default,,0000,0000,0000,,《Рейбу дегеніміз не?
Dialogue: 0,0:09:37.58,0:09:39.05,Default,,0000,0000,0000,,Мен сенімдімін➡
Dialogue: 0,0:09:39.05,0:09:43.55,Default,,0000,0000,0000,,Білім және дипломатияға жауапты
Dialogue: 0,0:09:39.05,0:09:43.55,Default,,0000,0000,0000,,Бұл бөлім болуы керек еді...》
Dialogue: 0,0:09:45.05,0:09:48.59,Default,,0000,0000,0000,,《Ресми және әйелдер емтихандарына оқу.
Dialogue: 0,0:09:45.05,0:09:48.59,Default,,0000,0000,0000,,Егер сіз байсалды болсаңыз...》
Dialogue: 0,0:09:48.59,0:09:51.12,Default,,0000,0000,0000,,(
Dialogue: 0,0:09:48.59,0:09:51.12,Default,,0000,0000,0000,,Азаматтық
Dialogue: 0,0:09:48.59,0:09:51.12,Default,,0000,0000,0000,,)
Dialogue: 0,0:09:48.59,0:09:51.12,Default,,0000,0000,0000,,Мен оны осында қалдырамын.
Dialogue: 0,0:09:48.59,0:09:51.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:51.12,0:09:53.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:51.12,0:09:53.66,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:09:51.12,0:09:53.66,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:53.66,0:09:58.06,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:09:53.66,0:09:58.06,Default,,0000,0000,0000,,Егер сіз бірдеңені түсінбесеңіз
Dialogue: 0,0:09:53.66,0:09:58.06,Default,,0000,0000,0000,,Менен кез келген уақытта сұраңыз
Dialogue: 0,0:09:53.66,0:09:58.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:58.06,0:10:00.57,Default,,0000,0000,0000,,Бұл
Dialogue: 0,0:09:58.06,0:10:00.57,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:09:58.06,0:10:00.57,Default,,0000,0000,0000,,Сіз қандай мемлекеттік қызметтесіз?
Dialogue: 0,0:10:00.57,0:10:05.54,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:00.57,0:10:05.54,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:10:00.57,0:10:05.54,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:10:00.57,0:10:05.54,Default,,0000,0000,0000,,Ол мерекелерге жауапты.
Dialogue: 0,0:10:00.57,0:10:05.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:05.54,0:10:08.04,Default,,0000,0000,0000,,Бұл мереке ме?
Dialogue: 0,0:10:05.54,0:10:08.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:09.54,0:10:11.04,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:09.54,0:10:11.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:11.04,0:10:13.08,Default,,0000,0000,0000,,Сізде жазатын нәрсе бар ма?
Dialogue: 0,0:10:13.08,0:10:15.11,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:10:13.08,0:10:15.11,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:13.08,0:10:15.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:15.11,0:10:18.05,Default,,0000,0000,0000,,Фестиваль
Dialogue: 0,0:10:15.11,0:10:18.05,Default,,0000,0000,0000,,Фестивальдар…
Dialogue: 0,0:10:15.11,0:10:18.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:18.05,0:10:22.56,Default,,0000,0000,0000,,《Тамақтан уланған шенеуніктер де
Dialogue: 0,0:10:18.05,0:10:22.56,Default,,0000,0000,0000,,Құран-сама да
Dialogue: 0,0:10:18.05,0:10:22.56,Default,,0000,0000,0000,,Ол мерекелерге қатысқан мемлекеттік қызметкер болды.
Dialogue: 0,0:10:22.56,0:10:25.06,Default,,0000,0000,0000,,《Және
Dialogue: 0,0:10:22.56,0:10:25.06,Default,,0000,0000,0000,,Сол сүйіспеншілік➡
Dialogue: 0,0:10:25.06,0:10:28.56,Default,,0000,0000,0000,,Салттық ыдыстарды сенімдірек пайдаланыңыз
Dialogue: 0,0:10:25.06,0:10:28.56,Default,,0000,0000,0000,,Егер ұрлық үшін болса➡
Dialogue: 0,0:10:28.56,0:10:32.06,Default,,0000,0000,0000,,Кездейсоқ көріну үшін жасалған
Dialogue: 0,0:10:28.56,0:10:32.06,Default,,0000,0000,0000,,Бұл оқиғалар бір-біріне сәйкес келеді➡
Dialogue: 0,0:10:32.06,0:10:35.10,Default,,0000,0000,0000,,Еріксіз жағдай орын алатын орын болуы керек.
Dialogue: 0,0:10:35.10,0:10:39.04,Default,,0000,0000,0000,,《Мен оны ұрлау үшін көп күш жұмсадым.
Dialogue: 0,0:10:35.10,0:10:39.04,Default,,0000,0000,0000,,Салттық ыдыстар қолданылса➡
Dialogue: 0,0:10:39.04,0:10:42.54,Default,,0000,0000,0000,,Тіпті фестивальдарда
Dialogue: 0,0:10:39.04,0:10:42.54,Default,,0000,0000,0000,,Сәйкес масштаб...》
Dialogue: 0,0:10:42.54,0:10:44.54,Default,,0000,0000,0000,,《Ортадағы ғибадатханадан да биік шығар》
Dialogue: 0,0:10:44.54,0:10:49.05,Default,,0000,0000,0000,,《Ол қашан өтеді?
Dialogue: 0,0:10:44.54,0:10:49.05,Default,,0000,0000,0000,,Барлығын тексеру керек.》
Dialogue: 0,0:10:49.05,0:10:53.05,Default,,0000,0000,0000,,《Айтпақшы, Джиндзи-сама да.
Dialogue: 0,0:10:49.05,0:10:53.05,Default,,0000,0000,0000,,Мисо
Dialogue: 0,0:10:49.05,0:10:53.05,Default,,0000,0000,0000,,Мен өзімді тазартатынмын...》
Dialogue: 0,0:10:53.05,0:10:55.09,Default,,0000,0000,0000,,Фестивальдерге қызығушылық танытсаңыз➡
Dialogue: 0,0:10:55.09,0:10:57.56,Default,,0000,0000,0000,,Мұнда
Dialogue: 0,0:10:55.09,0:10:57.56,Default,,0000,0000,0000,,Мұнда жақсы нәрсе бар.
Dialogue: 0,0:10:55.09,0:10:57.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:01.06,0:11:04.06,Default,,0000,0000,0000,,Бұл фестиваль залының суреті ме?
Dialogue: 0,0:11:04.06,0:11:08.53,Default,,0000,0000,0000,,Ұрыс
Dialogue: 0,0:11:04.06,0:11:08.53,Default,,0000,0000,0000,,О
Dialogue: 0,0:11:04.06,0:11:08.53,Default,,0000,0000,0000,,Сыртқы ауланың батыс жағында.
Dialogue: 0,0:11:04.06,0:11:08.53,Default,,0000,0000,0000,,Сокюдан
Dialogue: 0,0:11:04.06,0:11:08.53,Default,,0000,0000,0000,,Сокюдан➡ деп аталады
Dialogue: 0,0:11:08.53,0:11:12.04,Default,,0000,0000,0000,,Бұл өте ерекше құрылым, солай емес пе?
Dialogue: 0,0:11:12.04,0:11:16.08,Default,,0000,0000,0000,,Төбедегі үлкен тіректер
Dialogue: 0,0:11:12.04,0:11:16.08,Default,,0000,0000,0000,,Ол ілулі.
Dialogue: 0,0:11:12.04,0:11:16.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:16.08,0:11:20.65,Default,,0000,0000,0000,,Орталық құрбандық үстелінің үстінде
Dialogue: 0,0:11:16.08,0:11:20.65,Default,,0000,0000,0000,,Қанаттар салбырап тұр➡
Dialogue: 0,0:11:20.65,0:11:25.55,Default,,0000,0000,0000,,Әр жолы
Dialogue: 0,0:11:20.65,0:11:25.55,Default,,0000,0000,0000,,Бағананы төмендетіңіз
Dialogue: 0,0:11:20.65,0:11:25.55,Default,,0000,0000,0000,,Құттықтау сөздерді қосыңыз
Dialogue: 0,0:11:20.65,0:11:25.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:25.55,0:11:27.55,Default,,0000,0000,0000,,Сонда сіз көп нәрсені білесіз бе?
Dialogue: 0,0:11:25.55,0:11:27.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:27.55,0:11:31.06,Default,,0000,0000,0000,,О
Dialogue: 0,0:11:27.55,0:11:31.06,Default,,0000,0000,0000,,Ұят
Dialogue: 0,0:11:27.55,0:11:31.06,Default,,0000,0000,0000,,Мұрағатқа келмес бұрын ➡
Dialogue: 0,0:11:31.06,0:11:34.06,Default,,0000,0000,0000,,Рейбуда
Dialogue: 0,0:11:31.06,0:11:34.06,Default,,0000,0000,0000,,Қосымша
Dialogue: 0,0:11:31.06,0:11:34.06,Default,,0000,0000,0000,,Оның лайықты жұмысы болды.
Dialogue: 0,0:11:31.06,0:11:34.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:34.06,0:11:38.56,Default,,0000,0000,0000,,Жоғарыда қажетсіз нәрсе айтсаңыз
Dialogue: 0,0:11:34.06,0:11:38.56,Default,,0000,0000,0000,,Мен мұнда таң қалдым.
Dialogue: 0,0:11:34.06,0:11:38.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:38.56,0:11:40.03,Default,,0000,0000,0000,,Тағы бір… үкі ме?
Dialogue: 0,0:11:38.56,0:11:40.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:40.03,0:11:45.14,Default,,0000,0000,0000,,Алдымен
Dialogue: 0,0:11:40.03,0:11:45.14,Default,,0000,0000,0000,,Мен күшке алаңдадым.
Dialogue: 0,0:11:40.03,0:11:45.14,Default,,0000,0000,0000,,Ешқандай проблема жоқ сияқты болып, көңілім жайланды.
Dialogue: 0,0:11:40.03,0:11:45.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:45.14,0:11:47.17,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:11:47.17,0:11:50.54,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:47.17,0:11:50.54,Default,,0000,0000,0000,,Азаматтық дауыс
Dialogue: 0,0:11:47.17,0:11:50.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:47.17,0:11:50.54,Default,,0000,0000,0000,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:11:47.17,0:11:50.54,Default,,0000,0000,0000,,Төбеден тіректерді іліп қоясыз.
Dialogue: 0,0:11:47.17,0:11:50.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:50.54,0:11:55.55,Default,,0000,0000,0000,,Өйткені бұл үлкен нәрсе
Dialogue: 0,0:11:50.54,0:11:55.55,Default,,0000,0000,0000,,Мен құлап қалсам деп уайымдаймын➡
Dialogue: 0,0:11:55.55,0:11:57.55,Default,,0000,0000,0000,,Күшке қатысты ұсыныс жасағыңыз келсе➡
Dialogue: 0,0:11:57.55,0:12:01.55,Default,,0000,0000,0000,,Осындай жерде
Dialogue: 0,0:11:57.55,0:12:01.55,Default,,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:11:57.55,0:12:01.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:01.55,0:12:04.56,Default,,0000,0000,0000,,《Бұл әрине қорқынышты оқиға》
Dialogue: 0,0:12:04.56,0:12:07.59,Default,,0000,0000,0000,,《Егер
Dialogue: 0,0:12:04.56,0:12:07.59,Default,,0000,0000,0000,,Бағананы бекітетін металл фитингтер сынған➡
Dialogue: 0,0:12:07.59,0:12:11.66,Default,,0000,0000,0000,,Төбеден бағана құласа...》
Dialogue: 0,0:12:11.66,0:12:16.07,Default,,0000,0000,0000,,《Ең қауіптісі
Dialogue: 0,0:12:11.66,0:12:16.07,Default,,0000,0000,0000,,Тікелей төменде рәсімді орындайтын адам.
Dialogue: 0,0:12:16.07,0:12:20.57,Default,,0000,0000,0000,,《Ештеңе істемейтіндер құрбандыққа шалынады》
Dialogue: 0,0:12:20.57,0:12:23.58,Default,,0000,0000,0000,,Күш мәселесі…
Dialogue: 0,0:12:20.57,0:12:23.58,Default,,0000,0000,0000,,Күш…
Dialogue: 0,0:12:20.57,0:12:23.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:23.58,0:12:27.58,Default,,0000,0000,0000,,《Алайда
Dialogue: 0,0:12:23.58,0:12:27.58,Default,,0000,0000,0000,,Мәңгілік шың тек менікі
Dialogue: 0,0:12:23.58,0:12:27.58,Default,,0000,0000,0000,,Қандай ғұрыптық құралдар ұрланды? 》
Dialogue: 0,0:12:27.58,0:12:33.12,Default,,0000,0000,0000,,«Егер мұндай маңызды ғұрыптық құрал жоғалып кетсе,
Dialogue: 0,0:12:27.58,0:12:33.12,Default,,0000,0000,0000,,Мен оны міндетті түрде қайта жасауым керек...》
Dialogue: 0,0:12:33.12,0:12:35.65,Default,,0000,0000,0000,,《Қайта жасау…》
Dialogue: 0,0:12:35.65,0:12:37.19,Default,,0000,0000,0000,,Ха…
Dialogue: 0,0:12:35.65,0:12:37.19,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:37.19,0:12:41.09,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:12:37.19,0:12:41.09,Default,,0000,0000,0000,,Келесі фестиваль осы жерде өтеді.
Dialogue: 0,0:12:37.19,0:12:41.09,Default,,0000,0000,0000,,Істелген нәрсе
Dialogue: 0,0:12:37.19,0:12:41.09,Default,,0000,0000,0000,,Қашан?
Dialogue: 0,0:12:41.09,0:12:42.56,Default,,0000,0000,0000,,Қашан...
Dialogue: 0,0:12:41.09,0:12:42.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:42.56,0:12:45.56,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:12:42.56,0:12:45.56,Default,,0000,0000,0000,,Дәл бүгін.
Dialogue: 0,0:12:42.56,0:12:45.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:47.07,0:12:50.57,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:12:47.07,0:12:50.57,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:12:47.07,0:12:50.57,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:12:47.07,0:12:50.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:52.07,0:12:54.11,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:12:52.07,0:12:54.11,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:12:52.07,0:12:54.11,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:12:52.07,0:12:54.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:54.11,0:12:56.14,Default,,0000,0000,0000,,《Егер болжам дұрыс болса➡
Dialogue: 0,0:12:56.14,0:12:59.61,Default,,0000,0000,0000,,Бұл ұзақ уақытқа созылды
Dialogue: 0,0:12:56.14,0:12:59.61,Default,,0000,0000,0000,,Бұл жақсы ойластырылған жоспар болуы керек》
Dialogue: 0,0:13:01.05,0:13:03.58,Default,,0000,0000,0000,,《Бәрі де анық
Dialogue: 0,0:13:01.05,0:13:03.58,Default,,0000,0000,0000,,Жоқ》
Dialogue: 0,0:13:03.58,0:13:07.05,Default,,0000,0000,0000,,《Бірақ
Dialogue: 0,0:13:03.58,0:13:07.05,Default,,0000,0000,0000,,Көптеген орнату арқылы
Dialogue: 0,0:13:03.58,0:13:07.05,Default,,0000,0000,0000,,Кейбір қабаттасады》
Dialogue: 0,0:13:07.05,0:13:10.06,Default,,0000,0000,0000,,《Және
Dialogue: 0,0:13:07.05,0:13:10.06,Default,,0000,0000,0000,,Соңында
Dialogue: 0,0:13:07.05,0:13:10.06,Default,,0000,0000,0000,,Осы уақытқа дейін қосылған》
Dialogue: 0,0:13:12.59,0:13:14.06,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:13:12.59,0:13:14.06,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:13:12.59,0:13:14.06,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:13:12.59,0:13:14.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:14.06,0:13:17.10,Default,,0000,0000,0000,,《Бұл жай ғана болжам.
Dialogue: 0,0:13:14.06,0:13:17.10,Default,,0000,0000,0000,,Бұл жай ғана болжам》
Dialogue: 0,0:13:17.10,0:13:21.17,Default,,0000,0000,0000,,《Бірақ
Dialogue: 0,0:13:17.10,0:13:21.17,Default,,0000,0000,0000,,Егер
Dialogue: 0,0:13:17.10,0:13:21.17,Default,,0000,0000,0000,,Бұл болжам
Dialogue: 0,0:13:17.10,0:13:21.17,Default,,0000,0000,0000,,Егер сіз дұрыс болсаңыз...》
Dialogue: 0,0:13:21.17,0:13:23.57,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:13:21.17,0:13:23.57,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:13:21.17,0:13:23.57,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:13:21.17,0:13:23.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:23.57,0:13:25.04,Default,,0000,0000,0000,,Онда!
Dialogue: 0,0:13:29.54,0:13:32.58,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:13:29.54,0:13:32.58,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:13:29.54,0:13:32.58,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:13:29.54,0:13:32.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:32.58,0:13:34.05,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:13:34.05,0:13:36.55,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:34.05,0:13:36.55,Default,,0000,0000,0000,,Тіркеме 1
Dialogue: 0,0:13:34.05,0:13:36.55,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:34.05,0:13:36.55,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:13:34.05,0:13:36.55,Default,,0000,0000,0000,,Алып тасташы, өтінемін...?
Dialogue: 0,0:13:34.05,0:13:36.55,Default,,0000,0000,0000,,Ұшып кет…
Dialogue: 0,0:13:36.55,0:13:39.12,Default,,0000,0000,0000,,Чи…
Dialogue: 0,0:13:36.55,0:13:39.12,Default,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:13:36.55,0:13:39.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:39.12,0:13:41.65,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:13:39.12,0:13:41.65,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:39.12,0:13:41.65,Default,,0000,0000,0000,,Бұл төтенше жағдай!
Dialogue: 0,0:13:41.65,0:13:47.03,Default,,0000,0000,0000,,Сен сияқты қызметші қыз
Dialogue: 0,0:13:41.65,0:13:47.03,Default,,0000,0000,0000,,Фестивальге араласуды жоспарлап отырсыз ба?
Dialogue: 0,0:13:47.03,0:13:48.56,Default,,0000,0000,0000,,《Мағынасы бар》
Dialogue: 0,0:13:48.56,0:13:52.06,Default,,0000,0000,0000,,《Бұл
Dialogue: 0,0:13:48.56,0:13:52.06,Default,,0000,0000,0000,,Жай ғана қызметші қыз
Dialogue: 0,0:13:48.56,0:13:52.06,Default,,0000,0000,0000,,Күш жоқ》
Dialogue: 0,0:13:52.06,0:13:55.57,Default,,0000,0000,0000,,《Бірақ
Dialogue: 0,0:13:52.06,0:13:55.57,Default,,0000,0000,0000,,Бірдеңе болған соң тым кеш》
Dialogue: 0,0:13:55.57,0:13:59.57,Default,,0000,0000,0000,,«Қайтаруға болмайтын нәрсе
Dialogue: 0,0:13:55.57,0:13:59.57,Default,,0000,0000,0000,,Әрқашан
Dialogue: 0,0:13:55.57,0:13:59.57,Default,,0000,0000,0000,,Дұрыс》
Dialogue: 0,0:13:59.57,0:14:03.61,Default,,0000,0000,0000,,Өмірге қауіп төніп тұр
Dialogue: 0,0:13:59.57,0:14:03.61,Default,,0000,0000,0000,,Фестивальді тоқтатыңыз.
Dialogue: 0,0:13:59.57,0:14:03.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:03.61,0:14:07.15,Default,,0000,0000,0000,,Шешім өзіңізге байланысты
Dialogue: 0,0:14:03.61,0:14:07.15,Default,,0000,0000,0000,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:14:03.61,0:14:07.15,Default,,0000,0000,0000,,Айтар бірдеңе болса➡
Dialogue: 0,0:14:07.15,0:14:10.58,Default,,0000,0000,0000,,Фуми
Dialogue: 0,0:14:07.15,0:14:10.58,Default,,0000,0000,0000,,Хабарды ұсыныс жолағына қоюдан
Dialogue: 0,0:14:07.15,0:14:10.58,Default,,0000,0000,0000,,бастайық
Dialogue: 0,0:14:07.15,0:14:10.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:10.58,0:14:13.55,Default,,0000,0000,0000,,Бұл мүмкін емес!
Dialogue: 0,0:14:10.58,0:14:13.55,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:14:13.55,0:14:17.59,Default,,0000,0000,0000,,Сол құрбандық үстелінде
Dialogue: 0,0:14:13.55,0:14:17.59,Default,,0000,0000,0000,,Қауіпті ақау табылды
Dialogue: 0,0:14:13.55,0:14:17.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:17.59,0:14:20.59,Default,,0000,0000,0000,,Оны біреу құрастырған болуы мүмкін.
Dialogue: 0,0:14:17.59,0:14:20.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:20.59,0:14:25.06,Default,,0000,0000,0000,,Егер мені осында кіргізбесең
Dialogue: 0,0:14:20.59,0:14:25.06,Default,,0000,0000,0000,,Сіз өкінесіз.
Dialogue: 0,0:14:20.59,0:14:25.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:25.06,0:14:28.13,Default,,0000,0000,0000,,Дегенмен, не болып жатқанын түсінбеймін.
Dialogue: 0,0:14:25.06,0:14:28.13,Default,,0000,0000,0000,,Мен қауіпті уағыздасам да➡
Dialogue: 0,0:14:28.13,0:14:30.64,Default,,0000,0000,0000,,Егер бас тартсаңыз...
Dialogue: 0,0:14:28.13,0:14:30.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:30.64,0:14:34.04,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:14:30.64,0:14:34.04,Default,,0000,0000,0000,,Жер
Dialogue: 0,0:14:30.64,0:14:34.04,Default,,0000,0000,0000,,Осыны айтып тұрсың ба?
Dialogue: 0,0:14:30.64,0:14:34.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:34.04,0:14:37.54,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:14:34.04,0:14:37.54,Default,,0000,0000,0000,,Сіз мені алаңдатасыз➡
Dialogue: 0,0:14:37.54,0:14:40.55,Default,,0000,0000,0000,,Не болып жатқанын қараңыз
Dialogue: 0,0:14:37.54,0:14:40.55,Default,,0000,0000,0000,,Сіз күтіп отырсыз, солай емес пе?
Dialogue: 0,0:14:37.54,0:14:40.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:40.55,0:14:45.55,Default,,0000,0000,0000,,Егер оларға жұлын сұйықтығы енгізілген болса,
Dialogue: 0,0:14:40.55,0:14:45.55,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,0:14:40.55,0:14:45.55,Default,,0000,0000,0000,,Жұмысты орындаған адаммен
Dialogue: 0,0:14:40.55,0:14:45.55,Default,,0000,0000,0000,,Ол қосылған ба...
Dialogue: 0,0:14:40.55,0:14:45.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:45.55,0:14:47.52,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:45.55,0:14:47.52,Default,,0000,0000,0000,,Соққы дыбысы
Dialogue: 0,0:14:45.55,0:14:47.52,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:49.56,0:14:52.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:49.56,0:14:52.09,Default,,0000,0000,0000,,Доёмеки
Dialogue: 0,0:14:49.56,0:14:52.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:52.09,0:14:56.56,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:52.09,0:14:56.56,Default,,0000,0000,0000,,Тіркеме 1
Dialogue: 0,0:14:52.09,0:14:56.56,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:52.09,0:14:56.56,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:14:52.09,0:14:56.56,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:14:52.09,0:14:56.56,Default,,0000,0000,0000,,Ха...!
Dialogue: 0,0:14:56.56,0:15:03.04,Default,,0000,0000,0000,,Менің құлағымда шу бар, ешбір дыбыс естілмейді.
Dialogue: 0,0:14:56.56,0:15:03.04,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:56.56,0:15:03.04,Default,,0000,0000,0000,,А...
Dialogue: 0,0:14:56.56,0:15:03.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:03.04,0:15:06.04,Default,,0000,0000,0000,,《Мен есінен танып қалатын сияқтымын...》
Dialogue: 0,0:15:06.04,0:15:09.04,Default,,0000,0000,0000,,《Осындай кішкентай қызға
Dialogue: 0,0:15:06.04,0:15:09.04,Default,,0000,0000,0000,,Егер сіз осындай нәрсені айтсаңыз➡
Dialogue: 0,0:15:09.04,0:15:11.08,Default,,0000,0000,0000,,Сіз ашуланасыз》
Dialogue: 0,0:15:11.08,0:15:15.15,Default,,0000,0000,0000,,《Мақсат бойынша
Dialogue: 0,0:15:11.08,0:15:15.15,Default,,0000,0000,0000,,Себебі мен сені осылай істеуге мәжбүр еттім.
Dialogue: 0,0:15:11.08,0:15:15.15,Default,,0000,0000,0000,,Мен көмектесе алмаймын…》
Dialogue: 0,0:15:15.15,0:15:17.58,Default,,0000,0000,0000,,《Әбігерге салу дұрыс па...》
Dialogue: 0,0:15:17.58,0:15:22.59,Default,,0000,0000,0000,,《Осындай шағын әбігерде
Dialogue: 0,0:15:17.58,0:15:22.59,Default,,0000,0000,0000,,Фестиваль ешқашан тоқтамайды》
Dialogue: 0,0:15:22.59,0:15:26.59,Default,,0000,0000,0000,,《Ешқандай маңызды емес...
Dialogue: 0,0:15:22.59,0:15:26.59,Default,,0000,0000,0000,,Мен әлі есінен танып қала алмаймын.
Dialogue: 0,0:15:26.59,0:15:28.06,Default,,0000,0000,0000,,Хмм…
Dialogue: 0,0:15:26.59,0:15:28.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:30.10,0:15:32.56,Default,,0000,0000,0000,,Сіз дайынсыз ба?
Dialogue: 0,0:15:34.60,0:15:37.07,Default,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:15:34.60,0:15:37.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:39.17,0:15:44.08,Default,,0000,0000,0000,,Ішінде
Dialogue: 0,0:15:39.17,0:15:44.08,Default,,0000,0000,0000,,Бұзықсыз болған жақсы
Dialogue: 0,0:15:39.17,0:15:44.08,Default,,0000,0000,0000,,Сіз сондасыз ба?
Dialogue: 0,0:15:44.08,0:15:48.58,Default,,0000,0000,0000,,Бірдеңе болып қалса, ол ұшады...
Dialogue: 0,0:15:44.08,0:15:48.58,Default,,0000,0000,0000,,Бұл сенің мойның емес пе?
Dialogue: 0,0:15:44.08,0:15:48.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:48.58,0:15:52.05,Default,,0000,0000,0000,,Мен сенен мерекені үзуіңді сұрамаймын.
Dialogue: 0,0:15:48.58,0:15:52.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:52.05,0:15:55.55,Default,,0000,0000,0000,,Өйткені ол
Dialogue: 0,0:15:52.05,0:15:55.55,Default,,0000,0000,0000,,Өтінемін, өтінемін
Dialogue: 0,0:15:52.05,0:15:55.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:55.55,0:15:59.06,Default,,0000,0000,0000,,Уа! Ах, ах, ах! (Цубаки) Хмм!—
Dialogue: 0,0:15:55.55,0:15:59.06,Default,,0000,0000,0000,,Ішінде егеуқұйрық бар делік.
Dialogue: 0,0:15:55.55,0:15:59.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:59.06,0:16:03.63,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:15:59.06,0:16:03.63,Default,,0000,0000,0000,,Ұшатын
Dialogue: 0,0:15:59.06,0:16:03.63,Default,,0000,0000,0000,,Менің мойным ғана жасайды!
Dialogue: 0,0:16:03.63,0:16:07.57,Default,,0000,0000,0000,,Сен сияқты кішкентай қыздың сөзі
Dialogue: 0,0:16:03.63,0:16:07.57,Default,,0000,0000,0000,,Маған сенуімді айтып тұрсың ба?
Dialogue: 0,0:16:07.57,0:16:11.07,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:16:07.57,0:16:11.07,Default,,0000,0000,0000,,Менің сөздерім бойынша
Dialogue: 0,0:16:07.57,0:16:11.07,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:16:11.07,0:16:12.54,Default,,0000,0000,0000,,Ха…
Dialogue: 0,0:16:11.07,0:16:12.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:12.54,0:16:17.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:12.54,0:16:17.58,Default,,0000,0000,0000,,Аяқ дыбыстары
Dialogue: 0,0:16:12.54,0:16:17.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:17.58,0:16:20.55,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:17.58,0:16:20.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:17.58,0:16:20.55,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:17.58,0:16:20.55,Default,,0000,0000,0000,,Сіз...
Dialogue: 0,0:16:17.58,0:16:20.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:23.55,0:16:27.15,Default,,0000,0000,0000,,Лакан
Dialogue: 0,0:16:23.55,0:16:27.15,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:23.55,0:16:27.15,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:16:23.55,0:16:27.15,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:23.55,0:16:27.15,Default,,0000,0000,0000,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:16:23.55,0:16:27.15,Default,,0000,0000,0000,,Жас қызды ұру➡
Dialogue: 0,0:16:27.15,0:16:30.56,Default,,0000,0000,0000,,Бұл нені білдіреді деп ойлаймын.
Dialogue: 0,0:16:27.15,0:16:30.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:30.56,0:16:33.56,Default,,0000,0000,0000,,Сіз жарақат алдыңыз, солай емес пе?
Dialogue: 0,0:16:30.56,0:16:33.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:33.56,0:16:36.06,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:16:33.56,0:16:36.06,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:16:33.56,0:16:36.06,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:16:33.56,0:16:36.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:36.06,0:16:39.06,Default,,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,0:16:36.06,0:16:39.06,Default,,0000,0000,0000,,Қыздың айтқанын орындаймын➡
Dialogue: 0,0:16:39.06,0:16:44.07,Default,,0000,0000,0000,,… білдіреді
Dialogue: 0,0:16:39.06,0:16:44.07,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:16:39.06,0:16:44.07,Default,,0000,0000,0000,,Мен жауапкершілікті өз мойныма аламын.
Dialogue: 0,0:16:39.06,0:16:44.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:44.07,0:16:46.61,Default,,0000,0000,0000,,《Мен кімнің бар екенін көргім де келмейді》
Dialogue: 0,0:16:46.61,0:16:49.68,Default,,0000,0000,0000,,《Осылай
Dialogue: 0,0:16:46.61,0:16:49.68,Default,,0000,0000,0000,,Жоспарланған уақытта…》
Dialogue: 0,0:16:49.68,0:16:53.08,Default,,0000,0000,0000,,《Жоқ
Dialogue: 0,0:16:49.68,0:16:53.08,Default,,0000,0000,0000,,Қазір мен осылай істеп жатырмын
Dialogue: 0,0:16:49.68,0:16:53.08,Default,,0000,0000,0000,,Егер сізге қамқорлық жасасаңыз
Dialogue: 0,0:16:49.68,0:16:53.08,Default,,0000,0000,0000,,Жоқ》
Dialogue: 0,0:16:53.08,0:16:56.58,Default,,0000,0000,0000,,《Дауыстың иесі кім?
Dialogue: 0,0:16:53.08,0:16:56.58,Default,,0000,0000,0000,,Маған бәрібір》
Dialogue: 0,0:16:56.58,0:17:00.05,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:16:56.58,0:17:00.05,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:16:56.58,0:17:00.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:56.58,0:17:00.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:56.58,0:17:00.05,Default,,0000,0000,0000,,Доёмеки
Dialogue: 0,0:16:56.58,0:17:00.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:02.05,0:17:03.56,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:17:02.05,0:17:03.56,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:17:02.05,0:17:03.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:03.56,0:17:07.59,Default,,0000,0000,0000,,《Қорқынышты көрініс болса керек...
Dialogue: 0,0:17:03.56,0:17:07.59,Default,,0000,0000,0000,,Гаошун-самадан сұраңыз➡
Dialogue: 0,0:17:07.59,0:17:11.16,Default,,0000,0000,0000,,Барлығы аяқталғанда
Dialogue: 0,0:17:07.59,0:17:11.16,Default,,0000,0000,0000,,Баяу
Dialogue: 0,0:17:07.59,0:17:11.16,Default,,0000,0000,0000,,Жуынуға рұқсат етіңіз》
Dialogue: 0,0:17:11.16,0:17:13.57,Default,,0000,0000,0000,,《Бұған дейін➡
Dialogue: 0,0:17:13.57,0:17:17.07,Default,,0000,0000,0000,,Мойын
Dialogue: 0,0:17:13.57,0:17:17.07,Default,,0000,0000,0000,,Маған соққы болмайтынына көз жеткізуім керек.
Dialogue: 0,0:17:23.08,0:17:26.55,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:23.08,0:17:26.55,Default,,0000,0000,0000,,Сықырлау
Dialogue: 0,0:17:23.08,0:17:26.55,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:30.58,0:17:32.62,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:30.58,0:17:32.62,Default,,0000,0000,0000,,Металл дыбыс
Dialogue: 0,0:17:30.58,0:17:32.62,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:32.62,0:17:34.12,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:17:36.06,0:17:39.02,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:36.06,0:17:39.02,Default,,0000,0000,0000,,Сықырлау
Dialogue: 0,0:17:36.06,0:17:39.02,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:41.06,0:17:43.06,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:41.06,0:17:43.06,Default,,0000,0000,0000,,Металл дыбыс
Dialogue: 0,0:17:41.06,0:17:43.06,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:44.56,0:17:47.07,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:44.56,0:17:47.07,Default,,0000,0000,0000,,Соққы дыбысы
Dialogue: 0,0:17:44.56,0:17:47.07,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:47.07,0:17:49.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:17:47.07,0:17:49.03,Default,,0000,0000,0000,,Доёмеки
Dialogue: 0,0:17:47.07,0:17:49.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:17:55.61,0:17:59.58,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:55.61,0:17:59.58,Default,,0000,0000,0000,,А...
Dialogue: 0,0:17:55.61,0:17:59.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:59.58,0:18:03.05,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:17:59.58,0:18:03.05,Default,,0000,0000,0000,,Егер қаласаңыз, мен оны сіздің атыңыздан жеткізе аламын.
Dialogue: 0,0:17:59.58,0:18:03.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:03.05,0:18:04.55,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:18:03.05,0:18:04.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:10.09,0:18:12.59,Default,,0000,0000,0000,,Мен тігуім керек...
Dialogue: 0,0:18:10.09,0:18:12.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:12.59,0:18:16.56,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:18:12.59,0:18:16.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:12.59,0:18:16.56,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:19.16,0:18:23.07,Default,,0000,0000,0000,,Неге...
Dialogue: 0,0:18:19.16,0:18:23.07,Default,,0000,0000,0000,,Бұл жағдай ма?
Dialogue: 0,0:18:23.07,0:18:25.07,Default,,0000,0000,0000,,Джинджи мырза…
Dialogue: 0,0:18:23.07,0:18:25.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:26.57,0:18:31.08,Default,,0000,0000,0000,,Маған сиыр етінен жасалған хуанг жеуге бола ма?
Dialogue: 0,0:18:31.08,0:18:34.55,Default,,0000,0000,0000,,Бұл бәрі емес.
Dialogue: 0,0:18:31.08,0:18:34.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:34.55,0:18:40.12,Default,,0000,0000,0000,,Сүйегім сынды!
Dialogue: 0,0:18:34.55,0:18:40.12,Default,,0000,0000,0000,,Бұл бет...
Dialogue: 0,0:18:34.55,0:18:40.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:40.12,0:18:46.56,Default,,0000,0000,0000,,《Неге Джиндзи-сама?
Dialogue: 0,0:18:40.12,0:18:46.56,Default,,0000,0000,0000,,Менің ойымша, сіз осындасыз...》
Dialogue: 0,0:18:46.56,0:18:51.56,Default,,0000,0000,0000,,《Неге?
Dialogue: 0,0:18:46.56,0:18:51.56,Default,,0000,0000,0000,,Ол сондай болса керек...》
Dialogue: 0,0:18:51.56,0:18:55.07,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:18:51.56,0:18:55.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:55.07,0:19:00.07,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:18:55.07,0:19:00.07,Default,,0000,0000,0000,,Алдымен аяқтарды тігіңіз...
Dialogue: 0,0:18:55.07,0:19:00.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:00.07,0:19:02.61,Default,,0000,0000,0000,,италиялықтарға тән —
Dialogue: 0,0:19:00.07,0:19:02.61,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:19:02.61,0:19:05.64,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:19:02.61,0:19:05.64,Default,,0000,0000,0000,,Мықты болыңыз!
Dialogue: 0,0:19:05.64,0:19:08.58,Default,,0000,0000,0000,,Оян...
Dialogue: 0,0:19:05.64,0:19:08.58,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:19:08.58,0:19:11.08,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:19:08.58,0:19:11.08,Default,,0000,0000,0000,,Мықты бол!
Dialogue: 0,0:19:11.08,0:19:14.09,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:19:11.08,0:19:14.09,Default,,0000,0000,0000,,Эй...
Dialogue: 0,0:19:11.08,0:19:14.09,Default,,0000,0000,0000,,.
