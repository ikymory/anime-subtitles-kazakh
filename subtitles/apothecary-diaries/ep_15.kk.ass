Dialogue: 0,0:01:44.07,0:01:46.57,Default,,0000,0000,0000,,Сыбыс бойынша➡
Dialogue: 0,0:01:46.57,0:01:49.58,Default,,0000,0000,0000,,Қызметші қыз істі шешуге көмектеседі.
Dialogue: 0,0:01:46.57,0:01:49.58,Default,,0000,0000,0000,,Бір рөл
Dialogue: 0,0:01:46.57,0:01:49.58,Default,,0000,0000,0000,,Оны сатып алған сияқты.
Dialogue: 0,0:01:46.57,0:01:49.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:01:49.58,0:01:51.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:01:49.58,0:01:51.08,Default,,0000,0000,0000,,3-қосымша
Dialogue: 0,0:01:49.58,0:01:51.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:01:49.58,0:01:51.08,Default,,0000,0000,0000,,Қызметші?
Dialogue: 0,0:01:51.08,0:01:53.11,Default,,0000,0000,0000,,Джинши
Dialogue: 0,0:01:51.08,0:01:53.11,Default,,0000,0000,0000,,(
Dialogue: 0,0:01:51.08,0:01:53.11,Default,,0000,0000,0000,,2-қосымша
Dialogue: 0,0:01:51.08,0:01:53.11,Default,,0000,0000,0000,,)
Dialogue: 0,0:01:51.08,0:01:53.11,Default,,0000,0000,0000,,Джинджи мырза
Dialogue: 0,0:01:51.08,0:01:53.11,Default,,0000,0000,0000,,Тіпті бөлмесі бар қызметші
Dialogue: 0,0:01:51.08,0:01:53.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:01:53.11,0:01:55.65,Default,,0000,0000,0000,,(
Dialogue: 0,0:01:53.11,0:01:55.65,Default,,0000,0000,0000,,1-қосымша
Dialogue: 0,0:01:53.11,0:01:55.65,Default,,0000,0000,0000,,)
Dialogue: 0,0:01:53.11,0:01:55.65,Default,,0000,0000,0000,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:01:53.11,0:01:55.65,Default,,0000,0000,0000,,Мистер Столкер
Dialogue: 0,0:01:55.65,0:01:57.55,Default,,0000,0000,0000,,Джиндзи-сама туралы айтқанда
Dialogue: 0,0:01:55.65,0:01:57.55,Default,,0000,0000,0000,,Бұған дейін➡
Dialogue: 0,0:01:57.55,0:02:00.05,Default,,0000,0000,0000,,Рокушокан
Dialogue: 0,0:01:57.55,0:02:00.05,Default,,0000,0000,0000,,Джиджо
Dialogue: 0,0:01:57.55,0:02:00.05,Default,,0000,0000,0000,,Рёкусейканның жезөкшесі
Dialogue: 0,0:01:57.55,0:02:00.05,Default,,0000,0000,0000,,Сіз ақшаны өтейсіз бе?
Dialogue: 0,0:02:00.05,0:02:04.06,Default,,0000,0000,0000,,Зияткерлік және суық көз
Dialogue: 0,0:02:00.05,0:02:04.06,Default,,0000,0000,0000,,Ол сұлу ма?
Dialogue: 0,0:02:00.05,0:02:04.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:04.06,0:02:07.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:04.06,0:02:07.09,Default,,0000,0000,0000,,2-қосымша
Dialogue: 0,0:02:04.06,0:02:07.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:04.06,0:02:07.09,Default,,0000,0000,0000,,Мұны көрген жұрт шу шығарып жатты.
Dialogue: 0,0:02:04.06,0:02:07.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:04.06,0:02:07.09,Default,,0000,0000,0000,,Лакан
Dialogue: 0,0:02:04.06,0:02:07.09,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:04.06,0:02:07.09,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:02:04.06,0:02:07.09,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:04.06,0:02:07.09,Default,,0000,0000,0000,,Хмм…
Dialogue: 0,0:02:04.06,0:02:07.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:07.09,0:02:10.06,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:07.09,0:02:10.06,Default,,0000,0000,0000,,3 адам
Dialogue: 0,0:02:07.09,0:02:10.06,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:07.09,0:02:10.06,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:07.09,0:02:10.06,Default,,0000,0000,0000,,Архат-сама
Dialogue: 0,0:02:07.09,0:02:10.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:11.56,0:02:17.57,Default,,0000,0000,0000,,Хехе
Dialogue: 0,0:02:11.56,0:02:17.57,Default,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:02:11.56,0:02:17.57,Default,,0000,0000,0000,,Толығырақ айтып бере аласыз ба?
Dialogue: 0,0:02:25.61,0:02:28.58,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:02:25.61,0:02:28.58,Default,,0000,0000,0000,,Сяомао
Dialogue: 0,0:02:25.61,0:02:28.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:25.61,0:02:28.58,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:02:25.61,0:02:28.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:25.61,0:02:28.58,Default,,0000,0000,0000,,Конеко
Dialogue: 0,0:02:25.61,0:02:28.58,Default,,0000,0000,0000,,Біраз
Dialogue: 0,0:02:25.61,0:02:28.58,Default,,0000,0000,0000,,Бұл жақсы ма?
Dialogue: 0,0:02:28.58,0:02:32.05,Default,,0000,0000,0000,,Мао Мао
Dialogue: 0,0:02:28.58,0:02:32.05,Default,,0000,0000,0000,,(
Dialogue: 0,0:02:28.58,0:02:32.05,Default,,0000,0000,0000,,Мысық мысық
Dialogue: 0,0:02:28.58,0:02:32.05,Default,,0000,0000,0000,,)
Dialogue: 0,0:02:28.58,0:02:32.05,Default,,0000,0000,0000,,Гаошун мырза
Dialogue: 0,0:02:28.58,0:02:32.05,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:02:32.05,0:02:35.05,Default,,0000,0000,0000,,Мен нені көргім келеді
Dialogue: 0,0:02:32.05,0:02:35.05,Default,,0000,0000,0000,,Бар.
Dialogue: 0,0:02:32.05,0:02:35.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:36.09,0:02:39.13,Default,,0000,0000,0000,,Бұл ескі жағдайдан алынған материал.
Dialogue: 0,0:02:36.09,0:02:39.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:39.13,0:02:45.06,Default,,0000,0000,0000,,Намасу
Dialogue: 0,0:02:39.13,0:02:45.06,Default,,0000,0000,0000,,10 жыл бұрын саудагер үйінде
Dialogue: 0,0:02:39.13,0:02:45.06,Default,,0000,0000,0000,,Қапшық балық торында
Dialogue: 0,0:02:39.13,0:02:45.06,Default,,0000,0000,0000,,Маған тамақтан уланғанымды айтты.
Dialogue: 0,0:02:39.13,0:02:45.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:45.06,0:02:47.03,Default,,0000,0000,0000,,《Қыршық балық уы》
Dialogue: 0,0:02:47.03,0:02:49.57,Default,,0000,0000,0000,,《Сол қышынған сезім
Dialogue: 0,0:02:47.03,0:02:49.57,Default,,0000,0000,0000,,Маған ұйқышылдық ұнайды》
Dialogue: 0,0:02:49.57,0:02:51.57,Default,,0000,0000,0000,,《Аа~
Dialogue: 0,0:02:49.57,0:02:51.57,Default,,0000,0000,0000,,Мен жегім келеді》
Dialogue: 0,0:02:51.57,0:02:55.58,Default,,0000,0000,0000,,Келесі жолы
Dialogue: 0,0:02:51.57,0:02:55.58,Default,,0000,0000,0000,,Мұндай мейрамханада
Dialogue: 0,0:02:51.57,0:02:55.58,Default,,0000,0000,0000,,Мен сені сонда апарамын.
Dialogue: 0,0:02:51.57,0:02:55.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:55.58,0:02:58.58,Default,,0000,0000,0000,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:02:55.58,0:02:58.58,Default,,0000,0000,0000,,Ха~
Dialogue: 0,0:02:55.58,0:02:58.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:58.58,0:03:00.58,Default,,0000,0000,0000,,Бл…ээ…!!
Dialogue: 0,0:02:58.58,0:03:00.58,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:03:00.58,0:03:03.62,Default,,0000,0000,0000,,Баяғыда
Dialogue: 0,0:03:00.58,0:03:03.62,Default,,0000,0000,0000,,I
Dialogue: 0,0:03:00.58,0:03:03.62,Default,,0000,0000,0000,,Осы оқиға туралы➡
Dialogue: 0,0:03:03.62,0:03:06.69,Default,,0000,0000,0000,,Жұмыста
Dialogue: 0,0:03:03.62,0:03:06.69,Default,,0000,0000,0000,,Мен қатыстым
Dialogue: 0,0:03:03.62,0:03:06.69,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:06.69,0:03:11.06,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:06.69,0:03:11.06,Default,,0000,0000,0000,,Гаошунның дауысы
Dialogue: 0,0:03:06.69,0:03:11.06,Default,,0000,0000,0000,,)
Dialogue: 0,0:03:06.69,0:03:11.06,Default,,0000,0000,0000,,Осымен
Dialogue: 0,0:03:06.69,0:03:11.06,Default,,0000,0000,0000,,Ұқсас оқиға
Dialogue: 0,0:03:06.69,0:03:11.06,Default,,0000,0000,0000,,Өйткені бұл жақында болды➡
Dialogue: 0,0:03:11.06,0:03:14.06,Default,,0000,0000,0000,,Маған бұрынғы әріптесім кеңес берді.
Dialogue: 0,0:03:11.06,0:03:14.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:14.06,0:03:18.57,Default,,0000,0000,0000,,Осыған ұқсас оқиға?
Dialogue: 0,0:03:14.06,0:03:18.57,Default,,0000,0000,0000,,Бюрократ балықты жейді ➡
Dialogue: 0,0:03:18.57,0:03:21.07,Default,,0000,0000,0000,,Консуи
Dialogue: 0,0:03:18.57,0:03:21.07,Default,,0000,0000,0000,,Ол комада жатыр.
Dialogue: 0,0:03:18.57,0:03:21.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:21.07,0:03:24.10,Default,,0000,0000,0000,,Кома
Dialogue: 0,0:03:21.07,0:03:24.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:24.10,0:03:26.64,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:03:24.10,0:03:26.64,Default,,0000,0000,0000,,Гаошун мырза
Dialogue: 0,0:03:24.10,0:03:26.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:26.64,0:03:30.08,Default,,0000,0000,0000,,Менің естігенім осы
Dialogue: 0,0:03:26.64,0:03:30.08,Default,,0000,0000,0000,,Бұл жақсы әңгіме ме?
Dialogue: 0,0:03:30.08,0:03:32.05,Default,,0000,0000,0000,,Мәселе жоқ
Dialogue: 0,0:03:30.08,0:03:32.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:32.05,0:03:35.55,Default,,0000,0000,0000,,Конеко өз ұстанымын түсіндіреді
Dialogue: 0,0:03:32.05,0:03:35.55,Default,,0000,0000,0000,,Мен түсінемін.
Dialogue: 0,0:03:32.05,0:03:35.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:35.55,0:03:38.55,Default,,0000,0000,0000,,Тайбар әулеті келді!!
Dialogue: 0,0:03:35.55,0:03:38.55,Default,,0000,0000,0000,,《Басқаша айтқанда
Dialogue: 0,0:03:35.55,0:03:38.55,Default,,0000,0000,0000,,Сөйлеме》
Dialogue: 0,0:03:38.55,0:03:42.06,Default,,0000,0000,0000,,Ал қазір
Dialogue: 0,0:03:38.55,0:03:42.06,Default,,0000,0000,0000,,У шығады
Dialogue: 0,0:03:38.55,0:03:42.06,Default,,0000,0000,0000,,Бұл оқиға➡
Dialogue: 0,0:03:42.06,0:03:44.09,Default,,0000,0000,0000,,Мен оны ортасынан кесіп аламын ба?
Dialogue: 0,0:03:44.09,0:03:48.56,Default,,0000,0000,0000,,73 адам із-түссіз жоғалып кетті
Dialogue: 0,0:03:44.09,0:03:48.56,Default,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:03:44.09,0:03:48.56,Default,,0000,0000,0000,,Әңгімені жалғастырыңыз
Dialogue: 0,0:03:44.09,0:03:48.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:52.57,0:03:54.57,Default,,0000,0000,0000,,Бұл жолы
Dialogue: 0,0:03:52.57,0:03:54.57,Default,,0000,0000,0000,,Себетте➡
Dialogue: 0,0:03:54.57,0:03:58.57,Default,,0000,0000,0000,,Пісірілген балық терісі мен еті
Dialogue: 0,0:03:54.57,0:03:58.57,Default,,0000,0000,0000,,Ол пайдаланған сияқты
Dialogue: 0,0:03:54.57,0:03:58.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:58.57,0:04:01.57,Default,,0000,0000,0000,,Оны жеп, комаға түсті.
Dialogue: 0,0:03:58.57,0:04:01.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:01.57,0:04:07.08,Default,,0000,0000,0000,,Бұл балық еті ме?
Dialogue: 0,0:04:01.57,0:04:07.08,Default,,0000,0000,0000,,Ең улы
Dialogue: 0,0:04:01.57,0:04:07.08,Default,,0000,0000,0000,,Бауыр сияқты ішкі органдар
Dialogue: 0,0:04:01.57,0:04:07.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:07.08,0:04:10.08,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:04:07.08,0:04:10.08,Default,,0000,0000,0000,,Тері және дене
Dialogue: 0,0:04:07.08,0:04:10.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:10.08,0:04:13.69,Default,,0000,0000,0000,,Дене салыстырмалы түрде
Dialogue: 0,0:04:10.08,0:04:13.69,Default,,0000,0000,0000,,Удың әлсіз болуы керек болса да...
Dialogue: 0,0:04:10.08,0:04:13.69,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:13.69,0:04:16.56,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:04:13.69,0:04:16.56,Default,,0000,0000,0000,,Түрі мен ортаға байланысты➡
Dialogue: 0,0:04:16.56,0:04:19.56,Default,,0000,0000,0000,,Денесі улы болса да
Dialogue: 0,0:04:16.56,0:04:19.56,Default,,0000,0000,0000,,Бар болуы мүмкін
Dialogue: 0,0:04:16.56,0:04:19.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:19.56,0:04:22.56,Default,,0000,0000,0000,,Бөлек
Dialogue: 0,0:04:19.56,0:04:22.56,Default,,0000,0000,0000,,Бір қызығы сол
Dialogue: 0,0:04:19.56,0:04:22.56,Default,,0000,0000,0000,,Мүмкін емес пе?
Dialogue: 0,0:04:22.56,0:04:27.57,Default,,0000,0000,0000,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:04:22.56,0:04:27.57,Default,,0000,0000,0000,,Бұл оқиға және алдыңғы оқиға
Dialogue: 0,0:04:22.56,0:04:27.57,Default,,0000,0000,0000,,Аспаз -➡
Dialogue: 0,0:04:27.57,0:04:31.07,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:04:27.57,0:04:31.07,Default,,0000,0000,0000,,Фугу тағам дайындауда қолданылмайды
Dialogue: 0,0:04:27.57,0:04:31.07,Default,,0000,0000,0000,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:04:27.57,0:04:31.07,Default,,0000,0000,0000,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:04:27.57,0:04:31.07,Default,,0000,0000,0000,,Мен талап етемін.
Dialogue: 0,0:04:27.57,0:04:31.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:31.07,0:04:33.57,Default,,0000,0000,0000,,Қызық оқиға сияқты.
Dialogue: 0,0:04:31.07,0:04:33.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:33.57,0:04:36.61,Default,,0000,0000,0000,,Бізде ортақ нәрсе бар
Dialogue: 0,0:04:33.57,0:04:36.61,Default,,0000,0000,0000,,Бірақ бұл бәрі емес.
Dialogue: 0,0:04:33.57,0:04:36.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:36.61,0:04:41.05,Default,,0000,0000,0000,,Құлап кеткен екі адам...
Dialogue: 0,0:04:36.61,0:04:41.05,Default,,0000,0000,0000,,Осы шенеунікпен
Dialogue: 0,0:04:36.61,0:04:41.05,Default,,0000,0000,0000,,Соңғы саудагер ➡ болды
Dialogue: 0,0:04:41.05,0:04:45.05,Default,,0000,0000,0000,,Екеуі де талғампаз
Dialogue: 0,0:04:41.05,0:04:45.05,Default,,0000,0000,0000,,Ол дәмді тағамдарды ұнататын.
Dialogue: 0,0:04:41.05,0:04:45.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:45.05,0:04:48.55,Default,,0000,0000,0000,,Мен әдетте шикі балықты жеймін, т.б.
Dialogue: 0,0:04:45.05,0:04:48.55,Default,,0000,0000,0000,,Дұрыс тамақтану➡
Dialogue: 0,0:04:48.55,0:04:51.52,Default,,0000,0000,0000,,Қапшық балығы да сүйікті тағам деп айтылды.
Dialogue: 0,0:04:48.55,0:04:51.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:51.52,0:04:55.06,Default,,0000,0000,0000,,Чубу
Dialogue: 0,0:04:51.52,0:04:55.06,Default,,0000,0000,0000,,Оқиғадан кейін
Dialogue: 0,0:04:51.52,0:04:55.06,Default,,0000,0000,0000,,Ас үйдегі қоқыстан➡
Dialogue: 0,0:04:55.06,0:04:58.10,Default,,0000,0000,0000,,Ішкі мүшелер және тері
Dialogue: 0,0:04:55.06,0:04:58.10,Default,,0000,0000,0000,,Бәрі ашылғаннан бері➡
Dialogue: 0,0:04:58.10,0:05:01.53,Default,,0000,0000,0000,,Бауыр жеуге болмайды
Dialogue: 0,0:04:58.10,0:05:01.53,Default,,0000,0000,0000,,Сотталды
Dialogue: 0,0:04:58.10,0:05:01.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:01.53,0:05:05.07,Default,,0000,0000,0000,,Екі оқиғадағы аспаздардың екеуі де ➡ болды
Dialogue: 0,0:05:05.07,0:05:08.54,Default,,0000,0000,0000,,Қапшық балық
Dialogue: 0,0:05:05.07,0:05:08.54,Default,,0000,0000,0000,,Ол алдыңғы күні пісіру үшін қолданылған➡
Dialogue: 0,0:05:08.54,0:05:13.05,Default,,0000,0000,0000,,Себетке тағы бір балық пайдаланылды.
Dialogue: 0,0:05:08.54,0:05:13.05,Default,,0000,0000,0000,,Өз кінәсін мойындамады.
Dialogue: 0,0:05:08.54,0:05:13.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:13.05,0:05:17.55,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,0:05:13.05,0:05:17.55,Default,,0000,0000,0000,,Айғақ беретін ешкім болмады.
Dialogue: 0,0:05:13.05,0:05:17.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:17.55,0:05:20.59,Default,,0000,0000,0000,,Ресми тұлғалар
Dialogue: 0,0:05:17.55,0:05:20.59,Default,,0000,0000,0000,,Барлық тағамды аяқтағаннан кейін 30 минуттан кейін➡
Dialogue: 0,0:05:20.59,0:05:23.16,Default,,0000,0000,0000,,Улану белгілеріне байланысты құлады➡
Dialogue: 0,0:05:23.16,0:05:26.03,Default,,0000,0000,0000,,Мен тырысқан жерде
Dialogue: 0,0:05:23.16,0:05:26.03,Default,,0000,0000,0000,,ашылды
Dialogue: 0,0:05:23.16,0:05:26.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:26.03,0:05:29.56,Default,,0000,0000,0000,,《Сіз таң қаларлықтай мұқият тергеу жүргізіп жатырсыз.》
Dialogue: 0,0:05:29.56,0:05:32.57,Default,,0000,0000,0000,,《Тиісті тергеу арқылы
Dialogue: 0,0:05:29.56,0:05:32.57,Default,,0000,0000,0000,,Қылмыскерді ойлап табу➡
Dialogue: 0,0:05:32.57,0:05:35.54,Default,,0000,0000,0000,,Тіпті жаман шенеуніктер де
Dialogue: 0,0:05:32.57,0:05:35.54,Default,,0000,0000,0000,,Олар көп болса да》
Dialogue: 0,0:05:35.54,0:05:37.54,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:37.54,0:05:43.61,Default,,0000,0000,0000,,Симптомдары балық балығының уына ұқсас.
Dialogue: 0,0:05:37.54,0:05:43.61,Default,,0000,0000,0000,,Тек әңгіме ештеңе айтқан жоқ.
Dialogue: 0,0:05:37.54,0:05:43.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:43.61,0:05:49.08,Default,,0000,0000,0000,,Гаошун мырза
Dialogue: 0,0:05:43.61,0:05:49.08,Default,,0000,0000,0000,,Кішкене қосымша ақпарат
Dialogue: 0,0:05:43.61,0:05:49.08,Default,,0000,0000,0000,,Оны маған жинап бере аласыз ба?
Dialogue: 0,0:05:49.08,0:05:52.05,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:05:49.08,0:05:52.05,Default,,0000,0000,0000,,Мен оны қарастырамын.
Dialogue: 0,0:05:49.08,0:05:52.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:57.06,0:05:58.56,Default,,0000,0000,0000,,《Егер бұл маусым болса➡
Dialogue: 0,0:05:58.56,0:06:02.53,Default,,0000,0000,0000,,Тамақ қалдықтарын бірнеше күн қалдырсаңыз да.
Dialogue: 0,0:05:58.56,0:06:02.53,Default,,0000,0000,0000,,Бұл таңқаларлық емес》
Dialogue: 0,0:06:02.53,0:06:05.60,Default,,0000,0000,0000,,《Басқа балық қолданылған деген әңгіме де бар➡
Dialogue: 0,0:06:05.60,0:06:08.67,Default,,0000,0000,0000,,Қалдықтар табылды
Dialogue: 0,0:06:05.60,0:06:08.67,Default,,0000,0000,0000,,Ешқандай қайшылық жоқ》
Dialogue: 0,0:06:08.67,0:06:10.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:08.67,0:06:10.57,Default,,0000,0000,0000,,Джинши
Dialogue: 0,0:06:08.67,0:06:10.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:08.67,0:06:10.57,Default,,0000,0000,0000,,Сіз не туралы айттыңыз?
Dialogue: 0,0:06:10.57,0:06:12.07,Default,,0000,0000,0000,,Мен оны жек көремін...!
Dialogue: 0,0:06:12.07,0:06:14.54,Default,,0000,0000,0000,,Күтілгендей
Dialogue: 0,0:06:12.07,0:06:14.54,Default,,0000,0000,0000,,Бұл бет мені де ауыртады
Dialogue: 0,0:06:12.07,0:06:14.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:18.04,0:06:21.55,Default,,0000,0000,0000,,Гаошунның әңгімесі
Dialogue: 0,0:06:18.04,0:06:21.55,Default,,0000,0000,0000,,өте ынталы
Dialogue: 0,0:06:18.04,0:06:21.55,Default,,0000,0000,0000,,Мұны естіген сияқтысыз ба?
Dialogue: 0,0:06:21.55,0:06:25.59,Default,,0000,0000,0000,,Егер бұл қызықты оқиға болса
Dialogue: 0,0:06:21.55,0:06:25.59,Default,,0000,0000,0000,,Өйткені адамдар тыңдайды.
Dialogue: 0,0:06:21.55,0:06:25.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:25.59,0:06:29.12,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:06:25.59,0:06:29.12,Default,,0000,0000,0000,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:06:25.59,0:06:29.12,Default,,0000,0000,0000,,Алып тасташы, өтінемін...?
Dialogue: 0,0:06:25.59,0:06:29.12,Default,,0000,0000,0000,,Менің оқиғам
Dialogue: 0,0:06:25.59,0:06:29.12,Default,,0000,0000,0000,,Көбінесе жолда...
Dialogue: 0,0:06:25.59,0:06:29.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:29.12,0:06:33.06,Default,,0000,0000,0000,,Кеш болғандықтан,
Dialogue: 0,0:06:29.12,0:06:33.06,Default,,0000,0000,0000,,Маған үйге баруға рұқсат етіңіз
Dialogue: 0,0:06:29.12,0:06:33.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:33.06,0:06:35.53,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:06:33.06,0:06:35.53,Default,,0000,0000,0000,,Әңгіме әлі біткен жоқ...
Dialogue: 0,0:06:33.06,0:06:35.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:35.53,0:06:38.03,Default,,0000,0000,0000,,Су лалагүлі
Dialogue: 0,0:06:35.53,0:06:38.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:06:35.53,0:06:38.03,Default,,0000,0000,0000,,Су лотосу
Dialogue: 0,0:06:35.53,0:06:38.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:06:35.53,0:06:38.03,Default,,0000,0000,0000,,О, құдай!
Dialogue: 0,0:06:35.53,0:06:38.03,Default,,0000,0000,0000,,Қозғалмаңыз
Dialogue: 0,0:06:35.53,0:06:38.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:38.03,0:06:41.57,Default,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:06:38.03,0:06:41.57,Default,,0000,0000,0000,,Тыныш отырыңыз
Dialogue: 0,0:06:38.03,0:06:41.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:41.57,0:06:43.04,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:06:41.57,0:06:43.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:47.04,0:06:50.04,Default,,0000,0000,0000,,Конеко
Dialogue: 0,0:06:47.04,0:06:50.04,Default,,0000,0000,0000,,Кешегі күнге келсек...
Dialogue: 0,0:06:47.04,0:06:50.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:52.08,0:06:54.11,Default,,0000,0000,0000,,Бұл аспаздық кітап
Dialogue: 0,0:06:52.08,0:06:54.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:54.11,0:06:56.15,Default,,0000,0000,0000,,Құлдың куәлігі бойынша➡
Dialogue: 0,0:06:56.15,0:06:59.55,Default,,0000,0000,0000,,Күйеуіме қандай тағам беруім керек?
Dialogue: 0,0:06:56.15,0:06:59.55,Default,,0000,0000,0000,,Дерлік
Dialogue: 0,0:06:56.15,0:06:59.55,Default,,0000,0000,0000,,Мұнда жазылғандай
Dialogue: 0,0:06:56.15,0:06:59.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:59.55,0:07:01.52,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:06:59.55,0:07:01.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:04.56,0:07:09.06,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:07:04.56,0:07:09.06,Default,,0000,0000,0000,,Пісірілген балық үшін
Dialogue: 0,0:07:04.56,0:07:09.06,Default,,0000,0000,0000,,Ұсақталған көкөністер
Dialogue: 0,0:07:04.56,0:07:09.06,Default,,0000,0000,0000,,Сірке суын қосыңыз.
Dialogue: 0,0:07:04.56,0:07:09.06,Default,,0000,0000,0000,,”.
Dialogue: 0,0:07:09.06,0:07:13.07,Default,,0000,0000,0000,,Себет қалай жасалады
Dialogue: 0,0:07:09.06,0:07:13.07,Default,,0000,0000,0000,,Мұнда ерекше таңғаларлық ештеңе жоқ.
Dialogue: 0,0:07:09.06,0:07:13.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:13.07,0:07:16.57,Default,,0000,0000,0000,,Сірке суының қоспасы
Dialogue: 0,0:07:13.07,0:07:16.57,Default,,0000,0000,0000,,Жазылған бірнеше түрі бар➡
Dialogue: 0,0:07:16.57,0:07:19.14,Default,,0000,0000,0000,,Материалдар егжей-тегжейлі көрсетілмеген
Dialogue: 0,0:07:16.57,0:07:19.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:19.14,0:07:24.54,Default,,0000,0000,0000,,Жыл мезгіліне байланысты шығар
Dialogue: 0,0:07:19.14,0:07:24.54,Default,,0000,0000,0000,,Қол жетімді
Dialogue: 0,0:07:19.14,0:07:24.54,Default,,0000,0000,0000,,Мүмкін, балық пен көкөніс өзгергендіктен.
Dialogue: 0,0:07:19.14,0:07:24.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:24.54,0:07:30.05,Default,,0000,0000,0000,,Бұл маңызды мәселе.
Dialogue: 0,0:07:24.54,0:07:30.05,Default,,0000,0000,0000,,Нені пайдалану керек
Dialogue: 0,0:07:24.54,0:07:30.05,Default,,0000,0000,0000,,Сіз мұны жасадыңыз ба, білмеймін.
Dialogue: 0,0:07:24.54,0:07:30.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:30.05,0:07:33.05,Default,,0000,0000,0000,,Түсінбейсің бе?
Dialogue: 0,0:07:33.05,0:07:35.05,Default,,0000,0000,0000,,《Ол әңгімеге қосылғысы келетін сияқты》
Dialogue: 0,0:07:35.05,0:07:36.56,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:07:35.05,0:07:36.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:36.56,0:07:39.56,Default,,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:07:36.56,0:07:39.56,Default,,0000,0000,0000,,Нені түсінбедіңіз?
Dialogue: 0,0:07:39.56,0:07:41.63,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:07:39.56,0:07:41.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:41.63,0:07:44.53,Default,,0000,0000,0000,,Бұл кешкі асқа дейін.
Dialogue: 0,0:07:41.63,0:07:44.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:44.53,0:07:46.07,Default,,0000,0000,0000,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:07:44.53,0:07:46.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:46.07,0:07:49.07,Default,,0000,0000,0000,,《Көп
Dialogue: 0,0:07:46.07,0:07:49.07,Default,,0000,0000,0000,,Балалық заттар》
Dialogue: 0,0:07:49.07,0:07:51.04,Default,,0000,0000,0000,,Оқиға қашан болды?
Dialogue: 0,0:07:51.04,0:07:53.54,Default,,0000,0000,0000,,Шамамен бір апта бұрын
Dialogue: 0,0:07:51.04,0:07:53.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:53.54,0:07:56.08,Default,,0000,0000,0000,,Қысқы көкөністерге келетін болсақ➡
Dialogue: 0,0:07:56.08,0:08:00.05,Default,,0000,0000,0000,,Себеттің материалы - шалғам немесе сәбіз.
Dialogue: 0,0:07:56.08,0:08:00.05,Default,,0000,0000,0000,,Әлде соған ұқсас нәрсе ме?
Dialogue: 0,0:08:00.05,0:08:04.12,Default,,0000,0000,0000,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:08:00.05,0:08:04.12,Default,,0000,0000,0000,,Ол теңіз балдырларын пайдаланғанын айтты.
Dialogue: 0,0:08:00.05,0:08:04.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:04.12,0:08:07.55,Default,,0000,0000,0000,,Бұл теңіз балдыры ма?
Dialogue: 0,0:08:04.12,0:08:07.55,Default,,0000,0000,0000,,Теңіз балдыры
Dialogue: 0,0:08:04.12,0:08:07.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:07.55,0:08:10.06,Default,,0000,0000,0000,,《Тәтті тағамдарға артықшылық беру➡
Dialogue: 0,0:08:10.06,0:08:12.56,Default,,0000,0000,0000,,Ерекше теңіз балдыры
Dialogue: 0,0:08:10.06,0:08:12.56,Default,,0000,0000,0000,,қосуға болады》
Dialogue: 0,0:08:12.56,0:08:14.06,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:08:12.56,0:08:14.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:14.06,0:08:17.10,Default,,0000,0000,0000,,Егер
Dialogue: 0,0:08:14.06,0:08:17.10,Default,,0000,0000,0000,,Қарсы болмасаңыз
Dialogue: 0,0:08:14.06,0:08:17.10,Default,,0000,0000,0000,,Үйдің асханасы➡
Dialogue: 0,0:08:17.10,0:08:20.07,Default,,0000,0000,0000,,Маған көрсетулерің керек
Dialogue: 0,0:08:17.10,0:08:20.07,Default,,0000,0000,0000,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:08:27.14,0:08:28.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:33.58,0:08:37.55,Default,,0000,0000,0000,,Гаошун мырзадан
Dialogue: 0,0:08:33.58,0:08:37.55,Default,,0000,0000,0000,,Мен сенен осында келуіңді өтіндім.
Dialogue: 0,0:08:33.58,0:08:37.55,Default,,0000,0000,0000,,Маған айтты
Dialogue: 0,0:08:33.58,0:08:37.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:37.55,0:08:42.05,Default,,0000,0000,0000,,Бәсен
Dialogue: 0,0:08:37.55,0:08:42.05,Default,,0000,0000,0000,,Бұл Масен.
Dialogue: 0,0:08:37.55,0:08:42.05,Default,,0000,0000,0000,,Мен әңгімені естідім.
Dialogue: 0,0:08:37.55,0:08:42.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:37.55,0:08:42.05,Default,,0000,0000,0000,,Бұл мысық пен мысық.
Dialogue: 0,0:08:37.55,0:08:42.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:42.05,0:08:46.56,Default,,0000,0000,0000,,Мен қазір сарайға бара жатырмын.
Dialogue: 0,0:08:42.05,0:08:46.56,Default,,0000,0000,0000,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:08:42.05,0:08:46.56,Default,,0000,0000,0000,,Ол менің серігім ғана.
Dialogue: 0,0:08:42.05,0:08:46.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:46.56,0:08:49.10,Default,,0000,0000,0000,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:08:46.56,0:08:49.10,Default,,0000,0000,0000,,Өзімшіл ештеңе жасамаңыз.
Dialogue: 0,0:08:46.56,0:08:49.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:49.10,0:08:51.10,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:08:49.10,0:08:51.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:55.17,0:08:59.07,Default,,0000,0000,0000,,Егер сіз сол жаққа барсаңыз
Dialogue: 0,0:08:55.17,0:08:59.07,Default,,0000,0000,0000,,Үйдің қызметшісі
Dialogue: 0,0:08:55.17,0:08:59.07,Default,,0000,0000,0000,,Ол сізге асүйді көрсетеді.
Dialogue: 0,0:08:55.17,0:08:59.07,Default,,0000,0000,0000,,. [жиырма екі] .
Dialogue: 0,0:08:59.07,0:09:00.57,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:08:59.07,0:09:00.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:00.57,0:09:04.08,Default,,0000,0000,0000,,《Гаошун мырза күткендей
Dialogue: 0,0:09:00.57,0:09:04.08,Default,,0000,0000,0000,,Жылдам жұмыс істейді》
Dialogue: 0,0:09:04.08,0:09:07.58,Default,,0000,0000,0000,,《Солай болса да...
Dialogue: 0,0:09:04.08,0:09:07.58,Default,,0000,0000,0000,,Бұл мен бұрын көрмеген әскери офицер.
Dialogue: 0,0:09:07.58,0:09:11.58,Default,,0000,0000,0000,,《Мен өзімді біреуге ұқсайтындай сезінемін》
Dialogue: 0,0:09:11.58,0:09:16.09,Default,,0000,0000,0000,,《Менің ойымша, сіз онша жақсы ойламайсыз.
Dialogue: 0,0:09:11.58,0:09:16.09,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:09:11.58,0:09:16.09,Default,,0000,0000,0000,,Жарайды》
Dialogue: 0,0:09:21.69,0:09:23.66,Default,,0000,0000,0000,,(
Dialogue: 0,0:09:21.69,0:09:23.66,Default,,0000,0000,0000,,Қызметші
Dialogue: 0,0:09:21.69,0:09:23.66,Default,,0000,0000,0000,,)
Dialogue: 0,0:09:21.69,0:09:23.66,Default,,0000,0000,0000,,Бұл ас үй.
Dialogue: 0,0:09:21.69,0:09:23.66,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:26.57,0:09:30.47,Default,,0000,0000,0000,,(
Dialogue: 0,0:09:26.57,0:09:30.47,Default,,0000,0000,0000,,Қызметші
Dialogue: 0,0:09:26.57,0:09:30.47,Default,,0000,0000,0000,,)
Dialogue: 0,0:09:26.57,0:09:30.47,Default,,0000,0000,0000,,Улы оқиғадан бері
Dialogue: 0,0:09:26.57,0:09:30.47,Default,,0000,0000,0000,,Пайдаланылмаған
Dialogue: 0,0:09:26.57,0:09:30.47,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:34.57,0:09:36.08,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:34.57,0:09:36.08,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:09:34.57,0:09:36.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:36.08,0:09:37.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:09:36.08,0:09:37.58,Default,,0000,0000,0000,,Жүгіру қадамдары
Dialogue: 0,0:09:36.08,0:09:37.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:09:36.08,0:09:37.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:09:36.08,0:09:37.58,Default,,0000,0000,0000,,өзі құдаймын деп айтқан адаммен кездескеннен бері.
Dialogue: 0,0:09:36.08,0:09:37.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:09:36.08,0:09:37.58,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:09:36.08,0:09:37.58,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:09:36.08,0:09:37.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:37.58,0:09:39.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:09:37.58,0:09:39.08,Default,,0000,0000,0000,,Қызметші
Dialogue: 0,0:09:37.58,0:09:39.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:09:37.58,0:09:39.08,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:37.58,0:09:39.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:39.08,0:09:41.08,Default,,0000,0000,0000,,(
Dialogue: 0,0:09:39.08,0:09:41.08,Default,,0000,0000,0000,,өзі құдаймын деп айтқан адаммен кездескеннен бері.
Dialogue: 0,0:09:39.08,0:09:41.08,Default,,0000,0000,0000,,)
Dialogue: 0,0:09:39.08,0:09:41.08,Default,,0000,0000,0000,,Рұқсатсыз кіруге болмайды!
Dialogue: 0,0:09:39.08,0:09:41.08,Default,,0000,0000,0000,,Шығу!
Dialogue: 0,0:09:41.08,0:09:45.15,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:41.08,0:09:45.15,Default,,0000,0000,0000,,Бұл жігіттерге ұнайды
Dialogue: 0,0:09:41.08,0:09:45.15,Default,,0000,0000,0000,,Кім әкелді
Dialogue: 0,0:09:41.08,0:09:45.15,Default,,0000,0000,0000,,Сіз бе?
Dialogue: 0,0:09:45.15,0:09:47.09,Default,,0000,0000,0000,,Әйеліңізге лайықты түрде
Dialogue: 0,0:09:45.15,0:09:47.09,Default,,0000,0000,0000,,Біз растадық
Dialogue: 0,0:09:45.15,0:09:47.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:47.09,0:09:49.56,Default,,0000,0000,0000,,Юкине-кун, барсың ба?
Dialogue: 0,0:09:47.09,0:09:49.56,Default,,0000,0000,0000,,Бұл жұмыс, сондықтан
Dialogue: 0,0:09:47.09,0:09:49.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:49.56,0:09:52.06,Default,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:09:52.06,0:09:56.06,Default,,0000,0000,0000,,Тіпті кірсеңіз де
Dialogue: 0,0:09:52.06,0:09:56.06,Default,,0000,0000,0000,,Сіз сенімдісіз бе?
Dialogue: 0,0:09:52.06,0:09:56.06,Default,,0000,0000,0000,,Әлде ыңғайсыз нәрсе ме?
Dialogue: 0,0:09:56.06,0:09:58.56,Default,,0000,0000,0000,,Tsk
Dialogue: 0,0:09:56.06,0:09:58.56,Default,,0000,0000,0000,,Қалағаныңды істе
Dialogue: 0,0:09:56.06,0:09:58.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:00.57,0:10:05.10,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:00.57,0:10:05.10,Default,,0000,0000,0000,,Сыбырда
Dialogue: 0,0:10:00.57,0:10:05.10,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:00.57,0:10:05.10,Default,,0000,0000,0000,,Жоқ, бұл тек қана тәжірибе.
Dialogue: 0,0:10:00.57,0:10:05.10,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:00.57,0:10:05.10,Default,,0000,0000,0000,,Қызметші
Dialogue: 0,0:10:00.57,0:10:05.10,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:00.57,0:10:05.10,Default,,0000,0000,0000,,Бұл менің күйеуімнің інісі.
Dialogue: 0,0:10:00.57,0:10:05.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:05.10,0:10:07.64,Default,,0000,0000,0000,,Күйеуім комада➡
Dialogue: 0,0:10:07.64,0:10:10.08,Default,,0000,0000,0000,,Ханым да
Dialogue: 0,0:10:07.64,0:10:10.08,Default,,0000,0000,0000,,Шаршағандықтан ұйықтап қалдым➡
Dialogue: 0,0:10:10.08,0:10:13.58,Default,,0000,0000,0000,,Менің ағам
Dialogue: 0,0:10:10.08,0:10:13.58,Default,,0000,0000,0000,,Мен сарайға жауаптымын.
Dialogue: 0,0:10:10.08,0:10:13.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:13.58,0:10:16.58,Default,,0000,0000,0000,,Осыны айтып тұрсың ба?
Dialogue: 0,0:10:13.58,0:10:16.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:16.58,0:10:19.05,Default,,0000,0000,0000,,Мәсен-сама
Dialogue: 0,0:10:16.58,0:10:19.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:16.58,0:10:19.05,Default,,0000,0000,0000,,О
Dialogue: 0,0:10:16.58,0:10:19.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:21.09,0:10:26.06,Default,,0000,0000,0000,,《Пісіруге арналған ыдыстар
Dialogue: 0,0:10:21.09,0:10:26.06,Default,,0000,0000,0000,,Аспаз оны жуып қойған сияқты.》
Dialogue: 0,0:10:26.06,0:10:28.13,Default,,0000,0000,0000,,《Басқа нәрселер...》
Dialogue: 0,0:10:28.13,0:10:29.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:29.66,0:10:32.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:29.66,0:10:32.57,Default,,0000,0000,0000,,Аяқ дыбыстары
Dialogue: 0,0:10:29.66,0:10:32.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:34.03,0:10:37.04,Default,,0000,0000,0000,,(
Dialogue: 0,0:10:34.03,0:10:37.04,Default,,0000,0000,0000,,Қақпақты ашу дыбысы
Dialogue: 0,0:10:34.03,0:10:37.04,Default,,0000,0000,0000,,)
Dialogue: 0,0:10:34.03,0:10:37.04,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:10:34.03,0:10:37.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:38.54,0:10:42.54,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:10:38.54,0:10:42.54,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:10:38.54,0:10:42.54,Default,,0000,0000,0000,,Күйеуіме ұнайды.
Dialogue: 0,0:10:38.54,0:10:42.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:42.54,0:10:45.54,Default,,0000,0000,0000,,Таңдаулылар
Dialogue: 0,0:10:42.54,0:10:45.54,Default,,0000,0000,0000,,Ол жақсы тамақтанды➡
Dialogue: 0,0:10:45.54,0:10:48.55,Default,,0000,0000,0000,,Менің ойымша, бұл улы емес.
Dialogue: 0,0:10:45.54,0:10:48.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:48.55,0:10:51.08,Default,,0000,0000,0000,,《Өтірік
Dialogue: 0,0:10:48.55,0:10:51.08,Default,,0000,0000,0000,,Бұл жұмыс істемейтін сияқты.
Dialogue: 0,0:10:51.08,0:10:53.62,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:10:51.08,0:10:53.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:53.62,0:10:56.16,Default,,0000,0000,0000,,Аяқтасаңыз, үйге тезірек келіңіз.
Dialogue: 0,0:10:53.62,0:10:56.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:56.16,0:10:58.12,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:10:56.16,0:10:58.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:01.56,0:11:04.03,Default,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:11:01.56,0:11:04.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:07.03,0:11:09.57,Default,,0000,0000,0000,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:11:07.03,0:11:09.57,Default,,0000,0000,0000,,Оңай кері қайттың ба?
Dialogue: 0,0:11:09.57,0:11:12.57,Default,,0000,0000,0000,,Менің ойымша, біз кері шегініп жатқан жоқпыз.
Dialogue: 0,0:11:09.57,0:11:12.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:12.57,0:11:15.07,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:15.07,0:11:17.08,Default,,0000,0000,0000,,Сіз оны әкелдіңіз бе?
Dialogue: 0,0:11:17.08,0:11:19.61,Default,,0000,0000,0000,,Хаха… бұл қызық екен.
Dialogue: 0,0:11:17.08,0:11:19.61,Default,,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,0:11:17.08,0:11:19.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:19.61,0:11:23.05,Default,,0000,0000,0000,,Бұл теңіз балдыры жиналатын маусымда,
Dialogue: 0,0:11:19.61,0:11:23.05,Default,,0000,0000,0000,,Әлі сәл ерте
Dialogue: 0,0:11:19.61,0:11:23.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:23.05,0:11:26.05,Default,,0000,0000,0000,,Себебі
Dialogue: 0,0:11:23.05,0:11:26.05,Default,,0000,0000,0000,,Тұзданғаннан кейін➡
Dialogue: 0,0:11:26.05,0:11:29.06,Default,,0000,0000,0000,,Осы уақытқа дейін
Dialogue: 0,0:11:26.05,0:11:29.06,Default,,0000,0000,0000,,Бұл бар нәрсе емес.
Dialogue: 0,0:11:26.05,0:11:29.06,Default,,0000,0000,0000,,. [жиырма бес] .
Dialogue: 0,0:11:29.06,0:11:30.52,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:11:29.06,0:11:30.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:30.52,0:11:34.56,Default,,0000,0000,0000,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:11:30.52,0:11:34.56,Default,,0000,0000,0000,,Осы маңайда
Dialogue: 0,0:11:30.52,0:11:34.56,Default,,0000,0000,0000,,Мен оны жинаған жоқ деп ойлаймын.
Dialogue: 0,0:11:30.52,0:11:34.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:34.56,0:11:39.63,Default,,0000,0000,0000,,Мысалы, саудада
Dialogue: 0,0:11:34.56,0:11:39.63,Default,,0000,0000,0000,,Мен оны оңтүстіктен сатып алғанын естідім...
Dialogue: 0,0:11:34.56,0:11:39.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:39.63,0:11:44.07,Default,,0000,0000,0000,,Оны қайдан алдың?
Dialogue: 0,0:11:39.63,0:11:44.07,Default,,0000,0000,0000,,Түсінесіз деп үміттенемін.
Dialogue: 0,0:11:39.63,0:11:44.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:44.07,0:11:45.57,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:44.07,0:11:45.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:47.07,0:11:49.61,Default,,0000,0000,0000,,《Ол түсінетін сияқты》
Dialogue: 0,0:11:49.61,0:11:53.58,Default,,0000,0000,0000,,《Нара
Dialogue: 0,0:11:49.61,0:11:53.58,Default,,0000,0000,0000,,Мен де
Dialogue: 0,0:11:49.61,0:11:53.58,Default,,0000,0000,0000,,Мен істеу керек нәрсені істейік》
Dialogue: 0,0:12:01.05,0:12:03.06,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:12:01.05,0:12:03.06,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:12:01.05,0:12:03.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:03.06,0:12:05.56,Default,,0000,0000,0000,,Бұл сарайдан әкелінген теңіз балдыры.
Dialogue: 0,0:12:03.06,0:12:05.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:05.56,0:12:09.53,Default,,0000,0000,0000,,Алдын ала екіге бөліңіз
Dialogue: 0,0:12:05.56,0:12:09.53,Default,,0000,0000,0000,,Суда
Dialogue: 0,0:12:05.56,0:12:09.53,Default,,0000,0000,0000,,Мен оны ашық қалдырдым.
Dialogue: 0,0:12:05.56,0:12:09.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:09.53,0:12:13.10,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:09.53,0:12:13.10,Default,,0000,0000,0000,,《Неге Джиндзи-сама да сонда?》
Dialogue: 0,0:12:13.10,0:12:18.07,Default,,0000,0000,0000,,Зерттеулер бойынша
Dialogue: 0,0:12:13.10,0:12:18.07,Default,,0000,0000,0000,,Өйткені, теңіз балдыры
Dialogue: 0,0:12:13.10,0:12:18.07,Default,,0000,0000,0000,,Оңтүстіктен әкелінген.
Dialogue: 0,0:12:13.10,0:12:18.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:18.07,0:12:21.54,Default,,0000,0000,0000,,Қызметшінің куәлігі бойынша
Dialogue: 0,0:12:18.07,0:12:21.54,Default,,0000,0000,0000,,Күйеуім қыста➡
Dialogue: 0,0:12:21.54,0:12:25.04,Default,,0000,0000,0000,,Бұл теңіз балдырын жеу
Dialogue: 0,0:12:21.54,0:12:25.04,Default,,0000,0000,0000,,Жоқ деп айтылды
Dialogue: 0,0:12:21.54,0:12:25.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:25.04,0:12:29.55,Default,,0000,0000,0000,,Аспаздан да
Dialogue: 0,0:12:25.04,0:12:29.55,Default,,0000,0000,0000,,Әдетте пайдаланылады
Dialogue: 0,0:12:25.04,0:12:29.55,Default,,0000,0000,0000,,Теңіз балдырларының бір түрі➡
Dialogue: 0,0:12:29.55,0:12:31.55,Default,,0000,0000,0000,,Ол улы болуы мүмкін емес.
Dialogue: 0,0:12:29.55,0:12:31.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:31.55,0:12:36.12,Default,,0000,0000,0000,,Сол теңіз балдыры улы емес.
Dialogue: 0,0:12:31.55,0:12:36.12,Default,,0000,0000,0000,,Бұл олай емес.
Dialogue: 0,0:12:31.55,0:12:36.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:36.12,0:12:38.56,Default,,0000,0000,0000,,'Біз қазір-ақ бара жатырмыз!
Dialogue: 0,0:12:36.12,0:12:38.56,Default,,0000,0000,0000,,Оңтүстікте
Dialogue: 0,0:12:36.12,0:12:38.56,Default,,0000,0000,0000,,Көп емес➡
Dialogue: 0,0:12:38.56,0:12:42.56,Default,,0000,0000,0000,,Бұл теңіз балдырын жейтін әдет бар.
Dialogue: 0,0:12:38.56,0:12:42.56,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:12:38.56,0:12:42.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:42.56,0:12:48.03,Default,,0000,0000,0000,,Мен бұл асхана шенеунігінің сүйікті тағамы екенін білдім.
Dialogue: 0,0:12:42.56,0:12:48.03,Default,,0000,0000,0000,,Саудагерлер
Dialogue: 0,0:12:42.56,0:12:48.03,Default,,0000,0000,0000,,Мен ақша табады деп ойладым➡
Dialogue: 0,0:12:48.03,0:12:53.54,Default,,0000,0000,0000,,Біз жергілікті тұрғындарға тұздалған балдырларды беру үшін бардық.
Dialogue: 0,0:12:48.03,0:12:53.54,Default,,0000,0000,0000,,Егер мен сізге оны жасауға рұқсат етсем ше?
Dialogue: 0,0:12:53.54,0:12:56.11,Default,,0000,0000,0000,,Осымен
Dialogue: 0,0:12:53.54,0:12:56.11,Default,,0000,0000,0000,,Мәселе неде?
Dialogue: 0,0:12:56.11,0:13:01.05,Default,,0000,0000,0000,,Дүниеде
Dialogue: 0,0:12:56.11,0:13:01.05,Default,,0000,0000,0000,,У улы емес болуы мүмкін.
Dialogue: 0,0:12:56.11,0:13:01.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:01.05,0:13:05.05,Default,,0000,0000,0000,,Мысалы, жыланбалық
Dialogue: 0,0:13:01.05,0:13:05.05,Default,,0000,0000,0000,,Бастапқыда
Dialogue: 0,0:13:01.05,0:13:05.05,Default,,0000,0000,0000,,Ол улы➡
Dialogue: 0,0:13:05.05,0:13:09.05,Default,,0000,0000,0000,,Қан алу немесе оны қыздыру арқылы
Dialogue: 0,0:13:05.05,0:13:09.05,Default,,0000,0000,0000,,Жеуге жарамды болады
Dialogue: 0,0:13:05.05,0:13:09.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:09.05,0:13:11.06,Default,,0000,0000,0000,,Бұл теңіз балдыры жағдайында ➡
Dialogue: 0,0:13:11.06,0:13:14.56,Default,,0000,0000,0000,,Әк суына салып қоюға болады
Dialogue: 0,0:13:11.06,0:13:14.56,Default,,0000,0000,0000,,Қажет болуы керек еді
Dialogue: 0,0:13:11.06,0:13:14.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:14.56,0:13:16.56,Default,,0000,0000,0000,,Мұнда дайындағанымыз➡
Dialogue: 0,0:13:16.56,0:13:21.07,Default,,0000,0000,0000,,Әк суына малынған және
Dialogue: 0,0:13:16.56,0:13:21.07,Default,,0000,0000,0000,,Не емес
Dialogue: 0,0:13:16.56,0:13:21.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:22.17,0:13:24.04,Default,,0000,0000,0000,,(
Dialogue: 0,0:13:22.17,0:13:24.04,Default,,0000,0000,0000,,3 адам
Dialogue: 0,0:13:22.17,0:13:24.04,Default,,0000,0000,0000,,)
Dialogue: 0,0:13:22.17,0:13:24.04,Default,,0000,0000,0000,,Джо!
Dialogue: 0,0:13:22.17,0:13:24.04,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:13:24.04,0:13:26.57,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,0:13:24.04,0:13:26.57,Default,,0000,0000,0000,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:13:24.04,0:13:26.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:26.57,0:13:29.58,Default,,0000,0000,0000,,​​Не болуы мүмкін?
Dialogue: 0,0:13:26.57,0:13:29.58,Default,,0000,0000,0000,,Уайымдамаңыз
Dialogue: 0,0:13:26.57,0:13:29.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:29.58,0:13:32.04,Default,,0000,0000,0000,,Жылауыңды бітірсең, тез арада кел, жарай ма?
Dialogue: 0,0:13:29.58,0:13:32.04,Default,,0000,0000,0000,,Құсуды дұрыс қолданыңыз
Dialogue: 0,0:13:29.58,0:13:32.04,Default,,0000,0000,0000,,Мұнда…
Dialogue: 0,0:13:29.58,0:13:32.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:32.04,0:13:34.05,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:13:32.04,0:13:34.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:32.04,0:13:34.05,Default,,0000,0000,0000,,Оны тым сенімді түрде айтпа!
Dialogue: 0,0:13:34.05,0:13:36.05,Default,,0000,0000,0000,,Гаошун!
Dialogue: 0,0:13:34.05,0:13:36.05,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:13:34.05,0:13:36.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:36.05,0:13:39.08,Default,,0000,0000,0000,,Күте тұрыңыз…
Dialogue: 0,0:13:36.05,0:13:39.08,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:13:36.05,0:13:39.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:36.05,0:13:39.08,Default,,0000,0000,0000,,Түкіріңіз!
Dialogue: 0,0:13:39.08,0:13:41.12,Default,,0000,0000,0000,,Ороророро...!
Dialogue: 0,0:13:41.12,0:13:43.16,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:13:41.12,0:13:43.16,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:13:41.12,0:13:43.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:43.16,0:13:45.56,Default,,0000,0000,0000,,《Бір түндік қарым-қатынас
Dialogue: 0,0:13:43.16,0:13:45.56,Default,,0000,0000,0000,,Оны улы емес етіп жасауға бола ма➡
Dialogue: 0,0:13:45.56,0:13:48.56,Default,,0000,0000,0000,,Мен сені нашар өтірікші деп ойлайтынмын.
Dialogue: 0,0:13:45.56,0:13:48.56,Default,,0000,0000,0000,,Мен оны тексеретін болдым.
Dialogue: 0,0:13:48.56,0:13:51.03,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:13:48.56,0:13:51.03,Default,,0000,0000,0000,,Өзіңізге қамқорлық жасаңыз
Dialogue: 0,0:13:48.56,0:13:51.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:51.03,0:13:53.03,Default,,0000,0000,0000,,Міне, мәселе➡
Dialogue: 0,0:13:53.03,0:13:57.54,Default,,0000,0000,0000,,Саудагерлерге арналған тұздалған балдырлар
Dialogue: 0,0:13:53.03,0:13:57.54,Default,,0000,0000,0000,,Маған әкелуді ұсынған адам ➡ болды
Dialogue: 0,0:13:57.54,0:13:59.54,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:13:59.54,0:14:02.07,Default,,0000,0000,0000,,Мен тапсырыс берген адам болды
Dialogue: 0,0:13:59.54,0:14:02.07,Default,,0000,0000,0000,,Егер сіз оны жеген адам болсаңыз➡
Dialogue: 0,0:14:02.07,0:14:04.61,Default,,0000,0000,0000,,Бір мағынада
Dialogue: 0,0:14:02.07,0:14:04.61,Default,,0000,0000,0000,,Бұл менің кінәм➡
Dialogue: 0,0:14:04.61,0:14:08.55,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:14:04.61,0:14:08.55,Default,,0000,0000,0000,,Егер
Dialogue: 0,0:14:04.61,0:14:08.55,Default,,0000,0000,0000,,Егер жоқ болса...
Dialogue: 0,0:14:04.61,0:14:08.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:08.55,0:14:12.02,Default,,0000,0000,0000,,Тамақтану салты жоқ аймақтардан
Dialogue: 0,0:14:08.55,0:14:12.02,Default,,0000,0000,0000,,Тапсырыс берсеңіз➡
Dialogue: 0,0:14:12.02,0:14:14.52,Default,,0000,0000,0000,,Тәуекелдердің жоғары екені айтпаса да түсінікті.
Dialogue: 0,0:14:12.02,0:14:14.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:14.52,0:14:18.02,Default,,0000,0000,0000,,(
Dialogue: 0,0:14:14.52,0:14:18.02,Default,,0000,0000,0000,,Джинши
Dialogue: 0,0:14:14.52,0:14:18.02,Default,,0000,0000,0000,,:
Dialogue: 0,0:14:14.52,0:14:18.02,Default,,0000,0000,0000,,Масен
Dialogue: 0,0:14:14.52,0:14:18.02,Default,,0000,0000,0000,,)
Dialogue: 0,0:14:14.52,0:14:18.02,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:14.52,0:14:18.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:14.52,0:14:18.02,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:14:14.52,0:14:18.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:18.02,0:14:23.03,Default,,0000,0000,0000,,《Мұның адамдары дана.
Dialogue: 0,0:14:18.02,0:14:23.03,Default,,0000,0000,0000,,Артық айтудың қажеті жоқ.
Dialogue: 0,0:14:23.03,0:14:27.03,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:14:23.03,0:14:27.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:23.03,0:14:27.03,Default,,0000,0000,0000,,《Менің ойымша, мәселе қазір шешілді》
Dialogue: 0,0:14:28.13,0:14:29.57,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:29.57,0:14:31.54,Default,,0000,0000,0000,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:14:29.57,0:14:31.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:31.54,0:14:33.54,Default,,0000,0000,0000,,Жолдан кет! Эй!
Dialogue: 0,0:14:31.54,0:14:33.54,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:14:31.54,0:14:33.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:33.54,0:14:39.08,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:14:33.54,0:14:39.08,Default,,0000,0000,0000,,Кінәлі
Dialogue: 0,0:14:33.54,0:14:39.08,Default,,0000,0000,0000,,Ол қаза тапқан шенеуніктің інісі болатын.
Dialogue: 0,0:14:33.54,0:14:39.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:39.08,0:14:44.05,Default,,0000,0000,0000,,Сатып алушыны тапқаннан кейін
Dialogue: 0,0:14:39.08,0:14:44.05,Default,,0000,0000,0000,,Ол оны сатып алғанын мойындаған сияқты.
Dialogue: 0,0:14:39.08,0:14:44.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:46.12,0:14:50.06,Default,,0000,0000,0000,,Мотив
Dialogue: 0,0:14:46.12,0:14:50.06,Default,,0000,0000,0000,,Екінші ұлым
Dialogue: 0,0:14:46.12,0:14:50.06,Default,,0000,0000,0000,,Елеусіз болу➡
Dialogue: 0,0:14:50.06,0:14:53.06,Default,,0000,0000,0000,,Менің үлкен ұлым
Dialogue: 0,0:14:50.06,0:14:53.06,Default,,0000,0000,0000,,Шамасы, ол бұл жайсыздық деп ойлағандықтан болса керек.
Dialogue: 0,0:14:50.06,0:14:53.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:53.06,0:14:55.06,Default,,0000,0000,0000,,Бұл қарапайым әңгіме.
Dialogue: 0,0:14:53.06,0:14:55.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:55.06,0:15:00.03,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:14:55.06,0:15:00.03,Default,,0000,0000,0000,,Осындай таяз себеппен
Dialogue: 0,0:14:55.06,0:15:00.03,Default,,0000,0000,0000,,Кісі өлтірмекші болған адам➡
Dialogue: 0,0:15:00.03,0:15:03.57,Default,,0000,0000,0000,,тіпті Эден кампусында да — қайдағы қырағы көздердің қашан қарап тұрғанын білмейсің.
Dialogue: 0,0:15:00.03,0:15:03.57,Default,,0000,0000,0000,,Теңіз балдырының улы екенін білген болуыңыз керек.
Dialogue: 0,0:15:00.03,0:15:03.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:03.57,0:15:08.64,Default,,0000,0000,0000,,Барда жанымда отырған тұтынушыдан
Dialogue: 0,0:15:03.57,0:15:08.64,Default,,0000,0000,0000,,Уа! Ах, ах, ах! (Цубаки) Хмм!—
Dialogue: 0,0:15:03.57,0:15:08.64,Default,,0000,0000,0000,,Шамасы, оны оқытқан
Dialogue: 0,0:15:03.57,0:15:08.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:08.64,0:15:12.14,Default,,0000,0000,0000,,Қандай кездейсоқтық...
Dialogue: 0,0:15:08.64,0:15:12.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:16.05,0:15:21.05,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:15:16.05,0:15:21.05,Default,,0000,0000,0000,,Улы болып қалатын теңіз балдыры
Dialogue: 0,0:15:16.05,0:15:21.05,Default,,0000,0000,0000,,Мен оны жей алмадым.
Dialogue: 0,0:15:16.05,0:15:21.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:21.05,0:15:24.06,Default,,0000,0000,0000,,《Оны бәрібір не үшін пайдалануым керек?》
Dialogue: 0,0:15:24.06,0:15:28.56,Default,,0000,0000,0000,,《Ол сол кепкен жәндіктен шыққан.
Dialogue: 0,0:15:24.06,0:15:28.56,Default,,0000,0000,0000,,Өлі жапырақ түсті саңырауқұлақ》
Dialogue: 0,0:15:28.56,0:15:32.60,Default,,0000,0000,0000,,《Дәрілік шарап жасаймыз ба?
Dialogue: 0,0:15:28.56,0:15:32.60,Default,,0000,0000,0000,,Мен оны таблеткаға айналдырамын ба?
Dialogue: 0,0:15:32.60,0:15:35.13,Default,,0000,0000,0000,,Сондықтан мен сол болашақты өзгерту үшін өткенге ораламын.
Dialogue: 0,0:15:32.60,0:15:35.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:35.13,0:15:36.17,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:15:35.13,0:15:36.17,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:36.17,0:15:38.64,Default,,0000,0000,0000,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:15:36.17,0:15:38.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:38.64,0:15:40.64,Default,,0000,0000,0000,,｟Қош келдіңіз...
Dialogue: 0,0:15:38.64,0:15:40.64,Default,,0000,0000,0000,,Масе｠
Dialogue: 0,0:15:40.64,0:15:43.14,Default,,0000,0000,0000,,｟Масе
Dialogue: 0,0:15:40.64,0:15:43.14,Default,,0000,0000,0000,,Масе
Dialogue: 0,0:15:40.64,0:15:43.14,Default,,0000,0000,0000,,Масе…｠
Dialogue: 0,0:15:46.55,0:15:49.58,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:46.55,0:15:49.58,Default,,0000,0000,0000,,Басты соққан дыбыс
Dialogue: 0,0:15:46.55,0:15:49.58,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:46.55,0:15:49.58,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:15:49.58,0:15:52.15,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:49.58,0:15:52.15,Default,,0000,0000,0000,,Басты соққан дыбыс
Dialogue: 0,0:15:49.58,0:15:52.15,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:49.58,0:15:52.15,Default,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,0:15:52.15,0:15:54.62,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:52.15,0:15:54.62,Default,,0000,0000,0000,,Басты соққан дыбыс
Dialogue: 0,0:15:52.15,0:15:54.62,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:52.15,0:15:54.62,Default,,0000,0000,0000,,《Бұл менің кінәм
Dialogue: 0,0:15:52.15,0:15:54.62,Default,,0000,0000,0000,,Жоқ》
Dialogue: 0,0:15:56.56,0:16:00.06,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:15:56.56,0:16:00.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:56.56,0:16:00.06,Default,,0000,0000,0000,,Сіз шаршаған сияқтысыз.
Dialogue: 0,0:15:56.56,0:16:00.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:00.06,0:16:02.53,Default,,0000,0000,0000,,Менің көп жұмысым бар➡
Dialogue: 0,0:16:02.53,0:16:04.53,Default,,0000,0000,0000,,Әйтеуір
Dialogue: 0,0:16:02.53,0:16:04.53,Default,,0000,0000,0000,,Менде араласпайтын адам бар➡
Dialogue: 0,0:16:04.53,0:16:07.03,Default,,0000,0000,0000,,Пікірлер әртүрлі.
Dialogue: 0,0:16:04.53,0:16:07.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:07.03,0:16:11.57,Default,,0000,0000,0000,,Сондай-ақ Джинджи мырзаға
Dialogue: 0,0:16:07.03,0:16:11.57,Default,,0000,0000,0000,,Кейбір адамдар бұл іспен айналыспайды.
Dialogue: 0,0:16:07.03,0:16:11.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:11.57,0:16:15.64,Default,,0000,0000,0000,,Қарсылас – зерделі әскери шенеунік.
Dialogue: 0,0:16:11.57,0:16:15.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:15.64,0:16:20.05,Default,,0000,0000,0000,,Мен жақсы отбасынан шыққаныма қарамастан
Dialogue: 0,0:16:15.64,0:16:20.05,Default,,0000,0000,0000,,40-тан асқан және әйелі жоқ➡
Dialogue: 0,0:16:20.05,0:16:26.05,Default,,0000,0000,0000,,Ойго
Dialogue: 0,0:16:20.05,0:16:26.05,Default,,0000,0000,0000,,Жиенімді асырап алу
Dialogue: 0,0:16:20.05,0:16:26.05,Default,,0000,0000,0000,,Үйді басқару
Dialogue: 0,0:16:20.05,0:16:26.05,Default,,0000,0000,0000,,Ол әйгілі оғаш адам.
Dialogue: 0,0:16:20.05,0:16:26.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:26.05,0:16:31.06,Default,,0000,0000,0000,,《Қырықтан өткен
Dialogue: 0,0:16:26.05,0:16:31.06,Default,,0000,0000,0000,,Жоғары лауазымды әскери шенеунік...
Dialogue: 0,0:16:26.05,0:16:31.06,Default,,0000,0000,0000,,Біртүрлі? 》
Dialogue: 0,0:16:31.06,0:16:37.13,Default,,0000,0000,0000,,Мені қызықтыратын нәрселер туралы айтатын болсақ,
Dialogue: 0,0:16:31.06,0:16:37.13,Default,,0000,0000,0000,,Тек қана
Dialogue: 0,0:16:31.06,0:16:37.13,Default,,0000,0000,0000,,Бар, Шоги және Өсек
Dialogue: 0,0:16:31.06,0:16:37.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:37.13,0:16:40.13,Default,,0000,0000,0000,,Егер сіз қиындық тудырсаңыз, олар сізге шабуыл жасайды➡
Dialogue: 0,0:16:40.13,0:16:43.57,Default,,0000,0000,0000,,Істі шешу
Dialogue: 0,0:16:40.13,0:16:43.57,Default,,0000,0000,0000,,Кейінге қалдыру
Dialogue: 0,0:16:40.13,0:16:43.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:43.57,0:16:47.07,Default,,0000,0000,0000,,Мен нысанаға алынған сияқтымын.
Dialogue: 0,0:16:43.57,0:16:47.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:47.07,0:16:51.04,Default,,0000,0000,0000,,Бұл күндері
Dialogue: 0,0:16:47.07,0:16:51.04,Default,,0000,0000,0000,,Күн сайын
Dialogue: 0,0:16:47.07,0:16:51.04,Default,,0000,0000,0000,,Мен кеңседе отырдым...
Dialogue: 0,0:16:47.07,0:16:51.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:52.54,0:16:54.55,Default,,0000,0000,0000,,《Жарайды
Dialogue: 0,0:16:52.54,0:16:54.55,Default,,0000,0000,0000,,Ұмытайық》
Dialogue: 0,0:16:54.55,0:16:57.05,Default,,0000,0000,0000,,《Есімде болса да
Dialogue: 0,0:16:54.55,0:16:57.05,Default,,0000,0000,0000,,Бұл жақсы нәрсе болмайды》
Dialogue: 0,0:16:57.05,0:16:59.62,Default,,0000,0000,0000,,(
Dialogue: 0,0:16:57.05,0:16:59.62,Default,,0000,0000,0000,,Алыстағы найзағай
Dialogue: 0,0:16:57.05,0:16:59.62,Default,,0000,0000,0000,,)
Dialogue: 0,0:16:59.62,0:17:03.16,Default,,0000,0000,0000,,《Алайда
Dialogue: 0,0:16:59.62,0:17:03.16,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:16:59.62,0:17:03.16,Default,,0000,0000,0000,,Мен ұмытқанда➡
Dialogue: 0,0:17:03.16,0:17:06.06,Default,,0000,0000,0000,,Әдеттегі жағымсыз сезім
Dialogue: 0,0:17:03.16,0:17:06.06,Default,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:17:06.06,0:17:09.06,Default,,0000,0000,0000,,Бұл жағдай
Dialogue: 0,0:17:06.06,0:17:09.06,Default,,0000,0000,0000,,Сіз әлдеқашан өтуіңіз керек еді...
Dialogue: 0,0:17:06.06,0:17:09.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:09.06,0:17:14.53,Default,,0000,0000,0000,,Қыста шие гүлін көру қиын
Dialogue: 0,0:17:09.06,0:17:14.53,Default,,0000,0000,0000,,алып ағаштар орманға жүгіріп кірді
Dialogue: 0,0:17:09.06,0:17:14.53,Default,,0000,0000,0000,,Мен бұл жерде деп ойладым.
Dialogue: 0,0:17:09.06,0:17:14.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:14.53,0:17:19.04,Default,,0000,0000,0000,,《Бұл кісінің аты Архат
Dialogue: 0,0:17:14.53,0:17:19.04,Default,,0000,0000,0000,,Ол тактик》
Dialogue: 0,0:17:19.04,0:17:22.07,Default,,0000,0000,0000,,《Шамасы
Dialogue: 0,0:17:19.04,0:17:22.07,Default,,0000,0000,0000,,Адамдардың маған шабуыл жасауының себебі➡
Dialogue: 0,0:17:22.07,0:17:27.05,Default,,0000,0000,0000,,Риокусейканға қосылған мысықтар мен мысықтар
Dialogue: 0,0:17:22.07,0:17:27.05,Default,,0000,0000,0000,,Ол қызметші қызға айналдырылғандықтан болса керек》
Dialogue: 0,0:17:27.05,0:17:32.05,Default,,0000,0000,0000,,Ойланып көрейікші
Dialogue: 0,0:17:27.05,0:17:32.05,Default,,0000,0000,0000,,Рёкусейканға
Dialogue: 0,0:17:27.05,0:17:32.05,Default,,0000,0000,0000,,Баяғыда
Dialogue: 0,0:17:27.05,0:17:32.05,Default,,0000,0000,0000,,Сізге таныс сияқтысыз.
Dialogue: 0,0:17:27.05,0:17:32.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:32.05,0:17:34.05,Default,,0000,0000,0000,,《Таңқаларлық оқиға》
Dialogue: 0,0:17:34.05,0:17:37.56,Default,,0000,0000,0000,,《Иллюстрация және т.б.
Dialogue: 0,0:17:34.05,0:17:37.56,Default,,0000,0000,0000,,Мүлдем емес
Dialogue: 0,0:17:34.05,0:17:37.56,Default,,0000,0000,0000,,Мен сізді қызықтырмайды деп ойладым.
Dialogue: 0,0:17:37.56,0:17:40.06,Default,,0000,0000,0000,,Ол қандай жезөкше?
Dialogue: 0,0:17:40.06,0:17:41.56,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:17:40.06,0:17:41.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:41.56,0:17:44.13,Default,,0000,0000,0000,,《Аа...
Dialogue: 0,0:17:41.56,0:17:44.13,Default,,0000,0000,0000,,Мен оны жаңа ғана естідім》
Dialogue: 0,0:17:44.13,0:17:48.07,Default,,0000,0000,0000,,Ол жақсы жезөкше болған.
Dialogue: 0,0:17:44.13,0:17:48.07,Default,,0000,0000,0000,,Go және Shogi➡ жақсы
Dialogue: 0,0:17:48.07,0:17:52.57,Default,,0000,0000,0000,,Мен шогиде жеңе аламын, бірақ
Dialogue: 0,0:17:48.07,0:17:52.57,Default,,0000,0000,0000,,Мен Go-да жеңіліп жүрдім.
Dialogue: 0,0:17:48.07,0:17:52.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:52.57,0:17:57.04,Default,,0000,0000,0000,,Әскери қолбасшыны жеңу деген нені білдіреді?
Dialogue: 0,0:17:52.57,0:17:57.04,Default,,0000,0000,0000,,Бұл күшті болған болуы керек.
Dialogue: 0,0:17:52.57,0:17:57.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:57.04,0:18:02.05,Default,,0000,0000,0000,,Осындай қызықты әйел үшін
Dialogue: 0,0:17:57.04,0:18:02.05,Default,,0000,0000,0000,,Мен сені енді ешқашан көрмеймін деп ойладым➡
Dialogue: 0,0:18:02.05,0:18:08.15,Default,,0000,0000,0000,,Мен төлем туралы ойладым.
Dialogue: 0,0:18:02.05,0:18:08.15,Default,,0000,0000,0000,,Дүние
Dialogue: 0,0:18:02.05,0:18:08.15,Default,,0000,0000,0000,,Бұл жақсы жүрмейтін нәрсе.
Dialogue: 0,0:18:02.05,0:18:08.15,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:08.15,0:18:11.56,Default,,0000,0000,0000,,Заттарды ұнататын екі бай➡
Dialogue: 0,0:18:11.56,0:18:14.56,Default,,0000,0000,0000,,Бәсекелес
Dialogue: 0,0:18:11.56,0:18:14.56,Default,,0000,0000,0000,,Шамадан тыс бағалар
Dialogue: 0,0:18:11.56,0:18:14.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:14.56,0:18:16.56,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:18:14.56,0:18:16.56,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:18:14.56,0:18:16.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:16.56,0:18:19.06,Default,,0000,0000,0000,,《Кейде жезөкшелер үшін төлем ақша➡
Dialogue: 0,0:18:19.06,0:18:22.03,Default,,0000,0000,0000,,Вилла салуға жеткілікті.
Dialogue: 0,0:18:19.06,0:18:22.03,Default,,0000,0000,0000,,Наруто》
Dialogue: 0,0:18:22.03,0:18:25.07,Default,,0000,0000,0000,,Эксцентрик жезөкше бол.
Dialogue: 0,0:18:22.03,0:18:25.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:25.07,0:18:29.14,Default,,0000,0000,0000,,《Алайда
Dialogue: 0,0:18:25.07,0:18:29.14,Default,,0000,0000,0000,,Осылай сөйле
Dialogue: 0,0:18:25.07,0:18:29.14,Default,,0000,0000,0000,,Не айтқыңыз келеді?
Dialogue: 0,0:18:29.14,0:18:32.04,Default,,0000,0000,0000,,Өнер жақсы сатылады
Dialogue: 0,0:18:29.14,0:18:32.04,Default,,0000,0000,0000,,Өзіңді сатпа
Dialogue: 0,0:18:29.14,0:18:32.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:32.04,0:18:36.05,Default,,0000,0000,0000,,Негізі, мен оларды қонақ ретінде де ойламаймын.
Dialogue: 0,0:18:32.04,0:18:36.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:36.05,0:18:38.05,Default,,0000,0000,0000,,Тұтынушыға
Dialogue: 0,0:18:36.05,0:18:38.05,Default,,0000,0000,0000,,Тіпті шай құйып жатқанда➡
Dialogue: 0,0:18:38.05,0:18:43.52,Default,,0000,0000,0000,,Сен менің бір жақты әңгімемді тыңдадың…
Dialogue: 0,0:18:38.05,0:18:43.52,Default,,0000,0000,0000,,Төмен адамдарға садақа беру сияқты.
Dialogue: 0,0:18:38.05,0:18:43.52,Default,,0000,0000,0000,,Мен саған тәкаппар көзбен қарадым.
Dialogue: 0,0:18:38.05,0:18:43.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:43.52,0:18:49.09,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,0:18:43.52,0:18:49.09,Default,,0000,0000,0000,,Юкине-кун, барсың ба?
Dialogue: 0,0:18:43.52,0:18:49.09,Default,,0000,0000,0000,,Депрессиядан арылыңыз
Dialogue: 0,0:18:43.52,0:18:49.09,Default,,0000,0000,0000,,Заттарды ұнататындар да бар.
Dialogue: 0,0:18:43.52,0:18:49.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:49.09,0:18:52.13,Default,,0000,0000,0000,,Мұны мен де айтамын
Dialogue: 0,0:18:49.09,0:18:52.13,Default,,0000,0000,0000,,Мен солардың бірімін➡
Dialogue: 0,0:18:52.13,0:18:57.10,Default,,0000,0000,0000,,Мен омыртқаның шаншып жатқанын сеземін.
Dialogue: 0,0:18:52.13,0:18:57.10,Default,,0000,0000,0000,,Төзгісіз болыңыз
Dialogue: 0,0:18:52.13,0:18:57.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:59.07,0:19:05.04,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:18:59.07,0:19:05.04,Default,,0000,0000,0000,,Мен сені бір күні төмен түсіргім келеді
Dialogue: 0,0:18:59.07,0:19:05.04,Default,,0000,0000,0000,,Мен осылай ойладым.
Dialogue: 0,0:18:59.07,0:19:05.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:05.04,0:19:08.05,Default,,0000,0000,0000,,Аспаз аспаз Аспаз…
Dialogue: 0,0:19:05.04,0:19:08.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:08.05,0:19:11.05,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:19:08.05,0:19:11.05,Default,,0000,0000,0000,,Мен ол жезөкшеден бас тарта алмаймын➡
Dialogue: 0,0:19:11.05,0:19:14.59,Default,,0000,0000,0000,,Көңілсіз
Dialogue: 0,0:19:11.05,0:19:14.59,Default,,0000,0000,0000,,Мен лас қолдарды қолдандым.
Dialogue: 0,0:19:11.05,0:19:14.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:14.59,0:19:16.12,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:19:16.12,0:19:21.06,Default,,0000,0000,0000,,Егер ол тым қымбат болса және сіз оны сатып ала алмасаңыз
Dialogue: 0,0:19:16.12,0:19:21.06,Default,,0000,0000,0000,,Ол арзанырақ болса, ешқандай проблема жоқ➡
Dialogue: 0,0:19:21.06,0:19:25.56,Default,,0000,0000,0000,,Бұл тапшылық мәнін төмендетті.
Dialogue: 0,0:19:21.06,0:19:25.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:25.56,0:19:29.57,Default,,0000,0000,0000,,Қалай екенін білгіңіз келе ме?
Dialogue: 0,0:19:29.57,0:19:32.54,Default,,0000,0000,0000,,Осы уақытқа дейін кел
Dialogue: 0,0:19:29.57,0:19:32.54,Default,,0000,0000,0000,,Тым қымбат па?
Dialogue: 0,0:19:32.54,0:19:34.04,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:19:32.54,0:19:34.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:37.61,0:19:42.58,Default,,0000,0000,0000,,Хмм…
Dialogue: 0,0:19:37.61,0:19:42.58,Default,,0000,0000,0000,,Жарайды…
Dialogue: 0,0:19:37.61,0:19:42.58,Default,,0000,0000,0000,,Бұл қандай жаман иіс?
Dialogue: 0,0:19:37.61,0:19:42.58,Default,,0000,0000,0000,,Біраз
Dialogue: 0,0:19:37.61,0:19:42.58,Default,,0000,0000,0000,,Менің сенен сұрайтыным бар.
Dialogue: 0,0:19:37.61,0:19:42.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:42.58,0:19:45.55,Default,,0000,0000,0000,,Не ол?
Dialogue: 0,0:19:42.58,0:19:45.55,Default,,0000,0000,0000,,Мәңгілік шың тек менікі
Dialogue: 0,0:19:42.58,0:19:45.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:45.55,0:19:48.55,Default,,0000,0000,0000,,Сол жерде
Dialogue: 0,0:19:45.55,0:19:48.55,Default,,0000,0000,0000,,Жақында қосылған қызметші қыз➡
Dialogue: 0,0:19:48.55,0:19:51.06,Default,,0000,0000,0000,,Өте қызықты көрінеді
Dialogue: 0,0:19:48.55,0:19:51.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:51.06,0:19:54.06,Default,,0000,0000,0000,,Сіз жұмбақтарды шешуде біртүрлі шебер сияқтысыз.
Dialogue: 0,0:19:51.06,0:19:54.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:54.06,0:19:56.06,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:19:54.06,0:19:56.06,Default,,0000,0000,0000,,Хмм
Dialogue: 0,0:19:54.06,0:19:56.06,Default,,0000,0000,0000,,Ммм
Dialogue: 0,0:19:54.06,0:19:56.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:56.06,0:20:02.53,Default,,0000,0000,0000,,Ах~
Dialogue: 0,0:19:56.06,0:20:02.53,Default,,0000,0000,0000,,Менің бір досым бар, ол сотқа жеткізуші болып табылады.
Dialogue: 0,0:19:56.06,0:20:02.53,Default,,0000,0000,0000,,Металл оюшы болды.
Dialogue: 0,0:19:56.06,0:20:02.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:02.53,0:20:05.54,Default,,0000,0000,0000,,Бұл басқа күні болды
Dialogue: 0,0:20:02.53,0:20:05.54,Default,,0000,0000,0000,,Ол кенеттен қайтыс болды.
Dialogue: 0,0:20:02.53,0:20:05.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:05.54,0:20:09.58,Default,,0000,0000,0000,,Дұрыс
Dialogue: 0,0:20:05.54,0:20:09.58,Default,,0000,0000,0000,,Мұрагерді атамай-ақ.
Dialogue: 0,0:20:05.54,0:20:09.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:09.58,0:20:13.05,Default,,0000,0000,0000,,Оның үш баласы бар.
Dialogue: 0,0:20:09.58,0:20:13.05,Default,,0000,0000,0000,,Мен оны шәкірт ретінде алдым➡
Dialogue: 0,0:20:13.05,0:20:18.58,Default,,0000,0000,0000,,Құпия техниканы бермей
Dialogue: 0,0:20:13.05,0:20:18.58,Default,,0000,0000,0000,,Фубин
Dialogue: 0,0:20:13.05,0:20:18.58,Default,,0000,0000,0000,,Мен оның өмірден өткеніне өкінемін.
Dialogue: 0,0:20:13.05,0:20:18.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:18.58,0:20:24.56,Default,,0000,0000,0000,,Мен оның ұсыныс жасайтынына сенімдімін
Dialogue: 0,0:20:18.58,0:20:24.56,Default,,0000,0000,0000,,Менің ойымша, бұл түсініктеме.
Dialogue: 0,0:20:18.58,0:20:24.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:24.56,0:20:28.06,Default,,0000,0000,0000,,Бұлай емес сияқты.
Dialogue: 0,0:20:24.56,0:20:28.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:28.06,0:20:30.56,Default,,0000,0000,0000,,Сіз не айтқыңыз келеді?
Dialogue: 0,0:20:28.06,0:20:30.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:30.56,0:20:34.03,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:20:30.56,0:20:34.03,Default,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:20:30.56,0:20:34.03,Default,,0000,0000,0000,,Бұл үлкен мәселе емес
Dialogue: 0,0:20:30.56,0:20:34.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:34.03,0:20:39.07,Default,,0000,0000,0000,,Құпия техниканы қалай білуге болады
Dialogue: 0,0:20:34.03,0:20:39.07,Default,,0000,0000,0000,,Мен бар ма деп ойладым.
Dialogue: 0,0:20:34.03,0:20:39.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:39.07,0:20:42.11,Default,,0000,0000,0000,,Ах~
Dialogue: 0,0:20:39.07,0:20:42.11,Default,,0000,0000,0000,,Мысалы…➡
Dialogue: 0,0:20:42.11,0:20:48.11,Default,,0000,0000,0000,,Жылдам ойлау
Dialogue: 0,0:20:42.11,0:20:48.11,Default,,0000,0000,0000,,Сіздің күңіңіз
Dialogue: 0,0:20:42.11,0:20:48.11,Default,,0000,0000,0000,,Менің ойымша, сіз оны қарастыра аласыз ба?
Dialogue: 0,0:20:42.11,0:20:48.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:50.55,0:20:54.09,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:20:50.55,0:20:54.09,Default,,0000,0000,0000,,Әзірге➡
Dialogue: 0,0:20:54.09,0:20:57.06,Default,,0000,0000,0000,,Бір оқиға
Dialogue: 0,0:20:54.09,0:20:57.06,Default,,0000,0000,0000,,Маған хабарлай аласыз ба?
Dialogue: 0,0:20:54.09,0:20:57.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:04.06,0:21:06.53,Default,,0000,0000,0000,,Жаңбыр көп жауады.
Dialogue: 0,0:21:04.06,0:21:06.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:10.14,0:21:30.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:30.06,0:21:50.54,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:50.54,0:21:54.55,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:54.55,0:22:14.57,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:14.57,0:22:36.12,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:36.12,0:22:39.09,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡