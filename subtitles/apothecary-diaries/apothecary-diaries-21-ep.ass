Dialogue: 0,0:01:58.55,0:02:03.06,Default,,0000,0000,0000,,Корольдік медициналық кеңседе
Dialogue: 0,0:01:58.55,0:02:03.06,Default,,0000,0000,0000,,Дәрі-дәрмекті жеткіліксіз басқаруға байланысты➡
Dialogue: 0,0:02:03.06,0:02:06.56,Default,,0000,0000,0000,,Кейбір медицина қызметкерлері жалақыларын қысқарту арқылы жазаланды.
Dialogue: 0,0:02:03.06,0:02:06.56,Default,,0000,0000,0000,,Біреу бар деп естідім бе?
Dialogue: 0,0:02:06.56,0:02:07.69,Default,,0000,0000,0000,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,0:02:07.69,0:02:09.56,Default,,0000,0000,0000,,｟Ня~｠
Dialogue: 0,0:02:07.69,0:02:09.56,Default,,0000,0000,0000,,｟Сәлем~｠
Dialogue: 0,0:02:09.56,0:02:13.10,Default,,0000,0000,0000,,Тым ылғалды болмай тұрып
Dialogue: 0,0:02:09.56,0:02:13.10,Default,,0000,0000,0000,,Мен оны тазалауым керек➡
Dialogue: 0,0:02:13.10,0:02:15.13,Default,,0000,0000,0000,,Бұл кейінгі фестиваль.
Dialogue: 0,0:02:13.10,0:02:15.13,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:15.13,0:02:17.14,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:02:15.13,0:02:17.14,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:17.14,0:02:24.04,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:24.04,0:02:27.55,Default,,0000,0000,0000,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:02:24.04,0:02:27.55,Default,,0000,0000,0000,,Ақыры қоныстанды
Dialogue: 0,0:02:24.04,0:02:27.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:27.55,0:02:31.55,Default,,0000,0000,0000,,Өйткені, шаршаған кезде тәтті болады.
Dialogue: 0,0:02:27.55,0:02:31.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:31.55,0:02:34.55,Default,,0000,0000,0000,,《Бұл қарт
Dialogue: 0,0:02:31.55,0:02:34.55,Default,,0000,0000,0000,,Ол өте құрғақ》
Dialogue: 0,0:02:34.55,0:02:38.53,Default,,0000,0000,0000,,《Осы маусымда қолжетімді емес.
Dialogue: 0,0:02:34.55,0:02:38.53,Default,,0000,0000,0000,,Дәл сол тәтті картопқа да қатысты➡
Dialogue: 0,0:02:38.53,0:02:41.59,Default,,0000,0000,0000,,Әдеттегідей қағазды табаққа салыңыз...》
Dialogue: 0,0:02:41.59,0:02:43.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:43.13,0:02:45.06,Default,,0000,0000,0000,,Жақсы қағаз
Dialogue: 0,0:02:43.13,0:02:45.06,Default,,0000,0000,0000,,Мен оны қолданамын.
Dialogue: 0,0:02:43.13,0:02:45.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:45.06,0:02:47.07,Default,,0000,0000,0000,,О
Dialogue: 0,0:02:45.06,0:02:47.07,Default,,0000,0000,0000,,Түсінесіз бе?
Dialogue: 0,0:02:47.07,0:02:51.07,Default,,0000,0000,0000,,Менің ата-анамның отбасы ауылды ұйымдастырды.
Dialogue: 0,0:02:47.07,0:02:51.07,Default,,0000,0000,0000,,Мен жасап жатырмын.
Dialogue: 0,0:02:47.07,0:02:51.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:51.07,0:02:54.07,Default,,0000,0000,0000,,Ол императорлық соттың жеткізушісі.
Dialogue: 0,0:02:51.07,0:02:54.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:54.07,0:02:57.58,Default,,0000,0000,0000,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:02:54.07,0:02:57.58,Default,,0000,0000,0000,,оның қазір қайда екенін немесе не істеп жатқанын білуге рұқсат жоқ па? Тіпті соны да білмейміз бе?
Dialogue: 0,0:02:54.07,0:02:57.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:02:57.58,0:03:01.08,Default,,0000,0000,0000,,《Танысу бағасымен
Dialogue: 0,0:02:57.58,0:03:01.08,Default,,0000,0000,0000,,Сіз оны арзандата аласыз ба?》
Dialogue: 0,0:03:01.08,0:03:05.55,Default,,0000,0000,0000,,Бұрын сіз неғұрлым көп жасасаңыз, соғұрлым көп
Dialogue: 0,0:03:01.08,0:03:05.55,Default,,0000,0000,0000,,Мен пайда таптым
Dialogue: 0,0:03:01.08,0:03:05.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:07.55,0:03:10.52,Default,,0000,0000,0000,,Сондай-ақ басқа елдерде
Dialogue: 0,0:03:07.55,0:03:10.52,Default,,0000,0000,0000,,Көбірек экспорттау➡
Dialogue: 0,0:03:10.52,0:03:15.56,Default,,0000,0000,0000,,Бала кезімде
Dialogue: 0,0:03:10.52,0:03:15.56,Default,,0000,0000,0000,,Сүйікті тәттілер
Dialogue: 0,0:03:10.52,0:03:15.56,Default,,0000,0000,0000,,Сіз маған кез келген нәрсені сатып ала аласыз.
Dialogue: 0,0:03:10.52,0:03:15.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:15.56,0:03:20.57,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:03:15.56,0:03:20.57,Default,,0000,0000,0000,,Марқұм императордың анасы
Dialogue: 0,0:03:15.56,0:03:20.57,Default,,0000,0000,0000,,Ағаштарды кесуге тыйым салынғаннан кейін➡
Dialogue: 0,0:03:20.57,0:03:23.57,Default,,0000,0000,0000,,Істері жақсы болмады.
Dialogue: 0,0:03:20.57,0:03:23.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:23.57,0:03:27.61,Default,,0000,0000,0000,,Егер сіз оны басқа материалмен жасай бастасаңыз
Dialogue: 0,0:03:23.57,0:03:27.61,Default,,0000,0000,0000,,Сауда да нашарлады➡
Dialogue: 0,0:03:27.61,0:03:31.04,Default,,0000,0000,0000,,Біздің отбасымызды кінәлады.
Dialogue: 0,0:03:27.61,0:03:31.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:31.04,0:03:35.52,Default,,0000,0000,0000,,Оның алдында тұрған ештеңе жоқ.
Dialogue: 0,0:03:31.04,0:03:35.52,Default,,0000,0000,0000,,Менің әпкем ішкі сарайға барды.
Dialogue: 0,0:03:31.04,0:03:35.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:35.52,0:03:40.55,Default,,0000,0000,0000,,Тіпті әпкем барамын деді.
Dialogue: 0,0:03:35.52,0:03:40.55,Default,,0000,0000,0000,,Оның орнына мен мұнда келдім.
Dialogue: 0,0:03:35.52,0:03:40.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:40.55,0:03:45.06,Default,,0000,0000,0000,,Канган
Dialogue: 0,0:03:40.55,0:03:45.06,Default,,0000,0000,0000,,Дарындылығы аз эбнухтар жақсырақ
Dialogue: 0,0:03:40.55,0:03:45.06,Default,,0000,0000,0000,,Ол жоғары бағаға сатылды.
Dialogue: 0,0:03:40.55,0:03:45.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:45.06,0:03:48.63,Default,,0000,0000,0000,,Өйткені
Dialogue: 0,0:03:45.06,0:03:48.63,Default,,0000,0000,0000,,Менің әпкем кім?
Dialogue: 0,0:03:45.06,0:03:48.63,Default,,0000,0000,0000,,Кешіріңіз, біз әлі кездескен жоқпыз.
Dialogue: 0,0:03:45.06,0:03:48.63,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:48.63,0:03:52.57,Default,,0000,0000,0000,,《Мм...
Dialogue: 0,0:03:48.63,0:03:52.57,Default,,0000,0000,0000,,Менің ойымша, мен ойлағаннан да қиынырақ болдым.
Dialogue: 0,0:03:52.57,0:03:56.17,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:03:52.57,0:03:56.17,Default,,0000,0000,0000,,А...
Dialogue: 0,0:03:52.57,0:03:56.17,Default,,0000,0000,0000,,.
Dialogue: 0,0:03:56.17,0:03:57.57,Default,,0000,0000,0000,,Пейлин
Dialogue: 0,0:03:56.17,0:03:57.57,Default,,0000,0000,0000,,(
Dialogue: 0,0:03:56.17,0:03:57.57,Default,,0000,0000,0000,,Ақ қоңырау
Dialogue: 0,0:03:56.17,0:03:57.57,Default,,0000,0000,0000,,)
Dialogue: 0,0:03:56.17,0:03:57.57,Default,,0000,0000,0000,,｟Уфу｠
Dialogue: 0,0:03:57.57,0:03:59.57,Default,,0000,0000,0000,,Уау!!
Dialogue: 0,0:04:01.07,0:04:03.04,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:04:01.07,0:04:03.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:03.04,0:04:05.61,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:04:03.04,0:04:05.61,Default,,0000,0000,0000,,Тазалауды жалғастыру...
Dialogue: 0,0:04:03.04,0:04:05.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:05.61,0:04:07.68,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:04:05.61,0:04:07.68,Default,,0000,0000,0000,,Мисс-чан?
Dialogue: 0,0:04:05.61,0:04:07.68,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:07.68,0:04:09.15,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:10.62,0:04:16.56,Default,,0000,0000,0000,,Әпкемнің хаты
Dialogue: 0,0:04:10.62,0:04:16.56,Default,,0000,0000,0000,,Біздің қағаз үкіметке жеткізуші болып табылады.
Dialogue: 0,0:04:10.62,0:04:16.56,Default,,0000,0000,0000,,Ол жоғалып кетуі мүмкін
Dialogue: 0,0:04:10.62,0:04:16.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:16.56,0:04:21.06,Default,,0000,0000,0000,,《Бұл әрине рас
Dialogue: 0,0:04:16.56,0:04:21.06,Default,,0000,0000,0000,,Патша сарайына сату жеткілікті жақсы емес.
Dialogue: 0,0:04:21.06,0:04:23.60,Default,,0000,0000,0000,,《Тасушы дегеніміз не?
Dialogue: 0,0:04:21.06,0:04:23.60,Default,,0000,0000,0000,,Жабысып қала ма, жоқ па маңызды емес ➡
Dialogue: 0,0:04:23.60,0:04:26.17,Default,,0000,0000,0000,,Сатылым айтарлықтай өзгереді》
Dialogue: 0,0:04:26.17,0:04:29.57,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:04:26.17,0:04:29.57,Default,,0000,0000,0000,,Үлкен күшпен
Dialogue: 0,0:04:26.17,0:04:29.57,Default,,0000,0000,0000,,Қосымша
Dialogue: 0,0:04:26.17,0:04:29.57,Default,,0000,0000,0000,,Көп қағаз➡
Dialogue: 0,0:04:29.57,0:04:32.54,Default,,0000,0000,0000,,Сіз жасай аласыз
Dialogue: 0,0:04:29.57,0:04:32.54,Default,,0000,0000,0000,,Мен саған айттым
Dialogue: 0,0:04:29.57,0:04:32.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:32.54,0:04:37.04,Default,,0000,0000,0000,,Көп нәрсе жасауға келгенде
Dialogue: 0,0:04:32.54,0:04:37.04,Default,,0000,0000,0000,,Бұл сіздің уақытыңызды үнемдейді дегенді білдіре ме?
Dialogue: 0,0:04:37.04,0:04:39.05,Default,,0000,0000,0000,,Мен мұны істеуге ешқандай мүмкіндік жоқ.
Dialogue: 0,0:04:37.04,0:04:39.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:39.05,0:04:42.55,Default,,0000,0000,0000,,Ауыр жұмыс
Dialogue: 0,0:04:39.05,0:04:42.55,Default,,0000,0000,0000,,Мен оны сиырларға қалдыра бастадым.
Dialogue: 0,0:04:39.05,0:04:42.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:42.55,0:04:46.59,Default,,0000,0000,0000,,Материалдар мен процестер
Dialogue: 0,0:04:42.55,0:04:46.59,Default,,0000,0000,0000,,Мен оны көптен бері өзгерткен жоқпын...
Dialogue: 0,0:04:42.55,0:04:46.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:04:46.59,0:04:50.02,Default,,0000,0000,0000,,《Бұл жағдайда
Dialogue: 0,0:04:46.59,0:04:50.02,Default,,0000,0000,0000,,Бұл тіпті тазалау туралы да емес.
Dialogue: 0,0:04:50.02,0:04:53.53,Default,,0000,0000,0000,,《Ол осы жердегі дүкендерде бар.
Dialogue: 0,0:04:50.02,0:04:53.53,Default,,0000,0000,0000,,Төменгі өнімдерден айырмашылығы➡
Dialogue: 0,0:04:53.53,0:04:57.53,Default,,0000,0000,0000,,Қоспалар жоқ
Dialogue: 0,0:04:53.53,0:04:57.53,Default,,0000,0000,0000,,Талшықтар біркелкі ұсақталған➡
Dialogue: 0,0:04:57.53,0:04:59.53,Default,,0000,0000,0000,,Біркелкі қалыңдық》
Dialogue: 0,0:04:59.53,0:05:02.54,Default,,0000,0000,0000,,《Мәселе сырттай.
Dialogue: 0,0:04:59.53,0:05:02.54,Default,,0000,0000,0000,,Бұлыңғыр...》
Dialogue: 0,0:05:02.54,0:05:05.57,Default,,0000,0000,0000,,《Ах
Dialogue: 0,0:05:02.54,0:05:05.57,Default,,0000,0000,0000,,Күш?
Dialogue: 0,0:05:05.57,0:05:08.11,Default,,0000,0000,0000,,​​Дәстүрлі процесс дегеніміз не?
Dialogue: 0,0:05:08.11,0:05:10.64,Default,,0000,0000,0000,,Бұл кәдімгі қағаз жасаумен бірдей.
Dialogue: 0,0:05:08.11,0:05:10.64,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:10.64,0:05:15.55,Default,,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:05:10.64,0:05:15.55,Default,,0000,0000,0000,,Бізде материалдарды ұсақтау әдісі бар.
Dialogue: 0,0:05:10.64,0:05:15.55,Default,,0000,0000,0000,,Нори
Dialogue: 0,0:05:10.64,0:05:15.55,Default,,0000,0000,0000,,Желім жасауға арналған
Dialogue: 0,0:05:10.64,0:05:15.55,Default,,0000,0000,0000,,Мен ерекше ...
Dialogue: 0,0:05:10.64,0:05:15.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:15.55,0:05:18.05,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:05:15.55,0:05:18.05,Default,,0000,0000,0000,,Сіз бұлай айта алмайсыз, солай ма?
Dialogue: 0,0:05:18.05,0:05:21.05,Default,,0000,0000,0000,,《Осындай нәрсе
Dialogue: 0,0:05:18.05,0:05:21.05,Default,,0000,0000,0000,,Сіз дауыстап сөйлемейсіз.
Dialogue: 0,0:05:21.05,0:05:24.06,Default,,0000,0000,0000,,Су да
Dialogue: 0,0:05:21.05,0:05:24.06,Default,,0000,0000,0000,,Сіз бұл туралы ерекшесіз бе?
Dialogue: 0,0:05:24.06,0:05:29.56,Default,,0000,0000,0000,,О
Dialogue: 0,0:05:24.06,0:05:29.56,Default,,0000,0000,0000,,Желімнің дұрыс қатаюына көз жеткізіңіз.
Dialogue: 0,0:05:24.06,0:05:29.56,Default,,0000,0000,0000,,Мен бұлақ суын жинай беремін.
Dialogue: 0,0:05:24.06,0:05:29.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:29.56,0:05:32.60,Default,,0000,0000,0000,,Ылғалдылықты реттеу үшін➡
Dialogue: 0,0:05:32.60,0:05:35.17,Default,,0000,0000,0000,,Бұдан артық ештеңе құпия емес.
Dialogue: 0,0:05:32.60,0:05:35.17,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:35.17,0:05:40.54,Default,,0000,0000,0000,,《Сиыр
Dialogue: 0,0:05:35.17,0:05:40.54,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:05:35.17,0:05:40.54,Default,,0000,0000,0000,,Қайнаған бұлақ суы》
Dialogue: 0,0:05:40.54,0:05:42.54,Default,,0000,0000,0000,,Пикин!
Dialogue: 0,0:05:45.04,0:05:48.55,Default,,0000,0000,0000,,Желім үшін күріш суын да қолдануға болады.
Dialogue: 0,0:05:45.04,0:05:48.55,Default,,0000,0000,0000,,Бұқтыру ма?
Dialogue: 0,0:05:48.55,0:05:52.02,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:05:48.55,0:05:52.02,Default,,0000,0000,0000,,Дұрыс
Dialogue: 0,0:05:48.55,0:05:52.02,Default,,0000,0000,0000,,Мен бидай ұнын ерітіп жатырмын.
Dialogue: 0,0:05:48.55,0:05:52.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:52.02,0:05:54.52,Default,,0000,0000,0000,,Әйтпесе ол қатып қалмайды...
Dialogue: 0,0:05:52.02,0:05:54.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:05:54.52,0:05:59.13,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:05:54.52,0:05:59.13,Default,,0000,0000,0000,,Мисс
Dialogue: 0,0:05:54.52,0:05:59.13,Default,,0000,0000,0000,,Жаңа ғана айтқанымызды ұмыта аласыз ба?
Dialogue: 0,0:05:59.13,0:06:01.19,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:05:59.13,0:06:01.19,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:01.19,0:06:04.06,Default,,0000,0000,0000,,Сиыр да солай
Dialogue: 0,0:06:01.19,0:06:04.06,Default,,0000,0000,0000,,Оны қайда сақтайсыз?
Dialogue: 0,0:06:04.06,0:06:07.07,Default,,0000,0000,0000,,Мен бұл туралы білмеймін.
Dialogue: 0,0:06:04.06,0:06:07.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:07.07,0:06:09.04,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:06:07.07,0:06:09.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:10.57,0:06:12.57,Default,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:06:10.57,0:06:12.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:12.57,0:06:14.07,Default,,0000,0000,0000,,Кузуюкай?
Dialogue: 0,0:06:16.58,0:06:20.08,Default,,0000,0000,0000,,Мисс
Dialogue: 0,0:06:16.58,0:06:20.08,Default,,0000,0000,0000,,Саны
Dialogue: 0,0:06:16.58,0:06:20.08,Default,,0000,0000,0000,,Сіз қателесесіз.
Dialogue: 0,0:06:16.58,0:06:20.08,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:20.08,0:06:23.12,Default,,0000,0000,0000,,Шәй кесеге жабысу
Dialogue: 0,0:06:20.08,0:06:23.12,Default,,0000,0000,0000,,Сіз оны іше алмайсыз, солай ма?
Dialogue: 0,0:06:20.08,0:06:23.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:23.12,0:06:24.68,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:06:23.12,0:06:24.68,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:24.68,0:06:27.59,Default,,0000,0000,0000,,Ішуді қалай жеңілдетуге болады
Dialogue: 0,0:06:24.68,0:06:27.59,Default,,0000,0000,0000,,Мен саған үйретемін➡
Dialogue: 0,0:06:27.59,0:06:29.56,Default,,0000,0000,0000,,Маған еліктей аласыз ба?
Dialogue: 0,0:06:33.56,0:06:37.06,Default,,0000,0000,0000,,Қасық
Dialogue: 0,0:06:33.56,0:06:37.06,Default,,0000,0000,0000,,Дегенмен, не болып жатқанын түсінбеймін.
Dialogue: 0,0:06:33.56,0:06:37.06,Default,,0000,0000,0000,,Жалаған қасықпен араластырыңыз
Dialogue: 0,0:06:33.56,0:06:37.06,Default,,0000,0000,0000,,Қайталаңыз
Dialogue: 0,0:06:33.56,0:06:37.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:37.06,0:06:39.53,Default,,0000,0000,0000,,Менің мінез-құлқымда бір нәрсе дұрыс емес.
Dialogue: 0,0:06:37.06,0:06:39.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:46.11,0:06:49.54,Default,,0000,0000,0000,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:06:46.11,0:06:49.54,Default,,0000,0000,0000,,Ол енді қалың емес.
Dialogue: 0,0:06:46.11,0:06:49.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:49.54,0:06:51.04,Default,,0000,0000,0000,,Ицумида-сан ба?
Dialogue: 0,0:06:49.54,0:06:51.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:51.04,0:06:54.55,Default,,0000,0000,0000,,Кузую және желім
Dialogue: 0,0:06:51.04,0:06:54.55,Default,,0000,0000,0000,,Олар өте ұқсас, солай емес пе?
Dialogue: 0,0:06:51.04,0:06:54.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:54.55,0:06:58.02,Default,,0000,0000,0000,,Ммм
Dialogue: 0,0:06:54.55,0:06:58.02,Default,,0000,0000,0000,,Олар өте ұқсас.
Dialogue: 0,0:06:54.55,0:06:58.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:06:58.02,0:07:02.52,Default,,0000,0000,0000,,Егер сілекей араласса
Dialogue: 0,0:06:58.02,0:07:02.52,Default,,0000,0000,0000,,Желім де
Dialogue: 0,0:06:58.02,0:07:02.52,Default,,0000,0000,0000,,Білезік болуды қоя ма деп ойлаймын.
Dialogue: 0,0:06:58.02,0:07:02.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:02.52,0:07:05.59,Default,,0000,0000,0000,,Бұл сізге де, маған да тиімді мәміле, иә?
Dialogue: 0,0:07:02.52,0:07:05.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:05.59,0:07:07.63,Default,,0000,0000,0000,,Осыны айтып тұрсың ба?
Dialogue: 0,0:07:07.63,0:07:10.06,Default,,0000,0000,0000,,《Адасқан бұта》
Dialogue: 0,0:07:10.06,0:07:15.57,Default,,0000,0000,0000,,Сиыр дегеніміз не?
Dialogue: 0,0:07:10.06,0:07:15.57,Default,,0000,0000,0000,,Аузында
Dialogue: 0,0:07:10.06,0:07:15.57,Default,,0000,0000,0000,,Көп сілекей
Dialogue: 0,0:07:10.06,0:07:15.57,Default,,0000,0000,0000,,Сіз жинақтап жатырсыз, солай емес пе?
Dialogue: 0,0:07:10.06,0:07:15.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:15.57,0:07:21.04,Default,,0000,0000,0000,,Хиёри, бұл шынымен де түсініспеушілік
Dialogue: 0,0:07:15.57,0:07:21.04,Default,,0000,0000,0000,,Сіз суды қай жерде ішесіз?
Dialogue: 0,0:07:15.57,0:07:21.04,Default,,0000,0000,0000,,Неге оны тексермеске?
Dialogue: 0,0:07:22.04,0:07:25.04,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:07:22.04,0:07:25.04,Default,,0000,0000,0000,,Мен апама хат жіберуім керек!
Dialogue: 0,0:07:25.04,0:07:26.58,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:07:25.04,0:07:26.58,Default,,0000,0000,0000,,Ха...!
Dialogue: 0,0:07:26.58,0:07:29.15,Default,,0000,0000,0000,,Бүгін мені кешіріңіз.
Dialogue: 0,0:07:26.58,0:07:29.15,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:29.15,0:07:30.62,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:07:29.15,0:07:30.62,Default,,0000,0000,0000,,Ха...!
Dialogue: 0,0:07:34.05,0:07:36.06,Default,,0000,0000,0000,,Дәл қазір
Dialogue: 0,0:07:34.05,0:07:36.06,Default,,0000,0000,0000,,Мен оралдым
Dialogue: 0,0:07:34.05,0:07:36.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:36.06,0:07:38.06,Default,,0000,0000,0000,,Хоннян
Dialogue: 0,0:07:36.06,0:07:38.06,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:36.06,0:07:38.06,Default,,0000,0000,0000,,Бени Мусуме
Dialogue: 0,0:07:36.06,0:07:38.06,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:36.06,0:07:38.06,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:07:36.06,0:07:38.06,Default,,0000,0000,0000,,Мысық мысық
Dialogue: 0,0:07:36.06,0:07:38.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:38.06,0:07:41.53,Default,,0000,0000,0000,,(
Dialogue: 0,0:07:38.06,0:07:41.53,Default,,0000,0000,0000,,Бени Мусуме
Dialogue: 0,0:07:38.06,0:07:41.53,Default,,0000,0000,0000,,)
Dialogue: 0,0:07:38.06,0:07:41.53,Default,,0000,0000,0000,,Дереу келіңіз
Dialogue: 0,0:07:38.06,0:07:41.53,Default,,0000,0000,0000,,Мен сізге хабарластым
Dialogue: 0,0:07:38.06,0:07:41.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:07:41.53,0:07:44.03,Default,,0000,0000,0000,,Ха…
Dialogue: 0,0:07:41.53,0:07:44.03,Default,,0000,0000,0000,,Орналасқан жері
Dialogue: 0,0:07:41.53,0:07:44.03,Default,,0000,0000,0000,,Қайда?
Dialogue: 0,0:07:45.57,0:07:49.04,Default,,0000,0000,0000,,Джиджо
Dialogue: 0,0:07:45.57,0:07:49.04,Default,,0000,0000,0000,,Жезөкшелер үшін төлем ақшасы дегеніміз не?
Dialogue: 0,0:07:45.57,0:07:49.04,Default,,0000,0000,0000,,Қанша тұрады?
Dialogue: 0,0:07:50.64,0:07:54.57,Default,,0000,0000,0000,,Су лалагүлі
Dialogue: 0,0:07:50.64,0:07:54.57,Default,,0000,0000,0000,,《Мен мұнда Сүйрей туралы деп ойлап келдім...
Dialogue: 0,0:07:50.64,0:07:54.57,Default,,0000,0000,0000,,Ол әлі де пайдасыз ит.
Dialogue: 0,0:07:54.57,0:07:58.04,Default,,0000,0000,0000,,Мені тыңда.
Dialogue: 0,0:07:54.57,0:07:58.04,Default,,0000,0000,0000,,Ханым!
Dialogue: 0,0:07:54.57,0:07:58.04,Default,,0000,0000,0000,,Рокушокан
Dialogue: 0,0:07:54.57,0:07:58.04,Default,,0000,0000,0000,,Осы уақыт ішінде
Dialogue: 0,0:07:54.57,0:07:58.04,Default,,0000,0000,0000,,Ryokuseikan➡-ге барғанда
Dialogue: 0,0:07:58.04,0:08:02.05,Default,,0000,0000,0000,,Үш ханшайымның бірі
Dialogue: 0,0:07:58.04,0:08:02.05,Default,,0000,0000,0000,,Мен сені өтейтініңді естідім!
Dialogue: 0,0:08:02.05,0:08:06.09,Default,,0000,0000,0000,,Не-чан
Dialogue: 0,0:08:02.05,0:08:06.09,Default,,0000,0000,0000,,《Сонымен, Байлин Сяоцзи ше?
Dialogue: 0,0:08:02.05,0:08:06.09,Default,,0000,0000,0000,,Мен уайымдадым》
Dialogue: 0,0:08:06.09,0:08:08.09,Default,,0000,0000,0000,,Өткір жері бар.
Dialogue: 0,0:08:06.09,0:08:08.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:08.09,0:08:10.62,Default,,0000,0000,0000,,Супер бірегей
Dialogue: 0,0:08:08.09,0:08:10.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:08.09,0:08:10.62,Default,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:08:08.09,0:08:10.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:10.62,0:08:15.56,Default,,0000,0000,0000,,Әзірге
Dialogue: 0,0:08:10.62,0:08:15.56,Default,,0000,0000,0000,,Нарық бағасы ағымдағы баға болғандықтан
Dialogue: 0,0:08:10.62,0:08:15.56,Default,,0000,0000,0000,,Бұл тек нұсқаулық.
Dialogue: 0,0:08:10.62,0:08:15.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:15.56,0:08:19.57,Default,,0000,0000,0000,,Тікелей сұраңыз
Dialogue: 0,0:08:15.56,0:08:19.57,Default,,0000,0000,0000,,Қанша?
Dialogue: 0,0:08:19.57,0:08:22.07,Default,,0000,0000,0000,,《Бұл қиын》
Dialogue: 0,0:08:22.07,0:08:27.07,Default,,0000,0000,0000,,《Күндік ақша
Dialogue: 0,0:08:22.07,0:08:27.07,Default,,0000,0000,0000,,Сыпайы болу үшін қанша жыл қалды?
Dialogue: 0,0:08:22.07,0:08:27.07,Default,,0000,0000,0000,,Джиро
Dialogue: 0,0:08:22.07,0:08:27.07,Default,,0000,0000,0000,,Гарнизонда ақша табуға болатын-болмайтынын білу үшін кері санау➡
Dialogue: 0,0:08:27.07,0:08:29.58,Default,,0000,0000,0000,,Біраз
Dialogue: 0,0:08:27.07,0:08:29.58,Default,,0000,0000,0000,,Түсті сомалар➡
Dialogue: 0,0:08:29.58,0:08:32.45,Default,,0000,0000,0000,,Бұл мәннен шамамен екі есе
Dialogue: 0,0:08:29.58,0:08:32.45,Default,,0000,0000,0000,,Оны тіркеуге болады...》
Dialogue: 0,0:08:35.11,0:08:37.12,Default,,0000,0000,0000,,Мисс...
Dialogue: 0,0:08:35.11,0:08:37.12,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:39.05,0:08:43.02,Default,,0000,0000,0000,,Егер Сяоцзиді Байлинг
Dialogue: 0,0:08:39.05,0:08:43.02,Default,,0000,0000,0000,,Сатып алсаңыз ше➡
Dialogue: 0,0:08:43.02,0:08:45.52,Default,,0000,0000,0000,,Екі үміткер ескі достар.
Dialogue: 0,0:08:43.02,0:08:45.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:45.52,0:08:47.56,Default,,0000,0000,0000,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:08:45.52,0:08:47.56,Default,,0000,0000,0000,,Екі адам…
Dialogue: 0,0:08:45.52,0:08:47.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:47.56,0:08:51.06,Default,,0000,0000,0000,,Біреуі саудагердің ұлы шебері.
Dialogue: 0,0:08:47.56,0:08:51.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:51.06,0:08:56.07,Default,,0000,0000,0000,,Тіпті Риокусейкан қисайған кезде де
Dialogue: 0,0:08:51.06,0:08:56.07,Default,,0000,0000,0000,,Коукуя
Dialogue: 0,0:08:51.06,0:08:56.07,Default,,0000,0000,0000,,Бұл қасынан өткен жақсы қарт.
Dialogue: 0,0:08:51.06,0:08:56.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:08:56.07,0:09:01.54,Default,,0000,0000,0000,,Басқа адам
Dialogue: 0,0:08:56.07,0:09:01.54,Default,,0000,0000,0000,,Сүйікті жоғары лауазымды шенеунік
Dialogue: 0,0:08:56.07,0:09:01.54,Default,,0000,0000,0000,,Әлі жас
Dialogue: 0,0:08:56.07,0:09:01.54,Default,,0000,0000,0000,,Отыздан астам
Dialogue: 0,0:08:56.07,0:09:01.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:01.54,0:09:05.54,Default,,0000,0000,0000,,Түнгі ойындарға серіктес ретінде
Dialogue: 0,0:09:01.54,0:09:05.54,Default,,0000,0000,0000,,Жылқылар жарасады➡
Dialogue: 0,0:09:05.54,0:09:10.05,Default,,0000,0000,0000,,Келесі күні
Dialogue: 0,0:09:05.54,0:09:10.05,Default,,0000,0000,0000,,Мен аздап шаршадым.
Dialogue: 0,0:09:05.54,0:09:10.05,Default,,0000,0000,0000,,Мен қызықпын
Dialogue: 0,0:09:05.54,0:09:10.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:10.05,0:09:15.05,Default,,0000,0000,0000,,《Құннан кейінгі өмірді ойлау
Dialogue: 0,0:09:10.05,0:09:15.05,Default,,0000,0000,0000,,Екеуі де...
Dialogue: 0,0:09:10.05,0:09:15.05,Default,,0000,0000,0000,,Хмм》
Dialogue: 0,0:09:15.05,0:09:17.56,Default,,0000,0000,0000,,Шаршадыңыз ба?
Dialogue: 0,0:09:15.05,0:09:17.56,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:09:17.56,0:09:21.63,Default,,0000,0000,0000,,《Ақ Сузу кішкентай әпкесі
Dialogue: 0,0:09:17.56,0:09:21.63,Default,,0000,0000,0000,,Биде жақсы болумен қатар➡
Dialogue: 0,0:09:21.63,0:09:24.56,Default,,0000,0000,0000,,Түнгі уақытта жеңіліске ұшырамайтын ұрыс болмайтындығымен танымал.
Dialogue: 0,0:09:24.56,0:09:28.03,Default,,0000,0000,0000,,《Көңілің түскенде
Dialogue: 0,0:09:24.56,0:09:28.03,Default,,0000,0000,0000,,Басқа ешкімсіз сұқ саусағыңызды жылжытыңыз➡
Dialogue: 0,0:09:28.03,0:09:30.14,Default,,0000,0000,0000,,Басқаша айтқанда, бұл нәпсі жын.
Dialogue: 0,0:09:30.14,0:09:32.04,Default,,0000,0000,0000,,｟Жоқ! ｠
Dialogue: 0,0:09:32.04,0:09:34.04,Default,,0000,0000,0000,,көрінгендей, шамамен 36 дана шығады.
Dialogue: 0,0:09:32.04,0:09:34.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:09:34.04,0:09:36.54,Default,,0000,0000,0000,,Бірақ?
Dialogue: 0,0:09:36.54,0:09:42.15,Default,,0000,0000,0000,,《Мені әкем қабылдағанға дейін.
Dialogue: 0,0:09:36.54,0:09:42.15,Default,,0000,0000,0000,,Риокусейканда маған қамқорлық жасаған адам➡ болды
Dialogue: 0,0:09:42.15,0:09:46.05,Default,,0000,0000,0000,,Хаг
Dialogue: 0,0:09:42.15,0:09:46.05,Default,,0000,0000,0000,,Яритебаба және үш ханшайым
Dialogue: 0,0:09:46.05,0:09:50.06,Default,,0000,0000,0000,,《Әсіресе
Dialogue: 0,0:09:46.05,0:09:50.06,Default,,0000,0000,0000,,Менде босану тәжірибесі жоқ, бірақ мен емшек сүтін шығарып жатырмын ➡
Dialogue: 0,0:09:50.06,0:09:56.53,Default,,0000,0000,0000,,Кішкентай апаның ерекше конституциясы болды.
Dialogue: 0,0:09:50.06,0:09:56.53,Default,,0000,0000,0000,,Ол менің анама жақын》
Dialogue: 0,0:09:56.53,0:10:00.03,Default,,0000,0000,0000,,《Кіші әпке
Dialogue: 0,0:09:56.53,0:10:00.03,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:09:56.53,0:10:00.03,Default,,0000,0000,0000,,Мен білмеймін, бірақ➡
Dialogue: 0,0:10:00.03,0:10:04.60,Default,,0000,0000,0000,,Сол күндер есіме түскенде
Dialogue: 0,0:10:00.03,0:10:04.60,Default,,0000,0000,0000,,Менің ойымша, бұл ысырап》
Dialogue: 0,0:10:04.60,0:10:08.17,Default,,0000,0000,0000,,《Ол нәпсі күшті әйел➡
Dialogue: 0,0:10:08.17,0:10:12.04,Default,,0000,0000,0000,,Шамамен бірдей
Dialogue: 0,0:10:08.17,0:10:12.04,Default,,0000,0000,0000,,Аналық құқығы бар әйел.
Dialogue: 0,0:10:12.04,0:10:14.55,Default,,0000,0000,0000,,көрінгендей, шамамен 36 дана шығады.
Dialogue: 0,0:10:12.04,0:10:14.55,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:10:14.55,0:10:17.05,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:10:14.55,0:10:17.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:17.05,0:10:22.56,Default,,0000,0000,0000,,《Мырза. Ли Бай
Dialogue: 0,0:10:17.05,0:10:22.56,Default,,0000,0000,0000,,Кішкентай апаның жұмысы
Dialogue: 0,0:10:17.05,0:10:22.56,Default,,0000,0000,0000,,Ылғау
Dialogue: 0,0:10:17.05,0:10:22.56,Default,,0000,0000,0000,,Мен оны толық түсінемін және ғашық боламын.
Dialogue: 0,0:10:22.56,0:10:25.56,Default,,0000,0000,0000,,《Біраз
Dialogue: 0,0:10:22.56,0:10:25.56,Default,,0000,0000,0000,,Пайдасыз итке ұқсайды
Dialogue: 0,0:10:22.56,0:10:25.56,Default,,0000,0000,0000,,Оның жүрегі байсалды сияқты➡
Dialogue: 0,0:10:25.56,0:10:31.13,Default,,0000,0000,0000,,Ол әйел үшін қызметке көтерілгісі келеді.
Dialogue: 0,0:10:25.56,0:10:31.13,Default,,0000,0000,0000,,Сүйікті
Dialogue: 0,0:10:25.56,0:10:31.13,Default,,0000,0000,0000,,Кейбір ақымақ нәрселер бар》
Dialogue: 0,0:10:31.13,0:10:34.13,Default,,0000,0000,0000,,《Ең бастысы
Dialogue: 0,0:10:31.13,0:10:34.13,Default,,0000,0000,0000,,Физикалық күш теңдесі жоқ》
Dialogue: 0,0:10:35.57,0:10:38.07,Default,,0000,0000,0000,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:10:35.57,0:10:38.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:38.07,0:10:41.54,Default,,0000,0000,0000,,《Төлені алушы ретінде жаман емес》
Dialogue: 0,0:10:41.54,0:10:45.54,Default,,0000,0000,0000,,Ли Бай-сама
Dialogue: 0,0:10:41.54,0:10:45.54,Default,,0000,0000,0000,,Жалақы қандай?
Dialogue: 0,0:10:41.54,0:10:45.54,Default,,0000,0000,0000,,Сіз қанша аласыз?
Dialogue: 0,0:10:45.54,0:10:48.05,Default,,0000,0000,0000,,Кенеттен
Dialogue: 0,0:10:45.54,0:10:48.05,Default,,0000,0000,0000,,Сіз не айтқыңыз келеді?
Dialogue: 0,0:10:48.05,0:10:50.05,Default,,0000,0000,0000,,​​Жылына шамамен 800 күміс?
Dialogue: 0,0:10:50.05,0:10:51.58,Default,,0000,0000,0000,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:10:50.05,0:10:51.58,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:51.58,0:10:53.62,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:10:51.58,0:10:53.62,Default,,0000,0000,0000,,1200?
Dialogue: 0,0:10:53.62,0:10:57.02,Default,,0000,0000,0000,,《Жылына 1000 дана күміс
Dialogue: 0,0:10:53.62,0:10:57.02,Default,,0000,0000,0000,,Осындай нәрсе》
Dialogue: 0,0:10:57.02,0:10:59.06,Default,,0000,0000,0000,,Жеткіліксіз бе?
Dialogue: 0,0:10:57.02,0:10:59.06,Default,,0000,0000,0000,,Жетпейді
Dialogue: 0,0:10:57.02,0:10:59.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:59.06,0:11:02.53,Default,,0000,0000,0000,,Мен бірден 10 000 қолма-қол ақша алғым келеді.
Dialogue: 0,0:10:59.06,0:11:02.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:10:59.06,0:11:02.53,Default,,0000,0000,0000,,Карс неге қарап тұр өзі?
Dialogue: 0,0:11:02.53,0:11:05.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:02.53,0:11:05.03,Default,,0000,0000,0000,,Ли Бай
Dialogue: 0,0:11:02.53,0:11:05.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:02.53,0:11:05.03,Default,,0000,0000,0000,,⚟10 000⁉⚞
Dialogue: 0,0:11:02.53,0:11:05.03,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:02.53,0:11:05.03,Default,,0000,0000,0000,,2 адам
Dialogue: 0,0:11:02.53,0:11:05.03,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:02.53,0:11:05.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:05.03,0:11:10.04,Default,,0000,0000,0000,,Арзан жезөкше 400 иен тұрады.
Dialogue: 0,0:11:05.03,0:11:10.04,Default,,0000,0000,0000,,Ryokuseikan➡ үш ханшайымының бірі болсаңыз
Dialogue: 0,0:11:10.04,0:11:14.07,Default,,0000,0000,0000,,Кем дегенде
Dialogue: 0,0:11:10.04,0:11:14.07,Default,,0000,0000,0000,,Мен 10 000 алғым келеді.
Dialogue: 0,0:11:10.04,0:11:14.07,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:14.07,0:11:15.61,Default,,0000,0000,0000,,10 000…
Dialogue: 0,0:11:14.07,0:11:15.61,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:15.61,0:11:20.05,Default,,0000,0000,0000,,О...
Dialogue: 0,0:11:15.61,0:11:20.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:15.61,0:11:20.05,Default,,0000,0000,0000,,Қара…
Dialogue: 0,0:11:15.61,0:11:20.05,Default,,0000,0000,0000,,Сіз 10 000➡ жинадыңыз делік
Dialogue: 0,0:11:20.05,0:11:22.55,Default,,0000,0000,0000,,Сіз өзіңізді өтей аламын деп ойлайсыз ба?
Dialogue: 0,0:11:22.55,0:11:26.55,Default,,0000,0000,0000,,Ли Бай әпкесі болады
Dialogue: 0,0:11:22.55,0:11:26.55,Default,,0000,0000,0000,,Коппидоку
Dialogue: 0,0:11:22.55,0:11:26.55,Default,,0000,0000,0000,,Қабылданбау мүмкіндігі бар ма?
Dialogue: 0,0:11:26.55,0:11:31.09,Default,,0000,0000,0000,,Ха…
Dialogue: 0,0:11:26.55,0:11:31.09,Default,,0000,0000,0000,,Кү…
Dialogue: 0,0:11:26.55,0:11:31.09,Default,,0000,0000,0000,,Куу~
Dialogue: 0,0:11:26.55,0:11:31.09,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:31.09,0:11:34.06,Default,,0000,0000,0000,,Я...
Dialogue: 0,0:11:31.09,0:11:34.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:31.09,0:11:34.06,Default,,0000,0000,0000,,《Мен көмектесе алмаймын.》
Dialogue: 0,0:11:34.06,0:11:37.60,Default,,0000,0000,0000,,Ли Бай мырза
Dialogue: 0,0:11:34.06,0:11:37.60,Default,,0000,0000,0000,,Киіміңізді шешіп жібере аласыз ба?
Dialogue: 0,0:11:37.60,0:11:40.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:37.60,0:11:40.63,Default,,0000,0000,0000,,Киімімді шешсем, мені тастап кетпей ме?
Dialogue: 0,0:11:40.63,0:11:46.54,Default,,0000,0000,0000,,Менің білетінім бар
Dialogue: 0,0:11:40.63,0:11:46.54,Default,,0000,0000,0000,,Бұл Байлинг Сяожиге ұнайтын дене туралы.
Dialogue: 0,0:11:40.63,0:11:46.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:46.54,0:11:48.54,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:46.54,0:11:48.54,Default,,0000,0000,0000,,Ли Бай
Dialogue: 0,0:11:46.54,0:11:48.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:46.54,0:11:48.54,Default,,0000,0000,0000,,⚟Шешіңіз! ⚞
Dialogue: 0,0:11:46.54,0:11:48.54,Default,,0000,0000,0000,,(
Dialogue: 0,0:11:46.54,0:11:48.54,Default,,0000,0000,0000,,2 адам
Dialogue: 0,0:11:46.54,0:11:48.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:11:46.54,0:11:48.54,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:51.54,0:11:53.55,Default,,0000,0000,0000,,Төменгі де
Dialogue: 0,0:11:51.54,0:11:53.55,Default,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:11:51.54,0:11:53.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:53.55,0:11:56.52,Default,,0000,0000,0000,,Төменгі де?
Dialogue: 0,0:11:53.55,0:11:56.52,Default,,0000,0000,0000,,Төменде
Dialogue: 0,0:11:53.55,0:11:56.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:11:56.52,0:11:59.55,Default,,0000,0000,0000,,Киіміңді шешкенде
Dialogue: 0,0:11:56.52,0:11:59.55,Default,,0000,0000,0000,,Екі қолды иық деңгейіне көтеріңіз➡
Dialogue: 0,0:11:59.55,0:12:02.59,Default,,0000,0000,0000,,Маған бицепс жасай аласыз ба?
Dialogue: 0,0:12:02.59,0:12:05.12,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:12:02.59,0:12:05.12,Default,,0000,0000,0000,,Уф… Ой, жоқ!
Dialogue: 0,0:12:05.12,0:12:08.53,Default,,0000,0000,0000,,《Ақ Сузу кішкентай әпкесі
Dialogue: 0,0:12:05.12,0:12:08.53,Default,,0000,0000,0000,,Акуджики
Dialogue: 0,0:12:05.12,0:12:08.53,Default,,0000,0000,0000,,Менің кез келген нәрсені жеуге тәбетім нашар➡
Dialogue: 0,0:12:08.53,0:12:11.53,Default,,0000,0000,0000,,Дәл солай
Dialogue: 0,0:12:08.53,0:12:11.53,Default,,0000,0000,0000,,Артықшылық деген де бар.
Dialogue: 0,0:12:11.53,0:12:14.03,Default,,0000,0000,0000,,《Мм
Dialogue: 0,0:12:11.53,0:12:14.03,Default,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:12:11.53,0:12:14.03,Default,,0000,0000,0000,,Өте...》
Dialogue: 0,0:12:14.03,0:12:18.54,Default,,0000,0000,0000,,⚟Келесі
Dialogue: 0,0:12:14.03,0:12:18.54,Default,,0000,0000,0000,,Қолыңызды түсіріп, бицепті ⚞ басыңыз
Dialogue: 0,0:12:18.54,0:12:20.54,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:18.54,0:12:20.54,Default,,0000,0000,0000,,Ли Бай
Dialogue: 0,0:12:18.54,0:12:20.54,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:18.54,0:12:20.54,Default,,0000,0000,0000,,⚟Солай ма? ⚞
Dialogue: 0,0:12:18.54,0:12:20.54,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:12:18.54,0:12:20.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:20.54,0:12:25.08,Default,,0000,0000,0000,,《Тек әскери офицерлер үшін
Dialogue: 0,0:12:20.54,0:12:25.08,Default,,0000,0000,0000,,Тайку
Dialogue: 0,0:12:20.54,0:12:25.08,Default,,0000,0000,0000,,Оның жақсы дайындалған дене бітімі бар.
Dialogue: 0,0:12:25.08,0:12:27.61,Default,,0000,0000,0000,,《Шынымен жақсы бұлшықеттер》
Dialogue: 0,0:12:25.08,0:12:27.61,Default,,0000,0000,0000,,Ника~!
Dialogue: 0,0:12:27.61,0:12:30.55,Default,,0000,0000,0000,,《Бұл
Dialogue: 0,0:12:27.61,0:12:30.55,Default,,0000,0000,0000,,Мүмкін мен бара аламын.
Dialogue: 0,0:12:27.61,0:12:30.55,Default,,0000,0000,0000,,Фуфуфу...!
Dialogue: 0,0:12:30.55,0:12:32.55,Default,,0000,0000,0000,,《Қалғаны...》
Dialogue: 0,0:12:32.55,0:12:36.06,Default,,0000,0000,0000,,Енді соңғысын да шешіңіз.
Dialogue: 0,0:12:32.55,0:12:36.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:32.55,0:12:36.06,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:32.55,0:12:36.06,Default,,0000,0000,0000,,Ли Бай
Dialogue: 0,0:12:32.55,0:12:36.06,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:32.55,0:12:36.06,Default,,0000,0000,0000,,О!
Dialogue: 0,0:12:36.06,0:12:37.56,Default,,0000,0000,0000,,Ха…
Dialogue: 0,0:12:36.06,0:12:37.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:36.06,0:12:37.56,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:12:39.06,0:12:43.56,Default,,0000,0000,0000,,Джинши
Dialogue: 0,0:12:39.06,0:12:43.56,Default,,0000,0000,0000,,(
Dialogue: 0,0:12:39.06,0:12:43.56,Default,,0000,0000,0000,,Джинши
Dialogue: 0,0:12:39.06,0:12:43.56,Default,,0000,0000,0000,,)
Dialogue: 0,0:12:39.06,0:12:43.56,Default,,0000,0000,0000,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:12:39.06,0:12:43.56,Default,,0000,0000,0000,,Мәңгілік шың тек менікі
Dialogue: 0,0:12:39.06,0:12:43.56,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:43.56,0:12:46.60,Default,,0000,0000,0000,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:12:43.56,0:12:46.60,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:12:43.56,0:12:46.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:46.60,0:12:48.10,Default,,0000,0000,0000,,Жаңа түрдегі рух толқыны пайда болды!
Dialogue: 0,0:12:46.60,0:12:48.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:12:50.57,0:12:53.54,Default,,0000,0000,0000,,Сіз не істеп жүрсіз?
Dialogue: 0,0:12:53.54,0:12:56.54,Default,,0000,0000,0000,,《Әдемі әйелдер ашуланғанда қорқады》
Dialogue: 0,0:12:56.54,0:12:59.51,Default,,0000,0000,0000,,Не істедім десеңіз де➡
Dialogue: 0,0:12:59.51,0:13:03.02,Default,,0000,0000,0000,,Қоңырауда
Dialogue: 0,0:12:59.51,0:13:03.02,Default,,0000,0000,0000,,Маған кеңес берілді.
Dialogue: 0,0:12:59.51,0:13:03.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:03.02,0:13:05.58,Default,,0000,0000,0000,,Бұл сенсің ғой, иә?
Dialogue: 0,0:13:03.02,0:13:05.58,Default,,0000,0000,0000,,Сол адам
Dialogue: 0,0:13:03.02,0:13:05.58,Default,,0000,0000,0000,,Сіз осылай киіндіңіз бе?
Dialogue: 0,0:13:05.58,0:13:10.02,Default,,0000,0000,0000,,Бұның қатесі жоқ.
Dialogue: 0,0:13:05.58,0:13:10.02,Default,,0000,0000,0000,,Мен жай ғана мұқият қарап тұрдым.
Dialogue: 0,0:13:05.58,0:13:10.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:10.02,0:13:11.52,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:13:11.52,0:13:15.03,Default,,0000,0000,0000,,Мұқият...
Dialogue: 0,0:13:11.52,0:13:15.03,Default,,0000,0000,0000,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:13:15.03,0:13:17.53,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:13:15.03,0:13:17.53,Default,,0000,0000,0000,,Мен жай ғана қарап тұрдым.
Dialogue: 0,0:13:15.03,0:13:17.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:17.53,0:13:21.53,Default,,0000,0000,0000,,​​Не үшін?
Dialogue: 0,0:13:17.53,0:13:21.53,Default,,0000,0000,0000,,Не үшін болса да➡
Dialogue: 0,0:13:21.53,0:13:26.04,Default,,0000,0000,0000,,Денені ұнататынын қалай білуге болады
Dialogue: 0,0:13:21.53,0:13:26.04,Default,,0000,0000,0000,,Нақты өнімді тексерген дұрыс.
Dialogue: 0,0:13:21.53,0:13:26.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:26.04,0:13:28.61,Default,,0000,0000,0000,,Бұл сізге ұнайтын дене⁉
Dialogue: 0,0:13:28.61,0:13:32.55,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:13:28.61,0:13:32.55,Default,,0000,0000,0000,,Сыртқы түрі
Dialogue: 0,0:13:28.61,0:13:32.55,Default,,0000,0000,0000,,Бұл адам болмысының бір ғана элементі➡
Dialogue: 0,0:13:32.55,0:13:35.01,Default,,0000,0000,0000,,Қалауыңызша
Dialogue: 0,0:13:32.55,0:13:35.01,Default,,0000,0000,0000,,Мен ешқашан өткен емеспін...
Dialogue: 0,0:13:32.55,0:13:35.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:35.01,0:13:39.02,Default,,0000,0000,0000,,《Соңында
Dialogue: 0,0:13:35.01,0:13:39.02,Default,,0000,0000,0000,,Ең маңызды бөлігін тексеріңіз➡
Dialogue: 0,0:13:39.02,0:13:43.02,Default,,0000,0000,0000,,Болашақ
Dialogue: 0,0:13:39.02,0:13:43.02,Default,,0000,0000,0000,,Кішкентай әпкеге қалай жүгінуім керек?
Dialogue: 0,0:13:39.02,0:13:43.02,Default,,0000,0000,0000,,Мен ойладым...》
Dialogue: 0,0:13:43.02,0:13:46.03,Default,,0000,0000,0000,,《Иә?
Dialogue: 0,0:13:43.02,0:13:46.03,Default,,0000,0000,0000,,Иә? 》
Dialogue: 0,0:13:46.03,0:13:51.10,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:13:46.03,0:13:51.10,Default,,0000,0000,0000,,Бұл адам қандай?
Dialogue: 0,0:13:46.03,0:13:51.10,Default,,0000,0000,0000,,Қалай болды?
Dialogue: 0,0:13:51.10,0:13:54.03,Default,,0000,0000,0000,,Оның шын мәнінде пропорционалды денесі болды.
Dialogue: 0,0:13:51.10,0:13:54.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:13:54.03,0:13:58.54,Default,,0000,0000,0000,,Күн сайын
Dialogue: 0,0:13:54.03,0:13:58.54,Default,,0000,0000,0000,,Жаттығуды ешқашан жіберіп алмаңыз
Dialogue: 0,0:13:54.03,0:13:58.54,Default,,0000,0000,0000,,Сіз байсалды адам ретінде кездесесіз➡
Dialogue: 0,0:13:58.54,0:14:02.04,Default,,0000,0000,0000,,Әскери офицерлер арасында
Dialogue: 0,0:13:58.54,0:14:02.04,Default,,0000,0000,0000,,Біраз
Dialogue: 0,0:13:58.54,0:14:02.04,Default,,0000,0000,0000,,Ол жақсы адам емес пе?
Dialogue: 0,0:13:58.54,0:14:02.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:02.04,0:14:08.05,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:02.04,0:14:08.05,Default,,0000,0000,0000,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:14:02.04,0:14:08.05,Default,,0000,0000,0000,,Адам денесімен
Dialogue: 0,0:14:02.04,0:14:08.05,Default,,0000,0000,0000,,Сіз қандай адам екеніңізді білесіз бе?
Dialogue: 0,0:14:08.05,0:14:12.59,Default,,0000,0000,0000,,Өмір салты әдеттер денеде анық көрінеді
Dialogue: 0,0:14:08.05,0:14:12.59,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:12.59,0:14:17.02,Default,,0000,0000,0000,,Фармацевт болып жұмыс істеу
Dialogue: 0,0:14:12.59,0:14:17.02,Default,,0000,0000,0000,,Өзім туралы
Dialogue: 0,0:14:12.59,0:14:17.02,Default,,0000,0000,0000,,Кейбір тұтынушылар сөйлемейді, сондықтан➡
Dialogue: 0,0:14:17.02,0:14:19.53,Default,,0000,0000,0000,,Ұнамаса да, үйренесің.
Dialogue: 0,0:14:17.02,0:14:19.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:19.53,0:14:23.03,Default,,0000,0000,0000,,Менің денеме қарасаң да
Dialogue: 0,0:14:19.53,0:14:23.03,Default,,0000,0000,0000,,Сіз де соны түсінесіз бе?
Dialogue: 0,0:14:23.03,0:14:24.50,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:24.50,0:14:28.03,Default,,0000,0000,0000,,《Мүмкін
Dialogue: 0,0:14:24.50,0:14:28.03,Default,,0000,0000,0000,,Сіз Ли Байды қызғанасыз ба? 》
Dialogue: 0,0:14:28.03,0:14:30.54,Default,,0000,0000,0000,,《Қандай адам》
Dialogue: 0,0:14:30.54,0:14:35.11,Default,,0000,0000,0000,,«Мен өзімді әдемірек санаймын».
Dialogue: 0,0:14:30.54,0:14:35.11,Default,,0000,0000,0000,,Мен өзімді көрсеткім келеді》
Dialogue: 0,0:14:35.11,0:14:37.51,Default,,0000,0000,0000,,《Мен сенің әдемі денең бар екенін білемін》
Dialogue: 0,0:14:37.51,0:14:41.08,Default,,0000,0000,0000,,《Нақты
Dialogue: 0,0:14:37.51,0:14:41.08,Default,,0000,0000,0000,,Таңқаларлық
Dialogue: 0,0:14:37.51,0:14:41.08,Default,,0000,0000,0000,,Бұл тығыз болды》
Dialogue: 0,0:14:41.08,0:14:42.55,Default,,0000,0000,0000,,Әйтеуір, гала-концерт – өзіңді ерекше көрсетуге арналған.
Dialogue: 0,0:14:42.55,0:14:47.52,Default,,0000,0000,0000,,Джиндзи-саманың денесін көргенде
Dialogue: 0,0:14:42.55,0:14:47.52,Default,,0000,0000,0000,,Бұл ешқандай мағынасы жоқ
Dialogue: 0,0:14:42.55,0:14:47.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:48.52,0:14:51.02,Default,,0000,0000,0000,,Екі қолда да даңқ; жеңіс – біздің әніміз
Dialogue: 0,0:14:48.52,0:14:51.02,Default,,0000,0000,0000,,Джинджи мырза➡
Dialogue: 0,0:14:51.02,0:14:54.03,Default,,0000,0000,0000,,Әне
Dialogue: 0,0:14:51.02,0:14:54.03,Default,,0000,0000,0000,,Менің қарындасым кім?
Dialogue: 0,0:14:51.02,0:14:54.03,Default,,0000,0000,0000,,Менің ойымша, бұл сәйкес келмейді.
Dialogue: 0,0:14:51.02,0:14:54.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:54.03,0:14:55.56,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:55.56,0:14:58.10,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:14:55.56,0:14:58.10,Default,,0000,0000,0000,,Фу…
Dialogue: 0,0:14:55.56,0:14:58.10,Default,,0000,0000,0000,,.
Dialogue: 0,0:14:58.10,0:15:00.00,Default,,0000,0000,0000,,《Осыны істеп жатқанда➡
Dialogue: 0,0:15:00.00,0:15:02.50,Default,,0000,0000,0000,,Ширасуды сатып алды
Dialogue: 0,0:15:00.00,0:15:02.50,Default,,0000,0000,0000,,Мен оны тастауым мүмкін》
Dialogue: 0,0:15:02.50,0:15:07.54,Default,,0000,0000,0000,,《Алайда
Dialogue: 0,0:15:02.50,0:15:07.54,Default,,0000,0000,0000,,Мен қазір ештеңе істей алмаймын.
Dialogue: 0,0:15:07.54,0:15:10.51,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:15:07.54,0:15:10.51,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:10.51,0:15:13.05,Default,,0000,0000,0000,,Ширасу…
Dialogue: 0,0:15:10.51,0:15:13.05,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:13.05,0:15:16.02,Default,,0000,0000,0000,,(
Dialogue: 0,0:15:13.05,0:15:16.02,Default,,0000,0000,0000,,Тоқ
Dialogue: 0,0:15:13.05,0:15:16.02,Default,,0000,0000,0000,,)
Dialogue: 0,0:15:13.05,0:15:16.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:18.55,0:15:21.12,Default,,0000,0000,0000,,《Не болып жатыр?》
Dialogue: 0,0:15:21.12,0:15:24.02,Default,,0000,0000,0000,,《Оның аты Джиндзи екеніне сенімдімін бе?》
Dialogue: 0,0:15:24.02,0:15:27.03,Default,,0000,0000,0000,,《Императордың қолдары
Dialogue: 0,0:15:24.02,0:15:27.03,Default,,0000,0000,0000,,(Есік ашылу дыбысы)
Dialogue: 0,0:15:24.02,0:15:27.03,Default,,0000,0000,0000,,Сыбыс бар...》
Dialogue: 0,0:15:27.03,0:15:31.03,Default,,0000,0000,0000,,Келесі күні
Dialogue: 0,0:15:27.03,0:15:31.03,Default,,0000,0000,0000,,Менің қызметшім саған қамқор болды.
Dialogue: 0,0:15:27.03,0:15:31.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:31.03,0:15:33.50,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:15:31.03,0:15:33.50,Default,,0000,0000,0000,,Онша емес...
Dialogue: 0,0:15:31.03,0:15:33.50,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:33.50,0:15:37.54,Default,,0000,0000,0000,,Сіз қазірсіз
Dialogue: 0,0:15:33.50,0:15:37.54,Default,,0000,0000,0000,,Сіз біреуді жақсы көретін сияқтысыз.
Dialogue: 0,0:15:33.50,0:15:37.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:37.54,0:15:39.04,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:39.04,0:15:42.61,Default,,0000,0000,0000,,《Мүмкін
Dialogue: 0,0:15:39.04,0:15:42.61,Default,,0000,0000,0000,,Сол қыз
Dialogue: 0,0:15:39.04,0:15:42.61,Default,,0000,0000,0000,,Сіз сөйлестіңіз бе? 》
Dialogue: 0,0:15:42.61,0:15:45.54,Default,,0000,0000,0000,,《Ха
Dialogue: 0,0:15:42.61,0:15:45.54,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:15:42.61,0:15:45.54,Default,,0000,0000,0000,,Маған үнемі күлімдейсің бе?
Dialogue: 0,0:15:45.54,0:15:47.01,Default,,0000,0000,0000,,Дұрыс. Соның арқасында мен ұтылдым.
Dialogue: 0,0:15:45.54,0:15:47.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:15:47.01,0:15:51.05,Default,,0000,0000,0000,,《Осы жаста
Dialogue: 0,0:15:47.01,0:15:51.05,Default,,0000,0000,0000,,Оны елдегі ең жақсы сұлу деп айтады➡
Dialogue: 0,0:15:51.05,0:15:53.52,Default,,0000,0000,0000,,Есте қаларлық және берекелі ұстаным
Dialogue: 0,0:15:51.05,0:15:53.52,Default,,0000,0000,0000,,Егер мен жұмысқа орналассам➡
Dialogue: 0,0:15:53.52,0:15:57.52,Default,,0000,0000,0000,,Жезөкшелерді рандомизациялау және т.б.
Dialogue: 0,0:15:53.52,0:15:57.52,Default,,0000,0000,0000,,Бұл жай ғана әзіл болса керек.
Dialogue: 0,0:15:57.52,0:16:00.56,Default,,0000,0000,0000,,《Мені мазақ ету дұрыс емес》
Dialogue: 0,0:16:00.56,0:16:04.63,Default,,0000,0000,0000,,《Бірақ
Dialogue: 0,0:16:00.56,0:16:04.63,Default,,0000,0000,0000,,Ақ қоңырау
Dialogue: 0,0:16:00.56,0:16:04.63,Default,,0000,0000,0000,,Оны мазақ етсең, басқа әңгіме.
Dialogue: 0,0:16:04.63,0:16:07.03,Default,,0000,0000,0000,,《Егер оны қорласаң...》
Dialogue: 0,0:16:07.03,0:16:09.03,Default,,0000,0000,0000,,20 000
Dialogue: 0,0:16:07.03,0:16:09.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:07.03,0:16:09.03,Default,,0000,0000,0000,,А...
Dialogue: 0,0:16:07.03,0:16:09.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:09.03,0:16:14.54,Default,,0000,0000,0000,,Мен төлем ақшасын аламын.
Dialogue: 0,0:16:09.03,0:16:14.54,Default,,0000,0000,0000,,Айтсаңыз
Dialogue: 0,0:16:09.03,0:16:14.54,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:16:14.54,0:16:16.54,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:16:16.54,0:16:19.04,Default,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:16:16.54,0:16:19.04,Default,,0000,0000,0000,,(Изуку) Қарсыластың өз күшін пайдаланып, дәл қорғанына сондай етіп сүңгу...
Dialogue: 0,0:16:19.04,0:16:21.55,Default,,0000,0000,0000,,Оның мағынасы осы.
Dialogue: 0,0:16:19.04,0:16:21.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:26.62,0:16:30.56,Default,,0000,0000,0000,,және тек үшеуміз – анам, әкем және мен – бірге өмір сүремін…
Dialogue: 0,0:16:26.62,0:16:30.56,Default,,0000,0000,0000,,Сөздеріңді естігеніме қуаныштымын.
Dialogue: 0,0:16:26.62,0:16:30.56,Default,,0000,0000,0000,,Бейтаныс шенеунікке➡
Dialogue: 0,0:16:30.56,0:16:33.56,Default,,0000,0000,0000,,Кенеттен
Dialogue: 0,0:16:30.56,0:16:33.56,Default,,0000,0000,0000,,Тіпті егер сен солай айтсаң да
Dialogue: 0,0:16:30.56,0:16:33.56,Default,,0000,0000,0000,,Сіз сенімдісіз бе?
Dialogue: 0,0:16:33.56,0:16:38.03,Default,,0000,0000,0000,,Менің мысық
Dialogue: 0,0:16:33.56,0:16:38.03,Default,,0000,0000,0000,,Олар өте сақ.
Dialogue: 0,0:16:33.56,0:16:38.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:38.03,0:16:41.53,Default,,0000,0000,0000,,Сіз сұраған нәрсе.
Dialogue: 0,0:16:38.03,0:16:41.53,Default,,0000,0000,0000,,Наокатсу➡
Dialogue: 0,0:16:41.53,0:16:47.11,Default,,0000,0000,0000,,Қарындасыммен тең адам серігі ретінде.
Dialogue: 0,0:16:41.53,0:16:47.11,Default,,0000,0000,0000,,Мен сияқты нәрселер туралы ойлаймын
Dialogue: 0,0:16:41.53,0:16:47.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:47.11,0:16:51.54,Default,,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,0:16:47.11,0:16:51.54,Default,,0000,0000,0000,,Сақ мысыққа қосылып қалсаңыз➡
Dialogue: 0,0:16:51.54,0:16:54.55,Default,,0000,0000,0000,,Сену үшін осының өзі жеткілікті.
Dialogue: 0,0:16:51.54,0:16:54.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:54.55,0:16:56.55,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:16:54.55,0:16:56.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:16:56.55,0:16:59.55,Default,,0000,0000,0000,,《Бір нәрсе
Dialogue: 0,0:16:56.55,0:16:59.55,Default,,0000,0000,0000,,Мен қате айттым ба?
Dialogue: 0,0:16:59.55,0:17:04.56,Default,,0000,0000,0000,,Сіз туралы кейбір әңгімелер
Dialogue: 0,0:16:59.55,0:17:04.56,Default,,0000,0000,0000,,Мен оны айналамдағы адамдардан естідім.
Dialogue: 0,0:16:59.55,0:17:04.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:04.56,0:17:07.06,Default,,0000,0000,0000,,Жергілікті шенеуніктің баласы болса да➡
Dialogue: 0,0:17:07.06,0:17:11.63,Default,,0000,0000,0000,,Елордада әскери офицер болу деген нені білдіреді?
Dialogue: 0,0:17:07.06,0:17:11.63,Default,,0000,0000,0000,,Қиын болған жоқсың ба?
Dialogue: 0,0:17:11.63,0:17:15.07,Default,,0000,0000,0000,,Сұрасаңыз
Dialogue: 0,0:17:11.63,0:17:15.07,Default,,0000,0000,0000,,Білгіш стратег➡ тапты
Dialogue: 0,0:17:15.07,0:17:19.04,Default,,0000,0000,0000,,Маған жасақ сеніп тапсырылды.
Dialogue: 0,0:17:15.07,0:17:19.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:15.07,0:17:19.04,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:17:15.07,0:17:19.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:19.04,0:17:22.04,Default,,0000,0000,0000,,《Ресми
Dialogue: 0,0:17:19.04,0:17:22.04,Default,,0000,0000,0000,,Взвод бастығының қызметінен кетуіне байланысты➡
Dialogue: 0,0:17:22.04,0:17:24.54,Default,,0000,0000,0000,,Оны жоғары жылжыту керек еді...》
Dialogue: 0,0:17:24.54,0:17:27.51,Default,,0000,0000,0000,,Мен келешегі зор мемлекеттік шенеуніктермен дос болғым келеді.
Dialogue: 0,0:17:24.54,0:17:27.51,Default,,0000,0000,0000,,Яғни➡
Dialogue: 0,0:17:27.51,0:17:30.05,Default,,0000,0000,0000,,Барлығының ойы солай емес пе?
Dialogue: 0,0:17:30.05,0:17:34.12,Default,,0000,0000,0000,,《Алайда
Dialogue: 0,0:17:30.05,0:17:34.12,Default,,0000,0000,0000,,20 000 күміс тым үлкен мәміле》
Dialogue: 0,0:17:34.12,0:17:36.02,Default,,0000,0000,0000,,《Қажетті нәрсе
Dialogue: 0,0:17:34.12,0:17:36.02,Default,,0000,0000,0000,,Оның жартысы➡
Dialogue: 0,0:17:36.02,0:17:39.49,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:17:36.02,0:17:39.49,Default,,0000,0000,0000,,Тіпті жартысы жақсы.
Dialogue: 0,0:17:44.53,0:17:48.53,Default,,0000,0000,0000,,Мені сатып алғаны үшін
Dialogue: 0,0:17:44.53,0:17:48.53,Default,,0000,0000,0000,,Онда не бар?
Dialogue: 0,0:17:44.53,0:17:48.53,Default,,0000,0000,0000,,Адалдық
Dialogue: 0,0:17:44.53,0:17:48.53,Default,,0000,0000,0000,,Мен бақыттымын➡
Dialogue: 0,0:17:48.53,0:17:52.54,Default,,0000,0000,0000,,Сондай-ақ ұсыныста
Dialogue: 0,0:17:48.53,0:17:52.54,Default,,0000,0000,0000,,Тамақтан шыққан қол
Dialogue: 0,0:17:48.53,0:17:52.54,Default,,0000,0000,0000,,Мен өзімді шығатындай сезінемін.
Dialogue: 0,0:17:48.53,0:17:52.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:52.54,0:17:57.11,Default,,0000,0000,0000,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:17:52.54,0:17:57.11,Default,,0000,0000,0000,,Мұнда күміс
Dialogue: 0,0:17:52.54,0:17:57.11,Default,,0000,0000,0000,,Мен оны қабылдай алмаймын.
Dialogue: 0,0:17:52.54,0:17:57.11,Default,,0000,0000,0000,,.
Dialogue: 0,0:17:57.11,0:18:00.55,Default,,0000,0000,0000,,Сізге
Dialogue: 0,0:17:57.11,0:18:00.55,Default,,0000,0000,0000,,Ол жезөкшелердің бірі болуы мүмкін➡
Dialogue: 0,0:18:00.55,0:18:04.55,Default,,0000,0000,0000,,Мен үшін
Dialogue: 0,0:18:00.55,0:18:04.55,Default,,0000,0000,0000,,Бір ғана әйел бар
Dialogue: 0,0:18:00.55,0:18:04.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:04.55,0:18:10.02,Default,,0000,0000,0000,,Менің әйелім болғанын қалайтын әйел
Dialogue: 0,0:18:04.55,0:18:10.02,Default,,0000,0000,0000,,Мен оны тапқан ақшаммен сұрамадым...
Dialogue: 0,0:18:04.55,0:18:10.02,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:12.02,0:18:14.53,Default,,0000,0000,0000,,Сіз мені еркек деп атай аласыз ба?
Dialogue: 0,0:18:12.02,0:18:14.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:19.06,0:18:20.60,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:18:19.06,0:18:20.60,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:20.60,0:18:22.53,Default,,0000,0000,0000,,Бұл үшін кешіріңіз.
Dialogue: 0,0:18:20.60,0:18:22.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:20.60,0:18:22.53,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:22.53,0:18:26.54,Default,,0000,0000,0000,,Болашақ
Dialogue: 0,0:18:22.53,0:18:26.54,Default,,0000,0000,0000,,Мен айтқым келетін нәрсе
Dialogue: 0,0:18:22.53,0:18:26.54,Default,,0000,0000,0000,,Бар болуы мүмкін, бірақ➡
Dialogue: 0,0:18:26.54,0:18:29.54,Default,,0000,0000,0000,,Сіз сенімдісіз бе?
Dialogue: 0,0:18:29.54,0:18:31.01,Default,,0000,0000,0000,,Бакуго жеңіске жетті!
Dialogue: 0,0:18:29.54,0:18:31.01,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:36.55,0:18:39.55,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:18:36.55,0:18:39.55,Default,,0000,0000,0000,,(
Dialogue: 0,0:18:36.55,0:18:39.55,Default,,0000,0000,0000,,Гаошун
Dialogue: 0,0:18:36.55,0:18:39.55,Default,,0000,0000,0000,,)
Dialogue: 0,0:18:36.55,0:18:39.55,Default,,0000,0000,0000,,Джиндзи мырза
Dialogue: 0,0:18:36.55,0:18:39.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:36.55,0:18:39.55,Default,,0000,0000,0000,,О
Dialogue: 0,0:18:36.55,0:18:39.55,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:39.55,0:18:43.16,Default,,0000,0000,0000,,Мен уайымдаған жоқпын.
Dialogue: 0,0:18:39.55,0:18:43.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:39.55,0:18:43.16,Default,,0000,0000,0000,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:18:39.55,0:18:43.16,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:43.16,0:18:47.06,Default,,0000,0000,0000,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:18:43.16,0:18:47.06,Default,,0000,0000,0000,,Хмм… Уф
Dialogue: 0,0:18:43.16,0:18:47.06,Default,,0000,0000,0000,,Мәңгілік шың тек менікі
Dialogue: 0,0:18:43.16,0:18:47.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:47.06,0:18:51.06,Default,,0000,0000,0000,,​​Не істеуім керек?
Dialogue: 0,0:18:47.06,0:18:51.06,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:51.06,0:18:53.57,Default,,0000,0000,0000,,Әзірге
Dialogue: 0,0:18:51.06,0:18:53.57,Default,,0000,0000,0000,,Келесі тренингте➡
Dialogue: 0,0:18:53.57,0:18:57.54,Default,,0000,0000,0000,,Читто Бакаши
Dialogue: 0,0:18:53.57,0:18:57.54,Default,,0000,0000,0000,,Мен сізге жақсы жақтарын көрсетемін...
Dialogue: 0,0:18:53.57,0:18:57.54,Default,,0000,0000,0000,,.
Dialogue: 0,0:18:57.54,0:19:01.57,Default,,0000,0000,0000,,Әлде…
Dialogue: 0,0:18:57.54,0:19:01.57,Default,,0000,0000,0000,,Маған көбірек жұмыс керек пе...
Dialogue: 0,0:18:57.54,0:19:01.57,Default,,0000,0000,0000,,.
Dialogue: 0,0:19:01.57,0:19:04.64,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:19:01.57,0:19:04.64,Default,,0000,0000,0000,,Көрінбейтін белгілері жоқ, біртіндеп өршіп бара жатқан ауру сияқты—
Dialogue: 0,0:19:04.64,0:19:10.05,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:10.05,0:19:14.05,Default,,0000,0000,0000,,«Қашан кездесетінімізді білмейтін әйелге»
Dialogue: 0,0:19:10.05,0:19:14.05,Default,,0000,0000,0000,,Фуми
Dialogue: 0,0:19:10.05,0:19:14.05,Default,,0000,0000,0000,,Хабар жіберу》
Dialogue: 0,0:19:14.05,0:19:19.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:19.06,0:19:22.03,Default,,0000,0000,0000,,《Тек біржақты
Dialogue: 0,0:19:19.06,0:19:22.03,Default,,0000,0000,0000,,Мені көтерудің орнына➡
Dialogue: 0,0:19:22.03,0:19:24.56,Default,,0000,0000,0000,,Оның ниетін тыңдайық》
Dialogue: 0,0:19:24.56,0:19:34.04,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:34.04,0:19:36.04,Default,,0000,0000,0000,,《Бұл әлеуметтік сәлемдесу болуы мүмкін》
Dialogue: 0,0:19:36.04,0:19:39.55,Default,,0000,0000,0000,,《Бұған сеніңіз
Dialogue: 0,0:19:36.04,0:19:39.55,Default,,0000,0000,0000,,Оны күнделікті наныңызға айналдырыңыз.
Dialogue: 0,0:19:39.55,0:19:59.57,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:59.57,0:20:04.54,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:04.54,0:20:09.04,Default,,0000,0000,0000,,Тек сенетін жолмен жүріңіз
Dialogue: 0,0:20:04.54,0:20:09.04,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:11.54,0:20:16.62,Default,,0000,0000,0000,,(
Dialogue: 0,0:20:11.54,0:20:16.62,Default,,0000,0000,0000,,Ақ қоңырау дауысы
Dialogue: 0,0:20:11.54,0:20:16.62,Default,,0000,0000,0000,,)
Dialogue: 0,0:20:11.54,0:20:16.62,Default,,0000,0000,0000,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:20:11.54,0:20:16.62,Default,,0000,0000,0000,,Әжем бірдеңе дейді.
Dialogue: 0,0:20:11.54,0:20:16.62,Default,,0000,0000,0000,,Ол сондай адам.
Dialogue: 0,0:20:11.54,0:20:16.62,Default,,0000,0000,0000,,Әлі де белсенді
Dialogue: 0,0:20:11.54,0:20:16.62,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:16.62,0:20:20.52,Default,,0000,0000,0000,,Және мен
Dialogue: 0,0:20:16.62,0:20:20.52,Default,,0000,0000,0000,,Бір күні
Dialogue: 0,0:20:16.62,0:20:20.52,Default,,0000,0000,0000,,Бір жерде
Dialogue: 0,0:20:16.62,0:20:20.52,Default,,0000,0000,0000,,Оудзи
Dialogue: 0,0:20:16.62,0:20:20.52,Default,,0000,0000,0000,,Ханзаданың сені алып кетуге келгенін көру➡
Dialogue: 0,0:20:20.52,0:20:22.52,Default,,0000,0000,0000,,Не күтіп тұр
Dialogue: 0,0:20:20.52,0:20:22.52,Default,,0000,0000,0000,,”.
Dialogue: 0,0:20:22.52,0:20:25.52,Default,,0000,0000,0000,,Мұндай сезім
Dialogue: 0,0:20:22.52,0:20:25.52,Default,,0000,0000,0000,,Дегенмен мен жасадым.
Dialogue: 0,0:20:22.52,0:20:25.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:25.52,0:20:30.53,Default,,0000,0000,0000,,Не-чан
Dialogue: 0,0:20:25.52,0:20:30.53,Default,,0000,0000,0000,,Бейлинг Сяоцзи сені ұнататын болса
Dialogue: 0,0:20:25.52,0:20:30.53,Default,,0000,0000,0000,,Төлем ретінде сізге 10 000 күміс қажет емес.
Dialogue: 0,0:20:25.52,0:20:30.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:30.53,0:20:33.03,Default,,0000,0000,0000,,Қалғаны сәттілікке байланысты
Dialogue: 0,0:20:30.53,0:20:33.03,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:33.03,0:20:34.53,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:34.53,0:20:38.10,Default,,0000,0000,0000,,(
Dialogue: 0,0:20:34.53,0:20:38.10,Default,,0000,0000,0000,,Ақ қоңырау дауысы
Dialogue: 0,0:20:34.53,0:20:38.10,Default,,0000,0000,0000,,) "
Dialogue: 0,0:20:34.53,0:20:38.10,Default,,0000,0000,0000,,Сол адам келді
Dialogue: 0,0:20:34.53,0:20:38.10,Default,,0000,0000,0000,,Өйткені біз төлем туралы айтып едік➡
Dialogue: 0,0:20:38.10,0:20:41.07,Default,,0000,0000,0000,,Камуро
Dialogue: 0,0:20:38.10,0:20:41.07,Default,,0000,0000,0000,,Сондықтан мен тақырмын
Dialogue: 0,0:20:38.10,0:20:41.07,Default,,0000,0000,0000,,Мен қате түсіндім деп ойлаймын.
Dialogue: 0,0:20:38.10,0:20:41.07,Default,,0000,0000,0000,,”.
Dialogue: 0,0:20:48.55,0:20:51.05,Default,,0000,0000,0000,,《Сол адам》
Dialogue: 0,0:20:53.02,0:20:57.52,Default,,0000,0000,0000,,Риксон
Dialogue: 0,0:20:53.02,0:20:57.52,Default,,0000,0000,0000,,Лакан
Dialogue: 0,0:20:53.02,0:20:57.52,Default,,0000,0000,0000,,(
Dialogue: 0,0:20:53.02,0:20:57.52,Default,,0000,0000,0000,,Рику Сан
Dialogue: 0,0:20:53.02,0:20:57.52,Default,,0000,0000,0000,,)
Dialogue: 0,0:20:53.02,0:20:57.52,Default,,0000,0000,0000,,Архат-сама
Dialogue: 0,0:20:53.02,0:20:57.52,Default,,0000,0000,0000,,Осындай жерде
Dialogue: 0,0:20:53.02,0:20:57.52,Default,,0000,0000,0000,,Келдің бе?
Dialogue: 0,0:20:53.02,0:20:57.52,Default,,0000,0000,0000,,.
Dialogue: 0,0:20:57.52,0:21:00.53,Default,,0000,0000,0000,,Архат-сама
Dialogue: 0,0:20:57.52,0:21:00.53,Default,,0000,0000,0000,,Кездесу басталғалы жатыр.
Dialogue: 0,0:20:57.52,0:21:00.53,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:00.53,0:21:02.56,Default,,0000,0000,0000,,Суби
Dialogue: 0,0:21:00.53,0:21:02.56,Default,,0000,0000,0000,,(
Dialogue: 0,0:21:00.53,0:21:02.56,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:21:00.53,0:21:02.56,Default,,0000,0000,0000,,)
Dialogue: 0,0:21:00.53,0:21:02.56,Default,,0000,0000,0000,,Көк раушан
Dialogue: 0,0:21:00.53,0:21:02.56,Default,,0000,0000,0000,,.
Dialogue: 0,0:21:02.56,0:21:05.53,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:02.56,0:21:05.53,Default,,0000,0000,0000,,Не ол?
Dialogue: 0,0:21:07.10,0:21:09.10,Default,,0000,0000,0000,,(
Dialogue: 0,0:21:07.10,0:21:09.10,Default,,0000,0000,0000,,Архат
Dialogue: 0,0:21:07.10,0:21:09.10,Default,,0000,0000,0000,,)
Dialogue: 0,0:21:07.10,0:21:09.10,Default,,0000,0000,0000,,Иә
