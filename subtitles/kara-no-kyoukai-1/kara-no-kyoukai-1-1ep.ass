Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.55,0:00:07.55,CNsub,NTP,0,0,0,,КамиГами
Dialogue: 0,0:49:10.22,0:49:14.50,CNsub,NTP,0,0,0,,Қазіргі заманның болуы туралы әңгіме
Dialogue: 0,0:50:01.65,0:50:06.45,CNsub,NTP,0,0,0,,＠/···
Dialogue: 0,0:43:53.50,0:44:00.64,EDJ,NTP,0,0,0,,Өйткені мен ұша алатынымды білдім
Dialogue: 0,0:44:00.99,0:44:07.99,EDJ,NTP,0,0,0,,Қанат қағудан қорыққаным сонша, желді ұмыттым.
Dialogue: 0,0:44:08.25,0:44:09.71,EDJ,NTP,0,0,0,,немқұрайлы
Dialogue: 0,0:44:09.86,0:44:11.65,EDJ,NTP,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:44:11.81,0:44:16.27,EDJ,NTP,0,0,0,,Алыстан көрінетін сол сағым
Dialogue: 0,0:44:16.47,0:44:19.39,EDJ,NTP,0,0,0,,Бір күні қорқып отырып
Dialogue: 0,0:44:19.55,0:44:27.98,EDJ,NTP,0,0,0,,Екеуіміздің болашағымызды бейнелеу
Dialogue: 0,0:44:39.43,0:44:46.62,EDJ,NTP,0,0,0,,Екі дәрменсіз жүрек қосылса
Dialogue: 0,0:44:47.05,0:44:54.06,EDJ,NTP,0,0,0,,Нағыз мұң қанатын кеңге жаяды
Dialogue: 0,0:44:54.32,0:44:55.78,EDJ,NTP,0,0,0,,немқұрайлы
Dialogue: 0,0:44:55.94,0:44:57.76,EDJ,NTP,0,0,0,,Түнде
Dialogue: 0,0:44:57.97,0:45:02.20,EDJ,NTP,0,0,0,,Түс түсте көлеңке көргендей
Dialogue: 0,0:45:02.43,0:45:05.45,EDJ,NTP,0,0,0,,Мен құлайтыныма сенімдімін
Dialogue: 0,0:45:05.62,0:45:10.73,EDJ,NTP,0,0,0,,Жарыққа
Dialogue: 0,0:45:25.21,0:45:30.53,EDJ,NTP,0,0,0,,Бір күні сен және мен
Dialogue: 0,0:45:30.82,0:45:40.09,EDJ,NTP,0,0,0,,Түн, таң, күн, жұлдыздар, елес
Dialogue: 0,0:45:40.40,0:45:47.64,EDJ,NTP,0,0,0,,Жаз, қыс, уақыт, жел
Dialogue: 0,0:45:48.01,0:45:53.61,EDJ,NTP,0,0,0,,Су, топырақ, аспан
Dialogue: 0,0:45:53.84,0:46:02.15,EDJ,NTP,0,0,0,,біз тағдырда әрі қарай барамыз...
Dialogue: 0,0:46:11.55,0:46:18.81,EDJ,NTP,0,0,0,,Өйткені мен ұша алатынымды білдім
Dialogue: 0,0:46:19.19,0:46:28.00,EDJ,NTP,0,0,0,,Қанат қағудан қорыққаным сонша, желді ұмыттым.
Dialogue: 0,0:46:32.30,0:46:33.64,EDJ,NTP,0,0,0,,немқұрайлы
Dialogue: 0,0:46:33.86,0:46:35.70,EDJ,NTP,0,0,0,,Менің қасымда бол
Dialogue: 0,0:46:35.87,0:46:40.12,EDJ,NTP,0,0,0,,Тыныш махаббат басталғалы тұр
Dialogue: 0,0:46:40.39,0:46:43.36,EDJ,NTP,0,0,0,,Бір күні қалтырап
Dialogue: 0,0:46:43.53,0:46:47.48,EDJ,NTP,0,0,0,,Біздің болашағымызға
Dialogue: 0,0:46:47.64,0:46:49.04,EDJ,NTP,0,0,0,,ұмытылған
Dialogue: 0,0:46:49.23,0:46:51.06,EDJ,NTP,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:46:51.23,0:46:55.43,EDJ,NTP,0,0,0,,Алысқа ағып жатқан суда
Dialogue: 0,0:46:55.72,0:46:58.66,EDJ,NTP,0,0,0,,Дауысы қандай әдемі
Dialogue: 0,0:46:58.84,0:47:02.53,EDJ,NTP,0,0,0,,Біздің болашағымыз бірге
Dialogue: 0,0:47:02.78,0:47:08.71,EDJ,NTP,0,0,0,,Sing
Dialogue: 0,0:43:53.50,0:44:00.64,EDC,NTP,0,0,0,,...
Dialogue: 0,0:44:00.99,0:44:07.99,EDC,NTP,0,0,0,,...
Dialogue: 0,0:44:08.25,0:44:09.71,EDC,NTP,0,0,0,,Жедел меморандум
Dialogue: 0,0:44:09.86,0:44:11.65,EDC,NTP,0,0,0,,Мен мұны бұрын қайдан естідім?
Dialogue: 0,0:44:11.81,0:44:16.27,EDC,NTP,0,0,0,,Накай қаласындағы Мираж
Dialogue: 0,0:44:16.47,0:44:19.39,EDC,NTP,0,0,0,,Жағдайға алаңдаушылық
Dialogue: 0,0:44:19.55,0:44:27.98,EDC,NTP,0,0,0,,Екі адамның болашағын елестету
Dialogue: 0,0:44:39.43,0:44:46.62,EDC,NTP,0,0,0,,Біздің санамыз бір-біріне жақын болған сәтте
Dialogue: 0,0:44:47.05,0:44:54.06,EDC,NTP,0,0,0,,Басқаларға қарсы шынайы қайғылы соғыс
Dialogue: 0,0:44:54.32,0:44:55.78,EDC,NTP,0,0,0,,Жедел меморандум
Dialogue: 0,0:44:55.94,0:44:57.76,EDC,NTP,0,0,0,,Қараңғы түн
Dialogue: 0,0:44:57.97,0:45:02.20,EDC,NTP,0,0,0,,Будданың күндізгі көрінісі
Dialogue: 0,0:45:02.43,0:45:05.45,EDC,NTP,0,0,0,,Қорытынды жиналыс
Dialogue: 0,0:45:05.62,0:45:10.73,EDC,NTP,0,0,0,,Жарық бағыты
Dialogue: 0,0:45:25.21,0:45:30.53,EDC,NTP,0,0,0,,...
Dialogue: 0,0:45:30.82,0:45:40.09,EDC,NTP,0,0,0,,Еніп жатқан қара түн, ашық күн, жарық жұлдыз, қиял
Dialogue: 0,0:45:40.40,0:45:47.64,EDC,NTP,0,0,0,,Жаз ортасы, суық қыс, уақыт, мөлдір жел
Dialogue: 0,0:45:48.01,0:45:53.61,EDC,NTP,0,0,0,,Толып жатқан су Жер аспаны
Dialogue: 0,0:45:53.84,0:46:02.15,EDC,NTP,0,0,0,,Әр адамның тағдыры тереңге барады...
Dialogue: 0,0:46:11.55,0:46:18.81,EDC,NTP,0,0,0,,Дұрыс себепті тез біледі, өзін-өзі қондыру - аспанда ұшу
Dialogue: 0,0:46:19.19,0:46:28.00,EDC,NTP,0,0,0,,Талантты көрсетсең желді ұмытасың.
Dialogue: 0,0:46:32.30,0:46:33.64,EDC,NTP,0,0,0,,Жедел меморандум
Dialogue: 0,0:46:33.86,0:46:35.70,EDC,NTP,0,0,0,,Қайдасың?
Dialogue: 0,0:46:35.87,0:46:40.12,EDC,NTP,0,0,0,,Мұнда махаббат кеші
Dialogue: 0,0:46:40.39,0:46:43.36,EDC,NTP,0,0,0,,...
Dialogue: 0,0:46:43.53,0:46:47.48,EDC,NTP,0,0,0,,Екі адамның болашағы
Dialogue: 0,0:46:47.64,0:46:49.04,EDC,NTP,0,0,0,,Жедел меморандум
Dialogue: 0,0:46:49.23,0:46:51.06,EDC,NTP,0,0,0,,Мен мұны бұрын қайдан естідім?
Dialogue: 0,0:46:51.23,0:46:55.43,EDC,NTP,0,0,0,,Осы бағыттағы үздіксіз су ағыны
Dialogue: 0,0:46:55.72,0:46:58.66,EDC,NTP,0,0,0,,Әдемі ән салған дауыс
Dialogue: 0,0:46:58.84,0:47:02.53,EDC,NTP,0,0,0,,Ән айтудың басталуы
Dialogue: 0,0:47:02.78,0:47:08.71,EDC,NTP,0,0,0,,Екі адамның болашағы
Dialogue: 0,0:00:23.24,0:00:24.02,JPsub,NTP,0,0,0,,Ашық
Dialogue: 0,0:00:27.26,0:00:28.00,JPsub,NTP,0,0,0,,Қайырлы кеш
Dialogue: 0,0:00:28.76,0:00:30.64,JPsub,NTP,0,0,0,,Сіз әлі де летаргиялық көрінесіз.
Dialogue: 0,0:00:32.25,0:00:34.16,JPsub,NTP,0,0,0,,Иә, бұл тоңазытқыш
Dialogue: 0,0:00:39.16,0:00:43.02,JPsub,NTP,0,0,0,,Егер сіз кілттеріңізді құлыптамасаңыз, сіз мүлдем абайсыз.
Dialogue: 0,0:00:43.54,0:00:44.60,JPsub,NTP,0,0,0,,Мен сізге бұрын айттым
Dialogue: 0,0:00:45.01,0:00:48.23,JPsub,NTP,0,0,0,,Рұқсатсыз кіруге болмайды. Мен мұны бұрын да айтқанмын.
Dialogue: 0,0:00:49.08,0:00:50.70,JPsub,NTP,0,0,0,,Сіз бұлай айта алмайсыз.
Dialogue: 0,0:00:54.11,0:00:56.15,JPsub,NTP,0,0,0,,Бүгін мен құлпынай жедім
Dialogue: 0,0:00:59.03,0:01:00.44,JPsub,NTP,0,0,0,,Еріп жатыр.
Dialogue: 0,0:01:01.32,0:01:03.53,JPsub,NTP,0,0,0,,Мен мұз пакетін алуым керек еді.
Dialogue: 0,0:01:04.31,0:01:05.83,JPsub,NTP,0,0,0,,Мен балмұздақты ұнатпаймын
Dialogue: 0,0:01:06.29,0:01:12.09,JPsub,NTP,0,0,0,,Бірақ бүгін ыстық болды, сондықтан мен суық нәрсе кигім келеді деп ойладым.
Dialogue: 0,0:01:13.64,0:01:15.39,JPsub,NTP,0,0,0,,Мен бұл стандарт деп ойладым.
Dialogue: 0,0:01:15.85,0:01:18.26,JPsub,NTP,0,0,0,,Өрнекке қарасаңыз, сырты біраз
Dialogue: 0,0:01:18.59,0:01:19.29,JPsub,NTP,0,0,0,,Мен бәрібір жақсы боламын. Бар күшімді саламын
Dialogue: 0,0:01:20.33,0:01:21.17,JPsub,NTP,0,0,0,,Құлпынай
Dialogue: 0,0:01:22.32,0:01:23.43,JPsub,NTP,0,0,0,,Бұл Хааген-Дазс.
Dialogue: 0,0:01:24.10,0:01:26.35,JPsub,NTP,0,0,0,,Қараңызшы, оны кеше сатып алған жігіт жемейді.
Dialogue: 0,0:01:26.89,0:01:28.99,JPsub,NTP,0,0,0,,Құлпынай менің бейнем бе?
Dialogue: 0,0:01:31.08,0:01:32.04,JPsub,NTP,0,0,0,,Каважан т.б.
Dialogue: 0,0:01:34.08,0:01:36.72,JPsub,NTP,0,0,0,,Сондай-ақ, құлпынай раушангүлділер тұқымдасына жатады.
Dialogue: 0,0:01:37.97,0:01:38.76,JPsub,NTP,0,0,0,,Бұл таңқаларлық болар еді.
Dialogue: 0,0:01:39.16,0:01:42.79,JPsub,NTP,0,0,0,,Құлпынай сүйкімді, мен бәрі туралы ойлаймын, бірақ олар раушан гүлдері.
Dialogue: 0,0:01:44.19,0:01:45.98,JPsub,NTP,0,0,0,,Иә, бұл формула ғой.
Dialogue: 0,0:01:46.23,0:01:46.99,JPsub,NTP,0,0,0,,Тамақ ішпеңіз
Dialogue: 0,0:05:16.70,0:05:18.34,JPsub,NTP,0,0,0,,Бүгін сағат 14:00 шамасында.
Dialogue: 0,0:05:18.77,0:05:24.40,JPsub,NTP,0,0,0,,Қалада тұратын елордалық орта мектептің екінші курс студенті Мияджо №4 ғимаратының төбесінен құлап кетті.
Dialogue: 0,0:05:24.72,0:05:27.44,JPsub,NTP,0,0,0,,Оның бүкіл денесі қатты соққыға ұшырап, көп ұзамай қайтыс болды.
Dialogue: 0,0:05:28.61,0:05:31.80,JPsub,NTP,0,0,0,,Қазір Мияджо ғимаратында өз-өзіне қол жұмсаған төрт адам бар.
Dialogue: 0,0:05:32.27,0:05:35.20,JPsub,NTP,0,0,0,,Оқиға орнында бұрынғыдай өз-өзіне қол жұмсау туралы хат қалмады.
Dialogue: 0,0:05:35.57,0:05:38.70,JPsub,NTP,0,0,0,,Полиция Эйконың іздерін тексеруі керек және
Dialogue: 0,0:05:39.02,0:05:43.59,JPsub,NTP,0,0,0,,Мен отбасы мүшесі немесе досым болғандықтан, менде болуы мүмкін кез келген алаңдаушылықты немесе қиындықтарды зерттеймін.
Dialogue: 0,0:05:43.73,0:05:44.43,JPsub,NTP,0,0,0,,Қызықтырады
Dialogue: 0,0:05:50.01,0:05:52.08,JPsub,NTP,0,0,0,,Мен профессордың сөзін тыңдағым келеді.
Dialogue: 0,0:05:53.47,0:05:54.84,JPsub,NTP,0,0,0,,Бұл төртінші адам.
Dialogue: 0,0:05:56.89,0:06:00.98,JPsub,NTP,0,0,0,,Өткенде қатарынан суицид жағдайлары болды ма?
Dialogue: 0,0:05:55.63,0:05:56.85,JPsub,NTP,0,0,0,,Әлемнің уақыты келді
Dialogue: 0,0:06:00.07,0:06:02.37,JPsub,NTP,0,0,0,,Менің ойымша, сіз байланысты байқаған кез келді.
Dialogue: 0,0:06:02.94,0:06:03.84,JPsub,NTP,0,0,0,,Өзектілігі
Dialogue: 0,0:06:03.95,0:06:05.42,JPsub,NTP,0,0,0,,Өте маңызды
Dialogue: 0,0:06:05.72,0:06:07.37,JPsub,NTP,0,0,0,,Мүмкін, бұл жалпы қасиет деп айтуым керек.
Dialogue: 0,0:06:07.86,0:06:11.41,JPsub,NTP,0,0,0,,Өз-өзіне қол жұмсаған балалардың барлығы әртүрлі мектептерде оқыды және ешқандай қарым-қатынаста болмады.
Dialogue: 0,0:06:11.66,0:06:14.75,JPsub,NTP,0,0,0,,Жеке өмірінде қиындық жоқ, бәрі жақсы қыздар.
Dialogue: 0,0:06:14.89,0:06:17.49,JPsub,NTP,0,0,0,,Отбасы суицидке не себеп болғанын білмейді.
Dialogue: 0,0:06:18.21,0:06:22.56,JPsub,NTP,0,0,0,,Жағдайларды ескере отырып, олардың ісі өте жеке.
Dialogue: 0,0:06:22.80,0:06:27.33,JPsub,NTP,0,0,0,,Өзім туралы жағымсыз уайымға шыдағаннан кейін кенеттен өз-өзіне қол жұмсау маған пайдасыз.
Dialogue: 0,0:06:27.89,0:06:30.61,JPsub,NTP,0,0,0,,Сондықтан артымда қалдырғым келетін сөздер жоқ.
Dialogue: 0,0:06:30.95,0:06:33.94,JPsub,NTP,0,0,0,,Полиция да бұл ортақ қасиетке мән бермейді.
Dialogue: 0,0:06:34.29,0:06:35.07,JPsub,NTP,0,0,0,,Ерік немесе ерік?
Dialogue: 0,0:06:35.29,0:06:36.72,JPsub,NTP,0,0,0,,Керемет
Dialogue: 0,0:06:36.84,0:06:41.02,JPsub,NTP,0,0,0,,Егер бәрібір өлетін болсаң, ешкімге қиындық тудырмайтын әдісті таңдау керек.
Dialogue: 0,0:06:42.69,0:06:44.41,JPsub,NTP,0,0,0,,Секіру арқылы өзін-өзі өлтіруге қайшы келеді
Dialogue: 0,0:06:45.62,0:06:46.54,JPsub,NTP,0,0,0,,Солай ма?
Dialogue: 0,0:06:48.16,0:06:53.86,JPsub,NTP,0,0,0,,Дүниеде өкінбеймін десең, ең алдымен өліміңді де айтудың қажеті жоқ.
Dialogue: 0,0:06:54.91,0:06:59.59,JPsub,NTP,0,0,0,,Өсиет қалдырмау, яғни ешбір пікір білдірмей өсиет қалдыру.
Dialogue: 0,0:07:00.16,0:07:01.80,JPsub,NTP,0,0,0,,Керісінше назар аудартады
Dialogue: 0,0:07:02.14,0:07:04.96,JPsub,NTP,0,0,0,,Жағдайдың өзі ерік-жігерге ұқсайды.
Dialogue: 0,0:07:05.54,0:07:07.49,JPsub,NTP,0,0,0,,Бірақ олар секірді
Dialogue: 0,0:07:07.78,0:07:09.12,JPsub,NTP,0,0,0,,Ешқандай еріксіз
Dialogue: 0,0:07:09.92,0:07:10.64,JPsub,NTP,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:07:11.64,0:07:13.99,JPsub,NTP,0,0,0,,Мен шынымен өлгім келмеді.
Dialogue: 0,0:07:15.31,0:07:18.24,JPsub,NTP,0,0,0,,Екеуі біраз уақыт сонда дүкен аралады.
Dialogue: 0,0:07:18.52,0:07:21.57,JPsub,NTP,0,0,0,,Жол-көлік оқиғасына ұшырау жолы болмай қалғандай.
Dialogue: 0,0:07:23.05,0:07:24.50,JPsub,NTP,0,0,0,,Микия осылай деді.
Dialogue: 0,0:07:25.96,0:07:26.72,JPsub,NTP,0,0,0,,Әрі қарай, Эрен
Dialogue: 0,0:07:27.83,0:07:33.95,JPsub,NTP,0,0,0,,Бірақ мен дүкенге барайын деп жатқанда, ғимараттың төбесінен секіруге себеп таба алмаймын.
Dialogue: 0,0:07:35.30,0:07:36.35,JPsub,NTP,0,0,0,,Мүлдем
Dialogue: 0,0:07:38.71,0:07:42.74,JPsub,NTP,0,0,0,,Менің балам үйге қашан келеді?
Dialogue: 0,0:09:27.95,0:09:31.87,JPsub,NTP,0,0,0,,Бұл Мияджо ғимаратындағы жеке суицидтердің жалпы санын беске жеткізеді.
Dialogue: 0,0:09:32.26,0:09:36.29,JPsub,NTP,0,0,0,,Марқұм қаладағы орта мектептің екінші курсында оқитын қыз.
Dialogue: 0,0:09:36.57,0:09:39.38,JPsub,NTP,0,0,0,,Алдыңғы төрт жағдайдағыдай, оқиға орнында ешқандай күрес белгілері болған жоқ.
Dialogue: 0,0:09:42.38,0:09:44.06,JPsub,NTP,0,0,0,,Бұл қанша уақытқа созылады деп ойлаймын.
Dialogue: 0,0:09:44.45,0:09:46.42,JPsub,NTP,0,0,0,,Секіру сегіз адаммен аяқталады.
Dialogue: 0,0:09:46.52,0:09:48.08,JPsub,NTP,0,0,0,,Одан кейін ол біраз уақытқа созылмайды
Dialogue: 0,0:09:48.79,0:09:49.34,JPsub,NTP,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:09:49.55,0:09:50.13,JPsub,NTP,0,0,0,,Сегіз адам
Dialogue: 0,0:09:50.57,0:09:52.12,JPsub,NTP,0,0,0,,Сегіз ұшатын болды.
Dialogue: 0,0:09:53.29,0:09:54.75,JPsub,NTP,0,0,0,,Сіз Мияджо ғимаратына бардыңыз ба?
Dialogue: 0,0:09:57.91,0:09:58.51,JPsub,NTP,0,0,0,,О
Dialogue: 0,0:09:58.83,0:10:00.00,JPsub,NTP,0,0,0,,Басқалардан гөрі қаттырақ айқайлап тұр
Dialogue: 0,0:10:00.99,0:10:02.79,JPsub,NTP,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:10:04.69,0:10:08.03,JPsub,NTP,0,0,0,,Мияджо ғимараты 1970 жылдардағы жоғары экономикалық өсу кезеңінде салынған.
Dialogue: 0,0:10:08.22,0:10:11.26,JPsub,NTP,0,0,0,,Осы қаланың символдық мұнарасы ретінде салынған ғимараттар тобы.
Dialogue: 0,0:10:12.10,0:10:14.98,JPsub,NTP,0,0,0,,Бір кездері оның биіктігі мен бақылау алаңы келушілерді қызықтыратын.
Dialogue: 0,0:10:15.47,0:10:17.13,JPsub,NTP,0,0,0,,Қазір қартаюда.
Dialogue: 0,0:10:17.33,0:10:19.53,JPsub,NTP,0,0,0,,Біз оны көп жыл бұрын алып тастауды шештік.
Dialogue: 0,0:10:20.22,0:10:23.60,JPsub,NTP,0,0,0,,Жақында ғана барлық ғимараттар босатылды.
Dialogue: 0,0:10:24.26,0:10:25.54,JPsub,NTP,0,0,0,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:10:26.07,0:10:29.21,JPsub,NTP,0,0,0,,Не айтайын, ол жақта уақыт өтіп жатыр.
Dialogue: 0,0:10:29.93,0:10:32.02,JPsub,NTP,0,0,0,,Менің ойымша, сіз бұйрық кері деп айта аласыз.
Dialogue: 0,0:10:32.54,0:10:34.85,JPsub,NTP,0,0,0,,Адам жады немесе жазба?
Dialogue: 0,0:10:35.56,0:10:39.21,JPsub,NTP,0,0,0,,Сол ғимаратта уақыт оны жазу арқылы баяу өтеді.
Dialogue: 0,0:10:39.81,0:10:44.64,JPsub,NTP,0,0,0,,Олардың өмірінің жазбалары бұрынғы уақытына әлі жеткен жоқ.
Dialogue: 0,0:10:45.16,0:10:47.82,JPsub,NTP,0,0,0,,Нәтиже Тек ойлар өмір сүреді
Dialogue: 0,0:10:49.40,0:10:53.15,JPsub,NTP,0,0,0,,Адам өлсе де, есінде қалғаны ғана
Dialogue: 0,0:10:57.01,0:11:00.67,JPsub,NTP,0,0,0,,Кенеттен ештеңе болмайды Өртті сөндірсең де, түтін кенет сөнбейді.
Dialogue: 0,0:11:03.99,0:11:04.81,JPsub,NTP,0,0,0,,Эй өрнек
Dialogue: 0,0:11:05.35,0:11:07.08,JPsub,NTP,0,0,0,,Биік жерден көрінетін табиғат көрінісі
Dialogue: 0,0:11:07.36,0:11:09.05,JPsub,NTP,0,0,0,,Бұл сізге нені еске түсіреді деп ойлайсыз?
Dialogue: 0,0:11:09.79,0:11:13.49,JPsub,NTP,0,0,0,,Өзіңіз өмір сүріп жатқан әлемге қараған кездегі сіз сезінетін талпыныс
Dialogue: 0,0:11:14.02,0:11:16.31,JPsub,NTP,0,0,0,,Тіпті адам одан бас тартса да
Dialogue: 0,0:11:16.51,0:11:19.54,JPsub,NTP,0,0,0,,тану кенеттен жасалған зорлық-зомбылық сияқты
Dialogue: 0,0:11:20.20,0:11:22.48,JPsub,NTP,0,0,0,,Құспен қарау арқылы туындаған эмоциялар
Dialogue: 0,0:11:24.59,0:11:27.28,JPsub,NTP,0,0,0,,Бұл алыс.
Dialogue: 0,0:11:28.60,0:11:30.83,JPsub,NTP,0,0,0,,Биіктен көрініс керемет.
Dialogue: 0,0:11:31.57,0:11:34.37,JPsub,NTP,0,0,0,,Кәдімгі көріністің өзі керемет сезінеді.
Dialogue: 0,0:11:38.99,0:11:45.03,JPsub,NTP,0,0,0,,Дегенмен, тым кең көзқарас өрісі басқа әлемнен айқын бөлінуді тудыруы мүмкін.
Dialogue: 0,0:11:46.00,0:11:48.14,JPsub,NTP,0,0,0,,Сіз сезіне алатын тар кеңістіктен
Dialogue: 0,0:11:48.49,0:11:53.99,JPsub,NTP,0,0,0,,Бастапқыда біз көретін кең пейзажды ``біз өмір сүріп жатқан әлем'' деп тану дұрыс.
Dialogue: 0,0:11:54.47,0:11:59.80,JPsub,NTP,0,0,0,,Дегенмен, мен осы кең әлемде бар екенімді сезе алмаймын.
Dialogue: 0,0:12:01.83,0:12:06.62,JPsub,NTP,0,0,0,,Дәл осы жерде білім сияқты ақыл мен тәжірибе сияқты шындық қайшылыққа түседі.
Dialogue: 0,0:12:06.95,0:12:10.44,JPsub,NTP,0,0,0,,Ақырында біреуі тозып, шатасу басталады.
Dialogue: 0,0:12:11.91,0:12:12.94,JPsub,NTP,0,0,0,,Содан кейін
Dialogue: 0,0:12:20.55,0:12:23.16,JPsub,NTP,0,0,0,,Көру – бұл көз алмасы түсіретін сурет емес.
Dialogue: 0,0:12:23.42,0:12:24.97,JPsub,NTP,0,0,0,,Ми түсінетін бейнелер
Dialogue: 0,0:12:25.67,0:12:29.51,JPsub,NTP,0,0,0,,Біздің көзқарасымыз ақыл-парасатымызбен қорғалады.
Dialogue: 0,0:12:30.63,0:12:34.36,JPsub,NTP,0,0,0,,Адамдар өз қораптарынан тыс өмір сүре алмайды.
Dialogue: 0,0:12:35.12,0:12:36.25,JPsub,NTP,0,0,0,,Бастапқыда
Dialogue: 0,0:12:37.51,0:12:38.89,JPsub,NTP,0,0,0,,Жаңалық келді.
Dialogue: 0,0:12:39.39,0:12:42.67,JPsub,NTP,0,0,0,,Мияджо ғимаратында тағы бір суицид орын алған сияқты.
Dialogue: 0,0:12:43.03,0:12:46.61,JPsub,NTP,0,0,0,,Алтыншы адам, тағы екі?
Dialogue: 0,0:12:49.86,0:12:51.78,JPsub,NTP,0,0,0,,Қарым-қатынас бар ма?
Dialogue: 0,0:12:52.02,0:12:52.63,JPsub,NTP,0,0,0,,Жоқ.
Dialogue: 0,0:12:52.77,0:12:59.08,JPsub,NTP,0,0,0,,Оның бүкіл денесі қатты соққыға жығылды және ол ашылған кезде ес-түссіз жатқан, ауруханаға барар жолда қайтыс болғаны расталды.
Dialogue: 0,0:13:00.27,0:13:00.98,JPsub,NTP,0,0,0,,Жоқ
Dialogue: 0,0:12:59.31,0:13:02.66,JPsub,NTP,0,0,0,,Қазір өз-өзіне қол жұмсаған алты адам бар.
Dialogue: 0,0:13:21.40,0:13:23.68,JPsub,NTP,0,0,0,,Өлімнің бастапқы жоспары
Dialogue: 0,0:13:24.93,0:13:27.71,JPsub,NTP,0,0,0,,Екеуі біраз уақыт сонда дүкен аралады.
Dialogue: 0,0:13:28.08,0:13:31.13,JPsub,NTP,0,0,0,,Жол-көлік оқиғасына ұшырау жолы болмай қалғандай.
Dialogue: 0,0:13:34.43,0:13:35.32,JPsub,NTP,0,0,0,,Мүлдем
Dialogue: 0,0:13:37.65,0:13:41.79,JPsub,NTP,0,0,0,,Менің балам үйге қашан келеді?
Dialogue: 0,0:14:38.92,0:14:39.55,JPsub,NTP,0,0,0,,Қара пауловния
Dialogue: 0,0:16:37.28,0:16:37.94,JPsub,NTP,0,0,0,,Кеттік
Dialogue: 0,0:17:25.56,0:17:27.82,JPsub,NTP,0,0,0,,Ол үнемі армандайды
Dialogue: 0,0:17:28.32,0:17:30.36,JPsub,NTP,0,0,0,,Әрқашан түзетілген
Dialogue: 0,0:17:32.85,0:17:36.16,JPsub,NTP,0,0,0,,Осылайша сіз қаласаңыз, кез келген жерге ұша аласыз.
Dialogue: 0,0:17:40.67,0:17:43.26,JPsub,NTP,0,0,0,,Мен оның мені алып кетуін қалаймын
Dialogue: 0,0:17:46.61,0:17:48.10,JPsub,NTP,0,0,0,,Сіз ұша аласыз
Dialogue: 0,0:17:48.62,0:17:51.70,JPsub,NTP,0,0,0,,Сіз түсінбейсіз
Dialogue: 0,0:18:34.53,0:18:38.87,JPsub,NTP,0,0,0,,Түсіндім, бұл керемет ерлік.
Dialogue: 0,0:18:40.87,0:18:44.45,JPsub,NTP,0,0,0,,Сөзбе-сөз біреу алынды.
Dialogue: 0,0:18:45.09,0:18:46.21,JPsub,NTP,0,0,0,,Бұл Туконың кінәсі.
Dialogue: 0,0:18:46.51,0:18:48.15,JPsub,NTP,0,0,0,,Неліктен бұл деңгейде бұзылады?
Dialogue: 0,0:18:48.98,0:18:51.62,JPsub,NTP,0,0,0,,Егер бұл менің кінәм болса, онда мәселе жоқ.
Dialogue: 0,0:18:52.86,0:18:53.89,JPsub,NTP,0,0,0,,Мен есімде сақтамасам да,
Dialogue: 0,0:18:55.80,0:18:56.70,JPsub,NTP,0,0,0,,Жоқ.
Dialogue: 0,0:18:58.52,0:19:01.55,JPsub,NTP,0,0,0,,Бірақ Асагами Фуджино оқиғасынан бері әлі бір ай өтті.
Dialogue: 0,0:19:02.20,0:19:05.50,JPsub,NTP,0,0,0,,Протездік қолды қолданғанда абай болыңыз
Dialogue: 0,0:19:06.84,0:19:07.88,JPsub,NTP,0,0,0,,Бұдан былай
Dialogue: 0,0:19:08.53,0:19:09.83,JPsub,NTP,0,0,0,,Бұл жақсы идея.
Dialogue: 0,0:19:23.59,0:19:24.60,JPsub,NTP,0,0,0,,Эй өрнек
Dialogue: 0,0:19:25.61,0:19:29.91,JPsub,NTP,0,0,0,,If you take the time and effort to make dolls and prosthetic arms,
Dialogue: 0,0:19:30.28,0:19:33.35,JPsub,NTP,0,0,0,,You can get as close to success as you want
Dialogue: 0,0:19:34.21,0:19:37.54,JPsub,NTP,0,0,0,,But without a soul to move it
Dialogue: 0,0:19:37.85,0:19:39.34,JPsub,NTP,0,0,0,,Бұл жай ғана ыдыс
Dialogue: 0,0:19:40.49,0:19:42.64,JPsub,NTP,0,0,0,,The same goes for the human body.
Dialogue: 0,0:19:43.31,0:19:46.68,JPsub,NTP,0,0,0,,The body itself, which has become a shell of a soul, has no meaning.
Dialogue: 0,0:19:48.18,0:19:49.54,JPsub,NTP,0,0,0,,Жай ғана ыдыс
Dialogue: 0,0:19:50.26,0:19:51.66,JPsub,NTP,0,0,0,,Бұл жай ғана қабық
Dialogue: 0,0:19:53.15,0:19:55.50,JPsub,NTP,0,0,0,,Just like you used to be
Dialogue: 0,0:19:57.90,0:20:00.64,JPsub,NTP,0,0,0,,Did you know the story of when Kurogiri first came here?
Dialogue: 0,0:20:01.32,0:20:02.13,JPsub,NTP,0,0,0,,Жоқ
Dialogue: 0,0:20:02.39,0:20:04.92,JPsub,NTP,0,0,0,,He suddenly asked me to hire him.
Dialogue: 0,0:20:06.16,0:20:10.19,JPsub,NTP,0,0,0,,You saw my doll at an exhibition somewhere and fell in love with it.
Dialogue: 0,0:20:11.35,0:20:15.59,JPsub,NTP,0,0,0,,I started with no contact information and ended up here.
Dialogue: 0,0:20:16.36,0:20:19.66,JPsub,NTP,0,0,0,,In this “garan hall” with a barrier to avoid people.
Dialogue: 0,0:20:21.11,0:20:24.31,JPsub,NTP,0,0,0,,During the interview, I kept my eyes on the doll.
Dialogue: 0,0:20:26.62,0:20:28.10,JPsub,NTP,0,0,0,,Doll sitting on its edge
Dialogue: 0,0:20:28.99,0:20:31.44,JPsub,NTP,0,0,0,,That was Kurogiri's favorite back then.
Dialogue: 0,0:20:34.62,0:20:39.78,JPsub,NTP,0,0,0,,He might have been looking at your sky as my doll.
Dialogue: 0,0:20:42.31,0:20:48.44,JPsub,NTP,0,0,0,,He's obsessed with dolls. I told him to stay away from the Miyajo Building.
Dialogue: 0,0:20:58.51,0:20:59.34,JPsub,NTP,0,0,0,,Шығыс Одақпен ешқандай ойынға жол жоқ!
Dialogue: 0,0:21:12.25,0:21:13.11,JPsub,NTP,0,0,0,,Good morning ceremony
Dialogue: 0,0:21:13.89,0:21:16.53,JPsub,NTP,0,0,0,,You know the story of the suicide by throwing yourself in the Miyajo building, right?
Dialogue: 0,0:21:17.31,0:21:20.06,JPsub,NTP,0,0,0,,Mr. Touko wants to talk to you about that.
Dialogue: 0,0:21:21.46,0:21:25.05,JPsub,NTP,0,0,0,,That's right, I'd like you to buy me some coffee when you come here.
Dialogue: 0,0:21:25.67,0:21:26.78,JPsub,NTP,0,0,0,,Leave the name to me.
Dialogue: 0,0:21:27.66,0:21:28.37,JPsub,NTP,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:21:29.97,0:21:34.30,JPsub,NTP,0,0,0,,August 4th, 7:51 a.m.
Dialogue: 0,0:21:35.79,0:21:37.80,JPsub,NTP,0,0,0,,Осының бәрі хабар үшін
Dialogue: 0,0:23:20.33,0:23:21.22,JPsub,NTP,0,0,0,,Оны жылжытып көріңіз.
Dialogue: 0,0:23:27.94,0:23:31.28,JPsub,NTP,0,0,0,,You may still feel strange, but you'll get used to it soon.
Dialogue: 0,0:23:33.95,0:23:35.19,JPsub,NTP,0,0,0,,Double projectile fire
Dialogue: 0,0:23:35.70,0:23:37.06,JPsub,NTP,0,0,0,,This time it's sturdy.
Dialogue: 0,0:23:37.59,0:23:39.78,JPsub,NTP,0,0,0,,Unbreakable unless stepped on by an Indian elephant
Dialogue: 0,0:23:45.02,0:23:45.95,JPsub,NTP,0,0,0,,Жақсы қол.
Dialogue: 0,0:23:50.04,0:23:53.07,JPsub,NTP,0,0,0,,Is this the result of ignoring Touko's advice?
Dialogue: 0,0:23:54.90,0:23:56.05,JPsub,NTP,0,0,0,,It's your own fault.
Dialogue: 0,0:23:58.75,0:24:00.25,JPsub,NTP,0,0,0,,Сіз мені алып кетпейсіз бе?
Dialogue: 0,0:25:30.92,0:25:31.61,JPsub,NTP,0,0,0,,...
Dialogue: 0,0:25:32.33,0:25:35.30,JPsub,NTP,0,0,0,,This guy is definitely magical.
Dialogue: 0,0:25:39.65,0:25:40.45,JPsub,NTP,0,0,0,,Егер
Dialogue: 0,0:25:42.53,0:25:44.07,JPsub,NTP,0,0,0,,Мен сені өлтіруім керек
Dialogue: 0,0:27:43.09,0:27:44.66,JPsub,NTP,0,0,0,,No feet on the ground
Dialogue: 0,0:27:45.64,0:27:46.83,JPsub,NTP,0,0,0,,Ол ұшып жатыр ма?
Dialogue: 0,0:27:49.48,0:27:50.63,JPsub,NTP,0,0,0,,Ол қалқып тұр ма?
Dialogue: 0,0:28:15.31,0:28:16.64,JPsub,NTP,0,0,0,,Suggestion does not work
Dialogue: 0,0:28:17.34,0:28:20.24,JPsub,NTP,0,0,0,,Бастапқыда менде мұндай сағыныш болған жоқ.
Dialogue: 0,0:28:20.75,0:28:22.03,JPsub,NTP,0,0,0,,Тірі сезіну
Dialogue: 0,0:28:22.33,0:28:23.90,JPsub,NTP,0,0,0,,Мен өмірдің азабын білмеймін
Dialogue: 0,0:28:24.96,0:28:25.60,JPsub,NTP,0,0,0,,О
Dialogue: 0,0:28:25.92,0:28:28.06,JPsub,NTP,0,0,0,,Негізі мен саған бәрібір емеспін.
Dialogue: 0,0:28:28.66,0:28:29.21,JPsub,NTP,0,0,0,,Бірақ
Dialogue: 0,0:28:29.50,0:28:31.73,JPsub,NTP,0,0,0,,Оны алып кетсе қиын болар еді.
Dialogue: 0,0:28:32.09,0:28:34.09,JPsub,NTP,0,0,0,,Бұл бірінші болды.
Dialogue: 0,0:28:35.13,0:28:36.46,JPsub,NTP,0,0,0,,Мен оны қайтарып аламын.
Dialogue: 0,0:28:40.94,0:28:41.77,JPsub,NTP,0,0,0,,Құлау
Dialogue: 0,0:28:42.70,0:28:43.44,JPsub,NTP,0,0,0,,Құлау
Dialogue: 0,0:28:43.92,0:28:44.72,JPsub,NTP,0,0,0,,Құлау
Dialogue: 0,0:28:45.08,0:28:45.77,JPsub,NTP,0,0,0,,Құлау.
Dialogue: 0,0:28:46.01,0:28:46.63,JPsub,NTP,0,0,0,,Құлау.
Dialogue: 0,0:28:46.91,0:28:47.68,JPsub,NTP,0,0,0,,Құлау.
Dialogue: 0,0:28:47.86,0:28:48.88,JPsub,NTP,0,0,0,,Құлау.
Dialogue: 0,0:28:54.15,0:28:55.54,JPsub,NTP,0,0,0,,Сен құладың
Dialogue: 0,0:29:04.49,0:29:05.53,JPsub,NTP,0,0,0,,Сүйектер?
Dialogue: 0,0:29:06.96,0:29:07.90,JPsub,NTP,0,0,0,,Бұл лалагүл.
Dialogue: 0,0:29:54.17,0:29:55.03,JPsub,NTP,0,0,0,,Қазір
Dialogue: 0,0:30:06.57,0:30:07.60,JPsub,NTP,0,0,0,,Бұл
Dialogue: 0,0:30:10.17,0:30:13.20,JPsub,NTP,0,0,0,,Бұл тамаша көрініс.
Dialogue: 0,0:30:14.35,0:30:15.20,JPsub,NTP,0,0,0,,О
Dialogue: 0,0:30:15.69,0:30:20.42,JPsub,NTP,0,0,0,,Ай бүгін түнде әдемі болады.
Dialogue: 0,0:30:21.24,0:30:22.11,JPsub,NTP,0,0,0,,О
Dialogue: 0,0:30:25.52,0:30:26.40,JPsub,NTP,0,0,0,,Күтілгендей
Dialogue: 0,0:30:28.51,0:30:32.64,JPsub,NTP,0,0,0,,Маған осы жерден көрініс ұнайды.
Dialogue: 0,0:30:34.21,0:30:39.38,JPsub,NTP,0,0,0,,Шие гүлдері, көктемгі шие гүлдері сондай әдемі.
Dialogue: 0,0:30:40.71,0:30:42.53,JPsub,NTP,0,0,0,,Көк аспанда жапырақшалар шашылады
Dialogue: 0,0:30:43.11,0:30:45.31,JPsub,NTP,0,0,0,,Аспанда жайнаған гүлдердей
Dialogue: 0,0:30:46.94,0:30:48.60,JPsub,NTP,0,0,0,,Мен сені келесі жылы да көремін деп үміттенемін.
Dialogue: 0,0:30:53.75,0:30:56.68,JPsub,NTP,0,0,0,,Сен менің жауымсың
Dialogue: 0,0:30:57.76,0:30:58.54,JPsub,NTP,0,0,0,,О
Dialogue: 0,0:30:59.10,0:31:03.00,JPsub,NTP,0,0,0,,Мен саған қол көтерген адам мен саған қол көтерген адамның танысымын.
Dialogue: 0,0:31:03.79,0:31:05.63,JPsub,NTP,0,0,0,,Менің сізге қояйын деген бірнеше сұрағым бар.
Dialogue: 0,0:31:05.90,0:31:09.71,JPsub,NTP,0,0,0,,Мен сіздің жағдайыңызды білемін, сондықтан сізді мәжбүрлемеймін.
Dialogue: 0,0:31:11.17,0:31:12.03,JPsub,NTP,0,0,0,,Хе, өтінемін.
Dialogue: 0,0:31:12.20,0:31:13.12,JPsub,NTP,0,0,0,,Шынымен
Dialogue: 0,0:31:20.76,0:31:23.71,JPsub,NTP,0,0,0,,Атыңызды сұрасам бола ма?
Dialogue: 0,0:31:24.09,0:31:24.91,JPsub,NTP,0,0,0,,Бұл қызғылт сары
Dialogue: 0,0:31:27.54,0:31:29.16,JPsub,NTP,0,0,0,,Тоуко Аозаки
Dialogue: 0,0:31:31.18,0:31:32.04,JPsub,NTP,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:31:32.45,0:31:33.20,JPsub,NTP,0,0,0,,Тооко-сан
Dialogue: 0,0:31:34.06,0:31:34.75,JPsub,NTP,0,0,0,,О
Dialogue: 0,0:31:37.12,0:31:38.65,JPsub,NTP,0,0,0,,Сіз мұнда қанша уақыт болдыңыз?
Dialogue: 0,0:31:39.56,0:31:40.57,JPsub,NTP,0,0,0,,Шынында да солай емес пе?
Dialogue: 0,0:31:41.96,0:31:44.84,JPsub,NTP,0,0,0,,ұзақ уақыт
Dialogue: 0,0:31:46.06,0:31:49.57,JPsub,NTP,0,0,0,,Every day I just looked outside.
Dialogue: 0,0:31:51.18,0:31:54.71,JPsub,NTP,0,0,0,,Күн сайын осы терезеден
Dialogue: 0,0:31:55.42,0:31:56.79,JPsub,NTP,0,0,0,,Тек осы көрініс
Dialogue: 0,0:31:58.29,0:31:59.09,JPsub,NTP,0,0,0,,Бұл өте ауыр.
Dialogue: 0,0:32:01.17,0:32:01.86,JPsub,NTP,0,0,0,,Бірақ
Dialogue: 0,0:32:02.61,0:32:05.58,JPsub,NTP,0,0,0,,Өйткені бұл көрініс ешқашан жоғалмайды
Dialogue: 0,0:32:08.51,0:32:10.00,JPsub,NTP,0,0,0,,Мен сені қанша жек көрсем де
Dialogue: 0,0:32:11.01,0:32:13.60,JPsub,NTP,0,0,0,,Өйткені менде бар нәрсе осы
Dialogue: 0,0:32:15.03,0:32:17.16,JPsub,NTP,0,0,0,,So I kept looking out the window
Dialogue: 0,0:32:17.95,0:32:20.29,JPsub,NTP,0,0,0,,And take this scenery into your brain
Dialogue: 0,0:32:20.46,0:32:21.96,JPsub,NTP,0,0,0,,Obtained a bird's eye view
Dialogue: 0,0:32:23.63,0:32:24.58,JPsub,NTP,0,0,0,,Байқасаңыз
Dialogue: 0,0:32:25.20,0:32:27.20,JPsub,NTP,0,0,0,,My eyes were on the sky
Dialogue: 0,0:32:28.77,0:32:31.14,JPsub,NTP,0,0,0,,Сол кезде сіздің көзіңіз көрмей қалды ма?
Dialogue: 0,0:32:32.13,0:32:32.92,JPsub,NTP,0,0,0,,Иә
Dialogue: 0,0:32:33.44,0:32:35.36,JPsub,NTP,0,0,0,,Eyes can no longer see anything
Dialogue: 0,0:32:36.20,0:32:36.87,JPsub,NTP,0,0,0,,Бірақ
Dialogue: 0,0:32:37.68,0:32:40.78,JPsub,NTP,0,0,0,,My landscape did not change
Dialogue: 0,0:32:41.91,0:32:42.63,JPsub,NTP,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:32:43.16,0:32:45.37,JPsub,NTP,0,0,0,,Your consciousness was in the sky.
Dialogue: 0,0:32:46.38,0:32:49.17,JPsub,NTP,0,0,0,,Бірақ егер Мияджо ғимаратының елесі сіздің санаңыз болса?
Dialogue: 0,0:32:49.63,0:32:51.93,JPsub,NTP,0,0,0,,You should have been killed by now.
Dialogue: 0,0:32:53.05,0:32:55.82,JPsub,NTP,0,0,0,,I am not myself in Miyajo Building
Dialogue: 0,0:32:56.44,0:32:57.06,JPsub,NTP,0,0,0,,Иә
Dialogue: 0,0:32:57.60,0:33:00.64,JPsub,NTP,0,0,0,,I am empty and gone
Dialogue: 0,0:33:01.81,0:33:04.84,JPsub,NTP,0,0,0,,Give up on me in the box
Dialogue: 0,0:33:05.82,0:33:08.06,JPsub,NTP,0,0,0,,Personality split into two
Dialogue: 0,0:33:08.74,0:33:09.79,JPsub,NTP,0,0,0,,I can't explain it
Dialogue: 0,0:33:10.62,0:33:14.04,JPsub,NTP,0,0,0,,Сіз бір тұлғалы екі денені басқардыңыз.
Dialogue: 0,0:33:14.55,0:33:18.53,JPsub,NTP,0,0,0,,Сіз бір кезіңізде екінші ыдысты сізге берген біреу болды.
Dialogue: 0,0:33:20.82,0:33:25.76,JPsub,NTP,0,0,0,,Dual existence That's what he called it.
Dialogue: 0,0:33:26.52,0:33:31.15,JPsub,NTP,0,0,0,,Бірақ неге сыртқы дүниенің жай ғана көріністері сізді қанағаттандырмады?
Dialogue: 0,0:33:31.99,0:33:35.01,JPsub,NTP,0,0,0,,Оларды тастаудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:33:37.06,0:33:40.17,JPsub,NTP,0,0,0,,Those kids were flying around me.
Dialogue: 0,0:33:41.23,0:33:43.18,JPsub,NTP,0,0,0,,I thought we could be friends
Dialogue: 0,0:33:44.83,0:33:49.22,JPsub,NTP,0,0,0,,But those kids didn't notice me.
Dialogue: 0,0:33:50.29,0:33:52.28,JPsub,NTP,0,0,0,,Әрине, сана жоқ болғандықтан.
Dialogue: 0,0:33:52.41,0:33:56.11,JPsub,NTP,0,0,0,,So if you call out to me
Dialogue: 0,0:33:57.70,0:34:02.02,JPsub,NTP,0,0,0,,Мен сені санаға қондырсам, мені байқайсың деп ойладым.
Dialogue: 0,0:34:03.18,0:34:07.09,JPsub,NTP,0,0,0,,Мен мұндамын Мен осындамын
Dialogue: 0,0:34:08.00,0:34:09.16,JPsub,NTP,0,0,0,,Барлығы осы
Dialogue: 0,0:34:12.30,0:34:13.31,JPsub,NTP,0,0,0,,Неліктен?
Dialogue: 0,0:34:14.67,0:34:17.84,JPsub,NTP,0,0,0,,Was it a companion who took my boy?
Dialogue: 0,0:34:21.44,0:34:24.85,JPsub,NTP,0,0,0,,I met him in the hospital hallway.
Dialogue: 0,0:34:26.09,0:34:29.58,JPsub,NTP,0,0,0,,At the same time every week
Dialogue: 0,0:34:31.41,0:34:34.85,JPsub,NTP,0,0,0,,Carrying a beautiful bouquet of flowers
Dialogue: 0,0:34:39.98,0:34:48.32,JPsub,NTP,0,0,0,,I wanted you to take me with you.
Dialogue: 0,0:35:08.41,0:35:12.86,JPsub,NTP,0,0,0,,And that person, Touko Aosaki, is gone.
Dialogue: 0,0:35:15.92,0:35:17.61,JPsub,NTP,0,0,0,,There are two types of escape.
Dialogue: 0,0:35:18.41,0:35:21.23,JPsub,NTP,0,0,0,,Мақсатсыз қашу және мақсатпен қашу
Dialogue: 0,0:35:22.00,0:35:23.97,JPsub,NTP,0,0,0,,The former is generally called floating.
Dialogue: 0,0:35:24.39,0:35:25.80,JPsub,NTP,0,0,0,,The latter is called flight.
Dialogue: 0,0:35:26.94,0:35:29.03,JPsub,NTP,0,0,0,,Which is your bird's-eye view?
Dialogue: 0,0:35:29.17,0:35:30.69,JPsub,NTP,0,0,0,,Шешім өз еркіңізде
Dialogue: 0,0:35:31.46,0:35:32.03,JPsub,NTP,0,0,0,,Бірақ
Dialogue: 0,0:35:32.63,0:35:35.37,JPsub,NTP,0,0,0,,Ар-ұжданмен таңдасаңыз
Dialogue: 0,0:35:35.76,0:35:37.05,JPsub,NTP,0,0,0,,Бұл қате.
Dialogue: 0,0:35:38.55,0:35:41.85,JPsub,NTP,0,0,0,,Біз өз жолымызды көтерген күнәларымызға қарай таңдамаймыз;
Dialogue: 0,0:35:42.65,0:35:45.39,JPsub,NTP,0,0,0,,Өйткені таңдаған жолыңыздың кінәсін көтеру керек.
Dialogue: 0,0:35:46.90,0:35:48.99,JPsub,NTP,0,0,0,,Бұл оның соңғы сөздері болды
Dialogue: 0,0:35:50.19,0:35:51.29,JPsub,NTP,0,0,0,,Бірақ шын мәнінде
Dialogue: 0,0:35:51.76,0:35:55.08,JPsub,NTP,0,0,0,,Ол менің нәтижем қандай болатынын білетініне сенімдімін.
Dialogue: 0,0:35:56.53,0:35:58.28,JPsub,NTP,0,0,0,,Өйткені мен ұша алмадым
Dialogue: 0,0:35:59.11,0:36:01.03,JPsub,NTP,0,0,0,,Ол жай ғана қалқып тұрды.
Dialogue: 0,0:36:03.19,0:36:04.51,JPsub,NTP,0,0,0,,Себебі мен әлсізмін
Dialogue: 0,0:36:05.15,0:36:07.08,JPsub,NTP,0,0,0,,Мен ол кісінің айтқанын істей алмаймын.
Dialogue: 0,0:36:08.33,0:36:11.16,JPsub,NTP,0,0,0,,Сондықтан мен бұл азғыруға қарсы тұра алмаймын
Dialogue: 0,0:36:13.76,0:36:14.70,JPsub,NTP,0,0,0,,Бәрі сол қорқақтың кесірінен.
Dialogue: 0,0:36:15.31,0:36:18.33,JPsub,NTP,0,0,0,,Жарқылдың жарқырауы Жүрегімді тескен сәтте сездім
Dialogue: 0,0:36:19.15,0:36:21.96,JPsub,NTP,0,0,0,,Өлімнің тасқыны мен өмірдің жүрек соғысы
Dialogue: 0,0:36:23.56,0:36:25.81,JPsub,NTP,0,0,0,,Менде ештеңе жоқ деп ойладым, бірақ
Dialogue: 0,0:36:26.49,0:36:29.60,JPsub,NTP,0,0,0,,Қарапайым және маңызды нәрсе әлі де қалады.
Dialogue: 0,0:36:31.38,0:36:32.38,JPsub,NTP,0,0,0,,Алайда
Dialogue: 0,0:36:32.69,0:36:35.52,JPsub,NTP,0,0,0,,Бұлай өлу мүмкін емес еді.
Dialogue: 0,0:36:37.79,0:36:41.74,JPsub,NTP,0,0,0,,Мен мұндай жарқын аяқталуға ешқашан үміттенбейтін шығармын.
Dialogue: 0,0:36:42.69,0:36:48.03,JPsub,NTP,0,0,0,,Мені инедей, қылыштай, найзағайдай тесіп өтті.
Dialogue: 0,0:36:48.30,0:36:49.24,JPsub,NTP,0,0,0,,Сол өлімде
Dialogue: 0,0:36:50.73,0:36:54.07,JPsub,NTP,0,0,0,,Сондықтан мен оған барынша жақындауға тырысамын.
Dialogue: 0,0:36:55.18,0:36:56.11,JPsub,NTP,0,0,0,,Жарайды
Dialogue: 0,0:36:56.45,0:36:58.17,JPsub,NTP,0,0,0,,Тек әдіс шешілді.
Dialogue: 0,0:37:00.82,0:37:02.27,JPsub,NTP,0,0,0,,Бұл айтпаса да түсінікті
Dialogue: 0,0:37:14.54,0:37:19.26,JPsub,NTP,0,0,0,,Менің ойымша, құстың көзінен құлап өлгенім жақсы болар еді.
Dialogue: 0,0:37:32.81,0:37:37.11,JPsub,NTP,0,0,0,,Сәлеметсіз бе, 31 тамыз Менің бөлісетін жаңалығым бар.
Dialogue: 0,0:37:37.55,0:37:40.15,JPsub,NTP,0,0,0,,Алдымен кең жағу туралы айтайық.
Dialogue: 0,0:37:40.60,0:37:44.59,JPsub,NTP,0,0,0,,Өткен айда болған тайфун салдарынан болған кең өртке қатысты...
Dialogue: 0,0:37:48.68,0:37:50.02,JPsub,NTP,0,0,0,,Қайырлы таң Куротоу
Dialogue: 0,0:37:51.77,0:37:53.57,JPsub,NTP,0,0,0,,Қайырлы таң, Туко-сан.
Dialogue: 0,0:37:55.02,0:37:55.83,JPsub,NTP,0,0,0,,Кешіріңіз
Dialogue: 0,0:37:56.37,0:37:57.80,JPsub,NTP,0,0,0,,Мен ұйықтап қалдым деп ойлаймын.
Dialogue: 0,0:37:58.29,0:37:59.96,JPsub,NTP,0,0,0,,Қызықсыз нәрселерді түсіндірмеңіз
Dialogue: 0,0:38:00.17,0:38:01.13,JPsub,NTP,0,0,0,,Оны көргенде білесің
Dialogue: 0,0:38:02.12,0:38:02.87,JPsub,NTP,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:38:03.24,0:38:05.20,JPsub,NTP,0,0,0,,Енді маған шай бере аласыз ба?
Dialogue: 0,0:38:05.42,0:38:06.51,JPsub,NTP,0,0,0,,Маған кофе ұнайды.
Dialogue: 0,0:38:06.84,0:38:08.05,JPsub,NTP,0,0,0,,Жақсы оңалту
Dialogue: 0,0:38:08.87,0:38:09.88,JPsub,NTP,0,0,0,,шұғыл басымдық ретінде қарастырылып, ақпарат іздестіруде
Dialogue: 0,0:38:10.68,0:38:11.74,JPsub,NTP,0,0,0,,шұғыл басымдық ретінде қарастырылып, ақпарат іздестіруде
Dialogue: 0,0:38:13.48,0:38:15.58,JPsub,NTP,0,0,0,,Оңалту
Dialogue: 0,0:38:23.69,0:38:27.18,JPsub,NTP,0,0,0,,Бұл Мияджо ғимаратындағы суицидтердің санын сегізге дейін жеткізеді.
Dialogue: 0,0:38:27.82,0:38:32.15,JPsub,NTP,0,0,0,,Зерттеулерге қарағанда, алдыңғы жеті сияқты, ерік-жігер болмаған.
Dialogue: 0,0:38:28.91,0:38:29.55,JPsub,NTP,0,0,0,,Бұл
Dialogue: 0,0:38:29.89,0:38:30.61,JPsub,NTP,0,0,0,,Сегіз адам
Dialogue: 0,0:38:30.89,0:38:31.74,JPsub,NTP,0,0,0,,Сәлем Туко
Dialogue: 0,0:38:32.08,0:38:33.47,JPsub,NTP,0,0,0,,Егер сіз баяу ұшсаңыз
Dialogue: 0,0:38:33.96,0:38:37.06,JPsub,NTP,0,0,0,,Адамдардың тағдыры осындай мақсатқа сай ма?
Dialogue: 0,0:38:37.98,0:38:41.55,JPsub,NTP,0,0,0,,Бұрын ешкім тек адам күшін пайдаланып ұшуға әрекеттенген емес.
Dialogue: 0,0:38:42.14,0:38:45.23,JPsub,NTP,0,0,0,,Ұшу және апат сөздері байланысты.
Dialogue: 0,0:38:45.97,0:38:47.91,JPsub,NTP,0,0,0,,Бірақ аспанға жеткен адам
Dialogue: 0,0:38:48.06,0:38:49.87,JPsub,NTP,0,0,0,,Бұл факт жоқ.
Dialogue: 0,0:38:50.90,0:38:54.76,JPsub,NTP,0,0,0,,Нәтижесінде өлгеннен кейін де бұлттардың үстінен ұшуға тура келеді.
Dialogue: 0,0:38:55.03,0:38:56.73,JPsub,NTP,0,0,0,,Жерге құламай
Dialogue: 0,0:38:56.96,0:38:58.38,JPsub,NTP,0,0,0,,Аспанға түскендей
Dialogue: 0,0:38:59.11,0:39:01.14,JPsub,NTP,0,0,0,,Осы суретте олар мінсіз жұп сияқты көрінеді, иә?
Dialogue: 0,0:39:01.32,0:39:02.62,JPsub,NTP,0,0,0,,Мен оқиғаны көре алмаймын.
Dialogue: 0,0:39:03.37,0:39:04.24,JPsub,NTP,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:39:04.77,0:39:07.55,JPsub,NTP,0,0,0,,Мияджо ғимаратында қалқыған адам бар.
Dialogue: 0,0:39:07.82,0:39:11.80,JPsub,NTP,0,0,0,,Секіру арқылы өз-өзіне қол жұмсаған қыздардың елесі ұшып жүрді.
Dialogue: 0,0:39:12.02,0:39:13.47,JPsub,NTP,0,0,0,,Сан сегіз.
Dialogue: 0,0:39:14.00,0:39:15.46,JPsub,NTP,0,0,0,,Олар ұшты ма?
Dialogue: 0,0:39:15.58,0:39:16.43,JPsub,NTP,0,0,0,,Ол құлады ма?
Dialogue: 0,0:39:16.67,0:39:19.26,JPsub,NTP,0,0,0,,Әңгіменің құрылымы қарапайым.
Dialogue: 0,0:39:20.33,0:39:21.36,JPsub,NTP,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:39:22.09,0:39:25.31,JPsub,NTP,0,0,0,,Соны сұрасаң, үш тиындық роман сияқты.
Dialogue: 0,0:39:27.38,0:39:28.13,JPsub,NTP,0,0,0,,Мұндайды қалай байқадың, Рюзаки?
Dialogue: 0,0:39:45.97,0:39:48.85,JPsub,NTP,0,0,0,,Суицид дұрыс па? Микия
Dialogue: 0,0:39:49.25,0:39:50.97,JPsub,NTP,0,0,0,,Иә, бұл туралы ше?
Dialogue: 0,0:39:52.14,0:39:55.81,JPsub,NTP,0,0,0,,Мысалы, мен қорқынышты ретро вирусты жұқтырдым.
Dialogue: 0,0:39:56.42,0:39:59.80,JPsub,NTP,0,0,0,,Токионың барлық тұрғындары тірі қалу арқылы өлді делік.
Dialogue: 0,0:40:00.52,0:40:03.19,JPsub,NTP,0,0,0,,Мен өлсем, бәрі құтқарылады.
Dialogue: 0,0:40:03.86,0:40:05.89,JPsub,NTP,0,0,0,,Мен өз-өзіме қол жұмсайтын шығармын
Dialogue: 0,0:40:06.14,0:40:07.19,JPsub,NTP,0,0,0,,Бұл не?
Dialogue: 0,0:40:07.85,0:40:10.95,JPsub,NTP,0,0,0,,Мұндай мүмкін емес оқиғаны аналогия ретінде де қолдануға болмайды.
Dialogue: 0,0:40:11.21,0:40:12.06,JPsub,NTP,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:40:13.07,0:40:16.27,JPsub,NTP,0,0,0,,Бірақ бұл менің әлсіздігімнен деп ойлаймын.
Dialogue: 0,0:40:17.00,0:40:20.70,JPsub,NTP,0,0,0,,Токионың барлық тұрғындарын өзімнің жауыма айналдырып, аман қалуға батылым жетпейді.
Dialogue: 0,0:40:21.09,0:40:22.22,JPsub,NTP,0,0,0,,Мен өз-өзіме қол жұмсаймын.
Dialogue: 0,0:40:22.72,0:40:24.36,JPsub,NTP,0,0,0,,Бұл оңайырақ.
Dialogue: 0,0:40:25.51,0:40:29.27,JPsub,NTP,0,0,0,,Мәңгілік болуы керек уақытша батылдық пен батылдық
Dialogue: 0,0:40:29.79,0:40:31.77,JPsub,NTP,0,0,0,,Қайсысы ауыр екенін білесің.
Dialogue: 0,0:40:33.00,0:40:34.04,JPsub,NTP,0,0,0,,Бұл экстремалды теория, бірақ
Dialogue: 0,0:40:34.64,0:40:36.57,JPsub,NTP,0,0,0,,Менің ойымша, өлім тәтті.
Dialogue: 0,0:40:37.37,0:40:40.58,JPsub,NTP,0,0,0,,Дегенмен, мүдделі адамның қашудан басқа амалы қалмайтын кездер болады.
Dialogue: 0,0:40:41.45,0:40:42.75,JPsub,NTP,0,0,0,,Оны жоққа шығаруға болмайды
Dialogue: 0,0:40:43.14,0:40:44.15,JPsub,NTP,0,0,0,,Теріске шығару мүмкін емес
Dialogue: 0,0:40:45.28,0:40:45.96,JPsub,NTP,0,0,0,,Өйткені
Dialogue: 0,0:40:47.80,0:40:49.53,JPsub,NTP,0,0,0,,Өйткені мен де әлсіз адаммын.
Dialogue: 0,0:40:51.59,0:40:52.86,JPsub,NTP,0,0,0,,Сіз басқасыз.
Dialogue: 0,0:41:10.78,0:41:12.13,JPsub,NTP,0,0,0,,Олай десеңіз, формула
Dialogue: 0,0:41:12.90,0:41:14.27,JPsub,NTP,0,0,0,,Мен біртүрлі түс көрдім
Dialogue: 0,0:41:14.51,0:41:15.18,JPsub,NTP,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:41:16.15,0:41:16.82,JPsub,NTP,0,0,0,,Иә
Dialogue: 0,0:41:17.42,0:41:18.41,JPsub,NTP,0,0,0,,Инелік арманы
Dialogue: 0,0:41:19.05,0:41:20.59,JPsub,NTP,0,0,0,,Мен инелікке қарап тұрмын ба?
Dialogue: 0,0:41:20.93,0:41:22.22,JPsub,NTP,0,0,0,,Инелік мен болдым ба?
Dialogue: 0,0:41:23.47,0:41:24.24,JPsub,NTP,0,0,0,,Кез келген жағдайда
Dialogue: 0,0:41:24.45,0:41:26.26,JPsub,NTP,0,0,0,,Инелік айнала ұшып әлек болды.
Dialogue: 0,0:41:30.13,0:41:32.37,JPsub,NTP,0,0,0,,Сол кезде көбелек келді
Dialogue: 0,0:41:33.21,0:41:36.10,JPsub,NTP,0,0,0,,Қолымнан келгенше күш саламын, бірақ қанатымды қағып жатырмын
Dialogue: 0,0:41:37.07,0:41:38.11,JPsub,NTP,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:41:39.42,0:41:42.64,JPsub,NTP,0,0,0,,Ақыры күшім таусылып, жерге құладым.
Dialogue: 0,0:41:44.82,0:41:49.02,JPsub,NTP,0,0,0,,Егер ол қалқып бара жатқандай қанаттарын қағып кетсе, ұзағырақ ұша алар еді.
Dialogue: 0,0:41:50.98,0:41:57.87,JPsub,NTP,0,0,0,,Бірақ ұша білген көбелек өзінің қалқыған денесінің жеңілдігіне шыдай алмады.
Dialogue: 0,0:41:59.28,0:42:00.56,JPsub,NTP,0,0,0,,Сондықтан мен ұштым
Dialogue: 0,0:42:02.48,0:42:03.70,JPsub,NTP,0,0,0,,Мен жүзуді тоқтаттым.
Dialogue: 0,0:42:07.01,0:42:08.40,JPsub,NTP,0,0,0,,Осымен.
Dialogue: 0,0:42:08.65,0:42:10.18,JPsub,NTP,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:42:10.93,0:42:13.77,JPsub,NTP,0,0,0,,Бұл үлгі емес, солай ма?
Dialogue: 0,0:42:13.84,0:42:14.65,JPsub,NTP,0,0,0,,Микия
Dialogue: 0,0:42:14.92,0:42:15.97,JPsub,NTP,0,0,0,,Бүгін түнде болыңыз
Dialogue: 0,0:42:16.42,0:42:17.17,JPsub,NTP,0,0,0,,болып табылады
Dialogue: 0,0:42:17.91,0:42:19.01,JPsub,NTP,0,0,0,,Неліктен кенеттен?
Dialogue: 0,0:42:19.12,0:42:20.01,JPsub,NTP,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:42:20.71,0:42:21.74,JPsub,NTP,0,0,0,,Жарайды.
Dialogue: 0,0:42:22.17,0:42:24.52,JPsub,NTP,0,0,0,,Бұл оңайырақ.
Dialogue: 0,0:42:24.97,0:42:26.95,JPsub,NTP,0,0,0,,Әлде сізде бір нәрсе бар ма?
Dialogue: 0,0:42:28.29,0:42:29.23,JPsub,NTP,0,0,0,,Құлпынай
Dialogue: 0,0:42:30.36,0:42:31.12,JPsub,NTP,0,0,0,,болып табылады
Dialogue: 0,0:42:33.46,0:42:35.30,JPsub,NTP,0,0,0,,Хааген-Дазс құлпынай
Dialogue: 0,0:42:35.72,0:42:37.20,JPsub,NTP,0,0,0,,Сіздің үлесіңіз өзгеріссіз қалады.
Dialogue: 0,0:42:37.49,0:42:38.54,JPsub,NTP,0,0,0,,Одан құтылыңыз
Dialogue: 0,0:42:51.85,0:42:52.68,JPsub,NTP,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:42:53.06,0:42:54.13,JPsub,NTP,0,0,0,,Мен бүгін түнеймін.
Dialogue: 0,0:42:56.57,0:42:57.68,JPsub,NTP,0,0,0,,Бірақ формула
Dialogue: 0,0:42:59.06,0:43:00.91,JPsub,NTP,0,0,0,,Одан құтылудың жолы жоқ.
Dialogue: 0,0:43:01.47,0:43:03.91,JPsub,NTP,0,0,0,,Осы сөзбен бірдеңе жасаңыз.
Dialogue: 0,0:43:05.42,0:43:07.08,JPsub,NTP,0,0,0,,Өйткені сен қызсың
Dialogue: 0,0:43:10.05,0:43:10.85,JPsub,NTP,0,0,0,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:43:11.04,0:43:11.99,JPsub,NTP,0,0,0,,Бұл маған байланысты.
Dialogue: 0,0:47:27.17,0:47:28.47,JPsub,NTP,0,0,0,,Иә, бұл сайт.
Dialogue: 0,0:47:29.19,0:47:31.71,JPsub,NTP,0,0,0,,Өз-өзіне қол жұмсаған сегізінші адам Кири Мияджо болды.
Dialogue: 0,0:47:32.10,0:47:35.93,JPsub,NTP,0,0,0,,Ол Мияджо ғимаратының бұрынғы иесі Ясуки Котомиджоның үлкен қызы.
Dialogue: 0,0:47:36.35,0:47:37.24,JPsub,NTP,0,0,0,,Емделмейтін ауру
Dialogue: 0,0:47:37.58,0:47:40.97,JPsub,NTP,0,0,0,,Оның қаладағы ауруханада жатқанына он жылдан асты.
Dialogue: 0,0:47:41.55,0:47:47.67,JPsub,NTP,0,0,0,,Кири 27 жасында қайтыс болды және ауруханадан басқа ол жатқан аурухана бөлмесінен ешқашан шықпаған.
Dialogue: 0,0:47:47.79,0:47:48.52,JPsub,NTP,0,0,0,,Жаңа гүлдер
Dialogue: 0,0:47:51.70,0:47:52.84,JPsub,NTP,0,0,0,,Кешегі өз-өзіне қол жұмсау
Dialogue: 0,0:47:53.48,0:47:55.38,JPsub,NTP,0,0,0,,Ол мектеп оқушысы болмаған сияқты.
Dialogue: 0,0:47:56.45,0:47:57.15,JPsub,NTP,0,0,0,,О
Dialogue: 0,0:47:57.45,0:47:59.14,JPsub,NTP,0,0,0,,Оның айтуынша, бұл аурудан туындаған суицид және сериялық суицидтерге ешқандай қатысы жоқ.
Dialogue: 0,0:47:59.32,0:48:02.77,JPsub,NTP,0,0,0,,Тілші айтты
Dialogue: 0,0:48:03.86,0:48:05.01,JPsub,NTP,0,0,0,,Иә, байланыссыз ба?
Dialogue: 0,0:48:06.65,0:48:08.64,JPsub,NTP,0,0,0,,Жоқ, солай бола ма?
Dialogue: 0,0:48:11.35,0:48:12.12,JPsub,NTP,0,0,0,,Мен
Dialogue: 0,0:48:12.33,0:48:15.09,JPsub,NTP,0,0,0,,Мен адамдардың өз бетінше өлгенде қалай сезінетінін түсінбеймін.
Dialogue: 0,0:48:17.01,0:48:18.57,JPsub,NTP,0,0,0,,Туко-сан түсінеді.
Dialogue: 0,0:48:22.13,0:48:23.71,JPsub,NTP,0,0,0,,Суицидке себеп жоқ.
Dialogue: 0,0:48:26.93,0:48:29.98,JPsub,NTP,0,0,0,,Мен бүгін ұша алмас едім.
Dialogue: 0,0:49:37.13,0:49:39.04,JPsub,NTP,0,0,0,,Кінәлі жарақат алудан бас тартуы керек.
Dialogue: 0,0:49:39.19,0:49:41.11,JPsub,NTP,0,0,0,,Мен оған жаңа ғана үйрендім.
Dialogue: 0,0:49:41.44,0:49:42.01,JPsub,NTP,0,0,0,,Міне
Dialogue: 0,0:49:42.30,0:49:42.84,JPsub,NTP,0,0,0,,Үй
Dialogue: 0,0:49:43.03,0:49:43.41,JPsub,NTP,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:49:43.65,0:49:45.50,JPsub,NTP,0,0,0,,Тезірек тынышталсам ғой.
Dialogue: 0,0:49:46.20,0:49:47.32,JPsub,NTP,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:49:47.53,0:49:49.01,JPsub,NTP,0,0,0,,Жақында тағы кездесеміз.
Dialogue: 0,0:00:23.24,0:00:24.02,CNsub,NTP,0,0,0,,Құлыптау
Dialogue: 0,0:00:27.26,0:00:28.00,CNsub,NTP,0,0,0,,Қайырлы кеш
Dialogue: 0,0:00:28.76,0:00:30.64,CNsub,NTP,0,0,0,,Бұл салтанатты мақтау.
Dialogue: 0,0:00:32.25,0:00:34.16,CNsub,NTP,0,0,0,,Мұз жәшігінен шыққаннан кейін
Dialogue: 0,0:00:39.16,0:00:43.02,CNsub,NTP,0,0,0,,Құлып үстінде жақсы орналасу
Dialogue: 0,0:00:43.54,0:00:44.60,CNsub,NTP,0,0,0,,Келесі қадам - ояту.
Dialogue: 0,0:00:45.01,0:00:48.23,CNsub,NTP,0,0,0,,Бірдеңе айтсам, жоқ кезде келемін.
Dialogue: 0,0:00:49.08,0:00:50.70,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:00:54.11,0:00:56.15,CNsub,NTP,0,0,0,,Қазір аспан өзгеріп жатыр.
Dialogue: 0,0:00:59.03,0:01:00.44,CNsub,NTP,0,0,0,,Ол еріді ме?
Dialogue: 0,0:01:01.32,0:01:03.53,CNsub,NTP,0,0,0,,Ол үшін салқын қойма қажет екені рас.
Dialogue: 0,0:01:04.31,0:01:05.83,CNsub,NTP,0,0,0,,Мен бақытты емеспін
Dialogue: 0,0:01:06.29,0:01:12.09,CNsub,NTP,0,0,0,,Қазір онша ыстық емес.
Dialogue: 0,0:01:13.64,0:01:15.39,CNsub,NTP,0,0,0,,Көңілім қалды, бірақ мен де ойладым.
Dialogue: 0,0:01:15.85,0:01:18.26,CNsub,NTP,0,0,0,,Алайда, ойлап қарасаңыз, оның сыртқы түрі сәйкес келмейді.
Dialogue: 0,0:01:18.59,0:01:19.29,CNsub,NTP,0,0,0,,Саусағыңыз
Dialogue: 0,0:01:20.33,0:01:21.17,CNsub,NTP,0,0,0,,Шөп
Dialogue: 0,0:01:22.32,0:01:23.43,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:01:24.10,0:01:26.35,CNsub,NTP,0,0,0,,Келесі затты сатып алған адам.
Dialogue: 0,0:01:26.89,0:01:28.99,CNsub,NTP,0,0,0,,Шегіртке белгісі
Dialogue: 0,0:01:31.08,0:01:32.04,CNsub,NTP,0,0,0,,Терінің сыртқы түрі
Dialogue: 0,0:01:34.08,0:01:36.72,CNsub,NTP,0,0,0,,Бірақ шөп раушангүлділер тұқымдасына жататын өсімдік.
Dialogue: 0,0:01:37.97,0:01:38.76,CNsub,NTP,0,0,0,,Бұл туралы ойламаңыз
Dialogue: 0,0:01:39.16,0:01:42.79,CNsub,NTP,0,0,0,,Жер керемет, шөбі әдемі, бірақ бұл раушан гүлі.
Dialogue: 0,0:01:44.19,0:01:45.98,CNsub,NTP,0,0,0,,Иә, бұл рас.
Dialogue: 0,0:01:46.23,0:01:46.99,CNsub,NTP,0,0,0,,Кекірмеу
Dialogue: 0,0:05:16.70,0:05:18.34,CNsub,NTP,0,0,0,,2 ұпай түстен кейін 10 минут солға және оңға
Dialogue: 0,0:05:18.77,0:05:24.40,CNsub,NTP,0,0,0,,Токио Митрополитен орта мектебінің 2-сынып оқушысы Мидзёо Гранд ғимараты №4 Шируя кассасы
Dialogue: 0,0:05:24.72,0:05:27.44,CNsub,NTP,0,0,0,,Бүкіл дененің ауыр жарақаты, ұзақ уақыттан кейін өлім
Dialogue: 0,0:05:26.74,0:05:28.57,CNsub,NTP,0,0,0,,Орта және орта мектеп оқушысының өзін-өзі жоюы, ғибадатханадағы 4-ші адам
Dialogue: 0,0:05:28.61,0:05:31.80,CNsub,NTP,0,0,0,,Ғибадатханада өз-өзіне қол жұмсағандар саны 4 дана.
Dialogue: 0,0:05:32.27,0:05:35.20,CNsub,NTP,0,0,0,,Бұрынғыдай
Dialogue: 0,0:05:35.57,0:05:38.70,CNsub,NTP,0,0,0,,Осы кезде полиция қызметкері жоғалып кетті
Dialogue: 0,0:05:39.02,0:05:43.59,CNsub,NTP,0,0,0,,Достар мен отбасы мүшелері бар ма, жоқ па
Dialogue: 0,0:05:43.73,0:05:44.43,CNsub,NTP,0,0,0,,Қызықтырасыз ба?
Dialogue: 0,0:05:50.01,0:05:52.08,CNsub,NTP,0,0,0,,Оқытатын профессор…
Dialogue: 0,0:05:53.47,0:05:54.84,CNsub,NTP,0,0,0,,Бұл 4-ші адам.
Dialogue: 0,0:05:56.89,0:06:00.98,CNsub,NTP,0,0,0,,Профессор: Өткен суицид оқиғалары
Dialogue: 0,0:05:55.63,0:05:56.85,CNsub,NTP,0,0,0,,Адамдардың әңгімелері…
Dialogue: 0,0:06:00.07,0:06:02.37,CNsub,NTP,0,0,0,,Оқиғаны тексеру
Dialogue: 0,0:06:02.94,0:06:03.84,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:06:03.95,0:06:05.42,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:06:05.72,0:06:07.37,CNsub,NTP,0,0,0,,``Ортақ нүктелер''
Dialogue: 0,0:06:07.86,0:06:11.41,CNsub,NTP,0,0,0,,Өзін-өзі өлтірген қыздарды әртүрлі мектептерде жұмысқа орналастыру
Dialogue: 0,0:06:11.66,0:06:14.75,CNsub,NTP,0,0,0,,Қала - жеке өміріне қатысты сұрақтары жоқ жақсы бала.
Dialogue: 0,0:06:14.89,0:06:17.49,CNsub,NTP,0,0,0,,Отбасы мүшелерінің өзін-өзі жою себептері мүлдем жоқ.
Dialogue: 0,0:06:18.21,0:06:22.56,CNsub,NTP,0,0,0,,Жағдайларды қарастыру
Dialogue: 0,0:06:22.80,0:06:27.33,CNsub,NTP,0,0,0,,Сіз кенеттен жыныстық суицидке әкелетін психикалық тұрақсыз екеніңізді растауға болады.
Dialogue: 0,0:06:27.89,0:06:30.61,CNsub,NTP,0,0,0,,Бұл да ойлау мен кету туралы әңгіме.
Dialogue: 0,0:06:30.95,0:06:33.94,CNsub,NTP,0,0,0,,Полиция қызметкерлері мен полиция қызметкерлеріне ортақ нәрсе
Dialogue: 0,0:06:34.29,0:06:35.07,CNsub,NTP,0,0,0,,Ұзын кітап
Dialogue: 0,0:06:35.29,0:06:36.72,CNsub,NTP,0,0,0,,Жауап аяқталды
Dialogue: 0,0:06:36.84,0:06:41.02,CNsub,NTP,0,0,0,,Түзетпеу керек өлім туралы әңгіме.
Dialogue: 0,0:06:42.69,0:06:44.41,CNsub,NTP,0,0,0,,Секіру мұнарасының өзін-өзі өлтіруіне қарама-қайшылық
Dialogue: 0,0:06:45.62,0:06:46.54,CNsub,NTP,0,0,0,,Міне, болды
Dialogue: 0,0:06:48.16,0:06:53.86,CNsub,NTP,0,0,0,,Дүниенің қалай өлгені және өзімнің өлімі туралы әңгіме.
Dialogue: 0,0:06:54.91,0:06:59.59,CNsub,NTP,0,0,0,,Ләззат алатын орын жоғалады.
Dialogue: 0,0:07:00.16,0:07:01.80,CNsub,NTP,0,0,0,,Дәстүрге қарсы өлім
Dialogue: 0,0:07:02.14,0:07:04.96,CNsub,NTP,0,0,0,,Егер бұл ақпарат рас болса, маған кітапты қалдыруға рұқсат етіңіз.
Dialogue: 0,0:07:05.54,0:07:07.49,CNsub,NTP,0,0,0,,Абайсызда секіруден шығып кетті
Dialogue: 0,0:07:07.78,0:07:09.12,CNsub,NTP,0,0,0,,Бағыныңқыда не істеу керек
Dialogue: 0,0:07:09.92,0:07:10.64,CNsub,NTP,0,0,0,,18-ші эпизод: Венецияға!
Dialogue: 0,0:07:11.64,0:07:13.99,CNsub,NTP,0,0,0,,Түпнұсқаны жою жоспары болды.
Dialogue: 0,0:07:15.31,0:07:18.24,CNsub,NTP,0,0,0,,Тек түзетулер енгізіп, Шығысты қалдырыңыз
Dialogue: 0,0:07:18.52,0:07:21.57,CNsub,NTP,0,0,0,,Қайғылы жағдайға әкелген жол-көлік оқиғасы
Dialogue: 0,0:07:23.05,0:07:24.50,CNsub,NTP,0,0,0,,Бұл Канья екеуіңнің әңгімесі.
Dialogue: 0,0:07:25.96,0:07:26.72,CNsub,NTP,0,0,0,,Накая?
Dialogue: 0,0:07:27.83,0:07:33.95,CNsub,NTP,0,0,0,,``Олай ойламау себебім Шығысты тастап, Шығысқа қайту керек болды.''
Dialogue: 0,0:07:35.30,0:07:36.35,CNsub,NTP,0,0,0,,Барлығыңды өлтіреміз
Dialogue: 0,0:07:38.71,0:07:42.74,CNsub,NTP,0,0,0,,Менің пәк балам жылдық жиынға қашан келді?
Dialogue: 0,0:09:27.95,0:09:31.87,CNsub,NTP,0,0,0,,Бұл Вуджо мұнарасындағы өзін-өзі өлтіру оқиғасының 5-ші сектасы.
Dialogue: 0,0:09:32.26,0:09:36.29,CNsub,NTP,0,0,0,,Өлім - Мотойчи орта мектебінің оқушысы.
Dialogue: 0,0:09:36.57,0:09:39.38,CNsub,NTP,0,0,0,,Бұрынғы көрініс...
Dialogue: 0,0:09:42.38,0:09:44.06,CNsub,NTP,0,0,0,,Жиналысты қашан өткізу керек
Dialogue: 0,0:09:44.45,0:09:46.42,CNsub,NTP,0,0,0,,Секіру мұнарасында өз-өзіне қол жұмсаған 8-ші адамның жиналысының қорытындысы
Dialogue: 0,0:09:46.52,0:09:48.08,CNsub,NTP,0,0,0,,Жиналыс тоқтағаннан кейін
Dialogue: 0,0:09:48.79,0:09:49.34,CNsub,NTP,0,0,0,,Иә?
Dialogue: 0,0:09:49.55,0:09:50.13,CNsub,NTP,0,0,0,,8 адам
Dialogue: 0,0:09:50.57,0:09:52.12,CNsub,NTP,0,0,0,,8 дрейфтің жағдайы
Dialogue: 0,0:09:53.29,0:09:54.75,CNsub,NTP,0,0,0,,Сіз ғибадатханадан шықтыңыз
Dialogue: 0,0:09:57.91,0:09:58.51,CNsub,NTP,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:09:58.83,0:10:00.00,CNsub,NTP,0,0,0,,Қызығуға шынайы сезімдер
Dialogue: 0,0:10:00.99,0:10:02.79,CNsub,NTP,0,0,0,,Нари міндетті түрде Цзянь аймағында
Dialogue: 0,0:10:04.69,0:10:08.03,CNsub,NTP,0,0,0,,Shajo Tower 1970 жылы дамыған даму кезеңінде болған.
Dialogue: 0,0:10:08.22,0:10:11.26,CNsub,NTP,0,0,0,,Қаланың монументалды мұнаралары мен ғимараттарының құрылысы
Dialogue: 0,0:10:12.10,0:10:14.98,CNsub,NTP,0,0,0,,Бірде қонақты алдыңғы қатарлы жапондық бақылау бөлмесіне шақырды.
Dialogue: 0,0:10:15.47,0:10:17.13,CNsub,NTP,0,0,0,,Енді қалай болашақ бұзылды
Dialogue: 0,0:10:17.33,0:10:19.53,CNsub,NTP,0,0,0,,Шешім бір жыл бұрын қабылданған.
Dialogue: 0,0:10:20.22,0:10:23.60,CNsub,NTP,0,0,0,,Адамдарды бүкіл ғимарат бойымен тасымалдау мүмкіндігі мәңгілік нәрсе.
Dialogue: 0,0:10:24.26,0:10:25.54,CNsub,NTP,0,0,0,,Менде ешқандай сұрақтар жоқ.
Dialogue: 0,0:10:26.07,0:10:29.21,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:10:29.93,0:10:32.02,CNsub,NTP,0,0,0,,Бұл сондай-ақ «тәртіп қайшы»
Dialogue: 0,0:10:32.54,0:10:34.85,CNsub,NTP,0,0,0,,Адамның жады жазылмайды.
Dialogue: 0,0:10:35.56,0:10:39.21,CNsub,NTP,0,0,0,,Нагиро мүсіні тәкаппар болғаны сонша, ол уақыт өте келе жазылған.
Dialogue: 0,0:10:39.81,0:10:44.64,CNsub,NTP,0,0,0,,Түпнұсқа туғанға дейінгі жазбаның өлген уақыты
Dialogue: 0,0:10:45.16,0:10:47.82,CNsub,NTP,0,0,0,,Нәтижесінде бір ғана естелік қалады.
Dialogue: 0,0:10:49.40,0:10:53.15,CNsub,NTP,0,0,0,,Елшінің бірден қайтыс болуы.
Dialogue: 0,0:10:57.01,0:11:00.67,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:11:03.99,0:11:04.81,CNsub,NTP,0,0,0,,Өздігінен әңгімелеу
Dialogue: 0,0:11:05.35,0:11:07.08,CNsub,NTP,0,0,0,,Гаокаоның панорамалық көрінісі
Dialogue: 0,0:11:07.36,0:11:09.05,CNsub,NTP,0,0,0,,Сізбен кездесу
Dialogue: 0,0:11:09.79,0:11:13.49,CNsub,NTP,0,0,0,,Дүние шаршап, көз түбі уақытты сезетін дүниенің кенеттен қозғалысы.
Dialogue: 0,0:11:14.02,0:11:16.31,CNsub,NTP,0,0,0,,Тікелей өкілдің өзі жоспарлаудан бас тартады
Dialogue: 0,0:11:16.51,0:11:19.54,CNsub,NTP,0,0,0,,Бас тарту ұқсас зорлық-зомбылық және жалпы мойындауға қол сұғу ретінде жіктеледі.
Dialogue: 0,0:11:20.20,0:11:22.48,CNsub,NTP,0,0,0,,Құс көзқарасынан жалпы эмоциялар
Dialogue: 0,0:11:24.59,0:11:27.28,CNsub,NTP,0,0,0,,Назе «алыс»
Dialogue: 0,0:11:28.60,0:11:30.83,CNsub,NTP,0,0,0,,Биік тауды құс көзімен көру - бұл керемет көрініс.
Dialogue: 0,0:11:31.57,0:11:34.37,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:11:38.99,0:11:45.03,CNsub,NTP,0,0,0,,Дегенмен, бұл бүкіл дүние жүзіндегі қашықтық.
Dialogue: 0,0:11:46.00,0:11:48.14,CNsub,NTP,0,0,0,,Белгілі бір өздігінен жұмыс істейтін дене жететін тар кеңістік
36-бөлім
Dialogue: 0,0:11:48.49,0:11:53.99,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:11:54.47,0:11:59.80,CNsub,NTP,0,0,0,,Дегенмен, өзін-өзі жетілдірудің шегі жоқ екені даусыз, бірақ дүниеде ақиқат сезімі жоқ.
Dialogue: 0,0:12:01.83,0:12:06.62,CNsub,NTP,0,0,0,,Жұмыс туралы білім мен жұмыстың шындығы мен тәжірибе тәжірибесінің өзара жойылуы бар.
Dialogue: 0,0:12:06.95,0:12:10.44,CNsub,NTP,0,0,0,,Сосын, керісінше, бірінен соң бірі сана жоғала бастайды.
Dialogue: 0,0:12:11.91,0:12:12.94,CNsub,NTP,0,0,0,,Өте шу, әсіресе балалардың жылауы.
Dialogue: 0,0:12:20.55,0:12:23.16,CNsub,NTP,0,0,0,,Көзге көрінбейтін суреттер
Dialogue: 0,0:12:23.42,0:12:24.97,CNsub,NTP,0,0,0,,Бұл керемет түсінікті сурет.
Dialogue: 0,0:12:25.67,0:12:29.51,CNsub,NTP,0,0,0,,Ортақ білімімізді қорғау
Dialogue: 0,0:12:30.63,0:12:34.36,CNsub,NTP,0,0,0,,Адам заңсыз, өзін-өзі шектейтін, жансыз.
Dialogue: 0,0:12:35.12,0:12:36.25,CNsub,NTP,0,0,0,,Түпнұсқа оқиға
Dialogue: 0,0:12:37.51,0:12:38.89,CNsub,NTP,0,0,0,,Болашақ жаңалықтары
Dialogue: 0,0:12:39.39,0:12:42.67,CNsub,NTP,0,0,0,,Шаджо сарайында жаңа суицид оқиғасы пайда болды
Dialogue: 0,0:12:43.03,0:12:46.61,CNsub,NTP,0,0,0,,6-адам: 2 адам
Dialogue: 0,0:12:49.86,0:12:51.78,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:12:52.02,0:12:52.63,CNsub,NTP,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:52.77,0:12:59.08,CNsub,NTP,0,0,0,,Оның бүкіл денесі ауыр жарақаттанған, тасымалдау кезінде қайтыс болғаны расталды.
Dialogue: 0,0:13:00.27,0:13:00.98,CNsub,NTP,0,0,0,,Мұндайды есту өте сирек
Dialogue: 0,0:12:59.31,0:13:02.66,CNsub,NTP,0,0,0,,Ғибадатханада өзін-өзі өлтіру саны 6 болды.
Dialogue: 0,0:13:21.40,0:13:23.68,CNsub,NTP,0,0,0,,Өлімнің бастапқы жоспары
Dialogue: 0,0:13:24.93,0:13:27.71,CNsub,NTP,0,0,0,,Сізге жай ғана жағдайды түзету керек
Dialogue: 0,0:13:28.08,0:13:31.13,CNsub,NTP,0,0,0,,Қайғылы жағдайға әкелген жол-көлік оқиғасы
Dialogue: 0,0:13:34.43,0:13:35.32,CNsub,NTP,0,0,0,,Барлығыңды өлтіреміз
Dialogue: 0,0:13:37.65,0:13:41.79,CNsub,NTP,0,0,0,,Таза баламен неше рет кездестім?
Dialogue: 0,0:14:38.92,0:14:39.55,CNsub,NTP,0,0,0,,Қара пауловния
Dialogue: 0,0:16:37.28,0:16:37.94,CNsub,NTP,0,0,0,,Келесі жолы
Dialogue: 0,0:17:25.56,0:17:27.82,CNsub,NTP,0,0,0,,Тағы бір тікелей арман
Dialogue: 0,0:17:28.32,0:17:30.36,CNsub,NTP,0,0,0,,Тура мөлшерлеме
Dialogue: 0,0:17:32.85,0:17:36.16,CNsub,NTP,0,0,0,,Тағы қандай жерлерде жұмыс істегіңіз келеді?
Dialogue: 0,0:17:40.67,0:17:43.26,CNsub,NTP,0,0,0,,Басқалардың да ұша алуын тілеймін
Dialogue: 0,0:17:46.61,0:17:48.10,CNsub,NTP,0,0,0,,Сіз ұша аласыз
Dialogue: 0,0:17:48.62,0:17:51.70,CNsub,NTP,0,0,0,,Сіз мүлдем түсініксіз!
Dialogue: 0,0:18:34.53,0:18:38.87,CNsub,NTP,0,0,0,,Шығу тегі – трагедия
Dialogue: 0,0:18:40.87,0:18:44.45,CNsub,NTP,0,0,0,,Әдеттегідей «қол» астындағы бірінші пән күшті.
Dialogue: 0,0:18:45.09,0:18:46.21,CNsub,NTP,0,0,0,,Қала қызғылт сары түсті
Dialogue: 0,0:18:46.51,0:18:48.15,CNsub,NTP,0,0,0,,Жою дәрежесі аяқталды.
Dialogue: 0,0:18:48.98,0:18:51.62,CNsub,NTP,0,0,0,,Менің әңгімем өлі мәселе екені рас.
Dialogue: 0,0:18:52.86,0:18:53.89,CNsub,NTP,0,0,0,,Бэбифейс
Dialogue: 0,0:18:55.80,0:18:56.70,CNsub,NTP,0,0,0,,Мұндайды есту өте сирек
Dialogue: 0,0:18:58.52,0:19:01.55,CNsub,NTP,0,0,0,,Алайда Фуджиноның таланты бір аймен шектеледі.
Dialogue: 0,0:19:02.20,0:19:05.50,CNsub,NTP,0,0,0,,Абайлап, аяқ-қолдарыңызды пайдаланасыз деп үміттенемін
Dialogue: 0,0:19:06.84,0:19:07.88,CNsub,NTP,0,0,0,,Келесі бастау
Dialogue: 0,0:19:08.53,0:19:09.83,CNsub,NTP,0,0,0,,Жұмысқа деген қызығушылық
Dialogue: 0,0:19:23.59,0:19:24.60,CNsub,NTP,0,0,0,,Өздігінен әңгімелеу
Dialogue: 0,0:19:25.61,0:19:29.91,CNsub,NTP,0,0,0,,Адамның мүсіндері мен мүшелері туралы әңгіме.
Dialogue: 0,0:19:30.28,0:19:33.35,CNsub,NTP,0,0,0,,Шынайы адамдарға шексіз қол жеткізу
Dialogue: 0,0:19:34.21,0:19:37.54,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:19:37.85,0:19:39.34,CNsub,NTP,0,0,0,,Бұл жай ғана жалпы ыдыс емес.
Dialogue: 0,0:19:40.49,0:19:42.64,CNsub,NTP,0,0,0,,Адам ағзасы да осындай деп айтуға бола ма?
Dialogue: 0,0:19:43.31,0:19:46.68,CNsub,NTP,0,0,0,,Жан мағынасыз бос денеге айналады.
Dialogue: 0,0:19:48.18,0:19:49.54,CNsub,NTP,0,0,0,,Бұл ыдыс.
Dialogue: 0,0:19:50.26,0:19:51.66,CNsub,NTP,0,0,0,,Тадаари «аспан»
Dialogue: 0,0:19:53.15,0:19:55.50,CNsub,NTP,0,0,0,,Бұрын сіз осында болдыңыз.
Dialogue: 0,0:19:57.90,0:20:00.64,CNsub,NTP,0,0,0,,Менің алғашқы қара пауловния ағашына бару тарихым бар.
Dialogue: 0,0:20:01.32,0:20:02.13,CNsub,NTP,0,0,0,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:20:02.39,0:20:04.92,CNsub,NTP,0,0,0,,Менің жұмысыма басқалар кенеттен келеді, т.б.
Dialogue: 0,0:20:06.16,0:20:10.19,CNsub,NTP,0,0,0,,Белгілі бір жерде белгілі бір көрмені көргенде, мені адам баласы қызықтырды.
Dialogue: 0,0:20:11.35,0:20:15.59,CNsub,NTP,0,0,0,,Жер орналасқан жер Шираничи болды.
Dialogue: 0,0:20:16.36,0:20:19.66,CNsub,NTP,0,0,0,,Бұл аспан әлемінен қашатын жер.
Dialogue: 0,0:20:21.11,0:20:24.31,CNsub,NTP,0,0,0,,Көзілдірік таққан ерлер мен әйелдер
Dialogue: 0,0:20:26.62,0:20:28.10,CNsub,NTP,0,0,0,,Адамның ең ақылсыз фигурасы
Dialogue: 0,0:20:28.99,0:20:31.44,CNsub,NTP,0,0,0,,Бұл қазіргі жағдай.
Dialogue: 0,0:20:34.62,0:20:39.78,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:20:42.31,0:20:48.44,CNsub,NTP,0,0,0,,Басқа адамға байланған адамның бейнесіне ұқсас.
Dialogue: 0,0:20:58.51,0:20:59.34,CNsub,NTP,0,0,0,,Бос қорған
Dialogue: 0,0:21:12.25,0:21:13.11,CNsub,NTP,0,0,0,,Йоши Хаяками стилі
Dialogue: 0,0:21:13.89,0:21:16.53,CNsub,NTP,0,0,0,,You Zhi Dao Wujo Mansion Jump Tower өзін-өзі өлтіру оқиғасы 2-бөлім
Dialogue: 0,0:21:17.31,0:21:20.06,CNsub,NTP,0,0,0,,Апельсин балаға не болды
Dialogue: 0,0:21:21.46,0:21:25.05,CNsub,NTP,0,0,0,,Мен мұны келесі жолы орындай алмаймын.
Dialogue: 0,0:21:25.67,0:21:26.78,CNsub,NTP,0,0,0,,Планшетті пайдаланғыңыз келсе
Dialogue: 0,0:21:27.66,0:21:28.37,CNsub,NTP,0,0,0,,15-ші эпизод: Батырлық өлім – Екінші бөлім
Dialogue: 0,0:21:29.97,0:21:34.30,CNsub,NTP,0,0,0,,4 тамыз, 7 ұпай, түскі сағат 51 минут
Dialogue: 0,0:21:35.79,0:21:37.80,CNsub,NTP,0,0,0,,Терминология
Dialogue: 0,0:23:20.33,0:23:21.22,CNsub,NTP,0,0,0,,Динамикалық көрініс
Dialogue: 0,0:23:27.94,0:23:31.28,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:23:33.95,0:23:35.19,CNsub,NTP,0,0,0,,Сапасы екі есе жақсы
Dialogue: 0,0:23:35.70,0:23:37.06,CNsub,NTP,0,0,0,,Келесі қадам берік.
Dialogue: 0,0:23:37.59,0:23:39.78,CNsub,NTP,0,0,0,,Үндістанға бармаңыз.
Dialogue: 0,0:23:45.02,0:23:45.95,CNsub,NTP,0,0,0,,Ақылды шеберлік
Dialogue: 0,0:23:50.04,0:23:53.07,CNsub,NTP,0,0,0,,Бұл кеңестің жемісі – соңғы нәтиже.
Dialogue: 0,0:23:54.90,0:23:56.05,CNsub,NTP,0,0,0,,Ақиқат өздігінен жасалады және өзін өзі қабылдайды.
Dialogue: 0,0:23:58.75,0:24:00.25,CNsub,NTP,0,0,0,,Кастрацияланбаған басқалар
Dialogue: 0,0:25:30.92,0:25:31.61,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:25:32.33,0:25:35.30,CNsub,NTP,0,0,0,,Бекіту: Сиқырлы флейта мүсіні
Dialogue: 0,0:25:39.65,0:25:40.45,CNsub,NTP,0,0,0,,На…
Dialogue: 0,0:25:42.53,0:25:44.07,CNsub,NTP,0,0,0,,Өлме
Dialogue: 0,0:27:43.09,0:27:44.66,CNsub,NTP,0,0,0,,Аяқпен тегіс жерге түсу
Dialogue: 0,0:27:45.64,0:27:46.83,CNsub,NTP,0,0,0,,Ұшақ
Dialogue: 0,0:27:49.48,0:27:50.63,CNsub,NTP,0,0,0,,Бұл қалқымалы фигура.
Dialogue: 0,0:28:15.31,0:28:16.64,CNsub,NTP,0,0,0,,жасырын қолдану
Dialogue: 0,0:28:17.34,0:28:20.24,CNsub,NTP,0,0,0,,Өзімнің шынайы болмысымды аңсау
Dialogue: 0,0:28:20.75,0:28:22.03,CNsub,NTP,0,0,0,,Өмір мен өлім шындығы
Dialogue: 0,0:28:22.33,0:28:23.90,CNsub,NTP,0,0,0,,Сондай-ақ түсініксіз экзистенциалды ауырсыну
Dialogue: 0,0:28:24.96,0:28:25.60,CNsub,NTP,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:28:25.92,0:28:28.06,CNsub,NTP,0,0,0,,Маған бұл бастапқыда ұнамайды.
40-бөлім
Dialogue: 0,0:28:28.66,0:28:29.21,CNsub,NTP,0,0,0,,Бұл рөл де біраз қиын екен…
Dialogue: 0,0:28:29.50,0:28:31.73,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:28:32.09,0:28:34.09,CNsub,NTP,0,0,0,,Басқа денелерде бар бірінші адам - ​​мен.
Dialogue: 0,0:28:35.13,0:28:36.46,CNsub,NTP,0,0,0,,Басқа саяхатқа барыңыз
Dialogue: 0,0:28:40.94,0:28:41.77,CNsub,NTP,0,0,0,,Құлау
Dialogue: 0,0:28:42.70,0:28:43.44,CNsub,NTP,0,0,0,,Құлау
Dialogue: 0,0:28:43.92,0:28:44.72,CNsub,NTP,0,0,0,,Құлау
Dialogue: 0,0:28:45.08,0:28:45.77,CNsub,NTP,0,0,0,,Құлау
Dialogue: 0,0:28:46.01,0:28:46.63,CNsub,NTP,0,0,0,,Құлау
Dialogue: 0,0:28:46.91,0:28:47.68,CNsub,NTP,0,0,0,,Құлау
Dialogue: 0,0:28:47.86,0:28:48.88,CNsub,NTP,0,0,0,,Құлау
Dialogue: 0,0:28:54.15,0:28:55.54,CNsub,NTP,0,0,0,,Бұл сіздің жауабыңыз
Dialogue: 0,0:29:04.49,0:29:05.53,CNsub,NTP,0,0,0,,Ақ сүйектер
Dialogue: 0,0:29:06.96,0:29:07.90,CNsub,NTP,0,0,0,,Бұл Юри
Dialogue: 0,0:29:54.17,0:29:55.03,CNsub,NTP,0,0,0,,Бұл кім?
Dialogue: 0,0:30:06.57,0:30:07.60,CNsub,NTP,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:30:10.17,0:30:13.20,CNsub,NTP,0,0,0,,Декорация...осылай болды
Dialogue: 0,0:30:14.35,0:30:15.20,CNsub,NTP,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:30:15.69,0:30:20.42,CNsub,NTP,0,0,0,,Бүгінгі түнде айдың түсі...
Dialogue: 0,0:30:21.24,0:30:22.11,CNsub,NTP,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:30:25.52,0:30:26.40,CNsub,NTP,0,0,0,,Канзен
Dialogue: 0,0:30:28.51,0:30:32.64,CNsub,NTP,0,0,0,,Мен...осы жерден табиғат көрінісін көріп қатты қуандым.
Dialogue: 0,0:30:34.21,0:30:39.38,CNsub,NTP,0,0,0,,Жапон үйеңкі гүлі…көктемгі ауа райы 3 маусым… Жапон үйеңкі гүлі өте әдемі
Dialogue: 0,0:30:40.71,0:30:42.53,CNsub,NTP,0,0,0,,Көк аспанда шашылған гүлді бақа
Dialogue: 0,0:30:43.11,0:30:45.31,CNsub,NTP,0,0,0,,Аспанда пайда болған сұлу әйелдің мүсіні.
Dialogue: 0,0:30:46.94,0:30:48.60,CNsub,NTP,0,0,0,,Келесі жылы спектакльді көру керек.
Dialogue: 0,0:30:53.75,0:30:56.68,CNsub,NTP,0,0,0,,Сен менің жауымсың.
Dialogue: 0,0:30:57.76,0:30:58.54,CNsub,NTP,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:30:59.10,0:31:03.00,CNsub,NTP,0,0,0,,Мен сенің досыңмын.
Dialogue: 0,0:31:03.79,0:31:05.63,CNsub,NTP,0,0,0,,Сіздің үш сұрағыңыз бар ма?
Dialogue: 0,0:31:05.90,0:31:09.71,CNsub,NTP,0,0,0,,Әрине, мен қазіргі жағдайдан хабардармын...
Dialogue: 0,0:31:11.17,0:31:12.03,CNsub,NTP,0,0,0,,Жалғасы
Dialogue: 0,0:31:12.20,0:31:13.12,CNsub,NTP,0,0,0,,Аяқталды
Dialogue: 0,0:31:20.76,0:31:23.71,CNsub,NTP,0,0,0,,Менің фамилиям кім?
Dialogue: 0,0:31:24.09,0:31:24.91,CNsub,NTP,0,0,0,,Тоуко Га Шоуту
Dialogue: 0,0:31:27.54,0:31:29.16,CNsub,NTP,0,0,0,,Тоуко Косаки
Dialogue: 0,0:31:31.18,0:31:32.04,CNsub,NTP,0,0,0,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:31:32.45,0:31:33.20,CNsub,NTP,0,0,0,,Апельсин апа
Dialogue: 0,0:31:34.06,0:31:34.75,CNsub,NTP,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:31:37.12,0:31:38.65,CNsub,NTP,0,0,0,,Сіз осындасыз ба?
Dialogue: 0,0:31:39.56,0:31:40.57,CNsub,NTP,0,0,0,,Жазылмаған
Dialogue: 0,0:31:41.96,0:31:44.84,CNsub,NTP,0,0,0,,Ұзақ уақыт болды... көп уақыт өтті
Dialogue: 0,0:31:46.06,0:31:49.57,CNsub,NTP,0,0,0,,Күн сайын… күнделікті күтімнің сыртқы көрінісі
Dialogue: 0,0:31:51.18,0:31:54.71,CNsub,NTP,0,0,0,,Күн сайын желдеткіш арқылы өту
Dialogue: 0,0:31:55.42,0:31:56.79,CNsub,NTP,0,0,0,,Көрініс
Dialogue: 0,0:31:58.29,0:31:59.09,CNsub,NTP,0,0,0,,Үлкен азап пен азап
Dialogue: 0,0:32:01.17,0:32:01.86,CNsub,NTP,0,0,0,,Бұл рөл де біраз қиын екен…
Dialogue: 0,0:32:02.61,0:32:05.58,CNsub,NTP,0,0,0,,Осыған байланысты бір жақты көзқарас жоғалып кеткендей...
Dialogue: 0,0:32:08.51,0:32:10.00,CNsub,NTP,0,0,0,,Фуканари кек
Dialogue: 0,0:32:11.01,0:32:13.60,CNsub,NTP,0,0,0,,Бұл менің қайда екенімнің мәселесі.
Dialogue: 0,0:32:15.03,0:32:17.16,CNsub,NTP,0,0,0,,Осының арқасында сіз дарынды адамсыз
Dialogue: 0,0:32:17.95,0:32:20.29,CNsub,NTP,0,0,0,,Күннің соңында адамның жеке басындағы стигма туралы бір ғана көзқарас бар.
Dialogue: 0,0:32:20.46,0:32:21.96,CNsub,NTP,0,0,0,,Құстың көзін алу
Dialogue: 0,0:32:23.63,0:32:24.58,CNsub,NTP,0,0,0,,Көп уақыттың ортасында жүргеніме көп болды.
Dialogue: 0,0:32:25.20,0:32:27.20,CNsub,NTP,0,0,0,,Өз көзқарасының көрінісі көкте.
Dialogue: 0,0:32:28.77,0:32:31.14,CNsub,NTP,0,0,0,,Бұл менің көру қабілетімнен айырылған кезде.
Dialogue: 0,0:32:32.13,0:32:32.92,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:32:33.44,0:32:35.36,CNsub,NTP,0,0,0,,Көзімнің арасы көрінбейді.
Dialogue: 0,0:32:36.20,0:32:36.87,CNsub,NTP,0,0,0,,Бұл рөл де біраз қиын екен…
Dialogue: 0,0:32:37.68,0:32:40.78,CNsub,NTP,0,0,0,,Менің табиғатым ескіден ескіге өзгереді.
Dialogue: 0,0:32:41.91,0:32:42.63,CNsub,NTP,0,0,0,,Түсіндірме қандай?
Dialogue: 0,0:32:43.16,0:32:45.37,CNsub,NTP,0,0,0,,Мағынаң аспанда өмір сүре бастайды.
Dialogue: 0,0:32:46.38,0:32:49.17,CNsub,NTP,0,0,0,,Дегенмен, бұл Ұлы мұнарадағы түс оқиғасы.
Dialogue: 0,0:32:49.63,0:32:51.93,CNsub,NTP,0,0,0,,Сіз қазір рәсімге жауаптысыз.
Dialogue: 0,0:32:53.05,0:32:55.82,CNsub,NTP,0,0,0,,Мен ғибадатхананың мұнарасында емеспін
Dialogue: 0,0:32:56.44,0:32:57.06,CNsub,NTP,0,0,0,,Иә?
Dialogue: 0,0:32:57.60,0:33:00.64,CNsub,NTP,0,0,0,,Менің аспаннан ерекше бөлінуім
Dialogue: 0,0:33:01.81,0:33:04.84,CNsub,NTP,0,0,0,,Менің көңілім қалғандықтан, И
Dialogue: 0,0:33:05.82,0:33:08.06,CNsub,NTP,0,0,0,,Тұлғаның бөлінуі аяқталды...?
Dialogue: 0,0:33:08.74,0:33:09.79,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:33:10.62,0:33:14.04,CNsub,NTP,0,0,0,,Сіз өзіңіздің мінезіңізді және денеңізді басқаратын көйлек киіп жүрсіз.
Dialogue: 0,0:33:14.55,0:33:18.53,CNsub,NTP,0,0,0,,Басқарылатын түпнұсқа – бір контейнер.
Dialogue: 0,0:33:20.82,0:33:25.76,CNsub,NTP,0,0,0,,Қос тірлік... Ешбір адам бұл немесе эпитет емес
Dialogue: 0,0:33:26.52,0:33:31.15,CNsub,NTP,0,0,0,,Алайда сыртқы әлемге саяхат жасай алсаңыз, елесін көре алмайсыз.
Dialogue: 0,0:33:31.99,0:33:35.01,CNsub,NTP,0,0,0,,Мен сізге негізгі мәліметтерді жіберіп алғаныңызды түсінемін.
Dialogue: 0,0:33:37.06,0:33:40.17,CNsub,NTP,0,0,0,,Баламның баласы... баламның айналасы
Dialogue: 0,0:33:41.23,0:33:43.18,CNsub,NTP,0,0,0,,Мен сенің менің досым екеніңді түсіндім.
Dialogue: 0,0:33:44.83,0:33:49.22,CNsub,NTP,0,0,0,,Алайда балаларынан айырылғандарға сақ болыңыздар.
Dialogue: 0,0:33:50.29,0:33:52.28,CNsub,NTP,0,0,0,,Бұл өлімнің маңыздылығын растау.
Dialogue: 0,0:33:52.41,0:33:56.11,CNsub,NTP,0,0,0,,Сонымен... мен әңгімені қалай тастадым?
Dialogue: 0,0:33:57.70,0:34:02.02,CNsub,NTP,0,0,0,,Хабарламаны тыңдағыңыз келсе, маған хабарлаңыз...
Dialogue: 0,0:34:03.18,0:34:07.09,CNsub,NTP,0,0,0,,«Мен осындамын, мен осындамын»
Dialogue: 0,0:34:08.00,0:34:09.16,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:34:12.30,0:34:13.31,CNsub,NTP,0,0,0,,…
Dialogue: 0,0:34:14.67,0:34:17.84,CNsub,NTP,0,0,0,,Сен таза бала болсаң, мен жүгірсем...
Dialogue: 0,0:34:21.44,0:34:24.85,CNsub,NTP,0,0,0,,Мен ауруханадамын, мен ауруханадамын.
Dialogue: 0,0:34:26.09,0:34:29.58,CNsub,NTP,0,0,0,,Әрбір цикл... гомологтық уақыт
Dialogue: 0,0:34:31.41,0:34:34.85,CNsub,NTP,0,0,0,,Әдемі гүл шоқтары
Dialogue: 0,0:34:39.98,0:34:48.32,CNsub,NTP,0,0,0,,Мен үміттенемін...Мен басқа қабілеттермен жүгіремін
Dialogue: 0,0:35:08.41,0:35:12.86,CNsub,NTP,0,0,0,,Осыдан кейін адам... Тоуко Косаки жүгіруді аяқтады.
Dialogue: 0,0:35:15.92,0:35:17.61,CNsub,NTP,0,0,0,,Қашу санаты
Dialogue: 0,0:35:18.41,0:35:21.23,CNsub,NTP,0,0,0,,Мақсатты қашу және мақсатты ұшу
Dialogue: 0,0:35:22.00,0:35:23.97,CNsub,NTP,0,0,0,,Жалпы бұрынғы қалқымалы тақырып
Dialogue: 0,0:35:24.39,0:35:25.80,CNsub,NTP,0,0,0,,Одан кейін басқа есім шығады
Dialogue: 0,0:35:26.94,0:35:29.03,CNsub,NTP,0,0,0,,«Құс көзі» санаты сізге тиесілі.
Dialogue: 0,0:35:29.17,0:35:30.69,CNsub,NTP,0,0,0,,Бұл сіздің жеке шешіміңіз үшін қажет.
Dialogue: 0,0:35:31.46,0:35:32.03,CNsub,NTP,0,0,0,,Бұл рөл де біраз қиын екен…
Dialogue: 0,0:35:32.63,0:35:35.37,CNsub,NTP,0,0,0,,Қандай әңгімені ұстану керек деп ойлайсың?
Dialogue: 0,0:35:35.76,0:35:37.05,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:35:38.55,0:35:41.85,CNsub,NTP,0,0,0,,Қылмысқа жауапты емеспіз, сол жолды қайтадан таңдай алмаймыз.
Dialogue: 0,0:35:42.65,0:35:45.39,CNsub,NTP,0,0,0,,Демек, бұл таңдалған жолда арқа жарақатынан болатын қылмыс.
Dialogue: 0,0:35:46.90,0:35:48.99,CNsub,NTP,0,0,0,,На - ең соңғы әңгіме
Dialogue: 0,0:35:50.19,0:35:51.29,CNsub,NTP,0,0,0,,Дегенмен, бұл...
Dialogue: 0,0:35:51.76,0:35:55.08,CNsub,NTP,0,0,0,,Белгілі бір білім мөлшері және жиналыстан шығу туралы шешім.
Dialogue: 0,0:35:56.53,0:35:58.28,CNsub,NTP,0,0,0,,Өйткені мен ұшу қабілетін жоғалттым
Dialogue: 0,0:35:59.11,0:36:01.03,CNsub,NTP,0,0,0,,Мен Нариде жағаға шықтым.
Dialogue: 0,0:36:03.19,0:36:04.51,CNsub,NTP,0,0,0,,Өйткені ол әлсіз
Dialogue: 0,0:36:05.15,0:36:07.08,CNsub,NTP,0,0,0,,Мүсіндерді өз бетінше рұқсатсыз алып тастау
Dialogue: 0,0:36:08.33,0:36:11.16,CNsub,NTP,0,0,0,,Өйткені...сонымен қатар шайқаста жеңіске жеткен жоқ.
Dialogue: 0,0:36:13.76,0:36:14.70,CNsub,NTP,0,0,0,,Қоғамды қорғауға арналған бұл заңдар жеткілікті ақша төленсе
Dialogue: 0,0:36:15.31,0:36:18.33,CNsub,NTP,0,0,0,,Жарық байқалатын сәтте
Dialogue: 0,0:36:19.15,0:36:21.96,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:36:23.56,0:36:25.81,CNsub,NTP,0,0,0,,Өкінішке орай, мен өзімді-өзім қамтамасыз етуді жоғалттым.
Dialogue: 0,0:36:26.49,0:36:29.60,CNsub,NTP,0,0,0,,Алайда шығыс және батыс аймақтары шын мәнінде маңызды.
Dialogue: 0,0:36:31.38,0:36:32.38,CNsub,NTP,0,0,0,,Енді олар жай ғана кішігірім бандиттер тобы
Dialogue: 0,0:36:32.69,0:36:35.52,CNsub,NTP,0,0,0,,Ол кезде өлімді қайта елестету мүмкін емес.
Dialogue: 0,0:36:37.79,0:36:41.74,CNsub,NTP,0,0,0,,Суреттің соңғы нәтижесі қорқынышты болды.
Dialogue: 0,0:36:42.69,0:36:48.03,CNsub,NTP,0,0,0,,Генерал ретінде... Генерал ретінде кешіріңіз.
Dialogue: 0,0:36:48.30,0:36:49.24,CNsub,NTP,0,0,0,,Өлім
Dialogue: 0,0:36:50.73,0:36:54.07,CNsub,NTP,0,0,0,,Өйткені... мен үшін мүмкін болатын тәсіл
Dialogue: 0,0:36:55.18,0:36:56.11,CNsub,NTP,0,0,0,,Дайынсың ба? Алтыға бес қанша?
Dialogue: 0,0:36:56.45,0:36:58.17,CNsub,NTP,0,0,0,,Мен шешкен ең аз әдіс дұрыс.
Dialogue: 0,0:37:00.82,0:37:02.27,CNsub,NTP,0,0,0,,Бұл қажетсіз термин.
Dialogue: 0,0:37:14.54,0:37:19.26,CNsub,NTP,0,0,0,,Ақырында, мен үшін «төбеден» өлгенім жақсы.
Dialogue: 0,0:37:32.81,0:37:37.11,CNsub,NTP,0,0,0,,Бүгін 31 тамыз.
Dialogue: 0,0:37:37.55,0:37:40.15,CNsub,NTP,0,0,0,,Жолдың бірінші бөлігі - Кең көпір.
Dialogue: 0,0:37:40.60,0:37:44.59,CNsub,NTP,0,0,0,,Өткен айда салынған кең көпір…
Dialogue: 0,0:37:48.68,0:37:50.02,CNsub,NTP,0,0,0,,Йоши Хаяками Куротоу
Dialogue: 0,0:37:51.77,0:37:53.57,CNsub,NTP,0,0,0,,Йоши Хаяками
Dialogue: 0,0:37:55.02,0:37:55.83,CNsub,NTP,0,0,0,,Кешіріңіз
Dialogue: 0,0:37:56.37,0:37:57.80,CNsub,NTP,0,0,0,,Менің сүйікті мүсінім ұйықтап қалды
Dialogue: 0,0:37:58.29,0:37:59.96,CNsub,NTP,0,0,0,,Қажетсіз алып тастау және тривиальды жағдайлар
Dialogue: 0,0:38:00.17,0:38:01.13,CNsub,NTP,0,0,0,,Ичикенжучидорё
Dialogue: 0,0:38:02.12,0:38:02.87,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:38:03.24,0:38:05.20,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:38:05.42,0:38:06.51,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:38:06.84,0:38:08.05,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:38:08.87,0:38:09.88,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:38:10.68,0:38:11.74,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:38:13.48,0:38:15.58,CNsub,NTP,0,0,0,,Қосымша жеңілдіктер бар ма?
Dialogue: 0,0:38:23.69,0:38:27.18,CNsub,NTP,0,0,0,,...Мияджо Дайруда өз-өзіне қол жұмсағандар саны 8 адамға дейін өсті.
Dialogue: 0,0:38:27.82,0:38:32.15,CNsub,NTP,0,0,0,,Түбір орнату сынағы, 7 адам бір-бірінің алдында, қозғалыссыз...
Dialogue: 0,0:38:28.91,0:38:29.55,CNsub,NTP,0,0,0,,Мен саған мүмкіндік беремін. Таңдауға екі жол бар.
Dialogue: 0,0:38:29.89,0:38:30.61,CNsub,NTP,0,0,0,,8 адам?
Dialogue: 0,0:38:30.89,0:38:31.74,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:38:32.08,0:38:33.47,CNsub,NTP,0,0,0,,Төменгі жаққа қарай ұша алмады
Dialogue: 0,0:38:33.96,0:38:37.06,CNsub,NTP,0,0,0,,Қалаға келудің соңғы кезеңі
Dialogue: 0,0:38:37.98,0:38:41.55,CNsub,NTP,0,0,0,,Бұрын адамдар өз мүмкіндіктерін сынап көрген
Dialogue: 0,0:38:42.14,0:38:45.23,CNsub,NTP,0,0,0,,Екі сөз байланысты.
Dialogue: 0,0:38:45.97,0:38:47.91,CNsub,NTP,0,0,0,,Дегенмен, бұл аспандағы шаршаған адам.
Dialogue: 0,0:38:48.06,0:38:49.87,CNsub,NTP,0,0,0,,Басқалардың көзіндегі қазіргі жағдай
Dialogue: 0,0:38:50.90,0:38:54.76,CNsub,NTP,0,0,0,,Нәтижесінде, өлімнен кейін де ұшуды аяқтауға болады.
Dialogue: 0,0:38:55.03,0:38:56.73,CNsub,NTP,0,0,0,,Жоғалған құлаған жер
Dialogue: 0,0:38:56.96,0:38:58.38,CNsub,NTP,0,0,0,,Жалпы құлап жатқан Будда мүсіні
Dialogue: 0,0:38:59.11,0:39:01.14,CNsub,NTP,0,0,0,,Na…жағымсыз ниет
Dialogue: 0,0:39:01.32,0:39:02.62,CNsub,NTP,0,0,0,,Мен екінші орынды білмеймін.
Dialogue: 0,0:39:03.37,0:39:04.24,CNsub,NTP,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:39:04.77,0:39:07.55,CNsub,NTP,0,0,0,,Мияджо Дайродағы адам, «Кездесу» Нариде.
Dialogue: 0,0:39:07.82,0:39:11.80,CNsub,NTP,0,0,0,,«Ұшатын», айналада тұратын адамдар тобы, өзін-өзі жоюшы қыздың елесі
Dialogue: 0,0:39:12.02,0:39:13.47,CNsub,NTP,0,0,0,,Саны 8 дана
Dialogue: 0,0:39:14.00,0:39:15.46,CNsub,NTP,0,0,0,,Сіз ұшып бара жатырсыз
Dialogue: 0,0:39:15.58,0:39:16.43,CNsub,NTP,0,0,0,,Бұл тастап кеткен жер.
Dialogue: 0,0:39:16.67,0:39:19.26,CNsub,NTP,0,0,0,,Оқиғаның қысқаша мән-жайы
Dialogue: 0,0:39:20.33,0:39:21.36,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:39:22.09,0:39:25.31,CNsub,NTP,0,0,0,,Оқиғаның сипаттамасы, үшінші дәрежелі әңгімеден алған әсері мен әсері (3)
Dialogue: 0,0:39:27.38,0:39:28.13,CNsub,NTP,0,0,0,,артқа
Dialogue: 0,0:39:45.97,0:39:48.85,CNsub,NTP,0,0,0,,Суицид түзете ме? Кения
Dialogue: 0,0:39:49.25,0:39:50.97,CNsub,NTP,0,0,0,,…
Dialogue: 0,0:39:52.14,0:39:55.81,CNsub,NTP,0,0,0,,Мысал: Мен өзімді өте зиянды қоздырғыштармен жұқтырдым.
Dialogue: 0,0:39:56.42,0:39:59.80,CNsub,NTP,0,0,0,,Маған тек Токиода тұрып, қалаға иелік ету керек.
Dialogue: 0,0:40:00.52,0:40:03.19,CNsub,NTP,0,0,0,,Мен қалай өлдім?
Dialogue: 0,0:40:03.86,0:40:05.89,CNsub,NTP,0,0,0,,Мен өзімді өлтіремін.
Dialogue: 0,0:40:06.14,0:40:07.19,CNsub,NTP,0,0,0,,Бұл айырмашылық
Dialogue: 0,0:40:07.85,0:40:10.95,CNsub,NTP,0,0,0,,Сенімсіз биологиялық жағдайлардың мысалдары
Dialogue: 0,0:40:11.21,0:40:12.06,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:40:13.07,0:40:16.27,CNsub,NTP,0,0,0,,Дегенмен мен әлсізмін.
Dialogue: 0,0:40:17.00,0:40:20.70,CNsub,NTP,0,0,0,,Дұшпандық жағдайда аман қалу үшін Токионың бүкіл тұрғындарының батылдығы.
Dialogue: 0,0:40:21.09,0:40:22.22,CNsub,NTP,0,0,0,,Демек, өзін-өзі жою
Dialogue: 0,0:40:22.72,0:40:24.36,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:40:25.51,0:40:29.27,CNsub,NTP,0,0,0,,Тікелей сақталуы тиіс уақытша батылдық пен батылдық
Dialogue: 0,0:40:29.79,0:40:31.77,CNsub,NTP,0,0,0,,Ауыратыны, ауырғаны анық.
Dialogue: 0,0:40:33.00,0:40:34.04,CNsub,NTP,0,0,0,,Белгісіздік
Dialogue: 0,0:40:34.64,0:40:36.57,CNsub,NTP,0,0,0,,Дегенмен, мен өлімнің өлімнің көрінісі деп түсінемін.
Dialogue: 0,0:40:37.37,0:40:40.58,CNsub,NTP,0,0,0,,Алайда, егер тараптар мән-жайды білмесе, қашу туралы мәліметтер болуы мүмкін.
Dialogue: 0,0:40:41.45,0:40:42.75,CNsub,NTP,0,0,0,,Мүмкін еместігін жоққа шығару
Dialogue: 0,0:40:43.14,0:40:44.15,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:40:45.28,0:40:45.96,CNsub,NTP,0,0,0,,Себеп
Dialogue: 0,0:40:47.80,0:40:49.53,CNsub,NTP,0,0,0,,Мен де әлсіз адаммын.
Dialogue: 0,0:40:51.59,0:40:52.86,CNsub,NTP,0,0,0,,Сіз мұны қаламайсыз.
Dialogue: 0,0:41:10.78,0:41:12.13,CNsub,NTP,0,0,0,,Әңгіменің шығу тегі
Dialogue: 0,0:41:12.90,0:41:14.27,CNsub,NTP,0,0,0,,Мен түсінген түсініксіз арман
Dialogue: 0,0:41:14.51,0:41:15.18,CNsub,NTP,0,0,0,,Арман?
Dialogue: 0,0:41:16.15,0:41:16.82,CNsub,NTP,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:41:17.42,0:41:18.41,CNsub,NTP,0,0,0,,Айдаһардың арманы
Dialogue: 0,0:41:19.05,0:41:20.59,CNsub,NTP,0,0,0,,Ол да таза емес.
Dialogue: 0,0:41:20.93,0:41:22.22,CNsub,NTP,0,0,0,,Мен осындамын.
Dialogue: 0,0:41:23.47,0:41:24.24,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:41:24.45,0:41:26.26,CNsub,NTP,0,0,0,,Инелік шұғыл ұшуын аяқтады.
Dialogue: 0,0:41:30.13,0:41:32.37,CNsub,NTP,0,0,0,,Осыдан кейін көбелек ұшып кетті.
Dialogue: 0,0:41:33.21,0:41:36.10,CNsub,NTP,0,0,0,,Көбелек сияқты, бірақ оянып, ұшқанда қанатыңның қағысын.
Dialogue: 0,0:41:37.07,0:41:38.11,CNsub,NTP,0,0,0,,Нәтижесінде ол орындалмайды.
Dialogue: 0,0:41:39.42,0:41:42.64,CNsub,NTP,0,0,0,,Күннің соңында мен жерге жеттім.
Dialogue: 0,0:41:44.82,0:41:49.02,CNsub,NTP,0,0,0,,Ұшақты қалай басқару керектігі туралы әңгіме.
18-бөлім
Dialogue: 0,0:41:50.98,0:41:57.87,CNsub,NTP,0,0,0,,「」「」
Dialogue: 0,0:41:59.28,0:42:00.56,CNsub,NTP,0,0,0,,Осыған байланысты
Dialogue: 0,0:42:02.48,0:42:03.70,CNsub,NTP,0,0,0,,Қайта жүзу жоқ
Dialogue: 0,0:42:07.01,0:42:08.40,CNsub,NTP,0,0,0,,…
Dialogue: 0,0:42:08.65,0:42:10.18,CNsub,NTP,0,0,0,,Менің зерттеуім шығыс пен батыста.
Dialogue: 0,0:42:10.93,0:42:13.77,CNsub,NTP,0,0,0,,...
Dialogue: 0,0:42:13.84,0:42:14.65,CNsub,NTP,0,0,0,,Кения
Dialogue: 0,0:42:14.92,0:42:15.97,CNsub,NTP,0,0,0,,Қазір Теншу түседі
Dialogue: 0,0:42:16.42,0:42:17.17,CNsub,NTP,0,0,0,,Қамшы?
Dialogue: 0,0:42:17.91,0:42:19.01,CNsub,NTP,0,0,0,,Кенеттен...
Dialogue: 0,0:42:19.12,0:42:20.01,CNsub,NTP,0,0,0,,Басқа сұрақтар
Dialogue: 0,0:42:20.71,0:42:21.74,CNsub,NTP,0,0,0,,Есептеу
Dialogue: 0,0:42:22.17,0:42:24.52,CNsub,NTP,0,0,0,,Бұл жерде тұру сізге ыңғайлы.
Dialogue: 0,0:42:24.97,0:42:26.95,CNsub,NTP,0,0,0,,Сіздің жағдайыңыз қандай?
Dialogue: 0,0:42:28.29,0:42:29.23,CNsub,NTP,0,0,0,,Шөп…
Dialogue: 0,0:42:30.36,0:42:31.12,CNsub,NTP,0,0,0,,Қамшы?
Dialogue: 0,0:42:33.46,0:42:35.30,CNsub,NTP,0,0,0,,…
Dialogue: 0,0:42:35.72,0:42:37.20,CNsub,NTP,0,0,0,,Сіз боссыз
Dialogue: 0,0:42:37.49,0:42:38.54,CNsub,NTP,0,0,0,,Менің шешімім
Dialogue: 0,0:42:51.85,0:42:52.68,CNsub,NTP,0,0,0,,Қай жерде өлдің?
Dialogue: 0,0:42:53.06,0:42:54.13,CNsub,NTP,0,0,0,,Қазір мен қайдамын
Dialogue: 0,0:42:56.57,0:42:57.68,CNsub,NTP,0,0,0,,Дегенмен, бұл өрнек
Dialogue: 0,0:42:59.06,0:43:00.91,CNsub,NTP,0,0,0,,「」
Dialogue: 0,0:43:01.47,0:43:03.91,CNsub,NTP,0,0,0,,Сөйлесу кезіндегі ойлау әдісін өзгерту
Dialogue: 0,0:43:05.42,0:43:07.08,CNsub,NTP,0,0,0,,Сіз қыз бала бола аласыз.
Dialogue: 0,0:43:10.05,0:43:10.85,CNsub,NTP,0,0,0,,Көп тұмсық
Dialogue: 0,0:43:11.04,0:43:11.99,CNsub,NTP,0,0,0,,Қажетті нұсқаулар
Dialogue: 0,0:47:27.17,0:47:28.47,CNsub,NTP,0,0,0,,Бұл жерде пайда болады
Dialogue: 0,0:47:29.19,0:47:31.71,CNsub,NTP,0,0,0,,8-ші өз-өзіне қол жұмсаған адам
Dialogue: 0,0:47:32.10,0:47:35.93,CNsub,NTP,0,0,0,,Бұл Мияджо Даироның бастапқы иесінің үлкен қызы.
Dialogue: 0,0:47:36.35,0:47:37.24,CNsub,NTP,0,0,0,,Өзін-өзі жұқтыратын ауыр аурудың анықтамасы
Dialogue: 0,0:47:37.58,0:47:40.97,CNsub,NTP,0,0,0,,Қаладағы отбасылық ауруханада 10 жыл тұрдым.
Dialogue: 0,0:47:41.55,0:47:47.67,CNsub,NTP,0,0,0,,27 жасында ауруханаға түскеннен кейін жас келіншек ауруханадан шығып, аурухананы ашты...
Dialogue: 0,0:47:47.79,0:47:48.52,CNsub,NTP,0,0,0,,Фука
Dialogue: 0,0:47:51.70,0:47:52.84,CNsub,NTP,0,0,0,,Өткен суицид
Dialogue: 0,0:47:53.48,0:47:55.38,CNsub,NTP,0,0,0,,Козо – орта мектептің төменгі сынып оқушысы.
Dialogue: 0,0:47:56.45,0:47:57.15,CNsub,NTP,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:47:57.45,0:47:59.14,CNsub,NTP,0,0,0,,Тілшінің пікірі азап пен суицидке байланысты болды
Dialogue: 0,0:47:59.32,0:48:02.77,CNsub,NTP,0,0,0,,Жапондық суицид оқиғасы
Dialogue: 0,0:48:03.86,0:48:05.01,CNsub,NTP,0,0,0,,Кешір мені.
Dialogue: 0,0:48:06.65,0:48:08.64,CNsub,NTP,0,0,0,,Бұл аяқталуға жақын.
Dialogue: 0,0:48:11.35,0:48:12.12,CNsub,NTP,0,0,0,,Өзімшілдік
Dialogue: 0,0:48:12.33,0:48:15.09,CNsub,NTP,0,0,0,,Адамның өзін-өзі жеңетін сезімдері
Dialogue: 0,0:48:17.01,0:48:18.57,CNsub,NTP,0,0,0,,Сіз қызғылт сары түсті түсінесіз бе?
Dialogue: 0,0:48:22.13,0:48:23.71,CNsub,NTP,0,0,0,,Өзін-өзі өлтірудің себебі бар
Dialogue: 0,0:48:26.93,0:48:29.98,CNsub,NTP,0,0,0,,Дәл қазір...Мен ұша алмаймын.
Dialogue: 0,0:49:37.13,0:49:39.04,CNsub,NTP,0,0,0,,Қылмыстық жарақат алды
Dialogue: 0,0:49:39.19,0:49:41.11,CNsub,NTP,0,0,0,,Тек орындаңыз.
Dialogue: 0,0:49:41.44,0:49:42.01,CNsub,NTP,0,0,0,,Түсіндірме қандай?
Dialogue: 0,0:49:42.30,0:49:42.84,CNsub,NTP,0,0,0,,Мен қайдамын?
Dialogue: 0,0:49:43.03,0:49:43.41,CNsub,NTP,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:49:43.65,0:49:45.50,CNsub,NTP,0,0,0,,Ерте ескерту қалай келді?
Dialogue: 0,0:49:46.20,0:49:47.32,CNsub,NTP,0,0,0,,Егер ол шынымен бар болса…
Dialogue: 0,0:49:47.53,0:49:49.01,CNsub,NTP,0,0,0,,Кездесуімізді қайталау
Dialogue: 0,0:50:07.95,0:50:13.95,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
