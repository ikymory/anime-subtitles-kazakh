Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:18.01,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.01,0:00:27.02,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.02,0:00:38.05,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.05,0:00:49.01,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.01,0:01:02.02,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.06,0:01:13.07,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.07,0:01:28.03,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:31.00,0:01:35.00,Default,,0,0,0,,Мен олардың мұндай әсіреленген ыдысқа қашан және не үшін түскенін білемін.
Dialogue: 0,0:01:36.02,0:01:39.08,Default,,0,0,0,,35 санының векторлық белсенділік диапазоны 11 метр
Dialogue: 0,0:01:42.02,0:01:44.08,Default,,0,0,0,,35 саны болуы мүмкін
Dialogue: 0,0:01:44.08,0:01:46.02,Default,,0,0,0,,Люсиді ұрыңыз
Dialogue: 0,0:01:46.08,0:01:50.09,Default,,0,0,0,,Бірақ бұл жігіт адамды инстинктивті түрде өлтіретін құбыжық.
Dialogue: 0,0:01:52.01,0:01:54.00,Default,,0,0,0,,Адамдарды ынтымақтастыққа қалай тартуға болады
Dialogue: 0,0:01:54.09,0:01:58.02,Default,,0,0,0,,Оның үстіне бостандыққа шыққан соң оны қалай ұстайсың?
Dialogue: 0,0:02:00.07,0:02:02.08,Default,,0,0,0,,Сіз отырып қайыр сұрауды жоспарлап отырсыз ба?
Dialogue: 0,0:02:04.00,0:02:05.05,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:02:06.08,0:02:07.07,Default,,0,0,0,,Сіз?
Dialogue: 0,0:02:10.00,0:02:11.09,Default,,0,0,0,,Иә, мен Саитомын, алмастырушы ата-ана ретінде әрекет етемін.
Dialogue: 0,0:02:17.04,0:02:19.06,Default,,0,0,0,,Мониторда ақау жоқ, бірақ
Dialogue: 0,0:02:20.04,0:02:22.09,Default,,0,0,0,,Мүмкін мен аяғымды көтере алмаймын.
Dialogue: 0,0:02:23.09,0:02:27.07,Default,,0,0,0,,Мен туылғаннан бері осында оқшауланғанмын.
Dialogue: 0,0:02:29.01,0:02:31.04,Default,,0,0,0,,Мм, шынымен де осы жерден. . .
Dialogue: 0,0:02:31.09,0:02:32.06,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:02:33.09,0:02:38.00,Default,,0,0,0,,Сайтоның бес жыл ішінде тек 35 санына тағайындалғаны рас.
Dialogue: 0,0:02:38.06,0:02:41.04,Default,,0,0,0,,Мен күн сайын сөйлеушімен сөйлесемін.
Dialogue: 0,0:02:43.03,0:02:44.09,Default,,0,0,0,,Мен солай айтсам
Dialogue: 0,0:02:44.09,0:02:46.03,Default,,0,0,0,,Тыңдайсыздар деп үміттенемін. Тыңдайсыңдар деген үміттемін.
Dialogue: 0,0:02:46.09,0:02:49.09,Default,,0,0,0,,Ол мені ана деп атайды.
Dialogue: 0,0:02:51.06,0:02:53.00,Default,,0,0,0,,Біртүрлі сезіледі.
Dialogue: 0,0:02:53.04,0:02:56.00,Default,,0,0,0,,Жүзіңді көрмесем де
Dialogue: 0,0:02:56.05,0:02:58.06,Default,,0,0,0,,Бөлінген қызыммен көңіл-күйім жақсы сияқты.
Dialogue: 0,0:02:59.04,0:03:00.02,Default,,0,0,0,,Дайын бол
Dialogue: 0,0:03:00.04,0:03:00.54,Default,,0,0,0,,Иә
Dialogue: 0,0:03:02.04,0:03:05.00,Default,,0,0,0,,Сіз оны сендіруге тырысасыз ба?
Dialogue: 0,0:03:05.09,0:03:07.08,Default,,0,0,0,,Ең күшті Диклониус шығар
Dialogue: 0,0:03:08.03,0:03:10.03,Default,,0,0,0,,35 саны әлі бала.
Dialogue: 0,0:03:11.03,0:03:14.04,Default,,0,0,0,,Ол менің ата-анам және жалғыз адам
Dialogue: 0,0:03:15.08,0:03:19.03,Default,,0,0,0,,Мен де 35 санының оны жоғалтуына жол бере алмаймын.
Dialogue: 0,0:03:20.04,0:03:23.08,Default,,0,0,0,,Бірақ оны тыңдау кепілдігі
Dialogue: 0,0:03:24.02,0:03:26.00,Default,,0,0,0,,Егер мені тыңдамасаң
Dialogue: 0,0:03:26.02,0:03:27.03,Default,,0,0,0,,Тек мені қорқыт.
Dialogue: 0,0:03:28.07,0:03:29.08,Default,,0,0,0,,35 саны
Dialogue: 0,0:03:30.03,0:03:34.01,Default,,0,0,0,,Сіз дүниеге келген бойда денеңізге бомба қондырылды.
Dialogue: 0,0:03:34.04,0:03:36.04,Default,,0,0,0,,Ба. . . Мен оны бірінші рет естідім
Dialogue: 0,0:03:36.09,0:03:38.02,Default,,0,0,0,,Неліктен мұндай еліктеу керек?
Dialogue: 0,0:03:39.00,0:03:40.03,Default,,0,0,0,,Қандай себеп болса да
Dialogue: 0,0:03:40.03,0:03:43.00,Default,,0,0,0,,Бұл сөзсіз қазір пайдалы.
Dialogue: 0,0:03:44.04,0:03:46.06,Default,,0,0,0,,35 санының айтқанын тыңдамасаңыз
Dialogue: 0,0:03:47.07,0:03:49.06,Default,,0,0,0,,Жару арқылы жою
Dialogue: 0,0:03:50.07,0:03:51.04,Default,,0,0,0,,Бомба?
Dialogue: 0,0:03:52.01,0:03:53.06,Default,,0,0,0,,Директор осылай деді
Dialogue: 0,0:03:54.02,0:03:56.01,Default,,0,0,0,,Курама түсінеді.
Dialogue: 0,0:03:56.08,0:04:01.00,Default,,0,0,0,,Қызының адамға зиянын тигізбеу үшін әкенің міндетінен.
Dialogue: 0,0:04:03.06,0:04:05.02,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:04:05.02,0:04:08.07,Default,,0,0,0,,Ол мені ешқашан сатпауы үшін шынжыр болды. Ол маған ешқашан опасыздық жасамас үшін шынжыр болды.
Dialogue: 0,0:04:09.05,0:04:11.00,Default,,0,0,0,,Екі қолда да даңқ; жеңіс – біздің әніміз
Dialogue: 0,0:04:11.08,0:04:15.01,Default,,0,0,0,,Ол маған бағынбай, Гилперитті қашып жіберді.
Dialogue: 0,0:04:16.08,0:04:18.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:18.02,0:04:21.07,Default,,0,0,0,,Олар бюджетті барынша тиімді пайдалану үшін жұмыс істесін.
Dialogue: 0,0:04:22.04,0:04:24.05,Default,,0,0,0,,Бөлшектерді шығару
Dialogue: 0,0:04:41.01,0:04:43.00,Default,,0,0,0,,Марико-чан, қош келдіңіз
Dialogue: 0,0:04:43.09,0:04:45.02,Default,,0,0,0,,Шығу уақыты жақындап қалды.
Dialogue: 0,0:04:55.00,0:04:55.50,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:05:03.00,0:05:03.50,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:05:16.08,0:05:18.05,Default,,0,0,0,,Сізге жақындауға рұқсат бергенім дұрыс па?
Dialogue: 0,0:05:19.01,0:05:21.06,Default,,0,0,0,,Сіз сигнал жіберуге дайындалып жатырсыз ба?
Dialogue: 0,0:05:26.07,0:05:29.03,Default,,0,0,0,,Бейшара, сондай жұқа.
Dialogue: 0,0:05:38.03,0:05:40.09,Default,,0,0,0,,Сіз мені түсінесіз бе?
Dialogue: 0,0:05:42.07,0:05:43.09,Default,,0,0,0,,О. . . ана?
Dialogue: 0,0:05:49.04,0:05:50.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:56.00,0:05:56.50,Default,,0,0,0,,Ширакава
Dialogue: 0,0:06:06.00,0:06:07.01,Default,,0,0,0,,Бомба туралы сигнал
Dialogue: 0,0:06:07.01,0:06:07.51,Default,,0,0,0,,Ерте
Dialogue: 0,0:06:10.04,0:06:12.02,Default,,0,0,0,,Сондықтан мен ештеңе айтпаймын
Dialogue: 0,0:06:14.06,0:06:16.07,Default,,0,0,0,,Ширакава Қашайық
Dialogue: 0,0:06:44.02,0:06:46.05,Default,,0,0,0,,Ауырған кезде асығыңыз
Dialogue: 0,0:06:46.05,0:06:47.09,Default,,0,0,0,,Векторларды қолдануға болмайды
Dialogue: 0,0:06:53.06,0:06:54.07,Default,,0,0,0,,Түсіндіңіз.
Dialogue: 0,0:06:55.00,0:06:57.02,Default,,0,0,0,,Сіз бізді тыңдауыңыз керек
Dialogue: 0,0:06:57.05,0:06:59.00,Default,,0,0,0,,Сіз одан бетер ауырасыз.
Dialogue: 0,0:07:07.04,0:07:09.04,Default,,0,0,0,,Балмұздақ дәмді
Dialogue: 0,0:07:09.04,0:07:11.03,Default,,0,0,0,,Неге, Маю, мен тоқтай алмаймын.
Dialogue: 0,0:07:12.05,0:07:14.06,Default,,0,0,0,,Кенеттен тамақ ішу
Dialogue: 0,0:07:14.06,0:07:15.07,Default,,0,0,0,,Итатата
Dialogue: 0,0:07:16.03,0:07:18.09,Default,,0,0,0,,Басым ауырып тұр ғой деймін.
Dialogue: 0,0:07:19.09,0:07:21.06,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:25.03,0:07:27.08,Default,,0,0,0,,О, мен оны жыртып алдым.
Dialogue: 0,0:07:28.09,0:07:29.06,Default,,0,0,0,,Жаңа
Dialogue: 0,0:07:32.05,0:07:36.00,Default,,0,0,0,,Нана, бір сәт.
Dialogue: 0,0:07:39.03,0:07:42.00,Default,,0,0,0,,Ал, бұл қайда?
Dialogue: 0,0:07:45.05,0:07:47.04,Default,,0,0,0,,Ол қалыпты жағдайға орала ма?
Dialogue: 0,0:07:58.09,0:08:01.00,Default,,0,0,0,,Менен сұрасаң да, мен ештеңе айтпаймын.
Dialogue: 0,0:08:04.03,0:08:06.03,Default,,0,0,0,,Ню-чанмен қандай қарым-қатынастасың?
Dialogue: 0,0:08:06.06,0:08:07.05,Default,,0,0,0,,Бұл туралы
Dialogue: 0,0:08:10.02,0:08:12.04,Default,,0,0,0,,Егер сіз сөйлескіңіз келмесе, өзіңізді сұрауға мәжбүрлемеңіз.
Dialogue: 0,0:08:13.07,0:08:16.09,Default,,0,0,0,,Бірақ сіз мені қанша қонақ ретінде қабылдасаңыз да,
Dialogue: 0,0:08:16.09,0:08:17.06,Default,,0,0,0,,Мен қиындыққа тап болдым
Dialogue: 0,0:08:18.00,0:08:18.50,Default,,0,0,0,,Кота
Dialogue: 0,0:08:22.06,0:08:24.00,Default,,0,0,0,,Ә? Жоқ, мен ештеңе істеген жоқпын…
Dialogue: 0,0:08:25.08,0:08:27.06,Default,,0,0,0,,Бірден осылай
Dialogue: 0,0:08:28.00,0:08:29.07,Default,,0,0,0,,Маған үй жұмыстарына көмек керек.
Dialogue: 0,0:08:30.02,0:08:31.02,Default,,0,0,0,,Оны мұнда қоюға болмайды.
Dialogue: 0,0:08:32.06,0:08:34.05,Default,,0,0,0,,Мұнда барлығы осылай істейді.
Dialogue: 0,0:08:35.02,0:08:36.01,Default,,0,0,0,,Мен және Юка
Dialogue: 0,0:08:36.06,0:08:37.07,Default,,0,0,0,,Тіпті Маю-чан
Dialogue: 0,0:08:38.06,0:08:41.00,Default,,0,0,0,,Нана, мен осында тұра аламын ба?
Dialogue: 0,0:08:42.05,0:08:43.09,Default,,0,0,0,,Сіз қайда баруды жоспарладыңыз?
Dialogue: 0,0:08:45.04,0:08:46.02,Default,,0,0,0,,Өйткені
Dialogue: 0,0:08:47.05,0:08:50.00,Default,,0,0,0,,Әйтеуір қалыпты жағдайға оралды.
Dialogue: 0,0:08:54.03,0:08:57.02,Default,,0,0,0,,Жаңа ма? Жаңа
Dialogue: 0,0:09:00.04,0:09:01.06,Default,,0,0,0,,Ах. . Бұл
Dialogue: 0,0:09:01.06,0:09:03.06,Default,,0,0,0,,Себебі мен қорықтым.
Dialogue: 0,0:09:03.08,0:09:07.06,Default,,0,0,0,,Бұдан былай жалғыз өзім не істерімді білмеймін.
Dialogue: 0,0:09:07.08,0:09:10.06,Default,,0,0,0,,Мен әрқашан қорқатынмын
Dialogue: 0,0:09:11.01,0:09:12.00,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:09:12.04,0:09:13.04,Default,,0,0,0,,Сәлем Маю-чан
Dialogue: 0,0:09:14.00,0:09:14.50,Default,,0,0,0,,Иә
Dialogue: 0,0:09:15.02,0:09:17.00,Default,,0,0,0,,Егер бұл бала жасай алатын бірдеңе болса ше?
Dialogue: 0,0:09:17.03,0:09:18.03,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:09:19.04,0:09:20.00,Default,,0,0,0,,Иә
Dialogue: 0,0:09:24.08,0:09:25.06,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:09:41.07,0:09:43.00,Default,,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:09:43.06,0:09:46.06,Default,,0,0,0,,Сіз мына ыстық суға шомыласыз ба?
Dialogue: 0,0:09:47.01,0:09:48.03,Default,,0,0,0,,. . иә
Dialogue: 0,0:09:50.02,0:09:52.06,Default,,0,0,0,,Жоқ, ыстық су жақсы сезінеді.
Dialogue: 0,0:09:53.05,0:09:59.01,Default,,0,0,0,,Денеңіз кірленсе, оны сумен төгіп тастауға болады.
Dialogue: 0,0:09:59.06,0:10:00.04,Default,,0,0,0,,Шланг?
Dialogue: 0,0:10:03.05,0:10:04.01,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:10:04.02,0:10:06.06,Default,,0,0,0,,Маю Мен мұны бұрын айттым.
Dialogue: 0,0:10:07.04,0:10:11.02,Default,,0,0,0,,Бірақ мен білетін Ню-сан өте жақсы адам.
Dialogue: 0,0:10:11.07,0:10:14.01,Default,,0,0,0,,Бұл адам Люси-санға қайта оралды.
Dialogue: 0,0:10:14.01,0:10:15.02,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,0:10:18.04,0:10:20.07,Default,,0,0,0,,Мен сенің мәңгілік Ню-сан сияқты болғаныңды қалаймын.
Dialogue: 0,0:10:22.03,0:10:26.02,Default,,0,0,0,,Сонда Нана да осында бақытты өмір сүре алады.
Dialogue: 0,0:10:40.02,0:10:42.04,Default,,0,0,0,,Камакурада 7 саны көрінген сияқты.
Dialogue: 0,0:10:45.02,0:10:46.08,Default,,0,0,0,,Кимоно және т.б. № 35.
Dialogue: 0,0:10:47.02,0:10:49.01,Default,,0,0,0,,Бомба өте тиімді болған сияқты.
Dialogue: 0,0:10:49.04,0:10:51.03,Default,,0,0,0,,Мен қазір тынышпын.
Dialogue: 0,0:10:52.04,0:10:54.06,Default,,0,0,0,,Директор Курамаға не болды?
Dialogue: 0,0:10:55.04,0:10:56.09,Default,,0,0,0,,Ол мүлдем көрінбейді.
Dialogue: 0,0:10:58.04,0:11:01.05,Default,,0,0,0,,35 нөмірі маған қалды.
Dialogue: 0,0:11:02.03,0:11:04.02,Default,,0,0,0,,Бірақ. . . Эй
Dialogue: 0,0:11:04.03,0:11:06.01,Default,,0,0,0,,Кеңсе меңгерушісіне есеп беру.
Dialogue: 0,0:11:06.07,0:11:09.00,Default,,0,0,0,,Өйткені бұл менің рөлім
Dialogue: 0,0:11:14.04,0:11:15.00,Default,,0,0,0,,Директор
Dialogue: 0,0:11:17.04,0:11:18.04,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:32.04,0:11:33.02,Default,,0,0,0,,Өткен түн
Dialogue: 0,0:11:33.08,0:11:36.05,Default,,0,0,0,,Иә, бұл шұғыл байланыс жиналысы болды.
Dialogue: 0,0:11:36.05,0:11:39.03,Default,,0,0,0,,Ол арнайы шабарманмен кетіп қалды. Ол арнайы рейспен кетті.
Dialogue: 0,0:11:40.08,0:11:43.00,Default,,0,0,0,,Иә, жоқ па?
Dialogue: 0,0:11:46.07,0:11:47.02,Default,,0,0,0,,Ширакава мырза
Dialogue: 0,0:11:47.07,0:11:50.06,Default,,0,0,0,,No35 тасымалдауға дайын.
Dialogue: 0,0:11:51.00,0:11:52.02,Default,,0,0,0,,Кез келген уақытта тұрыңыз
Dialogue: 0,0:11:54.07,0:11:56.08,Default,,0,0,0,,Директор, сіз бе?
Dialogue: 0,0:12:01.02,0:12:02.08,Default,,0,0,0,,Осы жолы «өлім шеңберінен» аман қалған сияқтымын.
Dialogue: 0,0:12:03.04,0:12:06.03,Default,,0,0,0,,Жуынбағаныма неше күн болды?
Dialogue: 0,0:12:12.04,0:12:15.08,Default,,0,0,0,,Менің университетімде аспиранттарды қосқанда 3000-ға жуық студент бар.
Dialogue: 0,0:12:16.03,0:12:17.06,Default,,0,0,0,,Мен бір рет қана кездестірген бала
Dialogue: 0,0:12:17.06,0:12:19.01,Default,,0,0,0,,Тек оны іздеңіз.
Dialogue: 0,0:12:20.00,0:12:22.05,Default,,0,0,0,,Бұдан басқа, олар маған java-мен душ қабылдауға рұқсат бермейді.
Dialogue: 0,0:12:22.09,0:12:24.09,Default,,0,0,0,,Мен көптен бері іш киімімді ауыстырмадым.
Dialogue: 0,0:12:25.02,0:12:27.00,Default,,0,0,0,,Солай болатын сияқты.
Dialogue: 0,0:12:27.01,0:12:28.00,Default,,0,0,0,,Мүмкін емес. . .
Dialogue: 0,0:12:29.02,0:12:31.04,Default,,0,0,0,,Иә, иә, мен асығамын.
Dialogue: 0,0:12:41.09,0:12:42.06,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:43.01,0:12:44.03,Default,,0,0,0,,Бұл қолға не болды?
Dialogue: 0,0:12:45.01,0:12:48.04,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:12:49.02,0:12:51.06,Default,,0,0,0,,Қосылымдар мен басқару элементтері зақымдалмаса.
Dialogue: 0,0:12:52.09,0:12:55.01,Default,,0,0,0,,Мүмкін қарапайым бөлшектерді ауыстыру
Dialogue: 0,0:12:55.05,0:12:56.05,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:12:56.06,0:13:00.05,Default,,0,0,0,,Мен бөлшектерді ешкім білмей-ақ сатып аламын.
Dialogue: 0,0:13:01.04,0:13:03.03,Default,,0,0,0,,Сіз мені не істеуге мәжбүрлейсіз?
Dialogue: 0,0:13:04.09,0:13:07.03,Default,,0,0,0,,Диклониус, сізді жақын арада осында қарсы алатын адам.
Dialogue: 0,0:13:08.00,0:13:09.08,Default,,0,0,0,,Мені өлтіргеніңді қалаймын
Dialogue: 0,0:13:12.02,0:13:13.09,Default,,0,0,0,,Ма. . . Шынайы ма?
Dialogue: 0,0:13:15.06,0:13:17.02,Default,,0,0,0,,Вантаның фидері?
Dialogue: 0,0:13:17.04,0:13:18.00,Default,,0,0,0,,Иә
Dialogue: 0,0:13:18.03,0:13:20.06,Default,,0,0,0,,Нана, мен қазір ештеңе істей алмаймын.
Dialogue: 0,0:13:20.07,0:13:22.08,Default,,0,0,0,,Маю маған көп нәрсені үйретеді.
Dialogue: 0,0:13:23.06,0:13:25.04,Default,,0,0,0,,Иә, бұл жақсы деп ойлаймын.
Dialogue: 0,0:13:27.09,0:13:30.04,Default,,0,0,0,,Қолыңыздан келгенін жасаңыз.
Dialogue: 0,0:13:35.08,0:13:38.03,Default,,0,0,0,,Бұл бала кім?
Dialogue: 0,0:13:42.07,0:13:43.06,Default,,0,0,0,,Әпке
Dialogue: 0,0:13:44.03,0:13:45.06,Default,,0,0,0,,Ол қайтыс болды.
Dialogue: 0,0:13:47.00,0:13:48.02,Default,,0,0,0,,Сіз өлдіңіз бе?
Dialogue: 0,0:13:50.04,0:13:53.06,Default,,0,0,0,,Өлер алдында бір сұмдық айттың.
Dialogue: 0,0:13:54.06,0:13:56.01,Default,,0,0,0,,Мен жақсы есімде жоқ.
Dialogue: 0,0:13:56.04,0:13:58.00,Default,,0,0,0,,Мен әрқашан өкінетінмін
Dialogue: 0,0:13:59.04,0:14:01.09,Default,,0,0,0,,Кешірім сұрайын десем де, Кана кетіп қалды. . .
Dialogue: 0,0:14:02.08,0:14:07.07,Default,,0,0,0,,. . . Нана на на. . . Кота жылама
Dialogue: 0,0:14:10.02,0:14:11.01,Default,,0,0,0,,Жылама
Dialogue: 0,0:14:11.03,0:14:13.00,Default,,0,0,0,,Сондықтан жылама
Dialogue: 0,0:14:19.07,0:14:20.07,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:14:22.01,0:14:24.08,Default,,0,0,0,,Жоқ, бір сәтке солай болды.
Dialogue: 0,0:14:28.08,0:14:30.08,Default,,0,0,0,,Қайшымен не істейсің?
Dialogue: 0,0:14:36.02,0:14:37.08,Default,,0,0,0,,Ол қайда кетті?
Dialogue: 0,0:14:38.01,0:14:39.05,Default,,0,0,0,,Мен екінші қабатқа қараймын.
Dialogue: 0,0:14:39.05,0:14:40.06,Default,,0,0,0,,Нана да барады
Dialogue: 0,0:14:40.06,0:14:42.00,Default,,0,0,0,,Ню-сан?
Dialogue: 0,0:14:54.05,0:14:55.03,Default,,0,0,0,,Жаңа
Dialogue: 0,0:14:58.01,0:14:58.51,Default,,0,0,0,,Жаңа
Dialogue: 0,0:14:59.06,0:15:00.09,Default,,0,0,0,,Жаңа емес
Dialogue: 0,0:15:08.02,0:15:12.02,Default,,0,0,0,,Канае кешіреді Кота кешірші кешір
Dialogue: 0,0:15:15.02,0:15:20.04,Default,,0,0,0,,Усан, мен сенің қарындасың болып, Кота-санды кешіремін.
Dialogue: 0,0:15:22.03,0:15:23.06,Default,,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:15:23.09,0:15:25.08,Default,,0,0,0,,Маю айтқандай.
Dialogue: 0,0:15:26.00,0:15:27.08,Default,,0,0,0,,Ол өте жақсы адам.
Dialogue: 0,0:15:29.02,0:15:30.07,Default,,0,0,0,,Кеттік
Dialogue: 0,0:15:32.03,0:15:35.06,Default,,0,0,0,,Кота мұңды түрі Маған ұнамайды
Dialogue: 0,0:15:38.01,0:15:39.09,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:42.03,0:15:44.06,Default,,0,0,0,,Сіз алғаш келген кезде
Dialogue: 0,0:15:46.03,0:15:47.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:47.04,0:15:49.00,Default,,0,0,0,,Сіз әлі де бұл туралы алаңдайсыз ба?
Dialogue: 0,0:15:49.08,0:15:53.02,Default,,0,0,0,,'Otoishi-kun' деп жазып қойыңызшы
Dialogue: 0,0:15:54.09,0:15:56.07,Default,,0,0,0,,Кешіріңіз. . . Айт
Dialogue: 0,0:16:01.06,0:16:03.03,Default,,0,0,0,,Мен оның не екенін білмеймін
Dialogue: 0,0:16:03.08,0:16:06.04,Default,,0,0,0,,Мен Ню туралы бұрыннан білемін.
Dialogue: 0,0:16:08.02,0:16:09.02,Default,,0,0,0,,Кота
Dialogue: 0,0:16:11.00,0:16:11.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:12.04,0:16:13.07,Default,,0,0,0,,Маған да Ню ұнайды
Dialogue: 0,0:16:24.07,0:16:28.04,Default,,0,0,0,,Сіз қоңырау шалып жатқан телефон сигнал жоқ жерде ме?
Dialogue: 0,0:16:29.08,0:16:31.04,Default,,0,0,0,,Директор Қайда?
Dialogue: 0,0:16:33.08,0:16:34.04,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:16:36.05,0:16:38.01,Default,,0,0,0,,Сіз мұны әлі істеп жатырсыз ба?
Dialogue: 0,0:16:38.04,0:16:40.09,Default,,0,0,0,,Бастапқыда ол бұзылған, сондықтан жақсы.
Dialogue: 0,0:16:42.00,0:16:43.09,Default,,0,0,0,,Юка, кеш болды.
Dialogue: 0,0:16:45.06,0:16:47.08,Default,,0,0,0,,Өйткені Нана тамаққа жауапты.
Dialogue: 0,0:16:48.02,0:16:49.05,Default,,0,0,0,,Көп тамақтаныңыз
Dialogue: 0,0:16:49.08,0:16:52.00,Default,,0,0,0,,А, жеткілікті.
Dialogue: 0,0:16:54.01,0:16:57.00,Default,,0,0,0,,Бұл тірі зат, солай емес пе?
Dialogue: 0,0:16:57.02,0:17:00.05,Default,,0,0,0,,Менің атым Ванта.
Dialogue: 0,0:17:02.00,0:17:03.02,Default,,0,0,0,,Сәлем Маю
Dialogue: 0,0:17:03.06,0:17:04.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:05.07,0:17:08.01,Default,,0,0,0,,Осындай нәрсе жақсы, солай емес пе?
Dialogue: 0,0:17:08.09,0:17:09.03,Default,,0,0,0,,Иә
Dialogue: 0,0:17:16.03,0:17:19.01,Default,,0,0,0,,Басқа Люси болмағаны жақсы болар еді.
Dialogue: 0,0:17:19.08,0:17:21.05,Default,,0,0,0,,Сіз мені өлтіре аласыз, солай ма?
Dialogue: 0,0:17:23.02,0:17:24.04,Default,,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:17:25.06,0:17:27.05,Default,,0,0,0,,Мен Нананы өлтіруге келдім.
Dialogue: 0,0:17:29.00,0:17:31.06,Default,,0,0,0,,Диклониус Нана сияқты
Dialogue: 0,0:17:32.01,0:17:34.01,Default,,0,0,0,,зор зұлымдық
Dialogue: 0,0:17:35.00,0:17:36.06,Default,,0,0,0,,Жабық
Dialogue: 0,0:17:44.06,0:17:46.06,Default,,0,0,0,,Бұл бала екеніне күмән жоқ.
Dialogue: 0,0:17:51.04,0:17:53.09,Default,,0,0,0,,Нана-сан, сабыр етші.
Dialogue: 0,0:17:54.00,0:17:55.09,Default,,0,0,0,,Мен Нананы білетінмін.
Dialogue: 0,0:17:56.04,0:18:00.00,Default,,0,0,0,,Мен міндетті түрде келіп Нананы өлтіремін. Мүлдем.
Dialogue: 0,0:18:01.05,0:18:04.00,Default,,0,0,0,,Маю-чан, сен Юканың қайда екенін білмейсің бе?
Dialogue: 0,0:18:04.05,0:18:06.07,Default,,0,0,0,,Жоқ, мен ол туралы естіген жоқпын.
Dialogue: 0,0:18:07.02,0:18:10.00,Default,,0,0,0,,Ол кеспе алатынын айтты.
Dialogue: 0,0:18:10.09,0:18:12.05,Default,,0,0,0,,тым кеш.
Dialogue: 0,0:18:12.09,0:18:14.03,Default,,0,0,0,,Бұл біреу ме?
Dialogue: 0,0:18:14.09,0:18:16.08,Default,,0,0,0,,Бұл мен және Юканың сүйікті тамағы.
Dialogue: 0,0:18:17.03,0:18:19.06,Default,,0,0,0,,Сондықтан мен Нананың да жегенін қалаймын.
Dialogue: 0,0:18:26.02,0:18:27.02,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:18:30.03,0:18:31.06,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:18:32.00,0:18:33.03,Default,,0,0,0,,Мен біраз уақытқа шығамын.
Dialogue: 0,0:18:34.00,0:18:34.50,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:18:35.02,0:18:37.09,Default,,0,0,0,,Жарайды, мен міндетті түрде қайтамын.
Dialogue: 0,0:18:38.04,0:18:41.03,Default,,0,0,0,,Себебі Нана, мен тамақ жегім келеді.
Dialogue: 0,0:18:42.04,0:18:43.01,Default,,0,0,0,,Нана?
Dialogue: 0,0:19:00.04,0:19:02.05,Default,,0,0,0,,Кота бұл бетті жасайды.
Dialogue: 0,0:19:08.07,0:19:13.00,Default,,0,0,0,,Өйткені, Ню-чан басынан бері сонда.
Dialogue: 0,0:19:14.00,0:19:15.05,Default,,0,0,0,,Мен ақымақпын.
Dialogue: 0,0:19:22.09,0:19:23.06,Default,,0,0,0,,Құлыптау?
Dialogue: 0,0:19:27.02,0:19:30.04,Default,,0,0,0,,Сол адамдар Кота жараланған кезде келді.
Dialogue: 0,0:19:36.05,0:19:38.00,Default,,0,0,0,,Эносиманы толық блокадалау
Dialogue: 0,0:19:39.03,0:19:41.04,Default,,0,0,0,,Менің жасайтын істерім жылтырақ болып барады.
Dialogue: 0,0:19:42.03,0:19:44.05,Default,,0,0,0,,Биптің қандай түрі?
Dialogue: 0,0:19:58.00,0:19:59.02,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:19:59.08,0:20:03.03,Default,,0,0,0,,PIN кодты әр 30 минут сайын енгізу керек.
Dialogue: 0,0:20:03.07,0:20:05.02,Default,,0,0,0,,Денең желге ұшып кетеді.
Dialogue: 0,0:20:06.00,0:20:07.06,Default,,0,0,0,,Біртүрлі әрекет жасасаңыз
Dialogue: 0,0:20:07.09,0:20:09.02,Default,,0,0,0,,Мен оны бірден жарып жіберемін.
Dialogue: 0,0:20:11.09,0:20:13.02,Default,,0,0,0,,Блокада аяқталды
Dialogue: 0,0:20:13.08,0:20:15.08,Default,,0,0,0,,7 санының қозғалысы туралы не айтасыз?
Dialogue: 0,0:20:16.02,0:20:17.00,Default,,0,0,0,,Міне. . .
Dialogue: 0,0:20:17.01,0:20:19.00,Default,,0,0,0,,Мына жолмен келе жатыр.
Dialogue: 0,0:20:19.02,0:20:22.09,Default,,0,0,0,,Мен сенен қашсам түсінесің бе, ақымақ?
Dialogue: 0,0:20:24.02,0:20:25.04,Default,,0,0,0,,Бұл көңілді болатын сияқты
Dialogue: 0,0:20:28.08,0:20:30.09,Default,,0,0,0,,Маю-чан, сен бірдеңе білесің деп ойлаймын.
Dialogue: 0,0:20:31.08,0:20:33.02,Default,,0,0,0,,Осымен. . .
Dialogue: 0,0:20:35.03,0:20:37.02,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін, бірақ
Dialogue: 0,0:20:37.06,0:20:41.03,Default,,0,0,0,,Бірақ Нана, мені өлтіруге біреу келді.
Dialogue: 0,0:20:41.08,0:20:42.07,Default,,0,0,0,,Өлтіру?
Dialogue: 0,0:20:43.08,0:20:48.08,Default,,0,0,0,,Меніңше, ол бізге қиындық туғызады деп кетіп қалды.
Dialogue: 0,0:20:49.08,0:20:53.08,Default,,0,0,0,,Мен әрқашан өз үйімде бақытты өмір сүргім келетінін айтатынмын.
Dialogue: 0,0:20:58.08,0:21:00.08,Default,,0,0,0,,Маю-чан, үй күтуші сұра
Dialogue: 0,0:21:05.08,0:21:08.09,Default,,0,0,0,,Юкаға қайтып келгенде осында күтуін айт.
Dialogue: 0,0:21:09.05,0:21:12.02,Default,,0,0,0,,Иә, бірақ жақсы ма?
Dialogue: 0,0:21:12.05,0:21:14.04,Default,,0,0,0,,Мұнда тіпті Нана да отбасы.
Dialogue: 0,0:21:14.08,0:21:15.08,Default,,0,0,0,,Мені жалғыз қалдырмаңыз
Dialogue: 0,0:21:16.07,0:21:17.04,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:21:19.02,0:21:20.01,Default,,0,0,0,,Кота
Dialogue: 0,0:21:20.01,0:21:21.04,Default,,0,0,0,,Сіз қаласыз.
Dialogue: 0,0:21:21.04,0:21:22.03,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:21:22.03,0:21:23.00,Default,,0,0,0,,Келме
Dialogue: 0,0:21:23.00,0:21:24.03,Default,,0,0,0,,Барыңыз Куруна
Dialogue: 0,0:21:24.03,0:21:25.01,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:21:30.00,0:21:30.50,Default,,0,0,0,,Кота?
Dialogue: 0,0:21:31.07,0:21:32.09,Default,,0,0,0,,Қош келдің үйге.
Dialogue: 0,0:21:33.06,0:21:34.03,Default,,0,0,0,,Кота ше?
Dialogue: 0,0:21:35.08,0:21:36.07,Default,,0,0,0,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:21:37.03,0:21:38.09,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:21:46.00,0:21:47.04,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:21:48.02,0:21:48.52,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:21:49.00,0:21:50.04,Default,,0,0,0,,Бұйрық бермеу
Dialogue: 0,0:21:50.08,0:21:52.05,Default,,0,0,0,,Мен бұрын жақсылықты қайтаратынмын.
Dialogue: 0,0:21:54.00,0:21:55.02,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:21:58.07,0:22:02.00,Default,,0,0,0,,Елордалық полиция департаментінің арнайы бөлімшесін уақытша арнайы дайындықтан өткізу үшін
Dialogue: 0,0:22:02.00,0:22:04.06,Default,,0,0,0,,Эносима аймағы толығымен жабылған сияқты.
Dialogue: 0,0:22:13.06,0:22:15.06,Default,,0,0,0,,Бұл шынымен де келді
Dialogue: 0,0:22:25.04,0:22:27.01,Default,,0,0,0,,Бұл. . . Ол сондай кішкентай бала
Dialogue: 0,0:22:28.04,0:22:31.08,Default,,0,0,0,,Эй, сен анау апаны өлтіре аласың, солай ма?
Dialogue: 0,0:22:35.04,0:22:38.04,Default,,0,0,0,,Қарауылды жалаң қолмен түсіріп, қолдарың ұшып кетсе
Dialogue: 0,0:22:44.01,0:22:45.06,Default,,0,0,0,,Алыста болса да
Dialogue: 0,0:22:50.08,0:22:53.08,Default,,0,0,0,,Маған бұл ұнамайды. Маған бұл ұнамайды.
Dialogue: 0,0:22:56.00,0:22:57.03,Default,,0,0,0,,Қызықты
Dialogue: 0,0:24:33.05,0:24:37.08,Default,,0,0,0,,Баланың өзі жапқан өткеннің мөрін бұзу ырымы
Dialogue: 0,0:24:38.06,0:24:40.01,Default,,0,0,0,,Қан шашырандыларымен безендірілген
Dialogue: 0,0:24:40.05,0:24:42.05,Default,,0,0,0,,Адамдардың соңғы сәттерінің музыкасын жасау
Dialogue: 0,0:24:42.05,0:24:44.05,Default,,0,0,0,,Бұл тозақ доп болды
Dialogue: 0,0:24:45.02,0:24:46.08,Default,,0,0,0,,Би билеу
Dialogue: 0,0:24:47.01,0:24:49.04,Default,,0,0,0,,Кек, қарғыс, қайғы
Dialogue: 0,0:24:49.08,0:24:53.08,Default,,0,0,0,,Махаббаттарын жасырған оғаш би ханшайымдары
Dialogue: 0,0:24:54.04,0:24:57.01,Default,,0,0,0,,Келесі жолы Эльфен өтірік айтты 12-бөлім
Dialogue: 0,0:24:57.07,0:24:58.07,Default,,0,0,0,,Балшық
Dialogue: 0,0:24:59.57,0:25:04.57,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
