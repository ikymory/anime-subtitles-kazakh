Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:18.01,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.01,0:00:27.02,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.02,0:00:38.05,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.05,0:00:49.01,Default,,0,0,0,,Quoniqm cum probates fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.01,0:01:02.02,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.06,0:01:13.07,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.07,0:01:28.03,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:57.04,0:01:59.04,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:03:14.08,0:03:18.06,Default,,0,0,0,,Кисараги-сан да қиналып жатыр. Chief Kurama's secretary
Dialogue: 0,0:03:19.03,0:03:21.03,Default,,0,0,0,,Не?
Dialogue: 0,0:03:21.03,0:03:23.04,Default,,0,0,0,,Оның көздері де қалыпты емес.
Dialogue: 0,0:03:23.08,0:03:25.01,Default,,0,0,0,,Жотаро, бұл сенің Стар Платинум.
Dialogue: 0,0:03:25.07,0:03:28.06,Default,,0,0,0,,Иә, сен мейірімді адамсың.
Dialogue: 0,0:03:29.03,0:03:32.06,Default,,0,0,0,,Бірақ мен көп көмектесе алмаймын.
Dialogue: 0,0:03:33.00,0:03:34.09,Default,,0,0,0,,Әрқашан сәтсіздікке ұшырайды
Dialogue: 0,0:03:36.00,0:03:38.07,Default,,0,0,0,,Бірақ Кисараги барын салып жатыр.
Dialogue: 0,0:03:39.04,0:03:41.05,Default,,0,0,0,,Төтенше жағдай дабылы берілді.
Dialogue: 0,0:03:41.06,0:03:44.08,Default,,0,0,0,,Close underground research block after 60 seconds
Dialogue: 0,0:03:45.01,0:03:47.00,Default,,0,0,0,,Қызметкерлер, дереу эвакуациялаңыз.
Dialogue: 0,0:03:47.04,0:03:48.02,Default,,0,0,0,,Repetition
Dialogue: 0,0:03:48.07,0:03:50.06,Default,,0,0,0,,Төтенше жағдай дабылы берілді.
Dialogue: 0,0:03:51.00,0:03:53.06,Default,,0,0,0,,Close underground research block after 60 seconds
Dialogue: 0,0:03:54.02,0:03:55.06,Default,,0,0,0,,Қызметкерлер дереу эвакуациялансын. . .
Dialogue: 0,0:04:02.08,0:04:03.07,Default,,0,0,0,,Дүрбелең емес!
Dialogue: 0,0:04:04.00,0:04:07.04,Default,,0,0,0,,Нұсқаулықта 2 метрден артық жерде тұрсаңыз, қауіп жоқ деп жазылған.
Dialogue: 0,0:04:08.02,0:04:10.08,Default,,0,0,0,,Сонымен қатар заттарды еденге түсірмеңіз.
Dialogue: 0,0:06:37.07,0:06:38.06,Default,,0,0,0,,Kisaragi
Dialogue: 0,0:06:39.00,0:06:40.00,Default,,0,0,0,,Chief Kurama
Dialogue: 0,0:06:40.02,0:06:42.04,Default,,0,0,0,,Excuse me again. .
Dialogue: 0,0:06:42.04,0:06:43.04,Default,,0,0,0,,Кисарагиден қашыңыз
Dialogue: 0,0:06:43.07,0:06:45.02,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:45.02,0:06:46.01,Default,,0,0,0,,Кенеттен татами төсегі жарылып кетті.
Dialogue: 0,0:06:46.02,0:06:47.00,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:06:50.01,0:06:51.08,Default,,0,0,0,,Stop it, Lucy.
Dialogue: 0,0:06:57.02,0:06:58.05,Default,,0,0,0,,Shoot to death
Dialogue: 0,0:07:18.06,0:07:19.08,Default,,0,0,0,,Ату және ату
Dialogue: 0,0:07:19.08,0:07:20.08,Default,,0,0,0,,It's a bullet
Dialogue: 0,0:07:23.09,0:07:25.00,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:07:25.02,0:07:25.52,Default,,0,0,0,,Барма!
Dialogue: 0,0:07:41.09,0:07:43.00,Default,,0,0,0,,Апаттық шығуға бет алды
Dialogue: 0,0:07:43.03,0:07:45.06,Default,,0,0,0,,Қақпаны түсіріп, оны ішке бекітіңіз.
Dialogue: 0,0:08:08.09,0:08:10.05,Default,,0,0,0,,Сыртқы қалқа ашылды ма?
Dialogue: 0,0:08:11.00,0:08:11.50,Default,,0,0,0,,Don't be stupid
Dialogue: 0,0:08:12.08,0:08:15.00,Default,,0,0,0,,Бұл жақсы сылтау. Bring on the sniper.
Dialogue: 0,0:08:19.08,0:08:20.08,Default,,0,0,0,,Бір оқпен өлтіру
Dialogue: 0,0:08:21.05,0:08:23.07,Default,,0,0,0,,Ол сені екінші оқпен ұратын адам емес.
Dialogue: 0,0:08:24.02,0:08:26.07,Default,,0,0,0,,50 Банкай танкіге қарсы винтовка
Dialogue: 0,0:08:27.02,0:08:30.05,Default,,0,0,0,,Тіпті оның «қолдары» да бұл жігітті жұлқылай алмайды.
Dialogue: 0,0:08:30.08,0:08:31.07,Default,,0,0,0,,Бұл бастың артқы жағы.
Dialogue: 0,0:08:32.02,0:08:32.52,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:46.07,0:08:48.09,Default,,0,0,0,,Жоқ. Әлі біткен жоқ.
Dialogue: 0,0:09:53.09,0:09:56.07,Default,,0,0,0,,Кота-кун. . . Дұрыс па?
Dialogue: 0,0:09:58.05,0:10:00.04,Default,,0,0,0,,Иә, иә?
Dialogue: 0,0:10:01.03,0:10:02.03,Default,,0,0,0,,Бұл Юка
Dialogue: 0,0:10:03.00,0:10:04.00,Default,,0,0,0,,Кузендікі. . .
Dialogue: 0,0:10:05.01,0:10:05.51,Default,,0,0,0,,Юка-чан
Dialogue: 0,0:10:08.00,0:10:08.50,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:10:09.07,0:10:12.01,Default,,0,0,0,,Бұл вокзалда емес еді, мен оны іздедім.
Dialogue: 0,0:10:12.07,0:10:13.08,Default,,0,0,0,,Өтінемін. . Кешіріңіз
Dialogue: 0,0:10:19.05,0:10:21.06,Default,,0,0,0,,Бірақ ол осында.
Dialogue: 0,0:10:22.02,0:10:24.09,Default,,0,0,0,,Кота: Сізге осы жерден теңіз қарау ұнады ма?
Dialogue: 0,0:10:25.05,0:10:26.06,Default,,0,0,0,,Есіңізде болсын
Dialogue: 0,0:10:28.00,0:10:30.07,Default,,0,0,0,,Бала кезімнен мүлде өзгерген жоқ.
Dialogue: 0,0:10:32.00,0:10:34.03,Default,,0,0,0,,Бір жерде университет болады деп ойламаппын.
Dialogue: 0,0:10:35.04,0:10:37.03,Default,,0,0,0,,Теңізді көруге уақыт бөлейік.
Dialogue: 0,0:10:38.06,0:10:39.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:39.06,0:10:41.08,Default,,0,0,0,,Жарайды, уақытыңызды жақсы өткіздіңіз.
Dialogue: 0,0:10:51.05,0:10:53.04,Default,,0,0,0,,Сіз мұнда көп ойнадыңыз, солай емес пе?
Dialogue: 0,0:10:55.00,0:10:57.02,Default,,0,0,0,,Соңғы күні де Кана екеуміз
Dialogue: 0,0:11:00.04,0:11:01.05,Default,,0,0,0,,Канэ-чан
Dialogue: 0,0:11:02.03,0:11:06.04,Default,,0,0,0,,Ол мұнда снарядтарды жинап жатыр.
Dialogue: 0,0:11:16.08,0:11:18.09,Default,,0,0,0,,Онии-чан
Dialogue: 0,0:11:19.03,0:11:22.04,Default,,0,0,0,,Мен бір топ снарядтарды алдым, қара!
Dialogue: 0,0:11:22.08,0:11:24.04,Default,,0,0,0,,Бұл өте әдемі емес.
Dialogue: 0,0:11:33.06,0:11:34.01,Default,,0,0,0,,Кота
Dialogue: 0,0:11:34.02,0:11:34.52,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:11:35.02,0:11:36.05,Default,,0,0,0,,Екінші жаққа қараған
Dialogue: 0,0:11:40.09,0:11:41.09,Default,,0,0,0,,. . . Бұл не?
Dialogue: 0,0:11:41.09,0:11:43.06,Default,,0,0,0,,Сіз түсінуге мүмкіндік жоқ.
Dialogue: 0,0:12:03.00,0:12:03.50,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:12:07.06,0:12:08.06,Default,,0,0,0,,Жақсы. .
Dialogue: 0,0:12:21.01,0:12:23.00,Default,,0,0,0,,Кота Әзірше киіміңді шеш.
Dialogue: 0,0:12:23.08,0:12:25.03,Default,,0,0,0,,Жарайды, шешіңіз.
Dialogue: 0,0:12:29.04,0:12:32.01,Default,,0,0,0,,Тілді түсінбейтін сияқтымын.
Dialogue: 0,0:12:32.05,0:12:33.06,Default,,0,0,0,,Әй, қарашы
Dialogue: 0,0:12:34.01,0:12:34.51,Default,,0,0,0,,Ауыр жарақат
Dialogue: 0,0:12:39.06,0:12:42.03,Default,,0,0,0,,Сол шаш әшекейі Шиноны көргім келеді.
Dialogue: 0,0:12:43.06,0:12:45.04,Default,,0,0,0,,Өтірік Ол тікелей өседі
Dialogue: 0,0:12:52.06,0:12:53.06,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:12:54.02,0:12:55.03,Default,,0,0,0,,Кота
Dialogue: 0,0:12:56.00,0:12:57.00,Default,,0,0,0,,Кота
Dialogue: 0,0:12:57.04,0:12:58.09,Default,,0,0,0,,Эй, мен Коутамын.
Dialogue: 0,0:13:00.05,0:13:01.09,Default,,0,0,0,,Не?
Dialogue: 0,0:13:02.06,0:13:05.04,Default,,0,0,0,,Екеуміз жинала алмасақ, Коутаны қайда апару керектігін айтамын.
Dialogue: 0,0:13:05.09,0:13:07.01,Default,,0,0,0,,Мен қайдамын?
Dialogue: 0,0:13:07.02,0:13:08.05,Default,,0,0,0,,Where to live from now on
Dialogue: 0,0:13:09.00,0:13:10.09,Default,,0,0,0,,Өйткені ол осылай қала берсе
Dialogue: 0,0:13:14.05,0:13:17.06,Default,,0,0,0,,It's okay, don't worry.
Dialogue: 0,0:13:47.04,0:13:48.02,Default,,0,0,0,,Жаңа
Dialogue: 0,0:13:48.08,0:13:50.04,Default,,0,0,0,,In a house that is rented to you. . .
Dialogue: 0,0:13:50.08,0:13:51.04,Default,,0,0,0,,Бұл?
Dialogue: 0,0:13:51.07,0:13:52.09,Default,,0,0,0,,Бұл мейрамхана болды.
Dialogue: 0,0:13:53.02,0:13:55.00,Default,,0,0,0,,We're not open at the moment.
Dialogue: 0,0:13:55.07,0:13:58.09,Default,,0,0,0,,Анаң күнде үй жинаса, жарайды.
Dialogue: 0,0:13:59.04,0:14:00.00,Default,,0,0,0,,Осымен
Dialogue: 0,0:14:00.04,0:14:01.00,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:14:01.02,0:14:03.02,Default,,0,0,0,,Мен мұнда қанша бөлме бар деп ойлаймын.
Dialogue: 0,0:14:03.08,0:14:06.07,Default,,0,0,0,,I think it was 10 rooms.
Dialogue: 0,0:14:07.00,0:14:09.08,Default,,0,0,0,,Бәрін өзім тазалаймын.
Dialogue: 0,0:14:10.00,0:14:10.50,Default,,0,0,0,,Бақша да
Dialogue: 0,0:14:11.01,0:14:14.05,Default,,0,0,0,,Қысқасы, маған бос тұрған үйді басқару тағайындалды.
Dialogue: 0,0:14:16.04,0:14:17.01,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:17.07,0:14:21.04,Default,,0,0,0,,Олар: «Егер оларда ешкім тұрмаса, ғимараттар тез бұзылады» дейді.
Dialogue: 0,0:14:22.09,0:14:23.06,Default,,0,0,0,,Жаңа
Dialogue: 0,0:14:27.09,0:14:29.02,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:14:33.01,0:14:36.01,Default,,0,0,0,,Уау, бұл антиквариат.
Dialogue: 0,0:14:36.09,0:14:40.00,Default,,0,0,0,,Бұралсам да қозғалмайды, сынып қалады.
Dialogue: 0,0:14:40.06,0:14:41.02,Default,,0,0,0,,Не?
Dialogue: 0,0:14:44.03,0:14:46.05,Default,,0,0,0,,Коюю Мен сізбен келісе алмаймын, сондықтан мынаны пайдаланыңыз
Dialogue: 0,0:14:46.06,0:14:47.01,Default,,0,0,0,,Иә
Dialogue: 0,0:14:49.01,0:14:49.51,Default,,0,0,0,,Жаңа
Dialogue: 0,0:14:50.04,0:14:50.54,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:14:51.03,0:14:52.07,Default,,0,0,0,,Жаңа
Dialogue: 0,0:14:53.05,0:14:56.02,Default,,0,0,0,,Әй, мм.
Dialogue: 0,0:14:56.09,0:14:58.01,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:14:58.02,0:15:00.03,Default,,0,0,0,,Сіз атын да білмейсіз
Dialogue: 0,0:15:00.05,0:15:02.02,Default,,0,0,0,,Мен шошып кеттім де, «Нюу нюу» деймін.
Dialogue: 0,0:15:02.04,0:15:03.03,Default,,0,0,0,,Жаңа жеткіліксіз
Dialogue: 0,0:15:03.09,0:15:04.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:06.02,0:15:07.04,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:15:07.04,0:15:08.08,Default,,0,0,0,,Қараңдаршы, мен бақыттымын.
Dialogue: 0,0:15:09.05,0:15:10.08,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:15:12.00,0:15:12.50,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:21.04,0:15:22.07,Default,,0,0,0,,Жақсы емес, солай ма?
Dialogue: 0,0:15:23.00,0:15:24.08,Default,,0,0,0,,Сен бұлай қай жерге сидидің?
Dialogue: 0,0:15:24.09,0:15:25.06,Default,,0,0,0,,Жаңа
Dialogue: 0,0:15:30.01,0:15:31.08,Default,,0,0,0,,Сізді жалғыз жібергенім үшін кешіріңіз.
Dialogue: 0,0:15:33.02,0:15:35.08,Default,,0,0,0,,Маған шалбарымның ешқайсысын кигізбе
Dialogue: 0,0:15:36.02,0:15:38.01,Default,,0,0,0,,Өйткені менің ауыстыратын басқа киімім жоқ.
Dialogue: 0,0:15:38.07,0:15:40.00,Default,,0,0,0,,Мен оны кейінірек сатып аламын.
Dialogue: 0,0:15:41.00,0:15:42.04,Default,,0,0,0,,Мен қайда жеуім керек?
Dialogue: 0,0:15:43.03,0:15:44.07,Default,,0,0,0,,Мен саған күріш шарын әкелдім.
Dialogue: 0,0:15:52.04,0:15:53.07,Default,,0,0,0,,Сіз де ше?
Dialogue: 0,0:15:53.08,0:15:54.04,Default,,0,0,0,,Жаңа~
Dialogue: 0,0:15:59.08,0:16:03.05,Default,,0,0,0,,Эй, сен мына баламен қайда жүрсің?
Dialogue: 0,0:16:04.00,0:16:04.50,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:16:10.02,0:16:12.00,Default,,0,0,0,,Күріш жеген бала бар ма?
Dialogue: 0,0:16:13.08,0:16:15.02,Default,,0,0,0,,Оны осылай ұстаңыз
Dialogue: 0,0:16:22.01,0:16:23.03,Default,,0,0,0,,Мен бұған көмектесе алмаймын.
Dialogue: 0,0:16:28.08,0:16:30.06,Default,,0,0,0,,Жүріңдер, мен барлығын толқытамын.
Dialogue: 0,0:16:49.08,0:16:52.00,Default,,0,0,0,,Гуичидзи бес қабатты құлыптың қалқаны
Dialogue: 0,0:16:52.04,0:16:54.08,Default,,0,0,0,,Қауіпсіздік жүйесі де тамаша болды.
Dialogue: 0,0:16:55.06,0:16:59.03,Default,,0,0,0,,Өздігінен ашылған апаттық розетканың жапқышы әлі де себеп болып табылады. . .
Dialogue: 0,0:16:59.04,0:17:04.00,Default,,0,0,0,,Дәл қазір менің басты басымдығым себебін табу емес, Люсиді жою.
Dialogue: 0,0:17:04.00,0:17:06.00,Default,,0,0,0,,Өшіру? Түсіргеннен гөрі?
Dialogue: 0,0:17:07.00,0:17:09.08,Default,,0,0,0,,SAT арнайы шабуыл күштерін қолданыңыз
Dialogue: 0,0:17:11.06,0:17:13.04,Default,,0,0,0,,Люсиді миға жіберіңіз
Dialogue: 0,0:17:14.01,0:17:15.04,Default,,0,0,0,,Адамзат жойылады
Dialogue: 0,0:17:25.08,0:17:26.05,Default,,0,0,0,,Мені тезірек үйге жіберші.
Dialogue: 0,0:17:26.09,0:17:29.01,Default,,0,0,0,,Барлық нысандарды бір уақытта құлыптау
Dialogue: 0,0:17:30.02,0:17:33.01,Default,,0,0,0,,Оны жалғыз жеңетін нәрсе болса, бұл құбыжық.
Dialogue: 0,0:17:34.01,0:17:34.51,Default,,0,0,0,,Құбыжық. . .
Dialogue: 0,0:17:38.03,0:17:41.04,Default,,0,0,0,,Бұл адамдарды біршама мақсатты етеді.
Dialogue: 0,0:17:55.00,0:17:56.09,Default,,0,0,0,,Бандо: Сіз байсалдысыз ба?
Dialogue: 0,0:17:58.09,0:18:02.03,Default,,0,0,0,,Айқайлап, қансырап тұрған нәрсені атудың не керегі бар?
Dialogue: 0,0:18:02.08,0:18:03.07,Default,,0,0,0,,Ахокус!
Dialogue: 0,0:18:03.08,0:18:05.05,Default,,0,0,0,,Біреу біреуді атсын.
Dialogue: 0,0:18:05.07,0:18:06.07,Default,,0,0,0,,Кисама
Dialogue: 0,0:18:07.03,0:18:08.01,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:11.06,0:18:14.01,Default,,0,0,0,,Ahokuse Сіз мұны істей аласыз ба?
Dialogue: 0,0:18:16.00,0:18:19.02,Default,,0,0,0,,Бүгін таңертең кісі өлтіруші лагерьден қашып кетті.
Dialogue: 0,0:18:21.04,0:18:23.02,Default,,0,0,0,,Оны мүмкіндігінше тезірек табыңыз
Dialogue: 0,0:18:24.00,0:18:24.50,Default,,0,0,0,,Мені атып өлтіруіңді қалаймын.
Dialogue: 0,0:18:25.04,0:18:26.02,Default,,0,0,0,,Түсіру?
Dialogue: 0,0:18:27.00,0:18:28.07,Default,,0,0,0,,Біреуді кенеттен атып өлтіруге бола ма?
Dialogue: 0,0:18:40.08,0:18:42.03,Default,,0,0,0,,Ату керек пе?
Dialogue: 0,0:18:42.07,0:18:43.03,Default,,0,0,0,,Бандо мырза
Dialogue: 0,0:18:48.06,0:18:50.06,Default,,0,0,0,,Менің артымда тұрма
Dialogue: 0,0:18:50.09,0:18:51.07,Default,,0,0,0,,Ақымақ әйел
Dialogue: 0,0:18:58.08,0:18:59.08,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:19:09.00,0:19:10.06,Default,,0,0,0,,Мен айтқандай тазалаңыз.
Dialogue: 0,0:19:10.06,0:19:11.04,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:12.04,0:19:14.00,Default,,0,0,0,,Арнайы қызмет бүгін ғана
Dialogue: 0,0:19:14.03,0:19:16.00,Default,,0,0,0,,Ертеңнен бастап
Dialogue: 0,0:19:16.02,0:19:17.06,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:19:18.00,0:19:18.50,Default,,0,0,0,,Жаңа
Dialogue: 0,0:19:21.01,0:19:21.51,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:19:22.00,0:19:23.08,Default,,0,0,0,,Осында қойсам да
Dialogue: 0,0:19:24.05,0:19:26.08,Default,,0,0,0,,Менің ойымша, полицияға хабарласуым керек.
Dialogue: 0,0:19:27.02,0:19:27.52,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:19:29.06,0:19:30.07,Default,,0,0,0,,Ой. . .
Dialogue: 0,0:19:32.05,0:19:34.08,Default,,0,0,0,,Мүмкін. . .
Dialogue: 0,0:19:35.09,0:19:36.08,Default,,0,0,0,,At that time
Dialogue: 0,0:19:40.00,0:19:41.02,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:19:44.08,0:19:45.06,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:19:46.00,0:19:47.09,Default,,0,0,0,,Мен мұны тапқаныма қуаныштымын.
Dialogue: 0,0:19:50.06,0:19:51.05,Default,,0,0,0,,Сонымен. .
Dialogue: 0,0:19:55.07,0:19:58.08,Default,,0,0,0,,Менің қолымнан келмейді, мен ағама барамын.
Dialogue: 0,0:20:01.02,0:20:02.05,Default,,0,0,0,,Осыдан кейін бірден. . .
Dialogue: 0,0:20:03.08,0:20:05.04,Default,,0,0,0,,Өйткені мен аурудан қайтыс болдым.
Dialogue: 0,0:20:07.02,0:20:07.52,Default,,0,0,0,,Ауру?
Dialogue: 0,0:20:09.00,0:20:10.04,Default,,0,0,0,,Ауру дегеніміз не?
Dialogue: 0,0:20:10.07,0:20:12.03,Default,,0,0,0,,Бұл естелік сияқты.
Dialogue: 0,0:20:13.00,0:20:14.08,Default,,0,0,0,,Мен мұнда келу үшін қиындық көрдім.
Dialogue: 0,0:20:15.08,0:20:17.01,Default,,0,0,0,,Бірге ойланайық
Dialogue: 0,0:20:18.03,0:20:18.53,Default,,0,0,0,,Кота
Dialogue: 0,0:20:22.01,0:20:22.51,Default,,0,0,0,,Не?
Dialogue: 0,0:20:33.01,0:20:33.51,Default,,0,0,0,,Кота
Dialogue: 0,0:20:34.00,0:20:35.02,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:35.03,0:20:37.01,Default,,0,0,0,,Әпкеңе естелік ретінде айттың.
Dialogue: 0,0:20:37.03,0:20:38.02,Default,,0,0,0,,Коута №
Dialogue: 0,0:20:38.02,0:20:39.00,Default,,0,0,0,,Ой жоқ.
Dialogue: 0,0:20:39.00,0:20:40.04,Default,,0,0,0,,Коута № Тек мазасыздану жеткіліксіз
Dialogue: 0,0:20:40.04,0:20:41.04,Default,,0,0,0,,Кота, тоқтат.
Dialogue: 0,0:20:41.05,0:20:42.07,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:20:42.08,0:20:43.08,Default,,0,0,0,,Мен Ню-чанға сенімдімін. . .
Dialogue: 0,0:20:43.09,0:20:45.06,Default,,0,0,0,,Балалар, шығыңдар!
Dialogue: 0,0:20:45.07,0:20:46.07,Default,,0,0,0,,Сәлем Коута
Dialogue: 0,0:20:46.08,0:20:47.05,Default,,0,0,0,,Шығыңыз.
Dialogue: 0,0:20:47.06,0:20:48.07,Default,,0,0,0,,Жоқ дейсіз бе?
Dialogue: 0,0:20:48.08,0:20:49.03,Default,,0,0,0,,Сыртқа шығып, мені тепкіле, солай ма?
Dialogue: 0,0:20:49.07,0:20:50.06,Default,,0,0,0,,Сабыр етіңіз.
Dialogue: 0,0:20:50.09,0:20:51.00,Default,,0,0,0,,Тітіркендірмеңіз
Dialogue: 0,0:20:51.07,0:20:52.02,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:20:52.03,0:20:53.07,Default,,0,0,0,,Кота
Dialogue: 0,0:21:17.02,0:21:19.00,Default,,0,0,0,,Ол не ойлады?
Dialogue: 0,0:21:20.02,0:21:21.01,Default,,0,0,0,,Әрине. . .
Dialogue: 0,0:21:23.09,0:21:24.08,Default,,0,0,0,,Кота
Dialogue: 0,0:21:26.04,0:21:28.05,Default,,0,0,0,,Себебі сен мұңды көрінесің.
Dialogue: 0,0:21:29.08,0:21:33.05,Default,,0,0,0,,Менің ойымша, бұл қабық жаман адамдарды көргісі келеді.
Dialogue: 0,0:21:36.00,0:21:39.08,Default,,0,0,0,,Кота Канэ-чанды ойлаған сайын мұңайып кетсе
Dialogue: 0,0:21:41.00,0:21:43.06,Default,,0,0,0,,Кана-чан да мұңая ма деп ойлаймын.
Dialogue: 0,0:21:49.04,0:21:51.00,Default,,0,0,0,,Мен оны іздеймін.
Dialogue: 0,0:21:51.03,0:21:53.04,Default,,0,0,0,,Сыртта қараңғы, қатты жаңбыр жауып тұр.
Dialogue: 0,0:22:02.04,0:22:03.09,Default,,0,0,0,,Көп ұзамай Камакураның үстінде
Dialogue: 0,0:22:04.08,0:22:08.08,Default,,0,0,0,,Егер бұл елде кәмелетке толмағандарды атып өлтіру туралы нұсқау берілсе, онда...
Dialogue: 0,0:22:11.01,0:22:12.07,Default,,0,0,0,,Әлем жақсырақ жерге айналды.
Dialogue: 0,0:22:12.08,0:22:13.09,Default,,0,0,0,,Аузыңызды жабыңыз
Dialogue: 0,0:22:14.00,0:22:15.07,Default,,0,0,0,,Кисама, сенің міндетің қандай?
Dialogue: 0,0:22:17.06,0:22:18.02,Default,,0,0,0,,Ямаро
Dialogue: 0,0:22:18.02,0:22:19.02,Default,,0,0,0,,Сіз не ойладыңыз?
Dialogue: 0,0:22:19.02,0:22:22.07,Default,,0,0,0,,Ямаро Біз күнде қандай жаттығу жасаймыз?
Dialogue: 0,0:22:24.05,0:22:25.06,Default,,0,0,0,,Әйтеуір, адамның өмірінің соңы—
Dialogue: 0,0:22:26.09,0:22:27.06,Default,,0,0,0,,Талап етілмеген елу миллиардты қайтарып алу үшін.
Dialogue: 0,0:22:32.03,0:22:33.06,Default,,0,0,0,,Сіз бөлісесіз бе?
Dialogue: 0,0:22:37.01,0:22:40.06,Default,,0,0,0,,Көңілді болыңыз, бірақ сақтықты төмендетпеңіз.
Dialogue: 0,0:22:45.00,0:22:49.03,Default,,0,0,0,,Мақсат – бар болғаны 5 минутта 23 адамды өлтірген қаскөй.
Dialogue: 0,0:24:34.05,0:24:37.00,Default,,0,0,0,,Аңшылық, аңшылық.
Dialogue: 0,0:24:39.01,0:24:41.08,Default,,0,0,0,,Тұрақты сан кері және кері.
Dialogue: 0,0:24:43.09,0:24:45.04,Default,,0,0,0,,Оны айнымас серпінге айналдыр
Dialogue: 0,0:24:45.06,0:24:47.02,Default,,0,0,0,,Таза нәзік мінез-құлық
Dialogue: 0,0:24:49.03,0:24:51.00,Default,,0,0,0,,Өйткені бұл таза нәзіктік. . .
Dialogue: 0,0:24:51.03,0:24:52.02,Default,,0,0,0,,Ләззат
Dialogue: 0,0:24:55.01,0:24:57.03,Default,,0,0,0,,Келесі жолы Эльфен өтірік айтты «2-эпизод»
Dialogue: 0,0:24:57.07,0:24:58.08,Default,,0,0,0,,Сыпыру
Dialogue: 0,0:24:59.58,0:25:04.58,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
