Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:18.01,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.01,0:00:27.02,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.02,0:00:38.05,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.05,0:00:49.01,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.01,0:01:02.02,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.06,0:01:13.07,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.07,0:01:28.03,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:48.06,0:01:49.04,Default,,0,0,0,,Қауіпке барма.
Dialogue: 0,0:01:50.01,0:01:51.03,Default,,0,0,0,,Оны тез тоқтатыңыз
Dialogue: 0,0:01:51.09,0:01:52.08,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:53.00,0:01:55.07,Default,,0,0,0,,Менің ойымша, бұл апа сізді өлтіретін жалғыз адам.
Dialogue: 0,0:01:56.04,0:01:57.08,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:01:58.00,0:02:01.04,Default,,0,0,0,,Егер солай болса, мен оны бірден өлтірсем, босқа кетеді.
Dialogue: 0,0:02:14.03,0:02:15.08,Default,,0,0,0,,Ах, менің аяғым. .
Dialogue: 0,0:02:16.03,0:02:19.06,Default,,0,0,0,,Маған ұнамайды. Маған енді ауырсыну ұнамайды.
Dialogue: 0,0:02:26.02,0:02:29.00,Default,,0,0,0,,Ол енді жұмыс істемейді.
Dialogue: 0,0:02:29.08,0:02:31.04,Default,,0,0,0,,Сіз тек бір адамды өлтіре аласыз
Dialogue: 0,0:02:31.09,0:02:32.06,Default,,0,0,0,,Жалықтырғыш
Dialogue: 0,0:02:38.06,0:02:39.09,Default,,0,0,0,,Бұл баланың ойыны
Dialogue: 0,0:02:40.08,0:02:42.07,Default,,0,0,0,,Бұл жәндіктің қанатын ұстаумен бірдей.
Dialogue: 0,0:02:53.00,0:02:55.05,Default,,0,0,0,,Әй, әпке.
Dialogue: 0,0:02:55.09,0:02:57.02,Default,,0,0,0,,Бәрі бітті ме?
Dialogue: 0,0:02:58.03,0:02:59.09,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:03:17.07,0:03:19.03,Default,,0,0,0,,. . . Бұл не?
Dialogue: 0,0:03:43.06,0:03:46.04,Default,,0,0,0,,№ 35 Тоқта!
Dialogue: 0,0:03:49.07,0:03:50.08,Default,,0,0,0,,Жетеді
Dialogue: 0,0:03:51.02,0:03:52.04,Default,,0,0,0,,Мен жалықтым
Dialogue: 0,0:03:59.06,0:04:00.02,Default,,0,0,0,,Нана
Dialogue: 0,0:04:02.07,0:04:03.02,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:04:04.00,0:04:05.02,Default,,0,0,0,,Сіз жасырын түрде қайда кірдіңіз?
Dialogue: 0,0:04:05.08,0:04:07.03,Default,,0,0,0,,Қауіпсіздік тобы не істейді?
Dialogue: 0,0:04:10.01,0:04:11.09,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:04:12.08,0:04:14.01,Default,,0,0,0,,Сол бір бөтелкеге ​​не болды?
Dialogue: 0,0:04:14.09,0:04:16.08,Default,,0,0,0,,Неге келдің?
Dialogue: 0,0:04:17.08,0:04:19.04,Default,,0,0,0,,Ол 7 санымен таныс сияқты.
Dialogue: 0,0:04:19.07,0:04:22.09,Default,,0,0,0,,Әй, сен де анау ағаны өлтіргің келе ме?
Dialogue: 0,0:04:22.09,0:04:27.04,Default,,0,0,0,,Күте тұрыңыз, менің ойымша, мән-жайды сұрау керек.
Dialogue: 0,0:04:31.05,0:04:33.02,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:37.00,0:04:39.00,Default,,0,0,0,,Бұл адамға тиіспеңіз
Dialogue: 0,0:04:39.02,0:04:40.08,Default,,0,0,0,,Нана, сен ше?
Dialogue: 0,0:04:41.04,0:04:46.00,Default,,0,0,0,,Әй, анау аға сенің апаңның досы ғой.
Dialogue: 0,0:04:46.05,0:04:48.02,Default,,0,0,0,,Әй, тез қаш.
Dialogue: 0,0:04:48.02,0:04:49.08,Default,,0,0,0,,Сізді өлтіреді
Dialogue: 0,0:04:50.06,0:04:51.02,Default,,0,0,0,,Өлтірілді ме?
Dialogue: 0,0:04:51.08,0:04:52.08,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:04:52.08,0:04:53.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:53.09,0:04:56.05,Default,,0,0,0,,Камакура жағындағы барлық қауіпсіздік тобы құлап кеткен сияқты.
Dialogue: 0,0:04:57.01,0:04:58.04,Default,,0,0,0,,Қарапайым халық та жинап жатыр
Dialogue: 0,0:04:59.00,0:04:59.50,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:05:00.05,0:05:02.06,Default,,0,0,0,,Егер тұрақты емес жағдай әлі жалғаса берсе,
Dialogue: 0,0:05:05.01,0:05:05.51,Default,,0,0,0,,Ширакава
Dialogue: 0,0:05:06.02,0:05:07.06,Default,,0,0,0,,Мен ол қызбен сөйлесемін.
Dialogue: 0,0:05:08.01,0:05:09.05,Default,,0,0,0,,Өзіңізге еліктемеңіз
Dialogue: 0,0:05:09.08,0:05:12.00,Default,,0,0,0,,Біздің міндетіміз жеті санын жою.
Dialogue: 0,0:05:12.02,0:05:15.05,Default,,0,0,0,,Қарапайым адамдар мен Диклониус байланысады.
Dialogue: 0,0:05:16.00,0:05:17.04,Default,,0,0,0,,Өлтірмей істеудің жолы болуы керек.
Dialogue: 0,0:05:17.08,0:05:19.06,Default,,0,0,0,,Мицугу Ширакава
Dialogue: 0,0:05:20.04,0:05:22.04,Default,,0,0,0,,№ 35 № 7 өлтіру
Dialogue: 0,0:05:23.00,0:05:24.06,Default,,0,0,0,,Иә Тоқта
Dialogue: 0,0:05:31.00,0:05:31.50,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:05:45.02,0:05:46.03,Default,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:05:46.07,0:05:49.05,Default,,0,0,0,,Мен сияқты болсаң да, сенің достарың бар екеніне сене алмаймын.
Dialogue: 0,0:06:06.04,0:06:07.03,Default,,0,0,0,,Нана
Dialogue: 0,0:06:07.05,0:06:08.08,Default,,0,0,0,,Кота
Dialogue: 0,0:06:11.01,0:06:12.06,Default,,0,0,0,,7 саны теңізге құлады
Dialogue: 0,0:06:13.00,0:06:14.06,Default,,0,0,0,,Теңізді дереу іздеңіз.
Dialogue: 0,0:06:14.08,0:06:16.02,Default,,0,0,0,,Кота
Dialogue: 0,0:06:16.06,0:06:21.06,Default,,0,0,0,,Жақсы. . Люси болмайды
Dialogue: 0,0:06:29.03,0:06:30.08,Default,,0,0,0,,Нюу Жақсысың ба?
Dialogue: 0,0:06:31.00,0:06:32.03,Default,,0,0,0,,Сіз бара алмайсыз.
Dialogue: 0,0:06:32.05,0:06:34.05,Default,,0,0,0,,Сіз не істейсіз? Жіберу.
Dialogue: 0,0:06:34.05,0:06:36.05,Default,,0,0,0,,Жоқ, сені өлтіреді.
Dialogue: 0,0:06:36.07,0:06:38.07,Default,,0,0,0,,Сіз не айтып едіңіз? Жіберу.
Dialogue: 0,0:06:38.07,0:06:40.02,Default,,0,0,0,,Нюу Нюу
Dialogue: 0,0:06:40.04,0:06:41.06,Default,,0,0,0,,Кота
Dialogue: 0,0:06:42.02,0:06:44.07,Default,,0,0,0,,Сіз не істеп жатырсыз? 35. Тезірек Люсиді алыңыз.
Dialogue: 0,0:06:45.01,0:06:45.51,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:46.00,0:06:48.02,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр Бұл Люси емес
Dialogue: 0,0:06:48.02,0:06:50.02,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Асықшы.
Dialogue: 0,0:06:50.02,0:06:51.02,Default,,0,0,0,,Сіз қашып кете аласыз.
Dialogue: 0,0:06:51.02,0:06:53.04,Default,,0,0,0,,Ширакава Бұл туралы уайымдамаңыз.
Dialogue: 0,0:06:53.04,0:06:54.01,Default,,0,0,0,,Кота
Dialogue: 0,0:06:56.01,0:06:57.06,Default,,0,0,0,,Ах. . . сен
Dialogue: 0,0:07:01.02,0:07:04.04,Default,,0,0,0,,Ол шықпайды. Менің қолым шықпайды.
Dialogue: 0,0:07:04.04,0:07:05.02,Default,,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 0,0:07:06.04,0:07:07.08,Default,,0,0,0,,35 санын жинаңыз
Dialogue: 0,0:07:08.04,0:07:09.00,Default,,0,0,0,,Га
Dialogue: 0,0:07:09.05,0:07:11.01,Default,,0,0,0,,Ұстамдылық туралы ұмытпаңыз
Dialogue: 0,0:07:12.08,0:07:13.07,Default,,0,0,0,,Не. . Ол нені білдіреді?
Dialogue: 0,0:07:14.00,0:07:15.00,Default,,0,0,0,,Жаңа, қаш.
Dialogue: 0,0:07:15.07,0:07:16.04,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:07:16.04,0:07:19.04,Default,,0,0,0,,Шықпайды Шықпайды
Dialogue: 0,0:07:19.08,0:07:21.05,Default,,0,0,0,,Төтенше жағдайда
Dialogue: 0,0:07:22.06,0:07:23.08,Default,,0,0,0,,Люсидің қашып кетуіне жол берме
Dialogue: 0,0:07:24.05,0:07:27.02,Default,,0,0,0,,Күте тұрыңыз, Люси қазір Люси болды.
Dialogue: 0,0:07:27.02,0:07:27.52,Default,,0,0,0,,Түсіру
Dialogue: 0,0:07:31.07,0:07:32.09,Default,,0,0,0,,Тоқта
Dialogue: 0,0:07:33.02,0:07:35.01,Default,,0,0,0,,Куәгерлерді ешбір жағдайда тірі қалдыруға болмайды.
Dialogue: 0,0:07:35.05,0:07:36.09,Default,,0,0,0,,Шегіну
Dialogue: 0,0:07:37.02,0:07:38.06,Default,,0,0,0,,Ескерту атуларының мағынасы жоқ.
Dialogue: 0,0:07:39.02,0:07:41.07,Default,,0,0,0,,Егер сіз тартынсаңыз, өзіңізді өлтіре аласыз.
Dialogue: 0,0:07:42.03,0:07:43.04,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:07:43.09,0:07:44.07,Default,,0,0,0,,Мақсат
Dialogue: 0,0:07:45.08,0:07:47.07,Default,,0,0,0,,Бұл. . . өлтірілу
Dialogue: 0,0:07:48.00,0:07:49.01,Default,,0,0,0,,Кота
Dialogue: 0,0:07:49.01,0:07:50.05,Default,,0,0,0,,Қаш, қаш.
Dialogue: 0,0:07:50.05,0:07:51.05,Default,,0,0,0,,Кота
Dialogue: 0,0:07:51.08,0:07:52.08,Default,,0,0,0,,Түсіру
Dialogue: 0,0:07:53.06,0:07:55.04,Default,,0,0,0,,Кота
Dialogue: 0,0:07:59.05,0:08:01.04,Default,,0,0,0,,Мен бір нәрсені түсінбеймін.
Dialogue: 0,0:08:01.06,0:08:04.09,Default,,0,0,0,,Нана-чан мен Ню-чанға да солай.
Dialogue: 0,0:08:05.05,0:08:07.05,Default,,0,0,0,,Оның Котаға қатысы жоқ.
Dialogue: 0,0:08:08.06,0:08:09.03,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:09.07,0:08:12.03,Default,,0,0,0,,Мен туралы да
Dialogue: 0,0:08:13.04,0:08:14.02,Default,,0,0,0,,Маю-чан?
Dialogue: 0,0:08:15.03,0:08:17.04,Default,,0,0,0,,Мен мұны Нанамен бірге болған кезде сезіндім.
Dialogue: 0,0:08:17.08,0:08:21.02,Default,,0,0,0,,Кота-санды дүние тастап кеткен сияқты.
Dialogue: 0,0:08:21.03,0:08:24.01,Default,,0,0,0,,Олар бізді бірден қабылдады.
Dialogue: 0,0:08:24.03,0:08:25.08,Default,,0,0,0,,Жақсы айта алмаймын, бірақ
Dialogue: 0,0:08:26.00,0:08:31.00,Default,,0,0,0,,Қандай да бір қиналып, мұңайған адамды жалғыз қалдыра алмайтын сияқтысың.
Dialogue: 0,0:08:31.00,0:08:34.01,Default,,0,0,0,,Жоқ. Менің ойымша, мұны істеуіміздің себебі бар.
Dialogue: 0,0:08:34.07,0:08:35.05,Default,,0,0,0,,Сен дұрыс айтасың — сені өліміңе мен себеп болдым.
Dialogue: 0,0:08:38.02,0:08:41.04,Default,,0,0,0,,Оның сол оқиғаға қатысы бар ма деп ойлаймын.
Dialogue: 0,0:08:41.08,0:08:42.08,Default,,0,0,0,,Оқиға?
Dialogue: 0,0:08:43.03,0:08:44.08,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:08:46.06,0:08:49.03,Default,,0,0,0,,Котаға қандай себеп болғаны маңызды емес.
Dialogue: 0,0:08:49.05,0:08:53.01,Default,,0,0,0,,Менің ойымша, бұл Каэде сарайы мендегі жалғыз үй.
Dialogue: 0,0:08:53.06,0:08:56.03,Default,,0,0,0,,Ню-сан мен Нана-сан аға мен әпке сияқты.
Dialogue: 0,0:08:56.05,0:08:58.00,Default,,0,0,0,,Менің де ата-анам бар.
Dialogue: 0,0:08:58.08,0:08:59.06,Default,,0,0,0,,Ата-аналар?
Dialogue: 0,0:09:00.09,0:09:04.07,Default,,0,0,0,,Кота - Каэдесудың әкесі, Юка - анасы.
Dialogue: 0,0:09:05.03,0:09:06.08,Default,,0,0,0,,Менің ойымша, бұл.
Dialogue: 0,0:09:07.02,0:09:09.07,Default,,0,0,0,,Маю-чан, сен не айтып тұрсың?
Dialogue: 0,0:09:10.06,0:09:15.08,Default,,0,0,0,,Сондықтан бәрі жақын арада қайтып келетініне сенімдімін.
Dialogue: 0,0:09:23.08,0:09:25.00,Default,,0,0,0,,Жер бетінде не бар? . .
Dialogue: 0,0:09:26.09,0:09:28.02,Default,,0,0,0,,Бұл ақымақтық
Dialogue: 0,0:09:36.01,0:09:38.01,Default,,0,0,0,,Мен Люсиді көріп тұрмын.
Dialogue: 0,0:09:38.07,0:09:40.08,Default,,0,0,0,,Тұлға бөлінеді, сондықтан
Dialogue: 0,0:09:42.07,0:09:44.03,Default,,0,0,0,,Жаңа, не болды?
Dialogue: 0,0:09:44.07,0:09:45.07,Default,,0,0,0,,Тыңдау
Dialogue: 0,0:09:46.03,0:09:48.07,Default,,0,0,0,,Ол сіз білетін адам емес
Dialogue: 0,0:09:49.00,0:09:50.08,Default,,0,0,0,,Ол Люси
Dialogue: 0,0:09:54.09,0:09:57.01,Default,,0,0,0,,Мені кешіріңіз, бастық.
Dialogue: 0,0:10:04.04,0:10:05.02,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:10:08.02,0:10:09.01,Default,,0,0,0,,Әзірше осы.
Dialogue: 0,0:10:09.07,0:10:10.03,Default,,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:10:11.01,0:10:14.02,Default,,0,0,0,,Қорықпа. Барлығын бірден ататын болсаңыз, олар сізге тосқауыл қоя алмайды.
Dialogue: 0,0:10:15.02,0:10:16.01,Default,,0,0,0,,Өлгің келе ме?
Dialogue: 0,0:10:17.04,0:10:18.02,Default,,0,0,0,,Ал, қалай ойлайсың, Армин?
Dialogue: 0,0:10:25.02,0:10:28.02,Default,,0,0,0,,Түсіру. Енді бейбіт тұрғындарды тартуға алаңдаудың қажеті жоқ.
Dialogue: 0,0:10:33.08,0:10:34.08,Default,,0,0,0,,Мені атып таста
Dialogue: 0,0:10:36.02,0:10:37.04,Default,,0,0,0,,Бұл құбыжық
Dialogue: 0,0:10:50.09,0:10:54.00,Default,,0,0,0,,Иә, бұл бала.
Dialogue: 0,0:11:02.05,0:11:05.02,Default,,0,0,0,,Қарашы, қарашы, Юка-чан ебедейсіз.
Dialogue: 0,0:11:05.02,0:11:07.06,Default,,0,0,0,,Егер солай болса, қанша рет қолдансаңыз да, бәрі бірдей. Егер солай болса, қанша рет тырыссаңыз да, бәрі бірдей.
Dialogue: 0,0:11:08.02,0:11:11.05,Default,,0,0,0,,Не? Мен оны ұнатпаймын. Мен оны ұнатпаймын.
Dialogue: 0,0:11:11.06,0:11:13.05,Default,,0,0,0,,Осындай жерде жүрген идиот
Dialogue: 0,0:11:14.00,0:11:17.00,Default,,0,0,0,,Мен сені келесі жазға дейін көргім келмейді.
Dialogue: 0,0:11:17.08,0:11:19.08,Default,,0,0,0,,Ол қыз келмеді.
Dialogue: 0,0:11:22.00,0:11:23.04,Default,,0,0,0,,Жүр, жылауыңды доғар.
Dialogue: 0,0:11:23.06,0:11:25.00,Default,,0,0,0,,Өйткені сен бала емессің
Dialogue: 0,0:11:25.08,0:11:26.03,Default,,0,0,0,,Иә
Dialogue: 0,0:11:27.03,0:11:29.08,Default,,0,0,0,,Кана қайда кетті?
Dialogue: 0,0:11:30.06,0:11:32.07,Default,,0,0,0,,Мен адаспаймын деп үміттенемін.
Dialogue: 0,0:11:38.01,0:11:40.00,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:11:40.03,0:11:42.00,Default,,0,0,0,,Юка Кота
Dialogue: 0,0:11:42.00,0:11:42.50,Default,,0,0,0,,Ағай
Dialogue: 0,0:11:44.04,0:11:47.02,Default,,0,0,0,,Жақсы, жақсы болдыңыз ба?
Dialogue: 0,0:11:48.02,0:11:49.00,Default,,0,0,0,,Канае. .
Dialogue: 0,0:11:49.05,0:11:50.08,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:11:51.04,0:11:52.06,Default,,0,0,0,,Канэйге не болды?
Dialogue: 0,0:11:52.09,0:11:54.04,Default,,0,0,0,,Бөлініп қалды
Dialogue: 0,0:11:55.01,0:11:57.01,Default,,0,0,0,,Не болса да мен Канайды іздеймін.
Dialogue: 0,0:11:58.05,0:12:00.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:00.06,0:12:02.09,Default,,0,0,0,,Сол жерде бомба жарылса керек.
Dialogue: 0,0:12:02.09,0:12:03.08,Default,,0,0,0,,Бомба?
Dialogue: 0,0:12:05.04,0:12:06.02,Default,,0,0,0,,Ах.
Dialogue: 0,0:12:06.07,0:12:08.02,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:12:09.00,0:12:10.00,Default,,0,0,0,,Канае
Dialogue: 0,0:12:10.04,0:12:15.06,Default,,0,0,0,,Канэй-чан, сенің үстінде қан бар.
Dialogue: 0,0:12:15.06,0:12:16.04,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:12:17.07,0:12:20.05,Default,,0,0,0,,Көптеген адамдар қаза тапты.
Dialogue: 0,0:12:20.05,0:12:21.06,Default,,0,0,0,,Өлтірілді ме?
Dialogue: 0,0:12:22.02,0:12:26.09,Default,,0,0,0,,Мен оны көрдім.
Dialogue: 0,0:12:27.07,0:12:29.06,Default,,0,0,0,,Әйтеуір, тез үйге қайтайық.
Dialogue: 0,0:12:31.08,0:12:34.01,Default,,0,0,0,,Сіз қайтадан келесіз.
Dialogue: 0,0:12:35.04,0:12:38.05,Default,,0,0,0,,Бұл сөзсіз уәде.
Dialogue: 0,0:12:40.05,0:12:42.04,Default,,0,0,0,,Өйткені маған Юка-чан ұнайды
Dialogue: 0,0:12:42.08,0:12:44.02,Default,,0,0,0,,Сондықтан күте тұрыңыз.
Dialogue: 0,0:12:44.02,0:12:47.05,Default,,0,0,0,,Иә, күтемін. Мен сені күттім.
Dialogue: 0,0:12:47.06,0:12:50.03,Default,,0,0,0,,Сондықтан мені ұмытпа
Dialogue: 0,0:12:50.06,0:12:51.04,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:12:51.06,0:12:53.00,Default,,0,0,0,,Сен не істеп жүрсің, Кана?
Dialogue: 0,0:12:56.02,0:12:58.00,Default,,0,0,0,,Канэй Чанның да жағдайы жақсы деп үміттенемін.
Dialogue: 0,0:13:00.00,0:13:01.03,Default,,0,0,0,,Канае
Dialogue: 0,0:13:01.06,0:13:02.06,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:06.04,0:13:09.04,Default,,0,0,0,,Ақырында ол бала келмеді.
Dialogue: 0,0:13:09.06,0:13:10.02,Default,,0,0,0,,Кота
Dialogue: 0,0:13:10.04,0:13:11.04,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:13:25.08,0:13:27.08,Default,,0,0,0,,Кана, не болды?
Dialogue: 0,0:13:28.00,0:13:30.03,Default,,0,0,0,,Үлкен ағаның ақымақ
Dialogue: 0,0:13:30.03,0:13:33.04,Default,,0,0,0,,Менің ағамды мүйізді қыз өлтіреді.
Dialogue: 0,0:13:34.07,0:13:35.08,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:13:36.05,0:13:38.00,Default,,0,0,0,,Мен оны фестивальде көрдім.
Dialogue: 0,0:13:38.03,0:13:41.07,Default,,0,0,0,,Мүйізді қыз барлығын бір-ақ өлтірді.
Dialogue: 0,0:13:42.06,0:13:43.08,Default,,0,0,0,,Біртүрлі сөздер айтпа
Dialogue: 0,0:13:44.02,0:13:45.04,Default,,0,0,0,,Ондай нәрсе бар ма?
Dialogue: 0,0:13:45.08,0:13:46.08,Default,,0,0,0,,Дегенмен, менің ойымша, бұл жақсы жоспар.
Dialogue: 0,0:13:46.08,0:13:47.08,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:13:48.00,0:13:49.04,Default,,0,0,0,,Мен көрдім.
Dialogue: 0,0:13:49.09,0:13:52.03,Default,,0,0,0,,Мен олай өтірік айтатындарды ұнатпаймын.
Dialogue: 0,0:13:55.07,0:13:59.07,Default,,0,0,0,,Ақымақ, ақымақ, Канае өтірікші емес.
Dialogue: 0,0:13:59.07,0:14:00.07,Default,,0,0,0,,Әй, сен неге үндемейсің?
Dialogue: 0,0:14:01.06,0:14:05.03,Default,,0,0,0,,Оны мүйізді қыз шынымен өлтірді.
Dialogue: 0,0:14:17.08,0:14:19.01,Default,,0,0,0,,Канаэ Кора
Dialogue: 0,0:14:19.05,0:14:21.03,Default,,0,0,0,,О сен
Dialogue: 0,0:14:21.07,0:14:23.00,Default,,0,0,0,,Сіз де бортта болдыңыз.
Dialogue: 0,0:14:23.05,0:14:26.02,Default,,0,0,0,,Сен келмеген соң, мен не болды деп ойладым.
Dialogue: 0,0:14:26.09,0:14:29.01,Default,,0,0,0,,Бауырым, не айтып тұрсың?
Dialogue: 0,0:14:29.04,0:14:31.08,Default,,0,0,0,,Тез, тез қашуымыз керек.
Dialogue: 0,0:14:32.01,0:14:33.00,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:14:36.01,0:14:41.01,Default,,0,0,0,,Ертең бірге баратын Котаның жеңгелері ұл мен қыз.
Dialogue: 0,0:14:46.01,0:14:47.01,Default,,0,0,0,,Бұл ұл бала
Dialogue: 0,0:14:48.06,0:14:49.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:51.02,0:14:56.00,Default,,0,0,0,,Ертең Ертең түнде мен Котаны вокзалдан шығарып салуға барамын.
Dialogue: 0,0:14:56.09,0:14:57.04,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:15:00.04,0:15:02.06,Default,,0,0,0,,ұзын мойын ұзын мойын
Dialogue: 0,0:15:03.02,0:15:06.05,Default,,0,0,0,,Ей, сенің ұзын мойның керемет.
Dialogue: 0,0:15:08.09,0:15:11.09,Default,,0,0,0,,Бұл не? Үлкен үлкен үлкен
Dialogue: 0,0:15:12.03,0:15:14.05,Default,,0,0,0,,Өте үлкен нәрсе
Dialogue: 0,0:15:35.00,0:15:37.04,Default,,0,0,0,,Су салқын, өзін жақсы сезінеді
Dialogue: 0,0:15:43.08,0:15:45.05,Default,,0,0,0,,Бетіңіз лас.
Dialogue: 0,0:16:00.02,0:16:02.01,Default,,0,0,0,,Енді әдемірек емес пе?
Dialogue: 0,0:16:05.01,0:16:06.06,Default,,0,0,0,,Өз кезегінде
Dialogue: 0,0:16:07.00,0:16:08.05,Default,,0,0,0,,Менің ойымша, бұл бірінші орында.
Dialogue: 0,0:16:20.00,0:16:22.05,Default,,0,0,0,,Киім кепкенше автобусқа отыра алмаймын.
Dialogue: 0,0:16:31.04,0:16:33.02,Default,,0,0,0,,. . Ауырды
Dialogue: 0,0:16:35.00,0:16:37.01,Default,,0,0,0,,Аа, кешіріңіз, жақсысыз ба?
Dialogue: 0,0:16:39.05,0:16:41.01,Default,,0,0,0,,А, мен таң қалдым.
Dialogue: 0,0:16:41.08,0:16:42.08,Default,,0,0,0,,Бұл менің кесірім.
Dialogue: 0,0:16:45.03,0:16:45.53,Default,,0,0,0,,Кота
Dialogue: 0,0:16:47.06,0:16:48.07,Default,,0,0,0,,Сұранысыңыз бар ма?
Dialogue: 0,0:16:49.04,0:16:53.05,Default,,0,0,0,,Егер мен көп адамдарды өлтіре бастасам
Dialogue: 0,0:17:01.08,0:17:03.02,Default,,0,0,0,,Құрмет
Dialogue: 0,0:17:11.09,0:17:16.07,Default,,0,0,0,,Кота, Кота мені өлтірді.
Dialogue: 0,0:17:17.05,0:17:21.06,Default,,0,0,0,,Бұл өтірік. Мынадай. Мынадай.
Dialogue: 0,0:17:41.00,0:17:42.05,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:17:42.07,0:17:45.08,Default,,0,0,0,,Камакурада мұндай дүкендер көп.
Dialogue: 0,0:17:49.00,0:17:51.00,Default,,0,0,0,,Мұны сатып алуым керек пе?
Dialogue: 0,0:17:53.03,0:17:56.00,Default,,0,0,0,,Ән көңілді естілсе. . .
Dialogue: 0,0:17:56.04,0:17:57.06,Default,,0,0,0,,Бұл менің таңдауым.
Dialogue: 0,0:17:57.09,0:17:59.05,Default,,0,0,0,,Өйткені бұл ән маған ұнады
Dialogue: 0,0:18:18.06,0:18:19.02,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:18:20.05,0:18:22.00,Default,,0,0,0,,Өйткені мен оны үнемі қарап отырдым
Dialogue: 0,0:18:23.03,0:18:26.09,Default,,0,0,0,,Әдемі ән екен деп ойладым.
Dialogue: 0,0:18:27.03,0:18:28.01,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:18:28.08,0:18:30.06,Default,,0,0,0,,Мен үшін алаңдама
Dialogue: 0,0:18:31.01,0:18:33.03,Default,,0,0,0,,Ей, менімен дос бол.
Dialogue: 0,0:18:36.00,0:18:37.06,Default,,0,0,0,,Қай жерде сурет салдыңыз?
Dialogue: 0,0:18:38.04,0:18:40.07,Default,,0,0,0,,Иә, тауда
Dialogue: 0,0:18:41.02,0:18:43.00,Default,,0,0,0,,Біртүрлі бала еді.
Dialogue: 0,0:18:43.07,0:18:44.09,Default,,0,0,0,,Біртүрлі бала ма?
Dialogue: 0,0:18:44.09,0:18:50.00,Default,,0,0,0,,Үлкен аға, мен көп снарядтарды жинадым, қара!
Dialogue: 0,0:18:51.05,0:18:52.03,Default,,0,0,0,,(Роко) Һм? (Масато) Хехехе
Dialogue: 0,0:18:53.06,0:18:56.03,Default,,0,0,0,,Егер бұл мүйізді ұнатпасаңыз, оны жасырыңыз.
Dialogue: 0,0:18:59.02,0:19:00.00,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:19:01.04,0:19:02.03,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:19:02.03,0:19:03.01,Default,,0,0,0,,Канае
Dialogue: 0,0:19:04.09,0:19:08.06,Default,,0,0,0,,Үлкен аға, қашу керек, тез қашу керек.
Dialogue: 0,0:19:11.04,0:19:13.02,Default,,0,0,0,,Не істеп жатырсың, ақымақ?
Dialogue: 0,0:19:13.04,0:19:15.03,Default,,0,0,0,,Бұл бала не істеді?
Dialogue: 0,0:19:15.07,0:19:17.00,Default,,0,0,0,,Дұрыс кешірім сұрау
Dialogue: 0,0:19:17.00,0:19:19.08,Default,,0,0,0,,Әйтпесе, мен Канайды жек көремін.
Dialogue: 0,0:19:20.08,0:19:25.01,Default,,0,0,0,,Жоқ, аға, өтінемін, Канайды жек көрмеңіз.
Dialogue: 0,0:19:49.09,0:19:51.09,Default,,0,0,0,,Кота, сен нені шулатып тұрсың? . .
Dialogue: 0,0:20:01.03,0:20:04.04,Default,,0,0,0,,Мұның бәрін сіз жасадыңыз.
Dialogue: 0,0:20:05.03,0:20:07.00,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:20:07.02,0:20:09.02,Default,,0,0,0,,Біз дос емеспіз
Dialogue: 0,0:20:10.03,0:20:11.04,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:20:11.07,0:20:14.01,Default,,0,0,0,,Сен мені дос болғанымыз үшін өлтірмеген шығарсың.
Dialogue: 0,0:20:20.02,0:20:22.01,Default,,0,0,0,,Келесі - бұл әйел.
Dialogue: 0,0:20:24.09,0:20:26.06,Default,,0,0,0,,Әйел Юка
Dialogue: 0,0:20:44.00,0:20:45.04,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:20:46.06,0:20:50.09,Default,,0,0,0,,Тоқта, тоқта, тоқта!
Dialogue: 0,0:20:51.06,0:20:54.07,Default,,0,0,0,,Тоқта, тоқта
Dialogue: 0,0:20:54.07,0:20:56.07,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:21:00.00,0:21:01.06,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:21:11.08,0:21:13.07,Default,,0,0,0,,Қауіпті, бұл өрт қаупі.
Dialogue: 0,0:21:19.02,0:21:21.08,Default,,0,0,0,,Мен есімде қалдым Бәрі есімде
Dialogue: 0,0:21:23.04,0:21:26.02,Default,,0,0,0,,Сіз сегіз жыл бұрын сол кезде болдыңыз.
Dialogue: 0,0:21:47.05,0:21:52.08,Default,,0,0,0,,Айтшы, сен кімсің?
Dialogue: 0,0:21:54.08,0:21:57.00,Default,,0,0,0,,Осы сияқты әдеттен тыс нәрселер көп болып жатыр.
Dialogue: 0,0:21:57.04,0:21:59.04,Default,,0,0,0,,Сіз әрқашан ортадасыз
Dialogue: 0,0:21:59.07,0:22:01.00,Default,,0,0,0,,Білгеннен не пайда?
Dialogue: 0,0:22:01.04,0:22:04.00,Default,,0,0,0,,Мұның сізге еш қатысы жоқ.
Dialogue: 0,0:22:04.00,0:22:08.05,Default,,0,0,0,,Иә, болуы керек.
Dialogue: 0,0:22:12.06,0:22:16.09,Default,,0,0,0,,Менің әпкем мен әкемді өлтірдің.
Dialogue: 0,0:22:23.06,0:22:24.04,Default,,0,0,0,,Кота
Dialogue: 0,0:22:28.06,0:22:32.07,Default,,0,0,0,,Мен аң аулауды өтінген олжаны аулайтын сүйікті адам болады деп ойламаппын.
Dialogue: 0,0:22:32.07,0:22:35.04,Default,,0,0,0,,Көзімнің, қолымның жауы. Мен өлемін.
Dialogue: 0,0:22:44.03,0:22:46.08,Default,,0,0,0,,Қашпа, күрес!
Dialogue: 0,0:22:48.00,0:22:50.00,Default,,0,0,0,,Мені сол тас баспалдақта күт.
Dialogue: 0,0:22:53.06,0:22:54.04,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:24:34.06,0:24:36.08,Default,,0,0,0,,Дұғалар ақыры қабыл болмайды
Dialogue: 0,0:24:37.03,0:24:39.08,Default,,0,0,0,,Мойындаудың енді мағынасы жоқ
Dialogue: 0,0:24:40.09,0:24:42.09,Default,,0,0,0,,Бір-бірінің жеке сөздері, жақсылығы
Dialogue: 0,0:24:43.03,0:24:46.00,Default,,0,0,0,,Махаббаттың да ұсақ-түйек болудан басқа амалы жоқ
Dialogue: 0,0:24:46.09,0:24:50.01,Default,,0,0,0,,Ертегі жырындай
Dialogue: 0,0:24:50.04,0:24:53.03,Default,,0,0,0,,Мұңды жыр сияқты, Эфемерлі
