Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:18.01,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.01,0:00:27.02,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.02,0:00:38.05,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.05,0:00:49.01,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.01,0:01:02.02,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.06,0:01:13.07,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.07,0:01:28.03,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:46.04,0:01:47.02,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:01:47.07,0:01:49.02,Default,,0,0,0,,Бұл әке, бұл әке
Dialogue: 0,0:01:50.05,0:01:52.06,Default,,0,0,0,,Бұл жерде жақсы Сіз оны дыбысынан байқауға болады
Dialogue: 0,0:01:57.09,0:01:58.08,Default,,0,0,0,,Нана
Dialogue: 0,0:02:00.01,0:02:02.02,Default,,0,0,0,,Сәл кешігіп келсеңіз
Dialogue: 0,0:02:04.06,0:02:06.07,Default,,0,0,0,,Мен саған алыс жерде тұр дедім.
Dialogue: 0,0:02:08.01,0:02:09.06,Default,,0,0,0,,Мм, бұл. . .
Dialogue: 0,0:02:10.02,0:02:13.05,Default,,0,0,0,,Оның үстіне әке неге мұнда?
Dialogue: 0,0:02:17.05,0:02:18.06,Default,,0,0,0,,Қ–… Сен, порноман!
Dialogue: 0,0:02:19.02,0:02:22.04,Default,,0,0,0,,Сен менің олжамсың.
Dialogue: 0,0:02:23.05,0:02:27.04,Default,,0,0,0,,Мен оны міндетті түрде өз қолыммен аяқтаймын.
Dialogue: 0,0:02:27.09,0:02:29.01,Default,,0,0,0,,Сырттан қараған адамға бұл қызғаныштың өзі сияқты көрінуі тиіс.
Dialogue: 0,0:02:29.01,0:02:29.51,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:02:33.00,0:02:35.08,Default,,0,0,0,,Сіз мені енді ешқашан көрмейсіз
Dialogue: 0,0:02:43.01,0:02:45.02,Default,,0,0,0,,Күтіңіз, күтіңіз.
Dialogue: 0,0:02:55.02,0:02:57.06,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:02:59.04,0:03:00.02,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:03:00.04,0:03:01.00,Default,,0,0,0,,Иә
Dialogue: 0,0:03:02.00,0:03:08.06,Default,,0,0,0,,Котаның әкесі мен сіңлісі Канае өлтірілді.
Dialogue: 0,0:03:10.00,0:03:11.04,Default,,0,0,0,,Котаның алдында
Dialogue: 0,0:03:14.03,0:03:18.05,Default,,0,0,0,,Бұл бастапқы мәселе болды және Кота бір жылға жуық ауруханада жатты.
Dialogue: 0,0:03:20.04,0:03:22.06,Default,,0,0,0,,Ол кезде біз әлі бала едік.
Dialogue: 0,0:03:24.08,0:03:27.00,Default,,0,0,0,,Мен мұның бәрін кейін естідім.
Dialogue: 0,0:03:27.02,0:03:28.06,Default,,0,0,0,,. . Кінәлі
Dialogue: 0,0:03:31.00,0:03:33.00,Default,,0,0,0,,Басқа да көптеген құрбандар бар.
Dialogue: 0,0:03:34.00,0:03:36.01,Default,,0,0,0,,Полиция ұзақ уақыт бойы тергеу жүргізді.
Dialogue: 0,0:03:38.06,0:03:41.02,Default,,0,0,0,,Мен Кота-санмен мұндай оқиға болғанына сене алар емеспін.
Dialogue: 0,0:03:41.07,0:03:45.05,Default,,0,0,0,,Кота Ол кез туралы ештеңе есіңде жоқ сияқты.
Dialogue: 0,0:03:47.06,0:03:49.08,Default,,0,0,0,,Маю-чанның әңгімесін тыңдадым.
Dialogue: 0,0:03:51.00,0:03:55.07,Default,,0,0,0,,Ол басқа қыздарға мейірімді ме деп ойлаймын, себебі оның басынан осындай жағдай болған.
Dialogue: 0,0:03:56.09,0:04:00.02,Default,,0,0,0,,Котаға бәрі Канаэ-чан сияқты.
Dialogue: 0,0:04:02.05,0:04:03.04,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:04:05.00,0:04:07.01,Default,,0,0,0,,Мен әрқашан якимочиді рұқсатсыз гриль жасаймын.
Dialogue: 0,0:04:07.09,0:04:10.01,Default,,0,0,0,,Әр кезде ашуланып, жылайтынмын.
Dialogue: 0,0:04:11.09,0:04:15.02,Default,,0,0,0,,Мен керемет ана емеспін.
Dialogue: 0,0:04:17.01,0:04:18.00,Default,,0,0,0,,Юка-сан
Dialogue: 0,0:04:21.05,0:04:25.08,Default,,0,0,0,,Юка-сан шынымен Кота-санды ұнатады, солай ма?
Dialogue: 0,0:04:31.03,0:04:33.01,Default,,0,0,0,,Ширакаваны Люси жеңді
Dialogue: 0,0:04:34.08,0:04:38.02,Default,,0,0,0,,Иә, неге пайда болды?
Dialogue: 0,0:04:39.01,0:04:40.06,Default,,0,0,0,,Мен үшін де солай. . .
Dialogue: 0,0:04:41.02,0:04:47.00,Default,,0,0,0,,-ден кейін мен неге екенін білмеймін, бірақ 35 саны векторды енді шығару мүмкін емес.
Dialogue: 0,0:04:47.04,0:04:49.04,Default,,0,0,0,,Операция толығымен сәтсіздікке ұшырады.
Dialogue: 0,0:04:51.02,0:04:52.06,Default,,0,0,0,,Бірақ басқа да нұсқалар бар. . .
Dialogue: 0,0:04:52.09,0:04:57.09,Default,,0,0,0,,Вектор пайда болмаса да, 35 санының әлі де қолданысы болуы керек.
Dialogue: 0,0:04:58.08,0:05:00.06,Default,,0,0,0,,Тіпті саған автограф қойып, қолыңды да қысып қояйын
Dialogue: 0,0:05:03.04,0:05:06.06,Default,,0,0,0,,Мүмкін ол адам адам емес шығар.
Dialogue: 0,0:05:07.09,0:05:11.08,Default,,0,0,0,,Мен мұндай құбыжықты Құрама бастықтың қызы болады деп күтпедім.
Dialogue: 0,0:05:14.04,0:05:15.07,Default,,0,0,0,,Ол себеп пен салдарға байланысты.
Dialogue: 0,0:05:25.07,0:05:29.00,Default,,0,0,0,,Сақтықты түсірме, қандай жағдай болса да, тартынба.
Dialogue: 0,0:05:30.00,0:05:30.50,Default,,0,0,0,,Иә
Dialogue: 0,0:05:31.09,0:05:33.00,Default,,0,0,0,,Курама
Dialogue: 0,0:05:34.04,0:05:36.02,Default,,0,0,0,,Мен бар екеніне сенімдімін, Нана.
Dialogue: 0,0:05:36.07,0:05:39.01,Default,,0,0,0,,Иә, мен ояумын.
Dialogue: 0,0:05:39.09,0:05:41.00,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:05:41.04,0:05:44.00,Default,,0,0,0,,Неліктен әкем бұл баланы өлтіруге мәжбүр болды?
Dialogue: 0,0:05:45.01,0:05:46.06,Default,,0,0,0,,Өйткені ол менің нағыз қызым
Dialogue: 0,0:05:46.08,0:05:48.07,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:05:50.03,0:05:50.53,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:51.04,0:05:52.06,Default,,0,0,0,,Бұл Люси.
Dialogue: 0,0:05:52.08,0:05:54.08,Default,,0,0,0,,Люси де жақындап келеді.
Dialogue: 0,0:05:55.06,0:05:56.06,Default,,0,0,0,,Люси
Dialogue: 0,0:06:03.06,0:06:04.06,Default,,0,0,0,,Мен байқадым.
Dialogue: 0,0:06:06.00,0:06:08.00,Default,,0,0,0,,Мені өлтіргім келеді
Dialogue: 0,0:06:34.02,0:06:35.08,Default,,0,0,0,,Емделген сияқты
Dialogue: 0,0:06:36.06,0:06:40.03,Default,,0,0,0,,Мен оны қолданып көрдім, ол менің қолыммен жақсы шықты.
Dialogue: 0,0:06:42.08,0:06:45.00,Default,,0,0,0,,Люси осы жолмен келе жатыр.
Dialogue: 0,0:07:00.00,0:07:03.01,Default,,0,0,0,,Күшейтуге тағы 30 минут кетеді.
Dialogue: 0,0:07:03.08,0:07:06.01,Default,,0,0,0,,Құбыжықтар бір-бірімен жай ғана араласуы керек.
Dialogue: 0,0:07:07.00,0:07:08.03,Default,,0,0,0,,Енді құрбандық шалмайды
Dialogue: 0,0:07:08.06,0:07:09.07,Default,,0,0,0,,Төтенше жағдайда
Dialogue: 0,0:07:25.06,0:07:26.06,Default,,0,0,0,,​​Неге келдің?
Dialogue: 0,0:07:27.09,0:07:30.08,Default,,0,0,0,,Әу бастан нысана мен болсам керек.
Dialogue: 0,0:07:32.00,0:07:34.00,Default,,0,0,0,,Үлкен апа сенімге толы.
Dialogue: 0,0:07:35.00,0:07:37.07,Default,,0,0,0,,Мен енді ешкімді тартқым келмейді.
Dialogue: 0,0:07:56.02,0:07:57.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:19.03,0:08:22.02,Default,,0,0,0,,Енді мен сені мына тозақтан тез арада босатамын.
Dialogue: 0,0:08:30.07,0:08:33.09,Default,,0,0,0,,Өлтіру? Әпкең мені іздеп жүр ме?
Dialogue: 0,0:08:34.08,0:08:36.06,Default,,0,0,0,,Бұл қалжың ба, әлде бір нәрсе ме, білмеймін.
Dialogue: 0,0:08:37.05,0:08:39.07,Default,,0,0,0,,Мені ешкім өлтіре алмайды
Dialogue: 0,0:09:05.00,0:09:07.07,Default,,0,0,0,,Сіз жеңдіңіз. Енді Люсиді ұстауға болады.
Dialogue: 0,0:09:13.03,0:09:16.08,Default,,0,0,0,,Мен мұны істедім. Енді менің орным сенімді.
Dialogue: 0,0:09:17.03,0:09:18.02,Default,,0,0,0,,Осыдан кейін. . .
Dialogue: 0,0:09:22.01,0:09:25.00,Default,,0,0,0,,Бұл бәрі қорқатын Люси.
Dialogue: 0,0:09:25.00,0:09:25.50,Default,,0,0,0,,Марико
Dialogue: 0,0:09:36.06,0:09:38.00,Default,,0,0,0,,. . Бастық Курама
Dialogue: 0,0:09:38.07,0:09:39.04,Default,,0,0,0,,Курама
Dialogue: 0,0:09:41.09,0:09:42.07,Default,,0,0,0,,Әке?
Dialogue: 0,0:09:43.08,0:09:44.07,Default,,0,0,0,,Марико?
Dialogue: 0,0:09:46.08,0:09:47.08,Default,,0,0,0,,Әкем
Dialogue: 0,0:09:58.04,0:10:01.01,Default,,0,0,0,,Әке, мен Марикомен танысқым келді.
Dialogue: 0,0:10:11.02,0:10:12.03,Default,,0,0,0,,Әкем
Dialogue: 0,0:10:30.01,0:10:34.07,Default,,0,0,0,,Марико, мен оны көптен күттім.
Dialogue: 0,0:10:35.06,0:10:37.08,Default,,0,0,0,,Сол қараңғы бөлмеде
Dialogue: 0,0:10:40.06,0:10:49.05,Default,,0,0,0,,Мәңгі, мәңгі, бір күні әкем мен шешем мені алып кетуге келеді.
Dialogue: 0,0:10:50.04,0:10:54.06,Default,,0,0,0,,Мариконы бұл бөлмеден шығарыңыз.
Dialogue: 0,0:10:55.06,0:10:59.00,Default,,0,0,0,,Сонда үшеуміз бірге тұра аламыз.
Dialogue: 0,0:10:59.03,0:11:02.02,Default,,0,0,0,,Соған қарамастан, соған қарамастан
Dialogue: 0,0:11:03.05,0:11:05.03,Default,,0,0,0,,Ақыры кездескенімізге қарамастан
Dialogue: 0,0:11:05.06,0:11:08.04,Default,,0,0,0,,Әке әке
Dialogue: 0,0:11:09.01,0:11:11.08,Default,,0,0,0,,Әкем
Dialogue: 0,0:11:13.01,0:11:18.05,Default,,0,0,0,,Мен көп адамның баласын өлтірсем де,
Dialogue: 0,0:11:19.04,0:11:24.04,Default,,0,0,0,,Сен менің қызым болғаның үшін мен сені пайдалана бердім.
Dialogue: 0,0:11:25.08,0:11:28.09,Default,,0,0,0,,Бәріне менің кінәм.
Dialogue: 0,0:11:29.06,0:11:36.05,Default,,0,0,0,,Сонда Марико, сен осы уақытқа дейін не үшін өмір сүрдің?
Dialogue: 0,0:11:36.05,0:11:37.08,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:11:39.02,0:11:41.02,Default,,0,0,0,,Әке, қашу керек.
Dialogue: 0,0:11:41.05,0:11:47.04,Default,,0,0,0,,Әке? Неге, неге анау апа сізді әке деп атайды?
Dialogue: 0,0:11:48.03,0:11:51.00,Default,,0,0,0,,Мен Мариконы жалғыз қалдырдым
Dialogue: 0,0:11:51.02,0:11:52.02,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:58.00,0:12:00.04,Default,,0,0,0,,Әкем қашып кетті. . .
Dialogue: 0,0:12:01.05,0:12:02.07,Default,,0,0,0,,Сәлем, әке.
Dialogue: 0,0:12:04.04,0:12:06.06,Default,,0,0,0,,Үлкен апа өлсе, қайғырасың ба?
Dialogue: 0,0:12:09.01,0:12:12.00,Default,,0,0,0,,Жауап бере алмасаңыз, мен тырысамын.
Dialogue: 0,0:12:31.01,0:12:34.06,Default,,0,0,0,,Келме, Келме
Dialogue: 0,0:12:41.00,0:12:42.07,Default,,0,0,0,,Жылулық, махаббат
Dialogue: 0,0:12:44.04,0:12:46.08,Default,,0,0,0,,Бәрін алып кеткен менмін.
Dialogue: 0,0:12:49.04,0:12:50.01,Default,,0,0,0,,Марико
Dialogue: 0,0:12:51.09,0:12:57.00,Default,,0,0,0,,Мен сені бір сәтке де ұмытпадым.
Dialogue: 0,0:12:58.04,0:12:59.02,Default,,0,0,0,,Әкем
Dialogue: 0,0:13:00.02,0:13:02.02,Default,,0,0,0,,Марико, кешіріңіз.
Dialogue: 0,0:13:07.03,0:13:09.03,Default,,0,0,0,,Бұдан былай біз мәңгі бірге боламыз.
Dialogue: 0,0:13:10.00,0:13:11.00,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:13:11.05,0:13:12.04,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:13:13.05,0:13:14.05,Default,,0,0,0,,Кез келген уақытта
Dialogue: 0,0:13:14.07,0:13:15.09,Default,,0,0,0,,. . . бастық
Dialogue: 0,0:13:17.05,0:13:19.08,Default,,0,0,0,,Сіз әу бастан солай істеуді ойладыңыз ба?
Dialogue: 0,0:13:20.07,0:13:23.00,Default,,0,0,0,,Директормен қанша жыл жұмыс істеп келе жатырсыз деп ойлайсыз?
Dialogue: 0,0:13:23.09,0:13:25.09,Default,,0,0,0,,Ол кісі осылай ойлайтын.
Dialogue: 0,0:13:32.06,0:13:33.03,Default,,0,0,0,,Нана
Dialogue: 0,0:13:34.06,0:13:36.04,Default,,0,0,0,,Тек сен бақытты болуың керек
Dialogue: 0,0:13:38.00,0:13:38.50,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:13:40.04,0:13:41.04,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:14:01.02,0:14:03.08,Default,,0,0,0,,Бұйрықты орындамасаң, мен өлтіремін.
Dialogue: 0,0:14:05.02,0:14:07.02,Default,,0,0,0,,Өтінемін, бұл туралы ренжімеңіз.
Dialogue: 0,0:14:09.00,0:14:10.01,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:14:19.03,0:14:20.04,Default,,0,0,0,,Әкем
Dialogue: 0,0:14:22.00,0:14:22.50,Default,,0,0,0,,Марико
Dialogue: 0,0:14:23.07,0:14:28.01,Default,,0,0,0,,Мен сені кездестіргенімде осыны айтқым келген.
Dialogue: 0,0:14:29.04,0:14:34.05,Default,,0,0,0,,Анаң сені соңына дейін жақсы көрді.
Dialogue: 0,0:14:36.09,0:14:41.08,Default,,0,0,0,,Біз сені шын сүйдік
Dialogue: 0,0:15:21.09,0:15:26.03,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:15:27.07,0:15:29.00,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:15:36.08,0:15:40.02,Default,,0,0,0,,Енді сен ғана қалдың. Енді бұл менмін. .
Dialogue: 0,0:15:43.08,0:15:44.07,Default,,0,0,0,,Люси
Dialogue: 0,0:15:45.04,0:15:49.09,Default,,0,0,0,,Адамдар ақымақ
Dialogue: 0,0:15:50.01,0:15:54.02,Default,,0,0,0,,Ондай нәрсе жоқ. Әке - әке
Dialogue: 0,0:15:56.01,0:15:58.02,Default,,0,0,0,,Сол үйде Котамен бірге тұрыңыз.
Dialogue: 0,0:16:02.02,0:16:03.06,Default,,0,0,0,,Мен не істей алмаймын
Dialogue: 0,0:16:05.00,0:16:06.04,Default,,0,0,0,,Мен сенен қалаймын
Dialogue: 0,0:16:07.05,0:16:08.07,Default,,0,0,0,,Люси
Dialogue: 0,0:16:16.04,0:16:20.04,Default,,0,0,0,,Люсиді ұстау үшін SAT-тың толық күшін жұмылдырыңыз.
Dialogue: 0,0:16:21.01,0:16:23.03,Default,,0,0,0,,Тек мойын мен торсы қалуы керек
Dialogue: 0,0:16:25.00,0:16:26.07,Default,,0,0,0,,Өйткені, мен оны аяймын.
Dialogue: 0,0:16:27.01,0:16:29.06,Default,,0,0,0,,Толық жиынтыққа ие болу өзін-өзі жоюға бола ма?
Dialogue: 0,0:16:30.02,0:16:33.04,Default,,0,0,0,,Бұл. . . Жуынатын кез келді
Dialogue: 0,0:16:38.00,0:16:40.04,Default,,0,0,0,,Жоспарлау енді ғана басталды
Dialogue: 0,0:16:41.02,0:16:42.08,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,0:16:59.09,0:17:00.09,Default,,0,0,0,,Жара
Dialogue: 0,0:17:01.08,0:17:03.03,Default,,0,0,0,,Үлкен мәселе емес
Dialogue: 0,0:17:07.09,0:17:11.07,Default,,0,0,0,,Бала кезімізде бірге ойнаған қыздар
Dialogue: 0,0:17:12.09,0:17:15.06,Default,,0,0,0,,Бұл да сен бе деп ойлаймын
Dialogue: 0,0:17:17.04,0:17:22.07,Default,,0,0,0,,Мен адамдарды жою үшін дүниеге келдім
Dialogue: 0,0:17:24.05,0:17:28.04,Default,,0,0,0,,5 жыл. 5 жыл.
Dialogue: 0,0:17:29.05,0:17:34.01,Default,,0,0,0,,Біз отбасымызда туылған балалардың көпшілігін жасай аламыз.
Dialogue: 0,0:17:35.09,0:17:37.08,Default,,0,0,0,,Бірақ дүние солай болып кетсе
Dialogue: 0,0:17:40.06,0:17:42.04,Default,,0,0,0,,Сен де тірі болмас едің.
Dialogue: 0,0:17:43.04,0:17:50.04,Default,,0,0,0,,Мына тозақта кенет менің алдымда Кота пайда болды.
Dialogue: 0,0:17:52.02,0:17:53.06,Default,,0,0,0,,Бұл өткінші арман
Dialogue: 0,0:17:55.08,0:18:00.02,Default,,0,0,0,,Тек сені кездестірген сол күндер
Dialogue: 0,0:18:01.06,0:18:02.04,Default,,0,0,0,,Менің. . .
Dialogue: 0,0:18:06.02,0:18:10.07,Default,,0,0,0,,Мен әрқашан Котадан кешірім сұрағым келді.
Dialogue: 0,0:18:12.03,0:18:13.05,Default,,0,0,0,,Мен жай ғана
Dialogue: 0,0:18:14.04,0:18:16.07,Default,,0,0,0,,Сол үшін мәңгі шыда
Dialogue: 0,0:18:17.08,0:18:18.09,Default,,0,0,0,,Аман қалды
Dialogue: 0,0:18:31.09,0:18:33.00,Default,,0,0,0,,18-ші эпизод: Венецияға!
Dialogue: 0,0:18:33.07,0:18:35.08,Default,,0,0,0,,Неге, мен сенің отбасыңнан айырылдым.
Dialogue: 0,0:18:35.08,0:18:36.08,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:18:38.08,0:18:43.08,Default,,0,0,0,,Мен сені Кана мен әкеңді өлтіргеніңді кешіре алмаймын.
Dialogue: 0,0:18:46.00,0:18:47.03,Default,,0,0,0,,Бірақ
Dialogue: 0,0:18:48.00,0:18:49.06,Default,,0,0,0,,Егер сіз әлі де біреуді ренжітсеңіз
Dialogue: 0,0:18:50.00,0:18:55.04,Default,,0,0,0,,Мен әлі де мәңгі өкінетініме сенімдімін.
Dialogue: 0,0:18:59.08,0:19:03.08,Default,,0,0,0,,Балаларымның қасында болсам да, Жалғыз қыз болсам да
Dialogue: 0,0:19:05.00,0:19:08.04,Default,,0,0,0,,Өйткені мен де сені жақсы көремін
Dialogue: 0,0:19:09.00,0:19:09.50,Default,,0,0,0,,Кота
Dialogue: 0,0:20:19.08,0:20:21.03,Default,,0,0,0,,Барлығын ұмыт
Dialogue: 0,0:20:22.06,0:20:25.02,Default,,0,0,0,,Мен жай ғана Котаның қасында болғым келді.
Dialogue: 0,0:20:26.02,0:20:27.01,Default,,0,0,0,,Жаңа
Dialogue: 0,0:20:28.02,0:20:32.02,Default,,0,0,0,,Мені көп мұңды ойлар тудырды.
Dialogue: 0,0:20:33.04,0:20:34.03,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:37.00,0:20:37.50,Default,,0,0,0,,Тіпті сен де
Dialogue: 0,0:20:40.08,0:20:41.08,Default,,0,0,0,,Тіпті сіз
Dialogue: 0,0:20:43.06,0:20:47.07,Default,,0,0,0,,Сізде көптеген қайғылы сезімдер болды, солай емес пе?
Dialogue: 0,0:21:26.01,0:21:27.01,Default,,0,0,0,,Мен үйге баруым керек
Dialogue: 0,0:21:28.04,0:21:29.05,Default,,0,0,0,,Мен үйге баруым керек
Dialogue: 0,0:21:31.00,0:21:32.02,Default,,0,0,0,,Мен үйге баруым керек
Dialogue: 0,0:21:32.04,0:21:33.00,Default,,0,0,0,,Тұрыс
Dialogue: 0,0:21:39.08,0:21:43.08,Default,,0,0,0,,Мен әркімнің үйіне баруым керек.
Dialogue: 0,0:21:48.05,0:21:49.05,Default,,0,0,0,,Түсіру
Dialogue: 0,0:22:07.08,0:22:11.08,Default,,0,0,0,,Бұл мен оны ұзақ уақыт бойы тазаламағандықтан орын алды.
Dialogue: 0,0:22:12.01,0:22:13.09,Default,,0,0,0,,Егер сіз асықпасаңыз, түскі асты өткізіп жіберуге тура келеді.
Dialogue: 0,0:22:13.09,0:22:15.05,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:22:22.06,0:22:23.04,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:22:23.07,0:22:24.09,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:22:29.00,0:22:31.04,Default,,0,0,0,,Нана-сан, шеберлігің жақсарды.
Dialogue: 0,0:22:31.04,0:22:34.03,Default,,0,0,0,,Маған ұнамайды. Бұл винерді гриль жасау сияқты.
Dialogue: 0,0:22:34.06,0:22:36.08,Default,,0,0,0,,Өйткені ол көмірге айналмаған.
Dialogue: 0,0:22:36.08,0:22:38.03,Default,,0,0,0,,Орташа
Dialogue: 0,0:22:48.08,0:22:52.04,Default,,0,0,0,,Юка, сенде тағы бір тостаған бар.
Dialogue: 0,0:22:53.00,0:22:57.02,Default,,0,0,0,,Өйткені оның да жегісі келді.
Dialogue: 0,0:22:58.03,0:22:59.07,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:23:04.00,0:23:05.05,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:23:10.02,0:23:11.02,Default,,0,0,0,,Дәмді
Dialogue: 0,0:23:11.06,0:23:14.05,Default,,0,0,0,,Бұл менің бірінші рет сынап көруім.
Dialogue: 0,0:23:15.00,0:23:18.02,Default,,0,0,0,,Иә, мен соңғы рет тамақ ішпей қалдым.
Dialogue: 0,0:23:26.04,0:23:29.01,Default,,0,0,0,,Ғажайып дүниелер көп болса да
Dialogue: 0,0:23:31.06,0:23:33.03,Default,,0,0,0,,Көп
Dialogue: 0,0:23:39.00,0:23:39.50,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:23:43.00,0:23:44.08,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:23:45.09,0:23:47.02,Default,,0,0,0,,тамақ ішейік
Dialogue: 0,0:23:47.02,0:23:50.08,Default,,0,0,0,,Саса Көп жемесең, үлкен болмайсың.
Dialogue: 0,0:23:54.05,0:23:56.03,Default,,0,0,0,,Бұл тұтынушы ма?
Dialogue: 0,0:23:56.07,0:23:57.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:24:22.01,0:24:25.07,Default,,0,0,0,,Бұл қозғалады.
Dialogue: 0,0:24:26.57,0:24:31.57,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
