Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:18.01,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.01,0:00:27.02,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.02,0:00:38.05,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.05,0:00:49.01,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.01,0:01:02.02,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.06,0:01:13.07,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.07,0:01:28.03,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:31.00,0:01:32.00,Default,,0,0,0,,Ню-чан
Dialogue: 0,0:01:36.03,0:01:37.02,Default,,0,0,0,,Кота
Dialogue: 0,0:01:37.04,0:01:38.06,Default,,0,0,0,,Тек қолтаңба ғана — ерекше алғыс
Dialogue: 0,0:01:38.06,0:01:40.07,Default,,0,0,0,,Ол кездегідей емес
Dialogue: 0,0:01:40.09,0:01:41.08,Default,,0,0,0,,Ню-сан
Dialogue: 0,0:01:41.08,0:01:43.01,Default,,0,0,0,,Ню-чан, жақсысың ба?
Dialogue: 0,0:01:43.05,0:01:44.08,Default,,0,0,0,,Ню-чан деба
Dialogue: 0,0:01:45.03,0:01:46.01,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:46.02,0:01:46.52,Default,,0,0,0,,Эй
Dialogue: 0,0:01:53.03,0:01:55.00,Default,,0,0,0,,Сіз кенеттен не істеп жатырсыз?
Dialogue: 0,0:01:55.00,0:01:56.07,Default,,0,0,0,,Бұл менің жолым шығар.
Dialogue: 0,0:01:58.03,0:02:00.03,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:02:00.06,0:02:04.06,Default,,0,0,0,,Кешіріңіз. Бұл болғанына өкінемін.
Dialogue: 0,0:02:04.06,0:02:07.02,Default,,0,0,0,,Кота-сан, кешіріңіз.
Dialogue: 0,0:02:08.09,0:02:12.02,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:02:12.05,0:02:14.00,Default,,0,0,0,,Бұл кінәлі адам.
Dialogue: 0,0:02:14.03,0:02:16.06,Default,,0,0,0,,Неліктен бәрі Люсиді қорғайды?
Dialogue: 0,0:02:17.00,0:02:17.50,Default,,0,0,0,,Люси
Dialogue: 0,0:02:18.00,0:02:20.00,Default,,0,0,0,,Ол өте жаман адам.
Dialogue: 0,0:02:20.04,0:02:23.08,Default,,0,0,0,,Неге, бұл жерде ештеңе жоқ.
Dialogue: 0,0:02:24.04,0:02:27.05,Default,,0,0,0,,Нана Бұл жаман емес.
Dialogue: 0,0:02:27.05,0:02:29.09,Default,,0,0,0,,Ню-чан, жауап беріңізші.
Dialogue: 0,0:02:29.09,0:02:30.09,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:31.01,0:02:33.00,Default,,0,0,0,,Мен есінен танып қалдым деп ойлаймын.
Dialogue: 0,0:02:33.00,0:02:34.05,Default,,0,0,0,,Ей, мықты бол.
Dialogue: 0,0:02:34.07,0:02:36.02,Default,,0,0,0,,Ол қатты жараланған еді...
Dialogue: 0,0:02:37.02,0:02:38.04,Default,,0,0,0,,Ах Нана-сан
Dialogue: 0,0:02:46.00,0:02:48.05,Default,,0,0,0,,Нана, бұл жерде ештеңе жоқ.
Dialogue: 0,0:02:49.00,0:02:50.07,Default,,0,0,0,,Бұл жерде ештеңе жоқ
Dialogue: 0,0:03:02.06,0:03:04.06,Default,,0,0,0,,Мен сөмкемді ұмытып кетіппін.
Dialogue: 0,0:03:05.01,0:03:05.51,Default,,0,0,0,,Бетіңде әлі де сол мұңды кейіп бар.
Dialogue: 0,0:03:06.06,0:03:07.09,Default,,0,0,0,,Мен Маюды жек көремін
Dialogue: 0,0:03:08.01,0:03:10.00,Default,,0,0,0,,Бәріміз Нананы жаман жігіт қылайық
Dialogue: 0,0:03:10.00,0:03:11.00,Default,,0,0,0,,Жібер
Dialogue: 0,0:03:11.04,0:03:12.07,Default,,0,0,0,,Бұл өте жауапсыздық.
Dialogue: 0,0:03:12.07,0:03:13.04,Default,,0,0,0,,Егер сіз жіберсеңіз
Dialogue: 0,0:03:27.00,0:03:31.01,Default,,0,0,0,,Нана-сан кінәлі емес пе, күтпеген жерден Ню-санға осындай әрекет жасағаны үшін?
Dialogue: 0,0:03:31.01,0:03:34.01,Default,,0,0,0,,Өйткені ол адам шынымен жаман адам.
Dialogue: 0,0:03:34.04,0:03:39.07,Default,,0,0,0,,Ум, сен Нюу-санды Люси-сан деп атадың, солай ма?
Dialogue: 0,0:04:18.02,0:04:20.04,Default,,0,0,0,,Мен енді ешқашан мұндайды мінбеймін.
Dialogue: 0,0:04:20.08,0:04:22.02,Default,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:04:29.08,0:04:33.04,Default,,0,0,0,,Неліктен мен мұндай нәрсені жеткізу үшін қиындыққа баруым керек?
Dialogue: 0,0:04:33.08,0:04:36.00,Default,,0,0,0,,Бұл жай ғана келіп алып кету емес.
Dialogue: 0,0:04:40.02,0:04:42.05,Default,,0,0,0,,Бұл ұрлау емес.
Dialogue: 0,0:04:45.05,0:04:48.01,Default,,0,0,0,,Жуынғаныма неше күн болды?
Dialogue: 0,0:04:51.06,0:04:53.02,Default,,0,0,0,,Директор Кадозава сізді күтуде.
Dialogue: 0,0:04:59.01,0:05:00.01,Default,,0,0,0,,Әрине
Dialogue: 0,0:05:01.03,0:05:02.08,Default,,0,0,0,,Бұл оны шешер еді.
Dialogue: 0,0:05:03.03,0:05:04.08,Default,,0,0,0,,Үйге тез келе аласыз ба?
Dialogue: 0,0:05:06.00,0:05:06.50,Default,,0,0,0,,Going home?
Dialogue: 0,0:05:07.02,0:05:10.02,Default,,0,0,0,,Егер бұл рас болса, мен көңіл айтар едім.
Dialogue: 0,0:05:10.06,0:05:14.01,Default,,0,0,0,,Бірақ мені де күтпеген жерден осындай жерге шақырды.
Dialogue: 0,0:05:14.06,0:05:17.05,Default,,0,0,0,,Көңіл айту керек сенсің.
Dialogue: 0,0:05:21.05,0:05:23.05,Default,,0,0,0,,Na. . . What a moment
Dialogue: 0,0:05:23.05,0:05:25.09,Default,,0,0,0,,Бұл қауіпті, сондықтан оны қойыңыз.
Dialogue: 0,0:05:28.02,0:05:30.09,Default,,0,0,0,,Эй, бұл жай әрекет емес.
Dialogue: 0,0:05:31.02,0:05:32.09,Default,,0,0,0,,You saw this
Dialogue: 0,0:05:32.09,0:05:34.04,Default,,0,0,0,,Бұл мүйізді білдіре ме?
Dialogue: 0,0:05:34.04,0:05:38.07,Default,,0,0,0,,Сондықтан мен сені тірі қалдыра алмаймын.
Dialogue: 0,0:05:39.07,0:05:40.09,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:05:45.03,0:05:49.03,Default,,0,0,0,,That's a lie.
Dialogue: 0,0:05:49.08,0:05:54.02,Default,,0,0,0,,Рас, институттан қашып, Савадағы адамдарды өлтір.
Dialogue: 0,0:05:54.09,0:05:57.07,Default,,0,0,0,,Іздеп келген мүшелерім де сондай.
Dialogue: 0,0:05:58.08,0:06:01.06,Default,,0,0,0,,Мен бұған сене алмаймын.
Dialogue: 0,0:06:13.00,0:06:15.09,Default,,0,0,0,,Біз қарапайым адамдар емеспіз.
Dialogue: 0,0:06:16.03,0:06:17.08,Default,,0,0,0,,Олардың мүйізі ғана емес
Dialogue: 0,0:06:23.04,0:06:24.02,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:06:25.01,0:06:26.03,Default,,0,0,0,,Ах, сонда ол ма еді?
Dialogue: 0,0:06:33.06,0:06:35.08,Default,,0,0,0,,Ho. . . I really hit it
Dialogue: 0,0:06:38.07,0:06:40.05,Default,,0,0,0,,Өлгің келмейді
Dialogue: 0,0:06:41.02,0:06:43.06,Default,,0,0,0,,Менен анық нәрсені сұрама
Dialogue: 0,0:06:43.06,0:06:45.06,Default,,0,0,0,,А, тым көп қан.
Dialogue: 0,0:06:46.01,0:06:48.09,Default,,0,0,0,,Олай болса, менің артымнан мойынсұнып жүр.
Dialogue: 0,0:06:51.03,0:06:53.05,Default,,0,0,0,,Алдымен сұрағыңызға жауап берейін.
Dialogue: 0,0:06:55.05,0:06:56.07,Default,,0,0,0,,Екіншісі кім?
Dialogue: 0,0:06:57.06,0:06:58.06,Default,,0,0,0,,Не туралы сөйлесу керек
Dialogue: 0,0:06:59.00,0:07:01.06,Default,,0,0,0,,Менің баламның денесін көрген ол.
Dialogue: 0,0:07:01.07,0:07:05.00,Default,,0,0,0,,Оқиға орнында сізден басқа іздер расталды.
Dialogue: 0,0:07:05.08,0:07:08.07,Default,,0,0,0,,Әлбетте, тағы бір адам болды.
Dialogue: 0,0:07:09.03,0:07:11.09,Default,,0,0,0,,Мұғалімге қонаққа келген оқушы.
Dialogue: 0,0:07:12.04,0:07:13.03,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:07:13.04,0:07:16.07,Default,,0,0,0,,Осындай оқиғадан кейін мен оның бетін де жақсы есіме түсірмеймін.
Dialogue: 0,0:07:17.07,0:07:19.03,Default,,0,0,0,,Әсіресе аты
Dialogue: 0,0:07:20.04,0:07:21.06,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:07:24.01,0:07:27.03,Default,,0,0,0,,Соңғы кезде Рюкті көрмеппін, иә?
Dialogue: 0,0:07:27.06,0:07:31.00,Default,,0,0,0,,Ұлымнан оның тамаша ғалым екенін естідім.
Dialogue: 0,0:07:39.02,0:07:40.06,Default,,0,0,0,,қоғамдық бейбітшілік хатын алмастыру үшін, иә?
Dialogue: 0,0:07:41.09,0:07:46.09,Default,,0,0,0,,Мұғалімімен қалдырған қызды іздеп келді.
Dialogue: 0,0:07:47.06,0:07:49.02,Default,,0,0,0,,Қыз болса ше?
Dialogue: 0,0:07:49.02,0:07:54.03,Default,,0,0,0,,Біз кеткенде ол жоқ еді.
Dialogue: 0,0:07:55.08,0:07:59.08,Default,,0,0,0,,Мен қалай шіримін мұндай жерде, әлі тың?
Dialogue: 0,0:08:01.00,0:08:04.05,Default,,0,0,0,,Сіз мұнымен мүлдем келісесіз бе? . .
Dialogue: 0,0:08:12.04,0:08:13.05,Default,,0,0,0,,Ширакава
Dialogue: 0,0:08:13.08,0:08:14.07,Default,,0,0,0,,Иә
Dialogue: 0,0:08:17.03,0:08:18.04,Default,,0,0,0,,Director's office
Dialogue: 0,0:08:18.08,0:08:19.07,Default,,0,0,0,,Жедел медициналық бригада
Dialogue: 0,0:08:21.00,0:08:23.06,Default,,0,0,0,,Will you help me?
Dialogue: 0,0:08:23.06,0:08:26.07,Default,,0,0,0,,Дегенмен, мен сізден ынтымақтастық сұраймын.
Dialogue: 0,0:08:30.01,0:08:32.00,Default,,0,0,0,,Ұлымның атынан.
Dialogue: 0,0:08:36.01,0:08:39.09,Default,,0,0,0,,Біз туылғаннан бері қолымыз сенен басқа.
Dialogue: 0,0:08:40.04,0:08:41.02,Default,,0,0,0,,Hand?
Dialogue: 0,0:08:59.02,0:09:00.06,Default,,0,0,0,,Бұл қолдың төрт қолы бар.
Dialogue: 0,0:09:01.03,0:09:05.04,Default,,0,0,0,,Сондықтан Нана әкесі берген аяқ-қолдарды қозғалта алады.
Dialogue: 0,0:09:07.08,0:09:10.05,Default,,0,0,0,,Бұл арман емес еді.
Dialogue: 0,0:09:11.08,0:09:14.03,Default,,0,0,0,,Е, әлгі қарт не деді.
Dialogue: 0,0:09:16.02,0:09:17.02,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:09:17.07,0:09:20.05,Default,,0,0,0,,Бірақ Нана Люсиден өзгеше.
Dialogue: 0,0:09:20.08,0:09:22.03,Default,,0,0,0,,Ештеңе мүлдем жаман емес
Dialogue: 0,0:09:25.01,0:09:27.06,Default,,0,0,0,,Мұны маған әкем жасырын айтты.
Dialogue: 0,0:09:27.06,0:09:30.01,Default,,0,0,0,,Мен сөйлегеннен кейін не істеуім керек?
Dialogue: 0,0:09:30.01,0:09:31.05,Default,,0,0,0,,Ah. . . Бұл
Dialogue: 0,0:09:32.04,0:09:33.02,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:09:33.04,0:09:36.02,Default,,0,0,0,,Ню-сан мүлде жаман адам емес.
Dialogue: 0,0:09:36.04,0:09:40.06,Default,,0,0,0,,Өмір қарапайым, адал және қызықты.
Dialogue: 0,0:09:41.03,0:09:44.00,Default,,0,0,0,,Бірге, соңына дейін көңіл көтереміз.
Dialogue: 0,0:09:47.07,0:09:52.01,Default,,0,0,0,,That. . . Мен ешқашан қолды пайдаланған емеспін.
Dialogue: 0,0:09:52.06,0:09:56.03,Default,,0,0,0,,It's true. Ню-сан мен Нана-сан сен айтып отырған нәрсеге мүлдем ұқсамайды. . .
Dialogue: 0,0:09:56.06,0:09:57.07,Default,,0,0,0,,I wonder why
Dialogue: 0,0:09:59.05,0:10:02.06,Default,,0,0,0,,Бұл адам Люси екені сөзсіз.
Dialogue: 0,0:10:04.02,0:10:06.07,Default,,0,0,0,,Мен ешқандай қатысуды сезе алмаймын.
Dialogue: 0,0:10:08.06,0:10:11.05,Default,,0,0,0,,Ол Нана білетін Люси-саннан өзгеше.
Dialogue: 0,0:10:12.02,0:10:17.01,Default,,0,0,0,,Бірақ енді оны оңай басқаша атауға болады.
Dialogue: 0,0:10:18.01,0:10:19.01,Default,,0,0,0,,Nana-san
Dialogue: 0,0:10:20.05,0:10:23.02,Default,,0,0,0,,Мен білмеймін, білмеймін
Dialogue: 0,0:10:24.00,0:10:27.02,Default,,0,0,0,,Сіз қарсы алмайтын адаммен күресе алмайсыз.
Dialogue: 0,0:10:28.01,0:10:31.01,Default,,0,0,0,,Әке, мен не істеуім керек?
Dialogue: 0,0:10:31.09,0:10:33.02,Default,,0,0,0,,Nana-san
Dialogue: 0,0:10:40.04,0:10:41.07,Default,,0,0,0,,Дене қызуы көтерілмейді.
Dialogue: 0,0:10:41.07,0:10:42.06,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:10:42.08,0:10:45.05,Default,,0,0,0,,Тек ұрып-соғудан болмаған сияқты.
Dialogue: 0,0:10:45.08,0:10:48.03,Default,,0,0,0,,Егер ауырып жатсаңыз, мен сізді ауруханаға апаруым керек.
Dialogue: 0,0:10:50.00,0:10:52.08,Default,,0,0,0,,Мүйізі бар адамдар бірден оқшауланады.
Dialogue: 0,0:10:53.05,0:10:54.02,Default,,0,0,0,,Then
Dialogue: 0,0:10:54.08,0:10:56.05,Default,,0,0,0,,But the hospital
Dialogue: 0,0:11:02.03,0:11:03.08,Default,,0,0,0,,Nyu-chan woke up
Dialogue: 0,0:11:04.01,0:11:08.02,Default,,0,0,0,,Жақсы, мені түсіне аласың ба?
Dialogue: 0,0:11:10.04,0:11:11.00,Default,,0,0,0,,Кота
Dialogue: 0,0:11:12.09,0:11:14.01,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:11:17.03,0:11:19.04,Default,,0,0,0,,Нана-сан, не болды?
Dialogue: 0,0:11:24.01,0:11:25.02,Default,,0,0,0,,оянды
Dialogue: 0,0:11:26.03,0:11:30.02,Default,,0,0,0,,Ол профессор Какузаваның көмекшісі болса да, оның мұнда бөгде адамды әкелгеніне сене алар емеспін.
Dialogue: 0,0:11:31.06,0:11:33.06,Default,,0,0,0,,Комиссар не істейді?
Dialogue: 0,0:11:34.00,0:11:37.06,Default,,0,0,0,,Ол ұлының зерттеуі туралы бәрін біледі.
Dialogue: 0,0:11:38.02,0:11:40.03,Default,,0,0,0,,Ретровирусқа қарсы вакцина жасау
Dialogue: 0,0:11:41.00,0:11:43.02,Default,,0,0,0,,Бұл сыртқы агенттікпен мүмкін болуы керек
Dialogue: 0,0:11:44.01,0:11:45.08,Default,,0,0,0,,Вакцина.
Dialogue: 0,0:11:47.08,0:11:50.07,Default,,0,0,0,,Менің қалағаным вакцина емес
Dialogue: 0,0:11:51.02,0:11:53.01,Default,,0,0,0,,Бұл вирустың өзі.
Dialogue: 0,0:11:53.06,0:11:57.00,Default,,0,0,0,,Мен сіздің ниетіңізді өлшей алмаймын, бірақ
Dialogue: 0,0:11:57.06,0:12:02.06,Default,,0,0,0,,Жоғарғы жағында Люси бар жаңа адамзат нәсілінің қайта туылуын жоспарлау
Dialogue: 0,0:12:03.04,0:12:05.07,Default,,0,0,0,,Хатшы, сіз бе?
Dialogue: 0,0:12:06.05,0:12:11.00,Default,,0,0,0,,Адам түрі міндетті түрде өзінің соңына қарай бет алады.
Dialogue: 0,0:12:11.04,0:12:13.01,Default,,0,0,0,,Жоқ, мен өтуім керек.
Dialogue: 0,0:12:14.00,0:12:17.02,Default,,0,0,0,,Люсидің әлемге келуі – соның дәлелі.
Dialogue: 0,0:12:18.07,0:12:21.04,Default,,0,0,0,,Мен Құдайдың өкілімін
Dialogue: 0,0:12:21.04,0:12:22.04,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:23.02,0:12:24.08,Default,,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:12:24.08,0:12:26.08,Default,,0,0,0,,Мені қате түсінбеңіз Курама
Dialogue: 0,0:12:27.05,0:12:30.00,Default,,0,0,0,,Маған қарызыңды ұмыттың ба?
Dialogue: 0,0:12:31.00,0:12:34.04,Default,,0,0,0,,Сен маған адал болуың керек.
Dialogue: 0,0:12:36.01,0:12:38.02,Default,,0,0,0,,7 санының қашып кетуіне жол бергеніңізді естідім.
Dialogue: 0,0:12:39.05,0:12:45.02,Default,,0,0,0,,7 нөмірін өңдеу және Люсиді түсіру үшін 35 санын пайдаланыңыз
Dialogue: 0,0:12:47.02,0:12:51.08,Default,,0,0,0,,Жақсылығымның кесірінен бағынбаудың күнәларын оқимын ба?
Dialogue: 0,0:12:54.09,0:12:57.05,Default,,0,0,0,,Нюу Бір жері ауырып тұр ма?
Dialogue: 0,0:13:06.02,0:13:07.08,Default,,0,0,0,,Әй, қайда барасың?
Dialogue: 0,0:13:13.08,0:13:15.08,Default,,0,0,0,,Менің жадым әлі күнге дейін.
Dialogue: 0,0:13:22.01,0:13:23.03,Default,,0,0,0,,Бұл дәретхана ма?
Dialogue: 0,0:13:28.00,0:13:29.07,Default,,0,0,0,,Дәретхана ол жақта емес шығар.
Dialogue: 0,0:13:30.02,0:13:32.05,Default,,0,0,0,,Ақымақ қызды өлтіру
Dialogue: 0,0:13:36.08,0:13:38.03,Default,,0,0,0,,Сен ақымақсың
Dialogue: 0,0:13:38.06,0:13:40.07,Default,,0,0,0,,Сізге тыныш ұйықтау керек.
Dialogue: 0,0:13:42.04,0:13:43.01,Default,,0,0,0,,Кота
Dialogue: 0,0:13:47.06,0:13:50.00,Default,,0,0,0,,Жарайды, мен үйден дәрі алып келейін.
Dialogue: 0,0:13:51.00,0:13:53.02,Default,,0,0,0,,Тек жылуды салқындату қажет болса
Dialogue: 0,0:13:53.03,0:13:54.05,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:13:55.00,0:13:56.03,Default,,0,0,0,,Олай болса, өтінемін.
Dialogue: 0,0:13:56.03,0:13:57.07,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:13:57.09,0:14:00.09,Default,,0,0,0,,Ню-чан, енді тентектік жасама.
Dialogue: 0,0:14:16.08,0:14:18.01,Default,,0,0,0,,Себебі мен сенімен біргемін.
Dialogue: 0,0:14:18.04,0:14:19.09,Default,,0,0,0,,Ұйқыларыңыз тыныш болсын
Dialogue: 0,0:14:22.03,0:14:24.05,Default,,0,0,0,,Жылу тез суып кетуі керек.
Dialogue: 0,0:14:26.08,0:14:28.06,Default,,0,0,0,,Тез суытайық.
Dialogue: 0,0:14:51.03,0:14:53.02,Default,,0,0,0,,Баланың қызуы тағы көтерілді.
Dialogue: 0,0:14:53.05,0:14:55.00,Default,,0,0,0,,Мен сізден жеңіл болғаныңызды қалаймын.
Dialogue: 0,0:14:55.07,0:14:58.04,Default,,0,0,0,,Осыдан кейін менің уәдем бар еді.
Dialogue: 0,0:14:58.09,0:15:00.06,Default,,0,0,0,,Балаға мүлдем ұқсамайды
Dialogue: 0,0:15:00.06,0:15:01.09,Default,,0,0,0,,Жарық шіркін.
Dialogue: 0,0:15:02.04,0:15:03.09,Default,,0,0,0,,Және сол мүйіздер сияқты.
Dialogue: 0,0:15:04.03,0:15:05.02,Default,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:15:07.09,0:15:11.00,Default,,0,0,0,,Басқа балалар да бір бөлмеде болғысы келмейді.
Dialogue: 0,0:15:48.04,0:15:50.02,Default,,0,0,0,,Сіз уайымдап тұрсыз ба?
Dialogue: 0,0:15:51.03,0:15:54.03,Default,,0,0,0,,Ештеңе емес, жалғыздыққа үйреніп қалғанмын.
Dialogue: 0,0:15:54.07,0:15:56.06,Default,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,0:15:58.00,0:16:01.06,Default,,0,0,0,,Себебі мен өзімді жалғыз сезінбеймін
Dialogue: 0,0:16:04.00,0:16:06.00,Default,,0,0,0,,Эй, Кадо, бұл сенсің.
Dialogue: 0,0:16:06.04,0:16:10.00,Default,,0,0,0,,Ол сөмкемен не істеп жатырсың?
Dialogue: 0,0:16:10.04,0:16:12.07,Default,,0,0,0,,Сүт басып, сасық.
Dialogue: 0,0:16:13.08,0:16:16.00,Default,,0,0,0,,Сізге тек жауап беру керек.
Dialogue: 0,0:16:23.02,0:16:27.02,Default,,0,0,0,,Мен сізді орманды жерге тастап кеткенін естідім.
Dialogue: 0,0:16:27.05,0:16:30.02,Default,,0,0,0,,Жарайды, мүйіз өссе, лақтыруға болады.
Dialogue: 0,0:16:37.09,0:16:42.00,Default,,0,0,0,,Сен адам емессің, жынның баласысың.
Dialogue: 0,0:16:42.08,0:16:45.08,Default,,0,0,0,,Мұғалімдер бір-бірін ұнатпайтындарын айтып жатыр.
Dialogue: 0,0:16:53.08,0:16:56.06,Default,,0,0,0,,Мұғалім, Томоо сені тағы қорқытып жатыр.
Dialogue: 0,0:16:56.06,0:16:58.00,Default,,0,0,0,,Жоқ, қашайық.
Dialogue: 0,0:17:00.08,0:17:03.00,Default,,0,0,0,,Қызды қорлау - ең жаманы
Dialogue: 0,0:17:03.04,0:17:04.09,Default,,0,0,0,,Әй, жарайды.
Dialogue: 0,0:17:07.02,0:17:09.01,Default,,0,0,0,,Менің сөмкем сүтпен жабылған.
Dialogue: 0,0:17:10.03,0:17:12.00,Default,,0,0,0,,Қорқынышты істермен айналыспаңыз
Dialogue: 0,0:17:12.08,0:17:15.01,Default,,0,0,0,,Мұндағы балалардың бәрі бақытсыз.
Dialogue: 0,0:17:15.08,0:17:17.01,Default,,0,0,0,,Не?
Dialogue: 0,0:17:17.09,0:17:22.00,Default,,0,0,0,,Мен бақытсыз болғандықтан, маған менен қарағанда бақытсыз адам керек сияқты.
Dialogue: 0,0:17:24.05,0:17:25.05,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:17:30.01,0:17:32.04,Default,,0,0,0,,Қазір кептірсем жарай ма?
Dialogue: 0,0:17:32.08,0:17:35.08,Default,,0,0,0,,Ей, үнемі жалғыз қалма.
Dialogue: 0,0:17:36.05,0:17:40.00,Default,,0,0,0,,Егер қиналсаңыз, маған бірдеңе айтыңыз.
Dialogue: 0,0:17:40.05,0:17:42.03,Default,,0,0,0,,Бұл сізге көмектесетініне сенімдімін
Dialogue: 0,0:18:00.08,0:18:03.02,Default,,0,0,0,,Сіз қатты аш болған шығарсыз.
Dialogue: 0,0:18:06.09,0:18:12.05,Default,,0,0,0,,Сен болмасаң, мен баяғыда бас тартқан болар едім.
Dialogue: 0,0:18:16.07,0:18:20.03,Default,,0,0,0,,Кешіріңіз, сізді тамақтандыратын басқа ештеңем жоқ.
Dialogue: 0,0:18:22.09,0:18:25.07,Default,,0,0,0,,Мектептегі түскі астың жартысы жетпейді ғой.
Dialogue: 0,0:18:30.01,0:18:32.06,Default,,0,0,0,,Аш болсаң да, барма
Dialogue: 0,0:18:33.02,0:18:35.01,Default,,0,0,0,,Тіпті сізді қорлайды
Dialogue: 0,0:18:36.07,0:18:41.06,Default,,0,0,0,,Мен күштірек болсам, сені қорғай алар едім.
Dialogue: 0,0:18:45.04,0:18:47.02,Default,,0,0,0,,Ол күштірек болса
Dialogue: 0,0:19:11.04,0:19:18.02,Default,,0,0,0,,Ішімде тағы бірдеңе торға түскендей болды.
Dialogue: 0,0:19:33.00,0:19:33.50,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:19:35.01,0:19:36.06,Default,,0,0,0,,Консультация бар.
Dialogue: 0,0:19:38.01,0:19:40.03,Default,,0,0,0,,Керемет, менің итім бар.
Dialogue: 0,0:19:40.03,0:19:42.05,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:19:42.06,0:19:45.03,Default,,0,0,0,,Егер Тому мен басқалары білсе, сені қорлайды.
Dialogue: 0,0:19:47.02,0:19:50.08,Default,,0,0,0,,Жарайды, мен сендермен мектептегі түскі асымды бөлісемін.
Dialogue: 0,0:19:51.02,0:19:52.06,Default,,0,0,0,,Мен оны үнемі артта қалдырамын.
Dialogue: 0,0:19:54.04,0:19:56.00,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:19:56.02,0:19:57.05,Default,,0,0,0,,Бұл туралы ешкім білмеуі керек.
Dialogue: 0,0:19:57.05,0:20:01.02,Default,,0,0,0,,Иә, мен ешкімге айтпаймын, уайымдамаңыз.
Dialogue: 0,0:20:09.08,0:20:10.08,Default,,0,0,0,,Дос бұрыш
Dialogue: 0,0:20:12.07,0:20:14.06,Default,,0,0,0,,Сіз сондай тәкаппарсыз.
Dialogue: 0,0:20:14.08,0:20:16.04,Default,,0,0,0,,Мен адам болмасам да
Dialogue: 0,0:20:20.00,0:20:21.00,Default,,0,0,0,,Балалар
Dialogue: 0,0:20:24.05,0:20:26.06,Default,,0,0,0,,Жібер, тоқтат.
Dialogue: 0,0:20:26.08,0:20:30.02,Default,,0,0,0,,Мен сенің бұлай ренжігеніңді бірінші рет көріп тұрмын.
Dialogue: 0,0:20:30.02,0:20:34.02,Default,,0,0,0,,Жылауға да, күлуге де болмайды, бұл қорқынышты.
Dialogue: 0,0:20:34.06,0:20:37.03,Default,,0,0,0,,Жыла, жыла және жалбар.
Dialogue: 0,0:20:37.08,0:20:41.07,Default,,0,0,0,,Әйтпесе, сіздің орныңызда итіңіз қиналады.
Dialogue: 0,0:20:44.09,0:20:46.01,Default,,0,0,0,,Бұл. . . Бұл
Dialogue: 0,0:20:46.08,0:20:48.08,Default,,0,0,0,,Эй, мына итті теп!
Dialogue: 0,0:20:48.08,0:20:49.04,Default,,0,0,0,,Тоқта
Dialogue: 0,0:20:54.03,0:20:58.04,Default,,0,0,0,,тікелей қорқытуға қарағанда тиімдірек.
Dialogue: 0,0:21:02.06,0:21:03.08,Default,,0,0,0,,Мен сені ұстап тұрмын.
Dialogue: 0,0:21:16.00,0:21:18.07,Default,,0,0,0,,Бұл өтірік.
Dialogue: 0,0:21:19.02,0:21:21.07,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:22.06,0:21:23.05,Default,,0,0,0,,Тоқта
Dialogue: 0,0:21:24.01,0:21:27.02,Default,,0,0,0,,Не дедіңіз?
Dialogue: 0,0:21:28.05,0:21:29.08,Default,,0,0,0,,Өйткені, өйткені
Dialogue: 0,0:21:30.06,0:21:32.04,Default,,0,0,0,,Сенің бұлай істеп жатқаныңа сене алар емеспін.
Dialogue: 0,0:21:37.08,0:21:40.09,Default,,0,0,0,,Кешіріңіз, мен байқаусызда сөйледім.
Dialogue: 0,0:21:43.05,0:21:46.00,Default,,0,0,0,,Ол жұмысын тоқтатты.
Dialogue: 0,0:21:47.05,0:21:48.04,Default,,0,0,0,,Тым ерте
Dialogue: 0,0:21:52.02,0:21:53.09,Default,,0,0,0,,Өйткені мен бақытсызмын
Dialogue: 0,0:21:54.08,0:21:59.05,Default,,0,0,0,,Менің ойымша, маған менен бақытсыз нәрсе керек.
Dialogue: 0,0:22:00.04,0:22:04.02,Default,,0,0,0,,Адам емес нәрсе адам емес
Dialogue: 0,0:22:05.09,0:22:07.04,Default,,0,0,0,,Бұл сендерсіңдер, балалар.
Dialogue: 0,0:22:32.08,0:22:33.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:34.01,0:22:35.04,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:22:36.06,0:22:41.01,Default,,0,0,0,,Неліктен мен басқалардан аздап ерекшеленетіндіктен, мұны бастан өткеруім керек?
Dialogue: 0,0:22:41.08,0:22:42.07,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:24:35.03,0:24:37.01,Default,,0,0,0,,Айналуды тоқтатпай
Dialogue: 0,0:24:37.06,0:24:40.07,Default,,0,0,0,,Бірақ ешқашан торға қосылмайды
Dialogue: 0,0:24:42.00,0:24:44.00,Default,,0,0,0,,Тіпті жарық сәулесі де жарқырайды
Dialogue: 0,0:24:44.03,0:24:47.05,Default,,0,0,0,,Ол тек тамақ іздеуге баса назар аударды.
Dialogue: 0,0:24:48.07,0:24:50.00,Default,,0,0,0,,Бұл жады
Dialogue: 0,0:24:50.04,0:24:53.05,Default,,0,0,0,,Қызға қандай мағына берді?
Dialogue: 0,0:24:54.08,0:24:57.00,Default,,0,0,0,,Келесі жолы Эльфен өтірік айтты 9-бөлім
Dialogue: 0,0:24:57.04,0:24:58.04,Default,,0,0,0,,Естеліктер
Dialogue: 0,0:24:59.54,0:25:04.54,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
