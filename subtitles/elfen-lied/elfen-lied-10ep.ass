Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:18.01,Default,,0,0,0,,Os iusti meditabitur sapientiam,
Dialogue: 0,0:00:18.01,0:00:27.02,Default,,0,0,0,,Et lingua eius loquetur indicium.
Dialogue: 0,0:00:27.02,0:00:38.05,Default,,0,0,0,,Beatus vir qui азап шегеді,
Dialogue: 0,0:00:38.05,0:00:49.01,Default,,0,0,0,,Quoniqm cum probaes fuerit accipient coronam vitae.
Dialogue: 0,0:00:49.01,0:01:02.02,Default,,0,0,0,,Кири, ignis divine, eleison.
Dialogue: 0,0:01:02.06,0:01:13.07,Default,,0,0,0,,О quam sancta, quam serena,
Dialogue: 0,0:01:13.07,0:01:28.03,Default,,0,0,0,,Куам-беигма, квам амоена,
Dialogue: 0,0:01:38.04,0:01:39.09,Default,,0,0,0,,Ню-сан, болды. . .
Dialogue: 0,0:01:42.06,0:01:43.04,Default,,0,0,0,,Ню-сан
Dialogue: 0,0:01:43.07,0:01:45.07,Default,,0,0,0,,Маюға тиіспе
Dialogue: 0,0:01:47.08,0:01:49.01,Default,,0,0,0,,Сіз әлі де кетуді жоспарлап жүрсіз бе?
Dialogue: 0,0:01:50.03,0:01:51.07,Default,,0,0,0,,Ән тұрмаса да
Dialogue: 0,0:01:54.01,0:01:55.04,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:02:01.00,0:02:01.50,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:02:03.03,0:02:03.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:04.01,0:02:05.00,Default,,0,0,0,,Маған көрсет
Dialogue: 0,0:02:05.02,0:02:06.04,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:02:06.05,0:02:08.08,Default,,0,0,0,,Жоқ, мен Басонконы қоюым керек.
Dialogue: 0,0:02:09.06,0:02:12.04,Default,,0,0,0,,Мен пиязды өзімнің көңілімнен шығатындай етіп турай алмаймын.
Dialogue: 0,0:02:12.09,0:02:13.06,Default,,0,0,0,,Масқара
Dialogue: 0,0:02:14.03,0:02:15.05,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:02:18.04,0:02:20.04,Default,,0,0,0,,Сондықтан мен мұны істей алмаймын дедім.
Dialogue: 0,0:02:22.02,0:02:23.01,Default,,0,0,0,,Не?
Dialogue: 0,0:02:35.06,0:02:37.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:43.07,0:02:46.03,Default,,0,0,0,,Мені өлтірмек ойың соншама?
Dialogue: 0,0:02:47.00,0:02:48.02,Default,,0,0,0,,Маю қашып кетеді
Dialogue: 0,0:02:52.09,0:02:53.07,Default,,0,0,0,,Баруға болады
Dialogue: 0,0:02:56.01,0:02:57.03,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:03:03.02,0:03:03.52,Default,,0,0,0,,Бұл
Dialogue: 0,0:03:05.04,0:03:07.04,Default,,0,0,0,,Сәлем Кота
Dialogue: 0,0:03:07.09,0:03:09.02,Default,,0,0,0,,Ню-чан мұнда жоқ.
Dialogue: 0,0:03:10.00,0:03:10.50,Default,,0,0,0,,Не болса да
Dialogue: 0,0:03:18.00,0:03:18.50,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:03:19.04,0:03:22.06,Default,,0,0,0,,Мұндай нәрсе Мұндай нәрсе
Dialogue: 0,0:03:24.02,0:03:25.03,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:03:25.06,0:03:27.08,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:03:28.08,0:03:31.03,Default,,0,0,0,,Ню-сан, қазір әдейі.
Dialogue: 0,0:03:38.00,0:03:39.07,Default,,0,0,0,,Бәсекелестік жоқ
Dialogue: 0,0:03:40.09,0:03:41.08,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:03:42.08,0:03:45.05,Default,,0,0,0,,Ню-сан, доғар енді.
Dialogue: 0,0:03:47.04,0:03:48.08,Default,,0,0,0,,Юкине, сонда ісіңді бітірген соң дүкенге бар.
Dialogue: 0,0:03:51.02,0:03:52.02,Default,,0,0,0,,Ню-сан
Dialogue: 0,0:03:52.05,0:03:53.06,Default,,0,0,0,,. . . не
Dialogue: 0,0:03:53.07,0:03:54.07,Default,,0,0,0,,Ню-чан
Dialogue: 0,0:03:55.03,0:03:56.02,Default,,0,0,0,,Сіз не істеп жүрсіз?
Dialogue: 0,0:03:56.06,0:03:57.05,Default,,0,0,0,,Осындай жерде
Dialogue: 0,0:03:58.08,0:03:59.06,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:04:01.09,0:04:02.08,Default,,0,0,0,,Кота
Dialogue: 0,0:04:02.08,0:04:04.06,Default,,0,0,0,,Менің де қызуым төмендеген жоқ.
Dialogue: 0,0:04:06.00,0:04:08.07,Default,,0,0,0,,Кота Маған Кота ұнайды
Dialogue: 0,0:04:09.00,0:04:10.01,Default,,0,0,0,,Маған Кота ұнайды
Dialogue: 0,0:04:10.06,0:04:13.00,Default,,0,0,0,,Кота Кота
Dialogue: 0,0:04:15.07,0:04:17.08,Default,,0,0,0,,Міне, дәл қазір. . .
Dialogue: 0,0:04:18.01,0:04:20.06,Default,,0,0,0,,Кота-сан және басқалары таң қалады.
Dialogue: 0,0:04:24.02,0:04:26.09,Default,,0,0,0,,Бұл енді Люси емес.
Dialogue: 0,0:04:32.08,0:04:34.02,Default,,0,0,0,,Менде тек ботқа бар.
Dialogue: 0,0:04:38.04,0:04:41.00,Default,,0,0,0,,Ұялма, көптен бері тамақ ішкен жоқсың.
Dialogue: 0,0:04:41.01,0:04:42.00,Default,,0,0,0,,Жаңа
Dialogue: 0,0:04:44.04,0:04:47.05,Default,,0,0,0,,Аз ғана.
Dialogue: 0,0:04:54.07,0:04:56.01,Default,,0,0,0,,Маю-чанның досы?
Dialogue: 0,0:04:56.06,0:04:57.09,Default,,0,0,0,,. . . иә
Dialogue: 0,0:04:58.04,0:05:00.05,Default,,0,0,0,,Нана-сан менің досым
Dialogue: 0,0:05:01.03,0:05:04.00,Default,,0,0,0,,Мен сияқты менің де қайтатын жерім жоқ.
Dialogue: 0,0:05:04.06,0:05:07.02,Default,,0,0,0,,Одан гөрі неге бірінші Нюу туралы айттыңыз?
Dialogue: 0,0:05:07.03,0:05:10.08,Default,,0,0,0,,Мм, Нана-санның қарны ашып, уайымдады.
Dialogue: 0,0:05:11.08,0:05:14.05,Default,,0,0,0,,Нана-сан тамақ ішкенде жақсы қыз.
Dialogue: 0,0:05:14.06,0:05:18.06,Default,,0,0,0,,Мен жаңа ғана кешкі ас әзірлеп жатыр едім.
Dialogue: 0,0:05:20.05,0:05:22.06,Default,,0,0,0,,Жарайды, бір адам өссе де
Dialogue: 0,0:05:23.01,0:05:24.08,Default,,0,0,0,,Нана. . .
Dialogue: 0,0:05:29.09,0:05:30.09,Default,,0,0,0,,Ауыстыру
Dialogue: 0,0:05:42.01,0:05:43.00,Default,,0,0,0,,Жаңа
Dialogue: 0,0:05:44.08,0:05:46.09,Default,,0,0,0,,Сіз шынымен аш болған шығарсыз.
Dialogue: 0,0:05:48.00,0:05:48.50,Default,,0,0,0,,ұқсайды
Dialogue: 0,0:05:49.08,0:05:50.06,Default,,0,0,0,,Ауыстыру
Dialogue: 0,0:05:51.07,0:05:53.06,Default,,0,0,0,,Кешіріңіз, ол жоғалды.
Dialogue: 0,0:05:57.00,0:06:00.09,Default,,0,0,0,,Нана-сан, менің қазір тұратын жерім жоқ.
Dialogue: 0,0:06:01.00,0:06:03.02,Default,,0,0,0,,Бүгін түнде қалуыма рұқсат беруімді қалайсыз ба?
Dialogue: 0,0:06:03.06,0:06:05.02,Default,,0,0,0,,Тұратын жеріңіз жоқ па?
Dialogue: 0,0:06:05.04,0:06:09.00,Default,,0,0,0,,Мүйізді адамға қайтатын жер жоқ.
Dialogue: 0,0:06:12.02,0:06:13.00,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:06:14.01,0:06:16.01,Default,,0,0,0,,Менің сізден сұрайын дегенім көп.
Dialogue: 0,0:06:17.02,0:06:19.08,Default,,0,0,0,,Ал, менің үйімде біраз тұрайық.
Dialogue: 0,0:06:19.09,0:06:20.07,Default,,0,0,0,,жақында жолымыз қиылысар.
Dialogue: 0,0:06:22.02,0:06:23.02,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:06:23.04,0:06:26.02,Default,,0,0,0,,Нанаға бәрі жаман адам ретінде қараса да.
Dialogue: 0,0:06:26.02,0:06:27.02,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:06:27.07,0:06:29.08,Default,,0,0,0,,Сен күтпеген жерден Нюуды соғып кеткен шығарсың.
Dialogue: 0,0:06:29.08,0:06:31.02,Default,,0,0,0,,Себебі
Dialogue: 0,0:06:31.02,0:06:32.04,Default,,0,0,0,,Жаңа
Dialogue: 0,0:06:39.06,0:06:40.06,Default,,0,0,0,,Нанаға?
Dialogue: 0,0:06:41.05,0:06:42.03,Default,,0,0,0,,Жаңа
Dialogue: 0,0:06:44.05,0:06:46.02,Default,,0,0,0,,Жаңа сіз
Dialogue: 0,0:06:47.01,0:06:50.02,Default,,0,0,0,,Маю-чан аш болғандықтан ашуланғанын айтты.
Dialogue: 0,0:06:52.03,0:06:55.00,Default,,0,0,0,,Бірақ сіз жеуіңіз керек.
Dialogue: 0,0:06:55.01,0:06:55.51,Default,,0,0,0,,Жаңа ма?
Dialogue: 0,0:06:57.08,0:06:59.04,Default,,0,0,0,,Мен таяқшаларды әлі қойған жоқпын.
Dialogue: 0,0:06:59.06,0:07:00.06,Default,,0,0,0,,Ал ше?
Dialogue: 0,0:07:06.00,0:07:06.50,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:07.07,0:07:08.09,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:11.05,0:07:14.00,Default,,0,0,0,,Кенеттен маған шабуыл жасағанына Нана кінәлі.
Dialogue: 0,0:07:15.00,0:07:16.02,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:20.02,0:07:24.04,Default,,0,0,0,,Мен сенің мейірімділігіңмен мойынсұнбаған күнәларды өтеймін бе?
Dialogue: 0,0:07:29.05,0:07:31.09,Default,,0,0,0,,Сіз оқуды бітіргеннен кейін де осында қаласыз ба?
Dialogue: 0,0:07:32.02,0:07:36.01,Default,,0,0,0,,Аа, мен өз зерттеуімді осында жалғастыра аламын.
Dialogue: 0,0:07:38.02,0:07:40.07,Default,,0,0,0,,Мен басқалардың үндемегенін қалаймын.
Dialogue: 0,0:07:45.06,0:07:46.09,Default,,0,0,0,,Әкемнің зертханасы?
Dialogue: 0,0:07:46.09,0:07:51.00,Default,,0,0,0,,А, мен ұлттық жоба бойынша өте құпия зерттеуді жалғастырып жатырмын.
Dialogue: 0,0:07:51.09,0:07:55.08,Default,,0,0,0,,Бұл өте құпия сияқты және оны тек сенімді адамдар пайдалана алады.
Dialogue: 0,0:07:56.08,0:07:58.02,Default,,0,0,0,,Бұл өте құпия ма? Бұл құпия ма?
Dialogue: 0,0:07:59.02,0:08:01.03,Default,,0,0,0,,Басқа күмәнді оқиғалар жоқ.
Dialogue: 0,0:08:02.00,0:08:03.09,Default,,0,0,0,,Мен сенің күшіңді қалаймын
Dialogue: 0,0:08:04.05,0:08:07.00,Default,,0,0,0,,Кешіріңіз, бірақ менен басқа нәрсе сұраңыз, Кадозава.
Dialogue: 0,0:08:07.06,0:08:08.03,Default,,0,0,0,,Сәлем Курама
Dialogue: 0,0:08:08.08,0:08:11.04,Default,,0,0,0,,Адамзаттың бастауын көргің келмей ме?
Dialogue: 0,0:08:26.06,0:08:27.07,Default,,0,0,0,,Полиция.
Dialogue: 0,0:08:27.07,0:08:29.01,Default,,0,0,0,,Қоршалған
Dialogue: 0,0:08:37.01,0:08:37.51,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:08:45.05,0:08:46.04,Default,,0,0,0,,Қорғау
Dialogue: 0,0:08:47.05,0:08:49.03,Default,,0,0,0,,Жарайды, мен енді қорықпаймын.
Dialogue: 0,0:08:50.06,0:08:52.04,Default,,0,0,0,,Әлі де қорқатын адамдар бар ма?
Dialogue: 0,0:08:55.03,0:08:56.00,Default,,0,0,0,,Интрузия
Dialogue: 0,0:09:00.02,0:09:01.03,Default,,0,0,0,,Ешкім
Dialogue: 0,0:09:02.02,0:09:04.06,Default,,0,0,0,,Не? Басқа жол болмауы керек.
Dialogue: 0,0:09:05.07,0:09:07.06,Default,,0,0,0,,Қорқынышты адамдар қайда болды?
Dialogue: 0,0:09:23.03,0:09:24.03,Default,,0,0,0,,Ату, ату
Dialogue: 0,0:09:36.00,0:09:41.06,Default,,0,0,0,,Осыдан төрт жыл бұрын, негізінен, Канагавада, басының бүйірінде шығыңқы бар әйел дүниеге келген.
Dialogue: 0,0:09:42.06,0:09:44.02,Default,,0,0,0,,Бұл біртүрлі ауру екен, бірақ
Dialogue: 0,0:09:44.05,0:09:47.02,Default,,0,0,0,,Шындығында, бұл оңай болған жоқ.
Dialogue: 0,0:10:02.08,0:10:04.00,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:10:05.03,0:10:06.00,Default,,0,0,0,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,0:10:09.06,0:10:10.09,Default,,0,0,0,,270 Джоуль
Dialogue: 0,0:10:10.09,0:10:11.06,Default,,0,0,0,,Таза
Dialogue: 0,0:10:12.02,0:10:14.00,Default,,0,0,0,,300 джоуль кетеді
Dialogue: 0,0:10:14.07,0:10:17.01,Default,,0,0,0,,Маған ұнамайды Маған ұнамайды
Dialogue: 0,0:10:17.05,0:10:19.01,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:10:20.02,0:10:21.02,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:10:21.04,0:10:23.07,Default,,0,0,0,,Енді оны қаламаймын, тоқтат.
Dialogue: 0,0:10:24.00,0:10:25.08,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:10:28.06,0:10:30.04,Default,,0,0,0,,270-де тоқтайсыз ба?
Dialogue: 0,0:10:31.01,0:10:32.09,Default,,0,0,0,,Соңғы айда ешқандай өзгеріс болған жоқ.
Dialogue: 0,0:10:34.03,0:10:37.08,Default,,0,0,0,,Денеңіз өскен сайын күшіңіз де күшейе түсуі керек.
Dialogue: 0,0:10:38.07,0:10:40.00,Default,,0,0,0,,Жеке айырмашылықтар да үлкен.
Dialogue: 0,0:10:40.04,0:10:43.02,Default,,0,0,0,,Векторларды зерттеуге әлі де орын бар.
Dialogue: 0,0:10:55.04,0:10:56.04,Default,,0,0,0,,Не болды, Курама?
Dialogue: 0,0:10:58.05,0:10:59.09,Default,,0,0,0,,Көңіл-күйіңіз нашар сияқты.
Dialogue: 0,0:11:00.09,0:11:02.00,Default,,0,0,0,,Мен өкінемін.
Dialogue: 0,0:11:02.08,0:11:04.03,Default,,0,0,0,,Сіздің кеңесіңізді пайдаланғаным үшін кешіріңіз.
Dialogue: 0,0:11:06.02,0:11:10.02,Default,,0,0,0,,Біз әлемде теңдесі жоқ үлгілерді пайдаланып зерттеу жүргіземіз.
Dialogue: 0,0:11:10.03,0:11:13.09,Default,,0,0,0,,Біздің істеген ісіміз әрқашан әділ бағаланады
Dialogue: 0,0:11:14.03,0:11:16.00,Default,,0,0,0,,Маған сенші Курама
Dialogue: 0,0:11:17.03,0:11:20.01,Default,,0,0,0,,Неліктен ол бір уақытта және бір аймақта болды?
Dialogue: 0,0:11:21.02,0:11:22.06,Default,,0,0,0,,Менің ойымша, бұл маңыздырақ
Dialogue: 0,0:11:23.04,0:11:26.00,Default,,0,0,0,,Мұндай адамгершілікке жатпайтын еліктеудің қажеті жоқ.
Dialogue: 0,0:11:26.05,0:11:28.07,Default,,0,0,0,,Оларды адам деп ойлайсың ба?
Dialogue: 0,0:11:29.00,0:11:29.50,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:11:31.09,0:11:34.02,Default,,0,0,0,,Диклоний үш жаста болғанда
Dialogue: 0,0:11:34.06,0:11:36.02,Default,,0,0,0,,Оның шынайы табиғаты ашылады
Dialogue: 0,0:11:39.00,0:11:41.08,Default,,0,0,0,,Вектор кісі өлтіру әрекеттерін көрсетеді және қайталайды
Dialogue: 0,0:11:43.07,0:11:45.04,Default,,0,0,0,,Осы уақытқа дейін болған істердің негізінде,
Dialogue: 0,0:11:45.08,0:11:48.06,Default,,0,0,0,,Диклоний тіпті ата-анасын да ойланбастан өлтіреді.
Dialogue: 0,0:11:49.02,0:11:52.04,Default,,0,0,0,,Дегенмен, векторларыңызды бағыттай алатын жалғыз адамдар - 100% адамдар.
Dialogue: 0,0:11:53.01,0:11:54.03,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:11:59.08,0:12:03.02,Default,,0,0,0,,Диклоний – адамзаттың жауы.
Dialogue: 0,0:12:06.02,0:12:07.06,Default,,0,0,0,,Мен сені бүгін үйге жіберемін.
Dialogue: 0,0:12:08.01,0:12:10.05,Default,,0,0,0,,Әйеліңізге, жас жұбайларға сәлем айтыңыз
Dialogue: 0,0:12:10.05,0:12:11.05,Default,,0,0,0,,Басшы Кадозава
Dialogue: 0,0:12:11.08,0:12:12.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:13.01,0:12:14.09,Default,,0,0,0,,Үшінші тамақтың уақыты келді.
Dialogue: 0,0:12:14.09,0:12:16.02,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:12:16.07,0:12:18.02,Default,,0,0,0,,Тұрақты байланыс жоқ.
Dialogue: 0,0:12:18.03,0:12:20.00,Default,,0,0,0,,Құлыптан ашық болыңыз
Dialogue: 0,0:12:26.06,0:12:27.08,Default,,0,0,0,,Жақсы мақсат қойыңыз
Dialogue: 0,0:12:28.01,0:12:29.07,Default,,0,0,0,,Оқ мені жіберіп алды.
Dialogue: 0,0:12:33.00,0:12:35.00,Default,,0,0,0,,Нағашыларға да солай істе.
Dialogue: 0,0:12:38.00,0:12:39.00,Default,,0,0,0,,Негізгі люкті жабыңыз
Dialogue: 0,0:12:39.01,0:12:40.03,Default,,0,0,0,,Күзетшілер толық жабдықта
Dialogue: 0,0:12:40.03,0:12:41.09,Default,,0,0,0,,Үшінші қабатта қатаң қауіпсіздік
Dialogue: 0,0:12:42.05,0:12:44.04,Default,,0,0,0,,Омори Басқа қабаттарды тексеріңіз
Dialogue: 0,0:12:44.06,0:12:45.08,Default,,0,0,0,,. . . иә
Dialogue: 0,0:12:53.01,0:12:54.00,Default,,0,0,0,,Мұндай жағдайға жол беруге болмайды!
Dialogue: 0,0:13:02.09,0:13:04.03,Default,,0,0,0,,Біз ақыры кездестік.
Dialogue: 0,0:13:05.06,0:13:07.00,Default,,0,0,0,,Шыны артында тұрған адам
Dialogue: 0,0:13:12.06,0:13:15.04,Default,,0,0,0,,Мен сізге алғыс айтқым келді.
Dialogue: 0,0:13:17.00,0:13:17.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:29.07,0:13:31.04,Default,,0,0,0,,Мылтықтан шыққан оқ ауытқып кетсе де
Dialogue: 0,0:13:31.06,0:13:33.03,Default,,0,0,0,,Құрыш тесіп өтетін оқтар әлі де мүмкін емес.
Dialogue: 0,0:13:33.09,0:13:36.06,Default,,0,0,0,,Курама, сен менің өмірімді сақтап қалдың.
Dialogue: 0,0:13:37.04,0:13:39.08,Default,,0,0,0,,Бұл жігіттің өсуі жақында тоқтап қалды деп ойладым.
Dialogue: 0,0:13:40.01,0:13:41.01,Default,,0,0,0,,Бұл жалған болды
Dialogue: 0,0:13:41.09,0:13:44.02,Default,,0,0,0,,. . Оның оқ жаудыратын күші әлдеқашан болған.
Dialogue: 0,0:13:44.04,0:13:45.09,Default,,0,0,0,,Эмоционалды, тіпті сәбилер
Dialogue: 0,0:13:46.03,0:13:48.00,Default,,0,0,0,,Диклоний жоғары интеллектке ие.
Dialogue: 0,0:13:48.03,0:13:49.03,Default,,0,0,0,,Мен күзетімді түсірдім.
Dialogue: 0,0:13:57.00,0:13:58.06,Default,,0,0,0,,Мен сізге алғыс айтқым келді.
Dialogue: 0,0:14:00.09,0:14:02.02,Default,,0,0,0,,Мен есімде сақтамасам да,
Dialogue: 0,0:14:07.02,0:14:10.06,Default,,0,0,0,,Туылу себебі әлі анықталмағанымен
Dialogue: 0,0:14:11.00,0:14:13.07,Default,,0,0,0,,Диклониус түрмеге қамалған сайын көбейіп барады.
Dialogue: 0,0:14:14.05,0:14:16.04,Default,,0,0,0,,Нысандардың да өз шегі бар.
Dialogue: 0,0:14:16.07,0:14:20.04,Default,,0,0,0,,Мен қазірден бастап туатын барлық балалардан құтылғым келеді.
Dialogue: 0,0:14:21.00,0:14:27.03,Default,,0,0,0,,Туа біткен хромосомалық аномалияға байланысты кенеттен нәресте өлімі синдромы ретінде қарастырылуы керек.
Dialogue: 0,0:14:27.09,0:14:31.08,Default,,0,0,0,,Негізінен бұл жер осындай нысан.
Dialogue: 0,0:14:34.02,0:14:35.01,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:36.00,0:14:37.02,Default,,0,0,0,,Келмеңіз
Dialogue: 0,0:14:37.07,0:14:38.08,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:14:39.02,0:14:40.08,Default,,0,0,0,,Мүйіз өсірсең де
Dialogue: 0,0:14:40.08,0:14:42.00,Default,,0,0,0,,Ол менің қызым.
Dialogue: 0,0:14:42.00,0:14:45.04,Default,,0,0,0,,Омори Диклониус өссе не болады?
Dialogue: 0,0:14:45.06,0:14:47.01,Default,,0,0,0,,Сіз жақсырақ білуіңіз керек
Dialogue: 0,0:14:47.02,0:14:49.01,Default,,0,0,0,,Бірақ ол менің қызым.
Dialogue: 0,0:14:49.01,0:14:52.02,Default,,0,0,0,,Бірақ Мэй үш жылдан кейін бірінші болып өлтіріледі.
Dialogue: 0,0:14:55.05,0:14:58.02,Default,,0,0,0,,Ұмытшы, менің жолым болмады.
Dialogue: 0,0:14:59.06,0:15:02.06,Default,,0,0,0,,Сіз де солай ойлайсыз ба, Курама мырза?
Dialogue: 0,0:15:03.05,0:15:05.05,Default,,0,0,0,,Алда тұрған қиын тағдырды қарастыру
Dialogue: 0,0:15:06.00,0:15:07.08,Default,,0,0,0,,Бала есін жиғанға дейін
Dialogue: 0,0:15:08.08,0:15:10.05,Default,,0,0,0,,Мен саған ғашық болмас бұрын
Dialogue: 0,0:15:12.00,0:15:13.04,Default,,0,0,0,,Оны өлтірген дұрыс
Dialogue: 0,0:15:14.01,0:15:16.08,Default,,0,0,0,,Менің мұндай шешім қабылдауға мүмкіндігім жоқ.
Dialogue: 0,0:15:17.03,0:15:18.04,Default,,0,0,0,,Мен шешемін
Dialogue: 0,0:15:20.05,0:15:21.08,Default,,0,0,0,,Бұл менің шешімім
Dialogue: 0,0:15:22.06,0:15:23.07,Default,,0,0,0,,Сіз маған көмектесе аласыз
Dialogue: 0,0:15:29.06,0:15:31.08,Default,,0,0,0,,Ештеңе жасамасаңыз да
Dialogue: 0,0:15:32.02,0:15:34.03,Default,,0,0,0,,Мен оннан астам адамды өлтірдім.
Dialogue: 0,0:15:35.06,0:15:38.03,Default,,0,0,0,,Енді қолыңызды басқа нәрсемен ластаудың қажеті жоқ.
Dialogue: 0,0:15:39.01,0:15:42.03,Default,,0,0,0,,Жарайды, жаза сенікі, сондықтан мен ештеңе айтпаймын.
Dialogue: 0,0:15:43.00,0:15:45.08,Default,,0,0,0,,Әйеліңіздің жақын мерзімі сізге қиын болғанына сенімдімін.
Dialogue: 0,0:15:48.04,0:15:49.04,Default,,0,0,0,,Kisaragi
Dialogue: 0,0:15:50.08,0:15:52.03,Default,,0,0,0,,. . Кешіріңіз
Dialogue: 0,0:15:53.03,0:15:55.00,Default,,0,0,0,,Мен қазір шүберек әкелемін.
Dialogue: 0,0:16:00.01,0:16:01.01,Default,,0,0,0,,Жаңадан келген адам?
Dialogue: 0,0:16:01.08,0:16:03.08,Default,,0,0,0,,Токио университетінде оқитын талантты қыз сияқты.
Dialogue: 0,0:16:04.07,0:16:05.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:09.00,0:16:11.00,Default,,0,0,0,,Иә, бұл директордың кабинеті.
Dialogue: 0,0:16:11.06,0:16:13.05,Default,,0,0,0,,Бұл жерде сондай адамдар болғандықтан
Dialogue: 0,0:16:13.05,0:16:14.05,Default,,0,0,0,,Сіз құтқарыласыз
Dialogue: 0,0:16:15.05,0:16:16.06,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:16:16.09,0:16:17.08,Default,,0,0,0,,Курама мырза
Dialogue: 0,0:16:20.04,0:16:22.04,Default,,0,0,0,,Жатыр мойны обыры анықталды.
Dialogue: 0,0:16:22.08,0:16:24.04,Default,,0,0,0,,Жатырды асығыс алып тастады.
Dialogue: 0,0:16:24.04,0:16:25.08,Default,,0,0,0,,Мен қолымды кесіп аштым
Dialogue: 0,0:16:26.06,0:16:27.04,Default,,0,0,0,,Әйелі
Dialogue: 0,0:16:27.06,0:16:28.06,Default,,0,0,0,,Балалар
Dialogue: 0,0:16:28.09,0:16:31.09,Default,,0,0,0,,Ана мен баланың өміріне қауіп төндіретін жарақаттары жоқ.
Dialogue: 0,0:16:34.07,0:16:36.08,Default,,0,0,0,,Қарашы, қыз.
Dialogue: 0,0:16:37.07,0:16:39.01,Default,,0,0,0,,Маған есім ойлап табу керек.
Dialogue: 0,0:16:41.02,0:16:42.08,Default,,0,0,0,,Мүйіз өсірсең де
Dialogue: 0,0:16:42.08,0:16:44.03,Default,,0,0,0,,Ол менің қызым.
Dialogue: 0,0:16:47.01,0:16:48.08,Default,,0,0,0,,Оны өлтірген дұрыс.
Dialogue: 0,0:16:49.01,0:16:51.01,Default,,0,0,0,,Бірақ ол менің қызым.
Dialogue: 0,0:16:51.01,0:16:54.01,Default,,0,0,0,,Бірақ сіз үш жылдан кейін бірінші болып өлтірілесіздер.
Dialogue: 0,0:16:54.08,0:16:56.02,Default,,0,0,0,,Оны өлтірген дұрыс.
Dialogue: 0,0:16:56.08,0:16:59.06,Default,,0,0,0,,Менің мұндай шешім қабылдауға мүмкіндігім жоқ.
Dialogue: 0,0:16:59.08,0:17:01.02,Default,,0,0,0,,Мен шешемін
Dialogue: 0,0:17:01.06,0:17:02.08,Default,,0,0,0,,Бұл менің шешімім
Dialogue: 0,0:17:03.09,0:17:04.08,Default,,0,0,0,,Сіз мені кінәлай аласыз.
Dialogue: 0,0:17:11.04,0:17:12.05,Default,,0,0,0,,Бэбифейс: Американдық супержұлдыз Кеннет Брайан Эдмундтің сахналық лақап атынан алынған.
Dialogue: 0,0:17:12.05,0:17:13.05,Default,,0,0,0,,Шық!
Dialogue: 0,0:17:14.04,0:17:17.02,Default,,0,0,0,,Бұндай нәрсені есту мүмкін емес.
Dialogue: 0,0:17:17.02,0:17:18.01,Default,,0,0,0,,Түсініңіз
Dialogue: 0,0:17:18.01,0:17:20.04,Default,,0,0,0,,Маған да қиын, бірақ
Dialogue: 0,0:17:20.04,0:17:23.02,Default,,0,0,0,,Неліктен бұл баланы өлтіру керек болды?
Dialogue: 0,0:17:23.02,0:17:24.09,Default,,0,0,0,,Курама мырза, не болды?
Dialogue: 0,0:17:27.05,0:17:28.05,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:17:29.02,0:17:30.01,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:17:30.06,0:17:33.00,Default,,0,0,0,,Операциядан бері бірнеше сағат өтті.
Dialogue: 0,0:17:33.08,0:17:34.06,Default,,0,0,0,,Менің әйелім
Dialogue: 0,0:17:35.01,0:17:36.06,Default,,0,0,0,,Бұл абсолютті демалыс болса да
Dialogue: 0,0:17:36.06,0:17:38.04,Default,,0,0,0,,Көңілі көтеріліп, жабайы кетті.
Dialogue: 0,0:17:39.00,0:17:41.05,Default,,0,0,0,,Жағдайы ауыр, көп қан кетуге байланысты ес-түссіз.
Dialogue: 0,0:17:42.06,0:17:45.04,Default,,0,0,0,,Әрі қарай қан кету өмірге қауіп төндіреді.
Dialogue: 0,0:17:46.02,0:17:49.06,Default,,0,0,0,,Менің қызым қайда?
Dialogue: 0,0:17:50.02,0:17:51.02,Default,,0,0,0,,Балабақша бөлмесі
Dialogue: 0,0:17:51.07,0:17:53.04,Default,,0,0,0,,Ертең барып көріңіз.
Dialogue: 0,0:17:58.03,0:18:00.09,Default,,0,0,0,,Мен сізге алғыс айтқым келді.
Dialogue: 0,0:18:03.00,0:18:03.50,Default,,0,0,0,,At that time
Dialogue: 0,0:18:04.06,0:18:06.00,Default,,0,0,0,,Дарака Омори да
Dialogue: 0,0:18:06.08,0:18:09.00,Default,,0,0,0,,Мен көремін. Солай ма?
Dialogue: 0,0:18:12.09,0:18:16.02,Default,,0,0,0,,Бұл менің көзіме түскенде, мен мұны түсінемін
Dialogue: 0,0:18:21.07,0:18:22.06,Default,,0,0,0,,Мені кешір
Dialogue: 0,0:18:25.07,0:18:26.04,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:18:28.01,0:18:30.03,Default,,0,0,0,,Мына баланы неге өлтірмексің?
Dialogue: 0,0:18:31.08,0:18:33.09,Default,,0,0,0,,Мен оны қатты күттім.
Dialogue: 0,0:18:35.02,0:18:37.08,Default,,0,0,0,,Мен бұдан былай балалы бола алмаймын.
Dialogue: 0,0:18:38.03,0:18:41.08,Default,,0,0,0,,Неліктен оның басында мүйізі бар?
Dialogue: 0,0:18:43.04,0:18:44.08,Default,,0,0,0,,Ол жаман бала емес.
Dialogue: 0,0:18:45.03,0:18:50.07,Default,,0,0,0,,Балаға көмектесіңізші. . . Маған беріңізші
Dialogue: 0,0:18:57.02,0:18:58.02,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:19:00.00,0:19:01.09,Default,,0,0,0,,Жарайды, тұрайық.
Dialogue: 0,0:19:09.05,0:19:14.00,Default,,0,0,0,,Жарайды, оян.
Dialogue: 0,0:19:17.02,0:19:19.04,Default,,0,0,0,,Кейінгі тергеу нәтижелері қолжетімді.
Dialogue: 0,0:19:20.01,0:19:23.08,Default,,0,0,0,,Күтілгендей, барлық әкелердің реакциясы Курама сияқты болды.
Dialogue: 0,0:19:25.04,0:19:29.07,Default,,0,0,0,,Вектор арқылы таралатын вирус себепші екені күмәнсіз.
Dialogue: 0,0:19:30.08,0:19:31.09,Default,,0,0,0,,Бұл ирониялық.
Dialogue: 0,0:19:32.01,0:19:35.04,Default,,0,0,0,,Сіздің арқаңызда Диклониус індетінің жұмбағы шешілді.
Dialogue: 0,0:19:37.03,0:19:39.08,Default,,0,0,0,,Мен осы жерден кетіп, өзімді вирустарды зерттеуге арнаймын.
Dialogue: 0,0:19:40.03,0:19:42.01,Default,,0,0,0,,Бұл менің бастапқыда маманданғаным.
Dialogue: 0,0:19:42.05,0:19:43.02,Default,,0,0,0,,«Сенді ергеніме өкінемін».
Dialogue: 0,0:19:43.06,0:19:45.04,Default,,0,0,0,,Курама зертхана меңгерушісі болып ауыстырылды.
Dialogue: 0,0:19:45.06,0:19:46.02,Default,,0,0,0,,Иә
Dialogue: 0,0:19:46.06,0:19:48.04,Default,,0,0,0,,Ал, менде біраз дайындық бар, мінекей.
Dialogue: 0,0:19:55.02,0:19:57.00,Default,,0,0,0,,Патшайым болуы керек
Dialogue: 0,0:19:57.02,0:19:58.00,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:19:58.09,0:20:02.05,Default,,0,0,0,,Вирусты алғаш таратқан әрқашан Диклониус бар.
Dialogue: 0,0:20:03.03,0:20:05.05,Default,,0,0,0,,Өткен оқиғаларды мұқият анықтаңыз
Dialogue: 0,0:20:05.05,0:20:06.09,Default,,0,0,0,,Түпнұсқаны іздеңіз
Dialogue: 0,0:20:07.03,0:20:08.00,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:20:08.09,0:20:11.08,Default,,0,0,0,,Қызыңның өмірі менің қолымда.
Dialogue: 0,0:20:12.09,0:20:15.04,Default,,0,0,0,,Бұл бастапқыда жойылуы керек нәрсе.
Dialogue: 0,0:20:16.04,0:20:18.00,Default,,0,0,0,,Сізге маған бағынбауға рұқсат жоқ.
Dialogue: 0,0:20:30.02,0:20:32.00,Default,,0,0,0,,Тек сіз қашып ойнай аласыз.
Dialogue: 0,0:20:44.06,0:20:48.07,Default,,0,0,0,,Екеумізді де өртеп жібере алдың.
Dialogue: 0,0:20:48.08,0:20:51.07,Default,,0,0,0,,Сондықтан мен жалаңаш денеме ине саламын.
Dialogue: 0,0:20:56.06,0:20:58.04,Default,,0,0,0,,Нана-сан Нана-сан
Dialogue: 0,0:21:03.08,0:21:05.08,Default,,0,0,0,,Көрдім, кеше
Dialogue: 0,0:21:06.03,0:21:08.04,Default,,0,0,0,,Таңғы ас дайын.
Dialogue: 0,0:21:09.05,0:21:10.07,Default,,0,0,0,,Маю кінәлі
Dialogue: 0,0:21:12.04,0:21:16.02,Default,,0,0,0,,Бұл не? Бұл өте дәмді.
Dialogue: 0,0:21:16.02,0:21:17.09,Default,,0,0,0,,Маю мұны жасады.
Dialogue: 0,0:21:18.01,0:21:19.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:19.02,0:21:21.00,Default,,0,0,0,,Ғажайып Майу Гений
Dialogue: 0,0:21:21.04,0:21:23.04,Default,,0,0,0,,Осы суретте олар мінсіз жұп сияқты көрінеді, иә?
Dialogue: 0,0:21:23.04,0:21:25.02,Default,,0,0,0,,Екеуіңнен әлі ерініп жүрмін.
Dialogue: 0,0:21:25.07,0:21:26.07,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:26.09,0:21:29.04,Default,,0,0,0,,Егер ол осы дәрежеге дейін өссе, ол бірдей болады.
Dialogue: 0,0:21:29.05,0:21:32.01,Default,,0,0,0,,Иә, солай деп ойлаймын.
Dialogue: 0,0:21:32.02,0:21:33.04,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:21:33.04,0:21:35.05,Default,,0,0,0,,Адамдар көбейді, еносимаға барайық.
Dialogue: 0,0:21:35.09,0:21:37.04,Default,,0,0,0,,Сонда адам саны көбейді?
Dialogue: 0,0:21:37.06,0:21:38.06,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:21:38.08,0:21:40.04,Default,,0,0,0,,Wanta да бақытты болады
Dialogue: 0,0:21:40.04,0:21:41.04,Default,,0,0,0,,Жаңа
Dialogue: 0,0:21:45.05,0:21:47.09,Default,,0,0,0,,Неге бұлай айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:21:48.02,0:21:50.05,Default,,0,0,0,,Жақсы нәрсе
Dialogue: 0,0:21:59.03,0:22:01.06,Default,,0,0,0,,№35 жай ғана Зилпелит емес.
Dialogue: 0,0:22:02.02,0:22:04.05,Default,,0,0,0,,Олардың бар екенін білетін адамдар көп.
Dialogue: 0,0:22:05.02,0:22:06.08,Default,,0,0,0,,Мен тіпті білмедім
Dialogue: 0,0:22:07.07,0:22:09.02,Default,,0,0,0,,Бірақ директордың бұйрығы.
Dialogue: 0,0:22:09.08,0:22:13.00,Default,,0,0,0,,Қазірдің өзінде мен сені осы қабірде қамауда ұстау үшін істей аламын.
Dialogue: 0,0:22:15.02,0:22:19.03,Default,,0,0,0,,35 саны - көрген әрбір адамды өлтіретін ең жаман Зилперит.
Dialogue: 0,0:22:20.02,0:22:23.04,Default,,0,0,0,,Бұл жалғыз расталған үшінші алгебра, сондықтан мен оны пайдаланамын.
Dialogue: 0,0:22:23.09,0:22:25.00,Default,,0,0,0,,Әйтпесе
Dialogue: 0,0:22:44.05,0:22:46.05,Default,,0,0,0,,Иә, оны мына жерден көре аласыз.
Dialogue: 0,0:22:46.08,0:22:48.09,Default,,0,0,0,,Толқындар тым күшті.
Dialogue: 0,0:22:49.06,0:22:50.06,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:22:51.06,0:22:53.03,Default,,0,0,0,,саны 26
Dialogue: 0,0:22:54.00,0:22:55.08,Default,,0,0,0,,Бұл адам Люсиден де құбыжық.
Dialogue: 0,0:22:57.01,0:22:58.08,Default,,0,0,0,,Ең күшті Диклониус
Dialogue: 0,0:24:33.08,0:24:37.06,Default,,0,0,0,,Жас шайтан қарғыс атқан дауыспен түседі
Dialogue: 0,0:24:38.02,0:24:41.08,Default,,0,0,0,,Бақыттың мәнін біліп, оны қорғайтын қыз.
Dialogue: 0,0:24:43.00,0:24:44.08,Default,,0,0,0,,Барлық жерде шынжырларды үзуге тырысу
Dialogue: 0,0:24:44.08,0:24:46.08,Default,,0,0,0,,Аңмен қол ұстасып тұрған адам
Dialogue: 0,0:24:47.07,0:24:49.01,Default,,0,0,0,,Әр жерде
Dialogue: 0,0:24:49.06,0:24:51.01,Default,,0,0,0,,Қанды ән мерекесіне дайындық
Dialogue: 0,0:24:51.01,0:24:53.03,Default,,0,0,0,,Тұрақты прогреске қол жеткізілді
Dialogue: 0,0:24:54.04,0:24:57.02,Default,,0,0,0,,Келесі жолы Эльфен өтірік айтты 11-бөлім
Dialogue: 0,0:24:57.05,0:24:58.07,Default,,0,0,0,,Шатасу
Dialogue: 0,0:24:59.57,0:25:04.57,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
