Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.74,Default,,0,0,0,,NETFLIX түпнұсқа жұмысы
Dialogue: 0,0:00:08.04,0:00:11.17,Default,,0,0,0,,«Дөрекі шатыр»
Dialogue: 0,0:00:11.24,0:00:14.58,Default,,0,0,0,,Өйткені ол: «Бұл жақсы маска» дейді.
Dialogue: 0,0:00:15.08,0:00:17.61,Default,,0,0,0,,Мен: «Бұл жиіркенішті» деп жауап бердім.
Dialogue: 0,0:00:18.28,0:00:19.55,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:00:19.61,0:00:23.49,Default,,0,0,0,,Менің атымның басының бір қызық жағы бар.
Dialogue: 0,0:00:24.52,0:00:25.19,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:00:25.32,0:00:28.36,Default,,0,0,0,,Рок Хадсонның кектері күлкілі емес пе?
Dialogue: 0,0:00:28.49,0:00:31.49,Default,,0,0,0,,Жалғастырыңыз, ақшаңызды қайтарып аласыз.
Dialogue: 0,0:00:32.56,0:00:33.23,Default,,0,0,0,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:00:33.33,0:00:34.60,Default,,0,0,0,,Бұл күлкілі емес.
Dialogue: 0,0:00:34.70,0:00:36.30,Default,,0,0,0,,Деңгей тым жоғары болды ма?
Dialogue: 0,0:00:37.03,0:00:38.43,Default,,0,0,0,,Мм... сәл күте тұрыңыз.
Dialogue: 0,0:00:38.77,0:00:40.04,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:00:42.47,0:00:43.51,Default,,0,0,0,,«Дөрекі шатыр»
Dialogue: 0,0:00:44.51,0:00:45.64,Default,,0,0,0,,Мен саған сусын сатып аламын.
Dialogue: 0,0:00:46.17,0:00:47.51,Default,,0,0,0,,Блять!
Dialogue: 0,0:00:47.58,0:00:49.04,Default,,0,0,0,,Сен ақылдысың
Dialogue: 0,0:00:49.14,0:00:51.38,Default,,0,0,0,,Горбачевтің қағылысы күлкілі болды
Dialogue: 0,0:00:51.45,0:00:54.12,Default,,0,0,0,,Бірақ аудиторияға түсініктеме қажет емес.
Dialogue: 0,0:00:54.42,0:00:56.15,Default,,0,0,0,,Түсінген-түсінбегенін қалай бағалайсыз?
Dialogue: 0,0:00:56.22,0:00:57.52,Default,,0,0,0,,Күлкі пайда болады
Dialogue: 0,0:00:57.65,0:01:00.32,Default,,0,0,0,,Маған не үшін кеңес бересіз?
Dialogue: 0,0:01:00.59,0:01:02.56,Default,,0,0,0,,Сахнада жүргеніме бір жыл болды
Dialogue: 0,0:01:02.62,0:01:05.36,Default,,0,0,0,,Жасөспірімдерге көмектесу сіздің міндетіңіз...
Dialogue: 0,0:01:05.53,0:01:07.66,Default,,0,0,0,,Бұл ағаның міндеті.
Dialogue: 0,0:01:08.10,0:01:08.83,Default,,0,0,0,,Мен саған сусын алып беремін.
Dialogue: 0,0:01:09.10,0:01:10.20,Default,,0,0,0,,Мен ішімдік ішпеймін.
Dialogue: 0,0:01:10.60,0:01:12.13,Default,,0,0,0,,Бұл BoJack Horseman.
Dialogue: 0,0:01:12.23,0:01:13.54,Default,,0,0,0,,Бұл Казаз шөпі.
Dialogue: 0,0:01:17.07,0:01:17.57,Default,,0,0,0,,Ой
Dialogue: 0,0:01:18.24,0:01:20.31,Default,,0,0,0,,Тодд, тазалаңыз.
Dialogue: 0,0:01:20.64,0:01:23.68,Default,,0,0,0,,Өйткені олар маған сақтау орнын бермейді.
Dialogue: 0,0:01:23.78,0:01:24.81,Default,,0,0,0,,Қайта ашпаңыз
Dialogue: 0,0:01:25.11,0:01:26.82,Default,,0,0,0,,Баяғыда бір кісі айтыпты
Dialogue: 0,0:01:27.08,0:01:30.82,Default,,0,0,0,,«Үлкендерге көмек көрсету кішілердің міндеті».
Dialogue: 0,0:01:31.12,0:01:32.29,Default,,0,0,0,,Белгілі бір адам ше?
Dialogue: 0,0:01:32.49,0:01:35.12,Default,,0,0,0,,Сіз білесіз бе, Христос па, Ганди ме?
Dialogue: 0,0:01:35.19,0:01:36.29,Default,,0,0,0,,Тез тазалаңыз
Dialogue: 0,0:02:27.64,0:02:31.45,Default,,0,0,0,,БоДжек шабандозы
Dialogue: 0,0:02:31.61,0:02:34.75,Default,,0,0,0,,«Глория Штайнхам дәрісі»
Dialogue: 0,0:02:35.52,0:02:39.22,Default,,0,0,0,,Көрнекті феминист Глория Стейнхэм —
Dialogue: 0,0:02:39.32,0:02:41.86,Default,,0,0,0,,Тарихта із қалдырады.
Dialogue: 0,0:02:41.92,0:02:46.76,Default,,0,0,0,,Лампанелли мырзаның NBA ойыншысымен болған минет оқиғасы сияқты.
Dialogue: 0,0:02:49.86,0:02:51.57,Default,,0,0,0,,БоДжек, отыр.
Dialogue: 0,0:02:51.80,0:02:53.47,Default,,0,0,0,,Сіз кімсіз, Зои немесе Зельда?
Dialogue: 0,0:02:53.60,0:02:54.57,Default,,0,0,0,,(Баяндау) Бір күні адамсыз жүзуші кеме табылды.
Dialogue: 0,0:02:54.67,0:02:55.84,Default,,0,0,0,,Уэйнмен әңгіме...
Dialogue: 0,0:02:55.90,0:02:56.54,Default,,0,0,0,,Кім?
Dialogue: 0,0:02:56.84,0:02:57.51,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:02:57.61,0:03:00.24,Default,,0,0,0,,Менің мақаламды жаңалықтар сайттарында орналастыру
Dialogue: 0,0:03:00.41,0:03:02.81,Default,,0,0,0,,Өте танымал сайтта көрсетілген
Dialogue: 0,0:03:02.91,0:03:05.81,Default,,0,0,0,,Уэйн менің бұрынғы жігітім.
Dialogue: 0,0:03:06.21,0:03:07.32,Default,,0,0,0,,Бұл күлкілі, солай емес пе?
Dialogue: 0,0:03:07.48,0:03:08.78,Default,,0,0,0,,Бұл тамаша әңгіме емес пе?
Dialogue: 0,0:03:08.88,0:03:10.65,Default,,0,0,0,,Дайан сіздің кітабыңызды алды.
Dialogue: 0,0:03:10.75,0:03:12.52,Default,,0,0,0,,Ол менің мақаламды жазады
Dialogue: 0,0:03:12.59,0:03:13.76,Default,,0,0,0,,Бірдей позиция
Dialogue: 0,0:03:13.86,0:03:15.36,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:03:15.42,0:03:17.66,Default,,0,0,0,,Менің кітабым кітапханада.
Dialogue: 0,0:03:17.89,0:03:21.86,Default,,0,0,0,,Мысықтың ұйықтап жатқаны мен сұлу әйелдердің ерекшелігі -
Dialogue: 0,0:03:21.93,0:03:23.87,Default,,0,0,0,,Бірнеше жол
Dialogue: 0,0:03:23.97,0:03:25.67,Default,,0,0,0,,Ақыр соңында, сіз Зоидің жанкүйерісіз.
Dialogue: 0,0:03:25.77,0:03:26.87,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:26.94,0:03:28.84,Default,,0,0,0,,«Жаңғақ үйін» білесіз бе?
Dialogue: 0,0:03:28.90,0:03:31.51,Default,,0,0,0,,Оның құрылымы менің бағдарламаммен бірдей.
Dialogue: 0,0:03:31.61,0:03:33.78,Default,,0,0,0,,Мына сұмдық шоу?
Dialogue: 0,0:03:33.84,0:03:35.51,Default,,0,0,0,,Кейбір айырмашылықтар бар.
Dialogue: 0,0:03:35.58,0:03:37.98,Default,,0,0,0,,«П-ның үйінде» егіз апалы-сіңлілер болған.
Dialogue: 0,0:03:38.25,0:03:39.28,Default,,0,0,0,,Зоя мен Зельда
Dialogue: 0,0:03:39.38,0:03:42.42,Default,,0,0,0,,Зельда - белсенді және жарқын бала
Dialogue: 0,0:03:42.48,0:03:44.32,Default,,0,0,0,,Қараңдар, мен орындадым.
Dialogue: 0,0:03:44.39,0:03:46.32,Default,,0,0,0,,Сенде ең жақсы күлкі бар, Зельда
Dialogue: 0,0:03:46.65,0:03:49.29,Default,,0,0,0,,Зоя ұялшақ.
Dialogue: 0,0:03:49.49,0:03:50.66,Default,,0,0,0,,Мен оны құстыруға тырыстым.
Dialogue: 0,0:03:50.73,0:03:53.60,Default,,0,0,0,,Хэллоуин кезінде семіздіктен сақ болыңыз
Dialogue: 0,0:03:53.66,0:03:56.40,Default,,0,0,0,,Өйткені қантты қабылдау көбейеді
Dialogue: 0,0:03:56.73,0:04:00.40,Default,,0,0,0,,Костюмдер де нәсілшіл.
Dialogue: 0,0:04:00.67,0:04:03.30,Default,,0,0,0,,Жарайды, пышақты қояйық.
Dialogue: 0,0:04:07.44,0:04:10.65,Default,,0,0,0,,Актерлік ойын нашар, ал сценарий нашар, солай емес пе?
Dialogue: 0,0:04:10.95,0:04:12.38,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:04:12.45,0:04:12.91,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:04:13.28,0:04:15.58,Default,,0,0,0,,Бірақ егіздерді беру дұрыс әрекет болды.
Dialogue: 0,0:04:15.82,0:04:17.99,Default,,0,0,0,,Адамдарды Зои немесе Зельда ретінде жіктеуге болады.
Dialogue: 0,0:04:18.52,0:04:22.32,Default,,0,0,0,,Никсон – Зои Кеннеди – Зельда
Dialogue: 0,0:04:22.56,0:04:25.36,Default,,0,0,0,,Гор - Зои, Буш - толығымен Зельда
Dialogue: 0,0:04:25.43,0:04:27.26,Default,,0,0,0,,R2D2 және C3PO
Dialogue: 0,0:04:27.36,0:04:28.86,Default,,0,0,0,,Дешанель апалары да.
Dialogue: 0,0:04:28.96,0:04:30.33,Default,,0,0,0,,Дешанель апалары?
Dialogue: 0,0:04:30.47,0:04:33.00,Default,,0,0,0,,Зоя - Зельда Эмили - Зои
Dialogue: 0,0:04:33.33,0:04:34.50,Default,,0,0,0,,Бұл күрделі.
Dialogue: 0,0:04:34.60,0:04:35.94,Default,,0,0,0,,Сіз қайсысысыз?
Dialogue: 0,0:04:36.00,0:04:38.34,Default,,0,0,0,,Мен одан да асып кетемін
Dialogue: 0,0:04:38.41,0:04:39.84,Default,,0,0,0,,Синик Зоя?
Dialogue: 0,0:04:41.44,0:04:42.71,Default,,0,0,0,,Мен Зельдамын
Dialogue: 0,0:04:42.91,0:04:44.68,Default,,0,0,0,,Сіз басқа типсіз.
Dialogue: 0,0:04:44.75,0:04:48.32,Default,,0,0,0,,Сен адамдарға зиян тигізетін паразитсің.
Dialogue: 0,0:04:48.45,0:04:49.58,Default,,0,0,0,,Сіз тым көп айтасыз
Dialogue: 0,0:04:49.65,0:04:51.62,Default,,0,0,0,,Өзіңнің жалғыз сатылатын жерің – жастығың екенін көрсеткің келе ме? Енді жас емессің ғой
Dialogue: 0,0:04:51.72,0:04:53.55,Default,,0,0,0,,Егер сізге бұл туралы бірнеше рет айтылса,
Dialogue: 0,0:04:53.72,0:04:56.59,Default,,0,0,0,,Менің ойымша, бұл дұрыс. Бұл «сырғып келеді».
Dialogue: 0,0:04:56.99,0:04:59.03,Default,,0,0,0,,Мен жұмыссызмын, мақсатым жоқ.
Dialogue: 0,0:04:59.33,0:05:02.56,Default,,0,0,0,,Рок-операмды аяқтау мүмкін емес.
Dialogue: 0,0:05:02.63,0:05:03.56,Default,,0,0,0,,Не?
Dialogue: 0,0:05:04.00,0:05:07.00,Default,,0,0,0,,Мұндай нәрселерді қашаннан бастап жаза бастадыңыз?
Dialogue: 0,0:05:07.70,0:05:08.87,Default,,0,0,0,,Қосымша заттар...
Dialogue: 0,0:05:09.04,0:05:12.37,Default,,0,0,0,,Негізінен бұл «Томмидің» Cirque du Soleil нұсқасы
Dialogue: 0,0:05:12.44,0:05:15.01,Default,,0,0,0,,Сахна – «эротикаға» толы ғалам
Dialogue: 0,0:05:15.08,0:05:17.98,Default,,0,0,0,,Тұншықтыратын психологиялық тосқауылда махаббат пен...
Dialogue: 0,0:05:18.51,0:05:20.52,Default,,0,0,0,,Құрамында юмор бар
Dialogue: 0,0:05:20.58,0:05:21.52,Default,,0,0,0,,Тақырып:
Dialogue: 0,0:05:21.58,0:05:24.02,Default,,0,0,0,,«Ньютопияның көтерілуі 1 бөлім»
Dialogue: 0,0:05:24.09,0:05:26.65,Default,,0,0,0,,«Жаңа Ньютопияны іздеуде»
Dialogue: 0,0:05:26.75,0:05:29.86,Default,,0,0,0,,«1-бөлім»? Бұл жалғасы бар дегенді білдіре ме?
Dialogue: 0,0:05:34.63,0:05:37.03,Default,,0,0,0,,Ғарыш кемесінің бортында
Dialogue: 0,0:05:37.10,0:05:37.73,Default,,0,0,0,,Сендер тым ашушаңсыңдар
Dialogue: 0,0:05:37.80,0:05:38.53,Default,,0,0,0,,Түсті
Dialogue: 0,0:05:38.60,0:05:41.70,Default,,0,0,0,,Үйден шығу
Dialogue: 0,0:05:42.64,0:05:49.64,Default,,0,0,0,,Жаңа әлемге, бай болашаққа ұмтылу
Dialogue: 0,0:05:49.84,0:05:51.81,Default,,0,0,0,,Жер? Бұл «бай топырақ» ба?
Dialogue: 0,0:05:51.91,0:05:55.38,Default,,0,0,0,,Әй, топырақты өңдеп күн көріп жүрген адамдар туралы.
Dialogue: 0,0:05:55.58,0:05:56.85,Default,,0,0,0,,Ғарыш кемесінің бортында?
Dialogue: 0,0:05:56.92,0:05:59.42,Default,,0,0,0,,«Рок-опера» 2-акт
Dialogue: 0,0:06:00.46,0:06:05.56,Default,,0,0,0,,Мен әртүрлі тәжірибені бастан өткерсем де,
Dialogue: 0,0:06:05.63,0:06:08.96,Default,,0,0,0,,Тек құлдар үшін...
Dialogue: 0,0:06:09.03,0:06:12.43,Default,,0,0,0,,Бұл ешқашан болмайды.
Dialogue: 0,0:06:12.50,0:06:15.97,Default,,0,0,0,,Мен оны мүлдем жек көремін...
Dialogue: 0,0:06:19.54,0:06:21.38,Default,,0,0,0,,Онда сақтамаңыз
Dialogue: 0,0:06:21.88,0:06:27.12,Default,,0,0,0,,Құл!
Dialogue: 0,0:06:30.55,0:06:32.62,Default,,0,0,0,,Тоқта, бұл ең сорақысы.
Dialogue: 0,0:06:33.05,0:06:34.92,Default,,0,0,0,,9.11-ден нашар
Dialogue: 0,0:06:35.69,0:06:39.09,Default,,0,0,0,,Мен шынымен ақымақ екеніме сенімдімін.
Dialogue: 0,0:06:39.46,0:06:40.96,Default,,0,0,0,,Онда мен бас тартамын.
Dialogue: 0,0:06:41.03,0:06:42.43,Default,,0,0,0,,Мен мұны істеуім керек.
Dialogue: 0,0:06:45.90,0:06:48.74,Default,,0,0,0,,Ливерпуль порт қаласы болғандықтан—
Dialogue: 0,0:06:48.84,0:06:51.87,Default,,0,0,0,,Америка мәдениетінің әсері
Dialogue: 0,0:06:51.94,0:06:55.01,Default,,0,0,0,,Блюз және рок-н-ролл көрнекті мысалдар.
Dialogue: 0,0:06:55.11,0:06:58.75,Default,,0,0,0,,Сіз Пол Маккартнимен ваннада кездесу туралы айтып жатырсыз ба?
Dialogue: 0,0:06:58.91,0:07:01.82,Default,,0,0,0,,Иә, мұқият тыңдаңыз.
Dialogue: 0,0:07:01.92,0:07:03.48,Default,,0,0,0,,Бұл туралы басқа кезде айтамыз.
Dialogue: 0,0:07:03.85,0:07:04.75,Default,,0,0,0,,Тодд деген кім?
Dialogue: 0,0:07:04.99,0:07:06.65,Default,,0,0,0,,Тодд 5 жыл бұрын—
Dialogue: 0,0:07:06.72,0:07:09.69,Default,,0,0,0,,Ол кешке жасырын кіріп, сонда қалды.
Dialogue: 0,0:07:09.76,0:07:12.13,Default,,0,0,0,,Сіз оны үнсіз қабылдайсыз ба?
Dialogue: 0,0:07:12.19,0:07:14.20,Default,,0,0,0,,Мен саған кет деп айттым.
Dialogue: 0,0:07:14.50,0:07:17.17,Default,,0,0,0,,Мен сізді жігерлендірсем ше? Мүмкін сіздің талантыңыз гүлдейді
Dialogue: 0,0:07:17.57,0:07:19.97,Default,,0,0,0,,Сіздің де қайырымды адамыңыз болды ғой, солай ма?
Dialogue: 0,0:07:20.13,0:07:21.44,Default,,0,0,0,,Ол жоқ еді.
Dialogue: 0,0:07:21.50,0:07:23.17,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:07:23.47,0:07:25.04,Default,,0,0,0,,Оның «гей махаббаты»
Dialogue: 0,0:07:25.14,0:07:28.01,Default,,0,0,0,,Адамдарға көмектескенді ұнатпайтыныңызды түсіндім.
Dialogue: 0,0:07:28.11,0:07:30.65,Default,,0,0,0,,Адамдарға тегін өмір сүруге мүмкіндік беру
Dialogue: 0,0:07:30.71,0:07:32.65,Default,,0,0,0,,Мен Тереза анамын
Dialogue: 0,0:07:32.75,0:07:36.65,Default,,0,0,0,,Жалғыз қалудан қорқатындықтан ба?
Dialogue: 0,0:07:36.78,0:07:38.65,Default,,0,0,0,,Мүлдем жоқ.
Dialogue: 0,0:07:38.72,0:07:42.02,Default,,0,0,0,,Мен жалғыздықты жақсы көремін
Dialogue: 0,0:07:42.72,0:07:45.99,Default,,0,0,0,,Неліктен Тоддтың талантын бүршіктендіреді?
Dialogue: 0,0:07:46.19,0:07:48.53,Default,,0,0,0,,Не туралы айтып тұрсың, Тодд?
Dialogue: 0,0:07:48.93,0:07:50.20,Default,,0,0,0,,Оны тазалаңыз ба?
Dialogue: 0,0:07:50.73,0:07:53.10,Default,,0,0,0,,Иә, және сіздің...
Dialogue: 0,0:07:53.77,0:07:55.80,Default,,0,0,0,,Мен саған рок-операға көмектесемін.
Dialogue: 0,0:07:56.64,0:07:59.21,Default,,0,0,0,,Сондықтан мен сені қолдаймын.
Dialogue: 0,0:07:59.51,0:08:02.14,Default,,0,0,0,,Кенеттен не болды? Мен өлемін бе?
Dialogue: 0,0:08:02.51,0:08:06.08,Default,,0,0,0,,Себебі сенде жасырын талант бар.
Dialogue: 0,0:08:06.15,0:08:09.55,Default,,0,0,0,,Мен саған оны шығаруға көмектесемін.
Dialogue: 0,0:08:09.65,0:08:10.52,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:08:10.65,0:08:11.15,Default,,0,0,0,,О
Dialogue: 0,0:08:11.65,0:08:12.22,Default,,0,0,0,,Қазірше тек сен мен мен ғана оралдық.
Dialogue: 0,0:08:12.52,0:08:17.09,Default,,0,0,0,,Бұрын сен маған берген уәдеңді бұзып, стриптизшімен жүрдің.
Dialogue: 0,0:08:17.16,0:08:19.13,Default,,0,0,0,,Сіз коньки тептіңіз.
Dialogue: 0,0:08:19.19,0:08:22.70,Default,,0,0,0,,Осы жолы тағы да стриптизшімен баруды жоспарлап отырсыз ба?
Dialogue: 0,0:08:22.93,0:08:23.56,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:23.73,0:08:24.90,Default,,0,0,0,,Сонда сіз мұны істедіңіз!
Dialogue: 0,0:08:27.94,0:08:28.97,Default,,0,0,0,,Бастайық
Dialogue: 0,0:08:29.20,0:08:31.81,Default,,0,0,0,,Шынымды айтсам, бұл ең нашар
Dialogue: 0,0:08:31.97,0:08:35.64,Default,,0,0,0,,Барлығы дұрыс емес. Параметр мен аяқталуы да қате.
Dialogue: 0,0:08:35.74,0:08:37.68,Default,,0,0,0,,Бұл дүмшелердің арасында.
Dialogue: 0,0:08:37.85,0:08:39.28,Default,,0,0,0,,Қатты, бірақ түсінікті
Dialogue: 0,0:08:40.28,0:08:43.99,Default,,0,0,0,,Бірақ мен жақсартуға мүмкіндік бар деп ойлаймын.
Dialogue: 0,0:08:44.22,0:08:46.59,Default,,0,0,0,,Рахмет, мен бұл туралы ойланамын.
Dialogue: 0,0:08:48.86,0:08:49.29,Default,,0,0,0,,Камминг жасайсыз ба?
Dialogue: 0,0:08:49.56,0:08:50.02,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:08:50.19,0:08:50.83,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:50.89,0:08:51.66,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:08:51.73,0:08:52.16,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:52.23,0:08:53.76,Default,,0,0,0,,Ол сонда ма?
Dialogue: 0,0:08:53.83,0:08:56.20,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:57.27,0:08:58.13,Default,,0,0,0,,Сіз шәует еттіңіз бе?
Dialogue: 0,0:08:59.53,0:09:02.57,Default,,0,0,0,,Екінші актіде Ньютопия іздеушілері...
Dialogue: 0,0:09:02.64,0:09:05.67,Default,,0,0,0,,Ғарыш кемесі қирағанын білесіз бе?
Dialogue: 0,0:09:05.87,0:09:06.31,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:09:06.57,0:09:09.54,Default,,0,0,0,,Төртінші акт туралы не айтасыз?
Dialogue: 0,0:09:09.64,0:09:12.08,Default,,0,0,0,,Мен оның не екенін білмеймін, бірақ бұл ең сорақысы.
Dialogue: 0,0:09:12.18,0:09:14.28,Default,,0,0,0,,Ойлан.
Dialogue: 0,0:09:16.65,0:09:23.66,Default,,0,0,0,,Сондықтан бұл планета жақсы емес.
Dialogue: 0,0:09:25.73,0:09:26.86,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:09:26.96,0:09:27.83,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:27.90,0:09:32.17,Default,,0,0,0,,Холокост төрт жылда бір рет болады делік.
Dialogue: 0,0:09:32.27,0:09:35.30,Default,,0,0,0,,Бұл рок-операдан жақсы.
Dialogue: 0,0:09:35.94,0:09:38.27,Default,,0,0,0,,Бұл кеңес емес.
Dialogue: 0,0:09:38.34,0:09:42.18,Default,,0,0,0,,Сен мен туралы ештеңе естіген жоқсың ғой?
Dialogue: 0,0:09:42.58,0:09:43.95,Default,,0,0,0,,Сіз тыңдай аласыз және жасай аласыз.
Dialogue: 0,0:09:44.01,0:09:47.78,Default,,0,0,0,,Лайланған жат планеталық патшайымға берген уәдесін бұзды...
Dialogue: 0,0:09:47.85,0:09:50.82,Default,,0,0,0,,Үңгірге кіруге себеп болған болса.
Dialogue: 0,0:09:50.99,0:09:52.15,Default,,0,0,0,,Мен тыңдадым.
Dialogue: 0,0:09:52.22,0:09:53.12,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:09:53.65,0:09:57.33,Default,,0,0,0,,Лайлы жат планеталықтар адал. Олардың патшайымға опасыздық жасауы мүмкін емес.
Dialogue: 0,0:09:58.03,0:09:59.16,Default,,0,0,0,,Немесе...
Dialogue: 0,0:10:00.29,0:10:03.20,Default,,0,0,0,,Егер сіз мұны патшайым үшін жасасаңыз ше?
Dialogue: 0,0:10:03.30,0:10:07.94,Default,,0,0,0,,Королева берген «есте сақтауды өшіретін дәріні» қолдану
Dialogue: 0,0:10:08.00,0:10:11.37,Default,,0,0,0,,Мен үңгірде жасырылған құпияны қайтардым!
Dialogue: 0,0:10:11.64,0:10:15.31,Default,,0,0,0,,Патшалықты Ньютопияға айналдырыңыз және патшайым оны басқарсын!
Dialogue: 0,0:10:15.78,0:10:18.61,Default,,0,0,0,,Онда тұрма, жазып ал
Dialogue: 0,0:10:20.25,0:10:21.18,Default,,0,0,0,,Жарай ма?
Dialogue: 0,0:10:21.32,0:10:22.82,Default,,0,0,0,,Менің нани саған ұнай ма?
Dialogue: 0,0:10:23.02,0:10:24.05,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:10:26.75,0:10:27.76,Default,,0,0,0,,Сіз шәует еттіңіз бе?
Dialogue: 0,0:10:28.39,0:10:32.36,Default,,0,0,0,,Робот әскері жоқ деп есептейік?
Dialogue: 0,0:10:32.63,0:10:34.63,Default,,0,0,0,,Жетістік табылды.
Dialogue: 0,0:10:38.40,0:10:43.10,Default,,0,0,0,,Бұл Ньютопия
Dialogue: 0,0:10:43.17,0:10:44.27,Default,,0,0,0,,Жоғары
Dialogue: 0,0:10:44.81,0:10:45.91,Default,,0,0,0,,Төменгі
Dialogue: 0,0:10:48.28,0:10:52.11,Default,,0,0,0,,Жарайды, біз көп жетістіктерге жеттік. Түскі ас ішейік.
Dialogue: 0,0:10:52.28,0:10:55.12,Default,,0,0,0,,Бір минут күтіңіз. Менімен түскі ас?
Dialogue: 0,0:10:55.18,0:10:56.08,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:56.15,0:11:00.82,Default,,0,0,0,,Бұл оқиға түскі асқа кездесуді білдіреді.
Dialogue: 0,0:11:00.99,0:11:03.12,Default,,0,0,0,,Сізді қуып жіберген кездегідей ме?
Dialogue: 0,0:11:03.26,0:11:07.43,Default,,0,0,0,,«Мен қазір Стриппен түскі ас ішіп жатырмын.»
Dialogue: 0,0:11:07.70,0:11:09.20,Default,,0,0,0,,Менің туған күнім болса да
Dialogue: 0,0:11:10.20,0:11:10.87,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:10.97,0:11:12.10,Default,,0,0,0,,Сонда сіз мұны істедіңіз!
Dialogue: 0,0:11:14.37,0:11:15.07,Default,,0,0,0,,Бұл —
Dialogue: 0,0:11:15.20,0:11:18.24,Default,,0,0,0,,Бұл менің режиссер Расселмен соңғы жұмысым.
Dialogue: 0,0:11:18.31,0:11:22.44,Default,,0,0,0,,«Есту – уақытша ұят, тыңдамау – бұл...»
Dialogue: 0,0:11:23.44,0:11:24.38,Default,,0,0,0,,«Раттатта»
Dialogue: 0,0:11:24.71,0:11:26.88,Default,,0,0,0,,Аа, солай болды.
Dialogue: 0,0:11:27.28,0:11:28.82,Default,,0,0,0,,Ой, бұл телефон қоңырауы.
Dialogue: 0,0:11:28.88,0:11:32.69,Default,,0,0,0,,Эрика, дәл қазір сенің сүйкімділігіңе таң қалуға уақытым жоқ...
Dialogue: 0,0:11:32.89,0:11:36.16,Default,,0,0,0,,Жержаңғақ майы дегеніміз не? Ол қашан пайда болды? Шын айтасың ба?
Dialogue: 0,0:11:36.89,0:11:37.96,Default,,0,0,0,,Мақала үшін.
Dialogue: 0,0:11:38.06,0:11:40.90,Default,,0,0,0,,Қашан жазылады?
Dialogue: 0,0:11:41.13,0:11:42.26,Default,,0,0,0,,Сұхбатты дұрыс өткізу...
Dialogue: 0,0:11:42.33,0:11:43.10,Default,,0,0,0,,Не?
Dialogue: 0,0:11:43.16,0:11:45.80,Default,,0,0,0,,Дайан Бүгін қай күн?
Dialogue: 0,0:11:45.87,0:11:46.30,Default,,0,0,0,,жексенбі?
Dialogue: 0,0:11:46.40,0:11:51.04,Default,,0,0,0,,El Taco Loco-да өте үлкен бурритолар ұсынылады!
Dialogue: 0,0:11:51.11,0:11:51.91,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:11:52.27,0:11:54.38,Default,,0,0,0,,Дайан Арбустың фото көрмесіне барыңыз
Dialogue: 0,0:11:54.74,0:11:56.14,Default,,0,0,0,,Мен үлкен жанкүйермін
Dialogue: 0,0:11:57.04,0:11:58.95,Default,,0,0,0,,Сіз жанкүйер болуыңыз керек.
Dialogue: 0,0:11:59.01,0:12:00.98,Default,,0,0,0,,Оның аты Дайан
Dialogue: 0,0:12:01.05,0:12:02.92,Default,,0,0,0,,Сен де Дайан
Dialogue: 0,0:12:03.12,0:12:04.09,Default,,0,0,0,,Сәйкес емес
Dialogue: 0,0:12:04.15,0:12:06.02,Default,,0,0,0,,Біз бірге барамыз ба?
Dialogue: 0,0:12:06.09,0:12:06.79,Default,,0,0,0,,Не?
Dialogue: 0,0:12:07.12,0:12:08.39,Default,,0,0,0,,Мен де жанкүйермін
Dialogue: 0,0:12:08.49,0:12:11.16,Default,,0,0,0,,Ой, өйткені біздің хоббиіміз ұқсас.
Dialogue: 0,0:12:11.29,0:12:12.89,Default,,0,0,0,,Неге ажырастың?
Dialogue: 0,0:12:14.20,0:12:16.20,Default,,0,0,0,,Ал, тамақ ішіп алайық.
Dialogue: 0,0:12:16.30,0:12:17.83,Default,,0,0,0,,Көлікке отырыңыз!
Dialogue: 0,0:12:20.40,0:12:21.94,Default,,0,0,0,,Сиыр етінен жасалған стейк.
Dialogue: 0,0:12:22.87,0:12:23.80,Default,,0,0,0,,Жарыс басталмас бұрын Қвиркіңді қолданба! Өзіңді шаршатпа!
Dialogue: 0,0:12:24.31,0:12:28.48,Default,,0,0,0,,Орыс мафиясынан бір жыл қашып кеттің бе?
Dialogue: 0,0:12:28.74,0:12:30.95,Default,,0,0,0,,Міне, бұл туралы.
Dialogue: 0,0:12:31.21,0:12:33.08,Default,,0,0,0,,Тегін тамақ жеу
Dialogue: 0,0:12:33.18,0:12:36.35,Default,,0,0,0,,Мен сені жай ғана ойын ойнаған ақымақ деп ойладым.
Dialogue: 0,0:12:36.82,0:12:40.32,Default,,0,0,0,,``Decapaton'' деп аталатын ойын бар.
Dialogue: 0,0:12:40.86,0:12:44.23,Default,,0,0,0,,Мен фильм нұсқасындағы басты рөлге өтініш бердім.
Dialogue: 0,0:12:44.46,0:12:47.46,Default,,0,0,0,,Роберт Дауни таңдалды.
Dialogue: 0,0:12:47.53,0:12:48.16,Default,,0,0,0,,Кіші?
Dialogue: 0,0:12:48.23,0:12:50.26,Default,,0,0,0,,Мен кішімін дедім бе?
Dialogue: 0,0:12:50.53,0:12:53.27,Default,,0,0,0,,Сол ойын мені құртты
Dialogue: 0,0:12:53.43,0:12:56.17,Default,,0,0,0,,Орта мектепті тастап, құрбым оны тастап кетті
Dialogue: 0,0:12:56.24,0:13:00.21,Default,,0,0,0,,Сонда да мен ойнай бердім, ал ата-анам менен бас тартты.
Dialogue: 0,0:13:00.77,0:13:02.24,Default,,0,0,0,,Сол кезде мен түсіндім
Dialogue: 0,0:13:02.78,0:13:05.05,Default,,0,0,0,,Менің жаман адам екенімді
Dialogue: 0,0:13:05.21,0:13:07.11,Default,,0,0,0,,Сіз өзгердіңіз
Dialogue: 0,0:13:07.18,0:13:09.85,Default,,0,0,0,,Мен керемет рок опера жазып жатырмын.
Dialogue: 0,0:13:10.12,0:13:11.09,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:13:11.15,0:13:13.39,Default,,0,0,0,,Кэролайнның келесі репетициясы...
Dialogue: 0,0:13:13.49,0:13:16.12,Default,,0,0,0,,Ол Вирджилді В.Криф деп атады.
Dialogue: 0,0:13:16.56,0:13:17.42,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:13:17.49,0:13:21.03,Default,,0,0,0,,Ол рок-опера әлеміндегі супер жұлдыз.
Dialogue: 0,0:13:21.10,0:13:25.33,Default,,0,0,0,,Соңғы 20 жылдағы хит фильмдерді еске түсіріңіз.
Dialogue: 0,0:13:26.23,0:13:26.87,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:26.97,0:13:28.87,Default,,0,0,0,,Олардың барлығына қатысу.
Dialogue: 0,0:13:28.97,0:13:30.97,Default,,0,0,0,,Бірақ әлі ерте.
Dialogue: 0,0:13:31.04,0:13:35.14,Default,,0,0,0,,«Олгердім» десең де, айтқаныңды тыңдаймын.
Dialogue: 0,0:13:35.38,0:13:39.01,Default,,0,0,0,,Сіз жеткілікті естідіңіз. Енді менің тыңдау кезегім.
Dialogue: 0,0:13:39.45,0:13:40.55,Default,,0,0,0,,Әйтеуір...
Dialogue: 0,0:13:40.81,0:13:41.82,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:13:41.88,0:13:44.05,Default,,0,0,0,,БоДжек шабандозы
Dialogue: 0,0:13:44.12,0:13:48.36,Default,,0,0,0,,Шын мәнінде, егер олар сыртқа шығып кетсе, сізге зиян тигізетін фотосуреттер бар.
Dialogue: 0,0:13:48.42,0:13:51.56,Default,,0,0,0,,Провайдерді өзгерту жоспары жоқ
Dialogue: 0,0:13:51.96,0:13:52.49,Default,,0,0,0,,Не?
Dialogue: 0,0:13:52.56,0:13:55.40,Default,,0,0,0,,Кешіріңіз, мен досыммен кешкі ас ішемін.
Dialogue: 0,0:13:55.46,0:13:57.00,Default,,0,0,0,,Жай әңгіме...
Dialogue: 0,0:13:59.97,0:14:02.50,Default,,0,0,0,,Ван Клиф келгенде, мен одан сұраймын.
Dialogue: 0,0:14:03.04,0:14:05.31,Default,,0,0,0,,Бұл Тоддтың мүмкіндігі. Қатты шапалақ.
Dialogue: 0,0:14:05.94,0:14:08.14,Default,,0,0,0,,Барлық әзілдерге күліңіз
Dialogue: 0,0:14:08.24,0:14:11.98,Default,,0,0,0,,Бірақ егер сіз бұл әзіл деп ойласаңыз, олай болмауы мүмкін.
Dialogue: 0,0:14:12.15,0:14:13.28,Default,,0,0,0,,Жоқ… әлі де бір жол бар.
Dialogue: 0,0:14:15.32,0:14:16.08,Default,,0,0,0,,№.
Dialogue: 0,0:14:16.15,0:14:17.28,Default,,0,0,0,,Күлуге жаттығу
Dialogue: 0,0:14:17.42,0:14:19.22,Default,,0,0,0,,Уэйнді әкелді
Dialogue: 0,0:14:19.32,0:14:19.95,Default,,0,0,0,,Кім?
Dialogue: 0,0:14:20.05,0:14:20.55,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:14:20.62,0:14:25.09,Default,,0,0,0,,Сіздің мақалаңыз мұқабада болады, жақсы мақала жазыңыз.
Dialogue: 0,0:14:25.16,0:14:27.19,Default,,0,0,0,,Веб-сайтта мұқаба беті жоқ
Dialogue: 0,0:14:27.26,0:14:28.60,Default,,0,0,0,,Ол бәліш.
Dialogue: 0,0:14:28.86,0:14:29.93,Default,,0,0,0,,«Жақсы»
Dialogue: 0,0:14:30.00,0:14:33.07,Default,,0,0,0,,Екеуі де ұқсас, солай ма?
Dialogue: 0,0:14:34.44,0:14:36.30,Default,,0,0,0,,Менің саған сыйлығым бар
Dialogue: 0,0:14:36.37,0:14:38.27,Default,,0,0,0,,Әуе билеті?
Dialogue: 0,0:14:38.34,0:14:40.07,Default,,0,0,0,,Сан-Францискоға
Dialogue: 0,0:14:40.41,0:14:42.14,Default,,0,0,0,,Дайан Арбустың фотокөрмесі
Dialogue: 0,0:14:42.54,0:14:45.28,Default,,0,0,0,,Мен ризамын рахмет
Dialogue: 0,0:14:48.05,0:14:48.95,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:14:49.25,0:14:50.55,Default,,0,0,0,,Маған эмоция беріңіз
Dialogue: 0,0:14:51.39,0:14:52.95,Default,,0,0,0,,Әлі аяқталмаған
Dialogue: 0,0:14:53.02,0:14:56.32,Default,,0,0,0,,Бірінші нобай да бірінші нобай, рок операның прототипі болып табылады.
Dialogue: 0,0:14:56.39,0:14:59.09,Default,,0,0,0,,Параметр бос орын, бірақ мен сенімді емеспін.
Dialogue: 0,0:14:59.59,0:15:02.26,Default,,0,0,0,,Тодд әнші немесе музыкант емес.
Dialogue: 0,0:15:02.33,0:15:04.93,Default,,0,0,0,,Тіпті мектепті де бітірмеген
Dialogue: 0,0:15:05.17,0:15:07.37,Default,,0,0,0,,Осыны ескеріңіз.
Dialogue: 0,0:15:10.50,0:15:12.11,Default,,0,0,0,,бастайық
Dialogue: 0,0:15:12.21,0:15:16.31,Default,,0,0,0,,1887 жас Эмма Голдман...
Dialogue: 0,0:15:16.51,0:15:17.98,Default,,0,0,0,,5 сағаттан кейін
Dialogue: 0,0:15:18.25,0:15:23.48,Default,,0,0,0,,Мүлдем жоқ...
Dialogue: 0,0:15:24.39,0:15:29.39,Default,,0,0,0,,Құлдар үшін!
Dialogue: 0,0:15:31.49,0:15:33.63,Default,,0,0,0,,Бізге қызықты ән керек
Dialogue: 0,0:15:33.96,0:15:34.66,Default,,0,0,0,,Мен келісемін.
Dialogue: 0,0:15:35.13,0:15:38.13,Default,,0,0,0,,Дегенмен, бұл керемет болды.
Dialogue: 0,0:15:38.47,0:15:39.40,Default,,0,0,0,,Күте тұр… Демек, мені соңында ұмытып қалдыңдар ма?
Dialogue: 0,0:15:40.37,0:15:42.27,Default,,0,0,0,,Келесі айда менің кішкентай театрымда —
Dialogue: 0,0:15:42.34,0:15:45.01,Default,,0,0,0,,«Иса Мәсіхтің супер жұлдызы»
Dialogue: 0,0:15:45.07,0:15:47.34,Default,,0,0,0,,Біз қайталауды жоспарладық.
Dialogue: 0,0:15:47.41,0:15:51.21,Default,,0,0,0,,Эндрю Ллойд Уэббер қиын адам.
Dialogue: 0,0:15:51.58,0:15:52.51,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:15:52.58,0:15:55.42,Default,,0,0,0,,«Тыңдамау уақытша ұят» дейді.
Dialogue: 0,0:15:55.52,0:15:57.65,Default,,0,0,0,,Сұрамасқа амалым жоқ.
Dialogue: 0,0:15:58.25,0:16:01.29,Default,,0,0,0,,Оны 6 апта ішінде аяқтаңыз.
Dialogue: 0,0:16:01.56,0:16:04.73,Default,,0,0,0,,6 апта? Иә бәрібір
Dialogue: 0,0:16:04.99,0:16:08.70,Default,,0,0,0,,Керемет, оны бірден инвесторларға көрсетейік
Dialogue: 0,0:16:08.96,0:16:11.13,Default,,0,0,0,,Оған дейін тойлайық
Dialogue: 0,0:16:13.23,0:16:14.47,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:16:14.74,0:16:19.11,Default,,0,0,0,,Бүгін мен адамның жасырын табиғатын түсіндім.
Dialogue: 0,0:16:19.17,0:16:21.38,Default,,0,0,0,,О, жарайсың Тодд.
Dialogue: 0,0:16:22.11,0:16:23.28,Default,,0,0,0,,Бұл сіз туралы
Dialogue: 0,0:16:23.34,0:16:24.38,Default,,0,0,0,,Менде ештеңе жоқ...
Dialogue: 0,0:16:24.45,0:16:27.11,Default,,0,0,0,,Зояның ішінде Зельда болды, солай ма?
Dialogue: 0,0:16:27.21,0:16:30.05,Default,,0,0,0,,Менің ойымша, жіктеу ақымақтық.
Dialogue: 0,0:16:30.12,0:16:32.22,Default,,0,0,0,,БоДжек
Dialogue: 0,0:16:32.29,0:16:35.42,Default,,0,0,0,,Мүмкін мен де көшіп кетуім мүмкін
Dialogue: 0,0:16:35.66,0:16:37.73,Default,,0,0,0,,Менің үйімнен көшіп барасың ба?
Dialogue: 0,0:16:38.03,0:16:41.06,Default,,0,0,0,,«Тазалау» уақыты келді...
Dialogue: 0,0:16:41.13,0:16:46.13,Default,,0,0,0,,«Ол драмадағы актер кім болды?»
Dialogue: 0,0:16:46.20,0:16:49.14,Default,,0,0,0,,Әр кезде айқайлаудың қажеті жоқ.
Dialogue: 0,0:16:49.20,0:16:50.34,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:16:51.04,0:16:51.74,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:16:52.64,0:16:54.21,Default,,0,0,0,,Ұқыптылық
Dialogue: 0,0:16:54.31,0:16:56.21,Default,,0,0,0,,Сергіту - ең жақсысы
Dialogue: 0,0:16:57.14,0:16:59.15,Default,,0,0,0,,«NOHO театры»
Dialogue: 0,0:16:59.21,0:17:02.78,Default,,0,0,0,,«Newtopia 1-бөлім жақында шығады»
Dialogue: 0,0:17:03.12,0:17:05.62,Default,,0,0,0,,Дайындық тұрақты түрде жүріп жатыр
Dialogue: 0,0:17:05.69,0:17:07.65,Default,,0,0,0,,Инвесторларға арналған презентациялар үшін—
Dialogue: 0,0:17:07.72,0:17:10.32,Default,,0,0,0,,Арнайы әсерлер де қол жетімді
Dialogue: 0,0:17:10.52,0:17:12.29,Default,,0,0,0,,Бұл өте тегіс, қорқынышты
Dialogue: 0,0:17:12.43,0:17:14.50,Default,,0,0,0,,Тодд үшін тым ерте
Dialogue: 0,0:17:14.73,0:17:16.76,Default,,0,0,0,,«Маған», Тодд емес, солай ма?
Dialogue: 0,0:17:17.06,0:17:18.37,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:17:18.43,0:17:21.64,Default,,0,0,0,,Балапанның ұядан тым ерте кеткені сияқты.
Dialogue: 0,0:17:22.67,0:17:24.10,Default,,0,0,0,,Бұл сенің кінәң емес.
Dialogue: 0,0:17:24.20,0:17:26.61,Default,,0,0,0,,Мен бұл бала ұша алады деп ойладым.
Dialogue: 0,0:17:27.21,0:17:30.28,Default,,0,0,0,,Өзіңізді кінәламаңыз
Dialogue: 0,0:17:30.71,0:17:34.45,Default,,0,0,0,,Осындай кезде сізге жақсы агент керек.
Dialogue: 0,0:17:35.22,0:17:39.39,Default,,0,0,0,,Әнді жазып алсаңыз болғаны...
Dialogue: 0,0:17:39.45,0:17:41.49,Default,,0,0,0,,Қойылым басталғалы тұр.
Dialogue: 0,0:17:41.56,0:17:44.53,Default,,0,0,0,,Тоддтың қолынан бәрі келеді.
Dialogue: 0,0:17:44.59,0:17:45.66,Default,,0,0,0,,Белгі
Dialogue: 0,0:17:45.79,0:17:47.26,Default,,0,0,0,,Сондай-ақ осында
Dialogue: 0,0:17:47.33,0:17:49.23,Default,,0,0,0,,Мұнда және мұнда да
Dialogue: 0,0:17:49.30,0:17:51.17,Default,,0,0,0,,Әлеуметтік сақтандыру нөмірі де.
Dialogue: 0,0:17:52.10,0:17:55.40,Default,,0,0,0,,Бұл Вирджилдің қалаған әні.
Dialogue: 0,0:17:55.47,0:17:56.74,Default,,0,0,0,,Керемет әнұранға...
Dialogue: 0,0:17:56.84,0:17:58.27,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:17:58.44,0:18:02.41,Default,,0,0,0,,Тамақ ішіп отырып, ұзақ сөйлесейік.
Dialogue: 0,0:18:02.51,0:18:05.75,Default,,0,0,0,,Дұрыс, мен өте жақсы түсіндім.
Dialogue: 0,0:18:09.38,0:18:11.69,Default,,0,0,0,,Кешіріңіз, бірақ сату вагонынан —
Dialogue: 0,0:18:11.79,0:18:14.52,Default,,0,0,0,,Маған R. Milsap кассетасын ала аласыз ба?
Dialogue: 0,0:18:14.59,0:18:15.69,Default,,0,0,0,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,0:18:17.62,0:18:19.19,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:18:19.26,0:18:21.20,Default,,0,0,0,,«Декапатон 7»?
Dialogue: 0,0:18:21.63,0:18:23.13,Default,,0,0,0,,Бұл әлі жаңа туынды болса да
Dialogue: 0,0:18:23.20,0:18:24.57,Default,,0,0,0,,Тодд, оны орнына қойыңыз.
Dialogue: 0,0:18:24.83,0:18:26.30,Default,,0,0,0,,Он цент?
Dialogue: 0,0:18:26.50,0:18:28.37,Default,,0,0,0,,Егер ол сонда болса
Dialogue: 0,0:18:28.54,0:18:30.84,Default,,0,0,0,,Тодд Сізде бұған уақыт жоқ.
Dialogue: 0,0:18:31.21,0:18:35.61,Default,,0,0,0,,Мен бәрібір сатып аламын, бірақ әнім болмайынша жасамаймын.
Dialogue: 0,0:18:35.71,0:18:37.78,Default,,0,0,0,,Басталған сәт
Dialogue: 0,0:18:38.55,0:18:39.68,Default,,0,0,0,,Әр жолы
Dialogue: 0,0:18:42.58,0:18:43.45,Default,,0,0,0,,Ах… олар ақылды да, сүйкімді де көрінеді, иә, Аня?
Dialogue: 0,0:18:43.52,0:18:47.32,Default,,0,0,0,,Бұрынғыдай иісі бар ма? Иіскеп көрейік.
Dialogue: 0,0:18:47.52,0:18:49.86,Default,,0,0,0,,Пластмасса және балалар еңбегінің иісі
Dialogue: 0,0:18:51.16,0:18:52.33,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:18:52.63,0:18:53.63,Default,,0,0,0,,Бастайсыз ба?
Dialogue: 0,0:18:55.56,0:18:59.13,Default,,0,0,0,,Шығармашылық мотивацияңызды арттыру үшін мұны бір рет орындаңыз
Dialogue: 0,0:18:59.20,0:19:02.80,Default,,0,0,0,,Маған қазір тиіссең, мәңгілікке осылай қаласың.
Dialogue: 0,0:19:02.87,0:19:05.17,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:19:05.24,0:19:06.21,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:06.27,0:19:07.14,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:19:08.38,0:19:09.68,Default,,0,0,0,,10 секундтан кейін
Dialogue: 0,0:19:11.28,0:19:12.28,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:19:14.75,0:19:16.62,Default,,0,0,0,,Жақсы, Декапатон...
Dialogue: 0,0:19:18.92,0:19:21.62,Default,,0,0,0,,Оян, таң атты
Dialogue: 0,0:19:22.62,0:19:23.52,Default,,0,0,0,,Ақыр соңында?
Dialogue: 0,0:19:23.59,0:19:26.39,Default,,0,0,0,,Презентация 30 минуттан тұрады. Ән қандай?
Dialogue: 0,0:19:27.19,0:19:28.60,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:19:30.46,0:19:32.53,Default,,0,0,0,,Оны не үшін шашырасың?
Dialogue: 0,0:19:33.63,0:19:36.84,Default,,0,0,0,,Уақытыңызды алғаным үшін кешіріңіз.
Dialogue: 0,0:19:36.90,0:19:39.64,Default,,0,0,0,,Ол келмейтін сияқты.
Dialogue: 0,0:19:40.67,0:19:41.78,Default,,0,0,0,,Қазірше тек сен мен мен ғана оралдық.
Dialogue: 0,0:19:42.34,0:19:43.48,Default,,0,0,0,,Ей, не болып жатыр?
Dialogue: 0,0:19:43.81,0:19:47.88,Default,,0,0,0,,Ол түні бойы ойын ойнаған сияқты.
Dialogue: 0,0:19:48.38,0:19:49.88,Default,,0,0,0,,Сен мұнымен ән айта аласың ба?
Dialogue: 0,0:19:50.42,0:19:52.35,Default,,0,0,0,,Маған мүмкіндік беріңіз
Dialogue: 0,0:19:58.96,0:20:03.20,Default,,0,0,0,,Цу-чи-то, сосын...
Dialogue: 0,0:20:03.26,0:20:06.27,Default,,0,0,0,,Цу-чи-гэ
Dialogue: 0,0:20:06.50,0:20:10.80,Default,,0,0,0,,Сонда бұл планета жақсы емес.
Dialogue: 0,0:20:10.87,0:20:12.84,Default,,0,0,0,,Ғарышта...
Dialogue: 0,0:20:12.91,0:20:15.64,Default,,0,0,0,,Рок-опера? Бұл ызылдап тұр
Dialogue: 0,0:20:18.65,0:20:20.55,Default,,0,0,0,,«Ньютопия»
Dialogue: 0,0:20:20.65,0:20:21.28,Default,,0,0,0,,Жетеді
Dialogue: 0,0:20:21.88,0:20:25.79,Default,,0,0,0,,Менің көзім түйіншек болған сияқты.
Dialogue: 0,0:20:25.85,0:20:29.69,Default,,0,0,0,,Сені осындай жаман музыка тыңдауға мәжбүрлегенім үшін кешірім сұраймын.
Dialogue: 0,0:20:29.79,0:20:30.82,Default,,0,0,0,,Ван Клиф!
Dialogue: 0,0:20:30.92,0:20:34.29,Default,,0,0,0,,Рок-опера Тодд үшін тым ерте келді.
Dialogue: 0,0:20:34.53,0:20:37.30,Default,,0,0,0,,Тәуелсіздік мүмкін емес болуы мүмкін
Dialogue: 0,0:20:37.43,0:20:39.73,Default,,0,0,0,,Менің досым
Dialogue: 0,0:20:39.93,0:20:41.57,Default,,0,0,0,,Бұл маңызды емес
Dialogue: 0,0:20:41.64,0:20:42.80,Default,,0,0,0,,Келесі, мына жігіт
Dialogue: 0,0:20:42.87,0:20:46.24,Default,,0,0,0,,Тодд жаман, бірақ сен де ең жамансың.
Dialogue: 0,0:20:46.31,0:20:49.81,Default,,0,0,0,,Жалғыз өл, тентек тентек.
Dialogue: 0,0:20:50.94,0:20:53.78,Default,,0,0,0,,Маған қандай қорлық айтып тұрсың?
Dialogue: 0,0:20:53.91,0:20:55.98,Default,,0,0,0,,Бұлай көп айтудың қажеті жоқ...
Dialogue: 0,0:20:56.25,0:20:58.42,Default,,0,0,0,,Мүмкін тағы бір мүмкіндік болар...
Dialogue: 0,0:20:58.52,0:20:59.42,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:20:59.49,0:21:02.46,Default,,0,0,0,,Сен де солай ма, мына бұлан?
Dialogue: 0,0:21:02.76,0:21:04.59,Default,,0,0,0,,Осымен өмір сүр
Dialogue: 0,0:21:09.03,0:21:10.60,Default,,0,0,0,,Барлығына ойын кінәлі
Dialogue: 0,0:21:10.90,0:21:13.93,Default,,0,0,0,,Жоқ, бұл менің кінәм.
Dialogue: 0,0:21:14.00,0:21:16.70,Default,,0,0,0,,Бұл жолы көзім жетті.
Dialogue: 0,0:21:16.77,0:21:19.01,Default,,0,0,0,,Менің жаман адам екенімді
Dialogue: 0,0:21:19.57,0:21:21.81,Default,,0,0,0,,Мен өзімді аяймын
Dialogue: 0,0:21:21.88,0:21:23.78,Default,,0,0,0,,Бұл шынымен де жақсы емес.
Dialogue: 0,0:21:23.84,0:21:26.41,Default,,0,0,0,,Олар рок-опера ойнайды —
Dialogue: 0,0:21:26.48,0:21:28.85,Default,,0,0,0,,Мен мұны тек бизнес деп есептеймін.
Dialogue: 0,0:21:29.85,0:21:32.49,Default,,0,0,0,,Мен мұны да тастаймын.
Dialogue: 0,0:21:32.55,0:21:34.59,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:21:34.76,0:21:36.42,Default,,0,0,0,,Осы жерде сақтаңыз
Dialogue: 0,0:21:36.59,0:21:37.29,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:21:37.46,0:21:40.93,Default,,0,0,0,,Бүгіннен бастап бұл сіздің шкафыңыз.
Dialogue: 0,0:21:40.99,0:21:43.60,Default,,0,0,0,,Барлығы үшін рахмет
Dialogue: 0,0:21:44.33,0:21:46.03,Default,,0,0,0,,Мен бұны жоққа шығарамын.
Dialogue: 0,0:21:49.67,0:21:50.30,Default,,0,0,0,,Бұл…
Dialogue: 0,0:21:50.37,0:21:51.81,Default,,0,0,0,,Қарама, бұл менікі
Dialogue: 0,0:21:51.87,0:21:54.74,Default,,0,0,0,,Бұл жержаңғақ майы туралы сұхбат жазбасы ма?
Dialogue: 0,0:21:54.88,0:21:56.04,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,0:21:56.34,0:21:58.78,Default,,0,0,0,,Сіз кездейсоқ пернелерді басқаныңыз ба?
Dialogue: 0,0:21:58.85,0:22:00.05,Default,,0,0,0,,Негізі мен абдырап қалдым...
Dialogue: 0,0:22:00.95,0:22:02.35,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:22:02.88,0:22:05.99,Default,,0,0,0,,Мен мұны сізбен екі апта болған соң түсіндім.
Dialogue: 0,0:22:06.49,0:22:09.96,Default,,0,0,0,,Жержаңғақ майымен үзу керек.
Dialogue: 0,0:22:10.02,0:22:11.36,Default,,0,0,0,,Сіз менімен бірге болуыңыз керек
Dialogue: 0,0:22:11.53,0:22:13.36,Default,,0,0,0,,Жоқ, мен де түсіндім.
Dialogue: 0,0:22:13.43,0:22:17.33,Default,,0,0,0,,Сіз ақылды және жақсы адамсыз.
Dialogue: 0,0:22:17.40,0:22:18.80,Default,,0,0,0,,Бұл мағынасыз.
Dialogue: 0,0:22:19.03,0:22:21.40,Default,,0,0,0,,Оның мақаласының тақырыбы қандай?
Dialogue: 0,0:22:21.47,0:22:22.54,Default,,0,0,0,,Шартты тақырып...
Dialogue: 0,0:22:22.60,0:22:25.01,Default,,0,0,0,,«90-жылдардың тоғыз жұлдызының фарсы»
Dialogue: 0,0:22:25.07,0:22:25.74,Default,,0,0,0,,Көрдің бе?
Dialogue: 0,0:22:25.81,0:22:29.01,Default,,0,0,0,,БоДжекті сынайтын кітапты оқу керек.
Dialogue: 0,0:22:29.08,0:22:31.81,Default,,0,0,0,,Бұл туралы емес.
Dialogue: 0,0:22:31.88,0:22:34.95,Default,,0,0,0,,Жүрегі күрделі адам туралы әңгіме.
Dialogue: 0,0:22:35.05,0:22:37.58,Default,,0,0,0,,Менікінен айырмашылығы бар ма?
Dialogue: 0,0:22:37.65,0:22:40.02,Default,,0,0,0,,Жержаңғақ майы мейірімді
Dialogue: 0,0:22:40.09,0:22:43.59,Default,,0,0,0,,Ей, ақкөңіл, үлкен жүрек, ақ ниет адам.
Dialogue: 0,0:22:43.66,0:22:44.79,Default,,0,0,0,,Сіздің мәселеңіз –
Dialogue: 0,0:22:45.03,0:22:49.00,Default,,0,0,0,,Зоя Зельда болуға тырысса да.
Dialogue: 0,0:22:49.06,0:22:51.40,Default,,0,0,0,,Болжам жасамаңыз
Dialogue: 0,0:22:51.47,0:22:54.97,Default,,0,0,0,,Сіз Зельданың өмірін өткізе аласыз.
Dialogue: 0,0:22:55.07,0:22:57.40,Default,,0,0,0,,Егер сіз Zelda ойнауды жалғастырсаңыз.
Dialogue: 0,0:22:57.47,0:23:00.71,Default,,0,0,0,,Бірақ бұл нағыз сен емессің.
Dialogue: 0,0:23:01.58,0:23:03.98,Default,,0,0,0,,Адамдар оңайлықпен өзгермейді
Dialogue: 0,0:23:04.08,0:23:07.95,Default,,0,0,0,,Жержаңғақ майы - Зельда, жарқын және таза және сүйікті.
Dialogue: 0,0:23:08.48,0:23:10.78,Default,,0,0,0,,Бірақ сіз және мен Зоямыз.
Dialogue: 0,0:23:08.48,0:23:10.78,Default,,0,0,0,,«Жануарларды сатып алу»
Dialogue: 0,0:23:11.85,0:23:14.09,Default,,0,0,0,,Мұны қайтаруға бола ма?
Dialogue: 0,0:23:14.15,0:23:15.76,Default,,0,0,0,,Түбіртек жоқ
Dialogue: 0,0:23:15.82,0:23:18.13,Default,,0,0,0,,Сіз кеше біздің дүкенге келдіңіз.
Dialogue: 0,0:23:18.43,0:23:19.39,Default,,0,0,0,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,0:23:20.96,0:23:25.00,Default,,0,0,0,,Біз Зоямыз, қараңғы, ақымақ және қатыгез.
Dialogue: 0,0:23:25.83,0:23:26.87,Default,,0,0,0,,(Нацуки Субару) Ол қыз неге мұнда? Әлі күндізгі уақыт қой.
Dialogue: 0,0:23:26.93,0:23:29.74,Default,,0,0,0,,Сіз жақсы актер Марго Мартиндейлсіз
Dialogue: 0,0:23:29.80,0:23:32.14,Default,,0,0,0,,Бұл жағымсыз дәм қалдырады.
Dialogue: 0,0:23:32.57,0:23:35.81,Default,,0,0,0,,Сен не туралы айтып тұрсың?
Dialogue: 0,0:23:36.81,0:23:39.08,Default,,0,0,0,,Ішіңізде қараңғылық бар
Dialogue: 0,0:23:39.78,0:23:43.62,Default,,0,0,0,,Оны тереңге көмуге болады, бірақ...
Dialogue: 0,0:23:43.68,0:23:46.49,Default,,0,0,0,,Сол қараңғылық бір күні ашылады
Dialogue: 0,0:23:46.55,0:23:49.16,Default,,0,0,0,,Маған қоңырау шалыңыз.
Dialogue: 0,0:23:51.99,0:23:53.56,Default,,0,0,0,,Ол жақсы жігіт.
Dialogue: 0,0:24:12.91,0:24:16.85,Default,,0,0,0,,«Жануарларды сатып алу»
Dialogue: 0,0:24:18.35,0:24:24.35,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
