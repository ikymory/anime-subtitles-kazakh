Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:05.17,Default,,0,0,0,,NETFLIX түпнұсқа жұмысы
Dialogue: 0,0:00:05.17,0:00:06.50,Default,,0,0,0,,NETFLIX түпнұсқа жұмыстары
Dialogue: 0,0:00:05.17,0:00:06.50,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:00:06.50,0:00:06.57,Default,,0,0,0,,NETFLIX түпнұсқа жұмыстары
Dialogue: 0,0:00:06.57,0:00:07.74,Default,,0,0,0,,NETFLIX түпнұсқа жұмыстары
Dialogue: 0,0:00:06.57,0:00:07.74,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:00:13.58,0:00:14.74,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:00:15.58,0:00:20.32,Default,,0,0,0,,Хербпен кездескен жігіт қатерлі ісікке шалдыққан.
Dialogue: 0,0:00:20.38,0:00:24.19,Default,,0,0,0,,Мені жек көреді, сондықтан не болар екен деп ойлаймын
Dialogue: 0,0:00:24.32,0:00:27.19,Default,,0,0,0,,Шөпке бару керек пе? Мүлдем жоқ...
Dialogue: 0,0:00:27.32,0:00:30.16,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:00:30.56,0:00:31.73,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:00:33.19,0:00:33.80,Default,,0,0,0,,Сәлем
Dialogue: 0,0:00:35.16,0:00:35.73,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:00:35.80,0:00:39.07,Default,,0,0,0,,Шөппен жалғыз қалма
Dialogue: 0,0:00:39.20,0:00:40.57,Default,,0,0,0,,Өзін жайсыз сезіну
Dialogue: 0,0:00:40.64,0:00:44.47,Default,,0,0,0,,Мен сізбен елес жазушы ретінде танысқым келеді.
Dialogue: 0,0:00:44.54,0:00:46.74,Default,,0,0,0,,Тек екі адамға қалдырмаңыз.
Dialogue: 0,0:00:46.81,0:00:48.24,Default,,0,0,0,,Дәретхана да жоқ
Dialogue: 0,0:00:48.31,0:00:54.22,Default,,0,0,0,,Егер сіз күйеуіңізге оғаш эмодзилер жіберсеңіз, мен сізді кешірмеймін.
Dialogue: 0,0:00:54.35,0:00:55.32,Default,,0,0,0,,Сендер жақсысыңдар ма?
Dialogue: 0,0:00:55.58,0:00:58.12,Default,,0,0,0,,Иә, келісімге келуіңізбен құттықтаймыз.
Dialogue: 0,0:00:58.19,0:00:58.72,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:00:58.79,0:01:01.72,Default,,0,0,0,,Мен үйленемін
Dialogue: 0,0:01:01.79,0:01:03.43,Default,,0,0,0,,Ешкім жалғыз өле алмайды
Dialogue: 0,0:01:03.63,0:01:04.26,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:04.33,0:01:06.36,Default,,0,0,0,,Сіз не үшін кешірім сұрайсыз?
Dialogue: 0,0:01:06.43,0:01:09.83,Default,,0,0,0,,Шөптермен байланысы туралы айт.
Dialogue: 0,0:01:10.17,0:01:13.77,Default,,0,0,0,,Мүмкін мен оған опасыздық жасаған шығармын?
Dialogue: 0,0:01:14.14,0:01:16.24,Default,,0,0,0,,Кітапқа жақсы материал
Dialogue: 0,0:01:16.47,0:01:21.11,Default,,0,0,0,,Бұл билік пен сатқындық туралы әсірелеген әңгіме.
Dialogue: 0,0:01:21.24,0:01:22.68,Default,,0,0,0,,1980 жыл...
Dialogue: 0,0:01:22.74,0:01:23.85,Default,,0,0,0,,Көру аяқталды
Dialogue: 0,0:01:24.11,0:01:24.85,Default,,0,0,0,,Келесіні қараңыз
Dialogue: 0,0:01:25.11,0:01:28.78,Default,,0,0,0,,Мен тек кино көруден шаршадым.
Dialogue: 0,0:01:29.12,0:01:30.19,Default,,0,0,0,,«Бұл кім?» туралы не деуге болады? ойын?
Dialogue: 0,0:01:30.25,0:01:34.86,Default,,0,0,0,,Мен кімге қарап тұрмын? Ол шулы бейбақ.
Dialogue: 0,0:01:35.19,0:01:35.72,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:01:35.79,0:01:36.69,Default,,0,0,0,,Керемет жауап
Dialogue: 0,0:01:36.83,0:01:37.76,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:37.83,0:01:40.16,Default,,0,0,0,,«Мен досыма опасыздық жасадым»
Dialogue: 0,0:01:40.23,0:01:42.36,Default,,0,0,0,,Сосын Тодд араласады.
Dialogue: 0,0:01:42.43,0:01:43.80,Default,,0,0,0,,Иә, үндемеңіз.
Dialogue: 0,0:02:34.28,0:02:37.79,Default,,0,0,0,,БоДжек шабандозы
Dialogue: 0,0:02:41.19,0:02:45.36,Default,,0,0,0,,Бұл жаңа толқын
Dialogue: 0,0:02:45.43,0:02:48.50,Default,,0,0,0,,Сексеннің жырын айтайық
Dialogue: 0,0:02:48.86,0:02:51.30,Default,,0,0,0,,Мен қазір осы жердемін.
Dialogue: 0,0:02:51.40,0:02:52.67,Default,,0,0,0,,«Дөрекі шатыр»
Dialogue: 0,0:02:52.77,0:02:56.17,Default,,0,0,0,,Ас үйді де, дәретхананы да пайдалану дұрыс емес пе?
Dialogue: 0,0:02:56.44,0:02:58.87,Default,,0,0,0,,Құбырлар бірдей, солай емес пе?
Dialogue: 0,0:02:59.17,0:03:02.38,Default,,0,0,0,,Дәретхана мен ас үй Сізге ванна керек пе?
Dialogue: 0,0:03:02.44,0:03:03.71,Default,,0,0,0,,Осылай ойланайық
Dialogue: 0,0:03:03.78,0:03:06.35,Default,,0,0,0,,Әр бөлмедегі құбырлар жарамсыз.
Dialogue: 0,0:03:06.41,0:03:08.68,Default,,0,0,0,,Ақырында теңізге құяды
Dialogue: 0,0:03:10.42,0:03:12.69,Default,,0,0,0,,БоДжек сырасы.
Dialogue: 0,0:03:12.75,0:03:13.49,Default,,0,0,0,,Емдеу
Dialogue: 0,0:03:13.59,0:03:14.72,Default,,0,0,0,,Маған айтпа
Dialogue: 0,0:03:14.82,0:03:18.56,Default,,0,0,0,,Бірақ сахна алдында ішуге болмайды.
Dialogue: 0,0:03:18.63,0:03:20.23,Default,,0,0,0,,Шөптер өте танымал
Dialogue: 0,0:03:20.30,0:03:22.43,Default,,0,0,0,,ABC станциясының адамдары да келе жатыр.
Dialogue: 0,0:03:23.57,0:03:26.73,Default,,0,0,0,,Қараңызшы, сіз бас изеп отырсыз. Бұл жақсы сезінеді.
Dialogue: 0,0:03:26.87,0:03:29.50,Default,,0,0,0,,Бұл көп көңіл бөледі.
Dialogue: 0,0:03:29.57,0:03:33.41,Default,,0,0,0,,Анджела Диас өзінің шалбар костюмімен танымал.
Dialogue: 0,0:03:33.54,0:03:37.45,Default,,0,0,0,,«Болашаққа оралу» Менімен бірге барғыңыз келе ме?
Dialogue: 0,0:03:37.51,0:03:40.22,Default,,0,0,0,,Кеттік. Бұл менің сүйікті фильмім.
Dialogue: 0,0:03:40.28,0:03:43.95,Default,,0,0,0,,Мен 50-ші жылдардағы әзілдерді мүлдем түсінбеймін.
Dialogue: 0,0:03:44.45,0:03:45.49,Default,,0,0,0,,Кокс
Dialogue: 0,0:03:45.69,0:03:48.32,Default,,0,0,0,,Бірақ бұл сіздің кездесуіңіз, солай ма?
Dialogue: 0,0:03:48.39,0:03:50.76,Default,,0,0,0,,Сіз мені мазалайды деп үміттенемін.
Dialogue: 0,0:03:50.86,0:03:54.56,Default,,0,0,0,,Үш адам бірге, бір адам, үш велосипедпен бірге
Dialogue: 0,0:03:54.66,0:03:56.00,Default,,0,0,0,,Сонымен, екі адам болса, велосипедті пайдалану керек пе?
Dialogue: 0,0:03:56.30,0:03:58.77,Default,,0,0,0,,Бұл Казаз шөпі еді.
Dialogue: 0,0:03:58.93,0:03:59.87,Default,,0,0,0,,Бұл тамаша болды
Dialogue: 0,0:03:59.93,0:04:03.94,Default,,0,0,0,,Менің бұлай айтуға батылым жетпейді.
Dialogue: 0,0:04:04.24,0:04:06.91,Default,,0,0,0,,Көрермендерді жылы ұстадым.
Dialogue: 0,0:04:06.98,0:04:09.91,Default,,0,0,0,,Енді келесі кезекте Б.Атшы.
Dialogue: 0,0:04:10.88,0:04:12.48,Default,,0,0,0,,Бүгінгі кеш үшін рахмет.
Dialogue: 0,0:04:12.88,0:04:14.38,Default,,0,0,0,,LA жақсы
Dialogue: 0,0:04:14.68,0:04:18.62,Default,,0,0,0,,Сүйкімді қыз қандай да бір себептермен бейтаныс жігітпен кездесіп қалады.
Dialogue: 0,0:04:18.69,0:04:19.79,Default,,0,0,0,,Қараңызшы, сонда да.
Dialogue: 0,0:04:21.36,0:04:23.26,Default,,0,0,0,,Жас ханым, бұл сіздің жігітіңіз бе?
Dialogue: 0,0:04:23.32,0:04:24.66,Default,,0,0,0,,Менің күйеуім
Dialogue: 0,0:04:24.73,0:04:26.66,Default,,0,0,0,,Бұл ол болуы мүмкін бе?
Dialogue: 0,0:04:26.73,0:04:27.93,Default,,0,0,0,,Маған кейінірек қоңырау шалыңыз
Dialogue: 0,0:04:29.53,0:04:31.37,Default,,0,0,0,,Жай әзіл.
Dialogue: 0,0:04:31.63,0:04:33.37,Default,,0,0,0,,Өтірік Мен байыптымын
Dialogue: 0,0:04:37.91,0:04:40.91,Default,,0,0,0,,Осы күшті алкогольді күн ортасында ішу керек пе?
Dialogue: 0,0:04:41.74,0:04:45.55,Default,,0,0,0,,25 центтік кеңес? Мен тіпті бензин сатып ала алмаймын
Dialogue: 0,0:04:45.95,0:04:46.61,Default,,0,0,0,,Ішемін бе?
Dialogue: 0,0:04:46.68,0:04:49.62,Default,,0,0,0,,Осыдан кейін тыңдау
Dialogue: 0,0:04:49.75,0:04:51.95,Default,,0,0,0,,Жақсы жұмыс бар ма?
Dialogue: 0,0:04:52.02,0:04:53.66,Default,,0,0,0,,Мен жарнамадан шаршадым
Dialogue: 0,0:04:53.72,0:04:56.72,Default,,0,0,0,,«Енді сіз осы бағамен 2 дана ала аласыз!»
Dialogue: 0,0:04:56.79,0:04:59.73,Default,,0,0,0,,«Енді сіз бір қосымша аласыз», солай ма?
Dialogue: 0,0:04:59.79,0:05:00.70,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:05:00.76,0:05:02.33,Default,,0,0,0,,Неліктен екі?
Dialogue: 0,0:05:02.40,0:05:06.67,Default,,0,0,0,,Мен тек бір затты қалаймын, оны басынан бастап жарты бағамен жасаңыз.
Dialogue: 0,0:05:06.73,0:05:09.00,Default,,0,0,0,,Басты рөлді ойнауыңды сұрамаймын.
Dialogue: 0,0:05:09.07,0:05:11.54,Default,,0,0,0,,Бірақ мен жақсы рөл алғым келеді.
Dialogue: 0,0:05:11.61,0:05:13.34,Default,,0,0,0,,Сен және мен—
Dialogue: 0,0:05:13.41,0:05:16.58,Default,,0,0,0,,Егер бәрі жақсы болса, бұл осында.
Dialogue: 0,0:05:16.64,0:05:19.01,Default,,0,0,0,,ABC станциясынан естідіңіз бе?
Dialogue: 0,0:05:19.08,0:05:23.32,Default,,0,0,0,,Мені үлкен есім келе жатқан шараға шақырды.
Dialogue: 0,0:05:23.42,0:05:26.02,Default,,0,0,0,,Бағдарлама жоспарыңызды көрсетіңіз
Dialogue: 0,0:05:26.32,0:05:28.82,Default,,0,0,0,,Басқа адам босаңсыған кезде?
Dialogue: 0,0:05:28.92,0:05:31.99,Default,,0,0,0,,Бұл сіздің ең жақсы мүмкіндігіңіз. Сіз ақылдысыз.
Dialogue: 0,0:05:32.59,0:05:34.33,Default,,0,0,0,,Бұл өте сәнді.
Dialogue: 0,0:05:34.46,0:05:35.66,Default,,0,0,0,,Мына жерге қара.
Dialogue: 0,0:05:35.83,0:05:37.73,Default,,0,0,0,,Джойс ДеВитт
Dialogue: 0,0:05:37.80,0:05:39.40,Default,,0,0,0,,Анджела Диас та
Dialogue: 0,0:05:39.50,0:05:41.87,Default,,0,0,0,,Бұл костюм сәнді
Dialogue: 0,0:05:42.04,0:05:43.47,Default,,0,0,0,,Әдемі пальто
Dialogue: 0,0:05:43.94,0:05:45.94,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:05:46.01,0:05:48.51,Default,,0,0,0,,Үйге киш әкелейік
Dialogue: 0,0:05:48.58,0:05:49.94,Default,,0,0,0,,Маусымдағы таңғы ас.
Dialogue: 0,0:05:50.01,0:05:51.01,Default,,0,0,0,,Казаз шөпі?
Dialogue: 0,0:05:51.08,0:05:52.98,Default,,0,0,0,,Шетелдік болып көріну
Dialogue: 0,0:05:53.05,0:05:54.95,Default,,0,0,0,,Бон Джорно Бон Джови…
Dialogue: 0,0:05:55.02,0:05:57.45,Default,,0,0,0,,Иә! Бұл жаман ағылшын...
Dialogue: 0,0:05:57.62,0:05:59.69,Default,,0,0,0,,Мен жұлдызды қарызға аламын
Dialogue: 0,0:05:59.75,0:06:00.52,Default,,0,0,0,,О
Dialogue: 0,0:06:00.59,0:06:02.59,Default,,0,0,0,,Кейінірек
Dialogue: 0,0:06:02.66,0:06:03.73,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:06:03.83,0:06:09.60,Default,,0,0,0,,Ол үшін қызғылт болашақ, мен үшін қызық емес жарнама?
Dialogue: 0,0:06:09.66,0:06:10.47,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:06:10.63,0:06:14.74,Default,,0,0,0,,Шөп сенің жетістікке жететініңді айтады
Dialogue: 0,0:06:15.14,0:06:15.77,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:15.94,0:06:21.11,Default,,0,0,0,,Бірақ мен ол жұлдыз болған соң өзгермей ме деп қорқамын.
Dialogue: 0,0:06:21.41,0:06:22.54,Default,,0,0,0,,Бұл сізді семіртеді ме?
Dialogue: 0,0:06:22.64,0:06:24.68,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:06:24.91,0:06:26.58,Default,,0,0,0,,Мен салмақ қоспаймын ба?
Dialogue: 0,0:06:26.68,0:06:27.12,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:27.38,0:06:28.72,Default,,0,0,0,,​​Қайсысы?
Dialogue: 0,0:06:28.85,0:06:29.58,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:06:30.05,0:06:31.52,Default,,0,0,0,,Мұнай қоймасы
Dialogue: 0,0:06:31.69,0:06:35.59,Default,,0,0,0,,Голливуд астындағы қара май
Dialogue: 0,0:06:35.69,0:06:38.13,Default,,0,0,0,,Егер ол батып кетсе, тым кеш болуы мүмкін
Dialogue: 0,0:06:38.39,0:06:40.03,Default,,0,0,0,,Ғылым туралы әңгіме?
Dialogue: 0,0:06:40.09,0:06:41.96,Default,,0,0,0,,Жоқ, бұл ұқсастық.
Dialogue: 0,0:06:42.03,0:06:42.96,Default,,0,0,0,,Оның мағынасы жоқ
Dialogue: 0,0:06:43.06,0:06:45.13,Default,,0,0,0,,Негізі... Мен туған жеріме қайтамын.
Dialogue: 0,0:06:45.47,0:06:48.04,Default,,0,0,0,,Сіз шөптер туралы білесіз бе?
Dialogue: 0,0:06:48.10,0:06:51.74,Default,,0,0,0,,Ол мені емес
Dialogue: 0,0:06:52.44,0:06:53.78,Default,,0,0,0,,Менің тағдырымның жолында жатыр –
Dialogue: 0,0:06:53.94,0:06:58.05,Default,,0,0,0,,Егер сіз мені Хербке дейін кездестірсеңіз...
Dialogue: 0,0:06:58.41,0:06:59.55,Default,,0,0,0,,Сіз мені еріктірдіңіз бе?
Dialogue: 0,0:06:59.71,0:07:00.41,Default,,0,0,0,,Шарлотта
Dialogue: 0,0:07:00.48,0:07:02.68,Default,,0,0,0,,Мүмкін емес. Неге екенін білесіз бе?
Dialogue: 0,0:07:03.42,0:07:04.69,Default,,0,0,0,,Өйткені ол қорқақ
Dialogue: 0,0:07:05.45,0:07:08.69,Default,,0,0,0,,Қалағаныңызды бірден қалтаңызға салыңыз
Dialogue: 0,0:07:08.82,0:07:10.89,Default,,0,0,0,,«Гриффит обсерваториясы»
Dialogue: 0,0:07:10.96,0:07:13.09,Default,,0,0,0,,Бұл тамаша қала.
Dialogue: 0,0:07:13.56,0:07:15.10,Default,,0,0,0,,Мені мұнда неге әкелдің?
Dialogue: 0,0:07:15.50,0:07:17.87,Default,,0,0,0,,Менімен дуэль жасағың келе ме?
Dialogue: 0,0:07:17.93,0:07:18.87,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:07:18.93,0:07:20.74,Default,,0,0,0,,Дуэльдің себебі бар
Dialogue: 0,0:07:20.80,0:07:22.10,Default,,0,0,0,,Ууух!
Dialogue: 0,0:07:22.77,0:07:23.97,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:07:24.94,0:07:25.71,Default,,0,0,0,,Ал Шинохара—
Dialogue: 0,0:07:25.94,0:07:28.14,Default,,0,0,0,,Күндізгі жезөкше...
Dialogue: 0,0:07:28.21,0:07:31.48,Default,,0,0,0,,Мен атақты адамдарды көріп тұрмын.
Dialogue: 0,0:07:31.68,0:07:34.75,Default,,0,0,0,,Сіз қалағанның бәрін ала аласыз—
Dialogue: 0,0:07:34.85,0:07:37.72,Default,,0,0,0,,Мен мұнда бесіктеніп жатырмын.
Dialogue: 0,0:07:37.82,0:07:39.85,Default,,0,0,0,,Соңғы уақытта танымал болды.
Dialogue: 0,0:07:39.92,0:07:42.92,Default,,0,0,0,,Қол алысқаннан төмен тию жақсы.
Dialogue: 0,0:07:42.99,0:07:43.79,Default,,0,0,0,,Тыңдау
Dialogue: 0,0:07:43.86,0:07:46.79,Default,,0,0,0,,ABC станциясы менің бағдарлама жоспарымды сатып алады
Dialogue: 0,0:07:46.86,0:07:48.86,Default,,0,0,0,,Бұл рас па? Қандай бағдарлама?
Dialogue: 0,0:07:49.00,0:07:52.00,Default,,0,0,0,,Тақырып «Ат немесе шу»
Dialogue: 0,0:07:52.17,0:07:54.87,Default,,0,0,0,,Сәттілік тілеймін.
Dialogue: 0,0:07:54.94,0:07:57.04,Default,,0,0,0,,Қойылымның басты кейіпкері – жылқы.
Dialogue: 0,0:07:57.10,0:07:58.14,Default,,0,0,0,,дедім
Dialogue: 0,0:07:58.51,0:08:02.54,Default,,0,0,0,,«Бұл шоудың жұлдызы - БоДжек.»
Dialogue: 0,0:08:02.61,0:08:03.04,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:08:03.11,0:08:04.48,Default,,0,0,0,,Жауабы «жоқ»
Dialogue: 0,0:08:04.58,0:08:05.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:05.11,0:08:07.62,Default,,0,0,0,,Мен «өтінемін» деп сұрағанымда, ол «Жарайды» деді.
Dialogue: 0,0:08:07.92,0:08:10.82,Default,,0,0,0,,Сіз басты рөлді ойнауға дайынсыз ба?
Dialogue: 0,0:08:10.89,0:08:13.15,Default,,0,0,0,,Басты кейіпкер? Әрине жасаймын
Dialogue: 0,0:08:13.65,0:08:15.09,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,0:08:17.56,0:08:18.79,Default,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,0:08:18.86,0:08:19.86,Default,,0,0,0,,Э-э…
Dialogue: 0,0:08:19.93,0:08:20.56,Default,,0,0,0,,Осылайша?
Dialogue: 0,0:08:20.63,0:08:22.70,Default,,0,0,0,,Импульс жоқ
Dialogue: 0,0:08:22.76,0:08:24.00,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:08:25.10,0:08:26.63,Default,,0,0,0,,Ах… Тога…
Dialogue: 0,0:08:26.77,0:08:29.07,Default,,0,0,0,,Телехикая жасайық!
Dialogue: 0,0:08:29.17,0:08:34.04,Default,,0,0,0,,Американдық отбасылардың шындығын ашық бейнелеп көрейік.
Dialogue: 0,0:08:35.08,0:08:36.91,Default,,0,0,0,,Бұл әзіл. Бұл ақша табу туралы!
Dialogue: 0,0:08:37.04,0:08:38.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:40.68,0:08:43.05,Default,,0,0,0,,Бұл дәуір гранж
Dialogue: 0,0:08:43.15,0:08:45.75,Default,,0,0,0,,Фланель көйлек киіңіз
Dialogue: 0,0:08:45.85,0:08:48.22,Default,,0,0,0,,90-шы жылдардағы гранж
Dialogue: 0,0:08:48.29,0:08:50.09,Default,,0,0,0,,Сиэтлде туған жанр
Dialogue: 0,0:08:50.09,0:08:51.93,Default,,0,0,0,,Сиэтлде дүниеге келген жанр
Dialogue: 0,0:08:50.09,0:08:51.93,Default,,0,0,0,,«Paramount Studios»
Dialogue: 0,0:08:51.93,0:08:52.76,Default,,0,0,0,,«Paramount Studios»
Dialogue: 0,0:08:52.86,0:08:56.03,Default,,0,0,0,,Бұл көріністе мен жемпірді жамандадым.
Dialogue: 0,0:08:56.13,0:08:59.67,Default,,0,0,0,,Неліктен келесі көріністе оны киіп жүрсіз?
Dialogue: 0,0:08:59.80,0:09:02.90,Default,,0,0,0,,Айтқаныңды ұмытатын ақымақсың ба?
Dialogue: 0,0:09:02.97,0:09:04.11,Default,,0,0,0,,Мұнда ма еді?
Dialogue: 0,0:09:04.21,0:09:06.81,Default,,0,0,0,,Маған әзілдерді түсіндірме
Dialogue: 0,0:09:06.91,0:09:09.58,Default,,0,0,0,,Неліктен сұрақ?
Dialogue: 0,0:09:09.68,0:09:14.68,Default,,0,0,0,,Сценарийде неліктен оны қайта кигіңіз келетінін жазсаңыз екен.
Dialogue: 0,0:09:14.82,0:09:16.75,Default,,0,0,0,,Бұл сіздің сценарийіңіз, солай ма?
Dialogue: 0,0:09:16.82,0:09:17.82,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:09:17.95,0:09:19.82,Default,,0,0,0,,Эй, сценарийді орында.
Dialogue: 0,0:09:19.99,0:09:21.89,Default,,0,0,0,,Мен сұраған әңгіме ше?
Dialogue: 0,0:09:22.06,0:09:24.19,Default,,0,0,0,,Рэп сахнасы ше?
Dialogue: 0,0:09:24.26,0:09:27.96,Default,,0,0,0,,Менің ойыма жақсы рифма келмейді
Dialogue: 0,0:09:28.06,0:09:31.70,Default,,0,0,0,,Маған да роликті киюге рұқсат етіңіз.
Dialogue: 0,0:09:31.77,0:09:33.27,Default,,0,0,0,,Бұл ең озық рөл.
Dialogue: 0,0:09:33.57,0:09:35.67,Default,,0,0,0,,Тек жұмысқа барыңыз.
Dialogue: 0,0:09:35.77,0:09:37.74,Default,,0,0,0,,Сіз нәсілшілсіз
Dialogue: 0,0:09:37.81,0:09:40.24,Default,,0,0,0,,Бұл менің сату нүктесі.
Dialogue: 0,0:09:40.31,0:09:43.95,Default,,0,0,0,,Бұдан былай өзім жазамын.
Dialogue: 0,0:09:44.01,0:09:46.61,Default,,0,0,0,,«Ат немесе шу» ойынын атсыз ойнаңыз.
Dialogue: 0,0:09:47.11,0:09:48.08,Default,,0,0,0,,Боджак
Dialogue: 0,0:09:48.22,0:09:53.09,Default,,0,0,0,,Көрермендер Американың түкпір-түкпірінен сізді көруге келді.
Dialogue: 0,0:09:53.15,0:09:54.72,Default,,0,0,0,,Көңіліңізді қалдырғыңыз келе ме?
Dialogue: 0,0:09:55.62,0:09:56.76,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:09:56.86,0:10:00.73,Default,,0,0,0,,Сценарий дайын болғанша істеймін.
Dialogue: 0,0:10:00.86,0:10:03.80,Default,,0,0,0,,Бұл шөпке емес, аудиторияға арналған.
Dialogue: 0,0:10:03.86,0:10:05.23,Default,,0,0,0,,30 000 долларға дейін кіреді.
Dialogue: 0,0:10:05.30,0:10:08.14,Default,,0,0,0,,БоДжек шабандозы
Dialogue: 0,0:10:08.24,0:10:10.91,Default,,0,0,0,,Мен киім ауыстыратын бөлмеде сол сусынды сұраймын.
Dialogue: 0,0:10:13.87,0:10:14.71,Default,,0,0,0,,«Жазу»
Dialogue: 0,0:10:14.71,0:10:16.84,Default,,0,0,0,,«Жазу»
Dialogue: 0,0:10:14.71,0:10:16.84,Default,,0,0,0,,Бар емес пе?
Dialogue: 0,0:10:16.91,0:10:18.78,Default,,0,0,0,,Көмекші жұмыстан босатылады.
Dialogue: 0,0:10:19.35,0:10:21.68,Default,,0,0,0,,Сіз күлуге дайынсыз ба?
Dialogue: 0,0:10:24.75,0:10:26.82,Default,,0,0,0,,Не? Оның дәмі қорқынышты.
Dialogue: 0,0:10:29.06,0:10:29.82,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:10:29.89,0:10:32.19,Default,,0,0,0,,Сәлем, Каролин, қалайсың?
Dialogue: 0,0:10:32.26,0:10:33.63,Default,,0,0,0,,Негізі мен уайымдап тұрмын.
Dialogue: 0,0:10:33.76,0:10:35.93,Default,,0,0,0,,Тым әдемі болу
Dialogue: 0,0:10:36.66,0:10:38.17,Default,,0,0,0,,Қандай тамаша есеп.
Dialogue: 0,0:10:38.23,0:10:40.74,Default,,0,0,0,,Мен агентті ауыстырамын.
Dialogue: 0,0:10:40.94,0:10:43.84,Default,,0,0,0,,Жылқы жүзді БоДжек?
Dialogue: 0,0:10:43.97,0:10:45.64,Default,,0,0,0,,Жақсы жаңалық
Dialogue: 0,0:10:45.74,0:10:48.28,Default,,0,0,0,,Мен сені сүйгім келеді
Dialogue: 0,0:10:48.34,0:10:49.18,Default,,0,0,0,,Онда
Dialogue: 0,0:10:49.31,0:10:52.81,Default,,0,0,0,,Сіз қандай рөл үшін өлесіз?
Dialogue: 0,0:10:52.91,0:10:55.78,Default,,0,0,0,,Купальник үлгілерімен бірге ойнаудан басқа
Dialogue: 0,0:10:57.12,0:10:58.35,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:10:58.65,0:11:03.12,Default,,0,0,0,,Мен де өлсем, мен купальник үлгісімен жерленгім келеді.
Dialogue: 0,0:11:03.99,0:11:07.19,Default,,0,0,0,,Марв Қандай жақсы жаңалық бар?
Dialogue: 0,0:11:07.36,0:11:10.20,Default,,0,0,0,,«Хатшылық» үшін өндірістік шешім
Dialogue: 0,0:11:10.36,0:11:13.93,Default,,0,0,0,,Басты рөлде Вэл Килмер
Dialogue: 0,0:11:14.00,0:11:16.87,Default,,0,0,0,,Сене алар емеспін, рахмет
Dialogue: 0,0:11:16.94,0:11:20.41,Default,,0,0,0,,Бұдан былай келеңсіздіктерден сақ болыңыз.
Dialogue: 0,0:11:20.71,0:11:23.34,Default,,0,0,0,,Төмен профильді сақтаңыз
Dialogue: 0,0:11:23.44,0:11:27.78,Default,,0,0,0,,Енді кесіп алайық. Маңызды түскі астың уақыты келді.
Dialogue: 0,0:11:29.82,0:11:31.12,Default,,0,0,0,,Ең алдымен—
Dialogue: 0,0:11:31.19,0:11:33.82,Default,,0,0,0,,«Ат немесе дүрбелең» туралы жаңалықтар
Dialogue: 0,0:11:33.89,0:11:35.42,Default,,0,0,0,,Мен не істедім?
Dialogue: 0,0:11:35.69,0:11:37.46,Default,,0,0,0,,Мистер Херб Казас—
Dialogue: 0,0:11:37.73,0:11:41.73,Default,,0,0,0,,лайықсыз мінез-құлық үшін қамауға алынды
Dialogue: 0,0:11:41.96,0:11:46.07,Default,,0,0,0,,Ер адаммен әрекет жасағаны үшін ұсталды
Dialogue: 0,0:11:46.13,0:11:48.10,Default,,0,0,0,,Наразылықпен
Dialogue: 0,0:11:48.34,0:11:50.70,Default,,0,0,0,,``Ума Ка Назо'' балаларға арналған бағдарлама.
Dialogue: 0,0:11:50.77,0:11:53.21,Default,,0,0,0,,Жаратушы дегеніміз не?
Dialogue: 0,0:11:53.27,0:11:58.01,Default,,0,0,0,,Бұл Американы құртып жатқан әрекет.
Dialogue: 0,0:11:58.11,0:12:03.35,Default,,0,0,0,,Уф…
Dialogue: 0,0:12:03.48,0:12:06.82,Default,,0,0,0,,«Ат немесе дүрбелең»
Dialogue: 0,0:12:06.95,0:12:08.39,Default,,0,0,0,,Мен мойындаймын
Dialogue: 0,0:12:08.92,0:12:09.99,Default,,0,0,0,,Іс жүзінде гей
Dialogue: 0,0:12:10.06,0:12:10.79,Default,,0,0,0,,Бірінші адамның атын жазғаныңыздан бері қанша секунд өтті?
Dialogue: 0,0:12:11.06,0:12:14.10,Default,,0,0,0,,Өйткені басында жақсы араласпадық.
Dialogue: 0,0:12:14.20,0:12:16.40,Default,,0,0,0,,Жоқ, «үлкен ақымақ»?
Dialogue: 0,0:12:16.50,0:12:19.37,Default,,0,0,0,,Бірақ ол жаман адам емес, солай ма?
Dialogue: 0,0:12:19.47,0:12:23.87,Default,,0,0,0,,Мен жұмыстан босатылсам, мен біттім.
Dialogue: 0,0:12:24.14,0:12:25.84,Default,,0,0,0,,Маған көмек керек
Dialogue: 0,0:12:26.31,0:12:28.84,Default,,0,0,0,,Сіз мен жағында болуыңыз керек.
Dialogue: 0,0:12:28.94,0:12:31.05,Default,,0,0,0,,Уақыт өте нашар
Dialogue: 0,0:12:31.38,0:12:34.35,Default,,0,0,0,,Менің де сұрағым келмейді
Dialogue: 0,0:12:34.45,0:12:35.25,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:36.35,0:12:38.42,Default,,0,0,0,,Қашықтықты сезінбеу
Dialogue: 0,0:12:41.09,0:12:43.42,Default,,0,0,0,,Мен сенің жаныңда боламын
Dialogue: 0,0:12:43.76,0:12:45.86,Default,,0,0,0,,Мұның бәрі сіздің арқаңызда
Dialogue: 0,0:12:45.93,0:12:48.30,Default,,0,0,0,,Мен сен осылай айтасың деп ойладым.
Dialogue: 0,0:12:48.50,0:12:51.77,Default,,0,0,0,,Гриффит обсерваториясына барыңыз—
Dialogue: 0,0:12:51.93,0:12:54.00,Default,,0,0,0,,Кәне бесті жоғары қоямыз
Dialogue: 0,0:12:54.30,0:12:55.44,Default,,0,0,0,,Мен сұрасам бола ма?
Dialogue: 0,0:12:55.50,0:12:59.47,Default,,0,0,0,,Балалар, сендерде оргия бар ма?
Dialogue: 0,0:12:59.77,0:13:01.08,Default,,0,0,0,,Мұндай сурет...
Dialogue: 0,0:13:01.18,0:13:03.54,Default,,0,0,0,,Бұл ақымақ сұрақ болды.
Dialogue: 0,0:13:08.32,0:13:09.15,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:13:09.45,0:13:12.85,Default,,0,0,0,,Сондықтан біз «сау тіс - ең жақсы» дейміз
Dialogue: 0,0:13:12.92,0:13:15.49,Default,,0,0,0,,Мен осылай дедім.
Dialogue: 0,0:13:15.89,0:13:20.19,Default,,0,0,0,,Алдымен «тіс щеткасын орау» деп айтсаңыз, ол тиімдірек болады.
Dialogue: 0,0:13:23.03,0:13:25.47,Default,,0,0,0,,БоДжек, менің саған айтар сөзім бар.
Dialogue: 0,0:13:26.27,0:13:29.20,Default,,0,0,0,,Күн де ​​келді.
Dialogue: 0,0:13:29.90,0:13:31.94,Default,,0,0,0,,Мен сіздің уақытыңызды алмаймын
Dialogue: 0,0:13:32.07,0:13:34.34,Default,,0,0,0,,Жұмыс уақытына әсер ететін заттар
Dialogue: 0,0:13:34.51,0:13:35.54,Default,,0,0,0,,Шөп күйдіріледі
Dialogue: 0,0:13:35.88,0:13:39.21,Default,,0,0,0,,«Жоқ»? Бұл шешім
Dialogue: 0,0:13:39.35,0:13:41.18,Default,,0,0,0,,Шөп – жақсы адам.
Dialogue: 0,0:13:41.32,0:13:45.09,Default,,0,0,0,,Бірақ бұл бизнес, ақша жоғалтуға болмайды.
Dialogue: 0,0:13:45.45,0:13:46.25,Default,,0,0,0,,Сосын мен де...
Dialogue: 0,0:13:46.32,0:13:47.56,Default,,0,0,0,,Маған кетуге жол берме
Dialogue: 0,0:13:47.82,0:13:49.26,Default,,0,0,0,,Сен жұлдызсың
Dialogue: 0,0:13:49.36,0:13:52.36,Default,,0,0,0,,Қиын болса да шешім қабылдау керек
Dialogue: 0,0:13:52.49,0:13:56.10,Default,,0,0,0,,Ең жақын досым үшін шоудан кетуім керек пе?
Dialogue: 0,0:13:56.23,0:13:58.30,Default,,0,0,0,,Мен үнсіз жұмыс істей беруім керек пе?
Dialogue: 0,0:13:58.57,0:14:01.14,Default,,0,0,0,,Қазір тыңдаңыз.
Dialogue: 0,0:14:01.34,0:14:02.30,Default,,0,0,0,,Бұл жұлдыз
Dialogue: 0,0:14:02.40,0:14:05.51,Default,,0,0,0,,Бірақ жол енді ғана басталды
Dialogue: 0,0:14:06.11,0:14:08.11,Default,,0,0,0,,Нені таңдағаныңыз маңызды емес.
Dialogue: 0,0:14:08.21,0:14:09.51,Default,,0,0,0,,Бірақ сіз не білесіз?
Dialogue: 0,0:14:09.58,0:14:13.21,Default,,0,0,0,,Егер сіз ең жақын досыңызды қазір таңдасаңыз, сіз ешқандай жүлде ұтып алмайсыз.
Dialogue: 0,0:14:13.28,0:14:17.95,Default,,0,0,0,,«Хатшылықтың» басты кейіпкері бола алмайды
Dialogue: 0,0:14:18.12,0:14:20.49,Default,,0,0,0,,Бұл осы саланың тілі.
Dialogue: 0,0:14:20.86,0:14:23.62,Default,,0,0,0,,«Ақылсыз істер жасама»
Dialogue: 0,0:14:23.89,0:14:25.39,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:14:25.49,0:14:28.16,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:14:28.23,0:14:31.10,Default,,0,0,0,,Бұл туралы біз күнде айтамыз
Dialogue: 0,0:14:31.33,0:14:34.10,Default,,0,0,0,,Мен сізде жауап бар екенін білемін.
Dialogue: 0,0:14:34.44,0:14:36.90,Default,,0,0,0,,Бірақ неге мені таң қалдырмасқа?
Dialogue: 0,0:14:38.04,0:14:39.11,Default,,0,0,0,,Жақсы таңдау.
Dialogue: 0,0:14:39.17,0:14:43.41,Default,,0,0,0,,Бұл қиын, бірақ Херб түсінеді.
Dialogue: 0,0:14:43.58,0:14:46.55,Default,,0,0,0,,Шоу басталып жатыр, барыңыз.
Dialogue: 0,0:14:46.88,0:14:49.15,Default,,0,0,0,,Бұл нәтижелі пікірталас болды.
Dialogue: 0,0:14:49.32,0:14:51.29,Default,,0,0,0,,Бұл мен қайта істегім келмейтін нәрсе.
Dialogue: 0,0:14:57.59,0:14:59.16,Default,,0,0,0,,Көру уақыты
Dialogue: 0,0:15:00.53,0:15:04.47,Default,,0,0,0,,Сіз күткен адам пайда болады.
Dialogue: 0,0:15:12.64,0:15:14.91,Default,,0,0,0,,Бұл бар емес пе?
Dialogue: 0,0:15:14.98,0:15:16.64,Default,,0,0,0,,Көмекші жұмыстан босатылады.
Dialogue: 0,0:15:18.28,0:15:20.21,Default,,0,0,0,,«Осы жерден Малибу»
Dialogue: 0,0:15:20.35,0:15:23.32,Default,,0,0,0,,«Хатшылықтағы» басты рөл туралы не деуге болады?
Dialogue: 0,0:15:23.42,0:15:25.02,Default,,0,0,0,,Бірде күтуде -
Dialogue: 0,0:15:25.09,0:15:28.16,Default,,0,0,0,,Түсінбестен сөреде қалды
Dialogue: 0,0:15:28.26,0:15:29.46,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:15:29.56,0:15:32.56,Default,,0,0,0,,Шөптің үйі әлдеқайда үлкен
Dialogue: 0,0:15:32.69,0:15:35.70,Default,,0,0,0,,Саған опасыздық жасасам да, бұл үлкен жетістік болды.
Dialogue: 0,0:15:36.06,0:15:36.50,Default,,0,0,0,,Йосе
Dialogue: 0,0:15:36.56,0:15:37.33,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:15:37.40,0:15:40.94,Default,,0,0,0,,Сізге бірден үйге бару қажет болуы мүмкін. Көлікті айнала қалдырыңыз.
Dialogue: 0,0:15:41.00,0:15:42.60,Default,,0,0,0,,Мен жұмысқа орналастым
Dialogue: 0,0:15:47.41,0:15:49.41,Default,,0,0,0,,BoJack?
Dialogue: 0,0:15:49.51,0:15:51.21,Default,,0,0,0,,Мынау түтіккен бет.
Dialogue: 0,0:15:51.28,0:15:53.71,Default,,0,0,0,,Ішің «кінәға» толы ма?
Dialogue: 0,0:15:57.08,0:15:59.15,Default,,0,0,0,,Сіз де қорқынышты көрінесіз, солай емес пе?
Dialogue: 0,0:15:59.62,0:16:00.69,Default,,0,0,0,,Бұл қатерлі ісік.
Dialogue: 0,0:16:02.56,0:16:05.03,Default,,0,0,0,,Бұл сұлу әйел кім?
Dialogue: 0,0:16:05.09,0:16:08.33,Default,,0,0,0,,Неліктен BoJack?
Dialogue: 0,0:16:08.70,0:16:11.07,Default,,0,0,0,,Дайан Мен кітап жазушымын.
Dialogue: 0,0:16:11.23,0:16:12.60,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:16:12.67,0:16:14.97,Default,,0,0,0,,Тақырып «Төбешік» ме?
Dialogue: 0,0:16:16.57,0:16:20.11,Default,,0,0,0,,Ол мені құртты. Жай ойнам айттым.
Dialogue: 0,0:16:20.17,0:16:21.98,Default,,0,0,0,,Ішіндегі мылтықты өлтіріңіз.
Dialogue: 0,0:16:27.28,0:16:28.12,Default,,0,0,0,,«Мен… мен адаммын.»
Dialogue: 0,0:16:28.75,0:16:32.12,Default,,0,0,0,,Аз ғана қалды.
Dialogue: 0,0:16:33.55,0:16:34.39,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:35.52,0:16:37.99,Default,,0,0,0,,Пышақ қаншалықты өткір?
Dialogue: 0,0:16:38.09,0:16:39.06,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:16:39.16,0:16:41.60,Default,,0,0,0,,Егер ол нашар болса, мен оны ауыстырамын.
Dialogue: 0,0:16:41.66,0:16:44.50,Default,,0,0,0,,Арқамнан шаншып алған пышақ
Dialogue: 0,0:16:45.20,0:16:47.27,Default,,0,0,0,,Мен бұл келеді деп ешқашан ойламадым.
Dialogue: 0,0:16:47.47,0:16:49.07,Default,,0,0,0,,Сол ваннада
Dialogue: 0,0:16:49.14,0:16:50.30,Default,,0,0,0,,Мен бармаймын.
Dialogue: 0,0:16:57.21,0:16:58.05,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:16:58.11,0:16:59.68,Default,,0,0,0,,(Эмилия) Мұндай маңызды жерде не ойлап жүрсің?
Dialogue: 0,0:16:59.75,0:17:02.08,Default,,0,0,0,,Бағытты өзгерту мүмкін емес
Dialogue: 0,0:17:02.18,0:17:04.72,Default,,0,0,0,,Біз мұны мәңгі жасап жүрген сияқтымыз.
Dialogue: 0,0:17:05.62,0:17:07.65,Default,,0,0,0,,Сатсу қуды
Dialogue: 0,0:17:07.72,0:17:12.09,Default,,0,0,0,,Бұл автомектеп пе? Бұлай етпе, сұмырай
Dialogue: 0,0:17:12.16,0:17:14.46,Default,,0,0,0,,Көліктен тез түс.
Dialogue: 0,0:17:19.27,0:17:21.64,Default,,0,0,0,,Шөптер Сіздің араластырғышыңыз?
Dialogue: 0,0:17:22.07,0:17:23.20,Default,,0,0,0,,Оның да біреуі бар.
Dialogue: 0,0:17:23.30,0:17:28.04,Default,,0,0,0,,Екеуіңіз де бұған ерекше көңіл бөлесіз бе?
Dialogue: 0,0:17:28.14,0:17:29.51,Default,,0,0,0,,Оның құны 600 доллар.
Dialogue: 0,0:17:29.58,0:17:31.75,Default,,0,0,0,,Мен оны мүлдем қолданбаймын
Dialogue: 0,0:17:32.08,0:17:34.15,Default,,0,0,0,,Қатерлі ісік диагнозы қойылғанға дейін сатып алынған
Dialogue: 0,0:17:34.21,0:17:36.05,Default,,0,0,0,,Қазір денсаулығыңыз қандай?
Dialogue: 0,0:17:36.12,0:17:37.58,Default,,0,0,0,,Мен де
Dialogue: 0,0:17:37.68,0:17:38.45,Default,,0,0,0,,Оны кім пайдаланады?
Dialogue: 0,0:17:38.59,0:17:41.16,Default,,0,0,0,,Сұйықтықтың қандай пайдасы бар?
Dialogue: 0,0:17:41.22,0:17:44.19,Default,,0,0,0,,Кез келген нәрсені шырынға айналдырады
Dialogue: 0,0:17:44.26,0:17:46.39,Default,,0,0,0,,Шырын ережелері
Dialogue: 0,0:17:46.49,0:17:47.56,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:49.76,0:17:51.60,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:17:51.70,0:17:53.73,Default,,0,0,0,,Қолымнан келгеннің бәрін жасап жатсам да
Dialogue: 0,0:17:56.80,0:17:58.47,Default,,0,0,0,,Оны сырттан қараймыз ба?
Dialogue: 0,0:17:58.54,0:17:59.74,Default,,0,0,0,,Жоқ, сәл артық
Dialogue: 0,0:17:59.81,0:18:01.21,Default,,0,0,0,,Мен қолымнан келгеннің бәрін істеп жатырмын
Dialogue: 0,0:18:01.34,0:18:03.34,Default,,0,0,0,,Кенси, үндеме.
Dialogue: 0,0:18:03.44,0:18:05.45,Default,,0,0,0,,Бірақ сен жақсы адамсың.
Dialogue: 0,0:18:05.55,0:18:08.35,Default,,0,0,0,,Атақты ұрылар клубының 1 ережесі
Dialogue: 0,0:18:08.48,0:18:10.32,Default,,0,0,0,,«Ғашық болма»
Dialogue: 0,0:18:10.65,0:18:12.55,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:18:12.62,0:18:14.29,Default,,0,0,0,,Бұл жақсы ереже.
Dialogue: 0,0:18:14.42,0:18:16.49,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:18:16.56,0:18:18.69,Default,,0,0,0,,Ұрыспас
Dialogue: 0,0:18:18.79,0:18:22.63,Default,,0,0,0,,Біз маскаларымызды шешіп, сөйлесуіміз керек.
Dialogue: 0,0:18:22.76,0:18:25.10,Default,,0,0,0,,Мен оны сен үшін аламын.
Dialogue: 0,0:18:25.43,0:18:27.57,Default,,0,0,0,,Сіз бетпердеңізді шештіңіз бе?
Dialogue: 0,0:18:27.63,0:18:28.64,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:18:28.74,0:18:31.84,Default,,0,0,0,,Әлі де бетперде киген жоқсыз ба?
Dialogue: 0,0:18:34.58,0:18:37.24,Default,,0,0,0,,Сіз Клинтонмен кездестіңіз бе?
Dialogue: 0,0:18:37.31,0:18:38.21,Default,,0,0,0,,бірнеше рет
Dialogue: 0,0:18:38.28,0:18:41.52,Default,,0,0,0,,Соңғы 20 жыл бойы депрессияда болдыңыз ба?
Dialogue: 0,0:18:41.85,0:18:44.65,Default,,0,0,0,,Мен депрессияға түстім, бірақ...
Dialogue: 0,0:18:44.82,0:18:48.12,Default,,0,0,0,,Африкадағы балаларға да су жібердік.
Dialogue: 0,0:18:48.29,0:18:49.26,Default,,0,0,0,,Сол эмоциясыз қыз –
Dialogue: 0,0:18:49.42,0:18:51.26,Default,,0,0,0,,Сондай-ақ марапатқа ұсынылды
Dialogue: 0,0:18:51.86,0:18:52.79,Default,,0,0,0,,Бұл Шарлоттаның суреті.
Dialogue: 0,0:18:52.89,0:18:54.50,Default,,0,0,0,,Біз әлі де доспыз
Dialogue: 0,0:18:54.63,0:18:57.63,Default,,0,0,0,,Маған хабарлассаңыз қуанатынына сенімдімін.
Dialogue: 0,0:18:57.73,0:18:59.43,Default,,0,0,0,,Жасы бойынша жас
Dialogue: 0,0:18:59.53,0:19:00.67,Default,,0,0,0,,Үш жас кіші.
Dialogue: 0,0:19:00.77,0:19:01.54,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:04.67,0:19:06.67,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:19:06.81,0:19:08.38,Default,,0,0,0,,Ұйықтау уақыты келді
Dialogue: 0,0:19:08.44,0:19:09.81,Default,,0,0,0,,Сіз оянасыз деп үміттенемін...
Dialogue: 0,0:19:11.91,0:19:15.28,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:19:15.42,0:19:16.28,Default,,0,0,0,,Тиісті түрде қайтарыңыз
Dialogue: 0,0:19:18.15,0:19:20.25,Default,,0,0,0,,«Шырын ережесі» - шедевр
Dialogue: 0,0:19:21.62,0:19:22.56,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:19:24.46,0:19:27.56,Default,,0,0,0,,Сіз шынымен Сатсудан қашып жүрсіз бе?
Dialogue: 0,0:19:27.63,0:19:29.40,Default,,0,0,0,,Басқа нәрсе бар ма?
Dialogue: 0,0:19:29.46,0:19:32.77,Default,,0,0,0,,Өзімнен қашып бара жатқандай
Dialogue: 0,0:19:33.30,0:19:35.27,Default,,0,0,0,,Мен мұнымен келісемін.
Dialogue: 0,0:19:35.57,0:19:37.44,Default,,0,0,0,,Кенсидің пікірі қандай?
Dialogue: 0,0:19:37.87,0:19:40.57,Default,,0,0,0,,Адал болу жақсы.
Dialogue: 0,0:19:40.91,0:19:44.34,Default,,0,0,0,,Бүгінгі күнді ешқашан ұмытпаймын
Dialogue: 0,0:19:44.41,0:19:45.28,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:45.35,0:19:48.62,Default,,0,0,0,,Мен әдемі көрінсем де,
Dialogue: 0,0:19:48.68,0:19:51.82,Default,,0,0,0,,Ішінде бұл жай ғана Тодд.
Dialogue: 0,0:19:51.92,0:19:55.26,Default,,0,0,0,,Бұдан былай қорғануды доғар.
Dialogue: 0,0:19:55.36,0:19:56.89,Default,,0,0,0,,Сіз дайын емессіз бе?
Dialogue: 0,0:19:56.96,0:19:57.89,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:19:59.53,0:20:01.70,Default,,0,0,0,,Атақты ұрылар клубы Yay
Dialogue: 0,0:20:06.33,0:20:08.94,Default,,0,0,0,,Менің ойымша, бірдеңе дұрыс болмады.
Dialogue: 0,0:20:09.64,0:20:11.64,Default,,0,0,0,,Кәдесый шарабы жоқ...
Dialogue: 0,0:20:11.71,0:20:13.74,Default,,0,0,0,,Мен үлкен болсам да ұяламын
Dialogue: 0,0:20:13.84,0:20:16.71,Default,,0,0,0,,Сіз шарапқа қызықсыз ба?
Dialogue: 0,0:20:16.78,0:20:18.78,Default,,0,0,0,,Мен аздап ішсем ғой.
Dialogue: 0,0:20:18.88,0:20:20.88,Default,,0,0,0,,Жоқ, солай ма?
Dialogue: 0,0:20:21.22,0:20:24.35,Default,,0,0,0,,Егер біреуге бірдеңе айтқыңыз келсе—
Dialogue: 0,0:20:24.42,0:20:26.55,Default,,0,0,0,,Оны ойланбастан айту керек.
Dialogue: 0,0:20:26.75,0:20:28.96,Default,,0,0,0,,Тым кеш болуы мүмкін бе?
Dialogue: 0,0:20:29.76,0:20:33.99,Default,,0,0,0,,Бұл шөптер туралы ма? Әлде басқа нәрсе ме?
Dialogue: 0,0:20:34.26,0:20:35.33,Default,,0,0,0,,Шөп
Dialogue: 0,0:20:35.40,0:20:36.43,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:20:37.46,0:20:39.23,Default,,0,0,0,,Шөптер
Dialogue: 0,0:20:39.30,0:20:40.93,Default,,0,0,0,,Біз қайтадан шырын туралы айтамыз ба?
Dialogue: 0,0:20:43.84,0:20:45.37,Default,,0,0,0,,Сіз нашар көрінесіз.
Dialogue: 0,0:20:45.74,0:20:47.67,Default,,0,0,0,,Ой, мен аздап ауырып тұрмын.
Dialogue: 0,0:20:47.94,0:20:49.91,Default,,0,0,0,,Мен аздап сөйлескім келеді.
Dialogue: 0,0:20:50.48,0:20:53.48,Default,,0,0,0,,Мен қателестім деп ойладым.
Dialogue: 0,0:20:53.81,0:20:54.88,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:20:55.88,0:20:57.65,Default,,0,0,0,,Сонда сіз кешірім сұрағыңыз келе ме?
Dialogue: 0,0:20:57.99,0:20:59.92,Default,,0,0,0,,Ол ешкімнің жан дүниесін бақылауға мүлде қауқарсыз
Dialogue: 0,0:20:59.99,0:21:01.92,Default,,0,0,0,,Жарайды, мені кешіре аласың ба?
Dialogue: 0,0:21:02.52,0:21:03.56,Default,,0,0,0,,«Мені кешір»?
Dialogue: 0,0:21:03.96,0:21:06.39,Default,,0,0,0,,Сондықтан «Мен сені кешіремін»
Dialogue: 0,0:21:07.73,0:21:11.50,Default,,0,0,0,,Соңғысы болу мүмкіндігі бар.
Dialogue: 0,0:21:11.57,0:21:15.54,Default,,0,0,0,,Осымен мен шымылдықты жабуға жол бермеймін.
Dialogue: 0,0:21:16.30,0:21:20.27,Default,,0,0,0,,Өмір сүргенше, өкіне бер.
Dialogue: 0,0:21:20.41,0:21:23.54,Default,,0,0,0,,Оған ешқашан жол берілмейді деп ойлаймын
Dialogue: 0,0:21:23.84,0:21:26.38,Default,,0,0,0,,Кешірген жақсырақ...
Dialogue: 0,0:21:26.45,0:21:28.72,Default,,0,0,0,,Мен өлемін
Dialogue: 0,0:21:28.78,0:21:30.98,Default,,0,0,0,,Сіз мені жақсы сезінбейсіз
Dialogue: 0,0:21:31.79,0:21:34.45,Default,,0,0,0,,Мен де қолымнан келгенін істедім.
Dialogue: 0,0:21:34.52,0:21:36.82,Default,,0,0,0,,Маған неге қоңырау шалмадың?
Dialogue: 0,0:21:37.32,0:21:38.96,Default,,0,0,0,,20 жыл бойы жаңалық жоқ
Dialogue: 0,0:21:39.29,0:21:41.76,Default,,0,0,0,,Мен қоңырау шалуға тырыстым, бірақ...
Dialogue: 0,0:21:41.86,0:21:44.30,Default,,0,0,0,,Жалғыз болу дегенді түсінесің бе?
Dialogue: 0,0:21:44.46,0:21:45.43,Default,,0,0,0,,Онда ешкім жоқ
Dialogue: 0,0:21:45.53,0:21:47.77,Default,,0,0,0,,Жұмысқа телефон соғудан басқа амалым жоқ.
Dialogue: 0,0:21:47.90,0:21:48.60,Default,,0,0,0,,Тіпті сен бе?
Dialogue: 0,0:21:48.74,0:21:50.37,Default,,0,0,0,,Мені жұмыстан шығаруға кінәлі болдым ба?
Dialogue: 0,0:21:50.44,0:21:52.71,Default,,0,0,0,,Бұл жұмыс туралы емес.
Dialogue: 0,0:21:52.77,0:21:55.44,Default,,0,0,0,,Менің өмірім қызықты болды, бірақ...
Dialogue: 0,0:21:55.61,0:21:57.64,Default,,0,0,0,,Мен дос тапқым келді
Dialogue: 0,0:21:58.41,0:21:59.91,Default,,0,0,0,,Сен мені тастап кеттің
Dialogue: 0,0:22:00.31,0:22:03.02,Default,,0,0,0,,Мен сені ешқашан кешіре алмаймын
Dialogue: 0,0:22:03.92,0:22:05.99,Default,,0,0,0,,Тез шығыңыз
Dialogue: 0,0:22:07.35,0:22:08.32,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:13.09,0:22:16.06,Default,,0,0,0,,Эй, гей болу мен ауру болу арасында байланыс бар ма?
Dialogue: 0,0:22:16.33,0:22:16.96,Default,,0,0,0,,Шығу!
Dialogue: 0,0:22:17.03,0:22:19.43,Default,,0,0,0,,Жаман болды, ұмыт.
Dialogue: 0,0:22:21.34,0:22:23.57,Default,,0,0,0,,Эй, оған тиіспе.
Dialogue: 0,0:22:23.64,0:22:24.60,Default,,0,0,0,,Сіз оны маған бердіңіз.
Dialogue: 0,0:22:29.44,0:22:31.85,Default,,0,0,0,,БоДжек, сен не істеп жатырсың?
Dialogue: 0,0:22:32.11,0:22:32.88,Default,,0,0,0,,Тоқта
Dialogue: 0,0:22:33.01,0:22:34.85,Default,,0,0,0,,Сіз бағдарламаны өзгерттіңіз.
Dialogue: 0,0:22:34.95,0:22:37.48,Default,,0,0,0,,Кейбір адамдар мұны қалайды.
Dialogue: 0,0:22:37.65,0:22:38.49,Default,,0,0,0,,Тоқта
Dialogue: 0,0:22:39.55,0:22:41.49,Default,,0,0,0,,БоДжек, кеттік.
Dialogue: 0,0:22:42.86,0:22:46.76,Default,,0,0,0,,Мені шақырғаныңызға рахмет. Бұл керемет үй болды.
Dialogue: 0,0:22:46.83,0:22:48.03,Default,,0,0,0,,Саған не болды?
Dialogue: 0,0:22:48.13,0:22:50.50,Default,,0,0,0,,Жақсы адам екенімді мақтан ету
Dialogue: 0,0:22:50.76,0:22:53.47,Default,,0,0,0,,Бірақ мен түсінемін.
Dialogue: 0,0:22:53.63,0:22:55.64,Default,,0,0,0,,Сіз жақсы адамсыз
Dialogue: 0,0:22:55.97,0:22:58.37,Default,,0,0,0,,Жақсы ұйықтауды үйретейік
Dialogue: 0,0:22:58.44,0:23:02.04,Default,,0,0,0,,Өзіңізді өзімшіл және қорқақ деп санаңыз.
Dialogue: 0,0:23:02.48,0:23:06.78,Default,,0,0,0,,Бір мақсат үшін кез келген нәрсені істейтін адам екеніңізді мойындаңыз.
Dialogue: 0,0:23:06.91,0:23:09.92,Default,,0,0,0,,Бұл сенсің, БоДжек.
Dialogue: 0,0:23:10.58,0:23:12.49,Default,,0,0,0,,Неге келдің?
Dialogue: 0,0:23:13.62,0:23:15.79,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:23:19.53,0:23:21.03,Default,,0,0,0,,Жұмыс алғыңыз келе ме?
Dialogue: 0,0:23:21.16,0:23:24.00,Default,,0,0,0,,Жұмыс...жеткілікті
Dialogue: 0,0:23:24.50,0:23:26.17,Default,,0,0,0,,Эй, Малибуда не болды?
Dialogue: 0,0:23:26.43,0:23:27.13,Default,,0,0,0,,Мен оны қазір қиып аламын.
Dialogue: 0,0:23:28.87,0:23:32.67,Default,,0,0,0,,Әңгіме ойлап табу жақсы идея деп ойласам ше?
Dialogue: 0,0:23:32.81,0:23:34.91,Default,,0,0,0,,Оның мақтауы...
Dialogue: 0,0:23:35.18,0:23:36.68,Default,,0,0,0,,О, сұмдық
Dialogue: 0,0:23:49.16,0:23:53.13,Default,,0,0,0,,Кешіріңіз, бірақ мен зәрімді 3 сағат бойы ұстап тұрдым.
Dialogue: 0,0:23:55.13,0:23:58.43,Default,,0,0,0,,Бүгінгі күн туралы кітапқа жазбаймын.
Dialogue: 0,0:23:58.77,0:24:02.94,Default,,0,0,0,,Мұның бәрі рас, сондықтан бұл туралы алаңдамай, жазып алыңыз.
Dialogue: 0,0:24:03.20,0:24:04.44,Default,,0,0,0,,Жеткілікті
Dialogue: 0,0:24:04.50,0:24:06.71,Default,,0,0,0,,Адамдардың не айтатыны маған бәрібір
Dialogue: 0,0:24:07.07,0:24:11.21,Default,,0,0,0,,Мен ол жерге жиі баратынмын. Бұл тамаша болды.
Dialogue: 0,0:24:12.71,0:24:18.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
