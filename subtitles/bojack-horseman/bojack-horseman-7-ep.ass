Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:05.57,Default,,0,0,0,,NETFLIX түпнұсқа жұмысы
Dialogue: 0,0:00:05.57,0:00:07.74,Default,,0,0,0,,NETFLIX түпнұсқа жұмыстары
Dialogue: 0,0:00:05.57,0:00:07.74,Default,,0,0,0,,Қаттырақ болыңыз.
Dialogue: 0,0:00:08.64,0:00:11.34,Default,,0,0,0,,Сізде бәрі жақсы болады
Dialogue: 0,0:00:11.44,0:00:15.14,Default,,0,0,0,,Өнерлі, өткір, алғыр.
Dialogue: 0,0:00:15.21,0:00:18.18,Default,,0,0,0,,Сіз американдық қазынасыз
Dialogue: 0,0:00:18.25,0:00:21.22,Default,,0,0,0,,Бұл BoJack Horseman.
Dialogue: 0,0:00:21.58,0:00:23.18,Default,,0,0,0,,Тез жүріңіз
Dialogue: 0,0:00:25.15,0:00:27.59,Default,,0,0,0,,Гамбургер мейрамханаларына келетін болсақ...
Dialogue: 0,0:00:27.66,0:00:29.36,Default,,0,0,0,,Мен тым көп іштім
Dialogue: 0,0:00:29.46,0:00:32.33,Default,,0,0,0,,2 апта Мас болғанына қарамастан
Dialogue: 0,0:00:32.39,0:00:35.13,Default,,0,0,0,,Дайан құда түскендіктен...
Dialogue: 0,0:00:35.20,0:00:37.77,Default,,0,0,0,,Жержаңғақ майымен айналысасыз ба?
Dialogue: 0,0:00:38.03,0:00:41.37,Default,,0,0,0,,Ішуге болмайды. Соңғы кездері нашар болды.
Dialogue: 0,0:00:41.57,0:00:44.61,Default,,0,0,0,,Дж. Стамосты әкелді
Dialogue: 0,0:00:44.71,0:00:46.34,Default,,0,0,0,,Қате адам.
Dialogue: 0,0:00:46.51,0:00:50.28,Default,,0,0,0,,Құлағымды тесіп алдым.
Dialogue: 0,0:00:50.48,0:00:51.58,Default,,0,0,0,,Бұл кіндік, солай ма?
Dialogue: 0,0:00:51.75,0:00:55.18,Default,,0,0,0,,Стамос қайтыс болды.
Dialogue: 0,0:00:55.45,0:01:00.09,Default,,0,0,0,,Құдай-ау, неге, неге алдың?
Dialogue: 0,0:01:00.39,0:01:01.49,Default,,0,0,0,,Мен қауіптімін бе?
Dialogue: 0,0:01:01.56,0:01:04.19,Default,,0,0,0,,Ал мен жалаңаш болдым.
Dialogue: 0,0:01:04.53,0:01:07.76,Default,,0,0,0,,Стамос!
Dialogue: 0,0:01:08.06,0:01:10.50,Default,,0,0,0,,Иә, бұл менің кеңсемде...
Dialogue: 0,0:01:10.67,0:01:15.60,Default,,0,0,0,,Түнде теңізге шомылайын десем, толқындар қатты.
Dialogue: 0,0:01:15.70,0:01:17.57,Default,,0,0,0,,Мен ол кезде көлік жүргіздім бе?
Dialogue: 0,0:01:17.64,0:01:21.61,Default,,0,0,0,,Тодд көлік жүргізді, ол да ішімдік ішкен.
Dialogue: 0,0:01:21.68,0:01:25.38,Default,,0,0,0,,Бекон Чизбургер Құрметпен
Dialogue: 0,0:01:25.45,0:01:30.85,Default,,0,0,0,,Дайанды ұмытып, өз жұмысыңа көңіл бөл.
Dialogue: 0,0:01:32.22,0:01:36.16,Default,,0,0,0,,Тони, сен маған персоналыңды бере аласың ба?
Dialogue: 0,0:01:36.26,0:01:38.59,Default,,0,0,0,,Олай болса, БоДжектің үйінде.
Dialogue: 0,0:01:39.13,0:01:39.69,Default,,0,0,0,,Не?
Dialogue: 0,0:01:39.76,0:01:41.73,Default,,0,0,0,,«Гутен Бурбон» жарнамасы
Dialogue: 0,0:01:41.83,0:01:43.16,Default,,0,0,0,,Алкоголь қайдан алынған?
Dialogue: 0,0:01:43.26,0:01:44.57,Default,,0,0,0,,Германия
Dialogue: 0,0:01:44.67,0:01:47.17,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:01:47.27,0:01:50.41,Default,,0,0,0,,«Ішімдік ішуді ұнататындар үшін» ретінде белгіленген
Dialogue: 0,0:01:50.47,0:01:52.37,Default,,0,0,0,,Сізге өте ыңғайлы
Dialogue: 0,0:01:52.44,0:01:55.21,Default,,0,0,0,,Жай ғана күліңіз.
Dialogue: 0,0:01:55.34,0:01:57.18,Default,,0,0,0,,Бұл қиын сияқты.
Dialogue: 0,0:01:57.25,0:02:02.18,Default,,0,0,0,,Еңбек етсем де, табысым нөл.
Dialogue: 0,0:02:02.25,0:02:03.59,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:02:03.79,0:02:07.19,Default,,0,0,0,,Туртелтауб мырзамен таңғы ас ішетін уақыт келді.
Dialogue: 0,0:02:07.69,0:02:08.46,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:02:08.59,0:02:11.16,Default,,0,0,0,,Тодд, мені бақылаңыз.
Dialogue: 0,0:02:11.23,0:02:14.26,Default,,0,0,0,,Иә! деп сұрады
Dialogue: 0,0:02:14.33,0:02:17.87,Default,,0,0,0,,Жаңа айтқан сөзіңізді шын жүректен айттыңыз ба?
Dialogue: 0,0:02:18.17,0:02:20.74,Default,,0,0,0,,Өткір адаммын дейді...
Dialogue: 0,0:02:21.30,0:02:24.31,Default,,0,0,0,,Мен сенің агентіммін, саған сенемін.
Dialogue: 0,0:02:26.84,0:02:31.18,Default,,0,0,0,,Менің чизбургерім ше? Бір сағат болды
Dialogue: 0,0:03:21.76,0:03:25.57,Default,,0,0,0,,БоДжек шабандозы
Dialogue: 0,0:03:25.67,0:03:27.70,Default,,0,0,0,,«Күміс қасық асхана»
Dialogue: 0,0:03:27.87,0:03:30.77,Default,,0,0,0,,Сіздің теріңіз бұрынғыдай мінсіз.
Dialogue: 0,0:03:30.91,0:03:34.51,Default,,0,0,0,,Менің уақытым жоқ, сондықтан қысқаша айтайын.
Dialogue: 0,0:03:34.64,0:03:37.81,Default,,0,0,0,,Бұл әлі жоспарлау сатысында, бірақ менде жақсы әңгіме бар...
Dialogue: 0,0:03:38.25,0:03:39.45,Default,,0,0,0,,Кешіріңіз, Иә
Dialogue: 0,0:03:39.78,0:03:42.62,Default,,0,0,0,,Жақсы жұмысыңыз үшін рахмет
Dialogue: 0,0:03:42.68,0:03:45.42,Default,,0,0,0,,Ал мен ішімдікке құмар болдым.
Dialogue: 0,0:03:45.49,0:03:48.86,Default,,0,0,0,,Ол менің құлағымды да ұрды.
Dialogue: 0,0:03:48.99,0:03:50.49,Default,,0,0,0,,Кейін кездескенше
Dialogue: 0,0:03:50.56,0:03:53.29,Default,,0,0,0,,Сіз ғана түсінесіз
Dialogue: 0,0:03:53.36,0:03:54.73,Default,,0,0,0,,Иә, кездескенше.
Dialogue: 0,0:03:54.80,0:03:56.23,Default,,0,0,0,,Мен алғаш рет...
Dialogue: 0,0:03:56.30,0:03:57.97,Default,,0,0,0,,Мен жиналыстамын.
Dialogue: 0,0:03:58.23,0:03:58.90,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:03:59.53,0:04:01.40,Default,,0,0,0,,Сонымен, жақсы әңгіме дегеніміз не?
Dialogue: 0,0:04:01.60,0:04:02.54,Default,,0,0,0,,Бұл блеф туралы мәселе.
Dialogue: 0,0:04:02.67,0:04:06.87,Default,,0,0,0,,Бұл таңқаларлық. Сіз оны өте жақсы ұстай алдыңыз.
Dialogue: 0,0:04:06.94,0:04:11.85,Default,,0,0,0,,Тек ол «Ева Браунды» сала алады
Dialogue: 0,0:04:11.91,0:04:13.25,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:04:15.42,0:04:15.85,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:15.95,0:04:16.65,Default,,0,0,0,,Сәлем
Dialogue: 0,0:04:16.78,0:04:18.49,Default,,0,0,0,,Директор блеф айтып жатыр —
Dialogue: 0,0:04:18.55,0:04:20.89,Default,,0,0,0,,Басты актриса – К.Бланшетт.
Dialogue: 0,0:04:20.96,0:04:23.42,Default,,0,0,0,,Сіз жасаған
Dialogue: 0,0:04:23.49,0:04:25.33,Default,,0,0,0,,Бұл хит болатыны сөзсіз.
Dialogue: 0,0:04:25.39,0:04:28.56,Default,,0,0,0,,Мен бұл салада көптен бері жүрмін.
Dialogue: 0,0:04:28.63,0:04:33.50,Default,,0,0,0,,Мен Беглиге айтқанымдай, біз сақтықты төмендете алмаймыз.
Dialogue: 0,0:04:33.60,0:04:38.01,Default,,0,0,0,,Шарт жасауды маған қалдырыңыз.
Dialogue: 0,0:04:38.31,0:04:41.38,Default,,0,0,0,,Мен Китонға баяғыда айттым...
Dialogue: 0,0:04:41.84,0:04:42.58,Default,,0,0,0,,Солай ма! Онда саған ұнайды екен!
Dialogue: 0,0:04:42.68,0:04:46.65,Default,,0,0,0,,«Вигер»
Dialogue: 0,0:04:48.42,0:04:52.52,Default,,0,0,0,,«Келесі жұмысыңызға сәттілік»
Dialogue: 0,0:04:52.85,0:04:54.42,Default,,0,0,0,,Лаура
Dialogue: 0,0:04:55.02,0:04:55.66,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:04:55.72,0:04:56.42,Default,,0,0,0,,Біріктіру
Dialogue: 0,0:04:56.59,0:04:57.73,Default,,0,0,0,,Қай компаниямен?
Dialogue: 0,0:04:57.79,0:05:01.90,Default,,0,0,0,,Бұл FME. Жұмыстан шығару немесе жаңа қызметкер...
Dialogue: 0,0:05:01.96,0:05:04.90,Default,,0,0,0,,Мұндай қосылу күтпеген жағдай.
Dialogue: 0,0:05:07.44,0:05:10.44,Default,,0,0,0,,FME-ден келген қызметкерлер...
Dialogue: 0,0:05:10.51,0:05:11.41,Default,,0,0,0,,Ванесса
Dialogue: 0,0:05:11.51,0:05:14.68,Default,,0,0,0,,Мына геккон әйел осында ма?
Dialogue: 0,0:05:14.74,0:05:15.98,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:05:16.44,0:05:16.98,Default,,0,0,0,,Ванесса
Dialogue: 0,0:05:17.05,0:05:17.85,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:17.91,0:05:20.08,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:05:20.35,0:05:25.52,Default,,0,0,0,,Біріктіру туралы жаттығу кезінде естідім.
Dialogue: 0,0:05:25.72,0:05:26.59,Default,,0,0,0,,Сен мақтаншақ жігітсің, Тодороки.
Dialogue: 0,0:05:26.65,0:05:27.09,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:27.36,0:05:31.79,Default,,0,0,0,,Мен 15 жыл отасқан күйеуіммен жыныстық қатынасқа түскенім сонша, қатты толқыдым.
Dialogue: 0,0:05:31.89,0:05:34.03,Default,,0,0,0,,Бүгін таңертең қызыма тамақ әзірледім.
Dialogue: 0,0:05:34.43,0:05:38.90,Default,,0,0,0,,Сізді элиталық мектепке жіберген соң, осында асығыңыз.
Dialogue: 0,0:05:38.97,0:05:40.80,Default,,0,0,0,,Сіздің балаңыз неше жаста?
Dialogue: 0,0:05:40.90,0:05:42.37,Default,,0,0,0,,Сіздің балаларыңыз бар ма?
Dialogue: 0,0:05:42.44,0:05:44.81,Default,,0,0,0,,Әлі де үміт бар...
Dialogue: 0,0:05:46.61,0:05:47.34,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:05:47.41,0:05:50.38,Default,,0,0,0,,Кэролайн Кіріспе кешіктірілді.
Dialogue: 0,0:05:50.68,0:05:52.41,Default,,0,0,0,,Сіздің жаңа досыңыз
Dialogue: 0,0:05:52.61,0:05:53.68,Default,,0,0,0,,Бұл Ванесса.
Dialogue: 0,0:05:53.92,0:05:54.78,Default,,0,0,0,,Білу
Dialogue: 0,0:05:54.98,0:05:56.92,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:05:57.59,0:05:58.55,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын
Dialogue: 0,0:05:58.72,0:06:01.76,Default,,0,0,0,,Екеуіңіз де бар күшіңізді салыңыз.
Dialogue: 0,0:06:01.82,0:06:05.53,Default,,0,0,0,,Мен кімнің жұмыстан шығатынын да білмеймін.
Dialogue: 0,0:06:05.59,0:06:06.03,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:06.09,0:06:07.56,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:06:07.66,0:06:09.50,Default,,0,0,0,,Әзірге
Dialogue: 0,0:06:12.10,0:06:13.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:13.10,0:06:15.14,Default,,0,0,0,,Жаман жаңалықтар.
Dialogue: 0,0:06:15.40,0:06:21.01,Default,,0,0,0,,БоДжек жиыннан жоғалып кетті.
Dialogue: 0,0:06:21.14,0:06:23.71,Default,,0,0,0,,Үйде алу керек еді, солай ма?
Dialogue: 0,0:06:23.78,0:06:26.45,Default,,0,0,0,,Байқасам, көре алмадым.
Dialogue: 0,0:06:26.51,0:06:30.12,Default,,0,0,0,,Бұл бурбон өте тегіс.
Dialogue: 0,0:06:31.05,0:06:32.02,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:06:32.09,0:06:33.45,Default,,0,0,0,,Бұл дәл қазір ең жақсысы.
Dialogue: 0,0:06:33.52,0:06:33.99,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:34.09,0:06:35.42,Default,,0,0,0,,Костюмді киіп көргіңіз келе ме?
Dialogue: 0,0:06:35.66,0:06:37.66,Default,,0,0,0,,Кесіңіз, мүмкіндігіңіз келді.
Dialogue: 0,0:06:37.73,0:06:40.06,Default,,0,0,0,,Мен мақтаншақ емеспін.
Dialogue: 0,0:06:40.13,0:06:42.06,Default,,0,0,0,,Ей, ақымақ болма.
Dialogue: 0,0:06:42.43,0:06:43.73,Default,,0,0,0,,Бұл менің орындығым.
Dialogue: 0,0:06:43.83,0:06:46.13,Default,,0,0,0,,Маржа 10% құрайды.
Dialogue: 0,0:06:46.40,0:06:47.47,Default,,0,0,0,,Котенка
Dialogue: 0,0:06:47.54,0:06:50.51,Default,,0,0,0,,Жарнамалық түсірілімге не болды?
Dialogue: 0,0:06:50.74,0:06:52.84,Default,,0,0,0,,Егер сіз бурбон ішкен болсаңыз...
Dialogue: 0,0:06:52.91,0:06:54.61,Default,,0,0,0,,Бұл жалған, солай ма?
Dialogue: 0,0:06:54.71,0:06:56.48,Default,,0,0,0,,Нақты нәрсе қосылды
Dialogue: 0,0:06:56.58,0:06:57.41,Default,,0,0,0,,Мен байқадым
Dialogue: 0,0:06:57.48,0:07:02.12,Default,,0,0,0,,Нағыз маңызды адам Дайан емес, сенсің.
Dialogue: 0,0:07:02.45,0:07:05.75,Default,,0,0,0,,Сондықтан мен ол жаққа бардым.
Dialogue: 0,0:07:05.85,0:07:07.49,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:07:07.62,0:07:09.96,Default,,0,0,0,,Мұқият ойлан.
Dialogue: 0,0:07:10.02,0:07:11.66,Default,,0,0,0,,Бір-бірімізді сүйсек...
Dialogue: 0,0:07:11.76,0:07:14.16,Default,,0,0,0,,Сізге Дайан ұнайды, солай ма?
Dialogue: 0,0:07:14.46,0:07:18.93,Default,,0,0,0,,Немесе біз сөйлесіп жатқанда, мен сені ұнататын елес беремін.
Dialogue: 0,0:07:19.03,0:07:22.80,Default,,0,0,0,,Дайанның құда түскеніне қуаныштымын.
Dialogue: 0,0:07:22.87,0:07:24.51,Default,,0,0,0,,Мен сіздің қаншалықты маңызды екеніңізді түсінемін.
Dialogue: 0,0:07:25.14,0:07:27.84,Default,,0,0,0,,Кәдімгі «керісінше» тағы да?
Dialogue: 0,0:07:27.98,0:07:32.75,Default,,0,0,0,,Мен марапатқа ұсынылмағаныма қуаныштымын.
Dialogue: 0,0:07:32.85,0:07:36.48,Default,,0,0,0,,Мен кокаинмен ұсталғаныма қуаныштымын.
Dialogue: 0,0:07:36.58,0:07:39.02,Default,,0,0,0,,Жезөкше жүкті болып қалады және керісінше...
Dialogue: 0,0:07:39.12,0:07:41.06,Default,,0,0,0,,Түшкіру және керісінше әрекет ету...
Dialogue: 0,0:07:41.16,0:07:45.63,Default,,0,0,0,,Бірдеңе бола қалса, маған мейірімді боласың.
Dialogue: 0,0:07:45.76,0:07:47.66,Default,,0,0,0,,Мен сені бұл жолы жұбатпаймын.
Dialogue: 0,0:07:47.73,0:07:51.03,Default,,0,0,0,,Агент пен ғашықтың қос рөлдерін ойнау мүмкін емес.
Dialogue: 0,0:07:51.70,0:07:53.23,Default,,0,0,0,,Мен телефонмен сөйлесіп жатырмын.
Dialogue: 0,0:07:53.53,0:07:54.17,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:07:54.24,0:07:57.47,Default,,0,0,0,,Сіз мені қайтадан көруге болады, солай ма?
Dialogue: 0,0:07:57.77,0:07:59.87,Default,,0,0,0,,Мен сенің жүрегіңді аламын
Dialogue: 0,0:07:59.94,0:08:01.08,Default,,0,0,0,,Мен оны саған бермеймін.
Dialogue: 0,0:08:01.14,0:08:01.91,Default,,0,0,0,,Иә
Dialogue: 0,0:08:02.04,0:08:05.58,Default,,0,0,0,,Блафф қосылуға байланысты жұмыстан шыққанда
Dialogue: 0,0:08:05.71,0:08:06.68,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:08:06.75,0:08:08.95,Default,,0,0,0,,«Төлемді еселеу»
Dialogue: 0,0:08:09.05,0:08:13.49,Default,,0,0,0,,Мен Бэрримор сияқты: «Бұл жақсы» деп бас тарттым.
Dialogue: 0,0:08:13.55,0:08:16.62,Default,,0,0,0,,Бұл «Ева Браун» жоқ дегенді білдіре ме?
Dialogue: 0,0:08:16.72,0:08:17.93,Default,,0,0,0,,Басқасын іздеңіз
Dialogue: 0,0:08:17.99,0:08:19.23,Default,,0,0,0,,Қараңызшы, бұл...
Dialogue: 0,0:08:19.53,0:08:20.60,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:08:20.66,0:08:22.50,Default,,0,0,0,,Сіз тым көп жұмыс жасайсыз
Dialogue: 0,0:08:22.56,0:08:23.97,Default,,0,0,0,,Маңызды телефон қоңырауы.
Dialogue: 0,0:08:24.03,0:08:26.17,Default,,0,0,0,,«Дайжинаденвайо»
Dialogue: 0,0:08:26.23,0:08:27.90,Default,,0,0,0,,Алданбаңыз
Dialogue: 0,0:08:27.97,0:08:30.27,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,0:08:30.64,0:08:32.74,Default,,0,0,0,,Мен жұмыс істеймін, сен үйге бара бер
Dialogue: 0,0:08:32.81,0:08:36.91,Default,,0,0,0,,Сіз мені есіңе түсіру үшін мен өзімді қалдырамын.
Dialogue: 0,0:08:36.98,0:08:39.98,Default,,0,0,0,,Мен саған жақсы нәрсе дайындап қойдым.
Dialogue: 0,0:08:40.05,0:08:42.18,Default,,0,0,0,,«Боджак тақтасы»
Dialogue: 0,0:08:42.25,0:08:46.22,Default,,0,0,0,,«Агент» жолын айтыңыз
Dialogue: 0,0:08:46.29,0:08:47.22,Default,,0,0,0,,Сізге ұнайды, солай ма?
Dialogue: 0,0:08:47.56,0:08:48.26,Default,,0,0,0,,Тек сен
Dialogue: 0,0:08:48.56,0:08:49.99,Default,,0,0,0,,Бұл шынымен жаман ба?
Dialogue: 0,0:08:50.06,0:08:51.19,Default,,0,0,0,,Бұл бір көргеннен махаббат еді
Dialogue: 0,0:08:51.26,0:08:53.86,Default,,0,0,0,,Мені сізге немесе сіздің қағаз нұсқаңыз қызықтырмайды.
Dialogue: 0,0:08:53.93,0:08:55.10,Default,,0,0,0,,Маған директор табу керек
Dialogue: 0,0:08:55.23,0:08:58.53,Default,,0,0,0,,Менің сүйікті бөлімдерімді бақылау
Dialogue: 0,0:08:58.67,0:08:59.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:59.30,0:09:01.97,Default,,0,0,0,,Түскі астан кейін кездесу
Dialogue: 0,0:09:02.97,0:09:04.11,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:09:04.54,0:09:08.78,Default,,0,0,0,,Спилберг нацистерді түсірмейді.
Dialogue: 0,0:09:08.91,0:09:13.25,Default,,0,0,0,,Жоғарыда айтқанымдай, ұйымдық қайта құруға байланысты...
Dialogue: 0,0:09:13.31,0:09:14.02,Default,,0,0,0,,Не?
Dialogue: 0,0:09:14.12,0:09:15.08,Default,,0,0,0,,Мен біраз уақыт Ванессамен бір бөлмеде боламын.
Dialogue: 0,0:09:15.08,0:09:16.85,Default,,0,0,0,,Мен Ванессамен біраз уақыт бөлмеде боламын.
Dialogue: 0,0:09:15.08,0:09:16.85,Default,,0,0,0,,«Каролин Ванесса»
Dialogue: 0,0:09:17.15,0:09:18.15,Default,,0,0,0,,Сол әуесқой
Dialogue: 0,0:09:18.22,0:09:19.05,Default,,0,0,0,,Және…
Dialogue: 0,0:09:19.12,0:09:22.16,Default,,0,0,0,,Ванесса менің агентім болды
Dialogue: 0,0:09:22.22,0:09:22.86,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:09:22.99,0:09:26.59,Default,,0,0,0,,Сіз ғашығыңызбен қосарлы рөлдерді ойнай алмайсыз, сондықтан жұмыстан босатыласыз.
Dialogue: 0,0:09:26.66,0:09:28.00,Default,,0,0,0,,Махаббатқа рұқсат етілген
Dialogue: 0,0:09:28.06,0:09:29.66,Default,,0,0,0,,Мен көп ақша табамын
Dialogue: 0,0:09:29.73,0:09:33.83,Default,,0,0,0,,Мен сенімен бірге шыға аламын, менде жақсы агент бар.
Dialogue: 0,0:09:33.90,0:09:35.07,Default,,0,0,0,,Бұл ең жақсы
Dialogue: 0,0:09:35.84,0:09:36.84,Default,,0,0,0,,Мен жабайы боламын
Dialogue: 0,0:09:37.67,0:09:40.04,Default,,0,0,0,,Сіз әлі де бақыт іздеп жүрсіз бе?
Dialogue: 0,0:09:40.11,0:09:42.21,Default,,0,0,0,,Бақыт - бұл сіз жасайтын нәрсе
Dialogue: 0,0:09:43.64,0:09:46.08,Default,,0,0,0,,Гутен Бурбон
Dialogue: 0,0:09:46.15,0:09:47.65,Default,,0,0,0,,Cut Like
Dialogue: 0,0:09:47.72,0:09:48.18,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:09:48.28,0:09:51.89,Default,,0,0,0,,Мен көбірек көмектескім келеді.
Dialogue: 0,0:09:51.95,0:09:56.79,Default,,0,0,0,,Әлгі роботтың көздері жылтыр, көңілін аударады.
Dialogue: 0,0:09:56.99,0:09:59.66,Default,,0,0,0,,Сізді түсіріп жатқан камера.
Dialogue: 0,0:09:59.73,0:10:03.20,Default,,0,0,0,,Бұл жұмыс үшін. Мені тез қуып жібер.
Dialogue: 0,0:10:03.26,0:10:07.07,Default,,0,0,0,,Мен бұл бурбонның бетімін.
Dialogue: 0,0:10:07.17,0:10:11.37,Default,,0,0,0,,Олар неміс бурбонын насихаттауға тырысуда.
Dialogue: 0,0:10:13.27,0:10:16.61,Default,,0,0,0,,Бұл нағыз алкоголь сияқты
Dialogue: 0,0:10:17.81,0:10:19.35,Default,,0,0,0,,Әсіресе басқа елдің күшіне сүйенген адамға.
Dialogue: 0,0:10:19.65,0:10:24.15,Default,,0,0,0,,Ол NG директорлары мен көмекшілерінің тізімі.
Dialogue: 0,0:10:24.65,0:10:25.95,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:10:26.05,0:10:30.99,Default,,0,0,0,,Барлық таланттар танымал болса, менің көріну мүмкіндігім болмас еді.
Dialogue: 0,0:10:31.13,0:10:33.66,Default,,0,0,0,,Сонда ол ең жақсы
Dialogue: 0,0:10:33.79,0:10:35.63,Default,,0,0,0,,Жұмыс істемейтіндер
Dialogue: 0,0:10:36.20,0:10:39.70,Default,,0,0,0,,БоДжектің агенті кім?
Dialogue: 0,0:10:39.80,0:10:43.80,Default,,0,0,0,,Менің көп ақша табуға болатын жұмысым бар.
Dialogue: 0,0:10:43.87,0:10:44.84,Default,,0,0,0,,Мұндай нәрсе болуы мүмкін емес.
Dialogue: 0,0:10:44.94,0:10:46.04,Default,,0,0,0,,өзінің нағыз Кира екенін дәлелдеуге бағытталған алдын ала ойластырылған кісі өлтіру
Dialogue: 0,0:10:46.11,0:10:49.08,Default,,0,0,0,,Негізі... Мен сені бопсалауға келдім.
Dialogue: 0,0:10:49.24,0:10:50.98,Default,,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,0:10:51.08,0:10:55.02,Default,,0,0,0,,Мына фото шықса жаман болады.
Dialogue: 0,0:10:55.08,0:10:59.32,Default,,0,0,0,,Бірақ оқиғаға байланысты мен ешқашан болмағандай кейіп танытамын.
Dialogue: 0,0:10:59.92,0:11:03.42,Default,,0,0,0,,Әрқайсысы 150 доллардан ше?
Dialogue: 0,0:11:03.86,0:11:04.76,Default,,0,0,0,,Мен де
Dialogue: 0,0:11:04.83,0:11:06.09,Default,,0,0,0,,Мен чек арқылы төлей аламын ба?
Dialogue: 0,0:11:08.00,0:11:12.90,Default,,0,0,0,,Жеке меншікте рұқсатсыз суретке түсіруге тыйым салынады.
Dialogue: 0,0:11:13.20,0:11:14.17,Default,,0,0,0,,Рұқсат алдыңыз ба?
Dialogue: 0,0:11:14.30,0:11:15.20,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:15.27,0:11:20.27,Default,,0,0,0,,Сондай-ақ, бопсалау ауыр қылмыс болып табылады, сондықтан сіз 4 жылға бас бостандығынан айырыласыз.
Dialogue: 0,0:11:20.37,0:11:22.24,Default,,0,0,0,,Кісі өлтіруді қосыңыз...
Dialogue: 0,0:11:22.34,0:11:23.14,Default,,0,0,0,,Өлмеген
Dialogue: 0,0:11:23.21,0:11:24.68,Default,,0,0,0,,Біз кінәсізбіз
Dialogue: 0,0:11:24.85,0:11:26.35,Default,,0,0,0,,Мен оны кінәлі ретінде көрсетейін бе?
Dialogue: 0,0:11:27.31,0:11:28.35,Default,,0,0,0,,Кешіріңіз, мазаладым.
Dialogue: 0,0:11:28.42,0:11:29.72,Default,,0,0,0,,Оны ұмыт
Dialogue: 0,0:11:34.09,0:11:35.36,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:11:35.42,0:11:37.99,Default,,0,0,0,,Бұрынғы екі адамға сыйлық беру.
Dialogue: 0,0:11:38.13,0:11:39.03,Default,,0,0,0,,Иә
Dialogue: 0,0:11:39.09,0:11:40.69,Default,,0,0,0,,Менің көмекшім
Dialogue: 0,0:11:40.83,0:11:41.83,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:11:41.90,0:11:43.36,Default,,0,0,0,,О, бастық
Dialogue: 0,0:11:43.43,0:11:45.40,Default,,0,0,0,,Адамның басы 4 кг.
Dialogue: 0,0:11:45.47,0:11:46.30,Default,,0,0,0,,Нұсқаулық
Dialogue: 0,0:11:46.70,0:11:52.94,Default,,0,0,0,,Кешіріңіз, біз бір бөлмені бөлісеміз, бірақ бұл қызметкерлерді қысқарту аяқталғанша ғана.
Dialogue: 0,0:11:53.01,0:11:55.48,Default,,0,0,0,,Оның орнына мен көмекші дайындадым.
Dialogue: 0,0:11:55.78,0:12:00.05,Default,,0,0,0,,Бұл Чарли, менің ұлым және үміт жұлдызы.
Dialogue: 0,0:12:00.25,0:12:02.02,Default,,0,0,0,,Алдын ала рахмет...
Dialogue: 0,0:12:02.32,0:12:05.99,Default,,0,0,0,,Кешіріңіз, менің қолым жабысқақ.
Dialogue: 0,0:12:07.76,0:12:11.03,Default,,0,0,0,,Қызық, мені жақында жұмыстан босатады ма...?
Dialogue: 0,0:12:12.16,0:12:15.00,Default,,0,0,0,,Сон Гарвардтың бас редакторы.
Dialogue: 0,0:12:15.06,0:12:19.80,Default,,0,0,0,,Себебі менде Кэролайннан төмен Лаура бар.
Dialogue: 0,0:12:20.47,0:12:23.00,Default,,0,0,0,,Телефон шырылдап тұр!
Dialogue: 0,0:12:23.07,0:12:24.51,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:12:24.97,0:12:27.27,Default,,0,0,0,,Мен оны осында аламын, иә.
Dialogue: 0,0:12:27.34,0:12:29.84,Default,,0,0,0,,Дарын ұшады
Dialogue: 0,0:12:29.91,0:12:31.91,Default,,0,0,0,,Егер бұл BoJack болса...
Dialogue: 0,0:12:32.01,0:12:33.41,Default,,0,0,0,,Бұл Тодд.
Dialogue: 0,0:12:33.48,0:12:36.18,Default,,0,0,0,,Біреу спиртті араластырған сияқты.
Dialogue: 0,0:12:36.25,0:12:39.92,Default,,0,0,0,,Бурбон Кентуккиден
Dialogue: 0,0:12:39.99,0:12:42.52,Default,,0,0,0,,Неміс бурбоны бурбон емес.
Dialogue: 0,0:12:42.79,0:12:46.79,Default,,0,0,0,,Сан-Франциско шампанымен бірдей.
Dialogue: 0,0:12:47.46,0:12:49.26,Default,,0,0,0,,Мен жақында барамын.
Dialogue: 0,0:12:50.33,0:12:54.50,Default,,0,0,0,,Мықты бол, сен жеңімпазсың.
Dialogue: 0,0:12:54.84,0:12:55.27,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:12:55.34,0:12:59.01,Default,,0,0,0,,«Ева Браун» Өндіріс тобымен кездесу
Dialogue: 0,0:12:59.34,0:13:00.27,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,0:13:00.34,0:13:02.31,Default,,0,0,0,,Сәттілік, Тодд...
Dialogue: 0,0:13:02.81,0:13:03.54,Default,,0,0,0,,Сіздің есіміңіз кім?
Dialogue: 0,0:13:03.81,0:13:04.38,Default,,0,0,0,,Чавес
Dialogue: 0,0:13:04.48,0:13:05.81,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:13:05.88,0:13:06.31,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:13:06.41,0:13:08.55,Default,,0,0,0,,Себебі мен оны бірінші рет естіп тұрмын
Dialogue: 0,0:13:08.82,0:13:09.48,Default,,0,0,0,,Толық түсінгенім жоқ, бірақ—
Dialogue: 0,0:13:09.55,0:13:11.25,Default,,0,0,0,,Мен жігер берудің ортасындамын.
Dialogue: 0,0:13:11.32,0:13:13.79,Default,,0,0,0,,Мен киномен айналысып жатырмын.
Dialogue: 0,0:13:15.22,0:13:17.53,Default,,0,0,0,,Фильмнің әсерлі фразасы —
Dialogue: 0,0:13:17.83,0:13:21.96,Default,,0,0,0,,«Өзгелерді жек көретін адамға ғашық болған әйелдің оқиғасы»
Dialogue: 0,0:13:22.03,0:13:23.16,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:13:23.23,0:13:26.83,Default,,0,0,0,,Сіз қайда болдыңыз? Мен барлық жерден іздедім.
Dialogue: 0,0:13:26.90,0:13:29.24,Default,,0,0,0,,Менсіз кездесу өткізесіз бе?
Dialogue: 0,0:13:29.30,0:13:31.01,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:31.11,0:13:35.58,Default,,0,0,0,,Олар мені асықтырды. Қазір бітті.
Dialogue: 0,0:13:35.84,0:13:36.88,Default,,0,0,0,,Менің қонағым
Dialogue: 0,0:13:36.98,0:13:40.11,Default,,0,0,0,,Жиналыстан кейінгі есеп
Dialogue: 0,0:13:40.18,0:13:42.48,Default,,0,0,0,,Бұл С.Тарантулино ма?
Dialogue: 0,0:13:42.55,0:13:46.52,Default,,0,0,0,,Ол маған телефон соғып, романтикалық комедия түсіргісі келетінін айтты.
Dialogue: 0,0:13:46.85,0:13:48.49,Default,,0,0,0,,Мен ондай адам емеспін.
Dialogue: 0,0:13:48.99,0:13:50.39,Default,,0,0,0,,Олай болса
Dialogue: 0,0:13:53.13,0:13:56.53,Default,,0,0,0,,Өмірді болжау мүмкін емес.
Dialogue: 0,0:13:56.60,0:13:57.57,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:13:59.03,0:14:01.00,Default,,0,0,0,,Мен тым көп бұрылдым
Dialogue: 0,0:14:02.20,0:14:05.97,Default,,0,0,0,,Мен Тоддтың кесірінен кездесуді жіберіп алдым.
Dialogue: 0,0:14:06.04,0:14:09.31,Default,,0,0,0,,Себебі сіз спиртті араластырдыңыз.
Dialogue: 0,0:14:09.38,0:14:11.11,Default,,0,0,0,,Мен үшін не істей аласың?
Dialogue: 0,0:14:11.41,0:14:12.35,Default,,0,0,0,,Тіпті кешкі ас кезінде
Dialogue: 0,0:14:12.45,0:14:13.28,Default,,0,0,0,,№
Dialogue: 0,0:14:13.45,0:14:16.32,Default,,0,0,0,,Сапалы шарапты бірге ішейік
Dialogue: 0,0:14:17.02,0:14:20.55,Default,,0,0,0,,Пісіру: Тісбасар мен негізгі тағамды орналастырыңыз...
Dialogue: 0,0:14:20.62,0:14:22.12,Default,,0,0,0,,Мен иесімін
Dialogue: 0,0:14:22.36,0:14:23.32,Default,,0,0,0,,Жұмыс
Dialogue: 0,0:14:23.39,0:14:26.13,Default,,0,0,0,,Сізді жұмыс итермелейді.
Dialogue: 0,0:14:28.26,0:14:30.33,Default,,0,0,0,,Тыныс алсам ше?
Dialogue: 0,0:14:32.53,0:14:35.17,Default,,0,0,0,,«Піл жабық»
Dialogue: 0,0:14:35.57,0:14:42.01,Default,,0,0,0,,Бұрын мен жақсы дос та, жақсы ғашық та емес едім.
Dialogue: 0,0:14:43.34,0:14:44.35,Default,,0,0,0,,Мен өкінемін
Dialogue: 0,0:14:44.58,0:14:45.35,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:45.58,0:14:48.42,Default,,0,0,0,,«Ғашықтар» басқаша.
Dialogue: 0,0:14:48.52,0:14:51.92,Default,,0,0,0,,Бұл жерден кетіп, желато жесек қалай болады?
Dialogue: 0,0:14:51.99,0:14:54.89,Default,,0,0,0,,Теңізге қарай жүріңіз
Dialogue: 0,0:14:54.99,0:14:56.39,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:56.46,0:14:58.59,Default,,0,0,0,,Мен сенің сақалыңды қысқартамын.
Dialogue: 0,0:14:58.66,0:15:00.66,Default,,0,0,0,,Көлікті қозғалыста ұстаңыз
Dialogue: 0,0:15:00.96,0:15:04.40,Default,,0,0,0,,Маған ғашық болмай тұрып қайт
Dialogue: 0,0:15:04.60,0:15:05.37,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:15:08.44,0:15:09.40,Default,,0,0,0,,Ванесса
Dialogue: 0,0:15:09.50,0:15:13.17,Default,,0,0,0,,Сіз жұмыстан ерте шықтыңыз.
Dialogue: 0,0:15:13.31,0:15:15.11,Default,,0,0,0,,8:30-ға дейін сонда болдым.
Dialogue: 0,0:15:15.18,0:15:18.48,Default,,0,0,0,,Кейт екеуміз оны таптық.
Dialogue: 0,0:15:18.55,0:15:22.55,Default,,0,0,0,,Менде «Ева Браунға» ұқсас сезімдер бар
Dialogue: 0,0:15:22.62,0:15:25.15,Default,,0,0,0,,Мен сіздің агентіңіз болайын ба?
Dialogue: 0,0:15:25.22,0:15:27.45,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:15:27.52,0:15:31.66,Default,,0,0,0,,Бізде ортақ нәрсе бар: жұмыс істейтін ана болу.
Dialogue: 0,0:15:31.96,0:15:33.66,Default,,0,0,0,,Мені ауыстырғаныңды қалаймын.
Dialogue: 0,0:15:35.10,0:15:38.93,Default,,0,0,0,,«Ана» болу қаншалықты пайдалы екені таң қалдырады.
Dialogue: 0,0:15:39.33,0:15:41.67,Default,,0,0,0,,Мен ол туралы бәрін білемін
Dialogue: 0,0:15:41.94,0:15:46.51,Default,,0,0,0,,Менің сүйікті түсім, сүйікті кітабым, сүйікті әйелдер тобы.
Dialogue: 0,0:15:46.61,0:15:47.98,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:48.04,0:15:51.38,Default,,0,0,0,,Ол британдық және танымал. Мен оны жақсы білемін.
Dialogue: 0,0:15:51.45,0:15:53.31,Default,,0,0,0,,Австралиялықтар
Dialogue: 0,0:15:53.48,0:15:55.25,Default,,0,0,0,,Кешіріңіз, бірақ бұл жұмыс.
Dialogue: 0,0:15:55.32,0:15:56.55,Default,,0,0,0,,Осы мақсатта алдымен маған өзіңнің Қирктеріңнің егжей-тегжейін айт.
Dialogue: 0,0:15:57.08,0:16:00.02,Default,,0,0,0,,Осы мақсатта алдымен маған өзіңнің Қирктеріңнің егжей-тегжейін айт.
Dialogue: 0,0:16:02.12,0:16:04.16,Default,,0,0,0,,(Курокири) Шигараки, күткен нәтижеңді алдың ба?
Dialogue: 0,0:16:04.22,0:16:05.59,Default,,0,0,0,,Кейтпен байланысыңыз
Dialogue: 0,0:16:05.66,0:16:09.00,Default,,0,0,0,,Біреу... Не істеуім керек? Мен қиындыққа тап болдым.
Dialogue: 0,0:16:09.06,0:16:11.53,Default,,0,0,0,,Жоқ, ресивер өшірулі...
Dialogue: 0,0:16:12.27,0:16:14.60,Default,,0,0,0,,Маған бұл енді ұнамайды
Dialogue: 0,0:16:14.67,0:16:19.51,Default,,0,0,0,,Егер сіз онымен ұрсып қалсаңыз, қалағаныңызды жасаңыз.
Dialogue: 0,0:16:20.01,0:16:22.54,Default,,0,0,0,,Менде бәрі жақсы, мен бақытты боламын
Dialogue: 0,0:16:23.11,0:16:26.01,Default,,0,0,0,,Мен бүгін кешке бақытты уақытты таңдаймын
Dialogue: 0,0:16:26.18,0:16:28.45,Default,,0,0,0,,Мен дыбысты өшірдім.
Dialogue: 0,0:16:28.55,0:16:29.68,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:16:35.36,0:16:35.99,Default,,0,0,0,,«Шөптер»
Dialogue: 0,0:16:35.99,0:16:37.29,Default,,0,0,0,,«Шөптер»
Dialogue: 0,0:16:35.99,0:16:37.29,Default,,0,0,0,,Неге тағы...
Dialogue: 0,0:16:38.66,0:16:40.26,Default,,0,0,0,,Шөптер
Dialogue: 0,0:16:40.39,0:16:42.30,Default,,0,0,0,,Соңғы кездері қалай болдыңыз?
Dialogue: 0,0:16:42.36,0:16:43.66,Default,,0,0,0,,Бұл өрескел.
Dialogue: 0,0:16:44.03,0:16:45.07,Default,,0,0,0,,Не айтып тұрсың?
Dialogue: 0,0:16:45.17,0:16:46.67,Default,,0,0,0,,Мен сіздің жауап беру құрылғыңызды естідім.
Dialogue: 0,0:16:47.57,0:16:49.10,Default,,0,0,0,,Әңгімелейтін нәрсе бар, солай ма?
Dialogue: 0,0:16:49.17,0:16:53.04,Default,,0,0,0,,Малибуға кел, ертең тірі боласың
Dialogue: 0,0:16:53.47,0:16:55.51,Default,,0,0,0,,Ертеңгі күнді білмеймін.
Dialogue: 0,0:16:58.78,0:17:00.38,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:17:00.45,0:17:02.72,Default,,0,0,0,,Мұқият күтім
Dialogue: 0,0:17:03.32,0:17:04.45,Default,,0,0,0,,Осымен
Dialogue: 0,0:17:04.79,0:17:08.79,Default,,0,0,0,,Маған біртүрлі телефон қоңырауы келді...
Dialogue: 0,0:17:09.06,0:17:12.49,Default,,0,0,0,,Мен де, бірақ сен бүгін көңілді боласың, солай ма?
Dialogue: 0,0:17:12.59,0:17:13.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:14.80,0:17:16.33,Default,,0,0,0,,Желато ше?
Dialogue: 0,0:17:16.63,0:17:18.53,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:17:19.23,0:17:20.60,Default,,0,0,0,,Сіз тамақ ішпейсіз бе?
Dialogue: 0,0:17:23.24,0:17:24.34,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:24.81,0:17:29.51,Default,,0,0,0,,Мен жай ғана ақымақ істермен айналыстым, мен мына телефон қоңырауынан ояндым.
Dialogue: 0,0:17:29.58,0:17:32.38,Default,,0,0,0,,Біз ғашық емеспіз
Dialogue: 0,0:17:32.45,0:17:36.05,Default,,0,0,0,,Екеуміз де өзімізден жиіркенетін жалғызбасты адамдармыз.
Dialogue: 0,0:17:36.32,0:17:38.25,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:17:38.75,0:17:40.52,Default,,0,0,0,,Бұдан былай да
Dialogue: 0,0:17:41.82,0:17:43.76,Default,,0,0,0,,Жоспарларды өзгерту.
Dialogue: 0,0:17:47.16,0:17:48.40,Default,,0,0,0,,Ақылсыз көрінеді
Dialogue: 0,0:17:48.46,0:17:52.43,Default,,0,0,0,,Бұлай болатынын білсем де, көңілім көтерілді.
Dialogue: 0,0:17:52.50,0:17:54.67,Default,,0,0,0,,Маған бұл туралы алаңдау керек пе?
Dialogue: 0,0:18:00.71,0:18:02.18,Default,,0,0,0,,Олай болса
Dialogue: 0,0:18:02.24,0:18:03.81,Default,,0,0,0,,Маған жібермейсіз бе?
Dialogue: 0,0:18:04.11,0:18:06.41,Default,,0,0,0,,Мен жалғыз қалғым келеді
Dialogue: 0,0:18:11.35,0:18:15.66,Default,,0,0,0,,Жылқыға ғашық болған соң осылай болады.
Dialogue: 0,0:18:15.72,0:18:16.62,Default,,0,0,0,,(Әйел турист 1) Санта-Киара шіркеуіне қалай жетуге болады?
Dialogue: 0,0:18:18.39,0:18:20.46,Default,,0,0,0,,Мықты бол
Dialogue: 0,0:18:20.56,0:18:24.43,Default,,0,0,0,,Сәл ғашық болып, жүрегім ауырып кетті.
Dialogue: 0,0:18:24.53,0:18:26.37,Default,,0,0,0,,Эмоциялық марапаттау
Dialogue: 0,0:18:26.53,0:18:29.30,Default,,0,0,0,,Сіз мансап иесісіз
Dialogue: 0,0:18:29.37,0:18:33.21,Default,,0,0,0,,Бір сәт те босқа кетпейді
Dialogue: 0,0:18:33.41,0:18:35.31,Default,,0,0,0,,Мен қазір робот боламын
Dialogue: 0,0:18:35.41,0:18:37.31,Default,,0,0,0,,...
Dialogue: 0,0:18:41.55,0:18:42.18,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:18:42.25,0:18:43.85,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:18:44.25,0:18:48.39,Default,,0,0,0,,Сіз өзіңізді жақсы сезінбейсіз. Юбеге зиян тигіздің бе?
Dialogue: 0,0:18:48.52,0:18:50.26,Default,,0,0,0,,Агенттерге эмоциялар қажет емес
Dialogue: 0,0:18:50.32,0:18:54.60,Default,,0,0,0,,Айтпақшы, мен жұмысқа қайта оралғым келеді.
Dialogue: 0,0:18:54.70,0:18:55.60,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:18:55.73,0:18:57.83,Default,,0,0,0,,Мен енді сізге жауапты емеспін.
Dialogue: 0,0:18:58.17,0:19:00.70,Default,,0,0,0,,Дұрыс, мен түсінемін.
Dialogue: 0,0:19:05.87,0:19:06.84,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:19:07.88,0:19:11.45,Default,,0,0,0,,Хербпен кездескен жігіт қатерлі ісікке шалдыққан.
Dialogue: 0,0:19:11.51,0:19:16.52,Default,,0,0,0,,Сіз қайтып келгенше жақсы жаңалық естігім келеді.
Dialogue: 0,0:19:16.65,0:19:19.35,Default,,0,0,0,,Шөпке? Мүлдем жоқ...
Dialogue: 0,0:19:19.69,0:19:22.36,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:19:22.79,0:19:26.53,Default,,0,0,0,,Бүгін де қолымыздан келгенді жасайық.
Dialogue: 0,0:19:26.59,0:19:29.60,Default,,0,0,0,,Көшірме машина ретінде байлау
Dialogue: 0,0:19:29.66,0:19:30.60,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:19:30.66,0:19:34.64,Default,,0,0,0,,Бірақ мұны істесең, галстук жүгіреді.
Dialogue: 0,0:19:34.70,0:19:38.21,Default,,0,0,0,,БоДжек жұмыс алғысы келеді.
Dialogue: 0,0:19:38.27,0:19:42.48,Default,,0,0,0,,Оған қатысты Гвинет бүгін таңертең келді.
Dialogue: 0,0:19:42.54,0:19:45.51,Default,,0,0,0,,Оның келісім шарты үзілді
Dialogue: 0,0:19:46.31,0:19:48.32,Default,,0,0,0,,Сіз кеше келісімшартқа қол қойған болсаңыз да?
Dialogue: 0,0:19:48.42,0:19:52.92,Default,,0,0,0,,Қиындықтан құтылу жақсы емес пе?
Dialogue: 0,0:19:53.25,0:19:58.39,Default,,0,0,0,,Бұл тиімді емес және сіз мұны істеуде қиындықтарға тап болар едіңіз.
Dialogue: 0,0:19:58.49,0:20:01.86,Default,,0,0,0,,Мен Аризонаданмын.
Dialogue: 0,0:20:01.93,0:20:03.83,Default,,0,0,0,,Тодд Қуатты қалай өшіруге болады?
Dialogue: 0,0:20:04.50,0:20:05.73,Default,,0,0,0,,Тодд
Dialogue: 0,0:20:05.80,0:20:07.80,Default,,0,0,0,,Мен бос емеспін.
Dialogue: 0,0:20:07.90,0:20:10.47,Default,,0,0,0,,Мүмкін осы шығар
Dialogue: 0,0:20:10.97,0:20:15.28,Default,,0,0,0,,Ал, тромбонда ойнауға жаттығамыз.
Dialogue: 0,0:20:20.48,0:20:23.82,Default,,0,0,0,,Құлдыраса да, жұмыстан шығарылды ма?
Dialogue: 0,0:20:23.92,0:20:26.89,Default,,0,0,0,,Тіпті сіз жұмысқа орналаса алмадыңыз
Dialogue: 0,0:20:26.95,0:20:29.62,Default,,0,0,0,,Мен коммерциялық жұмысқа орналастым.
Dialogue: 0,0:20:29.69,0:20:31.83,Default,,0,0,0,,Фильм жұмысы бүгін басталады
Dialogue: 0,0:20:31.99,0:20:37.53,Default,,0,0,0,,Келісім-шартқа қол жеткізе алмасам, мен оны жіберемін.
Dialogue: 0,0:20:37.60,0:20:38.57,Default,,0,0,0,,Чарли
Dialogue: 0,0:20:38.67,0:20:42.90,Default,,0,0,0,,Сіз «галстук шоу» жасайсыз ба? Бұл керемет
Dialogue: 0,0:20:43.24,0:20:44.87,Default,,0,0,0,,Рахмет, әке.
Dialogue: 0,0:20:47.54,0:20:50.48,Default,,0,0,0,,Марти Бұл Кэролайн.
Dialogue: 0,0:20:50.54,0:20:53.48,Default,,0,0,0,,Неліктен BoJack-пен бірігуге болмайды?
Dialogue: 0,0:20:53.55,0:20:55.35,Default,,0,0,0,,Мүлдем жоқ па?
Dialogue: 0,0:20:55.42,0:20:57.42,Default,,0,0,0,,Әрекет ету жаман ба?
Dialogue: 0,0:20:57.48,0:20:59.32,Default,,0,0,0,,100 қоңыраудан кейін
Dialogue: 0,0:20:59.49,0:21:01.79,Default,,0,0,0,,Ешқашан қайта жұмыс істемейсіз бе?
Dialogue: 0,0:21:01.86,0:21:07.63,Default,,0,0,0,,«Ол тегістелсе, мен өзімді жақсы сезінемін»?
Dialogue: 0,0:21:08.33,0:21:10.30,Default,,0,0,0,,Егер сіз өз пікіріңізді өзгертсеңіз, бізге қоңырау шалыңыз.
Dialogue: 0,0:21:10.70,0:21:12.60,Default,,0,0,0,,Берілмеңіз.
Dialogue: 0,0:21:12.70,0:21:17.67,Default,,0,0,0,,Неліктен көп жұмыс істейсің? Бұл жай ғана мүше
Dialogue: 0,0:21:17.80,0:21:20.41,Default,,0,0,0,,Қолыңды кеспесең бақытты бола алмайсың.
Dialogue: 0,0:21:20.47,0:21:21.91,Default,,0,0,0,,Бір-біріне көмектесу
Dialogue: 0,0:21:22.81,0:21:24.78,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:21:25.31,0:21:27.28,Default,,0,0,0,,Директор Кроу
Dialogue: 0,0:21:27.35,0:21:29.82,Default,,0,0,0,,«Агент» - шедевр.
Dialogue: 0,0:21:29.95,0:21:33.79,Default,,0,0,0,,Режиссер қарға болса да, адамдық қасиеті бар.
Dialogue: 0,0:21:33.92,0:21:37.86,Default,,0,0,0,,Техникалық тұрғыдан айтсам, мен қарғамын.
Dialogue: 0,0:21:38.36,0:21:39.43,Default,,0,0,0,,Көбінесе дұрыс түсінбейді
Dialogue: 0,0:21:39.49,0:21:39.99,Default,,0,0,0,,Не...
Dialogue: 0,0:21:40.06,0:21:40.69,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:21:40.76,0:21:42.36,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,0:21:42.46,0:21:48.50,Default,,0,0,0,,«Суфрагеттер қаласы» «Рок және 80-жылдардың жастары»
Dialogue: 0,0:21:48.57,0:21:50.50,Default,,0,0,0,,«Ал хайуанаттар бағын алу»?
Dialogue: 0,0:21:50.60,0:21:52.07,Default,,0,0,0,,Ондай кітап бар ма?
Dialogue: 0,0:21:52.34,0:21:54.47,Default,,0,0,0,,Оны фильмге айналдырыңыз
Dialogue: 0,0:21:54.54,0:21:59.45,Default,,0,0,0,,Бұл Кейттің сүйікті кітабы, сондықтан ол оған қуана шығады.
Dialogue: 0,0:21:59.61,0:22:01.52,Default,,0,0,0,,Қалай ойлайсың, Карр?
Dialogue: 0,0:22:01.62,0:22:04.92,Default,,0,0,0,,Бұл жақсы әңгіме, бірақ бұл қарғаның зары.
Dialogue: 0,0:22:04.99,0:22:06.52,Default,,0,0,0,,Мен қарғамын
Dialogue: 0,0:22:06.82,0:22:09.62,Default,,0,0,0,,«Вигер»
Dialogue: 0,0:22:10.59,0:22:15.60,Default,,0,0,0,,«Ева Браунға» түсу сіздің арманыңыз емес пе?
Dialogue: 0,0:22:15.66,0:22:18.07,Default,,0,0,0,,Кейт? сәлем?
Dialogue: 0,0:22:18.33,0:22:18.83,Default,,0,0,0,,Кейт!
Dialogue: 0,0:22:19.57,0:22:21.47,Default,,0,0,0,,Не болды?
Dialogue: 0,0:22:21.54,0:22:26.77,Default,,0,0,0,,Холокост фильмдерін Кроу түсірген фильмдерге ауыстыру керек пе?
Dialogue: 0,0:22:26.84,0:22:30.84,Default,,0,0,0,,Неге қыздарыңыздан жұбатуды сұрамайсыз?
Dialogue: 0,0:22:30.91,0:22:33.91,Default,,0,0,0,,«Ева Браунға» кім жауапты?
Dialogue: 0,0:22:34.08,0:22:35.45,Default,,0,0,0,,Мен
Dialogue: 0,0:22:35.58,0:22:38.35,Default,,0,0,0,,Мен бұл жолы сәтсіздікке ұшырадым.
Dialogue: 0,0:22:38.42,0:22:42.62,Default,,0,0,0,,Мен жұмыстан қуылғанға шыдай алмаймын, өз еркімен жұмыстан кетуге не жетсін?
Dialogue: 0,0:22:42.69,0:22:43.92,Default,,0,0,0,,Төртелтауб мырза
Dialogue: 0,0:22:44.42,0:22:45.39,Default,,0,0,0,,Рахмет
Dialogue: 0,0:22:45.53,0:22:50.86,Default,,0,0,0,,Мен Кейт Кроу фильміне түседі деп естідім. Бұл рас па?
Dialogue: 0,0:22:51.06,0:22:54.37,Default,,0,0,0,,Мен Портерге айтқанымдай...
Dialogue: 0,0:22:54.43,0:22:57.60,Default,,0,0,0,,«Пойыз осы жолмен келе жатыр».
Dialogue: 0,0:22:57.77,0:23:00.47,Default,,0,0,0,,Ванесса «Еваға» жауапты
Dialogue: 0,0:23:00.67,0:23:01.84,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:01.94,0:23:06.15,Default,,0,0,0,,Директор Тарантулино да бұған ынталы болды.
Dialogue: 0,0:23:06.55,0:23:12.75,Default,,0,0,0,,«Голливудтан» D ұрлап, үйленуге ұсыныс жасаған адам болды.
Dialogue: 0,0:23:12.82,0:23:14.76,Default,,0,0,0,,Оны фильмге түсіруге болады.
Dialogue: 0,0:23:14.82,0:23:16.66,Default,,0,0,0,,Бірақ басты кейіпкер кім?
Dialogue: 0,0:23:16.72,0:23:22.16,Default,,0,0,0,,Режиссерлер сәтсіз актерлерді қайтадан ашуға итермелейді.
Dialogue: 0,0:23:22.43,0:23:24.40,Default,,0,0,0,,Рөлге кім лайық деп ойлайсың?
Dialogue: 0,0:23:24.46,0:23:26.07,Default,,0,0,0,,Маған ақшаны көрсетіңіз
Dialogue: 0,0:23:29.97,0:23:30.60,Default,,0,0,0,,Иә
Dialogue: 0,0:23:30.67,0:23:31.67,Default,,0,0,0,,Жақсы жаңалық
Dialogue: 0,0:23:31.74,0:23:36.48,Default,,0,0,0,,Мен романтикалық комедия фильмінде басты рөлді алдым.
Dialogue: 0,0:23:36.54,0:23:37.88,Default,,0,0,0,,Сіз ең жақсы агентсіз, солай емес пе?
Dialogue: 0,0:23:38.55,0:23:38.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:39.05,0:23:43.02,Default,,0,0,0,,Менде жағымсыз сезімдер болды, бірақ нәтиже жақсы болды.
Dialogue: 0,0:23:43.98,0:23:45.49,Default,,0,0,0,,Сіз бақытты емессіз бе?
Dialogue: 0,0:23:45.59,0:23:46.09,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:23:46.45,0:23:49.49,Default,,0,0,0,,Маған жұмыс маңызды емес.
Dialogue: 0,0:23:49.72,0:23:52.53,Default,,0,0,0,,Бірақ «Мен жұмыс алғым келеді»
Dialogue: 0,0:23:52.79,0:23:55.60,Default,,0,0,0,,Жұмыс...жеткілікті
Dialogue: 0,0:23:55.66,0:23:57.70,Default,,0,0,0,,Малибуда не бар?
Dialogue: 0,0:23:57.93,0:23:58.63,Default,,0,0,0,,Оны кесіңіз
Dialogue: 0,0:24:01.00,0:24:02.04,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:24:02.64,0:24:05.04,Default,,0,0,0,,Қазір үйге бара аласыз.
Dialogue: 0,0:24:05.94,0:24:07.47,Default,,0,0,0,,Үйге бармайсың ба?
Dialogue: 0,0:24:08.07,0:24:09.78,Default,,0,0,0,,Қайда қайтуым керек?
Dialogue: 0,0:24:10.11,0:24:14.15,Default,,0,0,0,,«Вигер»
Dialogue: 0,0:24:19.12,0:24:21.19,Default,,0,0,0,,«Бақытты таңда»
Dialogue: 0,0:24:21.79,0:24:24.12,Default,,0,0,0,,Мен оларды соншалықты ұнатпаймын...
Dialogue: 0,0:24:26.53,0:24:27.63,Default,,0,0,0,,Рахмет
Dialogue: 0,0:24:27.69,0:24:29.56,Default,,0,0,0,,Сіз 40 жастасыз
Dialogue: 0,0:24:31.06,0:24:37.06,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
