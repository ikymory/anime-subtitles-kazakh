Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.74,Default,,0,0,0,,NETFLIX түпнұсқа жұмысы
Dialogue: 0,0:00:16.31,0:00:20.08,Default,,0,0,0,,Мен сенен мені неге сүйдің деп сұрауым керек пе?
Dialogue: 0,0:00:20.18,0:00:22.05,Default,,0,0,0,,Сұрау қажет емес
Dialogue: 0,0:00:22.15,0:00:24.42,Default,,0,0,0,,Оның мағынасы көп емес.
Dialogue: 0,0:00:25.32,0:00:27.19,Default,,0,0,0,,Біз доспыз, солай ма?
Dialogue: 0,0:00:27.29,0:00:28.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:00:28.09,0:00:31.63,Default,,0,0,0,,Дос болу маңызды
Dialogue: 0,0:00:31.73,0:00:33.29,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:00:33.40,0:00:35.50,Default,,0,0,0,,Бұдан былай да
Dialogue: 0,0:00:35.63,0:00:36.50,Default,,0,0,0,,Біз доспыз.
Dialogue: 0,0:00:36.60,0:00:38.63,Default,,0,0,0,,Достық сол күйінде қалады
Dialogue: 0,0:00:38.73,0:00:41.07,Default,,0,0,0,,Сіз үйленгелі жатырсыз.
Dialogue: 0,0:00:41.17,0:00:44.51,Default,,0,0,0,,Келесі жазда Нантукет аралындағы үйлену тойы
Dialogue: 0,0:00:44.61,0:00:47.11,Default,,0,0,0,,LA жазынан қашу
Dialogue: 0,0:00:47.48,0:00:49.38,Default,,0,0,0,,Күйікті ЛА
Dialogue: 0,0:00:50.71,0:00:52.25,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:00:52.35,0:00:53.38,Default,,0,0,0,,Үйден алыс.
Dialogue: 0,0:00:53.48,0:00:54.72,Default,,0,0,0,,Жаяу
Dialogue: 0,0:00:56.65,0:00:58.12,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:00:58.62,0:00:59.52,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:01:00.36,0:01:01.66,Default,,0,0,0,,Рәсімге араласу
Dialogue: 0,0:01:02.16,0:01:02.76,Default,,0,0,0,,Тодд?
Dialogue: 0,0:01:04.53,0:01:06.19,Default,,0,0,0,,Мен оны Малибуда ұмытып кетіппін
Dialogue: 0,0:01:58.35,0:02:02.12,Default,,0,0,0,,БоДжек шабандозы
Dialogue: 0,0:02:02.22,0:02:03.28,Default,,0,0,0,,жексенбі
Dialogue: 0,0:02:03.28,0:02:03.82,Default,,0,0,0,,жексенбі
Dialogue: 0,0:02:03.28,0:02:03.82,Default,,0,0,0,,Дайан үйленгісі келмейді ме?
Dialogue: 0,0:02:03.82,0:02:06.39,Default,,0,0,0,,Дайан үйленгісі келмейді ме?
Dialogue: 0,0:02:06.45,0:02:09.69,Default,,0,0,0,,Мен қаламайтынымды түсінбеймін.
Dialogue: 0,0:02:09.79,0:02:12.33,Default,,0,0,0,,Сіз ең жақсы дос атанасыз.
Dialogue: 0,0:02:12.43,0:02:16.60,Default,,0,0,0,,Тойды бірге бұзайық.
Dialogue: 0,0:02:16.70,0:02:19.13,Default,,0,0,0,,Десең де…
Dialogue: 0,0:02:19.23,0:02:21.74,Default,,0,0,0,,Төтенше жағдай дегеніміз не?
Dialogue: 0,0:02:21.84,0:02:23.74,Default,,0,0,0,,Некеге араласу стратегиясы жиналысы
Dialogue: 0,0:02:24.24,0:02:26.74,Default,,0,0,0,,«Бұл төтенше жағдай» түн ортасында—
Dialogue: 0,0:02:26.84,0:02:29.51,Default,,0,0,0,,Сен мені ояттың.
Dialogue: 0,0:02:29.61,0:02:33.82,Default,,0,0,0,,Дайанның үйленуіне бір жыл қалды ма?
Dialogue: 0,0:02:34.15,0:02:35.22,Default,,0,0,0,,Идеяларыңыз бар ма?
Dialogue: 0,0:02:35.32,0:02:38.32,Default,,0,0,0,,Мен сенімен кездесе алмаймын.
Dialogue: 0,0:02:38.42,0:02:40.49,Default,,0,0,0,,Мен демалыс күні бардамын.
Dialogue: 0,0:02:40.59,0:02:42.36,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,0:02:42.46,0:02:44.89,Default,,0,0,0,,Ештеңе ойға келмейді, солай ма?
Dialogue: 0,0:02:45.19,0:02:46.90,Default,,0,0,0,,Эй, маған сусын сатып ал.
Dialogue: 0,0:02:47.20,0:02:48.70,Default,,0,0,0,,Қажеті жоқ. Айтқым келетін ешкім жоқ.
Dialogue: 0,0:02:48.80,0:02:50.60,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:02:50.70,0:02:52.83,Default,,0,0,0,,Винсент...
Dialogue: 0,0:02:52.93,0:02:56.57,Default,,0,0,0,,Ересек адам Винсент Ересек адам.
Dialogue: 0,0:02:56.67,0:02:59.91,Default,,0,0,0,,Ересек адам Винсент.
Dialogue: 0,0:03:00.21,0:03:02.31,Default,,0,0,0,,Әйелдерге қалай қарау керектігін білемін.
Dialogue: 0,0:03:02.41,0:03:04.25,Default,,0,0,0,,Ересек адам қайда?
Dialogue: 0,0:03:04.35,0:03:05.65,Default,,0,0,0,,Шай ішкіңіз келе ме?
Dialogue: 0,0:03:05.75,0:03:07.48,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:03:07.62,0:03:09.78,Default,,0,0,0,,Жақсы шақыру сөйлемі Шыдай алмаймын
Dialogue: 0,0:03:10.52,0:03:12.19,Default,,0,0,0,,Өз әңгімеңізді айтыңыз
Dialogue: 0,0:03:12.39,0:03:15.29,Default,,0,0,0,,Маған өз жұмысым ұнайды
Dialogue: 0,0:03:15.39,0:03:17.33,Default,,0,0,0,,Басқаша айтқанда, сауда
Dialogue: 0,0:03:18.76,0:03:22.40,Default,,0,0,0,,Батылдығыңызды көрсетіңіз, бірақ...
Dialogue: 0,0:03:22.50,0:03:25.50,Default,,0,0,0,,Менің иығыма мінген үш бала.
Dialogue: 0,0:03:25.60,0:03:27.74,Default,,0,0,0,,Сіз демалыс күні не істейсіз?
Dialogue: 0,0:03:27.84,0:03:30.67,Default,,0,0,0,,Мен сенімен кездесе алмаймын
Dialogue: 0,0:03:30.77,0:03:32.54,Default,,0,0,0,,Сәтті сауда үшін дұға етіңіз
Dialogue: 0,0:03:32.64,0:03:33.54,Default,,0,0,0,,Сәлем
Dialogue: 0,0:03:33.64,0:03:34.91,Default,,0,0,0,,Дүйсенбі
Dialogue: 0,0:03:35.51,0:03:39.68,Default,,0,0,0,,Пошта таситын көлікті тартып алу
Dialogue: 0,0:03:39.78,0:03:42.48,Default,,0,0,0,,Жаңа ғана ыстық болды
Dialogue: 0,0:03:42.58,0:03:46.29,Default,,0,0,0,,Мен жанкүйермін, сондықтан бұл жолы шыдаймын.
Dialogue: 0,0:03:52.46,0:03:53.53,Default,,0,0,0,,Жержаңғақ майы
Dialogue: 0,0:04:00.47,0:04:02.50,Default,,0,0,0,,Жақсы нәрсе болды
Dialogue: 0,0:04:02.60,0:04:04.44,Default,,0,0,0,,Полиция көлігіне міну
Dialogue: 0,0:04:04.54,0:04:06.84,Default,,0,0,0,,Менің лицензиям да тоқтатылды.
Dialogue: 0,0:04:06.94,0:04:09.61,Default,,0,0,0,,Кез келген жағдайда, тағы да пошта қызметкерімен?
Dialogue: 0,0:04:09.81,0:04:11.45,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:04:11.55,0:04:16.65,Default,,0,0,0,,Жаңбырда да, түнде де тоқтамайды.
Dialogue: 0,0:04:17.45,0:04:19.32,Default,,0,0,0,,Сондықтан мен сізбен ақылдасамын.
Dialogue: 0,0:04:19.45,0:04:22.52,Default,,0,0,0,,Менің жүргізуші бол
Dialogue: 0,0:04:22.59,0:04:24.99,Default,,0,0,0,,Жоқ, мен қазір бос емеспін.
Dialogue: 0,0:04:25.33,0:04:28.00,Default,,0,0,0,,Үйлену тойына сыйлық жасау керек пе?
Dialogue: 0,0:04:28.30,0:04:29.73,Default,,0,0,0,,Кітап жазу
Dialogue: 0,0:04:29.86,0:04:31.73,Default,,0,0,0,,Сондай-ақ тізім жасау керек.
Dialogue: 0,0:04:31.83,0:04:36.74,Default,,0,0,0,,Мен сені жақсы көремін және үйленуге шыдамаймын.
Dialogue: 0,0:04:36.84,0:04:39.74,Default,,0,0,0,,Бірақ мен басқа нәрселермен айналысамын...
Dialogue: 0,0:04:39.84,0:04:42.68,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:04:42.78,0:04:44.68,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:04:44.78,0:04:47.05,Default,,0,0,0,,Тыңдауды жеңілдететін күйге ие болыңыз
Dialogue: 0,0:04:47.42,0:04:51.35,Default,,0,0,0,,Дұрыс, аяқтарыңызды былай қойыңыз.
Dialogue: 0,0:04:51.59,0:04:52.55,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:52.65,0:04:56.76,Default,,0,0,0,,Үйлену қиын деп ойлай бастадым.
Dialogue: 0,0:04:56.89,0:04:59.63,Default,,0,0,0,,Ойлануды жеңілдетіңіз
Dialogue: 0,0:04:59.73,0:05:01.56,Default,,0,0,0,,Мен мұны екі рет жасадым.
Dialogue: 0,0:05:01.66,0:05:06.53,Default,,0,0,0,,Мен білемін, бірақ мен жазуға назар аударғым келеді.
Dialogue: 0,0:05:06.73,0:05:09.50,Default,,0,0,0,,Менің драйверім мүмкін емес пе?
Dialogue: 0,0:05:09.60,0:05:10.54,Default,,0,0,0,,Мен біреуді жалдасам ше?
Dialogue: 0,0:05:11.31,0:05:12.77,Default,,0,0,0,,Шам жанды.
Dialogue: 0,0:05:12.84,0:05:15.91,Default,,0,0,0,,Әңгімені естіген соң маған бір ой келді.
Dialogue: 0,0:05:16.04,0:05:17.85,Default,,0,0,0,,Жүргізуші жалдаңыз
Dialogue: 0,0:05:18.01,0:05:19.85,Default,,0,0,0,,Қандай жақсы идея
Dialogue: 0,0:05:19.95,0:05:23.79,Default,,0,0,0,,Менің ойыма тамаша идея келді.
Dialogue: 0,0:05:26.85,0:05:30.49,Default,,0,0,0,,Сіз жасырын түрде кіре алмайсыз деп ойлаймын.
Dialogue: 0,0:05:30.56,0:05:31.86,Default,,0,0,0,,Бұл ең жақсысы
Dialogue: 0,0:05:31.93,0:05:36.06,Default,,0,0,0,,Қалған идеялардың бәрі нашар.
Dialogue: 0,0:05:36.40,0:05:36.93,Default,,0,0,0,,Құралдар туралы не деуге болады?
Dialogue: 0,0:05:37.00,0:05:37.63,Default,,0,0,0,,Харизма!
Dialogue: 0,0:05:37.70,0:05:38.53,Default,,0,0,0,,Ұялы телефондар ше?
Dialogue: 0,0:05:38.60,0:05:39.40,Default,,0,0,0,,Калий цианиді?
Dialogue: 0,0:05:39.47,0:05:40.87,Default,,0,0,0,,Ол не үшін қолданылады?
Dialogue: 0,0:05:41.00,0:05:42.50,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:05:42.60,0:05:44.77,Default,,0,0,0,,1-қадам Зерттеуге еніңіз
Dialogue: 0,0:05:50.81,0:05:53.38,Default,,0,0,0,,2-қадам Айыптауды компьютерден жіберіңіз...
Dialogue: 0,0:05:53.48,0:05:54.82,Default,,0,0,0,,Бұл кім? Тодд?
Dialogue: 0,0:05:54.98,0:05:57.52,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:05:57.62,0:05:59.65,Default,,0,0,0,,Калий цианидін қолданыңыз
Dialogue: 0,0:06:03.79,0:06:04.73,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:06:04.79,0:06:07.53,Default,,0,0,0,,Сіз жүргізушіден сұхбат алуға келдіңіз бе?
Dialogue: 0,0:06:07.63,0:06:09.56,Default,,0,0,0,,Міне
Dialogue: 0,0:06:09.76,0:06:12.03,Default,,0,0,0,,Мен ешқандай жұмыс ұсынысын жарияламаған болсам да.
Dialogue: 0,0:06:12.40,0:06:14.57,Default,,0,0,0,,Тағдырды сезінбе
Dialogue: 0,0:06:19.74,0:06:22.08,Default,,0,0,0,,Келгеніңізге рахмет.
Dialogue: 0,0:06:22.41,0:06:26.55,Default,,0,0,0,,Түйіндемеңіз болмаса, менікі.
Dialogue: 0,0:06:26.68,0:06:27.92,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:28.02,0:06:29.75,Default,,0,0,0,,Міне, сіздің түйіндемеңіз.
Dialogue: 0,0:06:29.82,0:06:31.65,Default,,0,0,0,,Маған көрсетейін
Dialogue: 0,0:06:32.59,0:06:35.82,Default,,0,0,0,,Бұл жүргізушілер үшін өте қолайлы
Dialogue: 0,0:06:36.59,0:06:38.46,Default,,0,0,0,,Бұл менің түйіндемем.
Dialogue: 0,0:06:38.56,0:06:41.90,Default,,0,0,0,,Сіз де Солтүстік-Батыс университетіндесіз бе?
Dialogue: 0,0:06:42.00,0:06:43.77,Default,,0,0,0,,Батыспен күрес
Dialogue: 0,0:06:43.87,0:06:48.17,Default,,0,0,0,,Сіз еліктеуге шеберсіз, көрсетіңіз.
Dialogue: 0,0:06:48.47,0:06:49.84,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:06:49.94,0:06:51.91,Default,,0,0,0,,«Мен Роджермін».
Dialogue: 0,0:06:52.91,0:06:54.58,Default,,0,0,0,,Жаңа ғана атыңызды айттыңыз ба?
Dialogue: 0,0:06:54.81,0:06:56.98,Default,,0,0,0,,Тодд, бұл сізге байланысты.
Dialogue: 0,0:06:58.45,0:07:01.18,Default,,0,0,0,,Ауа райы өтірік сияқты.
Dialogue: 0,0:07:01.52,0:07:04.45,Default,,0,0,0,,О, мен сене алар емеспін.
Dialogue: 0,0:07:05.82,0:07:07.86,Default,,0,0,0,,Мен жақсы серіктес таптым
Dialogue: 0,0:07:07.96,0:07:11.46,Default,,0,0,0,,Сіз Минни жүргізушісіз бе?
Dialogue: 0,0:07:15.63,0:07:20.74,Default,,0,0,0,,Тодд көңілсіз және скучно, кел жыныстық қатынасқа.
Dialogue: 0,0:07:20.84,0:07:24.14,Default,,0,0,0,,Қазір мен Винсентпен біргемін
Dialogue: 0,0:07:24.44,0:07:26.01,Default,,0,0,0,,Сіз ауырып қалдыңыз ба?
Dialogue: 0,0:07:26.14,0:07:30.75,Default,,0,0,0,,Винсент бардағы бала болды.
Dialogue: 0,0:07:30.88,0:07:32.81,Default,,0,0,0,,Сіз қызғанасыз ба?
Dialogue: 0,0:07:32.91,0:07:34.68,Default,,0,0,0,,Бұл шындық болуы мүмкін емес
Dialogue: 0,0:07:34.78,0:07:39.02,Default,,0,0,0,,Алдыңыздағы адамға мұқият қараңыз.
Dialogue: 0,0:07:39.12,0:07:40.09,Default,,0,0,0,,Үш адам
Dialogue: 0,0:07:40.19,0:07:42.49,Default,,0,0,0,,Бала пальтода
Dialogue: 0,0:07:42.59,0:07:44.59,Default,,0,0,0,,Ол жақсы тыңдаушы
Dialogue: 0,0:07:44.69,0:07:46.16,Default,,0,0,0,,Жарайды, бірақ...
Dialogue: 0,0:07:46.49,0:07:47.70,Default,,0,0,0,,Тағы да қызғаныш?
Dialogue: 0,0:07:47.80,0:07:49.53,Default,,0,0,0,,Осымен.
Dialogue: 0,0:07:50.23,0:07:51.17,Default,,0,0,0,,Ол тірі болды ма?
Dialogue: 0,0:07:51.47,0:07:52.70,Default,,0,0,0,,Одан да көп
Dialogue: 0,0:07:52.87,0:07:55.90,Default,,0,0,0,,Мен оның жүргізушісі болдым.
Dialogue: 0,0:07:56.10,0:07:58.17,Default,,0,0,0,,Жүргізуші? Бұл тамаша
Dialogue: 0,0:07:58.24,0:08:01.11,Default,,0,0,0,,Ішкі мәліметтерді біле аласыз
Dialogue: 0,0:08:01.21,0:08:02.98,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:08:03.08,0:08:05.05,Default,,0,0,0,,Сенімге ие болу
Dialogue: 0,0:08:05.15,0:08:08.18,Default,,0,0,0,,Егер сіз тасымалдауды қамтамасыз ете бастасаңыз
Dialogue: 0,0:08:08.48,0:08:10.79,Default,,0,0,0,,Оған мұқият қараңыз.
Dialogue: 0,0:08:10.89,0:08:13.52,Default,,0,0,0,,Әлсіз жақтарын табыңыз
Dialogue: 0,0:08:13.62,0:08:15.06,Default,,0,0,0,,Мүмкіндікті жіберіп алмаңыз—
Dialogue: 0,0:08:15.22,0:08:17.96,Default,,0,0,0,,Бірден шабуыл жасаңыз.
Dialogue: 0,0:08:18.06,0:08:21.20,Default,,0,0,0,,Ол үшін солай.
Dialogue: 0,0:08:22.20,0:08:24.80,Default,,0,0,0,,Түсіндім, сен тыңшысың.
Dialogue: 0,0:08:28.97,0:08:30.94,Default,,0,0,0,,Мықты бол, мен.
Dialogue: 0,0:08:31.04,0:08:33.14,Default,,0,0,0,,Өзіңізбен сөйлесуді тоқтатыңыз—
Dialogue: 0,0:08:33.27,0:08:35.21,Default,,0,0,0,,Менімен сөйлесейік
Dialogue: 0,0:08:35.64,0:08:38.71,Default,,0,0,0,,Ауа райы өтірік сияқты.
Dialogue: 0,0:08:38.81,0:08:42.82,Default,,0,0,0,,Бұл керемет ауа-райы.
Dialogue: 0,0:08:43.52,0:08:45.15,Default,,0,0,0,,Сейсенбі
Dialogue: 0,0:08:47.12,0:08:48.92,Default,,0,0,0,,Кездесу 30 минут бұрын.
Dialogue: 0,0:08:49.26,0:08:52.23,Default,,0,0,0,,Иә, мен шынымен де көлікте отырдым.
Dialogue: 0,0:08:53.23,0:08:57.67,Default,,0,0,0,,Жазбаларымды қарап шыққаннан кейін менде жеткілікті ақпарат бар деп ойлаймын.
Dialogue: 0,0:08:58.00,0:09:01.64,Default,,0,0,0,,Мен жазуды бастауды ойлап жүрмін.
Dialogue: 0,0:09:01.74,0:09:05.57,Default,,0,0,0,,Қазір сұхбат берген дұрыс па? Өткеннен не есте қалды?
Dialogue: 0,0:09:05.67,0:09:09.21,Default,,0,0,0,,Мен үш емшегі бар әйел туралы әңгімені естідім.
Dialogue: 0,0:09:09.31,0:09:10.68,Default,,0,0,0,,Әйелдің шынайы тұлғасы қандай?
Dialogue: 0,0:09:10.78,0:09:11.31,Default,,0,0,0,,Тыңдалған
Dialogue: 0,0:09:11.58,0:09:14.25,Default,,0,0,0,,Жарайды, кездескенше.
Dialogue: 0,0:09:14.55,0:09:15.98,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:09:17.15,0:09:19.85,Default,,0,0,0,,Себебі ол біртүрлі атмосфера жасайды.
Dialogue: 0,0:09:23.59,0:09:25.09,Default,,0,0,0,,Бұл менің кінәм бе?
Dialogue: 0,0:09:26.23,0:09:27.60,Default,,0,0,0,,Мысалы—
Dialogue: 0,0:09:27.70,0:09:29.26,Default,,0,0,0,,Бұл нан жылытқышы.
Dialogue: 0,0:09:29.70,0:09:33.60,Default,,0,0,0,,Штрих-кодты оқып, тізімге қосыңыз
Dialogue: 0,0:09:33.70,0:09:36.24,Default,,0,0,0,,Ақпарат достарға да беріледі.
Dialogue: 0,0:09:37.10,0:09:38.17,Default,,0,0,0,,Бұл ақылды қадам.
Dialogue: 0,0:09:38.27,0:09:41.34,Default,,0,0,0,,Маған бірдеңе беріп мазалаудың қажеті жоқ.
Dialogue: 0,0:09:41.88,0:09:44.08,Default,,0,0,0,,Үйлену туралы екіталайсыз ба?
Dialogue: 0,0:09:44.21,0:09:46.35,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:09:46.61,0:09:49.62,Default,,0,0,0,,Бұл сәнді рәсімдер мен сыйлықтарға қатысты.
Dialogue: 0,0:09:49.68,0:09:53.82,Default,,0,0,0,,Ойланып жүргенде түсіне алмадым.
Dialogue: 0,0:09:53.92,0:09:55.66,Default,,0,0,0,,Жылытқыштың қажеттілігі
Dialogue: 0,0:09:55.79,0:09:57.89,Default,,0,0,0,,Қайта оралдын.
Dialogue: 0,0:09:58.13,0:10:01.33,Default,,0,0,0,,Көзіңізді жұмып, елестетуге тырысыңыз
Dialogue: 0,0:10:01.70,0:10:03.97,Default,,0,0,0,,Алыстағы жексенбінің салқын таңы
Dialogue: 0,0:10:04.03,0:10:08.17,Default,,0,0,0,,Біз робот қоғамына айналуымыз мүмкін.
Dialogue: 0,0:10:08.27,0:10:10.77,Default,,0,0,0,,Бәрібір жексенбінің таңы.
Dialogue: 0,0:10:10.94,0:10:14.78,Default,,0,0,0,,Ас үйге тәпішке киіп кіргенде...
Dialogue: 0,0:10:14.94,0:10:16.64,Default,,0,0,0,,Қараңдаршы, нанның иісі
Dialogue: 0,0:10:16.91,0:10:17.71,Default,,0,0,0,,Иә
Dialogue: 0,0:10:17.78,0:10:19.81,Default,,0,0,0,,Жылы, иісі жақсы.
Dialogue: 0,0:10:19.91,0:10:20.35,Default,,0,0,0,,Иә.
Dialogue: 0,0:10:20.62,0:10:22.65,Default,,0,0,0,,Жылытқышқа рахмет
Dialogue: 0,0:10:22.75,0:10:26.05,Default,,0,0,0,,Егер сізге ұнамаса, үйленуді тоқтату керек пе?
Dialogue: 0,0:10:26.22,0:10:30.19,Default,,0,0,0,,Мәселе некеде емес, рәсімде.
Dialogue: 0,0:10:30.29,0:10:34.30,Default,,0,0,0,,Мынаны істейік: Шамадан тыс той жасауды доғар
Dialogue: 0,0:10:34.36,0:10:37.77,Default,,0,0,0,,Үйлену тойы келесі айда тек отбасы мүшелері шақырылады.
Dialogue: 0,0:10:38.17,0:10:40.10,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:10:40.17,0:10:44.81,Default,,0,0,0,,Бірақ мен көгершіндерді реттеп, шақыру қағаздарын да дайындадым.
Dialogue: 0,0:10:44.94,0:10:46.84,Default,,0,0,0,,Бұл маңызды емес
Dialogue: 0,0:10:47.04,0:10:51.08,Default,,0,0,0,,Шақыру жіберсеңіз, сіздің жеке ақпаратыңыз ортақ болады.
Dialogue: 0,0:10:51.18,0:10:52.35,Default,,0,0,0,,Пошта бөлімшесінде
Dialogue: 0,0:10:52.88,0:10:53.81,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:10:54.12,0:10:57.22,Default,,0,0,0,,Өзіңіздің сүйікті ықшам дискіңіз туралы әңгімелеңіз.
Dialogue: 0,0:10:57.75,0:10:59.25,Default,,0,0,0,,Қалғаны сол.
Dialogue: 0,0:10:59.32,0:11:02.86,Default,,0,0,0,,Біз таяқ туралы айттық.
Dialogue: 0,0:11:03.09,0:11:05.03,Default,,0,0,0,,Жержаңғақ майы –
Dialogue: 0,0:11:05.09,0:11:09.13,Default,,0,0,0,,Мен таяқшаларға ерекше көңіл бөлемін.
Dialogue: 0,0:11:09.26,0:11:10.77,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:11:10.90,0:11:13.97,Default,,0,0,0,,Толығырақ айтып беріңізші.
Dialogue: 0,0:11:14.07,0:11:16.70,Default,,0,0,0,,Операциялар үшін пайдалануға болатын ақпаратты көрсетіңіз
Dialogue: 0,0:11:16.84,0:11:19.37,Default,,0,0,0,,Дұрыс, той өтпейді.
Dialogue: 0,0:11:19.44,0:11:21.31,Default,,0,0,0,,Не? Мен жасадым
Dialogue: 0,0:11:21.41,0:11:23.44,Default,,0,0,0,,Өйткені Құдай бар.
Dialogue: 0,0:11:23.71,0:11:27.15,Default,,0,0,0,,Үйлену тойы аралда емес, келесі айда осы қалада болады.
Dialogue: 0,0:11:27.21,0:11:27.85,Default,,0,0,0,,Не?
Dialogue: 0,0:11:27.92,0:11:30.72,Default,,0,0,0,,Түсінемін, ол «жоқ» емес.
Dialogue: 0,0:11:34.26,0:11:35.32,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:35.46,0:11:40.23,Default,,0,0,0,,Бұл қазылар алқасының шақыруы. Сот жұма күні.
Dialogue: 0,0:11:40.39,0:11:41.73,Default,,0,0,0,,Осыдан-
Dialogue: 0,0:11:41.90,0:11:46.27,Default,,0,0,0,,Осы ақылсыз басынан пайдалы ақпаратты сығып алыңыз.
Dialogue: 0,0:11:46.40,0:11:50.84,Default,,0,0,0,,Жаңғақ майы ішін сипаса қуанады.
Dialogue: 0,0:11:50.94,0:11:56.14,Default,,0,0,0,,Дайан вьетнамдық және вьетнамдық тағамдарды жейді.
Dialogue: 0,0:11:56.24,0:11:58.41,Default,,0,0,0,,Осы екі нәрсені ескере отырып...
Dialogue: 0,0:11:58.71,0:12:01.28,Default,,0,0,0,,Одан гөрі осы аптаға қандай жоспарларыңыз бар?
Dialogue: 0,0:12:01.38,0:12:05.02,Default,,0,0,0,,Цирк келе жатыр. Сондай-ақ, жаңа заң жобасы да дауысқа салынады.
Dialogue: 0,0:12:05.12,0:12:07.76,Default,,0,0,0,,Оның кестесі емес.
Dialogue: 0,0:12:07.86,0:12:11.89,Default,,0,0,0,,Бейсенбі күні екі адамды банкке апардым.
Dialogue: 0,0:12:11.99,0:12:14.76,Default,,0,0,0,,Қолдануға болады, қолданайық.
Dialogue: 0,0:12:14.90,0:12:16.96,Default,,0,0,0,,сәрсенбі
Dialogue: 0,0:12:17.23,0:12:20.37,Default,,0,0,0,,Банк тонаушы рөлі? Қызықсыз көрінеді
Dialogue: 0,0:12:20.43,0:12:23.40,Default,,0,0,0,,Марго орындаушы емес пе?
Dialogue: 0,0:12:23.47,0:12:29.11,Default,,0,0,0,,Мылтығыңды пайдасыз деп ренжітіп, оны жібер.
Dialogue: 0,0:12:29.21,0:12:32.78,Default,,0,0,0,,Сахналар да, фильмдер де, теледидарлар да тұншығады.
Dialogue: 0,0:12:32.88,0:12:34.52,Default,,0,0,0,,Түрмедегідей қазіргі жағдайдан
Dialogue: 0,0:12:34.82,0:12:38.09,Default,,0,0,0,,Сценарийсіз немесе режиссурасыз еркін әрекет ету
Dialogue: 0,0:12:38.29,0:12:41.89,Default,,0,0,0,,Сол түні біз осындай түс туралы әңгімелестік.
Dialogue: 0,0:12:41.99,0:12:44.19,Default,,0,0,0,,Тер басқан естеліктер
Dialogue: 0,0:12:45.06,0:12:46.33,Default,,0,0,0,,X-Кира, Дәптері бар және оны шынымен қолданатын
Dialogue: 0,0:12:46.39,0:12:47.76,Default,,0,0,0,,бейсенбі
Dialogue: 0,0:12:48.13,0:12:50.36,Default,,0,0,0,,Жоғалған баланың ата-анасы қайда?
Dialogue: 0,0:12:50.46,0:12:51.27,Default,,0,0,0,,Бұл кездейсоқтық.
Dialogue: 0,0:12:51.43,0:12:52.93,Default,,0,0,0,,Боджак
Dialogue: 0,0:12:53.03,0:12:54.20,Default,,0,0,0,,О, сәлем
Dialogue: 0,0:12:54.27,0:12:57.14,Default,,0,0,0,,Қандай кездейсоқтық. Келдің бе?
Dialogue: 0,0:12:57.91,0:12:59.31,Default,,0,0,0,,Қалдарыңыз қалай?
Dialogue: 0,0:12:59.37,0:13:01.81,Default,,0,0,0,,Менде бәрі жақсы. Сен ше?
Dialogue: 0,0:13:01.88,0:13:03.38,Default,,0,0,0,,әлемнің бәрі қастандық жасап жатқандай
Dialogue: 0,0:13:03.44,0:13:05.88,Default,,0,0,0,,Қозғалсаң, атып саламын.
Dialogue: 0,0:13:05.95,0:13:08.02,Default,,0,0,0,,Сіз қалай твит жазбайсыз?
Dialogue: 0,0:13:08.12,0:13:10.55,Default,,0,0,0,,Сізде әдемі сақина бар, солай емес пе?
Dialogue: 0,0:13:11.02,0:13:11.49,Default,,0,0,0,,Мұнда
Dialogue: 0,0:13:11.82,0:13:14.02,Default,,0,0,0,,Кешіріңіз, бұл сіздің сақинаңыз.
Dialogue: 0,0:13:14.22,0:13:15.22,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:13:15.36,0:13:16.82,Default,,0,0,0,,Бұл неке сақинасы.
Dialogue: 0,0:13:16.92,0:13:18.93,Default,,0,0,0,,Маған тым болмаса сақина берші.
Dialogue: 0,0:13:18.99,0:13:20.06,Default,,0,0,0,,«Туралы»?
Dialogue: 0,0:13:20.13,0:13:23.96,Default,,0,0,0,,Махаббатты білдіретін сақинаны босату қаншалықты оңай?
Dialogue: 0,0:13:24.10,0:13:27.80,Default,,0,0,0,,Бұл әйел туралы жеңіл ойламаңыз.
Dialogue: 0,0:13:27.90,0:13:30.97,Default,,0,0,0,,Тонаушының ұпайы бар.
Dialogue: 0,0:13:31.11,0:13:35.11,Default,,0,0,0,,Бұл адам дұрыс айтады. Сақина тек дәлел.
Dialogue: 0,0:13:35.28,0:13:37.91,Default,,0,0,0,,Сіз маңыздырақсыз
Dialogue: 0,0:13:38.05,0:13:40.28,Default,,0,0,0,,Біз бір-бірімізге керекпіз
Dialogue: 0,0:13:40.35,0:13:42.98,Default,,0,0,0,,Мен тіпті бір ай күтпеймін.
Dialogue: 0,0:13:43.12,0:13:47.12,Default,,0,0,0,,Бір қарақшы маған өмірдің қысқа екенін үйретті
Dialogue: 0,0:13:47.19,0:13:48.92,Default,,0,0,0,,Енді үйленейік
Dialogue: 0,0:13:49.02,0:13:49.92,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:50.02,0:13:51.13,Default,,0,0,0,,Бірден?
Dialogue: 0,0:13:51.23,0:13:52.26,Default,,0,0,0,,Осы демалыс күндері ше?
Dialogue: 0,0:13:52.36,0:13:55.30,Default,,0,0,0,,Келесі сенбіде мұны істеу ақылға қонымсыз ба?
Dialogue: 0,0:13:55.50,0:13:57.13,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:57.23,0:13:59.10,Default,,0,0,0,,Содан кейін сақинаны қайтарыңыз.
Dialogue: 0,0:14:01.24,0:14:03.04,Default,,0,0,0,,Үйлену тойы сенбіде.
Dialogue: 0,0:14:03.17,0:14:04.34,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:04.44,0:14:06.31,Default,,0,0,0,,Бұл нағыз махаббат
Dialogue: 0,0:14:08.14,0:14:10.24,Default,,0,0,0,,Тек тоқтаңыз.
Dialogue: 0,0:14:13.51,0:14:16.85,Default,,0,0,0,,Ал Эрика аяғынан айырылды.
Dialogue: 0,0:14:16.98,0:14:18.62,Default,,0,0,0,,Өзіне дос тапты
Dialogue: 0,0:14:19.12,0:14:20.62,Default,,0,0,0,,Ой, мен жолдан шығып кеттім.
Dialogue: 0,0:14:20.99,0:14:24.56,Default,,0,0,0,,Той алдындағы кешімізге қош келдіңіздер.
Dialogue: 0,0:14:24.93,0:14:28.03,Default,,0,0,0,,Шұғыл болғандықтан уақытым болмады.
Dialogue: 0,0:14:28.13,0:14:28.93,Default,,0,0,0,,Сабыр етіңіз.
Dialogue: 0,0:14:29.00,0:14:31.17,Default,,0,0,0,,Барлық ішімдік ішуге болады
Dialogue: 0,0:14:32.20,0:14:36.04,Default,,0,0,0,,Тосттар жасағаннан кейін ішіңіз.
Dialogue: 0,0:14:36.17,0:14:40.57,Default,,0,0,0,,Бірақ тост айтудан бұрын тағы бір шағын әңгіме.
Dialogue: 0,0:14:40.94,0:14:44.04,Default,,0,0,0,,Прагада қыста адамдар сатып алудан бас тартатын көңіл-күйде...
Dialogue: 0,0:14:44.14,0:14:46.45,Default,,0,0,0,,Банкті тонау сәтсіз болды
Dialogue: 0,0:14:46.55,0:14:50.65,Default,,0,0,0,,Винсент айтқандай: «Мен мұны істедім»
Dialogue: 0,0:14:50.95,0:14:51.39,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:14:51.49,0:14:53.92,Default,,0,0,0,,Біз бірнеше рет бірге ойнадық.
Dialogue: 0,0:14:54.29,0:14:56.09,Default,,0,0,0,,Ол көңілді жігіт.
Dialogue: 0,0:14:56.16,0:14:57.22,Default,,0,0,0,,Ол бала.
Dialogue: 0,0:14:57.39,0:15:01.20,Default,,0,0,0,,Мені өзіңнің және Кэролайнның проблемаларына тартпа.
Dialogue: 0,0:15:01.26,0:15:05.27,Default,,0,0,0,,Мәселе - Кэролайнның серіктесінің жеке басы.
Dialogue: 0,0:15:05.33,0:15:08.94,Default,,0,0,0,,Бұл үш баланың бетперделері емес пе?
Dialogue: 0,0:15:09.04,0:15:11.07,Default,,0,0,0,,Тағы бір қызықты оқиға
Dialogue: 0,0:15:11.24,0:15:12.94,Default,,0,0,0,,Менен бір сөз
Dialogue: 0,0:15:13.04,0:15:14.44,Default,,0,0,0,,Боджак
Dialogue: 0,0:15:14.51,0:15:16.48,Default,,0,0,0,,Кәне, микрофон.
Dialogue: 0,0:15:16.68,0:15:21.08,Default,,0,0,0,,Жержаңғақ майы Дайан мереке ретінде—
Dialogue: 0,0:15:21.58,0:15:24.95,Default,,0,0,0,,Менің дүкенімді той өтетін орын ретінде пайдаланыңыз.
Dialogue: 0,0:15:25.62,0:15:26.35,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:15:26.45,0:15:28.66,Default,,0,0,0,,Тым жомарт емес пе?
Dialogue: 0,0:15:29.02,0:15:31.36,Default,,0,0,0,,Жақсы әңгімемен бірге жүріңіз
Dialogue: 0,0:15:33.19,0:15:35.10,Default,,0,0,0,,Бұл әннің көшірмесі ме?
Dialogue: 0,0:15:35.20,0:15:35.70,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:15:36.20,0:15:38.47,Default,,0,0,0,,Олай болса, тост айтайық.
Dialogue: 0,0:15:38.67,0:15:41.64,Default,,0,0,0,,Толығырақ көңіл көтеріңіз
Dialogue: 0,0:15:44.04,0:15:45.04,Default,,0,0,0,,Міне!
Dialogue: 0,0:15:45.11,0:15:48.41,Default,,0,0,0,,Менің дүкенімде стратегияны жоспарлау оңай.
Dialogue: 0,0:15:48.54,0:15:50.11,Default,,0,0,0,,Мен оны құртамын.
Dialogue: 0,0:15:50.18,0:15:52.31,Default,,0,0,0,,Ей, рахмет айтайын.
Dialogue: 0,0:15:52.58,0:15:56.72,Default,,0,0,0,,Маған қоңырау шалғаныңызға рахмет.
Dialogue: 0,0:15:57.05,0:15:57.95,Default,,0,0,0,,Мен ғашық болдым
Dialogue: 0,0:15:58.19,0:16:01.66,Default,,0,0,0,,Сіз оны пальтосыз көрдіңіз бе?
Dialogue: 0,0:16:01.96,0:16:05.19,Default,,0,0,0,,Қуан, ол жақсы адам.
Dialogue: 0,0:16:05.29,0:16:09.13,Default,,0,0,0,,Әңгімелесейік, жақсы араласатынымызға сенімдімін.
Dialogue: 0,0:16:09.23,0:16:11.00,Default,,0,0,0,,Бірден
Dialogue: 0,0:16:11.10,0:16:14.03,Default,,0,0,0,,1-3, солай ма? Өйткені үш адам бар
Dialogue: 0,0:16:14.13,0:16:15.74,Default,,0,0,0,,Сізге бұл ұнамайды.
Dialogue: 0,0:16:16.04,0:16:17.37,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:16:19.64,0:16:21.14,Default,,0,0,0,,Дене хабар таратушы Такаданың мәйіті ретінде анықталған сәтте,
Dialogue: 0,0:16:21.24,0:16:23.28,Default,,0,0,0,,Әлі шығарылған жоқ
Dialogue: 0,0:16:23.38,0:16:28.55,Default,,0,0,0,,Менің мұнда жүргізуші болып келгенім мені әрқашан қызықтыратын.
Dialogue: 0,0:16:28.68,0:16:30.62,Default,,0,0,0,,Бұл не туралы?
Dialogue: 0,0:16:30.68,0:16:33.29,Default,,0,0,0,,Жүргізуші емес...
Dialogue: 0,0:16:34.02,0:16:35.56,Default,,0,0,0,,Ол менің досым.
Dialogue: 0,0:16:36.49,0:16:38.49,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:16:38.63,0:16:42.70,Default,,0,0,0,,Мен достарыммен ғана сырласатын нәрселер бар.
Dialogue: 0,0:16:43.06,0:16:46.30,Default,,0,0,0,,Неке бұзылуы мүмкін
Dialogue: 0,0:16:46.40,0:16:48.70,Default,,0,0,0,,Мен адамдарға сенімді емеспін.
Dialogue: 0,0:16:49.00,0:16:50.74,Default,,0,0,0,,Қайта үйленуге бола ма?
Dialogue: 0,0:16:51.04,0:16:53.74,Default,,0,0,0,,Мен Дайанды шын жүрегіммен жақсы көремін.
Dialogue: 0,0:16:54.01,0:16:57.44,Default,,0,0,0,,Бірақ ол үйлену туралы алаңдайды.
Dialogue: 0,0:16:57.54,0:17:01.12,Default,,0,0,0,,Мен ақылды болғандықтан, мен алаңдататын нәрсені байқадым.
Dialogue: 0,0:17:01.22,0:17:04.45,Default,,0,0,0,,Менің соншалықты маңызды нәрсе істегенімді қалайсың ба?
Dialogue: 0,0:17:04.55,0:17:06.42,Default,,0,0,0,,Менің жүрегімнен ауыр жүк алынды
Dialogue: 0,0:17:06.52,0:17:08.79,Default,,0,0,0,,Бірақ таяқшаны шешу мүмкін емес
Dialogue: 0,0:17:09.16,0:17:11.76,Default,,0,0,0,,Маған қысқа да, ұзын да ұнайды.
Dialogue: 0,0:17:12.36,0:17:14.73,Default,,0,0,0,,Дайан кішкентай, бірақ
Dialogue: 0,0:17:15.03,0:17:19.20,Default,,0,0,0,,Соңғы кездері мен қызымның жоғалып кеткенін көп армандайтынмын.
Dialogue: 0,0:17:19.33,0:17:23.40,Default,,0,0,0,,Үнсіз жоғалып, Мені жалғыз қалдырып өмір сүруге.
Dialogue: 0,0:17:23.54,0:17:26.54,Default,,0,0,0,,Менің сұмдығыма, түсімде мен...
Dialogue: 0,0:17:27.17,0:17:28.11,Default,,0,0,0,,Мен өзімді жеңіл сезінемін.
Dialogue: 0,0:17:29.14,0:17:31.18,Default,,0,0,0,,тыңдағандарыңызға рахмет
Dialogue: 0,0:17:31.41,0:17:32.61,Default,,0,0,0,,Жақсы дос
Dialogue: 0,0:17:34.38,0:17:37.72,Default,,0,0,0,,Сіз оны пайдалана алмағандықтан, тойды менің дүкенімде өткіземіз.
Dialogue: 0,0:17:37.79,0:17:40.22,Default,,0,0,0,,Бірақ бұл жақсы.
Dialogue: 0,0:17:40.49,0:17:42.76,Default,,0,0,0,,Мен тойды бұзамын.
Dialogue: 0,0:17:43.12,0:17:44.36,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:17:44.46,0:17:46.83,Default,,0,0,0,,Мен жақсы жоспар құрдым.
Dialogue: 0,0:17:47.09,0:17:50.83,Default,,0,0,0,,Нұсқауларды өзіңіз түсіне алатындай етіп беріңіз
Dialogue: 0,0:17:51.13,0:17:52.67,Default,,0,0,0,,Біз доспыз
Dialogue: 0,0:17:53.13,0:17:53.77,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:17:53.83,0:17:54.64,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:17:56.74,0:17:58.64,Default,,0,0,0,,Марго Мартиндейл —
Dialogue: 0,0:17:58.71,0:18:02.38,Default,,0,0,0,,Банкті тонау әрекеті үшін қамауға алынды.
Dialogue: 0,0:18:02.51,0:18:03.78,Default,,0,0,0,,Марго?
Dialogue: 0,0:18:03.84,0:18:07.78,Default,,0,0,0,,Бұған дейін пицца туралы таң қалдыратын мәліметтер бар.
Dialogue: 0,0:18:08.38,0:18:09.78,Default,,0,0,0,,Бұл мен көрген жүз.
Dialogue: 0,0:18:10.15,0:18:11.29,Default,,0,0,0,,Біз қай жерде кездестік?
Dialogue: 0,0:18:11.59,0:18:15.22,Default,,0,0,0,,Мен ойынды дүкеннен сатып алғанда.
Dialogue: 0,0:18:15.29,0:18:17.86,Default,,0,0,0,,Ол рок операны бұзған әйел.
Dialogue: 0,0:18:18.16,0:18:22.76,Default,,0,0,0,,Жеңілдік бұрышында мен оған таспа бердім...
Dialogue: 0,0:18:23.80,0:18:27.50,Default,,0,0,0,,Марго таспаларды жақсы көреді.
Dialogue: 0,0:18:27.57,0:18:29.50,Default,,0,0,0,,Музыкалық кассеталар және—
Dialogue: 0,0:18:29.57,0:18:33.51,Default,,0,0,0,,Сондай-ақ қорапқа жабыстыратын лента да бар.
Dialogue: 0,0:18:33.64,0:18:35.54,Default,,0,0,0,,Жәшік, жарма туралы айту
Dialogue: 0,0:18:37.34,0:18:40.41,Default,,0,0,0,,Қарым-қатынасты дұрыс түсінбесеңіз
Dialogue: 0,0:18:40.51,0:18:43.58,Default,,0,0,0,,Ал, ішу туралы айтсақ...
Dialogue: 0,0:18:43.65,0:18:47.25,Default,,0,0,0,,Сусындар, сода, су және т.б.
Dialogue: 0,0:18:47.32,0:18:49.19,Default,,0,0,0,,Су өсімдіктерге қажет
Dialogue: 0,0:18:49.26,0:18:53.66,Default,,0,0,0,,БоДжекке Марго керек болды.
Dialogue: 0,0:18:53.73,0:18:58.30,Default,,0,0,0,,Банкте және дүкенде BoJack...
Dialogue: 0,0:18:58.40,0:19:00.57,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:19:01.14,0:19:05.57,Default,,0,0,0,,БоДжектің нұсқауымен Марго қозғалды.
Dialogue: 0,0:19:05.64,0:19:09.31,Default,,0,0,0,,Мақсаты – рок операны жою.
Dialogue: 0,0:19:10.28,0:19:11.51,Default,,0,0,0,,О, тәңірім
Dialogue: 0,0:19:11.58,0:19:14.31,Default,,0,0,0,,жұма
Dialogue: 0,0:19:14.41,0:19:15.78,Default,,0,0,0,,Таң болды, Тодд.
Dialogue: 0,0:19:16.18,0:19:17.38,Default,,0,0,0,,Ұйықтамау
Dialogue: 0,0:19:17.52,0:19:21.19,Default,,0,0,0,,Антты үзгеніме бір-ақ күн қалды.
Dialogue: 0,0:19:21.26,0:19:23.39,Default,,0,0,0,,Мен жақында қозғала бастаймын.
Dialogue: 0,0:19:23.46,0:19:25.53,Default,,0,0,0,,Жарайды, бұл сынақ күні.
Dialogue: 0,0:19:25.66,0:19:27.33,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:19:27.46,0:19:30.60,Default,,0,0,0,,Орталық сот жұма, 13 маусым
Dialogue: 0,0:19:30.90,0:19:34.33,Default,,0,0,0,,Сонымен айыпталушыны көрдіңіз бе?
Dialogue: 0,0:19:34.50,0:19:34.94,Default,,0,0,0,,Иә
Dialogue: 0,0:19:35.40,0:19:38.81,Default,,0,0,0,,Сіз бұл жігіт екеніне сенімдісіз бе?
Dialogue: 0,0:19:38.91,0:19:39.81,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:19:40.21,0:19:40.81,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:19:41.18,0:19:44.48,Default,,0,0,0,,Басқаша айтқанда, айыпталушы көрінді
Dialogue: 0,0:19:44.65,0:19:47.35,Default,,0,0,0,,Өтінемін, мен дайынмын.
Dialogue: 0,0:19:47.48,0:19:48.22,Default,,0,0,0,,Иә
Dialogue: 0,0:19:48.32,0:19:50.25,Default,,0,0,0,,Бар болғаны, бас төреші.
Dialogue: 0,0:19:50.48,0:19:52.72,Default,,0,0,0,,Ой, ол әлі де болды.
Dialogue: 0,0:19:52.85,0:19:54.52,Default,,0,0,0,,Сұрақтар қоюды жалғастыра аламын ба?
Dialogue: 0,0:19:57.72,0:19:58.96,Default,,0,0,0,,Сенбі
Dialogue: 0,0:20:01.46,0:20:05.37,Default,,0,0,0,,Алқабилер сотталушыны кінәсіз деп тапты.
Dialogue: 0,0:20:06.27,0:20:09.27,Default,,0,0,0,,Нағыз жеңімпаз...
Dialogue: 0,0:20:09.50,0:20:10.64,Default,,0,0,0,,Жержаңғақ майы.
Dialogue: 0,0:20:14.27,0:20:14.98,Default,,0,0,0,,Боджак
Dialogue: 0,0:20:15.61,0:20:17.74,Default,,0,0,0,,Қалың қалай, үлкен жұлдыз?
Dialogue: 0,0:20:17.98,0:20:20.91,Default,,0,0,0,,Бұл ең жақсысы. Мен өмірімді осы рөлге арнаймын.
Dialogue: 0,0:20:21.32,0:20:24.52,Default,,0,0,0,,Санта-Барбара түрмесінде
Dialogue: 0,0:20:24.72,0:20:28.42,Default,,0,0,0,,Біріншіден, зұлым әйелдердің басын тапсаңыз
Dialogue: 0,0:20:28.49,0:20:30.39,Default,,0,0,0,,Саусақты тістеп алу
Dialogue: 0,0:20:31.66,0:20:34.93,Default,,0,0,0,,Мені бір рет ұрсаң, қауіпті адам болып көрінесің.
Dialogue: 0,0:20:35.26,0:20:36.46,Default,,0,0,0,,бас тартты
Dialogue: 0,0:20:36.53,0:20:38.93,Default,,0,0,0,,Мен өз жоспарым туралы айттым.
Dialogue: 0,0:20:39.30,0:20:40.90,Default,,0,0,0,,Сонымен, үйлену тойы ше?
Dialogue: 0,0:20:41.00,0:20:43.94,Default,,0,0,0,,Қазір қызу жүріп жатыр.
Dialogue: 0,0:20:44.27,0:20:47.27,Default,,0,0,0,,Оны неге сонша тоқтатқыңыз келді?
Dialogue: 0,0:20:47.37,0:20:51.65,Default,,0,0,0,,Мен онымен өзінше жақсы дос болғым келді.
Dialogue: 0,0:20:51.75,0:20:53.48,Default,,0,0,0,,Дайан - ең жақсы
Dialogue: 0,0:20:53.58,0:20:55.82,Default,,0,0,0,,Ол ақылды, мейірімді және әдемі...
Dialogue: 0,0:20:55.98,0:20:59.42,Default,,0,0,0,,Жай ғана тамаша әйел.
Dialogue: 0,0:20:59.85,0:21:01.52,Default,,0,0,0,,Мен саған ғашық болдым
Dialogue: 0,0:21:01.76,0:21:03.52,Default,,0,0,0,,Айтыңыз
Dialogue: 0,0:21:03.69,0:21:06.56,Default,,0,0,0,,Біртүрлі схемалар жоқ
Dialogue: 0,0:21:06.76,0:21:09.56,Default,,0,0,0,,Сезіміңізді білдірсеңіз болғаны
Dialogue: 0,0:21:10.30,0:21:14.30,Default,,0,0,0,,Сосын ренжіген кезде біреудің саусағын тістеп ал.
Dialogue: 0,0:21:14.57,0:21:17.60,Default,,0,0,0,,Мүмкін солай шығар, мен мойындаймын.
Dialogue: 0,0:21:18.01,0:21:19.71,Default,,0,0,0,,Жарайды, мен жасап көремін.
Dialogue: 0,0:21:20.01,0:21:21.44,Default,,0,0,0,,Онда да қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:21:25.31,0:21:27.65,Default,,0,0,0,,Тодд Рәсім аяқталды ма?
Dialogue: 0,0:21:27.71,0:21:29.52,Default,,0,0,0,,Мен түсемін
Dialogue: 0,0:21:29.58,0:21:31.32,Default,,0,0,0,,Өйткені ол жақсы адам
Dialogue: 0,0:21:31.49,0:21:33.99,Default,,0,0,0,,Барлығына мейірімді бол
Dialogue: 0,0:21:34.05,0:21:36.32,Default,,0,0,0,,Жоқ, мен ақымақ болдым.
Dialogue: 0,0:21:36.39,0:21:40.83,Default,,0,0,0,,Мен Дайанды жақсы көретіндіктен, бұл күлкілі.
Dialogue: 0,0:21:40.99,0:21:44.30,Default,,0,0,0,,Иә, сол сезімді жеткізіңіз.
Dialogue: 0,0:21:44.36,0:21:45.93,Default,,0,0,0,,Мен айта аламын
Dialogue: 0,0:21:46.03,0:21:47.97,Default,,0,0,0,,Мен жаңа ғана байқадым
Dialogue: 0,0:21:48.04,0:21:50.54,Default,,0,0,0,,Оның ойы құрастырылған
Dialogue: 0,0:21:50.60,0:21:54.07,Default,,0,0,0,,Сіздің кезегіңіз еш жерде жоқ.
Dialogue: 0,0:21:54.34,0:21:59.88,Default,,0,0,0,,Сондықтан біз басқа адамдардың өміріне араласуды тоқтатуымыз керек.
Dialogue: 0,0:22:00.98,0:22:03.02,Default,,0,0,0,,Мен неге үйленемін?
Dialogue: 0,0:22:03.35,0:22:04.72,Default,,0,0,0,,Бұл шынымен біртүрлі болып көрінеді.
Dialogue: 0,0:22:04.89,0:22:07.95,Default,,0,0,0,,Мен неге өмірімді біреуге арнаймын?
Dialogue: 0,0:22:08.36,0:22:10.56,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін.
Dialogue: 0,0:22:10.72,0:22:14.43,Default,,0,0,0,,Сіз бәрін түсінбесеңіз де
Dialogue: 0,0:22:14.53,0:22:19.37,Default,,0,0,0,,Жаңғақ майы Мен саған сенемін
Dialogue: 0,0:22:19.50,0:22:23.87,Default,,0,0,0,,Екеуіңіздің ерлі-зайыптылар болғаныңызды мәлімдейміз.
Dialogue: 0,0:22:24.37,0:22:26.77,Default,,0,0,0,,Жүр, мені тез сүй.
Dialogue: 0,0:22:39.79,0:22:42.39,Default,,0,0,0,,Тодд, мен оны бағалаймын.
Dialogue: 0,0:22:42.49,0:22:45.79,Default,,0,0,0,,Бүгін ең жақсы күн, Мен бақыттымын
Dialogue: 0,0:22:45.89,0:22:47.06,Default,,0,0,0,,Мен сені тағы тыңдаймын.
Dialogue: 0,0:22:47.39,0:22:49.80,Default,,0,0,0,,Иә, бұл сізге арналған.
Dialogue: 0,0:22:50.46,0:22:52.93,Default,,0,0,0,,«Тодд Чавес» Менің визит карточкам?
Dialogue: 0,0:22:53.13,0:22:54.94,Default,,0,0,0,,«PB Living» дегеніміз не?
Dialogue: 0,0:22:55.00,0:22:57.74,Default,,0,0,0,,Бұл менің фильм өндіруші компаниям. Сіздің атағыңыз қандай?
Dialogue: 0,0:22:58.41,0:23:02.08,Default,,0,0,0,,«Батыс жағалау бөлімінің менеджері»?
Dialogue: 0,0:23:02.38,0:23:05.41,Default,,0,0,0,,Жағалаудағы толқындарды басқаратын бизнес?
Dialogue: 0,0:23:05.48,0:23:08.55,Default,,0,0,0,,Бұл менің көмекшім. Мен оны асыға күтемін.
Dialogue: 0,0:23:08.72,0:23:12.95,Default,,0,0,0,,Артымды көрмеу үшін көлігімнің артқы айнасын алып тастадым.
Dialogue: 0,0:23:13.12,0:23:14.79,Default,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,0:23:14.86,0:23:17.12,Default,,0,0,0,,Мен көлік жүргізбеймін.
Dialogue: 0,0:23:18.02,0:23:19.09,Default,,0,0,0,,Боджак
Dialogue: 0,0:23:19.56,0:23:21.70,Default,,0,0,0,,Сіз шығасыз ба деп ойладым.
Dialogue: 0,0:23:22.10,0:23:23.56,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:23:23.73,0:23:26.63,Default,,0,0,0,,Менің жақсы достарым бар екеніне қуаныштымын
Dialogue: 0,0:23:27.87,0:23:30.70,Default,,0,0,0,,Біртүрлі сезінгенім үшін кешіріңіз
Dialogue: 0,0:23:30.87,0:23:31.94,Default,,0,0,0,,Жетеді
Dialogue: 0,0:23:33.04,0:23:33.74,Default,,0,0,0,,Дайан
Dialogue: 0,0:23:33.91,0:23:36.41,Default,,0,0,0,,Енді мен күйеуіммен билеймін
Dialogue: 0,0:23:36.48,0:23:37.81,Default,,0,0,0,,Тіпті «күйеу»
Dialogue: 0,0:23:41.58,0:23:42.48,Default,,0,0,0,,Сәлем
Dialogue: 0,0:23:42.62,0:23:45.09,Default,,0,0,0,,«Ересек адам»?
Dialogue: 0,0:23:45.15,0:23:48.46,Default,,0,0,0,,Саған бәрі жынды, бірақ неге екенін білмеймін
Dialogue: 0,0:23:48.69,0:23:51.06,Default,,0,0,0,,Мм, бұл ересектердің әңгімесі ме?
Dialogue: 0,0:23:51.46,0:23:55.06,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ бұл жақсы.
Dialogue: 0,0:23:55.73,0:24:00.47,Default,,0,0,0,,Кэролайн мен оны шақырған сайын артымнан еретін.
Dialogue: 0,0:24:01.07,0:24:04.07,Default,,0,0,0,,Бұл жағдай өзгергендіктен—
Dialogue: 0,0:24:04.44,0:24:06.14,Default,,0,0,0,,Мен қызғандым
Dialogue: 0,0:24:06.81,0:24:08.54,Default,,0,0,0,,Мен ең нашармын
Dialogue: 0,0:24:08.78,0:24:10.14,Default,,0,0,0,,Тіпті ол үшін
Dialogue: 0,0:24:11.58,0:24:12.61,Default,,0,0,0,,Барлығына арналған
Dialogue: 0,0:24:14.55,0:24:17.75,Default,,0,0,0,,Сіздің жақсы тыңдаушы екеніңізге сенімдімін.
Dialogue: 0,0:24:17.85,0:24:18.49,Default,,0,0,0,,Сәлем
Dialogue: 0,0:24:18.75,0:24:20.89,Default,,0,0,0,,Ар-ұждан сияқты нәрсе -
Dialogue: 0,0:24:21.15,0:24:25.63,Default,,0,0,0,,Бірте-бірте жоғалттым, енді ештеңе қалмады.
Dialogue: 0,0:24:25.76,0:24:28.50,Default,,0,0,0,,Мен оны енді қайтара алмаймын.
Dialogue: 0,0:24:29.90,0:24:32.17,Default,,0,0,0,,Есіктер бірінен соң бірі жабылады
Dialogue: 0,0:24:34.70,0:24:35.87,Default,,0,0,0,,Көңілдеріңіз көтеріңкі!
Dialogue: 0,0:24:37.80,0:24:39.01,Default,,0,0,0,,Бұл жақсы ат.
Dialogue: 0,0:24:42.08,0:24:43.68,Default,,0,0,0,,Мен өзімді жақсы сезінемін
Dialogue: 0,0:24:45.18,0:24:51.18,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
