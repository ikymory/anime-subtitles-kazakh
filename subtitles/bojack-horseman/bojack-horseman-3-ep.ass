Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.74,Default,,0,0,0,,NETFLIX түпнұсқа жұмысы
Dialogue: 0,0:00:09.14,0:00:12.31,Default,,0,0,0,,...
Dialogue: 0,0:00:12.51,0:00:13.44,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:00:13.54,0:00:16.44,Default,,0,0,0,,Этан, сен тамақтанып қойдың ғой, солай ма?
Dialogue: 0,0:00:16.54,0:00:19.68,Default,,0,0,0,,Үлкен жігіттермен бірдей «есімде жоқ».
Dialogue: 0,0:00:21.05,0:00:23.05,Default,,0,0,0,,Сабрина қайда?
Dialogue: 0,0:00:23.18,0:00:26.39,Default,,0,0,0,,...
Dialogue: 0,0:00:27.32,0:00:29.56,Default,,0,0,0,,...
Dialogue: 0,0:00:30.76,0:00:32.73,Default,,0,0,0,,...
Dialogue: 0,0:00:33.06,0:00:37.53,Default,,0,0,0,,Мектеп - қорқынышты жер, олар жасырын шабуыл жасайды.
Dialogue: 0,0:00:37.67,0:00:39.40,Default,,0,0,0,,...
Dialogue: 0,0:00:40.10,0:00:42.57,Default,,0,0,0,,Қалай қарасаң да тым көп
Dialogue: 0,0:00:44.74,0:00:47.61,Default,,0,0,0,,...
Dialogue: 0,0:00:47.74,0:00:50.18,Default,,0,0,0,,...
Dialogue: 0,0:00:50.25,0:00:52.35,Default,,0,0,0,,...
Dialogue: 0,0:00:52.45,0:00:53.82,Default,,0,0,0,,…
Dialogue: 0,0:00:54.08,0:00:56.05,Default,,0,0,0,,...
Dialogue: 0,0:00:57.22,0:00:59.19,Default,,0,0,0,,...
Dialogue: 0,0:01:00.56,0:01:02.19,Default,,0,0,0,,Көңілді отырсың ба?
Dialogue: 0,0:01:03.46,0:01:06.49,Default,,0,0,0,,･
Dialogue: 0,0:01:06.76,0:01:09.43,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:01:09.56,0:01:12.10,Default,,0,0,0,,...
Dialogue: 0,0:01:12.23,0:01:13.30,Default,,0,0,0,,Қайта алу
Dialogue: 0,0:01:13.60,0:01:15.24,Default,,0,0,0,,Оларға қараңыз
Dialogue: 0,0:01:15.34,0:01:20.34,Default,,0,0,0,,Ол ақымақ жанкүйер болуы мүмкін, бірақ ол сізді қолдайтын маңызды адам.
Dialogue: 0,0:01:20.41,0:01:22.51,Default,,0,0,0,,“”
Dialogue: 0,0:01:22.64,0:01:26.38,Default,,0,0,0,,...
Dialogue: 0,0:01:26.51,0:01:29.38,Default,,0,0,0,,...
Dialogue: 0,0:01:29.52,0:01:31.45,Default,,0,0,0,,...
Dialogue: 0,0:01:31.55,0:01:34.76,Default,,0,0,0,,...
Dialogue: 0,0:01:34.82,0:01:38.79,Default,,0,0,0,,Жанкүйерлеріңізге тіпті сізді өлтіру қиын болса да жауап беріңіз
Dialogue: 0,0:01:39.09,0:01:41.40,Default,,0,0,0,,—
Dialogue: 0,0:01:41.50,0:01:44.47,Default,,0,0,0,,...
Dialogue: 0,0:01:44.53,0:01:47.27,Default,,0,0,0,,...
Dialogue: 0,0:01:47.34,0:01:48.60,Default,,0,0,0,,Әрекет
Dialogue: 0,0:01:48.67,0:01:51.67,Default,,0,0,0,,...
Dialogue: 0,0:01:52.34,0:01:53.74,Default,,0,0,0,,12 жылдан кейін
Dialogue: 0,0:01:54.18,0:01:58.11,Default,,0,0,0,,Бұл бұрынғы атақты бала актриса Сара Линн туралы тақырып.
Dialogue: 0,0:01:58.18,0:01:59.81,Default,,0,0,0,,—
Dialogue: 0,0:02:00.12,0:02:03.15,Default,,0,0,0,,...
Dialogue: 0,0:02:03.75,0:02:07.26,Default,,0,0,0,,...
Dialogue: 0,0:02:07.36,0:02:08.66,Default,,0,0,0,,...
Dialogue: 0,0:02:09.76,0:02:12.16,Default,,0,0,0,,...
Dialogue: 0,0:02:12.43,0:02:13.83,Default,,0,0,0,,...
Dialogue: 0,0:02:15.43,0:02:18.57,Default,,0,0,0,,Мен енді күте алмаймын
Dialogue: 0,0:02:19.20,0:02:21.57,Default,,0,0,0,,Осы әнмен не айтқыңыз келеді?
Dialogue: 0,0:02:21.70,0:02:24.71,Default,,0,0,0,,Мен енді бала емеспін
Dialogue: 0,0:02:24.84,0:02:28.71,Default,,0,0,0,,Ол ересек адам және жыныстық қатынасқа түседі.
Dialogue: 0,0:02:28.84,0:02:30.85,Default,,0,0,0,,Сексуалды позаларды жақсы біледі
Dialogue: 0,0:02:31.15,0:02:35.92,Default,,0,0,0,,Мені бәрі сексуалды болғаным үшін жақсы көреді
Dialogue: 0,0:02:36.32,0:02:40.32,Default,,0,0,0,,Егер сіз сексуалды маршруттан шаршасаңыз ше?
Dialogue: 0,0:02:40.42,0:02:42.92,Default,,0,0,0,,Мен Сара Линнмін
Dialogue: 0,0:02:43.19,0:02:45.83,Default,,0,0,0,,Мәңгілік жыныстық белгі
Dialogue: 0,0:02:45.93,0:02:47.60,Default,,0,0,0,,Тағы 12 жылдан кейін
Dialogue: 0,0:02:47.70,0:02:49.73,Default,,0,0,0,,Сара Линн...
Dialogue: 0,0:02:49.86,0:02:52.20,Default,,0,0,0,,Осы айда 30-ға толамын.
Dialogue: 0,0:02:52.33,0:02:55.64,Default,,0,0,0,,Оның қызу тақырыпқа айналуына күмәнім бар...
Dialogue: 0,0:02:55.74,0:02:57.44,Default,,0,0,0,,Өйткені менің жасым 30-да.
Dialogue: 0,0:02:57.54,0:03:00.17,Default,,0,0,0,,Дабстептің көтерілген жұлдыздары
Dialogue: 0,0:03:00.24,0:03:02.88,Default,,0,0,0,,Секстинаны сұраңыз
Dialogue: 0,0:03:03.34,0:03:04.75,Default,,0,0,0,,Сәлем
Dialogue: 0,0:03:04.88,0:03:06.45,Default,,0,0,0,,Сара туралы не ойлайсың?
Dialogue: 0,0:03:06.55,0:03:10.85,Default,,0,0,0,,Мен оны жақсы көремін, ол мені бала кезімде шабыттандырды.
Dialogue: 0,0:03:10.92,0:03:14.49,Default,,0,0,0,,Бірақ қазір ол шіркін кемпір.
Dialogue: 0,0:03:14.56,0:03:17.23,Default,,0,0,0,,Қазір менің уақытым
Dialogue: 0,0:03:17.46,0:03:18.49,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:03:18.59,0:03:20.90,Default,,0,0,0,,Сараның болашағы туралы не деуге болады?
Dialogue: 0,0:03:21.23,0:03:22.76,Default,,0,0,0,,Оның болашағы?
Dialogue: 0,0:03:22.90,0:03:24.60,Default,,0,0,0,,Егер мен өлсем —
Dialogue: 0,0:03:24.67,0:03:28.37,Default,,0,0,0,,Көпшіліктің реакциясы «Иә?» деп аяқталады.
Dialogue: 0,0:03:30.91,0:03:32.37,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:04:22.96,0:04:26.73,Default,,0,0,0,,БоДжек шабандозы
Dialogue: 0,0:04:26.79,0:04:28.43,Default,,0,0,0,,5 сағат бұрын
Dialogue: 0,0:04:28.53,0:04:31.50,Default,,0,0,0,,Шоколадты құймақ ше?
Dialogue: 0,0:04:31.67,0:04:33.64,Default,,0,0,0,,жеп ал
Dialogue: 0,0:04:33.70,0:04:35.04,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:35.37,0:04:38.37,Default,,0,0,0,,Маған құймақ жасап берші.
Dialogue: 0,0:04:40.44,0:04:41.44,Default,,0,0,0,,Олар бақытты өмір сүруге құқылы
Dialogue: 0,0:04:41.58,0:04:43.44,Default,,0,0,0,,Бұл көңілді таң
Dialogue: 0,0:04:43.54,0:04:45.68,Default,,0,0,0,,Жарқын жарық пен құстардың әні
Dialogue: 0,0:04:45.75,0:04:47.55,Default,,0,0,0,,Демалыс күндеріне қандай жоспарларыңыз бар?
Dialogue: 0,0:04:47.62,0:04:48.58,Default,,0,0,0,,Сіз сарбаздарды жек көресіз бе?
Dialogue: 0,0:04:48.68,0:04:49.98,Default,,0,0,0,,Маған құсқа жем беріңіз.
Dialogue: 0,0:04:50.32,0:04:52.95,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:04:53.92,0:04:55.69,Default,,0,0,0,,Бірдеңе істейік
Dialogue: 0,0:04:55.82,0:04:56.46,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:04:56.59,0:04:58.66,Default,,0,0,0,,Ішке секіруге ше?
Dialogue: 0,0:05:01.50,0:05:03.87,Default,,0,0,0,,Мен төсек сатып алуым керек пе?
Dialogue: 0,0:05:04.53,0:05:06.73,Default,,0,0,0,,«Интерьер дүкені»
Dialogue: 0,0:05:06.80,0:05:10.47,Default,,0,0,0,,Мұндағы өнімдердің барлығы қайта өңделген өнімдер.
Dialogue: 0,0:05:10.57,0:05:12.97,Default,,0,0,0,,10 000 долларға қаңғыбас болып өмір сүру?
Dialogue: 0,0:05:13.07,0:05:16.34,Default,,0,0,0,,Ескі найзадан жасалған хат пышақ
Dialogue: 0,0:05:16.41,0:05:18.61,Default,,0,0,0,,Қан қою
Dialogue: 0,0:05:18.68,0:05:19.31,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:05:19.55,0:05:20.58,Default,,0,0,0,,Өтірік
Dialogue: 0,0:05:20.68,0:05:22.62,Default,,0,0,0,,Бұл өте қауіпті.
Dialogue: 0,0:05:22.75,0:05:24.99,Default,,0,0,0,,Бұл өте танымал.
Dialogue: 0,0:05:25.59,0:05:27.32,Default,,0,0,0,,Бұл шындық, солай ма?
Dialogue: 0,0:05:27.79,0:05:28.72,Default,,0,0,0,,Шынайылық
Dialogue: 0,0:05:28.82,0:05:31.36,Default,,0,0,0,,Қарапайым адамдардың өмірін бақылау
Dialogue: 0,0:05:31.46,0:05:33.90,Default,,0,0,0,,Сара және А.Гарфилд.
Dialogue: 0,0:05:34.00,0:05:35.63,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:05:38.60,0:05:39.60,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:05:39.83,0:05:41.47,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:42.54,0:05:45.07,Default,,0,0,0,,Бұл «Эвелинге» ұқсайды ма?
Dialogue: 0,0:05:45.94,0:05:48.48,Default,,0,0,0,,Сара Линн біраз уақытқа
Dialogue: 0,0:05:48.54,0:05:50.04,Default,,0,0,0,,БоДжек?
Dialogue: 0,0:05:50.34,0:05:53.58,Default,,0,0,0,,Қараңдаршы, әкенің рөлін сомдаған жігіт екен.
Dialogue: 0,0:05:53.72,0:05:55.72,Default,,0,0,0,,Бұл А.Гарфилд.
Dialogue: 0,0:05:55.85,0:05:57.52,Default,,0,0,0,,Егер сіз айтсаңыз -
Dialogue: 0,0:05:57.62,0:06:00.72,Default,,0,0,0,,Біз атақты жұппыз
Dialogue: 0,0:06:00.79,0:06:02.52,Default,,0,0,0,,Керемет, солай ма?
Dialogue: 0,0:06:02.62,0:06:04.93,Default,,0,0,0,,Осы мәселеге қатысты.
Dialogue: 0,0:06:05.06,0:06:08.06,Default,,0,0,0,,Сіз өткеннің үлкен жұлдызысыз.
Dialogue: 0,0:06:08.40,0:06:10.80,Default,,0,0,0,,Қазір сатылмайды, солай ма?
Dialogue: 0,0:06:12.00,0:06:13.63,Default,,0,0,0,,Атақты адам емес
Dialogue: 0,0:06:13.80,0:06:15.94,Default,,0,0,0,,Сонымен, ажырасуды қалайсыз ба?
Dialogue: 0,0:06:17.64,0:06:18.87,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:06:19.71,0:06:22.91,Default,,0,0,0,,Бұл қантпен қапталған таблетка, сондықтан мен қанттың мөлшері туралы алаңдаймын.
Dialogue: 0,0:06:23.01,0:06:24.68,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:06:25.11,0:06:27.42,Default,,0,0,0,,Адамдарды қинау қызық па?
Dialogue: 0,0:06:27.78,0:06:30.49,Default,,0,0,0,,Егер біз ажырасатын болсақ, мен мұны осылай жасаймын.
Dialogue: 0,0:06:33.39,0:06:34.56,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:06:35.96,0:06:39.16,Default,,0,0,0,,Мен сені қоғамдық орында шуламайсың деп ойладым.
Dialogue: 0,0:06:39.73,0:06:42.96,Default,,0,0,0,,Адамдардың не ойлайтыны маған бәрібір, бейбақ.
Dialogue: 0,0:06:43.03,0:06:44.80,Default,,0,0,0,,Сіз мені түсінбейсіз
Dialogue: 0,0:06:45.53,0:06:46.67,Default,,0,0,0,,Иә Назар аударыңыз
Dialogue: 0,0:06:46.73,0:06:50.54,Default,,0,0,0,,Мен сол диванға тітіркендім, оны кім көргісі келеді?
Dialogue: 0,0:06:52.57,0:06:55.41,Default,,0,0,0,,Мен оны шынымен диванға шығардым.
Dialogue: 0,0:06:55.61,0:06:56.51,Default,,0,0,0,,Енді Сара ше?
Dialogue: 0,0:06:56.64,0:06:59.71,Default,,0,0,0,,Оңалту үшін мекемеге кіру
Dialogue: 0,0:06:59.88,0:07:02.85,Default,,0,0,0,,Мен қыздың рөлін ойнағандықтан уайымдап отырмын.
Dialogue: 0,0:07:02.95,0:07:03.58,Default,,0,0,0,,О
Dialogue: 0,0:07:03.72,0:07:07.72,Default,,0,0,0,,Біз нысанға барар жолда қосылдық.
Dialogue: 0,0:07:08.09,0:07:09.86,Default,,0,0,0,,Көрінетін ішкі мүшелер
Dialogue: 0,0:07:09.92,0:07:13.46,Default,,0,0,0,,Қансырап жатырсың, амансың ба?
Dialogue: 0,0:07:13.59,0:07:15.13,Default,,0,0,0,,Көлік жүргізуге қолайлы күн.
Dialogue: 0,0:07:15.63,0:07:18.67,Default,,0,0,0,,Қарым-қатынас болашақта да жалғасатын сияқты.
Dialogue: 0,0:07:18.73,0:07:23.94,Default,,0,0,0,,Ол жақсы болған кезде маған керегі жоқ
Dialogue: 0,0:07:24.01,0:07:26.61,Default,,0,0,0,,Біз ешқашан кездеспейміз
Dialogue: 0,0:07:28.48,0:07:29.88,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:07:32.68,0:07:36.72,Default,,0,0,0,,Мен ризамын, бірақ емделудің қажеті жоқ.
Dialogue: 0,0:07:36.88,0:07:38.62,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:07:38.75,0:07:39.89,Default,,0,0,0,,Жақсы
Dialogue: 0,0:07:41.22,0:07:43.12,Default,,0,0,0,,Осының бәрін ішесіз бе?
Dialogue: 0,0:07:43.22,0:07:46.03,Default,,0,0,0,,Дәрігер маған берді.
Dialogue: 0,0:07:46.16,0:07:47.96,Default,,0,0,0,,Жақсы дәрігер?
Dialogue: 0,0:07:48.03,0:07:49.96,Default,,0,0,0,,Кез келген жағдайда дәрігер.
Dialogue: 0,0:07:50.10,0:07:54.17,Default,,0,0,0,,Ол «Доктор Кім» деді
Dialogue: 0,0:07:54.47,0:07:55.87,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:07:57.14,0:07:58.17,Default,,0,0,0,,Сергіту
Dialogue: 0,0:07:58.47,0:08:00.91,Default,,0,0,0,,Мұрын арқылы жұтуға болатын дәрі ме?
Dialogue: 0,0:08:01.04,0:08:05.91,Default,,0,0,0,,Мені тірілткен кезде дәл осылай естіген фельдшерлер есімде.
Dialogue: 0,0:08:06.05,0:08:09.05,Default,,0,0,0,,Айтпақшы, оңалту туралы...
Dialogue: 0,0:08:09.18,0:08:13.52,Default,,0,0,0,,Мен өзіммен ешқашан бетпе-бет келген емеспін
Dialogue: 0,0:08:13.79,0:08:17.63,Default,,0,0,0,,Мен ешқашан ешкімнен бас тартқан емеспін.
Dialogue: 0,0:08:17.73,0:08:22.76,Default,,0,0,0,,Сондықтан бұл жолы да саған қарамай қашып кеткім келеді.
Dialogue: 0,0:08:22.90,0:08:25.80,Default,,0,0,0,,Мен сіздің шынайы сезімдеріңізді түсінемін.
Dialogue: 0,0:08:25.90,0:08:29.04,Default,,0,0,0,,Мен сенімді ересек адамның маған айтқанын қалаймын.
Dialogue: 0,0:08:29.67,0:08:31.87,Default,,0,0,0,,«Жарайды, маған қалдырыңыз».
Dialogue: 0,0:08:31.94,0:08:35.68,Default,,0,0,0,,Олай болса бұрынғыдай қайта жасайық.
Dialogue: 0,0:08:35.74,0:08:38.28,Default,,0,0,0,,3 бала 1 2 3…
Dialogue: 0,0:08:39.18,0:08:42.55,Default,,0,0,0,,Шоколадты құймақ ше?
Dialogue: 0,0:08:42.72,0:08:43.75,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:08:43.95,0:08:45.95,Default,,0,0,0,,Не істеп жүрсің?
Dialogue: 0,0:08:46.05,0:08:48.76,Default,,0,0,0,,Қайырлы таң, құймақ ше?
Dialogue: 0,0:08:48.89,0:08:50.66,Default,,0,0,0,,Мен оны жегім келеді.
Dialogue: 0,0:08:50.76,0:08:53.56,Default,,0,0,0,,Сара ерте тұратын.
Dialogue: 0,0:08:53.66,0:08:55.03,Default,,0,0,0,,Ерте тұру үш сөйлемнің қасиеті.
Dialogue: 0,0:08:55.13,0:08:57.53,Default,,0,0,0,,Ерте тұру үш тиын тұрады.
Dialogue: 0,0:08:57.70,0:09:00.90,Default,,0,0,0,,Түсіндім, қызық бірдеңе айтып тұрсың.
Dialogue: 0,0:09:00.97,0:09:04.84,Default,,0,0,0,,Оны блогыңызға жүктеп салғыңыз келе ме?
Dialogue: 0,0:09:06.11,0:09:07.68,Default,,0,0,0,,Мен ризамын
Dialogue: 0,0:09:08.08,0:09:09.68,Default,,0,0,0,,Бөлмені өз қалауыңызша пайдаланыңыз
Dialogue: 0,0:09:10.01,0:09:11.25,Default,,0,0,0,,Бөлме?
Dialogue: 0,0:09:11.55,0:09:13.98,Default,,0,0,0,,Мен диванда отырсам да?
Dialogue: 0,0:09:14.12,0:09:15.92,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:09:16.02,0:09:18.12,Default,,0,0,0,,Құймақ дәмді
Dialogue: 0,0:09:18.69,0:09:21.92,Default,,0,0,0,,Мен онымен бірге болсам, бәрі лазанья
Dialogue: 0,0:09:22.02,0:09:24.79,Default,,0,0,0,,Бұл Эндрюдің сүйікті тағамы ма?
Dialogue: 0,0:09:24.89,0:09:25.86,Default,,0,0,0,,Менің сөйлескім келмейді
Dialogue: 0,0:09:25.93,0:09:28.60,Default,,0,0,0,,Эй, мені сауда орталығына апар.
Dialogue: 0,0:09:28.70,0:09:31.83,Default,,0,0,0,,Мен дүкенге барғым келеді.
Dialogue: 0,0:09:31.93,0:09:34.80,Default,,0,0,0,,Босаңсыған адамдарға көлік жүргізуге рұқсат бермеңіз.
Dialogue: 0,0:09:34.97,0:09:37.84,Default,,0,0,0,,«Мен толқудамын», солай ма?
Dialogue: 0,0:09:37.91,0:09:39.71,Default,,0,0,0,,Сұрақтар қойылмаған
Dialogue: 0,0:09:39.87,0:09:43.84,Default,,0,0,0,,Сіз кімсіз? Ол кездегі полиция қызметкері сияқты.
Dialogue: 0,0:09:43.95,0:09:47.01,Default,,0,0,0,,Сауда орталығына барудан аулақ болу керек.
Dialogue: 0,0:09:47.15,0:09:51.69,Default,,0,0,0,,Сауда орталығында сіз қиын уақытты өткіздіңіз, солай ма?
Dialogue: 0,0:09:53.15,0:09:56.02,Default,,0,0,0,,Қалай қарасаң да тым көп
Dialogue: 0,0:09:57.89,0:09:59.03,Default,,0,0,0,,Соншама?
Dialogue: 0,0:09:59.16,0:10:03.00,Default,,0,0,0,,Ішке пышақ сұққаннан жақсы.
Dialogue: 0,0:10:03.13,0:10:04.30,Default,,0,0,0,,Сіз кім туралы айтып отырсыз?
Dialogue: 0,0:10:04.60,0:10:09.14,Default,,0,0,0,,Эндрю дүйсенбіде мұны істей алады.
Dialogue: 0,0:10:09.24,0:10:13.71,Default,,0,0,0,,Эндрю дүйсенбі күндерін жек көреді және лазаньяны жақсы көреді ме?
Dialogue: 0,0:10:13.81,0:10:14.78,Default,,0,0,0,,Маған оның әңгімесі ұнамайды.
Dialogue: 0,0:10:14.91,0:10:16.14,Default,,0,0,0,,Басқа тақырып
Dialogue: 0,0:10:16.28,0:10:18.15,Default,,0,0,0,,Мен сауда орталығына баруды қойдым.
Dialogue: 0,0:10:18.25,0:10:19.78,Default,,0,0,0,,Досыңызға қоңырау шалыңыз
Dialogue: 0,0:10:19.91,0:10:25.19,Default,,0,0,0,,Мен үйде кітап жазамын, сондықтан адамдар шуылдаса мені мазалайды.
Dialogue: 0,0:10:25.29,0:10:28.66,Default,,0,0,0,,Жарайды, мен мазасызданамын.
Dialogue: 0,0:10:28.72,0:10:31.06,Default,,0,0,0,,Жоқ, мен мазасыз емеспін.
Dialogue: 0,0:10:31.16,0:10:34.80,Default,,0,0,0,,Бұл енді сүйкімді емес...
Dialogue: 0,0:10:34.90,0:10:37.33,Default,,0,0,0,,Сіздің досыңыз қош келдіңіз.
Dialogue: 0,0:10:37.67,0:10:38.77,Default,,0,0,0,,Кешіріңізші!
Dialogue: 0,0:10:39.33,0:10:40.20,Default,,0,0,0,,Мен де саған қоңырау шаламын...
Dialogue: 0,0:10:40.30,0:10:41.17,Default,,0,0,0,,No
Dialogue: 0,0:10:41.34,0:10:43.07,Default,,0,0,0,,«Вигер»
Dialogue: 0,0:10:43.14,0:10:45.07,Default,,0,0,0,,Сол әйелді үйге әкелесің бе?
Dialogue: 0,0:10:45.31,0:10:47.94,Default,,0,0,0,,Мазасыз, мені қуып жіберіңіз
Dialogue: 0,0:10:48.08,0:10:49.91,Default,,0,0,0,,Менің баратын жерім жоқ.
Dialogue: 0,0:10:49.98,0:10:53.65,Default,,0,0,0,,Жүрегім ауырып, өзімді пышақтап,...
Dialogue: 0,0:10:53.78,0:10:54.95,Default,,0,0,0,,Агент де кетіп қалды...
Dialogue: 0,0:10:55.18,0:10:56.08,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:10:56.18,0:10:58.22,Default,,0,0,0,,Агент жоқ па?
Dialogue: 0,0:10:58.35,0:11:00.29,Default,,0,0,0,,Мен жақында кетемін.
Dialogue: 0,0:11:00.35,0:11:02.96,Default,,0,0,0,,Сіз үлкен балықты ұстауыңыз мүмкін
Dialogue: 0,0:11:05.39,0:11:08.10,Default,,0,0,0,,Мм... Сәлеметсіз бе, тыңдап тұрсыз ба?
Dialogue: 0,0:11:14.97,0:11:16.70,Default,,0,0,0,,Эй, жоқ.
Dialogue: 0,0:11:16.84,0:11:17.84,Default,,0,0,0,,Эй...
Dialogue: 0,0:11:17.91,0:11:19.24,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:19.34,0:11:21.24,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:11:21.34,0:11:22.71,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:36.32,0:11:38.26,Default,,0,0,0,,Керемет кеш.
Dialogue: 0,0:11:40.23,0:11:43.23,Default,,0,0,0,,Телефоныңызда не іздеп жатырсыз?
Dialogue: 0,0:11:43.33,0:11:45.20,Default,,0,0,0,,Мен агент іздемеймін.
Dialogue: 0,0:11:45.30,0:11:48.40,Default,,0,0,0,,Маған ұнамайды, олай тұрма.
Dialogue: 0,0:11:48.70,0:11:50.37,Default,,0,0,0,,Демалу
Dialogue: 0,0:11:50.70,0:11:53.87,Default,,0,0,0,,Әйелдермен сөйлесейік
Dialogue: 0,0:11:53.94,0:11:56.24,Default,,0,0,0,,Мен білікті агентпін.
Dialogue: 0,0:11:56.31,0:11:59.38,Default,,0,0,0,,Бұл Ванессадан өзгеше.
Dialogue: 0,0:11:59.85,0:12:03.12,Default,,0,0,0,,Бұл менің бұрынғы жігітімнің агенті. Ол өте шебер.
Dialogue: 0,0:12:03.42,0:12:05.95,Default,,0,0,0,,Ванессаның керемет дағдылары бар ма?
Dialogue: 0,0:12:08.82,0:12:11.73,Default,,0,0,0,,Сіз үй сияқты нәрселерді тыңдайсыз.
Dialogue: 0,0:12:11.89,0:12:16.90,Default,,0,0,0,,Дыбыс деңгейін көтеруді сұрайтын жалған доктор.
Dialogue: 0,0:12:16.96,0:12:19.50,Default,,0,0,0,,«Пилилиге» қарсы тиімді деп айтылады.
Dialogue: 0,0:12:21.00,0:12:22.74,Default,,0,0,0,,Сара туралы не ойлайсың?
Dialogue: 0,0:12:23.04,0:12:25.24,Default,,0,0,0,,Иә, таң қалдым...
Dialogue: 0,0:12:25.31,0:12:30.38,Default,,0,0,0,,Ертеде секске құмар жастарды мазақ ету қызық еді.
Dialogue: 0,0:12:30.98,0:12:34.32,Default,,0,0,0,,Бірақ үшінші феминизм тұрғысынан...
Dialogue: 0,0:12:34.45,0:12:37.92,Default,,0,0,0,,Ер адамдар үстемдік ететін қоғамдағы әйелдерді көрсету қиын.
Dialogue: 0,0:12:38.02,0:12:42.86,Default,,0,0,0,,Ер адамның көзқарасын түсіну оңай, солай емес пе?
Dialogue: 0,0:12:43.36,0:12:44.43,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:44.76,0:12:49.43,Default,,0,0,0,,Бірақ бұл тақырыптың бәрі оған қуыршақ сияқты қарайды.
Dialogue: 0,0:12:49.53,0:12:50.76,Default,,0,0,0,,Әрине
Dialogue: 0,0:12:50.87,0:12:52.77,Default,,0,0,0,,Талқылау маңызды.
Dialogue: 0,0:12:52.90,0:12:53.47,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:53.83,0:12:56.00,Default,,0,0,0,,Ол әлі бала...
Dialogue: 0,0:12:56.47,0:12:57.47,Default,,0,0,0,,Бұл терең.
Dialogue: 0,0:12:58.77,0:13:01.21,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:13:01.34,0:13:03.44,Default,,0,0,0,,Менің сұрайын дегенім –
Dialogue: 0,0:13:03.78,0:13:06.78,Default,,0,0,0,,Бұл оның үйде болуы туралы.
Dialogue: 0,0:13:07.38,0:13:08.95,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:13:09.02,0:13:12.92,Default,,0,0,0,,Бірге жұмыс істегенде жақсы дос болдыңыз ба?
Dialogue: 0,0:13:13.05,0:13:14.89,Default,,0,0,0,,Жұлдыз ретінде.
Dialogue: 0,0:13:16.22,0:13:18.23,Default,,0,0,0,,Сіз қай университетті бітірдіңіз?
Dialogue: 0,0:13:18.29,0:13:19.79,Default,,0,0,0,,Сара, №.
Dialogue: 0,0:13:19.89,0:13:20.83,Default,,0,0,0,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,0:13:21.00,0:13:24.06,Default,,0,0,0,,Билеуде нашар болсаң, баратын жер колледж.
Dialogue: 0,0:13:24.20,0:13:25.90,Default,,0,0,0,,Менің арманым сәулетші болу
Dialogue: 0,0:13:25.97,0:13:27.37,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:27.50,0:13:32.21,Default,,0,0,0,,Менің анам ойын-сауық индустриясына түсу үшін өз денесін желіге қойғанымен?
Dialogue: 0,0:13:33.31,0:13:35.04,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:13:35.11,0:13:36.24,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:13:36.38,0:13:38.81,Default,,0,0,0,,Осы демалыста не істеп жатырсыз?
Dialogue: 0,0:13:38.95,0:13:41.52,Default,,0,0,0,,Сіз ойын-сауық саябағында циркті көргіңіз келе ме?
Dialogue: 0,0:13:42.12,0:13:43.98,Default,,0,0,0,,Жағажайда ұшатын батпырауықтар
Dialogue: 0,0:13:44.12,0:13:48.96,Default,,0,0,0,,Осыдан кейін балмұздақ жеп отырып Дисней фильмін көрдім.
Dialogue: 0,0:13:49.09,0:13:52.39,Default,,0,0,0,,Бұл өте қызық сияқты. Мен бара аламын ба?
Dialogue: 0,0:13:52.96,0:13:56.50,Default,,0,0,0,,Балалармен кездесулер мені күлдіреді.
Dialogue: 0,0:13:57.40,0:14:00.27,Default,,0,0,0,,Оны блогыңызға жүктеңіз
Dialogue: 0,0:14:00.37,0:14:01.27,Default,,0,0,0,,Келесі аптада кездескенше
Dialogue: 0,0:14:01.40,0:14:05.61,Default,,0,0,0,,Түсірілімнен кейін демалыс күні бояндыңыз ба?
Dialogue: 0,0:14:05.87,0:14:06.54,Default,,0,0,0,,Жаман ба?
Dialogue: 0,0:14:06.87,0:14:08.28,Default,,0,0,0,,Мен жай ғана сұрадым.
Dialogue: 0,0:14:08.61,0:14:13.55,Default,,0,0,0,,Сіз маған баяғыда салқынқандылық таныту үшін маған қамқорлық жасап жатырсыз.
Dialogue: 0,0:14:13.88,0:14:16.02,Default,,0,0,0,,Мен жай ғана досыма көмектескім келеді
Dialogue: 0,0:14:16.08,0:14:21.12,Default,,0,0,0,,Оның орнына әке бола ма, жоқ па, бәрібір.
Dialogue: 0,0:14:21.32,0:14:25.99,Default,,0,0,0,,Мен ол қыздың бұрынғы келбетімді қайталауына да жол бермедім.
Dialogue: 0,0:14:26.06,0:14:28.90,Default,,0,0,0,,Өзіңізге төмен қарамаңыз
Dialogue: 0,0:14:29.56,0:14:31.10,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:14:31.90,0:14:33.90,Default,,0,0,0,,Сол балаға бірдеңе болса ше?
Dialogue: 0,0:14:34.60,0:14:35.44,Default,,0,0,0,,Сара
Dialogue: 0,0:14:36.50,0:14:37.17,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:14:37.30,0:14:38.31,Default,,0,0,0,,Боджак
Dialogue: 0,0:14:38.44,0:14:43.58,Default,,0,0,0,,Мына қабырғаны қағып, секс бөлмесін жасаңыз.
Dialogue: 0,0:14:43.91,0:14:44.91,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:45.01,0:14:47.18,Default,,0,0,0,,Біртүрлі аура бермеңіз
Dialogue: 0,0:14:47.95,0:14:49.92,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:50.32,0:14:54.32,Default,,0,0,0,,Мен өзімнің шынайы бетімді осында сақтай аламын деп ойладым.
Dialogue: 0,0:14:54.42,0:14:55.46,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:14:56.39,0:14:58.43,Default,,0,0,0,,Қалай қарасаң да тым көп
Dialogue: 0,0:14:59.16,0:15:01.20,Default,,0,0,0,,Бұл сіздің соңғы жолыңыз.
Dialogue: 0,0:15:01.33,0:15:03.60,Default,,0,0,0,,Тек қабырғаны қиратпаңыз
Dialogue: 0,0:15:03.90,0:15:07.60,Default,,0,0,0,,Мен мұны істегім келеді, бірақ енді мұны істей алмайтын шығармын.
Dialogue: 0,0:15:07.90,0:15:09.20,Default,,0,0,0,,Жақсы бала
Dialogue: 0,0:15:09.34,0:15:11.21,Default,,0,0,0,,О, Құдай-ай, сен қатты жалықтырасың!
Dialogue: 0,0:15:15.68,0:15:19.31,Default,,0,0,0,,Біз осылай жиналдық...
Dialogue: 0,0:15:19.41,0:15:21.08,Default,,0,0,0,,Тодд, сен не істеп жатырсың?
Dialogue: 0,0:15:21.15,0:15:27.05,Default,,0,0,0,,Осы үйде өз ойыңды білдіргің келсе, алдымен менің рұқсатымды ал.
Dialogue: 0,0:15:27.19,0:15:29.62,Default,,0,0,0,,Ал, мен өз ойымды айтайын.
Dialogue: 0,0:15:29.99,0:15:34.03,Default,,0,0,0,,Бұл өтінішке қатысты мен оны жоққа шығарамын.
Dialogue: 0,0:15:34.16,0:15:38.63,Default,,0,0,0,,Бұлай жалғаса берсе, сізді Сара пайдаланады.
Dialogue: 0,0:15:38.93,0:15:42.97,Default,,0,0,0,,Менің Сарамен ерекше байланысым бар.
Dialogue: 0,0:15:43.07,0:15:45.34,Default,,0,0,0,,Мына ойранға қараңызшы.
Dialogue: 0,0:15:45.51,0:15:49.21,Default,,0,0,0,,Мен топозда маринадталған боламын.
Dialogue: 0,0:15:49.28,0:15:51.48,Default,,0,0,0,,Егер Хигучи ең кішкентай күдікті қимыл жасаса,
Dialogue: 0,0:15:51.61,0:15:53.45,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:15:53.51,0:15:57.35,Default,,0,0,0,,Ол менің туған әкем емес, сондықтан сызықты сызу керек.
Dialogue: 0,0:15:57.45,0:15:59.65,Default,,0,0,0,,Ол тоғыз жыл әке рөлін сомдады.
Dialogue: 0,0:15:59.99,0:16:02.99,Default,,0,0,0,,Балалар сендерге қарағанда ата-анаға көбірек ұқсайды.
Dialogue: 0,0:16:03.26,0:16:05.39,Default,,0,0,0,,Сызық сызудың қажеті жоқ
Dialogue: 0,0:16:05.49,0:16:08.10,Default,,0,0,0,,Махаббат беру керек.
Dialogue: 0,0:16:08.20,0:16:10.23,Default,,0,0,0,,Бұл бағдарлама емес
Dialogue: 0,0:16:10.60,0:16:12.67,Default,,0,0,0,,Бұл шынайы өмір
Dialogue: 0,0:16:13.40,0:16:15.67,Default,,0,0,0,,Көмектесші, жанып барамын
Dialogue: 0,0:16:19.17,0:16:21.74,Default,,0,0,0,,Менің ол балаға деген махаббатым ешқашан өзгермейді.
Dialogue: 0,0:16:22.01,0:16:25.08,Default,,0,0,0,,Жалынды махаббатыңды төгіп
Dialogue: 0,0:16:26.41,0:16:28.42,Default,,0,0,0,,Келесіде ойнаймыз ба?
Dialogue: 0,0:16:31.29,0:16:35.42,Default,,0,0,0,,Мен саған мускат жаңғағы қосылған джин әкелдім.
Dialogue: 0,0:16:35.56,0:16:37.56,Default,,0,0,0,,Мускат жаңғағы тым көп
Dialogue: 0,0:16:37.69,0:16:42.36,Default,,0,0,0,,Неліктен словак йогурты туралы ақпаратты таратуға болмайды?
Dialogue: 0,0:16:42.46,0:16:44.50,Default,,0,0,0,,Жақсы жұмыс, солай ма?
Dialogue: 0,0:16:44.77,0:16:48.57,Default,,0,0,0,,Ванессаның жүзі өте жақсы.
Dialogue: 0,0:16:48.67,0:16:51.71,Default,,0,0,0,,Мен үлкен жұмысқа орналастым.
Dialogue: 0,0:16:52.04,0:16:54.31,Default,,0,0,0,,Егер бұл комедиялық шоу болса...
Dialogue: 0,0:16:54.44,0:16:58.78,Default,,0,0,0,,Сара, қазір сыртқа шығайық.
Dialogue: 0,0:16:59.18,0:17:00.78,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:17:01.05,0:17:02.15,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:17:02.55,0:17:05.75,Default,,0,0,0,,«Санта-Моника»
Dialogue: 0,0:17:19.30,0:17:20.33,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:17:20.50,0:17:23.57,Default,,0,0,0,,Осылай жасасаңыз, уайымыңыз жоғалады.
Dialogue: 0,0:17:25.04,0:17:27.57,Default,,0,0,0,,Казазу қатерлі ісікке шалдыққан.
Dialogue: 0,0:17:27.67,0:17:29.68,Default,,0,0,0,,Казаз шөпі?
Dialogue: 0,0:17:30.08,0:17:32.75,Default,,0,0,0,,Өкецұғанның арқасында сенің жарты жыл ғана өмірің қалды.
Dialogue: 0,0:17:33.21,0:17:35.32,Default,,0,0,0,,Неге қазір бұл туралы айтып отырсың?
Dialogue: 0,0:17:35.38,0:17:38.82,Default,,0,0,0,,Әлгі тау құланға ұқсайтын
Dialogue: 0,0:17:39.09,0:17:43.12,Default,,0,0,0,,Бұл маған Қазаздың есек мылтығын еске түсірді.
Dialogue: 0,0:17:43.56,0:17:44.73,Default,,0,0,0,,Білмедің бе?
Dialogue: 0,0:17:44.79,0:17:48.50,Default,,0,0,0,,Мен онымен байланыста болған жоқпын.
Dialogue: 0,0:17:48.76,0:17:50.50,Default,,0,0,0,,Мен мұны сен үшін жасаймын
Dialogue: 0,0:17:51.30,0:17:52.83,Default,,0,0,0,,«ТВ гид сыйлығы»?
Dialogue: 0,0:17:53.17,0:17:55.64,Default,,0,0,0,,Бұл мен алған ең жақсы марапат.
Dialogue: 0,0:17:55.70,0:17:58.61,Default,,0,0,0,,Мен бір күні балама осылай жасасам ба деп ойладым.
Dialogue: 0,0:17:59.21,0:18:00.07,Default,,0,0,0,,Мен оны саған беремін
Dialogue: 0,0:18:00.21,0:18:03.31,Default,,0,0,0,,Жарайды ма? Мен бақыттымын
Dialogue: 0,0:18:09.25,0:18:09.78,Default,,0,0,0,,Не?
Dialogue: 0,0:18:10.12,0:18:12.19,Default,,0,0,0,,Соңғы кредиттер
Dialogue: 0,0:18:13.82,0:18:15.39,Default,,0,0,0,,Ерекше сәттер
Dialogue: 0,0:18:15.52,0:18:17.52,Default,,0,0,0,,Атқарушы продюсер: Гари
Dialogue: 0,0:18:17.76,0:18:19.66,Default,,0,0,0,,Қандай жақсы күн
Dialogue: 0,0:18:19.79,0:18:21.26,Default,,0,0,0,,«Келесі аптада кездескенше»
Dialogue: 0,0:18:21.33,0:18:22.46,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:18:22.53,0:18:23.76,Default,,0,0,0,,Бағдарламаның соңы
Dialogue: 0,0:18:32.57,0:18:33.27,Default,,0,0,0,,Иә
Dialogue: 0,0:18:33.41,0:18:34.54,Default,,0,0,0,,Боджак
Dialogue: 0,0:18:34.71,0:18:39.48,Default,,0,0,0,,Сіздің олжаңыз ломбардта болды.
Dialogue: 0,0:18:39.58,0:18:41.65,Default,,0,0,0,,Неліктен ломбард?
Dialogue: 0,0:18:41.88,0:18:45.79,Default,,0,0,0,,Мұндай мәмілелерді бірден сатып алыңыз.
Dialogue: 0,0:18:45.89,0:18:47.82,Default,,0,0,0,,Өзіңізге ат қойыңыз
Dialogue: 0,0:18:48.16,0:18:51.43,Default,,0,0,0,,Оның да Академия сыйлығы бар.
Dialogue: 0,0:18:51.76,0:18:53.23,Default,,0,0,0,,Сара Линн!
Dialogue: 0,0:18:53.53,0:18:55.40,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:18:58.43,0:19:00.57,Default,,0,0,0,,Кеш аяқталды
Dialogue: 0,0:19:00.83,0:19:03.70,Default,,0,0,0,,Сара, саған айтар сөзім бар.
Dialogue: 0,0:19:04.40,0:19:06.41,Default,,0,0,0,,Сіз мұны саттыңыз ба?
Dialogue: 0,0:19:06.51,0:19:12.81,Default,,0,0,0,,Бұл үлкен жүлде емес, мен есірткі сатып алғым келді.
Dialogue: 0,0:19:13.71,0:19:17.72,Default,,0,0,0,,Мен сіздің қиын жағдайда екеніңізді түсінемін, бірақ...
Dialogue: 0,0:19:17.78,0:19:20.32,Default,,0,0,0,,Иә, солай деп ойлаймын.
Dialogue: 0,0:19:20.39,0:19:23.59,Default,,0,0,0,,Балаларға арналған бағдарлама да өткеннің еншісінде.
Dialogue: 0,0:19:23.72,0:19:24.46,Default,,0,0,0,,Тоқта
Dialogue: 0,0:19:24.56,0:19:29.33,Default,,0,0,0,,Жас кезімде жетістікке жетіп, стадиондарды толтырдым.
Dialogue: 0,0:19:29.50,0:19:34.74,Default,,0,0,0,,«Мен Сарамен ойнадым» деп мойындайтын жанкүйер хаты—
Dialogue: 0,0:19:34.84,0:19:37.60,Default,,0,0,0,,Күн сайын дерлік келеді.
Dialogue: 0,0:19:37.74,0:19:38.47,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:19:38.64,0:19:40.74,Default,,0,0,0,,Иә, бұл тым өрескел.
Dialogue: 0,0:19:40.81,0:19:41.88,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:19:41.94,0:19:45.85,Default,,0,0,0,,Мен осы сарайда тұрып, өзімді жұбатамын.
Dialogue: 0,0:19:46.18,0:19:49.58,Default,,0,0,0,,Мен өткеннен келгенімді мойындасам ше?
Dialogue: 0,0:19:49.72,0:19:50.75,Default,,0,0,0,,Тоқта
Dialogue: 0,0:19:50.88,0:19:56.69,Default,,0,0,0,,Мен саған қамқор болдым, бірақ сен менің әкем емессің.
Dialogue: 0,0:19:56.76,0:19:59.36,Default,,0,0,0,,О, сен менің қызым емессің.
Dialogue: 0,0:19:59.49,0:20:01.63,Default,,0,0,0,,Бір үйде тұратын еркек пен әйел
Dialogue: 0,0:20:01.73,0:20:03.90,Default,,0,0,0,,Ал екеуміз де маспыз.
Dialogue: 0,0:20:09.50,0:20:12.64,Default,,0,0,0,,Өртті кім бастады?
Dialogue: 0,0:20:13.61,0:20:16.38,Default,,0,0,0,,Сұрамай-ақ түсінуге болады ғой, солай ма?
Dialogue: 0,0:20:16.48,0:20:18.78,Default,,0,0,0,,Мен жаман қызбын
Dialogue: 0,0:20:18.91,0:20:20.98,Default,,0,0,0,,Ой, ол сондай жаман бала.
Dialogue: 0,0:20:21.32,0:20:22.92,Default,,0,0,0,,Мен оны өшіремін бе?
Dialogue: 0,0:20:23.25,0:20:25.39,Default,,0,0,0,,Кеудеңізбен бірге шырын
Dialogue: 0,0:20:25.65,0:20:26.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:26.52,0:20:28.86,Default,,0,0,0,,Сіздің кеудеңіз...
Dialogue: 0,0:20:29.26,0:20:31.59,Default,,0,0,0,,Шамадан тыс өршу
Dialogue: 0,0:20:31.66,0:20:32.53,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:32.63,0:20:34.80,Default,,0,0,0,,Есірткі алғыңыз келе ме?
Dialogue: 0,0:20:35.30,0:20:38.40,Default,,0,0,0,,Менің қалағаным – «ат»
Dialogue: 0,0:20:38.47,0:20:40.87,Default,,0,0,0,,Сіз не істеп жатырсыз? Тоқта.
Dialogue: 0,0:20:41.34,0:20:42.94,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:20:43.00,0:20:45.27,Default,,0,0,0,,Неліктен? Бұл ең нашар.
Dialogue: 0,0:20:45.41,0:20:48.41,Default,,0,0,0,,Маған сол жерде жайылған көрпеңізді қайтарыңыз...
Dialogue: 0,0:20:48.61,0:20:51.41,Default,,0,0,0,,Шынымды айтсам, мені ұстамаңыз
Dialogue: 0,0:20:51.78,0:20:54.82,Default,,0,0,0,,Сондықтан бұл жақсы емес, араласпа.
Dialogue: 0,0:20:58.59,0:21:00.95,Default,,0,0,0,,Менің саусақтарым әлі жансыз
Dialogue: 0,0:21:01.29,0:21:02.92,Default,,0,0,0,,Бұл ұзақ екі минут болды.
Dialogue: 0,0:21:03.26,0:21:07.39,Default,,0,0,0,,Бар болғаны 2 минут? Біз ұзағырақ сөйлестік
Dialogue: 0,0:21:07.49,0:21:10.56,Default,,0,0,0,,Бұл керемет жағдай.
Dialogue: 0,0:21:10.63,0:21:11.97,Default,,0,0,0,,Бұқаралық ақпарат құралдары?
Dialogue: 0,0:21:12.30,0:21:14.94,Default,,0,0,0,,Білсең, соқпа.
Dialogue: 0,0:21:15.27,0:21:19.57,Default,,0,0,0,,Егер сіз бұл туралы ақылмен ойласаңыз да, бұл өте қауіпті жағдай.
Dialogue: 0,0:21:19.94,0:21:21.44,Default,,0,0,0,,Мен жатайын
Dialogue: 0,0:21:24.54,0:21:26.81,Default,,0,0,0,,Мен қолданылып жатырмын
Dialogue: 0,0:21:26.91,0:21:29.95,Default,,0,0,0,,Сіз де сол қызды пайдаланып жатырсыз.
Dialogue: 0,0:21:30.05,0:21:32.72,Default,,0,0,0,,Ол әке алаяқ
Dialogue: 0,0:21:32.89,0:21:35.69,Default,,0,0,0,,Бұл сенің мен сияқтысың деген сөз.
Dialogue: 0,0:21:35.82,0:21:37.96,Default,,0,0,0,,Мен саған сендім.
Dialogue: 0,0:21:41.06,0:21:42.86,Default,,0,0,0,,Сара Ал енді ше?
Dialogue: 0,0:21:43.00,0:21:45.33,Default,,0,0,0,,Келісімшартқа қол қоюға мүдделісіз бе?
Dialogue: 0,0:21:45.47,0:21:46.87,Default,,0,0,0,,Онда барыңыз
Dialogue: 0,0:21:47.00,0:21:47.60,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:21:47.77,0:21:50.47,Default,,0,0,0,,Сара, мен емделуге бара жатырмын.
Dialogue: 0,0:21:50.60,0:21:53.47,Default,,0,0,0,,Мен бұл жерде отырғым келмейді.
Dialogue: 0,0:21:53.77,0:21:55.01,Default,,0,0,0,,Барлығы 1965 жылғы жазға барып тіреледі
Dialogue: 0,0:21:56.34,0:22:00.41,Default,,0,0,0,,Бұл жерден кетіп, лайықты көмек алыңыз.
Dialogue: 0,0:22:00.51,0:22:03.85,Default,,0,0,0,,Мен сенімен мәңгі бірге боламын дедім.
Dialogue: 0,0:22:04.35,0:22:06.75,Default,,0,0,0,,Әке сенің жаныңда
Dialogue: 0,0:22:06.89,0:22:08.09,Default,,0,0,0,,Кесілген үзіліс
Dialogue: 0,0:22:08.42,0:22:10.09,Default,,0,0,0,,10 минуттан кейін түйіндеме
Dialogue: 0,0:22:11.56,0:22:15.00,Default,,0,0,0,,Бұл сценарий мүлдем пайдасыз.
Dialogue: 0,0:22:15.06,0:22:17.50,Default,,0,0,0,,Бұл ақымақ.
Dialogue: 0,0:22:17.60,0:22:18.63,Default,,0,0,0,,Мен телефондамын.
Dialogue: 0,0:22:18.80,0:22:20.87,Default,,0,0,0,,Үлес кейінірек келеді ме?
Dialogue: 0,0:22:21.57,0:22:23.50,Default,,0,0,0,,Бұл алдын ала берілген уәде.
Dialogue: 0,0:22:23.64,0:22:26.77,Default,,0,0,0,,Мен сені жақсыларымнан пышақтаймын.
Dialogue: 0,0:22:27.51,0:22:28.88,Default,,0,0,0,,Неге Цуки камералар мен тыңшылық құрылғыларға сонша әуес?
Dialogue: 0,0:22:30.98,0:22:33.05,Default,,0,0,0,,Мен сенің жаныңда боламын дедім.
Dialogue: 0,0:22:33.38,0:22:37.05,Default,,0,0,0,,Бұл саған, кет бұл жерден.
Dialogue: 0,0:22:37.58,0:22:39.52,Default,,0,0,0,,Олай болса, жеткілікті.
Dialogue: 0,0:22:39.62,0:22:42.66,Default,,0,0,0,,Мен басқа аса бай адамдарды іздеймін.
Dialogue: 0,0:22:42.76,0:22:45.49,Default,,0,0,0,,Бұлай өмір сүруді доғар.
Dialogue: 0,0:22:45.63,0:22:48.06,Default,,0,0,0,,Рұқсат етілгенше жалғастырыңыз
Dialogue: 0,0:22:48.66,0:22:52.90,Default,,0,0,0,,Өсу мен өзін-өзі жетілдіру мағынасыз.
Dialogue: 0,0:22:53.10,0:22:55.64,Default,,0,0,0,,Айнала ең нашар...
Dialogue: 0,0:22:55.74,0:22:58.07,Default,,0,0,0,,Сен жас өлесің.
Dialogue: 0,0:22:58.67,0:22:59.54,Default,,0,0,0,,Не?
Dialogue: 0,0:22:59.67,0:23:02.01,Default,,0,0,0,,Мен оны енді тоқтата алмаймын
Dialogue: 0,0:23:03.44,0:23:06.01,Default,,0,0,0,,Оңай алайық
Dialogue: 0,0:23:06.41,0:23:10.38,Default,,0,0,0,,Мен Ванессамен кездесуді шештім.
Dialogue: 0,0:23:10.45,0:23:11.55,Default,,0,0,0,,Сондықтан кешірім сұраймын.
Dialogue: 0,0:23:11.69,0:23:13.42,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:23:13.99,0:23:16.42,Default,,0,0,0,,Жаңа жиынтық сөйлем
Dialogue: 0,0:23:16.66,0:23:19.53,Default,,0,0,0,,«Пайдасыз.»
Dialogue: 0,0:23:22.76,0:23:25.03,Default,,0,0,0,,Лаура, операция сәтті өтті.
Dialogue: 0,0:23:25.57,0:23:28.57,Default,,0,0,0,,Мен қайтып келмеймін.
Dialogue: 0,0:23:28.97,0:23:32.97,Default,,0,0,0,,Эндрюдің өкілі Сарамен кездеседі.
Dialogue: 0,0:23:33.07,0:23:34.71,Default,,0,0,0,,Ақпараттың ағып кетуі
Dialogue: 0,0:23:34.84,0:23:37.44,Default,,0,0,0,,Мен Эндрюмен кешкі ас іштік
Dialogue: 0,0:23:37.68,0:23:39.11,Default,,0,0,0,,итальян
Dialogue: 0,0:23:39.85,0:23:41.08,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:23:41.15,0:23:44.92,Default,,0,0,0,,Ол өсе алмады
Dialogue: 0,0:23:45.05,0:23:48.92,Default,,0,0,0,,Бұл атақты әлемде жиі кездеседі.
Dialogue: 0,0:23:49.12,0:23:52.79,Default,,0,0,0,,Демек, барлығына қоғам кінәлі...
Dialogue: 0,0:23:52.86,0:23:56.13,Default,,0,0,0,,Жауапкершілікті сезінудің қажеті жоқ па?
Dialogue: 0,0:23:56.60,0:23:58.87,Default,,0,0,0,,Бұл сәл басқаша, бірақ...
Dialogue: 0,0:23:59.03,0:24:00.73,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:24:00.87,0:24:05.01,Default,,0,0,0,,Менің осындай болғаныма қоғам кінәлі.
Dialogue: 0,0:24:05.14,0:24:09.44,Default,,0,0,0,,Шіріген қоғамның мейіріміне кез келген адам.
Dialogue: 0,0:24:09.58,0:24:11.44,Default,,0,0,0,,Осы мағынада...
Dialogue: 0,0:24:11.55,0:24:13.98,Default,,0,0,0,,Бәріне қоғам кінәлі
Dialogue: 0,0:24:14.05,0:24:16.22,Default,,0,0,0,,Бұл дүниенің кінәсі.
Dialogue: 0,0:24:16.55,0:24:16.98,Default,,0,0,0,,(Декү) Кешір мені (Каири) Ах…
Dialogue: 0,0:24:17.05,0:24:18.62,Default,,0,0,0,,Содан кейін олар жоғалады
Dialogue: 0,0:24:18.75,0:24:20.99,Default,,0,0,0,,Мұның бәрі мағынасыз
Dialogue: 0,0:24:21.22,0:24:23.89,Default,,0,0,0,,Бұл менің кінәм емес!
Dialogue: 0,0:24:26.49,0:24:28.23,Default,,0,0,0,,Сіз жақсы жаңалық естідіңіз бе?
Dialogue: 0,0:24:28.63,0:24:30.76,Default,,0,0,0,,А, бұл ерекше қулық.
Dialogue: 0,0:24:32.26,0:24:38.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
