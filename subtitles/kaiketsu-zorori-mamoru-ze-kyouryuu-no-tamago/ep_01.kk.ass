Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.50,0:00:07.63,Default,,0,0,0,,Мен тоқтай алмаймын, тоқтай алмаймын!
Dialogue: 0,0:00:08.21,0:00:11.38,Default,,0,0,0,,Көпіршікті орамды ұсақтап, бақытты болыңыз!
Dialogue: 0,0:00:11.55,0:00:13.72,Default,,0,0,0,,Бүгін әлемнің барлық жерінде
Dialogue: 0,0:00:13.84,0:00:14.76,Default,,0,0,0,,Бір бұлтсыз күн шуақты.
Dialogue: 0,0:00:14.76,0:00:15.89,Default,,0,0,0,,Бір бұлтсыз шуақты ауа-райы.
Dialogue: 0,0:00:14.76,0:00:15.89,Default,,0,0,0,,Ах ммм
Dialogue: 0,0:00:15.89,0:00:16.01,Default,,0,0,0,,Ах ммм
Dialogue: 0,0:00:16.09,0:00:18.89,Default,,0,0,0,,Бірақ бүгіннен бастап ертеңге дейін теңіз керемет болады.
Dialogue: 0,0:00:19.06,0:00:21.73,Default,,0,0,0,,Бұрын-соңды көрмеген тайфун басталды...
Dialogue: 0,0:00:21.85,0:00:22.89,Default,,0,0,0,,Кез келген нәрсе—
Dialogue: 0,0:00:23.06,0:00:25.23,Default,,0,0,0,,Оның ұшып кету қаупі бар.
Dialogue: 0,0:00:25.35,0:00:27.27,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:00:27.73,0:00:31.82,Default,,0,0,0,,Бұл кішкентай резеңке қайықты тайфун ұшырып әкетеді!
Dialogue: 0,0:00:32.24,0:00:34.11,Default,,0,0,0,,Ношиши Дүрбелең емес
Dialogue: 0,0:00:34.45,0:00:37.57,Default,,0,0,0,,Тайфун келгенше аралға жете аламыз.
Dialogue: 0,0:00:37.82,0:00:38.78,Default,,0,0,0,,Йотто!
Dialogue: 0,0:00:40.58,0:00:42.08,Default,,0,0,0,,қауіпсіз.
Dialogue: 0,0:00:42.25,0:00:45.50,Default,,0,0,0,,Эй, бұл менің бірінші рет, сондықтан мен оны асыға күтпеймін.
Dialogue: 0,0:00:45.62,0:00:47.46,Default,,0,0,0,,Мен де бірінші рет!
Dialogue: 0,0:00:47.96,0:00:50.71,Default,,0,0,0,,Дәлірек айтсақ, әлемнің қай жеріне қарасаңыз да...
Dialogue: 0,0:00:51.21,0:00:52.92,Default,,0,0,0,,Айдаһар жұмыртқадан шығады.
Dialogue: 0,0:00:53.38,0:00:56.43,Default,,0,0,0,,Маған ешкім қарсы тұра алмайды!
Dialogue: 0,0:00:57.34,0:01:00.22,Default,,0,0,0,,«Зори-сан Ишиши-сан Ношиши-сан»
Dialogue: 0,0:01:00.35,0:01:02.02,Default,,0,0,0,,«Барлығының жағдайы қалай?»
Dialogue: 0,0:01:02.14,0:01:04.39,Default,,0,0,0,,«Зори-санға рахмет, біздің отбасымыз...»
Dialogue: 0,0:01:04.52,0:01:06.77,Default,,0,0,0,,«Мен тыныш және тыныш өмір сүремін».
Dialogue: 0,0:01:07.31,0:01:09.40,Default,,0,0,0,,«Шындығында, бұл жолы біз...»
Dialogue: 0,0:01:09.52,0:01:12.61,Default,,0,0,0,,«Біздің отбасымызға жаңа адам қосылды».
Dialogue: 0,0:01:12.78,0:01:16.53,Default,,0,0,0,,«Иә, жұмыртқа туды».
Dialogue: 0,0:01:16.65,0:01:17.95,Default,,0,0,0,,«Қазір де, әлемнің бір жерінде...»
Dialogue: 0,0:01:18.11,0:01:20.66,Default,,0,0,0,,«Себебі Зориге өте қатал қарауда».
Dialogue: 0,0:01:20.78,0:01:23.12,Default,,0,0,0,,«Бұл негізсіз сұрау болуы мүмкін.»
Dialogue: 0,0:01:23.29,0:01:25.62,Default,,0,0,0,,«Бірақ уақытыңыз болса...»
Dialogue: 0,0:01:25.75,0:01:28.63,Default,,0,0,0,,«Біздің аралға келіңізші»
Dialogue: 0,0:01:28.75,0:01:31.80,Default,,0,0,0,,«Жаңа отбасы дүниеге келгенде...»
Dialogue: 0,0:01:31.92,0:01:34.76,Default,,0,0,0,,«Бірге тұра алсаңдар мен бақытты болар едім».
Dialogue: 0,0:01:35.01,0:01:37.09,Default,,0,0,0,,«Кёрю Мамадан»
Dialogue: 0,0:01:37.63,0:01:40.26,Default,,0,0,0,,Мен мұны тойлауға баруым керек!
Dialogue: 0,0:01:40.39,0:01:41.26,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:01:42.10,0:01:42.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:47.14,0:01:50.23,Default,,0,0,0,,Мен мұндай кеменің осы жерден өтетініне сене алмаймын.
Dialogue: 0,0:01:50.36,0:01:51.94,Default,,0,0,0,,Мен радионы қарызға аламын.
Dialogue: 0,0:01:52.61,0:01:55.36,Default,,0,0,0,,мына жігітпен
Dialogue: 0,0:01:55.74,0:01:57.45,Default,,0,0,0,,Хоорагай Майк!
Dialogue: 0,0:01:57.57,0:01:59.07,Default,,0,0,0,,Бұл өкінішті мәңгі бойымен арқалап жүремін.
Dialogue: 0,0:01:59.20,0:01:59.86,Default,,0,0,0,,Хаа~
Dialogue: 0,0:01:59.99,0:02:02.78,Default,,0,0,0,,Конни~чива~!
Dialogue: 0,0:02:02.91,0:02:04.58,Default,,0,0,0,,Yaho!
Dialogue: 0,0:02:04.70,0:02:07.83,Default,,0,0,0,,Теңіздегі күн сәулесі Қайырлы түн!
Dialogue: 0,0:02:08.50,0:02:10.50,Default,,0,0,0,,Сіз байқаған сияқтысыз.
Dialogue: 0,0:02:11.96,0:02:14.88,Default,,0,0,0,,Сіз осындай бірдеңе жасадыңыз ба?
Dialogue: 0,0:02:15.17,0:02:16.34,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:02:16.51,0:02:17.84,Default,,0,0,0,,Жоқ (Ношиши Ишиши) хахахахаха
Dialogue: 0,0:02:18.01,0:02:20.68,Default,,0,0,0,,Бұл жерден тіпті кемесі де жоқ кеменің өтетініне сене алар емеспін...
Dialogue: 0,0:02:20.84,0:02:22.35,Default,,0,0,0,,Бұл сирек деп ойлаңыз.
Dialogue: 0,0:02:22.47,0:02:23.18,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:02:23.35,0:02:25.93,Default,,0,0,0,,Сіз осы жердегі теңіз туралы бірдеңе білесіз бе?
Dialogue: 0,0:02:26.06,0:02:27.31,Default,,0,0,0,,Мүмкін жақын жерде—
Dialogue: 0,0:02:27.43,0:02:29.73,Default,,0,0,0,,Кюрю тұратын арал бар екенін білесіз бе?
Dialogue: 0,0:02:30.10,0:02:32.48,Default,,0,0,0,,Бұдан былай бізде алаңдайтын ештеңе жоқ.
Dialogue: 0,0:02:32.61,0:02:35.82,Default,,0,0,0,,Онда... nggnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn...
Dialogue: 0,0:02:35.94,0:02:37.36,Default,,0,0,0,,Солай дегің келе ме? Кешір мені.
Dialogue: 0,0:02:37.49,0:02:39.78,Default,,0,0,0,,Сіз бірдеңе білесіз бе? (Ишиши Зори) Иә!
Dialogue: 0,0:02:40.24,0:02:42.45,Default,,0,0,0,,Жоқ, мен бұл қауесетті естідім...
Dialogue: 0,0:02:42.57,0:02:45.20,Default,,0,0,0,,Қызық, сендер бірдеңе білесіңдер ме?
Dialogue: 0,0:02:45.95,0:02:49.16,Default,,0,0,0,,Бұл жай ғана қауесет пе?
Dialogue: 0,0:02:49.71,0:02:50.71,Default,,0,0,0,,Хаа~
Dialogue: 0,0:02:50.83,0:02:52.71,Default,,0,0,0,,Шындығында, біз (3 адам) а?
Dialogue: 0,0:02:52.83,0:02:54.42,Default,,0,0,0,,Біз бүгін аман қалдық...
Dialogue: 0,0:02:54.54,0:02:57.55,Default,,0,0,0,,Біз Чосаданбыз, Іздеу үшін қалыптасқан
Dialogue: 0,0:02:58.21,0:03:00.93,Default,,0,0,0,,Осы жердегі арал туралы Бір жыл болды
Dialogue: 0,0:03:01.05,0:03:05.18,Default,,0,0,0,,Қанша іздесем де, қанша іздесем де, Кюрюдің ізі де...
Dialogue: 0,0:03:05.31,0:03:09.68,Default,,0,0,0,,Осыншама еңбек еткен мүшелердің бірі хабарсыз кетті.
Dialogue: 0,0:03:09.81,0:03:11.35,Default,,0,0,0,,Жоқ па?
Dialogue: 0,0:03:11.48,0:03:12.48,Default,,0,0,0,,Иә
Dialogue: 0,0:03:12.60,0:03:15.02,Default,,0,0,0,,Әртүрлі оқиғалардың нәтижесінде—
Dialogue: 0,0:03:15.15,0:03:17.98,Default,,0,0,0,,Егін жинаудан бас тартып, Жапонияға қайтатын кез келді.
Dialogue: 0,0:03:18.11,0:03:20.28,Default,,0,0,0,,Түсіндім... Ой.
Dialogue: 0,0:03:20.45,0:03:22.74,Default,,0,0,0,,Бұл ұят болды. Эхехе
Dialogue: 0,0:03:22.86,0:03:26.16,Default,,0,0,0,,Жарайды, үйге аман-есен оралуыңды сұраймын.
Dialogue: 0,0:03:26.28,0:03:29.62,Default,,0,0,0,,Айтпақшы, бәрің мына оңтүстік теңізде не істеп жүрсіңдер?
Dialogue: 0,0:03:29.79,0:03:30.66,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:03:31.08,0:03:32.54,Default,,0,0,0,,Бұл... Иә!
Dialogue: 0,0:03:32.67,0:03:35.71,Default,,0,0,0,,Елсіз аралдағы жағажайдағы демалыс.
Dialogue: 0,0:03:35.84,0:03:36.84,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:03:36.96,0:03:38.67,Default,,0,0,0,,Бақансу~!
Dialogue: 0,0:03:41.88,0:03:44.80,Default,,0,0,0,,Ахаха хахаха... Мен оны қызғанамын
Dialogue: 0,0:03:44.93,0:03:47.22,Default,,0,0,0,,Олай болса, көңілді өтіңіз!
Dialogue: 0,0:03:47.35,0:03:48.77,Default,,0,0,0,,Ааа
Dialogue: 0,0:03:49.06,0:03:52.98,Default,,0,0,0,,Тайфундан сақ болыңыз!
Dialogue: 0,0:03:55.56,0:03:58.27,Default,,0,0,0,,Мен мұның соншалықты нашар екеніне сене алмадым!
Dialogue: 0,0:03:58.40,0:04:00.07,Default,,0,0,0,,Бұл қауіпті болды~
Dialogue: 0,0:04:00.19,0:04:02.49,Default,,0,0,0,,Дұрыс. Ал Кёрю отбасына келсек...
Dialogue: 0,0:04:02.61,0:04:05.41,Default,,0,0,0,,Сіз мұны құпия сақтауға уәде бергенсіз!
Dialogue: 0,0:04:06.45,0:04:07.74,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:08.37,0:04:11.66,Default,,0,0,0,,Келіңіздер! Кёрю отбасына сәби сыйлығы ретінде.
Dialogue: 0,0:04:12.00,0:04:13.96,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:04:14.50,0:04:16.46,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:16.79,0:04:21.80,Default,,0,0,0,,♪〜
Dialogue: 0,0:05:41.96,0:05:46.80,Default,,0,0,0,,〜♪
Dialogue: 0,0:05:48.43,0:05:49.80,Default,,0,0,0,,Ишиши Ношиши
Dialogue: 0,0:05:50.47,0:05:53.06,Default,,0,0,0,,Резеңке қайықты дұрыс бүктелген алып келіңіз.
Dialogue: 0,0:05:53.18,0:05:54.18,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:54.97,0:05:55.85,Default,,0,0,0,,Jut
Dialogue: 0,0:05:58.31,0:06:00.52,Default,,0,0,0,,Қайықты көтеріп алайық
Dialogue: 0,0:06:06.78,0:06:10.53,Default,,0,0,0,,Өте ыстық!
Dialogue: 0,0:06:10.66,0:06:12.83,Default,,0,0,0,,О~ Міне, осында.
Dialogue: 0,0:06:13.28,0:06:15.08,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:06:15.62,0:06:17.33,Default,,0,0,0,,Ааа хмм
Dialogue: 0,0:06:17.46,0:06:19.54,Default,,0,0,0,,Хмм... Ии...
Dialogue: 0,0:06:27.55,0:06:29.43,Default,,0,0,0,,Зоори мырза күткендей!
Dialogue: 0,0:06:29.59,0:06:31.84,Default,,0,0,0,,Ол өнертапқыш гений!
Dialogue: 0,0:06:31.97,0:06:34.47,Default,,0,0,0,,Жасырын есік жасаған дұрыс болды.
Dialogue: 0,0:06:34.60,0:06:38.56,Default,,0,0,0,,Әйтпесе, әлгі көбелек мені тауып алар еді.
Dialogue: 0,0:06:41.23,0:06:42.40,Default,,0,0,0,,N га
Dialogue: 0,0:06:43.27,0:06:44.57,Default,,0,0,0,,Ағымдағы дыбыс
Dialogue: 0,0:06:45.15,0:06:46.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:46.78,0:06:51.24,Default,,0,0,0,,Хахахахахахахахахахахахахахаха
Dialogue: 0,0:06:51.86,0:06:53.45,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:06:53.57,0:06:55.24,Default,,0,0,0,,Мен оның осы жерде екеніне сенімдімін
Dialogue: 0,0:07:14.18,0:07:15.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:19.02,0:07:20.89,Default,,0,0,0,,Уау~
Dialogue: 0,0:07:21.81,0:07:24.02,Default,,0,0,0,,(Қуаныш дауысы)
Dialogue: 0,0:07:24.65,0:07:27.65,Default,,0,0,0,,Мен мұны бір көргеннен көргім келді.
Dialogue: 0,0:07:27.78,0:07:29.90,Default,,0,0,0,,Ой (Ишиши Ношиши) Ахххххх
Dialogue: 0,0:07:30.07,0:07:31.03,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:31.90,0:07:33.61,Default,,0,0,0,,Ичини күнінде айналайын
Dialogue: 0,0:07:33.74,0:07:35.74,Default,,0,0,0,,Мен қорқамын.
Dialogue: 0,0:07:35.87,0:07:39.00,Default,,0,0,0,,Иә, бәріміз бірге барайық!
Dialogue: 0,0:07:39.12,0:07:40.66,Default,,0,0,0,,Иә~
Dialogue: 0,0:07:40.79,0:07:42.37,Default,,0,0,0,,Увааааааааааааааааааааааааа
Dialogue: 0,0:07:43.08,0:07:47.30,Default,,0,0,0,,Grrrrr
Dialogue: 0,0:07:47.42,0:07:49.55,Default,,0,0,0,,Гяааах!
Dialogue: 0,0:07:50.05,0:07:51.92,Default,,0,0,0,,Ахх!
Dialogue: 0,0:07:52.05,0:07:54.26,Default,,0,0,0,,Вааааааааааа
Dialogue: 0,0:07:55.30,0:07:55.97,Default,,0,0,0,,Ha
Dialogue: 0,0:07:56.89,0:08:00.10,Default,,0,0,0,,Ол біздің асыл жұмыртқаны ұрлауға келді.
Dialogue: 0,0:08:00.22,0:08:02.19,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:08:02.31,0:08:04.19,Default,,0,0,0,,Әке, жоқ, тоқтатыңыз!
Dialogue: 0,0:08:05.23,0:08:08.69,Default,,0,0,0,,Бұл фигуралар Зори-сан мен екі ересек адам.
Dialogue: 0,0:08:09.03,0:08:10.44,Default,,0,0,0,,Иә, папа!
Dialogue: 0,0:08:10.57,0:08:13.53,Default,,0,0,0,,Бізге Зори және басқалары көмектесті.
Dialogue: 0,0:08:13.65,0:08:15.74,Default,,0,0,0,,Fundemasu Fundemasu!
Dialogue: 0,0:08:16.66,0:08:17.91,Default,,0,0,0,,Хаа~
Dialogue: 0,0:08:19.66,0:08:23.04,Default,,0,0,0,,Ха ха ха ха ха ха Сәлем
Dialogue: 0,0:08:23.66,0:08:26.75,Default,,0,0,0,,Кешіріңіз! Осы кезде мен күмәнді көбелектермен қиналып жатырмын.
Dialogue: 0,0:08:26.88,0:08:28.54,Default,,0,0,0,,Мен аралды кезіп жүрдім.
Dialogue: 0,0:08:29.13,0:08:31.67,Default,,0,0,0,,Біз балаларымызды сол адамдардан қорғауымыз керек...
Dialogue: 0,0:08:31.80,0:08:36.01,Default,,0,0,0,,Мен қобалжыдым, сондықтан дөрекі әрекет жасадым.
Dialogue: 0,0:08:36.64,0:08:38.01,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:08:38.30,0:08:40.77,Default,,0,0,0,,Хаха, түсінсең жақсы.
Dialogue: 0,0:08:40.89,0:08:43.48,Default,,0,0,0,,Папамен бірінші рет кездесіп тұрғаным сөзсіз.
Dialogue: 0,0:08:43.60,0:08:46.48,Default,,0,0,0,,Олардың бәрі үлкен, бірақ әке - ең жақсысы.
Dialogue: 0,0:08:47.15,0:08:49.32,Default,,0,0,0,,Менің ағамды ұрлап кеткенде—
Dialogue: 0,0:08:49.44,0:08:50.57,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:50.69,0:08:53.15,Default,,0,0,0,,Мен оны қатты іздедім, сондықтан
Dialogue: 0,0:08:54.20,0:08:58.62,Default,,0,0,0,,Айтпақшы, мен бұл аралға келгенде ағам жоқ еді.
Dialogue: 0,0:08:58.95,0:09:01.12,Default,,0,0,0,,Сіз оны әлі іздеп жүрсіз бе?
Dialogue: 0,0:09:05.00,0:09:06.92,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:09:07.21,0:09:08.08,Default,,0,0,0,,Өте дәмді~
Dialogue: 0,0:09:08.21,0:09:10.13,Default,,0,0,0,,Осының бәрін жеуге бола ма?
Dialogue: 0,0:09:10.42,0:09:14.01,Default,,0,0,0,,Өтінемін, аралда әлі көп нәрсе бар.
Dialogue: 0,0:09:14.13,0:09:16.13,Default,,0,0,0,,Бұл жерде!
Dialogue: 0,0:09:16.26,0:09:18.55,Default,,0,0,0,,Дегенмен, бұл жақсы жұмыртқа.
Dialogue: 0,0:09:19.10,0:09:20.14,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:09:20.26,0:09:23.43,Default,,0,0,0,,Зоори маған жасаған жасырын есіктің арқасында...
Dialogue: 0,0:09:23.56,0:09:26.27,Default,,0,0,0,,Жан тыныштығымен босандым.
Dialogue: 0,0:09:26.39,0:09:28.98,Default,,0,0,0,,Баламның жұмыртқадан сау болып шыққанын көру.
Dialogue: 0,0:09:29.31,0:09:31.40,Default,,0,0,0,,Қарап көріңіз.
Dialogue: 0,0:09:31.52,0:09:33.69,Default,,0,0,0,,Мочи жоқ Ронде!
Dialogue: 0,0:09:34.78,0:09:37.95,Default,,0,0,0,,Аралда тамақтың көп болғаны жақсы...
Dialogue: 0,0:09:38.07,0:09:41.41,Default,,0,0,0,,Соның арқасында әлгі көбелек де ұзақ отырды.
Dialogue: 0,0:09:41.53,0:09:43.58,Default,,0,0,0,,Жағымсыз адамдар емес
Dialogue: 0,0:09:43.70,0:09:47.33,Default,,0,0,0,,Ойнайтын адамдар болса жақсы болар еді.
Dialogue: 0,0:09:47.46,0:09:50.42,Default,,0,0,0,,Өмір сүру оңай емес деп ойлаймын.
Dialogue: 0,0:09:50.54,0:09:53.42,Default,,0,0,0,,Мен мұның бәрін жемегеніме қуаныштымын!
Dialogue: 0,0:09:53.55,0:09:55.26,Default,,0,0,0,,Міне!
Dialogue: 0,0:09:55.46,0:09:58.30,Default,,0,0,0,,Ахахахахахахахахахахахах
Dialogue: 0,0:10:02.05,0:10:03.97,Default,,0,0,0,,Мама
Dialogue: 0,0:10:04.31,0:10:08.06,Default,,0,0,0,,Өйткені, анамның иісі маған ұнайды.
Dialogue: 0,0:10:08.27,0:10:09.98,Default,,0,0,0,,Ммм!
Dialogue: 0,0:10:11.27,0:10:11.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:13.19,0:10:14.36,Default,,0,0,0,,Анашым!
Dialogue: 0,0:10:16.40,0:10:18.03,Default,,0,0,0,,А? арман?
Dialogue: 0,0:10:18.45,0:10:19.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:19.41,0:10:22.28,Default,,0,0,0,,Не!? Аа!?
Dialogue: 0,0:10:27.12,0:10:30.21,Default,,0,0,0,,Жұмыртқа... асыл балам
Dialogue: 0,0:10:31.50,0:10:34.21,Default,,0,0,0,,Уау, күте тұрыңыз~
Dialogue: 0,0:10:34.34,0:10:37.21,Default,,0,0,0,,Мияу, бұл жаман! Ишиши! Ношиши!
Dialogue: 0,0:10:37.34,0:10:39.68,Default,,0,0,0,,Оян! Жұмыртқаны тоқтатыңыз!
Dialogue: 0,0:10:39.80,0:10:42.35,Default,,0,0,0,,Хм, шулы болғаны сонша, ұйықтай алмаймын
Dialogue: 0,0:10:42.47,0:10:44.97,Default,,0,0,0,,Жақында оны тазалайтын адам бар ма?
Dialogue: 0,0:10:45.10,0:10:45.93,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:10:48.35,0:10:49.73,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:10:50.23,0:10:52.23,Default,,0,0,0,,Зоори мырза~!
Dialogue: 0,0:10:52.36,0:10:53.19,Default,,0,0,0,,Уау
Dialogue: 0,0:11:07.16,0:11:08.37,Default,,0,0,0,,Уау~
Dialogue: 0,0:11:12.83,0:11:15.04,Default,,0,0,0,,Екеуміз жабысып қалғандықтан—
Dialogue: 0,0:11:15.17,0:11:18.38,Default,,0,0,0,,Бұл қиын! Бұлай жалғаса берсе, ол теңізге түседі
Dialogue: 0,0:11:18.51,0:11:19.59,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:11:21.43,0:11:25.14,Default,,0,0,0,,Уау! Апыр-ай! О!
Dialogue: 0,0:11:26.51,0:11:27.97,Default,,0,0,0,,Төрт қадам… бес қадам
Dialogue: 0,0:11:31.89,0:11:33.81,Default,,0,0,0,,Папа~
Dialogue: 0,0:11:41.95,0:11:42.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:43.28,0:11:44.12,Default,,0,0,0,,Хмф!
Dialogue: 0,0:11:45.70,0:11:46.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:46.66,0:11:47.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:47.91,0:11:49.70,Default,,0,0,0,,Уууу!
Dialogue: 0,0:11:49.83,0:11:51.46,Default,,0,0,0,,Кя~! (Кёрю інісі/аға) Папа!
Dialogue: 0,0:11:51.58,0:11:54.33,Default,,0,0,0,,Вааааааааааааааааааааааааааа
Dialogue: 0,0:11:54.46,0:11:55.33,Default,,0,0,0,,Құт
Dialogue: 0,0:11:56.00,0:11:56.84,Default,,0,0,0,,Папа!
Dialogue: 0,0:11:56.96,0:11:58.55,Default,,0,0,0,,Уау!?
Dialogue: 0,0:11:59.13,0:12:00.05,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:02.09,0:12:02.93,Default,,0,0,0,,Ахх
Dialogue: 0,0:12:03.05,0:12:04.51,Default,,0,0,0,,Нашар! Қарғыс атсын
Dialogue: 0,0:12:04.97,0:12:05.80,Default,,0,0,0,,Ишиши!
Dialogue: 0,0:12:06.47,0:12:07.47,Default,,0,0,0,,Зоори мырза!
Dialogue: 0,0:12:07.60,0:12:08.56,Default,,0,0,0,,Әй
Dialogue: 0,0:12:09.31,0:12:11.31,Default,,0,0,0,,Ммммм
Dialogue: 0,0:12:11.43,0:12:13.89,Default,,0,0,0,,Ааааааааа
Dialogue: 0,0:12:14.65,0:12:15.60,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:15.90,0:12:17.52,Default,,0,0,0,,Не, Зоори-сенсэй!
Dialogue: 0,0:12:17.65,0:12:18.77,Default,,0,0,0,,Жақсы, Ишиши!
Dialogue: 0,0:12:20.57,0:12:21.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:21.53,0:12:25.45,Default,,0,0,0,,Зорори Сенсей~ (Ношиши Зорори) Уау~
Dialogue: 0,0:12:25.78,0:12:27.07,Default,,0,0,0,,U gaaaa
Dialogue: 0,0:12:27.20,0:12:28.74,Default,,0,0,0,,О, балапаным
Dialogue: 0,0:12:28.87,0:12:31.04,Default,,0,0,0,,Қауіпті! (Кёрюдың інісі) Анасы: Жоқ!
Dialogue: 0,0:12:31.16,0:12:33.21,Default,,0,0,0,,Бірақ менің жұмыртқам!
Dialogue: 0,0:12:33.33,0:12:35.54,Default,,0,0,0,,Эй, сен мені естисің бе? Ой!?
Dialogue: 0,0:12:35.67,0:12:36.88,Default,,0,0,0,,Ооо
Dialogue: 0,0:12:37.33,0:12:40.25,Default,,0,0,0,,Қазір секірсең, анама да қауіп төнеді!
Dialogue: 0,0:12:40.38,0:12:45.34,Default,,0,0,0,,Мен уәде беремін! Мен бағалы жұмыртқаны міндетті түрде қайтарамын!
Dialogue: 0,0:12:45.47,0:12:48.43,Default,,0,0,0,,Оның орнына мен жұмыртқаны қорғау үшін өз өмірімді қатерге тігемін.
Dialogue: 0,0:12:48.55,0:12:52.73,Default,,0,0,0,,Папаны жар түбінен тез құтқарыңыз!
Dialogue: 0,0:12:53.27,0:12:54.64,Default,,0,0,0,,Е-а-а~
Dialogue: 0,0:12:55.31,0:12:56.94,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:12:57.48,0:13:01.73,Default,,0,0,0,,Маған сеніп, мені күт!
Dialogue: 0,0:13:02.61,0:13:03.99,Default,,0,0,0,,N га
Dialogue: 0,0:13:05.70,0:13:06.82,Default,,0,0,0,,Қандай дыбыс?
Dialogue: 0,0:13:08.70,0:13:09.83,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:09.95,0:13:11.37,Default,,0,0,0,,Мүмкін бұл дауыл...
Dialogue: 0,0:13:11.49,0:13:13.62,Default,,0,0,0,,Айдаһарларға шабуыл жасалған шығар!
Dialogue: 0,0:13:14.25,0:13:16.33,Default,,0,0,0,,Хаха!
Dialogue: 0,0:13:16.75,0:13:17.58,Default,,0,0,0,,Құт
Dialogue: 0,0:13:17.71,0:13:20.13,Default,,0,0,0,,Ой... ой-а
Dialogue: 0,0:13:21.34,0:13:23.05,Default,,0,0,0,,Ха-ха
Dialogue: 0,0:13:23.59,0:13:24.59,Default,,0,0,0,,Құт
Dialogue: 0,0:13:29.93,0:13:32.35,Default,,0,0,0,,Жұмыртқа!? Жұмыртқа!
Dialogue: 0,0:13:32.52,0:13:35.06,Default,,0,0,0,,Бұл өлшем шынымен соншалықты үлкен бе?
Dialogue: 0,0:13:35.18,0:13:38.31,Default,,0,0,0,,Уф... Иә! Ақыры таптым!
Dialogue: 0,0:13:38.44,0:13:41.57,Default,,0,0,0,,Ей, оны ұстау қиын!
Dialogue: 0,0:13:41.69,0:13:44.03,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:13:44.15,0:13:48.61,Default,,0,0,0,,Уайымдамаңыз, егер сіз оны қайтарсаңыз, сізді тағы бір той күтіп тұр!
Dialogue: 0,0:13:49.45,0:13:51.49,Default,,0,0,0,,Біреу жұмыртқаны ұрлап кетті.
Dialogue: 0,0:13:51.62,0:13:52.99,Default,,0,0,0,,Ал мен оны жегім келеді!
Dialogue: 0,0:13:53.62,0:13:54.45,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:54.58,0:13:58.00,Default,,0,0,0,,Біз тиісті биология ғылымдарын қорғауымыз керек! Тет
Dialogue: 0,0:14:10.09,0:14:13.10,Default,,0,0,0,,Иә! Ақыры, мен оны алдым!
Dialogue: 0,0:14:13.22,0:14:14.39,Default,,0,0,0,,Зоори мырза!
Dialogue: 0,0:14:14.52,0:14:15.72,Default,,0,0,0,,Сіз мұны жасадыңыз!
Dialogue: 0,0:14:16.23,0:14:18.89,Default,,0,0,0,,Менің сүйкімді сүйкімді ханым
Dialogue: 0,0:14:19.60,0:14:22.82,Default,,0,0,0,,Жарқырап тұрғаны сонша, жүзіңді анық көрмеймін.
Dialogue: 0,0:14:22.94,0:14:27.03,Default,,0,0,0,,Қараңызшы, маған әдемі жүз беріңіз... Хм...
Dialogue: 0,0:14:27.78,0:14:29.24,Default,,0,0,0,,Иә? Хмм?
Dialogue: 0,0:14:29.36,0:14:32.62,Default,,0,0,0,,Керемет! Бұл таң қалдырады
Dialogue: 0,0:14:33.37,0:14:34.99,Default,,0,0,0,,Екеуін біз қараймыз.
Dialogue: 0,0:14:35.91,0:14:37.79,Default,,0,0,0,,Иә! Мен-
Dialogue: 0,0:14:37.91,0:14:40.88,Default,,0,0,0,,Мына жұмыртқаны үйге аман-есен әкелуге уәде бердің бе?
Dialogue: 0,0:14:41.00,0:14:41.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:42.63,0:14:43.96,Default,,0,0,0,,Ква Фу
Dialogue: 0,0:14:44.88,0:14:46.51,Default,,0,0,0,,Кува Хуу
Dialogue: 0,0:14:47.01,0:14:50.59,Default,,0,0,0,,Хаа... Барлығының аман болғанына қуаныштымын.
Dialogue: 0,0:14:56.39,0:14:57.60,Default,,0,0,0,,Бетінде бір атмосфера.
Dialogue: 0,0:14:57.73,0:15:00.19,Default,,0,0,0,,Эй, мен енді шыдай алмаймын.
Dialogue: 0,0:15:00.31,0:15:02.44,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:15:02.56,0:15:04.06,Default,,0,0,0,,Жоқ! (Ишиши Ношиши) А!?
Dialogue: 0,0:15:04.19,0:15:04.77,Default,,0,0,0,,Реңк!?
Dialogue: 0,0:15:07.11,0:15:08.69,Default,,0,0,0,,Ммм...
Dialogue: 0,0:15:08.82,0:15:12.11,Default,,0,0,0,,А? Не, қашан шықтың?
Dialogue: 0,0:15:13.07,0:15:15.08,Default,,0,0,0,,Мен саған ұнайтын нәрсені істеуге рұқсат бермеймін!
Dialogue: 0,0:15:15.20,0:15:16.83,Default,,0,0,0,,Уау! Апыр-ай! Жолдан кет!
Dialogue: 0,0:15:17.58,0:15:19.79,Default,,0,0,0,,Жұмыртқадан аулақ болыңыз!
Dialogue: 0,0:15:19.91,0:15:22.12,Default,,0,0,0,,Бұл кенеттен не болды?!
Dialogue: 0,0:15:22.67,0:15:24.34,Default,,0,0,0,,Бұл жұмыртқа қаншалықты ұқыпты?
Dialogue: 0,0:15:24.46,0:15:28.17,Default,,0,0,0,,Түсінбесем де! Оны жеудің еш зияны жоқ!
Dialogue: 0,0:15:28.30,0:15:30.01,Default,,0,0,0,,Ах! Ууууууууууу!
Dialogue: 0,0:15:30.13,0:15:32.68,Default,,0,0,0,,Ешкім жейміз деп айтқан жоқ!
Dialogue: 0,0:15:32.80,0:15:34.18,Default,,0,0,0,,Мен айттым ғой! Аа!?
Dialogue: 0,0:15:34.30,0:15:36.18,Default,,0,0,0,,Тайфун болған түнде! Теңізде!
Dialogue: 0,0:15:36.68,0:15:39.02,Default,,0,0,0,,Хмм, әшкере болмаңыз! Бұл қауіпті!
Dialogue: 0,0:15:39.18,0:15:41.73,Default,,0,0,0,,Жұмыртқадан құтыла алсаң, бәрі жақсы болады!
Dialogue: 0,0:15:41.85,0:15:42.77,Default,,0,0,0,,Ооо!
Dialogue: 0,0:15:42.90,0:15:44.40,Default,,0,0,0,,Зоори мырза!
Dialogue: 0,0:15:44.52,0:15:47.78,Default,,0,0,0,,Біз оны тез тоқтатуымыз керек! Егер ол сызылып кетсе де, бұл үлкен мәселе болар еді!
Dialogue: 0,0:15:47.90,0:15:48.73,Default,,0,0,0,,Уау!?
Dialogue: 0,0:15:49.82,0:15:50.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:51.03,0:15:51.95,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:15:52.95,0:15:54.11,Default,,0,0,0,,Түсіндім. Яғни, ән айтып, билейміз бе?
Dialogue: 0,0:15:55.28,0:15:56.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:56.83,0:15:58.54,Default,,0,0,0,,Мен тастай жаздадым!
Dialogue: 0,0:15:58.66,0:16:00.45,Default,,0,0,0,,Гякугирека!
Dialogue: 0,0:16:02.33,0:16:02.92,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:16:03.04,0:16:04.67,Default,,0,0,0,,Қазірдің өзінде! Менен аулақ жүр!
Dialogue: 0,0:16:04.79,0:16:08.25,Default,,0,0,0,,Уф, жоқ, менімен сөйлесіңізші!
Dialogue: 0,0:16:08.38,0:16:10.17,Default,,0,0,0,,Ношиши! Ха!
Dialogue: 0,0:16:10.30,0:16:12.93,Default,,0,0,0,,А... а, а, иә?
Dialogue: 0,0:16:13.68,0:16:14.72,Default,,0,0,0,,Гак!
Dialogue: 0,0:16:14.84,0:16:16.30,Default,,0,0,0,,О? иә?
Dialogue: 0,0:16:16.43,0:16:17.14,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:18.10,0:16:18.97,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:20.81,0:16:23.19,Default,,0,0,0,,Фуфуфуфуфуфуфуфу!
Dialogue: 0,0:16:23.31,0:16:25.31,Default,,0,0,0,,Уф! Алақай!
Dialogue: 0,0:16:25.60,0:16:26.40,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:16:26.52,0:16:27.31,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:16:27.44,0:16:28.23,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:28.48,0:16:30.32,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:30.78,0:16:32.99,Default,,0,0,0,,Ең сорақыны да шақырғаннан кейін!
Dialogue: 0,0:16:33.11,0:16:34.99,Default,,0,0,0,,Қарғыс атсын, бұл күшті!
Dialogue: 0,0:16:35.11,0:16:37.49,Default,,0,0,0,,Ол мықтап жабысып тұр және шықпайды!
Dialogue: 0,0:16:38.08,0:16:39.70,Default,,0,0,0,,Жоқ! Сөйлесіңіз!
Dialogue: 0,0:16:41.62,0:16:45.42,Default,,0,0,0,,Ммммммммммммммм
Dialogue: 0,0:16:45.62,0:16:47.71,Default,,0,0,0,,Мына сегізаяқ!
Dialogue: 0,0:16:47.84,0:16:49.75,Default,,0,0,0,,Гүлп (үлкен сегізаяқ) Hmph
Dialogue: 0,0:16:49.88,0:16:52.26,Default,,0,0,0,,Уау! (Үлкен сегізаяқ) Ууууууууууууууууууууууу
Dialogue: 0,0:16:53.05,0:16:56.68,Default,,0,0,0,,Қымбат жұмыртқамның жойылғанына шыдай алмаймын!
Dialogue: 0,0:16:57.18,0:16:59.51,Default,,0,0,0,,Иә! (Үлкен сегізаяқ) Фуфуфуфуфуфу
Dialogue: 0,0:16:59.64,0:17:00.43,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:02.77,0:17:03.56,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:17:05.48,0:17:08.23,Default,,0,0,0,,Ишиши! Ношиши! Бұл сызықша!
Dialogue: 0,0:17:08.35,0:17:09.19,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:17:09.31,0:17:12.65,Default,,0,0,0,,Хм, хехе, хехе
Dialogue: 0,0:17:14.99,0:17:19.20,Default,,0,0,0,,Муфуфуфуфуфу! Хун хун хун!
Dialogue: 0,0:17:19.70,0:17:21.12,Default,,0,0,0,,Сегізаяқ – көбелек!?
Dialogue: 0,0:17:21.62,0:17:23.79,Default,,0,0,0,,Хун хун хун!
Dialogue: 0,0:17:24.20,0:17:25.62,Default,,0,0,0,,Бір күні сен осында боласың!
Dialogue: 0,0:17:25.75,0:17:28.42,Default,,0,0,0,,Хамф! Ооо
Dialogue: 0,0:17:29.04,0:17:29.96,Default,,0,0,0,,(Фушигуро) Ол іссапарда. (Итадори) Ә?
Dialogue: 0,0:17:31.42,0:17:33.05,Default,,0,0,0,,А? Мен қашып бара жаттым
Dialogue: 0,0:17:33.17,0:17:34.63,Default,,0,0,0,,Уа, не!? Әй?
Dialogue: 0,0:17:36.93,0:17:37.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:39.93,0:17:42.68,Default,,0,0,0,,Уау~
Dialogue: 0,0:17:42.81,0:17:49.19,Default,,0,0,0,,Бұл жолы үлкен кит!
Dialogue: 0,0:17:51.77,0:17:52.61,Default,,0,0,0,,Хун
Dialogue: 0,0:17:58.20,0:18:01.45,Default,,0,0,0,,Уау... тым қараңғы, мен ештеңе көрмеймін.
Dialogue: 0,0:18:01.58,0:18:04.24,Default,,0,0,0,,Ишиши Дәл қазір көпіршікті орау қажет емес.
Dialogue: 0,0:18:04.37,0:18:06.62,Default,,0,0,0,,Мен уайымдаймын, уайымдаймын
Dialogue: 0,0:18:07.12,0:18:09.42,Default,,0,0,0,,Зоори мырза, біз не істеуіміз керек?
Dialogue: 0,0:18:09.54,0:18:12.00,Default,,0,0,0,,Сіз мені кім деп ойлайсыз?
Dialogue: 0,0:18:12.13,0:18:15.46,Default,,0,0,0,,Мені көп нәрсе жұтып, жеп қойды, бірақ...
Dialogue: 0,0:18:15.59,0:18:19.34,Default,,0,0,0,,Бұл әрқашан тамаша өнер көрсеткен Зори-сама!
Dialogue: 0,0:18:20.64,0:18:23.22,Default,,0,0,0,,Уайымдамаңыз, мен жай ғана үзіліс алдым.
Dialogue: 0,0:18:23.51,0:18:25.64,Default,,0,0,0,,Уақытша Хинан?
Dialogue: 0,0:18:26.18,0:18:28.77,Default,,0,0,0,,Ашкөз киттер тамақпен ғана шектелмейді.
Dialogue: 0,0:18:28.89,0:18:30.90,Default,,0,0,0,,Мен көп нәрсені жұтып жатырмын.
Dialogue: 0,0:18:31.02,0:18:32.48,Default,,0,0,0,,Мысалы, осындай нәрсе
Dialogue: 0,0:18:33.02,0:18:33.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:34.27,0:18:35.82,Default,,0,0,0,,Осындай нәрсе
Dialogue: 0,0:18:36.24,0:18:37.32,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:18:37.44,0:18:40.16,Default,,0,0,0,,Мен қалыпты өмір сүре алатын сияқтымын.
Dialogue: 0,0:18:41.37,0:18:42.45,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:18:44.83,0:18:46.33,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:18:47.37,0:18:49.04,Default,,0,0,0,,Ишиши! Қабан!
Dialogue: 0,0:18:49.16,0:18:50.96,Default,,0,0,0,,Гаг Гекиджо әке!
Dialogue: 0,0:18:51.08,0:18:53.67,Default,,0,0,0,,Шутчо! Киттің жүрегіне!
Dialogue: 0,0:18:53.79,0:18:55.34,Default,,0,0,0,,Жоқ, бірақ сіз қиындыққа тап болдыңыз.
Dialogue: 0,0:18:55.46,0:18:56.42,Default,,0,0,0,,Кит ұясында
Dialogue: 0,0:18:56.55,0:18:58.67,Default,,0,0,0,,Мен сағат қанша екенін білмеймін.
Dialogue: 0,0:18:58.80,0:19:02.18,Default,,0,0,0,,Маған бұл туралы алаңдаудың қажеті жоқ, бірақ бұл жай киттер...
Dialogue: 0,0:19:02.30,0:19:04.05,Default,,0,0,0,,Әрқашан сағат 9!
Dialogue: 0,0:19:04.18,0:19:05.56,Default,,0,0,0,,Зукозукозуко!
Dialogue: 0,0:19:07.02,0:19:09.27,Default,,0,0,0,,Піл осындай, солай ма?
Dialogue: 0,0:19:09.39,0:19:11.81,Default,,0,0,0,,Бұл жолы да жақсы жүрмін.
Dialogue: 0,0:19:13.40,0:19:15.52,Default,,0,0,0,,Бұл не сұмдық?
Dialogue: 0,0:19:15.65,0:19:17.07,Default,,0,0,0,,Сайзансу
Dialogue: 0,0:19:18.86,0:19:21.66,Default,,0,0,0,,Бұлыңғырлықтың соңы. Бұл жираф!
Dialogue: 0,0:19:21.78,0:19:23.20,Default,,0,0,0,,Ал, келесі...
Dialogue: 0,0:19:23.32,0:19:24.58,Default,,0,0,0,,Онымен біттіңіз бе?
Dialogue: 0,0:19:25.78,0:19:28.00,Default,,0,0,0,,Мен көзілдірігімнен көрінбеймін!
Dialogue: 0,0:19:28.12,0:19:29.54,Default,,0,0,0,,Зукозукозуко
Dialogue: 0,0:19:30.08,0:19:33.67,Default,,0,0,0,,Бұл... Бұл линза берік!
Dialogue: 0,0:19:34.13,0:19:35.50,Default,,0,0,0,,Зукозукозуко О!
Dialogue: 0,0:19:35.63,0:19:38.26,Default,,0,0,0,,Маған бір ой келді! Нихинихихи!
Dialogue: 0,0:19:38.38,0:19:42.01,Default,,0,0,0,,Жағдайыңыз жақсы сияқты~
Dialogue: 0,0:19:52.85,0:19:54.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:55.69,0:19:58.94,Default,,0,0,0,,Міне! Сонымен, осылай...
Dialogue: 0,0:20:04.87,0:20:07.87,Default,,0,0,0,,Егер сіз бұл киттің жерге жақындағанын күтсеңіз...
Dialogue: 0,0:20:08.33,0:20:10.12,Default,,0,0,0,,Теңізде жүзуден гөрі
Dialogue: 0,0:20:10.25,0:20:13.54,Default,,0,0,0,,Бұл өте жылдам, ең бастысы, күн жарқырайды ...
Dialogue: 0,0:20:13.67,0:20:15.75,Default,,0,0,0,,Жұмыртқаны үлкен сегізаяқтан қорғай аласың ба?
Dialogue: 0,0:20:15.88,0:20:18.00,Default,,0,0,0,,Зоори мырза күткендей!
Dialogue: 0,0:20:18.13,0:20:21.63,Default,,0,0,0,,Біз бұл бағалы жұмыртқаны қандай жағдайда да қорғауымыз керек!
Dialogue: 0,0:20:21.76,0:20:23.38,Default,,0,0,0,,Балалар! (3 адам) А!?
Dialogue: 0,0:20:23.51,0:20:27.35,Default,,0,0,0,,Неліктен мұны қорғау үшін көп күш жұмсайсың?
Dialogue: 0,0:20:27.47,0:20:28.14,Default,,0,0,0,,Еркін!
Dialogue: 0,0:20:28.26,0:20:30.10,Default,,0,0,0,,Бұл... бұл
Dialogue: 0,0:20:30.52,0:20:31.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:31.89,0:20:34.73,Default,,0,0,0,,А... а...
Dialogue: 0,0:20:35.23,0:20:37.11,Default,,0,0,0,,Мен досыма уәде бердім!
Dialogue: 0,0:20:37.23,0:20:40.61,Default,,0,0,0,,Мен бұл жігітті аман-есен жіберемін!
Dialogue: 0,0:20:41.90,0:20:42.82,Default,,0,0,0,,-да? (3 адам) Ух
Dialogue: 0,0:20:43.45,0:20:45.07,Default,,0,0,0,,Бұл дос кім?
Dialogue: 0,0:20:45.86,0:20:46.99,Default,,0,0,0,,Гику…гику!
Dialogue: 0,0:20:47.70,0:20:49.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:49.79,0:20:52.70,Default,,0,0,0,,Әй, мен саған досымның атын айттым...
Dialogue: 0,0:20:52.83,0:20:54.58,Default,,0,0,0,,Сіз оның кім екенін білмейсіз бе?
Dialogue: 0,0:20:54.71,0:20:55.87,Default,,0,0,0,,О
Dialogue: 0,0:20:56.54,0:21:00.46,Default,,0,0,0,,Дүниеде осы жұмыртқаға ең көп қамқорлық жасайтын дос сенсің!
Dialogue: 0,0:21:01.96,0:21:04.17,Default,,0,0,0,,Сіз оны жемейтініңізге сенімдісіз бе?
Dialogue: 0,0:21:04.55,0:21:06.39,Default,,0,0,0,,Сіз мұны басынан бастап айттыңыз!
Dialogue: 0,0:21:06.55,0:21:08.97,Default,,0,0,0,,Бірақ мен «тамагоякиді» жақсы көремін.
Dialogue: 0,0:21:09.10,0:21:09.89,Default,,0,0,0,,Ga!
Dialogue: 0,0:21:10.81,0:21:14.06,Default,,0,0,0,,Гугаги~ Мен әлі де сене алар емеспін.
Dialogue: 0,0:21:14.18,0:21:15.52,Default,,0,0,0,,Сіз және сіздің достарыңыз...
Dialogue: 0,0:21:15.69,0:21:18.19,Default,,0,0,0,,Бұл жұмыртқаны жеуге және сындыруға болмайды.
Dialogue: 0,0:21:18.31,0:21:20.94,Default,,0,0,0,,Мен саған соңына дейін барамын!
Dialogue: 0,0:21:21.07,0:21:21.98,Default,,0,0,0,,Ха~
Dialogue: 0,0:21:22.73,0:21:25.45,Default,,0,0,0,,Неліктен сіз бұған ерекше назар аударасыз?
Dialogue: 0,0:21:25.99,0:21:27.70,Default,,0,0,0,,Мені олай атама!
Dialogue: 0,0:21:27.82,0:21:29.95,Default,,0,0,0,,Менің атым Дина!
Dialogue: 0,0:21:30.08,0:21:32.41,Default,,0,0,0,,Біз де «сіздер» емеспіз!
Dialogue: 0,0:21:32.58,0:21:33.79,Default,,0,0,0,,Біз Ишишиміз.
Dialogue: 0,0:21:33.91,0:21:35.00,Default,,0,0,0,,Ора Ношиши
Dialogue: 0,0:21:35.12,0:21:37.21,Default,,0,0,0,,Міне біз келдік.
Dialogue: 0,0:21:37.33,0:21:38.54,Default,,0,0,0,,Әлемге әйгілі
Dialogue: 0,0:21:38.67,0:21:40.46,Default,,0,0,0,,Бұл Зорори мырза!
Dialogue: 0,0:21:40.59,0:21:42.88,Default,,0,0,0,,Охон! Өздеріңіз білетіндей...
Dialogue: 0,0:21:43.01,0:21:44.88,Default,,0,0,0,,Кешіріңіз?
Dialogue: 0,0:21:45.38,0:21:48.22,Default,,0,0,0,,Мені қазіргі жағдайымнан басқа ештеңе қызықтырмайды.
Dialogue: 0,0:21:48.34,0:21:49.01,Default,,0,0,0,,Түс
Dialogue: 0,0:21:49.72,0:21:52.31,Default,,0,0,0,,Зорори сенси, сен Кёрюден жеңілдің.
Dialogue: 0,0:21:52.43,0:21:54.31,Default,,0,0,0,,Ааа хмм
Dialogue: 0,0:21:55.85,0:21:57.52,Default,,0,0,0,,Мен бұл кітапты алған кезден бері—
Dialogue: 0,0:21:58.23,0:22:00.48,Default,,0,0,0,,Менің өмірім қатты өзгерді!
Dialogue: 0,0:22:00.81,0:22:03.23,Default,,0,0,0,,Бүгінгі мектеп?
Dialogue: 0,0:22:05.11,0:22:07.24,Default,,0,0,0,,Мен кішкентай кезімде әлсіз болдым.
Dialogue: 0,0:22:08.07,0:22:10.28,Default,,0,0,0,,Мен үнемі үйде отырдым.
Dialogue: 0,0:22:11.49,0:22:13.58,Default,,0,0,0,,Бірақ бұл кітапқа қарасаңыз...
Dialogue: 0,0:22:14.33,0:22:16.58,Default,,0,0,0,,Азапты ұмыту мүмкіндігінен алыс -
Dialogue: 0,0:22:16.71,0:22:19.54,Default,,0,0,0,,Мен Кёрюмен және басқалармен бірге көптеген шытырман сапарларға шыға алдым.
Dialogue: 0,0:22:22.34,0:22:24.92,Default,,0,0,0,,Уау, неше түрлі нәрсе бар.
Dialogue: 0,0:22:25.59,0:22:27.92,Default,,0,0,0,,Кітапханаға қарағанша түсінбедім.
Dialogue: 0,0:22:28.05,0:22:29.22,Default,,0,0,0,,О, менің!
Dialogue: 0,0:22:29.34,0:22:32.35,Default,,0,0,0,,Ертеде айдаһарлардың көп болғаны рас.
Dialogue: 0,0:22:33.06,0:22:35.35,Default,,0,0,0,,Бірақ климаттың өзгеруі және жанартау белсенділігі
Dialogue: 0,0:22:35.47,0:22:37.27,Default,,0,0,0,,—
Dialogue: 0,0:22:37.39,0:22:40.06,Default,,0,0,0,,Енді ол жоғалып кетті дейді.
Dialogue: 0,0:22:40.44,0:22:43.32,Default,,0,0,0,,Егер солай болса, мені сіз де танисыз.
Dialogue: 0,0:22:43.44,0:22:45.03,Default,,0,0,0,,Бірақ бұл басқаша!
Dialogue: 0,0:22:45.15,0:22:47.57,Default,,0,0,0,,Кюрю ештеңе істеген жоқ!
Dialogue: 0,0:22:47.90,0:22:48.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:48.90,0:22:52.07,Default,,0,0,0,,Хахахаха... Теледидарды көп көрмейсіз бе?
Dialogue: 0,0:22:52.20,0:22:53.74,Default,,0,0,0,,Мынаны қара (3 адам) А?
Dialogue: 0,0:22:57.33,0:22:59.04,Default,,0,0,0,,Еркін!
Dialogue: 0,0:22:59.33,0:23:00.71,Default,,0,0,0,,Бұл біз
Dialogue: 0,0:23:00.83,0:23:02.33,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:23:02.46,0:23:06.13,Default,,0,0,0,,Мені құтқарған Кюрюді қорғағым келеді!
Dialogue: 0,0:23:06.92,0:23:10.38,Default,,0,0,0,,Егер олар шынымен де бір жерде өлмей аман қалса...
Dialogue: 0,0:23:11.05,0:23:13.14,Default,,0,0,0,,Мен сені қорғауым керек
Dialogue: 0,0:23:14.60,0:23:16.01,Default,,0,0,0,,Ата-анамның қарсылығына қарамастан...
Dialogue: 0,0:23:16.43,0:23:18.73,Default,,0,0,0,,Мен Чосаданға қосылдым.
Dialogue: 0,0:23:18.85,0:23:20.48,Default,,0,0,0,,Кюрючо Садан
Dialogue: 0,0:23:20.60,0:23:23.02,Default,,0,0,0,,Ал мен іздендім
Dialogue: 0,0:23:23.69,0:23:26.69,Default,,0,0,0,,Бірақ мен Chosa-ны бастағаннан кейін бір жыл өткен соң...
Dialogue: 0,0:23:26.98,0:23:30.32,Default,,0,0,0,,Данчо аңшылықтан бас тарту керек деп бастады...
Dialogue: 0,0:23:31.40,0:23:33.66,Default,,0,0,0,,Ал, сен... бірақ Дина...
Dialogue: 0,0:23:33.78,0:23:36.37,Default,,0,0,0,,Ол жоғалған жоқ...
Dialogue: 0,0:23:36.49,0:23:39.45,Default,,0,0,0,,Иә, мен өзімді Чосаданнан ажырата алдым.
Dialogue: 0,0:23:39.87,0:23:41.62,Default,,0,0,0,,Сізге рахмет, мен мұны таптым.
Dialogue: 0,0:23:42.25,0:23:45.09,Default,,0,0,0,,Бұл сөзсіз заманауи жұмыртқа.
Dialogue: 0,0:23:45.21,0:23:48.00,Default,,0,0,0,,Сондықтан мен аман-есен оралғанша не болса да...
Dialogue: 0,0:23:49.13,0:23:50.38,Default,,0,0,0,,Мен сені қорғаймын!
Dialogue: 0,0:23:50.76,0:23:53.22,Default,,0,0,0,,Мен аздап қобалжыдым.
Dialogue: 0,0:23:53.34,0:23:55.89,Default,,0,0,0,,Иә, бүгін терең күн емес пе?
Dialogue: 0,0:23:56.22,0:23:59.60,Default,,0,0,0,,Күткендей, мен сені Кёрюдің отбасымен кездестіруге рұқсат ете алмаймын.
Dialogue: 0,0:24:00.23,0:24:03.10,Default,,0,0,0,,Егер сіз жұмыртқаны қорғауға тырыссаңыз, бұл ыңғайлы.
Dialogue: 0,0:24:03.73,0:24:07.36,Default,,0,0,0,,Мен не болып жатқанын білмеймін, бірақ жұмыртқаны аман-есен алғанша...
Dialogue: 0,0:24:07.86,0:24:09.90,Default,,0,0,0,,Осыны тиімді пайдаланамыз
Dialogue: 0,0:24:10.03,0:24:13.24,Default,,0,0,0,,Хмф, мен өте жылымын.
Dialogue: 0,0:24:13.36,0:24:14.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:14.74,0:24:16.37,Default,,0,0,0,,Уау, эй!
Dialogue: 0,0:24:16.58,0:24:19.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:24:21.16,0:24:21.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:23.08,0:24:24.04,Default,,0,0,0,,Не?
Dialogue: 0,0:24:24.75,0:24:28.00,Default,,0,0,0,,О! Бұл жұқпалы ма?
Dialogue: 0,0:24:28.92,0:24:29.67,Default,,0,0,0,,Бұл сокухо
Dialogue: 0,0:24:30.42,0:24:32.72,Default,,0,0,0,,Бір жыл бұрын мен мемлекеттік туды сұрадым.
Dialogue: 0,0:24:32.88,0:24:35.34,Default,,0,0,0,,Бұл үлкен жоба болды, бірақ нәтижесі—
Dialogue: 0,0:24:35.47,0:24:37.64,Default,,0,0,0,,Іс күткендей болмаған сияқты.
Dialogue: 0,0:24:37.93,0:24:40.60,Default,,0,0,0,,Ах! Сол Чосадандар!
Dialogue: 0,0:24:40.72,0:24:41.81,Default,,0,0,0,,Тіпті оның есту қабілетінен айырылғаны туралы қауесет те бар
Dialogue: 0,0:24:42.27,0:24:44.44,Default,,0,0,0,,Біз де ұйықтадық...
Dialogue: 0,0:24:44.56,0:24:46.73,Default,,0,0,0,,Мен өз зерттеуімді орындадым.
Dialogue: 0,0:24:47.02,0:24:50.53,Default,,0,0,0,,Беймәлім дүниедегі тыңдаулар мен тыңдаулар тізбегі
Dialogue: 0,0:24:50.73,0:24:55.24,Default,,0,0,0,,Соңында мен тіпті қымбатты досымнан айырылдым.
Dialogue: 0,0:24:55.91,0:24:58.24,Default,,0,0,0,,Уау! Сүйкімді кішкентай қыз
Dialogue: 0,0:24:58.99,0:25:00.70,Default,,0,0,0,,Чосадан бөлініп шыққан бала
Dialogue: 0,0:25:00.83,0:25:03.71,Default,,0,0,0,,Әйгілі Шисанка, Саул әулетінің әкесі.
Dialogue: 0,0:25:03.83,0:25:07.08,Default,,0,0,0,,Амалсыз әрекеттерге қарамастан, ол әлі де хабарсыз.
Dialogue: 0,0:25:07.29,0:25:11.34,Default,,0,0,0,,Сәлем! Ол әдемі ғана емес, сонымен қатар бай әйел!
Dialogue: 0,0:25:11.46,0:25:15.05,Default,,0,0,0,,Мынау Дина жоқ па?
Dialogue: 0,0:25:15.18,0:25:18.26,Default,,0,0,0,,Жұмыртқа бос және тесігі болса...
Dialogue: 0,0:25:18.43,0:25:19.51,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:25:19.64,0:25:21.60,Default,,0,0,0,,Мен ол емес екеніне сенімдімін.
Dialogue: 0,0:25:21.72,0:25:25.14,Default,,0,0,0,,Жарайды, Дина жоғалып кетті деді.
Dialogue: 0,0:25:25.31,0:25:28.23,Default,,0,0,0,,Мен жоғалған басқа адамдар бар екеніне сенімдімін.
Dialogue: 0,0:25:28.36,0:25:29.27,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:25:29.40,0:25:31.78,Default,,0,0,0,,Олай болса, оны жеңілдететін уақыт емес.
Dialogue: 0,0:25:31.90,0:25:35.40,Default,,0,0,0,,Жұмыртқаны аман-есен жеткізгеннен кейін, баланың не істейтінін білудің уақыты келді!
Dialogue: 0,0:25:35.65,0:25:36.57,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:25:36.70,0:25:40.03,Default,,0,0,0,,Бұл жолы біз Оширо мен Ойоме-санды аламыз!
Dialogue: 0,0:25:40.24,0:25:41.24,Default,,0,0,0,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,0:25:43.83,0:25:45.75,Default,,0,0,0,,Ах! Мен жерді көрдім!
Dialogue: 0,0:25:45.87,0:25:47.71,Default,,0,0,0,,Сіз шыға аласыз!
Dialogue: 0,0:25:47.83,0:25:50.75,Default,,0,0,0,,Ишиши Енді менің орнымды ал
Dialogue: 0,0:25:50.88,0:25:55.34,Default,,0,0,0,,Ал... Жүгіру үшін алдымен киттің аузын ашу керек.
Dialogue: 0,0:25:55.72,0:25:56.55,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:25:56.68,0:25:57.88,Default,,0,0,0,,Ах! Не болды!?
Dialogue: 0,0:25:58.01,0:26:00.68,Default,,0,0,0,,Бұрынғы үлкен сегізаяқ мені қуып келеді!
Dialogue: 0,0:26:00.80,0:26:02.81,Default,,0,0,0,,Сәлем~ Бұл сегізаяқ!
Dialogue: 0,0:26:03.27,0:26:05.68,Default,,0,0,0,,Хмм... Жарайды!
Dialogue: 0,0:26:06.23,0:26:08.40,Default,,0,0,0,,Ишиши! Ношиши! Көмектесіңіздер!
Dialogue: 0,0:26:08.52,0:26:09.73,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:26:11.73,0:26:12.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:20.20,0:26:21.57,Default,,0,0,0,,Жарайды, дайын!
Dialogue: 0,0:26:21.91,0:26:23.70,Default,,0,0,0,,Дина! Сорғышты алып тастаңыз!
Dialogue: 0,0:26:24.08,0:26:25.62,Default,,0,0,0,,Ә!? Иә, иә
Dialogue: 0,0:26:31.79,0:26:34.42,Default,,0,0,0,,Ғажайып... көзді ашып-жұмғанша осындай нәрсе
Dialogue: 0,0:26:34.80,0:26:39.59,Default,,0,0,0,,Хэхе! Мен сияқты болмасаң да, сен үлкен құмырсқа жегішсің! Сіз үлкен құмырсқа жегішсіз!
Dialogue: 0,0:26:39.76,0:26:40.84,Default,,0,0,0,,Ишиши ношиши!
Dialogue: 0,0:26:41.26,0:26:42.10,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:26:42.26,0:26:44.01,Default,,0,0,0,,Пуф!
Dialogue: 0,0:26:47.52,0:26:48.48,Default,,0,0,0,,Хамф!?
Dialogue: 0,0:26:50.65,0:26:53.65,Default,,0,0,0,,Фуууууууууууууууууууууууу
Dialogue: 0,0:26:53.77,0:26:56.82,Default,,0,0,0,,Фуфуфуфуфу! Ха!
Dialogue: 0,0:26:58.19,0:26:58.95,Default,,0,0,0,,Бум!
Dialogue: 0,0:27:01.36,0:27:02.45,Default,,0,0,0,,Ишиши ношиши!
Dialogue: 0,0:27:02.74,0:27:04.20,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:27:04.49,0:27:07.33,Default,,0,0,0,,Жүр, кеттік, кеттік
Dialogue: 0,0:27:07.45,0:27:09.71,Default,,0,0,0,,Жүр, кеттік, кеттік, кеттік
Dialogue: 0,0:27:10.08,0:27:14.29,Default,,0,0,0,,Ухуху уху һухухухухухуху... иә
Dialogue: 0,0:27:14.42,0:27:16.42,Default,,0,0,0,,Фуфуфуфуфу!
Dialogue: 0,0:27:17.46,0:27:18.30,Default,,0,0,0,,Хехе
Dialogue: 0,0:27:18.88,0:27:22.30,Default,,0,0,0,,Они-сан міне, Сегізаяқ-сан міне
Dialogue: 0,0:27:22.43,0:27:26.72,Default,,0,0,0,,Сәлем! Хой! Хой!
Dialogue: 0,0:27:30.98,0:27:32.15,Default,,0,0,0,,Гу!
Dialogue: 0,0:27:34.65,0:27:35.65,Default,,0,0,0,,Ой... ой!
Dialogue: 0,0:27:37.78,0:27:39.86,Default,,0,0,0,,Жоқ! Ура!
Dialogue: 0,0:27:43.95,0:27:45.49,Default,,0,0,0,,Қазір! (Ишиши Ношиши) Сәлем!
Dialogue: 0,0:27:45.99,0:27:46.99,Default,,0,0,0,,Мені ұстаңыз!
Dialogue: 0,0:27:47.29,0:27:47.95,Default,,0,0,0,,Әй!
Dialogue: 0,0:27:48.58,0:27:49.45,Default,,0,0,0,,Иә
Dialogue: 0,0:27:51.50,0:27:52.25,Default,,0,0,0,,Пау!
Dialogue: 0,0:27:52.58,0:27:54.08,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:27:54.42,0:27:56.00,Default,,0,0,0,,Бұл керемет, Зори-сан!
Dialogue: 0,0:27:56.13,0:27:56.84,Default,,0,0,0,,Нху?
Dialogue: 0,0:27:57.25,0:27:58.34,Default,,0,0,0,,Қымбаттым, онша емес...
Dialogue: 0,0:27:58.46,0:28:01.80,Default,,0,0,0,,Алибаба ұлы құмырсқа және 40 адам! Не?
Dialogue: 0,0:28:01.93,0:28:02.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:03.47,0:28:04.05,Default,,0,0,0,,Ол шынымен де осал тұстары көп екен.
Dialogue: 0,0:28:04.22,0:28:06.10,Default,,0,0,0,,Зо... Зорори мырза!
Dialogue: 0,0:28:06.22,0:28:07.31,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:28:07.60,0:28:11.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:12.10,0:28:12.94,Default,,0,0,0,,Не~!?
Dialogue: 0,0:28:13.06,0:28:14.90,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:28:15.52,0:28:17.15,Default,,0,0,0,,Мені тартып жатыр!
Dialogue: 0,0:28:19.15,0:28:19.86,Default,,0,0,0,,Хмф!
Dialogue: 0,0:28:20.57,0:28:22.36,Default,,0,0,0,,Hmph
Dialogue: 0,0:28:22.53,0:28:26.74,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:28:27.12,0:28:28.62,Default,,0,0,0,,Ууууууууу
Dialogue: 0,0:28:29.29,0:28:30.70,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:30.83,0:28:33.92,Default,,0,0,0,,Дио…
Dialogue: 0,0:28:36.17,0:28:38.50,Default,,0,0,0,,Нашар! Мен сондай жерге түсіп қалсам ше?
Dialogue: 0,0:28:38.84,0:28:40.55,Default,,0,0,0,,Жұмыртқа жойылды!
Dialogue: 0,0:28:40.67,0:28:43.72,Default,,0,0,0,,Сондықтан да осылай қалса да...
Dialogue: 0,0:28:44.26,0:28:46.64,Default,,0,0,0,,Қалай болғанда да, бұл үлкен шымшу!
Dialogue: 0,0:28:46.76,0:28:50.89,Default,,0,0,0,,Иә! Мұндай кездер сенің еркелігің!
Dialogue: 0,0:28:51.02,0:28:52.73,Default,,0,0,0,,Кенеттен осылай айтсаң да
Dialogue: 0,0:28:52.85,0:28:54.73,Default,,0,0,0,,Сіз оны оңайлықпен бере алмайсыз.
Dialogue: 0,0:28:54.85,0:28:55.65,Default,,0,0,0,,Хан~н
Dialogue: 0,0:28:55.77,0:28:57.90,Default,,0,0,0,,Ухухухухуху
Dialogue: 0,0:28:58.02,0:28:59.48,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:28:59.98,0:29:01.15,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:29:02.82,0:29:04.07,Default,,0,0,0,,Уф... Ха!
Dialogue: 0,0:29:04.70,0:29:06.78,Default,,0,0,0,,Дағдарыс мүмкіндікке айналуы мүмкін!
Dialogue: 0,0:29:06.91,0:29:07.49,Default,,0,0,0,,О!
Dialogue: 0,0:29:08.41,0:29:10.62,Default,,0,0,0,,Барлығы, тартыңдар!
Dialogue: 0,0:29:10.74,0:29:12.95,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:29:15.00,0:29:16.29,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:29:16.46,0:29:17.83,Default,,0,0,0,,Ифуфу Ичи
Dialogue: 0,0:29:19.17,0:29:20.00,Default,,0,0,0,,Фуууууу
Dialogue: 0,0:29:20.63,0:29:21.55,Default,,0,0,0,,Иә
Dialogue: 0,0:29:22.21,0:29:26.38,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:29:33.98,0:29:35.39,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:29:35.52,0:29:36.98,Default,,0,0,0,,Керемет!
Dialogue: 0,0:29:37.10,0:29:38.94,Default,,0,0,0,,Ммм?
Dialogue: 0,0:29:39.40,0:29:40.77,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:29:40.90,0:29:44.19,Default,,0,0,0,,Балалар, енді ысырып не істейсіңдер?
Dialogue: 0,0:29:44.32,0:29:46.07,Default,,0,0,0,,Бұл біз емес!
Dialogue: 0,0:29:46.20,0:29:47.61,Default,,0,0,0,,Сонымен бұл ненің иісі?
Dialogue: 0,0:29:47.74,0:29:49.12,Default,,0,0,0,,Кункун
Dialogue: 0,0:29:49.24,0:29:52.12,Default,,0,0,0,,Бұл күкірт иісі... жанартау газы!
Dialogue: 0,0:29:52.62,0:29:53.95,Default,,0,0,0,,Жанартау газы!?
Dialogue: 0,0:30:03.63,0:30:06.26,Default,,0,0,0,,Түсіндім, бұл жанартаулық арал болды ма?
Dialogue: 0,0:30:06.38,0:30:09.14,Default,,0,0,0,,Кешіріңіз, жағымсыз иіс шыққан жанартаулық газ болды.
Dialogue: 0,0:30:09.47,0:30:12.72,Default,,0,0,0,,Түсінесіздер деп үміттенемін.
Dialogue: 0,0:30:12.85,0:30:16.31,Default,,0,0,0,,Ал сенің осарларың онша жаман емес.
Dialogue: 0,0:30:16.68,0:30:21.56,Default,,0,0,0,,Бұл туралы не деуге болады? Мен бұл таудан тезірек түсуім керек.
Dialogue: 0,0:30:21.69,0:30:24.36,Default,,0,0,0,,Жұмыртқалар осы сегізаяқ сияқты қайнап, көтеріледі!
Dialogue: 0,0:30:24.48,0:30:26.03,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:30:27.90,0:30:31.66,Default,,0,0,0,,Ааааааааааааааааааааааааааааа
Dialogue: 0,0:30:33.91,0:30:36.16,Default,,0,0,0,,Сіз аяғыңызды жұлып алдыңыз ба?
Dialogue: 0,0:30:36.29,0:30:37.21,Default,,0,0,0,,О
Dialogue: 0,0:30:38.37,0:30:40.83,Default,,0,0,0,,Жақсы иіс шығады! Эххе
Dialogue: 0,0:30:41.38,0:30:42.84,Default,,0,0,0,,Дәмді көрінеді~
Dialogue: 0,0:30:42.96,0:30:45.09,Default,,0,0,0,,Ол жерде де біреу болған сияқты.
Dialogue: 0,0:30:45.21,0:30:47.55,Default,,0,0,0,,Біреу бар деп естідім, бірақ дәмді көрінеді.
Dialogue: 0,0:30:47.92,0:30:49.55,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:30:49.68,0:30:52.22,Default,,0,0,0,,Сегізаяқтың аяғы жұлынса да, қайтадан өседі.
Dialogue: 0,0:30:52.35,0:30:53.68,Default,,0,0,0,,Шынымен!?
Dialogue: 0,0:30:53.81,0:30:54.56,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:30:55.18,0:30:58.06,Default,,0,0,0,,Мен зоологпын!
Dialogue: 0,0:30:58.35,0:31:01.65,Default,,0,0,0,,Егер өссе, осы аяқты ұстаңыз.
Dialogue: 0,0:31:01.77,0:31:04.27,Default,,0,0,0,,Тек аяғыңыз үшін алаңдамаңыз.
Dialogue: 0,0:31:04.40,0:31:06.28,Default,,0,0,0,,Уфуфу хехуфуфу
Dialogue: 0,0:31:06.40,0:31:08.70,Default,,0,0,0,,Жарайды, қазір таудан түсейік.
Dialogue: 0,0:31:08.82,0:31:10.57,Default,,0,0,0,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,0:31:18.04,0:31:18.91,Default,,0,0,0,,Сонымен, осы екі адамның қайсысы Стэнді қолданады?
Dialogue: 0,0:31:28.51,0:31:29.55,Default,,0,0,0,,Техникалық колледжде күтіп тұрған сиқыршыларды мүмкіндігінше үнсіз жойып жібергім келеді.
Dialogue: 0,0:31:30.01,0:31:30.68,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:31:32.47,0:31:34.93,Default,,0,0,0,,Укуку… уф…
Dialogue: 0,0:31:38.81,0:31:41.06,Default,,0,0,0,,Қарғыс атсын, о...
Dialogue: 0,0:31:42.52,0:31:43.94,Default,,0,0,0,,Мені Май деп атай бер.
Dialogue: 0,0:31:52.45,0:31:54.12,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:31:54.24,0:31:56.45,Default,,0,0,0,,Сіз бірдеңені тазалай алдыңыз ба?
Dialogue: 0,0:31:56.58,0:31:57.79,Default,,0,0,0,,Тек бекер
Dialogue: 0,0:31:57.91,0:31:58.95,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:31:59.29,0:32:00.79,Default,,0,0,0,,Сахна тұрғысынан алғанда, көріп тұрсың ғой—
Dialogue: 0,0:32:03.46,0:32:04.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:05.21,0:32:06.42,Default,,0,0,0,,Сен… сен сорлы! Қалай батылың жетті!
Dialogue: 0,0:32:06.96,0:32:07.80,Default,,0,0,0,,Иә!?
Dialogue: 0,0:32:08.42,0:32:10.01,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:32:12.05,0:32:13.68,Default,,0,0,0,,Хаа ха
Dialogue: 0,0:32:16.76,0:32:18.97,Default,,0,0,0,,Ха, жоқ!
Dialogue: 0,0:32:19.10,0:32:20.93,Default,,0,0,0,,(Бум!)
Dialogue: 0,0:32:21.06,0:32:24.27,Default,,0,0,0,,Ах! Осы уақытқа дейін жету үшін көп еңбек еттіңіз!
Dialogue: 0,0:32:24.40,0:32:27.40,Default,,0,0,0,,Кюрю Папа Кёрю Мама Ағайындылар
Dialogue: 0,0:32:27.52,0:32:29.86,Default,,0,0,0,,Мен... Менмін!
Dialogue: 0,0:32:29.98,0:32:31.99,Default,,0,0,0,,Зорори мырза! Қараңдар!
Dialogue: 0,0:32:32.11,0:32:33.03,Default,,0,0,0,,Эх!
Dialogue: 0,0:32:38.12,0:32:40.45,Default,,0,0,0,,Міне, солай!
Dialogue: 0,0:32:40.58,0:32:42.79,Default,,0,0,0,,Шығарылған жоқ
Dialogue: 0,0:32:42.91,0:32:45.50,Default,,0,0,0,,Дина да қауіпсіз! Тамаша болды!
Dialogue: 0,0:32:46.13,0:32:46.96,Default,,0,0,0,,Әй?
Dialogue: 0,0:32:49.75,0:32:50.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:50.96,0:32:53.13,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:32:59.14,0:33:00.43,Default,,0,0,0,,Бұл...
Dialogue: 0,0:33:03.73,0:33:05.23,Default,,0,0,0,,Ух... Гехогехогехо
Dialogue: 0,0:33:05.35,0:33:06.90,Default,,0,0,0,,Мен бұған шыдай алмаймын!
Dialogue: 0,0:33:07.02,0:33:10.27,Default,,0,0,0,,Бірақ ауылда жейтін нәрсе бар шығар!
Dialogue: 0,0:33:10.40,0:33:11.36,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:33:12.32,0:33:13.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:15.82,0:33:17.41,Default,,0,0,0,,Иә~
Dialogue: 0,0:33:19.99,0:33:21.04,Default,,0,0,0,,Ах
Dialogue: 0,0:33:26.46,0:33:28.25,Default,,0,0,0,,Шамамен жарты жыл бұрын
Dialogue: 0,0:33:28.46,0:33:32.17,Default,,0,0,0,,Осылайша адамдар соңғы уақытқа дейін сонда тұрған.
Dialogue: 0,0:33:33.01,0:33:35.93,Default,,0,0,0,,Онда тұрған адамдар қайда кетті?
Dialogue: 0,0:33:36.05,0:33:37.64,Default,,0,0,0,,Мен бұл туралы білмеймін, бірақ...
Dialogue: 0,0:33:37.93,0:33:41.26,Default,,0,0,0,,Ауылдың түкпір-түкпірінен жанартау газы атқылап жатыр.
Dialogue: 0,0:33:41.43,0:33:43.56,Default,,0,0,0,,Ол жанартау суымен жабылған...
Dialogue: 0,0:33:43.98,0:33:47.19,Default,,0,0,0,,Осындай дағдарыс кезінде олардың ауылды тастап кетуден басқа амалы қалмас па еді?
Dialogue: 0,0:33:47.60,0:33:50.77,Default,,0,0,0,,Хохо, ғалым күткендей.
Dialogue: 0,0:33:51.15,0:33:53.78,Default,,0,0,0,,Қалай болғанда да, осыншама жанартаулық газ болса...
Dialogue: 0,0:33:53.90,0:33:55.86,Default,,0,0,0,,Біз де ашуланамыз.
Dialogue: 0,0:33:56.11,0:33:58.20,Default,,0,0,0,,Бұл ауылда ұзақ тұрудың қажеті жоқ.
Dialogue: 0,0:33:58.32,0:33:59.16,Default,,0,0,0,,Иә
Dialogue: 0,0:33:59.78,0:34:01.16,Default,,0,0,0,,Нджама Иччо...
Dialogue: 0,0:34:02.24,0:34:04.33,Default,,0,0,0,,Көңіліңіз толқып тұр ма?
Dialogue: 0,0:34:05.04,0:34:07.58,Default,,0,0,0,,Жарайсыңдар! Тездетіп, материалдарды жинаңыз!
Dialogue: 0,0:34:07.71,0:34:08.46,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:34:08.88,0:34:10.67,Default,,0,0,0,,Уф ха ха ха
Dialogue: 0,0:34:11.25,0:34:13.13,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:34:17.38,0:34:18.34,Default,,0,0,0,,Эй!?
Dialogue: 0,0:34:18.47,0:34:22.60,Default,,0,0,0,,Жарайды, иә... Жарайды.
Dialogue: 0,0:34:26.98,0:34:28.60,Default,,0,0,0,,Керемет Зорори-сан!
Dialogue: 0,0:34:28.73,0:34:31.73,Default,,0,0,0,,Хен, таңғы ас алдында, бірақ таңғы ас жоқ.
Dialogue: 0,0:34:31.86,0:34:35.69,Default,,0,0,0,,Зоори мырза~! Мен жейтін бірдеңе таптым
Dialogue: 0,0:34:37.32,0:34:39.65,Default,,0,0,0,,Ах, Могумогу
Dialogue: 0,0:34:40.07,0:34:42.58,Default,,0,0,0,,Әй, бұл шырақ!
Dialogue: 0,0:34:42.99,0:34:46.04,Default,,0,0,0,,Осыншама жақсы тағам қалмайды.
Dialogue: 0,0:34:47.12,0:34:50.63,Default,,0,0,0,,Бұл бір нәрсеге пайдалы болуы мүмкін, сондықтан оны алайық.
Dialogue: 0,0:35:05.18,0:35:06.89,Default,,0,0,0,,Уа... Хмф!
Dialogue: 0,0:35:07.02,0:35:08.56,Default,,0,0,0,,О!
Dialogue: 0,0:35:11.69,0:35:13.31,Default,,0,0,0,,Жарайды, орындалды!
Dialogue: 0,0:35:17.74,0:35:21.24,Default,,0,0,0,,Жарайды, жарайды, жарайды!
Dialogue: 0,0:35:21.74,0:35:23.78,Default,,0,0,0,,Жарайды, жарайды!
Dialogue: 0,0:35:24.37,0:35:25.58,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:35:25.70,0:35:26.74,Default,,0,0,0,,Ишиши! Ношиши!
Dialogue: 0,0:35:27.41,0:35:30.96,Default,,0,0,0,,Есту қиын, сондықтан жай сөйлеңіз!
Dialogue: 0,0:35:31.08,0:35:32.71,Default,,0,0,0,,Біртүрлі дауыс!
Dialogue: 0,0:35:32.83,0:35:34.54,Default,,0,0,0,,Ха~ I~
Dialogue: 0,0:35:34.67,0:35:35.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:36.34,0:35:37.59,Default,,0,0,0,,Таку
Dialogue: 0,0:35:37.84,0:35:42.14,Default,,0,0,0,,Бірақ менің ойымша, газ есту қабілетімді нашарлатады.
Dialogue: 0,0:35:42.68,0:35:44.51,Default,,0,0,0,,Сақ болыңыз, әйтпесе
Dialogue: 0,0:35:44.64,0:35:45.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:52.15,0:35:57.73,Default,,0,0,0,,Жарайды, жарайды, жарайды, тоқта!
Dialogue: 0,0:36:00.03,0:36:02.70,Default,,0,0,0,,Барлығы жақсы ма? Кеттік!
Dialogue: 0,0:36:02.82,0:36:04.45,Default,,0,0,0,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,0:36:06.33,0:36:10.45,Default,,0,0,0,,Мүмкін адам күшінің орнына қозғалтқышы бар көлік жақсырақ болар еді.
Dialogue: 0,0:36:10.58,0:36:11.83,Default,,0,0,0,,Бұл оңай емес пе?
Dialogue: 0,0:36:12.71,0:36:14.58,Default,,0,0,0,,Менің ойымша, бұл жанартаулық газ.
Dialogue: 0,0:36:14.71,0:36:16.50,Default,,0,0,0,,Ауылда қалған Кинзокуруй —
Dialogue: 0,0:36:16.63,0:36:18.30,Default,,0,0,0,,Бәрі тоз-тоз болып қалды.
Dialogue: 0,0:36:19.13,0:36:21.30,Default,,0,0,0,,Егер ол жарамсыз болып қалса...
Dialogue: 0,0:36:21.42,0:36:22.72,Default,,0,0,0,,Бұл қиын, солай емес пе?
Dialogue: 0,0:36:22.84,0:36:26.43,Default,,0,0,0,,Дұрыс! Бұл жұмыртқаны қорғау үшін, сондықтан бар күшіңізді салыңыз!
Dialogue: 0,0:36:26.60,0:36:28.06,Default,,0,0,0,,Рюкайда!
Dialogue: 0,0:36:32.94,0:36:37.11,Default,,0,0,0,,Егер сіз оны басынан бастап ойласаңыз, тіпті ол қолмен жасалса да, бұл әлдеқайда оңай.
Dialogue: 0,0:36:37.48,0:36:38.52,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:36:39.94,0:36:42.95,Default,,0,0,0,,Жанартау газы сөніп, ауа райы жақсарды.
Dialogue: 0,0:36:43.74,0:36:44.86,Default,,0,0,0,,О, бұл рас!
Dialogue: 0,0:36:45.53,0:36:48.99,Default,,0,0,0,,Бірақ абай бол, аяғыңның астында тас бар!
Dialogue: 0,0:36:53.87,0:36:55.67,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,0:36:55.79,0:36:58.38,Default,,0,0,0,,Сәлем! Уф
Dialogue: 0,0:36:59.05,0:36:59.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:37:03.76,0:37:06.93,Default,,0,0,0,,Иә! Ол тасқа толы, солай емес пе?
Dialogue: 0,0:37:07.05,0:37:10.06,Default,,0,0,0,,Иван мұнда жоқ. Иванмен бірге болыңыз!
Dialogue: 0,0:37:10.18,0:37:11.77,Default,,0,0,0,,Каку Зори-сан!
Dialogue: 0,0:37:13.77,0:37:14.94,Default,,0,0,0,,Мына жерде аң бар!
Dialogue: 0,0:37:15.69,0:37:16.52,Default,,0,0,0,,Ах
Dialogue: 0,0:37:17.86,0:37:21.11,Default,,0,0,0,,Ха... Басқа жол жоқ деп ойлаймын.
Dialogue: 0,0:37:21.23,0:37:22.90,Default,,0,0,0,,Менің үңгірге кіруден басқа амалым жоқ!
Dialogue: 0,0:37:35.58,0:37:37.38,Default,,0,0,0,,Нашар жүру
Dialogue: 0,0:37:37.92,0:37:41.00,Default,,0,0,0,,Арбаны аударып алмау үшін абай болыңыз! Жақсы!
Dialogue: 0,0:37:41.13,0:37:42.38,Default,,0,0,0,,жоғары!
Dialogue: 0,0:37:44.67,0:37:46.51,Default,,0,0,0,,Ха! Тағы да!
Dialogue: 0,0:37:46.72,0:37:49.39,Default,,0,0,0,,Біз құлыптаулымыз ба!?
Dialogue: 0,0:37:49.51,0:37:50.05,Default,,0,0,0,,Уф
Dialogue: 0,0:37:50.93,0:37:53.22,Default,,0,0,0,,Бұл аралдағы жанартаулық белсенділікке байланысты ма?
Dialogue: 0,0:37:54.39,0:37:56.89,Default,,0,0,0,,Бірақ мұндай нәрсе болған жоқ.
Dialogue: 0,0:37:57.85,0:37:59.52,Default,,0,0,0,,Жарқанатқа ұқсайды екен?
Dialogue: 0,0:37:59.69,0:38:01.77,Default,,0,0,0,,Арқам – үйім.
Dialogue: 0,0:38:03.82,0:38:04.90,Default,,0,0,0,,Жарайсыңдар! (Ишиши Ношиши) Хаа~
Dialogue: 0,0:38:10.83,0:38:13.83,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:38:14.45,0:38:16.79,Default,,0,0,0,,Мен шаршадым, ыстыққа малындым.
Dialogue: 0,0:38:17.75,0:38:20.88,Default,,0,0,0,,Сіздің қызуыңыздың көтерілуінің жалғыз себебі бұл емес сияқты.
Dialogue: 0,0:38:24.05,0:38:26.97,Default,,0,0,0,,Джоки әр жерден шығып жатыр!
Dialogue: 0,0:38:27.09,0:38:29.18,Default,,0,0,0,,Бұл соншалықты ыстық болғаны таңқаларлық емес.
Dialogue: 0,0:38:29.89,0:38:31.68,Default,,0,0,0,,Мен бұл жерден тез кетуім керек.
Dialogue: 0,0:38:31.80,0:38:34.68,Default,,0,0,0,,Бұлай жалғаса берсе, жұмыртқа жұлынады.
Dialogue: 0,0:38:35.43,0:38:36.14,Default,,0,0,0,,Не!?
Dialogue: 0,0:38:37.48,0:38:39.02,Default,,0,0,0,,Қай жолмен жүруім керек?
Dialogue: 0,0:38:39.40,0:38:42.15,Default,,0,0,0,,Уау... бұл күрделі~
Dialogue: 0,0:38:42.48,0:38:44.82,Default,,0,0,0,,Зори-сан, жарықты Тенджоға бағыттаңыз.
Dialogue: 0,0:38:45.19,0:38:46.44,Default,,0,0,0,,Не? Ол жоғарыда
Dialogue: 0,0:38:46.57,0:38:47.57,Default,,0,0,0,,Иә? О
Dialogue: 0,0:38:48.53,0:38:49.74,Default,,0,0,0,,(Кики~цу)
Dialogue: 0,0:38:49.86,0:38:52.70,Default,,0,0,0,,Сәлем! Жарғанат!
Dialogue: 0,0:38:55.49,0:38:58.12,Default,,0,0,0,,Бізге жазылыңыз! Міндетті түрде шығу жолы бар!
Dialogue: 0,0:38:58.25,0:38:59.17,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:39:04.80,0:39:05.96,Default,,0,0,0,,О, жарық!
Dialogue: 0,0:39:06.09,0:39:08.55,Default,,0,0,0,,Шығу! Бұл пайдалы болды
Dialogue: 0,0:39:09.30,0:39:10.51,Default,,0,0,0,,Динаға рахмет!
Dialogue: 0,0:39:11.14,0:39:13.22,Default,,0,0,0,,Зоолог үшін бұл анық.
Dialogue: 0,0:39:13.64,0:39:15.01,Default,,0,0,0,,Бұл дәмді~
Dialogue: 0,0:39:15.14,0:39:17.39,Default,,0,0,0,,Бұл сол жақсы әулеттен шыққан кемпір болса...
Dialogue: 0,0:39:17.52,0:39:22.19,Default,,0,0,0,,Қызым Кохоға берсем ғой.
Dialogue: 0,0:39:22.31,0:39:23.15,Default,,0,0,0,,Не?
Dialogue: 0,0:39:23.27,0:39:25.90,Default,,0,0,0,,А, жоқ, ештеңе, ештеңе.
Dialogue: 0,0:39:26.03,0:39:28.11,Default,,0,0,0,,Енді ары қарай жүрейік!
Dialogue: 0,0:39:32.16,0:39:33.49,Default,,0,0,0,,А... а?
Dialogue: 0,0:39:34.62,0:39:37.20,Default,,0,0,0,,Мынау ненің қарасы?
Dialogue: 0,0:39:38.25,0:39:40.62,Default,,0,0,0,,Бұл болар ма…
Dialogue: 0,0:39:41.46,0:39:46.17,Default,,0,0,0,,Уншо! Уншо! Уншо!
Dialogue: 0,0:39:46.30,0:39:49.88,Default,,0,0,0,,Уншо! Уншо!
Dialogue: 0,0:39:50.01,0:39:51.80,Default,,0,0,0,,Уншо!
Dialogue: 0,0:39:51.93,0:39:55.26,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:39:56.64,0:39:57.89,Default,,0,0,0,,Хаа~
Dialogue: 0,0:39:58.02,0:39:59.77,Default,,0,0,0,,Менің бағалы шайнегіме не істеп жатырсың?
Dialogue: 0,0:39:59.89,0:40:00.56,Default,,0,0,0,,Не?
Dialogue: 0,0:40:01.35,0:40:04.77,Default,,0,0,0,,Рак ағып, үлкен ағаш көмірге айналды!
Dialogue: 0,0:40:05.27,0:40:06.69,Default,,0,0,0,,Юган?
Dialogue: 0,0:40:06.82,0:40:08.90,Default,,0,0,0,,Айналаңа, қара (үш адам)?
Dialogue: 0,0:40:10.28,0:40:12.11,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:40:12.24,0:40:15.62,Default,,0,0,0,,Бүкіл шоколад сияқты.
Dialogue: 0,0:40:16.28,0:40:18.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:18.29,0:40:19.83,Default,,0,0,0,,Ношиши, сен не істеп жатырсың?
Dialogue: 0,0:40:19.95,0:40:22.29,Default,,0,0,0,,Йоган йоканде дейді.
Dialogue: 0,0:40:22.42,0:40:23.37,Default,,0,0,0,,Бұл жақсы емес!
Dialogue: 0,0:40:23.50,0:40:24.08,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:40:24.75,0:40:25.75,Default,,0,0,0,,Анада
Dialogue: 0,0:40:25.88,0:40:28.34,Default,,0,0,0,,Барлық жерде бос орындар бар.
Dialogue: 0,0:40:28.75,0:40:31.67,Default,,0,0,0,,Сіз тұрған жерде ағаштар өскен.
Dialogue: 0,0:40:31.80,0:40:33.13,Default,,0,0,0,,Ағаш!?
Dialogue: 0,0:40:33.43,0:40:37.18,Default,,0,0,0,,Бұл жер жанартау соққанға дейін бай орман болған сияқты.
Dialogue: 0,0:40:37.89,0:40:42.73,Default,,0,0,0,,Бірақ тезектен аққан лай орманды бұршақ өскінімен тез басып қалды.
Dialogue: 0,0:40:42.85,0:40:46.31,Default,,0,0,0,,Неге екені белгісіз, кенеттен денем суып кетті...
Dialogue: 0,0:40:46.44,0:40:48.15,Default,,0,0,0,,Сен осылай қалдың.
Dialogue: 0,0:40:48.27,0:40:49.98,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:40:50.11,0:40:52.45,Default,,0,0,0,,Біз көтерілген бұл шұңқыр...
Dialogue: 0,0:40:52.78,0:40:55.20,Default,,0,0,0,,Бұл ең үлкен ағаш еді...
Dialogue: 0,0:40:55.32,0:40:58.45,Default,,0,0,0,,Осылайша жанбай көмір болып қалды.
Dialogue: 0,0:40:58.78,0:41:00.83,Default,,0,0,0,,Дина білімді!
Dialogue: 0,0:41:00.95,0:41:03.00,Default,,0,0,0,,Бұл жай ғана Кёрю емес.
Dialogue: 0,0:41:03.12,0:41:05.67,Default,,0,0,0,,Бұл да Кёрюдың арқасында.
Dialogue: 0,0:41:06.46,0:41:08.71,Default,,0,0,0,,Инелік қай жерде тіршілік етуі мүмкін?
Dialogue: 0,0:41:08.84,0:41:11.76,Default,,0,0,0,,Өйткені ол әр түрлі сұмдық орынға айналады.
Dialogue: 0,0:41:11.88,0:41:13.38,Default,,0,0,0,,Мен оны табиғи түрде үйрендім.
Dialogue: 0,0:41:13.72,0:41:16.30,Default,,0,0,0,,Эй, бұл Кёрю-сама.
Dialogue: 0,0:41:16.43,0:41:17.34,Default,,0,0,0,,Иә!
Dialogue: 0,0:41:18.10,0:41:21.06,Default,,0,0,0,,Міне, ағаш өскен жер.
Dialogue: 0,0:41:21.93,0:41:22.81,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:41:22.93,0:41:25.23,Default,,0,0,0,,Ах! Аха! Аха! Ыстық!
Dialogue: 0,0:41:25.81,0:41:27.65,Default,,0,0,0,,Онсен қайнап жатыр!?
Dialogue: 0,0:41:27.77,0:41:29.69,Default,,0,0,0,,Жоғарыдағы ісік салқындап, қатып қалды, бірақ...
Dialogue: 0,0:41:29.82,0:41:32.40,Default,,0,0,0,,Асты әлі ыстық!
Dialogue: 0,0:41:33.57,0:41:35.49,Default,,0,0,0,,Тезірек бұл жерден кет!
Dialogue: 0,0:41:35.61,0:41:37.24,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:41:37.70,0:41:41.29,Default,,0,0,0,,Тағы да жұмыртқа үлкен шымшуда!
Dialogue: 0,0:41:42.79,0:41:43.75,Default,,0,0,0,,Уф!
Dialogue: 0,0:41:45.87,0:41:49.04,Default,,0,0,0,,Мынау - шіркін!
Dialogue: 0,0:41:52.09,0:41:54.26,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:41:55.55,0:41:59.26,Default,,0,0,0,,Уау, тоқта! Тоқта!
Dialogue: 0,0:42:00.10,0:42:01.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:01.51,0:42:02.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:03.35,0:42:04.93,Default,,0,0,0,,Не болды?
Dialogue: 0,0:42:05.06,0:42:06.27,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:42:07.02,0:42:10.11,Default,,0,0,0,,Бұл жолы өте өткір жартас жол.
Dialogue: 0,0:42:11.19,0:42:13.07,Default,,0,0,0,,Қандай арал!
Dialogue: 0,0:42:15.49,0:42:16.82,Default,,0,0,0,,Хмм...
Dialogue: 0,0:42:17.11,0:42:18.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:42:21.12,0:42:24.16,Default,,0,0,0,,Ку…ку…
Dialogue: 0,0:42:24.62,0:42:28.37,Default,,0,0,0,,Укукуку…
Dialogue: 0,0:42:31.79,0:42:33.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:42:33.59,0:42:35.63,Default,,0,0,0,,Хмм, ұстаңыз!
Dialogue: 0,0:42:36.26,0:42:38.30,Default,,0,0,0,,Әрбір қадам маңызды.
Dialogue: 0,0:42:39.05,0:42:40.68,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:42:43.64,0:42:48.10,Default,,0,0,0,,Хаа... хаа... хаа... хаа...
Dialogue: 0,0:42:56.49,0:42:59.11,Default,,0,0,0,,Жоқ! Бұл дыбыс? аа!
Dialogue: 0,0:42:59.86,0:43:01.41,Default,,0,0,0,,Ия, бұл өзен!
Dialogue: 0,0:43:01.53,0:43:04.03,Default,,0,0,0,,Өзеннен түссең, теңізге міндетті түрде жетесің!
Dialogue: 0,0:43:04.54,0:43:06.12,Default,,0,0,0,,А... Бұл рас!
Dialogue: 0,0:43:06.25,0:43:07.50,Default,,0,0,0,,Мен өзеннің дыбысын естимін!
Dialogue: 0,0:43:08.12,0:43:10.87,Default,,0,0,0,,Біз жанартаудан құтыла аламыз!
Dialogue: 0,0:43:11.00,0:43:13.92,Default,,0,0,0,,Көп уақыт өтті.
Dialogue: 0,0:43:14.25,0:43:14.88,Default,,0,0,0,,Не!?
Dialogue: 0,0:43:24.60,0:43:26.43,Default,,0,0,0,,Сіз шынымен осы жерден өткіңіз келе ме?
Dialogue: 0,0:43:26.56,0:43:28.52,Default,,0,0,0,,Басқа көпір жоқ сияқты.
Dialogue: 0,0:43:29.35,0:43:30.56,Default,,0,0,0,,Тек аспалы көпірлер үшін —
Dialogue: 0,0:43:30.69,0:43:34.06,Default,,0,0,0,,Өткенде бет-ауыз дірілдейді~
Dialogue: 0,0:43:48.83,0:43:52.50,Default,,0,0,0,,Уф... уф... фуу... уф
Dialogue: 0,0:44:03.39,0:44:05.72,Default,,0,0,0,,Қарғыс атсын! Нашар, қайтайық!
Dialogue: 0,0:44:05.85,0:44:07.47,Default,,0,0,0,,жоғары!
Dialogue: 0,0:44:09.52,0:44:10.60,Default,,0,0,0,,Кяах! (Ишиши Ношиши) Уау!
Dialogue: 0,0:44:11.31,0:44:14.06,Default,,0,0,0,,Барлығына! Жұмыртқаны қорғаңыз!
Dialogue: 0,0:44:14.94,0:44:16.02,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:44:22.03,0:44:23.82,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:44:24.16,0:44:27.66,Default,,0,0,0,,Керемет! Өте ыстық!
Dialogue: 0,0:44:28.08,0:44:30.41,Default,,0,0,0,,Сіз оны тастап кетуге қалай батылсыз!
Dialogue: 0,0:44:31.08,0:44:33.33,Default,,0,0,0,,Зоори мырза...хехе
Dialogue: 0,0:44:35.79,0:44:38.46,Default,,0,0,0,,Шықыр! Ишиши! Ношиши!
Dialogue: 0,0:44:38.84,0:44:40.34,Default,,0,0,0,,Тезірек төмен түсіп,
Dialogue: 0,0:44:40.46,0:44:43.38,Default,,0,0,0,,Мен оның орнына жастық ретінде пайдалану үшін бірдеңе жасадым!
Dialogue: 0,0:44:43.51,0:44:45.09,Default,,0,0,0,,жоғары!
Dialogue: 0,0:44:46.05,0:44:48.76,Default,,0,0,0,,Ух...
Dialogue: 0,0:44:49.18,0:44:51.93,Default,,0,0,0,,Жастық ретінде қолдануға болатын жалғыз нәрсе - сабан.
Dialogue: 0,0:44:52.06,0:44:55.06,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:44:55.19,0:44:57.31,Default,,0,0,0,,Оядзи Гаг Сіз оны өткізіп жібересіз бе!?
Dialogue: 0,0:44:57.44,0:44:58.40,Default,,0,0,0,,Мен олай айтқан жоқпын.
Dialogue: 0,0:44:58.86,0:45:02.74,Default,,0,0,0,,Қарғыс атсын! Ишиши Ношиши асығыңыз!
Dialogue: 0,0:45:03.11,0:45:04.86,Default,,0,0,0,,Тек сабан жинаңыз!
Dialogue: 0,0:45:04.99,0:45:06.16,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:45:07.20,0:45:08.58,Default,,0,0,0,,Иә, резеңке қайық!
Dialogue: 0,0:45:09.20,0:45:12.50,Default,,0,0,0,,Ношиши Резеңке қайықты үрлеңіз!
Dialogue: 0,0:45:13.37,0:45:16.67,Default,,0,0,0,,У-у-у-у
Dialogue: 0,0:45:18.67,0:45:20.67,Default,,0,0,0,,Керемет! Керемет! Хмм
Dialogue: 0,0:45:21.09,0:45:22.76,Default,,0,0,0,,Куку Кукуу!
Dialogue: 0,0:45:22.88,0:45:27.26,Default,,0,0,0,,Уу-у-у-у-у-у-у-у-у-у-у-у-у-у-у-у-у-у-у-у-у-у-у-у------
Dialogue: 0,0:45:27.39,0:45:29.26,Default,,0,0,0,,У-у-у-у
Dialogue: 0,0:45:31.31,0:45:33.89,Default,,0,0,0,,Уф, жоқ! Өтінемін тоқта!
Dialogue: 0,0:45:34.02,0:45:36.94,Default,,0,0,0,,У-у-у-у
Dialogue: 0,0:45:37.44,0:45:39.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:39.90,0:45:43.28,Default,,0,0,0,,Ах! Зорори мырза!
Dialogue: 0,0:45:43.40,0:45:46.41,Default,,0,0,0,,Ишиши Ношиши және Кёрю отбасылары
Dialogue: 0,0:45:46.53,0:45:48.74,Default,,0,0,0,,Кешіріңіз, бәрі осы.
Dialogue: 0,0:45:49.24,0:45:53.08,Default,,0,0,0,,Уәдеде тұра алмағаным үшін кешірім сұраймын.
Dialogue: 0,0:45:53.20,0:45:55.08,Default,,0,0,0,,Уәде бер! Жұмыртқа да!
Dialogue: 0,0:45:55.21,0:45:58.50,Default,,0,0,0,,Оны бірге қорғайық!
Dialogue: 0,0:45:58.67,0:46:01.17,Default,,0,0,0,,Фарт!
Dialogue: 0,0:46:03.96,0:46:04.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:46:04.97,0:46:07.22,Default,,0,0,0,,Чуунара
Dialogue: 0,0:46:09.60,0:46:11.72,Default,,0,0,0,,Міне
Dialogue: 0,0:46:13.64,0:46:16.06,Default,,0,0,0,,Бұл үлкен! Ишиши! Ношиши!
Dialogue: 0,0:46:16.52,0:46:18.31,Default,,0,0,0,,Біз мұны жасадық!
Dialogue: 0,0:46:18.44,0:46:19.27,Default,,0,0,0,,Не!
Dialogue: 0,0:46:19.40,0:46:21.15,Default,,0,0,0,,Не болды?
Dialogue: 0,0:46:21.27,0:46:22.90,Default,,0,0,0,,Ахам! Дұрыс!
Dialogue: 0,0:46:23.07,0:46:25.53,Default,,0,0,0,,Сізге түсіндірейін!
Dialogue: 0,0:46:26.15,0:46:27.99,Default,,0,0,0,,Біріншіден, үлкен фарт...
Dialogue: 0,0:46:28.11,0:46:29.49,Default,,0,0,0,,Бұл оссық!
Dialogue: 0,0:46:29.62,0:46:33.79,Default,,0,0,0,,Жұмыртқаны ауада қалқып жіберіңіз, содан кейін орташа өлшемді фарт шығарыңыз ...
Dialogue: 0,0:46:33.91,0:46:35.54,Default,,0,0,0,,Егер бұл рас болса!
Dialogue: 0,0:46:35.66,0:46:39.63,Default,,0,0,0,,Жұмыртқаның орнын реттегеннен кейін, ақырғы нәтиже - кішкентай, жұмсақ фарт.
Dialogue: 0,0:46:39.75,0:46:41.13,Default,,0,0,0,,Міне.
Dialogue: 0,0:46:41.25,0:46:43.21,Default,,0,0,0,,Ақырын қонды
Dialogue: 0,0:46:43.34,0:46:46.17,Default,,0,0,0,,Сонымен! жақсы!
Dialogue: 0,0:46:47.22,0:46:48.34,Default,,0,0,0,,Керемет!
Dialogue: 0,0:46:48.47,0:46:51.18,Default,,0,0,0,,Бүгінгі озық фарт техникасы!
Dialogue: 0,0:46:51.30,0:46:55.14,Default,,0,0,0,,Хаа~ Уайымдама, мен күшімді мүлде жоғалттым.
Dialogue: 0,0:46:55.89,0:46:57.39,Default,,0,0,0,,Жақында күн шығады
Dialogue: 0,0:46:57.52,0:47:00.06,Default,,0,0,0,,Қараңғы түскенде өзенге түсу қауіпті.
Dialogue: 0,0:47:00.52,0:47:02.36,Default,,0,0,0,,Жоқ! Қараңғыда -
Dialogue: 0,0:47:02.48,0:47:05.78,Default,,0,0,0,,Жұмыртқаны тасқа соқсаң, бәрі бітті.
Dialogue: 0,0:47:06.19,0:47:09.91,Default,,0,0,0,,Жарайды, мен газ шығып жатқан тесікті таба алмаймын.
Dialogue: 0,0:47:10.03,0:47:11.78,Default,,0,0,0,,Күйкейге жаман емес.\NЕгер бұл
Dialogue: 0,0:47:12.20,0:47:14.24,Default,,0,0,0,,болса, бұл сенімді нәрсе! Эххе
Dialogue: 0,0:47:22.25,0:47:26.26,Default,,0,0,0,,Ертең өзен жағасында сегізаяқтың аяғын жеу арқылы бар күшімді саламын.
Dialogue: 0,0:47:29.17,0:47:32.30,Default,,0,0,0,,Бірақ бүгін ұзақ күн болды.
Dialogue: 0,0:47:32.43,0:47:35.06,Default,,0,0,0,,Жоқ! Мына жаққа, мына жаққа...
Dialogue: 0,0:47:35.18,0:47:36.60,Default,,0,0,0,,Басым айналып кете жаздады.
Dialogue: 0,0:47:36.72,0:47:38.06,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:47:38.52,0:47:42.27,Default,,0,0,0,,Айтпақшы, Зоори мырза, Дина бұдан былай не істейді?
Dialogue: 0,0:47:42.40,0:47:45.11,Default,,0,0,0,,Жоқ! Мен Кёрюны қанша жақсы көрсем де...
Dialogue: 0,0:47:45.23,0:47:48.28,Default,,0,0,0,,Мен сені Кёрюдің отбасымен кездестіруге рұқсат ете алмаймын.
Dialogue: 0,0:47:48.40,0:47:49.95,Default,,0,0,0,,Рэм де көмектеседі.
Dialogue: 0,0:47:50.07,0:47:52.86,Default,,0,0,0,,Бұл аралдан аман-есен кету уақыты келгенде...
Dialogue: 0,0:47:53.03,0:47:55.87,Default,,0,0,0,,Мен алдап, қоштасамын.
Dialogue: 0,0:47:56.24,0:47:57.95,Default,,0,0,0,,Сіз оны артта қалдырасыз ба?
Dialogue: 0,0:47:58.08,0:48:00.87,Default,,0,0,0,,Бастапқыда сол жерде тұрған адамдар қаша бастады.
Dialogue: 0,0:48:01.00,0:48:02.67,Default,,0,0,0,,Мен сені бұл жерде қыдыруға рұқсат етпеймін.
Dialogue: 0,0:48:02.79,0:48:05.17,Default,,0,0,0,,Тыныш! даусыңыз үлкен
Dialogue: 0,0:48:05.29,0:48:07.17,Default,,0,0,0,,Бұл аз ғана күн.
Dialogue: 0,0:48:07.30,0:48:09.63,Default,,0,0,0,,Біз жоқпыз...
Dialogue: 0,0:48:09.76,0:48:12.63,Default,,0,0,0,,Біз де қартты табуымыз керек, солай ма?
Dialogue: 0,0:48:13.09,0:48:14.05,Default,,0,0,0,,Иә
Dialogue: 0,0:48:16.10,0:48:18.47,Default,,0,0,0,,Мен оны орындағаннан кейін де аламын.
Dialogue: 0,0:48:18.60,0:48:22.69,Default,,0,0,0,,Түсіндім! Зорори-сенсиде де осындай нәрсе болған!
Dialogue: 0,0:48:22.81,0:48:24.56,Default,,0,0,0,,Олай болса, жасайық!
Dialogue: 0,0:48:24.69,0:48:26.44,Default,,0,0,0,,Барлығын шеңберде ұстау үшін.
Dialogue: 0,0:48:26.57,0:48:28.78,Default,,0,0,0,,Мен бұл жерде шыдамдылық танытып, сізді күтуім керек.
Dialogue: 0,0:48:47.25,0:48:49.25,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:48:49.80,0:48:52.09,Default,,0,0,0,,Сіз білмей жатып ұйықтап қалдыңыз ба?
Dialogue: 0,0:48:52.92,0:48:54.22,Default,,0,0,0,,Бұл Дина ма?
Dialogue: 0,0:48:56.01,0:48:58.76,Default,,0,0,0,,Мен оны жалғыз көтере алмаймын ғой.
Dialogue: 0,0:48:58.89,0:49:00.27,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,0:49:07.31,0:49:08.73,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:49:10.44,0:49:11.44,Default,,0,0,0,,Ha
Dialogue: 0,0:49:18.45,0:49:20.87,Default,,0,0,0,,Өте сүйкімді!
Dialogue: 0,0:49:21.16,0:49:25.54,Default,,0,0,0,,Дәл сол қыз жоғалуы керек еді!
Dialogue: 0,0:49:27.13,0:49:29.54,Default,,0,0,0,,Мен сені мұндай жерде кездестіремін деп ойламаппын.
Dialogue: 0,0:49:29.88,0:49:32.51,Default,,0,0,0,,Сіз бұл аралға Кюрюді қуып келдіңіз бе?
Dialogue: 0,0:49:32.63,0:49:35.68,Default,,0,0,0,,Әлде мені аралдан тауып, артымнан келдің бе?
Dialogue: 0,0:49:35.80,0:49:38.39,Default,,0,0,0,,Екеуің де ғашық болдыңдар.
Dialogue: 0,0:49:38.51,0:49:41.72,Default,,0,0,0,,Ой, айтпақшы, Дина қайда?
Dialogue: 0,0:49:44.02,0:49:46.69,Default,,0,0,0,,Мынау Динаның киімі... Аа!?
Dialogue: 0,0:49:47.10,0:49:49.90,Default,,0,0,0,,Суда қалқып жүрген қыз – жоғалған қыз.
Dialogue: 0,0:49:50.02,0:49:51.36,Default,,0,0,0,,Бірақ киімдер осында...
Dialogue: 0,0:49:51.48,0:49:54.19,Default,,0,0,0,,Сонымен суда жүзіп жүрген Дина...
Dialogue: 0,0:49:54.32,0:49:55.70,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:49:57.32,0:49:59.70,Default,,0,0,0,,Оған еш күмәнім жоқ, бұл сол қыз.
Dialogue: 0,0:50:00.20,0:50:04.58,Default,,0,0,0,,Бұл жоғалған әке Дина дегенді білдіре ме?!
Dialogue: 0,0:50:04.71,0:50:09.08,Default,,0,0,0,,Біз бұрыннан кездескенбіз, солай емес пе?
Dialogue: 0,0:50:11.09,0:50:13.34,Default,,0,0,0,,Енді, уайымдамаңыз.
Dialogue: 0,0:50:13.46,0:50:14.76,Default,,0,0,0,,Бұл ақылсыз нәрсе...
Dialogue: 0,0:50:14.88,0:50:17.68,Default,,0,0,0,,Қартты аман-есен құтқардық.
Dialogue: 0,0:50:17.80,0:50:20.76,Default,,0,0,0,,О... Зори-сан, рахмет!
Dialogue: 0,0:50:20.89,0:50:22.93,Default,,0,0,0,,Қалай сәлем беруге болады?
Dialogue: 0,0:50:23.68,0:50:24.64,Default,,0,0,0,,Мен көптен бері өлі болсам да
Dialogue: 0,0:50:25.77,0:50:27.85,Default,,0,0,0,,Егер Зори-сан жараса...
Dialogue: 0,0:50:28.23,0:50:30.81,Default,,0,0,0,,Мәңгі осылай қал
Dialogue: 0,0:50:30.94,0:50:35.49,Default,,0,0,0,,Иә, тура Дина айтқандай, бізбен бірге тұрайық!
Dialogue: 0,0:50:35.61,0:50:36.86,Default,,0,0,0,,Мен бақыттымын.
Dialogue: 0,0:50:36.99,0:50:40.12,Default,,0,0,0,,Сәуле әулетінде тамаша мұрагер пайда болады дегенге сене алар емеспін!
Dialogue: 0,0:50:42.95,0:50:44.62,Default,,0,0,0,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:50:44.75,0:50:48.37,Default,,0,0,0,,О, рахмет рахмет
Dialogue: 0,0:50:53.00,0:50:53.92,Default,,0,0,0,,Дина
Dialogue: 0,0:50:54.30,0:50:56.34,Default,,0,0,0,,Ооо...
Dialogue: 0,0:50:56.84,0:50:58.88,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:50:59.01,0:51:00.01,Default,,0,0,0,,Кім!?
Dialogue: 0,0:51:00.76,0:51:02.85,Default,,0,0,0,,Жоқ, бұл менмін, бірақ мен емес!
Dialogue: 0,0:51:02.97,0:51:04.56,Default,,0,0,0,,Мен оны көрмедім!
Dialogue: 0,0:51:04.97,0:51:07.89,Default,,0,0,0,,Енді бірдеңе көзілдірікті алып, сол жерге қойды!
Dialogue: 0,0:51:08.02,0:51:09.10,Default,,0,0,0,,Иә? сурет?
Dialogue: 0,0:51:09.23,0:51:10.77,Default,,0,0,0,,Кя! Уаа ггггг
Dialogue: 0,0:51:10.90,0:51:12.73,Default,,0,0,0,,Уау~ Бұл кім! Апыр-ай?
Dialogue: 0,0:51:12.86,0:51:15.19,Default,,0,0,0,,Жұмыртқаға алаңдап тұрмын, тезірек қуып жет!
Dialogue: 0,0:51:15.32,0:51:17.15,Default,,0,0,0,,Уау... түсіндім.
Dialogue: 0,0:51:17.28,0:51:20.49,Default,,0,0,0,,Тоқта! Бұл біздің тағам!
Dialogue: 0,0:51:20.91,0:51:22.41,Default,,0,0,0,,Күт, күт, күт
Dialogue: 0,0:51:22.66,0:51:25.16,Default,,0,0,0,,Хмм, уау, бұл не?
Dialogue: 0,0:51:25.29,0:51:26.87,Default,,0,0,0,,Хмм... Уау!?
Dialogue: 0,0:51:27.29,0:51:29.54,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:51:29.71,0:51:30.37,Default,,0,0,0,,Ha
Dialogue: 0,0:51:31.50,0:51:34.21,Default,,0,0,0,,Ишиши! Ерте болса, тоқтайық
Dialogue: 0,0:51:34.34,0:51:35.05,Default,,0,0,0,,Қандай да бір себепті,
Dialogue: 0,0:51:35.17,0:51:36.92,Default,,0,0,0,,...
Dialogue: 0,0:51:37.05,0:51:39.51,Default,,0,0,0,,Жоқ, бұзық маймылдар!
Dialogue: 0,0:51:41.80,0:51:44.64,Default,,0,0,0,,Бұл сенің ойыншығың емес!
Dialogue: 0,0:51:45.06,0:51:46.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:51:47.22,0:51:50.35,Default,,0,0,0,,Хаха, анау кішкентай маймылдар күлкілі.
Dialogue: 0,0:51:50.48,0:51:53.10,Default,,0,0,0,,Аа, қазір ойлап қарасам, мына жігіттерден басқа...
Dialogue: 0,0:51:53.23,0:51:54.52,Default,,0,0,0,,Сіз нені қалайсыз?
Dialogue: 0,0:51:54.65,0:51:55.90,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:51:56.23,0:51:58.69,Default,,0,0,0,,Оның жылдам болғаны сонша, мен оны түсінбедім.
Dialogue: 0,0:51:58.82,0:52:01.86,Default,,0,0,0,,Жіңішке және жаман нәрсеге ұқсайтын.
Dialogue: 0,0:52:02.16,0:52:03.32,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:52:03.45,0:52:04.87,Default,,0,0,0,,Барлығы, хмм?
Dialogue: 0,0:52:05.08,0:52:05.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:06.33,0:52:07.95,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:52:08.75,0:52:09.70,Default,,0,0,0,,Бұл кім!?
Dialogue: 0,0:52:09.83,0:52:11.92,Default,,0,0,0,,Ол әдемі ханым!?
Dialogue: 0,0:52:12.04,0:52:15.21,Default,,0,0,0,,Бұл Дина. Мен де дәл қазір таң қалдым.
Dialogue: 0,0:52:15.34,0:52:16.63,Default,,0,0,0,,Ээээх!
Dialogue: 0,0:52:17.25,0:52:19.34,Default,,0,0,0,,Жоқ, бұл!
Dialogue: 0,0:52:21.05,0:52:23.13,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:52:23.64,0:52:25.64,Default,,0,0,0,,Қорыққан адамдар:
Dialogue: 0,0:52:25.76,0:52:28.10,Default,,0,0,0,,Жұмыртқаны қалай жеу керек деп ұрысып жатса керек.
Dialogue: 0,0:52:28.85,0:52:31.27,Default,,0,0,0,,Осылайша біз көпшілік дауысқа ие болдық.
Dialogue: 0,0:52:31.39,0:52:33.94,Default,,0,0,0,,1 плюс 2 плюс 1 плюс 4
Dialogue: 0,0:52:34.52,0:52:37.15,Default,,0,0,0,,Барлығы 8 Шугекихан бар.
Dialogue: 0,0:52:37.27,0:52:39.28,Default,,0,0,0,,Сіз күткендей, Зоори мырза!
Dialogue: 0,0:52:39.40,0:52:40.99,Default,,0,0,0,,Жылы.
Dialogue: 0,0:52:41.11,0:52:45.41,Default,,0,0,0,,Хмф, онша емес, құмырсқа, құмырсқа, үлкен құмырсқа, аллигатор!
Dialogue: 0,0:52:45.53,0:52:46.91,Default,,0,0,0,,Тағы бір… үкі ме?
Dialogue: 0,0:52:47.03,0:52:48.99,Default,,0,0,0,,Қызық, ол сол маймылдардың досы ма?
Dialogue: 0,0:52:51.54,0:52:55.33,Default,,0,0,0,,Қалай болғанда да, біз үшеуміз.
Dialogue: 0,0:52:55.50,0:52:57.42,Default,,0,0,0,,5 дос болса
Dialogue: 0,0:52:57.63,0:53:00.09,Default,,0,0,0,,Менің достарым болмаса, шеңберде 8 адам болар еді.
Dialogue: 0,0:53:00.21,0:53:02.63,Default,,0,0,0,,Бұл сіздің жұмыртқаларыңызды іздейтін адамдар бар дегенді білдіреді.
Dialogue: 0,0:53:03.22,0:53:05.43,Default,,0,0,0,,Қайтадан қорқып кетсең жаман болар еді.
Dialogue: 0,0:53:05.59,0:53:08.85,Default,,0,0,0,,Ойланып қарасам, менің көзілдірігім ешкімде жоқ.
Dialogue: 0,0:53:09.31,0:53:12.35,Default,,0,0,0,,Өзенмен әрі қарай әрі қарай бұл аралдан тез кетеміз.
Dialogue: 0,0:53:12.48,0:53:13.10,Default,,0,0,0,,Не!
Dialogue: 0,0:53:13.44,0:53:15.94,Default,,0,0,0,,Дегенмен таң атқанша күтуім керек.
Dialogue: 0,0:53:16.06,0:53:18.57,Default,,0,0,0,,Жұмыртқа тасқа соғылуы мүмкін.
Dialogue: 0,0:53:19.61,0:53:21.86,Default,,0,0,0,,Сіз жасай алмайтын ештеңе жоқ.
Dialogue: 0,0:53:22.15,0:53:25.53,Default,,0,0,0,,Оны мына жынды Зорори-самаға қалдыр!
Dialogue: 0,0:53:37.63,0:53:39.17,Default,,0,0,0,,Ах~
Dialogue: 0,0:53:39.50,0:53:40.21,Default,,0,0,0,,Ах
Dialogue: 0,0:53:42.01,0:53:44.26,Default,,0,0,0,,Уау! Керемет!
Dialogue: 0,0:53:45.30,0:53:46.72,Default,,0,0,0,,Зори-сан, бұл тамаша!
Dialogue: 0,0:53:47.01,0:53:50.18,Default,,0,0,0,,Хаха талай рет айттым, бірақ онша емес.
Dialogue: 0,0:53:50.51,0:53:51.97,Default,,0,0,0,,Ах! қайық
Dialogue: 0,0:53:52.10,0:53:53.39,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:53:53.52,0:53:55.73,Default,,0,0,0,,А, Дина, барамыз ба?
Dialogue: 0,0:53:55.85,0:53:57.81,Default,,0,0,0,,Уф, бірақ бұл балалар.
Dialogue: 0,0:53:57.94,0:53:59.69,Default,,0,0,0,,Нунгиги
Dialogue: 0,0:54:00.65,0:54:03.28,Default,,0,0,0,,Жақында менің достарым көмекке келеді.
Dialogue: 0,0:54:12.20,0:54:13.87,Default,,0,0,0,,Ношиши! Сәлем!
Dialogue: 0,0:54:14.75,0:54:16.21,Default,,0,0,0,,Енді Ишиши!
Dialogue: 0,0:54:16.33,0:54:18.04,Default,,0,0,0,,Сәлем! Жақсы!
Dialogue: 0,0:54:31.35,0:54:36.06,Default,,0,0,0,,Зоори мырза, ол ақ судағы қайықшыға ұқсайды, сондай керемет!
Dialogue: 0,0:54:36.60,0:54:39.23,Default,,0,0,0,,Зори-сан шынымен де бәрін жасай алады.
Dialogue: 0,0:54:39.40,0:54:44.15,Default,,0,0,0,,Әй, бүгінгі қала Динаға тең келмейді.
Dialogue: 0,0:54:44.28,0:54:45.32,Default,,0,0,0,,О
Dialogue: 0,0:54:48.61,0:54:50.87,Default,,0,0,0,,Өзеннің көптеген тармақтары бар.
Dialogue: 0,0:54:50.99,0:54:53.95,Default,,0,0,0,,Қай жолмен жүруім керек?
Dialogue: 0,0:54:54.08,0:54:55.87,Default,,0,0,0,,Жарайды! Ол төмендегенше...
Dialogue: 0,0:54:56.00,0:55:00.17,Default,,0,0,0,,Менің жуған жерім мұхит еді...
Dialogue: 0,0:55:01.25,0:55:03.88,Default,,0,0,0,,Ол мұхитқа ұқсамайды.
Dialogue: 0,0:55:04.42,0:55:05.71,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:55:06.80,0:55:10.22,Default,,0,0,0,,Ұзақ өмірде кейде айналып кетесің!
Dialogue: 0,0:55:11.51,0:55:14.89,Default,,0,0,0,,♪Қарашы, бұзақылықты жұлып алатын үйрек.
Dialogue: 0,0:55:15.02,0:55:17.64,Default,,0,0,0,,♪Бүгінгі Кими алтын медалі
Dialogue: 0,0:55:18.14,0:55:20.10,Default,,0,0,0,,♪ «Аджапа»
Dialogue: 0,0:55:20.23,0:55:23.69,Default,,0,0,0,,♪Сонымен қатар «Аджапа»
Dialogue: 0,0:55:23.94,0:55:30.70,Default,,0,0,0,,♪Қалып қалсаңыз, бірден «Аджапа!» деңіз.
Dialogue: 0,0:55:32.91,0:55:34.24,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:55:34.37,0:55:36.16,Default,,0,0,0,,Уау Уау Уау Уау Уау
Dialogue: 0,0:55:37.12,0:55:37.66,Default,,0,0,0,,Тұтқындарға арналған екінші жатақхана.
Dialogue: 0,0:55:39.00,0:55:41.08,Default,,0,0,0,,Achannnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn
Dialogue: 0,0:55:41.75,0:55:42.92,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:55:43.04,0:55:46.09,Default,,0,0,0,,Жұмыртқа өлсе не істеуім керек?
Dialogue: 0,0:55:53.64,0:55:55.56,Default,,0,0,0,,Иә! сәуле! бұл!
Dialogue: 0,0:55:56.72,0:55:58.22,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:55:59.18,0:56:02.19,Default,,0,0,0,,Эх...муххии
Dialogue: 0,0:56:02.31,0:56:04.11,Default,,0,0,0,,Не, күте тұрыңыз?
Dialogue: 0,0:56:04.69,0:56:08.69,Default,,0,0,0,,Маған қанша тас лақтырса да, олар жұмыртқаға тимейді.
Dialogue: 0,0:56:09.44,0:56:13.24,Default,,0,0,0,,Түсіндім! Олардың мақсаты жұмыртқаны сындыру емес.
Dialogue: 0,0:56:13.36,0:56:16.53,Default,,0,0,0,,Нақты мақсат қандай? Ха!?
Dialogue: 0,0:56:17.29,0:56:19.79,Default,,0,0,0,,Тағы да! Қайсысы!?
Dialogue: 0,0:56:22.08,0:56:25.21,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,0:56:27.25,0:56:30.55,Default,,0,0,0,,Жоқ! Қарғыс атқыр... бұл олардың тұзағы!
Dialogue: 0,0:56:31.63,0:56:32.84,Default,,0,0,0,,Сол Косаку Каваджири, иіліп-жығылып, жалтақтайды.
Dialogue: 0,0:56:33.64,0:56:34.30,Default,,0,0,0,,(JoJo) Құдай-ай! Мынаны ал—Орыаа!
Dialogue: 0,0:56:34.68,0:56:35.97,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:56:40.64,0:56:43.52,Default,,0,0,0,,Ааааааааааааааааааааааааа!
Dialogue: 0,0:56:46.11,0:56:47.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:47.73,0:56:49.57,Default,,0,0,0,,Уау~
Dialogue: 0,0:56:51.36,0:56:52.95,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:56:55.87,0:56:59.41,Default,,0,0,0,,Бітті~
Dialogue: 0,0:57:09.21,0:57:11.42,Default,,0,0,0,,...
Dialogue: 0,0:57:11.55,0:57:14.43,Default,,0,0,0,,Біз де солай жасадық.
Dialogue: 0,0:57:14.55,0:57:16.55,Default,,0,0,0,,Ух... ха ха ха
Dialogue: 0,0:57:17.85,0:57:19.64,Default,,0,0,0,,Хаха~
Dialogue: 0,0:57:21.47,0:57:22.56,Default,,0,0,0,,Қандай да бір себепті,
Dialogue: 0,0:57:26.40,0:57:28.02,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:57:32.07,0:57:32.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:40.24,0:57:41.24,Default,,0,0,0,,Яғни
Dialogue: 0,0:57:41.37,0:57:45.37,Default,,0,0,0,,Мені Зори-сенсей жасаған тырна көтерді!
Dialogue: 0,0:57:45.71,0:57:46.67,Default,,0,0,0,,Уф
Dialogue: 0,0:57:47.88,0:57:51.50,Default,,0,0,0,,Бұл менікі! Ешкімге айтпай кімді көшірдің?
Dialogue: 0,0:57:51.63,0:57:54.47,Default,,0,0,0,,Иә! Жылдам артқа кран
Dialogue: 0,0:57:54.59,0:57:55.76,Default,,0,0,0,,Өшіру өшірулі өшірулі
Dialogue: 0,0:57:56.26,0:57:58.72,Default,,0,0,0,,Бастапқыда ауылдан табылған материалдар
Dialogue: 0,0:57:58.85,0:58:00.97,Default,,0,0,0,,Қалай пайдалансаң да, өзіңе байланысты, солай ма?
Dialogue: 0,0:58:01.22,0:58:03.64,Default,,0,0,0,,Иә! Сонымен, сендер-
Dialogue: 0,0:58:05.02,0:58:06.35,Default,,0,0,0,,Сол ауылда...
Dialogue: 0,0:58:06.60,0:58:07.69,Default,,0,0,0,,Ки Ки
Dialogue: 0,0:58:08.02,0:58:09.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:58:10.32,0:58:13.28,Default,,0,0,0,,Мен саған жұмыртқаны ешқашан бермеймін!
Dialogue: 0,0:58:14.36,0:58:15.90,Default,,0,0,0,,Ммм
Dialogue: 0,0:58:16.53,0:58:17.95,Default,,0,0,0,,Менің көзілдірігім
Dialogue: 0,0:58:18.07,0:58:18.87,Default,,0,0,0,,Иә
Dialogue: 0,0:58:21.33,0:58:24.20,Default,,0,0,0,,О? иә? Ах
Dialogue: 0,0:58:24.79,0:58:25.91,Default,,0,0,0,,...
Dialogue: 0,0:58:26.04,0:58:27.67,Default,,0,0,0,,Ei Ei Ei
Dialogue: 0,0:58:28.75,0:58:29.46,Default,,0,0,0,,Уау
Dialogue: 0,0:58:31.34,0:58:33.05,Default,,0,0,0,,...
Dialogue: 0,0:58:33.17,0:58:34.63,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:58:35.80,0:58:38.72,Default,,0,0,0,,Уф! Хмм, уау!
Dialogue: 0,0:58:38.84,0:58:40.30,Default,,0,0,0,,Шуш Шуш Шуш Шуш
Dialogue: 0,0:58:43.93,0:58:44.77,Default,,0,0,0,,Хмм
Dialogue: 0,0:58:45.35,0:58:47.77,Default,,0,0,0,,Уау аааа
Dialogue: 0,0:58:48.06,0:58:49.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:58:51.61,0:58:52.32,Default,,0,0,0,,Хмм
Dialogue: 0,0:58:58.11,0:59:00.57,Default,,0,0,0,,Эй, мүмкін бұл?
Dialogue: 0,0:59:02.99,0:59:05.50,Default,,0,0,0,,Сіз оны пісірілген жұмыртқаға айналдыруды жоспарламайсыз!
Dialogue: 0,0:59:05.87,0:59:06.79,Default,,0,0,0,,Танымал жауаптар
Dialogue: 0,0:59:06.91,0:59:07.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:08.04,0:59:10.04,Default,,0,0,0,,Білсең, тез шабуыл жаса!
Dialogue: 0,0:59:10.17,0:59:11.17,Default,,0,0,0,,Жұмыртқамен бірге—
Dialogue: 0,0:59:11.29,0:59:13.29,Default,,0,0,0,,Ыстық күрішке қайнатамын!
Dialogue: 0,0:59:15.92,0:59:17.92,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:59:18.05,0:59:20.72,Default,,0,0,0,,Уф, уау!
Dialogue: 0,0:59:21.22,0:59:23.30,Default,,0,0,0,,Тоқта! Анама тиіспе!
Dialogue: 0,0:59:23.43,0:59:26.47,Default,,0,0,0,,Не? Әлде анама?
Dialogue: 0,0:59:27.52,0:59:30.65,Default,,0,0,0,,Анама бір жамандық жасасаң, мен сені кешірмеймін!
Dialogue: 0,0:59:31.65,0:59:33.98,Default,,0,0,0,,Сіз маймылдар отбасысыз ба?
Dialogue: 0,0:59:34.11,0:59:35.90,Default,,0,0,0,,Уау, ыстық!
Dialogue: 0,0:59:36.07,0:59:38.86,Default,,0,0,0,,Ха, өте ыстық!
Dialogue: 0,0:59:38.99,0:59:42.28,Default,,0,0,0,,Осылай жалғаса берсе, жұмыртқа да, біз де...
Dialogue: 0,0:59:44.45,0:59:47.91,Default,,0,0,0,,Күте тұрыңыз! Сол жұмыртқаны тайфун шайып кеткен...
Dialogue: 0,0:59:48.54,0:59:50.46,Default,,0,0,0,,Бұл Кюрюдің жұмыртқасы!
Dialogue: 0,0:59:51.21,0:59:53.13,Default,,0,0,0,,Ә!? (Ишиши Ношиши) Уау
Dialogue: 0,0:59:53.54,0:59:55.67,Default,,0,0,0,,Балалар сендер де білдіңдер ме!?
Dialogue: 0,0:59:57.17,1:00:00.26,Default,,0,0,0,,Кёрюдің отбасы оны үйге алып бара жатқанымызды көреді.
Dialogue: 0,1:00:00.76,1:00:03.68,Default,,0,0,0,,Мен мұны асыға күтемін!
Dialogue: 0,1:00:04.18,1:00:06.01,Default,,0,0,0,,Кёрю отбасы
Dialogue: 0,1:00:06.26,1:00:08.93,Default,,0,0,0,,Сонымен, бүгінгі ауа-райы шын болды!
Dialogue: 0,1:00:09.43,1:00:11.64,Default,,0,0,0,,Ах... (Ишиши Ношиши) Ах!
Dialogue: 0,1:00:12.69,1:00:14.15,Default,,0,0,0,,Егер сіз де ана болсаңыз—
Dialogue: 0,1:00:14.27,1:00:17.23,Default,,0,0,0,,Сіз ананың баласына деген сезімін түсінесіз, солай ма?
Dialogue: 0,1:00:18.69,1:00:22.20,Default,,0,0,0,,Міне! Ләззат алыңыз! Маған жұмыртқаны қайтарыңыз!
Dialogue: 0,1:00:23.28,1:00:26.70,Default,,0,0,0,,Зоори мырза ақымақтық жасап тұр.
Dialogue: 0,1:00:28.49,1:00:31.71,Default,,0,0,0,,Иә, мен де осы балалардың анасымын.
Dialogue: 0,1:00:32.25,1:00:33.46,Default,,0,0,0,,Қане, жұмыртқа алайық.
Dialogue: 0,1:00:33.58,1:00:38.38,Default,,0,0,0,,Жоқ, мен анамын, ол жұмыртқаны не болса да аламын!
Dialogue: 0,1:00:38.50,1:00:39.42,Default,,0,0,0,,Неліктен!?
Dialogue: 0,1:00:39.92,1:00:41.01,Default,,0,0,0,,Сізге—
Dialogue: 0,1:00:41.13,1:00:43.51,Default,,0,0,0,,Біз арық маймылдарға ұқсайтын шығармыз, бірақ...
Dialogue: 0,1:00:44.26,1:00:46.47,Default,,0,0,0,,Олар шын мәнінде горилла ата-анасы мен баласы.
Dialogue: 0,1:00:46.60,1:00:48.51,Default,,0,0,0,,Иә!? мм... аа
Dialogue: 0,1:00:50.14,1:00:53.69,Default,,0,0,0,,Бір күні кенет сол тау тезек болып қалды.
Dialogue: 0,1:00:53.81,1:00:56.94,Default,,0,0,0,,Егістер мен ормандар толығымен жойылды.
Dialogue: 0,1:00:58.69,1:01:01.99,Default,,0,0,0,,Нәтижесінде тамақ қалмады, осылай болды.
Dialogue: 0,1:01:02.45,1:01:04.28,Default,,0,0,0,,Ueta Біз үшін—
Dialogue: 0,1:01:04.41,1:01:07.49,Default,,0,0,0,,Сол жұмыртқалар көптен бергі ең үлкен деликатес.
Dialogue: 0,1:01:07.87,1:01:10.58,Default,,0,0,0,,Мені мұңайтқан осы балаларға...
Dialogue: 0,1:01:10.70,1:01:12.71,Default,,0,0,0,,Мен сені тоқ тойдырғым келеді.
Dialogue: 0,1:01:12.83,1:01:15.83,Default,,0,0,0,,Ананың сезімін түсіне аласыз ба?
Dialogue: 0,1:01:16.21,1:01:19.21,Default,,0,0,0,,Сенің көңіл-күйіңді түсінемін, бірақ мен саған жұмыртқаны бермеймін!
Dialogue: 0,1:01:19.55,1:01:21.55,Default,,0,0,0,,Даиичи: Егер сіз балаларыңызды ойласаңыз—
Dialogue: 0,1:01:22.01,1:01:23.93,Default,,0,0,0,,Мен осындай елде болғанды жөн көремін.
Dialogue: 0,1:01:24.05,1:01:26.01,Default,,0,0,0,,Тамақ бар басқа жерде —
Dialogue: 0,1:01:26.14,1:01:27.85,Default,,0,0,0,,Жұқпалы болуы керек емес пе?
Dialogue: 0,1:01:29.10,1:01:32.48,Default,,0,0,0,,Менің осында болуымның себебі бар.
Dialogue: 0,1:01:34.48,1:01:35.23,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:38.65,1:01:42.90,Default,,0,0,0,,«Ана Гориги Горика Готту Горми»
Dialogue: 0,1:01:43.03,1:01:46.28,Default,,0,0,0,,«Гори гора голу, бәрі қалай?»
Dialogue: 0,1:01:46.78,1:01:49.62,Default,,0,0,0,,«Әкем ауылдан жұмыс іздеп кеткен».
Dialogue: 0,1:01:49.74,1:01:52.08,Default,,0,0,0,,«Мен әртүрлі қалаларды араладым, бірақ...»
Dialogue: 0,1:01:52.20,1:01:54.08,Default,,0,0,0,,«Жақсы жұмыс табу қиын».
Dialogue: 0,1:01:54.21,1:01:56.75,Default,,0,0,0,,«Мен ай сайын аз ғана ақша жібере аламын».
Dialogue: 0,1:01:56.87,1:01:59.04,Default,,0,0,0,,«Мен барлығына перде жаптым».
Dialogue: 0,1:01:59.88,1:02:01.80,Default,,0,0,0,,«Бірақ бақытты болыңыз.»
Dialogue: 0,1:02:01.92,1:02:05.72,Default,,0,0,0,,«Бұл жолы достарыммен бастаған жұмысым жақсы жүріп жатқан сияқты».
Dialogue: 0,1:02:05.84,1:02:07.97,Default,,0,0,0,,«Мен бар күшімді саламын және оны табысты етемін».
Dialogue: 0,1:02:08.09,1:02:11.51,Default,,0,0,0,,«Менің ойымша, мен жақында үйге көптеген сувенирлер әкеле аламын...»
Dialogue: 0,1:02:11.64,1:02:14.89,Default,,0,0,0,,«Оған дейін барлығыңыз шыдамдылықпен күтіңіздер.»
Dialogue: 0,1:02:15.60,1:02:17.23,Default,,0,0,0,,«Әкемнен»
Dialogue: 0,1:02:18.48,1:02:20.15,Default,,0,0,0,,Уф...
Dialogue: 0,1:02:20.69,1:02:23.32,Default,,0,0,0,,Ол адам әртүрлі қалаларға саяхаттап жүр...
Dialogue: 0,1:02:23.44,1:02:25.45,Default,,0,0,0,,Мен оған үйренуім қиын.
Dialogue: 0,1:02:25.74,1:02:26.74,Default,,0,0,0,,Бұл арал суға батып бара жатыр
Dialogue: 0,1:02:26.86,1:02:29.74,Default,,0,0,0,,Олар қорқынышты жағдайда қалғандарын да білмейді.
Dialogue: 0,1:02:30.24,1:02:32.20,Default,,0,0,0,,Әкем осында қайтып келгенде...
Dialogue: 0,1:02:32.33,1:02:33.95,Default,,0,0,0,,Біз кеткеніміз қиын болар еді.
Dialogue: 0,1:02:34.58,1:02:36.91,Default,,0,0,0,,Маған еш нәрсе жазылмаған сияқты...
Dialogue: 0,1:02:37.04,1:02:39.42,Default,,0,0,0,,Егер біз аралдан бөлінетін болсақ...
Dialogue: 0,1:02:39.54,1:02:41.88,Default,,0,0,0,,Мен енді әкемді көре алмаймын.
Dialogue: 0,1:02:42.50,1:02:44.96,Default,,0,0,0,,Сонымен, әкем қайтып келгенше...
Dialogue: 0,1:02:45.09,1:02:47.30,Default,,0,0,0,,Сіз бұл жерде қолыңыздан келгеннің бәрін істеуді шештіңіз!
Dialogue: 0,1:02:47.43,1:02:49.22,Default,,0,0,0,,Нана Гориги-нии-чан!
Dialogue: 0,1:02:49.34,1:02:50.30,Default,,0,0,0,,Иә
Dialogue: 0,1:02:50.43,1:02:52.85,Default,,0,0,0,,Уф... бұл мені жылатады.
Dialogue: 0,1:02:52.97,1:02:54.68,Default,,0,0,0,,Олар жақсы балалар~ Уф
Dialogue: 0,1:02:55.27,1:03:00.02,Default,,0,0,0,,Гориллалар мен гориллалардың өз отбасыларына деген сезімдерінің айырмашылығы бар ма?
Dialogue: 0,1:03:00.40,1:03:02.94,Default,,0,0,0,,Хмм, не істеуім керек...
Dialogue: 0,1:03:06.32,1:03:08.28,Default,,0,0,0,,Ана... Ха
Dialogue: 0,1:03:08.45,1:03:10.49,Default,,0,0,0,,Уау~
Dialogue: 0,1:03:11.95,1:03:14.99,Default,,0,0,0,,Мен мұнда неге кете алмайтынымды енді түсіндім!
Dialogue: 0,1:03:15.12,1:03:17.21,Default,,0,0,0,,Бірақ тыңдаңыз!
Dialogue: 0,1:03:17.33,1:03:20.00,Default,,0,0,0,,Жұмыртқаны қазір жесең, болды.
Dialogue: 0,1:03:20.63,1:03:22.42,Default,,0,0,0,,Бірақ бұл жұмыртқа қауіпсіз болды.
Dialogue: 0,1:03:22.54,1:03:25.21,Default,,0,0,0,,Кёрю аралына жете алсақ...
Dialogue: 0,1:03:25.34,1:03:28.22,Default,,0,0,0,,Аралдан дәмді банандарды алуыңыз үшін мен мұны сізге жасаймын!
Dialogue: 0,1:03:30.47,1:03:31.22,Default,,0,0,0,,Шынымен!?
Dialogue: 0,1:03:31.64,1:03:33.68,Default,,0,0,0,,Бананды күнде жеуге болмайды!?
Dialogue: 0,1:03:34.14,1:03:35.68,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,1:03:35.89,1:03:38.60,Default,,0,0,0,,Я, бұл жақсы әңгіме.
Dialogue: 0,1:03:38.73,1:03:41.56,Default,,0,0,0,,Егер кенет менен біреу сұраса, оның рас екенін сұрай аламын ба?
Dialogue: 0,1:03:41.69,1:03:42.56,Default,,0,0,0,,Маған сеніңіз!
Dialogue: 0,1:03:43.15,1:03:46.32,Default,,0,0,0,,Мен сенімен алмастырған уәдем...
Dialogue: 0,1:03:47.86,1:03:50.45,Default,,0,0,0,,Мен сені еш нәрсеге қарамастан қорғаймын!
Dialogue: 0,1:03:51.61,1:03:52.74,Default,,0,0,0,,Сізді алдауға бола ма?
Dialogue: 0,1:03:53.24,1:03:53.95,Default,,0,0,0,,О.
Dialogue: 0,1:03:54.41,1:03:56.29,Default,,0,0,0,,Алдымен маған банан әкел!
Dialogue: 0,1:03:56.58,1:03:59.41,Default,,0,0,0,,Мен олай ойламаймын!
Dialogue: 0,1:03:59.54,1:04:02.08,Default,,0,0,0,,Горика! Горми! Оны байлаңыз
Dialogue: 0,1:04:03.00,1:04:05.17,Default,,0,0,0,,Ууууууууууууууууу
Dialogue: 0,1:04:11.09,1:04:12.34,Default,,0,0,0,,Ах!
Dialogue: 0,1:04:13.47,1:04:15.51,Default,,0,0,0,,Маған сеніңіз!
Dialogue: 0,1:04:15.64,1:04:17.93,Default,,0,0,0,,Барлығы тойып жегісі келеді, солай ма?
Dialogue: 0,1:04:18.06,1:04:18.77,Default,,0,0,0,,Ой
Dialogue: 0,1:04:19.10,1:04:21.89,Default,,0,0,0,,Алданбаңыз!
Dialogue: 0,1:04:22.02,1:04:24.27,Default,,0,0,0,,Горика, өтінемін, мені қаттырақ байла.
Dialogue: 0,1:04:24.40,1:04:25.11,Default,,0,0,0,,Гуха~
Dialogue: 0,1:04:27.86,1:04:29.74,Default,,0,0,0,,Қарапайым отбасы рөлін ойнауды жалғастыр
Dialogue: 0,1:04:30.74,1:04:32.07,Default,,0,0,0,,Жұмыртқа
Dialogue: 0,1:04:32.91,1:04:35.37,Default,,0,0,0,,Уф, өте ыстық.
Dialogue: 0,1:04:35.49,1:04:37.29,Default,,0,0,0,,Асықпасаң, жұмыртқа...
Dialogue: 0,1:04:41.00,1:04:42.54,Default,,0,0,0,,Уау! Гол!
Dialogue: 0,1:04:42.75,1:04:44.50,Default,,0,0,0,,Пами
Dialogue: 0,1:04:45.88,1:04:46.92,Default,,0,0,0,,Уау
Dialogue: 0,1:04:48.30,1:04:49.13,Default,,0,0,0,,Иин
Dialogue: 0,1:04:49.51,1:04:50.63,Default,,0,0,0,,Бала құлап жатыр!
Dialogue: 0,1:04:50.97,1:04:51.76,Default,,0,0,0,,Ах!
Dialogue: 0,1:04:53.18,1:04:54.14,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,1:04:54.43,1:04:55.34,Default,,0,0,0,,Хмм...хехе!
Dialogue: 0,1:04:55.47,1:04:57.22,Default,,0,0,0,,Ношиши сегізаяқ аяқтары!
Dialogue: 0,1:04:57.60,1:04:58.56,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:04:59.27,1:05:00.27,Default,,0,0,0,,Уау~
Dialogue: 0,1:05:01.39,1:05:02.39,Default,,0,0,0,,Хмф!
Dialogue: 0,1:05:03.31,1:05:04.90,Default,,0,0,0,,Зорори-сан!
Dialogue: 0,1:05:09.15,1:05:10.53,Default,,0,0,0,,Уф...
Dialogue: 0,1:05:10.99,1:05:13.15,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:15.28,1:05:18.49,Default,,0,0,0,,Өте ыстық!
Dialogue: 0,1:05:19.29,1:05:20.16,Default,,0,0,0,,Иә~
Dialogue: 0,1:05:20.91,1:05:22.96,Default,,0,0,0,,Ах... а
Dialogue: 0,1:05:23.33,1:05:24.33,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,1:05:24.46,1:05:26.71,Default,,0,0,0,,Гол! Ахаха
Dialogue: 0,1:05:32.47,1:05:34.43,Default,,0,0,0,,Гол~!
Dialogue: 0,1:05:35.55,1:05:39.39,Default,,0,0,0,,Фу, бұл көп болды.
Dialogue: 0,1:05:39.81,1:05:41.06,Default,,0,0,0,,Зоори мырза
Dialogue: 0,1:05:41.60,1:05:44.14,Default,,0,0,0,,Ахахахахаха
Dialogue: 0,1:05:46.06,1:05:47.15,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,1:05:47.98,1:05:52.40,Default,,0,0,0,,Балаңыздың өмірін жай ғана жырлай алмайсыз.
Dialogue: 0,1:05:54.28,1:05:56.28,Default,,0,0,0,,Жарайды
Dialogue: 0,1:05:56.41,1:05:57.87,Default,,0,0,0,,Баяу және ақырын тыңдаңыз
Dialogue: 0,1:06:01.54,1:06:03.37,Default,,0,0,0,,Гора Мушидако Жақсы ма?
Dialogue: 0,1:06:03.50,1:06:04.12,Default,,0,0,0,,Иә!
Dialogue: 0,1:06:04.25,1:06:07.71,Default,,0,0,0,,Қаша мен қабанға айналып кете жаздадық.
Dialogue: 0,1:06:10.00,1:06:12.09,Default,,0,0,0,,Жарайды, мына жерге қойыңыз!
Dialogue: 0,1:06:12.59,1:06:13.63,Default,,0,0,0,,Иә.
Dialogue: 0,1:06:15.17,1:06:16.05,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,1:06:16.88,1:06:17.64,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,1:06:37.03,1:06:37.78,Default,,0,0,0,,Мен енді мұны істей алмаймын!
Dialogue: 0,1:06:38.49,1:06:39.41,Default,,0,0,0,,Ах
Dialogue: 0,1:06:39.95,1:06:42.70,Default,,0,0,0,,Мен уәдемде тұрмадым!
Dialogue: 0,1:06:42.83,1:06:43.66,Default,,0,0,0,,Мені кешіріңіз!
Dialogue: 0,1:06:44.70,1:06:46.00,Default,,0,0,0,,Көрсетілгендей
Dialogue: 0,1:06:46.12,1:06:48.92,Default,,0,0,0,,Жұмыртқа кішкентай.
Dialogue: 0,1:06:49.04,1:06:50.42,Default,,0,0,0,,Әй, анашым!
Dialogue: 0,1:06:51.21,1:06:52.88,Default,,0,0,0,,Сосын сәби дүниеге келді!
Dialogue: 0,1:06:54.17,1:06:55.09,Default,,0,0,0,,Иә!?
Dialogue: 0,1:07:09.69,1:07:12.40,Default,,0,0,0,,Ух... Қарғыс атсын... Қап!
Dialogue: 0,1:07:12.90,1:07:14.94,Default,,0,0,0,,Ах!?
Dialogue: 0,1:07:15.86,1:07:18.07,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,1:07:18.40,1:07:21.07,Default,,0,0,0,,Не? Ол дүниеге келді ме?
Dialogue: 0,1:07:21.37,1:07:23.62,Default,,0,0,0,,Бұл шын! Шошин Шомей —
Dialogue: 0,1:07:23.74,1:07:25.24,Default,,0,0,0,,Бұл Кёрюдің баласы!
Dialogue: 0,1:07:25.37,1:07:27.62,Default,,0,0,0,,Мен саған жұмыртқаны маған қайтар деп айттым.
Dialogue: 0,1:07:27.75,1:07:29.96,Default,,0,0,0,,Пештің жылуы сізді кері қайтарды.
Dialogue: 0,1:07:30.08,1:07:32.42,Default,,0,0,0,,Уау, бұл керемет! Бұл шынайы!
Dialogue: 0,1:07:32.54,1:07:34.55,Default,,0,0,0,,Бірінші рет көруім! Уау~
Dialogue: 0,1:07:34.67,1:07:37.38,Default,,0,0,0,,О, құдайым
Dialogue: 0,1:07:37.51,1:07:38.80,Default,,0,0,0,,Барбарбарбару
Dialogue: 0,1:07:38.92,1:07:40.76,Default,,0,0,0,,Иә! Иә
Dialogue: 0,1:07:40.89,1:07:43.47,Default,,0,0,0,,Егер сіз осылай тырыссаңыз, жақсы емес.
Dialogue: 0,1:07:43.60,1:07:46.56,Default,,0,0,0,,Жарайды, жарайды, айналамда шу болды.
Dialogue: 0,1:07:47.89,1:07:49.89,Default,,0,0,0,,Уайымдаудың қажеті жоқ.
Dialogue: 0,1:07:50.14,1:07:54.07,Default,,0,0,0,,Жұмыртқа емессің, әдемі сәбисің.
Dialogue: 0,1:07:54.19,1:07:56.32,Default,,0,0,0,,Себебі мен тамақты ұстамаймын...
Dialogue: 0,1:07:56.44,1:07:58.36,Default,,0,0,0,,Тыныш ұйықта
Dialogue: 0,1:07:59.24,1:08:02.36,Default,,0,0,0,,Мен қорықтым, кешіріңіз.
Dialogue: 0,1:08:02.57,1:08:05.53,Default,,0,0,0,,...
Dialogue: 0,1:08:05.70,1:08:08.79,Default,,0,0,0,,Ооо... ой
Dialogue: 0,1:08:14.42,1:08:15.92,Default,,0,0,0,,Сонымен
Dialogue: 0,1:08:16.50,1:08:20.47,Default,,0,0,0,,А... аа... ааа
Dialogue: 0,1:08:20.59,1:08:22.93,Default,,0,0,0,,Менің балам...
Dialogue: 0,1:08:23.43,1:08:27.64,Default,,0,0,0,,Анасы мен әкесі асыға күткен күн.
Dialogue: 0,1:08:27.77,1:08:32.02,Default,,0,0,0,,Жұмыртқадан туылған нәрестенің әсерлі тәжірибесі!
Dialogue: 0,1:08:32.94,1:08:37.77,Default,,0,0,0,,Саған көрсете алмағаным өкінішті және ұят...Ууууууууу~
Dialogue: 0,1:08:38.82,1:08:41.74,Default,,0,0,0,,Нәресте аман қалды.
Dialogue: 0,1:08:41.86,1:08:44.99,Default,,0,0,0,,Біз бұдан артық ештеңе қаламаймыз
Dialogue: 0,1:08:45.12,1:08:46.41,Default,,0,0,0,,Горимама да...
Dialogue: 0,1:08:46.83,1:08:49.75,Default,,0,0,0,,Біздің сәбиге қарағаныңызға рахмет.
Dialogue: 0,1:08:49.87,1:08:50.87,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,1:08:51.58,1:08:54.13,Default,,0,0,0,,Зоори мырза, біздің асыл сәбиіміз...
Dialogue: 0,1:08:54.25,1:08:58.71,Default,,0,0,0,,Мені қорғағандарыңызға көп рахмет.
Dialogue: 0,1:08:58.84,1:08:59.84,Default,,0,0,0,,Бухун
Dialogue: 0,1:09:01.22,1:09:04.22,Default,,0,0,0,,Ағамды қорғағаныңыз үшін рахмет.
Dialogue: 0,1:09:04.64,1:09:07.26,Default,,0,0,0,,Иә, мені кешіресің бе?
Dialogue: 0,1:09:07.39,1:09:09.27,Default,,0,0,0,,Ал, мен жеңілдеп қалдым!
Dialogue: 0,1:09:09.39,1:09:11.14,Default,,0,0,0,,Кешіруден алыс -
Dialogue: 0,1:09:11.27,1:09:14.39,Default,,0,0,0,,Біз үшін бірдеңе істей аласыз ба?
Dialogue: 0,1:09:14.52,1:09:17.27,Default,,0,0,0,,Олай десеңіз, оқиға тезірек өтеді!
Dialogue: 0,1:09:17.40,1:09:19.40,Default,,0,0,0,,Негізінде бір ғана нәрсе бар!
Dialogue: 0,1:09:19.90,1:09:22.78,Default,,0,0,0,,Зори-сан сұраса қуанар едім!
Dialogue: 0,1:09:22.90,1:09:24.78,Default,,0,0,0,,Горилла ата-анасы мен баласы үшін -
Dialogue: 0,1:09:24.91,1:09:27.70,Default,,0,0,0,,Осы аралдың банандарын менімен бөлісе аласыз ба?
Dialogue: 0,1:09:27.83,1:09:31.45,Default,,0,0,0,,Вахахаха! Бұл арзан сияқты.
Dialogue: 0,1:09:31.58,1:09:33.50,Default,,0,0,0,,Әке! Мен апарамын!
Dialogue: 0,1:09:33.62,1:09:34.75,Default,,0,0,0,,Мен де!
Dialogue: 0,1:09:34.87,1:09:37.08,Default,,0,0,0,,Біз де көмектесеміз!
Dialogue: 0,1:09:37.21,1:09:38.25,Default,,0,0,0,,Барлығы, күте тұрыңдар!
Dialogue: 0,1:09:39.00,1:09:40.96,Default,,0,0,0,,Банан алып жүрудің қажеті жоқ.
Dialogue: 0,1:09:41.09,1:09:41.96,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:42.09,1:09:43.26,Default,,0,0,0,,Мұндай банан!
Dialogue: 0,1:09:44.05,1:09:46.51,Default,,0,0,0,,Мен саған банан әкелсем де...
Dialogue: 0,1:09:46.64,1:09:50.01,Default,,0,0,0,,Мен сол қараусыз қалған аралға қайта баруға мәжбүр болғаныма ренжідім.
Dialogue: 0,1:09:51.35,1:09:54.39,Default,,0,0,0,,Бұл жерде өмір сүруге болатын көптеген жақсы жерлер бар.
Dialogue: 0,1:09:54.52,1:09:56.90,Default,,0,0,0,,Қаласаңыз, осында тұрғыңыз келе ме?
Dialogue: 0,1:09:57.02,1:09:59.19,Default,,0,0,0,,Е! Аа, бірақ шын мәнінде ...
Dialogue: 0,1:09:59.32,1:10:00.98,Default,,0,0,0,,Қалғанын маған қалдырыңыз!
Dialogue: 0,1:10:01.11,1:10:01.98,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:02.57,1:10:03.53,Default,,0,0,0,,Нихи
Dialogue: 0,1:10:06.41,1:10:07.74,Default,,0,0,0,,Енді орындалды!
Dialogue: 0,1:10:07.87,1:10:10.78,Default,,0,0,0,,Бұл жігітті бастапқы аралға қойыңыз!
Dialogue: 0,1:10:10.91,1:10:14.50,Default,,0,0,0,,Қанбан тақтасы болса, өзіңізді қауіпсіз сезінетініңіз рас!
Dialogue: 0,1:10:14.62,1:10:17.75,Default,,0,0,0,,Ол сондай-ақ картамен бірге келеді, сондықтан жоғалып кетуден қорықпаңыз!
Dialogue: 0,1:10:17.88,1:10:19.79,Default,,0,0,0,,Хахахаха (Ишиши Ношиши) Иә?
Dialogue: 0,1:10:19.92,1:10:21.17,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,1:10:21.30,1:10:24.84,Default,,0,0,0,,Күте тұрыңыз! Біз де ойнайық!
Dialogue: 0,1:10:26.01,1:10:27.30,Default,,0,0,0,,Зорори-сан
Dialogue: 0,1:10:28.01,1:10:30.93,Default,,0,0,0,,Барлығы үшін рахмет
Dialogue: 0,1:10:37.69,1:10:40.65,Default,,0,0,0,,Кёрю Мама қатты қуанды.
Dialogue: 0,1:10:40.90,1:10:41.86,Default,,0,0,0,,О
Dialogue: 0,1:10:42.36,1:10:44.40,Default,,0,0,0,,Зооридің кацуякусы да керемет болды!
Dialogue: 0,1:10:44.53,1:10:46.15,Default,,0,0,0,,А... Түсіндім бе?
Dialogue: 0,1:10:47.11,1:10:47.74,Default,,0,0,0,,Әй!
Dialogue: 0,1:10:48.32,1:10:49.03,Default,,0,0,0,,Зоори мырза!
Dialogue: 0,1:10:49.16,1:10:50.12,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,1:10:50.78,1:10:53.49,Default,,0,0,0,,Мен бірге өмір сүргім келеді.
Dialogue: 0,1:10:53.62,1:10:54.25,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,1:10:55.25,1:10:57.75,Default,,0,0,0,,Бірге тұру керек пе?
Dialogue: 0,1:11:01.67,1:11:03.96,Default,,0,0,0,,Дина... Хаа~
Dialogue: 0,1:11:05.05,1:11:06.72,Default,,0,0,0,,Әрине, жақсы.
Dialogue: 0,1:11:06.84,1:11:08.84,Default,,0,0,0,,Ешқандай қарсылық білдіруге болмайды!
Dialogue: 0,1:11:08.97,1:11:11.72,Default,,0,0,0,,Ха, шынымен бе? Жарайды, мен осында мәңгі боламын.
Dialogue: 0,1:11:11.85,1:11:14.68,Default,,0,0,0,,Менің отбасыммен тұрғаным дұрыс па?
Dialogue: 0,1:11:14.81,1:11:16.64,Default,,0,0,0,,Мен құпияны ешқашан бермеймін!
Dialogue: 0,1:11:16.77,1:11:19.94,Default,,0,0,0,,Ахахха... О, әрине... Міне?
Dialogue: 0,1:11:20.40,1:11:23.02,Default,,0,0,0,,Эй... сен осында тұрасың ба?
Dialogue: 0,1:11:23.52,1:11:25.57,Default,,0,0,0,,Кёрю отбасымен?
Dialogue: 0,1:11:25.78,1:11:26.65,Default,,0,0,0,,Уф… Ах…
Dialogue: 0,1:11:28.49,1:11:31.82,Default,,0,0,0,,Уәдесінде тұруға тырысқан Ишидің күші
Dialogue: 0,1:11:31.95,1:11:35.20,Default,,0,0,0,,Бірінен соң бірі өнертабыстар жасау!
Dialogue: 0,1:11:35.33,1:11:38.08,Default,,0,0,0,,Қандай жағдай болса да әрекет ету күші!
Dialogue: 0,1:11:38.37,1:11:42.42,Default,,0,0,0,,Зори-сан туралы бәрі менің жүрегімді елжіретіп жіберді.
Dialogue: 0,1:11:43.38,1:11:46.09,Default,,0,0,0,,Бұл бәрі емес...
Dialogue: 0,1:11:46.21,1:11:50.30,Default,,0,0,0,,Мен дәл қазір бұл мүмкін емес күйзеліс үстіндемін.
Dialogue: 0,1:11:50.47,1:11:53.64,Default,,0,0,0,,Сондықтан мен осында қаламын.
Dialogue: 0,1:11:54.35,1:11:56.39,Default,,0,0,0,,Отбасыммен бірге тұру...
Dialogue: 0,1:11:56.52,1:11:58.98,Default,,0,0,0,,Маған ұнайтын зерттеуді жалғастыра алу –
Dialogue: 0,1:11:59.10,1:12:00.85,Default,,0,0,0,,Өйткені бұл менің бақытым
Dialogue: 0,1:12:04.94,1:12:07.86,Default,,0,0,0,,Иә... бұл... тамаша.
Dialogue: 0,1:12:08.44,1:12:11.28,Default,,0,0,0,,Уууу... Зорори Сенсей
Dialogue: 0,1:12:11.91,1:12:14.45,Default,,0,0,0,,Зори-сан, маған көмектесші!
Dialogue: 0,1:12:14.74,1:12:15.66,Default,,0,0,0,,Иә
Dialogue: 0,1:12:15.78,1:12:19.33,Default,,0,0,0,,Оитавашия, Зорори-сенсей!
Dialogue: 0,1:12:24.08,1:12:25.63,Default,,0,0,0,,Аман болыңыз!
Dialogue: 0,1:12:25.75,1:12:27.25,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,1:12:27.38,1:12:28.80,Default,,0,0,0,,Қайта келіңіз!
Dialogue: 0,1:12:29.51,1:12:31.88,Default,,0,0,0,,Мен құпияны кез келген жағдайда қорғаймын.
Dialogue: 0,1:12:32.01,1:12:33.22,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,1:12:33.68,1:12:35.43,Default,,0,0,0,,Мен әкем туралы сұрадым!
Dialogue: 0,1:12:35.55,1:12:37.43,Default,,0,0,0,,Мен оны сұрадым!
Dialogue: 0,1:12:37.56,1:12:38.89,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,1:12:39.06,1:12:41.73,Default,,0,0,0,,Аман болыңыз! Күте тұрыңыз!
Dialogue: 0,1:12:43.52,1:12:45.23,Default,,0,0,0,,Мен енді көре алмаймын
Dialogue: 0,1:12:45.77,1:12:47.78,Default,,0,0,0,,Не? Жалғызсың ба?
Dialogue: 0,1:12:47.90,1:12:51.36,Default,,0,0,0,,Шынымен де, отбасы деген жақсы нәрсе!
Dialogue: 0,1:12:51.49,1:12:54.82,Default,,0,0,0,,Әкесі мен анасы мейірімді бақытты отбасы.
Dialogue: 0,1:12:54.95,1:12:57.70,Default,,0,0,0,,Куу~ Бұл жақсы.
Dialogue: 0,1:12:57.83,1:13:00.16,Default,,0,0,0,,Динаны артта қалдырғаныңызға қуаныштысыз ба?
Dialogue: 0,1:13:00.29,1:13:02.75,Default,,0,0,0,,Ол жақсы әулеттен шыққан қарт, солай ма?
Dialogue: 0,1:13:04.75,1:13:06.46,Default,,0,0,0,,Дина шынымен отбасына ашулы емес пе?
Dialogue: 0,1:13:07.38,1:13:09.13,Default,,0,0,0,,Мен өмір бойы сонда тұрдым...
Dialogue: 0,1:13:09.25,1:13:11.34,Default,,0,0,0,,Сіз зерттеуді жалғастыратыныңызды айттыңыз...
Dialogue: 0,1:13:11.47,1:13:13.09,Default,,0,0,0,,Жақсы әулеттен шыққан қария болсаң да—
Dialogue: 0,1:13:13.22,1:13:14.51,Default,,0,0,0,,Бұл мағынасы жоқ, солай емес пе?
Dialogue: 0,1:13:14.64,1:13:15.47,Default,,0,0,0,,Ах
Dialogue: 0,1:13:16.10,1:13:19.01,Default,,0,0,0,,♪Дәмді торт Ня Көзсіз елес
Dialogue: 0,1:13:19.14,1:13:21.31,Default,,0,0,0,,Уу~ Бұл лай
Dialogue: 0,1:13:21.43,1:13:24.48,Default,,0,0,0,,♪Nobbera Adventure Fumidashi Egg
Dialogue: 0,1:13:24.60,1:13:25.48,Default,,0,0,0,,Жұмыртқа
Dialogue: 0,1:13:25.60,1:13:27.65,Default,,0,0,0,,♪Морн Блан Блан Блан
Dialogue: 0,1:13:27.77,1:13:28.77,Default,,0,0,0,,♪Әткеншекте
Dialogue: 0,1:13:28.90,1:13:31.44,Default,,0,0,0,,♪Мұхитта серфинг
Dialogue: 0,1:13:32.03,1:13:36.82,Default,,0,0,0,,♪ Харамаки Норимаки Койномачи
Dialogue: 0,1:13:37.37,1:13:39.91,Default,,0,0,0,,♪Аа, жарайды.
Dialogue: 0,1:13:40.04,1:13:42.54,Default,,0,0,0,,♪Қараңдаршы, жарайды.
Dialogue: 0,1:13:42.66,1:13:47.33,Default,,0,0,0,,♪Жақсы.
Dialogue: 0,1:13:48.09,1:13:49.34,Default,,0,0,0,,Жақсы немесе жаман
Dialogue: 0,1:13:49.46,1:13:53.76,Default,,0,0,0,,Мм, бүгін де жақсы күн.
Dialogue: 0,1:13:58.68,1:14:02.18,Default,,0,0,0,,♪Пісірілген магомаго магоме жоқ шукуба
Dialogue: 0,1:14:02.31,1:14:03.98,Default,,0,0,0,,Кел, Ясуэ
Dialogue: 0,1:14:04.10,1:14:07.02,Default,,0,0,0,,♪Бітті.
Dialogue: 0,1:14:07.15,1:14:08.31,Default,,0,0,0,,Ура
Dialogue: 0,1:14:08.44,1:14:10.27,Default,,0,0,0,,♪ Обанзай Зайзай
Dialogue: 0,1:14:10.40,1:14:11.44,Default,,0,0,0,,♪Шындықты табу
Dialogue: 0,1:14:11.57,1:14:14.07,Default,,0,0,0,,♪Ал, ұры, қараңғыда
Dialogue: 0,1:14:14.78,1:14:18.87,Default,,0,0,0,,♪ Қате Соримачи Рапсодиясы
Dialogue: 0,1:14:18.99,1:14:19.95,Default,,0,0,0,,Аа, солай.
Dialogue: 0,1:14:20.08,1:14:22.62,Default,,0,0,0,,♪Аа, жарайды.
Dialogue: 0,1:14:22.74,1:14:25.29,Default,,0,0,0,,♪Қараңдаршы, жарайды.
Dialogue: 0,1:14:25.41,1:14:27.88,Default,,0,0,0,,♪Жақсы.
Dialogue: 0,1:14:28.00,1:14:29.04,Default,,0,0,0,,Оны маған беріңіз -
Dialogue: 0,1:14:29.17,1:14:30.46,Default,,0,0,0,,Мені Дина сұрады.
Dialogue: 0,1:14:31.42,1:14:33.05,Default,,0,0,0,,Егер сіз мұны жеткізсеңіз, Динаның—
Dialogue: 0,1:14:33.17,1:14:36.30,Default,,0,0,0,,Ана мен әке, сіз таң қаласыз.
Dialogue: 0,1:14:36.43,1:14:37.97,Default,,0,0,0,,Бірақ мен бай болғандықтан...
Dialogue: 0,1:14:38.51,1:14:39.64,Default,,0,0,0,,Сізге жеткізілді—
Dialogue: 0,1:14:39.76,1:14:42.18,Default,,0,0,0,,Ол сізге үлкен той беруі мүмкін!
Dialogue: 0,1:14:42.31,1:14:42.89,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:14:43.27,1:14:44.02,Default,,0,0,0,,Өйткені ол өркен
Dialogue: 0,1:14:44.02,1:14:44.64,Default,,0,0,0,,Өскін, немесе сенің тойың ғой...
Dialogue: 0,1:14:44.64,1:14:44.77,Default,,0,0,0,,Сіздің мерекеңіз...
Dialogue: 0,1:14:44.77,1:14:46.06,Default,,0,0,0,,Сіздің мерекеңіз... Омори Рамен сияқты.
Dialogue: 0,1:14:52.36,1:14:54.40,Default,,0,0,0,,♪Маған бәрібір.
Dialogue: 0,1:14:54.74,1:14:55.61,Default,,0,0,0,,Сәлем
Dialogue: 0,1:14:55.74,1:14:57.45,Default,,0,0,0,,Ха ха ха ха ха ха ха
Dialogue: 0,1:14:57.57,1:14:58.45,Default,,0,0,0,,Сәлем
Dialogue: 0,1:14:58.66,1:14:59.87,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,1:14:59.99,1:15:01.53,Default,,0,0,0,,Керемет балалар
Dialogue: 0,1:15:05.41,1:15:06.62,Default,,0,0,0,,♪Жақсы, жаман
Dialogue: 0,1:15:06.75,1:15:08.17,Default,,0,0,0,,♪Жақсы
Dialogue: 0,1:15:08.29,1:15:09.33,Default,,0,0,0,,♪Маған бәрібір.
Dialogue: 0,1:15:09.46,1:15:12.50,Default,,0,0,0,,♪Маған бәрібір.
Dialogue: 0,1:15:12.63,1:15:14.63,Default,,0,0,0,,Зорори мырза, бірдеңе жасаңыз.
Dialogue: 0,1:15:14.76,1:15:18.63,Default,,0,0,0,,Жарайды, мен сенімен бірге болғанда
Dialogue: 0,1:15:18.76,1:15:21.14,Default,,0,0,0,,Бұл ең абайсызда... сіз қалай ойлайсыз?
Dialogue: 0,1:15:21.26,1:15:22.93,Default,,0,0,0,,Уфууааа
Dialogue: 0,1:15:25.97,1:15:26.85,Default,,0,0,0,,Иә
Dialogue: 0,1:15:26.98,1:15:28.39,Default,,0,0,0,,♪Маған бәрібір
Dialogue: 0,1:15:28.52,1:15:29.90,Default,,0,0,0,,♪Маған бәрібір
Dialogue: 0,1:15:40.11,1:15:42.62,Default,,0,0,0,,♪Маған бәрібір
Dialogue: 0,1:15:43.49,1:15:45.99,Default,,0,0,0,,Балалар, уайымдамаңдар.
Dialogue: 0,1:15:48.08,1:15:51.75,Default,,0,0,0,,♪Жіңішке пісірілген ыстық жұмыртқа
Dialogue: 0,1:15:51.88,1:15:53.34,Default,,0,0,0,,Жұмыртқа
Dialogue: 0,1:15:53.46,1:15:56.59,Default,,0,0,0,,♪Тамақ ішпе, сөйлеспе, Янбару Куина
Dialogue: 0,1:15:56.71,1:15:57.59,Default,,0,0,0,,Виви
Dialogue: 0,1:15:57.71,1:16:01.13,Default,,0,0,0,,♪Турнбарин Баринбарин
Dialogue: 0,1:16:01.26,1:16:02.84,Default,,0,0,0,,♪ Барин және өзгерту
Dialogue: 0,1:16:02.97,1:16:06.64,Default,,0,0,0,,♪Аспандағы сенбей күріш крекері
Dialogue: 0,1:16:06.77,1:16:08.64,Default,,0,0,0,,Ах
Dialogue: 0,1:16:09.39,1:16:13.65,Default,,0,0,0,,♪ Чаран Поранның коллагені
Dialogue: 0,1:16:13.77,1:16:14.57,Default,,0,0,0,,Иә жоқ жоқ
Dialogue: 0,1:16:14.69,1:16:16.65,Default,,0,0,0,,♪А, жарайды.
Dialogue: 0,1:16:17.44,1:16:20.11,Default,,0,0,0,,♪Қараңдаршы, жарайды.
Dialogue: 0,1:16:20.24,1:16:22.61,Default,,0,0,0,,♪Маған бәрібір
Dialogue: 0,1:16:22.74,1:16:25.28,Default,,0,0,0,,♪Аа, жарайды.
Dialogue: 0,1:16:25.41,1:16:27.24,Default,,0,0,0,,♪Қараңызшы, бәрі жақсы.
Dialogue: 0,1:16:28.08,1:16:30.58,Default,,0,0,0,,♪Аа, жарайды.
Dialogue: 0,1:16:30.71,1:16:32.46,Default,,0,0,0,,♪Қараңызшы, жарайды.
Dialogue: 0,1:16:33.33,1:16:35.13,Default,,0,0,0,,Сіз де жақсы және жылдамсыз...
Dialogue: 0,1:16:35.25,1:16:36.34,Default,,0,0,0,,Ойоме-сан!
Dialogue: 0,1:16:36.46,1:16:37.80,Default,,0,0,0,,Және тамаша...
Dialogue: 0,1:16:37.92,1:16:39.01,Default,,0,0,0,,Широ!
Dialogue: 0,1:16:39.34,1:16:40.72,Default,,0,0,0,,алу...
Dialogue: 0,1:16:40.84,1:16:42.84,Default,,0,0,0,,Мен Зорори отбасын құруым керек!
Dialogue: 0,1:16:43.26,1:16:44.93,Default,,0,0,0,,Бұл өкінішті мәңгі бойымен арқалап жүремін.
Dialogue: 0,1:16:45.05,1:16:48.35,Default,,0,0,0,,Маған қарашы, анашым! (Ишиши Ношиши) Хахахаха
Dialogue: 0,1:16:50.77,1:16:53.81,Default,,0,0,0,,♪Маған бәрібір.
