Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.96,0:00:05.67,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:05.75,0:00:07.79,Default,,0,0,0,,Мен де саған бір нәрсемен көмектесемін.
Dialogue: 0,0:00:07.88,0:00:09.80,Default,,0,0,0,,Ей, оян.
Dialogue: 0,0:00:09.88,0:00:11.59,Default,,0,0,0,,Рейна
Dialogue: 0,0:00:14.63,0:00:16.51,Default,,0,0,0,,♪ Қайырлы таң
Dialogue: 0,0:00:16.59,0:00:21.14,Default,,0,0,0,,♪ Бүгін таңғы асқа не бар?
Dialogue: 0,0:00:21.22,0:00:22.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:22.39,0:00:24.19,Default,,0,0,0,,Келесі жолы сынып қойылымында.
Dialogue: 0,0:00:24.27,0:00:26.77,Default,,0,0,0,,Өйткені мен мюзикл түсіруді шештім.
Dialogue: 0,0:00:26.86,0:00:28.36,Default,,0,0,0,,Бұл тәжірибе.
Dialogue: 0,0:00:29.52,0:00:31.03,Default,,0,0,0,,Музыкалық…
Dialogue: 0,0:00:33.32,0:00:38.37,Default,,0,0,0,,♪ Бүгін бізде Реннің сүйікті қуырылған тауық еті бар.
Dialogue: 0,0:00:38.45,0:00:42.04,Default,,0,0,0,,♪ Кинпира лопуха ~
Dialogue: 0,0:00:42.12,0:00:45.83,Default,,0,0,0,,Рейна Ни Қызық Мен көбірек көргім келеді!
Dialogue: 0,0:00:45.92,0:00:48.50,Default,,0,0,0,,Иә, мен сенің керемет талантың бар екенін сезіндім.
Dialogue: 0,0:00:51.05,0:00:56.05,Default,,0,0,0,,♪～
Dialogue: 0,0:02:15.71,0:02:19.72,Default,,0,0,0,,～♪
Dialogue: 0,0:02:28.69,0:02:30.02,Default,,0,0,0,,Қайырлы таң, Таманаха-сан
Dialogue: 0,0:02:30.10,0:02:31.73,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:02:31.81,0:02:32.94,Default,,0,0,0,,Райду-кун
Dialogue: 0,0:02:33.02,0:02:34.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:35.86,0:02:39.90,Default,,0,0,0,,♪ Қайырлы таң Райду-кун
Dialogue: 0,0:02:39.99,0:02:42.74,Default,,0,0,0,,♪ Қалайсың?
Dialogue: 0,0:02:42.82,0:02:44.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:44.16,0:02:48.66,Default,,0,0,0,,Ахарен мырза кенет менімен музыкалық үнмен сөйлесті!
Dialogue: 0,0:02:48.75,0:02:51.75,Default,,0,0,0,,Жоқ, таңқаларлық ештеңе жоқ.
Dialogue: 0,0:02:51.83,0:02:54.00,Default,,0,0,0,,Мюзиклде ән мен би болады
Dialogue: 0,0:02:54.09,0:02:56.30,Default,,0,0,0,,Сезімдерін білдіру, сендіру, т.б.
Dialogue: 0,0:02:56.38,0:03:00.51,Default,,0,0,0,,Көбінесе біреуге хабарды қатты жеткізу үшін қолданылады
Dialogue: 0,0:03:00.59,0:03:04.39,Default,,0,0,0,,Дауысы кішкентай және мимикасы жоқ Ахарен мырзаға да солай.
Dialogue: 0,0:03:04.47,0:03:06.89,Default,,0,0,0,,Бұл оны білдірудің тамаша тәсілі.
Dialogue: 0,0:03:06.97,0:03:09.10,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:03:09.73,0:03:12.23,Default,,0,0,0,,Ахареннің ән айтып, билегенін көру
Dialogue: 0,0:03:12.90,0:03:14.36,Default,,0,0,0,,Дәл мен сияқты
Dialogue: 0,0:03:14.44,0:03:15.77,Default,,0,0,0,,♪ Мюзикл әлеміне
Dialogue: 0,0:03:15.86,0:03:18.65,Default,,0,0,0,,♪ Мен өзімді сол жерде жүргендей сезінемін~
Dialogue: 0,0:03:18.74,0:03:20.28,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:03:22.61,0:03:24.87,Default,,0,0,0,,♪ Уайымдамаңыз
Dialogue: 0,0:03:25.41,0:03:29.95,Default,,0,0,0,,♪ Бүгін өзімді жақсы сезінемін~
Dialogue: 0,0:03:30.04,0:03:31.92,Default,,0,0,0,,Ой...
Dialogue: 0,0:03:32.00,0:03:34.29,Default,,0,0,0,,Ахарен мырза қуанады.
Dialogue: 0,0:03:34.38,0:03:36.42,Default,,0,0,0,,Мюзиклдер тиімді.
Dialogue: 0,0:03:36.50,0:03:37.38,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:37.46,0:03:39.21,Default,,0,0,0,,Қайырлы таң Райдоу
Dialogue: 0,0:03:39.30,0:03:40.59,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:40.67,0:03:43.18,Default,,0,0,0,,♪ Қайырлы таң екеуіңе де.
Dialogue: 0,0:03:43.26,0:03:44.14,Default,,0,0,0,,♪ Ертеңгі сынақ
Dialogue: 0,0:03:44.22,0:03:47.06,Default,,0,0,0,,♪ Мен мүлде оқымадым~
Dialogue: 0,0:03:47.14,0:03:50.93,Default,,0,0,0,,♪ Өзіңізді қандай болсаңыз, солай сынаңыз.
Dialogue: 0,0:03:51.02,0:03:53.06,Default,,0,0,0,,♪ Біз де
Dialogue: 0,0:03:53.14,0:03:55.77,Default,,0,0,0,,♪ Мүлдем орындалмады
Dialogue: 0,0:03:55.86,0:03:57.65,Default,,0,0,0,,♪ Бақытсыз
Dialogue: 0,0:03:59.94,0:04:03.24,Default,,0,0,0,,♪ Қайырлы таң, Оширо-сан
Dialogue: 0,0:04:03.32,0:04:05.82,Default,,0,0,0,,♪ Бүгін ауа-райы жақсы~
Dialogue: 0,0:04:07.45,0:04:08.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:08.37,0:04:13.00,Default,,0,0,0,,♪ Бірақ күндіз жаңбыр жауады
Dialogue: 0,0:04:13.08,0:04:15.50,Default,,0,0,0,,♪ Кішкене салқын~
Dialogue: 0,0:04:16.08,0:04:17.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:17.46,0:04:19.38,Default,,0,0,0,,Е, бұл қандай көңіл-күй?
Dialogue: 0,0:04:19.46,0:04:21.21,Default,,0,0,0,,Мен қорқамын, маған жақындама
Dialogue: 0,0:04:22.72,0:04:26.14,Default,,0,0,0,,Енді классикалық жапон тілі сабағын бастайық.
Dialogue: 0,0:04:26.22,0:04:28.30,Default,,0,0,0,,Материалдарды басып шығарыңыз.
Dialogue: 0,0:04:28.97,0:04:31.52,Default,,0,0,0,,Мен оны мүлдем ұмытып кеттім.
Dialogue: 0,0:04:32.73,0:04:34.23,Default,,0,0,0,,♪ Ахарен мырза
Dialogue: 0,0:04:34.77,0:04:37.48,Default,,0,0,0,,♪ Басып шығару Мен ұмытып кеткендіктен
Dialogue: 0,0:04:37.56,0:04:40.36,Default,,0,0,0,,♪ Маған көрсетіңізші.
Dialogue: 0,0:04:40.44,0:04:42.94,Default,,0,0,0,,♪ Уайымдамаңыз
Dialogue: 0,0:04:43.03,0:04:45.36,Default,,0,0,0,,♪ Орындар бір-біріне жақын
Dialogue: 0,0:04:45.45,0:04:48.16,Default,,0,0,0,,♪ Бірге тамашалайық~
Dialogue: 0,0:04:48.83,0:04:51.45,Default,,0,0,0,,Бұл екі адам ән арқылы сөйлеседі.
Dialogue: 0,0:04:51.54,0:04:54.29,Default,,0,0,0,,Бұл... Вака!
Dialogue: 0,0:04:54.37,0:04:55.58,Default,,0,0,0,,Хэйан дәуірінде
Dialogue: 0,0:04:55.67,0:04:58.71,Default,,0,0,0,,Біреу маған ән шығарайын десе, мен әнмен жауап берер едім.
Dialogue: 0,0:04:58.79,0:05:00.96,Default,,0,0,0,,Бұл екі адам әнді қазіргі заманға ауыстырған.
Dialogue: 0,0:05:01.05,0:05:02.38,Default,,0,0,0,,Мюзикл сияқты
Dialogue: 0,0:05:02.46,0:05:05.43,Default,,0,0,0,,Сіз Хейан ақсүйегі болып көрінесіз.
Dialogue: 0,0:05:05.51,0:05:10.64,Default,,0,0,0,,Бұл Нью-Йорктегі Бродвей сияқты!
Dialogue: 0,0:05:10.72,0:05:11.76,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:05:12.68,0:05:14.31,Default,,0,0,0,,С…
Dialogue: 0,0:05:14.39,0:05:18.35,Default,,0,0,0,,Мен оны өзім көтере аламын деп тым итермеуім керек еді.
Dialogue: 0,0:05:18.44,0:05:19.81,Default,,0,0,0,,♪ Мұғалім
Dialogue: 0,0:05:19.90,0:05:21.44,Default,,0,0,0,,♪ Жақсысың ба?
Dialogue: 0,0:05:21.52,0:05:24.11,Default,,0,0,0,,♪ Қаласаңыз, аламыз
Dialogue: 0,0:05:24.19,0:05:26.11,Default,,0,0,0,,♪ Мен саған көмектесемін~
Dialogue: 0,0:05:26.20,0:05:27.70,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:05:28.28,0:05:29.66,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:05:29.74,0:05:32.87,Default,,0,0,0,,Уф... Уау, бұл пайдалы болды.
Dialogue: 0,0:05:32.95,0:05:35.87,Default,,0,0,0,,Қазір мен түстен кейінгі презентацияға уақытында келдім.
Dialogue: 0,0:05:35.96,0:05:39.00,Default,,0,0,0,,♪ Қош келдіңіз~
Dialogue: 0,0:05:39.08,0:05:42.34,Default,,0,0,0,,Жарайды... Онда сабақта кездесеміз.
Dialogue: 0,0:05:43.80,0:05:45.21,Default,,0,0,0,,Хмм... (Рейнаның иіскеген дыбысы)
Dialogue: 0,0:05:45.30,0:05:47.84,Default,,0,0,0,,Мм... Ахарен мырза
Dialogue: 0,0:05:48.43,0:05:51.18,Default,,0,0,0,,Ахарен мырза асыл көрінеді
Dialogue: 0,0:05:51.26,0:05:53.06,Default,,0,0,0,,Ал раушан гүлдерінің иісі...
Dialogue: 0,0:05:54.60,0:05:57.98,Default,,0,0,0,,О, не болды? Граф Райду
Dialogue: 0,0:05:58.06,0:05:59.73,Default,,0,0,0,,Асылдық
Dialogue: 0,0:06:00.31,0:06:04.98,Default,,0,0,0,,Ахарен мырза бастапқыда әдемі және асыл ақсүйек болған!
Dialogue: 0,0:06:05.07,0:06:07.15,Default,,0,0,0,,Барлығы раушан гүлінің иісінен басталды.
Dialogue: 0,0:06:07.24,0:06:10.37,Default,,0,0,0,,Бұл менің мінез-құлқымда табиғи түрде көріне бастады.
Dialogue: 0,0:06:11.49,0:06:14.08,Default,,0,0,0,,Енді сыныпқа оралайық.
Dialogue: 0,0:06:14.16,0:06:15.75,Default,,0,0,0,,Міне... Ахарен мырза
Dialogue: 0,0:06:15.83,0:06:17.79,Default,,0,0,0,,Осылай бір-біріне жабыссақ
Dialogue: 0,0:06:17.87,0:06:21.00,Default,,0,0,0,,Хош иіс тарайды, тіпті мен асыл боламын...
Dialogue: 0,0:06:21.63,0:06:23.71,Default,,0,0,0,,Бұл айналды
Dialogue: 0,0:06:24.30,0:06:25.80,Default,,0,0,0,,Бұл мәселе...
Dialogue: 0,0:06:25.88,0:06:29.18,Default,,0,0,0,,«Бүгін менімен түскі ас ішкіңіз келе ме?»
Dialogue: 0,0:06:29.26,0:06:31.51,Default,,0,0,0,,Мен Аха-чанды шақырмақ болдым...
Dialogue: 0,0:06:33.93,0:06:37.56,Default,,0,0,0,,Мен адамдарды кездейсоқ шақырмауым керек сияқты.
Dialogue: 0,0:06:37.64,0:06:39.39,Default,,0,0,0,,Эрл Райду
Dialogue: 0,0:06:39.48,0:06:43.02,Default,,0,0,0,,Қаласаңыз, бірге түскі ас ішуді қалайсыз ба?
Dialogue: 0,0:06:43.11,0:06:47.99,Default,,0,0,0,,Мен сіздің жылы сөздеріңізді бағалаймын, бірақ мен түскі қорапты бүгін әкелген жоқпын...
Dialogue: 0,0:06:48.07,0:06:52.62,Default,,0,0,0,,О, онда нан сатып алайық.
Dialogue: 0,0:06:52.70,0:06:54.37,Default,,0,0,0,,Қуанышпен
Dialogue: 0,0:06:55.16,0:06:57.04,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:06:57.12,0:06:58.70,Default,,0,0,0,,Туна майо сэндвич апай!
Dialogue: 0,0:06:58.79,0:07:00.46,Default,,0,0,0,,Лосось онигири және чизбургер!
Dialogue: 0,0:07:00.54,0:07:01.37,Default,,0,0,0,,Мен Якисоба нанымын!
Dialogue: 0,0:07:01.46,0:07:02.33,Default,,0,0,0,,Мен де Мен де!
Dialogue: 0,0:07:02.42,0:07:05.04,Default,,0,0,0,,Өте жанды
Dialogue: 0,0:07:05.84,0:07:07.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:07.84,0:07:09.42,Default,,0,0,0,,Хаха!
Dialogue: 0,0:07:09.51,0:07:11.47,Default,,0,0,0,,Хмм, мен көмектесе алмаймын.
Dialogue: 0,0:07:12.39,0:07:15.89,Default,,0,0,0,,Нан жейміз бе?
Dialogue: 0,0:07:16.47,0:07:17.85,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:20.39,0:07:21.81,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:07:22.85,0:07:25.52,Default,,0,0,0,,Міне...
Dialogue: 0,0:07:26.11,0:07:28.99,Default,,0,0,0,,♪ Аштан өлемін, құрғаймын~
Dialogue: 0,0:07:29.07,0:07:31.82,Default,,0,0,0,,♪ Уайымдамаңыз
Dialogue: 0,0:07:31.90,0:07:34.82,Default,,0,0,0,,♪ Нан жоқ болса, торт ал...
Dialogue: 0,0:07:34.91,0:07:39.45,Default,,0,0,0,,♪ Жоқ, тек күрішті же.
Dialogue: 0,0:07:40.04,0:07:41.37,Default,,0,0,0,,♪ Рахмет
Dialogue: 0,0:07:41.46,0:07:44.29,Default,,0,0,0,,♪ Өте дәмді көрінетін күріш
Dialogue: 0,0:07:44.38,0:07:46.79,Default,,0,0,0,,♪ Бірақ мен оны ала алмаймын!
Dialogue: 0,0:07:46.88,0:07:50.30,Default,,0,0,0,,♪ Өйткені бұл сіздің бағалы күрішіңіз~
Dialogue: 0,0:07:50.88,0:07:53.38,Default,,0,0,0,,♪ Сіз бәрінен де маңыздысыз
Dialogue: 0,0:07:53.47,0:07:55.51,Default,,0,0,0,,♪ Құрбандық құнымен өмір сүру
Dialogue: 0,0:07:55.60,0:07:57.97,Default,,0,0,0,,♪ Мен олай ойламаймын.
Dialogue: 0,0:07:58.56,0:08:01.27,Default,,0,0,0,,♪ Мен сіздің шешіміңізді түсінемін.
Dialogue: 0,0:08:01.77,0:08:06.19,Default,,0,0,0,,♪ Бірақ мен не болса да жақсы боламын
Dialogue: 0,0:08:06.86,0:08:07.94,Default,,0,0,0,,♪ Өйткені мен
Dialogue: 0,0:08:08.02,0:08:11.15,Default,,0,0,0,,♪ Өйткені сен маңыздысың~
Dialogue: 0,0:08:11.24,0:08:12.86,Default,,0,0,0,,Әй, Рейна!
Dialogue: 0,0:08:12.95,0:08:14.57,Default,,0,0,0,,Эрл Райду!
Dialogue: 0,0:08:14.66,0:08:18.12,Default,,0,0,0,,♪ Сонда бұл күріш екі адамға арналған.
Dialogue: 0,0:08:18.20,0:08:21.54,Default,,0,0,0,,♪ Бөлісейік~
Dialogue: 0,0:08:21.62,0:08:25.29,Default,,0,0,0,,Ах... екеуің қандай қымбатсыңдар.
Dialogue: 0,0:08:25.37,0:08:27.50,Default,,0,0,0,,Бұл нағыз махаббат!
Dialogue: 0,0:08:27.59,0:08:30.05,Default,,0,0,0,,♪ Қаласаңыз
Dialogue: 0,0:08:30.13,0:08:32.51,Default,,0,0,0,,♪ біздің нан
Dialogue: 0,0:08:32.59,0:08:34.72,Default,,0,0,0,,♪ Біздің күріш
Dialogue: 0,0:08:34.80,0:08:39.43,Default,,0,0,0,,♪ Өтінемін, жеп қойыңыз.
Dialogue: 0,0:08:41.97,0:08:45.35,Default,,0,0,0,,Өзгелердің қамын ойлау сезімі
Dialogue: 0,0:08:45.85,0:08:48.98,Default,,0,0,0,,Бөлінген адамдардың ойлары біртұтас болды
Dialogue: 0,0:08:49.77,0:08:51.36,Default,,0,0,0,,Бұл дәл…
Dialogue: 0,0:08:52.03,0:08:55.24,Default,,0,0,0,,Француз революциясы Ренессанс Қоян!
Dialogue: 0,0:08:57.11,0:08:59.37,Default,,0,0,0,,Музыка шынымен керемет, солай емес пе?
Dialogue: 0,0:08:59.95,0:09:02.33,Default,,0,0,0,,Иә, шынымен
Dialogue: 0,0:09:02.41,0:09:03.54,Default,,0,0,0,,Мюзиклге
Dialogue: 0,0:09:03.62,0:09:07.12,Default,,0,0,0,,Адамдардың жүрегін бұлай елжірететін құдіреті барын білмедім.
Dialogue: 0,0:09:07.21,0:09:11.13,Default,,0,0,0,,Сонда да Ахарен мырзаның бүгінгі мінез-құлқына қарап.
Dialogue: 0,0:09:11.21,0:09:14.01,Default,,0,0,0,,Асыл азамат екеніне күмән жоқ.
Dialogue: 0,0:09:14.09,0:09:15.84,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:09:15.93,0:09:17.72,Default,,0,0,0,,Мен де асыл адаммын
Dialogue: 0,0:09:17.80,0:09:22.81,Default,,0,0,0,,Тектіліктің үлкен мәселесі бар.
Dialogue: 0,0:09:22.89,0:09:23.98,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:24.64,0:09:26.10,Default,,0,0,0,,Саяси неке!
Dialogue: 0,0:09:26.60,0:09:29.44,Default,,0,0,0,,Ешқайсымыз қаламаған келісім жасауымыз керек.
Dialogue: 0,0:09:29.52,0:09:32.90,Default,,0,0,0,,Еркін махаббатқа ешқашан жол берілмейді
Dialogue: 0,0:09:33.94,0:09:35.86,Default,,0,0,0,,Біз бірдеңе істеуіміз керек!
Dialogue: 0,0:09:35.95,0:09:37.82,Default,,0,0,0,,Жоқ… жоқ
Dialogue: 0,0:09:37.91,0:09:41.58,Default,,0,0,0,,Маған пудинг қалмады!
Dialogue: 0,0:09:41.66,0:09:43.33,Default,,0,0,0,,Мен үйге енді келдім.
Dialogue: 0,0:09:43.41,0:09:47.04,Default,,0,0,0,,Бауырым, сен менің пудингімді рұқсатсыз жедің!
Dialogue: 0,0:09:47.62,0:09:50.25,Default,,0,0,0,,H... Бұл өте нашар даму.
Dialogue: 0,0:09:50.33,0:09:54.96,Default,,0,0,0,,Бірақ қазір менде адамдардың жүрегін елжірететін ән бар!
Dialogue: 0,0:09:55.59,0:09:56.67,Default,,0,0,0,,Бұл керемет, Широ-сан. Шынымен де, бұл мүлде басқа деңгей.
Dialogue: 0,0:09:56.76,0:09:57.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:58.68,0:10:03.10,Default,,0,0,0,,♪ Бір ғана пудинг қалды
Dialogue: 0,0:10:03.18,0:10:08.31,Default,,0,0,0,,♪ Мен бәрін жеп қойдым.
Dialogue: 0,0:10:08.39,0:10:14.03,Default,,0,0,0,,♪ Күнәларымды кешіре гөр~
Dialogue: 0,0:10:14.65,0:10:17.07,Default,,0,0,0,,Сіз тіпті сөйлей алмайсыз ба?
Dialogue: 0,0:10:17.57,0:10:20.49,Default,,0,0,0,,Мюзикл күткендей керемет.
Dialogue: 0,0:10:20.57,0:10:23.41,Default,,0,0,0,,Қорқынышты! Мен оны мұқият ұстадым
Dialogue: 0,0:10:23.49,0:10:24.70,Default,,0,0,0,,Бұл адам емес!
Dialogue: 0,0:10:24.79,0:10:25.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:25.75,0:10:29.08,Default,,0,0,0,,Кенет қорқынышты ән айта бастайды
Dialogue: 0,0:10:29.17,0:10:32.75,Default,,0,0,0,,Енді жоқ, мен сені жек көремін, ақымақ!
Dialogue: 0,0:10:32.84,0:10:34.00,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:34.09,0:10:35.17,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:10:35.25,0:10:36.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:36.17,0:10:38.26,Default,,0,0,0,,А, сен үйде болдың.
Dialogue: 0,0:10:38.34,0:10:42.14,Default,,0,0,0,,Дұрыс, менің шежіремді сұрадың.
Dialogue: 0,0:10:42.22,0:10:44.31,Default,,0,0,0,,Менің атам оны электрондық пошта арқылы жіберді.
Dialogue: 0,0:10:44.39,0:10:45.56,Default,,0,0,0,,Иә
Dialogue: 0,0:10:45.64,0:10:47.56,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:10:50.77,0:10:52.19,Default,,0,0,0,,Сіз қарапайым адамсыз ба?
Dialogue: 0,0:10:55.98,0:10:58.11,Default,,0,0,0,,Қорытынды емтиханға да аз қалды.
Dialogue: 0,0:10:58.19,0:10:59.36,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:59.45,0:11:00.91,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз сенімдісіз бе?
Dialogue: 0,0:11:00.99,0:11:02.57,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:11:07.33,0:11:09.54,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:11:09.62,0:11:14.46,Default,,0,0,0,,Менің арманым – достарыммен сабақ өткізу!
Dialogue: 0,0:11:15.04,0:11:17.67,Default,,0,0,0,,Бұл мүшенің достық деңгейі артып келеді.
Dialogue: 0,0:11:17.76,0:11:20.93,Default,,0,0,0,,Мұндай оқиға орын алса, таң қалмас еді.
Dialogue: 0,0:11:21.01,0:11:24.18,Default,,0,0,0,,Сондықтан келесі жолы мен сізді шақырамын!
Dialogue: 0,0:11:24.26,0:11:26.39,Default,,0,0,0,,Эй... эй!
Dialogue: 0,0:11:26.97,0:11:30.60,Default,,0,0,0,,Тест өте жақын, неге бәріміз оқу сабағын өткізбейміз?
Dialogue: 0,0:11:31.31,0:11:32.65,Default,,0,0,0,,Оқу сессиясы…
Dialogue: 0,0:11:32.73,0:11:35.23,Default,,0,0,0,,Жоқ... ұнамаса, бұл проблема емес.
Dialogue: 0,0:11:35.31,0:11:36.69,Default,,0,0,0,,-Ұнайды -Иә
Dialogue: 0,0:11:36.77,0:11:39.15,Default,,0,0,0,,Мен жай ғана оқығым келді.
Dialogue: 0,0:11:39.24,0:11:42.36,Default,,0,0,0,,Иә! Мен батылдық танытқаныма қуаныштымын
Dialogue: 0,0:11:42.45,0:11:43.86,Default,,0,0,0,,Жарайды, осылай жүре бер...
Dialogue: 0,0:11:43.95,0:11:47.58,Default,,0,0,0,,Сато және Исикава мырзамен зерттеу сабағын өткізгіңіз келе ме?
Dialogue: 0,0:11:49.91,0:11:50.75,Default,,0,0,0,,Мен де?
Dialogue: 0,0:11:50.83,0:11:52.46,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:11:52.54,0:11:53.71,Default,,0,0,0,,Бәріміз бірге орындайық
Dialogue: 0,0:11:54.29,0:11:57.42,Default,,0,0,0,,А, мен...
Dialogue: 0,0:11:57.50,0:12:00.63,Default,,0,0,0,,Иә, мен мұны істеймін. Исикава-кун да солай жасайды!
Dialogue: 0,0:12:00.72,0:12:03.18,Default,,0,0,0,,Иә! Олай болса, мектептен кейін.
Dialogue: 0,0:12:03.26,0:12:04.09,Default,,0,0,0,,Иә
Dialogue: 0,0:12:11.14,0:12:11.98,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:14.52,0:12:18.61,Default,,0,0,0,,Барлығы мен ойлағаннан да байыпты оқуда.
Dialogue: 0,0:12:19.11,0:12:23.90,Default,,0,0,0,,Мен оқу сабағын өткізбеймін, өйткені мен оқығым келеді.
Dialogue: 0,0:12:23.99,0:12:27.83,Default,,0,0,0,,Менің бүгін бір ісім бар, ал менің жақсы досым Оширо-сан да жоқ.
Dialogue: 0,0:12:27.83,0:12:28.49,Default,,0,0,0,,Менің бүгін бір ісім бар, ал менің жақсы досым Оширо-сан да жоқ.
Dialogue: 0,0:12:27.83,0:12:28.49,Default,,0,0,0,,Кешіріңіз~
Dialogue: 0,0:12:28.49,0:12:28.58,Default,,0,0,0,,Кешіріңіз~
Dialogue: 0,0:12:28.58,0:12:29.49,Default,,0,0,0,,Кешіріңіз~
Dialogue: 0,0:12:28.58,0:12:29.49,Default,,0,0,0,,Оңай сөйлесетін ешкім жоқ
Dialogue: 0,0:12:29.49,0:12:31.50,Default,,0,0,0,,Оңай сөйлесетін ешкім жоқ
Dialogue: 0,0:12:31.58,0:12:33.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:33.29,0:12:35.46,Default,,0,0,0,,Бәріміз бірге жиналсақ та
Dialogue: 0,0:12:36.04,0:12:38.92,Default,,0,0,0,,Оқудан басқа ештеңемен айналыспау босқа кетеді
Dialogue: 0,0:12:39.00,0:12:40.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:40.80,0:12:43.47,Default,,0,0,0,,Хмм, мен шаршадым.
Dialogue: 0,0:12:43.55,0:12:44.63,Default,,0,0,0,,Неге үзіліс жасамайсың?
Dialogue: 0,0:12:45.22,0:12:46.72,Default,,0,0,0,,Біраз ойын ойнайық
Dialogue: 0,0:12:46.80,0:12:51.14,Default,,0,0,0,,А, мен мұны жаңа ғана әкелдім.
Dialogue: 0,0:12:51.22,0:12:53.52,Default,,0,0,0,,Әй, өмір деген ойын ғой!
Dialogue: 0,0:12:53.60,0:12:55.48,Default,,0,0,0,,Бұл соңғы нұсқа.
Dialogue: 0,0:12:57.61,0:13:00.32,Default,,0,0,0,,Не? Жасағыңыз келеді, бірақ оны ешқашан жасамадыңыз ба?
Dialogue: 0,0:13:00.40,0:13:01.23,Default,,0,0,0,,Иә
Dialogue: 0,0:13:01.90,0:13:03.61,Default,,0,0,0,,Негізі сугорокудаши
Dialogue: 0,0:13:03.69,0:13:06.32,Default,,0,0,0,,Ережені үйретемін, жарайды.
Dialogue: 0,0:13:06.91,0:13:08.03,Default,,0,0,0,,Иә
Dialogue: 0,0:13:08.12,0:13:11.49,Default,,0,0,0,,Иә! Енді сіз барлығымен ойнай аласыз
Dialogue: 0,0:13:11.58,0:13:14.33,Default,,0,0,0,,Ал, алдымен тас, қағаз, қайшы ойнап, ретін анықтайық.
Dialogue: 0,0:13:14.41,0:13:16.46,Default,,0,0,0,,Тас, қағаз, қайшы Пон
Dialogue: 0,0:13:16.54,0:13:18.29,Default,,0,0,0,,Айко де Шо
Dialogue: 0,0:13:18.38,0:13:20.71,Default,,0,0,0,,Аха, сосын менен.
Dialogue: 0,0:13:22.63,0:13:23.46,Default,,0,0,0,,３！
Dialogue: 0,0:13:23.55,0:13:27.30,Default,,0,0,0,,Жарайды 1 2 3
Dialogue: 0,0:13:27.38,0:13:30.72,Default,,0,0,0,,«Мен туысқанымнан мектеп бітіру үшін сыйлық алдым».
Dialogue: 0,0:13:30.80,0:13:32.85,Default,,0,0,0,,Иә! Қосымша 50 000 иен
Dialogue: 0,0:13:32.93,0:13:34.31,Default,,0,0,0,,Келесі мен
Dialogue: 0,0:13:36.85,0:13:38.40,Default,,0,0,0,,7...
Dialogue: 0,0:13:38.48,0:13:40.11,Default,,0,0,0,,５ ６ ７
Dialogue: 0,0:13:40.69,0:13:42.90,Default,,0,0,0,,«Мен смартфонымды түсіріп алдым, экран жарылып қалды»
Dialogue: 0,0:13:42.98,0:13:44.19,Default,,0,0,0,,«Минус 200 000»
Dialogue: 0,0:13:44.28,0:13:45.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:45.65,0:13:46.82,Default,,0,0,0,,Сол сияқты
Dialogue: 0,0:13:46.90,0:13:49.57,Default,,0,0,0,,Егер сіз оң шаршыға қонсаңыз, сіз ақша аласыз.
Dialogue: 0,0:13:49.66,0:13:53.37,Default,,0,0,0,,Егер сіз теріс шаршыға тоқтасаңыз, сізге ақша төлеу керек.
Dialogue: 0,0:13:53.45,0:13:54.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:58.33,0:13:59.17,Default,,0,0,0,,5.
Dialogue: 0,0:13:59.25,0:14:01.21,Default,,0,0,0,,４ ５
Dialogue: 0,0:14:01.29,0:14:04.38,Default,,0,0,0,,«Дүниежүзілік қол спиннер жарысында жеңіске жету»
Dialogue: 0,0:14:04.46,0:14:05.97,Default,,0,0,0,,«Плюс 5 миллион иен»
Dialogue: 0,0:14:06.05,0:14:08.13,Default,,0,0,0,,Иә, кенеттен бұл таңқаларлық!
Dialogue: 0,0:14:08.22,0:14:09.68,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:10.43,0:14:12.30,Default,,0,0,0,,4...
Dialogue: 0,0:14:12.39,0:14:16.27,Default,,0,0,0,,«Мен қызғанып, 50 жылдық несиеге пәтер сатып алдым»
Dialogue: 0,0:14:16.35,0:14:19.23,Default,,0,0,0,,«Минус 80 миллион»
Dialogue: 0,0:14:20.15,0:14:21.19,Default,,0,0,0,,８！
Dialogue: 0,0:14:21.27,0:14:24.11,Default,,0,0,0,,Иә! бірден алға
Dialogue: 0,0:14:24.19,0:14:26.86,Default,,0,0,0,,«Менің сүйікті тапиока дүкенім жұмыс істемейді»
Dialogue: 0,0:14:26.94,0:14:29.32,Default,,0,0,0,,«6 шаршыға артқа оралу»
Dialogue: 0,0:14:30.16,0:14:32.07,Default,,0,0,0,,4 5… Ah.
Dialogue: 0,0:14:32.16,0:14:34.03,Default,,0,0,0,,Мамандық таңдау
Dialogue: 0,0:14:34.62,0:14:35.74,Default,,0,0,0,,Компания қызметкері болыңыз
Dialogue: 0,0:14:35.83,0:14:37.50,Default,,0,0,0,,Жалақы 200 000~
Dialogue: 0,0:14:37.58,0:14:40.42,Default,,0,0,0,,Бұл тұрақты табысы бар тұрақты табыс.
Dialogue: 0,0:14:40.50,0:14:41.96,Default,,0,0,0,,Мен де кәсіби массажистпін.
Dialogue: 0,0:14:42.04,0:14:44.92,Default,,0,0,0,,Спортшылардың жалақысы 300 000 иен
Dialogue: 0,0:14:45.00,0:14:48.17,Default,,0,0,0,,Исикава-кун футболда жақсы, тамаша емес пе?
Dialogue: 0,0:14:48.26,0:14:49.13,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:49.22,0:14:51.05,Default,,0,0,0,,Аниматор бол
Dialogue: 0,0:14:51.14,0:14:52.60,Default,,0,0,0,,Жалақы 100 000 иен
Dialogue: 0,0:14:54.43,0:14:57.98,Default,,0,0,0,,Келесі шаршыдағы тапсырмаларды өзгертуге болады, сондықтан оны сақтаңыз.
Dialogue: 0,0:14:58.06,0:14:59.56,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:15:00.64,0:15:02.27,Default,,0,0,0,,Мен де кәсіби массажистпін.
Dialogue: 0,0:15:02.35,0:15:05.86,Default,,0,0,0,,Ендеше, жер мен үйге маркшейдер бол.
Dialogue: 0,0:15:05.94,0:15:07.23,Default,,0,0,0,,Жалақы 200 000 иен
Dialogue: 0,0:15:07.94,0:15:09.70,Default,,0,0,0,,Сіз кенеттен маньяк болдыңыз ба?
Dialogue: 0,0:15:09.78,0:15:13.95,Default,,0,0,0,,Хехехе, менде қандай жұмыс болады?
Dialogue: 0,0:15:14.03,0:15:16.37,Default,,0,0,0,,«Мен сүйікті кумиріме тым көп үлес қостым»
Dialogue: 0,0:15:16.45,0:15:18.83,Default,,0,0,0,,«Минус 500 000»
Dialogue: 0,0:15:19.71,0:15:22.46,Default,,0,0,0,,Осы жерден курстың екі түріне бөлінеді.
Dialogue: 0,0:15:22.54,0:15:25.84,Default,,0,0,0,,Бұл көптеген плюстері бар тұрақты орташа ащы тағам ба?
Dialogue: 0,0:15:25.92,0:15:26.96,Default,,0,0,0,,Теріс массасы көп болғанымен
Dialogue: 0,0:15:27.05,0:15:29.55,Default,,0,0,0,,Кері элементтері бар ащы курс
Dialogue: 0,0:15:29.63,0:15:32.26,Default,,0,0,0,,Менің ойымша, орташа ащы курс
Dialogue: 0,0:15:33.18,0:15:34.30,Default,,0,0,0,,Жалақы күні!
Dialogue: 0,0:15:34.39,0:15:38.14,Default,,0,0,0,,«Баламның туған күнін тойлау үшін барлығы маған 100 000 иен береді».
Dialogue: 0,0:15:38.22,0:15:41.52,Default,,0,0,0,,Иә! жалақы плюс бонус
Dialogue: 0,0:15:41.60,0:15:43.23,Default,,0,0,0,,Мен де орташа ащымын.
Dialogue: 0,0:15:44.02,0:15:46.40,Default,,0,0,0,,«Мен бейтаныс адамнан жұп алдым»
Dialogue: 0,0:15:46.48,0:15:48.44,Default,,0,0,0,,«4 шаршыны артқа қайтару»
Dialogue: 0,0:15:48.53,0:15:50.15,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:15:50.24,0:15:52.61,Default,,0,0,0,,Аа, Ахарен мырза, сіз өте дәмді боласыз ба?
Dialogue: 0,0:15:53.20,0:15:55.62,Default,,0,0,0,,«Сіз виртуалды валютада бонус алған кезде»
Dialogue: 0,0:15:55.70,0:15:57.33,Default,,0,0,0,,«Тарихи толқын»
Dialogue: 0,0:15:57.41,0:15:59.79,Default,,0,0,0,,“1 миллион иен x сүйектер саны”
Dialogue: 0,0:16:02.87,0:16:03.71,Default,,0,0,0,,10！
Dialogue: 0,0:16:03.79,0:16:05.50,Default,,0,0,0,,плюс 10 миллион
Dialogue: 0,0:16:05.58,0:16:07.17,Default,,0,0,0,,Инвестиция маңызды.
Dialogue: 0,0:16:12.76,0:16:13.59,Default,,0,0,0,,«Менің ата-анам үйде»
Dialogue: 0,0:16:13.68,0:16:15.59,Default,,0,0,0,,«Мен күдікті кәстрөл сатып алдым.»
Dialogue: 0,0:16:15.68,0:16:17.51,Default,,0,0,0,,«Минус 5 миллион»
Dialogue: 0,0:16:18.10,0:16:20.06,Default,,0,0,0,,Айырмашылық өте үлкен, солай емес пе?
Dialogue: 0,0:16:21.23,0:16:23.02,Default,,0,0,0,,«Токугава жерленген қазынаны қазу»
Dialogue: 0,0:16:23.10,0:16:24.40,Default,,0,0,0,,«Плюс 20 миллион»
Dialogue: 0,0:16:24.48,0:16:25.73,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:16:25.81,0:16:26.90,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:16:26.98,0:16:30.32,Default,,0,0,0,,Ахарен мырзамен алшақтық барған сайын кеңейіп барады.
Dialogue: 0,0:16:31.03,0:16:32.78,Default,,0,0,0,,Райду-кун
Dialogue: 0,0:16:32.86,0:16:34.61,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:16:35.49,0:16:36.32,Default,,0,0,0,,Әй!
Dialogue: 0,0:16:36.41,0:16:38.58,Default,,0,0,0,,Мен неге сонша әлсізмін?
Dialogue: 0,0:16:39.16,0:16:40.41,Default,,0,0,0,,Күте тұрыңыз, Ахарен мырза.
Dialogue: 0,0:16:41.04,0:16:43.29,Default,,0,0,0,,Мен қазір сені қуып жетуге тырысамын.
Dialogue: 0,0:16:43.37,0:16:44.75,Default,,0,0,0,,２ ３…
Dialogue: 0,0:16:44.83,0:16:47.04,Default,,0,0,0,,О, Райду, жұмысты ауыстыратын кез келді.
Dialogue: 0,0:16:47.13,0:16:49.96,Default,,0,0,0,,Дәрігер немесе заңгер болсаң, жалақың көтеріледі!
Dialogue: 0,0:16:50.05,0:16:53.30,Default,,0,0,0,,Бұл, әрине, ең сенімдісі.
Dialogue: 0,0:16:53.80,0:16:56.09,Default,,0,0,0,,Бірақ бұл қарыз тозақтан құтыл
Dialogue: 0,0:16:56.18,0:16:58.68,Default,,0,0,0,,Ахарен мырзаны қуып жету үшін...
Dialogue: 0,0:16:59.76,0:17:01.14,Default,,0,0,0,,Жұмыс құмар ойыншы болып өзгерді ме?
Dialogue: 0,0:17:01.22,0:17:02.73,Default,,0,0,0,,Райду, сен!
Dialogue: 0,0:17:02.81,0:17:03.81,Default,,0,0,0,,О
Dialogue: 0,0:17:03.89,0:17:06.40,Default,,0,0,0,,Құмар ойыншылардың басқа мамандықтардан ерекшелігі.
Dialogue: 0,0:17:06.48,0:17:09.40,Default,,0,0,0,,Рулетка дөңгелегі тақ санды шығарса, бұл плюс
Dialogue: 0,0:17:09.48,0:17:11.02,Default,,0,0,0,,жұп болса, минус
Dialogue: 0,0:17:11.11,0:17:13.40,Default,,0,0,0,,Нәтиже ×1 миллион иен болады.
Dialogue: 0,0:17:13.99,0:17:16.95,Default,,0,0,0,,Бақытыңызға қарай қарызыңызды қысқа мерзімде өтей аласыз!
Dialogue: 0,0:17:18.28,0:17:21.12,Default,,0,0,0,,Иә, кенеттен плюс 9 миллион!
Dialogue: 0,0:17:30.92,0:17:31.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:31.84,0:17:33.34,Default,,0,0,0,,Бұл керемет Райду
Dialogue: 0,0:17:34.84,0:17:37.34,Default,,0,0,0,,Казиноны мәжбүрлеп тоқтату
Dialogue: 0,0:17:37.43,0:17:40.39,Default,,0,0,0,,«Сіз қалағаныңызша ақша жұмсай аласыз».
Dialogue: 0,0:17:40.47,0:17:42.97,Default,,0,0,0,,«Егер тақ сан шықса, ставка плюс 2x»
Dialogue: 0,0:17:43.06,0:17:45.56,Default,,0,0,0,,«Егер сан жұп болса, минус 2 есе»
Dialogue: 0,0:17:45.64,0:17:48.15,Default,,0,0,0,,Хмм, қорқынышты екен, тоқтайық.
Dialogue: 0,0:17:48.23,0:17:49.35,Default,,0,0,0,,Мен де өтемін.
Dialogue: 0,0:17:49.44,0:17:50.52,Default,,0,0,0,,(Рюи) Неге сен өртеніп жатқан жоқсың?
Dialogue: 0,0:17:50.61,0:17:52.48,Default,,0,0,0,,Мен де тоқтаймын.
Dialogue: 0,0:17:53.07,0:17:56.95,Default,,0,0,0,,Ахарен мырзаның байлығы 100 миллионға жуық.
Dialogue: 0,0:17:57.03,0:17:59.99,Default,,0,0,0,,Тәуекелге барудың қажеті жоқ
Dialogue: 0,0:18:00.07,0:18:01.41,Default,,0,0,0,,Салыстырмалы түрде...
Dialogue: 0,0:18:03.41,0:18:05.87,Default,,0,0,0,,Мен барлық 20 миллион иенімді желіге саламын.
Dialogue: 0,0:18:05.95,0:18:06.83,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:07.41,0:18:09.12,Default,,0,0,0,,Сонымен қатар, кондоминиумды кепіл ретінде пайдаланыңыз
Dialogue: 0,0:18:09.21,0:18:10.79,Default,,0,0,0,,Банктен 40 млн
Dialogue: 0,0:18:10.88,0:18:12.34,Default,,0,0,0,,Тоқта, ақымақ, Райдоу!
Dialogue: 0,0:18:12.42,0:18:13.55,Default,,0,0,0,,Иә, мен үмітсіз болып барамын...
Dialogue: 0,0:18:13.63,0:18:15.51,Default,,0,0,0,,-Қайсысы ақымақ?-(Сато/Ишикава) Иә?
Dialogue: 0,0:18:15.59,0:18:17.93,Default,,0,0,0,,Бұл ойын... Бұл ойын, солай ма?
Dialogue: 0,0:18:18.01,0:18:19.93,Default,,0,0,0,,Осы жерде конкурсқа қатыспасақ
Dialogue: 0,0:18:20.01,0:18:22.47,Default,,0,0,0,,Бұдан кейін ешқандай мүмкіндік қалмады!
Dialogue: 0,0:18:22.55,0:18:24.06,Default,,0,0,0,,Жалпы сендер балалар
Dialogue: 0,0:18:24.14,0:18:27.18,Default,,0,0,0,,20 миллион иенге ие болу мақсат па?
Dialogue: 0,0:18:27.27,0:18:31.65,Default,,0,0,0,,Осыншама ақшамен зейнеткерлікте бай өмір сүре аламын деп ойлайсыз ба?
Dialogue: 0,0:18:31.73,0:18:33.23,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,0:18:33.32,0:18:35.28,Default,,0,0,0,,Өзгелердің иығына түсу
Dialogue: 0,0:18:35.36,0:18:39.61,Default,,0,0,0,,Жеңіл жолды таңдап, болашаққа деген көзқарасы жоқ
Dialogue: 0,0:18:39.70,0:18:42.45,Default,,0,0,0,,Мұндай өмірдің құны неде?
Dialogue: 0,0:18:42.53,0:18:44.28,Default,,0,0,0,,Ra… Raido…
Dialogue: 0,0:18:44.37,0:18:46.50,Default,,0,0,0,,Мен енді шегінуге болмайды!
Dialogue: 0,0:18:46.58,0:18:49.75,Default,,0,0,0,,Мен бұл шайқаста сәттілікке немесе табиғатқа бәс тігемін!
Dialogue: 0,0:18:50.33,0:18:53.92,Default,,0,0,0,,Ахарен мырзамен жақсы зейнетке шығу үшін!
Dialogue: 0,0:18:54.63,0:18:55.88,Default,,0,0,0,,Нууууу...
Dialogue: 0,0:18:59.55,0:19:03.64,Default,,0,0,0,,Бұл минус 60 миллион x 2...
Dialogue: 0,0:19:03.72,0:19:06.43,Default,,0,0,0,,Қарыз 120 миллион иен.
Dialogue: 0,0:19:06.52,0:19:10.39,Default,,0,0,0,,Шынында да, біраз уақыттан бері.
Dialogue: 0,0:19:11.02,0:19:12.56,Default,,0,0,0,,１ ２ ３
Dialogue: 0,0:19:13.65,0:19:15.44,Default,,0,0,0,,«Қаңғыбас мысыққа қосылу»
Dialogue: 0,0:19:15.52,0:19:17.82,Default,,0,0,0,,«Бір күн демалыс»
Dialogue: 0,0:19:18.49,0:19:20.65,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:19:22.70,0:19:26.62,Default,,0,0,0,,Соңында Ахарен мырза бірінші орынға шықты.
Dialogue: 0,0:19:26.70,0:19:27.91,Default,,0,0,0,,(Кёко) Ах…
Dialogue: 0,0:19:28.00,0:19:29.71,Default,,0,0,0,,Қайтадан бірге ойнайық!
Dialogue: 0,0:19:29.79,0:19:30.75,Default,,0,0,0,,Иә
Dialogue: 0,0:19:30.83,0:19:32.46,Default,,0,0,0,,(Рейнаның ішінің шұрылдаған дыбысы)
Dialogue: 0,0:19:33.04,0:19:35.00,Default,,0,0,0,,Менің қарным ашылып жатыр.
Dialogue: 0,0:19:35.09,0:19:37.96,Default,,0,0,0,,Мен дүкенге барып, жеңіл нәрсе аламын.
Dialogue: 0,0:19:38.05,0:19:40.67,Default,,0,0,0,,А, онда мен сенімен барамын.
Dialogue: 0,0:19:43.14,0:19:45.18,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:19:45.80,0:19:48.60,Default,,0,0,0,,Рахмет, Хана Чан, мені бүгін шақырғаның үшін.
Dialogue: 0,0:19:48.68,0:19:49.89,Default,,0,0,0,,... бөлек болыңыз
Dialogue: 0,0:19:49.98,0:19:52.48,Default,,0,0,0,,Маған алғыс айтқыңыз келсе, Таманаха-санға айтыңыз.
Dialogue: 0,0:19:53.60,0:19:55.81,Default,,0,0,0,,Бастапқыда бұл екеуі кездесіп қалады деп ойламаппын.
Dialogue: 0,0:19:55.90,0:19:58.19,Default,,0,0,0,,Мен мұны күтпеген едім және таң қалдым.
Dialogue: 0,0:19:58.28,0:19:59.74,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:19:59.82,0:20:02.11,Default,,0,0,0,,Мен де мектеп оқушысы болғанда
Dialogue: 0,0:20:02.20,0:20:05.37,Default,,0,0,0,,Үйірме жұмыстарына қатысу және қалыпты оқу.
Dialogue: 0,0:20:05.45,0:20:10.12,Default,,0,0,0,,Мен кәдімгідей ғашық болып, жоғары оқу орнына қалыпты түсемін деп ойладым.
Dialogue: 0,0:20:10.20,0:20:12.41,Default,,0,0,0,,Ештеңе жұмыс істемейді.
Dialogue: 0,0:20:12.50,0:20:14.96,Default,,0,0,0,,Қалыпты деген қиын, солай емес пе?
Dialogue: 0,0:20:15.04,0:20:17.84,Default,,0,0,0,,Ой... Кешіріңіз.
Dialogue: 0,0:20:17.92,0:20:20.80,Default,,0,0,0,,Жоқ, бұл кешірім сұрау туралы емес.
Dialogue: 0,0:20:20.88,0:20:21.88,Default,,0,0,0,,Иә...
Dialogue: 0,0:20:22.47,0:20:25.93,Default,,0,0,0,,Менің ойымша, Хана-чан өзіне сенімдірек болуы керек.
Dialogue: 0,0:20:26.43,0:20:28.06,Default,,0,0,0,,Үйірме жұмыстарын жүргіземін, сабақ оқимын.
Dialogue: 0,0:20:28.14,0:20:30.85,Default,,0,0,0,,Менің ойымша, Хана Чан өзінше барын салып жатыр.
Dialogue: 0,0:20:30.93,0:20:33.64,Default,,0,0,0,,Ишикава-кун мейірімді, солай емес пе?
Dialogue: 0,0:20:34.19,0:20:35.56,Default,,0,0,0,,Шынында да.
Dialogue: 0,0:20:41.28,0:20:42.53,Default,,0,0,0,,Мен күткендей...
Dialogue: 0,0:20:43.28,0:20:44.99,Default,,0,0,0,,Маған Исикава-кун ұнайды
Dialogue: 0,0:20:47.87,0:20:49.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:49.74,0:20:51.54,Default,,0,0,0,,Бірақ кешіріңіз.
Dialogue: 0,0:20:52.37,0:20:53.71,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:53.79,0:20:55.50,Default,,0,0,0,,Жарайды, мен мұны білдім.
Dialogue: 0,0:20:56.88,0:20:58.59,Default,,0,0,0,,Жыл сайынғы бәсекелестік қатынасы әдетте 300:1-ден асады>
Dialogue: 0,0:20:58.67,0:21:01.21,Default,,0,0,0,,Мен мұның жақсы емес екенін білсем де
Dialogue: 0,0:21:01.30,0:21:04.05,Default,,0,0,0,,Мен тез түсіндім
Dialogue: 0,0:21:04.13,0:21:05.84,Default,,0,0,0,,Жақында...
Dialogue: 0,0:21:07.09,0:21:10.97,Default,,0,0,0,,Себебі мен сені жақсы көруді тоқтата алмаймын...
Dialogue: 0,0:21:12.02,0:21:14.43,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:21:15.56,0:21:16.60,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:17.77,0:21:20.15,Default,,0,0,0,,Қалыпты бола бересіз бе?
Dialogue: 0,0:21:25.03,0:21:27.28,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:21:28.03,0:21:30.78,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:21:31.83,0:21:34.20,Default,,0,0,0,,Не, сен сонша сатып алдың ба?
Dialogue: 0,0:21:34.29,0:21:36.12,Default,,0,0,0,,Барлығын жеуге болады ма?
Dialogue: 0,0:21:36.21,0:21:38.25,Default,,0,0,0,,Бұлай оқуға болмайды ғой?
Dialogue: 0,0:21:38.33,0:21:39.33,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:39.42,0:21:41.46,Default,,0,0,0,,Ах, өйткені...
Dialogue: 0,0:21:41.55,0:21:42.80,Default,,0,0,0,,Оқу сессиясы аяқталды!
Dialogue: 0,0:21:43.51,0:21:45.51,Default,,0,0,0,,Бүгін кеш!
Dialogue: 0,0:21:46.09,0:21:51.10,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:21:54.31,0:21:59.10,Default,,0,0,0,,Иә, мен іздеген жастық осы еді!
Dialogue: 0,0:22:01.52,0:22:03.65,Default,,0,0,0,,Жарайды, дайынсың ба?
Dialogue: 0,0:22:03.73,0:22:06.11,Default,,0,0,0,,Ал, тестті бастайық!
Dialogue: 0,0:22:11.12,0:22:15.12,Default,,0,0,0,,Жастық шағымда өкініш жоқ
Dialogue: 0,0:22:16.04,0:22:20.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:40.96,0:23:45.96,Default,,0,0,0,,～♪
