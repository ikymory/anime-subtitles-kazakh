Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.21,0:00:07.09,Default,,0,0,0,,-Тама-чан Қайырлы таң -Уф!
Dialogue: 0,0:00:07.17,0:00:08.21,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:08.29,0:00:10.67,Default,,0,0,0,,Ах... о... қайырлы таң
Dialogue: 0,0:00:12.72,0:00:13.93,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:00:15.72,0:00:17.97,Default,,0,0,0,,Бос шұлықтар сүйкімді
Dialogue: 0,0:00:18.05,0:00:20.31,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:00:20.39,0:00:22.68,Default,,0,0,0,,Дьяру стилі сүйкімді
Dialogue: 0,0:00:22.77,0:00:24.69,Default,,0,0,0,,Мен де оны кигім келеді
Dialogue: 0,0:00:24.77,0:00:28.19,Default,,0,0,0,,А... Мен жұп әкелдім.
Dialogue: 0,0:00:28.27,0:00:29.15,Default,,0,0,0,,Біреуін кимеу
Dialogue: 0,0:00:29.73,0:00:31.23,Default,,0,0,0,,Мен оны қарызға аламын ба?
Dialogue: 0,0:00:31.32,0:00:32.65,Default,,0,0,0,,Әрине!
Dialogue: 0,0:00:33.65,0:00:35.41,Default,,0,0,0,,А, бұл жақсы болуы мүмкін!
Dialogue: 0,0:00:35.49,0:00:38.32,Default,,0,0,0,,Иә, Аха-чан сүйкімді!
Dialogue: 0,0:00:38.41,0:00:39.62,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:39.70,0:00:42.70,Default,,0,0,0,,Уау! Рейна-чан, маған бұл ұнайды.
Dialogue: 0,0:00:42.79,0:00:44.83,Default,,0,0,0,,Қайырлы таң, Оширо мырза.
Dialogue: 0,0:00:45.42,0:00:48.46,Default,,0,0,0,,Эй, мен Таманаха-саннан қарызға алдым.
Dialogue: 0,0:00:48.54,0:00:49.38,Default,,0,0,0,,Иә
Dialogue: 0,0:00:49.46,0:00:52.17,Default,,0,0,0,,Сіз де шашыңызды үйлестіргіңіз келуі мүмкін.
Dialogue: 0,0:00:52.26,0:00:53.80,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:00:53.88,0:00:55.22,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:00:55.84,0:00:58.30,Default,,0,0,0,,Олай болса, байқап көрейік пе?
Dialogue: 0,0:00:59.05,0:01:04.06,Default,,0,0,0,,♪～
Dialogue: 0,0:02:23.72,0:02:27.73,Default,,0,0,0,,～♪
Dialogue: 0,0:02:30.73,0:02:31.69,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:31.77,0:02:32.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:40.45,0:02:42.41,Default,,0,0,0,,Қайырлы таң Райду-кун
Dialogue: 0,0:02:42.99,0:02:46.16,Default,,0,0,0,,Ахарен-сан қызға айналды
Dialogue: 0,0:02:46.24,0:02:49.21,Default,,0,0,0,,Осы уақытқа дейін сондай тыныш адам болғаныңмен.
Dialogue: 0,0:02:49.29,0:02:50.87,Default,,0,0,0,,Неліктен кенеттен?
Dialogue: 0,0:02:50.96,0:02:54.38,Default,,0,0,0,,Жоқ, бір теорияға сәйкес, гальтер ...
Dialogue: 0,0:02:55.34,0:02:57.59,Default,,0,0,0,,Тәуелсіздіктің көрінісі
Dialogue: 0,0:02:57.67,0:03:01.63,Default,,0,0,0,,Студент қыздар туралы ескі стереотиптерді жою және трансформацияға ұмтылу
Dialogue: 0,0:03:01.72,0:03:06.10,Default,,0,0,0,,Радикалданған сән ретінде айтылған деген пікір бар.
Dialogue: 0,0:03:06.68,0:03:09.31,Default,,0,0,0,,Бұл өсуді білдіреді
Dialogue: 0,0:03:10.14,0:03:13.52,Default,,0,0,0,,Ахарен өсіп келе жатқанда оған қолдау көрсетейік.
Dialogue: 0,0:03:13.61,0:03:16.61,Default,,0,0,0,,Сіздің ерекше сәніңіз де сүйкімді.
Dialogue: 0,0:03:18.36,0:03:19.82,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:23.07,0:03:24.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:24.62,0:03:27.91,Default,,0,0,0,,Құжаттарды басып шығаруды ұмытып кетіппін.
Dialogue: 0,0:03:27.99,0:03:30.46,Default,,0,0,0,,Оны көргіңіз келе ме? бірге
Dialogue: 0,0:03:31.04,0:03:33.17,Default,,0,0,0,,Чассу Ахарен-сан Ассу!
Dialogue: 0,0:03:33.25,0:03:34.25,Default,,0,0,0,,Ха…
Dialogue: 0,0:03:34.33,0:03:36.88,Default,,0,0,0,,Не? Ендігі сөз
Dialogue: 0,0:03:36.96,0:03:38.00,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:03:38.09,0:03:42.22,Default,,0,0,0,,Менің миыма қыздар кіре бастады ма?
Dialogue: 0,0:03:42.80,0:03:45.18,Default,,0,0,0,,Менің Ахарен мырзаға сәйкес келу әрекетім
Dialogue: 0,0:03:45.26,0:03:48.43,Default,,0,0,0,,Бұған бейсаналық әдеттер себеп бола ма?
Dialogue: 0,0:03:49.02,0:03:50.14,Default,,0,0,0,,Бұл жаман
Dialogue: 0,0:03:50.22,0:03:52.23,Default,,0,0,0,,Ерік-жігері күшті болуы керек
Dialogue: 0,0:03:52.31,0:03:54.52,Default,,0,0,0,,Жуынатын бөлмеде бетімді жуайын деп жатырмын.
Dialogue: 0,0:04:02.45,0:04:03.99,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:04:04.99,0:04:06.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:07.45,0:04:09.33,Default,,0,0,0,,Сәлем Рейна-чан
Dialogue: 0,0:04:09.41,0:04:10.25,Default,,0,0,0,,Қайта…
Dialogue: 0,0:04:10.33,0:04:13.33,Default,,0,0,0,,Шынымен, 1-кезең немесе сол сияқты.
Dialogue: 0,0:04:14.21,0:04:16.46,Default,,0,0,0,,Кішкене ауыр
Dialogue: 0,0:04:16.54,0:04:17.84,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:04:18.42,0:04:19.92,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:04:20.00,0:04:21.55,Default,,0,0,0,,Физикалық шаршауға не себеп болады?
Dialogue: 0,0:04:21.63,0:04:24.97,Default,,0,0,0,,Сондай-ақ В1 витаминінің жетіспеу мүмкіндігі бар.
Dialogue: 0,0:04:25.05,0:04:28.68,Default,,0,0,0,,Қоңыр күріш, шошқа етін және соя бұршақтарын неғұрлым көп жеуге болады, соғұрлым жақсы.
Dialogue: 0,0:04:28.76,0:04:32.27,Default,,0,0,0,,Сабақты дұрыс өткізбеудің еш айыбы жоқ.
Dialogue: 0,0:04:34.85,0:04:38.11,Default,,0,0,0,,Жақында менде түшкіруге айтарлықтай қарсылық пайда болды.
Dialogue: 0,0:04:38.19,0:04:40.36,Default,,0,0,0,,Әйтеуір әлгі екеуі біраз жақындай түсті.
Dialogue: 0,0:04:40.44,0:04:42.49,Default,,0,0,0,,Мен енді қорықпаймын
Dialogue: 0,0:04:43.44,0:04:44.78,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:44.86,0:04:46.16,Default,,0,0,0,,Чолиссу
Dialogue: 0,0:04:46.24,0:04:47.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:47.16,0:04:50.08,Default,,0,0,0,,Соңында харизматикалық мұғалім пайда болады
Dialogue: 0,0:04:50.16,0:04:52.95,Default,,0,0,0,,Міне, дайын, кез келген уақытта қош келдіңіз.
Dialogue: 0,0:04:53.04,0:04:55.87,Default,,0,0,0,,Шынымды айтсам, маған илаһи сабақ бер, Онаша
Dialogue: 0,0:04:55.96,0:04:57.79,Default,,0,0,0,,Бұл күтпеген жағдай!
Dialogue: 0,0:04:57.96,0:04:59.17,Default,,0,0,0,,Қауіп
Dialogue: 0,0:04:59.25,0:05:03.38,Default,,0,0,0,,Өмірге қауіп төндіретін қоянның қауіпті синдромын алдын ала ескерту!
Dialogue: 0,0:05:03.46,0:05:05.47,Default,,0,0,0,,Біраз уақыт өзім оқимын!
Dialogue: 0,0:05:05.55,0:05:07.22,Default,,0,0,0,,Әй, бірдеңені ұмыттың ба?
Dialogue: 0,0:05:07.30,0:05:10.60,Default,,0,0,0,,Бұл шынымен де барлығында болады және бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:05:13.64,0:05:16.85,Default,,0,0,0,,Жарайды, мен де бүгін мектепке бардым.
Dialogue: 0,0:05:16.94,0:05:19.02,Default,,0,0,0,,Ал, қазір қалаға барайық.
Dialogue: 0,0:05:19.11,0:05:22.03,Default,,0,0,0,,Бірге жақсы нәрсе жасағыларыңыз келе ме?
Dialogue: 0,0:05:22.11,0:05:23.15,Default,,0,0,0,,Менің барғым келеді
Dialogue: 0,0:05:23.23,0:05:24.53,Default,,0,0,0,,Сөзсіз~
Dialogue: 0,0:05:24.61,0:05:26.82,Default,,0,0,0,,Кеттік
Dialogue: 0,0:05:28.07,0:05:29.53,Default,,0,0,0,,(Монета түскен дыбыс)
Dialogue: 0,0:05:29.62,0:05:31.08,Default,,0,0,0,,Азассу
Dialogue: 0,0:05:47.38,0:05:49.39,Default,,0,0,0,,Қайырлы таң Райду-кун
Dialogue: 0,0:05:49.47,0:05:52.01,Default,,0,0,0,,Эй, Рейна-чан, бүгін де сәттілік!
Dialogue: 0,0:05:52.10,0:05:53.26,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:53.35,0:05:56.10,Default,,0,0,0,,Сіз кешегі күнмен салыстырғанда шынымен ұқыпты және тазасыз ба?
Dialogue: 0,0:05:56.18,0:05:58.23,Default,,0,0,0,,Не болды? Сіздің көңіл-күйіңізде қандай өзгеріс бар?
Dialogue: 0,0:05:58.31,0:05:59.85,Default,,0,0,0,,Сіз ертегіні естідіңіз бе?
Dialogue: 0,0:05:59.94,0:06:04.61,Default,,0,0,0,,Кеше мен барлығы қалағандай киінуге тырыстым.
Dialogue: 0,0:06:04.69,0:06:06.82,Default,,0,0,0,,Гал сәні қызықты болды
Dialogue: 0,0:06:07.82,0:06:09.86,Default,,0,0,0,,А, мен түсіндім, көремін.
Dialogue: 0,0:06:09.95,0:06:12.87,Default,,0,0,0,,Бұл тек бір күндік сынақ дегенді білдіре ме?
Dialogue: 0,0:06:12.95,0:06:13.79,Default,,0,0,0,,Иә
Dialogue: 0,0:06:13.87,0:06:17.04,Default,,0,0,0,,...
Dialogue: 0,0:06:18.12,0:06:20.33,Default,,0,0,0,,Ал, мектепке барайық.
Dialogue: 0,0:06:20.83,0:06:22.00,Default,,0,0,0,,Иә
Dialogue: 0,0:06:26.13,0:06:27.92,Default,,0,0,0,,Бүгін де аяқталды
Dialogue: 0,0:06:28.59,0:06:30.13,Default,,0,0,0,,Райду-кун
Dialogue: 0,0:06:30.22,0:06:32.26,Default,,0,0,0,,Бұрынғыдай жақын.
Dialogue: 0,0:06:32.35,0:06:33.68,Default,,0,0,0,,Біз жас бәсекелестер ақыл-парасатымыз таусылып, әбден таңырқап қаламыз, солай ма~?
Dialogue: 0,0:06:33.76,0:06:36.31,Default,,0,0,0,,Бүгін бірге аркадаға барайық
Dialogue: 0,0:06:36.39,0:06:38.35,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:06:39.19,0:06:43.06,Default,,0,0,0,,Ахарен мырзаның мені шақыруы сирек.
Dialogue: 0,0:06:43.15,0:06:46.03,Default,,0,0,0,,(Қыздар сөйлейді)
Dialogue: 0,0:06:46.11,0:06:47.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:48.32,0:06:50.53,Default,,0,0,0,,Қыздарға арналған танымал ойындар
Dialogue: 0,0:06:50.61,0:06:52.45,Default,,0,0,0,,«Алғашқы планета»
Dialogue: 0,0:06:52.53,0:06:54.20,Default,,0,0,0,,Жалпы аты Припура
Dialogue: 0,0:06:54.28,0:06:56.54,Default,,0,0,0,,Сондай-ақ, аватарыңызды киюді ұната аласыз.
Dialogue: 0,0:06:56.62,0:06:58.29,Default,,0,0,0,,Бұл бос ойын
Dialogue: 0,0:06:58.37,0:07:02.25,Default,,0,0,0,,Жұмыс істеп тұрғанына біраз уақыт болса да, ол әлі де танымал.
Dialogue: 0,0:07:02.33,0:07:06.67,Default,,0,0,0,,Жанды спектакльдер, смартфон ойындары және жаңа аниме де шығарылуда.
Dialogue: 0,0:07:06.75,0:07:08.46,Default,,0,0,0,,Танымал мазмұн
Dialogue: 0,0:07:09.92,0:07:11.09,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:07:11.18,0:07:13.14,Default,,0,0,0,,Сізді күтуге мәжбүрлегенім үшін кешіріңіз.
Dialogue: 0,0:07:13.22,0:07:15.68,Default,,0,0,0,,Бұл жақсы, өйткені оны қарау қызықты.
Dialogue: 0,0:07:15.76,0:07:18.60,Default,,0,0,0,,Мен бұған баяғыда араластым.
Dialogue: 0,0:07:18.68,0:07:21.77,Default,,0,0,0,,Кеше мен Оширо мырзаға киімімді үйлестіруді тапсырдым.
Dialogue: 0,0:07:21.85,0:07:24.11,Default,,0,0,0,,Мен қайтадан бастағым келеді
Dialogue: 0,0:07:24.19,0:07:26.15,Default,,0,0,0,,Ойын болса, қалағаныңызша үйлестіре аласыз.
Dialogue: 0,0:07:26.23,0:07:27.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:27.94,0:07:30.03,Default,,0,0,0,,Райду-кун да байқап көре ме?
Dialogue: 0,0:07:30.11,0:07:32.53,Default,,0,0,0,,Мен саған көйлектің көшірмесін беремін.
Dialogue: 0,0:07:32.61,0:07:34.82,Default,,0,0,0,,(Сота) Онда менің үйіме барайық! Апама айтамын!
Dialogue: 0,0:07:36.12,0:07:37.33,Default,,0,0,0,,Иә, мен мұны істеймін.
Dialogue: 0,0:07:42.79,0:07:43.92,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:07:44.00,0:07:46.00,Default,,0,0,0,,Менің де солай етуімді қаладың.
Dialogue: 0,0:07:46.09,0:07:47.63,Default,,0,0,0,,(Монета түскен дыбыс)
Dialogue: 0,0:07:46.09,0:07:47.63,Default,,0,0,0,,Бірақ мен мұндай ойынды бірінші рет ойнап тұрмын.
Dialogue: 0,0:07:47.63,0:07:49.21,Default,,0,0,0,,Бірақ мен мұндай ойынды бірінші рет ойнап тұрмын.
Dialogue: 0,0:07:49.30,0:07:51.92,Default,,0,0,0,,Біріншіден, кейіпкердің макияжы
Dialogue: 0,0:07:52.01,0:07:52.93,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:54.14,0:07:55.89,Default,,0,0,0,,Сіз бет бөліктерін таңдайсыз ба?
Dialogue: 0,0:07:56.68,0:08:00.35,Default,,0,0,0,,Бірақ мұны қалай істеу керек...
Dialogue: 0,0:08:01.85,0:08:03.81,Default,,0,0,0,,Ал, сүйкімді болайық.
Dialogue: 0,0:08:12.78,0:08:14.24,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:08:15.49,0:08:19.66,Default,,0,0,0,,Онда менің киіміммен киін.
Dialogue: 0,0:08:19.74,0:08:21.12,Default,,0,0,0,,Мағынасыздық
Dialogue: 0,0:08:22.41,0:08:24.08,Default,,0,0,0,,Өте сүйкімді...
Dialogue: 0,0:08:24.87,0:08:27.13,Default,,0,0,0,,Би бөлімі басталады
Dialogue: 0,0:08:27.21,0:08:28.04,Default,,0,0,0,,Иә
Dialogue: 0,0:08:28.13,0:08:33.13,Default,,0,0,0,,(Ойын музыкасы)
Dialogue: 0,0:08:54.32,0:09:00.24,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:00.33,0:09:01.95,Default,,0,0,0,,(шығу дыбысы)
Dialogue: 0,0:09:02.75,0:09:04.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:04.37,0:09:08.42,Default,,0,0,0,,Координаттарды және менің картамды қабылдап, 1 ойынды аяқтаңыз
Dialogue: 0,0:09:08.50,0:09:09.71,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:09.79,0:09:12.42,Default,,0,0,0,,Мен көңілді аздап түсінетін сияқтымын.
Dialogue: 0,0:09:12.51,0:09:13.76,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:14.34,0:09:16.26,Default,,0,0,0,,Иә? Мен Авамен біргемін.
Dialogue: 0,0:09:16.34,0:09:17.76,Default,,0,0,0,,Футаба-чан
Dialogue: 0,0:09:17.84,0:09:20.30,Default,,0,0,0,,Футаба-чан да Пурипура жасай ма?
Dialogue: 0,0:09:20.39,0:09:22.35,Default,,0,0,0,,Иә? Мен мұны істемеймін
Dialogue: 0,0:09:22.43,0:09:24.85,Default,,0,0,0,,Мен ондай нәрсені бітірдім.
Dialogue: 0,0:09:24.93,0:09:25.89,Default,,0,0,0,,Сіздер де...
Dialogue: 0,0:09:25.98,0:09:27.40,Default,,0,0,0,,Әй, патша Аха!
Dialogue: 0,0:09:27.48,0:09:28.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:28.40,0:09:30.69,Default,,0,0,0,,Бұл кейіпкерді Аха патша жасады ма?
Dialogue: 0,0:09:30.77,0:09:33.28,Default,,0,0,0,,-Таңғажайып жақсы! - Керемет!
Dialogue: 0,0:09:33.36,0:09:35.82,Default,,0,0,0,,Мен де осы ойынды ойнағым келеді!
Dialogue: 0,0:09:35.90,0:09:37.66,Default,,0,0,0,,Мен саған қалған киімдерді беремін.
Dialogue: 0,0:09:37.74,0:09:39.41,Default,,0,0,0,,Патша күткендей!
Dialogue: 0,0:09:39.49,0:09:41.62,Default,,0,0,0,,-Мен істеймін! -Мен де, мен де!
Dialogue: 0,0:09:41.70,0:09:45.62,Default,,0,0,0,,А... Мен де істеймін~
Dialogue: 0,0:09:56.92,0:10:00.80,Default,,0,0,0,,(дыбысты ойнату)
Dialogue: 0,0:10:02.56,0:10:03.72,Default,,0,0,0,,Жарайды
Dialogue: 0,0:10:04.31,0:10:08.73,Default,,0,0,0,,Мен бұл киім туралы кеше түнде ұйықтамай-ақ ойладым. Бұл жақсы комбинация.
Dialogue: 0,0:10:09.31,0:10:11.44,Default,,0,0,0,,Мен бұл баланы одан да сүйкімді еткім келеді.
Dialogue: 0,0:10:11.52,0:10:12.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:37.42,0:10:40.59,Default,,0,0,0,,PriPla-ға тәуелді болып, күн сайын көңілді болу жақсы.
Dialogue: 0,0:10:40.68,0:10:43.39,Default,,0,0,0,,Күткендей, менде ақша таусылып жатыр.
Dialogue: 0,0:10:44.31,0:10:46.10,Default,,0,0,0,,Сақтамасаңыз...
Dialogue: 0,0:10:47.73,0:10:48.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:51.60,0:10:53.52,Default,,0,0,0,,-Кешіріңіз, кеңсеші - (хатшы) Иә.
Dialogue: 0,0:10:54.19,0:10:55.69,Default,,0,0,0,,Пурипура қайда орналасқан?
Dialogue: 0,0:10:55.78,0:10:57.11,Default,,0,0,0,,Бұл Пурипура ма?
Dialogue: 0,0:10:57.19,0:11:00.99,Default,,0,0,0,,Қызмет кеше аяқталды және жойылды.
Dialogue: 0,0:11:07.58,0:11:09.50,Default,,0,0,0,,Қызметтің аяқталуы...
Dialogue: 0,0:11:10.25,0:11:11.54,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:12.21,0:11:13.92,Default,,0,0,0,,Қанша уақыт күтуімді күтесің? Жылдам бол.
Dialogue: 0,0:11:15.63,0:11:19.01,Default,,0,0,0,,Мен Рай Чанмен енді ешқашан кездесе алмаймын...
Dialogue: 0,0:11:20.26,0:11:22.22,Default,,0,0,0,,Кенеттен ажырау
Dialogue: 0,0:11:31.35,0:11:33.48,Default,,0,0,0,,Бүгін де аркадаға барайық
Dialogue: 0,0:11:33.56,0:11:34.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:35.19,0:11:37.57,Default,,0,0,0,,Пурипурасыз ойын орталығы
Dialogue: 0,0:11:37.65,0:11:39.40,Default,,0,0,0,,Сіз мұңаймайсыз ба?
Dialogue: 0,0:11:41.03,0:11:41.86,Default,,0,0,0,,Ах
Dialogue: 0,0:11:41.95,0:11:43.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:48.04,0:11:50.96,Default,,0,0,0,,Сол сериядағы соңғы шығарма Пригачи
Dialogue: 0,0:11:51.54,0:11:53.46,Default,,0,0,0,,Жаңа нәрсе жасап көрейік
Dialogue: 0,0:11:54.38,0:11:57.96,Default,,0,0,0,,Жоқ, қоштасу жеткілікті.
Dialogue: 0,0:12:02.47,0:12:03.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:05.09,0:12:07.51,Default,,0,0,0,,Мен сені енді ешқашан көрмейтініме сене алар емеспін
Dialogue: 0,0:12:08.01,0:12:11.06,Default,,0,0,0,,Кенет қоштасу өте ауыр...
Dialogue: 0,0:12:11.93,0:12:13.56,Default,,0,0,0,,Рай-чан...
Dialogue: 0,0:12:14.40,0:12:16.52,Default,,0,0,0,,А... а...
Dialogue: 0,0:12:16.61,0:12:18.90,Default,,0,0,0,,PriPla қызметінің тоқтатылуына байланысты
Dialogue: 0,0:12:18.98,0:12:21.69,Default,,0,0,0,,Мен қайта ойнай алмаймын.
Dialogue: 0,0:12:26.95,0:12:28.37,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:12:28.45,0:12:30.87,Default,,0,0,0,,(Юки) Бірақ Хори, сен мықтысың ғой, иә? (Хидэ Иура) Һмм…
Dialogue: 0,0:12:31.45,0:12:34.12,Default,,0,0,0,,Ахарен мырзаға алаңдау жақсы емес.
Dialogue: 0,0:12:34.67,0:12:36.71,Default,,0,0,0,,Тез қалпына келтіру үшін...
Dialogue: 0,0:12:40.46,0:12:43.30,Default,,0,0,0,,Пригачи жаңа сериясын ойнаймыз
Dialogue: 0,0:12:43.38,0:12:44.26,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:12:44.34,0:12:47.18,Default,,0,0,0,,Өзім жасасам, Рай-чанға ұқсайды.
Dialogue: 0,0:12:47.26,0:12:49.31,Default,,0,0,0,,Бар таңбаларды пайдаланыңыз
Dialogue: 0,0:12:51.02,0:12:51.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:55.81,0:12:57.35,Default,,0,0,0,,Маған бұл қыз ұнайды
Dialogue: 0,0:12:58.61,0:12:59.65,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:00.36,0:13:02.49,Default,,0,0,0,,Сурет PriPla-ға қарағанда әдемі.
Dialogue: 0,0:13:02.57,0:13:04.45,Default,,0,0,0,,Қозғалысы бірқалыпты
Dialogue: 0,0:13:04.53,0:13:06.61,Default,,0,0,0,,Күтілгендей, бұл соңғы ойын.
Dialogue: 0,0:13:07.20,0:13:08.95,Default,,0,0,0,,Райду-кун Райду-кун
Dialogue: 0,0:13:09.03,0:13:09.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:10.45,0:13:12.62,Default,,0,0,0,,Мен саған қалған киімдерді беремін.
Dialogue: 0,0:13:12.70,0:13:14.33,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:13:15.25,0:13:17.04,Default,,0,0,0,,Жарайды, бастайық.
Dialogue: 0,0:13:19.88,0:13:20.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:21.59,0:13:24.59,Default,,0,0,0,,Әпке, алмасайық.
Dialogue: 0,0:13:24.67,0:13:25.67,Default,,0,0,0,,Иә
Dialogue: 0,0:13:27.38,0:13:28.68,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:28.76,0:13:32.26,Default,,0,0,0,,ПриПурадан айырмашылығы, Пури Гачи аниме де таратады.
Dialogue: 0,0:13:32.35,0:13:34.18,Default,,0,0,0,,Менің достарым көп.
Dialogue: 0,0:13:34.77,0:13:38.15,Default,,0,0,0,,Пуригачи Мен ойлағаннан да қызық болатын сияқты.
Dialogue: 0,0:13:39.31,0:13:43.28,Default,,0,0,0,,Бірақ мен Рай-чан үшін уайымдап жүрмін...
Dialogue: 0,0:14:11.43,0:14:14.35,Default,,0,0,0,,Мен оған Припураға қарағанда көбірек құмар болдым.
Dialogue: 0,0:14:15.06,0:14:17.56,Default,,0,0,0,,Жарайды, бүгін тағы да Пури Гачи жасайық.
Dialogue: 0,0:14:18.14,0:14:19.77,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:14:20.81,0:14:22.98,Default,,0,0,0,,Пури... Пура?
Dialogue: 0,0:14:24.07,0:14:27.49,Default,,0,0,0,,Өйткені PriPura-ның жалғасы шықты
Dialogue: 0,0:14:27.57,0:14:30.32,Default,,0,0,0,,Тұрғын үй де жанданды, солай ма?
Dialogue: 0,0:14:31.99,0:14:33.41,Default,,0,0,0,,Пурипура…
Dialogue: 0,0:14:34.16,0:14:35.33,Default,,0,0,0,,Рай-чан...
Dialogue: 0,0:14:36.50,0:14:39.33,Default,,0,0,0,,Ра… Рай-чан
Dialogue: 0,0:14:40.29,0:14:41.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:41.21,0:14:42.84,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:14:42.92,0:14:46.84,Default,,0,0,0,,Сол кемпірді ұмытпа.
Dialogue: 0,0:14:46.92,0:14:48.17,Default,,0,0,0,,Райду-кун
Dialogue: 0,0:14:48.26,0:14:49.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:49.17,0:14:50.47,Default,,0,0,0,,Райду-кун
Dialogue: 0,0:14:50.55,0:14:53.85,Default,,0,0,0,,Сен мені ұмыттың, бұл сұмдық.
Dialogue: 0,0:14:53.93,0:14:56.93,Default,,0,0,0,,Сен мені таңда, Райду-кун.
Dialogue: 0,0:14:57.02,0:14:59.27,Default,,0,0,0,,Жоқ, менмін.
Dialogue: 0,0:14:59.85,0:15:01.69,Default,,0,0,0,,Сіз қайсысын таңдайсыз? Сіз қайсысын таңдар едіңіз?
Dialogue: 0,0:15:02.94,0:15:05.11,Default,,0,0,0,,Қайсысын таңдауым керек...
Dialogue: 0,0:15:05.69,0:15:07.53,Default,,0,0,0,,Тек таңдау керек...
Dialogue: 0,0:15:08.03,0:15:10.65,Default,,0,0,0,,(Сота) Онда менің үйіме барайық! Апама айтамын!
Dialogue: 0,0:15:11.78,0:15:14.45,Default,,0,0,0,,Біреуін лақтырмаңыз!
Dialogue: 0,0:15:14.53,0:15:16.04,Default,,0,0,0,,Пурипура және Пуригачи
Dialogue: 0,0:15:16.66,0:15:18.20,Default,,0,0,0,,Екеуі де ойнайды!
Dialogue: 0,0:15:22.71,0:15:24.29,Default,,0,0,0,,Ақшаңыз жетпей ме?
Dialogue: 0,0:15:25.38,0:15:28.63,Default,,0,0,0,,Сізде ақша жоқ па? Содан кейін мен енді ойнай алмаймын.
Dialogue: 0,0:15:28.71,0:15:31.38,Default,,0,0,0,,Кешіріңіз, кедейлерге пайдасы жоқ.
Dialogue: 0,0:15:31.47,0:15:34.93,Default,,0,0,0,,- (2 адам) Қош бол - Уууу...
Dialogue: 0,0:15:41.39,0:15:43.40,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:15:43.48,0:15:45.98,Default,,0,0,0,,Ошикацу қатал, солай емес пе?
Dialogue: 0,0:15:46.86,0:15:48.03,Default,,0,0,0,,Иә
Dialogue: 0,0:15:54.82,0:15:58.29,Default,,0,0,0,,Ахарен мырза үзіліс уақыты болса да жазып жатыр.
Dialogue: 0,0:16:01.12,0:16:03.21,Default,,0,0,0,,Ән мәтіні... Түсіндім!
Dialogue: 0,0:16:05.08,0:16:06.79,Default,,0,0,0,,Пұттардың әрекеттері
Dialogue: 0,0:16:06.88,0:16:10.05,Default,,0,0,0,,Ахарен-сан пұт болуды мақсат етеді.
Dialogue: 0,0:16:10.13,0:16:12.51,Default,,0,0,0,,Пұттарға ән керек
Dialogue: 0,0:16:12.59,0:16:15.76,Default,,0,0,0,,Сондықтан ән мәтінін дәптеріме сақтаймын.
Dialogue: 0,0:16:16.43,0:16:18.72,Default,,0,0,0,,Пұт?
Dialogue: 0,0:16:21.31,0:16:22.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:26.77,0:16:31.19,Default,,0,0,0,,Ахарен мырза қаласа, өткеннің қайғылы естеліктерін тастаңыз.
Dialogue: 0,0:16:31.28,0:16:33.24,Default,,0,0,0,,Мен сені қолдауға бар күшімді саламын.
Dialogue: 0,0:16:33.32,0:16:35.53,Default,,0,0,0,,Қателіктеріңе көп тоқталудың орнына,
Dialogue: 0,0:16:35.61,0:16:38.12,Default,,0,0,0,,Тағы бір рет тынышталып, бұл туралы ойланыңыз.
Dialogue: 0,0:16:38.20,0:16:42.20,Default,,0,0,0,,Мен мұндай ойды осы уақытқа дейін сирек кездестірдім.
Dialogue: 0,0:16:42.29,0:16:43.71,Default,,0,0,0,,Бұл менің жаман әдетім.
Dialogue: 0,0:16:44.33,0:16:46.42,Default,,0,0,0,,Мен өсіп келе жатқан адаммын
Dialogue: 0,0:16:46.50,0:16:49.80,Default,,0,0,0,,Шындықты анықтау үшін мұқият бақылаңыз
Dialogue: 0,0:16:49.88,0:16:52.34,Default,,0,0,0,,Соңғы уақытта ыстық әрі ылғалды болды.
Dialogue: 0,0:16:52.42,0:16:54.26,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:59.47,0:17:01.64,Default,,0,0,0,,Қазір мен киім тігемін
Dialogue: 0,0:17:02.47,0:17:05.10,Default,,0,0,0,,Ахарен мырза, бұл...
Dialogue: 0,0:17:05.77,0:17:07.10,Default,,0,0,0,,Идол костюмі
Dialogue: 0,0:17:07.69,0:17:09.69,Default,,0,0,0,,Мен кумир бола бастағанда,
Dialogue: 0,0:17:09.77,0:17:13.36,Default,,0,0,0,,Адамдар өздерінің костюмдерін және т.б. беруі сирек емес.
Dialogue: 0,0:17:13.90,0:17:18.07,Default,,0,0,0,,Гламурлық сахнаның артында олар тұрақты күш салуда.
Dialogue: 0,0:17:18.16,0:17:21.79,Default,,0,0,0,,Жоқ, бұл қайтадан жақсы емес.
Dialogue: 0,0:17:21.87,0:17:23.91,Default,,0,0,0,,Ұзақ күте тұрыңыз және анықтаңыз
Dialogue: 0,0:17:24.00,0:17:27.00,Default,,0,0,0,,Музыкалық үй тапсырмасы – азап.
Dialogue: 0,0:17:27.08,0:17:28.63,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:28.71,0:17:30.34,Default,,0,0,0,,(Диктофонның өнімділігі)
Dialogue: 0,0:17:31.04,0:17:32.13,Default,,0,0,0,,Хмм…
Dialogue: 0,0:17:34.01,0:17:36.76,Default,,0,0,0,,Ахарен мырза аспапта ойнап отыр
Dialogue: 0,0:17:37.84,0:17:39.97,Default,,0,0,0,,Ахарен мырза, бұл...
Dialogue: 0,0:17:40.60,0:17:41.97,Default,,0,0,0,,Құрамы
Dialogue: 0,0:17:42.06,0:17:44.39,Default,,0,0,0,,Өзіңіздің әндеріңізді құрастырыңыз және айтыңыз
Dialogue: 0,0:17:44.48,0:17:47.48,Default,,0,0,0,,Сіз әнші-композитор кумиріне айналуды мақсат етесіз бе?
Dialogue: 0,0:17:47.98,0:17:52.19,Default,,0,0,0,,Өмір дейтін әндер, басқаларға қалдырғым келмейді.
Dialogue: 0,0:17:52.27,0:17:53.44,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:17:53.53,0:17:56.65,Default,,0,0,0,,Не істесең де, пұтқа байланасың.
Dialogue: 0,0:17:59.95,0:18:01.62,Default,,0,0,0,,Асықпа, Райду
Dialogue: 0,0:18:01.70,0:18:05.08,Default,,0,0,0,,Егер сіз тез қорытынды жасасаңыз, бәрі бұрынғы қалпына келеді.
Dialogue: 0,0:18:14.51,0:18:15.92,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:20.47,0:18:23.43,Default,,0,0,0,,Содан бері мен оны бірнеше күн бойы бақылап жүрмін.
Dialogue: 0,0:18:23.51,0:18:25.52,Default,,0,0,0,,Қорытынды өзгеріссіз қалды.
Dialogue: 0,0:18:26.81,0:18:30.56,Default,,0,0,0,,Мен өспеген сондай адам болдым ба?
Dialogue: 0,0:18:33.73,0:18:34.57,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:36.53,0:18:39.53,Default,,0,0,0,,Бүгін сауда аймағы мереке ме?
Dialogue: 0,0:18:40.57,0:18:45.20,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:18:45.99,0:18:47.04,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:47.83,0:18:49.67,Default,,0,0,0,,​​Барлығыңызға рахмет!
Dialogue: 0,0:18:49.75,0:18:51.50,Default,,0,0,0,,Сен өте тәртіпсізсің.
Dialogue: 0,0:18:52.33,0:18:53.42,Default,,0,0,0,,Хо…
Dialogue: 0,0:18:57.01,0:18:59.51,Default,,0,0,0,,А, мен қобалжыдым.
Dialogue: 0,0:18:59.59,0:19:02.14,Default,,0,0,0,,- (1-дос) Бірақ қызық болды! -(2-дос) А?
Dialogue: 0,0:18:59.59,0:19:02.14,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:02.72,0:19:04.43,Default,,0,0,0,,Әпке, бұл...
Dialogue: 0,0:19:04.51,0:19:06.10,Default,,0,0,0,,Әй, аға!
Dialogue: 0,0:19:06.18,0:19:08.64,Default,,0,0,0,,Эй, сен мұнда неге келдің?
Dialogue: 0,0:19:08.73,0:19:11.44,Default,,0,0,0,,Жоқ, мен кездейсоқ өтіп бара жатырмын.
Dialogue: 0,0:19:12.73,0:19:13.81,Default,,0,0,0,,(Гильда) Бірден көп жеме – аздап-аздап же.
Dialogue: 0,0:19:13.90,0:19:14.77,Default,,0,0,0,,Қый!
Dialogue: 0,0:19:14.86,0:19:16.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:17.19,0:19:18.53,Default,,0,0,0,,Көршілес қауымдастықтың фестивалінде
Dialogue: 0,0:19:18.61,0:19:22.28,Default,,0,0,0,,Досым сахнаға өнер көрсетуге шақырды.
Dialogue: 0,0:19:22.36,0:19:24.37,Default,,0,0,0,,Біз мұны бірге жасадық.
Dialogue: 0,0:19:24.45,0:19:25.99,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:26.08,0:19:27.74,Default,,0,0,0,,Жақсы, маңызды емес.
Dialogue: 0,0:19:27.83,0:19:30.00,Default,,0,0,0,,Райду Ниини
Dialogue: 0,0:19:30.91,0:19:33.50,Default,,0,0,0,,Ра… Райду-кун
Dialogue: 0,0:19:33.58,0:19:35.04,Default,,0,0,0,,Хахаха
Dialogue: 0,0:19:35.75,0:19:37.25,Default,,0,0,0,,Ахарен мырза...
Dialogue: 0,0:19:37.34,0:19:40.63,Default,,0,0,0,,Үшеуіңіз айдол тобын құра аласыз ба?
Dialogue: 0,0:19:40.72,0:19:41.72,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:42.80,0:19:45.68,Default,,0,0,0,,Қараңызшы, бұл Ахарен апалы-сіңлілері.
Dialogue: 0,0:19:45.76,0:19:47.43,Default,,0,0,0,,Әпкелер?
Dialogue: 0,0:19:47.51,0:19:49.81,Default,,0,0,0,,Рейна, бұл керемет.
Dialogue: 0,0:19:49.89,0:19:53.23,Default,,0,0,0,,Ол маған музыка мен киім жасады!
Dialogue: 0,0:19:54.44,0:19:56.36,Default,,0,0,0,,және осы адаммен шайқасуға рұқсат етті—
Dialogue: 0,0:19:56.44,0:20:00.24,Default,,0,0,0,,Ренга фестивальде кумир болғысы келетінін айтты.
Dialogue: 0,0:20:00.94,0:20:03.78,Default,,0,0,0,,Осымен бірге жүрейік...
Dialogue: 0,0:20:04.78,0:20:07.49,Default,,0,0,0,,Ол шынымен де кумир болатын
Dialogue: 0,0:20:08.08,0:20:09.70,Default,,0,0,0,,Ұят...
Dialogue: 0,0:20:09.79,0:20:10.91,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:20:11.00,0:20:11.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:11.91,0:20:14.75,Default,,0,0,0,,Сіз өзіңізге көбірек сенімді болуыңыз керек
Dialogue: 0,0:20:15.38,0:20:17.54,Default,,0,0,0,,Менің ойымша, Ахарен керемет.
Dialogue: 0,0:20:21.05,0:20:22.38,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:22.97,0:20:24.13,Default,,0,0,0,,Иә
Dialogue: 0,0:20:24.93,0:20:27.60,Default,,0,0,0,,Жарайды, мен барамын.
Dialogue: 0,0:20:28.31,0:20:30.56,Default,,0,0,0,,Сәттілік тілеймін, Ахарен-сан
Dialogue: 0,0:20:33.48,0:20:34.48,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:36.23,0:20:37.48,Default,,0,0,0,,Биыл ғана дебют жасаған –
Dialogue: 0,0:20:38.86,0:20:41.86,Default,,0,0,0,,Өз түйсігіңізге сенімдірек болыңыз
Dialogue: 0,0:20:41.94,0:20:45.32,Default,,0,0,0,,Барлығыңыз күтіңіздер!
Dialogue: 0,0:20:45.41,0:20:48.87,Default,,0,0,0,,♪ «Ахарен апалы-сіңлілері»
Dialogue: 0,0:21:08.35,0:21:11.64,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:21:19.77,0:21:20.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:21.32,0:21:23.07,Default,,0,0,0,,Қайырлы таң Ахарен-сан
Dialogue: 0,0:21:23.15,0:21:24.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:25.65,0:21:28.16,Default,,0,0,0,,Қайырлы таң Райду-кун
Dialogue: 0,0:21:28.74,0:21:31.12,Default,,0,0,0,,Ахарен мырза, бұл маска...
Dialogue: 0,0:21:31.62,0:21:32.87,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:33.83,0:21:36.62,Default,,0,0,0,,Бір түнде өте танымал кумирге айналды
Dialogue: 0,0:21:37.25,0:21:39.92,Default,,0,0,0,,Бетімді жасыру үшін маска киіп жүрмін.
Dialogue: 0,0:21:42.46,0:21:44.34,Default,,0,0,0,,Бейне 100 миллион қаралды
Dialogue: 0,0:21:44.42,0:21:46.13,Default,,0,0,0,,Будокан толып жатыр
Dialogue: 0,0:21:46.22,0:21:49.01,Default,,0,0,0,,SNS желісіндегі 10 миллион жазылушы
Dialogue: 0,0:21:49.09,0:21:51.43,Default,,0,0,0,,Мұндай атақты адамның ұқыпсыз әрекеті
Dialogue: 0,0:21:51.51,0:21:53.35,Default,,0,0,0,,Бірден апталық журналда жарияланады
Dialogue: 0,0:21:53.43,0:21:56.56,Default,,0,0,0,,Түнде ол қолжетімсіз болып қалды...
Dialogue: 0,0:21:57.10,0:22:00.31,Default,,0,0,0,,Бірақ бұл Ахарен мырзаның түсінген арманы.
Dialogue: 0,0:22:00.98,0:22:03.90,Default,,0,0,0,,Мен сіздің алдағы іс-әрекеттеріңізге қолдау көрсетуге бар күшімді саламын.
Dialogue: 0,0:22:04.57,0:22:07.45,Default,,0,0,0,,Ән айтсам тамағым ауырды.
Dialogue: 0,0:22:08.07,0:22:10.87,Default,,0,0,0,,Жарайды, өйткені мен енді ән айтпаймын.
Dialogue: 0,0:22:11.58,0:22:14.08,Default,,0,0,0,,Ах... бұл дұрыс.
Dialogue: 0,0:22:16.04,0:22:20.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:40.96,0:23:45.96,Default,,0,0,0,,～♪
