Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.25,0:00:05.50,Default,,0,0,0,,Ерен еңбегіңіз үшін рахмет, маркшейдер.
Dialogue: 0,0:00:05.58,0:00:07.59,Default,,0,0,0,,Сәлеметсіз бе ханым
Dialogue: 0,0:00:08.17,0:00:10.34,Default,,0,0,0,,Мен геодезист емеспін
Dialogue: 0,0:00:10.88,0:00:12.67,Default,,0,0,0,,Мен жер және үй маркшейдерімін.
Dialogue: 0,0:00:13.47,0:00:15.05,Default,,0,0,0,,(Кемпірдің айқайы)
Dialogue: 0,0:00:17.39,0:00:20.60,Default,,0,0,0,,Бұл... бұл шекаралық ставка!
Dialogue: 0,0:00:20.68,0:00:22.52,Default,,0,0,0,,Сәлем, геодезист!
Dialogue: 0,0:00:22.60,0:00:26.73,Default,,0,0,0,,Менің жерімде рұқсатсыз осындай әрекет жаса...
Dialogue: 0,0:00:26.81,0:00:29.40,Default,,0,0,0,,Көрші үйде Танака мырза!
Dialogue: 0,0:00:29.48,0:00:30.69,Default,,0,0,0,,Мұрагерлік жер
Dialogue: 0,0:00:30.78,0:00:33.19,Default,,0,0,0,,Ағайындылар оны тең үш бөлікке бөлу керек еді.
Dialogue: 0,0:00:34.32,0:00:35.16,Default,,0,0,0,,Иринака бұрынғыдай күшке ие емес
Dialogue: 0,0:00:35.24,0:00:37.41,Default,,0,0,0,,Шулы маркшейдер!
Dialogue: 0,0:00:37.49,0:00:39.12,Default,,0,0,0,,Мұның бәрі менің жерім!
Dialogue: 0,0:00:39.70,0:00:41.24,Default,,0,0,0,,Геодезист емес
Dialogue: 0,0:00:42.41,0:00:44.41,Default,,0,0,0,,Жерге және үйге геодезист
Dialogue: 0,0:00:44.50,0:00:48.08,Default,,0,0,0,,Тәртіпсіздік жасаңыз!
Dialogue: 0,0:00:48.17,0:00:49.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:50.88,0:00:52.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:53.13,0:00:54.13,Default,,0,0,0,,Кейінгі кескін
Dialogue: 0,0:00:54.97,0:00:57.59,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:00:58.18,0:00:59.39,Default,,0,0,0,,Мен айттым
Dialogue: 0,0:00:59.47,0:01:02.52,Default,,0,0,0,,Жай жер мен үйге маркшейдер!
Dialogue: 0,0:01:03.27,0:01:04.27,Default,,0,0,0,,Жоғарыда!
Dialogue: 0,0:01:05.94,0:01:07.31,Default,,0,0,0,,Жалпы станцияны іске қосу
Dialogue: 0,0:01:07.40,0:01:08.44,Default,,0,0,0,,Барлауды бастаңыз!
Dialogue: 0,0:01:11.73,0:01:13.90,Default,,0,0,0,,Мен сіздің шекараларыңызды өлшедім.
Dialogue: 0,0:01:13.99,0:01:15.57,Default,,0,0,0,,Тұрақты қада орнату!
Dialogue: 0,0:01:17.11,0:01:18.99,Default,,0,0,0,,Шекараның анықтамасы!
Dialogue: 0,0:01:19.62,0:01:23.37,Default,,0,0,0,,- Фудекай! -(Адам) Гяа!
Dialogue: 0,0:01:25.04,0:01:26.96,Default,,0,0,0,,Тіркеу аяқталды
Dialogue: 0,0:01:27.54,0:01:29.00,Default,,0,0,0,,Геодезист
Dialogue: 0,0:01:29.08,0:01:32.71,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:01:33.34,0:01:34.55,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:01:35.05,0:01:38.68,Default,,0,0,0,,Жерді және үйді зерттеушілер барлық жерде.
Dialogue: 0,0:01:46.56,0:01:47.64,Default,,0,0,0,,Әй?
Dialogue: 0,0:01:54.23,0:01:57.32,Default,,0,0,0,,Әже әже!
Dialogue: 0,0:01:58.82,0:02:00.03,Default,,0,0,0,,Сәлем әже
Dialogue: 0,0:02:02.78,0:02:04.87,Default,,0,0,0,,Не болды? Мадока
Dialogue: 0,0:02:04.95,0:02:06.25,Default,,0,0,0,,Anosa Anosa
Dialogue: 0,0:02:06.33,0:02:09.75,Default,,0,0,0,,Мен мұны қоймадан таптым. Бұл не?
Dialogue: 0,0:02:10.33,0:02:11.21,Default,,0,0,0,,Бұл…
Dialogue: 0,0:02:14.25,0:02:15.88,Default,,0,0,0,,Сондай сағыныш
Dialogue: 0,0:02:15.96,0:02:18.09,Default,,0,0,0,,Ол қалды
Dialogue: 0,0:02:18.17,0:02:20.47,Default,,0,0,0,,Бұл алмасу күнделігі
Dialogue: 0,0:02:20.55,0:02:22.05,Default,,0,0,0,,Мен орта мектеп оқушысы кезімде
Dialogue: 0,0:02:22.14,0:02:25.77,Default,,0,0,0,,Мен оны Райдодағы атаммен айырбастап тұрдым.
Dialogue: 0,0:02:26.35,0:02:29.23,Default,,0,0,0,,Райдоның атасы қандай адам болған?
Dialogue: 0,0:02:30.23,0:02:32.19,Default,,0,0,0,,Ата...
Dialogue: 0,0:02:40.61,0:02:43.28,Default,,0,0,0,,Олай болса кіріңіз.
Dialogue: 0,0:02:43.87,0:02:45.12,Default,,0,0,0,,Иә
Dialogue: 0,0:02:48.04,0:02:50.16,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:02:50.25,0:02:53.71,Default,,0,0,0,,Оқыту тәжірибесі кезінде көрсеткен көмегіңіз үшін рахмет. Мен осындамын.
Dialogue: 0,0:02:53.79,0:02:55.46,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:02:55.55,0:02:57.42,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:02:57.51,0:03:00.55,Default,,0,0,0,,Ең күшті қорқыныш қолданушысы, Райду-кун
Dialogue: 0,0:03:00.63,0:03:02.51,Default,,0,0,0,,Мен мектепке оралдым
Dialogue: 0,0:03:03.09,0:03:05.56,Default,,0,0,0,,Мұғалімдер, біраз уақыт өтті.
Dialogue: 0,0:03:05.64,0:03:07.64,Default,,0,0,0,,Ой... біраз болды.
Dialogue: 0,0:03:07.72,0:03:10.31,Default,,0,0,0,,Райду-кун, біраз уақыт өтті.
Dialogue: 0,0:03:10.39,0:03:13.15,Default,,0,0,0,,Басында бұл бірінші курстың бақылауы болды.
Dialogue: 0,0:03:13.23,0:03:15.98,Default,,0,0,0,,Менің сабағымды мұқият бақылаңыз.
Dialogue: 0,0:03:16.07,0:03:16.90,Default,,0,0,0,,Иә
Dialogue: 0,0:03:19.07,0:03:21.28,Default,,0,0,0,,Барлығың дайынсыңдар ма?
Dialogue: 0,0:03:21.78,0:03:23.36,Default,,0,0,0,,бастайық
Dialogue: 0,0:03:23.45,0:03:26.08,Default,,0,0,0,,А, мен оқулығымды ұмытып кетіппін.
Dialogue: 0,0:03:26.16,0:03:28.75,Default,,0,0,0,,Не, Футаба, ұмыттың ба?
Dialogue: 0,0:03:29.83,0:03:31.66,Default,,0,0,0,,Кел, бірге тамашалайық.
Dialogue: 0,0:03:31.75,0:03:35.25,Default,,0,0,0,,Ах... Рахмет, Ақкүн.
Dialogue: 0,0:03:36.04,0:03:38.00,Default,,0,0,0,,Сәлем, жаңадан келген адам!
Dialogue: 0,0:03:38.09,0:03:39.17,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:03:39.80,0:03:41.13,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:41.22,0:03:42.80,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:03:42.88,0:03:45.14,Default,,0,0,0,,Бірақ қан өте көп...
Dialogue: 0,0:03:45.22,0:03:49.56,Default,,0,0,0,,Бұл қан емес, ісінген шырын...
Dialogue: 0,0:03:49.64,0:03:51.10,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:51.18,0:03:52.39,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:52.89,0:03:57.15,Default,,0,0,0,,Содан кейін басқа мұғалімге есеп беріңіз, сонда сынып өздігінен жұмыс істейді...
Dialogue: 0,0:03:57.23,0:03:58.07,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:03:59.36,0:04:01.40,Default,,0,0,0,,Маған сабақ беруге рұқсат ете аласыз ба?
Dialogue: 0,0:04:03.03,0:04:04.11,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:04:04.70,0:04:07.03,Default,,0,0,0,,Иә, мен дайындық жасадым.
Dialogue: 0,0:04:07.12,0:04:09.08,Default,,0,0,0,,Содан кейін көріңіз.
Dialogue: 0,0:04:09.16,0:04:09.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:10.58,0:04:13.04,Default,,0,0,0,,Мен мұнда сабақ беру үшін келдім.
Dialogue: 0,0:04:13.12,0:04:16.08,Default,,0,0,0,,Мен Момохара мырзаның орнына сыныпқа сабақ беремін.
Dialogue: 0,0:04:16.17,0:04:17.79,Default,,0,0,0,,Бес бос дәптер парағы
Dialogue: 0,0:04:27.76,0:04:29.18,Default,,0,0,0,,(Рей) Уф~ Нұсқауларды мінсіз орындадым
Dialogue: 0,0:04:29.26,0:04:30.85,Default,,0,0,0,,Оң қолымен теңдеулерді шешіп отыр
Dialogue: 0,0:04:31.43,0:04:33.31,Default,,0,0,0,,Бұл жақсы сабақ болды.
Dialogue: 0,0:04:33.39,0:04:35.19,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:35.27,0:04:37.36,Default,,0,0,0,,Себебі маған мұғалімнің көмегі болды.
Dialogue: 0,0:04:37.44,0:04:38.82,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:04:38.90,0:04:40.57,Default,,0,0,0,,Момохара мырза!
Dialogue: 0,0:04:41.15,0:04:44.82,Default,,0,0,0,,Жақсысың ба? Мен оның түшкіргенінен құлап қалғанын естідім!
Dialogue: 0,0:04:45.99,0:04:49.83,Default,,0,0,0,,Мен жақында кетемін. Сен маған ашуыңды тағы қашан көрсетесің?
Dialogue: 0,0:04:49.91,0:04:52.29,Default,,0,0,0,,Жоқ, Хэянзан мырза.
Dialogue: 0,0:04:52.37,0:04:53.62,Default,,0,0,0,,Сенпай?
Dialogue: 0,0:04:53.71,0:04:57.38,Default,,0,0,0,,Бүгін мен тек оқушылардан мақтау алдым.
Dialogue: 0,0:04:57.46,0:04:59.96,Default,,0,0,0,,Райду-сан маған көмектесті.
Dialogue: 0,0:05:00.04,0:05:02.26,Default,,0,0,0,,Маған көмектестіңіз бе?
Dialogue: 0,0:05:02.34,0:05:04.30,Default,,0,0,0,,Иә, аздап
Dialogue: 0,0:05:04.88,0:05:07.18,Default,,0,0,0,,Райду-кун, сенің қайда екенің маған бәрібір.
Dialogue: 0,0:05:07.26,0:05:10.43,Default,,0,0,0,,Мен енді шу шығарғым келмейді.
Dialogue: 0,0:05:10.51,0:05:12.14,Default,,0,0,0,,Сіз ересек адам болдыңыз, солай емес пе?
Dialogue: 0,0:05:12.85,0:05:14.73,Default,,0,0,0,,Мен өте қуаныштымын!
Dialogue: 0,0:05:14.81,0:05:16.69,Default,,0,0,0,,(Мияхираның күлкісі)
Dialogue: 0,0:05:16.77,0:05:17.69,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:05:18.81,0:05:22.15,Default,,0,0,0,,Қызық... бес жыл бұрын болса да.
Dialogue: 0,0:05:22.23,0:05:25.82,Default,,0,0,0,,Мен орта мектепке қайта оралғандай болдым
Dialogue: 0,0:05:27.91,0:05:32.20,Default,,0,0,0,,Қазірдің өзінде мен дәл қасымда Ахарен мырза тұрғандай сезінемін.
Dialogue: 0,0:05:32.91,0:05:36.91,Default,,0,0,0,,Солай бола тұрса да, мен бүгін ерекше сезінемін.
Dialogue: 0,0:05:37.00,0:05:39.79,Default,,0,0,0,,Сіз дәл қазір сол жерде сияқтысыз...
Dialogue: 0,0:05:42.21,0:05:43.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:44.80,0:05:48.30,Default,,0,0,0,,Сәлем Райду-кун
Dialogue: 0,0:05:49.18,0:05:50.76,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:52.76,0:05:55.10,Default,,0,0,0,,Осы мектептен осы жылдан бастап
Dialogue: 0,0:05:55.18,0:05:58.52,Default,,0,0,0,,Мен өнер пәнінің мұғалімі болып тағайындалдым.
Dialogue: 0,0:05:58.60,0:06:00.31,Default,,0,0,0,,Мен Авамен біргемін.
Dialogue: 0,0:06:01.06,0:06:04.78,Default,,0,0,0,,Райду-кун, сіз өзіңіздің альма-матеріңізде жаттығу жасаймын дедіңіз.
Dialogue: 0,0:06:04.86,0:06:09.20,Default,,0,0,0,,Мен сені таң қалдырғым келгендіктен үндемедім.
Dialogue: 0,0:06:09.91,0:06:11.24,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:16.50,0:06:18.25,Default,,0,0,0,,...Мен сені құшақтағым келді...
Dialogue: 0,0:06:18.33,0:06:20.92,Default,,0,0,0,,Мен жаттығуда болдым, сондықтан мен көп нәрсені ұстай алдым.
Dialogue: 0,0:06:21.00,0:06:22.25,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:06:22.84,0:06:26.84,Default,,0,0,0,,Ронин ретінде мен жұмыс күшіне кірер алдында бір жылға кешіктім.
Dialogue: 0,0:06:27.42,0:06:30.97,Default,,0,0,0,,Мен Ахарен мырзамен осында кездескеніме өте қуаныштымын.
Dialogue: 0,0:06:31.55,0:06:33.05,Default,,0,0,0,,тосын сый Рахмет
Dialogue: 0,0:06:33.55,0:06:35.35,Default,,0,0,0,,Сізге рахмет, мен қолымнан келгеннің бәрін жасай аламын деп ойлаймын.
Dialogue: 0,0:06:36.02,0:06:37.68,Default,,0,0,0,,Қазір істей алмаудың орнына
Dialogue: 0,0:06:37.77,0:06:40.06,Default,,0,0,0,,Сабақтан кейін мен сені қатты құшақтаймын.
Dialogue: 0,0:06:40.65,0:06:42.27,Default,,0,0,0,,Уау...
Dialogue: 0,0:06:42.36,0:06:45.65,Default,,0,0,0,,Міне...міне, Райду-кун, мектепте солай болды.
Dialogue: 0,0:06:45.73,0:06:48.74,Default,,0,0,0,,Мұнда, мұнда, мұнда, мұнда ...
Dialogue: 0,0:06:48.82,0:06:50.99,Default,,0,0,0,,Кешіріңіз... кешіріңіз.
Dialogue: 0,0:06:52.66,0:06:54.58,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:06:55.79,0:06:57.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:57.16,0:06:59.87,Default,,0,0,0,,Көптен бері бір-біріңді көрмедіңдер ме?
Dialogue: 0,0:06:59.96,0:07:00.79,Default,,0,0,0,,Иә
Dialogue: 0,0:07:00.87,0:07:03.63,Default,,0,0,0,,Әже, сіз жалғыз емес пе едіңіз?
Dialogue: 0,0:07:04.21,0:07:08.26,Default,,0,0,0,,Мен жалғыз емес едім...жалғыз болғаным емес.
Dialogue: 0,0:07:08.34,0:07:10.47,Default,,0,0,0,,Өйткені сіз уәде бергенсіз
Dialogue: 0,0:07:10.55,0:07:11.84,Default,,0,0,0,,Тіпті ұйықтап қалғаннан кейін де, кем дегенде—
Dialogue: 0,0:07:13.34,0:07:14.80,Default,,0,0,0,,Сәлем Райду-кун
Dialogue: 0,0:07:14.89,0:07:16.56,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:07:17.14,0:07:19.27,Default,,0,0,0,,Мен сенімен суретке түсе аламын ба?
Dialogue: 0,0:07:19.35,0:07:21.06,Default,,0,0,0,,Әрине жақсы.
Dialogue: 0,0:07:21.14,0:07:22.94,Default,,0,0,0,,Иә! Суретке түсіру, суретке түсіру
Dialogue: 0,0:07:23.02,0:07:24.23,Default,,0,0,0,,Келесі мен!
Dialogue: 0,0:07:26.19,0:07:27.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:28.78,0:07:32.78,Default,,0,0,0,,Бірақ мен оған әлі жеткен жоқпын.
Dialogue: 0,0:07:32.86,0:07:34.91,Default,,0,0,0,,Біраз күте аласыз ба?
Dialogue: 0,0:07:34.99,0:07:36.41,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:07:36.49,0:07:40.20,Default,,0,0,0,,Ахарен мырза, мен әлі де тәжірибесіз адаммын.
Dialogue: 0,0:07:40.29,0:07:42.21,Default,,0,0,0,,Мен өзімді көбірек жетілдіруім керек
Dialogue: 0,0:07:42.29,0:07:43.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:46.46,0:07:47.55,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:07:47.63,0:07:50.55,Default,,0,0,0,,Мен сізге хат жаздым, оқып бере аласыз ба?
Dialogue: 0,0:07:51.05,0:07:51.88,Default,,0,0,0,,Иә
Dialogue: 0,0:07:59.18,0:08:01.89,Default,,0,0,0,,Ахарен мырзаның күнделікті сезімдері және сізге ұнайтыны
Dialogue: 0,0:08:01.98,0:08:03.48,Default,,0,0,0,,Мен оны сақтауға тырыстым.
Dialogue: 0,0:08:03.56,0:08:06.81,Default,,0,0,0,,Мм... иә, рахмет
Dialogue: 0,0:08:07.57,0:08:08.57,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:08.65,0:08:11.78,Default,,0,0,0,,Иә... Мен шынымен бақыттымын.
Dialogue: 0,0:08:11.86,0:08:14.61,Default,,0,0,0,,Жарайды, солай.
Dialogue: 0,0:08:16.57,0:08:19.70,Default,,0,0,0,,Иә? Кенеттен не болды?
Dialogue: 0,0:08:21.20,0:08:22.91,Default,,0,0,0,,- Таманаха-сан - Иә!
Dialogue: 0,0:08:23.00,0:08:24.62,Default,,0,0,0,,Ах... Жігіт
Dialogue: 0,0:08:24.71,0:08:26.21,Default,,0,0,0,,Ууух!
Dialogue: 0,0:08:26.29,0:08:27.59,Default,,0,0,0,,Не?
Dialogue: 0,0:08:28.17,0:08:32.55,Default,,0,0,0,,Мен қорқамын, бұл ыңғайсыздық төлемінің шоты...
Dialogue: 0,0:08:33.38,0:08:34.51,Default,,0,0,0,,«Әрқашан Ахарен-санмен бірге»
Dialogue: 0,0:08:34.59,0:08:36.93,Default,,0,0,0,,«Ойнағаныңызға рахмет»
Dialogue: 0,0:08:37.01,0:08:39.10,Default,,0,0,0,,«Бүгін мен ризашылығымды білдіргім келеді»
Dialogue: 0,0:08:39.18,0:08:40.81,Default,,0,0,0,,«Мен хат жаздым».
Dialogue: 0,0:08:40.89,0:08:45.02,Default,,0,0,0,,Жігітім мені жек көрмейтін.
Dialogue: 0,0:08:45.10,0:08:47.40,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:08:51.44,0:08:54.15,Default,,0,0,0,,Тікелей үлкен тосынсый!
Dialogue: 0,0:09:05.16,0:09:07.83,Default,,0,0,0,,Жарайды, бұл жақсы.
Dialogue: 0,0:09:08.79,0:09:12.80,Default,,0,0,0,,Райду-кун, сен неге маған кенет хат жібердің?
Dialogue: 0,0:09:13.38,0:09:16.38,Default,,0,0,0,,Өзін-өзі жетілдіру тек сырттай ғана емес.
Dialogue: 0,0:09:16.47,0:09:18.76,Default,,0,0,0,,Өйткені, ішіндегісі маңызды
Dialogue: 0,0:09:18.84,0:09:21.56,Default,,0,0,0,,Ең алдымен адамдарға деген ризашылықты сезіну.
Dialogue: 0,0:09:21.64,0:09:25.23,Default,,0,0,0,,Мен өз ойымды шынымды айтсам деп ойладым.
Dialogue: 0,0:09:25.81,0:09:30.19,Default,,0,0,0,,Міне, өзін-өзі жетілдіру.
Dialogue: 0,0:09:30.77,0:09:32.19,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:09:32.28,0:09:33.19,Default,,0,0,0,,О
Dialogue: 0,0:09:33.78,0:09:34.99,Default,,0,0,0,,Қалағаныңызша көп суретке түсіріңіз
Dialogue: 0,0:09:34.99,0:09:35.44,Default,,0,0,0,,Қалағаныңызша көп суретке түсіріңіз
Dialogue: 0,0:09:34.99,0:09:35.44,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:09:35.44,0:09:35.53,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:09:35.53,0:09:37.41,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:09:35.53,0:09:37.41,Default,,0,0,0,,-(Қыз оқушы 1) Ұнады, жақсы -(Әйел оқушы 2) Керемет поза!
Dialogue: 0,0:09:37.41,0:09:37.49,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:09:37.49,0:09:38.66,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:09:37.49,0:09:38.66,Default,,0,0,0,,Иә, толы...
Dialogue: 0,0:09:38.74,0:09:39.37,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:09:39.37,0:09:42.66,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:09:39.37,0:09:42.66,Default,,0,0,0,,Мен әріптер арқылы өзімді көп өскендей сезінемін.
Dialogue: 0,0:09:42.74,0:09:44.70,Default,,0,0,0,,Олай болса, келесі жолы бізді де суретке түсір.
Dialogue: 0,0:09:45.45,0:09:48.21,Default,,0,0,0,,А, бұл мен болуым керек емес.
Dialogue: 0,0:09:48.29,0:09:49.83,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:09:52.42,0:09:54.26,Default,,0,0,0,,Біз де суретке түсейік
Dialogue: 0,0:09:54.34,0:09:57.68,Default,,0,0,0,,Ахарен мырза да суретке түскісі келді.
Dialogue: 0,0:09:57.76,0:09:59.47,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:09:59.55,0:10:01.43,Default,,0,0,0,,(Таймердің кері санау дыбысы)
Dialogue: 0,0:10:01.51,0:10:02.18,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:10:02.18,0:10:03.26,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:10:02.18,0:10:03.26,Default,,0,0,0,,Ия
Dialogue: 0,0:10:03.26,0:10:03.89,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:10:06.52,0:10:10.02,Default,,0,0,0,,Бірақ неге бәрі кенет суретке түсіп жатыр...
Dialogue: 0,0:10:10.10,0:10:12.48,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:10:14.28,0:10:17.45,Default,,0,0,0,,Ертең мектеп бітірушілерді тапсыру салтанаты.
Dialogue: 0,0:10:21.45,0:10:22.91,Default,,0,0,0,,Мен өзімді жалғыз сезінемін.
Dialogue: 0,0:10:23.78,0:10:24.87,Default,,0,0,0,,Иә
Dialogue: 0,0:10:27.62,0:10:29.08,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:10:30.62,0:10:33.79,Default,,0,0,0,,Ла… Райду-кунға
Dialogue: 0,0:10:34.46,0:10:36.55,Default,,0,0,0,,Мен сізге бір нәрсе бергім келеді ме?
Dialogue: 0,0:10:38.47,0:10:41.80,Default,,0,0,0,,Осыны оқығаныңызды қалаймын
Dialogue: 0,0:10:51.23,0:10:55.23,Default,,0,0,0,,А, бітті.
Dialogue: 0,0:10:55.32,0:10:57.03,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:57.11,0:11:00.53,Default,,0,0,0,,Оширо мырза келесі аптада жұмысқа бара жатыр ма?
Dialogue: 0,0:11:00.61,0:11:01.91,Default,,0,0,0,,Иә
Dialogue: 0,0:11:03.16,0:11:06.33,Default,,0,0,0,,Әркім әртүрлі.
Dialogue: 0,0:11:06.41,0:11:10.04,Default,,0,0,0,,Бөлек... Уф!
Dialogue: 0,0:11:10.12,0:11:12.71,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:11:12.79,0:11:14.25,Default,,0,0,0,,Ахарен мырза
Dialogue: 0,0:11:18.30,0:11:21.88,Default,,0,0,0,,Кешегі хат туралы сұрасам болады ма?
Dialogue: 0,0:11:25.35,0:11:26.39,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:27.77,0:11:29.18,Default,,0,0,0,,Ахарен мырза...
Dialogue: 0,0:11:30.52,0:11:35.56,Default,,0,0,0,,Сіз маған неліктен ажырағыңыз келетінін айта аласыз ба?
Dialogue: 0,0:11:35.65,0:11:37.44,Default,,0,0,0,,- (Ишикава) Не... - (Осиро) А? Неліктен?
Dialogue: 0,0:11:37.53,0:11:38.78,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:11:43.41,0:11:46.20,Default,,0,0,0,,Ра... Райду-кун
Dialogue: 0,0:11:46.91,0:11:51.41,Default,,0,0,0,,Жан-жақты, таңғажайып, көп нәрсені істей алады.
Dialogue: 0,0:11:52.12,0:11:56.13,Default,,0,0,0,,Мен қазірден бастап әртүрлі нәрселерге айнала аламын деп ойлаймын.
Dialogue: 0,0:11:56.71,0:11:58.38,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:11:58.46,0:12:03.34,Default,,0,0,0,,Бұдан былай, Райду-кун, сен неше түрлі адамдарды кездестіресің.
Dialogue: 0,0:12:04.47,0:12:07.72,Default,,0,0,0,,Менен жақсы адамдар көп.
Dialogue: 0,0:12:09.35,0:12:11.77,Default,,0,0,0,,Райду-кун мейірімді
Dialogue: 0,0:12:13.73,0:12:16.15,Default,,0,0,0,,Мен сізге айтуым керек
Dialogue: 0,0:12:17.23,0:12:21.24,Default,,0,0,0,,Қашықтық Өйткені біз бір-бірімізден алыс боламыз...
Dialogue: 0,0:12:24.03,0:12:26.07,Default,,0,0,0,,Ештеңе жасамау
Dialogue: 0,0:12:26.91,0:12:29.79,Default,,0,0,0,,Мен алыстамын, ештеңе істей алмаймын
Dialogue: 0,0:12:30.79,0:12:35.75,Default,,0,0,0,,...
Dialogue: 0,0:12:36.42,0:12:38.92,Default,,0,0,0,,Ол «Рух толқынын» қолдануда — қалағанынша жоғалып, қайта пайда бола алады.
Dialogue: 0,0:12:42.97,0:12:45.59,Default,,0,0,0,,Ах... мен
Dialogue: 0,0:12:46.18,0:12:50.31,Default,,0,0,0,,...
Dialogue: 0,0:12:50.89,0:12:53.43,Default,,0,0,0,,Менде байланыс жоқ
Dialogue: 0,0:12:53.52,0:12:56.73,Default,,0,0,0,,Мен тек саған қарап тұрмын деп ойладым.
Dialogue: 0,0:12:57.27,0:12:58.81,Default,,0,0,0,,Өзіме солай
Dialogue: 0,0:12:59.40,0:13:03.44,Default,,0,0,0,,...
Dialogue: 0,0:13:03.53,0:13:04.53,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:13:05.32,0:13:08.91,Default,,0,0,0,,...
Dialogue: 0,0:13:08.99,0:13:11.66,Default,,0,0,0,,Ум... аа...
Dialogue: 0,0:13:12.16,0:13:14.75,Default,,0,0,0,,Мен оның не екенін білмеймін.
Dialogue: 0,0:13:15.96,0:13:18.96,Default,,0,0,0,,Бірақ бәрібір...
Dialogue: 0,0:13:19.04,0:13:23.38,Default,,0,0,0,,Аа... Екеуінің бақытты болғанын қалаймын...
Dialogue: 0,0:13:23.46,0:13:26.13,Default,,0,0,0,,(Рику жылайды)
Dialogue: 0,0:13:26.72,0:13:29.64,Default,,0,0,0,,Райду, не істегіңіз келеді?
Dialogue: 0,0:13:29.72,0:13:31.76,Default,,0,0,0,,Сонымен, көңіліңізден шықты ма?
Dialogue: 0,0:13:31.85,0:13:33.31,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:13:33.89,0:13:35.18,Default,,0,0,0,,Ишикава…
Dialogue: 0,0:13:44.49,0:13:48.20,Default,,0,0,0,,Сезіміңізді жеткізгеніңіз үшін рахмет, Ахарен-сан.
Dialogue: 0,0:13:49.45,0:13:52.91,Default,,0,0,0,,Менің айтайын дегенім – өз сезімдерім.
Dialogue: 0,0:13:52.99,0:13:56.83,Default,,0,0,0,,Бұл өзімшіл және біржақты, бірақ мені тыңдаңыз.
Dialogue: 0,0:13:58.08,0:13:59.54,Default,,0,0,0,,Иә
Dialogue: 0,0:14:00.42,0:14:01.46,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:02.88,0:14:06.55,Default,,0,0,0,,Ахарен мырза ештеңе істеп жатқан жоқ деп ойлаймын.
Dialogue: 0,0:14:07.51,0:14:11.14,Default,,0,0,0,,Ахарен мырзамен кездескеніме үш жыл болды.
Dialogue: 0,0:14:11.22,0:14:13.72,Default,,0,0,0,,Мен Ахарен мырзадан көп нәрсені алдым.
Dialogue: 0,0:14:14.31,0:14:16.77,Default,,0,0,0,,Кешіріңіз, мен сізге осы уақытқа дейін айта алмадым.
Dialogue: 0,0:14:18.69,0:14:21.15,Default,,0,0,0,,Біз әрқашан бірге көңіл көтердік.
Dialogue: 0,0:14:21.73,0:14:25.36,Default,,0,0,0,,Мен осындай болсам да, көп достар таптым.
Dialogue: 0,0:14:25.94,0:14:28.49,Default,,0,0,0,,Ахарен-сансыз оқу
Dialogue: 0,0:14:28.57,0:14:30.57,Default,,0,0,0,,Мен бұлай жұмыс істей алмадым
Dialogue: 0,0:14:30.66,0:14:32.07,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:33.08,0:14:37.00,Default,,0,0,0,,Өзіңізге ұнайтын және не істегіңіз келетініне сараңдықпен қарау.
Dialogue: 0,0:14:37.08,0:14:39.29,Default,,0,0,0,,Себебі Ахарен-сан маған сабақ берді.
Dialogue: 0,0:14:40.17,0:14:44.00,Default,,0,0,0,,Ахарен мырзаның болуы үлкен қолдау.
Dialogue: 0,0:14:44.59,0:14:45.59,Default,,0,0,0,,Және…
Dialogue: 0,0:14:47.80,0:14:50.34,Default,,0,0,0,,Мен Ахарен-санмен ажырасқым келмейді.
Dialogue: 0,0:14:51.51,0:14:54.14,Default,,0,0,0,,Мен болашақты байлағым келмейтінін айттым.
Dialogue: 0,0:14:54.22,0:14:56.35,Default,,0,0,0,,Белгіленген болашақ болса
Dialogue: 0,0:14:59.64,0:15:03.52,Default,,0,0,0,,Қандай жағдай болса да, мен оны жеңемін.
Dialogue: 0,0:15:04.19,0:15:05.65,Default,,0,0,0,,Сонымен, Ахарен мырза
Dialogue: 0,0:15:07.15,0:15:09.11,Default,,0,0,0,,Біз тағы кездескен кезде
Dialogue: 0,0:15:09.19,0:15:12.03,Default,,0,0,0,,Осы сезім екеумізде мәңгілік болса...
Dialogue: 0,0:15:14.49,0:15:15.91,Default,,0,0,0,,Ағаш қоршауға барып, оны ұстап, бір-бірімізден ажырайық.
Dialogue: 0,0:15:18.54,0:15:19.62,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:15:20.79,0:15:21.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:28.80,0:15:29.80,Default,,0,0,0,,Иә
Dialogue: 0,0:15:31.38,0:15:33.93,Default,,0,0,0,,Мен сізге міндетті түрде келемін
Dialogue: 0,0:15:34.97,0:15:38.18,Default,,0,0,0,,Бүгіннен бастап бізді қандай болашақ күтіп тұрса да
Dialogue: 0,0:15:43.56,0:15:45.73,Default,,0,0,0,,(камера таймерінің кері санақ дыбысы)
Dialogue: 0,0:15:45.81,0:15:46.65,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:15:47.36,0:15:50.86,Default,,0,0,0,,Жарайды, жарайды, біз бастадық.
Dialogue: 0,0:15:50.95,0:15:53.70,Default,,0,0,0,,Сол күнді асыға күт, Ахарен-сан.
Dialogue: 0,0:15:54.28,0:15:55.28,Default,,0,0,0,,Ахарен мырза?
Dialogue: 0,0:15:55.37,0:15:58.62,Default,,0,0,0,,Иә, мен әлі рахмет айтқан жоқпын.
Dialogue: 0,0:15:58.70,0:16:00.33,Default,,0,0,0,,Ахарен мырзаға ұқсайды.
Dialogue: 0,0:16:01.62,0:16:02.46,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:02.54,0:16:06.79,Default,,0,0,0,,Үйлену тойында ойнау үшін аяқталған фильм!
Dialogue: 0,0:16:06.88,0:16:08.25,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:10.55,0:16:12.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:12.26,0:16:15.01,Default,,0,0,0,,Бұл екеуі үйленіп жатыр ма?
Dialogue: 0,0:16:15.59,0:16:18.14,Default,,0,0,0,,Мен де солай үйленгім келеді.
Dialogue: 0,0:16:18.22,0:16:19.85,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:16:21.98,0:16:23.06,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:16:23.64,0:16:24.73,Default,,0,0,0,,Маған тұрмысқа шығасың ба?
Dialogue: 0,0:16:24.81,0:16:25.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:26.73,0:16:29.48,Default,,0,0,0,,Ха... қалжыңдауды доғар.
Dialogue: 0,0:16:30.07,0:16:32.44,Default,,0,0,0,,Өйткені Ишикава-кун...
Dialogue: 0,0:16:33.03,0:16:36.41,Default,,0,0,0,,Енді менімен бірге...
Dialogue: 0,0:16:43.41,0:16:45.33,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:16:46.42,0:16:48.84,Default,,0,0,0,,Не... неге?
Dialogue: 0,0:16:49.42,0:16:51.84,Default,,0,0,0,,Өйткені Ишикава-кун...
Dialogue: 0,0:16:52.38,0:16:55.59,Default,,0,0,0,,Өйткені... неге?
Dialogue: 0,0:16:55.68,0:16:59.35,Default,,0,0,0,,Ешкім бірін немесе екіншісін шешкен жоқ.
Dialogue: 0,0:16:59.97,0:17:02.64,Default,,0,0,0,,Осы уақытқа дейін қалыпты жағдайға келтіргеніңіз үшін рахмет.
Dialogue: 0,0:17:02.73,0:17:06.31,Default,,0,0,0,,Сіз мұны білмей тұрып, сіз бірге болуыңыз керек адамға айналасыз ...
Dialogue: 0,0:17:06.40,0:17:08.86,Default,,0,0,0,,Ол менің бірінші адамыма айналды.
Dialogue: 0,0:17:09.44,0:17:11.32,Default,,0,0,0,,Маған тұрмысқа шығуыңызды өтінемін
Dialogue: 0,0:17:14.86,0:17:15.86,Default,,0,0,0,,Иә
Dialogue: 0,0:17:20.70,0:17:24.79,Default,,0,0,0,,Рахмет, Оширо мырза, дүкен бос емес болса да.
Dialogue: 0,0:17:24.87,0:17:26.92,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:17:27.00,0:17:30.63,Default,,0,0,0,,Тойда шашымды байласам деген арманым орындалды.
Dialogue: 0,0:17:31.21,0:17:33.67,Default,,0,0,0,,Мені еске алғаныңызға рахмет.
Dialogue: 0,0:17:33.76,0:17:34.59,Default,,0,0,0,,Иә
Dialogue: 0,0:17:34.67,0:17:37.05,Default,,0,0,0,,Иә, мен жасадым.
Dialogue: 0,0:17:37.13,0:17:41.26,Default,,0,0,0,,Құттықтаймын Рейна-чан, сен сондай әдемісің
Dialogue: 0,0:17:43.81,0:17:46.44,Default,,0,0,0,,Сізге де рахмет, Оширо мырза.
Dialogue: 0,0:17:46.52,0:17:47.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:48.60,0:17:49.86,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:50.44,0:17:56.24,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:18:08.33,0:18:10.83,Default,,0,0,0,,Рахмет сізге Райду-кун
Dialogue: 0,0:18:11.92,0:18:14.71,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:18:15.42,0:18:16.26,Default,,0,0,0,,Мен де
Dialogue: 0,0:18:17.67,0:18:20.68,Default,,0,0,0,,Осы уақытқа дейін көп нәрсе болды.
Dialogue: 0,0:18:21.64,0:18:24.14,Default,,0,0,0,,Енді не болар екен деп ойлаймын.
Dialogue: 0,0:18:32.44,0:18:35.11,Default,,0,0,0,,Бұл соңы
Dialogue: 0,0:18:35.19,0:18:38.40,Default,,0,0,0,,Иә, мен көбірек тыңдағым келеді!
Dialogue: 0,0:18:38.49,0:18:41.32,Default,,0,0,0,,Қараңызшы, қараңғы түсіп кетті.
Dialogue: 0,0:18:41.91,0:18:43.99,Default,,0,0,0,,Хмм, түсіндім.
Dialogue: 0,0:18:44.08,0:18:45.66,Default,,0,0,0,,Олай болса
Dialogue: 0,0:18:45.74,0:18:48.58,Default,,0,0,0,,Келесі келгенде маған толығырақ айтып беріңізші.
Dialogue: 0,0:18:48.66,0:18:51.79,Default,,0,0,0,,Иә, келесі кездескенше.
Dialogue: 0,0:18:51.88,0:18:54.25,Default,,0,0,0,,Атам ғажап адам емес пе?
Dialogue: 0,0:18:54.34,0:18:55.75,Default,,0,0,0,,Иә
Dialogue: 0,0:18:55.84,0:18:59.97,Default,,0,0,0,,Барлығын біл, бәрін істе
Dialogue: 0,0:19:00.55,0:19:03.80,Default,,0,0,0,,Менде ешқашан ойламаған идея бар.
Dialogue: 0,0:19:04.39,0:19:07.93,Default,,0,0,0,,Кенеттен күтпеген нәрсені жасаңыз
Dialogue: 0,0:19:08.02,0:19:12.15,Default,,0,0,0,,Бірақ сен бірінші мені ойлайсың...
Dialogue: 0,0:19:12.23,0:19:16.48,Default,,0,0,0,,Рас, өлшей алмайтын адаммын.
Dialogue: 0,0:19:16.57,0:19:18.90,Default,,0,0,0,,Бұл керемет, ата.
Dialogue: 0,0:19:18.99,0:19:21.07,Default,,0,0,0,,Енді қайдасың?
Dialogue: 0,0:19:23.87,0:19:25.74,Default,,0,0,0,,Жұлдыз?
Dialogue: 0,0:19:25.83,0:19:31.42,Default,,0,0,0,,Ол бізді өте алыстан бақылап тұр.
Dialogue: 0,0:19:38.84,0:19:41.05,Default,,0,0,0,,Қатысқан мұғалімге рахмет.
Dialogue: 0,0:19:41.13,0:19:43.39,Default,,0,0,0,,Бәрі жақсы аяқталатын сияқты.
Dialogue: 0,0:19:43.47,0:19:47.47,Default,,0,0,0,,Жоқ, бұл жақсы тәжірибе болды.
Dialogue: 0,0:19:47.56,0:19:50.68,Default,,0,0,0,,Мен сіздің жаңа шығармаңызды оқыдым.
Dialogue: 0,0:19:51.27,0:19:53.06,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:53.15,0:19:56.73,Default,,0,0,0,,Бірақ сіз, романшы, неге бұлай ұзаққа бардыңыз?
Dialogue: 0,0:19:56.82,0:19:59.90,Default,,0,0,0,,Сіз Марсты зерттеу жобасына қатысқыңыз келе ме?
Dialogue: 0,0:20:00.49,0:20:01.74,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:03.91,0:20:06.24,Default,,0,0,0,,Бұл бірнеше жылға созылатын жоба.
Dialogue: 0,0:20:06.87,0:20:09.12,Default,,0,0,0,,Сіз бара алатыныңызға сенімдісіз бе?
Dialogue: 0,0:20:11.33,0:20:12.71,Default,,0,0,0,,Сен
Dialogue: 0,0:20:13.29,0:20:18.59,Default,,0,0,0,,Сіз маған елестете алатын кез келген нәрсе орындалатынын үйреттіңіз.
Dialogue: 0,0:20:19.46,0:20:21.09,Default,,0,0,0,,Бұл жолы...
Dialogue: 0,0:20:22.88,0:20:26.85,Default,,0,0,0,,Енді оны әлемге айт
Dialogue: 0,0:20:27.51,0:20:29.51,Default,,0,0,0,,Міндетті түрде қайтып келіңіз
Dialogue: 0,0:20:30.10,0:20:33.48,Default,,0,0,0,,Рахмет, мен міндетті түрде қайтамын.
Dialogue: 0,0:20:34.69,0:20:38.48,Default,,0,0,0,,Мен сені күтемін, Шота-күн.
Dialogue: 0,0:20:40.23,0:20:43.40,Default,,0,0,0,,Жарайды, қазір үйге қайтайық.
Dialogue: 0,0:20:43.49,0:20:46.11,Default,,0,0,0,,Соңғы бір нәрсе сұрасам болады ма?
Dialogue: 0,0:20:46.20,0:20:49.37,Default,,0,0,0,,Бір ғана нәрсе қалды...
Dialogue: 0,0:20:49.45,0:20:51.08,Default,,0,0,0,,Хаса әже
Dialogue: 0,0:20:51.16,0:20:54.08,Default,,0,0,0,,Атаңнан нені көрдің, ол сені ғашық етті?
Dialogue: 0,0:20:54.16,0:20:55.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:56.00,0:20:58.00,Default,,0,0,0,,Қазірдің өзінде... не туралы айтып тұрсыз?
Dialogue: 0,0:20:58.09,0:21:01.67,Default,,0,0,0,,Жарайды! айт маған айт
Dialogue: 0,0:21:01.76,0:21:03.17,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:21:04.47,0:21:08.51,Default,,0,0,0,,Алғаш кездескенімізді айтып берейін.
Dialogue: 0,0:21:13.27,0:21:17.40,Default,,0,0,0,,Мен Авамен біргемін. Рақмет сізге.
Dialogue: 0,0:21:17.98,0:21:19.86,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:21:19.94,0:21:22.11,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:21:23.15,0:21:25.07,Default,,0,0,0,,Мен мазасызданып тұрмын...
Dialogue: 0,0:21:26.36,0:21:31.28,Default,,0,0,0,,Даусым кішкентай болғандықтан және қашықтықты өлшей алмайтындықтан
Dialogue: 0,0:21:31.37,0:21:34.75,Default,,0,0,0,,Мен осы уақытқа дейін дос таба алмадым.
Dialogue: 0,0:21:36.08,0:21:39.08,Default,,0,0,0,,Менің ойымша, орта мектеп онша ерекшеленбейді.
Dialogue: 0,0:21:40.17,0:21:42.80,Default,,0,0,0,,Мен өзімді жаман сезінгім келмейді...
Dialogue: 0,0:21:43.71,0:21:47.18,Default,,0,0,0,,Адамдармен көп араласпау
Dialogue: 0,0:21:47.26,0:21:49.72,Default,,0,0,0,,Уақытты тыныш өткізейік
Dialogue: 0,0:21:50.43,0:21:52.68,Default,,0,0,0,,Қайырлы таң Ахарен-сан
Dialogue: 0,0:21:54.73,0:21:58.10,Default,,0,0,0,,Қасымда отырған үлкен бала.
Dialogue: 0,0:21:58.19,0:21:59.86,Default,,0,0,0,,Райду-кун
Dialogue: 0,0:21:59.94,0:22:03.07,Default,,0,0,0,,Қайырлы таң Райду-кун
Dialogue: 0,0:22:03.15,0:22:05.15,Default,,0,0,0,,♪～
Dialogue: 0,0:22:05.15,0:22:07.99,Default,,0,0,0,,♪～
Dialogue: 0,0:22:05.15,0:22:07.99,Default,,0,0,0,,Өйткені, менің дауысым саған жеткен жоқ.
Dialogue: 0,0:22:08.57,0:22:11.45,Default,,0,0,0,,Мен оны елемеді деп ойлайсың.
Dialogue: 0,0:22:11.53,0:22:14.20,Default,,0,0,0,,Сен енді менімен сөйлеспейсің.
Dialogue: 0,0:22:14.29,0:22:16.41,Default,,0,0,0,,Бұл жақсырақ.
Dialogue: 0,0:22:16.50,0:22:19.46,Default,,0,0,0,,Менімен ешнәрсе болмағаны жақсы...
Dialogue: 0,0:22:20.04,0:22:22.29,Default,,0,0,0,,Ауа райы жақсы, Ахарен-сан.
Dialogue: 0,0:22:22.38,0:22:23.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:28.80,0:22:30.43,Default,,0,0,0,,Бұл мектеп ауласы үлкен.
Dialogue: 0,0:22:30.51,0:22:32.51,Default,,0,0,0,,Нан сатып алу Дәмді сияқты.
Dialogue: 0,0:22:32.60,0:22:34.72,Default,,0,0,0,,Мен үйірме жұмыстарымен не істеймін деп алаңдаймын.
Dialogue: 0,0:22:35.35,0:22:36.52,Default,,0,0,0,,Неге сонша?
Dialogue: 0,0:22:36.60,0:22:39.23,Default,,0,0,0,,Менің ойымша, ол менімен сөйлесіп жатыр.
Dialogue: 0,0:22:39.31,0:22:42.94,Default,,0,0,0,,Мен мұндай адамды бірінші рет кездестіруім.
Dialogue: 0,0:22:44.86,0:22:46.65,Default,,0,0,0,,Райду-кун...
Dialogue: 0,0:22:49.20,0:22:51.70,Default,,0,0,0,,Бірақ олар мені елемейді.
Dialogue: 0,0:22:51.78,0:22:53.70,Default,,0,0,0,,Сіз солай ойлайсыз.
Dialogue: 0,0:22:53.78,0:22:57.54,Default,,0,0,0,,Күткендей, мен сені жек көре бастадым.
Dialogue: 0,0:22:59.37,0:23:01.08,Default,,0,0,0,,Иә, мен оны тастадым.
Dialogue: 0,0:23:01.67,0:23:03.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:05.30,0:23:08.55,Default,,0,0,0,,Менің ойымша, олар сені әлі жек көрмейді.
Dialogue: 0,0:23:08.63,0:23:11.89,Default,,0,0,0,,Бірақ бәрі осылай жалғаса берсе...
Dialogue: 0,0:23:13.72,0:23:15.51,Default,,0,0,0,,Рахмет айтуым керек.
Dialogue: 0,0:23:16.10,0:23:17.31,Default,,0,0,0,,Үш ойыншы оны құлатып тастады
Dialogue: 0,0:23:18.31,0:23:20.85,Default,,0,0,0,,Мен сізге қазір айтуым керек
Dialogue: 0,0:23:22.31,0:23:23.61,Default,,0,0,0,,Саған айтуым керек
Dialogue: 0,0:23:25.11,0:23:27.15,Default,,0,0,0,,Оны дұрыс жеткізгеніңізге көз жеткізіңіз—
Dialogue: 0,0:23:27.23,0:23:27.90,Default,,0,0,0,,～♪
Dialogue: 0,0:23:27.90,0:23:29.61,Default,,0,0,0,,～♪ Жақын жерде...
Dialogue: 0,0:23:29.61,0:23:30.45,Default,,0,0,0,,～♪
Dialogue: 0,0:23:30.45,0:23:32.32,Default,,0,0,0,,～♪ Жақынырақ
Dialogue: 0,0:23:37.58,0:23:39.96,Default,,0,0,0,,Рахмет сізге Райду-кун
Dialogue: 0,0:23:40.54,0:23:41.67,Default,,0,0,0,,Хори, көмектесіп жібересің бе?
Dialogue: 0,0:23:43.17,0:23:49.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
