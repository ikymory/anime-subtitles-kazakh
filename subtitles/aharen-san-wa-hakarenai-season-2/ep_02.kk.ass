Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.42,Default,,0,0,0,,(TV BGM)
Dialogue: 0,0:00:03.50,0:00:05.04,Default,,0,0,0,,Олай болса, баршаңызға.
Dialogue: 0,0:00:05.13,0:00:08.00,Default,,0,0,0,,Мен сендерге қызық әзілдер беремін.
Dialogue: 0,0:00:08.09,0:00:09.88,Default,,0,0,0,,100 граммнан бастаңыз
Dialogue: 0,0:00:09.96,0:00:10.88,Default,,0,0,0,,Осы уақыт ішінде темір табақ
Dialogue: 0,0:00:10.96,0:00:13.59,Default,,0,0,0,,Уши-кун, Бутак-кун, Тори-кунмен бірге шие гүлін көруге бару...
Dialogue: 0,0:00:13.68,0:00:14.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:18.22,0:00:20.02,Default,,0,0,0,,«Тубу-Тубу но Мори»
Dialogue: 0,0:00:20.72,0:00:22.52,Default,,0,0,0,,Мұндай ойын болды ма?
Dialogue: 0,0:00:22.60,0:00:26.44,Default,,0,0,0,,Бауырым, қызықсаң қолыңнан келеді.
Dialogue: 0,0:00:26.52,0:00:27.90,Default,,0,0,0,,Иә? Бұл жақсы ма?
Dialogue: 0,0:00:27.98,0:00:29.36,Default,,0,0,0,,Неліктен мұны өзіңіз жасамасқа?
Dialogue: 0,0:00:29.44,0:00:30.32,Default,,0,0,0,,Иә
Dialogue: 0,0:00:30.40,0:00:33.95,Default,,0,0,0,,Мен тестке оқуым керек, сондықтан мен оны біраз уақытқа дейін орындай алмаймын.
Dialogue: 0,0:00:34.03,0:00:35.53,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:35.61,0:00:36.91,Default,,0,0,0,,Ал, жасап көрейік.
Dialogue: 0,0:00:38.58,0:00:41.95,Default,,0,0,0,,Тек темір табаққа, дәнекерлеуші!
Dialogue: 0,0:00:42.04,0:00:47.04,Default,,0,0,0,,♪～
Dialogue: 0,0:02:06.70,0:02:10.71,Default,,0,0,0,,～♪
Dialogue: 0,0:02:27.18,0:02:28.52,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:29.02,0:02:31.35,Default,,0,0,0,,Материалдарды жинау және үй салу және т.б.
Dialogue: 0,0:02:31.44,0:02:33.19,Default,,0,0,0,,Бұл қала ойыны ма?
Dialogue: 0,0:02:33.27,0:02:34.57,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:02:34.65,0:02:36.53,Default,,0,0,0,,Кейіпкерлердің макияжы?
Dialogue: 0,0:02:37.61,0:02:39.99,Default,,0,0,0,,Сіз оны әртүрлі шаш үлгілері мен бет-әлпетін жасай аласыз.
Dialogue: 0,0:02:40.07,0:02:43.32,Default,,0,0,0,,Жарайды, оны өзіңе ұқсатып көрейік.
Dialogue: 0,0:02:44.74,0:02:46.29,Default,,0,0,0,,Иә, ұқсас
Dialogue: 0,0:02:47.12,0:02:49.29,Default,,0,0,0,,Мұндай ойында маңызды нәрсе
Dialogue: 0,0:02:50.12,0:02:52.38,Default,,0,0,0,,Ойын әлеміне ену
Dialogue: 0,0:02:53.92,0:02:56.25,Default,,0,0,0,,Жарайды, толық сүңгу аяқталды.
Dialogue: 0,0:02:56.96,0:02:58.46,Default,,0,0,0,,Орманға барайық!
Dialogue: 0,0:03:00.93,0:03:03.09,Default,,0,0,0,,Бұл Тубу-Тубу но Мори...
Dialogue: 0,0:03:03.89,0:03:05.93,Default,,0,0,0,,Сіз осында ұйықтайсыз ба?
Dialogue: 0,0:03:06.43,0:03:07.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:07.35,0:03:09.27,Default,,0,0,0,,Бұл жақсы үй.
Dialogue: 0,0:03:09.77,0:03:12.15,Default,,0,0,0,,Егер мен бір күні осындай үйде тұра алсам...
Dialogue: 0,0:03:12.23,0:03:14.23,Default,,0,0,0,,Бұл менің үйім.
Dialogue: 0,0:03:14.31,0:03:18.15,Default,,0,0,0,,Танысқаныма қуаныштымын, мен осы орманның тұрғынымын.
Dialogue: 0,0:03:18.23,0:03:20.36,Default,,0,0,0,,Мені Цуцутану деп атаңыз.
Dialogue: 0,0:03:20.45,0:03:23.20,Default,,0,0,0,,Мен Райдумын. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:03:23.28,0:03:26.83,Default,,0,0,0,,Үй салу үшін 30 миллион пел қажет.
Dialogue: 0,0:03:26.91,0:03:28.41,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:03:28.49,0:03:31.54,Default,,0,0,0,,Сонымен, мен қалай ақша табамын...
Dialogue: 0,0:03:31.62,0:03:34.75,Default,,0,0,0,,Қаласаңыз, мен сізді жұмыспен таныстырғым келеді.
Dialogue: 0,0:03:34.83,0:03:38.34,Default,,0,0,0,,Ал, ең алдымен ағаш бұтақтарын жинап алыңдар.
Dialogue: 0,0:03:39.55,0:03:42.05,Default,,0,0,0,,Одан әрі жемісті ұсақтау
Dialogue: 0,0:03:43.34,0:03:44.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:44.26,0:03:46.14,Default,,0,0,0,,Уф... Ууууууууу
Dialogue: 0,0:03:46.72,0:03:48.60,Default,,0,0,0,,Енді мен көкөніс алғым келеді.
Dialogue: 0,0:03:50.64,0:03:53.10,Default,,0,0,0,,Уау! Саңырауқұлақтар көп жиналды
Dialogue: 0,0:03:53.19,0:03:54.52,Default,,0,0,0,,Керемет!
Dialogue: 0,0:03:54.60,0:03:56.36,Default,,0,0,0,,-Аа -Рахмет
Dialogue: 0,0:03:56.44,0:03:58.86,Default,,0,0,0,,Өте пайдалы кеңес
Dialogue: 0,0:03:59.82,0:04:03.20,Default,,0,0,0,,Бұл қырыққабат жылтыр және өте жақсы жасалған.
Dialogue: 0,0:04:03.28,0:04:05.57,Default,,0,0,0,,100 пелге бір дана сатып алыңыз
Dialogue: 0,0:04:06.49,0:04:07.74,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:04:07.83,0:04:10.41,Default,,0,0,0,,Мен көбірек шығарғым келеді.
Dialogue: 0,0:04:10.50,0:04:13.21,Default,,0,0,0,,Жақында болған рецессия үшін кешірім сұраймыз.
Dialogue: 0,0:04:13.29,0:04:14.83,Default,,0,0,0,,Экономика деген нәрсе бар.
Dialogue: 0,0:04:18.92,0:04:21.59,Default,,0,0,0,,Әр түрлі орылған котлеттер~
Dialogue: 0,0:04:21.67,0:04:25.05,Default,,0,0,0,,Бұл кесте де 5000 пел тұрады!
Dialogue: 0,0:04:25.55,0:04:28.05,Default,,0,0,0,,Ақша табу қиын емес пе?
Dialogue: 0,0:04:32.85,0:04:35.40,Default,,0,0,0,,Жақсы қырыққабат алаңы болып шықты.
Dialogue: 0,0:04:36.10,0:04:36.94,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:04:37.02,0:04:39.36,Default,,0,0,0,,Келіңіздер, келіңіздер, қараңыздар.
Dialogue: 0,0:04:39.44,0:04:44.74,Default,,0,0,0,,Жаңа өнім: Цутубану өсірген ғажайып пестицидсіз көкөністер!
Dialogue: 0,0:04:45.28,0:04:47.03,Default,,0,0,0,,Сені өсірген мен едім ғой?
Dialogue: 0,0:04:47.12,0:04:48.28,Default,,0,0,0,,Бұл қырыққабат
Dialogue: 0,0:04:48.37,0:04:50.20,Default,,0,0,0,,Оны жесең, сен де көрікті боласың.
Dialogue: 0,0:04:50.29,0:04:51.95,Default,,0,0,0,,Әйелдер арасында танымал!
Dialogue: 0,0:04:52.04,0:04:54.87,Default,,0,0,0,,Бұл бар болғаны 2000 пельс!
Dialogue: 0,0:04:54.96,0:04:57.67,Default,,0,0,0,,Маған біреуін беріңіз! Бұл бірінші келеді!
Dialogue: 0,0:04:58.25,0:05:00.84,Default,,0,0,0,,Бұл тым көп алаяқтық емес пе?
Dialogue: 0,0:05:00.92,0:05:04.17,Default,,0,0,0,,(Цубанудың гуілдеуі)
Dialogue: 0,0:05:04.26,0:05:05.76,Default,,0,0,0,,Цуцутану-сан
Dialogue: 0,0:05:05.84,0:05:07.84,Default,,0,0,0,,Мен қырыққабат әкелдім.
Dialogue: 0,0:05:07.93,0:05:10.97,Default,,0,0,0,,Еңбегіңіз үшін рахмет 100 Pels
Dialogue: 0,0:05:11.93,0:05:14.52,Default,,0,0,0,,Бұрын ол 2000 пелге сатылған.
Dialogue: 0,0:05:18.98,0:05:22.15,Default,,0,0,0,,Райду-сан екеуміздің қарым-қатынасымыз
Dialogue: 0,0:05:22.23,0:05:24.86,Default,,0,0,0,,Әсіресе қызықты...
Dialogue: 0,0:05:26.86,0:05:29.82,Default,,0,0,0,,Ах, мен 30 миллион пел жинадым.
Dialogue: 0,0:05:31.03,0:05:33.29,Default,,0,0,0,,Ақыры арманымдағы үйге қол жеткіздім!
Dialogue: 0,0:05:33.95,0:05:37.00,Default,,0,0,0,,Бұл жетістік сезімі керемет, солай емес пе?
Dialogue: 0,0:05:44.21,0:05:45.88,Default,,0,0,0,,...Осылай болды.
Dialogue: 0,0:05:45.97,0:05:48.47,Default,,0,0,0,,Tweet Қызық, солай емес пе?
Dialogue: 0,0:05:48.55,0:05:50.14,Default,,0,0,0,,Ахарен де осылай істеп жатыр ма?
Dialogue: 0,0:05:50.22,0:05:53.60,Default,,0,0,0,,Иә, келесі жолы маған қонаққа келіңіз.
Dialogue: 0,0:05:53.68,0:05:55.10,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:05:55.18,0:05:57.81,Default,,0,0,0,,Мен мұндағы қаланың дамуы реттеліп болған соң барамын.
Dialogue: 0,0:05:58.94,0:05:59.94,Default,,0,0,0,,Содан бері
Dialogue: 0,0:06:00.73,0:06:03.44,Default,,0,0,0,,Қанағаттанарлық өмір сүру
Dialogue: 0,0:06:04.11,0:06:06.03,Default,,0,0,0,,Мен көп жұмыс жасадым
Dialogue: 0,0:06:07.40,0:06:08.45,Default,,0,0,0,,Және…
Dialogue: 0,0:06:09.45,0:06:11.70,Default,,0,0,0,,Мен бәрін алдым
Dialogue: 0,0:06:12.49,0:06:14.37,Default,,0,0,0,,Қанпай
Dialogue: 0,0:06:14.45,0:06:16.37,Default,,0,0,0,,Жоқ, мен үшін
Dialogue: 0,0:06:16.45,0:06:19.54,Default,,0,0,0,,Осындай сәнді туған күн кешін өткізгеніңіз үшін рахмет.
Dialogue: 0,0:06:19.62,0:06:20.96,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:06:21.04,0:06:24.46,Default,,0,0,0,,Мен саған әрқашан қарыздармын.
Dialogue: 0,0:06:24.55,0:06:26.05,Default,,0,0,0,,Кем дегенде рахмет
Dialogue: 0,0:06:26.13,0:06:28.17,Default,,0,0,0,,Raidou-nii…
Dialogue: 0,0:06:28.93,0:06:29.84,Default,,0,0,0,,Райду мырза
Dialogue: 0,0:06:29.93,0:06:30.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:30.84,0:06:32.80,Default,,0,0,0,,Мен қыз әкелдім
Dialogue: 0,0:06:32.89,0:06:33.72,Default,,0,0,0,,О
Dialogue: 0,0:06:33.81,0:06:35.35,Default,,0,0,0,,Бұл гиппопотам
Dialogue: 0,0:06:35.43,0:06:36.72,Default,,0,0,0,,Бұл Нукко
Dialogue: 0,0:06:36.81,0:06:38.56,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:06:40.73,0:06:41.73,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:42.69,0:06:43.90,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:43.98,0:06:45.57,Default,,0,0,0,,Кешіріңіз~
Dialogue: 0,0:06:45.65,0:06:47.69,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:06:47.78,0:06:50.15,Default,,0,0,0,,Цу… Цуцу Цуцута Нутцубу!
Dialogue: 0,0:06:50.24,0:06:52.28,Default,,0,0,0,,Мені Цубу-тан деп атағаныңызды қалаймын!
Dialogue: 0,0:06:52.37,0:06:55.45,Default,,0,0,0,,Цубутан-сан, бүгін сенің туған күнің ғой, солай емес пе?
Dialogue: 0,0:06:55.54,0:06:57.29,Default,,0,0,0,,Жасың нешеде?
Dialogue: 0,0:06:57.37,0:06:58.70,Default,,0,0,0,,Еееееееееееееееееееееееееееееееееееееееек...
Dialogue: 0,0:06:58.79,0:07:00.83,Default,,0,0,0,,Керемет… 25 жаста!
Dialogue: 0,0:07:00.92,0:07:04.46,Default,,0,0,0,,Иә, мен де! Қандай кездейсоқтық!
Dialogue: 0,0:07:04.54,0:07:08.26,Default,,0,0,0,,Сонымен, солай... Солай ма? Қандай кездейсоқтық!
Dialogue: 0,0:07:08.34,0:07:11.34,Default,,0,0,0,,Ал, мына тортпен тойлайық...
Dialogue: 0,0:07:11.43,0:07:12.84,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:07:12.93,0:07:13.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:15.35,0:07:17.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:17.27,0:07:18.22,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:07:18.31,0:07:20.14,Default,,0,0,0,,Дәмді тістеу!
Dialogue: 0,0:07:20.23,0:07:22.23,Default,,0,0,0,,Нукко-чан маған жеуге рұқсат берген торт
Dialogue: 0,0:07:22.31,0:07:23.73,Default,,0,0,0,,Ерекше ғажайып!
Dialogue: 0,0:07:23.81,0:07:25.36,Default,,0,0,0,,Ах хехе
Dialogue: 0,0:07:25.44,0:07:27.94,Default,,0,0,0,,Менде крем бар.
Dialogue: 0,0:07:28.03,0:07:30.03,Default,,0,0,0,,Ахмм
Dialogue: 0,0:07:30.11,0:07:31.99,Default,,0,0,0,,Шықыр!
Dialogue: 0,0:07:32.16,0:07:34.99,Default,,0,0,0,,-Уфуфуфу... -Тоқта, Нукко!
Dialogue: 0,0:07:35.07,0:07:37.95,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:07:38.04,0:07:41.41,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:07:44.46,0:07:46.71,Default,,0,0,0,,(Баланың тынысы)
Dialogue: 0,0:07:48.50,0:07:50.63,Default,,0,0,0,,Хехе...
Dialogue: 0,0:07:51.38,0:07:54.76,Default,,0,0,0,,Ки... Сізді бақытты ететін нәрселер!
Dialogue: 0,0:07:57.60,0:08:00.22,Default,,0,0,0,,Біз осы уақытқа дейін жеттік.
Dialogue: 0,0:08:00.31,0:08:03.56,Default,,0,0,0,,Райдоудың ағасының соңынан ергеніме қуаныштымын!
Dialogue: 0,0:08:04.15,0:08:05.77,Default,,0,0,0,,Рахмет сізге Цутубану
Dialogue: 0,0:08:05.86,0:08:07.27,Default,,0,0,0,,Бұл Цубу!
Dialogue: 0,0:08:07.36,0:08:10.74,Default,,0,0,0,,Мен дәл қазір ең бақытты болуым мүмкін.
Dialogue: 0,0:08:10.82,0:08:13.57,Default,,0,0,0,,А... бұл асыра сілтеу.
Dialogue: 0,0:08:14.61,0:08:15.99,Default,,0,0,0,,Ах! Үлкен аға!
Dialogue: 0,0:08:16.53,0:08:17.87,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:18.74,0:08:20.37,Default,,0,0,0,,- Қарғыс атсын! -Цутану!
Dialogue: 0,0:08:21.08,0:08:22.33,Default,,0,0,0,,Мықты болыңыз!
Dialogue: 0,0:08:23.41,0:08:26.71,Default,,0,0,0,,Оны іске кіріссе, барын салып кіріседі деуге болады, немесе бәлкім абайсыз.
Dialogue: 0,0:08:26.79,0:08:29.80,Default,,0,0,0,,Соңында, Нуко...
Dialogue: 0,0:08:31.84,0:08:33.26,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:33.34,0:08:36.97,Default,,0,0,0,,Цубутану!
Dialogue: 0,0:08:41.31,0:08:42.39,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:08:43.43,0:08:45.31,Default,,0,0,0,,Мен не үшінмін?
Dialogue: 0,0:08:46.73,0:08:49.40,Default,,0,0,0,,Менің ойымша, сіз осы уақытқа дейін көп жұмыс жасадыңыз.
Dialogue: 0,0:08:52.03,0:08:55.78,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:08:55.86,0:08:59.16,Default,,0,0,0,,Бір күні мен де сол жерге барармын
Dialogue: 0,0:08:59.24,0:09:01.49,Default,,0,0,0,,Оған дейін сәл қоштасамыз.
Dialogue: 0,0:09:01.58,0:09:03.91,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:09:11.25,0:09:12.34,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:12.42,0:09:15.13,Default,,0,0,0,,Енді Ахарен қаласына барайық.
Dialogue: 0,0:09:21.89,0:09:23.77,Default,,0,0,0,,(Камо) Һм. (Фушигиро) Ұф.
Dialogue: 0,0:09:24.48,0:09:26.98,Default,,0,0,0,,Бұл менімен бірдей ойын екеніне сене алар емеспін.
Dialogue: 0,0:09:27.56,0:09:30.23,Default,,0,0,0,,Мен өзімшіл қалауымды қанағаттандыру үшін жүгірген кіммін?
Dialogue: 0,0:09:30.31,0:09:32.53,Default,,0,0,0,,Дамудың басқа деңгейіне жету
Dialogue: 0,0:09:34.32,0:09:36.03,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:09:36.53,0:09:39.49,Default,,0,0,0,,Шынайы дүние сондай адал...
Dialogue: 0,0:09:39.57,0:09:43.33,Default,,0,0,0,,Жоқ, оның жаңарту арқылы шығарылғанына сене алмаймын.
Dialogue: 0,0:09:44.62,0:09:46.83,Default,,0,0,0,,Бұл керемет кемелдік
Dialogue: 0,0:09:46.91,0:09:49.50,Default,,0,0,0,,Және бұл шамадан тыс ақпарат көлемі
Dialogue: 0,0:09:50.08,0:09:53.92,Default,,0,0,0,,Мүмкін Ахарен мырза, сіздің соңғы мақсатыңыз...
Dialogue: 0,0:09:55.13,0:09:57.43,Default,,0,0,0,,Бүкіл Жердің көшірмесі
Dialogue: 0,0:09:58.05,0:10:00.97,Default,,0,0,0,,Ахарен мырза шындықтан бас тартты.
Dialogue: 0,0:10:01.05,0:10:03.93,Default,,0,0,0,,Мен виртуалды кеңістікте өмір сүруге тырысамын.
Dialogue: 0,0:10:05.22,0:10:08.48,Default,,0,0,0,,Мен қатысу маңызды екенін айттым.
Dialogue: 0,0:10:08.98,0:10:12.36,Default,,0,0,0,,Бұл толықтық дәрежесі, бұл ақпарат көлемі...
Dialogue: 0,0:10:12.44,0:10:14.82,Default,,0,0,0,,Әлемдік №...
Dialogue: 0,0:10:14.90,0:10:19.53,Default,,0,0,0,,Бұл бүкіл ғалам үшін қиындықтар тудыруы мүмкін.
Dialogue: 0,0:10:19.61,0:10:23.37,Default,,0,0,0,,Яғни виртуалды кеңістік пен шынайы әлем
Dialogue: 0,0:10:23.45,0:10:25.83,Default,,0,0,0,,Ауыстыру керек!
Dialogue: 0,0:10:25.91,0:10:29.87,Default,,0,0,0,,Виртуалды кеңістіктегі ақпарат көлемі шындықтан асып кеткенде
Dialogue: 0,0:10:29.96,0:10:34.17,Default,,0,0,0,,Виртуалды кеңістік шынайырақ болады деген теория бар.
Dialogue: 0,0:10:34.25,0:10:38.30,Default,,0,0,0,,Қазіргі технологиямен бұл мүмкіндік аз деп айтылғанымен.
Dialogue: 0,0:10:38.38,0:10:41.72,Default,,0,0,0,,Бір мүмкіндік бар дейді.
Dialogue: 0,0:10:42.51,0:10:44.18,Default,,0,0,0,,Кванттық компьютер
Dialogue: 0,0:10:44.89,0:10:47.22,Default,,0,0,0,,Егер кванттық компьютердің өнімділігі болса
Dialogue: 0,0:10:47.31,0:10:52.40,Default,,0,0,0,,Шындықтағы ақпарат көлемінен асатын виртуалды әлемді құруға болады.
Dialogue: 0,0:10:52.48,0:10:56.44,Default,,0,0,0,,Шындықпен салыстырылатын ақпарат көлемі бар виртуалды кеңістік
Dialogue: 0,0:10:56.94,0:11:00.36,Default,,0,0,0,,Әлемді ауыстыру қаупі бар.
Dialogue: 0,0:11:00.95,0:11:03.91,Default,,0,0,0,,Сондықтан Ахарен мырза, ары қарай жүре алмаймыз.
Dialogue: 0,0:11:03.99,0:11:09.16,Default,,0,0,0,,Шынайы әлемді виртуалды кеңістік жұтып қойды және сіз шындыққа орала алмайсыз.
Dialogue: 0,0:11:16.63,0:11:19.26,Default,,0,0,0,,Ахарен мырза, күткендей.
Dialogue: 0,0:11:19.84,0:11:24.51,Default,,0,0,0,,Бүкіл тұлғаңызды сол әлемге көшіріп, бейорганикалық тіршілік формасына айналыңыз...
Dialogue: 0,0:11:25.89,0:11:27.72,Default,,0,0,0,,Көңілге түскеннен пайда жоқ.
Dialogue: 0,0:11:28.56,0:11:29.56,Default,,0,0,0,,(сөмкенің құлаған дыбысы)
Dialogue: 0,0:11:28.56,0:11:29.56,Default,,0,0,0,,Бұл Ахарен мырзаның таңдаған жолы, соны қабылдайық.
Dialogue: 0,0:11:29.56,0:11:31.81,Default,,0,0,0,,Бұл Ахарен мырзаның таңдаған жолы, соны қабылдайық.
Dialogue: 0,0:11:32.85,0:11:33.94,Default,,0,0,0,,Каранэс ауданына оралу.
Dialogue: 0,0:11:34.02,0:11:36.52,Default,,0,0,0,,Мен де қазір сол дүниеге барамын.
Dialogue: 0,0:11:39.65,0:11:41.20,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:11:41.28,0:11:42.78,Default,,0,0,0,,Ах... қайырлы таң
Dialogue: 0,0:11:42.86,0:11:44.91,Default,,0,0,0,,Мен біраз ұйықтап қалдым.
Dialogue: 0,0:11:44.99,0:11:45.99,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:46.49,0:11:50.45,Default,,0,0,0,,Ойын қалашығында таңғажайып нәрсе болып жатыр.
Dialogue: 0,0:11:50.54,0:11:54.67,Default,,0,0,0,,Сол ойын Кірпіш оған қатты тәуелді болды.
Dialogue: 0,0:11:54.75,0:11:56.75,Default,,0,0,0,,Өйткені оны отбасы ортақ
Dialogue: 0,0:11:56.84,0:11:59.42,Default,,0,0,0,,Ах, Ренкун жасады.
Dialogue: 0,0:12:00.30,0:12:03.51,Default,,0,0,0,,Ренкун қазір бар ма?
Dialogue: 0,0:12:04.89,0:12:05.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:05.89,0:12:07.76,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:12:10.18,0:12:12.44,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:12.52,0:12:13.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:13.44,0:12:14.85,Default,,0,0,0,,Қайырлы таң анашым
Dialogue: 0,0:12:14.94,0:12:16.44,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:12:17.02,0:12:18.48,Default,,0,0,0,,Мен шөлдеп тұрмын.
Dialogue: 0,0:12:19.61,0:12:20.86,Default,,0,0,0,,Сүт?
Dialogue: 0,0:12:23.90,0:12:26.24,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:12:28.12,0:12:29.91,Default,,0,0,0,,Сүт емес
Dialogue: 0,0:12:29.99,0:12:30.91,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:31.00,0:12:34.08,Default,,0,0,0,,Мен ішейін деп жатқан амазакені іштің бе?
Dialogue: 0,0:12:35.08,0:12:36.92,Default,,0,0,0,,Сонымен... алкоголь?
Dialogue: 0,0:12:37.00,0:12:39.21,Default,,0,0,0,,Жапонияда алкоголь салығы туралы заңға сәйкес
Dialogue: 0,0:12:39.30,0:12:44.34,Default,,0,0,0,,Құрамында 1% немесе одан көп алкоголь бар сусындар алкогольдік сусындарға жатады.
Dialogue: 0,0:12:44.43,0:12:48.39,Default,,0,0,0,,Ішке түскен спирт асқазан және аш ішек арқылы ағзаға сіңеді.
Dialogue: 0,0:12:48.47,0:12:50.76,Default,,0,0,0,,Ақырында ол қанға ериді.
Dialogue: 0,0:12:50.85,0:12:52.14,Default,,0,0,0,,Бұл шарт...
Dialogue: 0,0:12:52.22,0:12:53.52,Default,,0,0,0,,Интоксикация
Dialogue: 0,0:12:54.02,0:12:55.31,Default,,0,0,0,,Қандағы алкоголь концентрациясы
Dialogue: 0,0:12:55.39,0:12:58.19,Default,,0,0,0,,Децилитр үшін 50 миллиграмнан астам
Dialogue: 0,0:12:58.27,0:13:01.28,Default,,0,0,0,,Үлкенірек немесе таныс сезіну, т.б.
Dialogue: 0,0:13:01.36,0:13:05.24,Default,,0,0,0,,Ішімдіктерді тұтынатын адамдардың көзқарасы өзгереді дейді.
Dialogue: 0,0:13:05.82,0:13:10.95,Default,,0,0,0,,Қазір ойлап қарасам, мен де жүрегімнен тайып бара жатқандай сезінемін.
Dialogue: 0,0:13:11.04,0:13:12.91,Default,,0,0,0,,Мен... мен барамын
Dialogue: 0,0:13:13.00,0:13:15.41,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:19.42,0:13:20.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:22.21,0:13:23.71,Default,,0,0,0,,Қайырлы таң, Райду-кун...
Dialogue: 0,0:13:23.80,0:13:25.05,Default,,0,0,0,,Йо Рейна
Dialogue: 0,0:13:25.13,0:13:26.93,Default,,0,0,0,,Әлі ерте емес пе?
Dialogue: 0,0:13:27.01,0:13:28.84,Default,,0,0,0,,Жүр, мен сенімен барамын.
Dialogue: 0,0:13:29.64,0:13:31.39,Default,,0,0,0,,Мен оны қалдырамын.
Dialogue: 0,0:13:33.10,0:13:35.56,Default,,0,0,0,,Ра... Райду-кун?
Dialogue: 0,0:13:35.64,0:13:37.85,Default,,0,0,0,,О? Сіз не айттыңыз?
Dialogue: 0,0:13:37.94,0:13:41.44,Default,,0,0,0,,Қараңыз, бұл Райду.
Dialogue: 0,0:13:41.52,0:13:43.11,Default,,0,0,0,,Бұл Райду.
Dialogue: 0,0:13:43.19,0:13:45.49,Default,,0,0,0,,Хмм... иә иә
Dialogue: 0,0:13:45.57,0:13:47.03,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:13:49.11,0:13:51.41,Default,,0,0,0,,Не? Рейна, сәлем...
Dialogue: 0,0:13:51.49,0:13:54.04,Default,,0,0,0,,Сіз жүргенде сөмкеңіз ауыр болып көрінеді.
Dialogue: 0,0:13:54.12,0:13:55.62,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:13:56.41,0:13:57.87,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:13:57.96,0:14:00.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:02.04,0:14:05.26,Default,,0,0,0,,Әй, ашуланба, әйтпесе құлайсың.
Dialogue: 0,0:14:06.88,0:14:08.88,Default,,0,0,0,,Енді сабақты бастайық.
Dialogue: 0,0:14:08.97,0:14:11.55,Default,,0,0,0,,Енді оқулығыңызды 42-бетті ашыңыз.
Dialogue: 0,0:14:11.64,0:14:14.97,Default,,0,0,0,,Не, Рейна, оқулығыңды ұмытып кеткен шығарсың.
Dialogue: 0,0:14:15.06,0:14:16.60,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:14:17.64,0:14:19.65,Default,,0,0,0,,Мен саған көрсетемін
Dialogue: 0,0:14:19.73,0:14:21.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:21.36,0:14:24.19,Default,,0,0,0,,Қараңдар, жақынырақ келулерің керек.
Dialogue: 0,0:14:24.28,0:14:26.86,Default,,0,0,0,,Сіз оны сонша жерден оқи алмайсыз, солай ма?
Dialogue: 0,0:14:26.94,0:14:30.36,Default,,0,0,0,,Райду-санды әдетте Ахарен-сан итеріп жібереді.
Dialogue: 0,0:14:30.45,0:14:34.33,Default,,0,0,0,,Бүгін салқын болды, ал Ахарен бос емес еді...
Dialogue: 0,0:14:34.41,0:14:37.12,Default,,0,0,0,,Бұзық бала, сәлем!
Dialogue: 0,0:14:37.87,0:14:39.04,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:14:41.08,0:14:43.46,Default,,0,0,0,,Келесі - жылжымалы сынып.
Dialogue: 0,0:14:44.17,0:14:45.55,Default,,0,0,0,,Ах, ахача...
Dialogue: 0,0:14:45.63,0:14:49.51,Default,,0,0,0,,Yo Reina мобильді сыныптары Бірге барайық
Dialogue: 0,0:14:52.05,0:14:54.43,Default,,0,0,0,,Тым қорқынышты~ Мүмкін емес Мүмкін емес
Dialogue: 0,0:15:01.10,0:15:02.56,Default,,0,0,0,,Бүгінгі Райду-кун
Dialogue: 0,0:15:02.65,0:15:06.11,Default,,0,0,0,,Әйтеуір, қысым әдеттегіден күштірек, қорқынышты.
Dialogue: 0,0:15:06.19,0:15:08.32,Default,,0,0,0,,Рейна-чан, жақсысың ба?
Dialogue: 0,0:15:08.40,0:15:09.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:09.61,0:15:12.99,Default,,0,0,0,,Эй, Оширо, сен...
Dialogue: 0,0:15:13.82,0:15:16.70,Default,,0,0,0,,Мен... таптым.
Dialogue: 0,0:15:18.79,0:15:21.79,Default,,0,0,0,,Шашыңызда Kinpira лопуха жоқ па?
Dialogue: 0,0:15:24.04,0:15:27.38,Default,,0,0,0,,Сен Рейнаның досысың, сондықтан абай бол.
Dialogue: 0,0:15:27.46,0:15:30.01,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:15:30.80,0:15:33.01,Default,,0,0,0,,Әй, мен саған дәптерімді берем.
Dialogue: 0,0:15:33.22,0:15:34.93,Default,,0,0,0,,Әй, аузыңды аш.
Dialogue: 0,0:15:35.14,0:15:37.85,Default,,0,0,0,,Суық, солай емес пе? Мұны да киюге болады
Dialogue: 0,0:15:38.52,0:15:39.68,Default,,0,0,0,,Бұл оңай-ақ болар, иә? Хех, хе-хех, хе
Dialogue: 0,0:15:39.89,0:15:43.10,Default,,0,0,0,,Мен мұғаліміме мұндай ауыр нәрсені көтеруге рұқсат ете алмаймын.
Dialogue: 0,0:15:43.81,0:15:45.94,Default,,0,0,0,,Балалар, бұл не керек?
Dialogue: 0,0:15:46.02,0:15:48.44,Default,,0,0,0,,Ал... алдын ала айтқаныңызға рахмет.
Dialogue: 0,0:15:48.53,0:15:50.78,Default,,0,0,0,,Мен де құтқарылдым.
Dialogue: 0,0:15:50.86,0:15:52.40,Default,,0,0,0,,Маған алғыс айтудың қажеті жоқ.
Dialogue: 0,0:15:52.49,0:15:56.03,Default,,0,0,0,,Бүгін менің жігітімде бірдеңе болды.
Dialogue: 0,0:15:56.12,0:15:58.49,Default,,0,0,0,,Қорқынышты ~ Тым жақындамаңыз
Dialogue: 0,0:15:59.20,0:16:02.79,Default,,0,0,0,,Бүгін мектептегі түскі асқа берілген пудинг өте дәмді болды.
Dialogue: 0,0:16:02.87,0:16:04.50,Default,,0,0,0,,Алғашқыда сүйкімді көрінгенімен,
Dialogue: 0,0:16:04.58,0:16:06.34,Default,,0,0,0,,-  -（･）
Dialogue: 0,0:16:06.42,0:16:08.05,Default,,0,0,0,,Бұл кездейсоқтық емес пе?
Dialogue: 0,0:16:08.13,0:16:10.01,Default,,0,0,0,,Райду Ниини!
Dialogue: 0,0:16:10.09,0:16:10.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:11.05,0:16:14.97,Default,,0,0,0,,Бүгінгі Райду-санның атмосферасы әдеттегіден өзгеше.
Dialogue: 0,0:16:15.05,0:16:17.68,Default,,0,0,0,,Қол жетпейтін ауаны шығарады
Dialogue: 0,0:16:17.76,0:16:20.52,Default,,0,0,0,,-Ни-ни ойынын ойнайық! - О, Рен!
Dialogue: 0,0:16:21.56,0:16:24.90,Default,,0,0,0,,Хахаха Иә, не ойнауымыз керек?
Dialogue: 0,0:16:24.98,0:16:26.94,Default,,0,0,0,,Мен тегті ойнағым келеді!
Dialogue: 0,0:16:27.02,0:16:29.27,Default,,0,0,0,,А, ендеше тегті ойнайық.
Dialogue: 0,0:16:29.36,0:16:30.65,Default,,0,0,0,,Иә, жасайық!
Dialogue: 0,0:16:30.73,0:16:32.53,Default,,0,0,0,,-Эй Еру -Иә!
Dialogue: 0,0:16:33.11,0:16:36.62,Default,,0,0,0,,Мені үнемі бақылап жүргеніңіз үшін рахмет, Рейна.
Dialogue: 0,0:16:36.70,0:16:40.83,Default,,0,0,0,,Уф! Бол... бірдеңе деуге себеп жоқ.
Dialogue: 0,0:16:40.91,0:16:42.29,Default,,0,0,0,,Рен Мен үйге бара жатырмын!
Dialogue: 0,0:16:42.37,0:16:43.54,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:45.00,0:16:47.00,Default,,0,0,0,,-Айтпақшы, Рейна -Хм?
Dialogue: 0,0:16:48.38,0:16:51.71,Default,,0,0,0,,Бүгін бетіңіз қызарып кетті ғой, солай емес пе?
Dialogue: 0,0:16:51.80,0:16:53.92,Default,,0,0,0,,Бұл жай ғана қызба емес пе?
Dialogue: 0,0:16:56.47,0:16:58.43,Default,,0,0,0,,Қызуыңыз көтерілмей ме?
Dialogue: 0,0:16:58.51,0:16:59.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:00.14,0:17:01.10,Default,,0,0,0,,Ой...
Dialogue: 0,0:17:01.18,0:17:03.31,Default,,0,0,0,,Әй, мұрныңнан қан кетіп жатыр емес пе?
Dialogue: 0,0:17:04.44,0:17:07.52,Default,,0,0,0,,Амансың ба? Онымен сүртіңіз.
Dialogue: 0,0:17:07.60,0:17:11.53,Default,,0,0,0,,Қараңызшы, мұрынның артқы жағындағы көптеген қан тамырлары жиналған кезде мұрыннан қан кетеді.
Dialogue: 0,0:17:11.61,0:17:14.99,Default,,0,0,0,,Бұл Кизельбах аймағы жарақат алған кезде жиі болады.
Dialogue: 0,0:17:15.61,0:17:16.91,Default,,0,0,0,,Отыру және төмен қарау
Dialogue: 0,0:17:16.99,0:17:20.08,Default,,0,0,0,,Қанды тоқтату үшін мұрынды біраз уақыт ұстау керек деп ойлаймын.
Dialogue: 0,0:17:20.66,0:17:23.04,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:17:23.12,0:17:25.66,Default,,0,0,0,,Үй Мен үйге баратын жерім
Dialogue: 0,0:17:26.58,0:17:29.17,Default,,0,0,0,,О... Иә.
Dialogue: 0,0:17:30.29,0:17:31.09,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:31.09,0:17:32.05,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:31.09,0:17:32.05,Default,,0,0,0,,(Әпкенің күбірлеуі)
Dialogue: 0,0:17:32.05,0:17:32.13,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:32.13,0:17:33.67,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:32.13,0:17:33.67,Default,,0,0,0,,Мен қазір оралдым
Dialogue: 0,0:17:34.55,0:17:36.88,Default,,0,0,0,,А, қош келдің, аға... А?
Dialogue: 0,0:17:37.80,0:17:40.60,Default,,0,0,0,,Атмосфераға қатысты бір нәрсе әдеттегіден өзгеше...
Dialogue: 0,0:17:40.68,0:17:44.10,Default,,0,0,0,,-Бұл не? -(Әпке) Әй... Иә, ештеңе.
Dialogue: 0,0:17:46.56,0:17:48.48,Default,,0,0,0,,Менің бір нәрсеге қарным ашылды.
Dialogue: 0,0:17:48.56,0:17:49.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:51.06,0:17:52.94,Default,,0,0,0,,О, күте тұрыңыз, бұл менікі!
Dialogue: 0,0:17:53.03,0:17:54.19,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:54.28,0:17:56.11,Default,,0,0,0,,Эй, мынаны жегің келе ме?
Dialogue: 0,0:17:56.20,0:17:58.07,Default,,0,0,0,,Эй... Эй, солай істе!
Dialogue: 0,0:17:58.16,0:17:59.16,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:17:59.24,0:18:02.03,Default,,0,0,0,,Е... Маған керек емес қой!
Dialogue: 0,0:18:02.87,0:18:05.50,Default,,0,0,0,,Мен... шөлдеп тұрмын.
Dialogue: 0,0:18:06.12,0:18:07.96,Default,,0,0,0,,Иә? Тек таңқаларлық
Dialogue: 0,0:18:08.04,0:18:09.67,Default,,0,0,0,,Тыңдаңыз, міне осы.
Dialogue: 0,0:18:14.55,0:18:15.63,Default,,0,0,0,,Эй, бұл алкоголь...
Dialogue: 0,0:18:15.71,0:18:19.30,Default,,0,0,0,,Не? Бұл керемет және құрамында алкоголь жоқ.
Dialogue: 0,0:18:21.80,0:18:24.18,Default,,0,0,0,,О, құрамында спирт жоқ.
Dialogue: 0,0:18:24.26,0:18:25.97,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:18:26.06,0:18:27.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:29.73,0:18:31.44,Default,,0,0,0,,Райду-чан өтінемін
Dialogue: 0,0:18:31.52,0:18:33.23,Default,,0,0,0,,Тазалық міндетін қабыл алыңыз!
Dialogue: 0,0:18:33.32,0:18:34.98,Default,,0,0,0,,Иә~ тағы да?
Dialogue: 0,0:18:35.07,0:18:37.24,Default,,0,0,0,,Мен саған келесі жолы балмұздақ сатып аламын!
Dialogue: 0,0:18:37.32,0:18:38.78,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:18:38.86,0:18:40.32,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:18:42.37,0:18:43.62,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:18:43.70,0:18:45.58,Default,,0,0,0,,Бұл Хакентац.
Dialogue: 0,0:18:45.66,0:18:46.50,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:48.00,0:18:48.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:48.91,0:18:52.04,Default,,0,0,0,,Бүгінгі тазалық жұмыстарына рахмет.
Dialogue: 0,0:18:52.13,0:18:54.17,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:18:54.75,0:18:57.26,Default,,0,0,0,,Хмм... бұл не? бұл адам
Dialogue: 0,0:18:57.34,0:18:59.68,Default,,0,0,0,,Мен оны бір жерден көрдім...
Dialogue: 0,0:19:01.26,0:19:05.68,Default,,0,0,0,,Ах! Бұл кісі менің ағаммен бірге болған адамға ұқсайды.
Dialogue: 0,0:19:05.76,0:19:06.72,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:19:06.81,0:19:08.52,Default,,0,0,0,,Doppelgänger
Dialogue: 0,0:19:08.60,0:19:10.06,Default,,0,0,0,,Мен сені кездестірсем, мен өлемін.
Dialogue: 0,0:19:10.73,0:19:12.69,Default,,0,0,0,,...Бұл рас емес пе?
Dialogue: 0,0:19:12.77,0:19:14.02,Default,,0,0,0,,Идиот
Dialogue: 0,0:19:16.07,0:19:19.53,Default,,0,0,0,,Эй Райдо-сан, біткен соң, мұнда да кел!
Dialogue: 0,0:19:19.61,0:19:20.57,Default,,0,0,0,,Иә
Dialogue: 0,0:19:21.49,0:19:22.95,Default,,0,0,0,,-Сіз - (апа) Әй!
Dialogue: 0,0:19:23.03,0:19:26.29,Default,,0,0,0,,Сіздің атыңыз Райдо-сан, солай ма?
Dialogue: 0,0:19:26.37,0:19:28.66,Default,,0,0,0,,Не... не? Кенет менің қолым...
Dialogue: 0,0:19:28.75,0:19:30.79,Default,,0,0,0,,Мен мұндай күшті күтпедім...
Dialogue: 0,0:19:30.87,0:19:33.46,Default,,0,0,0,,Көп деңгейлі маркетингтік сұраныстың мақсаты
Dialogue: 0,0:19:33.54,0:19:35.67,Default,,0,0,0,,Және менің қолымнан ұстау арқылы
Dialogue: 0,0:19:35.75,0:19:38.05,Default,,0,0,0,,Жеке ақпарат қазірдің өзінде бар
Dialogue: 0,0:19:38.13,0:19:40.26,Default,,0,0,0,,Өзіңнен қашып құтыла алмайтының
Dialogue: 0,0:19:40.34,0:19:42.72,Default,,0,0,0,,білдіруге тырысады
Dialogue: 0,0:19:42.80,0:19:45.60,Default,,0,0,0,,Менде ақша жоқ.
Dialogue: 0,0:19:45.68,0:19:47.76,Default,,0,0,0,,Мүмкін сіз
Dialogue: 0,0:19:47.85,0:19:50.56,Default,,0,0,0,,Сіздің орта мектептің екінші курс оқушысы ағаңыз бар ма?
Dialogue: 0,0:19:50.64,0:19:52.69,Default,,0,0,0,,Ал... мен бармын.
Dialogue: 0,0:19:52.77,0:19:54.23,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:54.90,0:19:58.15,Default,,0,0,0,,Менің әпкем Рейна сол ағаға қарыздар.
Dialogue: 0,0:19:58.65,0:20:00.86,Default,,0,0,0,,Менің атым Ава Ренеру.
Dialogue: 0,0:20:00.94,0:20:03.36,Default,,0,0,0,,Ах~ Бұл менің әпкем болатын.
Dialogue: 0,0:20:03.45,0:20:05.78,Default,,0,0,0,,Сол ағамен бірге болған сүйкімді адам.
Dialogue: 0,0:20:05.87,0:20:07.33,Default,,0,0,0,,-Сүйкімді? -(Әпке) А?
Dialogue: 0,0:20:07.41,0:20:11.00,Default,,0,0,0,,Мен жаңа ғана Рейна сүйкімді дедім бе?
Dialogue: 0,0:20:11.08,0:20:12.83,Default,,0,0,0,,Хей, кешіріңіз!
Dialogue: 0,0:20:12.92,0:20:14.04,Default,,0,0,0,,Рейна...
Dialogue: 0,0:20:14.63,0:20:18.00,Default,,0,0,0,,Өте сүйкімді! Түсіне аласыз ба?
Dialogue: 0,0:20:18.09,0:20:20.30,Default,,0,0,0,,Мен оны дұрыс қараған жоқпын...
Dialogue: 0,0:20:20.38,0:20:23.18,Default,,0,0,0,,Рейна бауырларына өте жақын.
Dialogue: 0,0:20:23.26,0:20:26.43,Default,,0,0,0,,Ол өте сабырлы және ол өте жақсы аспаз.
Dialogue: 0,0:20:26.51,0:20:28.31,Default,,0,0,0,,Әр ісінде аянбай еңбек етеді.
Dialogue: 0,0:20:28.39,0:20:30.14,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:20:30.77,0:20:32.14,Default,,0,0,0,,Мен толқып кеттім.
Dialogue: 0,0:20:32.23,0:20:34.52,Default,,0,0,0,,А, жоқ, бәрі жақсы.
Dialogue: 0,0:20:34.60,0:20:36.44,Default,,0,0,0,,Сізге әпкеңіз ұнайды, солай ма?
Dialogue: 0,0:20:36.52,0:20:39.11,Default,,0,0,0,,Ал... онша емес.
Dialogue: 0,0:20:39.69,0:20:43.15,Default,,0,0,0,,Бірақ ағаң да тамаша адам емес пе?
Dialogue: 0,0:20:43.24,0:20:44.86,Default,,0,0,0,,Иә, қайда?
Dialogue: 0,0:20:44.95,0:20:46.87,Default,,0,0,0,,Иә? Бұл дұрыс емес пе?
Dialogue: 0,0:20:46.95,0:20:49.12,Default,,0,0,0,,Менің ағам...
Dialogue: 0,0:20:49.20,0:20:51.95,Default,,0,0,0,,Мен сенің не ойлайтыныңды білмеймін, сондықтан мен біртүрлі заттарды сатып аламын.
Dialogue: 0,0:20:52.04,0:20:56.08,Default,,0,0,0,,Мен пудингті рұқсатсыз жеймін, кейде түсінбейтін нәрселерді жасаймын.
Dialogue: 0,0:20:56.71,0:20:58.04,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:58.13,0:21:02.42,Default,,0,0,0,,Мен кейде шынымен зейінді боласың ба деп ойлаймын.
Dialogue: 0,0:21:02.51,0:21:04.97,Default,,0,0,0,,Шынымен, кейде, кейде.
Dialogue: 0,0:21:05.05,0:21:06.80,Default,,0,0,0,,Хехе... Солай ма?
Dialogue: 0,0:21:06.89,0:21:09.81,Default,,0,0,0,,Бірақ сен менің ағам туралы қайдан білесің?
Dialogue: 0,0:21:09.89,0:21:12.81,Default,,0,0,0,,Иә, мен Рейнаны үнемі тыңдаймын.
Dialogue: 0,0:21:12.89,0:21:15.14,Default,,0,0,0,,Мен де сол адамның өзімен сөйлестім.
Dialogue: 0,0:21:15.23,0:21:16.14,Default,,0,0,0,,Я~
Dialogue: 0,0:21:16.23,0:21:19.82,Default,,0,0,0,,Мен сенің осындай жақсы ағаң бар екеніне қызғанамын.
Dialogue: 0,0:21:19.90,0:21:21.90,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:21:21.98,0:21:27.07,Default,,0,0,0,,Одан да әлгі екеуі бір-бірі туралы не ойлайды екен деп ойлаймын.
Dialogue: 0,0:21:27.61,0:21:28.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:28.53,0:21:31.87,Default,,0,0,0,,Бұл туралы тікелей ағаңнан сұрау керек емес пе?
Dialogue: 0,0:21:31.95,0:21:35.58,Default,,0,0,0,,Иә~ Біз көп сөйлеспейміз.
Dialogue: 0,0:21:35.66,0:21:37.67,Default,,0,0,0,,Біз жақсы қарым-қатынаста емеспіз, бірақ
Dialogue: 0,0:21:37.75,0:21:41.13,Default,,0,0,0,,Бұл туралы сөйлескеніміз дұрыс емес пе?
Dialogue: 0,0:21:41.21,0:21:42.63,Default,,0,0,0,,Олар ағайынды.
Dialogue: 0,0:21:43.84,0:21:46.09,Default,,0,0,0,,Хм... сіз қалай ойлайсыз?
Dialogue: 0,0:21:46.68,0:21:47.97,Default,,0,0,0,,Бірақ мен түсінемін.
Dialogue: 0,0:21:48.05,0:21:50.55,Default,,0,0,0,,Бүгін үйге келгенде сенімен сөйлесуге тырысамын.
Dialogue: 0,0:21:52.64,0:21:53.47,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:53.47,0:21:54.35,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:53.47,0:21:54.35,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:21:54.43,0:21:56.35,Default,,0,0,0,,Хмм, қош келдіңіз
Dialogue: 0,0:21:56.44,0:21:57.52,Default,,0,0,0,,Сәлем бауырым
Dialogue: 0,0:21:57.60,0:21:58.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:58.52,0:22:00.77,Default,,0,0,0,,Ахарен мырза қандай адам?
Dialogue: 0,0:22:00.86,0:22:03.15,Default,,0,0,0,,Не болды, кенет не болды?
Dialogue: 0,0:22:03.23,0:22:05.24,Default,,0,0,0,,Жоқ, қалай болғанда да
Dialogue: 0,0:22:05.32,0:22:06.78,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:22:06.86,0:22:07.86,Default,,0,0,0,,Не?
Dialogue: 0,0:22:07.95,0:22:11.20,Default,,0,0,0,,Әпкемнің маған қызығатынына қуаныштымын.
Dialogue: 0,0:22:11.28,0:22:12.45,Default,,0,0,0,,Иә, өрескел!
Dialogue: 0,0:22:12.53,0:22:14.20,Default,,0,0,0,,Жетеді!
Dialogue: 0,0:22:14.29,0:22:15.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:16.04,0:22:20.00,Default,,0,0,0,,♪～
Dialogue: 0,0:23:40.96,0:23:45.96,Default,,0,0,0,,～♪
