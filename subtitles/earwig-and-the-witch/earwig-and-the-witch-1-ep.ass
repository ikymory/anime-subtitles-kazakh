Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.65,0:00:21.94,Default,,0,0,0,,♪ Әй, жолбарыс бақсы
Dialogue: 0,0:00:22.03,0:00:26.74,Default,,0,0,0,,♪ Әй, бақытты пері
Dialogue: 0,0:00:26.74,0:00:31.38,Default,,0,0,0,,♪ Әй, шайтан жастық киіп алған
Dialogue: 0,0:00:31.49,0:00:36.04,Default,,0,0,0,,♪ Мен бұралып жатырмын
Dialogue: 0,0:00:36.12,0:00:38.50,Default,,0,0,0,,♪ Маған кедергі жасама...
Dialogue: 0,0:00:39.08,0:00:40.00,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:00:43.17,0:00:44.59,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:59.35,0:01:02.11,Default,,0,0,0,,(Көлік сигналы дыбысы)
Dialogue: 0,0:01:04.73,0:01:06.44,Default,,0,0,0,,(Көлік сигналы дыбысы)
Dialogue: 0,0:01:06.53,0:01:07.74,Default,,0,0,0,,(көлік дыбысы)
Dialogue: 0,0:01:13.58,0:01:15.16,Default,,0,0,0,,(Көліктің гуілдеген дыбысы)
Dialogue: 0,0:01:18.96,0:01:22.25,Default,,0,0,0,,(тышқан дыбысы)
Dialogue: 0,0:01:27.84,0:01:30.30,Default,,0,0,0,,(Пан дыбысы)
Dialogue: 0,0:01:31.93,0:01:35.01,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:01:56.70,0:01:58.62,Default,,0,0,0,,(нәресте дауысы)
Dialogue: 0,0:02:00.46,0:02:02.79,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:02:04.92,0:02:06.38,Default,,0,0,0,,Сізге серуен ұнады ма?
Dialogue: 0,0:02:06.46,0:02:07.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:07.67,0:02:09.80,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:02:10.63,0:02:13.05,Default,,0,0,0,,Мұндағы бөлмелердің бәрі жылтыр.
Dialogue: 0,0:02:13.14,0:02:16.60,Default,,0,0,0,,Көптеген үлкен терезелер бар және ол жақсы сезінеді.
Dialogue: 0,0:02:17.27,0:02:19.89,Default,,0,0,0,,Ал қойшының бәлегі дәмді.
Dialogue: 0,0:02:22.56,0:02:25.61,Default,,0,0,0,,Жарайсың ба? сен осындасың
Dialogue: 0,0:02:26.73,0:02:28.61,Default,,0,0,0,,Басқа жерге бармаңыз
Dialogue: 0,0:02:29.65,0:02:32.20,Default,,0,0,0,,Қалғанын жақсы орында.
Dialogue: 0,0:02:33.57,0:02:34.87,Default,,0,0,0,,Аяцуру
Dialogue: 0,0:02:36.78,0:02:37.45,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:02:37.54,0:02:39.41,Default,,0,0,0,,(Аятсурудың айқайы)
Dialogue: 0,0:02:39.50,0:02:41.62,Default,,0,0,0,,Таңертең ерте!
Dialogue: 0,0:02:42.21,0:02:44.83,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:02:44.92,0:02:46.13,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:02:46.21,0:02:49.46,Default,,0,0,0,,О, ой, ой! О...
Dialogue: 0,0:02:50.13,0:02:52.47,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,0:02:53.05,0:02:55.47,Default,,0,0,0,,Кел, жылама, жылама
Dialogue: 0,0:02:56.14,0:02:58.47,Default,,0,0,0,,Ико Ико
Dialogue: 0,0:02:58.56,0:03:01.48,Default,,0,0,0,,«12 сиқыршы қуғындады»
Dialogue: 0,0:03:02.10,0:03:02.89,Default,,0,0,0,,«Егер сен қашсаң»
Dialogue: 0,0:03:02.98,0:03:04.98,Default,,0,0,0,,«Мен бұл баланы қайтаруға келемін.»
Dialogue: 0,0:03:05.06,0:03:08.44,Default,,0,0,0,,«Бұл жылдар қажет болуы мүмкін.»
Dialogue: 0,0:03:08.52,0:03:11.49,Default,,0,0,0,,«Бұл баланың аты Аяцуру».
Dialogue: 0,0:03:11.57,0:03:12.70,Default,,0,0,0,,Аяцуру?
Dialogue: 0,0:03:13.28,0:03:16.78,Default,,0,0,0,,Осы сәбидің анасы 12 бақсының бірі болса.
Dialogue: 0,0:03:16.87,0:03:19.12,Default,,0,0,0,,Бұл адам да бақсы ғой, солай ма?
Dialogue: 0,0:03:19.20,0:03:21.12,Default,,0,0,0,,Ведьма Ковеннің барлық мүшелері
Dialogue: 0,0:03:21.20,0:03:23.66,Default,,0,0,0,,Мен сені ашуландыратын бірдеңе істедім бе?
Dialogue: 0,0:03:23.75,0:03:26.13,Default,,0,0,0,,Сіз бақсысыз ба? күлкілі!
Dialogue: 0,0:03:26.21,0:03:29.92,Default,,0,0,0,,Сонда бұл нәресте де бақсы болуы мүмкін.
Dialogue: 0,0:03:30.00,0:03:31.46,Default,,0,0,0,,Е...
Dialogue: 0,0:03:31.55,0:03:32.63,Default,,0,0,0,,Аха аа!
Dialogue: 0,0:03:32.72,0:03:36.72,Default,,0,0,0,,Бос сөз! Бұл дүниеде сиқыршылар жоқ.
Dialogue: 0,0:03:36.80,0:03:37.72,Default,,0,0,0,,Эй
Dialogue: 0,0:03:37.80,0:03:38.76,Default,,0,0,0,,Ах
Dialogue: 0,0:03:38.85,0:03:41.22,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:03:42.77,0:03:46.15,Default,,0,0,0,,Аяцуру адамдарды «айла» алмайтын сияқты.
Dialogue: 0,0:03:46.73,0:03:48.15,Default,,0,0,0,,Аяцуру…
Dialogue: 0,0:03:48.23,0:03:51.15,Default,,0,0,0,,Аятуру… Аятуру…
Dialogue: 0,0:03:52.07,0:03:53.65,Default,,0,0,0,,Principal?
Dialogue: 0,0:03:53.74,0:03:55.49,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,0:03:56.28,0:04:00.16,Default,,0,0,0,,Мен сендерді мына баламен таныстырамын, Ая құрал.
Dialogue: 0,0:04:00.74,0:04:02.33,Default,,0,0,0,,Aya!
Dialogue: 0,0:04:03.04,0:04:05.16,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:05.25,0:04:06.79,Default,,0,0,0,,(Аяның күлкісі)
Dialogue: 0,0:04:06.87,0:04:08.75,Default,,0,0,0,,Ой, көңіл-күйің жақсы.
Dialogue: 0,0:04:08.83,0:04:11.92,Default,,0,0,0,,(Барлығының күлкісі)
Dialogue: 0,0:04:13.01,0:04:17.26,Default,,0,0,0,,(жарқын музыка)
Dialogue: 0,0:05:54.61,0:05:58.53,Default,,0,0,0,,(аяқ дыбыстары мен күлдіру)
Dialogue: 0,0:06:01.11,0:06:03.28,Default,,0,0,0,,Хехе... Тынш!
Dialogue: 0,0:06:05.79,0:06:09.04,Default,,0,0,0,,(ритмикалық музыка)
Dialogue: 0,0:06:28.64,0:06:30.06,Default,,0,0,0,,Гах!
Dialogue: 0,0:06:30.14,0:06:31.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:36.73,0:06:38.23,Default,,0,0,0,,(Иттің айқайы)
Dialogue: 0,0:06:38.32,0:06:39.44,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:40.15,0:06:41.32,Default,,0,0,0,,А, аа...!
Dialogue: 0,0:06:47.66,0:06:48.33,Default,,0,0,0,,Ууууах!
Dialogue: 0,0:06:49.08,0:06:50.08,Default,,0,0,0,,(Иттің айқайы)
Dialogue: 0,0:06:50.16,0:06:52.54,Default,,0,0,0,,Ах! Ууууу...
Dialogue: 0,0:06:52.62,0:06:54.33,Default,,0,0,0,,(Дженкинс ентігу)
Dialogue: 0,0:06:54.42,0:06:55.25,Default,,0,0,0,,(Нигеру дыбысы)
Dialogue: 0,0:06:55.33,0:06:57.34,Default,,0,0,0,,(Елестердің күлкісі)
Dialogue: 0,0:07:05.01,0:07:06.97,Default,,0,0,0,,Тоқтатайық, Ая.
Dialogue: 0,0:07:07.05,0:07:09.43,Default,,0,0,0,,Егер олар білсе, олар міндетті түрде ашуланады.
Dialogue: 0,0:07:09.52,0:07:12.85,Default,,0,0,0,,Ештеңе етпейді, тек олар таппаса.
Dialogue: 0,0:07:15.81,0:07:16.86,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:20.69,0:07:22.03,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:07:24.95,0:07:27.28,Default,,0,0,0,,Маған ұрысқан ұнамайды.
Dialogue: 0,0:07:27.37,0:07:31.20,Default,,0,0,0,,Сен ақымақсың. Мұндай мүмкіндіктер жиі бола бермейді.
Dialogue: 0,0:07:31.29,0:07:32.20,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:07:32.29,0:07:34.17,Default,,0,0,0,,Осы жерде күтуім керек пе?
Dialogue: 0,0:07:34.25,0:07:38.75,Default,,0,0,0,,Хехе, батыл болсаң.
Dialogue: 0,0:07:41.51,0:07:42.21,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:42.30,0:07:44.43,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:07:45.93,0:07:49.56,Default,,0,0,0,,Ая, күте тұрыңыз.
Dialogue: 0,0:07:58.61,0:08:00.02,Default,,0,0,0,,Хехе...
Dialogue: 0,0:08:00.11,0:08:01.44,Default,,0,0,0,,Не?
Dialogue: 0,0:08:01.53,0:08:05.20,Default,,0,0,0,,Не істеу керек? Сіз шыңға жеткенде, қоңыраудың орнына
Dialogue: 0,0:08:05.28,0:08:09.12,Default,,0,0,0,,Адамның кесілген басы дірілдеп тұр
Dialogue: 0,0:08:09.20,0:08:10.16,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:08:10.74,0:08:12.16,Default,,0,0,0,,It's not fun!
Dialogue: 0,0:08:12.24,0:08:14.96,Default,,0,0,0,,Ахахахаха!
Dialogue: 0,0:08:15.04,0:08:18.63,Default,,0,0,0,,Сонымен, кесілген бастың көзі ашық болды...
Dialogue: 0,0:08:18.71,0:08:19.59,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:19.67,0:08:20.21,Default,,0,0,0,,Эй...!
Dialogue: 0,0:08:20.29,0:08:22.88,Default,,0,0,0,,Ол бізге қарап тұр.
Dialogue: 0,0:08:23.84,0:08:25.67,Default,,0,0,0,,Сосын кенеттен...
Dialogue: 0,0:08:25.76,0:08:26.88,Default,,0,0,0,,Кесілген бастың аузы ашылады!
Dialogue: 0,0:08:26.97,0:08:28.51,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:08:28.59,0:08:30.22,Default,,0,0,0,,Мен сізді естімеймін.
Dialogue: 0,0:08:30.30,0:08:32.97,Default,,0,0,0,,A little custard
Dialogue: 0,0:08:33.06,0:08:36.73,Default,,0,0,0,,Егер сіз соншалықты қорқатын болсаңыз, марсиялықтар шабуыл жасаса не істейсіз?
Dialogue: 0,0:08:36.81,0:08:40.27,Default,,0,0,0,,Марслықтар бізге мейірімді!
Dialogue: 0,0:08:40.36,0:08:43.32,Default,,0,0,0,,Ол Генлейннің кітабында жазылған!
Dialogue: 0,0:08:44.28,0:08:45.95,Default,,0,0,0,,Бұл бәрібір сенсің
Dialogue: 0,0:08:46.03,0:08:48.45,Default,,0,0,0,,Сегіз қол мені қатты ұстайды
Dialogue: 0,0:08:48.53,0:08:51.83,Default,,0,0,0,,Намуамидабутсу Қош бол
Dialogue: 0,0:08:52.49,0:08:55.91,Default,,0,0,0,,Марстардың сегіз емес, үш қолы бар!
Dialogue: 0,0:08:56.58,0:08:58.33,Default,,0,0,0,,Бұл екі жағдайда да маңызды емес.
Dialogue: 0,0:09:03.00,0:09:04.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:05.71,0:09:12.30,Default,,0,0,0,,Өзіңізді жақсы сезінесіз!
Dialogue: 0,0:09:13.10,0:09:13.93,Default,,0,0,0,,Тынш!
Dialogue: 0,0:09:14.01,0:09:15.72,Default,,0,0,0,,Сізді біреу ести алады!
Dialogue: 0,0:09:16.39,0:09:18.35,Default,,0,0,0,,Баршаңызға.
Dialogue: 0,0:09:18.44,0:09:21.86,Default,,0,0,0,,Зират шедевріндегі елес кеші!
Dialogue: 0,0:09:22.44,0:09:25.82,Default,,0,0,0,,Біздің кеткенімізді ешкім байқамады.
Dialogue: 0,0:09:26.82,0:09:28.36,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:09:29.15,0:09:31.28,Default,,0,0,0,,Бұл кеме емес пе?
Dialogue: 0,0:09:31.37,0:09:32.37,Default,,0,0,0,,Эмма мен басқалары – мен бұрын-соңды көрген де, сөйлескен де алғашқы адамдар еді.
Dialogue: 0,0:09:33.53,0:09:35.45,Default,,0,0,0,,Ғарыш кемесіне ұқсайды
Dialogue: 0,0:09:35.54,0:09:38.87,Default,,0,0,0,,Керемет... Мен оны мінгім келеді.
Dialogue: 0,0:09:41.13,0:09:43.29,Default,,0,0,0,,Ах... Арья...
Dialogue: 0,0:09:43.88,0:09:46.46,Default,,0,0,0,,Оны маған біреу басқа жерден берді
Dialogue: 0,0:09:46.55,0:09:49.38,Default,,0,0,0,,Сіз сонда өмір сүргіңіз келді ме?
Dialogue: 0,0:09:50.05,0:09:51.26,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:09:53.22,0:09:55.47,Default,,0,0,0,,Иә, мен олай ойламаймын.
Dialogue: 0,0:09:55.56,0:09:59.14,Default,,0,0,0,,Егер мені кім таңдаса, олар өте біртүрлі болуы керек.
Dialogue: 0,0:09:59.23,0:10:02.61,Default,,0,0,0,,Және оны кәдімгі үйге алып кетті.
Dialogue: 0,0:10:02.69,0:10:05.90,Default,,0,0,0,,Менің айтқанымды істейтін екі-үш адам бар.
Dialogue: 0,0:10:06.53,0:10:10.40,Default,,0,0,0,,Ең көбі 6 адам Бұл қызық емес пе?
Dialogue: 0,0:10:11.03,0:10:13.87,Default,,0,0,0,,Мұндағылардың бәрі мен айтқандай дұрыс.
Dialogue: 0,0:10:14.53,0:10:17.04,Default,,0,0,0,,Барлық жерде жылтыр
Dialogue: 0,0:10:19.04,0:10:21.79,Default,,0,0,0,,Үлкен терезелер және көп күн сәулесі
Dialogue: 0,0:10:21.87,0:10:25.79,Default,,0,0,0,,Ал ағайдың қойшысының пирогы ең жақсы!
Dialogue: 0,0:10:27.38,0:10:31.30,Default,,0,0,0,,Жарайды, сені де ешкім таңдамайды.
Dialogue: 0,0:10:31.97,0:10:35.80,Default,,0,0,0,,Бірақ менің алдымда тоқтайтын адамдар аз емес.
Dialogue: 0,0:10:36.68,0:10:39.64,Default,,0,0,0,,Таңдалып қала жаздаған кездерім болды.
Dialogue: 0,0:10:40.18,0:10:41.02,Default,,0,0,0,,Ахахаха!
Dialogue: 0,0:10:41.10,0:10:42.27,Default,,0,0,0,,(ритмикалық музыка)
Dialogue: 0,0:10:45.61,0:10:46.73,Default,,0,0,0,,Міне!
Dialogue: 0,0:10:46.82,0:10:50.49,Default,,0,0,0,,Мен үйреткенімдей, оны жиі көруді ұмытпаңыз.
Dialogue: 0,0:10:51.49,0:10:53.78,Default,,0,0,0,,Түсінесіз бе, Мистер Кьютерд?
Dialogue: 0,0:10:54.32,0:10:55.24,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:10:56.16,0:10:58.74,Default,,0,0,0,,А... Иә, капитан!
Dialogue: 0,0:11:00.41,0:11:01.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:04.33,0:11:07.25,Default,,0,0,0,,(Ая мен Кистардтың күлкісі)
Dialogue: 0,0:11:21.77,0:11:22.94,Default,,0,0,0,,Селма!
Dialogue: 0,0:11:23.56,0:11:24.85,Default,,0,0,0,,Селма!
Dialogue: 0,0:11:24.94,0:11:29.36,Default,,0,0,0,,Welcome back, Director, what's wrong?
Dialogue: 0,0:11:29.44,0:11:31.53,Default,,0,0,0,,Ата-анаңның үйінде бірдеңе болып жатыр ма?
Dialogue: 0,0:11:31.61,0:11:33.36,Default,,0,0,0,,Бұл бәрі емес!
Dialogue: 0,0:11:33.45,0:11:36.95,Default,,0,0,0,,Мен сол жерде аялдамада көршім Дженкинс мырзаны кездестірдім.
Dialogue: 0,0:11:37.03,0:11:39.58,Default,,0,0,0,,Кеше кешке балалар елес болып киінген...
Dialogue: 0,0:11:39.66,0:11:40.95,Default,,0,0,0,,Жақсы! кеше түнде?
Dialogue: 0,0:11:41.04,0:11:43.41,Default,,0,0,0,,Did you not notice something?
Dialogue: 0,0:11:43.50,0:11:46.46,Default,,0,0,0,,No, I didn't notice at all.
Dialogue: 0,0:11:47.13,0:11:49.29,Default,,0,0,0,,Сіз шынымен елес көрдіңіз бе?
Dialogue: 0,0:11:49.38,0:11:51.00,Default,,0,0,0,,Бірақ аталған адам өз келісімін берді
Dialogue: 0,0:11:51.09,0:11:52.72,Default,,0,0,0,,Негізгі
Dialogue: 0,0:11:53.30,0:11:55.09,Default,,0,0,0,,Мен солай істедім
Dialogue: 0,0:11:55.18,0:11:56.68,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:56.76,0:11:58.64,Default,,0,0,0,,Кьютерд алға
Dialogue: 0,0:11:58.72,0:11:59.60,Default,,0,0,0,,Иә
Dialogue: 0,0:12:00.22,0:12:03.14,Default,,0,0,0,,Айя, бұл нені білдіреді?
Dialogue: 0,0:12:03.23,0:12:06.60,Default,,0,0,0,,Бүгін түстен кейін оны басқа біреу алады, солай ма?
Dialogue: 0,0:12:07.31,0:12:10.77,Default,,0,0,0,,That's why we all had a farewell party.
Dialogue: 0,0:12:10.86,0:12:14.11,Default,,0,0,0,,Негізінде, директор да солай жасамақ болған.
Dialogue: 0,0:12:14.19,0:12:18.37,Default,,0,0,0,,Себебі мен директормен қоштасып жатырмын...
Dialogue: 0,0:12:18.45,0:12:19.78,Default,,0,0,0,,I hate it the most
Dialogue: 0,0:12:20.53,0:12:23.12,Default,,0,0,0,,But did I go a little too far?
Dialogue: 0,0:12:23.20,0:12:25.83,Default,,0,0,0,,Ах... Арья
Dialogue: 0,0:12:25.91,0:12:27.83,Default,,0,0,0,,You are a child...
Dialogue: 0,0:12:28.67,0:12:30.96,Default,,0,0,0,,Иә, бұл күн.
Dialogue: 0,0:12:31.04,0:12:33.63,Default,,0,0,0,,It might be your day.
Dialogue: 0,0:12:34.59,0:12:36.76,Default,,0,0,0,,Менің сендей сүйкімді қызым бар.
Dialogue: 0,0:12:36.84,0:12:40.43,Default,,0,0,0,,It's no wonder that I was never chosen.
Dialogue: 0,0:12:41.64,0:12:42.81,Default,,0,0,0,,(Аяның күрсінуі)
Dialogue: 0,0:12:45.02,0:12:47.35,Default,,0,0,0,,Иә...
Dialogue: 0,0:12:48.35,0:12:49.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:49.81,0:12:52.90,Default,,0,0,0,,That's right, I completely forgot.
Dialogue: 0,0:12:56.07,0:12:59.62,Default,,0,0,0,,Қараңызшы, мен біраздан бері осыны қалаймын.
Dialogue: 0,0:13:00.28,0:13:01.91,Default,,0,0,0,,Қызыл жемпір?
Dialogue: 0,0:13:02.53,0:13:04.66,Default,,0,0,0,,Тынш! Барлығына айтпаңыз
Dialogue: 0,0:13:04.75,0:13:07.16,Default,,0,0,0,,Иә, айтпа.
Dialogue: 0,0:13:07.25,0:13:10.79,Default,,0,0,0,,А, мен бақтағы ең бақытты адаммын!
Dialogue: 0,0:13:10.88,0:13:12.67,Default,,0,0,0,,I love you so much, Mr. Principal!
Dialogue: 0,0:13:12.75,0:13:13.38,Default,,0,0,0,,Oh my goodness
Dialogue: 0,0:13:13.46,0:13:15.34,Default,,0,0,0,,Бұл негізгі
Dialogue: 0,0:13:15.42,0:13:17.17,Default,,0,0,0,,Дженкинс мырзаға не айтасыз?
Dialogue: 0,0:13:17.93,0:13:21.89,Default,,0,0,0,,Бейіттерді аңдып жүр, соны айт!
Dialogue: 0,0:13:21.97,0:13:24.93,Default,,0,0,0,,Мұғалім, мен сенің сөмкеңді аламын.
Dialogue: 0,0:13:25.52,0:13:27.64,Default,,0,0,0,,Әй, бұл ауыр емес пе?
Dialogue: 0,0:13:27.73,0:13:29.06,Default,,0,0,0,,Одан аулақ болыңыз
Dialogue: 0,0:13:29.14,0:13:30.94,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:13:33.36,0:13:34.53,Default,,0,0,0,,Бірақ аталған адам өз келісімін берді
Dialogue: 0,0:13:34.61,0:13:37.53,Default,,0,0,0,,(жеңіл музыка)
Dialogue: 0,0:13:40.61,0:13:42.99,Default,,0,0,0,,Ah, Aya, yesterday...
Dialogue: 0,0:13:43.62,0:13:46.75,Default,,0,0,0,,Жарайды, бәрін қайта жазып, пошта жәшігіне салдым.
Dialogue: 0,0:13:47.25,0:13:50.54,Default,,0,0,0,,Ертең махаббатқа толы жауап алатыныңызға сенімдімін, солай ма?
Dialogue: 0,0:13:50.62,0:13:51.50,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:13:51.58,0:13:52.84,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:13:52.92,0:13:54.21,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:13:54.29,0:13:57.01,Default,,0,0,0,,(Аяның иіскеген дыбысы)
Dialogue: 0,0:14:02.76,0:14:05.26,Default,,0,0,0,,Әй, бүгін түскі асқа қойшы бәлегі ше?
Dialogue: 0,0:14:06.06,0:14:08.27,Default,,0,0,0,,A young lady with a sharp nose came.
Dialogue: 0,0:14:08.98,0:14:12.23,Default,,0,0,0,,Шопан бәліш, солай ма? Солай болуы керек.
Dialogue: 0,0:14:12.31,0:14:15.98,Default,,0,0,0,,Өйткені ағамның пирогы әлемдегі ең жақсы.
Dialogue: 0,0:14:16.07,0:14:17.82,Default,,0,0,0,,It smells wonderful.
Dialogue: 0,0:14:17.90,0:14:20.28,Default,,0,0,0,,Мұнда бас аспаз кім болды?
Dialogue: 0,0:14:20.36,0:14:22.11,Default,,0,0,0,,That's right, Arya.
Dialogue: 0,0:14:22.78,0:14:24.66,Default,,0,0,0,,О, мен емеспін.
Dialogue: 0,0:14:24.74,0:14:28.25,Default,,0,0,0,,Мен соншалықты аш емеспін.
Dialogue: 0,0:14:28.33,0:14:29.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:30.33,0:14:32.33,Default,,0,0,0,,Аздап арықтасаңыз ше?
Dialogue: 0,0:14:33.13,0:14:36.17,Default,,0,0,0,,Хмф! Мен бұған мүлдем шыдай алмаймын.
Dialogue: 0,0:14:36.25,0:14:40.67,Default,,0,0,0,,Earwig lady, look forward to lunch.
Dialogue: 0,0:14:41.47,0:14:42.93,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:45.93,0:14:47.56,Default,,0,0,0,,I love you so much!
Dialogue: 0,0:14:50.02,0:14:51.64,Default,,0,0,0,,(Аспаз бен көмекші арасындағы күлкі)
Dialogue: 0,0:14:53.15,0:14:53.73,Default,,0,0,0,,(нәресте дауысы)
Dialogue: 0,0:14:53.81,0:14:54.65,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:14:54.73,0:14:56.69,Default,,0,0,0,,Мен мұны көрдім.
Dialogue: 0,0:14:56.77,0:14:59.15,Default,,0,0,0,,Қандай жарқыраған көздер!
Dialogue: 0,0:14:59.23,0:15:00.78,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:00.86,0:15:02.65,Default,,0,0,0,,Әдемі қара шаш.
Dialogue: 0,0:15:03.41,0:15:05.78,Default,,0,0,0,,Oh, can you give it to me? рахмет
Dialogue: 0,0:15:05.87,0:15:06.66,Default,,0,0,0,,Ол жақсы бала.
Dialogue: 0,0:15:07.28,0:15:08.45,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:15:08.54,0:15:10.20,Default,,0,0,0,,Иә! I feel bad!
Dialogue: 0,0:15:13.25,0:15:14.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:22.55,0:15:24.80,Default,,0,0,0,,Those kids aren't dolls.
Dialogue: 0,0:15:24.89,0:15:26.43,Default,,0,0,0,,Мен тірімін.
Dialogue: 0,0:15:27.43,0:15:29.77,Default,,0,0,0,,Қарап отырып ләззат алатын нәрсе емес.
Dialogue: 0,0:15:36.52,0:15:39.11,Default,,0,0,0,,At most we also have cute dolls.
Dialogue: 0,0:15:39.19,0:15:41.82,Default,,0,0,0,,Әрекет етейік, мистер Кистард.
Dialogue: 0,0:15:48.83,0:15:53.29,Default,,0,0,0,,(Doorbell buzzer sound)
Dialogue: 0,0:15:53.37,0:15:55.46,Default,,0,0,0,,Yes, yes, I'm home.
Dialogue: 0,0:15:57.63,0:15:59.84,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:16:01.25,0:16:02.46,Default,,0,0,0,,Please...
Dialogue: 0,0:16:03.13,0:16:05.38,Default,,0,0,0,,Сол бет – белгі, көріп тұрсың ба.
Dialogue: 0,0:16:05.47,0:16:08.35,Default,,0,0,0,,Кәне, дұрыстап сапқа тұрыңдар.
Dialogue: 0,0:16:08.43,0:16:10.60,Default,,0,0,0,,Барлығыңыз күліңіздер
Dialogue: 0,0:16:11.18,0:16:12.60,Default,,0,0,0,,Өтінемін, осы.
Dialogue: 0,0:16:15.77,0:16:16.85,Default,,0,0,0,,Ах! (Ая) А?
Dialogue: 0,0:16:17.48,0:16:21.44,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,0:16:25.45,0:16:28.87,Default,,0,0,0,,Әр адамды бір-бірден таныстырамын.
Dialogue: 0,0:16:29.74,0:16:32.87,Default,,0,0,0,,Бұл бала Мария Хименес, 8 жаста.
Dialogue: 0,0:16:32.95,0:16:36.25,Default,,0,0,0,,Түрі осылай болғанымен, ол өте белсенді ханым.
Dialogue: 0,0:16:36.96,0:16:38.38,Default,,0,0,0,,Бұл Джордж МакРэй
Dialogue: 0,0:16:38.46,0:16:39.00,Default,,0,0,0,,Бет!
Dialogue: 0,0:16:39.08,0:16:41.63,Default,,0,0,0,,Маған жүк көліктері сияқты үлкен көліктер ұнайды.
Dialogue: 0,0:16:41.71,0:16:42.55,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:16:42.63,0:16:43.38,Default,,0,0,0,,Ал келесі...
Dialogue: 0,0:16:43.96,0:16:47.38,Default,,0,0,0,,Кристиан Фрум Мен спортты жақсы көремін
Dialogue: 0,0:16:47.47,0:16:50.10,Default,,0,0,0,,Сенің болашақта велосипедші болғың келеді деп естідім.
Dialogue: 0,0:16:50.76,0:16:53.60,Default,,0,0,0,,Келесі бала - Аки Райсфилд.
Dialogue: 0,0:16:54.81,0:16:57.39,Default,,0,0,0,,(көпіршікті дыбыс)
Dialogue: 0,0:17:06.49,0:17:07.49,Default,,0,0,0,,(дыбыс)
Dialogue: 0,0:17:07.57,0:17:09.78,Default,,0,0,0,,...Ата-анаң өртте қайтыс болды.
Dialogue: 0,0:17:09.87,0:17:13.08,Default,,0,0,0,,Сондай-ақ көршілес аумақта күдікті өртке оранды.
Dialogue: 0,0:17:13.16,0:17:15.54,Default,,0,0,0,,Нағыз бейшара бала...
Dialogue: 0,0:17:17.71,0:17:19.92,Default,,0,0,0,,А...? О
Dialogue: 0,0:17:20.00,0:17:22.21,Default,,0,0,0,,Бұл бала Айя құралы
Dialogue: 0,0:17:22.29,0:17:25.80,Default,,0,0,0,,Мен сәби кезімнен осындамын.
Dialogue: 0,0:17:27.34,0:17:29.43,Default,,0,0,0,,(Исуми Миямура) Ишикава-кун, сенде абсурдтай көп зат бар, иә?
Dialogue: 0,0:17:29.51,0:17:31.51,Default,,0,0,0,,Қалай ойлайсың, Мандрейк?
Dialogue: 0,0:17:31.60,0:17:32.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:32.89,0:17:34.77,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:17:35.47,0:17:37.31,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:17:39.69,0:17:40.81,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:17:40.90,0:17:41.86,Default,,0,0,0,,Не!
Dialogue: 0,0:17:41.94,0:17:42.61,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:42.69,0:17:43.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:44.40,0:17:46.32,Default,,0,0,0,,Мен бармаймын!
Dialogue: 0,0:17:46.40,0:17:50.11,Default,,0,0,0,,Кенеттен не болды? Отбасың болғанын қалаймын
Dialogue: 0,0:17:50.20,0:17:53.70,Default,,0,0,0,,Біз әрқашан не күтетінімізді білесіз бе?
Dialogue: 0,0:17:53.78,0:17:56.83,Default,,0,0,0,,Бірақ бұл маған ұнамайды, мен Кастадпен бірге болғым келеді!
Dialogue: 0,0:17:56.91,0:18:00.33,Default,,0,0,0,,Жоқ, Ая, бұл адамдар.
Dialogue: 0,0:18:00.42,0:18:03.84,Default,,0,0,0,,Ол Лайм көшесінде тұрады.
Dialogue: 0,0:18:03.92,0:18:06.84,Default,,0,0,0,,Достарыңызбен осында кездескіңіз келсе
Dialogue: 0,0:18:06.92,0:18:07.71,Default,,0,0,0,,Жақында кездесеміз.
Dialogue: 0,0:18:07.80,0:18:08.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:08.42,0:18:12.34,Default,,0,0,0,,Мектеп басталғаннан кейін сіз Кьютердті күн сайын көре аласыз.
Dialogue: 0,0:18:12.97,0:18:16.52,Default,,0,0,0,,А, мен сені кеңседе күтемін.
Dialogue: 0,0:18:20.85,0:18:22.81,Default,,0,0,0,,Мен оны жеп қойсаңыз екен.
Dialogue: 0,0:18:23.48,0:18:25.40,Default,,0,0,0,,Мен кейін аш боламын.
Dialogue: 0,0:18:26.90,0:18:28.03,Default,,0,0,0,,(Директор орынбасарының күрсінуі)
Dialogue: 0,0:18:28.11,0:18:31.78,Default,,0,0,0,,Олай болса, дайындалып болған соң, төменге тез түсіңіз.
Dialogue: 0,0:18:33.95,0:18:37.41,Default,,0,0,0,,(есіктің ашылу және жабылу дыбысы)
Dialogue: 0,0:18:42.87,0:18:44.63,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:45.46,0:18:47.75,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:18:54.43,0:18:56.39,Default,,0,0,0,,«Құлақ»?
Dialogue: 0,0:18:57.35,0:18:58.89,Default,,0,0,0,,Хмф!
Dialogue: 0,0:19:03.98,0:19:05.61,Default,,0,0,0,,Жоқ… Оларды Эрен өлтірді!!
Dialogue: 0,0:19:07.07,0:19:09.32,Default,,0,0,0,,Ая…
Dialogue: 0,0:19:15.28,0:19:17.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:18.87,0:19:21.00,Default,,0,0,0,,Ая…
Dialogue: 0,0:19:24.88,0:19:28.80,Default,,0,0,0,,Өмірімде бірінші рет өзім қаламайтын нәрсені жасауға мәжбүр болдым.
Dialogue: 0,0:19:28.88,0:19:31.01,Default,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,0:19:31.09,0:19:34.47,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,0:19:56.24,0:19:59.16,Default,,0,0,0,,Бұл мүйіз екені сөзсіз.
Dialogue: 0,0:20:02.75,0:20:03.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:03.75,0:20:05.00,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:20:07.38,0:20:10.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:10.50,0:20:12.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:24.39,0:20:27.31,Default,,0,0,0,,Жарайды, мен жеңілемін деп ойлаймын.
Dialogue: 0,0:20:33.40,0:20:36.82,Default,,0,0,0,,(нәзік музыка)
Dialogue: 0,0:20:45.71,0:20:50.13,Default,,0,0,0,,No 13 ғұн, күткендей.
Dialogue: 0,0:20:54.13,0:20:57.88,Default,,0,0,0,,О, өте жақсы сезіледі, мен кез келген уақытта қашып кететін сияқтымын.
Dialogue: 0,0:20:58.55,0:20:59.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:03.10,0:21:04.64,Default,,0,0,0,,(ұшып бара жатқан дыбыс)
Dialogue: 0,0:21:05.68,0:21:08.14,Default,,0,0,0,,Мен саған қалағаныңды алдым.
Dialogue: 0,0:21:08.23,0:21:11.94,Default,,0,0,0,,Бұдан былай мені мазалама.
Dialogue: 0,0:21:12.86,0:21:14.48,Default,,0,0,0,,Иә! Ах...
Dialogue: 0,0:21:18.15,0:21:20.03,Default,,0,0,0,,Сіз осында ұйықтайсыз.
Dialogue: 0,0:21:21.07,0:21:24.54,Default,,0,0,0,,Енді біраз нәрсені нақтылай кетейін.
Dialogue: 0,0:21:25.12,0:21:28.54,Default,,0,0,0,,Менің атым Бела Яга, мен бақсымын.
Dialogue: 0,0:21:29.42,0:21:33.63,Default,,0,0,0,,Маған сенің көмегің керек болғандықтан үйге әкелдім.
Dialogue: 0,0:21:33.71,0:21:37.26,Default,,0,0,0,,Еңбек етсең, қиналмайсың.
Dialogue: 0,0:21:37.34,0:21:38.17,Default,,0,0,0,,(қабырғадағы қолдың дыбысы)
Dialogue: 0,0:21:41.01,0:21:44.56,Default,,0,0,0,,Бірақ егер...
Dialogue: 0,0:21:44.64,0:21:45.77,Default,,0,0,0,,Керемет!
Dialogue: 0,0:21:45.85,0:21:47.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:47.89,0:21:51.31,Default,,0,0,0,,Әпкең ана болғысы келсе, жарайды.
Dialogue: 0,0:21:51.40,0:21:52.27,Default,,0,0,0,,Мен оны көре алмадым
Dialogue: 0,0:21:54.02,0:21:56.28,Default,,0,0,0,,Содан кейін шешім қабылданады.
Dialogue: 0,0:21:57.61,0:22:00.70,Default,,0,0,0,,Тәтемнің маған сиқыр үйреткеніне айырбас
Dialogue: 0,0:22:00.78,0:22:03.16,Default,,0,0,0,,Мен апаңның көмекшісі боламын.
Dialogue: 0,0:22:03.74,0:22:06.54,Default,,0,0,0,,Хмф, мен түсінемін. Сосын шешілді.
Dialogue: 0,0:22:09.04,0:22:10.54,Default,,0,0,0,,Бұл жерге кірме
Dialogue: 0,0:22:11.12,0:22:12.75,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:22:16.13,0:22:17.13,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:22:18.13,0:22:19.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:19.55,0:22:22.30,Default,,0,0,0,,(Тездіргіш музыка)
Dialogue: 0,0:22:31.19,0:22:32.27,Default,,0,0,0,,(Аяның ентігуі)
Dialogue: 0,0:22:32.35,0:22:34.98,Default,,0,0,0,,Хехехехе…
Dialogue: 0,0:22:37.07,0:22:40.95,Default,,0,0,0,,Әй, оны киіп, осында кел.
Dialogue: 0,0:22:41.57,0:22:44.82,Default,,0,0,0,,Қарап отыру сенің міндетің емес.
Dialogue: 0,0:22:48.95,0:22:51.54,Default,,0,0,0,,Мұнда не болып жатқаны сізге ұнамаса.
Dialogue: 0,0:22:51.62,0:22:54.63,Default,,0,0,0,,Ақыр соңында оны тазалауға тура келеді.
Dialogue: 0,0:22:54.71,0:22:57.55,Default,,0,0,0,,Хехехехе…
Dialogue: 0,0:22:58.76,0:22:59.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:59.71,0:23:03.05,Default,,0,0,0,,Енді мына егеуқұйрықтың сүйектерін сындырыңыз.
Dialogue: 0,0:23:03.13,0:23:04.68,Default,,0,0,0,,Оны ұнтаққа айналдырыңыз.
Dialogue: 0,0:23:05.72,0:23:06.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:07.72,0:23:10.10,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:23:10.18,0:23:12.14,Default,,0,0,0,,Сіз көрші бөлімшелерді толық пайдалануға еркінсіз.
Dialogue: 0,0:23:12.23,0:23:13.35,Default,,0,0,0,,Айтпақшы
Dialogue: 0,0:23:13.44,0:23:17.11,Default,,0,0,0,,Бұл үйде бір маңызды ереже бар.
Dialogue: 0,0:23:17.19,0:23:19.65,Default,,0,0,0,,Қазір есіңе түсір, жарай ма?
Dialogue: 0,0:23:20.57,0:23:24.20,Default,,0,0,0,,Қандай жағдай болмасын, ешқашан мандраканы қолданбаңыз⸺
Dialogue: 0,0:23:24.28,0:23:26.66,Default,,0,0,0,,Қиындық тудыратын ештеңе жасамаңыз.
Dialogue: 0,0:23:26.74,0:23:28.83,Default,,0,0,0,,Мандраке?
Dialogue: 0,0:23:28.91,0:23:32.16,Default,,0,0,0,,Басында мүйізді қарияны айтасыз ба?
Dialogue: 0,0:23:32.25,0:23:34.37,Default,,0,0,0,,Мүйіздер жоқ!
Dialogue: 0,0:23:35.29,0:23:36.58,Default,,0,0,0,,(тыныс алу дыбысы)
Dialogue: 0,0:23:36.67,0:23:39.13,Default,,0,0,0,,Негізінен.
Dialogue: 0,0:23:39.75,0:23:43.68,Default,,0,0,0,,Мен ашуланып, ашуланғанда ғана өседі.
Dialogue: 0,0:23:43.76,0:23:46.76,Default,,0,0,0,,Қарт ашуланғанда тағы не болады?
Dialogue: 0,0:23:47.80,0:23:50.85,Default,,0,0,0,,Иә...
Dialogue: 0,0:23:50.93,0:23:53.81,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:23:54.77,0:23:57.69,Default,,0,0,0,,Егер бақытыңыз болса, білмейсіз.
Dialogue: 0,0:23:58.61,0:24:01.19,Default,,0,0,0,,Жүр, жұмысқа кірісейік.
Dialogue: 0,0:24:12.20,0:24:15.71,Default,,0,0,0,,Әй, апа, мына ұнтақты не үшін қолданасыз?
Dialogue: 0,0:24:16.33,0:24:18.38,Default,,0,0,0,,Сен мұнымен сиқыр жасай аласың ба?
Dialogue: 0,0:24:18.46,0:24:21.21,Default,,0,0,0,,Ұсақталғанша ұнтақтаңыз.
Dialogue: 0,0:24:21.30,0:24:23.76,Default,,0,0,0,,Ұннан көп
Dialogue: 0,0:24:23.84,0:24:26.76,Default,,0,0,0,,Ей, қандай сиқыр? Оны кім пайдаланады?
Dialogue: 0,0:24:26.84,0:24:29.22,Default,,0,0,0,,Апай? Әлде ағай?
Dialogue: 0,0:24:29.80,0:24:32.22,Default,,0,0,0,,Аузыңды емес, қолыңды пайдалан, ақымақ!
Dialogue: 0,0:24:34.64,0:24:36.31,Default,,0,0,0,,Хмм!
Dialogue: 0,0:24:36.39,0:24:37.65,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:24:38.31,0:24:39.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:40.82,0:24:42.73,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:24:50.20,0:24:52.08,Default,,0,0,0,,Ой, бұл қызық
Dialogue: 0,0:24:52.16,0:24:55.12,Default,,0,0,0,,Мен саған қолыңды қозғама дедім!
Dialogue: 0,0:24:55.21,0:24:57.25,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:24:58.37,0:25:02.05,Default,,0,0,0,,Мына жерде таныс бар...
Dialogue: 0,0:25:02.13,0:25:04.84,Default,,0,0,0,,Томас, сенің кезегің!
Dialogue: 0,0:25:06.84,0:25:08.38,Default,,0,0,0,,Анчоко?
Dialogue: 0,0:25:12.51,0:25:13.22,Default,,0,0,0,,(Мысықтың дауысы)
Dialogue: 0,0:25:13.31,0:25:14.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:22.94,0:25:23.78,Default,,0,0,0,,(Томастың айқайы)
Dialogue: 0,0:25:23.86,0:25:24.98,Default,,0,0,0,,(Телефон дыбысы)
Dialogue: 0,0:25:25.07,0:25:26.32,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:25:27.95,0:25:29.36,Default,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:25:29.45,0:25:30.45,Default,,0,0,0,,Ах
Dialogue: 0,0:25:32.08,0:25:33.24,Default,,0,0,0,,О, ханым?
Dialogue: 0,0:25:33.95,0:25:36.16,Default,,0,0,0,,Иә, мен Бела Ягамын.
Dialogue: 0,0:25:36.25,0:25:36.96,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:25:37.04,0:25:39.25,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:25:39.33,0:25:42.17,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:25:42.25,0:25:43.75,Default,,0,0,0,,Иә Иә…
Dialogue: 0,0:25:44.42,0:25:45.96,Default,,0,0,0,,Немерең...
Dialogue: 0,0:25:47.38,0:25:49.26,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:25:49.84,0:25:52.55,Default,,0,0,0,,«Ит шоуында жеңіске жету үшін жазу»?
Dialogue: 0,0:25:52.64,0:25:54.76,Default,,0,0,0,,О, әрине.
Dialogue: 0,0:25:54.85,0:25:59.52,Default,,0,0,0,,«Балет рециталындағы басты рөлді алып тастау емлесі»
Dialogue: 0,0:25:59.60,0:26:00.77,Default,,0,0,0,,...Дұрыс.
Dialogue: 0,0:26:00.85,0:26:03.73,Default,,0,0,0,,Охохохохо маған қалдырыңызшы
Dialogue: 0,0:26:03.82,0:26:07.61,Default,,0,0,0,,«Көрші бақшадағы гүлгүлді өлтіруге арналған сиқыр»
Dialogue: 0,0:26:09.28,0:26:12.62,Default,,0,0,0,,«Көшедегі балаға дәрі»?
Dialogue: 0,0:26:12.70,0:26:15.62,Default,,0,0,0,,Бұлардың ешқайсысы пайдалы емес сияқты.
Dialogue: 0,0:26:15.70,0:26:17.62,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:26:18.75,0:26:21.21,Default,,0,0,0,,Мен оны сізге бірден әкелемін. Иә.
Dialogue: 0,0:26:21.29,0:26:23.63,Default,,0,0,0,,Қайырлы күн
Dialogue: 0,0:26:28.38,0:26:30.13,Default,,0,0,0,,Томас!
Dialogue: 0,0:26:30.72,0:26:31.63,Default,,0,0,0,,Томас!
Dialogue: 0,0:26:32.26,0:26:35.72,Default,,0,0,0,,Тыңдамасаң, құрт жегіземін!
Dialogue: 0,0:26:37.60,0:26:38.27,Default,,0,0,0,,Томас!
Dialogue: 0,0:26:38.85,0:26:39.77,Default,,0,0,0,,Томас!
Dialogue: 0,0:26:40.35,0:26:41.77,Default,,0,0,0,,Томас!
Dialogue: 0,0:26:41.85,0:26:44.27,Default,,0,0,0,,Томас…
Dialogue: 0,0:26:46.36,0:26:49.28,Default,,0,0,0,,Өзіңіз шығарған жынды күшке ие болу үшін пайдаланыңыз.
Dialogue: 0,0:26:49.36,0:26:51.74,Default,,0,0,0,,Әйел өзінің үй жануары Көкнәр итіне қамқорлық жасайды.
Dialogue: 0,0:26:51.82,0:26:54.28,Default,,0,0,0,,Маған ит шоуында жеңіске жетуге рұқсат етіңіз
Dialogue: 0,0:26:56.37,0:26:56.91,Default,,0,0,0,,Уф... (Томас ырылдап)
Dialogue: 0,0:26:56.99,0:26:57.70,Default,,0,0,0,,Квинтеле Күн
Dialogue: 0,0:26:57.79,0:27:01.00,Default,,0,0,0,,Pterepteria Sun Kwintere
Dialogue: 0,0:27:01.08,0:27:05.29,Default,,0,0,0,,Qvunturus Bresten Brestemur Qvante
Dialogue: 0,0:27:05.38,0:27:06.79,Default,,0,0,0,,Квинтеле Күн
Dialogue: 0,0:27:06.88,0:27:09.30,Default,,0,0,0,,Pterepteria Sun Kwintere
Dialogue: 0,0:27:09.38,0:27:13.84,Default,,0,0,0,,Qvunturus Bresten Brestemur Qvante
Dialogue: 0,0:27:19.81,0:27:21.18,Default,,0,0,0,,Күлгін гүлінің иісі
Dialogue: 0,0:27:24.15,0:27:25.81,Default,,0,0,0,,Маған мылқаулықпен қарама!
Dialogue: 0,0:27:25.90,0:27:28.32,Default,,0,0,0,,Кешке дейін қандай жұмыс істеу керек?
Dialogue: 0,0:27:28.40,0:27:29.82,Default,,0,0,0,,Олар өте көп.
Dialogue: 0,0:27:33.82,0:27:35.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:36.16,0:27:39.58,Default,,0,0,0,,(радиодан дүниежүзілік ауа райы болжамы)
Dialogue: 0,0:27:43.46,0:27:45.08,Default,,0,0,0,,Келіңдер, жындар
Dialogue: 0,0:27:45.17,0:27:46.58,Default,,0,0,0,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,0:27:46.67,0:27:49.59,Default,,0,0,0,,Маған бүгін не әкелдің деп қызық.
Dialogue: 0,0:27:51.59,0:27:53.26,Default,,0,0,0,,Сток-он-Трент станциясы⸺
Dialogue: 0,0:27:53.34,0:27:57.01,Default,,0,0,0,,Асханадан алған пирог пен картоп.
Dialogue: 0,0:27:57.68,0:28:01.56,Default,,0,0,0,,Вокзалдағы бәліш... мен жек көретінім осы.
Dialogue: 0,0:28:02.31,0:28:03.60,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:28:03.69,0:28:04.73,Default,,0,0,0,,Хмм…
Dialogue: 0,0:28:04.81,0:28:05.73,Default,,0,0,0,,(Мандраке ырылдады)
Dialogue: 0,0:28:05.81,0:28:06.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:28:06.90,0:28:08.82,Default,,0,0,0,,Бұл менің сүйікті тағамым.
Dialogue: 0,0:28:12.32,0:28:14.82,Default,,0,0,0,,Мен станция пирогтарын жақсы көремін!
Dialogue: 0,0:28:14.90,0:28:16.49,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:28:24.58,0:28:27.50,Default,,0,0,0,,Әпкеңді тыңдамас бұрын
Dialogue: 0,0:28:27.58,0:28:29.34,Default,,0,0,0,,Е
Dialogue: 0,0:28:29.42,0:28:31.42,Default,,0,0,0,,Мен өзімді қорғауым керек.
Dialogue: 0,0:28:31.50,0:28:32.80,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:28:35.84,0:28:39.76,Default,,0,0,0,,Жарайды, ұстай алмасаң, қашып кете аласың.
Dialogue: 0,0:28:40.60,0:28:44.18,Default,,0,0,0,,Бұл шұғыл тапсырыс және маған өте қажет.
Dialogue: 0,0:28:44.77,0:28:46.52,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:28:46.60,0:28:48.90,Default,,0,0,0,,Олай болса, мен сенен көмек сұрадым.
Dialogue: 0,0:28:58.36,0:28:59.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:59.87,0:29:01.37,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:29:25.27,0:29:29.44,Default,,0,0,0,,(орган музыкасы)
Dialogue: 0,0:29:42.37,0:29:43.87,Default,,0,0,0,,Роман?
Dialogue: 0,0:29:44.62,0:29:47.41,Default,,0,0,0,,Хмм...?
Dialogue: 0,0:29:47.50,0:29:49.58,Default,,0,0,0,,Бұл не? Бұл қызықсыз
Dialogue: 0,0:29:49.67,0:29:52.08,Default,,0,0,0,,Мен оны қайта жазайын ба?
Dialogue: 0,0:29:52.84,0:29:55.42,Default,,0,0,0,,Itter…
Dialogue: 0,0:29:55.51,0:29:57.05,Default,,0,0,0,,Уф
Dialogue: 0,0:29:57.13,0:29:57.97,Default,,0,0,0,,(айқай)
Dialogue: 0,0:29:58.05,0:29:59.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:00.18,0:30:01.01,Default,,0,0,0,,Бұл!
Dialogue: 0,0:30:02.51,0:30:04.60,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:30:07.68,0:30:08.68,Default,,0,0,0,,Ах
Dialogue: 0,0:30:10.48,0:30:12.06,Default,,0,0,0,,(Жындардың айқайы)
Dialogue: 0,0:30:15.44,0:30:17.28,Default,,0,0,0,,(Аяның ентігуі)
Dialogue: 0,0:30:17.36,0:30:19.32,Default,,0,0,0,,Жарайды, келесі!
Dialogue: 0,0:30:25.37,0:30:26.33,Default,,0,0,0,,Уф!
Dialogue: 0,0:30:29.62,0:30:30.37,Default,,0,0,0,,(дем шығару дыбысы)
Dialogue: 0,0:30:30.46,0:30:31.50,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:30:40.51,0:30:41.84,Default,,0,0,0,,Уф
Dialogue: 0,0:30:41.93,0:30:43.85,Default,,0,0,0,,Уккук... Уккук...
Dialogue: 0,0:30:43.93,0:30:46.26,Default,,0,0,0,,(Темір есіктің ашылған дыбысы)
Dialogue: 0,0:31:05.70,0:31:07.62,Default,,0,0,0,,«Құлақ»?
Dialogue: 0,0:31:12.00,0:31:13.25,Default,,0,0,0,,Пухар
Dialogue: 0,0:31:14.46,0:31:15.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:18.38,0:31:19.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:19.80,0:31:21.92,Default,,0,0,0,,​​О... не?
Dialogue: 0,0:31:22.01,0:31:23.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:25.09,0:31:28.14,Default,,0,0,0,,Алдыңғы есік жоғалып кетті ме?
Dialogue: 0,0:31:28.68,0:31:30.47,Default,,0,0,0,,(терезені ашуға тырысқан дыбыс)
Dialogue: 0,0:31:30.56,0:31:33.60,Default,,0,0,0,,(Аяның күшті дауысы)
Dialogue: 0,0:31:34.31,0:31:37.73,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:31:37.82,0:31:38.61,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:31:40.28,0:31:42.24,Default,,0,0,0,,Қабырғаға жабысу
Dialogue: 0,0:31:48.08,0:31:49.87,Default,,0,0,0,,(Жынның ұшып бара жатқан дыбысы)
Dialogue: 0,0:31:55.71,0:31:58.63,Default,,0,0,0,,«Құлақ»
Dialogue: 0,0:32:00.80,0:32:04.59,Default,,0,0,0,,Қарғыс атсын... Мен мүлде қамалып қалдым.
Dialogue: 0,0:32:12.27,0:32:15.23,Default,,0,0,0,,Бұл менің бірінші рет жалғыз ұйықтауым болуы мүмкін.
Dialogue: 0,0:32:21.73,0:32:24.20,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:32:26.99,0:32:29.66,Default,,0,0,0,,Оян! жалқау!
Dialogue: 0,0:32:39.17,0:32:43.05,Default,,0,0,0,,Өйткені, оны менен басқа ешкім қолданбайды.
Dialogue: 0,0:32:49.05,0:32:51.43,Default,,0,0,0,,Аа, жуынатын бөлме менікі.
Dialogue: 0,0:33:04.90,0:33:06.86,Default,,0,0,0,,Мен саған мұқият қарап тұрмын.
Dialogue: 0,0:33:06.95,0:33:10.37,Default,,0,0,0,,Ақырында маған таңғы ас әзірлеп берейін.
Dialogue: 0,0:33:10.45,0:33:11.83,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:33:12.99,0:33:15.62,Default,,0,0,0,,Әй, апаң қайда ұйықтап жатыр?
Dialogue: 0,0:33:15.71,0:33:17.37,Default,,0,0,0,,Мен өз бөлмемді таба алмай жатырмын.
Dialogue: 0,0:33:17.46,0:33:20.88,Default,,0,0,0,,Хмф, тым көп тартпаңыз.
Dialogue: 0,0:33:20.96,0:33:24.88,Default,,0,0,0,,Тыңдамасаң, апа, маған не істейсің?
Dialogue: 0,0:33:25.46,0:33:26.63,Default,,0,0,0,,(пісіру дыбысы)
Dialogue: 0,0:33:27.59,0:33:30.14,Default,,0,0,0,,Мен саған жауын құрттарын тамақтандырамын
Dialogue: 0,0:33:31.35,0:33:35.14,Default,,0,0,0,,Гунегуне такуру көк және күлгін
Dialogue: 0,0:33:35.22,0:33:38.14,Default,,0,0,0,,Бұл үлкен жігіт.
Dialogue: 0,0:33:38.73,0:33:39.94,Default,,0,0,0,,әйелдерді нысанаға алған қанды қырғын жылдары
Dialogue: 0,0:33:47.86,0:33:50.16,Default,,0,0,0,,Мен бақсы болсам да, кір жуғыш машинаны қолданамын.
Dialogue: 0,0:33:50.95,0:33:52.62,Default,,0,0,0,,Шатаспаңыз
Dialogue: 0,0:33:52.70,0:33:55.16,Default,,0,0,0,,Тез, қалақай толы себетті ал.
Dialogue: 0,0:33:56.62,0:33:57.46,Default,,0,0,0,,Хмф!
Dialogue: 0,0:33:57.54,0:33:58.16,Default,,0,0,0,,Ах
Dialogue: 0,0:33:59.75,0:34:02.42,Default,,0,0,0,,Иә, ой... жақсы ату.
Dialogue: 0,0:34:05.09,0:34:07.17,Default,,0,0,0,,Итата!
Dialogue: 0,0:34:07.26,0:34:08.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:34:08.63,0:34:10.97,Default,,0,0,0,,Ол жерден қашып құтыла алмайсың.
Dialogue: 0,0:34:11.05,0:34:11.80,Default,,0,0,0,,Уф
Dialogue: 0,0:34:13.35,0:34:14.64,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:34:15.77,0:34:17.60,Default,,0,0,0,,Ал, мандраке.
Dialogue: 0,0:34:17.68,0:34:20.19,Default,,0,0,0,,Менде жындар бар!
Dialogue: 0,0:34:20.77,0:34:22.19,Default,,0,0,0,,Сонымен... иә хехе
Dialogue: 0,0:34:22.27,0:34:23.98,Default,,0,0,0,,Ахахаха!
Dialogue: 0,0:34:24.07,0:34:26.11,Default,,0,0,0,,Мандрака туралы да.
Dialogue: 0,0:34:26.19,0:34:29.20,Default,,0,0,0,,Сіз оны жақсы басқара білуіңіз керек.
Dialogue: 0,0:34:29.28,0:34:30.53,Default,,0,0,0,,Уф!
Dialogue: 0,0:34:30.61,0:34:31.16,Default,,0,0,0,,(жынның қозғалған дыбысы)
Dialogue: 0,0:34:31.24,0:34:32.20,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:34:32.28,0:34:34.20,Default,,0,0,0,,(араластырғыш дыбысы)
Dialogue: 0,0:34:36.37,0:34:40.21,Default,,0,0,0,,Ей, бос тұрма, тез оюды баста!
Dialogue: 0,0:34:42.63,0:34:46.21,Default,,0,0,0,,Сәлем, апай! Бұл қандай сиқыр үшін қолданылады?
Dialogue: 0,0:34:47.59,0:34:48.96,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:34:50.72,0:34:53.22,Default,,0,0,0,,Сол нәрсені тез аяқтаңыз.
Dialogue: 0,0:34:53.30,0:34:55.30,Default,,0,0,0,,Сонда маған айтасың ба?
Dialogue: 0,0:34:55.81,0:34:59.14,Default,,0,0,0,,Дайын болғаннан кейін Bryonia жемісін ұсақтаңыз.
Dialogue: 0,0:35:01.27,0:35:02.31,Default,,0,0,0,,Қолмен.
Dialogue: 0,0:35:02.81,0:35:04.23,Default,,0,0,0,,Қолдарыңызбен...
Dialogue: 0,0:35:10.24,0:35:13.78,Default,,0,0,0,,Орындалды! Әй, апа, маған сиқыр үйретіңізші.
Dialogue: 0,0:35:14.32,0:35:17.74,Default,,0,0,0,,Аулаға барып, ошағандарды ал.
Dialogue: 0,0:35:18.33,0:35:19.66,Default,,0,0,0,,Тез орындаңыз
Dialogue: 0,0:35:20.33,0:35:23.25,Default,,0,0,0,,(Жақсы қарқынды музыка)
Dialogue: 0,0:35:23.83,0:35:26.34,Default,,0,0,0,,Тікен неге көп!
Dialogue: 0,0:35:28.09,0:35:29.34,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:35:30.13,0:35:32.26,Default,,0,0,0,,Қалақай жетпейді.
Dialogue: 0,0:35:33.18,0:35:34.76,Default,,0,0,0,,Қалақай алыңыз
Dialogue: 0,0:35:34.84,0:35:38.81,Default,,0,0,0,,Тағы да? Маған сиқырды қашан үйретесің?
Dialogue: 0,0:35:39.64,0:35:42.89,Default,,0,0,0,,«Қайтадан» деген не?
Dialogue: 0,0:35:42.98,0:35:46.40,Default,,0,0,0,,Ал мен себет толы бұталарды аламын.
Dialogue: 0,0:35:46.48,0:35:47.94,Default,,0,0,0,,Тез жүр!
Dialogue: 0,0:35:50.03,0:35:52.28,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:35:57.87,0:36:00.29,Default,,0,0,0,,24 дана жылан терісі жыртылған
Dialogue: 0,0:36:00.37,0:36:01.45,Default,,0,0,0,,Маған сиқырды үйрет
Dialogue: 0,0:36:01.54,0:36:05.29,Default,,0,0,0,,Белладоннаның 120 жапырағын алыңыз.
Dialogue: 0,0:36:06.54,0:36:07.96,Default,,0,0,0,,Томас!
Dialogue: 0,0:36:08.04,0:36:08.88,Default,,0,0,0,,Хмф!
Dialogue: 0,0:36:15.05,0:36:16.30,Default,,0,0,0,,Әй!
Dialogue: 0,0:36:16.39,0:36:18.43,Default,,0,0,0,,Мынаны да жуу керек.
Dialogue: 0,0:36:18.51,0:36:20.06,Default,,0,0,0,,Ол да.
Dialogue: 0,0:36:22.64,0:36:25.56,Default,,0,0,0,,Барлығы раковинада.
Dialogue: 0,0:36:26.15,0:36:27.73,Default,,0,0,0,,Барлығы.
Dialogue: 0,0:36:28.98,0:36:30.07,Default,,0,0,0,,Біз...
Dialogue: 0,0:36:37.20,0:36:38.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:38.66,0:36:42.08,Default,,0,0,0,,Сіз не қарап тұрсыз? Тез бітір.
Dialogue: 0,0:36:42.16,0:36:45.08,Default,,0,0,0,,Ей, маған да рұқсат етіңізші!
Dialogue: 0,0:36:45.16,0:36:48.58,Default,,0,0,0,,Сізге тек айтқаныңызды орындау керек!
Dialogue: 0,0:36:49.88,0:36:53.05,Default,,0,0,0,,(телефон шырылдауы)
Dialogue: 0,0:36:53.13,0:36:54.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:57.01,0:36:57.55,Default,,0,0,0,,Хун
Dialogue: 0,0:36:57.64,0:36:58.47,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:36:58.55,0:36:59.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:37:01.51,0:37:03.27,Default,,0,0,0,,Хмм…
Dialogue: 0,0:37:03.35,0:37:06.10,Default,,0,0,0,,Дәл сол ханым!
Dialogue: 0,0:37:06.19,0:37:09.61,Default,,0,0,0,,Маған сиқыр үйретейін деген ниетіңіз жоқ.
Dialogue: 0,0:37:11.82,0:37:14.57,Default,,0,0,0,,Сіз мені шақырып жатырсыз ба, сэр?
Dialogue: 0,0:37:15.19,0:37:18.53,Default,,0,0,0,,Маған табақты беріңіз, Уинтерфорд.
Dialogue: 0,0:37:19.57,0:37:22.45,Default,,0,0,0,,Сізге көп рахмет, ұстаз.
Dialogue: 0,0:37:25.20,0:37:26.62,Default,,0,0,0,,А...
Dialogue: 0,0:37:27.41,0:37:30.21,Default,,0,0,0,,Бүгін түнде бізде Silver Hines балық пен чипсы бар.
Dialogue: 0,0:37:30.29,0:37:32.00,Default,,0,0,0,,Барып алыңыз.
Dialogue: 0,0:37:32.09,0:37:33.75,Default,,0,0,0,,Сіз айтқандай
Dialogue: 0,0:37:37.22,0:37:39.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:43.93,0:37:46.60,Default,,0,0,0,,Сиқыр шынымен жаман
Dialogue: 0,0:37:51.98,0:37:54.36,Default,,0,0,0,,Керемет мандрака...
Dialogue: 0,0:37:54.86,0:37:55.90,Default,,0,0,0,,Ах
Dialogue: 0,0:38:00.16,0:38:01.45,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:38:02.95,0:38:07.41,Default,,0,0,0,,Жындарды тек мандрактер басқара алады, солай ма?
Dialogue: 0,0:38:09.71,0:38:13.75,Default,,0,0,0,,Бәлкім, мандрака сияқты өмір сүрген шығармын.
Dialogue: 0,0:38:14.42,0:38:17.38,Default,,0,0,0,,Мен сұраған кезде қалағанымды жей алатынмын.
Dialogue: 0,0:38:18.80,0:38:22.55,Default,,0,0,0,,«Мен бүгін кешке баланың үйінен қойшы бәлішін аламын».
Dialogue: 0,0:38:23.72,0:38:25.56,Default,,0,0,0,,«Иә, капитан»
Dialogue: 0,0:38:26.97,0:38:28.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:35.98,0:38:37.61,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:38:37.69,0:38:40.03,Default,,0,0,0,,Мен Кстардпен кездескім келеді
Dialogue: 0,0:38:43.07,0:38:46.08,Default,,0,0,0,,Менің айтқым келетін нәрселер өте көп...
Dialogue: 0,0:38:51.58,0:38:53.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:53.79,0:38:55.21,Default,,0,0,0,,(Шинобу) Мұнда кездейсоқ біреуді білетін адам бар ма?
Dialogue: 0,0:38:56.71,0:38:58.26,Default,,0,0,0,,Томас?
Dialogue: 0,0:39:04.51,0:39:09.77,Default,,0,0,0,,Сол кемпірдің бізге пайдалануы қиын ғой, солай емес пе? Қаймақ
Dialogue: 0,0:39:10.43,0:39:11.27,Default,,0,0,0,,(Томастың айқайы)
Dialogue: 0,0:39:11.85,0:39:13.90,Default,,0,0,0,,Томас емес пе?
Dialogue: 0,0:39:13.98,0:39:16.90,Default,,0,0,0,,Өйткені сіз қаймақ сияқтысыз.
Dialogue: 0,0:39:17.44,0:39:19.40,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:39:23.36,0:39:28.20,Default,,0,0,0,,♪~ «Маған кедергі жасама»
Dialogue: 0,0:39:42.38,0:39:46.72,Default,,0,0,0,,♪ Тәтті ыстығы тоқырауға ұшыраған жаз түні
Dialogue: 0,0:39:47.35,0:39:48.43,Default,,0,0,0,,Уау
Dialogue: 0,0:39:48.51,0:39:49.26,Default,,0,0,0,,(Boombox музыкасы)
Dialogue: 0,0:39:49.35,0:39:51.23,Default,,0,0,0,,Бұл жақсы қаймақ
Dialogue: 0,0:39:51.89,0:39:53.23,Default,,0,0,0,,Иә!
Dialogue: 0,0:39:53.31,0:39:56.48,Default,,0,0,0,,♪~ «Маған кедергі жасама»
Dialogue: 0,0:40:00.28,0:40:02.61,Default,,0,0,0,,Қараңызшы, қаймақ.
Dialogue: 0,0:40:02.69,0:40:05.74,Default,,0,0,0,,Уфуфуфуфу… хефуфу
Dialogue: 0,0:40:05.82,0:40:09.20,Default,,0,0,0,,(Аяның радио кассета ойнатқышымен бірге ызылдағаны)
Dialogue: 0,0:40:16.42,0:40:19.17,Default,,0,0,0,,Қайырлы таң апа, қандай тамаша таң.
Dialogue: 0,0:40:19.25,0:40:23.05,Default,,0,0,0,,Бүгіннен бастап сіз кір жуатын боласыз!
Dialogue: 0,0:40:25.97,0:40:27.89,Default,,0,0,0,,23…
Dialogue: 0,0:40:28.93,0:40:31.27,Default,,0,0,0,,24…
Dialogue: 0,0:40:31.85,0:40:34.02,Default,,0,0,0,,25…
Dialogue: 0,0:40:35.27,0:40:37.27,Default,,0,0,0,,24…
Dialogue: 0,0:40:39.11,0:40:41.32,Default,,0,0,0,,Нижу... Са...
Dialogue: 0,0:40:41.40,0:40:43.53,Default,,0,0,0,,Иә? Неше жаста?
Dialogue: 0,0:40:43.61,0:40:46.78,Default,,0,0,0,,Мұқият қабылдамасаң, сені жауын құрт жазалайды!
Dialogue: 0,0:40:46.86,0:40:50.28,Default,,0,0,0,,Тіпті кемпірдің де қолынан келеді!
Dialogue: 0,0:40:50.95,0:40:55.79,Default,,0,0,0,,Сіз көрегенсіз. Сіз соншалықты кішкентай нәрсені көре аласыз ба?
Dialogue: 0,0:40:56.37,0:40:58.29,Default,,0,0,0,,Басшымен бірдей.
Dialogue: 0,0:40:59.08,0:41:02.50,Default,,0,0,0,,Көп айтпа, Тритонның көз алмасы біткен соң.
Dialogue: 0,0:41:02.59,0:41:03.30,Default,,0,0,0,,Тұзды ұсақтау
Dialogue: 0,0:41:04.17,0:41:05.97,Default,,0,0,0,,Миллипед аяқтары
Dialogue: 0,0:41:06.05,0:41:07.63,Default,,0,0,0,,Рододендрон тұқымдары
Dialogue: 0,0:41:07.72,0:41:09.55,Default,,0,0,0,,Егеуқұйрықтың тырнағы
Dialogue: 0,0:41:09.64,0:41:11.05,Default,,0,0,0,,Барлығы санайды
Dialogue: 0,0:41:11.89,0:41:14.52,Default,,0,0,0,,Ойсыз болсаң қасыңа жауын құрт келеді!
Dialogue: 0,0:41:17.64,0:41:20.06,Default,,0,0,0,,(Радиокасеталық музыка және жаңбыр дыбысы)
Dialogue: 0,0:41:20.65,0:41:24.07,Default,,0,0,0,,Не! Жауын құрты Жер құрты Жер құрты!
Dialogue: 0,0:41:25.32,0:41:27.57,Default,,0,0,0,,О, қазірдің өзінде! Қарғыс атсын!
Dialogue: 0,0:41:28.24,0:41:31.07,Default,,0,0,0,,Бұл мүйіз емес, есек құлақ!
Dialogue: 0,0:41:31.66,0:41:34.66,Default,,0,0,0,,Ағайдың жүзі ондай емес.
Dialogue: 0,0:41:39.37,0:41:41.25,Default,,0,0,0,,Хмм, бұл басқаша.
Dialogue: 0,0:41:41.34,0:41:44.71,Default,,0,0,0,,(жел тәрізді дыбыс)
Dialogue: 0,0:41:47.51,0:41:48.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:53.10,0:41:54.10,Default,,0,0,0,,Әй!
Dialogue: 0,0:41:57.68,0:41:59.90,Default,,0,0,0,,Не болып жатыр! Бұл!
Dialogue: 0,0:42:00.56,0:42:02.06,Default,,0,0,0,,Бұл мандрака.
Dialogue: 0,0:42:03.36,0:42:06.40,Default,,0,0,0,,Оның бөлмесі осы жерде.
Dialogue: 0,0:42:07.74,0:42:09.61,Default,,0,0,0,,Сіз сөйлеп тұрсыз!
Dialogue: 0,0:42:09.70,0:42:12.95,Default,,0,0,0,,Мен онша сөйлейтін емеспін.
Dialogue: 0,0:42:13.03,0:42:16.12,Default,,0,0,0,,Бұл суретті салуды тоқтату керек.
Dialogue: 0,0:42:16.20,0:42:19.58,Default,,0,0,0,,Өйткені бұл Мандрейкті мазалайтын сияқты.
Dialogue: 0,0:42:22.50,0:42:23.79,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:42:23.88,0:42:24.96,Default,,0,0,0,,Ах
Dialogue: 0,0:42:25.05,0:42:27.13,Default,,0,0,0,,Эй, сен заклинание туралы бірдеңе білесің бе?
Dialogue: 0,0:42:27.84,0:42:31.51,Default,,0,0,0,,Иә, мен сенен артық білетін шығармын.
Dialogue: 0,0:42:31.59,0:42:34.43,Default,,0,0,0,,Мен оның кітабын ақтарып отырғаныңды көрдім.
Dialogue: 0,0:42:35.22,0:42:39.14,Default,,0,0,0,,Мүмкін сіз ең көп білгіңіз келетін заклинание соңына жақын шығар.
Dialogue: 0,0:42:39.23,0:42:41.31,Default,,0,0,0,,Қайсысын айтайын ба?
Dialogue: 0,0:42:41.40,0:42:43.15,Default,,0,0,0,,Иә! өтінемін!
Dialogue: 0,0:42:45.07,0:42:48.49,Default,,0,0,0,,Бірақ сәл күте тұрыңыз, мандрака бөлмесі бар ма?
Dialogue: 0,0:42:48.57,0:42:50.65,Default,,0,0,0,,Бұл шындық болуы мүмкін емес, солай ма?
Dialogue: 0,0:42:50.74,0:42:52.49,Default,,0,0,0,,Мұнда жуынатын бөлме бар.
Dialogue: 0,0:42:52.57,0:42:56.24,Default,,0,0,0,,Иә, білемін, бірақ бар.
Dialogue: 0,0:42:57.08,0:42:57.83,Default,,0,0,0,,Хмм.
Dialogue: 0,0:42:58.41,0:42:59.62,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:43:00.91,0:43:04.13,Default,,0,0,0,,(Бела Яганың қорылдауы)
Dialogue: 0,0:43:08.46,0:43:09.09,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:43:09.17,0:43:10.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:43:12.38,0:43:14.22,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:43:16.97,0:43:19.47,Default,,0,0,0,,(Каминари дыбысы)
Dialogue: 0,0:43:19.56,0:43:22.73,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:43:28.98,0:43:31.24,Default,,0,0,0,,Бұл жиіркенішті!
Dialogue: 0,0:43:31.32,0:43:34.24,Default,,0,0,0,,Тынш! Тек кейінірек жалап тазалаңыз.
Dialogue: 0,0:43:34.82,0:43:36.74,Default,,0,0,0,,Жалау...
Dialogue: 0,0:43:40.62,0:43:42.62,Default,,0,0,0,,Қарашы, сен оны сонда қалдырдың.
Dialogue: 0,0:43:43.79,0:43:46.08,Default,,0,0,0,,Соңғы беттен бұрылу
Dialogue: 0,0:43:46.17,0:43:48.34,Default,,0,0,0,,Мен саған тоқта дегенше.
Dialogue: 0,0:43:50.30,0:43:52.51,Default,,0,0,0,,«Көп жауын құрттарын қалай жасауға болады»?
Dialogue: 0,0:43:52.59,0:43:53.55,Default,,0,0,0,,Сәлем! иә?
Dialogue: 0,0:43:55.22,0:43:56.55,Default,,0,0,0,,Ah “Шіркеу базары⸺”
Dialogue: 0,0:43:56.64,0:44:00.02,Default,,0,0,0,,«Тәртіпсіздікті тудыратын дауылды қалай жасауға болады»
Dialogue: 0,0:44:00.10,0:44:03.56,Default,,0,0,0,,«Автобустың уақытында келуі үшін емле»
Dialogue: 0,0:44:03.64,0:44:06.06,Default,,0,0,0,,«Өзіңізді барлық сиқырлардан қорғау үшін емле»
Dialogue: 0,0:44:06.15,0:44:09.07,Default,,0,0,0,,Тоқта! Бізге керегі де сол
Dialogue: 0,0:44:09.65,0:44:13.53,Default,,0,0,0,,Егер біз бұл сиқырды қолдансақ, бақсы бізге тиісе алмайды.
Dialogue: 0,0:44:14.24,0:44:16.37,Default,,0,0,0,,Иә? Бірақ қаймақ...
Dialogue: 0,0:44:16.45,0:44:18.24,Default,,0,0,0,,Томас емес пе?
Dialogue: 0,0:44:18.33,0:44:21.08,Default,,0,0,0,,Жүздеген әртүрлі материалдар бар сияқты.
Dialogue: 0,0:44:21.66,0:44:23.96,Default,,0,0,0,,Олардың барлығы осы бөлменің бір жерінде болуы керек.
Dialogue: 0,0:44:24.04,0:44:26.08,Default,,0,0,0,,Таңға дейін көп уақыт бар.
Dialogue: 0,0:44:26.17,0:44:28.09,Default,,0,0,0,,Бастайық!
Dialogue: 0,0:44:28.84,0:44:33.51,Default,,0,0,0,,Ең алдымен қоңыр егеуқұйрық сүйегінің ұнтағы және тритон көз алмасы.
Dialogue: 0,0:44:33.59,0:44:35.97,Default,,0,0,0,,Ал содан кейін жұқа тілімдерге кесілген бақа бар.
Dialogue: 0,0:44:36.05,0:44:37.93,Default,,0,0,0,,Уау! Хмф
Dialogue: 0,0:44:40.85,0:44:45.35,Default,,0,0,0,,Оны дайындап жатқанда, тауық етін жылытыңыз.
Dialogue: 0,0:44:48.02,0:44:49.82,Default,,0,0,0,,Мысықтың құйрық жүні
Dialogue: 0,0:44:49.90,0:44:52.28,Default,,0,0,0,,Үш бөтелкені бірге жылытуға болады деген сөз бар.
Dialogue: 0,0:44:52.36,0:44:55.03,Default,,0,0,0,,Оны жұлып алғанда жұмсақ болыңыз.
Dialogue: 0,0:44:55.11,0:44:57.03,Default,,0,0,0,,Нгя!
Dialogue: 0,0:44:57.70,0:45:01.54,Default,,0,0,0,,Келесі - белладонна сығындысы, қатардағы төртінші бөтелке.
Dialogue: 0,0:45:02.20,0:45:04.66,Default,,0,0,0,,Тауық басына 3 тамшы тамызыңыз
Dialogue: 0,0:45:04.75,0:45:08.79,Default,,0,0,0,,(жарқын музыка)
Dialogue: 0,0:45:40.41,0:45:42.45,Default,,0,0,0,,(Каминари дыбысы)
Dialogue: 0,0:45:44.54,0:45:46.66,Default,,0,0,0,,(Аяның күшті дауысы)
Dialogue: 0,0:45:51.84,0:45:54.21,Default,,0,0,0,,Таныстарды орын. Бұл жақсы.
Dialogue: 0,0:45:54.30,0:45:56.17,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:45:56.26,0:45:59.26,Default,,0,0,0,,«Цукайма во Хайчи» нені білдіреді?
Dialogue: 0,0:45:59.89,0:46:02.55,Default,,0,0,0,,Бақсыға таныс адам көмектеседі⸺
Dialogue: 0,0:46:02.64,0:46:04.26,Default,,0,0,0,,Бұл мысық сияқты тіршілік иесі туралы.
Dialogue: 0,0:46:04.85,0:46:06.77,Default,,0,0,0,,Закланың дұрыс жұмыс істеуі үшін
Dialogue: 0,0:46:06.85,0:46:10.27,Default,,0,0,0,,Мен таныс адамым жасап жатқан жерге жақын болуым керек.
Dialogue: 0,0:46:10.35,0:46:12.61,Default,,0,0,0,,Айтпақшы...
Dialogue: 0,0:46:12.69,0:46:14.19,Default,,0,0,0,,(Каминари дыбысы)
Dialogue: 0,0:46:14.27,0:46:18.78,Default,,0,0,0,,Қара мысықтардың заклинание жасау қабілеті күшті.
Dialogue: 0,0:46:18.86,0:46:22.28,Default,,0,0,0,,Онда неге үнемі қашуға тырысасың?
Dialogue: 0,0:46:22.37,0:46:25.83,Default,,0,0,0,,Өйткені маған оның жасаған сиқырлары ұнамайды.
Dialogue: 0,0:46:25.91,0:46:28.87,Default,,0,0,0,,Менің шашымды төңкеріп сипап жатқандай.
Dialogue: 0,0:46:29.79,0:46:33.79,Default,,0,0,0,,Аа, араластырып жатқан жасыл заттарға раушанның мәнін қосыңыз.
Dialogue: 0,0:46:35.63,0:46:39.05,Default,,0,0,0,,Барға жуық. Барлығын үлкен ыдысқа салыңыз.
Dialogue: 0,0:46:39.13,0:46:41.80,Default,,0,0,0,,Сөздерді араластыра отырып айту
Dialogue: 0,0:46:41.89,0:46:44.47,Default,,0,0,0,,Сөздер қандай?
Dialogue: 0,0:46:44.55,0:46:45.89,Default,,0,0,0,,Әй!
Dialogue: 0,0:46:45.97,0:46:48.31,Default,,0,0,0,,Бұл жазылмаған! Қандай сөздер!
Dialogue: 0,0:46:48.39,0:46:52.56,Default,,0,0,0,,Тынышталыңыз! Мүмкін бұл сіз қорытынды жасау үшін қолданатын сөз шығар.
Dialogue: 0,0:46:52.65,0:46:56.32,Default,,0,0,0,,Бақсылар қолданатын заттардың шамамен 6 түрі болған...
Dialogue: 0,0:46:56.40,0:46:58.90,Default,,0,0,0,,Есіңізде болсын, қаймақ!
Dialogue: 0,0:46:58.99,0:47:00.32,Default,,0,0,0,,...Томас емес!
Dialogue: 0,0:47:00.40,0:47:02.28,Default,,0,0,0,,Өйткені, мен көп еңбек еттім!
Dialogue: 0,0:47:02.36,0:47:03.82,Default,,0,0,0,,Қараңдар, бәрін есте сақта!
Dialogue: 0,0:47:04.41,0:47:07.70,Default,,0,0,0,,Естіген әрбір сөзді айт!
Dialogue: 0,0:47:07.79,0:47:09.79,Default,,0,0,0,,Түсіндім! Бірақ мен туралы
Dialogue: 0,0:47:09.87,0:47:11.83,Default,,0,0,0,,Мені қаймақ деуді доғар!
Dialogue: 0,0:47:11.92,0:47:15.38,Default,,0,0,0,,Мен айтқан әр сөзді бір-бірлеп айтасың⸺
Dialogue: 0,0:47:15.46,0:47:17.84,Default,,0,0,0,,Қатесіз қайталау керек.
Dialogue: 0,0:47:18.42,0:47:20.59,Default,,0,0,0,,Сіз бақсы ойнап жатырсыз!
Dialogue: 0,0:47:20.67,0:47:21.72,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:47:21.80,0:47:24.97,Default,,0,0,0,,Kvinterea Sun Pterepteria Sun
Dialogue: 0,0:47:25.05,0:47:26.10,Default,,0,0,0,,Квинтере
Dialogue: 0,0:47:26.18,0:47:29.22,Default,,0,0,0,,Kvinterea Sun Pterepteria Sun
Dialogue: 0,0:47:29.31,0:47:30.23,Default,,0,0,0,,Квинтере
Dialogue: 0,0:47:30.31,0:47:33.06,Default,,0,0,0,,Квунтур бу тыныс бре бре...
Dialogue: 0,0:47:33.14,0:47:34.69,Default,,0,0,0,,Уня~о
Dialogue: 0,0:47:35.90,0:47:38.65,Default,,0,0,0,,Квунтур Брестен Бле Бле...
Dialogue: 0,0:47:38.73,0:47:40.24,Default,,0,0,0,,Уня~о
Dialogue: 0,0:47:40.32,0:47:43.57,Default,,0,0,0,,Брестемур Эстеун Кванте
Dialogue: 0,0:47:43.66,0:47:46.24,Default,,0,0,0,,Брестемур Эстеун Кванте
Dialogue: 0,0:47:46.32,0:47:47.20,Default,,0,0,0,,(Шықылдаған дыбыс)
Dialogue: 0,0:47:47.28,0:47:48.95,Default,,0,0,0,,Квинтеле Күн
Dialogue: 0,0:47:49.04,0:47:51.25,Default,,0,0,0,,Pterepteria Sun Kwintere
Dialogue: 0,0:47:52.54,0:47:54.46,Default,,0,0,0,,Квунтур Брестен
Dialogue: 0,0:47:54.54,0:47:56.88,Default,,0,0,0,,Брестемур Эстеун Кванте
Dialogue: 0,0:47:56.96,0:47:58.25,Default,,0,0,0,,(отшашу сияқты дыбыс)
Dialogue: 0,0:47:59.09,0:48:00.26,Default,,0,0,0,,Уау
Dialogue: 0,0:48:01.26,0:48:02.72,Default,,0,0,0,,Раушан гүлдерінің иісі!
Dialogue: 0,0:48:04.97,0:48:06.26,Default,,0,0,0,,Не болды?
Dialogue: 0,0:48:06.34,0:48:08.31,Default,,0,0,0,,Жоқ, жай...
Dialogue: 0,0:48:08.39,0:48:10.97,Default,,0,0,0,,Жаңа айтқан сөздерім есімде жоқ.
Dialogue: 0,0:48:11.06,0:48:13.27,Default,,0,0,0,,Шыққан қара сөздерді де қамтыды.
Dialogue: 0,0:48:13.35,0:48:15.19,Default,,0,0,0,,Бұл дұрыс жұмыс істейді деп үміттенемін.
Dialogue: 0,0:48:15.27,0:48:16.48,Default,,0,0,0,,“Уня~о”…
Dialogue: 0,0:48:16.56,0:48:20.28,Default,,0,0,0,,Енді не болады? Мен оны тек денеме жағу керек пе?
Dialogue: 0,0:48:20.36,0:48:23.70,Default,,0,0,0,,Иә, бірақ алдымен оны маған бояуыңызды өтінемін!
Dialogue: 0,0:48:23.78,0:48:26.66,Default,,0,0,0,,Өйткені мен де сен сияқты еңбек еттім.
Dialogue: 0,0:48:26.74,0:48:30.29,Default,,0,0,0,,Ал мен бақсыны бұрын талай рет ашуландырғанмын.
Dialogue: 0,0:48:30.37,0:48:33.87,Default,,0,0,0,,Мені осылай істегенім үшін жауын құрттары жазалап жатыр.
Dialogue: 0,0:48:34.50,0:48:35.79,Default,,0,0,0,,Міне саған – қоштасу сүйісі.
Dialogue: 0,0:48:38.92,0:48:42.26,Default,,0,0,0,,Хе хе уф...
Dialogue: 0,0:48:42.34,0:48:44.13,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:48:44.22,0:48:46.80,Default,,0,0,0,,Ой… нюу… нюу…
Dialogue: 0,0:48:46.89,0:48:47.93,Default,,0,0,0,,Күрсін
Dialogue: 0,0:48:48.51,0:48:51.51,Default,,0,0,0,,Hiiiii…
Dialogue: 0,0:48:51.60,0:48:53.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:48:53.81,0:48:54.98,Default,,0,0,0,,Hii
Dialogue: 0,0:48:55.06,0:48:55.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:48:56.06,0:48:59.31,Default,,0,0,0,,Менің ойымша, бұл ақыр соңында менің денеме батады ма?
Dialogue: 0,0:49:12.66,0:49:14.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:14.62,0:49:15.83,Default,,0,0,0,,Маған қарама!
Dialogue: 0,0:49:16.46,0:49:17.67,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:49:17.75,0:49:18.33,Default,,0,0,0,,Уня!
Dialogue: 0,0:49:24.42,0:49:26.55,Default,,0,0,0,,Уф
Dialogue: 0,0:49:26.63,0:49:28.30,Default,,0,0,0,,Ой, сергіту
Dialogue: 0,0:49:28.97,0:49:31.35,Default,,0,0,0,,Ол дұрыс жұмыс істей ме?
Dialogue: 0,0:49:31.43,0:49:33.39,Default,,0,0,0,,Жұмыс істемесе, қиналып қаламын.
Dialogue: 0,0:49:33.47,0:49:37.06,Default,,0,0,0,,Мен мұны қайта бастан өткергім келмейді.
Dialogue: 0,0:49:46.65,0:49:49.86,Default,,0,0,0,,Мен мұны қайталамас едім
Dialogue: 0,0:49:49.95,0:49:51.87,Default,,0,0,0,,Мүлдем жоқ...
Dialogue: 0,0:49:53.62,0:49:55.25,Default,,0,0,0,,(Аяның ұйқысы)
Dialogue: 0,0:49:55.33,0:49:56.96,Default,,0,0,0,,Оян, ақымақ!
Dialogue: 0,0:49:57.04,0:50:00.67,Default,,0,0,0,,Мандракей бекон мен жұмыртқаны тез пісіре алады!
Dialogue: 0,0:50:01.84,0:50:04.88,Default,,0,0,0,,«Сен үшін жындар жасасын» деп айт.
Dialogue: 0,0:50:04.96,0:50:06.92,Default,,0,0,0,,Не!
Dialogue: 0,0:50:07.01,0:50:08.88,Default,,0,0,0,,Қазір кеттік!
Dialogue: 0,0:50:09.80,0:50:12.39,Default,,0,0,0,,Бірақ мен құл емеспін!
Dialogue: 0,0:50:12.47,0:50:15.06,Default,,0,0,0,,Менің ойымша, дәл солай! Хан!
Dialogue: 0,0:50:15.14,0:50:18.89,Default,,0,0,0,,(Мандраке ырылдады)
Dialogue: 0,0:50:18.98,0:50:22.90,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:50:25.98,0:50:28.86,Default,,0,0,0,,Адамдар туралы: Басқаларға қатал болу...
Dialogue: 0,0:50:28.95,0:50:31.82,Default,,0,0,0,,Мен қазір еске саламын...
Dialogue: 0,0:50:33.37,0:50:34.91,Default,,0,0,0,,Жалқау болма
Dialogue: 0,0:50:34.99,0:50:38.08,Default,,0,0,0,,Қалақай мен жаңа жылдық раушан гүлін ал.
Dialogue: 0,0:50:41.62,0:50:43.29,Default,,0,0,0,,Уф! Бір...
Dialogue: 0,0:50:46.96,0:50:50.01,Default,,0,0,0,,Мен көп қолдандым...
Dialogue: 0,0:50:50.80,0:50:52.80,Default,,0,0,0,,Жаңбыр жауып тұр!
Dialogue: 0,0:50:53.43,0:50:54.55,Default,,0,0,0,,Хмф!
Dialogue: 0,0:50:54.64,0:50:56.31,Default,,0,0,0,,(Жынның айқайы)
Dialogue: 0,0:50:57.93,0:50:59.31,Default,,0,0,0,,(Аяның ауыр тыныс алуы)
Dialogue: 0,0:51:00.06,0:51:02.56,Default,,0,0,0,,Иә, көп ұзамай.
Dialogue: 0,0:51:03.90,0:51:06.48,Default,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:51:13.24,0:51:14.91,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:51:14.99,0:51:18.33,Default,,0,0,0,,Алған шөпті қазанға сал дедім!
Dialogue: 0,0:51:18.41,0:51:20.54,Default,,0,0,0,,Хмм, хмм, хмм, хмм…
Dialogue: 0,0:51:21.92,0:51:24.08,Default,,0,0,0,,Сіз құл емеспіз деп жатырсыз!
Dialogue: 0,0:51:24.17,0:51:26.46,Default,,0,0,0,,Мен сенің көмекшісің боламын, ал апам қасымда болады⸺
Dialogue: 0,0:51:26.54,0:51:28.55,Default,,0,0,0,,Ол маған сиқырды үйретуге уәде берді.
Dialogue: 0,0:51:29.26,0:51:32.76,Default,,0,0,0,,Апай, сіз мені өлгенше пайдаланып жатқан жоқсыз!
Dialogue: 0,0:51:32.84,0:51:35.22,Default,,0,0,0,,Мен мұндай уәде берген жоқпын.
Dialogue: 0,0:51:35.30,0:51:38.68,Default,,0,0,0,,Сені алған себебім қолым жетпейді.
Dialogue: 0,0:51:38.77,0:51:41.14,Default,,0,0,0,,Апай алдап жатыр! Директорға⸺
Dialogue: 0,0:51:41.23,0:51:44.06,Default,,0,0,0,,Менің анам болғым келеді дегеніңмен!
Dialogue: 0,0:51:45.77,0:51:48.19,Default,,0,0,0,,Хмм…
Dialogue: 0,0:51:48.27,0:51:49.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:51.69,0:51:52.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:55.53,0:51:58.70,Default,,0,0,0,,Сенің анаң? Хмф!
Dialogue: 0,0:51:58.79,0:52:02.62,Default,,0,0,0,,Қазанның түбіне қазір жанармай құйыңыз!
Dialogue: 0,0:52:03.21,0:52:05.46,Default,,0,0,0,,Әйтпесе сені жауын құрттары жазалайды.
Dialogue: 0,0:52:19.10,0:52:20.77,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:52:20.85,0:52:23.52,Default,,0,0,0,,Маған сиқырды үйрете аласыз ба?
Dialogue: 0,0:52:23.60,0:52:26.40,Default,,0,0,0,,Мен сізге айтпаймын, солай ма?
Dialogue: 0,0:52:26.48,0:52:29.02,Default,,0,0,0,,Қолым жетпеген соң сені осында алып келдім.
Dialogue: 0,0:52:29.98,0:52:32.99,Default,,0,0,0,,О, мен түсіндім.
Dialogue: 0,0:52:47.54,0:52:51.96,Default,,0,0,0,,(радиодан дүниежүзілік ауа райы болжамы)
Dialogue: 0,0:52:54.55,0:52:58.47,Default,,0,0,0,,Балалар үйі... қойшының пирогы
Dialogue: 0,0:52:59.85,0:53:02.14,Default,,0,0,0,,Бұл менің сүйікті тағамым.
Dialogue: 0,0:53:02.22,0:53:06.35,Default,,0,0,0,,(тыныш фортепиано музыкасы)
Dialogue: 0,0:53:14.74,0:53:16.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:53:18.20,0:53:20.87,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:53:42.39,0:53:43.81,Default,,0,0,0,,Сіз сыпырғышқа барасыз ба?
Dialogue: 0,0:53:44.85,0:53:46.77,Default,,0,0,0,,Хмф! Амал жоқ
Dialogue: 0,0:53:46.85,0:53:50.73,Default,,0,0,0,,Менің барлық тұтынушыларым жақсы адамдар.
Dialogue: 0,0:53:50.81,0:53:54.98,Default,,0,0,0,,Тек «Жер достары» және «Аналар қауымдастығы» мүшелері
Dialogue: 0,0:53:55.49,0:53:58.45,Default,,0,0,0,,Мен барған жерлерім сыпырғышымда
Dialogue: 0,0:53:58.53,0:54:02.58,Default,,0,0,0,,Көршілерім көрсе, жыным келеді.
Dialogue: 0,0:54:02.66,0:54:04.04,Default,,0,0,0,,(Жарық жарылған дыбыс)
Dialogue: 0,0:54:04.12,0:54:04.95,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:54:05.04,0:54:05.91,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:54:06.00,0:54:10.92,Default,,0,0,0,,Енді мына бос сөзді тыңдамай, мен қайтып келгенше бітіріп ал.
Dialogue: 0,0:54:14.00,0:54:18.05,Default,,0,0,0,,Кешкі асты еденде жей алатындай етіп таза ет!
Dialogue: 0,0:54:18.13,0:54:19.76,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:54:26.02,0:54:27.93,Default,,0,0,0,,Томас!
Dialogue: 0,0:54:29.19,0:54:31.85,Default,,0,0,0,,Томас! Бұл қайда!
Dialogue: 0,0:54:31.94,0:54:34.82,Default,,0,0,0,,Бұл не? Мен ұйықтап жатыр едім
Dialogue: 0,0:54:36.11,0:54:38.70,Default,,0,0,0,,Мен демалатын жалғыз уақыт ол далаға шыққанда...
Dialogue: 0,0:54:38.78,0:54:41.57,Default,,0,0,0,,Мен білемін, бірақ маған көмектесіңізші, бар болғаны 5 минутқа.
Dialogue: 0,0:54:41.66,0:54:44.70,Default,,0,0,0,,Ей, біреудің қолын өсіретін тағы бір сиқыры бар ма?
Dialogue: 0,0:54:45.29,0:54:46.49,Default,,0,0,0,,А…?
Dialogue: 0,0:54:46.58,0:54:48.20,Default,,0,0,0,,Дәл солай!
Dialogue: 0,0:54:55.63,0:54:59.72,Default,,0,0,0,,♪~ «Маған кедергі жасама»
Dialogue: 0,0:55:07.22,0:55:08.73,Default,,0,0,0,,Фуфуфуфуфуфуфу…
Dialogue: 0,0:55:14.77,0:55:16.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:17.15,0:55:19.28,Default,,0,0,0,,Жақсы сезім Уфуфуфу...
Dialogue: 0,0:55:22.57,0:55:26.08,Default,,0,0,0,,Ең қиыны - қуыршақтың айналасына орау⸺
Dialogue: 0,0:55:26.16,0:55:29.58,Default,,0,0,0,,Оның шашын қалай аламын?
Dialogue: 0,0:55:29.66,0:55:32.50,Default,,0,0,0,,Оның шашына қол тигізуге рұқсат бермейді.
Dialogue: 0,0:55:32.58,0:55:36.50,Default,,0,0,0,,Жарайды, әйтеуір аламын.
Dialogue: 0,0:55:36.59,0:55:38.55,Default,,0,0,0,,Әлгі келіншек «Менің қолым жетпейді» деді⸺
Dialogue: 0,0:55:38.63,0:55:40.01,Default,,0,0,0,,Тек табанды бол.
Dialogue: 0,0:55:40.63,0:55:43.30,Default,,0,0,0,,Мен сізге міндетті түрде қосымша беремін!
Dialogue: 0,0:55:45.60,0:55:47.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:54.06,0:55:55.69,Default,,0,0,0,,(Дыбыс азаяды)
Dialogue: 0,0:55:55.77,0:55:59.40,Default,,0,0,0,,Кешіріңіз, сәл шу болды ма? Ехе!
Dialogue: 0,0:55:59.98,0:56:02.24,Default,,0,0,0,,Мен сіздің жұмысыңызға кедергі келтірдім бе?
Dialogue: 0,0:56:05.53,0:56:08.03,Default,,0,0,0,,Рахмет! Мен жай ғана қарным ашты.
Dialogue: 0,0:56:11.12,0:56:13.04,Default,,0,0,0,,Әй, аға!
Dialogue: 0,0:56:13.12,0:56:15.54,Default,,0,0,0,,Ағаңыз романшы ма?
Dialogue: 0,0:56:17.04,0:56:18.04,Default,,0,0,0,,Иә.
Dialogue: 0,0:56:18.13,0:56:21.05,Default,,0,0,0,,Уау, керемет! Келесі жолы оқуға рұқсат етіңіз!
Dialogue: 0,0:56:21.67,0:56:22.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:24.38,0:56:25.30,Default,,0,0,0,,(Шықылдаған дыбыс)
Dialogue: 0,0:56:25.39,0:56:26.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:29.18,0:56:30.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:30.64,0:56:32.68,Default,,0,0,0,,Олар қосымша күш әкелді.
Dialogue: 0,0:56:35.73,0:56:39.94,Default,,0,0,0,,Енді бұл қолды денеңіздің қай жеріне қою керек.
Dialogue: 0,0:56:40.02,0:56:42.11,Default,,0,0,0,,Шынтақ ше?
Dialogue: 0,0:56:42.19,0:56:44.40,Default,,0,0,0,,Сіздің тізеңіз ше? Ол жігіт...
Dialogue: 0,0:56:48.20,0:56:51.33,Default,,0,0,0,,Осылайша! тез! Қазір қайттып келемін!
Dialogue: 0,0:56:51.41,0:56:52.41,Default,,0,0,0,,Ей!
Dialogue: 0,0:56:56.12,0:56:57.08,Default,,0,0,0,,Ах
Dialogue: 0,0:57:08.76,0:57:13.68,Default,,0,0,0,,«Маған кедергі жасама»
Dialogue: 0,0:57:13.77,0:57:17.19,Default,,0,0,0,,Бұл үйде ән айтуға тыйым салынған!
Dialogue: 0,0:57:17.77,0:57:19.86,Default,,0,0,0,,Бұл ән қайда еді...
Dialogue: 0,0:57:19.94,0:57:23.53,Default,,0,0,0,,Мына еденді таза деп айта аласың ба, жалқау?
Dialogue: 0,0:57:23.61,0:57:26.70,Default,,0,0,0,,Егер сіз дұрыстап тазаламасаңыз, кешкі асты өткізіп жіберуге тура келеді!
Dialogue: 0,0:57:27.32,0:57:30.20,Default,,0,0,0,,(жеңіл музыка)
Dialogue: 0,0:57:30.83,0:57:34.20,Default,,0,0,0,,Апайдың шашын қалай аламын...
Dialogue: 0,0:57:34.91,0:57:37.21,Default,,0,0,0,,Апайдың бөлмесі қайда?
Dialogue: 0,0:57:38.08,0:57:39.50,Default,,0,0,0,,Мандрейк бөлмесі
Dialogue: 0,0:57:39.58,0:57:42.38,Default,,0,0,0,,Менің бөлмемдегі қабырғаның екінші жағында, солай ма?
Dialogue: 0,0:57:42.46,0:57:43.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:45.47,0:57:46.97,Default,,0,0,0,,Бұл солай емес пе?
Dialogue: 0,0:57:47.05,0:57:49.09,Default,,0,0,0,,Бұл тікенді раушан жүзім бұтасы
Dialogue: 0,0:57:49.18,0:57:52.85,Default,,0,0,0,,Шаштары түспейді, бір-біріне шатасып жатыр.
Dialogue: 0,0:57:52.93,0:57:54.10,Default,,0,0,0,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:57:54.68,0:57:55.89,Default,,0,0,0,,Сәлем
Dialogue: 0,0:58:03.23,0:58:05.61,Default,,0,0,0,,Хмф! Біраз жақсарды
Dialogue: 0,0:58:06.19,0:58:08.07,Default,,0,0,0,,Бөлмеңізге барыңыз!
Dialogue: 0,0:58:08.15,0:58:10.62,Default,,0,0,0,,Кешкі ас бөлмедегі ірімшік пен нан ғана.
Dialogue: 0,0:58:11.32,0:58:15.12,Default,,0,0,0,,Есіңізде болсын, егер сіз жалқау болсаңыз, сіз де солай боласыз.
Dialogue: 0,0:58:21.38,0:58:22.71,Default,,0,0,0,,О, сигналы келіп жатыр, келіп жатыр
Dialogue: 0,0:58:23.84,0:58:25.42,Default,,0,0,0,,Дэймон мырза?
Dialogue: 0,0:58:26.34,0:58:27.76,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:58:30.84,0:58:34.18,Default,,0,0,0,,Әй, мен оны көрерсің деп ойладым.
Dialogue: 0,0:58:34.76,0:58:36.27,Default,,0,0,0,,Уф…
Dialogue: 0,0:58:37.35,0:58:40.94,Default,,0,0,0,,Ағай, сіз шынымен қызықсыз дүниелер жазасыз.
Dialogue: 0,0:58:41.02,0:58:42.69,Default,,0,0,0,,Уақытты босқа кетіру
Dialogue: 0,0:58:44.40,0:58:46.78,Default,,0,0,0,,Әйтеуір апам туралы.
Dialogue: 0,0:58:49.11,0:58:54.28,Default,,0,0,0,,Шашыңызды щеткаңызда шатастырып тастағаныңызға сенімдімін.
Dialogue: 0,0:58:56.54,0:58:57.41,Default,,0,0,0,,Иә...
Dialogue: 0,0:59:01.92,0:59:06.84,Default,,0,0,0,,Ағаңның бөлмесі осы қабырғаның ар жағында болса ше?
Dialogue: 0,0:59:08.42,0:59:10.80,Default,,0,0,0,,Тіпті апамның бөлмесі...
Dialogue: 0,0:59:10.88,0:59:14.22,Default,,0,0,0,,Онда болуы керек...
Dialogue: 0,0:59:14.30,0:59:14.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:16.39,0:59:17.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:17.93,0:59:18.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:23.02,0:59:24.44,Default,,0,0,0,,Хмм?
Dialogue: 0,0:59:24.52,0:59:26.32,Default,,0,0,0,,Уау! Уф
Dialogue: 0,0:59:26.40,0:59:27.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:59:27.98,0:59:28.94,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:59:31.86,0:59:34.78,Default,,0,0,0,,(Мандрейктің ақылсыз ойыны)
Dialogue: 0,0:59:34.87,0:59:36.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:55.64,0:59:57.10,Default,,0,0,0,,(Жынның айқайы)
Dialogue: 0,1:00:01.89,1:00:03.06,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:04.10,1:00:05.15,Default,,0,0,0,,(Музыка тоқтайды)
Dialogue: 0,1:00:05.86,1:00:07.44,Default,,0,0,0,,Бір минут, Ұсуке.
Dialogue: 0,1:00:08.40,1:00:12.65,Default,,0,0,0,,Мен мұны істесем де, апамның шашын ала алмаймын.
Dialogue: 0,1:00:22.75,1:00:24.50,Default,,0,0,0,,Хмм...
Dialogue: 0,1:00:24.58,1:00:25.46,Default,,0,0,0,,Хмф!
Dialogue: 0,1:00:26.75,1:00:29.42,Default,,0,0,0,,Мен сиқырды түсінбеймін
Dialogue: 0,1:00:29.50,1:00:32.97,Default,,0,0,0,,Қандай жағдай болмасын, апайдың сабақ беруіне рұқсат беруім керек.
Dialogue: 0,1:00:33.05,1:00:34.18,Default,,0,0,0,,(роботтық дыбыс)
Dialogue: 0,1:00:35.47,1:00:37.76,Default,,0,0,0,,(Дөрекі қағу дыбысы)
Dialogue: 0,1:00:37.85,1:00:39.14,Default,,0,0,0,,Тез оян!
Dialogue: 0,1:00:39.64,1:00:43.27,Default,,0,0,0,,Мандраке қуырылған нан алғысы келеді!
Dialogue: 0,1:00:50.19,1:00:51.40,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:53.99,1:00:55.78,Default,,0,0,0,,Хмм... Ах!
Dialogue: 0,1:00:57.32,1:00:58.66,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,1:00:58.74,1:01:00.24,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:00.33,1:01:01.66,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,1:01:05.16,1:01:07.17,Default,,0,0,0,,Мен таптым!
Dialogue: 0,1:01:09.75,1:01:12.84,Default,,0,0,0,,Сіз не істеп жатырсыз? Асықшы!
Dialogue: 0,1:01:12.92,1:01:15.30,Default,,0,0,0,,Эй, мен үйдемін!
Dialogue: 0,1:01:15.97,1:01:17.72,Default,,0,0,0,,Қазір қараңыз!
Dialogue: 0,1:01:19.10,1:01:21.97,Default,,0,0,0,,(радиодан дүниежүзілік ауа райы болжамы)
Dialogue: 0,1:01:22.06,1:01:25.52,Default,,0,0,0,,(май шашыраған дыбыс)
Dialogue: 0,1:01:25.60,1:01:26.89,Default,,0,0,0,,(көзілдірік артындағы ұшқынның дыбысы)
Dialogue: 0,1:01:26.98,1:01:29.69,Default,,0,0,0,,(қарқынды гитара музыкасы)
Dialogue: 0,1:01:30.77,1:01:35.57,Default,,0,0,0,,Ууууууу
Dialogue: 0,1:01:42.16,1:01:43.08,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:01:45.16,1:01:48.58,Default,,0,0,0,,Мен бұрын қуырылған нан жасаған емеспін.
Dialogue: 0,1:01:48.67,1:01:49.58,Default,,0,0,0,,Басқаша болды ма?
Dialogue: 0,1:01:50.17,1:01:51.42,Default,,0,0,0,,Әртүрлі
Dialogue: 0,1:01:52.13,1:01:54.59,Default,,0,0,0,,Неге оны қалай жасау керектігін айтпадың?
Dialogue: 0,1:01:54.67,1:01:56.72,Default,,0,0,0,,Өйткені...
Dialogue: 0,1:01:57.84,1:02:01.10,Default,,0,0,0,,Кез келген адам нан пісіру сияқты нәрсені істей алады.
Dialogue: 0,1:02:01.80,1:02:05.81,Default,,0,0,0,,Бұл дұрыс емес. Бұл сізді қайтадан алаңдатпасын!
Dialogue: 0,1:02:07.56,1:02:10.10,Default,,0,0,0,,Мен сізге не істей аламын?
Dialogue: 0,1:02:10.19,1:02:13.02,Default,,0,0,0,,Менің қорқынышты шеберім
Dialogue: 0,1:02:14.11,1:02:15.61,Default,,0,0,0,,Аузыңызды жабыңыз
Dialogue: 0,1:02:16.40,1:02:19.32,Default,,0,0,0,,Оны Epping Forest кемпингінен түсіріңіз.
Dialogue: 0,1:02:19.41,1:02:23.28,Default,,0,0,0,,Маған скауттар жасаған жақсы қуырылған нан әкеліңіз.
Dialogue: 0,1:02:23.37,1:02:26.66,Default,,0,0,0,,Мен ақылдымын, қорқыныштың иесімін.
Dialogue: 0,1:02:29.37,1:02:32.33,Default,,0,0,0,,Уау...
Dialogue: 0,1:02:33.38,1:02:34.38,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:34.46,1:02:36.38,Default,,0,0,0,,(радиодан дүниежүзілік ауа райы болжамы)
Dialogue: 0,1:02:41.80,1:02:42.39,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:46.14,1:02:46.89,Default,,0,0,0,,Иә
Dialogue: 0,1:02:56.36,1:02:58.44,Default,,0,0,0,,Дәл солай⸺
Dialogue: 0,1:02:58.53,1:03:00.11,Default,,0,0,0,,Сіз Мандрейкті ашуландырып жатырсыз!
Dialogue: 0,1:03:00.70,1:03:04.33,Default,,0,0,0,,Сіздің арқаңызда мен қорқынышты жағдайға тап бола жаздадым.
Dialogue: 0,1:03:04.41,1:03:06.24,Default,,0,0,0,,Сонда бәрі болады⸺
Dialogue: 0,1:03:06.33,1:03:07.62,Default,,0,0,0,,Маған мұны істе деп айтпа.
Dialogue: 0,1:03:08.37,1:03:10.92,Default,,0,0,0,,Мен саған біраз нәрсе айтуым керек, жарай ма?
Dialogue: 0,1:03:11.00,1:03:12.63,Default,,0,0,0,,Ақымақ сылтау айтпа!
Dialogue: 0,1:03:13.25,1:03:16.09,Default,,0,0,0,,Сен мұнда жұмыс істеуге келдің!
Dialogue: 0,1:03:16.71,1:03:19.63,Default,,0,0,0,,Мысықтың қолын алсам ғой, қолым жетпейді!
Dialogue: 0,1:03:19.72,1:03:23.14,Default,,0,0,0,,Енді жұмысқа кіріс!
Dialogue: 0,1:03:29.48,1:03:30.64,Default,,0,0,0,,Мен дәретханаға барғым келеді
Dialogue: 0,1:03:32.48,1:03:34.10,Default,,0,0,0,,Менің ашуымды келтіргің келе ме?
Dialogue: 0,1:03:34.19,1:03:35.11,Default,,0,0,0,,Ууууууууууууууу...
Dialogue: 0,1:03:35.19,1:03:37.15,Default,,0,0,0,,Жарайды, 2 минут жасайық.
Dialogue: 0,1:03:38.07,1:03:40.44,Default,,0,0,0,,Қайту үшін сәл кеш болса да...
Dialogue: 0,1:03:50.25,1:03:54.67,Default,,0,0,0,,♪ Маған кедергі жасама
Dialogue: 0,1:03:55.38,1:03:59.00,Default,,0,0,0,,♪ Қарғыс атса да болады
Dialogue: 0,1:04:07.22,1:04:08.97,Default,,0,0,0,,Уау! Сәлем!
Dialogue: 0,1:04:09.06,1:04:10.35,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,1:04:10.43,1:04:11.02,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,1:04:13.94,1:04:17.48,Default,,0,0,0,,Мына тәтті қыз! Сен не істедің?
Dialogue: 0,1:04:21.53,1:04:22.61,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,1:04:22.70,1:04:25.24,Default,,0,0,0,,Куә!
Dialogue: 0,1:04:25.87,1:04:26.87,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,1:04:26.95,1:04:29.41,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:04:29.91,1:04:31.29,Default,,0,0,0,,Ахахахаха!
Dialogue: 0,1:04:31.37,1:04:33.41,Default,,0,0,0,,Дани во жида?
Dialogue: 0,1:04:34.21,1:04:36.42,Default,,0,0,0,,Мен қол қостым!
Dialogue: 0,1:04:36.50,1:04:40.55,Default,,0,0,0,,Себебі ханым: «Менің қолым жетпейді, қолым жетпейді» деді.
Dialogue: 0,1:04:40.63,1:04:42.42,Default,,0,0,0,,Ол сондай табанды болды!
Dialogue: 0,1:04:42.51,1:04:44.93,Default,,0,0,0,,Ааа!
Dialogue: 0,1:04:45.01,1:04:46.43,Default,,0,0,0,,Бибизу жоқ Баду!
Dialogue: 0,1:04:49.76,1:04:51.27,Default,,0,0,0,,Уау! Ува уа уа...
Dialogue: 0,1:04:51.35,1:04:52.81,Default,,0,0,0,,Уау!
Dialogue: 0,1:04:52.89,1:04:53.93,Default,,0,0,0,,Уф!
Dialogue: 0,1:04:55.14,1:04:56.27,Default,,0,0,0,,Куу...
Dialogue: 0,1:04:58.31,1:05:00.15,Default,,0,0,0,,Itter
Dialogue: 0,1:05:00.86,1:05:03.94,Default,,0,0,0,,Осы жерде болыңыз! Бибизу осында!
Dialogue: 0,1:05:04.03,1:05:05.99,Default,,0,0,0,,Уньяа~о!
Dialogue: 0,1:05:06.57,1:05:07.78,Default,,0,0,0,,Ой...
Dialogue: 0,1:05:08.37,1:05:13.29,Default,,0,0,0,,Сіз бұл сиқырды денеңізге саласыз. Бұл сізге ешқандай зиян тигізбейді.
Dialogue: 0,1:05:13.37,1:05:16.58,Default,,0,0,0,,(Томастың үрейлі дауысы)
Dialogue: 0,1:05:16.67,1:05:18.08,Default,,0,0,0,,Тұтқындарға арналған екінші жатақхана.
Dialogue: 0,1:05:18.17,1:05:19.08,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,1:05:19.17,1:05:20.25,Default,,0,0,0,,Я...
Dialogue: 0,1:05:22.13,1:05:23.88,Default,,0,0,0,,Хмм…
Dialogue: 0,1:05:24.38,1:05:26.43,Default,,0,0,0,,Ол келмейді...
Dialogue: 0,1:05:26.93,1:05:27.47,Default,,0,0,0,,(Қуыршақтың айқайы)
Dialogue: 0,1:05:27.55,1:05:28.30,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:29.76,1:05:30.68,Default,,0,0,0,,Уау!
Dialogue: 0,1:05:30.76,1:05:33.18,Default,,0,0,0,,(Қуыршақтың айқайы)
Dialogue: 0,1:05:41.44,1:05:42.90,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:05:42.98,1:05:45.19,Default,,0,0,0,,Заклинание бұзылды...
Dialogue: 0,1:05:45.95,1:05:47.91,Default,,0,0,0,,Қанша тырыссам да
Dialogue: 0,1:05:51.70,1:05:52.66,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:56.04,1:05:57.87,Default,,0,0,0,,Уау! Ах
Dialogue: 0,1:06:01.09,1:06:04.05,Default,,0,0,0,,Біздің заклинание жақсы жұмыс істейді.
Dialogue: 0,1:06:04.92,1:06:07.97,Default,,0,0,0,,Жауын құрттарының тек қана еденде болуының еш кінәсі жоқ.
Dialogue: 0,1:06:08.80,1:06:09.89,Default,,0,0,0,,Уф...
Dialogue: 0,1:06:09.97,1:06:13.97,Default,,0,0,0,,Әй, сұмдық! Қаймақтан да қорқынышты
Dialogue: 0,1:06:17.06,1:06:18.27,Default,,0,0,0,,Хмм
Dialogue: 0,1:06:20.56,1:06:22.73,Default,,0,0,0,,О... күте тұрыңыз.
Dialogue: 0,1:06:23.65,1:06:26.57,Default,,0,0,0,,Осы қарқынмен біз өзімізді сиқырлармен қорғайтын боламыз.
Dialogue: 0,1:06:26.65,1:06:28.49,Default,,0,0,0,,Апай біліп қояды!
Dialogue: 0,1:06:29.15,1:06:30.41,Default,,0,0,0,,Жасырын болуы керек!
Dialogue: 0,1:06:31.45,1:06:31.99,Default,,0,0,0,,Ах...
Dialogue: 0,1:06:33.45,1:06:36.50,Default,,0,0,0,,(Жақсы қарқынды музыка)
Dialogue: 0,1:06:40.08,1:06:41.96,Default,,0,0,0,,Біртүрлі екен, солай емес пе?
Dialogue: 0,1:06:42.04,1:06:45.13,Default,,0,0,0,,Шабыт қиын кезде соғады, солай ма?
Dialogue: 0,1:07:08.69,1:07:10.40,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:07:12.87,1:07:16.79,Default,,0,0,0,,Менде жауын құрттары бар, мен оларды ваннаға тығып жатырмын.
Dialogue: 0,1:07:16.87,1:07:20.54,Default,,0,0,0,,Сәлем! Ия, бұл үлкен мәселе!
Dialogue: 0,1:07:20.62,1:07:24.21,Default,,0,0,0,,Бұл кішкене қаймақ болды...
Dialogue: 0,1:07:24.29,1:07:25.96,Default,,0,0,0,,…Томас
Dialogue: 0,1:07:26.05,1:07:29.59,Default,,0,0,0,,Жер құрттары үш аяқты марсиялықтармен салыстырылады.
Dialogue: 0,1:07:29.67,1:07:31.05,Default,,0,0,0,,Ол әрқашан кішкентай болды...
Dialogue: 0,1:07:31.13,1:07:34.34,Default,,0,0,0,,(қарқынды гитара музыкасы)
Dialogue: 0,1:07:42.19,1:07:45.06,Default,,0,0,0,,(Мандрейктің айқайы)
Dialogue: 0,1:07:49.19,1:07:50.57,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,1:07:50.65,1:07:53.07,Default,,0,0,0,,(едендегі күйдірілген дыбыс)
Dialogue: 0,1:07:58.58,1:07:59.58,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,1:08:02.33,1:08:03.87,Default,,0,0,0,,Құрт!
Dialogue: 0,1:08:03.96,1:08:07.75,Default,,0,0,0,,Мен оған құрт беремін!
Dialogue: 0,1:08:07.84,1:08:12.42,Default,,0,0,0,,(Жындардың күлкісі)
Dialogue: 0,1:08:15.76,1:08:17.47,Default,,0,0,0,,(Чиби жынның айқайы)
Dialogue: 0,1:08:18.68,1:08:21.60,Default,,0,0,0,,(Жындардың айқайы)
Dialogue: 0,1:08:22.18,1:08:23.31,Default,,0,0,0,,(қабырғаны жарып өткен дыбыс)
Dialogue: 0,1:08:23.39,1:08:24.14,Default,,0,0,0,,Ах!
Dialogue: 0,1:08:24.23,1:08:24.98,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,1:08:25.06,1:08:27.61,Default,,0,0,0,,Бұл мен емес! Мен болмасам!
Dialogue: 0,1:08:27.69,1:08:30.65,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,1:08:31.74,1:08:33.11,Default,,0,0,0,,Конох!
Dialogue: 0,1:08:33.74,1:08:36.66,Default,,0,0,0,,Мен үшін не істедің!
Dialogue: 0,1:08:36.74,1:08:39.83,Default,,0,0,0,,Кешіріңіз! Менің тәтем жоқ.
Dialogue: 0,1:08:39.91,1:08:41.29,Default,,0,0,0,,Не!
Dialogue: 0,1:08:41.37,1:08:42.62,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,1:08:42.70,1:08:46.83,Default,,0,0,0,,Мен саған мазалама дедім ғой!
Dialogue: 0,1:08:46.92,1:08:47.63,Default,,0,0,0,,Ах!
Dialogue: 0,1:08:47.71,1:08:49.13,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,1:08:51.71,1:08:53.13,Default,,0,0,0,,«Маған кедергі жасама»
Dialogue: 0,1:08:53.22,1:08:54.13,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:02.56,1:09:03.18,Default,,0,0,0,,Иә
Dialogue: 0,1:09:03.27,1:09:05.39,Default,,0,0,0,,Мазасыздық жойылды.
Dialogue: 0,1:09:05.48,1:09:06.19,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:06.27,1:09:10.19,Default,,0,0,0,,Себебі мен саған тағы да қиындық туғызсам жаман болар еді.
Dialogue: 0,1:09:10.27,1:09:11.48,Default,,0,0,0,,Дұрыс па? ағай
Dialogue: 0,1:09:11.57,1:09:12.69,Default,,0,0,0,,Не айтып тұрсың...
Dialogue: 0,1:09:13.36,1:09:14.70,Default,,0,0,0,,Өзіңізге ұнайтын нәрсені жасаңыз!
Dialogue: 0,1:09:14.78,1:09:17.16,Default,,0,0,0,,Екеуің!
Dialogue: 0,1:09:17.24,1:09:18.28,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:20.70,1:09:22.37,Default,,0,0,0,,(Мандрейктің айқайы)
Dialogue: 0,1:09:22.45,1:09:23.95,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:09:24.54,1:09:25.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:28.08,1:09:29.46,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:42.10,1:09:42.72,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:43.43,1:09:44.64,Default,,0,0,0,,Құлаққап?
Dialogue: 0,1:09:45.18,1:09:46.23,Default,,0,0,0,,Бұл өтірік емес пе?
Dialogue: 0,1:09:46.31,1:09:50.73,Default,,0,0,0,,♪ Салқын пеште күлмен жабыңыз
Dialogue: 0,1:09:50.81,1:09:54.74,Default,,0,0,0,,♪ Жалаңаяқ қыз жылап тұр
Dialogue: 0,1:09:55.49,1:09:58.49,Default,,0,0,0,,♪ Арманымның ханзадасын қанша күтуім керек?
Dialogue: 0,1:09:59.16,1:10:02.74,Default,,0,0,0,,♪ Мен сені Хакубадан алып кетемін.
Dialogue: 0,1:10:04.24,1:10:08.25,Default,,0,0,0,,♪ Қамал мұнарасындағы ойыншықтармен қоршалған
Dialogue: 0,1:10:08.96,1:10:12.75,Default,,0,0,0,,♪ Ханзада бозарған жүзімен шегінді.
Dialogue: 0,1:10:13.55,1:10:16.59,Default,,0,0,0,,♪ Бөлменің есігіне жүз кілт іліңіз
Dialogue: 0,1:10:17.26,1:10:21.85,Default,,0,0,0,,♪ Әйел тек анасын ғана біледі
Dialogue: 0,1:10:21.93,1:10:26.35,Default,,0,0,0,,♪ О, ақымақ ханзада
Dialogue: 0,1:10:26.43,1:10:30.85,Default,,0,0,0,,♪ Әй, шіркін қыз
Dialogue: 0,1:10:30.94,1:10:35.94,Default,,0,0,0,,♪ Аа, есік ашуға арналған
Dialogue: 0,1:10:36.03,1:10:39.78,Default,,0,0,0,,♪ Ол қосулы.
Dialogue: 0,1:10:40.70,1:10:44.03,Default,,0,0,0,,♪ Маған кедергі жасама
Dialogue: 0,1:10:45.12,1:10:48.54,Default,,0,0,0,,♪ Қиындық тудыратындар
Dialogue: 0,1:10:49.75,1:10:54.09,Default,,0,0,0,,♪ Мені тозақта мазалама
Dialogue: 0,1:10:54.17,1:10:57.76,Default,,0,0,0,,♪ Өртенгенім артық.
Dialogue: 0,1:10:58.84,1:11:02.76,Default,,0,0,0,,♪ Маған кедергі жасама
Dialogue: 0,1:11:03.26,1:11:07.02,Default,,0,0,0,,♪ Қиындық тудыратындар
Dialogue: 0,1:11:07.89,1:11:11.02,Default,,0,0,0,,♪ Маған кедергі жасама
Dialogue: 0,1:11:12.27,1:11:16.53,Default,,0,0,0,,♪ Қарғыс атса да болады
Dialogue: 0,1:11:24.28,1:11:26.08,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,1:11:29.37,1:11:31.21,Default,,0,0,0,,(Музыка ойнауды тоқтатады)
Dialogue: 0,1:11:31.29,1:11:33.04,Default,,0,0,0,,Ол саған құрт берді...
Dialogue: 0,1:11:33.13,1:11:35.38,Default,,0,0,0,,Ағай! Ол рок жұлдызы болды!
Dialogue: 0,1:11:35.46,1:11:37.55,Default,,0,0,0,,Мен құлаққа арналған шашты жақсы көремін!
Dialogue: 0,1:11:37.63,1:11:39.55,Default,,0,0,0,,Мына қызыл шашты сүйкімді адам кім?
Dialogue: 0,1:11:40.26,1:11:41.09,Default,,0,0,0,,Ғашық?
Dialogue: 0,1:11:41.17,1:11:44.55,Default,,0,0,0,,Ол саған жауын құртын берді!
Dialogue: 0,1:11:46.51,1:11:48.89,Default,,0,0,0,,Иә, сондықтан мен оны жасыруға тырыстым.
Dialogue: 0,1:11:48.97,1:11:51.14,Default,,0,0,0,,Мен сені ваннаға жібердім деп ойладым.
Dialogue: 0,1:11:51.98,1:11:54.06,Default,,0,0,0,,Мен қателестім деп ойлаймын. Хехе!
Dialogue: 0,1:11:54.15,1:11:58.15,Default,,0,0,0,,Сиқырлы жерге сиқырлы құрт кіреді.
Dialogue: 0,1:11:58.23,1:12:00.57,Default,,0,0,0,,Сөйтіп ол менің бөлмеме келді.
Dialogue: 0,1:12:01.49,1:12:06.07,Default,,0,0,0,,Әнде де солай, сиқырлы жерге қояды.
Dialogue: 0,1:12:06.66,1:12:10.20,Default,,0,0,0,,Ол енді саған олай жасамайды.
Dialogue: 0,1:12:10.29,1:12:13.58,Default,,0,0,0,,Дәл сол әрекетті қайталама.
Dialogue: 0,1:12:13.67,1:12:16.25,Default,,0,0,0,,Мен сені өзімнің көмекшім етіп аламын.
Dialogue: 0,1:12:16.34,1:12:19.59,Default,,0,0,0,,Мен оған дұрыстап оқытыңыз дедім.
Dialogue: 0,1:12:19.67,1:12:21.09,Default,,0,0,0,,Рахмет!
Dialogue: 0,1:12:21.92,1:12:24.59,Default,,0,0,0,,Менің қолым көптен бері жақсы болса да,
Dialogue: 0,1:12:25.39,1:12:28.35,Default,,0,0,0,,Барабан және емле жасау...
Dialogue: 0,1:12:33.60,1:12:36.61,Default,,0,0,0,,Ағай, Эрвиг тарап кетті ме?
Dialogue: 0,1:12:36.69,1:12:39.27,Default,,0,0,0,,Қызыл шашты адам кім?
Dialogue: 0,1:12:42.36,1:12:43.82,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,1:12:44.70,1:12:46.82,Default,,0,0,0,,(мұңды музыка)
Dialogue: 0,1:12:46.91,1:12:50.24,Default,,0,0,0,,Тоқта, бақсы заңын не істейсің!
Dialogue: 0,1:12:50.33,1:12:52.50,Default,,0,0,0,,Шулы! мен не істеймін
Dialogue: 0,1:12:52.58,1:12:54.79,Default,,0,0,0,,Мен шешемін!
Dialogue: 0,1:12:58.84,1:13:00.09,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,1:13:00.17,1:13:01.88,Default,,0,0,0,,Қош бол әпке
Dialogue: 0,1:13:01.96,1:13:06.39,Default,,0,0,0,,12 кемпірдің айла-шарғы жасағаны үшін кешірім сұраймын.
Dialogue: 0,1:13:06.89,1:13:08.01,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,1:13:15.31,1:13:19.52,Default,,0,0,0,,Бақсы жасаған тесікті бақсы ғана толтыра алады.
Dialogue: 0,1:13:19.61,1:13:23.15,Default,,0,0,0,,Ол кетіп қалды...
Dialogue: 0,1:13:26.49,1:13:30.45,Default,,0,0,0,,Ағай, мен жоғалып кетпеймін, мен керемет бақсы болатыныма сенімдімін!
Dialogue: 0,1:13:31.54,1:13:35.16,Default,,0,0,0,,Өтінемін! Сізге романшы ретінде жұмыс істеуге көмектесуге рұқсат етіңіз
Dialogue: 0,1:13:35.25,1:13:36.96,Default,,0,0,0,,Мен ағама көмектескім келеді.
Dialogue: 0,1:13:37.04,1:13:38.96,Default,,0,0,0,,Мен қазір кетемін
Dialogue: 0,1:13:39.54,1:13:42.46,Default,,0,0,0,,Маған алаңдаған ұнамайды.
Dialogue: 0,1:13:43.17,1:13:45.05,Default,,0,0,0,,Ағай, өтінемін...
Dialogue: 0,1:13:47.13,1:13:47.97,Default,,0,0,0,,Уф!
Dialogue: 0,1:13:49.89,1:13:52.06,Default,,0,0,0,,Білесіз бе, аға?
Dialogue: 0,1:13:52.14,1:13:53.97,Default,,0,0,0,,Мектеп ертең басталады.
Dialogue: 0,1:13:54.56,1:13:56.98,Default,,0,0,0,,Сізді жібере аласыз ба?
Dialogue: 0,1:13:57.77,1:14:00.40,Default,,0,0,0,,Мен досым Кьюстердпен кездескім келеді.
Dialogue: 0,1:14:00.48,1:14:02.40,Default,,0,0,0,,Хмм... қаймақ.
Dialogue: 0,1:14:02.48,1:14:05.03,Default,,0,0,0,,Ағам сияқты мен де кітапқұмармын.
Dialogue: 0,1:14:05.57,1:14:07.65,Default,,0,0,0,,Бірақ мен оқығанның бәрі - SF
Dialogue: 0,1:14:07.74,1:14:09.49,Default,,0,0,0,,Кейде тіпті жұмбақ оқуға болады.
Dialogue: 0,1:14:10.45,1:14:11.78,Default,,0,0,0,,Дұрыс? Жақсы емес пе?
Dialogue: 0,1:14:11.87,1:14:12.41,Default,,0,0,0,,Хмм…
Dialogue: 0,1:14:12.49,1:14:14.37,Default,,0,0,0,,Күндіз мектепке барсам
Dialogue: 0,1:14:14.45,1:14:17.16,Default,,0,0,0,,Менің ойымша, үйде әлдеқайда тыныш болады.
Dialogue: 0,1:14:19.54,1:14:21.59,Default,,0,0,0,,Ойланып көрейік
Dialogue: 0,1:14:24.09,1:14:25.21,Default,,0,0,0,,Хмм...
Dialogue: 0,1:14:25.30,1:14:27.38,Default,,0,0,0,,Ма Икка
Dialogue: 0,1:14:30.59,1:14:31.51,Default,,0,0,0,,Әй!
Dialogue: 0,1:14:40.10,1:14:42.36,Default,,0,0,0,,Эй, Томас, мына екеуі.
Dialogue: 0,1:14:43.15,1:14:45.86,Default,,0,0,0,,Біз оны қалауымызша басқара аламыз.
Dialogue: 0,1:14:45.94,1:14:46.61,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:46.69,1:14:49.07,Default,,0,0,0,,Егер мен жақсы болсам
Dialogue: 0,1:14:49.15,1:14:50.11,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,1:14:50.20,1:14:51.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:56.54,1:15:01.46,Default,,0,0,0,,(Сыпырып алу дыбысы)
Dialogue: 0,1:15:07.59,1:15:08.97,Default,,0,0,0,,Я...
Dialogue: 0,1:15:10.43,1:15:12.84,Default,,0,0,0,,Сиқыр Сіз маған үйретесіз, солай ма?
Dialogue: 0,1:15:12.93,1:15:14.47,Default,,0,0,0,,Оны дереу орындаңыз!
Dialogue: 0,1:15:16.31,1:15:18.23,Default,,0,0,0,,күрсіну...
Dialogue: 0,1:15:18.93,1:15:21.35,Default,,0,0,0,,Бірақ мен олардың мұны қалай жасағанын білгім келеді...
Dialogue: 0,1:15:21.44,1:15:21.98,Default,,0,0,0,,Уау!
Dialogue: 0,1:15:22.06,1:15:23.52,Default,,0,0,0,,Рахмет, апай!
Dialogue: 0,1:15:23.61,1:15:24.44,Default,,0,0,0,,(Томастың қиналған дауысы)
Dialogue: 0,1:15:24.52,1:15:25.86,Default,,0,0,0,,Маған ағам айтты
Dialogue: 0,1:15:25.94,1:15:29.57,Default,,0,0,0,,Апай - шебер бақсы және ең жақсы барабаншы!
Dialogue: 0,1:15:29.65,1:15:32.49,Default,,0,0,0,,Мен апамдай болғым келеді!
Dialogue: 0,1:15:32.57,1:15:36.12,Default,,0,0,0,,Хмм, у, а, а...
Dialogue: 0,1:15:36.20,1:15:38.50,Default,,0,0,0,,Ой... неге тоқтамайсың!
Dialogue: 0,1:15:38.58,1:15:42.71,Default,,0,0,0,,Жүр, алдымен жинап алайық!
Dialogue: 0,1:15:42.79,1:15:45.50,Default,,0,0,0,,Мұнымен ештеңе істей алмайсыз!
Dialogue: 0,1:15:45.59,1:15:46.75,Default,,0,0,0,,Сахна тұрғысынан алғанда, көріп тұрсың ғой—
Dialogue: 0,1:15:49.55,1:15:54.09,Default,,0,0,0,,♪ Маған кедергі жасама
Dialogue: 0,1:15:54.18,1:15:58.60,Default,,0,0,0,,♪ Қиындық тудыратындар
Dialogue: 0,1:15:59.35,1:16:00.39,Default,,0,0,0,,Сондықтан мен бақылауға тырысуды тоқтаттым — бұл жүз пайыздық бар күшімді салған шабуыл.
Dialogue: 0,1:16:01.64,1:16:02.69,Default,,0,0,0,,Сәлем, апай!
Dialogue: 0,1:16:02.77,1:16:04.94,Default,,0,0,0,,Келесіде бәріміз пикникке барамыз ба?
Dialogue: 0,1:16:05.02,1:16:06.77,Default,,0,0,0,,Сары көлікке мін!
Dialogue: 0,1:16:07.57,1:16:08.61,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:16:08.69,1:16:11.28,Default,,0,0,0,,Егер сізде осылай уақыт болса, тіпті бір заклинание үйренбеңіз!
Dialogue: 0,1:16:11.99,1:16:14.45,Default,,0,0,0,,Көліктердің көпшілігінде сол мандрака бар...
Dialogue: 0,1:16:14.53,1:16:17.49,Default,,0,0,0,,Әй, мен апам мінетін көлікке мінгім келеді.
Dialogue: 0,1:16:17.58,1:16:19.08,Default,,0,0,0,,Ақымақ!
Dialogue: 0,1:16:19.16,1:16:22.33,Default,,0,0,0,,Менің айтып тұрғаным бұл емес.
Dialogue: 0,1:16:22.41,1:16:26.38,Default,,0,0,0,,(тыныш музыка)
Dialogue: 0,1:16:30.09,1:16:33.26,Default,,0,0,0,,Мені осында әкелгеніме жарты жыл болды.
Dialogue: 0,1:16:33.88,1:16:37.30,Default,,0,0,0,,Қазір бұл үйдегілердің бәрі менімен келіседі.
Dialogue: 0,1:16:39.06,1:16:42.31,Default,,0,0,0,,Мен баламның үйінде болған кездегіден әлдеқайда жақсы сезінемін.
Dialogue: 0,1:16:43.27,1:16:45.60,Default,,0,0,0,,Шешім! «Аралас гриль»!
Dialogue: 0,1:16:46.65,1:16:49.07,Default,,0,0,0,,Мандраке бұл күндері.
Dialogue: 0,1:16:49.15,1:16:50.40,Default,,0,0,0,,«Ая-чан»
Dialogue: 0,1:16:50.48,1:16:51.48,Default,,0,0,0,,Сіз маған мейірімділікпен қоңырау шаласыз
Dialogue: 0,1:16:51.57,1:16:52.32,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:16:53.57,1:16:55.07,Default,,0,0,0,,Ая-чан
Dialogue: 0,1:16:55.16,1:16:59.08,Default,,0,0,0,,Қайырлы таң аға, бүгін таңертең аралас гриль жеуге бола ма?
Dialogue: 0,1:16:59.70,1:17:00.58,Default,,0,0,0,,Иә
Dialogue: 0,1:17:00.66,1:17:01.58,Default,,0,0,0,,Ах
Dialogue: 0,1:17:02.16,1:17:04.21,Default,,0,0,0,,Мен кешегі қолжазбаны оқыдым.
Dialogue: 0,1:17:04.29,1:17:06.54,Default,,0,0,0,,Бұл өте қызықты болды!
Dialogue: 0,1:17:06.63,1:17:10.21,Default,,0,0,0,,Қараңғыда мұнарада адасқан балалар
Dialogue: 0,1:17:10.30,1:17:14.05,Default,,0,0,0,,Қоңыраудың орнына ілулі тұрған кесілген бастың табылған бөлігі.
Dialogue: 0,1:17:14.13,1:17:15.59,Default,,0,0,0,,Мен қатты шошып кеттім!
Dialogue: 0,1:17:17.18,1:17:19.10,Default,,0,0,0,,Қалғанын қашан оқуға болады?
Dialogue: 0,1:17:20.22,1:17:21.51,Default,,0,0,0,,Қазір жаз
Dialogue: 0,1:17:22.31,1:17:23.10,Default,,0,0,0,,Ммм
Dialogue: 0,1:17:23.68,1:17:26.27,Default,,0,0,0,,Жындар да бірте-бірте мені тыңдай бастады.
Dialogue: 0,1:17:26.35,1:17:27.31,Default,,0,0,0,,Мен тыңдай бастадым.
Dialogue: 0,1:17:27.40,1:17:29.94,Default,,0,0,0,,Енді, жын!
Dialogue: 0,1:17:33.15,1:17:36.95,Default,,0,0,0,,Сіз мені шақырасыз ба, менің сұлу ханым?
Dialogue: 0,1:17:37.03,1:17:39.28,Default,,0,0,0,,Мен және Мандрейк «аралас гриль»
Dialogue: 0,1:17:39.37,1:17:39.95,Default,,0,0,0,,Апай...
Dialogue: 0,1:17:40.03,1:17:41.95,Default,,0,0,0,,Бірақ әлі де бір нәрсе бар.
Dialogue: 0,1:17:42.62,1:17:44.45,Default,,0,0,0,,Кейде істер сіз қалағандай бола бермейді.
Dialogue: 0,1:17:47.04,1:17:50.04,Default,,0,0,0,,Қаймақ не болса да менің үйіме келмейді.
Dialogue: 0,1:17:50.13,1:17:50.71,Default,,0,0,0,,Оны ашыңыз.
Dialogue: 0,1:17:50.79,1:17:51.34,Default,,0,0,0,,Иә
Dialogue: 0,1:17:51.42,1:17:53.46,Default,,0,0,0,,Мен мандракадан қорқамын
Dialogue: 0,1:17:53.55,1:17:55.38,Default,,0,0,0,,Келгісі келмейді.
Dialogue: 0,1:17:57.26,1:17:59.47,Default,,0,0,0,,Уф...
Dialogue: 0,1:17:59.55,1:18:01.47,Default,,0,0,0,,Хмм!
Dialogue: 0,1:18:02.81,1:18:04.52,Default,,0,0,0,,О, түсіндім. Ол жер жергілікті көрікті жерге айналған екен, иә?
Dialogue: 0,1:18:04.60,1:18:07.48,Default,,0,0,0,,Мен бұл жаңа үйде жақсы жұмыс істеген сияқтымын.
Dialogue: 0,1:18:07.56,1:18:11.61,Default,,0,0,0,,Сіз сондай-ақ кремді жақсы өңдей білуіңіз керек.
Dialogue: 0,1:18:11.69,1:18:12.94,Default,,0,0,0,,Хмм…
Dialogue: 0,1:18:14.44,1:18:15.90,Default,,0,0,0,,(көліктің жақындап келе жатқан дыбысы)
Dialogue: 0,1:18:18.74,1:18:19.91,Default,,0,0,0,,Ах
Dialogue: 0,1:18:22.74,1:18:23.95,Default,,0,0,0,,(есік қоңырауының дыбысы)
Dialogue: 0,1:18:24.04,1:18:25.04,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,1:18:25.12,1:18:25.66,Default,,0,0,0,,Иә
Dialogue: 0,1:18:29.42,1:18:31.29,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:31.38,1:18:32.84,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,1:18:33.63,1:18:34.92,Default,,0,0,0,,Қаймақ!
Dialogue: 0,1:18:35.42,1:18:36.34,Default,,0,0,0,,Ах
Dialogue: 0,1:18:37.63,1:18:40.84,Default,,0,0,0,,Рождество мерекесімен Аяцуру
Dialogue: 0,1:18:41.93,1:18:45.64,Default,,0,0,0,,♪~
Dialogue: 0,1:19:09.96,1:19:14.00,Default,,0,0,0,,♪ Таң атқанша күлгін аспан
Dialogue: 0,1:19:14.09,1:19:18.67,Default,,0,0,0,,♪ Қарға қоқыс жинап жатыр.
Dialogue: 0,1:19:18.76,1:19:23.09,Default,,0,0,0,,♪ Жақында қала ұйқылы көздерін уқалайды
Dialogue: 0,1:19:23.18,1:19:27.47,Default,,0,0,0,,♪Адамдар мен көліктерге толып жатыр.
Dialogue: 0,1:19:27.56,1:19:31.94,Default,,0,0,0,,♪ Жарқыраған, жымыңдаған жұлдыздар да
Dialogue: 0,1:19:32.02,1:19:36.07,Default,,0,0,0,,♪ Қазір мен суағарға түсіп қалдым
Dialogue: 0,1:19:36.78,1:19:39.07,Default,,0,0,0,,♪ сыпырылып бара жатыр
Dialogue: 0,1:19:39.15,1:19:44.70,Default,,0,0,0,,♪ Қош бол менің батырым
Dialogue: 0,1:19:45.99,1:19:49.91,Default,,0,0,0,,♪ Ыстық шай ішкеннен кейін
Dialogue: 0,1:19:50.00,1:19:54.58,Default,,0,0,0,,♪ Елсіз жердің мөлдір желі
Dialogue: 0,1:19:54.67,1:20:01.42,Default,,0,0,0,,♪ Төбе басынан көрінген дүние
Dialogue: 0,1:20:01.51,1:20:04.64,Default,,0,0,0,,♪ Бұл менікі.
Dialogue: 0,1:20:13.06,1:20:17.44,Default,,0,0,0,,♪ Бетон және пластик
Dialogue: 0,1:20:17.52,1:20:21.95,Default,,0,0,0,,♪ Әшекейленген қала
Dialogue: 0,1:20:22.03,1:20:25.95,Default,,0,0,0,,♪ Зомби сияқты қалың топта
Dialogue: 0,1:20:26.62,1:20:30.87,Default,,0,0,0,,♪ Мен оңға-солға сырғып бара жатырмын
Dialogue: 0,1:20:30.95,1:20:35.38,Default,,0,0,0,,♪ Қайсысы қазынаға ұқсайды
Dialogue: 0,1:20:35.46,1:20:38.96,Default,,0,0,0,,♪ Жай ғана электрлік трюк
Dialogue: 0,1:20:40.26,1:20:42.55,Default,,0,0,0,,♪ Енді маған керегі жоқ
Dialogue: 0,1:20:42.63,1:20:48.22,Default,,0,0,0,,♪ Қош бол менің батырым
Dialogue: 0,1:20:49.10,1:20:53.48,Default,,0,0,0,,♪ Тәтті су атқылайды
Dialogue: 0,1:20:53.56,1:20:57.98,Default,,0,0,0,,♪ Жалаң аяқты көктемде батырып алсаң
Dialogue: 0,1:20:58.06,1:21:04.61,Default,,0,0,0,,♪ Ежелден бері өзгеріссіз қалды.
Dialogue: 0,1:21:05.20,1:21:08.03,Default,,0,0,0,,♪ Шынайы әлем
Dialogue: 0,1:21:32.06,1:21:36.52,Default,,0,0,0,,♪ Ыстық шай ішкеннен кейін
Dialogue: 0,1:21:36.60,1:21:41.11,Default,,0,0,0,,♪ Елсіз жердің мөлдір желі
Dialogue: 0,1:21:41.19,1:21:48.07,Default,,0,0,0,,♪ Төбе басынан көрінген дүние
Dialogue: 0,1:21:48.16,1:21:50.03,Default,,0,0,0,,♪ Бұл менікі.
Dialogue: 0,1:21:50.12,1:21:54.04,Default,,0,0,0,,♪ Тәтті су атқылайды
