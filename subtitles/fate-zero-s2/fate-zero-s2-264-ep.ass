Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 1,0:02:13.45,0:02:14.97,JP,NTP,0,0,0,,Өте көп
Dialogue: 1,0:02:15.67,0:02:19.07,JP,NTP,0,0,0,,Сен мені сонша жек көрдің бе?
Dialogue: 1,0:02:31.47,0:02:32.78,JP,NTP,0,0,0,,Бастапқы маркер
Dialogue: 1,0:02:33.52,0:02:38.65,JP,NTP,0,0,0,,Жәбірленушінің сиқырлы күші бақылаудан шығып, өз денесін әп-сәтте жойып жібереді.
Dialogue: 1,0:02:40.73,0:02:41.81,JP,NTP,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 1,0:02:42.39,0:02:43.39,JP,NTP,0,0,0,,Меншікті уақытты басқару
Dialogue: 1,0:02:44.79,0:02:46.26,JP,NTP,0,0,0,,Екі еселік жылдамдық
Dialogue: 1,0:03:01.09,0:03:02.73,JP,NTP,0,0,0,,Түпнұсқа таңбалауышы жұмыс істемейді
Dialogue: 1,0:03:03.70,0:03:04.98,JP,NTP,0,0,0,,Жоқ
Dialogue: 1,0:03:05.29,0:03:06.24,JP,NTP,0,0,0,,Мен көремін.
Dialogue: 1,0:03:06.50,0:03:09.56,JP,NTP,0,0,0,,Ол сиқырлы күштің көзі ретінде командалық заклинание қолдана ма?
Dialogue: 1,0:03:10.17,0:03:12.51,JP,NTP,0,0,0,,Origin Bullet күшіне енген кезде,
Dialogue: 1,0:03:12.63,0:03:15.81,JP,NTP,0,0,0,,Оның қолынан сиқырлы күштің бастауы болып табылатын командалық заклинание жоғалып кетті.
Dialogue: 1,0:03:17.30,0:03:20.26,JP,NTP,0,0,0,,Өзінің сиқырлы схемасы қолданылмағандықтан
Dialogue: 1,0:03:20.38,0:03:22.37,JP,NTP,0,0,0,,Бастапқы оқтың сиқырлы күші әсер етпейді.
Dialogue: 1,0:03:23.25,0:03:25.21,JP,NTP,0,0,0,,Бірақ соққанша
Dialogue: 1,0:03:26.15,0:03:28.25,JP,NTP,0,0,0,,Оның өлтіруге күші жетеді
Dialogue: 1,0:03:30.25,0:03:32.62,JP,NTP,0,0,0,,Келесі жолы қашып құтыла аламын деп ойлаймын.
Dialogue: 1,0:03:33.26,0:03:35.44,JP,NTP,0,0,0,,Егер сіз оның қос жылдамдықпен қозғалатынын білсеңіз
Dialogue: 1,0:03:35.74,0:03:39.94,JP,NTP,0,0,0,,Мұны түсінгеннен кейін уақытты өлшеу керек.
Dialogue: 1,0:03:52.49,0:03:53.28,JP,NTP,0,0,0,,Ол тез.
Dialogue: 1,0:04:11.54,0:04:13.57,JP,NTP,0,0,0,,Сізді сонша жынды еткен не болды?
Dialogue: 1,0:04:18.44,0:04:20.27,JP,NTP,0,0,0,,Менің кінәм бар ма?
Dialogue: 1,0:04:37.26,0:04:38.30,JP,NTP,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 1,0:04:40.97,0:04:41.93,JP,NTP,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 1,0:04:59.68,0:05:00.69,JP,NTP,0,0,0,,Меншікті уақытты бақылау
Dialogue: 1,0:05:01.32,0:05:03.07,JP,NTP,0,0,0,,Екі еселік жылдамдық
Dialogue: 1,0:05:51.60,0:05:54.45,JP,NTP,0,0,0,,Жақын шайқаста біз өте қолайсыз жағдайға тап болдық.
Dialogue: 1,0:05:55.03,0:05:56.53,JP,NTP,0,0,0,,Калико жоғалды
Dialogue: 1,0:05:56.77,0:05:58.90,JP,NTP,0,0,0,,Contender қайта жүктеуді қажет етеді
Dialogue: 1,0:05:59.94,0:06:00.42,JP,NTP,0,0,0,,Бірақ
Dialogue: 1,0:06:01.71,0:06:04.01,JP,NTP,0,0,0,,Бәрі де алыстағы утопия
Dialogue: 1,0:06:07.14,0:06:11.58,JP,NTP,0,0,0,,Қалпына келтіру күші сонша, жүрек бұзылса да, ол бірден қалпына келеді.
Dialogue: 1,0:06:11.79,0:06:14.35,JP,NTP,0,0,0,,Содан кейін миды бұзыңыз
Dialogue: 1,0:06:14.90,0:06:15.67,JP,NTP,0,0,0,,Бірақ
Dialogue: 1,0:06:16.24,0:06:18.30,JP,NTP,0,0,0,,Бұл оң қолды қолдануға болмайды.
Dialogue: 1,0:06:18.64,0:06:21.47,JP,NTP,0,0,0,,Авалонның сауықтыру қабілеті өзіне зиян келтіруге қарсы да тиімді
Dialogue: 1,0:06:21.78,0:06:23.93,JP,NTP,0,0,0,,Қалған қарулар - бір пышақ және екі граната.
Dialogue: 1,0:06:24.08,0:06:28.02,JP,NTP,0,0,0,,Он екі қара перне қалды.
Dialogue: 1,0:06:28.14,0:06:30.35,JP,NTP,0,0,0,,Алдын ала пәрмен емлелері үшін тек 8 штрих қалды
Dialogue: 1,0:06:30.59,0:06:31.58,JP,NTP,0,0,0,,Меншікті уақытты бақылау
Dialogue: 1,0:06:32.70,0:06:34.00,JP,NTP,0,0,0,,Үш еселік жылдамдық
Dialogue: 1,0:07:13.63,0:07:14.80,JP,NTP,0,0,0,,Меншікті уақытты бақылау
Dialogue: 1,0:07:15.03,0:07:16.51,JP,NTP,0,0,0,,Төрт еселік жылдамдық
Dialogue: 1,0:08:08.93,0:08:12.22,JP,NTP,0,0,0,,Сонда да мен Қасиетті Граалды жеңемін
Dialogue: 1,0:08:12.62,0:08:14.00,JP,NTP,0,0,0,,Әйтпесе
Dialogue: 1,0:08:15.02,0:08:19.04,JP,NTP,0,0,0,,Мен сізге ештеңе өтей алмаймын.
Dialogue: 1,0:08:24.80,0:08:27.22,JP,NTP,0,0,0,,Осы кезеңнің өзінде
Dialogue: 1,0:08:27.84,0:08:32.64,JP,NTP,0,0,0,,Сол үшін қолыңа қылышты аласың ба?
Dialogue: 1,0:08:35.10,0:08:37.45,JP,NTP,0,0,0,,Сіз қиындыққа тап болдыңыз.
Dialogue: 1,0:08:56.91,0:08:57.87,JP,NTP,0,0,0,,Бұл
Dialogue: 1,0:09:04.11,0:09:06.98,JP,NTP,0,0,0,,Мен сенің келетініңе сенімді болдым.
Dialogue: 1,0:09:08.62,0:09:12.65,JP,NTP,0,0,0,,Мен сенің осында жете алатыныңа сендім.
Dialogue: 1,0:09:13.87,0:09:14.83,JP,NTP,0,0,0,,Айри
Dialogue: 1,0:09:15.21,0:09:18.55,JP,NTP,0,0,0,,Бұл сіздің тілектеріңіз орындалатын жер
Dialogue: 1,0:09:18.76,0:09:22.19,JP,NTP,0,0,0,,Іздеген киелі тастың ішінде.
Dialogue: 1,0:09:26.61,0:09:28.53,JP,NTP,0,0,0,,Бұл Қасиетті Граил
Dialogue: 1,0:09:28.75,0:09:30.47,JP,NTP,0,0,0,,Ол әлі қалыптаспағанымен.
Dialogue: 1,0:09:30.75,0:09:33.51,JP,NTP,0,0,0,,Ыдыс толып қалды.
Dialogue: 1,0:09:34.34,0:09:36.75,JP,NTP,0,0,0,,Бар болғаны дұғаңызды оқысаңыз болғаны
Dialogue: 1,0:09:37.16,0:09:41.84,JP,NTP,0,0,0,,Осылайша ол бірінші рет «сыртқа» шыға алады.
Dialogue: 1,0:09:42.15,0:09:44.51,JP,NTP,0,0,0,,Енді, өтінемін
Dialogue: 1,0:09:44.71,0:09:47.20,JP,NTP,0,0,0,,Оған мүмкіндігінше тезірек «құрмет» көрсетіңіз.
Dialogue: 1,0:09:47.51,0:09:48.43,JP,NTP,0,0,0,,Кирицугу
Dialogue: 1,0:09:48.99,0:09:53.39,JP,NTP,0,0,0,,Сіз оның не екенін анықтайтын дұрыс адамсыз.
Dialogue: 1,0:09:54.74,0:09:56.99,JP,NTP,0,0,0,,Сіз кімсіз?
Dialogue: 1,0:09:57.60,0:09:59.28,JP,NTP,0,0,0,,Мен Айрисвиелмін
Dialogue: 1,0:09:59.64,0:10:00.63,JP,NTP,0,0,0,,Жоқ
Dialogue: 1,0:10:01.02,0:10:05.55,JP,NTP,0,0,0,,Егер Қасиетті Граил дайын болса, ол қазірдің өзінде
Dialogue: 1,0:10:07.16,0:10:08.63,JP,NTP,0,0,0,,Сонымен қатар, ол бізге дерлік жетіп қалды.
Dialogue: 1,0:10:09.09,0:10:10.28,JP,NTP,0,0,0,,Иә.
Dialogue: 1,0:10:10.80,0:10:13.69,JP,NTP,0,0,0,,Мен бұл маска екенін жоққа шығармаймын.
Dialogue: 1,0:10:14.58,0:10:18.85,JP,NTP,0,0,0,,Мен бар тұлғамды «қабық» ретінде жабуым керек.
Dialogue: 1,0:10:19.25,0:10:21.70,JP,NTP,0,0,0,,Басқалармен тіл табыса алмайды
Dialogue: 1,0:10:21.81,0:10:27.90,JP,NTP,0,0,0,,Бірақ мен жазған Ирисвиелдің тұлғасы сөзсіз шынайы.
Dialogue: 1,0:10:28.04,0:10:32.94,JP,NTP,0,0,0,,Сондықтан мен Ирисвиелдің соңғы тілегін мұра еттім.
Dialogue: 1,0:10:33.17,0:10:35.33,JP,NTP,0,0,0,,Сіз Қасиетті Граилдың еркісіз бе?
Dialogue: 1,0:10:36.12,0:10:39.45,JP,NTP,0,0,0,,Иә, бұл түсіндіру дұрыс.
Dialogue: 1,0:10:39.96,0:10:42.99,JP,NTP,0,0,0,,Менде ерік пен қалау бар
Dialogue: 1,0:10:43.44,0:10:46.11,JP,NTP,0,0,0,,«Осы әлемде туылу» еркі
Dialogue: 1,0:10:46.55,0:10:47.67,JP,NTP,0,0,0,,Мақтана алатын ұлыңмын. Иә.
Dialogue: 1,0:10:47.85,0:10:53.31,JP,NTP,0,0,0,,Олай болса, сізден сұрайын: Қасиетті Граил менің тілегімді қалай орындамақ?
Dialogue: 1,0:10:53.55,0:10:55.12,JP,NTP,0,0,0,,Бұл дұрыс емес, Кирицугу.
Dialogue: 1,0:10:57.55,0:11:01.68,JP,NTP,0,0,0,,Сіз оны басқалардан жақсы түсінбеуіңіз керек.
Dialogue: 1,0:11:01.86,0:11:03.01,JP,NTP,0,0,0,,Тіпті қазір де жағдай осылай,
Dialogue: 1,0:11:03.55,0:11:08.41,JP,NTP,0,0,0,,Сіз әлемді қалай құтқару керектігін түсіндіңіз.
Dialogue: 1,0:11:08.63,0:11:11.90,JP,NTP,0,0,0,,Ендеше мен сенің істегеніңді істеймін.
Dialogue: 1,0:11:12.17,0:11:16.79,JP,NTP,0,0,0,,Мен сенің болмысыңды мұра етіп, дұғаларыңды орындаймын.
Dialogue: 1,0:11:17.31,0:11:18.78,JP,NTP,0,0,0,,Егер ол белгілі бір дәрежеде бар күшін салмайтын болса—
Dialogue: 1,0:11:20.80,0:11:22.31,JP,NTP,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 1,0:11:22.83,0:11:27.67,JP,NTP,0,0,0,,Бұдан былай сізге тек өз ішіндегі сұрақты қою керек.
Dialogue: 1,0:11:33.67,0:11:34.88,JP,NTP,0,0,0,,Бұл
Dialogue: 1,0:11:38.37,0:11:43.47,JP,NTP,0,0,0,,Бір кемеде үш жүз адам, екіншісінде екі жүз адам.
Dialogue: 1,0:11:43.70,0:11:44.46,JP,NTP,0,0,0,,Не?
Dialogue: 1,0:11:44.81,0:11:49.52,JP,NTP,0,0,0,,Барлығы 500 экипаж мүшелері мен жолаушылар, ал қалғандары Кирицугу Эмия.
Dialogue: 1,0:11:50.10,0:11:55.15,JP,NTP,0,0,0,,Осы 501 адам адамзаттың соңғы аман қалғандары деп есептейік.
Dialogue: 1,0:11:55.62,0:12:00.26,JP,NTP,0,0,0,,Екі кеменің түбінде бір уақытта ашылған өлімге әкелетін үлкен тесік.
Dialogue: 1,0:12:00.53,0:12:04.07,JP,NTP,0,0,0,,Тек Кирицугу кемелерді жөндеуге қабілетті.
Dialogue: 1,0:12:04.70,0:12:08.50,JP,NTP,0,0,0,,Енді қай кемені жөндейсіз?
Dialogue: 1,0:12:08.87,0:12:12.24,JP,NTP,0,0,0,,Әрине, бұл бортында 300 адам бар кеме.
Dialogue: 1,0:12:12.67,0:12:14.56,JP,NTP,0,0,0,,Егер сіз мұны шешсеңіз
Dialogue: 1,0:12:15.11,0:12:20.56,JP,NTP,0,0,0,,Басқа кемедегі екі жүз адам сізді ұстап алып, талап етті:
Dialogue: 1,0:12:20.81,0:12:23.21,JP,NTP,0,0,0,,«Алдымен осы кемені жөндеңіз».
Dialogue: 1,0:12:23.74,0:12:25.28,JP,NTP,0,0,0,,Енді не істеуіміз керек?
Dialogue: 1,0:12:26.60,0:12:28.14,JP,NTP,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 1,0:12:55.03,0:12:57.80,JP,NTP,0,0,0,,Барлық 200 адамды өлтіріңіз
Dialogue: 1,0:12:58.05,0:13:01.55,JP,NTP,0,0,0,,Дұрыс Сондықтан Кирицугу Эмия
Dialogue: 1,0:13:05.61,0:13:09.78,JP,NTP,0,0,0,,Енді аман қалған 300 адам зақымдалған кемені тастап кетті.
Dialogue: 1,0:13:10.37,0:13:13.84,JP,NTP,0,0,0,,Екі жаңа кемеде жүзуді жалғастырыңыз
Dialogue: 1,0:13:14.61,0:13:19.52,JP,NTP,0,0,0,,Енді бір кемеде екі жүз адам, екіншісінде жүз адам.
Dialogue: 1,0:13:20.04,0:13:25.40,JP,NTP,0,0,0,,Алайда бұл екі кеменің түбінде бір уақытта тесіктер ашылды.
Dialogue: 1,0:13:25.85,0:13:26.49,JP,NTP,0,0,0,,Эй
Dialogue: 1,0:13:27.80,0:13:31.30,JP,NTP,0,0,0,,Сізді кішірек кемеде жүз адам ұрлап әкетті.
Dialogue: 1,0:13:31.70,0:13:34.43,JP,NTP,0,0,0,,Алдымен кемеңізді жөндеуге мәжбүр болды
Dialogue: 1,0:13:34.95,0:13:36.22,JP,NTP,0,0,0,,Енді не істеуіміз керек?
Dialogue: 1,0:13:36.58,0:13:37.72,JP,NTP,0,0,0,,Бұл дұрыс емес.
Dialogue: 1,0:13:38.06,0:13:38.90,JP,NTP,0,0,0,,Бірақ
Dialogue: 1,0:13:55.47,0:13:57.72,JP,NTP,0,0,0,,Иә, дұрыс айтасыз.
Dialogue: 1,0:13:57.99,0:14:00.19,JP,NTP,0,0,0,,Бұл ақымақтық. Бұл ақымақ.
Dialogue: 1,0:14:00.33,0:14:01.71,JP,NTP,0,0,0,,Дұрыс деген не?
Dialogue: 1,0:14:02.09,0:14:03.84,JP,NTP,0,0,0,,Екі жүз адам аман қалды
Dialogue: 1,0:14:04.10,0:14:06.19,JP,NTP,0,0,0,,Оның кесірінен үш жүз адам өлді.
Dialogue: 1,0:14:06.42,0:14:08.43,JP,NTP,0,0,0,,Бұл жағдайда таразының инесі екінші жағын көрсетіп тұр.
Dialogue: 1,0:14:08.67,0:14:11.41,JP,NTP,0,0,0,,Жоқ, есептеу қате емес.
Dialogue: 1,0:14:11.91,0:14:16.15,JP,NTP,0,0,0,,Шынында да, сіз көпті құтқару үшін азды құрбан етуді таңдайсыз.
Dialogue: 1,0:14:16.63,0:14:19.09,JP,NTP,0,0,0,,Менің ойымша, Кирицугу Эмия
Dialogue: 1,0:14:19.57,0:14:23.79,JP,NTP,0,0,0,,Таразыны төңкермеген санаулыларды ылғи да өлтірдің.
Dialogue: 1,0:14:24.52,0:14:28.55,JP,NTP,0,0,0,,Осыншама мәйіт үйіліп жатса да
Dialogue: 1,0:14:28.79,0:14:30.81,JP,NTP,0,0,0,,Егер бұл өмірді сақтап қалса
Dialogue: 1,0:14:31.20,0:14:34.22,JP,NTP,0,0,0,,Қорғалған сан қымбат болуы керек.
Dialogue: 1,0:14:37.66,0:14:40.80,JP,NTP,0,0,0,,Маған көрсеткіңіз келгені осы ма?
Dialogue: 1,0:14:41.20,0:14:42.10,JP,NTP,0,0,0,,Иә.
Dialogue: 1,0:14:42.35,0:14:46.67,JP,NTP,0,0,0,,Бұл сіздің ақиқатыңыз, Кирицугу Эмиияның жауабы.
Dialogue: 1,0:14:47.24,0:14:51.78,JP,NTP,0,0,0,,Басқаша айтқанда, бұл Қасиетті Граил қалау машинасы ретінде орындауы керек.
Dialogue: 1,0:14:51.98,0:14:52.78,JP,NTP,0,0,0,,Жоқ
Dialogue: 1,0:14:52.96,0:14:54.92,JP,NTP,0,0,0,,Мен мұны қаламаймын
Dialogue: 1,0:14:55.28,0:14:57.99,JP,NTP,0,0,0,,Бұдан басқа жол болса екен.
Dialogue: 1,0:14:58.55,0:15:02.91,JP,NTP,0,0,0,,Сондықтан менде ғажайыпқа сүйенуден басқа амал жоқ.
Dialogue: 1,0:15:03.22,0:15:05.47,JP,NTP,0,0,0,,Сіз білмейтін әдіс
Dialogue: 1,0:15:05.74,0:15:08.59,JP,NTP,0,0,0,,Мен оны сіздің тілектеріңізге қоса алмаймын.
Dialogue: 1,0:15:09.05,0:15:11.14,JP,NTP,0,0,0,,Дүниенің құтқарылуын тілесең
Dialogue: 1,0:15:11.74,0:15:15.09,JP,NTP,0,0,0,,Оны сізге белгілі құралдар арқылы ғана орындауға болады.
Dialogue: 1,0:15:15.54,0:15:16.57,JP,NTP,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 1,0:15:16.74,0:15:20.54,JP,NTP,0,0,0,,Бұл қандай керемет?
Dialogue: 1,0:15:21.56,0:15:23.00,JP,NTP,0,0,0,,Бұл керемет
Dialogue: 1,0:15:23.77,0:15:29.30,JP,NTP,0,0,0,,Сіз бір кездері өзіңіз ешқашан жасай алмайтын нәрсені жасауға ұмтылдыңыз.
Dialogue: 1,0:15:29.58,0:15:32.86,JP,NTP,0,0,0,,Тапсырманы адам қолымен орындай алмайтын шкала бойынша орындаңыз.
Dialogue: 1,0:15:33.27,0:15:36.35,JP,NTP,0,0,0,,Бұл ғажайып болмаса, не?
Dialogue: 1,0:15:41.92,0:15:43.09,JP,NTP,0,0,0,,Әке.
Dialogue: 1,0:15:51.30,0:15:52.48,JP,NTP,0,0,0,,Наталья
Dialogue: 1,0:15:56.20,0:15:58.17,JP,NTP,0,0,0,,Кирицугу Эмия
Dialogue: 1,0:15:58.55,0:16:04.58,JP,NTP,0,0,0,,——「」
Dialogue: 1,0:16:05.35,0:16:08.37,JP,NTP,0,0,0,,Енді соңғы ұсынысқа.
Dialogue: 1,0:16:10.98,0:16:13.85,JP,NTP,0,0,0,,Үш адам қалды
Dialogue: 1,0:16:16.46,0:16:20.25,JP,NTP,0,0,0,,Екі сақтау керек пе, әлде біреуін таңдау керек пе?
Dialogue: 1,0:16:31.79,0:16:34.27,JP,NTP,0,0,0,,Қош келдіңіз, Кирицугу.
Dialogue: 1,0:16:35.11,0:16:38.07,JP,NTP,0,0,0,,Сіз ақыры оралдыңыз.
Dialogue: 1,0:16:39.62,0:16:41.70,JP,NTP,0,0,0,,Жақсы, түсіндің.
Dialogue: 1,0:16:42.97,0:16:46.46,JP,NTP,0,0,0,,Бұл сіздің дұғаларыңызды Қасиетті Граил арқылы орындау
Dialogue: 1,0:16:50.39,0:16:53.37,JP,NTP,0,0,0,,Ол үшін дұға ету жеткілікті
Dialogue: 1,0:16:53.79,0:16:55.80,JP,NTP,0,0,0,,Әйелімді өмірге қайтар
Dialogue: 1,0:16:56.58,0:16:58.13,JP,NTP,0,0,0,,Қызымды қайтару үшін
Dialogue: 1,0:17:06.06,0:17:09.83,JP,NTP,0,0,0,,Мен енді жаңғақ бүршігін іздей алмаймын.
Dialogue: 1,0:17:10.23,0:17:11.89,JP,NTP,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 1,0:17:12.10,0:17:16.93,JP,NTP,0,0,0,,Илья, Кирицугу мен сенің анаң бірге болса, бәрі жақсы.
Dialogue: 1,0:17:17.51,0:17:22.29,JP,NTP,0,0,0,,Рахмет, әкем де Ильяны жақсы көреді.
Dialogue: 1,0:17:22.84,0:17:26.00,JP,NTP,0,0,0,,Ант еткенім рас.
Dialogue: 1,0:17:33.28,0:17:34.79,JP,NTP,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 1,0:17:35.84,0:17:36.50,JP,NTP,0,0,0,,Ілияс
Dialogue: 1,0:17:37.40,0:17:38.68,JP,NTP,0,0,0,,Ілияс
Dialogue: 1,0:17:39.17,0:17:43.79,JP,NTP,0,0,0,,Илья Илья...
Dialogue: 1,0:17:46.01,0:17:48.75,JP,NTP,0,0,0,,Неліктен, неге бұлай?
Dialogue: 1,0:17:48.86,0:17:52.43,JP,NTP,0,0,0,,Сіз біздің Ілияссыз
Dialogue: 1,0:17:58.86,0:18:00.06,JP,NTP,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 1,0:18:01.24,0:18:03.03,JP,NTP,0,0,0,,Неліктен?
Dialogue: 1,0:18:03.73,0:18:09.96,JP,NTP,0,0,0,,Неліктен бізге Қасиетті Граилдан бас тартасың?
Dialogue: 1,0:18:13.69,0:18:16.95,JP,NTP,0,0,0,,Алты миллиард адам және
Dialogue: 1,0:18:17.09,0:18:19.98,JP,NTP,0,0,0,,Мен сені қарғаймын
Dialogue: 1,0:18:20.96,0:18:23.42,JP,NTP,0,0,0,,Кирицугу Эмия
Dialogue: 1,0:18:23.94,0:18:25.24,JP,NTP,0,0,0,,Отбасының екі мүшесі
Dialogue: 1,0:18:25.39,0:18:29.29,JP,NTP,0,0,0,,Анри Маю сізге қарғыс айтады
Dialogue: 1,0:18:29.43,0:18:30.82,JP,NTP,0,0,0,,Бұл анық
Dialogue: 1,0:18:31.36,0:18:32.64,JP,NTP,0,0,0,,Азап
Dialogue: 1,0:18:32.92,0:18:33.50,JP,NTP,0,0,0,,Бұл анық
Dialogue: 1,0:18:33.63,0:18:34.52,JP,NTP,0,0,0,,Өлгенге дейін
Dialogue: 1,0:18:34.78,0:18:35.63,JP,NTP,0,0,0,,Өлтіремін
Dialogue: 1,0:18:35.73,0:18:36.77,JP,NTP,0,0,0,,Тәубе ету
Dialogue: 1,0:18:37.60,0:18:38.82,JP,NTP,0,0,0,,Мүлдем
Dialogue: 1,0:18:39.03,0:18:42.75,JP,NTP,0,0,0,,Ешкімнің шағымдануына жол бермеймін
Dialogue: 1,0:18:42.83,0:18:45.20,JP,NTP,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 1,0:19:11.14,0:19:13.84,JP,NTP,0,0,0,,Қандай қызықсыз аяқталды.
Dialogue: 1,0:19:15.56,0:19:17.50,JP,NTP,0,0,0,,Неліктен одан бас тарттыңыз?
Dialogue: 1,0:19:18.02,0:19:19.98,JP,NTP,0,0,0,,Сіз де көрдіңіз бе?
Dialogue: 1,0:19:20.40,0:19:23.52,JP,NTP,0,0,0,,Бәрінен бас тартып, құрбандыққа шалдың.
Dialogue: 1,0:19:23.67,0:19:26.00,JP,NTP,0,0,0,,Сіз осы уақытқа дейін жетуіңіз керек еді.
Dialogue: 1,0:19:26.84,0:19:29.47,JP,NTP,0,0,0,,Алған нәрсенің құны
Dialogue: 1,0:19:29.76,0:19:31.91,JP,NTP,0,0,0,,Неліктен оны қазір күшін жоюға болады?
Dialogue: 1,0:19:32.55,0:19:34.77,JP,NTP,0,0,0,,Түсіну үшін тым ақымақ
Dialogue: 1,0:19:35.55,0:19:37.53,JP,NTP,0,0,0,,ол әкелетін нәрсеге қарағанда
Dialogue: 1,0:19:38.16,0:19:40.64,JP,NTP,0,0,0,,Бұл құрбандық ауырырақ.
Dialogue: 1,0:19:41.16,0:19:42.74,JP,NTP,0,0,0,,Барлығы осы.
Dialogue: 1,0:19:43.25,0:19:46.69,JP,NTP,0,0,0,,Бұл әмбебап тілек машинасы емес.
Dialogue: 1,0:19:46.94,0:19:48.76,JP,NTP,0,0,0,,Олай болса маған бер.
Dialogue: 1,0:19:49.10,0:19:53.44,JP,NTP,0,0,0,,Саған қажет емес нәрсе маған пайдалы.
Dialogue: 1,0:19:53.94,0:19:57.75,JP,NTP,0,0,0,,Ондай нәрсе туа қалса.
Dialogue: 1,0:19:58.16,0:20:02.82,JP,NTP,0,0,0,,Менің барлық күмәндеріме жауап беру керек
Dialogue: 1,0:20:03.20,0:20:06.99,JP,NTP,0,0,0,,Ол өз өмірін, туғанын қалайды.
Dialogue: 1,0:20:07.55,0:20:09.32,JP,NTP,0,0,0,,Өтінемін, мені өлтірме
Dialogue: 1,0:20:10.12,0:20:10.90,JP,NTP,0,0,0,,Яғни
Dialogue: 1,0:20:16.09,0:20:17.43,JP,NTP,0,0,0,,Бұл сенсің
Dialogue: 1,0:20:18.09,0:20:21.38,JP,NTP,0,0,0,,Сіз тым ақымақ екенсіз.
Dialogue: 1,0:20:31.24,0:20:33.13,JP,NTP,0,0,0,,Ирисвиел
Dialogue: 1,0:20:35.94,0:20:37.62,JP,NTP,0,0,0,,Сіз кешігіп қалдыңыз, Сабер.
Dialogue: 1,0:20:37.81,0:20:40.79,JP,NTP,0,0,0,,Мен таныс ессіз итпен ойнасам да
Dialogue: 1,0:20:41.10,0:20:45.11,JP,NTP,0,0,0,,Мені күту өте ақылсыздық.
Dialogue: 1,0:20:45.27,0:20:46.22,JP,NTP,0,0,0,,Садақшы
Dialogue: 1,0:20:47.96,0:20:50.23,JP,NTP,0,0,0,,Сенің жүзің қандай!
Dialogue: 1,0:20:50.70,0:20:53.31,JP,NTP,0,0,0,,Аштан өлген ит сияқты емес пе?
Dialogue: 1,0:20:54.03,0:20:56.14,JP,NTP,0,0,0,,Бірақ істер осылай жалғаса берсе,
Dialogue: 1,0:20:57.09,0:21:00.91,JP,NTP,0,0,0,,Қасиетті Граил менікі
Dialogue: 1,0:21:04.18,0:21:05.59,JP,NTP,0,0,0,,Сабер
Dialogue: 1,0:21:05.98,0:21:09.00,JP,NTP,0,0,0,,Аңдауға түсіп, жермен жорғалау
Dialogue: 1,0:21:09.36,0:21:12.42,JP,NTP,0,0,0,,Сіз әдемі әйелсіз
Dialogue: 1,0:21:14.21,0:21:16.24,JP,NTP,0,0,0,,Қылышыңды қойып, менің әйелім бол.
Dialogue: 1,0:21:18.04,0:21:20.30,JP,NTP,0,0,0,,Ғажайыптарды жүзеге асыратын қасиетті гриль, т.б.
Dialogue: 1,0:21:20.65,0:21:24.74,JP,NTP,0,0,0,,Мұндай күдікті нәрсеге байлануының себебі неде?
Dialogue: 1,0:21:26.38,0:21:30.38,JP,NTP,0,0,0,,Барлық түкке тұрғысыз идеалдарыңыз бен анттарыңыздан бас тартыңыз.
Dialogue: 1,0:21:30.54,0:21:34.16,JP,NTP,0,0,0,,Бұдан былай тек мені іздеп, тек менімен боя.
Dialogue: 1,0:21:34.40,0:21:38.42,JP,NTP,0,0,0,,Әлем патшасының атымен
Dialogue: 1,0:21:38.84,0:21:41.95,JP,NTP,0,0,0,,Мен саған бұл дүниенің барлық рахатын, қуанышын сыйлаймын.
Dialogue: 1,0:21:43.45,0:21:46.78,JP,NTP,0,0,0,,Осындай бос сөздің кесірінен сен
Dialogue: 1,0:21:47.27,0:21:49.16,JP,NTP,0,0,0,,Қасиетті құлымды алып кетесің бе?
Dialogue: 1,0:21:53.05,0:21:55.27,JP,NTP,0,0,0,,Мен сіздің өсиетіңізді естіген жоқпын.
Dialogue: 1,0:21:56.14,0:21:58.06,JP,NTP,0,0,0,,Бұл менің шешімім.
Dialogue: 1,0:21:59.49,0:22:02.39,JP,NTP,0,0,0,,Енді жауабын тыңдайық.
Dialogue: 1,0:22:02.84,0:22:04.80,JP,NTP,0,0,0,,Мүлдем бас тарту
Dialogue: 1,0:22:06.69,0:22:09.54,JP,NTP,0,0,0,,Сіз бірдеңе айтуға ұяласыз ба?
Dialogue: 1,0:22:10.01,0:22:13.93,JP,NTP,0,0,0,,Жарайды, қанша рет қате айтсам да кешіремін.
Dialogue: 1,0:22:14.07,0:22:16.43,JP,NTP,0,0,0,,Маған қызмет етудің қуанышын білу
Dialogue: 1,0:22:16.82,0:22:20.24,JP,NTP,0,0,0,,Алдымен ауырсыну арқылы үйрену керек.
Dialogue: 1,0:22:28.42,0:22:29.83,JP,NTP,0,0,0,,Кирицугу
Dialogue: 1,0:22:34.97,0:22:37.19,JP,NTP,0,0,0,,Ақырында шешім қабылдадыңыз ба?
Dialogue: 1,0:22:37.69,0:22:42.15,JP,NTP,0,0,0,,Эмия Кирицугының атынан мен сізге бұйрықты сиқырмен бұйырдым.
Dialogue: 1,0:22:42.52,0:22:44.93,JP,NTP,0,0,0,,Маған Қасиетті Граильді беріңіз
Dialogue: 1,0:22:45.23,0:22:48.04,JP,NTP,0,0,0,,Сабер, Қасиетті Граалды алу үшін асыл фантасмаңызды пайдаланыңыз.
Dialogue: 1,0:22:49.22,0:22:50.67,JP,NTP,0,0,0,,Жою
Dialogue: 1,0:22:51.46,0:22:52.11,JP,NTP,0,0,0,,На
Dialogue: 1,0:22:54.55,0:22:55.37,JP,NTP,0,0,0,,Мүмкін емес
Dialogue: 1,0:22:55.74,0:22:57.30,JP,NTP,0,0,0,,Нені айтып тұрсың, Сабер?
Dialogue: 1,0:22:58.29,0:22:59.23,JP,NTP,0,0,0,,Жоқ
Dialogue: 1,0:22:59.87,0:23:03.51,JP,NTP,0,0,0,,Үшінші пәрмен емлесі арқылы қайтадан пәрмен беріңіз
Dialogue: 1,0:23:04.49,0:23:05.75,JP,NTP,0,0,0,,Неге, Кирицугу
Dialogue: 1,0:23:06.13,0:23:07.90,JP,NTP,0,0,0,,Егер сіз
Dialogue: 1,0:23:08.31,0:23:09.29,JP,NTP,0,0,0,,Мақсатқа жету біртүрлі бос сезім екен, иә?
Dialogue: 1,0:23:09.55,0:23:14.59,JP,NTP,0,0,0,,Сен менің тойыма кедергі келтіріп тұрсың ба, дәулет?
Dialogue: 1,0:23:14.78,0:23:17.30,JP,NTP,0,0,0,,Сабер Қасиетті Граил
Dialogue: 1,0:23:18.03,0:23:19.43,JP,NTP,0,0,0,,Тоқта
Dialogue: 1,0:23:19.87,0:23:21.43,JP,NTP,0,0,0,,Оны жойыңыз.
Dialogue: 1,0:24:56.77,0:24:58.84,JP,NTP,0,0,0,,Сол жүз есімде
Dialogue: 1,0:24:59.15,0:25:00.50,JP,NTP,0,0,0,,Көз жасыммен
Dialogue: 1,0:25:00.79,0:25:02.71,JP,NTP,0,0,0,,Мен шын жүректен қуаныштымын
Dialogue: 1,0:25:03.15,0:25:04.52,JP,NTP,0,0,0,,Адам фигурасы
Dialogue: 1,0:25:05.34,0:25:07.77,JP,NTP,0,0,0,,Ер адам бір нәрсеге риза болуы керек
Dialogue: 1,0:25:08.42,0:25:10.60,JP,NTP,0,0,0,,«Рахмет» дедім
Dialogue: 0,0:25:12.10,0:25:18.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
