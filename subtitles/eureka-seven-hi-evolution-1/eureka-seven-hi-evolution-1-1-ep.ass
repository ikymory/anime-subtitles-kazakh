Dialogue: 0,0:07:58.39,0:08:04.40,Default,,0,0,0,,5 4 3 2 1 0
Dialogue: 0,0:08:04.94,0:08:06.02,Default,,0,0,0,,Міне!
Dialogue: 0,0:08:10.53,0:08:12.03,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:08:14.61,0:08:15.66,Default,,0,0,0,,Аман қалдыңыз ба?
Dialogue: 0,0:08:18.95,0:08:22.37,Default,,0,0,0,,Ха... дәрігердің айтқаны осы ма?
Dialogue: 0,0:08:22.71,0:08:27.42,Default,,0,0,0,,Дұрыс, бұл жауынгерлік оқтұмсық күміс қорап.
Dialogue: 0,0:08:38.64,0:08:44.64,Default,,0,0,0,,(Күміс қораптағы музыка)
Dialogue: 0,0:08:54.32,0:08:56.66,Default,,0,0,0,,Мен доктордан естідім.
Dialogue: 0,0:08:57.45,0:09:02.62,Default,,0,0,0,,Адам даналығының шоғырлануы шешуші оқтұмсық күміс жәшік
Dialogue: 0,0:09:03.29,0:09:07.42,Default,,0,0,0,,Жоқ, бұл не нәрсе?
Dialogue: 0,0:09:29.06,0:09:31.02,Default,,0,0,0,,Күміс қорап
Dialogue: 0,0:09:31.15,0:09:33.07,Default,,0,0,0,,Ол сәтті пайдалануға берілді ме?
Dialogue: 0,0:09:33.40,0:09:34.94,Default,,0,0,0,,Міне осылай.
Dialogue: 0,0:09:35.44,0:09:38.20,Default,,0,0,0,,Бірақ мұндай оғаш қару
Dialogue: 0,0:09:38.32,0:09:40.16,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:09:40.28,0:09:43.74,Default,,0,0,0,,Сондықтан олар доктор Турстонды түрмеге қамады ма?
Dialogue: 0,0:09:44.08,0:09:45.20,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:09:45.33,0:09:47.46,Default,,0,0,0,,Өзінің стратегиясын жоспарлады.
Dialogue: 0,0:09:47.58,0:09:49.92,Default,,0,0,0,,Үлкен инвестиция салған соң
Dialogue: 0,0:09:50.04,0:09:53.42,Default,,0,0,0,,Ол кенет маған мұны тоқтатуымды айтты.
Dialogue: 0,0:09:54.01,0:09:57.47,Default,,0,0,0,,Сіз армандаған нәрсе көз алдыңызға келгенде
Dialogue: 0,0:09:57.76,0:10:00.68,Default,,0,0,0,,Сіз кенеттен белде әлсіздік сезінуіңіз мүмкін.
Dialogue: 0,0:10:01.51,0:10:03.35,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:10:03.47,0:10:04.60,Default,,0,0,0,,Біреуді алдағың келсе
Dialogue: 0,0:10:05.06,0:10:07.27,Default,,0,0,0,,Сіз мұны соңына дейін ұстануыңыз керек, солай ма?
Dialogue: 0,0:10:07.85,0:10:10.31,Default,,0,0,0,,Маған басшылық бере алмайтын нәрсе
Dialogue: 0,0:10:10.44,0:10:13.07,Default,,0,0,0,,Сіз адамдарға жол көрсете аласыз ба?
Dialogue: 0,0:10:13.19,0:10:15.82,Default,,0,0,0,,Адамның еркі енді маңызды емес.
Dialogue: 0,0:10:16.49,0:10:21.24,Default,,0,0,0,,Бұл операция басталғаннан бері бұл адам батыр болды.
Dialogue: 0,0:10:21.53,0:10:26.79,Default,,0,0,0,,Батыр ретінде аман қалу немесе өлу ғана қалды.
Dialogue: 0,0:10:27.79,0:10:29.33,Default,,0,0,0,,Күміс жәшік дегеніміз не?
Dialogue: 0,0:10:29.46,0:10:32.67,Default,,0,0,0,,Музыкалық қару деп аталмайды ма?
Dialogue: 0,0:10:33.67,0:10:36.34,Default,,0,0,0,,Әлемді музыкамен құтқарыңыз
Dialogue: 0,0:10:36.55,0:10:41.22,Default,,0,0,0,,Мен бәрін арман сияқты нәрсеге көбірек салуым керек
Dialogue: 0,0:10:41.34,0:10:44.43,Default,,0,0,0,,Біздің жоспарымыз жоқ.
Dialogue: 0,0:10:46.27,0:10:49.81,Default,,0,0,0,,Дәрігер айтқандай, әлгі күміс қорап соқты.
Dialogue: 0,0:10:49.94,0:10:52.02,Default,,0,0,0,,Scab ырғағымен синхрондау мүмкіндігіңіз болса...
Dialogue: 0,0:10:52.90,0:10:53.94,Default,,0,0,0,,Чарльз!
Dialogue: 0,0:10:54.36,0:10:56.15,Default,,0,0,0,,Фестиваль басталды
Dialogue: 0,0:10:56.32,0:10:58.49,Default,,0,0,0,,Міне, Коралиан келеді.
Dialogue: 0,0:11:01.45,0:11:05.87,Default,,0,0,0,,Хехехе Маған бұл барабан орамы ұнайды
Dialogue: 0,0:11:06.12,0:11:08.83,Default,,0,0,0,,Бұны ести беру – босқа.
Dialogue: 0,0:11:08.95,0:11:11.75,Default,,0,0,0,,Біз бұл жерді қандай жағдайда да қорғауымыз керек!
Dialogue: 0,0:11:23.76,0:11:25.22,Default,,0,0,0,,Дыбыс
Dialogue: 0,0:11:27.60,0:11:29.89,Default,,0,0,0,,Жауынгерлік оқтұмсықтың күміс қорабынан
Dialogue: 0,0:11:30.02,0:11:33.40,Default,,0,0,0,,А дыбысы жасалғанша, бұл жақсы.
Dialogue: 0,0:11:34.69,0:11:37.19,Default,,0,0,0,,А дыбысы жасалғанша
Dialogue: 0,0:11:37.65,0:11:39.94,Default,,0,0,0,,Бұл біздің адамзаттың қайта тірілуі!
Dialogue: 0,0:11:44.16,0:11:45.66,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:46.83,0:11:47.66,Default,,0,0,0,,А…?
Dialogue: 0,0:11:50.16,0:11:52.54,Default,,0,0,0,,Ха! Қышқылды дыбыс синхрондалмаған ба?
Dialogue: 0,0:11:52.67,0:11:53.50,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:12:02.30,0:12:03.22,Default,,0,0,0,,Чарльз
Dialogue: 0,0:12:03.97,0:12:05.93,Default,,0,0,0,,Күміс қорап синхрондалмаған
Dialogue: 0,0:12:06.39,0:12:07.93,Default,,0,0,0,,Бұлай жалғаса берсе, ол бақылаудан шығады!
Dialogue: 0,0:12:09.06,0:12:09.93,Default,,0,0,0,,Рэй!
Dialogue: 0,0:12:10.06,0:12:11.27,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:23.07,0:12:24.49,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:33.96,0:12:37.17,Default,,0,0,0,,Пойнт Вудстокте байқалған траппердің жарылысы
Dialogue: 0,0:12:37.29,0:12:38.46,Default,,0,0,0,,Күлгін деңгей
Dialogue: 0,0:12:38.59,0:12:40.21,Default,,0,0,0,,Құрлық әскерлері туралы не деуге болады? (Экипаж В) Жауап жоқ
Dialogue: 0,0:12:40.34,0:12:42.17,Default,,0,0,0,,Күміс жәшік жұмыс істей ме?
Dialogue: 0,0:12:42.30,0:12:44.43,Default,,0,0,0,,Ешқандай сигнал қабылданбады Бақыланбайтын
Dialogue: 0,0:12:44.68,0:12:46.55,Default,,0,0,0,,Бұл Юки Тарухо, операциялық бөлімнің бастығы.
Dialogue: 0,0:12:46.68,0:12:48.60,Default,,0,0,0,,SOF-ті бірден Вудсток нүктесіне жылжытыңыз
Dialogue: 0,0:12:48.72,0:12:49.56,Default,,0,0,0,,Жіберіңіз
Dialogue: 0,0:12:49.68,0:12:50.51,Default,,0,0,0,,Бас Юки
Dialogue: 0,0:12:50.81,0:12:52.81,Default,,0,0,0,,Күлгін тұзақшы турбуленттілік деңгейінде
Dialogue: 0,0:12:52.93,0:12:54.81,Default,,0,0,0,,Секіруге болатын KLF жұмбақтары жоқ.
Dialogue: 0,0:12:54.94,0:12:57.02,Default,,0,0,0,,Енді қонған күміс жәшікке назар аударайық.
Dialogue: 0,0:12:57.15,0:12:58.48,Default,,0,0,0,,Сіз оны жоғалтқыңыз келе ме?
Dialogue: 0,0:12:58.86,0:13:01.28,Default,,0,0,0,,Күміс жәшік бақылаудан шығып кеткен шығар.
Dialogue: 0,0:13:01.40,0:13:04.28,Default,,0,0,0,,Оны басқарудың жалғыз жолы - қолмен.
Dialogue: 0,0:13:04.45,0:13:08.03,Default,,0,0,0,,SOF-те рифбордшылардан KLF шабандоздары бар.
Dialogue: 0,0:13:08.32,0:13:10.08,Default,,0,0,0,,Егер олар бұл толқынды жеңе алса
Dialogue: 0,0:13:10.20,0:13:12.62,Default,,0,0,0,,Сіз контроллерге қол жеткізе алуыңыз керек.
Dialogue: 0,0:13:13.37,0:13:15.00,Default,,0,0,0,,Маған оңай айтыңыз
Dialogue: 0,0:13:18.00,0:13:19.00,Default,,0,0,0,,Бірақ бұл трагедия
Dialogue: 0,0:13:19.88,0:13:20.92,Default,,0,0,0,,Тек біз үшін Refriders
Dialogue: 0,0:13:21.05,0:13:22.38,Default,,0,0,0,,Жақындай алмайсыз ба?
Dialogue: 0,0:13:25.09,0:13:26.59,Default,,0,0,0,,Дьюи Новак, ефрейтор.
Dialogue: 0,0:13:26.72,0:13:28.30,Default,,0,0,0,,Мен сені қазір жіберемін.
Dialogue: 0,0:13:28.76,0:13:31.01,Default,,0,0,0,,Голландия, менің артымнан келе аласыз ба?
Dialogue: 0,0:13:31.35,0:13:33.06,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:13:34.02,0:13:37.14,Default,,0,0,0,,Мәңгілік бала болмайсың.
Dialogue: 0,0:13:46.15,0:13:47.99,Default,,0,0,0,,Эй, кел!
Dialogue: 0,0:13:48.11,0:13:48.99,Default,,0,0,0,,Алға!
Dialogue: 0,0:13:49.11,0:13:51.74,Default,,0,0,0,,Енді мен сенен көмек сұраймын, Юдзуру.
Dialogue: 0,0:13:51.87,0:13:52.70,Default,,0,0,0,,Көмек көрсете алмайды
Dialogue: 0,0:13:52.83,0:13:53.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:54.20,0:13:58.08,Default,,0,0,0,,Біздің кеме енді жақындап келе жатқан көтерілісшілердің ұшағын ұстап алады.
Dialogue: 0,0:13:58.21,0:14:00.63,Default,,0,0,0,,Көтерілісшілердің ұшағы? Эй, сен не деп тұрсың?
Dialogue: 0,0:14:00.75,0:14:01.71,Default,,0,0,0,,Қарамаңдар! (ескерту дыбысы)
Dialogue: 0,0:14:01.84,0:14:02.67,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:04.80,0:14:05.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:29.03,0:14:31.62,Default,,0,0,0,,Солай... соңы жоқ!
Dialogue: 0,0:14:35.45,0:14:37.04,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:40.08,0:14:43.25,Default,,0,0,0,,Ей, аға, бұл да доктор Турстондікі...
Dialogue: 0,0:14:43.59,0:14:45.88,Default,,0,0,0,,Қожамыздың күткені осы ма?
Dialogue: 0,0:14:46.01,0:14:47.01,Default,,0,0,0,,біз қайта орала аламыз.
Dialogue: 0,0:14:47.13,0:14:48.88,Default,,0,0,0,,Басқаша болса да, басқа амал жоқ.
Dialogue: 0,0:14:49.01,0:14:49.84,Default,,0,0,0,,Голландия!
Dialogue: 0,0:14:59.77,0:15:01.52,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:01.65,0:15:04.23,Default,,0,0,0,,Операциялар бөлімінен SOF002 дейін
Dialogue: 0,0:15:04.69,0:15:08.82,Default,,0,0,0,,SOF002 пәрменін өзгерту бірден кері қайтарылады.
Dialogue: 0,0:15:09.19,0:15:11.03,Default,,0,0,0,,Көтерілісшілердің ұшағы ұсталды
Dialogue: 0,0:15:11.16,0:15:13.12,Default,,0,0,0,,А... Юдзуру келе жатыр еді, солай ма?
Dialogue: 0,0:15:13.24,0:15:15.08,Default,,0,0,0,,Юзуру батып кетті, иә?
Dialogue: 0,0:15:15.45,0:15:19.37,Default,,0,0,0,,Стратегияны SOF001-ге қалдырыңыз және ұстап алуды алыңыз.
Dialogue: 0,0:15:20.33,0:15:23.50,Default,,0,0,0,,Жақындап келе жатқан бүлікшілер ұшағы - Origin Zero.
Dialogue: 0,0:15:24.04,0:15:26.67,Default,,0,0,0,,Ұшақта гуманоид Коралиялық Эврика бар...
Dialogue: 0,0:15:27.67,0:15:29.55,Default,,0,0,0,,Бортта Адрок Турстон бар.
Dialogue: 0,0:15:29.80,0:15:31.51,Default,,0,0,0,,Не... сонда?
Dialogue: 0,0:15:33.51,0:15:34.43,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:35.51,0:15:37.35,Default,,0,0,0,,Саған қалдырамын, інім!
Dialogue: 0,0:15:41.60,0:15:43.65,Default,,0,0,0,,Әй, аға!
Dialogue: 0,0:15:47.48,0:15:49.44,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:53.16,0:15:57.03,Default,,0,0,0,,Екі топқа бөлінді, Дьюи көш бастады.
Dialogue: 0,0:15:59.50,0:16:02.75,Default,,0,0,0,,1000 адамды өлтіру арқылы адам батыр болады дейді.
Dialogue: 0,0:16:03.75,0:16:06.00,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:16:06.25,0:16:07.59,Default,,0,0,0,,Adlock антиденелер келеді.
Dialogue: 0,0:16:18.64,0:16:20.98,Default,,0,0,0,,Кешіріңіз, Эврика.
Dialogue: 0,0:16:24.60,0:16:26.77,Default,,0,0,0,,Жарайды, мен саған сенемін.
Dialogue: 0,0:16:26.90,0:16:27.73,Default,,0,0,0,,Ах
Dialogue: 0,0:16:31.57,0:16:34.91,Default,,0,0,0,,Ұстаз! Жолды ашыңыз
Dialogue: 0,0:16:35.41,0:16:37.99,Default,,0,0,0,,Мені атып тастауға бұйрық беру керек еді.
Dialogue: 0,0:16:39.08,0:16:41.37,Default,,0,0,0,,Голландия сарбаз ретінде дисквалификацияланды.
Dialogue: 0,0:16:41.62,0:16:45.04,Default,,0,0,0,,Сіз дисквалификацияланған кезде, мен сізге еріп жүруіңізді сұраймын.
Dialogue: 0,0:16:45.87,0:16:47.08,Default,,0,0,0,,Жоқ, ей... Ұстаз!
Dialogue: 0,0:16:47.63,0:16:48.46,Default,,0,0,0,,Мен сақтық көшірме жасауды сұраймын!
Dialogue: 0,0:16:49.75,0:16:52.80,Default,,0,0,0,,Күте тұрыңыз, ұстаз, не болды?
Dialogue: 0,0:16:54.17,0:16:55.59,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:17:00.39,0:17:04.64,Default,,0,0,0,,Мен фейк болдым.
Dialogue: 0,0:17:05.39,0:17:06.23,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:17:06.98,0:17:10.15,Default,,0,0,0,,Дүниені жалған жолмен құтқаруға тырысты
Dialogue: 0,0:17:10.36,0:17:13.49,Default,,0,0,0,,Ал... үкім шығаруда қателесті.
Dialogue: 0,0:17:13.94,0:17:15.07,Default,,0,0,0,,барлығына өзімді дәлелдеуім керек сияқты.
Dialogue: 0,0:17:15.20,0:17:19.58,Default,,0,0,0,,Алып кеткендері өздері кінәлі, хаха.
Dialogue: 0,0:17:20.91,0:17:24.96,Default,,0,0,0,,Бірақ, Голландия, мен барамын.
Dialogue: 0,0:17:25.75,0:17:28.00,Default,,0,0,0,,Менің қателігімді түзету үшін
Dialogue: 0,0:17:30.59,0:17:33.63,Default,,0,0,0,,Барлығын аяқтап, бәрін бастау
Dialogue: 0,0:17:35.09,0:17:36.84,Default,,0,0,0,,Ұстаз, біз не істеуіміз керек?
Dialogue: 0,0:17:37.68,0:17:39.09,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:17:41.64,0:17:43.47,Default,,0,0,0,,Ұстаз~!
Dialogue: 0,0:17:47.85,0:17:49.77,Default,,0,0,0,,Мәліметтерге сәйкес, күміс жәшік
Dialogue: 0,0:17:49.90,0:17:51.44,Default,,0,0,0,,Бұл синхрондалмайды, солай ма?\NЕгер
Dialogue: 0,0:17:52.07,0:17:52.90,Default,,0,0,0,,...
Dialogue: 0,0:17:53.44,0:17:55.53,Default,,0,0,0,,Мен не істеу керектігін шешіп қойдым.
Dialogue: 0,0:17:55.78,0:17:56.74,Default,,0,0,0,,Дьюи!
Dialogue: 0,0:18:09.21,0:18:10.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:14.13,0:18:15.21,Default,,0,0,0,,Синхрондалмаған жағдайда
Dialogue: 0,0:18:15.34,0:18:17.97,Default,,0,0,0,,Менің ойымша, оларды физикалық түрде байланыстырған дұрыс болар еді!
Dialogue: 0,0:18:29.73,0:18:31.61,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:18:32.19,0:18:34.98,Default,,0,0,0,,Ауырды... Ах!
Dialogue: 0,0:18:44.95,0:18:45.83,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:46.45,0:18:49.75,Default,,0,0,0,,Күміс жәшіктер физикалық байланысқан ба?
Dialogue: 0,0:18:51.08,0:18:53.29,Default,,0,0,0,,Мүмкін емес Мәміле неде?
Dialogue: 0,0:18:53.59,0:18:55.42,Default,,0,0,0,,Дәрігер нұсқаулығында жоқ
Dialogue: 0,0:18:55.71,0:18:56.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:59.84,0:19:00.68,Default,,0,0,0,,Мен шынымен де мықты энергияны сезіп тұрмын!
Dialogue: 0,0:19:01.68,0:19:02.89,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:05.47,0:19:07.35,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:19:07.56,0:19:08.48,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:22.66,0:19:23.82,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:19:24.58,0:19:25.62,Default,,0,0,0,,Эй, бұл сөзсіз күдікті. Ішінде бірдеңе бар.
Dialogue: 0,0:19:25.74,0:19:26.79,Default,,0,0,0,,Эвакуациялаңыз! иә?
Dialogue: 0,0:19:27.33,0:19:30.04,Default,,0,0,0,,Мен уақытында үлгере алмадым, сондықтан әзірше шегінемін.
Dialogue: 0,0:19:30.62,0:19:31.92,Default,,0,0,0,,Көбейту орын алады
Dialogue: 0,0:19:32.21,0:19:33.50,Default,,0,0,0,,Сіз қуып жетесіз!
Dialogue: 0,0:19:33.63,0:19:36.17,Default,,0,0,0,,Көбейту керек пе? Бұл не?
Dialogue: 0,0:19:47.97,0:19:50.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:22.13,0:20:24.13,Default,,0,0,0,,Не? не болып жатыр?
Dialogue: 0,0:20:24.51,0:20:27.18,Default,,0,0,0,,Пойнт Вудстокте белгісіз құбылыс болды.
Dialogue: 0,0:20:27.30,0:20:28.72,Default,,0,0,0,,Жер қыртысы жұтылады
Dialogue: 0,0:20:28.85,0:20:33.06,Default,,0,0,0,,Прогресс болжамды жылдамдық секундына 2,5 километр
Dialogue: 0,0:20:33.44,0:20:36.65,Default,,0,0,0,,Екі сағаттан кейін Жердің көп бөлігі жұтылады.
Dialogue: 0,0:20:36.77,0:20:38.90,Default,,0,0,0,,Құбылыстың энергиясын талдауға болмайды!
Dialogue: 0,0:20:39.02,0:20:41.65,Default,,0,0,0,,Жермен байланыс бірінен соң бірі үзіледі.
Dialogue: 0,0:20:41.78,0:20:42.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:43.53,0:20:45.86,Default,,0,0,0,,Қалалар телеграф арқылы қоштасып жатыр.
Dialogue: 0,0:20:45.99,0:20:49.16,Default,,0,0,0,,Бұл құбылыс жақын арада Батыс жарты шарға жетеді деп күтілуде.
Dialogue: 0,0:20:49.37,0:20:51.12,Default,,0,0,0,,Ах... біреу...
Dialogue: 0,0:20:51.58,0:20:54.08,Default,,0,0,0,,Мұны біреу тоқтата ала ма?
Dialogue: 0,0:20:55.17,0:20:56.46,Default,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:21:00.75,0:21:03.05,Default,,0,0,0,,Кетчуппен бүтіндей бүркелген—
Dialogue: 0,0:21:04.42,0:21:05.43,Default,,0,0,0,,Мастер
Dialogue: 0,0:21:06.64,0:21:11.18,Default,,0,0,0,,Ұстаз, мен де барамын. Сізге көмектесуге рұқсат етіңіз.
Dialogue: 0,0:21:12.89,0:21:13.85,Default,,0,0,0,,Голландия
Dialogue: 0,0:21:15.14,0:21:16.85,Default,,0,0,0,,Сіз осында болыңыз.
Dialogue: 0,0:21:17.06,0:21:18.15,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:21:18.40,0:21:20.11,Default,,0,0,0,,Менің өтінішім бар! иә?
Dialogue: 0,0:21:21.73,0:21:25.20,Default,,0,0,0,,Балалардан сұра...
Dialogue: 0,0:21:26.66,0:21:31.33,Default,,0,0,0,,Не? Мастер~!
Dialogue: 0,0:21:33.54,0:21:35.41,Default,,0,0,0,,Adlock-қа барайық
Dialogue: 0,0:21:35.54,0:21:37.42,Default,,0,0,0,,Жоқ, сен де.
Dialogue: 0,0:21:37.83,0:21:38.67,Default,,0,0,0,,Не?
Dialogue: 0,0:21:39.13,0:21:41.59,Default,,0,0,0,,Барлығы үшін рахмет Эврика
Dialogue: 0,0:21:42.71,0:21:45.55,Default,,0,0,0,,Сен де менің баламсың.
Dialogue: 0,0:21:51.43,0:21:53.89,Default,,0,0,0,,Неліктен? Неліктен?
Dialogue: 0,0:21:54.27,0:21:55.93,Default,,0,0,0,,Adlock~!
Dialogue: 0,0:22:00.44,0:22:01.44,Default,,0,0,0,,Хаа~
Dialogue: 0,0:22:02.82,0:22:03.65,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:22:04.15,0:22:06.82,Default,,0,0,0,,Неге оны сонда қалдырдың, Адлок?
Dialogue: 0,0:22:07.11,0:22:10.32,Default,,0,0,0,,Adlock Adlock! Неге!
Dialogue: 0,0:22:10.62,0:22:15.04,Default,,0,0,0,,Барма, Адрок, мені тастама!
Dialogue: 0,0:22:15.54,0:22:19.33,Default,,0,0,0,,Кешіріңіз, Эврика, мен сізбен бара алмаймын.
Dialogue: 0,0:22:19.46,0:22:21.96,Default,,0,0,0,,Барсаң, мен сені пайдаланамын.
Dialogue: 0,0:22:22.50,0:22:26.67,Default,,0,0,0,,Сені құрбан ет, Коралиан, адамға ыңғайлы болу үшін.
Dialogue: 0,0:22:27.01,0:22:29.89,Default,,0,0,0,,Мен бұған жол бермеймін.
Dialogue: 0,0:22:30.05,0:22:30.89,Default,,0,0,0,,Га
Dialogue: 0,0:22:32.18,0:22:35.77,Default,,0,0,0,,Менің саған көрсететін ештеңем жоқ еді.
Dialogue: 0,0:22:37.18,0:22:40.56,Default,,0,0,0,,Біздің қолымыздан келгені мұны тоқтату.
Dialogue: 0,0:22:41.73,0:22:44.19,Default,,0,0,0,,Балалар сендерге не болады... Ой!
Dialogue: 0,0:22:44.82,0:22:47.15,Default,,0,0,0,,Өзіңіз біліңіз!
Dialogue: 0,0:22:48.28,0:22:51.24,Default,,0,0,0,,Менің қолымнан келмеген нәрсені жеңу
Dialogue: 0,0:22:51.99,0:22:53.49,Default,,0,0,0,,Орындаңыз!
Dialogue: 0,0:22:55.70,0:22:59.16,Default,,0,0,0,,«Өтінем, жең, ол саған берілмейді».
Dialogue: 0,0:22:59.41,0:23:01.75,Default,,0,0,0,,Мен өмірімді соған сеніп өттім
Dialogue: 0,0:23:03.04,0:23:05.84,Default,,0,0,0,,Ал қазір және болашақта...
Dialogue: 0,0:23:09.05,0:23:10.43,Default,,0,0,0,,Уау... Ах!
Dialogue: 0,0:23:15.47,0:23:16.47,Default,,0,0,0,,О? Сіздер әлдеқашан бастадыңыздар ма? Әңгіме
Dialogue: 0,0:23:17.14,0:23:19.98,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:23:21.10,0:23:22.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:27.32,0:23:29.65,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:23:30.99,0:23:35.24,Default,,0,0,0,,Құдай-ау, мынау дүние ме?
Dialogue: 0,0:23:36.28,0:23:40.21,Default,,0,0,0,,Қандай жігерлі, қандай тәтті
Dialogue: 0,0:23:40.54,0:23:44.88,Default,,0,0,0,,Бұл шын мәнінде Махаббат жазы.
Dialogue: 0,0:23:46.34,0:23:50.42,Default,,0,0,0,,Мен оны Рентонға көрсеткім келді.
Dialogue: 0,0:24:19.41,0:24:22.21,Default,,0,0,0,,Содан бері 10 жыл өтті
Dialogue: 0,0:24:23.00,0:24:26.63,Default,,0,0,0,,Баланың ересек болуы үшін осы уақыт жеткілікті.
Dialogue: 0,0:24:27.34,0:24:32.30,Default,,0,0,0,,Жерді күл басып, күн сәулесі екі есе азайған күннен бастап.
Dialogue: 0,0:24:32.42,0:24:36.68,Default,,0,0,0,,Біз қиын жолдан өттік
Dialogue: 0,0:24:45.48,0:24:46.65,Default,,0,0,0,,Хаа…
Dialogue: 0,0:24:50.19,0:24:51.23,Default,,0,0,0,,Біз
Dialogue: 0,0:24:51.94,0:24:54.61,Default,,0,0,0,,Бұл жартылай қираған планетаны тастамаңыз
Dialogue: 0,0:24:54.99,0:24:57.37,Default,,0,0,0,,Мен қайта құруды шештім...
Dialogue: 0,0:24:57.49,0:25:02.79,Default,,0,0,0,,10 жыл бұрын сол күні бізді құтқару үшін күрескен
Dialogue: 0,0:25:02.91,0:25:06.83,Default,,0,0,0,,Қайтыс болған көптеген жерлестерді еске алу.
Dialogue: 0,0:25:06.96,0:25:09.09,Default,,0,0,0,,Марапаттау
Dialogue: 0,0:25:09.67,0:25:13.38,Default,,0,0,0,,Әлемнің күйреуін тоқтату стратегиясын жоспарлаңыз.
Dialogue: 0,0:25:13.59,0:25:15.68,Default,,0,0,0,,Ол да өмірден айырылды.
Dialogue: 0,0:25:15.80,0:25:18.30,Default,,0,0,0,,Доктор Адрок Турстон
Dialogue: 0,0:25:18.43,0:25:19.85,Default,,0,0,0,,Сол күн туралы
Dialogue: 0,0:25:19.97,0:25:22.68,Default,,0,0,0,,Олар оны «Махаббат жазы» деп атаса керек.
Dialogue: 0,0:25:23.56,0:25:28.40,Default,,0,0,0,,Махаббат жазы Қандай тәтті сөздер!
Dialogue: 0,0:25:28.73,0:25:33.28,Default,,0,0,0,,Дәрігер тәтті сөздерді қолданған шығар.
Dialogue: 0,0:25:33.40,0:25:36.20,Default,,0,0,0,,Бұл қиындықты жеңуге үміттену
Dialogue: 0,0:25:36.32,0:25:38.70,Default,,0,0,0,,Менің ойымша, сіз оны білдіргіңіз келді.
Dialogue: 0,0:25:39.28,0:25:41.12,Default,,0,0,0,,Біз бұған үміттенеміз
Dialogue: 0,0:25:41.24,0:25:43.83,Default,,0,0,0,,Мұрагерлік болуы керек
Dialogue: 0,0:25:50.29,0:25:53.63,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:26:17.20,0:26:20.32,Default,,0,0,0,,Қожайын маған таң қалды.
Dialogue: 0,0:26:21.53,0:26:23.79,Default,,0,0,0,,Саған сеніп тапсырдым, бірақ ештеңе істей алмадым.
Dialogue: 0,0:26:24.04,0:26:26.71,Default,,0,0,0,,Мен әскери ит болғандықтан
Dialogue: 0,0:26:27.29,0:26:28.25,Default,,0,0,0,,Сонымен, бұл ...
Dialogue: 0,0:26:28.37,0:26:31.25,Default,,0,0,0,,Сентименталды, ғылыми емес
Dialogue: 0,0:26:31.88,0:26:34.05,Default,,0,0,0,,Бірақ мен бұл сезімді түсінемін.
Dialogue: 0,0:26:35.05,0:26:37.59,Default,,0,0,0,,Соңында ештеңе істей алмадық
Dialogue: 0,0:26:41.97,0:26:44.93,Default,,0,0,0,,Сен анау-мынау баланы аласың.
Dialogue: 0,0:26:45.64,0:26:46.52,Default,,0,0,0,,О
Dialogue: 0,0:26:47.52,0:26:48.98,Default,,0,0,0,,Менімен келесің бе?
Dialogue: 0,0:26:49.56,0:26:50.85,Default,,0,0,0,,Мен сізге еремін.
Dialogue: 0,0:26:52.19,0:26:57.03,Default,,0,0,0,,Мен де дәрігер білетін шынайы дүниені көргім келеді.
Dialogue: 0,0:26:59.03,0:27:01.99,Default,,0,0,0,,Содан бері он жыл өтті.
Dialogue: 0,0:27:02.20,0:27:05.24,Default,,0,0,0,,Қирау жалғасуда
Dialogue: 0,0:27:05.37,0:27:08.33,Default,,0,0,0,,Тірі қалу үшін жерді бағындырамыз.
Dialogue: 0,0:27:09.00,0:27:11.50,Default,,0,0,0,,Біз бірге өмір сүруіміз керек
Dialogue: 0,0:27:11.75,0:27:14.84,Default,,0,0,0,,Бірақ үмітіңізді үзбеңіз
Dialogue: 0,0:27:16.30,0:27:19.80,Default,,0,0,0,,Күндердің күнінде бұлттар ашылып, нұр жауады.
Dialogue: 0,0:27:19.92,0:27:22.55,Default,,0,0,0,,Біз мұны мәлімдейміз
Dialogue: 0,0:27:22.89,0:27:25.60,Default,,0,0,0,,Махаббат жазы деген сөз
Dialogue: 0,0:27:25.72,0:27:30.06,Default,,0,0,0,,Үмітсіздікте үміт білдіретін сөздер емес
Dialogue: 0,0:27:30.19,0:27:35.23,Default,,0,0,0,,Біздің мақтаныш пен рухымыздың жеңістерін тойлау
Dialogue: 0,0:27:35.36,0:27:39.44,Default,,0,0,0,,Бұл бір дәуірдің аты деп ойлаймын.
Dialogue: 0,0:27:39.57,0:27:42.11,Default,,0,0,0,,Ол дәуір әдемі де бақытты болды.
Dialogue: 0,0:27:42.49,0:27:47.12,Default,,0,0,0,,Бұл бітпейтін мерекелер уақыты.
Dialogue: 0,0:27:48.75,0:27:50.54,Default,,0,0,0,,«Фестиваль» дегеніміз не?
Dialogue: 0,0:27:50.91,0:27:53.00,Default,,0,0,0,,Содан бері 10 жыл өтті, бірақ мен әлі түсінбеймін.
Dialogue: 0,0:27:53.12,0:27:56.50,Default,,0,0,0,,Не сақталса да, күйреу, қалпына келтіру, қайта құру, шешім қабылдау, армандар
Dialogue: 0,0:27:56.63,0:27:58.55,Default,,0,0,0,,Сіз не туралы айтып отырсыз? оған еш қатысы жоқ
Dialogue: 0,0:27:58.67,0:28:00.17,Default,,0,0,0,,Маған рұқсатсыз сеніп тапсырма.
Dialogue: 0,0:28:00.30,0:28:02.01,Default,,0,0,0,,Мені құтқаруыңды кім сұрады?
Dialogue: 0,0:28:02.13,0:28:03.59,Default,,0,0,0,,Мен қайыр сұрамаймын.
Dialogue: 0,0:28:03.72,0:28:04.93,Default,,0,0,0,,Сіз де, солай ма?
Dialogue: 0,0:28:05.05,0:28:06.64,Default,,0,0,0,,Түрлі заттарды сатып алған адамдар оларды жойды.
Dialogue: 0,0:28:06.76,0:28:07.60,Default,,0,0,0,,Қалғаны болды
Dialogue: 0,0:28:07.72,0:28:09.18,Default,,0,0,0,,Боқ сияқты құлағалы тұрған дүние
Dialogue: 0,0:28:09.35,0:28:10.56,Default,,0,0,0,,Борыштық міндеттеме жауапкершілігі
Dialogue: 0,0:28:10.68,0:28:11.85,Default,,0,0,0,,Оның үстіне намысшыл адамдар
Dialogue: 0,0:28:11.98,0:28:15.86,Default,,0,0,0,,Мақтанышпен айтылған халық ертегілері, ертегілер, биік ертегілер, биік ертегілер
Dialogue: 0,0:28:15.98,0:28:17.82,Default,,0,0,0,,Махаббат жазы дегеніміз не?
Dialogue: 0,0:28:17.94,0:28:19.65,Default,,0,0,0,,Әй, көңіл-күйің жақсы ма?
Dialogue: 0,0:28:19.78,0:28:22.65,Default,,0,0,0,,Менің атым Рентон Рентон Бимс 14 жаста
Dialogue: 0,0:28:22.78,0:28:23.99,Default,,0,0,0,,Ең алдымен мынаны айтқым келеді
Dialogue: 0,0:28:24.11,0:28:26.20,Default,,0,0,0,,Мен осылай көрінсем де, қашып жүрген жоқпын.
Dialogue: 0,0:28:26.32,0:28:27.91,Default,,0,0,0,,Мына жігіттер мені қуып келеді.
Dialogue: 0,0:28:28.03,0:28:30.79,Default,,0,0,0,,Ит үргенде мен де жүгіремін.
Dialogue: 0,0:28:31.20,0:28:32.71,Default,,0,0,0,,Сондықтан мен қазір
Dialogue: 0,0:28:32.83,0:28:35.17,Default,,0,0,0,,Қираған дүние маған қызық емес
Dialogue: 0,0:28:35.29,0:28:38.25,Default,,0,0,0,,Жоғарыға шығуға бел буғандар қатты айғайлайды.
Dialogue: 0,0:28:38.38,0:28:40.51,Default,,0,0,0,,Бұл ең нашар. Бұл ең нашар.
Dialogue: 0,0:28:40.76,0:28:41.76,Default,,0,0,0,,Мен қандаймын?
Dialogue: 0,0:28:41.88,0:28:43.34,Default,,0,0,0,,Сізде осындай жағдай болды ма?
Dialogue: 0,0:28:43.80,0:28:45.68,Default,,0,0,0,,Олай болса, бір нәрсе сұрайын.
Dialogue: 0,0:28:52.10,0:28:55.48,Default,,0,0,0,,Менің қарсылық көрсетуге ниетім жоқ. Өтінемін, шабуылыңызды тоқтатыңыз.
Dialogue: 0,0:28:56.06,0:28:59.02,Default,,0,0,0,,Бұл Альфа партизандық эскадрильясының екінші лейтенанты Чарльз Бимс.
Dialogue: 0,0:28:59.19,0:29:02.40,Default,,0,0,0,,Бұл ерекше миссия. Сіз менің жеке кодымды тексере аласыз ба?
Dialogue: 0,0:29:03.28,0:29:06.03,Default,,0,0,0,,Растау Кешіріңіз
Dialogue: 0,0:29:06.16,0:29:09.78,Default,,0,0,0,,Бұл 4-патрульдік батальонның аға сержанты Милтон.
Dialogue: 0,0:29:10.37,0:29:12.75,Default,,0,0,0,,Ертеңгі Гекко Шабуылдың басталуына қарай
Dialogue: 0,0:29:12.87,0:29:15.83,Default,,0,0,0,,Біз күдікті KLF, т.б. іздедік.
Dialogue: 0,0:29:16.50,0:29:19.54,Default,,0,0,0,,Мен ертеңнен бастап бірге күресуді асыға күтемін.
Dialogue: 0,0:29:19.88,0:29:22.13,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:29:22.30,0:29:23.47,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:29:24.05,0:29:27.97,Default,,0,0,0,,Өйткені сіз қазір демалыстасыз.
Dialogue: 0,0:29:28.09,0:29:29.01,Default,,0,0,0,,Және...
Dialogue: 0,0:29:29.14,0:29:32.52,Default,,0,0,0,,Айкода Рентон
Dialogue: 0,0:29:32.68,0:29:33.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:34.02,0:29:37.10,Default,,0,0,0,,Келесі күні Қауіпсіздік бюросы Гекконы атып түсірді.
Dialogue: 0,0:29:37.23,0:29:39.81,Default,,0,0,0,,Бортта болған Эвриканың өлтірілуі.
Dialogue: 0,0:29:39.94,0:29:42.61,Default,,0,0,0,,Өте құпия миссияға қатысуға бұйрық берілді
Dialogue: 0,0:29:43.07,0:29:45.40,Default,,0,0,0,,Ертең таңғы сағат 7-де бастапқы құрылғыға оралыңыз
Dialogue: 0,0:29:46.49,0:29:48.16,Default,,0,0,0,,Қалжың... иә?
Dialogue: 0,0:29:48.45,0:29:49.28,Default,,0,0,0,,Жоқ
Dialogue: 0,0:29:49.41,0:29:51.12,Default,,0,0,0,,Бұл өтірік. (Чарльз) Бұл өтірік емес.
Dialogue: 0,0:29:51.24,0:29:52.91,Default,,0,0,0,,Бұл өтірік! (Чарльз) Бұл өтірік емес!
Dialogue: 0,0:29:53.04,0:29:54.16,Default,,0,0,0,,Бұл өтірік! (Чарльз) Рентон!
Dialogue: 0,0:29:54.62,0:29:56.12,Default,,0,0,0,,Айтыңызшы, бұл өтірік!
Dialogue: 0,0:29:56.87,0:29:57.83,Default,,0,0,0,,Иә...
Dialogue: 0,0:29:58.29,0:30:01.17,Default,,0,0,0,,Өтінемін, Чарльз, мен жаттығу жасаймын.
Dialogue: 0,0:30:01.71,0:30:04.42,Default,,0,0,0,,Мен бар күшімді саламын, сонда сен ана мен әке деуге болады.
Dialogue: 0,0:30:04.71,0:30:06.88,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:30:07.26,0:30:09.51,Default,,0,0,0,,Өйткені бұл... өтірік.
Dialogue: 0,0:30:11.43,0:30:13.43,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:30:15.48,0:30:17.60,Default,,0,0,0,,Операция ертең таңертең басталады
Dialogue: 0,0:30:17.98,0:30:20.90,Default,,0,0,0,,Геккоға қайтып барып, оған айта аласыз.
Dialogue: 0,0:30:21.15,0:30:23.57,Default,,0,0,0,,Жүрегіңнің бір бұрышында сақтағың келсе
Dialogue: 0,0:30:23.78,0:30:24.86,Default,,0,0,0,,Осы кемеде қалғандар
Dialogue: 0,0:30:24.98,0:30:27.28,Default,,0,0,0,,Бұл қорқақтық емес.
Dialogue: 0,0:30:27.45,0:30:29.32,Default,,0,0,0,,Рэй екеуіміз де соны қалаймыз.
Dialogue: 0,0:30:30.11,0:30:32.33,Default,,0,0,0,,Екеуінен де құтылудың жолдары бар.
Dialogue: 0,0:30:32.66,0:30:34.08,Default,,0,0,0,,Сіз шешесіз
Dialogue: 0,0:30:36.12,0:30:38.46,Default,,0,0,0,,Бірақ өкінетін болсаң
Dialogue: 0,0:30:39.54,0:30:43.46,Default,,0,0,0,,Өмір бойы өзіңмен бірге алып жүруге батылың жетпесе
Dialogue: 0,0:30:43.92,0:30:48.34,Default,,0,0,0,,Не істеу керектігін және не істеу керектігін өзіңіз таңдайсыз.
Dialogue: 0,0:30:48.80,0:30:53.05,Default,,0,0,0,,Қандай шешім қабылдасаңыз да, өзіңізді алдамай қабылдаймыз.
Dialogue: 0,0:30:53.39,0:30:54.64,Default,,0,0,0,,Міндетті түрде еніңіз
Dialogue: 0,0:30:57.73,0:30:58.56,Default,,0,0,0,,Таңдау?
Dialogue: 0,0:31:00.14,0:31:02.56,Default,,0,0,0,,Бірақ мен не туралы өтірік айтып жатырмын?
Dialogue: 0,0:31:02.69,0:31:04.90,Default,,0,0,0,,Ол кезде мен түсінбедім.
Dialogue: 0,0:31:05.19,0:31:08.03,Default,,0,0,0,,Тек өкінетін болсаң... Иә.
Dialogue: 0,0:31:09.24,0:31:10.07,Default,,0,0,0,,Бұрынғыдай
Dialogue: 0,0:31:10.20,0:31:12.99,Default,,0,0,0,,Маған біреуді итеріп жіберетін сөздер керек емес еді
Dialogue: 0,0:31:16.70,0:31:19.62,Default,,0,0,0,,Сонда да мен білгім келетін бір нәрсе бар еді.
Dialogue: 0,0:31:23.00,0:31:25.13,Default,,0,0,0,,Сіз мені іздедіңіз бе?
Dialogue: 0,0:31:29.42,0:31:31.51,Default,,0,0,0,,Бұл адам Чарльз Бимс
Dialogue: 0,0:31:33.30,0:31:35.10,Default,,0,0,0,,Мені өсірген ата-ана
Dialogue: 0,0:31:35.56,0:31:38.22,Default,,0,0,0,,Әйтеуір, ойпаңда өмір сүріп жатырмын.
Dialogue: 0,0:31:39.10,0:31:41.14,Default,,0,0,0,,Көп жағынан күшті адам
Dialogue: 0,0:31:47.03,0:31:48.44,Default,,0,0,0,,Мен сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,0:31:49.15,0:31:51.86,Default,,0,0,0,,Мен Адрок Турстонның ұлы болмасам да
Dialogue: 0,0:31:52.49,0:31:54.37,Default,,0,0,0,,Мені асырап алдың ба?
Dialogue: 0,0:31:54.53,0:31:55.99,Default,,0,0,0,,Мені есіңде бар ғой, иә?
Dialogue: 0,0:31:57.79,0:32:00.20,Default,,0,0,0,,Сонымен, бұл Сәулелер сәулесі
Dialogue: 0,0:32:00.87,0:32:02.46,Default,,0,0,0,,Чарльздың әйелі
Dialogue: 0,0:32:03.50,0:32:05.84,Default,,0,0,0,,Бір қарағанда суық сияқты, бірақ
Dialogue: 0,0:32:06.54,0:32:08.76,Default,,0,0,0,,Негізінде, қызу әйел
Dialogue: 0,0:32:13.01,0:32:14.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:32:16.85,0:32:18.72,Default,,0,0,0,,Онда мен барамын.
Dialogue: 0,0:32:18.93,0:32:21.85,Default,,0,0,0,,Чарльз мен Рэйге рахмет.
Dialogue: 0,0:32:23.90,0:32:25.40,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:32:25.65,0:32:27.86,Default,,0,0,0,,(Рей жылайды)
Dialogue: 0,0:32:32.53,0:32:35.03,Default,,0,0,0,,Сонымен, біз нені бастаймыз
Dialogue: 0,0:32:35.49,0:32:37.95,Default,,0,0,0,,Кездесулер мен қоштасулар туралы барлығы
Dialogue: 0,0:32:59.39,0:33:02.10,Default,,0,0,0,,Мен және сен, анау қыз және мен
Dialogue: 0,0:33:02.27,0:33:03.31,Default,,0,0,0,,Біз және олар
Dialogue: 0,0:33:04.39,0:33:08.19,Default,,0,0,0,,Бастау сізге жақынырақтан басталады.
Dialogue: 0,0:33:12.07,0:33:14.24,Default,,0,0,0,,Мөлдір жарық бөлшектері
Dialogue: 0,0:33:14.40,0:33:16.66,Default,,0,0,0,,Осындай жұмбақ ұшатын бөлшектермен қоршалған
Dialogue: 0,0:33:16.78,0:33:19.70,Default,,0,0,0,,Қоңыраулы орман, осы планетаның шекарасы
Dialogue: 0,0:33:32.55,0:33:36.13,Default,,0,0,0,,Қоңыраулы орман Батыс Оңтүстік жел жел күші 3
Dialogue: 0,0:33:36.26,0:33:38.09,Default,,0,0,0,,Мөлдір жарық бөлшектері
Dialogue: 0,0:33:38.22,0:33:40.85,Default,,0,0,0,,36 кейінірек 56
Dialogue: 0,0:33:41.18,0:33:44.77,Default,,0,0,0,,Қоңыраулы орман Солтүстік оңтүстік-шығыс жел 1
Dialogue: 0,0:33:44.89,0:33:47.10,Default,,0,0,0,,Мөлдір жарық бөлшектері…
Dialogue: 0,0:33:47.52,0:33:48.35,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:33:48.94,0:33:51.36,Default,,0,0,0,,Мен туылғаннан кейін шамамен 14 жыл өткен соң
Dialogue: 0,0:33:52.11,0:33:53.86,Default,,0,0,0,,Міне, мен сол қалада өткізген күндерім
Dialogue: 0,0:33:53.99,0:33:55.49,Default,,0,0,0,,Қайтадан ойланып көрсеңіз
Dialogue: 0,0:33:55.61,0:33:57.36,Default,,0,0,0,,Менің айналамда ештеңе болмайды
Dialogue: 0,0:33:57.49,0:33:59.74,Default,,0,0,0,,Ол тіпті ештеңе болатынын сезбейді.
Dialogue: 0,0:34:00.20,0:34:02.33,Default,,0,0,0,,Бұл менің ең нашар өмірім болды.
Dialogue: 0,0:34:02.49,0:34:04.58,Default,,0,0,0,,Сондықтан бұл сізге мүмкін емес
Dialogue: 0,0:34:05.04,0:34:09.04,Default,,0,0,0,,Болашағы бар жас жігітке олай айтпа.
Dialogue: 0,0:34:09.38,0:34:10.92,Default,,0,0,0,,Сіз мұны бірнеше рет айттыңыз.
Dialogue: 0,0:34:11.04,0:34:14.05,Default,,0,0,0,,Эй Рентон, сен толқындарға сенбейсің.
Dialogue: 0,0:34:14.51,0:34:17.09,Default,,0,0,0,,Мен толқындарға сенбейтіндіктен, мен толқындарды жақсы жүргізе алмаймын.
Dialogue: 0,0:34:17.22,0:34:18.72,Default,,0,0,0,,Егер солай болса, ол қанша уақытқа созылса да
Dialogue: 0,0:34:18.84,0:34:21.43,Default,,0,0,0,,Қысқарту/түсіру бұрылысы мүмкін емес
Dialogue: 0,0:34:22.26,0:34:24.72,Default,,0,0,0,,Бірақ Голландия 14 жаста болғанда
Dialogue: 0,0:34:24.85,0:34:25.85,Default,,0,0,0,,Қысқарту/түсіру бұрылысы
Dialogue: 0,0:34:25.98,0:34:27.27,Default,,0,0,0,,Шешілді.
Dialogue: 0,0:34:27.39,0:34:28.94,Default,,0,0,0,,Тіпті мен үшін...
Dialogue: 0,0:34:29.06,0:34:30.65,Default,,0,0,0,,О, Голландия.
Dialogue: 0,0:34:31.15,0:34:32.02,Default,,0,0,0,,Мудамуда
Dialogue: 0,0:34:32.15,0:34:33.78,Default,,0,0,0,,Өйткені ол данышпан.
Dialogue: 0,0:34:34.11,0:34:35.78,Default,,0,0,0,,Сіз бізден басқасыз.
Dialogue: 0,0:34:36.32,0:34:38.74,Default,,0,0,0,,Және ол Солтүстік жағалауда дүниеге келген.
Dialogue: 0,0:34:38.86,0:34:41.32,Default,,0,0,0,,Мен басқа ортада өстім.
Dialogue: 0,0:34:41.99,0:34:43.99,Default,,0,0,0,,Бірақ Голландия мұны жиі айта бермейді ме?
Dialogue: 0,0:34:44.58,0:34:46.41,Default,,0,0,0,,«Қай жерде туылғаның маңызды емес».
Dialogue: 0,0:34:46.54,0:34:48.21,Default,,0,0,0,,«Сізге шынымен керек жер»
Dialogue: 0,0:34:48.33,0:34:50.54,Default,,0,0,0,,«Бұл әрқашан сіздің алдыңызда»
Dialogue: 0,0:34:50.96,0:34:53.25,Default,,0,0,0,,Мен осы жерде өсемін
Dialogue: 0,0:34:54.25,0:34:58.13,Default,,0,0,0,,Өсіп, бір күні KLF-дегі Голландия сияқты бол.
Dialogue: 0,0:34:58.26,0:35:00.93,Default,,0,0,0,,Қысқарту/түсіру бұрылысын шешіңіз
Dialogue: 0,0:35:01.14,0:35:02.10,Default,,0,0,0,,Иә, иә?
Dialogue: 0,0:35:02.68,0:35:04.31,Default,,0,0,0,,Сіз қызмет үшін төлейсіз.
Dialogue: 0,0:35:04.43,0:35:06.10,Default,,0,0,0,,Амансың ба, Уноның ағасы?
Dialogue: 0,0:35:06.22,0:35:07.77,Default,,0,0,0,,Қош бол.
Dialogue: 0,0:35:07.89,0:35:08.73,Default,,0,0,0,,Қоштасу?
Dialogue: 0,0:35:09.02,0:35:11.10,Default,,0,0,0,,Иә, мен көшіп жатырмын.
Dialogue: 0,0:35:11.23,0:35:12.27,Default,,0,0,0,,Додо... қайда?
Dialogue: 0,0:35:12.40,0:35:14.86,Default,,0,0,0,,Толқындар көп келетін мұнаралар қаласында.
Dialogue: 0,0:35:14.98,0:35:17.74,Default,,0,0,0,,Өйткені мұнда бизнес өркендеп жатыр.
Dialogue: 0,0:35:18.36,0:35:19.90,Default,,0,0,0,,Сіз жалғыз тұтынушысыз.
Dialogue: 0,0:35:20.03,0:35:22.74,Default,,0,0,0,,Мен де саған қарап сатып алмаймын.
Dialogue: 0,0:35:23.99,0:35:24.83,Default,,0,0,0,,Мен адамдардың өмірін сақтайтын жұмыста істедім
Dialogue: 0,0:35:28.62,0:35:31.58,Default,,0,0,0,,Бұл қала, Белл орманы, әрине, ең нашар болды.
Dialogue: 0,0:35:32.04,0:35:34.59,Default,,0,0,0,,Риф десем де, Жаман толқын келмейді.
Dialogue: 0,0:35:34.71,0:35:36.80,Default,,0,0,0,,Лайықты өмір сүрудің бірден-бір жолы - солдат болу.
Dialogue: 0,0:35:37.17,0:35:40.93,Default,,0,0,0,,Бірақ ол кезде мен бұл қаладан қалай кететінімді білмедім.
Dialogue: 0,0:35:41.09,0:35:42.68,Default,,0,0,0,,Білуге тым жас
Dialogue: 0,0:35:43.22,0:35:44.10,Default,,0,0,0,,Өйткені I
Dialogue: 0,0:35:44.43,0:35:46.72,Default,,0,0,0,,Оның өмір сүргеніне небәрі 14 жыл болды.
Dialogue: 0,0:35:47.06,0:35:49.85,Default,,0,0,0,,Сол себепті де сол қалада қалудан басқа амалым қалмады.
Dialogue: 0,0:35:50.02,0:35:51.89,Default,,0,0,0,,Ең нашар қалада
Dialogue: 0,0:35:52.15,0:35:52.98,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:35:54.23,0:35:57.02,Default,,0,0,0,,Бұл кезде аспан толып кеткен
Dialogue: 0,0:35:57.15,0:35:59.40,Default,,0,0,0,,Мөлдір жарық бөлшектері
Dialogue: 0,0:35:59.53,0:36:03.32,Default,,0,0,0,,Басқаша айтқанда, тұзақшылардың жаппай пайда болуынан жер қыртысының деформациясы
Dialogue: 0,0:36:03.45,0:36:07.20,Default,,0,0,0,,және оның әлемде хаос тудыратын физикалық зақымдануы
Dialogue: 0,0:36:07.33,0:36:08.49,Default,,0,0,0,,Ол әлемге...
Dialogue: 0,0:36:09.25,0:36:10.96,Default,,0,0,0,,Махаббат жазы
Dialogue: 0,0:36:11.46,0:36:14.54,Default,,0,0,0,,Өз өмірін қиып, мұндай апаттың алдын алғандар
Dialogue: 0,0:36:14.67,0:36:18.63,Default,,0,0,0,,Адрок Турстон, біздің қала жасаған аты аңызға айналған тұлға.
Dialogue: 0,0:36:18.75,0:36:22.84,Default,,0,0,0,,Иә, ал батыр Адроктың ұлы.
Dialogue: 0,0:36:22.97,0:36:25.64,Default,,0,0,0,,Негізі бұл менің сыныбымның мүшесі Рентон.
Dialogue: 0,0:36:25.76,0:36:26.60,Default,,0,0,0,,Ах
Dialogue: 0,0:36:26.72,0:36:28.10,Default,,0,0,0,,
Dialogue: 0,0:36:28.60,0:36:29.64,Default,,0,0,0,,Мен адамдардың өмірін сақтайтын жұмыста істедім
Dialogue: 0,0:36:29.77,0:36:31.64,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:36:36.36,0:36:37.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:36:38.69,0:36:39.61,Default,,0,0,0,,Өздігінен оқу.
Dialogue: 0,0:36:39.73,0:36:41.53,Default,,0,0,0,,Мұғалімдер қотырмен күресуге барады.
Dialogue: 0,0:36:41.65,0:36:43.57,Default,,0,0,0,,Көшеге шықпауыңызды өтінемін
Dialogue: 0,0:36:44.49,0:36:47.62,Default,,0,0,0,,Шынымен, көрдің бе?
Dialogue: 0,0:36:47.74,0:36:49.87,Default,,0,0,0,,Әкең әлемді құтқарған жер.
Dialogue: 0,0:36:50.45,0:36:52.37,Default,,0,0,0,,Сіз шынымен жақсы жағдайдасыз.
Dialogue: 0,0:36:52.50,0:36:57.08,Default,,0,0,0,,Осындай ерлікпен ол әскери училищенің ерекше студенті.
Dialogue: 0,0:36:57.21,0:36:59.96,Default,,0,0,0,,(Ерлердің күлкісі)
Dialogue: 0,0:37:00.09,0:37:00.92,Default,,0,0,0,,Әй!
Dialogue: 0,0:37:02.22,0:37:05.43,Default,,0,0,0,,Бұл сұмдық қаладағы ең ауыр күндер еді
Dialogue: 0,0:37:05.59,0:37:08.22,Default,,0,0,0,,Ол кезде толқындар келгенше бәрі жақсы болатын.
Dialogue: 0,0:37:08.35,0:37:10.14,Default,,0,0,0,,Сіз рифф жасай алатын болсаңыз, проблема жоқ
Dialogue: 0,0:37:10.26,0:37:11.81,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:37:11.93,0:37:14.94,Default,,0,0,0,,Рифф болғанша, ол кез келген жерде ең жақсы болды!
Dialogue: 0,0:37:17.69,0:37:18.52,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:37:18.69,0:37:19.61,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:37:22.65,0:37:24.74,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:37:25.99,0:37:26.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:28.95,0:37:29.78,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:37:30.45,0:37:34.08,Default,,0,0,0,,Қаланың осындай түрі...
Dialogue: 0,0:37:34.66,0:37:37.67,Default,,0,0,0,,Бұл ең нашар!
Dialogue: 0,0:37:43.51,0:37:46.34,Default,,0,0,0,,Дәл солай, мен ол қаладан секірдім
Dialogue: 0,0:37:46.47,0:37:50.64,Default,,0,0,0,,Мен көрген нәрселер, мен естіген нәрселер, мен кездескен адамдар, мен ажырасқан адамдар.
Dialogue: 0,0:37:51.39,0:37:53.68,Default,,0,0,0,,Ал сол бала туралы.
Dialogue: 0,0:37:54.27,0:37:55.60,Default,,0,0,0,,Сол уақыт туралы
Dialogue: 0,0:37:56.56,0:37:58.44,Default,,0,0,0,,Осылайша өмір сүру
Dialogue: 0,0:37:58.56,0:37:59.69,Default,,0,0,0,,Мағынасы...
Dialogue: 0,0:38:00.52,0:38:03.07,Default,,0,0,0,,Тіпті мен осылай тапқан жер
Dialogue: 0,0:38:03.57,0:38:05.40,Default,,0,0,0,,Мен секірдім
Dialogue: 0,0:38:06.11,0:38:07.11,Default,,0,0,0,,Және…
Dialogue: 0,0:38:20.79,0:38:24.88,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:38:25.84,0:38:27.34,Default,,0,0,0,,Иә? жоқ!
Dialogue: 0,0:38:27.63,0:38:29.76,Default,,0,0,0,,Жоқ, жоқ, жоқ!
Dialogue: 0,0:38:30.39,0:38:33.76,Default,,0,0,0,,Барлығын жоғалтқаннан кейін қалғаны...
Dialogue: 0,0:38:35.06,0:38:35.98,Default,,0,0,0,,Хаа…
Dialogue: 0,0:38:37.98,0:38:40.69,Default,,0,0,0,,Содан бері қанша күн өткенін де білмеймін.
Dialogue: 0,0:38:40.81,0:38:43.94,Default,,0,0,0,,Мен мұны білмей тұрып, мен бір тақтамен тиынсыз болдым.
Dialogue: 0,0:38:44.57,0:38:46.36,Default,,0,0,0,,Жоспар болған жоқ.
Dialogue: 0,0:38:46.49,0:38:48.53,Default,,0,0,0,,Мен мүмкіндігінше алысқа барғым келді.
Dialogue: 0,0:38:48.90,0:38:50.70,Default,,0,0,0,,Бірақ мен жалғыз қалғанда бір нәрсені түсіндім.
Dialogue: 0,0:38:51.66,0:38:53.99,Default,,0,0,0,,Көп нәрсе болды, менің қояр жерім болмады.
Dialogue: 0,0:38:54.37,0:38:56.33,Default,,0,0,0,,Мен жалғыз болған жоқпын.
Dialogue: 0,0:38:56.75,0:38:58.96,Default,,0,0,0,,Бірақ... жоқ, сондықтан
Dialogue: 0,0:38:59.08,0:39:02.92,Default,,0,0,0,,Мен бұл жер туралы әлі ештеңе есіме түсіргім келмейді.
Dialogue: 0,0:39:04.67,0:39:06.88,Default,,0,0,0,,Мен Эвриканы қорғаймын
Dialogue: 0,0:39:07.09,0:39:08.38,Default,,0,0,0,,Мен Эврикамын
Dialogue: 0,0:39:08.51,0:39:11.30,Default,,0,0,0,,Мені үлкен ауруханаға апарыңыз!
Dialogue: 0,0:39:11.93,0:39:12.76,Default,,0,0,0,,А... Уф!
Dialogue: 0,0:39:13.18,0:39:14.76,Default,,0,0,0,,Сөйтсем!
Dialogue: 0,0:39:15.26,0:39:18.06,Default,,0,0,0,,Кішкене үлкен болғаның бұл дегенді білдірмейді!
Dialogue: 0,0:39:18.27,0:39:21.31,Default,,0,0,0,,Маған сенің рыцарь сияқты әрекет еткенің ұнамайды.
Dialogue: 0,0:39:21.44,0:39:24.69,Default,,0,0,0,,Өлдірмеймін, рыцарьға айналамын!
Dialogue: 0,0:39:26.28,0:39:27.99,Default,,0,0,0,,Ол Голланд Новак
Dialogue: 0,0:39:29.36,0:39:35.08,Default,,0,0,0,,Хаа... Гекконың жетекшісі - бастық рифтің данышпаны.
Dialogue: 0,0:39:35.49,0:39:38.95,Default,,0,0,0,,Шұғыл, көңіл-күй, қолын аузынан бұрын қоятын түрі
Dialogue: 0,0:39:40.96,0:39:42.50,Default,,0,0,0,,Мен саған көмектеспеймін.
Dialogue: 0,0:39:42.71,0:39:45.96,Default,,0,0,0,,Мен сізге құтқару операциясына ешқашан көмектеспеймін!
Dialogue: 0,0:39:46.17,0:39:47.55,Default,,0,0,0,,Тым мақтанба!
Dialogue: 0,0:39:47.67,0:39:51.18,Default,,0,0,0,,Сенсіз болсам да өзіме жетеді
Dialogue: 0,0:39:51.30,0:39:52.13,Default,,0,0,0,,Ағай!
Dialogue: 0,0:39:52.30,0:39:53.14,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:39:53.80,0:39:55.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:39:56.06,0:39:57.47,Default,,0,0,0,,Бұл Гекко
Dialogue: 0,0:39:57.60,0:39:59.85,Default,,0,0,0,,Белл орманынан, барлық нәрселер үшін ең нашар қала.
Dialogue: 0,0:39:59.98,0:40:02.23,Default,,0,0,0,,Мен секіріп түсіп, домалап түскен жерім
Dialogue: 0,0:40:02.65,0:40:04.61,Default,,0,0,0,,Ондай адамдар болды.
Dialogue: 0,0:40:04.90,0:40:07.32,Default,,0,0,0,,Есіңе түсіруге қарсы емеспін.
Dialogue: 0,0:40:07.57,0:40:10.19,Default,,0,0,0,,Мен оны қалдырамын, себебі ол өте ұзақ сияқты.
Dialogue: 0,0:40:11.86,0:40:12.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:18.41,0:40:21.71,Default,,0,0,0,,Мен мұны... өзім істей аламын.
Dialogue: 0,0:40:22.00,0:40:25.08,Default,,0,0,0,,Эй, сен тірісің бе?
Dialogue: 0,0:40:32.13,0:40:34.26,Default,,0,0,0,,Онда не болды?
Dialogue: 0,0:40:34.59,0:40:36.97,Default,,0,0,0,,Дұрыс, хмм...
Dialogue: 0,0:40:38.85,0:40:40.68,Default,,0,0,0,,Мен сенімен сөйлескім келмейді
Dialogue: 0,0:40:50.78,0:40:51.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:55.45,0:40:57.03,Default,,0,0,0,,Мен жай ғана шаршадым.
Dialogue: 0,0:40:57.41,0:40:59.08,Default,,0,0,0,,Иә, мен шаршадым.
Dialogue: 0,0:40:59.79,0:41:02.12,Default,,0,0,0,,Сондықтан енді ештеңені ойлағым келмеді.
Dialogue: 0,0:41:09.92,0:41:12.34,Default,,0,0,0,,(жоғары ырғақты музыка)
Dialogue: 0,0:41:12.47,0:41:14.43,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:41:18.30,0:41:19.85,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:41:37.95,0:41:39.95,Default,,0,0,0,,Мені құтқарған адам болды
Dialogue: 0,0:41:40.08,0:41:43.37,Default,,0,0,0,,Музыка Rave Rhythm Beat
Dialogue: 0,0:41:44.08,0:41:45.71,Default,,0,0,0,,яғни би билеу
Dialogue: 0,0:41:45.83,0:41:47.37,Default,,0,0,0,,Шикараба айнала билейді
Dialogue: 0,0:41:47.83,0:41:51.55,Default,,0,0,0,,Осы планетаның жұмысын ақыл мен денеңізбен түсіну
Dialogue: 0,0:41:51.84,0:41:53.05,Default,,0,0,0,,Жүрек соғуы – толқын
Dialogue: 0,0:41:53.55,0:41:56.05,Default,,0,0,0,,Сезіну, көп сезіну
Dialogue: 0,0:41:56.84,0:42:00.10,Default,,0,0,0,,Бұл сезімді сөзбен айтып жеткізу мүмкін емес.
Dialogue: 0,0:42:00.55,0:42:03.93,Default,,0,0,0,,Мен білмей тұрып, мені қағып алды.
Dialogue: 0,0:42:21.70,0:42:22.54,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:42:23.33,0:42:24.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:42:24.70,0:42:27.96,Default,,0,0,0,,Музыка әрқашан адамды өзіне тартады.
Dialogue: 0,0:42:28.25,0:42:31.25,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:42:31.92,0:42:36.17,Default,,0,0,0,,-де не білдіңіз? Осы уақытқа дейін қашып кеттің
Dialogue: 0,0:42:36.38,0:42:39.13,Default,,0,0,0,,Қашып кетсем де, айтайын дегенім ол емес.
Dialogue: 0,0:42:39.26,0:42:40.09,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:42:40.89,0:42:42.85,Default,,0,0,0,,Тіпті маған ұнайтын қыз да мұны істей алар еді.
Dialogue: 0,0:42:42.97,0:42:44.31,Default,,0,0,0,,Мен Рэймен сөйлестім.
Dialogue: 0,0:42:44.43,0:42:45.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:45.85,0:42:49.10,Default,,0,0,0,,Хахахаха Бұл карта жұлдызы ма?
Dialogue: 0,0:42:49.23,0:42:53.15,Default,,0,0,0,,Мұндай жерде кездесу өте таңқаларлық оқиға.
Dialogue: 0,0:42:56.44,0:42:57.28,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:42:57.40,0:42:59.28,Default,,0,0,0,,Кешірім сұраудың қажеті жоқ
Dialogue: 0,0:42:59.41,0:43:02.49,Default,,0,0,0,,Сенің жасыңда мен де жас болғым келді.
Dialogue: 0,0:43:02.62,0:43:04.20,Default,,0,0,0,,Хахахаха! Хахаха...
Dialogue: 0,0:43:05.04,0:43:06.54,Default,,0,0,0,,Бірақ Рентон
Dialogue: 0,0:43:06.66,0:43:09.50,Default,,0,0,0,,Ол сені іздеді.
Dialogue: 0,0:43:09.62,0:43:11.29,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:43:12.71,0:43:13.67,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:43:15.09,0:43:19.17,Default,,0,0,0,,Бірақ дәл осы уақытқа дейін сенің мені іздеп жүргеніңді білмедім.
Dialogue: 0,0:43:20.09,0:43:22.76,Default,,0,0,0,,Сондықтан мен бұл сәйкестік жай ғана арман деп ойладым.
Dialogue: 0,0:43:22.97,0:43:24.10,Default,,0,0,0,,Рэй-сан да...
Dialogue: 0,0:43:25.39,0:43:26.43,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:43:28.14,0:43:29.44,Default,,0,0,0,,Не? (Чарльз) Мына жақта.
Dialogue: 0,0:43:30.85,0:43:32.56,Default,,0,0,0,,диджей емес
Dialogue: 0,0:43:33.61,0:43:34.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:34.77,0:43:37.36,Default,,0,0,0,,Мына бөксе өте еліктіреді.
Dialogue: 0,0:43:38.65,0:43:41.57,Default,,0,0,0,,Эй, сен билеп жүрген сияқтысың.
Dialogue: 0,0:43:41.70,0:43:44.53,Default,,0,0,0,,Мен сенімен сөйлесуіңді күтемін.
Dialogue: 0,0:43:44.87,0:43:45.83,Default,,0,0,0,,Иә
Dialogue: 0,0:43:50.54,0:43:53.08,Default,,0,0,0,,Бірақ мен өзімшіл нәрсе жасадым...
Dialogue: 0,0:43:53.42,0:43:56.00,Default,,0,0,0,,Сізге не болды, ол сізді жоғалтты?
Dialogue: 0,0:43:56.13,0:43:58.13,Default,,0,0,0,,Содан бері екеуміз де бұл туралы ойландық.
Dialogue: 0,0:43:58.46,0:44:00.97,Default,,0,0,0,,Бірақ шынымды айтсам, білмеймін.
Dialogue: 0,0:44:01.55,0:44:04.51,Default,,0,0,0,,Дегенмен, Рэй сіздің маңызды отбасы екеніңізді айтады.
Dialogue: 0,0:44:04.64,0:44:07.60,Default,,0,0,0,,Осыны білгім келеді
Dialogue: 0,0:44:07.93,0:44:08.85,Default,,0,0,0,,Иә
Dialogue: 0,0:44:08.97,0:44:11.52,Default,,0,0,0,,Ондай жағдайда алдымен менімен сөйлесу керек.
Dialogue: 0,0:44:16.07,0:44:16.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:17.98,0:44:21.65,Default,,0,0,0,,Бас музыкаға лайлы дыбыс араласа бастады.
Dialogue: 0,0:44:23.32,0:44:25.57,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:44:25.70,0:44:27.12,Default,,0,0,0,,Хмм... Жер қыртысының қозғалысы?
Dialogue: 0,0:44:27.24,0:44:28.16,Default,,0,0,0,,Рэй!
Dialogue: 0,0:44:28.62,0:44:30.04,Default,,0,0,0,,(Раверлердің айқайы)
Dialogue: 0,0:44:31.83,0:44:32.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:38.63,0:44:39.92,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:44:42.80,0:44:43.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:44.30,0:44:45.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:46.80,0:44:47.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:52.31,0:44:53.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:06.12,0:45:06.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:07.95,0:45:08.78,Default,,0,0,0,,Ах
Dialogue: 0,0:45:08.91,0:45:11.83,Default,,0,0,0,,А... Мм, менің басымнан осындай бірдеңе болды...
Dialogue: 0,0:45:14.37,0:45:15.83,Default,,0,0,0,,Ішіңіз келе ме? Ах
Dialogue: 0,0:45:15.96,0:45:17.92,Default,,0,0,0,,Жастық қашқын бала
Dialogue: 0,0:45:20.50,0:45:23.59,Default,,0,0,0,,Қараңдаршы, айтар сөзің бар.
Dialogue: 0,0:45:23.76,0:45:24.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:45:25.22,0:45:26.97,Default,,0,0,0,,Сіздің қарныңыз ашты ма?
Dialogue: 0,0:45:27.85,0:45:31.01,Default,,0,0,0,,Ұят, бірақ мен бұл күлімсіреумен теңесе алмаймын.
Dialogue: 0,0:45:32.14,0:45:33.89,Default,,0,0,0,,Мен ашуланбадым
Dialogue: 0,0:45:35.44,0:45:37.90,Default,,0,0,0,,Сіздің ностальгиялық үйіңіз туралы не айтасыз?
Dialogue: 0,0:45:40.69,0:45:43.49,Default,,0,0,0,,Оның тазалығы таң қалдырады.
Dialogue: 0,0:45:43.74,0:45:44.74,Default,,0,0,0,,Рахмет
Dialogue: 0,0:45:45.82,0:45:48.07,Default,,0,0,0,,Оның басқа кемелерден айырмашылығы.
Dialogue: 0,0:45:48.57,0:45:50.74,Default,,0,0,0,,Маған мақтау керек емес.
Dialogue: 0,0:45:50.87,0:45:52.45,Default,,0,0,0,,А, жоқ, олай емес...
Dialogue: 0,0:45:52.58,0:45:54.33,Default,,0,0,0,,Балалар бала болсын
Dialogue: 0,0:45:54.46,0:45:56.92,Default,,0,0,0,,Үлкендердің көңілін көтеретін сөздерді айтпа.
Dialogue: 0,0:45:57.08,0:46:00.79,Default,,0,0,0,,Баланың бала бола алатын жалғыз уақыты - дәл қазір.
Dialogue: 0,0:46:01.80,0:46:05.17,Default,,0,0,0,,Өйткені, бұл менің ниетім емес еді.
Dialogue: 0,0:46:05.42,0:46:07.84,Default,,0,0,0,,Сол сөздерден еріндім.
Dialogue: 0,0:46:08.47,0:46:10.60,Default,,0,0,0,,Бірақ дәл осы сәтте мен болдым
Dialogue: 0,0:46:10.72,0:46:12.47,Default,,0,0,0,,Мүмкін мен сенің ашуыңды қалаған шығармын.
Dialogue: 0,0:46:13.10,0:46:13.93,Default,,0,0,0,,Сол қаладан...
Dialogue: 0,0:46:15.02,0:46:18.40,Default,,0,0,0,,Мен тіпті әскери мектептен рұқсатсыз шығып кеттім.
Dialogue: 0,0:46:18.77,0:46:21.19,Default,,0,0,0,,Мен оларға ештеңе айта алмадым.
Dialogue: 0,0:46:28.61,0:46:30.37,Default,,0,0,0,,Мен мұны істемеймін~ Бәрі менікі.
Dialogue: 0,0:46:30.49,0:46:31.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:31.91,0:46:33.33,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:46:33.95,0:46:35.45,Default,,0,0,0,,Қайтадан бастадыңыз ба?
Dialogue: 0,0:46:35.83,0:46:38.83,Default,,0,0,0,,Менде туғаннан бері тақта бар.
Dialogue: 0,0:46:39.25,0:46:41.17,Default,,0,0,0,,Бірақ бұл тақта
Dialogue: 0,0:46:41.29,0:46:43.63,Default,,0,0,0,,Мен тіпті жылдам маневр жасауды шеше алмаймын.
Dialogue: 0,0:46:43.80,0:46:46.13,Default,,0,0,0,,Дөңгелектер үлкен, сондықтан айла түрлері...
Dialogue: 0,0:46:46.42,0:46:49.43,Default,,0,0,0,,Доңғалақтарды нақты жиектерде тақпау стильді ме?
Dialogue: 0,0:46:49.55,0:46:50.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:50.68,0:46:53.56,Default,,0,0,0,,Журналдарда осылай жазылуы мүмкін.
Dialogue: 0,0:46:53.68,0:46:55.31,Default,,0,0,0,,Риффтерге келетін болсақ, сіз қызықты болуыңыз керек.
Dialogue: 0,0:46:55.43,0:46:57.73,Default,,0,0,0,,Басқалардың көзі маңызды емес, солай ма?
Dialogue: 0,0:46:58.85,0:47:02.90,Default,,0,0,0,,Бұл дүниеде өзін жақсы сезінген адам әрқашан жеңеді.
Dialogue: 0,0:47:03.02,0:47:04.07,Default,,0,0,0,,Оны қалай тоқтатамыз?
Dialogue: 0,0:47:04.57,0:47:06.36,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:47:07.07,0:47:08.61,Default,,0,0,0,,Себебі ол журналда болды
Dialogue: 0,0:47:08.74,0:47:10.57,Default,,0,0,0,,Себебі мен Голландияға тәнті болдым
Dialogue: 0,0:47:11.11,0:47:14.33,Default,,0,0,0,,Сондықтан мен бәрі жақсы деп ойлаймын.
Dialogue: 0,0:47:14.66,0:47:16.25,Default,,0,0,0,,Мен ойланбастан шешім қабылдадым.
Dialogue: 0,0:47:17.58,0:47:19.04,Default,,0,0,0,,Рентон Иә?
Dialogue: 0,0:47:20.08,0:47:23.34,Default,,0,0,0,,Мен саған жақсы нәрсе көрсетемін хехе
Dialogue: 0,0:47:24.04,0:47:25.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:28.97,0:47:32.18,Default,,0,0,0,,Уау... өте керемет!
Dialogue: 0,0:47:33.47,0:47:34.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:47:35.18,0:47:37.93,Default,,0,0,0,,Бұл мен мектепте көрмеген ұшақ.
Dialogue: 0,0:47:42.94,0:47:43.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:43.90,0:47:47.23,Default,,0,0,0,,Мм, мен тақтаны таба алмай жатырмын.
Dialogue: 0,0:47:47.69,0:47:49.28,Default,,0,0,0,,Хахаха
Dialogue: 0,0:47:49.78,0:47:51.78,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз оны мінгіңіз келе ме?
Dialogue: 0,0:47:53.49,0:47:54.78,Default,,0,0,0,,Иә!
Dialogue: 0,0:47:56.03,0:47:59.79,Default,,0,0,0,,Негізгі құрылым және кадр бөлігі MS негізіндегі емес.
Dialogue: 0,0:48:00.08,0:48:02.75,Default,,0,0,0,,Егер сіз оны жалпы қарасаңыз, ол TR-ге жақын болуы мүмкін.
Dialogue: 0,0:48:03.13,0:48:06.92,Default,,0,0,0,,Ах, бірақ дизайн философиясының KLF-ге тән емес кейбір аспектілері бар...
Dialogue: 0,0:48:07.05,0:48:08.88,Default,,0,0,0,,Енді толығырақ.
Dialogue: 0,0:48:09.01,0:48:10.84,Default,,0,0,0,,А, жоқ, маған ұнайды.
Dialogue: 0,0:48:11.13,0:48:13.14,Default,,0,0,0,,Айтпақшы, тақта қайда?
Dialogue: 0,0:48:13.39,0:48:15.43,Default,,0,0,0,,Бұл жігітке ештеңе керек емес.
Dialogue: 0,0:48:15.55,0:48:18.10,Default,,0,0,0,,Не? Сонымен, сіз қалай тұзақшы боласыз?
Dialogue: 0,0:48:18.27,0:48:19.43,Default,,0,0,0,,Шын мәнінде... (рингтон)
Dialogue: 0,0:48:19.56,0:48:20.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:21.73,0:48:23.90,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:48:25.94,0:48:27.73,Default,,0,0,0,,Чарльздың шұғыл сұрауы
Dialogue: 0,0:48:28.03,0:48:29.19,Default,,0,0,0,,Жер қыртысының ертерек қозғалуына байланысты
Dialogue: 0,0:48:29.32,0:48:32.20,Default,,0,0,0,,Жағада қалған бос кемеден жеткізілім сұрауы.
Dialogue: 0,0:48:32.32,0:48:35.41,Default,,0,0,0,,Қозғалтқыш істен шығып, жабдықты әкелу мүмкін болмады.
Dialogue: 0,0:48:35.53,0:48:37.20,Default,,0,0,0,,Рейвке уақытында үлгере алмайтын сияқтымын.
Dialogue: 0,0:48:37.45,0:48:39.58,Default,,0,0,0,,Жауапкершілікті өз мойныңа ал.
Dialogue: 0,0:48:39.70,0:48:41.41,Default,,0,0,0,,Мен демалыстамын.
Dialogue: 0,0:48:41.58,0:48:43.62,Default,,0,0,0,,Клиент DJ Banks болып табылады.
Dialogue: 0,0:48:43.87,0:48:46.21,Default,,0,0,0,,Водарак қатысатын кешке ұқсайды.
Dialogue: 0,0:48:46.63,0:48:48.38,Default,,0,0,0,,Бұл заңсыз ба?
Dialogue: 0,0:48:48.55,0:48:49.80,Default,,0,0,0,,Бірақ күміс қорап
Dialogue: 0,0:48:49.92,0:48:52.05,Default,,0,0,0,,Мен оны әкелетін сияқты емеспін.
Dialogue: 0,0:48:52.38,0:48:53.22,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:48:53.34,0:48:55.89,Default,,0,0,0,,Рейв басталғалы аз уақыт қалды
Dialogue: 0,0:48:56.22,0:48:58.76,Default,,0,0,0,,Мен диджей Банктерге қарыздармын.
Dialogue: 0,0:48:59.51,0:49:01.02,Default,,0,0,0,,Рентон па?
Dialogue: 0,0:49:01.14,0:49:03.56,Default,,0,0,0,,Бұл жігіт тақтасыз қақпанға қалай мінеді?
Dialogue: 0,0:49:03.69,0:49:05.06,Default,,0,0,0,,Сіз мұны естідіңіз бе?
Dialogue: 0,0:49:05.44,0:49:06.44,Default,,0,0,0,,Мен сізге айтайын.
Dialogue: 0,0:49:07.61,0:49:08.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:10.65,0:49:13.40,Default,,0,0,0,,Сәлем Чарльз, жалғыз барғың келе ме?
Dialogue: 0,0:49:13.53,0:49:15.36,Default,,0,0,0,,Хехе, сыныптан тыс сынып.
Dialogue: 0,0:49:27.88,0:49:31.25,Default,,0,0,0,,Уайымдама, мен жәй ғана заттар алып жүрмін.
Dialogue: 0,0:49:31.42,0:49:34.63,Default,,0,0,0,,Ғажайып, тақтай денеге бекітілген.
Dialogue: 0,0:49:34.76,0:49:35.59,Default,,0,0,0,,О
Dialogue: 0,0:49:35.93,0:49:39.72,Default,,0,0,0,,Музыка деген көзге көрінбейтін нәрсені теріңізбен сезініп, билей аласыз.
Dialogue: 0,0:49:39.85,0:49:43.60,Default,,0,0,0,,Трапперлер жай көзбен көруге болмайтын нәрселерді сезініп, байқайды.
Dialogue: 0,0:49:43.73,0:49:45.14,Default,,0,0,0,,Бұл біздің бірге екенімізді білдіреді.
Dialogue: 0,0:49:45.64,0:49:48.86,Default,,0,0,0,,Тіпті KLF жағдайында да мәселе басқарманың бар-жоғында емес.
Dialogue: 0,0:49:49.44,0:49:51.86,Default,,0,0,0,,Ең бастысы - толқынмен жүре аласыз ба, жоқ па.
Dialogue: 0,0:49:52.98,0:49:53.82,Default,,0,0,0,,Шайқас
Dialogue: 0,0:49:53.94,0:49:55.03,Default,,0,0,0,,Сіздің көру қабілетіңіз жақсы, Рентон.
Dialogue: 0,0:49:55.15,0:49:56.32,Default,,0,0,0,,Мамыр Майдай
Dialogue: 0,0:49:56.78,0:49:58.20,Default,,0,0,0,,Мұнда бізге қарақшылар шабуыл жасап жатыр.
Dialogue: 0,0:49:58.32,0:50:00.83,Default,,0,0,0,,Егер бұл зат алынып тасталса, мен Үлкен Брат Бэнкспен бетпе-бет келе алмаймын.
Dialogue: 0,0:50:02.04,0:50:05.62,Default,,0,0,0,,Сіз жер қыртысының өзгеруін мақсат еткен өрт ұрысыз ба?
Dialogue: 0,0:50:05.75,0:50:08.21,Default,,0,0,0,,Осындай апаттың тереңінде?
Dialogue: 0,0:50:08.92,0:50:10.34,Default,,0,0,0,,О, бұл қорқақтық.
Dialogue: 0,0:50:10.84,0:50:14.55,Default,,0,0,0,,Бірақ бұл да бір-бірін тамақтандыру үшін күрес.
Dialogue: 0,0:50:19.14,0:50:20.76,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:50:21.18,0:50:22.89,Default,,0,0,0,,Күте тұрыңыз, Рентон.
Dialogue: 0,0:50:23.01,0:50:24.31,Default,,0,0,0,,3 ұшаққа қарсы?
Dialogue: 0,0:50:24.43,0:50:25.48,Default,,0,0,0,,Наннаннанно
Dialogue: 0,0:50:25.85,0:50:28.23,Default,,0,0,0,,Цирктегі маневр қызу жүріп жатыр!
Dialogue: 0,0:50:36.90,0:50:38.03,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:50:38.32,0:50:39.24,Default,,0,0,0,,Уф!
Dialogue: 0,0:50:40.07,0:50:41.07,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:50:43.74,0:50:44.75,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:50:45.12,0:50:46.16,Default,,0,0,0,,Хехе
Dialogue: 0,0:51:01.30,0:51:02.47,Default,,0,0,0,,Судара!
Dialogue: 0,0:51:07.35,0:51:08.64,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:51:13.48,0:51:14.32,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:51:16.07,0:51:16.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:24.12,0:51:25.45,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:51:29.62,0:51:32.33,Default,,0,0,0,,Ей, мен қақпанды құлағыммен сеземін.
Dialogue: 0,0:51:33.00,0:51:34.80,Default,,0,0,0,,Түсіндің бе, Рентон?
Dialogue: 0,0:51:36.34,0:51:37.21,Default,,0,0,0,,Иә
Dialogue: 0,0:51:38.80,0:51:40.63,Default,,0,0,0,,Тамақ үшін күресу
Dialogue: 0,0:51:46.56,0:51:48.35,Default,,0,0,0,,Уау~ Дәмді көрінеді!
Dialogue: 0,0:51:48.93,0:51:51.23,Default,,0,0,0,,Оның шынымен қауіпсіз болғаны жақсы болды.
Dialogue: 0,0:51:51.85,0:51:53.10,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:51:53.48,0:51:54.86,Default,,0,0,0,,Бұл қорқынышты емес пе?
Dialogue: 0,0:51:55.32,0:51:57.11,Default,,0,0,0,,Жоқ, жақсы болды.
Dialogue: 0,0:51:57.82,0:51:59.03,Default,,0,0,0,,Бұл рас болды
Dialogue: 0,0:51:59.24,0:52:02.11,Default,,0,0,0,,Бұл тіпті мен үшін де таңқаларлықтай болды.
Dialogue: 0,0:52:02.91,0:52:04.37,Default,,0,0,0,,Чарльздың көңіл-күйі
Dialogue: 0,0:52:04.49,0:52:07.04,Default,,0,0,0,,Бұл жерде не болғаны маңызды емес, бұл күшті.
Dialogue: 0,0:52:07.54,0:52:08.95,Default,,0,0,0,,Бірақ бұл үлкен
Dialogue: 0,0:52:09.25,0:52:12.67,Default,,0,0,0,,Не керек, күріш бар...
Dialogue: 0,0:52:13.71,0:52:16.34,Default,,0,0,0,,Тамақтың дәмді болғаны сонша, көзіме жас келді.
Dialogue: 0,0:52:17.46,0:52:21.13,Default,,0,0,0,,Табиғат та, адам да бір сәтте өзгереді.
Dialogue: 0,0:52:21.55,0:52:23.80,Default,,0,0,0,,Бұл мен үшін күтпеген жағдай болды.
Dialogue: 0,0:52:24.68,0:52:28.10,Default,,0,0,0,,Бірақ мені соншалықты тыныш сезінуге не себеп болды?
Dialogue: 0,0:52:29.27,0:52:31.14,Default,,0,0,0,,Бұл менің өмірімде бірінші рет болғандай болды
Dialogue: 0,0:52:42.32,0:52:45.24,Default,,0,0,0,,(Рентон шуылдады)
Dialogue: 0,0:52:46.99,0:52:48.16,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:52:48.49,0:52:52.66,Default,,0,0,0,,Маған қатты әсер еткені сонша, жұмысқа кірістім.
Dialogue: 0,0:52:52.83,0:52:54.79,Default,,0,0,0,,Жатақханада тұруға үйрендім.
Dialogue: 0,0:52:57.21,0:52:59.13,Default,,0,0,0,,Адамдар – біртүрлі заттар
Dialogue: 0,0:52:59.71,0:53:02.42,Default,,0,0,0,,Бірдей әрекет жасасаңыз да, реакция басқаша болады
Dialogue: 0,0:53:05.59,0:53:08.26,Default,,0,0,0,,Ол жақта адамдар «Кешігіңдер!» дейтін.
Dialogue: 0,0:53:08.51,0:53:11.77,Default,,0,0,0,,Осы кезде сіз таңғалып: «Бітті ме?» деп таң қалуыңыз мүмкін.
Dialogue: 0,0:53:16.15,0:53:18.65,Default,,0,0,0,,Маған аса зейінді емес екенімді айтты.
Dialogue: 0,0:53:18.77,0:53:22.40,Default,,0,0,0,,Мұндағы адамдар күліп: «Мен мұны істеудің қажеті жоқ еді» дейді.
Dialogue: 0,0:53:24.07,0:53:26.53,Default,,0,0,0,,Біраз уақыттан кейін бірінші рет екі адаммен уақыт өткізу
Dialogue: 0,0:53:26.87,0:53:29.16,Default,,0,0,0,,Шынымды айтсам, мен мұнда өзімді жайлы сезінемін.
Dialogue: 0,0:53:29.62,0:53:31.83,Default,,0,0,0,,Геккода мен жай ғана...
Dialogue: 0,0:53:32.41,0:53:33.37,Default,,0,0,0,,Тек...
Dialogue: 0,0:53:33.91,0:53:34.75,Default,,0,0,0,,Ах
Dialogue: 0,0:53:35.12,0:53:37.00,Default,,0,0,0,,Сіз не ойлап отырсыз? Бұл ештеңе емес
Dialogue: 0,0:53:38.08,0:53:39.29,Default,,0,0,0,,Сыртқа қараңыз.
Dialogue: 0,0:53:44.80,0:53:47.39,Default,,0,0,0,,Сіз бұл жерден ештеңе көре алмайсыз.
Dialogue: 0,0:53:47.51,0:53:48.80,Default,,0,0,0,,Бұл жұмыс па?
Dialogue: 0,0:53:49.18,0:53:50.81,Default,,0,0,0,,Рентон да келіңізші.
Dialogue: 0,0:53:51.01,0:53:54.39,Default,,0,0,0,,Мен бүгін осы қалада боламын деп ойлаймын.
Dialogue: 0,0:53:55.56,0:53:58.61,Default,,0,0,0,,Мен қашпағанымды айттым.
Dialogue: 0,0:53:58.73,0:54:00.94,Default,,0,0,0,,Бірақ бізді қуған екеуміз ғана емес едік.
Dialogue: 0,0:54:02.03,0:54:03.82,Default,,0,0,0,,Бұл күтпеген шабуыл болды...
Dialogue: 0,0:54:04.19,0:54:05.45,Default,,0,0,0,,Сіздің сапарыңыздың мақсаты қандай?
Dialogue: 0,0:54:05.74,0:54:06.78,Default,,0,0,0,,Жұмыс
Dialogue: 0,0:54:06.91,0:54:08.95,Default,,0,0,0,,Мен тасымалдау бизнесінен пакет алуға келдім.
Dialogue: 0,0:54:11.62,0:54:14.37,Default,,0,0,0,,Террористік ескерту жарияланды.
Dialogue: 0,0:54:14.54,0:54:15.54,Default,,0,0,0,,Көшеге шыққанда
Dialogue: 0,0:54:15.66,0:54:17.87,Default,,0,0,0,,Өзіңізбен бірге төлқұжатыңызды алып келуді ұмытпаңыз
Dialogue: 0,0:54:19.29,0:54:21.84,Default,,0,0,0,,Коменданттық сағат жақындап қалды.
Dialogue: 0,0:54:22.34,0:54:23.59,Default,,0,0,0,,Асыққан дұрыс
Dialogue: 0,0:54:23.76,0:54:25.09,Default,,0,0,0,,Келесі кезекте біз
Dialogue: 0,0:54:28.80,0:54:29.64,Default,,0,0,0,,Сен
Dialogue: 0,0:54:30.18,0:54:31.30,Default,,0,0,0,,Иә
Dialogue: 0,0:54:31.43,0:54:32.89,Default,,0,0,0,,Әкелері кетті
Dialogue: 0,0:54:33.01,0:54:33.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:36.60,0:54:39.73,Default,,0,0,0,,Рентон Бимс өзін бірінші рет дұрыс сезінеді
Dialogue: 0,0:54:40.61,0:54:42.77,Default,,0,0,0,,Мен отбасы деген сөздің мағынасын түсінбеймін.
Dialogue: 0,0:54:43.19,0:54:44.15,Default,,0,0,0,,Тіпті қабылданған кезде де
Dialogue: 0,0:54:44.28,0:54:46.28,Default,,0,0,0,,Мен өзімді ыңғайсыз сезіндім.
Dialogue: 0,0:54:46.99,0:54:49.78,Default,,0,0,0,,Бірақ бұл кезде мен бұған қуандым.
Dialogue: 0,0:54:50.03,0:54:53.79,Default,,0,0,0,,(Төтенше көлік сиренасы)
Dialogue: 0,0:54:57.04,0:54:58.08,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:55:05.92,0:55:06.76,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:55:06.88,0:55:07.88,Default,,0,0,0,,«Аздап жұмсауға да болар...» деп ойладым.
Dialogue: 0,0:55:21.90,0:55:22.73,Default,,0,0,0,,Соғыс?
Dialogue: 0,0:55:22.86,0:55:24.86,Default,,0,0,0,,Жоқ, бұл терроризм. Терроризм?
Dialogue: 0,0:55:25.28,0:55:26.36,Default,,0,0,0,,Сіз осында күтіп тұрсыз ба?
Dialogue: 0,0:55:26.94,0:55:28.57,Default,,0,0,0,,Жоқ, мен барамын.
Dialogue: 0,0:55:29.61,0:55:30.53,Default,,0,0,0,,
Dialogue: 0,0:55:31.74,0:55:32.57,Default,,0,0,0,,О
Dialogue: 0,0:55:32.82,0:55:35.29,Default,,0,0,0,,Бұл – Арқалар. Мен тасымалдау туралы өтініш алдым.
Dialogue: 0,0:55:35.70,0:55:38.25,Default,,0,0,0,,Мен сені күттім, өтінемін.
Dialogue: 0,0:55:50.93,0:55:51.76,Default,,0,0,0,,Ах
Dialogue: 0,0:55:51.89,0:55:53.47,Default,,0,0,0,,Бұл ол, солай емес пе?
Dialogue: 0,0:55:53.76,0:55:55.14,Default,,0,0,0,,Өтінемін?
Dialogue: 0,0:55:55.39,0:55:58.64,Default,,0,0,0,,Осы жағдайда, сіздің қызыңыз тірі кезінде.
Dialogue: 0,0:55:58.77,0:56:01.69,Default,,0,0,0,,Біз сізді Водарақтың киелі жеріне апара алатынымызға кепілдік жоқ.
Dialogue: 0,0:56:01.81,0:56:02.65,Default,,0,0,0,,(Браффорд) Лорд Дио маған өмір сыйлады—
Dialogue: 0,0:56:03.10,0:56:07.57,Default,,0,0,0,,Өзінің ақырын осында қарсы алудан гөрі, қызы киелі жерге өзі барды.
Dialogue: 0,0:56:07.69,0:56:09.44,Default,,0,0,0,,Водарак Құдайымен бір болыңыз
Dialogue: 0,0:56:09.57,0:56:12.36,Default,,0,0,0,,Мәңгілік өмірді алуға үміттену керек
Dialogue: 0,0:56:12.66,0:56:16.28,Default,,0,0,0,,Ал мен енді мұнда намаз оқи алмаймын.
Dialogue: 0,0:56:19.83,0:56:21.46,Default,,0,0,0,,Ах
Dialogue: 0,0:56:22.29,0:56:24.17,Default,,0,0,0,,Коменданттық сағат туралы ескерту
Dialogue: 0,0:56:24.50,0:56:25.59,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:56:26.29,0:56:28.00,Default,,0,0,0,,Егер сіз аздап өрескел әрекет жасасаңыз
Dialogue: 0,0:56:28.13,0:56:30.63,Default,,0,0,0,,Мен оны дәл қазір орындай алмайтын сияқтымын.
Dialogue: 0,0:56:30.76,0:56:31.63,Default,,0,0,0,,Жоқ
Dialogue: 0,0:56:31.76,0:56:35.47,Default,,0,0,0,,Мен қызымды бұдан былай ауыртқым келмейді.
Dialogue: 0,0:56:35.60,0:56:39.77,Default,,0,0,0,,Таңертең ерте коменданттық сағатты алып тастағанда, ешкім байқамай...
Dialogue: 0,0:56:41.31,0:56:44.23,Default,,0,0,0,,Е-е, оны құтқару мүмкін емес сияқты!
Dialogue: 0,0:56:44.48,0:56:45.98,Default,,0,0,0,,Жоқ, мен олай айтқан жоқпын.
Dialogue: 0,0:56:46.11,0:56:48.98,Default,,0,0,0,,Мен өмірлік тірексіз өмір сүре алмайтынымды айттым.
Dialogue: 0,0:56:49.19,0:56:52.65,Default,,0,0,0,,Сонымен, өмірді қолдау аппаратының болуы сізді құтқарады, солай ма?
Dialogue: 0,0:56:53.11,0:56:54.03,Default,,0,0,0,,Жақсы
Dialogue: 0,0:56:54.24,0:56:56.32,Default,,0,0,0,,Бұл ауруханада бұл құрал болмаса ше?
Dialogue: 0,0:56:56.45,0:56:57.83,Default,,0,0,0,,Киелі жерлерге барма
Dialogue: 0,0:56:57.95,0:57:00.91,Default,,0,0,0,,Неге оны құрал-жабдығы бар ауруханаға апармайсың?
Dialogue: 0,0:57:01.04,0:57:02.58,Default,,0,0,0,,Бұл ауруханада жоқ сияқты емес.
Dialogue: 0,0:57:02.79,0:57:04.12,Default,,0,0,0,,Сіз оны пайдалана алмайсыз.
Dialogue: 0,0:57:04.25,0:57:05.25,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:57:05.71,0:57:07.63,Default,,0,0,0,,Өйткені олар Водарак
Dialogue: 0,0:57:08.63,0:57:10.38,Default,,0,0,0,,Әскери хабарландыру бойынша
Dialogue: 0,0:57:10.51,0:57:13.88,Default,,0,0,0,,Терактіні кейбір Водарак экстремистері жасады.
Dialogue: 0,0:57:14.26,0:57:18.14,Default,,0,0,0,,Өз нәсілінің өкілі болып саналатын оны емдеуді жалғастыру.
Dialogue: 0,0:57:18.43,0:57:21.43,Default,,0,0,0,,Лаңкестік құрбандардың отбасылары үзілді-кесілді қарсылық танытқанға ұқсайды.
Dialogue: 0,0:57:21.93,0:57:25.15,Default,,0,0,0,,Бірақ ол терроризм тудырмады!
Dialogue: 0,0:57:25.35,0:57:26.65,Default,,0,0,0,,Бұл Водарак болғандықтан...
Dialogue: 0,0:57:26.77,0:57:28.27,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:57:28.52,0:57:31.78,Default,,0,0,0,,Бірақ оның ата-анасы оны қабылдады.
Dialogue: 0,0:57:32.36,0:57:34.20,Default,,0,0,0,,Сол баланың өлгенін қалайсың ба?
Dialogue: 0,0:57:34.78,0:57:36.24,Default,,0,0,0,,Водараку терминімен
Dialogue: 0,0:57:36.36,0:57:39.66,Default,,0,0,0,,Өлуден сәл басқаша болуы мүмкін.
Dialogue: 0,0:57:41.41,0:57:43.16,Default,,0,0,0,,Мәңгілік өмір мүмкін емес
Dialogue: 0,0:57:43.33,0:57:44.16,Default,,0,0,0,,Ах
Dialogue: 0,0:57:44.75,0:57:47.54,Default,,0,0,0,,Адам бір рет бұзылса, ол ешқашан бұрынғыдай болмайды.
Dialogue: 0,0:57:47.71,0:57:48.54,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:57:49.00,0:57:52.71,Default,,0,0,0,,Сондықтан, бір өлсең, бітті!
Dialogue: 0,0:57:53.05,0:57:54.38,Default,,0,0,0,,Мен бұл бала екеніне сенімдімін!
Dialogue: 0,0:57:54.63,0:57:57.22,Default,,0,0,0,,Ол жерден Водарак мәселесі.
Dialogue: 0,0:57:57.34,0:57:59.89,Default,,0,0,0,,Бұл біз айтуымыз керек нәрсе емес.
Dialogue: 0,0:58:00.93,0:58:04.23,Default,,0,0,0,,Чарльз-сан таң қаларлықтай суық.
Dialogue: 0,0:58:10.02,0:58:13.40,Default,,0,0,0,,айналасында ұлды болу қиын болуы керек.
Dialogue: 0,0:58:13.69,0:58:14.57,Default,,0,0,0,,Хехе
Dialogue: 0,0:58:15.40,0:58:17.16,Default,,0,0,0,,Баланың дәрігері?
Dialogue: 0,0:58:17.41,0:58:19.20,Default,,0,0,0,,Батыс қанатында шығар...
Dialogue: 0,0:58:20.70,0:58:21.58,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:58:21.70,0:58:22.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:25.87,0:58:28.04,Default,,0,0,0,,Өкінішке орай, бұл мүмкін емес.
Dialogue: 0,0:58:28.29,0:58:29.50,Default,,0,0,0,,(Ирис) Анашым, әкешім! Ағам мен апам да!
Dialogue: 0,0:58:29.63,0:58:34.05,Default,,0,0,0,,Баланың ата-анасының мейірімінің арқасында ол қазір өмірлік көмек көрсетуде.
Dialogue: 0,0:58:35.88,0:58:38.76,Default,,0,0,0,,(электрокардиограмма мониторының синхронды дыбысы)
Dialogue: 0,0:58:39.09,0:58:40.35,Default,,0,0,0,,Басқа ештеңе жоқ па?
Dialogue: 0,0:58:40.47,0:58:41.72,Default,,0,0,0,,Үйде
Dialogue: 0,0:58:42.26,0:58:44.02,Default,,0,0,0,,Тек біз...
Dialogue: 0,0:58:49.98,0:58:51.02,Default,,0,0,0,,Енді бұл бала да
Dialogue: 0,0:58:51.40,0:58:53.94,Default,,0,0,0,,Енді мені ренжітудің қажеті жоқ.
Dialogue: 0,0:58:54.19,0:58:55.03,Default,,0,0,0,,О
Dialogue: 0,0:58:55.15,0:58:58.86,Default,,0,0,0,,Мен мұғалімге алғыс айтамын, сондықтан сәл күте тұрыңыз.
Dialogue: 0,0:58:58.99,0:59:00.03,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:59:04.66,0:59:07.12,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:59:13.55,0:59:14.67,Default,,0,0,0,,Мистер Бимс!
Dialogue: 0,0:59:16.34,0:59:17.17,Default,,0,0,0,,Ха! Сол 100 йендік тиынды таста! Ора!
Dialogue: 0,0:59:17.30,0:59:19.68,Default,,0,0,0,,Қызым... Менің қызым жоқ.
Dialogue: 0,0:59:19.93,0:59:20.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:21.22,0:59:23.72,Default,,0,0,0,,Кез келген жағдайда біреу сізге оның водарак екенін айтты ма?
Dialogue: 0,0:59:23.89,0:59:24.85,Default,,0,0,0,,Ха!
Dialogue: 0,0:59:27.10,0:59:28.60,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:59:28.73,0:59:29.98,Default,,0,0,0,,Мүмкін менің...
Dialogue: 0,0:59:30.10,0:59:30.94,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:59:31.31,0:59:32.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:33.36,0:59:36.44,Default,,0,0,0,,Сол жастағы ұл ше?
Dialogue: 0,0:59:43.16,0:59:46.20,Default,,0,0,0,,
Dialogue: 0,0:59:50.29,0:59:52.13,Default,,0,0,0,,Кішкене шыдамдылық.
Dialogue: 0,0:59:53.67,0:59:56.09,Default,,0,0,0,,Мен ол қыз туралы ойлаған жоқпын.
Dialogue: 0,0:59:56.42,0:59:57.38,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:59:57.92,1:00:01.30,Default,,0,0,0,,Мен ештеңе істей алмадым, болды.
Dialogue: 0,1:00:05.76,1:00:10.39,Default,,0,0,0,,
Dialogue: 0,1:00:10.64,1:00:11.48,Default,,0,0,0,,Ах
Dialogue: 0,1:00:14.81,1:00:17.90,Default,,0,0,0,,Сіз ауруханадан келдіңіз. Мен сенен бірнәрсе сұрайын деп едім...
Dialogue: 0,1:00:18.11,1:00:19.49,Default,,0,0,0,,Эй, сен
Dialogue: 0,1:00:19.61,1:00:20.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:21.36,1:00:22.70,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:00:22.82,1:00:25.99,Default,,0,0,0,,Өлім киімін киген Водарак баланы қалай әкеле аласың?
Dialogue: 0,1:00:26.20,1:00:27.54,Default,,0,0,0,,Өлімге арналған киім?
Dialogue: 0,1:00:28.45,1:00:29.41,Default,,0,0,0,,Хаа~
Dialogue: 0,1:00:29.58,1:00:31.58,Default,,0,0,0,,Әйтеуір, мәселеге айналмас бұрын...
Dialogue: 0,1:00:31.71,1:00:33.79,Default,,0,0,0,,Мұнда келудегі ниетіңіз қандай?
Dialogue: 0,1:00:34.13,1:00:36.50,Default,,0,0,0,,Өлі ойнама!
Dialogue: 0,1:00:37.46,1:00:39.26,Default,,0,0,0,,Бірдеңе айт!
Dialogue: 0,1:00:39.59,1:00:42.22,Default,,0,0,0,,Тоқта! Жоқ, ол...
Dialogue: 0,1:00:42.34,1:00:43.30,Default,,0,0,0,,Ей! Апыр-ай!
Dialogue: 0,1:00:44.97,1:00:49.43,Default,,0,0,0,,Маған асыл адамымды қайтар.
Dialogue: 0,1:00:49.97,1:00:51.56,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,1:00:53.98,1:00:54.81,Default,,0,0,0,,Ах!
Dialogue: 0,1:00:56.02,1:00:57.40,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,1:00:58.44,1:01:00.86,Default,,0,0,0,,Ол терроризмді тудырмады, солай ма?
Dialogue: 0,1:01:02.07,1:01:03.86,Default,,0,0,0,,Бұл бала не істеді?
Dialogue: 0,1:01:04.20,1:01:06.07,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,1:01:06.32,1:01:09.79,Default,,0,0,0,,Келуге ниетіңіз қандай?
Dialogue: 0,1:01:09.91,1:01:14.00,Default,,0,0,0,,Сіз кенеттен отбасы мүшесінен айырылған адам қалай сезінетінін ойлап көрдіңіз бе?
Dialogue: 0,1:01:14.12,1:01:20.46,Default,,0,0,0,,(Халықтың қарғысы)
Dialogue: 0,1:01:21.30,1:01:22.88,Default,,0,0,0,,Рентон табылды ма?
Dialogue: 0,1:01:23.22,1:01:25.55,Default,,0,0,0,,Өйткені қыздар әлі бірге.
Dialogue: 0,1:01:25.68,1:01:27.89,Default,,0,0,0,,Менің ойымша, біз соншалықты алысқа бара алмаймыз.
Dialogue: 0,1:01:28.55,1:01:29.56,Default,,0,0,0,,(Ранпа) Зұлымдар Альянсы, иә? Тамаша! Кел, байқап көрейік!
Dialogue: 0,1:01:29.97,1:01:31.85,Default,,0,0,0,,Мұнарадан шығатын кемелер мен көліктер үшін
Dialogue: 0,1:01:31.97,1:01:34.06,Default,,0,0,0,,Мұндай дуэт табылмады.
Dialogue: 0,1:01:34.64,1:01:36.19,Default,,0,0,0,,Егер мен ауруханаға қайта оралсам
Dialogue: 0,1:01:36.31,1:01:39.36,Default,,0,0,0,,Қыздың ата-анасы сізге хабарласатын шығар.
Dialogue: 0,1:01:39.82,1:01:40.78,Default,,0,0,0,,Сәлем Сэм
Dialogue: 0,1:01:41.28,1:01:43.86,Default,,0,0,0,,Митч пен басқалары баланы ертерек қуған сияқты.
Dialogue: 0,1:01:43.99,1:01:46.03,Default,,0,0,0,,Водарактың қызы да солай.
Dialogue: 0,1:01:46.70,1:01:47.53,Default,,0,0,0,,Рэй, не болды?
Dialogue: 0,1:01:48.12,1:01:49.16,Default,,0,0,0,,Мен таптым
Dialogue: 0,1:01:49.28,1:01:50.37,Default,,0,0,0,,Не?
Dialogue: 0,1:01:50.58,1:01:52.04,Default,,0,0,0,,Өтінемін, байлау құралдарын әкеліңдер!
Dialogue: 0,1:01:52.25,1:01:53.20,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:01:54.66,1:01:57.54,Default,,0,0,0,,Балалар, сендерге мұны істеген қызық па?
Dialogue: 0,1:01:57.96,1:01:59.29,Default,,0,0,0,,Бұл көңілді ме?
Dialogue: 0,1:01:59.42,1:02:01.92,Default,,0,0,0,,Бұл қызық емес!
Dialogue: 0,1:02:02.92,1:02:03.97,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,1:02:04.09,1:02:07.09,Default,,0,0,0,,Бұл кек. Менің достарым мен отбасым өлтірілді.
Dialogue: 0,1:02:07.22,1:02:08.39,Default,,0,0,0,,Ах
Dialogue: 0,1:02:09.80,1:02:10.64,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:12.52,1:02:13.47,Default,,0,0,0,,Ах
Dialogue: 0,1:02:15.52,1:02:17.90,Default,,0,0,0,,Кешіріңіз, сіз мұны қазір аяқтай аласыз ба?
Dialogue: 0,1:02:18.40,1:02:20.94,Default,,0,0,0,,Мен басқа адамдардың зардап шеккенін қаламаймын.
Dialogue: 0,1:02:26.40,1:02:27.24,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:28.87,1:02:31.24,Default,,0,0,0,,Оны тексеру тобы байқады ма?
Dialogue: 0,1:02:36.00,1:02:36.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:39.08,1:02:39.92,Default,,0,0,0,,Ах
Dialogue: 0,1:02:57.14,1:02:59.60,Default,,0,0,0,,Мен сенің істегеніңді жоққа шығармаймын.
Dialogue: 0,1:03:03.69,1:03:08.49,Default,,0,0,0,,Менің ойымша, бұл шын мәнінде адам ретінде жасаған дұрыс нәрсе.
Dialogue: 0,1:03:09.61,1:03:13.28,Default,,0,0,0,,Бірақ ол баланың шынымен де соны қалағанын білмеймін.
Dialogue: 0,1:03:13.41,1:03:14.62,Default,,0,0,0,,Тағы бір нәрсе.
Dialogue: 0,1:03:15.50,1:03:17.54,Default,,0,0,0,,Бір-екі рет айтпақшы...
Dialogue: 0,1:03:17.66,1:03:19.58,Default,,0,0,0,,Ал сіз ешқашан сөйлескен емессіз.
Dialogue: 0,1:03:19.71,1:03:20.88,Default,,0,0,0,,Сіз білуге мүмкіндік жоқ
Dialogue: 0,1:03:21.00,1:03:23.13,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:03:27.84,1:03:31.14,Default,,0,0,0,,Қазір жас ханым дүниеден өтті.
Dialogue: 0,1:03:31.26,1:03:32.14,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:34.47,1:03:35.60,Default,,0,0,0,,Операцияны басқаратын шебер агент: Твайлайт
Dialogue: 0,1:03:36.14,1:03:40.52,Default,,0,0,0,,Мен сені қалаған жерге апарамын, әрине маған ақша керек емес
Dialogue: 0,1:03:41.40,1:03:42.90,Default,,0,0,0,,Қасиетті жерге
Dialogue: 0,1:03:44.86,1:03:47.53,Default,,0,0,0,,Баланың да соны қалайтынына сенімдімін.
Dialogue: 0,1:03:47.69,1:03:48.69,Default,,0,0,0,,Ха...
Dialogue: 0,1:03:49.45,1:03:51.11,Default,,0,0,0,,Уф...
Dialogue: 0,1:03:53.99,1:03:56.54,Default,,0,0,0,,(Рентон жылайды)
Dialogue: 0,1:03:59.71,1:04:00.54,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,1:04:02.54,1:04:04.59,Default,,0,0,0,,Сол бала үшін рахмет.
Dialogue: 0,1:04:04.71,1:04:08.80,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,1:04:12.97,1:04:15.89,Default,,0,0,0,,Басқа адамның сезімі туралы тіпті ойламаңыз
Dialogue: 0,1:04:16.43,1:04:18.64,Default,,0,0,0,,Мен сізге көмектесуім керек деп ойладым.
Dialogue: 0,1:04:19.48,1:04:22.19,Default,,0,0,0,,Бұл тіпті дұрыс әрекет пе?
Dialogue: 0,1:04:22.31,1:04:24.23,Default,,0,0,0,,Менде ештеңе болмады
Dialogue: 0,1:04:25.69,1:04:27.36,Default,,0,0,0,,Сол баланың сезімі...
Dialogue: 0,1:04:28.19,1:04:30.15,Default,,0,0,0,,Ол кезде де солай болды.
Dialogue: 0,1:04:31.20,1:04:35.74,Default,,0,0,0,,(электрокардиограмма мониторының синхрондалған дыбысы)
Dialogue: 0,1:04:49.76,1:04:50.84,Default,,0,0,0,,Рентон
Dialogue: 0,1:04:56.05,1:04:57.10,Default,,0,0,0,,Ум...
Dialogue: 0,1:04:59.56,1:05:00.43,Default,,0,0,0,,Не?
Dialogue: 0,1:05:11.69,1:05:13.07,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:05:15.91,1:05:18.49,Default,,0,0,0,,Маған сенімен кездеспеуім керек деді.
Dialogue: 0,1:05:21.95,1:05:23.58,Default,,0,0,0,,Маған да солай айтылды.
Dialogue: 0,1:05:25.08,1:05:28.79,Default,,0,0,0,,Себебі мен қасында тұрақсыз болып кетесің.
Dialogue: 0,1:05:29.84,1:05:31.21,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,1:05:32.26,1:05:33.22,Default,,0,0,0,,Өйткені...
Dialogue: 0,1:05:34.47,1:05:37.51,Default,,0,0,0,,Жүрек соғу жиілігін арттыратын нәрселер
Dialogue: 0,1:05:42.85,1:05:46.31,Default,,0,0,0,,Мен оны Эврикамен бірдей деп ойладым.
Dialogue: 0,1:05:47.31,1:05:48.81,Default,,0,0,0,,Сіз мен туралы ойлайсыз
Dialogue: 0,1:05:48.94,1:05:50.48,Default,,0,0,0,,Күнделікті ең жаман күннен
Dialogue: 0,1:05:50.61,1:05:52.94,Default,,0,0,0,,Мені байлаған шынжырдан босаттың.
Dialogue: 0,1:05:53.95,1:05:56.36,Default,,0,0,0,,Бірақ сіз де шынжырға байланғансыз.
Dialogue: 0,1:05:57.16,1:06:00.95,Default,,0,0,0,,Сондықтан мен сені бұл жолы босатқым келді.
Dialogue: 0,1:06:02.24,1:06:03.58,Default,,0,0,0,,Бірақ бұл басқаша болды.
Dialogue: 0,1:06:04.87,1:06:05.75,Default,,0,0,0,,Не?
Dialogue: 0,1:06:06.21,1:06:09.42,Default,,0,0,0,,Біз сияқты адам емессің деген не?
Dialogue: 0,1:06:09.54,1:06:10.80,Default,,0,0,0,,Мен түсінбедім
Dialogue: 0,1:06:11.63,1:06:13.63,Default,,0,0,0,,Сен мен сияқты емес едің
Dialogue: 0,1:06:14.55,1:06:16.13,Default,,0,0,0,,Мен мұны шынымен сезбедім.
Dialogue: 0,1:06:16.76,1:06:19.05,Default,,0,0,0,,Мен сен сияқты емеспін
Dialogue: 0,1:06:31.73,1:06:33.78,Default,,0,0,0,,Бірақ мен сенің мұны білгеніңді қалаймын.
Dialogue: 0,1:06:34.07,1:06:37.07,Default,,0,0,0,,Мен сені құтқарғым келеді, сен үшін...
Dialogue: 0,1:06:37.78,1:06:39.07,Default,,0,0,0,,Мен үшін?
Dialogue: 0,1:06:39.41,1:06:42.87,Default,,0,0,0,,Бірақ соның арқасында үлкен апат орын алды.
Dialogue: 0,1:06:43.29,1:06:46.04,Default,,0,0,0,,Сондықтан мен осылай көрінемін.
Dialogue: 0,1:06:46.29,1:06:47.16,Default,,0,0,0,,Га
Dialogue: 0,1:06:47.62,1:06:48.96,Default,,0,0,0,,Сіз осылай айтасыз...
Dialogue: 0,1:06:49.29,1:06:50.88,Default,,0,0,0,,Сіз бұлай айта алмайсыз!
Dialogue: 0,1:06:51.25,1:06:52.29,Default,,0,0,0,,Ах
Dialogue: 0,1:06:52.88,1:06:54.26,Default,,0,0,0,,(Бөлім құлаған дыбыс)
Dialogue: 0,1:06:55.05,1:06:57.63,Default,,0,0,0,,(тезірек синхронды дыбыс)
Dialogue: 0,1:07:02.81,1:07:04.22,Default,,0,0,0,,Кешіріңіз! Ах...
Dialogue: 0,1:07:14.15,1:07:15.15,Default,,0,0,0,,Мына бала ше?
Dialogue: 0,1:07:15.36,1:07:16.19,Default,,0,0,0,,Бұл бөлме.
Dialogue: 0,1:07:16.82,1:07:19.24,Default,,0,0,0,,айналасында ұлы бар ...
Dialogue: 0,1:07:20.11,1:07:21.62,Default,,0,0,0,,Жаман емес, солай ма?
Dialogue: 0,1:07:22.07,1:07:22.99,Default,,0,0,0,,О
Dialogue: 0,1:07:23.99,1:07:25.54,Default,,0,0,0,,Жаман емес
Dialogue: 0,1:07:29.04,1:07:31.21,Default,,0,0,0,,Ұмытам десем де, қуады
Dialogue: 0,1:07:31.50,1:07:34.42,Default,,0,0,0,,Мен саған ештеңе айта алмайтын адам емеспін.
Dialogue: 0,1:07:35.05,1:07:37.80,Default,,0,0,0,,Мен ең нашармын.
Dialogue: 0,1:07:42.97,1:07:45.31,Default,,0,0,0,,Неліктен? Неліктен бұл болып жатыр...
Dialogue: 0,1:07:45.43,1:07:47.14,Default,,0,0,0,,Менің кінәм бар ма? Менің кінәм бар ма?
Dialogue: 0,1:07:47.52,1:07:48.85,Default,,0,0,0,,Бұл менің кінәм емес!
Dialogue: 0,1:07:49.94,1:07:51.56,Default,,0,0,0,,Мен үмітсіз болдым
Dialogue: 0,1:07:52.06,1:07:53.86,Default,,0,0,0,,Мен шарасыз шешіммен...
Dialogue: 0,1:07:54.44,1:07:55.36,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,1:07:57.19,1:07:59.32,Default,,0,0,0,,Маған жауап бер, Нирваш.
Dialogue: 0,1:08:00.53,1:08:03.07,Default,,0,0,0,,Неліктен мұны тек мен ғана бастан кешіремін?
Dialogue: 0,1:08:03.57,1:08:06.83,Default,,0,0,0,,Неге... Мен мұны енді қаламаймын!
Dialogue: 0,1:08:10.96,1:08:12.12,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:08:43.78,1:08:45.83,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:08:46.49,1:08:47.66,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:08:47.83,1:08:49.16,Default,,0,0,0,,Сіз оқиға орнында болдыңыз, солай ма?
Dialogue: 0,1:08:49.29,1:08:50.45,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,1:08:50.96,1:08:54.46,Default,,0,0,0,,Тіпті мен... тіпті түсінбеймін.
Dialogue: 0,1:08:54.96,1:08:56.38,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,1:08:56.88,1:08:59.76,Default,,0,0,0,,Қарғыс атсын... не болды?
Dialogue: 0,1:09:00.01,1:09:01.47,Default,,0,0,0,,Сен Эврикаға не істедің?
Dialogue: 0,1:09:01.59,1:09:03.26,Default,,0,0,0,,Acperiance-тен қалай оралдыңыз?
Dialogue: 0,1:09:03.38,1:09:05.09,Default,,0,0,0,,Мен ештеңе түсінбеймін!
Dialogue: 0,1:09:06.05,1:09:07.68,Default,,0,0,0,,Мен түсінгенде
Dialogue: 0,1:09:08.22,1:09:10.35,Default,,0,0,0,,Эврика осылай болған.
Dialogue: 0,1:09:11.10,1:09:13.35,Default,,0,0,0,,Жолда Эврика да есінен танып қалды.
Dialogue: 0,1:09:13.48,1:09:14.31,Default,,0,0,0,,Не?
Dialogue: 0,1:09:14.98,1:09:17.57,Default,,0,0,0,,Сонымен, сен жалғызсың ба?
Dialogue: 0,1:09:17.69,1:09:19.11,Default,,0,0,0,,Өйткені Эврика...
Dialogue: 0,1:09:19.44,1:09:22.07,Default,,0,0,0,,Эврика, Эврика, солай болып қалды.
Dialogue: 0,1:09:22.19,1:09:23.07,Default,,0,0,0,,Уф...
Dialogue: 0,1:09:23.20,1:09:24.66,Default,,0,0,0,,Тыңда, Рентон.
Dialogue: 0,1:09:25.49,1:09:28.12,Default,,0,0,0,,Сен енді Нирвашқа мінбе.
Dialogue: 0,1:09:28.33,1:09:32.79,Default,,0,0,0,,Содан мен біреуге Эврика туралы айтқанымда...
Dialogue: 0,1:09:33.71,1:09:36.38,Default,,0,0,0,,«Егер ол рас болса, біз жасырын кіре алар едік» деп сен айтқан едің ғой?
Dialogue: 0,1:09:40.13,1:09:41.84,Default,,0,0,0,,Кез келген адам не айта алады?
Dialogue: 0,1:09:42.09,1:09:43.80,Default,,0,0,0,,Мен саған айтқан жоқпын.
Dialogue: 0,1:09:44.30,1:09:47.09,Default,,0,0,0,,Сен менің артымнан қуған сол кез
Dialogue: 0,1:09:48.01,1:09:50.18,Default,,0,0,0,,Бірақ мен қазір ештеңе туралы ойлағым келмейді.
Dialogue: 0,1:09:50.85,1:09:52.43,Default,,0,0,0,,Мен ештеңені есіме түсіргім келмейді
Dialogue: 0,1:10:14.75,1:10:15.79,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:15.96,1:10:17.79,Default,,0,0,0,,Міне, солай.
Dialogue: 0,1:10:17.92,1:10:20.50,Default,,0,0,0,,Рэй екеуміз туралы сөйлесетін кез келді.
Dialogue: 0,1:10:20.63,1:10:23.01,Default,,0,0,0,,Неге мені мама әке демейсің?
Dialogue: 0,1:10:23.13,1:10:23.96,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:24.42,1:10:27.18,Default,,0,0,0,,Жоқ, Рей, жақсы болса...
Dialogue: 0,1:10:27.30,1:10:29.14,Default,,0,0,0,,Жоқ, сен де
Dialogue: 0,1:10:29.26,1:10:31.22,Default,,0,0,0,,Ах... Ахахха...
Dialogue: 0,1:10:31.51,1:10:32.43,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:32.68,1:10:35.81,Default,,0,0,0,,Жүр, Рентон, сені ана мен әке деп шақырайық.
Dialogue: 0,1:10:35.94,1:10:37.73,Default,,0,0,0,,Дауыстап айтайық!
Dialogue: 0,1:10:44.19,1:10:46.15,Default,,0,0,0,,А-а... эй
Dialogue: 0,1:10:46.28,1:10:48.03,Default,,0,0,0,,Сіз күтпеген жерден таң қалдыңыз.
Dialogue: 0,1:10:48.16,1:10:49.32,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,1:10:49.91,1:10:52.83,Default,,0,0,0,,Мені осылай атағың келсе, жарайды.
Dialogue: 0,1:10:53.04,1:10:55.83,Default,,0,0,0,,Осы жерде болғанша.
Dialogue: 0,1:10:56.21,1:10:57.50,Default,,0,0,0,,Бірақ... а
Dialogue: 0,1:10:57.92,1:10:59.75,Default,,0,0,0,,Одан да жаманы, қансыраудан әлсіреп барамын
Dialogue: 0,1:11:00.42,1:11:03.05,Default,,0,0,0,,Орпаса қаласында ақымақтық жасау
Dialogue: 0,1:11:03.38,1:11:05.38,Default,,0,0,0,,Олардың жұмысына кедергі жасау
Dialogue: 0,1:11:05.76,1:11:07.88,Default,,0,0,0,,Уф...
Dialogue: 0,1:11:09.22,1:11:12.76,Default,,0,0,0,,Егер бұл рас болса, мені қуып жіберу керек еді.
Dialogue: 0,1:11:13.85,1:11:15.18,Default,,0,0,0,,Сен ақымақ бала.
Dialogue: 0,1:11:15.35,1:11:19.02,Default,,0,0,0,,Бұл сенің үйің, біз отбасы емеспіз.
Dialogue: 0,1:11:20.56,1:11:24.40,Default,,0,0,0,,Отбасы - қандай жағдай болмасын бірге болатын нәрсе.
Dialogue: 0,1:11:25.32,1:11:27.03,Default,,0,0,0,,Сәлем Рентон
Dialogue: 0,1:11:27.15,1:11:29.78,Default,,0,0,0,,(Рентонның айқайы)
Dialogue: 0,1:11:30.03,1:11:33.03,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,1:11:33.16,1:11:34.20,Default,,0,0,0,,Демек, Қамалардың сыртында шынымен қалалар бар екен, және онда адамдар тұрады…
Dialogue: 0,1:11:38.04,1:11:40.46,Default,,0,0,0,,Па… Папа Мама
Dialogue: 0,1:11:41.46,1:11:42.54,Default,,0,0,0,,Эхехе, менің ойымша...
Dialogue: 0,1:11:42.67,1:11:44.17,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,1:11:44.92,1:11:47.21,Default,,0,0,0,,Бұл жастардың артықшылығы.
Dialogue: 0,1:11:47.51,1:11:49.26,Default,,0,0,0,,Сіз бұл туралы ойладыңыз ба?
Dialogue: 0,1:11:49.55,1:11:50.97,Default,,0,0,0,,(Жігіттердің күлкісі)
Dialogue: 0,1:11:51.26,1:11:54.22,Default,,0,0,0,,Сіз мұны жасырмаймын деп ойлаған шығарсыз.
Dialogue: 0,1:11:54.35,1:11:56.56,Default,,0,0,0,,Бұл дұрыс емес, Чарльз!
Dialogue: 0,1:11:57.56,1:12:00.14,Default,,0,0,0,,Ммм... Хмф!
Dialogue: 0,1:12:00.69,1:12:05.52,Default,,0,0,0,,А-а-а... мм, әке, әке...
Dialogue: 0,1:12:05.65,1:12:08.53,Default,,0,0,0,,Фухахаха!
Dialogue: 0,1:12:08.65,1:12:12.07,Default,,0,0,0,,Сіз кенеттен бірдеңе айтуымды сұрасаңыз да, мен әдетте айта алмаймын.
Dialogue: 0,1:12:12.20,1:12:13.66,Default,,0,0,0,,Мен де істей алмаймын.
Dialogue: 0,1:12:14.33,1:12:16.08,Default,,0,0,0,,Э-э…
Dialogue: 0,1:12:16.37,1:12:20.00,Default,,0,0,0,,«Әке, шеше» деп бастаған дұрыс емес пе?
Dialogue: 0,1:12:20.41,1:12:21.25,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:21.87,1:12:27.05,Default,,0,0,0,,Мен әкеммен немесе анаммен бірге тұрғаным есімде жоқ.
Dialogue: 0,1:12:27.38,1:12:29.80,Default,,0,0,0,,Кенеттен «ана мен әке» үшін кедергі болады...
Dialogue: 0,1:12:31.43,1:12:32.26,Default,,0,0,0,,Иә
Dialogue: 0,1:12:33.39,1:12:34.55,Default,,0,0,0,,Не... Уау!
Dialogue: 0,1:12:36.43,1:12:40.02,Default,,0,0,0,,Мен жаттығу залында көп терледім. Сасық па?
Dialogue: 0,1:12:41.89,1:12:42.81,Default,,0,0,0,,Жоқ
Dialogue: 0,1:12:43.98,1:12:46.36,Default,,0,0,0,,Бұл сенің әкеңнің иісі.
Dialogue: 0,1:12:46.69,1:12:47.57,Default,,0,0,0,,Га
Dialogue: 0,1:12:51.36,1:12:54.07,Default,,0,0,0,,Бұл өте жақсы иіс.
Dialogue: 0,1:12:57.12,1:12:58.24,Default,,0,0,0,,(пештің электронды дыбысы)
Dialogue: 0,1:12:59.83,1:13:01.25,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,1:13:01.54,1:13:04.46,Default,,0,0,0,,Сіздің әкеңіз инженер болған.
Dialogue: 0,1:13:04.58,1:13:08.96,Default,,0,0,0,,Жас кезімнен әкем туралы көп нәрсе есімде жоқ.
Dialogue: 0,1:13:09.25,1:13:12.34,Default,,0,0,0,,Оны жиі кабинаға осылай жатқызатын.
Dialogue: 0,1:13:12.47,1:13:13.76,Default,,0,0,0,,Неге екені белгісіз, мен өзімді тыныш сезінемін.
Dialogue: 0,1:13:13.97,1:13:17.43,Default,,0,0,0,,Есімде дұрыс болса, сені сәби кезіңде осында әкелген едім.
Dialogue: 0,1:13:17.55,1:13:21.52,Default,,0,0,0,,Adlock ол кезде өте жақсы болды.
Dialogue: 0,1:13:21.68,1:13:24.27,Default,,0,0,0,,Бұл... болды?
Dialogue: 0,1:13:24.56,1:13:28.15,Default,,0,0,0,,Adlock, әдетте дымқыл және басқаларды алыстатады
Dialogue: 0,1:13:28.27,1:13:30.48,Default,,0,0,0,,«Бұл менің балам, сүйкімді емес пе?»
Dialogue: 0,1:13:31.28,1:13:34.20,Default,,0,0,0,,Бұл Нирваш болуы мүмкін бе?
Dialogue: 0,1:13:34.36,1:13:37.24,Default,,0,0,0,,Мен оны мінгенде, бұл менің бірінші рет болғандай сезілмеді.
Dialogue: 0,1:13:37.70,1:13:39.37,Default,,0,0,0,,Сіз Нирвашты міндіңіз бе?
Dialogue: 0,1:13:39.83,1:13:40.74,Default,,0,0,0,,Иә
Dialogue: 0,1:13:41.95,1:13:46.92,Default,,0,0,0,,Анау ұшақ... бұл сенің әкеңнің ұшағы болуы мүмкін.
Dialogue: 0,1:13:48.25,1:13:50.75,Default,,0,0,0,,Бұл менің әкемнің Нирвашы
Dialogue: 0,1:13:51.34,1:13:54.51,Default,,0,0,0,,Сіз Нирвашты Геккоға отырғыздыңыз ба?
Dialogue: 0,1:13:54.93,1:13:57.51,Default,,0,0,0,,Ол Белл орманындағы ата-анамның үйіне құлады.
Dialogue: 0,1:13:57.64,1:13:58.76,Default,,0,0,0,,Мені барла
Dialogue: 0,1:13:59.14,1:13:59.97,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,1:14:00.22,1:14:03.48,Default,,0,0,0,,Сонымен, өткен айда болған траппердің кері реакциясы...
Dialogue: 0,1:14:03.60,1:14:06.85,Default,,0,0,0,,Сіз сол кезде Нирваш ұшқышымен бірге болдыңыз ба?
Dialogue: 0,1:14:06.98,1:14:08.98,Default,,0,0,0,,Иә, бұл Эврика.
Dialogue: 0,1:14:11.11,1:14:13.28,Default,,0,0,0,,Мен мұндай жарқырауды ешқашан күткен емеспін
Dialogue: 0,1:14:13.69,1:14:16.36,Default,,0,0,0,,Эврика екеуіңіздің араңыздағы тәжірибе
Dialogue: 0,1:14:16.49,1:14:17.36,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:23.33,1:14:25.96,Default,,0,0,0,,Егер бұл сынақ болса, маған барудың қажеті жоқ.
Dialogue: 0,1:14:26.12,1:14:28.00,Default,,0,0,0,,Менің көңіл-күйімді білу үшін көлік жүргізу
Dialogue: 0,1:14:28.13,1:14:29.75,Default,,0,0,0,,Мен сізге бір нәрсе көрсеткім келеді.
Dialogue: 0,1:14:29.88,1:14:30.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:31.13,1:14:32.00,Default,,0,0,0,,Хехе
Dialogue: 0,1:14:37.38,1:14:38.22,Default,,0,0,0,,Га
Dialogue: 0,1:14:39.80,1:14:42.31,Default,,0,0,0,,Жалынба, жеңесің деді.
Dialogue: 0,1:14:42.68,1:14:45.10,Default,,0,0,0,,Бұл дүние нені қалайды?
Dialogue: 0,1:14:45.23,1:14:47.69,Default,,0,0,0,,Мен не жеңемін деп ойладым.
Dialogue: 0,1:14:49.90,1:14:51.27,Default,,0,0,0,,Керемет
Dialogue: 0,1:14:52.98,1:14:56.03,Default,,0,0,0,,Бірақ мен ештеңе көрмей тұрып,
Dialogue: 0,1:14:56.15,1:14:57.28,Default,,0,0,0,,Мен шештім
Dialogue: 0,1:14:57.95,1:15:00.41,Default,,0,0,0,,Көз алдымда өзгермейтін табиғат болды.
Dialogue: 0,1:15:01.24,1:15:03.12,Default,,0,0,0,,Ол кісі қайыр сұрамай жеңді
Dialogue: 0,1:15:03.83,1:15:05.83,Default,,0,0,0,,Бұл керемет болды ма?
Dialogue: 0,1:15:07.33,1:15:10.58,Default,,0,0,0,,Сондай ғажайып жер бар. Бұл планетаны қорғау үшін
Dialogue: 0,1:15:10.71,1:15:12.75,Default,,0,0,0,,Сенің әкең соғысқан
Dialogue: 0,1:15:13.71,1:15:15.71,Default,,0,0,0,,Бірақ егер бұл шайқас болмаса
Dialogue: 0,1:15:16.26,1:15:19.05,Default,,0,0,0,,Мен ешқашан мұндай жерде қалмас едім.
Dialogue: 0,1:15:20.80,1:15:22.80,Default,,0,0,0,,Сосын мен және Эврика
Dialogue: 0,1:15:23.06,1:15:24.68,Default,,0,0,0,,Осындай нәрсеге араласу
Dialogue: 0,1:15:24.81,1:15:25.68,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:15:26.18,1:15:28.14,Default,,0,0,0,,Солай емес пе, Чарльз мырза?
Dialogue: 0,1:15:34.02,1:15:36.53,Default,,0,0,0,,Сізге тыңдауға рұқсат етіңіз.
Dialogue: 0,1:15:36.65,1:15:38.95,Default,,0,0,0,,Нирвашта не болды?
Dialogue: 0,1:15:39.07,1:15:39.95,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:40.07,1:15:42.24,Default,,0,0,0,,Балалар, не көрдіңдер?
Dialogue: 0,1:15:43.45,1:15:46.37,Default,,0,0,0,,Иә, көп нәрсе есімде жоқ.
Dialogue: 0,1:15:46.91,1:15:49.37,Default,,0,0,0,,Тек Нирваштың ықшам дискісі үшін.
Dialogue: 0,1:15:49.50,1:15:52.00,Default,,0,0,0,,Amita Drive деп аталатын қосымшаны тіркесеңіз
Dialogue: 0,1:15:52.17,1:15:54.42,Default,,0,0,0,,Satori бағдарламасы деп аталатын нәрсе іске қосылды деп айтылады.
Dialogue: 0,1:15:55.05,1:15:57.55,Default,,0,0,0,,Бұл нирвашты оятады
Dialogue: 0,1:15:57.76,1:15:59.55,Default,,0,0,0,,Жарылыс құбылыстары
Dialogue: 0,1:16:00.05,1:16:01.26,Default,,0,0,0,,Ол бақылаудан шығып кетті.
Dialogue: 0,1:16:01.68,1:16:05.18,Default,,0,0,0,,Сонда мен Эвриканың солай екенін байқадым.
Dialogue: 0,1:16:05.64,1:16:06.47,Default,,0,0,0,,Дәл…
Dialogue: 0,1:16:06.81,1:16:11.35,Default,,0,0,0,,Бұл өткен айда Таңдау қақпасында болған құбылысты білдіре ме?
Dialogue: 0,1:16:11.48,1:16:12.77,Default,,0,0,0,,Э? О, иә.
Dialogue: 0,1:16:13.11,1:16:17.28,Default,,0,0,0,,Amita Drive бақылаудан шығып, Acperience құбылысы орын алды.
Dialogue: 0,1:16:18.61,1:16:21.53,Default,,0,0,0,,Жұтылмай қайтып келдің.
Dialogue: 0,1:16:21.66,1:16:23.99,Default,,0,0,0,,Иә, Эврика есінен танып қалды.
Dialogue: 0,1:16:24.12,1:16:27.33,Default,,0,0,0,,Қалғанын өз бетімше жасауға тырыстым, сондықтан мен Нирвашты жылжыттым.
Dialogue: 0,1:16:27.91,1:16:29.08,Default,,0,0,0,,Мен оны тоқтата алмаймын
Dialogue: 0,1:16:29.45,1:16:31.54,Default,,0,0,0,,Сіз жалғыз Нирвашсыз ба?
Dialogue: 0,1:16:32.17,1:16:33.46,Default,,0,0,0,,Менде ештеңе жоқ...
Dialogue: 0,1:16:34.00,1:16:36.46,Default,,0,0,0,,Бірақ мен жынды болдым, өйткені Эврика менімен бірге болды.
Dialogue: 0,1:16:37.34,1:16:38.26,Default,,0,0,0,,Байқасаңыз...
Dialogue: 0,1:16:39.55,1:16:42.26,Default,,0,0,0,,Бірақ мен ештеңе істей алмадым
Dialogue: 0,1:16:46.93,1:16:48.85,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:16:49.64,1:16:50.68,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:16:51.14,1:16:52.39,Default,,0,0,0,,Қорыққаным сонша, өзімді ұстай алмадым
Dialogue: 0,1:16:53.60,1:16:56.94,Default,,0,0,0,,Әйтсе де, көз алдымда өрбіп жатқан көрініс
Dialogue: 0,1:16:57.44,1:16:59.57,Default,,0,0,0,,Мен өзімді бір жерде таныс сияқты сезінемін.
Dialogue: 0,1:17:00.24,1:17:01.53,Default,,0,0,0,,Осы уақытта И
Dialogue: 0,1:17:01.86,1:17:04.70,Default,,0,0,0,,Менің қолымнан келгені – оған қарап тұру ғана болды.
Dialogue: 0,1:17:05.49,1:17:08.79,Default,,0,0,0,,Бұл менің тәжірибем болды
Dialogue: 0,1:17:13.87,1:17:14.79,Default,,0,0,0,,Уф!
Dialogue: 0,1:17:21.84,1:17:22.97,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:17:23.47,1:17:27.30,Default,,0,0,0,,Мен осындаймын, өйткені мен адам емеспін.
Dialogue: 0,1:17:27.60,1:17:30.06,Default,,0,0,0,,Ол кісі де мені тастап кетті.
Dialogue: 0,1:17:30.27,1:17:31.39,Default,,0,0,0,,Эврика
Dialogue: 0,1:17:33.44,1:17:38.19,Default,,0,0,0,,Мен басқалардан ерекшемін, өйткені бәрі жоғалады.
Dialogue: 0,1:17:38.73,1:17:42.53,Default,,0,0,0,,Эй Рентон, мен не істеуім керек?
Dialogue: 0,1:17:43.07,1:17:45.99,Default,,0,0,0,,Кешіріңіз, мен... кешіріңіз
Dialogue: 0,1:17:46.11,1:17:48.16,Default,,0,0,0,,Мен құбыжық болғандықтан ба?
Dialogue: 0,1:17:49.70,1:17:51.54,Default,,0,0,0,,Мен ештеңе істей алмадым.
Dialogue: 0,1:17:51.66,1:17:56.46,Default,,0,0,0,,Мен сол кемеде қалсам да, енді ештеңе істей алмаймын.
Dialogue: 0,1:17:57.83,1:18:00.92,Default,,0,0,0,,Гекко мен болуы керек жер емес еді.
Dialogue: 0,1:18:03.26,1:18:04.09,Default,,0,0,0,,Хаа~
Dialogue: 0,1:18:04.34,1:18:05.26,Default,,0,0,0,,Ах
Dialogue: 0,1:18:08.10,1:18:08.93,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:18:13.64,1:18:14.48,Default,,0,0,0,,Аа...
Dialogue: 0,1:18:15.85,1:18:17.10,Default,,0,0,0,,Чарльз мырза?
Dialogue: 0,1:18:18.73,1:18:20.52,Default,,0,0,0,,Мен мұны жасырғым келмеді.
Dialogue: 0,1:18:20.90,1:18:24.28,Default,,0,0,0,,Бірақ мен оны айта алмаймын.
Dialogue: 0,1:18:24.90,1:18:26.99,Default,,0,0,0,,Кешіріңіз... Кешіріңіз
Dialogue: 0,1:18:28.12,1:18:29.12,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:18:31.49,1:18:34.71,Default,,0,0,0,,Сіз бұған шынымен жақсысыз ба? Рентон
Dialogue: 0,1:18:34.87,1:18:35.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:35.83,1:18:36.96,Default,,0,0,0,,Ах
Dialogue: 0,1:18:37.33,1:18:38.29,Default,,0,0,0,,KLF?
Dialogue: 0,1:18:38.54,1:18:39.88,Default,,0,0,0,,Чарльз!
Dialogue: 0,1:18:40.00,1:18:40.92,Default,,0,0,0,,Иә
Dialogue: 0,1:18:41.04,1:18:44.26,Default,,0,0,0,,Не істеу керек? Осылай жүре берсең, сені атып түсіреді.
Dialogue: 0,1:18:44.55,1:18:45.42,Default,,0,0,0,,​​Хмм.
Dialogue: 0,1:18:46.05,1:18:47.51,Default,,0,0,0,,Не? Өтірік пе?
Dialogue: 0,1:18:47.63,1:18:50.51,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:18:50.89,1:18:51.72,Default,,0,0,0,,Уф...
Dialogue: 0,1:18:56.52,1:18:57.35,Default,,0,0,0,,Аһ!
Dialogue: 0,1:19:03.65,1:19:04.48,Default,,0,0,0,,Әй!
Dialogue: 0,1:19:09.70,1:19:11.16,Default,,0,0,0,,Құралдарды таңдау
Dialogue: 0,1:19:11.37,1:19:13.95,Default,,0,0,0,,Жауап алу керек.
Dialogue: 0,1:19:14.24,1:19:16.58,Default,,0,0,0,,Жуып кеткеннен кейін жауап емес
Dialogue: 0,1:19:17.37,1:19:21.21,Default,,0,0,0,,Таңдау жасау – жауапкершілікті өз мойнына алуға дайын болу.
Dialogue: 0,1:19:21.71,1:19:23.42,Default,,0,0,0,,Түсінесің бе, Рентон?
Dialogue: 0,1:19:24.34,1:19:25.71,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:19:25.92,1:19:26.76,Default,,0,0,0,,Уф...
Dialogue: 0,1:19:29.34,1:19:30.22,Default,,0,0,0,,Ах...
Dialogue: 0,1:19:36.77,1:19:37.60,Default,,0,0,0,,Әй!
Dialogue: 0,1:19:38.85,1:19:40.02,Default,,0,0,0,,Ах
Dialogue: 0,1:19:41.77,1:19:45.19,Default,,0,0,0,,Менің қарсылық көрсетуге ниетім жоқ. Өтінемін, шабуылды тоқтатыңыз.
Dialogue: 0,1:19:45.90,1:19:48.99,Default,,0,0,0,,Бұл Альфа партизандық эскадрильясының прапорщигі Чарльз Бимс.
Dialogue: 0,1:19:49.11,1:19:52.45,Default,,0,0,0,,Бұл ерекше миссия. Сіз менің жеке кодымды тексере аласыз ба?
Dialogue: 0,1:19:52.82,1:19:53.66,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:54.79,1:19:57.54,Default,,0,0,0,,Растау Кешіріңіз
Dialogue: 0,1:19:57.75,1:20:01.37,Default,,0,0,0,,Бұл 4-патрульдік батальонның аға сержанты Милтон.
Dialogue: 0,1:20:01.96,1:20:04.34,Default,,0,0,0,,Ертеңгі Гекко Шабуылдың басталуына қарай
Dialogue: 0,1:20:04.46,1:20:07.42,Default,,0,0,0,,Біз күдікті KLF, т.б. іздедік.
Dialogue: 0,1:20:08.09,1:20:11.13,Default,,0,0,0,,Мен ертеңнен бастап бірге күресуді асыға күтемін.
Dialogue: 0,1:20:11.43,1:20:13.72,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,1:20:13.85,1:20:14.93,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:20:15.64,1:20:19.48,Default,,0,0,0,,Өйткені сіз қазір демалыстасыз.
Dialogue: 0,1:20:19.64,1:20:20.60,Default,,0,0,0,,Және...
Dialogue: 0,1:20:20.85,1:20:24.11,Default,,0,0,0,,Айкода Рентон
Dialogue: 0,1:20:24.27,1:20:25.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:25.57,1:20:28.61,Default,,0,0,0,,Келесі күні Қауіпсіздік бюросы Гекконы атып түсірді.
Dialogue: 0,1:20:28.74,1:20:31.40,Default,,0,0,0,,Бортта болған Эвриканың өлтірілуі.
Dialogue: 0,1:20:31.53,1:20:34.12,Default,,0,0,0,,Өте құпия миссияға қатысуға бұйрық берілді
Dialogue: 0,1:20:34.74,1:20:36.91,Default,,0,0,0,,Ертең таңғы сағат 7-де бастапқы құрылғыға оралыңыз
Dialogue: 0,1:20:38.04,1:20:39.62,Default,,0,0,0,,Сіз қалжыңдап тұрсыз... солай ма?
Dialogue: 0,1:20:40.04,1:20:40.87,Default,,0,0,0,,Жоқ
Dialogue: 0,1:20:41.00,1:20:42.71,Default,,0,0,0,,Бұл өтірік. (Чарльз) Бұл өтірік емес.
Dialogue: 0,1:20:42.87,1:20:44.38,Default,,0,0,0,,Бұл өтірік! (Чарльз) Бұл өтірік емес!
Dialogue: 0,1:20:44.50,1:20:45.75,Default,,0,0,0,,Бұл өтірік! (Чарльз) Рентон!
Dialogue: 0,1:20:46.25,1:20:47.75,Default,,0,0,0,,Айтыңызшы, өтірік!
Dialogue: 0,1:20:48.55,1:20:49.51,Default,,0,0,0,,Иә...
Dialogue: 0,1:20:49.84,1:20:52.84,Default,,0,0,0,,Өтінемін, Чарльз, мен жаттығу жасаймын.
Dialogue: 0,1:20:53.47,1:20:56.05,Default,,0,0,0,,Ана мен әке деп айту үшін бар күшімді саламын.
Dialogue: 0,1:20:56.22,1:20:58.47,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:20:58.89,1:21:01.18,Default,,0,0,0,,Өйткені бұл... өтірік.
Dialogue: 0,1:21:02.94,1:21:05.06,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,1:21:07.90,1:21:10.90,Default,,0,0,0,,Ал таңдау уақыты келді
Dialogue: 0,1:21:22.62,1:21:24.62,Default,,0,0,0,,Операция ертең таңертең басталады
Dialogue: 0,1:21:25.17,1:21:28.25,Default,,0,0,0,,Геккого қайтып барып, оған айта аласыз.
Dialogue: 0,1:21:28.55,1:21:30.76,Default,,0,0,0,,Жүрегіңнің бір түкпірінде сақтағың келсе
Dialogue: 0,1:21:30.88,1:21:34.01,Default,,0,0,0,,Бұл кемеде қалу қорқақтық емес.
Dialogue: 0,1:21:34.51,1:21:36.64,Default,,0,0,0,,Бұл Рэйдің де, мен де қалайтыны.
Dialogue: 0,1:21:36.93,1:21:39.14,Default,,0,0,0,,Екеуінен де құтылудың жолдары бар.
Dialogue: 0,1:21:39.31,1:21:40.27,Default,,0,0,0,,Сіз шешесіз
Dialogue: 0,1:21:42.85,1:21:46.10,Default,,0,0,0,,Маған көмектес, маған көмектес, маған көмектес, маған көмектес...
Dialogue: 0,1:21:46.44,1:21:51.57,Default,,0,0,0,,Көмектес, көмектес, көмектес, көмектес, көмектес...
Dialogue: 0,1:21:52.15,1:21:54.20,Default,,0,0,0,,Мен қашан өлетінімді білмеймін!
Dialogue: 0,1:21:58.78,1:21:59.62,Default,,0,0,0,,Ах
Dialogue: 0,1:22:05.71,1:22:08.08,Default,,0,0,0,,Иә!
Dialogue: 0,1:22:23.43,1:22:24.27,Default,,0,0,0,,Уф!
Dialogue: 0,1:22:31.48,1:22:32.57,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:22:33.11,1:22:36.86,Default,,0,0,0,,Өйткені мен осындаймын, өйткені мен адам емеспін.
Dialogue: 0,1:22:37.20,1:22:39.62,Default,,0,0,0,,Ол кісі де мені тастап кетті.
Dialogue: 0,1:22:39.78,1:22:40.91,Default,,0,0,0,,Эврика
Dialogue: 0,1:22:41.74,1:22:43.58,Default,,0,0,0,,Мен кешірім сұрауым керек
Dialogue: 0,1:22:44.12,1:22:45.37,Default,,0,0,0,,Ең сорақысы
Dialogue: 0,1:22:46.08,1:22:49.71,Default,,0,0,0,,Дәл сол адам сияқты мен де оны артқа тастадым.
Dialogue: 0,1:22:51.04,1:22:51.88,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:22:53.42,1:22:56.42,Default,,0,0,0,,Мен Адрок емес, ол адаммын.
Dialogue: 0,1:22:57.22,1:22:58.22,Default,,0,0,0,,Бұл Рентон.
Dialogue: 0,1:23:06.77,1:23:09.15,Default,,0,0,0,,Бірақ өкінетін болсаңыз
Dialogue: 0,1:23:10.27,1:23:14.03,Default,,0,0,0,,Өмір бойы өзіңмен бірге алып жүруге батылың жетпесе
Dialogue: 0,1:23:14.23,1:23:19.03,Default,,0,0,0,,Не істеу керек, не істеу керек, өз еркіңіз.
Dialogue: 0,1:23:19.57,1:23:23.62,Default,,0,0,0,,Егер бұл өзімізді алдамай-ақ шешкен нәрсе болса, біз оны қабылдаймыз.
Dialogue: 0,1:23:24.08,1:23:25.33,Default,,0,0,0,,Міндетті түрде еніңіз
Dialogue: 0,1:23:35.67,1:23:36.51,Default,,0,0,0,,Ах
Dialogue: 0,1:23:43.51,1:23:44.60,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:55.86,1:23:57.61,Default,,0,0,0,,Уф... аа!
Dialogue: 0,1:23:59.95,1:24:01.95,Default,,0,0,0,,Сол түні маған не үйреттің
Dialogue: 0,1:24:02.32,1:24:04.08,Default,,0,0,0,,Сол қаладан секірген адам
Dialogue: 0,1:24:04.37,1:24:05.29,Default,,0,0,0,,Бұл қашып кеткім келгендіктен емес.
Dialogue: 0,1:24:06.62,1:24:08.75,Default,,0,0,0,,Себебі мен сен туралы білгім келді.
Dialogue: 0,1:24:08.91,1:24:09.87,Default,,0,0,0,,Себебі мен саған тиіскім келді
Dialogue: 0,1:24:10.00,1:24:11.50,Default,,0,0,0,,Себебі мен оны сезгім келді
Dialogue: 0,1:24:12.21,1:24:18.26,Default,,0,0,0,,Эврика Мен жеңуім керек...
Dialogue: 0,1:24:37.40,1:24:40.20,Default,,0,0,0,,Мен екі балам барына қуаныштымын.
Dialogue: 0,1:24:41.07,1:24:44.28,Default,,0,0,0,,Бемстің баласы әрқашан ең ыңғайлы болды.
Dialogue: 0,1:24:44.95,1:24:48.20,Default,,0,0,0,,Сондықтан мен сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,1:24:51.00,1:24:52.42,Default,,0,0,0,,Мен сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,1:24:53.08,1:24:55.75,Default,,0,0,0,,Мен Адрок Турстонның ұлы болмасам да
Dialogue: 0,1:24:56.38,1:24:58.25,Default,,0,0,0,,Мені асырап алдың ба?
Dialogue: 0,1:24:58.42,1:25:00.01,Default,,0,0,0,,Мені есіңде бар ғой, иә?
Dialogue: 0,1:25:01.67,1:25:03.43,Default,,0,0,0,,Уф...
Dialogue: 0,1:25:05.55,1:25:07.31,Default,,0,0,0,,Онда мен барамын.
Dialogue: 0,1:25:07.51,1:25:10.56,Default,,0,0,0,,Чарльз мен Рэйге рахмет.
Dialogue: 0,1:25:12.52,1:25:14.02,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:25:15.19,1:25:16.65,Default,,0,0,0,,(Рейдің айқайы)
Dialogue: 0,1:25:16.77,1:25:17.69,Default,,0,0,0,,Иә
Dialogue: 0,1:26:10.45,1:26:11.95,Default,,0,0,0,,«Сізді қалай сезіндіңіз?»
Dialogue: 0,1:26:13.12,1:26:15.71,Default,,0,0,0,,Сол ән туралы сұрайтыным осы.
Dialogue: 0,1:26:16.04,1:26:17.79,Default,,0,0,0,,Мен шынымен түсінбеймін
Dialogue: 0,1:26:18.25,1:26:20.46,Default,,0,0,0,,Оның орнына бүгін аптаның қай күні?
Dialogue: 0,1:26:20.63,1:26:22.51,Default,,0,0,0,,Иә, дүйсенбі
Dialogue: 0,1:26:22.80,1:26:24.26,Default,,0,0,0,,Ол әрқашан дүйсенбіде басталады.
Dialogue: 0,1:26:24.92,1:26:26.72,Default,,0,0,0,,Әрине, біз кездескен түн
Dialogue: 0,1:26:28.22,1:26:29.93,Default,,0,0,0,,Сен маған тиіс
Dialogue: 0,1:26:30.26,1:26:34.10,Default,,0,0,0,,Сол түні сен маған кім екеніңді айттың, дүйсенбі
Dialogue: 0,1:26:35.98,1:26:37.81,Default,,0,0,0,,Мен енді қашпаймын.
Dialogue: 0,1:26:39.86,1:26:43.69,Default,,0,0,0,,«Өтінем, жең, және ол саған берілмейді».
Dialogue: 0,1:26:44.78,1:26:47.74,Default,,0,0,0,,Ол кісінің сөзі арқамнан қағып кетті
Dialogue: 0,1:26:49.20,1:26:51.83,Default,,0,0,0,,Мен қазір саған бара жатырмын.
Dialogue: 0,1:26:52.49,1:26:54.70,Default,,0,0,0,,Жақында кездесеміз
Dialogue: 0,1:26:55.29,1:26:56.25,Default,,0,0,0,,Жақында
Dialogue: 0,1:26:57.33,1:26:58.83,Default,,0,0,0,,Сондықтан күтулеріңізді қалаймын.
Dialogue: 0,1:26:59.29,1:27:02.00,Default,,0,0,0,,Мен әлі шындық туралы ештеңе айтқан жоқпын.
Dialogue: 0,1:27:02.34,1:27:03.80,Default,,0,0,0,,Не болды?
Dialogue: 0,1:27:04.09,1:27:06.30,Default,,0,0,0,,Сен екеуміз не боламыз?
Dialogue: 0,1:27:07.18,1:27:10.26,Default,,0,0,0,,Сондықтан қазір қашатын уақыт емес.
Dialogue: 0,1:27:11.22,1:27:14.35,Default,,0,0,0,,Әй, көңіл-күйің жақсы ма?
Dialogue: 0,1:27:15.64,1:27:17.02,Default,,0,0,0,,Менің атым Рентон
Dialogue: 0,1:27:17.60,1:27:19.69,Default,,0,0,0,,Рентон Турстон 14 жаста
Dialogue: 0,1:27:21.15,1:27:22.94,Default,,0,0,0,,Сен маған тиіс
Dialogue: 0,1:27:23.11,1:27:25.86,Default,,0,0,0,,Сол дүйсенбіде сен маған кім екеніңді айттың
Dialogue: 0,1:27:25.99,1:27:28.40,Default,,0,0,0,,Сол дүйсенбі, осы дүйсенбі
Dialogue: 0,1:27:29.24,1:27:31.49,Default,,0,0,0,,Иә, қазірден бастап
Dialogue: 0,1:27:31.62,1:27:35.58,Default,,0,0,0,,Сіз бен біз үшін жаңа дүйсенбі басталады!
Dialogue: 0,1:27:43.84,1:27:49.84,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:32:34.71,1:32:40.72,Default,,0,0,0,,~♪
Dialogue: 0,1:32:42.22,1:32:48.22,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory