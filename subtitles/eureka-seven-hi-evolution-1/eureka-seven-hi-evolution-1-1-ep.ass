Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:50.25,0:00:51.59,Default,,0,0,0,,Барлық кемелерді хабардар ету
Dialogue: 0,0:00:51.71,0:00:55.63,Default,,0,0,0,,Вудсток айналасындағы әуе кеңістігінде А кезеңі әлі де орындалуда
Dialogue: 0,0:00:55.76,0:00:57.68,Default,,0,0,0,,101-рәсім (Бір-бірден)
Dialogue: 0,0:00:58.39,0:00:59.97,Default,,0,0,0,,Пайдалану нұсқаулары F
Dialogue: 0,0:01:00.10,0:01:03.18,Default,,0,0,0,,№16 түсіру қазіргі уақытта жойылды.
Dialogue: 0,0:01:03.35,0:01:05.73,Default,,0,0,0,,№17 түсіру жарамды
Dialogue: 0,0:01:06.31,0:01:07.44,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:09.48,0:01:11.52,Default,,0,0,0,,(Адроктың жылауы)
Dialogue: 0,0:01:13.99,0:01:16.65,Default,,0,0,0,,Хаа... Адамзатты құтқару үшін
Dialogue: 0,0:01:16.78,0:01:19.03,Default,,0,0,0,,Мен кісі өлтіруім керек пе?
Dialogue: 0,0:01:20.20,0:01:23.87,Default,,0,0,0,,Бұл стратегияны жасау сіздің жауапкершілігіңіз бе?
Dialogue: 0,0:01:27.50,0:01:28.63,Default,,0,0,0,,Рентон
Dialogue: 0,0:01:29.21,0:01:30.38,Default,,0,0,0,,Неліктен мен
Dialogue: 0,0:01:30.50,0:01:33.59,Default,,0,0,0,,Менің ойымша, сіз осындай нәрсені бастадыңыз ба?
Dialogue: 0,0:01:34.17,0:01:35.09,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:37.68,0:01:38.93,Default,,0,0,0,,Эврика
Dialogue: 0,0:01:41.47,0:01:43.77,Default,,0,0,0,,Өкінішке орай, мен ғалыммын.
Dialogue: 0,0:01:44.02,0:01:46.18,Default,,0,0,0,,KLF жұмыс істей алмайды
Dialogue: 0,0:01:46.48,0:01:47.39,Default,,0,0,0,,Сізге Коралян
Dialogue: 0,0:01:47.52,0:01:49.19,Default,,0,0,0,,Қолдау қажет
Dialogue: 0,0:01:49.31,0:01:50.15,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:01:52.23,0:01:55.24,Default,,0,0,0,,Суық па, Адрок? Мен қалтырап тұрмын
Dialogue: 0,0:01:55.36,0:01:57.99,Default,,0,0,0,,Суық болмаса да, қалтырап кетесің.
Dialogue: 0,0:01:58.28,0:02:00.53,Default,,0,0,0,,Адамдардың өзі осындай.
Dialogue: 0,0:02:03.28,0:02:04.12,Default,,0,0,0,,Сіз үшін көбірек
Dialogue: 0,0:02:04.24,0:02:06.83,Default,,0,0,0,,Мен саған соны үйреткім келді.
Dialogue: 0,0:02:07.12,0:02:08.08,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:02:08.71,0:02:10.96,Default,,0,0,0,,Сіз маған қазір сабақ бересіз бе?
Dialogue: 0,0:02:11.08,0:02:12.96,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:02:13.75,0:02:16.01,Default,,0,0,0,,7 сағат 30 минут өтті
Dialogue: 0,0:02:16.13,0:02:17.84,Default,,0,0,0,,T минус 25 минут
Dialogue: 0,0:02:18.47,0:02:20.68,Default,,0,0,0,,Апельсин фермасы 1-толқын
Dialogue: 0,0:02:20.80,0:02:21.64,Default,,0,0,0,,Қора ауласы
Dialogue: 0,0:02:21.76,0:02:24.43,Default,,0,0,0,,Өткір 1-ден 5-ке дейін
Dialogue: 0,0:02:24.56,0:02:25.81,Default,,0,0,0,,Содан кейін екінші толқын
Dialogue: 0,0:02:25.93,0:02:27.73,Default,,0,0,0,,Өткір 6-дан өткір 10-ға дейін
Dialogue: 0,0:02:27.85,0:02:29.10,Default,,0,0,0,,Жеткізу күту режимі
Dialogue: 0,0:02:29.81,0:02:31.90,Default,,0,0,0,,Апельсин фермасы 3-толқын
Dialogue: 0,0:02:32.02,0:02:32.86,Default,,0,0,0,,Аула…
Dialogue: 0,0:02:33.23,0:02:35.53,Default,,0,0,0,,Өткір 11-ден 15-ке дейін
Dialogue: 0,0:02:37.24,0:02:39.57,Default,,0,0,0,,Orange Farm Terminal Guidance Online
Dialogue: 0,0:02:40.32,0:02:45.62,Default,,0,0,0,,Координаталық түзету - Валенсия 2123070 Zebra
Dialogue: 0,0:02:46.79,0:02:48.58,Default,,0,0,0,,Фаворит 4-толқыннан
Dialogue: 0,0:02:48.71,0:02:52.58,Default,,0,0,0,,Доктор Турстон болжағандай, ол үшінші толқынға дейін тиімді болмайды.
Dialogue: 0,0:02:52.88,0:02:54.17,Default,,0,0,0,,Жергілікті жерде жағдай қандай?
Dialogue: 0,0:02:55.09,0:02:56.84,Default,,0,0,0,,Жұмыс орны: Вудсток
Dialogue: 0,0:02:56.96,0:02:58.26,Default,,0,0,0,,Жағдай өзгермейді
Dialogue: 0,0:02:58.63,0:02:59.59,Default,,0,0,0,,Соғыс кезінде
Dialogue: 0,0:02:59.72,0:03:00.72,Default,,0,0,0,,Апельсиндер ше?
Dialogue: 0,0:03:00.84,0:03:02.84,Default,,0,0,0,,Қанша жерден келдіңіз?
Dialogue: 0,0:03:04.14,0:03:06.31,Default,,0,0,0,,В кезеңіне өтуге болады.
Dialogue: 0,0:03:06.43,0:03:10.81,Default,,0,0,0,,А-дағы барлық ұшақтарды жойыңыз. Тіпті оқтұмсықтарды да атуға болмайды.
Dialogue: 0,0:03:11.39,0:03:13.86,Default,,0,0,0,,Күміс қорапты да укол сала алмаймын.
Dialogue: 0,0:03:14.56,0:03:16.94,Default,,0,0,0,,AFX іске қосуды жалғастырыңыз.
Dialogue: 0,0:03:17.07,0:03:17.90,Default,,0,0,0,,А…?
Dialogue: 0,0:03:18.03,0:03:19.69,Default,,0,0,0,,Бортта төтенше жағдай туралы ескерту беру
Dialogue: 0,0:03:19.94,0:03:22.03,Default,,0,0,0,,Қарулы адам өзімен бірге гуманоид коралянды алып кетеді.
Dialogue: 0,0:03:22.16,0:03:23.74,Default,,0,0,0,,Ангарға кіру
Dialogue: 0,0:03:24.03,0:03:28.37,Default,,0,0,0,,Күте тұрыңыз. Қамау бөлмесінде үш күзетшінің мәйіті расталды.
Dialogue: 0,0:03:28.75,0:03:31.50,Default,,0,0,0,,Кінәлі бір адам деп есептеледі
Dialogue: 0,0:03:31.62,0:03:33.00,Default,,0,0,0,,Мен бұған сенбеймін...
Dialogue: 0,0:03:33.29,0:03:35.08,Default,,0,0,0,,Сондықтан мен бұл туралы көп айттым!
Dialogue: 0,0:03:35.21,0:03:37.38,Default,,0,0,0,,Бұл доктор Адрок Турстон.
Dialogue: 0,0:03:37.50,0:03:39.21,Default,,0,0,0,,Ол қазірдің өзінде 7 адамды өлтірді.
Dialogue: 0,0:03:39.34,0:03:40.17,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:03:43.68,0:03:45.64,Default,,0,0,0,,Тезірек, Эврика, бізде уақыт жоқ.
Dialogue: 0,0:03:49.81,0:03:50.98,Default,,0,0,0,,Жарайды, мен ояндым.
Dialogue: 0,0:03:51.10,0:03:51.94,Default,,0,0,0,,Adlock
Dialogue: 0,0:03:52.14,0:03:53.27,Default,,0,0,0,,Иә? қазір кет
Dialogue: 0,0:03:53.39,0:03:54.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:55.10,0:03:56.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:57.40,0:03:58.52,Default,,0,0,0,,Тоқтамаңыз!
Dialogue: 0,0:03:59.82,0:04:01.53,Default,,0,0,0,,Тіпті осы сәтте
Dialogue: 0,0:04:01.65,0:04:04.61,Default,,0,0,0,,Мен құрастырған стратегия бойынша күрес
Dialogue: 0,0:04:04.74,0:04:06.78,Default,,0,0,0,,Адамдар өліп жатыр.
Dialogue: 0,0:04:07.16,0:04:10.12,Default,,0,0,0,,Уф, ах… Кеменің орнын анықтау үшін.
Dialogue: 0,0:04:11.16,0:04:14.04,Default,,0,0,0,,Қате нұсқаулармен көптеген адамдарды өлтіру
Dialogue: 0,0:04:14.17,0:04:17.38,Default,,0,0,0,,Ал оны тоқтату үшін мен тағы да өлтіремін
Dialogue: 0,0:04:18.09,0:04:22.05,Default,,0,0,0,,Ха... Бұл қалай болды?
Dialogue: 0,0:04:23.63,0:04:27.14,Default,,0,0,0,,Мен тек адамзатты құтқарғым келді.
Dialogue: 0,0:04:37.48,0:04:38.82,Default,,0,0,0,,Origin Zero іске қосылуы!
Dialogue: 0,0:04:39.32,0:04:41.53,Default,,0,0,0,,Люкті қорғау? Бұл мүмкін емес.
Dialogue: 0,0:04:41.65,0:04:44.11,Default,,0,0,0,,Бұл ақылсыз! Эвакуацияланамын! (Солдат А) Иә?
Dialogue: 0,0:04:44.65,0:04:46.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:56.87,0:04:58.13,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:05:01.84,0:05:05.68,Default,,0,0,0,,Цк, мен сені жоспарлағандай қуамын, Эврика!
Dialogue: 0,0:05:07.84,0:05:08.93,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:05:11.01,0:05:12.10,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:05:16.44,0:05:19.19,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:05:21.61,0:05:22.57,Default,,0,0,0,,Аһ!
Dialogue: 0,0:05:23.69,0:05:25.74,Default,,0,0,0,,Жарайды, уақытында жасаңыз!
Dialogue: 0,0:05:32.08,0:05:32.99,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:05:33.12,0:05:34.50,Default,,0,0,0,,Мидори кіріс тізбегі
Dialogue: 0,0:05:34.62,0:05:37.46,Default,,0,0,0,,Якусаноикацучи күші 1/8-ге дейін қысқарды
Dialogue: 0,0:05:37.96,0:05:40.38,Default,,0,0,0,,Соңғы тазарту шайқасы енді басталады.
Dialogue: 0,0:05:40.50,0:05:42.80,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:06:07.28,0:06:09.66,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:06:11.41,0:06:15.54,Default,,0,0,0,,Жанкешті бомба шабуылы дегеніміз не? Олар үмітсіз бе?
Dialogue: 0,0:06:15.66,0:06:17.62,Default,,0,0,0,,Келді, Чарльз, соққы толқыны.
Dialogue: 0,0:06:20.67,0:06:25.30,Default,,0,0,0,,Үшінші толқын қонған жоқ!
Dialogue: 0,0:06:26.63,0:06:30.43,Default,,0,0,0,,4-ші толқын келе жатыр. 5 секундтан кейін кері санақ қайта басталады.
Dialogue: 0,0:06:31.01,0:06:34.81,Default,,0,0,0,,Біз фестиваль өтетін орынды қамтамасыз етуді аяқтаған жоқпыз!
Dialogue: 0,0:06:36.77,0:06:40.65,Default,,0,0,0,,87 86 85 84
Dialogue: 0,0:06:40.90,0:06:43.94,Default,,0,0,0,,83 82 81 80
Dialogue: 0,0:06:44.48,0:06:48.53,Default,,0,0,0,,79 78 77 76
Dialogue: 0,0:06:48.65,0:06:53.41,Default,,0,0,0,,75 74 73 72 71
