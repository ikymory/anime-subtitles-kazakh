Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:19.01,Default,,0,0,0,,♪～
Dialogue: 0,0:00:19.01,0:00:20.93,Default,,0,0,0,,《Nosplash》
Dialogue: 0,0:00:21.02,0:00:23.94,Default,,0,0,0,,《Ешқандай шашыратпай суға түсу》
Dialogue: 0,0:00:24.02,0:00:28.94,Default,,0,0,0,,《Бұл суға секіру жарыстарында ұпай алудың маңызды әдісі》
Dialogue: 0,0:00:29.02,0:00:32.95,Default,,0,0,0,,《Бірақ бассейнде жүрген біздер→
Dialogue: 0,0:00:33.03,0:00:35.95,Default,,0,0,0,,Кенет маған су шашырағандай сөздер лақтырылды》
Dialogue: 0,0:00:36.03,0:00:38.95,Default,,0,0,0,,Біреуі Олимпиадаға бармаса→
Dialogue: 0,0:00:39.03,0:00:41.95,Default,,0,0,0,,Клуб құлап қалады.
Dialogue: 0,0:00:42.04,0:00:45.96,Default,,0,0,0,,Сіз қалай ойлайсыз? Бара аласыздар ма?
Dialogue: 0,0:00:46.04,0:00:49.96,Default,,0,0,0,,Токио Олимпиадасына
Dialogue: 0,0:00:50.05,0:00:51.96,Default,,0,0,0,,Мен оларды жуып, қайта әкеліп беремін, сондықтан осы уақытта бұларды киіп көрші.
Dialogue: 0,0:00:52.05,0:00:54.97,Default,,0,0,0,,《Токио Олимпиадасы》
Dialogue: 0,0:00:55.05,0:00:57.97,Default,,0,0,0,,《Ол мен үшін алыс→
Dialogue: 0,0:00:58.05,0:01:00.06,Default,,0,0,0,,Бұл түсініксіз болды》
Dialogue: 0,0:01:01.97,0:01:07.98,Default,,0,0,0,,《Бірақ сол сәтте жүрегім біртүрлі соғып кетті.》
Dialogue: 0,0:01:07.98,0:01:17.99,Default,,0,0,0,,♪～
Dialogue: 0,0:02:40.16,0:02:42.12,Default,,0,0,0,,Алдымен бір-бірден ұшып көрейік.
Dialogue: 0,0:02:49.12,0:02:51.04,Default,,0,0,0,,(қол шапалақтау дыбысы)
Dialogue: 0,0:02:51.13,0:02:53.04,Default,,0,0,0,,Бұл жеткілікті. Түсіндім, төменге түс.
Dialogue: 0,0:02:53.13,0:02:56.05,Default,,0,0,0,,Иә? (Нацу Йоко) Секірудің қажеті жоқ.
Dialogue: 0,0:02:56.13,0:02:58.05,Default,,0,0,0,,Баспалдақпен төмен түсіңіз.
Dialogue: 0,0:02:58.13,0:03:00.13,Default,,0,0,0,,Не деген…
Dialogue: 0,0:03:04.14,0:03:06.06,Default,,0,0,0,,(қол шапалақтау дыбысы)
Dialogue: 0,0:03:06.14,0:03:08.06,Default,,0,0,0,,Иә. Бұл жеткілікті. Төмен түсу.
Dialogue: 0,0:03:08.14,0:03:11.06,Default,,0,0,0,,Я...
Dialogue: 0,0:03:11.15,0:03:14.06,Default,,0,0,0,,Менің ұшқым келеді...
Dialogue: 0,0:03:14.15,0:03:16.07,Default,,0,0,0,,(қол шапалақтау дыбысы)
Dialogue: 0,0:03:16.15,0:03:20.15,Default,,0,0,0,,Иә, иә, солай. Тез түсіңіз.
Dialogue: 0,0:03:27.16,0:03:30.08,Default,,0,0,0,,Дұрыс қалыпта тұра алмайтын сүңгуірлер үшін→
Dialogue: 0,0:03:30.16,0:03:33.17,Default,,0,0,0,,Мен дұрыс сүңгуді жасай алмаймын.
Dialogue: 0,0:03:35.17,0:03:37.17,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:39.17,0:03:41.01,Default,,0,0,0,,Я...
Dialogue: 0,0:03:41.09,0:03:43.01,Default,,0,0,0,,Мойынға тым көп қысым.→
Dialogue: 0,0:03:43.09,0:03:45.01,Default,,0,0,0,,Бөксені одан әрі артқа тартыңыз.→
Dialogue: 0,0:03:45.10,0:03:48.02,Default,,0,0,0,,Қолдарыңызды тік ұстаңыз. Бірақ оларды қатты етпеңіз.→
Dialogue: 0,0:03:48.10,0:03:51.02,Default,,0,0,0,,Саусақтарыңызды біріктіріңіз, бірақ көп күш салмаңыз.→
Dialogue: 0,0:03:51.10,0:03:56.02,Default,,0,0,0,,Жоғарғы денені босаңсытып, төменгі денені қатайтыңыз.→
Dialogue: 0,0:03:56.11,0:03:59.11,Default,,0,0,0,,Күшіңізді асқазанның ортасында сақтаңыз.
Dialogue: 0,0:04:01.11,0:04:05.03,Default,,0,0,0,,Балалар, сендер жылдар бойы →
Dialogue: 0,0:04:05.12,0:04:08.04,Default,,0,0,0,,Денені туралауды орындай алмайсыз ба?
Dialogue: 0,0:04:08.12,0:04:10.04,Default,,0,0,0,,⟨Дене туралау дегеніміз не→
Dialogue: 0,0:04:10.12,0:04:13.04,Default,,0,0,0,,Дайвинг кезіндегі дұрыс қалып⟩
Dialogue: 0,0:04:13.12,0:04:17.04,Default,,0,0,0,,⟨Мысалы, сіз суға түсу тақтасынан жүзім шоғын түсіріп алсаңыз→
Dialogue: 0,0:04:17.13,0:04:19.05,Default,,0,0,0,,Ауырлық центрін осында және сол жерде еңкейтіңіз →
Dialogue: 0,0:04:19.13,0:04:23.05,Default,,0,0,0,,Тепе-теңдікті жоғалтпай суға құлау⟩
Dialogue: 0,0:04:23.13,0:04:26.05,Default,,0,0,0,,⟨Бірақ қияр болса, ол түзу сызықпен құлап кетер еді→
Dialogue: 0,0:04:26.14,0:04:28.06,Default,,0,0,0,,Суды енгізіп, төгіңіз⟩
Dialogue: 0,0:04:28.14,0:04:31.06,Default,,0,0,0,,⟨Денеңізге күшті таратпаңыз →
Dialogue: 0,0:04:31.14,0:04:36.06,Default,,0,0,0,,Бүкіл денеңізді қияр сияқты қатайтып, орындауды орындаңыз⟩
Dialogue: 0,0:04:36.15,0:04:39.07,Default,,0,0,0,,⟨Бұл әдемі әуе өнімділігінің негізі⟩
Dialogue: 0,0:04:39.15,0:04:43.07,Default,,0,0,0,,《Ол жерде тұру бір сағатты алады...》
Dialogue: 0,0:04:45.07,0:04:47.03,Default,,0,0,0,,Мұның бәрі бірінші жартыжылдық үшін
Dialogue: 0,0:04:47.07,0:04:51.08,Default,,0,0,0,,10 минуттық үзіліс жасап, қайта жалғастырыңыз.
Dialogue: 0,0:04:54.08,0:04:57.04,Default,,0,0,0,,Ол жігітке не болды? Оның есі дұрыс емес.
Dialogue: 0,0:04:57.08,0:04:59.04,Default,,0,0,0,,Денені туралау қаншалықты маңызды болса да →
Dialogue: 0,0:04:59.09,0:05:02.05,Default,,0,0,0,,Менің істегенім осы, бір-екі сағатты өткізетін ақымақтар →
Dialogue: 0,0:05:02.09,0:05:05.05,Default,,0,0,0,,Жоқ, мен олай ойламаймын. (Томоки) Мүмкін бұл стратегия шығар?
Dialogue: 0,0:05:05.09,0:05:09.05,Default,,0,0,0,,Бастау ең бастысы болғандықтан, олар оны әдейі қатаңдатқан жоқ па?
Dialogue: 0,0:05:09.10,0:05:12.06,Default,,0,0,0,,Бұндай адамдар қате түсінеді.
Dialogue: 0,0:05:12.10,0:05:16.06,Default,,0,0,0,,Өзіне сенімі жоқ адамдар ғана оғаш айлаларды қолданады.
Dialogue: 0,0:05:16.10,0:05:19.06,Default,,0,0,0,,Әрине бар. Сол түрі.
Dialogue: 0,0:05:19.11,0:05:21.07,Default,,0,0,0,,Йоичи-кун
Dialogue: 0,0:05:21.11,0:05:25.07,Default,,0,0,0,,Мен де осындай жаттықтырушыны кездестірдім.→
Dialogue: 0,0:05:25.11,0:05:27.07,Default,,0,0,0,,Америкадан келген адамның жаттықтырушысына →
Dialogue: 0,0:05:27.11,0:05:29.07,Default,,0,0,0,,Мені сол әйелге ұқсас етіп оқытты.
Dialogue: 0,0:05:29.12,0:05:31.08,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:05:31.12,0:05:34.08,Default,,0,0,0,,Бірінші күні денені мұқият теңестіру
Dialogue: 0,0:05:34.12,0:05:36.08,Default,,0,0,0,,Екінші күн - жердегі оқу
Dialogue: 0,0:05:36.12,0:05:39.08,Default,,0,0,0,,Үшінші күні жүгіру және көтерілу жаттығуларын жасаңыз
Dialogue: 0,0:05:39.13,0:05:41.00,Default,,0,0,0,,Өйткені →
Dialogue: 0,0:05:41.09,0:05:44.01,Default,,0,0,0,,Ол маған сүңгудің өзі туралы ешқашан айтқан емес.→
Dialogue: 0,0:05:44.09,0:05:47.01,Default,,0,0,0,,Олай болса, бәрі шағымдануы керек.
Dialogue: 0,0:05:47.09,0:05:49.01,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:05:49.09,0:05:53.02,Default,,0,0,0,,Бірақ жаттықтырушы Жапонияға оралғаннан кейін барлығы секіріп кетті→
Dialogue: 0,0:05:53.10,0:05:56.02,Default,,0,0,0,,Іс басқаша көріне бастады.→
Dialogue: 0,0:05:56.10,0:06:00.02,Default,,0,0,0,,Жапон бапкерлері таң қалды.
Dialogue: 0,0:06:00.11,0:06:03.03,Default,,0,0,0,,Айтпақшы, мен де мұны кейін білдім→
Dialogue: 0,0:06:03.11,0:06:05.03,Default,,0,0,0,,Сол жаттықтырушы→
Dialogue: 0,0:06:05.11,0:06:09.03,Default,,0,0,0,,Ол американдық алтын жүлдегерді дайындаған адам.
Dialogue: 0,0:06:09.11,0:06:11.03,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:06:11.12,0:06:14.04,Default,,0,0,0,,Күте тұрыңыз, Йоичи-кун.
Dialogue: 0,0:06:14.12,0:06:16.04,Default,,0,0,0,,>> Иә? (Томоки) Сол америкалық жаттықтырушы →
Dialogue: 0,0:06:16.12,0:06:20.04,Default,,0,0,0,,Оның сол адамға қатысы бар ма? >> Жоқ, олай емес
Dialogue: 0,0:06:20.13,0:06:23.05,Default,,0,0,0,,Жай ғана олардың ұқсастығы. Коучинг
Dialogue: 0,0:06:23.13,0:06:27.05,Default,,0,0,0,,Жарайды, ол әйел де қарапайым адам емес сияқты.
Dialogue: 0,0:06:27.13,0:06:30.05,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:06:30.14,0:06:34.06,Default,,0,0,0,,Олар сенің үздік спортшы екеніңді тек жеңіс тұғырында тұру арқылы білуге болатынын айтады.→
Dialogue: 0,0:06:34.14,0:06:37.06,Default,,0,0,0,,Тіпті бірінші дәрежелі жаттықтырушы мұны тек бассейнде болу арқылы жасай алады→
Dialogue: 0,0:06:37.14,0:06:39.14,Default,,0,0,0,,Мен түсіндім. Әйтеуір.
Dialogue: 0,0:06:43.07,0:06:45.03,Default,,0,0,0,,Сізде жақсы есек бар.
Dialogue: 0,0:06:45.07,0:06:47.03,Default,,0,0,0,,Иә!?
Dialogue: 0,0:06:47.07,0:06:50.03,Default,,0,0,0,,Жарайды... Менің ойымша, бәрі жақсы.
Dialogue: 0,0:06:50.07,0:06:52.03,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:52.07,0:06:55.04,Default,,0,0,0,,Платформада қолмен ұстау әрекеті →
Dialogue: 0,0:06:55.08,0:06:58.04,Default,,0,0,0,,Жапондық ойыншыларға жақсы емес ойыншылар көп.
Dialogue: 0,0:06:58.08,0:07:01.04,Default,,0,0,0,,Себеп тәжірибенің жетіспеушілігі екені анық.→
Dialogue: 0,0:07:01.08,0:07:04.04,Default,,0,0,0,,Жарайсың ба? Қолмен ұстауға қажетті бұлшықеттер →
Dialogue: 0,0:07:04.09,0:07:06.05,Default,,0,0,0,,Сіз тек қолмен жұмыс жасай аласыз.→
Dialogue: 0,0:07:06.09,0:07:08.05,Default,,0,0,0,,Күнделікті өлгенше қолмен ұстау
Dialogue: 0,0:07:08.09,0:07:11.05,Default,,0,0,0,,Уақытыңыз болса, қол қимылын жасаңыз
Dialogue: 0,0:07:11.09,0:07:13.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:13.10,0:07:15.06,Default,,0,0,0,,Дайвинг – психикалық спорт→
Dialogue: 0,0:07:15.10,0:07:18.06,Default,,0,0,0,,Егер сіз → бойынша барлығы әлсіз болатын оқиғаға сенімді болсаңыз
Dialogue: 0,0:07:18.10,0:07:22.06,Default,,0,0,0,,Бұл сізге матчта көбірек еркіндік беретіні сөзсіз.
Dialogue: 0,0:07:22.10,0:07:25.07,Default,,0,0,0,,Міне, бүгінге бәрі!
Dialogue: 0,0:07:25.11,0:07:28.07,Default,,0,0,0,,Ішім аузымнан шығып жатыр деп ойладым...
Dialogue: 0,0:07:28.11,0:07:31.07,Default,,0,0,0,,Менің құлағымнан миым түсіп қалады деп ойладым.
Dialogue: 0,0:07:31.11,0:07:35.08,Default,,0,0,0,,Менің саған бірдеңе беретінім бар, киіміңді ауыстырған соң фойеде күте тұр.
Dialogue: 0,0:07:35.12,0:07:39.08,Default,,0,0,0,,Эй, сәлем. (Йоко Нацу) Сакай Томоки, солай ма?
Dialogue: 0,0:07:39.12,0:07:41.08,Default,,0,0,0,,Қарсы боласыз ба?
Dialogue: 0,0:07:41.12,0:07:43.08,Default,,0,0,0,,Дайвинг Сіз неше жыл бастадыңыз?
Dialogue: 0,0:07:43.13,0:07:46.09,Default,,0,0,0,,5 жылдан сәл астам...
Dialogue: 0,0:07:46.13,0:07:49.09,Default,,0,0,0,,Сізге қос буынды екеніңізді айттыңыз ба?
Dialogue: 0,0:07:49.13,0:07:51.09,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:07:51.13,0:07:55.10,Default,,0,0,0,,Сіздің денеңіз адамдарға қарағанда жұмсақ. Сіздің дене пішініңіз суға түсуге жарамды.
Dialogue: 0,0:07:55.14,0:07:57.10,Default,,0,0,0,,Мен оны анық айтамын.→
Dialogue: 0,0:07:57.14,0:08:02.10,Default,,0,0,0,,Сіз міндетті түрде өсесіз. Сондықтан шыңға ұмтылыңыз.
Dialogue: 0,0:08:02.14,0:08:06.11,Default,,0,0,0,,Үлкен биіктерге көтерілу
Dialogue: 0,0:08:06.15,0:08:10.11,Default,,0,0,0,,Бұл Жапония чемпионатында жеңіске жету...
Dialogue: 0,0:08:10.15,0:08:13.11,Default,,0,0,0,,Кішкентай есігі бар адам.
Dialogue: 0,0:08:13.16,0:08:15.12,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:08:15.16,0:08:19.12,Default,,0,0,0,,Біздің мақсатымыз – Олимпиада.
Dialogue: 0,0:08:19.16,0:08:22.12,Default,,0,0,0,,Сіз де барғыңыз келетінін айттыңыз.
Dialogue: 0,0:08:22.16,0:08:25.13,Default,,0,0,0,,Бұл жай ғана күшпен болды ...
Dialogue: 0,0:08:25.17,0:08:29.13,Default,,0,0,0,,Егер сізде осындай импульс болса, жоғары қарай жүріңіз.
Dialogue: 0,0:08:29.17,0:08:33.13,Default,,0,0,0,,Тек сіз көре алатын көріністер бар.
Dialogue: 0,0:08:33.18,0:08:36.18,Default,,0,0,0,,Мен ғана көретін көрініс...
Dialogue: 0,0:08:39.18,0:08:44.06,Default,,0,0,0,,Соны көрсем... Олимпиадаға барғым келеді.
Dialogue: 0,0:08:44.14,0:08:46.06,Default,,0,0,0,,Мен байсалдымын. Бұл жолы
Dialogue: 0,0:08:46.15,0:08:48.15,Default,,0,0,0,,Мен де байсалдымын.
Dialogue: 0,0:08:57.16,0:08:59.08,Default,,0,0,0,,Ол дәл қазір не деді?
Dialogue: 0,0:08:59.16,0:09:04.08,Default,,0,0,0,,А... қос буын ше? >> Не? ол
Dialogue: 0,0:09:04.16,0:09:06.08,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:09:06.17,0:09:09.09,Default,,0,0,0,,Сіз не бергіңіз келеді?
Dialogue: 0,0:09:09.17,0:09:11.17,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:09:13.17,0:09:15.09,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:09:15.18,0:09:17.09,Default,,0,0,0,,Күнделікті өзін-өзі дайындау мәзірі
Dialogue: 0,0:09:17.18,0:09:21.10,Default,,0,0,0,,Ерікті жаттығулар өз еркіңізбен айналысатындықтан емес пе?
Dialogue: 0,0:09:21.18,0:09:24.10,Default,,0,0,0,,Өйткені мұны істе деп бұйырмайынша жасамайсың.
Dialogue: 0,0:09:24.18,0:09:26.10,Default,,0,0,0,,Сендер жапон балалары
Dialogue: 0,0:09:26.19,0:09:28.11,Default,,0,0,0,,Мен мұны істеймін. Кейде
Dialogue: 0,0:09:28.19,0:09:34.11,Default,,0,0,0,,Мұны әркім анда-санда жасайды. Тіпті орташа ойыншы.
Dialogue: 0,0:09:34.19,0:09:37.11,Default,,0,0,0,,Әйтеуір, ерте келгенім үшін кешірім сұраймын →
Dialogue: 0,0:09:37.20,0:09:40.12,Default,,0,0,0,,Келесі аптада бір аптаға іссапарым бар.→
Dialogue: 0,0:09:40.20,0:09:42.04,Default,,0,0,0,,Осы уақыт ішінде бәрін дұрыс орындаңыз.
Dialogue: 0,0:09:42.12,0:09:45.12,Default,,0,0,0,,А... (Шыңғырлау) Бұл не?
Dialogue: 0,0:09:54.13,0:09:56.05,Default,,0,0,0,,＼
Dialogue: 0,0:09:56.13,0:09:58.05,Default,,0,0,0,,Иә
Dialogue: 0,0:09:58.14,0:10:02.06,Default,,0,0,0,,Не? (Фудзитани) А... а.→
Dialogue: 0,0:10:02.14,0:10:05.06,Default,,0,0,0,,Жаңа жаттықтырушы Асаки - бастауыш және кіші мектеп оқушысы→
Dialogue: 0,0:10:05.14,0:10:08.06,Default,,0,0,0,,Мен кіші мектеп оқушыларын арнайы басқардым.
Dialogue: 0,0:10:08.15,0:10:11.06,Default,,0,0,0,,Иә. (Фудзитани) Жалғастыру →
Dialogue: 0,0:10:11.15,0:10:13.07,Default,,0,0,0,,Саған қамқор болғаным дұрыс па?
Dialogue: 0,0:10:13.15,0:10:16.07,Default,,0,0,0,,Қазіргідей жақсы.
Dialogue: 0,0:10:16.15,0:10:18.07,Default,,0,0,0,,Жай... (Фудзитани) Иә?
Dialogue: 0,0:10:18.16,0:10:20.07,Default,,0,0,0,,Біз бірге жерге жаттығу жасаймыз.
Dialogue: 0,0:10:20.16,0:10:23.08,Default,,0,0,0,,Мен көремін. Мен түссіндім. (Йоичи) Иә.
Dialogue: 0,0:10:23.16,0:10:25.16,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:10:34.17,0:10:36.09,Default,,0,0,0,,Тағзым Бау!
Dialogue: 0,0:10:36.17,0:10:39.09,Default,,0,0,0,,Кеттік, Чикува! >> Тағзым!
Dialogue: 0,0:10:39.18,0:10:41.05,Default,,0,0,0,,《Жаман ештеңе айтпа》
Dialogue: 0,0:10:41.09,0:10:45.06,Default,,0,0,0,,《Ауызға құлап қалдым деп ойла және мені тыңда》→
Dialogue: 0,0:10:45.10,0:10:47.06,Default,,0,0,0,,《Күн сайын таңертең жүгіруден бастаңыз》→
Dialogue: 0,0:10:47.10,0:10:51.06,Default,,0,0,0,,《Егер сіздің итіңіз болса, онымен кемінде 1 сағат жүгіріңіз》→
Dialogue: 0,0:10:51.10,0:10:55.07,Default,,0,0,0,,《Әрине, үй ішінде шұлық кимейсің, солай ма? 》
Dialogue: 0,0:10:55.11,0:10:57.07,Default,,0,0,0,,《Сүңгу – жалаң аяқ спорт》→
Dialogue: 0,0:10:57.11,0:11:01.07,Default,,0,0,0,,《Жалаң аяқ сезімін күнде ұштап отырмасаң, не істейсің? 》
Dialogue: 0,0:11:01.11,0:11:03.08,Default,,0,0,0,,《Ең алдымен негізгі дене күші》→
Dialogue: 0,0:11:03.12,0:11:05.08,Default,,0,0,0,,《Сол ұзақ ойында→
Dialogue: 0,0:11:05.12,0:11:08.08,Default,,0,0,0,,Соңына дейін жақсы жүйкемен орындау үшін →
Dialogue: 0,0:11:08.12,0:11:13.09,Default,,0,0,0,,Бұлшықет күші, шоғырлану және қалыптыдан жоғары ақыл-ой күші қажет.→
Dialogue: 0,0:11:13.13,0:11:17.09,Default,,0,0,0,,《Негізгі дене күші осының барлығына негіз болады》→
Dialogue: 0,0:11:17.13,0:11:21.09,Default,,0,0,0,,《Сонымен қатар, мен бірнеше рет айтқанымдай, денені мұқият теңестіру》→
Dialogue: 0,0:11:21.13,0:11:24.10,Default,,0,0,0,,《Күнде түнде айна алдында өз қалпыңызды тексеріңіз》→
Dialogue: 0,0:11:24.14,0:11:28.10,Default,,0,0,0,,《Сенің иығың тартылып қалды ма? Асқазаныңыз шығып тұр ма?》→
Dialogue: 0,0:11:28.14,0:11:30.10,Default,,0,0,0,,《Бөкселерің қатты ма?》
Dialogue: 0,0:11:30.14,0:11:32.10,Default,,0,0,0,,Оны мықтап қатайтыңыз...?
Dialogue: 0,0:11:32.15,0:11:35.11,Default,,0,0,0,,\(Хироя) Эй, Томо! (Томоки) Не... не!?
Dialogue: 0,0:11:35.15,0:11:37.15,Default,,0,0,0,,\(Хироя) Телефон шырылдап жатыр.
Dialogue: 0,0:11:42.11,0:11:46.03,Default,,0,0,0,,📱(Қоңырау үні)
Dialogue: 0,0:11:46.12,0:11:49.04,Default,,0,0,0,,Сәлеметсіз бе, сіз маған қоңырау шалдыңыз ба?
Dialogue: 0,0:11:49.12,0:11:52.04,Default,,0,0,0,,📱(Досы) О, Шиташита. Бүгін боссың ба? →
Dialogue: 0,0:11:52.12,0:11:54.04,Default,,0,0,0,,Бұл мереке, сондықтан біз жиналайық деп сөйлестік.
Dialogue: 0,0:11:54.13,0:11:57.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:57.13,0:11:59.05,Default,,0,0,0,,📱Мен жаңа ойын сатып алдым
Dialogue: 0,0:11:59.13,0:12:01.05,Default,,0,0,0,,Кешіріңіз, мен бара алмаймын.
Dialogue: 0,0:12:01.13,0:12:06.05,Default,,0,0,0,,📱Қайтадан секіргіңіз келе ме? Жарайды, мен басқа біреуді шақырамын.
Dialogue: 0,0:12:06.14,0:12:08.14,Default,,0,0,0,,Келесі кездескенше... 📱(Қоңырауды ажырату дыбысы)
Dialogue: 0,0:12:19.99,0:12:29.91,Default,,0,0,0,,♪～
Dialogue: 0,0:12:29.91,0:12:31.91,Default,,0,0,0,,Табылды...
Dialogue: 0,0:12:36.92,0:12:39.92,Default,,0,0,0,,Бұған ешқандай күмән жоқ. Бұл бала.
Dialogue: 0,0:12:41.92,0:12:44.84,Default,,0,0,0,,Сондықтан қорқасың.
Dialogue: 0,0:12:44.93,0:12:46.85,Default,,0,0,0,,Не?
Dialogue: 0,0:12:46.93,0:12:48.85,Default,,0,0,0,,Теңізден кетуге қорқады
Dialogue: 0,0:12:48.93,0:12:52.85,Default,,0,0,0,,Жаңа әлемге қадам басудан қорқады
Dialogue: 0,0:12:52.93,0:12:55.85,Default,,0,0,0,,Ал атаңның жинағандары→
Dialogue: 0,0:12:55.94,0:12:57.86,Default,,0,0,0,,Мен жойылып кетуден қорқамын
Dialogue: 0,0:12:57.94,0:12:59.86,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:12:59.94,0:13:04.86,Default,,0,0,0,,Аты аңызға айналған данышпан сүңгуір Окицу Ширанамидің немересі Окицу Сплэш
Dialogue: 0,0:13:04.95,0:13:06.87,Default,,0,0,0,,Теңізде ғана ұшады
Dialogue: 0,0:13:06.95,0:13:08.87,Default,,0,0,0,,Бұл сөзсіз керемет, солай емес пе?→
Dialogue: 0,0:13:08.95,0:13:12.87,Default,,0,0,0,,Мен бассейнге бару арқылы ештеңеге тәуекел етпес едім.→
Dialogue: 0,0:13:12.95,0:13:14.87,Default,,0,0,0,,Қарт адам сияқты
Dialogue: 0,0:13:14.96,0:13:18.88,Default,,0,0,0,,Қарт Токиоға тәуекелге барған жоқ.→
Dialogue: 0,0:13:18.96,0:13:21.88,Default,,0,0,0,,Ол жаққа барсаңыз, таңғажайып нәрсе болады→
Dialogue: 0,0:13:21.96,0:13:24.88,Default,,0,0,0,,Мен ол жерге үлкен үмітпен бардым. Бірақ ештеңе болған жоқ.→
Dialogue: 0,0:13:24.97,0:13:28.85,Default,,0,0,0,,Қартқа ештеңе қалмады, артта қалған ештеңе жоқ.
Dialogue: 0,0:13:28.89,0:13:30.85,Default,,0,0,0,,Мен оны тастап кеттім.
Dialogue: 0,0:13:30.89,0:13:34.85,Default,,0,0,0,,Хмф... Біреудің жадында қалдырдым демеңіз.
Dialogue: 0,0:13:34.89,0:13:37.85,Default,,0,0,0,,Пішінсіз жақсылық жоқ.
Dialogue: 0,0:13:37.90,0:13:40.86,Default,,0,0,0,,Көрінетін нәтиже болмаса, сіз ұтылдыңыз.
Dialogue: 0,0:13:40.90,0:13:42.86,Default,,0,0,0,,Ал, мен саған көрсетемін.
Dialogue: 0,0:13:42.90,0:13:44.86,Default,,0,0,0,,Атаңның артында қалғаны
Dialogue: 0,0:13:44.90,0:13:46.86,Default,,0,0,0,,А? (Нацу Йоко) Дегенмен→
Dialogue: 0,0:13:46.91,0:13:51.91,Default,,0,0,0,,Атамнан қалған тілегіңді орындасаң
Dialogue: 0,0:13:53.91,0:13:57.87,Default,,0,0,0,,Не? Асаки жаттықтырушы? (Юкия) Дұрыс.
Dialogue: 0,0:13:57.92,0:13:59.88,Default,,0,0,0,,Қайтыс болған МДК негізін қалаушы →
Dialogue: 0,0:13:59.92,0:14:02.88,Default,,0,0,0,,Ол төраға Мизукидің немересі.
Dialogue: 0,0:14:02.92,0:14:06.88,Default,,0,0,0,,Бұл бәрі емес, Асаки жаттықтырушы - бұрынғы сүңгуір→
Dialogue: 0,0:14:06.93,0:14:10.89,Default,,0,0,0,,Ол жасөспірімдер арасындағы турнирде болашағы зор ойыншы болып көрінді.
Dialogue: 0,0:14:10.93,0:14:14.89,Default,,0,0,0,,6 жастан 14 жасқа дейін Нью-Йоркте 8 жыл болды...
Dialogue: 0,0:14:14.93,0:14:17.89,Default,,0,0,0,,Қайтып оралған балалар деп аталатындар.
Dialogue: 0,0:14:17.94,0:14:21.90,Default,,0,0,0,,Иә! Бұл Нью-Йорк! нью йорк!
Dialogue: 0,0:14:21.94,0:14:23.90,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:14:23.94,0:14:25.82,Default,,0,0,0,,Ол сүңгуді бастады →
Dialogue: 0,0:14:25.90,0:14:27.82,Default,,0,0,0,,8 жас шамасында→
Dialogue: 0,0:14:27.90,0:14:30.82,Default,,0,0,0,,Мен Жапонияға оралып, біраз уақытқа кетіп қалсам да →
Dialogue: 0,0:14:30.91,0:14:33.83,Default,,0,0,0,,Орта мектепті бітіргеннен кейін мен суға сүңгуді үйренуге қайта оралдым →
Dialogue: 0,0:14:33.91,0:14:36.83,Default,,0,0,0,,Бұл жолы мен Америкаға жалғыз барамын.
Dialogue: 0,0:14:36.91,0:14:39.83,Default,,0,0,0,,Бірақ ойыншы ретінде емес→
Dialogue: 0,0:14:39.92,0:14:42.84,Default,,0,0,0,,Спортшыларға нұсқау беретін ізденуші жаттықтырушы ретінде.→
Dialogue: 0,0:14:42.92,0:14:44.84,Default,,0,0,0,,Бұл не үшін деп ойлайсыз?
Dialogue: 0,0:14:44.92,0:14:47.84,Default,,0,0,0,,Мен білмеймін. Ол не үшін?
Dialogue: 0,0:14:47.92,0:14:50.84,Default,,0,0,0,,Онда менің атам, төраға Мизуки жұмыс істеген →
Dialogue: 0,0:14:50.93,0:14:53.85,Default,,0,0,0,,Мен MDC-те жаттықтыру үшін келдім!
Dialogue: 0,0:14:53.93,0:14:56.85,Default,,0,0,0,,Осы мақсатта...
Dialogue: 0,0:14:56.93,0:14:59.85,Default,,0,0,0,,>> Сондай-ақ... (Томоки) Не?
Dialogue: 0,0:14:59.94,0:15:01.86,Default,,0,0,0,,MDC құлауын болдырмау үшін→
Dialogue: 0,0:15:01.94,0:15:04.86,Default,,0,0,0,,Мен бірімізді Олимпиадаға жіберуді жоспарлап отырмын.
Dialogue: 0,0:15:04.94,0:15:08.86,Default,,0,0,0,,Ол байсалды ма?
Dialogue: 0,0:15:08.95,0:15:11.87,Default,,0,0,0,,《Біздің мақсатымыз – Олимпиада》
Dialogue: 0,0:15:11.95,0:15:13.87,Default,,0,0,0,,Сіз Олимпиадаға қатысуды мақсат етесіз бе?
Dialogue: 0,0:15:13.95,0:15:16.87,Default,,0,0,0,,Жоқ, мүмкін емес... Дұрыс па?
Dialogue: 0,0:15:16.95,0:15:19.87,Default,,0,0,0,,Теріс пікірлер жақсы емес.
Dialogue: 0,0:15:19.96,0:15:21.88,Default,,0,0,0,,Бұл мүмкін емес деп ойлаймын... >> Иә?
Dialogue: 0,0:15:21.96,0:15:23.88,Default,,0,0,0,,Бұл мүмкін емес, солай емес пе?
Dialogue: 0,0:15:23.96,0:15:27.88,Default,,0,0,0,,Олимпиадаға бір жарым жыл қалды. Бас тартуға әлі ерте.
Dialogue: 0,0:15:27.96,0:15:31.89,Default,,0,0,0,,Дұрыс. >> Жоқ, күткендей...
Dialogue: 0,0:15:31.97,0:15:34.89,Default,,0,0,0,,Йоичи-кунның мүмкіндігі болуы мүмкін.
Dialogue: 0,0:15:34.97,0:15:38.89,Default,,0,0,0,,Мойындау керек, егер бұл басқа жарыс болса, мүмкін емес еді.→
Dialogue: 0,0:15:38.98,0:15:41.90,Default,,0,0,0,,Дайвинг ойыншыларының бассейні жұқа.→
Dialogue: 0,0:15:41.98,0:15:44.90,Default,,0,0,0,,Сүңгуір бойдақ ер адамдар үшін 3 орын бар.→
Dialogue: 0,0:15:44.98,0:15:49.90,Default,,0,0,0,,Әзірге Хиогодан келген Кеничиро Терамото шешім қабылдады деп айтуға болады.→
Dialogue: 0,0:15:49.99,0:15:51.91,Default,,0,0,0,,Барлығы қайда қалды?
Dialogue: 0,0:15:51.99,0:15:55.91,Default,,0,0,0,,Біз әлгі доккой доккойда да жоқпыз.
Dialogue: 0,0:15:55.99,0:15:58.91,Default,,0,0,0,,Сәлем? Хмм, дұрыс.
Dialogue: 0,0:15:59.00,0:16:00.91,Default,,0,0,0,,Барлығы тым пессимистік.
Dialogue: 0,0:16:01.00,0:16:03.92,Default,,0,0,0,,Сіз шындықты ең көп көруді қажет ететін адамсыз, солай емес пе?
Dialogue: 0,0:16:04.00,0:16:06.92,Default,,0,0,0,,Шындық →
Dialogue: 0,0:16:07.00,0:16:08.92,Default,,0,0,0,,Осы адамдардың бірі Олимпиадаға бармаса→
Dialogue: 0,0:16:09.01,0:16:11.93,Default,,0,0,0,,Бұл жер құлағалы жатыр. (3 адам) А...
Dialogue: 0,0:16:12.01,0:16:14.93,Default,,0,0,0,,Ах~ Йоичи-кун, сен мұны айтасың ба?
Dialogue: 0,0:16:15.01,0:16:19.02,Default,,0,0,0,,Бірақ MDC-де бұл әйел жаттықтырушы бар.
Dialogue: 0,0:16:22.02,0:16:25.90,Default,,0,0,0,,Жақсы болады. Йоичи Олимпиадаға барса→
Dialogue: 0,0:16:25.94,0:16:28.90,Default,,0,0,0,,Ешқандай проблема жоқ. (Юкия) Оны басқаларға қалдырыңыз.
Dialogue: 0,0:16:28.94,0:16:30.94,Default,,0,0,0,,Бұл шынайы.
Dialogue: 0,0:16:32.95,0:16:34.91,Default,,0,0,0,,Мүмкіндік нөлге тең бе?
Dialogue: 0,0:16:34.95,0:16:38.91,Default,,0,0,0,,>> Не? (Томоки) Біз Олимпиадаға барамыз.
Dialogue: 0,0:16:38.95,0:16:40.91,Default,,0,0,0,,Нөл емес
Dialogue: 0,0:16:40.95,0:16:43.92,Default,,0,0,0,,Бұл шын мәнінде минус.
Dialogue: 0,0:16:43.96,0:16:47.92,Default,,0,0,0,,Айтпақшы, бүгін үйге қайтып бара жатқанда бірдеңе жегіңіз келе ме?
Dialogue: 0,0:16:47.96,0:16:49.92,Default,,0,0,0,,Жақсы. (Юкия) Мен де барамын!
Dialogue: 0,0:16:49.96,0:16:54.93,Default,,0,0,0,,Бастауыш сынып оқушылары үшін бұл жақсы емес. (Юкия) Бу~ Неге?
Dialogue: 0,0:16:54.97,0:16:57.93,Default,,0,0,0,,Өз бетінше дайындық туралы не деуге болады?
Dialogue: 0,0:16:57.97,0:17:00.93,Default,,0,0,0,,Өзін-өзі жаттықтыру, Томо, мүмкін...
Dialogue: 0,0:17:00.97,0:17:02.93,Default,,0,0,0,,Сіз бұл мәзірді жасайсыз ба?
Dialogue: 0,0:17:02.98,0:17:04.94,Default,,0,0,0,,Иә
Dialogue: 0,0:17:04.98,0:17:07.94,Default,,0,0,0,,Күн сайын? (Томоки) Иә, бірақ
Dialogue: 0,0:17:07.98,0:17:10.94,Default,,0,0,0,,Олай жасасаңыз, басқа ештеңе істей алмайсыз ба?
Dialogue: 0,0:17:10.98,0:17:12.94,Default,,0,0,0,,Сондықтан бұл өте қиын
Dialogue: 0,0:17:12.99,0:17:16.95,Default,,0,0,0,,Олай болса, бүгін дүкенге барайық.
Dialogue: 0,0:17:16.99,0:17:19.95,Default,,0,0,0,,Және сызықшамен. иә? Сіз жүгіресіз бе?
Dialogue: 0,0:17:19.99,0:17:23.00,Default,,0,0,0,,Бұл жаттығуды алмастыратын құрал. (Томоки) Бұл жақсы!
Dialogue: 0,0:17:32.96,0:17:35.88,Default,,0,0,0,,Не? Сен де бүгін жүгіресің бе? (Томоки) Иә.
Dialogue: 0,0:17:35.97,0:17:39.89,Default,,0,0,0,,Сіз бұлшық етсіз болғанда не істейсіз?
Dialogue: 0,0:17:39.97,0:17:41.89,Default,,0,0,0,,Неліктен Миха →
Dialogue: 0,0:17:41.97,0:17:43.89,Default,,0,0,0,,Мен осы спорт ақымақпен кездесіп жүрмін.
Dialogue: 0,0:17:43.98,0:17:46.90,Default,,0,0,0,,Егер біз бәрібір кездесіп жүрсек, мен Томодан гөрі сенімен болғанды ​​жақсы көремін.
Dialogue: 0,0:17:46.98,0:17:48.90,Default,,0,0,0,,Михаға айт
Dialogue: 0,0:17:48.98,0:17:50.90,Default,,0,0,0,,Мен айттым...
Dialogue: 0,0:17:50.98,0:17:53.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:53.99,0:17:56.91,Default,,0,0,0,,Мен қайтып келдім! Асаки жаттықтырушы! →
Dialogue: 0,0:17:56.99,0:18:00.91,Default,,0,0,0,,Ал ер адаммен! (3 адам) Иә?
Dialogue: 0,0:18:00.99,0:18:02.99,Default,,0,0,0,,Қожайын болуы мүмкін!
Dialogue: 0,0:18:09.00,0:18:10.92,Default,,0,0,0,,(қол шапалақтау дыбысы)
Dialogue: 0,0:18:11.00,0:18:13.92,Default,,0,0,0,,Иә. Бәріңе сәлем, тыңдаңдар. →
Dialogue: 0,0:18:14.01,0:18:16.93,Default,,0,0,0,,Таныстырғыңыз келетін адам бар ма?
Dialogue: 0,0:18:17.01,0:18:19.93,Default,,0,0,0,,Уау! Ай, ай, ай...｡ (Нацу Йоко)《Мен сенің ханымынмын》
Dialogue: 0,0:18:20.01,0:18:21.93,Default,,0,0,0,,Окицу-кун. (Юкия) Иә!?
Dialogue: 0,0:18:22.01,0:18:25.85,Default,,0,0,0,,Бүгіннен бастап сіз MDC мүшесісіз, Окицу Хикару мырза.→
Dialogue: 0,0:18:25.93,0:18:28.85,Default,,0,0,0,,Мен кеше ғана Аомориден Токиоға келдім.→
Dialogue: 0,0:18:28.94,0:18:31.86,Default,,0,0,0,,Әй, бәріңе сәлем айт.
Dialogue: 0,0:18:31.94,0:18:34.86,Default,,0,0,0,,Сәлеметсіз бе. (Барлығы) Рахмет!
Dialogue: 0,0:18:34.94,0:18:38.86,Default,,0,0,0,,Содан кейін денені қыздыру жаттығуларын жалғастырыңыз.
Dialogue: 0,0:18:38.95,0:18:40.87,Default,,0,0,0,,Сіз автотренингті дұрыс орындадыңыз ба?
Dialogue: 0,0:18:40.95,0:18:43.87,Default,,0,0,0,,Иә. Ал...
Dialogue: 0,0:18:43.95,0:18:45.87,Default,,0,0,0,,Иә. (Нацу Йоко) Жарайды.
Dialogue: 0,0:18:45.95,0:18:48.87,Default,,0,0,0,,Оны көргенде білесің
Dialogue: 0,0:18:48.96,0:18:51.88,Default,,0,0,0,,Жаттықтырушы Ошима сол жігіт → дейді
Dialogue: 0,0:18:51.96,0:18:53.88,Default,,0,0,0,,Оны бір кездері данышпан сүңгуір деп атаған→
Dialogue: 0,0:18:53.96,0:18:56.88,Default,,0,0,0,,Окицу Ширанамидің немересі болса керек.
Dialogue: 0,0:18:56.97,0:18:59.97,Default,,0,0,0,,Сіз тек теңізде ұшады дедіңіз.
Dialogue: 0,0:19:01.97,0:19:04.89,Default,,0,0,0,,Ол тыныш. Ол күткендей теңіз адамына ұқсайды.
Dialogue: 0,0:19:04.97,0:19:07.89,Default,,0,0,0,,Сіз тек балық аулауға жүрегіңізді ашасыз ба?
Dialogue: 0,0:19:07.98,0:19:09.89,Default,,0,0,0,,Оның орнына. Бұрын-соңды болмаған →
Dialogue: 0,0:19:09.98,0:19:12.90,Default,,0,0,0,,Сіз ешқашан бассейнде ұшпағаныңыз рас па?
Dialogue: 0,0:19:12.98,0:19:14.90,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:19:14.98,0:19:17.90,Default,,0,0,0,,Менің ойымша, оны бір кезде кит жеп қойған деген жалғандық.
Dialogue: 0,0:19:17.99,0:19:22.91,Default,,0,0,0,,Олай болса, неге қазір бассейнде ұшқың келді?
Dialogue: 0,0:19:22.99,0:19:25.87,Default,,0,0,0,,Барлығы сізді қызықтырады.
Dialogue: 0,0:19:25.91,0:19:28.87,Default,,0,0,0,,Бұл теңізде болған жоқ, солай ма?
Dialogue: 0,0:19:28.91,0:19:31.88,Default,,0,0,0,,Сіздің қатысуыңызды асыға күтемін.→
Dialogue: 0,0:19:31.92,0:19:35.88,Default,,0,0,0,,Бұл қандай сезімде? Теріңіздің іші кедір-бұдыр емес пе?
Dialogue: 0,0:19:35.92,0:19:38.88,Default,,0,0,0,,Шулы ма? (Нацу Йоко) Дұрыс. Қан тамырлары.→
Dialogue: 0,0:19:38.92,0:19:41.89,Default,,0,0,0,,Көтеріп бара жатқан ағындай, қан ағыла бастайды.→
Dialogue: 0,0:19:41.93,0:19:46.89,Default,,0,0,0,,Мен өзімді күшке толы сезінемін және дәл қазір кез келген нәрсені істей алатынымды сезінемін.
Dialogue: 0,0:19:46.93,0:19:48.89,Default,,0,0,0,,Сізге бұл ұнамайды, солай ма?
Dialogue: 0,0:19:48.93,0:19:52.90,Default,,0,0,0,,Мен сенің жаныңда жүргенде шулы болудан гөрі көбірек толқыймын.
Dialogue: 0,0:19:52.94,0:19:54.90,Default,,0,0,0,,-де? Сіз не істемексіз?
Dialogue: 0,0:19:54.94,0:19:56.90,Default,,0,0,0,,Қайтару
Dialogue: 0,0:19:56.94,0:20:00.90,Default,,0,0,0,,Қайда? Цугару? Ал уәде ше?
Dialogue: 0,0:20:00.95,0:20:04.91,Default,,0,0,0,,Бұл уәде емес. Бұл келісімшарт.
Dialogue: 0,0:20:04.95,0:20:10.91,Default,,0,0,0,,Келісімшартты орындағанымды қаласаңыз, алдымен сонда секіріңіз.
Dialogue: 0,0:20:10.96,0:20:13.92,Default,,0,0,0,,Ұшу. (Шашу) Сіз кімсіз?
Dialogue: 0,0:20:13.96,0:20:15.92,Default,,0,0,0,,Йоити Фудзитани
Dialogue: 0,0:20:15.96,0:20:18.92,Default,,0,0,0,,Дайвинг әлемінде мені танымайтын адам болса→
Dialogue: 0,0:20:18.96,0:20:20.92,Default,,0,0,0,,Бұл мең.
Dialogue: 0,0:20:20.97,0:20:23.93,Default,,0,0,0,,Өкінішті, мен меңмін.
Dialogue: 0,0:20:23.97,0:20:27.85,Default,,0,0,0,,А... Сіз Цугаруда теңізде сүңгіп жүрдіңіз ғой, солай ма?
Dialogue: 0,0:20:27.93,0:20:30.93,Default,,0,0,0,,Перронға шығыңыз. Мен сенің суға түсуіңді көргім келеді.
Dialogue: 0,0:20:39.94,0:20:42.86,Default,,0,0,0,,Не? Сіз мүлде секірмейсіз.
Dialogue: 0,0:20:42.95,0:20:45.87,Default,,0,0,0,,Оның қорқынышты ештеңесі жоқ... иә?
Dialogue: 0,0:20:45.95,0:20:47.87,Default,,0,0,0,,Мен әлі үйренбегенмін.
Dialogue: 0,0:20:47.95,0:20:52.87,Default,,0,0,0,,Тегіс платформада да, бетонның сезінуінде де→
Dialogue: 0,0:20:52.96,0:20:54.96,Default,,0,0,0,,Сондай-ақ галереяда
Dialogue: 0,0:20:57.96,0:20:59.88,Default,,0,0,0,,Қымбат!
Dialogue: 0,0:20:59.96,0:21:01.97,Default,,0,0,0,,Ой! (Юкия) Керемет!
Dialogue: 0,0:21:03.97,0:21:07.89,Default,,0,0,0,,Ахахха! Суға түсу үшін 0 ұпай
Dialogue: 0,0:21:07.97,0:21:09.89,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:09.97,0:21:12.89,Default,,0,0,0,,⟨Мен көрмеген ештеңе сияқты→
Dialogue: 0,0:21:12.98,0:21:14.89,Default,,0,0,0,,Бұл қатты сүңгу болды⟩
Dialogue: 0,0:21:14.98,0:21:17.90,Default,,0,0,0,,⟨Бұл адам қатты шашыраумен келді→
Dialogue: 0,0:21:17.98,0:21:20.90,Default,,0,0,0,,МДК-ға, менің әлеміме→
Dialogue: 0,0:21:20.98,0:21:24.99,Default,,0,0,0,,Маған қызық, сіз не істегіңіз келеді⟩
Dialogue: 0,0:21:24.99,0:21:34.91,Default,,0,0,0,,♪～
Dialogue: 0,0:21:36.41,0:21:42.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory