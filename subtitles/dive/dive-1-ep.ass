Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:08.92,Default,,0,0,0,,(цикаданың шырылдауы)
Dialogue: 0,0:00:09.00,0:00:11.01,Default,,0,0,0,,Бір! Уф уф!
Dialogue: 0,0:00:13.01,0:00:15.93,Default,,0,0,0,,Чикува! Күте тұрыңыз, Чикува!
Dialogue: 0,0:00:16.01,0:00:18.93,Default,,0,0,0,,Бір! Уф уф!
Dialogue: 0,0:00:19.01,0:00:21.93,Default,,0,0,0,,Уфф! бір! Уф уф! бір!
Dialogue: 0,0:00:22.02,0:00:23.94,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:24.02,0:00:27.02,Default,,0,0,0,,Чиква, сен не істеп жатырсың?
Dialogue: 0,0:00:31.03,0:00:33.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:38.03,0:00:41.04,Default,,0,0,0,,Бұл айдаһар.
Dialogue: 0,0:00:46.04,0:00:48.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:50.05,0:00:52.05,Default,,0,0,0,,Уф…
Dialogue: 0,0:00:56.05,0:00:57.97,Default,,0,0,0,,Сіз...
Dialogue: 0,0:00:58.05,0:01:01.97,Default,,0,0,0,,Ах... бұл мен...
Dialogue: 0,0:01:07.98,0:01:10.90,Default,,0,0,0,,Ұшқыңыз келе ме?
Dialogue: 0,0:01:10.98,0:01:12.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:15.99,0:01:17.91,Default,,0,0,0,,⟨Сол жаз күні⟩
Dialogue: 0,0:01:17.99,0:01:21.91,Default,,0,0,0,,⟨Мені мына бетон айдаһар қызықтырады→
Dialogue: 0,0:01:21.99,0:01:26.92,Default,,0,0,0,,Мен жел мен су әлемінің ләззатына және қорқынышына тәуелдімін⟩
Dialogue: 0,0:01:27.00,0:01:29.92,Default,,0,0,0,,⟨Ең биік айдаһарды мінген бала →
Dialogue: 0,0:01:30.00,0:01:35.01,Default,,0,0,0,,Ол менің көзіме құбыжықты жеңген батырдай көрінді⟩
Dialogue: 0,0:01:37.01,0:01:39.93,Default,,0,0,0,,Келесі, Mizuki дайвинг клубына тиесілі →
Dialogue: 0,0:01:40.01,0:01:42.93,Default,,0,0,0,,Бұл Йоити Фуджитани! →
Dialogue: 0,0:01:43.02,0:01:44.93,Default,,0,0,0,,Кіші болып жеңілмеген.→
Dialogue: 0,0:01:45.02,0:01:49.02,Default,,0,0,0,,Әміршінің аты оның қалағанындай болды.
Dialogue: 0,0:01:49.02,0:01:59.03,Default,,0,0,0,,♪～
Dialogue: 0,0:01:59.03,0:02:01.95,Default,,0,0,0,,Фу…
Dialogue: 0,0:02:05.96,0:02:08.92,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:02:08.96,0:02:12.92,Default,,0,0,0,,1 орын Йоичи Фудзитани 412,40｡→
Dialogue: 0,0:02:12.96,0:02:18.97,Default,,0,0,0,,2 орын Тошихико Цудзи 381,75. 3 орын...
Dialogue: 0,0:02:18.97,0:02:25.98,Default,,0,0,0,,♪～
Dialogue: 0,0:02:25.98,0:02:28.94,Default,,0,0,0,,Йоичи-кун!
Dialogue: 0,0:02:28.98,0:02:31.94,Default,,0,0,0,,Өте керемет болды!
Dialogue: 0,0:02:31.98,0:02:34.98,Default,,0,0,0,,Сіз де ұша аласыз.
Dialogue: 0,0:02:37.99,0:02:48.00,Default,,0,0,0,,♪～
Dialogue: 0,0:04:13.25,0:04:16.17,Default,,0,0,0,,Томоки! Бүгін тағы жаттығу жасайсыз ба?
Dialogue: 0,0:04:16.25,0:04:20.17,Default,,0,0,0,,Иә. >> Сізге дайвинг қаншалықты ұнайды?
Dialogue: 0,0:04:20.26,0:04:23.18,Default,,0,0,0,,Цукаса, секіруден қорықпайсың ба?
Dialogue: 0,0:04:23.26,0:04:25.18,Default,,0,0,0,,Хмм…
Dialogue: 0,0:04:25.26,0:04:28.18,Default,,0,0,0,,Жақсы. >> Қайсысы?
Dialogue: 0,0:04:28.26,0:04:30.27,Default,,0,0,0,,(Миха) Томо-кун
Dialogue: 0,0:04:32.27,0:04:34.19,Default,,0,0,0,,Хехехе
Dialogue: 0,0:04:34.27,0:04:36.19,Default,,0,0,0,,Жаттығу... (Томоки) Ах.
Dialogue: 0,0:04:36.27,0:04:39.27,Default,,0,0,0,,Жоқ... бұл шын мәнінде жаттығу! (Досым) Олай болса, жүре бер.
Dialogue: 0,0:04:41.19,0:04:43.20,Default,,0,0,0,,Я...
Dialogue: 0,0:04:45.20,0:04:49.16,Default,,0,0,0,,Эй, мен сенімен MDC-ге қайта барсам болады ма?
Dialogue: 0,0:04:49.20,0:04:51.16,Default,,0,0,0,,Миханчиге қарама-қарсы бағыт емес пе?
Dialogue: 0,0:04:51.20,0:04:54.16,Default,,0,0,0,,Хехе, бұл жақсы.
Dialogue: 0,0:04:54.21,0:04:58.17,Default,,0,0,0,,Теледидарда танымал тәттілермен таныстыру→
Dialogue: 0,0:04:58.21,0:05:02.17,Default,,0,0,0,,Сонымен, құймақ өте дәмді болып шықты.
Dialogue: 0,0:05:02.21,0:05:04.17,Default,,0,0,0,,Бірақ тамақ липомен айналысатындар бар→
Dialogue: 0,0:05:04.22,0:05:07.18,Default,,0,0,0,,Сіз тамақты аса тәбет ашпайсыз деп үміттенемін.
Dialogue: 0,0:05:07.22,0:05:09.18,Default,,0,0,0,,Сонымен дәмді көрінеді, бірақ→
Dialogue: 0,0:05:09.22,0:05:13.18,Default,,0,0,0,,Дәмі соншалықты жақсы емес пе деп ойладым.→
Dialogue: 0,0:05:13.23,0:05:17.19,Default,,0,0,0,,Бірақ бұл маған өте дәмді болып көрінді, солай емес пе?
Dialogue: 0,0:05:17.23,0:05:21.19,Default,,0,0,0,,《Бәрі әрқашан мен сүңгіп жатырмын ба деп сұрайды.》
Dialogue: 0,0:05:21.23,0:05:23.19,Default,,0,0,0,,``Қорықпайсың ба?''
Dialogue: 0,0:05:23.24,0:05:28.20,Default,,0,0,0,,《Шынында, сіз шамамен үшінші қабаттан секіресіз.》
Dialogue: 0,0:05:28.24,0:05:32.20,Default,,0,0,0,,《Бірақ ең қорқыныштысы – ауырсыну.》
Dialogue: 0,0:05:32.24,0:05:37.21,Default,,0,0,0,,《Сәтсіз кезде жүрек айну ауруы》
Dialogue: 0,0:05:37.25,0:05:39.21,Default,,0,0,0,,《Бірақ бұл сезім→
Dialogue: 0,0:05:39.25,0:05:43.13,Default,,0,0,0,,Сіз шынымен секірмейінше білмейсіз.
Dialogue: 0,0:05:43.21,0:05:45.13,Default,,0,0,0,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:05:45.22,0:05:47.13,Default,,0,0,0,,Иә
Dialogue: 0,0:05:47.22,0:05:50.14,Default,,0,0,0,,Сонымен, құймақ үшін қай үстіңгі қоспаны жақсы деп ойлайсыз?
Dialogue: 0,0:05:50.22,0:05:54.14,Default,,0,0,0,,Хмм...жаным?
Dialogue: 0,0:05:54.22,0:05:58.15,Default,,0,0,0,,>> Әй... (Томоки) О, жоқ. мм...
Dialogue: 0,0:05:58.23,0:06:03.15,Default,,0,0,0,,Қоспаларда бал жоқ. Менің ойымша, мен бәрібір сұраған жоқпын.
Dialogue: 0,0:06:03.23,0:06:06.24,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:06.24,0:06:20.25,Default,,0,0,0,,♪～
Dialogue: 0,0:06:20.25,0:06:23.17,Default,,0,0,0,,Бұл жеткілікті.
Dialogue: 0,0:06:23.25,0:06:26.17,Default,,0,0,0,,Не? Мен секірген кезде қарауға болады ма?
Dialogue: 0,0:06:26.26,0:06:28.18,Default,,0,0,0,,Иә. Жоқ.
Dialogue: 0,0:06:28.26,0:06:30.18,Default,,0,0,0,,А... неге?
Dialogue: 0,0:06:30.26,0:06:32.18,Default,,0,0,0,,Кез келген нәрсе
Dialogue: 0,0:06:32.26,0:06:34.18,Default,,0,0,0,,Ах
Dialogue: 0,0:06:34.26,0:06:36.18,Default,,0,0,0,,《Бұл Йоичи-кун》
Dialogue: 0,0:06:36.27,0:06:39.19,Default,,0,0,0,,《Уау...》 >> Әй, жарайды емес пе?
Dialogue: 0,0:06:39.27,0:06:42.19,Default,,0,0,0,,Кездескенше, Миха
Dialogue: 0,0:06:47.19,0:06:59.21,Default,,0,0,0,,♪～
Dialogue: 0,0:06:59.21,0:07:03.21,Default,,0,0,0,,Бапкер Фудзитани, өтінемін!
Dialogue: 0,0:07:16.22,0:07:19.18,Default,,0,0,0,,Ұшуыңыз баяу. Сіздің иықтарыңыз ауырады.
Dialogue: 0,0:07:19.23,0:07:23.19,Default,,0,0,0,,Орындау - саусақтарыңыз суға батқанша. Соңына дейін сақтықты төмендетпеңіз.
Dialogue: 0,0:07:23.23,0:07:25.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:25.23,0:07:30.24,Default,,0,0,0,,《10 м биіктіктен 60 км/сағ жылдамдықпен кенеттен түсу》
Dialogue: 0,0:07:34.24,0:07:39.20,Default,,0,0,0,,《Бар болғаны 1,4 секундта әуе өнімділігі》
Dialogue: 0,0:07:39.25,0:07:41.21,Default,,0,0,0,,Су…
Dialogue: 0,0:07:41.25,0:07:44.21,Default,,0,0,0,,\(Сақина) Эй, Томо!
Dialogue: 0,0:07:44.25,0:07:47.21,Default,,0,0,0,,Асығыңыз. (Томоки) Иә.
Dialogue: 0,0:07:47.25,0:07:49.26,Default,,0,0,0,,Жаттықтырушы Ошима, өтінемін!
Dialogue: 0,0:08:02.27,0:08:05.23,Default,,0,0,0,,Өзіңізді ойландырып тастаңыз. Басыңыз және алға жылжыңыз.→
Dialogue: 0,0:08:05.27,0:08:08.23,Default,,0,0,0,,Онда бара аласыз! (Томоки) Иә!
Dialogue: 0,0:08:08.28,0:08:12.28,Default,,0,0,0,,күрсіну~ Жаттықтырушы Ошима, міне, тағы да психология теориясы келді.
Dialogue: 0,0:08:16.28,0:08:20.25,Default,,0,0,0,,Ауырды~ Мен оны дәл қазір қолымнан келгенше соқтым.
Dialogue: 0,0:08:20.29,0:08:22.25,Default,,0,0,0,,Бұл ауыр көрінеді.
Dialogue: 0,0:08:22.29,0:08:25.25,Default,,0,0,0,,Жолда, Уау! Мен солай ойладым, бірақ тым кеш болды.
Dialogue: 0,0:08:25.29,0:08:28.25,Default,,0,0,0,,Бетке жұдырықпен ұру - ең жаманы.
Dialogue: 0,0:08:28.30,0:08:30.26,Default,,0,0,0,,Бұған жол бермеуге болады.
Dialogue: 0,0:08:30.30,0:08:33.26,Default,,0,0,0,,Томо, сен бұрын жабысқақ едің.
Dialogue: 0,0:08:33.30,0:08:38.26,Default,,0,0,0,,Алдыңдағы адам оңай ұшпаса, қорқасың.
Dialogue: 0,0:08:38.31,0:08:42.18,Default,,0,0,0,,Кешіріңіз. >> Жоқ, олай емес. Мен де кейде.
Dialogue: 0,0:08:42.27,0:08:45.19,Default,,0,0,0,,Мен кенеттен ұша алмай қалғандай болдым.
Dialogue: 0,0:08:45.27,0:08:48.19,Default,,0,0,0,,Дұрыс па? Және мұндай жағдайларда ғана→
Dialogue: 0,0:08:48.27,0:08:50.19,Default,,0,0,0,,Мен сәтсіздікке ұшыраған кезде нәрселерді елестете беремін, солай ма?
Dialogue: 0,0:08:52.28,0:08:54.20,Default,,0,0,0,,«Қиял – жау!».
Dialogue: 0,0:08:54.28,0:08:57.20,Default,,0,0,0,,Бұл не? Жаттықтырушы Ошиманы көшіріп жатырсыз ба? Ешқандай ұқсастық жоқ
Dialogue: 0,0:08:57.28,0:08:59.20,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:08:59.28,0:09:02.20,Default,,0,0,0,,Жаттықтырушы қайтадан жұмысын тоқтатты.
Dialogue: 0,0:09:02.29,0:09:05.21,Default,,0,0,0,,Менің ойымша, бұл басқа біреуден алынған шығар?
Dialogue: 0,0:09:05.29,0:09:08.29,Default,,0,0,0,,Мүмкін. Менің клубым өте нашар сияқты.
Dialogue: 0,0:09:11.30,0:09:13.22,Default,,0,0,0,,《Мидзуки дайвинг клубы》
Dialogue: 0,0:09:13.30,0:09:17.22,Default,,0,0,0,,《MDC деп аталатын жүйе қазір өте нашар күйде》
Dialogue: 0,0:09:17.30,0:09:19.22,Default,,0,0,0,,《Басқару дағдарысы》
Dialogue: 0,0:09:19.30,0:09:24.23,Default,,0,0,0,,《Біріншіден, MDC-ті ірі спорт өндірушісі Mizuki тікелей басқарады→
Dialogue: 0,0:09:24.31,0:09:27.23,Default,,0,0,0,,Жапонияда саны аз, сүңгуір спортшылар→
Dialogue: 0,0:09:27.31,0:09:30.23,Default,,0,0,0,,Сол көшбасшыларды дайындауға назар аударайық→
Dialogue: 0,0:09:30.32,0:09:33.24,Default,,0,0,0,,Төраға Мизуки оны 6 жыл бұрын құрған →
Dialogue: 0,0:09:33.32,0:09:39.24,Default,,0,0,0,,Төраға осы жылдың басында өмірден өтті.
Dialogue: 0,0:09:39.32,0:09:42.16,Default,,0,0,0,,《Одан кейін, бірден →
Dialogue: 0,0:09:42.24,0:09:47.17,Default,,0,0,0,,Компанияның MDC сыны күшейген сияқты...》
Dialogue: 0,0:09:47.25,0:09:50.17,Default,,0,0,0,,Бірақ менің клубым жақсы.
Dialogue: 0,0:09:50.25,0:09:52.17,Default,,0,0,0,,Мұны қалай айта аласыз?
Dialogue: 0,0:09:52.25,0:09:55.26,Default,,0,0,0,,Өйткені біздің үйде Йоичи-кун бар.
Dialogue: 0,0:09:59.26,0:10:01.18,Default,,0,0,0,,《Дұрыс》
Dialogue: 0,0:10:01.26,0:10:05.18,Default,,0,0,0,,《Сіз біздің клубтың үміт жұлдызысыз》
Dialogue: 0,0:10:05.27,0:10:09.19,Default,,0,0,0,,《Әкем МДК-да жаттықтырушысы→
Dialogue: 0,0:10:09.27,0:10:13.19,Default,,0,0,0,,Жаттықтырушы Кейсуке Фудзитани, бұрынғы Олимпиадалық спортшы
Dialogue: 0,0:10:13.28,0:10:17.20,Default,,0,0,0,,《Менің анам бір кездері сүңгуір әлемінің мадоннасы болған》
Dialogue: 0,0:10:17.28,0:10:20.20,Default,,0,0,0,,《Осындай берекелі қанға ие болған Йоичи-кун →
Dialogue: 0,0:10:20.28,0:10:23.20,Default,,0,0,0,,Нағыз асыл тұқымды.
Dialogue: 0,0:10:23.29,0:10:28.21,Default,,0,0,0,,Йоичи белсенді рөл атқарса, MDC бейнесі жақсарады →
Dialogue: 0,0:10:28.29,0:10:33.21,Default,,0,0,0,,Тіпті басшылар да бізді қуып жібермейді...
Dialogue: 0,0:10:33.30,0:10:36.21,Default,,0,0,0,,Кім айтты? Йоичи-кун өз бетімен.→
Dialogue: 0,0:10:36.30,0:10:40.30,Default,,0,0,0,,Бірақ бұлай айтқаның таң қалдырады.
Dialogue: 0,0:10:40.30,0:10:53.23,Default,,0,0,0,,♪～
Dialogue: 0,0:10:53.23,0:10:57.24,Default,,0,0,0,,(цикаданың шырылдауы)
Dialogue: 0,0:11:00.24,0:11:03.20,Default,,0,0,0,,《Жарайды. Алдымен бассейн жағынан секіріп алайық.》
Dialogue: 0,0:11:03.24,0:11:05.24,Default,,0,0,0,,《Иә! 》
Dialogue: 0,0:11:08.25,0:11:11.21,Default,,0,0,0,,《Жарайды. Бар, Томо! 》
Dialogue: 0,0:11:11.25,0:11:13.25,Default,,0,0,0,,Жоқ, ол емес. Жасырынған орын. Жасырынған орын ба?
Dialogue: 0,0:11:22.26,0:11:26.22,Default,,0,0,0,,>> 《Одан кейін. Сакай-кун》 (Томоки) 《Иә! 》
Dialogue: 0,0:11:26.26,0:11:28.23,Default,,0,0,0,,《Бұл 1м-ден айырмашылығы жоқ! 》
Dialogue: 0,0:11:28.27,0:11:30.23,Default,,0,0,0,,《Ұшсақ, бірге боламыз》
Dialogue: 0,0:11:30.27,0:11:34.23,Default,,0,0,0,,《Мен үлгі тұтқан Косэй Арима》
Dialogue: 0,0:11:34.27,0:11:39.28,Default,,0,0,0,,《Жарайды. Дайхиро-кун мен Маруяма-кун 5 метрге жүгіреді.》
Dialogue: 0,0:11:41.24,0:11:44.16,Default,,0,0,0,,《Мен бәрімен бірге болмағанды жек көремін...》
Dialogue: 0,0:11:44.24,0:11:47.24,Default,,0,0,0,,《Жалғыз болу – қызық емес, жалғыз болу》
Dialogue: 0,0:11:57.25,0:11:59.26,Default,,0,0,0,,《Тамаша...》
Dialogue: 0,0:12:18.28,0:12:21.19,Default,,0,0,0,,《Томо, келдің бе? 》
Dialogue: 0,0:12:21.28,0:12:23.20,Default,,0,0,0,,Жоқ, ол емес. Жасырынған орын. Жасырынған орын ба?
Dialogue: 0,0:12:23.28,0:12:25.28,Default,,0,0,0,,《Жалғызсың ба? 》
Dialogue: 0,0:12:29.29,0:12:32.21,Default,,0,0,0,,《Жаңбыр осылай жауып тұрса да? 》
Dialogue: 0,0:12:32.29,0:12:37.21,Default,,0,0,0,,《Иә. Мен жаттығу бар деп ойладым. Мен бәрібір дымқыл боламын.》
Dialogue: 0,0:12:37.29,0:12:39.21,Default,,0,0,0,,《Жаттығуды ұнатасыз ба? 》
Dialogue: 0,0:12:39.30,0:12:42.17,Default,,0,0,0,,《Ондай емес...》
Dialogue: 0,0:12:42.22,0:12:46.18,Default,,0,0,0,,《Мен басқалар сияқты тезірек бір жерде ұшқым келеді》
Dialogue: 0,0:12:46.22,0:12:49.22,Default,,0,0,0,,《Қандай қызық нәрсе》
Dialogue: 0,0:12:49.22,0:13:05.24,Default,,0,0,0,,♪～
Dialogue: 0,0:13:05.24,0:13:08.20,Default,,0,0,0,,(суға түскен дыбыс)
Dialogue: 0,0:13:08.24,0:13:10.20,Default,,0,0,0,,《Ұшуға тырыс! 》
Dialogue: 0,0:13:10.24,0:13:13.21,Default,,0,0,0,,《Мен мұны істей алмаймын! Төмендегісі де жақсы ұшпайды.
Dialogue: 0,0:13:13.25,0:13:16.21,Default,,0,0,0,,《Табыспай тұрып берілме! 》
Dialogue: 0,0:13:16.25,0:13:18.25,Default,,0,0,0,,Жоқ, ол емес. Жасырынған орын. Жасырынған орын ба?
Dialogue: 0,0:13:18.25,0:13:31.26,Default,,0,0,0,,♪～
Dialogue: 0,0:13:31.26,0:13:33.27,Default,,0,0,0,,《Аа...》
Dialogue: 0,0:13:37.27,0:13:39.27,Default,,0,0,0,,《Көздерің ашық па? 》
Dialogue: 0,0:13:41.23,0:13:46.15,Default,,0,0,0,,《Көзіңді аш және судың құлап жатқан бетіне қара》
Dialogue: 0,0:13:46.24,0:13:48.16,Default,,0,0,0,,《Көзіңді аш...》
Dialogue: 0,0:13:48.24,0:13:50.16,Default,,0,0,0,,《Түсінікті》
Dialogue: 0,0:13:50.24,0:13:52.16,Default,,0,0,0,,《Жарайсыңдар》
Dialogue: 0,0:13:52.24,0:13:54.25,Default,,0,0,0,,《Иә! 》
Dialogue: 0,0:13:58.25,0:14:01.17,Default,,0,0,0,,《Көзіңді ашық ұста...》
Dialogue: 0,0:14:01.25,0:14:03.17,Default,,0,0,0,,《Жабуға болмайды...》
Dialogue: 0,0:14:03.26,0:14:05.26,Default,,0,0,0,,《Көзіңді аш》
Dialogue: 0,0:14:08.26,0:14:10.26,Default,,0,0,0,,《Баяу! 》
Dialogue: 0,0:14:10.26,0:14:23.28,Default,,0,0,0,,♪～
Dialogue: 0,0:14:23.28,0:14:25.19,Default,,0,0,0,,《Қазір! 》
Dialogue: 0,0:14:25.28,0:14:27.20,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:14:27.28,0:14:30.28,Default,,0,0,0,,《Иә~! 》
Dialogue: 0,0:14:33.29,0:14:35.20,Default,,0,0,0,,《Дайын! 》
Dialogue: 0,0:14:35.29,0:14:40.21,Default,,0,0,0,,《Мүмкін емес деп ойлама. Бұл бәріне мүмкін》
Dialogue: 0,0:14:40.29,0:14:44.13,Default,,0,0,0,,《Мен үшін және сен үшін》
Dialogue: 0,0:14:44.21,0:14:48.13,Default,,0,0,0,,⟨Йоичи-кун маған дейін және кейін нені үйретті →
Dialogue: 0,0:14:48.22,0:14:51.22,Default,,0,0,0,,Бұл бір рет қана болды⟩
Dialogue: 0,0:14:56.22,0:14:58.14,Default,,0,0,0,,\(Юкия) Жанжал!
Dialogue: 0,0:14:58.23,0:15:01.15,Default,,0,0,0,,Юкия ұстаған үлкен жанжал!
Dialogue: 0,0:15:01.23,0:15:04.15,Default,,0,0,0,,Иә? Қалай болғанда да, синхрондалған ханымдар қайтадан →
Dialogue: 0,0:15:04.23,0:15:06.15,Default,,0,0,0,,Бұл жанжал шығар. Мұндай хобби түрлері→
Dialogue: 0,0:15:06.23,0:15:08.15,Default,,0,0,0,,Сіз араласпағаныңыз жөн.
Dialogue: 0,0:15:08.24,0:15:11.16,Default,,0,0,0,,Жоқ, жоқ! Тағы да таңғажайып әңгімелер
Dialogue: 0,0:15:11.24,0:15:13.24,Default,,0,0,0,,｡ ･･
Dialogue: 0,0:15:17.00,0:15:18.91,Default,,0,0,0,,Маған мәліметтерді айтыңыз. (Юкия) Бапкер Фудзитани →
Dialogue: 0,0:15:19.00,0:15:20.92,Default,,0,0,0,,Жас әйелмен зинақорлық
Dialogue: 0,0:15:21.00,0:15:22.92,Default,,0,0,0,,Жоқ. >> Бұл рас.
Dialogue: 0,0:15:23.00,0:15:25.92,Default,,0,0,0,,Жаттықтырушы Фудзитани Менің шұғыл жұмысым бар →
Dialogue: 0,0:15:26.00,0:15:28.92,Default,,0,0,0,,Бүгінгі жаттығу жаттықтырушы Ошимаға тапсырылады.
Dialogue: 0,0:15:29.01,0:15:34.93,Default,,0,0,0,,Иә? Юкия мен орта мектеп үштігі қайда кетті?
Dialogue: 0,0:15:35.01,0:15:39.93,Default,,0,0,0,,Шұғыл жұмыс? Бапкер Фудзитани жаттығудан ерте кеткені күдікті.
Dialogue: 0,0:15:40.02,0:15:42.94,Default,,0,0,0,,Бізден маңыздырақ нәрсе бар...
Dialogue: 0,0:15:43.02,0:15:44.94,Default,,0,0,0,,Мен көрдім, солай ма?
Dialogue: 0,0:15:45.02,0:15:48.94,Default,,0,0,0,,Жаттықтырушыға өте әдемі әйел келеді.
Dialogue: 0,0:15:49.03,0:15:50.95,Default,,0,0,0,,Бізден де маңыздырақ сұлу әйел...
Dialogue: 0,0:15:51.03,0:15:54.95,Default,,0,0,0,,Бұған ешқандай күмән жоқ. Бұл зинақорлық.
Dialogue: 0,0:15:55.03,0:15:58.04,Default,,0,0,0,,Бұл іс бізден маңыздырақ па...
Dialogue: 0,0:16:05.04,0:16:07.96,Default,,0,0,0,,Жоқ, жоқ, жоқ! Тек жаттықтырушы Фудзитани үшін. Мүлде жоқ!
Dialogue: 0,0:16:08.05,0:16:12.97,Default,,0,0,0,,Аа, дұрыс. Басқа адам қандай адам?
Dialogue: 0,0:16:13.05,0:16:15.97,Default,,0,0,0,,Менің кеудем серпілу →
Dialogue: 0,0:16:16.05,0:16:18.97,Default,,0,0,0,,Менің бөксем пудинг
Dialogue: 0,0:16:19.06,0:16:20.98,Default,,0,0,0,,Иә? Бұл болуы мүмкін →
Dialogue: 0,0:16:21.06,0:16:23.98,Default,,0,0,0,,Ол Mizuki Sports компаниясының қызметкері емес пе?
Dialogue: 0,0:16:24.06,0:16:27.94,Default,,0,0,0,,Сіз бұрын осында болған сияқтысыз... (Рё) Түсіндім, Рейдзи.
Dialogue: 0,0:16:27.98,0:16:29.94,Default,,0,0,0,,Компания ішіндегі опасыздық!?
Dialogue: 0,0:16:29.98,0:16:31.95,Default,,0,0,0,,Сонымен, ақырында Mizuki Sports →
Dialogue: 0,0:16:31.99,0:16:34.95,Default,,0,0,0,,Сонда сіз бұл жерді жою үшін келдіңіз бе? (Томоки) Иә?
Dialogue: 0,0:16:34.99,0:16:38.95,Default,,0,0,0,,Сізбен қарым-қатынаста болған адам? Сондықтан бұл зина емес
Dialogue: 0,0:16:38.99,0:16:40.95,Default,,0,0,0,,Оның мағынасын түсінесің бе?
Dialogue: 0,0:16:41.00,0:16:43.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:45.00,0:16:47.96,Default,,0,0,0,,Сіз бұл сұрақты дәл қазір естідіңіз бе?
Dialogue: 0,0:16:48.00,0:16:49.96,Default,,0,0,0,,Бүгінгі...
Dialogue: 0,0:16:50.00,0:16:51.97,Default,,0,0,0,,Ол?
Dialogue: 0,0:16:52.01,0:16:55.97,Default,,0,0,0,,Не!? Сол!? (Томоки) Жоқ... ештеңе.
Dialogue: 0,0:16:56.01,0:16:57.97,Default,,0,0,0,,Томоның қарым-қатынасы бар ма?
Dialogue: 0,0:16:58.01,0:16:59.97,Default,,0,0,0,,Демек, бұл зинақорлық емес.
Dialogue: 0,0:17:00.01,0:17:03.98,Default,,0,0,0,,Өйткені бұл басқаша. >> Бұл қалай ерекшеленеді?
Dialogue: 0,0:17:04.02,0:17:06.02,Default,,0,0,0,,Иә
Dialogue: 0,0:17:08.02,0:17:11.99,Default,,0,0,0,,《Ха... Бұл ең жаманы...》
Dialogue: 0,0:17:12.03,0:17:14.99,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:17:15.03,0:17:20.99,Default,,0,0,0,,Миха менің хатыма жауап бермеді деп уайымдадым.
Dialogue: 0,0:17:21.04,0:17:24.00,Default,,0,0,0,,Тыңдап тұрсың ба? (Томоки) Иә.
Dialogue: 0,0:17:24.04,0:17:25.92,Default,,0,0,0,,Неге жауап бермейсіз?
Dialogue: 0,0:17:26.00,0:17:28.92,Default,,0,0,0,,Шын мәнінде емес. >> Содан кейін жасаңыз!
Dialogue: 0,0:17:29.00,0:17:30.92,Default,,0,0,0,,Сен өте тәкаппарсың, Хиро. Сен менің інім болсаң да.
Dialogue: 0,0:17:31.00,0:17:32.92,Default,,0,0,0,,Бірақ біз бір сыныпта оқимыз.
Dialogue: 0,0:17:33.01,0:17:34.92,Default,,0,0,0,,Шулы ерте туылу
Dialogue: 0,0:17:35.01,0:17:37.01,Default,,0,0,0,,Бұл жаман сөз емес...
Dialogue: 0,0:17:40.01,0:17:41.93,Default,,0,0,0,,Чиква қыдырайық!
Dialogue: 0,0:17:42.02,0:17:44.02,Default,,0,0,0,,Тағзым!
Dialogue: 0,0:17:54.03,0:17:58.95,Default,,0,0,0,,《Мен Томокунды әрқашан жақсы көретінмін》
Dialogue: 0,0:17:59.03,0:18:00.95,Default,,0,0,0,,《Сен мені қызыңа айналдырасың ба? 》
Dialogue: 0,0:18:01.03,0:18:05.04,Default,,0,0,0,,《Не!? Ах...》
Dialogue: 0,0:18:15.05,0:18:16.97,Default,,0,0,0,,Садақ…
Dialogue: 0,0:18:17.05,0:18:21.97,Default,,0,0,0,,《Қызық, мен неге сол кезде жақсы дедім...》
Dialogue: 0,0:18:22.06,0:18:24.97,Default,,0,0,0,,《Не? Томо, сенің қызың бар ма? 》
Dialogue: 0,0:18:25.06,0:18:26.89,Default,,0,0,0,,《Өтірік айтпа! Жоқ, өтірік деп айт! 》
Dialogue: 0,0:18:26.98,0:18:30.90,Default,,0,0,0,,《Жақсы~ Өте жақсы》
Dialogue: 0,0:18:30.98,0:18:34.90,Default,,0,0,0,,《Мүмкін мен мақтанғым келген шығар...》
Dialogue: 0,0:18:34.98,0:18:38.91,Default,,0,0,0,,《Сақай-күн бас тартқаны үшін сұмдық. Байғұс Миха! 》
Dialogue: 0,0:18:38.99,0:18:41.99,Default,,0,0,0,,《Қызды жылатудың өзі жиіркенішті》 《Шайтан! 》
Dialogue: 0,0:18:43.99,0:18:46.91,Default,,0,0,0,,《Мүмкін ол қорқып кеткен шығар? 》
Dialogue: 0,0:18:47.00,0:18:51.00,Default,,0,0,0,,《Бірақ мен әлі де қарым-қатынаста болу дегенді түсінбеймін》
Dialogue: 0,0:18:53.00,0:18:54.92,Default,,0,0,0,,《Мен не істеуім керек?》
Dialogue: 0,0:18:55.00,0:18:57.01,Default,,0,0,0,,Тағзым!
Dialogue: 0,0:19:01.01,0:19:04.93,Default,,0,0,0,,《Менің клубым өте қауіпті сияқты》
Dialogue: 0,0:19:05.01,0:19:08.94,Default,,0,0,0,,《Олар соңғы алты жылда қызылда жұмыс істеген сияқты...》
Dialogue: 0,0:19:09.02,0:19:12.94,Default,,0,0,0,,《MDC шынымен банкротқа ұшырай ма?》
Dialogue: 0,0:19:13.02,0:19:15.02,Default,,0,0,0,,《Бұл жаман...》
Dialogue: 0,0:19:24.03,0:19:25.95,Default,,0,0,0,,📱(дірілдеткіш дыбысы)
Dialogue: 0,0:19:29.96,0:19:31.92,Default,,0,0,0,,Томо Сіз де бүгін жаттығу жасайсыз ба? (Томоки) Иә.
Dialogue: 0,0:19:31.96,0:19:35.92,Default,,0,0,0,,Мен көремін. Келесі кездескенше. (Досым) Сонда кездескенше.
Dialogue: 0,0:19:35.96,0:19:38.92,Default,,0,0,0,,Олай болса. (Досым) Бүгін не істеп жатырсың?
Dialogue: 0,0:19:38.97,0:19:40.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:40.97,0:19:53.98,Default,,0,0,0,,♪～
Dialogue: 0,0:19:53.98,0:19:55.94,Default,,0,0,0,,Ах
Dialogue: 0,0:19:55.98,0:19:57.94,Default,,0,0,0,,Не? Сачин
Dialogue: 0,0:19:57.98,0:20:00.99,Default,,0,0,0,,>> Сұлу әйелмен құпия кездесу... (Томоки) Иә?
Dialogue: 0,0:20:09.00,0:20:10.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:11.00,0:20:13.96,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:20:14.00,0:20:18.96,Default,,0,0,0,,Бұл қиын. (Йоко Нацу) Иә, бұл өте өкінішті.
Dialogue: 0,0:20:19.01,0:20:23.01,Default,,0,0,0,,《Мен бұл жерді қирату үшін келген сияқтымын.》
Dialogue: 0,0:20:25.01,0:20:28.89,Default,,0,0,0,,А... Әй... Әй... Әй...
Dialogue: 0,0:20:28.97,0:20:30.89,Default,,0,0,0,,Бұл кісі... (Юкия) Ханшайым!
Dialogue: 0,0:20:30.98,0:20:32.89,Default,,0,0,0,,Бұл Нацу Йоко Асаки. (Томоки) Ешқандай →
Dialogue: 0,0:20:32.98,0:20:34.90,Default,,0,0,0,,Сіз бұл клубты жою үшін келдіңіз бе?
Dialogue: 0,0:20:34.98,0:20:38.90,Default,,0,0,0,,>> Иә? (Томоки) Өйткені, «Бұл мүлде жақсы емес».
Dialogue: 0,0:20:38.98,0:20:41.90,Default,,0,0,0,,Дұрыс. Бұлай жалғаса берсе жұмыс істемейді.
Dialogue: 0,0:20:41.99,0:20:43.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:43.99,0:20:46.91,Default,,0,0,0,,Сіз қалай ойлайсыз? Бара аласыздар ма?
Dialogue: 0,0:20:46.99,0:20:50.91,Default,,0,0,0,,Токио Олимпиадасына
Dialogue: 0,0:20:51.00,0:20:53.00,Default,,0,0,0,,Мен оларды жуып, қайта әкеліп беремін, сондықтан осы уақытта бұларды киіп көрші.
Dialogue: 0,0:20:56.00,0:21:00.92,Default,,0,0,0,,《Мүмкін емес деп ойлама. Мүмкіндік барлығында бар》→
Dialogue: 0,0:21:01.01,0:21:02.92,Default,,0,0,0,,《Мен үшін және сен үшін》
Dialogue: 0,0:21:03.01,0:21:06.01,Default,,0,0,0,,Мен... барғым келеді
Dialogue: 0,0:21:08.01,0:21:09.93,Default,,0,0,0,,⟨Токио Олимпиадасы⟩
Dialogue: 0,0:21:10.01,0:21:13.94,Default,,0,0,0,,⟨Бұл мен үшін алыс→
