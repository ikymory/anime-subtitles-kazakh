Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:14.01,Default,,0,0,0,,♪～
Dialogue: 0,0:00:14.01,0:00:15.93,Default,,0,0,0,,«Тозақ оқиға».
Dialogue: 0,0:00:16.01,0:00:20.02,Default,,0,0,0,,«Біз де мұхиттың көгілдір кереметіне таң қалдық!»
Dialogue: 0,0:00:20.02,0:00:30.03,Default,,0,0,0,,♪～
Dialogue: 0,0:01:52.11,0:01:54.11,Default,,0,0,0,,Сіздер жазды қалай өткізіп жатырсыздар?
Dialogue: 0,0:01:58.11,0:02:01.08,Default,,0,0,0,,Жоқ, айтыңыз.
Dialogue: 0,0:02:01.12,0:02:04.08,Default,,0,0,0,,Қарашы, Йоичи.
Dialogue: 0,0:02:04.12,0:02:06.08,Default,,0,0,0,,«Тозақ оқиға».
Dialogue: 0,0:02:06.12,0:02:09.08,Default,,0,0,0,,«Біз де кездейсоқ бір кереметпіз».
Dialogue: 0,0:02:09.12,0:02:12.09,Default,,0,0,0,,Керемет! Сол сұмдық сезім!
Dialogue: 0,0:02:12.13,0:02:14.09,Default,,0,0,0,,Қазіргі орта мектеп оқушысына ұқсайды
Dialogue: 0,0:02:14.13,0:02:17.09,Default,,0,0,0,,Президент! Күтілгендей, бұл керемет!
Dialogue: 0,0:02:17.13,0:02:22.10,Default,,0,0,0,,Әй, тамаша, Такада-кун. Қызықты жарнама болады деп ойлаймын.
Dialogue: 0,0:02:22.14,0:02:25.10,Default,,0,0,0,,Осы уақытқа дейін біздің компания тек спорттық тауарлармен айналысты →
Dialogue: 0,0:02:25.14,0:02:29.10,Default,,0,0,0,,Бұл менің спорттық сусын әзірлеудегі бірінші міндетім! →
Dialogue: 0,0:02:29.14,0:02:31.11,Default,,0,0,0,,Йоичи сияқты жас олимпиадашы →
Dialogue: 0,0:02:31.15,0:02:34.11,Default,,0,0,0,,Бұл кескін кейіпкеріне өте ыңғайлы.
Dialogue: 0,0:02:34.15,0:02:37.11,Default,,0,0,0,,Иә? Йоичи-кун, не болды?
Dialogue: 0,0:02:37.15,0:02:39.11,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:02:39.15,0:02:43.03,Default,,0,0,0,,Президент. (Президент) Бұл не?
Dialogue: 0,0:02:43.12,0:02:46.04,Default,,0,0,0,,Біріміз Олимпиадаға барсақ→
Dialogue: 0,0:02:46.12,0:02:48.04,Default,,0,0,0,,Мизуки MDC-ны қиратпайды
Dialogue: 0,0:02:48.12,0:02:51.04,Default,,0,0,0,,Иә, жаттықтырушы Асакиге уәде бердіңіз, солай ма?
Dialogue: 0,0:02:51.13,0:02:54.04,Default,,0,0,0,,Иә? Жоқ, бұл қорқынышты.→
Dialogue: 0,0:02:54.13,0:02:57.05,Default,,0,0,0,,Әрине уәдемде тұрамын.→
Dialogue: 0,0:02:57.13,0:02:59.05,Default,,0,0,0,,Сіз медаль алған кезде→
Dialogue: 0,0:02:59.13,0:03:03.05,Default,,0,0,0,,Сіз MDC түпнұсқа купальниктерін жасап, оларды клубтағы барлық адамдарға тарата аласыз.
Dialogue: 0,0:03:03.14,0:03:07.06,Default,,0,0,0,,Менің жеңіл атлетикаға арналған төсенішімнің жыртылып жатқанына үш жыл болды.
Dialogue: 0,0:03:07.14,0:03:10.06,Default,,0,0,0,,Иә? О, мен саған бірден жаңасын жіберемін.
Dialogue: 0,0:03:10.14,0:03:13.06,Default,,0,0,0,,Бекітілген болса, әлі де пайдалануға болады
Dialogue: 0,0:03:13.15,0:03:15.07,Default,,0,0,0,,Эй
Dialogue: 0,0:03:15.15,0:03:20.07,Default,,0,0,0,,Мен өзімді экологиялық орта мектептің сүңгуіріндей сезінемін.
Dialogue: 0,0:03:20.15,0:03:24.16,Default,,0,0,0,,Жоқ, сіз мүлдем ерекше кейіпкерсіз.
Dialogue: 0,0:03:28.16,0:03:31.08,Default,,0,0,0,,Мен бейтаныс тәжірибеден шаршаған болар едім.
Dialogue: 0,0:03:31.17,0:03:35.09,Default,,0,0,0,,Менде болғандай, Олимпиада да алып толқын сияқты.
Dialogue: 0,0:03:35.17,0:03:39.09,Default,,0,0,0,,Бұл ақымақ жарнама бірінші толқын болды ма?
Dialogue: 0,0:03:39.17,0:03:44.01,Default,,0,0,0,,Мен де жаңа ғана естідім, шынымды айтсам, таң қалдым.
Dialogue: 0,0:03:44.09,0:03:46.01,Default,,0,0,0,,Бірақ әлі де кішігірім сүңгулер бар →
Dialogue: 0,0:03:46.10,0:03:49.02,Default,,0,0,0,,Бұл сіздің адамдарға назар аудару мүмкіндігі.
Dialogue: 0,0:03:49.10,0:03:54.10,Default,,0,0,0,,Жастарды тәрбиелеу одан да маңыздырақ деп ойлаймын.
Dialogue: 0,0:04:05.12,0:04:09.04,Default,,0,0,0,,Сіз MDC үшін Мэтт туралы жақсы сөйледіңіз.
Dialogue: 0,0:04:09.12,0:04:11.04,Default,,0,0,0,,Мен де әрқашан қызық болдым.
Dialogue: 0,0:04:11.12,0:04:13.12,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:16.13,0:04:20.13,Default,,0,0,0,,《MDC үшін...қайтадан》
Dialogue: 0,0:04:22.13,0:04:25.05,Default,,0,0,0,,Келесі күні мен келесі Олимпиадаға сүңгуірден өкіл ретінде таңдалдым→
Dialogue: 0,0:04:25.14,0:04:29.06,Default,,0,0,0,,Екі адам, Терамото-кун және менің Фуджитани-кун шешілді.→
Dialogue: 0,0:04:29.14,0:04:32.06,Default,,0,0,0,,Сізді не қызықтырады →
Dialogue: 0,0:04:32.14,0:04:37.06,Default,,0,0,0,,Олимпиада жылының көктемінде өткен өкілдік іріктеу жиналысы неге өткізілмеді?→
Dialogue: 0,0:04:37.15,0:04:42.03,Default,,0,0,0,,Өкілдің тез шешілуінің себебі осы деп ойлаймын.→
Dialogue: 0,0:04:42.07,0:04:44.03,Default,,0,0,0,,Бұл шешімді қабылдау уақыты әдеттен тыс ерте, бірақ →
Dialogue: 0,0:04:44.07,0:04:46.03,Default,,0,0,0,,Жапония су федерациясының Маэхара мырзасы→
Dialogue: 0,0:04:46.07,0:04:50.04,Default,,0,0,0,,Сіз медаль жеңіп алуға керемет ынталысыз.
Dialogue: 0,0:04:50.08,0:04:53.04,Default,,0,0,0,,Олимпиада алдындағы екі ірі халықаралық жарыс→
Dialogue: 0,0:04:53.08,0:04:56.04,Default,,0,0,0,,Өкіл ойыншыларды жіберуге шешім қабылдады
Dialogue: 0,0:04:56.08,0:04:58.04,Default,,0,0,0,,Сондықтан мен ертерек шешім қабылдадым.
Dialogue: 0,0:04:58.09,0:05:00.05,Default,,0,0,0,,Егер медальды соншалықты қаласаңыз→
Dialogue: 0,0:05:00.09,0:05:04.05,Default,,0,0,0,,Неліктен өкілдер санын үшеуден екіге ауыстырдыңыз?
Dialogue: 0,0:05:04.09,0:05:06.05,Default,,0,0,0,,Адам санын көбейтсеңіз, медаль алу ықтималдығы артады→
Dialogue: 0,0:05:06.09,0:05:08.05,Default,,0,0,0,,Бұл міндетті түрде көтеріледі дегенді білдірмейді.→
Dialogue: 0,0:05:08.10,0:05:11.06,Default,,0,0,0,,Егер Жапония шынымен медаль алғысы келсе→
Dialogue: 0,0:05:11.10,0:05:14.06,Default,,0,0,0,,Өкілді тек Терамото-кунмен шектеген дұрыс.
Dialogue: 0,0:05:14.10,0:05:19.06,Default,,0,0,0,,Онда неліктен мен де таңдалдым?
Dialogue: 0,0:05:19.11,0:05:22.07,Default,,0,0,0,,Терамото-кун жалғыз болса, күту жоғары болады.
Dialogue: 0,0:05:22.11,0:05:24.07,Default,,0,0,0,,Сол қысымды босату үшін→
Dialogue: 0,0:05:24.11,0:05:27.07,Default,,0,0,0,,Менің ойымша, командаластар болғаны дұрыс.→
Dialogue: 0,0:05:27.11,0:05:30.08,Default,,0,0,0,,Сондай-ақ, Терамото-кунның жұмысы жақсы болмаған жағдайда →
Dialogue: 0,0:05:30.12,0:05:32.08,Default,,0,0,0,,Сондай-ақ қауіпсіздік пирогы ретінде қызмет етеді
Dialogue: 0,0:05:32.12,0:05:35.08,Default,,0,0,0,,Бұл менің қауіпсіз пирог екенімді білдіре ме?
Dialogue: 0,0:05:35.12,0:05:38.08,Default,,0,0,0,,Сіз Терамото мырзаның психикалық денсаулығын қолдайтын серіктес сияқтысыз ба?
Dialogue: 0,0:05:38.13,0:05:41.00,Default,,0,0,0,,Жоқ, мен олай айтқан жоқпын.
Dialogue: 0,0:05:41.09,0:05:46.01,Default,,0,0,0,,Жарнама туралы айтатын болсақ, оның Олимпиадалық іріктеуге еш қатысы жоқ, солай ма?
Dialogue: 0,0:05:46.09,0:05:48.01,Default,,0,0,0,,Бұлай болуы мүмкін емес. Ақымақ болма.
Dialogue: 0,0:05:48.09,0:05:52.01,Default,,0,0,0,,Өйткені менің жұмыс ұсынысым жақында ғана шешілді→
Dialogue: 0,0:05:52.10,0:05:54.02,Default,,0,0,0,,Тіпті жарнаманың мазмұны да шешілді...
Dialogue: 0,0:05:54.10,0:05:58.02,Default,,0,0,0,,Меніңше, көптен бері шешілген оқиға алға жылжып бара жатыр еді.
Dialogue: 0,0:05:58.10,0:06:01.11,Default,,0,0,0,,Уақыт өте жақсы емес пе?
Dialogue: 0,0:06:03.11,0:06:05.03,Default,,0,0,0,,Білесің бе, Йоичи →
Dialogue: 0,0:06:05.11,0:06:08.03,Default,,0,0,0,,Сіздің жұмыс ұсынысыңызда жарнама бар ма, жоқ па маңызды емес.→
Dialogue: 0,0:06:08.11,0:06:13.12,Default,,0,0,0,,Ең бастысы, сізде 2 санының дағдылары бар.
Dialogue: 0,0:06:15.12,0:06:19.04,Default,,0,0,0,,Ал, Олимпиадаға жолдама алғаннан бері→
Dialogue: 0,0:06:19.12,0:06:22.04,Default,,0,0,0,,Сол болашақ әркімге берілгені рас.→
Dialogue: 0,0:06:22.13,0:06:24.05,Default,,0,0,0,,Мизуки президенті бүгін→
Dialogue: 0,0:06:24.13,0:06:27.05,Default,,0,0,0,,Өйткені ол MDC жалғастыру туралы уәдесін орындайтынын айтты →
Dialogue: 0,0:06:27.13,0:06:31.05,Default,,0,0,0,,Сіз де әлі де көп жұмыс істеп, келесі нәрсені мақсат ете аласыз.
Dialogue: 0,0:06:31.14,0:06:35.06,Default,,0,0,0,,Келесі Олимпиада бес жылдан кейін болады...
Dialogue: 0,0:06:35.14,0:06:38.06,Default,,0,0,0,,Мен ол кезде не болатынын білмеймін.→
Dialogue: 0,0:06:38.14,0:06:41.02,Default,,0,0,0,,Келер жыл немесе ертең туралы болса да→
Dialogue: 0,0:06:41.06,0:06:43.07,Default,,0,0,0,,Мен түсінбесем де...
Dialogue: 0,0:06:46.07,0:06:49.03,Default,,0,0,0,,Сәлем Рейджи. Бір минут күте тұрыңыз.
Dialogue: 0,0:06:49.07,0:06:52.03,Default,,0,0,0,,Сіз секіріп, тастап кетпейсіз бе?
Dialogue: 0,0:06:52.07,0:06:54.03,Default,,0,0,0,,Не? (1-кілт) Кесене сияқты →
Dialogue: 0,0:06:54.08,0:06:56.04,Default,,0,0,0,,Ертең жаттығуға келуді тоқтатпайсыз, солай ма?
Dialogue: 0,0:06:56.08,0:07:00.04,Default,,0,0,0,,Мұндай нәрселерге алаңдау Йоичиге ұқсамайды.
Dialogue: 0,0:07:00.08,0:07:02.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:02.08,0:07:04.04,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:07:04.09,0:07:07.05,Default,,0,0,0,,Бұл таңқаларлық болды, шынымды айтсам, көңілім қалды.→
Dialogue: 0,0:07:07.09,0:07:09.05,Default,,0,0,0,,Бірақ Томодан айырмашылығы мен →
Dialogue: 0,0:07:09.09,0:07:12.05,Default,,0,0,0,,Мен мұнда өз шегімді біліп келдім.
Dialogue: 0,0:07:12.09,0:07:15.06,Default,,0,0,0,,Біртүрлі нәрселерге алаңдамаңыз, бар күшіңізді салыңыз
Dialogue: 0,0:07:15.10,0:07:17.06,Default,,0,0,0,,Мен Йоичиге әрқашан әдемі көрінемін →
Dialogue: 0,0:07:17.10,0:07:20.06,Default,,0,0,0,,Мен сенің топтан озғаныңды қалаймын, солай ма?
Dialogue: 0,0:07:20.10,0:07:24.06,Default,,0,0,0,,Егер сіз одан да көп уайымдасаңыз, бұл Томо.
Dialogue: 0,0:07:24.11,0:07:26.07,Default,,0,0,0,,Не? Асаки жаттықтырушыдан күндізгі уақытта →
Dialogue: 0,0:07:26.11,0:07:30.07,Default,,0,0,0,,Өкіл ұсынысы туралы естігеннен бері біртүрлі болды, ол жігіт.
Dialogue: 0,0:07:30.11,0:07:32.07,Default,,0,0,0,,Біртүрлі?
Dialogue: 0,0:07:32.11,0:07:38.08,Default,,0,0,0,,Мен өзімді бұлыңғыр және жансыз сезінетіндей сезінемін ...
Dialogue: 0,0:07:38.12,0:07:42.12,Default,,0,0,0,,Ол дәл қазір брифингте ештеңе айтқан жоқ.
Dialogue: 0,0:07:49.13,0:07:52.09,Default,,0,0,0,,Фудзитани Олимпиада командасына таңдалды→
Dialogue: 0,0:07:52.13,0:07:55.10,Default,,0,0,0,,Қазіргі қуанышыңызды кіммен бөліскіңіз келеді?
Dialogue: 0,0:07:55.14,0:07:58.10,Default,,0,0,0,,Жұмақтағы анама. (Йорико) Ол тірі.
Dialogue: 0,0:07:58.14,0:08:03.10,Default,,0,0,0,,Әке мен бала Олимпиадада әке мен баладан екі ұрпақ бақ сынайтынына сене алар емеспін.
Dialogue: 0,0:08:03.15,0:08:07.11,Default,,0,0,0,,Бір нәрсе сізді бақытты етпейді.
Dialogue: 0,0:08:07.15,0:08:10.11,Default,,0,0,0,,Ондай ештеңе жоқ.→
Dialogue: 0,0:08:10.15,0:08:12.15,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:08:16.16,0:08:20.12,Default,,0,0,0,,《Бұл басқаша... бірдеңе》
Dialogue: 0,0:08:20.16,0:08:23.12,Default,,0,0,0,,Оқиға!
Dialogue: 0,0:08:23.17,0:08:26.13,Default,,0,0,0,,Көп нәрсе болып жатқаны сонша, бұл шынымен үлкен оқиға болуы керек→
Dialogue: 0,0:08:26.17,0:08:28.13,Default,,0,0,0,,Мен таң қалған жоқпын. (Томоки) Иә.
Dialogue: 0,0:08:28.17,0:08:30.13,Default,,0,0,0,,Йоичи-кун келмеді!
Dialogue: 0,0:08:30.17,0:08:32.13,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:08:32.17,0:08:36.14,Default,,0,0,0,,Олимпиадаға қатысты нәрсе емес пе?
Dialogue: 0,0:08:36.18,0:08:40.14,Default,,0,0,0,,Жоқ, жоқ, мен Фудзитани жаттықтырушысынан жауап алдым.
Dialogue: 0,0:08:40.18,0:08:43.14,Default,,0,0,0,,Сіз ауырып жатырсыз ба? (Томоки) Иә...
Dialogue: 0,0:08:45.15,0:08:49.07,Default,,0,0,0,,Бас ауруы Жақсысыз ба? (Йоичи) О
Dialogue: 0,0:08:49.15,0:08:53.07,Default,,0,0,0,,Дәрігер, мен баруым керек пе? (1-кілт) Әдеттегі мигрень
Dialogue: 0,0:08:53.15,0:08:56.07,Default,,0,0,0,,Егер солай болса, сіз жаттығуға барасыз, солай ма?
Dialogue: 0,0:08:56.16,0:08:59.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:59.16,0:09:01.08,Default,,0,0,0,,《Иә. Әдетте→
Dialogue: 0,0:09:01.16,0:09:04.08,Default,,0,0,0,,Мен мұндай мигреннен бір күн демалмаймын》→
Dialogue: 0,0:09:04.16,0:09:07.08,Default,,0,0,0,,《Мен “не керек болса да” деп ойладым》→
Dialogue: 0,0:09:07.17,0:09:10.09,Default,,0,0,0,,《Қазіргі уақытта мұндай “не қажет болса да” жоқ》
Dialogue: 0,0:09:10.17,0:09:12.09,Default,,0,0,0,,《Мүмкін сіз жаттығудан үзіліс алғыңыз келе ме? 》
Dialogue: 0,0:09:12.17,0:09:14.17,Default,,0,0,0,,《Бұл мен...》
Dialogue: 0,0:09:17.97,0:09:22.93,Default,,0,0,0,,Бір аптаға жуық уақыт қалды. (Тамшылар) Не?
Dialogue: 0,0:09:22.98,0:09:24.94,Default,,0,0,0,,Йоичи үзіліс жасай бастады.
Dialogue: 0,0:09:24.98,0:09:27.94,Default,,0,0,0,,Солай ма? (Томоки) Иә...
Dialogue: 0,0:09:29.94,0:09:33.86,Default,,0,0,0,,Окицу-кун қайтып келсе де, →
Dialogue: 0,0:09:33.94,0:09:36.86,Default,,0,0,0,,Сонымен... өкіл болып сайланбағаныңызға көңіліңіз қалды ма?
Dialogue: 0,0:09:36.95,0:09:38.87,Default,,0,0,0,,>> Жоқ. (Томоки) Иә?
Dialogue: 0,0:09:38.95,0:09:40.87,Default,,0,0,0,,Сол әйел маған айтты
Dialogue: 0,0:09:40.95,0:09:43.87,Default,,0,0,0,,«Мен бұл жолы Олимпиадаға қатыса алмауым мүмкін».
Dialogue: 0,0:09:43.95,0:09:45.87,Default,,0,0,0,,Солай ма? Олай болса...
Dialogue: 0,0:09:45.96,0:09:50.88,Default,,0,0,0,,Неге қайтып келдің? (Томоки) Иә... Иә.
Dialogue: 0,0:09:50.96,0:09:53.96,Default,,0,0,0,,Себебі мен бұл қызықты деп ойладым.
Dialogue: 0,0:09:58.97,0:10:01.97,Default,,0,0,0,,Қызық... иә?
Dialogue: 0,0:10:04.98,0:10:07.98,Default,,0,0,0,,(Суға түскен дыбыс)
Dialogue: 0,0:10:14.99,0:10:18.91,Default,,0,0,0,,Не, сен жақсы сияқтысың ба? Менің ойымша, сіз бір күн демалыс аласыз.
Dialogue: 0,0:10:18.99,0:10:23.91,Default,,0,0,0,,Уранның ықпалына байланысты осы айда Арыстанда су мәселесінің бір қыры бар.
Dialogue: 0,0:10:23.99,0:10:27.87,Default,,0,0,0,,Мен Цугарудан оралған бойда Олимпиадаға қатысатын спортшылар анықталады →
Dialogue: 0,0:10:27.91,0:10:32.92,Default,,0,0,0,,Менің қарсыласым жаттығуды өткізіп жібереді. Бұл жай ғана әзіл.
Dialogue: 0,0:10:35.92,0:10:38.88,Default,,0,0,0,,Менің басым ауырып жүр. (Тамшылар) Бір апта?
Dialogue: 0,0:10:38.93,0:10:40.89,Default,,0,0,0,,Бұл маңызды.
Dialogue: 0,0:10:40.93,0:10:43.89,Default,,0,0,0,,Не болды? Сізге ұқсамайды.→
Dialogue: 0,0:10:43.93,0:10:45.89,Default,,0,0,0,,Айтпақшы, менің бөлмелесім сенсің→
Dialogue: 0,0:10:45.93,0:10:49.90,Default,,0,0,0,,Мен күйіп қалу синдромы туралы алаңдаймын.
Dialogue: 0,0:10:49.94,0:10:53.90,Default,,0,0,0,,Әзіл болса күлкілі, ал байыпты болса тым қызықсыз →
Dialogue: 0,0:10:53.94,0:10:55.90,Default,,0,0,0,,Жаттықтырушы Ошимаға айтыңыз
Dialogue: 0,0:10:55.94,0:10:59.91,Default,,0,0,0,,Алтын медаль ұтып алсаңыз да, қатысу құқығы күл болады...
Dialogue: 0,0:10:59.95,0:11:01.91,Default,,0,0,0,,Сонда сен талантты боласың ба? (Йоичи) Иә?
Dialogue: 0,0:11:01.95,0:11:05.91,Default,,0,0,0,,Спорттық сусынның жарнамасы. (Йоичи) Сіз осындай нәрсе жасайсыз ба? Идиот.
Dialogue: 0,0:11:05.95,0:11:07.91,Default,,0,0,0,,Онда неге жаттығуға келмейсің? →
Dialogue: 0,0:11:07.95,0:11:10.92,Default,,0,0,0,,Сіз не ойлап отырсыз? (Бірінші кілт) Себебі мен мұны түсінбеймін →
Dialogue: 0,0:11:10.96,0:11:13.92,Default,,0,0,0,,Мен оны сынап жатырмын. (Шашырау) Әй?
Dialogue: 0,0:11:13.96,0:11:16.92,Default,,0,0,0,,Мен кенет жаттығуға барғым келмеді.→
Dialogue: 0,0:11:16.96,0:11:20.93,Default,,0,0,0,,Мен мұндай әрекетті бірінші рет жасап отырмын, сондықтан мен де абдырап қалдым.→
Dialogue: 0,0:11:20.97,0:11:22.93,Default,,0,0,0,,Мен шынымен де үзіліс жасасам, түсінемін бе деп ойлаймын.→
Dialogue: 0,0:11:22.97,0:11:25.85,Default,,0,0,0,,Тек мұны істеу.
Dialogue: 0,0:11:25.93,0:11:29.85,Default,,0,0,0,,Мен түсінбеймін. Бірақ жақсы.
Dialogue: 0,0:11:29.94,0:11:33.86,Default,,0,0,0,,Ойланып қарасаң, мен де Цугаруда көп босаңсыдым.→
Dialogue: 0,0:11:33.94,0:11:35.86,Default,,0,0,0,,Бірақ мен сізге мынаны айтайын.
Dialogue: 0,0:11:35.94,0:11:39.86,Default,,0,0,0,,Сақай екеуіңмен тағы да соғысқым келеді.→
Dialogue: 0,0:11:39.95,0:11:41.86,Default,,0,0,0,,Кезең Олимпиада болмаса да →
Dialogue: 0,0:11:41.95,0:11:43.87,Default,,0,0,0,,Кез келген жерде жақсы, тіпті Тацуми де.→
Dialogue: 0,0:11:43.95,0:11:46.95,Default,,0,0,0,,Бұл жай ғана сенсіз басталмайды.
Dialogue: 0,0:11:51.96,0:11:53.88,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:11:53.96,0:11:57.88,Default,,0,0,0,,Мен оны Томо-куннан алдым. Құттықтау гүлдері.
Dialogue: 0,0:11:57.96,0:11:59.97,Default,,0,0,0,,Мен сөз тіркесін айтамын.
Dialogue: 0,0:12:01.97,0:12:04.97,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,0:12:06.97,0:12:08.97,Default,,0,0,0,,《Бұл әрқашан біртүрлі болды》
Dialogue: 0,0:12:14.98,0:12:16.90,Default,,0,0,0,,📱(Қоңырау үні)
Dialogue: 0,0:12:16.98,0:12:18.90,Default,,0,0,0,,📱(Томоки) Йоичи-кун?
Dialogue: 0,0:12:18.98,0:12:21.90,Default,,0,0,0,,Фаленопсис келді. рахмет
Dialogue: 0,0:12:21.99,0:12:23.91,Default,,0,0,0,,📱(Томоки) Кешіктіргенім үшін кешіріңіз.→
Dialogue: 0,0:12:23.99,0:12:25.82,Default,,0,0,0,,Осындай сәттерде менің ойымша, бұл гүлдер→
Dialogue: 0,0:12:25.91,0:12:28.83,Default,,0,0,0,,Хиромен сөйлескенімде, ол әртүрлі нәрселерді зерттеді→
Dialogue: 0,0:12:28.91,0:12:33.83,Default,,0,0,0,,Фаленопсис гүлі ең керемет көрінді. Сіз қалай ойлайсыз?
Dialogue: 0,0:12:33.92,0:12:37.84,Default,,0,0,0,,Аа, бұл керемет. Қымбат емес пе еді?
Dialogue: 0,0:12:37.92,0:12:41.84,Default,,0,0,0,,📱 (Томоки) Жарайды. Анам мен әкем бізге әрқайсысының жартысын берді.
Dialogue: 0,0:12:41.92,0:12:44.93,Default,,0,0,0,,>> Сіз мені сыртқа шығара алмайсыз. 📱 (Томоки) Хехехе
Dialogue: 0,0:12:46.93,0:12:51.85,Default,,0,0,0,,📱Эй, Йоичи-кун, сен неге жаттығуға келмейсің?
Dialogue: 0,0:12:51.93,0:12:53.85,Default,,0,0,0,,Айдың әсерінен осы аптадағы Арыстан →
Dialogue: 0,0:12:53.94,0:12:58.86,Default,,0,0,0,,Биік жерге көтерілмеңіз және секірмеңіз.
Dialogue: 0,0:12:58.94,0:13:02.86,Default,,0,0,0,,📱(Томоки) Өйткені Йоичисіз біздің клуб ештеңе болмас еді.→
Dialogue: 0,0:13:02.94,0:13:04.86,Default,,0,0,0,,Эй, келесі аптада келесің бе?
Dialogue: 0,0:13:04.95,0:13:07.87,Default,,0,0,0,,Жұлдыздардан сұра. Сонда кездескенше.
Dialogue: 0,0:13:07.95,0:13:09.87,Default,,0,0,0,,📱 (Томоки) Иә...
Dialogue: 0,0:13:09.95,0:13:12.87,Default,,0,0,0,,＼ (Йоичи) Иә
Dialogue: 0,0:13:12.95,0:13:15.96,Default,,0,0,0,,Әкем полицияда қызмет етеді.
Dialogue: 0,0:13:19.96,0:13:21.88,Default,,0,0,0,,Сіздің де өз ойыңыз бар екеніне сенімдімін.→
Dialogue: 0,0:13:21.96,0:13:23.88,Default,,0,0,0,,Осы жерге қалдырыңыз.→
Dialogue: 0,0:13:23.97,0:13:25.84,Default,,0,0,0,,Мен де жаттықтырушы ретінде →
Dialogue: 0,0:13:25.88,0:13:28.85,Default,,0,0,0,,Біз мұны енді назардан тыс қалдыра алмаймыз.
Dialogue: 0,0:13:28.89,0:13:31.85,Default,,0,0,0,,Оның үстіне, сіз енді келесі матчқа дайындалып жатырсыз→
Dialogue: 0,0:13:31.89,0:13:34.85,Default,,0,0,0,,Түзетулер енгізу уақыты келді.
Dialogue: 0,0:13:34.89,0:13:37.85,Default,,0,0,0,,Келесі ойын? (Фудзитани) Жапония су федерациясы қараша айында өтеді→
Dialogue: 0,0:13:37.90,0:13:42.86,Default,,0,0,0,,Қытай ойыншыларын шақырып, жолдастық кездесу өткізіңіз.
Dialogue: 0,0:13:42.90,0:13:46.86,Default,,0,0,0,,Осы нәтижелерге сүйене отырып, сіз және Терамото ұлттық құрама ойыншысы ретінде таңдалдыңыз→
Dialogue: 0,0:13:46.91,0:13:48.87,Default,,0,0,0,,Көпшілікке жарияланады
Dialogue: 0,0:13:48.91,0:13:52.87,Default,,0,0,0,,Мен тіпті матч ойнамаған болсам да...
Dialogue: 0,0:13:52.91,0:13:55.87,Default,,0,0,0,,Терамото-саннан басқа жапон ойыншысынан жеңілсем→
Dialogue: 0,0:13:55.91,0:13:57.87,Default,,0,0,0,,Менің өкілдік құқығыма не болады?
Dialogue: 0,0:13:57.92,0:14:00.88,Default,,0,0,0,,Сіздің өкілдік ету құқығыңыз – шешім қабылдау мәселесі.
Dialogue: 0,0:14:00.92,0:14:02.88,Default,,0,0,0,,Егер мен матчта үлкен қателік жіберсем ше?
Dialogue: 0,0:14:02.92,0:14:05.88,Default,,0,0,0,,Әй, айнымас. (Йоичи) Бұл біртүрлі болуы керек!
Dialogue: 0,0:14:05.92,0:14:08.89,Default,,0,0,0,,Ондай жағдайда күндіз жолдастық кездесу болатын еді→
Dialogue: 0,0:14:08.93,0:14:11.89,Default,,0,0,0,,Тек өкілді шешіңіз!
Dialogue: 0,0:14:11.93,0:14:15.89,Default,,0,0,0,,Жалғыз айтарым, сіз... Йоичи Фудзитани→
Dialogue: 0,0:14:15.93,0:14:18.90,Default,,0,0,0,,Маңызды ойындарда ешқашан покер ойнамаңыз
Dialogue: 0,0:14:18.94,0:14:20.90,Default,,0,0,0,,Ол сондай ойыншы.
Dialogue: 0,0:14:20.94,0:14:23.94,Default,,0,0,0,,Бұл мақтау емес.
Dialogue: 0,0:14:28.91,0:14:30.82,Default,,0,0,0,,Ах! (Юкия) Йоичи-кун!
Dialogue: 0,0:14:30.91,0:14:34.83,Default,,0,0,0,,Не... Не? (Томоки) Сен келдің.
Dialogue: 0,0:14:34.91,0:14:36.83,Default,,0,0,0,,Жұлдыздардың ілімін ұстандым.
Dialogue: 0,0:14:36.91,0:14:40.83,Default,,0,0,0,,Балалар, осындасыңдар.
Dialogue: 0,0:14:40.92,0:14:42.84,Default,,0,0,0,,Жаттықтырушы Ошима. Окитсу ше?
Dialogue: 0,0:14:42.92,0:14:46.84,Default,,0,0,0,,Аа, егер бұл тамшылар болса, мен бүгін белімді электрмен емдеуге барамын.
Dialogue: 0,0:14:46.92,0:14:48.84,Default,,0,0,0,,Содан кейін балет сабақтары бар.
Dialogue: 0,0:14:48.93,0:14:51.85,Default,,0,0,0,,Балет? неге тағы
Dialogue: 0,0:14:51.93,0:14:53.85,Default,,0,0,0,,Мен оны тренингтің бір бөлігі ретінде енгіздім.
Dialogue: 0,0:14:53.93,0:14:56.85,Default,,0,0,0,,Сізге тамшылар ұнамайды деп ойладым →
Dialogue: 0,0:14:56.93,0:14:58.85,Default,,0,0,0,,Бір қызығы, ол оңай түсінді.
Dialogue: 0,0:14:58.94,0:15:00.85,Default,,0,0,0,,Талай тарылып кеткен сияқты→
Dialogue: 0,0:15:00.94,0:15:02.86,Default,,0,0,0,,Сабақтан кейін өзімді жайбарақат сезінемін→
Dialogue: 0,0:15:02.94,0:15:04.86,Default,,0,0,0,,Тамшылардың динамизміне→
Dialogue: 0,0:15:04.94,0:15:07.86,Default,,0,0,0,,Балеттің талғампаз элементтерін қосқанда не болады→
Dialogue: 0,0:15:07.94,0:15:10.86,Default,,0,0,0,,Мен қараша айындағы ойынды асыға күтемін.
Dialogue: 0,0:15:10.95,0:15:13.87,Default,,0,0,0,,Бұл Жапония-Қытай жолдастық кездесуі ме? Ол келе жатыр ма?
Dialogue: 0,0:15:13.95,0:15:16.87,Default,,0,0,0,,Мен сонда боламын. (Йоичи) Бірақ бұл матч...
Dialogue: 0,0:15:16.95,0:15:19.87,Default,,0,0,0,,О, мен сенің не айтып тұрғаныңды білемін.
Dialogue: 0,0:15:19.96,0:15:21.88,Default,,0,0,0,,Тіпті тамшылар, Томо мен Рейдзи→
Dialogue: 0,0:15:21.96,0:15:23.88,Default,,0,0,0,,Соны біліп, сол матчқа бардым.→
Dialogue: 0,0:15:23.96,0:15:28.88,Default,,0,0,0,,Сіздің қайтып келгеніңізді білгенде тамшылар қуанатынына сенімдімін.
Dialogue: 0,0:15:28.97,0:15:31.89,Default,,0,0,0,,Жарайсың ба? Өз көзіңізбен мұқият қараңыз →
Dialogue: 0,0:15:31.97,0:15:33.97,Default,,0,0,0,,Уақытты дұрыс анықтаңыз!
Dialogue: 0,0:15:39.98,0:15:41.98,Default,,0,0,0,,Төрт жарым есе!
Dialogue: 0,0:15:45.98,0:15:51.91,Default,,0,0,0,,Жіліншіктерді кеудеге жақындатып, кішірек денеге бүгіңіз.
Dialogue: 0,0:15:51.99,0:15:54.91,Default,,0,0,0,,Көзіңізді пайдаланыңыз. Сол қаруың.→
Dialogue: 0,0:15:54.99,0:15:57.99,Default,,0,0,0,,Егер сіз мұны жасасаңыз, мен мұны істей алатыныңызға сенімдімін. (Томоки) Иә.
Dialogue: 0,0:15:57.99,0:16:09.01,Default,,0,0,0,,♪～
Dialogue: 0,0:16:11.01,0:16:12.93,Default,,0,0,0,,《Уақыт дұрыс емес...》→
Dialogue: 0,0:16:13.01,0:16:15.93,Default,,0,0,0,,《Қателерді жабу мүмкін емес...》→
Dialogue: 0,0:16:16.01,0:16:18.01,Default,,0,0,0,,《Сіздің интуицияңыз ақылсыз ба? 》
Dialogue: 0,0:16:22.02,0:16:24.94,Default,,0,0,0,,Сол Йоичи-кун сәтсіздікке ұшырап, допты соқты.
Dialogue: 0,0:16:25.02,0:16:28.90,Default,,0,0,0,,Бір апталық үзіліске байланысты ма? (Томоки) Иә... олай емес сияқты.
Dialogue: 0,0:16:28.94,0:16:31.90,Default,,0,0,0,,Эй, сен білесің бе? Окицу-кун және жаттықтырушы Асаги →
Dialogue: 0,0:16:31.95,0:16:34.91,Default,,0,0,0,,Олар Чиба маңындағы теңізде жасырын жаттығу жасап жатқан сияқты.
Dialogue: 0,0:16:34.95,0:16:37.91,Default,,0,0,0,,Тек балет емес, теңіздегі арнайы дайындық→
Dialogue: 0,0:16:37.95,0:16:40.91,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:40.95,0:16:42.96,Default,,0,0,0,,(суға түскен дыбыс)
Dialogue: 0,0:16:45.96,0:16:47.96,Default,,0,0,0,,《Не болып жатыр...》
Dialogue: 0,0:16:51.97,0:16:55.93,Default,,0,0,0,,Макарон түскі ас, өтінемін. (Йоичи) Мұзды кофе
Dialogue: 0,0:16:55.97,0:16:59.93,Default,,0,0,0,,Түскі асқа да тапсырыс беру керек. Әлі түскі ас емес, солай ма?
Dialogue: 0,0:16:59.97,0:17:02.93,Default,,0,0,0,,Бұл мүмкін емес. Мен сүңгуірмін.
Dialogue: 0,0:17:02.98,0:17:06.94,Default,,0,0,0,,Паста түскі ас жиынтығы 1480 ккал
Dialogue: 0,0:17:06.98,0:17:09.94,Default,,0,0,0,,Бір ғана макарондағы кеспенің калориясы жеткілікті болса да→
Dialogue: 0,0:17:09.98,0:17:12.94,Default,,0,0,0,,Бұл негізінен бекон және ақ соус.
Dialogue: 0,0:17:12.99,0:17:15.95,Default,,0,0,0,,Қысқы ұйқыға шыққанға дейін шошқалар да онша көп қоректенбейді.
Dialogue: 0,0:17:15.99,0:17:19.95,Default,,0,0,0,,Күтілгендей. Бірақ шошқалар қыстайды ма?
Dialogue: 0,0:17:19.99,0:17:22.95,Default,,0,0,0,,Келіңіздер ме? (Нацу Йоко) Олай болса, оқиға неде?
Dialogue: 0,0:17:23.00,0:17:25.87,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:17:25.96,0:17:28.88,Default,,0,0,0,,Неге сонша жұмыс істейсің?
Dialogue: 0,0:17:28.96,0:17:30.88,Default,,0,0,0,,Не? (Негізгі нүкте 1) Жаттықтырушы Асакидің мақсаты →
Dialogue: 0,0:17:30.96,0:17:34.88,Default,,0,0,0,,МДК-дан Олимпиадаға өкіл жіберу идеясы.
Dialogue: 0,0:17:34.97,0:17:37.89,Default,,0,0,0,,Әзірге біз өкілдік құқығын қамтамасыз еттік.
Dialogue: 0,0:17:37.97,0:17:40.89,Default,,0,0,0,,Бірақ неге Окицуды балет үйренуге мәжбүр еттіңіз→
Dialogue: 0,0:17:40.97,0:17:43.89,Default,,0,0,0,,Сіз Томаға төрт жарым рет сабақ беріп жатырсыз ба?
Dialogue: 0,0:17:43.98,0:17:47.90,Default,,0,0,0,,Өйткені ол балалар тоқтамайды.→
Dialogue: 0,0:17:47.98,0:17:49.90,Default,,0,0,0,,Олимпиадалық құрамаға түспесем де →
Dialogue: 0,0:17:49.98,0:17:52.90,Default,,0,0,0,,Мен сол балалардың ештеңе айтпастан секіріп бара жатқанын бақылап отырдым→
Dialogue: 0,0:17:52.98,0:17:55.90,Default,,0,0,0,,Жаттықтырушыға қажет нәрсе мақсат емес→
Dialogue: 0,0:17:55.99,0:17:57.99,Default,,0,0,0,,Себебі мен сенің ойыншы екеніңді білдім.
Dialogue: 0,0:17:59.99,0:18:03.91,Default,,0,0,0,,Шынымды айтсам, бес жылдан кейін не боларын өзім де білмеймін.→
Dialogue: 0,0:18:04.00,0:18:05.91,Default,,0,0,0,,Бірақ қазір, бұл жолы →
Dialogue: 0,0:18:06.00,0:18:11.92,Default,,0,0,0,,Мен оны сол балалармен толығымен өртеп жібергім келеді. Бар болғаны.
Dialogue: 0,0:18:12.00,0:18:13.92,Default,,0,0,0,,Мен де солай ойладым...
Dialogue: 0,0:18:14.01,0:18:16.93,Default,,0,0,0,,Ақырында, негізгі ой?
Dialogue: 0,0:18:17.01,0:18:21.93,Default,,0,0,0,,Соңғы кездері өзімді өте нашар сезініп жүрмін...
Dialogue: 0,0:18:22.01,0:18:24.93,Default,,0,0,0,,Сіз түсінесіз деп ойлаймын.
Dialogue: 0,0:18:25.02,0:18:26.94,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:18:28.94,0:18:31.86,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:31.94,0:18:35.86,Default,,0,0,0,,Мен білмеймін. Шынымды айтсам, бұл менің бірінші рет...→
Dialogue: 0,0:18:35.94,0:18:39.86,Default,,0,0,0,,Мен өзімнің сенімімді жоғалтып бара жатқанымды сезінемін.
Dialogue: 0,0:18:39.95,0:18:43.87,Default,,0,0,0,,Сенімге ие болған күш қана емес→
Dialogue: 0,0:18:43.95,0:18:47.87,Default,,0,0,0,,Бұл жаңа сынақ сияқты...
Dialogue: 0,0:18:47.96,0:18:49.87,Default,,0,0,0,,Томо төрт жарым төңкеріс жасап көру→
Dialogue: 0,0:18:49.96,0:18:51.88,Default,,0,0,0,,Окицуды балет ойнап жатқанына қарап →
Dialogue: 0,0:18:51.96,0:18:55.88,Default,,0,0,0,,Мен ғана, мен жаңа ештеңе жасаған жоқпын.
Dialogue: 0,0:18:55.96,0:18:57.88,Default,,0,0,0,,Сіз қателескен кезде сүңгу→
Dialogue: 0,0:18:57.97,0:19:00.89,Default,,0,0,0,,Көбінесе ұшатын сәтте менің иегім әлсірейді.
Dialogue: 0,0:19:00.97,0:19:05.89,Default,,0,0,0,,Жүрекпен қозғалған Иек жоғары қарай қисайған сайын, көзқарас табиғи түрде көтеріледі.→
Dialogue: 0,0:19:05.97,0:19:07.89,Default,,0,0,0,,Осыдан менің барлық түйсігім бұрмаланып кетеді.
Dialogue: 0,0:19:07.98,0:19:10.90,Default,,0,0,0,,Бірақ бұл тек үстірт.
Dialogue: 0,0:19:10.98,0:19:13.90,Default,,0,0,0,,Мәселенің мәні әлдеқайда тереңде жатыр.
Dialogue: 0,0:19:13.98,0:19:17.90,Default,,0,0,0,,Сіз Олимпиадаға өкіл спортшы ретінде таңдадыңыз.→
Dialogue: 0,0:19:17.99,0:19:19.90,Default,,0,0,0,,Таңдалғаным мені қанағаттандырмайды.→
Dialogue: 0,0:19:19.99,0:19:23.91,Default,,0,0,0,,Бірақ МДК үшін оны жұтудан басқа амалым жоқ.→
Dialogue: 0,0:19:23.99,0:19:26.87,Default,,0,0,0,,Ақыл мен дене бөлек.
Dialogue: 0,0:19:26.91,0:19:28.87,Default,,0,0,0,,Сакай-кун мен Окицу-кунды көргенде, мен → мазасызданамын
Dialogue: 0,0:19:28.91,0:19:32.88,Default,,0,0,0,,Өйткені олар өз еркімен секіреді.→
Dialogue: 0,0:19:32.92,0:19:34.88,Default,,0,0,0,,Басқа біреу дайындаған рельсте болу→
Dialogue: 0,0:19:34.92,0:19:37.92,Default,,0,0,0,,Сізден басқаша
Dialogue: 0,0:19:39.92,0:19:43.89,Default,,0,0,0,,Бұл елес қар сияқты. Денесіз қар...→
Dialogue: 0,0:19:43.93,0:19:46.89,Default,,0,0,0,,Ұстасаң да ерімейді, суымайды.→
Dialogue: 0,0:19:46.93,0:19:48.89,Default,,0,0,0,,Барлығымыз оны айналдырып жатырмыз.
Dialogue: 0,0:19:48.93,0:19:50.89,Default,,0,0,0,,Маған қатысы жоқ жерде →
Dialogue: 0,0:19:50.94,0:19:54.90,Default,,0,0,0,,Ақшақар үлкейіп барады.
Dialogue: 0,0:19:54.94,0:19:57.90,Default,,0,0,0,,Жапонияның су федерациясы маған өкілдік құқық берді, ол арзан болды.
Dialogue: 0,0:19:57.94,0:20:02.91,Default,,0,0,0,,Мизуки мені жаман жарнамаға тартуға тырысты...
Dialogue: 0,0:20:02.95,0:20:05.91,Default,,0,0,0,,Әкем мені MDC аман қалуының кілті етті...
Dialogue: 0,0:20:05.95,0:20:08.91,Default,,0,0,0,,Мен мұның бәрінен ыңғайсыз сезінемін.
Dialogue: 0,0:20:08.95,0:20:10.91,Default,,0,0,0,,Олимпиада осындай болады.
Dialogue: 0,0:20:10.96,0:20:14.92,Default,,0,0,0,,Бірақ сен оны бар күшіңмен жоққа шығарасың.→
Dialogue: 0,0:20:14.96,0:20:17.92,Default,,0,0,0,,Домалап келе жатқан қар адамын тоқтатқыңыз келеді, солай ма?
Dialogue: 0,0:20:17.96,0:20:19.92,Default,,0,0,0,,Ах. (Нацу Йоко) Олай болса, өзіңіз жасаңыз→
Dialogue: 0,0:20:19.96,0:20:23.93,Default,,0,0,0,,Онымен жай ғана айналдырыңыз. Не істегіңіз келсе, соны істеуден басқа амалыңыз жоқ.
Dialogue: 0,0:20:23.97,0:20:25.85,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:20:25.93,0:20:30.85,Default,,0,0,0,,Өзіңіз шешесіз. Бұл сенің өмірің.
Dialogue: 0,0:20:30.93,0:20:33.85,Default,,0,0,0,,Сіз басқаларға қарағанда MDC-ті сақтағыңыз келетін адамсыз.
Dialogue: 0,0:20:33.94,0:20:36.86,Default,,0,0,0,,Неліктен бұлай дейсіз?
Dialogue: 0,0:20:36.94,0:20:40.86,Default,,0,0,0,,Неліктен? Себебі сенде талант бар.
Dialogue: 0,0:20:40.94,0:20:42.86,Default,,0,0,0,,Мен оның жойылғанын қаламаймын
Dialogue: 0,0:20:42.95,0:20:46.95,Default,,0,0,0,,Мен сенің қаншалықты өсетініңді көргім келеді.
Dialogue: 0,0:20:50.95,0:20:53.87,Default,,0,0,0,,《Гамбургер 250 килокалория》→
Dialogue: 0,0:20:53.96,0:20:57.88,Default,,0,0,0,,《Шоколадты бананнан жасалған креп 560 килокалория》→
Dialogue: 0,0:20:57.96,0:20:59.88,Default,,0,0,0,,《Құлпынайдан жасалған қысқа қаймақ…》→
Dialogue: 0,0:20:59.96,0:21:03.88,Default,,0,0,0,,《Бұл қауіпті, бұл қауіпті, бұл қауіпті, бұл қала қауіпті...》→
Dialogue: 0,0:21:03.97,0:21:06.89,Default,,0,0,0,,《Бұл менің басым қауіпті...》
Dialogue: 0,0:21:06.97,0:21:08.89,Default,,0,0,0,,《Мен тұйыққа тірелдім...》
Dialogue: 0,0:21:08.97,0:21:11.89,Default,,0,0,0,,《Онда неге оны өзіңіз айналдырмасқа》
Dialogue: 0,0:21:11.98,0:21:14.98,Default,,0,0,0,,《Бұл сенің өмірің》
Dialogue: 0,0:21:14.98,0:21:34.91,Default,,0,0,0,,♪～
Dialogue: 0,0:21:36.41,0:21:42.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory