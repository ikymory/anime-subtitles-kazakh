Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:18.05,0:00:18.71,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:00:24.55,0:00:30.56,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:00:34.70,0:00:36.56,Default,,0,0,0,,Қарғыс атсын! Не болады?
Dialogue: 0,0:00:36.63,0:00:38.33,Default,,0,0,0,,Оны тез өлтір!
Dialogue: 0,0:00:38.50,0:00:40.50,Default,,0,0,0,,Мен сені өлтірсем де, өлмеймін!
Dialogue: 0,0:00:41.20,0:00:42.80,Default,,0,0,0,,Бір ғана жау болуы мүмкін!
Dialogue: 0,0:00:43.17,0:00:45.24,Default,,0,0,0,,Ол баяғы құбыжық!
Dialogue: 0,0:00:47.81,0:00:50.71,Default,,0,0,0,,Үкімет бейбақтары құбыжықтарды жіберді!
Dialogue: 0,0:00:51.41,0:00:52.31,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:00:52.38,0:00:53.78,Default,,0,0,0,,Басты көздеңіз! бас!
Dialogue: 0,0:01:03.73,0:01:04.53,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:06.23,0:01:08.80,Default,,0,0,0,,Зеницу, мені ойлама.
Dialogue: 0,0:01:14.14,0:01:16.17,Default,,0,0,0,,Жүр! Өлтір!
Dialogue: 0,0:01:16.24,0:01:17.24,Default,,0,0,0,,мен зұлымдарды әділ сотқа тартуға тырысар ма едім?
Dialogue: 0,0:01:17.84,0:01:23.31,Default,,0,0,0,,(Әскери балалардың айқайы)
Dialogue: 0,0:01:23.41,0:01:24.65,Default,,0,0,0,,Ха ха... Га!
Dialogue: 0,0:01:28.15,0:01:28.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:30.52,0:01:32.62,Default,,0,0,0,,Эй, сәлем...
Dialogue: 0,0:01:33.49,0:01:35.82,Default,,0,0,0,,♬~
Dialogue: 0,0:01:36.09,0:01:36.72,Default,,0,0,0,,Эй
Dialogue: 0,0:01:39.53,0:01:40.33,Default,,0,0,0,,Төмен түспе
Dialogue: 0,0:01:40.40,0:01:41.20,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:01:41.60,0:01:43.57,Default,,0,0,0,,Ол Құдайдың сарбазы! Құдайдың...
Dialogue: 0,0:01:43.63,0:01:45.13,Default,,0,0,0,,Ааааааааааааааааааааааааа...
Dialogue: 0,0:01:45.43,0:01:46.27,Default,,0,0,0,,Төмен түспе!
Dialogue: 0,0:01:46.33,0:01:46.87,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:01:48.24,0:01:49.27,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:49.67,0:01:51.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:56.64,0:02:00.52,Default,,0,0,0,,Хаа… хаа… хаа…
Dialogue: 0,0:02:08.52,0:02:14.73,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:02:15.46,0:02:16.90,Default,,0,0,0,,Құдайдың сарбазы қандай!
Dialogue: 0,0:02:17.17,0:02:20.30,Default,,0,0,0,,Қараңыз! Қараңызшы! Қараңызшы!
Dialogue: 0,0:02:20.87,0:02:23.40,Default,,0,0,0,,Мен Құдайды өлтірдім!
Dialogue: 0,0:02:23.81,0:02:26.14,Default,,0,0,0,,А...
Dialogue: 0,0:02:34.38,0:02:34.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:38.45,0:02:40.82,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:02:41.79,0:02:42.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:48.30,0:02:50.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:50.63,0:02:52.57,Default,,0,0,0,,(Соғыс ұшағы дыбысы)
Dialogue: 0,0:02:55.80,0:02:57.57,Default,,0,0,0,,Асығыңыз! Асығыңыз! Асығыңыз! Асығыңыз!
Dialogue: 0,0:03:02.74,0:03:03.68,Default,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,0:03:49.59,0:03:52.83,Default,,0,0,0,,♪Терең ұйықтай аласыз ба? Сіз жараларыңызды емдедіңіз бе? ♪
Dialogue: 0,0:03:53.29,0:03:54.80,Default,,0,0,0,,♪Себебі түн жалғыз♪
Dialogue: 0,0:03:54.86,0:03:56.60,Default,,0,0,0,,♪Біреуді сүюге өзіңізді мәжбүрлеме♪
Dialogue: 0,0:03:56.93,0:04:00.37,Default,,0,0,0,,♪Тіпті армандап жылау♪
Dialogue: 0,0:04:00.44,0:04:04.97,Default,,0,0,0,,♪Мен ештеңе білмей өлуге тырыстым♪
Dialogue: 0,0:04:05.74,0:04:09.51,Default,,0,0,0,,♪Сен оны жақсы жасырдың ба? Сіз деміңізді ұстадыңыз ба? ♪
Dialogue: 0,0:04:09.91,0:04:11.51,Default,,0,0,0,,♪Себебі қазір ауырады♪
Dialogue: 0,0:04:11.58,0:04:13.28,Default,,0,0,0,,♪Өзіңізді өзгертуге мәжбүрлеме♪
Dialogue: 0,0:04:13.68,0:04:17.35,Default,,0,0,0,,♪Тіпті батыл варвар, тіпті қиналған қозы♪
Dialogue: 0,0:04:17.42,0:04:20.49,Default,,0,0,0,,♪Айналмалы жолдармен өмір сүріп жатырмын♪
Dialogue: 0,0:04:22.72,0:04:24.56,Default,,0,0,0,,♪Көзге түспеу♪
Dialogue: 0,0:04:26.56,0:04:28.80,Default,,0,0,0,,♪ Шыдай алатындай етіп ♪
Dialogue: 0,0:04:30.27,0:04:34.90,Default,,0,0,0,,♪Ойлау процесін әлі тоқтатпа♪
Dialogue: 0,0:04:35.04,0:04:37.04,Default,,0,0,0,,♪Бүгін түнде ҚАШЫҚ ЖҮРГІЗУ♪
Dialogue: 0,0:04:37.34,0:04:39.31,Default,,0,0,0,,♪Өтірік сияқты♪
Dialogue: 0,0:04:39.41,0:04:42.68,Default,,0,0,0,,♪Біреу менің қолымнан ұсташы♪
Dialogue: 0,0:04:42.94,0:04:48.05,Default,,0,0,0,,♪Сіз көре алмайтын ертеңгі күннің келуі міндетті емес♪
Dialogue: 0,0:04:48.62,0:04:52.92,Default,,0,0,0,,♪Енді мен жай ғана ұйықтағым келеді♪
Dialogue: 0,0:05:04.30,0:05:05.50,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:05:22.42,0:05:23.69,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:05:46.61,0:05:49.68,Default,,0,0,0,,Бірыңғай сынақ емтиханы сенбіде, солай ма? Қалыңыз қалай?
Dialogue: 0,0:05:49.74,0:05:51.08,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:05:53.68,0:05:56.08,Default,,0,0,0,,Бұл жолы да үлкен үміт күтуге болады, солай ма?
Dialogue: 0,0:05:56.55,0:05:58.12,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:06:01.62,0:06:02.59,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:06:05.76,0:06:06.83,Default,,0,0,0,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:06:09.76,0:06:11.83,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:12.63,0:06:13.47,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:06:18.04,0:06:20.71,Default,,0,0,0,,Нагай-кун, таңертеңнен бері сабақ оқыдың ба?
Dialogue: 0,0:06:20.81,0:06:23.85,Default,,0,0,0,,Жарайды, бұл бос уақыт.
Dialogue: 0,0:06:24.05,0:06:26.45,Default,,0,0,0,,Мен күткендей дәрігер болғым келеді.
Dialogue: 0,0:06:26.58,0:06:29.42,Default,,0,0,0,,Медициналық мектептегі сынақ емтиханында рейтингте бір таңбалы айырмашылық бар.
Dialogue: 0,0:06:31.49,0:06:34.42,Default,,0,0,0,,Неге сонша мысқылдау керек?
Dialogue: 0,0:06:34.86,0:06:38.46,Default,,0,0,0,,Мен жай ғана жақсы адам болуға тырысамын.
Dialogue: 0,0:06:42.76,0:06:43.43,Default,,0,0,0,,Кай
Dialogue: 0,0:06:47.60,0:06:48.90,Default,,0,0,0,,Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:06:49.80,0:06:52.74,Default,,0,0,0,,Жоқ, сен біртүрлі адамсың.
Dialogue: 0,0:06:54.08,0:06:55.81,Default,,0,0,0,,«Біртүрлі адам» эй
Dialogue: 0,0:06:57.04,0:06:59.88,Default,,0,0,0,,Мүмкін бұл «Аджин» болған шығар?
Dialogue: 0,0:07:00.05,0:07:02.45,Default,,0,0,0,,Мен олардың бір адам екеніне сене алар емеспін.
Dialogue: 0,0:07:03.12,0:07:05.19,Default,,0,0,0,,Мұның бізге еш қатысы жоқ.
Dialogue: 0,0:07:07.89,0:07:10.96,Default,,0,0,0,,Оқулық 247 бет
Dialogue: 0,0:07:11.09,0:07:13.46,Default,,0,0,0,,Деми-адамдардың ашылуына қатысты
Dialogue: 0,0:07:13.86,0:07:16.03,Default,,0,0,0,,Бұл аймақтың емтиханға еш қатысы жоқ...
Dialogue: 0,0:07:16.16,0:07:17.80,Default,,0,0,0,,Оны елемеу дұрыс. (Мұғалім) Жалпы білім ретінде...
Dialogue: 0,0:07:17.87,0:07:19.87,Default,,0,0,0,,Бұл сіз білуіңіз керек бөлік.
Dialogue: 0,0:07:20.13,0:07:24.91,Default,,0,0,0,,Барлығына белгілі, деми-адамдар өлмейтін тіршілік иелері.
Dialogue: 0,0:07:25.77,0:07:28.14,Default,,0,0,0,,Өлмейсің дейді.
Dialogue: 0,0:07:28.61,0:07:30.85,Default,,0,0,0,,Бұл рас па, жоқ па, білмеймін.
Dialogue: 0,0:07:31.15,0:07:36.02,Default,,0,0,0,,Сондай-ақ олардың ерекше дауыс шығарғаны туралы мәліметтер бар.
Dialogue: 0,0:07:36.78,0:07:38.09,Default,,0,0,0,,Көпшілікке ашық...
Dialogue: 0,0:07:38.15,0:07:40.89,Default,,0,0,0,,Бұл жарты адам эксперименті.
Dialogue: 0,0:07:40.99,0:07:44.49,Default,,0,0,0,,Эксперимент? Бұл бәрібір жалған
Dialogue: 0,0:07:45.86,0:07:50.50,Default,,0,0,0,,Деми-адамдар алғаш рет Африкада 17 жыл бұрын расталды.
Dialogue: 0,0:07:51.20,0:07:54.00,Default,,0,0,0,,Балалар, дәл сол жылы туылғансыңдар.
Dialogue: 0,0:07:55.57,0:07:59.77,Default,,0,0,0,,Бұл өлмес сарбаз болды, ол жергілікті жерде «Құдайдың солдаты» деп аталады.
Dialogue: 0,0:08:00.24,0:08:03.78,Default,,0,0,0,,Бұл АҚШ әскері оны басып алған кезде дәлелденді.
Dialogue: 0,0:08:04.48,0:08:06.78,Default,,0,0,0,,Оны жасыру әрекеті болған сияқты, бірақ...
Dialogue: 0,0:08:06.85,0:08:09.48,Default,,0,0,0,,Істің ауыр болғаны сонша, ол бірден әшкере болды.
Dialogue: 0,0:08:09.78,0:08:12.19,Default,,0,0,0,,Қазіргі уақытта әлемде 46 дене
Dialogue: 0,0:08:12.25,0:08:15.66,Default,,0,0,0,,Жапонияда екі деми адам расталды, бірақ...
Dialogue: 0,0:08:15.76,0:08:18.79,Default,,0,0,0,,Ашылмаған демиадамдар бар шығар.
Dialogue: 0,0:08:19.03,0:08:22.20,Default,,0,0,0,,Өлгенше білмейсің ғой.
Dialogue: 0,0:08:22.60,0:08:27.70,Default,,0,0,0,,Дәл қазір бұл жерде деми-адамның болу мүмкіндігі нөлге тең емес.
Dialogue: 0,0:08:30.74,0:08:31.74,Default,,0,0,0,,Ватанабе мырза
Dialogue: 0,0:08:32.94,0:08:34.61,Default,,0,0,0,,Сіз жарты адамды ұстаған кезде—
Dialogue: 0,0:08:34.68,0:08:37.98,Default,,0,0,0,,Қомақты ақшалай сыйлық алуға болады деп естідім.
Dialogue: 0,0:08:38.91,0:08:43.22,Default,,0,0,0,,Сыйлық қауесет болуы мүмкін, бірақ мен қандай да бір сыйлық болатынына сенімдімін.
Dialogue: 0,0:08:43.85,0:08:46.12,Default,,0,0,0,,Мысалы, олжа аулау кезінде...
Dialogue: 0,0:08:46.19,0:08:46.99,Default,,0,0,0,,Жыртқыш?
Dialogue: 0,0:08:48.02,0:08:48.79,Default,,0,0,0,,Ах
Dialogue: 0,0:08:49.19,0:08:50.79,Default,,0,0,0,,Нагай-кун, бұл не?
Dialogue: 0,0:08:52.53,0:08:55.16,Default,,0,0,0,,Е, жоқ, ештеңе.
Dialogue: 0,0:08:55.23,0:08:56.86,Default,,0,0,0,,Сұрақтарыңыз бар ма?
Dialogue: 0,0:09:01.17,0:09:04.81,Default,,0,0,0,,Мм... деми-адамдар адам емес пе?
Dialogue: 0,0:09:05.01,0:09:05.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:06.81,0:09:07.94,Default,,0,0,0,,Л-Ллойд, қарашы…
Dialogue: 0,0:09:09.98,0:09:11.11,Default,,0,0,0,,...Олай емес пе?
Dialogue: 0,0:09:12.25,0:09:13.21,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:09:13.28,0:09:15.78,Default,,0,0,0,,Әрі қарай, деми-адамдардың пайдалы құндылығы туралы сөйлесейік...
Dialogue: 0,0:09:15.85,0:09:17.18,Default,,0,0,0,,Хаха...
Dialogue: 0,0:09:38.94,0:09:42.24,Default,,0,0,0,,Біз де достық қарым-қатынасымызды белгілі бір деңгейде сақтауымыз керек.
Dialogue: 0,0:09:48.25,0:09:49.98,Default,,0,0,0,,Деми-адам эксперименттері
Dialogue: 0,0:09:57.76,0:09:59.36,Default,,0,0,0,,Уау, бұл қорқынышты
Dialogue: 0,0:10:00.19,0:10:01.36,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:05.73,0:10:07.30,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:10:07.60,0:10:08.97,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:10:09.64,0:10:11.67,Default,,0,0,0,,Бұл бала неліктен өлді?
Dialogue: 0,0:10:11.81,0:10:14.18,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:10:14.28,0:10:17.65,Default,,0,0,0,,Анам бұл ақаулы өнім екенін айтты.
Dialogue: 0,0:10:18.98,0:10:21.05,Default,,0,0,0,,Егер ол ақаулы өнім болса, мен өлемін бе?
Dialogue: 0,0:10:21.28,0:10:23.72,Default,,0,0,0,,Амал жоқ, ауырдым.
Dialogue: 0,0:10:26.65,0:10:29.29,Default,,0,0,0,,Ойланып қарашы, неге өлесің?
Dialogue: 0,0:10:30.86,0:10:33.06,Default,,0,0,0,,Өлмесең де...
Dialogue: 0,0:10:36.40,0:10:37.20,Default,,0,0,0,,Кім?
Dialogue: 0,0:10:37.93,0:10:41.00,Default,,0,0,0,,Тағы... өлімге...
Dialogue: 0,0:10:41.34,0:10:42.24,Default,,0,0,0,,Ха...
Dialogue: 0,0:10:43.94,0:10:45.67,Default,,0,0,0,,Бұл... Бұл...
Dialogue: 0,0:10:48.11,0:10:48.84,Default,,0,0,0,,Ах
Dialogue: 0,0:10:50.95,0:10:52.68,Default,,0,0,0,,(түсіру қоңырауының дыбысы)
Dialogue: 0,0:10:59.22,0:11:01.42,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:11:02.09,0:11:03.36,Default,,0,0,0,,Жаман емес
Dialogue: 0,0:11:03.89,0:11:05.93,Default,,0,0,0,,Егер мен жақсы болсам, мен мұнда болмас едім.
Dialogue: 0,0:11:06.36,0:11:08.33,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:11:09.86,0:11:11.70,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:11:11.83,0:11:13.83,Default,,0,0,0,,Бұл жолы қыспақ мектеп емес пе?
Dialogue: 0,0:11:13.97,0:11:17.17,Default,,0,0,0,,Кішкентай кезіңізде ит қабірін жасадыңыз ба?
Dialogue: 0,0:11:17.87,0:11:19.37,Default,,0,0,0,,Сол кез есіңде ме?
Dialogue: 0,0:11:20.01,0:11:21.31,Default,,0,0,0,,Есіңізде бірдеңе болса...
Dialogue: 0,0:11:21.38,0:11:23.78,Default,,0,0,0,,Хэхе, күткендей.
Dialogue: 0,0:11:24.81,0:11:27.42,Default,,0,0,0,,Мақсатың болмаса, келмейсің.
Dialogue: 0,0:11:30.72,0:11:33.09,Default,,0,0,0,,Сіз Кай мырзаны жақында кездестірдіңіз бе?
Dialogue: 0,0:11:33.19,0:11:36.32,Default,,0,0,0,,Не? Жоқ, мен сені кездестірген жоқпын.
Dialogue: 0,0:11:38.09,0:11:39.43,Default,,0,0,0,,Мен Кай мырзамен танысқым келеді
Dialogue: 0,0:11:44.33,0:11:45.47,Default,,0,0,0,,Сіз қалай ойлайсыз? Кай
Dialogue: 0,0:11:46.03,0:11:47.07,Default,,0,0,0,,Мен оны ұстадым!
Dialogue: 0,0:11:48.07,0:11:51.14,Default,,0,0,0,,Керемет! Бұл ара тісті бұғы қоңызы!
Dialogue: 0,0:11:52.07,0:11:54.41,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:11:55.84,0:11:58.88,Default,,0,0,0,,Кей-чан, телефоныңды анаңа бер.
Dialogue: 0,0:11:59.45,0:12:00.71,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:12:00.78,0:12:02.42,Default,,0,0,0,,Мен Кайтоның мекенжайын жоямын.
Dialogue: 0,0:12:03.42,0:12:07.72,Default,,0,0,0,,Жақсы адам болғың келсе, кездесіп жүрген адамдарды таңда.
Dialogue: 0,0:12:11.36,0:12:13.76,Default,,0,0,0,,Біз сондай жақсы достар едік
Dialogue: 0,0:12:14.46,0:12:17.16,Default,,0,0,0,,Мен қазір көп нәрсемен айналысамын...
Dialogue: 0,0:12:17.23,0:12:19.90,Default,,0,0,0,,Тамаша боласың, аға.
Dialogue: 0,0:12:20.77,0:12:23.10,Default,,0,0,0,,Білесің бе, Эрико, шынымен есіңде жоқ па?
Dialogue: 0,0:12:23.40,0:12:24.34,Default,,0,0,0,,Мен иттің қабірін жасағанда...
Dialogue: 0,0:12:24.41,0:12:26.27,Default,,0,0,0,,Бұрынғы нәрселер есімде жоқ.
Dialogue: 0,0:12:27.81,0:12:29.98,Default,,0,0,0,,Енді үйге баруым керек пе? Сіз бос емессіз бе?
Dialogue: 0,0:12:31.25,0:12:33.08,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:12:40.02,0:12:42.42,Default,,0,0,0,,Нагай мырза, қан алу керек.
Dialogue: 0,0:12:44.02,0:12:45.46,Default,,0,0,0,,Әдемі екен.
Dialogue: 0,0:12:45.76,0:12:46.89,Default,,0,0,0,,Оны тастаңыз
Dialogue: 0,0:12:52.00,0:12:53.77,Default,,0,0,0,,«Жақсы адам бол»
Dialogue: 0,0:12:54.40,0:12:57.04,Default,,0,0,0,,Осы мақсатта тек қажет нәрсені ғана жасаңыз—
Dialogue: 0,0:12:57.34,0:12:59.07,Default,,0,0,0,,Сізге қажет нәрсені ғана таңдаңыз...
Dialogue: 0,0:13:01.08,0:13:05.01,Default,,0,0,0,,Сонымен... Әй, Нағай-күн!
Dialogue: 0,0:13:05.35,0:13:06.98,Default,,0,0,0,,Не қажет емес...
Dialogue: 0,0:13:07.11,0:13:08.85,Default,,0,0,0,,Иә? Нагай-кун?
Dialogue: 0,0:13:09.12,0:13:10.95,Default,,0,0,0,,Мен оны қысқартуым керек
Dialogue: 0,0:13:13.49,0:13:14.92,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:18.49,0:13:19.23,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:13:26.57,0:13:28.20,Default,,0,0,0,,А... а...
Dialogue: 0,0:13:41.85,0:13:43.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:44.05,0:13:46.82,Default,,0,0,0,,Бағдаршам қызыл жанды, солай ма?
Dialogue: 0,0:13:47.12,0:13:49.16,Default,,0,0,0,,Секірген бала кінәлі! ?
Dialogue: 0,0:13:49.82,0:13:50.56,Default,,0,0,0,,Бұл жазатайым оқиға болды ма?
Dialogue: 0,0:13:51.36,0:13:52.19,Default,,0,0,0,,Е...
Dialogue: 0,0:13:56.43,0:13:58.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:12.61,0:14:16.02,Default,,0,0,0,,Ах… Ах… Ах…
Dialogue: 0,0:14:18.92,0:14:20.89,Default,,0,0,0,,Жоқ... жоқ...
Dialogue: 0,0:14:21.92,0:14:22.92,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:24.26,0:14:25.06,Default,,0,0,0,,Деми-адам?
Dialogue: 0,0:14:25.13,0:14:26.46,Default,,0,0,0,,А... бұл жарты адам.
Dialogue: 0,0:14:26.53,0:14:29.26,Default,,0,0,0,,Мен бұл шынымен болғанына сене алмаймын ...
Dialogue: 0,0:14:30.50,0:14:32.30,Default,,0,0,0,,Кешіріңіз, мен жасырын жолаушымын.
Dialogue: 0,0:14:32.97,0:14:33.90,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:34.17,0:14:36.34,Default,,0,0,0,,Бұл... мен...
Dialogue: 0,0:14:37.10,0:14:38.31,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:14:38.91,0:14:41.04,Default,,0,0,0,,Адам... Менмін!
Dialogue: 0,0:14:41.44,0:14:44.35,Default,,0,0,0,,А... аа, мен сенемін...
Dialogue: 0,0:14:45.15,0:14:47.28,Default,,0,0,0,,Достар... солай ма?
Dialogue: 0,0:14:47.62,0:14:48.35,Default,,0,0,0,,Га
Dialogue: 0,0:14:49.15,0:14:50.32,Default,,0,0,0,,Үлкен ақшалай сыйлық...
Dialogue: 0,0:14:50.38,0:14:51.39,Default,,0,0,0,,Сен адам емессің бе?
Dialogue: 0,0:14:51.45,0:14:52.35,Default,,0,0,0,,Л-Ллойд, қарашы…
Dialogue: 0,0:14:54.02,0:14:59.23,Default,,0,0,0,,Шыу!
Dialogue: 0,0:15:01.53,0:15:02.43,Default,,0,0,0,,Дене...
Dialogue: 0,0:15:05.20,0:15:06.67,Default,,0,0,0,,Жылжыту... емес...
Dialogue: 0,0:15:07.90,0:15:08.64,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:15:10.44,0:15:11.34,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:12.21,0:15:13.21,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:16.54,0:15:18.11,Default,,0,0,0,,
Dialogue: 0,0:15:18.21,0:15:21.08,Default,,0,0,0,,Бұл жай ғана оқыс оқиға емес!
Dialogue: 0,0:15:21.45,0:15:23.18,Default,,0,0,0,,Деми-адам, жарты-адам!
Dialogue: 0,0:15:24.15,0:15:26.15,Default,,0,0,0,,О, сен, маған бір сәт болады ма?
Dialogue: 0,0:15:26.29,0:15:28.42,Default,,0,0,0,,Кей Нагай деген адамды білесіз бе?
Dialogue: 0,0:15:29.26,0:15:29.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:30.96,0:15:32.99,Default,,0,0,0,,Мен мүлде білмеймін
Dialogue: 0,0:15:33.53,0:15:35.26,Default,,0,0,0,,Сіз не істедіңіз? Сол
Dialogue: 0,0:15:35.33,0:15:37.97,Default,,0,0,0,,Эй, бұл бала деми адамға ұқсайды.
Dialogue: 0,0:15:38.07,0:15:39.03,Default,,0,0,0,,A-J-N! (Офицер) Эй...
Dialogue: 0,0:15:39.10,0:15:42.17,Default,,0,0,0,,Бұл рас! Қайта тірілгенде не көрдіңіз?
Dialogue: 0,0:15:42.27,0:15:44.47,Default,,0,0,0,,Хмм, мені қызықтырмайды.
Dialogue: 0,0:15:44.97,0:15:46.54,Default,,0,0,0,,Жоқ, білмесең жақсы.
Dialogue: 0,0:15:50.44,0:15:51.18,Default,,0,0,0,,Кей!
Dialogue: 0,0:15:53.31,0:15:57.25,Default,,0,0,0,,Хаа… хаа… хаа…
Dialogue: 0,0:15:57.62,0:16:00.19,Default,,0,0,0,,Хаа… хаа… хаа…
Dialogue: 0,0:16:03.46,0:16:05.43,Default,,0,0,0,,Хаааааа...
Dialogue: 0,0:16:08.40,0:16:11.40,Default,,0,0,0,,Міне... үйге кетіп қалды.
Dialogue: 0,0:16:13.07,0:16:15.60,Default,,0,0,0,,Қайда... Мен қайда қашамын?
Dialogue: 0,0:16:37.39,0:16:39.49,Default,,0,0,0,,Біреу біреу...
Dialogue: 0,0:16:41.06,0:16:42.76,Default,,0,0,0,,Жоқ! Қарғыс атқыр...
Dialogue: 0,0:16:47.47,0:16:48.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:50.67,0:16:52.21,Default,,0,0,0,,Кей қара!
Dialogue: 0,0:16:52.41,0:16:53.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:55.18,0:16:55.78,Default,,0,0,0,,Кай…
Dialogue: 0,0:16:59.51,0:17:00.25,Default,,0,0,0,,Ах
Dialogue: 0,0:17:05.29,0:17:08.59,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:17:09.02,0:17:10.76,Default,,0,0,0,,Кей, мен сені күттім.
Dialogue: 0,0:17:11.23,0:17:14.06,Default,,0,0,0,,Кай! О, мен не істеуім керек?
Dialogue: 0,0:17:14.16,0:17:15.30,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:17:15.80,0:17:17.56,Default,,0,0,0,,Сабыр ет, қазір қайдасың?
Dialogue: 0,0:17:18.53,0:17:19.33,Default,,0,0,0,,Енді?
Dialogue: 0,0:17:20.33,0:17:21.17,Default,,0,0,0,,(Иида) Турбо Герой Ингениумды білесің бе?
Dialogue: 0,0:17:22.20,0:17:23.74,Default,,0,0,0,,А, мен сенемін...
Dialogue: 0,0:17:25.04,0:17:28.11,Default,,0,0,0,,Ах, м... бұл...
Dialogue: 0,0:17:28.64,0:17:29.41,Default,,0,0,0,,Кей
Dialogue: 0,0:17:32.21,0:17:33.41,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:17:34.21,0:17:35.08,Default,,0,0,0,,Кай…
Dialogue: 0,0:17:36.22,0:17:38.79,Default,,0,0,0,,(Кішкентай Кей мен Кайтоның күлкісі)
Dialogue: 0,0:17:41.82,0:17:45.33,Default,,0,0,0,,Бірде мен бұғы қоңызын ұстаған ағаштың астында
Dialogue: 0,0:17:46.43,0:17:47.36,Default,,0,0,0,,Қазір мен романтика туралы ойлауға өзімді дайын сезіне алмаймын.
Dialogue: 0,0:18:04.65,0:18:05.35,Default,,0,0,0,,Кай?
Dialogue: 0,0:18:12.45,0:18:13.65,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:14.09,0:18:14.62,Default,,0,0,0,,Ах
Dialogue: 0,0:18:15.56,0:18:17.69,Default,,0,0,0,,Демиадамдарды табу Қолдау сұрау
Dialogue: 0,0:18:18.63,0:18:20.09,Default,,0,0,0,,Эй, күте тұр! тоқта!
Dialogue: 0,0:18:26.60,0:18:29.50,Default,,0,0,0,,Мен қуып жетуді күте алмаймын! Мен ұсталуды күте алмаймын!
Dialogue: 0,0:18:49.39,0:18:50.72,Default,,0,0,0,,Ия...
Dialogue: 0,0:18:51.89,0:18:53.39,Default,,0,0,0,,Қатты еліктеуге болмайды
Dialogue: 0,0:18:53.69,0:18:55.43,Default,,0,0,0,,Тыныш шығыңыз
Dialogue: 0,0:19:00.37,0:19:01.20,Default,,0,0,0,,А...
Dialogue: 0,0:19:06.41,0:19:07.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:08.41,0:19:11.25,Default,,0,0,0,,Гах... Ааа!
Dialogue: 0,0:19:11.88,0:19:14.55,Default,,0,0,0,,Қозғалмаңыз! Қозғалма
Dialogue: 0,0:19:17.75,0:19:21.16,Default,,0,0,0,,Цуки храмының жанында деми-адамды қорғаңыз Деми-адамды қорғаңыз
Dialogue: 0,0:19:21.22,0:19:21.92,Default,,0,0,0,,Деми-адам…
Dialogue: 0,0:19:22.82,0:19:23.62,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:28.20,0:19:29.20,Default,,0,0,0,,Сәлем! (полицей) хаха
Dialogue: 0,0:19:31.43,0:19:32.60,Default,,0,0,0,,Кай! (Кайто) Ой!
Dialogue: 0,0:19:32.73,0:19:33.83,Default,,0,0,0,,Маған атыңды айтпа
Dialogue: 0,0:19:36.54,0:19:37.54,Default,,0,0,0,,Сіз тұра аласыз ба?
Dialogue: 0,0:19:38.91,0:19:39.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:40.44,0:19:41.28,Default,,0,0,0,,Иә
Dialogue: 0,0:19:44.71,0:19:45.58,Default,,0,0,0,,Жүгірейік
Dialogue: 0,0:19:50.25,0:19:52.25,Default,,0,0,0,,Ах... жарты адам қашып кетті!
Dialogue: 0,0:19:52.35,0:19:54.82,Default,,0,0,0,,Қайталау Деми-адам қашады!
Dialogue: 0,0:19:54.92,0:19:58.49,Default,,0,0,0,,Бір досыңыз болса, тексеруді сұраңыз!
Dialogue: 0,0:20:03.83,0:20:04.63,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:20:04.70,0:20:05.43,Default,,0,0,0,,О
Dialogue: 0,0:20:28.66,0:20:30.62,Default,,0,0,0,,Бұл Әджиннің үйінің алдында.
Dialogue: 0,0:20:30.69,0:20:33.73,Default,,0,0,0,,Үшінші жарты адам Жапонияда табылып, қашып құтылды
Dialogue: 0,0:20:33.89,0:20:36.73,Default,,0,0,0,,Шағын қалада қиыншылық көп
Dialogue: 0,0:20:37.36,0:20:39.57,Default,,0,0,0,,Мен бұл туралы біраз уақыт ойладым.
Dialogue: 0,0:20:39.67,0:20:41.80,Default,,0,0,0,,Тіпті адамға ұқсамайды.
Dialogue: 0,0:21:06.93,0:21:09.03,Default,,0,0,0,,Оны деми-адам деп атаса да, ол жай ғана бала!
Dialogue: 0,0:21:09.30,0:21:12.33,Default,,0,0,0,,Біз бәрібір алысқа бара алмаймыз. Асығыңыз және оны қорғаңыз!
Dialogue: 0,0:21:12.43,0:21:13.83,Default,,0,0,0,,(телефонның қоңырау үні)
Dialogue: 0,0:21:14.43,0:21:15.30,Default,,0,0,0,,
Dialogue: 0,0:21:15.60,0:21:18.84,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз, бұл Сайтама префектуралық полициясынан Араки...
Dialogue: 0,0:21:18.91,0:21:21.64,Default,,0,0,0,,Сіз нәрселерге тым жеңіл қарайсыз.
Dialogue: 0,0:21:22.74,0:21:25.68,Default,,0,0,0,,Айтсаңыз да, іздейтін адамдар жеткілікті...
Dialogue: 0,0:21:25.75,0:21:27.85,Default,,0,0,0,,Бұл ұлттық деңгейдегі мәселе
Dialogue: 0,0:21:29.05,0:21:29.82,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:21:30.05,0:21:33.72,Default,,0,0,0,,Деми-адамдар туралы түсініктің ілгері баспағаны барлық елдерде бірдей.
Dialogue: 0,0:21:33.82,0:21:35.62,Default,,0,0,0,,Егер сіздің епсіздігіңіз...
Dialogue: 0,0:21:35.69,0:21:38.69,Default,,0,0,0,,Кей Нағайды басқа ел алып кететін болса...
Dialogue: 0,0:21:38.99,0:21:40.76,Default,,0,0,0,,Нәтижесін білесіз бе?
Dialogue: 0,0:21:42.56,0:21:43.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:44.46,0:21:45.30,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:21:47.60,0:21:50.74,Default,,0,0,0,,Жеке құрамды екі есе, жоқ, үш есе!
Dialogue: 0,0:21:51.31,0:21:52.91,Default,,0,0,0,,Не қажет болса, оны алыңыз!
Dialogue: 0,0:21:53.97,0:21:56.78,Default,,0,0,0,,Жаңа Аджин Кей Нагай
Dialogue: 0,0:21:58.31,0:21:59.95,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бере алмаймын.
Dialogue: 0,0:22:15.36,0:22:16.86,Default,,0,0,0,,Сіз қуып жетуге шыдай аласыз ба?
Dialogue: 0,0:22:30.88,0:22:36.48,Default,,0,0,0,,♪Егер тілегім орындалса, тағы да♪
Dialogue: 0,0:22:36.98,0:22:42.56,Default,,0,0,0,,♪Мен сенің жүрегіңді қозғағым келеді♪
Dialogue: 0,0:22:42.99,0:22:48.40,Default,,0,0,0,,♪Қанша қараңғы болса да, іздеймін♪
Dialogue: 0,0:22:49.03,0:22:53.60,Default,,0,0,0,,♪Бір ғана шам♪
Dialogue: 0,0:22:54.97,0:22:58.51,Default,,0,0,0,,♪Жұлдыздарға қарағанымда♪
Dialogue: 0,0:22:58.84,0:23:00.57,Default,,0,0,0,,♪Алыс болса да♪
Dialogue: 0,0:23:01.01,0:23:06.41,Default,,0,0,0,,♪Сол бір жұлдызды аспанға қарап♪
Dialogue: 0,0:23:06.88,0:23:12.42,Default,,0,0,0,,♪Жүрегімнің аспанына түсетін сияқты♪
Dialogue: 0,0:23:12.99,0:23:17.12,Default,,0,0,0,,♪Сіздің күлкіңіз бен жылуыңыз♪
Dialogue: 0,0:23:17.52,0:23:18.76,Default,,0,0,0,,♪Мені тыңда♪
Dialogue: 0,0:23:18.89,0:23:23.80,Default,,0,0,0,,♪Кетіп, Жалғыз күндерді көргенше♪
Dialogue: 0,0:23:23.86,0:23:27.07,Default,,0,0,0,,♪Сүйу деген нені білдіреді?♪
Dialogue: 0,0:23:27.40,0:23:30.47,Default,,0,0,0,,♪Мен білемін деп ойладым♪
Dialogue: 0,0:23:31.07,0:23:35.74,Default,,0,0,0,,♪Менің алдымда болғанның бәрін сезіну♪
Dialogue: 0,0:23:35.81,0:23:39.01,Default,,0,0,0,,♪Мен маңызды нәрсені жоғалтып алдым♪
Dialogue: 0,0:23:39.11,0:23:43.12,Default,,0,0,0,,♪Шынайы махаббатты тану♪
Dialogue: 0,0:23:44.92,0:23:48.99,Default,,0,0,0,,♪Мен қазір айтамын, Сен қаншалықты жақынсың♪
Dialogue: 0,0:23:50.49,0:23:56.49,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
