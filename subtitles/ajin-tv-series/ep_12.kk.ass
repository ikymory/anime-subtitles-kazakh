Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.77,0:00:06.50,Default,,0,0,0,,Өздерін маңызды емес деп санайтын адамдар
Dialogue: 0,0:00:07.00,0:00:09.04,Default,,0,0,0,,Соққыға дайындалу
Dialogue: 0,0:00:19.41,0:00:21.28,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:00:24.65,0:00:27.79,Default,,0,0,0,,«Стратегиялар біртүрлі болуы керек».
Dialogue: 0,0:00:28.56,0:00:31.09,Default,,0,0,0,,Мен сені енді кешіруге дайын емеспін
Dialogue: 0,0:00:31.16,0:00:32.19,Default,,0,0,0,,Қалпақ киген адам басып келеді...
Dialogue: 0,0:00:32.26,0:00:33.60,Default,,0,0,0,,Өлтірме! Бұл адам жарты адам!
Dialogue: 0,0:00:33.66,0:00:37.43,Default,,0,0,0,,Жапониядағы деми-адамдардың жағдайы күрт өзгереді.
Dialogue: 0,0:00:37.50,0:00:39.10,Default,,0,0,0,,Менің атым Сато
Dialogue: 0,0:00:39.17,0:00:40.64,Default,,0,0,0,,Біз наразылық акциясын өткіземіз!
Dialogue: 0,0:00:40.77,0:00:43.10,Default,,0,0,0,,Бақыт үшін
Dialogue: 0,0:00:43.17,0:00:47.24,Default,,0,0,0,,Мен өлтіргенді жақсы көремін.
Dialogue: 0,0:00:47.44,0:00:49.34,Default,,0,0,0,,Соңында бастапқы нүкте
Dialogue: 0,0:00:49.41,0:00:52.28,Default,,0,0,0,,Тіпті біз сенімен ұрыспаймыз.
Dialogue: 0,0:00:52.35,0:00:54.25,Default,,0,0,0,,Бұл ұрыс емес
Dialogue: 0,0:00:54.32,0:00:55.72,Default,,0,0,0,,Бұл соғыс.
Dialogue: 0,0:00:57.82,0:01:05.76,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:01:09.33,0:01:10.60,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:01:16.47,0:01:18.44,Default,,0,0,0,,Көпқабатты үй құлады...
Dialogue: 0,0:01:18.51,0:01:20.41,Default,,0,0,0,,Бұл... осылай...
Dialogue: 0,0:01:20.48,0:01:21.54,Default,,0,0,0,,Тозаки мырза...
Dialogue: 0,0:01:22.24,0:01:24.25,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:01:26.25,0:01:27.62,Default,,0,0,0,,Жедел жәрдем әлі бар ма?
Dialogue: 0,0:01:27.68,0:01:29.28,Default,,0,0,0,,Мұнда да жараланғандар бар!
Dialogue: 0,0:01:31.75,0:01:33.76,Default,,0,0,0,,(Дарио) Хе-хе-хе-хе. Эй, қарашы — бұл апат!
Dialogue: 0,0:01:36.49,0:01:38.19,Default,,0,0,0,,Келіңдер, бәрің
Dialogue: 0,0:01:38.63,0:01:42.10,Default,,0,0,0,,Сіз өзіңізді соншалықты ұтқан жоқ деп ойлайсыз, солай ма?
Dialogue: 0,0:01:42.86,0:01:44.33,Default,,0,0,0,,Ал... бұл Сато!
Dialogue: 0,0:01:47.54,0:01:50.14,Default,,0,0,0,,Бұл елдегі ең күшті күш қандай?
Dialogue: 0,0:01:50.54,0:01:52.81,Default,,0,0,0,,Елордалық полиция департаментінің арнайы шабуыл бөлімі
Dialogue: 0,0:01:53.14,0:01:54.44,Default,,0,0,0,,Егер біз оларды жеңе алсақ...
Dialogue: 0,0:01:54.51,0:01:57.58,Default,,0,0,0,,Біз бұл елдегі ең күшті әскерміз.
Dialogue: 0,0:01:57.65,0:02:01.32,Default,,0,0,0,,Бұл шайқасты бүкіл Жапония тамашалайды! Біз жеңілуге ​​шыдай алмаймыз!
Dialogue: 0,0:02:01.38,0:02:02.72,Default,,0,0,0,,Олардың бәрі бірдей
Dialogue: 0,0:02:03.32,0:02:04.49,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:02:06.62,0:02:08.62,Default,,0,0,0,,Көру уақыты
Dialogue: 0,0:02:35.25,0:02:38.45,Default,,0,0,0,,♪Терең ұйықтай аласыз ба? Сіз жараларыңызды емдедіңіз бе? ♪
Dialogue: 0,0:02:38.72,0:02:40.46,Default,,0,0,0,,♪Себебі түн жалғыз♪
Dialogue: 0,0:02:40.52,0:02:42.22,Default,,0,0,0,,♪Біреуді сүюге өзіңізді мәжбүрлеме♪
Dialogue: 0,0:02:42.52,0:02:45.79,Default,,0,0,0,,♪Тіпті армандап жылау♪
Dialogue: 0,0:02:45.86,0:02:50.70,Default,,0,0,0,,♪Мен ештеңе білмей өлуге тырыстым♪
Dialogue: 0,0:02:51.50,0:02:54.90,Default,,0,0,0,,♪Сен оны жақсы жасырдың ба? Сіз деміңізді ұстадыңыз ба? ♪
Dialogue: 0,0:02:55.54,0:02:56.80,Default,,0,0,0,,♪Себебі қазір ауырады♪
Dialogue: 0,0:02:57.24,0:02:58.71,Default,,0,0,0,,♪Өзіңізді өзгертуге мәжбүрлеме♪
Dialogue: 0,0:02:59.27,0:03:02.71,Default,,0,0,0,,♪Тіпті батыл варвар, тіпті қиналған қозы♪
Dialogue: 0,0:03:02.84,0:03:05.91,Default,,0,0,0,,♪Айналмалы жолдармен өмір сүріп жатырмын♪
Dialogue: 0,0:03:08.32,0:03:10.18,Default,,0,0,0,,♪Көзге түспеу♪
Dialogue: 0,0:03:11.95,0:03:14.39,Default,,0,0,0,,♪ Шыдай алатындай етіп ♪
Dialogue: 0,0:03:15.69,0:03:20.26,Default,,0,0,0,,♪Ойлау процесін әлі тоқтатпа♪
Dialogue: 0,0:03:20.66,0:03:22.66,Default,,0,0,0,,♪Бүгін түнде ҚАШЫҚ ЖҮРГІЗУ♪
Dialogue: 0,0:03:22.73,0:03:24.53,Default,,0,0,0,,♪Өтірік сияқты♪
Dialogue: 0,0:03:24.80,0:03:28.30,Default,,0,0,0,,♪Біреу менің қолымнан ұсташы♪
Dialogue: 0,0:03:28.54,0:03:33.61,Default,,0,0,0,,♪Сіз көре алмайтын ертеңгі күннің келуі міндетті емес♪
Dialogue: 0,0:03:34.21,0:03:38.38,Default,,0,0,0,,♪Енді мен жай ғана ұйықтағым келеді♪
Dialogue: 0,0:03:51.93,0:03:54.90,Default,,0,0,0,,Ағымдағы кадрлар Grant Pharmaceuticals компаниясының жанында.
Dialogue: 0,0:03:54.96,0:03:56.83,Default,,0,0,0,,Хатори ғимараты осылайша құлады.
Dialogue: 0,0:03:57.80,0:03:59.90,Default,,0,0,0,,Хатори ғимараты жаңа белгі ретінде
Dialogue: 0,0:03:59.97,0:04:02.44,Default,,0,0,0,,Бұл жақында ғана ашылған көпқабатты үй.
Dialogue: 0,0:04:04.81,0:04:07.78,Default,,0,0,0,,Ал мынау жаншылып құлады.
Dialogue: 0,0:04:07.84,0:04:09.94,Default,,0,0,0,,Гранттық фармацевтикалық препараттардың ағымдағы жағдайы
Dialogue: 0,0:04:25.56,0:04:27.70,Default,,0,0,0,,Жағдай аздап түсініксіз, бірақ...
Dialogue: 0,0:04:27.76,0:04:30.70,Default,,0,0,0,,Стратегия жоспарына сәйкес, оны бағындырыңыз
Dialogue: 0,0:04:31.33,0:04:32.43,Default,,0,0,0,,Өзіңізді орналастырыңыз!
Dialogue: 0,0:04:49.05,0:04:52.99,Default,,0,0,0,,Арнайы талшықты сауыт пен дулыға...
Dialogue: 0,0:04:54.46,0:04:58.89,Default,,0,0,0,,Жақын қашықтықта болмаса, шолақ мылтықпен ату мүмкін емес.
Dialogue: 0,0:05:02.36,0:05:03.90,Default,,0,0,0,,екінші Кира тек бет-әлпетке қарап кісі өлтіре алатынын көрсетеді.
Dialogue: 0,0:05:05.63,0:05:07.84,Default,,0,0,0,,Бұл соғыс
Dialogue: 0,0:05:13.54,0:05:15.38,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,0:05:16.68,0:05:19.78,Default,,0,0,0,,Бәлкім, оны бүкіл халық көреді.
Dialogue: 0,0:05:25.42,0:05:28.52,Default,,0,0,0,,Сіз көріп отырған нәрсе - көріністің үстінде түсірілген сурет.
Dialogue: 0,0:05:29.36,0:05:32.73,Default,,0,0,0,,Биліктен бұл оқиғаға қатысты әзірге ешқандай мәлімдеме болған жоқ...
Dialogue: 0,0:05:32.93,0:05:36.46,Default,,0,0,0,,Қылмысты өзін Сато деп атайтын адам жасаған болуы ықтимал.
Dialogue: 0,0:05:36.83,0:05:39.97,Default,,0,0,0,,Бұл компания да твиттер жазбайды.
Dialogue: 0,0:05:40.44,0:05:43.87,Default,,0,0,0,,Бұл міндетті түрде банкроттыққа әкеледі.
Dialogue: 0,0:05:44.37,0:05:47.81,Default,,0,0,0,,Деми-адамдарға одан құтылуға мүмкіндік беру дұрыс емес.
Dialogue: 0,0:05:48.41,0:05:50.98,Default,,0,0,0,,Олар аң сияқты
Dialogue: 0,0:05:51.95,0:05:53.08,Default,,0,0,0,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,0:05:53.92,0:05:55.65,Default,,0,0,0,,Ах Кита-сан
Dialogue: 0,0:05:56.75,0:05:59.02,Default,,0,0,0,,Сіздің қорқынышты бетіңіз не болды?
Dialogue: 0,0:05:59.09,0:06:02.42,Default,,0,0,0,,Сіз тағы да Яманака мырзаның немересі туралы айтып отырсыз ба?
Dialogue: 0,0:06:02.62,0:06:05.79,Default,,0,0,0,,Мен мұны талай рет айттым, бірақ мен оған сене аламын.
Dialogue: 0,0:06:06.59,0:06:07.53,Default,,0,0,0,,Эй, эй...
Dialogue: 0,0:06:07.76,0:06:09.70,Default,,0,0,0,,Жаңа ақпарат келді
Dialogue: 0,0:06:10.00,0:06:12.87,Default,,0,0,0,,Интернетте өзін Сато деп атайтын адамның видеосы бар.
Dialogue: 0,0:06:12.93,0:06:14.74,Default,,0,0,0,,Таратылып жатқаны туралы ақпарат
Dialogue: 0,0:06:15.10,0:06:18.51,Default,,0,0,0,,“Адзин.net” “Тікелей трансляция”?
Dialogue: 0,0:06:20.01,0:06:22.94,Default,,0,0,0,,Таратылым құлаған жердің ішінен шыққан сияқты.
Dialogue: 0,0:06:23.38,0:06:24.55,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:06:24.88,0:06:27.08,Default,,0,0,0,,Не... не болды?
Dialogue: 0,0:06:27.55,0:06:31.05,Default,,0,0,0,,Бұл компанияны білсеңіз де...
Dialogue: 0,0:06:33.02,0:06:35.16,Default,,0,0,0,,Маған адам қарамайды.
Dialogue: 0,0:06:35.96,0:06:36.99,Default,,0,0,0,,Ақша!
Dialogue: 0,0:06:37.63,0:06:38.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:38.76,0:06:42.10,Default,,0,0,0,,Тамаша компаниялар үшін акциялардың бағасы тұрақты...
Dialogue: 0,0:06:42.60,0:06:44.87,Default,,0,0,0,,Менің естігенім осы!
Dialogue: 0,0:06:44.93,0:06:46.60,Default,,0,0,0,,Кита-сан, сәл сабыр ет...
Dialogue: 0,0:06:46.67,0:06:47.70,Default,,0,0,0,,Шулы!
Dialogue: 0,0:06:49.80,0:06:55.44,Default,,0,0,0,,Мен барлық зейнетақымды және жинақ ақшамды Грант фармацевтикасына салдым!
Dialogue: 0,0:06:56.41,0:06:57.04,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:06:58.75,0:06:59.85,Default,,0,0,0,,Кита-сан!
Dialogue: 0,0:07:00.05,0:07:02.58,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:07:03.05,0:07:03.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:15.03,0:07:16.90,Default,,0,0,0,,Оны қалай ұйықтатпақсың?
Dialogue: 0,0:07:16.96,0:07:19.63,Default,,0,0,0,,Бұл ғылыми-зерттеу институтында болған оқиғаның қайталануы емес пе?
Dialogue: 0,0:07:19.80,0:07:21.70,Default,,0,0,0,,Транквилизатор пайдаланылмаған
Dialogue: 0,0:07:22.14,0:07:24.84,Default,,0,0,0,,Транквилизаторды қолдану заңсыз.
Dialogue: 0,0:07:24.97,0:07:28.58,Default,,0,0,0,,«Тая» сияқты, оны көпшілік алдында пайдалану мүмкін емес.
Dialogue: 0,0:07:28.88,0:07:29.61,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:29.74,0:07:32.58,Default,,0,0,0,,Бейнебаян да таратылса жақсы болар еді.
Dialogue: 0,0:07:32.88,0:07:34.05,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:07:34.15,0:07:37.15,Default,,0,0,0,,Олар аң қашып кеткенде тыныштандыратын мылтық қолданатын шығар!
Dialogue: 0,0:07:37.49,0:07:38.69,Default,,0,0,0,,Бұл ветеринарлар, т.б.
Dialogue: 0,0:07:38.75,0:07:41.46,Default,,0,0,0,,Білікті адамдардан ынтымақтастықты сұрау
Dialogue: 0,0:07:41.82,0:07:43.69,Default,,0,0,0,,Деми-адамдарды ұстауға да қатысты.
Dialogue: 0,0:07:43.76,0:07:44.63,Default,,0,0,0,,Және...
Dialogue: 0,0:07:45.46,0:07:48.76,Default,,0,0,0,,Лабораторияға шабуыл жасалған кездегі жағдай басқаша.
Dialogue: 0,0:07:48.90,0:07:53.50,Default,,0,0,0,,Енді «Шинья Накамура оқиғасы» ... «су тасқыны құбылысы» жоқ.
Dialogue: 0,0:07:54.47,0:07:57.14,Default,,0,0,0,,Сізге деми-адамды өлтіру түрткі болды...
Dialogue: 0,0:07:57.21,0:08:00.51,Default,,0,0,0,,Сіз бұл оқиға болады деп күткен сияқтысыз.
Dialogue: 0,0:08:00.74,0:08:04.05,Default,,0,0,0,,Бұл аздап... үлкен қателік.
Dialogue: 0,0:08:04.21,0:08:07.18,Default,,0,0,0,,Бұл құбылысты «су тасқыны» деп атаймыз.
Dialogue: 0,0:08:07.78,0:08:11.12,Default,,0,0,0,,Егер әдеттен тыс күшейген эмоциялар мен қайта тірілу сәйкес келсе -
Dialogue: 0,0:08:11.49,0:08:13.92,Default,,0,0,0,,Бұл өте сирек кездесетін құбылыс.
Dialogue: 0,0:08:14.99,0:08:18.79,Default,,0,0,0,,Енді біз жарты адамдарды өлтіру мен Топан су құбылысы бір-бірімен байланысты емес екенін білеміз ...
Dialogue: 0,0:08:19.13,0:08:21.16,Default,,0,0,0,,Бір ғана әдісті қабылдау керек
Dialogue: 0,0:08:21.53,0:08:25.10,Default,,0,0,0,,Хмф! Сіз соншалықты сақ болсаңыз да, оны өлтірдіңіз бе?
Dialogue: 0,0:08:25.17,0:08:26.07,Default,,0,0,0,,«Золушка» сұлулық салонына қош келдіңіз.
Dialogue: 0,0:08:26.90,0:08:27.74,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:08:32.24,0:08:33.88,Default,,0,0,0,,Өлтіруді жалғастырыңыз
Dialogue: 0,0:08:49.52,0:08:49.96,Default,,0,0,0,,Жаса!
Dialogue: 0,0:08:50.22,0:08:50.86,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:08:51.16,0:08:51.93,Default,,0,0,0,,Не! ?
Dialogue: 0,0:08:52.06,0:08:52.86,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:08:55.13,0:08:56.56,Default,,0,0,0,,Әр топ алға шығады!
Dialogue: 0,0:09:01.17,0:09:03.20,Default,,0,0,0,,Сіз стратегияңызды өзгерттіңіз, Тозаки...
Dialogue: 0,0:09:03.27,0:09:03.91,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:03.97,0:09:05.97,Default,,0,0,0,,2-ші команданы жүктеу 3-ші командаға ауысу
Dialogue: 0,0:09:07.24,0:09:08.21,Default,,0,0,0,,3-ші топ ату
Dialogue: 0,0:09:09.58,0:09:13.11,Default,,0,0,0,,Әр 3 секунд сайын түсіруді жалғастырыңыз. Ешқашан оған қайта тірілуге ​​мүмкіндік бермеңіз!
Dialogue: 0,0:09:14.85,0:09:15.72,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:16.75,0:09:17.55,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:32.67,0:09:35.90,Default,,0,0,0,,Мылтық ату. Оқиға орнында біраз уақыттан бері атыс естіліп жатыр.
Dialogue: 0,0:09:38.67,0:09:40.58,Default,,0,0,0,,Сіз ғимаратты бомбалаған адамсыз ба?
Dialogue: 0,0:09:40.94,0:09:44.01,Default,,0,0,0,,Көру нашар, бірақ полиция көп...
Dialogue: 0,0:09:44.08,0:09:47.21,Default,,0,0,0,,Ал мен кінәліге ұқсайтын фигураны көріп тұрмын.
Dialogue: 0,0:09:48.25,0:09:48.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:50.28,0:09:53.02,Default,,0,0,0,,Полицейлер қылмыскерді атып жатқан сияқты!
Dialogue: 0,0:09:55.92,0:09:57.93,Default,,0,0,0,,Бұл деми адамдарға қарсы стратегия ма?
Dialogue: 0,0:09:58.06,0:10:00.73,Default,,0,0,0,,Айналадағы полиция оқ жаудыруда.
Dialogue: 0,0:10:03.10,0:10:08.14,Default,,0,0,0,,Енді стратегия сәтті бола ма? көзілдірік
Dialogue: 0,0:10:17.04,0:10:18.78,Default,,0,0,0,,Қылмыскер құлады
Dialogue: 0,0:10:19.28,0:10:21.88,Default,,0,0,0,,Мылтық дыбыстары тоқтау белгілерін көрсетпейді. Қылмыскер қарсылық көрсете алмаған сияқты...
Dialogue: 0,0:10:21.95,0:10:23.78,Default,,0,0,0,,Жақсы... жасаңыз!
Dialogue: 0,0:10:28.66,0:10:30.83,Default,,0,0,0,,Полиция күші өте күшті.
Dialogue: 0,0:10:31.09,0:10:34.06,Default,,0,0,0,,Бағындырылған жарты адам Сато ма?
Dialogue: 0,0:10:35.66,0:10:37.20,Default,,0,0,0,,Сақтығыңызды төмендетпеңіз
Dialogue: 0,0:10:39.93,0:10:41.07,Default,,0,0,0,,Сіз соққыға ұшырайсыз.
Dialogue: 0,0:10:48.04,0:10:48.91,Default,,0,0,0,,Зембіл!
Dialogue: 0,0:10:51.75,0:10:52.35,Default,,0,0,0,,Жарайды, атқа мінейік.
Dialogue: 0,0:10:55.08,0:10:56.28,Default,,0,0,0,,Асығыңыз! Асығыңыз!
Dialogue: 0,0:10:58.15,0:10:59.12,Default,,0,0,0,,Ұстау аяқталды!
Dialogue: 0,0:10:59.22,0:10:59.95,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:11:01.32,0:11:03.22,Default,,0,0,0,,Мен сені өлтіріп жатқанда конвойға апарамын!
Dialogue: 0,0:11:25.81,0:11:28.22,Default,,0,0,0,,Бұл қалпақ қозғалмайды...
Dialogue: 0,0:11:28.88,0:11:30.82,Default,,0,0,0,,Өте оңай...
Dialogue: 0,0:11:31.29,0:11:32.32,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:11:32.99,0:11:34.79,Default,,0,0,0,,20 SAT мүшесі
Dialogue: 0,0:11:35.19,0:11:37.69,Default,,0,0,0,,Күзетшілермен жұмыс істеуден басқа жағдай.
Dialogue: 0,0:11:43.20,0:11:46.87,Default,,0,0,0,,Ол адамдарды тым төмен бағалады.
Dialogue: 0,0:11:56.44,0:11:58.05,Default,,0,0,0,,Өлмесең...
Dialogue: 0,0:11:59.15,0:12:01.78,Default,,0,0,0,,Оған өмірге қайта келуге мүмкіндік бермеңіз
Dialogue: 0,0:12:07.82,0:12:10.09,Default,,0,0,0,,Мұқият жүріңіз! Конвой жақында келеді!
Dialogue: 0,0:12:11.96,0:12:13.96,Default,,0,0,0,,4-топты жүктеу 1-командаға ауысу!
Dialogue: 0,0:12:14.03,0:12:14.76,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:12:15.46,0:12:16.33,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:12:18.97,0:12:20.33,Default,,0,0,0,,
Dialogue: 0,0:12:21.77,0:12:23.40,Default,,0,0,0,,Досым, бізді атып жатыр!
Dialogue: 0,0:12:26.91,0:12:28.04,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:12:29.01,0:12:31.01,Default,,0,0,0,,Оң жақ 2 миль реттеу
Dialogue: 0,0:12:31.28,0:12:32.95,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:36.52,0:12:38.19,Default,,0,0,0,,Қорғаныс тобының қалқаны!
Dialogue: 0,0:12:43.12,0:12:44.16,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:12:45.26,0:12:46.93,Default,,0,0,0,,Ген-кун! Такахаши-кун!
Dialogue: 0,0:12:47.29,0:12:48.90,Default,,0,0,0,,Цубаки горилла емес—
Dialogue: 0,0:12:53.27,0:12:54.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:54.84,0:12:56.54,Default,,0,0,0,,Мынаны тірілтпе!
Dialogue: 0,0:12:56.97,0:12:58.37,Default,,0,0,0,,Мергенге бірдеңе жасаңыз!
Dialogue: 0,0:13:00.07,0:13:01.81,Default,,0,0,0,,Бұғаулар алынып тасталды.
Dialogue: 0,0:13:01.91,0:13:04.28,Default,,0,0,0,,Енді бізге тек жаңғыруға жол ашу ғана қалды...
Dialogue: 0,0:13:04.35,0:13:05.08,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:05.98,0:13:06.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:12.32,0:13:15.26,Default,,0,0,0,,Бұл мерген 01. Нысананың жарты адам екені расталды.
Dialogue: 0,0:13:15.99,0:13:18.09,Default,,0,0,0,,10 сағат бағыты Бұл көп пәтерлі үйдің төбесінде.
Dialogue: 0,0:13:18.26,0:13:20.86,Default,,0,0,0,,Мерген 02 Нысананы растау
Dialogue: 0,0:13:21.36,0:13:24.06,Default,,0,0,0,,Мерген 03 Нысананы растау
Dialogue: 0,0:13:24.23,0:13:26.07,Default,,0,0,0,,Жарайды, өлтіре бер.
Dialogue: 0,0:13:26.23,0:13:27.20,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:32.94,0:13:34.48,Default,,0,0,0,,Жаудың мергенін залалсыздандыру
Dialogue: 0,0:13:35.08,0:13:36.84,Default,,0,0,0,,Жарайды, тасымалдауды жалғастырыңыз.
Dialogue: 0,0:13:41.15,0:13:41.88,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:41.95,0:13:43.52,Default,,0,0,0,,Асығыңыз! Жақында
Dialogue: 0,0:13:50.36,0:13:51.83,Default,,0,0,0,,Басқа адам туралы не деуге болады?
Dialogue: 0,0:13:52.03,0:13:53.86,Default,,0,0,0,,Атпа Мен берілемін
Dialogue: 0,0:13:57.06,0:13:59.10,Default,,0,0,0,,3 SAT мергені бар
Dialogue: 0,0:13:59.97,0:14:03.20,Default,,0,0,0,,Оңтүстік және... солтүстік ғимараттың төбесі
Dialogue: 0,0:14:04.14,0:14:06.27,Default,,0,0,0,,Қалғаны Мизуно ғимаратының жоғарғы қабатында.
Dialogue: 0,0:14:07.17,0:14:08.28,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:13.61,0:14:14.58,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:16.95,0:14:17.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:18.92,0:14:21.29,Default,,0,0,0,,Терең! Өте сау-саламат көрінесің! Бір жақсы жаңалық болды ма?
Dialogue: 0,0:14:22.02,0:14:24.12,Default,,0,0,0,,Бұл 01-ге оқ атылып жатыр.
Dialogue: 0,0:14:24.23,0:14:25.99,Default,,0,0,0,,Тағы бір мерген бар сияқты.
Dialogue: 0,0:14:31.40,0:14:33.43,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:14:37.57,0:14:39.91,Default,,0,0,0,,Ол шынымен бар ма? ?
Dialogue: 0,0:14:48.95,0:14:49.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:50.55,0:14:51.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:51.59,0:14:53.49,Default,,0,0,0,,Не болды 01! ? Не болды?
Dialogue: 0,0:14:57.49,0:14:58.49,Default,,0,0,0,,01 шабуыл жасалды
Dialogue: 0,0:14:58.56,0:15:00.33,Default,,0,0,0,,IBM! Дайын бол!
Dialogue: 0,0:15:01.63,0:15:04.53,Default,,0,0,0,,Қақпақ, ол қайда?
Dialogue: 0,0:15:08.00,0:15:09.14,Default,,0,0,0,,Мен оны көріп тұрмын! Бұл келе жатыр!
Dialogue: 0,0:15:09.20,0:15:10.04,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:15:12.27,0:15:12.97,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:17.24,0:15:18.01,Default,,0,0,0,,О!
Dialogue: 0,0:15:19.41,0:15:20.35,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:23.32,0:15:24.22,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:29.39,0:15:32.59,Default,,0,0,0,,Ааа аа...
Dialogue: 0,0:15:34.16,0:15:36.50,Default,,0,0,0,,Тоқтады... Тоқтады!
Dialogue: 0,0:15:36.96,0:15:37.56,Default,,0,0,0,,Жарайды
Dialogue: 0,0:15:38.43,0:15:40.33,Default,,0,0,0,,Ах! (мылтық)
Dialogue: 0,0:15:45.41,0:15:49.01,Default,,0,0,0,,Хмф! Кеш болды, мен шықтым.
Dialogue: 0,0:15:51.48,0:15:53.48,Default,,0,0,0,,Мен мұны біраз уақытқа дейін шығара алмаймын.
Dialogue: 0,0:15:54.21,0:15:55.65,Default,,0,0,0,,Бір орын қалды...
Dialogue: 0,0:15:57.52,0:15:59.95,Default,,0,0,0,,А... жүгіреміз бе?
Dialogue: 0,0:16:05.69,0:16:08.06,Default,,0,0,0,,Күрсін... Колоннаны ашыңыз!
Dialogue: 0,0:16:13.47,0:16:17.34,Default,,0,0,0,,Ерте тұр, қолдамасаң алып кетеді!
Dialogue: 0,0:16:26.35,0:16:27.72,Default,,0,0,0,,01 және 02 төмендеді
Dialogue: 0,0:16:27.98,0:16:30.62,Default,,0,0,0,,Сіз мұнымен оларды үздіксіз өлтіре алмайсыз. Эвакуациялайық.
Dialogue: 0,0:16:31.09,0:16:32.02,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:16:33.42,0:16:35.52,Default,,0,0,0,,Қарсыластың винтовкасының өзін өшіріңіз
Dialogue: 0,0:16:39.19,0:16:40.69,Default,,0,0,0,,Зембілдегіні көздеу
Dialogue: 0,0:16:41.03,0:16:43.16,Default,,0,0,0,,Мен саған қайта тірілуге мүмкіндік беремін.
Dialogue: 0,0:16:43.40,0:16:44.67,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:46.03,0:16:48.37,Default,,0,0,0,,Алдындағыны құлатыңыз
Dialogue: 0,0:16:53.17,0:16:55.21,Default,,0,0,0,,Жел жоқ дерлік
Dialogue: 0,0:16:55.41,0:16:56.34,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:16:57.28,0:16:57.71,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:01.38,0:17:03.18,Default,,0,0,0,,Ақымақ! Сен не істеп жатырсың!
Dialogue: 0,0:17:03.25,0:17:04.59,Default,,0,0,0,,Арх! Қарғыс атсын!
Dialogue: 0,0:17:04.72,0:17:05.62,Default,,0,0,0,,Сіз мұны істедіңіз! ?
Dialogue: 0,0:17:13.69,0:17:14.56,Default,,0,0,0,,Не?
Dialogue: 0,0:17:17.13,0:17:20.27,Default,,0,0,0,,Екі қолмен көздеген дұрыс, Танака-сан.
Dialogue: 0,0:17:21.44,0:17:22.67,Default,,0,0,0,,Цубаки горилла емес—
Dialogue: 0,0:17:23.17,0:17:24.37,Default,,0,0,0,,Ах... (мылтық атылды)
Dialogue: 0,0:17:24.57,0:17:25.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:27.11,0:17:29.14,Default,,0,0,0,,Ия...
Dialogue: 0,0:17:30.34,0:17:31.51,Default,,0,0,0,,Хмф!
Dialogue: 0,0:17:32.38,0:17:33.25,Default,,0,0,0,,А...
Dialogue: 0,0:17:37.75,0:17:40.05,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,0:17:40.39,0:17:42.09,Default,,0,0,0,,Жоқ! сынған
Dialogue: 0,0:17:42.26,0:17:43.39,Default,,0,0,0,,Сатоға не болды? ?
Dialogue: 0,0:17:43.46,0:17:45.19,Default,,0,0,0,,Мен оны қазір көріп тұрмын!
Dialogue: 0,0:17:46.09,0:17:47.36,Default,,0,0,0,,Бұл ыңғайсыздық! Жолдан кет!
Dialogue: 0,0:17:49.23,0:17:50.23,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:17:51.53,0:17:52.53,Default,,0,0,0,,Бітір!
Dialogue: 0,0:17:54.50,0:17:56.44,Default,,0,0,0,,Қарғыс атсын! Жақсы емес пе?
Dialogue: 0,0:17:58.37,0:17:59.14,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:00.61,0:18:01.48,Default,,0,0,0,,Оқ...
Dialogue: 0,0:18:05.58,0:18:07.68,Default,,0,0,0,,(Мүшелердің айқайы)
Dialogue: 0,0:18:08.58,0:18:11.65,Default,,0,0,0,,Өте өкінішті, бұл дерлік болды.
Dialogue: 0,0:18:12.72,0:18:13.72,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:15.32,0:18:16.72,Default,,0,0,0,,Керемет!
Dialogue: 0,0:18:17.42,0:18:20.09,Default,,0,0,0,,Хахахаха... Бар, Сато!
Dialogue: 0,0:18:20.53,0:18:23.43,Default,,0,0,0,,Анау қарт адам емес!
Dialogue: 0,0:18:23.66,0:18:25.37,Default,,0,0,0,,Бұл құбыжық
Dialogue: 0,0:18:26.13,0:18:27.27,Default,,0,0,0,,Мен сені жеңемін — міне, жоспар!
Dialogue: 0,0:18:28.77,0:18:29.54,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:18:31.54,0:18:32.47,Default,,0,0,0,,Ой... атпа!
Dialogue: 0,0:18:34.68,0:18:35.54,Default,,0,0,0,,Мен жай ғана жағдайды біраз бақылап тұрамын.
Dialogue: 0,0:18:38.78,0:18:39.71,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:42.28,0:18:42.88,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:43.22,0:18:43.82,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:50.49,0:18:51.43,Default,,0,0,0,,Атпа!
Dialogue: 0,0:19:02.74,0:19:06.67,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:15.85,0:19:17.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:33.83,0:19:37.34,Default,,0,0,0,,Жарайды, мен шаршадым.
Dialogue: 0,0:19:49.65,0:19:50.82,Default,,0,0,0,,Мына жерде Сато!
Dialogue: 0,0:19:50.88,0:19:52.19,Default,,0,0,0,,Мен сені іздеп табамын.
Dialogue: 0,0:20:05.50,0:20:08.47,Default,,0,0,0,,Сізге бұқаралық ақпарат құралдары ұнамайды, солай ма?
Dialogue: 0,0:20:08.90,0:20:10.30,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:20:16.51,0:20:18.71,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:20:21.32,0:20:21.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:21.98,0:20:24.72,Default,,0,0,0,,О... жаңалық тікұшақ құлады!
Dialogue: 0,0:20:24.89,0:20:28.82,Default,,0,0,0,,Саған оқ тиді ме? Қазір ол жолға құлап, өртеніп жатыр.
Dialogue: 0,0:20:28.99,0:20:30.49,Default,,0,0,0,,А... а...
Dialogue: 0,0:20:31.83,0:20:33.69,Default,,0,0,0,,SAT командасының мәртебесі туралы не деуге болады?
Dialogue: 0,0:20:33.76,0:20:35.60,Default,,0,0,0,,Сато қай жерде? ?
Dialogue: 0,0:20:35.76,0:20:39.53,Default,,0,0,0,,Жоқ, аймақтағы бақылау камералары бұзылған.
Dialogue: 0,0:20:39.80,0:20:41.87,Default,,0,0,0,,SAT командасы жойылған шығар...
Dialogue: 0,0:20:44.50,0:20:45.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:46.44,0:20:47.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:51.78,0:20:52.78,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:20:56.98,0:20:58.65,Default,,0,0,0,,Сіз мұны жасадыңыз ...
Dialogue: 0,0:20:59.59,0:21:02.79,Default,,0,0,0,,Ой, бұл ойын жинағы.
Dialogue: 0,0:21:11.03,0:21:15.34,Default,,0,0,0,,Кей-кун, маған кішкене көмектесші~
Dialogue: 0,0:21:23.88,0:21:27.68,Default,,0,0,0,,Қылмыс орнында тірі қалғандарды іздеу жалғасуда.
Dialogue: 0,0:21:29.42,0:21:32.72,Default,,0,0,0,,Деми-адам Сатоның қылмыстары салдарынан құрбан болғандардың көп болуының себебі...
Dialogue: 0,0:21:32.99,0:21:36.69,Default,,0,0,0,,Grant Pharmaceuticals сонымен қатар терроризмге қарсы шараларды елемегені үшін жауапты.
Dialogue: 0,0:21:36.76,0:21:39.43,Default,,0,0,0,,Компанияның өмір сүруі қиын жағдайда
Dialogue: 0,0:21:42.03,0:21:43.80,Default,,0,0,0,,Қартайған кезімде...
Dialogue: 0,0:21:45.67,0:21:48.04,Default,,0,0,0,,Өмір қандай болады?
Dialogue: 0,0:21:49.34,0:21:50.54,Default,,0,0,0,,Осы оқиғаға жауап ретінде -
Dialogue: 0,0:21:50.60,0:21:53.67,Default,,0,0,0,,Сондай-ақ полицияның жақын арада сыйақы беретіні туралы ақпарат бар.
Dialogue: 0,0:21:53.97,0:21:56.81,Default,,0,0,0,,Деми-адамды ұстауға 100 миллион иен қажет деген қауесеттер біраздан бері айтылып жүр...
Dialogue: 0,0:21:57.31,0:21:59.05,Default,,0,0,0,,Иә? 100 миллион?
Dialogue: 0,0:22:00.58,0:22:02.62,Default,,0,0,0,,Бұл ақпаратпен қамтамасыз ету пәні.
Dialogue: 0,0:22:02.68,0:22:05.32,Default,,0,0,0,,Мемлекет қорғауында емес деми-адамдардың тізімі
Dialogue: 0,0:22:07.39,0:22:08.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:09.36,0:22:12.09,Default,,0,0,0,,Мен төмендегі ауылда тұратын Яманаканың немересімін.
Dialogue: 0,0:22:12.76,0:22:13.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:16.40,0:22:17.63,Default,,0,0,0,,Сол бала...
Dialogue: 0,0:22:31.55,0:22:36.95,Default,,0,0,0,,♪Егер тілегім орындалса, тағы да♪
Dialogue: 0,0:22:37.62,0:22:42.96,Default,,0,0,0,,♪Мен сенің жүрегіңді қозғағым келеді♪
Dialogue: 0,0:22:43.62,0:22:48.76,Default,,0,0,0,,♪Қанша қараңғы болса да, іздеймін♪
Dialogue: 0,0:22:49.66,0:22:54.00,Default,,0,0,0,,♪Бір ғана шам♪
Dialogue: 0,0:22:55.60,0:22:58.84,Default,,0,0,0,,♪Жұлдыздарға қарағанымда♪
Dialogue: 0,0:22:59.51,0:23:00.94,Default,,0,0,0,,♪Алыс болса да♪
Dialogue: 0,0:23:01.68,0:23:06.85,Default,,0,0,0,,♪Сол бір жұлдызды аспанға қарап♪
Dialogue: 0,0:23:07.51,0:23:12.95,Default,,0,0,0,,♪Жүрегімнің аспанына түсетін сияқты♪
Dialogue: 0,0:23:13.62,0:23:17.62,Default,,0,0,0,,♪Сіздің күлкіңіз бен жылуыңыз♪
Dialogue: 0,0:23:17.96,0:23:19.09,Default,,0,0,0,,♪Мені тыңда♪
Dialogue: 0,0:23:19.49,0:23:24.43,Default,,0,0,0,,♪Кетіп, Жалғыз күндерді көргенше♪
Dialogue: 0,0:23:24.50,0:23:27.63,Default,,0,0,0,,♪Сүйу деген нені білдіреді?♪
Dialogue: 0,0:23:27.87,0:23:30.80,Default,,0,0,0,,♪Мен білемін деп ойладым♪
Dialogue: 0,0:23:31.64,0:23:36.14,Default,,0,0,0,,♪Менің алдымда болғанның бәрін сезіну♪
Dialogue: 0,0:23:36.41,0:23:39.61,Default,,0,0,0,,♪Мен маңызды нәрсені жоғалтып алдым♪
Dialogue: 0,0:23:39.75,0:23:43.92,Default,,0,0,0,,♪Шынайы махаббатты тану♪
Dialogue: 0,0:23:45.55,0:23:49.69,Default,,0,0,0,,♪Мен қазір айтамын, Сен қаншалықты жақынсың♪
Dialogue: 0,0:23:51.19,0:23:57.19,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory