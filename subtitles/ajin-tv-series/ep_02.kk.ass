Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.30,0:00:09.30,Default,,0,0,0,,А... а...
Dialogue: 0,0:00:15.71,0:00:18.28,Default,,0,0,0,,Деми-адамдар өлмейтін тіршілік иелері
Dialogue: 0,0:00:19.01,0:00:22.12,Default,,0,0,0,,Жапонияда екі деми адам расталды...
Dialogue: 0,0:00:22.22,0:00:23.49,Default,,0,0,0,,Сен адам емессің бе?
Dialogue: 0,0:00:23.59,0:00:24.79,Default,,0,0,0,,Л-Ллойд, қарашы…
Dialogue: 0,0:00:25.15,0:00:27.52,Default,,0,0,0,,Сен керемет боласың, ағайын.
Dialogue: 0,0:00:28.06,0:00:29.16,Default,,0,0,0,,Үйге баруым керек пе?
Dialogue: 0,0:00:30.79,0:00:31.79,Default,,0,0,0,,Ах... бұл жарты адам.
Dialogue: 0,0:00:32.63,0:00:33.63,Default,,0,0,0,,Деми-адам?
Dialogue: 0,0:00:33.73,0:00:36.43,Default,,0,0,0,,Жоқ... жоқ!
Dialogue: 0,0:00:37.20,0:00:39.27,Default,,0,0,0,,Жапонияда ашылған үшінші жарты адам
Dialogue: 0,0:00:39.37,0:00:41.27,Default,,0,0,0,,Шағын қалада әбігер көп
Dialogue: 0,0:00:41.34,0:00:42.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:43.27,0:00:45.54,Default,,0,0,0,,Цуки храмының жанында деми-адамды қорғаңыз
Dialogue: 0,0:00:45.77,0:00:46.61,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:48.08,0:00:48.81,Default,,0,0,0,,Сәлем! (полицей) хаха
Dialogue: 0,0:00:51.65,0:00:52.61,Default,,0,0,0,,Сіз тұра аласыз ба?
Dialogue: 0,0:00:53.25,0:00:54.08,Default,,0,0,0,,Иә
Dialogue: 0,0:00:54.62,0:00:55.55,Default,,0,0,0,,Жүгірейік
Dialogue: 0,0:00:58.22,0:00:58.79,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:00:59.05,0:00:59.62,Default,,0,0,0,,О
Dialogue: 0,0:01:04.19,0:01:06.73,Default,,0,0,0,,Жаңа Аджин Кей Нагай
Dialogue: 0,0:01:07.46,0:01:09.26,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бере алмаймын.
Dialogue: 0,0:01:14.44,0:01:16.50,Default,,0,0,0,,Олар қорқынышты істер жасайды...
Dialogue: 0,0:01:21.51,0:01:23.24,Default,,0,0,0,,Сіз қуып жетуге шыдай аласыз ба?
Dialogue: 0,0:01:48.50,0:01:51.74,Default,,0,0,0,,♪Терең ұйықтай аласыз ба? Сіз жараларыңызды емдедіңіз бе? ♪
Dialogue: 0,0:01:52.21,0:01:53.71,Default,,0,0,0,,♪Себебі түн жалғыз♪
Dialogue: 0,0:01:53.78,0:01:55.51,Default,,0,0,0,,♪Өзіңізді біреуді сүюге мәжбүрлеме♪
Dialogue: 0,0:01:55.84,0:01:59.28,Default,,0,0,0,,♪Тіпті армандап, жылау♪
Dialogue: 0,0:01:59.35,0:02:03.89,Default,,0,0,0,,♪Мен ештеңе білмей өлуге тырыстым♪
Dialogue: 0,0:02:04.65,0:02:08.42,Default,,0,0,0,,♪Сен оны жақсы жасырдың ба? Сіз деміңізді ұстадыңыз ба? ♪
Dialogue: 0,0:02:08.82,0:02:10.43,Default,,0,0,0,,♪Себебі қазір ауырады♪
Dialogue: 0,0:02:10.49,0:02:12.19,Default,,0,0,0,,♪Өзіңізді өзгертуге мәжбүрлеме♪
Dialogue: 0,0:02:12.59,0:02:16.26,Default,,0,0,0,,♪Тіпті батыл варвар, тіпті қиналған қозы♪
Dialogue: 0,0:02:16.33,0:02:19.40,Default,,0,0,0,,♪Айналмалы жолдармен өмір сүріп жатырмын♪
Dialogue: 0,0:02:21.64,0:02:23.47,Default,,0,0,0,,♪Көзге түспеу♪
Dialogue: 0,0:02:25.47,0:02:27.71,Default,,0,0,0,,♪ Шыдай алатындай етіп ♪
Dialogue: 0,0:02:29.18,0:02:33.82,Default,,0,0,0,,♪Ойлау процесін әлі тоқтатпа♪
Dialogue: 0,0:02:34.15,0:02:36.15,Default,,0,0,0,,♪Бүгін түнде ҚАШЫҚ ЖҮРГІЗУ♪
Dialogue: 0,0:02:36.25,0:02:38.22,Default,,0,0,0,,♪Өтірік сияқты♪
Dialogue: 0,0:02:38.32,0:02:41.59,Default,,0,0,0,,♪Біреу менің қолымнан ұсташы♪
Dialogue: 0,0:02:41.86,0:02:47.16,Default,,0,0,0,,♪Сіз көре алмайтын ертеңгі күннің келуі міндетті емес♪
Dialogue: 0,0:02:47.53,0:02:51.83,Default,,0,0,0,,♪Дәл қазір мен жай ғана ұйықтағым келеді♪
Dialogue: 0,0:03:40.32,0:03:40.95,Default,,0,0,0,,Га
Dialogue: 0,0:03:41.82,0:03:42.65,Default,,0,0,0,,Уф
Dialogue: 0,0:03:45.92,0:03:47.92,Default,,0,0,0,,Неліктен бұл болды?
Dialogue: 0,0:03:49.69,0:03:50.86,Default,,0,0,0,,Неге мен...
Dialogue: 0,0:03:51.46,0:03:53.73,Default,,0,0,0,,Жоқ, неге...
Dialogue: 0,0:03:59.63,0:04:03.97,Default,,0,0,0,,Мен ұсталып қалсам, олар менің шын өлмейтін екенімді анықтайтынына сенімдімін.
Dialogue: 0,0:04:07.54,0:04:09.54,Default,,0,0,0,,Қайта-қайта өлтірілу
Dialogue: 0,0:04:11.71,0:04:13.85,Default,,0,0,0,,Маған ұнамайды... Жай ғана ұнамайды!
Dialogue: 0,0:04:13.92,0:04:14.75,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:04:19.62,0:04:20.42,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:04:20.56,0:04:21.72,Default,,0,0,0,,«Біз қиындыққа тап болдық, біз үлкен қиындықтамыз!»
Dialogue: 0,0:04:21.79,0:04:24.66,Default,,0,0,0,,Жоқ, бір сәттен ұзағырақ...
Dialogue: 0,0:04:31.57,0:04:34.67,Default,,0,0,0,,Ауырды... қатты!
Dialogue: 0,0:04:39.67,0:04:42.88,Default,,0,0,0,,Шүкір, сен неге бұлай істейсің...
Dialogue: 0,0:04:43.28,0:04:43.91,Default,,0,0,0,,Кей…
Dialogue: 0,0:04:43.98,0:04:44.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:45.71,0:04:47.02,Default,,0,0,0,,Қазір бәрі жақсы
Dialogue: 0,0:04:47.52,0:04:49.65,Default,,0,0,0,,Тау жолымен көп жол жүрдім...
Dialogue: 0,0:04:51.82,0:04:54.72,Default,,0,0,0,,Полиция мұндай жылдам әрекет ете алмайды.
Dialogue: 0,0:05:02.73,0:05:05.80,Default,,0,0,0,,Жаңалықтарды қарапайым адамдар да көрмейді.
Dialogue: 0,0:05:09.34,0:05:12.07,Default,,0,0,0,,Мен тыныштандыратын жерге назар аудардым.
Dialogue: 0,0:05:14.78,0:05:16.98,Default,,0,0,0,,Ол жерге жеткенде, сіз нәрселер туралы ойлай аласыз.
Dialogue: 0,0:05:18.58,0:05:19.45,Default,,0,0,0,,Иә
Dialogue: 0,0:05:22.88,0:05:24.05,Default,,0,0,0,,Кай Со...
Dialogue: 0,0:05:24.42,0:05:25.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:25.49,0:05:27.39,Default,,0,0,0,,Бүгін таңертең... Кешіріңіз.
Dialogue: 0,0:05:27.96,0:05:29.42,Default,,0,0,0,,Жарайды, проблема жоқ.
Dialogue: 0,0:05:29.72,0:05:30.63,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:05:31.56,0:05:35.46,Default,,0,0,0,,Мм... бәлкім мен адам емес шығармын?
Dialogue: 0,0:05:35.93,0:05:38.47,Default,,0,0,0,,Мені бұл бөлік қызықтырмайды.
Dialogue: 0,0:05:41.60,0:05:44.74,Default,,0,0,0,,
Dialogue: 0,0:05:45.47,0:05:46.97,Default,,0,0,0,,Полиция хабарламасына сәйкес
Dialogue: 0,0:05:47.04,0:05:48.68,Default,,0,0,0,,Деми-адамдар әріптестерімен-
Dialogue: 0,0:05:48.88,0:05:51.61,Default,,0,0,0,,Олар префектурадан қашып кеткен болуы мүмкін.
Dialogue: 0,0:05:51.75,0:05:53.41,Default,,0,0,0,,Басқа префектуралық полиция күштерімен ынтымақтасу.
Dialogue: 0,0:05:53.51,0:05:56.58,Default,,0,0,0,,Олар күн шыққанда толық ауқымды іздеуді бастаймыз дейді.
Dialogue: 0,0:05:56.88,0:05:59.05,Default,,0,0,0,,Бұл деми-адамның үйінің алдындағы болды.
Dialogue: 0,0:05:59.39,0:06:02.09,Default,,0,0,0,,Қосымша ақпарат алғаннан кейін біз сізді жаңартамыз.
Dialogue: 0,0:06:03.06,0:06:04.73,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:06:05.43,0:06:06.03,Default,,0,0,0,,Иә
Dialogue: 0,0:06:07.70,0:06:08.60,Default,,0,0,0,,(көлік есігінің жабылу дыбысы)
Dialogue: 0,0:06:09.73,0:06:10.50,Default,,0,0,0,,Ах
Dialogue: 0,0:06:11.10,0:06:14.97,Default,,0,0,0,,Иә, мен жаңа ғана келдім, проблема жоқ.
Dialogue: 0,0:06:16.80,0:06:21.14,Default,,0,0,0,,Иә, олар алмас бұрын мен оны түсіріп аламын.
Dialogue: 0,0:06:22.08,0:06:23.01,Default,,0,0,0,,Ең болмағанда… Микасаның жиі басы ауырады деген факті➡
Dialogue: 0,0:06:23.08,0:06:26.98,Default,,0,0,0,,Иә? Ол денсаулық, еңбек және әл-ауқат министрлігінде үлкен бастық.
Dialogue: 0,0:06:27.05,0:06:29.82,Default,,0,0,0,,Бұл деми-адамға қатысты материалдарда іс жүзінде бірінші орында.
Dialogue: 0,0:06:29.98,0:06:32.42,Default,,0,0,0,,Әйел хатшы ма?
Dialogue: 0,0:06:32.85,0:06:36.09,Default,,0,0,0,,Ммм әдемі мансап
Dialogue: 0,0:06:36.56,0:06:37.39,Default,,0,0,0,,Жаман емес.
Dialogue: 0,0:06:37.46,0:06:38.46,Default,,0,0,0,,Иә, иә…
Dialogue: 0,0:06:39.06,0:06:41.50,Default,,0,0,0,,Еңбегіңізге рахмет, Тозаки-сан.
Dialogue: 0,0:06:41.83,0:06:44.00,Default,,0,0,0,,Мен сізбен бұрын телефонмен сөйлескенмін...
Dialogue: 0,0:06:44.07,0:06:45.10,Default,,0,0,0,,Бұл Тосаки.
Dialogue: 0,0:06:45.40,0:06:45.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:46.07,0:06:48.74,Default,,0,0,0,,Бұл Тозаки емес, Тосаки.
Dialogue: 0,0:06:49.04,0:06:51.71,Default,,0,0,0,,А... Мен бұл үшін қатты өкінемін.
Dialogue: 0,0:06:52.61,0:06:53.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:55.08,0:06:58.78,Default,,0,0,0,,Сіздің ұсынысыңыз бойынша біз қызметкерлер санын айтарлықтай арттырдық.
Dialogue: 0,0:06:59.11,0:07:01.95,Default,,0,0,0,,Елордалық полиция департаментімен және басқа префектуралық полиция бөлімшелерімен ынтымақтастық маңызды.
Dialogue: 0,0:07:02.02,0:07:03.05,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:04.42,0:07:05.09,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:07.92,0:07:08.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:09.62,0:07:11.79,Default,,0,0,0,,А, жоқ, менде бәрі жақсы.
Dialogue: 0,0:07:12.66,0:07:14.56,Default,,0,0,0,,Орналастырылған персонал қалай жабдықталған?
Dialogue: 0,0:07:14.70,0:07:16.56,Default,,0,0,0,,Иә, сіз жабдықталғансыз ба?
Dialogue: 0,0:07:16.70,0:07:19.90,Default,,0,0,0,,Жабдықтарға келетін болсақ, ол әдеттегідей жабдықталған.
Dialogue: 0,0:07:22.60,0:07:25.57,Default,,0,0,0,,Біздің деми-адамдармен де тәжірибеміз жоқ.
Dialogue: 0,0:07:25.71,0:07:27.74,Default,,0,0,0,,Қандай да бір арнайы жабдық қажет болса...
Dialogue: 0,0:07:27.81,0:07:28.64,Default,,0,0,0,,Ууух!
Dialogue: 0,0:07:28.94,0:07:31.01,Default,,0,0,0,,Мен реттеуді жасадым.
Dialogue: 0,0:07:33.58,0:07:34.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:36.52,0:07:38.69,Default,,0,0,0,,«Өлімге әкелмейтін анестетиктер»?
Dialogue: 0,0:07:38.75,0:07:41.99,Default,,0,0,0,,Бұл демиадамдардың қозғалысын тоқтатудың ең тиімді құралы.
Dialogue: 0,0:07:42.86,0:07:45.76,Default,,0,0,0,,Ол тигенше, сіз оны міндетті түрде өлтіре аласыз.
Dialogue: 0,0:07:46.83,0:07:48.93,Default,,0,0,0,,Күрсіну… тіпті мұндай нәрсе…
Dialogue: 0,0:07:49.00,0:07:51.10,Default,,0,0,0,,Біз шамамен 2 сағатта келеміз деп күтеміз.
Dialogue: 0,0:07:51.60,0:07:54.74,Default,,0,0,0,,Келген бойда оны сайттағы әрбір адамға орналастырыңыз.
Dialogue: 0,0:07:55.07,0:07:56.84,Default,,0,0,0,,Аа... Түсінікті.
Dialogue: 0,0:07:58.04,0:08:03.64,Default,,0,0,0,,Бірақ... бұл анестетикпен аң аулау және өлтіру сияқты...
Dialogue: 0,0:08:03.71,0:08:05.05,Default,,0,0,0,,Жай аң аулау
Dialogue: 0,0:08:05.71,0:08:08.02,Default,,0,0,0,,Деми-адамдар сирек кездесетін тіршілік иелері
Dialogue: 0,0:08:10.89,0:08:13.96,Default,,0,0,0,,Мен сені соңғы рет бүгін түстен кейін көрдім.
Dialogue: 0,0:08:15.56,0:08:18.53,Default,,0,0,0,,Бірақ мен ештеңе білмеймін.
Dialogue: 0,0:08:18.59,0:08:21.20,Default,,0,0,0,,Сіздің ағаңыз біртүрлі болып көрінді ме?
Dialogue: 0,0:08:21.50,0:08:24.50,Default,,0,0,0,,Бұл әдеттегідей болды.
Dialogue: 0,0:08:24.87,0:08:27.54,Default,,0,0,0,,Сіз ештеңе байқамадыңыз ба? Бұл сіздің әпкеңіз, солай ма?
Dialogue: 0,0:08:27.60,0:08:29.10,Default,,0,0,0,,Білу дегенді қалай түсінесіңдер?
Dialogue: 0,0:08:29.17,0:08:29.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:30.00,0:08:33.07,Default,,0,0,0,,Сіз өлгенше деми-адамдар туралы білмейсіз, солай ма?
Dialogue: 0,0:08:33.81,0:08:35.04,Default,,0,0,0,,Байқауға мүмкіндік жоқ
Dialogue: 0,0:08:35.58,0:08:37.21,Default,,0,0,0,,Бұл рас...
Dialogue: 0,0:08:42.12,0:08:43.68,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:08:44.89,0:08:48.06,Default,,0,0,0,,Мен сенің ағаң туралы ештеңе білмеймін.
Dialogue: 0,0:09:02.20,0:09:05.91,Default,,0,0,0,,Қош келдіңіз, қозғалтқышты тоқтатыңыз.
Dialogue: 0,0:09:07.81,0:09:10.61,Default,,0,0,0,,Кай маған не үшін көмектеседі?
Dialogue: 0,0:09:11.28,0:09:12.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:13.65,0:09:17.08,Default,,0,0,0,,Қасымда болсаң, Кайға да қауіп төнеді.
Dialogue: 0,0:09:17.89,0:09:19.22,Default,,0,0,0,,Біз доспыз, солай ма?
Dialogue: 0,0:09:21.76,0:09:22.92,Default,,0,0,0,,Сіз жарты адам болсаңыз да?
Dialogue: 0,0:09:23.16,0:09:26.13,Default,,0,0,0,,Иә, бұл маңызды емес.
Dialogue: 0,0:09:27.13,0:09:29.13,Default,,0,0,0,,Дәлірек айтқанда, әлемде қанша демиадам бар?
Dialogue: 0,0:09:29.33,0:09:30.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:31.80,0:09:33.97,Default,,0,0,0,,Умм 46…
Dialogue: 0,0:09:34.24,0:09:38.21,Default,,0,0,0,,Жоқ... 47 адам, соның ішінде мені де.
Dialogue: 0,0:09:39.01,0:09:42.68,Default,,0,0,0,,Не, 47 адам бар ма?
Dialogue: 0,0:09:43.78,0:09:45.78,Default,,0,0,0,,Бұл ерекше емес.
Dialogue: 0,0:09:48.78,0:09:51.85,Default,,0,0,0,,Хэхе... Рахмет Кай
Dialogue: 0,0:09:52.32,0:09:54.22,Default,,0,0,0,,Мүмкін мен өзімді сәл жақсы сезінемін
Dialogue: 0,0:09:55.96,0:09:57.09,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:09:57.29,0:09:59.96,Default,,0,0,0,,(көлік дыбысы)
Dialogue: 0,0:10:00.09,0:10:02.76,Default,,0,0,0,,Хаха, шығып жатыр.
Dialogue: 0,0:10:03.60,0:10:04.87,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:10:05.83,0:10:08.20,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:10:08.27,0:10:11.37,Default,,0,0,0,,Бұл уақытта газдың таусылуы мүмкін емес.
Dialogue: 0,0:10:12.67,0:10:15.91,Default,,0,0,0,,Цк, о, қандай тітіркендіргіш!
Dialogue: 0,0:10:16.68,0:10:19.28,Default,,0,0,0,,Мен оны сатпас бұрын ләззат аламын. Күте тұр!
Dialogue: 0,0:10:19.65,0:10:25.65,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:10:27.02,0:10:27.69,Default,,0,0,0,,Ах
Dialogue: 0,0:10:32.16,0:10:33.63,Default,,0,0,0,,Эй, енді...
Dialogue: 0,0:10:33.83,0:10:34.70,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:35.13,0:10:37.03,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:10:38.63,0:10:39.83,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:10:41.30,0:10:42.97,Default,,0,0,0,,Бұл ұят болды.
Dialogue: 0,0:10:43.04,0:10:45.91,Default,,0,0,0,,Егер мен оны сол кезде ұстасам, мен 100 миллион иен алар едім.
Dialogue: 0,0:10:45.97,0:10:47.91,Default,,0,0,0,,Алдын ала білгенімді қалаймын
Dialogue: 0,0:10:47.98,0:10:51.98,Default,,0,0,0,,Біз жалғыз қалғанда сен өліп кетсең ғой.
Dialogue: 0,0:10:52.08,0:10:53.31,Default,,0,0,0,,Аа…
Dialogue: 0,0:10:53.91,0:10:57.72,Default,,0,0,0,,Дәлірек айтқанда, физика мәселесі бойынша не істеуіміз керек? Мен Нагай-кунға сүйендім.
Dialogue: 0,0:10:57.79,0:11:01.32,Default,,0,0,0,,Аа, бұл ұят.
Dialogue: 0,0:11:01.76,0:11:05.29,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:11:05.96,0:11:09.23,Default,,0,0,0,,А... не? не болды?
Dialogue: 0,0:11:10.73,0:11:11.77,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:11:13.97,0:11:16.70,Default,,0,0,0,,Сұрақ қоймаңыз, жай ғана қозғалыңыз.
Dialogue: 0,0:11:16.77,0:11:17.91,Default,,0,0,0,,Бірақ Араки мырза...
Dialogue: 0,0:11:17.97,0:11:23.11,Default,,0,0,0,,А? Сондықтан сіздің пікіріңізді естіген жоқпын деп отырсыз.
Dialogue: 0,0:11:24.81,0:11:28.12,Default,,0,0,0,,Сіз оны полиция деп атасаңыз да, бұл юрисдикция деңгейі ме?
Dialogue: 0,0:11:28.35,0:11:30.28,Default,,0,0,0,,Деми-адамды қорғау заңын қолдану туралы не айтасыз?
Dialogue: 0,0:11:30.42,0:11:32.69,Default,,0,0,0,,Бақылау жұмыс күшін қажет етеді
Dialogue: 0,0:11:35.19,0:11:37.86,Default,,0,0,0,,Сіз жоғарыдан қысымға қарсы тұра алмайсыз.
Dialogue: 0,0:11:37.96,0:11:39.36,Default,,0,0,0,,Көп сөйлеме
Dialogue: 0,0:11:40.09,0:11:40.96,Default,,0,0,0,,Иә
Dialogue: 0,0:11:41.33,0:11:42.73,Default,,0,0,0,,Ум...
Dialogue: 0,0:11:43.00,0:11:44.70,Default,,0,0,0,,Сөйлесіп тұрғанымда кешіріңіз.
Dialogue: 0,0:11:44.77,0:11:45.37,Default,,0,0,0,,Не?
Dialogue: 0,0:11:45.47,0:11:49.20,Default,,0,0,0,,Иә, у... Деми-адамдарды мүмкіндігінше тезірек қамтамасыз ету.
Dialogue: 0,0:11:49.27,0:11:52.91,Default,,0,0,0,,Мүмкін болса, мен деми-адамдар туралы көбірек ақпарат алғым келеді...
Dialogue: 0,0:12:09.22,0:12:12.43,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:12:12.49,0:12:14.36,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:12:15.30,0:12:18.30,Default,,0,0,0,,Бұл тітіркендіргіш. Алға қарап, жүріңіз. Таз.
Dialogue: 0,0:12:18.43,0:12:20.90,Default,,0,0,0,,Сіз шынымен жарты адамсыз ба?
Dialogue: 0,0:12:21.47,0:12:23.20,Default,,0,0,0,,Бұған ешқандай күмән жоқ
Dialogue: 0,0:12:25.01,0:12:26.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:28.91,0:12:29.78,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:32.85,0:12:33.75,Default,,0,0,0,,Кай
Dialogue: 0,0:12:34.01,0:12:34.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:34.98,0:12:38.22,Default,,0,0,0,,Осындай кезде... міне, солай...
Dialogue: 0,0:12:39.39,0:12:41.02,Default,,0,0,0,,Мен шынымен сиқым келеді.
Dialogue: 0,0:12:41.99,0:12:44.23,Default,,0,0,0,,А, онда шеткі көшеге көшейік.
Dialogue: 0,0:13:10.89,0:13:11.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:12.32,0:13:15.92,Default,,0,0,0,,Меніңше, зәр қалыпты түрде шығады... Дұрыс.
Dialogue: 0,0:13:16.12,0:13:19.49,Default,,0,0,0,,Мен де бүгінге дейін қалыпты өмір сүрдім...
Dialogue: 0,0:13:20.46,0:13:21.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:21.16,0:13:21.90,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:13:22.96,0:13:25.47,Default,,0,0,0,,(бұзақтың күлкісі)
Dialogue: 0,0:13:32.34,0:13:34.14,Default,,0,0,0,,О... Иә?
Dialogue: 0,0:13:38.05,0:13:38.95,Default,,0,0,0,,Гах! (Кайто) Ах!
Dialogue: 0,0:13:39.01,0:13:40.35,Default,,0,0,0,,Ахх... (Кайто) Кей!
Dialogue: 0,0:13:40.55,0:13:42.08,Default,,0,0,0,,Хаа… хаа… хаа…
Dialogue: 0,0:13:42.35,0:13:45.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:45.25,0:13:46.19,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,0:13:48.46,0:13:51.96,Default,,0,0,0,,Қате болма, бұл деми-адам! Ол шын мәнінде жарты адам!
Dialogue: 0,0:13:52.03,0:13:55.30,Default,,0,0,0,,Сіз байсалдысыз ба? Мен сенбеймін, бұл 100 миллион!
Dialogue: 0,0:13:55.36,0:13:58.40,Default,,0,0,0,,Сіз байсалдысыз ба? Эй, сен оны маған шындап бере аласың ба?
Dialogue: 0,0:13:58.47,0:13:59.23,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:59.30,0:14:00.57,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:14:01.57,0:14:03.34,Default,,0,0,0,,Ол қайдан шыққан?
Dialogue: 0,0:14:03.90,0:14:05.17,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:14:05.24,0:14:09.14,Default,,0,0,0,,О? Сіз қандайсыз? Аджиннің досы ма?
Dialogue: 0,0:14:09.21,0:14:12.11,Default,,0,0,0,,Мен саған алып беремін, Демикун. Рақмет сізге.
Dialogue: 0,0:14:12.18,0:14:14.25,Default,,0,0,0,,Тек ары қарай қозғалмаңыз!
Dialogue: 0,0:14:15.92,0:14:19.25,Default,,0,0,0,,А... жарты адам? Шынымен бе?
Dialogue: 0,0:14:21.02,0:14:24.02,Default,,0,0,0,,Ах... уф...
Dialogue: 0,0:14:24.09,0:14:25.26,Default,,0,0,0,,Уф
Dialogue: 0,0:14:33.20,0:14:36.00,Default,,0,0,0,,Маған ұнамайды... Ұнамайды...!
Dialogue: 0,0:14:36.20,0:14:37.10,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:14:38.87,0:14:39.47,Default,,0,0,0,,Ga!
Dialogue: 0,0:14:39.57,0:14:40.44,Default,,0,0,0,,Кей!
Dialogue: 0,0:14:40.88,0:14:41.51,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:14:42.14,0:14:44.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:47.31,0:14:51.09,Default,,0,0,0,,Мен сенің өлмейтін екеніңді тексеремін.
Dialogue: 0,0:14:51.89,0:14:55.59,Default,,0,0,0,,Неліктен бұлай болды? Неге...
Dialogue: 0,0:14:58.99,0:15:01.00,Default,,0,0,0,,Бұл менің кінәм емес!
Dialogue: 0,0:15:01.23,0:15:04.20,Default,,0,0,0,,Сәлем! Сіз өлмейтінсіз!
Dialogue: 0,0:15:04.90,0:15:06.63,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:07.07,0:15:10.97,Default,,0,0,0,,Хахаха... 100 миллион беремін.
Dialogue: 0,0:15:11.04,0:15:15.01,Default,,0,0,0,,Өлді... Сосын... А?
Dialogue: 0,0:15:15.21,0:15:18.68,Default,,0,0,0,,Сіз... бәріңіз...
Dialogue: 0,0:15:19.05,0:15:20.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:20.95,0:15:22.52,Default,,0,0,0,,Өлген…
Dialogue: 0,0:15:31.03,0:15:35.33,Default,,0,0,0,,Не? иә? Сіз өлмейсіз, солай ма?
Dialogue: 0,0:15:36.20,0:15:37.13,Default,,0,0,0,,Кей!
Dialogue: 0,0:15:39.40,0:15:40.63,Default,,0,0,0,,Урьяа (Кайто) Ах!
Dialogue: 0,0:15:41.20,0:15:41.64,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:45.04,0:15:48.18,Default,,0,0,0,,Неге мен... Неге...
Dialogue: 0,0:15:48.38,0:15:50.24,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:15:51.21,0:15:52.35,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,0:15:52.45,0:15:53.35,Default,,0,0,0,,Ga!
Dialogue: 0,0:15:54.38,0:15:55.28,Default,,0,0,0,,Кей! (соққы дыбысы)
Dialogue: 0,0:15:55.62,0:15:57.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:57.72,0:16:01.96,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:16:02.32,0:16:04.12,Default,,0,0,0,,Әй...
Dialogue: 0,0:16:04.26,0:16:06.73,Default,,0,0,0,,Бұл жарты адам өлді!
Dialogue: 0,0:16:07.49,0:16:08.63,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:16:10.33,0:16:11.40,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:16:16.14,0:16:22.11,Default,,0,0,0,,Шыу!
Dialogue: 0,0:16:24.38,0:16:25.35,Default,,0,0,0,,Не?
Dialogue: 0,0:16:26.68,0:16:29.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:31.12,0:16:33.19,Default,,0,0,0,,Менің денем... қозғалмайды.
Dialogue: 0,0:16:33.65,0:16:36.49,Default,,0,0,0,,Хааааааааааааааааааааааааааа...
Dialogue: 0,0:16:36.56,0:16:38.13,Default,,0,0,0,,Мен мектептен шыққан кездегідей.
Dialogue: 0,0:16:38.46,0:16:40.73,Default,,0,0,0,,Мұның бәрі осында!
Dialogue: 0,0:16:42.26,0:16:43.46,Default,,0,0,0,,Сәлем! Ахх
Dialogue: 0,0:16:44.30,0:16:45.57,Default,,0,0,0,,Ах, а, а...
Dialogue: 0,0:16:45.73,0:16:47.60,Default,,0,0,0,,Кай сен тұра аласың ба? Қанекей жүгірейік!
Dialogue: 0,0:16:48.14,0:16:49.30,Default,,0,0,0,,Дегенмен, заттары көп екен.
Dialogue: 0,0:16:49.40,0:16:52.11,Default,,0,0,0,,Ах! Хааааааа...
Dialogue: 0,0:16:59.61,0:17:01.25,Default,,0,0,0,,Бұл әйгілі әңгіме...
Dialogue: 0,0:17:02.42,0:17:04.65,Default,,0,0,0,,Демиадам дауыстарынан сақ болыңыз
Dialogue: 0,0:17:05.12,0:17:07.19,Default,,0,0,0,,А... Мен бұл туралы естідім.
Dialogue: 0,0:17:07.29,0:17:10.36,Default,,0,0,0,,Сіз байлауда тұрғандай бірнеше секунд қозғала алмайсыз.
Dialogue: 0,0:17:10.46,0:17:12.36,Default,,0,0,0,,Адам ағзасына әсері жоқ, бірақ-
Dialogue: 0,0:17:12.43,0:17:15.16,Default,,0,0,0,,Оларды ұстау кезінде аздап сақ болу керек.
Dialogue: 0,0:17:15.30,0:17:16.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:19.13,0:17:21.50,Default,,0,0,0,,Ах... иә...
Dialogue: 0,0:17:21.60,0:17:23.20,Default,,0,0,0,,Денеңіз жақсы ма?
Dialogue: 0,0:17:23.54,0:17:27.54,Default,,0,0,0,,Соққыдан басқа, қарғыс атсын, мен сені қуамын!
Dialogue: 0,0:17:29.28,0:17:31.45,Default,,0,0,0,,Ах! Менің әйелім жоқ, мені жайына қалдыр!
Dialogue: 0,0:17:31.55,0:17:33.25,Default,,0,0,0,,Тезірек жүр, таз!
Dialogue: 0,0:17:36.22,0:17:38.59,Default,,0,0,0,,…
Dialogue: 0,0:17:39.45,0:17:43.52,Default,,0,0,0,,Адамдардың қозғалысын тоқтататын дауыс па? Бұл біртүрлі.
Dialogue: 0,0:17:43.62,0:17:45.29,Default,,0,0,0,,Бұл түсіндірілді ме?
Dialogue: 0,0:17:45.36,0:17:47.59,Default,,0,0,0,,Мен қазір зерттеп жатқандықтан жауап бере алмаймын.
Dialogue: 0,0:17:47.83,0:17:48.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:49.40,0:17:50.16,Default,,0,0,0,,Араки мырза
Dialogue: 0,0:17:50.23,0:17:51.50,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:17:51.73,0:17:53.27,Default,,0,0,0,,Тоза…
Dialogue: 0,0:17:53.33,0:17:56.60,Default,,0,0,0,,Тозаки мырзаның анасымен сұхбат біткен сияқты.
Dialogue: 0,0:17:56.74,0:17:58.24,Default,,0,0,0,,Иә... сонда.
Dialogue: 0,0:17:58.71,0:18:01.24,Default,,0,0,0,,А, оның алдында мен сенен бір нәрсе сұрасам болады ма?
Dialogue: 0,0:18:01.64,0:18:02.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:03.81,0:18:08.65,Default,,0,0,0,,Мм... сіз деми-адамдар туралы басқа ештеңе жасырмайсыз... солай ма?
Dialogue: 0,0:18:09.15,0:18:13.39,Default,,0,0,0,,Ахаха... аа, жоқ, м... сен мұны жиі айтасың, солай емес пе?
Dialogue: 0,0:18:13.62,0:18:15.12,Default,,0,0,0,,«Төбе көп нәрсені жасырады».
Dialogue: 0,0:18:15.19,0:18:17.66,Default,,0,0,0,,Жасыратын ештеңем жоқ сияқты...
Dialogue: 0,0:18:17.72,0:18:21.36,Default,,0,0,0,,Сізге «дауыстан» басқа ешқандай әсер жоқ.
Dialogue: 0,0:18:22.26,0:18:25.13,Default,,0,0,0,,Деми-адамдар қауіпті емес, бұл мүлдем дұрыс.
Dialogue: 0,0:18:26.40,0:18:28.17,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:18:28.77,0:18:29.64,Default,,0,0,0,,Га
Dialogue: 0,0:18:34.37,0:18:36.24,Default,,0,0,0,,Біз адам емеспіз
Dialogue: 0,0:18:38.68,0:18:41.78,Default,,0,0,0,,Қызметте жүргенде қоғам қайраткері, басқа жаратылыс.
Dialogue: 0,0:18:42.12,0:18:45.39,Default,,0,0,0,,Егер сіз мұны терең түсінсеңіз, қажетсіз сентименталды өшіре аласыз.
Dialogue: 0,0:18:45.55,0:18:46.89,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:18:49.22,0:18:50.72,Default,,0,0,0,,Изуми Шимомура
Dialogue: 0,0:18:51.33,0:18:52.49,Default,,0,0,0,,Иә
Dialogue: 0,0:19:00.43,0:19:02.44,Default,,0,0,0,,Деми-адамдар қауіпті емес
Dialogue: 0,0:19:04.37,0:19:07.21,Default,,0,0,0,,Кей Нагай басқа түр болмаса
Dialogue: 0,0:19:16.78,0:19:17.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:17.89,0:19:19.82,Default,,0,0,0,,Тағы 500 рет!
Dialogue: 0,0:19:19.92,0:19:20.82,Default,,0,0,0,,Е! ?
Dialogue: 0,0:19:21.46,0:19:22.22,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:22.29,0:19:24.16,Default,,0,0,0,,Не? А... жоқ
Dialogue: 0,0:19:24.29,0:19:28.40,Default,,0,0,0,,Кей: Бұл менің кінәм. Мен күзетімді түсірдім. Мен мұндай нәрсенің кенеттен болғанына сене алар емеспін.
Dialogue: 0,0:19:28.46,0:19:30.80,Default,,0,0,0,,Мұндай нәрсе... Бұл жарақат сияқты...
Dialogue: 0,0:19:31.17,0:19:31.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:40.67,0:19:41.58,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:19:45.28,0:19:46.51,Default,,0,0,0,,Қашып кетейін, қарғыс атсын!
Dialogue: 0,0:19:46.58,0:19:48.62,Default,,0,0,0,,Соқыңыз! Өлсем де өлмеймін!
Dialogue: 0,0:19:48.68,0:19:50.32,Default,,0,0,0,,Мені ұрып өлтір! сізді түсіндім!
Dialogue: 0,0:19:56.82,0:19:57.79,Default,,0,0,0,,Сіз мені ұрмақшысыз ба? ?
Dialogue: 0,0:19:57.86,0:20:00.19,Default,,0,0,0,,Бұл қандай балалар?
Dialogue: 0,0:20:01.46,0:20:04.83,Default,,0,0,0,,Өйткені сендер мұндасыңдар... балалар...
Dialogue: 0,0:20:05.47,0:20:06.80,Default,,0,0,0,,Жүр! Мені ұр!
Dialogue: 0,0:20:11.41,0:20:12.31,Default,,0,0,0,,О... қарғыс атсын.
Dialogue: 0,0:20:19.31,0:20:20.78,Default,,0,0,0,,(Ажыратқыштың дыбысы)
Dialogue: 0,0:20:20.88,0:20:23.58,Default,,0,0,0,,Кей, итермелей берейік!
Dialogue: 0,0:20:23.75,0:20:24.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:30.42,0:20:31.53,Default,,0,0,0,,Твит!
Dialogue: 0,0:20:34.33,0:20:35.30,Default,,0,0,0,,Гррр…
Dialogue: 0,0:20:35.36,0:20:36.56,Default,,0,0,0,,Сен барасың ба? Барамыз ба?
Dialogue: 0,0:20:36.63,0:20:37.43,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:20:40.47,0:20:42.54,Default,,0,0,0,,Жарайды, уақытында жасаймыз. Бұзыңыз!
Dialogue: 0,0:20:45.74,0:20:47.51,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:20:52.51,0:20:55.55,Default,,0,0,0,,Не істеп жатырсың, ақымақ? Тез шығарыңыз!
Dialogue: 0,0:20:55.68,0:20:56.88,Default,,0,0,0,,Сәлем! Бұлай етпе!
Dialogue: 0,0:20:57.52,0:20:58.95,Default,,0,0,0,,Ух...ол қозғалмайды...
Dialogue: 0,0:20:59.39,0:21:01.39,Default,,0,0,0,,Иә? Ол тоқтап қалды ма? ?
Dialogue: 0,0:21:02.96,0:21:04.29,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:21:04.66,0:21:06.69,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:21:07.53,0:21:08.90,Default,,0,0,0,,Немесе... дене...
Dialogue: 0,0:21:10.36,0:21:11.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:13.90,0:21:16.84,Default,,0,0,0,,Мен... жаман емеспін.
Dialogue: 0,0:21:17.90,0:21:23.68,Default,,0,0,0,,Өліңдер, балалар... бәрің де өліңдер...
Dialogue: 0,0:21:23.94,0:21:24.91,Default,,0,0,0,,А... а...
Dialogue: 0,0:21:25.01,0:21:28.88,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:21:29.32,0:21:30.98,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:21:34.05,0:21:37.76,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:21:38.03,0:21:39.96,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:21:40.03,0:21:42.90,Default,,0,0,0,,Жарайды... Бірақ мен оны сілкіп тастадым деп ойлаймын.
Dialogue: 0,0:21:46.73,0:21:50.00,Default,,0,0,0,,Ол кезде неге мен ғана жылдам қозғалатынмын?
Dialogue: 0,0:21:56.84,0:21:58.71,Default,,0,0,0,,Бұл бұрыннан белгілі болды.
Dialogue: 0,0:21:58.81,0:22:02.72,Default,,0,0,0,,Деми-адамның даусының адамдарды қозғалуын тоқтату қасиеті бар сияқты.
Dialogue: 0,0:22:04.38,0:22:08.36,Default,,0,0,0,,Басқа нәрсе жоқ па?
Dialogue: 0,0:22:11.56,0:22:12.53,Default,,0,0,0,,Жартылай адам...
Dialogue: 0,0:22:15.93,0:22:19.67,Default,,0,0,0,,Мен шынымен зәр алғым келеді...
Dialogue: 0,0:22:30.78,0:22:36.38,Default,,0,0,0,,♪Егер тілегім орындалса, тағы да♪
Dialogue: 0,0:22:36.88,0:22:42.46,Default,,0,0,0,,♪Мен сенің жүрегіңді қозғағым келеді♪
Dialogue: 0,0:22:42.89,0:22:48.10,Default,,0,0,0,,♪Қанша қараңғы болса да, іздеймін♪
Dialogue: 0,0:22:48.93,0:22:53.50,Default,,0,0,0,,♪Бір ғана шам♪
Dialogue: 0,0:22:54.87,0:22:58.41,Default,,0,0,0,,♪Жұлдыздарға қарағанымда♪
Dialogue: 0,0:22:58.74,0:23:00.47,Default,,0,0,0,,♪Алыста болса да♪
Dialogue: 0,0:23:00.91,0:23:06.11,Default,,0,0,0,,♪Сол бір жұлдызды аспанға қарап♪
Dialogue: 0,0:23:06.78,0:23:12.12,Default,,0,0,0,,♪Жүрегімнің аспанына түсетін сияқты♪
Dialogue: 0,0:23:12.89,0:23:17.02,Default,,0,0,0,,♪Сіздің күлкіңіз бен жылуыңыз♪
Dialogue: 0,0:23:17.42,0:23:18.66,Default,,0,0,0,,♪Мені тыңда♪
Dialogue: 0,0:23:18.79,0:23:23.70,Default,,0,0,0,,♪Кетіп, Жалғыз күндерді көргенше♪
Dialogue: 0,0:23:23.76,0:23:26.97,Default,,0,0,0,,♪Сүйу деген нені білдіреді?♪
Dialogue: 0,0:23:27.10,0:23:30.17,Default,,0,0,0,,♪Мен білемін деп ойладым♪
Dialogue: 0,0:23:30.97,0:23:35.64,Default,,0,0,0,,♪Менің алдымда болғанның бәрін сезіну♪
Dialogue: 0,0:23:35.71,0:23:38.91,Default,,0,0,0,,♪Мен маңызды нәрсені жоғалтып алдым♪
Dialogue: 0,0:23:39.01,0:23:43.02,Default,,0,0,0,,♪Шынайы махаббатты тану♪
Dialogue: 0,0:23:44.82,0:23:48.89,Default,,0,0,0,,♪Мен қазір айтамын, Қаншалықты жақынсың♪
Dialogue: 0,0:23:50.39,0:23:56.39,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
