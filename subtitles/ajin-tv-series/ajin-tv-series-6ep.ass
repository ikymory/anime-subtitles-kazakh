Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.71,0:00:05.21,Default,,0,0,0,,Эй, Изуна.
Dialogue: 0,0:00:05.42,0:00:06.29,Default,,0,0,0,,Көз байлау?
Dialogue: 0,0:00:07.54,0:00:08.67,Default,,0,0,0,,Адамдарды жек көру
Dialogue: 0,0:00:08.75,0:00:12.80,Default,,0,0,0,,Осының барлығын бойына сіңіру үшін мен оны адам жағына ұсындым.
Dialogue: 0,0:00:13.05,0:00:14.22,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:00:14.72,0:00:16.05,Default,,0,0,0,,Мен неге...
Dialogue: 0,0:00:16.22,0:00:17.97,Default,,0,0,0,,Сіз түсіндіңіз бе?
Dialogue: 0,0:00:18.05,0:00:21.39,Default,,0,0,0,,Төтенше жағдайда көмек сұраңыз, ең жаман қоқыс.
Dialogue: 0,0:00:21.81,0:00:24.31,Default,,0,0,0,,Дұрыс... өлтір!
Dialogue: 0,0:00:24.81,0:00:26.81,Default,,0,0,0,,Өзіңіздің шынайы болыңыз!
Dialogue: 0,0:00:28.31,0:00:30.69,Default,,0,0,0,,Зиянкес! Қалпақ киген адам басып кірді!
Dialogue: 0,0:00:31.48,0:00:34.70,Default,,0,0,0,,Нағайға көмектесуге келдің бе? Мені жалғыз қалдыр?
Dialogue: 0,0:00:35.24,0:00:37.70,Default,,0,0,0,,Сонда... неге сонша шулы?
Dialogue: 0,0:00:37.78,0:00:40.45,Default,,0,0,0,,Осы Огура Икуя-сама келсе де.
Dialogue: 0,0:00:40.79,0:00:44.16,Default,,0,0,0,,Енді, Нагай-кун, қош келдің.
Dialogue: 0,0:00:46.37,0:00:47.96,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:00:50.04,0:00:51.42,Default,,0,0,0,,Сато мырза...
Dialogue: 0,0:00:53.42,0:00:55.76,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:00:57.39,0:01:02.22,Default,,0,0,0,,Бұл мәре сәтсіз аяқталды...
Dialogue: 0,0:01:15.61,0:01:18.62,Default,,0,0,0,,Жүр, кеттік. Тым ұзақ қалмаңыз.
Dialogue: 0,0:01:19.03,0:01:20.78,Default,,0,0,0,,А... иә
Dialogue: 0,0:01:46.27,0:01:49.56,Default,,0,0,0,,♪Терең ұйықтай аласыз ба? Сіз жараларыңызды емдедіңіз бе? ♪
Dialogue: 0,0:01:49.85,0:01:51.56,Default,,0,0,0,,♪Себебі түн жалғыз♪
Dialogue: 0,0:01:51.65,0:01:53.23,Default,,0,0,0,,♪Өзіңізді біреуді сүюге мәжбүрлеме♪
Dialogue: 0,0:01:53.61,0:01:56.95,Default,,0,0,0,,♪Тіпті армандап, жылау♪
Dialogue: 0,0:01:57.03,0:02:01.83,Default,,0,0,0,,♪Мен ештеңе білмей өлуге тырыстым♪
Dialogue: 0,0:02:02.62,0:02:06.12,Default,,0,0,0,,♪Сен оны жақсы жасырдың ба? Сіз деміңізді ұстадыңыз ба? ♪
Dialogue: 0,0:02:06.62,0:02:07.96,Default,,0,0,0,,♪Себебі қазір ауырады♪
Dialogue: 0,0:02:08.12,0:02:09.83,Default,,0,0,0,,♪Өзіңізді өзгертуге мәжбүрлеме♪
Dialogue: 0,0:02:10.29,0:02:13.88,Default,,0,0,0,,♪Тіпті батыл варвар, тіпті қиналған қозы♪
Dialogue: 0,0:02:14.00,0:02:17.09,Default,,0,0,0,,♪Айналмалы жолдармен өмір сүріп жатырмын♪
Dialogue: 0,0:02:19.43,0:02:21.47,Default,,0,0,0,,♪Көзге түспеу♪
Dialogue: 0,0:02:23.14,0:02:25.43,Default,,0,0,0,,♪ Шыдай алатындай етіп ♪
Dialogue: 0,0:02:26.77,0:02:31.52,Default,,0,0,0,,♪Ойлау процесін әлі тоқтатпа♪
Dialogue: 0,0:02:31.77,0:02:33.77,Default,,0,0,0,,♪Бүгін түнде ЖОЛДА ЖҮРГІЗ♪
Dialogue: 0,0:02:33.86,0:02:35.69,Default,,0,0,0,,♪Өтірік сияқты♪
Dialogue: 0,0:02:35.94,0:02:39.28,Default,,0,0,0,,♪Біреу менің қолымнан ұсташы♪
Dialogue: 0,0:02:39.40,0:02:44.53,Default,,0,0,0,,♪Сіз көре алмайтын ертеңгі күннің келуі міндетті емес♪
Dialogue: 0,0:02:45.20,0:02:49.54,Default,,0,0,0,,♪Дәл қазір мен жай ғана ұйықтағым келеді♪
Dialogue: 0,0:03:08.02,0:03:09.27,Default,,0,0,0,,Саған бәрібір?
Dialogue: 0,0:03:09.35,0:03:11.60,Default,,0,0,0,,Не? А... шынымен емес
Dialogue: 0,0:03:12.35,0:03:15.19,Default,,0,0,0,,Бұл жерді қорғау осы адамдардың міндеті шығар.
Dialogue: 0,0:03:15.40,0:03:17.57,Default,,0,0,0,,Ол әлдеқашан өлді.
Dialogue: 0,0:03:17.78,0:03:19.69,Default,,0,0,0,,Хаха... Дұрыс.
Dialogue: 0,0:03:19.78,0:03:20.65,Default,,0,0,0,,Одан да көп —
Dialogue: 0,0:03:21.03,0:03:24.91,Default,,0,0,0,,Мен бұл жерден қашып кеткім келеді, маған көмектесіңізші.
Dialogue: 0,0:03:25.28,0:03:26.58,Default,,0,0,0,,Олай болса, тезірек барайық.
Dialogue: 0,0:03:35.25,0:03:36.29,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:03:37.63,0:03:40.84,Default,,0,0,0,,Мен алғаш сөйлескен кездегі ыңғайсыздықты есіме түсірдім.
Dialogue: 0,0:03:41.38,0:03:45.93,Default,,0,0,0,,Әпкесі үшін алаңдайтынын айтады, бірақ әйтеуір өтірік сияқты...
Dialogue: 0,0:03:46.47,0:03:49.93,Default,,0,0,0,,Оны деми-адам деп атағаннан гөрі, бұл балада бірдеңе дұрыс емес.
Dialogue: 0,0:03:50.64,0:03:55.31,Default,,0,0,0,,Мен мәре сәтсіз аяқталды деп ойладым, бірақ мен күтемін және көремін.
Dialogue: 0,0:03:57.32,0:03:58.19,Default,,0,0,0,,(шу)
Dialogue: 0,0:03:59.44,0:04:00.19,Default,,0,0,0,,Ха...
Dialogue: 0,0:04:06.53,0:04:09.95,Default,,0,0,0,,Атпа! біз күзетші емеспіз
Dialogue: 0,0:04:10.25,0:04:11.04,Default,,0,0,0,,сені бәсекелес деп санайтын Бакуго мен Тодороки емес
Dialogue: 0,0:04:12.41,0:04:13.41,Default,,0,0,0,,Тезірек... (мылтық)
Dialogue: 0,0:04:14.17,0:04:14.79,Default,,0,0,0,,Ах
Dialogue: 0,0:04:14.87,0:04:16.29,Default,,0,0,0,,Хек... (Кондо) Хек...
Dialogue: 0,0:04:16.63,0:04:19.67,Default,,0,0,0,,Мм... сен мені өлтіресің бе?
Dialogue: 0,0:04:19.92,0:04:23.01,Default,,0,0,0,,Хмм... Мен барлық сақтық шараларын қолданамын.
Dialogue: 0,0:04:23.55,0:04:24.63,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:27.60,0:04:30.39,Default,,0,0,0,,Қарғыс атсын... Нагай-кун
Dialogue: 0,0:04:30.97,0:04:32.73,Default,,0,0,0,,А... жоқ, мм...
Dialogue: 0,0:04:33.39,0:04:36.19,Default,,0,0,0,,Маған бұлай айту қиын, себебі мен саған көмектесіп жатырмын, бірақ...
Dialogue: 0,0:04:36.52,0:04:39.82,Default,,0,0,0,,Ол қарсылық көрсетпейді, сондықтан оны өлтірудің қажеті жоқ...
Dialogue: 0,0:04:40.44,0:04:42.69,Default,,0,0,0,,Ол тыныштандыратын мылтық тығып жатқан болуы мүмкін.
Dialogue: 0,0:04:44.74,0:04:49.16,Default,,0,0,0,,А...олай болса, соқыр қылу немесе қолын сындыру қалай?
Dialogue: 0,0:04:49.53,0:04:52.20,Default,,0,0,0,,Нагай-кун, сен...
Dialogue: 0,0:04:53.33,0:04:54.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:54.66,0:04:56.37,Default,,0,0,0,,Бұл сәтсіз болды.
Dialogue: 0,0:04:58.54,0:04:59.75,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:04:59.88,0:05:00.67,Default,,0,0,0,,Гррр…
Dialogue: 0,0:05:04.01,0:05:06.97,Default,,0,0,0,,Сен мені атып тастадың...
Dialogue: 0,0:05:07.59,0:05:11.01,Default,,0,0,0,,Ах... Кешіріңіз, мен жай ғана...
Dialogue: 0,0:05:11.10,0:05:11.93,Default,,0,0,0,,Гофу…
Dialogue: 0,0:05:13.18,0:05:14.56,Default,,0,0,0,,Нагай…
Dialogue: 0,0:05:15.39,0:05:19.56,Default,,0,0,0,,Мен де сені өлтіремін...
Dialogue: 0,0:05:22.32,0:05:24.61,Default,,0,0,0,,IBM - субстанция
Dialogue: 0,0:05:24.86,0:05:26.40,Default,,0,0,0,,Онда неге оны көрмейсің?
Dialogue: 0,0:05:27.24,0:05:28.82,Default,,0,0,0,,Сіз мұны көре аласыз ба?
Dialogue: 0,0:05:29.12,0:05:29.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:30.33,0:05:31.37,Default,,0,0,0,,Қазір оқу уақыты
Dialogue: 0,0:05:31.99,0:05:35.04,Default,,0,0,0,,Жарық көзінен шыққан жарық материал арқылы шағылысады.
Dialogue: 0,0:05:35.20,0:05:38.42,Default,,0,0,0,,Көз оны қабылдайды, ал адам затты көреді.
Dialogue: 0,0:05:40.13,0:05:42.75,Default,,0,0,0,,Сонда шыны неге мөлдір болады?
Dialogue: 0,0:05:42.96,0:05:45.72,Default,,0,0,0,,Шыны – жарықты өткізетін зат.
Dialogue: 0,0:05:45.80,0:05:47.72,Default,,0,0,0,,Өйткені ол тұрады
Dialogue: 0,0:05:48.05,0:05:52.22,Default,,0,0,0,,Әйнектің әдеттегі өткізгіштігі 80-90 пайызды құрайды
Dialogue: 0,0:05:52.60,0:05:55.81,Default,,0,0,0,,IBM бүкіл денесі 100% өткізгіштікке ие.
Dialogue: 0,0:05:55.89,0:05:58.48,Default,,0,0,0,,Ол белгісіз заттан тұрады.
Dialogue: 0,0:05:59.02,0:06:01.73,Default,,0,0,0,,Мұны қатты қабылдамаңыз, Рикуса.
Dialogue: 0,0:06:01.98,0:06:07.11,Default,,0,0,0,,Ол өзінің барлық жабайы теорияларының арқасында ешкімнің айналысқысы келмейтін адам болды.
Dialogue: 0,0:06:07.24,0:06:08.32,Default,,0,0,0,,Жапонияда жоқ
Dialogue: 0,0:06:08.40,0:06:10.45,Default,,0,0,0,,Кедей елдер мойындаған нәрсе —
Dialogue: 0,0:06:10.53,0:06:12.74,Default,,0,0,0,,Икуя-кун, сен сондай бақыттысың ба?
Dialogue: 0,0:06:12.87,0:06:14.66,Default,,0,0,0,,Өйткені ол тас бас
Dialogue: 0,0:06:14.74,0:06:18.37,Default,,0,0,0,,Мен келесі кезеңге өте алмаймын, Кіші мырза.
Dialogue: 0,0:06:21.92,0:06:23.17,Default,,0,0,0,,Ол шықпайды.
Dialogue: 0,0:06:23.54,0:06:26.59,Default,,0,0,0,,Жабдық бөлмесі камераның ауқымынан тыс. Ол осылай көрінеді...
Dialogue: 0,0:06:28.84,0:06:30.84,Default,,0,0,0,,Тозаки мырза, у...
Dialogue: 0,0:06:31.51,0:06:33.47,Default,,0,0,0,,Мен күресуім керек пе?
Dialogue: 0,0:06:33.55,0:06:35.14,Default,,0,0,0,,Мен оның жақсы екеніне сенімдімін.
Dialogue: 0,0:06:35.35,0:06:38.85,Default,,0,0,0,,Бұл жерге біреу басып кірсе, мені кім қорғайды?
Dialogue: 0,0:06:39.44,0:06:43.65,Default,,0,0,0,,Сіз осында қаласыз және ешқашан ешқайда кетпейсіз.
Dialogue: 0,0:06:45.23,0:06:46.07,Default,,0,0,0,,Иә
Dialogue: 0,0:06:58.45,0:07:00.37,Default,,0,0,0,,Сен қайда жасырдың?
Dialogue: 0,0:07:01.54,0:07:02.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:07.09,0:07:09.84,Default,,0,0,0,,Менің қаруым жоқ, жолды білмеймін.
Dialogue: 0,0:07:10.22,0:07:11.63,Default,,0,0,0,,Мен қалай құтылуым керек?
Dialogue: 0,0:07:13.51,0:07:16.01,Default,,0,0,0,,Мен деми-адаммен жасырынып қаламын деп ешқашан ойламадым.
Dialogue: 0,0:07:16.10,0:07:18.02,Default,,0,0,0,,Эй, сен мені қорғадың.
Dialogue: 0,0:07:18.10,0:07:21.31,Default,,0,0,0,,Ақымақ болма! Оны алғаш шақырған да осы.
Dialogue: 0,0:07:21.39,0:07:23.19,Default,,0,0,0,,Осы жігіттің кесірінен қанша адам өлді деп ойлайсың?
Dialogue: 0,0:07:23.48,0:07:25.82,Default,,0,0,0,,Мен оны өлтірген жоқпын.
Dialogue: 0,0:07:26.27,0:07:28.69,Default,,0,0,0,,Бірінші, егер сіз мұны айтсаңыз -
Dialogue: 0,0:07:29.90,0:07:32.91,Default,,0,0,0,,Маған не істегеніңді ұмытқан жоқпын.
Dialogue: 0,0:07:35.62,0:07:39.50,Default,,0,0,0,,Хм... Мен оны міндетті түрде сараптама үстеліне қайта қоямын.
Dialogue: 0,0:07:39.58,0:07:42.42,Default,,0,0,0,,Маған ұнамайды! Мен өлсем де қайтқым келмейді
Dialogue: 0,0:07:44.33,0:07:46.79,Default,,0,0,0,,Мен бұл жерден міндетті түрде құтыламын.
Dialogue: 0,0:07:47.34,0:07:49.71,Default,,0,0,0,,Сіз де сыртқа көшкіңіз келеді, солай ма?
Dialogue: 0,0:07:50.59,0:07:53.97,Default,,0,0,0,,Мақсат бір, бер, ал.
Dialogue: 0,0:07:54.80,0:07:57.60,Default,,0,0,0,,Мен жем болып, сені бұл жерден алып кетемін.
Dialogue: 0,0:07:58.26,0:08:01.68,Default,,0,0,0,,Сен маған сырттағы қауіпсіз жолды көрсет.
Dialogue: 0,0:08:01.81,0:08:04.02,Default,,0,0,0,,... жақсы ма? Қандай алдамшы...
Dialogue: 0,0:08:04.31,0:08:05.77,Default,,0,0,0,,Мен өлмеймін
Dialogue: 0,0:08:05.90,0:08:06.98,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:08:07.06,0:08:09.07,Default,,0,0,0,,Жарайды! Себебі мен мотивация алдым
Dialogue: 0,0:08:09.15,0:08:09.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:10.94,0:08:13.11,Default,,0,0,0,,Нагай-кун, тыңдап тұрсың ба?
Dialogue: 0,0:08:13.20,0:08:13.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:14.82,0:08:18.99,Default,,0,0,0,,Сіз өлмейтін қауіпсіздік сезімі сізді барлық шешімдерді оңай қабылдауға мәжбүр етеді.
Dialogue: 0,0:08:20.04,0:08:22.71,Default,,0,0,0,,Өлтіремін десем, бұл метафора емес еді.
Dialogue: 0,0:08:23.79,0:08:25.54,Default,,0,0,0,,Деми-адамдар өледі.
Dialogue: 0,0:08:25.92,0:08:27.54,Default,,0,0,0,,Цк, қажет емес заттар...
Dialogue: 0,0:08:27.63,0:08:28.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:29.13,0:08:32.13,Default,,0,0,0,,Өлімді қалай анықтайтыныңызға байланысты...
Dialogue: 0,0:08:34.01,0:08:38.76,Default,,0,0,0,,Деми-адам еттің үлкен бөлігін өзегі ретінде пайдаланады және қайта қалпына келу үшін шашылған ет бөліктерін жинайды.
Dialogue: 0,0:08:39.64,0:08:44.81,Default,,0,0,0,,Алайда тым алысқа кеткен ет бөліктері қалпына келтірілмейді және жаңадан жасалады.
Dialogue: 0,0:08:45.44,0:08:48.40,Default,,0,0,0,,Бас болса ше?
Dialogue: 0,0:08:49.36,0:08:51.61,Default,,0,0,0,,Уәде берейік.
Dialogue: 0,0:08:51.90,0:08:55.28,Default,,0,0,0,,Бұдан былай мен сенің басыңды кесіп аламын.
Dialogue: 0,0:08:58.53,0:09:00.87,Default,,0,0,0,,Және оның басын көтеріңіз
Dialogue: 0,0:09:01.45,0:09:07.25,Default,,0,0,0,,Жаңа бастың өлгенше қалай жасалатынын бақылаңыз
Dialogue: 0,0:09:07.88,0:09:14.55,Default,,0,0,0,,Енді сіздің жаңа басыңыз, миыңыз және жүрегіңіз қазір кімсіз?
Dialogue: 0,0:09:16.26,0:09:17.39,Default,,0,0,0,,№
Dialogue: 0,0:09:17.89,0:09:21.51,Default,,0,0,0,,Сіз мұндасыз, бұл жерде.
Dialogue: 0,0:09:22.18,0:09:22.89,Default,,0,0,0,,А...
Dialogue: 0,0:09:23.98,0:09:29.52,Default,,0,0,0,,Мені өлтіргенің үшін сені өкіндіремін.
Dialogue: 0,0:09:30.23,0:09:31.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:32.11,0:09:33.65,Default,,0,0,0,,Нагай... Кей-кун
Dialogue: 0,0:09:34.78,0:09:36.24,Default,,0,0,0,,Шығаруға болмайды.
Dialogue: 0,0:09:36.57,0:09:37.74,Default,,0,0,0,,Ех... (Кондо)! ?
Dialogue: 0,0:09:40.78,0:09:41.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:44.62,0:09:45.83,Default,,0,0,0,,Шығармаңыз
Dialogue: 0,0:09:47.25,0:09:48.87,Default,,0,0,0,,Сізді шығарып салыңыз
Dialogue: 0,0:09:49.71,0:09:52.88,Default,,0,0,0,,Сізге... мүмкін
Dialogue: 0,0:10:01.26,0:10:01.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:02.68,0:10:04.52,Default,,0,0,0,,Мойынның артқы жағына... жұлынға бағыттау
Dialogue: 0,0:10:04.68,0:10:07.14,Default,,0,0,0,,Егер бәрі ойдағыдай болса, мен оны өлтірмей-ақ барлық жүйкені кесіп аламын.
Dialogue: 0,0:10:08.27,0:10:08.81,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:08.94,0:10:09.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:09.98,0:10:11.86,Default,,0,0,0,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:10:12.02,0:10:12.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:13.19,0:10:13.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:17.45,0:10:19.99,Default,,0,0,0,,Гррр... Ааа!
Dialogue: 0,0:10:20.07,0:10:21.03,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:24.33,0:10:26.41,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:31.50,0:10:32.67,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:32.88,0:10:34.13,Default,,0,0,0,,Сіз уәде бердіңіз!
Dialogue: 0,0:10:34.96,0:10:37.80,Default,,0,0,0,,Мен қашуға көмектесуге жауапты емеспін.
Dialogue: 0,0:10:38.38,0:10:43.76,Default,,0,0,0,,Ауырды... Арғх... Тоқтауым керек еді.
Dialogue: 0,0:10:45.10,0:10:48.73,Default,,0,0,0,,Қарғыс атсын, қарғыс атсын! Неге бұлай көрінесің?
Dialogue: 0,0:10:50.85,0:10:51.52,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:56.28,0:10:58.15,Default,,0,0,0,,Не? Яғни...
Dialogue: 0,0:11:03.45,0:11:05.66,Default,,0,0,0,,Бұл не? Сомасы
Dialogue: 0,0:11:09.04,0:11:09.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:11.54,0:11:12.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:16.55,0:11:18.92,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:11:19.92,0:11:21.38,Default,,0,0,0,,Э? Қайда?
Dialogue: 0,0:11:22.22,0:11:26.72,Default,,0,0,0,,Бұл Нагай-күннің... пішіні тегіс
Dialogue: 0,0:11:29.56,0:11:30.35,Default,,0,0,0,,Енді бәрі жақсы
Dialogue: 0,0:11:30.64,0:11:33.85,Default,,0,0,0,,Қолыңызды сындырсаңыз ше?
Dialogue: 0,0:11:33.94,0:11:34.65,Default,,0,0,0,,Аһ!
Dialogue: 0,0:11:35.65,0:11:37.61,Default,,0,0,0,,Әрине, қара елес —
Dialogue: 0,0:11:37.69,0:11:41.57,Default,,0,0,0,,Ол бұйрықсыз сөздерді қайталап, біраз қыдыруы мүмкін, бірақ...
Dialogue: 0,0:11:42.82,0:11:43.61,Default,,0,0,0,,Техникалық колледжде күтіп тұрған сиқыршыларды мүмкіндігінше үнсіз жойып жібергім келеді.
Dialogue: 0,0:11:44.49,0:11:50.00,Default,,0,0,0,,(Кей IBM айқайы)
Dialogue: 0,0:11:51.04,0:11:54.13,Default,,0,0,0,,Бұл жігіт аздап өзімшіл.
Dialogue: 0,0:11:55.42,0:11:58.00,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:12:00.26,0:12:03.43,Default,,0,0,0,,Белгісіз материалдан жасалған көрінбейтін адам?
Dialogue: 0,0:12:04.22,0:12:08.39,Default,,0,0,0,,Мұның адам өлместігіне қандай қатысы бар?
Dialogue: 0,0:12:08.56,0:12:11.39,Default,,0,0,0,,Неліктен адамдар мандаринді жейді?
Dialogue: 0,0:12:11.73,0:12:12.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:13.31,0:12:16.65,Default,,0,0,0,,Амиро Зама Соның арқасында мен құтқарылдым.
Dialogue: 0,0:12:19.86,0:12:23.36,Default,,0,0,0,,Адам С витаминін өздігінен өндіре алмайды
Dialogue: 0,0:12:23.74,0:12:26.91,Default,,0,0,0,,Сондықтан оны жемістерден алуымыз керек.
Dialogue: 0,0:12:27.70,0:12:31.50,Default,,0,0,0,,Қара елес... Деми-адамдар мұны істей алады.
Dialogue: 0,0:12:31.58,0:12:33.71,Default,,0,0,0,,Тамақтанудан өлген демиадамдар —
Dialogue: 0,0:12:33.79,0:12:37.75,Default,,0,0,0,,Тіпті оны регенерация кезінде жасауға болады.
Dialogue: 0,0:12:38.71,0:12:41.76,Default,,0,0,0,,Менің айтайын дегенім, оның өлмейтіндікке қатысы жоқ.
Dialogue: 0,0:12:41.84,0:12:42.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:43.17,0:12:44.55,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:12:45.38,0:12:49.97,Default,,0,0,0,,Ол белгісіз субстанция жасаумен байланыссыз болуы мүмкін емес.
Dialogue: 0,0:12:50.35,0:12:54.06,Default,,0,0,0,,А... а... жүр!
Dialogue: 0,0:12:54.19,0:12:55.98,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:13:03.57,0:13:04.82,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:13:06.07,0:13:06.82,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:07.70,0:13:09.24,Default,,0,0,0,,Мен мұны осы бөлмеде жасаймын.
Dialogue: 0,0:13:09.87,0:13:13.58,Default,,0,0,0,,Ол тіпті белгілерді аңдып, сол адамды өлтіруі мүмкін.
Dialogue: 0,0:13:14.54,0:13:15.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:16.79,0:13:21.09,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:26.22,0:13:28.93,Default,,0,0,0,,Күрсін... Күрсін...
Dialogue: 0,0:13:35.39,0:13:37.19,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:37.35,0:13:38.23,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:13:38.85,0:13:39.40,Default,,0,0,0,,Е! ?
Dialogue: 0,0:13:40.81,0:13:41.48,Default,,0,0,0,,...
Dialogue: 0,0:13:44.15,0:13:47.82,Default,,0,0,0,,Уф... Уф... Не?
Dialogue: 0,0:13:49.07,0:13:51.41,Default,,0,0,0,,А... сіз оны көре аласыз ба?
Dialogue: 0,0:13:53.04,0:13:57.71,Default,,0,0,0,,Мұны адамдар күшті эмоцияларды білдіргенде де көре алады.
Dialogue: 0,0:13:58.75,0:14:00.58,Default,,0,0,0,,Адам өлтіру ниеті... т.б.
Dialogue: 0,0:14:00.88,0:14:04.96,Default,,0,0,0,,Ха... та... маған көмектесші...
Dialogue: 0,0:14:06.38,0:14:08.22,Default,,0,0,0,,Кешіріңіз, бұл мүмкін емес.
Dialogue: 0,0:14:08.43,0:14:12.64,Default,,0,0,0,,Мен өлтіргенді жақсы көремін.
Dialogue: 0,0:14:12.85,0:14:14.89,Default,,0,0,0,,Ууууууууууууу...
Dialogue: 0,0:14:16.48,0:14:20.23,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:14:22.90,0:14:25.19,Default,,0,0,0,,Ах... ха... ха...
Dialogue: 0,0:14:25.32,0:14:26.65,Default,,0,0,0,,Нагай-кун, осылай!
Dialogue: 0,0:14:26.94,0:14:30.36,Default,,0,0,0,,Иә? Ахх...
Dialogue: 0,0:14:32.07,0:14:33.58,Default,,0,0,0,,Неге әлі осындасың?
Dialogue: 0,0:14:33.70,0:14:36.62,Default,,0,0,0,,Өрт сөндіру құбыры Маған оны пайдалануды үйрену керек.
Dialogue: 0,0:14:36.75,0:14:40.04,Default,,0,0,0,,А... жоқ, маған керегі жоқ.
Dialogue: 0,0:14:40.21,0:14:41.13,Default,,0,0,0,,Бұдан басқа, қауесетке сенсек, сол жігіт... өзімен бірге екі Өлім дәптерін алып кеткен.
Dialogue: 0,0:14:44.63,0:14:47.38,Default,,0,0,0,,Мен осы биіктікте өле аламын ба?
Dialogue: 0,0:14:48.30,0:14:51.01,Default,,0,0,0,,Бірақ мен күткенім бұл ғана емес.
Dialogue: 0,0:14:51.51,0:14:52.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:52.68,0:14:56.64,Default,,0,0,0,,Егер сіз төмен түссеңіз, мен сізді көлігіммен бір жерге апара аламын.
Dialogue: 0,0:14:57.77,0:14:58.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:59.18,0:15:03.06,Default,,0,0,0,,Мен бұл жұмыс деп ойладым, бірақ мен шынымен қорқынышты нәрсе жасадым.
Dialogue: 0,0:15:03.36,0:15:05.94,Default,,0,0,0,,Мен сенің өзіңді қауіпсіз сезінуіңді қалайтын тағы бір нәрсе бар.
Dialogue: 0,0:15:07.32,0:15:10.03,Default,,0,0,0,,Сіз әлі де өзіңізсіз
Dialogue: 0,0:15:10.70,0:15:13.41,Default,,0,0,0,,Тәжірибе кезінде бас кесу жүргізілген жоқ.
Dialogue: 0,0:15:13.49,0:15:16.33,Default,,0,0,0,,Жүк көлігі апат болған жерде ми жасушалары қалмады.
Dialogue: 0,0:15:16.45,0:15:18.08,Default,,0,0,0,,Мен жеткізгім келгені осы болды
Dialogue: 0,0:15:19.25,0:15:22.25,Default,,0,0,0,,Сіз басқаларға қалай қамқорлық жасай аласыз?
Dialogue: 0,0:15:22.71,0:15:23.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:24.34,0:15:26.92,Default,,0,0,0,,Біреудің мұңын түсіне аласың ба?
Dialogue: 0,0:15:27.80,0:15:31.72,Default,,0,0,0,,Мен үстірттен басқа ешкімді уайымдаған емеспін.
Dialogue: 0,0:15:32.26,0:15:35.76,Default,,0,0,0,,Нагай-кун, сен әлі қызықсың.
Dialogue: 0,0:15:36.51,0:15:39.48,Default,,0,0,0,,Оның ішінде апаң айтқан адамдық.
Dialogue: 0,0:15:44.31,0:15:46.77,Default,,0,0,0,,Сенің ағаң қандай адам?
Dialogue: 0,0:15:47.15,0:15:49.82,Default,,0,0,0,,Дуэт сенен осылай сұрады, солай ма?
Dialogue: 0,0:15:50.32,0:15:50.99,Default,,0,0,0,,Иә
Dialogue: 0,0:15:51.78,0:15:53.49,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:15:55.70,0:15:56.74,Default,,0,0,0,,Менің ағам...
Dialogue: 0,0:15:59.04,0:15:59.70,Default,,0,0,0,,Қоқыс
Dialogue: 0,0:16:00.25,0:16:00.91,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:01.54,0:16:02.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:02.79,0:16:04.17,Default,,0,0,0,,Жел күшті.
Dialogue: 0,0:16:04.25,0:16:04.96,Default,,0,0,0,,Жасыру
Dialogue: 0,0:16:05.08,0:16:05.92,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:08.88,0:16:09.96,Default,,0,0,0,,Уф! Ах...
Dialogue: 0,0:16:13.43,0:16:16.60,Default,,0,0,0,,Маск... Хаха, болды...
Dialogue: 0,0:16:16.68,0:16:17.51,Default,,0,0,0,,Қоқыс
Dialogue: 0,0:16:17.68,0:16:18.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:20.93,0:16:25.81,Default,,0,0,0,,Сіздің шынайы болмысыңыз парасатты және салқын.
Dialogue: 0,0:16:27.36,0:16:28.40,Default,,0,0,0,,Бұл адам –
Dialogue: 0,0:16:29.53,0:16:30.94,Default,,0,0,0,,Мен сондай адаммын.
Dialogue: 0,0:16:31.78,0:16:35.66,Default,,0,0,0,,Әй, егер сен өлсең, мен саған көмектесу үшін ештеңе істей алмаймын ...
Dialogue: 0,0:16:36.32,0:16:39.49,Default,,0,0,0,,Ең қысқа қашықтық –...сол жолмен!
Dialogue: 0,0:16:44.50,0:16:45.54,Default,,0,0,0,,Уф! мен...
Dialogue: 0,0:16:45.62,0:16:46.33,Default,,0,0,0,,(ауада атыс дыбысы)
Dialogue: 0,0:16:46.92,0:16:50.09,Default,,0,0,0,,Хмм, кешіріңіз, оқ-дәрі бітті.
Dialogue: 0,0:16:50.55,0:16:52.30,Default,,0,0,0,,Уф... (Номура жөтеледі)
Dialogue: 0,0:16:52.38,0:16:53.05,Default,,0,0,0,,өтіңіз! ?
Dialogue: 0,0:16:53.72,0:16:54.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:55.18,0:16:56.89,Default,,0,0,0,,Сіз әлі тірісіз бе? ?
Dialogue: 0,0:16:57.30,0:17:00.22,Default,,0,0,0,,Бұл соңғы кезең, Нагай-кун.
Dialogue: 0,0:17:00.35,0:17:01.93,Default,,0,0,0,,Не... аа...
Dialogue: 0,0:17:02.47,0:17:03.48,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:17:06.85,0:17:07.69,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:10.07,0:17:13.32,Default,,0,0,0,,Қара елес! Қайтадан шық!
Dialogue: 0,0:17:14.90,0:17:16.03,Default,,0,0,0,,Шық!
Dialogue: 0,0:17:19.12,0:17:20.78,Default,,0,0,0,,А, шықты!
Dialogue: 0,0:17:23.95,0:17:26.92,Default,,0,0,0,,Жаңбыр жауып тұрса да... жарай ма?
Dialogue: 0,0:17:34.76,0:17:35.80,Default,,0,0,0,,Басты көздеп отырсыз ба?
Dialogue: 0,0:17:38.68,0:17:40.76,Default,,0,0,0,,Сәлем! Сіз де басты мақсат етіңіз!
Dialogue: 0,0:17:41.39,0:17:45.60,Default,,0,0,0,,Мен неге сонша мысқыл болуым керек...
Dialogue: 0,0:17:46.44,0:17:47.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:47.48,0:17:50.98,Default,,0,0,0,,О, бұл керемет. Сіз де тапсырыстарды елемейсіз бе?
Dialogue: 0,0:17:51.27,0:17:56.65,Default,,0,0,0,,Жалғыз қалғаныма ренжідім... сондықтан... назар аудардым...
Dialogue: 0,0:17:57.78,0:18:01.16,Default,,0,0,0,,Бұл туралы бұрыннан айтпаңызшы.
Dialogue: 0,0:18:01.91,0:18:03.24,Default,,0,0,0,,Нагай... сен
Dialogue: 0,0:18:03.91,0:18:06.75,Default,,0,0,0,,Жақсы... қаш...
Dialogue: 0,0:18:08.67,0:18:09.58,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:18:16.17,0:18:18.47,Default,,0,0,0,,Неге... мен...
Dialogue: 0,0:18:19.09,0:18:24.06,Default,,0,0,0,,Менің ешкіммен жұмысым болған жоқ, оның қажеті де жоқ...
Dialogue: 0,0:18:24.18,0:18:26.27,Default,,0,0,0,,Мен басқа адамдарға мән бермедім.
Dialogue: 0,0:18:26.85,0:18:29.81,Default,,0,0,0,,Бірақ сіз көмектескіңіз келеді.
Dialogue: 0,0:18:31.52,0:18:32.61,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:37.03,0:18:40.03,Default,,0,0,0,,Оны осы жерден тастаңыз, бұл жалғыз жол
Dialogue: 0,0:18:41.45,0:18:46.12,Default,,0,0,0,,Сол жерде. Егер сіз бұталардың ішіне түсіп қалсаңыз, аман қалу мүмкіндігіңіз сөзсіз артады.
Dialogue: 0,0:18:47.00,0:18:49.04,Default,,0,0,0,,Көрдім, бұл Кей Нагай.
Dialogue: 0,0:18:49.12,0:18:52.17,Default,,0,0,0,,Ол зерттеушіге ұқсайтын адамды өлтірмекші сияқты.
Dialogue: 0,0:18:52.25,0:18:53.71,Default,,0,0,0,,Сіз кепілге алынғандарды айтасыз ба?
Dialogue: 0,0:18:53.79,0:18:56.76,Default,,0,0,0,,Сіз не істемексіз? Сіз осылай құтыла аласыз
Dialogue: 0,0:18:56.92,0:18:57.84,Default,,0,0,0,,Тозаки мырза...
Dialogue: 0,0:18:58.09,0:18:58.72,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:00.72,0:19:01.51,Default,,0,0,0,,Кума Рикуса
Dialogue: 0,0:19:01.59,0:19:02.34,Default,,0,0,0,,Не?
Dialogue: 0,0:19:02.76,0:19:07.22,Default,,0,0,0,,Анти-Аджин... «Анти-Аджин арнайы іріктеу тобын» шақыру үшін неше минут қажет?
Dialogue: 0,0:19:07.31,0:19:08.56,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:19:08.81,0:19:11.27,Default,,0,0,0,,«Азияға қарсы» басқа түрлерге қарсы шаралар нашарлаған кезде арналған.
Dialogue: 0,0:19:11.35,0:19:13.48,Default,,0,0,0,,Бұл асығыс іске қосылған уақытша бөлімше ғана!
Dialogue: 0,0:19:13.56,0:19:15.44,Default,,0,0,0,,Рикуса Коума, тыңдаңыз.
Dialogue: 0,0:19:15.61,0:19:18.53,Default,,0,0,0,,Қазіргі уақытта әртүрлі түрлерге қарсы қарсы шаралар табылған жоқ.
Dialogue: 0,0:19:18.61,0:19:19.74,Default,,0,0,0,,Қол астындағыларымды ұрысқа жіберуге дайынмын...
Dialogue: 0,0:19:19.82,0:19:21.24,Default,,0,0,0,,Бүгін сіздің мүмкіндігіңіз!
Dialogue: 0,0:19:21.41,0:19:22.24,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:19:22.32,0:19:25.08,Default,,0,0,0,,Неліктен Hat бүгін IBM қолданбады?
Dialogue: 0,0:19:25.24,0:19:27.33,Default,,0,0,0,,Біз осылай ойлауымыз керек емес пе?
Dialogue: 0,0:19:27.54,0:19:29.75,Default,,0,0,0,,Бүгін оны пайдалану мүмкін емес
Dialogue: 0,0:19:30.25,0:19:33.08,Default,,0,0,0,,Себебін білмеймін, бірақ мүмкіндігі жоғары
Dialogue: 0,0:19:33.67,0:19:36.96,Default,,0,0,0,,Танака қайта тұтқынға алынған кездегі мен бүгінгі күннің айырмашылығы бар.
Dialogue: 0,0:19:37.25,0:19:37.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:37.92,0:19:40.17,Default,,0,0,0,,Бізде енді мұндай мүмкіндік болмайды.
Dialogue: 0,0:19:40.63,0:19:41.72,Default,,0,0,0,,Кума Рикуса!
Dialogue: 0,0:19:45.76,0:19:48.72,Default,,0,0,0,,Тізелеріңізді «ит» пішініне келтіріңіз! Барайық!
Dialogue: 0,0:19:48.81,0:19:50.60,Default,,0,0,0,,Ух... жарайды... күте тұрыңыз.
Dialogue: 0,0:19:51.85,0:19:54.06,Default,,0,0,0,,Сіз мұны көре аласыз ба?
Dialogue: 0,0:19:54.77,0:19:55.65,Default,,0,0,0,,«Бұл»?
Dialogue: 0,0:19:57.57,0:19:58.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:05.41,0:20:08.29,Default,,0,0,0,,Сонымен қалай күресеміз?
Dialogue: 0,0:20:09.75,0:20:13.04,Default,,0,0,0,,Сіз де… сіздің басыңыз…
Dialogue: 0,0:20:18.59,0:20:19.25,Default,,0,0,0,,Әй! ?
Dialogue: 0,0:20:20.46,0:20:21.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:23.47,0:20:26.01,Default,,0,0,0,,Енді... Сато мырза?
Dialogue: 0,0:20:29.01,0:20:32.23,Default,,0,0,0,,Нағайдың кейбір естеліктері сіздің ойыңызға түсті ме?
Dialogue: 0,0:20:32.85,0:20:35.98,Default,,0,0,0,,Бастар бірге болғанда осындай нәрсе бола ма?
Dialogue: 0,0:20:37.02,0:20:40.61,Default,,0,0,0,,Нагай... сен... жүр.
Dialogue: 0,0:20:43.70,0:20:44.74,Default,,0,0,0,,(Кастердің айқайы)
Dialogue: 0,0:20:44.82,0:20:45.53,Default,,0,0,0,,Сіз оны тастадыңыз ба?
Dialogue: 0,0:20:45.61,0:20:46.57,Default,,0,0,0,,Мен оны тастадым!
Dialogue: 0,0:20:47.87,0:20:52.70,Default,,0,0,0,,Жарайды, бірақ бұл гипотеза дұрыс болса ғана.
Dialogue: 0,0:20:53.71,0:20:56.42,Default,,0,0,0,,Сіз мұны естідіңіз бе? Сіз қалай ойлайсыз? Доктор Огура
Dialogue: 0,0:20:57.38,0:21:00.92,Default,,0,0,0,,IBM сіз ойлағандай жан-жақты емес.
Dialogue: 0,0:21:01.46,0:21:04.09,Default,,0,0,0,,Пайдаланудың көптеген мүмкіндіктері бар...
Dialogue: 0,0:21:04.26,0:21:04.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:07.01,0:21:09.60,Default,,0,0,0,,Сіз мұны көре аласыз ба? Нагай мырза
Dialogue: 0,0:21:11.31,0:21:16.60,Default,,0,0,0,,Ол өзен су төгетін өзен. Қатты жаңбыр кезінде су тасқыны теңізге дейін ашылады.
Dialogue: 0,0:21:17.10,0:21:20.02,Default,,0,0,0,,Бұл құмар ойын, бірақ мен онымен құтыла аламын.
Dialogue: 0,0:21:20.61,0:21:23.15,Default,,0,0,0,,А... ха... ха...
Dialogue: 0,0:21:26.03,0:21:30.37,Default,,0,0,0,,Дәрігер, деми-адамдар туралы ақпаратты жария етуден аулақ болыңыз.
Dialogue: 0,0:21:30.53,0:21:34.16,Default,,0,0,0,,А... Аа, солай.
Dialogue: 0,0:21:35.41,0:21:38.38,Default,,0,0,0,,Сондықтан түсініктеме жоқ.
Dialogue: 0,0:21:38.88,0:21:40.09,Default,,0,0,0,,Шит… шит…
Dialogue: 0,0:21:44.55,0:21:45.17,Default,,0,0,0,,Хмф!
Dialogue: 0,0:21:45.72,0:21:46.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:46.76,0:21:47.84,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:21:48.55,0:21:52.39,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:21:52.51,0:21:54.14,Default,,0,0,0,,(Су дыбысы)
Dialogue: 0,0:21:54.39,0:21:56.77,Default,,0,0,0,,Ах! Кей Нагай өзенге барады!
Dialogue: 0,0:21:57.23,0:21:58.85,Default,,0,0,0,,Сіз нені айтасыз...
Dialogue: 0,0:22:01.23,0:22:03.86,Default,,0,0,0,,Үйге қайтайық. Үлгі қашып кетті.
Dialogue: 0,0:22:04.28,0:22:05.49,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:22:08.32,0:22:11.45,Default,,0,0,0,,Кей Нагай нысанның төбесінен өзенге секірді.
Dialogue: 0,0:22:11.66,0:22:15.75,Default,,0,0,0,,Зерттеуші болып көрінген нәрсені тастап, өзі өзенге секірді.
Dialogue: 0,0:22:16.12,0:22:18.12,Default,,0,0,0,,Соңғы бірнеше тәулікте жауған жаңбыр салдарынан өзен суының деңгейі айтарлықтай көтерілді...
Dialogue: 0,0:22:18.21,0:22:19.37,Default,,0,0,0,,Көріп тұрсың ба, осы қызыл шамы бар ауданда…
Dialogue: 0,0:22:19.50,0:22:20.75,Default,,0,0,0,,лайлы ағынға айналды.
Dialogue: 0,0:22:31.55,0:22:37.18,Default,,0,0,0,,♪Егер тілегім орындалса, тағы да♪
Dialogue: 0,0:22:37.68,0:22:43.07,Default,,0,0,0,,♪Мен сенің жүрегіңді қозғағым келеді♪
Dialogue: 0,0:22:43.69,0:22:48.90,Default,,0,0,0,,♪Қанша қараңғы болса да, іздеймін♪
Dialogue: 0,0:22:49.74,0:22:54.16,Default,,0,0,0,,♪Бір ғана шам♪
Dialogue: 0,0:22:55.70,0:22:59.12,Default,,0,0,0,,♪Жұлдыздарға қарағанымда♪
Dialogue: 0,0:22:59.50,0:23:01.29,Default,,0,0,0,,♪Алыста болса да♪
Dialogue: 0,0:23:01.71,0:23:07.09,Default,,0,0,0,,♪Сол бір жұлдызды аспанға қарап♪
Dialogue: 0,0:23:07.55,0:23:13.10,Default,,0,0,0,,♪Жүрегімнің аспанында құлайтын сияқты♪
Dialogue: 0,0:23:13.72,0:23:17.85,Default,,0,0,0,,♪Сіздің күлкіңіз бен жылуыңыз♪
Dialogue: 0,0:23:18.14,0:23:19.35,Default,,0,0,0,,♪Мені тыңда♪
Dialogue: 0,0:23:19.56,0:23:24.52,Default,,0,0,0,,♪Кетіп, Жалғыз күндерді көргенше♪
Dialogue: 0,0:23:24.61,0:23:27.78,Default,,0,0,0,,♪Сүйу деген нені білдіреді?♪
Dialogue: 0,0:23:27.98,0:23:31.07,Default,,0,0,0,,♪Мен білемін деп ойладым♪
Dialogue: 0,0:23:31.70,0:23:36.37,Default,,0,0,0,,♪Менің алдымда болғанның бәрін сезіну♪
Dialogue: 0,0:23:36.45,0:23:39.66,Default,,0,0,0,,♪Мен маңызды нәрсені жоғалтып алдым♪
Dialogue: 0,0:23:39.83,0:23:44.08,Default,,0,0,0,,♪Шынайы махаббатты тану♪
Dialogue: 0,0:23:45.54,0:23:49.97,Default,,0,0,0,,♪Айтайын қазір, Қаншалықты жақынсың♪
Dialogue: 0,0:23:51.47,0:23:57.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory