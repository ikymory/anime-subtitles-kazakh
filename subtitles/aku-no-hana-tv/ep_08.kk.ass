Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:39.58,0:00:47.62,Default,,0,0,0,,Хана га Саку Итайо Хана га Хана га Саку Итайо
Dialogue: 0,0:00:48.12,0:00:59.54,Default,,0,0,0,,Желдің қорқынышты болғаны сонша, гүлдің жайқалғанын ешкім көрмеді.
Dialogue: 0,0:01:31.87,0:01:36.16,Default,,0,0,0,,Бір-біріне қарау аздап ұят
Dialogue: 0,0:01:36.50,0:01:40.45,Default,,0,0,0,,Мен әлі ертеңді күтемін
Dialogue: 0,0:01:40.58,0:01:44.54,Default,,0,0,0,,Себебі мен жалғыз қалудан қорқамын
Dialogue: 0,0:01:44.70,0:01:48.95,Default,,0,0,0,,Уәде берейік
Dialogue: 0,0:01:49.58,0:01:53.83,Default,,0,0,0,,Айнаға теңестірілген кескін бұзылып жатыр
Dialogue: 0,0:01:53.91,0:01:58.50,Default,,0,0,0,,Бұл біз жасамақ болған басқатырғыш сияқты
Dialogue: 0,0:02:00.25,0:02:06.95,Default,,0,0,0,,Мен қалай жүкті боламын?
Dialogue: 0,0:02:07.41,0:02:08.83,Default,,0,0,0,,Ұйқысы мүлде жоқ
Dialogue: 0,0:02:09.79,0:02:11.95,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:02:12.33,0:02:13.08,Default,,0,0,0,,Касуга-кун
Dialogue: 0,0:02:13.16,0:02:14.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:15.08,0:02:15.79,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:16.25,0:02:18.41,Default,,0,0,0,,Хехе, біраз уақыттан кейін бірінші рет сергіп қалғандай болдым.
Dialogue: 0,0:02:18.50,0:02:19.87,Default,,0,0,0,,Сіз оны көрдіңіз бе? олардың жүздері
Dialogue: 0,0:02:20.79,0:02:21.79,Default,,0,0,0,,Мақтан тұт
Dialogue: 0,0:02:22.04,0:02:24.00,Default,,0,0,0,,Мен ақырында терінің бір қабатын аршып алдым.
Dialogue: 0,0:02:25.87,0:02:30.04,Default,,0,0,0,,Болатқа жайылған гүлдер бал дәмін татады
Dialogue: 0,0:02:30.12,0:02:34.91,Default,,0,0,0,,Гүлденбейтін гүлдер Жамандықтың бүршіктерін тер
Dialogue: 0,0:02:35.12,0:02:39.41,Default,,0,0,0,,Желпілдеген жапырақшалар сияқты
Dialogue: 0,0:02:39.50,0:02:43.62,Default,,0,0,0,,(Мені жалғыз қалдырмаңыз!)
Dialogue: 0,0:02:43.75,0:02:49.29,Default,,0,0,0,,Аздап ағып кете бастады.
Dialogue: 0,0:08:59.37,0:09:00.16,Default,,0,0,0,,Хаха...
Dialogue: 0,0:09:05.50,0:09:06.45,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:09:07.50,0:09:09.04,Default,,0,0,0,,Себебі мен осындамын
Dialogue: 0,0:09:12.04,0:09:12.75,Default,,0,0,0,,Иә
Dialogue: 0,0:09:15.08,0:09:16.83,Default,,0,0,0,,Сәлем, Накамура мырза
Dialogue: 0,0:09:20.29,0:09:24.70,Default,,0,0,0,,Бірер сағаттан кейін барлығы сол сыныпқа қарайды.
Dialogue: 0,0:09:27.08,0:09:28.50,Default,,0,0,0,,Саэки мырза да...
Dialogue: 0,0:09:31.12,0:09:32.83,Default,,0,0,0,,Не болады?
Dialogue: 0,0:09:44.04,0:09:44.87,Default,,0,0,0,,Әй
Dialogue: 0,0:09:45.79,0:09:46.87,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:09:58.00,0:09:59.12,Default,,0,0,0,,Бүгін кездескенше
Dialogue: 0,0:10:02.16,0:10:02.83,Default,,0,0,0,,Иә
Dialogue: 0,0:10:04.58,0:10:05.41,Default,,0,0,0,,Бүгін кездескенше
Dialogue: 0,0:10:47.20,0:10:48.66,Default,,0,0,0,,Ұйқысы мүлде жоқ
Dialogue: 0,0:10:49.91,0:10:52.70,Default,,0,0,0,,Мен... Мен...
Dialogue: 0,0:10:54.37,0:10:56.33,Default,,0,0,0,,Енді артқа жол жоқ.
Dialogue: 0,0:10:57.37,0:11:03.66,Default,,0,0,0,,Бүгін менің қалыпты өмірім аяқталады.
Dialogue: 0,0:11:06.87,0:11:07.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:07.91,0:11:09.79,Default,,0,0,0,,А, мен таң қалдым.
Dialogue: 0,0:11:09.95,0:11:12.08,Default,,0,0,0,,Не, Такао, сен ояусың ба?
Dialogue: 0,0:11:12.25,0:11:14.83,Default,,0,0,0,,Ха, мен әрқашан соңғы минутқа дейін ұйықтаймын.
Dialogue: 0,0:11:15.62,0:11:17.95,Default,,0,0,0,,Анашым, сіздің өмір жасыңыз қысқарды.
Dialogue: 0,0:11:18.25,0:11:18.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:18.95,0:11:19.58,Default,,0,0,0,,Га
Dialogue: 0,0:11:21.16,0:11:24.25,Default,,0,0,0,,Сен бүгін жазғы киім киіп жүрсің, анаң оны үтіктеп жатқан.
Dialogue: 0,0:13:13.00,0:13:14.50,Default,,0,0,0,,-Жеркінішті -Сен жынды болсаң керек
Dialogue: 0,0:13:14.58,0:13:15.58,Default,,0,0,0,,-Маған қарама -Маған жақындама
Dialogue: 0,0:13:15.83,0:13:17.16,Default,,0,0,0,,-Жоғал -Лас жұқпалы
Dialogue: 0,0:13:17.58,0:13:19.25,Default,,0,0,0,,-Сізде қандай жауапкершілік бар? -Жоқ~
Dialogue: 0,0:13:19.33,0:13:20.75,Default,,0,0,0,,Мүлде рұқсат етілмейді
Dialogue: 0,0:13:20.83,0:13:22.70,Default,,0,0,0,,Сен мектепке келмейсің!
Dialogue: 0,0:13:23.41,0:13:24.50,Default,,0,0,0,,Касуга-кун…
Dialogue: 0,0:13:25.83,0:13:26.75,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:13:28.08,0:13:29.08,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:13:30.50,0:13:31.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:31.20,0:13:33.45,Default,,0,0,0,,Жоқ, бұл әлі де жақсы емес.
Dialogue: 0,0:13:34.62,0:13:35.75,Default,,0,0,0,,Саяхатқа шығайық
Dialogue: 0,0:13:36.41,0:13:38.70,Default,,0,0,0,,Бір жерге саяхатқа шығайық
Dialogue: 0,0:13:38.95,0:13:40.62,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:13:40.70,0:13:41.45,Default,,0,0,0,,Касуга-кун
Dialogue: 0,0:13:41.54,0:13:42.58,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:13:43.45,0:13:44.25,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:13:48.79,0:13:50.29,Default,,0,0,0,,Бүгіннен бастап жазғы киімдер.
Dialogue: 0,0:13:52.75,0:13:53.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:55.04,0:13:56.04,Default,,0,0,0,,Иә
Dialogue: 0,0:13:59.04,0:14:01.37,Default,,0,0,0,,Кешегі күн үшін рахмет
Dialogue: 0,0:14:02.79,0:14:04.70,Default,,0,0,0,,Біртүрлі айтқаным үшін кешіріңіз.
Dialogue: 0,0:14:05.66,0:14:07.04,Default,,0,0,0,,Бірақ мен өзімді сергек сезіндім.
Dialogue: 0,0:14:09.00,0:14:11.58,Default,,0,0,0,,Бүгіннен бастап тағы да рахмет.
Dialogue: 0,0:14:12.29,0:14:14.04,Default,,0,0,0,,Саэки мырза
Dialogue: 0,0:14:15.20,0:14:17.16,Default,,0,0,0,,О, мен...
Dialogue: 0,0:14:17.83,0:14:20.20,Default,,0,0,0,,Мен мен...
Dialogue: 0,0:14:21.20,0:14:24.04,Default,,0,0,0,,Касуга-кун, не болды? Мен кешігіп қаламын!
Dialogue: 0,0:14:24.29,0:14:24.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:28.04,0:14:28.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:48.91,0:14:49.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:50.75,0:14:52.25,Default,,0,0,0,,Бұл шулы.
Dialogue: 0,0:14:53.12,0:14:54.08,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:55.16,0:14:56.50,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:15:04.29,0:15:06.20,Default,,0,0,0,,Пами
Dialogue: 0,0:15:09.04,0:15:10.16,Default,,0,0,0,,Мен бұған байыпты емеспін.
Dialogue: 0,0:15:12.41,0:15:13.62,Default,,0,0,0,,Бұл менікі.
Dialogue: 0,0:15:14.91,0:15:16.41,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:15:19.33,0:15:20.16,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:15:24.33,0:15:25.16,Default,,0,0,0,,Нанако
Dialogue: 0,0:15:36.95,0:15:37.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:44.37,0:15:47.08,Default,,0,0,0,,Өтірік... бұл менікі...
Dialogue: 0,0:15:48.45,0:15:50.83,Default,,0,0,0,,Уф... неге?
Dialogue: 0,0:15:53.16,0:15:54.12,Default,,0,0,0,,Нанако...
Dialogue: 0,0:15:56.75,0:15:57.37,Default,,0,0,0,,Касуга!
Dialogue: 0,0:15:57.45,0:15:58.08,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:58.41,0:16:01.37,Default,,0,0,0,,Керемет! Бұл құпия болуы керек!
Dialogue: 0,0:16:01.45,0:16:02.41,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:16:05.08,0:16:07.37,Default,,0,0,0,,Бұзық тағы да осында.
Dialogue: 0,0:16:07.66,0:16:08.45,Default,,0,0,0,,(Киришима & Сейро) Хахаха… Шынымен бе? Шынымен бе? Бакуго!
Dialogue: 0,0:16:09.04,0:16:11.04,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:11.62,0:16:12.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:12.79,0:16:15.25,Default,,0,0,0,,Сәлем Ямада! Шу шығармаңыз!
Dialogue: 0,0:16:15.79,0:16:16.75,Default,,0,0,0,,Олар…
Dialogue: 0,0:16:16.83,0:16:18.54,Default,,0,0,0,,Нанакоға қамқор болыңыз!
Dialogue: 0,0:16:22.16,0:16:22.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:27.16,0:16:27.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:31.25,0:16:31.95,Default,,0,0,0,,Ах
Dialogue: 0,0:16:33.33,0:16:37.08,Default,,0,0,0,,Менің атым сиямен өшірілді
Dialogue: 0,0:16:56.54,0:16:59.54,Default,,0,0,0,,Иә, назар аударыңыз! Қазір гимназияда арнайы жиналыс болады!
Dialogue: 0,0:16:59.83,0:17:01.33,Default,,0,0,0,,Тез қозғал!
Dialogue: 0,0:17:01.79,0:17:02.75,Default,,0,0,0,,Уақытша!
Dialogue: 0,0:17:03.20,0:17:04.37,Default,,0,0,0,,Ябе
Dialogue: 0,0:17:05.87,0:17:06.83,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:06.91,0:17:08.41,Default,,0,0,0,,Нанако, сен тұра аласың ба?
Dialogue: 0,0:17:20.95,0:17:21.83,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:17:22.50,0:17:24.12,Default,,0,0,0,,Хмм... иә
Dialogue: 0,0:17:30.95,0:17:34.62,Default,,0,0,0,,Ал, бүгін 2-сынып, 1-сынып.
Dialogue: 0,0:17:34.91,0:17:37.25,Default,,0,0,0,,Сынып толығымен бұзылды.
Dialogue: 0,0:17:37.50,0:17:42.12,Default,,0,0,0,,Оқушылардың оқу құралдары сияқты жеке заттары зақымданған оқиға болды.
Dialogue: 0,0:17:42.20,0:17:42.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:43.08,0:17:46.83,Default,,0,0,0,,Мен әлі егжей-тегжейлі білмеймін.
Dialogue: 0,0:17:46.91,0:17:48.79,Default,,0,0,0,,Тыныш! Тыныш бол!
Dialogue: 0,0:17:51.12,0:17:51.83,Default,,0,0,0,,Е, жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:17:51.91,0:17:53.70,Default,,0,0,0,,Ал, фактілерді тексеріңіз.
Dialogue: 0,0:17:53.79,0:17:55.29,Default,,0,0,0,,Әй, бұл керемет емес пе?
Dialogue: 0,0:17:55.37,0:17:58.16,Default,,0,0,0,,Біздің мектепте мұндай оқиға болғанына сене алар емеспін.
Dialogue: 0,0:17:58.37,0:18:00.95,Default,,0,0,0,,-Теледидар келмей ме? -Сен қалай ойлайсың?
Dialogue: 0,0:18:01.04,0:18:02.91,Default,,0,0,0,,Жоқ, мен сұхбат бермеймін.
Dialogue: 0,0:18:03.25,0:18:04.50,Default,,0,0,0,,Бұл бәрінен бұрын, солай емес пе?
Dialogue: 0,0:18:04.58,0:18:07.45,Default,,0,0,0,,Саэкидің жаттығу залындағы киімдері де ұрланған кезде көрінді...
Dialogue: 0,0:18:07.54,0:18:08.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:09.08,0:18:11.70,Default,,0,0,0,,Ол көзілдірік киген ақымаққа ұқсайды...
Dialogue: 0,0:18:11.91,0:18:13.79,Default,,0,0,0,,Маған шабуыл жасалса, не істеуім керек?
Dialogue: 0,0:18:13.87,0:18:15.37,Default,,0,0,0,,Бейшара Нанако
Dialogue: 0,0:18:15.58,0:18:17.62,Default,,0,0,0,,Бұл туралы бәрі ұмытып кетсе де
Dialogue: 0,0:18:19.54,0:18:25.83,Default,,0,0,0,,Қауіпсіздік мақсатында біз бүгіннен бастап мектептен топ болып шығамыз, бірақ әрбір сынып мұғалімі мен мұғалімі
Dialogue: 0,0:18:26.00,0:18:27.50,Default,,0,0,0,,Үйде демалу.
Dialogue: 0,0:18:33.25,0:18:34.20,Default,,0,0,0,,Мажикимои
Dialogue: 0,0:18:36.45,0:18:37.66,Default,,0,0,0,,2-1 үшінші қабат па?
Dialogue: 0,0:18:39.50,0:18:41.66,Default,,0,0,0,,- Сіз емессіз бе? -Хаха, білдің бе?
Dialogue: 0,0:18:51.75,0:18:54.37,Default,,0,0,0,,Ууууууууууууууу...
Dialogue: 0,0:18:55.16,0:18:59.58,Default,,0,0,0,,Ууууууууууу...уууу
Dialogue: 0,0:18:59.87,0:19:02.75,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:19:04.79,0:19:08.33,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:19:08.66,0:19:12.58,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:19:14.50,0:19:16.50,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:19:16.58,0:19:17.41,Default,,0,0,0,,Касуга-кун
Dialogue: 0,0:19:21.58,0:19:23.12,Default,,0,0,0,,Олардың білмегеніне көңіліңіз толды ма?
Dialogue: 0,0:19:24.41,0:19:25.58,Default,,0,0,0,,Накамура мырза
Dialogue: 0,0:19:28.41,0:19:32.20,Default,,0,0,0,,Фуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфу…
Dialogue: 0,0:19:32.66,0:19:34.58,Default,,0,0,0,,Мен біраз уақыттан кейін бірінші рет сергек болдым!
Dialogue: 0,0:19:34.66,0:19:36.12,Default,,0,0,0,,Көрдіңіз бе? олардың жүздері
Dialogue: 0,0:19:36.20,0:19:37.75,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:19:39.70,0:19:40.62,Default,,0,0,0,,Мақтан тұт
Dialogue: 0,0:19:41.00,0:19:42.91,Default,,0,0,0,,Мен ақырында терінің бір қабатын аршып алдым.
Dialogue: 0,0:20:03.37,0:20:04.33,Default,,0,0,0,,Касуга-кун
Dialogue: 0,0:20:18.58,0:20:19.91,Default,,0,0,0,,Саэки мырза
Dialogue: 0,0:20:29.37,0:20:30.41,Default,,0,0,0,,Қоштасайық
Dialogue: 0,0:20:43.91,0:20:44.87,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:20:47.58,0:20:48.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:48.87,0:20:49.50,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:20:49.58,0:20:50.45,Default,,0,0,0,,Касуга-кун!
Dialogue: 0,0:20:57.83,0:20:58.83,Default,,0,0,0,,Бұл…
Dialogue: 0,0:21:00.75,0:21:02.62,Default,,0,0,0,,«Зұлымдық гүлдерінің» мұқаба суреті
Dialogue: 0,0:21:07.83,0:21:09.41,Default,,0,0,0,,Ол еденге сызылған.
Dialogue: 0,0:21:15.66,0:21:17.83,Default,,0,0,0,,Касуга-кун... бұл не?
Dialogue: 0,0:21:21.70,0:21:23.12,Default,,0,0,0,,Сол сынып
Dialogue: 0,0:21:24.62,0:21:27.62,Default,,0,0,0,,Менің де… спортзалға арналған киімім.
Dialogue: 0,0:21:34.70,0:21:36.87,Default,,0,0,0,,Касуга-кун... бұл не?
Dialogue: 0,0:21:50.29,0:21:57.45,Default,,0,0,0,,Хана га Саку Итайо Хана га Хана га Саку Итайо
Dialogue: 0,0:21:58.08,0:22:07.66,Default,,0,0,0,,Желдің қорқынышты болғаны сонша, гүлдің жайқалғанын ешкім көрмеді.
Dialogue: 0,0:22:10.79,0:22:19.12,Default,,0,0,0,,Хана га Хана га Саку Итайо Хана га Хана га Саку Итайо
Dialogue: 0,0:22:20.08,0:22:23.79,Default,,0,0,0,,Гүлдер жайқалып тұрған сияқты.
Dialogue: 0,0:22:23.87,0:22:25.66,Default,,0,0,0,,Ханана Донай
Dialogue: 0,0:22:25.75,0:22:32.04,Default,,0,0,0,,Оның орын алуына ешқандай себеп болмауы керек
Dialogue: 0,0:22:32.12,0:22:40.70,Default,,0,0,0,,...
Dialogue: 0,0:22:41.25,0:22:45.91,Default,,0,0,0,,Оны ешкімнің көруі мүмкін емес.
Dialogue: 0,0:22:46.00,0:22:50.16,Default,,0,0,0,,Гүлдену керек болған нәрсе гүлдейді
Dialogue: 0,0:22:50.25,0:22:55.87,Default,,0,0,0,,Орын қай жерде?
Dialogue: 0,0:22:55.95,0:23:01.08,Default,,0,0,0,,Хана га Саку Итайо Хана га Хана га Саку Итайо
Dialogue: 0,0:23:01.37,0:23:08.41,Default,,0,0,0,,Желдің қорқынышты болғаны сонша, гүлдің жайқалғанын ешкім көрмеді.
Dialogue: 0,0:23:20.91,0:23:23.20,Default,,0,0,0,,Мені жек көруге келдің бе?
Dialogue: 0,0:23:23.29,0:23:24.79,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:23:24.87,0:23:27.45,Default,,0,0,0,,Өйткені Касуга-кун – мүлде бұзық.
Dialogue: 0,0:23:27.79,0:23:30.12,Default,,0,0,0,,Мен оның барлық мазмұнын алып тастайтын келісімшарт.
Dialogue: 0,0:23:30.79,0:23:33.29,Default,,0,0,0,,Қалай қарасаң да, бұзық.
Dialogue: 0,0:23:33.58,0:23:34.83,Default,,0,0,0,,Ешқайда
Dialogue: 0,0:23:36.33,0:23:42.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory