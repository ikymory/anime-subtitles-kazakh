Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.75,0:00:09.45,Default,,0,0,0,,Неге...
Dialogue: 0,0:00:12.75,0:00:13.41,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:00:17.29,0:00:19.83,Default,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,0:00:21.54,0:00:25.04,Default,,0,0,0,,Эй, көңіл-күйің қалай? Ертеңге дейін сезімдеріңізді жазып кетіңіздер.
Dialogue: 0,0:00:25.75,0:00:30.04,Default,,0,0,0,,Уау! Ах! Ах!
Dialogue: 0,0:00:30.54,0:00:35.95,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:00:36.83,0:00:40.50,Default,,0,0,0,,Күрсін... Күрсін... Осы менде болса ғой
Dialogue: 0,0:00:41.04,0:00:44.00,Default,,0,0,0,,Бұл болмауы керек еді
Dialogue: 0,0:00:47.91,0:00:52.50,Default,,0,0,0,,Тек бұл...
Dialogue: 0,0:01:07.50,0:01:11.37,Default,,0,0,0,,Бірақ бұлай етпеу керек.
Dialogue: 0,0:01:11.45,0:01:15.29,Default,,0,0,0,,Сол себепті сіз зардап шегесіз
Dialogue: 0,0:01:15.58,0:01:19.16,Default,,0,0,0,,Қоқыстардың үстінен періште ұшып келеді
Dialogue: 0,0:01:19.33,0:01:23.16,Default,,0,0,0,,Мен де ақымақ сияқтымын
Dialogue: 0,0:01:23.54,0:01:29.08,Default,,0,0,0,,Мен жәндіктердің торын жек көремін.
Dialogue: 0,0:01:29.37,0:01:36.95,Default,,0,0,0,,Мен көп қателіктер мен күнәлар жасайтыныма сенімдімін
Dialogue: 0,0:01:37.20,0:01:41.95,Default,,0,0,0,,Соңы мен басы артық, ол сенікі
Dialogue: 0,0:01:42.08,0:01:49.41,Default,,0,0,0,,Мен оны көруге шыдамаймын.
Dialogue: 0,0:01:49.54,0:01:51.66,Default,,0,0,0,,Мен де бүгін сабақтан кейін кітапханадамын.
Dialogue: 0,0:01:51.75,0:01:54.12,Default,,0,0,0,,Касуга-кун, бетіңді Саэки-санның кеудесіне көміп алдың!
Dialogue: 0,0:01:54.33,0:01:57.08,Default,,0,0,0,,Сен мүлде азғынсың! Касуга-кун!
Dialogue: 0,0:01:57.25,0:02:00.20,Default,,0,0,0,,Мен бұл затты қазір пеште өртеймін!
Dialogue: 0,0:02:00.29,0:02:04.04,Default,,0,0,0,,Гүл, гүл, Күнәнің бүршігі.
Dialogue: 0,0:02:04.12,0:02:08.79,Default,,0,0,0,,Бақыланатын гүл, гүлдер, бүршіктер
Dialogue: 0,0:02:08.91,0:02:12.58,Default,,0,0,0,,Өсіп, кеуіп қалатын үміт
Dialogue: 0,0:02:12.66,0:02:16.16,Default,,0,0,0,,Қаш
Dialogue: 0,0:02:16.58,0:02:20.91,Default,,0,0,0,,Мені жалғыз қалдырмаңыз
Dialogue: 0,0:02:31.58,0:02:32.29,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:33.08,0:02:37.41,Default,,0,0,0,,Мама, маған бүгін таңғы ас керек емес. Мен мектепке барамын.
Dialogue: 0,0:02:37.75,0:02:38.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:41.75,0:02:43.70,Default,,0,0,0,,Неліктен? Бірдеңе бар ма?
Dialogue: 0,0:02:43.83,0:02:48.04,Default,,0,0,0,,Жоқ, менің ойымша, кейде ерте барған дұрыс.
Dialogue: 0,0:02:51.37,0:02:54.41,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:02:54.54,0:02:58.87,Default,,0,0,0,,Оны тастаңыз! Бұны лақтырып тастаңыз және бәрін бітіріңіз.
Dialogue: 0,0:02:59.33,0:03:02.08,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:03:02.95,0:03:04.75,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:03:04.83,0:03:06.62,Default,,0,0,0,,Уау, жақсарып қалдың.
Dialogue: 0,0:03:07.20,0:03:07.83,Default,,0,0,0,,Ах
Dialogue: 0,0:03:07.91,0:03:12.29,Default,,0,0,0,,Хааа... хахахахаха! Күрсін...
Dialogue: 0,0:03:12.54,0:03:15.41,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:03:15.50,0:03:16.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:17.70,0:03:23.54,Default,,0,0,0,,Хаа ха ха ха... аа аа... ха...
Dialogue: 0,0:03:24.91,0:03:29.04,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:03:29.12,0:03:35.33,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:03:39.70,0:03:45.33,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:03:45.79,0:03:50.58,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:03:53.87,0:03:55.54,Default,,0,0,0,,Ха... Ах... Ха...
Dialogue: 0,0:03:56.66,0:03:57.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:57.91,0:03:59.50,Default,,0,0,0,,күрсіну...
Dialogue: 0,0:04:01.04,0:04:03.79,Default,,0,0,0,,Ха-а-а-а-а-а
Dialogue: 0,0:04:04.08,0:04:04.95,Default,,0,0,0,,Бұл оңай емес пе?
Dialogue: 0,0:04:05.12,0:04:08.75,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:04:09.41,0:04:13.54,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:04:13.83,0:04:14.70,Default,,0,0,0,,Ағай!
Dialogue: 0,0:04:16.25,0:04:19.16,Default,,0,0,0,,Иә, бұл Озу. Бұл Сабуро Озу!
Dialogue: 0,0:04:19.79,0:04:20.87,Default,,0,0,0,,Ондай нәрсе жоқ, солай ма?
Dialogue: 0,0:04:21.58,0:04:26.25,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:04:27.58,0:04:29.87,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:04:29.95,0:04:31.83,Default,,0,0,0,,Олай болса, саған қандай дәм ұнайды?
Dialogue: 0,0:04:32.41,0:04:33.04,Default,,0,0,0,,Күнжіт дәмі
Dialogue: 0,0:04:33.16,0:04:33.83,Default,,0,0,0,,Күнжіттің дәмі?
Dialogue: 0,0:04:33.91,0:04:35.12,Default,,0,0,0,,Пами
Dialogue: 0,0:04:35.20,0:04:36.20,Default,,0,0,0,,Әй, қоңырау шырылдап тұрған жоқ па?
Dialogue: 0,0:04:36.29,0:04:36.91,Default,,0,0,0,,Әрине
Dialogue: 0,0:04:37.66,0:04:38.70,Default,,0,0,0,,Бүгін тағы кешіктің.
Dialogue: 0,0:04:38.79,0:04:39.87,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:04:40.66,0:04:41.29,Default,,0,0,0,,Касуга-кун
Dialogue: 0,0:04:41.37,0:04:42.00,Default,,0,0,0,,Га
Dialogue: 0,0:04:42.70,0:04:47.87,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:04:49.58,0:04:52.45,Default,,0,0,0,,Сіз қолжазба жаздыңыз ба? Сіз жазыпсыз, солай емес пе?
Dialogue: 0,0:04:53.20,0:04:56.58,Default,,0,0,0,,Хааааааааааааааааааааааааааааааа...
Dialogue: 0,0:04:57.08,0:04:59.45,Default,,0,0,0,,Мен де бүгін сабақтан кейін кітапханаға барамын.
Dialogue: 0,0:05:08.83,0:05:12.37,Default,,0,0,0,,Ух, Касуга! У жуши жуши жуши жуши
Dialogue: 0,0:05:14.20,0:05:14.83,Default,,0,0,0,,Джуши
Dialogue: 0,0:05:21.04,0:05:25.12,Default,,0,0,0,,Ертең эвакуациялау жаттығуы бар, сондықтан апатқа қарсы капюшондарыңызды әкеліңіз.
Dialogue: 0,0:05:25.79,0:05:30.62,Default,,0,0,0,,А... не істеуім керек? Мен енді қаша алмаймын.
Dialogue: 0,0:05:33.45,0:05:37.45,Default,,0,0,0,,Саэки мырза, мен...
Dialogue: 0,0:05:43.33,0:05:48.16,Default,,0,0,0,,Е... а, тағы бір айтарым бар.
Dialogue: 0,0:05:49.33,0:05:52.79,Default,,0,0,0,,Өткенде Саэкидің жаттығу залындағы киімін ұрлағаны туралы айтпадық па?
Dialogue: 0,0:05:53.20,0:05:54.87,Default,,0,0,0,,Негізі сол күні сабақтан кейін
Dialogue: 0,0:05:55.54,0:05:59.91,Default,,0,0,0,,Осы мектептің бір оқушысы мектепті аралап жүрген күдікті адамды көрген көрінеді.
Dialogue: 0,0:06:00.00,0:06:00.70,Default,,0,0,0,,Не?!
Dialogue: 0,0:06:00.79,0:06:01.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:02.29,0:06:06.08,Default,,0,0,0,,Шашы ұзын, көзілдірік киген 30 жас шамасындағы ер адам.
Dialogue: 0,0:06:06.16,0:06:06.95,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:06:07.41,0:06:08.25,Default,,0,0,0,,Бұл бұзық адамның ісі ғой.
Dialogue: 0,0:06:08.33,0:06:11.41,Default,,0,0,0,,Иә, тыныш бол, тыныш бол!
Dialogue: 0,0:06:12.12,0:06:14.95,Default,,0,0,0,,Егер күдікті біреуді көрсеңіз, дереу мұғалімге айтыңыз
Dialogue: 0,0:06:15.50,0:06:18.08,Default,,0,0,0,,Сабақтан соң, тура үйге қайт! Міне бітті!
Dialogue: 0,0:06:18.45,0:06:19.83,Default,,0,0,0,,Уау~
Dialogue: 0,0:06:19.91,0:06:21.45,Default,,0,0,0,,Оны тез ұстаңыз!
Dialogue: 0,0:06:22.20,0:06:24.66,Default,,0,0,0,,Жоқ, егер маған оғаш нәрсе болса, не істеуім керек? Хехе
Dialogue: 0,0:06:24.87,0:06:26.95,Default,,0,0,0,,Касуга: Бәрі қызық бола бастады.
Dialogue: 0,0:06:29.45,0:06:32.62,Default,,0,0,0,,Касуга? иә? иә?
Dialogue: 0,0:06:33.08,0:06:35.95,Default,,0,0,0,,Нанако, көп уайымдама.
Dialogue: 0,0:07:11.50,0:07:13.37,Default,,0,0,0,,«Бұл шайтан!»
Dialogue: 0,0:07:14.50,0:07:15.62,Default,,0,0,0,,«Бостандық»
Dialogue: 0,0:07:16.54,0:07:21.29,Default,,0,0,0,,«Сіз жіптерді ұстайсыз және бізді ағаш қуыршақ сияқты басқарасыз».
Dialogue: 0,0:07:22.91,0:07:27.29,Default,,0,0,0,,«Сіздердің арқаларыңызда біз жағымсыз нәрселердің арбауына түсіп қалдық».
Dialogue: 0,0:07:28.87,0:07:33.83,Default,,0,0,0,,«Күн сайын сіз тозаққа бір қадам жасайсыз».
Dialogue: 0,0:07:35.70,0:07:40.91,Default,,0,0,0,,«Қараңғы түнектен ойланбастан өту».
Dialogue: 0,0:08:03.83,0:08:07.95,Default,,0,0,0,,Касуга-кун, маған эссеңді тез көрсетші.
Dialogue: 0,0:08:17.25,0:08:18.04,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:08:18.79,0:08:21.62,Default,,0,0,0,,Бодлердің «Зұлымдық гүлдері» поэзиялық жинағы
Dialogue: 0,0:08:23.04,0:08:24.79,Default,,0,0,0,,Маған ұнайтын өлеңдер жинағы
Dialogue: 0,0:08:26.25,0:08:29.29,Default,,0,0,0,,Бұл кітап қараңғы эмоцияларға толы.
Dialogue: 0,0:08:30.16,0:08:35.37,Default,,0,0,0,,Бұл қалашықтағы қарапайым адамдар ешқашан түсінбейтін философия бар.
Dialogue: 0,0:08:36.54,0:08:38.04,Default,,0,0,0,,Бұл менмін.
Dialogue: 0,0:08:40.16,0:08:41.50,Default,,0,0,0,,Бұл менің эссем
Dialogue: 0,0:08:43.50,0:08:44.58,Default,,0,0,0,,Үніңді жап, қаншық.
Dialogue: 0,0:08:45.50,0:08:46.79,Default,,0,0,0,,Касуга-кун, мен
Dialogue: 0,0:08:47.16,0:08:50.87,Default,,0,0,0,,Гаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:08:50.95,0:08:53.08,Default,,0,0,0,,Мен сіздің беймаза эссеңізді оқығым келді!
Dialogue: 0,0:08:53.75,0:08:56.20,Default,,0,0,0,,Касуга-кун, бетіңді Саэки-санның кеудесіне көміп алдың!
Dialogue: 0,0:08:56.54,0:09:00.33,Default,,0,0,0,,Сіз менің спорттық формамды иіскеп, барлық жерін ысқылап жібердіңіз!
Dialogue: 0,0:09:00.70,0:09:03.50,Default,,0,0,0,,Сіз мүлде азғынсыз! Касуга-кун!
Dialogue: 0,0:09:05.45,0:09:08.83,Default,,0,0,0,,Не болды! Ха ха...
Dialogue: 0,0:09:09.29,0:09:14.66,Default,,0,0,0,,Мен неге екенін түсінбеймін! Кеше ме, бүгін бе, сіз не ойлап отырсыз, Накамура мырза?
Dialogue: 0,0:09:14.95,0:09:18.50,Default,,0,0,0,,Сол сыныптағы атмосфераны көрдіңіз бе? Күдікті адам кім?
Dialogue: 0,0:09:18.87,0:09:24.20,Default,,0,0,0,,Тіпті Саэки мырза маған біртүрлі қарады... Мен басқамын! Мен басқамын!
Dialogue: 0,0:09:24.62,0:09:28.41,Default,,0,0,0,,Ха, мен оны үнемі ысқылап жатқан жоқпын!
Dialogue: 0,0:09:28.83,0:09:34.16,Default,,0,0,0,,Саэки-сан - менің музам, менің әйелім, менің Мариям және менің Венерам!
Dialogue: 0,0:09:34.45,0:09:35.37,Default,,0,0,0,,Мәңгі!
Dialogue: 0,0:09:35.79,0:09:40.70,Default,,0,0,0,,Мынадай бірдеңе... Осындай бірдеңе мен оны дәл қазір өртелетін пеште өртеп жіберемін!
Dialogue: 0,0:09:41.62,0:09:42.25,Default,,0,0,0,,Ах
Dialogue: 0,0:09:43.83,0:09:44.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:44.79,0:09:49.37,Default,,0,0,0,,Жібер... Ха... Эй, эй...
Dialogue: 0,0:09:50.45,0:09:53.08,Default,,0,0,0,,Неліктен, неге, жоқ...
Dialogue: 0,0:09:55.79,0:09:58.08,Default,,0,0,0,,Иә, жоқ, жоқ.
Dialogue: 0,0:09:58.95,0:10:00.75,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:10:01.37,0:10:02.41,Default,,0,0,0,,Ха ха…
Dialogue: 0,0:10:03.33,0:10:06.33,Default,,0,0,0,,Эй, күте тұрыңыз!
Dialogue: 0,0:10:08.08,0:10:13.41,Default,,0,0,0,,Уф ха ха... ха ха ха аааа
Dialogue: 0,0:10:16.87,0:10:17.50,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:10:21.12,0:10:25.95,Default,,0,0,0,,Уф ха ха ха ха...
Dialogue: 0,0:10:26.29,0:10:29.50,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:10:29.62,0:10:32.75,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:10:33.16,0:10:38.08,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:10:39.25,0:10:42.20,Default,,0,0,0,,Хмм... қалай ұнайды?
Dialogue: 0,0:10:44.00,0:10:45.16,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:10:47.00,0:10:50.70,Default,,0,0,0,,Күрсін... Касуга-кун, бұл мен.
Dialogue: 0,0:10:51.62,0:10:54.20,Default,,0,0,0,,Мен көптен бері қышиды.
Dialogue: 0,0:10:55.54,0:10:58.87,Default,,0,0,0,,Дененің төменгі бөлігі
Dialogue: 0,0:10:59.45,0:11:02.37,Default,,0,0,0,,Менің абдырап қалғаным сонша, айқайлағым келеді
Dialogue: 0,0:11:04.37,0:11:09.62,Default,,0,0,0,,Осы дүние менің қасіретімде ласқа айналса екен деп тілеймін.
Dialogue: 0,0:11:10.37,0:11:13.37,Default,,0,0,0,,UPX өткізілетін орын.
Dialogue: 0,0:11:13.79,0:11:19.79,Default,,0,0,0,,Күлсін... Мен де бұзық шығармын.
Dialogue: 0,0:11:21.16,0:11:22.79,Default,,0,0,0,,де?
Dialogue: 0,0:11:23.95,0:11:24.58,Default,,0,0,0,,Га
Dialogue: 0,0:11:26.45,0:11:28.37,Default,,0,0,0,,Касуга-кун, сенімді бол
Dialogue: 0,0:11:29.04,0:11:32.58,Default,,0,0,0,,Менімен келісім-шарт жасай алатын жалғыз адам Касуга-кун болатын.
Dialogue: 0,0:11:36.87,0:11:42.58,Default,,0,0,0,,Хаа, бұдан былай күнде сабақтан кейін менімен бірге боласыз! Мұны істейік!
Dialogue: 0,0:11:42.95,0:11:47.62,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:11:48.91,0:11:50.87,Default,,0,0,0,,Саэки мырзаның жаттығу залындағы киімдері
Dialogue: 0,0:11:51.37,0:11:56.87,Default,,0,0,0,,Теріме жабысып, жамандықтың дымқыл иісін шығарды.
Dialogue: 0,0:12:09.37,0:12:11.66,Default,,0,0,0,,Эй Касуга, үйге бара жатқанда маған тоқтағың келе ме?
Dialogue: 0,0:12:12.33,0:12:15.83,Default,,0,0,0,,Жоқ, мен біраз...
Dialogue: 0,0:12:16.54,0:12:19.95,Default,,0,0,0,,Не? Сіз соңғы кездері мүлде ойнамайсыз.
Dialogue: 0,0:12:20.08,0:12:20.70,Default,,0,0,0,,Эй
Dialogue: 0,0:12:21.33,0:12:24.45,Default,,0,0,0,,Жарайды, ол жігітті жайына қалдырайық~
Dialogue: 0,0:12:57.41,0:12:58.16,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:13:01.91,0:13:02.54,Default,,0,0,0,,Иә
Dialogue: 0,0:13:06.70,0:13:08.08,Default,,0,0,0,,Содан бері бір апта
Dialogue: 0,0:13:08.91,0:13:13.20,Default,,0,0,0,,Накамура-сан екеуміз сабақтан кейін күнде бірге болдық.
Dialogue: 0,0:13:20.87,0:13:21.62,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:13:21.79,0:13:25.16,Default,,0,0,0,,А-а... Бұл сондай құрметті...
Dialogue: 0,0:13:25.79,0:13:29.08,Default,,0,0,0,,Мектептегі жігіттер біліп қалса, не айтарын білмейсің.
Dialogue: 0,0:13:29.83,0:13:30.50,Default,,0,0,0,,Не?
Dialogue: 0,0:13:32.91,0:13:34.37,Default,,0,0,0,,«Не»…
Dialogue: 0,0:13:35.70,0:13:37.91,Default,,0,0,0,,Жүр, тезірек, Қасуга-кун.
Dialogue: 0,0:13:56.20,0:13:57.33,Default,,0,0,0,,Эй, Касуга-кун
Dialogue: 0,0:13:57.87,0:13:58.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:58.79,0:14:02.58,Default,,0,0,0,,Соңғы кездері менің қолымнан жақсы иіс шығып жатыр. Жай ғана иіскеңіз.
Dialogue: 0,0:14:02.83,0:14:03.45,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:09.00,0:14:11.83,Default,,0,0,0,,Қаланы басып өтетін ең үлкен өзен
Dialogue: 0,0:14:12.95,0:14:16.20,Default,,0,0,0,,Осы жерде өзен жағасындағы шөпте
Dialogue: 0,0:14:17.37,0:14:20.79,Default,,0,0,0,,Мен Накамура мырзаның түсініксіз әңгімесін тыңдаймын.
Dialogue: 0,0:14:27.00,0:14:31.12,Default,,0,0,0,,Әй, қазірдің өзінде қараңғы түсіп жатыр.
Dialogue: 0,0:14:32.04,0:14:34.04,Default,,0,0,0,,Бүгінгі уақыт та қалды...
Dialogue: 0,0:14:36.08,0:14:38.25,Default,,0,0,0,,Ата-анаң ашулы емес пе?
Dialogue: 0,0:14:39.00,0:14:41.75,Default,,0,0,0,,Күнде үйге бұлай кеш келме.
Dialogue: 0,0:14:42.16,0:14:42.79,Default,,0,0,0,,Маған қол ұшын созыңыз
Dialogue: 0,0:14:42.87,0:14:43.50,Default,,0,0,0,,Эй, сәлем...
Dialogue: 0,0:14:53.58,0:14:54.79,Default,,0,0,0,,Хмм…
Dialogue: 0,0:14:55.41,0:15:01.04,Default,,0,0,0,,Түсіндім... Касуга-кун Саэки-санның жаттығу залындағы киімін қолымен сипады.
Dialogue: 0,0:15:01.87,0:15:03.62,Default,,0,0,0,,Мен көп ысқылаймын.
Dialogue: 0,0:15:03.70,0:15:04.91,Default,,0,0,0,,Сондықтан мен олай істемедім!
Dialogue: 0,0:15:05.00,0:15:06.12,Default,,0,0,0,,Бұзық бейбақ
Dialogue: 0,0:15:07.79,0:15:12.54,Default,,0,0,0,,Эй, саған Саэки-сан ұнайды, солай ма? Сізге оның не ұнайды?
Dialogue: 0,0:15:13.62,0:15:18.25,Default,,0,0,0,,Өткен күні Саэки-санның жаттығу залындағы киімін киіп көргенде қандай сезімде болдың? Көңіліңіз толқып тұр ма?
Dialogue: 0,0:15:18.95,0:15:23.37,Default,,0,0,0,,Жазбаңыз жоқ болса, дауыстап айтыңыз, бұзықсыз.
Dialogue: 0,0:15:23.66,0:15:24.41,Default,,0,0,0,,(Иида) Барлығы шараның рухына ене ала ма екен?
Dialogue: 0,0:15:24.50,0:15:28.95,Default,,0,0,0,,Айт! Айтыңызшы! Ей, бейбақ, фуфуфу, айтшы, бейбақ!
Dialogue: 0,0:15:30.54,0:15:31.66,Default,,0,0,0,,Тоқта, шынымен!
Dialogue: 0,0:15:39.87,0:15:40.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:42.08,0:15:47.41,Default,,0,0,0,,Жоқ, мен бүгін үйге барғым келеді.
Dialogue: 0,0:15:49.25,0:15:50.87,Default,,0,0,0,,Қараңғы түсті
Dialogue: 0,0:16:10.45,0:16:13.58,Default,,0,0,0,,Мен бүгін үйге барамын, ертең кездескенше.
Dialogue: 0,0:16:26.66,0:16:29.62,Default,,0,0,0,,Сөзсіз сен! Сіз күнде қайда қыдырасыз?
Dialogue: 0,0:16:30.37,0:16:33.16,Default,,0,0,0,,Кешіріңіз, мен жаңа ғана Ямадамен араластым.
Dialogue: 0,0:16:33.25,0:16:35.58,Default,,0,0,0,,Сонша ойнау үшін не керек?
Dialogue: 0,0:16:35.66,0:16:38.04,Default,,0,0,0,,Әкем де тамақ ішпей осында күтіп отыр!
Dialogue: 0,0:16:38.75,0:16:43.12,Default,,0,0,0,,Жарайды, мама, ол қазірдің өзінде кіші мектеп оқушысы, сондықтан ойнауға болады.
Dialogue: 0,0:16:43.20,0:16:44.16,Default,,0,0,0,,Әке!
Dialogue: 0,0:16:44.25,0:16:45.16,Default,,0,0,0,,Енді, енді.
Dialogue: 0,0:16:46.20,0:16:50.20,Default,,0,0,0,,Бірақ анаң сені уайымдап жүр.
Dialogue: 0,0:16:50.79,0:16:53.29,Default,,0,0,0,,Енді тым болмаса маған хабарласыңыз.
Dialogue: 0,0:16:54.54,0:16:55.16,Default,,0,0,0,,Иә
Dialogue: 0,0:16:56.25,0:16:58.08,Default,,0,0,0,,Жүр, тезірек тамақ ішейік.
Dialogue: 0,0:17:03.58,0:17:07.25,Default,,0,0,0,,Күрсін... Мен не істеп жатырмын?
Dialogue: 0,0:17:09.66,0:17:10.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:18.87,0:17:22.08,Default,,0,0,0,,Накамура-санның иісі әлі кетпейді
Dialogue: 0,0:17:25.16,0:17:28.20,Default,,0,0,0,,Накамура мырза не істегісі келеді?
Dialogue: 0,0:17:29.66,0:17:32.95,Default,,0,0,0,,Накамура мырза үшін мен кіммін?
Dialogue: 0,0:17:37.62,0:17:38.25,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:38.83,0:17:44.20,Default,,0,0,0,,Менің бұлдыр күйімде бұл дүниенің күллі қоңызға айналуын қалаймын.
Dialogue: 0,0:17:45.54,0:17:47.08,Default,,0,0,0,,Мүмкін Накамура мырза
Dialogue: 0,0:17:47.83,0:17:52.62,Default,,0,0,0,,Мүмкін сен де мен сияқты өмір сүрген шығарсың.
Dialogue: 0,0:17:54.12,0:17:56.37,Default,,0,0,0,,Мен де бұзық шығармын
Dialogue: 0,0:18:00.95,0:18:04.45,Default,,0,0,0,,Жоқ... бірақ мен бұзық емеспін.
Dialogue: 0,0:18:06.04,0:18:09.83,Default,,0,0,0,,Менің Саэки-санға деген сезімім... Менің сезімімнің бәрі...
Dialogue: 0,0:18:11.54,0:18:13.20,Default,,0,0,0,,Өте таза
Dialogue: 0,0:18:22.91,0:18:26.75,Default,,0,0,0,,Касуга! Қайырлы таң! Пейпи!
Dialogue: 0,0:18:27.20,0:18:28.62,Default,,0,0,0,,Шулы таңнан
Dialogue: 0,0:18:29.16,0:18:33.70,Default,,0,0,0,,Ал, DVD дискіні ағаңның бөлмесінен тауып ал.
Dialogue: 0,0:18:33.87,0:18:34.50,Default,,0,0,0,,На
Dialogue: 0,0:18:35.04,0:18:37.29,Default,,0,0,0,,Көрдіңіз бе? DVD…
Dialogue: 0,0:18:38.04,0:18:40.41,Default,,0,0,0,,Сіз қалай ойлайсыз? Бүгін келесің бе?
Dialogue: 0,0:18:41.12,0:18:42.20,Default,,0,0,0,,Жарайды, мен
Dialogue: 0,0:18:42.66,0:18:46.66,Default,,0,0,0,,Иә! Жүр, кел, Қасуга!
Dialogue: 0,0:18:46.75,0:18:47.54,Default,,0,0,0,,Бұл оқудан алаңдатады!
Dialogue: 0,0:18:47.62,0:18:48.25,Default,,0,0,0,,Хех хех хех
Dialogue: 0,0:18:50.25,0:18:52.58,Default,,0,0,0,,Жоқ! Не істеу керек, Ай Чан?
Dialogue: 0,0:18:53.41,0:18:54.45,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:55.08,0:18:57.62,Default,,0,0,0,,Маю сабыр ет, не болды?
Dialogue: 0,0:18:57.75,0:18:59.25,Default,,0,0,0,,Мектептегі түскі асқа кететін шығындар
Dialogue: 0,0:18:59.50,0:19:03.87,Default,,0,0,0,,Мен оны кеше шығаруды ұмытып кетіппін, сөйтіп шкафта қалдырып кеткенмін, сондықтан бүгін таңертең келсем жоқ болып шықты.
Dialogue: 0,0:19:03.95,0:19:04.79,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:19:05.00,0:19:06.45,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:19:06.54,0:19:10.87,Default,,0,0,0,,Сонымен... кеше сабақтан кейін біреу болды...
Dialogue: 0,0:19:12.91,0:19:14.20,Default,,0,0,0,,Сонда сіз оны ұрлап алдыңыз ба?
Dialogue: 0,0:19:14.33,0:19:15.37,Default,,0,0,0,,Е, жоқ~
Dialogue: 0,0:19:15.45,0:19:17.75,Default,,0,0,0,,Саэки мырзамен болған оқиға кеше ғана болды.
Dialogue: 0,0:19:18.37,0:19:19.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:20.12,0:19:22.70,Default,,0,0,0,,Кім? Біреу бірдеңе біледі ме?
Dialogue: 0,0:19:25.04,0:19:28.75,Default,,0,0,0,,Эй, бұл Накамура шығар?
Dialogue: 0,0:19:30.12,0:19:32.54,Default,,0,0,0,,Не, Ямада Накамура?
Dialogue: 0,0:19:33.12,0:19:35.00,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:19:35.16,0:19:38.50,Default,,0,0,0,,Ой-ау...
Dialogue: 0,0:19:38.58,0:19:39.66,Default,,0,0,0,,Накамура?
Dialogue: 0,0:19:40.70,0:19:43.66,Default,,0,0,0,,Иә, Накамура мырза күдікті.
Dialogue: 0,0:19:43.79,0:19:45.66,Default,,0,0,0,,Менің ойымша, Накамура мұны істей алады.
Dialogue: 0,0:19:45.95,0:19:46.66,Default,,0,0,0,,О
Dialogue: 0,0:19:48.70,0:19:52.66,Default,,0,0,0,,Күте тұрыңыз, Накамура-сан менімен бірге болды...
Dialogue: 0,0:19:58.95,0:20:00.20,Default,,0,0,0,,Эй, Накамура-сан
Dialogue: 0,0:20:01.87,0:20:03.58,Default,,0,0,0,,Кеше сабақтан кейін не істедің?
Dialogue: 0,0:20:04.91,0:20:07.12,Default,,0,0,0,,Маю Маюдың мектептегі түскі асқа ақшасы ұрланды.
Dialogue: 0,0:20:08.20,0:20:10.20,Default,,0,0,0,,Накамура мырза, сіз не істеп жүрсіз?
Dialogue: 0,0:20:11.91,0:20:13.75,Default,,0,0,0,,Жолдан кет, бейбақ.
Dialogue: 0,0:20:14.45,0:20:15.25,Default,,0,0,0,,Ха...
Dialogue: 0,0:20:16.66,0:20:21.37,Default,,0,0,0,,Бұл мені еске түсіреді! Мен сені кеше сабақтан кейін сыныпқа қайтуға тырысқаныңды көрдім!
Dialogue: 0,0:20:21.79,0:20:22.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:22.54,0:20:23.16,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:20:23.62,0:20:25.62,Default,,0,0,0,,Бұл сенсің! Оған күмән жоқ
Dialogue: 0,0:20:26.50,0:20:31.33,Default,,0,0,0,,Сіз әрқашан біртүрлі болдыңыз! Түсінбеймін, неге жалғыз өзің мұнша ұсқынсыз көрінесің!
Dialogue: 0,0:20:31.70,0:20:32.33,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:20:32.41,0:20:36.79,Default,,0,0,0,,Сәлем! Фу-ха-фу-ха...
Dialogue: 0,0:20:38.58,0:20:39.29,Default,,0,0,0,,Мен оларды шаруамен жібердім.
Dialogue: 0,0:20:40.66,0:20:45.25,Default,,0,0,0,,Накамура не істерін білмейтіні рас, бірақ мұның оған еш қатысы жоқ!
Dialogue: 0,0:20:45.70,0:20:47.08,Default,,0,0,0,,Дәлелдер болмауы мүмкін!
Dialogue: 0,0:20:51.70,0:20:55.50,Default,,0,0,0,,Не, Касуга! Бұрышта кітап оқу керек!
Dialogue: 0,0:20:58.33,0:21:04.29,Default,,0,0,0,,Ах... Мүмкін Касуга Накамураны ұнататын шығар?
Dialogue: 0,0:21:04.58,0:21:05.83,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:21:05.91,0:21:06.54,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:21:06.87,0:21:08.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:08.41,0:21:10.41,Default,,0,0,0,,Уау Касуга
Dialogue: 0,0:21:10.58,0:21:11.58,Default,,0,0,0,,Хикува
Dialogue: 0,0:21:11.66,0:21:13.16,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:21:13.25,0:21:16.00,Default,,0,0,0,,-Неге Накамура? -Касуга да біртүрлі емес пе?
Dialogue: 0,0:21:16.08,0:21:18.58,Default,,0,0,0,,Бір минут күтіңіз! мен жай
Dialogue: 0,0:21:18.79,0:21:22.04,Default,,0,0,0,,Жағдайды объективті қарастыру нәтижесінде Ах...
Dialogue: 0,0:21:26.08,0:21:26.70,Default,,0,0,0,,Хун
Dialogue: 0,0:21:27.08,0:21:28.70,Default,,0,0,0,,Маю, мұғалімге айт.
Dialogue: 0,0:21:50.70,0:21:57.83,Default,,0,0,0,,Хана га Саку Итайо Хана га Хана га Саку Итайо
Dialogue: 0,0:21:58.54,0:22:08.87,Default,,0,0,0,,Желдің қорқынышты болғаны сонша, гүлдің жайқалғанын ешкім көрмеді.
Dialogue: 0,0:22:11.20,0:22:19.37,Default,,0,0,0,,Хана га Хана га Саку Итайо Хана га Хана га Саку Итайо
Dialogue: 0,0:22:20.58,0:22:24.25,Default,,0,0,0,,Гүлдер жайқалып тұрған сияқты.
Dialogue: 0,0:22:24.33,0:22:26.08,Default,,0,0,0,,Ханана Донай
Dialogue: 0,0:22:26.16,0:22:32.45,Default,,0,0,0,,Міне, солай болуы керек және оның дұрыс еместігі.
Dialogue: 0,0:22:32.62,0:22:41.29,Default,,0,0,0,,Шитара Сошитара Шитара Ханагааридаё
Dialogue: 0,0:22:41.75,0:22:46.33,Default,,0,0,0,,Оны ешкімнің көрмеуі мүмкін емес.
Dialogue: 0,0:22:46.41,0:22:50.66,Default,,0,0,0,,Гүлдену керек болған нәрсе гүлдеді
Dialogue: 0,0:22:50.75,0:22:56.33,Default,,0,0,0,,Орын қай жерде?
Dialogue: 0,0:22:56.41,0:23:01.50,Default,,0,0,0,,Хана га Саку Итайо Хана га Хана га Саку Итайо
Dialogue: 0,0:23:01.83,0:23:08.75,Default,,0,0,0,,Желдің қорқынышты болғаны сонша, гүлдің жайқалғанын ешкім көрмеді.
Dialogue: 0,0:23:20.70,0:23:22.58,Default,,0,0,0,,Мен неге олай айттым?
Dialogue: 0,0:23:23.33,0:23:24.54,Default,,0,0,0,,Мен бірдеңе айтқым келеді...
Dialogue: 0,0:23:24.62,0:23:25.29,Default,,0,0,0,,Сабырмен
Dialogue: 0,0:23:26.25,0:23:27.87,Default,,0,0,0,,Қазіргі жағдайға объективті қарау...
Dialogue: 0,0:23:27.95,0:23:29.54,Default,,0,0,0,,Накамураға қайырлы таң демеңіз
Dialogue: 0,0:23:29.62,0:23:31.37,Default,,0,0,0,,Мүмкін сіз байқаған боларсыз?
Dialogue: 0,0:23:31.41,0:23:33.33,Default,,0,0,0,,Мені мазақ етуді доғар
Dialogue: 0,0:23:33.70,0:23:34.45,Default,,0,0,0,,Кузутацу
Dialogue: 0,0:23:35.95,0:23:41.95,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
