Dialogue: 0,0:18:18.06,0:18:22.09,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:22.46,0:18:23.25,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:18:27.01,0:18:29.11,CN,,0000,0000,0000,,Әкесінің қайтыс болуы
Dialogue: 0,0:18:29.93,0:18:31.59,CN,,0000,0000,0000,,Айырбасталған жандар
Dialogue: 0,0:18:34.20,0:18:36.30,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:41.52,0:18:42.27,CN,,0000,0000,0000,,Жұмыртқа
Dialogue: 0,0:18:42.43,0:18:43.19,CN,,0000,0000,0000,,Токо?
Dialogue: 0,0:18:43.59,0:18:44.45,CN,,0000,0000,0000,,Дұрыс емес
Dialogue: 0,0:18:45.06,0:18:49.01,CN,,0000,0000,0000,,Жұмыртқа сізге бақыт керек
Dialogue: 0,0:18:50.35,0:18:52.84,CN,,0000,0000,0000,,?
Dialogue: 0,0:18:55.35,0:18:58.70,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:58.75,0:19:00.25,CN,,0000,0000,0000,,Бұл тамаша емес
Dialogue: 0,0:19:08.64,0:19:10.46,CN,,0000,0000,0000,,Жұмыртқа
Dialogue: 0,0:19:11.12,0:19:13.52,CN,,0000,0000,0000,,Фукан Тамагоға бірінші келген адам кім?
Dialogue: 0,0:19:14.23,0:19:16.12,CN,,0000,0000,0000,,Такара Тамаго Бақыт аяқталды
Dialogue: 0,0:19:17.64,0:19:21.94,CN,,0000,0000,0000,,Мен ғана емес, сауда көшесі мен елестеткен астана.
Dialogue: 0,0:19:23.52,0:19:25.68,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:27.75,0:19:28.68,CN,,0000,0000,0000,,Шуан
Dialogue: 0,0:19:35.41,0:19:36.58,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:37.31,0:19:39.03,CN,,0000,0000,0000,,Қаланың иесі...
Dialogue: 0,0:19:39.98,0:19:42.58,CN,,0000,0000,0000,,Мен бұл туралы ойлаймын.
Dialogue: 0,0:19:42.58,0:19:45.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:47.48,0:19:48.44,CN,,0000,0000,0000,,Кодама
Dialogue: 0,0:19:49.61,0:19:53.48,CN,,0000,0000,0000,,Оянғың келе ме?
Dialogue: 0,0:19:53.48,0:19:57.06,CN,,0000,0000,0000,,Оянғаннан кейін де емес
Dialogue: 0,0:20:05.00,0:20:08.12,CN,,0000,0000,0000,,Кодамаяның өткен жұмысына шолу
Dialogue: 0,0:20:13.64,0:20:14.47,CN,,0000,0000,0000,,Шуан
Dialogue: 0,0:20:19.99,0:20:22.18,CN,,0000,0000,0000,,Фусо Кайкан
Dialogue: 0,0:20:22.89,0:20:27.41,CN,,0000,0000,0000,,Адамның ішкі сезімі екі жүзді, қарама-қайшы сезімдер.
Dialogue: 0,0:20:27.53,0:20:30.29,CN,,0000,0000,0000,,Тірі қалуға тырысу
Dialogue: 0,0:20:58.63,0:21:00.87,CN,,0000,0000,0000,,Ол жерге қалай жетуге болады
Dialogue: 0,0:21:02.11,0:21:03.71,CN,,0000,0000,0000,,Көрінбейтін!
Dialogue: 0,0:21:05.34,0:21:06.51,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:06.51,0:21:07.80,CN,,0000,0000,0000,,Микро тарау көрінбейді
Dialogue: 0,0:21:08.13,0:21:09.32,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:09.32,0:21:10.16,CN,,0000,0000,0000,,4-бөлім: Астаң әлеміне кіріспе
Dialogue: 0,0:21:10.20,0:21:10.80,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:10.80,0:21:13.01,CN,,0000,0000,0000,,Кіші тараулар көрінбейді
Dialogue: 0,0:21:13.30,0:21:15.18,CN,,0000,0000,0000,,Нағыз құлшыныс
Dialogue: 0,0:21:15.62,0:21:17.64,CN,,0000,0000,0000,,Уақыт басқаша болғанда
Dialogue: 0,0:21:17.93,0:21:21.40,CN,,0000,0000,0000,,Жақсы күйге келгеннен кейін
Dialogue: 0,0:21:21.40,0:21:24.98,CN,,0000,0000,0000,,Ерте тұрып, кенет есіне түсу
Dialogue: 0,0:21:24.98,0:21:26.72,CN,,0000,0000,0000,,Ауылға бір көзқарас
Dialogue: 0,0:21:26.72,0:21:27.94,CN,,0000,0000,0000,,Иесато Менку
Dialogue: 0,0:21:27.94,0:21:28.92,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:28.99,0:21:30.45,CN,,0000,0000,0000,,Елордаға бару
Dialogue: 0,0:21:30.51,0:21:31.59,CN,,0000,0000,0000,,Елорда арқылы өту
Dialogue: 0,0:21:32.01,0:21:33.25,CN,,0000,0000,0000,,Каору мырза
Dialogue: 0,0:21:33.35,0:21:35.57,CN,,0000,0000,0000,,Елтаңбаны алған кезде кім кие алады?
Dialogue: 0,0:21:35.57,0:21:36.18,CN,,0000,0000,0000,,Дела!
Dialogue: 0,0:21:36.35,0:21:39.23,CN,,0000,0000,0000,,Менің келгенімді еске алудың себебі осы.
Dialogue: 0,0:21:39.61,0:21:41.34,CN,,0000,0000,0000,,Бұл үйге қайту.
Dialogue: 0,0:21:41.45,0:21:44.22,CN,,0000,0000,0000,,Менде 50 акция бар.
Dialogue: 0,0:21:44.69,0:21:48.92,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:49.33,0:21:50.97,CN,,0000,0000,0000,,Елтаңба
Dialogue: 0,0:21:51.67,0:21:53.86,CN,,0000,0000,0000,,Сіз Шығыс пен Батыста осындасыз.
Dialogue: 0,0:22:02.75,0:22:03.83,CN,,0000,0000,0000,,Елтаңба!
Dialogue: 0,0:23:35.78,0:23:38.66,CN,,0000,0000,0000,,Мен бір жыл бойы жұмыртқаға ризамын.
Dialogue: 0,0:23:38.80,0:23:42.37,CN,,0000,0000,0000,,Жыл соңы және жақын болашақ
Dialogue: 0,0:23:42.61,0:23:45.43,CN,,0000,0000,0000,,Жылда пайдалануға болатын су мөлшері ұлғайтылды.
Dialogue: 0,0:23:45.72,0:23:48.18,CN,,0000,0000,0000,,Көпжылдық жалға берушіні қалайды
Dialogue: 0,0:23:48.28,0:23:49.34,CN,,0000,0000,0000,,Жоғарыда айтылғандар менің жеке айыптауым.
Dialogue: 0,0:04:03.01,0:04:08.01,CN,,0000,0000,0000,,Ханшайымның атағы
Dialogue: 0,0:23:50.84,0:23:56.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
