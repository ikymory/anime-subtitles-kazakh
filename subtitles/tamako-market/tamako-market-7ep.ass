Dialogue: 0,0:15:45.52,0:15:46.40,CN,,0000,0000,0000,,Саюри Коджи
Dialogue: 0,0:15:47.93,0:15:49.80,CN,,0000,0000,0000,,Бақытың құтты болсын
Dialogue: 0,0:15:56.61,0:15:57.43,CN,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:16:00.55,0:16:02.26,CN,,0000,0000,0000,,Төмендегілерді кім алу керек
Dialogue: 0,0:16:02.26,0:16:03.61,CN,,0000,0000,0000,,Мен көріпкелмін.
Dialogue: 0,0:16:03.61,0:16:04.79,CN,,0000,0000,0000,,Мұнда емес.
Dialogue: 0,0:16:04.85,0:16:06.74,CN,,0000,0000,0000,,Төменде мейрамхана орналасқан.
Dialogue: 0,0:16:09.73,0:16:11.91,CN,,0000,0000,0000,,Енді оны қайтадан көпіртуге болады.
Dialogue: 0,0:16:12.56,0:16:14.13,CN,,0000,0000,0000,,Кешегі аспан ештеңені білдірмеді.
Dialogue: 0,0:16:14.93,0:16:18.99,CN,,0000,0000,0000,,Мен де ваннада отырған кішкентай адаммын.
Dialogue: 0,0:16:22.39,0:16:23.70,CN,,0000,0000,0000,,Басқа Уке-дукури
Dialogue: 0,0:16:25.56,0:16:27.54,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:27.86,0:16:29.22,CN,,0000,0000,0000,,Енді көктегі қашқын
Dialogue: 0,0:16:30.66,0:16:33.07,CN,,0000,0000,0000,,Отбасында бір ғана әйел
Dialogue: 0,0:16:33.51,0:16:34.32,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:34.72,0:16:36.62,CN,,0000,0000,0000,,Мен белгілі бір жалғыздық сезімін сезінемін.
