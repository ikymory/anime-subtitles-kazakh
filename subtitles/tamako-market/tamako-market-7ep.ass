Dialogue: 0,0:18:42.40,0:18:45.24,CN,,0000,0000,0000,,Сіздің қалаңыздағы заттар сіздің үйіңізден бөлек.
Dialogue: 0,0:18:46.73,0:18:47.26,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:18:59.16,0:19:01.71,CN,,0000,0000,0000,,На...
Dialogue: 0,0:19:03.51,0:19:05.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:07.01,0:19:08.15,CN,,0000,0000,0000,,Бұл теңіздің дауысы.
Dialogue: 0,0:19:10.07,0:19:11.93,CN,,0000,0000,0000,,Шығару уақыты
Dialogue: 0,0:19:12.10,0:19:13.73,CN,,0000,0000,0000,,Store Lao Board Dictionary
Dialogue: 0,0:19:13.93,0:19:15.32,CN,,0000,0000,0000,,Кішкентай жеңге
Dialogue: 0,0:19:15.32,0:19:17.49,CN,,0000,0000,0000,,Бұл ұлттық музыкамыздан мүлде бөлек.
Dialogue: 0,0:19:17.78,0:19:20.04,CN,,0000,0000,0000,,Менің музыкам анық және әдемі.
Dialogue: 0,0:19:19.45,0:19:21.18,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:21.21,0:19:21.76,CN,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:19:21.76,0:19:23.77,CN,,0000,0000,0000,,Менің не айтып тұрғанымды білгің келсе,
Dialogue: 0,0:19:23.79,0:19:24.33,CN,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:19:24.55,0:19:26.13,CN,,0000,0000,0000,,Келтірілген зиян
Dialogue: 0,0:19:26.13,0:19:28.99,CN,,0000,0000,0000,,Жоқ... Кешіріңіз...
Dialogue: 0,0:19:29.10,0:19:30.59,CN,,0000,0000,0000,,Мен ханзада туралы хабарлауым керек.
Dialogue: 0,0:19:31.32,0:19:33.23,CN,,0000,0000,0000,,Тек Германияда
Dialogue: 0,0:19:33.47,0:19:36.92,CN,,0000,0000,0000,,Өз тамағын өзі жеген дұрыс.
Dialogue: 0,0:19:36.98,0:19:37.77,CN,,0000,0000,0000,,негізсіз
Dialogue: 0,0:19:37.77,0:19:39.90,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:39.90,0:19:41.20,CN,,0000,0000,0000,,Келісесіз бе?
Dialogue: 0,0:19:41.20,0:19:43.97,CN,,0000,0000,0000,,Адекватсыз
Dialogue: 0,0:19:43.97,0:19:44.98,CN,,0000,0000,0000,,Мен сізді қу емес деп ойлаймын
Dialogue: 0,0:19:41.30,0:19:44.38,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:46.26,0:19:47.82,CN,,0000,0000,0000,,Алғашқы күзгі самал
Dialogue: 0,0:19:50.41,0:19:52.92,CN,,0000,0000,0000,,Кишуенкай ағысы
Dialogue: 0,0:19:55.49,0:19:57.85,CN,,0000,0000,0000,,Бірақ шығыс пен батыста өзгеріс жоқ
Dialogue: 0,0:19:58.51,0:19:59.73,CN,,0000,0000,0000,,Құттықтаймыз
Dialogue: 0,0:19:59.73,0:20:01.63,CN,,0000,0000,0000,,Тікелей өкілдің некесі аяқталды
Dialogue: 0,0:20:02.14,0:20:04.37,CN,,0000,0000,0000,,Тофу әлі де төрт жақты
Dialogue: 0,0:20:05.32,0:20:07.63,CN,,0000,0000,0000,,Тофу таланты - бұл тофу
Dialogue: 0,0:20:13.21,0:20:15.69,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:16.38,0:20:16.99,CN,,0000,0000,0000,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:20:17.95,0:20:19.31,CN,,0000,0000,0000,,Маған сәттілік
Dialogue: 0,0:20:21.49,0:20:22.65,CN,,0000,0000,0000,,Мұндайды есту өте сирек
Dialogue: 0,0:20:23.42,0:20:27.67,CN,,0000,0000,0000,,Бұл Саюридің үйлену тойының жылнамасы.
Dialogue: 0,0:20:28.08,0:20:30.87,CN,,0000,0000,0000,,Мен ойлағанмен салыстырғанда менде ұқсас пішін бар.
Dialogue: 0,0:20:31.77,0:20:32.93,CN,,0000,0000,0000,,Қызыл жапондық ақ?
Dialogue: 0,0:20:33.37,0:20:35.59,CN,,0000,0000,0000,,Уақыт дұрыс болғанда
Dialogue: 0,0:20:36.07,0:20:38.62,CN,,0000,0000,0000,,Бұл жақсы идея
Dialogue: 0,0:20:41.99,0:20:43.88,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:44.59,0:20:46.30,CN,,0000,0000,0000,,Мен емес
Dialogue: 0,0:20:46.42,0:20:47.19,CN,,0000,0000,0000,,Шынайы оқиға
Dialogue: 0,0:20:48.07,0:20:49.97,CN,,0000,0000,0000,,Келесі бет
Dialogue: 0,0:20:58.48,0:20:59.78,CN,,0000,0000,0000,,...?
Dialogue: 0,0:20:59.97,0:21:02.35,CN,,0000,0000,0000,,Жақсы тамақ
Dialogue: 0,0:21:06.47,0:21:08.35,CN,,0000,0000,0000,,Мен қалуға келдім.
Dialogue: 0,0:21:08.54,0:21:11.09,CN,,0000,0000,0000,,Менің отбасым: «Кешіріңіз!» деп айқайлады.
Dialogue: 0,0:21:11.20,0:21:13.39,CN,,0000,0000,0000,,Дегенмен, бұл кемшілік.
Dialogue: 0,0:21:13.92,0:21:15.57,CN,,0000,0000,0000,,Жер тақтасындағы тағы бір станция
Dialogue: 0,0:21:15.88,0:21:17.86,CN,,0000,0000,0000,,Сізді қанағаттандырмады!
Dialogue: 0,0:21:19.65,0:21:21.45,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:21.90,0:21:27.05,CN,,0000,0000,0000,,Сіздің алдыңызда байланыс функциясын пайдалана аласыз.
Dialogue: 0,0:21:27.60,0:21:30.17,CN,,0000,0000,0000,,1 тікелей нұсқа
Dialogue: 0,0:21:30.60,0:21:33.95,CN,,0000,0000,0000,,Насаның әңгімесі: Ханшайым болу қиын болды
Dialogue: 0,0:21:34.76,0:21:36.23,CN,,0000,0000,0000,,Королеваның ересектер бөлмесі
Dialogue: 0,0:21:36.80,0:21:38.93,CN,,0000,0000,0000,,Жолды іздеу
Dialogue: 0,0:21:39.25,0:21:40.07,CN,,0000,0000,0000,,Бұл...
Dialogue: 0,0:21:48.21,0:21:49.52,CN,,0000,0000,0000,,Әрине, бұл дәм
Dialogue: 0,0:21:51.46,0:21:52.15,CN,,0000,0000,0000,,?
Dialogue: 0,0:23:26.11,0:23:28.06,CN,,0000,0000,0000,,Күзгі аспан келді. Мен жұмыртқамын.
Dialogue: 0,0:23:28.30,0:23:30.78,CN,,0000,0000,0000,,Қызыл және ақ шайқастың шығу тегі
Dialogue: 0,0:23:31.02,0:23:34.06,CN,,0000,0000,0000,,Гендзидің ақ туы, Хейкенің қызыл туы
Dialogue: 0,0:23:34.28,0:23:37.25,CN,,0000,0000,0000,,Қызыл және ақ астанадан алған әсерлері
Dialogue: 0,0:23:37.25,0:23:39.43,CN,,0000,0000,0000,,Жиналыстың соңында кейбір кемшіліктер бар.
Dialogue: 0,0:04:28.33,0:04:33.29,CN,,0000,0000,0000,,Үйленген әйел
