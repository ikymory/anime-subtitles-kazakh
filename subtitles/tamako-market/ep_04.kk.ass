Dialogue: 0,0:16:43.26,0:16:44.05,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:45.04,0:16:45.68,CN,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:16:45.73,0:16:48.15,CN,,0000,0000,0000,,Баламның иығы
Dialogue: 0,0:16:49.28,0:16:50.85,CN,,0000,0000,0000,,Шыдамдылық
Dialogue: 0,0:16:54.60,0:16:57.34,CN,,0000,0000,0000,,Орталықтағы жабық жоғарғы көздердің саны 10
Dialogue: 0,0:17:06.55,0:17:08.02,CN,,0000,0000,0000,,Жақсы аяқталды
Dialogue: 0,0:17:08.61,0:17:09.79,CN,,0000,0000,0000,,Бөлек анықтамалық
Dialogue: 0,0:17:11.53,0:17:14.02,CN,,0000,0000,0000,,Біртүрлі сезім
Dialogue: 0,0:17:14.80,0:17:16.34,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:16.49,0:17:17.48,CN,,0000,0000,0000,,Сіз оны жақсы көре аласыз ба?
Dialogue: 0,0:17:17.76,0:17:19.05,CN,,0000,0000,0000,,Ичия ханшайымның мүсіні
Dialogue: 0,0:17:19.46,0:17:20.36,CN,,0000,0000,0000,,Рас?
Dialogue: 0,0:17:20.47,0:17:21.95,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:23.05,0:17:24.24,CN,,0000,0000,0000,,Мелони
Dialogue: 0,0:17:24.95,0:17:26.97,CN,,0000,0000,0000,,Каору мырза қазір сонда ма?
Dialogue: 0,0:17:27.04,0:17:28.98,CN,,0000,0000,0000,,Қазіргі уақытта... 11 ұпай
Dialogue: 0,0:17:29.17,0:17:30.64,CN,,0000,0000,0000,,Мен жүгіруді аяқтадым
Dialogue: 0,0:17:31.00,0:17:31.97,CN,,0000,0000,0000,,Төтенше жағдай
Dialogue: 0,0:17:33.04,0:17:34.20,CN,,0000,0000,0000,,Жүгіру керек
Dialogue: 0,0:18:00.43,0:18:02.13,CN,,0000,0000,0000,,Нәтижесінде өлім.
Dialogue: 0,0:18:09.78,0:18:11.49,CN,,0000,0000,0000,,Жақсы бастама
Dialogue: 0,0:18:13.07,0:18:14.51,CN,,0000,0000,0000,,Усакоға секіру
Dialogue: 0,0:18:14.51,0:18:16.14,CN,,0000,0000,0000,,Тауы.
Dialogue: 0,0:18:20.18,0:18:22.42,CN,,0000,0000,0000,,Шынайы бейне
Dialogue: 0,0:18:24.66,0:18:28.67,CN,,0000,0000,0000,,Келгенше құлап қалмайын деген ниет болды.
Dialogue: 0,0:18:32.45,0:18:35.86,CN,,0000,0000,0000,,Қазіргі уақытта тек фестивальге арналған бақытты кавер шырқалып жатыр
Dialogue: 0,0:18:36.26,0:18:37.41,CN,,0000,0000,0000,,Мен тағы келдім
Dialogue: 0,0:18:38.16,0:18:38.98,CN,,0000,0000,0000,,Қайтып келу
Dialogue: 0,0:18:39.11,0:18:39.93,CN,,0000,0000,0000,,Чико?
Dialogue: 0,0:18:40.37,0:18:42.28,CN,,0000,0000,0000,,Нәтижесінде бұл шығын.
Dialogue: 0,0:18:43.03,0:18:45.10,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:46.00,0:18:47.20,CN,,0000,0000,0000,,Фуфу
Dialogue: 0,0:18:47.59,0:18:50.36,CN,,0000,0000,0000,,Жауапты емес
Dialogue: 0,0:18:50.75,0:18:52.88,CN,,0000,0000,0000,,Дегенмен, өзімшіл
Dialogue: 0,0:18:53.00,0:18:53.82,CN,,0000,0000,0000,,Фестивальге саяхат
Dialogue: 0,0:18:54.71,0:18:55.38,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:18:57.28,0:18:58.15,CN,,0000,0000,0000,,Бұл шағын тағам.
Dialogue: 0,0:18:58.31,0:18:59.50,CN,,0000,0000,0000,,Перфорация әдісі қолданылады
Dialogue: 0,0:18:59.71,0:19:01.23,CN,,0000,0000,0000,,Басқалары құдайларды тастап кетеді
Dialogue: 0,0:19:01.29,0:19:03.36,CN,,0000,0000,0000,,Арқасынан жылау
Dialogue: 0,0:19:03.56,0:19:04.56,CN,,0000,0000,0000,,Жақсы адамдар
Dialogue: 0,0:19:05.37,0:19:06.96,CN,,0000,0000,0000,,Кіріс
Dialogue: 0,0:19:07.23,0:19:09.79,CN,,0000,0000,0000,,Құқық мұқабасы қазір қолданыста
Dialogue: 0,0:19:10.16,0:19:11.83,CN,,0000,0000,0000,,Кіріс
Dialogue: 0,0:19:12.18,0:19:16.09,CN,,0000,0000,0000,,Фестиваль шектелген Тадари-Кон Тенсай Ариха
Dialogue: 0,0:19:16.26,0:19:17.44,CN,,0000,0000,0000,,Киташиракава
Dialogue: 0,0:19:21.45,0:19:23.97,CN,,0000,0000,0000,,Сізге ұнайды
Dialogue: 0,0:19:24.89,0:19:28.00,CN,,0000,0000,0000,,Кемеңгердің дауысы жетті.
Dialogue: 0,0:19:32.40,0:19:33.94,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:33.94,0:19:34.72,CN,,0000,0000,0000,,Чико?
Dialogue: 0,0:19:36.33,0:19:37.10,CN,,0000,0000,0000,,Чико
Dialogue: 0,0:19:37.38,0:19:38.00,CN,,0000,0000,0000,,Жоқ
Dialogue: 0,0:19:38.10,0:19:39.36,CN,,0000,0000,0000,,Юкучи қашып кетті ме?
Dialogue: 0,0:19:39.59,0:19:40.56,CN,,0000,0000,0000,,Ол өзінің Стэндін шығарды. Оған кім қарсы шығады?
Dialogue: 0,0:19:42.07,0:19:43.48,CN,,0000,0000,0000,,Алтын құс?
Dialogue: 0,0:19:43.48,0:19:44.85,CN,,0000,0000,0000,,Бұл белгі.
Dialogue: 0,0:19:45.42,0:19:47.43,CN,,0000,0000,0000,,Мұнда емес.
Dialogue: 0,0:19:47.90,0:19:48.81,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:53.41,0:19:54.26,CN,,0000,0000,0000,,Чико
Dialogue: 0,0:19:54.26,0:19:54.99,CN,,0000,0000,0000,,Міндетті емес
Dialogue: 0,0:19:55.48,0:19:56.33,CN,,0000,0000,0000,,?
Dialogue: 0,0:19:56.38,0:19:57.48,CN,,0000,0000,0000,,Мұндайды есту өте сирек
Dialogue: 0,0:19:58.17,0:19:58.88,CN,,0000,0000,0000,,Мүмкін...
Dialogue: 0,0:19:58.88,0:20:00.35,CN,,0000,0000,0000,,Сәттілік!
Dialogue: 0,0:20:01.20,0:20:02.15,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:02.51,0:20:03.41,CN,,0000,0000,0000,,Алмасу
Dialogue: 0,0:20:03.58,0:20:06.57,CN,,0000,0000,0000,,Әртүрлі уақыт түрлері дәмді шабуылды талап етті
Dialogue: 0,0:20:06.80,0:20:07.81,CN,,0000,0000,0000,,Хош иісті заттар мен хош иісті заттар
Dialogue: 0,0:20:10.89,0:20:11.84,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:12.90,0:20:14.84,CN,,0000,0000,0000,,Бақытты болу үшін жақсы уақыт емес.
Dialogue: 0,0:20:14.96,0:20:16.38,CN,,0000,0000,0000,,Жақында жақсы сурет шықты.
Dialogue: 0,0:20:17.57,0:20:18.84,CN,,0000,0000,0000,,Қайшылық
Dialogue: 0,0:20:18.84,0:20:19.56,CN,,0000,0000,0000,,17-ші эпизод: Бэбифейс
Dialogue: 0,0:20:19.75,0:20:20.74,CN,,0000,0000,0000,,Сіз оны бөлек пайдалана аласыз
Dialogue: 0,0:20:22.69,0:20:24.98,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:26.69,0:20:27.71,CN,,0000,0000,0000,,Полпо
Dialogue: 0,0:20:32.24,0:20:33.65,CN,,0000,0000,0000,,Кіші дела өлім оқиғасы
Dialogue: 0,0:20:33.85,0:20:35.99,CN,,0000,0000,0000,,Накаши аяқталды
Dialogue: 0,0:20:37.33,0:20:40.32,CN,,0000,0000,0000,,Кита Ширакава университетінен сыйлық
Dialogue: 0,0:20:41.29,0:20:43.32,CN,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:20:43.63,0:20:45.68,CN,,0000,0000,0000,,Басқа түсініктемелер қажет
Dialogue: 0,0:20:46.08,0:20:46.98,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:20:47.35,0:20:49.98,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:51.63,0:20:53.29,CN,,0000,0000,0000,,Қайда жіберу керек
Dialogue: 0,0:21:02.23,0:21:05.43,CN,,0000,0000,0000,,Үй иесінен сыйлық
Dialogue: 0,0:21:19.46,0:21:20.94,CN,,0000,0000,0000,,Төменде қай жерден оқуға болады
Dialogue: 0,0:21:29.21,0:21:30.83,CN,,0000,0000,0000,,Сізге ұнайды деп үміттенемін
Dialogue: 0,0:21:34.38,0:21:35.91,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:36.51,0:21:37.38,CN,,0000,0000,0000,,Аняның үйіне қош келдіңіз
Dialogue: 0,0:21:37.67,0:21:39.80,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:40.11,0:21:40.84,CN,,0000,0000,0000,,Ұқсастық
Dialogue: 0,0:21:40.97,0:21:41.78,CN,,0000,0000,0000,,Ондық?
Dialogue: 0,0:21:42.40,0:21:46.54,CN,,0000,0000,0000,,Бала таңдаулы бала...
Dialogue: 0,0:21:52.53,0:21:56.69,CN,,0000,0000,0000,,Ақыл-ойды бірден пайдалану мүмкін емес.
Dialogue: 0,0:21:57.30,0:22:01.81,CN,,0000,0000,0000,,Аспан мен өлім жолы.
Dialogue: 0,0:22:02.24,0:22:03.43,CN,,0000,0000,0000,,Судың температурасы
Dialogue: 0,0:23:35.80,0:23:38.53,CN,,0000,0000,0000,,Жел мезгілі келді, мен жұмыртқамын.
Dialogue: 0,0:23:38.87,0:23:40.70,CN,,0000,0000,0000,,Осы маусым талап етеді
Dialogue: 0,0:23:40.91,0:23:42.88,CN,,0000,0000,0000,,Жаңа өскін пайда болғанға дейін
Dialogue: 0,0:23:42.88,0:23:44.51,CN,,0000,0000,0000,,Бұрынғы Каноко Фуаиды ұрлау
Dialogue: 0,0:23:44.60,0:23:46.69,CN,,0000,0000,0000,,Осының арқасында бала тарихының пілдері бағындырылады.
Dialogue: 0,0:23:46.95,0:23:49.65,CN,,0000,0000,0000,,Мисо сорпасы және мисо сорпасы
Dialogue: 0,0:04:38.50,0:04:43.51,CN,,0000,0000,0000,,Кішкентай махаббат, аяқталды
Dialogue: 0,0:02:50.94,0:02:54.94,CN,,0000,0000,0000,,1-7 қаңтар, Тайшогацу (ерлер жаңа жылы) 15 қаңтар, Шошогацу (әйелдердің жаңа жылы)
Dialogue: 0,0:08:01.91,0:08:05.91,CN,,0000,0000,0000,,“”“”
