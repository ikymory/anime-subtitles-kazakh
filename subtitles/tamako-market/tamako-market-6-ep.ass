Dialogue: 0,0:01:52.17,0:01:56.73,OP-JP,,0000,0000,0000,,Мен өзімді көп адамның арасынан жүгіріп өткендей сезінемін
Dialogue: 0,0:01:56.92,0:01:59.59,OP-JP,,0000,0000,0000,,Мен сені шақырғандай.
Dialogue: 0,0:01:59.59,0:02:02.51,OP-JP,,0000,0000,0000,,Тағы да толып жатыр
Dialogue: 0,0:02:03.45,0:02:08.04,OP-JP,,0000,0000,0000,,Жан-жақта ұшқан фаворитизмді мақтан тұтамын
Dialogue: 0,0:02:08.16,0:02:14.05,OP-JP,,0000,0000,0000,,Мен өзімнің күткен үміттеріме қуанғым келеді
Dialogue: 0,0:02:14.64,0:02:17.17,OP-JP,,0000,0000,0000,,Мен тік тұрдым.
Dialogue: 0,0:02:17.45,0:02:19.81,OP-JP,,0000,0000,0000,,Мен көптен бері күттім
Dialogue: 0,0:02:19.81,0:02:21.71,OP-JP,,0000,0000,0000,,Бірінен-бірі өтіп бара жатқан күлкілер
Dialogue: 0,0:02:21.86,0:02:25.58,OP-JP,,0000,0000,0000,,Мен сені қатты құшақтағым келеді
Dialogue: 0,0:02:28.29,0:02:31.00,OP-JP,,0000,0000,0000,,Келіңіздер, бәріңіз.
Dialogue: 0,0:02:31.09,0:02:38.99,OP-JP,,0000,0000,0000,,Ол әрқашан кенеттен жүгіре бастайды.
Dialogue: 0,0:02:39.07,0:02:44.89,OP-JP,,0000,0000,0000,,Кез келген кештің тұман болатыны сияқты.
Dialogue: 0,0:02:45.14,0:02:52.07,OP-JP,,0000,0000,0000,,Бұл жерді жарқыраған жерде тексеру
Dialogue: 0,0:22:05.97,0:22:09.53,ED-JP,,0000,0000,0000,,бұрылыс жазбасы
Dialogue: 0,0:22:09.53,0:22:13.01,ED-JP,,0000,0000,0000,,Егер ісініп, жарылып кетсе
Dialogue: 0,0:22:13.01,0:22:18.37,ED-JP,,0000,0000,0000,,Бұл күйдірілген жазба болады.
Dialogue: 0,0:22:20.45,0:22:25.54,ED-JP,,0000,0000,0000,,Шаш кептіргішпен түзетілмейтін көңіл-күй
Dialogue: 0,0:22:27.59,0:22:31.45,ED-JP,,0000,0000,0000,,Мен кеше тым көп сөйледім
Dialogue: 0,0:22:34.49,0:22:39.56,ED-JP,,0000,0000,0000,,Мен контактілерді жоюға тырыстым.
Dialogue: 0,0:22:41.49,0:22:45.12,ED-JP,,0000,0000,0000,,Дүние бұлыңғыр
Dialogue: 0,0:22:47.20,0:22:50.50,ED-JP,,0000,0000,0000,,Бір сәтке
Dialogue: 0,0:22:50.50,0:22:54.00,ED-JP,,0000,0000,0000,,Мен сенің тұрған жеріңді тексеремін.
Dialogue: 0,0:22:54.20,0:23:01.23,ED-JP,,0000,0000,0000,,Бір күні сені тастап кетемін бе деп ойлаймын
Dialogue: 0,0:23:04.64,0:23:08.14,ED-JP,,0000,0000,0000,,Әрқашан бірдеңе іздеу
Dialogue: 0,0:23:08.14,0:23:11.73,ED-JP,,0000,0000,0000,,Жақын жерде жасырыну
Dialogue: 0,0:23:11.73,0:23:17.21,ED-JP,,0000,0000,0000,,Тақпақтың жүрегін білсем де
Dialogue: 0,0:23:18.06,0:23:22.24,ED-JP,,0000,0000,0000,,Ах, иіру, иіру, жазулар
Dialogue: 0,0:23:22.24,0:23:25.73,ED-JP,,0000,0000,0000,,Ол ісініп, жарылып кетеді.
Dialogue: 0,0:23:25.73,0:23:30.79,ED-JP,,0000,0000,0000,,Бірақ, жұмбақ әуен
Dialogue: 0,0:23:32.05,0:23:34.65,ED-JP,,0000,0000,0000,,Мен оны ешқашан ұмытпаймын
Dialogue: 0,0:03:02.99,0:03:12.92,Staff,,0000,0000,0000,,Осы субтитр көзімен жасалған, God Subtitles Group (kamigami.org), жеткізу алмасу оқыту, коммерциялық мақсатта пайдалануға тыйым салынған
Dialogue: 0,0:03:02.99,0:03:12.92,Staff,,0000,0000,0000,,:& :&NOKI :& : : :
Dialogue: 0,0:00:14.76,0:00:17.14,JP,,0000,0000,0000,,Қызым, ол қандай тас?
Dialogue: 0,0:00:17.56,0:00:19.63,JP,,0000,0000,0000,,Бұл тас емес, Джизо мүсіні.
Dialogue: 0,0:00:19.88,0:00:21.11,JP,,0000,0000,0000,,Джизо мүсіні
Dialogue: 0,0:00:21.24,0:00:25.02,JP,,0000,0000,0000,,Иә, бірдеңе бола қалса балаларды қорғайды.
Dialogue: 0,0:00:26.29,0:00:27.13,JP,,0000,0000,0000,,Бл…ээ…!!
Dialogue: 0,0:00:27.97,0:00:30.72,JP,,0000,0000,0000,,Бірақ жауға лақтыру ауыр сияқты.
Dialogue: 0,0:00:31.50,0:00:33.64,JP,,0000,0000,0000,,Жоқ, мен сізден өтінемін.
Dialogue: 0,0:00:33.74,0:00:36.13,JP,,0000,0000,0000,,Олай айтсаң, барабан таяқпен ұрылады, Делла-чан.
Dialogue: 0,0:00:36.21,0:00:36.84,JP,,0000,0000,0000,,барабан
Dialogue: 0,0:00:36.90,0:00:39.15,JP,,0000,0000,0000,,Дұрыс, сіз қорқынышты нәрселерге тап боласыз.
Dialogue: 0,0:00:39.72,0:00:40.69,JP,,0000,0000,0000,,Қорқынышты көздер
Dialogue: 0,0:00:41.31,0:00:43.38,JP,,0000,0000,0000,,Сіз үйреніп қалдым деп ойласаңыз да
Dialogue: 0,0:00:43.38,0:00:46.80,JP,,0000,0000,0000,,Біртүрлі мінез-құлық Мен кейде Техника сөздерін көремін
Dialogue: 0,0:00:46.80,0:00:48.51,JP,,0000,0000,0000,,Неғұрлым көп білсең, соншалықты біртүрлі болады.
Dialogue: 0,0:00:48.82,0:00:51.43,JP,,0000,0000,0000,,Түсініксіз, түсініксіз, біртүрлі
Dialogue: 0,0:00:51.96,0:00:53.02,JP,,0000,0000,0000,,Барабан?
Dialogue: 0,0:00:53.57,0:00:54.92,JP,,0000,0000,0000,,Жүр, мен үйге бара жатырмын.
Dialogue: 0,0:00:55.18,0:00:59.59,JP,,0000,0000,0000,,Кешіріңіз, қыз, бұл әсерді қабылдауға уақыт керек деп ойлаймын.
Dialogue: 0,0:00:59.87,0:01:02.74,JP,,0000,0000,0000,,Енді кешігіп кете алмайсың.
Dialogue: 0,0:01:18.49,0:01:19.30,JP,,0000,0000,0000,,Делла-чан
Dialogue: 0,0:01:30.23,0:01:32.61,JP,,0000,0000,0000,,Ақыр соңында танымал емес
Dialogue: 0,0:03:14.03,0:03:18.66,JP,,0000,0000,0000,,Сағат 10-нан бастап бір сағаттай тұтынушылар санын санадым.
Dialogue: 0,0:03:18.99,0:03:21.75,JP,,0000,0000,0000,,Тамаяның алдынан он үш адам өтті.
Dialogue: 0,0:03:23.05,0:03:25.46,JP,,0000,0000,0000,,Сіз не істеп жатырсыз? Үй тапсырмасын орындадың ба?
Dialogue: 0,0:03:25.46,0:03:26.63,JP,,0000,0000,0000,,Дай-чан, үндеме
Dialogue: 0,0:03:26.97,0:03:29.99,JP,,0000,0000,0000,,Менің ойымша, жаяу жүру аздап азаяды.
Dialogue: 0,0:03:30.82,0:03:33.96,JP,,0000,0000,0000,,Тама-чан, жаз өлетін жыл мезгілі.
Dialogue: 0,0:03:34.10,0:03:37.75,JP,,0000,0000,0000,,Ыстықта далаға шығудың өзі азап.
Dialogue: 0,0:03:37.94,0:03:41.07,JP,,0000,0000,0000,,Жаңа ғана таратқан парақшамызға назар аударыңыз.
Dialogue: 0,0:03:41.51,0:03:46.00,JP,,0000,0000,0000,,Мен жазғы аптапты желге ұшатын жоба ойладым.
Dialogue: 0,0:03:46.72,0:03:48.29,JP,,0000,0000,0000,,Тама-чан, бұл не?
Dialogue: 0,0:03:48.39,0:03:49.37,JP,,0000,0000,0000,,Натто
Dialogue: 0,0:03:49.50,0:03:50.52,JP,,0000,0000,0000,,Натто
Dialogue: 0,0:03:50.73,0:03:51.86,JP,,0000,0000,0000,,Бұл Кифунэ-чан.
Dialogue: 0,0:03:52.02,0:03:53.29,JP,,0000,0000,0000,,Кифуне...
Dialogue: 0,0:03:53.87,0:03:57.32,JP,,0000,0000,0000,,Менің ойымша, арулар бар үйлер жазда тамаша болады.
Dialogue: 0,0:03:57.79,0:03:59.31,JP,,0000,0000,0000,,Haunted House
Dialogue: 0,0:04:06.41,0:04:07.27,JP,,0000,0000,0000,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:04:07.51,0:04:08.54,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:04:08.70,0:04:09.46,JP,,0000,0000,0000,,Күткеніңізге рахмет
Dialogue: 0,0:04:09.86,0:04:11.04,JP,,0000,0000,0000,,Келдің бе?
Dialogue: 0,0:04:11.04,0:04:12.17,JP,,0000,0000,0000,,Кочи Кокчи
Dialogue: 0,0:04:12.41,0:04:14.10,JP,,0000,0000,0000,,Неге мұндасың?
Dialogue: 0,0:04:14.22,0:04:16.06,JP,,0000,0000,0000,,дегенді қалай түсінесіңдер? Бұл дөрекі.
Dialogue: 0,0:04:16.45,0:04:20.37,JP,,0000,0000,0000,,Шиори-санды көре алмаймын, кешігіп қалдың ба?
Dialogue: 0,0:04:20.54,0:04:23.46,JP,,0000,0000,0000,,Мен келмеймін. Бұл бадминтон клубының оқу-жаттығу жиыны.
Dialogue: 0,0:04:24.07,0:04:25.07,JP,,0000,0000,0000,,Қалай
Dialogue: 0,0:04:25.30,0:04:26.00,JP,,0000,0000,0000,,Оджи де
Dialogue: 0,0:04:26.11,0:04:28.27,JP,,0000,0000,0000,,Оқу-жаттығу жиыны Көңілім қалды.
Dialogue: 0,0:04:28.38,0:04:30.32,JP,,0000,0000,0000,,Түсіндім, мен сені аядым.
Dialogue: 0,0:04:30.65,0:04:33.80,JP,,0000,0000,0000,,Сонымен мен ойыма келген ойларды жазып алдым.
Dialogue: 0,0:04:34.00,0:04:35.51,JP,,0000,0000,0000,,Көрсет, көрсет
Dialogue: 0,0:04:37.40,0:04:38.25,JP,,0000,0000,0000,,Жарайды
Dialogue: 0,0:04:38.25,0:04:41.28,JP,,0000,0000,0000,,Тағы да кешіріңіз, мен құстарды ұнатпаймын.
Dialogue: 0,0:04:41.39,0:04:42.76,JP,,0000,0000,0000,,Мен бұған жақсы емеспін
Dialogue: 0,0:04:43.44,0:04:44.34,JP,,0000,0000,0000,,Қай жерде
Dialogue: 0,0:04:44.60,0:04:46.77,JP,,0000,0000,0000,,Усаю мырза маған қоймасын қарызға береді.
Dialogue: 0,0:04:46.77,0:04:48.41,JP,,0000,0000,0000,,Сізге жақсы.
Dialogue: 0,0:04:48.60,0:04:50.64,JP,,0000,0000,0000,,Эй, Делла-чан неден қорқады?
Dialogue: 0,0:04:51.76,0:04:53.38,JP,,0000,0000,0000,,Маған қорқынышты нәрсе айтсаңыз
Dialogue: 0,0:04:53.61,0:04:55.96,JP,,0000,0000,0000,,Мен сіздің ойларыңызды арулар үйіне енгіземін.
Dialogue: 0,0:04:56.02,0:04:58.66,JP,,0000,0000,0000,,Арулар үйі дегеніміз не?
Dialogue: 0,0:04:58.74,0:05:00.39,JP,,0000,0000,0000,,Сол жерден
Dialogue: 0,0:05:00.52,0:05:02.17,JP,,0000,0000,0000,,Бұл елулі сарай.
Dialogue: 0,0:05:02.53,0:05:03.98,JP,,0000,0000,0000,,Елес пайда болады
Dialogue: 0,0:05:04.20,0:05:05.82,JP,,0000,0000,0000,,Тамако дәл солай
Dialogue: 0,0:05:06.26,0:05:07.25,JP,,0000,0000,0000,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:05:07.54,0:05:09.54,JP,,0000,0000,0000,,Мен оны интернеттен қарадым.
Dialogue: 0,0:05:09.83,0:05:11.00,JP,,0000,0000,0000,,Уау, бұл жиіркенішті
Dialogue: 0,0:05:11.13,0:05:12.48,JP,,0000,0000,0000,,Күт, күт, күт, күт
Dialogue: 0,0:05:12.64,0:05:17.09,JP,,0000,0000,0000,,Олай болса, аруақ үйі қорқынышты көздерге қарау үшін жолдан шығу керек пе?
Dialogue: 0,0:05:17.35,0:05:19.42,JP,,0000,0000,0000,,Барабан соқты ма?
Dialogue: 0,0:05:19.42,0:05:20.37,JP,,0000,0000,0000,,Бакхи
Dialogue: 0,0:05:20.59,0:05:22.49,JP,,0000,0000,0000,,Жоқ, бұл барабан емес.
Dialogue: 0,0:05:22.49,0:05:24.70,JP,,0000,0000,0000,,Қорқыныш сезіну сізді салқын етеді.
Dialogue: 0,0:05:24.85,0:05:26.37,JP,,0000,0000,0000,,Бұл қызық
Dialogue: 0,0:05:27.18,0:05:28.67,JP,,0000,0000,0000,,Қорқынышты қызықты
Dialogue: 0,0:05:29.60,0:05:33.62,JP,,0000,0000,0000,,Балалар, сізде ерекше жыныстық бейімділіктер бар ма?
Dialogue: 0,0:05:33.73,0:05:35.33,JP,,0000,0000,0000,,Бұл дөрекі кім?
Dialogue: 0,0:05:36.30,0:05:39.69,JP,,0000,0000,0000,,Қорқыныштың қалыпты мөлшері - өмірдің дәмі.
Dialogue: 0,0:05:39.86,0:05:44.78,JP,,0000,0000,0000,,Аспалы көпірдің естелікке айналғанындай, адамның жүрегі де сондай ғажап, жұмбақ.
Dialogue: 0,0:05:45.23,0:05:48.41,JP,,0000,0000,0000,,Кішкентай балалар да келеді, сондықтан қауіпсіздікке мұқият болу керек.
Dialogue: 0,0:05:48.41,0:05:51.28,JP,,0000,0000,0000,,Дұрыс, жоғалған балаларға абай болу керек.
Dialogue: 0,0:05:51.77,0:05:53.43,JP,,0000,0000,0000,,Жоқ емес
Dialogue: 0,0:05:54.12,0:05:55.63,JP,,0000,0000,0000,,Жоқ, мен жай ғана айттым.
Dialogue: 0,0:05:55.79,0:05:57.53,JP,,0000,0000,0000,,Бірақ бұл жиі болады.
Dialogue: 0,0:05:57.75,0:05:59.37,JP,,0000,0000,0000,,Күнде түнде жоғалған бала...
Dialogue: 0,0:05:59.37,0:06:00.84,JP,,0000,0000,0000,,Бір сәтке тоқтаңыз.
Dialogue: 0,0:06:00.84,0:06:01.79,JP,,0000,0000,0000,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:06:01.98,0:06:04.57,JP,,0000,0000,0000,,Бұл енді қалжыңға ұқсамайды.
Dialogue: 0,0:06:04.64,0:06:08.10,JP,,0000,0000,0000,,Кешіріңіз, менің көңіл-күйім ертерек болды.
Dialogue: 0,0:06:08.75,0:06:09.94,JP,,0000,0000,0000,,Мастер
Dialogue: 0,0:06:09.98,0:06:12.00,JP,,0000,0000,0000,,Өтінемін, жат әндерді қоймаңыз
Dialogue: 0,0:06:14.23,0:06:16.09,JP,,0000,0000,0000,,Мен оны көктемге дейін қолданғаннан бері болды.
Dialogue: 0,0:06:16.52,0:06:17.80,JP,,0000,0000,0000,,Сіз осындай жерге баруға болады
Dialogue: 0,0:06:17.87,0:06:18.90,JP,,0000,0000,0000,,Бұл тамаша.
Dialogue: 0,0:06:19.05,0:06:20.14,JP,,0000,0000,0000,,Сәлем Канна-чан
Dialogue: 0,0:06:20.52,0:06:22.49,JP,,0000,0000,0000,,Планер өлшемі
Dialogue: 0,0:06:22.87,0:06:24.13,JP,,0000,0000,0000,,Менің майорым
Dialogue: 0,0:06:24.13,0:06:25.01,JP,,0000,0000,0000,,Бұл Агент Твайлайт басқаратын академия ма?
Dialogue: 0,0:06:27.83,0:06:29.79,JP,,0000,0000,0000,,Мен оның тым әлсіз болып қалмауын қадағалауым керек.
Dialogue: 0,0:06:30.21,0:06:32.39,JP,,0000,0000,0000,,Жоспарлағаныңыздан да көп нәрсені жасай алатын сияқтысыз.
Dialogue: 0,0:06:32.44,0:06:33.28,JP,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:06:33.70,0:06:34.55,JP,,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:06:35.99,0:06:37.70,JP,,0000,0000,0000,,М-тәрізді курсты қабылдау
Dialogue: 0,0:06:37.70,0:06:41.53,JP,,0000,0000,0000,,Қалқалар мен едендер үшін шамамен 200 дана картон қажет болады.
Dialogue: 0,0:06:41.68,0:06:43.19,JP,,0000,0000,0000,,Аа, өте көп
Dialogue: 0,0:06:43.27,0:06:45.77,JP,,0000,0000,0000,,Егер бұл картон болса, алаңдаудың қажеті жоқ.
Dialogue: 0,0:06:47.41,0:06:49.79,JP,,0000,0000,0000,,Сауда ауданындағы барлығына хабарлама
Dialogue: 0,0:06:49.90,0:06:55.29,JP,,0000,0000,0000,,Takedan no Tama-chan жобасына картон мен материалдарды беріңіз.
Dialogue: 0,0:06:58.21,0:06:59.58,JP,,0000,0000,0000,,Мен тағы біраз дайындаймын.
Dialogue: 0,0:06:59.72,0:07:00.59,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:07:00.85,0:07:03.41,JP,,0000,0000,0000,,Мен осындай нәрсені қайта өңдеуге бола ма деп ойладым.
Dialogue: 0,0:07:03.94,0:07:04.88,JP,,0000,0000,0000,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:07:05.57,0:07:07.31,JP,,0000,0000,0000,,Мен парақшаны көшіріп алдым.
Dialogue: 0,0:07:07.87,0:07:10.07,JP,,0000,0000,0000,,Мұны тұтынушыға беруім керек пе?
Dialogue: 0,0:07:11.07,0:07:12.07,JP,,0000,0000,0000,,Натто
Dialogue: 0,0:07:15.12,0:07:16.78,JP,,0000,0000,0000,,Мен Шиори-санмен кездескім келеді
Dialogue: 0,0:07:16.78,0:07:20.08,JP,,0000,0000,0000,,Бірақ адамдардың мені ерекше бейімділігім бар деп ойлағанын қаламаймын.
Dialogue: 0,0:07:20.27,0:07:23.71,JP,,0000,0000,0000,,Осы парақшаны жеткізуім керек пе, жоқ па?
Dialogue: 0,0:07:23.79,0:07:26.55,JP,,0000,0000,0000,,Уайымдау, уайымдау, уайымдау
Dialogue: 0,0:07:25.08,0:07:26.63,JP,,0000,0000,0000,,Бұл шынымен де қауіпті болуы мүмкін.
Dialogue: 0,0:07:27.73,0:07:28.82,JP,,0000,0000,0000,,Бұл қауіпті ме?
Dialogue: 0,0:07:28.99,0:07:30.16,JP,,0000,0000,0000,,Yeah, that’s bad.
Dialogue: 0,0:07:30.64,0:07:31.91,JP,,0000,0000,0000,,Мен бірдеңе істеуім керек
Dialogue: 0,0:07:33.03,0:07:34.84,JP,,0000,0000,0000,,Бұл шынымен де ойлануға тұрарлық.
Dialogue: 0,0:07:39.71,0:07:40.68,JP,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:07:42.10,0:07:42.95,JP,,0000,0000,0000,,Делла
Dialogue: 0,0:07:43.54,0:07:45.80,JP,,0000,0000,0000,,Мен Мидори-чан мен Канна-чанды жібердім.
Dialogue: 0,0:07:46.03,0:07:49.89,JP,,0000,0000,0000,,Мен Делладан дөңгелек тақтаны жеткізуді өтінемін деп ойладым.
Dialogue: 0,0:07:49.98,0:07:50.93,JP,,0000,0000,0000,,Енді, енді.
Dialogue: 0,0:07:51.08,0:07:52.76,JP,,0000,0000,0000,,Бұл не, әпке?
Dialogue: 0,0:07:53.59,0:07:54.47,JP,,0000,0000,0000,,Бұл тал
Dialogue: 0,0:07:54.60,0:07:55.47,JP,,0000,0000,0000,,Шие гүлі шығар
Dialogue: 0,0:07:55.76,0:07:58.05,JP,,0000,0000,0000,,Бұл талға айналатын шие ағашы.
Dialogue: 0,0:07:58.16,0:07:59.17,JP,,0000,0000,0000,,Сакура
Dialogue: 0,0:07:59.46,0:08:00.80,JP,,0000,0000,0000,,Бұл әлі де жақсы емес пе?
Dialogue: 0,0:08:01.05,0:08:03.06,JP,,0000,0000,0000,,Клиенттерге осылай қоңырау шалуға болады ма?
Dialogue: 0,0:08:03.30,0:08:04.85,JP,,0000,0000,0000,,Анко келеді.
Dialogue: 0,0:08:06.17,0:08:08.85,JP,,0000,0000,0000,,Анко келсе 3 есе қорқынышты болады.
Dialogue: 0,0:08:09.05,0:08:10.73,JP,,0000,0000,0000,,Жоқ, 5 есе қосайық
Dialogue: 0,0:08:10.94,0:08:11.96,JP,,0000,0000,0000,,Мен бармаймын.
Dialogue: 0,0:08:22.45,0:08:23.87,JP,,0000,0000,0000,,tatatatata towel towel
Dialogue: 0,0:08:24.91,0:08:25.41,JP,,0000,0000,0000,,Не?
Dialogue: 0,0:08:30.32,0:08:32.88,JP,,0000,0000,0000,,Демек, бұл дұрыс
Dialogue: 0,0:08:32.98,0:08:33.89,JP,,0000,0000,0000,,Бір айдан кейін
Dialogue: 0,0:08:34.00,0:08:35.59,JP,,0000,0000,0000,,Шынымен
Dialogue: 0,0:08:35.59,0:08:37.12,JP,,0000,0000,0000,,Және екі отты шар
Dialogue: 0,0:08:37.18,0:08:38.61,JP,,0000,0000,0000,,Сіз мас болған шығарсыз.
Dialogue: 0,0:08:39.32,0:08:40.40,JP,,0000,0000,0000,,Мен ішпеймін
Dialogue: 0,0:08:40.72,0:08:43.10,JP,,0000,0000,0000,,That's right, boring one.
Dialogue: 0,0:08:43.66,0:08:44.80,JP,,0000,0000,0000,,I'm not the only one
Dialogue: 0,0:08:45.23,0:08:46.80,JP,,0000,0000,0000,,Мен Сашими-санды көрдім.
Dialogue: 0,0:08:47.29,0:08:50.15,JP,,0000,0000,0000,,Office worker returning from work
Dialogue: 0,0:08:50.51,0:08:51.86,JP,,0000,0000,0000,,Және қанды
Dialogue: 0,0:08:55.81,0:08:57.57,JP,,0000,0000,0000,,Неліктен бұл болып жатыр?
Dialogue: 0,0:08:57.82,0:09:01.38,JP,,0000,0000,0000,,Бұл әрқашан тыныш және демалатын сауда ауданы болды.
Dialogue: 0,0:09:02.09,0:09:04.08,JP,,0000,0000,0000,,This is definitely a curse
Dialogue: 0,0:09:04.08,0:09:05.14,JP,,0000,0000,0000,,Қарғыс
Dialogue: 0,0:09:05.40,0:09:07.01,JP,,0000,0000,0000,,Эй, тоқта!
Dialogue: 0,0:09:08.03,0:09:11.26,JP,,0000,0000,0000,,Эй, Ойва-сан сияқты бірдеңе жасасаң ақша төлейміз дейді.
Dialogue: 0,0:09:11.43,0:09:12.93,JP,,0000,0000,0000,,Иә, төлеңіз.
Dialogue: 0,0:09:12.94,0:09:14.06,JP,,0000,0000,0000,,Did someone do it?
Dialogue: 0,0:09:16.50,0:09:18.35,JP,,0000,0000,0000,,Usayu-san, this year's payment?
Dialogue: 0,0:09:18.75,0:09:20.14,JP,,0000,0000,0000,,Оны ешкім істемейді
Dialogue: 0,0:09:20.59,0:09:21.40,JP,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:09:21.45,0:09:22.17,JP,,0000,0000,0000,,Бір айдан кейін
Dialogue: 0,0:09:22.17,0:09:23.02,JP,,0000,0000,0000,,Не болды, Рюзаки?
Dialogue: 0,0:09:23.02,0:09:23.95,JP,,0000,0000,0000,,Бұл өтірік болар еді
Dialogue: 0,0:09:24.43,0:09:26.45,JP,,0000,0000,0000,,Мұндай жағдайда арулар үйі?
Dialogue: 0,0:09:26.86,0:09:30.43,JP,,0000,0000,0000,,Бұл қазірдің өзінде жапондық құбыжық, жын, жын, кекшіл рух.
Dialogue: 0,0:09:30.43,0:09:32.83,JP,,0000,0000,0000,,Барлық бағытта төленуі керек
Dialogue: 0,0:09:33.03,0:09:35.16,JP,,0000,0000,0000,,Hey hey, it's something kids make.
Dialogue: 0,0:09:35.62,0:09:36.97,JP,,0000,0000,0000,,What happened to the child?
Dialogue: 0,0:09:37.04,0:09:38.33,JP,,0000,0000,0000,,Тамако
Dialogue: 0,0:09:38.47,0:09:41.15,JP,,0000,0000,0000,,Dad, you sell oil in a place like this.
Dialogue: 0,0:09:41.45,0:09:43.83,JP,,0000,0000,0000,,It seems tempting, Tamako, actually.
Dialogue: 0,0:09:46.49,0:09:47.85,JP,,0000,0000,0000,,About this, Tama-chan
Dialogue: 0,0:09:48.30,0:09:51.72,JP,,0000,0000,0000,,Hey, what if my Tamako has a curse?
Dialogue: 0,0:09:52.10,0:09:54.84,JP,,0000,0000,0000,,Өйткені мен оны қатты күттім.
Dialogue: 0,0:09:55.04,0:09:56.68,JP,,0000,0000,0000,,Мен Тама-чанды мұңайтқым келеді.
Dialogue: 0,0:10:00.34,0:10:00.99,JP,,0000,0000,0000,,Жарайды
Dialogue: 0,0:10:01.19,0:10:03.38,JP,,0000,0000,0000,,Біз Тама-чанды қорғаймыз.
Dialogue: 0,0:10:03.53,0:10:04.62,JP,,0000,0000,0000,,Қорғау деген нені білдіреді?
Dialogue: 0,0:10:05.86,0:10:08.07,JP,,0000,0000,0000,,Жарайды, оның Тама-чанға қатысы жоқ.
Dialogue: 0,0:10:08.31,0:10:11.13,JP,,0000,0000,0000,,Дұрыс, Тама-чан, уайымдаудың қажеті жоқ.
Dialogue: 0,0:10:14.49,0:10:15.06,JP,,0000,0000,0000,,Жарайды
Dialogue: 0,0:10:15.37,0:10:16.67,JP,,0000,0000,0000,,Бұл жылдам.
Dialogue: 0,0:10:17.04,0:10:17.95,JP,,0000,0000,0000,,Бұл қандай сезімде?
Dialogue: 0,0:10:18.63,0:10:19.61,JP,,0000,0000,0000,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:10:20.79,0:10:22.12,JP,,0000,0000,0000,,Урамешия
Dialogue: 0,0:10:23.96,0:10:25.50,JP,,0000,0000,0000,,Бұл не істейді?
Dialogue: 0,0:10:25.88,0:10:27.12,JP,,0000,0000,0000,,Шегені соғу
Dialogue: 0,0:10:27.28,0:10:28.22,JP,,0000,0000,0000,,Бұл қорқынышты болуы керек
Dialogue: 0,0:10:30.11,0:10:32.38,JP,,0000,0000,0000,,Тауықтың қанатын қараңғыда жақсы көре алмайсың.
Dialogue: 0,0:10:32.64,0:10:34.39,JP,,0000,0000,0000,,Бұл түсіну басқаша шығар.
Dialogue: 0,0:10:34.67,0:10:36.09,JP,,0000,0000,0000,,Тама-чан осында
Dialogue: 0,0:10:36.72,0:10:38.57,JP,,0000,0000,0000,,Мен оны өз үйімнен әкелдім.
Dialogue: 0,0:10:38.91,0:10:41.19,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:10:42.58,0:10:43.77,JP,,0000,0000,0000,,Бұл бонито
Dialogue: 0,0:10:43.94,0:10:46.26,JP,,0000,0000,0000,,Сарымсақ Сарымсақ дәмді.
Dialogue: 0,0:10:46.64,0:10:48.36,JP,,0000,0000,0000,,Сарымсақты көп жеу.
Dialogue: 0,0:10:48.81,0:10:49.73,JP,,0000,0000,0000,,Және бұл
Dialogue: 0,0:10:50.29,0:10:52.06,JP,,0000,0000,0000,,О, сүйкімді
Dialogue: 0,0:10:52.06,0:10:53.23,JP,,0000,0000,0000,,Э-э-э—
Dialogue: 0,0:10:53.33,0:10:55.85,JP,,0000,0000,0000,,Бірақ Дракула жоқ.
Dialogue: 0,0:10:56.05,0:10:57.35,JP,,0000,0000,0000,,Бар ма деп ойлаймын.
Dialogue: 0,0:10:57.35,0:10:59.34,JP,,0000,0000,0000,,Бұл сізге мүлдем қажет емес.
Dialogue: 0,0:11:00.00,0:11:02.96,JP,,0000,0000,0000,,Олай болса, абай болыңыз... Сәттілік.
Dialogue: 0,0:11:03.39,0:11:04.24,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:11:09.24,0:11:10.48,JP,,0000,0000,0000,,Тама-чан
Dialogue: 0,0:11:11.53,0:11:13.05,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:11:13.51,0:11:16.02,JP,,0000,0000,0000,,Сыйлық Мен түс алғым келді.
Dialogue: 0,0:11:16.12,0:11:18.11,JP,,0000,0000,0000,,Иә, бұл жаман нәрсе.
Dialogue: 0,0:11:18.22,0:11:19.78,JP,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:11:19.88,0:11:22.41,JP,,0000,0000,0000,,Мен ішімдік әкелдім.
Dialogue: 0,0:11:22.41,0:11:23.13,JP,,0000,0000,0000,,О.
Dialogue: 0,0:11:23.29,0:11:26.86,JP,,0000,0000,0000,,Бұл ұят. Кәмелетке толмағандықтан іше алмаймын.
Dialogue: 0,0:11:27.40,0:11:29.02,JP,,0000,0000,0000,,Жарайды, мен оны лақтырып жіберемін.
Dialogue: 0,0:11:29.02,0:11:29.88,JP,,0000,0000,0000,,Шашу
Dialogue: 0,0:11:30.53,0:11:31.65,JP,,0000,0000,0000,,Өсімдіктер де
Dialogue: 0,0:11:32.04,0:11:34.28,JP,,0000,0000,0000,,Қараңызшы, оны сол жерге себіңіз, сонда сіз біттіңіз.
Dialogue: 0,0:11:34.99,0:11:36.88,JP,,0000,0000,0000,,Сонда бізде бұл бар
Dialogue: 0,0:11:37.34,0:11:38.35,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:11:39.26,0:11:40.33,JP,,0000,0000,0000,,Алкогольдің дәмі жағымсыз
Dialogue: 0,0:11:41.42,0:11:42.71,JP,,0000,0000,0000,,Жоқ, күте тұрыңыз.
Dialogue: 0,0:11:42.99,0:11:43.80,JP,,0000,0000,0000,,Қалай болды?
Dialogue: 0,0:11:44.23,0:11:47.69,JP,,0000,0000,0000,,Мен өзімнің қаншалықты керемет актриса екенімді көрсеткім келді.
Dialogue: 0,0:11:47.88,0:11:49.01,JP,,0000,0000,0000,,Жарайды, келесі.
Dialogue: 0,0:11:50.17,0:11:51.70,JP,,0000,0000,0000,,Жоқ, жоқ, мен
Dialogue: 0,0:11:51.70,0:11:53.00,JP,,0000,0000,0000,,Жалғастырыңыз.
Dialogue: 0,0:11:53.14,0:11:55.34,JP,,0000,0000,0000,,Менің қызымның және сауда аймағының болашағына қауіп төніп тұр.
Dialogue: 0,0:11:55.52,0:11:58.37,JP,,0000,0000,0000,,Уайымдама, мен мәйітті алып кетемін.
Dialogue: 0,0:11:58.53,0:12:01.43,JP,,0000,0000,0000,,Кел, маған сол адамды көрсет.
Dialogue: 0,0:12:05.34,0:12:05.94,JP,,0000,0000,0000,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:12:05.94,0:12:07.32,JP,,0000,0000,0000,,Ыстық соққы
Dialogue: 0,0:12:07.35,0:12:07.90,JP,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:12:07.90,0:12:08.56,JP,,0000,0000,0000,,Тұз
Dialogue: 0,0:12:08.89,0:12:10.31,JP,,0000,0000,0000,,Иә тұз
Dialogue: 0,0:12:10.37,0:12:11.28,JP,,0000,0000,0000,,...
Dialogue: 0,0:12:11.65,0:12:12.97,JP,,0000,0000,0000,,Ыстық тұз
Dialogue: 0,0:12:13.28,0:12:14.49,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,0:12:14.83,0:12:19.01,JP,,0000,0000,0000,,Бұл тұзды көбірек жеу керек дегенді білдірмей ме, себебі сіз ыстық соққы аласыз?
Dialogue: 0,0:12:19.12,0:12:20.63,JP,,0000,0000,0000,,Иә, солай.
Dialogue: 0,0:12:20.76,0:12:21.50,JP,,0000,0000,0000,,Және бұл
Dialogue: 0,0:12:21.92,0:12:23.27,JP,,0000,0000,0000,,Онда мен мұны істеймін.
Dialogue: 0,0:12:23.67,0:12:24.99,JP,,0000,0000,0000,,О, досым! Осы жеңісті тойлайық
Dialogue: 0,0:12:26.60,0:12:29.37,JP,,0000,0000,0000,,Мұндағы адамдардың сыйлықтары өзгерді.
Dialogue: 0,0:12:30.14,0:12:32.41,JP,,0000,0000,0000,,Иә, бірақ мен бақыттымын.
Dialogue: 0,0:12:33.25,0:12:35.18,JP,,0000,0000,0000,,Құрбандық үстеліне ұқсайды.
Dialogue: 0,0:12:43.01,0:12:44.21,JP,,0000,0000,0000,,Әрқашанғыдай рахмет.
Dialogue: 0,0:12:44.34,0:12:46.41,JP,,0000,0000,0000,,Мен сізді арулар үйін жасап жатқаныңызды естідім.
Dialogue: 0,0:12:46.41,0:12:49.21,JP,,0000,0000,0000,,Иә?! Бұл еліктіретін сияқты.
Dialogue: 0,0:12:49.44,0:12:52.30,JP,,0000,0000,0000,,Иә, қайта келіңіз.
Dialogue: 0,0:12:53.07,0:12:54.50,JP,,0000,0000,0000,,Арулар үйін жасайсыз ба?
Dialogue: 0,0:12:55.90,0:12:57.77,JP,,0000,0000,0000,,Барғыңыз келе ме?
Dialogue: 0,0:12:57.96,0:12:58.86,JP,,0000,0000,0000,,Жақсы №
Dialogue: 0,0:13:01.97,0:13:07.74,JP,,0000,0000,0000,,Әңгіме осында ғана шықса.
Dialogue: 0,0:13:08.61,0:13:10.04,JP,,0000,0000,0000,,Мысықтарға арналған ванна жоқ
Dialogue: 0,0:13:10.04,0:13:11.55,JP,,0000,0000,0000,,Тазалау немесе тазалау
Dialogue: 0,0:13:11.55,0:13:14.72,JP,,0000,0000,0000,,Суланған аяқ іздері шығады
Dialogue: 0,0:13:14.93,0:13:17.53,JP,,0000,0000,0000,,Ол шығып жатыр.
Dialogue: 0,0:13:18.70,0:13:19.44,JP,,0000,0000,0000,,Күлкілі
Dialogue: 0,0:13:20.17,0:13:23.06,JP,,0000,0000,0000,,Мен дайындаған удон кеспесі бір тостаған қысқа болды.
Dialogue: 0,0:13:23.88,0:13:27.07,JP,,0000,0000,0000,,Біреу, бұл да қарғыс
Dialogue: 0,0:13:27.73,0:13:29.48,JP,,0000,0000,0000,,ыстық ыстық
Dialogue: 0,0:13:30.13,0:13:31.23,JP,,0000,0000,0000,,Салқын
Dialogue: 0,0:13:34.99,0:13:36.14,JP,,0000,0000,0000,,Come back to life
Dialogue: 0,0:13:39.62,0:13:42.75,JP,,0000,0000,0000,,Жоқ, егер мен жасасам, біраз уақыт керек еді.
Dialogue: 0,0:13:44.00,0:13:46.66,JP,,0000,0000,0000,,Гүлдер өздігінен гүлдейді
Dialogue: 0,0:13:47.36,0:13:48.85,JP,,0000,0000,0000,,Осы сауда ауданында
Dialogue: 0,0:13:48.95,0:13:49.74,JP,,0000,0000,0000,,Бірдеңе
Dialogue: 0,0:13:49.74,0:13:51.00,JP,,0000,0000,0000,,Болып жатқан жағдай
Dialogue: 0,0:13:53.56,0:13:54.91,JP,,0000,0000,0000,,Бірдеңе шығатын сияқты.
Dialogue: 0,0:13:55.14,0:13:56.13,JP,,0000,0000,0000,,Бір айдан кейін
Dialogue: 0,0:13:56.45,0:13:57.37,JP,,0000,0000,0000,,Бұл тест
Dialogue: 0,0:13:58.04,0:13:59.05,JP,,0000,0000,0000,,Бұл сізде болды ма?
Dialogue: 0,0:13:59.21,0:14:00.79,JP,,0000,0000,0000,,Иә, бәрібір
Dialogue: 0,0:14:01.40,0:14:02.32,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:14:02.55,0:14:03.73,JP,,0000,0000,0000,,Шиори-чан
Dialogue: 0,0:14:03.73,0:14:05.31,JP,,0000,0000,0000,,Шиори Нану
Dialogue: 0,0:14:06.35,0:14:07.88,JP,,0000,0000,0000,,Шиори-сан
Dialogue: 0,0:14:12.55,0:14:13.90,JP,,0000,0000,0000,,Мен саған бірдеңе әкелдім.
Dialogue: 0,0:14:16.23,0:14:17.17,JP,,0000,0000,0000,,Дәмді
Dialogue: 0,0:14:17.96,0:14:19.99,JP,,0000,0000,0000,,Шиоридің крокеттерінен күткендей
Dialogue: 0,0:14:20.39,0:14:22.43,JP,,0000,0000,0000,,Балалар, мұқият тамақтаныңдар.
Dialogue: 0,0:14:22.72,0:14:23.47,JP,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:14:23.90,0:14:25.37,JP,,0000,0000,0000,,Сен аңдыған үйді ойнайсың.
Dialogue: 0,0:14:25.48,0:14:27.14,JP,,0000,0000,0000,,Дұрыс, кіргіңіз келе ме?
Dialogue: 0,0:14:27.42,0:14:28.87,JP,,0000,0000,0000,,Дайын болды.
Dialogue: 0,0:14:29.72,0:14:30.59,JP,,0000,0000,0000,,Жақсы болуы мүмкін
Dialogue: 0,0:14:30.84,0:14:33.48,JP,,0000,0000,0000,,Мен оны тұтынушы тұрғысынан тексергеніңізді қалаймын.
Dialogue: 0,0:14:33.69,0:14:36.73,JP,,0000,0000,0000,,Сосын мен де тексеремін.
Dialogue: 0,0:14:36.97,0:14:39.22,JP,,0000,0000,0000,,Менімен бірге келгің келе ме, Шиори?
Dialogue: 0,0:14:39.52,0:14:43.32,JP,,0000,0000,0000,,Арулар үйіне кірсең, дос болып кетесің деген жын бар сияқты.
Dialogue: 0,0:14:43.76,0:14:44.79,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:14:44.79,0:14:47.65,JP,,0000,0000,0000,,Мен сізге өткен күні үйге баратын жол туралы айттым.
Dialogue: 0,0:14:48.01,0:14:51.04,JP,,0000,0000,0000,,Мен тіл табысудан ұялмаймын.
Dialogue: 0,0:14:51.37,0:14:52.46,JP,,0000,0000,0000,,Маған бәрібір.
Dialogue: 0,0:14:53.44,0:14:54.94,JP,,0000,0000,0000,,Жарайды, егер солай шешсеңіз.
Dialogue: 0,0:14:55.31,0:14:57.28,JP,,0000,0000,0000,,Шиори-чанға өшіңіз бар ма?
Dialogue: 0,0:14:57.77,0:14:58.69,JP,,0000,0000,0000,,Урамесу?
Dialogue: 0,0:14:58.83,0:15:01.57,JP,,0000,0000,0000,,Иә, мен сені жердің шетіне дейін жек көремін.
Dialogue: 0,0:15:01.67,0:15:02.36,JP,,0000,0000,0000,,Міне, бастаймыз!
Dialogue: 0,0:15:03.41,0:15:04.86,JP,,0000,0000,0000,,Оны жандандыру үшін бар күшіңізді салыңыз.
Dialogue: 0,0:15:05.12,0:15:07.56,JP,,0000,0000,0000,,Махаббатымыздың алдында осындай болмашы...
Dialogue: 0,0:15:07.56,0:15:09.05,JP,,0000,0000,0000,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:15:15.29,0:15:17.24,JP,,0000,0000,0000,,Нене Мен қорықтым мен қорықтым
Dialogue: 0,0:15:17.38,0:15:17.92,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:15:18.34,0:15:20.42,JP,,0000,0000,0000,,Сіз шынымен қорықпадыңыз, солай ма?
Dialogue: 0,0:15:20.78,0:15:22.31,JP,,0000,0000,0000,,Жоқ, қорқынышты болды.
Dialogue: 0,0:15:22.42,0:15:25.47,JP,,0000,0000,0000,,Бірақ құстың дауысы ең қорқынышты болды.
Dialogue: 0,0:15:25.87,0:15:27.11,JP,,0000,0000,0000,,Бұл қай жер?
Dialogue: 0,0:15:27.11,0:15:28.72,JP,,0000,0000,0000,,Біз арулар үйін жасап жатырмыз.
Dialogue: 0,0:15:28.86,0:15:30.55,JP,,0000,0000,0000,,Бұл парақша. Өтінемін
Dialogue: 0,0:15:31.27,0:15:32.07,JP,,0000,0000,0000,,Мен де аламын
Dialogue: 0,0:15:32.43,0:15:33.47,JP,,0000,0000,0000,,Мен де
Dialogue: 0,0:15:33.54,0:15:34.14,JP,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:15:34.41,0:15:38.24,JP,,0000,0000,0000,,Усагияма сауда көшесі салқын жаз жобасы сізді айғайлайтыны сөзсіз
Dialogue: 0,0:15:38.44,0:15:41.17,JP,,0000,0000,0000,,Арулар үйіне келгеніңіз үшін рахмет.
Dialogue: 0,0:15:44.81,0:15:48.80,JP,,0000,0000,0000,,Бүгінгі аруақ үйі ешқандай жарақатсыз аяқталады деп үміттенемін.
Dialogue: 0,0:15:52.66,0:15:53.87,JP,,0000,0000,0000,,«Токио Доумда Өлім періштесінің бар екенін раста».
Dialogue: 0,0:15:54.05,0:15:55.43,JP,,0000,0000,0000,,Татарша болады деп ойламадым.
Dialogue: 0,0:15:55.43,0:15:57.35,JP,,0000,0000,0000,,Эй, жоқ, Усаю-сан.
Dialogue: 0,0:15:57.75,0:15:59.88,JP,,0000,0000,0000,,Ол батаға көбірек ұқсайды емес пе?
Dialogue: 0,0:16:00.14,0:16:01.16,JP,,0000,0000,0000,,Бата дегеніміз не?
Dialogue: 0,0:16:03.39,0:16:06.50,JP,,0000,0000,0000,,20 минут қалды, күте тұрыңыз.
Dialogue: 0,0:16:07.19,0:16:08.94,JP,,0000,0000,0000,,Өйткені, мен Тама-чанмен дұрыс сөйлесуім керек.
Dialogue: 0,0:16:09.95,0:16:11.82,JP,,0000,0000,0000,,Бірдеңе болған соң тым кеш деп ойлаймын.
Dialogue: 0,0:16:12.51,0:16:13.96,JP,,0000,0000,0000,,Эй, сен осы жерден кетесің, солай ма?
Dialogue: 0,0:16:14.17,0:16:14.73,JP,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:16:14.73,0:16:15.91,JP,,0000,0000,0000,,Бұл елес
Dialogue: 0,0:16:17.70,0:16:18.47,JP,,0000,0000,0000,,Тама-чан
Dialogue: 0,0:16:19.22,0:16:20.40,JP,,0000,0000,0000,,May I ask?
Dialogue: 0,0:16:21.03,0:16:25.13,JP,,0000,0000,0000,,Қорқынышты отты шарлар Қорқынышты кеңсе қызметкерлері
Dialogue: 0,0:16:25.13,0:16:26.34,JP,,0000,0000,0000,,Иә, аяқ іздері.
Dialogue: 0,0:16:26.53,0:16:27.22,JP,,0000,0000,0000,,Қарға қысы
Dialogue: 0,0:16:27.22,0:16:27.89,JP,,0000,0000,0000,,Гүлдер
Dialogue: 0,0:16:28.08,0:16:30.82,JP,,0000,0000,0000,,Осы сауда ауданында бірдеңе болып жатыр.
Dialogue: 0,0:16:31.00,0:16:32.61,JP,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:16:32.79,0:16:35.06,JP,,0000,0000,0000,,Менің айтайын дегенім, бұл қалыпты жағдай емес пе?
Dialogue: 0,0:16:35.92,0:16:38.18,JP,,0000,0000,0000,,Моншада із қалды.
Dialogue: 0,0:16:38.46,0:16:41.29,JP,,0000,0000,0000,,Қаңғыбас мысықты тамақтандырсаңыз, қорыңыз азаяды.
Dialogue: 0,0:16:41.61,0:16:43.95,JP,,0000,0000,0000,,Тоңазытқыш камерасынан алынған гүлдер гүлдейді.
Dialogue: 0,0:16:44.46,0:16:46.42,JP,,0000,0000,0000,,Мұның бәрі қалыпты, солай емес пе?
Dialogue: 0,0:16:46.65,0:16:49.73,JP,,0000,0000,0000,,Осылай киінсе де сабырлы бала.
Dialogue: 0,0:16:49.98,0:16:52.02,JP,,0000,0000,0000,,Бірақ менен сұрасаңыз, бұл рас
Dialogue: 0,0:16:52.02,0:16:53.13,JP,,0000,0000,0000,,Шешілді ме?
Dialogue: 0,0:16:53.19,0:16:53.77,JP,,0000,0000,0000,,Ерте
Dialogue: 0,0:16:54.17,0:16:55.59,JP,,0000,0000,0000,,Рахмет Шиори-чан
Dialogue: 0,0:16:55.59,0:16:57.77,JP,,0000,0000,0000,,Енді сіз арулар үйін қауіпсіз жасай аласыз.
Dialogue: 0,0:16:57.77,0:16:58.54,JP,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:16:58.59,0:17:00.44,JP,,0000,0000,0000,,Шиори-сан күткендей
Dialogue: 0,0:17:00.62,0:17:03.02,JP,,0000,0000,0000,,Бұл отты шар және кеңсе қызметкері.
Dialogue: 0,0:17:06.30,0:17:09.47,JP,,0000,0000,0000,,Мен қазір кек сақтаймын, сондықтан сәл күте тұрыңыз.
Dialogue: 0,0:17:09.79,0:17:11.37,JP,,0000,0000,0000,,Жарайды. Мен оны өзгертейін бе?
Dialogue: 0,0:17:11.54,0:17:12.66,JP,,0000,0000,0000,,Жоқ, менде бәрі жақсы.
Dialogue: 0,0:17:14.03,0:17:15.18,JP,,0000,0000,0000,,Ах, уф…!
Dialogue: 0,0:17:15.18,0:17:17.05,JP,,0000,0000,0000,,Таңертеңгі тұман емес пе?
Dialogue: 0,0:17:17.43,0:17:18.29,JP,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:17:18.41,0:17:20.01,JP,,0000,0000,0000,,Арулар үйі?
Dialogue: 0,0:17:20.08,0:17:21.95,JP,,0000,0000,0000,,Жақсы, сен жас көрінесің.
Dialogue: 0,0:17:22.29,0:17:23.99,JP,,0000,0000,0000,,Ой, бұл менің әйелім
Dialogue: 0,0:17:24.26,0:17:25.68,JP,,0000,0000,0000,,Қараңдаршы, бұл менің оқушым.
Dialogue: 0,0:17:26.19,0:17:28.37,JP,,0000,0000,0000,,Танысқаныма қуаныштымын, бұл үлкен жетістік.
Dialogue: 0,0:17:28.68,0:17:30.20,JP,,0000,0000,0000,,Иә, рахмет
Dialogue: 0,0:17:31.50,0:17:33.03,JP,,0000,0000,0000,,Тада-кун, жақсысың ба?
Dialogue: 0,0:17:33.69,0:17:35.79,JP,,0000,0000,0000,,Ал Кира
Dialogue: 0,0:17:36.07,0:17:39.11,JP,,0000,0000,0000,,Уайымдама, мен Джуко-чанды қорғаймын.
Dialogue: 0,0:17:37.82,0:17:40.58,JP,,0000,0000,0000,,Мен сізге ең қызықты бөлігін көрсетейін.
Dialogue: 0,0:17:41.48,0:17:42.15,JP,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:17:43.06,0:17:45.27,JP,,0000,0000,0000,,Әй, бұл өте жақсы жасалған емес пе?
Dialogue: 0,0:17:45.67,0:17:47.67,JP,,0000,0000,0000,,Менің оқушыларым да солай жасайды.
Dialogue: 0,0:17:47.97,0:17:49.87,JP,,0000,0000,0000,,Жақсы, мұғалім жақсы.
Dialogue: 0,0:17:50.02,0:17:51.02,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:17:51.98,0:17:53.28,JP,,0000,0000,0000,,Джуко-чан, кеттік
Dialogue: 0,0:17:53.53,0:17:55.65,JP,,0000,0000,0000,,Мен қорқатын адаммын...
Dialogue: 0,0:17:57.32,0:17:58.58,JP,,0000,0000,0000,,Урамешия
Dialogue: 0,0:17:58.97,0:18:00.05,JP,,0000,0000,0000,,Бұл шықты!
Dialogue: 0,0:18:03.30,0:18:05.29,JP,,0000,0000,0000,,Джуко-чан, бұл бөлме қауіпті.
Dialogue: 0,0:18:05.29,0:18:07.06,JP,,0000,0000,0000,,Урамешия
Dialogue: 0,0:18:11.91,0:18:13.01,JP,,0000,0000,0000,,Барлығы дүрбелеңде.
Dialogue: 0,0:18:13.01,0:18:16.35,JP,,0000,0000,0000,,Саяхатшы, мына баланы қолыңа аласың ба?
Dialogue: 0,0:18:16.57,0:18:18.61,JP,,0000,0000,0000,,Тоңып кететін сияқтымын.
Dialogue: 0,0:18:17.30,0:18:18.59,JP,,0000,0000,0000,,Жоқ, қар елі
Dialogue: 0,0:18:20.25,0:18:21.05,JP,,0000,0000,0000,,Қар елі
Dialogue: 0,0:18:21.33,0:18:23.12,JP,,0000,0000,0000,,Керемет, жарайсың
Dialogue: 0,0:18:21.35,0:18:23.16,JP,,0000,0000,0000,,Джуко-чан Джуко-чан
Dialogue: 0,0:18:24.35,0:18:25.83,JP,,0000,0000,0000,,Нашар, шынымен жаман.
Dialogue: 0,0:18:27.17,0:18:27.97,JP,,0000,0000,0000,,Шығуға дейін
Dialogue: 0,0:18:29.74,0:18:34.13,JP,,0000,0000,0000,,Урамешия Урамешия Урамешия
Dialogue: 0,0:18:40.51,0:18:42.93,JP,,0000,0000,0000,,Балалар сендер керемет болдыңдар, қызық болды.
Dialogue: 0,0:18:43.14,0:18:44.08,JP,,0000,0000,0000,,Ол қатты жараланған еді...
Dialogue: 0,0:18:44.25,0:18:46.68,JP,,0000,0000,0000,,Кешіріңіз, Тадаши-кун, әрқашан осылай.
Dialogue: 0,0:18:47.89,0:18:48.98,JP,,0000,0000,0000,,Жақсы жұмыс
Dialogue: 0,0:18:49.92,0:18:51.18,JP,,0000,0000,0000,,Ыстық болды, солай емес пе?
Dialogue: 0,0:18:51.28,0:18:52.21,JP,,0000,0000,0000,,Ха... Уф...
Dialogue: 0,0:18:53.04,0:18:54.02,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,0:18:56.34,0:18:57.66,JP,,0000,0000,0000,,Үш крокет беріңізші
Dialogue: 0,0:18:57.86,0:18:58.55,JP,,0000,0000,0000,,Иә.
Dialogue: 0,0:18:58.82,0:18:59.53,JP,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:18:59.86,0:19:02.08,JP,,0000,0000,0000,,Мен қоғамдық моншаға бармайын деп терлеп жатырмын.
Dialogue: 0,0:19:02.28,0:19:03.64,JP,,0000,0000,0000,,Гүл дүкенін қараңыз
Dialogue: 0,0:19:03.92,0:19:05.00,JP,,0000,0000,0000,,Иә, жарайды.
Dialogue: 0,0:19:06.87,0:19:07.94,JP,,0000,0000,0000,,Мен мұны істегеніме қуаныштымын.
Dialogue: 0,0:19:09.31,0:19:09.82,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:19:10.21,0:19:11.57,JP,,0000,0000,0000,,Керемет табыс!
Dialogue: 0,0:19:11.83,0:19:13.49,JP,,0000,0000,0000,,Мен аздап терлеп кеттім.
Dialogue: 0,0:19:15.66,0:19:19.45,JP,,0000,0000,0000,,Жарайсыңдар, бәріңді аруақ үйінің табыстарымен құттықтаймыз.
Dialogue: 0,0:19:19.92,0:19:21.46,JP,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:19:21.46,0:19:23.92,JP,,0000,0000,0000,,Сондықтан мен сізге бұл жұмыс істейтінін айттым.
Dialogue: 0,0:19:24.03,0:19:25.48,JP,,0000,0000,0000,,Мен оны бірінші рет естіп тұрмын.
Dialogue: 0,0:19:25.63,0:19:27.71,JP,,0000,0000,0000,,Мен қуырылған бонито жасадым.
Dialogue: 0,0:19:28.59,0:19:30.99,JP,,0000,0000,0000,,Күтілгендей, Тама-чан үлкен мәселе.
Dialogue: 0,0:19:30.99,0:19:33.18,JP,,0000,0000,0000,,Жоқ, жоқ, барлығына рахмет.
Dialogue: 0,0:19:33.30,0:19:35.83,JP,,0000,0000,0000,,Не болды? Мен сені мақтасам да, одан ештеңе шықпайды.
Dialogue: 0,0:19:36.03,0:19:38.19,JP,,0000,0000,0000,,Ұялма, ұялма, тойлайық!
Dialogue: 0,0:19:38.19,0:19:40.65,JP,,0000,0000,0000,,Сондықтан мен оны іше алмаймын.
Dialogue: 0,0:19:40.65,0:19:42.23,JP,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:19:43.62,0:19:45.53,JP,,0000,0000,0000,,Шиори-сан, көңілді болды.
Dialogue: 0,0:19:45.84,0:19:48.29,JP,,0000,0000,0000,,Иә, адамдардың бас қосқанына қуаныштымын.
Dialogue: 0,0:19:49.42,0:19:51.49,JP,,0000,0000,0000,,Уақыт өте жақсы болды, солай емес пе?
Dialogue: 0,0:19:51.89,0:19:53.76,JP,,0000,0000,0000,,Келгендеріңізге рахмет.
Dialogue: 0,0:19:53.97,0:19:55.76,JP,,0000,0000,0000,,Бірақ мен отты шарларды түсінбеймін
Dialogue: 0,0:19:55.98,0:19:57.65,JP,,0000,0000,0000,,Және қанды кеңсе қызметкері
Dialogue: 0,0:19:58.12,0:19:59.80,JP,,0000,0000,0000,,Бұл менмін
Dialogue: 0,0:20:02.18,0:20:03.07,JP,,0000,0000,0000,,Оны өз бетінше қалдыр
Dialogue: 0,0:20:03.46,0:20:05.38,JP,,0000,0000,0000,,Жазғы сауда көшесіне қарау
Dialogue: 0,0:20:05.46,0:20:08.40,JP,,0000,0000,0000,,Осылай жалғаса берсе қауіпті, ешкім келмейді деп ойладым.
Dialogue: 0,0:20:08.93,0:20:12.34,JP,,0000,0000,0000,,Біріншіден, мен құс адамдарды өз пайдам үшін пайдалана аламын деп ойладым.
Dialogue: 0,0:20:12.52,0:20:14.03,JP,,0000,0000,0000,,Сол күні үйге қайтар жолда
Dialogue: 0,0:20:14.54,0:20:15.97,JP,,0000,0000,0000,,Ертең кездескенше.
Dialogue: 0,0:20:15.97,0:20:17.09,JP,,0000,0000,0000,,Иә, сау болыңыз
Dialogue: 0,0:20:19.93,0:20:21.92,JP,,0000,0000,0000,,Эй, Тори мырза, сіз қазір осында қала аласыз.
Dialogue: 0,0:20:22.12,0:20:23.18,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:20:23.54,0:20:26.18,JP,,0000,0000,0000,,Ендеше жалғыз жүргенде абай бол, қыз.
Dialogue: 0,0:20:26.23,0:20:30.34,JP,,0000,0000,0000,,Кішкентай құс, бояуды қоймаға қайтарыңыз.
Dialogue: 0,0:20:30.41,0:20:31.69,JP,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:20:32.12,0:20:32.89,JP,,0000,0000,0000,,Және
Dialogue: 0,0:20:33.04,0:20:38.35,JP,,0000,0000,0000,,Өзіңе ұнайтын адаммен арулар үйіне кірсең, дос болып кетесің деген бір жын бар.
Dialogue: 0,0:20:39.35,0:20:41.02,JP,,0000,0000,0000,,Шио Чан ше?
Dialogue: 0,0:20:41.86,0:20:42.87,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:20:42.87,0:20:44.42,JP,,0000,0000,0000,,Ал, ойланып көрейік.
Dialogue: 0,0:20:44.59,0:20:46.04,JP,,0000,0000,0000,,Олай болса үйге бара жатқанда абай болыңыз.
Dialogue: 0,0:20:46.24,0:20:49.31,JP,,0000,0000,0000,,Тори мырза, сіз үйге қарсы бағытта барасыз.
Dialogue: 0,0:20:49.62,0:20:52.25,JP,,0000,0000,0000,,Айналада қалқып жүрген құсқа қараңдар
Dialogue: 0,0:20:52.25,0:20:54.37,JP,,0000,0000,0000,,Сіз мені дұрыс түсінбейсіз деп үміттенемін.
Dialogue: 0,0:20:54.76,0:20:56.69,JP,,0000,0000,0000,,Солған құйрық гүл деп аталады.
Dialogue: 0,0:20:57.00,0:20:57.78,JP,,0000,0000,0000,,Шығатын жол жоқ сияқты
Dialogue: 0,0:20:58.16,0:20:59.26,JP,,0000,0000,0000,,Кеңсе қызметкерлері ше?
Dialogue: 0,0:20:59.26,0:21:00.49,JP,,0000,0000,0000,,Бұл бояу
Dialogue: 0,0:21:00.69,0:21:03.52,JP,,0000,0000,0000,,Мен ол жерге құлап қалар деп үміттендім.
Dialogue: 0,0:21:04.01,0:21:05.60,JP,,0000,0000,0000,,Әй, жаңбыр
Dialogue: 0,0:21:06.65,0:21:08.24,JP,,0000,0000,0000,,Бұл қалай болуы мүмкін?
Dialogue: 0,0:21:08.72,0:21:09.82,JP,,0000,0000,0000,,Рахмет, Тори-сан.
Dialogue: 0,0:21:10.87,0:21:12.25,JP,,0000,0000,0000,,Стратег бар
Dialogue: 0,0:21:12.50,0:21:14.13,JP,,0000,0000,0000,,Канна-чан керемет
Dialogue: 0,0:21:14.30,0:21:15.55,JP,,0000,0000,0000,,Керемет емес
Dialogue: 0,0:21:15.55,0:21:16.57,JP,,0000,0000,0000,,Кешіріңіз, Тори-сан.
Dialogue: 0,0:21:16.86,0:21:19.67,JP,,0000,0000,0000,,Кешірсең, құсқа кек сақтаудың қажеті жоқ.
Dialogue: 0,0:21:19.79,0:21:22.39,JP,,0000,0000,0000,,Жарайды, мен оны бетбелгімен бірге қойдым.
Dialogue: 0,0:21:22.39,0:21:23.88,JP,,0000,0000,0000,,Жақсы, бірақ жақсы емес
Dialogue: 0,0:21:23.88,0:21:27.25,JP,,0000,0000,0000,,Менің пәктігіммен ойнағаның маған ұнамайды.
Dialogue: 0,0:21:26.36,0:21:27.23,JP,,0000,0000,0000,,Делла-чан қауіпті
Dialogue: 0,0:21:27.25,0:21:27.97,JP,,0000,0000,0000,,Ақымақ
Dialogue: 0,0:21:33.91,0:21:35.91,JP,,0000,0000,0000,,Дера дера, қалайсың?
Dialogue: 0,0:21:36.13,0:21:38.11,JP,,0000,0000,0000,,Чой сонда барды, танысқаныма қуаныштымын.
Dialogue: 0,0:21:38.48,0:21:39.44,JP,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:21:39.89,0:21:41.43,JP,,0000,0000,0000,,Иә, қайсысы?
Dialogue: 0,0:21:41.64,0:21:42.83,JP,,0000,0000,0000,,Не келеді?
Dialogue: 0,0:21:43.50,0:21:45.49,JP,,0000,0000,0000,,Саттамонда шуы
Dialogue: 0,0:21:45.51,0:21:47.12,JP,,0000,0000,0000,,Бәрі жақсы, оның соңы жақсы
Dialogue: 0,0:21:47.55,0:21:49.53,JP,,0000,0000,0000,,Мен қазір ұйықтаймын.
Dialogue: 0,0:21:53.73,0:21:56.59,JP,,0000,0000,0000,,Бұл жауға лақтыратын нәрсе.
Dialogue: 0,0:22:01.90,0:22:03.06,JP,,0000,0000,0000,,Бұл хош иіс
Dialogue: 0,0:23:35.98,0:23:38.17,JP,,0000,0000,0000,,Мен шайнайтын кез келген нәрсені жақсы көремін
Dialogue: 0,0:23:38.17,0:23:39.02,JP,,0000,0000,0000,,Бұл Тамако
Dialogue: 0,0:23:39.46,0:23:41.75,JP,,0000,0000,0000,,Варабимимочи ыстықта да жақсы.
Dialogue: 0,0:23:42.06,0:23:44.18,JP,,0000,0000,0000,,Сіз кинако немесе куромицу түрісіз бе?
Dialogue: 0,0:23:44.18,0:23:45.70,JP,,0000,0000,0000,,Мен екеуін де аламын
Dialogue: 0,0:23:46.25,0:23:48.55,JP,,0000,0000,0000,,Келесі жолы қандай күріш тортын жеуге болады?
Dialogue: 0,0:00:14.76,0:00:17.14,CN,,0000,0000,0000,,Кішкентай жеңге
Dialogue: 0,0:00:17.56,0:00:19.63,CN,,0000,0000,0000,,Талант – тас емес, жер – бодхисаттва
Dialogue: 0,0:00:19.88,0:00:21.11,CN,,0000,0000,0000,,Бодхисаттва Бодхисаттва?
Dialogue: 0,0:00:21.24,0:00:25.02,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:26.29,0:00:27.13,CN,,0000,0000,0000,,Сіздің қазіргі қызметіңіз қандай?
Dialogue: 0,0:00:27.97,0:00:30.72,CN,,0000,0000,0000,,Дегенмен, жаумен бір тілде сөйлеу маңызды.
Dialogue: 0,0:00:31.50,0:00:33.64,CN,,0000,0000,0000,,Мұнда емес.
Dialogue: 0,0:00:33.74,0:00:36.13,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:36.21,0:00:36.84,CN,,0000,0000,0000,,?
Dialogue: 0,0:00:36.90,0:00:39.15,CN,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:00:39.72,0:00:40.69,CN,,0000,0000,0000,,Мүмкін нәрсе?
Dialogue: 0,0:00:41.31,0:00:43.38,CN,,0000,0000,0000,,Шығуды өзіңізге бақылау
Dialogue: 0,0:00:43.38,0:00:46.80,CN,,0000,0000,0000,,Күтпеген жерден байқалатын оғаш қозғалыстар
Dialogue: 0,0:00:46.80,0:00:48.51,CN,,0000,0000,0000,,Білім және пайдасы
Dialogue: 0,0:00:48.82,0:00:51.43,CN,,0000,0000,0000,,Заңсыз айқындық, заңсыз түсінік, ғажап, ғажап, ғажап.
Dialogue: 0,0:00:51.96,0:00:53.02,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:53.57,0:00:54.92,CN,,0000,0000,0000,,Сәттілік.
Dialogue: 0,0:00:55.18,0:00:59.59,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:59.87,0:01:02.74,CN,,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:01:18.49,0:01:19.30,CN,,0000,0000,0000,,Кіші дела
Dialogue: 0,0:01:30.23,0:01:32.61,CN,,0000,0000,0000,,Бір адам қайтыс болды.
Dialogue: 0,0:03:14.03,0:03:18.66,CN,,0000,0000,0000,,10 ұпайдан бастап сағатына келушілер саны
Dialogue: 0,0:03:18.99,0:03:21.75,CN,,0000,0000,0000,,Тамаяны тек 13 адам аяқтады
Dialogue: 0,0:03:23.05,0:03:25.46,CN,,0000,0000,0000,,Сіз сонда болған кезде жұмыс аяқталады.
Dialogue: 0,0:03:25.46,0:03:26.63,CN,,0000,0000,0000,,Бұршақ мөлшерінің демалу орны
Dialogue: 0,0:03:26.97,0:03:29.99,CN,,0000,0000,0000,,Осыған байланысты мен жақсы адам емеспін
Dialogue: 0,0:03:30.82,0:03:33.96,CN,,0000,0000,0000,,Басқаша айтқанда, бұл жаздың жарық айы.
Dialogue: 0,0:03:34.10,0:03:37.75,CN,,0000,0000,0000,,Бұл жылу шығатын жер.
Dialogue: 0,0:03:37.94,0:03:41.07,CN,,0000,0000,0000,,Осыған байланысты үй иесінің оқиғаны бөлісудегі ерекше қабілеті бар.
Dialogue: 0,0:03:41.51,0:03:46.00,CN,,0000,0000,0000,,Жаздың шаршаған бір күні деп ойладым.
Dialogue: 0,0:03:46.72,0:03:48.29,CN,,0000,0000,0000,,Кодама осында.
Dialogue: 0,0:03:48.39,0:03:49.37,CN,,0000,0000,0000,,Кептірілген бұршақ?
Dialogue: 0,0:03:49.50,0:03:50.52,CN,,0000,0000,0000,,Бұл бұршақ
Dialogue: 0,0:03:50.73,0:03:51.86,CN,,0000,0000,0000,,Шағын ағаш қайық айқайлау
Dialogue: 0,0:03:52.02,0:03:53.29,CN,,0000,0000,0000,,Оги...кеме
Dialogue: 0,0:03:53.87,0:03:57.32,CN,,0000,0000,0000,,Табиғи жазғы аспан - бұл құт-береке
Dialogue: 0,0:03:57.79,0:03:59.31,CN,,0000,0000,0000,,Ония?
Dialogue: 0,0:04:06.41,0:04:07.27,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:07.51,0:04:08.54,CN,,0000,0000,0000,,Сәлем
Dialogue: 0,0:04:08.70,0:04:09.46,CN,,0000,0000,0000,,Рио Хисато
Dialogue: 0,0:04:09.86,0:04:11.04,CN,,0000,0000,0000,,Мен мұнда келдім
Dialogue: 0,0:04:11.04,0:04:12.17,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:12.41,0:04:14.10,CN,,0000,0000,0000,,Қайдасың?
Dialogue: 0,0:04:14.22,0:04:16.06,CN,,0000,0000,0000,,Бұл рас, кешіріңіз.
Dialogue: 0,0:04:16.45,0:04:20.37,CN,,0000,0000,0000,,Сөйлесу Қарау тарихы жоқ
Dialogue: 0,0:04:20.54,0:04:23.46,CN,,0000,0000,0000,,Клубтың оқу-жаттығу жиыны аяқталды.
Dialogue: 0,0:04:24.07,0:04:25.07,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:25.30,0:04:26.00,CN,,0000,0000,0000,,Оджия осында
Dialogue: 0,0:04:26.11,0:04:28.27,CN,,0000,0000,0000,,Оқу лагері және басқа тәжірибелер
Dialogue: 0,0:04:28.38,0:04:30.32,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:30.65,0:04:33.80,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:34.00,0:04:35.51,CN,,0000,0000,0000,,Мені бақылаңыз, мені бақылаңыз
Dialogue: 0,0:04:37.40,0:04:38.25,CN,,0000,0000,0000,,Өлім оқиғасы
Dialogue: 0,0:04:38.25,0:04:41.28,CN,,0000,0000,0000,,Құшақтап, қайта кел, мен өлемін.
Dialogue: 0,0:04:41.39,0:04:42.76,CN,,0000,0000,0000,,Құсты осылай өлтіру керек.
Dialogue: 0,0:04:43.44,0:04:44.34,CN,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:04:44.60,0:04:46.77,CN,,0000,0000,0000,,Қоян залының ескі тақта тілін бізден жалға алуға болады
Dialogue: 0,0:04:46.77,0:04:48.41,CN,,0000,0000,0000,,Бұл жақсы идея емес.
Dialogue: 0,0:04:48.60,0:04:50.64,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:51.76,0:04:53.38,CN,,0000,0000,0000,,Шығыс пен Батысқа зияныңыз болса, хабарласыңыз.
Dialogue: 0,0:04:53.61,0:04:55.96,CN,,0000,0000,0000,,Ония Сатоя
Dialogue: 0,0:04:56.02,0:04:58.66,CN,,0000,0000,0000,,Әңгімелесу Ония ең жақсы
Dialogue: 0,0:04:58.74,0:05:00.39,CN,,0000,0000,0000,,Елордаға барма
Dialogue: 0,0:05:00.52,0:05:02.17,CN,,0000,0000,0000,,Бұл жындар пайда болатын жер.
Dialogue: 0,0:05:02.53,0:05:03.98,CN,,0000,0000,0000,,Жындар пайда болды ма?
Dialogue: 0,0:05:04.20,0:05:05.82,CN,,0000,0000,0000,,Жұмыртқаларды алмастырғыш ретінде пайдаланады.
Dialogue: 0,0:05:06.26,0:05:07.25,CN,,0000,0000,0000,,Минору және т.б.
Dialogue: 0,0:05:07.54,0:05:09.54,CN,,0000,0000,0000,,Мен осындамын
Dialogue: 0,0:05:09.83,0:05:11.00,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:11.13,0:05:12.48,CN,,0000,0000,0000,,Тең төменгі тең төменгі тең төменгі тең төменгі
Dialogue: 0,0:05:12.64,0:05:17.09,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:17.35,0:05:19.42,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:19.42,0:05:20.37,CN,,0000,0000,0000,,?
Dialogue: 0,0:05:20.59,0:05:22.49,CN,,0000,0000,0000,,Мұнда емес. Мұнда емес.
Dialogue: 0,0:05:22.49,0:05:24.70,CN,,0000,0000,0000,,Ол жерге жету үшін не істеуге болады
Dialogue: 0,0:05:24.85,0:05:26.37,CN,,0000,0000,0000,,Насу – көрікті жер
Dialogue: 0,0:05:27.18,0:05:28.67,CN,,0000,0000,0000,,Мен қайда бола аламын?
Dialogue: 0,0:05:29.60,0:05:33.62,CN,,0000,0000,0000,,Сіздің ерекше қалауыңыз қандай?
Dialogue: 0,0:05:33.73,0:05:35.33,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:05:36.30,0:05:39.69,CN,,0000,0000,0000,,Сәйкес қорқыныш – өмірдің дәмі
Dialogue: 0,0:05:39.86,0:05:44.78,CN,,0000,0000,0000,,Мүсіннің ілінуі туралы естеліктер жинағы.
Dialogue: 0,0:05:45.23,0:05:48.41,CN,,0000,0000,0000,,Содан бері мұқият және қауіпсіз болыңыз.
Dialogue: 0,0:05:48.41,0:05:51.28,CN,,0000,0000,0000,,Сондай-ақ, абай болыңыз!
Dialogue: 0,0:05:51.77,0:05:53.43,CN,,0000,0000,0000,,Жоғалып кетпеу.
Dialogue: 0,0:05:54.12,0:05:55.63,CN,,0000,0000,0000,,Менің өлгім келмеді.
Dialogue: 0,0:05:55.79,0:05:57.53,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:05:57.75,0:05:59.37,CN,,0000,0000,0000,,Елордада әр түнде жоғалған балалар...
Dialogue: 0,0:05:59.37,0:06:00.84,CN,,0000,0000,0000,,т.б. Басқа сөздер
Dialogue: 0,0:06:00.84,0:06:01.79,CN,,0000,0000,0000,,Ойын
Dialogue: 0,0:06:01.98,0:06:04.57,CN,,0000,0000,0000,,Басынан бір нүкте
Dialogue: 0,0:06:04.64,0:06:08.10,CN,,0000,0000,0000,,Оны қабылдаңыз
Dialogue: 0,0:06:08.75,0:06:09.94,CN,,0000,0000,0000,,Ол шабуылын қалай бастайды екен?
Dialogue: 0,0:06:09.98,0:06:12.00,CN,,0000,0000,0000,,Қажетсіз және оғаш музыка
Dialogue: 0,0:06:14.23,0:06:16.09,CN,,0000,0000,0000,,Көктемнің басының қайта жоғалуы
Dialogue: 0,0:06:16.52,0:06:17.80,CN,,0000,0000,0000,,Әртүрлі жергілікті іс-шаралар
Dialogue: 0,0:06:17.87,0:06:18.90,CN,,0000,0000,0000,,Дұрыс сәйкестік
Dialogue: 0,0:06:19.05,0:06:20.14,CN,,0000,0000,0000,,Канна
Dialogue: 0,0:06:20.52,0:06:22.49,CN,,0000,0000,0000,,Kana Kaname ашылу саны аяқталды
Dialogue: 0,0:06:22.87,0:06:24.13,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:24.13,0:06:25.01,CN,,0000,0000,0000,,Канна болғысы келмеуі
Dialogue: 0,0:06:27.83,0:06:29.79,CN,,0000,0000,0000,,Назар аударудың қажеті жоқ
Dialogue: 0,0:06:30.21,0:06:32.39,CN,,0000,0000,0000,,Есептің есебі негізінде қосу
Dialogue: 0,0:06:32.44,0:06:33.28,CN,,0000,0000,0000,,Бұл 3
Dialogue: 0,0:06:33.70,0:06:34.55,CN,,0000,0000,0000,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:06:35.99,0:06:37.70,CN,,0000,0000,0000,,Қажетті М-тәрізді жол сызығының әңгімесі
Dialogue: 0,0:06:37.70,0:06:41.53,CN,,0000,0000,0000,,Қолдану бөлімі Жапондық картон қағаз қорапшасына шолу 200 бет сол және оң
Dialogue: 0,0:06:41.68,0:06:43.19,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:43.27,0:06:45.77,CN,,0000,0000,0000,,Қағаз жәшік әңгімесі
Dialogue: 0,0:06:47.41,0:06:49.79,CN,,0000,0000,0000,,Сауда аймағының сақтық шаралары
Dialogue: 0,0:06:49.90,0:06:55.29,CN,,0000,0000,0000,,Кітап дүкенінен алынған қағаз жәшік және басқа да материалдар
Dialogue: 0,0:06:58.21,0:06:59.58,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:59.72,0:07:00.59,CN,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:07:00.85,0:07:03.41,CN,,0000,0000,0000,,Менде бар ақпаратты қалпына келтіру мүмкіндігін пайдалану
Dialogue: 0,0:07:03.94,0:07:04.88,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:05.57,0:07:07.31,CN,,0000,0000,0000,,Егер мөр сізді қанағаттандырса
Dialogue: 0,0:07:07.87,0:07:10.07,CN,,0000,0000,0000,,Қонақ туралы мәліметтерді қалай алуға болады
Dialogue: 0,0:07:11.07,0:07:12.07,CN,,0000,0000,0000,,Оянсаң, бұршақ бейнесі.
Dialogue: 0,0:07:15.12,0:07:16.78,CN,,0000,0000,0000,,Жақсы ойлар мен естеліктер
Dialogue: 0,0:07:16.78,0:07:20.08,CN,,0000,0000,0000,,Дегенмен, сізде ерекше қалаулар болуы мүмкін екенін ескеріңіз.
Dialogue: 0,0:07:20.27,0:07:23.71,CN,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:07:23.79,0:07:26.55,CN,,0000,0000,0000,,Біртүрлі, біртүрлі, жақсы, жақсы, жақсы
Dialogue: 0,0:07:25.08,0:07:26.63,CN,,0000,0000,0000,,Нақты мағынасы белгісіз.
Dialogue: 0,0:07:27.73,0:07:28.82,CN,,0000,0000,0000,,Бұл біртүрлі
Dialogue: 0,0:07:28.99,0:07:30.16,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:30.64,0:07:31.91,CN,,0000,0000,0000,,Қажетті ақпарат
Dialogue: 0,0:07:33.03,0:07:34.84,CN,,0000,0000,0000,,Шындық - сіз үйренетін ойлау мәселесі
Dialogue: 0,0:07:39.71,0:07:40.68,CN,,0000,0000,0000,,Міне, марапат ретінде сүйіс. Мwah.
Dialogue: 0,0:07:42.10,0:07:42.95,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:43.54,0:07:45.80,CN,,0000,0000,0000,,Ұсақ жасыл жапырақтар
Dialogue: 0,0:07:46.03,0:07:49.89,CN,,0000,0000,0000,,Мен бұл туралы ойладым.
Dialogue: 0,0:07:49.98,0:07:50.93,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:51.08,0:07:52.76,CN,,0000,0000,0000,,Әңгімелесу
Dialogue: 0,0:07:53.59,0:07:54.47,CN,,0000,0000,0000,,Бұл Янагиеда
Dialogue: 0,0:07:54.60,0:07:55.47,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:55.76,0:07:58.05,CN,,0000,0000,0000,,Бұл бас менеджердің тал бұтақтары мен үйеңкі гүлдері.
Dialogue: 0,0:07:58.16,0:07:59.17,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:59.46,0:08:00.80,CN,,0000,0000,0000,,Абсолютті тәртіпсіздік
Dialogue: 0,0:08:01.05,0:08:03.06,CN,,0000,0000,0000,,Насадағы Шығыс және Батыс Ноға қонақтарды шақырды
Dialogue: 0,0:08:03.30,0:08:04.85,CN,,0000,0000,0000,,Кейін
Dialogue: 0,0:08:06.17,0:08:08.85,CN,,0000,0000,0000,,Үш есе көп қорқыныш
Dialogue: 0,0:08:09.05,0:08:10.73,CN,,0000,0000,0000,,Фукоу бес есе екі
Dialogue: 0,0:08:10.94,0:08:11.96,CN,,0000,0000,0000,,Мен кеткен жоқпын
Dialogue: 0,0:08:22.45,0:08:23.87,CN,,0000,0000,0000,,Шаш мата Шаш мата...
Dialogue: 0,0:08:24.91,0:08:25.41,CN,,0000,0000,0000,,Накореджия
Dialogue: 0,0:08:30.32,0:08:32.88,CN,,0000,0000,0000,,Тіл ақиқат.
Dialogue: 0,0:08:32.98,0:08:33.89,CN,,0000,0000,0000,,Шынайы ойдан шығарылған
Dialogue: 0,0:08:34.00,0:08:35.59,CN,,0000,0000,0000,,Сеншинманшу
Dialogue: 0,0:08:35.59,0:08:37.12,CN,,0000,0000,0000,,Алайда жын оты екеуі де
Dialogue: 0,0:08:37.18,0:08:38.61,CN,,0000,0000,0000,,Бізді кездестірмесеңіз, мас болыңыз.
Dialogue: 0,0:08:39.32,0:08:40.40,CN,,0000,0000,0000,,Мен ішімдік ішпеймін
Dialogue: 0,0:08:40.72,0:08:43.10,CN,,0000,0000,0000,,Бұл да дұрыс.
Dialogue: 0,0:08:43.66,0:08:44.80,CN,,0000,0000,0000,,Мен жарық емеспін
Dialogue: 0,0:08:45.23,0:08:46.80,CN,,0000,0000,0000,,Сашими дүкенінің ескі Итаясы келді
Dialogue: 0,0:08:47.29,0:08:50.15,CN,,0000,0000,0000,,Камибан тайпасы мен Хайкай отбасының көшелері
Dialogue: 0,0:08:50.51,0:08:51.86,CN,,0000,0000,0000,,Алайда бүкіл дене қан.
Dialogue: 0,0:08:55.81,0:08:57.57,CN,,0000,0000,0000,,Жануарлар туралы мәліметтер
Dialogue: 0,0:08:57.82,0:09:01.38,CN,,0000,0000,0000,,Сауда ауданындағы бірінші ауысымнан бері астана тыныш және тыныш болды.
Dialogue: 0,0:09:02.09,0:09:04.08,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:04.08,0:09:05.14,CN,,0000,0000,0000,,Сакутака!
Dialogue: 0,0:09:05.40,0:09:07.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:08.03,0:09:11.26,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:11.43,0:09:12.93,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:12.94,0:09:14.06,CN,,0000,0000,0000,,Жынды кім тастап кетті?
Dialogue: 0,0:09:16.50,0:09:18.35,CN,,0000,0000,0000,,Қоян ванна бөлмесінің ескі тақтасы
Dialogue: 0,0:09:18.75,0:09:20.14,CN,,0000,0000,0000,,Ұшқышсыз адам
Dialogue: 0,0:09:20.59,0:09:21.40,CN,,0000,0000,0000,,Сіздің пікіріңіз қандай?
Dialogue: 0,0:09:21.45,0:09:22.17,CN,,0000,0000,0000,,Шынайы оқиға
Dialogue: 0,0:09:22.17,0:09:23.02,CN,,0000,0000,0000,,Кейде оны ес-түссіз етіп ұрып, полиция тоқтатса да…
Dialogue: 0,0:09:23.02,0:09:23.95,CN,,0000,0000,0000,,Отыз ба?
Dialogue: 0,0:09:24.43,0:09:26.45,CN,,0000,0000,0000,,Әртүрлі жағдайлар қайда?
Dialogue: 0,0:09:26.86,0:09:30.43,CN,,0000,0000,0000,,Жапон құбыжықтары мен елестері.
Dialogue: 0,0:09:30.43,0:09:32.83,CN,,0000,0000,0000,,Толығымен жалғастыру керек
Dialogue: 0,0:09:33.03,0:09:35.16,CN,,0000,0000,0000,,Бұл кішкентай баланың ойы.
Dialogue: 0,0:09:35.62,0:09:36.97,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:37.04,0:09:38.33,CN,,0000,0000,0000,,Жұмыртқа
Dialogue: 0,0:09:38.47,0:09:41.15,CN,,0000,0000,0000,,Шындық бірдей.
Dialogue: 0,0:09:41.45,0:09:43.83,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:46.49,0:09:47.85,CN,,0000,0000,0000,,Бұл оқиғаның қажеті жоқ.
Dialogue: 0,0:09:48.30,0:09:51.72,CN,,0000,0000,0000,,Отбасымның жаны мен жұмыртқаның денесіне табыну керек.
Dialogue: 0,0:09:52.10,0:09:54.84,CN,,0000,0000,0000,,Иә, мүмкін.
Dialogue: 0,0:09:55.04,0:09:56.68,CN,,0000,0000,0000,,Кіші допты оқу керек.
Dialogue: 0,0:10:00.34,0:10:00.99,CN,,0000,0000,0000,,Ой, керемет екен.
Dialogue: 0,0:10:01.19,0:10:03.38,CN,,0000,0000,0000,,Біздің бірлестігіміз кіші допты қорғайды
Dialogue: 0,0:10:03.53,0:10:04.62,CN,,0000,0000,0000,,Қалай қорғау керек?
Dialogue: 0,0:10:05.86,0:10:08.07,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:10:08.31,0:10:11.13,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:14.49,0:10:15.06,CN,,0000,0000,0000,,Орындалды
Dialogue: 0,0:10:15.37,0:10:16.67,CN,,0000,0000,0000,,Шинкайку
Dialogue: 0,0:10:17.04,0:10:17.95,CN,,0000,0000,0000,,Алғыс сезімі
Dialogue: 0,0:10:18.63,0:10:19.61,CN,,0000,0000,0000,,Тога Ичиге
Dialogue: 0,0:10:20.79,0:10:22.12,CN,,0000,0000,0000,,Кек
Dialogue: 0,0:10:23.96,0:10:25.50,CN,,0000,0000,0000,,Бұл жеке пайдалануға арналған
Dialogue: 0,0:10:25.88,0:10:27.12,CN,,0000,0000,0000,,Канаме Кайко Каджиджо
Dialogue: 0,0:10:27.28,0:10:28.22,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:30.11,0:10:32.38,CN,,0000,0000,0000,,Өйткені ол қалың және қара.
Dialogue: 0,0:10:32.64,0:10:34.39,CN,,0000,0000,0000,,Сіз оны дерлік түсіне аласыз.
Dialogue: 0,0:10:34.67,0:10:36.09,CN,,0000,0000,0000,,Зейн Кодама
Dialogue: 0,0:10:36.72,0:10:38.57,CN,,0000,0000,0000,,Менің жұбаныш сыйлығым келді.
Dialogue: 0,0:10:38.91,0:10:41.19,CN,,0000,0000,0000,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:10:42.58,0:10:43.77,CN,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:10:43.94,0:10:46.26,CN,,0000,0000,0000,,Сарымсақ
Dialogue: 0,0:10:46.64,0:10:48.36,CN,,0000,0000,0000,,Сарымсақ препараттары
Dialogue: 0,0:10:48.81,0:10:49.73,CN,,0000,0000,0000,,Сіз қайдасыз
Dialogue: 0,0:10:50.29,0:10:52.06,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:52.06,0:10:53.23,CN,,0000,0000,0000,,Э-э...
Dialogue: 0,0:10:53.33,0:10:55.85,CN,,0000,0000,0000,,Пайдаланылмаған вампир
Dialogue: 0,0:10:56.05,0:10:57.35,CN,,0000,0000,0000,,Нәтижесінде бұл қажет.
Dialogue: 0,0:10:57.35,0:10:59.34,CN,,0000,0000,0000,,Шығыс пен Батыс мүлдем қажет емес.
Dialogue: 0,0:11:00.00,0:11:02.96,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:03.39,0:11:04.24,CN,,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:11:09.24,0:11:10.48,CN,,0000,0000,0000,,Кіші доп
Dialogue: 0,0:11:11.53,0:11:13.05,CN,,0000,0000,0000,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:11:13.51,0:11:16.02,CN,,0000,0000,0000,,Мен жіберген жұбаныш тауарлары келіп, сұраныс көбейді.
Dialogue: 0,0:11:16.12,0:11:18.11,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:18.22,0:11:19.78,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:19.88,0:11:22.41,CN,,0000,0000,0000,,Мен ішімдік ішуге келдім.
Dialogue: 0,0:11:22.41,0:11:23.13,CN,,0000,0000,0000,,Ол өлген
Dialogue: 0,0:11:23.29,0:11:26.86,CN,,0000,0000,0000,,Кәмелетке толмағандардың қылмыс және алкогольді ішімдік ішуі
Dialogue: 0,0:11:27.40,0:11:29.02,CN,,0000,0000,0000,,Есептеу аяқталды.
Dialogue: 0,0:11:29.02,0:11:29.88,CN,,0000,0000,0000,,Маңызды ақпарат
Dialogue: 0,0:11:30.53,0:11:31.65,CN,,0000,0000,0000,,Бонсай және басқа орындар
Dialogue: 0,0:11:32.04,0:11:34.28,CN,,0000,0000,0000,,Накасакуды аяқтау
Dialogue: 0,0:11:34.99,0:11:36.88,CN,,0000,0000,0000,,Нагато мәреге бірінші жетті
Dialogue: 0,0:11:37.34,0:11:38.35,CN,,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:11:39.26,0:11:40.33,CN,,0000,0000,0000,,Ичимата Саке дәмі
Dialogue: 0,0:11:41.42,0:11:42.71,CN,,0000,0000,0000,,Рио Хисато
Dialogue: 0,0:11:42.99,0:11:43.80,CN,,0000,0000,0000,,...
