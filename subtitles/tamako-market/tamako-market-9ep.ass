Dialogue: 0,0:10:37.44,0:10:39.19,CN,,0000,0000,0000,,Оған тұрарлық емес
Dialogue: 0,0:10:40.69,0:10:42.11,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:42.75,0:10:44.08,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:44.35,0:10:44.88,CN,,0000,0000,0000,,Джунмей
Dialogue: 0,0:10:45.42,0:10:48.85,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:49.48,0:10:51.93,CN,,0000,0000,0000,,Кішкентай қонақты шақыру
Dialogue: 0,0:10:52.98,0:10:54.04,CN,,0000,0000,0000,,«Ептілік» ойыны
Dialogue: 0,0:10:54.47,0:10:56.12,CN,,0000,0000,0000,,Эня ұйықтап жатыр.
Dialogue: 0,0:10:56.39,0:10:57.27,CN,,0000,0000,0000,,Кешір
Dialogue: 0,0:10:57.45,0:10:59.69,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:11:00.26,0:11:01.46,CN,,0000,0000,0000,,Нана Мен бірінші жүгірдім.
Dialogue: 0,0:11:03.23,0:11:05.38,CN,,0000,0000,0000,,Отты керамика цехы
Dialogue: 0,0:11:05.95,0:11:07.69,CN,,0000,0000,0000,,Апельсин соя соусы
Dialogue: 0,0:11:08.01,0:11:09.74,CN,,0000,0000,0000,,Осыдан кейін күріш ботқасы пісіріледі.
Dialogue: 0,0:11:10.47,0:11:11.48,CN,,0000,0000,0000,,Мен жеймін
Dialogue: 0,0:11:12.41,0:11:13.13,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:13.61,0:11:15.41,CN,,0000,0000,0000,,Уф, мен жаңа ғана өмірден өттім.
Dialogue: 0,0:11:15.87,0:11:17.21,CN,,0000,0000,0000,,Сіз суық тиіп қалдыңыз.
Dialogue: 0,0:11:17.60,0:11:18.25,CN,,0000,0000,0000,,Сондай-ақ қолжетімді
Dialogue: 0,0:11:35.72,0:11:38.51,CN,,0000,0000,0000,,Менің мейрамханам бар.
Dialogue: 0,0:11:39.33,0:11:41.57,CN,,0000,0000,0000,,Өлім рухы
Dialogue: 0,0:11:41.90,0:11:43.84,CN,,0000,0000,0000,,Сіз әлі мектептесіз бе?
Dialogue: 0,0:11:43.98,0:11:45.81,CN,,0000,0000,0000,,Менде не бар?
Dialogue: 0,0:11:47.55,0:11:50.47,CN,,0000,0000,0000,,Көп уақыттың ортасында болғанымнан бері көп уақыт өтті.
Dialogue: 0,0:11:50.89,0:11:53.11,CN,,0000,0000,0000,,Жақсы мен көктен кетемін...
Dialogue: 0,0:12:00.77,0:12:01.96,CN,,0000,0000,0000,,Мен шықтым
Dialogue: 0,0:12:04.10,0:12:06.69,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:07.29,0:12:09.17,CN,,0000,0000,0000,,Кейко
Dialogue: 0,0:12:09.60,0:12:12.90,CN,,0000,0000,0000,,Өтеу мерзімі
Dialogue: 0,0:12:13.41,0:12:16.04,CN,,0000,0000,0000,,Дәл қазір емес
Dialogue: 0,0:12:16.16,0:12:16.72,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:12:16.95,0:12:19.44,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:19.62,0:12:22.94,CN,,0000,0000,0000,,Әпкесі мен әпкесінің туған күні
Dialogue: 0,0:12:23.11,0:12:24.34,CN,,0000,0000,0000,,Наяның өлім сериясы
Dialogue: 0,0:12:24.58,0:12:25.81,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:26.31,0:12:27.68,CN,,0000,0000,0000,,Әсіресе маңызды
Dialogue: 0,0:12:27.96,0:12:32.07,CN,,0000,0000,0000,,Өмірдің сәтсіздігінің себебі бірінші кезекте қарастырылады
Dialogue: 0,0:12:32.39,0:12:33.46,CN,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:12:33.88,0:12:35.12,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:35.46,0:12:38.04,CN,,0000,0000,0000,,Достарыма шыдай алмағандықтан ба?
Dialogue: 0,0:12:38.31,0:12:39.45,CN,,0000,0000,0000,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:12:39.55,0:12:41.22,CN,,0000,0000,0000,,Нацу – ескі шебердің бұйрығы
Dialogue: 0,0:12:41.64,0:12:42.66,CN,,0000,0000,0000,,Сондай-ақ жоғалған.
Dialogue: 0,0:12:42.85,0:12:44.14,CN,,0000,0000,0000,,Зайсуро Ками-Суки аяқталды ма?
Dialogue: 0,0:12:44.55,0:12:45.60,CN,,0000,0000,0000,,Жою
Dialogue: 0,0:12:45.89,0:12:47.13,CN,,0000,0000,0000,,Дүниенің құлауы?
Dialogue: 0,0:12:47.47,0:12:48.88,CN,,0000,0000,0000,,Елордада емес
Dialogue: 0,0:12:48.97,0:12:50.30,CN,,0000,0000,0000,,Бастықтың қылмыстық жазбасы болса да, оны өшіртіп тастаған болар, иә?
Dialogue: 0,0:12:50.64,0:12:52.74,CN,,0000,0000,0000,,Юдзуки-кун оқуды қажет етті
Dialogue: 0,0:12:53.26,0:12:57.74,CN,,0000,0000,0000,,Бірінші семестр аяқталғаннан кейін қазан айында күзгі салтанатты жиын өтті.
Dialogue: 0,0:13:25.20,0:13:27.54,CN,,0000,0000,0000,,Дүкеніңіз туралы не айтасыз?
Dialogue: 0,0:13:27.71,0:13:30.82,CN,,0000,0000,0000,,Әрине, қазір бітті.
Dialogue: 0,0:13:31.39,0:13:32.80,CN,,0000,0000,0000,,Біз бірінші болып бастаймыз.
Dialogue: 0,0:13:32.91,0:13:34.70,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:34.86,0:13:36.56,CN,,0000,0000,0000,,Кондитерлік күріштен жасалған қамыр
Dialogue: 0,0:13:36.77,0:13:37.86,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:39.01,0:13:41.61,CN,,0000,0000,0000,,Сен маған айқайладың.
Dialogue: 0,0:13:39.01,0:13:41.61,CN,,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:13:41.97,0:13:43.97,CN,,0000,0000,0000,,Жұмыртқа буға пісірілген желім күріш
Dialogue: 0,0:13:44.31,0:13:44.70,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:13:44.91,0:13:46.32,CN,,0000,0000,0000,,Жақсы мен өткенмін
Dialogue: 0,0:13:47.42,0:13:49.63,CN,,0000,0000,0000,,Тамақтану жағдайлары
Dialogue: 0,0:13:50.88,0:13:51.64,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:52.27,0:13:54.82,CN,,0000,0000,0000,,Достың досының досы
Dialogue: 0,0:13:55.18,0:13:57.37,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:57.92,0:13:58.92,CN,,0000,0000,0000,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:13:59.00,0:13:59.63,CN,,0000,0000,0000,,Мен кеттім
Dialogue: 0,0:14:03.25,0:14:06.31,CN,,0000,0000,0000,,Бұл өнімді пайдалану жолы
Dialogue: 0,0:14:07.24,0:14:09.47,CN,,0000,0000,0000,,Менің дүкенім қабан етін беруге дайын.
Dialogue: 0,0:14:09.81,0:14:10.49,CN,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:14:10.75,0:14:11.65,CN,,0000,0000,0000,,Чико
Dialogue: 0,0:14:12.27,0:14:13.05,CN,,0000,0000,0000,,Сәлем
Dialogue: 0,0:14:13.37,0:14:14.74,CN,,0000,0000,0000,,Мен мұнда келемін.
Dialogue: 0,0:14:15.13,0:14:16.16,CN,,0000,0000,0000,,Мейірбике күтімі
Dialogue: 0,0:14:16.35,0:14:20.73,CN,,0000,0000,0000,,Канна апа биыл бітірді.
Dialogue: 0,0:14:24.24,0:14:25.76,CN,,0000,0000,0000,,Шағын жасыл ағымдағы орын
Dialogue: 0,0:14:28.02,0:14:29.10,CN,,0000,0000,0000,,4 ұпай жіберіп алды
Dialogue: 0,0:14:31.12,0:14:32.31,CN,,0000,0000,0000,,Дайындық
Dialogue: 0,0:14:33.98,0:14:34.65,CN,,0000,0000,0000,,Келесі жолы
Dialogue: 0,0:14:35.28,0:14:36.25,CN,,0000,0000,0000,,Басталды
Dialogue: 0,0:14:38.50,0:14:39.53,CN,,0000,0000,0000,,Екінші келу
Dialogue: 0,0:14:41.21,0:14:45.36,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:45.54,0:14:48.69,CN,,0000,0000,0000,,Бұл нақты нүкте кескінінің егжей-тегжейлі түсіндірмесі.
Dialogue: 0,0:14:48.78,0:14:50.06,CN,,0000,0000,0000,,Канна
Dialogue: 0,0:14:50.23,0:14:51.24,CN,,0000,0000,0000,,Бұл жылан.
Dialogue: 0,0:14:51.24,0:14:53.69,CN,,0000,0000,0000,,Ной ересек на...накоре...
Dialogue: 0,0:14:53.85,0:14:56.74,CN,,0000,0000,0000,,Нагояға ұқсас жалпы қолмен қозғалыстар
Dialogue: 0,0:14:56.87,0:15:00.39,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:00.39,0:15:02.75,CN,,0000,0000,0000,,Оң – аралдағы жердің биі
Dialogue: 0,0:15:02.92,0:15:06.49,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:06.72,0:15:07.99,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:08.53,0:15:11.12,CN,,0000,0000,0000,,1990 жылдардағы анимациялық мүсіндер
Dialogue: 0,0:15:11.59,0:15:14.00,CN,,0000,0000,0000,,Жақсы шолу
Dialogue: 0,0:15:14.45,0:15:17.44,CN,,0000,0000,0000,,Макино Кананың соңғы жылдағы жарқын болашағы
Dialogue: 0,0:15:17.44,0:15:20.90,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:22.58,0:15:23.67,CN,,0000,0000,0000,,Қосылған май
Dialogue: 0,0:15:24.25,0:15:26.08,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:35.58,0:15:36.16,CN,,0000,0000,0000,,Чико
Dialogue: 0,0:15:36.41,0:15:37.58,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:39.14,0:15:41.92,CN,,0000,0000,0000,,Кадзуко Юдзуки отбасына барып, басқа жерлерге барады.
Dialogue: 0,0:15:43.67,0:15:44.89,CN,,0000,0000,0000,,Қазіргі уақытта қол жетімді және қол жетімді
Dialogue: 0,0:15:47.85,0:15:50.69,CN,,0000,0000,0000,,Басқа сөздер: Түнде көлікті қашан іске қосу керек
Dialogue: 0,0:15:51.69,0:15:53.00,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:53.46,0:15:57.56,CN,,0000,0000,0000,,Мен кетпедім, не айтарымды білмедім.
Dialogue: 0,0:15:58.31,0:16:01.26,CN,,0000,0000,0000,,Конспект... «Мен бақыттымын»
Dialogue: 0,0:16:01.86,0:16:02.78,CN,,0000,0000,0000,,Мүсін мүсіні
Dialogue: 0,0:16:03.13,0:16:04.31,CN,,0000,0000,0000,,Нанари «Хошиджу»
Dialogue: 0,0:16:04.62,0:16:06.26,CN,,0000,0000,0000,,Тілде кім сөйлейді?
Dialogue: 0,0:16:06.50,0:16:08.17,CN,,0000,0000,0000,,Бұл туралы айту қызық.
Dialogue: 0,0:16:08.17,0:16:09.10,CN,,0000,0000,0000,,Тәртіпсіздік
Dialogue: 0,0:16:09.10,0:16:09.77,CN,,0000,0000,0000,,Чико
Dialogue: 0,0:16:12.55,0:16:13.01,CN,,0000,0000,0000,,Неаполь, таңғы 11:26
Dialogue: 0,0:16:14.52,0:16:16.51,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:16.90,0:16:19.23,CN,,0000,0000,0000,,Мен саған ғашықпын
Dialogue: 0,0:16:21.14,0:16:23.06,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:23.44,0:16:25.36,CN,,0000,0000,0000,,Юдзуки мырза
Dialogue: 0,0:16:26.58,0:16:29.44,CN,,0000,0000,0000,,Юдзуки-кунның ағымдағы жылы туралы ойларым.
Dialogue: 0,0:16:30.53,0:16:32.77,CN,,0000,0000,0000,,Юдзуки-кунның орта мектебі
Dialogue: 0,0:16:33.23,0:16:35.02,CN,,0000,0000,0000,,Осыған байланысты мен үшін жақсы жыл болды.
Dialogue: 0,0:16:35.35,0:16:37.61,CN,,0000,0000,0000,,Температура тұрақты.
Dialogue: 0,0:16:44.99,0:16:47.17,CN,,0000,0000,0000,,Тамақ ішуге жақсы жыл ба?
Dialogue: 0,0:16:47.74,0:16:48.30,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:16:48.45,0:16:49.96,CN,,0000,0000,0000,,Әңгіме сізді қызықтырады ма?
Dialogue: 0,0:16:50.50,0:16:51.50,CN,,0000,0000,0000,,Әрине
Dialogue: 0,0:16:51.84,0:16:53.55,CN,,0000,0000,0000,,Чидо Рё мен кеттім
Dialogue: 0,0:16:56.02,0:16:56.69,CN,,0000,0000,0000,,Кіші дела
Dialogue: 0,0:16:56.84,0:16:57.44,CN,,0000,0000,0000,,Дрейф
Dialogue: 0,0:16:57.72,0:16:58.76,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:59.02,0:17:01.15,CN,,0000,0000,0000,,Позитивті айқын, өзімді қамтитын
Dialogue: 0,0:17:01.28,0:17:02.66,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:31.00,0:17:32.19,CN,,0000,0000,0000,,Пайдаланған...
Dialogue: 0,0:17:32.67,0:17:33.46,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:34.73,0:17:35.88,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:36.01,0:17:36.67,CN,,0000,0000,0000,,Дела
Dialogue: 0,0:17:37.01,0:17:39.71,CN,,0000,0000,0000,,Мен ұшақты пайдалануым керек, алдымен оны қолданған дұрыс.
Dialogue: 0,0:17:39.95,0:17:43.15,CN,,0000,0000,0000,,т.б., қулық пен қулық
Dialogue: 0,0:17:52.71,0:17:55.98,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:58.53,0:18:00.75,CN,,0000,0000,0000,,Нана...Нана...
Dialogue: 0,0:18:01.15,0:18:03.07,CN,,0000,0000,0000,,Тізе жамылғысының қажеті жоқ па?
Dialogue: 0,0:18:04.96,0:18:06.95,CN,,0000,0000,0000,,Ичиго Ичиге мен сені сонда қалдырамын.
Dialogue: 0,0:18:07.66,0:18:09.08,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:09.24,0:18:10.39,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:10.45,0:18:12.39,CN,,0000,0000,0000,,Бұл бөлім
Dialogue: 0,0:18:12.51,0:18:13.27,CN,,0000,0000,0000,,Сатып алу бағасы
Dialogue: 0,0:18:13.87,0:18:14.94,CN,,0000,0000,0000,,Ұйқы...
Dialogue: 0,0:18:15.66,0:18:16.26,CN,,0000,0000,0000,,Дела
Dialogue: 0,0:18:16.26,0:18:17.31,CN,,0000,0000,0000,,Мен бірінші болып кешірім сұраймын.
Dialogue: 0,0:18:17.96,0:18:21.30,CN,,0000,0000,0000,,Бұл тағы бір жылдық сыйлық.
Dialogue: 0,0:18:21.56,0:18:22.17,CN,,0000,0000,0000,,Жыл жылы?
Dialogue: 0,0:18:22.48,0:18:24.80,CN,,0000,0000,0000,,Бұл ағымдағы жыл.
Dialogue: 0,0:18:24.90,0:18:27.52,CN,,0000,0000,0000,,Осыған байланысты
Dialogue: 0,0:18:27.71,0:18:31.74,CN,,0000,0000,0000,,Жыл – жақсы жыл
Dialogue: 0,0:18:32.46,0:18:35.06,CN,,0000,0000,0000,,Ryomen Horyokishi...Мен мұнда емеспін
Dialogue: 0,0:18:35.06,0:18:37.05,CN,,0000,0000,0000,,Бұршақ қайдан алынған?
Dialogue: 0,0:18:37.33,0:18:41.27,CN,,0000,0000,0000,,Алайда, бұл...
Dialogue: 0,0:18:41.48,0:18:42.93,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:45.25,0:18:48.93,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:49.36,0:18:53.53,CN,,0000,0000,0000,,Жаңа жыл кеші келгенде мен кештен шығып, дүкеннен шықтым.
Dialogue: 0,0:18:53.87,0:18:55.62,CN,,0000,0000,0000,,Сол кездегі жиналысты қайта қарау
Dialogue: 0,0:18:58.21,0:18:58.88,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:19:02.96,0:19:04.40,CN,,0000,0000,0000,,Жеке тұтынушыларға қызмет көрсету
Dialogue: 0,0:19:04.67,0:19:05.69,CN,,0000,0000,0000,,Жақсы тамақ
Dialogue: 0,0:19:05.75,0:19:07.60,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:08.28,0:19:10.32,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:10.32,0:19:11.95,CN,,0000,0000,0000,,Жалғандық
Dialogue: 0,0:19:12.99,0:19:13.66,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:27.98,0:19:33.57,CN,,0000,0000,0000,,Бұл басқаша ойлау тәсілі.
Dialogue: 0,0:19:34.94,0:19:40.36,CN,,0000,0000,0000,,Өмір бойы бақыт тілеймін
Dialogue: 0,0:19:42.03,0:19:52.71,CN,,0000,0000,0000,,Мен сенімен бақытты болғаныма қуаныштымын
Dialogue: 0,0:19:53.82,0:19:55.17,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:56.32,0:19:57.27,CN,,0000,0000,0000,,Иккушита
Dialogue: 0,0:19:57.47,0:19:58.60,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:58.72,0:19:59.56,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:00.21,0:20:01.63,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:01.63,0:20:02.50,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:20:02.50,0:20:03.26,CN,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:20:03.61,0:20:05.34,CN,,0000,0000,0000,,Мен де кіршіксізмін.
Dialogue: 0,0:20:06.62,0:20:09.21,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:09.81,0:20:13.26,CN,,0000,0000,0000,,Әуен мен Премьер-Министрдің айырмашылығы өте үлкен.
Dialogue: 0,0:20:13.97,0:20:16.16,CN,,0000,0000,0000,,Мен саңыраумын.
Dialogue: 0,0:20:16.45,0:20:17.10,CN,,0000,0000,0000,,Накая?
Dialogue: 0,0:20:17.76,0:20:22.70,CN,,0000,0000,0000,,Накубута - Хизутоши жасаған ән.
Dialogue: 0,0:20:23.81,0:20:26.68,CN,,0000,0000,0000,,Автор жазған ба?
Dialogue: 0,0:20:26.68,0:20:29.37,CN,,0000,0000,0000,,Кунио
Dialogue: 0,0:20:29.87,0:20:32.92,CN,,0000,0000,0000,,Студенттік кезімде мен Вазу Бин университетінің бастауыш тобының мүшесі болдым.
Dialogue: 0,0:20:54.99,0:20:56.09,CN,,0000,0000,0000,,Бұл қарт.
Dialogue: 0,0:20:57.17,0:20:58.57,CN,,0000,0000,0000,,Бұл адам сіздің әкеңіз бе?
Dialogue: 0,0:20:59.52,0:21:01.37,CN,,0000,0000,0000,,Бұл әннің аты
Dialogue: 0,0:21:01.53,0:21:02.95,CN,,0000,0000,0000,,Мүлдем басқа
Dialogue: 0,0:21:03.40,0:21:04.65,CN,,0000,0000,0000,,Махаббат әні?
Dialogue: 0,0:21:13.45,0:21:15.37,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:15.77,0:21:19.75,CN,,0000,0000,0000,,Жақсы адам, ескі тақта және жұмыртқаның әкесі
Dialogue: 0,0:21:20.23,0:21:22.91,CN,,0000,0000,0000,,Бір адам қатты қуанды.
Dialogue: 0,0:21:23.49,0:21:26.19,CN,,0000,0000,0000,,Адам болсаң, біздің қызметкерсің.
Dialogue: 0,0:21:26.66,0:21:27.86,CN,,0000,0000,0000,,...
Dialogue: 0,0:22:07.07,0:22:09.04,CN,,0000,0000,0000,,...
Dialogue: 0,0:22:09.95,0:22:11.01,CN,,0000,0000,0000,,Нана Минг Тенвью
Dialogue: 0,0:22:11.58,0:22:13.01,CN,,0000,0000,0000,,Йозо т.б.
Dialogue: 0,0:22:15.28,0:22:18.37,CN,,0000,0000,0000,,Тамақ және сусын
Dialogue: 0,0:22:18.98,0:22:21.16,CN,,0000,0000,0000,,Барлығы біреуді жақсы көреді
Dialogue: 0,0:22:21.63,0:22:23.93,CN,,0000,0000,0000,,Әрбір адам өзіне ұнамды адам.
Dialogue: 0,0:22:24.63,0:22:26.85,CN,,0000,0000,0000,,Қалаға деген махаббат кім?
Dialogue: 0,0:22:27.46,0:22:29.99,CN,,0000,0000,0000,,Саған менің бейнем келді.
Dialogue: 0,0:22:56.53,0:23:02.38,CN,,0000,0000,0000,,...
Dialogue: 0,0:23:02.61,0:23:03.38,CN,,0000,0000,0000,,...
Dialogue: 0,0:23:03.38,0:23:04.41,CN,,0000,0000,0000,,Мен оны көрдім.
Dialogue: 0,0:23:06.50,0:23:08.71,CN,,0000,0000,0000,,Әке
Dialogue: 0,0:23:09.06,0:23:14.14,CN,,0000,0000,0000,,...
Dialogue: 0,0:23:15.25,0:23:16.51,CN,,0000,0000,0000,,...
Dialogue: 0,0:23:24.40,0:23:28.14,CN,,0000,0000,0000,,Барлығы біреуді жақсы көреді
Dialogue: 0,0:23:35.66,0:23:38.26,CN,,0000,0000,0000,,Мен жұмыртқамын.
Dialogue: 0,0:23:38.75,0:23:42.16,CN,,0000,0000,0000,,Бұл тәтті және дәмді жеміс сыртқы әлемге ұқсайды.
Dialogue: 0,0:23:42.17,0:23:43.67,CN,,0000,0000,0000,,Курико Шинка Махаббат
Dialogue: 0,0:23:43.90,0:23:46.14,CN,,0000,0000,0000,,Каштан сорпасы
Dialogue: 0,0:23:46.62,0:23:48.91,CN,,0000,0000,0000,,Жиналыс келгенде, олқылықтар болады.
Dialogue: 0,0:02:57.90,0:02:59.32,CN,,0000,0000,0000,,10 қазан Жаңа жыл мерекесі.
Dialogue: 0,0:04:54.98,0:04:59.99,CN,,0000,0000,0000,,Махаббат әні Махаббат
Dialogue: 0,0:23:50.41,0:23:56.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
