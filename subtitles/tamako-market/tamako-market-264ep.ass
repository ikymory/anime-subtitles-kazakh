Dialogue: 0,0:01:25.14,0:01:29.70,OP-JP,,0000,0000,0000,,Мен өзімді көп адамның арасынан жүгіріп өткендей сезінемін
Dialogue: 0,0:01:29.89,0:01:32.56,OP-JP,,0000,0000,0000,,Мен сені шақырғандай.
Dialogue: 0,0:01:32.56,0:01:35.48,OP-JP,,0000,0000,0000,,Тағы да толып жатыр
Dialogue: 0,0:01:36.42,0:01:41.01,OP-JP,,0000,0000,0000,,Жан-жақта ұшқан фаворитизмді мақтан тұтамын
Dialogue: 0,0:01:41.13,0:01:47.02,OP-JP,,0000,0000,0000,,Мен өзімнің күткен үміттеріме қуанғым келеді
Dialogue: 0,0:01:47.61,0:01:50.14,OP-JP,,0000,0000,0000,,Мен тік тұрдым.
Dialogue: 0,0:01:50.42,0:01:52.78,OP-JP,,0000,0000,0000,,Мен көптен бері күттім
Dialogue: 0,0:01:52.78,0:01:54.68,OP-JP,,0000,0000,0000,,Бірінен-бірі өтіп бара жатқан күлкілер
Dialogue: 0,0:01:54.83,0:01:58.55,OP-JP,,0000,0000,0000,,Мен сені қатты құшақтағым келеді
Dialogue: 0,0:02:01.26,0:02:03.97,OP-JP,,0000,0000,0000,,Келіңіздер, бәріңіз.
Dialogue: 0,0:02:04.06,0:02:11.96,OP-JP,,0000,0000,0000,,Ол әрқашан кенеттен жүгіре бастайды.
Dialogue: 0,0:02:12.04,0:02:17.86,OP-JP,,0000,0000,0000,,Кез келген кештің тұман болатыны сияқты.
Dialogue: 0,0:02:18.11,0:02:25.04,OP-JP,,0000,0000,0000,,Бұл жерді жарқыраған жерде тексеру
Dialogue: 0,0:22:05.97,0:22:09.53,ED-JP,,0000,0000,0000,,бұрылыс жазбасы
Dialogue: 0,0:22:09.53,0:22:13.01,ED-JP,,0000,0000,0000,,Егер ісініп, жарылып кетсе
Dialogue: 0,0:22:13.01,0:22:18.37,ED-JP,,0000,0000,0000,,Бұл күйдірілген жазба болады.
Dialogue: 0,0:22:20.45,0:22:25.54,ED-JP,,0000,0000,0000,,Шаш кептіргішпен түзетілмейтін көңіл-күй
Dialogue: 0,0:22:27.59,0:22:31.45,ED-JP,,0000,0000,0000,,Мен кеше тым көп сөйледім
Dialogue: 0,0:22:34.49,0:22:39.56,ED-JP,,0000,0000,0000,,Мен контактілерді жоюға тырыстым.
Dialogue: 0,0:22:41.49,0:22:45.12,ED-JP,,0000,0000,0000,,Дүние бұлыңғыр
Dialogue: 0,0:22:47.20,0:22:50.50,ED-JP,,0000,0000,0000,,Бір сәтке
Dialogue: 0,0:22:50.50,0:22:54.00,ED-JP,,0000,0000,0000,,Мен сенің тұрған жеріңді тексеремін.
Dialogue: 0,0:22:54.20,0:23:01.23,ED-JP,,0000,0000,0000,,Бір күні сені тастап кетемін бе деп ойлаймын
Dialogue: 0,0:23:04.64,0:23:08.14,ED-JP,,0000,0000,0000,,Әрқашан бірдеңе іздеу
Dialogue: 0,0:23:08.14,0:23:11.73,ED-JP,,0000,0000,0000,,Жақын жерде жасырыну
Dialogue: 0,0:23:11.73,0:23:17.21,ED-JP,,0000,0000,0000,,Мен бұлдыр сезімді білсем де
Dialogue: 0,0:23:18.06,0:23:22.24,ED-JP,,0000,0000,0000,,Ах, иіру, иіру, жазулар
Dialogue: 0,0:23:22.24,0:23:25.73,ED-JP,,0000,0000,0000,,Ол ісініп, жарылып кетеді.
Dialogue: 0,0:23:25.73,0:23:30.79,ED-JP,,0000,0000,0000,,Бірақ, жұмбақ әуен
Dialogue: 0,0:23:32.05,0:23:34.65,ED-JP,,0000,0000,0000,,Мен оны ешқашан ұмытпаймын
Dialogue: 0,0:02:35.84,0:02:45.89,Staff,,0000,0000,0000,,Осы субтитр көзімен жасалған, God Subtitles Group (kamigami.org), жеткізу алмасу оқыту, коммерциялық мақсатта пайдалануға тыйым салынған
Dialogue: 0,0:02:35.84,0:02:45.89,Staff,,0000,0000,0000,,:& :&NOKI :& : : :
Dialogue: 0,0:00:21.41,0:00:22.31,JP,,0000,0000,0000,,Анко ханшайым
Dialogue: 0,0:00:34.80,0:00:36.54,JP,,0000,0000,0000,,Бұл қыз Тамако
Dialogue: 0,0:00:36.84,0:00:38.04,JP,,0000,0000,0000,,Mochi shop's daughter
Dialogue: 0,0:00:39.57,0:00:41.94,JP,,0000,0000,0000,,Біз саяхатта кездейсоқ кездестік.
Dialogue: 0,0:00:42.45,0:00:45.54,JP,,0000,0000,0000,,Мен осында біраз тұрамын.
Dialogue: 0,0:00:48.80,0:00:49.81,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:00:50.44,0:00:51.23,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:00:58.20,0:00:59.52,JP,,0000,0000,0000,,Менің таңдауым жоқ.
Dialogue: 0,0:01:00.18,0:01:01.79,JP,,0000,0000,0000,,Бір ғана.
Dialogue: 0,0:01:00.42,0:01:02.05,JP,,0000,0000,0000,,Ал мына қыз
Dialogue: 0,0:01:02.68,0:01:05.31,JP,,0000,0000,0000,,Falling in love with me
Dialogue: 0,0:02:47.04,0:02:47.64,JP,,0000,0000,0000,,Жарайды
Dialogue: 0,0:02:48.17,0:02:50.37,JP,,0000,0000,0000,,Менің ойымша, таңғы ас әзірлеу уақыты келді.
Dialogue: 0,0:02:51.10,0:02:51.80,JP,,0000,0000,0000,,Тамако
Dialogue: 0,0:02:52.20,0:02:52.75,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:02:52.98,0:02:54.88,JP,,0000,0000,0000,,Оң жақтағыны алыңыз.
Dialogue: 0,0:02:58.75,0:03:00.20,JP,,0000,0000,0000,,Grandpa
Dialogue: 0,0:03:14.38,0:03:15.19,JP,,0000,0000,0000,,Дәмді
Dialogue: 0,0:03:16.03,0:03:17.01,JP,,0000,0000,0000,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:03:18.31,0:03:20.59,JP,,0000,0000,0000,,Анко мочи сорпасы жүрек пішінді нұсқасы
Dialogue: 0,0:03:21.40,0:03:22.77,JP,,0000,0000,0000,,Дәмді көрінеді.
Dialogue: 0,0:03:23.96,0:03:25.15,JP,,0000,0000,0000,,Оны әкеңе бер
Dialogue: 0,0:03:25.57,0:03:26.59,JP,,0000,0000,0000,,Барлығы дүрбелеңде.
Dialogue: 0,0:03:26.60,0:03:28.16,JP,,0000,0000,0000,,Анко Қайырлы таң
Dialogue: 0,0:03:28.42,0:03:29.58,JP,,0000,0000,0000,,Киіміңді тез ауыстыр.
Dialogue: 0,0:03:29.58,0:03:31.17,JP,,0000,0000,0000,,Барлығы дүрбелеңде.
Dialogue: 0,0:03:34.31,0:03:38.00,JP,,0000,0000,0000,,Әпке, формаңызды котацуға салмаңыз.
Dialogue: 0,0:03:38.30,0:03:39.67,JP,,0000,0000,0000,,Мен қызыл бұршақ пастасын да қостым.
Dialogue: 0,0:03:39.85,0:03:41.57,JP,,0000,0000,0000,,Піскен жеміс
Dialogue: 0,0:03:46.43,0:03:48.05,JP,,0000,0000,0000,,Енді бұл құс жоқ
Dialogue: 0,0:03:48.62,0:03:49.78,JP,,0000,0000,0000,,Сіз қанша уақыт тұрасыз?
Dialogue: 0,0:03:49.93,0:03:51.97,JP,,0000,0000,0000,,Көктемге дейін тұрайын ба?
Dialogue: 0,0:03:52.14,0:03:52.97,JP,,0000,0000,0000,,Көктем
Dialogue: 0,0:03:53.38,0:03:54.81,JP,,0000,0000,0000,,Неліктен көктемді күту керек?
Dialogue: 0,0:03:54.99,0:03:55.99,JP,,0000,0000,0000,,Өйткені суық
Dialogue: 0,0:03:58.15,0:03:59.85,JP,,0000,0000,0000,,Таңертең менде бір тостаған күріш торт болды.
Dialogue: 0,0:03:59.93,0:04:02.59,JP,,0000,0000,0000,,Ал гүлдер көктемде гүлдейді.
Dialogue: 0,0:04:02.59,0:04:04.62,JP,,0000,0000,0000,,Қыздың жүрегі көтеріледі
Dialogue: 0,0:04:05.00,0:04:07.00,JP,,0000,0000,0000,,Көктем келгенде
Dialogue: 0,0:04:07.39,0:04:10.56,JP,,0000,0000,0000,,Сонда ханзадаға ханшайым табу оңайырақ болады.
Dialogue: 0,0:04:11.54,0:04:12.07,JP,,0000,0000,0000,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:04:12.15,0:04:12.88,JP,,0000,0000,0000,,Ханзада
Dialogue: 0,0:04:13.05,0:04:14.59,JP,,0000,0000,0000,,Ол менің руымның ханзадасы.
Dialogue: 0,0:04:14.84,0:04:17.92,JP,,0000,0000,0000,,Мен сол патшайымды табу үшін жолға шықтым.
Dialogue: 0,0:04:22.36,0:04:24.83,JP,,0000,0000,0000,,Ханзаданың әйелі қайда?
Dialogue: 0,0:04:25.50,0:04:27.67,JP,,0000,0000,0000,,Мен сені үй жануарлары дүкеніне апарайын ба?
Dialogue: 0,0:04:28.21,0:04:29.02,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:04:29.42,0:04:30.56,JP,,0000,0000,0000,,Қыздың қазынасы?
Dialogue: 0,0:04:31.41,0:04:33.12,JP,,0000,0000,0000,,Бұл Делла үшін дұрыс болуы мүмкін.
Dialogue: 0,0:04:34.61,0:04:36.10,JP,,0000,0000,0000,,Әке, мынаны қараңыз.
Dialogue: 0,0:04:36.81,0:04:37.69,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:04:38.19,0:04:39.86,JP,,0000,0000,0000,,Бұл Валентиннің Мочиі
Dialogue: 0,0:04:40.37,0:04:43.27,JP,,0000,0000,0000,,Күте тұрыңыз, сіз жақсы емессіз.
Dialogue: 0,0:04:43.41,0:04:45.76,JP,,0000,0000,0000,,Осындай қалқымалы күріш торттарын сатуға болады ма?
Dialogue: 0,0:04:45.98,0:04:49.43,JP,,0000,0000,0000,,Мен көп адамдар мочи жегенін қалаймын.
Dialogue: 0,0:04:49.83,0:04:51.41,JP,,0000,0000,0000,,Мочи жай ғана мочи.
Dialogue: 0,0:04:52.93,0:04:55.93,JP,,0000,0000,0000,,Осылай жүре берсек, дүниеден қалып қоямыз.
Dialogue: 0,0:04:57.48,0:04:58.64,JP,,0000,0000,0000,,Валентин
Dialogue: 0,0:04:58.71,0:05:02.72,JP,,0000,0000,0000,,Түскі ас кезінде шоколад сатып алуға келетін әйелдерге толы.
Dialogue: 0,0:05:03.06,0:05:04.03,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:05:03.12,0:05:06.05,JP,,0000,0000,0000,,Махаббат гүлдері әр адамның шоколадымен гүлдесін
Dialogue: 0,0:05:05.02,0:05:06.18,JP,,0000,0000,0000,,Көремін, көремін.
Dialogue: 0,0:05:07.82,0:05:09.00,JP,,0000,0000,0000,,Жасыл
Dialogue: 0,0:05:10.09,0:05:10.74,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:05:12.40,0:05:13.11,JP,,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:05:13.27,0:05:14.23,JP,,0000,0000,0000,,Шайқалған
Dialogue: 0,0:05:14.35,0:05:17.08,JP,,0000,0000,0000,,Иә, енді емес, шындап.
Dialogue: 0,0:05:17.25,0:05:19.96,JP,,0000,0000,0000,,Иә, Валентин күні қарсаңында.
Dialogue: 0,0:05:20.58,0:05:23.47,JP,,0000,0000,0000,,Эй, барайық, швед үстелі торт ішейік.
Dialogue: 0,0:05:25.11,0:05:26.45,JP,,0000,0000,0000,,Оны кімге бересің?
Dialogue: 0,0:05:26.78,0:05:27.77,JP,,0000,0000,0000,,Маған айтпа
Dialogue: 0,0:05:28.25,0:05:30.10,JP,,0000,0000,0000,,Қолмен орындаңыз
Dialogue: 0,0:05:35.14,0:05:36.18,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:05:36.79,0:05:38.32,JP,,0000,0000,0000,,Мидори-чан Қайырлы таң
Dialogue: 0,0:05:39.54,0:05:40.60,JP,,0000,0000,0000,,Ненің суретін салып жатырсың?
Dialogue: 0,0:05:40.87,0:05:41.62,JP,,0000,0000,0000,,Күріш торты
Dialogue: 0,0:05:42.06,0:05:44.96,JP,,0000,0000,0000,,Ах, жаңа мочи туралы идеяны ойлап тап.
Dialogue: 0,0:05:45.33,0:05:45.98,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:05:47.51,0:05:48.73,JP,,0000,0000,0000,,Шоколад жақсы.
Dialogue: 0,0:05:49.14,0:05:51.85,JP,,0000,0000,0000,,Шоколадтың өзі бұл кітапты сүйкімді етеді.
Dialogue: 0,0:05:52.87,0:05:54.66,JP,,0000,0000,0000,,Бірақ күріш торттарына келгенде
Dialogue: 0,0:05:55.09,0:05:56.68,JP,,0000,0000,0000,,Бұл өте өкінішті.
Dialogue: 0,0:05:56.94,0:05:58.17,JP,,0000,0000,0000,,Дүниені түсіну қиын.
Dialogue: 0,0:05:58.62,0:06:00.02,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:06:00.73,0:06:02.35,JP,,0000,0000,0000,,Қайырлы таң Канна-чан
Dialogue: 0,0:06:02.77,0:06:03.65,JP,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:03.75,0:06:05.48,JP,,0000,0000,0000,,Мүмкін ұйқының болмауы
Dialogue: 0,0:06:06.25,0:06:08.80,JP,,0000,0000,0000,,Кішкене дизайн жасаңыз.
Dialogue: 0,0:06:11.75,0:06:12.83,JP,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:06:12.91,0:06:13.70,JP,,0000,0000,0000,,Әрине
Dialogue: 0,0:06:15.98,0:06:17.59,JP,,0000,0000,0000,,Канначанчи қайта құрылады
Dialogue: 0,0:06:18.30,0:06:21.87,JP,,0000,0000,0000,,Жоқ, мен Валентин күніне шоколад үйін жасауды ойладым.
Dialogue: 0,0:06:22.05,0:06:24.39,JP,,0000,0000,0000,,Канна-чан ең жақсысы сияқты
Dialogue: 0,0:06:24.39,0:06:25.40,JP,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:06:25.79,0:06:27.76,JP,,0000,0000,0000,,Екеуің де шамалы.
Dialogue: 0,0:06:28.17,0:06:31.95,JP,,0000,0000,0000,,Мақсат бастапқы Валентин күнінен алыстап кетті.
Dialogue: 0,0:06:32.06,0:06:33.06,JP,,0000,0000,0000,,Жоқ?
Dialogue: 0,0:06:33.56,0:06:37.31,JP,,0000,0000,0000,,Мидори-чан әрқашан қыздардан шоколад алатын.
Dialogue: 0,0:06:37.97,0:06:40.54,JP,,0000,0000,0000,,Тіпті бала оны Мидори-чанға беруге келеді.
Dialogue: 0,0:06:40.65,0:06:42.49,JP,,0000,0000,0000,,Айналада әбігершілік көп.
Dialogue: 0,0:06:42.74,0:06:47.32,JP,,0000,0000,0000,,Айтпақшы, балалар кеше Мидо-чаннан шоколад аламыз деп сөйлесіп жатыр еді.
Dialogue: 0,0:06:48.53,0:06:50.28,JP,,0000,0000,0000,,Бұл керемет, Мидори-чан
Dialogue: 0,0:06:50.65,0:06:53.28,JP,,0000,0000,0000,,Ұлдар мен қыздар арасында танымал
Dialogue: 0,0:06:53.56,0:06:55.32,JP,,0000,0000,0000,,Мен бойдақпын.
Dialogue: 0,0:06:55.59,0:06:57.27,JP,,0000,0000,0000,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:06:57.52,0:06:59.66,JP,,0000,0000,0000,,Уау, қызыл болып кетті. Ол қызыл түсті.
Dialogue: 0,0:06:59.83,0:07:01.88,JP,,0000,0000,0000,,Мидо-чан сүйкімді
Dialogue: 0,0:07:01.92,0:07:03.22,JP,,0000,0000,0000,,Мен енді білмеймін
Dialogue: 0,0:07:03.26,0:07:04.87,JP,,0000,0000,0000,,Мен жыладым
Dialogue: 0,0:07:06.19,0:07:07.07,JP,,0000,0000,0000,,Тамакоха
Dialogue: 0,0:07:08.21,0:07:09.17,JP,,0000,0000,0000,,Біреуге беру
Dialogue: 0,0:07:16.37,0:07:18.40,JP,,0000,0000,0000,,Иә, сабақты бастайық.
Dialogue: 0,0:07:21.39,0:07:22.38,JP,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:07:22.72,0:07:23.63,JP,,0000,0000,0000,,Джейн Хонжа
Dialogue: 0,0:07:29.00,0:07:30.83,JP,,0000,0000,0000,,Қызым, қайтып келдің бе?
Dialogue: 0,0:07:31.48,0:07:32.71,JP,,0000,0000,0000,,Иә Тама-чан
Dialogue: 0,0:07:33.47,0:07:34.20,JP,,0000,0000,0000,,Мен шын мәнінде айта алмаймын.
Dialogue: 0,0:07:34.64,0:07:35.51,JP,,0000,0000,0000,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:07:36.34,0:07:38.64,JP,,0000,0000,0000,,Әже, бес жаңа қуырылған крокет.
Dialogue: 0,0:07:38.85,0:07:39.56,JP,,0000,0000,0000,,Иә.
Dialogue: 0,0:07:40.12,0:07:41.48,JP,,0000,0000,0000,,Маған бүгін сары құйрық ұнайды.
Dialogue: 0,0:07:41.69,0:07:42.99,JP,,0000,0000,0000,,Олай болса сары құйрықты қолданайық.
Dialogue: 0,0:07:43.49,0:07:44.62,JP,,0000,0000,0000,,Екі кесек мақта
Dialogue: 0,0:07:44.72,0:07:45.40,JP,,0000,0000,0000,,Иә.
Dialogue: 0,0:07:48.23,0:07:49.44,JP,,0000,0000,0000,,Майдо бар
Dialogue: 0,0:07:52.77,0:07:53.47,JP,,0000,0000,0000,,Бұл
Dialogue: 0,0:07:53.76,0:07:57.49,JP,,0000,0000,0000,,Менің Valentine сауда көшесінде «V» белгісі жоқ.
Dialogue: 0,0:08:00.37,0:08:02.14,JP,,0000,0000,0000,,Ғашықтар күніне бір нәрсе туралы ойлау
Dialogue: 0,0:08:02.35,0:08:03.05,JP,,0000,0000,0000,,Барре...
Dialogue: 0,0:08:04.95,0:08:07.87,JP,,0000,0000,0000,,Жоқ, қолымнан келсе Усаюдан Саюриге барар едім.
Dialogue: 0,0:08:08.22,0:08:10.73,JP,,0000,0000,0000,,Бұл жай ғана міндеттеме болса да, шоколадтар бере алсаңыз.
Dialogue: 0,0:08:11.09,0:08:11.74,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:08:11.88,0:08:13.24,JP,,0000,0000,0000,,Жоқ, ештеңе.
Dialogue: 0,0:08:13.51,0:08:14.55,JP,,0000,0000,0000,,Махаббат па әлде жастық па?
Dialogue: 0,0:08:14.70,0:08:16.66,JP,,0000,0000,0000,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:08:18.32,0:08:19.85,JP,,0000,0000,0000,,Біз оны жандандыруымыз керек.
Dialogue: 0,0:08:36.78,0:08:37.49,JP,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:08:46.78,0:08:48.24,JP,,0000,0000,0000,,Мен оны жандандырғым келеді.
Dialogue: 0,0:08:48.98,0:08:51.34,JP,,0000,0000,0000,,Осылай қалса жаман. өтінемін
Dialogue: 0,0:08:51.99,0:08:53.46,JP,,0000,0000,0000,,Сіз нені қалайсыз?
Dialogue: 0,0:08:54.44,0:08:55.62,JP,,0000,0000,0000,,Біздің
Dialogue: 0,0:08:56.89,0:08:57.74,JP,,0000,0000,0000,,Біздің
Dialogue: 0,0:09:00.08,0:09:02.72,JP,,0000,0000,0000,,Эй, мұнымен тоқтап қалма.
Dialogue: 0,0:09:03.25,0:09:04.73,JP,,0000,0000,0000,,Тоқтаудың не кінәсі бар?
Dialogue: 0,0:09:13.01,0:09:14.10,JP,,0000,0000,0000,,Сіз оны ести алмайсыз.
Dialogue: 0,0:09:14.23,0:09:15.83,JP,,0000,0000,0000,,Эй ақымақ
Dialogue: 0,0:09:15.83,0:09:18.12,JP,,0000,0000,0000,,Идиот Идиот
Dialogue: 0,0:09:18.12,0:09:21.02,JP,,0000,0000,0000,,Сонымен не істейміз?
Dialogue: 0,0:09:22.23,0:09:24.55,JP,,0000,0000,0000,,Мен сауда аймағын жандандырғым келеді.
Dialogue: 0,0:09:25.07,0:09:26.58,JP,,0000,0000,0000,,Ах, сауда ауданы.
Dialogue: 0,0:09:27.47,0:09:30.49,JP,,0000,0000,0000,,Бүгін Усаюда кездесу бар, мен барайын деп ойладым.
Dialogue: 0,0:09:30.99,0:09:33.08,JP,,0000,0000,0000,,Мочизо менімен бірге жүріңізші.
Dialogue: 0,0:09:34.33,0:09:36.22,JP,,0000,0000,0000,,Оған көмектесу мүмкін емес, өтінемін.
Dialogue: 0,0:09:36.74,0:09:38.63,JP,,0000,0000,0000,,Рахмет, өтінемін.
Dialogue: 0,0:09:39.24,0:09:43.30,JP,,0000,0000,0000,,Көңіліңізді көбірек көтеріңіз, өтінемін.
Dialogue: 0,0:09:43.61,0:09:44.36,JP,,0000,0000,0000,,Сен оны бірнеше күн бұрын ертіп келгенде маған айтсаң ғой.
Dialogue: 0,0:09:47.77,0:09:50.19,JP,,0000,0000,0000,,Қалай болды? Дұрыс жұмыс істеген
Dialogue: 0,0:09:50.51,0:09:52.82,JP,,0000,0000,0000,,Ескілері өте жақсы қабылданады.
Dialogue: 0,0:09:52.90,0:09:53.88,JP,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:09:53.88,0:09:55.38,JP,,0000,0000,0000,,Маған екеуі де ұнайды.
Dialogue: 0,0:09:52.65,0:09:53.99,JP,,0000,0000,0000,,Жоқ, жоқ, рахмет.
Dialogue: 0,0:09:53.99,0:09:54.76,JP,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:09:56.18,0:09:57.27,JP,,0000,0000,0000,,Чису
Dialogue: 0,0:09:58.00,0:10:00.22,JP,,0000,0000,0000,,Тамако, сен мұнда неге келдің?
Dialogue: 0,0:10:00.86,0:10:01.87,JP,,0000,0000,0000,,Чису
Dialogue: 0,0:10:03.03,0:10:05.42,JP,,0000,0000,0000,,Бүгін менің кіші қызым мен Тама-чан да қатыса ма?
Dialogue: 0,0:10:06.99,0:10:08.33,JP,,0000,0000,0000,,Бұл қандай киім?
Dialogue: 0,0:10:08.69,0:10:12.44,JP,,0000,0000,0000,,Мамедай-чан, кәсіпкерлер үшін жыл мезгілдерін сезіну маңызды.
Dialogue: 0,0:10:12.60,0:10:14.88,JP,,0000,0000,0000,,Жыл мезгілі қандай сезім, Тончинкан.
Dialogue: 0,0:10:14.88,0:10:15.87,JP,,0000,0000,0000,,Бұл басталды
Dialogue: 0,0:10:17.90,0:10:19.26,JP,,0000,0000,0000,,Әке, тоқтатыңыз!
Dialogue: 0,0:10:20.03,0:10:21.28,JP,,0000,0000,0000,,Әке, кешіріңіз.
Dialogue: 0,0:10:21.33,0:10:23.81,JP,,0000,0000,0000,,Мені әке деуге еш себеп жоқ.
Dialogue: 0,0:10:23.86,0:10:25.12,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:10:25.29,0:10:26.15,JP,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:10:27.50,0:10:28.33,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:10:30.24,0:10:35.01,JP,,0000,0000,0000,,Бүгінгі Усагияма сауда көшесі кездесуін бастайық.
Dialogue: 0,0:10:36.03,0:10:37.70,JP,,0000,0000,0000,,Қоян Пиоко Пиоко
Dialogue: 0,0:10:37.75,0:10:39.10,JP,,0000,0000,0000,,Қоян тауы
Dialogue: 0,0:10:39.43,0:10:40.85,JP,,0000,0000,0000,,Мен де бүгін жақсымын.
Dialogue: 0,0:10:40.85,0:10:42.33,JP,,0000,0000,0000,,Сауда көшесі
Dialogue: 0,0:10:45.24,0:10:47.48,JP,,0000,0000,0000,,Ал, бүгінгі тапсырма
Dialogue: 0,0:10:47.83,0:10:50.59,JP,,0000,0000,0000,,Тамаядағы Тама-чанның ұсынысы бар сияқты.
Dialogue: 0,0:10:51.17,0:10:51.83,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:10:55.29,0:10:57.00,JP,,0000,0000,0000,,Сәлем Тама-чан
Dialogue: 0,0:10:59.91,0:11:03.13,JP,,0000,0000,0000,,Әулие Валентин күні жақындап қалды.
Dialogue: 0,0:11:03.21,0:11:07.67,JP,,0000,0000,0000,,Бұл Усагияма сауда көшесі де өте қызықты болды.
Dialogue: 0,0:11:08.39,0:11:09.53,JP,,0000,0000,0000,,Қандай мочизо
Dialogue: 0,0:11:17.13,0:11:19.83,JP,,0000,0000,0000,,Әулие Валентин күні жақындап қалды...
Dialogue: 0,0:11:18.68,0:11:19.91,JP,,0000,0000,0000,,Бұл скит пе?
Dialogue: 0,0:11:20.02,0:11:21.42,JP,,0000,0000,0000,,Тынышталыңдар, балалар.
Dialogue: 0,0:11:21.78,0:11:24.80,JP,,0000,0000,0000,,Тамачаджи қобалжыды, Адажи қобалжыды
Dialogue: 0,0:11:24.80,0:11:26.85,JP,,0000,0000,0000,,Жоқ, жоқ, жоқ, адам, адам.
Dialogue: 0,0:11:27.42,0:11:30.16,JP,,0000,0000,0000,,Осы Усагияма сауда көшесі де.
Dialogue: 0,0:11:30.16,0:11:33.33,JP,,0000,0000,0000,,Мен Валентин күніне бірдеңе жасау керек деп ойладым.
Dialogue: 0,0:11:33.58,0:11:34.35,JP,,0000,0000,0000,,Керемет
Dialogue: 0,0:11:34.46,0:11:35.35,JP,,0000,0000,0000,,(Балалардың шуы)
Dialogue: 0,0:11:35.71,0:11:39.77,JP,,0000,0000,0000,,Қалай болғанда да, ол қызғылт сияқты.
Dialogue: 0,0:11:41.39,0:11:44.66,JP,,0000,0000,0000,,Мен жүрек пішінді гүл шоғын немесе бір нәрсе жасап көремін деп ойлаймын.
Dialogue: 0,0:11:44.94,0:11:45.99,JP,,0000,0000,0000,,Учиха
Dialogue: 0,0:11:46.09,0:11:48.05,JP,,0000,0000,0000,,Шоколадты сатып алғандарға қызмет көрсету.
Dialogue: 0,0:11:48.23,0:11:51.53,JP,,0000,0000,0000,,Егер сіз Авекке осы кезеңде келсеңіз, біз жеңілдік жасаймыз ба?
Dialogue: 0,0:11:51.65,0:11:54.11,JP,,0000,0000,0000,,Ата, суды қызғылт түске айналдырайық.
Dialogue: 0,0:11:54.25,0:11:57.70,JP,,0000,0000,0000,,Ал, мен сиыр етін жүрек пішінінде орналастырып көрейін деп ойлаймын.
Dialogue: 0,0:11:58.36,0:11:59.98,JP,,0000,0000,0000,,Бұл жақсы сезім.
Dialogue: 0,0:12:02.64,0:12:04.92,JP,,0000,0000,0000,,Бұл өте қызықты, Мочизо.
Dialogue: 0,0:12:05.01,0:12:08.40,JP,,0000,0000,0000,,Жарайды, жарайды, мен де оны қызықты ету үшін бар күшімді саламын.
Dialogue: 0,0:12:08.98,0:12:11.01,JP,,0000,0000,0000,,Мен сауда көшесіне жарнама жасаймын.
Dialogue: 0,0:12:11.43,0:12:13.65,JP,,0000,0000,0000,,Өйткені мен кино зерттеу тобының мүшесімін.
Dialogue: 0,0:12:15.44,0:12:16.68,JP,,0000,0000,0000,,Иә, менің кенжем
Dialogue: 0,0:12:16.68,0:12:18.27,JP,,0000,0000,0000,,О~. Құдай-ай!
Dialogue: 0,0:12:18.35,0:12:20.46,JP,,0000,0000,0000,,Валентин күнінің мочи дүкендеріне еш қатысы жоқ.
Dialogue: 0,0:12:21.00,0:12:24.13,JP,,0000,0000,0000,,Әке, бәрінің көңілдері көтерілді.
Dialogue: 0,0:12:24.53,0:12:25.84,JP,,0000,0000,0000,,Дүниелік
Dialogue: 0,0:12:26.02,0:12:27.40,JP,,0000,0000,0000,,Барлығы – бәрі
Dialogue: 0,0:12:27.40,0:12:28.75,JP,,0000,0000,0000,,Дүние – дүние
Dialogue: 0,0:12:29.51,0:12:30.78,JP,,0000,0000,0000,,Бұл бізден өзгеше.
Dialogue: 0,0:12:33.21,0:12:33.88,JP,,0000,0000,0000,,Таз
Dialogue: 0,0:12:35.02,0:12:36.63,JP,,0000,0000,0000,,Әлі таз емес
Dialogue: 0,0:12:45.69,0:12:51.58,JP,,0000,0000,0000,,А ғана емес, сонымен қатар В uh
Dialogue: 0,0:12:52.00,0:12:52.73,JP,,0000,0000,0000,,Орындалды ма?
Dialogue: 0,0:12:52.94,0:12:55.20,JP,,0000,0000,0000,,Кешіріңіз, сіз өзіңіздің клубтық іс-шараларыңызға бара аласыз.
Dialogue: 0,0:12:55.20,0:12:56.15,JP,,0000,0000,0000,,Бөліну ұштары
Dialogue: 0,0:12:56.20,0:12:56.95,JP,,0000,0000,0000,,Өтірік!
Dialogue: 0,0:12:57.01,0:12:59.12,JP,,0000,0000,0000,,А ғана емес, В
Dialogue: 0,0:12:59.12,0:13:03.72,JP,,0000,0000,0000,,Сондықтан олар сөзді ғана емес, жүректі де бағалайды.
Dialogue: 0,0:13:04.41,0:13:06.27,JP,,0000,0000,0000,,Мидори-чан, шашың әдемі екен.
Dialogue: 0,0:13:06.88,0:13:07.87,JP,,0000,0000,0000,,Бұл рас
Dialogue: 0,0:13:07.94,0:13:08.87,JP,,0000,0000,0000,,<Мен оны «Спайс» деп атаймын➡
Dialogue: 0,0:13:09.47,0:13:10.42,JP,,0000,0000,0000,,Не
Dialogue: 0,0:13:10.96,0:13:13.34,JP,,0000,0000,0000,,Мен Мидо-чанның жарылған ұштарын таптым.
Dialogue: 0,0:13:13.34,0:13:14.41,JP,,0000,0000,0000,,Кішкене ғана
Dialogue: 0,0:13:14.56,0:13:16.83,JP,,0000,0000,0000,,Тамако, тез үй тапсырмасын орында.
Dialogue: 0,0:13:16.83,0:13:18.56,JP,,0000,0000,0000,,Жақсы, Мидори-чан
Dialogue: 0,0:13:18.93,0:13:21.10,JP,,0000,0000,0000,,Әй
Dialogue: 0,0:13:21.71,0:13:23.57,JP,,0000,0000,0000,,Біз кездесе бастағанымыз өкінішті.
Dialogue: 0,0:13:23.91,0:13:26.10,JP,,0000,0000,0000,,Тамако, бұл қандай көрініс?
Dialogue: 0,0:13:26.16,0:13:27.23,JP,,0000,0000,0000,,Өте сүйкімді
Dialogue: 0,0:13:27.48,0:13:28.67,JP,,0000,0000,0000,,Иә Канна-чан
Dialogue: 0,0:13:29.17,0:13:29.98,JP,,0000,0000,0000,,Чикара удон
Dialogue: 0,0:13:30.19,0:13:30.83,JP,,0000,0000,0000,,Иә.
Dialogue: 0,0:13:31.17,0:13:32.53,JP,,0000,0000,0000,,Әулие Валентин күні дегеніміз не?
Dialogue: 0,0:13:33.11,0:13:35.90,JP,,0000,0000,0000,,Тамако - Тамако, бірақ бәрі - бәрі.
Dialogue: 0,0:13:36.05,0:13:36.76,JP,,0000,0000,0000,,Күтіңіз
Dialogue: 0,0:13:37.89,0:13:39.12,JP,,0000,0000,0000,,Е, бұл не?
Dialogue: 0,0:13:39.69,0:13:41.26,JP,,0000,0000,0000,,Валентин Чикара Удон
Dialogue: 0,0:13:41.75,0:13:42.46,JP,,0000,0000,0000,,Барлық мектеп оқушылары, кітаптан жалыққан
Dialogue: 0,0:13:44.66,0:13:45.70,JP,,0000,0000,0000,,Бұл іс жарыққа шыққанына төрт айдан асты.
Dialogue: 0,0:13:47.17,0:13:48.04,JP,,0000,0000,0000,,Юкине, сонда ісіңді бітірген соң дүкенге қара.
Dialogue: 0,0:13:48.04,0:13:49.26,JP,,0000,0000,0000,,Қалай
Dialogue: 0,0:13:49.76,0:13:51.75,JP,,0000,0000,0000,,Махаббат гүлдейді
Dialogue: 0,0:13:52.43,0:13:55.14,JP,,0000,0000,0000,,Дұрыс, бұл ғашық болатын сауда ауданы.
Dialogue: 0,0:13:55.50,0:13:59.91,JP,,0000,0000,0000,,Барлығымыз Валентин күніне Қоян тауына барайық.
Dialogue: 0,0:14:00.29,0:14:01.55,JP,,0000,0000,0000,,Усаусапёнпён
Dialogue: 0,0:14:02.89,0:14:04.80,JP,,0000,0000,0000,,Токива кесілген
Dialogue: 0,0:14:04.88,0:14:06.23,JP,,0000,0000,0000,,Жарайды, тоқтат
Dialogue: 0,0:14:06.93,0:14:11.24,JP,,0000,0000,0000,,Екi мырза, тағы бiршама бөлiп көрейік.
Dialogue: 0,0:14:11.58,0:14:13.42,JP,,0000,0000,0000,,Егер заттар қазіргідей қалса, ештеңе болмайды.
Dialogue: 0,0:14:13.65,0:14:15.34,JP,,0000,0000,0000,,Ол керексіз бала.
Dialogue: 0,0:14:15.43,0:14:18.30,JP,,0000,0000,0000,,қандай болса да дөрекі.
Dialogue: 0,0:14:18.30,0:14:20.15,JP,,0000,0000,0000,,Мен оны балғамен ұрайын ба?
Dialogue: 0,0:14:20.24,0:14:22.40,JP,,0000,0000,0000,,Оны күріш торттарына ингредиент ретінде пайдалану керек пе?
Dialogue: 0,0:14:23.01,0:14:24.95,JP,,0000,0000,0000,,Қарап тұрғанның өзі қызық.
Dialogue: 0,0:14:25.50,0:14:27.38,JP,,0000,0000,0000,,Келесі жолы дұрыс орындаңыз.
Dialogue: 0,0:14:27.93,0:14:30.34,JP,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:30.53,0:14:32.82,JP,,0000,0000,0000,,Мен сізді сауда көшесіне жарнама жасап жатқаныңызды естідім.
Dialogue: 0,0:14:32.98,0:14:33.92,JP,,0000,0000,0000,,CM?
Dialogue: 0,0:14:33.92,0:14:35.03,JP,,0000,0000,0000,,Жарнама
Dialogue: 0,0:14:36.87,0:14:38.06,JP,,0000,0000,0000,,Мидори
Dialogue: 0,0:14:39.10,0:14:40.22,JP,,0000,0000,0000,,Grandpa
Dialogue: 0,0:14:40.41,0:14:41.73,JP,,0000,0000,0000,,Кішкене ғана
Dialogue: 0,0:14:44.14,0:14:45.58,JP,,0000,0000,0000,,Валентин туралы не айтасыз?
Dialogue: 0,0:14:46.35,0:14:49.83,JP,,0000,0000,0000,,Қызық, Мидори Токивадо жарнамасына түсе ме?
Dialogue: 0,0:14:49.91,0:14:51.07,JP,,0000,0000,0000,,Әрине.
Dialogue: 0,0:14:51.07,0:14:52.15,JP,,0000,0000,0000,,Иә!
Dialogue: 0,0:14:52.34,0:14:57.45,JP,,0000,0000,0000,,Мен кішкентай кезімдегідей «Саған ойыншықтар керек пе?» деуіңді қалаймын.
Dialogue: 0,0:14:57.66,0:15:00.14,JP,,0000,0000,0000,,Тоқта, ата.
Dialogue: 0,0:15:00.14,0:15:02.10,JP,,0000,0000,0000,,Эй Мидори-чан сүйкімді
Dialogue: 0,0:15:03.55,0:15:05.71,JP,,0000,0000,0000,,GO GO Валентин
Dialogue: 0,0:15:05.71,0:15:11.33,JP,,0000,0000,0000,,бәрі біреуді жақсы көреді
Dialogue: 0,0:15:11.33,0:15:12.29,JP,,0000,0000,0000,,Бұл… (Бакуго) Э?
Dialogue: 0,0:15:12.30,0:15:13.42,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:15:14.68,0:15:17.19,JP,,0000,0000,0000,,Барлығы біреуді жақсы көреді
Dialogue: 0,0:15:32.41,0:15:34.06,JP,,0000,0000,0000,,Ал, кеттік.
Dialogue: 0,0:15:34.06,0:15:37.33,JP,,0000,0000,0000,,Ей, кел, ханзада әйелі
Dialogue: 0,0:15:38.83,0:15:40.42,JP,,0000,0000,0000,,Не істеп жатырсың, құс?
Dialogue: 0,0:15:40.54,0:15:41.49,JP,,0000,0000,0000,,CM and
Dialogue: 0,0:15:41.56,0:15:43.48,JP,,0000,0000,0000,,Бұл қауесет сөйлейтін кітап...
Dialogue: 0,0:15:49.02,0:15:51.04,JP,,0000,0000,0000,,Қызым, сен сондай батылсың.
Dialogue: 0,0:15:51.04,0:15:53.05,JP,,0000,0000,0000,,Менің құстарға аллергиям бар.
Dialogue: 0,0:15:53.52,0:15:55.96,JP,,0000,0000,0000,,Енді өзіңізді тартып, әрекетті қайталаңыз.
Dialogue: 0,0:15:57.20,0:15:59.64,JP,,0000,0000,0000,,Бұл қалашықтағы қыздар бақытты.
Dialogue: 0,0:16:00.17,0:16:01.76,JP,,0000,0000,0000,,Тамако сәл солға қарай
Dialogue: 0,0:16:02.51,0:16:03.47,JP,,0000,0000,0000,,Like this?
Dialogue: 0,0:16:03.57,0:16:04.49,JP,,0000,0000,0000,,жарайды
Dialogue: 0,0:16:05.04,0:16:06.11,JP,,0000,0000,0000,,With a smile
Dialogue: 0,0:16:06.26,0:16:07.10,JP,,0000,0000,0000,,Like this?
Dialogue: 0,0:16:07.13,0:16:07.84,JP,,0000,0000,0000,,жарайды
Dialogue: 0,0:16:09.62,0:16:10.52,JP,,0000,0000,0000,,Анко
Dialogue: 0,0:16:11.56,0:16:12.61,JP,,0000,0000,0000,,A little change
Dialogue: 0,0:16:12.90,0:16:13.66,JP,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:16:13.77,0:16:14.53,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:16:15.79,0:16:16.53,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:16:19.84,0:16:22.32,JP,,0000,0000,0000,,Қызым, кофе ішкің келе ме?
Dialogue: 0,0:16:24.89,0:16:26.01,JP,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:16:26.09,0:16:27.05,JP,,0000,0000,0000,,Let's ask
Dialogue: 0,0:16:28.70,0:16:29.64,JP,,0000,0000,0000,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:16:32.04,0:16:33.17,JP,,0000,0000,0000,,Мен білемін
Dialogue: 0,0:16:33.38,0:16:34.02,JP,,0000,0000,0000,,Не
Dialogue: 0,0:16:35.15,0:16:37.14,JP,,0000,0000,0000,,Кеудеде ауырсыну болуы керек.
Dialogue: 0,0:16:38.20,0:16:39.06,JP,,0000,0000,0000,,Мен
Dialogue: 0,0:16:41.92,0:16:43.24,JP,,0000,0000,0000,,Маған ғашық болма
Dialogue: 0,0:16:46.00,0:16:47.55,JP,,0000,0000,0000,,Құсқа ғашық болу мүмкін емес.
Dialogue: 0,0:16:48.04,0:16:49.30,JP,,0000,0000,0000,,Бірге барайық.
Dialogue: 0,0:16:51.12,0:16:52.78,JP,,0000,0000,0000,,Оның үстіне олай емес.
Dialogue: 0,0:16:55.05,0:16:58.57,JP,,0000,0000,0000,,Ешкім атай алмайтын сезімдер бар.
Dialogue: 0,0:16:59.31,0:17:00.59,JP,,0000,0000,0000,,Probably
Dialogue: 0,0:17:01.37,0:17:03.56,JP,,0000,0000,0000,,Сондықтан адамдар мұңаяды
Dialogue: 0,0:17:52.13,0:17:52.99,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:17:53.54,0:17:55.24,JP,,0000,0000,0000,,Мен тазалап қойғанмын.
Dialogue: 0,0:17:55.84,0:17:57.71,JP,,0000,0000,0000,,О, оны сонда қалдырыңыз.
Dialogue: 0,0:17:58.53,0:17:59.76,JP,,0000,0000,0000,,Мен мұны істеймін
Dialogue: 0,0:18:02.02,0:18:05.40,JP,,0000,0000,0000,,Мүмкін сіз әлі де ашуланатын шығарсыз, әке...
Dialogue: 0,0:18:11.74,0:18:13.84,JP,,0000,0000,0000,,Мен шоколадты ішіне салып көрдім.
Dialogue: 0,0:18:21.50,0:18:26.02,JP,,0000,0000,0000,,Бұл бірге жеген кездегі сезімдеріңізді байланыстыратын сүйкімді жүрек мочи.
Dialogue: 0,0:18:30.60,0:18:32.30,JP,,0000,0000,0000,,Махаббатты сүй
Dialogue: 0,0:18:32.57,0:18:34.11,JP,,0000,0000,0000,,Егер сіз қатты күлетін болсаңыз, тоқтаңыз.
Dialogue: 0,0:18:34.80,0:18:35.57,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:18:39.02,0:18:40.24,JP,,0000,0000,0000,,Жақсы, мен тоқтаймын.
Dialogue: 0,0:18:40.24,0:18:42.31,JP,,0000,0000,0000,,Кешіріңіз, бұл өте жақсы деп ойлаймын.
Dialogue: 0,0:18:42.41,0:18:43.51,JP,,0000,0000,0000,,Мынаны жасап, сатайық.
Dialogue: 0,0:18:43.82,0:18:45.32,JP,,0000,0000,0000,,Рахмет, әке.
Dialogue: 0,0:18:49.11,0:18:50.03,JP,,0000,0000,0000,,Үлкен әпке
Dialogue: 0,0:18:51.17,0:18:52.83,JP,,0000,0000,0000,,Мынаны маған да қайтар.
Dialogue: 0,0:18:53.35,0:18:54.86,JP,,0000,0000,0000,,Бүгін де Анкоға рахмет.
Dialogue: 0,0:18:55.27,0:18:57.92,JP,,0000,0000,0000,,Құс Мидори-чанды бір жерге апарады.
Dialogue: 0,0:18:57.98,0:19:00.46,JP,,0000,0000,0000,,Анко шашын өзі қиып жүрді.
Dialogue: 0,0:19:11.63,0:19:12.65,JP,,0000,0000,0000,,Менің қызым
Dialogue: 0,0:19:13.00,0:19:15.63,JP,,0000,0000,0000,,Мочиге күнбағыс дәнін салған жақсы.
Dialogue: 0,0:19:15.79,0:19:17.19,JP,,0000,0000,0000,,Кейбір жемістер де жақсы болар еді.
Dialogue: 0,0:19:17.29,0:19:19.00,JP,,0000,0000,0000,,Киви банан манго
Dialogue: 0,0:19:19.59,0:19:20.96,JP,,0000,0000,0000,,Аа, бұл Мидори-чан.
Dialogue: 0,0:19:21.03,0:19:23.03,JP,,0000,0000,0000,,Мынау сары шашты қыз ба?
Dialogue: 0,0:19:23.17,0:19:23.88,JP,,0000,0000,0000,,бірақ енді Эсидиси жеңілгендіктен—
Dialogue: 0,0:19:23.98,0:19:24.86,JP,,0000,0000,0000,,Бұл ыңғайсыздық
Dialogue: 0,0:19:27.36,0:19:28.46,JP,,0000,0000,0000,,Йорошику
Dialogue: 0,0:19:29.33,0:19:30.83,JP,,0000,0000,0000,,Тек үш-төрт сағат бұрын—
Dialogue: 0,0:19:31.51,0:19:32.51,JP,,0000,0000,0000,,Ол жабыспайды.
Dialogue: 0,0:19:32.95,0:19:35.01,JP,,0000,0000,0000,,Мен оны шығарғаныма біраз болды.
Dialogue: 0,0:19:35.23,0:19:36.62,JP,,0000,0000,0000,,Қызық, сынған ба?
Dialogue: 0,0:19:37.79,0:19:39.31,JP,,0000,0000,0000,,Кесу оны түзетпейді.
Dialogue: 0,0:19:43.85,0:19:46.61,JP,,0000,0000,0000,,Дұрыс, бұл ғашық болатын сауда ауданы.
Dialogue: 0,0:19:46.90,0:19:48.77,JP,,0000,0000,0000,,Сіз, бұл қандай функция?
Dialogue: 0,0:19:48.85,0:19:50.27,JP,,0000,0000,0000,,Не, не, не болып жатыр?
Dialogue: 0,0:19:50.71,0:19:53.24,JP,,0000,0000,0000,,Эй, не болып жатыр?
Dialogue: 0,0:19:53.34,0:19:55.05,JP,,0000,0000,0000,,Бұл Тори-сан.
Dialogue: 0,0:19:54.17,0:19:56.02,JP,,0000,0000,0000,,Бұл ғашық сауда көшесі
Dialogue: 0,0:19:58.50,0:20:02.99,JP,,0000,0000,0000,,Барлығымыз, Валентин күні Усагияма сауда көшесіне барайық.
Dialogue: 0,0:20:03.26,0:20:04.91,JP,,0000,0000,0000,,Усаусапёнпён
Dialogue: 0,0:20:05.83,0:20:08.49,JP,,0000,0000,0000,,Тама-чан сауда көшелеріне құмар.
Dialogue: 0,0:20:10.34,0:20:11.12,JP,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:20:13.48,0:20:16.16,JP,,0000,0000,0000,,Кімге ұнайтыны маңызды емес.
Dialogue: 0,0:20:20.54,0:20:21.22,JP,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:20:21.47,0:20:23.54,JP,,0000,0000,0000,,Усагияма сауда көшесі
Dialogue: 0,0:20:25.23,0:20:30.11,JP,,0000,0000,0000,,Міне, былай қарасаңыз, біздің сауда аймағы өте жақсы.
Dialogue: 0,0:20:31.47,0:20:32.17,JP,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:20:32.81,0:20:34.04,JP,,0000,0000,0000,,Жарайсың, Тори-чан
Dialogue: 0,0:20:34.11,0:20:35.55,JP,,0000,0000,0000,,Сізге жақсы Мочизо
Dialogue: 0,0:20:44.65,0:20:47.31,JP,,0000,0000,0000,,Делла, сен қазір қайдасың?
Dialogue: 0,0:20:48.89,0:20:50.73,JP,,0000,0000,0000,,Бұл жерде күнде ыстық болса да
Dialogue: 0,0:20:50.97,0:20:53.08,JP,,0000,0000,0000,,Теңіз әлі де керемет
Dialogue: 0,0:20:54.02,0:20:56.17,JP,,0000,0000,0000,,Делла киви мен мангоны жақсы көреді.
Dialogue: 0,0:20:56.68,0:20:58.16,JP,,0000,0000,0000,,Бүгін сіз көп нәрсені ұстадыңыз.
Dialogue: 0,0:21:00.50,0:21:02.10,JP,,0000,0000,0000,,Қайырлы таң Мидори-чан
Dialogue: 0,0:21:02.40,0:21:03.06,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:21:03.54,0:21:04.63,JP,,0000,0000,0000,,Білесің бе, Мидори-чан?
Dialogue: 0,0:21:05.07,0:21:06.32,JP,,0000,0000,0000,,Бұл Валентин күні
Dialogue: 0,0:21:07.35,0:21:10.35,JP,,0000,0000,0000,,Биыл тағы әкеме беремін деп шештім.
Dialogue: 0,0:21:12.32,0:21:13.04,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:21:13.37,0:21:18.17,JP,,0000,0000,0000,,Бір күні біз де жақсы көретін адамға шоколад береміз бе деп ойлаймын.
Dialogue: 0,0:21:21.28,0:21:24.35,JP,,0000,0000,0000,,Тамако ешқашан аман қалмайтын сияқты.
Dialogue: 0,0:21:24.55,0:21:25.69,JP,,0000,0000,0000,,Мидори-чан
Dialogue: 0,0:21:27.55,0:21:28.70,JP,,0000,0000,0000,,Ой...
Dialogue: 0,0:21:30.01,0:21:30.86,JP,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:21:31.16,0:21:33.13,JP,,0000,0000,0000,,Түрлі-түсті гүлдер арасында
Dialogue: 0,0:21:33.52,0:21:35.50,JP,,0000,0000,0000,,Кейбір гүлдер жасырын гүлдейді
Dialogue: 0,0:21:35.99,0:21:37.90,JP,,0000,0000,0000,,Қалай ойласаң да, Гүл – гүл
Dialogue: 0,0:21:38.25,0:21:41.00,JP,,0000,0000,0000,,Жүрегімде құлпырған, жаным
Dialogue: 0,0:21:45.62,0:21:48.64,JP,,0000,0000,0000,,Эй, сен неге біздің өнімді көшіріп жатырсың?
Dialogue: 0,0:21:48.88,0:21:50.42,JP,,0000,0000,0000,,Менің ойымша, бұл сіз көшірілген нәрсе.
Dialogue: 0,0:21:51.00,0:21:52.67,JP,,0000,0000,0000,,Жоқ, біз түпнұсқамыз.
Dialogue: 0,0:21:52.77,0:21:53.88,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:21:53.88,0:21:54.53,JP,,0000,0000,0000,,Мен бұларды басып шығарамын!
Dialogue: 0,0:21:54.53,0:21:57.67,JP,,0000,0000,0000,,Неге, бүгін ғашықтар күні.
Dialogue: 0,0:21:59.14,0:22:01.71,JP,,0000,0000,0000,,Мен шоколад ала алмаймын.
Dialogue: 0,0:23:36.12,0:23:38.08,JP,,0000,0000,0000,,Суық, солай емес пе? Бұл Тамако.
Dialogue: 0,0:23:38.69,0:23:42.02,JP,,0000,0000,0000,,Микротолқынды пеште пісірілген және шоколадқа оралған жылы күріш тортын жегенде.
Dialogue: 0,0:23:42.10,0:23:43.65,JP,,0000,0000,0000,,Бұл өте дәмді.
Dialogue: 0,0:23:43.77,0:23:44.74,JP,,0000,0000,0000,,Байқап көріңіз
Dialogue: 0,0:23:45.48,0:23:48.00,JP,,0000,0000,0000,,Келесі жолы қандай күріш тортын жеуге болады?
Dialogue: 0,0:00:21.41,0:00:22.31,CN,,0000,0000,0000,,Кадзуко ханшайымы
Dialogue: 0,0:00:34.80,0:00:36.54,CN,,0000,0000,0000,,Кішкентай жеңге
Dialogue: 0,0:00:36.84,0:00:38.04,CN,,0000,0000,0000,,Бұл ақаулы әйел.
Dialogue: 0,0:00:39.57,0:00:41.94,CN,,0000,0000,0000,,Менің сапарымда күтпеген кездесу
Dialogue: 0,0:00:42.45,0:00:45.54,CN,,0000,0000,0000,,Қазіргі уақытта үйдегі интернатта
Dialogue: 0,0:00:48.80,0:00:49.81,CN,,0000,0000,0000,,Йошиёши Хаяками
Dialogue: 0,0:00:50.44,0:00:51.23,CN,,0000,0000,0000,,Йошиёши Хаяками
Dialogue: 0,0:00:58.20,0:00:59.52,CN,,0000,0000,0000,,...
Dialogue: 0,0:01:00.18,0:01:01.79,CN,,0000,0000,0000,,Бір ғана адам келді
Dialogue: 0,0:01:00.42,0:01:02.05,CN,,0000,0000,0000,,Дегенмен, бұл менің кішкентай жеңгем.
Dialogue: 0,0:01:02.68,0:01:05.31,CN,,0000,0000,0000,,Мен адасып қалдым
Dialogue: 0,0:02:47.04,0:02:47.64,CN,,0000,0000,0000,,Қазірге дейін
Dialogue: 0,0:02:48.17,0:02:50.37,CN,,0000,0000,0000,,Ешбір айырмашылық қажет емес, кешкі асқа дайын
Dialogue: 0,0:02:51.10,0:02:51.80,CN,,0000,0000,0000,,Жұмыртқа
Dialogue: 0,0:02:52.20,0:02:52.75,CN,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:02:52.98,0:02:54.88,CN,,0000,0000,0000,,Өрістің ең оң жағы
Dialogue: 0,0:02:58.75,0:03:00.20,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:14.38,0:03:15.19,CN,,0000,0000,0000,,Аджидошин Футу
Dialogue: 0,0:03:16.03,0:03:17.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:18.31,0:03:20.59,CN,,0000,0000,0000,,heart version
Dialogue: 0,0:03:21.40,0:03:22.77,CN,,0000,0000,0000,,Дәмді және дәмді
Dialogue: 0,0:03:23.96,0:03:25.15,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:25.57,0:03:26.59,CN,,0000,0000,0000,,Салқындық
Dialogue: 0,0:03:26.60,0:03:28.16,CN,,0000,0000,0000,,Кейко Хаяками Йоши
Dialogue: 0,0:03:28.42,0:03:29.58,CN,,0000,0000,0000,,Ыңғайлы киім
Dialogue: 0,0:03:29.58,0:03:31.17,CN,,0000,0000,0000,,Салқындық
Dialogue: 0,0:03:34.31,0:03:38.00,CN,,0000,0000,0000,,Әпкелер мен әпкелер бөлек мектеп формасын киеді.
Dialogue: 0,0:03:38.30,0:03:39.67,CN,,0000,0000,0000,,Мен отбасымды тастап кеттім
Dialogue: 0,0:03:39.85,0:03:41.57,CN,,0000,0000,0000,,Нәтижені аяқтау
Dialogue: 0,0:03:46.43,0:03:48.05,CN,,0000,0000,0000,,Құс ақиқат
Dialogue: 0,0:03:48.62,0:03:49.78,CN,,0000,0000,0000,,Сіз қашан келдіңіз?
Dialogue: 0,0:03:49.93,0:03:51.97,CN,,0000,0000,0000,,Көктемде аспан келгенге дейін Цуру осында болды.
Dialogue: 0,0:03:52.14,0:03:52.97,CN,,0000,0000,0000,,Шунтен
Dialogue: 0,0:03:53.38,0:03:54.81,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:54.99,0:03:55.99,CN,,0000,0000,0000,,Суық тигізу
Dialogue: 0,0:03:58.15,0:03:59.85,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:59.93,0:04:02.59,CN,,0000,0000,0000,,Дегенмен, көктем мерекесі қызу жүріп жатыр.
Dialogue: 0,0:04:02.59,0:04:04.62,CN,,0000,0000,0000,,Қыздар кеші көктемгі жүрек Мо
Dialogue: 0,0:04:05.00,0:04:07.00,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:07.39,0:04:10.56,CN,,0000,0000,0000,,Насаның әңгімесі: Ханшайым болу оңай болды
Dialogue: 0,0:04:11.54,0:04:12.07,CN,,0000,0000,0000,,Сондай-ақ қолжетімді
Dialogue: 0,0:04:12.15,0:04:12.88,CN,,0000,0000,0000,,Ханзада?
Dialogue: 0,0:04:13.05,0:04:14.59,CN,,0000,0000,0000,,Мен өз руымның ханзадасымын.
Dialogue: 0,0:04:14.84,0:04:17.92,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:22.36,0:04:24.83,CN,,0000,0000,0000,,Королеваның Эриде болуы мүмкін емес еді.
Dialogue: 0,0:04:25.50,0:04:27.67,CN,,0000,0000,0000,,Дүкеннен шыққаннан кейін
Dialogue: 0,0:04:28.21,0:04:29.02,CN,,0000,0000,0000,,Накореджия
Dialogue: 0,0:04:29.42,0:04:30.56,CN,,0000,0000,0000,,Бұл қыздың қазынасы
Dialogue: 0,0:04:31.41,0:04:33.12,CN,,0000,0000,0000,,Мұнда келуге де болады.
Dialogue: 0,0:04:34.61,0:04:36.10,CN,,0000,0000,0000,,Әке
Dialogue: 0,0:04:36.81,0:04:37.69,CN,,0000,0000,0000,,Мұндайды есту өте сирек
Dialogue: 0,0:04:38.19,0:04:39.86,CN,,0000,0000,0000,,Бұл жылдың махаббаты.
Dialogue: 0,0:04:40.37,0:04:43.27,CN,,0000,0000,0000,,Қайтадан келгені дұрыс.
Dialogue: 0,0:04:43.41,0:04:45.76,CN,,0000,0000,0000,,Жылдың жылы жыл жылы жыл жыл жылы жыл
Dialogue: 0,0:04:45.98,0:04:49.43,CN,,0000,0000,0000,,Адам мінезі жылдар бойы өзгерді деп есептеймін.
Dialogue: 0,0:04:49.83,0:04:51.41,CN,,0000,0000,0000,,Жылдық салымдарды сақтау
Dialogue: 0,0:04:52.93,0:04:55.93,CN,,0000,0000,0000,,Жиналыс аяқталғаннан кейін
Dialogue: 0,0:04:57.48,0:04:58.64,CN,,0000,0000,0000,,Ғашықтар тәжірибесі?
Dialogue: 0,0:04:58.71,0:05:02.72,CN,,0000,0000,0000,,Түскі ас кезінде дүкенге келген білікті де күшті әйел
Dialogue: 0,0:05:03.06,0:05:04.03,CN,,0000,0000,0000,,Оларды таба аламыз ба, Мелони?
Dialogue: 0,0:05:03.12,0:05:06.05,CN,,0000,0000,0000,,Үміттенетін шебер махаббат гүлін шығарудың шебер қабілетін сатып алады
Dialogue: 0,0:05:05.02,0:05:06.18,CN,,0000,0000,0000,,Шығу тегі осы жерден шыққан
Dialogue: 0,0:05:07.82,0:05:09.00,CN,,0000,0000,0000,,Кішкентай жасыл
Dialogue: 0,0:05:10.09,0:05:10.74,CN,,0000,0000,0000,,Йошиёши Хаяками
Dialogue: 0,0:05:12.40,0:05:13.11,CN,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:05:13.27,0:05:14.23,CN,,0000,0000,0000,,Мен жеңілдім.
Dialogue: 0,0:05:14.35,0:05:17.08,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:17.25,0:05:19.96,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:20.58,0:05:23.47,CN,,0000,0000,0000,,Жүгіру және өз-өзіне көмектесу
Dialogue: 0,0:05:25.11,0:05:26.45,CN,,0000,0000,0000,,Кімге жіберу керек?
Dialogue: 0,0:05:26.78,0:05:27.77,CN,,0000,0000,0000,,Бұл құпия
Dialogue: 0,0:05:28.25,0:05:30.10,CN,,0000,0000,0000,,Бала тәрбиесінің пайдасы мен зияны
Dialogue: 0,0:05:35.14,0:05:36.18,CN,,0000,0000,0000,,Йошиёши Хаяками
Dialogue: 0,0:05:36.79,0:05:38.32,CN,,0000,0000,0000,,Косуй Хая
Dialogue: 0,0:05:39.54,0:05:40.60,CN,,0000,0000,0000,,Сурет
Dialogue: 0,0:05:40.87,0:05:41.62,CN,,0000,0000,0000,,Жыл соңы
Dialogue: 0,0:05:42.06,0:05:44.96,CN,,0000,0000,0000,,Бұл жаңа жылдық дизайн.
Dialogue: 0,0:05:45.33,0:05:45.98,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:05:47.51,0:05:48.73,CN,,0000,0000,0000,,Шеберлік және тиімді шеберлік
Dialogue: 0,0:05:49.14,0:05:51.85,CN,,0000,0000,0000,,Мазмұны шебер және тиімді.
Dialogue: 0,0:05:52.87,0:05:54.66,CN,,0000,0000,0000,,Иә.
Dialogue: 0,0:05:55.09,0:05:56.68,CN,,0000,0000,0000,,Әлемдегі ең жақсы таңдау
Dialogue: 0,0:05:56.94,0:05:58.17,CN,,0000,0000,0000,,Ақиқат – дүниенің жолы
Dialogue: 0,0:05:58.62,0:06:00.02,CN,,0000,0000,0000,,Йошиёши Хаяками
Dialogue: 0,0:06:00.73,0:06:02.35,CN,,0000,0000,0000,,Йошиёши Кана Хаяками
Dialogue: 0,0:06:02.77,0:06:03.65,CN,,0000,0000,0000,,Йошиёши Хаяками
Dialogue: 0,0:06:03.75,0:06:05.48,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:06.25,0:06:08.80,CN,,0000,0000,0000,,Аздап дизайн
Dialogue: 0,0:06:11.75,0:06:12.83,CN,,0000,0000,0000,,Шығаруға болады
Dialogue: 0,0:06:12.91,0:06:13.70,CN,,0000,0000,0000,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:06:15.98,0:06:17.59,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:18.30,0:06:21.87,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:22.05,0:06:24.39,CN,,0000,0000,0000,,Канна Сайбо Рё
Dialogue: 0,0:06:24.39,0:06:25.40,CN,,0000,0000,0000,,Мынау
Dialogue: 0,0:06:25.79,0:06:27.76,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:28.17,0:06:31.95,CN,,0000,0000,0000,,Махаббат хикаясының алғашқы кіріспесі бөлек
Dialogue: 0,0:06:32.06,0:06:33.06,CN,,0000,0000,0000,,Бұл мүмкін емес пе?
Dialogue: 0,0:06:33.56,0:06:37.31,CN,,0000,0000,0000,,Бұрыннан бастап, кішкентай кезінде жетістікке жеткен студент қыздың шеберлігі мен шеберлігі.
Dialogue: 0,0:06:37.97,0:06:40.54,CN,,0000,0000,0000,,Адамның дүниеге келуі де өнерлі, күшті.
Dialogue: 0,0:06:40.65,0:06:42.49,CN,,0000,0000,0000,,Ғашықтардың астаналық көтеріліс үлгісі толық емес
Dialogue: 0,0:06:42.74,0:06:47.32,CN,,0000,0000,0000,,Кешегі адам өмірінен үйренгенім осы.
Dialogue: 0,0:06:48.53,0:06:50.28,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:50.65,0:06:53.28,CN,,0000,0000,0000,,Студент қызды немесе ер студентті қабылдау
Dialogue: 0,0:06:53.56,0:06:55.32,CN,,0000,0000,0000,,Саяхаттамау – бір дене
Dialogue: 0,0:06:55.59,0:06:57.27,CN,,0000,0000,0000,,Жарайды, бұл тек менің жеке пікірім ғана.
Dialogue: 0,0:06:57.52,0:06:59.66,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:59.83,0:07:01.88,CN,,0000,0000,0000,,Кішкентай жасыл шынайы махаббат
Dialogue: 0,0:07:01.92,0:07:03.22,CN,,0000,0000,0000,,Ақиқат және ақиқат.
Dialogue: 0,0:07:03.26,0:07:04.87,CN,,0000,0000,0000,,Жылау
Dialogue: 0,0:07:06.19,0:07:07.07,CN,,0000,0000,0000,,Жұмыртқа 3
Dialogue: 0,0:07:08.21,0:07:09.17,CN,,0000,0000,0000,,Оны кімге жіберу керек?
Dialogue: 0,0:07:16.37,0:07:18.40,CN,,0000,0000,0000,,Оқуды бастаңыз
Dialogue: 0,0:07:21.39,0:07:22.38,CN,,0000,0000,0000,,Қайта қарау
Dialogue: 0,0:07:22.72,0:07:23.63,CN,,0000,0000,0000,,Қайта қарау
Dialogue: 0,0:07:29.00,0:07:30.83,CN,,0000,0000,0000,,Кішкентай жеңге
Dialogue: 0,0:07:31.48,0:07:32.71,CN,,0000,0000,0000,,Кодама
Dialogue: 0,0:07:33.47,0:07:34.20,CN,,0000,0000,0000,,Құттықтаймыз
Dialogue: 0,0:07:34.64,0:07:35.51,CN,,0000,0000,0000,,15-ші эпизод: Батырлық өлім – Екінші бөлім
Dialogue: 0,0:07:36.34,0:07:38.64,CN,,0000,0000,0000,,Кемпір пешті шығару үшін бес адамды талап етеді.
Dialogue: 0,0:07:38.85,0:07:39.56,CN,,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:07:40.12,0:07:41.48,CN,,0000,0000,0000,,Енді көктегі сарықұйрық балық
Dialogue: 0,0:07:41.69,0:07:42.99,CN,,0000,0000,0000,,Нашу Канаме Сарықұйрық
Dialogue: 0,0:07:43.49,0:07:44.62,CN,,0000,0000,0000,,Райбан тофуы
Dialogue: 0,0:07:44.72,0:07:45.40,CN,,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:07:48.23,0:07:49.44,CN,,0000,0000,0000,,Құттықтаймыз
Dialogue: 0,0:07:52.77,0:07:53.47,CN,,0000,0000,0000,,тақырып
Dialogue: 0,0:07:53.76,0:07:57.49,CN,,0000,0000,0000,,Менің сауда көшем, ғашық қаласым жоғалды.
Dialogue: 0,0:08:00.37,0:08:02.14,CN,,0000,0000,0000,,Жоспары бар сүйікті адамға шағын қонаққа бару
Dialogue: 0,0:08:02.35,0:08:03.05,CN,,0000,0000,0000,,Ғашық...
Dialogue: 0,0:08:04.95,0:08:07.87,CN,,0000,0000,0000,,Менің үмітім мектептегі Саюри Коджидің шеберлігіне жетті деп қалай айта аламын?
Dialogue: 0,0:08:08.22,0:08:10.73,CN,,0000,0000,0000,,Бұл жай ғана факт.
Dialogue: 0,0:08:11.09,0:08:11.74,CN,,0000,0000,0000,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:08:11.88,0:08:13.24,CN,,0000,0000,0000,,Табылмады
Dialogue: 0,0:08:13.51,0:08:14.55,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:14.70,0:08:16.66,CN,,0000,0000,0000,,Дарынды дарындылық
Dialogue: 0,0:08:18.32,0:08:19.85,CN,,0000,0000,0000,,Токушю сауда көшесінің шығу тегі
Dialogue: 0,0:08:36.78,0:08:37.49,CN,,0000,0000,0000,,Кел, кел, кел!
Dialogue: 0,0:08:46.78,0:08:48.24,CN,,0000,0000,0000,,Сауда аймағының дүниеге келуі
Dialogue: 0,0:08:48.98,0:08:51.34,CN,,0000,0000,0000,,Мәліметтер қолжетімді емес.
Dialogue: 0,0:08:51.99,0:08:53.46,CN,,0000,0000,0000,,Нұсқауларды қараңыз
Dialogue: 0,0:08:54.44,0:08:55.62,CN,,0000,0000,0000,,Өзімшіл
Dialogue: 0,0:08:56.89,0:08:57.74,CN,,0000,0000,0000,,Өзімшіл?
Dialogue: 0,0:09:00.08,0:09:02.72,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:03.25,0:09:04.73,CN,,0000,0000,0000,,Станция қай жерде болса да.
Dialogue: 0,0:09:13.01,0:09:14.10,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:14.23,0:09:15.83,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:15.83,0:09:18.12,CN,,0000,0000,0000,,Сатып алу сатып алу Сатып алу Сатып алу сатып алу
Dialogue: 0,0:09:18.12,0:09:21.02,CN,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:09:22.23,0:09:24.55,CN,,0000,0000,0000,,Сауда көшесінің шығу тегі
Dialogue: 0,0:09:25.07,0:09:26.58,CN,,0000,0000,0000,,Сауда көшесі
Dialogue: 0,0:09:27.47,0:09:30.49,CN,,0000,0000,0000,,Қояндар залы көкте бар, мен кетіп қалдым.
Dialogue: 0,0:09:30.99,0:09:33.08,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:34.33,0:09:36.22,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:36.74,0:09:38.63,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:39.24,0:09:43.30,CN,,0000,0000,0000,,Сіз өзіңіздің сезімдеріңізді жоғары сұраныспен оқуыңыз керек.
Dialogue: 0,0:09:43.61,0:09:44.36,CN,,0000,0000,0000,,Бастықты құлатып, осылайша оның зор есірткі табысын өз пайдасына иелену үшін
Dialogue: 0,0:09:47.77,0:09:50.19,CN,,0000,0000,0000,,Жаңа сатып алу туралы не айтасыз?
Dialogue: 0,0:09:50.51,0:09:52.82,CN,,0000,0000,0000,,Ескі ережелерді өзгерту
Dialogue: 0,0:09:52.90,0:09:53.88,CN,,0000,0000,0000,,Бір нәрсе дұрыс емес.
Dialogue: 0,0:09:53.88,0:09:55.38,CN,,0000,0000,0000,,Біз бірге болғанымызға қуаныштымыз
