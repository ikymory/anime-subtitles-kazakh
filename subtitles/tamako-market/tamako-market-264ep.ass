Dialogue: 0,0:18:39.02,0:18:40.24,CN,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:18:40.24,0:18:42.31,CN,,0000,0000,0000,,Бұл мен үшін өте жақсы
Dialogue: 0,0:18:42.41,0:18:43.51,CN,,0000,0000,0000,,Жұмыстың бөлігі
Dialogue: 0,0:18:43.82,0:18:45.32,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:49.11,0:18:50.03,CN,,0000,0000,0000,,Міне, марапат ретінде сүйіс. Мwah.
Dialogue: 0,0:18:51.17,0:18:52.83,CN,,0000,0000,0000,,Шағын тамақты өңдеу
Dialogue: 0,0:18:53.35,0:18:54.86,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:55.27,0:18:57.92,CN,,0000,0000,0000,,Шағын жасыл ауылдан Шираничи құсы кетіп қалды.
Dialogue: 0,0:18:57.98,0:19:00.46,CN,,0000,0000,0000,,Сондықтан бір адам CUT сәтті аяқталды.
Dialogue: 0,0:19:11.63,0:19:12.65,CN,,0000,0000,0000,,Кішкентай жеңге
Dialogue: 0,0:19:13.00,0:19:15.63,CN,,0000,0000,0000,,Aoi гүл себеттерін бір уақытта шығаруға болады.
Dialogue: 0,0:19:15.79,0:19:17.19,CN,,0000,0000,0000,,Су мен жемістің бөлінуі
Dialogue: 0,0:19:17.29,0:19:19.00,CN,,0000,0000,0000,,Шабдалы
Dialogue: 0,0:19:19.59,0:19:20.96,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:21.03,0:19:23.03,CN,,0000,0000,0000,,Кішкентай ене сары бас
Dialogue: 0,0:19:23.17,0:19:23.88,CN,,0000,0000,0000,,Көрсетші.
Dialogue: 0,0:19:23.98,0:19:24.86,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:27.36,0:19:28.46,CN,,0000,0000,0000,,Сіздің сұранысыңызға қатысты сұрақтар
Dialogue: 0,0:19:29.33,0:19:30.83,CN,,0000,0000,0000,,Нағыз біртүрлі құбыжық
Dialogue: 0,0:19:31.51,0:19:32.51,CN,,0000,0000,0000,,Қолайсыз елші?
Dialogue: 0,0:19:32.95,0:19:35.01,CN,,0000,0000,0000,,Йошихиса қайтыс болды.
Dialogue: 0,0:19:35.23,0:19:36.62,CN,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:19:37.79,0:19:39.31,CN,,0000,0000,0000,,Жұмысты аяқтағаннан кейін
Dialogue: 0,0:19:43.85,0:19:46.61,CN,,0000,0000,0000,,Бұл махаббат пен махаббат саудасы көшесі.
Dialogue: 0,0:19:46.90,0:19:48.77,CN,,0000,0000,0000,,Сізде... әр түрлі қабілеттеріңіз бар
Dialogue: 0,0:19:48.85,0:19:50.27,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:50.71,0:19:53.24,CN,,0000,0000,0000,,Бұл оқиға...
Dialogue: 0,0:19:53.34,0:19:55.05,CN,,0000,0000,0000,,Құс...Мистер. Құс...
Dialogue: 0,0:19:54.17,0:19:56.02,CN,,0000,0000,0000,,Коиай сауда ауданы
20-тарау
Dialogue: 0,0:19:58.50,0:20:02.99,CN,,0000,0000,0000,,～
Dialogue: 0,0:20:03.26,0:20:04.91,CN,,0000,0000,0000,,～～
Dialogue: 0,0:20:05.83,0:20:08.49,CN,,0000,0000,0000,,Кодамако сауда көшесі шынымен ыстық.
Dialogue: 0,0:20:10.34,0:20:11.12,CN,,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:20:13.48,0:20:16.16,CN,,0000,0000,0000,,Кім қабылдауға құқылы?
Dialogue: 0,0:20:20.54,0:20:21.22,CN,,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:20:21.47,0:20:23.54,CN,,0000,0000,0000,,Усагияма сауда көшесі
Dialogue: 0,0:20:25.23,0:20:30.11,CN,,0000,0000,0000,,Менің сауда көшесім осы жерден шыққан.
Dialogue: 0,0:20:31.47,0:20:32.17,CN,,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:20:32.81,0:20:34.04,CN,,0000,0000,0000,,Ащы құс
Dialogue: 0,0:20:34.11,0:20:35.55,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:44.65,0:20:47.31,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:48.89,0:20:50.73,CN,,0000,0000,0000,,Аспандағы әрбір қала ыстық
Dialogue: 0,0:20:50.97,0:20:53.08,CN,,0000,0000,0000,,Дегенмен, НАСА сұлулығы әлі де мұхитта сақталады.
Dialogue: 0,0:20:54.02,0:20:56.17,CN,,0000,0000,0000,,Деладағы ең қуанышты көгершін жемісі
Dialogue: 0,0:20:56.68,0:20:58.16,CN,,0000,0000,0000,,Енді Теня алынып тасталды.
Dialogue: 0,0:21:00.50,0:21:02.10,CN,,0000,0000,0000,,Косуй Хаяками
Dialogue: 0,0:21:02.40,0:21:03.06,CN,,0000,0000,0000,,Йошиёши Хаяками
Dialogue: 0,0:21:03.54,0:21:04.63,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:05.07,0:21:06.32,CN,,0000,0000,0000,,Ғашықтан сыйлық
Dialogue: 0,0:21:07.35,0:21:10.35,CN,,0000,0000,0000,,Биыл мен де баламды жіберуді жөн көрдім.
Dialogue: 0,0:21:12.32,0:21:13.04,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:21:13.37,0:21:18.17,CN,,0000,0000,0000,,Дүниедегі ең бақытты адамдардың бірі
Dialogue: 0,0:21:21.28,0:21:24.35,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:24.55,0:21:25.69,CN,,0000,0000,0000,,Кішкентай жасыл
Dialogue: 0,0:21:27.55,0:21:28.70,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:21:30.01,0:21:30.86,CN,,0000,0000,0000,,Барлығыңды өлтіреміз
Dialogue: 0,0:21:31.16,0:21:33.13,CN,,0000,0000,0000,,Гүлге толы бақ
Dialogue: 0,0:21:33.52,0:21:35.50,CN,,0000,0000,0000,,Сондай-ақ қызықты гүл бағы бар
Dialogue: 0,0:21:35.99,0:21:37.90,CN,,0000,0000,0000,,Гүл бағы – гүл бағы
Dialogue: 0,0:21:38.25,0:21:41.00,CN,,0000,0000,0000,,Жүректегі сүйкімді гүл бағы
Dialogue: 0,0:21:45.62,0:21:48.64,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:48.88,0:21:50.42,CN,,0000,0000,0000,,Бұл сіздің үлгіңіз.
Dialogue: 0,0:21:51.00,0:21:52.67,CN,,0000,0000,0000,,Менің жеке талантым емес, түпнұсқа нұсқасы
Dialogue: 0,0:21:52.77,0:21:53.88,CN,,0000,0000,0000,,Асуға қажет
Dialogue: 0,0:21:53.88,0:21:54.53,CN,,0000,0000,0000,,Келу
Dialogue: 0,0:21:54.53,0:21:57.67,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:59.14,0:22:01.71,CN,,0000,0000,0000,,Шеберлік пен шеберлік арқылы бір адам соңына жетеді!
Dialogue: 0,0:23:36.12,0:23:38.08,CN,,0000,0000,0000,,Сәттілік, мен жұмыртқамын.
Dialogue: 0,0:23:38.69,0:23:42.02,CN,,0000,0000,0000,,Микротолқынды пеште қыздырудың кемшіліктері
Dialogue: 0,0:23:42.10,0:23:43.65,CN,,0000,0000,0000,,Кездесу өте жақсы ән
Dialogue: 0,0:23:43.77,0:23:44.74,CN,,0000,0000,0000,,Сот талқылауы
Dialogue: 0,0:23:45.48,0:23:48.00,CN,,0000,0000,0000,,Жиналыстың соңында кейбір кемшіліктер бар.
Dialogue: 0,0:03:00.78,0:03:05.70,CN,,0000,0000,0000,,Махаббат махаббат гүлі тегін махаббат тәжірибесі
Dialogue: 0,0:09:45.85,0:09:47.35,CN,,0000,0000,0000,,Таза қонақ келгеннен кейін.
Dialogue: 0,0:09:45.85,0:09:47.35,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:04.41,0:10:07.91,CN,,0000,0000,0000,,Ғашықтар билеті
Dialogue: 0,0:13:51.64,0:13:55.02,CN,,0000,0000,0000,,Хоуп және т.б.
Dialogue: 0,0:13:51.64,0:13:55.02,CN,,0000,0000,0000,,Бақыт туралы әңгімелеу
Dialogue: 0,0:19:10.08,0:19:12.50,CN,,0000,0000,0000,,Жұмыртқа
Dialogue: 0,0:19:10.08,0:19:12.50,CN,,0000,0000,0000,,Менің үй құсым
Dialogue: 0,0:19:10.08,0:19:12.50,CN,,0000,0000,0000,,Бұл дұрыс па, жоқ па?
Dialogue: 0,0:19:25.01,0:19:25.60,CN,,0000,0000,0000,,Кішкентай жасыл
Dialogue: 0,0:19:25.01,0:19:25.60,CN,,0000,0000,0000,,Мен өзімшілмін
Dialogue: 0,0:19:25.01,0:19:25.60,CN,,0000,0000,0000,,Мансап ортасынан кету аяқталды ~~~
Dialogue: 0,0:19:25.01,0:19:25.60,CN,,0000,0000,0000,,CM
Dialogue: 0,0:19:25.60,0:19:25.64,CN,,0000,0000,0000,,Мен өзімшілмін
Dialogue: 0,0:19:25.60,0:19:25.64,CN,,0000,0000,0000,,Мансап ортасынан кету аяқталды ~~~
Dialogue: 0,0:19:25.60,0:19:25.64,CN,,0000,0000,0000,,CM
Dialogue: 0,0:19:25.64,0:19:25.85,CN,,0000,0000,0000,,Мен өзімшілмін
Dialogue: 0,0:19:25.64,0:19:25.85,CN,,0000,0000,0000,,Мансап ортасынан кету аяқталды ~~~
Dialogue: 0,0:19:25.64,0:19:25.85,CN,,0000,0000,0000,,CM
Dialogue: 0,0:19:25.64,0:19:25.85,CN,,0000,0000,0000,,Күзетші құс
Dialogue: 0,0:19:25.85,0:19:25.89,CN,,0000,0000,0000,,Мансап ортасынан кету аяқталды ~~~
Dialogue: 0,0:19:25.85,0:19:25.89,CN,,0000,0000,0000,,CM
Dialogue: 0,0:19:25.85,0:19:25.89,CN,,0000,0000,0000,,Қорғаушы құс
Dialogue: 0,0:19:25.89,0:19:28.56,CN,,0000,0000,0000,,Мансап ортасынан кету аяқталды ~~~
