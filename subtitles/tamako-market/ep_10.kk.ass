Dialogue: 0,0:01:38.99,0:01:43.55,OP-JP,,0000,0000,0000,,Мен өзімді көп адамның арасынан жүгіріп өткендей сезінемін
Dialogue: 0,0:01:43.74,0:01:46.41,OP-JP,,0000,0000,0000,,Мен сені шақырғандай.
Dialogue: 0,0:01:46.41,0:01:49.33,OP-JP,,0000,0000,0000,,Тағы да толып жатыр
Dialogue: 0,0:01:50.27,0:01:54.86,OP-JP,,0000,0000,0000,,Жан-жақта ұшқан фаворитизмді мақтан тұтамын
Dialogue: 0,0:01:54.98,0:02:00.87,OP-JP,,0000,0000,0000,,Мен өзімнің күткен үміттеріме қуанғым келеді
Dialogue: 0,0:02:01.46,0:02:03.99,OP-JP,,0000,0000,0000,,Мен тік тұрдым.
Dialogue: 0,0:02:04.27,0:02:06.63,OP-JP,,0000,0000,0000,,Мен көптен бері күттім
Dialogue: 0,0:02:06.63,0:02:08.53,OP-JP,,0000,0000,0000,,Бірінен-бірі өтіп бара жатқан күлкілер
Dialogue: 0,0:02:08.68,0:02:12.40,OP-JP,,0000,0000,0000,,Мен сені қатты құшақтағым келеді
Dialogue: 0,0:02:15.11,0:02:17.82,OP-JP,,0000,0000,0000,,Келіңіздер, бәріңіз.
Dialogue: 0,0:02:17.91,0:02:25.81,OP-JP,,0000,0000,0000,,Ол әрқашан кенеттен жүгіре бастайды.
Dialogue: 0,0:02:25.89,0:02:31.71,OP-JP,,0000,0000,0000,,Кез келген кештің тұман болатыны сияқты.
Dialogue: 0,0:02:31.96,0:02:38.89,OP-JP,,0000,0000,0000,,Бұл жерді жарқыраған жерде тексеру
Dialogue: 0,0:21:55.83,0:21:59.39,ED-JP,,0000,0000,0000,,бұрылыс жазбасы
Dialogue: 0,0:21:59.39,0:22:02.87,ED-JP,,0000,0000,0000,,Егер ісініп, жарылып кетсе
Dialogue: 0,0:22:02.87,0:22:08.23,ED-JP,,0000,0000,0000,,Бұл күйдірілген жазба болады.
Dialogue: 0,0:22:10.31,0:22:15.40,ED-JP,,0000,0000,0000,,Шаш кептіргішпен түзетілмейтін көңіл-күй
Dialogue: 0,0:22:17.45,0:22:21.31,ED-JP,,0000,0000,0000,,Мен кеше тым көп сөйледім
Dialogue: 0,0:22:24.35,0:22:29.42,ED-JP,,0000,0000,0000,,Мен контактілерді жоюға тырыстым.
Dialogue: 0,0:22:31.35,0:22:34.98,ED-JP,,0000,0000,0000,,Дүние бұлыңғыр
Dialogue: 0,0:22:37.06,0:22:40.36,ED-JP,,0000,0000,0000,,Бір сәтке
Dialogue: 0,0:22:40.36,0:22:43.86,ED-JP,,0000,0000,0000,,Мен сенің тұрған жеріңді тексеремін.
Dialogue: 0,0:22:44.06,0:22:51.09,ED-JP,,0000,0000,0000,,Бір күні сені тастап кетемін бе деп ойлаймын
Dialogue: 0,0:22:54.50,0:22:58.00,ED-JP,,0000,0000,0000,,Әрқашан бірдеңе іздеу
Dialogue: 0,0:22:58.00,0:23:01.59,ED-JP,,0000,0000,0000,,Жақын жерде жасырыну
Dialogue: 0,0:23:01.59,0:23:07.07,ED-JP,,0000,0000,0000,,Тақпақтың жүрегін білсем де
Dialogue: 0,0:23:07.92,0:23:12.10,ED-JP,,0000,0000,0000,,Ах, иіру, иіру, жазулар
Dialogue: 0,0:23:12.10,0:23:15.59,ED-JP,,0000,0000,0000,,Ол ісініп, жарылып кетеді.
Dialogue: 0,0:23:15.59,0:23:20.65,ED-JP,,0000,0000,0000,,Бірақ, жұмбақ әуен
Dialogue: 0,0:23:21.91,0:23:24.51,ED-JP,,0000,0000,0000,,Мен оны ешқашан ұмытпаймын
Dialogue: 0,0:00:03.16,0:00:04.79,JP,,0000,0000,0000,,Барлығы осында жиналды
Dialogue: 0,0:00:04.79,0:00:08.21,JP,,0000,0000,0000,,Енді мектеп фестивалінің сахналық тұсаукесер тәртібін шешеміз.
Dialogue: 0,0:00:08.35,0:00:11.50,JP,,0000,0000,0000,,Әр бөлім меңгерушілері сахнада жеребе тартуы керек.
Dialogue: 0,0:00:12.07,0:00:13.40,JP,,0000,0000,0000,,Мидори-чан жекпе-жегі
Dialogue: 0,0:00:13.62,0:00:16.00,JP,,0000,0000,0000,,Сайлауда жеңіліп қалмасаңыз, кез келген уақыт жақсы.
Dialogue: 0,0:00:16.21,0:00:18.08,JP,,0000,0000,0000,,Жоқ, қабылдамау деген жоқ.
Dialogue: 0,0:00:19.22,0:00:20.49,JP,,0000,0000,0000,,Жарайды, мен барамын.
Dialogue: 0,0:00:20.49,0:00:22.04,JP,,0000,0000,0000,,Иә, сәттілік
Dialogue: 0,0:00:23.48,0:00:25.67,JP,,0000,0000,0000,,Өткен жыл соңғы болды, солай ма?
Dialogue: 0,0:00:25.86,0:00:27.47,JP,,0000,0000,0000,,Тұтынушылар көп болмады.
Dialogue: 0,0:00:27.57,0:00:29.64,JP,,0000,0000,0000,,Сізге рахмет, мен қобалжымадым.
Dialogue: 0,0:00:29.84,0:00:32.21,JP,,0000,0000,0000,,Қисарағы-сенпай әлсіз.
Dialogue: 0,0:00:32.45,0:00:34.03,JP,,0000,0000,0000,,Бұл жерде мочи сақталады.
Dialogue: 0,0:00:36.80,0:00:39.19,JP,,0000,0000,0000,,Таңертеңгі уақыттан бері ақымақ фильм?
Dialogue: 0,0:00:42.79,0:00:43.81,JP,,0000,0000,0000,,Тасбақа тасбақа
Dialogue: 0,0:00:44.08,0:00:45.10,JP,,0000,0000,0000,,Мұнда
Dialogue: 0,0:00:45.10,0:00:45.82,JP,,0000,0000,0000,,Бұл ауыр
Dialogue: 0,0:00:45.82,0:00:47.60,JP,,0000,0000,0000,,Төраға, шиеленіс жоғары.
Dialogue: 0,0:00:48.13,0:00:49.88,JP,,0000,0000,0000,,Батон клубын беріңізші
Dialogue: 0,0:00:49.11,0:00:49.91,JP,,0000,0000,0000,,Мидори-чан
Dialogue: 0,0:00:49.91,0:00:51.65,JP,,0000,0000,0000,,Менеджер өте күшті сияқты.
Dialogue: 0,0:00:52.04,0:00:53.14,JP,,0000,0000,0000,,Күтулер
Dialogue: 0,0:00:58.62,0:01:03.80,JP,,0000,0000,0000,,Он бірден он бір отызға дейінгі алтын уақыт. Бұл таяқша клубы.
Dialogue: 0,0:01:04.31,0:01:05.60,JP,,0000,0000,0000,,Мен оны шынымен тарттым
Dialogue: 0,0:01:06.34,0:01:07.65,JP,,0000,0000,0000,,Керемет менеджер
Dialogue: 0,0:01:07.65,0:01:08.88,JP,,0000,0000,0000,,Менің ойымша.
Dialogue: 0,0:01:08.88,0:01:12.14,JP,,0000,0000,0000,,Толқып, ізетті, кеудесін кернейді
Dialogue: 0,0:01:12.35,0:01:14.13,JP,,0000,0000,0000,,Жүрегіңді билейтін мәдениет фестивалі
Dialogue: 0,0:01:14.62,0:01:18.98,JP,,0000,0000,0000,,Күнделікті жетістіктерімді барлығына көрсетемін. Маған қосылыңыз.
Dialogue: 0,0:02:52.31,0:02:57.35,JP,,0000,0000,0000,,Сондықтан біз мектеп фестивалінің бағдарламасын ойластыру үшін жиналысты бастаймыз.
Dialogue: 0,0:02:57.89,0:02:59.86,JP,,0000,0000,0000,,Егер бірдеңе істегіңіз келсе, маған хабарлаңыз.
Dialogue: 0,0:03:00.22,0:03:01.60,JP,,0000,0000,0000,,Таяқшаны не істеуім керек?
Dialogue: 0,0:03:02.20,0:03:03.03,JP,,0000,0000,0000,,Ұлықтау рәсімі
Dialogue: 0,0:03:03.50,0:03:04.60,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:03:05.86,0:03:07.49,JP,,0000,0000,0000,,Өткен жылы не істедің?
Dialogue: 0,0:03:10.00,0:03:11.16,JP,,0000,0000,0000,,Жаңа жыл тойы дегеніміз не?
Dialogue: 0,0:03:12.52,0:03:15.49,JP,,0000,0000,0000,,Қайырлы таң, Қисараги-сенпай.
Dialogue: 0,0:03:15.77,0:03:17.13,JP,,0000,0000,0000,,Мен қарауға келдім.
Dialogue: 0,0:03:23.81,0:03:26.26,JP,,0000,0000,0000,,Өткен жылы біз сиқырлы шоу музыкасына биледік.
Dialogue: 0,0:03:26.26,0:03:29.21,JP,,0000,0000,0000,,Көгершіндер қашан пайда болады деген үлкен үміт бар.
Dialogue: 0,0:03:29.21,0:03:31.02,JP,,0000,0000,0000,,Ән таңдауда қате болды, сенпай.
Dialogue: 0,0:03:31.02,0:03:34.20,JP,,0000,0000,0000,,Біз биыл көгершіндерді жібереміз бе? Бізде Делла Чан бар.
Dialogue: 0,0:03:34.20,0:03:35.91,JP,,0000,0000,0000,,Өйткені біз таяқша клубымыз
Dialogue: 0,0:03:35.91,0:03:37.71,JP,,0000,0000,0000,,Жарайды, айтқаныңды айт.
Dialogue: 0,0:03:37.88,0:03:40.06,JP,,0000,0000,0000,,Олай болса, мен былтыр үндемедім.
Dialogue: 0,0:03:40.16,0:03:41.03,JP,,0000,0000,0000,,Не?
Dialogue: 0,0:03:41.03,0:03:42.08,JP,,0000,0000,0000,,Жаңа жылды қарсы алу рәсімі
Dialogue: 0,0:03:43.55,0:03:44.94,JP,,0000,0000,0000,,Бұл тоқырау емес еді.
Dialogue: 0,0:03:45.41,0:03:46.14,JP,,0000,0000,0000,,Таныстырулар!
Dialogue: 0,0:03:46.34,0:03:48.58,JP,,0000,0000,0000,,Алты адам баспалдақты ұстай алмайды.
Dialogue: 0,0:03:49.16,0:03:51.14,JP,,0000,0000,0000,,Баспалдақ төбеге жабысып қалмаңыз
Dialogue: 0,0:03:51.16,0:03:52.11,JP,,0000,0000,0000,,Жақсы
Dialogue: 0,0:03:47.02,0:03:50.59,JP,,0000,0000,0000,,Мидо-чан саған мисоны өшіру керек деп айтқаны үшін солай айтпадың ба?
Dialogue: 0,0:03:52.93,0:03:54.21,JP,,0000,0000,0000,,Эй, сен Хаппи киесің бе?
Dialogue: 0,0:03:54.21,0:03:55.13,JP,,0000,0000,0000,,Кенже
Dialogue: 0,0:03:55.42,0:03:57.14,JP,,0000,0000,0000,,Олай болса, тақырыпты шешейік.
Dialogue: 0,0:03:57.30,0:03:58.11,JP,,0000,0000,0000,,Тақырып қандай?
Dialogue: 0,0:03:58.11,0:04:01.40,JP,,0000,0000,0000,,Бәрі жақсы, тіпті "Mochi Love" немесе "Seishun Explosion"
Dialogue: 0,0:04:01.40,0:04:03.15,JP,,0000,0000,0000,,Күріш тортының өмірі туралы не деуге болады?
Dialogue: 0,0:04:03.41,0:04:05.17,JP,,0000,0000,0000,,Күріш торты өмір бойы сақталады ма?
Dialogue: 0,0:04:05.28,0:04:08.10,JP,,0000,0000,0000,,Иә, мен жабысқақ күріш көшеттерін отырғызамын.
Dialogue: 0,0:04:08.21,0:04:11.64,JP,,0000,0000,0000,,Үлкен болып өседі, сосын орады.
Dialogue: 0,0:04:11.78,0:04:14.83,JP,,0000,0000,0000,,Дән бастырылып, таза ақ желімді күріш болды.
Dialogue: 0,0:04:15.34,0:04:17.39,JP,,0000,0000,0000,,Содан кейін түні бойы суға салып қойыңыз.
Dialogue: 0,0:04:17.55,0:04:18.88,JP,,0000,0000,0000,,Барлығымен бірге пісірілген
Dialogue: 0,0:04:18.88,0:04:20.04,JP,,0000,0000,0000,,Тама-чан, бұл қызық.
Dialogue: 0,0:04:20.21,0:04:22.71,JP,,0000,0000,0000,,Басқа жер минометке ауыстырылды.
Dialogue: 0,0:04:22.71,0:04:23.84,JP,,0000,0000,0000,,пышақпен ұрды
Dialogue: 0,0:04:25.95,0:04:27.45,JP,,0000,0000,0000,,Тамақтанудың бақытты аяқталуы?
Dialogue: 0,0:04:27.45,0:04:28.51,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:04:27.86,0:04:29.16,JP,,0000,0000,0000,,Процесс маңызды
Dialogue: 0,0:04:29.16,0:04:30.34,JP,,0000,0000,0000,,Қызықты көрінеді.
Dialogue: 0,0:04:30.46,0:04:31.76,JP,,0000,0000,0000,,Бұл үлкен мәселе болатын сияқты
Dialogue: 0,0:04:31.86,0:04:32.60,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:04:32.75,0:04:35.11,JP,,0000,0000,0000,,Бірақ сіз бұл туралы осылай ойлайсыз.
Dialogue: 0,0:04:35.21,0:04:35.94,JP,,0000,0000,0000,,Оған не болды?
Dialogue: 0,0:04:36.01,0:04:38.14,JP,,0000,0000,0000,,Мен өзімді бір ойға келгендей сезінемін.
Dialogue: 0,0:04:38.98,0:04:40.04,JP,,0000,0000,0000,,Э-э…
Dialogue: 0,0:04:40.77,0:04:43.01,JP,,0000,0000,0000,,Олай болса, бес-он минуттық әрекет.
Dialogue: 0,0:04:43.11,0:04:46.31,JP,,0000,0000,0000,,Сіз сондай-ақ кейбір трюктар жасап, түсіндіре аласыз.
Dialogue: 0,0:04:46.69,0:04:47.39,JP,,0000,0000,0000,,Тақырып...
Dialogue: 0,0:04:47.39,0:04:48.88,JP,,0000,0000,0000,,Тақырып бір сәтке күтілуде
Dialogue: 0,0:04:48.92,0:04:52.39,JP,,0000,0000,0000,,Хореография біздің режиссер Мидо Чан, мен оны асыға күтемін.
Dialogue: 0,0:04:53.13,0:04:55.86,JP,,0000,0000,0000,,Әндерді шешкенім дұрыс па?
Dialogue: 0,0:04:56.03,0:04:56.57,JP,,0000,0000,0000,,Әрине
Dialogue: 0,0:04:56.57,0:04:57.13,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:04:58.11,0:05:00.44,JP,,0000,0000,0000,,Енді бос емес.
Dialogue: 0,0:05:01.07,0:05:02.85,JP,,0000,0000,0000,,Мен сендерге костюмдер жасап беремін.
Dialogue: 0,0:05:03.15,0:05:06.01,JP,,0000,0000,0000,,Е, жоқ, мен сенімен бірге дүкен аралауға барғым келеді.
Dialogue: 0,0:05:06.01,0:05:08.48,JP,,0000,0000,0000,,Жарайды, мен өз бетімше шешпеймін.
Dialogue: 0,0:05:08.57,0:05:09.58,JP,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:05:09.86,0:05:11.19,JP,,0000,0000,0000,,Мен де бара аламын ба?
Dialogue: 0,0:05:11.19,0:05:12.38,JP,,0000,0000,0000,,Әрине.
Dialogue: 0,0:05:12.49,0:05:13.64,JP,,0000,0000,0000,,Менің де барғым келеді
Dialogue: 0,0:05:13.64,0:05:14.41,JP,,0000,0000,0000,,Мен де
Dialogue: 0,0:05:14.45,0:05:15.76,JP,,0000,0000,0000,,Бұл қызық болып барады.
Dialogue: 0,0:05:15.86,0:05:17.11,JP,,0000,0000,0000,,Бұл мәдени мереке
Dialogue: 0,0:05:17.36,0:05:18.22,JP,,0000,0000,0000,,Сонда кездескенше
Dialogue: 0,0:05:18.22,0:05:19.58,JP,,0000,0000,0000,,Қайта кездескенше, еңбектеріңізге рахмет.
Dialogue: 0,0:05:20.09,0:05:21.66,JP,,0000,0000,0000,,Қандай жүйені қолдануым керек?
Dialogue: 0,0:05:22.20,0:05:23.65,JP,,0000,0000,0000,,Мочи махаббат түрі Дехатсушики түрі
Dialogue: 0,0:05:24.58,0:05:25.54,JP,,0000,0000,0000,,Мәдени мереке?
Dialogue: 0,0:05:26.03,0:05:28.29,JP,,0000,0000,0000,,Иә, былтырғы фотоларды көргіңіз келе ме?
Dialogue: 0,0:05:28.71,0:05:30.09,JP,,0000,0000,0000,,Қараңызшы, бұл жаман мінез.
Dialogue: 0,0:05:30.09,0:05:31.49,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:05:32.36,0:05:33.86,JP,,0000,0000,0000,,Мочизо бұл суретті мен үшін түсірді.
Dialogue: 0,0:05:35.37,0:05:37.03,JP,,0000,0000,0000,,Бәріміз сол таяқшаны сермеп береміз бе?
Dialogue: 0,0:05:37.16,0:05:39.69,JP,,0000,0000,0000,,Дұрыс, әнге билеу
Dialogue: 0,0:05:40.09,0:05:43.80,JP,,0000,0000,0000,,Бұл мочицуки деп аталады. Бұл жердегі адамдар билегенді ұнатады.
Dialogue: 0,0:05:43.94,0:05:46.68,JP,,0000,0000,0000,,Иә, Чой Чан, маған да келіңізші.
Dialogue: 0,0:05:46.80,0:05:48.41,JP,,0000,0000,0000,,Go Мен билегенді ұнатамын
Dialogue: 0,0:05:46.68,0:05:48.02,JP,,0000,0000,0000,,Анко да тәртіпсіз.
Dialogue: 0,0:05:48.41,0:05:49.42,JP,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:05:54.73,0:05:55.61,JP,,0000,0000,0000,,(Каишо) Қорықпа—ағамның қаны менікімен бірдей қасиетке ие емес.
Dialogue: 0,0:05:56.55,0:05:57.99,JP,,0000,0000,0000,,Ертең бәріне көрсетейік
Dialogue: 0,0:06:00.68,0:06:07.00,JP,,0000,0000,0000,,Жоғарғы? Клиенттер жеткілікті жылы емес, бірақ бұл жақсы. Өтінемін, алға.
Dialogue: 0,0:06:07.65,0:06:09.97,JP,,0000,0000,0000,,Мочизо Жақсысың ба? өтінемін
Dialogue: 0,0:06:10.81,0:06:12.51,JP,,0000,0000,0000,,Иә, қызба төмендеді.
Dialogue: 0,0:06:13.13,0:06:16.87,JP,,0000,0000,0000,,Мен көремін. Сіз фильмді түсіруді аяқтадыңыз ба? өтінемін
Dialogue: 0,0:06:17.27,0:06:19.22,JP,,0000,0000,0000,,Сағат мұнарасынан құлау ғана қалды.
Dialogue: 0,0:06:19.22,0:06:20.48,JP,,0000,0000,0000,,А, сағат мұнарасы?
Dialogue: 0,0:06:22.17,0:06:23.75,JP,,0000,0000,0000,,Хариботе...
Dialogue: 0,0:06:24.69,0:06:26.51,JP,,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:06:26.86,0:06:29.62,JP,,0000,0000,0000,,Мен нағыз биік нәрседен құлап жатырмын деп ойладым.
Dialogue: 0,0:06:29.69,0:06:30.52,JP,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:06:31.03,0:06:35.38,JP,,0000,0000,0000,,Дұрыс. Биыл да эстафеталық клубтың камерасын алатыныңызға сенімдімін. өтінемін
Dialogue: 0,0:06:36.23,0:06:38.84,JP,,0000,0000,0000,,Мен жұмыртқаны аламын.
Dialogue: 0,0:06:37.86,0:06:38.82,JP,,0000,0000,0000,,Жақсы
Dialogue: 0,0:06:39.12,0:06:40.33,JP,,0000,0000,0000,,Мен оны асыға күтемін.
Dialogue: 0,0:06:40.94,0:06:43.92,JP,,0000,0000,0000,,Мидори-чанның биылғы хореографиясы, өтінемін.
Dialogue: 0,0:06:44.50,0:06:47.25,JP,,0000,0000,0000,,Токива? Сіз мұны істей алмайсыз ба? өтінемін
Dialogue: 0,0:06:47.90,0:06:49.97,JP,,0000,0000,0000,,Әрине, бұл Мидори-чан.
Dialogue: 0,0:07:04.02,0:07:07.07,JP,,0000,0000,0000,,Ауырды, ауырады...
Dialogue: 0,0:07:15.64,0:07:18.34,JP,,0000,0000,0000,,Менің ойыма ештеңе келмейді
Dialogue: 0,0:07:19.45,0:07:21.70,JP,,0000,0000,0000,,Ей, сен қалай ойлайсың, Сенпай?
Dialogue: 0,0:07:21.99,0:07:24.75,JP,,0000,0000,0000,,Тамако-чан авангардтың бір түрі, солай емес пе?
Dialogue: 0,0:07:24.75,0:07:25.97,JP,,0000,0000,0000,,Сіз шабуыл жасап жатырсыз, солай емес пе?
Dialogue: 0,0:07:26.04,0:07:27.16,JP,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:07:27.53,0:07:29.16,JP,,0000,0000,0000,,Мен де жақсы деп ойладым.
Dialogue: 0,0:07:30.13,0:07:31.52,JP,,0000,0000,0000,,Бұл менің ойым
Dialogue: 0,0:07:32.58,0:07:34.89,JP,,0000,0000,0000,,Хореографиядан басқа, тіпті костюм дизайны
Dialogue: 0,0:07:35.07,0:07:37.75,JP,,0000,0000,0000,,Сіз мінуге келгеніңізде, мен бұл туралы ойладым.
Dialogue: 0,0:07:37.81,0:07:40.10,JP,,0000,0000,0000,,Сіз оны хореографияға сәйкес етіп жасадыңыз ба?
Dialogue: 0,0:07:41.31,0:07:43.62,JP,,0000,0000,0000,,Иә, комбинация түрі.
Dialogue: 0,0:07:44.08,0:07:45.63,JP,,0000,0000,0000,,Ғажайып Мидори-чан
Dialogue: 0,0:07:46.57,0:07:48.45,JP,,0000,0000,0000,,Аа, жоқ
Dialogue: 0,0:07:51.38,0:07:52.96,JP,,0000,0000,0000,,Костюм де осымен шешіледі.
Dialogue: 0,0:07:53.19,0:07:53.80,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:07:56.99,0:07:57.62,JP,,0000,0000,0000,,Ерте
Dialogue: 0,0:07:57.74,0:07:58.55,JP,,0000,0000,0000,,Қалыпты
Dialogue: 0,0:07:58.81,0:08:02.14,JP,,0000,0000,0000,,Бұл жылдам. Бұл шынымен жылдам. Сен жақсысың.
Dialogue: 0,0:08:02.52,0:08:05.57,JP,,0000,0000,0000,,Чой мырзаның қолөнерге деген талғамы бар.
Dialogue: 0,0:08:07.10,0:08:07.93,JP,,0000,0000,0000,,Жеңіске тұрып қошемет!
Dialogue: 0,0:08:10.92,0:08:12.41,JP,,0000,0000,0000,,Өте жақсы емес
Dialogue: 0,0:08:12.62,0:08:14.27,JP,,0000,0000,0000,,Өйткені ол сананы тыныштандырады.
Dialogue: 0,0:08:15.99,0:08:19.33,JP,,0000,0000,0000,,Сіз тынышталасыз ба? Жарайды демейсің бе?
Dialogue: 0,0:08:20.66,0:08:24.00,JP,,0000,0000,0000,,Инені жабыңыз және жіпті тартыңыз
Dialogue: 0,0:08:24.72,0:08:27.40,JP,,0000,0000,0000,,Инені салып, жіпті тартыңыз
Dialogue: 0,0:08:27.94,0:08:29.52,JP,,0000,0000,0000,,Менің ақыл-ойым анық және анық болады
Dialogue: 0,0:08:30.34,0:08:33.87,JP,,0000,0000,0000,,Күріш торттарын орап жатқанда менде де солай болуы мүмкін.
Dialogue: 0,0:08:34.46,0:08:37.87,JP,,0000,0000,0000,,Менің жүрегім тазарып, Делла маған әкелетін болашақты көремін.
Dialogue: 0,0:08:38.32,0:08:43.94,JP,,0000,0000,0000,,Чой мырза көрсеткен болашақтың бейнесі 98% дәлдікпен мақтана алады.
Dialogue: 0,0:08:44.16,0:08:45.73,JP,,0000,0000,0000,,Чой Чан, сен кереметсің.
Dialogue: 0,0:08:45.73,0:08:48.05,JP,,0000,0000,0000,,Досым, бұл мен болуым керек.
Dialogue: 0,0:08:46.77,0:08:49.28,JP,,0000,0000,0000,,Шетіне жеткен шебердей.
Dialogue: 0,0:08:50.04,0:08:52.46,JP,,0000,0000,0000,,Бірақ бізде әлі көп жол бар
Dialogue: 0,0:08:53.07,0:08:54.82,JP,,0000,0000,0000,,Ол соншалықты жылдам және шебер болса да?
Dialogue: 0,0:08:55.78,0:09:02.22,JP,,0000,0000,0000,,Менің арманым - жақсырақ болып, ханзаданың әйеліне той костюмдерін жасау.
Dialogue: 0,0:09:02.98,0:09:03.69,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:09:04.54,0:09:09.08,JP,,0000,0000,0000,,Ханзада да, патшайым да Чой-чан соларға жасап берсе қуанар еді.
Dialogue: 0,0:09:12.79,0:09:13.89,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,0:09:18.61,0:09:20.51,JP,,0000,0000,0000,,Мен мұны біраздан бері сұрайын деп жүр едім...
Dialogue: 0,0:09:21.71,0:09:23.58,JP,,0000,0000,0000,,Кешіріңіз, сәл кейінірек.
Dialogue: 0,0:09:23.95,0:09:24.86,JP,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:09:26.38,0:09:27.69,JP,,0000,0000,0000,,Не болды, Чойчан?
Dialogue: 0,0:09:32.79,0:09:34.69,JP,,0000,0000,0000,,Қалайсың деп қызық болдым.
Dialogue: 0,0:09:36.85,0:09:40.86,JP,,0000,0000,0000,,Е, бәрі жақсы болып жатыр, Чой-чан? Жақсы.
Dialogue: 0,0:09:41.72,0:09:44.63,JP,,0000,0000,0000,,Осы жолмен? Мұнда да біраз
Dialogue: 0,0:09:45.92,0:09:47.12,JP,,0000,0000,0000,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:09:50.05,0:09:51.38,JP,,0000,0000,0000,,Мүмкін сәл көбірек
Dialogue: 0,0:09:51.80,0:09:53.30,JP,,0000,0000,0000,,Мм...иә, кездескенше.
Dialogue: 0,0:09:56.88,0:09:59.81,JP,,0000,0000,0000,,Одан әрі ойыма келе алмаймын.
Dialogue: 0,0:10:00.93,0:10:01.47,JP,,0000,0000,0000,,Осы жерден айналып өтейік…
Dialogue: 0,0:10:09.11,0:10:10.27,JP,,0000,0000,0000,,Бұл таңқаларлық
Dialogue: 0,0:10:10.27,0:10:10.80,JP,,0000,0000,0000,,Қызымнан күткенімдей.
Dialogue: 0,0:10:10.80,0:10:11.99,JP,,0000,0000,0000,,Сіз оны ауыстыра аласыз.
Dialogue: 0,0:10:12.14,0:10:12.94,JP,,0000,0000,0000,,О, жасайық.
Dialogue: 0,0:10:12.94,0:10:13.82,JP,,0000,0000,0000,,Қайсысы жақсы?
Dialogue: 0,0:10:14.37,0:10:15.55,JP,,0000,0000,0000,,Мынау немесе мынау қайсысы?
Dialogue: 0,0:10:17.64,0:10:19.62,JP,,0000,0000,0000,,Қызық, Тама-чан екеуміз үйге бара жатырмыз ба?
Dialogue: 0,0:10:19.80,0:10:21.40,JP,,0000,0000,0000,,Жоқ, мен бүгін тоқтамаймын.
Dialogue: 0,0:10:22.01,0:10:23.30,JP,,0000,0000,0000,,Бұл әдеттен тыс
Dialogue: 0,0:10:23.49,0:10:24.18,JP,,0000,0000,0000,,Менің ойымша, солай
Dialogue: 0,0:10:24.45,0:10:27.73,JP,,0000,0000,0000,,Олай болса, бүгін сиқырлы таяқ алғыңыз келе ме?
Dialogue: 0,0:10:28.14,0:10:31.54,JP,,0000,0000,0000,,Немесе жинақы немесе қалталы ақша...
Dialogue: 0,0:10:31.54,0:10:32.83,JP,,0000,0000,0000,,Бұл қайыр сұрау емес.
Dialogue: 0,0:10:32.98,0:10:34.22,JP,,0000,0000,0000,,(Беатриса) Ол кітап бөлмеге кіріп кеткен жәндіктерден қалай құтылу керектігін айтып бере ме екен?
Dialogue: 0,0:10:34.60,0:10:35.49,JP,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:10:39.33,0:10:42.11,JP,,0000,0000,0000,,Ең бірінші кешірім сұрау керек пе?
Dialogue: 0,0:10:44.41,0:10:45.37,JP,,0000,0000,0000,,Бұл ұрыс емес.
Dialogue: 0,0:10:45.62,0:10:48.02,JP,,0000,0000,0000,,Иә, тағы да кешіріңіз.
Dialogue: 0,0:10:51.18,0:10:51.73,JP,,0000,0000,0000,,Қайтару
Dialogue: 0,0:10:51.91,0:10:53.72,JP,,0000,0000,0000,,А, солай ма... о?
Dialogue: 0,0:10:54.74,0:10:59.57,JP,,0000,0000,0000,,Идея Идея Идея...
Dialogue: 0,0:11:10.63,0:11:12.38,JP,,0000,0000,0000,,Біраз идеяларды ортаға салайық
Dialogue: 0,0:11:20.39,0:11:21.41,JP,,0000,0000,0000,,Осындай нәрсе
Dialogue: 0,0:11:22.66,0:11:23.67,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:11:24.39,0:11:25.55,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:11:31.34,0:11:35.82,JP,,0000,0000,0000,,Музыка тек дыбыстардан тұрады деп ойласаңыз, қателесесіз.
Dialogue: 0,0:11:37.18,0:11:40.46,JP,,0000,0000,0000,,Үнсіздік те музыканың бір бөлігі
Dialogue: 0,0:11:45.28,0:11:47.32,JP,,0000,0000,0000,,Бұл менің асықпауым керек дегенді білдіре ме?
Dialogue: 0,0:11:48.88,0:11:50.25,JP,,0000,0000,0000,,Бұл сізге ұқсайды ма?
Dialogue: 0,0:12:06.29,0:12:09.30,JP,,0000,0000,0000,,А, қызық, неге келмедің?
Dialogue: 0,0:12:09.77,0:12:12.17,JP,,0000,0000,0000,,Сіз асығыс болған сияқтысыз.
Dialogue: 0,0:12:13.68,0:12:14.88,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,0:12:15.27,0:12:18.21,JP,,0000,0000,0000,,Мидори-чан, телефон қоңырауы да біртүрлі болды.
Dialogue: 0,0:12:21.88,0:12:23.79,JP,,0000,0000,0000,,Бұл стресс
Dialogue: 0,0:12:24.51,0:12:25.08,JP,,0000,0000,0000,,Не?
Dialogue: 0,0:12:25.79,0:12:27.72,JP,,0000,0000,0000,,Басшының ауыр жауапкершілігін көтере алмау
Dialogue: 0,0:12:29.52,0:12:31.90,JP,,0000,0000,0000,,Дәлел - сенің ойың жоқ екенің.
Dialogue: 0,0:12:32.57,0:12:34.45,JP,,0000,0000,0000,,Бұл төмендей ме?
Dialogue: 0,0:12:38.08,0:12:39.11,JP,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:47.37,0:12:49.92,JP,,0000,0000,0000,,Жоқ, артық емес
Dialogue: 0,0:12:51.72,0:12:52.35,JP,,0000,0000,0000,,No
Dialogue: 0,0:12:53.66,0:12:55.22,JP,,0000,0000,0000,,Мен емес
Dialogue: 0,0:12:56.86,0:13:00.70,JP,,0000,0000,0000,,Маған бірдеңе беріңіз...
Dialogue: 0,0:13:05.13,0:13:06.90,JP,,0000,0000,0000,,Жоқ, бетбелгі
Dialogue: 0,0:13:08.58,0:13:09.24,JP,,0000,0000,0000,,Джейн
Dialogue: 0,0:13:20.62,0:13:21.67,JP,,0000,0000,0000,,Бұл дәмді.
Dialogue: 0,0:13:23.88,0:13:25.34,JP,,0000,0000,0000,,Мидори-чан көрінбеді
Dialogue: 0,0:13:25.48,0:13:27.37,JP,,0000,0000,0000,,Жарайды, мен шығамын ба деп.
Dialogue: 0,0:13:28.17,0:13:29.04,JP,,0000,0000,0000,,Бұл көп орын.
Dialogue: 0,0:13:30.75,0:13:34.17,JP,,0000,0000,0000,,Бұл Мидори-чан туралы, сондықтан оның жұмысы жақсы.
Dialogue: 0,0:13:34.66,0:13:35.49,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:36.33,0:13:37.78,JP,,0000,0000,0000,,Қанна-чан да істейік
Dialogue: 0,0:13:38.45,0:13:40.05,JP,,0000,0000,0000,,Не?
Dialogue: 0,0:13:40.52,0:13:43.17,JP,,0000,0000,0000,,Менің саясатым - тонкацу үшін жеңіл заттар болмау.
Dialogue: 0,0:13:43.86,0:13:45.20,JP,,0000,0000,0000,,Уайымдамаңыз
Dialogue: 0,0:13:45.88,0:13:46.68,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:13:46.97,0:13:48.55,JP,,0000,0000,0000,,Ах Шио-чан Шиори-сан
Dialogue: 0,0:13:49.96,0:13:51.61,JP,,0000,0000,0000,,Иә, мен үйдемін.
Dialogue: 0,0:13:53.96,0:13:55.25,JP,,0000,0000,0000,,Сәтсіздік үшін кешіріңіз.
Dialogue: 0,0:13:55.32,0:13:56.24,JP,,0000,0000,0000,,Бұл дөрекі қоңыр, бірақ
Dialogue: 0,0:13:56.53,0:13:58.49,JP,,0000,0000,0000,,Мм, мен бүгін бір тапсырманы орындаймын.
Dialogue: 0,0:13:58.88,0:14:00.17,JP,,0000,0000,0000,,Кешіріңіз, бұл асығыс болды ма?
Dialogue: 0,0:14:00.25,0:14:01.15,JP,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:14:01.29,0:14:02.92,JP,,0000,0000,0000,,Ал, шәй ішейік.
Dialogue: 0,0:14:03.13,0:14:03.98,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:14:04.50,0:14:05.96,JP,,0000,0000,0000,,Ол таяқша бөлігі.
Dialogue: 0,0:14:06.10,0:14:07.78,JP,,0000,0000,0000,,Иә, мектеп мерекесіне.
Dialogue: 0,0:14:08.14,0:14:09.17,JP,,0000,0000,0000,,Бұл әдемі.
Dialogue: 0,0:14:09.27,0:14:11.52,JP,,0000,0000,0000,,Менің ойымша, бұл Мидори-чанның дизайны.
Dialogue: 0,0:14:11.92,0:14:14.09,JP,,0000,0000,0000,,Ой, жасыл әлі келген жоқ.
Dialogue: 0,0:14:14.27,0:14:16.05,JP,,0000,0000,0000,,Иә, мен сізбен байланыса алмаймын.
Dialogue: 0,0:14:18.27,0:14:19.29,JP,,0000,0000,0000,,Не болды, Шио-чан?
Dialogue: 0,0:14:20.03,0:14:21.64,JP,,0000,0000,0000,,Кеше дәретханада
Dialogue: 0,0:14:24.55,0:14:26.50,JP,,0000,0000,0000,,Аа, солай болды.
Dialogue: 0,0:14:27.56,0:14:30.19,JP,,0000,0000,0000,,Шиори-сан да науаға барады.
Dialogue: 0,0:14:31.12,0:14:33.78,JP,,0000,0000,0000,,Шио Чан мырза жуынатын бөлмеге бара жатыр.
Dialogue: 0,0:14:41.26,0:14:41.70,JP,,0000,0000,0000,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:14:42.15,0:14:42.92,JP,,0000,0000,0000,,Қайырлы түн
Dialogue: 0,0:14:43.62,0:14:44.78,JP,,0000,0000,0000,,Сіз бірдеңе тыңдап жатырсыз ба?
Dialogue: 0,0:14:45.28,0:14:46.03,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:14:47.80,0:14:48.52,JP,,0000,0000,0000,,Мочи
Dialogue: 0,0:14:48.76,0:14:50.75,JP,,0000,0000,0000,,Балалар, тыңдамайсыңдар ма?
Dialogue: 0,0:14:51.31,0:14:52.57,JP,,0000,0000,0000,,Иә, мен естіген жоқпын.
Dialogue: 0,0:14:53.12,0:14:54.58,JP,,0000,0000,0000,,Менің қызуым көтеріліп, демалысқа шығуға тура келді.
Dialogue: 0,0:14:54.81,0:14:56.10,JP,,0000,0000,0000,,Е безгегі
Dialogue: 0,0:14:56.17,0:14:56.76,JP,,0000,0000,0000,,Суық
Dialogue: 0,0:14:58.08,0:14:59.16,JP,,0000,0000,0000,,Жылу және басқа заттар
Dialogue: 0,0:15:01.81,0:15:04.01,JP,,0000,0000,0000,,Кешіріңіз, мен сізге бірден айтуым керек еді.
Dialogue: 0,0:15:04.22,0:15:06.08,JP,,0000,0000,0000,,Уайымдама, Шио-чан
Dialogue: 0,0:15:06.42,0:15:08.35,JP,,0000,0000,0000,,Мидори-чан жақсы болады.
Dialogue: 0,0:15:08.69,0:15:10.23,JP,,0000,0000,0000,,Мен маме дайфуку әкелдім.
Dialogue: 0,0:15:10.47,0:15:12.90,JP,,0000,0000,0000,,Дене қызуыңыз көтеріліп тұрса да, мұны жеуге болады.
Dialogue: 0,0:15:20.37,0:15:21.20,JP,,0000,0000,0000,,Жақсы
Dialogue: 0,0:15:28.17,0:15:29.46,JP,,0000,0000,0000,,Кешіріңіз, ештеңе жоқ.
Dialogue: 0,0:15:29.46,0:15:30.50,JP,,0000,0000,0000,,It's okay.
Dialogue: 0,0:15:30.83,0:15:32.29,JP,,0000,0000,0000,,Сізге кенеттен кіріп кеткенім үшін кешіріңіз.
Dialogue: 0,0:15:32.29,0:15:33.59,JP,,0000,0000,0000,,Жоқ рахмет.
Dialogue: 0,0:15:34.02,0:15:35.07,JP,,0000,0000,0000,,Чой Чан ше?
Dialogue: 0,0:15:35.20,0:15:38.24,JP,,0000,0000,0000,,Теледидар көріп отырмын, Кең шоуда қалып қойдым.
Dialogue: 0,0:15:38.75,0:15:39.86,JP,,0000,0000,0000,,Дене қызуыңыз төмендеді ме?
Dialogue: 0,0:15:40.05,0:15:42.72,JP,,0000,0000,0000,,Иә, таңертең ғана қызуым көтерілді.
Dialogue: 0,0:15:42.96,0:15:44.50,JP,,0000,0000,0000,,Күріш торт же, күріш торт же
Dialogue: 0,0:15:45.28,0:15:47.28,JP,,0000,0000,0000,,Иә, же, Мидори-чан.
Dialogue: 0,0:15:47.60,0:15:48.06,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:15:51.05,0:15:51.69,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:15:54.74,0:15:57.38,JP,,0000,0000,0000,,Кәдімгі энергияң не болды, қыз?
Dialogue: 0,0:15:57.53,0:15:58.76,JP,,0000,0000,0000,,Тұзды емес пе?
Dialogue: 0,0:16:00.24,0:16:01.63,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:16:01.72,0:16:03.25,JP,,0000,0000,0000,,Сізде әлі де қызба бар ма?
Dialogue: 0,0:16:04.23,0:16:07.23,JP,,0000,0000,0000,,Жоқ, шынымен бірдеңе болды.
Dialogue: 0,0:16:07.95,0:16:11.63,JP,,0000,0000,0000,,Оның дәретханадағы әңгімеге қатысы бар ма?
Dialogue: 0,0:16:12.19,0:16:12.70,JP,,0000,0000,0000,,Планер
Dialogue: 0,0:16:14.14,0:16:14.72,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:16:15.35,0:16:19.23,JP,,0000,0000,0000,,Жуынатын бөлмеде Мидоридің бірдеңе айтқанын естідім.
Dialogue: 0,0:16:19.80,0:16:20.84,JP,,0000,0000,0000,,Бұл басқаша.
Dialogue: 0,0:16:20.94,0:16:24.68,JP,,0000,0000,0000,,Плюс Бұл не?
Dialogue: 0,0:16:24.82,0:16:25.34,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:16:32.99,0:16:33.76,JP,,0000,0000,0000,,Мидори-чан
Dialogue: 0,0:16:33.76,0:16:34.63,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:16:37.51,0:16:42.47,JP,,0000,0000,0000,,Кешіріңіз, мен мектеп фестиваліне арналған хореографияны ойлап таба алмаймын.
Dialogue: 0,0:16:44.64,0:16:47.99,JP,,0000,0000,0000,,Мен енді ештеңе ойлай алмаймын.
Dialogue: 0,0:16:49.70,0:16:51.12,JP,,0000,0000,0000,,Рас Мүлдем емес
Dialogue: 0,0:16:52.25,0:16:56.47,JP,,0000,0000,0000,,Мұның бәрі жақсы емес, дәлірек айтсақ, бұл жақсы емес.
Dialogue: 0,0:16:59.86,0:17:03.30,JP,,0000,0000,0000,,Бұл менмін, сен маған қалдырдың.
Dialogue: 0,0:17:03.62,0:17:05.08,JP,,0000,0000,0000,,Мидори-чан қызы
Dialogue: 0,0:17:07.71,0:17:08.28,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:17:09.34,0:17:10.15,JP,,0000,0000,0000,,Не?
Dialogue: 0,0:17:10.29,0:17:10.95,JP,,0000,0000,0000,,Не керек, Крюгер мырза?
Dialogue: 0,0:17:11.40,0:17:12.68,JP,,0000,0000,0000,,Шығып жатыр.
Dialogue: 0,0:17:12.99,0:17:14.09,JP,,0000,0000,0000,,О, бұл
Dialogue: 0,0:17:15.52,0:17:17.39,JP,,0000,0000,0000,,Бұл ерекше ештеңе емес.
Dialogue: 0,0:17:19.21,0:17:19.92,JP,,0000,0000,0000,,Мен жыламаймын
Dialogue: 0,0:17:19.92,0:17:20.87,JP,,0000,0000,0000,,Сіздің асыл жүзіңіз
Dialogue: 0,0:17:26.67,0:17:27.66,JP,,0000,0000,0000,,Мидори-чан
Dialogue: 0,0:17:28.80,0:17:30.41,JP,,0000,0000,0000,,Кешіріңіз, байқамадым.
Dialogue: 0,0:17:31.14,0:17:31.79,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:17:34.22,0:17:36.81,JP,,0000,0000,0000,,Мен сізге жағымсыз бөлігін көрсете алмаймын.
Dialogue: 0,0:17:37.80,0:17:39.98,JP,,0000,0000,0000,,Бұл жерде тамаша ештеңе жоқ
Dialogue: 0,0:17:43.34,0:17:44.12,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:17:44.15,0:17:45.33,JP,,0000,0000,0000,,Мидори-чан
Dialogue: 0,0:17:44.12,0:17:45.78,JP,,0000,0000,0000,,Шио-чан Жақсы көмекші
Dialogue: 0,0:17:46.50,0:17:47.73,JP,,0000,0000,0000,,Иә Чин
Dialogue: 0,0:17:50.11,0:17:50.86,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:17:51.65,0:17:52.39,JP,,0000,0000,0000,,Ақымақ
Dialogue: 0,0:17:53.16,0:17:55.06,JP,,0000,0000,0000,,Сізді не уайымдады?
Dialogue: 0,0:17:55.74,0:17:56.89,JP,,0000,0000,0000,,Би дегеніміз не?
Dialogue: 0,0:17:57.26,0:17:57.95,JP,,0000,0000,0000,,Құдайға
Dialogue: 0,0:17:58.16,0:17:58.79,JP,,0000,0000,0000,,Достарға
Dialogue: 0,0:17:58.82,0:17:59.85,JP,,0000,0000,0000,,Әрине
Dialogue: 0,0:18:00.28,0:18:01.83,JP,,0000,0000,0000,,Алғыс пен қуаныш сезімін білдіреді.
Dialogue: 0,0:18:02.22,0:18:05.89,JP,,0000,0000,0000,,Би сіздің денеңіздің табиғи түрде қозғалуы, ол туралы ойлаған кезде емес.
Dialogue: 0,0:18:06.36,0:18:11.13,JP,,0000,0000,0000,,Менің және мені мадақтаған тамаша биімді қараңыз.
Dialogue: 0,0:18:09.36,0:18:11.00,JP,,0000,0000,0000,,Құдай қайда кетті?
Dialogue: 0,0:18:22.42,0:18:23.48,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:18:26.97,0:18:28.49,JP,,0000,0000,0000,,Шиори мырзаны алдап кетті
Dialogue: 0,0:18:28.86,0:18:30.56,JP,,0000,0000,0000,,Бұл өте қызық, Делла-чан.
Dialogue: 0,0:18:31.23,0:18:32.84,JP,,0000,0000,0000,,Қызықты болуы күтпеген жағдай.
Dialogue: 0,0:18:31.94,0:18:34.59,JP,,0000,0000,0000,,Мырза, маған көмектесіңізші.
Dialogue: 0,0:18:35.18,0:18:37.37,JP,,0000,0000,0000,,Керек болса, ұялмас едім.
Dialogue: 0,0:18:39.67,0:18:40.63,JP,,0000,0000,0000,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:18:40.63,0:18:41.74,JP,,0000,0000,0000,,Неге күлесің?
Dialogue: 0,0:18:42.60,0:18:45.80,JP,,0000,0000,0000,,Бірақ қызым, өзіңді жақсы сезінесің бе?
Dialogue: 0,0:18:46.43,0:18:48.46,JP,,0000,0000,0000,,Керемет, Делла-чан билеп жатыр.
Dialogue: 0,0:18:49.18,0:18:50.13,JP,,0000,0000,0000,,Мен билеп жатырмын
Dialogue: 0,0:18:52.20,0:18:52.98,JP,,0000,0000,0000,,Мидори-чан
Dialogue: 0,0:18:53.24,0:18:54.01,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:18:54.38,0:18:56.92,JP,,0000,0000,0000,,Хореографияға келгенде, бәрі бірге ойлану керек.
Dialogue: 0,0:18:58.38,0:18:59.30,JP,,0000,0000,0000,,Не болды, мырза Мокки!
Dialogue: 0,0:19:00.22,0:19:02.55,JP,,0000,0000,0000,,Менеджерлер өз мүшелеріне қатал.
Dialogue: 0,0:19:03.81,0:19:04.29,JP,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:19:07.93,0:19:09.16,JP,,0000,0000,0000,,Барлығыңызға рахмет
Dialogue: 0,0:19:10.78,0:19:12.27,JP,,0000,0000,0000,,Бұл қайтадан келеді
Dialogue: 0,0:19:12.42,0:19:13.45,JP,,0000,0000,0000,,Ол келмеді.
Dialogue: 0,0:19:13.59,0:19:14.62,JP,,0000,0000,0000,,Crybaby-san
Dialogue: 0,0:19:14.68,0:19:15.86,JP,,0000,0000,0000,,Қараңызшы, шықты.
Dialogue: 0,0:19:16.43,0:19:17.65,JP,,0000,0000,0000,,қытық
Dialogue: 0,0:19:37.69,0:19:39.22,JP,,0000,0000,0000,,Әйтеуір уақытында үлгердің.
Dialogue: 0,0:19:39.22,0:19:40.12,JP,,0000,0000,0000,,Жақсы
Dialogue: 0,0:19:40.12,0:19:41.37,JP,,0000,0000,0000,,Сіз тамаша жұмыс жасадыңыз
Dialogue: 0,0:19:41.37,0:19:41.87,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:19:42.82,0:19:45.27,JP,,0000,0000,0000,,Жарайды, орындалды, қалай?
Dialogue: 0,0:19:45.27,0:19:47.19,JP,,0000,0000,0000,,Жоқ, Тамако сүйкімді
Dialogue: 0,0:19:46.51,0:19:47.19,JP,,0000,0000,0000,,Пречи
Dialogue: 0,0:19:47.19,0:19:47.71,JP,,0000,0000,0000,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:19:48.42,0:19:49.11,JP,,0000,0000,0000,,Бұл Чой Чан.
Dialogue: 0,0:19:49.76,0:19:51.03,JP,,0000,0000,0000,,Чой-чан Делла-чан
Dialogue: 0,0:19:51.42,0:19:52.93,JP,,0000,0000,0000,,Чой-чан, костюм үшін рахмет
Dialogue: 0,0:19:51.82,0:19:54.09,JP,,0000,0000,0000,,Мына сүйкімді қыз қандай?
Dialogue: 0,0:19:52.93,0:19:54.09,JP,,0000,0000,0000,,Ол келді.
Dialogue: 0,0:19:54.24,0:19:55.00,JP,,0000,0000,0000,,Бұл Чой Чан
Dialogue: 0,0:19:55.59,0:19:56.56,JP,,0000,0000,0000,,Оны түртуге болады.
Dialogue: 0,0:19:56.85,0:19:58.18,JP,,0000,0000,0000,,Бұта емес
Dialogue: 0,0:19:55.88,0:19:57.81,JP,,0000,0000,0000,,Директор Мидо Чан, бұл бір орын.
Dialogue: 0,0:19:59.83,0:20:03.07,JP,,0000,0000,0000,,Жарайсыңдар, барлығымыз шеңбер құрайық.
Dialogue: 0,0:20:03.07,0:20:03.58,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:20:03.58,0:20:04.29,JP,,0000,0000,0000,,Шеңбер?
Dialogue: 0,0:20:04.29,0:20:06.24,JP,,0000,0000,0000,,Чой-чан да эстафета клубының мүшесі.
Dialogue: 0,0:20:07.17,0:20:08.09,JP,,0000,0000,0000,,Мен де?
Dialogue: 0,0:20:08.76,0:20:09.25,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:20:11.88,0:20:12.90,JP,,0000,0000,0000,,Неге тым кеш дейсің?
Dialogue: 0,0:20:11.61,0:20:16.62,JP,,0000,0000,0000,,Олай болса, тасымалдаушы ретінде біз үшін не маңызды екенін бәріміз айғайлап алайық.
Dialogue: 0,0:20:17.22,0:20:17.77,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:20:17.85,0:20:18.22,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:20:18.22,0:20:19.06,JP,,0000,0000,0000,,Түсінікті!
Dialogue: 0,0:20:19.94,0:20:21.06,JP,,0000,0000,0000,,Көшіру, көшіру, көшіру
Dialogue: 0,0:20:23.11,0:20:26.82,JP,,0000,0000,0000,,Міне.
Dialogue: 0,0:20:27.31,0:20:30.80,JP,,0000,0000,0000,,Аю Мочи Тік бұрышы Шиба Ину Маған ханзада айтып жатыр
Dialogue: 0,0:20:30.80,0:20:31.95,JP,,0000,0000,0000,,Батон
Dialogue: 0,0:20:36.30,0:20:38.61,JP,,0000,0000,0000,,Аспан мен жүрек әдемі
Dialogue: 0,0:20:39.21,0:20:41.58,JP,,0000,0000,0000,,Күн шуақты сахнада шымылдық ашылады
Dialogue: 0,0:20:42.53,0:20:44.96,JP,,0000,0000,0000,,Baton Musume билей бастайды
Dialogue: 0,0:20:58.21,0:20:58.90,JP,,0000,0000,0000,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:21:05.16,0:21:10.31,JP,,0000,0000,0000,,Сейно Тамая
Dialogue: 0,0:21:16.96,0:21:19.77,JP,,0000,0000,0000,,Жоқ, жоқ, еңбегіңіз үшін рахмет, директор.
Dialogue: 0,0:21:19.96,0:21:21.93,JP,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:21:22.55,0:21:23.38,JP,,0000,0000,0000,,Үлкен жетістік?
Dialogue: 0,0:21:23.38,0:21:24.78,JP,,0000,0000,0000,,Сізге қалай ұнады, директор?
Dialogue: 0,0:21:25.77,0:21:26.49,JP,,0000,0000,0000,,Өту ұпайы?
Dialogue: 0,0:21:27.34,0:21:27.97,JP,,0000,0000,0000,,Қатаң
Dialogue: 0,0:21:27.97,0:21:28.89,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:21:29.63,0:21:30.21,JP,,0000,0000,0000,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:21:31.91,0:21:33.34,JP,,0000,0000,0000,,Өзін бақытты сезіну
Dialogue: 0,0:21:37.41,0:21:38.44,JP,,0000,0000,0000,,Бақытты
Dialogue: 0,0:21:41.19,0:21:41.69,JP,,0000,0000,0000,,Чой-чан
Dialogue: 0,0:21:42.69,0:21:45.35,JP,,0000,0000,0000,,Чой-чанды көрдіңіз бе? Қалай болды?
Dialogue: 0,0:21:45.49,0:21:46.35,JP,,0000,0000,0000,,Тамако-сама
Dialogue: 0,0:21:48.47,0:21:50.43,JP,,0000,0000,0000,,Сен ханзаданың әйелісің.
Dialogue: 0,0:23:25.99,0:23:28.90,JP,,0000,0000,0000,,Дәмді жаңа күріш мезгілі. Бұл Тамако.
Dialogue: 0,0:23:29.35,0:23:32.96,JP,,0000,0000,0000,,Мен қай префектурада күріш торттарын көп тұтынатыны қызық болды, сондықтан мен оны іздедім.
Dialogue: 0,0:23:32.96,0:23:35.43,JP,,0000,0000,0000,,Бұл күткендей күріш өндіретін аймақ болды.
Dialogue: 0,0:23:35.97,0:23:39.08,JP,,0000,0000,0000,,Келесі жолы қандай күріш тортын жеуге болады?
Dialogue: 0,0:00:03.16,0:00:04.79,CN,,0000,0000,0000,,Бір университетке келгендердің барлығына.
Dialogue: 0,0:00:04.79,0:00:08.21,CN,,0000,0000,0000,,Алдағы мәдени фестивальдің сахналық қойылымын ұйымдастыру
Dialogue: 0,0:00:08.35,0:00:11.50,CN,,0000,0000,0000,,Әр компанияның бөлімшелерінің ұзақтығына арналған лотерея
Dialogue: 0,0:00:12.07,0:00:13.40,CN,,0000,0000,0000,,Кішкентай жасыл май
Dialogue: 0,0:00:13.62,0:00:16.00,CN,,0000,0000,0000,,Тек таңдау керек.
Dialogue: 0,0:00:16.21,0:00:18.08,CN,,0000,0000,0000,,мүмкін емес
Dialogue: 0,0:00:19.22,0:00:20.49,CN,,0000,0000,0000,,Нана мен кеттім
Dialogue: 0,0:00:20.49,0:00:22.04,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:23.48,0:00:25.67,CN,,0000,0000,0000,,Өткен жылы мен соңғы болып өнер көрсеттім.
Dialogue: 0,0:00:25.86,0:00:27.47,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:27.57,0:00:29.64,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:29.84,0:00:32.21,CN,,0000,0000,0000,,Кисараги Гакуджидің ұзақ ұтысына байланысты
Dialogue: 0,0:00:32.45,0:00:34.03,CN,,0000,0000,0000,,Мейрамханаға және басқа адамдардың мекемелеріне келу
Dialogue: 0,0:00:36.80,0:00:39.19,CN,,0000,0000,0000,,Ол жерге жетудің ең жылдам жолы - бейнені көру
Dialogue: 0,0:00:42.79,0:00:43.81,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:44.08,0:00:45.10,CN,,0000,0000,0000,,Әрине, мен ашуланамын — мен сонша…
Dialogue: 0,0:00:45.10,0:00:45.82,CN,,0000,0000,0000,,Коята ынталандырды
Dialogue: 0,0:00:45.82,0:00:47.60,CN,,0000,0000,0000,,Басқарма мүшесі ұзақ мерзімді қызметкер
Dialogue: 0,0:00:48.13,0:00:49.88,CN,,0000,0000,0000,,Би үйірмесі
Dialogue: 0,0:00:49.11,0:00:49.91,CN,,0000,0000,0000,,Кішкентай жасыл
Dialogue: 0,0:00:49.91,0:00:51.65,CN,,0000,0000,0000,,Бөлім ұзындығы сызбаға ұқсас
Dialogue: 0,0:00:52.04,0:00:53.14,CN,,0000,0000,0000,,Батыс аудан, Парк даңғылы, 128 үй
Dialogue: 0,0:00:58.62,0:01:03.80,CN,,0000,0000,0000,,Би үйірмесі алтын сағатқа 11 ұпайдан 11 жарым ұпайға жетті.
Dialogue: 0,0:01:04.31,0:01:05.60,CN,,0000,0000,0000,,Нағыз лотерея аяқталды
Dialogue: 0,0:01:06.34,0:01:07.65,CN,,0000,0000,0000,,Бөлімнің негізгі артықшылықтары
Dialogue: 0,0:01:07.65,0:01:08.88,CN,,0000,0000,0000,,Мен не білдім
Dialogue: 0,0:01:08.88,0:01:12.14,CN,,0000,0000,0000,,Толқу, күшті жел, қарқынды қозғалыс
Dialogue: 0,0:01:12.35,0:01:14.13,CN,,0000,0000,0000,,Адам жүрегінің мәдени фестивалі
Dialogue: 0,0:01:14.62,0:01:18.98,CN,,0000,0000,0000,,Көрме және тұрақты тренинг сабақтарының жетістіктері.
Dialogue: 0,0:02:52.31,0:02:57.35,CN,,0000,0000,0000,,Бұл ағымдағы көрме өтетін орын.
Dialogue: 0,0:02:57.89,0:02:59.86,CN,,0000,0000,0000,,Әңгімелесу мақсатын елестету.
Dialogue: 0,0:03:00.22,0:03:01.60,CN,,0000,0000,0000,,Саусақ таяқшасын көрсету құрылғысы
Dialogue: 0,0:03:02.20,0:03:03.03,CN,,0000,0000,0000,,Жаңа жылдық өрт қойылымы
Dialogue: 0,0:03:03.50,0:03:04.60,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:05.86,0:03:07.49,CN,,0000,0000,0000,,Өткен жылы орындалды.
Dialogue: 0,0:03:10.00,0:03:11.16,CN,,0000,0000,0000,,Жаңа жылдық өрт қойылымы
Dialogue: 0,0:03:12.52,0:03:15.49,CN,,0000,0000,0000,,Манабу Кисараги Йошиёши Хаяками
Dialogue: 0,0:03:15.77,0:03:17.13,CN,,0000,0000,0000,,Сізді көруге келгендегі менің жағдайым
Dialogue: 0,0:03:23.81,0:03:26.26,CN,,0000,0000,0000,,Өткен жылғы музыкалық секіру биі сиқырлы қойылым ретінде
Dialogue: 0,0:03:26.26,0:03:29.21,CN,,0000,0000,0000,,Уақыты келгенде кездесу болады деп күтеді.
Dialogue: 0,0:03:29.21,0:03:31.02,CN,,0000,0000,0000,,Сіз өз таңдауыңызды таңдайсыз.
Dialogue: 0,0:03:31.02,0:03:34.20,CN,,0000,0000,0000,,Биылғы шынайы шығарылым - сіз жасай алатын ең жақсы нәрсе.
Dialogue: 0,0:03:34.20,0:03:35.91,CN,,0000,0000,0000,,Маған би үйірмесін ойнауға рұқсат етілген.
Dialogue: 0,0:03:35.91,0:03:37.71,CN,,0000,0000,0000,,Энциклопедия
Dialogue: 0,0:03:37.88,0:03:40.06,CN,,0000,0000,0000,,Нана Мен былтыр сөйлесе алдым.
Dialogue: 0,0:03:40.16,0:03:41.03,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:41.03,0:03:42.08,CN,,0000,0000,0000,,Жаңа жылдық өрт қойылымы
Dialogue: 0,0:03:43.55,0:03:44.94,CN,,0000,0000,0000,,Әңгіменің шығу тегі мұнда емес.
Dialogue: 0,0:03:45.41,0:03:46.14,CN,,0000,0000,0000,,Шешім жоқ
Dialogue: 0,0:03:46.34,0:03:48.58,CN,,0000,0000,0000,,Алты жасар ер адамның баспалдақтары
Dialogue: 0,0:03:49.16,0:03:51.14,CN,,0000,0000,0000,,Баспалдақ аспандағы гүл табақпен кездеспейді.
Dialogue: 0,0:03:51.16,0:03:52.11,CN,,0000,0000,0000,,Тортты да жей алмай ма?
Dialogue: 0,0:03:47.02,0:03:50.59,CN,,0000,0000,0000,,Бұл кішкентай жасыл.
Dialogue: 0,0:03:52.93,0:03:54.21,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:54.21,0:03:55.13,CN,,0000,0000,0000,,Жауапкершіліктен бас тарту
Dialogue: 0,0:03:55.42,0:03:57.14,CN,,0000,0000,0000,,Мен бірінші таңдайтын адаммын.
Dialogue: 0,0:03:57.30,0:03:58.11,CN,,0000,0000,0000,,Негізгі тақырып?
Dialogue: 0,0:03:58.11,0:04:01.40,CN,,0000,0000,0000,,「Love」 「」
Dialogue: 0,0:04:01.40,0:04:03.15,CN,,0000,0000,0000,,「」
Dialogue: 0,0:04:03.41,0:04:05.17,CN,,0000,0000,0000,,Өмір сүрген жылдары
Dialogue: 0,0:04:05.28,0:04:08.10,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:08.21,0:04:11.64,CN,,0000,0000,0000,,Жиналыс аяқталғаннан кейін.
Dialogue: 0,0:04:11.78,0:04:14.83,CN,,0000,0000,0000,,Үйден шыққан соң атымды ақ жабысқақ күріш деп өзгерттім.
Dialogue: 0,0:04:15.34,0:04:17.39,CN,,0000,0000,0000,,Суда болып, түнде көбіктенгеннен кейін
Dialogue: 0,0:04:17.55,0:04:18.88,CN,,0000,0000,0000,,Желімделген күріш және басқа да буға пісірілген күріш
Dialogue: 0,0:04:18.88,0:04:20.04,CN,,0000,0000,0000,,Кодаманың нүктелері қызықты.
Dialogue: 0,0:04:20.21,0:04:22.71,CN,,0000,0000,0000,,Бумен пісіріп, қызған соң Усуриге жеттік.
Dialogue: 0,0:04:22.71,0:04:23.84,CN,,0000,0000,0000,,Йоки Райкацу
Dialogue: 0,0:04:25.95,0:04:27.45,CN,,0000,0000,0000,,Бұл бақытты аяқталады ма?
Dialogue: 0,0:04:27.45,0:04:28.51,CN,,0000,0000,0000,,Зена Каку
Dialogue: 0,0:04:27.86,0:04:29.16,CN,,0000,0000,0000,,Бұл өте маңызды
Dialogue: 0,0:04:29.16,0:04:30.34,CN,,0000,0000,0000,,Бағалау сезімі
Dialogue: 0,0:04:30.46,0:04:31.76,CN,,0000,0000,0000,,Ұқсас сандар
Dialogue: 0,0:04:31.86,0:04:32.60,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:04:32.75,0:04:35.11,CN,,0000,0000,0000,,Бұл жақсы идея емес.
Dialogue: 0,0:04:35.21,0:04:35.94,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:36.01,0:04:38.14,CN,,0000,0000,0000,,Мен оны көріп, жақсы тәжірибе аламын.
Dialogue: 0,0:04:38.98,0:04:40.04,CN,,0000,0000,0000,,Ақ жүректі мінез
Dialogue: 0,0:04:40.77,0:04:43.01,CN,,0000,0000,0000,,Нананың орындауы 50 минут
Dialogue: 0,0:04:43.11,0:04:46.31,CN,,0000,0000,0000,,Кішігірім техникалық әрекеттерді қосу.
Dialogue: 0,0:04:46.69,0:04:47.39,CN,,0000,0000,0000,,Негізгі мәселе...
Dialogue: 0,0:04:47.39,0:04:48.88,CN,,0000,0000,0000,,Тақырып көрсетілмеген
Dialogue: 0,0:04:48.92,0:04:52.39,CN,,0000,0000,0000,,Менің бөлімшенің ұзақтығы шағын және мен капиталымның келуін күтемін.
Dialogue: 0,0:04:53.13,0:04:55.86,CN,,0000,0000,0000,,Музыка музыкадан туындауы мүмкін.
Dialogue: 0,0:04:56.03,0:04:56.57,CN,,0000,0000,0000,,1-деңгей—тіпті танк те толықтай қауіпсіз сезілмейді.
Dialogue: 0,0:04:56.57,0:04:57.13,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:04:58.11,0:05:00.44,CN,,0000,0000,0000,,Ақиқат және ақиқат
Dialogue: 0,0:05:01.07,0:05:02.85,CN,,0000,0000,0000,,Киімдерді қайдан алуға болады
Dialogue: 0,0:05:03.15,0:05:06.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:06.01,0:05:08.48,CN,,0000,0000,0000,,Өзім анықтаған жоқпын
Dialogue: 0,0:05:08.57,0:05:09.58,CN,,0000,0000,0000,,Түсініктеме
Dialogue: 0,0:05:09.86,0:05:11.19,CN,,0000,0000,0000,,тым кеш.
Dialogue: 0,0:05:11.19,0:05:12.38,CN,,0000,0000,0000,,Әрине мүмкін
Dialogue: 0,0:05:12.49,0:05:13.64,CN,,0000,0000,0000,,Гая туралы естеліктер
Dialogue: 0,0:05:13.64,0:05:14.41,CN,,0000,0000,0000,,Мен де
Dialogue: 0,0:05:14.45,0:05:15.76,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:15.86,0:05:17.11,CN,,0000,0000,0000,,Қосайзе мәдени фестивалі
Dialogue: 0,0:05:17.36,0:05:18.22,CN,,0000,0000,0000,,Нана қайта қарау
Dialogue: 0,0:05:18.22,0:05:19.58,CN,,0000,0000,0000,,Үй иесінің қайғысын қайта қарау
Dialogue: 0,0:05:20.09,0:05:21.66,CN,,0000,0000,0000,,Би стилі туралы мәлімет
Dialogue: 0,0:05:22.20,0:05:23.65,CN,,0000,0000,0000,,Жаңа жыл Махаббат стилі Жаңа жыл отты орындау стилі
Dialogue: 0,0:05:24.58,0:05:25.54,CN,,0000,0000,0000,,Мәдени мереке?
Dialogue: 0,0:05:26.03,0:05:28.29,CN,,0000,0000,0000,,Өткен жылғы суретке назар аударыңыз
Dialogue: 0,0:05:28.71,0:05:30.09,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:30.09,0:05:31.49,CN,,0000,0000,0000,,Кешір
Dialogue: 0,0:05:32.36,0:05:33.86,CN,,0000,0000,0000,,Бұл мен үшін мәзір.
Dialogue: 0,0:05:35.37,0:05:37.03,CN,,0000,0000,0000,,Меншік лицензиясы
Dialogue: 0,0:05:37.16,0:05:39.69,CN,,0000,0000,0000,,Қоңырау үні аралас секіру биі
Dialogue: 0,0:05:40.09,0:05:43.80,CN,,0000,0000,0000,,Бұл әлемдегі ең әдемі секіруші биші.
Dialogue: 0,0:05:43.94,0:05:46.68,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:46.80,0:05:48.41,CN,,0000,0000,0000,,Мен сенімен танысамын, мен билеймін
Dialogue: 0,0:05:46.68,0:05:48.02,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:48.41,0:05:49.42,CN,,0000,0000,0000,,Барлығыңды өлтіреміз
Dialogue: 0,0:05:54.73,0:05:55.61,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:56.55,0:05:57.99,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:00.68,0:06:07.00,CN,,0000,0000,0000,,Содан бері қонақтардың бірінші саны өтті.
Dialogue: 0,0:06:07.65,0:06:09.97,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:10.81,0:06:12.51,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:13.13,0:06:16.87,CN,,0000,0000,0000,,Бұл бейне жазу аяқталды.
Dialogue: 0,0:06:17.27,0:06:19.22,CN,,0000,0000,0000,,Мұнараның басынан төменге дейінгі жолдың бір бөлігі
Dialogue: 0,0:06:19.22,0:06:20.48,CN,,0000,0000,0000,,?
Dialogue: 0,0:06:22.17,0:06:23.75,CN,,0000,0000,0000,,Бұл қағазды қоюға арналған құрал...
Dialogue: 0,0:06:24.69,0:06:26.51,CN,,0000,0000,0000,,Бір секіру
Dialogue: 0,0:06:26.86,0:06:29.62,CN,,0000,0000,0000,,Содан бері мен нағыз мұнараның басынан түстім.
Dialogue: 0,0:06:29.69,0:06:30.52,CN,,0000,0000,0000,,О тобы, сондай-ақ Балықтар белгісі.
Dialogue: 0,0:06:31.03,0:06:35.38,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:36.23,0:06:38.84,CN,,0000,0000,0000,,Соққы соғуы...
Dialogue: 0,0:06:37.86,0:06:38.82,CN,,0000,0000,0000,,Аняның үйіне қош келдіңіз
Dialogue: 0,0:06:39.12,0:06:40.33,CN,,0000,0000,0000,,Шынайы үміттер
Dialogue: 0,0:06:40.94,0:06:43.92,CN,,0000,0000,0000,,Биылғы би шағын ғана.
Dialogue: 0,0:06:44.50,0:06:47.25,CN,,0000,0000,0000,,Әрқашан?
Dialogue: 0,0:06:47.90,0:06:49.97,CN,,0000,0000,0000,,Әрине аз.
Dialogue: 0,0:07:04.02,0:07:07.07,CN,,0000,0000,0000,,Жақсы ауырсыну Жақсы ауырсыну ...
Dialogue: 0,0:07:15.64,0:07:18.34,CN,,0000,0000,0000,,Елестету мүмкін емес
Dialogue: 0,0:07:19.45,0:07:21.70,CN,,0000,0000,0000,,Мисс
Dialogue: 0,0:07:21.99,0:07:24.75,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:24.75,0:07:25.97,CN,,0000,0000,0000,,Өте батыл дизайн
Dialogue: 0,0:07:26.04,0:07:27.16,CN,,0000,0000,0000,,Бұлай емес
Dialogue: 0,0:07:27.53,0:07:29.16,CN,,0000,0000,0000,,Мен де оны бағалаймын.
Dialogue: 0,0:07:30.13,0:07:31.52,CN,,0000,0000,0000,,Мен оны елестете аламын.
Dialogue: 0,0:07:32.58,0:07:34.89,CN,,0000,0000,0000,,Костюм дизайнын жасау міндетті емес.
Dialogue: 0,0:07:35.07,0:07:37.75,CN,,0000,0000,0000,,Мен не ойладым, не ойладым деп ойлаймын.
Dialogue: 0,0:07:37.81,0:07:40.10,CN,,0000,0000,0000,,Бұл би мен безендірілген киімнің үйлесімі.
Dialogue: 0,0:07:41.31,0:07:43.62,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:44.08,0:07:45.63,CN,,0000,0000,0000,,Кішкентай жасыл шынайы зақым
Dialogue: 0,0:07:46.57,0:07:48.45,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:51.38,0:07:52.96,CN,,0000,0000,0000,,Киім таңдау аяқталды.
Dialogue: 0,0:07:53.19,0:07:53.80,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:07:56.99,0:07:57.62,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:07:57.74,0:07:58.55,CN,,0000,0000,0000,,Жалпы ақпарат
Dialogue: 0,0:07:58.81,0:08:02.14,CN,,0000,0000,0000,,Нағыз ләззат
Dialogue: 0,0:08:02.52,0:08:05.57,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:07.10,0:08:07.93,CN,,0000,0000,0000,,Нағыз сәтсіздік
Dialogue: 0,0:08:10.92,0:08:12.41,CN,,0000,0000,0000,,Өлім болмайды
Dialogue: 0,0:08:12.62,0:08:14.27,CN,,0000,0000,0000,,Тек сабырлы және жан тыныштығын сақтаңыз.
Dialogue: 0,0:08:15.99,0:08:19.33,CN,,0000,0000,0000,,Нохеи Шизука кездесусіз түсіп, маникальды қонаққа келеді.
Dialogue: 0,0:08:20.66,0:08:24.00,CN,,0000,0000,0000,,Бұрғылау сызығы
Dialogue: 0,0:08:24.72,0:08:27.40,CN,,0000,0000,0000,,Бұрғылау сызығы
Dialogue: 0,0:08:27.94,0:08:29.52,CN,,0000,0000,0000,,Тәкаппар дүниенің келуі
Dialogue: 0,0:08:30.34,0:08:33.87,CN,,0000,0000,0000,,Мен ұзақ уақыттың ортасындамын, менде әртүрлі сезімдер бар.
Dialogue: 0,0:08:34.46,0:08:37.87,CN,,0000,0000,0000,,Жан тыныштығы, байсалдылық және болашаққа деген көзқарас
Dialogue: 0,0:08:38.32,0:08:43.94,CN,,0000,0000,0000,,98%
Dialogue: 0,0:08:44.16,0:08:45.73,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:45.73,0:08:48.05,CN,,0000,0000,0000,,Бұл менмін.
Dialogue: 0,0:08:46.77,0:08:49.28,CN,,0000,0000,0000,,Аяқталған мүсінші
Dialogue: 0,0:08:50.04,0:08:52.46,CN,,0000,0000,0000,,Дегенмен, ұзақ жол қажет.
Dialogue: 0,0:08:53.07,0:08:54.82,CN,,0000,0000,0000,,Барғыңыз келсе, ала аласыз.
Dialogue: 0,0:08:55.78,0:09:02.22,CN,,0000,0000,0000,,Менің арманым - Гонконг патшайымының үйлену көйлегінің тұрақты ұсынысы.
Dialogue: 0,0:09:02.98,0:09:03.69,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:09:04.54,0:09:09.08,CN,,0000,0000,0000,,Той көйлегіндегі той көйлегі туралы әңгіме.
Dialogue: 0,0:09:12.79,0:09:13.89,CN,,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:09:18.61,0:09:20.51,CN,,0000,0000,0000,,Мен сұрамас бұрын...
Dialogue: 0,0:09:21.71,0:09:23.58,CN,,0000,0000,0000,,Жағымсыз ниет және т.б.
Dialogue: 0,0:09:23.95,0:09:24.86,CN,,0000,0000,0000,,Кел, кел, кел!
Dialogue: 0,0:09:26.38,0:09:27.69,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:32.79,0:09:34.69,CN,,0000,0000,0000,,Мен туралы не ойлайсың?
Dialogue: 0,0:09:36.85,0:09:40.86,CN,,0000,0000,0000,,?
Dialogue: 0,0:09:41.72,0:09:44.63,CN,,0000,0000,0000,,Мен қайдамын?
Dialogue: 0,0:09:45.92,0:09:47.12,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:50.05,0:09:51.38,CN,,0000,0000,0000,,Бірінен соң бірі
Dialogue: 0,0:09:51.80,0:09:53.30,CN,,0000,0000,0000,,Ух... тағы да.
Dialogue: 0,0:09:56.88,0:09:59.81,CN,,0000,0000,0000,,Шынайы мағына мүлдем елестету мүмкін емес
Dialogue: 0,0:10:00.93,0:10:01.47,CN,,0000,0000,0000,,Керіскерлер тобы
Dialogue: 0,0:10:09.11,0:10:10.27,CN,,0000,0000,0000,,Нана Синбо
Dialogue: 0,0:10:10.27,0:10:10.80,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:10.80,0:10:11.99,CN,,0000,0000,0000,,Менімен айырбастауға болады ма?
Dialogue: 0,0:10:12.14,0:10:12.94,CN,,0000,0000,0000,,Келесі жолы
Dialogue: 0,0:10:12.94,0:10:13.82,CN,,0000,0000,0000,,Талаптар
Dialogue: 0,0:10:14.37,0:10:15.55,CN,,0000,0000,0000,,Қайда жүру керек
Dialogue: 0,0:10:17.64,0:10:19.62,CN,,0000,0000,0000,,Юко отбасының оралуы
Dialogue: 0,0:10:19.80,0:10:21.40,CN,,0000,0000,0000,,Мұнда емес.
Dialogue: 0,0:10:22.01,0:10:23.30,CN,,0000,0000,0000,,Накама - шағын көрініс
Dialogue: 0,0:10:23.49,0:10:24.18,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:10:24.45,0:10:27.73,CN,,0000,0000,0000,,Нана, енді сенде сиқырлы таяқ бар
Dialogue: 0,0:10:28.14,0:10:31.54,CN,,0000,0000,0000,,Бұл қажет ұнтақ қорабы.
Dialogue: 0,0:10:31.54,0:10:32.83,CN,,0000,0000,0000,,Шығысқа да, Батысқа да келгім келмейді.
Dialogue: 0,0:10:32.98,0:10:34.22,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:34.60,0:10:35.49,CN,,0000,0000,0000,,Барлығыңды өлтіреміз
Dialogue: 0,0:10:39.33,0:10:42.11,CN,,0000,0000,0000,,Бірінші қадам – маңызды жол.
Dialogue: 0,0:10:44.41,0:10:45.37,CN,,0000,0000,0000,,Мен көпірден өткім келмейді
Dialogue: 0,0:10:45.62,0:10:48.02,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:10:51.18,0:10:51.73,CN,,0000,0000,0000,,Мен кеттім
Dialogue: 0,0:10:51.91,0:10:53.72,CN,,0000,0000,0000,,... дегеніміз не?
Dialogue: 0,0:10:54.74,0:10:59.57,CN,,0000,0000,0000,,Тензи Тензи Тензи
Dialogue: 0,0:11:10.63,0:11:12.38,CN,,0000,0000,0000,,Армандарыңызға қамқорлық жасаңыз
Dialogue: 0,0:11:20.39,0:11:21.41,CN,,0000,0000,0000,,Ұйқы...
Dialogue: 0,0:11:22.66,0:11:23.67,CN,,0000,0000,0000,,Кешір
Dialogue: 0,0:11:24.39,0:11:25.55,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:31.34,0:11:35.82,CN,,0000,0000,0000,,Дыбысты қалай естідің?
Dialogue: 0,0:11:37.18,0:11:40.46,CN,,0000,0000,0000,,Джаку Сейя – музыканың бір бөлігі
Dialogue: 0,0:11:45.28,0:11:47.32,CN,,0000,0000,0000,,Сіздің ниетіңіз маған бірден келудің қажеті жоқ.
Dialogue: 0,0:11:48.88,0:11:50.25,CN,,0000,0000,0000,,Бұл менің ниетім
Dialogue: 0,0:12:06.29,0:12:09.30,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:09.77,0:12:12.17,CN,,0000,0000,0000,,Ю Хао бейнесі кенеттен бос емес
Dialogue: 0,0:12:13.68,0:12:14.88,CN,,0000,0000,0000,,Маған ұнамайды.
Dialogue: 0,0:12:15.27,0:12:18.21,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:21.88,0:12:23.79,CN,,0000,0000,0000,,Бұл... күш
Dialogue: 0,0:12:24.51,0:12:25.08,CN,,0000,0000,0000,,Биліктің оннан бір бөлігі
Dialogue: 0,0:12:25.79,0:12:27.72,CN,,0000,0000,0000,,Ұзақ мерзімді міндеттеменің төленбеген бөлігі
Dialogue: 0,0:12:29.52,0:12:31.90,CN,,0000,0000,0000,,Тұлғаның аты-жөні екені расталады
Dialogue: 0,0:12:32.57,0:12:34.45,CN,,0000,0000,0000,,Бұл жоғарылау уақыты.
Dialogue: 0,0:12:38.08,0:12:39.11,CN,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:12:47.37,0:12:49.92,CN,,0000,0000,0000,,Тәртіпсіздік
Dialogue: 0,0:12:51.72,0:12:52.35,CN,,0000,0000,0000,,3-бөлім: Түрмедегі бандиттермен кездесу
Dialogue: 0,0:12:53.66,0:12:55.22,CN,,0000,0000,0000,,Фукоу I...
Dialogue: 0,0:12:56.86,0:13:00.70,CN,,0000,0000,0000,,Мен елестете аламын ...
Dialogue: 0,0:13:05.13,0:13:06.90,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:08.58,0:13:09.24,CN,,0000,0000,0000,,15-ші эпизод: Батырлық өлім – Екінші бөлім
Dialogue: 0,0:13:20.62,0:13:21.67,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:23.88,0:13:25.34,CN,,0000,0000,0000,,Шағын сымсыз телефон қоңырауы
Dialogue: 0,0:13:25.48,0:13:27.37,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:28.17,0:13:29.04,CN,,0000,0000,0000,,Бұл нақты шешім.
Dialogue: 0,0:13:30.75,0:13:34.17,CN,,0000,0000,0000,,Жасыл түсті шағын әңгіме
Dialogue: 0,0:13:34.66,0:13:35.49,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:36.33,0:13:37.78,CN,,0000,0000,0000,,Каннаяның келуі
Dialogue: 0,0:13:38.45,0:13:40.05,CN,,0000,0000,0000,,тақырып
Dialogue: 0,0:13:40.52,0:13:43.17,CN,,0000,0000,0000,,Шығыс және Батыс
Dialogue: 0,0:13:43.86,0:13:45.20,CN,,0000,0000,0000,,Жақсы оқу
Dialogue: 0,0:13:45.88,0:13:46.68,CN,,0000,0000,0000,,Сәлем
Dialogue: 0,0:13:46.97,0:13:48.55,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:49.96,0:13:51.61,CN,,0000,0000,0000,,Келу және қарсы алу
Dialogue: 0,0:13:53.96,0:13:55.25,CN,,0000,0000,0000,,Жағымсыз ниеттер
Dialogue: 0,0:13:55.32,0:13:56.24,CN,,0000,0000,0000,,Шайды алдау
Dialogue: 0,0:13:56.53,0:13:58.49,CN,,0000,0000,0000,,Қазіргі жағдай қандай?
Dialogue: 0,0:13:58.88,0:14:00.17,CN,,0000,0000,0000,,Құшақтау
Dialogue: 0,0:14:00.25,0:14:01.15,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:14:01.29,0:14:02.92,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:03.13,0:14:03.98,CN,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:14:04.50,0:14:05.96,CN,,0000,0000,0000,,Бұл би үйірмесі...
Dialogue: 0,0:14:06.10,0:14:07.78,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:08.14,0:14:09.17,CN,,0000,0000,0000,,Райо Коуки
Dialogue: 0,0:14:09.27,0:14:11.52,CN,,0000,0000,0000,,Бұл кішкентай жасыл дизайн.
Dialogue: 0,0:14:11.92,0:14:14.09,CN,,0000,0000,0000,,Ұсақ көк шөптердің пайдасы мен зияны
Dialogue: 0,0:14:14.27,0:14:16.05,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:18.27,0:14:19.29,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:20.03,0:14:21.64,CN,,0000,0000,0000,,Өткен жылғы резиденция...
Dialogue: 0,0:14:24.55,0:14:26.50,CN,,0000,0000,0000,,Міне, болды...
Dialogue: 0,0:14:27.56,0:14:30.19,CN,,0000,0000,0000,,Кішкентай апаның кездесу тарихы... болды.
Dialogue: 0,0:14:31.12,0:14:33.78,CN,,0000,0000,0000,,Тарих мырза
Dialogue: 0,0:14:41.26,0:14:41.70,CN,,0000,0000,0000,,Әңгіме
Dialogue: 0,0:14:42.15,0:14:42.92,CN,,0000,0000,0000,,?
Dialogue: 0,0:14:43.62,0:14:44.78,CN,,0000,0000,0000,,Сіз оны оқи аласыз.
Dialogue: 0,0:14:45.28,0:14:46.03,CN,,0000,0000,0000,,Мен сені қашып құтылуға ешқашан жібермеймін.
Dialogue: 0,0:14:47.80,0:14:48.52,CN,,0000,0000,0000,,Зал
Dialogue: 0,0:14:48.76,0:14:50.75,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:51.31,0:14:52.57,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:53.12,0:14:54.58,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:54.81,0:14:56.10,CN,,0000,0000,0000,,?
Dialogue: 0,0:14:56.17,0:14:56.76,CN,,0000,0000,0000,,Суық тию?
Dialogue: 0,0:14:58.08,0:14:59.16,CN,,0000,0000,0000,,Осыны айту...
Dialogue: 0,0:15:01.81,0:15:04.01,CN,,0000,0000,0000,,Тез сөйлеймін деп құшақтап ал.
Dialogue: 0,0:15:04.22,0:15:06.08,CN,,0000,0000,0000,,Тарихқа алаңдамаңыз
Dialogue: 0,0:15:06.42,0:15:08.35,CN,,0000,0000,0000,,Шағын жасыл әңгіме
Dialogue: 0,0:15:08.69,0:15:10.23,CN,,0000,0000,0000,,Менің қызыл бұршақтан жасалған Дайфуку ыдысым
Dialogue: 0,0:15:10.47,0:15:12.90,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:20.37,0:15:21.20,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:28.17,0:15:29.46,CN,,0000,0000,0000,,Шығыс пен Батысқа шақыруды қабыл алыңыз.
Dialogue: 0,0:15:29.46,0:15:30.50,CN,,0000,0000,0000,,Өлім
Dialogue: 0,0:15:30.83,0:15:32.29,CN,,0000,0000,0000,,Кенеттен қолайсыз ниет орындалады
Dialogue: 0,0:15:32.29,0:15:33.59,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:34.02,0:15:35.07,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:35.20,0:15:38.24,CN,,0000,0000,0000,,Бейнежазбаны көргенде абдырап қаласың.
Dialogue: 0,0:15:38.75,0:15:39.86,CN,,0000,0000,0000,,Үйден шыққаннан кейін
Dialogue: 0,0:15:40.05,0:15:42.72,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:42.96,0:15:44.50,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:45.28,0:15:47.28,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:47.60,0:15:48.06,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:15:51.05,0:15:51.69,CN,,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:15:54.74,0:15:57.38,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:57.53,0:15:58.76,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:00.24,0:16:01.63,CN,,0000,0000,0000,,Дұрыс. Дұрыс.
Dialogue: 0,0:16:01.72,0:16:03.25,CN,,0000,0000,0000,,Мүмкін опциялар
Dialogue: 0,0:16:04.23,0:16:07.23,CN,,0000,0000,0000,,Оған тұрарлық емес
Dialogue: 0,0:16:07.95,0:16:11.63,CN,,0000,0000,0000,,Бұл жапон мейрамханасында көптеген сөздер бар.
Dialogue: 0,0:16:12.19,0:16:12.70,CN,,0000,0000,0000,,Канна
Dialogue: 0,0:16:14.14,0:16:14.72,CN,,0000,0000,0000,,Кешір
Dialogue: 0,0:16:15.35,0:16:19.23,CN,,0000,0000,0000,,Мен дүкендегі шағын дүкенге келдім.
Dialogue: 0,0:16:19.80,0:16:20.84,CN,,0000,0000,0000,,Намутеки...
Dialogue: 0,0:16:20.94,0:16:24.68,CN,,0000,0000,0000,,Міне, сіз осы жердесіз.
Dialogue: 0,0:16:24.82,0:16:25.34,CN,,0000,0000,0000,,Негізсіз
