Dialogue: 0,0:15:41.90,0:15:44.33,CN,,0000,0000,0000,,Зорлық-зомбылық, қорлау
Dialogue: 0,0:15:45.01,0:15:46.74,CN,,0000,0000,0000,,Айқайлаған құс
Dialogue: 0,0:15:47.00,0:15:51.28,CN,,0000,0000,0000,,Бұзықтық, Өлдім, Жаман күйде болдым, Өлдім.
Dialogue: 0,0:15:51.28,0:15:53.54,CN,,0000,0000,0000,,Әңгімелесу
Dialogue: 0,0:15:53.69,0:15:57.15,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:57.15,0:15:58.08,CN,,0000,0000,0000,,Демалыңыз
Dialogue: 0,0:15:58.59,0:15:59.78,CN,,0000,0000,0000,,Ересек адам
Dialogue: 0,0:15:59.88,0:16:00.52,CN,,0000,0000,0000,,Дұрыс кездесу
Dialogue: 0,0:16:03.23,0:16:04.37,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:06.84,0:16:09.50,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:14.67,0:16:15.94,CN,,0000,0000,0000,,...
Dialogue: 0,0:16:18.52,0:16:22.28,CN,,0000,0000,0000,,Тарих кішкентай апа
Dialogue: 0,0:16:22.28,0:16:25.17,CN,,0000,0000,0000,,Табысты және сау болуға талпыныс
Dialogue: 0,0:16:27.66,0:16:28.83,CN,,0000,0000,0000,,Қауырсын доп
Dialogue: 0,0:16:30.21,0:16:31.08,CN,,0000,0000,0000,,Жақсы нәтиже
Dialogue: 0,0:16:31.79,0:16:32.20,CN,,0000,0000,0000,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:16:32.60,0:16:33.18,CN,,0000,0000,0000,,Алтын тәуелсіздік
Dialogue: 0,0:16:39.66,0:16:41.04,CN,,0000,0000,0000,,Сяо де ла өлім оқиғасы
Dialogue: 0,0:16:41.55,0:16:43.90,CN,,0000,0000,0000,,Бұл нүкте өшпейді.
Dialogue: 0,0:16:45.48,0:16:47.45,CN,,0000,0000,0000,,Мейтеняның негізгі дайындығы
Dialogue: 0,0:16:57.08,0:16:58.28,CN,,0000,0000,0000,,Ересек
Dialogue: 0,0:16:58.28,0:17:01.16,CN,,0000,0000,0000,,Қиын жолды айтсам, жұмсақ денемді, ойымды көрсетемін.
Dialogue: 0,0:17:01.16,0:17:01.95,CN,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:17:01.95,0:17:02.94,CN,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:17:03.52,0:17:07.24,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:07.57,0:17:09.30,CN,,0000,0000,0000,,Түнде суық болады
Dialogue: 0,0:17:09.76,0:17:12.95,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:13.39,0:17:14.09,CN,,0000,0000,0000,,Негізінен
Dialogue: 0,0:17:14.45,0:17:15.86,CN,,0000,0000,0000,,Бірінші күз
Dialogue: 0,0:17:16.21,0:17:17.06,CN,,0000,0000,0000,,Күздің басы?
Dialogue: 0,0:17:17.39,0:17:18.50,CN,,0000,0000,0000,,Бірінші күзгі аспан
Dialogue: 0,0:17:18.73,0:17:20.83,CN,,0000,0000,0000,,Алғашқы махаббат бейнесі
Dialogue: 0,0:17:21.19,0:17:23.44,CN,,0000,0000,0000,,Жаңа киім сатып алу
Dialogue: 0,0:17:24.49,0:17:26.57,CN,,0000,0000,0000,,Мен мектеп формасын киіп біттім.
Dialogue: 0,0:17:27.64,0:17:30.28,CN,,0000,0000,0000,,Мектеп формасы
Dialogue: 0,0:17:32.14,0:17:34.18,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:34.51,0:17:36.31,CN,,0000,0000,0000,,Қолдан жасалған гүл композициясы
Dialogue: 0,0:17:36.72,0:17:40.89,CN,,0000,0000,0000,,Мен не істерімді білмеймін.
Dialogue: 0,0:17:41.86,0:17:44.78,CN,,0000,0000,0000,,Перфорация – тұрақты махаббат.
Dialogue: 0,0:17:44.78,0:17:47.25,CN,,0000,0000,0000,,Оны қалай ауыстыруға болады?
Dialogue: 0,0:17:47.25,0:17:49.35,CN,,0000,0000,0000,,Жасыл түсті шағын хат толтырылды
Dialogue: 0,0:17:49.71,0:17:54.10,CN,,0000,0000,0000,,Ұсталмаған түрі Әскери киім түрі Әскери киім түрі Ол икемді және икемді.
Dialogue: 0,0:17:54.32,0:17:56.59,CN,,0000,0000,0000,,...
Dialogue: 0,0:17:52.36,0:17:53.33,CN,,0000,0000,0000,,Учигакуя
Dialogue: 0,0:17:54.79,0:17:58.74,CN,,0000,0000,0000,,Наганың киім алмасуы
Dialogue: 0,0:17:56.59,0:17:58.69,CN,,0000,0000,0000,,Ол бұрыннан бар еді.
Dialogue: 0,0:17:58.84,0:18:00.80,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:05.39,0:18:08.02,CN,,0000,0000,0000,,Дүкенім бар, мүсінім бар.
Dialogue: 0,0:18:08.09,0:18:10.97,CN,,0000,0000,0000,,Келуші кіретін жер.
Dialogue: 0,0:18:12.58,0:18:13.94,CN,,0000,0000,0000,,Қабылданбаған
Dialogue: 0,0:18:14.33,0:18:16.10,CN,,0000,0000,0000,,Не болды?
Dialogue: 0,0:18:17.90,0:18:19.79,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:20.06,0:18:21.70,CN,,0000,0000,0000,,Мен жақсы уақыт өткіземін ...
Dialogue: 0,0:18:21.70,0:18:22.42,CN,,0000,0000,0000,,Бұзушылық!
Dialogue: 0,0:18:22.51,0:18:23.52,CN,,0000,0000,0000,,Дұрыс
Dialogue: 0,0:18:27.54,0:18:30.68,CN,,0000,0000,0000,,Біздің дүкеннің негізгі қызметкерлері орта жастағы адамдар.
Dialogue: 0,0:18:31.39,0:18:34.58,CN,,0000,0000,0000,,Бұл менің досымның дүкені.
Dialogue: 0,0:18:37.83,0:18:39.51,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:39.86,0:18:41.96,CN,,0000,0000,0000,,Әңгіменің стилі
Dialogue: 0,0:18:42.42,0:18:45.15,CN,,0000,0000,0000,,Сіз қонақсыз.
Dialogue: 0,0:18:45.47,0:18:47.29,CN,,0000,0000,0000,,Бұл жақсы
Dialogue: 0,0:18:47.86,0:18:48.68,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:49.05,0:18:52.32,CN,,0000,0000,0000,,Гаму оянады
Dialogue: 0,0:18:55.70,0:18:56.40,CN,,0000,0000,0000,,...
Dialogue: 0,0:18:57.17,0:18:58.29,CN,,0000,0000,0000,,Перфорация Перфорациясы
Dialogue: 0,0:18:58.76,0:19:00.42,CN,,0000,0000,0000,,тарау
Dialogue: 0,0:19:02.85,0:19:04.05,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:04.39,0:19:06.47,CN,,0000,0000,0000,,Егер сіз басқа елдің тұрғыны болсаңыз, кәмелетке толмаған болуыңыз мүмкін.
Dialogue: 0,0:19:07.04,0:19:08.08,CN,,0000,0000,0000,,Жағдай қандай?
Dialogue: 0,0:19:08.93,0:19:09.71,CN,,0000,0000,0000,,Сеніңше, қалай?
Dialogue: 0,0:19:10.37,0:19:11.97,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:12.21,0:19:13.22,CN,,0000,0000,0000,,Аянобу
Dialogue: 0,0:19:13.27,0:19:15.42,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:13.31,0:19:16.15,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:16.52,0:19:19.13,CN,,0000,0000,0000,,Мырза өзеннен өтті.
Dialogue: 0,0:19:20.50,0:19:21.58,CN,,0000,0000,0000,,Әрине
Dialogue: 0,0:19:16.53,0:19:20.07,CN,,0000,0000,0000,,Жақсы, жарайды, жаман емес, кішкентай жасыл.
Dialogue: 0,0:19:20.28,0:19:21.58,CN,,0000,0000,0000,,Әрине
Dialogue: 0,0:19:24.28,0:19:27.01,CN,,0000,0000,0000,,Екеуінің айырмашылығы неде?
Dialogue: 0,0:19:27.21,0:19:29.92,CN,,0000,0000,0000,,Мен Шығыс жағалаудан шыққанда
Dialogue: 0,0:19:28.99,0:19:29.98,CN,,0000,0000,0000,,Бұл дәм...
Dialogue: 0,0:19:30.25,0:19:31.37,CN,,0000,0000,0000,,Құшақтау
Dialogue: 0,0:19:31.81,0:19:33.53,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:33.86,0:19:36.60,CN,,0000,0000,0000,,Қазір өлмеу.
Dialogue: 0,0:19:36.75,0:19:39.34,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:39.59,0:19:40.24,CN,,0000,0000,0000,,Жақсы дәм
Dialogue: 0,0:19:42.54,0:19:44.59,CN,,0000,0000,0000,,Шайқас – жалғыздық
Dialogue: 0,0:19:45.13,0:19:48.56,CN,,0000,0000,0000,,Ұзақ түннен кейін болашақта жеңіс нұры түсуі керек.
Dialogue: 0,0:19:51.00,0:19:52.54,CN,,0000,0000,0000,,...
Dialogue: 0,0:19:52.82,0:19:55.81,CN,,0000,0000,0000,,Жақында байланыс ақпаратыңыз жоғалды.
Dialogue: 0,0:19:56.17,0:19:58.09,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:07.49,0:20:09.01,CN,,0000,0000,0000,,Хисато Рио Ойке
Dialogue: 0,0:20:10.07,0:20:12.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:12.49,0:20:14.31,CN,,0000,0000,0000,,Мен сені енді көргім келмейді.
Dialogue: 0,0:20:14.74,0:20:16.70,CN,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:20:17.18,0:20:20.14,CN,,0000,0000,0000,,Белгілі бір тривиальды себепке байланысты жалпы дененің өзгеруі
Dialogue: 0,0:20:20.55,0:20:22.23,CN,,0000,0000,0000,,Бұл...
Dialogue: 0,0:20:25.61,0:20:26.54,CN,,0000,0000,0000,,Жақсы дәмді сақтау
Dialogue: 0,0:20:26.77,0:20:30.66,CN,,0000,0000,0000,,Әрине, осыдан кейін дене пішінімді сақтауым керек.
Dialogue: 0,0:20:31.06,0:20:32.76,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:33.08,0:20:35.05,CN,,0000,0000,0000,,Сіз бұл туралы бұрын естідіңіз бе?
Dialogue: 0,0:20:39.72,0:20:41.70,CN,,0000,0000,0000,,Сатып алу - бұл сатып алу.
Dialogue: 0,0:20:42.38,0:20:43.76,CN,,0000,0000,0000,,Суретті зерттеу
Dialogue: 0,0:20:43.91,0:20:44.47,CN,,0000,0000,0000,,Жылдамдық
Dialogue: 0,0:20:44.73,0:20:46.96,CN,,0000,0000,0000,,Сауда ауданындағы адамдардың әсері
Dialogue: 0,0:20:46.96,0:20:50.30,CN,,0000,0000,0000,,Мені ұрлағаныма көп болды.
Dialogue: 0,0:20:50.69,0:20:52.25,CN,,0000,0000,0000,,Бұл менің ниетім емес
Dialogue: 0,0:20:52.40,0:20:53.09,CN,,0000,0000,0000,,Ерте
Dialogue: 0,0:20:54.10,0:20:55.14,CN,,0000,0000,0000,,Косуй Канна
Dialogue: 0,0:20:55.88,0:20:57.03,CN,,0000,0000,0000,,...
Dialogue: 0,0:20:59.00,0:21:01.24,CN,,0000,0000,0000,,мәңгі жасыл бойынша таңдау
Dialogue: 0,0:21:01.58,0:21:03.96,CN,,0000,0000,0000,,Кана Макино бойынша өлшеу
Dialogue: 0,0:21:04.27,0:21:05.93,CN,,0000,0000,0000,,ашайық
Dialogue: 0,0:21:19.90,0:21:20.91,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:21:21.18,0:21:23.64,CN,,0000,0000,0000,,Менің сатып алғаным қандай?
Dialogue: 0,0:21:24.14,0:21:24.71,CN,,0000,0000,0000,,Белгісіз
Dialogue: 0,0:21:25.17,0:21:26.72,CN,,0000,0000,0000,,Қайта пайдаланылмайды
Dialogue: 0,0:21:26.85,0:21:28.12,CN,,0000,0000,0000,,Қолжетімсіз
Dialogue: 0,0:21:28.54,0:21:31.15,CN,,0000,0000,0000,,Сіздің денеңіз туралы айту сіздің рахатыңыз.
Dialogue: 0,0:21:31.33,0:21:31.95,CN,,0000,0000,0000,,Менсінбеу...
Dialogue: 0,0:21:32.24,0:21:33.82,CN,,0000,0000,0000,,Сен әдемі, сұлусың
Dialogue: 0,0:21:34.17,0:21:35.90,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:36.08,0:21:37.37,CN,,0000,0000,0000,,...
Dialogue: 0,0:21:37.37,0:21:39.62,CN,,0000,0000,0000,,Мистер қазір қайтыс болды.
Dialogue: 0,0:21:40.80,0:21:41.54,CN,,0000,0000,0000,,Сеніңше, қалай?
Dialogue: 0,0:21:48.14,0:21:49.17,CN,,0000,0000,0000,,Бұл ерте күз
Dialogue: 0,0:21:50.54,0:21:53.93,CN,,0000,0000,0000,,Жыл мезгілінің ауысуы Күзгі жоғары маусым
Dialogue: 0,0:21:54.62,0:21:56.81,CN,,0000,0000,0000,,Жылы адамзат
Dialogue: 0,0:21:57.31,0:22:00.01,CN,,0000,0000,0000,,Шоганың жүрегі қызыл жапыраққа боялған
Dialogue: 0,0:23:35.79,0:23:39.03,CN,,0000,0000,0000,,Жылдағы жұмыртқаны асыға күтемін.
Dialogue: 0,0:23:39.19,0:23:42.78,CN,,0000,0000,0000,,Жыл келіп кептіру бітсе, жарылыстан кейін қарағай сынғыш кездесу жақсы.
Dialogue: 0,0:23:43.16,0:23:44.56,CN,,0000,0000,0000,,Мүмкін нүктелер
Dialogue: 0,0:23:44.56,0:23:46.46,CN,,0000,0000,0000,,Жасыл теңіз балдыры немесе қара бұрыш қосылды
Dialogue: 0,0:23:46.84,0:23:48.87,CN,,0000,0000,0000,,Жиналыс келгенде кейбір кемшіліктер бар.
Dialogue: 0,0:00:03.52,0:00:05.27,CN,,0000,0000,0000,,Каштан тортының бастапқы тартуы
Dialogue: 0,0:06:41.38,0:06:45.38,CN,,0000,0000,0000,,Мүмкін емес Мистер Гулп
Dialogue: 0,0:06:46.67,0:06:51.68,CN,,0000,0000,0000,,Мен сенімен кездескім келмейді.
Dialogue: 0,0:21:49.66,0:21:55.16,CN,,0000,0000,0000,,○Сато толтыру
Dialogue: 0,0:23:50.37,0:23:56.37,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
