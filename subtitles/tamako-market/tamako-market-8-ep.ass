Dialogue: 0,0:04:23.06,0:04:27.62,OP-JP,,0000,0000,0000,,Мен өзімді көп адамның арасынан жүгіріп өткендей сезінемін
Dialogue: 0,0:04:27.81,0:04:30.48,OP-JP,,0000,0000,0000,,Мен сені шақырғандай.
Dialogue: 0,0:04:30.48,0:04:33.40,OP-JP,,0000,0000,0000,,Тағы да толып жатыр
Dialogue: 0,0:04:34.34,0:04:38.93,OP-JP,,0000,0000,0000,,Жан-жақта ұшқан фаворитизмді мақтан тұтамын
Dialogue: 0,0:04:39.05,0:04:44.94,OP-JP,,0000,0000,0000,,Мен өзімнің күткен үміттеріме қуанғым келеді
Dialogue: 0,0:04:45.53,0:04:48.06,OP-JP,,0000,0000,0000,,Мен тік тұрдым.
Dialogue: 0,0:04:48.34,0:04:50.70,OP-JP,,0000,0000,0000,,Мен көптен бері күттім
Dialogue: 0,0:04:50.70,0:04:52.60,OP-JP,,0000,0000,0000,,Бірінен-бірі өтіп бара жатқан күлкілер
Dialogue: 0,0:04:52.75,0:04:56.47,OP-JP,,0000,0000,0000,,Мен сені қатты құшақтағым келеді
Dialogue: 0,0:04:59.18,0:05:01.89,OP-JP,,0000,0000,0000,,Келіңіздер, бәріңіз.
Dialogue: 0,0:05:01.98,0:05:09.88,OP-JP,,0000,0000,0000,,Ол әрқашан кенеттен жүгіре бастайды.
Dialogue: 0,0:05:09.96,0:05:15.78,OP-JP,,0000,0000,0000,,Кез келген кештің тұман болатыны сияқты.
Dialogue: 0,0:05:16.03,0:05:22.96,OP-JP,,0000,0000,0000,,Бұл жерді жарқыраған жерде тексеру
Dialogue: 0,0:22:05.85,0:22:09.41,ED-JP,,0000,0000,0000,,бұрылыс жазбасы
Dialogue: 0,0:22:09.41,0:22:12.89,ED-JP,,0000,0000,0000,,Егер ісініп, жарылып кетсе
Dialogue: 0,0:22:12.89,0:22:18.25,ED-JP,,0000,0000,0000,,Бұл күйдірілген жазба болады.
Dialogue: 0,0:22:20.33,0:22:25.42,ED-JP,,0000,0000,0000,,Шаш кептіргішпен түзетілмейтін көңіл-күй
Dialogue: 0,0:22:27.47,0:22:31.33,ED-JP,,0000,0000,0000,,Мен кеше тым көп сөйледім
Dialogue: 0,0:22:34.37,0:22:39.44,ED-JP,,0000,0000,0000,,Мен контактілерді жоюға тырыстым.
Dialogue: 0,0:22:41.37,0:22:45.00,ED-JP,,0000,0000,0000,,Дүние бұлыңғыр
Dialogue: 0,0:22:47.08,0:22:50.38,ED-JP,,0000,0000,0000,,Бір сәтке
Dialogue: 0,0:22:50.38,0:22:53.88,ED-JP,,0000,0000,0000,,Мен сенің тұрған жеріңді тексеремін.
Dialogue: 0,0:22:54.08,0:23:01.11,ED-JP,,0000,0000,0000,,Бір күні сені тастап кетемін бе деп ойлаймын
Dialogue: 0,0:23:04.52,0:23:08.02,ED-JP,,0000,0000,0000,,Әрқашан бірдеңе іздеу
Dialogue: 0,0:23:08.02,0:23:11.61,ED-JP,,0000,0000,0000,,Жақын жерде жасырыну
Dialogue: 0,0:23:11.61,0:23:17.09,ED-JP,,0000,0000,0000,,Тақпақтың жүрегін білсем де
Dialogue: 0,0:23:17.94,0:23:22.12,ED-JP,,0000,0000,0000,,Ах, иіру, иіру, жазулар
Dialogue: 0,0:23:22.12,0:23:25.61,ED-JP,,0000,0000,0000,,Ол ісініп, жарылып кетеді.
Dialogue: 0,0:23:25.61,0:23:30.67,ED-JP,,0000,0000,0000,,Бірақ, жұмбақ әуен
Dialogue: 0,0:23:31.93,0:23:34.53,ED-JP,,0000,0000,0000,,Мен оны ешқашан ұмытпаймын
Dialogue: 0,0:05:33.97,0:05:43.94,Staff,,0000,0000,0000,,Осы субтитр көзімен жасалған, God Subtitles Group (kamigami.org), жеткізу алмасу оқыту, коммерциялық мақсатта пайдалануға тыйым салынған
Dialogue: 0,0:05:33.97,0:05:43.94,Staff,,0000,0000,0000,,:& :&NOKI :& : : :
Dialogue: 0,0:00:05.61,0:00:06.82,JP,,0000,0000,0000,,Иә, бұл Тамая.
Dialogue: 0,0:00:07.58,0:00:08.78,JP,,0000,0000,0000,,О, Канна-чан
Dialogue: 0,0:00:09.97,0:00:11.77,JP,,0000,0000,0000,,Енді? Дүкенде көмектесу
Dialogue: 0,0:00:12.94,0:00:14.92,JP,,0000,0000,0000,,Жарайды, Канна-чан.
Dialogue: 0,0:00:15.32,0:00:18.64,JP,,0000,0000,0000,,Жақсы Бұл каштан мочи өте жақсы.
Dialogue: 0,0:00:17.66,0:00:21.65,JP,,0000,0000,0000,,Дұрыс. Мен каштан мочи жасай бастадым, сондықтан оны қайтадан жей беріңіз.
Dialogue: 0,0:00:19.22,0:00:21.84,JP,,0000,0000,0000,,Қайсысы тағы...
Dialogue: 0,0:00:23.60,0:00:24.55,JP,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:00:25.01,0:00:25.96,JP,,0000,0000,0000,,Сіз тым көп жеп жатырсыз.
Dialogue: 0,0:00:26.13,0:00:27.93,JP,,0000,0000,0000,,Бұл мағынасы бар.
Dialogue: 0,0:00:25.37,0:00:26.64,JP,,0000,0000,0000,,тапсырмалар
Dialogue: 0,0:00:28.07,0:00:30.43,JP,,0000,0000,0000,,Мырза? О, Делла-чан?
Dialogue: 0,0:00:31.31,0:00:32.08,JP,,0000,0000,0000,,Бар
Dialogue: 0,0:00:33.00,0:00:34.72,JP,,0000,0000,0000,,Иә, түсіндім. Мен бірден барамын.
Dialogue: 0,0:00:38.20,0:00:39.08,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:00:39.51,0:00:40.13,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:00:40.90,0:00:43.13,JP,,0000,0000,0000,,Менімен кездескісі келген сен бе?
Dialogue: 0,0:00:43.37,0:00:44.73,JP,,0000,0000,0000,,Сәлем мырза.
Dialogue: 0,0:00:48.39,0:00:50.28,JP,,0000,0000,0000,,Еш ойланба, қыз
Dialogue: 0,0:00:50.70,0:00:52.29,JP,,0000,0000,0000,,Егер көзіңді соншалықты күйдірсе…
Dialogue: 0,0:00:52.60,0:00:54.71,JP,,0000,0000,0000,,Жоқ, маған үзіліс беріңізші.
Dialogue: 0,0:00:56.02,0:00:58.93,JP,,0000,0000,0000,,Сонымен не болып жатыр? Менің Делла-чанға қатысым бар.
Dialogue: 0,0:00:59.14,0:01:00.12,JP,,0000,0000,0000,,Дәл осы
Dialogue: 0,0:01:04.13,0:01:05.36,JP,,0000,0000,0000,,Бұл Делланың үйі ме?
Dialogue: 0,0:01:05.83,0:01:08.83,JP,,0000,0000,0000,,Менде қосымша тақталар болды, сондықтан мен мырзамен бірге бардым.
Dialogue: 0,0:01:09.23,0:01:12.37,JP,,0000,0000,0000,,Менің жеке ерекшелігім - бұл шатыр мен ағаш жақтау.
Dialogue: 0,0:01:09.41,0:01:13.62,JP,,0000,0000,0000,,Бұл құрмет. Бұл құрмет. Бұл ауырмайды.
Dialogue: 0,0:01:13.76,0:01:14.50,JP,,0000,0000,0000,,Бұл… (Бакуго) Э?
Dialogue: 0,0:01:14.50,0:01:16.03,JP,,0000,0000,0000,,Канна күткендей
Dialogue: 0,0:01:16.30,0:01:20.09,JP,,0000,0000,0000,,Мұндай мінез-құлық менің жас кезімнен үлкен мәселе болды.
Dialogue: 0,0:01:18.72,0:01:20.80,JP,,0000,0000,0000,,Байланыстың жоқтығы ұят.
Dialogue: 0,0:01:21.44,0:01:23.76,JP,,0000,0000,0000,,Кішкене байыпты болдыңыз ба?
Dialogue: 0,0:01:23.89,0:01:25.43,JP,,0000,0000,0000,,Бұл
Dialogue: 0,0:01:25.78,0:01:29.48,JP,,0000,0000,0000,,Кішкентай қыз, тынымсыз Делла үшін.
Dialogue: 0,0:01:31.28,0:01:35.02,JP,,0000,0000,0000,,Чой мырза қанша айтса да, мен оны елемеуге болмайды.
Dialogue: 0,0:01:35.46,0:01:39.09,JP,,0000,0000,0000,,Бұл Дера Мочимаззи халық шөпі күшті беделге ие.
Dialogue: 0,0:01:39.27,0:01:42.12,JP,,0000,0000,0000,,Мұның бәрі менің қасиетім, жоқ, бұл менің құс қасиетімнен.
Dialogue: 0,0:01:42.12,0:01:44.58,JP,,0000,0000,0000,,Жарайды, кіріңіз.
Dialogue: 0,0:01:48.02,0:01:49.85,JP,,0000,0000,0000,,Енді есте қалатын алғашқы қадам жасайық.
Dialogue: 0,0:01:51.15,0:01:51.99,JP,,0000,0000,0000,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:01:55.15,0:01:56.09,JP,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:01:56.37,0:01:59.01,JP,,0000,0000,0000,,Жоқ, кіреберіс шынымен тар.
Dialogue: 0,0:02:00.37,0:02:02.12,JP,,0000,0000,0000,,Өтірік Бұлай болуы мүмкін емес.
Dialogue: 0,0:02:08.23,0:02:12.12,JP,,0000,0000,0000,,Қаһарлысың, қыз. Бұл да махаббаттың көрінісі ме?
Dialogue: 0,0:02:30.96,0:02:32.10,JP,,0000,0000,0000,,Сәтсіздік
Dialogue: 0,0:02:32.93,0:02:34.86,JP,,0000,0000,0000,,Қате өлшемді қалай алуға болады?
Dialogue: 0,0:02:34.93,0:02:35.95,JP,,0000,0000,0000,,Неге?
Dialogue: 0,0:02:36.14,0:02:39.48,JP,,0000,0000,0000,,Қате өлшемдер және ағаш ұстасының басқа жиі кездесетін қателері
Dialogue: 0,0:02:39.72,0:02:41.10,JP,,0000,0000,0000,,Өмірдегі ұят
Dialogue: 0,0:02:41.25,0:02:42.75,JP,,0000,0000,0000,,Мен оны үгіндіге айналдырамын
Dialogue: 0,0:02:44.21,0:02:45.09,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:02:45.09,0:02:46.01,JP,,0000,0000,0000,,Моттайнай
Dialogue: 0,0:02:46.01,0:02:47.68,JP,,0000,0000,0000,,Күте тұр, қыз
Dialogue: 0,0:02:48.83,0:02:50.91,JP,,0000,0000,0000,,Қателік жасаған сіз емессіз.
Dialogue: 0,0:02:51.86,0:02:52.41,JP,,0000,0000,0000,,Бұл Делла.
Dialogue: 0,0:02:53.35,0:02:55.06,JP,,0000,0000,0000,,Делла қайтадан салмақ қосып алды.
Dialogue: 0,0:02:57.37,0:02:59.67,JP,,0000,0000,0000,,Мен бұрын екі каштан күріш тортын жедім.
Dialogue: 0,0:02:59.67,0:03:03.13,JP,,0000,0000,0000,,Делла-чан біздің күріш торттары мен тоқаштарды жақсы көреді.
Dialogue: 0,0:03:03.42,0:03:05.64,JP,,0000,0000,0000,,Сондықтан...
Dialogue: 0,0:03:05.64,0:03:08.30,JP,,0000,0000,0000,,Жоқ, мен мочиді ұнатпаймын.
Dialogue: 0,0:03:08.30,0:03:09.99,JP,,0000,0000,0000,,Себебі Мочи мені жақсы көреді...
Dialogue: 0,0:03:09.99,0:03:10.98,JP,,0000,0000,0000,,Сонымен не?
Dialogue: 0,0:03:12.40,0:03:13.45,JP,,0000,0000,0000,,This is that.
Dialogue: 0,0:03:14.96,0:03:15.98,JP,,0000,0000,0000,,Diet
Dialogue: 0,0:03:17.59,0:03:18.67,JP,,0000,0000,0000,,Exercise first?
Dialogue: 0,0:03:18.83,0:03:20.50,JP,,0000,0000,0000,,Жоқ, бұл диеталық шектеу.
Dialogue: 0,0:03:38.12,0:03:40.34,JP,,0000,0000,0000,,Диеталық шектеулер
Dialogue: 0,0:03:40.40,0:03:42.74,JP,,0000,0000,0000,,Ең болмағанда осында қоюға жеткілікті
Dialogue: 0,0:03:42.86,0:03:43.95,JP,,0000,0000,0000,,That's a bit...
Dialogue: 0,0:03:43.95,0:03:46.89,JP,,0000,0000,0000,,Бірақ диетаның басқа да жолдары бар.
Dialogue: 0,0:03:46.99,0:03:47.55,JP,,0000,0000,0000,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,0:03:47.55,0:03:48.13,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:03:48.66,0:03:52.45,JP,,0000,0000,0000,,Аспанда жылқы өскен күз, Тәбет ашар күз
Dialogue: 0,0:03:53.22,0:03:57.24,JP,,0000,0000,0000,,Бірақ мен қарным ашты және жалғызбын
Dialogue: 0,0:03:54.72,0:03:55.53,JP,,0000,0000,0000,,Maido
Dialogue: 0,0:03:57.50,0:03:58.70,JP,,0000,0000,0000,,Сәлем, қош келдіңіз.
Dialogue: 0,0:03:58.84,0:04:03.39,JP,,0000,0000,0000,,Бұл дүниедегі ең өкініштісі – ұшпайтын құстан жеуге болмайтын құс.
Dialogue: 0,0:05:46.57,0:05:47.65,JP,,0000,0000,0000,,Әр жолы
Dialogue: 0,0:05:50.74,0:05:51.91,JP,,0000,0000,0000,,and birds
Dialogue: 0,0:05:52.05,0:05:54.30,JP,,0000,0000,0000,,Мочи, сен мені көре аласың ба?
Dialogue: 0,0:05:55.50,0:05:57.25,JP,,0000,0000,0000,,Мен осындамын
Dialogue: 0,0:05:57.68,0:05:59.83,JP,,0000,0000,0000,,Менің күріш тортымды жегің келе ме?
Dialogue: 0,0:05:59.83,0:06:02.65,JP,,0000,0000,0000,,I'm here
Dialogue: 0,0:06:02.73,0:06:06.85,JP,,0000,0000,0000,,Қарасам, бұршақ көлеміндей кесектерде жасалған ескі мочиден өзгеше.
Dialogue: 0,0:06:07.03,0:06:10.10,JP,,0000,0000,0000,,Біздікі - авангард және бренди мочи.
Dialogue: 0,0:06:08.60,0:06:11.42,JP,,0000,0000,0000,,А, мен жұмсақ жарық көріп тұрмын.
Dialogue: 0,0:06:10.85,0:06:14.39,JP,,0000,0000,0000,,Бұл жаңа Хэллоуин мочи.
Dialogue: 0,0:06:14.91,0:06:16.08,JP,,0000,0000,0000,,Қалай
Dialogue: 0,0:06:16.34,0:06:17.88,JP,,0000,0000,0000,,Енді кешіріңіз.
Dialogue: 0,0:06:21.51,0:06:26.99,JP,,0000,0000,0000,,Бұл соя соусы, мирин, сарымсақ, зімбірдің бір бөлігі, бір түнде қартаяды.
Dialogue: 0,0:06:28.54,0:06:31.01,JP,,0000,0000,0000,,Бұл мазасыз сиқыр дегеніміз не?
Dialogue: 0,0:06:31.31,0:06:33.19,JP,,0000,0000,0000,,Жер бетінде не болып жатыр?
Dialogue: 0,0:06:33.55,0:06:35.41,JP,,0000,0000,0000,,Do not feed birds
Dialogue: 0,0:06:36.56,0:06:39.06,JP,,0000,0000,0000,,Делла-чан диета ұстауды шешті.
Dialogue: 0,0:06:39.23,0:06:40.32,JP,,0000,0000,0000,,Yes Mr.
Dialogue: 0,0:06:41.63,0:06:42.56,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:06:42.68,0:06:45.50,JP,,0000,0000,0000,,Мистер мырзаға арналған өз қолыммен жасаған бұйымдарым.
Dialogue: 0,0:06:51.99,0:06:54.17,JP,,0000,0000,0000,,Иә, сұрасаңыз.
Dialogue: 0,0:06:54.42,0:06:55.98,JP,,0000,0000,0000,,Бұрынғыдан да толып кетті.
Dialogue: 0,0:06:56.45,0:06:58.71,JP,,0000,0000,0000,,Мен оны аяймын, бірақ оның метаболикалық синдромы бар.
Dialogue: 0,0:06:58.95,0:07:00.39,JP,,0000,0000,0000,,Арықтаған кезде тағы кездескенше
Dialogue: 0,0:07:01.02,0:07:02.81,JP,,0000,0000,0000,,Окараның калориясы төмен.
Dialogue: 0,0:07:02.94,0:07:04.74,JP,,0000,0000,0000,,Олай десеңіз.
Dialogue: 0,0:07:04.74,0:07:06.81,JP,,0000,0000,0000,,Сол бейқамдық тауықтың көзі.
Dialogue: 0,0:07:06.81,0:07:08.22,JP,,0000,0000,0000,,This much
Dialogue: 0,0:07:08.22,0:07:08.89,JP,,0000,0000,0000,,Шаршаған
Dialogue: 0,0:07:11.48,0:07:13.67,JP,,0000,0000,0000,,Е, мен дера диетасына отырамын.
Dialogue: 0,0:07:14.35,0:07:16.24,JP,,0000,0000,0000,,Мен де қызыл бұршақ пастасын жасаймын ба деп ойлаймын.
Dialogue: 0,0:07:16.36,0:07:18.30,JP,,0000,0000,0000,,Не айтып тұрсың, сен баласың ба?
Dialogue: 0,0:07:18.30,0:07:19.56,JP,,0000,0000,0000,,Not a child
Dialogue: 0,0:07:20.38,0:07:23.00,JP,,0000,0000,0000,,Бірақ артық салмақ жақсы емес, солай емес пе?
Dialogue: 0,0:07:23.73,0:07:26.03,JP,,0000,0000,0000,,Мен әркімнің мейірімділігіне тым тәуелді болдым.
Dialogue: 0,0:07:26.18,0:07:27.19,JP,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:07:27.90,0:07:32.84,JP,,0000,0000,0000,,Бірақ мен Чой-чанның сәуегейлігіне де қарсы емеспін.Дера-чан семіз.
Dialogue: 0,0:07:33.32,0:07:37.78,JP,,0000,0000,0000,,Егер солай болса, мен сізді аздап аяймын, бірақ мен бар күшімді салуым керек.
Dialogue: 0,0:07:39.17,0:07:40.52,JP,,0000,0000,0000,,Grandpa
Dialogue: 0,0:07:41.60,0:07:42.94,JP,,0000,0000,0000,,Ата
Dialogue: 0,0:07:45.00,0:07:45.94,JP,,0000,0000,0000,,«және күн сайын күрсінемін.»
Dialogue: 0,0:07:47.86,0:07:49.92,JP,,0000,0000,0000,,Бұл Делла-чанға арналған.
Dialogue: 0,0:07:50.75,0:07:53.26,JP,,0000,0000,0000,,Мен солай айтамын, бірақ мені аямайсың ба?
Dialogue: 0,0:07:53.89,0:07:58.64,JP,,0000,0000,0000,,Менің ойымша, бұл дүниедегі ең қиын нәрсе аш болу.
Dialogue: 0,0:07:58.91,0:08:01.05,JP,,0000,0000,0000,,Әкемнің айтқаны рас.
Dialogue: 0,0:08:01.90,0:08:03.21,JP,,0000,0000,0000,,Мен түсінемін, бірақ
Dialogue: 0,0:08:05.35,0:08:06.29,JP,,0000,0000,0000,,Not now
Dialogue: 0,0:08:06.57,0:08:08.45,JP,,0000,0000,0000,,Оларды жасырын тамақтандырмаңыз.
Dialogue: 0,0:08:08.83,0:08:10.91,JP,,0000,0000,0000,,Маған бергенде, маған берші...
Dialogue: 0,0:08:11.20,0:08:12.27,JP,,0000,0000,0000,,Ата
Dialogue: 0,0:08:12.80,0:08:15.00,JP,,0000,0000,0000,,Ата мен әкеге қауіп төніп тұр.
Dialogue: 0,0:08:15.35,0:08:18.35,JP,,0000,0000,0000,,It's dangerous. Мен сізге міндетті түрде жасырын түрде беремін.
Dialogue: 0,0:08:18.80,0:08:20.27,JP,,0000,0000,0000,,Мен Делланы қадағалаймын.
Dialogue: 0,0:08:20.89,0:08:23.13,JP,,0000,0000,0000,,Адамдардың Канаваги-мочи жеуіне жол бермеу
Dialogue: 0,0:08:23.86,0:08:24.96,JP,,0000,0000,0000,,No rice cakes
Dialogue: 0,0:08:25.35,0:08:26.02,JP,,0000,0000,0000,,№
Dialogue: 0,0:08:26.36,0:08:29.21,JP,,0000,0000,0000,,А, иә, мен Делланы мектепке апарамын.
Dialogue: 0,0:08:29.44,0:08:30.46,JP,,0000,0000,0000,,Мен сенің жаныңда бақылап тұрамын.
Dialogue: 0,0:08:30.65,0:08:31.50,JP,,0000,0000,0000,,Тоқтат! Сол жерде тоқта!
Dialogue: 0,0:08:31.85,0:08:34.00,JP,,0000,0000,0000,,Оны Тамакоға жалғыз қалдырғаныма өкінемін.
Dialogue: 0,0:08:34.00,0:08:36.64,JP,,0000,0000,0000,,Жоқ, жоқ, жоқ, шектен шыққан
Dialogue: 0,0:08:36.64,0:08:40.85,JP,,0000,0000,0000,,Ол мүмкіндікті пайдаланып, қариядан күріш тортын алуды ойлап жүргеніне сенімдімін.
Dialogue: 0,0:08:41.87,0:08:43.92,JP,,0000,0000,0000,,Мен сенің не ойлайтыныңды білемін.
Dialogue: 0,0:08:44.11,0:08:47.38,JP,,0000,0000,0000,,Бірақ Чой мырза бар болса, ол көзге түседі.
Dialogue: 0,0:08:47.65,0:08:51.07,JP,,0000,0000,0000,,Чой мырза бұл туралы көп білмейтін сияқты.
Dialogue: 0,0:08:51.63,0:08:54.68,JP,,0000,0000,0000,,Мектепке бару үшін біліктілік қажет
Dialogue: 0,0:08:54.68,0:08:55.63,JP,,0000,0000,0000,,Қандай біліктілік?
Dialogue: 0,0:08:57.66,0:08:59.67,JP,,0000,0000,0000,,Мұндай жағдайларды алдын ала болжайтын сен — нағыз кереметсің.
Dialogue: 0,0:08:59.67,0:09:01.30,JP,,0000,0000,0000,,Емтихан, форма және т.б.
Dialogue: 0,0:09:01.37,0:09:05.14,JP,,0000,0000,0000,,Емтихан, форма және т.б.
Dialogue: 0,0:09:05.66,0:09:07.76,JP,,0000,0000,0000,,Уайымдама, мен ақылдымын.
Dialogue: 0,0:09:08.14,0:09:09.51,JP,,0000,0000,0000,,Емтихан деген ұғым жоқ.
Dialogue: 0,0:09:09.57,0:09:11.39,JP,,0000,0000,0000,,Бірақ, бірақ, біркелкі және т.б.
Dialogue: 0,0:09:11.39,0:09:12.38,JP,,0000,0000,0000,,Біркелкі
Dialogue: 0,0:09:12.50,0:09:13.29,JP,,0000,0000,0000,,Міне
Dialogue: 0,0:09:14.80,0:09:15.85,JP,,0000,0000,0000,,That matching
Dialogue: 0,0:09:16.12,0:09:20.04,JP,,0000,0000,0000,,Иә, ол киімсіз мектепке бара алмайсың.
Dialogue: 0,0:09:20.04,0:09:22.36,JP,,0000,0000,0000,,Ah, what a shame. Масқара.
Dialogue: 0,0:09:22.54,0:09:27.27,JP,,0000,0000,0000,,Уайымдама, маған да бұл көйлек ұнайды.
Dialogue: 0,0:09:28.44,0:09:29.22,JP,,0000,0000,0000,,May be worn
Dialogue: 0,0:09:29.81,0:09:31.80,JP,,0000,0000,0000,,Көрдім, мен бақыттымын.
Dialogue: 0,0:09:31.80,0:09:33.72,JP,,0000,0000,0000,,Чой Чанға да ұнайды.
Dialogue: 0,0:09:33.97,0:09:35.77,JP,,0000,0000,0000,,Иә, бұл жақсы.
Dialogue: 0,0:09:36.45,0:09:39.44,JP,,0000,0000,0000,,Біз бәріміз бірдейміз және жақсы араласатындай сезінеміз.
Dialogue: 0,0:09:40.11,0:09:42.01,JP,,0000,0000,0000,,Біреу маған бірінші рет осылай айтты.
Dialogue: 0,0:09:42.01,0:09:45.14,JP,,0000,0000,0000,,Бірақ менде қалған форма жоқ.
Dialogue: 0,0:09:45.61,0:09:47.34,JP,,0000,0000,0000,,Түсіндім, не істеуім керек?
Dialogue: 0,0:09:47.73,0:09:50.57,JP,,0000,0000,0000,,Жоқ, жоқ, бұл көңілсіз болды.
Dialogue: 0,0:09:50.81,0:09:54.05,JP,,0000,0000,0000,,Иә, қарсы болмасаң, нағашымның әпкесі.
Dialogue: 0,0:10:24.52,0:10:25.76,JP,,0000,0000,0000,,Мен оны асыға күтемін.
Dialogue: 0,0:10:25.78,0:10:26.50,JP,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:10:26.98,0:10:29.41,JP,,0000,0000,0000,,Сізді күткенім үшін кешіріңіз. Тек мынаны же.
Dialogue: 0,0:10:29.81,0:10:32.31,JP,,0000,0000,0000,,Таң Дайфуку Итадакимасу
Dialogue: 0,0:10:32.98,0:10:34.10,JP,,0000,0000,0000,,Itadadakimasu
Dialogue: 0,0:10:34.10,0:10:34.70,JP,,0000,0000,0000,,Иә.
Dialogue: 0,0:10:35.35,0:10:37.20,JP,,0000,0000,0000,,Бұл таңғы дайфуку.
Dialogue: 0,0:10:37.31,0:10:38.80,JP,,0000,0000,0000,,Таңертеңгілік карри мағынасында
Dialogue: 0,0:10:39.38,0:10:41.21,JP,,0000,0000,0000,,А, Карри.
Dialogue: 0,0:10:41.55,0:10:42.67,JP,,0000,0000,0000,,Менің қыздарым
Dialogue: 0,0:10:43.69,0:10:45.53,JP,,0000,0000,0000,,Маған да бере аласыз ба?
Dialogue: 0,0:10:46.99,0:10:49.72,JP,,0000,0000,0000,,Иә, қалаймын, бірақ істей алмаймын.
Dialogue: 0,0:10:49.87,0:10:52.87,JP,,0000,0000,0000,,Мұның бәрі мен мырзаны ойлағаным үшін.
Dialogue: 0,0:10:53.09,0:10:56.21,JP,,0000,0000,0000,,Олай болса, оған көмектесу мүмкін емес.
Dialogue: 0,0:10:57.59,0:11:00.20,JP,,0000,0000,0000,,Дәмді, бірақ қайғылы
Dialogue: 0,0:11:00.52,0:11:03.18,JP,,0000,0000,0000,,Дәмді Дәмді - ащы
Dialogue: 0,0:11:06.43,0:11:07.68,JP,,0000,0000,0000,,Ащы
Dialogue: 0,0:11:08.38,0:11:09.85,JP,,0000,0000,0000,,Тама-чан әлі
Dialogue: 0,0:11:10.13,0:11:11.21,JP,,0000,0000,0000,,Қазір барыңыз
Dialogue: 0,0:11:11.39,0:11:13.20,JP,,0000,0000,0000,,Бұл шынымен жақсы ма?
Dialogue: 0,0:11:13.20,0:11:14.57,JP,,0000,0000,0000,,Жер
Dialogue: 0,0:11:14.75,0:11:18.06,JP,,0000,0000,0000,,Бұл біртүрлі, дәлірек айтсақ, дұрыс емес сияқты.
Dialogue: 0,0:11:18.06,0:11:20.53,JP,,0000,0000,0000,,Бұл менің қиялым, Чой Чан, өте жақсы
Dialogue: 0,0:11:21.82,0:11:22.78,JP,,0000,0000,0000,,Күткеніңізге рахмет
Dialogue: 0,0:11:23.05,0:11:24.54,JP,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:11:24.82,0:11:26.01,JP,,0000,0000,0000,,Бұл сүйкімді
Dialogue: 0,0:11:26.01,0:11:26.64,JP,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:11:26.98,0:11:28.01,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:11:28.22,0:11:32.58,JP,,0000,0000,0000,,Нафталиннің иісі жоқ. Менің ойымша, бұл гардероб үшін өте жақсы тыңайтқыш болды.
Dialogue: 0,0:11:32.93,0:11:34.03,JP,,0000,0000,0000,,Ал Кира
Dialogue: 0,0:11:34.65,0:11:36.54,JP,,0000,0000,0000,,Бірінің үстіне бірін үйіп тастамасқа амал жоқ
Dialogue: 0,0:11:37.33,0:11:39.13,JP,,0000,0000,0000,,Делла ғана емес, мен де.
Dialogue: 0,0:11:39.49,0:11:42.45,JP,,0000,0000,0000,,Жоқ, жоқ, мен сізге көмектесе алатыныма қуаныштымын.
Dialogue: 0,0:11:45.17,0:11:46.90,JP,,0000,0000,0000,,Ұрыс, мырза.
Dialogue: 0,0:11:47.00,0:11:49.71,JP,,0000,0000,0000,,Канна-чанның үйіне барымызды салайық
Dialogue: 0,0:11:49.88,0:11:54.57,JP,,0000,0000,0000,,Жоқ, осы кезде қалыпты жағдайға келгенше диета ұстануға қалай болады?
Dialogue: 0,0:11:54.79,0:11:56.87,JP,,0000,0000,0000,,Бұл басты жын ба?
Dialogue: 0,0:11:57.08,0:11:58.72,JP,,0000,0000,0000,,Ей, эй, мен шағымданбаймын.
Dialogue: 0,0:11:58.97,0:12:01.35,JP,,0000,0000,0000,,Мектепке келсең Оричан сені күтіп алады.
Dialogue: 0,0:12:02.50,0:12:03.46,JP,,0000,0000,0000,,Шиори-чан?
Dialogue: 0,0:12:04.11,0:12:04.84,JP,,0000,0000,0000,,Делла-чанның сүйіктісі...
Dialogue: 0,0:12:04.84,0:12:06.85,JP,,0000,0000,0000,,Не айтып тұрсың, қызым?
Dialogue: 0,0:12:07.15,0:12:09.92,JP,,0000,0000,0000,,Ханзадаға әйел табу басты міндет болса да.
Dialogue: 0,0:12:10.29,0:12:12.28,JP,,0000,0000,0000,,Сіз нені елемейсіз?
Dialogue: 0,0:12:12.28,0:12:14.33,JP,,0000,0000,0000,,Оны қалдырмаңыз Оны қалдырмаңыз
Dialogue: 0,0:12:14.33,0:12:15.57,JP,,0000,0000,0000,,Жарайды, ең алдымен арықтаңыз.
Dialogue: 0,0:12:15.57,0:12:16.40,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:12:27.31,0:12:30.15,JP,,0000,0000,0000,,Иә, тәпішке. Чойчан бұларды пайдалануы керек.
Dialogue: 0,0:12:30.58,0:12:31.28,JP,,0000,0000,0000,,Хмм
Dialogue: 0,0:12:35.05,0:12:36.88,JP,,0000,0000,0000,,А, мен сөмкемді қалдырамын.
Dialogue: 0,0:12:38.98,0:12:42.15,JP,,0000,0000,0000,,Бірінші кезең әлеуметтік, сондықтан Мидори-чанмен бірдей.
Dialogue: 0,0:12:47.52,0:12:49.22,JP,,0000,0000,0000,,Кешіріңіз кішкентай қыз
Dialogue: 0,0:12:49.82,0:12:50.83,JP,,0000,0000,0000,,Не не?
Dialogue: 0,0:12:51.01,0:12:54.35,JP,,0000,0000,0000,,Сонда да Тамакомен және басқалармен бірге партада оқу?
Dialogue: 0,0:12:54.70,0:12:56.37,JP,,0000,0000,0000,,Сен де ақылдысың.
Dialogue: 0,0:13:00.85,0:13:03.36,JP,,0000,0000,0000,,Мүмкін деп ойлаймын.
Dialogue: 0,0:13:03.83,0:13:07.59,JP,,0000,0000,0000,,Чой-чан, сен Канна-чанды өзіңнен жас кіші деп ойлайсың ба?
Dialogue: 0,0:13:11.19,0:13:13.08,JP,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:13:14.30,0:13:19.88,JP,,0000,0000,0000,,Кешіріңіз, мен үлкен түсініспеушілік жасадым деп ойлаймын.
Dialogue: 0,0:13:20.29,0:13:23.54,JP,,0000,0000,0000,,Жоқ, мұнымен де бір жылда 5 см өстім.
Dialogue: 0,0:13:23.86,0:13:25.76,JP,,0000,0000,0000,,Нағыз азғын еліктеуші
Dialogue: 0,0:13:26.67,0:13:27.36,JP,,0000,0000,0000,,Чой-чан
Dialogue: 0,0:13:30.36,0:13:32.15,JP,,0000,0000,0000,,Форма кигенде, доссың.
Dialogue: 0,0:13:32.56,0:13:33.33,JP,,0000,0000,0000,,...
Dialogue: 0,0:13:33.47,0:13:34.32,JP,,0000,0000,0000,,Серіктер?
Dialogue: 0,0:13:34.64,0:13:35.13,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:13:40.38,0:13:41.76,JP,,0000,0000,0000,,Қайырлы таң, иә?
Dialogue: 0,0:13:44.74,0:13:46.90,JP,,0000,0000,0000,,Қайырлы таң, Шиори-сан
Dialogue: 0,0:13:47.93,0:13:48.67,JP,,0000,0000,0000,,Жақсы
Dialogue: 0,0:13:49.16,0:13:50.57,JP,,0000,0000,0000,,Сіздерді таныстыруға рұқсат етіңіздер.
Dialogue: 0,0:13:51.03,0:13:55.99,JP,,0000,0000,0000,,Бұл Чой Мочимадзуи, уақытша алмасу студенті және турға қатысушы.
Dialogue: 0,0:13:56.44,0:13:59.46,JP,,0000,0000,0000,,Айтпақшы, бұл тұлыптың рөлін ойнайтын мырза.
Dialogue: 0,0:14:01.43,0:14:06.16,JP,,0000,0000,0000,,Ойланып қарасам, бұрын ондай нәрсені естімеген сияқтымын.
Dialogue: 0,0:14:06.55,0:14:08.31,JP,,0000,0000,0000,,Иә, естідім.
Dialogue: 0,0:14:10.49,0:14:11.97,JP,,0000,0000,0000,,Сізде оқулық бар ма?
Dialogue: 0,0:14:12.10,0:14:13.30,JP,,0000,0000,0000,,I
Dialogue: 0,0:14:13.81,0:14:15.69,JP,,0000,0000,0000,,Бірдеңені түсінбесеңіз, менен сұраңыз.
Dialogue: 0,0:14:15.83,0:14:16.64,JP,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:14:16.88,0:14:19.98,JP,,0000,0000,0000,,Мұнда үш маңызды тармақ бар. Біреуі
Dialogue: 0,0:14:20.26,0:14:23.49,JP,,0000,0000,0000,,Бірі – Адам Смиттің лессез-фэйр саясаты.
Dialogue: 0,0:14:24.15,0:14:24.73,JP,,0000,0000,0000,,Содан кейін...
Dialogue: 0,0:14:19.17,0:14:20.03,JP,,0000,0000,0000,,Менің қызым
Dialogue: 0,0:14:20.16,0:14:20.76,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:14:21.09,0:14:22.81,JP,,0000,0000,0000,,Менің аяғымды тырнап аласың ба?
Dialogue: 0,0:14:24.72,0:14:26.75,JP,,0000,0000,0000,,Сіз оны жеңе алатыныңызға сенімдімін.
Dialogue: 0,0:14:26.92,0:14:27.98,JP,,0000,0000,0000,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:14:30.44,0:14:33.72,JP,,0000,0000,0000,,Сондықтан уақытша директордың өкілеттігі бойынша
Dialogue: 0,0:14:34.04,0:14:38.00,JP,,0000,0000,0000,,Бүгін біз осы мүшемен арнайы жаттығу өткізуді шештік.
Dialogue: 0,0:14:38.18,0:14:38.80,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:14:39.13,0:14:41.09,JP,,0000,0000,0000,,Уақытша директор дегеніміз не?
Dialogue: 0,0:14:41.50,0:14:43.66,JP,,0000,0000,0000,,Какко амбициясы каккотоджи сияқты
Dialogue: 0,0:14:44.15,0:14:45.93,JP,,0000,0000,0000,,Бұл үміт емес, амбиция.
Dialogue: 0,0:14:46.61,0:14:47.38,JP,,0000,0000,0000,,Сүйкімді
Dialogue: 0,0:14:47.52,0:14:48.38,JP,,0000,0000,0000,,Танысқаныма қуаныштымын.
Dialogue: 0,0:14:48.80,0:14:51.36,JP,,0000,0000,0000,,Қызым, мен де сүйкімдімін.
Dialogue: 0,0:14:48.68,0:14:50.73,JP,,0000,0000,0000,,Чой мырза, бұл ерекше есім.
Dialogue: 0,0:14:51.03,0:14:52.35,JP,,0000,0000,0000,,Сіз қай жақтансыз?
Dialogue: 0,0:14:51.69,0:14:53.08,JP,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:14:53.70,0:14:55.30,JP,,0000,0000,0000,,Бұл не, балам...
Dialogue: 0,0:14:57.50,0:14:59.03,JP,,0000,0000,0000,,Сіз диетаны айттыңыз, солай ма?
Dialogue: 0,0:14:59.50,0:15:00.72,JP,,0000,0000,0000,,Осының үстіне?
Dialogue: 0,0:15:01.15,0:15:04.90,JP,,0000,0000,0000,,Соя соусы Мирин Сарымсақ Зімбірдің бір бөлігі Бір түнде қартаяды
Dialogue: 0,0:15:05.39,0:15:07.44,JP,,0000,0000,0000,,Иә, менің мотивациям бар.
Dialogue: 0,0:15:07.44,0:15:08.33,JP,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:15:08.56,0:15:11.77,JP,,0000,0000,0000,,Чой-чан, мен Спартаға мырзаға барамын.
Dialogue: 0,0:15:12.08,0:15:12.83,JP,,0000,0000,0000,,Әрине.
Dialogue: 0,0:15:13.64,0:15:15.97,JP,,0000,0000,0000,,Иә, барлығы шеңбер құрып тұрады.
Dialogue: 0,0:15:16.96,0:15:19.27,JP,,0000,0000,0000,,Мен сізден сұрайын деп жүрген едім.
Dialogue: 0,0:15:19.27,0:15:20.65,JP,,0000,0000,0000,,Бұл не таяқ?
Dialogue: 0,0:15:20.99,0:15:22.08,JP,,0000,0000,0000,,Сен жеңілдін ба?
Dialogue: 0,0:15:22.24,0:15:23.05,JP,,0000,0000,0000,,Цукуёми, тез бол, тез бол
Dialogue: 0,0:15:24.07,0:15:25.42,JP,,0000,0000,0000,,Мен сені ұрдым
Dialogue: 0,0:15:25.90,0:15:27.05,JP,,0000,0000,0000,,Қош бол, қызым.
Dialogue: 0,0:15:29.15,0:15:30.96,JP,,0000,0000,0000,,Не болды, мырза?
Dialogue: 0,0:15:33.88,0:15:34.81,JP,,0000,0000,0000,,(Фушигиро) Неге мұнда жүрсің, Зэн'ин-сенпай?
Dialogue: 0,0:15:37.64,0:15:39.24,JP,,0000,0000,0000,,Соққанда ауырады.
Dialogue: 0,0:15:39.89,0:15:41.48,JP,,0000,0000,0000,,Сәттілік, Делла-чан
Dialogue: 0,0:15:41.90,0:15:44.33,JP,,0000,0000,0000,,Зорлық-зомбылық
Dialogue: 0,0:15:45.01,0:15:46.74,JP,,0000,0000,0000,,Міне, құстардың айналуы
Dialogue: 0,0:15:47.00,0:15:51.28,JP,,0000,0000,0000,,Мен енді мұны істей алмаймын. Мен өлемін. Мен салмақ тастамай тұрып өлемін.
Dialogue: 0,0:15:51.28,0:15:53.54,JP,,0000,0000,0000,,Өтірік, әлі көп уақыт бар
Dialogue: 0,0:15:53.69,0:15:57.15,JP,,0000,0000,0000,,Құрметті Чой, менің жағым ауырып тұр.
Dialogue: 0,0:15:57.15,0:15:58.08,JP,,0000,0000,0000,,Мен сізге демалуға рұқсат етемін
Dialogue: 0,0:15:58.59,0:15:59.78,JP,,0000,0000,0000,,Чой мырза
Dialogue: 0,0:15:59.88,0:16:00.52,JP,,0000,0000,0000,,Кейінірек
Dialogue: 0,0:16:03.23,0:16:04.37,JP,,0000,0000,0000,,Керемет, Чой Чан.
Dialogue: 0,0:16:06.84,0:16:09.50,JP,,0000,0000,0000,,Қазірдің өзінде шекті
Dialogue: 0,0:16:14.67,0:16:15.94,JP,,0000,0000,0000,,Шиори-сан
Dialogue: 0,0:16:18.52,0:16:22.28,JP,,0000,0000,0000,,Шиори-сан, мен Шиори-сан үшінмін.
Dialogue: 0,0:16:22.28,0:16:25.17,JP,,0000,0000,0000,,Мен күшті адам болу үшін диета ұстаймын.
Dialogue: 0,0:16:27.66,0:16:28.83,JP,,0000,0000,0000,,Бадминтон
Dialogue: 0,0:16:30.21,0:16:31.08,JP,,0000,0000,0000,,Жалғасы
Dialogue: 0,0:16:31.79,0:16:32.20,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:16:32.60,0:16:33.18,JP,,0000,0000,0000,,Шешім
Dialogue: 0,0:16:39.66,0:16:41.04,JP,,0000,0000,0000,,Делла-чан, жақсысың ба?
Dialogue: 0,0:16:41.55,0:16:43.90,JP,,0000,0000,0000,,Дыбысты осы деңгейде көтеру аянышты.
Dialogue: 0,0:16:45.48,0:16:47.45,JP,,0000,0000,0000,,Мен де ертең мұқият жасаймын.
Dialogue: 0,0:16:57.08,0:16:58.28,JP,,0000,0000,0000,,Жоқ, Чой мырза
Dialogue: 0,0:16:58.28,0:17:01.16,JP,,0000,0000,0000,,Сол түшкіру менің әлжуаз келбетім үшін мені қобалжытты.
Dialogue: 0,0:17:01.16,0:17:01.95,JP,,0000,0000,0000,,А...
Dialogue: 0,0:17:01.95,0:17:02.94,JP,,0000,0000,0000,,Аа, солай ма?
Dialogue: 0,0:17:03.52,0:17:07.24,JP,,0000,0000,0000,,Чой Чан, мен тропиктік елде өстім, сондықтан Жапонияда күз салқын болуы керек.
Dialogue: 0,0:17:07.57,0:17:09.30,JP,,0000,0000,0000,,Бұл кеште одан да маңызды.
Dialogue: 0,0:17:09.76,0:17:12.95,JP,,0000,0000,0000,,Чой-чан тұратын жерде әрқашан жылы емес пе?
Dialogue: 0,0:17:13.39,0:17:14.09,JP,,0000,0000,0000,,Жалпы
Dialogue: 0,0:17:14.45,0:17:15.86,JP,,0000,0000,0000,,Сонымен, ерте күз.
Dialogue: 0,0:17:16.21,0:17:17.06,JP,,0000,0000,0000,,Ерте күз?
Dialogue: 0,0:17:17.39,0:17:18.50,JP,,0000,0000,0000,,Бірінші күз
Dialogue: 0,0:17:18.73,0:17:20.83,JP,,0000,0000,0000,,Не? Бұл сіздің алғашқы махаббатыңыз сияқты қалай айтуға болады?
Dialogue: 0,0:17:21.19,0:17:23.44,JP,,0000,0000,0000,,Мен жаңа киім алғанымда, Чой-чан
Dialogue: 0,0:17:24.49,0:17:26.57,JP,,0000,0000,0000,,Маған бұл форма керек
Dialogue: 0,0:17:27.64,0:17:30.28,JP,,0000,0000,0000,,Форма біркелкі, сән – сән.
Dialogue: 0,0:17:32.14,0:17:34.18,JP,,0000,0000,0000,,Чой-чан, тоқылған көйлек ше?
Dialogue: 0,0:17:34.51,0:17:36.31,JP,,0000,0000,0000,,Қолдан тоқылған ою да бар.
Dialogue: 0,0:17:36.72,0:17:40.89,JP,,0000,0000,0000,,Жоқ, жоқ, жоқ, мен ақ лөлі көргім келеді.
Dialogue: 0,0:17:41.86,0:17:44.78,JP,,0000,0000,0000,,Менің ойымша, сіз қандай киім кисеңіз де, сөзсіз сүйкімді көрінесіз.
Dialogue: 0,0:17:44.78,0:17:47.25,JP,,0000,0000,0000,,А, мен киімімді ауыстырайын!
Dialogue: 0,0:17:47.25,0:17:49.35,JP,,0000,0000,0000,,Мидо-чан қосылды
Dialogue: 0,0:17:49.71,0:17:54.10,JP,,0000,0000,0000,,Богемиялық, әскери, саудалық, Кирахуа?
Dialogue: 0,0:17:54.32,0:17:56.59,JP,,0000,0000,0000,,Эй, Чой Чан, бір қарап алайық.
Dialogue: 0,0:17:52.36,0:17:53.33,JP,,0000,0000,0000,,Бұл сәнді ме?
Dialogue: 0,0:17:54.79,0:17:58.74,JP,,0000,0000,0000,,Қаласаңыз, оны менің киімімнің шеберлеріне қалдыра аласыз.
Dialogue: 0,0:17:56.59,0:17:58.69,JP,,0000,0000,0000,,Егер бұлай болса, менің кетуден басқа амалым жоқ.
Dialogue: 0,0:17:58.84,0:18:00.80,JP,,0000,0000,0000,,Кеттік, Чой Чан.
Dialogue: 0,0:18:05.39,0:18:08.02,JP,,0000,0000,0000,,Біздің үй неге ұқсайды?
Dialogue: 0,0:18:08.09,0:18:10.97,JP,,0000,0000,0000,,Бұл қорқыту үшін бе? Бұл қорқыту деп санала ма?
Dialogue: 0,0:18:12.58,0:18:13.94,JP,,0000,0000,0000,,Маған қоңырау шалмадың ба?
Dialogue: 0,0:18:14.33,0:18:16.10,JP,,0000,0000,0000,,Сонымен бұл не?
Dialogue: 0,0:18:17.90,0:18:19.79,JP,,0000,0000,0000,,Бұл ұя төсегіне жақсы болатын сияқты.
Dialogue: 0,0:18:20.06,0:18:21.70,JP,,0000,0000,0000,,Мен ештеңеге мән бермеймін
Dialogue: 0,0:18:21.70,0:18:22.42,JP,,0000,0000,0000,,No
Dialogue: 0,0:18:22.51,0:18:23.52,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:18:27.54,0:18:30.68,JP,,0000,0000,0000,,Менің негізгі мақсатым 50-ге жуық.
Dialogue: 0,0:18:31.39,0:18:34.58,JP,,0000,0000,0000,,Ашиноның серігі осылай істеп жатыр. Онда барайық.
Dialogue: 0,0:18:37.83,0:18:39.51,JP,,0000,0000,0000,,Екінші қол киім дүкені
Dialogue: 0,0:18:39.86,0:18:41.96,JP,,0000,0000,0000,,Усагияма тән емес дәм
Dialogue: 0,0:18:42.42,0:18:45.15,JP,,0000,0000,0000,,А, не, тұтынушы?
Dialogue: 0,0:18:45.47,0:18:47.29,JP,,0000,0000,0000,,Иә, сәлем.
Dialogue: 0,0:18:47.86,0:18:48.68,JP,,0000,0000,0000,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:18:49.05,0:18:52.32,JP,,0000,0000,0000,,А, жанып тұр.
Dialogue: 0,0:18:55.70,0:18:56.40,JP,,0000,0000,0000,,Чой-чан
Dialogue: 0,0:18:57.17,0:18:58.29,JP,,0000,0000,0000,,Мисо киген Мисо киген
Dialogue: 0,0:18:58.76,0:19:00.42,JP,,0000,0000,0000,,Әй, жарайды, жарайды.
Dialogue: 0,0:19:02.85,0:19:04.05,JP,,0000,0000,0000,,Ыстық па?
Dialogue: 0,0:19:04.39,0:19:06.47,JP,,0000,0000,0000,,Бәлкім, мен аз киім киетін елден болғанымнан шығар.
Dialogue: 0,0:19:07.04,0:19:08.08,JP,,0000,0000,0000,,Бұл туралы не деуге болады?
Dialogue: 0,0:19:08.93,0:19:09.71,JP,,0000,0000,0000,,Сізге қалай ұнайды?
Dialogue: 0,0:19:10.37,0:19:11.97,JP,,0000,0000,0000,,Чойчан саған жақсы көрінеді.
Dialogue: 0,0:19:12.21,0:19:13.22,JP,,0000,0000,0000,,Суретке түсіру
Dialogue: 0,0:19:13.27,0:19:15.42,JP,,0000,0000,0000,,Иә, иә, иә.
Dialogue: 0,0:19:13.31,0:19:16.15,JP,,0000,0000,0000,,Қыздарым, менің координациям бар ма?
Dialogue: 0,0:19:16.52,0:19:19.13,JP,,0000,0000,0000,,Мистер қазірдің өзінде жақсы.
Dialogue: 0,0:19:20.50,0:19:21.58,JP,,0000,0000,0000,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:19:16.53,0:19:20.07,JP,,0000,0000,0000,,Иә Жарайды, Мидори-чан күткендей, Митате Банчо
Dialogue: 0,0:19:20.28,0:19:21.58,JP,,0000,0000,0000,,Бұл анық емес
Dialogue: 0,0:19:24.28,0:19:27.01,JP,,0000,0000,0000,,Ей, неге айтпадың?
Dialogue: 0,0:19:27.21,0:19:29.92,JP,,0000,0000,0000,,Анко да менімен бірге дүкенге барғысы келді.
Dialogue: 0,0:19:28.99,0:19:29.98,JP,,0000,0000,0000,,Бұл хош иіс
Dialogue: 0,0:19:30.25,0:19:31.37,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:19:31.81,0:19:33.53,JP,,0000,0000,0000,,Сонымен, сіз не сатып алдыңыз?
Dialogue: 0,0:19:33.86,0:19:36.60,JP,,0000,0000,0000,,Жоқ, мен оны бүгін сатып алған жоқпын.
Dialogue: 0,0:19:36.75,0:19:39.34,JP,,0000,0000,0000,,Олай болса келесі жолы мен де анко ішемін.
Dialogue: 0,0:19:39.59,0:19:40.24,JP,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:19:42.54,0:19:44.59,JP,,0000,0000,0000,,Ұрыс – жалғыздық
Dialogue: 0,0:19:45.13,0:19:48.56,JP,,0000,0000,0000,,Жеңіс нұры ұзақ түннен кейін келеді
Dialogue: 0,0:19:51.00,0:19:52.54,JP,,0000,0000,0000,,Чой Дера
Dialogue: 0,0:19:52.82,0:19:55.81,JP,,0000,0000,0000,,Соңғы кездері сізден хабар жоқ, жағдайыңыз жақсы ма?
Dialogue: 0,0:19:56.17,0:19:58.09,JP,,0000,0000,0000,,Чой Дера
Dialogue: 0,0:20:07.49,0:20:09.01,JP,,0000,0000,0000,,Мен бәріңді күттім.
Dialogue: 0,0:20:10.07,0:20:12.01,JP,,0000,0000,0000,,Бұл қалай кесілген?
Dialogue: 0,0:20:12.49,0:20:14.31,JP,,0000,0000,0000,,Мен енді мені тауық деп атауға рұқсат бермеймін.
Dialogue: 0,0:20:14.74,0:20:16.70,JP,,0000,0000,0000,,Не болды, Делла-чан?
Dialogue: 0,0:20:17.18,0:20:20.14,JP,,0000,0000,0000,,Денені өзгерту туралы ойларым бар.
Dialogue: 0,0:20:20.55,0:20:22.23,JP,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:20:25.61,0:20:26.54,JP,,0000,0000,0000,,Дұрыс. Кира өлім уақытын қаншалықты өзгертсе де,
Dialogue: 0,0:20:26.77,0:20:30.66,JP,,0000,0000,0000,,Әрине, мен қазірден бастап осы пішінді сақтауға бел байладым.
Dialogue: 0,0:20:31.06,0:20:32.76,JP,,0000,0000,0000,,Бұл саңырауқұлақ сығындысы
Dialogue: 0,0:20:33.08,0:20:35.05,JP,,0000,0000,0000,,Бұл қоректік, сондықтан оны тамақтандырыңыз.
Dialogue: 0,0:20:39.72,0:20:41.70,JP,,0000,0000,0000,,Құрмет немесе құрмет?
Dialogue: 0,0:20:42.38,0:20:43.76,JP,,0000,0000,0000,,Жанашырлық танытуға ұқсайды.
Dialogue: 0,0:20:43.91,0:20:44.47,JP,,0000,0000,0000,,Бұл сенсің ғой, иә?
Dialogue: 0,0:20:44.73,0:20:46.96,JP,,0000,0000,0000,,Сауда ауданындағы адамдар үшін
Dialogue: 0,0:20:46.96,0:20:50.30,JP,,0000,0000,0000,,Дера жалқау және жалқау дегенді білдіре ме?
Dialogue: 0,0:20:50.69,0:20:52.25,JP,,0000,0000,0000,,Енді қаламаймын
Dialogue: 0,0:20:52.40,0:20:53.09,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:20:54.10,0:20:55.14,JP,,0000,0000,0000,,Каннани Мидори
Dialogue: 0,0:20:55.88,0:20:57.03,JP,,0000,0000,0000,,Чой-чан бұл
Dialogue: 0,0:20:59.00,0:21:01.24,JP,,0000,0000,0000,,Мидори Токиваның таңдауы
Dialogue: 0,0:21:01.58,0:21:03.96,JP,,0000,0000,0000,,Канна Макино бойынша өлшеу
Dialogue: 0,0:21:04.27,0:21:05.93,JP,,0000,0000,0000,,Чой Чан Ашайық
Dialogue: 0,0:21:19.90,0:21:20.91,JP,,0000,0000,0000,,Сүйкімді
Dialogue: 0,0:21:21.18,0:21:23.64,JP,,0000,0000,0000,,Маған қандай құрмет көрсетесіз?
Dialogue: 0,0:21:24.14,0:21:24.71,JP,,0000,0000,0000,,және үшінші (Three) фильмде алғашқы болып өлген адамның немересі, және т.б.—
Dialogue: 0,0:21:25.17,0:21:26.72,JP,,0000,0000,0000,,Оны жасырудың қажеті жоқ.
Dialogue: 0,0:21:26.85,0:21:28.12,JP,,0000,0000,0000,,Мен мұны жасырмаймын.
Dialogue: 0,0:21:28.54,0:21:31.15,JP,,0000,0000,0000,,Менің айтайын дегенім, сіздің денеңіз сондай жиіркенішті.
Dialogue: 0,0:21:31.33,0:21:31.95,JP,,0000,0000,0000,,Кимо...
Dialogue: 0,0:21:32.24,0:21:33.82,JP,,0000,0000,0000,,Бұл сұлулықты қалай түсінуге болады?
Dialogue: 0,0:21:34.17,0:21:35.90,JP,,0000,0000,0000,,Иә, менің үйіме не болды?
Dialogue: 0,0:21:36.08,0:21:37.37,JP,,0000,0000,0000,,Аа, қазір ойлап қарасам
Dialogue: 0,0:21:37.37,0:21:39.62,JP,,0000,0000,0000,,Кешіріңіз мырза, мен оны бүгін әкелген жоқпын.
Dialogue: 0,0:21:40.80,0:21:41.54,JP,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:48.14,0:21:49.17,JP,,0000,0000,0000,,Күздің басы
Dialogue: 0,0:21:50.54,0:21:53.93,JP,,0000,0000,0000,,Жыл мезгілдері ауысып, ауа таза, таза болады.
Dialogue: 0,0:21:54.62,0:21:56.81,JP,,0000,0000,0000,,Адамгершілік пен жылулық
Dialogue: 0,0:21:57.31,0:22:00.01,JP,,0000,0000,0000,,Менің жүрегім күзгі жапырақтардың түсіне боялған
Dialogue: 0,0:23:35.79,0:23:39.03,JP,,0000,0000,0000,,Менің атым Тамако, менің ойымша, қуырылған мочи картоп чиптеріне қарағанда дәмдірек.
Dialogue: 0,0:23:39.19,0:23:42.78,JP,,0000,0000,0000,,Күріштен қалған тортты кептіріп, қытырлақ болғанша қуырсаңыз дәмді болады.
Dialogue: 0,0:23:43.16,0:23:44.56,JP,,0000,0000,0000,,Үстіне тұз себуге болады.
Dialogue: 0,0:23:44.56,0:23:46.46,JP,,0000,0000,0000,,Сіз жасыл балдырды немесе қара бұрышты пайдалана аласыз.
Dialogue: 0,0:23:46.84,0:23:48.87,JP,,0000,0000,0000,,Келесі жолы қандай күріш тортын жеуге болады?
Dialogue: 0,0:00:05.61,0:00:06.82,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:00:07.58,0:00:08.78,CN,,0000,0000,0000,,Бұл Құдайдың есімі
Dialogue: 0,0:00:09.97,0:00:11.77,CN,,0000,0000,0000,,Мен қазір дүкеніммен айналысып жатырмын.
Dialogue: 0,0:00:12.94,0:00:14.92,CN,,0000,0000,0000,,Канна-ку
Dialogue: 0,0:00:15.32,0:00:18.64,CN,,0000,0000,0000,,Бұл өте жақсы.
Dialogue: 0,0:00:17.66,0:00:21.65,CN,,0000,0000,0000,,Дүкенімді ашқанда каштан жеп біттім.
Dialogue: 0,0:00:19.22,0:00:21.84,CN,,0000,0000,0000,,Екінші келу
Dialogue: 0,0:00:23.60,0:00:24.55,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:25.01,0:00:25.96,CN,,0000,0000,0000,,Тамақ ішкенде
Dialogue: 0,0:00:26.13,0:00:27.93,CN,,0000,0000,0000,,Заң не дейді
Dialogue: 0,0:00:25.37,0:00:26.64,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:28.07,0:00:30.43,CN,,0000,0000,0000,,Мырза
Dialogue: 0,0:00:31.31,0:00:32.08,CN,,0000,0000,0000,,Қайда тұру керек
Dialogue: 0,0:00:33.00,0:00:34.72,CN,,0000,0000,0000,,Менің анық екенім анық.
Dialogue: 0,0:00:38.20,0:00:39.08,CN,,0000,0000,0000,,Сәлем
Dialogue: 0,0:00:39.51,0:00:40.13,CN,,0000,0000,0000,,Ерте
Dialogue: 0,0:00:40.90,0:00:43.13,CN,,0000,0000,0000,,Мен туралы не ойлайсың?
Dialogue: 0,0:00:43.37,0:00:44.73,CN,,0000,0000,0000,,Ерте мырза...
Dialogue: 0,0:00:48.39,0:00:50.28,CN,,0000,0000,0000,,Басқа әрекеттер
Dialogue: 0,0:00:50.70,0:00:52.29,CN,,0000,0000,0000,,Келе жатыр
Dialogue: 0,0:00:52.60,0:00:54.71,CN,,0000,0000,0000,,Сізге қызмет ету үшін емес
Dialogue: 0,0:00:56.02,0:00:58.93,CN,,0000,0000,0000,,Әңгіменің шығу тегі мынада: сіз оны шынымен қалайсыз.
Dialogue: 0,0:00:59.14,0:01:00.12,CN,,0000,0000,0000,,Осы бетті қараңыз
Dialogue: 0,0:01:04.13,0:01:05.36,CN,,0000,0000,0000,,Бұл Декладағы саятшылық.
Dialogue: 0,0:01:05.83,0:01:08.83,CN,,0000,0000,0000,,Ағаш тақта бар, мен мұнда мырзаны жасадым.
Dialogue: 0,0:01:09.23,0:01:12.37,CN,,0000,0000,0000,,Мен бұл цех үшін ең жақсы құрылым екенін түсінемін.
Dialogue: 0,0:01:09.41,0:01:13.62,CN,,0000,0000,0000,,Мен бірдеңе сатып аламын ба, бәрібір.
Dialogue: 0,0:01:13.76,0:01:14.50,CN,,0000,0000,0000,,және интернатта тұратын оқушылар мен күндізгі бөлімде оқитындар арасында шиеленіс бар.
Dialogue: 0,0:01:14.50,0:01:16.03,CN,,0000,0000,0000,,Нағыз футан - бұл канна ку
Dialogue: 0,0:01:16.30,0:01:20.09,CN,,0000,0000,0000,,Кіші-кішкентай жылдар өтті, Бұл қол шын емес.
Dialogue: 0,0:01:18.72,0:01:20.80,CN,,0000,0000,0000,,Суық және немқұрайлы өрнек - өзін-өзі кемсітетін өрнек.
Dialogue: 0,0:01:21.44,0:01:23.76,CN,,0000,0000,0000,,Себебі сәл басқаша.
Dialogue: 0,0:01:23.89,0:01:25.43,CN,,0000,0000,0000,,...
Dialogue: 0,0:01:25.78,0:01:29.48,CN,,0000,0000,0000,,Еңбегіңізге рахмет.
Dialogue: 0,0:01:31.28,0:01:35.02,CN,,0000,0000,0000,,Бұл сұрақтың жауабы.
Dialogue: 0,0:01:35.46,0:01:39.09,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:01:39.27,0:01:42.12,CN,,0000,0000,0000,,Менің қасиетім деп астана десе де болады...
Dialogue: 0,0:01:42.12,0:01:44.58,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:01:48.02,0:01:49.85,CN,,0000,0000,0000,,Мен бірінші қадамымды кесіп өту ниетімен аяқтадым.
Dialogue: 0,0:01:51.15,0:01:51.99,CN,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:01:55.15,0:01:56.09,CN,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:01:56.37,0:01:59.01,CN,,0000,0000,0000,,Кіреберіс тар болуы керек.
Dialogue: 0,0:02:00.37,0:02:02.12,CN,,0000,0000,0000,,...
Dialogue: 0,0:02:08.23,0:02:12.12,CN,,0000,0000,0000,,Кішкентай жеңгеге деген махаббатын білдіру
Dialogue: 0,0:02:30.96,0:02:32.10,CN,,0000,0000,0000,,Мен кінәлімін.
Dialogue: 0,0:02:32.93,0:02:34.86,CN,,0000,0000,0000,,...
Dialogue: 0,0:02:34.93,0:02:35.95,CN,,0000,0000,0000,,...
Dialogue: 0,0:02:36.14,0:02:39.48,CN,,0000,0000,0000,,...
Dialogue: 0,0:02:39.72,0:02:41.10,CN,,0000,0000,0000,,Бұл өмір бойы қорлық
Dialogue: 0,0:02:41.25,0:02:42.75,CN,,0000,0000,0000,,Мен ескі ағаш қалдықтарын алдым.
Dialogue: 0,0:02:44.21,0:02:45.09,CN,,0000,0000,0000,,3-бөлім: Түрмедегі бандиттермен кездесу
Dialogue: 0,0:02:45.09,0:02:46.01,CN,,0000,0000,0000,,Таро ақысы
Dialogue: 0,0:02:46.01,0:02:47.68,CN,,0000,0000,0000,,Тәкаппар жеңгем
Dialogue: 0,0:02:48.83,0:02:50.91,CN,,0000,0000,0000,,Қылмыстық құқық бұзушылық
Dialogue: 0,0:02:51.86,0:02:52.41,CN,,0000,0000,0000,,Демек, бұл Деку.
Dialogue: 0,0:02:53.35,0:02:55.06,CN,,0000,0000,0000,,Ұзақ мерзімді табыс
Dialogue: 0,0:02:57.37,0:02:59.67,CN,,0000,0000,0000,,Каштан сорпасын жейміз
31-бөлім
Dialogue: 0,0:02:59.67,0:03:03.13,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:03.42,0:03:05.64,CN,,0000,0000,0000,,Есепті есептеу мүмкін емес...
Dialogue: 0,0:03:05.64,0:03:08.30,CN,,0000,0000,0000,,Оны қолданып көрмеңіз
Dialogue: 0,0:03:08.30,0:03:09.99,CN,,0000,0000,0000,,Бұл тұрарлық емес.
Dialogue: 0,0:03:09.99,0:03:10.98,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:12.40,0:03:13.45,CN,,0000,0000,0000,,Мәліметтерді қараңыз
Dialogue: 0,0:03:14.96,0:03:15.98,CN,,0000,0000,0000,,Ұрықтану
Dialogue: 0,0:03:17.59,0:03:18.67,CN,,0000,0000,0000,,Мойын ұшының қозғалысы
Dialogue: 0,0:03:18.83,0:03:20.50,CN,,0000,0000,0000,,Алдын ала диеталық шектеулер жоқ
Dialogue: 0,0:03:38.12,0:03:40.34,CN,,0000,0000,0000,,Тамақтан бас тарту...тамақ қабылдау
Dialogue: 0,0:03:40.40,0:03:42.74,CN,,0000,0000,0000,,Ең аз күш қажет
Dialogue: 0,0:03:42.86,0:03:43.95,CN,,0000,0000,0000,,Нана Наята...
Dialogue: 0,0:03:43.95,0:03:46.89,CN,,0000,0000,0000,,Ұрықтанудың басқа әдістері
Dialogue: 0,0:03:46.99,0:03:47.55,CN,,0000,0000,0000,,Мені жіберіңізші
Dialogue: 0,0:03:47.55,0:03:48.13,CN,,0000,0000,0000,,Джунмей
Dialogue: 0,0:03:48.66,0:03:52.45,CN,,0000,0000,0000,,Тәбеттің күзі
Dialogue: 0,0:03:53.22,0:03:57.24,CN,,0000,0000,0000,,Алайда мен мұңайып отырмын.
Dialogue: 0,0:03:54.72,0:03:55.53,CN,,0000,0000,0000,,Құттықтаймыз
Dialogue: 0,0:03:57.50,0:03:58.70,CN,,0000,0000,0000,,отбасы құру
Dialogue: 0,0:03:58.84,0:04:03.39,CN,,0000,0000,0000,,Бұл әлемдегі ең қайғылы құс.
Dialogue: 0,0:05:46.57,0:05:47.65,CN,,0000,0000,0000,,Құттықтаймыз
Dialogue: 0,0:05:50.74,0:05:51.91,CN,,0000,0000,0000,,Құс
Dialogue: 0,0:05:52.05,0:05:54.30,CN,,0000,0000,0000,,Саған не болды?
Dialogue: 0,0:05:55.50,0:05:57.25,CN,,0000,0000,0000,,Мен қайдамын
Dialogue: 0,0:05:57.68,0:05:59.83,CN,,0000,0000,0000,,Менің дүкенімнің ақаулары
Dialogue: 0,0:05:59.83,0:06:02.65,CN,,0000,0000,0000,,Мен осындамын
Dialogue: 0,0:06:02.73,0:06:06.85,CN,,0000,0000,0000,,Себебі ескі стиль бастапқыдан өзгеше.
Dialogue: 0,0:06:07.03,0:06:10.10,CN,,0000,0000,0000,,Біздің дүкеннің ақаулары ең жетілдірілген және ең заманауи болып табылады.
Dialogue: 0,0:06:08.60,0:06:11.42,CN,,0000,0000,0000,,Момын жарық көрдім
Dialogue: 0,0:06:10.85,0:06:14.39,CN,,0000,0000,0000,,Бұл жаңа жұмыс.
Dialogue: 0,0:06:14.91,0:06:16.08,CN,,0000,0000,0000,,Жарайды, бұл тек менің жеке пікірім ғана.
Dialogue: 0,0:06:16.34,0:06:17.88,CN,,0000,0000,0000,,Қызметке көңілі толмады
Dialogue: 0,0:06:21.51,0:06:26.99,CN,,0000,0000,0000,,Бұл үшін май, тәтті саке, сарымсақ, зімбірдің бір бөлігі және бір түндік пайдалану қажет.
Dialogue: 0,0:06:28.54,0:06:31.01,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:31.31,0:06:33.19,CN,,0000,0000,0000,,Мен оны мүлдем жек көремін.
Dialogue: 0,0:06:33.55,0:06:35.41,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:36.56,0:06:39.06,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:39.23,0:06:40.32,CN,,0000,0000,0000,,Мырзадан
Dialogue: 0,0:06:41.63,0:06:42.56,CN,,0000,0000,0000,,Мұндайды есту өте сирек
Dialogue: 0,0:06:42.68,0:06:45.50,CN,,0000,0000,0000,,Бұл менің мырзамның қолы.
Dialogue: 0,0:06:51.99,0:06:54.17,CN,,0000,0000,0000,,Бұл да бір оқиға.
Dialogue: 0,0:06:54.42,0:06:55.98,CN,,0000,0000,0000,,Бұрын аяқталған
Dialogue: 0,0:06:56.45,0:06:58.71,CN,,0000,0000,0000,,Қолайсыздық үшін кешіріңіз, бірақ мәселе...
Dialogue: 0,0:06:58.95,0:07:00.39,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:01.02,0:07:02.81,CN,,0000,0000,0000,,Тофудың телефон нөмірі аз
Dialogue: 0,0:07:02.94,0:07:04.74,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:04.74,0:07:06.81,CN,,0000,0000,0000,,Дұрыс мағынасы дұрыс.
Dialogue: 0,0:07:06.81,0:07:08.22,CN,,0000,0000,0000,,Жұмыс орны
Dialogue: 0,0:07:08.22,0:07:08.89,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:11.48,0:07:13.67,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:14.35,0:07:16.24,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:16.36,0:07:18.30,CN,,0000,0000,0000,,Кішкентай баланы оқығанда
Dialogue: 0,0:07:18.30,0:07:19.56,CN,,0000,0000,0000,,Дарынды адам – кішкентай бала.
Dialogue: 0,0:07:20.38,0:07:23.00,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:23.73,0:07:26.03,CN,,0000,0000,0000,,Үй иесінің иесі
Dialogue: 0,0:07:26.18,0:07:27.19,CN,,0000,0000,0000,,Эйкикай
Dialogue: 0,0:07:27.90,0:07:32.84,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:07:33.32,0:07:37.78,CN,,0000,0000,0000,,Әңгімені тыңдау жақсы идея, бірақ оны оқу керек.
Dialogue: 0,0:07:39.17,0:07:40.52,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:41.60,0:07:42.94,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:45.00,0:07:45.94,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:47.86,0:07:49.92,CN,,0000,0000,0000,,Бұл астана
