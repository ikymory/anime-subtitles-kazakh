Dialogue: 0,0:01:47.12,0:01:51.68,OP-JP,,0000,0000,0000,,Мен өзімді көп адамның арасынан жүгіріп өткендей сезінемін
Dialogue: 0,0:01:51.87,0:01:54.54,OP-JP,,0000,0000,0000,,Мен сені шақырғандай.
Dialogue: 0,0:01:54.54,0:01:57.46,OP-JP,,0000,0000,0000,,Тағы да толып жатыр
Dialogue: 0,0:01:58.40,0:02:02.99,OP-JP,,0000,0000,0000,,Жан-жақта ұшқан фаворитизмді мақтан тұтамын
Dialogue: 0,0:02:03.11,0:02:09.00,OP-JP,,0000,0000,0000,,Мен өзімнің күткен үміттеріме қуанғым келеді
Dialogue: 0,0:02:09.59,0:02:12.12,OP-JP,,0000,0000,0000,,Мен тік тұрдым.
Dialogue: 0,0:02:12.40,0:02:14.76,OP-JP,,0000,0000,0000,,Мен көптен бері күттім
Dialogue: 0,0:02:14.76,0:02:16.66,OP-JP,,0000,0000,0000,,Бірінен-бірі өтіп бара жатқан күлкілер
Dialogue: 0,0:02:16.81,0:02:20.53,OP-JP,,0000,0000,0000,,Мен сені қатты құшақтағым келеді
Dialogue: 0,0:02:23.24,0:02:25.95,OP-JP,,0000,0000,0000,,Келіңіздер, бәріңіз.
Dialogue: 0,0:02:26.04,0:02:33.94,OP-JP,,0000,0000,0000,,Ол әрқашан кенеттен жүгіре бастайды.
Dialogue: 0,0:02:34.02,0:02:39.84,OP-JP,,0000,0000,0000,,Кез келген кештің тұман болатыны сияқты.
Dialogue: 0,0:02:40.09,0:02:47.02,OP-JP,,0000,0000,0000,,Бұл жерді жарқыраған жерде тексеру
Dialogue: 0,0:22:06.02,0:22:09.58,ED-JP,,0000,0000,0000,,бұрылыс жазбасы
Dialogue: 0,0:22:09.58,0:22:13.06,ED-JP,,0000,0000,0000,,Егер ісініп, жарылып кетсе
Dialogue: 0,0:22:13.06,0:22:18.42,ED-JP,,0000,0000,0000,,Бұл күйдірілген жазба болады.
Dialogue: 0,0:22:20.50,0:22:25.59,ED-JP,,0000,0000,0000,,Шаш кептіргішпен түзетілмейтін көңіл-күй
Dialogue: 0,0:22:27.64,0:22:31.50,ED-JP,,0000,0000,0000,,Мен кеше тым көп сөйледім
Dialogue: 0,0:22:34.54,0:22:39.61,ED-JP,,0000,0000,0000,,Мен контактілерді жоюға тырыстым.
Dialogue: 0,0:22:41.54,0:22:45.17,ED-JP,,0000,0000,0000,,Дүние бұлыңғыр
Dialogue: 0,0:22:47.25,0:22:50.55,ED-JP,,0000,0000,0000,,Бір сәтке
Dialogue: 0,0:22:50.55,0:22:54.05,ED-JP,,0000,0000,0000,,Мен сенің тұрған жеріңді тексеремін.
Dialogue: 0,0:22:54.25,0:23:01.28,ED-JP,,0000,0000,0000,,Бір күні сені тастап кетемін бе деп ойлаймын
Dialogue: 0,0:23:04.69,0:23:08.19,ED-JP,,0000,0000,0000,,Әрқашан бірдеңе іздеу
Dialogue: 0,0:23:08.19,0:23:11.78,ED-JP,,0000,0000,0000,,Жақын жерде жасырыну
Dialogue: 0,0:23:11.78,0:23:17.26,ED-JP,,0000,0000,0000,,Мен бұлдыр сезімді білсем де
Dialogue: 0,0:23:18.11,0:23:22.29,ED-JP,,0000,0000,0000,,Ах, иіру, иіру, жазулар
Dialogue: 0,0:23:22.29,0:23:25.78,ED-JP,,0000,0000,0000,,Ол ісініп, жарылып кетеді.
Dialogue: 0,0:23:25.78,0:23:30.84,ED-JP,,0000,0000,0000,,Бірақ, жұмбақ әуен
Dialogue: 0,0:23:32.10,0:23:34.70,ED-JP,,0000,0000,0000,,Мен оны ешқашан ұмытпаймын
Dialogue: 0,0:02:57.94,0:03:07.95,Staff,,0000,0000,0000,,Осы субтитр көзімен жасалған, God Subtitles Group (kamigami.org), жеткізу алмасу оқыту, коммерциялық мақсатта пайдалануға тыйым салынған
Dialogue: 0,0:02:57.94,0:03:07.95,Staff,,0000,0000,0000,,:& :&NOKI :& : : :
Dialogue: 0,0:00:01.25,0:00:03.09,JP,,0000,0000,0000,,Ертең сыныпты ауыстыру туралы хабарландыру болады.
Dialogue: 0,0:00:03.21,0:00:05.26,JP,,0000,0000,0000,,Қызық, сабақ қазірдің өзінде басталады ма?
Dialogue: 0,0:00:06.99,0:00:07.80,JP,,0000,0000,0000,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:00:08.43,0:00:09.79,JP,,0000,0000,0000,,Бір сыныпта оқитын болсақ жақсы болар еді.
Dialogue: 0,0:00:09.83,0:00:10.59,JP,,0000,0000,0000,,Эй
Dialogue: 0,0:00:07.88,0:00:10.57,JP,,0000,0000,0000,,Шие гүлдеп, гүлдеп көктем
Dialogue: 0,0:00:11.31,0:00:13.95,JP,,0000,0000,0000,,Бүршік мезгілінде көтерілетін жүрек
Dialogue: 0,0:00:15.32,0:00:16.95,JP,,0000,0000,0000,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:00:16.95,0:00:20.03,JP,,0000,0000,0000,,Мен аз ғана рейстен кейін бұлай шаршаймын деп ойламаппын.
Dialogue: 0,0:00:20.24,0:00:22.32,JP,,0000,0000,0000,,Күн жылынып барады.
Dialogue: 0,0:00:22.63,0:00:24.30,JP,,0000,0000,0000,,Ұша алмасаң, саяхаттай алмайсың
Dialogue: 0,0:00:24.84,0:00:25.94,JP,,0000,0000,0000,,Себебі мен салмақ қосып алдым.
Dialogue: 0,0:00:25.96,0:00:28.26,JP,,0000,0000,0000,,Қызым, мына мочи дәмді екен.
Dialogue: 0,0:00:28.57,0:00:29.70,JP,,0000,0000,0000,,Көктемнің дәмі бар
Dialogue: 0,0:00:30.00,0:00:31.13,JP,,0000,0000,0000,,Бұл сакурамочи
Dialogue: 0,0:00:31.29,0:00:33.13,JP,,0000,0000,0000,,Ата, 20 сакурамочи.
Dialogue: 0,0:00:33.37,0:00:34.35,JP,,0000,0000,0000,,Айо
Dialogue: 0,0:00:32.14,0:00:35.06,JP,,0000,0000,0000,,Делла-чан, сен біз алғаш кездескен кездегіден мүлде басқашасың.
Dialogue: 0,0:00:35.30,0:00:39.15,JP,,0000,0000,0000,,Күріш тортының пісіргенге дейінгі және кейінгі айырмашылығы жақсы.
Dialogue: 0,0:00:40.31,0:00:41.50,JP,,0000,0000,0000,,Тамако, жеткілікті
Dialogue: 0,0:00:41.62,0:00:43.22,JP,,0000,0000,0000,,Иә, көп рахмет.
Dialogue: 0,0:00:48.37,0:00:50.39,JP,,0000,0000,0000,,Ұш, ұш, мен
Dialogue: 0,0:00:50.57,0:00:52.33,JP,,0000,0000,0000,,Бұл не, құс?
Dialogue: 0,0:00:52.67,0:00:53.94,JP,,0000,0000,0000,,Мен құлайтын сияқты емеспін.
Dialogue: 0,0:00:54.75,0:00:55.90,JP,,0000,0000,0000,,А, мен таусылдым.
Dialogue: 0,0:00:56.18,0:00:57.42,JP,,0000,0000,0000,,Құлау Құлау
Dialogue: 0,0:01:06.99,0:01:08.49,JP,,0000,0000,0000,,Мен күткеннен де ауыр болды.
Dialogue: 0,0:01:19.15,0:01:21.74,JP,,0000,0000,0000,,Шие гүлдеп, гүлдеп көктем
Dialogue: 0,0:01:22.67,0:01:26.48,JP,,0000,0000,0000,,Аспаннан түскенде, Ғашық болдым
Dialogue: 0,0:01:26.81,0:01:27.52,JP,,0000,0000,0000,,Құс
Dialogue: 0,0:03:09.08,0:03:09.98,JP,,0000,0000,0000,,болды
Dialogue: 0,0:03:10.05,0:03:12.05,JP,,0000,0000,0000,,С тобында жоқ
Dialogue: 0,0:03:12.34,0:03:13.97,JP,,0000,0000,0000,,А сыныбы
Dialogue: 0,0:03:14.94,0:03:16.23,JP,,0000,0000,0000,,Мен де А сыныбында оқимын.
Dialogue: 0,0:03:17.60,0:03:18.83,JP,,0000,0000,0000,,Мен В сыныбында оқимын.
Dialogue: 0,0:03:18.91,0:03:20.41,JP,,0000,0000,0000,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:03:20.95,0:03:21.90,JP,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:03:22.29,0:03:25.45,JP,,0000,0000,0000,,Мен ешқашан Мидори-чаннан басқа сыныпта болмағанмын.
Dialogue: 0,0:03:26.12,0:03:27.18,JP,,0000,0000,0000,,Оған көмектесу мүмкін емес
Dialogue: 0,0:03:30.10,0:03:31.19,JP,,0000,0000,0000,,Бұл басқа сынып.
Dialogue: 0,0:03:34.06,0:03:36.30,JP,,0000,0000,0000,,Тамакомен тағы бір сабақ.
Dialogue: 0,0:03:37.89,0:03:40.04,JP,,0000,0000,0000,,Мен Асагири-санмен бір сыныпта оқимын.
Dialogue: 0,0:03:40.31,0:03:41.50,JP,,0000,0000,0000,,Бадминтон клубы
Dialogue: 0,0:03:41.74,0:03:42.39,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:03:50.17,0:03:51.66,JP,,0000,0000,0000,,Мүмкін ол мені жек көретін шығар
Dialogue: 0,0:03:58.53,0:04:00.19,JP,,0000,0000,0000,,Бұл Яги, менің сынып жетекшім.
Dialogue: 0,0:04:00.49,0:04:03.56,JP,,0000,0000,0000,,Өткен айда үйлендім, көңілім көтерілді.
Dialogue: 0,0:04:04.78,0:04:05.94,JP,,0000,0000,0000,,Неге… неге мен
Dialogue: 0,0:04:05.94,0:04:07.05,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:04:07.29,0:04:11.89,JP,,0000,0000,0000,,Жаңа сезіммен бәріміз ынталы болайық
Dialogue: 0,0:04:14.69,0:04:16.13,JP,,0000,0000,0000,,Өзіңізді таныстырыңыз
Dialogue: 0,0:04:16.49,0:04:17.39,JP,,0000,0000,0000,,Асагири-саннан
Dialogue: 0,0:04:20.36,0:04:21.71,JP,,0000,0000,0000,,Бұл Шиори Асагири.
Dialogue: 0,0:04:22.29,0:04:24.08,JP,,0000,0000,0000,,Мен бадминтон үйірмесіне қатысамын.
Dialogue: 0,0:04:24.55,0:04:25.95,JP,,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:04:26.40,0:04:27.31,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:04:27.74,0:04:29.34,JP,,0000,0000,0000,,Келесі, Инуэ мырза
Dialogue: 0,0:04:29.59,0:04:30.25,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:04:33.25,0:04:35.05,JP,,0000,0000,0000,,Келесі - Киташиракава-сан
Dialogue: 0,0:04:35.38,0:04:36.08,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:04:36.15,0:04:37.21,JP,,0000,0000,0000,,Киташиракава
Dialogue: 0,0:04:37.37,0:04:39.78,JP,,0000,0000,0000,,Бұл Тамако Киташиракава.
Dialogue: 0,0:04:40.16,0:04:44.01,JP,,0000,0000,0000,,Менің үйім - Усагияма сауда көшесіндегі «Тамая» деп аталатын күріш торттары дүкені.
Dialogue: 0,0:04:44.25,0:04:46.15,JP,,0000,0000,0000,,Сакурамоти қазір дәмді.
Dialogue: 0,0:04:46.65,0:04:48.56,JP,,0000,0000,0000,,Қаласаңыз, көріңіз.
Dialogue: 0,0:04:49.12,0:04:50.47,JP,,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:04:52.68,0:04:53.55,JP,,0000,0000,0000,,Таяқша бөлігі
Dialogue: 0,0:04:53.72,0:04:55.03,JP,,0000,0000,0000,,Бұл Канна Макино.
Dialogue: 0,0:04:55.20,0:04:57.80,JP,,0000,0000,0000,,Мен көрнекі бағалауды жақсы білемін және тік бұрыштарды жақсы көремін.
Dialogue: 0,0:04:58.10,0:04:59.99,JP,,0000,0000,0000,,Мені үйдің арқалықтары қызықтырады.
Dialogue: 0,0:05:00.20,0:05:02.83,JP,,0000,0000,0000,,Енді артқы жағындағы шкафты жөндегім келеді.
Dialogue: 0,0:05:03.47,0:05:04.53,JP,,0000,0000,0000,,Таяқша бөлігі
Dialogue: 0,0:05:05.39,0:05:07.16,JP,,0000,0000,0000,,Жаңа сабақ қалай өтті?
Dialogue: 0,0:05:07.42,0:05:08.66,JP,,0000,0000,0000,,Мен Оджимен бірге болдым.
Dialogue: 0,0:05:09.14,0:05:10.03,JP,,0000,0000,0000,,Тамако және т.б
Dialogue: 0,0:05:10.91,0:05:13.51,JP,,0000,0000,0000,,Мұғалім өте ынталы, сабақ қызықты өтетін сияқты.
Dialogue: 0,0:05:14.21,0:05:16.81,JP,,0000,0000,0000,,Егер шкафты жөндеуге болатын болса, бұл одан да жақсы сынып болар еді.
Dialogue: 0,0:05:17.25,0:05:18.22,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:05:19.68,0:05:22.86,JP,,0000,0000,0000,,Артқы жағындағы шкаф сынған, мен оны жөндегім келеді.
Dialogue: 0,0:05:25.02,0:05:27.15,JP,,0000,0000,0000,,Таңертең ерте келіп, жөндеп беруім керек пе?
Dialogue: 0,0:05:28.62,0:05:30.25,JP,,0000,0000,0000,,Оны тоқтату Тоқтату
Dialogue: 0,0:05:35.72,0:05:37.42,JP,,0000,0000,0000,,Таяқпен шеге соғуға болады ма?
Dialogue: 0,0:05:38.00,0:05:40.10,JP,,0000,0000,0000,,Жоқ, бұл қалыпты жағдай, өйткені мен соқпаймын.
Dialogue: 0,0:05:40.57,0:05:42.07,JP,,0000,0000,0000,,Бұл фильм
Dialogue: 0,0:05:42.50,0:05:43.25,JP,,0000,0000,0000,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:05:44.29,0:05:45.83,JP,,0000,0000,0000,,Әй, құс, сен не істеп жатырсың?
Dialogue: 0,0:05:46.17,0:05:47.03,JP,,0000,0000,0000,,Шығатын жол жоқ сияқты
Dialogue: 0,0:05:47.89,0:05:50.39,JP,,0000,0000,0000,,Бұл құс кинопроекторға айналады.
Dialogue: 0,0:05:50.58,0:05:52.16,JP,,0000,0000,0000,,Айтпа, бірақ
Dialogue: 0,0:05:52.16,0:05:53.54,JP,,0000,0000,0000,,Жоқ, түсінбеймін.
Dialogue: 0,0:05:59.28,0:05:59.94,JP,,0000,0000,0000,,Бұл
Dialogue: 0,0:06:01.79,0:06:04.07,JP,,0000,0000,0000,,Жалғызсың ба, жас ханым?
Dialogue: 0,0:06:05.58,0:06:08.80,JP,,0000,0000,0000,,Кішкентай қыз, құстарды жақсы көресің бе?
Dialogue: 0,0:06:11.60,0:06:13.00,JP,,0000,0000,0000,,Дене
Dialogue: 0,0:06:14.40,0:06:15.36,JP,,0000,0000,0000,,Хе-хе, рақмет
Dialogue: 0,0:06:17.30,0:06:18.50,JP,,0000,0000,0000,,бірақ әлемде не болып жатқанын білесің бе?
Dialogue: 0,0:06:19.27,0:06:21.87,JP,,0000,0000,0000,,Мен ханзадаға әйел табуым керек.
Dialogue: 0,0:06:22.42,0:06:24.62,JP,,0000,0000,0000,,Осындай нәрсені істеуге болады ма?
Dialogue: 0,0:06:26.20,0:06:26.93,JP,,0000,0000,0000,,Мұнда емес.
Dialogue: 0,0:06:28.28,0:06:29.02,JP,,0000,0000,0000,,Онда жоқ.
Dialogue: 0,0:06:29.81,0:06:32.92,JP,,0000,0000,0000,,Бұл қайда?
Dialogue: 0,0:06:33.13,0:06:34.31,JP,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:06:34.98,0:06:36.45,JP,,0000,0000,0000,,Сабыр ет, мен.
Dialogue: 0,0:06:36.93,0:06:41.14,JP,,0000,0000,0000,,Осындай кездерде, егер сіз барлық нәрсені биік жерден қарасаңыз,
Dialogue: 0,0:06:43.41,0:06:45.73,JP,,0000,0000,0000,,Бұл не болып жатыр өзі?!
Dialogue: 0,0:06:52.37,0:06:53.32,JP,,0000,0000,0000,,Таң құсы
Dialogue: 0,0:06:55.17,0:06:56.28,JP,,0000,0000,0000,,Бос уақытқа таяп қалды—
Dialogue: 0,0:06:56.99,0:06:58.31,JP,,0000,0000,0000,,Неге сөйлейсің?
Dialogue: 0,0:06:58.88,0:06:59.95,JP,,0000,0000,0000,,Құс болса да
Dialogue: 0,0:07:01.23,0:07:03.14,JP,,0000,0000,0000,,Кешіріңіз, жас ханым.
Dialogue: 0,0:07:03.80,0:07:05.45,JP,,0000,0000,0000,,Бұл құс, солай ма?
Dialogue: 0,0:07:05.68,0:07:08.00,JP,,0000,0000,0000,,Менің атым Делла Мочимадзу.
Dialogue: 0,0:07:08.46,0:07:10.45,JP,,0000,0000,0000,,Ханым, сіздің атыңыз кім?
Dialogue: 0,0:07:12.94,0:07:13.73,JP,,0000,0000,0000,,Шиори
Dialogue: 0,0:07:14.39,0:07:15.76,JP,,0000,0000,0000,,Шиори Асагири
Dialogue: 0,0:07:16.08,0:07:18.77,JP,,0000,0000,0000,,Шиори-сан, бұл жақсы есім.
Dialogue: 0,0:07:19.82,0:07:20.66,JP,,0000,0000,0000,,келді
Dialogue: 0,0:07:22.84,0:07:24.99,JP,,0000,0000,0000,,Шиори-сан, маған рахмет айтқың келсе.
Dialogue: 0,0:07:25.12,0:07:27.17,JP,,0000,0000,0000,,Менің үйіме тоқтап, шай ішіңіз.
Dialogue: 0,0:07:27.54,0:07:28.97,JP,,0000,0000,0000,,Жоқ мен осындамын
Dialogue: 0,0:07:29.06,0:07:31.04,JP,,0000,0000,0000,,Бізде дәмді сакурамочи де бар.
Dialogue: 0,0:07:31.43,0:07:32.48,JP,,0000,0000,0000,,Сакурамоти
Dialogue: 0,0:07:32.74,0:07:35.19,JP,,0000,0000,0000,,Бұл менің үйім болса да, уақытша тұратын жерім.
Dialogue: 0,0:07:35.46,0:07:36.68,JP,,0000,0000,0000,,Бұл күріш торттары дүкені.
Dialogue: 0,0:07:37.07,0:07:38.07,JP,,0000,0000,0000,,Мочи дүкені
Dialogue: 0,0:07:39.34,0:07:40.30,JP,,0000,0000,0000,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:07:40.50,0:07:42.62,JP,,0000,0000,0000,,Мен бұл Тама-чан деп ойладым.
Dialogue: 0,0:07:42.96,0:07:44.38,JP,,0000,0000,0000,,Бұл Шиори Асагири.
Dialogue: 0,0:07:44.73,0:07:46.48,JP,,0000,0000,0000,,Тама-чанмен бірдей мектеп.
Dialogue: 0,0:07:47.23,0:07:48.08,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:07:48.24,0:07:49.44,JP,,0000,0000,0000,,Бұл Шиори-сан.
Dialogue: 0,0:07:49.80,0:07:51.90,JP,,0000,0000,0000,,Танысқаныма қуаныштымын, өтінемін.
Dialogue: 0,0:07:53.59,0:07:54.69,JP,,0000,0000,0000,,О, Тори-чан
Dialogue: 0,0:07:54.98,0:07:57.44,JP,,0000,0000,0000,,Соңғы кездері қызым мені Делла-чан деп атайтын болды.
Dialogue: 0,0:07:58.11,0:07:59.53,JP,,0000,0000,0000,,Әй, бұл жақсы.
Dialogue: 0,0:08:00.05,0:08:00.91,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:08:02.27,0:08:04.06,JP,,0000,0000,0000,,О, Тама-чанның досы
Dialogue: 0,0:08:04.42,0:08:05.75,JP,,0000,0000,0000,,Ах, мм.
Dialogue: 0,0:08:06.01,0:08:07.01,JP,,0000,0000,0000,,Танысқаныма қуаныштымын.
Dialogue: 0,0:08:07.17,0:08:08.72,JP,,0000,0000,0000,,А, сәл күте тұрыңыз.
Dialogue: 0,0:08:12.55,0:08:13.61,JP,,0000,0000,0000,,Бұл дәмді болар еді
Dialogue: 0,0:08:14.81,0:08:15.53,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:08:16.19,0:08:17.21,JP,,0000,0000,0000,,Мен оралдым
Dialogue: 0,0:08:17.79,0:08:19.02,JP,,0000,0000,0000,,Қош келдіңіз...
Dialogue: 0,0:08:21.70,0:08:22.75,JP,,0000,0000,0000,,Асагири-сан
Dialogue: 0,0:08:23.39,0:08:25.24,JP,,0000,0000,0000,,Мен жоғалған жер
Dialogue: 0,0:08:25.59,0:08:28.94,JP,,0000,0000,0000,,Мұны маған осы мейірімді әрі сұлу Шиори жіберген.
Dialogue: 0,0:08:29.33,0:08:30.47,JP,,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,0:08:32.36,0:08:34.91,JP,,0000,0000,0000,,Ештеңеден қалма, ішке кірейін.
Dialogue: 0,0:08:34.97,0:08:35.97,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:08:35.97,0:08:36.65,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:08:37.99,0:08:39.68,JP,,0000,0000,0000,,Мен осы жерде кешірім сұраймын.
Dialogue: 0,0:08:40.65,0:08:43.29,JP,,0000,0000,0000,,Күте тұрыңыз, менің сакурамочиімді жеңіз.
Dialogue: 0,0:08:51.39,0:08:52.76,JP,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:08:53.62,0:08:54.47,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:09:00.11,0:09:01.16,JP,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:09:02.46,0:09:03.29,JP,,0000,0000,0000,,Itadadakimasu
Dialogue: 0,0:09:05.94,0:09:07.06,JP,,0000,0000,0000,,Бұл дәмді болар еді
Dialogue: 0,0:09:08.73,0:09:09.58,JP,,0000,0000,0000,,Бұл дәмді
Dialogue: 0,0:09:12.58,0:09:13.68,JP,,0000,0000,0000,,Жақсы
Dialogue: 0,0:09:14.61,0:09:15.69,JP,,0000,0000,0000,,Мен бақыттымын.
Dialogue: 0,0:09:16.26,0:09:18.48,JP,,0000,0000,0000,,Асагири-санның үйіме келетініне сене алар емеспін.
Dialogue: 0,0:09:20.98,0:09:22.05,JP,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:09:22.75,0:09:25.05,JP,,0000,0000,0000,,Үйге келсем әлі шие гүлінің иісі шығады
Dialogue: 0,0:09:24.20,0:09:25.23,JP,,0000,0000,0000,,Қайта оралдын.
Dialogue: 0,0:09:26.18,0:09:27.60,JP,,0000,0000,0000,,Тама-чан мектебіндегі адамдар
Dialogue: 0,0:09:27.89,0:09:28.66,JP,,0000,0000,0000,,Иә Асагири
Dialogue: 0,0:09:28.66,0:09:30.11,JP,,0000,0000,0000,,Бұл Шиори Асагири.
Dialogue: 0,0:09:30.95,0:09:31.85,JP,,0000,0000,0000,,Сәлем
Dialogue: 0,0:09:33.98,0:09:34.61,JP,,0000,0000,0000,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:09:35.72,0:09:37.12,JP,,0000,0000,0000,,Мен дайынмын
Dialogue: 0,0:09:37.68,0:09:40.21,JP,,0000,0000,0000,,Барып кешкі ас ішу жақсы.
Dialogue: 0,0:09:40.60,0:09:41.16,JP,,0000,0000,0000,,Бірақ
Dialogue: 0,0:09:44.36,0:09:45.58,JP,,0000,0000,0000,,Ғашықтан?
Dialogue: 0,0:09:46.12,0:09:47.03,JP,,0000,0000,0000,,Анамнан
Dialogue: 0,0:09:47.19,0:09:48.76,JP,,0000,0000,0000,,Түсіндім, ана?
Dialogue: 0,0:09:49.21,0:09:50.27,JP,,0000,0000,0000,,Бірдеңе болды
Dialogue: 0,0:09:50.66,0:09:52.05,JP,,0000,0000,0000,,Мен бүгін кешігіп барамын.
Dialogue: 0,0:09:52.47,0:09:53.44,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:09:54.50,0:09:56.97,JP,,0000,0000,0000,,Олай болса, кешкі ас ішу керек.
Dialogue: 0,0:09:57.01,0:09:58.30,JP,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:09:58.74,0:09:59.80,JP,,0000,0000,0000,,Бір сәт кешіріңіз.
Dialogue: 0,0:10:00.16,0:10:01.06,JP,,0000,0000,0000,,Yes
Dialogue: 0,0:10:01.39,0:10:02.69,JP,,0000,0000,0000,,Әкелер
Dialogue: 0,0:10:02.69,0:10:03.70,JP,,0000,0000,0000,,Көршілес бірлестігі
Dialogue: 0,0:10:06.17,0:10:07.74,JP,,0000,0000,0000,,Шиори-санға да пудинг керек
Dialogue: 0,0:10:09.37,0:10:11.07,JP,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:10:12.15,0:10:13.98,JP,,0000,0000,0000,,Тама-чан, не жегің келеді?
Dialogue: 0,0:10:14.29,0:10:15.92,JP,,0000,0000,0000,,Грильде пісірілген балық және крокет
Dialogue: 0,0:10:16.27,0:10:17.47,JP,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:10:17.62,0:10:18.88,JP,,0000,0000,0000,,Анко жасаймыз ба?
Dialogue: 0,0:10:18.97,0:10:19.94,JP,,0000,0000,0000,,Сіз жасай аласыз ба?
Dialogue: 0,0:10:19.94,0:10:21.60,JP,,0000,0000,0000,,Мүмкін мен мұны істей аламын.
Dialogue: 0,0:10:22.12,0:10:22.86,JP,,0000,0000,0000,,Бұл
Dialogue: 0,0:10:24.00,0:10:26.04,JP,,0000,0000,0000,,Карбонара және көкөніс сорпасы.
Dialogue: 0,0:10:28.02,0:10:30.03,JP,,0000,0000,0000,,Бұл өте стильді және таң қалдырады
Dialogue: 0,0:10:30.23,0:10:31.48,JP,,0000,0000,0000,,Дәмді көрінеді
Dialogue: 0,0:10:31.75,0:10:33.77,JP,,0000,0000,0000,,Тұтынушыдан кешірім сұраймыз.
Dialogue: 0,0:10:34.17,0:10:34.75,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:10:35.21,0:10:37.05,JP,,0000,0000,0000,,Біз қызыл бұршақ пастасын да бірге жасадық.
Dialogue: 0,0:10:38.71,0:10:41.06,JP,,0000,0000,0000,,Бұл дәмді карбонара
Dialogue: 0,0:10:41.06,0:10:42.79,JP,,0000,0000,0000,,Делланы жеудің қажеті жоқ.
Dialogue: 0,0:10:46.48,0:10:47.35,JP,,0000,0000,0000,,Бұл жолы
Dialogue: 0,0:10:47.80,0:10:48.59,JP,,0000,0000,0000,,Әкемнен
Dialogue: 0,0:10:49.06,0:10:50.52,JP,,0000,0000,0000,,Монша бұзылды.
Dialogue: 0,0:10:51.41,0:10:52.27,JP,,0000,0000,0000,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:10:57.99,0:10:59.72,JP,,0000,0000,0000,,Шиори-сан, әдемі шаш
Dialogue: 0,0:10:59.97,0:11:01.97,JP,,0000,0000,0000,,Сіз қандай шампунь және қандай шампунь қолданасыз?
Dialogue: 0,0:11:02.06,0:11:03.13,JP,,0000,0000,0000,,Сусабын
Dialogue: 0,0:11:03.62,0:11:06.25,JP,,0000,0000,0000,,Керемет, теріңіз де тегіс.
Dialogue: 0,0:11:07.88,0:11:11.03,JP,,0000,0000,0000,,Ыстық сезіне бастадыңыз ба?
Dialogue: 0,0:11:11.10,0:11:11.90,JP,,0000,0000,0000,,Делла-чан
Dialogue: 0,0:11:13.22,0:11:14.79,JP,,0000,0000,0000,,Мен түнеп қалсам ғой.
Dialogue: 0,0:11:14.90,0:11:16.14,JP,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:11:16.60,0:11:17.24,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:11:18.14,0:11:19.05,JP,,0000,0000,0000,,Асагири-сан
Dialogue: 0,0:11:19.76,0:11:23.00,JP,,0000,0000,0000,,Тағам дәмді болды, рахмет
Dialogue: 0,0:11:27.53,0:11:28.23,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:11:28.47,0:11:30.24,JP,,0000,0000,0000,,Шиори-сан, барамыз ба?
Dialogue: 0,0:11:32.56,0:11:33.85,JP,,0000,0000,0000,,Таңғажайып емес пе? Көз жеткен жердің бәрінде Ятоитерлер!
Dialogue: 0,0:11:34.10,0:11:35.26,JP,,0000,0000,0000,,Ертең кездескенше
Dialogue: 0,0:11:37.50,0:11:38.90,JP,,0000,0000,0000,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:11:40.45,0:11:42.51,JP,,0000,0000,0000,,Түнгі жел әлі сәл салқын ма?
Dialogue: 0,0:11:43.69,0:11:45.33,JP,,0000,0000,0000,,Суық емес пе, Шиори-сан?
Dialogue: 0,0:11:45.46,0:11:47.15,JP,,0000,0000,0000,,Міне, қазірдің өзінде
Dialogue: 0,0:11:48.23,0:11:50.27,JP,,0000,0000,0000,,Иә, абай болыңыз.
Dialogue: 0,0:11:50.84,0:11:52.17,JP,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:11:52.69,0:11:54.62,JP,,0000,0000,0000,,Жоқ, жоқ, иілу жақсы.
Dialogue: 0,0:11:53.72,0:11:55.46,JP,,0000,0000,0000,,Пойыз келе жатыр, мен кетейін.
Dialogue: 0,0:11:54.99,0:11:59.96,JP,,0000,0000,0000,,Одан да мен шие гүлінің ағаштарын осылай жағалап жүргім келеді.
Dialogue: 0,0:12:00.20,0:12:01.04,JP,,0000,0000,0000,,Шиори-сан
Dialogue: 0,0:12:04.95,0:12:05.64,JP,,0000,0000,0000,,Үйге барасыз ба?
Dialogue: 0,0:12:11.64,0:12:12.64,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:12:12.75,0:12:13.69,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:12:15.02,0:12:15.71,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:12:15.71,0:12:16.53,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:12:17.65,0:12:20.36,JP,,0000,0000,0000,,Қайырлы таң Асагири-сан
Dialogue: 0,0:12:24.61,0:12:26.01,JP,,0000,0000,0000,,Кешегі күн үшін рахмет
Dialogue: 0,0:12:30.73,0:12:32.18,JP,,0000,0000,0000,,Қайырлы таң Тама-чан
Dialogue: 0,0:12:34.28,0:12:35.18,JP,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:12:35.50,0:12:37.59,JP,,0000,0000,0000,,Асагири-санға не болды?
Dialogue: 0,0:12:37.85,0:12:40.67,JP,,0000,0000,0000,,Иә, мен кеше өз үйімде кешкі ас әзірледім.
Dialogue: 0,0:12:40.90,0:12:43.38,JP,,0000,0000,0000,,Біз бірге монша дүкеніне бардық.
Dialogue: 0,0:12:43.88,0:12:44.72,JP,,0000,0000,0000,,О, құдай!
Dialogue: 0,0:12:45.36,0:12:48.27,JP,,0000,0000,0000,,Менің ойымша, бұл кенеттен таныс болды.
Dialogue: 0,0:12:50.65,0:12:51.66,JP,,0000,0000,0000,,(Кёко) Ах…
Dialogue: 0,0:12:53.29,0:12:55.32,JP,,0000,0000,0000,,Кешегі күн үшін рахмет
Dialogue: 0,0:12:56.16,0:12:57.17,JP,,0000,0000,0000,,(Кёко) Ах…
Dialogue: 0,0:13:05.54,0:13:07.80,JP,,0000,0000,0000,,Кешегі күн үшін рахмет. Бұл көңілді болды.
Dialogue: 0,0:13:17.11,0:13:20.39,JP,,0000,0000,0000,,Мен үйге баруды жоспарлағым келеді.
Dialogue: 0,0:13:20.66,0:13:23.34,JP,,0000,0000,0000,,Сізге ыңғайлы күнді дөңгелектеп, жіберіңіз.
Dialogue: 0,0:13:23.76,0:13:28.20,JP,,0000,0000,0000,,Айтпақшы, сіздің жанұяңыз қазір өте бақытты.
Dialogue: 0,0:13:29.70,0:13:32.61,JP,,0000,0000,0000,,Делла-чан, сен мектепке не үшін келесің?
Dialogue: 0,0:13:32.82,0:13:33.97,JP,,0000,0000,0000,,Өйткені көктем
Dialogue: 0,0:13:34.21,0:13:35.13,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:13:35.37,0:13:36.90,JP,,0000,0000,0000,,Сізді бөлгенім үшін кешіріңіз.
Dialogue: 0,0:13:35.50,0:13:36.70,JP,,0000,0000,0000,,Біз кесіп өтетін нәрсе – ақымақтық сызығы
Dialogue: 0,0:13:37.12,0:13:38.82,JP,,0000,0000,0000,,Қызым, маған кедергі жасама
Dialogue: 0,0:13:38.93,0:13:40.40,JP,,0000,0000,0000,,Жүр, үйге ерте кел.
Dialogue: 0,0:13:40.40,0:13:42.73,JP,,0000,0000,0000,,Әй, кеше
Dialogue: 0,0:13:43.58,0:13:44.79,JP,,0000,0000,0000,,I see, I'm here.
Dialogue: 0,0:13:44.91,0:13:48.17,JP,,0000,0000,0000,,Бәрі де қызық, қызық, жаттығу жасай аламыз ба?
Dialogue: 0,0:13:46.76,0:13:47.63,JP,,0000,0000,0000,,(Роко) Куфуфуфу. Мақтаның жараланды ма?
Dialogue: 0,0:13:48.28,0:13:49.53,JP,,0000,0000,0000,,It wasn't done.
Dialogue: 0,0:13:48.95,0:13:51.30,JP,,0000,0000,0000,,Бұл қуанышты интерпретация.
Dialogue: 0,0:14:00.98,0:14:02.73,JP,,0000,0000,0000,,Мен бәрі бұрынғыдай қалса екен деп тілеймін.
Dialogue: 0,0:14:03.00,0:14:04.53,JP,,0000,0000,0000,,Бұлай жұмыс істемейді.
Dialogue: 0,0:14:05.65,0:14:08.43,JP,,0000,0000,0000,,Махаббат - күткенде де жүрегіңді елжірететін нәрсе.
Dialogue: 0,0:14:18.12,0:14:19.99,JP,,0000,0000,0000,,Жоқ, мен ұйықтап қалдым.
Dialogue: 0,0:14:21.31,0:14:22.90,JP,,0000,0000,0000,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:14:23.13,0:14:24.20,JP,,0000,0000,0000,,Fate
Dialogue: 0,0:14:24.56,0:14:25.90,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:14:26.61,0:14:28.41,JP,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:14:29.24,0:14:30.94,JP,,0000,0000,0000,,Pain Pain Pain
Dialogue: 0,0:14:32.28,0:14:34.51,JP,,0000,0000,0000,,Шиори-сан мейірімді.
Dialogue: 0,0:14:35.50,0:14:38.81,JP,,0000,0000,0000,,Сондай-ақ, бұл әйелдік, талғампаз және әдемі.
Dialogue: 0,0:14:42.87,0:14:43.62,JP,,0000,0000,0000,,Не болды?
Dialogue: 0,0:14:45.06,0:14:46.82,JP,,0000,0000,0000,,I'm like that
Dialogue: 0,0:14:48.13,0:14:50.00,JP,,0000,0000,0000,,Бұл мүлдем жақсы емес.
Dialogue: 0,0:14:50.15,0:14:52.51,JP,,0000,0000,0000,,Оның тереңдігі де жақсы.
Dialogue: 0,0:14:52.87,0:14:54.96,JP,,0000,0000,0000,,Бүгін менің үйіме тағы келе аласыз ба?
Dialogue: 0,0:14:55.23,0:14:55.91,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:14:57.02,0:14:58.52,JP,,0000,0000,0000,,Кружка мочи дәмді
Dialogue: 0,0:14:58.52,0:14:59.57,JP,,0000,0000,0000,,I'll stop it.
Dialogue: 0,0:14:59.86,0:15:00.61,JP,,0000,0000,0000,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:15:02.05,0:15:03.79,JP,,0000,0000,0000,,Мен саған өткен күн үшін әлі алғыс айтқан жоқпын.
Dialogue: 0,0:15:04.90,0:15:05.99,JP,,0000,0000,0000,,Mochimazui-san
Dialogue: 0,0:15:07.04,0:15:09.85,JP,,0000,0000,0000,,Киташиракава мырзаға айтыңызшы.
Dialogue: 0,0:15:10.65,0:15:12.16,JP,,0000,0000,0000,,Өткен күн үшін рахмет.
Dialogue: 0,0:15:13.23,0:15:16.26,JP,,0000,0000,0000,,Мұны өзіңіз де айтуыңыз керек екеніне сенімдімін.
Dialogue: 0,0:15:18.08,0:15:18.89,JP,,0000,0000,0000,,By yourself
Dialogue: 0,0:15:19.45,0:15:21.56,JP,,0000,0000,0000,,Мен жақындаған кезде...
Dialogue: 0,0:15:21.56,0:15:24.99,JP,,0000,0000,0000,,Hey Asagiri
Dialogue: 0,0:15:25.98,0:15:29.51,JP,,0000,0000,0000,,Кешіріңіз, мен мұнда жаңа жұмыс істей бастадым, мен карталарда жақсы емеспін.
Dialogue: 0,0:15:30.87,0:15:32.72,JP,,0000,0000,0000,,О Тама-чанның досы
Dialogue: 0,0:15:36.83,0:15:38.21,JP,,0000,0000,0000,,Well, Tama-chan's
Dialogue: 0,0:15:38.47,0:15:39.49,JP,,0000,0000,0000,,Are you a teacher?
Dialogue: 0,0:15:39.90,0:15:42.11,JP,,0000,0000,0000,,Tama-chan always takes care of me.
Dialogue: 0,0:15:42.34,0:15:44.66,JP,,0000,0000,0000,,I try to be a good kid at school.
Dialogue: 0,0:15:44.90,0:15:47.69,JP,,0000,0000,0000,,Please take care of my Midori as well.
Dialogue: 0,0:15:48.17,0:15:49.29,JP,,0000,0000,0000,,Eating croquettes
Dialogue: 0,0:15:49.64,0:15:50.81,JP,,0000,0000,0000,,Teachers also welcome
Dialogue: 0,0:15:51.07,0:15:54.20,JP,,0000,0000,0000,,No, I feel like everyone is greeting me.
Dialogue: 0,0:16:01.89,0:16:03.01,JP,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:16:03.39,0:16:05.08,JP,,0000,0000,0000,,and Asagiri-san
Dialogue: 0,0:16:05.80,0:16:09.96,JP,,0000,0000,0000,,My daughter is always taking care of me.
Dialogue: 0,0:16:10.45,0:16:11.02,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:16:13.88,0:16:15.40,JP,,0000,0000,0000,,Бұл менің күріш тортым, өтінемін.
Dialogue: 0,0:16:15.84,0:16:18.06,JP,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:16:18.96,0:16:20.45,JP,,0000,0000,0000,,Well, it'll come out in a bit.
Dialogue: 0,0:16:25.84,0:16:28.44,JP,,0000,0000,0000,,This is my special feather
Dialogue: 0,0:16:30.06,0:16:30.69,JP,,0000,0000,0000,,Around here
Dialogue: 0,0:16:31.06,0:16:32.70,JP,,0000,0000,0000,,Grandpa, I'm going.
Dialogue: 0,0:16:33.10,0:16:34.21,JP,,0000,0000,0000,,Абайлаңыз
Dialogue: 0,0:16:34.96,0:16:36.73,JP,,0000,0000,0000,,Thank you for waiting, Asagiri-san.
Dialogue: 0,0:16:37.49,0:16:39.24,JP,,0000,0000,0000,,Қайтадан қиындық тудырғаным үшін кешіріңіз.
Dialogue: 0,0:16:41.48,0:16:44.31,JP,,0000,0000,0000,,That's troublesome.
Dialogue: 0,0:16:44.75,0:16:46.22,JP,,0000,0000,0000,,Then I
Dialogue: 0,0:16:46.44,0:16:48.32,JP,,0000,0000,0000,,I don't feel at ease here.
Dialogue: 0,0:16:48.57,0:16:51.25,JP,,0000,0000,0000,,Кофе алғың келе ме, Шиори?
Dialogue: 0,0:16:51.46,0:16:52.31,JP,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:16:52.31,0:16:54.39,JP,,0000,0000,0000,,Are you here too?
Dialogue: 0,0:16:54.71,0:16:57.45,JP,,0000,0000,0000,,Дәлірек айтсақ, Делла-чан келуге міндетті емес.
Dialogue: 0,0:16:58.57,0:17:01.31,JP,,0000,0000,0000,,Hey, I'm following Asagiri too much.
Dialogue: 0,0:17:04.47,0:17:05.08,JP,,0000,0000,0000,,Бұл
Dialogue: 0,0:17:07.68,0:17:08.31,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:17:08.80,0:17:09.42,JP,,0000,0000,0000,,Бұл
Dialogue: 0,0:17:09.42,0:17:10.52,JP,,0000,0000,0000,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:17:12.36,0:17:12.92,JP,,0000,0000,0000,,Бұл
Dialogue: 0,0:17:21.30,0:17:22.87,JP,,0000,0000,0000,,Asagiri-san this
Dialogue: 0,0:17:23.68,0:17:24.78,JP,,0000,0000,0000,,Өткен күн үшін рахмет
Dialogue: 0,0:17:26.54,0:17:28.16,JP,,0000,0000,0000,,It's my product.
Dialogue: 0,0:17:29.48,0:17:30.41,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:17:33.39,0:17:34.43,JP,,0000,0000,0000,,Asagiri-san
Dialogue: 0,0:17:35.79,0:17:39.43,JP,,0000,0000,0000,,What if I or Della-chan cause trouble?
Dialogue: 0,0:17:40.43,0:17:41.45,JP,,0000,0000,0000,,Please say it properly
Dialogue: 0,0:17:44.20,0:17:47.73,JP,,0000,0000,0000,,The other day, I felt quite familiar.
Dialogue: 0,0:17:57.97,0:18:02.94,JP,,0000,0000,0000,,Музыканың сөзден гөрі көп нәрсені айтатын кездері болады.
Dialogue: 0,0:18:05.19,0:18:11.78,JP,,0000,0000,0000,,Кейде барлық сөздер музыка болғанын қалаймын.
Dialogue: 0,0:18:24.58,0:18:25.34,JP,,0000,0000,0000,,ащы
Dialogue: 0,0:18:31.57,0:18:33.36,JP,,0000,0000,0000,,Ки Киташиракава-сан
Dialogue: 0,0:18:33.75,0:18:34.43,JP,,0000,0000,0000,,Түсінікті.
Dialogue: 0,0:18:35.92,0:18:38.18,JP,,0000,0000,0000,,Мен, бұл өте қызық болды.
Dialogue: 0,0:18:40.77,0:18:42.94,JP,,0000,0000,0000,,Мен өткен күні көп көңілді болдым.
Dialogue: 0,0:18:43.86,0:18:47.16,JP,,0000,0000,0000,,Бұл өте қызықты болды.
Dialogue: 0,0:18:57.85,0:18:58.77,JP,,0000,0000,0000,,Асагири-сан
Dialogue: 0,0:19:04.45,0:19:05.54,JP,,0000,0000,0000,,Мен де
Dialogue: 0,0:19:22.42,0:19:24.41,JP,,0000,0000,0000,,Мен, жаттығу залында.
Dialogue: 0,0:19:24.74,0:19:28.25,JP,,0000,0000,0000,,Мен әрқашан Киташиракава-сан мен оның достары көңіл көтеріп жүрген сияқты деп ойлайтынмын.
Dialogue: 0,0:19:31.49,0:19:34.34,JP,,0000,0000,0000,,Сондықтан мен бір сыныпта оқығанымызға қуаныштымын.
Dialogue: 0,0:19:37.43,0:19:38.23,JP,,0000,0000,0000,,ащы
Dialogue: 0,0:19:42.30,0:19:43.36,JP,,0000,0000,0000,,Бұл ащы, солай емес пе?
Dialogue: 0,0:19:46.78,0:19:51.83,JP,,0000,0000,0000,,Мм, енді біз доспыз, жарай ма?
Dialogue: 0,0:19:56.94,0:19:58.64,JP,,0000,0000,0000,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:20:01.97,0:20:03.31,JP,,0000,0000,0000,,Үздіксіз қолдауыңыз үшін рахмет.
Dialogue: 0,0:20:04.59,0:20:05.34,JP,,0000,0000,0000,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:20:07.68,0:20:09.37,JP,,0000,0000,0000,,Онда ертең кездескенше.
Dialogue: 0,0:20:15.63,0:20:19.44,JP,,0000,0000,0000,,Бұл қиындық тудыруы мүмкін емес.
Dialogue: 0,0:20:26.52,0:20:28.36,JP,,0000,0000,0000,,Жоқ, жоқ, жоқ, бұл туралы алаңдамаңыз
Dialogue: 0,0:20:28.41,0:20:31.33,JP,,0000,0000,0000,,Маған ғашық болған мыңдаған қыздар бар.
Dialogue: 0,0:20:31.33,0:20:32.46,JP,,0000,0000,0000,,Мочимазуи-сан
Dialogue: 0,0:20:34.10,0:20:34.92,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:20:36.91,0:20:41.34,JP,,0000,0000,0000,,Мочимазуидің арқасында мен Киташиракаваға біраз жақындадым.
Dialogue: 0,0:20:42.60,0:20:47.00,JP,,0000,0000,0000,,Мен де Ори-сан мен анау қыздың бір-бірін ашса екен деп тілеймін.
Dialogue: 0,0:20:47.58,0:20:48.87,JP,,0000,0000,0000,,Мен назарымды аудардым
Dialogue: 0,0:20:49.33,0:20:50.55,JP,,0000,0000,0000,,Дегенмен, 11 жасыңдағы кезіңмен салыстырғанда бетің біраз өзгерген болар
Dialogue: 0,0:20:51.32,0:20:52.63,JP,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:20:52.73,0:20:55.47,JP,,0000,0000,0000,,Жарайды, шүкіршілік етудің қажеті жоқ.
Dialogue: 0,0:20:55.81,0:20:57.28,JP,,0000,0000,0000,,Міне, осы.
Dialogue: 0,0:20:59.49,0:21:04.08,JP,,0000,0000,0000,,Басқаша айтқанда, бұл Шиориді ұнататынымның дәлелі.
Dialogue: 0,0:21:04.24,0:21:08.30,JP,,0000,0000,0000,,Мен бадминтон ойнамаймын, өйткені мен қауырсынды жақсы көремін.
Dialogue: 0,0:21:09.39,0:21:10.06,JP,,0000,0000,0000,,Олай болса
Dialogue: 0,0:21:20.44,0:21:22.43,JP,,0000,0000,0000,,Мен Асагири-санмен дос болдым.
Dialogue: 0,0:21:22.68,0:21:26.21,JP,,0000,0000,0000,,Иә, мен қиындық тудырдым ба деп уайымдадым.
Dialogue: 0,0:21:28.34,0:21:30.01,JP,,0000,0000,0000,,Енді ойлап қарасам, өткен күні
Dialogue: 0,0:21:30.43,0:21:33.81,JP,,0000,0000,0000,,Асагири-сан мұны жуынатын бөлмеде айнаға қайта-қайта айтты.
Dialogue: 0,0:21:34.86,0:21:37.26,JP,,0000,0000,0000,,Кешегі күн үшін рахмет. Бұл көңілді болды.
Dialogue: 0,0:21:38.75,0:21:40.07,JP,,0000,0000,0000,,Бұл өте қызық болды
Dialogue: 0,0:21:44.36,0:21:45.11,JP,,0000,0000,0000,,Тамако
Dialogue: 0,0:21:46.50,0:21:47.19,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:21:48.34,0:21:49.55,JP,,0000,0000,0000,,Не?
Dialogue: 0,0:21:50.61,0:21:52.59,JP,,0000,0000,0000,,Сөздер кейде қиын болады
Dialogue: 0,0:21:52.86,0:21:54.85,JP,,0000,0000,0000,,Сөздер кейде көңілді қалдырады.
Dialogue: 0,0:21:55.38,0:21:57.99,JP,,0000,0000,0000,,Мен жеткізгім келетін сезімдер әрқашан бос
Dialogue: 0,0:21:58.89,0:22:02.23,JP,,0000,0000,0000,,Бірақ ол бір күні келуі керек.
Dialogue: 0,0:22:03.10,0:22:03.90,JP,,0000,0000,0000,,Дәмді
Dialogue: 0,0:23:36.09,0:23:37.04,JP,,0000,0000,0000,,Бұл Тамако
Dialogue: 0,0:23:37.46,0:23:41.02,JP,,0000,0000,0000,,Біреу маған шие гүлі мочиді өзенге қарап жеген дұрыс деп айтты.
Dialogue: 0,0:23:41.15,0:23:44.64,JP,,0000,0000,0000,,Мен өзенге қарап тамақ ішіп отырғанымда, өзен бойындағы шие гүлдері сондай әдемі.
Dialogue: 0,0:23:44.64,0:23:46.21,JP,,0000,0000,0000,,Одан да дәмді болды.
Dialogue: 0,0:23:46.63,0:23:49.47,JP,,0000,0000,0000,,Келесі жолы қандай күріш тортын жеуге болады?
Dialogue: 0,0:00:01.25,0:00:03.09,CN,,0000,0000,0000,,Мекеме туралы көпшілікке жариялау үшін тарату тобы аяқталғаннан кейін
Dialogue: 0,0:00:03.21,0:00:05.26,CN,,0000,0000,0000,,Бағдарламаны іске қосу туралы маңызды ақпарат
Dialogue: 0,0:00:06.99,0:00:07.80,CN,,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:00:08.43,0:00:09.79,CN,,0000,0000,0000,,Бір топты сәтті аяқтау
Dialogue: 0,0:00:09.83,0:00:10.59,CN,,0000,0000,0000,,...
Dialogue: 0,0:00:07.88,0:00:10.57,CN,,0000,0000,0000,,Какука Мори ашық көктемгі ерік-жігер
