Dialogue: 0,0:00:40.04,0:00:41.13,CN,,0000,0000,0000,,Нада Макото
Dialogue: 0,0:00:41.52,0:00:43.50,CN,,0000,0000,0000,,Кодама – бейкүнә бала
Dialogue: 0,0:00:44.03,0:00:45.23,CN,,0000,0000,0000,,Мен бұған жақсы емеспін
Dialogue: 0,0:00:45.61,0:00:47.26,CN,,0000,0000,0000,,Қайта қарау
Dialogue: 0,0:00:52.36,0:00:53.79,CN,,0000,0000,0000,,Біздің бизнес
Dialogue: 0,0:00:54.33,0:00:55.80,CN,,0000,0000,0000,,38-тарау: Алтын тәжірибе · Реквием
Dialogue: 0,0:00:56.69,0:00:59.39,CN,,0000,0000,0000,,Жаздың келуі, ішкі толқу
Dialogue: 0,0:00:59.95,0:01:02.87,CN,,0000,0000,0000,,Накакода қанша сезім бар?
Dialogue: 0,0:02:45.96,0:02:47.41,CN,,0000,0000,0000,,Тарих тарихы
Dialogue: 0,0:02:48.78,0:02:49.91,CN,,0000,0000,0000,,Рио Хисато
Dialogue: 0,0:02:50.27,0:02:51.57,CN,,0000,0000,0000,,Мен келген соң осында келдім.
Dialogue: 0,0:02:51.89,0:02:52.78,CN,,0000,0000,0000,,Ұйықтау
Dialogue: 0,0:02:53.02,0:02:54.98,CN,,0000,0000,0000,,Жүзу құралдарын киюді ұмытпаңыз.
Dialogue: 0,0:02:55.54,0:02:57.87,CN,,0000,0000,0000,,Менің бастапқы ойларым осында...
Dialogue: 0,0:02:58.23,0:02:59.73,CN,,0000,0000,0000,,Натоку Кайкё
Dialogue: 0,0:03:00.13,0:03:01.88,CN,,0000,0000,0000,,Менің тоғанға бару ойым жоқ.
Dialogue: 0,0:03:07.63,0:03:11.13,CN,,0000,0000,0000,,Оңға солға оңға солға оңға
Dialogue: 0,0:03:11.29,0:03:13.46,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:13.77,0:03:15.90,CN,,0000,0000,0000,,Жұмыртқалар жүзуге сәйкес келмейді
Dialogue: 0,0:03:17.22,0:03:18.90,CN,,0000,0000,0000,,Май мен жұмыртқа қосылды
Dialogue: 0,0:03:19.48,0:03:20.93,CN,,0000,0000,0000,,Жан түршігерлік тәртіп бұзушылық
Dialogue: 0,0:03:21.16,0:03:23.79,CN,,0000,0000,0000,,Нана, мен босмын, сен бір адаммен ойнай аласың.
Dialogue: 0,0:03:23.79,0:03:25.69,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:25.69,0:03:28.18,CN,,0000,0000,0000,,Ақиқаттың шынайы мағынасы
Dialogue: 0,0:03:28.57,0:03:30.60,CN,,0000,0000,0000,,Сәттілік Май қосып, май қосыңыз
Dialogue: 0,0:03:36.36,0:03:37.26,CN,,0000,0000,0000,,Жұмыртқа
Dialogue: 0,0:03:37.38,0:03:38.66,CN,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз
Dialogue: 0,0:03:38.99,0:03:40.90,CN,,0000,0000,0000,,1.1.0000
Dialogue: 0,0:03:42.68,0:03:43.55,CN,,0000,0000,0000,,Сеніңше, қалай?
Dialogue: 0,0:03:45.45,0:03:47.79,CN,,0000,0000,0000,,...
Dialogue: 0,0:03:48.35,0:03:51.61,CN,,0000,0000,0000,,Жұмыртқа бастауыш сыныптың жүзу сабағы?
Dialogue: 0,0:03:51.88,0:03:52.93,CN,,0000,0000,0000,,13
Dialogue: 0,0:03:53.03,0:03:55.16,CN,,0000,0000,0000,,Нозай су ауылы 10 секунд
Dialogue: 0,0:03:55.44,0:03:56.75,CN,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:03:56.75,0:04:00.69,CN,,0000,0000,0000,,12 деңгейлі су астындағы жұдырық
Dialogue: 0,0:04:01.04,0:04:03.84,CN,,0000,0000,0000,,Тыныс ала алмау
Dialogue: 0,0:04:04.17,0:04:05.99,CN,,0000,0000,0000,,Өзгерістің себебі қайда?
Dialogue: 0,0:04:06.50,0:04:08.33,CN,,0000,0000,0000,,...
Dialogue: 0,0:04:09.20,0:04:10.72,CN,,0000,0000,0000,,Жол? Уақыт?
Dialogue: 0,0:04:11.20,0:04:13.58,CN,,0000,0000,0000,,Бұны ұмыту - азапты еске түсіру
Dialogue: 0,0:04:16.11,0:04:17.87,CN,,0000,0000,0000,,Шуичи Кодама
Dialogue: 0,0:04:21.70,0:04:22.66,CN,,0000,0000,0000,,Канна
Dialogue: 0,0:04:22.70,0:04:23.86,CN,,0000,0000,0000,,Кушитадан шығу
Dialogue: 0,0:04:27.53,0:04:28.49,CN,,0000,0000,0000,,Канна?
Dialogue: 0,0:04:28.68,0:04:29.73,CN,,0000,0000,0000,,Өліммен кездесу
Dialogue: 0,0:04:30.09,0:04:31.22,CN,,0000,0000,0000,,Құрғақ па?
Dialogue: 0,0:04:34.82,0:04:36.29,CN,,0000,0000,0000,,38-тарау: Алтын тәжірибе · Реквием
Dialogue: 0,0:04:36.29,0:04:38.36,CN,,0000,0000,0000,,Ішуге бөлек уақыт
Dialogue: 0,0:04:38.74,0:04:40.70,CN,,0000,0000,0000,,Мен үшін не маңызды?
Dialogue: 0,0:04:41.06,0:04:42.80,CN,,0000,0000,0000,,Маңызды мәселе? Кішігірім мәселе?
Dialogue: 0,0:04:44.58,0:04:45.39,CN,,0000,0000,0000,,Мұндайды есту өте сирек
Dialogue: 0,0:04:45.71,0:04:47.59,CN,,0000,0000,0000,,Керісінше қандай?
Dialogue: 0,0:04:48.51,0:04:49.36,CN,,0000,0000,0000,,Ондық
Dialogue: 0,0:04:49.36,0:04:51.21,CN,,0000,0000,0000,,Дарындылық жақсы емес
Dialogue: 0,0:04:54.39,0:04:55.28,CN,,0000,0000,0000,,Мен жеймін
Dialogue: 0,0:05:02.30,0:05:03.35,CN,,0000,0000,0000,,Барлығыңды өлтіреміз
Dialogue: 0,0:05:07.17,0:05:09.29,CN,,0000,0000,0000,,Нәтижесінде ол жойылды.
Dialogue: 0,0:05:10.05,0:05:12.25,CN,,0000,0000,0000,,Бұл жалпыға ортақ жүзу аймағы.
Dialogue: 0,0:05:17.77,0:05:19.35,CN,,0000,0000,0000,,Зал
Dialogue: 0,0:05:20.17,0:05:22.34,CN,,0000,0000,0000,,Жұмыртқа сенсің
Dialogue: 0,0:05:22.34,0:05:23.02,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:05:23.32,0:05:26.48,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:27.94,0:05:29.19,CN,,0000,0000,0000,,Жоқ... орындалмады
Dialogue: 0,0:05:29.58,0:05:32.70,CN,,0000,0000,0000,,Мен де онша талантты емеспін.
Dialogue: 0,0:05:33.44,0:05:34.54,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:05:34.96,0:05:37.48,CN,,0000,0000,0000,,Менің бекіту кездесуім конспект.
Dialogue: 0,0:05:42.36,0:05:43.40,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:43.81,0:05:45.47,CN,,0000,0000,0000,,Сен... осы жерден келдің
Dialogue: 0,0:05:45.49,0:05:46.78,CN,,0000,0000,0000,,...
Dialogue: 0,0:05:46.97,0:05:49.51,CN,,0000,0000,0000,,「」
Dialogue: 0,0:05:49.75,0:05:51.54,CN,,0000,0000,0000,,Бұл мәңгілік патша отбасы...
Dialogue: 0,0:05:51.54,0:05:53.07,CN,,0000,0000,0000,,Мен музыка тыңдаймын.
Dialogue: 0,0:05:53.07,0:05:54.33,CN,,0000,0000,0000,,Бөлек шығу
Dialogue: 0,0:05:54.68,0:05:56.71,CN,,0000,0000,0000,,Міне, сіз осы жерден келдіңіз.
Dialogue: 0,0:05:57.11,0:05:59.43,CN,,0000,0000,0000,,Сіз кіреберіс қақпасындағы есікке қарайсыз.
Dialogue: 0,0:06:00.56,0:06:03.97,CN,,0000,0000,0000,,Әр адамға арналған қабылдау банкетінің символы
Dialogue: 0,0:06:04.29,0:06:06.33,CN,,0000,0000,0000,,Менің келгеніме жарты жыл болды
Dialogue: 0,0:06:06.79,0:06:09.68,CN,,0000,0000,0000,,Осы кеште талантты адамдармен бірге банкетте
Dialogue: 0,0:06:09.99,0:06:13.33,CN,,0000,0000,0000,,Мен де сіздердің ойларыңызды алғаныма қуаныштымын.
Dialogue: 0,0:06:13.33,0:06:15.97,CN,,0000,0000,0000,,Мынау Жапония, Айқайлаған жел мен темір
Dialogue: 0,0:06:16.22,0:06:18.08,CN,,0000,0000,0000,,Банкет
Dialogue: 0,0:06:18.27,0:06:20.34,CN,,0000,0000,0000,,Менің не айтып тұрғанымды білгің келсе,
Dialogue: 0,0:06:20.34,0:06:22.01,CN,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:06:22.53,0:06:23.23,CN,,0000,0000,0000,,Есептеу
Dialogue: 0,0:06:23.23,0:06:25.40,CN,,0000,0000,0000,,Сіздің келуіңіз аяқталды.
Dialogue: 0,0:06:25.71,0:06:26.49,CN,,0000,0000,0000,,?
Dialogue: 0,0:06:26.84,0:06:28.16,CN,,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:06:31.02,0:06:32.56,CN,,0000,0000,0000,,Уақытқа келгенде
Dialogue: 0,0:06:32.82,0:06:34.95,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:35.79,0:06:37.40,CN,,0000,0000,0000,,Жоқ... орындалмады
Dialogue: 0,0:06:37.48,0:06:39.88,CN,,0000,0000,0000,,Мен де онша талантты емеспін.
Dialogue: 0,0:06:40.52,0:06:41.94,CN,,0000,0000,0000,,Екеуінің айырмашылығы
Dialogue: 0,0:06:41.94,0:06:43.08,CN,,0000,0000,0000,,Сіз оны көре аласыз
Dialogue: 0,0:06:43.09,0:06:45.09,CN,,0000,0000,0000,,Бұл сіз өзіңіз үшін айта аласыз.
Dialogue: 0,0:06:46.16,0:06:48.27,CN,,0000,0000,0000,,Бұл құстардың тіршілігіне байланысты мәселе.
Dialogue: 0,0:06:48.67,0:06:49.50,CN,,0000,0000,0000,,Бөлек басқару
Dialogue: 0,0:06:49.50,0:06:50.16,CN,,0000,0000,0000,,LOVE
Dialogue: 0,0:06:51.05,0:06:54.13,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:54.52,0:06:55.58,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:55.58,0:06:57.48,CN,,0000,0000,0000,,Таңертең ойлайтын қыз кім?
Dialogue: 0,0:06:57.67,0:06:58.60,CN,,0000,0000,0000,,...
Dialogue: 0,0:06:58.60,0:06:59.57,CN,,0000,0000,0000,,Тарих кішкентай апа
Dialogue: 0,0:06:59.99,0:07:01.32,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:01.40,0:07:02.46,CN,,0000,0000,0000,,Мұнда емес
Dialogue: 0,0:07:02.66,0:07:04.35,CN,,0000,0000,0000,,Нана - гүл дүкенінің ескі тақтасы
Dialogue: 0,0:07:04.49,0:07:07.47,CN,,0000,0000,0000,,Келсең тыңдайсың.
Dialogue: 0,0:07:07.77,0:07:09.69,CN,,0000,0000,0000,,Бас әріп дұрыс емес.
Dialogue: 0,0:07:10.00,0:07:11.31,CN,,0000,0000,0000,,Нана - кішкентай қайын ене
Dialogue: 0,0:07:13.43,0:07:14.50,CN,,0000,0000,0000,,Негізсіз... негізсіз
Dialogue: 0,0:07:14.77,0:07:15.82,CN,,0000,0000,0000,,Жылдық адам
Dialogue: 0,0:07:16.17,0:07:18.26,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:18.55,0:07:20.24,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:07:20.40,0:07:21.96,CN,,0000,0000,0000,,Бұл кішкентай қайын енесі
Dialogue: 0,0:07:22.25,0:07:25.57,CN,,0000,0000,0000,,Жақын жерде тұра алмайтындай өмір сүру
Dialogue: 0,0:07:25.96,0:07:27.45,CN,,0000,0000,0000,,Сіз ер адамсыз.
Dialogue: 0,0:07:27.54,0:07:28.63,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:28.78,0:07:31.86,CN,,0000,0000,0000,,Менің ойым ақ. Өткен жыл да былтыр болды.
Dialogue: 0,0:07:32.26,0:07:34.80,CN,,0000,0000,0000,,Дегенмен, мен Тамако Найкені мүлде сағындым...
Dialogue: 0,0:07:35.91,0:07:37.02,CN,,0000,0000,0000,,Бұл жолдың бар екені анық
Dialogue: 0,0:07:37.49,0:07:39.27,CN,,0000,0000,0000,,...
Dialogue: 0,0:07:39.58,0:07:41.97,CN,,0000,0000,0000,,Жою әдісі де әртүрлі.
Dialogue: 0,0:07:42.44,0:07:47.49,CN,,0000,0000,0000,,Такатаға келгенде маған хабарлаңыз.
Dialogue: 0,0:07:47.97,0:07:51.47,CN,,0000,0000,0000,,Менің жеңгем мен келінім
Dialogue: 0,0:07:51.62,0:07:53.44,CN,,0000,0000,0000,,Жұмыртқа бағыты...
Dialogue: 0,0:07:53.69,0:07:58.14,CN,,0000,0000,0000,,Ол үшін уайымдама, мен өзімді мақтан тұтамын.
Dialogue: 0,0:07:58.89,0:08:00.64,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:01.03,0:08:04.40,CN,,0000,0000,0000,,Сондықтан менде кішкентай қыз бен қыз сияқты сезім бар.
Dialogue: 0,0:08:04.98,0:08:06.54,CN,,0000,0000,0000,,Фукигюя Футаку жобасы
Dialogue: 0,0:08:06.76,0:08:09.32,CN,,0000,0000,0000,,Сіз сенімсізсіз.
Dialogue: 0,0:08:10.01,0:08:13.30,CN,,0000,0000,0000,,Менің еңбегімнің күші мен адамның көмегі
Dialogue: 0,0:08:13.83,0:08:14.87,CN,,0000,0000,0000,,Қайта қаралды
Dialogue: 0,0:08:17.15,0:08:17.80,CN,,0000,0000,0000,,Уолтер Эванс (59)
Dialogue: 0,0:08:17.80,0:08:18.34,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:23.30,0:08:25.59,CN,,0000,0000,0000,,Қара түске ұшыраған
Dialogue: 0,0:08:26.77,0:08:29.05,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:29.41,0:08:30.86,CN,,0000,0000,0000,,Фукуси де кейін келеді
Dialogue: 0,0:08:33.28,0:08:35.58,CN,,0000,0000,0000,,Ауыстыру аяқталды
Dialogue: 0,0:08:35.97,0:08:37.13,CN,,0000,0000,0000,,Армандағы әңгіме
Dialogue: 0,0:08:37.76,0:08:39.91,CN,,0000,0000,0000,,...
Dialogue: 0,0:08:40.52,0:08:41.65,CN,,0000,0000,0000,,Жақсы~
Dialogue: 0,0:08:42.60,0:08:44.11,CN,,0000,0000,0000,,Бұл анық.
Dialogue: 0,0:08:44.22,0:08:48.09,CN,,0000,0000,0000,,Бұл бұрыш ең маңызды болып табылады.
Dialogue: 0,0:08:48.34,0:08:50.22,CN,,0000,0000,0000,,Әйелдер қауымдастығы сізді жоғалтты
Dialogue: 0,0:08:50.92,0:08:52.04,CN,,0000,0000,0000,,Сіз не айтасыз?
Dialogue: 0,0:08:52.39,0:08:53.79,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:00.13,0:09:04.21,CN,,0000,0000,0000,,Ұзақ жүзу Жүзу орны мен мұхит мүлдем басқа.
Dialogue: 0,0:09:04.61,0:09:05.78,CN,,0000,0000,0000,,Мотивация
Dialogue: 0,0:09:06.22,0:09:07.24,CN,,0000,0000,0000,,Шабыт рухы
Dialogue: 0,0:09:07.53,0:09:08.77,CN,,0000,0000,0000,,Тек жүзіңіз.
Dialogue: 0,0:09:08.93,0:09:11.31,CN,,0000,0000,0000,,Осы шетелдік капиталды есептемегенде, жағымды жағдай.
Dialogue: 0,0:09:11.54,0:09:12.45,CN,,0000,0000,0000,,Сондай-ақ
Dialogue: 0,0:09:12.93,0:09:15.65,CN,,0000,0000,0000,,Бұл кеште жақсы ойлар
Dialogue: 0,0:09:16.07,0:09:16.92,CN,,0000,0000,0000,,Жыл жылы?
Dialogue: 0,0:09:16.92,0:09:18.16,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:18.40,0:09:20.49,CN,,0000,0000,0000,,Отты қай уақытта пісіру керек?
Dialogue: 0,0:09:20.96,0:09:22.41,CN,,0000,0000,0000,,Үй иесі Кейя Юя
Dialogue: 0,0:09:23.47,0:09:24.32,CN,,0000,0000,0000,,Жақсы дәм
Dialogue: 0,0:09:24.32,0:09:24.92,CN,,0000,0000,0000,,Неаполь, таңғы 11:26
Dialogue: 0,0:09:25.00,0:09:26.54,CN,,0000,0000,0000,,Кішкентай болғысы келмеу
Dialogue: 0,0:09:27.29,0:09:29.33,CN,,0000,0000,0000,,Жаздан бері көп уақыт өтті.
Dialogue: 0,0:09:29.66,0:09:32.54,CN,,0000,0000,0000,,Нацутеняның өлім оқиғасы
Dialogue: 0,0:09:33.07,0:09:35.94,CN,,0000,0000,0000,,Сіз Ужикин уақытын көре аласыз, сонымен қатар шығарылымды аласыз.
Dialogue: 0,0:09:36.08,0:09:37.79,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:38.00,0:09:39.42,CN,,0000,0000,0000,,Жыл жылы
Dialogue: 0,0:09:39.77,0:09:41.69,CN,,0000,0000,0000,,Жыл жылы
Dialogue: 0,0:09:41.80,0:09:43.25,CN,,0000,0000,0000,,Насука Као Ичиге
Dialogue: 0,0:09:43.57,0:09:44.90,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:45.27,0:09:47.49,CN,,0000,0000,0000,,Орындалмады
Dialogue: 0,0:09:48.22,0:09:48.77,CN,,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:09:49.02,0:09:50.53,CN,,0000,0000,0000,,Жыл жылы
Dialogue: 0,0:09:50.73,0:09:51.70,CN,,0000,0000,0000,,Бұл 3
Dialogue: 0,0:09:54.23,0:09:56.81,CN,,0000,0000,0000,,...
Dialogue: 0,0:09:56.84,0:09:58.48,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:09:58.83,0:10:01.44,CN,,0000,0000,0000,,Әсіресе нақты мәселе
Dialogue: 0,0:10:01.74,0:10:06.84,CN,,0000,0000,0000,,Тыныш, сүйіспеншілік, сәттілік, махаббат - табыс
Dialogue: 0,0:10:07.31,0:10:11.21,CN,,0000,0000,0000,,Мен тұрған жерге келгенде,
Dialogue: 0,0:10:11.59,0:10:15.81,CN,,0000,0000,0000,,Сәттілік.
Dialogue: 0,0:10:16.54,0:10:18.59,CN,,0000,0000,0000,,Жақсы ой.
Dialogue: 0,0:10:18.59,0:10:19.53,CN,,0000,0000,0000,,Әрине, мен ашуланамын — мен сонша…
Dialogue: 0,0:10:19.68,0:10:21.42,CN,,0000,0000,0000,,Жою
Dialogue: 0,0:10:29.24,0:10:30.74,CN,,0000,0000,0000,,Екі қабатты төсек нағыз сұлулық
Dialogue: 0,0:10:35.07,0:10:36.35,CN,,0000,0000,0000,,Канна?
Dialogue: 0,0:10:36.81,0:10:38.95,CN,,0000,0000,0000,,Канна Ганжу Джусоку 3
Dialogue: 0,0:10:39.23,0:10:40.75,CN,,0000,0000,0000,,Аспанда жүзу
Dialogue: 0,0:10:41.47,0:10:43.62,CN,,0000,0000,0000,,Өйткені мен жүзуге қуаныштымын
Dialogue: 0,0:10:48.92,0:10:50.24,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:51.56,0:10:54.70,CN,,0000,0000,0000,,...
Dialogue: 0,0:10:54.77,0:10:56.13,CN,,0000,0000,0000,,Теңізден көрініс
Dialogue: 0,0:10:58.11,0:11:01.43,CN,,0000,0000,0000,,Бұл теңіз, теңіз суының ұзаққа созылатын дәмі.
Dialogue: 0,0:11:01.43,0:11:04.24,CN,,0000,0000,0000,,Мен көлік үлгісінмін
Dialogue: 0,0:11:05.57,0:11:06.93,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:07.13,0:11:08.67,CN,,0000,0000,0000,,Қолдан келгені осы
Dialogue: 0,0:11:08.67,0:11:10.65,CN,,0000,0000,0000,,Денеме оралмағаныма көп болды.
Dialogue: 0,0:11:11.56,0:11:14.03,CN,,0000,0000,0000,,Кітаптың жыл сайынғы басылымы.
Dialogue: 0,0:11:14.35,0:11:15.25,CN,,0000,0000,0000,,Махаббат кітабы?
Dialogue: 0,0:11:15.81,0:11:17.47,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:17.65,0:11:18.80,CN,,0000,0000,0000,,Жақсы оқу
Dialogue: 0,0:11:18.80,0:11:19.58,CN,,0000,0000,0000,,Қайдасың?
Dialogue: 0,0:11:21.00,0:11:24.05,CN,,0000,0000,0000,,Әңгіме туралы не ойлайсыз?
Dialogue: 0,0:11:24.33,0:11:26.71,CN,,0000,0000,0000,,Енді түн аяқталды
Dialogue: 0,0:11:26.83,0:11:29.07,CN,,0000,0000,0000,,Кітапқа қызығушылық танытсаңыз, оны тыңдамаңыз.
Dialogue: 0,0:11:29.63,0:11:30.41,CN,,0000,0000,0000,,Есептеу
Dialogue: 0,0:11:30.71,0:11:32.77,CN,,0000,0000,0000,,Махаббатқа ұмтылу тренингі
Dialogue: 0,0:11:33.27,0:11:35.58,CN,,0000,0000,0000,,Қашықтық бұрышы
Dialogue: 0,0:11:35.58,0:11:37.62,CN,,0000,0000,0000,,Капитал құрғақ емес.
Dialogue: 0,0:11:37.74,0:11:38.58,CN,,0000,0000,0000,,Кіші дела
Dialogue: 0,0:11:38.84,0:11:39.79,CN,,0000,0000,0000,,Мәңгілік
Dialogue: 0,0:11:40.43,0:11:42.63,CN,,0000,0000,0000,,Елімізде басқа елді мекендер бар ма?
Dialogue: 0,0:11:42.63,0:11:44.72,CN,,0000,0000,0000,,Иә, мен кішкентай қайын сіңлісінің досымын.
Dialogue: 0,0:11:44.72,0:11:47.31,CN,,0000,0000,0000,,...
Dialogue: 0,0:11:47.31,0:11:49.09,CN,,0000,0000,0000,,Буггарати? Меніңше, ол Неаполитандық бандит болған, иә?
Dialogue: 0,0:11:51.98,0:11:52.86,CN,,0000,0000,0000,,Бұл...
Dialogue: 0,0:11:53.10,0:11:55.15,CN,,0000,0000,0000,,Өлмеген
Dialogue: 0,0:11:56.00,0:11:57.93,CN,,0000,0000,0000,,Мені шығарып салды
Dialogue: 0,0:11:58.27,0:12:00.19,CN,,0000,0000,0000,,Шындық – үйеңкі үй
Dialogue: 0,0:12:00.57,0:12:03.16,CN,,0000,0000,0000,,Бұл менің өткенде жіберген әңгімем.
Dialogue: 0,0:12:03.16,0:12:06.18,CN,,0000,0000,0000,,Ерлер мен әйелдердің тұрғын үй-жайларын қайта оқу
Dialogue: 0,0:12:06.28,0:12:07.44,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:12:10.57,0:12:12.19,CN,,0000,0000,0000,,?
Dialogue: 0,0:12:12.97,0:12:15.93,CN,,0000,0000,0000,,Әңгімелесу Кіші әпке
Dialogue: 0,0:12:16.45,0:12:18.99,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:17.86,0:12:19.25,CN,,0000,0000,0000,,Кішкентай жасыл келеді
Dialogue: 0,0:12:19.44,0:12:20.87,CN,,0000,0000,0000,,Кішкентай жеңге
Dialogue: 0,0:12:25.26,0:12:28.19,CN,,0000,0000,0000,,...
Dialogue: 0,0:12:28.97,0:12:31.50,CN,,0000,0000,0000,,Мен туралы естідің бе?
Dialogue: 0,0:12:35.73,0:12:36.51,CN,,0000,0000,0000,,Мәңгілік
Dialogue: 0,0:12:41.89,0:12:43.83,CN,,0000,0000,0000,,Накаясуке
Dialogue: 0,0:12:52.53,0:12:56.31,CN,,0000,0000,0000,,Бейне қараңғыда, көздері жұмылған, дауысы теңіз толқынындай естіледі.
Dialogue: 0,0:12:56.56,0:12:58.40,CN,,0000,0000,0000,,Туған жердің еңбек қызметі мен туған жерін еске түсіру
Dialogue: 0,0:12:59.39,0:13:01.46,CN,,0000,0000,0000,,Ханзада, менің кездесуім бар...
Dialogue: 0,0:13:08.34,0:13:09.34,CN,,0000,0000,0000,,Джиен Шығыс
Dialogue: 0,0:13:11.89,0:13:14.00,CN,,0000,0000,0000,,Келу сезімін қараңыз
Dialogue: 0,0:13:14.38,0:13:16.25,CN,,0000,0000,0000,,Жұмыртқа өнімділігі
Dialogue: 0,0:13:16.61,0:13:17.86,CN,,0000,0000,0000,,Екінші кездесу
Dialogue: 0,0:13:18.58,0:13:19.72,CN,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:13:19.85,0:13:20.63,CN,,0000,0000,0000,,Жиналыс
Dialogue: 0,0:13:21.25,0:13:22.63,CN,,0000,0000,0000,,Мүлдем жиіркенішті
Dialogue: 0,0:13:23.00,0:13:23.91,CN,,0000,0000,0000,,Мұндайды есту өте сирек
Dialogue: 0,0:13:24.15,0:13:27.15,CN,,0000,0000,0000,,Мен жай ғана шолудың шолушысымын
Dialogue: 0,0:13:27.86,0:13:29.63,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:29.79,0:13:30.58,CN,,0000,0000,0000,,Арикан жүйесі
Dialogue: 0,0:13:30.86,0:13:33.35,CN,,0000,0000,0000,,Сіз жұмыртқа қалдырдыңыз
Dialogue: 0,0:13:33.91,0:13:35.46,CN,,0000,0000,0000,,Мен де тапсырысымды жоғалттым.
Dialogue: 0,0:13:35.60,0:13:36.81,CN,,0000,0000,0000,,Мэй Мин Ю
Dialogue: 0,0:13:37.20,0:13:40.55,CN,,0000,0000,0000,,Менің әңгімем жұмыртқа жоқ.
Dialogue: 0,0:13:40.70,0:13:43.07,CN,,0000,0000,0000,,Себебі сіз пайдалы емессіз
Dialogue: 0,0:13:43.14,0:13:44.67,CN,,0000,0000,0000,,Кесте... үстел ақ
Dialogue: 0,0:13:44.81,0:13:46.61,CN,,0000,0000,0000,,Менің жеке жоспарларым...
Dialogue: 0,0:13:46.67,0:13:47.63,CN,,0000,0000,0000,,Натажуя
Dialogue: 0,0:13:47.63,0:13:49.53,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:49.64,0:13:51.91,CN,,0000,0000,0000,,Босатпаңыз
Dialogue: 0,0:13:52.03,0:13:53.31,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:53.70,0:13:57.34,CN,,0000,0000,0000,,...
Dialogue: 0,0:13:57.72,0:13:58.46,CN,,0000,0000,0000,,Өйткені...
Dialogue: 0,0:13:58.59,0:14:01.17,CN,,0000,0000,0000,,Юуноның өлім оқиғасы
Dialogue: 0,0:14:01.62,0:14:03.11,CN,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:14:03.35,0:14:05.98,CN,,0000,0000,0000,,Мен уақытында басталатынын түсінемін.
Dialogue: 0,0:14:07.06,0:14:08.85,CN,,0000,0000,0000,,Бұл жай ғана дүкен ашатын орын.
Dialogue: 0,0:14:09.00,0:14:11.09,CN,,0000,0000,0000,,Сіздің әңгімеңіз қандай?
Dialogue: 0,0:14:11.19,0:14:12.63,CN,,0000,0000,0000,,Әңгіме қандай?
Dialogue: 0,0:14:12.90,0:14:15.29,CN,,0000,0000,0000,,Мен жұмыртқаны түсінемін
Dialogue: 0,0:14:15.49,0:14:19.10,CN,,0000,0000,0000,,25 жылдық білім
Dialogue: 0,0:14:19.24,0:14:20.72,CN,,0000,0000,0000,,Шынайы мағына
Dialogue: 0,0:14:21.65,0:14:25.04,CN,,0000,0000,0000,,Ная Чжи Дао жұмыртқасы сүт көзілдірігі
Dialogue: 0,0:14:25.72,0:14:26.47,CN,,0000,0000,0000,,Ондық?
Dialogue: 0,0:14:26.82,0:14:28.32,CN,,0000,0000,0000,,Белгісіз жол
Dialogue: 0,0:14:28.44,0:14:31.65,CN,,0000,0000,0000,,Тәждегі үлкен көзді айна алдында
Dialogue: 0,0:14:32.22,0:14:33.82,CN,,0000,0000,0000,,Мен әрине жолды білемін
Dialogue: 0,0:14:34.51,0:14:37.31,CN,,0000,0000,0000,,Бастауыш мектептің төртінші сыныбына қабылдандым.
Dialogue: 0,0:14:37.44,0:14:38.86,CN,,0000,0000,0000,,Натоязе
Dialogue: 0,0:14:38.97,0:14:43.61,CN,,0000,0000,0000,,Әлі жоқ, мен жұмыртқа жейтін ең жақсы жермін.
Dialogue: 0,0:14:43.61,0:14:47.86,CN,,0000,0000,0000,,...
Dialogue: 0,0:14:48.73,0:14:50.20,CN,,0000,0000,0000,,Диск сол жерде
Dialogue: 0,0:14:52.45,0:14:53.87,CN,,0000,0000,0000,,Қолайсыздықты жою
Dialogue: 0,0:14:53.87,0:14:56.87,CN,,0000,0000,0000,,Адал болу оңай, бағасы жоғары.
Dialogue: 0,0:14:57.88,0:14:59.78,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:00.06,0:15:01.16,CN,,0000,0000,0000,,демалыс
Dialogue: 0,0:15:02.57,0:15:06.24,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:06.56,0:15:08.60,CN,,0000,0000,0000,,Бұл дұрыс емес...
Dialogue: 0,0:15:08.60,0:15:11.21,CN,,0000,0000,0000,,Тамако менің досым
Dialogue: 0,0:15:11.63,0:15:13.16,CN,,0000,0000,0000,,Біздің қорғанысымыз
Dialogue: 0,0:15:14.59,0:15:16.98,CN,,0000,0000,0000,,Жұмыртқа туралы ойлау – менің еркіндігім.
Dialogue: 0,0:15:19.94,0:15:20.83,CN,,0000,0000,0000,,...
Dialogue: 0,0:15:21.51,0:15:22.64,CN,,0000,0000,0000,,Жоқ...мұнда емес
Dialogue: 0,0:15:22.74,0:15:24.79,CN,,0000,0000,0000,,Бұл тұрарлық емес.
Dialogue: 0,0:15:25.09,0:15:26.02,CN,,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:15:26.43,0:15:29.53,CN,,0000,0000,0000,,Сіз оны шашып жіберсеңіз, мен де сол дәмді сезінемін.
Dialogue: 0,0:15:30.23,0:15:32.07,CN,,0000,0000,0000,,Қазіргі уақытта сәл көтерілулер мен құлдыраулар бар.
Dialogue: 0,0:15:32.32,0:15:34.69,CN,,0000,0000,0000,,Осыдан кейін генералдың тазаруға уақыты болмайды.
Dialogue: 0,0:15:35.22,0:15:38.40,CN,,0000,0000,0000,,Сіздің бетіңіздің дәмі бірдей.
