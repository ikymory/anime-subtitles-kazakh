Dialogue: 0,0:01:23.27,0:01:27.83,OP-JP,,0000,0000,0000,,Мен өзімді көп адамның арасынан жүгіріп өткендей сезінемін
Dialogue: 0,0:01:28.02,0:01:30.69,OP-JP,,0000,0000,0000,,Мен сені шақырғандай.
Dialogue: 0,0:01:30.69,0:01:33.61,OP-JP,,0000,0000,0000,,Тағы да толып жатыр
Dialogue: 0,0:01:34.55,0:01:39.14,OP-JP,,0000,0000,0000,,Жан-жақта ұшқан фаворитизмді мақтан тұтамын
Dialogue: 0,0:01:39.26,0:01:45.15,OP-JP,,0000,0000,0000,,Мен өзімнің күткен үміттеріме қуанғым келеді
Dialogue: 0,0:01:45.74,0:01:48.27,OP-JP,,0000,0000,0000,,Мен тік тұрдым.
Dialogue: 0,0:01:48.55,0:01:50.91,OP-JP,,0000,0000,0000,,Мен көптен бері күттім
Dialogue: 0,0:01:50.91,0:01:52.81,OP-JP,,0000,0000,0000,,Бірінен-бірі өтіп бара жатқан күлкілер
Dialogue: 0,0:01:52.96,0:01:56.68,OP-JP,,0000,0000,0000,,Мен сені қатты құшақтағым келеді
Dialogue: 0,0:01:59.39,0:02:02.10,OP-JP,,0000,0000,0000,,Келіңіздер, бәріңіз.
Dialogue: 0,0:02:02.19,0:02:10.09,OP-JP,,0000,0000,0000,,Ол әрқашан кенеттен жүгіре бастайды.
Dialogue: 0,0:02:10.17,0:02:15.99,OP-JP,,0000,0000,0000,,Кез келген кештің тұман болатыны сияқты.
Dialogue: 0,0:02:16.24,0:02:23.17,OP-JP,,0000,0000,0000,,Бұл жерді жарқыраған жерде тексеру
Dialogue: 0,0:22:06.17,0:22:09.73,ED-JP,,0000,0000,0000,,бұрылыс жазбасы
Dialogue: 0,0:22:09.73,0:22:13.21,ED-JP,,0000,0000,0000,,Егер ісініп, жарылып кетсе
Dialogue: 0,0:22:13.21,0:22:18.57,ED-JP,,0000,0000,0000,,Бұл күйдірілген жазба болады.
Dialogue: 0,0:22:20.65,0:22:25.74,ED-JP,,0000,0000,0000,,Шаш кептіргішпен түзетілмейтін көңіл-күй
Dialogue: 0,0:22:27.79,0:22:31.65,ED-JP,,0000,0000,0000,,Мен кеше тым көп сөйледім
Dialogue: 0,0:22:34.69,0:22:39.76,ED-JP,,0000,0000,0000,,Мен контактілерді жоюға тырыстым.
Dialogue: 0,0:22:41.69,0:22:45.32,ED-JP,,0000,0000,0000,,Дүние бұлыңғыр
Dialogue: 0,0:22:47.40,0:22:50.70,ED-JP,,0000,0000,0000,,Бір сәтке
Dialogue: 0,0:22:50.70,0:22:54.20,ED-JP,,0000,0000,0000,,Мен сенің тұрған жеріңді тексеремін.
Dialogue: 0,0:22:54.40,0:23:01.43,ED-JP,,0000,0000,0000,,Бір күні сені тастап кетемін бе деп ойлаймын
Dialogue: 0,0:23:04.84,0:23:08.34,ED-JP,,0000,0000,0000,,Әрқашан бірдеңе іздеу
Dialogue: 0,0:23:08.34,0:23:11.93,ED-JP,,0000,0000,0000,,Жақын жерде жасырыну
Dialogue: 0,0:23:11.93,0:23:17.41,ED-JP,,0000,0000,0000,,Тақпақтың жүрегін білсем де
Dialogue: 0,0:23:18.26,0:23:22.44,ED-JP,,0000,0000,0000,,Ах, иіру, иіру, жазулар
Dialogue: 0,0:23:22.44,0:23:25.93,ED-JP,,0000,0000,0000,,Ол ісініп, жарылып кетеді.
Dialogue: 0,0:23:25.93,0:23:30.99,ED-JP,,0000,0000,0000,,Бірақ, жұмбақ әуен
Dialogue: 0,0:23:32.25,0:23:34.85,ED-JP,,0000,0000,0000,,Мен оны ешқашан ұмытпаймын
Dialogue: 0,0:02:33.96,0:02:43.97,Staff,,0000,0000,0000,,Осы субтитр көзімен жасалған, God Subtitles Group (kamigami.org), жеткізу алмасу оқыту, коммерциялық мақсатта пайдалануға тыйым салынған
Dialogue: 0,0:02:33.96,0:02:43.97,Staff,,0000,0000,0000,,:& :&NOKI :& : : :
Dialogue: 0,0:00:09.61,0:00:12.46,JP,,0000,0000,0000,,Мочизу Егер сіз өзіңізді бей-жай сезінсеңіз, онда Chute-Tales
Dialogue: 0,0:00:13.39,0:00:14.30,JP,,0000,0000,0000,,О
Dialogue: 0,0:00:17.89,0:00:19.27,JP,,0000,0000,0000,,Олай болса, мен барамын.
Dialogue: 0,0:00:19.35,0:00:20.78,JP,,0000,0000,0000,,Күн ыстық
Dialogue: 0,0:00:26.59,0:00:27.86,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:00:28.21,0:00:29.08,JP,,0000,0000,0000,,Мочизо
Dialogue: 0,0:00:30.33,0:00:31.10,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:00:31.79,0:00:32.86,JP,,0000,0000,0000,,Бассейнге барыңыз
Dialogue: 0,0:00:33.03,0:00:34.27,JP,,0000,0000,0000,,Кішкене Тамако
Dialogue: 0,0:00:34.43,0:00:35.54,JP,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:00:35.83,0:00:39.80,JP,,0000,0000,0000,,Ер баланы шақырсақ не істеуіміз керек? Біз купальник киеміз.
Dialogue: 0,0:00:40.04,0:00:41.13,JP,,0000,0000,0000,,Бұл жаман
Dialogue: 0,0:00:41.52,0:00:43.50,JP,,0000,0000,0000,,Тама-чан, сен бұзық қызсың.
Dialogue: 0,0:00:44.03,0:00:45.23,JP,,0000,0000,0000,,Барма
Dialogue: 0,0:00:45.61,0:00:47.26,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:00:52.36,0:00:53.79,JP,,0000,0000,0000,,Үй тапсырмасын орында
Dialogue: 0,0:00:54.33,0:00:55.80,JP,,0000,0000,0000,,Бұл ауырады
Dialogue: 0,0:00:56.69,0:00:59.39,JP,,0000,0000,0000,,Жаз келер жүрегім қайнады
Dialogue: 0,0:00:59.95,0:01:02.87,JP,,0000,0000,0000,,Сол баланың ойы қазір қайда?
Dialogue: 0,0:02:45.96,0:02:47.41,JP,,0000,0000,0000,,Сіз кешігіп қалдыңыз, Шиори-чан.
Dialogue: 0,0:02:48.78,0:02:49.91,JP,,0000,0000,0000,,Күткеніңізге рахмет
Dialogue: 0,0:02:50.27,0:02:51.57,JP,,0000,0000,0000,,Кешіктіргеніміз үшін кешірім сұраймыз
Dialogue: 0,0:02:51.89,0:02:52.78,JP,,0000,0000,0000,,Ұйықтап қалды
Dialogue: 0,0:02:53.02,0:02:54.98,JP,,0000,0000,0000,,Жоқ, мен купальникімді ұмытып кетіппін.
Dialogue: 0,0:02:55.54,0:02:57.87,JP,,0000,0000,0000,,Мен сені келер деп ойладым.
Dialogue: 0,0:02:58.23,0:02:59.73,JP,,0000,0000,0000,,Ал, мен қайтамын.
Dialogue: 0,0:03:00.13,0:03:01.88,JP,,0000,0000,0000,,Енді бассейнге келудің мәні жоқ.
Dialogue: 0,0:03:07.63,0:03:11.13,JP,,0000,0000,0000,,Оңға солға оңға солға оңға
Dialogue: 0,0:03:11.29,0:03:13.46,JP,,0000,0000,0000,,Қараңдар, қараңдар, жамбастарың қайырылған.
Dialogue: 0,0:03:13.77,0:03:15.90,JP,,0000,0000,0000,,Тамако жүзе алмады
Dialogue: 0,0:03:17.22,0:03:18.90,JP,,0000,0000,0000,,Сәттілік Тамако
Dialogue: 0,0:03:19.48,0:03:20.93,JP,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:03:21.16,0:03:23.79,JP,,0000,0000,0000,,Жарайды, мен сені жіберемін, сен өзің жүзе аласың.
Dialogue: 0,0:03:23.79,0:03:25.69,JP,,0000,0000,0000,,Сол Мидори-чан
Dialogue: 0,0:03:25.69,0:03:28.18,JP,,0000,0000,0000,,Ертең теңіз жағасындағы мектеп.
Dialogue: 0,0:03:28.57,0:03:30.60,JP,,0000,0000,0000,,Иә, қолыңнан келгеннің бәрін жаса, барыңды істе
Dialogue: 0,0:03:36.36,0:03:37.26,JP,,0000,0000,0000,,Тамако
Dialogue: 0,0:03:37.38,0:03:38.66,JP,,0000,0000,0000,,Сенгісіз
Dialogue: 0,0:03:38.99,0:03:40.90,JP,,0000,0000,0000,,Мен бір миллиметрді алға қойған жоқпын.
Dialogue: 0,0:03:42.68,0:03:43.55,JP,,0000,0000,0000,,Икета
Dialogue: 0,0:03:45.45,0:03:47.79,JP,,0000,0000,0000,,Бұл жолы өте жақсы өтті.
Dialogue: 0,0:03:48.35,0:03:51.61,JP,,0000,0000,0000,,Тамако: Сіз бастауыш мектепте неше сыныпта жүздіңіз?
Dialogue: 0,0:03:51.88,0:03:52.93,JP,,0000,0000,0000,,13 сынып
Dialogue: 0,0:03:53.03,0:03:55.16,JP,,0000,0000,0000,,10 секунд суға жабысқан бет
Dialogue: 0,0:03:55.44,0:03:56.75,JP,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:03:56.75,0:04:00.69,JP,,0000,0000,0000,,12-сыныпта су астындағы тас-қағаз-қайшыны орындай алмаған жалғыз Тамако болды.
Dialogue: 0,0:04:01.04,0:04:03.84,JP,,0000,0000,0000,,Қорыққандықтан, тыныс ала алмаймын.
Dialogue: 0,0:04:04.17,0:04:05.99,JP,,0000,0000,0000,,Сондықтан сіз дем алып жатырсыз, солай ма?
Dialogue: 0,0:04:06.50,0:04:08.33,JP,,0000,0000,0000,,Сіз Мочизо сияқты сөздер айтасыз.
Dialogue: 0,0:04:09.20,0:04:10.72,JP,,0000,0000,0000,,Оджи қашан болды?
Dialogue: 0,0:04:11.20,0:04:13.58,JP,,0000,0000,0000,,Мен ұмытып қалдым. Бұл ауыр естелік.
Dialogue: 0,0:04:16.11,0:04:17.87,JP,,0000,0000,0000,,Тама-чан, артқа шегін.
Dialogue: 0,0:04:21.70,0:04:22.66,JP,,0000,0000,0000,,Канна-чан
Dialogue: 0,0:04:22.70,0:04:23.86,JP,,0000,0000,0000,,батып кетті
Dialogue: 0,0:04:27.53,0:04:28.49,JP,,0000,0000,0000,,Планер
Dialogue: 0,0:04:28.68,0:04:29.73,JP,,0000,0000,0000,,Суға бату
Dialogue: 0,0:04:30.09,0:04:31.22,JP,,0000,0000,0000,,Балға
Dialogue: 0,0:04:34.82,0:04:36.29,JP,,0000,0000,0000,,Бұл ауырады
Dialogue: 0,0:04:36.29,0:04:38.36,JP,,0000,0000,0000,,Тамақ ішу кезінде алаңдамаңыз
Dialogue: 0,0:04:38.74,0:04:40.70,JP,,0000,0000,0000,,Мен маңызды нәрсе туралы ойлап отырмын.
Dialogue: 0,0:04:41.06,0:04:42.80,JP,,0000,0000,0000,,Не маңызды?
Dialogue: 0,0:04:44.58,0:04:45.39,JP,,0000,0000,0000,,Бөлек
Dialogue: 0,0:04:45.71,0:04:47.59,JP,,0000,0000,0000,,Бұл бәрібір Тамако-чан туралы шығар.
Dialogue: 0,0:04:48.51,0:04:49.36,JP,,0000,0000,0000,,Не?
Dialogue: 0,0:04:49.36,0:04:51.21,JP,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:04:54.39,0:04:55.28,JP,,0000,0000,0000,,Ас үшін рахмет
Dialogue: 0,0:05:02.30,0:05:03.35,JP,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:05:07.17,0:05:09.29,JP,,0000,0000,0000,,Мен бәрібір кетуім керек еді.
Dialogue: 0,0:05:10.05,0:05:12.25,JP,,0000,0000,0000,,Баратын жер - қоғамдық бассейн.
Dialogue: 0,0:05:17.77,0:05:19.35,JP,,0000,0000,0000,,Мочизо
Dialogue: 0,0:05:20.17,0:05:22.34,JP,,0000,0000,0000,,Тамако сонда болды ма?
Dialogue: 0,0:05:22.34,0:05:23.02,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:05:23.32,0:05:26.48,JP,,0000,0000,0000,,Ей, бірге ойнайық.
Dialogue: 0,0:05:27.94,0:05:29.19,JP,,0000,0000,0000,,Иә, жарайды.
Dialogue: 0,0:05:29.58,0:05:32.70,JP,,0000,0000,0000,,Менің мұнда келген себебім емес.
Dialogue: 0,0:05:33.44,0:05:34.54,JP,,0000,0000,0000,,Демек, шынымен де мұнда жартылай жұмыс істеуді бастапсың ғой.
Dialogue: 0,0:05:34.96,0:05:37.48,JP,,0000,0000,0000,,Сіз айтасыз, мен анық
Dialogue: 0,0:05:42.36,0:05:43.40,JP,,0000,0000,0000,,Жас жігіт
Dialogue: 0,0:05:43.81,0:05:45.47,JP,,0000,0000,0000,,7-ші эпизод: Секси тапанша дебют жасайды – Бірінші бөлім
Dialogue: 0,0:05:45.49,0:05:46.78,JP,,0000,0000,0000,,«сіз» емес
Dialogue: 0,0:05:46.97,0:05:49.51,JP,,0000,0000,0000,,Менің атым Дерамохимадзу
Dialogue: 0,0:05:49.75,0:05:51.54,JP,,0000,0000,0000,,Құрметті король отбасы...
Dialogue: 0,0:05:51.54,0:05:53.07,JP,,0000,0000,0000,,Мен жеткілікті білемін.
Dialogue: 0,0:05:53.07,0:05:54.33,JP,,0000,0000,0000,,Рұқсатсыз кірмеңіз.
Dialogue: 0,0:05:54.68,0:05:56.71,JP,,0000,0000,0000,,Сіз оны ішке шақырған болуыңыз керек.
Dialogue: 0,0:05:57.11,0:05:59.43,JP,,0000,0000,0000,,Қараңдаршы, есікте қоңырау соғылып тұр.
Dialogue: 0,0:06:00.56,0:06:03.97,JP,,0000,0000,0000,,Сол қоңырау – қарсы алу тойының өтетіндігінің белгісі.
Dialogue: 0,0:06:04.29,0:06:06.33,JP,,0000,0000,0000,,Менің келгеніме жарты жыл болды.
Dialogue: 0,0:06:06.79,0:06:09.68,JP,,0000,0000,0000,,Мен кешті өткізуге сәл кешіккендей сезінемін.
Dialogue: 0,0:06:09.99,0:06:13.33,JP,,0000,0000,0000,,Сізді қарсы алғыңыз келсе, ұялмаңыз.
Dialogue: 0,0:06:13.33,0:06:15.97,JP,,0000,0000,0000,,Бұл Жапония, бұл «жел қоңырауы»
Dialogue: 0,0:06:16.22,0:06:18.08,JP,,0000,0000,0000,,Банкет немесе ештеңе болмайды.
Dialogue: 0,0:06:18.27,0:06:20.34,JP,,0000,0000,0000,,Бұл түсініксіз.
Dialogue: 0,0:06:20.34,0:06:22.01,JP,,0000,0000,0000,,Қайсысы түсініксіз?
Dialogue: 0,0:06:22.53,0:06:23.23,JP,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:06:23.23,0:06:25.40,JP,,0000,0000,0000,,Онда мен сенің қиналғаныңды тыңдаймын.
Dialogue: 0,0:06:25.71,0:06:26.49,JP,,0000,0000,0000,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:06:26.84,0:06:28.16,JP,,0000,0000,0000,,Сіз уайымдауыңыз керек.
Dialogue: 0,0:06:31.02,0:06:32.56,JP,,0000,0000,0000,,Сіз мұнда қанша уақыт болдыңыз?
Dialogue: 0,0:06:32.82,0:06:34.95,JP,,0000,0000,0000,,Ей, бірге ойнама.
Dialogue: 0,0:06:35.79,0:06:37.40,JP,,0000,0000,0000,,Иә, жарайды.
Dialogue: 0,0:06:37.48,0:06:39.88,JP,,0000,0000,0000,,Менің мұнда келген себебім емес.
Dialogue: 0,0:06:40.52,0:06:41.94,JP,,0000,0000,0000,,шамасында болуы мүмкін
Dialogue: 0,0:06:41.94,0:06:43.08,JP,,0000,0000,0000,,Сіз мұны естідіңіз бе?
Dialogue: 0,0:06:43.09,0:06:45.09,JP,,0000,0000,0000,,Сіз өз бетіңізше сөйлеген болуыңыз керек.
Dialogue: 0,0:06:46.16,0:06:48.27,JP,,0000,0000,0000,,Оның құстарға қатысы жоқ.
Dialogue: 0,0:06:48.67,0:06:49.50,JP,,0000,0000,0000,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:06:49.50,0:06:50.16,JP,,0000,0000,0000,,Махаббат?
Dialogue: 0,0:06:51.05,0:06:54.13,JP,,0000,0000,0000,,Жігіт, сені түсіну оңай.
Dialogue: 0,0:06:54.52,0:06:55.58,JP,,0000,0000,0000,,Шулы
Dialogue: 0,0:06:55.58,0:06:57.48,JP,,0000,0000,0000,,Ғашық қыз кім?
Dialogue: 0,0:06:57.67,0:06:58.60,JP,,0000,0000,0000,,Эй, айтшы.
Dialogue: 0,0:06:58.60,0:06:59.57,JP,,0000,0000,0000,,Шиори-сан?
Dialogue: 0,0:06:59.99,0:07:01.32,JP,,0000,0000,0000,,Ол жақсы емес.
Dialogue: 0,0:07:01.40,0:07:02.46,JP,,0000,0000,0000,,Чиги
Dialogue: 0,0:07:02.66,0:07:04.35,JP,,0000,0000,0000,,Олай болса, сіз гүл дүкенінің иесісіз бе?
Dialogue: 0,0:07:04.49,0:07:07.47,JP,,0000,0000,0000,,Олай етпе. Бұл саған тым әдемі.
Dialogue: 0,0:07:07.77,0:07:09.69,JP,,0000,0000,0000,,Сондықтан сіз басқаша деп отырсыз.
Dialogue: 0,0:07:10.00,0:07:11.31,JP,,0000,0000,0000,,Сонда қызым?
Dialogue: 0,0:07:13.43,0:07:14.50,JP,,0000,0000,0000,,Чи Чигейо
Dialogue: 0,0:07:14.77,0:07:15.82,JP,,0000,0000,0000,,Жас жігіт
Dialogue: 0,0:07:16.17,0:07:18.26,JP,,0000,0000,0000,,Сізді түсіну оңай.
Dialogue: 0,0:07:18.55,0:07:20.24,JP,,0000,0000,0000,,Жарайды, үйге қайт.
Dialogue: 0,0:07:20.40,0:07:21.96,JP,,0000,0000,0000,,Менің қызым қандай?
Dialogue: 0,0:07:22.25,0:07:25.57,JP,,0000,0000,0000,,Қалайша осыншама алыс өмір сүресің, сонда да маған сезіміңді айтпайсың?
Dialogue: 0,0:07:25.96,0:07:27.45,JP,,0000,0000,0000,,Әлі де еркек пе?
Dialogue: 0,0:07:27.54,0:07:28.63,JP,,0000,0000,0000,,Шулы
Dialogue: 0,0:07:28.78,0:07:31.86,JP,,0000,0000,0000,,Мен сізге былтыр және оның алдындағы жылы айтқым келеді.
Dialogue: 0,0:07:32.26,0:07:34.80,JP,,0000,0000,0000,,Бірақ Тамако мұны мүлде байқамады.
Dialogue: 0,0:07:35.91,0:07:37.02,JP,,0000,0000,0000,,Менің ойымша, солай.
Dialogue: 0,0:07:37.49,0:07:39.27,JP,,0000,0000,0000,,Шулы
Dialogue: 0,0:07:39.58,0:07:41.97,JP,,0000,0000,0000,,Ямувоен Бұл да байланыстың бір түрі
Dialogue: 0,0:07:42.44,0:07:47.49,JP,,0000,0000,0000,,Туған жерімде талай қыз-келіншектерге жалған ат қойған мен сендермен қызметтес боламын.
Dialogue: 0,0:07:47.97,0:07:51.47,JP,,0000,0000,0000,,Біріншіден, бұл қыз бір рет сүйіспеншілікке ұшырады.
Dialogue: 0,0:07:51.62,0:07:53.44,JP,,0000,0000,0000,,Тамако сізге
Dialogue: 0,0:07:53.69,0:07:58.14,JP,,0000,0000,0000,,Уайымдама, мен асыл адаммын, сондықтан сыпайы түрде бас тарттым.
Dialogue: 0,0:07:58.89,0:08:00.64,JP,,0000,0000,0000,,Менің ойымша, ол өте қайғылы болды.
Dialogue: 0,0:08:01.03,0:08:04.40,JP,,0000,0000,0000,,Сондықтан мен қызымның сезімін түсінемін.
Dialogue: 0,0:08:04.98,0:08:06.54,JP,,0000,0000,0000,,Өтірік айт
Dialogue: 0,0:08:06.76,0:08:09.32,JP,,0000,0000,0000,,Өтірік деп ойласаң, солай ойла.
Dialogue: 0,0:08:10.01,0:08:13.30,JP,,0000,0000,0000,,Сол кісідей мен де қол ұшын беруге тырыстым.
Dialogue: 0,0:08:13.83,0:08:14.87,JP,,0000,0000,0000,,Спидвегон, мен мұнда келдім —
Dialogue: 0,0:08:17.15,0:08:17.80,JP,,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:08:17.80,0:08:18.34,JP,,0000,0000,0000,,Бұл
Dialogue: 0,0:08:23.30,0:08:25.59,JP,,0000,0000,0000,,Қызыл бұршақ пастасы да өте жақсы пісірілген.
Dialogue: 0,0:08:26.77,0:08:29.05,JP,,0000,0000,0000,,Мен күннен қорғайтын крем жағып жүрсем де
Dialogue: 0,0:08:29.41,0:08:30.86,JP,,0000,0000,0000,,Анко да кел
Dialogue: 0,0:08:33.28,0:08:35.58,JP,,0000,0000,0000,,Сізге тек дем алу керек
Dialogue: 0,0:08:35.97,0:08:37.13,JP,,0000,0000,0000,,Ұйқыда сөйлесесіз бе?
Dialogue: 0,0:08:37.76,0:08:39.91,JP,,0000,0000,0000,,Сүлгіні ілу.
Dialogue: 0,0:08:40.52,0:08:41.65,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:08:42.60,0:08:44.11,JP,,0000,0000,0000,,Сіз мұны түсінесіз бе?
Dialogue: 0,0:08:44.22,0:08:48.09,JP,,0000,0000,0000,,Дұрыс, міне, осы бұрыш маңызды.
Dialogue: 0,0:08:48.34,0:08:50.22,JP,,0000,0000,0000,,Дәл осы жерде әйелдер ғашық болады.
Dialogue: 0,0:08:50.92,0:08:52.04,JP,,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:08:52.39,0:08:53.79,JP,,0000,0000,0000,,Мұны істеу мүмкін емес.
Dialogue: 0,0:09:00.13,0:09:04.21,JP,,0000,0000,0000,,Ұзақ қашықтыққа жүзу? Бассейндер мен теңіз - бұл екі бөлек нәрсе.
Dialogue: 0,0:09:04.61,0:09:05.78,JP,,0000,0000,0000,,Жүрек соғуы
Dialogue: 0,0:09:06.22,0:09:07.24,JP,,0000,0000,0000,,Көңіл көтеру
Dialogue: 0,0:09:07.53,0:09:08.77,JP,,0000,0000,0000,,Жай жүзу
Dialogue: 0,0:09:08.93,0:09:11.31,JP,,0000,0000,0000,,Қалғанының бәрі жай ғана көңілді.
Dialogue: 0,0:09:11.54,0:09:12.45,JP,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:09:12.93,0:09:15.65,JP,,0000,0000,0000,,Okay, then think about tonight.
Dialogue: 0,0:09:16.07,0:09:16.92,JP,,0000,0000,0000,,Rice cake
Dialogue: 0,0:09:16.92,0:09:18.16,JP,,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:09:18.40,0:09:20.49,JP,,0000,0000,0000,,Burn it at the campfire.
Dialogue: 0,0:09:20.96,0:09:22.41,JP,,0000,0000,0000,,There's something for everyone too.
Dialogue: 0,0:09:23.47,0:09:24.32,JP,,0000,0000,0000,,Дәмді көрінеді
Dialogue: 0,0:09:24.32,0:09:24.92,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:09:25.00,0:09:26.54,JP,,0000,0000,0000,,As expected of Tama-chan
Dialogue: 0,0:09:27.29,0:09:29.33,JP,,0000,0000,0000,,Mochi is heavy in the summer though.
Dialogue: 0,0:09:29.66,0:09:32.54,JP,,0000,0000,0000,,Бұл дұрыс емес. It's okay even in summer.
Dialogue: 0,0:09:33.07,0:09:35.94,JP,,0000,0000,0000,,Look, it's also on top of Uji Kintoki.
Dialogue: 0,0:09:36.08,0:09:37.79,JP,,0000,0000,0000,,That must be a white ball.
Dialogue: 0,0:09:38.00,0:09:39.42,JP,,0000,0000,0000,,Mochi would also be fine.
Dialogue: 0,0:09:39.77,0:09:41.69,JP,,0000,0000,0000,,Mochi does not become hard
Dialogue: 0,0:09:41.80,0:09:43.25,JP,,0000,0000,0000,,Then warm it up.
Dialogue: 0,0:09:43.57,0:09:44.90,JP,,0000,0000,0000,,The ice will melt
Dialogue: 0,0:09:45.27,0:09:47.49,JP,,0000,0000,0000,,But it looks delicious.
Dialogue: 0,0:09:48.22,0:09:48.77,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:09:49.02,0:09:50.53,JP,,0000,0000,0000,,Deep rice cake
Dialogue: 0,0:09:50.73,0:09:51.70,JP,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:09:54.23,0:09:56.81,JP,,0000,0000,0000,,Эй, сен мені осындай жерге мәжбүрлемексің бе?
Dialogue: 0,0:09:56.84,0:09:58.48,JP,,0000,0000,0000,,Жарайды, кіріңіз.
Dialogue: 0,0:09:58.83,0:10:01.44,JP,,0000,0000,0000,,Менің ойымша, бұл шынымен де жақсы.
Dialogue: 0,0:10:01.74,0:10:06.84,JP,,0000,0000,0000,,Уайымдама, маған қалдырсаң, махаббатты табу оңай болады.
Dialogue: 0,0:10:07.31,0:10:11.21,JP,,0000,0000,0000,,Одан да, егер сіз осында шынымен кірсеңіз, жағажайға жетуіңіз мүмкін.
Dialogue: 0,0:10:11.59,0:10:15.81,JP,,0000,0000,0000,,Иә, онда келу санына қарай кезекке отырыңыз.
Dialogue: 0,0:10:16.54,0:10:18.59,JP,,0000,0000,0000,,Жарайды, тыныш бол.
Dialogue: 0,0:10:18.59,0:10:19.53,JP,,0000,0000,0000,,Мұнда
Dialogue: 0,0:10:19.68,0:10:21.42,JP,,0000,0000,0000,,Оны алыңыз
Dialogue: 0,0:10:29.24,0:10:30.74,JP,,0000,0000,0000,,Маған екі қабатты кереуеттер ұнайды
Dialogue: 0,0:10:35.07,0:10:36.35,JP,,0000,0000,0000,,Бұл Канна Чан
Dialogue: 0,0:10:36.81,0:10:38.95,JP,,0000,0000,0000,,Kanna is so motivated.
Dialogue: 0,0:10:39.23,0:10:40.75,JP,,0000,0000,0000,,Жүзу ертең болады.
Dialogue: 0,0:10:41.47,0:10:43.62,JP,,0000,0000,0000,,Өйткені мен ұзақ қашықтыққа жүзгенді ұнатамын.
Dialogue: 0,0:10:48.92,0:10:50.24,JP,,0000,0000,0000,,Эй, жақсысың ба?
Dialogue: 0,0:10:51.56,0:10:54.70,JP,,0000,0000,0000,,Менің көзім айналып, ауырып тұрмын.
Dialogue: 0,0:10:54.77,0:10:56.13,JP,,0000,0000,0000,,Look, it's the sea.
Dialogue: 0,0:10:58.11,0:11:01.43,JP,,0000,0000,0000,,O sea, the nostalgic scent of the tide
Dialogue: 0,0:11:01.43,0:11:04.24,JP,,0000,0000,0000,,Құстардың қозғалыс ауруымен ауыратынын бірінші рет білдім.
Dialogue: 0,0:11:05.57,0:11:06.93,JP,,0000,0000,0000,,Эй, құспа.
Dialogue: 0,0:11:07.13,0:11:08.67,JP,,0000,0000,0000,,Yamuwoen
Dialogue: 0,0:11:08.67,0:11:10.65,JP,,0000,0000,0000,,Өзіңізді жақсы сезінбейінше теңізге бармаңыз.
Dialogue: 0,0:11:11.56,0:11:14.03,JP,,0000,0000,0000,,Жас жігіт, мәтініңді дайындадың ба?
Dialogue: 0,0:11:14.35,0:11:15.25,JP,,0000,0000,0000,,sentence
Dialogue: 0,0:11:15.81,0:11:17.47,JP,,0000,0000,0000,,Иә, мен оны жағдайға байланысты жаздым.
Dialogue: 0,0:11:17.65,0:11:18.80,JP,,0000,0000,0000,,Okay, read it.
Dialogue: 0,0:11:18.80,0:11:19.58,JP,,0000,0000,0000,,Here?
Dialogue: 0,0:11:21.00,0:11:24.05,JP,,0000,0000,0000,,Мен бір нәрсе туралы айтқым келеді.
Dialogue: 0,0:11:24.33,0:11:26.71,JP,,0000,0000,0000,,Бүгін кешке шыға аласыз ба?
Dialogue: 0,0:11:26.83,0:11:29.07,JP,,0000,0000,0000,,Бұл жай сөйлем қандай?
Dialogue: 0,0:11:29.63,0:11:30.41,JP,,0000,0000,0000,,Мен сізбен кездескім келеді
Dialogue: 0,0:11:30.71,0:11:32.77,JP,,0000,0000,0000,,Менің ойымша, сіз танысуға жаттығасыз.
Dialogue: 0,0:11:33.27,0:11:35.58,JP,,0000,0000,0000,,Бұл жердегі бұрыш.
Dialogue: 0,0:11:35.58,0:11:37.62,JP,,0000,0000,0000,,Сондықтан сіз мұны істемеңіз деп жатырсыз.
Dialogue: 0,0:11:37.74,0:11:38.58,JP,,0000,0000,0000,,Делла-чан
Dialogue: 0,0:11:38.84,0:11:39.79,JP,,0000,0000,0000,,Tokiwa
Dialogue: 0,0:11:40.43,0:11:42.63,JP,,0000,0000,0000,,Неліктен Делла-чан мұнда?
Dialogue: 0,0:11:42.63,0:11:44.72,JP,,0000,0000,0000,,Әй, қызымның досы ма?
Dialogue: 0,0:11:44.72,0:11:47.31,JP,,0000,0000,0000,,Ей, мына жігіт қызына ғашық...
Dialogue: 0,0:11:47.31,0:11:49.09,JP,,0000,0000,0000,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:11:51.98,0:11:52.86,JP,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:11:53.10,0:11:55.15,JP,,0000,0000,0000,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:11:56.00,0:11:57.93,JP,,0000,0000,0000,,Әй, тез жеткізіңізші.
Dialogue: 0,0:11:58.27,0:12:00.19,JP,,0000,0000,0000,,Бұл өте қиын.
Dialogue: 0,0:12:00.57,0:12:03.16,JP,,0000,0000,0000,,Жеткіземін дегендіктен жазған шығарсың.
Dialogue: 0,0:12:03.16,0:12:06.18,JP,,0000,0000,0000,,Жалпы айтқанда, қыздар жатақханасына ұлдар кірмейді.
Dialogue: 0,0:12:06.28,0:12:07.44,JP,,0000,0000,0000,,Жарайды, жүр.
Dialogue: 0,0:12:10.57,0:12:12.19,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:12.97,0:12:15.93,JP,,0000,0000,0000,,Мм, менің қызым қайда?
Dialogue: 0,0:12:16.45,0:12:18.99,JP,,0000,0000,0000,,Әй қыз, сен осындасың ба?
Dialogue: 0,0:12:17.86,0:12:19.25,JP,,0000,0000,0000,,Мидори-чан осында.
Dialogue: 0,0:12:19.44,0:12:20.87,JP,,0000,0000,0000,,Сәлем қыз
Dialogue: 0,0:12:25.26,0:12:28.19,JP,,0000,0000,0000,,Эй, сен дәл қазір Делланың даусын естімедің бе?
Dialogue: 0,0:12:28.97,0:12:31.50,JP,,0000,0000,0000,,Иә, мен мұны естімедім.
Dialogue: 0,0:12:35.73,0:12:36.51,JP,,0000,0000,0000,,Токива
Dialogue: 0,0:12:41.89,0:12:43.83,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:12:52.53,0:12:56.31,JP,,0000,0000,0000,,Қараңғыда көзімді жұмып, толқынның дыбысын тыңдағанымда,
Dialogue: 0,0:12:56.56,0:12:58.40,JP,,0000,0000,0000,,Туған жерді еске алу
Dialogue: 0,0:12:59.39,0:13:01.46,JP,,0000,0000,0000,,Ханзада, мен міндетті түрде...
Dialogue: 0,0:13:08.34,0:13:09.34,JP,,0000,0000,0000,,Не?
Dialogue: 0,0:13:11.89,0:13:14.00,JP,,0000,0000,0000,,Мен бір нәрсені дәнекерлей алатындай сезінемін.
Dialogue: 0,0:13:14.38,0:13:16.25,JP,,0000,0000,0000,,Тамако, қазір жей аласың ба?
Dialogue: 0,0:13:16.61,0:13:17.86,JP,,0000,0000,0000,,Мүмкін сәл көбірек
Dialogue: 0,0:13:18.58,0:13:19.72,JP,,0000,0000,0000,,Дәмді көрінеді
Dialogue: 0,0:13:19.85,0:13:20.63,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:13:21.25,0:13:22.63,JP,,0000,0000,0000,,Бұл не сұмдық?
Dialogue: 0,0:13:23.00,0:13:23.91,JP,,0000,0000,0000,,Бөлек
Dialogue: 0,0:13:24.15,0:13:27.15,JP,,0000,0000,0000,,Мен жай ғана Тамако қиындыққа тап болады деп ойладым.
Dialogue: 0,0:13:27.86,0:13:29.63,JP,,0000,0000,0000,,Оның Токиваға еш қатысы жоқ шығар.
Dialogue: 0,0:13:29.79,0:13:30.58,JP,,0000,0000,0000,,Харизма!
Dialogue: 0,0:13:30.86,0:13:33.35,JP,,0000,0000,0000,,Тамакоға жазылуды тоқтатсаңыз
Dialogue: 0,0:13:33.91,0:13:35.46,JP,,0000,0000,0000,,Арнайы қосымша бар ма?
Dialogue: 0,0:13:35.60,0:13:36.81,JP,,0000,0000,0000,,I'm wearing it
Dialogue: 0,0:13:37.20,0:13:40.55,JP,,0000,0000,0000,,Білесің бе, Тамако, мен Оджи туралы мүлдем ештеңе көрмедім.
Dialogue: 0,0:13:40.70,0:13:43.07,JP,,0000,0000,0000,,Сол себепті мойындау мүмкін емес деп ойлаймын.
Dialogue: 0,0:13:43.14,0:13:44.67,JP,,0000,0000,0000,,Confession?!
Dialogue: 0,0:13:44.81,0:13:46.61,JP,,0000,0000,0000,,Мен олай істемеймін...
Dialogue: 0,0:13:46.67,0:13:47.63,JP,,0000,0000,0000,,Сонымен не?
Dialogue: 0,0:13:47.63,0:13:49.53,JP,,0000,0000,0000,,Сонымен не?
Dialogue: 0,0:13:49.64,0:13:51.91,JP,,0000,0000,0000,,Мені жалғыз қалдырмайсың ба деп уайымдаймын.
Dialogue: 0,0:13:52.03,0:13:53.31,JP,,0000,0000,0000,,Иә, мен уайымдап тұрмын.
Dialogue: 0,0:13:53.70,0:13:57.34,JP,,0000,0000,0000,,Қараңдаршы, ол бей-берекет, бір қауіп бар шығар.
Dialogue: 0,0:13:57.72,0:13:58.46,JP,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:13:58.59,0:14:01.17,JP,,0000,0000,0000,,Менің ойымша, олай емес.
Dialogue: 0,0:14:01.62,0:14:03.11,JP,,0000,0000,0000,,Мұндай жағдай орын алады.
Dialogue: 0,0:14:03.35,0:14:05.98,JP,,0000,0000,0000,,Мен оны бала кезімнен білемін.
Dialogue: 0,0:14:07.06,0:14:08.85,JP,,0000,0000,0000,,Бұл жай ғана мочи дүкені мен мочи дүкені шығар.
Dialogue: 0,0:14:09.00,0:14:11.09,JP,,0000,0000,0000,,Тамакомен сөйлесіп тұрған менмін.
Dialogue: 0,0:14:11.19,0:14:12.63,JP,,0000,0000,0000,,Мен де сөйлеп тұрмын.
Dialogue: 0,0:14:12.90,0:14:15.29,JP,,0000,0000,0000,,Мен Тамаконы сізден жақсы білемін.
Dialogue: 0,0:14:15.49,0:14:19.10,JP,,0000,0000,0000,,Сонымен, Тамако енді 25 метрге жүзе алатынын білесіз бе?
Dialogue: 0,0:14:19.24,0:14:20.72,JP,,0000,0000,0000,,Шынайы ма? Бұл керемет.
Dialogue: 0,0:14:21.65,0:14:25.04,JP,,0000,0000,0000,,Сонымен, Тамаконың көзілдірік киетінін білесің бе?
Dialogue: 0,0:14:25.72,0:14:26.47,JP,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:14:26.82,0:14:28.32,JP,,0000,0000,0000,,Менің ойымша, сіз білмейсіз
Dialogue: 0,0:14:28.44,0:14:31.65,JP,,0000,0000,0000,,Мен контактілерді алмас бұрын мен осындай көзілдірік кидім.
Dialogue: 0,0:14:32.22,0:14:33.82,JP,,0000,0000,0000,,Білетініңізге сенімдімін.
Dialogue: 0,0:14:34.51,0:14:37.31,JP,,0000,0000,0000,,Біз бастауыш мектептің төртінші сыныбынан бері біргеміз.
Dialogue: 0,0:14:37.44,0:14:38.86,JP,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:14:38.97,0:14:43.61,JP,,0000,0000,0000,,Бірақ мен де мочизомын және Тамаконың сүйікті мочиімін.
Dialogue: 0,0:14:43.61,0:14:47.86,JP,,0000,0000,0000,,Ей, жігіт, мен саған көмектесейін.
Dialogue: 0,0:14:48.73,0:14:50.20,JP,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:52.45,0:14:53.87,JP,,0000,0000,0000,,Төмен түскен дұрыс
Dialogue: 0,0:14:53.87,0:14:56.87,JP,,0000,0000,0000,,Бұл мен сияқты асыл адамға қол сұғудың өзі күлкі болар еді.
Dialogue: 0,0:14:57.88,0:14:59.78,JP,,0000,0000,0000,,Сонымен не істеп жатырсың?
Dialogue: 0,0:15:00.06,0:15:01.16,JP,,0000,0000,0000,,C.C.
Dialogue: 0,0:15:02.57,0:15:06.24,JP,,0000,0000,0000,,Жалпы айтқанда, Делла-чанның көмегімен мойындауға тырысу жақсы емес.
Dialogue: 0,0:15:06.56,0:15:08.60,JP,,0000,0000,0000,,Қарғыс атсын, бұл...
Dialogue: 0,0:15:08.60,0:15:11.21,JP,,0000,0000,0000,,Қалай болғанда да, Тамако менің досым.
Dialogue: 0,0:15:11.63,0:15:13.16,JP,,0000,0000,0000,,Мен сені қорғаймын
Dialogue: 0,0:15:14.59,0:15:16.98,JP,,0000,0000,0000,,Тамакоға не айтатыным өзіме байланысты.
Dialogue: 0,0:15:19.94,0:15:20.83,JP,,0000,0000,0000,,Ұрыс?
Dialogue: 0,0:15:21.51,0:15:22.64,JP,,0000,0000,0000,,Чи Чигейо
Dialogue: 0,0:15:22.74,0:15:24.79,JP,,0000,0000,0000,,Бұл ұрыс-керіс сияқты емес.
Dialogue: 0,0:15:25.09,0:15:26.02,JP,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:15:26.43,0:15:29.53,JP,,0000,0000,0000,,Иелері бірдей иіске ие болғандай болды.
Dialogue: 0,0:15:30.23,0:15:32.07,JP,,0000,0000,0000,,Қазір аздап дүрбелең, бірақ
Dialogue: 0,0:15:32.32,0:15:34.69,JP,,0000,0000,0000,,Ол кейін әдемі және мөлдір болуы керек.
Dialogue: 0,0:15:35.22,0:15:38.40,JP,,0000,0000,0000,,Шеберлердің иістері бірдей түсті.
Dialogue: 0,0:15:39.18,0:15:40.16,JP,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:15:41.06,0:15:42.66,JP,,0000,0000,0000,,Иә, Делла-чан
Dialogue: 0,0:15:43.76,0:15:45.00,JP,,0000,0000,0000,,Неге мұндасың?
Dialogue: 0,0:15:45.32,0:15:47.53,JP,,0000,0000,0000,,Адамның жол жүруіне себеп жоқ.
Dialogue: 0,0:15:47.91,0:15:49.96,JP,,0000,0000,0000,,Мен одан да қарным ашты, қыз.
Dialogue: 0,0:15:50.30,0:15:51.30,JP,,0000,0000,0000,,Менде күріш торты бар.
Dialogue: 0,0:15:51.81,0:15:54.35,JP,,0000,0000,0000,,Бұл жақсы. Бар, қыз.
Dialogue: 0,0:15:54.65,0:15:55.41,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:15:55.66,0:15:57.44,JP,,0000,0000,0000,,Мидори-чан мен Мочизомен бірге барайық.
Dialogue: 0,0:16:00.69,0:16:03.18,JP,,0000,0000,0000,,Сіз не істеп жатырсыз? Мен тез барамын.
Dialogue: 0,0:16:03.82,0:16:06.10,JP,,0000,0000,0000,,Кешіріңіз, менің бір ісім бар.
Dialogue: 0,0:16:06.47,0:16:07.54,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:16:15.79,0:16:17.97,JP,,0000,0000,0000,,О, керемет күн
Dialogue: 0,0:16:18.37,0:16:21.74,JP,,0000,0000,0000,,Қызық, ханзада да сол күнді көреді ме?
Dialogue: 0,0:16:21.99,0:16:24.03,JP,,0000,0000,0000,,Ханзада, сәл күте тұрыңыз.
Dialogue: 0,0:16:24.39,0:16:25.96,JP,,0000,0000,0000,,Міндетті түрде қазір патшайым алыңыз
Dialogue: 0,0:16:35.25,0:16:36.65,JP,,0000,0000,0000,,Аа.
Dialogue: 0,0:16:37.04,0:16:38.14,JP,,0000,0000,0000,,Қолымыздан келгенше Тамако жасайық
Dialogue: 0,0:16:38.33,0:16:40.29,JP,,0000,0000,0000,,Сіз мұны істей аласыз, өйткені сіз жаттығу жасадыңыз.
Dialogue: 0,0:16:40.50,0:16:41.87,JP,,0000,0000,0000,,Yes, that's right.
Dialogue: 0,0:16:41.94,0:16:45.04,JP,,0000,0000,0000,,Жарайды, жүзе алмайтындардың жүзу қуығы бар.
Dialogue: 0,0:16:45.56,0:16:47.30,JP,,0000,0000,0000,,Ауырса, дереу айт.
Dialogue: 0,0:16:47.60,0:16:49.29,JP,,0000,0000,0000,,Бала бітті ме?
Dialogue: 0,0:16:49.43,0:16:51.44,JP,,0000,0000,0000,,Барлығы таусылды.
Dialogue: 0,0:16:51.44,0:16:53.19,JP,,0000,0000,0000,,Ұзақ қашықтыққа жүзу қорқынышты.
Dialogue: 0,0:16:53.19,0:16:54.40,JP,,0000,0000,0000,,Тамако
Dialogue: 0,0:16:54.40,0:16:56.84,JP,,0000,0000,0000,,Уау, бұл өте қиын
Dialogue: 0,0:16:57.11,0:16:58.17,JP,,0000,0000,0000,,Тамако, кеттік
Dialogue: 0,0:16:58.44,0:16:59.83,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:17:02.06,0:17:02.89,JP,,0000,0000,0000,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:17:03.27,0:17:05.85,JP,,0000,0000,0000,,Менің ойымша, ол қазір 25 метр жүзе алады.
Dialogue: 0,0:17:06.84,0:17:07.40,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:17:13.00,0:17:14.24,JP,,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:17:19.83,0:17:21.09,JP,,0000,0000,0000,,Сәттілік Тамако
Dialogue: 0,0:17:21.77,0:17:23.89,JP,,0000,0000,0000,,Сәттілік Тама-чан
Dialogue: 0,0:17:24.37,0:17:28.13,JP,,0000,0000,0000,,Канна Бұл жүзуден гөрі жүзу сияқты.
Dialogue: 0,0:17:28.68,0:17:30.35,JP,,0000,0000,0000,,Себебі мен ұзақ қашықтыққа жүзуді жақсы білемін
Dialogue: 0,0:17:30.80,0:17:31.47,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:17:34.63,0:17:36.39,JP,,0000,0000,0000,,Сіз мұны істедіңіз. Тек жартысы қалды.
Dialogue: 0,0:17:40.53,0:17:41.69,JP,,0000,0000,0000,,Аремохизо
Dialogue: 0,0:17:41.95,0:17:42.59,JP,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:17:43.43,0:17:46.07,JP,,0000,0000,0000,,Жақсы, бітіргендердің қалтасы көтереді.
Dialogue: 0,0:17:47.03,0:17:49.33,JP,,0000,0000,0000,,Ал, кеттік, Мидори-чан.
Dialogue: 0,0:17:50.25,0:17:53.34,JP,,0000,0000,0000,,Эй, Тамако Оджи туралы не ойлайды?
Dialogue: 0,0:17:54.42,0:17:55.29,JP,,0000,0000,0000,,Қалай?
Dialogue: 0,0:17:55.52,0:17:56.73,JP,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:17:57.33,0:17:58.56,JP,,0000,0000,0000,,Біз бала кезден доспыз.
Dialogue: 0,0:17:58.83,0:18:00.40,JP,,0000,0000,0000,,Дәлірек айтқанда, мочи дүкенінде достар.
Dialogue: 0,0:18:00.56,0:18:01.72,JP,,0000,0000,0000,,Дұрыс па, солай емес пе?
Dialogue: 0,0:18:01.80,0:18:03.46,JP,,0000,0000,0000,,Олай болса, мен ше?
Dialogue: 0,0:18:04.04,0:18:04.94,JP,,0000,0000,0000,,Мидори-чан?
Dialogue: 0,0:18:05.18,0:18:07.79,JP,,0000,0000,0000,,Мен Мидори-чанды жақсы көремін
Dialogue: 0,0:18:10.28,0:18:10.94,JP,,0000,0000,0000,,Рахмет
Dialogue: 0,0:18:10.94,0:18:12.97,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:18:12.97,0:18:13.79,JP,,0000,0000,0000,,Делла-чан
Dialogue: 0,0:18:16.06,0:18:18.99,JP,,0000,0000,0000,,Мен сияқты асыл нәрсеге келгенде,
Dialogue: 0,0:18:18.99,0:18:20.74,JP,,0000,0000,0000,,Жақындап келе жатқан адамдар көп...
Dialogue: 0,0:18:23.21,0:18:24.80,JP,,0000,0000,0000,,Делла-чан, сен танымалсың.
Dialogue: 0,0:18:25.03,0:18:26.56,JP,,0000,0000,0000,,Мен оны олай көрмеймін.
Dialogue: 0,0:18:28.76,0:18:30.54,JP,,0000,0000,0000,,Тама-чан Тама-чан
Dialogue: 0,0:18:30.88,0:18:32.40,JP,,0000,0000,0000,,Жақында отшашу болады
Dialogue: 0,0:18:32.64,0:18:34.20,JP,,0000,0000,0000,,Барлығы сыртқа шықты.
Dialogue: 0,0:18:34.73,0:18:37.23,JP,,0000,0000,0000,,Тама-чан оны асыға күтетінін айтты.
Dialogue: 0,0:18:37.23,0:18:38.49,JP,,0000,0000,0000,,Иә, мен ояумын.
Dialogue: 0,0:18:43.75,0:18:45.42,JP,,0000,0000,0000,,Сіз шынымен шаршаған болуыңыз керек.
Dialogue: 0,0:18:48.69,0:18:49.50,JP,,0000,0000,0000,,Канна-чан
Dialogue: 0,0:18:52.19,0:18:53.24,JP,,0000,0000,0000,,Бұл теңіз бе?
Dialogue: 0,0:18:53.82,0:18:54.71,JP,,0000,0000,0000,,Мен суға батып кетемін
Dialogue: 0,0:18:57.48,0:18:59.80,JP,,0000,0000,0000,,Отшашу, Шиори-чан, Канна-чан
Dialogue: 0,0:18:59.94,0:19:00.54,JP,,0000,0000,0000,,оянды
Dialogue: 0,0:19:00.87,0:19:03.60,JP,,0000,0000,0000,,Кеттік. Екеуің қалай демалып жатырсыңдар?
Dialogue: 0,0:19:04.78,0:19:06.24,JP,,0000,0000,0000,,Бұл керемет, Тамако.
Dialogue: 0,0:19:06.63,0:19:07.08,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:19:11.03,0:19:11.74,JP,,0000,0000,0000,,Неге?
Dialogue: 0,0:19:12.50,0:19:13.46,JP,,0000,0000,0000,,Бөлек
Dialogue: 0,0:19:13.46,0:19:16.23,JP,,0000,0000,0000,,Әңгімелейтін нәрсең болса кел.
Dialogue: 0,0:19:18.07,0:19:19.35,JP,,0000,0000,0000,,Жарайды, проблема жоқ.
Dialogue: 0,0:19:20.22,0:19:20.90,JP,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:19:21.16,0:19:22.78,JP,,0000,0000,0000,,Оның сізге қатысы жоқ.
Dialogue: 0,0:19:23.28,0:19:24.90,JP,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:19:25.08,0:19:26.80,JP,,0000,0000,0000,,Әй, қара, қара!
Dialogue: 0,0:19:28.74,0:19:30.40,JP,,0000,0000,0000,,Үлкен
Dialogue: 0,0:19:30.62,0:19:33.50,JP,,0000,0000,0000,,Тез сол жаққа барайық. Ол үлкенірек көрінеді.
Dialogue: 0,0:19:33.50,0:19:35.04,JP,,0000,0000,0000,,Тама-чан, күте тұрыңыз
Dialogue: 0,0:19:39.14,0:19:40.32,JP,,0000,0000,0000,,Токива да кетуі керек.
Dialogue: 0,0:19:41.51,0:19:43.33,JP,,0000,0000,0000,,Менімен жүргеннен пайда жоқ.
Dialogue: 0,0:19:43.85,0:19:46.07,JP,,0000,0000,0000,,Уайымдама, мен енді мойындамаймын...
Dialogue: 0,0:19:46.39,0:19:50.66,JP,,0000,0000,0000,,Жоқ, мен басқа ештеңе істеуді жоспарлаған жоқпын.
Dialogue: 0,0:19:51.14,0:19:51.84,JP,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:19:51.91,0:19:54.81,JP,,0000,0000,0000,,Сондықтан бұл туралы айтудың қажеті жоқ.
Dialogue: 0,0:19:55.24,0:19:59.35,JP,,0000,0000,0000,,Сондықтан мен біріншіден ештеңе айтуды жоспарлаған жоқпын.
Dialogue: 0,0:19:59.43,0:20:00.09,JP,,0000,0000,0000,,Сонымен
Dialogue: 0,0:20:00.52,0:20:01.78,JP,,0000,0000,0000,,Әй, итата
Dialogue: 0,0:20:01.91,0:20:03.42,JP,,0000,0000,0000,,Мидори-чан Мидори-чан
Dialogue: 0,0:20:03.55,0:20:05.82,JP,,0000,0000,0000,,Мен сол жерден жақсы жер таптым.
Dialogue: 0,0:20:06.26,0:20:08.14,JP,,0000,0000,0000,,Бұл жасырын асыл тас. Бұл жасырын асыл тас.
Dialogue: 0,0:20:08.14,0:20:09.04,JP,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:20:09.45,0:20:10.69,JP,,0000,0000,0000,,Оджи де кеттік.
Dialogue: 0,0:20:11.31,0:20:12.23,JP,,0000,0000,0000,,Менде бәрі жақсы
Dialogue: 0,0:20:12.43,0:20:14.04,JP,,0000,0000,0000,,Мочизо да келуі керек.
Dialogue: 0,0:20:15.94,0:20:17.16,JP,,0000,0000,0000,,Тамако да қоңырау шалып жатыр.
Dialogue: 0,0:20:18.63,0:20:19.67,JP,,0000,0000,0000,,Шулы
Dialogue: 0,0:20:25.71,0:20:27.26,JP,,0000,0000,0000,,Тамая
Dialogue: 0,0:20:27.95,0:20:29.09,JP,,0000,0000,0000,,Бұл менің дүкенім.
Dialogue: 0,0:20:29.29,0:20:31.01,JP,,0000,0000,0000,,Тамая
Dialogue: 0,0:20:31.30,0:20:34.87,JP,,0000,0000,0000,,Тамаяның күріш тортын тамашалаңыздар
Dialogue: 0,0:20:35.29,0:20:37.21,JP,,0000,0000,0000,,Тамая
Dialogue: 0,0:20:37.21,0:20:39.35,JP,,0000,0000,0000,,Дәмді күріш торты
Dialogue: 0,0:20:40.04,0:20:41.22,JP,,0000,0000,0000,,Ақымақ болма
Dialogue: 0,0:20:43.17,0:20:45.03,JP,,0000,0000,0000,,Тамая
Dialogue: 0,0:20:45.23,0:20:47.67,JP,,0000,0000,0000,,Күріш торты үшін де рахмет Oh!ZEE
Dialogue: 0,0:20:49.97,0:20:51.10,JP,,0000,0000,0000,,Сонымен, сетте алты ойынды бірінші жеңген адам жеңеді, иә?
Dialogue: 0,0:20:54.44,0:20:56.86,JP,,0000,0000,0000,,Махаббат отшашуы мен жүрек гүлдері
Dialogue: 0,0:20:57.43,0:20:59.97,JP,,0000,0000,0000,,Жазғы түндегі түс Түрлі-түсті ойлар
Dialogue: 0,0:21:00.46,0:21:03.02,JP,,0000,0000,0000,,Ол тез жоғалып кетпес үшін
Dialogue: 0,0:21:10.29,0:21:11.13,JP,,0000,0000,0000,,Делла-чан
Dialogue: 0,0:21:12.15,0:21:12.88,JP,,0000,0000,0000,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:21:12.97,0:21:13.87,JP,,0000,0000,0000,,Шымшуға ұқсайды
Dialogue: 0,0:21:13.96,0:21:15.03,JP,,0000,0000,0000,,Көмектесіңіз
Dialogue: 0,0:21:27.38,0:21:28.36,JP,,0000,0000,0000,,Үй тапсырмасы
Dialogue: 0,0:21:28.55,0:21:30.43,JP,,0000,0000,0000,,Шулы.
Dialogue: 0,0:21:30.68,0:21:32.59,JP,,0000,0000,0000,,Тағы бір кездейсоқ нәрсе
Dialogue: 0,0:21:32.71,0:21:35.10,JP,,0000,0000,0000,,Мен саған ешқашан көмектеспеймін.
Dialogue: 0,0:21:35.73,0:21:37.72,JP,,0000,0000,0000,,Сіз ешқашан көмек сұрамағаныңызға сенімдімін.
Dialogue: 0,0:21:39.93,0:21:41.33,JP,,0000,0000,0000,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:21:42.21,0:21:43.57,JP,,0000,0000,0000,,Бүгін тағы да ыстық.
Dialogue: 0,0:21:56.48,0:21:57.39,JP,,0000,0000,0000,,Иә…♡
Dialogue: 0,0:23:36.04,0:23:38.32,JP,,0000,0000,0000,,Жаз - тегіс ақ шар, солай емес пе?
Dialogue: 0,0:23:38.44,0:23:39.29,JP,,0000,0000,0000,,Бұл Тамако.
Dialogue: 0,0:23:39.51,0:23:41.73,JP,,0000,0000,0000,,Қантты суық суда да дәмді болады.
Dialogue: 0,0:23:42.01,0:23:44.73,JP,,0000,0000,0000,,«Мүмкін бұл күріш шарларында ерітілмеген қант шығар».
Dialogue: 0,0:23:44.93,0:23:47.16,JP,,0000,0000,0000,,Бұл Киоши Такахама деген адамның өлеңі.
Dialogue: 0,0:23:47.16,0:23:49.97,JP,,0000,0000,0000,,Келесі жолы қандай күріш тортын жеуге болады?
