Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.45,0:00:06.46,Default,,0,0,0,,《Жатақханадағы шай ішу
Dialogue: 0,0:00:01.45,0:00:06.46,Default,,0,0,0,,Раушан кеші➡
Dialogue: 0,0:00:06.46,0:00:12.46,Default,,0,0,0,,Сеанстың құпия жиналысы
Dialogue: 0,0:00:06.46,0:00:12.46,Default,,0,0,0,,Кітапхана шығанағындағы терезе...》
Dialogue: 0,0:00:14.46,0:00:17.47,Default,,0,0,0,,《Мен не істеуім керек? Мен сені сүйемін.》
Dialogue: 0,0:00:17.47,0:00:20.47,Default,,0,0,0,,≪(есіктің ашылу дыбысы)
Dialogue: 0,0:00:17.47,0:00:20.47,Default,,0,0,0,,Ах
Dialogue: 0,0:00:20.47,0:00:35.49,Default,,0,0,0,,♬～
Dialogue: 0,0:00:35.49,0:00:37.49,Default,,0,0,0,,Ах
Dialogue: 0,0:00:44.49,0:00:46.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:49.50,0:00:51.50,Default,,0,0,0,,Ясуко
Dialogue: 0,0:00:49.50,0:00:51.50,Default,,0,0,0,,(Кёки)
Dialogue: 0,0:00:49.50,0:00:51.50,Default,,0,0,0,,Уау! Сен не істеп жатырсың? Сіз
Dialogue: 0,0:00:51.50,0:00:55.52,Default,,0,0,0,,Ах, жоқ. Бірдеңе болды...
Dialogue: 0,0:00:55.52,0:00:57.44,Default,,0,0,0,,Сенің достарың кім?
Dialogue: 0,0:00:57.44,0:01:02.45,Default,,0,0,0,,Мен шіркеуге барамын.
Dialogue: 0,0:00:57.44,0:01:02.45,Default,,0,0,0,,Менімен бірге бармадың ба?
Dialogue: 0,0:01:02.45,0:01:04.45,Default,,0,0,0,,Иә. Ой...
Dialogue: 0,0:01:04.45,0:01:08.45,Default,,0,0,0,,Менің ағама
Dialogue: 0,0:01:04.45,0:01:08.45,Default,,0,0,0,,Мен сізбен бір нәрсе туралы сөйлескім келеді.
Dialogue: 0,0:01:08.45,0:01:11.45,Default,,0,0,0,,Мен айтуды ұмытып кетіппін...
Dialogue: 0,0:01:13.46,0:01:16.46,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:01:16.46,0:01:19.46,Default,,0,0,0,,Әңгімелесейік. Біз сыртқа шыға аламыз ба?
Dialogue: 0,0:01:19.46,0:01:21.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:21.46,0:01:25.46,Default,,0,0,0,,Сырттан бірдеңені тыңдағым келеді.
Dialogue: 0,0:01:27.47,0:01:32.48,Default,,0,0,0,,Көк
Dialogue: 0,0:01:27.47,0:01:32.48,Default,,0,0,0,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:01:27.47,0:01:32.48,Default,,0,0,0,,♬『Көк гүл』
Dialogue: 0,0:01:32.48,0:01:42.49,Default,,0,0,0,,♬～
Dialogue: 0,0:01:42.49,0:01:51.49,Default,,0,0,0,,♬～
Dialogue: 0,0:01:51.49,0:02:11.45,Default,,0,0,0,,♬～
Dialogue: 0,0:02:11.45,0:02:31.47,Default,,0,0,0,,♬～
Dialogue: 0,0:02:31.47,0:02:45.47,Default,,0,0,0,,♬～
Dialogue: 0,0:02:53.46,0:02:56.46,Default,,0,0,0,,Йоко
Dialogue: 0,0:02:53.46,0:02:56.46,Default,,0,0,0,,Бұл керемет болды!
Dialogue: 0,0:02:53.46,0:02:56.46,Default,,0,0,0,,Мива
Dialogue: 0,0:02:53.46,0:02:56.46,Default,,0,0,0,,Бұл таңқаларлық болды Бұл керемет болды!
Dialogue: 0,0:02:56.46,0:03:00.46,Default,,0,0,0,,Мисако
Dialogue: 0,0:02:56.46,0:03:00.46,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:56.46,0:03:00.46,Default,,0,0,0,,Биік төбе керемет көрінеді.
Dialogue: 0,0:03:00.46,0:03:03.47,Default,,0,0,0,,(Мива)
Dialogue: 0,0:03:00.46,0:03:03.47,Default,,0,0,0,,Витраж әдемі болды!
Dialogue: 0,0:03:03.47,0:03:07.47,Default,,0,0,0,,Ішінен қатты бірдеңе
Dialogue: 0,0:03:03.47,0:03:07.47,Default,,0,0,0,,Сіз өзіңізді алданғандай сезіндіңіз.
Dialogue: 0,0:03:07.47,0:03:11.47,Default,,0,0,0,,Дұрыс! Мен де
Dialogue: 0,0:03:07.47,0:03:11.47,Default,,0,0,0,,Мен ол атмосфераға әлі үйрене алмай жүрмін.
Dialogue: 0,0:03:14.48,0:03:17.48,Default,,0,0,0,,Кешіріңіз. Бұл менің түсінбеуім еді➡
Dialogue: 0,0:03:17.48,0:03:21.48,Default,,0,0,0,,Әдебиет үйірмесі екені көрініп тұр.
Dialogue: 0,0:03:17.48,0:03:21.48,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:03:21.48,0:03:26.49,Default,,0,0,0,,Мен...
Dialogue: 0,0:03:21.48,0:03:26.49,Default,,0,0,0,,Сіз баскетбол клубын тастап жатырсыз ба?
Dialogue: 0,0:03:26.49,0:03:29.49,Default,,0,0,0,,Қайдағы босқа кеткен.
Dialogue: 0,0:03:26.49,0:03:29.49,Default,,0,0,0,,Дене бітімі әдемі болса да
Dialogue: 0,0:03:29.49,0:03:32.50,Default,,0,0,0,,Бұл сенің бойың ұзын болғаны үшін ғана.
Dialogue: 0,0:03:32.50,0:03:35.50,Default,,0,0,0,,Аа, бұл ұят.➡
Dialogue: 0,0:03:35.50,0:03:37.50,Default,,0,0,0,,Бұл ұят. Әттең.
Dialogue: 0,0:03:37.50,0:03:42.51,Default,,0,0,0,,Міне...｡ Мен
Dialogue: 0,0:03:37.50,0:03:42.51,Default,,0,0,0,,Атлетикалық қабілеті өте төмен.
Dialogue: 0,0:03:42.51,0:03:46.51,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:03:42.51,0:03:46.51,Default,,0,0,0,,Бұл қатынасты аяқтайды.➡
Dialogue: 0,0:03:46.51,0:03:49.45,Default,,0,0,0,,Манджуме
Dialogue: 0,0:03:46.51,0:03:49.45,Default,,0,0,0,,Мен туралы, Манжоме мырза
Dialogue: 0,0:03:46.51,0:03:49.45,Default,,0,0,0,,Өйткені маған ұнады
Dialogue: 0,0:03:49.45,0:03:51.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:53.45,0:03:55.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:55.45,0:04:00.46,Default,,0,0,0,,Мен оны алғаш көргенде шертті.
Dialogue: 0,0:03:55.45,0:04:00.46,Default,,0,0,0,,Эй, бұл маған ұнайды.
Dialogue: 0,0:04:00.46,0:04:03.46,Default,,0,0,0,,Бұл... әзіл...
Dialogue: 0,0:04:03.46,0:04:06.46,Default,,0,0,0,,Мен байсалдымын.
Dialogue: 0,0:04:13.47,0:04:16.47,Default,,0,0,0,,О
Dialogue: 0,0:04:13.47,0:04:16.47,Default,,0,0,0,,Көңіл-күйде бірдеңе бар.
Dialogue: 0,0:04:16.47,0:04:18.47,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:04:16.47,0:04:18.47,Default,,0,0,0,,Жарайды, сөзді бөлейік.
Dialogue: 0,0:04:18.47,0:04:22.48,Default,,0,0,0,,Неге мені мазалайсың?
Dialogue: 0,0:04:18.47,0:04:22.48,Default,,0,0,0,,Өйткені мұндай жерде➡
Dialogue: 0,0:04:22.48,0:04:24.48,Default,,0,0,0,,Біз қарап тұрмыз
Dialogue: 0,0:04:22.48,0:04:24.48,Default,,0,0,0,,Әрі қарай не істеу керек➡
Dialogue: 0,0:04:24.48,0:04:27.48,Default,,0,0,0,,Махаббат жолына тосқауыл емес пе?
Dialogue: 0,0:04:27.48,0:04:29.49,Default,,0,0,0,,Мен барамын.➡
Dialogue: 0,0:04:29.49,0:04:32.49,Default,,0,0,0,,Манжоме-сан Каэро!
Dialogue: 0,0:04:37.49,0:04:41.50,Default,,0,0,0,,Боу?
Dialogue: 0,0:04:41.50,0:04:45.50,Default,,0,0,0,,Ах-чан! Қайта кездескенше!
Dialogue: 0,0:04:48.44,0:04:50.44,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:04:53.44,0:04:57.45,Default,,0,0,0,,Сугимото
Dialogue: 0,0:04:53.44,0:04:57.45,Default,,0,0,0,,《Бұл адам Сугимото-сенпай》
Dialogue: 0,0:04:57.45,0:05:05.45,Default,,0,0,0,,♬～
Dialogue: 0,0:05:05.45,0:05:20.47,Default,,0,0,0,,♬～
Dialogue: 0,0:05:20.47,0:05:23.47,Default,,0,0,0,,Киоко
Dialogue: 0,0:05:20.47,0:05:23.47,Default,,0,0,0,,《Анашым! 》
Dialogue: 0,0:05:27.48,0:05:30.48,Default,,0,0,0,,《Киоко Мен осындамын! 》
Dialogue: 0,0:05:35.48,0:05:42.48,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:05:57.44,0:06:00.44,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:05:57.44,0:06:00.44,Default,,0,0,0,,Қайырлы таң. Менің атым Ясуши.
Dialogue: 0,0:06:00.44,0:06:04.45,Default,,0,0,0,,≪(Киоконың анасы)
Dialogue: 0,0:06:00.44,0:06:04.45,Default,,0,0,0,,Киоко-сан! Әлі де бар ма?
Dialogue: 0,0:06:04.45,0:06:07.45,Default,,0,0,0,,Тағы біраз
Dialogue: 0,0:06:04.45,0:06:07.45,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:06:07.45,0:06:09.45,Default,,0,0,0,,(Киоконың анасы)
Dialogue: 0,0:06:07.45,0:06:09.45,Default,,0,0,0,,Кешіріңіз, Ясу-чан.
Dialogue: 0,0:06:09.45,0:06:12.45,Default,,0,0,0,,Маған бәрібір, апай.
Dialogue: 0,0:06:26.47,0:06:28.47,Default,,0,0,0,,Көлікпен
Dialogue: 0,0:06:26.47,0:06:28.47,Default,,0,0,0,,Тек мектепке барыңыз.➡
Dialogue: 0,0:06:28.47,0:06:31.47,Default,,0,0,0,,Неліктен қымбат?
Dialogue: 0,0:06:28.47,0:06:31.47,Default,,0,0,0,,Сіз оны маған сатып алсаңыз да
Dialogue: 0,0:06:31.47,0:06:34.48,Default,,0,0,0,,Жіберемін десем де
Dialogue: 0,0:06:31.47,0:06:34.48,Default,,0,0,0,,Киоко, сен мінбейсің.
Dialogue: 0,0:06:34.48,0:06:37.48,Default,,0,0,0,,Маған пойызбен саяхаттаған ұнайды.
Dialogue: 0,0:06:37.48,0:06:40.48,Default,,0,0,0,,Жақында қайта айтыңыз
Dialogue: 0,0:06:40.48,0:06:45.49,Default,,0,0,0,,Ах
Dialogue: 0,0:06:40.48,0:06:45.49,Default,,0,0,0,,Маған біраз сенім артыңызшы.
Dialogue: 0,0:06:45.49,0:06:47.51,Default,,0,0,0,,Мен әрқашан саған сенемін.
Dialogue: 0,0:06:47.51,0:06:51.43,Default,,0,0,0,,(Канг)
Dialogue: 0,0:06:47.51,0:06:51.43,Default,,0,0,0,,Мен саған арқа сүйейтінмін... Бұл қателік болса керек.
Dialogue: 0,0:06:51.43,0:06:53.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:53.43,0:06:56.43,Default,,0,0,0,,Киоко. Өзімшілдік өткенде
Dialogue: 0,0:06:53.43,0:06:56.43,Default,,0,0,0,,Бұл сүйкімді емес
Dialogue: 0,0:06:56.43,0:06:59.44,Default,,0,0,0,,Мен бастапқыда болдым
Dialogue: 0,0:06:56.43,0:06:59.44,Default,,0,0,0,,Бұл сүйкімді емес пе?
Dialogue: 0,0:06:59.44,0:07:01.44,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:07:01.44,0:07:04.44,Default,,0,0,0,,Жексенбіге дейін
Dialogue: 0,0:07:01.44,0:07:04.44,Default,,0,0,0,,Қыздарды жинап алсаңыз болғаны.
Dialogue: 0,0:07:06.44,0:07:09.45,Default,,0,0,0,,Иә
Dialogue: 0,0:07:06.44,0:07:09.45,Default,,0,0,0,,Шешім болған кезде мен сізге қоңырау шаламын.
Dialogue: 0,0:07:09.45,0:07:14.45,Default,,0,0,0,,Содан кейін оны сол жерге орнатыңыз.
Dialogue: 0,0:07:09.45,0:07:14.45,Default,,0,0,0,,Маған жібергеніңіз үшін рахмет.
Dialogue: 0,0:07:18.45,0:07:21.45,Default,,0,0,0,,Шынында сүйкімді емес
Dialogue: 0,0:07:25.46,0:07:27.46,Default,,0,0,0,,Окудаира
Dialogue: 0,0:07:25.46,0:07:27.46,Default,,0,0,0,,Окудаира мырза
Dialogue: 0,0:07:27.46,0:07:31.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:27.46,0:07:31.47,Default,,0,0,0,,Бір сәтке бола аламын ба?
Dialogue: 0,0:07:31.47,0:07:34.47,Default,,0,0,0,,Бұл соқыр кездесу! Бұл топтық кездесу ме?
Dialogue: 0,0:07:34.47,0:07:37.47,Default,,0,0,0,,Міне, солай болады деп ойлаймын.
Dialogue: 0,0:07:37.47,0:07:43.48,Default,,0,0,0,,Түсіндім, бұл соқыр кездесу...
Dialogue: 0,0:07:37.47,0:07:43.48,Default,,0,0,0,,Бұл менің бірлескен кездесудегі дебютім!
Dialogue: 0,0:07:43.48,0:07:45.48,Default,,0,0,0,,Бұлай дайындалудың қажеті жоқ.
Dialogue: 0,0:07:45.48,0:07:48.42,Default,,0,0,0,,Өйткені басқа адам
Dialogue: 0,0:07:45.48,0:07:48.42,Default,,0,0,0,,Сіз университет студентісіз бе?
Dialogue: 0,0:07:48.42,0:07:51.42,Default,,0,0,0,,Мен не айтарымды білмеймін.
Dialogue: 0,0:07:51.42,0:07:54.42,Default,,0,0,0,,Ұйымдастырушы
Dialogue: 0,0:07:51.42,0:07:54.42,Default,,0,0,0,,Бұл менің жақсы есімім➡
Dialogue: 0,0:07:54.42,0:07:57.43,Default,,0,0,0,,Окудайра-сан қолайлы болуы мүмкін.
Dialogue: 0,0:07:57.43,0:08:01.43,Default,,0,0,0,,Жақсы тапсырыс…
Dialogue: 0,0:07:57.43,0:08:01.43,Default,,0,0,0,,Мұндай нәрсе бүгінде де бар.
Dialogue: 0,0:08:01.43,0:08:03.43,Default,,0,0,0,,Бұл жай ғана форма.
Dialogue: 0,0:08:03.43,0:08:08.44,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:08:03.43,0:08:08.44,Default,,0,0,0,,Икуми
Dialogue: 0,0:08:03.43,0:08:08.44,Default,,0,0,0,,Игуми мырзаға кім ұнайды?
Dialogue: 0,0:08:08.44,0:08:12.44,Default,,0,0,0,,Ол адам емес.
Dialogue: 0,0:08:08.44,0:08:12.44,Default,,0,0,0,,А... солай ма?
Dialogue: 0,0:08:12.44,0:08:15.44,Default,,0,0,0,,Мен
Dialogue: 0,0:08:12.44,0:08:15.44,Default,,0,0,0,,Мені ұнататын адам тастап кетті
Dialogue: 0,0:08:15.44,0:08:17.44,Default,,0,0,0,,Иә!?
Dialogue: 0,0:08:19.45,0:08:23.45,Default,,0,0,0,,Енді
Dialogue: 0,0:08:19.45,0:08:23.45,Default,,0,0,0,,Мен біраз үмітсізмін.
Dialogue: 0,0:08:23.45,0:08:25.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:46.48,0:08:48.41,Default,,0,0,0,,≪(есік жабылу дыбысы)
Dialogue: 0,0:08:48.41,0:08:53.42,Default,,0,0,0,,Иә, сол – қамыр жағылған.
Dialogue: 0,0:08:48.41,0:08:53.42,Default,,0,0,0,,«Жақын туыстарынан басқа еркектердің кіруіне тыйым салынады.
Dialogue: 0,0:08:48.41,0:08:53.42,Default,,0,0,0,,Қатаң тыйым салынған.➡
Dialogue: 0,0:08:53.42,0:08:57.42,Default,,0,0,0,,Оған рұқсат етілген
Dialogue: 0,0:08:53.42,0:08:57.42,Default,,0,0,0,,«Тек шақыру бойынша»…｡➡
Dialogue: 0,0:08:57.42,0:08:59.42,Default,,0,0,0,,«Тек келісесіз»
Dialogue: 0,0:08:57.42,0:08:59.42,Default,,0,0,0,,Керемет
Dialogue: 0,0:08:59.42,0:09:02.43,Default,,0,0,0,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:08:59.42,0:09:02.43,Default,,0,0,0,,Жас ханым мектебінен күткендей
Dialogue: 0,0:09:02.43,0:09:05.43,Default,,0,0,0,,Сакико
Dialogue: 0,0:09:02.43,0:09:05.43,Default,,0,0,0,,Бірақ
Dialogue: 0,0:09:02.43,0:09:05.43,Default,,0,0,0,,«Бұл жақсы» ➡ сияқты бірдеңе айтыңыз
Dialogue: 0,0:09:05.43,0:09:07.43,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:09:05.43,0:09:07.43,Default,,0,0,0,,Жігітіңізді әкелмейсіз бе?
Dialogue: 0,0:09:07.43,0:09:09.43,Default,,0,0,0,,Дұрыс. Міне бітті.
Dialogue: 0,0:09:09.43,0:09:12.44,Default,,0,0,0,,Жыл сайын жақсы неке болады
Dialogue: 0,0:09:09.43,0:09:12.44,Default,,0,0,0,,Кейбір адамдар өзгереді.
Dialogue: 0,0:09:12.44,0:09:15.44,Default,,0,0,0,,Ахаха…｡ Ия.
Dialogue: 0,0:09:23.45,0:09:25.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:27.45,0:09:29.45,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:09:42.47,0:09:44.47,Default,,0,0,0,,Ах
Dialogue: 0,0:09:48.40,0:09:51.41,Default,,0,0,0,,[ТД] Ертең бүкіл ел бойынша
Dialogue: 0,0:09:48.40,0:09:51.41,Default,,0,0,0,,Көптеген жерлерде күн ашық болады
Dialogue: 0,0:09:51.41,0:09:53.41,Default,,0,0,0,,<Дәрігер Китамура үнемі «Бәрі анаңның арқасы» деп қайталайтын➡
Dialogue: 0,0:09:51.41,0:09:53.41,Default,,0,0,0,,[ТД] Жалғастыруда…
Dialogue: 0,0:09:53.41,0:09:56.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:56.41,0:09:59.42,Default,,0,0,0,,Йоши
Dialogue: 0,0:09:56.41,0:09:59.42,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:56.41,0:09:59.42,Default,,0,0,0,,Кенет дірілдеу
Dialogue: 0,0:09:59.42,0:10:02.42,Default,,0,0,0,,Қайта безендіру
Dialogue: 0,0:09:59.42,0:10:02.42,Default,,0,0,0,,Мен партаны жылжытқым келді.
Dialogue: 0,0:10:02.42,0:10:05.42,Default,,0,0,0,,Міне.
Dialogue: 0,0:10:02.42,0:10:05.42,Default,,0,0,0,,Ертең ғана жасаңыз.
Dialogue: 0,0:10:05.42,0:10:07.42,Default,,0,0,0,,Бүгін жексенбі
Dialogue: 0,0:10:07.42,0:10:11.42,Default,,0,0,0,,Сондай-ақ, мен партаның үстіндегі заттарды орнына қойсам.
Dialogue: 0,0:10:07.42,0:10:11.42,Default,,0,0,0,,Өйткені ол аяқталады
Dialogue: 0,0:10:15.43,0:10:17.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:20.44,0:10:23.44,Default,,0,0,0,,Жақсы жұмыс. Хмм...
Dialogue: 0,0:10:25.44,0:10:28.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:28.44,0:10:31.44,Default,,0,0,0,,(Кёки)
Dialogue: 0,0:10:28.44,0:10:31.44,Default,,0,0,0,,《Мен байсалдымын》
Dialogue: 0,0:10:36.45,0:10:39.46,Default,,0,0,0,,《Әй, кездесуге барайық па? 》
Dialogue: 0,0:10:36.45,0:10:39.46,Default,,0,0,0,,《Аа!?》
Dialogue: 0,0:10:39.46,0:10:43.46,Default,,0,0,0,,《Жексенбіде біреумен кездесу бар ма? 》
Dialogue: 0,0:10:39.46,0:10:43.46,Default,,0,0,0,,《Бос...》
Dialogue: 0,0:10:43.46,0:10:46.46,Default,,0,0,0,,《Сосын шешілді.
Dialogue: 0,0:10:43.46,0:10:46.46,Default,,0,0,0,,Камакура
Dialogue: 0,0:10:43.46,0:10:46.46,Default,,0,0,0,,Камакура станциясында сағат 10 ше? 》
Dialogue: 0,0:10:46.46,0:10:48.40,Default,,0,0,0,,《А... иә》
Dialogue: 0,0:10:48.40,0:10:51.40,Default,,0,0,0,,≪(Йоко)
Dialogue: 0,0:10:48.40,0:10:51.40,Default,,0,0,0,,《Манжоме-сан, Каэро! 》
Dialogue: 0,0:10:57.41,0:11:01.41,Default,,0,0,0,,《Ертең не киемін? 》
Dialogue: 0,0:11:07.44,0:11:10.44,Default,,0,0,0,,≪Ех! Сен не айтып тұрсың!?
Dialogue: 0,0:11:07.44,0:11:10.44,Default,,0,0,0,,Йошимичи
Dialogue: 0,0:11:07.44,0:11:10.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:10.44,0:11:12.44,Default,,0,0,0,,Сізге ұнамайтынына сенімдімін!
Dialogue: 0,0:11:12.44,0:11:14.44,Default,,0,0,0,,Егер сіз мұны істесеңіз
Dialogue: 0,0:11:12.44,0:11:14.44,Default,,0,0,0,,Өйткені мен енді сөйлей алмаймын
Dialogue: 0,0:11:14.44,0:11:16.45,Default,,0,0,0,,Тек мұны жасамаңыз.
Dialogue: 0,0:11:16.45,0:11:19.45,Default,,0,0,0,,Әкеме беремін.➡
Dialogue: 0,0:11:19.45,0:11:21.45,Default,,0,0,0,,Мен әкеме айтқанымда
Dialogue: 0,0:11:19.45,0:11:21.45,Default,,0,0,0,,Не болады деп ойлайсыз?
Dialogue: 0,0:11:21.45,0:11:23.45,Default,,0,0,0,,≪(Джидо) Не болды? ➡
Dialogue: 0,0:11:23.45,0:11:27.46,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:11:23.45,0:11:27.46,Default,,0,0,0,,Жоқ... бұл ештеңе емес!
Dialogue: 0,0:11:27.46,0:11:31.46,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:11:27.46,0:11:31.46,Default,,0,0,0,,Тым көп шу шығармаңыз
Dialogue: 0,0:11:31.46,0:11:33.46,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:11:33.46,0:11:37.47,Default,,0,0,0,,Ол жігіт маған қарағанда 10 есе табанды.
Dialogue: 0,0:11:33.46,0:11:37.47,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:11:37.47,0:11:39.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:41.47,0:11:44.47,Default,,0,0,0,,Үстел үстінде
Dialogue: 0,0:11:41.47,0:11:44.47,Default,,0,0,0,,Дәрілер бар.
Dialogue: 0,0:11:44.47,0:11:47.48,Default,,0,0,0,,Акио
Dialogue: 0,0:11:44.47,0:11:47.48,Default,,0,0,0,,Ах. Аа, кешіріңіз.
Dialogue: 0,0:11:47.48,0:11:51.48,Default,,0,0,0,,Мен енді жас емеспін
Dialogue: 0,0:11:47.48,0:11:51.48,Default,,0,0,0,,Оны қалыпты жағдайда ұстаңыз.
Dialogue: 0,0:11:51.48,0:11:54.48,Default,,0,0,0,,Иә
Dialogue: 0,0:11:51.48,0:11:54.48,Default,,0,0,0,,Фуми әлі ұйықтап жатыр ма?
Dialogue: 0,0:11:54.48,0:11:56.49,Default,,0,0,0,,Мен баяғыда шықтым.
Dialogue: 0,0:11:56.49,0:11:59.49,Default,,0,0,0,,Мен көремін. Шопинг па?
Dialogue: 0,0:11:59.49,0:12:01.49,Default,,0,0,0,,Келіңіздер. Мүмкін кездесу шығар.
Dialogue: 0,0:12:01.49,0:12:03.49,Default,,0,0,0,,(Акионың жөтелі)
Dialogue: 0,0:12:03.49,0:12:07.43,Default,,0,0,0,,А... қарсы тарап кім? Амал жоқ
Dialogue: 0,0:12:03.49,0:12:07.43,Default,,0,0,0,,Мен ұялы телефон сұрай бастадым.
Dialogue: 0,0:12:07.43,0:12:10.43,Default,,0,0,0,,Жоқ, сіз шынымен де алаңдаушысыз.
Dialogue: 0,0:12:10.43,0:12:12.43,Default,,0,0,0,,Уайымдау дегеніміз... сіз уайымдап жатырсыз, солай ма?
Dialogue: 0,0:12:12.43,0:12:15.43,Default,,0,0,0,,Ештеңе болмаған жақсы
Dialogue: 0,0:12:12.43,0:12:15.43,Default,,0,0,0,,Мен шынымен де қызықпын.
Dialogue: 0,0:12:23.45,0:12:26.45,Default,,0,0,0,,Ах, Окухира мырза
Dialogue: 0,0:12:23.45,0:12:26.45,Default,,0,0,0,,Кочи Кокчи
Dialogue: 0,0:12:26.45,0:12:29.45,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:12:29.45,0:12:32.45,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым
Dialogue: 0,0:12:29.45,0:12:32.45,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:32.45,0:12:35.46,Default,,0,0,0,,Біз
Dialogue: 0,0:12:32.45,0:12:35.46,Default,,0,0,0,,Мен тым ерте келдім.
Dialogue: 0,0:12:35.46,0:12:38.46,Default,,0,0,0,,Тағы бір адам
Dialogue: 0,0:12:35.46,0:12:38.46,Default,,0,0,0,,Бұдан әрі кешігулер болуы мүмкін
Dialogue: 0,0:12:38.46,0:12:40.46,Default,,0,0,0,,Өйткені ол өз уақытында бос.
Dialogue: 0,0:12:40.46,0:12:42.46,Default,,0,0,0,,Саваной
Dialogue: 0,0:12:40.46,0:12:42.46,Default,,0,0,0,,Бұл Ясуши Саванои
Dialogue: 0,0:12:42.46,0:12:45.47,Default,,0,0,0,,Мен бұл туралы өткен күні айттым.
Dialogue: 0,0:12:42.46,0:12:45.47,Default,,0,0,0,,Маған батаңызды беріңіз
Dialogue: 0,0:12:45.47,0:12:47.47,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:12:47.47,0:12:50.47,Default,,0,0,0,,... Танысқаныма қуаныштымын.
Dialogue: 0,0:12:47.47,0:12:50.47,Default,,0,0,0,,Бұл Акира Окудайра.
Dialogue: 0,0:12:57.48,0:12:59.48,Default,,0,0,0,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:13:07.42,0:13:27.44,Default,,0,0,0,,♬～
Dialogue: 0,0:13:27.44,0:13:32.45,Default,,0,0,0,,♬～
Dialogue: 0,0:13:32.45,0:13:34.45,Default,,0,0,0,,Сіз кездесіп жүрген адам болды ма?
Dialogue: 0,0:13:34.45,0:13:37.45,Default,,0,0,0,,Иә!? Не? кенеттен
Dialogue: 0,0:13:37.45,0:13:39.45,Default,,0,0,0,,Әлде қазір бар ма?
Dialogue: 0,0:13:39.45,0:13:42.45,Default,,0,0,0,,Жоқ. Бұл емес...
Dialogue: 0,0:13:48.46,0:13:52.47,Default,,0,0,0,,Теңізге барайық
Dialogue: 0,0:13:48.46,0:13:52.47,Default,,0,0,0,,Не? Теңіз...
Dialogue: 0,0:13:52.47,0:13:57.47,Default,,0,0,0,,Орынды бөлек қойыңыз
Dialogue: 0,0:13:52.47,0:13:57.47,Default,,0,0,0,,Жылдың осы мезгілінде әлі көп адам жоқ.
Dialogue: 0,0:14:08.42,0:14:13.42,Default,,0,0,0,,Мұнда, гортензия гүлдеген кезде
Dialogue: 0,0:14:08.42,0:14:13.42,Default,,0,0,0,,Өйткені ол адамға толы болады
Dialogue: 0,0:14:13.42,0:14:17.42,Default,,0,0,0,,Уау, мен мұнда бірінші рет келіп тұрмын.
Dialogue: 0,0:14:19.43,0:14:22.43,Default,,0,0,0,,Фуми деген жақсы есім, солай емес пе?
Dialogue: 0,0:14:22.43,0:14:25.43,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:25.43,0:14:27.44,Default,,0,0,0,,Фуми-чан｡➡
Dialogue: 0,0:14:27.44,0:14:29.44,Default,,0,0,0,,Фуми
Dialogue: 0,0:14:32.44,0:14:35.44,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:35.44,0:14:37.44,Default,,0,0,0,,Тағы бір жерге барайық
Dialogue: 0,0:14:44.45,0:14:47.46,Default,,0,0,0,,Біртүрлі жігіт
Dialogue: 0,0:14:44.45,0:14:47.46,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:47.46,0:14:49.46,Default,,0,0,0,,(Канг)
Dialogue: 0,0:14:47.46,0:14:49.46,Default,,0,0,0,,Оның соңынан ерген сияқты.
Dialogue: 0,0:14:49.46,0:14:53.46,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:49.46,0:14:53.46,Default,,0,0,0,,Күдікті күннен қорғайтын көзілдірік киген ер адам.➡
Dialogue: 0,0:14:53.46,0:14:57.47,Default,,0,0,0,,Олар шамамен бір жаста.
Dialogue: 0,0:14:53.46,0:14:57.47,Default,,0,0,0,,Бүгін мен оны үш рет көрдім.
Dialogue: 0,0:14:57.47,0:15:01.47,Default,,0,0,0,,Бұл менің қиялым емес пе?
Dialogue: 0,0:14:57.47,0:15:01.47,Default,,0,0,0,,Жоқ, мен тапсырысты күтіп отырмын➡
Dialogue: 0,0:15:01.47,0:15:04.47,Default,,0,0,0,,Әрқашан басыңызды маған қарай бұрыңыз
Dialogue: 0,0:15:01.47,0:15:04.47,Default,,0,0,0,,Ол мүлде қозғалмайды.
Dialogue: 0,0:15:04.47,0:15:07.41,Default,,0,0,0,,Тіпті дүкендегі қыз
Dialogue: 0,0:15:04.47,0:15:07.41,Default,,0,0,0,,Сіз оны көрмедіңіз бе?
Dialogue: 0,0:15:07.41,0:15:09.41,Default,,0,0,0,,Маған ұнамайды. Сталкер?
Dialogue: 0,0:15:09.41,0:15:12.41,Default,,0,0,0,,Мен Иносукэні құтқарамын
Dialogue: 0,0:15:09.41,0:15:12.41,Default,,0,0,0,,Бұл менің ағам.
Dialogue: 0,0:15:12.41,0:15:14.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:14.42,0:15:17.42,Default,,0,0,0,,Мен оны ұнатпаймын дедім
Dialogue: 0,0:15:14.42,0:15:17.42,Default,,0,0,0,,Менің артымнан жүр...
Dialogue: 0,0:15:17.42,0:15:22.42,Default,,0,0,0,,Мені шақырса да...
Dialogue: 0,0:15:17.42,0:15:22.42,Default,,0,0,0,,Мен саған келме дедім.
Dialogue: 0,0:15:22.42,0:15:25.43,Default,,0,0,0,,Қатерлі ісік ескерілмеді
Dialogue: 0,0:15:25.43,0:15:28.43,Default,,0,0,0,,Ең нашар!
Dialogue: 0,0:15:28.43,0:15:30.43,Default,,0,0,0,,<<Өл!
Dialogue: 0,0:15:30.43,0:15:32.43,Default,,0,0,0,,≪Ақымақ, ақымақ... ақымақ
Dialogue: 0,0:15:30.43,0:15:32.43,Default,,0,0,0,,Бұл қауіпті. Эй! Акира
Dialogue: 0,0:15:32.43,0:15:34.43,Default,,0,0,0,,Қаттыларды қолданбаңыз! Ой!?
Dialogue: 0,0:15:36.44,0:15:39.44,Default,,0,0,0,,Мен бұған сене алмаймын
Dialogue: 0,0:15:36.44,0:15:39.44,Default,,0,0,0,,үшінның көңілі қалды.
Dialogue: 0,0:15:39.44,0:15:43.45,Default,,0,0,0,,Мен мұны біртүрлі деп ойладым.
Dialogue: 0,0:15:39.44,0:15:43.45,Default,,0,0,0,,Әпкеңді қорлаудың қызығы неде?
Dialogue: 0,0:15:43.45,0:15:46.45,Default,,0,0,0,,Райнер, кейін кездескенше.
Dialogue: 0,0:15:43.45,0:15:46.45,Default,,0,0,0,,Ауырды. Міне. Міне.
Dialogue: 0,0:15:46.45,0:15:50.45,Default,,0,0,0,,Асыл әпкемді үйге әкелгенде
Dialogue: 0,0:15:46.45,0:15:50.45,Default,,0,0,0,,Ойланып қарасаңыз...
Dialogue: 0,0:15:50.45,0:15:54.46,Default,,0,0,0,,Қайда барасың?
Dialogue: 0,0:15:50.45,0:15:54.46,Default,,0,0,0,,Жоқ... не?
Dialogue: 0,0:15:54.46,0:15:57.46,Default,,0,0,0,,Өйткені қанша уақыт өтсе де солай
Dialogue: 0,0:15:54.46,0:15:57.46,Default,,0,0,0,,Сенің қызың болмайды!
Dialogue: 0,0:15:57.46,0:16:00.46,Default,,0,0,0,,Менің уайымымнан
Dialogue: 0,0:15:57.46,0:16:00.46,Default,,0,0,0,,Өзіңізді уайымдаңыз!
Dialogue: 0,0:16:00.46,0:16:03.47,Default,,0,0,0,,Менде болсаң...
Dialogue: 0,0:16:00.46,0:16:03.47,Default,,0,0,0,,Қорқынышты сөздер айтпа!
Dialogue: 0,0:16:03.47,0:16:05.48,Default,,0,0,0,,≪(Қабырға қағу дыбысы)
Dialogue: 0,0:16:03.47,0:16:05.48,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:16:05.48,0:16:08.40,Default,,0,0,0,,Енді тоқтай аласыз ба?
Dialogue: 0,0:16:08.40,0:16:12.41,Default,,0,0,0,,Мен көршілерімнен ұялдым.
Dialogue: 0,0:16:12.41,0:16:14.41,Default,,0,0,0,,Иә
Dialogue: 0,0:16:19.41,0:16:23.41,Default,,0,0,0,,Әй, жақсы көңіл-күйге бөленетін кез келді.
Dialogue: 0,0:16:25.42,0:16:27.42,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:16:34.43,0:16:38.43,Default,,0,0,0,,Менің атым Игуми-сан.
Dialogue: 0,0:16:34.43,0:16:38.43,Default,,0,0,0,,Бұл сөзсіз сексуалды
Dialogue: 0,0:16:38.43,0:16:43.44,Default,,0,0,0,,Бұл ұят болды.
Dialogue: 0,0:16:38.43,0:16:43.44,Default,,0,0,0,,Менің жақсы серігім бар.
Dialogue: 0,0:16:43.44,0:16:46.44,Default,,0,0,0,,Тек пішін
Dialogue: 0,0:16:43.44,0:16:46.44,Default,,0,0,0,,Сіз айттыңыз.
Dialogue: 0,0:16:46.44,0:16:50.45,Default,,0,0,0,,Эй, Игуми мырза, мен сізді көздеп отырмын.
Dialogue: 0,0:16:46.44,0:16:50.45,Default,,0,0,0,,Олай емес.➡
Dialogue: 0,0:16:50.45,0:16:54.45,Default,,0,0,0,,Сізді нысанаға алу мүмкіндігі бар.
Dialogue: 0,0:16:50.45,0:16:54.45,Default,,0,0,0,,Мен айттым
Dialogue: 0,0:16:54.45,0:16:56.45,Default,,0,0,0,,Иә! Ал... бұл дұрыс емес...
Dialogue: 0,0:16:56.45,0:16:58.45,Default,,0,0,0,,Жоқ деп айта аласыз ба? ➡
Dialogue: 0,0:16:58.45,0:17:02.45,Default,,0,0,0,,Егер күйеу жігіт жай ғана формальдылық болса
Dialogue: 0,0:16:58.45,0:17:02.45,Default,,0,0,0,,Ажырасқанымыз таңқаларлық емес
Dialogue: 0,0:17:04.46,0:17:09.40,Default,,0,0,0,,Ол қызық бала еді.
Dialogue: 0,0:17:04.46,0:17:09.40,Default,,0,0,0,,Ол сүйкімді қыз болса керек
Dialogue: 0,0:17:09.40,0:17:13.40,Default,,0,0,0,,Айтыңызшы, ағаңыз менің соңымнан келе жатыр.
Dialogue: 0,0:17:09.40,0:17:13.40,Default,,0,0,0,,Мен жылаймын
Dialogue: 0,0:17:13.40,0:17:17.40,Default,,0,0,0,,Соңында сол ағасымен
Dialogue: 0,0:17:13.40,0:17:17.40,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:17:20.41,0:17:22.41,Default,,0,0,0,,Бұл сөзсіз сүйкімді.
Dialogue: 0,0:17:25.41,0:17:29.42,Default,,0,0,0,,≪(Ёши) Фуми, қайтып келдің бе?
Dialogue: 0,0:17:29.42,0:17:33.42,Default,,0,0,0,,≪(Есіктің ашылу/жабылу дыбысы)
Dialogue: 0,0:17:33.42,0:17:35.42,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:37.43,0:17:39.43,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:17:41.43,0:17:44.43,Default,,0,0,0,,《Фуми➡
Dialogue: 0,0:17:44.43,0:17:46.43,Default,,0,0,0,,Басқа жерге барайық》
Dialogue: 0,0:17:48.44,0:17:50.44,Default,,0,0,0,,Хехе…
Dialogue: 0,0:17:53.44,0:17:55.44,Default,,0,0,0,,Кавасаки
Dialogue: 0,0:17:53.44,0:17:55.44,Default,,0,0,0,,Иә
Dialogue: 0,0:17:53.44,0:17:55.44,Default,,0,0,0,,Ах
Dialogue: 0,0:17:55.44,0:17:57.45,Default,,0,0,0,,Мұқият оқып шығыңыз.➡
Dialogue: 0,0:17:57.45,0:18:00.45,Default,,0,0,0,,Мен сахнада тұрмағаным үшін
Dialogue: 0,0:17:57.45,0:18:00.45,Default,,0,0,0,,Оқылымды елемеңіз
Dialogue: 0,0:18:00.45,0:18:02.45,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:18:02.45,0:18:06.39,Default,,0,0,0,,Кавасаки Сенпай. Менеджерге
Dialogue: 0,0:18:02.45,0:18:06.39,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:18:06.39,0:18:09.39,Default,,0,0,0,,Босдық
Dialogue: 0,0:18:06.39,0:18:09.39,Default,,0,0,0,,Менің ойымша, бұл қазір Кагами-сенсейдің орны.➡
Dialogue: 0,0:18:09.39,0:18:12.39,Default,,0,0,0,,Біраз уақыттан кейін
Dialogue: 0,0:18:09.39,0:18:12.39,Default,,0,0,0,,Қайтып келе жатқан жоқ па?
Dialogue: 0,0:18:16.40,0:18:20.40,Default,,0,0,0,,Түсіндім, сценарий дайын ба?
Dialogue: 0,0:18:16.40,0:18:20.40,Default,,0,0,0,,Іс қалай жүріп жатыр?
Dialogue: 0,0:18:20.40,0:18:24.41,Default,,0,0,0,,Театр фестиваліне дайындық
Dialogue: 0,0:18:20.40,0:18:24.41,Default,,0,0,0,,Бұл бұлыңғыр.
Dialogue: 0,0:18:24.41,0:18:29.41,Default,,0,0,0,,Өте жаман. Клубпен қиындықтар.
Dialogue: 0,0:18:24.41,0:18:29.41,Default,,0,0,0,,Мен бәрін көре алмадым
Dialogue: 0,0:18:29.41,0:18:31.41,Default,,0,0,0,,Әу бастан ешқандай үміт күткен жоқпын.
Dialogue: 0,0:18:31.41,0:18:36.42,Default,,0,0,0,,Ұстаз, бар ма, жоқ па.
Dialogue: 0,0:18:31.41,0:18:36.42,Default,,0,0,0,,Ешқандай өзгеріс жоқ, сондықтан бәрі жақсы.
Dialogue: 0,0:18:36.42,0:18:40.42,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:18:36.42,0:18:40.42,Default,,0,0,0,,Жоқ, мен жай қалжыңдап тұрмын.
Dialogue: 0,0:18:40.42,0:18:42.42,Default,,0,0,0,,Иә
Dialogue: 0,0:18:42.42,0:18:45.42,Default,,0,0,0,,Бұл жерде де аздап сарказм бар.
Dialogue: 0,0:18:42.42,0:18:45.42,Default,,0,0,0,,Иә
Dialogue: 0,0:18:47.43,0:18:53.44,Default,,0,0,0,,Сугимотоны қонаққа шақырды
Dialogue: 0,0:18:47.43,0:18:53.44,Default,,0,0,0,,Хитклиффтің рөлі
Dialogue: 0,0:18:53.44,0:18:55.44,Default,,0,0,0,,Иә. Сугимото: Қалайсың?
Dialogue: 0,0:18:55.44,0:18:59.44,Default,,0,0,0,,Иә. Бір нәрсе.
Dialogue: 0,0:18:55.44,0:18:59.44,Default,,0,0,0,,Барған сайын сүйкімді болып барады.
Dialogue: 0,0:18:59.44,0:19:05.46,Default,,0,0,0,,Ахаха...｡ Керемет пе?
Dialogue: 0,0:18:59.44,0:19:05.46,Default,,0,0,0,,Онда да драма үйірмесі бар ма?
Dialogue: 0,0:19:05.46,0:19:07.38,Default,,0,0,0,,Мен қазір дене шынықтыру сабағындамын.➡
Dialogue: 0,0:19:07.38,0:19:09.38,Default,,0,0,0,,Баскетбол клубының директоры
Dialogue: 0,0:19:07.38,0:19:09.38,Default,,0,0,0,,Олар мұны істеп жатқан сияқты.
Dialogue: 0,0:19:09.38,0:19:11.39,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:19:11.39,0:19:16.39,Default,,0,0,0,,Сіз кез келген нәрсені тым көп жасай аласыз.
Dialogue: 0,0:19:11.39,0:19:16.39,Default,,0,0,0,,Титанның алдында сарбаздар бірінен соң бірі құлады.
Dialogue: 0,0:19:16.39,0:19:18.39,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:19:25.40,0:19:28.40,Default,,0,0,0,,Иә. Әрине
Dialogue: 0,0:19:25.40,0:19:28.40,Default,,0,0,0,,Ах
Dialogue: 0,0:19:28.40,0:19:31.41,Default,,0,0,0,,Мен көп қиындық көрдім.
Dialogue: 0,0:19:31.41,0:19:35.41,Default,,0,0,0,,А, енді баскетбол клубы
Dialogue: 0,0:19:31.41,0:19:35.41,Default,,0,0,0,,Бұл шоудың соңы ма? Өкінішті.
Dialogue: 0,0:19:35.41,0:19:39.41,Default,,0,0,0,,Бұл адам осында жиі болады
Dialogue: 0,0:19:35.41,0:19:39.41,Default,,0,0,0,,Ол келе жатыр, сондықтан сақтығыңызды түсірмеңіз.➡
Dialogue: 0,0:19:39.41,0:19:41.42,Default,,0,0,0,,Өйткені олар адамдарды зорлықпен ұрлайды.
Dialogue: 0,0:19:41.42,0:19:44.42,Default,,0,0,0,,(Кёки)
Dialogue: 0,0:19:41.42,0:19:44.42,Default,,0,0,0,,Егер солай болса, мен қазір адамдарды ұрлауға кірісемін.
Dialogue: 0,0:19:47.42,0:19:51.42,Default,,0,0,0,,Манжоме-сан, кітапханаға барайық.
Dialogue: 0,0:19:47.42,0:19:51.42,Default,,0,0,0,,Ах
Dialogue: 0,0:19:56.43,0:20:02.44,Default,,0,0,0,,Болат сөрелер де жаман емес.
Dialogue: 0,0:19:56.43,0:20:02.44,Default,,0,0,0,,Ағаш талғампазырақ.
Dialogue: 0,0:20:02.44,0:20:05.41,Default,,0,0,0,,Фудзи
Dialogue: 0,0:20:02.44,0:20:05.41,Default,,0,0,0,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:20:02.44,0:20:05.41,Default,,0,0,0,,Фудзигая кітапханасы тамаша, солай емес пе?
Dialogue: 0,0:20:05.41,0:20:08.28,Default,,0,0,0,,«Кітапхана» деп аталатынына сенімдімін.
Dialogue: 0,0:20:05.41,0:20:08.28,Default,,0,0,0,,Менің ойымша, бұл сияқты
Dialogue: 0,0:20:08.28,0:20:12.28,Default,,0,0,0,,Аа-чан
Dialogue: 0,0:20:08.28,0:20:12.28,Default,,0,0,0,,Мен Фудзидің неліктен алқапты таңдағанын түсінемін.
Dialogue: 0,0:20:12.28,0:20:15.28,Default,,0,0,0,,Ах, Ах-чан...
Dialogue: 0,0:20:17.29,0:20:21.29,Default,,0,0,0,,Фудзигаяда
Dialogue: 0,0:20:17.29,0:20:21.29,Default,,0,0,0,,«Кітапхана-но-кун» деген нәрсе бар.
Dialogue: 0,0:20:21.29,0:20:25.29,Default,,0,0,0,,«Кітапхана қожасы»?
Dialogue: 0,0:20:25.29,0:20:29.30,Default,,0,0,0,,Мұғалім қалжыңдады
Dialogue: 0,0:20:25.29,0:20:29.30,Default,,0,0,0,,Кітапты жақсы көретін студентті осылай атасаңыз➡
Dialogue: 0,0:20:29.30,0:20:33.30,Default,,0,0,0,,Бұл лақап ат бүкіл мектепке тарады.
Dialogue: 0,0:20:33.30,0:20:36.30,Default,,0,0,0,,Керемет... солай емес пе?
Dialogue: 0,0:20:36.30,0:20:38.31,Default,,0,0,0,,Сен не үшін жылайсың?
Dialogue: 0,0:20:38.31,0:20:43.31,Default,,0,0,0,,Мен психикалық тұрғыдан дайын болмасам да, кенеттен
Dialogue: 0,0:20:38.31,0:20:43.31,Default,,0,0,0,,Тым жақындамаңыз
Dialogue: 0,0:20:45.31,0:20:50.32,Default,,0,0,0,,Содан кейін ойыңызды дайындаңыз.
Dialogue: 0,0:20:45.31,0:20:50.32,Default,,0,0,0,,А...
Dialogue: 0,0:20:50.32,0:20:52.32,Default,,0,0,0,,Терең тыныс алыңыз
Dialogue: 0,0:20:58.33,0:21:01.33,Default,,0,0,0,,《Болат сөрелермен қоршалған
Dialogue: 0,0:20:58.33,0:21:01.33,Default,,0,0,0,,Кітапхана –➡
Dialogue: 0,0:21:01.33,0:21:06.33,Default,,0,0,0,,Мен және менің ағам
Dialogue: 0,0:21:01.33,0:21:06.33,Default,,0,0,0,,Бұл біздің алғашқы сүйіскен жеріміз болды》
Dialogue: 0,0:21:10.34,0:21:15.34,Default,,0,0,0,,♬『ｾﾝﾃｨﾌｫﾘｱ』
Dialogue: 0,0:21:15.34,0:21:35.36,Default,,0,0,0,,♬～
