Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.44,0:00:10.45,Default,,0,0,0,,Кешіріңіз. Тіпті мен.
Dialogue: 0,0:00:05.44,0:00:10.45,Default,,0,0,0,,Маған жіберіңізші
Dialogue: 0,0:00:10.45,0:00:13.45,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:00:10.45,0:00:13.45,Default,,0,0,0,,Иә. Ойын ойнау.
Dialogue: 0,0:00:10.45,0:00:13.45,Default,,0,0,0,,Өйткені бұл маған ұнады
Dialogue: 0,0:00:13.45,0:00:16.45,Default,,0,0,0,,Екеуің келмеді.
Dialogue: 0,0:00:13.45,0:00:16.45,Default,,0,0,0,,Бұл ұят болды➡
Dialogue: 0,0:00:16.45,0:00:18.46,Default,,0,0,0,,Хитклифф жақсы болды.
Dialogue: 0,0:00:18.46,0:00:21.46,Default,,0,0,0,,Сол костюм
Dialogue: 0,0:00:18.46,0:00:21.46,Default,,0,0,0,,Икуми
Dialogue: 0,0:00:18.46,0:00:21.46,Default,,0,0,0,,Игуми мырза жасады.
Dialogue: 0,0:00:21.46,0:00:25.46,Default,,0,0,0,,Киоко
Dialogue: 0,0:00:21.46,0:00:25.46,Default,,0,0,0,,Сәлем. Солай ма? Киоко
Dialogue: 0,0:00:31.47,0:00:33.47,Default,,0,0,0,,《Кеш қалды》
Dialogue: 0,0:00:33.47,0:00:35.47,Default,,0,0,0,,(мүше)
Dialogue: 0,0:00:33.47,0:00:35.47,Default,,0,0,0,,《Бұл дәл қазір керемет болды.➡
Dialogue: 0,0:00:35.47,0:00:38.47,Default,,0,0,0,,Лорд Хитклифф
Dialogue: 0,0:00:35.47,0:00:38.47,Default,,0,0,0,,Мен жыладым》
Dialogue: 0,0:00:40.48,0:00:42.48,Default,,0,0,0,,《Бірдеңе болды ма? 》
Dialogue: 0,0:00:42.48,0:00:46.48,Default,,0,0,0,,《Мм.
Dialogue: 0,0:00:42.48,0:00:46.48,Default,,0,0,0,,Босдық
Dialogue: 0,0:00:42.48,0:00:46.48,Default,,0,0,0,,Кагами-сенсей сені шақырғанда, кенеттен.➡
Dialogue: 0,0:00:46.48,0:00:49.49,Default,,0,0,0,,Сезімге батқан жоқсың ба? 》
Dialogue: 0,0:00:49.49,0:00:54.49,Default,,0,0,0,,Каори
Dialogue: 0,0:00:49.49,0:00:54.49,Default,,0,0,0,,《Қарау жиналысы басталады》
Dialogue: 0,0:00:49.49,0:00:54.49,Default,,0,0,0,,《Иә》
Dialogue: 0,0:00:54.49,0:00:56.51,Default,,0,0,0,,Киоко. Киоко?
Dialogue: 0,0:00:56.51,0:00:59.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:56.51,0:00:59.51,Default,,0,0,0,,Не болды?
Dialogue: 0,0:01:01.43,0:01:03.43,Default,,0,0,0,,Пыс, пыс… Э?
Dialogue: 0,0:01:09.44,0:01:14.45,Default,,0,0,0,,Көк
Dialogue: 0,0:01:09.44,0:01:14.45,Default,,0,0,0,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:01:09.44,0:01:14.45,Default,,0,0,0,,♬『Көк гүл』
Dialogue: 0,0:01:14.45,0:01:24.46,Default,,0,0,0,,♬～
Dialogue: 0,0:01:24.46,0:01:33.46,Default,,0,0,0,,♬～
Dialogue: 0,0:01:33.46,0:01:53.48,Default,,0,0,0,,♬～
Dialogue: 0,0:01:53.48,0:02:13.44,Default,,0,0,0,,♬～
Dialogue: 0,0:02:13.44,0:02:26.44,Default,,0,0,0,,♬～
Dialogue: 0,0:02:34.46,0:02:37.46,Default,,0,0,0,,Ясуко
Dialogue: 0,0:02:34.46,0:02:37.46,Default,,0,0,0,,《Өткен шақ.➡
Dialogue: 0,0:02:37.46,0:02:42.47,Default,,0,0,0,,Маған қатты ұнады
Dialogue: 0,0:02:37.46,0:02:42.47,Default,,0,0,0,,Тек мен сені жақсы көремін➡
Dialogue: 0,0:02:42.47,0:02:44.47,Default,,0,0,0,,үшін осы болды.》
Dialogue: 0,0:02:47.47,0:02:51.48,Default,,0,0,0,,《Мен
Dialogue: 0,0:02:47.47,0:02:51.48,Default,,0,0,0,,Фумиге опасыздық жасап жатырсың ба? 》
Dialogue: 0,0:02:51.48,0:02:54.48,Default,,0,0,0,,《Осындай нәрсе...》
Dialogue: 0,0:02:54.48,0:02:59.48,Default,,0,0,0,,Менің қолымды ал және
Dialogue: 0,0:02:54.48,0:02:59.48,Default,,0,0,0,,қараңғылықпен қоштасты.➡
Dialogue: 0,0:02:59.48,0:03:02.49,Default,,0,0,0,,Мен сені алып кетейін
Dialogue: 0,0:02:59.48,0:03:02.49,Default,,0,0,0,,менің құпия жеріме➡
Dialogue: 0,0:03:02.49,0:03:06.49,Default,,0,0,0,,сіз қандай болсаңыз, сол жерде.➡
Dialogue: 0,0:03:06.49,0:03:09.49,Default,,0,0,0,,Көзіңді жұмы,
Dialogue: 0,0:03:06.49,0:03:09.49,Default,,0,0,0,,қорықпа.
Dialogue: 0,0:03:09.49,0:03:12.50,Default,,0,0,0,,[℡]
Dialogue: 0,0:03:12.50,0:03:14.50,Default,,0,0,0,,Иә...
Dialogue: 0,0:03:14.50,0:03:16.50,Default,,0,0,0,,Ах Фуми-чан
Dialogue: 0,0:03:16.50,0:03:19.50,Default,,0,0,0,,Иә, кеше театр фестивалі болды...
Dialogue: 0,0:03:19.50,0:03:22.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:22.51,0:03:24.51,Default,,0,0,0,,Керемет
Dialogue: 0,0:03:26.51,0:03:30.51,Default,,0,0,0,,Жарайды, бірақ... Фуми-чан мен Комо
Dialogue: 0,0:03:26.51,0:03:30.51,Default,,0,0,0,,Бұл демалыс күні болды ма?
Dialogue: 0,0:03:32.45,0:03:35.45,Default,,0,0,0,,Мен әлсіреп қалдым.
Dialogue: 0,0:03:32.45,0:03:35.45,Default,,0,0,0,,Анрема
Dialogue: 0,0:03:35.45,0:03:39.46,Default,,0,0,0,,Сонымен, А-чан, сенің демалыс күнің.
Dialogue: 0,0:03:35.45,0:03:39.46,Default,,0,0,0,,Есте сақта...
Dialogue: 0,0:03:39.46,0:03:41.46,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:43.46,0:03:47.46,Default,,0,0,0,,Жақсы! Ал, бүгін күн.
Dialogue: 0,0:03:43.46,0:03:47.46,Default,,0,0,0,,Фуми-чанмен кездесу
Dialogue: 0,0:03:47.46,0:03:50.47,Default,,0,0,0,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:03:50.47,0:03:52.47,Default,,0,0,0,,Мен осындай нәрсені сатып алдым.
Dialogue: 0,0:03:52.47,0:04:11.49,Default,,0,0,0,,♬～
Dialogue: 0,0:04:11.49,0:04:14.49,Default,,0,0,0,,♬～
Dialogue: 0,0:04:14.49,0:04:33.49,Default,,0,0,0,,♬～
Dialogue: 0,0:04:35.45,0:04:38.45,Default,,0,0,0,,Жұмыс күні болса да ғажап
Dialogue: 0,0:04:35.45,0:04:38.45,Default,,0,0,0,,Иә
Dialogue: 0,0:04:38.45,0:04:40.45,Default,,0,0,0,,(қоңырау сигналы)
Dialogue: 0,0:04:38.45,0:04:40.45,Default,,0,0,0,,Ах
Dialogue: 0,0:04:40.45,0:04:42.45,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:04:46.46,0:04:49.46,Default,,0,0,0,,(әйел студент)
Dialogue: 0,0:04:46.46,0:04:49.46,Default,,0,0,0,,Уау. Апыр-ай. Маған қоңырау келді.
Dialogue: 0,0:04:49.46,0:04:52.46,Default,,0,0,0,,Ұйқасы, токтайтын атмосфера—бәрі!—
Dialogue: 0,0:04:49.46,0:04:52.46,Default,,0,0,0,,Ухуху. Құпия.
Dialogue: 0,0:04:52.46,0:04:56.46,Default,,0,0,0,,Не! Айтыңызшы
Dialogue: 0,0:04:52.46,0:04:56.46,Default,,0,0,0,,Бұл ерекше ештеңе емес.
Dialogue: 0,0:04:59.47,0:05:01.47,Default,,0,0,0,,Манжоме
Dialogue: 0,0:04:59.47,0:05:01.47,Default,,0,0,0,,Манжоме-сан? ➡
Dialogue: 0,0:05:01.47,0:05:07.48,Default,,0,0,0,,Ол бүгін әлі келген жоқ.
Dialogue: 0,0:05:01.47,0:05:07.48,Default,,0,0,0,,Не? Сіз бірдеңе уәде бердіңіз бе?
Dialogue: 0,0:05:07.48,0:05:11.48,Default,,0,0,0,,《Ертең біраз уақыттан кейін бірінші рет
Dialogue: 0,0:05:07.48,0:05:11.48,Default,,0,0,0,,Мен баскетбол клубының менеджері боламын.➡
Dialogue: 0,0:05:11.48,0:05:13.48,Default,,0,0,0,,Сіз мені көруге келе аласыз ба? 》
Dialogue: 0,0:05:13.48,0:05:15.48,Default,,0,0,0,,Сізді тастап кетті ме?
Dialogue: 0,0:05:19.49,0:05:26.50,Default,,0,0,0,,Бүгінгі күн
Dialogue: 0,0:05:19.49,0:05:26.50,Default,,0,0,0,,Мен Ачанчиде қалғым келетін сияқты...
Dialogue: 0,0:05:26.50,0:05:29.52,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:26.50,0:05:29.52,Default,,0,0,0,,Пижама, менікі жақсы ма?
Dialogue: 0,0:05:29.52,0:05:32.44,Default,,0,0,0,,А, ұзындығы сәйкес емес...
Dialogue: 0,0:05:32.44,0:05:36.44,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:32.44,0:05:36.44,Default,,0,0,0,,Анамнан маған қарыз беруін сұрау керек пе...
Dialogue: 0,0:05:36.44,0:05:38.44,Default,,0,0,0,,Ах-чан...
Dialogue: 0,0:05:36.44,0:05:38.44,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:38.44,0:05:40.44,Default,,0,0,0,,Тым мейірімді
Dialogue: 0,0:05:40.44,0:05:45.45,Default,,0,0,0,,Егер А-чан мені итеріп жібермесе
Dialogue: 0,0:05:40.44,0:05:45.45,Default,,0,0,0,,Барған сайын бүліну
Dialogue: 0,0:05:45.45,0:05:48.45,Default,,0,0,0,,Соны айтсаң да...
Dialogue: 0,0:05:52.46,0:05:55.46,Default,,0,0,0,,Сугимото
Dialogue: 0,0:05:52.46,0:05:55.46,Default,,0,0,0,,《Сугимото-сенпайға бірдеңе болды ма? ➡
Dialogue: 0,0:05:55.46,0:05:58.46,Default,,0,0,0,,Осыны сұрасам бола ма?
Dialogue: 0,0:05:55.46,0:05:58.46,Default,,0,0,0,,Дұрыс емес пе➡
Dialogue: 0,0:05:58.46,0:06:03.46,Default,,0,0,0,,Қайсысы екен деп ойлаймын. Бірақ
Dialogue: 0,0:05:58.46,0:06:03.46,Default,,0,0,0,,Фуми-чан, сен жақында жылайсың》
Dialogue: 0,0:06:06.47,0:06:10.47,Default,,0,0,0,,А-чан. Мен балалардың жылағанын жек көремін.
Dialogue: 0,0:06:06.47,0:06:10.47,Default,,0,0,0,,Иә!?
Dialogue: 0,0:06:14.48,0:06:17.48,Default,,0,0,0,,Құрт болмаса
Dialogue: 0,0:06:14.48,0:06:17.48,Default,,0,0,0,,Түнде болайық
Dialogue: 0,0:06:21.49,0:06:23.49,Default,,0,0,0,,Мен ғана сұмдық жасадым
Dialogue: 0,0:06:23.49,0:06:27.49,Default,,0,0,0,,Не? Сіздің ағаңызға?
Dialogue: 0,0:06:23.49,0:06:27.49,Default,,0,0,0,,Иә
Dialogue: 0,0:06:27.49,0:06:30.43,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:06:27.49,0:06:30.43,Default,,0,0,0,,Бұл адам тым танымал.
Dialogue: 0,0:06:30.43,0:06:34.43,Default,,0,0,0,,Мен өзімді үлкендерге жаман сезінемін, бірақ
Dialogue: 0,0:06:30.43,0:06:34.43,Default,,0,0,0,,Мен Фуми-чанның жанкүйерімін.
Dialogue: 0,0:06:34.43,0:06:36.43,Default,,0,0,0,,Рахмет, А-чан.
Dialogue: 0,0:06:36.43,0:06:40.44,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:36.43,0:06:40.44,Default,,0,0,0,,Дұрыстап құрастырайық.
Dialogue: 0,0:06:40.44,0:06:42.44,Default,,0,0,0,,Иә
Dialogue: 0,0:06:42.44,0:06:46.44,Default,,0,0,0,,Дұрысырақ
Dialogue: 0,0:06:42.44,0:06:46.44,Default,,0,0,0,,Біз соқтығыспайынша, пайдасы жоқ.
Dialogue: 0,0:06:46.44,0:06:50.44,Default,,0,0,0,,Егер ол бұзылса
Dialogue: 0,0:06:46.44,0:06:50.44,Default,,0,0,0,,Мен мұның бәрі бар деп ойлаймын.
Dialogue: 0,0:06:52.45,0:06:54.45,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:06:54.45,0:06:56.45,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:07:01.46,0:07:03.46,Default,,0,0,0,,(жүгіру дыбысы)
Dialogue: 0,0:07:03.46,0:07:05.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:05.46,0:07:07.46,Default,,0,0,0,,≪(Әпке) Міне!
Dialogue: 0,0:07:05.46,0:07:07.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:07.46,0:07:11.47,Default,,0,0,0,,Біреу ашулы
Dialogue: 0,0:07:07.46,0:07:11.47,Default,,0,0,0,,Окудаира
Dialogue: 0,0:07:07.46,0:07:11.47,Default,,0,0,0,,Мүмкін бұл Окудайра мырза шығар.
Dialogue: 0,0:07:11.47,0:07:14.47,Default,,0,0,0,,Сыныпты және атын айт
Dialogue: 0,0:07:14.47,0:07:18.48,Default,,0,0,0,,Фуджикуми
Dialogue: 0,0:07:14.47,0:07:18.48,Default,,0,0,0,,Бұл 1 курс Фудзи сыныбынан Акира Окухира.
Dialogue: 0,0:07:18.48,0:07:21.48,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:07:18.48,0:07:21.48,Default,,0,0,0,,≪(Әпке) Окудайра мырза.➡
Dialogue: 0,0:07:21.48,0:07:25.48,Default,,0,0,0,,Осы жерден оралыңыз
Dialogue: 0,0:07:21.48,0:07:25.48,Default,,0,0,0,,Дұрыстап қайталап көріңіз.➡
Dialogue: 0,0:07:25.48,0:07:28.49,Default,,0,0,0,,Қаншалықты тез болса да
Dialogue: 0,0:07:25.48,0:07:28.49,Default,,0,0,0,,Жүгіруге болмайды
Dialogue: 0,0:07:28.49,0:07:30.49,Default,,0,0,0,,≪ бұл... иә
Dialogue: 0,0:07:32.42,0:07:36.43,Default,,0,0,0,,Бұл қорқынышты болды.
Dialogue: 0,0:07:32.42,0:07:36.43,Default,,0,0,0,,Жоқ, мен дұрыс түсіндім.
Dialogue: 0,0:07:36.43,0:07:38.43,Default,,0,0,0,,Сіз үрейленбеуіңіз керек еді
Dialogue: 0,0:07:38.43,0:07:41.43,Default,,0,0,0,,Жоқ...хехехе...
Dialogue: 0,0:07:50.44,0:07:52.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:54.44,0:07:56.45,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:54.44,0:07:56.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:56.45,0:08:01.45,Default,,0,0,0,,О
Dialogue: 0,0:07:56.45,0:08:01.45,Default,,0,0,0,,Бұл кісі Сугимото-сенпайдың әпкесі.
Dialogue: 0,0:08:01.45,0:08:03.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:03.45,0:08:08.46,Default,,0,0,0,,Эй
Dialogue: 0,0:08:03.45,0:08:08.46,Default,,0,0,0,,А, ол мұнда мұғалім болды.
Dialogue: 0,0:08:08.46,0:08:13.46,Default,,0,0,0,,Біз көтерілмес бұрын
Dialogue: 0,0:08:08.46,0:08:13.46,Default,,0,0,0,,Ол орта мектеп мұғалімі.
Dialogue: 0,0:08:13.46,0:08:16.47,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:13.46,0:08:16.47,Default,,0,0,0,,Не? Неліктен, неге?
Dialogue: 0,0:08:16.47,0:08:18.47,Default,,0,0,0,,Мен орта мектепте оқып жүрген кезім➡
Dialogue: 0,0:08:18.47,0:08:22.47,Default,,0,0,0,,Бір рет ағамның үйінде
Dialogue: 0,0:08:18.47,0:08:22.47,Default,,0,0,0,,Сізді шақырған кез болды ма?
Dialogue: 0,0:08:22.47,0:08:25.48,Default,,0,0,0,,Жіңішке сызықтары бар әдемі адам еді.
Dialogue: 0,0:08:25.48,0:08:30.41,Default,,0,0,0,,«4 апалы-сіңлілі Сугимото»
Dialogue: 0,0:08:25.48,0:08:30.41,Default,,0,0,0,,Ол аздап атақты болды.
Dialogue: 0,0:08:30.41,0:08:32.42,Default,,0,0,0,,Уау! Сугимото 4 апа
Dialogue: 0,0:08:32.42,0:08:52.44,Default,,0,0,0,,♬～
Dialogue: 0,0:08:52.44,0:08:57.44,Default,,0,0,0,,♬～
Dialogue: 0,0:08:57.44,0:09:00.44,Default,,0,0,0,,Орамал
Dialogue: 0,0:08:57.44,0:09:00.44,Default,,0,0,0,,Иә
Dialogue: 0,0:09:05.45,0:09:08.45,Default,,0,0,0,,Келесі сенбіде боссыз ба?
Dialogue: 0,0:09:08.45,0:09:11.45,Default,,0,0,0,,Иә
Dialogue: 0,0:09:08.45,0:09:11.45,Default,,0,0,0,,Ал, кездесуге барайық.
Dialogue: 0,0:09:11.45,0:09:14.46,Default,,0,0,0,,Себебі мен оны отбасыммен таныстырғым келеді
Dialogue: 0,0:09:11.45,0:09:14.46,Default,,0,0,0,,Менің үйіме кел
Dialogue: 0,0:09:14.46,0:09:16.46,Default,,0,0,0,,Иә
Dialogue: 0,0:09:21.46,0:09:23.47,Default,,0,0,0,,Иә!?
Dialogue: 0,0:09:23.47,0:09:25.47,Default,,0,0,0,,[℡] Үлкендеріңіздің арасында?
Dialogue: 0,0:09:25.47,0:09:28.47,Default,,0,0,0,,Иә. Келесі сенбі
Dialogue: 0,0:09:28.47,0:09:30.41,Default,,0,0,0,,[℡]Тамаша.➡
Dialogue: 0,0:09:30.41,0:09:34.41,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:09:30.41,0:09:34.41,Default,,0,0,0,,Сіз төрт апалы-сіңлілі Сугимотомен кездестіңіз.
Dialogue: 0,0:09:34.41,0:09:36.41,Default,,0,0,0,,Төрт апалы-сіңлілі Сугимото?
Dialogue: 0,0:09:36.41,0:09:38.42,Default,,0,0,0,,Мен сенен үлкен үш әпке бар деп естідім.
Dialogue: 0,0:09:38.42,0:09:42.42,Default,,0,0,0,,Және бір адам
Dialogue: 0,0:09:38.42,0:09:42.42,Default,,0,0,0,,Менің мектебімнің бұрынғы мұғалімі
Dialogue: 0,0:09:42.42,0:09:48.43,Default,,0,0,0,,Үш адам...Не істеу керек?
Dialogue: 0,0:09:42.42,0:09:48.43,Default,,0,0,0,,Бір нәрсе мені қобалжытады.
Dialogue: 0,0:09:48.43,0:09:50.43,Default,,0,0,0,,[℡] Жарайды! ➡
Dialogue: 0,0:09:50.43,0:09:55.43,Default,,0,0,0,,Менің де ұстазым болған адам
Dialogue: 0,0:09:50.43,0:09:55.43,Default,,0,0,0,,Ол өте мейірімді адам.
Dialogue: 0,0:09:55.43,0:09:59.44,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:55.43,0:09:59.44,Default,,0,0,0,,[℡] Дәлірек айтқанда, Фуми-чан
Dialogue: 0,0:09:59.44,0:10:02.44,Default,,0,0,0,,Мен ағаммен татуластым.
Dialogue: 0,0:10:02.44,0:10:04.44,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:10:04.44,0:10:06.44,Default,,0,0,0,,Иә
Dialogue: 0,0:10:06.44,0:10:08.44,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:20.46,0:10:24.46,Default,,0,0,0,,《Аға апа
Dialogue: 0,0:10:20.46,0:10:24.46,Default,,0,0,0,,Олар қандай адамдар?
Dialogue: 0,0:10:26.46,0:10:28.46,Default,,0,0,0,,Уау
Dialogue: 0,0:10:32.40,0:10:36.40,Default,,0,0,0,,《Күндесуге барайық.
Dialogue: 0,0:10:32.40,0:10:36.40,Default,,0,0,0,,Ол маған айтты》
Dialogue: 0,0:10:49.44,0:10:51.44,Default,,0,0,0,,《Баяу…》
Dialogue: 0,0:10:57.45,0:11:00.45,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:11:00.45,0:11:03.45,Default,,0,0,0,,Фуми
Dialogue: 0,0:11:00.45,0:11:03.45,Default,,0,0,0,,Не!
Dialogue: 0,0:11:03.45,0:11:05.46,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:05.46,0:11:08.46,Default,,0,0,0,,Аға
Dialogue: 0,0:11:05.46,0:11:08.46,Default,,0,0,0,,Кешіріңіз, жол бос емес.
Dialogue: 0,0:11:11.46,0:11:13.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:16.47,0:11:21.47,Default,,0,0,0,,Сізді елемеді деп ойладыңыз ба?
Dialogue: 0,0:11:16.47,0:11:21.47,Default,,0,0,0,,Иә? Жоқ, солай...
Dialogue: 0,0:11:21.47,0:11:25.48,Default,,0,0,0,,Огино
Dialogue: 0,0:11:21.47,0:11:25.48,Default,,0,0,0,,Өзіңізге еркіндік беріңіз.
Dialogue: 0,0:11:21.47,0:11:25.48,Default,,0,0,0,,Мен шықтым деп ойладым.
Dialogue: 0,0:11:25.48,0:11:29.48,Default,,0,0,0,,Сақтамаңыз
Dialogue: 0,0:11:25.48,0:11:29.48,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:11:41.51,0:11:43.51,Default,,0,0,0,,Рахмет, Огино мырза.
Dialogue: 0,0:11:49.43,0:11:51.43,Default,,0,0,0,,《Аға...》
Dialogue: 0,0:11:59.44,0:12:01.44,Default,,0,0,0,,《Аға...》
Dialogue: 0,0:12:05.45,0:12:08.45,Default,,0,0,0,,《Аға...》
Dialogue: 0,0:12:08.45,0:12:11.45,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:12:11.45,0:12:13.45,Default,,0,0,0,,(Көмекші)
Dialogue: 0,0:12:11.45,0:12:13.45,Default,,0,0,0,,Қолымды ұсташы, өтінемін. Әрқашан істейтіндей.
Dialogue: 0,0:12:16.46,0:12:19.46,Default,,0,0,0,,《Ол жас ханым еді, солай ма?》
Dialogue: 0,0:12:19.46,0:12:23.46,Default,,0,0,0,,Не? көтерілу
Dialogue: 0,0:12:19.46,0:12:23.46,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:12:26.47,0:12:29.47,Default,,0,0,0,,Шинако
Dialogue: 0,0:12:26.47,0:12:29.47,Default,,0,0,0,,(Сугако)
Dialogue: 0,0:12:26.47,0:12:29.47,Default,,0,0,0,,О, Якчан. Қайтадан қош келдіңіз.
Dialogue: 0,0:12:29.47,0:12:31.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:31.47,0:12:35.48,Default,,0,0,0,,Бұл сенің досың ба?
Dialogue: 0,0:12:31.47,0:12:35.48,Default,,0,0,0,,Иә. Кіші
Dialogue: 0,0:12:35.48,0:12:38.48,Default,,0,0,0,,Ал... Менің атым Фуми Манджоме.
Dialogue: 0,0:12:38.48,0:12:42.42,Default,,0,0,0,,Бұл менің үлкен әпкем Сугако. Ол үлкен қызы.
Dialogue: 0,0:12:42.42,0:12:55.43,Default,,0,0,0,,♬～
Dialogue: 0,0:12:55.43,0:12:59.44,Default,,0,0,0,,Каштан
Dialogue: 0,0:12:55.43,0:12:59.44,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:12:55.43,0:12:59.44,Default,,0,0,0,,Мен үлкен балаларды жақсы көремін.
Dialogue: 0,0:12:59.44,0:13:01.44,Default,,0,0,0,,Біз де үлкенміз.
Dialogue: 0,0:13:01.44,0:13:05.44,Default,,0,0,0,,Бұл үшінші қыздың аксиомасы. Құрметпен.
Dialogue: 0,0:13:05.44,0:13:07.44,Default,,0,0,0,,Мен де солай.
Dialogue: 0,0:13:19.46,0:13:23.46,Default,,0,0,0,,Кьюми
Dialogue: 0,0:13:19.46,0:13:23.46,Default,,0,0,0,,Сіз шынымен таңданасыз.
Dialogue: 0,0:13:23.46,0:13:27.46,Default,,0,0,0,,Қайтадан басталды
Dialogue: 0,0:13:23.46,0:13:27.46,Default,,0,0,0,,О, мен оны ұнатпаймын.
Dialogue: 0,0:13:27.46,0:13:29.47,Default,,0,0,0,,Оны елемеуіңізге болады.
Dialogue: 0,0:13:29.47,0:13:34.47,Default,,0,0,0,,Менің анамның әңгімесі оның қызы болғаны туралы.
Dialogue: 0,0:13:29.47,0:13:34.47,Default,,0,0,0,,Мені де жақсы көрді ме деп ойлаймын➡
Dialogue: 0,0:13:34.47,0:13:37.47,Default,,0,0,0,,Бұл жай ғана мақтануға айналады.
Dialogue: 0,0:13:37.47,0:13:41.49,Default,,0,0,0,,Сәлем. Сіз жігіттер.
Dialogue: 0,0:13:37.47,0:13:41.49,Default,,0,0,0,,Неліктен иә, тұтынушы алдында➡
Dialogue: 0,0:13:41.49,0:13:44.41,Default,,0,0,0,,жаңылыстыру...
Dialogue: 0,0:13:41.49,0:13:44.41,Default,,0,0,0,,Өйткені бұл шындық.
Dialogue: 0,0:13:44.41,0:13:47.42,Default,,0,0,0,,(Аксиома: Сугатаның күлкісі)
Dialogue: 0,0:13:47.42,0:13:49.42,Default,,0,0,0,,Балалар сендер қорқыныштысыңдар.➡
Dialogue: 0,0:13:49.42,0:13:51.42,Default,,0,0,0,,I
Dialogue: 0,0:13:49.42,0:13:51.42,Default,,0,0,0,,Соңғы рет қашан мақтандың?
Dialogue: 0,0:13:51.42,0:13:54.42,Default,,0,0,0,,Сіз мұны үнемі жасайсыз.
Dialogue: 0,0:13:51.42,0:13:54.42,Default,,0,0,0,,Дұрыс.➡
Dialogue: 0,0:13:54.42,0:13:57.43,Default,,0,0,0,,Қараңыз. Мен алдында
Dialogue: 0,0:13:54.42,0:13:57.43,Default,,0,0,0,,Досымды алып келгенімде де
Dialogue: 0,0:13:57.43,0:14:01.43,Default,,0,0,0,,(Сугако)
Dialogue: 0,0:13:57.43,0:14:01.43,Default,,0,0,0,,О, ол кезде сұмдық еді.
Dialogue: 0,0:14:01.43,0:14:04.43,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:01.43,0:14:04.43,Default,,0,0,0,,Мұны істейік.
Dialogue: 0,0:14:04.43,0:14:06.43,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:14:13.44,0:14:15.44,Default,,0,0,0,,Казуза
Dialogue: 0,0:14:13.44,0:14:15.44,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:14:19.45,0:14:21.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:23.45,0:14:27.46,Default,,0,0,0,,Танысқаныма қуаныштымын. Бұл Васа, менің екінші қызым.
Dialogue: 0,0:14:27.46,0:14:30.46,Default,,0,0,0,,Бұл Фуми Манжоме.
Dialogue: 0,0:14:30.46,0:14:35.47,Default,,0,0,0,,Ум...
Dialogue: 0,0:14:30.46,0:14:35.47,Default,,0,0,0,,Фудзи
Dialogue: 0,0:14:30.46,0:14:35.47,Default,,0,0,0,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:14:30.46,0:14:35.47,Default,,0,0,0,,Фудзигатани мұғалім болған...
Dialogue: 0,0:14:35.47,0:14:40.47,Default,,0,0,0,,О, аз ғана уақытқа.
Dialogue: 0,0:14:40.47,0:14:45.41,Default,,0,0,0,,《А-чан айтқандай
Dialogue: 0,0:14:40.47,0:14:45.41,Default,,0,0,0,,Мейірімді адам》
Dialogue: 0,0:14:45.41,0:14:49.41,Default,,0,0,0,,Якчан достар тапты
Dialogue: 0,0:14:45.41,0:14:49.41,Default,,0,0,0,,Бұл әдеттен тыс
Dialogue: 0,0:14:49.41,0:14:53.42,Default,,0,0,0,,Біз шынымен жақсы достармыз, солай емес пе?
Dialogue: 0,0:14:53.42,0:14:56.42,Default,,0,0,0,,Бұл туралы...
Dialogue: 0,0:14:56.42,0:15:00.42,Default,,0,0,0,,үшінна айтқым келетін бір нәрсе...
Dialogue: 0,0:14:56.42,0:15:00.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:00.42,0:15:05.43,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:00.42,0:15:05.43,Default,,0,0,0,,Мен қазір бұл қызбен кездесіп жүрмін.
Dialogue: 0,0:15:05.43,0:15:07.43,Default,,0,0,0,,Не!
Dialogue: 0,0:15:12.44,0:15:16.44,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:15:12.44,0:15:16.44,Default,,0,0,0,,Сіз романтикалық қарым-қатынастасыз ба?
Dialogue: 0,0:15:16.44,0:15:19.44,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:15:19.44,0:15:23.45,Default,,0,0,0,,Якчан лесбиянка ма?
Dialogue: 0,0:15:23.45,0:15:26.45,Default,,0,0,0,,Сізге бұл қыз шынымен ұнай ма?
Dialogue: 0,0:15:26.45,0:15:29.45,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:15:26.45,0:15:29.45,Default,,0,0,0,,Саған қазір ол қыз ұнайды, солай емес пе?
Dialogue: 0,0:15:29.45,0:15:32.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:29.45,0:15:32.46,Default,,0,0,0,,Аксиомалар
Dialogue: 0,0:15:32.46,0:15:37.46,Default,,0,0,0,,Қазір сізге кім ұнайды?
Dialogue: 0,0:15:32.46,0:15:37.46,Default,,0,0,0,,Бұл жас ханым ба?
Dialogue: 0,0:15:37.46,0:15:42.40,Default,,0,0,0,,Соншалықты табанды
Dialogue: 0,0:15:37.46,0:15:42.40,Default,,0,0,0,,Менің айтайын дегенім осы.
Dialogue: 0,0:15:42.40,0:15:46.40,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:15:42.40,0:15:46.40,Default,,0,0,0,,Кьюки қос жынысты.
Dialogue: 0,0:15:48.40,0:15:51.41,Default,,0,0,0,,(Кёки)
Dialogue: 0,0:15:48.40,0:15:51.41,Default,,0,0,0,,Фуми, менің бөлмеме барайық.
Dialogue: 0,0:15:51.41,0:15:54.41,Default,,0,0,0,,Мені бөлмеге апарыңыз
Dialogue: 0,0:15:51.41,0:15:54.41,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:15:56.41,0:16:00.42,Default,,0,0,0,,Ах
Dialogue: 0,0:15:56.41,0:16:00.42,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:16:00.42,0:16:02.42,Default,,0,0,0,,(шодзи ашу/жабу дыбысы)
Dialogue: 0,0:16:02.42,0:16:06.42,Default,,0,0,0,,Дәл солай, сіз бірден шағымдана бастайсыз.
Dialogue: 0,0:16:02.42,0:16:06.42,Default,,0,0,0,,Шламды кетіру.➡
Dialogue: 0,0:16:06.42,0:16:10.43,Default,,0,0,0,,Мені біреу жұбатады деп ойладым.➡
Dialogue: 0,0:16:10.43,0:16:13.43,Default,,0,0,0,,Дәл менің әжем
Dialogue: 0,0:16:20.44,0:16:22.44,Default,,0,0,0,,Фу
Dialogue: 0,0:16:22.44,0:16:27.44,Default,,0,0,0,,Кешіріңіз. Темекі шегуге болады ма?
Dialogue: 0,0:16:22.44,0:16:27.44,Default,,0,0,0,,Иә
Dialogue: 0,0:16:27.44,0:16:31.45,Default,,0,0,0,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:16:27.44,0:16:31.45,Default,,0,0,0,,Бұл кісі дөрекі емес пе?
Dialogue: 0,0:16:31.45,0:16:36.45,Default,,0,0,0,,Аксиома әрқашан осылай болады.
Dialogue: 0,0:16:31.45,0:16:36.45,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:16:36.45,0:16:41.47,Default,,0,0,0,,(Алыстағы найзағай)
Dialogue: 0,0:16:41.47,0:16:54.40,Default,,0,0,0,,♬～
Dialogue: 0,0:16:54.40,0:17:00.40,Default,,0,0,0,,(Алыстағы найзағай)
Dialogue: 0,0:17:02.41,0:17:05.42,Default,,0,0,0,,≪
Dialogue: 0,0:17:05.42,0:17:07.42,Default,,0,0,0,,Фуми?
Dialogue: 0,0:17:07.42,0:17:09.42,Default,,0,0,0,,Иә
Dialogue: 0,0:17:07.42,0:17:09.42,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:17:17.43,0:17:20.43,Default,,0,0,0,,Бұл жақсы бөлме.
Dialogue: 0,0:17:22.43,0:17:25.44,Default,,0,0,0,,Әрқашан солай
Dialogue: 0,0:17:25.44,0:17:29.44,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:17:25.44,0:17:29.44,Default,,0,0,0,,Оңай пайдаланылады
Dialogue: 0,0:17:29.44,0:17:33.44,Default,,0,0,0,,Өйткені менің ағаларым жоқ
Dialogue: 0,0:17:29.44,0:17:33.44,Default,,0,0,0,,Мен қызғанамын
Dialogue: 0,0:17:37.45,0:17:44.39,Default,,0,0,0,,Мм... мен
Dialogue: 0,0:17:37.45,0:17:44.39,Default,,0,0,0,,Мен бұрын кездескен адам бар.
Dialogue: 0,0:17:44.39,0:17:51.39,Default,,0,0,0,,Біз кездесіп жүрсек те
Dialogue: 0,0:17:44.39,0:17:51.39,Default,,0,0,0,,Үлкен әпке мен сіңлінің жалғасы сияқты➡
Dialogue: 0,0:17:51.39,0:17:55.40,Default,,0,0,0,,Мен ол адам туралы алаңдаймын.
Dialogue: 0,0:17:51.39,0:17:55.40,Default,,0,0,0,,Маған ұнады, бірақ➡
Dialogue: 0,0:17:55.40,0:17:59.40,Default,,0,0,0,,Ол кісі жай ғана көңіл көтеріп жүрген шығар...
Dialogue: 0,0:17:59.40,0:18:01.40,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:01.40,0:18:05.41,Default,,0,0,0,,Бірақ мен ағамды кездестіргенде,
Dialogue: 0,0:18:01.40,0:18:05.41,Default,,0,0,0,,Мен ағама қатты алаңдаймын...
Dialogue: 0,0:18:05.41,0:18:08.41,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:18:05.41,0:18:08.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:08.41,0:18:11.41,Default,,0,0,0,,Фумиха
Dialogue: 0,0:18:08.41,0:18:11.41,Default,,0,0,0,,Сіз маған күмәнданасыз.
Dialogue: 0,0:18:11.41,0:18:14.42,Default,,0,0,0,,Ескі сезімдер
Dialogue: 0,0:18:11.41,0:18:14.42,Default,,0,0,0,,Ол әлі де сүйреп келеді.
Dialogue: 0,0:18:14.42,0:18:17.42,Default,,0,0,0,,Сонымен қатар, дәптерге қол тимейінше Шinigami-ді көре алмайсың – онда қалай…
Dialogue: 0,0:18:17.42,0:18:19.42,Default,,0,0,0,,Сонымен Фуми ше?
Dialogue: 0,0:18:21.42,0:18:26.43,Default,,0,0,0,,Сол адамның тастап кетуі
Dialogue: 0,0:18:21.42,0:18:26.43,Default,,0,0,0,,Мен дер кезінде пайда болдым
Dialogue: 0,0:18:26.43,0:18:29.43,Default,,0,0,0,,Мен және Фуми де➡
Dialogue: 0,0:18:29.43,0:18:32.43,Default,,0,0,0,,Мен бір көргеннен ғашық болғандай сезінемін
Dialogue: 0,0:18:29.43,0:18:32.43,Default,,0,0,0,,Мүмкін бұл жай ғана болған шығар.
Dialogue: 0,0:18:36.44,0:18:38.44,Default,,0,0,0,,≪(содзи ашу дыбысы)
Dialogue: 0,0:18:38.44,0:18:41.46,Default,,0,0,0,,≪(Сугако)
Dialogue: 0,0:18:38.44,0:18:41.46,Default,,0,0,0,,Олай болса да, жарайды.
Dialogue: 0,0:18:41.46,0:18:46.38,Default,,0,0,0,,Якчан. Басқа адамды кінәлаңыз.
Dialogue: 0,0:18:41.46,0:18:46.38,Default,,0,0,0,,Сізді бұрышқа салу жақсы емес.
Dialogue: 0,0:18:46.38,0:18:49.38,Default,,0,0,0,,Бұл аға болудың дұрыс жолы емес.
Dialogue: 0,0:18:51.39,0:18:54.39,Default,,0,0,0,,Сафуми-сан
Dialogue: 0,0:18:51.39,0:18:54.39,Default,,0,0,0,,Мұнда кел.➡
Dialogue: 0,0:18:54.39,0:18:56.39,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:18:59.40,0:19:02.40,Default,,0,0,0,,Бүгін сол жерде жалғыз ойлан.
Dialogue: 0,0:19:11.41,0:19:14.41,Default,,0,0,0,,Фуми-сан
Dialogue: 0,0:19:11.41,0:19:14.41,Default,,0,0,0,,Бүгін уақытыңыз бар ма?
Dialogue: 0,0:19:14.41,0:19:16.41,Default,,0,0,0,,Түнде қалуыңызды өтінемін.
Dialogue: 0,0:19:16.41,0:19:18.41,Default,,0,0,0,,Бұл шектен шыққан
Dialogue: 0,0:19:18.41,0:19:21.42,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:19:18.41,0:19:21.42,Default,,0,0,0,,Жоқ, шынымен.
Dialogue: 0,0:19:21.42,0:19:24.42,Default,,0,0,0,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,0:19:24.42,0:19:28.42,Default,,0,0,0,,Кьюкиге тамақ беріңіз.
Dialogue: 0,0:19:24.42,0:19:28.42,Default,,0,0,0,,Оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:19:30.43,0:19:33.43,Default,,0,0,0,,Ах, тағы да
Dialogue: 0,0:19:30.43,0:19:33.43,Default,,0,0,0,,Бірден осылай еркелетіңіз
Dialogue: 0,0:19:33.43,0:19:38.43,Default,,0,0,0,,Бұл! мен
Dialogue: 0,0:19:33.43,0:19:38.43,Default,,0,0,0,,Мен оны өзіммен бірге ала аламын ба?
Dialogue: 0,0:19:38.43,0:19:42.43,Default,,0,0,0,,О, бірақ...
Dialogue: 0,0:19:38.43,0:19:42.43,Default,,0,0,0,,Жоқ. Мм... бұл менмін.
Dialogue: 0,0:19:44.37,0:19:47.38,Default,,0,0,0,,Бұл шынымен жақсы нәрсе
Dialogue: 0,0:19:47.38,0:19:52.38,Default,,0,0,0,,Жарайды. Бәс тігеміз бе? Бүгін түнде.
Dialogue: 0,0:19:47.38,0:19:52.38,Default,,0,0,0,,Киоки сызықтан өте алады ма?
Dialogue: 0,0:19:52.38,0:19:55.38,Default,,0,0,0,,Егер қазір тоқтатсаңыз
Dialogue: 0,0:19:52.38,0:19:55.38,Default,,0,0,0,,Сіз мұны айтасыз ба?
Dialogue: 0,0:19:55.38,0:19:58.38,Default,,0,0,0,,Не? Сіз өзіңізді кінәлі сезінесіз бе?
Dialogue: 0,0:20:00.39,0:20:02.39,Default,,0,0,0,,Әй, эй, ұрыспа.
Dialogue: 0,0:20:02.39,0:20:06.40,Default,,0,0,0,,Ал басқа жол
Dialogue: 0,0:20:02.39,0:20:06.40,Default,,0,0,0,,Мүмкін мен одан асып түскен шығармын.
Dialogue: 0,0:20:06.40,0:20:08.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:06.40,0:20:08.40,Default,,0,0,0,,Иә!?
Dialogue: 0,0:20:08.40,0:20:11.40,Default,,0,0,0,,≪(Сугако)
Dialogue: 0,0:20:08.40,0:20:11.40,Default,,0,0,0,,Жоқ Ана – ең жас қамқоршы.
Dialogue: 0,0:20:16.41,0:20:18.41,Default,,0,0,0,,Ах
Dialogue: 0,0:20:18.41,0:20:20.41,Default,,0,0,0,,≪
Dialogue: 0,0:20:25.41,0:20:28.41,Default,,0,0,0,,Бұл жанды үй, солай емес пе?
Dialogue: 0,0:20:33.42,0:20:36.43,Default,,0,0,0,,Сенпай. Бұрынғыға келсек...
Dialogue: 0,0:20:33.42,0:20:36.43,Default,,0,0,0,,Ум...
Dialogue: 0,0:20:36.43,0:20:42.43,Default,,0,0,0,,Бұл қорқынышты болды, мен. Кешіріңіз.
Dialogue: 0,0:20:42.43,0:20:45.43,Default,,0,0,0,,менің сезімдерім
Dialogue: 0,0:20:42.43,0:20:45.43,Default,,0,0,0,,Ұйымдастырылмаған болу➡
Dialogue: 0,0:20:45.43,0:20:47.43,Default,,0,0,0,,Мен бұған Фумиді кінәладым.
Dialogue: 0,0:20:54.44,0:20:57.44,Default,,0,0,0,,(Кёки)
Dialogue: 0,0:20:54.44,0:20:57.44,Default,,0,0,0,,Біз қазіргідей кездесе алмаймыз.
Dialogue: 0,0:21:00.45,0:21:03.45,Default,,0,0,0,,(Жаңбыр дыбысы)
Dialogue: 0,0:21:11.46,0:21:16.47,Default,,0,0,0,,♬『ｾﾝﾃｨﾌｫﾘｱ』
