Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.46,0:00:11.46,Rubi,,0000,0000,0000,,Йошимичи
Dialogue: 0,0:00:08.46,0:00:11.46,Default,,0000,0000,0000,,Уф…
Dialogue: 0,0:00:08.46,0:00:11.46,Default,,0000,0000,0000,,Мектеп ғимаратына жету үшін біршама жаяу жүру керек.
Dialogue: 0,0:00:11.46,0:00:16.47,Rubi,,0000,0000,0000,,Сакико
Dialogue: 0,0:00:11.46,0:00:16.47,Rubi,,0000,0000,0000,,Фудзи
Dialogue: 0,0:00:11.46,0:00:16.47,Rubi,,0000,0000,0000,,Мен бас тартқан адамдардың бәрі бірден жойылды
Dialogue: 0,0:00:11.46,0:00:16.47,Default,,0000,0000,0000,,Фудзигая, солай ма?
Dialogue: 0,0:00:11.46,0:00:16.47,Rubi,,0000,0000,0000,,Иә, сол – қамыр жағылған.
Dialogue: 0,0:00:11.46,0:00:16.47,Default,,0000,0000,0000,,«The» дегеніміз не?
Dialogue: 0,0:00:16.47,0:00:19.47,Default,,0000,0000,0000,,Шинобу. Бүгінге сабыр етіңіз.
Dialogue: 0,0:00:19.47,0:00:22.47,Default,,0000,0000,0000,,Мен кіру рәсімінен бері костюм киген жоқпын.
Dialogue: 0,0:00:25.48,0:00:30.48,Rubi,,0000,0000,0000,,Көк
Dialogue: 0,0:00:25.48,0:00:30.48,Rubi,,0000,0000,0000,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:00:25.48,0:00:30.48,Default,,0000,0000,0000,,♬『Көк гүл』
Dialogue: 0,0:00:30.48,0:00:50.50,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:00:50.50,0:00:59.44,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:00:59.44,0:01:19.46,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:19.46,0:01:39.48,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:39.48,0:01:53.48,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:02.47,0:02:04.48,Default,,0000,0000,0000,,Аа-чан.
Dialogue: 0,0:02:04.48,0:02:07.48,Default,,0000,0000,0000,,Ей!
Dialogue: 0,0:02:07.48,0:02:10.48,Default,,0000,0000,0000,,О, ол жоғалып кетті.
Dialogue: 0,0:02:07.48,0:02:10.48,Rubi,,0000,0000,0000,,Мива
Dialogue: 0,0:02:07.48,0:02:10.48,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:02:10.48,0:02:12.48,Default,,0000,0000,0000,,Тыныш
Dialogue: 0,0:02:14.49,0:02:18.49,Rubi,,0000,0000,0000,,Йоко
Dialogue: 0,0:02:14.49,0:02:18.49,Default,,0000,0000,0000,,Маған гид керек, өтінемін.
Dialogue: 0,0:02:14.49,0:02:18.49,Default,,0000,0000,0000,,Иә, иә. О?
Dialogue: 0,0:02:18.49,0:02:21.49,Default,,0000,0000,0000,,Сәлем
Dialogue: 0,0:02:18.49,0:02:21.49,Default,,0000,0000,0000,,Бұл Фуми-чан емес.
Dialogue: 0,0:02:21.49,0:02:23.50,Default,,0000,0000,0000,,Бұған қоса, осы батпақтың қараңғылығы денеңе жабысып, салмақ салып тұр.
Dialogue: 0,0:02:23.50,0:02:26.50,Default,,0000,0000,0000,,А-чанның ата-анасы мен үлкен ағасы
Dialogue: 0,0:02:26.50,0:02:29.50,Rubi,,0000,0000,0000,,Мисако
Dialogue: 0,0:02:26.50,0:02:29.50,Default,,0000,0000,0000,,Сәлем, А Чан
Dialogue: 0,0:02:29.50,0:02:32.50,Rubi,,0000,0000,0000,,Мацуока
Dialogue: 0,0:02:29.50,0:02:32.50,Default,,0000,0000,0000,,Барлығы Мацуока, солай ма?
Dialogue: 0,0:02:29.50,0:02:32.50,Default,,0000,0000,0000,,Неге мұндасың?
Dialogue: 0,0:02:32.50,0:02:34.51,Default,,0000,0000,0000,,Біз
Dialogue: 0,0:02:32.50,0:02:34.51,Default,,0000,0000,0000,,Себебі мен А Чанның досымын➡
Dialogue: 0,0:02:34.51,0:02:36.51,Default,,0000,0000,0000,,Мен көмектесуге келдім.
Dialogue: 0,0:02:36.51,0:02:40.51,Default,,0000,0000,0000,,Иә, А-чанның көмегімен.
Dialogue: 0,0:02:36.51,0:02:40.51,Default,,0000,0000,0000,,Сәлем! А-чан
Dialogue: 0,0:02:40.51,0:02:45.52,Default,,0000,0000,0000,,Не? Сен ондасың ба? сонда
Dialogue: 0,0:02:40.51,0:02:45.52,Default,,0000,0000,0000,,Бос уақытыңыз болса, мектеп ғимаратын көрсетіңіз.
Dialogue: 0,0:02:45.52,0:02:49.52,Default,,0000,0000,0000,,Қосымша заттар
Dialogue: 0,0:02:45.52,0:02:49.52,Default,,0000,0000,0000,,Жақсы, жақсы
Dialogue: 0,0:02:55.54,0:02:58.46,Default,,0000,0000,0000,,(Ханзада айқайы)
Dialogue: 0,0:02:58.46,0:03:00.47,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:00.47,0:03:03.47,Rubi,,0000,0000,0000,,Ясуко
Dialogue: 0,0:03:00.47,0:03:03.47,Default,,0000,0000,0000,,Уау
Dialogue: 0,0:03:03.47,0:03:06.47,Rubi,,0000,0000,0000,,Сугимото
Dialogue: 0,0:03:03.47,0:03:06.47,Default,,0000,0000,0000,,Эй, Сугимото ше?
Dialogue: 0,0:03:06.47,0:03:10.48,Default,,0000,0000,0000,,Кішкентай ханзада жылап жатыр
Dialogue: 0,0:03:06.47,0:03:10.48,Default,,0000,0000,0000,,Мен қазір сені жұбатып жатырмын.
Dialogue: 0,0:03:10.48,0:03:13.48,Default,,0000,0000,0000,,Бастауыш сыныпқа да барған.
Dialogue: 0,0:03:10.48,0:03:13.48,Default,,0000,0000,0000,,Сіз фан-клуб ашуды жоспарлап отырсыз ба?
Dialogue: 0,0:03:15.48,0:03:18.48,Default,,0000,0000,0000,,Сіздің әпкеңіз қандай рөл атқарады?
Dialogue: 0,0:03:18.48,0:03:23.49,Default,,0000,0000,0000,,Мен? Хмм
Dialogue: 0,0:03:18.48,0:03:23.49,Default,,0000,0000,0000,,Аздап қиналған адам
Dialogue: 0,0:03:23.49,0:03:26.49,Default,,0000,0000,0000,,Сіз қиындыққа тап болған адамсыз ба?
Dialogue: 0,0:03:26.49,0:03:30.50,Default,,0000,0000,0000,,Жоқ…
Dialogue: 0,0:03:26.49,0:03:30.50,Default,,0000,0000,0000,,Менің айналамдағы адамдар қиыншылықта.
Dialogue: 0,0:03:30.50,0:03:33.50,Default,,0000,0000,0000,,Жаман адам?
Dialogue: 0,0:03:33.50,0:03:36.50,Default,,0000,0000,0000,,Нақты айта алмаймын.➡
Dialogue: 0,0:03:36.50,0:03:39.50,Default,,0000,0000,0000,,Ол қайдан пайда болды?
Dialogue: 0,0:03:36.50,0:03:39.50,Default,,0000,0000,0000,,Сіз не істедіңіз➡
Dialogue: 0,0:03:39.50,0:03:41.51,Default,,0000,0000,0000,,Мен шынымен түсінбеймін
Dialogue: 0,0:03:41.51,0:03:43.51,Default,,0000,0000,0000,,Барлығы біле бермейді ме?
Dialogue: 0,0:03:43.51,0:03:49.51,Default,,0000,0000,0000,,Иә. Әңгіменің басты кейіпкері
Dialogue: 0,0:03:43.51,0:03:49.51,Default,,0000,0000,0000,,Сіз өзіңізді үнемі жалғыз сезінесіз.
Dialogue: 0,0:03:49.51,0:03:52.52,Default,,0000,0000,0000,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:03:52.52,0:03:55.52,Default,,0000,0000,0000,,А, міне! тез
Dialogue: 0,0:03:59.46,0:04:01.46,Default,,0000,0000,0000,,Жақында кездескенше
Dialogue: 0,0:04:10.47,0:04:14.47,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:04:10.47,0:04:14.47,Default,,0000,0000,0000,,Сугимото-сенпай, осындасың ба?
Dialogue: 0,0:04:14.47,0:04:16.47,Default,,0000,0000,0000,,(мүше)
Dialogue: 0,0:04:14.47,0:04:16.47,Default,,0000,0000,0000,,Кешіріңіз. Мен әлі оралған жоқпын.➡
Dialogue: 0,0:04:16.47,0:04:19.48,Default,,0000,0000,0000,,Менің ханзадамда кезбе құмар бар.
Dialogue: 0,0:04:19.48,0:04:24.48,Default,,0000,0000,0000,,Хитклифф Хитклифф
Dialogue: 0,0:04:19.48,0:04:24.48,Default,,0000,0000,0000,,Мен үшін позиция жоқ.
Dialogue: 0,0:04:24.48,0:04:26.48,Rubi,,0000,0000,0000,,Каори
Dialogue: 0,0:04:24.48,0:04:26.48,Default,,0000,0000,0000,,Бұл жаман, Эдгар.
Dialogue: 0,0:04:26.48,0:04:29.49,Default,,0000,0000,0000,,Менің ағамда бұл Изабелла бар.
Dialogue: 0,0:04:26.48,0:04:29.49,Default,,0000,0000,0000,,Бар емес пе?
Dialogue: 0,0:04:29.49,0:04:33.49,Default,,0000,0000,0000,,Сен жақсы емессің.
Dialogue: 0,0:04:29.49,0:04:33.49,Default,,0000,0000,0000,,Мен сенің қарындасың болсам да, сен мені сатып жібердің.➡
Dialogue: 0,0:04:33.49,0:04:35.49,Default,,0000,0000,0000,,Сондықтан бақытсыз боласың
Dialogue: 0,0:04:35.49,0:04:37.50,Default,,0000,0000,0000,,Себебі Эдгар
Dialogue: 0,0:04:35.49,0:04:37.50,Default,,0000,0000,0000,,Хит жақсырақ.
Dialogue: 0,0:04:37.50,0:04:40.50,Default,,0000,0000,0000,,Сіз шынымен
Dialogue: 0,0:04:37.50,0:04:40.50,Default,,0000,0000,0000,,Жаман адамға алданып қалу...
Dialogue: 0,0:04:40.50,0:04:45.50,Default,,0000,0000,0000,,Бұл таңқаларлық. Қанша дана?
Dialogue: 0,0:04:40.50,0:04:45.50,Default,,0000,0000,0000,,Е. Мен енді түсінбеймін.
Dialogue: 0,0:04:49.51,0:04:52.51,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:04:49.51,0:04:52.51,Default,,0000,0000,0000,,Бұл бастауыш мектеп
Dialogue: 0,0:04:52.51,0:04:55.53,Default,,0000,0000,0000,,(Мисако)
Dialogue: 0,0:04:52.51,0:04:55.53,Default,,0000,0000,0000,,Қызық, қайда жоғалып кетті?
Dialogue: 0,0:04:55.53,0:04:58.45,Default,,0000,0000,0000,,Аты қалай?
Dialogue: 0,0:04:55.53,0:04:58.45,Default,,0000,0000,0000,,Мен бүкіл отбасы үшін жазуым керек пе?
Dialogue: 0,0:04:58.45,0:05:00.45,Default,,0000,0000,0000,,А, иә. Мұнда.
Dialogue: 0,0:05:00.45,0:05:03.45,Default,,0000,0000,0000,,《Мен бастауыш мектепке қайтамын》
Dialogue: 0,0:05:03.45,0:05:05.45,Default,,0000,0000,0000,,(Мисако)
Dialogue: 0,0:05:03.45,0:05:05.45,Default,,0000,0000,0000,,《Шынымен бе? Жарайды, өтінемін》
Dialogue: 0,0:05:10.46,0:05:12.46,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:05:12.46,0:05:14.47,Default,,0000,0000,0000,,Ах Фуми
Dialogue: 0,0:05:14.47,0:05:17.47,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:05:17.47,0:05:23.47,Default,,0000,0000,0000,,Хаха. Сіз аудиторияда болуыңыз керек ...
Dialogue: 0,0:05:23.47,0:05:26.48,Default,,0000,0000,0000,,Мен бастауыш мектепке тоқтадым. Фуми ше?
Dialogue: 0,0:05:26.48,0:05:29.48,Default,,0000,0000,0000,,Мен мұны жеткізуге бара жатырмын.
Dialogue: 0,0:05:29.48,0:05:33.48,Default,,0000,0000,0000,,Біз қиындыққа тап болуымыз мүмкін болса да
Dialogue: 0,0:05:29.48,0:05:33.48,Default,,0000,0000,0000,,Біздің мұндай жерде кездесетінімізге сене алар емеспін.
Dialogue: 0,0:05:33.48,0:05:37.49,Default,,0000,0000,0000,,Иә. Бұл керемет.
Dialogue: 0,0:05:37.49,0:05:41.49,Default,,0000,0000,0000,,Таңғажайып тағдыр
Dialogue: 0,0:05:37.49,0:05:41.49,Default,,0000,0000,0000,,Шынымен
Dialogue: 0,0:05:41.49,0:05:53.50,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:53.50,0:05:56.44,Default,,0000,0000,0000,,Қойылымды жеңгеңнен тамашалайсың ба?
Dialogue: 0,0:05:56.44,0:06:00.45,Default,,0000,0000,0000,,Мен оны көрермендер орындарынан көремін.
Dialogue: 0,0:05:56.44,0:06:00.45,Default,,0000,0000,0000,,Түсіндім
Dialogue: 0,0:06:00.45,0:06:03.45,Default,,0000,0000,0000,,Жұмыс біткен соң, маған асығып кел.
Dialogue: 0,0:06:03.45,0:06:05.45,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:06:11.46,0:06:13.46,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:06:13.46,0:06:17.46,Default,,0000,0000,0000,,Тортқа тапсырыс берейік.
Dialogue: 0,0:06:13.46,0:06:17.46,Default,,0000,0000,0000,,А-чан не істейді?
Dialogue: 0,0:06:17.46,0:06:21.47,Default,,0000,0000,0000,,Менде бәрі жақсы.
Dialogue: 0,0:06:17.46,0:06:21.47,Default,,0000,0000,0000,,Менің қазір кетуім керек.
Dialogue: 0,0:06:21.47,0:06:25.47,Default,,0000,0000,0000,,Кішкене болса жақсы.
Dialogue: 0,0:06:21.47,0:06:25.47,Default,,0000,0000,0000,,Эй, сен не ұсынасың?
Dialogue: 0,0:06:25.47,0:06:27.47,Default,,0000,0000,0000,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:06:25.47,0:06:27.47,Default,,0000,0000,0000,,Ах.➡
Dialogue: 0,0:06:27.47,0:06:29.47,Rubi,,0000,0000,0000,,Дауыл
Dialogue: 0,0:06:27.47,0:06:29.47,Rubi,,0000,0000,0000,,Жарайды
Dialogue: 0,0:06:27.47,0:06:29.47,Default,,0000,0000,0000,,«Шыңғырған биіктер»
Dialogue: 0,0:06:27.47,0:06:29.47,Default,,0000,0000,0000,,Бұл орналасқан жер туралы емес.
Dialogue: 0,0:06:29.47,0:06:32.48,Default,,0000,0000,0000,,Үйдің атауы шешілді.
Dialogue: 0,0:06:32.48,0:06:34.48,Default,,0000,0000,0000,,Себебі мен білмеймін
Dialogue: 0,0:06:32.48,0:06:34.48,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:06:34.48,0:06:39.48,Default,,0000,0000,0000,,«Шыңғырған биіктер»...
Dialogue: 0,0:06:34.48,0:06:39.48,Default,,0000,0000,0000,,Хитклифф керемет, солай емес пе?
Dialogue: 0,0:06:39.48,0:06:43.49,Default,,0000,0000,0000,,Анашым, сіз білесіз бе?
Dialogue: 0,0:06:39.48,0:06:43.49,Default,,0000,0000,0000,,Студент кезімде оқығаным.➡
Dialogue: 0,0:06:43.49,0:06:47.49,Default,,0000,0000,0000,,Мен сенімдімін Англия 18 ғасырдың аяғында
Dialogue: 0,0:06:43.49,0:06:47.49,Default,,0000,0000,0000,,Бұл сахна, солай ма?
Dialogue: 0,0:06:47.49,0:06:50.50,Default,,0000,0000,0000,,Иә. Солтүстік Англия.
Dialogue: 0,0:06:47.49,0:06:50.50,Default,,0000,0000,0000,,Йоркшир - шөл дала➡
Dialogue: 0,0:06:50.50,0:06:52.50,Default,,0000,0000,0000,,Дауыл ғажап
Dialogue: 0,0:06:52.50,0:06:55.52,Default,,0000,0000,0000,,Бұл күмәнді.
Dialogue: 0,0:06:52.50,0:06:55.52,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:06:55.52,0:06:59.44,Default,,0000,0000,0000,,Хитклифф пен Кэтрин
Dialogue: 0,0:06:55.52,0:06:59.44,Default,,0000,0000,0000,,Бала күнгі достар арасындағы қайғылы махаббат хикаясы.
Dialogue: 0,0:06:59.44,0:07:03.44,Default,,0000,0000,0000,,Бір-бірімізді жақсы көрсек те
Dialogue: 0,0:06:59.44,0:07:03.44,Default,,0000,0000,0000,,Екеуі бірге бітпейді, солай ма?
Dialogue: 0,0:07:03.44,0:07:06.44,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:07:03.44,0:07:06.44,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:07:06.44,0:07:10.45,Default,,0000,0000,0000,,Бұл мен түсінбейтін нәрсе.
Dialogue: 0,0:07:06.44,0:07:10.45,Default,,0000,0000,0000,,Ком-Омбодағы адам да шынайы емес пе еді?
Dialogue: 0,0:07:10.45,0:07:12.45,Default,,0000,0000,0000,,Мен қазір кетемін.
Dialogue: 0,0:07:12.45,0:07:16.45,Default,,0000,0000,0000,,Орта мектеп бәрібір соңғысы, солай ма?
Dialogue: 0,0:07:12.45,0:07:16.45,Default,,0000,0000,0000,,Дайынсың ба?
Dialogue: 0,0:07:16.45,0:07:19.46,Default,,0000,0000,0000,,[ﾏｲｸ](ｱﾅｳﾝｽ)
Dialogue: 0,0:07:16.45,0:07:19.46,Default,,0000,0000,0000,,Қойылым басталатын уақыт та қалды.➡
Dialogue: 0,0:07:19.46,0:07:22.46,Default,,0000,0000,0000,,Орыныңызға отырыңыз және күтіңіз.
Dialogue: 0,0:07:22.46,0:07:25.46,Rubi,,0000,0000,0000,,Манджуме
Dialogue: 0,0:07:22.46,0:07:25.46,Default,,0000,0000,0000,,Манжоме-сан
Dialogue: 0,0:07:22.46,0:07:25.46,Default,,0000,0000,0000,,Қанша жол жүрдіңіз?
Dialogue: 0,0:07:25.46,0:07:28.46,Default,,0000,0000,0000,,(Шығарманы іске қосу)
Dialogue: 0,0:07:31.47,0:07:36.47,Default,,0000,0000,0000,,Қараңдаршы, мына жіңішке тікен.
Dialogue: 0,0:07:31.47,0:07:36.47,Default,,0000,0000,0000,,Аң келсе де жарайды
Dialogue: 0,0:07:36.47,0:07:39.48,Default,,0000,0000,0000,,(ханзада)
Dialogue: 0,0:07:36.47,0:07:39.48,Default,,0000,0000,0000,,Менің планетамда аңдар жоқ.➡
Dialogue: 0,0:07:39.48,0:07:43.48,Default,,0000,0000,0000,,Және қорқынышты аң
Dialogue: 0,0:07:39.48,0:07:43.48,Default,,0000,0000,0000,,Мен шөп жемеймін.
Dialogue: 0,0:07:43.48,0:07:47.49,Default,,0000,0000,0000,,Мен шөп емеспін
Dialogue: 0,0:07:43.48,0:07:47.49,Default,,0000,0000,0000,,Аа, кешіріңіз.
Dialogue: 0,0:07:47.49,0:07:49.49,Default,,0000,0000,0000,,(аудитория күлкі)
Dialogue: 0,0:07:49.49,0:07:54.49,Default,,0000,0000,0000,,А-чан, егер мені осында шығарсаң.
Dialogue: 0,0:07:49.49,0:07:54.49,Default,,0000,0000,0000,,Бұл жақсы емес пе? Шиноби!
Dialogue: 0,0:07:54.49,0:07:56.43,Default,,0000,0000,0000,,(ханзада)
Dialogue: 0,0:07:54.49,0:07:56.43,Default,,0000,0000,0000,,Мен оны жақсы көрдім, бірақ➡
Dialogue: 0,0:07:56.43,0:07:59.43,Default,,0000,0000,0000,,Бірге болу
Dialogue: 0,0:07:56.43,0:07:59.43,Default,,0000,0000,0000,,Мен қиын екенін сезіне бастадым.
Dialogue: 0,0:07:59.43,0:08:02.43,Default,,0000,0000,0000,,Қош бол!
Dialogue: 0,0:08:02.43,0:08:04.44,Default,,0000,0000,0000,,(Юки) Уф… (Ишикава) Ха…
Dialogue: 0,0:08:04.44,0:08:08.44,Default,,0000,0000,0000,,Мен бұл планетадан кетемін
Dialogue: 0,0:08:04.44,0:08:08.44,Default,,0000,0000,0000,,Иә. Қош бол.
Dialogue: 0,0:08:13.44,0:08:16.44,Default,,0000,0000,0000,,Таспа
Dialogue: 0,0:08:13.44,0:08:16.44,Default,,0000,0000,0000,,Сіз қайсысын таңдар едіңіз?
Dialogue: 0,0:08:18.45,0:08:22.45,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:08:18.45,0:08:22.45,Default,,0000,0000,0000,,Сосын ашық көк түс, өтінемін.
Dialogue: 0,0:08:22.45,0:08:24.45,Default,,0000,0000,0000,,Иә, бұл ашық көк.
Dialogue: 0,0:08:26.46,0:08:28.46,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:31.46,0:08:33.46,Default,,0000,0000,0000,,Уху…
Dialogue: 0,0:08:35.47,0:08:37.47,Default,,0000,0000,0000,,(ханзада)
Dialogue: 0,0:08:35.47,0:08:37.47,Default,,0000,0000,0000,,Барлығы не іздейді➡
Dialogue: 0,0:08:37.47,0:08:42.47,Default,,0000,0000,0000,,Бір ғана раушан, бірнешеу ғана
Dialogue: 0,0:08:37.47,0:08:42.47,Default,,0000,0000,0000,,Суда кездеседі➡
Dialogue: 0,0:08:42.47,0:08:47.48,Default,,0000,0000,0000,,Көзге көрінбейтін
Dialogue: 0,0:08:42.47,0:08:47.48,Default,,0000,0000,0000,,Жүрекпен іздеу керек.
Dialogue: 0,0:08:47.48,0:08:56.42,Default,,0000,0000,0000,,Мен хат жібергім келеді…
Dialogue: 0,0:08:56.42,0:08:58.42,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:09:02.43,0:09:04.43,Default,,0000,0000,0000,,Сіз қайда болдыңыз?
Dialogue: 0,0:09:04.43,0:09:08.43,Rubi,,0000,0000,0000,,Мынау да.
Dialogue: 0,0:09:04.43,0:09:08.43,Rubi,,0000,0000,0000,,Окудаира
Dialogue: 0,0:09:04.43,0:09:08.43,Default,,0000,0000,0000,,Окухира мырза
Dialogue: 0,0:09:04.43,0:09:08.43,Default,,0000,0000,0000,,А, сәлем
Dialogue: 0,0:09:08.43,0:09:11.44,Rubi,,0000,0000,0000,,Киоко
Dialogue: 0,0:09:08.43,0:09:11.44,Default,,0000,0000,0000,,Киоко сонда ма?
Dialogue: 0,0:09:08.43,0:09:11.44,Rubi,,0000,0000,0000,,Икуми
Dialogue: 0,0:09:08.43,0:09:11.44,Default,,0000,0000,0000,,Егер Игуми мырза...
Dialogue: 0,0:09:11.44,0:09:16.44,Default,,0000,0000,0000,,Ясу-чан. Келдің бе?
Dialogue: 0,0:09:11.44,0:09:16.44,Default,,0000,0000,0000,,Ал, келе жатыр.
Dialogue: 0,0:09:16.44,0:09:19.44,Default,,0000,0000,0000,,Сіз
Dialogue: 0,0:09:16.44,0:09:19.44,Default,,0000,0000,0000,,Бұл менің кінәм екенін түсінесің бе?
Dialogue: 0,0:09:19.44,0:09:23.45,Default,,0000,0000,0000,,Ясу-чан жақсы аға.
Dialogue: 0,0:09:19.44,0:09:23.45,Default,,0000,0000,0000,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:09:23.45,0:09:26.45,Rubi,,0000,0000,0000,,Вакакуса оқиғасы
Dialogue: 0,0:09:23.45,0:09:26.45,Default,,0000,0000,0000,,«Кішкентай әйелдер» басталды!
Dialogue: 0,0:09:23.45,0:09:26.45,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:09:26.45,0:09:29.45,Default,,0000,0000,0000,,Міне, ақырында!
Dialogue: 0,0:09:26.45,0:09:29.45,Default,,0000,0000,0000,,Мен қобалжыдым
Dialogue: 0,0:09:29.45,0:09:32.46,Default,,0000,0000,0000,,Аяқтаған соң жіберемін.
Dialogue: 0,0:09:29.45,0:09:32.46,Default,,0000,0000,0000,,Себебі мен көлікпен келдім.
Dialogue: 0,0:09:32.46,0:09:36.46,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:09:32.46,0:09:36.46,Default,,0000,0000,0000,,Спектакльден кейін кездесу бар ма?
Dialogue: 0,0:09:36.46,0:09:39.46,Default,,0000,0000,0000,,Сондықтан күтудің қажеті жоқ.
Dialogue: 0,0:09:39.46,0:09:41.46,Default,,0000,0000,0000,,Мен күтемін!
Dialogue: 0,0:09:45.47,0:09:47.47,Default,,0000,0000,0000,,Бет... сенің өлгеніңді қаламаймын.
Dialogue: 0,0:09:47.47,0:09:50.48,Default,,0000,0000,0000,,Жақсы қыз бол және барынша тырыс, жарай ма?
Dialogue: 0,0:09:47.47,0:09:50.48,Default,,0000,0000,0000,,Бетке көмектесіңіз.➡
Dialogue: 0,0:09:50.48,0:09:53.48,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:09:50.48,0:09:53.48,Default,,0000,0000,0000,,Мен енді ешқашан шағымданбаймын
Dialogue: 0,0:09:53.48,0:09:56.48,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:09:53.48,0:09:56.48,Default,,0000,0000,0000,,Өміріңіздің соңына дейін Құдайға қызмет етіңіз
Dialogue: 0,0:09:59.42,0:10:02.42,Default,,0000,0000,0000,,Кешіріңіз. Бұл жерде бұзылған.
Dialogue: 0,0:09:59.42,0:10:02.42,Default,,0000,0000,0000,,А... иә
Dialogue: 0,0:10:04.42,0:10:09.43,Default,,0000,0000,0000,,Хмм, тағы біраз
Dialogue: 0,0:10:04.42,0:10:09.43,Default,,0000,0000,0000,,Сізге жабайы нәрсе керек, солай ма?
Dialogue: 0,0:10:09.43,0:10:12.43,Default,,0000,0000,0000,,Жоқ, бұл жеткілікті жабайы.
Dialogue: 0,0:10:12.43,0:10:15.43,Default,,0000,0000,0000,,Өтінемін, А-чан
Dialogue: 0,0:10:12.43,0:10:15.43,Default,,0000,0000,0000,,Қолдарыңызбен атқылаңыз
Dialogue: 0,0:10:15.43,0:10:18.44,Default,,0000,0000,0000,,Е! А... мен!?
Dialogue: 0,0:10:18.44,0:10:20.44,Default,,0000,0000,0000,,Массаж қызметін де атқарады
Dialogue: 0,0:10:23.44,0:10:29.44,Default,,0000,0000,0000,,Аа, бұл жақсы сезінеді
Dialogue: 0,0:10:23.44,0:10:29.44,Default,,0000,0000,0000,,Менің жүрегім қатты босаңсыды.
Dialogue: 0,0:10:34.45,0:10:36.45,Default,,0000,0000,0000,,Сенпай?
Dialogue: 0,0:10:38.46,0:10:41.46,Default,,0000,0000,0000,,Мен бұл туралы әлі қатты қобалжыдым.
Dialogue: 0,0:10:43.46,0:10:45.46,Default,,0000,0000,0000,,Еңбек тәжірибесі бағдарламасына оралды
Dialogue: 0,0:10:45.46,0:10:47.46,Default,,0000,0000,0000,,Иә... Иә.
Dialogue: 0,0:10:49.47,0:10:55.49,Default,,0000,0000,0000,,《Бұл Фуми-чан болмаса да
Dialogue: 0,0:10:49.47,0:10:55.49,Default,,0000,0000,0000,,Бұл өте қауіпті.➡
Dialogue: 0,0:10:55.49,0:10:57.41,Default,,0000,0000,0000,,Бұл қауіпті аға.
Dialogue: 0,0:10:57.41,0:10:59.41,Default,,0000,0000,0000,,Барлығың дайынсыңдар ма?
Dialogue: 0,0:10:59.41,0:11:12.41,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:11:14.43,0:11:18.43,Default,,0000,0000,0000,,(Сыртқышты бастау)
Dialogue: 0,0:11:26.46,0:11:32.46,Default,,0000,0000,0000,,(Ағаш есікті қағу)
Dialogue: 0,0:11:32.46,0:11:38.47,Default,,0000,0000,0000,,(Жел дыбысы)
Dialogue: 0,0:11:38.47,0:11:41.47,Default,,0000,0000,0000,,Сол сарайда
Dialogue: 0,0:11:38.47,0:11:41.47,Default,,0000,0000,0000,,Сіз сонда болдыңыз ба?
Dialogue: 0,0:11:41.47,0:11:45.48,Default,,0000,0000,0000,,Мен солай ойлаймын. Ана жерде.
Dialogue: 0,0:11:41.47,0:11:45.48,Default,,0000,0000,0000,,Қатал атмосфераға толы➡
Dialogue: 0,0:11:45.48,0:11:47.48,Default,,0000,0000,0000,,Мен тұншығып жатырмын
Dialogue: 0,0:11:47.48,0:11:52.48,Default,,0000,0000,0000,,Отбасы жиналыстары және т.б.
Dialogue: 0,0:11:47.48,0:11:52.48,Default,,0000,0000,0000,,Ұзақ жоғалған.
Dialogue: 0,0:11:52.48,0:11:57.49,Default,,0000,0000,0000,,Онда не болды?
Dialogue: 0,0:11:52.48,0:11:57.49,Default,,0000,0000,0000,,Иә, мен өте жақсы білемін.
Dialogue: 0,0:11:57.49,0:12:00.49,Default,,0000,0000,0000,,Сол сарайға келсек.
Dialogue: 0,0:12:00.49,0:12:03.49,Default,,0000,0000,0000,,Егер сіз Узеринг Биіктері туралы айтып жатсаңыз...｡➡
Dialogue: 0,0:12:03.49,0:12:06.50,Default,,0000,0000,0000,,Үйдің иесі
Dialogue: 0,0:12:03.49,0:12:06.50,Default,,0000,0000,0000,,Эрншоу отбасы.➡
Dialogue: 0,0:12:06.50,0:12:10.50,Default,,0000,0000,0000,,Әйелі дүниеден озды.
Dialogue: 0,0:12:06.50,0:12:10.50,Default,,0000,0000,0000,,Күтуші ретінде➡
Dialogue: 0,0:12:10.50,0:12:13.50,Default,,0000,0000,0000,,Екі бала
Dialogue: 0,0:12:10.50,0:12:13.50,Default,,0000,0000,0000,,Көмегіңе рахмет.➡
Dialogue: 0,0:12:13.50,0:12:17.51,Default,,0000,0000,0000,,Сол күні, менің күйеуім
Dialogue: 0,0:12:13.50,0:12:17.51,Default,,0000,0000,0000,,Кім қайтарылды ➡
Dialogue: 0,0:12:17.51,0:12:22.51,Default,,0000,0000,0000,,шүберек киген
Dialogue: 0,0:12:17.51,0:12:22.51,Default,,0000,0000,0000,,Туысы жоқ бала еді.
Dialogue: 0,0:12:22.51,0:12:24.53,Default,,0000,0000,0000,,Ик!
Dialogue: 0,0:12:24.53,0:12:26.45,Default,,0000,0000,0000,,Тыныш
Dialogue: 0,0:12:26.45,0:12:29.45,Default,,0000,0000,0000,,«Кя» Ухуфу
Dialogue: 0,0:12:26.45,0:12:29.45,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:12:29.45,0:12:33.46,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:12:29.45,0:12:33.46,Rubi,,0000,0000,0000,,Такаразука
Dialogue: 0,0:12:29.45,0:12:33.46,Default,,0000,0000,0000,,Такаразука сияқты нәрсе ме?
Dialogue: 0,0:12:33.46,0:12:36.46,Default,,0000,0000,0000,,Үйдегі адамдар
Dialogue: 0,0:12:33.46,0:12:36.46,Default,,0000,0000,0000,,Мен абдырап қалдым➡
Dialogue: 0,0:12:36.46,0:12:41.47,Default,,0000,0000,0000,,Бір ғана, менің әпкем Кэтрин
Dialogue: 0,0:12:36.46,0:12:41.47,Default,,0000,0000,0000,,Мен оған жүрегімді бердім.
Dialogue: 0,0:12:41.47,0:12:44.47,Default,,0000,0000,0000,,Не керек, Крюгер мырза?
Dialogue: 0,0:12:41.47,0:12:44.47,Default,,0000,0000,0000,,Сіз Хитклиффті айтасыз ба?
Dialogue: 0,0:12:44.47,0:12:47.47,Default,,0000,0000,0000,,О
Dialogue: 0,0:12:44.47,0:12:47.47,Default,,0000,0000,0000,,Маған есімді күйеуім қойды.
Dialogue: 0,0:12:47.47,0:12:50.47,Default,,0000,0000,0000,,Хитклиф... Хитклиф.➡
Dialogue: 0,0:12:50.47,0:12:55.48,Default,,0000,0000,0000,,Ешқашан дауылға берілме
Dialogue: 0,0:12:50.47,0:12:55.48,Default,,0000,0000,0000,,Мен Ринмен бірге тұрмын.
Dialogue: 0,0:12:55.48,0:12:58.48,Default,,0000,0000,0000,,Керемет атына сай
Dialogue: 0,0:12:58.48,0:13:01.49,Default,,0000,0000,0000,,(Хитклиф пен Кэтрин күледі)
Dialogue: 0,0:13:01.49,0:13:05.49,Default,,0000,0000,0000,,Кэтрин
Dialogue: 0,0:13:01.49,0:13:05.49,Default,,0000,0000,0000,,Маған Хитклифф ұнады.
Dialogue: 0,0:13:05.49,0:13:09.49,Default,,0000,0000,0000,,Хитклифф де
Dialogue: 0,0:13:05.49,0:13:09.49,Default,,0000,0000,0000,,Мен Кэтринді жақсы көретінмін.
Dialogue: 0,0:13:11.50,0:13:13.50,Default,,0000,0000,0000,,(Итеру дыбысы)
Dialogue: 0,0:13:11.50,0:13:13.50,Default,,0000,0000,0000,,Уф
Dialogue: 0,0:13:13.50,0:13:15.50,Default,,0000,0000,0000,,Хиндли аға!
Dialogue: 0,0:13:15.50,0:13:18.50,Default,,0000,0000,0000,,Сіз келгеннен бері
Dialogue: 0,0:13:15.50,0:13:18.50,Default,,0000,0000,0000,,Менің үйім бей-берекет.➡
Dialogue: 0,0:13:18.50,0:13:22.51,Default,,0000,0000,0000,,Неге, әке?
Dialogue: 0,0:13:18.50,0:13:22.51,Default,,0000,0000,0000,,Өзіңізге қамқор болыңыз!
Dialogue: 0,0:13:22.51,0:13:24.48,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:13:22.51,0:13:24.48,Default,,0000,0000,0000,,Ke…➡
Dialogue: 0,0:13:24.48,0:13:26.48,Default,,0000,0000,0000,,Мен сені дәл қазір қуып жіберемін.
Dialogue: 0,0:13:28.35,0:13:32.35,Default,,0000,0000,0000,,Менің ағам Хиндли
Dialogue: 0,0:13:28.35,0:13:32.35,Default,,0000,0000,0000,,Мен Хитклиффті жек көретінмін.➡
Dialogue: 0,0:13:32.35,0:13:37.35,Default,,0000,0000,0000,,Әке махаббатынан айырылғанын.
Dialogue: 0,0:13:32.35,0:13:37.35,Default,,0000,0000,0000,,Мен оны сезіндім.
Dialogue: 0,0:13:37.35,0:13:41.36,Rubi,,0000,0000,0000,,Кавасаки
Dialogue: 0,0:13:37.35,0:13:41.36,Default,,0000,0000,0000,,Уф... шашым ұсталып қалды.
Dialogue: 0,0:13:37.35,0:13:41.36,Default,,0000,0000,0000,,Жою
Dialogue: 0,0:13:41.36,0:13:44.36,Default,,0000,0000,0000,,А-чан
Dialogue: 0,0:13:41.36,0:13:44.36,Default,,0000,0000,0000,,Иә. Келесі осы.
Dialogue: 0,0:13:44.36,0:13:46.36,Default,,0000,0000,0000,,Сіз бір нәрсені ұмыттыңыз ба?
Dialogue: 0,0:13:44.36,0:13:46.36,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:46.36,0:13:51.37,Default,,0000,0000,0000,,О! Мен оны бірден аламын
Dialogue: 0,0:13:46.36,0:13:51.37,Default,,0000,0000,0000,,Дүрбелеңнің қажеті жоқ
Dialogue: 0,0:13:51.37,0:13:54.37,Default,,0000,0000,0000,,(Нелли)
Dialogue: 0,0:13:51.37,0:13:54.37,Default,,0000,0000,0000,,Қасында жүрген Кэтрин ➡
Dialogue: 0,0:13:54.37,0:13:58.38,Default,,0000,0000,0000,,Егер сіз мысық кию туралы ойласаңыз
Dialogue: 0,0:13:54.37,0:13:58.38,Default,,0000,0000,0000,,Кенет ашулану➡
Dialogue: 0,0:13:58.38,0:14:02.38,Default,,0000,0000,0000,,Көңіл-күйі оңай өзгеретін қызға
Dialogue: 0,0:13:58.38,0:14:02.38,Default,,0000,0000,0000,,Енді
Dialogue: 0,0:14:04.38,0:14:08.39,Default,,0000,0000,0000,,♬
Dialogue: 0,0:14:08.39,0:14:10.39,Default,,0000,0000,0000,,Жақын жердегі сарайдан ➡
Dialogue: 0,0:14:10.39,0:14:14.39,Default,,0000,0000,0000,,Көбінесе кешкі астағы музыка
Dialogue: 0,0:14:10.39,0:14:14.39,Default,,0000,0000,0000,,Мен оны естідім.
Dialogue: 0,0:14:14.39,0:14:17.39,Default,,0000,0000,0000,,Линтон отбасының жалғыз ұлы.
Dialogue: 0,0:14:14.39,0:14:17.39,Default,,0000,0000,0000,,Эдгар➡
Dialogue: 0,0:14:17.39,0:14:21.40,Default,,0000,0000,0000,,Кэтрин ше?
Dialogue: 0,0:14:17.39,0:14:21.40,Default,,0000,0000,0000,,Оған ғашық болғанын айтты.
Dialogue: 0,0:14:21.40,0:14:24.40,Default,,0000,0000,0000,,♬
Dialogue: 0,0:14:24.40,0:14:29.44,Default,,0000,0000,0000,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:14:24.40,0:14:29.44,Default,,0000,0000,0000,,Нелли, мен не істеуім керек?
Dialogue: 0,0:14:29.44,0:14:33.44,Default,,0000,0000,0000,,Не? жас ханым
Dialogue: 0,0:14:29.44,0:14:33.44,Default,,0000,0000,0000,,Ешкімге айтпа
Dialogue: 0,0:14:33.44,0:14:37.45,Default,,0000,0000,0000,,Эдгарға
Dialogue: 0,0:14:33.44,0:14:37.45,Default,,0000,0000,0000,,Саған тұрмысқа шығуымды өтінді...➡
Dialogue: 0,0:14:37.45,0:14:41.45,Default,,0000,0000,0000,,Сіз келісім бердіңіз бе?
Dialogue: 0,0:14:37.45,0:14:41.45,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:41.45,0:14:45.46,Default,,0000,0000,0000,,Сіз оны алдыңыз ба?
Dialogue: 0,0:14:41.45,0:14:45.46,Default,,0000,0000,0000,,Иә.➡
Dialogue: 0,0:14:45.46,0:14:49.46,Default,,0000,0000,0000,,Бірақ бұл
Dialogue: 0,0:14:45.46,0:14:49.46,Default,,0000,0000,0000,,Бұл шынымен де жақсы болды ма?
Dialogue: 0,0:14:49.46,0:14:51.46,Default,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:14:49.46,0:14:51.46,Default,,0000,0000,0000,,Сіз сұраққа жауап бердіңіз, солай ма? ➡
Dialogue: 0,0:14:51.46,0:14:57.47,Default,,0000,0000,0000,,Енді сөзге араласудың қажеті жоқ...
Dialogue: 0,0:14:51.46,0:14:57.47,Default,,0000,0000,0000,,Маған жауап бер, Нелли.
Dialogue: 0,0:14:57.47,0:14:59.47,Default,,0000,0000,0000,,Тым тығыз емес пе?
Dialogue: 0,0:15:01.47,0:15:04.47,Default,,0000,0000,0000,,Киоко да тентек қыз.
Dialogue: 0,0:15:06.48,0:15:09.48,Default,,0000,0000,0000,,Ақша бермесе де... солай ма?
Dialogue: 0,0:15:09.48,0:15:15.49,Default,,0000,0000,0000,,Маған Эдгар ұнайды
Dialogue: 0,0:15:09.48,0:15:15.49,Default,,0000,0000,0000,,А... Мен қате таңдадым.
Dialogue: 0,0:15:15.49,0:15:18.49,Default,,0000,0000,0000,,≪ (Нелли) Хитклифф туралы
Dialogue: 0,0:15:15.49,0:15:18.49,Default,,0000,0000,0000,,Бұл сізді мазалайды ма?
Dialogue: 0,0:15:18.49,0:15:23.49,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Кэтрин
Dialogue: 0,0:15:18.49,0:15:23.49,Default,,0000,0000,0000,,IBN 5100 — ол
Dialogue: 0,0:15:23.49,0:15:27.43,Default,,0000,0000,0000,,Мен сенің үйленгеніңді білгенде
Dialogue: 0,0:15:23.49,0:15:27.43,Default,,0000,0000,0000,,Хитклифф қайғылы болады.
Dialogue: 0,0:15:27.43,0:15:31.44,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:15:27.43,0:15:31.44,Default,,0000,0000,0000,,Біз бұдан былай әрқашан бірге боламыз.
Dialogue: 0,0:15:31.44,0:15:34.44,Default,,0000,0000,0000,,Сен шынымен жақсысың, Кавасаки-сенпай.
Dialogue: 0,0:15:34.44,0:15:37.44,Default,,0000,0000,0000,,Бұл ол туралы емес.
Dialogue: 0,0:15:34.44,0:15:37.44,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:37.44,0:15:40.44,Default,,0000,0000,0000,,Жоқ, Нелли.
Dialogue: 0,0:15:37.44,0:15:40.44,Default,,0000,0000,0000,,Солай емес пе?
Dialogue: 0,0:15:40.44,0:15:42.45,Default,,0000,0000,0000,,Кэтрин
Dialogue: 0,0:15:42.45,0:15:46.45,Default,,0000,0000,0000,,Ах. Менің ойымша, ол қиын адам.
Dialogue: 0,0:15:42.45,0:15:46.45,Default,,0000,0000,0000,,Хэхе…
Dialogue: 0,0:15:46.45,0:15:49.45,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:15:46.45,0:15:49.45,Default,,0000,0000,0000,,Бірақ мен қызғанамын.
Dialogue: 0,0:15:49.45,0:15:54.46,Default,,0000,0000,0000,,Өзімшіл, бірақ кедергісіз
Dialogue: 0,0:15:49.45,0:15:54.46,Default,,0000,0000,0000,,Рұқсат етілген
Dialogue: 0,0:15:54.46,0:15:58.46,Default,,0000,0000,0000,,Менің жүрегімнің ортасында
Dialogue: 0,0:15:54.46,0:15:58.46,Default,,0000,0000,0000,,Хитклифф
Dialogue: 0,0:15:58.46,0:16:03.47,Default,,0000,0000,0000,,Ол сонда болса болды
Dialogue: 0,0:15:58.46,0:16:03.47,Default,,0000,0000,0000,,Мен өмір сүремін
Dialogue: 0,0:16:03.47,0:16:06.47,Default,,0000,0000,0000,,Бұл өзімшіл, бәрі.
Dialogue: 0,0:16:08.47,0:16:11.48,Default,,0000,0000,0000,,(ｷｬｻﾘﾝ)
Dialogue: 0,0:16:08.47,0:16:11.48,Default,,0000,0000,0000,,Хитклифф - өзіммін...｡➡
Dialogue: 0,0:16:11.48,0:16:14.48,Default,,0000,0000,0000,,Мен Хитклиффпін
Dialogue: 0,0:16:14.48,0:16:17.48,Default,,0000,0000,0000,,Маған ұнамайды.
Dialogue: 0,0:16:19.48,0:16:21.49,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:16:21.49,0:16:25.42,Default,,0000,0000,0000,,Кэтрин
Dialogue: 0,0:16:21.49,0:16:25.42,Default,,0000,0000,0000,,Сіз қатыгез және арамсыз.➡
Dialogue: 0,0:16:25.42,0:16:31.43,Default,,0000,0000,0000,,Неге өз жүрегіңе бағынбадың?
Dialogue: 0,0:16:25.42,0:16:31.43,Default,,0000,0000,0000,,Мені неге тастап кеттің?
Dialogue: 0,0:16:31.43,0:16:34.43,Default,,0000,0000,0000,,Сен де мені таста
Dialogue: 0,0:16:31.43,0:16:34.43,Default,,0000,0000,0000,,Мен бір жерге бардым
Dialogue: 0,0:16:34.43,0:16:41.44,Default,,0000,0000,0000,,Бірақ мен сені кешіремін
Dialogue: 0,0:16:34.43,0:16:41.44,Default,,0000,0000,0000,,Сондықтан мені де кешіріңіз.
Dialogue: 0,0:16:41.44,0:16:44.44,Default,,0000,0000,0000,,Ол өзімшіл әйел.
Dialogue: 0,0:16:41.44,0:16:44.44,Default,,0000,0000,0000,,Тыныш
Dialogue: 0,0:16:44.44,0:16:46.44,Default,,0000,0000,0000,,(ﾋｰｽｸﾘﾌ)
Dialogue: 0,0:16:44.44,0:16:46.44,Default,,0000,0000,0000,,Кэтрин. Мықты бол.
Dialogue: 0,0:16:46.44,0:16:51.45,Default,,0000,0000,0000,,А, мен Хизер төбелерін көріп тұрмын.
Dialogue: 0,0:16:51.45,0:16:54.45,Default,,0000,0000,0000,,Күте тұрыңыз... Хитклифф
Dialogue: 0,0:16:56.45,0:16:59.46,Default,,0000,0000,0000,,Кэтрин…｡➡
Dialogue: 0,0:16:59.46,0:17:01.46,Default,,0000,0000,0000,,Кэтрин
Dialogue: 0,0:17:03.46,0:17:06.46,Default,,0000,0000,0000,,Мен сені өлтірдім
Dialogue: 0,0:17:06.46,0:17:10.47,Default,,0000,0000,0000,,Ендеше кел, мен болып бетперде бол.
Dialogue: 0,0:17:06.46,0:17:10.47,Default,,0000,0000,0000,,Кез келген пішін жақсы.➡
Dialogue: 0,0:17:10.47,0:17:14.47,Default,,0000,0000,0000,,барлығы дерлік өлімге ұшырауға жақын қалды, бұл менің кінәм.
Dialogue: 0,0:17:10.47,0:17:14.47,Default,,0000,0000,0000,,Мені жалғыз қалдырмаңыз
Dialogue: 0,0:17:16.47,0:17:21.47,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:17:35.43,0:17:40.43,Default,,0000,0000,0000,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:17:46.44,0:17:51.44,Default,,0000,0000,0000,,[Майк] (Хабарландыру) Барлық жоғары сынып оқушыларына
Dialogue: 0,0:17:46.44,0:17:51.44,Default,,0000,0000,0000,,Тағы бір үлкен шапалақ!
Dialogue: 0,0:17:51.44,0:17:53.44,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:51.44,0:17:53.44,Default,,0000,0000,0000,,Мен хат жібергім келеді…
Dialogue: 0,0:18:04.46,0:18:07.46,Default,,0000,0000,0000,,А, бітті.
Dialogue: 0,0:18:12.46,0:18:14.47,Rubi,,0000,0000,0000,,Босдық
Dialogue: 0,0:18:12.46,0:18:14.47,Default,,0000,0000,0000,,Баршаңызға жақсы жұмыс
Dialogue: 0,0:18:14.47,0:18:16.47,Default,,0000,0000,0000,,Кагами Сенсей
Dialogue: 0,0:18:16.47,0:18:18.47,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:18.47,0:18:21.47,Default,,0000,0000,0000,,Сіз гүлдермен келдіңіз.
Dialogue: 0,0:18:18.47,0:18:21.47,Default,,0000,0000,0000,,Қулық
Dialogue: 0,0:18:21.47,0:18:23.47,Default,,0000,0000,0000,,Сен дұрыс қарадың ба?
Dialogue: 0,0:18:23.47,0:18:26.41,Default,,0000,0000,0000,,Әрине
Dialogue: 0,0:18:23.47,0:18:26.41,Default,,0000,0000,0000,,Барлығы өте керемет болды
Dialogue: 0,0:18:26.41,0:18:31.42,Default,,0000,0000,0000,,Сіз тамаша жұмыс жасадыңыз. Тамаша Тамаша
Dialogue: 0,0:18:26.41,0:18:31.42,Default,,0000,0000,0000,,Қазірдің өзінде! бала сияқты
Dialogue: 0,0:18:31.42,0:18:33.42,Default,,0000,0000,0000,,Хаха...
Dialogue: 0,0:18:36.42,0:18:39.42,Default,,0000,0000,0000,,Сугимото да тамаша жұмыс жасады.
Dialogue: 0,0:18:39.42,0:18:42.42,Default,,0000,0000,0000,,Не болды, мырза Мокки!
Dialogue: 0,0:18:39.42,0:18:42.42,Default,,0000,0000,0000,,Сугимото ерекше қызметі үшін марапат.
Dialogue: 0,0:18:44.43,0:18:46.43,Default,,0000,0000,0000,,Рахмет
Dialogue: 0,0:18:44.43,0:18:46.43,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:50.43,0:18:52.43,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:18:54.44,0:18:58.44,Default,,0000,0000,0000,,Иә. Тамаша.
Dialogue: 0,0:19:01.45,0:19:06.45,Default,,0000,0000,0000,,Жоқ. Сугимото жылап жатыр.
Dialogue: 0,0:19:06.45,0:19:26.40,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:19:26.40,0:19:30.41,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:19:30.41,0:19:35.41,Default,,0000,0000,0000,,Біртүрлі нәрсе көрінді
Dialogue: 0,0:19:30.41,0:19:35.41,Default,,0000,0000,0000,,Бұл таңқаларлық емес.
Dialogue: 0,0:19:35.41,0:19:39.42,Default,,0000,0000,0000,,Бұл біртүрлі. Мүмкін емес.
Dialogue: 0,0:19:39.42,0:19:42.42,Default,,0000,0000,0000,,(Толғанған бастауыш сынып оқушыларының дыбыстары)
Dialogue: 0,0:19:42.42,0:19:45.42,Default,,0000,0000,0000,,Аға
Dialogue: 0,0:19:42.42,0:19:45.42,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:45.42,0:19:50.43,Default,,0000,0000,0000,,Кенже
Dialogue: 0,0:19:45.42,0:19:50.43,Default,,0000,0000,0000,,Мен бұл туралы бұрын да ойладым
Dialogue: 0,0:19:50.43,0:19:53.43,Default,,0000,0000,0000,,Маған емес, үлкендерге.
Dialogue: 0,0:19:50.43,0:19:53.43,Default,,0000,0000,0000,,Басқа...
Dialogue: 0,0:19:55.43,0:19:58.43,Default,,0000,0000,0000,,Маған ұнайтын адам бар, сондықтан...
Dialogue: 0,0:20:00.44,0:20:02.44,Default,,0000,0000,0000,,Фуми білгісі келеді ме?
Dialogue: 0,0:20:04.44,0:20:07.44,Default,,0000,0000,0000,,Білгім келмейді, бірақ мен қызықпын.
Dialogue: 0,0:20:09.45,0:20:11.45,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:20:13.45,0:20:16.45,Default,,0000,0000,0000,,Бұл өткен шақ.
Dialogue: 0,0:20:13.45,0:20:16.45,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:20:18.46,0:20:20.46,Default,,0000,0000,0000,,Маған қатты ұнады.➡
Dialogue: 0,0:20:20.46,0:20:25.46,Default,,0000,0000,0000,,Тек мен сені сүйемін
Dialogue: 0,0:20:20.46,0:20:25.46,Default,,0000,0000,0000,,Барлығы осы болды.
Dialogue: 0,0:20:28.40,0:20:31.40,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:20:28.40,0:20:31.40,Default,,0000,0000,0000,,Фумиге опасыздық жасап жатырсың ба?
Dialogue: 0,0:20:31.40,0:20:35.40,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:20:31.40,0:20:35.40,Default,,0000,0000,0000,,Осыны айтып тұрсыз...
Dialogue: 0,0:20:41.41,0:20:45.42,Default,,0000,0000,0000,,Иә. Ертеңнен бері көп уақыт өтті.
Dialogue: 0,0:20:41.41,0:20:45.42,Default,,0000,0000,0000,,Мен баскетбол клубының менеджері боламын.
Dialogue: 0,0:20:45.42,0:20:48.42,Default,,0000,0000,0000,,Сіз мені көруге келе аласыз ба?
Dialogue: 0,0:20:45.42,0:20:48.42,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:20:50.42,0:20:53.42,Default,,0000,0000,0000,,Үйге қайт Фуми
Dialogue: 0,0:20:53.42,0:20:55.43,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:20:55.43,0:21:07.43,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:10.44,0:21:15.45,Default,,0000,0000,0000,,♬『ｾﾝﾃｨﾌｫﾘｱ』
Dialogue: 0,0:21:15.45,0:21:19.45,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:19.45,0:21:24.45,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:24.45,0:21:38.47,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:38.47,0:21:43.47,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:43.47,0:21:53.48,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:53.48,0:21:58.49,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:58.49,0:22:16.51,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:22:16.51,0:22:22.51,Default,,0000,0000,0000,,♬～
