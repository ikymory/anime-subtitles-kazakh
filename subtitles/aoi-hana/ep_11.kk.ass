Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.48,0:00:07.48,Default,,0,0,0,,Сакико
Dialogue: 0,0:00:05.48,0:00:07.48,Default,,0,0,0,,А-чан, оян.
Dialogue: 0,0:00:07.48,0:00:09.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:13.49,0:00:16.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:13.49,0:00:16.49,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:00:16.49,0:00:18.49,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:00:18.49,0:00:21.49,Default,,0,0,0,,Мен қыстық киімімді сонда қалдырдым.
Dialogue: 0,0:00:18.49,0:00:21.49,Default,,0,0,0,,≪(есік жабылу дыбысы)
Dialogue: 0,0:00:23.50,0:00:25.50,Default,,0,0,0,,Қысқы киім?
Dialogue: 0,0:00:27.50,0:00:29.50,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:00:29.50,0:00:33.50,Default,,0,0,0,,Киімді ауыстыру…｡ Күрсіну…
Dialogue: 0,0:00:36.51,0:00:41.52,Default,,0,0,0,,Көк
Dialogue: 0,0:00:36.51,0:00:41.52,Default,,0,0,0,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:00:36.51,0:00:41.52,Default,,0,0,0,,♬『Көк гүл』
Dialogue: 0,0:00:41.52,0:00:51.53,Default,,0,0,0,,♬～
Dialogue: 0,0:00:51.53,0:01:00.47,Default,,0,0,0,,♬～
Dialogue: 0,0:01:00.47,0:01:20.49,Default,,0,0,0,,♬～
Dialogue: 0,0:01:20.49,0:01:40.51,Default,,0,0,0,,♬～
Dialogue: 0,0:01:40.51,0:01:53.51,Default,,0,0,0,,♬～
Dialogue: 0,0:02:07.47,0:02:12.47,Default,,0,0,0,,Иә, сол – қамыр жағылған.
Dialogue: 0,0:02:07.47,0:02:12.47,Default,,0,0,0,,Екі рет ұйықтау және кешіктіру
Dialogue: 0,0:02:07.47,0:02:12.47,Default,,0,0,0,,Сіз бастауыш сынып оқушысысыз ба?
Dialogue: 0,0:02:12.47,0:02:14.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:14.48,0:02:18.48,Default,,0,0,0,,Айтпақшы, мен сені мектепке апарайын ба?
Dialogue: 0,0:02:14.48,0:02:18.48,Default,,0,0,0,,Вокзалға дейін.
Dialogue: 0,0:02:21.48,0:02:24.49,Default,,0,0,0,,≪Фуми-чан!
Dialogue: 0,0:02:21.48,0:02:24.49,Default,,0,0,0,,Ах
Dialogue: 0,0:02:24.49,0:02:26.49,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:26.49,0:02:31.49,Default,,0,0,0,,Мен ұйықтап қалып, ағама айттым
Dialogue: 0,0:02:26.49,0:02:31.49,Default,,0,0,0,,Мені көлікпен жіберді.
Dialogue: 0,0:02:31.49,0:02:33.49,Default,,0,0,0,,Мен солай деп ойладым.
Dialogue: 0,0:02:44.51,0:02:47.51,Default,,0,0,0,,Күз келген сияқты, солай ма?
Dialogue: 0,0:02:47.51,0:02:49.51,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:02:56.53,0:02:59.45,Default,,0,0,0,,Биылғы жаз қысқа болды, солай емес пе?
Dialogue: 0,0:02:59.45,0:03:03.46,Default,,0,0,0,,бір нәрсені тез
Dialogue: 0,0:02:59.45,0:03:03.46,Default,,0,0,0,,Бәрі біткен сияқты
Dialogue: 0,0:03:03.46,0:03:05.46,Default,,0,0,0,,Осы мақсатқа жету үшін бәрін қолданамыз — Титан күшін де, сенің қаруларыңды да. ➡
Dialogue: 0,0:03:05.46,0:03:25.48,Default,,0,0,0,,♬～
Dialogue: 0,0:03:25.48,0:03:33.49,Default,,0,0,0,,♬～
Dialogue: 0,0:03:33.49,0:03:35.49,Default,,0,0,0,,Сіз кітаптарды ауыстырып жатырсыз ба?
Dialogue: 0,0:03:35.49,0:03:39.49,Default,,0,0,0,,Иә, кітапханада.
Dialogue: 0,0:03:35.49,0:03:39.49,Default,,0,0,0,,Ескі кітаптарды кәдеге жарату
Dialogue: 0,0:03:39.49,0:03:41.50,Default,,0,0,0,,Тек кітапханашылар
Dialogue: 0,0:03:39.49,0:03:41.50,Default,,0,0,0,,Себебі қолымыз жетпейді➡
Dialogue: 0,0:03:41.50,0:03:44.50,Default,,0,0,0,,Біз әрқашан
Dialogue: 0,0:03:41.50,0:03:44.50,Default,,0,0,0,,Мені итеріп жіберді.➡
Dialogue: 0,0:03:44.50,0:03:47.50,Default,,0,0,0,,Кітап сөресінен тауып алсаңыз
Dialogue: 0,0:03:44.50,0:03:47.50,Default,,0,0,0,,Оны қорапқа салыңыз.➡
Dialogue: 0,0:03:47.50,0:03:50.50,Default,,0,0,0,,Манджуме
Dialogue: 0,0:03:47.50,0:03:50.50,Default,,0,0,0,,Манжоме мырза
Dialogue: 0,0:03:47.50,0:03:50.50,Default,,0,0,0,,Әлем әдебиеті.
Dialogue: 0,0:03:50.50,0:03:53.51,Default,,0,0,0,,Кітаптар тізімі
Dialogue: 0,0:03:50.50,0:03:53.51,Default,,0,0,0,,Несие бойынша болса ше?
Dialogue: 0,0:03:53.51,0:03:56.48,Default,,0,0,0,,Бұл кітап атауының басында.
Dialogue: 0,0:03:53.51,0:03:56.48,Default,,0,0,0,,Себебі оның ➡ жұлдызшасы бар
Dialogue: 0,0:03:56.48,0:03:58.48,Default,,0,0,0,,Іздеудің қажеті жоқ
Dialogue: 0,0:04:08.36,0:04:12.36,Default,,0,0,0,,Хиро
Dialogue: 0,0:04:08.36,0:04:12.36,Default,,0,0,0,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:04:08.36,0:04:12.36,Default,,0,0,0,,Теңіз
Dialogue: 0,0:04:08.36,0:04:12.36,Default,,0,0,0,,«Балдырлардың кең теңізі»…｡ «Балдырлардың кең теңізі»
Dialogue: 0,0:04:12.36,0:04:15.36,Default,,0,0,0,,Хмм...｡ О, мінеки болды.
Dialogue: 0,0:04:15.36,0:04:17.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:22.37,0:04:26.37,Default,,0,0,0,,Фудзин
Dialogue: 0,0:04:22.37,0:04:26.37,Default,,0,0,0,,«Миссис Даллоуэй»
Dialogue: 0,0:04:22.37,0:04:26.37,Default,,0,0,0,,«Миссис Даллоуэй»…
Dialogue: 0,0:04:32.38,0:04:34.38,Default,,0,0,0,,Ясуко
Dialogue: 0,0:04:32.38,0:04:34.38,Default,,0,0,0,,《Онда жүрегіңді дайында.➡
Dialogue: 0,0:04:34.38,0:04:36.38,Default,,0,0,0,,Терең тыныс алыңыз》
Dialogue: 0,0:04:47.40,0:04:50.40,Default,,0,0,0,,Йоко
Dialogue: 0,0:04:47.40,0:04:50.40,Default,,0,0,0,,Манжоме-сан, мен қолдарымды тыныға алмаймын.
Dialogue: 0,0:04:50.40,0:04:53.40,Default,,0,0,0,,Кешіріңіз! иә?
Dialogue: 0,0:04:53.40,0:04:57.44,Default,,0,0,0,,(Йоко)
Dialogue: 0,0:04:53.40,0:04:57.44,Default,,0,0,0,,Қолдарыңыздың демалуына жол бермеңіз.
Dialogue: 0,0:04:57.44,0:05:01.44,Default,,0,0,0,,Мива
Dialogue: 0,0:04:57.44,0:05:01.44,Default,,0,0,0,,Міне, мен ұсталдым!
Dialogue: 0,0:04:57.44,0:05:01.44,Default,,0,0,0,,Мисако
Dialogue: 0,0:04:57.44,0:05:01.44,Default,,0,0,0,,Пон-чан жақсы!
Dialogue: 0,0:05:01.44,0:05:04.45,Default,,0,0,0,,Қорқынышты!
Dialogue: 0,0:05:01.44,0:05:04.45,Default,,0,0,0,,Мен Манджоме-санға қарап тұрғанда...
Dialogue: 0,0:05:04.45,0:05:06.45,Default,,0,0,0,,Мен сені мазақ еткім келеді.
Dialogue: 0,0:05:06.45,0:05:10.45,Default,,0,0,0,,Балалар сендер тым көп екенсіңдер
Dialogue: 0,0:05:06.45,0:05:10.45,Default,,0,0,0,,Жұмысты бұзбау.
Dialogue: 0,0:05:10.45,0:05:12.45,Default,,0,0,0,,Иә
Dialogue: 0,0:05:12.45,0:05:16.46,Default,,0,0,0,,Бұл шығарма әдебиет үйірмесі салығы.
Dialogue: 0,0:05:12.45,0:05:16.46,Default,,0,0,0,,Маған қоңырау шалып жатқаныңызды естідім.
Dialogue: 0,0:05:16.46,0:05:18.46,Default,,0,0,0,,Салық?
Dialogue: 0,0:05:18.46,0:05:22.46,Default,,0,0,0,,Қараңдаршы, әдебиет үйірмесі кітапханада.
Dialogue: 0,0:05:18.46,0:05:22.46,Default,,0,0,0,,Қолдану жиілігі керемет.
Dialogue: 0,0:05:22.46,0:05:26.47,Default,,0,0,0,,Уақыт пен күш қажет
Dialogue: 0,0:05:22.46,0:05:26.47,Default,,0,0,0,,Неліктен сізден айырбастау операцияларына көмектесуіңізді сұрайды?
Dialogue: 0,0:05:26.47,0:05:31.47,Default,,0,0,0,,Біз, драма үйірмесі, алатын кітап жоқ.
Dialogue: 0,0:05:26.47,0:05:31.47,Default,,0,0,0,,Бұл жақсы, өйткені ол шектеулі.
Dialogue: 0,0:05:31.47,0:05:34.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:34.48,0:05:38.48,Default,,0,0,0,,Каори
Dialogue: 0,0:05:34.48,0:05:38.48,Default,,0,0,0,,Келесі театр фестивалінің бағдарламасы
Dialogue: 0,0:05:34.48,0:05:38.48,Default,,0,0,0,,Осылардың ішінен таңдаңыз.➡
Dialogue: 0,0:05:38.48,0:05:40.48,Default,,0,0,0,,Жаңа жылда дауыс беру арқылы шешеміз➡
Dialogue: 0,0:05:40.48,0:05:42.48,Default,,0,0,0,,Осы жыл ішінде
Dialogue: 0,0:05:40.48,0:05:42.48,Default,,0,0,0,,үшінн оқу
Dialogue: 0,0:05:42.48,0:05:46.49,Default,,0,0,0,,Бірінші курс студенттері келесі жылы да болады.
Dialogue: 0,0:05:42.48,0:05:46.49,Default,,0,0,0,,Себебі сіз сахнада боласыз➡
Dialogue: 0,0:05:46.49,0:05:49.49,Default,,0,0,0,,Өзіңіз әрекет етіп жатқандай әрекет етіңіз
Dialogue: 0,0:05:46.49,0:05:49.49,Default,,0,0,0,,Оқыңыз
Dialogue: 0,0:05:49.49,0:05:51.49,Default,,0,0,0,,Иә
Dialogue: 0,0:05:51.49,0:05:53.49,Default,,0,0,0,,Өйткені біз бітіреміз➡
Dialogue: 0,0:05:53.49,0:05:56.48,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:05:53.49,0:05:56.48,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:56.48,0:05:59.43,Default,,0,0,0,,Мұндай жауапсыз пікірлер
Dialogue: 0,0:05:56.48,0:05:59.43,Default,,0,0,0,,елемеу
Dialogue: 0,0:05:59.43,0:06:02.43,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:06:06.44,0:06:08.44,Default,,0,0,0,,Казуза
Dialogue: 0,0:06:06.44,0:06:08.44,Default,,0,0,0,,(Васа)
Dialogue: 0,0:06:06.44,0:06:08.44,Default,,0,0,0,,《Композиция жақсы жасалған деп ойлаймын.➡
Dialogue: 0,0:06:08.44,0:06:12.45,Default,,0,0,0,,Содан кейін заттың бар екендігі сезілетініне көз жеткізіңіз.
Dialogue: 0,0:06:08.44,0:06:12.45,Default,,0,0,0,,Батыл сурет салыңыз》
Dialogue: 0,0:06:12.45,0:06:14.45,Default,,0,0,0,,Киоко
Dialogue: 0,0:06:12.45,0:06:14.45,Default,,0,0,0,,《Иә》
Dialogue: 0,0:06:12.45,0:06:14.45,Default,,0,0,0,,Каштан
Dialogue: 0,0:06:12.45,0:06:14.45,Default,,0,0,0,,《Аса! ➡
Dialogue: 0,0:06:14.45,0:06:16.45,Default,,0,0,0,,Телефонға жауап бересіз бе? ➡
Dialogue: 0,0:06:16.45,0:06:21.46,Default,,0,0,0,,Басқа адам ағылшын тілінде сөйлейді, сондықтан мен мұны өзім істей алмаймын.
Dialogue: 0,0:06:16.45,0:06:21.46,Default,,0,0,0,,Менің ойымша, бұл Киокидің шетелде оқуы туралы.
Dialogue: 0,0:06:21.46,0:06:24.46,Default,,0,0,0,,《О? 》
Dialogue: 0,0:06:21.46,0:06:24.46,Default,,0,0,0,,《Оған көмектесу мүмкін емес.➡
Dialogue: 0,0:06:24.46,0:06:26.46,Default,,0,0,0,,Сәлем…》
Dialogue: 0,0:06:28.46,0:06:30.46,Default,,0,0,0,,《Мм...》
Dialogue: 0,0:06:28.46,0:06:30.46,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:06:30.46,0:06:33.47,Default,,0,0,0,,Сугимото
Dialogue: 0,0:06:30.46,0:06:33.47,Default,,0,0,0,,《Сугимото Сенпай
Dialogue: 0,0:06:30.46,0:06:33.47,Default,,0,0,0,,Шетелге барасыз ба? 》
Dialogue: 0,0:06:33.47,0:06:36.47,Default,,0,0,0,,《Ол бір күні жария болады.
Dialogue: 0,0:06:33.47,0:06:36.47,Default,,0,0,0,,Менің ойымша➡
Dialogue: 0,0:06:36.47,0:06:38.47,Default,,0,0,0,,Біраз уақыт үндемей тұра аласыз ба? ➡
Dialogue: 0,0:06:38.47,0:06:42.47,Default,,0,0,0,,Ол белгілі
Dialogue: 0,0:06:38.47,0:06:42.47,Default,,0,0,0,,Себебі бұл сізге ұнамайды деп ойлаймын》
Dialogue: 0,0:06:50.48,0:06:52.48,Default,,0,0,0,,Ах
Dialogue: 0,0:06:54.49,0:06:56.42,Default,,0,0,0,,Ах
Dialogue: 0,0:06:54.49,0:06:56.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:56.42,0:07:16.44,Default,,0,0,0,,♬～
Dialogue: 0,0:07:16.44,0:07:22.45,Default,,0,0,0,,♬～
Dialogue: 0,0:07:31.46,0:07:33.46,Default,,0,0,0,,Ах
Dialogue: 0,0:07:41.47,0:07:43.47,Default,,0,0,0,,≪Фуми-чан
Dialogue: 0,0:07:49.48,0:07:51.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:51.48,0:07:55.48,Default,,0,0,0,,Осы уақытқа дейін, шынымен
Dialogue: 0,0:07:51.48,0:07:55.48,Default,,0,0,0,,Мен өзімді ұшырып жібердім деп ойладым.
Dialogue: 0,0:07:55.48,0:07:57.42,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:57.42,0:07:59.42,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:07:59.42,0:08:03.42,Default,,0,0,0,,Коммутаторды басқандай сезім
Dialogue: 0,0:07:59.42,0:08:03.42,Default,,0,0,0,,Менің ауысуға мүмкіндігім жоқ.
Dialogue: 0,0:08:03.42,0:08:06.43,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:06.43,0:08:11.43,Default,,0,0,0,,Өзіңізге қамқорлық
Dialogue: 0,0:08:06.43,0:08:11.43,Default,,0,0,0,,Мен енді түсінбеймін
Dialogue: 0,0:08:11.43,0:08:15.44,Default,,0,0,0,,Фуми-чан. тамақ ішейік.
Dialogue: 0,0:08:11.43,0:08:15.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:15.44,0:08:18.44,Default,,0,0,0,,Мұндай кезде тамақ ішкен дұрыс.
Dialogue: 0,0:08:18.44,0:08:21.44,Default,,0,0,0,,Мен Монбланмын
Dialogue: 0,0:08:21.44,0:08:24.45,Default,,0,0,0,,Ал, мен алма бәлішімін.
Dialogue: 0,0:08:24.45,0:08:26.45,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:26.45,0:08:46.47,Default,,0,0,0,,♬～
Dialogue: 0,0:08:46.47,0:08:55.48,Default,,0,0,0,,♬～
Dialogue: 0,0:08:55.48,0:08:59.41,Default,,0,0,0,,Сугимото Сенпай деген кім?
Dialogue: 0,0:08:55.48,0:08:59.41,Default,,0,0,0,,Сіз шынымен де кез келген нәрсені жасай аласыз.➡
Dialogue: 0,0:08:59.41,0:09:01.42,Default,,0,0,0,,Мен саған тәнтімін
Dialogue: 0,0:09:01.42,0:09:05.42,Default,,0,0,0,,Сол Сугимото-сенпай
Dialogue: 0,0:09:01.42,0:09:05.42,Default,,0,0,0,,Сіз шетелде оқу туралы қауесетті естідіңіз бе?
Dialogue: 0,0:09:05.42,0:09:08.42,Default,,0,0,0,,Тыңдалған
Dialogue: 0,0:09:05.42,0:09:08.42,Default,,0,0,0,,Лондондағы университетке бару керек пе?
Dialogue: 0,0:09:08.42,0:09:12.42,Default,,0,0,0,,Өтірік! Шынайы ма?
Dialogue: 0,0:09:08.42,0:09:12.42,Default,,0,0,0,,Міне. Мен таң қалдым.
Dialogue: 0,0:09:15.43,0:09:19.43,Default,,0,0,0,,«Англияда
Dialogue: 0,0:09:15.43,0:09:19.43,Default,,0,0,0,,Сіздің шетелде оқитыныңызды естідім.➡
Dialogue: 0,0:09:19.43,0:09:23.44,Default,,0,0,0,,Бұл қарапайым сөз, бірақ
Dialogue: 0,0:09:19.43,0:09:23.44,Default,,0,0,0,,Оқуларыңызға сәттілік.➡
Dialogue: 0,0:09:23.44,0:09:27.44,Default,,0,0,0,,Жеке кездесу туралы айту
Dialogue: 0,0:09:23.44,0:09:27.44,Default,,0,0,0,,Мен жылап жіберуім мүмкін➡
Dialogue: 0,0:09:27.44,0:09:29.44,Default,,0,0,0,,Мен оны электрондық пошта арқылы жібердім.➡
Dialogue: 0,0:09:29.44,0:09:35.45,Default,,0,0,0,,Васа мырзаның сурет сабағы
Dialogue: 0,0:09:29.44,0:09:35.45,Default,,0,0,0,,Мен жалғастыруға ниеттімін. Киоко».
Dialogue: 0,0:09:35.45,0:09:49.46,Default,,0,0,0,,♬～
Dialogue: 0,0:09:49.46,0:09:52.47,Default,,0,0,0,,Рождество түні?
Dialogue: 0,0:09:49.46,0:09:52.47,Default,,0,0,0,,Иә
Dialogue: 0,0:09:52.47,0:09:54.47,Default,,0,0,0,,Мен жалықтым.
Dialogue: 0,0:09:54.47,0:09:56.49,Default,,0,0,0,,Мен де
Dialogue: 0,0:09:54.47,0:09:56.49,Default,,0,0,0,,(Фушигиро) Түпкі Дала жабылды! Арнайы сынып жойылды.
Dialogue: 0,0:09:56.49,0:09:58.41,Default,,0,0,0,,А-чан, бәріне қоңырау шалыңыз➡
Dialogue: 0,0:09:58.41,0:10:01.41,Default,,0,0,0,,Рождестволық кеш
Dialogue: 0,0:09:58.41,0:10:01.41,Default,,0,0,0,,Мен мұны істеуіңізді сұраймын.
Dialogue: 0,0:10:01.41,0:10:05.41,Default,,0,0,0,,О, жақсы. Содан кейін
Dialogue: 0,0:10:01.41,0:10:05.41,Default,,0,0,0,,Сонымен бірге сыйлықтармен алмасайық.
Dialogue: 0,0:10:05.41,0:10:07.41,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:10:07.41,0:10:10.42,Default,,0,0,0,,үшінның көңілі көтерілді
Dialogue: 0,0:10:07.41,0:10:10.42,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:10:10.42,0:10:12.42,Default,,0,0,0,,Жақсы
Dialogue: 0,0:10:12.42,0:10:15.42,Default,,0,0,0,,Икуми
Dialogue: 0,0:10:12.42,0:10:15.42,Default,,0,0,0,,Осымен Игуми мырза да келеді.
Dialogue: 0,0:10:12.42,0:10:15.42,Default,,0,0,0,,Бұл ең жақсысы.
Dialogue: 0,0:10:15.42,0:10:17.42,Default,,0,0,0,,Игуми мырза, келе алмайсыз ба?
Dialogue: 0,0:10:17.42,0:10:20.43,Default,,0,0,0,,Саваной
Dialogue: 0,0:10:17.42,0:10:20.43,Default,,0,0,0,,Саваной мырзамен
Dialogue: 0,0:10:17.42,0:10:20.43,Default,,0,0,0,,Уәде бар.
Dialogue: 0,0:10:20.43,0:10:23.43,Default,,0,0,0,,Мен көремін. Бұл біраз көңіл көншітеді.
Dialogue: 0,0:10:27.43,0:10:29.44,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:10:29.44,0:10:32.44,Default,,0,0,0,,Йоши
Dialogue: 0,0:10:29.44,0:10:32.44,Default,,0,0,0,,Фуми. Бір минут күтіңіз.➡
Dialogue: 0,0:10:32.44,0:10:34.44,Default,,0,0,0,,Чизу
Dialogue: 0,0:10:32.44,0:10:34.44,Default,,0,0,0,,Бұл Чизу-чаннан
Dialogue: 0,0:10:32.44,0:10:34.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:34.44,0:10:51.46,Default,,0,0,0,,♬～
Dialogue: 0,0:10:51.46,0:10:55.46,Default,,0,0,0,,(Кёки)
Dialogue: 0,0:10:51.46,0:10:55.46,Default,,0,0,0,,《Сәлем Фуми. Алғашқы махаббатыңыз есіңізде ме? ➡
Dialogue: 0,0:10:55.46,0:11:01.40,Default,,0,0,0,,Ең бірінші ғашық болған адам
Dialogue: 0,0:10:55.46,0:11:01.40,Default,,0,0,0,,Фуми есіңде ме? 》
Dialogue: 0,0:11:01.40,0:11:05.40,Default,,0,0,0,,Мен біріншімін
Dialogue: 0,0:11:01.40,0:11:05.40,Default,,0,0,0,,Мен ғашық болған адам...
Dialogue: 0,0:11:11.47,0:11:14.47,Default,,0,0,0,,☎
Dialogue: 0,0:11:14.47,0:11:17.47,Default,,0,0,0,,Окудаира
Dialogue: 0,0:11:14.47,0:11:17.47,Default,,0,0,0,,Иә, бұл Окудайра.
Dialogue: 0,0:11:17.47,0:11:20.47,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:11:17.47,0:11:20.47,Default,,0,0,0,,☎(Ясу) Мм, бұл Саваной.
Dialogue: 0,0:11:17.47,0:11:20.47,Default,,0,0,0,,Ясуши мырза?
Dialogue: 0,0:11:20.47,0:11:24.47,Default,,0,0,0,,☎(Ясу)Негізі мен бірдеңе сұрайын деп едім.
Dialogue: 0,0:11:20.47,0:11:24.47,Default,,0,0,0,,Бар
Dialogue: 0,0:11:27.48,0:11:31.49,Default,,0,0,0,,Мен кенеттен кешірім сұраймын.
Dialogue: 0,0:11:27.48,0:11:31.49,Default,,0,0,0,,Басқа жүгінетін ешкім жоқ
Dialogue: 0,0:11:31.49,0:11:34.49,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:31.49,0:11:34.49,Default,,0,0,0,,Менің де сауда жасауым керек еді.
Dialogue: 0,0:11:34.49,0:11:37.49,Default,,0,0,0,,Бірақ мен біраз уайымдап тұрмын.
Dialogue: 0,0:11:37.49,0:11:42.50,Default,,0,0,0,,Жарайды. Окухира-санның қалауы.
Dialogue: 0,0:11:37.49,0:11:42.50,Default,,0,0,0,,Таңдау мүлдем дұрыс.
Dialogue: 0,0:11:42.50,0:11:44.50,Default,,0,0,0,,Шынында ма?
Dialogue: 0,0:11:42.50,0:11:44.50,Default,,0,0,0,,Иә.➡
Dialogue: 0,0:11:44.50,0:11:48.50,Default,,0,0,0,,Мен нені таңдар едім
Dialogue: 0,0:11:44.50,0:11:48.50,Default,,0,0,0,,Өйткені мен оны тікелей көре аламын.
Dialogue: 0,0:11:48.50,0:11:51.50,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:48.50,0:11:51.50,Default,,0,0,0,,Мен өзіме сенімді емеспін, бірақ тырысамын
Dialogue: 0,0:11:57.51,0:12:00.51,Default,,0,0,0,,Хмм.
Dialogue: 0,0:12:00.51,0:12:02.51,Default,,0,0,0,,Ах
Dialogue: 0,0:12:07.52,0:12:10.52,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:12:07.52,0:12:10.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:14.46,0:12:17.46,Default,,0,0,0,,Бұл шынымен жақсы емес пе?
Dialogue: 0,0:12:17.46,0:12:22.47,Default,,0,0,0,,Жоқ. Менің ойымша, бұл жақсы.
Dialogue: 0,0:12:17.46,0:12:22.47,Default,,0,0,0,,Иә. Мен мұны істеймін.
Dialogue: 0,0:12:22.47,0:12:24.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:33.48,0:12:38.49,Default,,0,0,0,,Окудайра мырзадан сұрау дұрыс жауап болды.
Dialogue: 0,0:12:33.48,0:12:38.49,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:12:38.49,0:12:42.49,Default,,0,0,0,,Иә. Мен міндетті түрде таңдай алмаймын.
Dialogue: 0,0:12:38.49,0:12:42.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:42.49,0:12:45.49,Default,,0,0,0,,Жоқ. Мен мұны жаман мағынада айтып тұрған жоқпын...
Dialogue: 0,0:12:45.49,0:12:49.50,Default,,0,0,0,,Сізге ұнайды деп ойлаймын.
Dialogue: 0,0:12:49.50,0:12:51.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:51.50,0:12:54.50,Default,,0,0,0,,Бұл жақсы болар еді.
Dialogue: 0,0:12:54.50,0:12:58.51,Default,,0,0,0,,Ах
Dialogue: 0,0:12:54.50,0:12:58.51,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:12:58.51,0:13:00.51,Default,,0,0,0,,Ум, кешіріңіз.
Dialogue: 0,0:13:03.51,0:13:05.51,Default,,0,0,0,,Сіз осында қалғыңыз келетініне сенімдісіз бе?
Dialogue: 0,0:13:05.51,0:13:09.53,Default,,0,0,0,,Иә. Осы төңіректе
Dialogue: 0,0:13:05.51,0:13:09.53,Default,,0,0,0,,Менің бір ісім бар екенін еске түсіру
Dialogue: 0,0:13:09.53,0:13:12.45,Default,,0,0,0,,Дұрыс. Ендеше бүгінгі рахмет➡
Dialogue: 0,0:13:12.45,0:13:15.46,Default,,0,0,0,,Келесі жолы кездесеміз
Dialogue: 0,0:13:12.45,0:13:15.46,Default,,0,0,0,,Мен мұны істеуге рұқсат етемін.
Dialogue: 0,0:13:15.46,0:13:18.46,Default,,0,0,0,,Үйге бара жатқанда абай болыңыз
Dialogue: 0,0:13:15.46,0:13:18.46,Default,,0,0,0,,Иә
Dialogue: 0,0:13:27.47,0:13:29.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:31.47,0:13:34.47,Default,,0,0,0,,《Келесі жылы бұзу басталады...》
Dialogue: 0,0:13:45.49,0:13:49.49,Default,,0,0,0,,《Ясу-сан және А-чан
Dialogue: 0,0:13:45.49,0:13:49.49,Default,,0,0,0,,Мен кездесіп жүрген жоқпыз деп ойлаймын➡
Dialogue: 0,0:13:49.49,0:13:53.49,Default,,0,0,0,,Сіз кездесіп жүрген болсаңыз да
Dialogue: 0,0:13:49.49,0:13:53.49,Default,,0,0,0,,Мен қарсы емеспін.➡
Dialogue: 0,0:13:53.49,0:13:57.49,Default,,0,0,0,,Егер солай болса, айтыңыз
Dialogue: 0,0:13:53.49,0:13:57.49,Default,,0,0,0,,Сіз маған айтасыз деп ойлаймын...》
Dialogue: 0,0:14:03.50,0:14:08.50,Default,,0,0,0,,《I
Dialogue: 0,0:14:03.50,0:14:08.50,Default,,0,0,0,,Неге жасырдың?
Dialogue: 0,0:14:11.45,0:14:13.45,Default,,0,0,0,,≪(Крекер дыбысы)
Dialogue: 0,0:14:11.45,0:14:13.45,Default,,0,0,0,,О
Dialogue: 0,0:14:13.45,0:14:16.45,Default,,0,0,0,,Рождество мерекесімен!
Dialogue: 0,0:14:16.45,0:14:20.45,Default,,0,0,0,,Үшінші рет.
Dialogue: 0,0:14:16.45,0:14:20.45,Default,,0,0,0,,Қанша рет сынағаныңыз маңызды емес.
Dialogue: 0,0:14:20.45,0:14:22.46,Default,,0,0,0,,(Йоко)
Dialogue: 0,0:14:20.45,0:14:22.46,Default,,0,0,0,,Мен тағы бір торт алайын деп жатырмын.
Dialogue: 0,0:14:22.46,0:14:24.46,Default,,0,0,0,,(Мисако)
Dialogue: 0,0:14:22.46,0:14:24.46,Default,,0,0,0,,Аяз ата деп айта аламын ба?
Dialogue: 0,0:14:24.46,0:14:28.46,Default,,0,0,0,,Сіз оны жей аласыз ба?
Dialogue: 0,0:14:24.46,0:14:28.46,Default,,0,0,0,,Иә. Жарайды. Жарайды.
Dialogue: 0,0:14:28.46,0:14:31.47,Default,,0,0,0,,Ах. Ой... мен сені мазалап жүрмін.
Dialogue: 0,0:14:31.47,0:14:34.47,Default,,0,0,0,,Бұл бүгін
Dialogue: 0,0:14:31.47,0:14:34.47,Default,,0,0,0,,Шулы болуы мүмкін➡
Dialogue: 0,0:14:34.47,0:14:37.47,Default,,0,0,0,,Ол 2-3 сағатта аяқталады.
Dialogue: 0,0:14:37.47,0:14:40.47,Default,,0,0,0,,Көңілді сияқты
Dialogue: 0,0:14:37.47,0:14:40.47,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:14:40.47,0:14:44.48,Default,,0,0,0,,Жалғыз адам
Dialogue: 0,0:14:40.47,0:14:44.48,Default,,0,0,0,,Бейшара, аянышты
Dialogue: 0,0:14:44.48,0:14:48.48,Default,,0,0,0,,Мені бейшараға
Dialogue: 0,0:14:44.48,0:14:48.48,Default,,0,0,0,,Сізде сыйлықтар бар ма?
Dialogue: 0,0:14:48.48,0:14:51.49,Default,,0,0,0,,Мен саған кір жудым.
Dialogue: 0,0:14:48.48,0:14:51.49,Default,,0,0,0,,Суық.
Dialogue: 0,0:14:51.49,0:14:54.49,Default,,0,0,0,,Қараңыз. Сыйлығың жоқ па?
Dialogue: 0,0:14:54.49,0:14:58.49,Default,,0,0,0,,Жалғыз адамдарды жалғыз қалдырыңыз
Dialogue: 0,0:14:54.49,0:14:58.49,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:14:58.49,0:15:00.49,Default,,0,0,0,,Онда! Біртүрлі жанып кетпеңіз
Dialogue: 0,0:15:00.49,0:15:03.50,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:00.49,0:15:03.50,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:15:03.50,0:15:07.50,Default,,0,0,0,,Йошимичи
Dialogue: 0,0:15:03.50,0:15:07.50,Default,,0,0,0,,Неше адам бар?
Dialogue: 0,0:15:03.50,0:15:07.50,Default,,0,0,0,,Акира, барлығы 5 адам.
Dialogue: 0,0:15:07.50,0:15:11.44,Default,,0,0,0,,Үш әйел жиналса, ұят болады.
Dialogue: 0,0:15:07.50,0:15:11.44,Default,,0,0,0,,➡
Dialogue: 0,0:15:11.44,0:15:14.44,Default,,0,0,0,,5 әйелмен шулы ма?
Dialogue: 0,0:15:14.44,0:15:19.45,Default,,0,0,0,,Бұл қорқынышты нәрсе. Және
Dialogue: 0,0:15:14.44,0:15:19.45,Default,,0,0,0,,Мен шотқа кірмеймін бе?
Dialogue: 0,0:15:19.45,0:15:24.45,Default,,0,0,0,,Жоқ. Көрдіңіз бе... болды.
Dialogue: 0,0:15:19.45,0:15:24.45,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:15:24.45,0:15:28.46,Default,,0,0,0,,Ах! Бұл А Чан ба?
Dialogue: 0,0:15:24.45,0:15:28.46,Default,,0,0,0,,Кавайи
Dialogue: 0,0:15:28.46,0:15:32.46,Default,,0,0,0,,(Йоко)
Dialogue: 0,0:15:28.46,0:15:32.46,Default,,0,0,0,,Юбка өте ыстық көрінеді.
Dialogue: 0,0:15:32.46,0:15:36.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:32.46,0:15:36.46,Default,,0,0,0,,А-чан өте кішкентай
Dialogue: 0,0:15:36.46,0:15:40.47,Default,,0,0,0,,Кішкентайы - Фуми-чан.
Dialogue: 0,0:15:36.46,0:15:40.47,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:15:40.47,0:15:44.47,Default,,0,0,0,,Не?! Ха...
Dialogue: 0,0:15:46.47,0:15:48.48,Default,,0,0,0,,Егер ол өзгерсе, ол өзгереді.
Dialogue: 0,0:15:48.48,0:15:53.48,Default,,0,0,0,,Менде кіру рәсімінен фотосурет бар, оны көргің келе ме?
Dialogue: 0,0:15:48.48,0:15:53.48,Default,,0,0,0,,қараңыз, қараңыз
Dialogue: 0,0:15:53.48,0:15:55.48,Default,,0,0,0,,Иә
Dialogue: 0,0:15:53.48,0:15:55.48,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:16:01.49,0:16:03.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:09.51,0:16:13.43,Default,,0,0,0,,Мектеп ғимараты ағаштан жасалған, солай ма?
Dialogue: 0,0:16:09.51,0:16:13.43,Default,,0,0,0,,Иә, бірақ келесі жылы бұзылады.
Dialogue: 0,0:16:13.43,0:16:17.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:13.43,0:16:17.43,Default,,0,0,0,,Жаңа мектеп ғимараты салынады.
Dialogue: 0,0:16:20.44,0:16:23.44,Default,,0,0,0,,Иә. Бұл жақсы емес пе?
Dialogue: 0,0:16:23.44,0:16:25.45,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:16:25.45,0:16:27.45,Default,,0,0,0,,Бұл сәл қарапайым болды ма?
Dialogue: 0,0:16:27.45,0:16:31.45,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:16:27.45,0:16:31.45,Default,,0,0,0,,Мен де ересекпін.
Dialogue: 0,0:16:31.45,0:16:34.45,Default,,0,0,0,,Ересек
Dialogue: 0,0:16:38.46,0:16:43.46,Default,,0,0,0,,(Киоконың күлкісі)
Dialogue: 0,0:16:43.46,0:16:45.47,Default,,0,0,0,,Сәлем Ясу-чан
Dialogue: 0,0:16:45.47,0:16:48.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:45.47,0:16:48.47,Default,,0,0,0,,Мен сізден бір нәрсе сұрағым келеді...
Dialogue: 0,0:16:48.47,0:16:50.47,Default,,0,0,0,,[℡] (Электрондық пошта қоңырау үні)
Dialogue: 0,0:16:48.47,0:16:50.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:50.47,0:16:53.47,Default,,0,0,0,,(Мисако)
Dialogue: 0,0:16:50.47,0:16:53.47,Default,,0,0,0,,Менің дыбыс өшіргішім қайда?
Dialogue: 0,0:16:53.47,0:16:56.48,Default,,0,0,0,,Үстелдің астында не бар?
Dialogue: 0,0:16:53.47,0:16:56.48,Default,,0,0,0,,Мен оны көрдім. Бірақ жоқ.
Dialogue: 0,0:16:56.48,0:17:00.48,Default,,0,0,0,,Әй... Мен сөйлестім.
Dialogue: 0,0:16:56.48,0:17:00.48,Default,,0,0,0,,Не?
Dialogue: 0,0:17:00.48,0:17:04.48,Default,,0,0,0,,«Бұл көңілді сыйлық болды, сондықтан
Dialogue: 0,0:17:00.48,0:17:04.48,Default,,0,0,0,,Ясу-чанды сұрағанымда➡
Dialogue: 0,0:17:04.48,0:17:07.49,Default,,0,0,0,,Мен шындықты мойындадым
Dialogue: 0,0:17:04.48,0:17:07.49,Default,,0,0,0,,Рахмет.➡
Dialogue: 0,0:17:07.49,0:17:11.42,Default,,0,0,0,,Рождество мерекесі ＆ Жаңа жыл құтты болсын｣
Dialogue: 0,0:17:11.42,0:17:14.43,Default,,0,0,0,,«Шындықты мойындау» нені білдіреді?
Dialogue: 0,0:17:11.42,0:17:14.43,Default,,0,0,0,,Іс жүзінде...
Dialogue: 0,0:17:14.43,0:17:18.43,Default,,0,0,0,,О, мінекей!
Dialogue: 0,0:17:14.43,0:17:18.43,Default,,0,0,0,,Әй, жақсы, жақсы.
Dialogue: 0,0:17:18.43,0:17:20.43,Default,,0,0,0,,Иә, енді Ясанха!
Dialogue: 0,0:17:20.43,0:17:23.44,Default,,0,0,0,,≪(күлкі)
Dialogue: 0,0:17:20.43,0:17:23.44,Default,,0,0,0,,Ах
Dialogue: 0,0:17:23.44,0:17:27.44,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,0:17:23.44,0:17:27.44,Default,,0,0,0,,Не?
Dialogue: 0,0:17:27.44,0:17:31.44,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:17:27.44,0:17:31.44,Default,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:17:31.44,0:17:33.45,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:17:31.44,0:17:33.45,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:17:33.45,0:17:35.45,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:41.45,0:17:44.46,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:17:44.46,0:17:46.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:49.46,0:17:52.47,Default,,0,0,0,,Оу!
Dialogue: 0,0:17:49.46,0:17:52.47,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:17:52.47,0:17:57.47,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:17:52.47,0:17:57.47,Default,,0,0,0,,Жүр, тез кетейік. Асығыңыз, асығыңыз.
Dialogue: 0,0:17:57.47,0:18:00.47,Default,,0,0,0,,Ух, суық, суық
Dialogue: 0,0:17:57.47,0:18:00.47,Default,,0,0,0,,Сакико-сан｡➡
Dialogue: 0,0:18:00.47,0:18:02.48,Default,,0,0,0,,Сіз біреуін кие аласыз ба?
Dialogue: 0,0:18:00.47,0:18:02.48,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:18:02.48,0:18:04.48,Default,,0,0,0,,Қазір қыс!
Dialogue: 0,0:18:04.48,0:18:07.48,Default,,0,0,0,,Мен бұл жерде мойындау деп ойламадым.
Dialogue: 0,0:18:07.48,0:18:13.42,Default,,0,0,0,,Мотеги
Dialogue: 0,0:18:07.48,0:18:13.42,Default,,0,0,0,,Моги-сан, бұл керемет.
Dialogue: 0,0:18:07.48,0:18:13.42,Default,,0,0,0,,Мұның несі жақсы?
Dialogue: 0,0:18:13.42,0:18:16.42,Default,,0,0,0,,Шамдарды өшіріңіз
Dialogue: 0,0:18:13.42,0:18:16.42,Default,,0,0,0,,Иә
Dialogue: 0,0:18:16.42,0:18:21.43,Default,,0,0,0,,♬『ｾﾝﾃｨﾌｫﾘｱ』
Dialogue: 0,0:18:21.43,0:18:32.44,Default,,0,0,0,,♬～
Dialogue: 0,0:18:32.44,0:18:36.44,Default,,0,0,0,,♬～
Dialogue: 0,0:18:36.44,0:18:52.46,Default,,0,0,0,,♬～
Dialogue: 0,0:18:52.46,0:18:59.46,Default,,0,0,0,,♬～
Dialogue: 0,0:19:02.47,0:19:04.47,Default,,0,0,0,,Ұйықтау мүмкін емес пе?
Dialogue: 0,0:19:02.47,0:19:04.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:04.47,0:19:08.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:04.47,0:19:08.48,Default,,0,0,0,,Әйтеуір, көзім бақырайып кетті.
Dialogue: 0,0:19:08.48,0:19:10.48,Default,,0,0,0,,Негізі мен де
Dialogue: 0,0:19:13.41,0:19:15.42,Default,,0,0,0,,Ах
Dialogue: 0,0:19:13.41,0:19:15.42,Default,,0,0,0,,Ах
Dialogue: 0,0:19:15.42,0:19:18.42,Default,,0,0,0,,Үйіліп жатыр!
Dialogue: 0,0:19:15.42,0:19:18.42,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:19:18.42,0:19:20.42,Default,,0,0,0,,Бұл ақ Рождество.
Dialogue: 0,0:19:20.42,0:19:23.42,Default,,0,0,0,,Сәлем А-чан
Dialogue: 0,0:19:20.42,0:19:23.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:27.43,0:19:32.43,Default,,0,0,0,,Біраз уақыт өтті
Dialogue: 0,0:19:27.43,0:19:32.43,Default,,0,0,0,,Мен бұл саябаққа жиі келетінмін.
Dialogue: 0,0:19:32.43,0:19:37.44,Default,,0,0,0,,Фуми-чан, жақсы есіңе түсірдің.
Dialogue: 0,0:19:32.43,0:19:37.44,Default,,0,0,0,,Бұл... жақсы...
Dialogue: 0,0:19:37.44,0:19:42.44,Default,,0,0,0,,Дұрыс. Мұнда көшу күні
Dialogue: 0,0:19:37.44,0:19:42.44,Default,,0,0,0,,Фуми-чан үнемі жылап отырды➡
Dialogue: 0,0:19:42.44,0:19:46.45,Default,,0,0,0,,Бұл мәселе болды.
Dialogue: 0,0:19:42.44,0:19:46.45,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:46.45,0:19:51.45,Default,,0,0,0,,Иә, мен сені тыныштандырсам да.
Dialogue: 0,0:19:46.45,0:19:51.45,Default,,0,0,0,,Мен мүлде жылауымды тоқтатқан жоқпын.
Dialogue: 0,0:19:51.45,0:19:55.46,Default,,0,0,0,,есімде жоқ.
Dialogue: 0,0:19:51.45,0:19:55.46,Default,,0,0,0,,А, сен сондай ақымақсың.
Dialogue: 0,0:19:55.46,0:19:58.46,Default,,0,0,0,,Бұл ақымақ емес.
Dialogue: 0,0:19:55.46,0:19:58.46,Default,,0,0,0,,Қазірдің өзінде! Фуми-чан
Dialogue: 0,0:19:58.46,0:20:00.46,Default,,0,0,0,,Ей! Ах...
Dialogue: 0,0:20:02.46,0:20:06.47,Default,,0,0,0,,Бастауыш мектеп ғимараты
Dialogue: 0,0:20:02.46,0:20:06.47,Default,,0,0,0,,Жоқ болды, солай емес пе?
Dialogue: 0,0:20:06.47,0:20:08.47,Default,,0,0,0,,Иә
Dialogue: 0,0:20:08.47,0:20:13.41,Default,,0,0,0,,Камакура
Dialogue: 0,0:20:08.47,0:20:13.41,Default,,0,0,0,,Мен Камакураға қайтып келсем де
Dialogue: 0,0:20:08.47,0:20:13.41,Default,,0,0,0,,Онда ешқашан болған емес
Dialogue: 0,0:20:13.41,0:20:17.41,Default,,0,0,0,,Мен оны дұрыстап қарасам ғой.
Dialogue: 0,0:20:13.41,0:20:17.41,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:20:17.41,0:20:19.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:19.41,0:20:22.42,Default,,0,0,0,,Ол жоғалды...
Dialogue: 0,0:20:19.41,0:20:22.42,Default,,0,0,0,,Не?
Dialogue: 0,0:20:22.42,0:20:26.42,Default,,0,0,0,,Түнгі мектеп дегеніміз не?
Dialogue: 0,0:20:22.42,0:20:26.42,Default,,0,0,0,,Мен қорқынышты туралы ұмытып кеттім ...
Dialogue: 0,0:20:26.42,0:20:30.42,Default,,0,0,0,,А, бұл рас.
Dialogue: 0,0:20:30.42,0:20:32.42,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:34.43,0:20:36.43,Default,,0,0,0,,Уау
Dialogue: 0,0:20:36.43,0:20:41.43,Default,,0,0,0,,Сәлем Фуми-чан. Уақыт келді...
Dialogue: 0,0:20:36.43,0:20:41.43,Default,,0,0,0,,Мүмкін мен де сол жаққа қарағаным жөн болар.
Dialogue: 0,0:20:41.43,0:20:45.44,Default,,0,0,0,,Не!? Күте тұрыңыз...
Dialogue: 0,0:20:41.43,0:20:45.44,Default,,0,0,0,,Жоқ, күте тұрыңыз!
Dialogue: 0,0:20:45.44,0:20:48.44,Default,,0,0,0,,Қараңдар, тез келулерің керек.
Dialogue: 0,0:20:45.44,0:20:48.44,Default,,0,0,0,,Мен оны қалдырамын.
Dialogue: 0,0:20:48.44,0:20:50.44,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:20:50.44,0:20:52.44,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:20:50.44,0:20:52.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:54.45,0:20:56.45,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:20:54.45,0:20:56.45,Default,,0,0,0,,Бұл кек.
Dialogue: 0,0:20:56.45,0:21:02.46,Default,,0,0,0,,Тоқта. Уфуфу... Кешіріңіз...
Dialogue: 0,0:20:56.45,0:21:02.46,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:02.46,0:21:04.46,Default,,0,0,0,,Уф…
Dialogue: 0,0:21:04.46,0:21:08.46,Default,,0,0,0,,Қазірдің өзінде! Келесі жолы мен жаман боламын
Dialogue: 0,0:21:04.46,0:21:08.46,Default,,0,0,0,,Мен сені кешірмеймін.
Dialogue: 0,0:21:08.46,0:21:10.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:12.47,0:21:14.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:16.47,0:21:20.47,Default,,0,0,0,,《Иә.
Dialogue: 0,0:21:16.47,0:21:20.47,Default,,0,0,0,,Қалай ұмытып қалдым деп ойлаймын》
Dialogue: 0,0:21:20.47,0:21:24.48,Default,,0,0,0,,《I
Dialogue: 0,0:21:20.47,0:21:24.48,Default,,0,0,0,,Мен бірінші ғашық болғаным...》
Dialogue: 0,0:21:24.48,0:21:27.48,Default,,0,0,0,,《Менің алғашқы махаббатым...》
Dialogue: 0,0:21:27.48,0:21:29.48,Default,,0,0,0,,Жарайсың ба? Түсінді ме?
Dialogue: 0,0:21:33.49,0:21:35.49,Default,,0,0,0,,Иә!?
Dialogue: 0,0:21:35.49,0:21:38.49,Default,,0,0,0,,Жоқ! Фуми-чан, мен ашуланбаймын.
Dialogue: 0,0:21:38.49,0:21:41.49,Default,,0,0,0,,Жоқ. Бұл дұрыс емес.
Dialogue: 0,0:21:41.49,0:21:44.50,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:21:44.50,0:21:47.50,Default,,0,0,0,,Өте маңызды нәрсе
Dialogue: 0,0:21:47.50,0:21:49.50,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:21:51.50,0:21:54.51,Default,,0,0,0,,Иә
Dialogue: 0,0:21:54.51,0:21:56.51,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:21:56.51,0:21:58.51,Default,,0,0,0,,Иә...
Dialogue: 0,0:22:02.52,0:22:07.52,Default,,0,0,0,,Жарайды. Онда үйге барайық.
Dialogue: 0,0:22:02.52,0:22:07.52,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:22:09.54,0:22:11.54,Default,,0,0,0,,Иә
Dialogue: 0,0:22:19.47,0:22:22.47,Default,,0,0,0,,《Фуми-чан бұл
Dialogue: 0,0:22:19.47,0:22:22.47,Default,,0,0,0,,Себебі сен оңай жылайсың》
Dialogue: 0,0:22:23.97,0:22:29.97,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
