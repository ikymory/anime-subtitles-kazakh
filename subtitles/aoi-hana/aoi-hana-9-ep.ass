Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.45,0:00:05.45,Default,,0,0,0,,Киоко
Dialogue: 0,0:00:03.45,0:00:05.45,Default,,0,0,0,,《Сен ағаңды әлі де жақсы көресің бе? 》
Dialogue: 0,0:00:05.45,0:00:08.46,Default,,0,0,0,,《Не! Ах...》
Dialogue: 0,0:00:08.46,0:00:11.46,Default,,0,0,0,,《Мен...》
Dialogue: 0,0:00:11.46,0:00:15.46,Default,,0,0,0,,《Кешіріңіз
Dialogue: 0,0:00:11.46,0:00:15.46,Default,,0,0,0,,Сізді мазалайтын нәрселерді тыңдаңыз》
Dialogue: 0,0:00:15.46,0:00:19.47,Default,,0,0,0,,《Жоқ. мен...
Dialogue: 0,0:00:15.46,0:00:19.47,Default,,0,0,0,,Мен қазірдің өзінде...》
Dialogue: 0,0:00:19.47,0:00:24.47,Default,,0,0,0,,《Мені тастап кетті және
Dialogue: 0,0:00:19.47,0:00:24.47,Default,,0,0,0,,Қазір мені мүлдем жек көреді...｡➡
Dialogue: 0,0:00:24.47,0:00:27.48,Default,,0,0,0,,Сонда да мен сені әлі де жақсы көремін
Dialogue: 0,0:00:24.47,0:00:27.48,Default,,0,0,0,,Өте ақымақ》
Dialogue: 0,0:00:27.48,0:00:29.48,Default,,0,0,0,,《…》
Dialogue: 0,0:00:31.48,0:00:33.48,Default,,0,0,0,,《Осындай нәрсе...》
Dialogue: 0,0:00:38.49,0:00:42.49,Default,,0,0,0,,《Шынында да
Dialogue: 0,0:00:38.49,0:00:42.49,Default,,0,0,0,,Мүмкін жауапсыз махаббат хобби шығар...》
Dialogue: 0,0:00:42.49,0:00:45.49,Default,,0,0,0,,《Олай емес》
Dialogue: 0,0:00:42.49,0:00:45.49,Default,,0,0,0,,《А...》
Dialogue: 0,0:00:45.49,0:00:48.49,Default,,0,0,0,,Манжоме
Dialogue: 0,0:00:45.49,0:00:48.49,Default,,0,0,0,,...
Dialogue: 0,0:00:45.49,0:00:48.49,Default,,0,0,0,,《Не?》
Dialogue: 0,0:00:51.50,0:00:56.50,Default,,0,0,0,,《Не? иә? 》
Dialogue: 0,0:00:51.50,0:00:56.50,Default,,0,0,0,,《Жоқ, кешіріңіз》
Dialogue: 0,0:01:10.45,0:01:12.45,Default,,0,0,0,,《Артық емес》
Dialogue: 0,0:01:16.46,0:01:21.46,Default,,0,0,0,,Көк
Dialogue: 0,0:01:16.46,0:01:21.46,Default,,0,0,0,,3D маневрлік жабдықтың табиғи жауы.
Dialogue: 0,0:01:16.46,0:01:21.46,Default,,0,0,0,,♬『Көк гүл』
Dialogue: 0,0:01:21.46,0:01:31.47,Default,,0,0,0,,♬～
Dialogue: 0,0:01:31.47,0:01:40.48,Default,,0,0,0,,♬～
Dialogue: 0,0:01:40.48,0:02:00.43,Default,,0,0,0,,♬～
Dialogue: 0,0:02:00.43,0:02:20.45,Default,,0,0,0,,♬～
Dialogue: 0,0:02:20.45,0:02:34.45,Default,,0,0,0,,♬～
Dialogue: 0,0:02:41.44,0:02:44.45,Default,,0,0,0,,Иә, сол – қамыр жағылған.
Dialogue: 0,0:02:41.44,0:02:44.45,Default,,0,0,0,,Келесі қызмет көрсету аймағында үзіліс жасаңыз.
Dialogue: 0,0:02:44.45,0:02:47.45,Default,,0,0,0,,Не?!
Dialogue: 0,0:02:44.45,0:02:47.45,Default,,0,0,0,,Сіз жаңа ғана үзіліс алдыңыз!
Dialogue: 0,0:02:47.45,0:02:49.45,Default,,0,0,0,,Мен оған газ қоюды ұмытып кетіппін.
Dialogue: 0,0:02:49.45,0:02:53.45,Default,,0,0,0,,Не! Қазірдің өзінде.
Dialogue: 0,0:02:49.45,0:02:53.45,Default,,0,0,0,,Себебі мен сізге артымнан жүруге рұқсат бердім➡
Dialogue: 0,0:02:53.45,0:02:55.46,Default,,0,0,0,,Қаттырақ болыңыз.
Dialogue: 0,0:02:55.46,0:02:59.46,Default,,0,0,0,,Иә? Менімен жүріңіз...
Dialogue: 0,0:02:55.46,0:02:59.46,Default,,0,0,0,,Менің ойымша, ол оны өзімен бірге алып бара жатыр.
Dialogue: 0,0:02:59.46,0:03:01.46,Default,,0,0,0,,Уау. Жаман
Dialogue: 0,0:03:01.46,0:03:04.47,Default,,0,0,0,,«Мен сені өзіммен бірге алып кетемін», егер сіз маған ілескіңіз келсе.\NСіз
Dialogue: 0,0:03:01.46,0:03:04.47,Default,,0,0,0,,десеңіз де
Dialogue: 0,0:03:04.47,0:03:07.47,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:04.47,0:03:07.47,Default,,0,0,0,,Мисако
Dialogue: 0,0:03:04.47,0:03:07.47,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:07.47,0:03:09.47,Default,,0,0,0,,Ұрыспас
Dialogue: 0,0:03:09.47,0:03:14.48,Default,,0,0,0,,Окудаира
Dialogue: 0,0:03:09.47,0:03:14.48,Default,,0,0,0,,Жарайды, Окудайра мырза.
Dialogue: 0,0:03:09.47,0:03:14.48,Default,,0,0,0,,Ақырын жүрейік
Dialogue: 0,0:03:14.48,0:03:16.48,Default,,0,0,0,,Сәлем. Маған қара.
Dialogue: 0,0:03:16.48,0:03:18.48,Default,,0,0,0,,Йоко
Dialogue: 0,0:03:16.48,0:03:18.48,Default,,0,0,0,,Не?
Dialogue: 0,0:03:16.48,0:03:18.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:18.48,0:03:20.48,Default,,0,0,0,,Ах
Dialogue: 0,0:03:22.48,0:03:25.49,Default,,0,0,0,,Уау
Dialogue: 0,0:03:22.48,0:03:25.49,Default,,0,0,0,,Мива
Dialogue: 0,0:03:22.48,0:03:25.49,Default,,0,0,0,,Фудзи тауы
Dialogue: 0,0:03:25.49,0:03:27.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:30.49,0:03:32.49,Default,,0,0,0,,Хехе...
Dialogue: 0,0:03:40.43,0:03:43.44,Default,,0,0,0,,Көп болды, апа.
Dialogue: 0,0:03:43.44,0:03:47.44,Default,,0,0,0,,Ханае
Dialogue: 0,0:03:43.44,0:03:47.44,Default,,0,0,0,,Қош келдіңіз, Киоко-чан
Dialogue: 0,0:03:43.44,0:03:47.44,Default,,0,0,0,,Мен жақындап қалдық деп ойладым.
Dialogue: 0,0:03:47.44,0:03:50.44,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:03:47.44,0:03:50.44,Default,,0,0,0,,Ақша, мәртебе және әдемі әйел.
Dialogue: 0,0:03:47.44,0:03:50.44,Default,,0,0,0,,Ясу-чан
Dialogue: 0,0:03:50.44,0:03:52.45,Default,,0,0,0,,Саваной
Dialogue: 0,0:03:50.44,0:03:52.45,Default,,0,0,0,,Бұл Ясуши Саванои
Dialogue: 0,0:03:52.45,0:03:55.45,Default,,0,0,0,,Сәлем
Dialogue: 0,0:03:52.45,0:03:55.45,Default,,0,0,0,,Сәлем
Dialogue: 0,0:03:55.45,0:04:01.46,Default,,0,0,0,,Бұл Хана апай
Dialogue: 0,0:03:55.45,0:04:01.46,Default,,0,0,0,,Канның анасының қарындасы
Dialogue: 0,0:04:01.46,0:04:05.46,Default,,0,0,0,,Кешіріңіз. менің әпкем
Dialogue: 0,0:04:01.46,0:04:05.46,Default,,0,0,0,,Іс кенеттен ыңғайсызданып кетті...
Dialogue: 0,0:04:05.46,0:04:07.46,Default,,0,0,0,,Өсек-аяңға сол кісі себепкер.
Dialogue: 0,0:04:07.46,0:04:10.46,Default,,0,0,0,,(Мисако)
Dialogue: 0,0:04:07.46,0:04:10.46,Default,,0,0,0,,күрсіну. Қай жерде бар болса, бар.
Dialogue: 0,0:04:10.46,0:04:14.47,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:04:10.46,0:04:14.47,Default,,0,0,0,,Ол Акира Окудайраның ағасы.
Dialogue: 0,0:04:14.47,0:04:16.47,Default,,0,0,0,,Танысқаныма қуаныштымын. А... жоқ.➡
Dialogue: 0,0:04:16.47,0:04:19.47,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:04:16.47,0:04:19.47,Default,,0,0,0,,Бұл бірінші рет емес.
Dialogue: 0,0:04:19.47,0:04:22.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:19.47,0:04:22.48,Default,,0,0,0,,Қарашы, бір күні...
Dialogue: 0,0:04:22.48,0:04:24.48,Default,,0,0,0,,Хаха…
Dialogue: 0,0:04:24.48,0:04:27.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:27.48,0:04:32.49,Default,,0,0,0,,Жүр, көтеріл.
Dialogue: 0,0:04:27.48,0:04:32.49,Default,,0,0,0,,Мен саған айналаны көрсетемін.➡
Dialogue: 0,0:04:32.49,0:04:36.51,Default,,0,0,0,,Бұл асхана
Dialogue: 0,0:04:32.49,0:04:36.51,Default,,0,0,0,,Қонақ бөлме осында.
Dialogue: 0,0:04:36.51,0:04:39.51,Default,,0,0,0,,Жатын бөлме осында...
Dialogue: 0,0:04:36.51,0:04:39.51,Default,,0,0,0,,Осы жерде пайдаланыңыз
Dialogue: 0,0:04:41.43,0:04:44.43,Default,,0,0,0,,Егер сіз бірдеңені түсінбесеңіз
Dialogue: 0,0:04:41.43,0:04:44.43,Default,,0,0,0,,Менен бірдеңе сұра.
Dialogue: 0,0:04:44.43,0:04:47.43,Default,,0,0,0,,Әй, теннис корты!
Dialogue: 0,0:04:44.43,0:04:47.43,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:04:47.43,0:04:50.44,Default,,0,0,0,,Оны қолданып көргіңіз келе ме?
Dialogue: 0,0:04:47.43,0:04:50.44,Default,,0,0,0,,Мен мұны істеймін. Эй.
Dialogue: 0,0:04:50.44,0:04:53.44,Default,,0,0,0,,≪(Йоко) Сіз мұны жасадыңыз. Сіз өте мотивациясыз.
Dialogue: 0,0:05:07.45,0:05:10.46,Default,,0,0,0,,Оны Киоко-чан салды.
Dialogue: 0,0:05:10.46,0:05:12.46,Default,,0,0,0,,Бұл жақсы сурет.
Dialogue: 0,0:05:20.47,0:05:22.47,Default,,0,0,0,,Хун
Dialogue: 0,0:05:22.47,0:05:24.47,Default,,0,0,0,,Ах
Dialogue: 0,0:05:22.47,0:05:24.47,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:05:24.47,0:05:28.48,Default,,0,0,0,,Мен сенің қарсыласың емеспін.
Dialogue: 0,0:05:24.47,0:05:28.48,Default,,0,0,0,,Пончан
Dialogue: 0,0:05:28.48,0:05:31.48,Default,,0,0,0,,Шулы
Dialogue: 0,0:05:28.48,0:05:31.48,Default,,0,0,0,,Сәттілік Пон Чан
Dialogue: 0,0:05:31.48,0:05:34.48,Default,,0,0,0,,(Мива)
Dialogue: 0,0:05:31.48,0:05:34.48,Default,,0,0,0,,Йоко - бәрін жасай алатын қыз!
Dialogue: 0,0:05:34.48,0:05:36.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:36.45,0:05:38.32,Default,,0,0,0,,Хун
Dialogue: 0,0:05:38.32,0:05:40.32,Default,,0,0,0,,Хой
Dialogue: 0,0:05:40.32,0:05:43.32,Default,,0,0,0,,О
Dialogue: 0,0:05:40.32,0:05:43.32,Default,,0,0,0,,О
Dialogue: 0,0:05:50.33,0:05:52.33,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:58.34,0:06:02.34,Default,,0,0,0,,Ерм. Жақсы кадр.
Dialogue: 0,0:06:02.34,0:06:05.35,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:06:05.35,0:06:07.35,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:07.35,0:06:10.35,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:10.35,0:06:13.35,Default,,0,0,0,,Келген бойда кездесе бастадық.
Dialogue: 0,0:06:13.35,0:06:19.35,Default,,0,0,0,,Жоқ. Егер бұл сияқты нәрсе болмаса.
Dialogue: 0,0:06:13.35,0:06:19.35,Default,,0,0,0,,Менің гольф сияқты айналысатын ештеңем жоқ.
Dialogue: 0,0:06:22.36,0:06:25.37,Default,,0,0,0,,(Канг)
Dialogue: 0,0:06:22.36,0:06:25.37,Default,,0,0,0,,Мм... Мен сенің әпкең туралы айтып отырмын.
Dialogue: 0,0:06:25.37,0:06:27.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:27.37,0:06:30.37,Default,,0,0,0,,Топ басқа күні де кездеседі
Dialogue: 0,0:06:27.37,0:06:30.37,Default,,0,0,0,,Иә, бірақ➡
Dialogue: 0,0:06:30.37,0:06:33.37,Default,,0,0,0,,Мен сені енді шақырмаймын.
Dialogue: 0,0:06:30.37,0:06:33.37,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,0:06:33.37,0:06:37.37,Default,,0,0,0,,Ах. Сол үшін рахмет.
Dialogue: 0,0:06:40.41,0:06:44.42,Default,,0,0,0,,Менің әпкем туралы
Dialogue: 0,0:06:40.41,0:06:44.42,Default,,0,0,0,,Олар сізге шынымен жақсы қамқорлық жасайды.
Dialogue: 0,0:06:44.42,0:06:47.42,Default,,0,0,0,,Мен тым көп істеп жатқанымды түсіндім.
Dialogue: 0,0:06:44.42,0:06:47.42,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:06:47.42,0:06:51.43,Default,,0,0,0,,А... Солай ма?
Dialogue: 0,0:06:51.43,0:06:54.43,Default,,0,0,0,,Менің ойымша, сіз уайымдап жатқан шығарсыз.
Dialogue: 0,0:06:54.43,0:06:57.43,Default,,0,0,0,,Жақсы.➡
Dialogue: 0,0:06:57.43,0:07:00.43,Default,,0,0,0,,Мені шақырмасаң да➡
Dialogue: 0,0:07:00.43,0:07:06.43,Default,,0,0,0,,Бір күні басқа біреу
Dialogue: 0,0:07:00.43,0:07:06.43,Default,,0,0,0,,Менің ойымша, олар пайда болады.
Dialogue: 0,0:07:08.44,0:07:11.45,Default,,0,0,0,,Ах…｡➡
Dialogue: 0,0:07:11.45,0:07:17.45,Default,,0,0,0,,Мен мұны өте жақсы түсінемін.
Dialogue: 0,0:07:21.46,0:07:24.46,Default,,0,0,0,,(Киоко)
Dialogue: 0,0:07:21.46,0:07:24.46,Default,,0,0,0,,Баяғыда адасып кеткен жерім осы.
Dialogue: 0,0:07:24.46,0:07:28.46,Default,,0,0,0,,Ех! Мұнда?
Dialogue: 0,0:07:24.46,0:07:28.46,Default,,0,0,0,,Бұл өте қорқынышты емес пе? мұнда
Dialogue: 0,0:07:28.46,0:07:32.47,Default,,0,0,0,,Иә
Dialogue: 0,0:07:28.46,0:07:32.47,Default,,0,0,0,,Мен қорқып жүргенімде➡
Dialogue: 0,0:07:32.47,0:07:36.45,Default,,0,0,0,,Мен білмей тұрып, ағыстың жағасында болдым➡
Dialogue: 0,0:07:36.45,0:07:39.45,Default,,0,0,0,,Онда мен ұзақ жыладым.
Dialogue: 0,0:07:41.41,0:07:44.41,Default,,0,0,0,,Оны тапқан адам
Dialogue: 0,0:07:41.41,0:07:44.41,Default,,0,0,0,,Бұл Ясу-чан болатын.
Dialogue: 0,0:07:44.41,0:07:48.42,Default,,0,0,0,,Кя! Бұл не?
Dialogue: 0,0:07:44.41,0:07:48.42,Default,,0,0,0,,Сол романтикалық эпизод
Dialogue: 0,0:07:48.42,0:07:50.42,Default,,0,0,0,,Мен қызғанамын!
Dialogue: 0,0:07:50.42,0:07:54.42,Default,,0,0,0,,Жарайды. Бұл үлкен мәселе.
Dialogue: 0,0:07:50.42,0:07:54.42,Default,,0,0,0,,Қасиетті жерлерге зияратқа барайық
Dialogue: 0,0:07:54.42,0:07:57.42,Default,,0,0,0,,Уау! Ұнайды
Dialogue: 0,0:07:54.42,0:07:57.42,Default,,0,0,0,,Кеттік, кеттік!
Dialogue: 0,0:07:57.42,0:07:59.43,Default,,0,0,0,,Ей!
Dialogue: 0,0:07:57.42,0:07:59.43,Default,,0,0,0,,Онда барсаң да ештеңе жоқ.
Dialogue: 0,0:07:59.43,0:08:02.43,Default,,0,0,0,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,0:07:59.43,0:08:02.43,Default,,0,0,0,,Барудың мағынасы бар
Dialogue: 0,0:08:02.43,0:08:04.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:02.43,0:08:04.43,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:08:09.44,0:08:13.44,Default,,0,0,0,,Хмм... Тайғақ.
Dialogue: 0,0:08:09.44,0:08:13.44,Default,,0,0,0,,Баяу төмен түсіңіз.
Dialogue: 0,0:08:13.44,0:08:15.44,Default,,0,0,0,,Эй, сәлем...
Dialogue: 0,0:08:19.45,0:08:21.45,Default,,0,0,0,,А-чан, абай бол
Dialogue: 0,0:08:21.45,0:08:23.45,Default,,0,0,0,,Сонда бәрі—әбден бәрі—шешіледі!
Dialogue: 0,0:08:23.45,0:08:26.45,Default,,0,0,0,,Уау!? Апыр-ай!
Dialogue: 0,0:08:23.45,0:08:26.45,Default,,0,0,0,,Ах!?
Dialogue: 0,0:08:26.45,0:08:28.45,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:26.45,0:08:28.45,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:08:28.45,0:08:30.45,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:08:33.46,0:08:36.40,Default,,0,0,0,,(Масато) Денең болмауы біраз қиын ғой, иә?
Dialogue: 0,0:08:33.46,0:08:36.40,Default,,0,0,0,,≪(Йоко) Уау!?
Dialogue: 0,0:08:36.40,0:08:41.40,Default,,0,0,0,,Ауырды
Dialogue: 0,0:08:36.40,0:08:41.40,Default,,0,0,0,,Маған да біреу көмектесуін өтінемін!
Dialogue: 0,0:08:41.40,0:08:43.40,Default,,0,0,0,,Кешіріңіз... Кешіріңіз. Сенімен бәрі жақсы ма?
Dialogue: 0,0:08:43.40,0:08:47.41,Default,,0,0,0,,Бұл! Күлме!
Dialogue: 0,0:08:43.40,0:08:47.41,Default,,0,0,0,,Күте тұрыңыз, міне!
Dialogue: 0,0:08:47.41,0:08:51.41,Default,,0,0,0,,Пон-чан, сен бүгін келген жоқсың.
Dialogue: 0,0:08:47.41,0:08:51.41,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:08:57.42,0:09:00.42,Default,,0,0,0,,Таулар салқын.
Dialogue: 0,0:08:57.42,0:09:00.42,Default,,0,0,0,,Өзін жақсы сезінеді
Dialogue: 0,0:09:00.42,0:09:04.42,Default,,0,0,0,,Иә
Dialogue: 0,0:09:00.42,0:09:04.42,Default,,0,0,0,,Мен қазірдің өзінде терлеп жатырмын
Dialogue: 0,0:09:09.43,0:09:13.43,Default,,0,0,0,,О, мінекей.
Dialogue: 0,0:09:13.43,0:09:17.44,Default,,0,0,0,,Жақсы, жақсы.
Dialogue: 0,0:09:13.43,0:09:17.44,Default,,0,0,0,,Мен адасып қалдым.
Dialogue: 0,0:09:17.44,0:09:21.44,Default,,0,0,0,,Киоко! Мен көмектесуге келдім!
Dialogue: 0,0:09:17.44,0:09:21.44,Default,,0,0,0,,Ах Ясу-чан!
Dialogue: 0,0:09:21.44,0:09:24.44,Default,,0,0,0,,Ал... оны қайта шығарудың қажеті жоқ!
Dialogue: 0,0:09:24.44,0:09:27.45,Default,,0,0,0,,Киоко!
Dialogue: 0,0:09:24.44,0:09:27.45,Default,,0,0,0,,Ясу-чан!
Dialogue: 0,0:09:27.45,0:09:39.39,Default,,0,0,0,,♬～
Dialogue: 0,0:09:39.39,0:09:41.39,Default,,0,0,0,,Суық!
Dialogue: 0,0:09:44.40,0:09:46.40,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:09:44.40,0:09:46.40,Default,,0,0,0,,Эй
Dialogue: 0,0:09:54.41,0:09:57.41,Default,,0,0,0,,(Гүл суреті)
Dialogue: 0,0:09:54.41,0:09:57.41,Default,,0,0,0,,Маған сенің көмегің керек емес.
Dialogue: 0,0:09:57.41,0:10:00.41,Default,,0,0,0,,Жоқ. Бұл туралы көп
Dialogue: 0,0:10:00.41,0:10:04.42,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:10:00.41,0:10:04.42,Default,,0,0,0,,Анау ұзын балаға не дедіңіз?
Dialogue: 0,0:10:04.42,0:10:06.42,Default,,0,0,0,,Манжоме-сан?
Dialogue: 0,0:10:06.42,0:10:09.42,Default,,0,0,0,,Салған суреттерің мені таң қалдырды.
Dialogue: 0,0:10:09.42,0:10:12.43,Default,,0,0,0,,Абай бол, ДжоДжо!
Dialogue: 0,0:10:12.43,0:10:14.43,Default,,0,0,0,,Иә
Dialogue: 0,0:10:21.43,0:10:27.44,Default,,0,0,0,,Хуи! Күріш дәмді болды
Dialogue: 0,0:10:21.43,0:10:27.44,Default,,0,0,0,,Ванна жақсы болды➡
Dialogue: 0,0:10:27.44,0:10:32.45,Default,,0,0,0,,Жұмақ Жұмақ
Dialogue: 0,0:10:27.44,0:10:32.45,Default,,0,0,0,,Қазірдің өзінде ашантара
Dialogue: 0,0:10:32.45,0:10:34.45,Default,,0,0,0,,≪
Dialogue: 0,0:10:32.45,0:10:34.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:34.45,0:10:37.38,Default,,0,0,0,,Апай
Dialogue: 0,0:10:37.38,0:10:39.39,Default,,0,0,0,,Не ол?
Dialogue: 0,0:10:39.39,0:10:43.39,Default,,0,0,0,,Қорқынышты оқиғаны айтып берейік
Dialogue: 0,0:10:39.39,0:10:43.39,Default,,0,0,0,,Иә!? Жоқ, жоқ.
Dialogue: 0,0:10:43.39,0:10:47.39,Default,,0,0,0,,Біз сондаймыз.
Dialogue: 0,0:10:43.39,0:10:47.39,Default,,0,0,0,,Өйткені бұл жақсы емес. Сәлем Фуми Чан
Dialogue: 0,0:10:47.39,0:10:50.40,Default,,0,0,0,,Қызық көрінеді...
Dialogue: 0,0:10:47.39,0:10:50.40,Default,,0,0,0,,Иә!?
Dialogue: 0,0:10:50.40,0:10:53.40,Default,,0,0,0,,Ал, Ясаннан бастайық.
Dialogue: 0,0:10:50.40,0:10:53.40,Default,,0,0,0,,Сағат тілімен осылай
Dialogue: 0,0:10:53.40,0:10:55.40,Default,,0,0,0,,Рух толқыны ма?
Dialogue: 0,0:10:55.40,0:10:58.40,Default,,0,0,0,,«Сукима Онна» туралы білесіз бе?
Dialogue: 0,0:10:58.40,0:11:01.41,Default,,0,0,0,,Хехе...
Dialogue: 0,0:10:58.40,0:11:01.41,Default,,0,0,0,,Мен бұл есімді жек көремін!
Dialogue: 0,0:11:01.41,0:11:04.41,Default,,0,0,0,,Жарықты өшіру керек пе?
Dialogue: 0,0:11:01.41,0:11:04.41,Default,,0,0,0,,Уау. Тоқта!
Dialogue: 0,0:11:04.41,0:11:07.41,Default,,0,0,0,,(Мисако)
Dialogue: 0,0:11:04.41,0:11:07.41,Default,,0,0,0,,Бөлмеде жалғыз болсам да➡
Dialogue: 0,0:11:07.41,0:11:11.42,Default,,0,0,0,,Мені біреу бақылап тұрғандай сезінемін
Dialogue: 0,0:11:07.41,0:11:11.42,Default,,0,0,0,,Мен... Маған ұнамайды! Мен оны ұнатпаймын!
Dialogue: 0,0:11:11.42,0:11:16.42,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:11:11.42,0:11:16.42,Default,,0,0,0,,жәшіктердің арасындағы саңылауда...
Dialogue: 0,0:11:16.42,0:11:20.42,Default,,0,0,0,,Уау!?
Dialogue: 0,0:11:27.42,0:11:29.42,Default,,0,0,0,,Кемпинг!?
Dialogue: 0,0:11:27.42,0:11:29.42,Default,,0,0,0,,Иә
Dialogue: 0,0:11:29.42,0:11:33.43,Default,,0,0,0,,Кешегі жаяу серуендеу курсы
Dialogue: 0,0:11:29.42,0:11:33.43,Default,,0,0,0,,Жолда үш жақты қиылыс болды, солай ма?
Dialogue: 0,0:11:33.43,0:11:36.43,Default,,0,0,0,,Мына жерде лагерь бар.
Dialogue: 0,0:11:36.43,0:11:38.43,Default,,0,0,0,,Өйткені бұл үлкен мәселе
Dialogue: 0,0:11:36.43,0:11:38.43,Default,,0,0,0,,Сіз түнде болғыңыз келе ме?
Dialogue: 0,0:11:38.43,0:11:40.43,Default,,0,0,0,,Бар, бар, бар. Жүр, жүр!
Dialogue: 0,0:11:40.43,0:11:44.44,Default,,0,0,0,,Қыз бала болу қауіпті
Dialogue: 0,0:11:40.43,0:11:44.44,Default,,0,0,0,,Ясу-чан және басқалары да, өтінемін.
Dialogue: 0,0:11:44.44,0:11:47.44,Default,,0,0,0,,Иә
Dialogue: 0,0:11:44.44,0:11:47.44,Default,,0,0,0,,Бұл менің кемпингке бірінші рет шығуым.
Dialogue: 0,0:11:47.44,0:11:49.44,Default,,0,0,0,,Кемпингке барғанда➡
Dialogue: 0,0:11:49.44,0:11:53.45,Default,,0,0,0,,Өз отымызды жасайық
Dialogue: 0,0:11:49.44,0:11:53.45,Default,,0,0,0,,Күрішті пісіріңіз➡
Dialogue: 0,0:11:53.45,0:11:56.45,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:11:53.45,0:11:56.45,Default,,0,0,0,,Бұл карри, солай ма?
Dialogue: 0,0:11:56.45,0:12:00.45,Default,,0,0,0,,Сіз өте жақсысыз
Dialogue: 0,0:11:56.45,0:12:00.45,Default,,0,0,0,,үшін тамаққа қатысты.
Dialogue: 0,0:12:00.45,0:12:03.46,Default,,0,0,0,,Не!
Dialogue: 0,0:12:00.45,0:12:03.46,Default,,0,0,0,,Жақсы, мен саған оны жеуге рұқсат бермеймін.
Dialogue: 0,0:12:03.46,0:12:06.46,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:12:03.46,0:12:06.46,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:06.46,0:12:08.46,Default,,0,0,0,,Ұрыспас
Dialogue: 0,0:12:08.46,0:12:28.41,Default,,0,0,0,,♬～
Dialogue: 0,0:12:28.41,0:12:39.43,Default,,0,0,0,,♬～
Dialogue: 0,0:12:39.43,0:12:42.43,Default,,0,0,0,,Уау. Бұл жеткілікті емес пе?
Dialogue: 0,0:12:39.43,0:12:42.43,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:12:42.43,0:12:48.43,Default,,0,0,0,,Таймер әлі шырылдаған жоқ.
Dialogue: 0,0:12:42.43,0:12:48.43,Default,,0,0,0,,А, қазірдің өзінде! Сондай көңілсіз!
Dialogue: 0,0:12:48.43,0:12:51.44,Default,,0,0,0,,(таймер дыбысы)
Dialogue: 0,0:12:48.43,0:12:51.44,Default,,0,0,0,,Ах
Dialogue: 0,0:12:51.44,0:12:53.44,Default,,0,0,0,,Қоңырау соқты!
Dialogue: 0,0:12:56.44,0:13:00.45,Default,,0,0,0,,А... жақсы иіс шығады.
Dialogue: 0,0:13:00.45,0:13:04.45,Default,,0,0,0,,Иә. Мен оған қызмет етемін. Мен оған қызмет етемін.
Dialogue: 0,0:13:00.45,0:13:04.45,Default,,0,0,0,,табақ табақ
Dialogue: 0,0:13:07.45,0:13:10.45,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:13:13.46,0:13:16.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:16.46,0:13:19.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:19.47,0:13:21.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:21.47,0:13:23.47,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:13:21.47,0:13:23.47,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:13:23.47,0:13:28.41,Default,,0,0,0,,Міне. Міне, солай.
Dialogue: 0,0:13:23.47,0:13:28.41,Default,,0,0,0,,Мен өзім жасаған тағамға тәнті болдым.
Dialogue: 0,0:13:28.41,0:13:32.41,Default,,0,0,0,,Бірақ бұл өте дәмді. Эй.
Dialogue: 0,0:13:32.41,0:13:35.41,Default,,0,0,0,,Иә
Dialogue: 0,0:13:32.41,0:13:35.41,Default,,0,0,0,,Икуми
Dialogue: 0,0:13:32.41,0:13:35.41,Default,,0,0,0,,Игуми мырза жақсы.
Dialogue: 0,0:13:35.41,0:13:41.42,Default,,0,0,0,,Менің осындай тамаша жерде виллам бар.
Dialogue: 0,0:13:35.41,0:13:41.42,Default,,0,0,0,,Менің жақсы досым бар екеніне сене алар емеспін.
Dialogue: 0,0:13:41.42,0:13:44.42,Default,,0,0,0,,Ол жол кешегі жаяу жүру жолы болатын
Dialogue: 0,0:13:41.42,0:13:44.42,Default,,0,0,0,,Олар бір-бірімен байланысты, солай ма?
Dialogue: 0,0:13:44.42,0:13:46.43,Default,,0,0,0,,Ах!?
Dialogue: 0,0:13:44.42,0:13:46.43,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:13:46.43,0:13:50.43,Default,,0,0,0,,Түн болғанда
Dialogue: 0,0:13:46.43,0:13:50.43,Default,,0,0,0,,Ендеше жігерімізді сынап көрейік.
Dialogue: 0,0:13:50.43,0:13:53.43,Default,,0,0,0,,Иә!?
Dialogue: 0,0:13:50.43,0:13:53.43,Default,,0,0,0,,Қараңыз, ағынның жағасында➡
Dialogue: 0,0:13:53.43,0:13:57.44,Default,,0,0,0,,лалагүлдер гүлдеді.
Dialogue: 0,0:13:53.43,0:13:57.44,Default,,0,0,0,,Оларды жұппен таңдаңыз.
Dialogue: 0,0:13:57.44,0:14:03.44,Default,,0,0,0,,Маған ұнамайды! Мен оны мүлдем жек көремін! Сондықтан
Dialogue: 0,0:13:57.44,0:14:03.44,Default,,0,0,0,,Бұл жақсы емес, солай ма?
Dialogue: 0,0:14:03.44,0:14:06.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:03.44,0:14:06.45,Default,,0,0,0,,Игуми мырза!
Dialogue: 0,0:14:06.45,0:14:09.45,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:14:06.45,0:14:09.45,Default,,0,0,0,,Иә!?
Dialogue: 0,0:14:09.45,0:14:12.45,Default,,0,0,0,,Мен сонда бардым.
Dialogue: 0,0:14:09.45,0:14:12.45,Default,,0,0,0,,Иә
Dialogue: 0,0:14:12.45,0:14:15.45,Default,,0,0,0,,Содан кейін I
Dialogue: 0,0:14:12.45,0:14:15.45,Default,,0,0,0,,Жұптар үшін лотерея ұтысын жасаңыз!
Dialogue: 0,0:14:15.45,0:14:20.45,Default,,0,0,0,,Маған қағаз бен сиқырды қарызға алуым керек.
Dialogue: 0,0:14:15.45,0:14:20.45,Default,,0,0,0,,Жарайды. Қанекей мынаны істейік. Қанекей мынаны істейік.
Dialogue: 0,0:14:29.40,0:14:32.40,Default,,0,0,0,,《Ха ха…》
Dialogue: 0,0:14:42.41,0:14:44.42,Default,,0,0,0,,≪(Киоконың жылауы)
Dialogue: 0,0:14:42.41,0:14:44.42,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:14:44.42,0:14:47.42,Default,,0,0,0,,≪(Ясу)《Киоко! 》
Dialogue: 0,0:14:44.42,0:14:47.42,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:14:47.42,0:14:49.42,Default,,0,0,0,,《А...》
Dialogue: 0,0:14:59.43,0:15:02.43,Default,,0,0,0,,《Ясу-чан
Dialogue: 0,0:14:59.43,0:15:02.43,Default,,0,0,0,,Киокого ашуланасың ба? 》
Dialogue: 0,0:15:02.43,0:15:04.44,Default,,0,0,0,,《Неге?》
Dialogue: 0,0:15:04.44,0:15:07.44,Default,,0,0,0,,《Киоко туралы
Dialogue: 0,0:15:04.44,0:15:07.44,Default,,0,0,0,,Себебі мен сені арқамда көтеріп жүрмін➡
Dialogue: 0,0:15:07.44,0:15:11.44,Default,,0,0,0,,Сіз құлап қалдыңыз, солай ма? 》
Dialogue: 0,0:15:07.44,0:15:11.44,Default,,0,0,0,,Жоқ, ол емес. Жасырынған орын. Жасырынған орын ба?
Dialogue: 0,0:15:11.44,0:15:14.45,Default,,0,0,0,,《Ауырып тұр ма? 》
Dialogue: 0,0:15:11.44,0:15:14.45,Default,,0,0,0,,《Ауырып тұр.➡
Dialogue: 0,0:15:14.45,0:15:18.45,Default,,0,0,0,,Киоко үшін ауырады》
Dialogue: 0,0:15:18.45,0:15:21.45,Default,,0,0,0,,《Аа... кешіріңіз》
Dialogue: 0,0:15:21.45,0:15:24.47,Default,,0,0,0,,《Бұл өтірік》
Dialogue: 0,0:15:21.45,0:15:24.47,Default,,0,0,0,,(Киоконың жылауы)
Dialogue: 0,0:15:24.47,0:15:27.39,Default,,0,0,0,,《Жылама. Күліңіз》
Dialogue: 0,0:15:27.39,0:15:30.40,Default,,0,0,0,,(Киоконың жылауы)
Dialogue: 0,0:15:30.40,0:15:32.40,Default,,0,0,0,,《А...》
Dialogue: 0,0:15:34.40,0:15:36.40,Default,,0,0,0,,《Күлімде. Киоко》
Dialogue: 0,0:15:36.40,0:15:40.40,Default,,0,0,0,,(Киоконың жылауы)
Dialogue: 0,0:15:44.41,0:15:48.41,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:15:48.41,0:15:51.42,Default,,0,0,0,,Қызыл
Dialogue: 0,0:15:48.41,0:15:51.42,Default,,0,0,0,,О, менмін.
Dialogue: 0,0:15:51.42,0:15:53.42,Default,,0,0,0,,Жасыл…
Dialogue: 0,0:15:51.42,0:15:53.42,Default,,0,0,0,,Жасыл
Dialogue: 0,0:15:55.42,0:15:59.43,Default,,0,0,0,,Сары
Dialogue: 0,0:15:55.42,0:15:59.43,Default,,0,0,0,,А, бұл менмін.
Dialogue: 0,0:15:59.43,0:16:04.43,Default,,0,0,0,,Сонымен, көк - Пон-чан?
Dialogue: 0,0:15:59.43,0:16:04.43,Default,,0,0,0,,Сәлем. Бұл қорқытудың қажеті жоқ.
Dialogue: 0,0:16:04.43,0:16:09.43,Default,,0,0,0,,Ах-чанды ауыстырайын ба?
Dialogue: 0,0:16:04.43,0:16:09.43,Default,,0,0,0,,Тоқта! Мен Ясанмен жалғыз қалғым келмейді!
Dialogue: 0,0:16:13.44,0:16:17.44,Default,,0,0,0,,Абайлаңыз. Жақында.
Dialogue: 0,0:16:13.44,0:16:17.44,Default,,0,0,0,,Кеше Пон-чанның құлаған жері.
Dialogue: 0,0:16:17.44,0:16:19.44,Default,,0,0,0,,Иә
Dialogue: 0,0:16:22.45,0:16:24.42,Default,,0,0,0,,Сурет…
Dialogue: 0,0:16:24.42,0:16:29.42,Default,,0,0,0,,Бұл керемет болды. Ақ гиппопотам...
Dialogue: 0,0:16:24.42,0:16:29.42,Default,,0,0,0,,Әйтеуір...
Dialogue: 0,0:16:34.29,0:16:37.29,Default,,0,0,0,,(Киоко)
Dialogue: 0,0:16:34.29,0:16:37.29,Default,,0,0,0,,Мен орта мектепте оқып жүргенде көркемсурет үйірмесіне қатысатынмын.
Dialogue: 0,0:16:40.30,0:16:43.30,Default,,0,0,0,,Ал мен ағама ғашық болдым
Dialogue: 0,0:16:51.31,0:16:54.31,Default,,0,0,0,,Бірақ ол кезде менің ағам бұрыннан...
Dialogue: 0,0:16:56.32,0:17:00.32,Default,,0,0,0,,Мен оны осы маңайда бір жерге қойған едім…
Dialogue: 0,0:16:56.32,0:17:00.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:00.32,0:17:04.32,Default,,0,0,0,,Бұл... әртүрлі заттар.
Dialogue: 0,0:17:09.33,0:17:11.33,Default,,0,0,0,,Міне
Dialogue: 0,0:17:17.34,0:17:22.34,Default,,0,0,0,,Уф…｡ Фуми-чан және т.б
Dialogue: 0,0:17:17.34,0:17:22.34,Default,,0,0,0,,Мен мұндай жерлерде жиі болдым.
Dialogue: 0,0:17:22.34,0:17:24.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:24.34,0:17:28.38,Default,,0,0,0,,Окухира мырза қорқып кетті.
Dialogue: 0,0:17:24.34,0:17:28.38,Default,,0,0,0,,Күтпеген нәрсе.
Dialogue: 0,0:17:28.38,0:17:32.38,Default,,0,0,0,,(Изуку) Қарсыластың өз күшін пайдаланып, дәл қорғанына сондай етіп сүңгу...
Dialogue: 0,0:17:28.38,0:17:32.38,Default,,0,0,0,,Мен де қызбын.
Dialogue: 0,0:17:32.38,0:17:35.39,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:17:32.38,0:17:35.39,Default,,0,0,0,,Менің айтқым келгені бұл емес еді...
Dialogue: 0,0:17:35.39,0:17:40.39,Default,,0,0,0,,Мұндай жерде қалай адасып кетесің?
Dialogue: 0,0:17:35.39,0:17:40.39,Default,,0,0,0,,Мен болсам, мен өте...
Dialogue: 0,0:17:42.39,0:17:46.40,Default,,0,0,0,,Мен оны естідім.
Dialogue: 0,0:17:42.39,0:17:46.40,Default,,0,0,0,,Киоконың адасу оқиғасы
Dialogue: 0,0:17:46.40,0:17:48.40,Default,,0,0,0,,А... иә
Dialogue: 0,0:17:48.40,0:17:53.40,Default,,0,0,0,,Киоко біреуді ұнатады, солай ма?
Dialogue: 0,0:17:48.40,0:17:53.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:55.41,0:17:59.41,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:17:55.41,0:17:59.41,Default,,0,0,0,,Хмм... Былай деуге болады
Dialogue: 0,0:17:59.41,0:18:04.42,Default,,0,0,0,,Аа, бірақ бұл жай әңгіме, Игуми мырза.
Dialogue: 0,0:17:59.41,0:18:04.42,Default,,0,0,0,,Мені ол адам тастап кеткен.
Dialogue: 0,0:18:04.42,0:18:08.42,Default,,0,0,0,,Ах
Dialogue: 0,0:18:04.42,0:18:08.42,Default,,0,0,0,,Иә... Рахмет
Dialogue: 0,0:18:15.43,0:18:17.43,Default,,0,0,0,,I...➡
Dialogue: 0,0:18:17.43,0:18:20.43,Default,,0,0,0,,Мен сол адам болғым келеді
Dialogue: 0,0:18:20.43,0:18:22.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:31.38,0:18:33.38,Default,,0,0,0,,Бұл жақсы сезінеді.
Dialogue: 0,0:18:31.38,0:18:33.38,Default,,0,0,0,,Иә
Dialogue: 0,0:18:33.38,0:18:35.38,Default,,0,0,0,,Не?
Dialogue: 0,0:18:35.38,0:18:38.38,Default,,0,0,0,,Не? могги айт
Dialogue: 0,0:18:35.38,0:18:38.38,Default,,0,0,0,,Мойында!
Dialogue: 0,0:18:38.38,0:18:40.39,Default,,0,0,0,,Аға десең, Окухира-нии дейсің!
Dialogue: 0,0:18:40.39,0:18:42.39,Default,,0,0,0,,Не болды?
Dialogue: 0,0:18:42.39,0:18:45.39,Default,,0,0,0,,Мотеги
Dialogue: 0,0:18:42.39,0:18:45.39,Default,,0,0,0,,Моги мырза.
Dialogue: 0,0:18:42.39,0:18:45.39,Default,,0,0,0,,Окухира мырзаның ағасына...
Dialogue: 0,0:18:45.39,0:18:47.39,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:18:45.39,0:18:47.39,Default,,0,0,0,,Не!
Dialogue: 0,0:18:47.39,0:18:51.40,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:18:47.39,0:18:51.40,Default,,0,0,0,,Мен дәл осылай ойладым.
Dialogue: 0,0:18:51.40,0:18:55.40,Default,,0,0,0,,Эх!
Dialogue: 0,0:18:51.40,0:18:55.40,Default,,0,0,0,,Уау! Мен саған осыны айтып тұрмын!
Dialogue: 0,0:18:55.40,0:18:58.40,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:55.40,0:18:58.40,Default,,0,0,0,,Болашақтың шағын кілемі ретінде
Dialogue: 0,0:18:58.40,0:19:00.40,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:19:02.41,0:19:04.41,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:19:02.41,0:19:04.41,Default,,0,0,0,,Қайсысы жақсы?
Dialogue: 0,0:19:04.41,0:19:06.41,Default,,0,0,0,,Уау, тамаша!
Dialogue: 0,0:19:23.43,0:19:28.43,Default,,0,0,0,,《Әркім бір нәрсе ме?
Dialogue: 0,0:19:23.43,0:19:28.43,Default,,0,0,0,,Сізге шынымен ұнайтын адам бар деп ойлаймын.
Dialogue: 0,0:19:37.38,0:19:42.38,Default,,0,0,0,,《Мен де
Dialogue: 0,0:19:37.38,0:19:42.38,Default,,0,0,0,,Бұдан былай мен біреуге ғашық боламын➡
Dialogue: 0,0:19:42.38,0:19:45.38,Default,,0,0,0,,Фуми-чанға ұқсайды
Dialogue: 0,0:19:42.38,0:19:45.38,Default,,0,0,0,,Мен жылаймын ба деп ойлаймын》
Dialogue: 0,0:19:54.39,0:19:56.40,Default,,0,0,0,,(Асқазанның айқайлауы)
Dialogue: 0,0:19:56.40,0:19:59.40,Default,,0,0,0,,Уф…
Dialogue: 0,0:19:59.40,0:20:01.40,Default,,0,0,0,,Хехе...
Dialogue: 0,0:20:01.40,0:20:04.40,Default,,0,0,0,,Ех...
Dialogue: 0,0:20:04.40,0:20:08.40,Default,,0,0,0,,Тоңазытқышта бірдеңе болды, солай ма?
Dialogue: 0,0:20:04.40,0:20:08.40,Default,,0,0,0,,Иә
Dialogue: 0,0:20:12.41,0:20:17.42,Default,,0,0,0,,Ах... А-чан, бұл керемет...
Dialogue: 0,0:20:17.42,0:20:20.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:17.42,0:20:20.42,Default,,0,0,0,,Аспан әдемі
Dialogue: 0,0:20:20.42,0:20:22.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:27.36,0:20:30.36,Default,,0,0,0,,Керемет... Бұл таңқаларлық.
Dialogue: 0,0:20:30.36,0:20:33.37,Default,,0,0,0,,Иә. Керемет.
Dialogue: 0,0:20:33.37,0:20:43.38,Default,,0,0,0,,♬～
Dialogue: 0,0:20:43.38,0:20:54.39,Default,,0,0,0,,♬～
Dialogue: 0,0:20:54.39,0:20:59.39,Default,,0,0,0,,<Сол түн
Dialogue: 0,0:20:54.39,0:20:59.39,Default,,0,0,0,,Екеуміз біраз кеш тұрдық➡
Dialogue: 0,0:20:59.39,0:21:03.39,Default,,0,0,0,,Келесі күні екеуміз жақсы араласып кеттік.
Dialogue: 0,0:20:59.39,0:21:03.39,Default,,0,0,0,,Мен суық тиіп қалдым＞
Dialogue: 0,0:21:10.40,0:21:15.41,Default,,0,0,0,,♬『ｾﾝﾃｨﾌｫﾘｱ』
Dialogue: 0,0:21:15.41,0:21:35.43,Default,,0,0,0,,♬～
Dialogue: 0,0:21:35.43,0:21:53.45,Default,,0,0,0,,♬～
Dialogue: 0,0:21:53.45,0:21:58.45,Default,,0,0,0,,♬～
Dialogue: 0,0:21:58.45,0:22:18.47,Default,,0,0,0,,♬～
Dialogue: 0,0:22:18.47,0:22:28.47,Default,,0,0,0,,♬～
