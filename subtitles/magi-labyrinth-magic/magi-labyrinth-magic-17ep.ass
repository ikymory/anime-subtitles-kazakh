Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.83,0:01:05.17,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:09.11,0:02:01.72,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:22.07,0:02:25.37,Default,,0,0,0,,Не... бұл не болды? Қазір.
Dialogue: 0,0:02:25.37,0:02:27.66,Default,,0,0,0,,Мен барлығына келуді өтіндім.
Dialogue: 0,0:02:27.66,0:02:31.06,Default,,0,0,0,,Сізге және сіздің қымбат достарыңызға жол көрсету.
Dialogue: 0,0:02:33.11,0:02:36.72,Default,,0,0,0,,Оны енді қараңғылық толығымен жеді.
Dialogue: 0,0:02:36.72,0:02:41.41,Default,,0,0,0,,Оны жеңудің жалғыз жолы - қылышпен тесу.
Dialogue: 0,0:02:41.41,0:02:43.79,Default,,0,0,0,,Бірақ енді қылыш жоқ...
Dialogue: 0,0:02:43.79,0:02:47.04,Default,,0,0,0,,Жарайды. Амонның семсері қайта тіріледі.
Dialogue: 0,0:02:47.04,0:02:49.24,Default,,0,0,0,,Егер біз бірге жұмыс жасасақ.
Dialogue: 0,0:02:51.07,0:02:53.28,Default,,0,0,0,,«Қүйген егіз алақан»!
Dialogue: 0,0:02:53.28,0:02:56.94,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:56.94,0:03:01.14,Default,,0,0,0,,Тағы да солай. Менің ойымша, бұл мен үшін жұмыс істемейді.
Dialogue: 0,0:03:01.14,0:03:03.78,Default,,0,0,0,,Жүр, Әлибаба-күн. иә?
Dialogue: 0,0:03:03.78,0:03:07.08,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:07.08,0:03:09.30,Default,,0,0,0,,Не? иә... ә!?
Dialogue: 0,0:03:09.30,0:03:12.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:12.84,0:03:15.76,Default,,0,0,0,,Өрт. Ах.
Dialogue: 0,0:03:15.76,0:03:18.84,Default,,0,0,0,,Мен әзірге тек жылулық сиқырды қолдана аламын→
Dialogue: 0,0:03:18.84,0:03:21.55,Default,,0,0,0,,Қылышың жалыннан жаралғанына қуанамын.
Dialogue: 0,0:03:21.55,0:03:23.95,Default,,0,0,0,,Бұл да кездейсоқ емес.
Dialogue: 0,0:03:23.95,0:03:27.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:27.79,0:03:30.91,Default,,0,0,0,,Амонның қылышы қайтып келді.
Dialogue: 0,0:03:30.91,0:03:33.79,Default,,0,0,0,,Сонымен не керек?
Dialogue: 0,0:03:33.79,0:03:36.76,Default,,0,0,0,,Енді жүр, Алибаба-кун!
Dialogue: 0,0:03:36.76,0:03:39.06,Default,,0,0,0,,Ах! Қарғыс атсын!
Dialogue: 0,0:03:39.06,0:03:42.18,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:42.18,0:03:44.18,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:03:45.60,0:03:49.09,Default,,0,0,0,,Хмф! Tsk!
Dialogue: 0,0:03:49.09,0:03:51.69,Default,,0,0,0,,Сәлем! Дау!
Dialogue: 0,0:03:53.14,0:03:55.68,Default,,0,0,0,,Керемет!
Dialogue: 0,0:03:55.68,0:03:57.73,Default,,0,0,0,,≪Сіз жасадыңыз ба!?≫
Dialogue: 0,0:03:57.73,0:04:00.28,Default,,0,0,0,,Hmph. Блэк Джин өлмейтін. →
Dialogue: 0,0:04:00.28,0:04:03.19,Default,,0,0,0,,Мұндай шабуыл қарсы шабуылға әкеледі.
Dialogue: 0,0:04:03.19,0:04:06.99,Default,,0,0,0,,Ах! Гррр… Уф….
Dialogue: 0,0:04:06.99,0:04:09.54,Default,,0,0,0,,Уф… уф…. Апыр-ай!
Dialogue: 0,0:04:09.54,0:04:11.54,Default,,0,0,0,,Ух... Арх!
Dialogue: 0,0:04:13.15,0:04:15.78,Default,,0,0,0,,А...Әлібаба ханзада...
Dialogue: 0,0:04:15.78,0:04:19.09,Default,,0,0,0,,Не? Мені Джиннің іші жеп қойды.
Dialogue: 0,0:04:19.09,0:04:21.59,Default,,0,0,0,,Сіз жай ғана блеф жасап жатырсыз ба? Хаха.
Dialogue: 0,0:04:23.11,0:04:26.31,Default,,0,0,0,,Менің де сізге айтқым келетін бір нәрсе бар. а?
Dialogue: 0,0:04:29.53,0:04:31.75,Default,,0,0,0,,Жоқ... хмм! Не?
Dialogue: 0,0:04:31.75,0:04:33.78,Default,,0,0,0,,Жүрек соғысы Ах!
Dialogue: 0,0:04:33.78,0:04:38.96,Default,,0,0,0,,Dokun dokun dokunun dokunun…
Dialogue: 0,0:04:38.96,0:04:41.26,Default,,0,0,0,,Не... не? →
Dialogue: 0,0:04:41.26,0:04:44.33,Default,,0,0,0,,Тоқта... Тоқта!
Dialogue: 0,0:04:44.33,0:04:47.95,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:04:47.95,0:04:49.98,Default,,0,0,0,,Жудал!
Dialogue: 0,0:04:49.98,0:04:54.19,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:54.19,0:04:56.24,Default,,0,0,0,,≪Алибаба-кун...≫
Dialogue: 0,0:04:56.24,0:05:01.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:02.78,0:05:04.78,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:05:06.13,0:05:09.55,Default,,0,0,0,,Бұл қара джиннің ішінде, Алибаба-кун.
Dialogue: 0,0:05:09.55,0:05:12.26,Default,,0,0,0,,Аладдин…. Ах.
Dialogue: 0,0:05:12.26,0:05:14.29,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:14.29,0:05:17.69,Default,,0,0,0,,Оның Руфы - өзінің үлгісі. →
Dialogue: 0,0:05:19.16,0:05:22.45,Default,,0,0,0,,Мен уақытты сатып аламын. Сондықтан асығыңыз →
Dialogue: 0,0:05:22.45,0:05:24.75,Default,,0,0,0,,Оны қараңғылықтан құтқар.
Dialogue: 0,0:05:27.86,0:05:31.76,Default,,0,0,0,,Қасым Мен сенімен тағы сөйлескім келеді.
Dialogue: 0,0:05:34.93,0:05:38.72,Default,,0,0,0,,Сізбен сөйлесетін ештеңе жоқ.
Dialogue: 0,0:05:38.72,0:05:41.52,Default,,0,0,0,,Қасым. Келме.
Dialogue: 0,0:05:42.92,0:05:45.92,Default,,0,0,0,,Абайлаңыз.
Dialogue: 0,0:05:45.92,0:05:48.86,Default,,0,0,0,,Мен сені жек көремін. →
Dialogue: 0,0:05:48.86,0:05:52.85,Default,,0,0,0,,Бұл қазір ғана емес, бала кезімнен.
Dialogue: 0,0:05:52.85,0:05:55.92,Default,,0,0,0,,Ол кезде... Тіпті сол кезде... →
Dialogue: 0,0:05:55.92,0:05:58.29,Default,,0,0,0,,Сол кезде де мен сенімен бірге болдым→
Dialogue: 0,0:05:58.29,0:06:01.39,Default,,0,0,0,,Мен сені үмітсіздіктің түбіне дейін құлатқым келді! →
Dialogue: 0,0:06:02.96,0:06:07.65,Default,,0,0,0,,Бірақ... неге жарығыңнан айырылмайсың? →
Dialogue: 0,0:06:07.65,0:06:12.47,Default,,0,0,0,,Қарғыс атсын... Бұл басқаша ма? →
Dialogue: 0,0:06:12.47,0:06:14.52,Default,,0,0,0,,Қараңғыда жалғыз мен ғана. →
Dialogue: 0,0:06:14.52,0:06:18.59,Default,,0,0,0,,Мен жалғыз туылған маскүнем бе?
Dialogue: 0,0:06:18.59,0:06:20.59,Default,,0,0,0,,Қасым….
Dialogue: 0,0:06:23.06,0:06:25.88,Default,,0,0,0,,Қарғыс атсын... Қарғыс атсын →
Dialogue: 0,0:06:25.88,0:06:27.98,Default,,0,0,0,,Маған не істедің!?
Dialogue: 0,0:06:30.20,0:06:32.37,Default,,0,0,0,,Қарғыс атсын! Уф….
Dialogue: 0,0:06:32.37,0:06:36.69,Default,,0,0,0,,Алибаба-кун, Раффтың дауысында ешқандай жалғандық жоқ. →
Dialogue: 0,0:06:36.69,0:06:41.48,Default,,0,0,0,,Сондықтан бұл сізді қатты ренжітуі мүмкін. →
Dialogue: 0,0:06:41.48,0:06:44.08,Default,,0,0,0,,Бірақ сенің қолыңнан келетініне сенімдімін. →
Dialogue: 0,0:06:45.45,0:06:49.10,Default,,0,0,0,,Біреуді сөзсіз құтқару үшін бәріне тәуекел етесіз→
Dialogue: 0,0:06:49.10,0:06:51.87,Default,,0,0,0,,Ержүрек адам. →
Dialogue: 0,0:06:51.87,0:06:56.24,Default,,0,0,0,,Өйткені мен таңдаған патшаның ыдысымын.
Dialogue: 0,0:06:56.24,0:06:59.13,Default,,0,0,0,,Сізге →
Dialogue: 0,0:06:59.13,0:07:03.98,Default,,0,0,0,,Сол мейірімді анамен бірге патшалық қан ағады.
Dialogue: 0,0:07:03.98,0:07:07.58,Default,,0,0,0,,Сол бейбақ қарттың қаны менің тамырларымнан өтеді.
Dialogue: 0,0:07:09.62,0:07:11.72,Default,,0,0,0,,Әрине, бұл басқаша. →
Dialogue: 0,0:07:13.23,0:07:15.68,Default,,0,0,0,,Дүние осылай жұмыс істейді. →
Dialogue: 0,0:07:15.68,0:07:19.25,Default,,0,0,0,,Хе, мен мұны бала болсам да түсіндім. →
Dialogue: 0,0:07:19.25,0:07:22.89,Default,,0,0,0,,Бірақ бұл әділетсіздік емес пе?
Dialogue: 0,0:07:22.89,0:07:25.11,Default,,0,0,0,,Туған сәттен бастап қалай өмір сүру керек →
Dialogue: 0,0:07:25.11,0:07:27.21,Default,,0,0,0,,Бұл қазірдің өзінде шешілді!
Dialogue: 0,0:07:27.21,0:07:30.33,Default,,0,0,0,,Ах! Сондықтан мен шештім!
Dialogue: 0,0:07:30.33,0:07:33.33,Default,,0,0,0,,Тағдыр болса, осы қолдармен→
Dialogue: 0,0:07:33.33,0:07:37.23,Default,,0,0,0,,Мына шіркінді қарашы, мен тағдырдың өшін аламын!!
Dialogue: 0,0:07:39.24,0:07:41.79,Default,,0,0,0,,Уф... уау! Аа….
Dialogue: 0,0:07:41.79,0:07:44.43,Default,,0,0,0,,Маған ұнамайды Маған ұнамайды.
Dialogue: 0,0:07:44.43,0:07:46.53,Default,,0,0,0,,Ха! (Қасымның дауысы) Сол жерде →
Dialogue: 0,0:07:46.53,0:07:51.15,Default,,0,0,0,,Біз туып өссек те, сен екеуміз мүлдем басқа едік. →
Dialogue: 0,0:07:51.15,0:07:55.77,Default,,0,0,0,,Сіз әрқашан жарықта өмір сүретін жалғыз адам болдыңыз.
Dialogue: 0,0:07:55.77,0:07:58.29,Default,,0,0,0,,≪Дауыстар кіріп жатыр≫
Dialogue: 0,0:07:58.29,0:08:00.32,Default,,0,0,0,,Біз басқаша туылғандықтан...
Dialogue: 0,0:08:00.32,0:08:04.11,Default,,0,0,0,,Уау! Уф... Уау!
Dialogue: 0,0:08:04.11,0:08:07.11,Default,,0,0,0,,Қай жерде болсаңыз да, тура және шынайы өмір сүріңіз.
Dialogue: 0,0:08:07.11,0:08:09.15,Default,,0,0,0,,Жоқ….
Dialogue: 0,0:08:09.15,0:08:11.20,Default,,0,0,0,,Маған сенің жақсы адам сияқты әрекет еткенің ұнамайды!
Dialogue: 0,0:08:11.20,0:08:14.67,Default,,0,0,0,,Жоқ! Қарғыс атсын!
Dialogue: 0,0:08:14.67,0:08:16.96,Default,,0,0,0,,Баки! Жоқ!!
Dialogue: 0,0:08:16.96,0:08:18.99,Default,,0,0,0,,Гах... Мен сондаймын →
Dialogue: 0,0:08:18.99,0:08:21.46,Default,,0,0,0,,Сіз әдемі адам емессіз! Ах.
Dialogue: 0,0:08:21.46,0:08:24.15,Default,,0,0,0,,Мен жай ғана үмітсіз болдым!
Dialogue: 0,0:08:24.15,0:08:27.33,Default,,0,0,0,,Мен роялти немесе қан туралы ешқашан ойлаған емеспін!
Dialogue: 0,0:08:27.33,0:08:31.14,Default,,0,0,0,,Кейбір күндер азапты болды. Мен де лас істер жасадым.
Dialogue: 0,0:08:31.14,0:08:34.06,Default,,0,0,0,,Өзімді аяйтын кезім көп.
Dialogue: 0,0:08:34.06,0:08:37.36,Default,,0,0,0,,Қалағаныңызша орындаңыз→
Dialogue: 0,0:08:37.36,0:08:39.76,Default,,0,0,0,,Тек шешім қабылдамаңыз!!
Dialogue: 0,0:08:41.27,0:08:43.83,Default,,0,0,0,,Қарғыс атсын! Боқ...
Dialogue: 0,0:08:43.83,0:08:47.65,Default,,0,0,0,,Шулы! Шулы, шулы!
Dialogue: 0,0:08:47.65,0:08:51.73,Default,,0,0,0,,Мен сенен жеңіле алмаймын!!
Dialogue: 0,0:08:51.73,0:08:56.45,Default,,0,0,0,,Жеңіс пе, әлде жеңілу ме? Мұның қажеті жоқ!!
Dialogue: 0,0:08:56.45,0:08:59.73,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:59.73,0:09:04.05,Default,,0,0,0,,Бір түкпір-түкпірде туып-өскен, Дәл осылай жерде жорғалаған→
Dialogue: 0,0:09:04.05,0:09:06.61,Default,,0,0,0,,Екеумізді де лай басып қалдық!
Dialogue: 0,0:09:06.61,0:09:10.03,Default,,0,0,0,,Ешқандай айырмашылық жоқ! Әдемі нәрсе жасаңыз!
Dialogue: 0,0:09:10.03,0:09:13.93,Default,,0,0,0,,Сіз түсінбейсіз. Адамдар арасында айырмашылықтар бар!
Dialogue: 0,0:09:13.93,0:09:17.23,Default,,0,0,0,,Баки! Уф! Арх! Уф….
Dialogue: 0,0:09:23.52,0:09:26.71,Default,,0,0,0,,Оған көмектесу мүмкін емес. Хмм….
Dialogue: 0,0:09:26.71,0:09:30.01,Default,,0,0,0,,Қабілеттер Сыртқы түрі Тұлға→
Dialogue: 0,0:09:30.01,0:09:34.52,Default,,0,0,0,,Нәсіл, тек және бәрінен бұрын таптық айырмашылықтар→
Dialogue: 0,0:09:34.52,0:09:37.57,Default,,0,0,0,,Бізде не бар екенін бәріміз туған кезде білеміз→
Dialogue: 0,0:09:37.57,0:09:39.74,Default,,0,0,0,,Ол бекітілген. →
Dialogue: 0,0:09:39.74,0:09:44.34,Default,,0,0,0,,Ал бізде ештеңе жоқ... Ах.
Dialogue: 0,0:09:47.11,0:09:49.42,Default,,0,0,0,,Бұл қараңғы қала ма?
Dialogue: 0,0:09:49.42,0:09:52.22,Default,,0,0,0,,Анашым! Анашым! →
Dialogue: 0,0:09:52.22,0:09:54.25,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу бол 'uuuu...]]
Dialogue: 0,0:09:54.25,0:09:56.85,Default,,0,0,0,,Ух...)) ((Аа...))
Dialogue: 0,0:09:58.49,0:10:00.53,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:10:00.53,0:10:02.68,Default,,0,0,0,,Ах.
Dialogue: 0,0:10:02.68,0:10:07.27,Default,,0,0,0,,) ((Ауады... Ауырды...→
Dialogue: 0,0:10:07.27,0:10:10.82,Default,,0,0,0,,Үлкен аға...)) ((Ах Мариям...→
Dialogue: 0,0:10:10.82,0:10:14.66,Default,,0,0,0,,Мариям… Мариям~!!))
Dialogue: 0,0:10:14.66,0:10:19.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:19.81,0:10:26.95,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:10:26.95,0:10:29.96,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:29.96,0:10:33.03,Default,,0,0,0,,((Ол жерде жоқ емес еді, ұрланған, солай ма?→
Dialogue: 0,0:10:33.03,0:10:35.78,Default,,0,0,0,,Корольдік отбасына)) ()
Dialogue: 0,0:10:35.78,0:10:38.37,Default,,0,0,0,,((Бұл ел ғана емес. Бүгінгі әлем →
Dialogue: 0,0:10:38.37,0:10:41.00,Default,,0,0,0,,Төменгі жағын пайдалану арқылы →
Dialogue: 0,0:10:41.00,0:10:43.52,Default,,0,0,0,,Бұл дұрыс. →
Dialogue: 0,0:10:43.52,0:10:46.86,Default,,0,0,0,,Бұл жексұрын тағдыр. →
Dialogue: 0,0:10:46.86,0:10:48.89,Default,,0,0,0,,Бұл жақсы ма? →
Dialogue: 0,0:10:48.89,0:10:53.18,Default,,0,0,0,,Сіз өмір бойы жоғары қарап өмір сүресіз бе? →
Dialogue: 0,0:10:53.18,0:10:57.57,Default,,0,0,0,,Төңкеріске деген ерік-жігерің болса →
Dialogue: 0,0:10:57.57,0:10:59.60,Default,,0,0,0,,Қол ұшын беруге рұқсат етіңіз))
Dialogue: 0,0:10:59.60,0:11:03.74,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:03.74,0:11:06.33,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:11:06.33,0:11:09.68,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:11:09.68,0:11:12.57,Default,,0,0,0,,Мен сенің тағдырыңды өзгертемін.
Dialogue: 0,0:11:12.57,0:11:16.59,Default,,0,0,0,,Мұны кез келген адам жасай алады, тіпті маған ұқсайтын қоқыс.
Dialogue: 0,0:11:16.59,0:11:19.64,Default,,0,0,0,,Менен мүлдем басқа→
Dialogue: 0,0:11:19.64,0:11:23.18,Default,,0,0,0,,Керемет нәрсеге! Ах!
Dialogue: 0,0:11:23.18,0:11:25.68,Default,,0,0,0,,Сіз мұны істей алуыңыз керек!
Dialogue: 0,0:11:27.08,0:11:29.08,Default,,0,0,0,,Тос!
Dialogue: 0,0:11:41.13,0:11:43.13,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:11:46.77,0:11:50.67,Default,,0,0,0,,≪Не? Бірдеңе ағып жатыр≫
Dialogue: 0,0:11:50.67,0:11:52.71,Default,,0,0,0,,Ах.
Dialogue: 0,0:11:52.71,0:11:55.49,Default,,0,0,0,,≪Alibaba? ≫
Dialogue: 0,0:11:55.49,0:11:58.90,Default,,0,0,0,,Бұл көңілсіз, сондай аянышты... →
Dialogue: 0,0:11:58.90,0:12:01.68,Default,,0,0,0,,Қасымның → деп ойлағанына сене алар емеспін
Dialogue: 0,0:12:01.68,0:12:04.23,Default,,0,0,0,,Мен оны байқамадым... →
Dialogue: 0,0:12:04.23,0:12:09.21,Default,,0,0,0,,Негізі байқаған шығар. →
Dialogue: 0,0:12:09.21,0:12:13.18,Default,,0,0,0,,Бірақ біз үмітсіз →
Dialogue: 0,0:12:13.18,0:12:15.40,Default,,0,0,0,,Мені атап көрсетуден қорқамын →
Dialogue: 0,0:12:15.40,0:12:18.82,Default,,0,0,0,,Мүмкін мен қашып бара жатқан шығармын. →
Dialogue: 0,0:12:18.82,0:12:23.29,Default,,0,0,0,,Айырмашылық адам санымен бірдей болуы мүмкін. →
Dialogue: 0,0:12:23.29,0:12:25.71,Default,,0,0,0,,Бірақ менің ойымша...→
Dialogue: 0,0:12:25.71,0:12:28.36,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:12:28.36,0:12:31.29,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:31.29,0:12:33.56,Default,,0,0,0,,Бакин! Ах!
Dialogue: 0,0:12:33.56,0:12:36.57,Default,,0,0,0,,Бірақ болуы керек. →
Dialogue: 0,0:12:36.57,0:12:41.25,Default,,0,0,0,,Сонда да әр адамның бақытты өмір сүруінің жолы бар...→
Dialogue: 0,0:12:41.25,0:12:44.26,Default,,0,0,0,,Мұны істеудің жолы бар!
Dialogue: 0,0:12:44.26,0:12:48.51,Default,,0,0,0,,≪Мен бұл туралы ойлана бастадым≫
Dialogue: 0,0:12:48.51,0:12:52.60,Default,,0,0,0,,≪Мен бұл үмітсіз айырмашылық туралы бірдеңе жасауға тырысамын...≫
Dialogue: 0,0:12:52.60,0:13:03.39,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:03.39,0:13:06.25,Default,,0,0,0,,≪“Қайғылы”≫
Dialogue: 0,0:13:06.25,0:13:09.05,Default,,0,0,0,,<<Осылай қабылдауым керек пе еді? ≫
Dialogue: 0,0:13:10.98,0:13:13.84,Default,,0,0,0,,≪Қанша қол созсаңыз да →
Dialogue: 0,0:13:13.84,0:13:16.99,Default,,0,0,0,,Бұл жігіт екеуміз басқа адамдармыз. →
Dialogue: 0,0:13:16.99,0:13:19.03,Default,,0,0,0,,Олар бірдей болуы мүмкін емес≫
Dialogue: 0,0:13:19.03,0:13:22.51,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:13:22.51,0:13:26.40,Default,,0,0,0,,() ((Иә? Хахаха!))
Dialogue: 0,0:13:26.40,0:13:30.49,Default,,0,0,0,,≪Өзге болуды қабылдаңыз→
Dialogue: 0,0:13:30.49,0:13:33.67,Default,,0,0,0,,Әр жерде, әр өмірде →
Dialogue: 0,0:13:33.67,0:13:35.71,Default,,0,0,0,,Толық өмір сүрсең...≫
Dialogue: 0,0:13:35.71,0:13:41.05,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:41.05,0:13:44.70,Default,,0,0,0,,Уф... Мен солай істеймін →
Dialogue: 0,0:13:44.70,0:13:48.72,Default,,0,0,0,,Мен өзіңмен бір орында тұруға мәжбүр болдым.
Dialogue: 0,0:13:48.72,0:13:54.91,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:54.91,0:13:58.90,Default,,0,0,0,,Pakipkipkiggoooo!
Dialogue: 0,0:13:58.90,0:14:00.97,Default,,0,0,0,,Алибаба-кун! Tsk!
Dialogue: 0,0:14:00.97,0:14:02.97,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:05.02,0:14:07.02,Default,,0,0,0,,Тікелей бекіту
Dialogue: 0,0:14:09.13,0:14:11.65,Default,,0,0,0,,Джин құлап қалады.
Dialogue: 0,0:14:11.65,0:14:14.20,Default,,0,0,0,,Сіз осы уақытқа дейін жеткен сияқтысыз.
Dialogue: 0,0:14:14.20,0:14:17.77,Default,,0,0,0,,Қасым мен саған көмектесуге келдім.
Dialogue: 0,0:14:17.77,0:14:22.09,Default,,0,0,0,,Бұл жеткілікті. Қатысқандарға →
Dialogue: 0,0:14:22.09,0:14:25.09,Default,,0,0,0,,Кешіріңіз, мен бір рет кешірім сұрай алмаймын.
Dialogue: 0,0:14:26.48,0:14:28.81,Default,,0,0,0,,Сізбен көбірек →
Dialogue: 0,0:14:28.81,0:14:31.82,Default,,0,0,0,,Мен сенімен сөйлескенімді қалаймын.
Dialogue: 0,0:14:31.82,0:14:34.27,Default,,0,0,0,,Қасым…. ≪Пакин!
Dialogue: 0,0:14:34.27,0:14:39.62,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:39.62,0:14:42.02,Default,,0,0,0,,А... күте тұр, Қасым!
Dialogue: 0,0:14:43.43,0:14:46.18,Default,,0,0,0,,Эй, Alibaba →
Dialogue: 0,0:14:46.18,0:14:48.65,Default,,0,0,0,,Біз... келіңіздер...
Dialogue: 0,0:14:48.65,0:14:50.65,Default,,0,0,0,,Бұл не!? Қасым!
Dialogue: 0,0:14:52.19,0:14:54.19,Default,,0,0,0,,Хаха….
Dialogue: 0,0:14:56.57,0:14:59.99,Default,,0,0,0,,)) (Қасым әке) ((Қарғыс атқыр бала!))
Dialogue: 0,0:14:59.99,0:15:02.93,Default,,0,0,0,,) ((Уф!))
Dialogue: 0,0:15:02.93,0:15:13.49,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:15:13.49,0:15:15.64,Default,,0,0,0,,) ((Сол жігіт, уақыт келді →
Dialogue: 0,0:15:15.64,0:15:18.30,Default,,0,0,0,,Бұл оларға тұтынушыларды қабылдауға мүмкіндік беретін жақсы уақыт шығар. →
Dialogue: 0,0:15:18.30,0:15:22.20,Default,,0,0,0,,Біраз уақыт ақша ішуге тура келеді)) ((уф!))
Dialogue: 0,0:15:23.63,0:15:27.89,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:15:27.89,0:15:32.03,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:32.03,0:15:34.23,Default,,0,0,0,,() ((Ah…))
Dialogue: 0,0:15:35.86,0:15:39.47,Default,,0,0,0,,((Гух... Қасым...→
Dialogue: 0,0:15:39.47,0:15:44.20,Default,,0,0,0,,Сен мен сияқты ең жаман ақымақсың...))
Dialogue: 0,0:15:44.20,0:15:46.60,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:15:48.29,0:15:50.81,Default,,0,0,0,,((Haa… haa…→
Dialogue: 0,0:15:50.81,0:15:54.41,Default,,0,0,0,,Тәтті... Тәтті! Шіркін~!!))
Dialogue: 0,0:15:59.94,0:16:02.16,Default,,0,0,0,,≪Әлі...→
Dialogue: 0,0:16:02.16,0:16:05.46,Default,,0,0,0,,Мен осындай болсам да, ол жалғыз...≫
Dialogue: 0,0:16:07.61,0:16:18.72,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:16:18.72,0:16:24.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:24.11,0:16:26.91,Default,,0,0,0,,((Эй, Alibaba →
Dialogue: 0,0:16:26.91,0:16:31.41,Default,,0,0,0,,Біз... келіңіздер... Хаха...))
Dialogue: 0,0:16:33.42,0:16:36.96,Default,,0,0,0,,Ха! Неліктен...→
Dialogue: 0,0:16:36.96,0:16:39.36,Default,,0,0,0,,Неліктен бұлай сұрайсыз?
Dialogue: 0,0:16:39.36,0:16:42.60,Default,,0,0,0,,Бұл емес... Бұл емес →
Dialogue: 0,0:16:42.60,0:16:45.90,Default,,0,0,0,,Әрине сен ақымақ~!!
Dialogue: 0,0:16:45.90,0:16:48.65,Default,,0,0,0,,Қарғыс атсын! Ха ха ха ха….
Dialogue: 0,0:16:48.65,0:16:51.91,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:51.91,0:16:53.91,Default,,0,0,0,,Біз...
Dialogue: 0,0:16:55.86,0:16:57.89,Default,,0,0,0,,Біз...
Dialogue: 0,0:16:57.89,0:17:01.62,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:01.62,0:17:03.67,Default,,0,0,0,,Олар достар!!
Dialogue: 0,0:17:03.67,0:17:12.91,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:12.91,0:17:14.94,Default,,0,0,0,,Цк. ≫Уф….
Dialogue: 0,0:17:14.94,0:17:18.30,Default,,0,0,0,,Иә? Не? Қуат...
Dialogue: 0,0:17:18.30,0:17:20.35,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:17:20.35,0:17:24.60,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:24.60,0:17:26.64,Default,,0,0,0,,Қайта кездескенше, Маги.
Dialogue: 0,0:17:26.64,0:17:32.40,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:32.40,0:17:37.27,Default,,0,0,0,,Уф... Уф... Күрсін....
Dialogue: 0,0:17:37.27,0:17:42.01,Default,,0,0,0,,Ах... Уф! Уф….
Dialogue: 0,0:17:42.01,0:17:49.15,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:49.15,0:17:52.63,Default,,0,0,0,,Алибаба-кунға қош келдіңіз.
Dialogue: 0,0:17:52.63,0:17:56.17,Default,,0,0,0,,Ах! Ахх... Уф...
Dialogue: 0,0:17:56.17,0:17:59.77,Default,,0,0,0,,Ах... Уф...
Dialogue: 0,0:20:05.55,0:20:09.62,Default,,0,0,0,,Ол Сүлейменнің даналығын алған төртінші магия ма? →
Dialogue: 0,0:20:09.62,0:20:11.99,Default,,0,0,0,,Хаха, қызық. →
Dialogue: 0,0:20:11.99,0:20:14.87,Default,,0,0,0,,Алайық! Сіз де →
Dialogue: 0,0:20:14.87,0:20:18.41,Default,,0,0,0,,Сіз таңдаған патшаның барлық ыдыстары→
Dialogue: 0,0:20:18.41,0:20:21.18,Default,,0,0,0,,Ол бізді қараңғылығымызбен бояйды.
Dialogue: 0,0:20:21.18,0:20:23.45,Default,,0,0,0,,≫Бұл мүмкін емес. (Иснан) А?
Dialogue: 0,0:20:23.45,0:20:26.70,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:26.70,0:20:29.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:29.57,0:20:32.88,Default,,0,0,0,,Бағынышты қару Важра сауыт.
Dialogue: 0,0:20:32.88,0:20:35.70,Default,,0,0,0,,Қарғыс атсын... Ха!
Dialogue: 0,0:20:35.70,0:20:38.52,Default,,0,0,0,,Бағыныңқы: Егіз жылан.
Dialogue: 0,0:20:38.52,0:20:41.89,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:41.89,0:20:43.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:43.92,0:20:47.42,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:47.42,0:20:50.99,Default,,0,0,0,,Арх! Бұл... Мен бұған сене алар емеспін!
Dialogue: 0,0:20:50.99,0:20:53.05,Default,,0,0,0,,≫Барибарибарибари...(Найзағай) Га.
Dialogue: 0,0:20:53.05,0:20:56.88,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:56.88,0:21:00.35,Default,,0,0,0,,Қарғыс атсын! Неліктен...→
Dialogue: 0,0:21:00.35,0:21:04.15,Default,,0,0,0,,Неге сен сияқты адам бар!?→
Dialogue: 0,0:21:05.64,0:21:10.46,Default,,0,0,0,,Жеті теңіздің Иесі, Синдбад!
Dialogue: 0,0:21:10.46,0:21:12.78,Default,,0,0,0,,«Найзағай, жарық, қылыш»!
Dialogue: 0,0:21:12.78,0:21:17.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:17.34,0:21:22.64,Default,,0,0,0,,Уау!!
Dialogue: 0,0:21:33.07,0:21:35.46,Default,,0,0,0,,Уф... уф... (Жафар) Әй!
Dialogue: 0,0:21:35.46,0:21:37.56,Default,,0,0,0,,Амансың ба? Шин.
Dialogue: 0,0:21:37.56,0:21:42.13,Default,,0,0,0,,Ах…. Әйтеуір олардың көлеңкесін өшіріп алдым.
Dialogue: 0,0:21:42.13,0:21:45.00,Default,,0,0,0,,Жоқ, менің күйеуім күткендей! (3 адам) Иә?
Dialogue: 0,0:21:45.00,0:21:47.47,Default,,0,0,0,,Қорқынышты түрде.
Dialogue: 0,0:21:47.47,0:21:49.47,Default,,0,0,0,,Хаха…. (Джафар) Хмм...
Dialogue: 0,0:21:54.42,0:21:56.42,Default,,0,0,0,,≪Таяз болды ма...≫
Dialogue: 0,0:22:08.40,0:22:11.26,Default,,0,0,0,,О? О...
Dialogue: 0,0:22:11.26,0:22:13.44,Default,,0,0,0,,Бұл.
Dialogue: 0,0:22:13.44,0:22:17.54,Default,,0,0,0,,Сізді ұрып-соқты. Сені ұрып-соққан.
Dialogue: 0,0:22:18.97,0:22:21.87,Default,,0,0,0,,Бірақ бұл туралы ештеңе істей алмаймыз. →
Dialogue: 0,0:22:23.50,0:22:28.27,Default,,0,0,0,,Қасиетті сарайда жасырылған сол Маги пайда болады.
Dialogue: 0,0:22:28.27,0:22:32.23,Default,,0,0,0,,Оның үстіне Маги және ол таңдаған корольдік ыдыс →
Dialogue: 0,0:22:32.23,0:22:36.13,Default,,0,0,0,,Біз сол бірінші дәрежелі ерекше адаммен бірге жұмыс істеп жатырмыз.
Dialogue: 0,0:22:36.13,0:22:40.27,Default,,0,0,0,,Хмм…. Уайымдаудың қажеті жоқ. →
Dialogue: 0,0:22:40.27,0:22:44.29,Default,,0,0,0,,Бұл жай ғана Сүлейменнің кәдімгі «менмен араласуы».
Dialogue: 0,0:22:44.29,0:22:48.73,Default,,0,0,0,,Осыған ұқсас нәрсе бірнеше ғасырда бірнеше рет болған.
Dialogue: 0,0:22:48.73,0:22:52.93,Default,,0,0,0,,Бізге жай ғана тұрып, берілмеу керек.
Dialogue: 0,0:22:52.93,0:22:56.35,Default,,0,0,0,,Дұрыс. бұл дұрыс.
Dialogue: 0,0:22:56.35,0:22:58.76,Default,,0,0,0,,Біз мәңгі болашақта →
Dialogue: 0,0:22:58.76,0:23:03.58,Default,,0,0,0,,Біз бұл дүниеде қараңғылықты жасай береміз делік.
Dialogue: 0,0:23:03.58,0:23:07.43,Default,,0,0,0,,Әкеміздің жаратылысы...
Dialogue: 0,0:23:07.43,0:23:11.38,Default,,0,0,0,,Шынайы адамдар қауымы.
Dialogue: 0,0:23:11.38,0:23:15.18,Default,,0,0,0,,Гаппосей жоспарын сол күйінде қалдырыңыз.
Dialogue: 0,0:23:20.51,0:23:23.80,Default,,0,0,0,,Кешіріңіз Қасым...→
Dialogue: 0,0:23:23.80,0:23:26.08,Default,,0,0,0,,Мен сізге көмектесе алмаймын.
Dialogue: 0,0:23:26.08,0:23:29.18,Default,,0,0,0,,Мен ештеңе істей алмадым...
Dialogue: 0,0:23:31.07,0:23:33.11,Default,,0,0,0,,Alibaba-kun→
Dialogue: 0,0:23:33.11,0:23:35.56,Default,,0,0,0,,Мәңгілік жылай алмайсың.
Dialogue: 0,0:23:35.56,0:23:37.94,Default,,0,0,0,,Ол қайтып орала алмайды.
Dialogue: 0,0:23:37.94,0:23:39.94,Default,,0,0,0,,Қайтару?
Dialogue: 0,0:23:43.25,0:23:47.62,Default,,0,0,0,,Өлген адамдар жайдан-жай жоғалып кетпейді.
Dialogue: 0,0:23:47.62,0:23:51.22,Default,,0,0,0,,Бұл жаңа ғана ұлы Руфқа оралады.
Dialogue: 0,0:23:53.33,0:23:55.33,Default,,0,0,0,,Сүлейменнің даналығы!
Dialogue: 0,0:23:57.95,0:23:59.95,Default,,0,0,0,,Уф!
Dialogue: 0,0:24:01.97,0:24:04.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:04.00,0:24:08.57,Default,,0,0,0,,Ана…. О... бұрынғы Барбад патшасы!
Dialogue: 0,0:24:08.57,0:24:12.30,Default,,0,0,0,,Олар Руф → болды
Dialogue: 0,0:24:12.30,0:24:15.23,Default,,0,0,0,,Енді үлкенірек нәрсенің бөлігі →
Dialogue: 0,0:24:15.23,0:24:18.23,Default,,0,0,0,,Дүниені орап, ағып жатыр.
Dialogue: 0,0:24:18.23,0:24:21.29,Default,,0,0,0,,Сондықтан адам өлсе мұңды→
Dialogue: 0,0:24:21.29,0:24:24.59,Default,,0,0,0,,Бұл мәңгі қоштасу емес.
Dialogue: 0,0:24:24.59,0:24:27.41,Default,,0,0,0,,Сенің жолың, сенің өмір жолың→
Dialogue: 0,0:24:27.41,0:24:30.30,Default,,0,0,0,,Олар үнемі қарап тұрады.
Dialogue: 0,0:24:30.30,0:24:33.08,Default,,0,0,0,,Мен сені үнемі бақылап отырамын.
Dialogue: 0,0:24:33.08,0:24:35.75,Default,,0,0,0,,Аа….
Dialogue: 0,0:24:35.75,0:24:37.97,Default,,0,0,0,,Келіңіздер, бәріңіз!
Dialogue: 0,0:24:37.97,0:24:40.44,Default,,0,0,0,,Сүйікті адамға қайта оралыңыз!
Dialogue: 0,0:24:40.44,0:24:55.25,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:55.25,0:24:58.45,Default,,0,0,0,,Ана. Уф...
Dialogue: 0,0:25:00.24,0:25:02.24,Default,,0,0,0,,Ах... (Абмад Субмад) Ах!
Dialogue: 0,0:25:03.71,0:25:05.71,Default,,0,0,0,,Уф... Мм....
Dialogue: 0,0:25:09.32,0:25:11.37,Default,,0,0,0,,Мариям!
Dialogue: 0,0:25:11.37,0:25:16.56,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:16.56,0:25:18.56,Default,,0,0,0,,Хехе. иә?
Dialogue: 0,0:25:21.30,0:25:23.30,Default,,0,0,0,,Хаха.
Dialogue: 0,0:25:26.52,0:25:29.04,Default,,0,0,0,,Иә.
Dialogue: 0,0:25:29.04,0:25:31.04,Default,,0,0,0,,Аа….
Dialogue: 0,0:25:35.21,0:25:48.99,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:51.54,0:25:54.18,Default,,0,0,0,,Эй, сен шынымен →
Dialogue: 0,0:25:54.18,0:25:57.18,Default,,0,0,0,,Сіз оларды құтқара алмадым деп ойлайсыз ба?
Dialogue: 0,0:25:57.18,0:26:00.37,Default,,0,0,0,,Бұл елдегі досыңның... қараңғылығы →
Dialogue: 0,0:26:00.37,0:26:02.37,Default,,0,0,0,,Күн ашық.
Dialogue: 0,0:26:06.54,0:26:09.43,Default,,0,0,0,,Аладдин! Алибаба мырза!
Dialogue: 0,0:26:09.43,0:26:11.88,Default,,0,0,0,,Ах. Мол-сан!
Dialogue: 0,0:26:11.88,0:26:13.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:16.27,0:26:18.77,Default,,0,0,0,,Magi дегеніміз не? Бұл керемет.
Dialogue: 0,0:26:20.59,0:26:22.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:22.63,0:26:27.73,Default,,0,0,0,,♪♪~
Dialogue: 0,0:27:59.69,0:28:01.91,Default,,0,0,0,,Сегіз генерал шақырылды. Ха! →
Dialogue: 0,0:28:01.91,0:28:04.84,Default,,0,0,0,,Біздің кезегіміз. Ұзақ болды. →
Dialogue: 0,0:28:04.84,0:28:07.04,Default,,0,0,0,,Менің кезегім келді деп ойладым.
Dialogue: 0,0:28:09.70,0:28:12.70,Default,,0,0,0,,Жаңа даму басталады! Оны асыға күтіңіздер!
Dialogue: 0,0:30:41.33,0:30:44.10,Default,,0,0,0,,Алдымен марафон жарысынан бастайық.
Dialogue: 0,0:30:49.04,0:30:52.19,Default,,0,0,0,,Бұл сондай-ақ тамыз айында Мәскеуде өтетін жеңіл атлетикадан әлем чемпионатының өкілдерін таңдау ретінде қызмет етеді.
Dialogue: 0,0:30:52.19,0:30:54.45,Default,,0,0,0,,Беппу Ойта Майничи марафонында,
Dialogue: 0,0:30:55.95,0:31:00.95,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
