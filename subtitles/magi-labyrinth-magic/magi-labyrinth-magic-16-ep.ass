Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.08,0:00:36.76,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:36.76,0:00:39.73,Default,,0,0,0,,Керемет!!
Dialogue: 0,0:00:39.73,0:00:42.37,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:00:42.37,0:00:47.29,Default,,0,0,0,,Блэк Руфтың Джинді жаттықтыру әдістемесі→
Dialogue: 0,0:00:47.29,0:00:49.31,Default,,0,0,0,,Бұл сәтті болған сияқты.
Dialogue: 0,0:00:49.31,0:00:56.45,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:56.45,0:00:59.30,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:00:59.30,0:01:07.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:07.34,0:01:09.34,Default,,0,0,0,,Уф! Таң!
Dialogue: 0,0:01:11.00,0:01:13.55,Default,,0,0,0,,Алибаба мырза, мықты болыңыз!
Dialogue: 0,0:01:13.55,0:01:15.95,Default,,0,0,0,,Осы қарқынмен бәріміз де жаншылып қаламыз!
Dialogue: 0,0:01:18.40,0:01:21.40,Default,,0,0,0,,≪Бұл Қасым ба? ≫
Dialogue: 0,0:01:23.13,0:01:56.47,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:00.41,0:02:53.05,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:59.49,0:03:03.39,Default,,0,0,0,,А... Әй... Әй, мен саған қарап тұрмын.
Dialogue: 0,0:03:05.61,0:03:08.01,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:03:08.01,0:03:10.01,Default,,0,0,0,,Дока!
Dialogue: 0,0:03:12.45,0:03:14.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:14.89,0:03:18.49,Default,,0,0,0,,Алибаба-сан, асығыңыз! Оны Алибабаның қылышымен өлтір!
Dialogue: 0,0:03:19.77,0:03:21.77,Default,,0,0,0,,Қасым ба?
Dialogue: 0,0:03:23.20,0:03:25.86,Default,,0,0,0,,Ха! Заш!
Dialogue: 0,0:03:25.86,0:03:28.56,Default,,0,0,0,,Керемет!
Dialogue: 0,0:03:37.44,0:03:39.54,Default,,0,0,0,,Алибаба мырза, тағы да!
Dialogue: 0,0:03:40.93,0:03:42.93,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:03:44.82,0:03:47.74,Default,,0,0,0,,Керемет!
Dialogue: 0,0:03:47.74,0:04:04.44,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:04.44,0:04:06.54,Default,,0,0,0,,Ойнатылған.
Dialogue: 0,0:04:06.54,0:04:10.14,Default,,0,0,0,,Қара Джин жеткізілгенше →
Dialogue: 0,0:04:10.14,0:04:12.84,Default,,0,0,0,,Шексіз жаңғырды. Және →
Dialogue: 0,0:04:12.84,0:04:16.35,Default,,0,0,0,,Сол қара иірімді не жасайды→
Dialogue: 0,0:04:16.35,0:04:19.90,Default,,0,0,0,,Адамның реніші. Әлемді жек көру →
Dialogue: 0,0:04:19.90,0:04:23.19,Default,,0,0,0,,Тағдырды жек көретін адамдардың кекінің өзі →
Dialogue: 0,0:04:23.19,0:04:26.76,Default,,0,0,0,,Бұл дүниеде қараңғылық тудыратын тамақ.
Dialogue: 0,0:04:26.76,0:04:30.13,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:30.13,0:04:33.13,Default,,0,0,0,,Аа….
Dialogue: 0,0:04:33.13,0:04:36.53,Default,,0,0,0,,Керемет!
Dialogue: 0,0:04:37.92,0:04:40.12,Default,,0,0,0,,≪Ол үлкейіп барады≫
Dialogue: 0,0:04:40.12,0:04:42.19,Default,,0,0,0,,≪Тағы бір соққы≫
Dialogue: 0,0:04:42.19,0:04:47.15,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:47.15,0:04:49.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:51.10,0:04:53.10,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:54.67,0:04:57.86,Default,,0,0,0,,Бум! (Барлығы) Уау!
Dialogue: 0,0:04:57.86,0:05:02.11,Default,,0,0,0,,Қарғыс атқыр... Енді қандай құдірет бар?
Dialogue: 0,0:05:02.11,0:05:04.96,Default,,0,0,0,,≫Ей, не? Бұл! ≪Ой...
Dialogue: 0,0:05:04.96,0:05:06.97,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:06.97,0:05:11.02,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:11.02,0:05:13.69,Default,,0,0,0,,Қара Джин ауырлық күшін басқарады. →
Dialogue: 0,0:05:13.69,0:05:16.73,Default,,0,0,0,,Тіпті қол тигізбейтін ауырлық→
Dialogue: 0,0:05:16.73,0:05:18.79,Default,,0,0,0,,(Кондуктор) Сен, сол жерде тұр! Ей! Қауіпті!
Dialogue: 0,0:05:18.79,0:05:21.50,Default,,0,0,0,,≪Сондай бірдеңе, тіпті Alibaba-ның қылышы→
Dialogue: 0,0:05:21.50,0:05:23.50,Default,,0,0,0,,Алдын алу мүмкін емес≫
Dialogue: 0,0:05:25.45,0:05:29.20,Default,,0,0,0,,Қарғыс атсын! Мен сізге рұқсат беруді күте алмаймын! Ханзада Алибаба!
Dialogue: 0,0:05:29.20,0:05:31.66,Default,,0,0,0,,Аа….
Dialogue: 0,0:05:31.66,0:05:34.66,Default,,0,0,0,,Неге тек бізді нысанаға аласың!?
Dialogue: 0,0:05:37.25,0:05:40.15,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:05:40.15,0:05:42.45,Default,,0,0,0,,Арх! Уф….
Dialogue: 0,0:05:46.57,0:05:49.57,Default,,0,0,0,,Керемет!
Dialogue: 0,0:05:51.14,0:05:53.78,Default,,0,0,0,,Мазасыз адам пайда болды. →
Dialogue: 0,0:05:53.78,0:05:58.28,Default,,0,0,0,,Дегенмен, он мыңдаған өмірден жиналған қара Руф→
Dialogue: 0,0:05:58.28,0:06:00.65,Default,,0,0,0,,Қанша уақыт шыдай аласың?
Dialogue: 0,0:06:00.65,0:06:03.94,Default,,0,0,0,,Алибаба-кун, мен сені тежеп қоямын. →
Dialogue: 0,0:06:03.94,0:06:05.96,Default,,0,0,0,,Осы жігітке соңғы соққыны беріңіз!
Dialogue: 0,0:06:05.96,0:06:08.56,Default,,0,0,0,,Ах... Бұл жігітке →
Dialogue: 0,0:06:08.56,0:06:11.18,Default,,0,0,0,,Осы елдің корольдік отбасы Патша үкіметіне қатысқан адамдар→
Dialogue: 0,0:06:11.18,0:06:15.20,Default,,0,0,0,,Барлығын жою үшін революциялық ерік бар. →
Dialogue: 0,0:06:15.20,0:06:18.05,Default,,0,0,0,,Тек бұған жол бермеңіз. →
Dialogue: 0,0:06:18.05,0:06:19.97,Default,,0,0,0,,Қанда жасалған революция →
Dialogue: 0,0:06:19.97,0:06:23.78,Default,,0,0,0,,Жақсы себеп болғанша, зорлық-зомбылықтың барлық түрі ақталған!
Dialogue: 0,0:06:23.78,0:06:25.83,Default,,0,0,0,,Thud! Уф! →
Dialogue: 0,0:06:25.83,0:06:28.61,Default,,0,0,0,,Бұдан елді не құтқарады →
Dialogue: 0,0:06:28.61,0:06:32.08,Default,,0,0,0,,Қансыз революцияны қолдаған жалғыз сенсің.
Dialogue: 0,0:06:32.08,0:06:35.24,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:35.24,0:06:38.66,Default,,0,0,0,,Alibaba-ны өлтіріңіз!
Dialogue: 0,0:06:38.66,0:06:41.13,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:06:41.13,0:06:44.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:45.98,0:06:48.77,Default,,0,0,0,,Уау!!
Dialogue: 0,0:06:48.77,0:06:51.32,Default,,0,0,0,,Гакин!
Dialogue: 0,0:06:51.32,0:06:54.62,Default,,0,0,0,,Мен, Джоэстар, бұл жақсылықты ешқашан ұмытпаймын
Dialogue: 0,0:06:54.62,0:06:57.48,Default,,0,0,0,,≪Ол тістемейді. Қара дәндер→
Dialogue: 0,0:06:57.48,0:06:59.74,Default,,0,0,0,,Тек қылыштан жалтару≫
Dialogue: 0,0:06:59.74,0:07:04.32,Default,,0,0,0,,Қарғыс атсын! Ах... Жарайсың!
Dialogue: 0,0:07:04.32,0:07:07.79,Default,,0,0,0,,≪Амон, маған күш бер≫
Dialogue: 0,0:07:07.79,0:07:10.89,Default,,0,0,0,,≪Егер қазір жасамасаңыз, тым кеш! ≫
Dialogue: 0,0:07:10.89,0:07:14.49,Default,,0,0,0,,≪Қазір енетін күш...≫
Dialogue: 0,0:07:14.49,0:07:19.38,Default,,0,0,0,,Маған! Ооооооо!
Dialogue: 0,0:07:19.38,0:07:22.38,Default,,0,0,0,,Алға!!
Dialogue: 0,0:07:26.00,0:07:28.32,Default,,0,0,0,,Әли... Баба?
Dialogue: 0,0:07:28.32,0:07:30.33,Default,,0,0,0,,≪Қасым? ≫
Dialogue: 0,0:07:30.33,0:07:33.03,Default,,0,0,0,,Уау! Гррр….
Dialogue: 0,0:07:34.41,0:07:36.72,Default,,0,0,0,,Қасым….
Dialogue: 0,0:07:36.72,0:07:39.82,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:43.71,0:07:47.21,Default,,0,0,0,,Хмм! Қарғыс атсын... Арх!
Dialogue: 0,0:07:52.80,0:07:55.17,Default,,0,0,0,,Уф... ≫Тс
Dialogue: 0,0:07:55.17,0:07:57.90,Default,,0,0,0,,Уф…. Жарайды?
Dialogue: 0,0:07:57.90,0:07:59.90,Default,,0,0,0,,Морджиана.
Dialogue: 0,0:08:03.44,0:08:06.39,Default,,0,0,0,,Енді ше? Бұл сиқырлы манипуляция.
Dialogue: 0,0:08:06.39,0:08:10.72,Default,,0,0,0,,Мен де оның сиқырлы күшінің ағынын уақытша бөгеп тастадым.
Dialogue: 0,0:08:10.72,0:08:13.92,Default,,0,0,0,,Әзірше гравитациялық сиқырды пайдалана алмауыңыз керек.
Dialogue: 0,0:08:13.92,0:08:16.81,Default,,0,0,0,,Бір соққыға бар күшіңізді салыңыз.
Dialogue: 0,0:08:16.81,0:08:19.91,Default,,0,0,0,,Енді сіз оны міндетті түрде өте аласыз. иә!
Dialogue: 0,0:08:23.01,0:08:25.81,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:27.27,0:08:29.27,Default,,0,0,0,,Ах.
Dialogue: 0,0:08:31.47,0:08:33.57,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:08:40.18,0:08:42.18,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:08:43.60,0:08:46.35,Default,,0,0,0,,≪Ұлттық армияның барлық мүшелері шабуылға дайын! →
Dialogue: 0,0:08:46.35,0:08:49.74,Default,,0,0,0,,≪Құбыжықтың алға қадам басуына жол берме! Ах!
Dialogue: 0,0:08:49.74,0:08:52.57,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:52.57,0:08:54.86,Default,,0,0,0,,13-ші взвод заряды!
Dialogue: 0,0:08:54.86,0:08:57.86,Default,,0,0,0,,24-ші взвод солға қарай орналасады!
Dialogue: 0,0:09:00.32,0:09:02.32,Default,,0,0,0,,Барлығы….
Dialogue: 0,0:09:04.34,0:09:06.55,Default,,0,0,0,,Мұндай құбыжық→
Dialogue: 0,0:09:06.55,0:09:08.84,Default,,0,0,0,,Саған бере аламын ба деп ойлаймын...
Dialogue: 0,0:09:08.84,0:09:13.58,Default,,0,0,0,,Біз бұл елді қорғауымыз керек!
Dialogue: 0,0:09:13.58,0:09:18.85,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:18.85,0:09:21.32,Default,,0,0,0,,Барлығы….
Dialogue: 0,0:09:21.32,0:09:23.96,Default,,0,0,0,,Қатты тырыспасам, не істейсің?
Dialogue: 0,0:09:23.96,0:09:26.42,Default,,0,0,0,,Ооооооооооооооооооооо.
Dialogue: 0,0:09:26.42,0:09:31.46,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:31.46,0:09:33.50,Default,,0,0,0,,Анықтама.
Dialogue: 0,0:09:33.50,0:09:36.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:36.32,0:09:38.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:40.22,0:09:42.26,Default,,0,0,0,,≪Барлығыңыз! ≫
Dialogue: 0,0:09:42.26,0:09:53.90,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:53.90,0:09:56.60,Default,,0,0,0,,≪Бәрі осы бір соққымен...≫
Dialogue: 0,0:09:56.60,0:10:01.23,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:01.23,0:10:03.26,Default,,0,0,0,,≪Аяқтаңыз! ≫
Dialogue: 0,0:10:03.26,0:10:06.92,Default,,0,0,0,,Алға!!
Dialogue: 0,0:10:06.92,0:10:08.92,Default,,0,0,0,,Иә! Ах!
Dialogue: 0,0:10:10.34,0:10:12.39,Default,,0,0,0,,Бум! (Барлығы) Уау!
Dialogue: 0,0:10:12.39,0:10:17.91,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:17.91,0:10:21.21,Default,,0,0,0,,Иә, бұл жақсы, солай ма?
Dialogue: 0,0:10:21.21,0:10:25.10,Default,,0,0,0,,Кешіріңіз, Маги, ауырған соң.
Dialogue: 0,0:10:25.10,0:10:27.32,Default,,0,0,0,,≪Ол...≫
Dialogue: 0,0:10:27.32,0:10:31.77,Default,,0,0,0,,Біреуді осылай өлтіру үшін жолдан шығудың мәні бар ма?
Dialogue: 0,0:10:31.77,0:10:34.59,Default,,0,0,0,,Ол біз жасаған ағымды бірнеше рет қайталады→
Dialogue: 0,0:10:34.59,0:10:36.86,Default,,0,0,0,,Кедергі жасау. →
Dialogue: 0,0:10:36.86,0:10:39.98,Default,,0,0,0,,Бұл келешекте келеңсіздікке айналады. →
Dialogue: 0,0:10:39.98,0:10:43.10,Default,,0,0,0,,Оны қазір жою керек.
Dialogue: 0,0:10:43.10,0:10:45.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:45.75,0:10:48.99,Default,,0,0,0,,Мен өзімді біртүрлі күшке толып жатқандай сезінемін.
Dialogue: 0,0:10:48.99,0:10:52.11,Default,,0,0,0,,Сіз құлаған адамсыз. →
Dialogue: 0,0:10:52.11,0:10:55.00,Default,,0,0,0,,Қара рюфке толы ағымдағы күй →
Dialogue: 0,0:10:55.00,0:10:57.33,Default,,0,0,0,,Сіздің күшіңіз артады.
Dialogue: 0,0:10:57.33,0:10:59.43,Default,,0,0,0,,>
Dialogue: 0,0:10:59.43,0:11:03.62,Default,,0,0,0,,≪Мен шоғырланған барлық сиқырлы құрал-жабдықтар жойылды≫
Dialogue: 0,0:11:03.62,0:11:06.42,Default,,0,0,0,,≪Менде көп сиқырлы күш қалмады.≫
Dialogue: 0,0:11:06.42,0:11:09.99,Default,,0,0,0,,≪Осындай адамдармен қалай әрекет етесіз...≫
Dialogue: 0,0:11:09.99,0:11:12.21,Default,,0,0,0,,≪Мен не істеуім керек? ≫
Dialogue: 0,0:11:12.21,0:11:14.25,Default,,0,0,0,,≪Не істеу керек!?≫
Dialogue: 0,0:11:14.25,0:11:16.23,Default,,0,0,0,,Өл! Каа~!
Dialogue: 0,0:11:16.23,0:11:18.27,Default,,0,0,0,,Атымды айтып қойсам зияны жоқ шығар».
Dialogue: 0,0:11:18.27,0:11:21.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:21.32,0:11:24.33,Default,,0,0,0,,Сіз сенімдісіз бе? Маған патша сарайына барудың қажеті жоқ.
Dialogue: 0,0:11:24.33,0:11:26.54,Default,,0,0,0,,Бірақ мұндай қайғылы жағдай→
Dialogue: 0,0:11:26.54,0:11:30.45,Default,,0,0,0,,Мен жай қалдыра алмаймын... Шин.
Dialogue: 0,0:11:30.45,0:11:33.64,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:33.64,0:11:35.85,Default,,0,0,0,,Бұл тозақ сияқты.
Dialogue: 0,0:11:35.85,0:11:38.74,Default,,0,0,0,,Кіші інім, сен қаншаға барасың?
Dialogue: 0,0:11:38.74,0:11:42.03,Default,,0,0,0,,Әйтеуір мына затты сол адамға қайтар.
Dialogue: 0,0:11:42.03,0:11:44.68,Default,,0,0,0,,Бірақ, ағайын, солай екен→
Dialogue: 0,0:11:44.68,0:11:46.83,Default,,0,0,0,,Маған қызық ол адам қайда...
Dialogue: 0,0:11:46.83,0:11:53.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:53.32,0:11:55.36,Default,,0,0,0,,Боқ...
Dialogue: 0,0:11:55.36,0:11:58.06,Default,,0,0,0,,Қарғыс атсын! Мен не істеуім керек...
Dialogue: 0,0:11:58.06,0:12:01.06,Default,,0,0,0,,Ой... Неге бұлай болып жатыр...?
Dialogue: 0,0:12:01.06,0:12:04.26,Default,,0,0,0,,Біреу... Өтінемін, біреу!
Dialogue: 0,0:12:05.73,0:12:08.67,Default,,0,0,0,,Осы елге көмектесіңізші...
Dialogue: 0,0:12:08.67,0:12:13.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:13.84,0:12:15.88,Default,,0,0,0,,Аға.
Dialogue: 0,0:12:15.88,0:12:19.36,Default,,0,0,0,,Не? Сіз құсқа жақындап келе жатырсыз ба?
Dialogue: 0,0:12:19.36,0:12:22.90,Default,,0,0,0,,Иә? (Джафар) Бұл...
Dialogue: 0,0:12:22.90,0:12:39.00,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:43.52,0:14:45.56,Default,,0,0,0,,Жудар →
Dialogue: 0,0:14:45.56,0:14:49.58,Default,,0,0,0,,Ол адам сен сияқты қара күшке ие жын. →
Dialogue: 0,0:14:49.58,0:14:52.17,Default,,0,0,0,,Күшпен басқару. → түймесін түртсеңіз
Dialogue: 0,0:14:52.17,0:14:54.74,Default,,0,0,0,,Мен сенің қызметшің боламын.
Dialogue: 0,0:14:54.74,0:14:59.06,Default,,0,0,0,,Тезірек менікі бол!
Dialogue: 0,0:14:59.06,0:15:02.06,Default,,0,0,0,,Керемет!
Dialogue: 0,0:15:04.16,0:15:07.06,Default,,0,0,0,,Ммм, түсіндім.
Dialogue: 0,0:15:10.59,0:15:13.17,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:15:13.17,0:15:15.21,Default,,0,0,0,,>
Dialogue: 0,0:15:15.21,0:15:18.09,Default,,0,0,0,,≪Бірдеңе істеу керек≫
Dialogue: 0,0:15:18.09,0:15:20.43,Default,,0,0,0,,«Мұзды найзалар»!
Dialogue: 0,0:15:20.43,0:15:22.43,Default,,0,0,0,,Ах! Уф!
Dialogue: 0,0:15:23.78,0:15:25.78,Default,,0,0,0,,Уф... Қарғыс атсын!
Dialogue: 0,0:15:27.30,0:15:29.72,Default,,0,0,0,,Тыныш бол, Синдбад.
Dialogue: 0,0:15:29.72,0:15:33.62,Default,,0,0,0,,Уайымдама, мен сені өлтірмеймін. →
Dialogue: 0,0:15:33.62,0:15:36.52,Default,,0,0,0,,Кейін мен сені де менікі қыламын. →
Dialogue: 0,0:15:38.01,0:15:41.55,Default,,0,0,0,,Келіңіздер! Ақыры сені өлтіретін кезегім келді!
Dialogue: 0,0:15:41.55,0:15:43.55,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:56.50,0:15:58.70,Default,,0,0,0,,Гуоо
Dialogue: 0,0:16:00.08,0:16:02.14,Default,,0,0,0,,Керемет!
Dialogue: 0,0:16:02.14,0:16:06.24,Default,,0,0,0,,Хаха! Менің джинім күшті!
Dialogue: 0,0:16:13.16,0:16:16.15,Default,,0,0,0,,>
Dialogue: 0,0:16:16.15,0:16:18.15,Default,,0,0,0,,≪Менің қашудан басқа амалым жоқ...≫
Dialogue: 0,0:16:19.92,0:16:23.79,Default,,0,0,0,,Морджиана... мен→
Dialogue: 0,0:16:23.79,0:16:26.79,Default,,0,0,0,,Сіз мені сонда ұшып жібере аласыз ба? иә?
Dialogue: 0,0:16:28.65,0:16:32.52,Default,,0,0,0,,Менде бұрын жинаған соңғы қуат әлі бар.
Dialogue: 0,0:16:32.52,0:16:36.82,Default,,0,0,0,,Бұл оларға соңғы соққы. Және... бірақ→
Dialogue: 0,0:16:36.82,0:16:39.09,Default,,0,0,0,,Жау көбейді, жын жарасы да көбейді →
Dialogue: 0,0:16:39.09,0:16:41.98,Default,,0,0,0,,Мен толық қалпына келдім.
Dialogue: 0,0:16:41.98,0:16:44.80,Default,,0,0,0,,Олай болса, бұрынғыға қарағанда→
Dialogue: 0,0:16:44.80,0:16:47.83,Default,,0,0,0,,Мен көбірек күш жұмсамайынша.
Dialogue: 0,0:16:47.83,0:16:50.62,Default,,0,0,0,,Синдбадтың бұрын айтқандары →
Dialogue: 0,0:16:50.62,0:16:53.94,Default,,0,0,0,,Денеңіздегі сиқырлы күшті пайдалансаңыз... →
Dialogue: 0,0:16:53.94,0:16:57.21,Default,,0,0,0,,Мүмкін болуы керек. Бірақ...→
Dialogue: 0,0:16:57.21,0:16:59.71,Default,,0,0,0,,Бірақ мұны істесеңіз →
Dialogue: 0,0:16:59.71,0:17:02.38,Default,,0,0,0,,Alibaba өлуі мүмкін...
Dialogue: 0,0:17:02.38,0:17:06.03,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, біз бәріміз осы уақытқа дейін бәрін қорғап келдік→
Dialogue: 0,0:17:06.03,0:17:08.05,Default,,0,0,0,,Мұның бәрі бекер болады.
Dialogue: 0,0:17:08.05,0:17:10.12,Default,,0,0,0,,Мұны істеу керек!
Dialogue: 0,0:17:10.12,0:17:12.12,Default,,0,0,0,,Морджиана, өтінемін!
Dialogue: 0,0:17:13.54,0:17:15.54,Default,,0,0,0,,Амон!
Dialogue: 0,0:17:15.54,0:17:19.03,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:19.03,0:17:21.10,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:21.10,0:17:25.54,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:25.54,0:17:27.54,Default,,0,0,0,,Ох… Уф~ Мен қатты ашпын.
Dialogue: 0,0:17:29.56,0:17:31.58,Default,,0,0,0,,Хехе.
Dialogue: 0,0:17:31.58,0:17:40.33,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:40.33,0:17:44.99,Default,,0,0,0,,Бұл қылышта екі адамның, мен және шайтанның сиқырлы күші бар→
Dialogue: 0,0:17:44.99,0:17:47.26,Default,,0,0,0,,Қызық, қабылдай аламын ба!?
Dialogue: 0,0:17:47.26,0:17:50.08,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:50.08,0:17:52.93,Default,,0,0,0,,Гакин!
Dialogue: 0,0:17:52.93,0:17:56.65,Default,,0,0,0,,Хмм! Эй! Құлап қалмаңыз!
Dialogue: 0,0:17:56.65,0:17:58.67,Default,,0,0,0,,Амон! Снап
Dialogue: 0,0:17:58.67,0:18:00.67,Default,,0,0,0,,Иә? Бакин!
Dialogue: 0,0:18:00.67,0:18:06.28,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:06.28,0:18:08.36,Default,,0,0,0,,Alibaba!
Dialogue: 0,0:18:08.36,0:18:11.35,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:11.35,0:18:13.35,Default,,0,0,0,,Қылыш...
Dialogue: 0,0:18:14.80,0:18:17.44,Default,,0,0,0,,Морджиана Тағы бір рет.
Dialogue: 0,0:18:17.44,0:18:21.08,Default,,0,0,0,,Не айтып тұрсың! Қазірдің өзінде қылыш бар ...
Dialogue: 0,0:18:21.08,0:18:23.09,Default,,0,0,0,,Әлі де біразы қалды...
Dialogue: 0,0:18:23.09,0:18:25.66,Default,,0,0,0,,Мен де әлі тірімін.
Dialogue: 0,0:18:25.66,0:18:28.06,Default,,0,0,0,,Мен мұны қайталауым керек!
Dialogue: 0,0:18:29.93,0:18:32.00,Default,,0,0,0,,Тағы да!!
Dialogue: 0,0:18:32.00,0:18:34.10,Default,,0,0,0,,Иә….
Dialogue: 0,0:18:35.42,0:18:37.52,Default,,0,0,0,,Эй Алибаба-кун→
Dialogue: 0,0:18:39.04,0:18:41.51,Default,,0,0,0,,Неліктен мұндай ұзаққа барасыз?
Dialogue: 0,0:18:41.51,0:18:45.50,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:45.50,0:18:49.44,Default,,0,0,0,,Сізде әрқашан өзіңізге жүктелмейтін жауапкершілік бар→
Dialogue: 0,0:18:49.44,0:18:52.57,Default,,0,0,0,,Оны жалғыз алып жүруге тырысу.
Dialogue: 0,0:18:52.57,0:18:55.01,Default,,0,0,0,,Сол кезде де →
Dialogue: 0,0:18:55.01,0:18:57.71,Default,,0,0,0,,Ол кезде де...→
Dialogue: 0,0:18:57.71,0:18:59.81,Default,,0,0,0,,Ол кезде де солай болды.
Dialogue: 0,0:19:01.17,0:19:03.17,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:19:06.10,0:19:10.01,Default,,0,0,0,,Себебі сіз Алибаба-кунсыз.
Dialogue: 0,0:19:10.01,0:19:13.34,Default,,0,0,0,,Хахаха. Күрсін!
Dialogue: 0,0:19:13.34,0:19:16.44,Default,,0,0,0,,Сондықтан мен...
Dialogue: 0,0:19:18.05,0:19:20.75,Default,,0,0,0,,♬~
Dialogue: 0,0:19:24.62,0:19:26.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:26.64,0:19:29.88,Default,,0,0,0,,Мен көмектескім келеді →
Dialogue: 0,0:19:29.88,0:19:31.88,Default,,0,0,0,,Мен сізге хабарласамын.
Dialogue: 0,0:19:34.73,0:19:36.73,Default,,0,0,0,,Қалағаныңызша.
Dialogue: 0,0:19:42.89,0:19:44.99,Default,,0,0,0,,Эй, Алибаба-кун.
Dialogue: 0,0:19:46.46,0:19:48.38,Default,,0,0,0,,Аладдин….
Dialogue: 0,0:19:48.38,0:19:50.82,Default,,0,0,0,,Ақыры келдің, кішкентайым.
Dialogue: 0,0:19:50.82,0:19:54.35,Default,,0,0,0,,Мен бұл жолы ол кездегідей жеңілмеймін.
Dialogue: 0,0:19:54.35,0:19:58.32,Default,,0,0,0,,Мен де джин алдым!
Dialogue: 0,0:19:58.32,0:20:02.02,Default,,0,0,0,,Енді, сен де, джинді шығар!
Dialogue: 0,0:20:06.78,0:20:08.85,Default,,0,0,0,,Уго-кун?
Dialogue: 0,0:20:08.85,0:20:10.85,Default,,0,0,0,,Уго-кун...
Dialogue: 0,0:20:13.85,0:20:16.22,Default,,0,0,0,,Ол кетті.
Dialogue: 0,0:20:16.22,0:20:18.28,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:18.28,0:20:20.28,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:20:22.86,0:20:27.72,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:27.72,0:20:31.02,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:31.02,0:20:33.27,Default,,0,0,0,,Джин өндіре алмасаңыз, сіз →
Dialogue: 0,0:20:33.27,0:20:36.21,Default,,0,0,0,,Ол жай ғана бала. Өл.
Dialogue: 0,0:20:36.21,0:20:39.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:39.30,0:20:41.30,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:43.02,0:20:46.39,Default,,0,0,0,,Не? Рафтың батасы…→
Dialogue: 0,0:20:46.39,0:20:48.51,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:20:48.51,0:20:50.57,Default,,0,0,0,,≪Уго-кун маған арналған→
Dialogue: 0,0:20:50.57,0:20:52.59,Default,,0,0,0,,Сіз мені күшпен қалдырдыңыз≫
Dialogue: 0,0:20:52.59,0:21:03.15,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:03.15,0:21:05.49,Default,,0,0,0,,Әй... Ақ дәу!
Dialogue: 0,0:21:05.49,0:21:09.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:09.81,0:21:12.51,Default,,0,0,0,,Бұл Джиннің жаттығу техникасы. →
Dialogue: 0,0:21:12.51,0:21:15.93,Default,,0,0,0,,Ол шынымен түсінді ме?
Dialogue: 0,0:21:15.93,0:21:19.80,Default,,0,0,0,,Не... ол дәу тәрізді болса да→
Dialogue: 0,0:21:19.80,0:21:22.87,Default,,0,0,0,,Бұл жай ғана жылулық сиқыр емес пе?
Dialogue: 0,0:21:22.87,0:21:26.41,Default,,0,0,0,,Аладдин Сіз сиқырды қазір қолдана аласыз ба?
Dialogue: 0,0:21:26.41,0:21:30.60,Default,,0,0,0,,Қандай қызықсыз бала! Жәй мені сиқы!
Dialogue: 0,0:21:30.60,0:21:36.70,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:36.70,0:21:39.61,Default,,0,0,0,,≪Енді жақсы, Уго-кун≫
Dialogue: 0,0:21:39.61,0:21:42.58,Default,,0,0,0,,≪Себебі сен мені оқыдың→
Dialogue: 0,0:21:42.58,0:21:45.88,Default,,0,0,0,,Мен мұны жалғыз істей аламын! ≫
Dialogue: 0,0:21:45.88,0:21:48.18,Default,,0,0,0,,«Қүйген егіз алақан»!
Dialogue: 0,0:21:50.23,0:21:53.07,Default,,0,0,0,,Уау... Уау!!
Dialogue: 0,0:21:53.07,0:22:00.53,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:00.53,0:22:04.53,Default,,0,0,0,,Ағай, амансыз ба? А... аа.
Dialogue: 0,0:22:04.53,0:22:08.99,Default,,0,0,0,,Олай болса, Мол мырза, ағамды қалаға алып кетсеңіз?
Dialogue: 0,0:22:08.99,0:22:11.29,Default,,0,0,0,,Ол жақта қарттың кездесуі керек адамдар бар→
Dialogue: 0,0:22:11.29,0:22:14.41,Default,,0,0,0,,Бар. Бірақ... Бірақ...
Dialogue: 0,0:22:14.41,0:22:17.90,Default,,0,0,0,,Жарайды. Жүр, асығыңыз.
Dialogue: 0,0:22:17.90,0:22:20.45,Default,,0,0,0,,Менің үмітім ақталмады. →
Dialogue: 0,0:22:20.45,0:22:23.50,Default,,0,0,0,,Мен мұны жай ғана жылулық сиқыр деп ешқашан ойламадым. →
Dialogue: 0,0:22:23.50,0:22:25.90,Default,,0,0,0,,Егер сіз сол деңгейдегі маги болсаңыз→
Dialogue: 0,0:22:25.90,0:22:29.02,Default,,0,0,0,,Енді бұл елде қара руфқа толы→
Dialogue: 0,0:22:29.02,0:22:31.02,Default,,0,0,0,,Иудалдың жауы емес.
Dialogue: 0,0:22:32.93,0:22:36.20,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:22:36.20,0:22:40.10,Default,,0,0,0,,Мені ренжітпе, кішкентайым!
Dialogue: 0,0:22:40.10,0:22:43.64,Default,,0,0,0,,>
Dialogue: 0,0:22:43.64,0:22:46.31,Default,,0,0,0,,≪Бірақ бүгінгі Аладдин→
Dialogue: 0,0:22:46.31,0:22:48.31,Default,,0,0,0,,Мен өзімді жақсы сезінемін≫
Dialogue: 0,0:22:51.50,0:22:55.52,Default,,0,0,0,,Иә... Мен жеңе алмаймын.
Dialogue: 0,0:22:55.52,0:22:57.58,Default,,0,0,0,,Не!
Dialogue: 0,0:22:57.58,0:23:00.40,Default,,0,0,0,,Менің сиқырым толық емес→
Dialogue: 0,0:23:00.40,0:23:03.00,Default,,0,0,0,,Дәл қазір ол адамды жеңу мүмкін емес.
Dialogue: 0,0:23:04.73,0:23:07.16,Default,,0,0,0,,Маған сенің көмегің керек.
Dialogue: 0,0:23:07.16,0:23:10.70,Default,,0,0,0,,Ол кісіні де, қара жынды да жеңе аласың.
Dialogue: 0,0:23:10.70,0:23:12.70,Default,,0,0,0,,Бірақ...→
Dialogue: 0,0:23:14.27,0:23:16.72,Default,,0,0,0,,Қылыш жоқ, сиқыр жоқ.
Dialogue: 0,0:23:16.72,0:23:19.22,Default,,0,0,0,,Мен енді жақсы күресе алмаймын...
Dialogue: 0,0:23:23.59,0:23:26.63,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:23:26.63,0:23:29.33,Default,,0,0,0,,Мұқият қара, Әлибаба-күн.
Dialogue: 0,0:23:29.33,0:23:39.38,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:39.38,0:23:42.11,Default,,0,0,0,,Корольдік отбасы Барлық дворяндарды өлтіріңіз!
Dialogue: 0,0:23:42.11,0:23:44.15,Default,,0,0,0,,Бар! Ақымақ!
Dialogue: 0,0:23:44.15,0:23:46.48,Default,,0,0,0,,Бұлай етудің мәні неде!
Dialogue: 0,0:23:46.48,0:23:49.79,Default,,0,0,0,,Бәрі қайта туылатын болды!
Dialogue: 0,0:23:49.79,0:23:52.26,Default,,0,0,0,,Өз еліміз...→
Dialogue: 0,0:23:52.26,0:23:55.19,Default,,0,0,0,,Сіз осылай қайталап көруді шештіңіз. →
Dialogue: 0,0:23:55.19,0:23:57.59,Default,,0,0,0,,Мен сол кезде осылай ант бердім!
Dialogue: 0,0:23:58.98,0:24:01.32,Default,,0,0,0,,Алибаба-кун, осы елде →
Dialogue: 0,0:24:01.32,0:24:04.13,Default,,0,0,0,,Үміт күші сақталады.
Dialogue: 0,0:24:04.13,0:24:06.92,Default,,0,0,0,,Алға жылжып, тағдырды жеңуге тырыс→
Dialogue: 0,0:24:06.92,0:24:09.54,Default,,0,0,0,,Оң қуат.
Dialogue: 0,0:24:09.54,0:24:11.54,Default,,0,0,0,,Өртті сен тудырдың, солай ма?
Dialogue: 0,0:24:13.41,0:24:16.23,Default,,0,0,0,,Әр адамның жүрегінде үміт.
Dialogue: 0,0:24:16.23,0:24:19.25,Default,,0,0,0,,Ой... бәрі...
Dialogue: 0,0:24:19.25,0:24:21.25,Default,,0,0,0,,Сіз бас тарта аласыз ба? аа!
Dialogue: 0,0:24:23.49,0:24:25.77,Default,,0,0,0,,Өмірдің алға жылжуы →
Dialogue: 0,0:24:25.77,0:24:28.11,Default,,0,0,0,,Руф құсын бағыттайды.
Dialogue: 0,0:24:28.11,0:24:31.41,Default,,0,0,0,,Сондықтан біз әлі де күресе аламыз!
Dialogue: 0,0:24:31.41,0:24:37.28,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:37.28,0:24:40.35,Default,,0,0,0,,Tsk! Бұл қайтадан жылу сиқыры.
Dialogue: 0,0:24:40.35,0:24:46.04,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:46.04,0:24:49.71,Default,,0,0,0,,Жоқ, олай емес. Бұл...
Dialogue: 0,0:24:49.71,0:24:54.64,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:54.64,0:24:59.91,Default,,0,0,0,,Сөз жоқ. Өйткені, ол оны алды. →
Dialogue: 0,0:24:59.91,0:25:01.89,Default,,0,0,0,,Дәл солай болды...
Dialogue: 0,0:25:01.89,0:25:09.90,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:09.90,0:25:11.90,Default,,0,0,0,,Сүлейменнің даналығы!
Dialogue: 0,0:25:14.07,0:25:58.53,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:02.74,0:26:13.34,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:17.55,0:26:43.00,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:15.05,0:28:17.09,Default,,0,0,0,,Мен шештім. Бұл сұмдық тағдыр →
Dialogue: 0,0:28:17.09,0:28:19.46,Default,,0,0,0,,Мен кек аламын! Alibaba-kun →
Dialogue: 0,0:28:19.46,0:28:22.06,Default,,0,0,0,,Сен оны қараңғылықтан құтқарасың.
Dialogue: 0,0:28:24.41,0:28:28.31,Default,,0,0,0,,Ей, Қасым, біз неге басқа адамдармыз деп ойлаймын.
Dialogue: 0,0:30:42.92,0:30:45.34,Default,,0,0,0,,Қысқы атмосфералық қысымның таралуына байланысты,
Dialogue: 0,0:30:46.35,0:30:49.39,Default,,0,0,0,,Бүгін Жапонияның солтүстігінде қарлы боран болатын көптеген жерлер бар.
Dialogue: 0,0:30:49.39,0:30:51.49,Default,,0,0,0,,Энгару қаласында, Хоккайдо
Dialogue: 0,0:30:51.49,0:30:53.61,Default,,0,0,0,,Қарлы жолда
Dialogue: 0,0:30:53.61,0:30:55.60,Default,,0,0,0,,Сегіз адам ауыр жарақат алған ЖКО орын алды.
Dialogue: 0,0:30:57.10,0:31:02.10,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
