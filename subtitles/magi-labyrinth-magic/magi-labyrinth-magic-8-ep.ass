Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.64,0:00:37.26,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:37.26,0:00:40.05,Default,,0,0,0,,Alibaba...kun?
Dialogue: 0,0:00:40.05,0:00:45.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:00:45.83,0:00:48.13,Default,,0,0,0,,Бір-біріңді білесіңдер ме? аа.
Dialogue: 0,0:00:50.42,0:00:53.36,Default,,0,0,0,,Аладдин Біраз уақыт өтті.
Dialogue: 0,0:00:53.36,0:00:57.56,Default,,0,0,0,,Уго-кунды алып тастай аласыз ба? Менің достарым қорқады.
Dialogue: 0,0:00:57.56,0:01:00.08,Default,,0,0,0,,Жоқ! Мені тыңдама!
Dialogue: 0,0:01:00.08,0:01:14.00,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:14.00,0:01:16.15,Default,,0,0,0,,Білесің бе, Алибаба-кун→
Dialogue: 0,0:01:16.15,0:01:19.45,Default,,0,0,0,,Мен Алибаба-кунды көруге келдім.
Dialogue: 0,0:01:19.45,0:01:22.81,Default,,0,0,0,,Менің айтқым келетін нәрселер өте көп.
Dialogue: 0,0:01:22.81,0:01:25.21,Default,,0,0,0,,Сол кез есіңде ме?
Dialogue: 0,0:01:26.71,0:01:30.70,Default,,0,0,0,,Біз әлемді бірге көруге уәде бердік.
Dialogue: 0,0:01:30.70,0:01:35.53,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:35.53,0:01:38.53,Default,,0,0,0,,Аладдин Кешіріңіз...
Dialogue: 0,0:01:40.99,0:01:43.99,Default,,0,0,0,,Мен енді уәдемді орындай алмаймын.
Dialogue: 0,0:01:52.64,0:01:54.67,Default,,0,0,0,,Міне болды! (Солдат) Күте тұрыңыз! Эй!
Dialogue: 0,0:01:54.67,0:01:56.72,Default,,0,0,0,,Ұлттық армия келді!
Dialogue: 0,0:01:56.72,0:01:59.54,Default,,0,0,0,,Эй, Алибаба, кешігіп қаласың! аа.
Dialogue: 0,0:01:59.54,0:02:02.96,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:02.96,0:02:05.41,Default,,0,0,0,,Қатаңдық пен әдептілік рухы→
Dialogue: 0,0:02:05.41,0:02:07.91,Default,,0,0,0,,Саған және сенің ізбасарларыңа бұйырамын.
Dialogue: 0,0:02:09.97,0:02:12.32,Default,,0,0,0,,Менің сиқырыммен қоректену →
Dialogue: 0,0:02:12.32,0:02:15.02,Default,,0,0,0,,Менің еркіме үлкен күш бер.
Dialogue: 0,0:02:16.46,0:02:18.49,Default,,0,0,0,,Шық, Амон.
Dialogue: 0,0:02:18.49,0:02:22.70,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:22.70,0:02:25.60,Default,,0,0,0,,Уау! Әй... бұл отты жын ғой.
Dialogue: 0,0:02:27.74,0:02:29.74,Default,,0,0,0,,Хмф!
Dialogue: 0,0:02:31.34,0:03:59.47,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:03.92,0:04:06.59,Default,,0,0,0,,Солай болса да, тұман тобына→
Dialogue: 0,0:04:06.59,0:04:09.29,Default,,0,0,0,,Мен лабиринтті бағындырушы болады деп ойламаппын. →
Dialogue: 0,0:04:09.29,0:04:12.71,Default,,0,0,0,,Аладдиннің досы кім? →
Dialogue: 0,0:04:12.71,0:04:16.01,Default,,0,0,0,,Жұмбақ Әлибаба қандай адам?
Dialogue: 0,0:04:16.01,0:04:22.61,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:24.77,0:04:28.37,Default,,0,0,0,,Нии-чан, бұл адамдар қорқынышты... Амансың ба?
Dialogue: 0,0:04:28.37,0:04:32.80,Default,,0,0,0,,Ах. Мұнда тіпті әскерилер де тиісе алмайды. →
Dialogue: 0,0:04:32.80,0:04:34.85,Default,,0,0,0,,Біз қауіпсізбіз.
Dialogue: 0,0:04:34.85,0:04:38.43,Default,,0,0,0,,Мен қазір достар жинап жатырмын.
Dialogue: 0,0:04:38.43,0:04:41.14,Default,,0,0,0,,Баратын жеріңіз болмаса, қош келдіңіз.
Dialogue: 0,0:04:41.14,0:04:43.19,Default,,0,0,0,,Сәлем? Досым.
Dialogue: 0,0:04:43.19,0:04:47.26,Default,,0,0,0,,Ах. Бірақ мынаны айтайын.
Dialogue: 0,0:04:47.26,0:04:49.55,Default,,0,0,0,,Біз қарақшылармыз.
Dialogue: 0,0:04:49.55,0:04:53.12,Default,,0,0,0,,Ұлттық әскермен кедейлер үшін соғысу.
Dialogue: 0,0:04:53.12,0:04:56.67,Default,,0,0,0,,Ұры сияқты ұрлық жасама.
Dialogue: 0,0:04:56.67,0:04:58.87,Default,,0,0,0,,Осы ережені бұзсаңыз...
Dialogue: 0,0:05:00.24,0:05:03.14,Default,,0,0,0,,Hiii…. Мен өміріммен төлеймін.
Dialogue: 0,0:05:05.64,0:05:09.25,Default,,0,0,0,,Әй, Қасым, сен не айтып тұрсың?
Dialogue: 0,0:05:09.25,0:05:12.25,Default,,0,0,0,,Сол жұмбақ адамдарды көбірек тартыңыз.
Dialogue: 0,0:05:13.69,0:05:15.90,Default,,0,0,0,,Соғыс жеткілікті ме?
Dialogue: 0,0:05:15.90,0:05:19.51,Default,,0,0,0,,Сәлем! Әзіл әзіл.
Dialogue: 0,0:05:19.51,0:05:23.35,Default,,0,0,0,,Бірақ біз күресуді жалғастыруымыз керек.
Dialogue: 0,0:05:23.35,0:05:25.45,Default,,0,0,0,,Хаха! Алибабаның ағасы!
Dialogue: 0,0:05:26.88,0:05:30.12,Default,,0,0,0,,Бүгін де ұлттық әскерді жеңдіңіз бе? ағама рахмет →
Dialogue: 0,0:05:30.12,0:05:34.09,Default,,0,0,0,,Енді әрбір адам күніне екі рет тамақ іше алады.
Dialogue: 0,0:05:34.09,0:05:36.69,Default,,0,0,0,,А... Әй, досым→
Dialogue: 0,0:05:36.69,0:05:39.39,Default,,0,0,0,,Біз де бала кезімізде, тозақтың тозығы →
Dialogue: 0,0:05:39.39,0:05:41.39,Default,,0,0,0,,Біз бірге аман қалдық. →
Dialogue: 0,0:05:42.83,0:05:46.30,Default,,0,0,0,,Өтінемін... мына балаларды құтқар. →
Dialogue: 0,0:05:46.30,0:05:49.19,Default,,0,0,0,,Мәриям сияқты болма.
Dialogue: 0,0:05:49.19,0:05:52.01,Default,,0,0,0,,Енді ешқайда кетпе, Алибаба! →
Dialogue: 0,0:05:52.01,0:05:55.11,Default,,0,0,0,,Менің қасымда болып, бұрынғыдай шайқас.
Dialogue: 0,0:06:03.19,0:06:05.59,Default,,0,0,0,,≪Жоқ. Мен өзім бірдеңе істеймін→
Dialogue: 0,0:06:05.59,0:06:07.87,Default,,0,0,0,,Сіз шештіңіз≫
Dialogue: 0,0:06:07.87,0:06:09.87,Default,,0,0,0,,А... бұл кім!?
Dialogue: 0,0:06:11.94,0:06:14.11,Default,,0,0,0,,Бұл менің қиялым ғана ма?
Dialogue: 0,0:06:14.11,0:06:16.11,Default,,0,0,0,,Мүмкін мен әбден шаршаған шығармын.
Dialogue: 0,0:06:22.34,0:06:24.44,Default,,0,0,0,,Уау... Мм! Өтінемін, тыныш болыңыз.
Dialogue: 0,0:06:24.44,0:06:26.44,Default,,0,0,0,,Шу шығарсаң, тастайсың. Хмм... Хмм!
Dialogue: 0,0:06:27.86,0:06:32.35,Default,,0,0,0,,Сен мұнда не үшін келдің? Мен сенің иісіңді аңдыдым.
Dialogue: 0,0:06:32.35,0:06:34.90,Default,,0,0,0,,Сен неге ұрысың?
Dialogue: 0,0:06:34.90,0:06:37.22,Default,,0,0,0,,Аладдинге аудармасын айтып беріңізші.
Dialogue: 0,0:06:37.22,0:06:40.39,Default,,0,0,0,,Әңгімелейтін ештеңе жоқ.
Dialogue: 0,0:06:40.39,0:06:42.67,Default,,0,0,0,,Одан гөрі бұл ұрының ұясы.
Dialogue: 0,0:06:42.67,0:06:44.78,Default,,0,0,0,,Өлтірер алдында үйге бару керек.
Dialogue: 0,0:06:44.78,0:06:47.03,Default,,0,0,0,,Жоқ, мен үйге бармаймын.
Dialogue: 0,0:06:47.03,0:06:49.43,Default,,0,0,0,,Аладдин сізді қарсы алуға келді →
Dialogue: 0,0:06:49.43,0:06:52.13,Default,,0,0,0,,Мен ұзақ, ұзақ жол жүрдім.
Dialogue: 0,0:06:53.57,0:06:56.15,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:06:56.15,0:07:00.59,Default,,0,0,0,,Тіпті сіз алты ай бұрын Цишан қаласында Аладдинді көріп отырғансыз →
Dialogue: 0,0:07:00.59,0:07:02.88,Default,,0,0,0,,Іздеген жоқсың ба? Шулы!
Dialogue: 0,0:07:02.88,0:07:06.11,Default,,0,0,0,,Бұл сіздің шаруаңыз емес. Бұл менің проблемам.
Dialogue: 0,0:07:06.11,0:07:08.11,Default,,0,0,0,,Thud! Апыр-ай!
Dialogue: 0,0:07:10.05,0:07:12.05,Default,,0,0,0,,Қарамастан. иә?
Dialogue: 0,0:07:14.19,0:07:17.74,Default,,0,0,0,,Иә? Сізді Аладдинге апарыңыз→
Dialogue: 0,0:07:17.74,0:07:21.33,Default,,0,0,0,,Мен сені өзіммен бірге алып кетемін. Иә!?
Dialogue: 0,0:07:21.33,0:07:24.40,Default,,0,0,0,,Ия!!
Dialogue: 0,0:07:24.40,0:07:27.54,Default,,0,0,0,,Иә? Сіз айқай естіген жоқсыз ба?
Dialogue: 0,0:07:27.54,0:07:31.01,Default,,0,0,0,,Бұл менің қиялым болса керек. (М Нандо) Менің ағам болса да →
Dialogue: 0,0:07:31.01,0:07:33.59,Default,,0,0,0,,Тұман бригадасына қосылмасаңыз да, осыны сата аласыз→
Dialogue: 0,0:07:33.59,0:07:35.74,Default,,0,0,0,,Мен әзірге өмір сүріп, ойнай аламын.
Dialogue: 0,0:07:35.74,0:07:38.66,Default,,0,0,0,,Мен тек алтын мен күміс тиындарға сенемін.
Dialogue: 0,0:07:38.66,0:07:40.70,Default,,0,0,0,,Осы жігітті қазір Балбадта сатсам да→
Dialogue: 0,0:07:40.70,0:07:43.60,Default,,0,0,0,,Бұл тек осындай қағаз болуы мүмкін.
Dialogue: 0,0:07:45.02,0:07:49.41,Default,,0,0,0,,Қазіргі уақытта Барбад экономикасы қатты күйзеліс үстінде.
Dialogue: 0,0:07:49.41,0:07:51.98,Default,,0,0,0,,Бұл себептердің бірі.
Dialogue: 0,0:07:51.98,0:07:55.46,Default,,0,0,0,,Бұл Коу империясы шығарған Кира банкноттары ма?
Dialogue: 0,0:07:55.46,0:07:59.03,Default,,0,0,0,,Коу империясы өзінің әскери күшіне сүйенеді →
Dialogue: 0,0:07:59.03,0:08:01.59,Default,,0,0,0,,Бұл жарқыраған банкнот көрші елдерге→
Dialogue: 0,0:08:01.59,0:08:03.92,Default,,0,0,0,,Таратуға тырысу. →
Dialogue: 0,0:08:03.92,0:08:08.26,Default,,0,0,0,,Барбад патшасы Абумад та Коу империясының қамқорлығында. →
Dialogue: 0,0:08:08.26,0:08:11.50,Default,,0,0,0,,Зерттеуден кейін ол Коу империясының ханшайымы болып көрінеді→
Dialogue: 0,0:08:11.50,0:08:14.62,Default,,0,0,0,,Олар айналысқан сияқты. Не?
Dialogue: 0,0:08:14.62,0:08:18.22,Default,,0,0,0,,Анау бейбақ, неге айтпадың?
Dialogue: 0,0:08:18.22,0:08:23.06,Default,,0,0,0,,Тұман бригадасының мәселесі де бар, біз де бұл мәселені қалай шешуге болатынын ойлап жатырмыз →
Dialogue: 0,0:08:23.06,0:08:25.78,Default,,0,0,0,,Туған елге хабарласқан дұрыс.
Dialogue: 0,0:08:25.78,0:08:30.05,Default,,0,0,0,,Дұрыс. Мен металл құралдарды қолданбаймын.
Dialogue: 0,0:08:30.05,0:08:32.32,Default,,0,0,0,,Айтпақшы, Аладдин ше?
Dialogue: 0,0:08:32.32,0:08:36.41,Default,,0,0,0,,Мен күйзеліске түсіп, бөлмемде демалып жатырмын. →
Dialogue: 0,0:08:36.41,0:08:39.31,Default,,0,0,0,,Олар сиқыршы болса да, қарапайым балалар.
Dialogue: 0,0:08:48.70,0:08:52.54,Default,,0,0,0,,Соңғы алты айда бізде сонша оқиға болды→
Dialogue: 0,0:08:52.54,0:08:55.54,Default,,0,0,0,,Alibaba-да да көп нәрсе болған болуы керек.
Dialogue: 0,0:09:00.28,0:09:03.07,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:09:03.07,0:09:05.50,Default,,0,0,0,,Маған жаңа мақсаттар қою керек.
Dialogue: 0,0:09:05.50,0:09:10.42,Default,,0,0,0,,Уго-кун бізге тапсырған металл ыдыстарды жинауды жалғастырайық...
Dialogue: 0,0:09:10.42,0:09:13.48,Default,,0,0,0,,А, бұған дейін Мол мырзамен →
Dialogue: 0,0:09:13.48,0:09:16.24,Default,,0,0,0,,Қараңғы континентке бару жақсы болар еді.
Dialogue: 0,0:09:16.24,0:09:19.60,Default,,0,0,0,,Мен Синдбад ағасының маған көп нәрсені үйреткенін қалаймын →
Dialogue: 0,0:09:19.60,0:09:21.60,Default,,0,0,0,,Көп нәрсе істеу керек!
Dialogue: 0,0:09:25.30,0:09:27.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:27.37,0:09:31.47,Default,,0,0,0,,Мен сеземін... Менің күшім жоқ.
Dialogue: 0,0:09:33.95,0:09:37.85,Default,,0,0,0,,Мен оны асыға күттім...
Dialogue: 0,0:10:00.79,0:10:03.68,Default,,0,0,0,,Уау!! ≪Таң!
Dialogue: 0,0:10:03.68,0:10:06.39,Default,,0,0,0,,Ах. Гах...
Dialogue: 0,0:10:06.39,0:10:08.99,Default,,0,0,0,,Жо... Жо...
Dialogue: 0,0:10:11.55,0:10:24.55,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:24.55,0:10:27.15,Default,,0,0,0,,Эй... сенің ісің жақсы сияқты.
Dialogue: 0,0:10:27.15,0:10:29.32,Default,,0,0,0,,Иә, Алибаба-кун да.
Dialogue: 0,0:10:29.32,0:10:31.40,Default,,0,0,0,,Жарты жыл болды.
Dialogue: 0,0:10:31.40,0:10:34.57,Default,,0,0,0,,Сіз өзіңізді басқаша сезінесіз бе?
Dialogue: 0,0:10:34.57,0:10:37.14,Default,,0,0,0,,Иә, Алибаба-кун да.
Dialogue: 0,0:10:37.14,0:10:41.28,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:41.28,0:10:44.17,Default,,0,0,0,,Қуып жету үшін кесіңіз. Уф...
Dialogue: 0,0:10:44.17,0:10:46.62,Default,,0,0,0,,Тұман тобыңызға байланысты→
Dialogue: 0,0:10:46.62,0:10:49.62,Default,,0,0,0,,Дәл қазір бұл елде не болып жатқанын білесіз бе?
Dialogue: 0,0:10:50.94,0:10:55.33,Default,,0,0,0,,Азаматтық соғыс салдарынан сауда тоқтап, үкімет өз азаматтарын тастап кетті→
Dialogue: 0,0:10:55.33,0:10:58.35,Default,,0,0,0,,Қашқан бейкүнә бейшаралар→
Dialogue: 0,0:10:58.35,0:11:00.53,Default,,0,0,0,,Құлдарды аулауда.
Dialogue: 0,0:11:00.53,0:11:02.58,Default,,0,0,0,,Ал, Мол мырза.
Dialogue: 0,0:11:02.58,0:11:05.52,Default,,0,0,0,,Неліктен әртүрлі нәрселерге ашуланатыныңызды түсінемін.→
Dialogue: 0,0:11:05.52,0:11:08.71,Default,,0,0,0,,Үшеуміз біраз уақыттан кейін бірінші рет кездесіп қалдық...→
Dialogue: 0,0:11:08.71,0:11:11.46,Default,,0,0,0,,Ойлап қарасам, айлы түн →
Dialogue: 0,0:11:11.46,0:11:14.81,Default,,0,0,0,,Барлығымыз бірге қызықты оқиғаларды көрейік.
Dialogue: 0,0:11:14.81,0:11:16.81,Default,,0,0,0,,Эй, Алибаба-кун.
Dialogue: 0,0:11:18.33,0:11:20.93,Default,,0,0,0,,Ах... Оу.
Dialogue: 0,0:11:23.44,0:11:26.71,Default,,0,0,0,,Ааа~ Осындай нәрсе болды ма?
Dialogue: 0,0:11:26.71,0:11:29.04,Default,,0,0,0,,Бұл тамаша шытырман оқиға болды.
Dialogue: 0,0:11:29.04,0:11:31.86,Default,,0,0,0,,Иә. Және →
Dialogue: 0,0:11:31.86,0:11:33.90,Default,,0,0,0,,Мен бұл елдің тұман тобымын→
Dialogue: 0,0:11:33.90,0:11:36.22,Default,,0,0,0,,Мен оны ұстауым керек еді.
Dialogue: 0,0:11:36.22,0:11:38.92,Default,,0,0,0,,Мен сені сонда болады деп күтпедім, бірақ...
Dialogue: 0,0:11:41.32,0:11:44.74,Default,,0,0,0,,Бірақ мен сенің еш себепсіз мұндай нәрсені жасайтыныңа сене алмаймын.
Dialogue: 0,0:11:44.74,0:11:46.74,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:11:48.10,0:11:52.00,Default,,0,0,0,,Неліктен Тұман тобында екеніңізді айтыңыз.
Dialogue: 0,0:11:56.24,0:11:58.76,Default,,0,0,0,,Аладдин бірінші →
Dialogue: 0,0:11:58.76,0:12:01.81,Default,,0,0,0,,Менің досымды тыңдайсың ба?
Dialogue: 0,0:12:01.81,0:12:04.61,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:12:04.61,0:12:08.75,Default,,0,0,0,,Оның аты Қасым. Қасым?
Dialogue: 0,0:12:08.75,0:12:12.75,Default,,0,0,0,,Ах. Ол «Мист» труппасының нағыз жетекшісі.
Dialogue: 0,0:12:14.21,0:12:18.31,Default,,0,0,0,,Қасым менің ескі досым болатын.
Dialogue: 0,0:12:20.71,0:12:23.05,Default,,0,0,0,,((уф!)) ((хахаха!))
Dialogue: 0,0:12:23.05,0:12:25.50,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:12:25.50,0:12:27.90,Default,,0,0,0,,) ((Қасым күткендей! Керемет))
Dialogue: 0,0:12:27.90,0:12:31.02,Default,,0,0,0,,((Маған тең келетін ешкім жоқ.→
Dialogue: 0,0:12:31.02,0:12:33.07,Default,,0,0,0,,Ах! )) ((Hehe~!))
Dialogue: 0,0:12:33.07,0:12:35.71,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:12:35.71,0:12:38.35,Default,,0,0,0,,((Мен бұл тауды қазғандықтан→
Dialogue: 0,0:12:38.35,0:12:40.38,Default,,0,0,0,,Сансыз туннельдер бар))
Dialogue: 0,0:12:40.38,0:12:43.27,Default,,0,0,0,,) ((Na!?))
Dialogue: 0,0:12:43.27,0:12:45.55,Default,,0,0,0,,) ((Бірақ бұл кішкентай!))
Dialogue: 0,0:12:45.55,0:12:50.44,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:12:50.44,0:12:52.44,Default,,0,0,0,,) ((Уау!))
Dialogue: 0,0:12:53.96,0:12:56.03,Default,,0,0,0,,Біз көп ұрысатынбыз →
Dialogue: 0,0:12:56.03,0:12:59.07,Default,,0,0,0,,Біртүрлі жақсы араласып кеттік.
Dialogue: 0,0:12:59.07,0:13:01.97,Default,,0,0,0,,Біз күнде бірге қоқыс шығаратын қаланы араладық.
Dialogue: 0,0:13:03.77,0:13:05.87,Default,,0,0,0,,Өмір кедей болды, бірақ→
Dialogue: 0,0:13:05.87,0:13:08.83,Default,,0,0,0,,Үйге келсем, анам маған мейірімді болды.
Dialogue: 0,0:13:08.83,0:13:11.48,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:13:11.48,0:13:14.42,Default,,0,0,0,,Менің анам шалғында жезөкше болған.
Dialogue: 0,0:13:14.42,0:13:18.12,Default,,0,0,0,,Ол жарқын адам. Мен әрқашан бақытты болдым.
Dialogue: 0,0:13:19.57,0:13:22.01,Default,,0,0,0,,Бірақ Қасым басқаша болды.
Dialogue: 0,0:13:22.01,0:13:24.79,Default,,0,0,0,,Оның әкесі бейбақ болған.
Dialogue: 0,0:13:24.79,0:13:27.61,Default,,0,0,0,,) ((Уф! Уф...))
Dialogue: 0,0:13:27.61,0:13:30.38,Default,,0,0,0,,) ((Сіз алкоголь сатып алдыңыз!))
Dialogue: 0,0:13:30.38,0:13:33.22,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:13:33.22,0:13:36.79,Default,,0,0,0,,((Аа! Тоқта! Мәриямға тиіспе!→
Dialogue: 0,0:13:36.79,0:13:39.44,Default,,0,0,0,,Ах! )) ((Үлкен аға...))
Dialogue: 0,0:13:39.44,0:13:41.71,Default,,0,0,0,,((Хмф! Аға мен әпке бірге→
Dialogue: 0,0:13:41.71,0:13:44.66,Default,,0,0,0,,Мұның сізге пайдасы жоқ)) ((Tch…))
Dialogue: 0,0:13:44.66,0:13:48.85,Default,,0,0,0,,Күндердің күнінде Қасымның әкесі қараңғы жақтан жоғалып кетті.
Dialogue: 0,0:13:48.85,0:13:52.34,Default,,0,0,0,,Жарайды, бұл шалғындардағы қарапайым әңгіме.
Dialogue: 0,0:13:52.34,0:13:56.76,Default,,0,0,0,,Қасым мен Мариямның анасы оларды асырап алды.
Dialogue: 0,0:13:56.76,0:14:00.33,Default,,0,0,0,,Осылайша төртеуміз бір отбасы болдық.
Dialogue: 0,0:14:00.33,0:14:03.93,Default,,0,0,0,,Отбасы? Ол жанды көрінеді, бұл жақсы.
Dialogue: 0,0:14:03.93,0:14:07.84,Default,,0,0,0,,Ах. Бұл жанды және көңілді болды.
Dialogue: 0,0:14:07.84,0:14:11.64,Default,,0,0,0,,Алайда мұндай өмір ұзаққа бармады.
Dialogue: 0,0:14:13.17,0:14:16.07,Default,,0,0,0,,Анам ауырып қайтыс болды.
Dialogue: 0,0:14:17.36,0:14:20.32,Default,,0,0,0,,Менің қолымнан келгені жылау ғана болды.
Dialogue: 0,0:14:20.32,0:14:22.58,Default,,0,0,0,,Бірақ Қасым басқаша болды.
Dialogue: 0,0:14:22.58,0:14:25.40,Default,,0,0,0,,((Жылама. Бұдан былай→
Dialogue: 0,0:14:25.40,0:14:27.99,Default,,0,0,0,,Мен сені қорғаймын))
Dialogue: 0,0:14:27.99,0:14:32.79,Default,,0,0,0,,Бала кезімізде біз бірге көп жұмыс жасадық.
Dialogue: 0,0:14:32.79,0:14:35.10,Default,,0,0,0,,Қоқыстарды жинау және аяқ киімді жылтырату→
Dialogue: 0,0:14:35.10,0:14:37.83,Default,,0,0,0,,Туристік ақпарат.
Dialogue: 0,0:14:37.83,0:14:39.87,Default,,0,0,0,,Бірақ ақырында Қасым→
Dialogue: 0,0:14:39.87,0:14:43.79,Default,,0,0,0,,Мен көшедегі балалармен араласып, ұрлық жасай бастадым.
Dialogue: 0,0:14:43.79,0:14:48.76,Default,,0,0,0,,Қасым тіршілігін қорғауға тырысқан болуы мүмкін.
Dialogue: 0,0:14:48.76,0:14:52.30,Default,,0,0,0,,Бір күні мен айттым:
Dialogue: 0,0:14:52.30,0:15:04.11,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:15:04.11,0:15:08.08,Default,,0,0,0,,((Мен сол қарттың ұрпағынан шыққан жауызмын.→
Dialogue: 0,0:15:08.08,0:15:10.18,Default,,0,0,0,,Бірақ сіз басқасыз. →
Dialogue: 0,0:15:10.18,0:15:14.74,Default,,0,0,0,,Анаң сияқты адал өмір сүру керек))
Dialogue: 0,0:15:14.74,0:15:16.96,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:15:16.96,0:15:21.28,Default,,0,0,0,,Қасым бұл күні біртүрлі болды.
Dialogue: 0,0:15:21.28,0:15:24.78,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:15:26.15,0:15:30.25,Default,,0,0,0,,) ((хаха...))
Dialogue: 0,0:15:31.99,0:15:35.99,Default,,0,0,0,,Бір күні Барбад королі кедейлерге келеді.
Dialogue: 0,0:15:38.09,0:15:40.91,Default,,0,0,0,,((Сен менің ұлымсың. →
Dialogue: 0,0:15:40.91,0:15:43.87,Default,,0,0,0,,Бұдан былай патша сарайында тұрасың))
Dialogue: 0,0:15:43.87,0:15:51.24,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:15:51.24,0:15:54.66,Default,,0,0,0,,((Анис анаңыз →
Dialogue: 0,0:15:54.66,0:15:58.15,Default,,0,0,0,,Баяғыда ол патша сарайында қызмет еткен қызметші қыз болған. →
Dialogue: 0,0:15:58.15,0:16:01.43,Default,,0,0,0,,Мен оны алғаш рет сонда көрдім. →
Dialogue: 0,0:16:01.43,0:16:03.93,Default,,0,0,0,,Ал сен дүниеге келдің))
Dialogue: 0,0:16:05.45,0:16:09.54,Default,,0,0,0,,((Күтілгендей. Мен әрқашан бұл туралы ойланатынмын →
Dialogue: 0,0:16:09.54,0:16:12.39,Default,,0,0,0,,Неліктен сен сияқты біреу бар?))
Dialogue: 0,0:16:12.39,0:16:17.58,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:16:17.58,0:16:20.03,Default,,0,0,0,,((Сіз және мен дүниеге келдік →
Dialogue: 0,0:16:20.03,0:16:24.39,Default,,0,0,0,,Ол басқа адам. Кез келген жерге барыңыз))
Dialogue: 0,0:16:24.39,0:16:27.59,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:16:29.31,0:16:32.31,Default,,0,0,0,,Қасым мені тоқтатады деп ойладым.
Dialogue: 0,0:16:32.31,0:16:35.92,Default,,0,0,0,,Өйткені Қасым отбасы болған.
Dialogue: 0,0:16:35.92,0:16:38.44,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:38.44,0:16:42.99,Default,,0,0,0,,Ақырында мен жай ғана қараңғы үйден шықтым.
Dialogue: 0,0:16:42.99,0:16:46.29,Default,,0,0,0,,() ((Бұл ханзада))
Dialogue: 0,0:16:46.29,0:16:48.33,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:16:48.33,0:16:51.93,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:51.93,0:16:54.40,Default,,0,0,0,,Менің өмірім мүлде өзгерді.
Dialogue: 0,0:16:54.40,0:16:57.59,Default,,0,0,0,,Барлық жеке күтімді қызметші күтеді →
Dialogue: 0,0:16:57.59,0:16:59.62,Default,,0,0,0,,Қалай сөйлеу және жүру →
Dialogue: 0,0:16:59.62,0:17:02.41,Default,,0,0,0,,Академиялық: қылышқа дейін→
Dialogue: 0,0:17:02.41,0:17:04.81,Default,,0,0,0,,Күн сайын қатаң жаттығулар қажет болды.
Dialogue: 0,0:17:07.37,0:17:10.15,Default,,0,0,0,,Ал үш жыл өтті →
Dialogue: 0,0:17:10.15,0:17:13.72,Default,,0,0,0,,Шаладағы күндерім есте қалды.
Dialogue: 0,0:17:13.72,0:17:22.66,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:22.66,0:17:26.08,Default,,0,0,0,,Күндердің күнінде мен шалшықты көргім келді →
Dialogue: 0,0:17:26.08,0:17:28.18,Default,,0,0,0,,Мен патша сарайынан жасырын шықтым.
Dialogue: 0,0:17:30.15,0:17:33.61,Default,,0,0,0,,Бірақ ол жерде ештеңе болған жоқ.
Dialogue: 0,0:17:33.61,0:17:36.16,Default,,0,0,0,,Қоқыс қаласы жақсы сақталған→
Dialogue: 0,0:17:36.16,0:17:38.56,Default,,0,0,0,,Қашықтықта тұратындар болған жоқ.
Dialogue: 0,0:17:38.56,0:17:51.41,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:51.41,0:17:53.44,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:17:53.44,0:18:01.97,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:01.97,0:18:05.99,Default,,0,0,0,,Қасымды сол кезде не үшін кездестірдім деп ойлаймын.
Dialogue: 0,0:18:05.99,0:18:10.25,Default,,0,0,0,,Егер мен ол кезде патша сарайынан қашпасам→
Dialogue: 0,0:18:10.25,0:18:12.75,Default,,0,0,0,,Бұл оқиға ешқашан болған емес.
Dialogue: 0,0:18:14.45,0:18:16.45,Default,,0,0,0,,Осындай оқиға болды ма?
Dialogue: 0,0:20:18.66,0:20:23.21,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:24.78,0:20:29.15,Default,,0,0,0,,((Эй! Бұл Alibaba емес пе? Біраз уақыт болды. →
Dialogue: 0,0:20:29.15,0:20:32.04,Default,,0,0,0,,Хаха! )) ()
Dialogue: 0,0:20:32.04,0:20:58.23,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:58.23,0:21:00.26,Default,,0,0,0,,((Ішейік.→
Dialogue: 0,0:21:00.26,0:21:03.60,Default,,0,0,0,,Иә? Тіпті бір жұтым алмаңыз))
Dialogue: 0,0:21:03.60,0:21:07.17,Default,,0,0,0,,) ((... ішуге болады!))
Dialogue: 0,0:21:07.17,0:21:12.63,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:12.63,0:21:17.30,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:21:17.30,0:21:21.32,Default,,0,0,0,,Көзді ашып-жұмғанша уақытты кері қайтардық.
Dialogue: 0,0:21:21.32,0:21:24.86,Default,,0,0,0,,Бірақ қазір қайта ойласам, мен → түсінемін
Dialogue: 0,0:21:24.86,0:21:28.53,Default,,0,0,0,,Әлгі жігіттің көзі бір сәт күңгірттей көрінді.
Dialogue: 0,0:21:28.53,0:21:30.56,Default,,0,0,0,,Қасым сол күні →
Dialogue: 0,0:21:30.56,0:21:33.06,Default,,0,0,0,,Мен сізбен кездескен сәттен бастап сіз...→
Dialogue: 0,0:21:34.53,0:21:36.53,Default,,0,0,0,,Бұл оқиғаға себеп болу.
Dialogue: 0,0:21:38.25,0:21:41.31,Default,,0,0,0,,((Айтпақшы, мен сізді патша сарайында қамауға алғаныңызды бұрын естідім→
Dialogue: 0,0:21:41.31,0:21:44.61,Default,,0,0,0,,Сіз мұны айттыңыз, солай ма? Сонымен, біз мұнда қалай келдік? ))
Dialogue: 0,0:21:44.61,0:21:49.05,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:21:49.05,0:21:51.83,Default,,0,0,0,,) ((Есіңде ме?))
Dialogue: 0,0:21:51.83,0:21:57.96,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:21:57.96,0:22:01.19,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:01.19,0:22:05.46,Default,,0,0,0,,((Ей, Қасым... Патша сарайына кірген күнім →
Dialogue: 0,0:22:05.46,0:22:08.16,Default,,0,0,0,,Мм... сені ұрғаным жаман болды))
Dialogue: 0,0:22:09.53,0:22:12.54,Default,,0,0,0,,((Бірақ мен кез келген жерге баруға болады дедім→
Dialogue: 0,0:22:12.54,0:22:15.66,Default,,0,0,0,,Бұл... бұл→
Dialogue: 0,0:22:15.66,0:22:17.66,Default,,0,0,0,,Сіз мұны мен үшін айттыңыз, солай ма? ))
Dialogue: 0,0:22:19.74,0:22:22.01,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:22:22.01,0:22:25.27,Default,,0,0,0,,) ()
Dialogue: 0,0:22:25.27,0:22:27.35,Default,,0,0,0,,Мен бақытты болдым.
Dialogue: 0,0:22:27.35,0:22:29.70,Default,,0,0,0,,Қасымның мені ойлап тұрғаны.
Dialogue: 0,0:22:29.70,0:22:31.80,Default,,0,0,0,,()
Dialogue: 0,0:22:33.12,0:22:35.91,Default,,0,0,0,,Сондықтан мен байқамадым →
Dialogue: 0,0:22:35.91,0:22:38.61,Default,,0,0,0,,Менің артымнан сол жігіттің қол астындағы қызметкері келе жатты.
Dialogue: 0,0:22:42.30,0:22:46.25,Default,,0,0,0,,Мен шынымен ақымақпын. мен...
Dialogue: 0,0:22:46.25,0:22:48.69,Default,,0,0,0,,Алибаба-кун….
Dialogue: 0,0:22:48.69,0:22:51.33,Default,,0,0,0,,Содан бір күн, біраз уақыттан кейін →
Dialogue: 0,0:22:51.33,0:22:54.78,Default,,0,0,0,,Мені төсегінде ауырып жатқан патша шақырды.
Dialogue: 0,0:22:54.78,0:22:58.00,Default,,0,0,0,,((Менің уақытым аз қалды.→
Dialogue: 0,0:22:58.00,0:23:03.19,Default,,0,0,0,,Абумад жалқау, басқа елдің айтқанын істейді. →
Dialogue: 0,0:23:03.19,0:23:07.21,Default,,0,0,0,,Alibaba, мен бұл елді саған қалдырғым келеді))
Dialogue: 0,0:23:07.21,0:23:14.61,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:23:16.02,0:23:19.92,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:23:19.92,0:23:23.52,Default,,0,0,0,,((Не?)) ((Ұлы мәртебелім менің анам...→
Dialogue: 0,0:23:23.52,0:23:27.22,Default,,0,0,0,,Жоқ.Анам туралы не ойладың? ))
Dialogue: 0,0:23:28.63,0:23:34.39,Default,,0,0,0,,((Анис... Көптеген шектеулер бар →
Dialogue: 0,0:23:34.39,0:23:36.99,Default,,0,0,0,,Біз бірге бола алмадық... →
Dialogue: 0,0:23:38.34,0:23:42.28,Default,,0,0,0,,Бірақ... Иә→
Dialogue: 0,0:23:42.28,0:23:44.31,Default,,0,0,0,,Мен сені сүйдім))
Dialogue: 0,0:23:44.31,0:23:47.52,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:47.52,0:23:54.51,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:23:54.51,0:23:59.76,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:59.76,0:24:05.47,Default,,0,0,0,,) ()
Dialogue: 0,0:24:05.47,0:24:09.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:09.30,0:24:12.10,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:24:15.24,0:24:17.24,Default,,0,0,0,,Бұл бір сергек сезім болды.
Dialogue: 0,0:24:22.92,0:24:27.50,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:24:29.56,0:24:31.56,Default,,0,0,0,,) ((Уф!))
Dialogue: 0,0:24:32.98,0:24:36.33,Default,,0,0,0,,) ((Ах...))
Dialogue: 0,0:24:36.33,0:24:41.92,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:24:41.92,0:24:53.20,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:53.20,0:24:58.65,Default,,0,0,0,,Дұрыс... Қасымның қазынаны ұрлағаны →
Dialogue: 0,0:24:58.65,0:25:01.66,Default,,0,0,0,,Бұл мен дүкенде айтқан туннель болатын.
Dialogue: 0,0:25:01.66,0:25:05.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:05.83,0:25:08.33,Default,,0,0,0,,Қасым Әли Бабаны ұрлап әкетті.
Dialogue: 0,0:25:09.78,0:25:12.28,Default,,0,0,0,,Мүшелерді жинаңыз. Қайта қолға алынды.
Dialogue: 0,0:25:13.65,0:26:07.93,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:12.33,0:26:18.63,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:23.00,0:26:40.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:14.62,0:28:16.65,Default,,0,0,0,,Генералдар арасындағы мәселені шешейік→
Dialogue: 0,0:28:16.65,0:28:19.20,Default,,0,0,0,,Жұмбақ Әлибаба-кун. (Джафар) Бұл қиын, бірақ →
Dialogue: 0,0:28:19.20,0:28:21.60,Default,,0,0,0,,Сатқынның соңы – қоршау.
Dialogue: 0,0:28:24.06,0:28:27.86,Default,,0,0,0,,Ойлан, ағайын! Халық өлгенше қиналып жатыр!
Dialogue: 0,0:30:40.84,0:30:43.38,Default,,0,0,0,,Бүгін, үш күндік мерекенің соңғы күні,
Dialogue: 0,0:30:45.72,0:30:48.37,Default,,0,0,0,,Әртүрлі жерлердегі жедел жолдарда, демалыс аймағынан қайтып келе жатқан автокөлікпен және т.б.
Dialogue: 0,0:30:50.84,0:30:52.82,Default,,0,0,0,,Адамдар көп және кей жерлерде
Dialogue: 0,0:30:52.82,0:30:55.89,Default,,0,0,0,,50 км-ден асатын қатты көлік кептелісі.
Dialogue: 0,0:30:57.39,0:31:02.39,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
