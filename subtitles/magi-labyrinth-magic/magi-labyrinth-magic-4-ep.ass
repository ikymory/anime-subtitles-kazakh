Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.89,0:00:36.49,Default,,0,0,0,,О~ Қош келдіңіз. Қош келдіңіз, қош келдіңіз.
Dialogue: 0,0:00:39.89,0:00:41.93,Default,,0,0,0,,Жоқ, мырза→
Dialogue: 0,0:00:41.93,0:00:45.90,Default,,0,0,0,,Ол бүгін тағы да жақсы адам. Бұл болуы керек →
Dialogue: 0,0:00:45.90,0:00:49.62,Default,,0,0,0,,Сіз тым жомартсыз, қазынаңызды осындай нәрсеге жұмсауға болмайды. →
Dialogue: 0,0:00:49.62,0:00:52.86,Default,,0,0,0,,Иә. Жүр, мұнда кел. →
Dialogue: 0,0:00:52.86,0:00:56.66,Default,,0,0,0,,Мен де саған ең жақсы шарап пен әйелдерді дайындадым.
Dialogue: 0,0:00:56.66,0:00:59.81,Default,,0,0,0,,Ал, маған қамқор болшы→
Dialogue: 0,0:00:59.81,0:01:02.93,Default,,0,0,0,,Ұялмайсың ба? ештене етпейді.
Dialogue: 0,0:01:02.93,0:01:04.93,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:01:07.55,0:01:10.14,Default,,0,0,0,,≪Одан бері үш күн өтті≫
Dialogue: 0,0:01:10.14,0:01:12.14,Default,,0,0,0,,>
Dialogue: 0,0:01:14.01,0:01:16.56,Default,,0,0,0,,≪Alibaba-sama→
Dialogue: 0,0:01:16.56,0:01:19.66,Default,,0,0,0,,Бізде бала тұтынушы бар. Ах!
Dialogue: 0,0:01:21.00,0:01:23.00,Default,,0,0,0,,Аладдинге қош келдіңіз!
Dialogue: 0,0:01:24.81,0:01:26.81,Default,,0,0,0,,Ах.
Dialogue: 0,0:01:28.19,0:01:30.29,Default,,0,0,0,,Қазынаны не үшін пайдалану керек→
Dialogue: 0,0:01:30.29,0:01:33.09,Default,,0,0,0,,Бізді құлдарды босаттың ба?
Dialogue: 0,0:01:34.98,0:01:37.58,Default,,0,0,0,,Мен мұны істей ме деп ойлаймын.
Dialogue: 0,0:01:39.19,0:01:41.99,Default,,0,0,0,,Барлығы сізге риза.
Dialogue: 0,0:01:43.37,0:01:48.60,Default,,0,0,0,,Мен де ризамын деп ойлаймын.
Dialogue: 0,0:01:48.60,0:01:52.60,Default,,0,0,0,,Сізге және сіздің досыңыз болған балаға.
Dialogue: 0,0:01:55.27,0:01:57.84,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,0:01:57.84,0:02:01.21,Default,,0,0,0,,Бір күні туған жеріме ораламын.
Dialogue: 0,0:02:01.21,0:02:03.21,Default,,0,0,0,,Бұл менің жанашырымның сөзі.
Dialogue: 0,0:02:05.58,0:02:09.88,Default,,0,0,0,,Қайырымды адамның сөзі? Дұрыс →
Dialogue: 0,0:02:11.29,0:02:13.32,Default,,0,0,0,,Мен де шешім қабылдауым керек.
Dialogue: 0,0:02:13.32,0:02:17.46,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:17.46,0:02:20.88,Default,,0,0,0,,>
Dialogue: 0,0:02:20.88,0:02:26.70,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:02:26.70,0:02:29.35,Default,,0,0,0,,≪Аладдин, мен істеу керек нәрсені істеп жатқанда→
Dialogue: 0,0:02:29.35,0:02:32.47,Default,,0,0,0,,Мен сені іздеймін. Және →
Dialogue: 0,0:02:32.47,0:02:34.47,Default,,0,0,0,,Тағы бірге шытырман оқиғаға барайық≫
Dialogue: 0,0:02:43.42,0:04:10.98,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:16.96,0:04:19.70,Default,,0,0,0,,()
Dialogue: 0,0:04:19.70,0:04:21.70,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:23.23,0:04:25.23,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:26.75,0:04:29.05,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:33.53,0:04:37.35,Default,,0,0,0,,≪Сіз ояусыз ба? Рафтың баласы. →
Dialogue: 0,0:04:37.35,0:04:40.10,Default,,0,0,0,,Хэхехехе. →
Dialogue: 0,0:04:40.10,0:04:42.54,Default,,0,0,0,,Өзіңізді жақсы сезінген сияқтысыз. →
Dialogue: 0,0:04:42.54,0:04:45.36,Default,,0,0,0,,Раф бақытты.
Dialogue: 0,0:04:45.36,0:04:48.86,Default,,0,0,0,,Руф? Ол жерде ұшып келеді.
Dialogue: 0,0:04:48.86,0:04:51.20,Default,,0,0,0,,А, әжең де көре ала ма?
Dialogue: 0,0:04:51.20,0:04:54.11,Default,,0,0,0,,Ах. →
Dialogue: 0,0:04:54.11,0:04:56.55,Default,,0,0,0,,Сіз де көре аласыз ба? →
Dialogue: 0,0:04:56.55,0:05:00.20,Default,,0,0,0,,Бұл сансыз өмір ағыны.
Dialogue: 0,0:05:00.20,0:05:03.86,Default,,0,0,0,,Дыбыстық сигнал дыбыстық сигнал... (Руфтың дауысы)
Dialogue: 0,0:05:03.86,0:05:05.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:07.28,0:05:11.30,Default,,0,0,0,,Эй, Рафф деген не? Ruff дегеніміз не→
Dialogue: 0,0:05:11.30,0:05:15.20,Default,,0,0,0,,яғни жанның мекені. →
Dialogue: 0,0:05:15.20,0:05:18.51,Default,,0,0,0,,Барлық тірі заттар өлуі керек→
Dialogue: 0,0:05:18.51,0:05:21.71,Default,,0,0,0,,Бір жерге оралу. →
Dialogue: 0,0:05:21.71,0:05:25.86,Default,,0,0,0,,Тән жерге қайтады, ал жан Руфуға барады→
Dialogue: 0,0:05:25.86,0:05:27.96,Default,,0,0,0,,Мен үйге бара жатырмын.
Dialogue: 0,0:05:29.33,0:05:33.35,Default,,0,0,0,,Оларға тек көмек керек. иә?
Dialogue: 0,0:05:33.35,0:05:36.57,Default,,0,0,0,,Ішімнің қуатын сіздермен бөліскім келеді →
Dialogue: 0,0:05:36.57,0:05:38.99,Default,,0,0,0,,Жарық бөлшектері жиналады →
Dialogue: 0,0:05:38.99,0:05:42.00,Default,,0,0,0,,Ол маған күш береді.
Dialogue: 0,0:05:42.00,0:05:45.30,Default,,0,0,0,,Не! бұл…. ≪Пасат
Dialogue: 0,0:05:45.30,0:05:49.10,Default,,0,0,0,,≪(Тоя) Әже. ше? Тоя.
Dialogue: 0,0:05:49.10,0:05:51.51,Default,,0,0,0,,Барлаушылар тобы оралды.
Dialogue: 0,0:05:51.51,0:05:53.51,Default,,0,0,0,,Ммм, түсіндім.
Dialogue: 0,0:06:11.43,0:06:13.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:13.44,0:06:17.65,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:17.65,0:06:19.92,Default,,0,0,0,,Сіз оны көре аласыз ба?
Dialogue: 0,0:06:19.92,0:06:21.92,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:23.29,0:06:25.92,Default,,0,0,0,,Хихен (аттың дыбысы) (Тоя) Доржи қош келдіңіз.
Dialogue: 0,0:06:25.92,0:06:29.26,Default,,0,0,0,,О! Сіз зардап шеккен жоқсыз ба?
Dialogue: 0,0:06:29.26,0:06:31.48,Default,,0,0,0,,Ах... а... (Тоя) Доржи →
Dialogue: 0,0:06:31.48,0:06:34.03,Default,,0,0,0,,Мен сені құлаған соң осында әкелдім.
Dialogue: 0,0:06:34.03,0:06:37.57,Default,,0,0,0,,≫Қазір жақсысың ба? Шығыста қалай болды?
Dialogue: 0,0:06:37.57,0:06:40.47,Default,,0,0,0,,Тағы бір ауылды басып алды.
Dialogue: 0,0:06:42.06,0:06:44.52,Default,,0,0,0,,≪Жарайды, Баба. →
Dialogue: 0,0:06:44.52,0:06:46.66,Default,,0,0,0,,Біз, Сары азу руы→
Dialogue: 0,0:06:46.66,0:06:50.20,Default,,0,0,0,,Біз жүздеген жылдар бойы басқа елдердің қолынан қорғандық. →
Dialogue: 0,0:06:50.20,0:06:52.23,Default,,0,0,0,,Осы жолы оларды тағы бір тепейік.
Dialogue: 0,0:06:52.23,0:06:54.27,Default,,0,0,0,,≪О. ≪Иә.
Dialogue: 0,0:06:54.27,0:06:57.34,Default,,0,0,0,,Отбасының мақтанышы үшін! (Барлығы) О!
Dialogue: 0,0:06:57.34,0:06:59.82,Default,,0,0,0,,Пуу (ысқырық дыбысы)
Dialogue: 0,0:06:59.82,0:07:02.89,Default,,0,0,0,,Уау!! Хехе!
Dialogue: 0,0:07:02.89,0:07:04.93,Default,,0,0,0,,Бұл не? Сіз?
Dialogue: 0,0:07:04.93,0:07:06.96,Default,,0,0,0,,Сіз Коу империясының тыңшысысыз ба?
Dialogue: 0,0:07:06.96,0:07:09.52,Default,,0,0,0,,Мұндай баланың тыңшы болуы мүмкін емес.
Dialogue: 0,0:07:09.52,0:07:11.55,Default,,0,0,0,,Бұл дұрыс, бірақ...
Dialogue: 0,0:07:11.55,0:07:14.74,Default,,0,0,0,,Сенің атың кім? Қайдан келдің?
Dialogue: 0,0:07:14.74,0:07:16.89,Default,,0,0,0,,Мен Аладдинмін.
Dialogue: 0,0:07:16.89,0:07:20.89,Default,,0,0,0,,Мен Чишан деген қалада болдым, білмейсің бе?
Dialogue: 0,0:07:22.30,0:07:26.20,Default,,0,0,0,,Мен бұл туралы естідім. Батысқа қарай →
Dialogue: 0,0:07:26.20,0:07:29.05,Default,,0,0,0,,Олар жаяу жүруге екі жыл кетеді деді.
Dialogue: 0,0:07:29.05,0:07:31.54,Default,,0,0,0,,Иә! Сонша алыс па?
Dialogue: 0,0:07:31.54,0:07:34.17,Default,,0,0,0,,Күрсіну…. Жарайды.
Dialogue: 0,0:07:34.17,0:07:38.16,Default,,0,0,0,,Екі аптадан кейін келе жатқан керуенге баруды сұраңыз.
Dialogue: 0,0:07:38.16,0:07:41.23,Default,,0,0,0,,Не? Мен үйге ерте бара аламын.
Dialogue: 0,0:07:41.23,0:07:45.37,Default,,0,0,0,,Жақсы! Үйге ерте қайтқыңыз келе ме?
Dialogue: 0,0:07:45.37,0:07:47.37,Default,,0,0,0,,Иә. Хехе.
Dialogue: 0,0:07:48.87,0:07:51.37,Default,,0,0,0,,Менің досыммен кездесу бар.
Dialogue: 0,0:07:53.11,0:07:56.30,Default,,0,0,0,,≪Хахаха. ≫Ах~ Хахаха!
Dialogue: 0,0:07:56.30,0:07:58.37,Default,,0,0,0,,Бұл жанды.
Dialogue: 0,0:07:58.37,0:08:01.22,Default,,0,0,0,,Көп балалы отбасы.
Dialogue: 0,0:08:01.22,0:08:05.06,Default,,0,0,0,,Сіз барлық отбасысыз ба? Бұл дұрыс. →
Dialogue: 0,0:08:05.06,0:08:09.26,Default,,0,0,0,,Біз жүздеген жылдар бойы бірге өмір сүрдік→
Dialogue: 0,0:08:09.26,0:08:12.55,Default,,0,0,0,,Біз бір отбасымыз.
Dialogue: 0,0:08:12.55,0:08:14.55,Default,,0,0,0,,Һмм.
Dialogue: 0,0:08:15.95,0:08:19.42,Default,,0,0,0,,((Сіздің отбасыңыз жоқ.→
Dialogue: 0,0:08:19.42,0:08:23.21,Default,,0,0,0,,Сіз басқа адамдардан мүлде бөлексіз→
Dialogue: 0,0:08:23.21,0:08:25.51,Default,,0,0,0,,Бұл бірегей болмыс))
Dialogue: 0,0:08:27.11,0:08:30.16,Default,,0,0,0,,Отбасы? жақсы.
Dialogue: 0,0:08:30.16,0:08:33.26,Default,,0,0,0,,Сіз не айтасыз? иә?
Dialogue: 0,0:08:34.85,0:08:39.77,Default,,0,0,0,,Шөптің адамдары бірге өмір сүрсе, біртұтас болады. →
Dialogue: 0,0:08:39.77,0:08:42.97,Default,,0,0,0,,Сіз енді біздің отбасымыздың мүшесісіз.
Dialogue: 0,0:08:44.36,0:08:47.41,Default,,0,0,0,,Бабаның баласы.
Dialogue: 0,0:08:47.41,0:08:49.45,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:08:49.45,0:08:53.17,Default,,0,0,0,,Әже мен сізді жақсы көремін! Хахаха.
Dialogue: 0,0:08:53.17,0:08:55.17,Default,,0,0,0,,Гуки! Ах! Ах...
Dialogue: 0,0:09:07.18,0:09:10.37,Default,,0,0,0,,Уау! Бұл дәмді! иә? →
Dialogue: 0,0:09:10.37,0:09:13.46,Default,,0,0,0,,Ах! Оны тікелей ішпеңіз!
Dialogue: 0,0:09:13.46,0:09:15.83,Default,,0,0,0,,Сіз жоқ дейсіз. Ах.
Dialogue: 0,0:09:15.83,0:09:19.13,Default,,0,0,0,,Бұл қорқынышты, адам. Ол біртүрлі бала. →
Dialogue: 0,0:09:20.66,0:09:22.93,Default,,0,0,0,,Бүгін ауа райы жақсы.
Dialogue: 0,0:09:22.93,0:09:26.64,Default,,0,0,0,,Иә. Ал семсер ше?
Dialogue: 0,0:09:26.64,0:09:28.64,Default,,0,0,0,,Кез келген жағдайда.
Dialogue: 0,0:09:31.68,0:09:36.08,Default,,0,0,0,,Мен ұрысатын күн ешқашан келмейді деп үміттенемін. →
Dialogue: 0,0:09:37.46,0:09:39.53,Default,,0,0,0,,Әрқашан осылай →
Dialogue: 0,0:09:39.53,0:09:42.33,Default,,0,0,0,,Бәріміз бірге өмір сүрсек, бақытты болар едік.
Dialogue: 0,0:09:45.26,0:09:49.23,Default,,0,0,0,,Уайымдама, Тоя. Мен сені міндетті түрде қорғаймын.
Dialogue: 0,0:09:49.23,0:09:51.29,Default,,0,0,0,,≪Хехин! иә?
Dialogue: 0,0:09:51.29,0:09:53.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:53.36,0:09:56.72,Default,,0,0,0,,Тоқтамаңыз! Апыр-ай!
Dialogue: 0,0:09:56.72,0:09:59.64,Default,,0,0,0,,Аладдин!
Dialogue: 0,0:09:59.64,0:10:02.01,Default,,0,0,0,,Уау! Уау...
Dialogue: 0,0:10:02.01,0:10:04.71,Default,,0,0,0,,Ах... Уа.
Dialogue: 0,0:10:13.13,0:10:16.44,Default,,0,0,0,,Амансың ба? бала. Ах.
Dialogue: 0,0:10:16.44,0:10:18.44,Default,,0,0,0,,Хехе.
Dialogue: 0,0:10:20.61,0:10:24.48,Default,,0,0,0,,Мен Коу империясының бірінші императорымын және үшінші перзентімін→
Dialogue: 0,0:10:24.48,0:10:29.18,Default,,0,0,0,,Рен Хакуэй. Мен мұнда дипломатия туралы сөйлесу үшін келдім.
Dialogue: 0,0:10:29.18,0:10:31.74,Default,,0,0,0,,Қош келдіңіз, ханшайым. →
Dialogue: 0,0:10:31.74,0:10:33.80,Default,,0,0,0,,Мен Сары азу руынанмын→
Dialogue: 0,0:10:33.80,0:10:37.89,Default,,0,0,0,,155-ші Ұлы Патша оның немересі→
Dialogue: 0,0:10:37.89,0:10:41.31,Default,,0,0,0,,Менің атым Шаған бақсы.
Dialogue: 0,0:10:41.31,0:10:44.70,Default,,0,0,0,,Мен бұл туралы білемін. Сары азу кланы →
Dialogue: 0,0:10:44.70,0:10:48.30,Default,,0,0,0,,Бір кездегі ең гүлденген ат үстіндегі тайпа. →
Dialogue: 0,0:10:48.30,0:10:51.42,Default,,0,0,0,,Бірінші ұлы патшада жынның күші болған →
Dialogue: 0,0:10:51.42,0:10:54.77,Default,,0,0,0,,Ұлы Сары азу империясы, тарихтағы ең үлкен мемлекет →
Dialogue: 0,0:10:54.77,0:10:57.28,Default,,0,0,0,,Салған деп естідім. →
Dialogue: 0,0:10:57.28,0:11:01.35,Default,,0,0,0,,Алайда соңғы жылдары әлсіреп, құл аулау құрбанына айналды→
Dialogue: 0,0:11:01.35,0:11:03.72,Default,,0,0,0,,Сіз мұны бастан кешірдіңіз бе? (Барлығы) Қарғыс атсын!
Dialogue: 0,0:11:03.72,0:11:07.74,Default,,0,0,0,,Бірақ бұл күрес бүгінгі күнге дейін жалғасуда.
Dialogue: 0,0:11:07.74,0:11:10.29,Default,,0,0,0,,Біздің қолшатырымыздың астына келіңіз.
Dialogue: 0,0:11:10.29,0:11:12.31,Default,,0,0,0,,≪Егер ол сіздің қолшатырыңыздың астында болса?
Dialogue: 0,0:11:12.31,0:11:15.36,Default,,0,0,0,,Бұл не...? Бұл мүмкін емес.
Dialogue: 0,0:11:15.36,0:11:17.73,Default,,0,0,0,,Біз Батыс Реме→
Dialogue: 0,0:11:17.73,0:11:20.47,Default,,0,0,0,,Партевияның және басқалардың оңтүстік-батыстағы бірігуі →
Dialogue: 0,0:11:20.47,0:11:24.67,Default,,0,0,0,,Басқаша айтқанда, біз әлемді біріктіруге ұмтыламыз. →
Dialogue: 0,0:11:24.67,0:11:27.84,Default,,0,0,0,,Сары азудың ата-бабаларының арманы. →
Dialogue: 0,0:11:27.84,0:11:30.46,Default,,0,0,0,,Маған көмектесіңізші.
Dialogue: 0,0:11:30.46,0:11:32.83,Default,,0,0,0,,≫Ата-бабалар? ≪Сол арман?
Dialogue: 0,0:11:32.83,0:11:35.35,Default,,0,0,0,,Не болды? Уго-кун.
Dialogue: 0,0:11:35.35,0:11:37.42,Default,,0,0,0,,Басқаша айтқанда, біздің ауыл→
Dialogue: 0,0:11:37.42,0:11:40.27,Default,,0,0,0,,Шабуыл, солай ма? (Бартл) Солай емес пе?
Dialogue: 0,0:11:40.27,0:11:42.82,Default,,0,0,0,,≪Ах! ≫Басқа жерге бару скучно ма?
Dialogue: 0,0:11:42.82,0:11:44.82,Default,,0,0,0,,Сәлем! Тыныш бол!
Dialogue: 0,0:11:46.24,0:11:50.08,Default,,0,0,0,,Ханшайым, бұлай асықпа.
Dialogue: 0,0:11:50.08,0:11:53.08,Default,,0,0,0,,Hmph. ≪(Тоя) Мм...→
Dialogue: 0,0:11:53.08,0:11:55.57,Default,,0,0,0,,Мен жылқы сүтінің ликерін қостым→
Dialogue: 0,0:11:55.57,0:11:58.31,Default,,0,0,0,,Ішіңізде баяу сөйлескіңіз келе ме?
Dialogue: 0,0:11:58.31,0:12:00.31,Default,,0,0,0,,Ал, рахмет.
Dialogue: 0,0:12:00.31,0:12:02.38,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:12:02.38,0:12:04.69,Default,,0,0,0,,Рёсай, не істеп жатырсың!
Dialogue: 0,0:12:04.69,0:12:08.98,Default,,0,0,0,,Мен асыл ханшайымыма жылқы сүтін ішуге рұқсат етпеймін.
Dialogue: 0,0:12:08.98,0:12:12.59,Default,,0,0,0,,Русаи! (Розай) Эй, балалар! →
Dialogue: 0,0:12:12.59,0:12:16.01,Default,,0,0,0,,Бұл ауыл енді Коу империясының бақылауына өтеді.
Dialogue: 0,0:12:16.01,0:12:18.94,Default,,0,0,0,,Иә!? (Рёсай) Дереу мойынсұн. →
Dialogue: 0,0:12:18.94,0:12:23.26,Default,,0,0,0,,Мен сені мына сасық, лас өмірден құтқарамын. →
Dialogue: 0,0:12:23.26,0:12:25.30,Default,,0,0,0,,Жаман оқиға емес, солай ма?
Dialogue: 0,0:12:25.30,0:12:27.77,Default,,0,0,0,,Уау!!
Dialogue: 0,0:12:27.77,0:12:30.04,Default,,0,0,0,,Гакин! Қарғыс атсын!
Dialogue: 0,0:12:30.04,0:12:32.92,Default,,0,0,0,,Бұл адамды өлтіру соғыс жариялаумен бірдей.
Dialogue: 0,0:12:32.92,0:12:34.96,Default,,0,0,0,,Сіз мұны қалайсыз ба?
Dialogue: 0,0:12:34.96,0:12:38.46,Default,,0,0,0,,Жарайсыңдар отбасы! ≪Тоқта, Доржи!
Dialogue: 0,0:12:42.77,0:12:45.94,Default,,0,0,0,,Tsk! Сіз де бас тартуыңыз керек.
Dialogue: 0,0:12:45.94,0:12:47.94,Default,,0,0,0,,Бұл өріс сызылған.
Dialogue: 0,0:12:53.08,0:12:55.66,Default,,0,0,0,,Неге тоқтадың? →
Dialogue: 0,0:12:55.66,0:12:58.85,Default,,0,0,0,,Шетелдіктерді жерлеуге тамаша мүмкіндік →
Dialogue: 0,0:12:58.85,0:13:01.12,Default,,0,0,0,,Мен оны елемеймін...
Dialogue: 0,0:13:01.12,0:13:04.49,Default,,0,0,0,,Олар болашақтың нұрлы елі.
Dialogue: 0,0:13:04.49,0:13:06.89,Default,,0,0,0,,Ең жақсы жоспарды қарастырыңыз.
Dialogue: 0,0:13:06.89,0:13:08.89,Default,,0,0,0,,Жақсы ма? Қарғыс атсын!
Dialogue: 0,0:13:10.43,0:13:13.23,Default,,0,0,0,,Болашақ ертең таңертең шешіледі.
Dialogue: 0,0:13:21.05,0:13:23.39,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:13:23.39,0:13:26.93,Default,,0,0,0,,Генерал ретінде мен бәрін бірге ұстауым керек...
Dialogue: 0,0:13:26.93,0:13:28.93,Default,,0,0,0,,≫Қайырлы кеш! Ах.
Dialogue: 0,0:13:31.13,0:13:33.23,Default,,0,0,0,,Қайырлы кеш, апа.
Dialogue: 0,0:13:36.97,0:13:39.41,Default,,0,0,0,,Сәлем. Мен Аладдинмін.
Dialogue: 0,0:13:39.41,0:13:42.78,Default,,0,0,0,,Мен жай ғана сенімен сөйлескім келді.
Dialogue: 0,0:13:42.78,0:13:45.76,Default,,0,0,0,,≪Сол мата...≫
Dialogue: 0,0:13:45.76,0:13:48.56,Default,,0,0,0,,Мен де сенімен сөйлескім келеді.
Dialogue: 0,0:13:50.38,0:13:53.04,Default,,0,0,0,,Бұл лабиринт заты емес пе?
Dialogue: 0,0:13:53.04,0:13:56.09,Default,,0,0,0,,Не? Құрамында адам түсінбейтін күш →
Dialogue: 0,0:13:56.09,0:13:59.33,Default,,0,0,0,,Жұмбақ құрал. Оны алу үшін→
Dialogue: 0,0:13:59.33,0:14:02.28,Default,,0,0,0,,Тек лабиринттен аман қалғандар. Бұл→
Dialogue: 0,0:14:02.28,0:14:05.75,Default,,0,0,0,,Бұл менде бастапқыда болған нәрсе. иә?
Dialogue: 0,0:14:05.75,0:14:10.07,Default,,0,0,0,,Сол ауылды басып алатын апаң ба?
Dialogue: 0,0:14:10.07,0:14:14.39,Default,,0,0,0,,Олай болса мен сенің тоқтауыңды қалаймын. Әже жылай береді.
Dialogue: 0,0:14:14.39,0:14:18.29,Default,,0,0,0,,Бұл менің отбасым туралы үйреткен мен жақсы көретін адамдар.
Dialogue: 0,0:14:19.68,0:14:21.71,Default,,0,0,0,,Мені өлтірме.
Dialogue: 0,0:14:21.71,0:14:25.25,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:25.25,0:14:29.19,Default,,0,0,0,,Мен сені өлтірмеймін... ешқашан. →
Dialogue: 0,0:14:29.19,0:14:33.89,Default,,0,0,0,,Әділ күшіммен, жүрегіммен әлемді біріктіремін→
Dialogue: 0,0:14:33.89,0:14:37.13,Default,,0,0,0,,Ешкім өлмейтін дүние жасағым келеді. →
Dialogue: 0,0:14:37.13,0:14:39.18,Default,,0,0,0,,Маған сеніңіз.
Dialogue: 0,0:14:39.18,0:14:41.22,Default,,0,0,0,,Дыбыстық сигнал...
Dialogue: 0,0:14:41.22,0:14:45.77,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:45.77,0:14:48.59,Default,,0,0,0,,Хехе.
Dialogue: 0,0:14:48.59,0:14:50.76,Default,,0,0,0,,Үлкен әпкенің айналасында →
Dialogue: 0,0:14:50.76,0:14:53.40,Default,,0,0,0,,Бұл өте шатастырады.
Dialogue: 0,0:14:53.40,0:14:56.40,Default,,0,0,0,,Мен түсіндім. Мен әжеммен сөйлесуге тырысамын.
Dialogue: 0,0:14:56.40,0:15:06.20,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:09.51,0:15:12.57,Default,,0,0,0,,Уго-кун сол ханымды кездестіргенде→
Dialogue: 0,0:15:12.57,0:15:14.57,Default,,0,0,0,,Қарт әже, кіріп келемін.
Dialogue: 0,0:15:17.15,0:15:19.51,Default,,0,0,0,,Атоса Алдыңғы лабиринтте →
Dialogue: 0,0:15:19.51,0:15:21.71,Default,,0,0,0,,Амон-кунмен не туралы сөйлестің?
Dialogue: 0,0:15:27.48,0:15:30.07,Default,,0,0,0,,Мен көремін. Жарайды →
Dialogue: 0,0:15:30.07,0:15:32.67,Default,,0,0,0,,Мен жауап бере алмайтын нәрселер бар екенін білемін.
Dialogue: 0,0:15:34.25,0:15:37.65,Default,,0,0,0,,Мен өзімді қалағанымша зерттеймін.
Dialogue: 0,0:15:39.13,0:15:41.34,Default,,0,0,0,,Мен бұл ауылда бір нәрсені түсінемін→
Dialogue: 0,0:15:41.34,0:15:43.45,Default,,0,0,0,,Менде сондай сезім бар.
Dialogue: 0,0:15:43.45,0:15:47.78,Default,,0,0,0,,Дыбыстық сигнал сигналдық сигнал...
Dialogue: 0,0:15:47.78,0:15:49.78,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:52.99,0:15:56.04,Default,,0,0,0,,Балалар... Мен сендерді ешқашан кешірмеймін! →
Dialogue: 0,0:15:56.04,0:15:58.86,Default,,0,0,0,,Кеттік! (Барлығы) О!
Dialogue: 0,0:15:58.86,0:16:01.15,Default,,0,0,0,,Ешқашан жауыңды өлтірме.
Dialogue: 0,0:16:01.15,0:16:04.08,Default,,0,0,0,,Бір адам болса да өлсе, бұл соғыс болады. →
Dialogue: 0,0:16:04.08,0:16:06.08,Default,,0,0,0,,Жақсы!?
Dialogue: 0,0:16:08.29,0:16:10.92,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:16:10.92,0:16:13.86,Default,,0,0,0,,Мені үйге аман-есен жеткізіңізші...
Dialogue: 0,0:16:13.86,0:16:16.08,Default,,0,0,0,,≫Таң! Ха!
Dialogue: 0,0:16:16.08,0:16:18.88,Default,,0,0,0,,Не болды? Әже.
Dialogue: 0,0:16:18.88,0:16:20.92,Default,,0,0,0,,Сіз кімсіз...?
Dialogue: 0,0:16:20.92,0:16:23.77,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:23.77,0:16:25.81,Default,,0,0,0,,Күте тұр, Тоя.
Dialogue: 0,0:16:25.81,0:16:29.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:29.11,0:16:32.83,Default,,0,0,0,,Иә! Бұл жігіттер мықты отбасы.
Dialogue: 0,0:16:32.83,0:16:35.83,Default,,0,0,0,,Мен оны мәңгілікке ақша табу үшін қолданамын.
Dialogue: 0,0:16:35.83,0:16:38.59,Default,,0,0,0,,Сіз не істемексіз? (Тоя) Ах! Уф...
Dialogue: 0,0:16:38.59,0:16:41.47,Default,,0,0,0,,Олар сізді балалы болуды жалғастырады.
Dialogue: 0,0:16:41.47,0:16:43.69,Default,,0,0,0,,А... у... (Капитан) Тұқымдассаң →
Dialogue: 0,0:16:43.69,0:16:46.99,Default,,0,0,0,,Сіз ақша табуды жалғастыра аласыз. Хмм….
Dialogue: 0,0:16:46.99,0:16:51.73,Default,,0,0,0,,Не? Бұл тіпті шағым ма? Жоқ, солай ма?
Dialogue: 0,0:16:51.73,0:16:54.02,Default,,0,0,0,,Уф! Ах!
Dialogue: 0,0:16:54.02,0:16:56.05,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:16:56.05,0:16:58.55,Default,,0,0,0,,≫ (Эскадрон) Капитан Мен қуғыншымын! (Капитан) Ан!?
Dialogue: 0,0:17:00.87,0:17:02.93,Default,,0,0,0,,Тоя!
Dialogue: 0,0:17:02.93,0:17:04.93,Default,,0,0,0,,Сәлем! Оны атып таста!
Dialogue: 0,0:17:06.25,0:17:08.30,Default,,0,0,0,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,0:17:08.30,0:17:11.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:11.58,0:17:13.64,Default,,0,0,0,,Сәлем! Ату, ату!
Dialogue: 0,0:17:13.64,0:17:18.07,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:18.07,0:17:20.11,Default,,0,0,0,,Қарғыс атсын... Маған жақындауға жол берме!
Dialogue: 0,0:17:20.11,0:17:23.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:23.30,0:17:25.30,Default,,0,0,0,,Дока! (Капитан) Арх!
Dialogue: 0,0:17:26.72,0:17:28.82,Default,,0,0,0,,Сары азу руымен араласпаңыз.
Dialogue: 0,0:17:28.82,0:17:30.82,Default,,0,0,0,,Келме! Гакин!
Dialogue: 0,0:17:32.24,0:17:35.96,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:17:35.96,0:17:37.96,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:17:39.43,0:17:41.90,Default,,0,0,0,,А... Қарғыс атсын!
Dialogue: 0,0:17:41.90,0:17:44.40,Default,,0,0,0,,Сәлем! Сіз~!
Dialogue: 0,0:19:46.39,0:19:48.39,Default,,0,0,0,,Дон Дон Дон Дон… (аяқ дыбысы)
Dialogue: 0,0:19:51.73,0:19:53.76,Default,,0,0,0,,Мен оны қадағалай алмай қалдым.
Dialogue: 0,0:19:53.76,0:19:57.15,Default,,0,0,0,,Осы жерде күте тұрыңыз. бірақ….
Dialogue: 0,0:19:57.15,0:20:00.97,Default,,0,0,0,,Бұл жігіттер жақсы сары азу жауынгерлері.
Dialogue: 0,0:20:00.97,0:20:03.27,Default,,0,0,0,,Маған сеніңіз.
Dialogue: 0,0:20:04.59,0:20:06.61,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:06.61,0:20:10.80,Default,,0,0,0,,Бірақ алыпты қолданып, руф → қолдан
Dialogue: 0,0:20:10.80,0:20:15.30,Default,,0,0,0,,Аладдин де ертегідегі сиқыршы сияқты.
Dialogue: 0,0:20:15.30,0:20:19.57,Default,,0,0,0,,Сіз Магиді білесіз бе? аа. Мен білемін.
Dialogue: 0,0:20:19.57,0:20:22.51,Default,,0,0,0,,Эй, айтшы. Magi дегеніміз не?
Dialogue: 0,0:20:22.51,0:20:24.71,Default,,0,0,0,,Мен сол сиқыршы болуым мүмкін.
Dialogue: 0,0:20:26.11,0:20:29.25,Default,,0,0,0,,Мен кім екенімді іздеймін.
Dialogue: 0,0:20:29.25,0:20:35.92,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:35.92,0:20:40.22,Default,,0,0,0,,Бұл дүниеде әлі елдер болмаған кездегі оқиға.
Dialogue: 0,0:20:42.43,0:20:46.03,Default,,0,0,0,,Апатқа ұшыраған адамдардың алдында →
Dialogue: 0,0:20:46.03,0:20:50.10,Default,,0,0,0,,Бір жас жігіт пайда болып: →
Dialogue: 0,0:20:50.10,0:20:52.47,Default,,0,0,0,,«Адамдар... ел жасайды→
Dialogue: 0,0:20:52.47,0:20:56.14,Default,,0,0,0,,Патшаның астында бірлікте өмір сүр. →
Dialogue: 0,0:20:56.14,0:20:59.90,Default,,0,0,0,,Патшалардың күші бұл мұнарадағы сынақтарды жеңеді→
Dialogue: 0,0:20:59.90,0:21:02.68,Default,,0,0,0,,Сіз оны аласыз».
Dialogue: 0,0:21:02.68,0:21:05.38,Default,,0,0,0,,Көптеген адамдар мұнараға жоғалып кетеді→
Dialogue: 0,0:21:05.38,0:21:10.09,Default,,0,0,0,,Ақырында бір адам қайтып, патша болып ел құрды→
Dialogue: 0,0:21:10.09,0:21:13.39,Default,,0,0,0,,Бейбітшілік келді.
Dialogue: 0,0:21:13.39,0:21:15.95,Default,,0,0,0,,Сол жұмбақ жігітті жұрт көрді→
Dialogue: 0,0:21:15.95,0:21:19.05,Default,,0,0,0,,Сірә, құрметтеп осылай атаса керек→
Dialogue: 0,0:21:20.53,0:21:22.82,Default,,0,0,0,,«Маги». Ах.
Dialogue: 0,0:21:22.82,0:21:25.49,Default,,0,0,0,,Сол кезде ел құрылды→
Dialogue: 0,0:21:25.49,0:21:29.81,Default,,0,0,0,,Бізді Ұлы Сары Азу империясы деп атайды.
Dialogue: 0,0:21:29.81,0:21:34.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:38.53,0:21:41.80,Default,,0,0,0,,Мен көремін. Бұл сиқыр ма?
Dialogue: 0,0:21:41.80,0:21:44.59,Default,,0,0,0,,Кейде Аладдин. иә?
Dialogue: 0,0:21:44.59,0:21:47.18,Default,,0,0,0,,Сіз кімсіз?→
Dialogue: 0,0:21:47.18,0:21:50.71,Default,,0,0,0,,Енді бұл Бабаның ұлы Аладдин.
Dialogue: 0,0:21:50.71,0:21:52.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:52.75,0:21:56.19,Default,,0,0,0,,Сіздің достарыңыз бар ма?
Dialogue: 0,0:21:56.19,0:21:59.36,Default,,0,0,0,,Иә. Уго-кун және Алибаба-кун.
Dialogue: 0,0:21:59.36,0:22:03.68,Default,,0,0,0,,Онда сіз Ugo мен Alibaba-ның досысыз →
Dialogue: 0,0:22:03.68,0:22:06.05,Default,,0,0,0,,Аладдин. Ах.
Dialogue: 0,0:22:06.05,0:22:08.86,Default,,0,0,0,,Хохохохохо.
Dialogue: 0,0:22:08.86,0:22:12.77,Default,,0,0,0,,Бұл біртүрлі. Баба, сен кімсің?
Dialogue: 0,0:22:12.77,0:22:16.27,Default,,0,0,0,,Мен мұны көп білетінмін.
Dialogue: 0,0:22:16.27,0:22:19.69,Default,,0,0,0,,Иә! Рахмет, әже.
Dialogue: 0,0:22:19.69,0:22:21.89,Default,,0,0,0,,Сіз білесіз. Бұл не?
Dialogue: 0,0:22:23.25,0:22:27.08,Default,,0,0,0,,Кеше мен Коу империясының ханшайымын кездестірдім→
Dialogue: 0,0:22:27.08,0:22:29.18,Default,,0,0,0,,Бір-бірімізді өлтірмеуге уәде бердік.
Dialogue: 0,0:22:30.62,0:22:34.46,Default,,0,0,0,,Сондықтан соғыс болмайды. Сенімен бәрі жақсы ма.
Dialogue: 0,0:22:34.46,0:22:38.66,Default,,0,0,0,,Уа... Раббым... Қараңдар!
Dialogue: 0,0:22:38.66,0:22:40.73,Default,,0,0,0,,Барлығы қайтып келді.
Dialogue: 0,0:22:40.73,0:22:44.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:44.30,0:22:46.30,Default,,0,0,0,,О!
Dialogue: 0,0:22:48.77,0:22:52.83,Default,,0,0,0,,Баба! Барлығы қауіпсіз. →
Dialogue: 0,0:22:52.83,0:22:55.88,Default,,0,0,0,,Ешкімді өлтірмей жалғыз адамды құтқардым!
Dialogue: 0,0:22:55.88,0:22:57.88,Default,,0,0,0,,О...
Dialogue: 0,0:22:59.30,0:23:02.45,Default,,0,0,0,,Бабаның сөзі есіме түсті. →
Dialogue: 0,0:23:02.45,0:23:04.74,Default,,0,0,0,,Жауды өлтірсең, соғыс болады. →
Dialogue: 0,0:23:04.74,0:23:07.94,Default,,0,0,0,,Сонда біз бірге тұра алмас едік. →
Dialogue: 0,0:23:07.94,0:23:09.94,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:23:11.36,0:23:13.36,Default,,0,0,0,,) ((уф!))
Dialogue: 0,0:23:15.20,0:23:17.20,Default,,0,0,0,,) ((Хааааа...))
Dialogue: 0,0:23:18.75,0:23:21.29,Default,,0,0,0,,Сонымен... Хехе. (Тоя) Хехе.
Dialogue: 0,0:23:21.29,0:23:24.39,Default,,0,0,0,,Керемет, Доржи. Ол аурады! →
Dialogue: 0,0:23:24.39,0:23:27.26,Default,,0,0,0,,Ауырды, Баба. (Барлығы) Хахахаха!
Dialogue: 0,0:23:27.26,0:23:30.48,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:30.48,0:23:35.12,Default,,0,0,0,,Империяға түсейік. Ах.
Dialogue: 0,0:23:35.12,0:23:38.42,Default,,0,0,0,,Біз нені қорғауымыз керек? →
Dialogue: 0,0:23:38.42,0:23:43.01,Default,,0,0,0,,Ел? Мақтаныш па? Жоқ, олай емес...→
Dialogue: 0,0:23:43.01,0:23:45.66,Default,,0,0,0,,Бұл біздің өміріміз.
Dialogue: 0,0:23:45.66,0:23:49.27,Default,,0,0,0,,Қандай жағдай болмасын соғысқа барма! →
Dialogue: 0,0:23:49.27,0:23:52.47,Default,,0,0,0,,Бүкіл отбасы қазіргі уақытта аман қалу үшін →
Dialogue: 0,0:23:52.47,0:23:54.54,Default,,0,0,0,,Ақылмен күрес.
Dialogue: 0,0:23:54.54,0:23:59.38,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:59.38,0:24:01.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:24:01.41,0:24:04.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:04.11,0:24:06.52,Default,,0,0,0,,Жылы.
Dialogue: 0,0:24:06.52,0:24:09.35,Default,,0,0,0,,Бұл. (Тоя) Рахмет.
Dialogue: 0,0:24:09.35,0:24:11.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:11.79,0:24:14.52,Default,,0,0,0,,Адам бол, Доржи.
Dialogue: 0,0:24:14.52,0:24:17.03,Default,,0,0,0,,Бетіңіз тентек көрінеді, Баба! Хахахаха.
Dialogue: 0,0:24:17.03,0:24:19.71,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:24:19.71,0:24:23.08,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:23.08,0:24:26.39,Default,,0,0,0,,Қайда бара жатырсың? А~ әжетхана, әжетхана.
Dialogue: 0,0:24:26.39,0:24:35.29,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:35.29,0:24:39.05,Default,,0,0,0,,≪Мені не қызықтырды? →
Dialogue: 0,0:24:39.05,0:24:43.97,Default,,0,0,0,,Менің міндетім – отбасымды сақтап қалу≫
Dialogue: 0,0:24:43.97,0:24:47.54,Default,,0,0,0,,≪Олай болса... қымбатты балаларым→
Dialogue: 0,0:24:47.54,0:24:51.11,Default,,0,0,0,,Шөберем Яшагоның жүзін көргенше →
Dialogue: 0,0:24:51.11,0:24:55.81,Default,,0,0,0,,Мен бәрімен бірге аман қалуым керек≫
Dialogue: 0,0:24:57.28,0:24:59.28,Default,,0,0,0,,Thud! (Санған жебенің дыбысы)
Dialogue: 0,0:25:08.51,0:25:11.41,Default,,0,0,0,,≫Хахаха. Әже, сіз сондасыз ба?
Dialogue: 0,0:25:13.43,0:26:07.70,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:12.07,0:26:18.27,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:22.62,0:26:40.12,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:14.35,0:28:17.20,Default,,0,0,0,,Енді соғыс, ханшайым.
Dialogue: 0,0:28:17.20,0:28:20.70,Default,,0,0,0,,Мен саған ешқашан бұған жол бермеймін. Өйткені мен ол балаға уәде бердім.
Dialogue: 0,0:28:23.82,0:28:27.02,Default,,0,0,0,,Боқ~ Мен де ханшайыммен танысқым келді.
Dialogue: 0,0:30:42.18,0:30:44.65,Default,,0,0,0,,Кеше Кочи қаласындағы канализациялық құрылыс алаңында.
Dialogue: 0,0:30:47.58,0:30:50.24,Default,,0,0,0,,Екі ер жұмысшы тірідей көмілген апат
Dialogue: 0,0:30:51.52,0:30:54.17,Default,,0,0,0,,Оқиға орнында, тіпті індет басталғаннан кейін бір күннен астам уақыт өткенде,
Dialogue: 0,0:30:54.17,0:30:56.36,Default,,0,0,0,,Құтқару жұмыстары жалғасуда.
Dialogue: 0,0:30:57.86,0:31:02.86,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
