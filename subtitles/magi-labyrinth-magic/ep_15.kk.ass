Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.27,0:00:35.43,Default,,0,0,0,,Халықты тек қана қинайтын патша жеңіледі.
Dialogue: 0,0:00:35.43,0:00:37.60,Default,,0,0,0,,Азаматтар өз өкілдерін таңдайды→
Dialogue: 0,0:00:37.60,0:00:40.38,Default,,0,0,0,,Азаматтық үкімет құру және парламентті өткізу.
Dialogue: 0,0:00:40.38,0:00:43.72,Default,,0,0,0,,Ел қандай болу керектігін халық өзі шешеді.
Dialogue: 0,0:00:43.72,0:00:48.54,Default,,0,0,0,,Балбадты ешқандай теңсіздіксіз азаматтық республикаға айналдырыңыз.
Dialogue: 0,0:00:48.54,0:00:52.41,Default,,0,0,0,,Осы жерге әркімнің аяғын нық басып, өмір сүрейік.
Dialogue: 0,0:00:52.41,0:00:55.01,Default,,0,0,0,,Бұл жаңа Барбад!
Dialogue: 0,0:00:56.61,0:00:59.40,Default,,0,0,0,,≪Мен енді бұл жерден қашпаймын≫
Dialogue: 0,0:00:59.40,0:01:01.44,Default,,0,0,0,,≪Сізбен кішкене уәде →
Dialogue: 0,0:01:01.44,0:01:04.17,Default,,0,0,0,,Мен кейінге қалдырамын≫
Dialogue: 0,0:01:04.17,0:01:06.39,Default,,0,0,0,,>
Dialogue: 0,0:01:06.39,0:01:09.39,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:09.39,0:01:14.13,Default,,0,0,0,,Кел, тағдыр, үлкен жолмен кері ағып.
Dialogue: 0,0:01:14.13,0:01:17.74,Default,,0,0,0,,Барбад~! Алибаба мырза!
Dialogue: 0,0:01:17.74,0:01:20.62,Default,,0,0,0,,Барбад аман болсын! Барбад аман болсын!
Dialogue: 0,0:01:20.62,0:01:23.72,Default,,0,0,0,,Құрметті Alibaba! Құрметті Alibaba!
Dialogue: 0,0:01:25.11,0:01:27.51,Default,,0,0,0,,≪Мен бүгін бұл көріністі ешқашан ұмытпаймын≫
Dialogue: 0,0:01:27.51,0:01:31.05,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:31.05,0:01:34.85,Default,,0,0,0,,≪Мәңгілік сақталуы үшін оны жадыңызға жазыңыз≫
Dialogue: 0,0:01:36.15,0:01:38.19,Default,,0,0,0,,Ах.
Dialogue: 0,0:01:38.19,0:01:42.88,Default,,0,0,0,,♪♪~
Dialogue: 0,0:01:42.88,0:01:46.48,Default,,0,0,0,,Кел, Қасым.
Dialogue: 0,0:01:48.28,0:02:21.64,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:25.67,0:03:18.27,Default,,0,0,0,,♪♪~
Dialogue: 0,0:03:22.76,0:03:24.76,Default,,0,0,0,,А... бұл Қасым ғой.
Dialogue: 0,0:03:26.41,0:03:29.81,Default,,0,0,0,,≫Бұл Қасым. ≪Бұл Тұман тобынан Қасым.
Dialogue: 0,0:03:31.25,0:03:35.84,Default,,0,0,0,,Эй, енді маған шабуыл жасаудың қажеті жоқ. →
Dialogue: 0,0:03:35.84,0:03:38.39,Default,,0,0,0,,Бұл елдің енді патшасы жоқ. →
Dialogue: 0,0:03:38.39,0:03:42.29,Default,,0,0,0,,Әлібаба ханзада ел халықтікі деді.
Dialogue: 0,0:03:44.00,0:03:48.59,Default,,0,0,0,,Енді шабуыл жасауға ешқандай себеп жоқ. →
Dialogue: 0,0:03:48.59,0:03:51.74,Default,,0,0,0,,Не істеу керек? Қасым.
Dialogue: 0,0:03:51.74,0:03:54.74,Default,,0,0,0,,≪Ура! ≫Alibaba!
Dialogue: 0,0:03:54.74,0:03:57.63,Default,,0,0,0,,Иә! Барбад! Ура!
Dialogue: 0,0:03:57.63,0:04:00.61,Default,,0,0,0,,≪Ура! ≫Alibaba!
Dialogue: 0,0:04:00.61,0:04:03.27,Default,,0,0,0,,Құрметті Alibaba! Алибаба аман болсын!
Dialogue: 0,0:04:03.27,0:04:05.30,Default,,0,0,0,,≪Бұл... бәрі→
Dialogue: 0,0:04:05.30,0:04:08.60,Default,,0,0,0,,Осыны жинадың ба, Alibaba≫
Dialogue: 0,0:04:11.01,0:04:13.53,Default,,0,0,0,,≪Мүлдем сен сондайсың→
Dialogue: 0,0:04:13.53,0:04:15.53,Default,,0,0,0,,Ол керемет жігіт. →
Dialogue: 0,0:04:17.13,0:04:19.70,Default,,0,0,0,,Сіз әрқашан солай болдыңыз. →
Dialogue: 0,0:04:19.70,0:04:23.07,Default,,0,0,0,,Басқа біреу үшін болса, дұрыс деп санайтын нәрсені істе →
Dialogue: 0,0:04:23.07,0:04:25.07,Default,,0,0,0,,Ол қыңыр адам. →
Dialogue: 0,0:04:26.57,0:04:29.13,Default,,0,0,0,,Сондықтан мен сенімен біргемін→
Dialogue: 0,0:04:29.13,0:04:31.68,Default,,0,0,0,,Мен көптен бері араласып жүрмін. →
Dialogue: 0,0:04:31.68,0:04:35.13,Default,,0,0,0,,Ал енді ел үшін...→
Dialogue: 0,0:04:35.13,0:04:37.40,Default,,0,0,0,,Мені тоқтату үшін→
Dialogue: 0,0:04:37.40,0:04:40.97,Default,,0,0,0,,Бұл сіз берген жауап≫
Dialogue: 0,0:04:40.97,0:04:44.61,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:44.61,0:04:46.61,Default,,0,0,0,,≪Бірақ...≫
Dialogue: 0,0:04:48.11,0:04:50.21,Default,,0,0,0,,Не болады? Эй.
Dialogue: 0,0:04:52.53,0:04:55.05,Default,,0,0,0,,Иә. Барбад – →
Dialogue: 0,0:04:55.05,0:04:57.51,Default,,0,0,0,,Республика болды деп естідім. →
Dialogue: 0,0:04:57.51,0:05:00.27,Default,,0,0,0,,Енді патшаға тиесілі барлық жер→
Dialogue: 0,0:05:00.27,0:05:03.87,Default,,0,0,0,,Ол біздің халық арасында тең бөлінеді.
Dialogue: 0,0:05:06.33,0:05:09.38,Default,,0,0,0,,Бірақ бұл қулық емес пе?
Dialogue: 0,0:05:09.38,0:05:12.27,Default,,0,0,0,,Иә? (Барлығы) иә?
Dialogue: 0,0:05:12.27,0:05:14.67,Default,,0,0,0,,Бөлісу туралы не деуге болады? →
Dialogue: 0,0:05:14.67,0:05:17.98,Default,,0,0,0,,Бұл елде бәрі біздікі, халықтық→
Dialogue: 0,0:05:17.98,0:05:20.53,Default,,0,0,0,,Қан мен термен құрылған→
Dialogue: 0,0:05:20.53,0:05:22.83,Default,,0,0,0,,Бұл бастапқыда біздікі!
Dialogue: 0,0:05:22.83,0:05:25.65,Default,,0,0,0,,Біліксіз саясатпен жеп қой→
Dialogue: 0,0:05:25.65,0:05:28.77,Default,,0,0,0,,Кім кінәні бізге артты!?
Dialogue: 0,0:05:28.77,0:05:31.96,Default,,0,0,0,,А... Есіңде ме, солай ма? →
Dialogue: 0,0:05:31.96,0:05:35.83,Default,,0,0,0,,Ауыр салықтың бәрінен айырылған күндер. →
Dialogue: 0,0:05:35.83,0:05:40.41,Default,,0,0,0,,Ас ішпей өлген ата-ана, бауырлар.
Dialogue: 0,0:05:40.41,0:05:42.97,Default,,0,0,0,,Өлген адамдар қайтып келмейді!
Dialogue: 0,0:05:42.97,0:05:45.00,Default,,0,0,0,,Қарғыс атсын! Уф….
Dialogue: 0,0:05:45.00,0:05:47.04,Default,,0,0,0,,Хмм!
Dialogue: 0,0:05:47.04,0:05:51.63,Default,,0,0,0,,Монархия жойылса, патша әулетінің күнәсі де жойыла ма?
Dialogue: 0,0:05:51.63,0:05:53.68,Default,,0,0,0,,Бұл жоғалып кетуі мүмкін емес! →
Dialogue: 0,0:05:53.68,0:05:57.75,Default,,0,0,0,,Патша әулеті біздің жауымыз ғой!
Dialogue: 0,0:05:57.75,0:05:59.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:59.97,0:06:02.67,Default,,0,0,0,,Иә... Дұрыс…→
Dialogue: 0,0:06:02.67,0:06:06.99,Default,,0,0,0,,Республика болсақ та қызым қайтып келмейді.
Dialogue: 0,0:06:06.99,0:06:09.04,Default,,0,0,0,,Менің әпкем де...
Dialogue: 0,0:06:09.04,0:06:13.18,Default,,0,0,0,,Бірақ бір қызық, біз қазір теңбіз.
Dialogue: 0,0:06:13.18,0:06:15.22,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:06:15.22,0:06:18.10,Default,,0,0,0,,≪Біртүрлі... ≫Бұл біртүрлі...
Dialogue: 0,0:06:18.10,0:06:20.89,Default,,0,0,0,,≫Бұл біртүрлі. ≪Бұл біртүрлі.
Dialogue: 0,0:06:20.89,0:06:26.86,Default,,0,0,0,,Бұл біртүрлі! біртүрлі!
Dialogue: 0,0:06:26.86,0:06:28.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:28.90,0:06:32.43,Default,,0,0,0,,Енді тұру уақыты келді!
Dialogue: 0,0:06:32.43,0:06:35.50,Default,,0,0,0,,Елімізді жалмап кеткен патша әулеті→
Dialogue: 0,0:06:35.50,0:06:38.51,Default,,0,0,0,,Дворяндар мен ұлттық әскерді ату!!
Dialogue: 0,0:06:38.51,0:06:42.28,Default,,0,0,0,,Ооо!!
Dialogue: 0,0:06:42.28,0:06:45.58,Default,,0,0,0,,Тағдыр маған қарсы келе бастады. →
Dialogue: 0,0:06:45.58,0:06:50.68,Default,,0,0,0,,Сол себепті саған вассал бергені жөн еді.
Dialogue: 0,0:06:50.68,0:06:53.74,Default,,0,0,0,,Уау!!
Dialogue: 0,0:06:53.74,0:06:56.37,Default,,0,0,0,,Міне! Ақымақ!
Dialogue: 0,0:06:56.37,0:06:59.63,Default,,0,0,0,,≪Қасым... неге!?≫
Dialogue: 0,0:06:59.63,0:07:02.03,Default,,0,0,0,,≪Зұлымдық Alibaba≫
Dialogue: 0,0:07:04.00,0:07:06.28,Default,,0,0,0,,Бұл менің жауабым.
Dialogue: 0,0:07:06.28,0:07:19.43,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:19.43,0:07:23.08,Default,,0,0,0,,Аладдин Аладдин.
Dialogue: 0,0:07:23.08,0:07:27.22,Default,,0,0,0,,Әй, мына бала өлген жоқ па?
Dialogue: 0,0:07:27.22,0:07:29.92,Default,,0,0,0,,Аладдин! Аладдин!
Dialogue: 0,0:07:33.16,0:07:36.23,Default,,0,0,0,,Аладдин→
Dialogue: 0,0:07:36.23,0:07:38.23,Default,,0,0,0,,Аладдин. Хмм….
Dialogue: 0,0:08:01.12,0:08:03.17,Default,,0,0,0,,Сәлем. Ах.
Dialogue: 0,0:08:03.17,0:08:05.47,Default,,0,0,0,,Аладдинге қош келдіңіз.
Dialogue: 0,0:08:06.89,0:08:09.05,Default,,0,0,0,,Гюго...кун?
Dialogue: 0,0:08:09.05,0:08:13.25,Default,,0,0,0,,Иә. Сіз оны тік етіп жасай аласыз ба? Тігінен.
Dialogue: 0,0:08:14.75,0:08:17.87,Default,,0,0,0,,Мен оларды жасадым. →
Dialogue: 0,0:08:17.87,0:08:20.51,Default,,0,0,0,,Сен кеткеннен бері тым тыныш болды.
Dialogue: 0,0:08:20.51,0:08:23.09,Default,,0,0,0,,Мен өлдім деп ойлаймын.
Dialogue: 0,0:08:23.09,0:08:27.11,Default,,0,0,0,,Өлді ме? Өйткені менің де денем біртүрлі...
Dialogue: 0,0:08:27.11,0:08:31.25,Default,,0,0,0,,Эй, эй. Хахаха, жарайды.
Dialogue: 0,0:08:31.25,0:08:33.35,Default,,0,0,0,,Сіз өлген жоқсыз.
Dialogue: 0,0:08:33.35,0:08:37.01,Default,,0,0,0,,Менде Рафф пен оның достары мені алып жүрді. →
Dialogue: 0,0:08:37.01,0:08:41.51,Default,,0,0,0,,Дене жер бетінде тіршілік етеді. Эй.
Dialogue: 0,0:08:41.51,0:08:44.93,Default,,0,0,0,,Бірақ бұл қауіпті болды. →
Dialogue: 0,0:08:44.93,0:08:49.67,Default,,0,0,0,,Мен өте абайсызда өліп қала жаздадым. →
Dialogue: 0,0:08:49.67,0:08:53.69,Default,,0,0,0,,Сол Магиді де осында әкелуге тырысамын.→
Dialogue: 0,0:08:53.69,0:08:56.46,Default,,0,0,0,,Бұл жақсы емес сияқты.
Dialogue: 0,0:08:56.46,0:09:07.14,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:07.14,0:09:09.64,Default,,0,0,0,,Хмм…. Хмф!
Dialogue: 0,0:09:11.88,0:09:14.66,Default,,0,0,0,,Қасиетті сарайдың қалағанын істеуіне жол бермеймін.
Dialogue: 0,0:09:14.66,0:09:36.78,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:36.78,0:09:39.35,Default,,0,0,0,,Алда әлі көп→
Dialogue: 0,0:09:39.35,0:09:41.71,Default,,0,0,0,,Бұл дүниеде қараңғылық жасама.
Dialogue: 0,0:09:41.71,0:09:44.99,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:44.99,0:09:48.71,Default,,0,0,0,,Олардың бәрін өлтіріңіз! Әрине, патша сарайындағы адамдар→
Dialogue: 0,0:09:48.71,0:09:51.12,Default,,0,0,0,,Қаланың асылдары, тіпті күшті отбасылар!
Dialogue: 0,0:09:51.12,0:09:54.72,Default,,0,0,0,,Ой!
Dialogue: 0,0:09:54.72,0:09:58.02,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:58.02,0:10:00.42,Default,,0,0,0,,Бұл қиын! Патша сарайының сыртында →
Dialogue: 0,0:10:00.42,0:10:02.46,Default,,0,0,0,,Жан түршігерлік жанжал тарай бастады!
Dialogue: 0,0:10:02.46,0:10:04.50,Default,,0,0,0,,Ах! Қарғы сатқыр! →
Dialogue: 0,0:10:04.50,0:10:06.50,Default,,0,0,0,,Не болып жатыр!?
Dialogue: 0,0:10:07.95,0:10:13.05,Default,,0,0,0,,Жер бетінде тағдырды өзгертуге тырысатын адамдар бар.
Dialogue: 0,0:10:13.05,0:10:15.91,Default,,0,0,0,,Тағдырдың кері қайтуы?
Dialogue: 0,0:10:15.91,0:10:18.78,Default,,0,0,0,,Бастапқыда өмір қандай болса, →
Dialogue: 0,0:10:18.78,0:10:22.08,Default,,0,0,0,,Ағыспен өмір сүріп, алға ұмтыл. →
Dialogue: 0,0:10:23.53,0:10:25.98,Default,,0,0,0,,Сіз де, Рафтың жетекшілігімен→
Dialogue: 0,0:10:25.98,0:10:29.48,Default,,0,0,0,,Сен жындармен және олардың қожайындарымен кездесу арқылы осы уақытқа дейін жеттің.
Dialogue: 0,0:10:31.27,0:10:34.09,Default,,0,0,0,,Бұл тағдыр. Бірақ→
Dialogue: 0,0:10:34.09,0:10:37.98,Default,,0,0,0,,Мұндай эволюция дегенерацияға айналады, болмыс ештеңеге айналады →
Dialogue: 0,0:10:37.98,0:10:40.98,Default,,0,0,0,,Барлығын көлеңкеге қайтаруға тырысу...→
Dialogue: 0,0:10:42.37,0:10:44.70,Default,,0,0,0,,Сыбайлас жемқорлық деген осы.
Dialogue: 0,0:10:44.70,0:10:46.75,Default,,0,0,0,,Құлаған….
Dialogue: 0,0:10:46.75,0:10:51.19,Default,,0,0,0,,Сосын Рух денесін қара түске бояйды. →
Dialogue: 0,0:10:51.19,0:10:53.76,Default,,0,0,0,,Маги сізге де солай. →
Dialogue: 0,0:10:53.76,0:10:58.33,Default,,0,0,0,,Қара боялған Маги алдыңызда тұрды→
Dialogue: 0,0:10:58.33,0:11:00.90,Default,,0,0,0,,Мен де таң қалдым. →
Dialogue: 0,0:11:00.90,0:11:04.87,Default,,0,0,0,,Сізді сол кезде өлтіру керек еді→
Dialogue: 0,0:11:04.87,0:11:08.93,Default,,0,0,0,,Тағдырдың бұрмалануымен. →
Dialogue: 0,0:11:08.93,0:11:11.35,Default,,0,0,0,,Бірақ мен оған қарсы болдым. →
Dialogue: 0,0:11:11.35,0:11:16.27,Default,,0,0,0,,Мен қожайынымның маған қалдырған барлық сиқырлы күшін жұмсасам да. →
Dialogue: 0,0:11:16.27,0:11:18.55,Default,,0,0,0,,Маған сиқырлы күш беруге тырыстың, бірақ→
Dialogue: 0,0:11:18.55,0:11:21.12,Default,,0,0,0,,Мен сенің Джин емеспін. →
Dialogue: 0,0:11:21.12,0:11:26.11,Default,,0,0,0,,Міне, сондықтан, сен Жаратқан Иенің көшірмесі ретінде өз күшіңді ала алмайсың.
Dialogue: 0,0:11:26.11,0:11:29.83,Default,,0,0,0,,Мен сені енді қорғай алмаймын.
Dialogue: 0,0:11:29.83,0:11:32.47,Default,,0,0,0,,Ах... Сонымен →
Dialogue: 0,0:11:32.47,0:11:35.25,Default,,0,0,0,,Сыбызғыда қалған соңғы күшпен→
Dialogue: 0,0:11:35.25,0:11:37.69,Default,,0,0,0,,Мен сені осында шақырдым.
Dialogue: 0,0:11:37.69,0:11:41.59,Default,,0,0,0,,Сізге маңызды нәрсе беру.
Dialogue: 0,0:11:41.59,0:11:43.88,Default,,0,0,0,,Иә? Қараңыз.
Dialogue: 0,0:11:43.88,0:11:48.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:48.80,0:11:50.83,Default,,0,0,0,,Алибаба-кун!
Dialogue: 0,0:11:50.83,0:11:54.56,Default,,0,0,0,,Бұлай жалғаса берсе, сіз таңдаған патша өледі.
Dialogue: 0,0:11:54.56,0:11:58.09,Default,,0,0,0,,Алайда бұл бастапқы ағын емес.
Dialogue: 0,0:11:58.09,0:12:02.71,Default,,0,0,0,,Қараңғылықты тудыратын тағдырдың кері ағымы. Ах!
Dialogue: 0,0:12:02.71,0:12:06.13,Default,,0,0,0,,Адамдар қанша тырысса да, енді жетпейді→
Dialogue: 0,0:12:06.13,0:12:09.10,Default,,0,0,0,,Дүние қара түске айналғанда→
Dialogue: 0,0:12:09.10,0:12:11.17,Default,,0,0,0,,Бұл дүниеде қараңғылықты кесетін адам бар →
Dialogue: 0,0:12:11.17,0:12:13.57,Default,,0,0,0,,Маған ауаны шығару үшін күш керек.
Dialogue: 0,0:12:15.23,0:12:17.33,Default,,0,0,0,,Иә... ғажайып.
Dialogue: 0,0:12:19.81,0:12:22.81,Default,,0,0,0,,Бұл Магидің миссиясы. →
Dialogue: 0,0:12:24.13,0:12:28.73,Default,,0,0,0,,Сол тапсырманы орындау үшін белгілі бір жерге бару керек.
Dialogue: 0,0:12:31.04,0:12:35.11,Default,,0,0,0,,Дүние, тағдыр→
Dialogue: 0,0:12:35.11,0:12:37.11,Default,,0,0,0,,Өзіңді тану.
Dialogue: 0,0:12:38.48,0:12:40.82,Default,,0,0,0,,Ал бұл аяқталғаннан кейін сіз →
Dialogue: 0,0:12:40.82,0:12:44.61,Default,,0,0,0,,Мен оны алдым. Мырзам…→
Dialogue: 0,0:12:44.61,0:12:46.71,Default,,0,0,0,,Сүлейменнің даналығы.
Dialogue: 0,0:12:49.43,0:12:52.70,Default,,0,0,0,,≪Қош бол Аладдин. →
Dialogue: 0,0:12:52.70,0:12:56.07,Default,,0,0,0,,Мен сені енді ешқашан көрмеймін≫
Dialogue: 0,0:12:56.07,0:12:58.10,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:12:58.10,0:13:01.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:01.04,0:13:03.86,Default,,0,0,0,,≪Мен сені әлі жалғыз қалдыруым керек→
Dialogue: 0,0:13:03.86,0:13:06.08,Default,,0,0,0,,Ерте болуы мүмкін, бірақ...≫
Dialogue: 0,0:13:06.08,0:13:08.58,Default,,0,0,0,,≪Жоқ, енді жоқ. →
Dialogue: 0,0:13:09.98,0:13:13.28,Default,,0,0,0,,Аладдиннің сыртта достары бар→
Dialogue: 0,0:13:13.28,0:13:15.58,Default,,0,0,0,,Енді мен көп нәрсені жасай аламын. →
Dialogue: 0,0:13:17.09,0:13:20.59,Default,,0,0,0,,Негізі менсіз де жақсы≫
Dialogue: 0,0:13:22.19,0:13:25.43,Default,,0,0,0,,Сезамды ашыңыз!
Dialogue: 0,0:13:25.43,0:13:29.10,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:29.10,0:13:33.77,Default,,0,0,0,,≪Қасиетті ғибадатхана, сенің ұлы патшаң Сүлеймен→
Dialogue: 0,0:13:33.77,0:13:36.29,Default,,0,0,0,,Мына баланы жерге қайтар. →
Dialogue: 0,0:13:36.29,0:13:40.19,Default,,0,0,0,,Ал сенің даналығың мен кереметтерің→
Dialogue: 0,0:13:40.19,0:13:42.19,Default,,0,0,0,,Өтінемін, мына бала! ≫
Dialogue: 0,0:13:51.66,0:13:54.78,Default,,0,0,0,,Бұл қайда...?
Dialogue: 0,0:13:54.78,0:13:56.78,Default,,0,0,0,,Ах.
Dialogue: 0,0:14:00.71,0:14:05.45,Default,,0,0,0,,Бұл білімнің кең құйынына кіретін есік. →
Dialogue: 0,0:14:05.45,0:14:09.29,Default,,0,0,0,,қараңыз. Әрбір астық →
Dialogue: 0,0:14:09.29,0:14:13.19,Default,,0,0,0,,Дүниенің нақты элементар бөлшектері. →
Dialogue: 0,0:14:13.19,0:14:15.78,Default,,0,0,0,,Бұдан былай сіз олардың барлығына → кіресіз
Dialogue: 0,0:14:15.78,0:14:19.62,Default,,0,0,0,,Қайта ту, Маги.
Dialogue: 0,0:14:19.62,0:14:21.65,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:14:21.65,0:14:25.85,Default,,0,0,0,,Бәрі анық болады... осы ұзақ сапардан кейін.
Dialogue: 0,0:14:32.70,0:14:35.77,Default,,0,0,0,,Жақсы. Қызару бетіме қайта оралды.
Dialogue: 0,0:14:35.77,0:14:38.04,Default,,0,0,0,,Ах... ≫Уау!
Dialogue: 0,0:14:38.04,0:14:40.85,Default,,0,0,0,,≫Патша отбасын өлтіріңіз~! ≫Қызымды маған қайтарыңыз!
Dialogue: 0,0:14:40.85,0:14:42.85,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:45.18,0:14:48.96,Default,,0,0,0,,Қалғаны өзіңізге байланысты. баруымыз керек. →
Dialogue: 0,0:14:48.96,0:14:50.96,Default,,0,0,0,,Масрур патша сарайына барайық.
Dialogue: 0,0:14:53.70,0:14:55.74,Default,,0,0,0,,Мм... Қарғыс атсын! Қанекей мынаны істейік!
Dialogue: 0,0:14:55.74,0:14:57.79,Default,,0,0,0,,Хмф! Гррр….
Dialogue: 0,0:14:57.79,0:15:00.57,Default,,0,0,0,,Ей! Апыр-ай!
Dialogue: 0,0:15:00.57,0:15:04.03,Default,,0,0,0,,Вице-король, ұлттық әскерге жан-жақты шабуыл жасауға бұйрық беріңіз!
Dialogue: 0,0:15:04.03,0:15:06.81,Default,,0,0,0,,Ах... Қарсы жақ азамат болса да→
Dialogue: 0,0:15:06.81,0:15:11.22,Default,,0,0,0,,Бұл қазірдің өзінде соғыс. Алаң мен қала құрбандарға толы.
Dialogue: 0,0:15:11.22,0:15:14.29,Default,,0,0,0,,Шешім қабылдаңыз. Аа…. →
Dialogue: 0,0:15:14.29,0:15:16.81,Default,,0,0,0,,Біз не істеуіміз керек? Alibaba...
Dialogue: 0,0:15:16.81,0:15:19.44,Default,,0,0,0,,Ұлттық армияның жартысы бас қақпаға қарай бет алады→
Dialogue: 0,0:15:19.44,0:15:22.26,Default,,0,0,0,,Көтерілісшілердің басып кіруін тоқтата аласыз ба?
Dialogue: 0,0:15:22.26,0:15:26.40,Default,,0,0,0,,Қалғандары басып алғандарды басуға көмектеседі.
Dialogue: 0,0:15:26.40,0:15:29.47,Default,,0,0,0,,Зардап шеккендер мен олардың ағалары бас ғибадатханаға көшірілді.
Dialogue: 0,0:15:29.47,0:15:32.44,Default,,0,0,0,,Мен жау көсеміне барамын.
Dialogue: 0,0:15:32.44,0:15:35.14,Default,,0,0,0,,Қасымды тоқтатамын.
Dialogue: 0,0:17:37.28,0:17:39.58,Default,,0,0,0,,≪Уау! ≫Уау!
Dialogue: 0,0:17:42.20,0:17:45.09,Default,,0,0,0,,Ұлттық әскерде аяушылық жоқ. Дәл осылай→
Dialogue: 0,0:17:45.09,0:17:48.49,Default,,0,0,0,,Бас ғибадатханаға қарай алға ұмтылайық. (Барлығы) иә?
Dialogue: 0,0:17:50.06,0:17:52.11,Default,,0,0,0,,келді.
Dialogue: 0,0:17:52.11,0:17:54.11,Default,,0,0,0,,Уф! Ой...
Dialogue: 0,0:17:56.37,0:18:18.21,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:18.21,0:18:20.79,Default,,0,0,0,,Хмф! Эй Алибаба.
Dialogue: 0,0:18:20.79,0:18:24.03,Default,,0,0,0,,Не болды? Қорқынышты бет жасаңыз.
Dialogue: 0,0:18:24.03,0:18:27.51,Default,,0,0,0,,Қасым, сен не айтып тұрсың?
Dialogue: 0,0:18:27.51,0:18:29.88,Default,,0,0,0,,Монархия бітті.
Dialogue: 0,0:18:29.88,0:18:32.79,Default,,0,0,0,,Енді қан төгудің қажеті жоқ.
Dialogue: 0,0:18:32.79,0:18:34.89,Default,,0,0,0,,Сонда да сен неге?
Dialogue: 0,0:18:36.87,0:18:39.33,Default,,0,0,0,,Қасымға жауап бер!
Dialogue: 0,0:18:39.33,0:18:42.33,Default,,0,0,0,,Сіз нені айтасыз? Alibaba. →
Dialogue: 0,0:18:43.75,0:18:46.85,Default,,0,0,0,,Теңдік? Патшасы жоқ ел ме?
Dialogue: 0,0:18:48.34,0:18:51.94,Default,,0,0,0,,Мен мұндайды қашан сұрадым!?
Dialogue: 0,0:18:53.31,0:18:55.36,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:55.36,0:18:57.36,Default,,0,0,0,,Қасым Сәлем!
Dialogue: 0,0:18:59.91,0:19:02.55,Default,,0,0,0,,≪Олар да қара байлаулы тұман қылыштары ма?≫
Dialogue: 0,0:19:02.55,0:19:06.75,Default,,0,0,0,,≪Бірақ тұман, бұл Амон жалыны→
Dialogue: 0,0:19:06.75,0:19:09.09,Default,,0,0,0,,Мен сені жол бойы тепкілеймін! ≫
Dialogue: 0,0:19:09.09,0:19:11.09,Default,,0,0,0,,Қызыл иллюзия тұман қылыш!
Dialogue: 0,0:19:12.46,0:19:15.58,Default,,0,0,0,,≪ Қарғыс атсын! Бірақ... менің көзқарасым...≫
Dialogue: 0,0:19:15.58,0:19:20.25,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:20.25,0:19:23.25,Default,,0,0,0,,Эй, Alibaba→
Dialogue: 0,0:19:23.25,0:19:27.64,Default,,0,0,0,,Қалай ойлайсың, патшаның балалары патша ретінде өмір сүруі керек пе?
Dialogue: 0,0:19:27.64,0:19:30.51,Default,,0,0,0,,Қарғыс атсын! Қашықтықтағы бала →
Dialogue: 0,0:19:30.51,0:19:33.31,Default,,0,0,0,,Қалай ойлайсың, өмір бойы қараңғы жерде тұру керек пе?
Dialogue: 0,0:19:33.31,0:19:36.45,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:36.45,0:19:39.52,Default,,0,0,0,,Уф! Мен солай ойламаймын. →
Dialogue: 0,0:19:39.52,0:19:41.55,Default,,0,0,0,,Барлығы бірдей адам.
Dialogue: 0,0:19:41.55,0:19:45.76,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:45.76,0:19:47.86,Default,,0,0,0,,Сонымен, кез келген адам→
Dialogue: 0,0:19:47.86,0:19:51.40,Default,,0,0,0,,Ол патша болуға лайықты болуы керек.
Dialogue: 0,0:19:51.40,0:19:54.50,Default,,0,0,0,,Ха... Олай болса!
Dialogue: 0,0:19:55.90,0:19:57.94,Default,,0,0,0,,Амон!
Dialogue: 0,0:19:57.94,0:20:00.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:00.84,0:20:04.14,Default,,0,0,0,,Жоқ! Не!? Сол қылыш?
Dialogue: 0,0:20:05.50,0:20:09.77,Default,,0,0,0,,Қасым... Басқаша айтқанда, сіз →
Dialogue: 0,0:20:09.77,0:20:12.77,Default,,0,0,0,,Сіз жай ғана патша болғыңыз келді дейсіз бе?
Dialogue: 0,0:20:14.80,0:20:16.84,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:20:16.84,0:20:21.14,Default,,0,0,0,,Сонда не істеп жатырсың!? Айналаңыздағы барлық адамдарды тартыңыз!
Dialogue: 0,0:20:22.85,0:20:26.73,Default,,0,0,0,,Мен саған енді қалағаныңды істеуге рұқсат бермеймін!
Dialogue: 0,0:20:26.73,0:20:31.57,Default,,0,0,0,,Бұл бейберекет және шулы! Мен оны Сары басқыншы тұман қылышпен ерітемін! →
Dialogue: 0,0:20:31.57,0:20:34.72,Default,,0,0,0,,Теря~! Хмф!
Dialogue: 0,0:20:34.72,0:20:36.72,Default,,0,0,0,,Не!?
Dialogue: 0,0:20:38.08,0:20:40.36,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:40.36,0:20:42.36,Default,,0,0,0,,Хмф! Уф...
Dialogue: 0,0:20:44.80,0:20:47.20,Default,,0,0,0,,Уф! Қарғыс атсын... Ах!
Dialogue: 0,0:20:49.96,0:20:52.54,Default,,0,0,0,,Сарбаздарға тойтарыс беру. Қасым→
Dialogue: 0,0:20:52.54,0:20:54.58,Default,,0,0,0,,Мен сені қуып жіберемін.
Dialogue: 0,0:20:54.58,0:20:59.62,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:59.62,0:21:03.05,Default,,0,0,0,,Alibaba I шегінбеймін. →
Dialogue: 0,0:21:03.05,0:21:07.45,Default,,0,0,0,,Мен осылай шегінгенше өлгенім артық.
Dialogue: 0,0:21:09.34,0:21:12.74,Default,,0,0,0,,Менің ойымша, сізде маған шабуыл жасау үшін соншалықты шешім бар шығар.
Dialogue: 0,0:21:15.23,0:21:17.53,Default,,0,0,0,,Сондықтан мені өлтіріңіз.
Dialogue: 0,0:21:19.67,0:21:22.67,Default,,0,0,0,,Уф... Өлтіріңізші.
Dialogue: 0,0:21:22.67,0:21:24.71,Default,,0,0,0,,Қарғыс атсын! Мені өлтір.
Dialogue: 0,0:21:24.71,0:21:28.24,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:28.24,0:21:32.22,Default,,0,0,0,,Сен мені өлтіресің, Алибаба!!
Dialogue: 0,0:21:32.22,0:21:35.72,Default,,0,0,0,,Қасым... ау!
Dialogue: 0,0:21:35.72,0:21:37.75,Default,,0,0,0,,Өтінемін, мені өлтір, Әлибаба-сама! →
Dialogue: 0,0:21:37.75,0:21:39.96,Default,,0,0,0,,Міне!
Dialogue: 0,0:21:39.96,0:21:48.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:48.11,0:21:52.30,Default,,0,0,0,,Қарғыс атсын! Қарғыс атсын!!
Dialogue: 0,0:21:52.30,0:22:04.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:22:05.82,0:22:08.32,Default,,0,0,0,,Сен істей аласың ба... ақымақ!
Dialogue: 0,0:22:10.44,0:22:14.81,Default,,0,0,0,,Қасым Солдаттарды қазір шығарсақ, бүлік тоқтайды!
Dialogue: 0,0:22:14.81,0:22:18.81,Default,,0,0,0,,Олай болса, мен сенің емдеуің қандай болатынын әлі білмеймін.
Dialogue: 0,0:22:21.30,0:22:24.00,Default,,0,0,0,,Сол себепті!
Dialogue: 0,0:22:24.00,0:22:29.30,Default,,0,0,0,,Хаха. Сіз шынымен тәттісіз. →
Dialogue: 0,0:22:31.01,0:22:33.11,Default,,0,0,0,,Бұл соншалықты аңғал болуы мүмкін емес.
Dialogue: 0,0:22:34.68,0:22:37.28,Default,,0,0,0,,Сонда кездескенше. Аа….
Dialogue: 0,0:22:43.14,0:22:45.14,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:22:47.57,0:22:49.57,Default,,0,0,0,,Уф!
Dialogue: 0,0:22:51.06,0:22:53.06,Default,,0,0,0,,Хмм….
Dialogue: 0,0:22:55.55,0:22:57.65,Default,,0,0,0,,≪Менің мұны істеуден басқа амалым жоқ≫
Dialogue: 0,0:22:57.65,0:23:00.24,Default,,0,0,0,,((Тағдырға қарғыс айтсаң →
Dialogue: 0,0:23:00.24,0:23:03.54,Default,,0,0,0,,Қаруыңызға тән күшті пайдаланыңыз))
Dialogue: 0,0:23:08.34,0:23:11.81,Default,,0,0,0,,((Егер сіз оны пайдаланатын ыдыс болмасаңыз →
Dialogue: 0,0:23:11.81,0:23:14.31,Default,,0,0,0,,Өміріңді жоғалтасың))
Dialogue: 0,0:23:15.87,0:23:17.87,Default,,0,0,0,,Тағдыр...?
Dialogue: 0,0:23:21.77,0:23:24.67,Default,,0,0,0,,Мен сиқыр жасаймын.
Dialogue: 0,0:23:26.25,0:23:28.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:29.67,0:23:32.27,Default,,0,0,0,,Жоқ! Уф….
Dialogue: 0,0:23:34.29,0:23:37.52,Default,,0,0,0,,Хмм! Гах... →
Dialogue: 0,0:23:37.52,0:23:40.94,Default,,0,0,0,,Қараңдаршы... қарақұйрық бейбақтар→
Dialogue: 0,0:23:40.94,0:23:45.22,Default,,0,0,0,,Ұлттық әскерилер, ақсүйектер, патшалар... →
Dialogue: 0,0:23:45.22,0:23:48.27,Default,,0,0,0,,Бұл күш кез келген адамда болуы мүмкін→
Dialogue: 0,0:23:48.27,0:23:50.27,Default,,0,0,0,,Мен саған дәлелдеймін.
Dialogue: 0,0:23:51.94,0:23:55.36,Default,,0,0,0,,Жинал! Барлығы менің астымда!
Dialogue: 0,0:23:55.36,0:24:02.88,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:02.88,0:24:05.20,Default,,0,0,0,,Жоқ, яғни, ол қайда…
Dialogue: 0,0:24:05.20,0:24:07.24,Default,,0,0,0,,Ах! Ахх.
Dialogue: 0,0:24:07.24,0:24:10.54,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:10.54,0:24:13.66,Default,,0,0,0,,Ақыр соңында, оның қанымен бірге бұйрық берсең →
Dialogue: 0,0:24:13.66,0:24:16.66,Default,,0,0,0,,Туыстар бір кісідей жиналады. →
Dialogue: 0,0:24:16.66,0:24:19.72,Default,,0,0,0,,Қара ыдыстың иесі.
Dialogue: 0,0:24:19.72,0:24:21.75,Default,,0,0,0,,Уф! Уф….
Dialogue: 0,0:24:21.75,0:24:24.40,Default,,0,0,0,,Ах... Уф! →
Dialogue: 0,0:24:24.40,0:24:29.20,Default,,0,0,0,,Ух... Мм! Гррр…. →
Dialogue: 0,0:24:30.58,0:24:34.00,Default,,0,0,0,,Гуоооо... Мм...
Dialogue: 0,0:24:34.00,0:24:44.71,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:44.71,0:24:47.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:47.38,0:24:49.58,Default,,0,0,0,,Ақымақ! Әйтеуір, бұл...
Dialogue: 0,0:24:51.05,0:24:54.10,Default,,0,0,0,,Керемет!!
Dialogue: 0,0:24:54.10,0:24:57.75,Default,,0,0,0,,Ах... Қара... Маджин...
Dialogue: 0,0:24:57.75,0:24:59.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:59.81,0:25:01.84,Default,,0,0,0,,Куха!
Dialogue: 0,0:25:01.84,0:25:04.89,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:04.89,0:25:08.49,Default,,0,0,0,,Керемет!! (Барлығы) Уау!
Dialogue: 0,0:25:10.07,0:25:12.77,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:25:14.39,0:25:58.59,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:02.99,0:26:13.59,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:17.80,0:26:43.25,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:15.23,0:28:17.27,Default,,0,0,0,,Бұл елді тек сіз ғана сақтай аласыз!
Dialogue: 0,0:28:17.27,0:28:19.32,Default,,0,0,0,,Сіз менікі боласыз!
Dialogue: 0,0:28:19.32,0:28:22.42,Default,,0,0,0,,Неліктен бұлай ұзаққа барасың? Алибаба-кун.
Dialogue: 0,0:28:25.38,0:28:28.18,Default,,0,0,0,,Мен тірі болғанша күресемін.
Dialogue: 0,0:30:44.33,0:30:47.12,Default,,0,0,0,,Алдымен Алжирдегі барымта жағдайына тоқталайық.
Dialogue: 0,0:30:48.49,0:30:50.96,Default,,0,0,0,,Жапон азаматтарының өлімі немесе расталмаған тірі қалуы туралы ақпарат
Dialogue: 0,0:30:51.97,0:30:54.83,Default,,0,0,0,,Алжир үкіметі қамтамасыз еткеннен кейін
Dialogue: 0,0:30:54.83,0:30:57.38,Default,,0,0,0,,Жапон үкіметі бұған өз қызметкерлерінің қатысы барын айтты.
Dialogue: 0,0:30:58.88,0:31:03.88,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
