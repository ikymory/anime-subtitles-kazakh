Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.95,0:00:35.12,Default,,0,0,0,,Хаа хаа ха....
Dialogue: 0,0:00:35.12,0:00:37.15,Default,,0,0,0,,Сәлем! (Ауыл тұрғыны) Баба-сама!
Dialogue: 0,0:00:37.15,0:00:40.25,Default,,0,0,0,,Баба, берік бол! Баба!
Dialogue: 0,0:00:41.66,0:00:44.17,Default,,0,0,0,,Әже! Әлі тірі. →
Dialogue: 0,0:00:44.17,0:00:48.10,Default,,0,0,0,,Тездетіп, ауылға әкел! ≪А... аа!
Dialogue: 0,0:00:48.10,0:00:50.10,Default,,0,0,0,,Мен оны алып жүрмін.
Dialogue: 0,0:00:57.79,0:01:00.34,Default,,0,0,0,,>
Dialogue: 0,0:01:00.34,0:02:29.00,Default,,0,0,0,,♪♪~
Dialogue: 0,0:02:37.94,0:02:39.99,Default,,0,0,0,,Бұл рас па? иә.
Dialogue: 0,0:02:39.99,0:02:43.34,Default,,0,0,0,,Күзетте жүргенде бізге Сары азу әулеті шабуыл жасаған сияқты.
Dialogue: 0,0:02:43.34,0:02:45.93,Default,,0,0,0,,Сондықтан мен айттым. →
Dialogue: 0,0:02:45.93,0:02:48.50,Default,,0,0,0,,Келіссөздер енді қажет емес.
Dialogue: 0,0:02:48.50,0:02:50.80,Default,,0,0,0,,Оны бірден жою керек.
Dialogue: 0,0:02:52.40,0:02:54.62,Default,,0,0,0,,Сары азу ауылына барыңыз. (Розаи) Ал...
Dialogue: 0,0:02:54.62,0:02:58.11,Default,,0,0,0,,Жебеңді шынымен біздің әскерге бағыттадың ба?→
Dialogue: 0,0:02:58.11,0:03:01.00,Default,,0,0,0,,Мен тексеруім керек.
Dialogue: 0,0:03:01.00,0:03:04.05,Default,,0,0,0,,Банг! (Рёсай) Мен саған ұнайтын нәрсені істеуге рұқсат бермеймін! →
Dialogue: 0,0:03:04.05,0:03:08.14,Default,,0,0,0,,Сен ханшайым болсаң да, бұрынғы императордың қызысың. →
Dialogue: 0,0:03:08.14,0:03:12.72,Default,,0,0,0,,Менің қазіргі лауазымым қазіргі император ұлы мәртебелі мейіріммен берілді.
Dialogue: 0,0:03:12.72,0:03:14.79,Default,,0,0,0,,Ал мен, Мәртебелі →
Dialogue: 0,0:03:14.79,0:03:17.54,Default,,0,0,0,,Мен сізді бақылауға тағайындалдым.
Dialogue: 0,0:03:17.54,0:03:21.08,Default,,0,0,0,,Мен сенің өзімшіл әрекеттеріңе назар аудара алмаймын.
Dialogue: 0,0:03:21.08,0:03:23.78,Default,,0,0,0,,Олай болса мен өзім барамын.
Dialogue: 0,0:03:23.78,0:03:26.59,Default,,0,0,0,,Хакуэй-доно.
Dialogue: 0,0:03:26.59,0:03:28.62,Default,,0,0,0,,Күшпен үстемдік ақырында → болады
Dialogue: 0,0:03:28.62,0:03:30.87,Default,,0,0,0,,Үлкен кек алу.
Dialogue: 0,0:03:30.87,0:03:33.39,Default,,0,0,0,,Адамдардың жүрегін шынымен жаулап алатын нәрсе→
Dialogue: 0,0:03:33.39,0:03:36.26,Default,,0,0,0,,Бұл асыл мұрат пен ұмтылыс болуы керек.
Dialogue: 0,0:03:36.26,0:03:39.45,Default,,0,0,0,,Күрсін... Мен енді тоқтамаймын.
Dialogue: 0,0:03:39.45,0:03:43.70,Default,,0,0,0,,Мен сыртта жүргенде, мен әскери қолбасшылыққа жауапты боламын →
Dialogue: 0,0:03:43.70,0:03:45.76,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:03:45.76,0:03:49.06,Default,,0,0,0,,Сөзсіз. Кеттік, Сейшун.
Dialogue: 0,0:03:49.06,0:03:51.06,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:03:55.17,0:03:58.87,Default,,0,0,0,,Баба-саманы атқан жебе Коу империясының жебесімен бірдей!
Dialogue: 0,0:03:58.87,0:04:00.90,Default,,0,0,0,,Не? Біз күресуіміз керек!
Dialogue: 0,0:04:00.90,0:04:03.42,Default,,0,0,0,,Құлдарды аулап, Бабаны қараңғыда өлтірді→
Dialogue: 0,0:04:03.42,0:04:05.71,Default,,0,0,0,,Енді ұстауға ешқандай себеп жоқ!
Dialogue: 0,0:04:05.71,0:04:09.85,Default,,0,0,0,,Ах~ Иә! Біз өз руымыздың болашағы үшін күресуіміз керек!
Dialogue: 0,0:04:09.85,0:04:11.95,Default,,0,0,0,,<<Иә, иә! ≫Иә!
Dialogue: 0,0:04:11.95,0:04:14.40,Default,,0,0,0,,Барлығыңыз күтіңіздер! Баба →
Dialogue: 0,0:04:14.40,0:04:16.87,Default,,0,0,0,,Не болса да соғыс болмасын деді. →
Dialogue: 0,0:04:16.87,0:04:19.69,Default,,0,0,0,,Тек аман қалу үшін жүрегімізбен күресуіміз керек...
Dialogue: 0,0:04:19.69,0:04:22.21,Default,,0,0,0,,Бұл менің ниетім емес.
Dialogue: 0,0:04:22.21,0:04:24.78,Default,,0,0,0,,Тіпті Тоя да, басқалары да құл болып кете жаздады. →
Dialogue: 0,0:04:24.78,0:04:27.58,Default,,0,0,0,,Бізде қазір күресуден басқа амал жоқ! (Тоя) А...
Dialogue: 0,0:04:27.58,0:04:29.95,Default,,0,0,0,,Ах... ≫ Жасай бер!
Dialogue: 0,0:04:29.95,0:04:32.05,Default,,0,0,0,,≫ (Ауыл тұрғыны) О! ≫(Ауыл тұрғыны) Жасай берейік!
Dialogue: 0,0:04:33.79,0:04:35.82,Default,,0,0,0,,Әже…→
Dialogue: 0,0:04:35.82,0:04:39.12,Default,,0,0,0,,Әженің сүйікті ауылы қиыншылықта.
Dialogue: 0,0:04:40.51,0:04:43.45,Default,,0,0,0,,Кланыңыздың мақтанышы үшін күресіңіз!
Dialogue: 0,0:04:43.45,0:04:47.28,Default,,0,0,0,,Отбасының игілігі үшін! (Барлығы) О!
Dialogue: 0,0:04:47.28,0:04:58.40,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:58.40,0:05:01.40,Default,,0,0,0,,Біз не істейміз? Барлығы өледі.
Dialogue: 0,0:05:03.07,0:05:06.49,Default,,0,0,0,,Маған күшіңді бер, Аладдин.
Dialogue: 0,0:05:06.49,0:05:08.96,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:05:08.96,0:05:13.14,Default,,0,0,0,,Енді сізде толық билік бар. →
Dialogue: 0,0:05:13.14,0:05:17.00,Default,,0,0,0,,Алайда оны сонша арандатқанымен, бірде-бір жауынгерді өлтірген жоқ.→
Dialogue: 0,0:05:17.00,0:05:20.17,Default,,0,0,0,,Бұл керемет ебедейсіз. Сізге рахмет, міне →
Dialogue: 0,0:05:20.17,0:05:23.47,Default,,0,0,0,,Енді қолдарыңды ластау керек. (Розаи) Хмф. →
Dialogue: 0,0:05:23.47,0:05:27.31,Default,,0,0,0,,Бірақ сонда біздің ханшайым пайда болса→
Dialogue: 0,0:05:27.31,0:05:31.28,Default,,0,0,0,,Не болады? (Солдат)... Не айтып тұрсың?
Dialogue: 0,0:05:31.28,0:05:34.18,Default,,0,0,0,,Мен уайымдап тұрмын.
Dialogue: 0,0:05:34.18,0:05:37.87,Default,,0,0,0,,Ханшайымға ашулы шетелдік нәсіл шабуыл жасады →
Dialogue: 0,0:05:37.87,0:05:42.14,Default,,0,0,0,,Мен оларды кез келген кездейсоқ басып ала ма деп қорқамын.
Dialogue: 0,0:05:42.14,0:05:44.17,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:44.17,0:05:46.96,Default,,0,0,0,,Ал... Ол үшін бәрін істедің бе?
Dialogue: 0,0:05:46.96,0:05:49.16,Default,,0,0,0,,Неліктен жер бетінде...? (Розаи) Неге?
Dialogue: 0,0:05:50.53,0:05:52.58,Default,,0,0,0,,Өйткені маған ұнайды. →
Dialogue: 0,0:05:52.58,0:05:56.47,Default,,0,0,0,,Соғысты жек көремін дейтін сол ақымақтар→
Dialogue: 0,0:05:56.47,0:06:01.64,Default,,0,0,0,,Ашуланып, олардың шынайы болмысын әшкерелеп, бірін-бірі өлтірді →
Dialogue: 0,0:06:01.64,0:06:03.64,Default,,0,0,0,,Соғыс.
Dialogue: 0,0:06:05.45,0:06:08.23,Default,,0,0,0,,Сары азу руы соғыс ашқысы келеді→
Dialogue: 0,0:06:08.23,0:06:10.55,Default,,0,0,0,,Мен олай ойламаймын. (Сейшун) Неге?
Dialogue: 0,0:06:10.55,0:06:14.62,Default,,0,0,0,,Өйткені мен кеше түнде бір жұмбақ баладан әңгіме естідім.
Dialogue: 0,0:06:14.62,0:06:19.09,Default,,0,0,0,,((Бұл менің отбасым туралы үйреткен мен жақсы көретін адамдар))
Dialogue: 0,0:06:19.09,0:06:21.75,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:06:21.75,0:06:24.73,Default,,0,0,0,,Мына бала лабиринтті бағындырушы ма?
Dialogue: 0,0:06:24.73,0:06:29.24,Default,,0,0,0,,Мен білмеймін. Бірақ мен оның сөздеріне сенетіндей болдым.
Dialogue: 0,0:06:29.24,0:06:32.54,Default,,0,0,0,,Мүмкін оның ханшайыммен сөйлесетін бірдеңесі бар шығар→
Dialogue: 0,0:06:32.54,0:06:34.58,Default,,0,0,0,,Дәл сол жаулаушы ретінде.
Dialogue: 0,0:06:34.58,0:06:37.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:37.58,0:06:39.75,Default,,0,0,0,,Әйтеуір, сөйлесейік.
Dialogue: 0,0:06:39.75,0:06:43.40,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:43.40,0:06:45.50,Default,,0,0,0,,Хехин! (Аттың дыбысы) Уф... Ой!
Dialogue: 0,0:06:46.94,0:06:48.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:48.97,0:06:54.14,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:54.14,0:06:56.18,Default,,0,0,0,,Ханшайым.
Dialogue: 0,0:06:56.18,0:06:59.72,Default,,0,0,0,,Жарайсың Баба! (Хакуэй) Тынышталыңыз. →
Dialogue: 0,0:06:59.72,0:07:03.69,Default,,0,0,0,,Біз келіссөздер жүргізуге келдік. Өзіңізді мазақ етпеңіз! →
Dialogue: 0,0:07:03.69,0:07:06.62,Default,,0,0,0,,Сіз енді алданбайсыз! Ханшайым!
Dialogue: 0,0:07:06.62,0:07:08.62,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:07:13.25,0:07:15.38,Default,,0,0,0,,Неліктен одан құтыла алмайсың?
Dialogue: 0,0:07:15.38,0:07:18.20,Default,,0,0,0,,Біздің күресуге ерік-жігеріміз жоқ.
Dialogue: 0,0:07:18.20,0:07:22.22,Default,,0,0,0,,Шындықты білу үшін келіссөз үстеліне келіңіз.
Dialogue: 0,0:07:22.22,0:07:24.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:29.16,0:07:31.20,Default,,0,0,0,,≪(Ауылдық) Алданба! →
Dialogue: 0,0:07:31.20,0:07:35.27,Default,,0,0,0,,Кешегі қозғалыс. Жаса! Бұл дұрыс!
Dialogue: 0,0:07:35.27,0:07:37.59,Default,,0,0,0,,Тоқтаңдар, ақымақтар!
Dialogue: 0,0:07:37.59,0:07:39.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:41.91,0:07:43.94,Default,,0,0,0,,Баба!
Dialogue: 0,0:07:43.94,0:07:48.53,Default,,0,0,0,,Өкінішті болмаңыз. Сонда да Сары азу жауынгер! →
Dialogue: 0,0:07:48.53,0:07:52.95,Default,,0,0,0,,Сізге шынымен нені қорғау керек екенін қате бағаламаңыз.
Dialogue: 0,0:07:52.95,0:07:56.76,Default,,0,0,0,,Ол үшін қандай күрес әдісін қолдануымыз керек!
Dialogue: 0,0:07:56.76,0:07:58.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:00.99,0:08:10.29,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:10.29,0:08:15.39,Default,,0,0,0,,Менің отбасым Коу империясының қолшатырының астында қалады.
Dialogue: 0,0:08:15.39,0:08:18.18,Default,,0,0,0,,Баба! Сол жігіттерге түссеңіз→
Dialogue: 0,0:08:18.18,0:08:20.25,Default,,0,0,0,,Бәрімізді қырып тастаймыз!
Dialogue: 0,0:08:20.25,0:08:24.33,Default,,0,0,0,,Көріп тұрғаныңыздай, ханшайым. →
Dialogue: 0,0:08:24.33,0:08:28.77,Default,,0,0,0,,Менің отбасым ұзақ уақыт шапқыншылық пен құл аулаудан зардап шекті→
Dialogue: 0,0:08:28.77,0:08:32.98,Default,,0,0,0,,Мен физикалық және психикалық жағынан толығымен зардап шектім. →
Dialogue: 0,0:08:32.98,0:08:38.20,Default,,0,0,0,,Мен бұдан былай отбасымның зардап шегуіне жол бере алмаймын. →
Dialogue: 0,0:08:38.20,0:08:43.42,Default,,0,0,0,,Бір кездері мен тіпті патшалыққа қарсы күресуге дайын болдым, бірақ→
Dialogue: 0,0:08:43.42,0:08:48.39,Default,,0,0,0,,Бірақ бір бала маған: →
Dialogue: 0,0:08:48.39,0:08:53.43,Default,,0,0,0,,Жау елдің қолбасшысы ретінде сен сенетін адам болуың керек.
Dialogue: 0,0:08:53.43,0:08:57.70,Default,,0,0,0,,♪♪~
Dialogue: 0,0:08:57.70,0:09:01.05,Default,,0,0,0,,Дегенмен, жара ерекше. →
Dialogue: 0,0:09:01.05,0:09:04.17,Default,,0,0,0,,Күткендей, бұл біздің әскерден келген жебе...
Dialogue: 0,0:09:04.17,0:09:07.63,Default,,0,0,0,,Бір ауыл бастығының және барлық ауыл тұрғындарының өмірі→
Dialogue: 0,0:09:07.63,0:09:10.68,Default,,0,0,0,,Қайсысы маңыздырақ екенін білесіз.
Dialogue: 0,0:09:10.68,0:09:17.07,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:17.07,0:09:21.27,Default,,0,0,0,,Сіздің өсиетіңіз міндетті түрде мұраға қалды. →
Dialogue: 0,0:09:21.27,0:09:26.20,Default,,0,0,0,,Бұдан былай Сары азу әулеті Коу империясы және Хакуэй атымен жүр→
Dialogue: 0,0:09:26.20,0:09:28.20,Default,,0,0,0,,Қауіпсіздікке кепілдік беру.
Dialogue: 0,0:09:30.18,0:09:33.25,Default,,0,0,0,,Сіз басқа елге барасыз ба?
Dialogue: 0,0:09:33.25,0:09:35.92,Default,,0,0,0,,Бұл маңызды емес. →
Dialogue: 0,0:09:35.92,0:09:38.68,Default,,0,0,0,,Тек мақтаншақ жүрегіңді сақта →
Dialogue: 0,0:09:38.68,0:09:40.68,Default,,0,0,0,,Баба сияқты!
Dialogue: 0,0:09:42.76,0:09:45.70,Default,,0,0,0,,Не дейсің, Сары азу жұрт! →
Dialogue: 0,0:09:45.70,0:09:48.60,Default,,0,0,0,,Өз еркіңді көрсет!
Dialogue: 0,0:09:48.60,0:09:55.24,Default,,0,0,0,,♪♪~
Dialogue: 0,0:09:55.24,0:09:57.58,Default,,0,0,0,,>
Dialogue: 0,0:09:57.58,0:10:00.46,Default,,0,0,0,,≪Әркім болашақ үшін не істеуі керек?→
Dialogue: 0,0:10:00.46,0:10:02.46,Default,,0,0,0,,Таңдауға батылдық танытыңыз≫
Dialogue: 0,0:10:03.93,0:10:07.33,Default,,0,0,0,,≪Бізде ештеңе істеу керек емес еді≫
Dialogue: 0,0:10:13.84,0:10:16.06,Default,,0,0,0,,Баба, берік бол!
Dialogue: 0,0:10:16.06,0:10:18.66,Default,,0,0,0,,Әже! Баба!
Dialogue: 0,0:10:20.08,0:10:23.57,Default,,0,0,0,,≪Не болды? Аладдин. Ах!
Dialogue: 0,0:10:23.57,0:10:27.07,Default,,0,0,0,,Артымда осылай жалғыз қалған соң.
Dialogue: 0,0:10:28.61,0:10:32.26,Default,,0,0,0,,Әже, сіз өлдіңіз.
Dialogue: 0,0:10:32.26,0:10:34.90,Default,,0,0,0,,Барлығы жылап жатыр. Әже туралы →
Dialogue: 0,0:10:34.90,0:10:38.39,Default,,0,0,0,,Сізге ұнады. Хохохохо. →
Dialogue: 0,0:10:38.39,0:10:41.02,Default,,0,0,0,,Оны нақыл сияқты айтады. →
Dialogue: 0,0:10:41.02,0:10:43.97,Default,,0,0,0,,Аладдин ше?
Dialogue: 0,0:10:43.97,0:10:47.41,Default,,0,0,0,,Мен де әжемді жақсы көремін.
Dialogue: 0,0:10:47.41,0:10:51.77,Default,,0,0,0,,Бірақ басқаларға қарағанда менің естеліктерім аз.
Dialogue: 0,0:10:51.77,0:10:55.97,Default,,0,0,0,,Аладдин. Раббым, егер сен жалғыз болсаң →
Dialogue: 0,0:10:55.97,0:10:59.16,Default,,0,0,0,,Сіз солай ойлайсыз, солай ма? иә?
Dialogue: 0,0:10:59.16,0:11:02.51,Default,,0,0,0,,Бұл дұрыс емес. Ах...
Dialogue: 0,0:11:02.51,0:11:06.05,Default,,0,0,0,,Енді менде бұл пішін бар, мен ақырында → болдым
Dialogue: 0,0:11:06.05,0:11:09.47,Default,,0,0,0,,Енді сіз кім екеніңізді білесіз. →
Dialogue: 0,0:11:09.47,0:11:12.35,Default,,0,0,0,,Мынаны қараңыз. иә?
Dialogue: 0,0:11:12.35,0:11:15.47,Default,,0,0,0,,Қарғыс атсын... Ах! Ах!
Dialogue: 0,0:11:15.47,0:11:18.53,Default,,0,0,0,,Әрбір тіршілік иесі – жеке тұлға→
Dialogue: 0,0:11:18.53,0:11:20.93,Default,,0,0,0,,Бірақ қайнар көзі →
Dialogue: 0,0:11:20.93,0:11:24.50,Default,,0,0,0,,Барлығы бір жерге жиналды. →
Dialogue: 0,0:11:24.50,0:11:28.32,Default,,0,0,0,,Барлық жанды байланыстыратын дүниенің қаны→
Dialogue: 0,0:11:28.32,0:11:32.81,Default,,0,0,0,,Бұл Рафф. Және сол Руфты жақсы көретін→
Dialogue: 0,0:11:32.81,0:11:36.31,Default,,0,0,0,,Мен сенің күшіңді кімнен аламын?→
Dialogue: 0,0:11:37.76,0:11:42.72,Default,,0,0,0,,Сіз сиқыршысыз. Миллиардтаған тіршілік иелерімен өмір сүру→
Dialogue: 0,0:11:42.72,0:11:46.62,Default,,0,0,0,,Оларға бағыт-бағдар беріп, дүниені жаратушы.
Dialogue: 0,0:11:48.71,0:11:53.66,Default,,0,0,0,,Демек, сіз жалғыз емессіз.
Dialogue: 0,0:11:53.66,0:11:55.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:55.70,0:12:00.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:00.30,0:12:04.49,Default,,0,0,0,,Ах... Сүйікті Сүлейменнің ұлы
Dialogue: 0,0:12:04.49,0:12:07.49,Default,,0,0,0,,Мен әрқашан сенің жаныңда боламын.
Dialogue: 0,0:12:09.59,0:12:12.99,Default,,0,0,0,,Дыбыстық сигнал дыбыстық сигнал... (Руфтың дауысы)
Dialogue: 0,0:12:21.89,0:12:25.38,Default,,0,0,0,,Бұдан былай біз бұл жердегі тыныштықты қорғауымыз керек.
Dialogue: 0,0:12:25.38,0:12:28.14,Default,,0,0,0,,Иә. Ал қайтып келгенде →
Dialogue: 0,0:12:28.14,0:12:30.44,Default,,0,0,0,,Қамқорлық қажет нәрселер бар.
Dialogue: 0,0:12:32.03,0:12:40.62,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:40.62,0:12:44.69,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз!? (Розаи) Бұл не? Бұл соғыс.
Dialogue: 0,0:12:44.69,0:12:46.75,Default,,0,0,0,,Сарбаздарыңызды шегіндіріңіздер! →
Dialogue: 0,0:12:46.75,0:12:50.52,Default,,0,0,0,,Сары азу ауылы келіссөздер арқылы біздің бақылауымызға алынды!
Dialogue: 0,0:12:50.52,0:12:54.49,Default,,0,0,0,,Хмф! Бұл көңілсіз күйзеліс болды. →
Dialogue: 0,0:12:54.49,0:12:57.84,Default,,0,0,0,,Құл ретінде аңға түсіп, қараңғыда өлтірілгеніне қарамастан→
Dialogue: 0,0:12:57.84,0:13:01.44,Default,,0,0,0,,Мен оның келіссөзді қабылдағанына сене алар емеспін.
Dialogue: 0,0:13:01.44,0:13:03.78,Default,,0,0,0,,Бұл сен едің ғой, Рёсай.
Dialogue: 0,0:13:03.78,0:13:08.82,Default,,0,0,0,,Дұрыс. Дегенмен, менің сценарийім келесідей болды.
Dialogue: 0,0:13:08.82,0:13:13.44,Default,,0,0,0,,Басқа нәсілдің ауылында ханшайым қайғылы түрде өлтірілді.
Dialogue: 0,0:13:13.44,0:13:16.08,Default,,0,0,0,,Қалған Риосай ханшайымнан кек алады →
Dialogue: 0,0:13:16.08,0:13:19.68,Default,,0,0,0,,Мен бүкіл әскерімді басқарып, ауылды қиратамын.
Dialogue: 0,0:13:19.68,0:13:23.70,Default,,0,0,0,,Жақсы, мен білмеймін. Сеннинчо сен сияқты →
Dialogue: 0,0:13:23.70,0:13:25.92,Default,,0,0,0,,Бүкіл әскердің қолбасшылығы? Қарғыс атсын!
Dialogue: 0,0:13:25.92,0:13:29.46,Default,,0,0,0,,Неліктен мен мұндай орынсыз нәрсе ойладым?
Dialogue: 0,0:13:29.46,0:13:34.08,Default,,0,0,0,,Сен келмегенде, мен таңдап алар едім.→
Dialogue: 0,0:13:34.08,0:13:36.43,Default,,0,0,0,,Осы бөлімшенің командирі бол! →
Dialogue: 0,0:13:36.43,0:13:39.18,Default,,0,0,0,,Бұл жігіттер менің тікелей есептерім. →
Dialogue: 0,0:13:39.18,0:13:42.30,Default,,0,0,0,,Уайымдама, бля, қаншық!
Dialogue: 0,0:13:42.30,0:13:45.37,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:45.37,0:13:47.41,Default,,0,0,0,,Хмф!
Dialogue: 0,0:13:47.41,0:13:50.71,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:52.98,0:13:55.98,Default,,0,0,0,,♪♪~
Dialogue: 0,0:13:55.98,0:13:58.03,Default,,0,0,0,,Күмәнді әдістер... →
Dialogue: 0,0:13:58.03,0:14:01.27,Default,,0,0,0,,Лабиринтті жаулап алушы. Түсіріңіз!
Dialogue: 0,0:14:01.27,0:14:04.06,Default,,0,0,0,,Уау! Қарғыс атсын!
Dialogue: 0,0:14:04.06,0:14:06.09,Default,,0,0,0,,Бағынышты қару Егіз ай семсер!
Dialogue: 0,0:14:06.09,0:14:08.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:08.41,0:14:11.35,Default,,0,0,0,,Сізге қалай ұнайды? Уақытты сатып алыңыз.
Dialogue: 0,0:14:11.35,0:14:14.77,Default,,0,0,0,,Осы күш деңгейімен мен оларды қалған сиқырлы күшіммен жеңе аламын.
Dialogue: 0,0:14:14.77,0:14:16.77,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:14:18.42,0:14:22.93,Default,,0,0,0,,Тар махаббат пен хаос рухы, мен саған бұйырамын. →
Dialogue: 0,0:14:22.93,0:14:24.98,Default,,0,0,0,,Өзіңізді жабыңыз →
Dialogue: 0,0:14:24.98,0:14:29.57,Default,,0,0,0,,Менде қал, мені үлкен жынға айналдыр.
Dialogue: 0,0:14:29.57,0:14:31.60,Default,,0,0,0,,Паймон!
Dialogue: 0,0:14:31.60,0:14:35.96,Default,,0,0,0,,♪♪~
Dialogue: 0,0:14:35.96,0:14:38.22,Default,,0,0,0,,Риосай көтерілісі. →
Dialogue: 0,0:14:38.22,0:14:40.58,Default,,0,0,0,,Коу империясының бірінші ханшайымы→
Dialogue: 0,0:14:40.58,0:14:44.23,Default,,0,0,0,,Рен Хакуэйге үкім шығарылады.
Dialogue: 0,0:14:44.23,0:14:46.23,Default,,0,0,0,,Өзіңізді дайындаңыз!
Dialogue: 0,0:14:52.94,0:14:56.74,Default,,0,0,0,,Қайырлы түн Баба. →
Dialogue: 0,0:14:56.74,0:14:59.04,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:15:00.68,0:15:05.50,Default,,0,0,0,,Уго-кун, мен осы ауылға келгеніме қуаныштымын.
Dialogue: 0,0:15:05.50,0:15:08.05,Default,,0,0,0,,Ақыры өзімді түсіндім...→
Dialogue: 0,0:15:08.05,0:15:10.05,Default,,0,0,0,,Мен осылай сезінемін.
Dialogue: 0,0:15:11.36,0:15:14.56,Default,,0,0,0,,Дәл сол кезде айтқаныңыздай.
Dialogue: 0,0:15:17.90,0:15:21.43,Default,,0,0,0,,Дыбыстық сигнал сигналдық сигнал...
Dialogue: 0,0:15:21.43,0:15:23.47,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:23.47,0:15:25.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:25.52,0:15:28.69,Default,,0,0,0,,Осы қарқынмен біз жойыламыз! (Рёсай) Жебені ат!
Dialogue: 0,0:15:28.69,0:15:31.51,Default,,0,0,0,,Одақтасты ұрады. Уайымдамаңыз →
Dialogue: 0,0:15:31.51,0:15:34.93,Default,,0,0,0,,Мүмкіндік жоқ. Жебені ат!
Dialogue: 0,0:15:34.93,0:15:45.89,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:45.89,0:15:50.55,Default,,0,0,0,,Күрсіну…. Осылай қалса, оның сиқырлы күші болмайды. Көк Шун!
Dialogue: 0,0:15:50.55,0:15:52.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:52.58,0:15:54.62,Default,,0,0,0,,Бірден құтылыңыз.
Dialogue: 0,0:15:54.62,0:15:58.40,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:58.40,0:16:00.40,Default,,0,0,0,,«Магл Аль Хазард»!
Dialogue: 0,0:16:02.84,0:16:04.88,Default,,0,0,0,,Уф... уау!
Dialogue: 0,0:16:04.88,0:16:15.62,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:15.62,0:16:18.53,Default,,0,0,0,,Ханшайым. Rusai... →
Dialogue: 0,0:16:18.53,0:16:22.23,Default,,0,0,0,,Жаулардың саны азайды. Риосайды басып алыңыз.
Dialogue: 0,0:16:22.23,0:16:25.35,Default,,0,0,0,,Қандай санды азайттыңыз?
Dialogue: 0,0:16:25.35,0:16:33.84,Default,,0,0,0,,♪♪~
Dialogue: 0,0:16:33.84,0:16:35.88,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:35.88,0:16:38.48,Default,,0,0,0,,Металл ыдыста сақталған сиқырлы қуатты пайдалансаңыз →
Dialogue: 0,0:16:38.48,0:16:42.63,Default,,0,0,0,,Бұл жәрдемақыны алатын асырауындағылар ештеңе істей алмайды. →
Dialogue: 0,0:16:42.63,0:16:46.29,Default,,0,0,0,,Сіз дәрменсізсіз, Жеңіп алушы.
Dialogue: 0,0:16:46.29,0:16:48.69,Default,,0,0,0,,Қарғыс атсын! (Рёсай) Уайымдама, ханшайым. →
Dialogue: 0,0:16:48.69,0:16:53.01,Default,,0,0,0,,Мен сені бірден өлтіремін. сенің асыл інің →
Dialogue: 0,0:16:53.01,0:16:55.41,Default,,0,0,0,,Рен Хакурю да. Арх!
Dialogue: 0,0:16:55.41,0:16:57.45,Default,,0,0,0,,Құрметті сіздерге!!
Dialogue: 0,0:16:57.45,0:16:59.55,Default,,0,0,0,,Гакин!
Dialogue: 0,0:16:59.55,0:17:03.99,Default,,0,0,0,,Жарайды. Мен де жауынгермін... Генерал болуға қайсысы қолайлы?
Dialogue: 0,0:17:03.99,0:17:05.99,Default,,0,0,0,,Пышақпен шешейік.
Dialogue: 0,0:17:05.99,0:17:08.12,Default,,0,0,0,,«Супер Айджа».
Dialogue: 0,0:17:08.12,0:17:10.16,Default,,0,0,0,,≪Егер бұл жеке жекпе-жек болса, жеңіске жету мүмкіндігі бар≫
Dialogue: 0,0:17:10.16,0:17:12.16,Default,,0,0,0,,Thud! (Хакуэй) Арх!
Dialogue: 0,0:17:17.22,0:17:21.30,Default,,0,0,0,,Хахахаха! Оған сенген ақымақ әйел! →
Dialogue: 0,0:17:21.30,0:17:23.91,Default,,0,0,0,,Сіз шұбарсыз!
Dialogue: 0,0:17:23.91,0:17:25.91,Default,,0,0,0,,≪Барлығы...≫
Dialogue: 0,0:19:27.95,0:19:29.98,Default,,0,0,0,,Бұл не, Бірінші ханшайым? →
Dialogue: 0,0:19:29.98,0:19:32.02,Default,,0,0,0,,Сен сондай болмашы жансың!
Dialogue: 0,0:19:32.02,0:19:34.07,Default,,0,0,0,,Дыбыстық сигнал сигналдық сигнал...
Dialogue: 0,0:19:34.07,0:19:36.59,Default,,0,0,0,,«Қүйген егіз алақан»!
Dialogue: 0,0:19:36.59,0:19:38.89,Default,,0,0,0,,Бум!
Dialogue: 0,0:19:43.85,0:19:53.86,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:53.86,0:19:55.91,Default,,0,0,0,,Уау….
Dialogue: 0,0:19:55.91,0:20:19.02,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:19.02,0:20:22.62,Default,,0,0,0,,Бала... сен...
Dialogue: 0,0:20:24.37,0:20:27.94,Default,,0,0,0,,Мен бе? мен...
Dialogue: 0,0:20:27.94,0:20:31.51,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:20:31.51,0:20:35.26,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:35.26,0:20:37.32,Default,,0,0,0,,Маги.
Dialogue: 0,0:20:37.32,0:20:40.25,Default,,0,0,0,,Маги…. →
Dialogue: 0,0:20:40.25,0:20:42.29,Default,,0,0,0,,Желдеткіш...
Dialogue: 0,0:20:42.29,0:20:45.48,Default,,0,0,0,,Әпке, маған қол тигізуге рұқсат ете аласыз ба?
Dialogue: 0,0:20:45.48,0:20:48.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:53.52,0:21:01.49,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:01.49,0:21:06.05,Default,,0,0,0,,Өзіңізді қалай сезінесіз? барлығы. Мен Пэймонмын.
Dialogue: 0,0:21:06.05,0:21:10.25,Default,,0,0,0,,Тар махаббат пен бейберекетсіздіктен, Сүлеймен жаратқан жын.
Dialogue: 0,0:21:10.25,0:21:13.92,Default,,0,0,0,,Қожайыны - патшайым Рен Хакуэй. →
Dialogue: 0,0:21:13.92,0:21:17.27,Default,,0,0,0,,Солай болса да, мені заттандыруға жеткілікті сиқырлы күш →
Dialogue: 0,0:21:17.27,0:21:19.34,Default,,0,0,0,,Қайдан? →
Dialogue: 0,0:21:19.34,0:21:22.20,Default,,0,0,0,,Жоқ, бұл Маги емес. Ах.
Dialogue: 0,0:21:22.20,0:21:26.28,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:26.28,0:21:30.69,Default,,0,0,0,,О, менің! Мен сирек кездесетін адамды кездестірдім. Хмм!
Dialogue: 0,0:21:30.69,0:21:34.37,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:34.37,0:21:38.24,Default,,0,0,0,,≪Қайтадан. Сіз не туралы айтып отырсыз? ≫
Dialogue: 0,0:21:38.24,0:21:42.00,Default,,0,0,0,,Мен көрдім. Мен жағдайды түсінемін. →
Dialogue: 0,0:21:42.00,0:21:44.70,Default,,0,0,0,,Дүниеде біртүрлі нәрсе болып жатқан сияқты. →
Dialogue: 0,0:21:44.70,0:21:47.60,Default,,0,0,0,,Бірақ бұл маңызды емес.
Dialogue: 0,0:21:47.60,0:21:51.21,Default,,0,0,0,,Мен Хакуэй-чанмын, оған патшаның сауыты болып ғашық болдым→
Dialogue: 0,0:21:51.21,0:21:55.83,Default,,0,0,0,,Тек күшіңді бер. Мен сол үшін жаратылғанмын.
Dialogue: 0,0:21:55.83,0:21:58.71,Default,,0,0,0,,Патша ыдысы? Бұл дұрыс. →
Dialogue: 0,0:21:58.71,0:22:01.32,Default,,0,0,0,,Тіпті Хакуэй-чанның өзі корольге кандидат→
Dialogue: 0,0:22:01.32,0:22:05.10,Default,,0,0,0,,Себебі мен Коу империясының магиясы болып сайландым. иә?
Dialogue: 0,0:22:05.10,0:22:09.13,Default,,0,0,0,,Ғибадатхана. Мен оны қайда қоюым керек? Ғибадатхана залы. →
Dialogue: 0,0:22:09.13,0:22:11.13,Default,,0,0,0,,Жоқ, Маги. →
Dialogue: 0,0:22:12.70,0:22:14.70,Default,,0,0,0,,Онда. →
Dialogue: 0,0:22:14.70,0:22:16.92,Default,,0,0,0,,Мәртебелі Императормен кездесуді жіберіп алмаңыз. →
Dialogue: 0,0:22:16.92,0:22:19.42,Default,,0,0,0,,Сіз ашуланасыз.
Dialogue: 0,0:22:19.42,0:22:21.75,Default,,0,0,0,,≪(Хакурю) Ха! Ха! Өйткені мен, әлгі шошқа бейбақ →
Dialogue: 0,0:22:21.75,0:22:25.63,Default,,0,0,0,,Маған бәрібір. Ақ айдаһар!
Dialogue: 0,0:22:25.63,0:22:27.69,Default,,0,0,0,,Бұл не үшін? Ғибадатхана залы.
Dialogue: 0,0:22:27.69,0:22:30.00,Default,,0,0,0,,Сізге тек император болу керек. →
Dialogue: 0,0:22:30.00,0:22:32.62,Default,,0,0,0,,Біраз қуат алыңыз.
Dialogue: 0,0:22:32.62,0:22:35.37,Default,,0,0,0,,Сіз лабиринтті бағындырыңыз →
Dialogue: 0,0:22:35.37,0:22:38.17,Default,,0,0,0,,Үлкен апаң Рен Хакуэйге қара.
Dialogue: 0,0:22:39.51,0:22:43.41,Default,,0,0,0,,Діни қызметкер мені лабиринтке шақырды.
Dialogue: 0,0:22:44.86,0:22:48.45,Default,,0,0,0,,Менен басқа сиқыршылар бар. Бұл дұрыс. →
Dialogue: 0,0:22:48.45,0:22:51.15,Default,,0,0,0,,Патша таңдау - сиқыршылардың міндеті. →
Dialogue: 0,0:22:51.15,0:22:54.54,Default,,0,0,0,,Сіз бұрын ешқашан патша таңдаған жоқсыз ба? →
Dialogue: 0,0:22:54.54,0:22:58.86,Default,,0,0,0,,Лабиринтте Хакуэй-чанмен келісім-шарт жасасқаным сияқты.
Dialogue: 0,0:22:58.86,0:23:00.86,Default,,0,0,0,,Ах.
Dialogue: 0,0:23:11.50,0:23:13.92,Default,,0,0,0,,Осыны қалайтыныңызға сенімдісіз бе?
Dialogue: 0,0:23:13.92,0:23:17.53,Default,,0,0,0,,Жарайды. Баба да қуанатынына сенімдімін.
Dialogue: 0,0:23:17.53,0:23:21.58,Default,,0,0,0,,Иә. Қару-жарақтарыңызды да әкеліңіз.
Dialogue: 0,0:23:21.58,0:23:24.58,Default,,0,0,0,,Ба-ка. Аладдинге керегі жоқ.
Dialogue: 0,0:23:26.24,0:23:30.34,Default,,0,0,0,,Ах! Қарт, сен Гортастың кім екенін білесің бе?
Dialogue: 0,0:23:33.11,0:23:36.16,Default,,0,0,0,,Осындай нәрсе болды ма? →
Dialogue: 0,0:23:36.16,0:23:38.83,Default,,0,0,0,,«Голтас» - Сары азудың жалпы атауы. →
Dialogue: 0,0:23:38.83,0:23:42.13,Default,,0,0,0,,Олардың да біздің отбасымыз екеніне сенімдімін. →
Dialogue: 0,0:23:42.13,0:23:44.74,Default,,0,0,0,,Мен сенің рухыңды еске алу кешін өткіземін.
Dialogue: 0,0:23:44.74,0:23:47.74,Default,,0,0,0,,Түсіндім... Кездейсоқ болса да →
Dialogue: 0,0:23:47.74,0:23:50.11,Default,,0,0,0,,Менің соңғы сәттерімді бақылағаныңыз үшін рахмет.
Dialogue: 0,0:23:50.11,0:23:52.43,Default,,0,0,0,,Жоқ, бұл кездейсоқтық емес.
Dialogue: 0,0:23:52.43,0:23:54.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:55.97,0:23:58.82,Default,,0,0,0,,((Менің ойымша, сіздің сыртқа шығатын уақыт келді))
Dialogue: 0,0:23:58.82,0:24:01.95,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:01.95,0:24:05.26,Default,,0,0,0,,((Аладдин, есіңде ме?→
Dialogue: 0,0:24:05.26,0:24:09.43,Default,,0,0,0,,Мен кім екенімді білмей жылап жібердім))
Dialogue: 0,0:24:09.43,0:24:13.18,Default,,0,0,0,,((Егер қалағаныңызша саяхаттасаңыз, оны міндетті түрде табасыз→
Dialogue: 0,0:24:13.18,0:24:15.18,Default,,0,0,0,,Сіздің туған күніңіздің мәні. →
Dialogue: 0,0:24:16.60,0:24:20.40,Default,,0,0,0,,Көптеген адамдармен танысып, өзіңізді ашыңыз. →
Dialogue: 0,0:24:22.09,0:24:25.49,Default,,0,0,0,,Себебі сізді осылай бағыттайсыз))
Dialogue: 0,0:24:27.08,0:24:32.42,Default,,0,0,0,,≪Дәл сен айтқандай, Уго-кун≫
Dialogue: 0,0:24:32.42,0:24:34.52,Default,,0,0,0,,Кеттік! →
Dialogue: 0,0:24:34.52,0:24:37.52,Default,,0,0,0,,≪Ағайындылардың жолдары бөлініп кетті ме?
Dialogue: 0,0:24:37.52,0:24:40.58,Default,,0,0,0,,Аладдин Жақында кездескенше. (Тоя) Сау болыңыз.
Dialogue: 0,0:24:40.58,0:24:44.15,Default,,0,0,0,,Қайта кездескенше, Сары азу! аа!
Dialogue: 0,0:24:44.15,0:24:51.80,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:51.80,0:24:56.56,Default,,0,0,0,,≪Сол лабиринтте болған оқиға патшаны таңдау≫
Dialogue: 0,0:24:56.56,0:24:59.11,Default,,0,0,0,,≪Сізбен кездескенде не өзгереді→
Dialogue: 0,0:24:59.11,0:25:01.13,Default,,0,0,0,,Мен әлі білмеймін...≫
Dialogue: 0,0:25:01.13,0:25:06.69,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:06.69,0:25:10.09,Default,,0,0,0,,≪Алибаба-кун, мен сені көремін≫
Dialogue: 0,0:25:13.99,0:26:08.24,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:12.65,0:26:18.95,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:23.36,0:26:40.66,Default,,0,0,0,,♪♪~
Dialogue: 0,0:28:14.97,0:28:17.11,Default,,0,0,0,,Қолдануға жарамсыз құлдар – шөлдегі гиеналарға жем!
Dialogue: 0,0:28:17.11,0:28:20.11,Default,,0,0,0,,Жарайды. Мен сенің құл болуға жол бермеймін.
Dialogue: 0,0:28:23.62,0:28:27.42,Default,,0,0,0,,Морджиана керемет! Сонымен... менің кезегім қашан!?
Dialogue: 0,0:30:44.62,0:30:47.61,Default,,0,0,0,,Премьер-министр Нода АСЕМ-ге қатысады
Dialogue: 0,0:30:50.33,0:30:52.75,Default,,0,0,0,,Қабылдаушы ел Лаосқа кетті.
Dialogue: 0,0:30:53.80,0:30:56.90,Default,,0,0,0,,Сенкаку аралдары үшін жанжалдасып жатқан Қытаймен қарым-қатынасты жақсартуға қатысты,
Dialogue: 0,0:30:56.90,0:30:59.25,Default,,0,0,0,,Саммит отырысы кейінге қалдырылғанымен,
Dialogue: 0,0:31:00.75,0:31:05.75,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
