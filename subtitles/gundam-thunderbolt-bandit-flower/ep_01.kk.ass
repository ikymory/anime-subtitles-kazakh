Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.59,0:00:14.59,Default,,0,0,0,,Мен саған да беремін, Тору.
Dialogue: 0,0:00:20.02,0:00:22.27,Default,,0,0,0,,Өмір біртүрлі
Dialogue: 0,0:00:24.94,0:00:27.65,Default,,0,0,0,,Басқа жануарлар ше?
Dialogue: 0,0:00:30.19,0:00:31.40,Default,,0,0,0,,Құс –
Dialogue: 0,0:00:32.11,0:00:36.07,Default,,0,0,0,,Қанатымды лақтырып, теңізге сүңгім бе?
Dialogue: 0,0:00:38.83,0:00:41.95,Default,,0,0,0,,Тасбақалар қабықтарын лақтырып, ұшады ма?
Dialogue: 0,0:00:44.08,0:00:47.79,Default,,0,0,0,,Тауыстың әдемі өрнектері бар.
Dialogue: 0,0:00:48.46,0:00:50.67,Default,,0,0,0,,Жай жолақ па?
Dialogue: 0,0:00:54.34,0:00:56.68,Default,,0,0,0,,Бұл болмайды
Dialogue: 0,0:00:59.26,0:01:00.39,Default,,0,0,0,,Бірақ—
Dialogue: 0,0:01:00.97,0:01:02.64,Default,,0,0,0,,Адамдар әртүрлі
Dialogue: 0,0:01:05.27,0:01:07.23,Default,,0,0,0,,Инновация орын алады
Dialogue: 0,0:01:10.98,0:01:12.28,Default,,0,0,0,,(Косей) Тұрсаңдаршы—мектеп ше, сендер!? Бұл велосипед кімнің өзі!?
Dialogue: 0,0:01:13.65,0:01:15.20,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:01:15.65,0:01:19.74,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:01:22.49,0:01:26.37,Default,,0,0,0,,Гууууууу
Dialogue: 0,0:01:26.66,0:01:29.21,Default,,0,0,0,,Ууууууууу~
Dialogue: 0,0:01:30.59,0:01:31.71,Default,,0,0,0,,Ga!
Dialogue: 0,0:01:32.42,0:01:33.51,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:34.01,0:01:35.67,Default,,0,0,0,,Гү!
Dialogue: 0,0:01:40.26,0:01:42.18,Default,,0,0,0,,Ууууууууу
Dialogue: 0,0:01:46.48,0:01:48.60,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:51.73,0:01:53.44,Default,,0,0,0,,Немесе өл!
Dialogue: 0,0:01:55.78,0:01:57.24,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:01:57.70,0:01:59.16,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:02:06.12,0:02:08.62,Default,,0,0,0,,Жылдам краб!
Dialogue: 0,0:02:13.09,0:02:14.21,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:02:16.80,0:02:17.97,Default,,0,0,0,,Сегіз!
Dialogue: 0,0:02:38.86,0:02:40.99,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:02:43.53,0:02:45.20,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:02:48.12,0:02:49.41,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:02:54.75,0:02:56.46,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:03:03.26,0:03:06.89,Default,,0,0,0,,Жанып тұр ма? A Baoa Ku
Dialogue: 0,0:03:06.97,0:03:08.18,Default,,0,0,0,,- прапорщик Билли! -(Билли) Ха!
Dialogue: 0,0:03:08.27,0:03:10.10,Default,,0,0,0,,Жаудың десанты тоқтамайды!
Dialogue: 0,0:03:10.18,0:03:11.35,Default,,0,0,0,,Фланаган агенттігі де
Dialogue: 0,0:03:11.44,0:03:13.77,Default,,0,0,0,,Барлығы әлі сонда.
Dialogue: 0,0:03:13.86,0:03:15.94,Default,,0,0,0,,Бұл Баоа Ку!
Dialogue: 0,0:03:16.02,0:03:18.94,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:03:25.62,0:03:26.74,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:03:40.63,0:03:44.09,Default,,0,0,0,,Капитан Крид: SS үшін мобильді костюмдерді алып тастаңыз.
Dialogue: 0,0:03:44.18,0:03:46.35,Default,,0,0,0,,Жаудың басқа мобильді костюмдері расталмады.
Dialogue: 0,0:03:46.43,0:03:51.02,Default,,0,0,0,,Ақпаратқа сәйкес, алда жеткізу жолы бар. Операцияны жалғастыру үшін нұсқауларды сұраңыз.
Dialogue: 0,0:03:56.36,0:03:58.52,Default,,0,0,0,,Цк
Dialogue: 0,0:03:58.61,0:04:02.28,Default,,0,0,0,,Толық ақпарат алу үшін тек кабель арқылы хабарлаңыз. Бұл солай ма?
Dialogue: 0,0:04:03.49,0:04:06.12,Default,,0,0,0,,Кодты тексеру жақсы! Ату
Dialogue: 0,0:04:06.20,0:04:07.24,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:11.45,0:04:13.16,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:04:15.33,0:04:16.67,Default,,0,0,0,,Алдыңғы люк ашық
Dialogue: 0,0:04:16.75,0:04:17.79,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:04:21.88,0:04:23.34,Default,,0,0,0,,ЖЕТ!
Dialogue: 0,0:04:38.31,0:04:40.32,Default,,0,0,0,,Шайқас аяқталғанша —
Dialogue: 0,0:04:40.40,0:04:44.32,Default,,0,0,0,,Сіз тіпті жалпы жағдайды түсіне алмайсыз.
Dialogue: 0,0:04:44.40,0:04:46.78,Default,,0,0,0,,Федерация дайындаған арнайы күштер өте...
Dialogue: 0,0:04:46.86,0:04:48.53,Default,,0,0,0,,Өте жақсы емес пе?
Dialogue: 0,0:04:48.62,0:04:49.95,Default,,0,0,0,,Иә, офицер Моника.
Dialogue: 0,0:04:50.41,0:04:53.96,Default,,0,0,0,,Маған Заби әулетінің басшысы маңызды емес.
Dialogue: 0,0:04:54.04,0:04:57.46,Default,,0,0,0,,Алып тастауымыз керек тағы бір нәрсе бар.
Dialogue: 0,0:05:09.93,0:05:11.01,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:05:19.23,0:05:20.82,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:05:24.57,0:05:25.82,Default,,0,0,0,,Уф
Dialogue: 0,0:05:26.78,0:05:27.99,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:29.87,0:05:31.87,Default,,0,0,0,,(Марио) Ж… Жуық келме. Бұл тұзақ.
Dialogue: 0,0:05:31.95,0:05:32.99,Default,,0,0,0,,Уф
Dialogue: 0,0:05:35.08,0:05:36.37,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:05:38.21,0:05:39.67,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:05:42.05,0:05:44.96,Default,,0,0,0,,Даррил! Сенімен бәрі жақсы ма? Басқару тұтқасы басқаша
Dialogue: 0,0:05:45.05,0:05:46.42,Default,,0,0,0,,Оны асыра алмаңыз
Dialogue: 0,0:05:46.51,0:05:47.97,Default,,0,0,0,,А...ха
Dialogue: 0,0:05:50.05,0:05:52.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:55.81,0:05:58.52,Default,,0,0,0,,- (Корнелий) Ио! - (Федералдық сарбаздар) Иә
Dialogue: 0,0:05:58.60,0:06:01.73,Default,,0,0,0,,Корнелий Сізде ұлпалар бар ма?
Dialogue: 0,0:06:02.02,0:06:03.23,Default,,0,0,0,,Куш!
Dialogue: 0,0:06:09.86,0:06:12.20,Default,,0,0,0,,Нысана сәтті алынды
Dialogue: 0,0:06:12.66,0:06:15.29,Default,,0,0,0,,Федерация да Psycommu алды.
Dialogue: 0,0:07:47.09,0:07:50.09,Default,,0,0,0,,Биіктігі 1600 Ханшайым тас жолының қалдықтарын қадағалаңыз
Dialogue: 0,0:07:55.68,0:08:00.52,Default,,0,0,0,,Бұл Сидней. Мен оны тек теледидардан көрдім.
Dialogue: 0,0:08:00.60,0:08:03.06,Default,,0,0,0,,Көк таулар сияқты.
Dialogue: 0,0:08:03.14,0:08:06.19,Default,,0,0,0,,Тіпті бұл Федерацияның қарсы шабуылын тоқтату үшін жеткіліксіз болды.
Dialogue: 0,0:08:06.27,0:08:07.94,Default,,0,0,0,,Тіпті осындай жағдай орын алса да?
Dialogue: 0,0:08:08.40,0:08:10.07,Default,,0,0,0,,Князьдіктің тәуелсіздік соғысы әлі де жалғасуда
Dialogue: 0,0:08:10.15,0:08:14.45,Default,,0,0,0,,Бірақ жеңіліспен Зеон Республикаға айналады...
Dialogue: 0,0:08:15.20,0:08:16.49,Default,,0,0,0,,- Жау ұшағы! -Ха! ?
Dialogue: 0,0:08:20.58,0:08:23.37,Default,,0,0,0,,Федерацияның көлік ұшағы Сіз бұл туралы да білесіз бе?
Dialogue: 0,0:08:23.46,0:08:24.87,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:08:28.04,0:08:30.21,Default,,0,0,0,,Аспанда Зеон патрульдік ұшағы анықталды
Dialogue: 0,0:08:30.30,0:08:31.88,Default,,0,0,0,,Сигнал бомбасының шығуы расталды
Dialogue: 0,0:08:31.96,0:08:34.38,Default,,0,0,0,,Құрамадағы әрбір ұшақ ұстап алуға дайын.
Dialogue: 0,0:08:34.47,0:08:36.14,Default,,0,0,0,,Ұшқыштың жауынгерлік ұшуға дайындығы
Dialogue: 0,0:08:36.22,0:08:37.35,Default,,0,0,0,,Зеон қалдықтары?
Dialogue: 0,0:08:37.43,0:08:40.97,Default,,0,0,0,,Соғыстың аяқталуы туралы келісімді орындамағандар
Dialogue: 0,0:08:41.06,0:08:43.98,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:08:56.82,0:08:58.57,Default,,0,0,0,,Негізгі жауынгердің құлауы
Dialogue: 0,0:09:14.09,0:09:16.47,Default,,0,0,0,,Капитан Берклиден әр ұшаққа
Dialogue: 0,0:09:16.55,0:09:18.51,Default,,0,0,0,,Сіздің жайлы әуе сапарыңыз осында аяқталады.
Dialogue: 0,0:09:19.01,0:09:20.51,Default,,0,0,0,,Тренинг нәтижелерін көрсетіңіз!
Dialogue: 0,0:09:29.77,0:09:32.15,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:09:34.44,0:09:37.24,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:09:37.32,0:09:39.49,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:09:40.91,0:09:42.16,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:09:43.45,0:09:45.87,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:09:54.01,0:09:55.80,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:09:57.59,0:09:58.63,Default,,0,0,0,,Уф
Dialogue: 0,0:09:58.72,0:10:00.34,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:10:01.85,0:10:03.14,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:10:04.02,0:10:07.14,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:10:07.23,0:10:13.15,Default,,0,0,0,,(джаз музыкасы)
Dialogue: 0,0:10:17.74,0:10:22.03,Default,,0,0,0,,(Радио музыка)
Dialogue: 0,0:10:27.12,0:10:31.54,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:10:32.38,0:10:38.26,Default,,0,0,0,,♪ Ұзын түнді сығып алыңыз
Dialogue: 0,0:10:38.34,0:10:44.68,Default,,0,0,0,,♪ Үнемі жылайтыным сонша, көзім қысылып қалады
Dialogue: 0,0:10:44.76,0:10:47.98,Default,,0,0,0,,♪ Иә, Құдай
Dialogue: 0,0:10:48.06,0:10:52.19,Default,,0,0,0,,♪ Мені роммен жуып, сүй
Dialogue: 0,0:10:52.27,0:10:58.65,Default,,0,0,0,,♪ Қызындай дұға ет
Dialogue: 0,0:11:00.24,0:11:03.66,Default,,0,0,0,,♪ Тек қателер төгіледі...
Dialogue: 0,0:11:03.74,0:11:07.54,Default,,0,0,0,,Хаа хаа сонда
Dialogue: 0,0:11:07.62,0:11:11.71,Default,,0,0,0,,Ылғалдылық керемет! Бұл таң қалдырады
Dialogue: 0,0:11:11.79,0:11:14.42,Default,,0,0,0,,Бұл жағдайда колония ыңғайлырақ болар еді.
Dialogue: 0,0:11:14.50,0:11:15.67,Default,,0,0,0,,Теңіз және қар —
Dialogue: 0,0:11:15.75,0:11:18.09,Default,,0,0,0,,Шөлдер мен шабындықтардың барлығы шынайы.
Dialogue: 0,0:11:18.46,0:11:21.72,Default,,0,0,0,,Әй... Жер әдемі екен.
Dialogue: 0,0:11:21.80,0:11:24.72,Default,,0,0,0,,Даррил! Аяғыңызды дұрыстап жуыңыз!
Dialogue: 0,0:11:24.80,0:11:26.56,Default,,0,0,0,,Теңіз суы тат басады
Dialogue: 0,0:11:28.72,0:11:30.39,Default,,0,0,0,,(шашу шуы)
Dialogue: 0,0:11:33.15,0:11:35.36,Default,,0,0,0,,Жасайық
Dialogue: 0,0:11:35.44,0:11:38.11,Default,,0,0,0,,Ой-ооооо
Dialogue: 0,0:11:39.19,0:11:40.70,Default,,0,0,0,,(Панда) Бірінші курс студентін жіберуді қамтитын Арнайы сынып ісі — бұл төтенше жағдай.
Dialogue: 0,0:11:42.41,0:11:44.07,Default,,0,0,0,,Бұрынғы тірі өлілер бөлімі
Dialogue: 0,0:11:44.16,0:11:46.41,Default,,0,0,0,,Екінші лейтенант – қайырымды адам.
Dialogue: 0,0:11:46.49,0:11:49.87,Default,,0,0,0,,Біздің техникалық қызмет көрсету тобы лейтенант үшін осылай істеп жатыр.
Dialogue: 0,0:11:49.95,0:11:53.08,Default,,0,0,0,,Бұл мен пайдалы болады деп уәде еткен эмблема.
Dialogue: 0,0:11:53.17,0:11:55.46,Default,,0,0,0,,Оны қабылдаңыз.
Dialogue: 0,0:11:55.54,0:11:56.84,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:57.21,0:11:58.59,Default,,0,0,0,,Сондай-ақ өтінемін
Dialogue: 0,0:12:00.80,0:12:02.17,Default,,0,0,0,,Мен оны бағалаймын
Dialogue: 0,0:12:02.55,0:12:03.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:06.18,0:12:07.68,Default,,0,0,0,,Хаха
Dialogue: 0,0:12:09.01,0:12:10.06,Default,,0,0,0,,Бұл ол.
Dialogue: 0,0:12:10.14,0:12:12.02,Default,,0,0,0,,прапорщик Даррил Лоренц
Dialogue: 0,0:12:12.44,0:12:13.60,Default,,0,0,0,,Thunderbolt секторы.
Dialogue: 0,0:12:13.69,0:12:14.73,Default,,0,0,0,,Тірі қалу
Dialogue: 0,0:12:14.81,0:12:15.86,Default,,0,0,0,,Қазіргі уақытта концерттік турда
Dialogue: 0,0:12:15.94,0:12:18.57,Default,,0,0,0,,Әйгілі Психо Закуды басқару үшін—
Dialogue: 0,0:12:18.65,0:12:20.61,Default,,0,0,0,,Ол протездік мүшені өзі жасаған көрінеді.
Dialogue: 0,0:12:20.69,0:12:24.11,Default,,0,0,0,,Осындай жанқиярлық пен елге деген адалдық рухы...
Dialogue: 0,0:12:24.20,0:12:26.07,Default,,0,0,0,,Маған ешкім еліктей алмайды
Dialogue: 0,0:12:27.03,0:12:28.45,Default,,0,0,0,,Уф
Dialogue: 0,0:12:29.24,0:12:32.12,Default,,0,0,0,,Ол нағыз ұшқыш.
Dialogue: 0,0:12:32.20,0:12:33.54,Default,,0,0,0,,Мен саған тәнтімін
Dialogue: 0,0:12:34.00,0:12:36.79,Default,,0,0,0,,Прапорщик Билли Шылым шегу
Dialogue: 0,0:12:36.88,0:12:38.17,Default,,0,0,0,,Денсаулыққа зиян.
Dialogue: 0,0:12:38.25,0:12:40.80,Default,,0,0,0,,Жер өте үлкен
Dialogue: 0,0:12:40.88,0:12:43.63,Default,,0,0,0,,Кішкене ластанған дұрыс, Себастьян.
Dialogue: 0,0:12:43.72,0:12:50.68,Default,,0,0,0,,♪ Әулиедей тазарған
Dialogue: 0,0:12:51.52,0:12:57.15,Default,,0,0,0,,♪ Таң атқанға дейінгі ең қараңғы сағат
Dialogue: 0,0:12:57.23,0:12:58.44,Default,,0,0,0,,Маржанды баспа
Dialogue: 0,0:12:58.52,0:13:04.90,Default,,0,0,0,,♪ Билли Холидж төсекте жылап жатыр
Dialogue: 0,0:13:05.40,0:13:11.45,Default,,0,0,0,,♪ Өлемін деген түстен оянсам
Dialogue: 0,0:13:12.37,0:13:17.92,Default,,0,0,0,,♪ Ғашық адам жоқ
Dialogue: 0,0:13:19.25,0:13:25.09,Default,,0,0,0,,♪ Ғашық адам жоқ
Dialogue: 0,0:13:26.01,0:13:30.93,Default,,0,0,0,,♪ Ғашық адам жоқ
Dialogue: 0,0:13:33.22,0:13:37.81,Default,,0,0,0,,♪ Ғашық адам жоқ
Dialogue: 0,0:13:38.23,0:13:39.27,Default,,0,0,0,,Эй
Dialogue: 0,0:13:39.36,0:13:41.61,Default,,0,0,0,,Ауырлық күші болған кезде техникалық қызмет көрсету шынымен қиындық туғыза ма?
Dialogue: 0,0:13:41.69,0:13:42.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:42.82,0:13:45.95,Default,,0,0,0,,А Бианка… Ка Ка…
Dialogue: 0,0:13:46.03,0:13:48.45,Default,,0,0,0,,Фу Бианка Карлайл
Dialogue: 0,0:13:48.91,0:13:51.33,Default,,0,0,0,,Аха Карлайл
Dialogue: 0,0:13:51.41,0:13:55.62,Default,,0,0,0,,Аа, дұрыс. Гравитация қозғалуды қиындатады.
Dialogue: 0,0:13:55.70,0:13:57.67,Default,,0,0,0,,Раттал бойымен жоғары және төмен жүру
Dialogue: 0,0:13:57.75,0:13:59.29,Default,,0,0,0,,Сіз Guncannon Aqua компаниясысыз
Dialogue: 0,0:14:00.13,0:14:03.34,Default,,0,0,0,,Сіз Thunderbolt секторынан аман қалғансыз, солай ма?
Dialogue: 0,0:14:03.42,0:14:06.34,Default,,0,0,0,,Сыбыс Гундам Мен де көргім келді
Dialogue: 0,0:14:06.42,0:14:08.09,Default,,0,0,0,,Иә
Dialogue: 0,0:14:08.18,0:14:12.30,Default,,0,0,0,,Ол кезде мен Конпей аралында соғысып жүргенмін.
Dialogue: 0,0:14:12.39,0:14:13.72,Default,,0,0,0,,Джим сонда?
Dialogue: 0,0:14:14.27,0:14:19.73,Default,,0,0,0,,RGM-79 Хмм, тіпті №1 жұлдыз болған кезде де.
Dialogue: 0,0:14:19.81,0:14:22.40,Default,,0,0,0,,Io да басында болды.
Dialogue: 0,0:14:22.48,0:14:24.98,Default,,0,0,0,,Ио Гундам ұшқышы
Dialogue: 0,0:14:25.57,0:14:29.49,Default,,0,0,0,,Иә, егер ол осы операцияда болса.
Dialogue: 0,0:14:29.57,0:14:31.87,Default,,0,0,0,,Уайымдама, мен осындамын.
Dialogue: 0,0:14:31.95,0:14:33.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:33.66,0:14:36.37,Default,,0,0,0,,Жер Бұл менің бірінші рет.
Dialogue: 0,0:14:36.45,0:14:37.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:37.91,0:14:40.46,Default,,0,0,0,,Бұл сендіреді, танысқаныма қуаныштымын.
Dialogue: 0,0:14:40.83,0:14:42.04,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:14:49.68,0:14:50.80,Default,,0,0,0,,Әй
Dialogue: 0,0:14:53.22,0:14:55.47,Default,,0,0,0,,Кері іске қосу!
Dialogue: 0,0:14:55.85,0:14:57.98,Default,,0,0,0,,Барлық кемелер жеделдету қорғанысын кері қайтарады!
Dialogue: 0,0:15:04.27,0:15:06.48,Default,,0,0,0,,Қалыпты жақсы бақылау
Dialogue: 0,0:15:06.57,0:15:08.32,Default,,0,0,0,,Круиздік ұшу режиміне көшу
Dialogue: 0,0:15:18.79,0:15:22.08,Default,,0,0,0,,Ай! А, мен шынтағымды соқтым.
Dialogue: 0,0:15:22.17,0:15:25.71,Default,,0,0,0,,Әй! Әлі әрекет етуде!
Dialogue: 0,0:15:25.79,0:15:27.71,Default,,0,0,0,,Сіз қазір қозғала аласыз!
Dialogue: 0,0:15:27.80,0:15:29.72,Default,,0,0,0,,Мәселе бұл емес.
Dialogue: 0,0:15:29.80,0:15:32.51,Default,,0,0,0,,-Жарайды.-(Корнелий) Тыңда.
Dialogue: 0,0:15:35.60,0:15:36.72,Default,,0,0,0,,Иә
Dialogue: 0,0:15:39.31,0:15:40.64,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:41.06,0:15:43.65,Default,,0,0,0,,Уау! Бұл теңіз!
Dialogue: 0,0:15:43.73,0:15:44.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:45.48,0:15:47.40,Default,,0,0,0,,Бізге дереу орналастыру туралы бұйрық беріңіз!
Dialogue: 0,0:15:48.11,0:15:50.90,Default,,0,0,0,,Қандай дұшпан болса да, мен оны талқандаймын!
Dialogue: 0,0:15:50.99,0:15:54.91,Default,,0,0,0,,Ахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахахаха
Dialogue: 0,0:16:09.17,0:16:11.84,Default,,0,0,0,,Бұдан былай жоспарланған орбитаға көшу басталады
Dialogue: 0,0:16:11.92,0:16:15.34,Default,,0,0,0,,30 секундтан кейін аналық кемемен байланыс жойылады.
Dialogue: 0,0:16:15.80,0:16:19.10,Default,,0,0,0,,Мен ефрейтор Хулио мен ефрейтор Григорийге сәттілік тілеймін.
Dialogue: 0,0:16:19.97,0:16:25.23,Default,,0,0,0,,Арнайы шабуылыңызды аяқтаңыз, мақтаныш Зеон элитасы!
Dialogue: 0,0:16:25.85,0:16:31.15,Default,,0,0,0,,(джаз музыкасы)
Dialogue: 0,0:16:33.74,0:16:36.53,Default,,0,0,0,,Соңғы сорпа дәмді болды.
Dialogue: 0,0:16:43.87,0:16:45.87,Default,,0,0,0,,Міне! Зениттік өрт!
Dialogue: 0,0:16:45.96,0:16:48.00,Default,,0,0,0,,Жарайсыңдар! Біз жеңеміз!
Dialogue: 0,0:16:48.09,0:16:50.00,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:16:50.09,0:16:53.26,Default,,0,0,0,,Әуе шабуылына қарсы қорғаныс! Оны SAM көмегімен түсіріңіз!
Dialogue: 0,0:16:53.34,0:16:55.93,Default,,0,0,0,,Төмендеу! Мен оны түсіре алмаймын!
Dialogue: 0,0:16:56.01,0:16:59.01,Default,,0,0,0,,Қалағаныңды істесең болады! Ат!
Dialogue: 0,0:16:59.10,0:17:00.56,Default,,0,0,0,,Жалтару маневрлерін орындау
Dialogue: 0,0:17:00.64,0:17:01.85,Default,,0,0,0,,«Жоқ» десе де қозғал!
Dialogue: 0,0:17:09.15,0:17:10.61,Default,,0,0,0,,(белгі дыбысы)
Dialogue: 0,0:17:29.17,0:17:30.84,Default,,0,0,0,,(Цезарь) Не… Не болып жатыр? Бұл жігіттердің айналасындағы атмосфера…
Dialogue: 0,0:17:30.92,0:17:34.17,Default,,0,0,0,,Мұндай стратегияны ойлаған адам өлсін!
Dialogue: 0,0:17:34.26,0:17:36.63,Default,,0,0,0,,Федерация мен Зеон жойылсын!
Dialogue: 0,0:17:41.18,0:17:42.60,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:17:45.18,0:17:46.02,Default,,0,0,0,,Міне!
Dialogue: 0,0:17:48.19,0:17:49.40,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:17:54.49,0:17:55.90,Default,,0,0,0,,Қандай шабуыл!
Dialogue: 0,0:18:00.99,0:18:01.95,Default,,0,0,0,,Гундам! ?
Dialogue: 0,0:18:21.09,0:18:24.35,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:27.06,0:18:28.64,Default,,0,0,0,,О Гу
Dialogue: 0,0:18:28.73,0:18:30.35,Default,,0,0,0,,Уф уф
Dialogue: 0,0:18:32.69,0:18:35.36,Default,,0,0,0,,Бұл жігіт жаңадан келген
Dialogue: 0,0:18:36.24,0:18:40.11,Default,,0,0,0,,RX-78AL
Dialogue: 0,0:18:40.66,0:18:44.79,Default,,0,0,0,,Бұл стратегияның кілті болатыны сөзсіз.
Dialogue: 0,0:18:45.54,0:18:47.16,Default,,0,0,0,,Келіспейсің бе?
Dialogue: 0,0:19:11.69,0:19:15.52,Default,,0,0,0,,(джаз музыкасы)
Dialogue: 0,0:19:15.61,0:19:18.69,Default,,0,0,0,,бөліміне өтіңіз ~ Жақсы хобби емес
Dialogue: 0,0:19:19.49,0:19:20.70,Default,,0,0,0,,Джаз
Dialogue: 0,0:19:21.16,0:19:24.58,Default,,0,0,0,,(джаз музыкасы)
Dialogue: 0,0:19:25.49,0:19:29.71,Default,,0,0,0,,Атлас Гундамға прапорщик Ио Флеминг келді.
Dialogue: 0,0:19:51.19,0:19:54.86,Default,,0,0,0,,Жаудың нысанасы Азия немесе Африка ма?
Dialogue: 0,0:19:58.15,0:20:00.44,Default,,0,0,0,,Федералдық шошқалар
Dialogue: 0,0:20:02.57,0:20:04.99,Default,,0,0,0,,Дәл осындай азаптың дәмін тат
Dialogue: 0,0:20:05.87,0:20:09.87,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:20:36.36,0:20:37.73,Default,,0,0,0,,Бианка
Dialogue: 0,0:20:37.81,0:20:39.90,Default,,0,0,0,,Сіз жаңа Гундамды қызғанасыз ба?
Dialogue: 0,0:20:39.98,0:20:42.03,Default,,0,0,0,,Хахаха! бөлек
Dialogue: 0,0:20:42.44,0:20:45.82,Default,,0,0,0,,Соңғы уақытта жалған Гандам бастары да бар.
Dialogue: 0,0:20:46.66,0:20:50.62,Default,,0,0,0,,Менің Guncannon Aqua нақты шайқаста пайдалырақ.
Dialogue: 0,0:20:50.70,0:20:54.58,Default,,0,0,0,,Бірақ эй, бұл жаңа буын.
Dialogue: 0,0:20:54.67,0:20:57.25,Default,,0,0,0,,Олар Зеонның қосмекенді буындарына ұқсамайды ма?
Dialogue: 0,0:20:57.33,0:20:59.59,Default,,0,0,0,,А, солай шығар.
Dialogue: 0,0:21:00.63,0:21:02.80,Default,,0,0,0,,Ха ха
Dialogue: 0,0:21:03.72,0:21:05.63,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:21:06.43,0:21:08.26,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:10.43,0:21:13.14,Default,,0,0,0,,Ол әнді тыңдап тұрған жоқ па?
Dialogue: 0,0:21:13.23,0:21:14.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:14.56,0:21:18.98,Default,,0,0,0,,Прапорщик Ио Флеминг, сіз спартандықтарды жақсы қорғадыңыз.
Dialogue: 0,0:21:19.06,0:21:20.36,Default,,0,0,0,,Мен құрметтімін
Dialogue: 0,0:21:20.44,0:21:24.53,Default,,0,0,0,,Полковник Моника Хамфри, Директордың орынбасары, Үшінші департамент, Біріккен Штаб бастықтары
Dialogue: 0,0:21:24.61,0:21:27.11,Default,,0,0,0,,Мұның бәрі Атлас Гундамның өнерінің арқасында.
Dialogue: 0,0:21:27.20,0:21:31.20,Default,,0,0,0,,Моория бауырластығының үлкен инвестициясымен жасалған мобильді костюм.
Dialogue: 0,0:21:31.28,0:21:32.33,Default,,0,0,0,,Ақылмен пайдаланыңыз
Dialogue: 0,0:21:34.91,0:21:36.29,Default,,0,0,0,,Жауап беріңіз!
Dialogue: 0,0:21:36.37,0:21:39.92,Default,,0,0,0,,Жарайды, мен барлығына алдағы стратегия туралы айтып беремін.
Dialogue: 0,0:21:40.00,0:21:41.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:42.55,0:21:45.76,Default,,0,0,0,,Гундам Мур бауырластарының ақшасымен жасалды ма?
Dialogue: 0,0:21:45.84,0:21:47.47,Default,,0,0,0,,Маған ұнамайды, бұл элиталық жағы.
Dialogue: 0,0:21:47.55,0:21:49.05,Default,,0,0,0,,Тек ерекшеленгісі келеді
Dialogue: 0,0:21:49.14,0:21:51.60,Default,,0,0,0,,Қабылдау үстелін шабуылдаушы ақымақ басқара алады.
Dialogue: 0,0:21:51.68,0:21:53.02,Default,,0,0,0,,Жаман емес
Dialogue: 0,0:21:56.23,0:21:57.27,Default,,0,0,0,,Io!
Dialogue: 0,0:21:57.69,0:21:59.77,Default,,0,0,0,,Сәлем досым!
Dialogue: 0,0:21:59.86,0:22:01.48,Default,,0,0,0,,Мен сені естідім, джаз.
Dialogue: 0,0:22:01.57,0:22:04.53,Default,,0,0,0,,Сәлем, осыны қайта орнатқаныңызды қалаймын.
Dialogue: 0,0:22:04.61,0:22:06.40,Default,,0,0,0,,Ұрыс кезінде дірілдеп қаламын.
Dialogue: 0,0:22:06.49,0:22:07.53,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:22:07.61,0:22:10.03,Default,,0,0,0,,Бұрынғыдай жігіт емес пе?
Dialogue: 0,0:22:10.41,0:22:13.08,Default,,0,0,0,,Өйткені, бұл олай емес.
Dialogue: 0,0:22:13.16,0:22:15.04,Default,,0,0,0,,Кейінірек кабинаға қараңыз
Dialogue: 0,0:22:15.12,0:22:19.42,Default,,0,0,0,,Сонымен қатар, орындыққа қараңыз. Менің арқамның бұл бөлігі қызып кетеді.
Dialogue: 0,0:22:19.50,0:22:22.54,Default,,0,0,0,,Дұрыс, мен бірден қараймын.
Dialogue: 0,0:22:22.63,0:22:25.05,Default,,0,0,0,,Ал мына рельсті мылтық.
Dialogue: 0,0:22:25.13,0:22:27.30,Default,,0,0,0,,Оқ атылған сайын сылдырлады.
Dialogue: 0,0:22:27.38,0:22:29.34,Default,,0,0,0,,Сіз оны кенет лақтырып жібердіңіз, солай ма?
Dialogue: 0,0:22:29.43,0:22:31.14,Default,,0,0,0,,Бір ату және ол дірілдеп кетті
Dialogue: 0,0:22:31.22,0:22:33.26,Default,,0,0,0,,Мұнда да батыр болып көріну
Dialogue: 0,0:22:33.35,0:22:37.48,Default,,0,0,0,,Найзағай секторында солдат баланы қалқан ретінде пайдаланған қорқақ
Dialogue: 0,0:22:37.81,0:22:39.81,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:22:40.23,0:22:42.81,Default,,0,0,0,,Құдайдың жазасы бір күні келеді
Dialogue: 0,0:22:43.73,0:22:44.78,Default,,0,0,0,,Хун
Dialogue: 0,0:22:44.86,0:22:47.44,Default,,0,0,0,,Сондықтан мен саған көмектесемін.
Dialogue: 0,0:22:47.53,0:22:48.82,Default,,0,0,0,,Түсіндім, түсіндім.
Dialogue: 0,0:22:48.90,0:22:51.57,Default,,0,0,0,,Мұқият тыңдаңыз, мен байыптымын.
Dialogue: 0,0:22:52.03,0:22:55.16,Default,,0,0,0,,Бір жылдық соғыс аяқталғаннан бері 8 ай
Dialogue: 0,0:22:55.24,0:22:58.46,Default,,0,0,0,,Зеон қалдықтарының құпия маневрлері жалғасуда.
Dialogue: 0,0:22:58.54,0:23:04.42,Default,,0,0,0,,Соғыстан кейінгі осы хаотикалық кезеңді тыныштандыру Жер Федерациясының күштері ретінде біздің міндетіміз.
Dialogue: 0,0:23:05.17,0:23:09.09,Default,,0,0,0,,Дегенмен, біз, Жер Федерациясының әскери қолбасшылары,
Dialogue: 0,0:23:09.17,0:23:14.05,Default,,0,0,0,,Оңтүстік теңіз альянсы тәуелсіздікке ұмтылуда және әскерін кеңейтуде.
Dialogue: 0,0:23:14.35,0:23:16.31,Default,,0,0,0,,Тіпті ол Оңтүстік теңіз альянсы деп аталса да—
Dialogue: 0,0:23:16.39,0:23:18.02,Default,,0,0,0,,Бірге соғысқан жолдас болса керек.
Dialogue: 0,0:23:18.10,0:23:22.44,Default,,0,0,0,,Олар біздің Федерация күштеріне қауіп төндіретін нәрсеге ие болды.
Dialogue: 0,0:23:28.15,0:23:30.90,Default,,0,0,0,,Бұл ұшақты білетін кез келген адам —
Dialogue: 0,0:23:30.99,0:23:33.57,Default,,0,0,0,,Солардың ішінде мен прапорщик Ио дер едім.
Dialogue: 0,0:23:33.66,0:23:34.83,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:23:35.66,0:23:38.08,Default,,0,0,0,,Мавриандық бауырлас ара ұясы
Dialogue: 0,0:23:38.16,0:23:41.46,Default,,0,0,0,,және үш Salamis кемесі бір ғана ұшақпен суға батты.
Dialogue: 0,0:23:41.54,0:23:44.17,Default,,0,0,0,,Тіпті толық қару-жарақ Гундамды жеңді.
Dialogue: 0,0:23:44.25,0:23:46.34,Default,,0,0,0,,Зеонның тәжірибелік машинасы
Dialogue: 0,0:23:46.71,0:23:51.13,Default,,0,0,0,,Бұл құбыжық Оңтүстік теңіз альянсы деп аталатын культтің қолында.
Dialogue: 0,0:23:51.22,0:23:52.26,Default,,0,0,0,,Ұшқыш —
Dialogue: 0,0:23:52.34,0:23:54.34,Default,,0,0,0,,Аяқ нервтерін жалғаңыз—
Dialogue: 0,0:23:54.43,0:23:58.27,Default,,0,0,0,,Максималды жұмыс жылдамдығы бар жылжымалы костюм
Dialogue: 0,0:23:58.81,0:24:00.60,Default,,0,0,0,,Осы ұшақты барынша пайдалану үшін—
Dialogue: 0,0:24:00.68,0:24:04.23,Default,,0,0,0,,Зеон әскері мүгедек жауынгерлерді пайдаланды.
Dialogue: 0,0:24:04.56,0:24:06.48,Default,,0,0,0,,Скульт мүшелері -
Dialogue: 0,0:24:06.57,0:24:10.24,Default,,0,0,0,,Мен өз сенімім үшін бір мүшені кесіп тастар едім.
Dialogue: 0,0:24:10.32,0:24:11.53,Default,,0,0,0,,Бұған дейін—
Dialogue: 0,0:24:11.61,0:24:16.16,Default,,0,0,0,,Осы ұшақты басып алуға немесе жоюға жіберілген адам:
Dialogue: 0,0:24:16.70,0:24:20.87,Default,,0,0,0,,Бұл біз осы уақытта әкелген Атлас Гундам.
Dialogue: 0,0:24:27.75,0:24:29.42,Default,,0,0,0,,Психо Заку
Dialogue: 0,0:24:29.50,0:24:33.34,Default,,0,0,0,,Қайтарып алсақ, бәрінің аяқ-қолын кесіп тастамақсыз ба?
Dialogue: 0,0:24:33.43,0:24:38.05,Default,,0,0,0,,Енді, мүгедек жауынгерлердің ынтымақтастығын сұрайтын уақыт емес пе?
Dialogue: 0,0:24:38.14,0:24:40.56,Default,,0,0,0,,Ньютайп зерттеуімен не болып жатыр?
Dialogue: 0,0:24:40.64,0:24:44.44,Default,,0,0,0,,Маған қарамастан, достарымның әлі де көп әлеуеті бар.
Dialogue: 0,0:24:44.52,0:24:46.02,Default,,0,0,0,,Әрине солай.
Dialogue: 0,0:24:46.10,0:24:48.52,Default,,0,0,0,,Мен үшін прапорщик Биллидің күші көбірек
Dialogue: 0,0:24:51.86,0:24:54.99,Default,,0,0,0,,Қабатқа оралу, су ағыны турбулентті.
Dialogue: 0,0:24:55.07,0:24:56.11,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:25:00.16,0:25:03.33,Default,,0,0,0,,Қайта пайдалану P құрылғысын жасаған әйел...
Dialogue: 0,0:25:03.41,0:25:05.29,Default,,0,0,0,,Ол әлдеқашан бұзылған, солай ма?
Dialogue: 0,0:25:16.89,0:25:18.89,Default,,0,0,0,,«Көңілді дуэль» Бұл ақылсыз, солай ма?
Dialogue: 0,0:25:18.97,0:25:20.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:20.10,0:25:22.89,Default,,0,0,0,,Сіз мұны біз осы кемеге қонған кезде естідіңіз.
Dialogue: 0,0:25:22.97,0:25:24.56,Default,,0,0,0,,Сіз бұл әнді білесіз бе?
Dialogue: 0,0:25:24.64,0:25:25.81,Default,,0,0,0,,Әрине!
Dialogue: 0,0:25:25.89,0:25:28.94,Default,,0,0,0,,Хаха! Бұл менің сүйікті әнім
Dialogue: 0,0:25:29.02,0:25:32.44,Default,,0,0,0,,Сіз барлығын нотасыз ойнай аласыз. Әрине, сіз қателеспейсіз.
Dialogue: 0,0:25:32.53,0:25:33.69,Default,,0,0,0,,Мен де!
Dialogue: 0,0:25:34.44,0:25:35.95,Default,,0,0,0,,Бұл Ио Флеминг.
Dialogue: 0,0:25:36.03,0:25:37.53,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:25:38.78,0:25:44.16,Default,,0,0,0,,(джаз музыкасы)
Dialogue: 0,0:27:21.89,0:27:23.18,Default,,0,0,0,,Уф
Dialogue: 0,0:27:24.72,0:27:28.02,Default,,0,0,0,,А... уф
Dialogue: 0,0:27:29.27,0:27:30.60,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:27:30.69,0:27:33.10,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:27:34.69,0:27:36.69,Default,,0,0,0,,6 ай болды.
Dialogue: 0,0:27:36.78,0:27:40.20,Default,,0,0,0,,Күрсініп, ақыры баламды алдым.
Dialogue: 0,0:27:40.82,0:27:45.12,Default,,0,0,0,,Егер олар өз еліне ертерек эвакуацияланса.
Dialogue: 0,0:27:46.20,0:27:47.74,Default,,0,0,0,,Әйелім және мен—
Dialogue: 0,0:27:48.79,0:27:51.58,Default,,0,0,0,,Үйінді астынан қазып алдым.
Dialogue: 0,0:27:52.46,0:27:55.84,Default,,0,0,0,,Әй, кішкентай бала.
Dialogue: 0,0:27:58.92,0:28:00.01,Default,,0,0,0,,Ахх
Dialogue: 0,0:28:09.35,0:28:14.27,Default,,0,0,0,,Спартандықтар енді Оңтүстік теңіз альянсы басқаратын аймақтарға қарай жүр!
Dialogue: 0,0:28:17.98,0:28:20.07,Default,,0,0,0,,Полковник, қауіпсіздік белбеуіңізді тақыңыз.
Dialogue: 0,0:28:20.15,0:28:21.78,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:28:22.40,0:28:23.91,Default,,0,0,0,,Мен мұны өзім жасаймын.
Dialogue: 0,0:28:23.99,0:28:26.57,Default,,0,0,0,,Оның пішіні Саламистен басқа.
Dialogue: 0,0:28:26.66,0:28:29.74,Default,,0,0,0,,Иә? о рас
Dialogue: 0,0:28:31.87,0:28:34.58,Default,,0,0,0,,- (Федералдық сарбаз) Яаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа Уф - (әскери дәрігер) хехехе
Dialogue: 0,0:28:34.67,0:28:35.79,Default,,0,0,0,,Ой...
Dialogue: 0,0:28:35.88,0:28:37.79,Default,,0,0,0,,Әдемі екен.
Dialogue: 0,0:28:37.88,0:28:39.96,Default,,0,0,0,,Бұл ойын түрі сияқты.
Dialogue: 0,0:28:40.05,0:28:43.43,Default,,0,0,0,,Мен кіммін? Взводтың бірлігі бірінші орында!
Dialogue: 0,0:28:43.51,0:28:46.68,Default,,0,0,0,,Білемін, мен де келдім.
Dialogue: 0,0:28:50.01,0:28:51.73,Default,,0,0,0,,Керемет
Dialogue: 0,0:28:51.81,0:28:55.06,Default,,0,0,0,,Менде көп бос орын қалмады.
Dialogue: 0,0:28:55.15,0:28:57.86,Default,,0,0,0,,А, сол жақ бөкселерің бос па?
Dialogue: 0,0:28:59.52,0:29:01.57,Default,,0,0,0,,Сіз көп саяхаттадыңыз.
Dialogue: 0,0:29:01.65,0:29:05.07,Default,,0,0,0,,Мен бірінші тағайындалғаннан бері бәрін салып қойдым.
Dialogue: 0,0:29:05.41,0:29:09.58,Default,,0,0,0,,Менің ойымша, бұл клавесин операциясы мен Хоши №1 ең жаңасы.
Dialogue: 0,0:29:09.66,0:29:11.83,Default,,0,0,0,,Соғыс тарихының айғағы?
Dialogue: 0,0:29:11.91,0:29:14.62,Default,,0,0,0,,Жолдастарыңыздың естеліктерін ойып, есте сақтаңыз
Dialogue: 0,0:29:15.08,0:29:17.83,Default,,0,0,0,,Себебі мен ұмытшақпын
Dialogue: 0,0:29:17.92,0:29:18.96,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:29:19.04,0:29:21.96,Default,,0,0,0,,Капитан Винсент капитан Мариге
Dialogue: 0,0:29:22.05,0:29:26.43,Default,,0,0,0,,Патрульдік миссия №1-ден 4-ке дейін десанттық кемені ұшыруға дайындық
Dialogue: 0,0:29:26.51,0:29:30.68,Default,,0,0,0,,Бұл капитан Мари, мобильді костюмді жүктеу аяқталды.
Dialogue: 0,0:29:30.76,0:29:32.47,Default,,0,0,0,,Енді іске қосуға дайын
Dialogue: 0,0:29:32.97,0:29:35.02,Default,,0,0,0,,Компьютерлерді джазға енгізу —
Dialogue: 0,0:29:35.10,0:29:37.90,Default,,0,0,0,,Өліп бара жатқан еркін джаз мен фьюжнның мәні —
Dialogue: 0,0:29:37.98,0:29:40.27,Default,,0,0,0,,Араластырып, өмірге әкелдім.
Dialogue: 0,0:29:40.36,0:29:43.28,Default,,0,0,0,,Виджай Иер Бомба Кесорике
Dialogue: 0,0:29:43.36,0:29:45.11,Default,,0,0,0,,Олар джазға қосымша заттар қосады.
Dialogue: 0,0:29:45.20,0:29:46.82,Default,,0,0,0,,Мен оны ұрыс даласынан лақтырып жібердім.
Dialogue: 0,0:29:46.91,0:29:50.91,Default,,0,0,0,,Жыныстық қатынас пен зорлық-зомбылықтың өзі, махаббат кейінірек келеді.
Dialogue: 0,0:29:50.99,0:29:52.99,Default,,0,0,0,,Бұл Universal Century Jazz тақырыбы, солай ма?
Dialogue: 0,0:29:53.33,0:29:54.87,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:29:54.95,0:29:59.00,Default,,0,0,0,,Джаз пайда болғаннан бері жалғасып келе жатқан талғампаздық осы.
Dialogue: 0,0:29:59.08,0:30:01.67,Default,,0,0,0,,Қаһарлы болыңыз Дәл болыңыз
Dialogue: 0,0:30:02.30,0:30:05.09,Default,,0,0,0,,Мейірімді бол
Dialogue: 0,0:30:06.05,0:30:09.39,Default,,0,0,0,,Иә, келесі сеанста нені қалайсыз?
Dialogue: 0,0:30:10.01,0:30:11.89,Default,,0,0,0,,Иә.
Dialogue: 0,0:30:11.97,0:30:14.47,Default,,0,0,0,,Олай болса
Dialogue: 0,0:30:14.56,0:30:16.68,Default,,0,0,0,,Қатесіз «Көңілді дуэль».
Dialogue: 0,0:30:17.27,0:30:19.40,Default,,0,0,0,,Екеуміз де аман қалсақ.
Dialogue: 0,0:30:19.48,0:30:22.61,Default,,0,0,0,,«Көңілді дуэль» Жақсы.
Dialogue: 0,0:30:42.63,0:30:44.80,Default,,0,0,0,,Лейтенант Берклиден көпірге дейін
Dialogue: 0,0:30:44.88,0:30:48.80,Default,,0,0,0,,Бұл менің спартандықтарға қосылғаннан кейінгі бірінші миссиям. Рақмет сізге.
Dialogue: 0,0:30:48.88,0:30:51.68,Default,,0,0,0,,Аспандағы жауды іздеу миссиясы үшін рахмет.
Dialogue: 0,0:30:51.76,0:30:55.06,Default,,0,0,0,,Бұл жылжымалы костюмдерді қалайтын жаңадан келгендер тобы.
Dialogue: 0,0:30:55.14,0:30:56.56,Default,,0,0,0,,Дұрыс тапсырма.
Dialogue: 0,0:30:56.64,0:30:59.56,Default,,0,0,0,,истребитель ұшқыштарының саны толығымен қысқарды.
Dialogue: 0,0:30:59.64,0:31:01.06,Default,,0,0,0,,Әрине
Dialogue: 0,0:31:03.52,0:31:05.07,Default,,0,0,0,,(белгі дыбысы)
Dialogue: 0,0:31:30.43,0:31:36.06,Default,,0,0,0,,Федерация барша, менің кекім ешқашан бітпейді.
Dialogue: 0,0:31:43.31,0:31:45.90,Default,,0,0,0,,Миновский бөлшектері соншалықты тығыз екеніне сене алмаймын.
Dialogue: 0,0:31:49.90,0:31:52.41,Default,,0,0,0,,Не? не?
Dialogue: 0,0:31:56.91,0:31:58.20,Default,,0,0,0,,Біраз
Dialogue: 0,0:31:59.75,0:32:01.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:32:01.25,0:32:03.04,Default,,0,0,0,,Төмен қарай амфибиялық жылжымалы костюм!
Dialogue: 0,0:32:03.12,0:32:04.17,Default,,0,0,0,,Доп!
Dialogue: 0,0:32:04.67,0:32:09.55,Default,,0,0,0,,Кешіріңіз, Бианка, мен байқамадым... Ха!
Dialogue: 0,0:32:10.59,0:32:12.43,Default,,0,0,0,,Каролина!
Dialogue: 0,0:32:17.51,0:32:19.22,Default,,0,0,0,,Байланыс кабелін кесуге болады!
Dialogue: 0,0:32:19.31,0:32:21.23,Default,,0,0,0,,Шарларды жеке-жеке алыңыз!
Dialogue: 0,0:32:41.16,0:32:44.00,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:32:46.92,0:32:48.46,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:32:57.43,0:32:59.56,Default,,0,0,0,,Жоқ! Су!
Dialogue: 0,0:33:02.81,0:33:04.02,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:33:11.69,0:33:15.15,Default,,0,0,0,,Барлығың теңізге жүгіріңдер! Сіз көтеріле алмайсыз ба?
Dialogue: 0,0:33:17.37,0:33:18.66,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:33:18.74,0:33:21.91,Default,,0,0,0,,Ах! Coo
Dialogue: 0,0:33:22.00,0:33:23.41,Default,,0,0,0,,Куу
Dialogue: 0,0:33:23.50,0:33:25.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:33:28.25,0:33:32.17,Default,,0,0,0,,Хаа, алданып қалмаңыздар, Зеон қалдықтары!
Dialogue: 0,0:33:32.26,0:33:35.09,Default,,0,0,0,,Мен сені аналығыңнан тайдырамын!
Dialogue: 0,0:33:35.17,0:33:37.34,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:33:41.22,0:33:43.10,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:33:48.94,0:33:50.57,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:33:53.99,0:33:56.36,Default,,0,0,0,,Еріксіз жасалған амфибиялық құрылғылар және т.б.
Dialogue: 0,0:33:56.45,0:33:59.41,Default,,0,0,0,,Бұл Гогтың жауы емес!
Dialogue: 0,0:34:03.54,0:34:05.00,Default,,0,0,0,,Өкінбе!
Dialogue: 0,0:34:05.46,0:34:08.33,Default,,0,0,0,,Бұл қашықтық менікі!
Dialogue: 0,0:34:11.88,0:34:13.05,Default,,0,0,0,,Өзінің өліміне әкелсе де.
Dialogue: 0,0:34:18.43,0:34:20.30,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:34:20.93,0:34:22.72,Default,,0,0,0,,Ах! Ой уау
Dialogue: 0,0:34:22.81,0:34:24.52,Default,,0,0,0,,Уф
Dialogue: 0,0:34:25.22,0:34:26.35,Default,,0,0,0,,Не?!
Dialogue: 0,0:34:26.43,0:34:29.06,Default,,0,0,0,,Порт жағы 17/18 блоктары су астында қалды!
Dialogue: 0,0:34:29.15,0:34:31.36,Default,,0,0,0,,Су басқан блок қалқа жабылды!
Dialogue: 0,0:34:33.32,0:34:36.19,Default,,0,0,0,,Терең теңізге қашыңыз! орындаңыз
Dialogue: 0,0:34:36.78,0:34:41.24,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:34:45.33,0:34:46.41,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:34:48.46,0:34:50.50,Default,,0,0,0,,Иә!
Dialogue: 0,0:34:50.58,0:34:52.59,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:34:53.46,0:34:55.63,Default,,0,0,0,,Бір ұшақ қашып кетті! сурет?
Dialogue: 0,0:35:05.72,0:35:06.97,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:35:09.56,0:35:12.98,Default,,0,0,0,,Гог жай ғана су асты емес!
Dialogue: 0,0:35:13.31,0:35:16.48,Default,,0,0,0,,Сіз мұз үстінде билеп көрдіңіз бе?
Dialogue: 0,0:35:17.19,0:35:21.78,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:35:21.86,0:35:24.66,Default,,0,0,0,,Io Fleming Atlas Гандам Go
Dialogue: 0,0:35:24.74,0:35:26.16,Default,,0,0,0,,(белгі дыбысы)
Dialogue: 0,0:35:39.51,0:35:42.68,Default,,0,0,0,,Энергияңызды аяқтарыңызға және қылышқа шоғырландырыңыз
Dialogue: 0,0:35:42.76,0:35:46.31,Default,,0,0,0,,Өздерін Федерацияға орналастыруды ойламайтындар және т.б.—
Dialogue: 0,0:35:46.85,0:35:49.56,Default,,0,0,0,,Әйел болса да аямайды
Dialogue: 0,0:35:49.64,0:35:52.31,Default,,0,0,0,,Хананың әйел сияқты қарағаны жақсы!
Dialogue: 0,0:35:54.48,0:35:55.98,Default,,0,0,0,,Не!
Dialogue: 0,0:35:58.11,0:35:59.15,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:35:59.24,0:36:01.82,Default,,0,0,0,,Күш! Уф!
Dialogue: 0,0:36:06.49,0:36:07.58,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:36:11.08,0:36:11.75,Default,,0,0,0,,Гаха!
Dialogue: 0,0:36:11.83,0:36:13.50,Default,,0,0,0,,Гехо Гехо Гехо! (ескерту дыбысы)
Dialogue: 0,0:36:13.58,0:36:15.50,Default,,0,0,0,,Хахаха, гохо...
Dialogue: 0,0:36:15.59,0:36:17.50,Default,,0,0,0,,Хааааааааааааа...
Dialogue: 0,0:36:18.09,0:36:21.34,Default,,0,0,0,,Мен зарядтауды күте алмаймын.
Dialogue: 0,0:36:23.72,0:36:26.18,Default,,0,0,0,,Зақымдалған мобильді костюмдерді қалпына келтіруге басымдық беріңіз
Dialogue: 0,0:36:26.26,0:36:27.64,Default,,0,0,0,,Мұзда не бар екенін білесің бе?
Dialogue: 0,0:36:27.72,0:36:29.31,Default,,0,0,0,,Жоқ, мен сілтеме жасамаймын.
Dialogue: 0,0:36:29.39,0:36:30.43,Default,,0,0,0,,О
Dialogue: 0,0:36:30.52,0:36:33.23,Default,,0,0,0,,Майор көтерілгеннен бері неше минут өтті?
Dialogue: 0,0:36:36.48,0:36:40.23,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:36:52.87,0:36:57.54,Default,,0,0,0,,(Пингвин дыбысы)
Dialogue: 0,0:37:12.52,0:37:17.86,Default,,0,0,0,,(Ұялы костюмнің жүру дыбысы)
Dialogue: 0,0:37:32.12,0:37:33.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:37:33.37,0:37:37.04,Default,,0,0,0,,(джаз музыкасы)
Dialogue: 0,0:37:37.12,0:37:38.67,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:37:40.34,0:37:41.21,Default,,0,0,0,,Ей!
Dialogue: 0,0:37:42.17,0:37:45.59,Default,,0,0,0,,Топ мүшелері көмектесуге келді, прапорщик Бианка.
Dialogue: 0,0:37:45.68,0:37:49.43,Default,,0,0,0,,Ол! Мен осында болсам да!
Dialogue: 0,0:37:49.51,0:37:52.64,Default,,0,0,0,,Шашырау! Шашырау! Таратыңыз!
Dialogue: 0,0:37:52.72,0:37:53.68,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:37:53.77,0:37:55.60,Default,,0,0,0,,Не? Бұл тірі оқ па?
Dialogue: 0,0:38:02.65,0:38:04.11,Default,,0,0,0,,(дыбысты сезу)
Dialogue: 0,0:38:10.99,0:38:12.08,Default,,0,0,0,,Мені төмен сүйреңіз!
Dialogue: 0,0:38:12.16,0:38:13.16,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:38:13.24,0:38:14.29,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:38:17.87,0:38:20.13,Default,,0,0,0,,Осылай! О!
Dialogue: 0,0:38:25.97,0:38:27.30,Default,,0,0,0,,Хамф!
Dialogue: 0,0:38:27.59,0:38:31.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:38:31.68,0:38:33.01,Default,,0,0,0,,Әй?
Dialogue: 0,0:38:33.10,0:38:35.02,Default,,0,0,0,,Ол кесілмейді!
Dialogue: 0,0:38:35.10,0:38:38.85,Default,,0,0,0,,Luna титан қорытпасы Федерацияға ғана тән емес!
Dialogue: 0,0:39:12.55,0:39:15.97,Default,,0,0,0,,Біз қосылсақ, сізді босата алмаймыз
Dialogue: 0,0:39:43.50,0:39:45.00,Default,,0,0,0,,Генератор!
Dialogue: 0,0:39:45.09,0:39:47.42,Default,,0,0,0,,Не болып жатыр!
Dialogue: 0,0:39:47.51,0:39:49.38,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:39:50.17,0:39:51.59,Default,,0,0,0,,Ха
Dialogue: 0,0:39:51.68,0:39:53.26,Default,,0,0,0,,Медузаның жебесі!
Dialogue: 0,0:39:56.47,0:39:59.14,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:40:01.69,0:40:04.69,Default,,0,0,0,,Гуха гопок
Dialogue: 0,0:40:09.57,0:40:10.61,Default,,0,0,0,,...
Dialogue: 0,0:40:11.61,0:40:13.16,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:40:14.28,0:40:15.62,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:40:16.41,0:40:17.45,Default,,0,0,0,,Соңғы!
Dialogue: 0,0:40:17.54,0:40:19.50,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:40:48.23,0:40:51.90,Default,,0,0,0,,Амфибия Гандам Бұл Атлас!
Dialogue: 0,0:40:53.15,0:40:55.03,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:40:57.95,0:40:59.12,Default,,0,0,0,,Ұстадым!
Dialogue: 0,0:40:59.62,0:41:01.41,Default,,0,0,0,,Мен тұрып, атамын.
Dialogue: 0,0:41:02.04,0:41:03.91,Default,,0,0,0,,Егер ұсталып қалсам, ең болмағанда сені өлтіремін, Польнарефф》
Dialogue: 0,0:41:09.09,0:41:12.09,Default,,0,0,0,,Бұл қандай шабуыл? Ио!
Dialogue: 0,0:41:12.17,0:41:16.30,Default,,0,0,0,,Майор Кауфман құтқарылған бойда бұл аймақты тастаңыз!
Dialogue: 0,0:41:16.68,0:41:18.60,Default,,0,0,0,,Мен мұны шешемін!
Dialogue: 0,0:41:18.68,0:41:21.60,Default,,0,0,0,,Түсінікті! Лейтенант Булл, сәттілік
Dialogue: 0,0:41:25.56,0:41:26.85,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:41:29.65,0:41:30.86,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:41:31.86,0:41:33.69,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:41:36.03,0:41:37.74,Default,,0,0,0,,Эй!
Dialogue: 0,0:41:38.16,0:41:39.20,Default,,0,0,0,,О!
Dialogue: 0,0:41:44.71,0:41:47.21,Default,,0,0,0,,Бұл теңіз астында бірінші рет соғысып тұрсыз ба?
Dialogue: 0,0:41:47.29,0:41:51.34,Default,,0,0,0,,Омар жігіт, сен менің жаңа көлігімді тырнап алдың.
Dialogue: 0,0:41:58.97,0:42:00.64,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:42:00.72,0:42:02.39,Default,,0,0,0,,Мен саған оң қолымды беремін.
Dialogue: 0,0:42:04.10,0:42:05.48,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:42:05.56,0:42:06.60,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:42:06.69,0:42:07.90,Default,,0,0,0,,Өрт!
Dialogue: 0,0:42:07.98,0:42:09.40,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:42:09.48,0:42:11.77,Default,,0,0,0,,Еееееееааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:42:14.99,0:42:16.99,Default,,0,0,0,,Мына жігіт! Іске қосу уақыты!
Dialogue: 0,0:42:20.82,0:42:23.33,Default,,0,0,0,,Бұл жай ғана сылтау емес!
Dialogue: 0,0:42:26.83,0:42:29.58,Default,,0,0,0,,Менің Grabro!
Dialogue: 0,0:42:42.26,0:42:45.35,Default,,0,0,0,,Жоқ, мен құлап жатырмын.
Dialogue: 0,0:42:45.43,0:42:49.06,Default,,0,0,0,,Атластың қысым шегі қандай? Ол қаншалықты терең?
Dialogue: 0,0:42:56.99,0:43:00.45,Default,,0,0,0,,Энергия бар. Бір жолы болуы керек!
Dialogue: 0,0:43:09.62,0:43:11.42,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:43:12.29,0:43:15.71,Default,,0,0,0,,Міне! Қылышқа қуат
Dialogue: 0,0:43:16.21,0:43:18.47,Default,,0,0,0,,Сіз қазір көтерілуіңіз керек!
Dialogue: 0,0:43:28.02,0:43:31.27,Default,,0,0,0,,Жақсы! Жақсы, егер бұл Гундамның пайдасы болса...
Dialogue: 0,0:43:31.35,0:43:34.27,Default,,0,0,0,,А? температура?
Dialogue: 0,0:43:37.11,0:43:40.78,Default,,0,0,0,,Неге тоқтап тұрсың? Ол батып кете ме?
Dialogue: 0,0:43:47.45,0:43:49.87,Default,,0,0,0,,Қайта зарядтау туралы не деуге болады?
Dialogue: 0,0:44:18.61,0:44:21.32,Default,,0,0,0,,Не, жыртылмаған.
Dialogue: 0,0:44:21.40,0:44:23.70,Default,,0,0,0,,Барлығын, тіпті жаңа жабдықты жоғалту...
Dialogue: 0,0:44:24.82,0:44:27.16,Default,,0,0,0,,Сіз өте жомартсыз, солай емес пе?
Dialogue: 0,0:44:27.24,0:44:28.70,Default,,0,0,0,,Бианка
Dialogue: 0,0:44:28.79,0:44:33.17,Default,,0,0,0,,Біз бір-бірімізді қыспақтан құтқардық, сондықтан енді ештеңе қарыз емеспіз.
Dialogue: 0,0:44:34.17,0:44:36.46,Default,,0,0,0,,Ио, мен үйге келгенде саған бірдеңе сатып аламын.
Dialogue: 0,0:44:37.04,0:44:38.25,Default,,0,0,0,,Не жақсы?
Dialogue: 0,0:44:38.34,0:44:39.59,Default,,0,0,0,,Ha
Dialogue: 0,0:44:40.51,0:44:43.72,Default,,0,0,0,,Макаллан 12 жыл қатарынан?
Dialogue: 0,0:44:43.80,0:44:45.14,Default,,0,0,0,,Дос
Dialogue: 0,0:46:24.74,0:46:28.57,Default,,0,0,0,,♪ Сүйкімді сүйкімді Сүйкімді сүйкімді сүйкімді
Dialogue: 0,0:46:28.66,0:46:31.91,Default,,0,0,0,,♪ Сен сүйкімдісің
Dialogue: 0,0:46:32.45,0:46:36.16,Default,,0,0,0,,♪ Сүйкімді сүйкімді Сүйкімді сүйкімді сүйкімді
Dialogue: 0,0:46:36.25,0:46:39.33,Default,,0,0,0,,♪ Сол сүйкімді қыз
Dialogue: 0,0:46:39.42,0:46:42.88,Default,,0,0,0,,♪ Барлығы, бәрі
Dialogue: 0,0:46:42.96,0:46:46.84,Default,,0,0,0,,♪ Сүйкімді әлем
Dialogue: 0,0:46:47.47,0:46:50.59,Default,,0,0,0,,♪ Тек мен
Dialogue: 0,0:46:50.68,0:46:54.93,Default,,0,0,0,,♪ Неге сүйкімді емес?
Dialogue: 0,0:46:55.31,0:46:59.02,Default,,0,0,0,,♪ Жүзу костюмі Күнделікті киім формасы
Dialogue: 0,0:46:59.10,0:47:01.61,Default,,0,0,0,,♪ Жалаңаш
Dialogue: 0,0:47:02.94,0:47:09.49,Default,,0,0,0,,♪ Айнаны не болса да жек көремін.
Dialogue: 0,0:47:09.86,0:47:13.45,Default,,0,0,0,,♪ Бірақ сіз
Dialogue: 0,0:47:13.53,0:47:17.66,Default,,0,0,0,,♪ Себебі сен мені жақсы көремін дейсің
Dialogue: 0,0:47:18.16,0:47:21.79,Default,,0,0,0,,♪ Мен сүйкімдімін, мен сүйкімдімін
Dialogue: 0,0:47:21.88,0:47:25.13,Default,,0,0,0,,♪ Сізге
Dialogue: 0,0:47:25.50,0:47:28.26,Default,,0,0,0,,Бұл екі адамға арналған кәдесый.
Dialogue: 0,0:47:28.34,0:47:32.68,Default,,0,0,0,,Тамаша, Карла, табиғи бал – асыл тауар.
Dialogue: 0,0:47:32.76,0:47:33.89,Default,,0,0,0,,Мұқият тамақтаныңыз
Dialogue: 0,0:47:33.97,0:47:35.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:47:35.10,0:47:37.98,Default,,0,0,0,,Мен тост алғым келеді, әке!
Dialogue: 0,0:47:43.23,0:47:45.15,Default,,0,0,0,,Иә, Қара.
Dialogue: 0,0:47:46.11,0:47:47.07,Default,,0,0,0,,Кира өзімен-өзі айналысып жүр ғой?
Dialogue: 0,0:47:50.28,0:47:52.61,Default,,0,0,0,,Мен тағы келемін, уәде бер.
Dialogue: 0,0:47:53.32,0:47:56.12,Default,,0,0,0,,А, бұл уәде.
Dialogue: 0,0:48:02.92,0:48:05.21,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:48:15.30,0:48:17.51,Default,,0,0,0,,Қош келдіңіз, Кара-чан
Dialogue: 0,0:48:17.60,0:48:18.81,Default,,0,0,0,,Бұл көңілді болды ма?
Dialogue: 0,0:48:18.89,0:48:21.44,Default,,0,0,0,,Иә, мен кәдесый алдым.
Dialogue: 0,0:48:21.52,0:48:22.52,Default,,0,0,0,,Бұл бал.
Dialogue: 0,0:48:22.60,0:48:24.81,Default,,0,0,0,,О, бұл жақсы.
Dialogue: 0,0:48:24.90,0:48:27.36,Default,,0,0,0,,Бірақ аралар адамдарды шаға ма?
Dialogue: 0,0:48:27.44,0:48:29.99,Default,,0,0,0,,Иә, мен абай болуым керек.
Dialogue: 0,0:48:30.07,0:48:31.65,Default,,0,0,0,,- (Қара) Иә! -(Офицер) Кара-чан
Dialogue: 0,0:48:31.74,0:48:35.12,Default,,0,0,0,,Әкем жұмыста, мен осы жерден қоштасамын.
Dialogue: 0,0:48:35.49,0:48:38.66,Default,,0,0,0,,Жақында кездескенше! Әке, жұмысыңызға сәттілік!
Dialogue: 0,0:48:38.74,0:48:40.08,Default,,0,0,0,,Кездескенше, Карла
Dialogue: 0,0:48:40.16,0:48:41.91,Default,,0,0,0,,-Ой! -(Карла) Сау бол!
Dialogue: 0,0:48:42.00,0:48:44.12,Default,,0,0,0,,Иә, сау болыңыз
Dialogue: 0,0:48:49.05,0:48:53.43,Default,,0,0,0,,Ол өте жақсы бала, әсіресе әкесі жанында.
Dialogue: 0,0:48:54.18,0:48:55.47,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:48:55.55,0:48:57.18,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:48:59.39,0:49:01.81,Default,,0,0,0,,Еңбегіңіз үшін рахмет, прапорщик Даррил.
Dialogue: 0,0:49:02.52,0:49:05.85,Default,,0,0,0,,Профессор Карланы сауықтырудағы күш-жігеріңізге рахмет.
Dialogue: 0,0:49:05.94,0:49:07.56,Default,,0,0,0,,Біз P құрылғыларын да қайта пайдаланамыз...
Dialogue: 0,0:49:07.65,0:49:10.40,Default,,0,0,0,,Мен түсіндім, бәрі жақсы.
Dialogue: 0,0:49:10.82,0:49:12.57,Default,,0,0,0,,Профессор Карлаға қамқорлық жасаңыз.
Dialogue: 0,0:49:12.65,0:49:15.16,Default,,0,0,0,,Қылышымды қатты тартып, саңылауды пайдаланып соғамын
Dialogue: 0,0:49:23.12,0:49:26.38,Default,,0,0,0,,Қорқынышты оқиғаларға байланысты сана мен есте сақтаудың регрессиясы—
Dialogue: 0,0:49:26.46,0:49:29.21,Default,,0,0,0,,Ерте жасөспірімдер деңгейінде болуы мүмкін.
Dialogue: 0,0:49:29.59,0:49:33.51,Default,,0,0,0,,Әрине, дәрігер болғаным есімде жоқтың қасы.
Dialogue: 0,0:49:33.92,0:49:37.05,Default,,0,0,0,,Әкелікпен қоршалған қауіпсіздік сезімі —
Dialogue: 0,0:49:37.14,0:49:40.60,Default,,0,0,0,,Аз да болса психикалық тұрақтылық сақталады.
Dialogue: 0,0:49:40.68,0:49:42.93,Default,,0,0,0,,Психикалық жағдайдың тұрақтылығы—
Dialogue: 0,0:49:43.02,0:49:46.02,Default,,0,0,0,,Бұл жадты қалпына келтіруге әкелетінін білдіре ме?
Dialogue: 0,0:49:46.10,0:49:47.56,Default,,0,0,0,,бұл дұрыс
Dialogue: 0,0:49:47.65,0:49:51.32,Default,,0,0,0,,Профессор Караның емделуіне прапорщик Дарил қажет.
Dialogue: 0,0:49:51.69,0:49:55.74,Default,,0,0,0,,Мен болашақ операцияларға шектеулер қойылғанын қалаймын.
Dialogue: 0,0:49:56.53,0:49:59.49,Default,,0,0,0,,Бұл да маңызды миссия.
Dialogue: 0,0:49:59.57,0:50:00.62,Default,,0,0,0,,Бұл да?
Dialogue: 0,0:50:00.70,0:50:05.66,Default,,0,0,0,,Иә, оның басқа да міндеттері бар.
Dialogue: 0,0:50:06.37,0:50:12.38,Default,,0,0,0,,(Радио музыка)
Dialogue: 0,0:50:19.39,0:50:21.01,Default,,0,0,0,,Қайтадан қош келдіңіз!
Dialogue: 0,0:50:21.10,0:50:23.68,Default,,0,0,0,,Аздап еске түсіре алдыңыз ба?
Dialogue: 0,0:50:23.77,0:50:26.18,Default,,0,0,0,,Ештеңе өзгермейді.
Dialogue: 0,0:50:29.73,0:50:32.27,Default,,0,0,0,,Мүмкін сіз осылай бақытты боларсыз
Dialogue: 0,0:50:32.73,0:50:36.24,Default,,0,0,0,,Өзіңіз жасаған құбыжықтың азабын тартудың қажеті жоқ.
Dialogue: 0,0:50:45.95,0:50:48.62,Default,,0,0,0,,Иә? Капитан жоқ па?
Dialogue: 0,0:50:48.71,0:50:50.75,Default,,0,0,0,,Мен жаңа ғана әйелдікіне бара жатыр едім.
Dialogue: 0,0:50:50.83,0:50:51.88,Default,,0,0,0,,өтіңіз
Dialogue: 0,0:51:02.60,0:51:03.60,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:52:00.20,0:52:02.66,Default,,0,0,0,,Бұл жігітті дер кезінде жөндей алмасам да...
Dialogue: 0,0:52:02.74,0:52:05.28,Default,,0,0,0,,Неліктен операция жоспарланғандай жүріп жатыр?
Dialogue: 0,0:52:05.37,0:52:06.70,Default,,0,0,0,,Мен келіспеймін!
Dialogue: 0,0:52:06.79,0:52:08.50,Default,,0,0,0,,Шешім менің қолымда емес!
Dialogue: 0,0:52:08.58,0:52:10.21,Default,,0,0,0,,Менің күтуімді қалайсыз ба?
Dialogue: 0,0:52:10.29,0:52:11.54,Default,,0,0,0,,Мен үндемеймін!
Dialogue: 0,0:52:11.62,0:52:14.00,Default,,0,0,0,,Бұл ұшаққа бәрі әлі үйренбеген.
Dialogue: 0,0:52:14.08,0:52:15.21,Default,,0,0,0,,Railgun-да да көптеген мәселелер бар
Dialogue: 0,0:52:15.29,0:52:17.09,Default,,0,0,0,,Өткен күні мені бірнеше оқ атып өлтірді.
Dialogue: 0,0:52:17.17,0:52:19.88,Default,,0,0,0,,Сәлем! Менікі жақсы емес пе?
Dialogue: 0,0:52:19.97,0:52:22.93,Default,,0,0,0,,Guncannon-да қосымша бөлшектер бар.
Dialogue: 0,0:52:23.01,0:52:24.34,Default,,0,0,0,,Термоядролық реактор да бұзылған.
Dialogue: 0,0:52:24.43,0:52:25.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:25.60,0:52:28.14,Default,,0,0,0,,Сіз оң аяғыңызды тептіңіз, солай ма?
Dialogue: 0,0:52:28.22,0:52:30.23,Default,,0,0,0,,-Аа -Сен оны тептің бе?
Dialogue: 0,0:52:30.52,0:52:33.40,Default,,0,0,0,,Мүмкін мен тепкен шығармын.
Dialogue: 0,0:52:33.48,0:52:35.23,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:52:35.52,0:52:37.94,Default,,0,0,0,,Себебі мені шынымен семіз жігіт басып алды, солай ма?
Dialogue: 0,0:52:38.02,0:52:38.86,Default,,0,0,0,,Сол жігітке.
Dialogue: 0,0:52:38.94,0:52:41.24,Default,,0,0,0,,Механизаторларыңызды менің ұшағыма шоғырландырыңыз!
Dialogue: 0,0:52:41.32,0:52:43.78,Default,,0,0,0,,Сәлем! Сен де бұздың.
Dialogue: 0,0:52:43.86,0:52:47.41,Default,,0,0,0,,Атлас - бұл стратегияның кілті! ?
Dialogue: 0,0:52:47.49,0:52:50.79,Default,,0,0,0,,Ауырады, ауырады, ауырады, ауырады
Dialogue: 0,0:52:50.87,0:52:54.37,Default,,0,0,0,,Жаңа үлгіні керемет түрде бөлшектеу...
Dialogue: 0,0:52:54.46,0:52:55.54,Default,,0,0,0,,Жақсы батылдық.
Dialogue: 0,0:52:55.63,0:52:57.54,Default,,0,0,0,,Хахахахахахаха!
Dialogue: 0,0:52:57.63,0:52:59.09,Default,,0,0,0,,Сізге де солай!
Dialogue: 0,0:52:59.88,0:53:01.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:53:03.30,0:53:04.76,Default,,0,0,0,,БУМ‼ (Кацуми) Көрдің бе!?
Dialogue: 0,0:53:04.84,0:53:07.01,Default,,0,0,0,,Батыр мен батыр қыз үзіліс жасайды.
Dialogue: 0,0:53:07.10,0:53:09.31,Default,,0,0,0,,Келесі стратегияны маған қалдырыңыз.
Dialogue: 0,0:53:09.39,0:53:13.56,Default,,0,0,0,,Су және жер Риоро? Жер мен судан артық... артық
Dialogue: 0,0:53:13.64,0:53:15.56,Default,,0,0,0,,Мен айта алмаймын! Сау бол!
Dialogue: 0,0:53:15.65,0:53:16.94,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:53:17.02,0:53:19.40,Default,,0,0,0,,Әй, өтінемін, досым.
Dialogue: 0,0:53:19.48,0:53:21.11,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:53:24.70,0:53:26.99,Default,,0,0,0,,Теңізден инфильтрацияға қатысты.
Dialogue: 0,0:53:27.07,0:53:30.33,Default,,0,0,0,,Оңтүстік теңіз альянсы Миновский бөлшектерін пайдаланбайды—
Dialogue: 0,0:53:30.41,0:53:32.62,Default,,0,0,0,,Прапорщик Даррил радар функциясы бар Acguy пайдаланады...
Dialogue: 0,0:53:32.70,0:53:33.91,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:53:34.00,0:53:36.29,Default,,0,0,0,,Миновский бөлшектерін қолданбаймын дейсіз.
Dialogue: 0,0:53:36.37,0:53:38.00,Default,,0,0,0,,Бір рет шашырап бітті, солай ма?
Dialogue: 0,0:53:38.08,0:53:39.38,Default,,0,0,0,,Бүрікпеңіз
Dialogue: 0,0:53:39.46,0:53:41.84,Default,,0,0,0,,Тіпті Миновский бөлшектерінің астында
Dialogue: 0,0:53:41.92,0:53:45.47,Default,,0,0,0,,Прапорщик Даррил ұшағы радиусы 600 метр.
Dialogue: 0,0:53:45.55,0:53:48.85,Default,,0,0,0,,Радар байланысы қоңыраулар мен деректерді ортақ пайдалануға мүмкіндік береді
Dialogue: 0,0:53:48.93,0:53:52.27,Default,,0,0,0,,Сонымен, бұл жолы да жақсысың ба?
Dialogue: 0,0:53:52.35,0:53:54.23,Default,,0,0,0,,Мұндай әңгіме жақсы.
Dialogue: 0,0:53:55.23,0:53:59.86,Default,,0,0,0,,Бүріксе, шашылады, сондықтан икемді болу керек емес пе?
Dialogue: 0,0:54:00.36,0:54:03.03,Default,,0,0,0,,Өйткені сіз жаудың жүрегіне кіресіз.
Dialogue: 0,0:54:03.11,0:54:05.61,Default,,0,0,0,,А, әлі де.
Dialogue: 0,0:54:05.70,0:54:07.86,Default,,0,0,0,,Прапорщик Дэрил ұшағының өзегі —
Dialogue: 0,0:54:07.95,0:54:10.53,Default,,0,0,0,,Оның қару-жарағы кәдімгі ацгуиге қарағанда әлдеқайда аз.
Dialogue: 0,0:54:10.62,0:54:13.12,Default,,0,0,0,,Мүмкіндігінше ұрыстан аулақ болыңыз
Dialogue: 0,0:54:13.20,0:54:16.71,Default,,0,0,0,,Барлау қызметкерінің деректерін қалпына келтіру және құтқару басты басымдық болып табылады.
Dialogue: 0,0:54:16.79,0:54:19.75,Default,,0,0,0,,Мені атып тастайсың ба? Ол үшін жабдық па?
Dialogue: 0,0:54:19.83,0:54:21.88,Default,,0,0,0,,Жауынгерлік мақсат емес
Dialogue: 0,0:54:23.88,0:54:25.63,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:54:26.38,0:54:31.60,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:55:35.99,0:55:39.21,Default,,0,0,0,,Оған көмектесуге болмайды, ол сынған.
Dialogue: 0,0:55:39.66,0:55:42.96,Default,,0,0,0,,«Groovy Duel» Мен мұны істемедім.
Dialogue: 0,0:55:43.67,0:55:46.46,Default,,0,0,0,,Стратегия ойдағыдай болғанша сақтайық.
Dialogue: 0,0:55:47.01,0:55:51.05,Default,,0,0,0,,Сіз жөнелтпесеңіз де, ештеңе жақсы емес.
Dialogue: 0,0:55:51.13,0:55:52.89,Default,,0,0,0,,-Әй -А?
Dialogue: 0,0:55:52.97,0:55:57.72,Default,,0,0,0,,Қауіпсіздік жолағын киіңіз, мені ашуландырасыз.
Dialogue: 0,0:55:57.81,0:55:58.89,Default,,0,0,0,,Әй?
Dialogue: 0,0:56:02.35,0:56:07.98,Default,,0,0,0,,♪ Бұл Кушимото және көшенің арғы жағында Ошима
Dialogue: 0,0:56:08.07,0:56:13.74,Default,,0,0,0,,♪ Делдалдық қызмет ететін круиздік кеме
Dialogue: 0,0:56:13.82,0:56:19.75,Default,,0,0,0,,♪ (Ара йойшо йойшо йойшо йойшо йойшо)
Dialogue: 0,0:56:22.96,0:56:25.42,Default,,0,0,0,,♪ (Хаа окчаяре)
Dialogue: 0,0:56:28.67,0:56:31.17,Default,,0,0,0,,♪ (хаха окчаяре)
Dialogue: 0,0:56:33.68,0:56:39.52,Default,,0,0,0,,♪ Бір қолда қармақ, қолында балық себет
Dialogue: 0,0:56:39.60,0:56:45.36,Default,,0,0,0,,♪ Махаббат ұзаққа созылмайтын нәрсе ме?
Dialogue: 0,0:56:45.44,0:56:51.03,Default,,0,0,0,,♪ (Ара йойшо йойшо йойшо йойшо йойшо)
Dialogue: 0,0:56:54.53,0:56:56.87,Default,,0,0,0,,♪ (Хаа окчаяре)
Dialogue: 0,0:57:00.12,0:57:02.58,Default,,0,0,0,,♪ (Хаа окчаяре)
Dialogue: 0,0:57:16.59,0:57:19.64,Default,,0,0,0,,Картаны жаңарту аяқталды; әрбір әуе кемесіне ақпарат беру басталады
Dialogue: 0,0:57:20.68,0:57:22.14,Default,,0,0,0,,Қабылдау деңгейін тексеріңіз
Dialogue: 0,0:58:25.66,0:58:29.33,Default,,0,0,0,,Қаруды бағыттамаңыз; сізді тежеу ​​жеткілікті.
Dialogue: 0,0:58:45.52,0:58:47.19,Default,,0,0,0,,Сіздің тағы балаңыз болды ма?
Dialogue: 0,0:58:47.27,0:58:48.94,Default,,0,0,0,,Ол қашып кетті! Мені ұста!
Dialogue: 0,0:58:49.81,0:58:51.19,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:58:51.27,0:58:53.53,Default,,0,0,0,,Міне! Өтінемін!
Dialogue: 0,0:58:54.28,0:58:55.99,Default,,0,0,0,,Түсінікті! қауіпсіз
Dialogue: 0,0:58:56.07,0:58:59.61,Default,,0,0,0,,Ха ха ха ха ха ха ха ха
Dialogue: 0,0:58:59.70,0:59:01.49,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:59:03.58,0:59:06.70,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:59:06.79,0:59:07.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:09.25,0:59:11.04,Default,,0,0,0,,Ааа
Dialogue: 0,0:59:11.75,0:59:15.46,Default,,0,0,0,,Қозғалма, жай қал.
Dialogue: 0,0:59:17.01,0:59:18.59,Default,,0,0,0,,Жоқ! жылу сұңқары
Dialogue: 0,0:59:20.93,0:59:22.18,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:59:27.52,0:59:30.60,Default,,0,0,0,,Қат! Эй! Heat Hawk жою
Dialogue: 0,0:59:30.69,0:59:33.23,Default,,0,0,0,,Иә! иә!
Dialogue: 0,0:59:34.40,0:59:37.49,Default,,0,0,0,,Бала тағы да қашып кетті. Жоспарларды өзгерту.
Dialogue: 0,0:59:37.94,0:59:41.70,Default,,0,0,0,,Әлі жоқ! Ол бала ғой, оны ұстап алу ғана қалды.
Dialogue: 0,0:59:41.78,0:59:44.41,Default,,0,0,0,,Ха ха ха ха!
Dialogue: 0,0:59:44.49,0:59:46.87,Default,,0,0,0,,(алау дыбысы)
Dialogue: 0,0:59:47.33,0:59:48.66,Default,,0,0,0,,- (Фишер) Иә? - Фишер!
Dialogue: 0,0:59:48.75,0:59:51.17,Default,,0,0,0,,Оңтүстіктен: 3 көлік және 4 мотоцикл
Dialogue: 0,1:00:02.09,1:00:05.81,Default,,0,0,0,,Қараңдар! Стратегияларды өзгерту ұят емес! Себу!
Dialogue: 0,1:00:12.56,1:00:15.27,Default,,0,0,0,,Не, ұрысып жатқан жоқсың ба?
Dialogue: 0,1:00:15.36,1:00:17.86,Default,,0,0,0,,Менің сонша жерге көшкенімді қалайсың ба?
Dialogue: 0,1:00:18.74,1:00:19.90,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:21.28,1:00:23.95,Default,,0,0,0,,Әй, үйге барсақ болады ма?
Dialogue: 0,1:00:27.66,1:00:28.70,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,1:00:28.79,1:00:30.83,Default,,0,0,0,,Билли! Фишер! жылжымалы костюм
Dialogue: 0,1:00:30.91,1:00:32.58,Default,,0,0,0,,- (Билли) Мен оны көріп тұрмын! - (Фишер) Қайда?
Dialogue: 0,1:00:34.38,1:00:35.84,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:00:36.25,1:00:38.63,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:00:44.05,1:00:45.76,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:00:45.85,1:00:48.72,Default,,0,0,0,,Сіз мұндай барлау агенттерімен байланыста бола алмайсыз.
Dialogue: 0,1:00:48.81,1:00:51.48,Default,,0,0,0,,Құтқару ісімен айналысамын.Фишер де шайқасқа қосылуы керек!
Dialogue: 0,1:00:52.02,1:00:53.73,Default,,0,0,0,,В жоспары! В жоспары!
Dialogue: 0,1:01:00.44,1:01:01.74,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:01:02.74,1:01:03.78,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:01:04.70,1:01:07.99,Default,,0,0,0,,Ньютайп осылай деді ме? Бұл жиіркенішті.
Dialogue: 0,1:01:23.42,1:01:26.30,Default,,0,0,0,,Сіз мініп жатқан мобильді костюм Zeon емес пе?
Dialogue: 0,1:01:26.72,1:01:29.47,Default,,0,0,0,,Оңтүстік теңіз альянсы федералды армия болуы керек, солай ма?
Dialogue: 0,1:01:29.56,1:01:32.35,Default,,0,0,0,,Зақымдалған заттарды алып, пайдаланады.
Dialogue: 0,1:01:32.43,1:01:34.14,Default,,0,0,0,,Сіз өткен күні жиналыста айттыңыз.
Dialogue: 0,1:01:34.23,1:01:36.85,Default,,0,0,0,,Достық ұшақты атудан жақсырақ.
Dialogue: 0,1:01:41.19,1:01:42.74,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:01:58.92,1:02:00.88,Default,,0,0,0,,Қат! Мынадай
Dialogue: 0,1:02:13.47,1:02:15.02,Default,,0,0,0,,Карта!
Dialogue: 0,1:02:18.35,1:02:22.61,Default,,0,0,0,,Оңтүстік теңіз альянсы Шекара қызметінің қолбасшысы, подполковник Пирден
Dialogue: 0,1:02:22.69,1:02:24.78,Default,,0,0,0,,Жер Федерациясы күштерінің жауынгерлік кемесіне ескерту
Dialogue: 0,1:02:25.99,1:02:28.41,Default,,0,0,0,,Сіздің кемеңіз аумақтық әуе кеңістігін бұзуда.
Dialogue: 0,1:02:28.49,1:02:31.53,Default,,0,0,0,,Бұл автономияны анық бұзу болып табылады.
Dialogue: 0,1:02:32.20,1:02:36.79,Default,,0,0,0,,Кеменің тиесілігін, кеме атауын және кіру мақсатын дереу жариялаңыз.
Dialogue: 0,1:02:36.87,1:02:40.13,Default,,0,0,0,,Немесе менің әуе кеңістігімді қалдырыңыз.
Dialogue: 0,1:02:41.00,1:02:42.04,Default,,0,0,0,,Сол жақтағы адам бәрін егжей-тегжейлі түсіндіреді. Содан кейін оның нұсқауларын орындаңыз
Dialogue: 0,1:02:42.88,1:02:46.97,Default,,0,0,0,,Оңтүстік теңіз альянсы шекара гарнизонының командирі подполковник Пирден —
Dialogue: 0,1:02:47.38,1:02:49.51,Default,,0,0,0,,Жер Федерациясының жауынгерлік кемесіне ескерту
Dialogue: 0,1:02:49.59,1:02:50.80,Default,,0,0,0,,Бұл дауыс
Dialogue: 0,1:02:50.89,1:02:52.89,Default,,0,0,0,,Сіздің кемеңіз аумақтық әуе кеңістігін бұзуда...
Dialogue: 0,1:02:52.97,1:02:54.31,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,1:02:54.39,1:02:55.77,Default,,0,0,0,,Бұл автономия құқығын бұзу болып табылады.
Dialogue: 0,1:02:55.85,1:02:58.52,Default,,0,0,0,,Сәлем? аздап!
Dialogue: 0,1:02:59.73,1:03:01.19,Default,,0,0,0,,Не болды!
Dialogue: 0,1:03:02.11,1:03:04.90,Default,,0,0,0,,Немесе менің әуе кеңістігімді қалдырыңыз.
Dialogue: 0,1:03:04.98,1:03:06.19,Default,,0,0,0,,Бұл...
Dialogue: 0,1:03:06.94,1:03:11.03,Default,,0,0,0,,Оңтүстік теңіз альянсы Шекара қызметінің қолбасшысы, подполковник Пирден
Dialogue: 0,1:03:11.12,1:03:13.53,Default,,0,0,0,,...
Dialogue: 0,1:03:14.58,1:03:17.79,Default,,0,0,0,,Сіздің кеменің тиесілігі мен атауын және елге кіру мақсатын жариялау
Dialogue: 0,1:03:18.79,1:03:22.00,Default,,0,0,0,,Немесе менің әуе кеңістігімді қалдырыңыз.
Dialogue: 0,1:03:22.08,1:03:23.50,Default,,0,0,0,,Ах!
Dialogue: 0,1:03:28.01,1:03:30.51,Default,,0,0,0,,Сен неге...
Dialogue: 0,1:03:34.10,1:03:39.02,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,1:03:39.44,1:03:41.27,Default,,0,0,0,,...
Dialogue: 0,1:03:46.32,1:03:47.99,Default,,0,0,0,,Осындай жерде!
Dialogue: 0,1:03:48.07,1:03:50.49,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:03:52.41,1:03:55.20,Default,,0,0,0,,Хаа ха ха ха...
Dialogue: 0,1:03:55.28,1:03:56.95,Default,,0,0,0,,Хаха хаха
Dialogue: 0,1:03:57.04,1:04:01.46,Default,,0,0,0,,…
Dialogue: 0,1:04:01.54,1:04:03.38,Default,,0,0,0,,…
Dialogue: 0,1:04:03.46,1:04:05.84,Default,,0,0,0,,...
Dialogue: 0,1:04:05.92,1:04:09.09,Default,,0,0,0,,…
Dialogue: 0,1:04:09.17,1:04:10.72,Default,,0,0,0,,...
Dialogue: 0,1:04:11.13,1:04:13.14,Default,,0,0,0,,...
Dialogue: 0,1:04:13.80,1:04:17.31,Default,,0,0,0,,Біз Зеон қалдықтарын жою үшін.
Dialogue: 0,1:04:17.39,1:04:19.89,Default,,0,0,0,,...
Dialogue: 0,1:04:20.18,1:04:23.90,Default,,0,0,0,,Жолды дереу босатыңыз және кеменің нұсқауларын орындаңыз.
Dialogue: 0,1:04:23.98,1:04:25.44,Default,,0,0,0,,...
Dialogue: 0,1:04:25.52,1:04:27.15,Default,,0,0,0,,...
Dialogue: 0,1:04:27.23,1:04:29.82,Default,,0,0,0,,Шатаспаңыз, жолдан тайыңыз.
Dialogue: 0,1:04:29.90,1:04:33.66,Default,,0,0,0,,...
Dialogue: 0,1:04:38.66,1:04:41.33,Default,,0,0,0,,...
Dialogue: 0,1:04:41.71,1:04:43.33,Default,,0,0,0,,...
Dialogue: 0,1:04:43.42,1:04:46.09,Default,,0,0,0,,...
Dialogue: 0,1:04:46.17,1:04:48.17,Default,,0,0,0,,Миновский бөлшектердің шашырауы!
Dialogue: 0,1:04:50.76,1:04:52.72,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,1:04:52.80,1:04:57.93,Default,,0,0,0,,Бұл операция шынымен Федералдық армияның ресми операциясы ма?
Dialogue: 0,1:04:58.35,1:05:00.31,Default,,0,0,0,,...
Dialogue: 0,1:05:00.39,1:05:01.43,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:02.85,1:05:04.35,Default,,0,0,0,,Оңтүстік теңіз альянсы —
Dialogue: 0,1:05:04.44,1:05:07.23,Default,,0,0,0,,Біз автономия құқығымызды бұзуға қарсы бар күшімізбен күресеміз.
Dialogue: 0,1:05:08.19,1:05:10.74,Default,,0,0,0,,Чау Мин бұл жолы болжайды
Dialogue: 0,1:05:10.82,1:05:11.94,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:05:12.03,1:05:15.24,Default,,0,0,0,,Тренинг нәтижелері Қараңызшы, Бхикхуни
Dialogue: 0,1:05:15.32,1:05:16.87,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:05:20.12,1:05:21.79,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:05:21.87,1:05:23.41,Default,,0,0,0,,Ｄ
Dialogue: 0,1:05:44.19,1:05:48.11,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:05:48.19,1:05:52.74,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:05:58.70,1:05:59.62,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,1:06:11.80,1:06:14.26,Default,,0,0,0,,...
Dialogue: 0,1:06:14.88,1:06:16.30,Default,,0,0,0,,Түсінікті!
Dialogue: 0,1:06:31.40,1:06:34.32,Default,,0,0,0,,Нашар, мен сигналды қабылдай алмаймын.
Dialogue: 0,1:06:37.41,1:06:41.16,Default,,0,0,0,,･
Dialogue: 0,1:06:41.41,1:06:44.16,Default,,0,0,0,,Атып кетсе де кек сақтама!
Dialogue: 0,1:06:44.95,1:06:47.62,Default,,0,0,0,,Оны тірідей ұстап алу ғажап болар еді!
Dialogue: 0,1:06:48.12,1:06:49.75,Default,,0,0,0,,Капитан сұрыптауға рұқсат берді!
Dialogue: 0,1:06:50.17,1:06:52.29,Default,,0,0,0,,Ио Клаудианы тоқтатыңыз.
Dialogue: 0,1:06:52.67,1:06:54.88,Default,,0,0,0,,Мен сені мұндай жерде өлуге жол бермеймін.
Dialogue: 0,1:06:57.97,1:06:59.89,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:06:59.97,1:07:01.51,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:07:12.11,1:07:13.98,Default,,0,0,0,,Бұл ағын күтілуде.
Dialogue: 0,1:07:15.44,1:07:17.61,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:07:18.20,1:07:19.20,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:22.41,1:07:25.49,Default,,0,0,0,,Оптикалық линзалар мен жылу көзі сенсоры барлығы жұмысын тоқтатты!
Dialogue: 0,1:07:25.58,1:07:27.12,Default,,0,0,0,,Жау көлеңкесі жоғалды! Бұл Чафф!
Dialogue: 0,1:07:27.20,1:07:30.12,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:07:31.17,1:07:32.96,Default,,0,0,0,,Капитан Мари көрінбейді
Dialogue: 0,1:07:33.04,1:07:35.30,Default,,0,0,0,,Атпа, біз сөйлесе алмаймыз!
Dialogue: 0,1:07:35.63,1:07:37.67,Default,,0,0,0,,Айналадағы До Дайдан сақ болыңыз
Dialogue: 0,1:07:38.47,1:07:41.97,Default,,0,0,0,,Соня... Капитан Крид ше?
Dialogue: 0,1:07:42.05,1:07:45.39,Default,,0,0,0,,Осындай тұманмен жау жақындай алмайды.
Dialogue: 0,1:07:46.06,1:07:47.64,Default,,0,0,0,,Негізгі жауынгер Берклиден—
Dialogue: 0,1:07:47.73,1:07:49.39,Default,,0,0,0,,...
Dialogue: 0,1:07:49.48,1:07:52.40,Default,,0,0,0,,Бұл жерден жауды да, досты да анықтау мүмкін емес.
Dialogue: 0,1:07:52.48,1:07:54.19,Default,,0,0,0,,...
Dialogue: 0,1:07:55.40,1:07:58.94,Default,,0,0,0,,♪ Ақырында, таудың ар жағынан
Dialogue: 0,1:07:59.03,1:08:00.57,Default,,0,0,0,,♪
Dialogue: 0,1:08:00.65,1:08:04.87,Default,,0,0,0,,♪
Dialogue: 0,1:08:04.95,1:08:09.12,Default,,0,0,0,,♪
Dialogue: 0,1:08:09.21,1:08:12.12,Default,,0,0,0,,♪ Көңілді кешке ұқсайды
Dialogue: 0,1:08:12.21,1:08:13.75,Default,,0,0,0,,♪
Dialogue: 0,1:08:13.83,1:08:16.38,Default,,0,0,0,,Бұл жерде барлау агенттерімен байланысу мүмкін емес!
Dialogue: 0,1:08:16.80,1:08:19.34,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:08:19.42,1:08:21.93,Default,,0,0,0,,Қайта құрайық! Жабдық таусылады!
Dialogue: 0,1:08:22.01,1:08:23.18,Default,,0,0,0,,Тез шешім қабылдаңыз!
Dialogue: 0,1:08:23.26,1:08:25.30,Default,,0,0,0,,Капитан! Қосалқы журнал нөл
Dialogue: 0,1:08:25.39,1:08:27.31,Default,,0,0,0,,Капитан! Маған нұсқау беріңіз!
Dialogue: 0,1:08:30.94,1:08:32.23,Default,,0,0,0,,Құт
Dialogue: 0,1:08:33.02,1:08:35.27,Default,,0,0,0,,Барлық ұшақтар мерекелік үстелге шегінеді!
Dialogue: 0,1:08:35.90,1:08:38.03,Default,,0,0,0,,Партиялық үстелді түсіну
Dialogue: 0,1:08:38.36,1:08:40.32,Default,,0,0,0,,♪ Ханшайым
Dialogue: 0,1:08:40.40,1:08:43.07,Default,,0,0,0,,♪ Мен кешке бара алмаймын.
Dialogue: 0,1:08:43.16,1:08:45.12,Default,,0,0,0,,♪ Ханзада
Dialogue: 0,1:08:45.20,1:08:47.95,Default,,0,0,0,,♪
Dialogue: 0,1:08:48.04,1:08:50.20,Default,,0,0,0,,♪ Ханшайым
Dialogue: 0,1:08:50.29,1:08:52.79,Default,,0,0,0,,♪
Dialogue: 0,1:08:52.87,1:08:57.46,Default,,0,0,0,,♪ Мұнараның басынан барлығын көру
Dialogue: 0,1:08:57.55,1:08:59.46,Default,,0,0,0,,♪ Шөп даласында
Dialogue: 0,1:08:59.55,1:09:00.97,Default,,0,0,0,,♪
Dialogue: 0,1:09:01.05,1:09:03.22,Default,,0,0,0,,...
Dialogue: 0,1:09:03.30,1:09:04.51,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:04.59,1:09:06.26,Default,,0,0,0,,...
Dialogue: 0,1:09:06.35,1:09:07.60,Default,,0,0,0,,Бұл көмектеседі.
Dialogue: 0,1:09:07.68,1:09:08.72,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:08.81,1:09:09.93,Default,,0,0,0,,...
Dialogue: 0,1:09:10.02,1:09:10.98,Default,,0,0,0,,Тағы кездескенше!
Dialogue: 0,1:09:12.10,1:09:13.89,Default,,0,0,0,,♪
Dialogue: 0,1:09:13.98,1:09:16.86,Default,,0,0,0,,♪
Dialogue: 0,1:09:16.94,1:09:17.90,Default,,0,0,0,,♪ Сақина Сақина Сақина
Dialogue: 0,1:09:17.98,1:09:18.94,Default,,0,0,0,,♪ Сақина Сақина Сақина
Dialogue: 0,1:09:19.02,1:09:21.86,Default,,0,0,0,,♪ Қоңырау соғылып жатыр
Dialogue: 0,1:09:21.94,1:09:25.53,Default,,0,0,0,,♪ Айна тігінен жарылған
Dialogue: 0,1:09:25.61,1:09:28.87,Default,,0,0,0,,♪ Солдаттардың бірі
Dialogue: 0,1:09:28.95,1:09:31.83,Default,,0,0,0,,♪ Ханшайымның атын айт
Dialogue: 0,1:09:31.91,1:09:36.08,Default,,0,0,0,,♪ Айқайлап өлу
Dialogue: 0,1:09:36.17,1:09:41.21,Default,,0,0,0,,♪ Мылтық иісі, найзаның тесілген дыбысы
Dialogue: 0,1:09:41.30,1:09:45.72,Default,,0,0,0,,♪ Мұнараның құлайтынын сезгенде жүрегім елжірейді
Dialogue: 0,1:09:45.80,1:09:49.89,Default,,0,0,0,,♪ Ханшайым ережені бұзды
Dialogue: 0,1:09:49.97,1:09:55.23,Default,,0,0,0,,♪ Партияға кіру үшін төмен түсу
Dialogue: 0,1:09:55.31,1:09:57.06,Default,,0,0,0,,♪ Па Па Па
Dialogue: 0,1:09:57.15,1:09:58.69,Default,,0,0,0,,♪ Па Па Па...
Dialogue: 0,1:09:58.77,1:10:03.03,Default,,0,0,0,,...
Dialogue: 0,1:10:03.11,1:10:05.20,Default,,0,0,0,,А, мен оны енді қаламаймын.
Dialogue: 0,1:10:05.28,1:10:07.28,Default,,0,0,0,,Мен енді ешқашан мұндай тапсырманы орындамаймын.
Dialogue: 0,1:10:07.62,1:10:10.16,Default,,0,0,0,,Кешіріңіз, хаха.
Dialogue: 0,1:10:10.24,1:10:11.91,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:10:16.75,1:10:18.29,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:10:20.13,1:10:22.34,Default,,0,0,0,,Жақын қашықтықта жаудың мобильді костюмін жеңіңіз
Dialogue: 0,1:10:22.42,1:10:24.42,Default,,0,0,0,,Порт жағындағы мега бөлшектердің зеңбіректері де қатты зақымдалған.
Dialogue: 0,1:10:24.51,1:10:26.72,Default,,0,0,0,,Жақсы, атуды жалғастыра бер.
Dialogue: 0,1:10:26.80,1:10:28.97,Default,,0,0,0,,Мен оны түсірген жоқпын.
Dialogue: 0,1:10:29.05,1:10:30.89,Default,,0,0,0,,Өзін құрбан ету арқылы—
Dialogue: 0,1:10:30.97,1:10:33.85,Default,,0,0,0,,Ол одақтастарының жолын босатып алу үшін ішке кірді.
Dialogue: 0,1:10:34.22,1:10:35.98,Default,,0,0,0,,Сіз өзіңізді жоюға дейін барар ма едіңіз?
Dialogue: 0,1:10:36.06,1:10:38.19,Default,,0,0,0,,Бұл сенімнің күші
Dialogue: 0,1:10:38.98,1:10:40.11,Default,,0,0,0,,...
Dialogue: 0,1:10:48.78,1:10:51.12,Default,,0,0,0,,Миыңды жуып жатырсың ба?
Dialogue: 0,1:10:51.83,1:10:53.04,Default,,0,0,0,,Оны атып тастаңыз!
Dialogue: 0,1:10:55.54,1:10:56.58,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:10:56.66,1:10:58.37,Default,,0,0,0,,Бұл ұшу бірлігі.
Dialogue: 0,1:10:58.46,1:11:00.67,Default,,0,0,0,,Сіз еркін ұша алмайсыз
Dialogue: 0,1:11:03.80,1:11:05.30,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:11:10.39,1:11:11.72,Default,,0,0,0,,Ойланып қалдым!
Dialogue: 0,1:11:11.80,1:11:13.56,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:11:13.64,1:11:14.72,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:11:18.35,1:11:19.94,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:11:20.27,1:11:21.94,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,1:11:22.02,1:11:23.32,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:11:24.19,1:11:26.36,Default,,0,0,0,,Рахмет, Чау Мин мырза
Dialogue: 0,1:11:26.44,1:11:28.32,Default,,0,0,0,,Енді біздің кезегіміз
Dialogue: 0,1:11:28.40,1:11:33.08,Default,,0,0,0,,Монсеньор Леван Фоу қол жеткізуді мақсат еткен шынайы буддистік жерді жүзеге асыру үшін
Dialogue: 0,1:11:57.27,1:11:58.98,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:11:59.35,1:12:00.31,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:12:02.06,1:12:04.06,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:12:10.24,1:12:11.66,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:12:21.37,1:12:22.96,Default,,0,0,0,,Қарғыс атқырлар!
Dialogue: 0,1:12:38.39,1:12:39.52,Default,,0,0,0,,Ах!
Dialogue: 0,1:12:39.60,1:12:42.23,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,1:12:44.40,1:12:45.44,Default,,0,0,0,,Қайтарушы Турбо
Dialogue: 0,1:12:50.53,1:12:54.95,Default,,0,0,0,,...
Dialogue: 0,1:12:57.45,1:12:58.91,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,1:12:59.20,1:13:02.12,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:13:02.21,1:13:05.25,Default,,0,0,0,,Көтерілу мүмкін бе?
Dialogue: 0,1:13:10.01,1:13:12.47,Default,,0,0,0,,Маркус Орфей! Сенімен бәрі жақсы ма?
Dialogue: 0,1:13:13.55,1:13:15.59,Default,,0,0,0,,Сәлем! Ио бортта бар ма?
Dialogue: 0,1:13:15.68,1:13:17.60,Default,,0,0,0,,Мен бұл жігіттерді айдадым
Dialogue: 0,1:13:17.68,1:13:19.43,Default,,0,0,0,,До Дайдың жұмысы бар.
Dialogue: 0,1:13:19.52,1:13:21.31,Default,,0,0,0,,Қалғанын сізге қалдырамын.
Dialogue: 0,1:13:28.65,1:13:30.69,Default,,0,0,0,,Өз еркімен әрекет жасамаңыз!
Dialogue: 0,1:13:31.61,1:13:35.45,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:13:37.12,1:13:38.70,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,1:13:38.78,1:13:39.70,Default,,0,0,0,,Ах
Dialogue: 0,1:13:39.79,1:13:40.79,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:13:40.87,1:13:43.29,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:13:45.37,1:13:47.29,Default,,0,0,0,,Люкті жабыңыз
Dialogue: 0,1:13:47.79,1:13:50.88,Default,,0,0,0,,Бұл жылжымалы костюмдерге арналған. Қоян-қолтық ұрысқа дайын болыңыз.
Dialogue: 0,1:13:50.96,1:13:53.34,Default,,0,0,0,,Қоян-қолтық ұрыс? Біз де?
Dialogue: 0,1:13:53.42,1:13:55.34,Default,,0,0,0,,Сіз әлі де кабинада күте аласыз.
Dialogue: 0,1:13:55.43,1:13:57.55,Default,,0,0,0,,Жабдықты тексеріңіз.
Dialogue: 0,1:13:58.55,1:13:59.85,Default,,0,0,0,,Иә!
Dialogue: 0,1:14:03.48,1:14:04.85,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:14:05.85,1:14:08.36,Default,,0,0,0,,Орташа және одан жоғары қашықтыққа арналған қарулар енді жоқ.
Dialogue: 0,1:14:08.44,1:14:09.94,Default,,0,0,0,,Дәл осы жерде!
Dialogue: 0,1:14:10.02,1:14:12.78,Default,,0,0,0,,Сіз өз шегіңіздесіз. Шығу нүктесіне көшіңіз!
Dialogue: 0,1:14:12.86,1:14:16.20,Default,,0,0,0,,Қарғыс атсын! Даррил
Dialogue: 0,1:14:25.16,1:14:28.83,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:14:33.92,1:14:36.05,Default,,0,0,0,,Енді сіз білесіз
Dialogue: 0,1:14:36.13,1:14:37.18,Default,,0,0,0,,Капитан Дэрил —
Dialogue: 0,1:14:37.26,1:14:39.60,Default,,0,0,0,,Психо Закудың арқасында керемет нәтижелерге қол жеткізе алдық па?
Dialogue: 0,1:14:40.35,1:14:43.14,Default,,0,0,0,,Бұл Acguy нәтиже бере ме?
Dialogue: 0,1:14:43.22,1:14:46.60,Default,,0,0,0,,Әлде бұл жауынгерлік рухты көтеру үшін алдау болды ма?
Dialogue: 0,1:14:47.14,1:14:50.02,Default,,0,0,0,,Мен шындықтан алыспын
Dialogue: 0,1:14:50.11,1:14:54.40,Default,,0,0,0,,Шынайы Ньютайп болса, оны өз көзіммен көргім келеді.
Dialogue: 0,1:14:54.48,1:14:58.41,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:15:00.91,1:15:01.95,Default,,0,0,0,,Уф!
Dialogue: 0,1:15:02.03,1:15:03.95,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:15:09.88,1:15:14.96,Default,,0,0,0,,Зиянкестер минималды және олардың дайындығы аз.
Dialogue: 0,1:15:15.05,1:15:17.80,Default,,0,0,0,,Мүмкін мақсат оны бақылау емес шығар.
Dialogue: 0,1:15:17.88,1:15:19.76,Default,,0,0,0,,Олай болса, мақсаты қандай?
Dialogue: 0,1:15:19.84,1:15:21.22,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:15:21.89,1:15:24.39,Default,,0,0,0,,Орынды өзгерткіңіз келе ме? мұнда
Dialogue: 0,1:15:24.47,1:15:27.27,Default,,0,0,0,,Бұл жағдайда ең қауіпсіз.
Dialogue: 0,1:15:35.03,1:15:36.36,Default,,0,0,0,,Бірақ мен осы тасбақамен денемізді алмастырдым
Dialogue: 0,1:15:39.07,1:15:40.61,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:15:50.37,1:15:52.75,Default,,0,0,0,,Io! Дәл бұрынғыдай жау өледі...
Dialogue: 0,1:15:52.83,1:15:54.71,Default,,0,0,0,,Мен олардың бәрін құлатамын! ?
Dialogue: 0,1:15:54.80,1:15:59.63,Default,,0,0,0,,Ауырлық күші астында мұндай акробатикалық шайқас абсурд!
Dialogue: 0,1:15:59.72,1:16:01.76,Default,,0,0,0,,Басқа таңдау жоқ!
Dialogue: 0,1:16:01.84,1:16:04.64,Default,,0,0,0,,Мен Клаудияның қай ұшақта екенін білмеймін!
Dialogue: 0,1:16:05.10,1:16:07.89,Default,,0,0,0,,Бұрынғы қызыңызды ұстағанда не істеуді жоспарлайсыз?
Dialogue: 0,1:16:07.98,1:16:12.81,Default,,0,0,0,,Мен Клаудияға не болғанын білгім келеді.
Dialogue: 0,1:16:13.19,1:16:18.40,Default,,0,0,0,,Мүмкін ол діни қызметкердің миын шайған аянышты ханшайымға айналған шығар.
Dialogue: 0,1:16:18.86,1:16:20.07,Default,,0,0,0,,О
Dialogue: 0,1:16:21.78,1:16:22.86,Default,,0,0,0,,Тс!
Dialogue: 0,1:16:23.82,1:16:27.04,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:16:32.54,1:16:33.79,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:33.88,1:16:35.71,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:16:36.38,1:16:40.26,Default,,0,0,0,,Өзін-өзі жою! F21 орталық блогының сыртқы қабырғасының зақымдануы!
Dialogue: 0,1:16:40.34,1:16:43.26,Default,,0,0,0,,Олардың мақсаты қандай?
Dialogue: 0,1:16:43.34,1:16:48.47,Default,,0,0,0,,Инсайдермен байланысу немесе кемеге бірдеңе әкелу?
Dialogue: 0,1:16:52.89,1:16:57.02,Default,,0,0,0,,Ха ха ха ха! Уфф
Dialogue: 0,1:17:00.36,1:17:05.45,Default,,0,0,0,,А, у, у...
Dialogue: 0,1:17:07.28,1:17:08.83,Default,,0,0,0,,Мен де солай ойладым, бірақ бұл шешімді талқылаудың қажеті жоқ
Dialogue: 0,1:17:13.08,1:17:14.33,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:17:18.71,1:17:21.63,Default,,0,0,0,,Бұл өзеннің бойында, тура жүруге болады.
Dialogue: 0,1:17:21.72,1:17:24.93,Default,,0,0,0,,Жау шабуылын тоқтатты. Бірдеңе болып жатыр.
Dialogue: 0,1:17:25.01,1:17:26.51,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:30.81,1:17:32.81,Default,,0,0,0,,Нууа Көпір бұзылды!
Dialogue: 0,1:17:32.89,1:17:37.73,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:17:37.81,1:17:39.48,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:17:48.24,1:17:49.66,Default,,0,0,0,,Уау!
Dialogue: 0,1:17:52.08,1:17:54.08,Default,,0,0,0,,Бұл жігіт! Оны шайқаңыз!
Dialogue: 0,1:17:59.54,1:18:00.96,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:18:03.42,1:18:05.18,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:18:10.47,1:18:11.97,Default,,0,0,0,,Бұл да басқа!
Dialogue: 0,1:18:12.56,1:18:13.64,Default,,0,0,0,,(Тепкен дыбыс)
Dialogue: 0,1:18:14.10,1:18:15.14,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:18:16.48,1:18:18.40,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:18:21.98,1:18:25.74,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:18:26.07,1:18:27.11,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,1:18:27.20,1:18:28.78,Default,,0,0,0,,Эй, эй! Біз соқтығысамыз! ?
Dialogue: 0,1:18:28.87,1:18:30.49,Default,,0,0,0,,Өтінемін! Өтінемін, үндемеңіз
Dialogue: 0,1:18:32.58,1:18:36.25,Default,,0,0,0,,Жүр, көрсетші, капитан Дэрил.
Dialogue: 0,1:18:38.83,1:18:39.92,Default,,0,0,0,,Яру!
Dialogue: 0,1:18:41.96,1:18:43.00,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:18:43.34,1:18:44.88,Default,,0,0,0,,Мұзды аула?
Dialogue: 0,1:18:52.60,1:18:55.77,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:19:00.44,1:19:02.15,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:19:08.91,1:19:11.12,Default,,0,0,0,,Уау!
Dialogue: 0,1:19:16.62,1:19:18.83,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:19:23.55,1:19:25.51,Default,,0,0,0,,Ия, хаха! Алақай!
Dialogue: 0,1:19:25.59,1:19:28.05,Default,,0,0,0,,Ей, эй, ғажап емес пе!
Dialogue: 0,1:19:28.13,1:19:30.05,Default,,0,0,0,,Сіз кездейсоқ капитан Дэрилсіз бе?
Dialogue: 0,1:19:30.14,1:19:34.51,Default,,0,0,0,,Түсіндім. Сіз әлі өзіңізді таныстырған жоқсыз.
Dialogue: 0,1:19:34.60,1:19:35.77,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:19:39.10,1:19:41.44,Default,,0,0,0,,Бәріміз бірге өлтірілген жоқпыз ба?
Dialogue: 0,1:19:45.53,1:19:47.94,Default,,0,0,0,,Хаааааа...
Dialogue: 0,1:19:50.78,1:19:52.16,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,1:19:59.16,1:20:02.00,Default,,0,0,0,,Жарайсың! Капитан Дэрил күткендей!
Dialogue: 0,1:20:02.67,1:20:06.21,Default,,0,0,0,,Сізде жаман қару болмаса да, мобильді костюмді қалай жеңуге болады?
Dialogue: 0,1:20:06.30,1:20:07.26,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,1:20:07.34,1:20:09.13,Default,,0,0,0,,Мен Сукедачиге келдім
Dialogue: 0,1:20:09.67,1:20:11.09,Default,,0,0,0,,Жеткізгішті қайта бер.
Dialogue: 0,1:20:11.80,1:20:14.01,Default,,0,0,0,,Бұл жерді маған қалдырыңыз.
Dialogue: 0,1:20:15.26,1:20:18.27,Default,,0,0,0,,Пожалуйста, прапорщик Билли Хикам.
Dialogue: 0,1:20:38.08,1:20:39.79,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:20:41.46,1:20:45.34,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:20:56.35,1:20:57.39,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:20:57.47,1:20:59.14,Default,,0,0,0,,№5 ұшақ зақымдалған!
Dialogue: 0,1:20:59.22,1:21:00.89,Default,,0,0,0,,Сол жігіт!
Dialogue: 0,1:21:01.14,1:21:02.85,Default,,0,0,0,,Еркін құлау
Dialogue: 0,1:21:03.35,1:21:06.57,Default,,0,0,0,,Io! Сәулелік қылышты тастаңыз!
Dialogue: 0,1:21:09.28,1:21:10.65,Default,,0,0,0,,Кешігіп қалдың, баспалдақ!
Dialogue: 0,1:21:10.74,1:21:14.41,Default,,0,0,0,,Теңізге сүңгіңіз келе ме? өзімшіл бейбақ
Dialogue: 0,1:21:14.49,1:21:15.82,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:21:15.91,1:21:18.24,Default,,0,0,0,,- (монах) Жақсы жолдас - (монах) Құла!
Dialogue: 0,1:21:23.25,1:21:24.37,Default,,0,0,0,,Га
Dialogue: 0,1:21:27.71,1:21:29.25,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:29.34,1:21:31.01,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,1:21:32.34,1:21:33.17,Default,,0,0,0,,Ha
Dialogue: 0,1:21:35.64,1:21:36.80,Default,,0,0,0,,О
Dialogue: 0,1:21:48.52,1:21:49.73,Default,,0,0,0,,Иә!
Dialogue: 0,1:21:49.82,1:21:51.86,Default,,0,0,0,,Клаудия!
Dialogue: 0,1:21:51.94,1:21:54.07,Default,,0,0,0,,Менің атымды айт!
Dialogue: 0,1:21:55.86,1:21:56.95,Default,,0,0,0,,Io
Dialogue: 0,1:22:07.79,1:22:10.13,Default,,0,0,0,,Бхикхуни! Маған қазір көмектесуге рұқсат етіңіз!
Dialogue: 0,1:22:10.21,1:22:11.63,Default,,0,0,0,,Қарғыс атсын! Бұл жігіт!
Dialogue: 0,1:22:11.71,1:22:13.13,Default,,0,0,0,,Чоу Мин! Тоқта!
Dialogue: 0,1:22:14.97,1:22:16.64,Default,,0,0,0,,Куу уф
Dialogue: 0,1:22:16.72,1:22:18.60,Default,,0,0,0,,Бхикхунимен араласпа!
Dialogue: 0,1:22:18.68,1:22:20.51,Default,,0,0,0,,(ұшқын дыбысы)
Dialogue: 0,1:22:20.60,1:22:21.81,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,1:22:25.52,1:22:26.52,Default,,0,0,0,,Ах!
Dialogue: 0,1:22:26.60,1:22:27.90,Default,,0,0,0,,Ах!
Dialogue: 0,1:22:27.98,1:22:29.27,Default,,0,0,0,,Io!
Dialogue: 0,1:22:35.45,1:22:36.53,Default,,0,0,0,,Бхикхуни!
Dialogue: 0,1:22:36.91,1:22:38.45,Default,,0,0,0,,Бхикхуни!
Dialogue: 0,1:22:40.58,1:22:41.79,Default,,0,0,0,,Io
Dialogue: 0,1:22:55.09,1:22:57.26,Default,,0,0,0,,Ол мұны істеді ме?
Dialogue: 0,1:22:57.59,1:22:58.64,Default,,0,0,0,,Джим Кай және—
Dialogue: 0,1:22:58.72,1:23:00.76,Default,,0,0,0,,Сіз мұны Corvette күшейткішімен жасадыңыз ба?
Dialogue: 0,1:23:01.14,1:23:04.52,Default,,0,0,0,,Атластың ұшқышы тек шоу үшін ғана емес.
Dialogue: 0,1:23:09.10,1:23:11.36,Default,,0,0,0,,Менің ойымша, мен сізге сусын сатып алуым керек.
Dialogue: 0,1:23:11.44,1:23:12.94,Default,,0,0,0,,Осындай жас адамға?
Dialogue: 0,1:23:13.02,1:23:14.32,Default,,0,0,0,,Сіз маған көмектестіңіз.
Dialogue: 0,1:23:14.40,1:23:15.53,Default,,0,0,0,,Қандай керемет сәттілік!
Dialogue: 0,1:23:15.61,1:23:18.91,Default,,0,0,0,,Бианка Карлайлдан Спартан көпіріне репортаж!
Dialogue: 0,1:23:18.99,1:23:21.03,Default,,0,0,0,,Уф...
Dialogue: 0,1:23:21.12,1:23:24.33,Default,,0,0,0,,Гохо ха пе
Dialogue: 0,1:23:27.79,1:23:30.29,Default,,0,0,0,,Io! Жарайды ма?
Dialogue: 0,1:23:30.58,1:23:35.13,Default,,0,0,0,,Корнелий Сізде ұлпалар бар ма? Ол ластанған
Dialogue: 0,1:23:35.88,1:23:37.42,Default,,0,0,0,,Клаудия ше?
Dialogue: 0,1:23:37.76,1:23:41.59,Default,,0,0,0,,Оған дейін кемпірмен бір шаруам бар.
Dialogue: 0,1:23:50.27,1:23:54.44,Default,,0,0,0,,Мен Клаудияның Оңтүстік теңіз альянсында екенін білдім.
Dialogue: 0,1:23:55.36,1:23:57.11,Default,,0,0,0,,Оның бастамасынан -
Dialogue: 0,1:23:57.19,1:24:02.41,Default,,0,0,0,,Оңтүстік теңіз альянсының әскери операцияларының жедел басқаруы күшейтілді.
Dialogue: 0,1:24:03.16,1:24:06.70,Default,,0,0,0,,Мұндай әйелді сындыруға мүмкіндік болса...
Dialogue: 0,1:24:06.79,1:24:10.29,Default,,0,0,0,,Оны пайдаланғыңыз келетіні табиғи емес пе?
Dialogue: 0,1:24:10.54,1:24:12.21,Default,,0,0,0,,Мені ұр
Dialogue: 0,1:24:12.29,1:24:13.96,Default,,0,0,0,,Сонда сен мені көтеріп алдың ба?
Dialogue: 0,1:24:14.04,1:24:17.42,Default,,0,0,0,,Иә, бұл тек Флемингтер отбасының ақшасы емес.
Dialogue: 0,1:24:17.51,1:24:20.22,Default,,0,0,0,,Бұл әйел туралы жеткілікті.
Dialogue: 0,1:24:20.30,1:24:23.85,Default,,0,0,0,,«Мен өлім елінен қайтамын және әділ жолды ұстанамын».
Dialogue: 0,1:24:24.35,1:24:28.22,Default,,0,0,0,,Бұл жазбамен бірге сіздің бөлмеңізде қалдырылған.
Dialogue: 0,1:24:29.27,1:24:31.60,Default,,0,0,0,,Бұл хош иісті зат ұстағыш
Dialogue: 0,1:24:31.69,1:24:37.11,Default,,0,0,0,,Мен мұны мекемеден кетіп бара жатқан балаларға қоштасу сыйы ретінде бердім.
Dialogue: 0,1:24:37.44,1:24:38.86,Default,,0,0,0,,Нысан дегеніміз не?
Dialogue: 0,1:24:40.82,1:24:42.82,Default,,0,0,0,,Ньютайп ғылыми-зерттеу институты
Dialogue: 0,1:24:46.45,1:24:47.87,Default,,0,0,0,,Эй, міне, осы.
Dialogue: 0,1:24:48.41,1:24:51.87,Default,,0,0,0,,Бұрынғы Зеон ғылым академиясы Дж. Секстон
Dialogue: 0,1:24:52.17,1:24:53.50,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,1:24:53.92,1:24:55.88,Default,,0,0,0,,Ол Оңтүстік теңіз альянсына қосылды ма?
Dialogue: 0,1:24:55.96,1:25:00.51,Default,,0,0,0,,Психо Заку оларда жалғыз нәрсе емес еді.
Dialogue: 0,1:25:02.30,1:25:05.80,Default,,0,0,0,,Бала кезінен ұзақ оқудан кейін
Dialogue: 0,1:25:05.89,1:25:11.64,Default,,0,0,0,,Миы қатты зақымданған ол сене бастады.
Dialogue: 0,1:25:12.52,1:25:14.48,Default,,0,0,0,,Объектіден шыққаннан кейін ол...
Dialogue: 0,1:25:14.56,1:25:19.98,Default,,0,0,0,,Менің мекемемде күшейтілген арнайы психикалық күштерді пайдалану -
Dialogue: 0,1:25:20.61,1:25:24.24,Default,,0,0,0,,Сенушілерді бақылау
Dialogue: 0,1:25:32.58,1:25:33.96,Default,,0,0,0,,Ах
Dialogue: 0,1:25:37.50,1:25:41.46,Default,,0,0,0,,Дауыс...Мен діни қызметкердің дауысын естимін.
Dialogue: 0,1:25:42.42,1:25:48.56,Default,,0,0,0,,Мен өсірген, тастап кеткен шәкіртім
Dialogue: 0,1:25:50.52,1:25:53.94,Default,,0,0,0,,Реван Фу – жаңа тип.
Dialogue: 0,1:25:55.81,1:25:57.81,Default,,0,0,0,,♪~
Dialogue: 0,1:26:23.59,1:26:25.43,Default,,0,0,0,,♪ Сондай-ақ дыбыс деңгейі.
Dialogue: 0,1:26:25.97,1:26:30.18,Default,,0,0,0,,♪ Ырғақты жақсы тыңдамасаң жаман.
Dialogue: 0,1:26:30.81,1:26:35.39,Default,,0,0,0,,♪ Менің мінезім де, харизмам да жоқ сияқты.
Dialogue: 0,1:26:35.48,1:26:37.60,Default,,0,0,0,,♪ Әлі де
Dialogue: 0,1:26:37.98,1:26:41.07,Default,,0,0,0,,♪ Мен туралы көп нәрсе бар
Dialogue: 0,1:26:41.15,1:26:43.65,Default,,0,0,0,,♪ Өте шатастырған
Dialogue: 0,1:26:43.74,1:26:47.20,Default,,0,0,0,,♪ Дірілдеп тұр
Dialogue: 0,1:26:47.28,1:26:52.24,Default,,0,0,0,,♪ Сіз кімсіз? Балапан
Dialogue: 0,1:26:52.33,1:26:54.37,Default,,0,0,0,,♪ Бет де
Dialogue: 0,1:26:54.79,1:26:59.50,Default,,0,0,0,,♪ Бұл әсіресе жақсы сияқты емес.
Dialogue: 0,1:26:59.58,1:27:04.30,Default,,0,0,0,,♪ Мен сататын жалғыз нәрсе - оң қолымдағы татуировкасы.
Dialogue: 0,1:27:04.38,1:27:06.42,Default,,0,0,0,,♪ Бұл хаски.
Dialogue: 0,1:27:06.80,1:27:11.01,Default,,0,0,0,,♪ Менің достарым, қаншықтар да
Dialogue: 0,1:27:11.10,1:27:15.98,Default,,0,0,0,,♪ Шайқау және сулану
Dialogue: 0,1:27:16.06,1:27:20.90,Default,,0,0,0,,♪ Сенің атың кім? Балапан
Dialogue: 0,1:27:22.11,1:27:24.44,Default,,0,0,0,,♪ Сізге
Dialogue: 0,1:27:24.53,1:27:26.82,Default,,0,0,0,,♪ Қандай қорқынышты жара
Dialogue: 0,1:27:26.90,1:27:29.66,Default,,0,0,0,,♪ Мен оның бар-жоғын білмеймін.
Dialogue: 0,1:27:31.70,1:27:33.91,Default,,0,0,0,,♪ Мен
Dialogue: 0,1:27:33.99,1:27:35.62,Default,,0,0,0,,♪ Сол жара
Dialogue: 0,1:27:35.70,1:27:38.79,Default,,0,0,0,,♪ Мен саған жалап жіберемін.
Dialogue: 0,1:27:39.46,1:27:41.50,Default,,0,0,0,,♪ Мені сүй
Dialogue: 0,1:27:49.88,1:27:51.84,Default,,0,0,0,,♪ Гитара да.
Dialogue: 0,1:27:52.30,1:27:57.10,Default,,0,0,0,,♪ Мен Джими Хендрикске еліктей алмаймын.
Dialogue: 0,1:27:57.18,1:28:01.81,Default,,0,0,0,,♪ Әнді бір жерден естігенмін.
Dialogue: 0,1:28:01.90,1:28:03.98,Default,,0,0,0,,♪ Әлі де
Dialogue: 0,1:28:04.36,1:28:06.99,Default,,0,0,0,,♪ Осы тар дүкеннің ішінде
Dialogue: 0,1:28:07.07,1:28:09.86,Default,,0,0,0,,♪ Міндетті түрде шамамен 5 адам
Dialogue: 0,1:28:09.95,1:28:13.57,Default,,0,0,0,,♪ Сіз мені жынды қыласыз
Dialogue: 0,1:28:13.66,1:28:18.45,Default,,0,0,0,,♪ Не үшін? Балапан
Dialogue: 0,1:28:18.54,1:28:20.62,Default,,0,0,0,,♪ Мотоциклдер де.
Dialogue: 0,1:28:21.12,1:28:25.88,Default,,0,0,0,,♪ Екі есек айдағанның басы айналады.
Dialogue: 0,1:28:25.96,1:28:29.05,Default,,0,0,0,,♪ Мен де қисық сызықты жіберіп алдым.
Dialogue: 0,1:28:29.13,1:28:30.63,Default,,0,0,0,,♪ Хидейши
Dialogue: 0,1:28:30.72,1:28:32.64,Default,,0,0,0,,♪ Бірақ
Dialogue: 0,1:28:33.18,1:28:36.26,Default,,0,0,0,,♪ Таңертеңгі күн шыққан жерде
Dialogue: 0,1:28:36.35,1:28:42.44,Default,,0,0,0,,♪ Күліп отырып жыладым
Dialogue: 0,1:28:42.52,1:28:47.32,Default,,0,0,0,,♪ Кім үшін? Балапан
Dialogue: 0,1:28:57.95,1:29:00.41,Default,,0,0,0,,♪ Сізге
Dialogue: 0,1:29:00.50,1:29:02.83,Default,,0,0,0,,♪ Қандай қорқынышты жара
Dialogue: 0,1:29:02.92,1:29:05.67,Default,,0,0,0,,♪ Мен оның бар-жоғын білмеймін.
Dialogue: 0,1:29:07.67,1:29:09.92,Default,,0,0,0,,♪ Мен
Dialogue: 0,1:29:10.01,1:29:11.63,Default,,0,0,0,,♪ Сол жара
Dialogue: 0,1:29:11.72,1:29:14.89,Default,,0,0,0,,♪ Мен саған жалап жіберемін.
Dialogue: 0,1:29:15.47,1:29:17.51,Default,,0,0,0,,♪ Мені сүй
Dialogue: 0,1:29:32.82,1:29:34.82,Default,,0,0,0,,~♪
Dialogue: 0,1:29:36.32,1:29:42.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory