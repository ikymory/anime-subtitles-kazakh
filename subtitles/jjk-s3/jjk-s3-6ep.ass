Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:35.23,0:00:37.67,Default,,0,0,0,,Aaasum haa➡
Dialogue: 0,0:00:37.67,0:00:41.34,Default,,0,0,0,,Бүгін неше сағат жұмыс істедіңіз?
Dialogue: 0,0:00:41.34,0:00:46.07,Default,,0,0,0,,Таңертеңнен бері ештеңе жеген жоқпын, қарным ашты...➡
Dialogue: 0,0:00:46.07,0:00:49.08,Default,,0,0,0,,Хаа, үйге келгенде не жеуім керек?➡
Dialogue: 0,0:00:50.91,0:00:53.78,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:00:53.78,0:00:57.25,Default,,0,0,0,,Сооооооо. ➡
Dialogue: 0,0:00:57.25,0:00:59.72,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:59.72,0:01:03.03,Default,,0,0,0,,Иә, бірақ мен үлкенірек жақсырақ дедім, солай ма? ➡
Dialogue: 0,0:01:03.03,0:01:06.46,Default,,0,0,0,,Соғыссын десең, ауыр болғаны дұрыс➡
Dialogue: 0,0:01:06.46,0:01:10.27,Default,,0,0,0,,А, мен оны іздеп, сізге қайта қоңырау шаламын. Иә. ➡
Dialogue: 0,0:01:10.27,0:01:13.37,Default,,0,0,0,,Хмм? Жоқ, қайда бардың? ➡
Dialogue: 0,0:01:13.37,0:01:16.94,Default,,0,0,0,,Цк, не деген әурешілік. Бұл әжетхана ма? ➡
Dialogue: 0,0:01:16.94,0:01:19.04,Default,,0,0,0,,Аһ!
Dialogue: 0,0:01:21.48,0:01:23.71,Default,,0,0,0,,Ой.
Dialogue: 0,0:01:23.71,0:01:26.95,Default,,0,0,0,,Әй, қарашы. (Байқау) А?
Dialogue: 0,0:01:26.95,0:01:29.42,Default,,0,0,0,,Джонисо жеймін бе деп ойлаймын. Capi.
Dialogue: 0,0:01:29.42,0:01:31.59,Default,,0,0,0,,Жоқ, ол турнирде болды.
Dialogue: 0,0:01:31.59,0:01:34.26,Default,,0,0,0,,Capi. (Байқау) Қараңызшы, бұл Джонисо, солай емес пе? ➡
Dialogue: 0,0:01:34.26,0:01:36.69,Default,,0,0,0,,Бұл дәмді емес пе? Апыр-ай. Мінеки біз! ➡
Dialogue: 0,0:01:36.69,0:01:38.79,Default,,0,0,0,,Мен Джонисо аламын.
Dialogue: 0,0:01:41.26,0:01:44.63,Default,,0,0,0,,Апаттық баспалдақта камералар жоқ! ➡
Dialogue: 0,0:01:44.63,0:01:47.17,Default,,0,0,0,,Йо.
Dialogue: 0,0:01:47.17,0:01:50.57,Default,,0,0,0,,Панда-сенпай, шынымен жақсысың ба?
Dialogue: 0,0:01:50.57,0:01:53.28,Default,,0,0,0,,Бұл кейінірек шағымдануыма себеп болды...
Dialogue: 0,0:01:53.28,0:01:55.41,Default,,0,0,0,,Daijob Daijob~. ➡
Dialogue: 0,0:01:55.41,0:01:57.65,Default,,0,0,0,,Тез есікті бекітіп алайық.
Dialogue: 0,0:01:57.65,0:02:06.05,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:08.39,0:02:12.19,Default,,0,0,0,,Гэез… Кирара…. Таразымен бірдей емес пе еді?
Dialogue: 0,0:02:13.80,0:02:15.93,Default,,0,0,0,,Панда-чан⁉
Dialogue: 0,0:02:15.93,0:02:19.63,Default,,0,0,0,,≪Ал тікенек бала…. ➡
Dialogue: 0,0:02:19.63,0:02:22.34,Default,,0,0,0,,Сонымен, сіз Панда-чанның нұсқауымен басып кірдіңіз➡
Dialogue: 0,0:02:22.34,0:02:24.37,Default,,0,0,0,,Техникалық колледждердегі адамдар…. ➡
Dialogue: 0,0:02:24.37,0:02:28.91,Default,,0,0,0,,Сонымен Ю-чан да техникалық колледж студенті... ➡
Dialogue: 0,0:02:28.91,0:02:32.01,Default,,0,0,0,,Кин-чанға қауіп төніп тұр...≫
Dialogue: 0,0:02:32.01,0:02:33.98,Default,,0,0,0,,Домото: Менде кеңес бар...
Dialogue: 0,0:02:33.98,0:02:38.19,Default,,0,0,0,,🖁
Dialogue: 0,0:02:38.19,0:02:40.66,Default,,0,0,0,,«Ғұн» нефрит ит! ! !
Dialogue: 0,0:02:40.66,0:02:42.66,Default,,0,0,0,,Хирари!
Dialogue: 0,0:02:44.06,0:02:46.06,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:02:48.00,0:02:50.10,Default,,0,0,0,,Ха Фушигуро⁉
Dialogue: 0,0:02:51.47,0:02:54.40,Default,,0,0,0,,Гах!!
Dialogue: 0,0:02:56.77,0:02:59.71,Default,,0,0,0,,≪Жоқ, Панда-сенпайдың айтқанына қарағанда➡
Dialogue: 0,0:02:59.71,0:03:02.54,Default,,0,0,0,,Жақындай алмадың ба? ≫
Dialogue: 0,0:03:02.54,0:03:04.65,Default,,0,0,0,,О? иә?
Dialogue: 0,0:03:04.65,0:03:07.08,Default,,0,0,0,,≪Panda-chan әлдеқашан белгіленген≫
Dialogue: 0,0:03:07.08,0:03:11.99,Default,,0,0,0,,Иә. Ха ха ха ха ха….
Dialogue: 0,0:03:11.99,0:03:15.89,Default,,0,0,0,,≪Бөлмеде... Таразыға қайта оралуды жоспарлап отырсыз ба? ≫
Dialogue: 0,0:03:15.89,0:03:18.79,Default,,0,0,0,,Тоқта, Кира, біз жау емеспіз!! ➡
Dialogue: 0,0:03:18.79,0:03:21.03,Default,,0,0,0,,Таразыдан сұрайын дегенім бар!!
Dialogue: 0,0:03:21.03,0:03:24.43,Default,,0,0,0,,Мен сенбеймін!! Мен оны сағындым, панда!
Dialogue: 0,0:03:24.43,0:03:28.57,Default,,0,0,0,,Күлсін, ау, мынау мен де жақындай алмаймын.
Dialogue: 0,0:03:28.57,0:03:30.57,Default,,0,0,0,,Хаха хаа идея! Tsk.
Dialogue: 0,0:03:31.97,0:03:34.74,Default,,0,0,0,,≪Жақындай алмаған Кира-санға да солай ма...≫
Dialogue: 0,0:03:34.74,0:03:37.61,Default,,0,0,0,,Уф!! Фушигуро⁉
Dialogue: 0,0:03:37.61,0:03:40.25,Default,,0,0,0,,≪Мен Кирара-санға жақындай алмағаным ғана емес...➡
Dialogue: 0,0:03:40.25,0:03:44.39,Default,,0,0,0,,Мен Jade Dog-тен кете алмаймын⁉ Бұл қандай техника?≫
Dialogue: 0,0:03:44.39,0:03:46.49,Default,,0,0,0,,Арх! Тыңдаңыз!!
Dialogue: 0,0:03:46.49,0:03:49.89,Default,,0,0,0,,Мүмкін емес. Өйткені суық!!
Dialogue: 0,0:03:51.23,0:03:55.93,Default,,0,0,0,,♬ МЕНІ СҮЙІП, ЖЕК КӨРЕДІ
Dialogue: 0,0:03:55.93,0:04:00.24,Default,,0,0,0,,♬ LUV ME ӨЛТІР
Dialogue: 0,0:04:02.50,0:04:05.07,Default,,0,0,0,,♬ Сүйіспеншілік, жек көру, сүйіспеншілік, жек көру
Dialogue: 0,0:04:05.07,0:04:07.58,Default,,0,0,0,,♬ Дай Токио Рюусо Ута
Dialogue: 0,0:04:07.58,0:04:09.98,Default,,0,0,0,,♬ Маваримавари дәуірінде
Dialogue: 0,0:04:09.98,0:04:12.65,Default,,0,0,0,,♬ Ұятқа малынған
Dialogue: 0,0:04:12.65,0:04:15.22,Default,,0,0,0,,♬ Сүйіспеншілік, жек көру, жақсы көру және жек көру
Dialogue: 0,0:04:15.22,0:04:17.55,Default,,0,0,0,,♬ Кеттік, үлкен әңгіме сияқты
Dialogue: 0,0:04:17.55,0:04:20.06,Default,,0,0,0,,♬ Екеуміз айырылысып қаламыз
Dialogue: 0,0:04:20.06,0:04:23.16,Default,,0,0,0,,♬ Олай болса тағы кездесейік.
Dialogue: 0,0:04:25.13,0:04:27.50,Default,,0,0,0,,♬ Драмаға батып кету
Dialogue: 0,0:04:27.50,0:04:29.97,Default,,0,0,0,,♬ Толық еместігімді мойында
Dialogue: 0,0:04:29.97,0:04:32.10,Default,,0,0,0,,♬ Босаңсытатын көркем әдебиет
Dialogue: 0,0:04:32.10,0:04:35.00,Default,,0,0,0,,♬ Өтірік пен шындық арасындағы диссонанс
Dialogue: 0,0:04:35.00,0:04:37.51,Default,,0,0,0,,♬ Махаббатым толық болмаса да кешірші
Dialogue: 0,0:04:37.51,0:04:39.88,Default,,0,0,0,,♬ Мәселе жоқ! Осы кезеңнен аман өтіңіз
Dialogue: 0,0:04:39.88,0:04:42.18,Default,,0,0,0,,♬ Тістеген ит жауынгер қалтырап
Dialogue: 0,0:04:42.18,0:04:45.41,Default,,0,0,0,,♬ Есейе берсең, ересек бола алмайсың
Dialogue: 0,0:04:45.41,0:04:47.82,Default,,0,0,0,,♬ LUV ME Тек әділдік
Dialogue: 0,0:04:47.82,0:04:50.45,Default,,0,0,0,,♬ ЖЕК КӨРСІЗ Бәрін алып кетіңіз
Dialogue: 0,0:04:50.45,0:04:53.02,Default,,0,0,0,,♬ LUV ME Махаббат пен жек көрушілікке толы
Dialogue: 0,0:04:53.02,0:04:57.89,Default,,0,0,0,,♬ ӨЛТІР мені бұл жерден алып кет
Dialogue: 0,0:04:57.89,0:05:00.53,Default,,0,0,0,,♬ Сүй, жек көр, сүй, жек көр, құшақтас
Dialogue: 0,0:05:00.53,0:05:02.90,Default,,0,0,0,,♬ Қай уақытта болса да шарықтау шегі
Dialogue: 0,0:05:02.90,0:05:05.43,Default,,0,0,0,,♬ Алдап-арбау да, алдау да дұрыс.
Dialogue: 0,0:05:05.43,0:05:08.34,Default,,0,0,0,,♬ Маған баға маңызды емес
Dialogue: 0,0:05:08.34,0:05:10.74,Default,,0,0,0,,♬ Ғашық, өшпенділік, сүйіспеншілік, жек көрушілікпен кезіп
Dialogue: 0,0:05:10.74,0:05:13.11,Default,,0,0,0,,♬ Дипломатиялық сүйкімділік себіңіз
Dialogue: 0,0:05:13.11,0:05:15.58,Default,,0,0,0,,♬ Бәрі сұрақ-жауапсыз аяқталады.
Dialogue: 0,0:05:15.58,0:05:19.08,Default,,0,0,0,,♬ Олай болса тағы кездесейік.
Dialogue: 0,0:05:21.75,0:05:28.59,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:28.59,0:05:31.69,Default,,0,0,0,,≪Тұйық!! Дұрыс...≫
Dialogue: 0,0:05:31.69,0:05:36.00,Default,,0,0,0,,Кира-сан!! Біз дәл қазір техникалық колледж жағында емеспіз!
Dialogue: 0,0:05:36.00,0:05:39.30,Default,,0,0,0,,Дәл қазір Токиода не болып жатқанын білесіз бе?
Dialogue: 0,0:05:39.30,0:05:41.34,Default,,0,0,0,,Хмм….
Dialogue: 0,0:05:41.34,0:05:44.67,Default,,0,0,0,,Әртүрлі жерлерде кездесетін кедергілер бір-бірімен байланысты емес.
Dialogue: 0,0:05:44.67,0:05:47.21,Default,,0,0,0,,Бұрын-соңды болмаған сиқырлы теракт болды!!
Dialogue: 0,0:05:47.21,0:05:49.81,Default,,0,0,0,,Бізге Скайл мырзаның ынтымақтастығы қажет!!
Dialogue: 0,0:05:49.81,0:05:52.25,Default,,0,0,0,,Бізді бірінші рет сол кісі басты.
Dialogue: 0,0:05:52.25,0:05:54.28,Default,,0,0,0,,Оған өзің кінәлісің, солай ма?
Dialogue: 0,0:05:54.28,0:05:56.79,Default,,0,0,0,,Бұл техникалық колледж жағы емес...
Dialogue: 0,0:05:56.79,0:05:58.82,Default,,0,0,0,,Жоғарыда не болды?
Dialogue: 0,0:05:58.82,0:06:00.86,Default,,0,0,0,,Мен консерваторлармен қиындыққа тап болдым. ➡
Dialogue: 0,0:06:00.86,0:06:02.96,Default,,0,0,0,,Сонымен, консерваторлар «консервативті» дегенді білдіреді?
Dialogue: 0,0:06:02.96,0:06:06.26,Default,,0,0,0,,Бұл тек ережелерге қатысты ұстаным туралы емес➡
Dialogue: 0,0:06:06.26,0:06:10.17,Default,,0,0,0,,«Сиқыр деген осындай болуы керек» деген ой бар. ➡
Dialogue: 0,0:06:10.17,0:06:13.13,Default,,0,0,0,,Кугисакидің техникасын түсіну оңай➡
Dialogue: 0,0:06:13.13,0:06:16.87,Default,,0,0,0,,Бұл консерваторларға ұнайтын сиқырдың бір түрі. ➡
Dialogue: 0,0:06:16.87,0:06:19.51,Default,,0,0,0,,Бұрыннан танымал болған «қарғыс атқан бейнелер» сияқты нәрсе➡
Dialogue: 0,0:06:19.51,0:06:23.41,Default,,0,0,0,,Уақыт өте келе сиқырдың өзі жаңа технологиямен астасып кетуі мүмкін. ➡
Dialogue: 0,0:06:23.41,0:06:28.22,Default,,0,0,0,,Бұл хирургиялық процедураларға қатысты болғанда, консерваторлар қатты ашуланады.
Dialogue: 0,0:06:28.22,0:06:31.39,Default,,0,0,0,,Кин-чанның әдістемесі соның типтік мысалы.
Dialogue: 0,0:06:31.39,0:06:34.36,Default,,0,0,0,,Жоғарыдағы әлгі ақымақтар, сондықтан ұтыла алмайсың.
Dialogue: 0,0:06:34.36,0:06:37.19,Default,,0,0,0,,Бірақ балалар, Сатору Годжо➡ қалағаныңды істей аласың
Dialogue: 0,0:06:37.19,0:06:41.80,Default,,0,0,0,,Менің есегімді сүрте аласыз ба? Бізге арқа сүйеу дегенді түсінбеймін. ➡
Dialogue: 0,0:06:41.80,0:06:44.87,Default,,0,0,0,,Сонымен сұрағаныңыз өтірік болды➡
Dialogue: 0,0:06:44.87,0:06:49.07,Default,,0,0,0,,Басқа мақсат бар деп ойлау қалыпты жағдай емес пе?
Dialogue: 0,0:06:49.07,0:06:51.74,Default,,0,0,0,,Годжо мырза мөрленді.
Dialogue: 0,0:06:51.74,0:06:53.78,Default,,0,0,0,,Сондықтан мен жеңілдім.
Dialogue: 0,0:06:53.78,0:07:05.42,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:05.42,0:07:07.46,Default,,0,0,0,,≪Ah～～～～➡
Dialogue: 0,0:07:07.46,0:07:09.79,Default,,0,0,0,,Мен сенбеймін!! ≫ ≪Мен сенбеймін...≫
Dialogue: 0,0:07:09.79,0:07:12.36,Default,,0,0,0,,≪Жақсы, мен сіздің сезіміңізді түсінемін≫
Dialogue: 0,0:07:12.36,0:07:16.43,Default,,0,0,0,,≪Бірақ бұл адам Скалес мырзаға ең жақын адам≫
Dialogue: 0,0:07:16.43,0:07:18.87,Default,,0,0,0,,«Қоян»!!
Dialogue: 0,0:07:18.87,0:07:21.84,Default,,0,0,0,,Қоян…. ≪Осы адамды сендіре алсаңыз➡
Dialogue: 0,0:07:21.84,0:07:25.34,Default,,0,0,0,,Скайл мырзамен келіссөздер қиындықсыз өтуде...≫
Dialogue: 0,0:07:25.34,0:07:27.61,Default,,0,0,0,,Сооооо.
Dialogue: 0,0:07:27.61,0:07:29.71,Default,,0,0,0,,≪Acrux⁉≫
Dialogue: 0,0:07:31.38,0:07:33.78,Default,,0,0,0,,≪Gaklux...≫
Dialogue: 0,0:07:33.78,0:07:37.42,Default,,0,0,0,,≪Бұл өте үлкен сома... Маған қызық, бұл не туралы...➡
Dialogue: 0,0:07:37.42,0:07:41.06,Default,,0,0,0,,Өйткені менің техникам сиқырлы күшті белгілейді➡
Dialogue: 0,0:07:41.06,0:07:44.39,Default,,0,0,0,,Шикигамиге сиқыршылар сияқты қарайды. ➡
Dialogue: 0,0:07:44.39,0:07:46.63,Default,,0,0,0,,Бұлай жалғаса берсе, мен бұрынғы иттей боламын➡
Dialogue: 0,0:07:46.63,0:07:51.00,Default,,0,0,0,,Мені өзіме тартатын шикигами езіп, тұншықтырамын≫
Dialogue: 0,0:07:51.00,0:08:02.38,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:02.38,0:08:05.18,Default,,0,0,0,,Панда Сенпай!! «Қоян» қалай болды?
Dialogue: 0,0:08:05.18,0:08:07.28,Default,,0,0,0,,Менен кейінгі ең сүйкімді нәрсе болды!!
Dialogue: 0,0:08:07.28,0:08:09.58,Default,,0,0,0,,Неге жақындап, нені жақындатпады?➡
Dialogue: 0,0:08:09.58,0:08:12.19,Default,,0,0,0,,Мен тыңдаймын!! а!
Dialogue: 0,0:08:12.19,0:08:15.32,Default,,0,0,0,,Сіз екеуміз екінші қабатқа еш қиындықсыз шыға алдық!
Dialogue: 0,0:08:15.32,0:08:18.59,Default,,0,0,0,,Кирара мен монитор бөлмесінің есігі жарамсыз!!
Dialogue: 0,0:08:18.59,0:08:20.73,Default,,0,0,0,,Панда Сенпайдың денесінің бір жері➡
Dialogue: 0,0:08:20.73,0:08:23.33,Default,,0,0,0,,Оның ★ белгісі мен аты жоқ па?
Dialogue: 0,0:08:23.33,0:08:25.60,Default,,0,0,0,,Е... Ах⁉➡
Dialogue: 0,0:08:25.60,0:08:27.84,Default,,0,0,0,,I… MAI….
Dialogue: 0,0:08:27.84,0:08:30.17,Default,,0,0,0,,≪Мен де бір жердемін...≫ Қазір, қазір, қазір?
Dialogue: 0,0:08:30.17,0:08:32.21,Default,,0,0,0,,болды. Онда Имай деп жазылған!!
Dialogue: 0,0:08:32.21,0:08:34.51,Default,,0,0,0,,≪Acrux қоянды алып тастаумен бірдей!! ≫
Dialogue: 0,0:08:34.51,0:08:37.11,Default,,0,0,0,,≪Менің ойымша, Jade Dog-те де бар≫
Dialogue: 0,0:08:37.11,0:08:40.12,Default,,0,0,0,,≪Мен әлі ештеңе түсінбеймін, бірақ мұнда...≫
Dialogue: 0,0:08:41.52,0:08:45.45,Default,,0,0,0,,Түсінікті!! Бұл техниканың тұқымдары - шоқжұлдыздар!
Dialogue: 0,0:08:45.45,0:08:48.16,Default,,0,0,0,,≪Оған дейін түсінгендер түсінеді≫
Dialogue: 0,0:08:48.16,0:08:50.19,Default,,0,0,0,,Мотивтің шоқжұлдызы - бұл...
Dialogue: 0,0:08:50.19,0:08:54.60,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:08:54.60,0:08:56.63,Default,,0,0,0,,«Оңтүстік крест».
Dialogue: 0,0:08:56.63,0:09:01.37,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:09:01.37,0:09:03.41,Default,,0,0,0,,Қақпа!!
Dialogue: 0,0:09:03.41,0:09:05.51,Default,,0,0,0,,≪Менің бетімде пайда болды!! Бір-біріне…≫
Dialogue: 0,0:09:05.51,0:09:08.34,Default,,0,0,0,,≪Мен ``Сіз байсалдысыз ба?''≫ түрін жасадым
Dialogue: 0,0:09:08.34,0:09:10.78,Default,,0,0,0,,≪Менің техникамның мотиві - Оңтүстік крест➡
Dialogue: 0,0:09:10.78,0:09:12.81,Default,,0,0,0,,Мен сенімді емес едім! ≫
Dialogue: 0,0:09:12.81,0:09:15.42,Default,,0,0,0,,≪Бірақ мен де ``Сіз байсалдысыз ба?'' ≫ түрін жасадым.
Dialogue: 0,0:09:15.42,0:09:17.75,Default,,0,0,0,,≪Мен сізге сенімділік бердім!! ≫
Dialogue: 0,0:09:17.75,0:09:19.95,Default,,0,0,0,,≪Егер техниканы сол күйінде анықтай алсаңыз➡
Dialogue: 0,0:09:19.95,0:09:22.42,Default,,0,0,0,,Бөлмеге кіріңіз. ➡
Dialogue: 0,0:09:22.42,0:09:24.63,Default,,0,0,0,,Осы жерден тоқтаңыз!! ≫
Dialogue: 0,0:09:24.63,0:09:26.63,Default,,0,0,0,,>
Dialogue: 0,0:09:29.03,0:09:32.53,Default,,0,0,0,,≪Бірақ бұл шынымен де Оңтүстік крест болды≫
Dialogue: 0,0:09:32.53,0:09:34.77,Default,,0,0,0,,≪Рахмет, Цумики≫
Dialogue: 0,0:09:34.77,0:09:36.81,Default,,0,0,0,,≪Бірақ мен артық ештеңе білмеймін...➡
Dialogue: 0,0:09:36.81,0:09:39.81,Default,,0,0,0,,4 Оңтүстік Крест шоқжұлдыздары бар емес пе? ≫
Dialogue: 0,0:09:39.81,0:09:41.98,Default,,0,0,0,,Фушигуро~.
Dialogue: 0,0:09:41.98,0:09:45.21,Default,,0,0,0,,≪Ақыр соңында мен Панда-сенпайға жақындай аламын≫
Dialogue: 0,0:09:45.21,0:09:49.05,Default,,0,0,0,,Сенпай, Оңтүстік крестте 4 жұлдыз бар, солай ма?
Dialogue: 0,0:09:49.05,0:09:51.92,Default,,0,0,0,,Е... бұл крест...
Dialogue: 0,0:09:51.92,0:09:53.92,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:58.89,0:10:03.47,Default,,0,0,0,,Кира-санның техникасы әр адамға Оңтүстік Крест жұлдыздарын бөлу➡
Dialogue: 0,0:10:03.47,0:10:06.73,Default,,0,0,0,,Мен бұл тиісті қашықтықты сақтаудың жолы деп ойладым.
Dialogue: 0,0:10:06.73,0:10:09.67,Default,,0,0,0,,Бірақ Кира-сан мені есікке жақындатады➡
Dialogue: 0,0:10:09.67,0:10:12.34,Default,,0,0,0,,Панда-сенпай екеуміз жақындайық.
Dialogue: 0,0:10:12.34,0:10:15.81,Default,,0,0,0,,Жай ғана біздің жұлдыз Кира және есік жұлдызы➡
Dialogue: 0,0:10:15.81,0:10:18.18,Default,,0,0,0,,Бұл жиіркенішті сияқты.
Dialogue: 0,0:10:18.18,0:10:20.22,Default,,0,0,0,,Содан кейін Кирара-сан➡
Dialogue: 0,0:10:20.22,0:10:23.08,Default,,0,0,0,,Қазір бөлмеңе жүгірмеу біртүрлі.
Dialogue: 0,0:10:23.08,0:10:28.42,Default,,0,0,0,,Ах соқа. Ішіндегі есікке жабысып қалса, кептеліп қалады. ➡
Dialogue: 0,0:10:28.42,0:10:30.89,Default,,0,0,0,,Сонымен, мұндай нәрсе туралы не деуге болады? ➡
Dialogue: 0,0:10:30.89,0:10:34.36,Default,,0,0,0,,Белгілі бір А жұлдызын басқа В жұлдызына жақындатуға болады➡
Dialogue: 0,0:10:34.36,0:10:36.43,Default,,0,0,0,,А-ға В-дан жақындауға болмайды. ➡
Dialogue: 0,0:10:36.43,0:10:39.83,Default,,0,0,0,,Осы сияқты әр жұлдыздың үйлесімділігі бар➡
Dialogue: 0,0:10:39.83,0:10:44.17,Default,,0,0,0,,Сізді тек өзіңізбен үйлесімді жұлдыздарға жақындататын тас, қағаз, қайшы теориясы.
Dialogue: 0,0:10:44.17,0:10:46.34,Default,,0,0,0,,Бірақ мен және Панда-сенпай➡
Dialogue: 0,0:10:46.34,0:10:49.74,Default,,0,0,0,,Олар жақындаса да, екеуі де еркін қозғала алады.
Dialogue: 0,0:10:49.74,0:10:51.75,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:10:53.15,0:10:56.15,Default,,0,0,0,,Белгіленген маршруты бар маркалы митинг сияқты➡
Dialogue: 0,0:10:56.15,0:10:59.69,Default,,0,0,0,,Менің ойымша, олардың әрқайсысына жақындауға болатын тәртіп бар.
Dialogue: 0,0:10:59.69,0:11:02.19,Default,,0,0,0,,Сонда бірдей жұлдыздар бір-біріне жабысады.
Dialogue: 0,0:11:03.53,0:11:08.13,Default,,0,0,0,,Мен көремін. Бірақ практиктің өзі техникаға бағынбауы мүмкін емес пе?
Dialogue: 0,0:11:08.13,0:11:12.97,Default,,0,0,0,,Бұл дұрыс емес. Оны да Тама-инудан алыс ұстаған.
Dialogue: 0,0:11:12.97,0:11:17.37,Default,,0,0,0,,Енді Кира-сан, біз кейбір шарттарды орындаймыз➡
Dialogue: 0,0:11:17.37,0:11:19.57,Default,,0,0,0,,Көрінбейтін➡
Dialogue: 0,0:11:19.57,0:11:22.88,Default,,0,0,0,,Мен бөлмеме біреу кіріп кетеді деп қорқамын. Егер бұл
Dialogue: 0,0:11:22.88,0:11:27.42,Default,,0,0,0,,болса, онда ол 5 жұлдыздан көп. иә.
Dialogue: 0,0:11:27.42,0:11:30.18,Default,,0,0,0,,Марка ралли теориясын дұрыс деп есептейміз➡
Dialogue: 0,0:11:30.18,0:11:32.49,Default,,0,0,0,,4 жұлдыз болса, мен немесе Панда Сенпай➡
Dialogue: 0,0:11:32.49,0:11:34.99,Default,,0,0,0,,Мен Кирара-санға жақындай алуым керек➡
Dialogue: 0,0:11:34.99,0:11:37.19,Default,,0,0,0,,Арасында бесінші жұлдыз бар➡
Dialogue: 0,0:11:37.19,0:11:41.06,Default,,0,0,0,,Ол жерден өтпесеңіз, Кирара-сан мен есікке жақындай алмайсыз.
Dialogue: 0,0:11:41.06,0:11:43.46,Default,,0,0,0,,Егер сізде 6 немесе 7 болса, не істер едіңіз?
Dialogue: 0,0:11:43.46,0:11:46.30,Default,,0,0,0,,Мен ондай нәрсе жоқ деп сенгім келеді.
Dialogue: 0,0:11:46.30,0:11:48.84,Default,,0,0,0,,Кресттегі 5-тің мағынасын түсінбесем де.
Dialogue: 0,0:11:48.84,0:11:51.04,Default,,0,0,0,,≪Егер сіз білсеңіз≫ Ха!
Dialogue: 0,0:11:51.04,0:11:53.71,Default,,0,0,0,,<<Сен шабуыл жасайсың!! ≫
Dialogue: 0,0:11:53.71,0:11:56.51,Default,,0,0,0,,Дыбыстық сигнал… (көлік қауіпсіздігі дабылы)
Dialogue: 0,0:11:56.51,0:11:59.51,Default,,0,0,0,,Бум!
Dialogue: 0,0:11:59.51,0:12:01.82,Default,,0,0,0,,№. Панда Сенпай!!
Dialogue: 0,0:12:03.82,0:12:06.55,Default,,0,0,0,,Жарайды! проблема жоқ! ➡
Dialogue: 0,0:12:06.55,0:12:09.76,Default,,0,0,0,,Фушигуро!! ★ табыңыз!! ➡
Dialogue: 0,0:12:11.23,0:12:13.56,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:13.56,0:12:16.76,Default,,0,0,0,,Ах! Оны лақтырмаңыз! иә?
Dialogue: 0,0:12:18.70,0:12:20.74,Default,,0,0,0,,Құдай! Дого!
Dialogue: 0,0:12:20.74,0:12:23.71,Default,,0,0,0,,Мен ағам сияқты көлігіме арнайы ★ қойдым!
Dialogue: 0,0:12:23.71,0:12:26.27,Default,,0,0,0,,Мен нефрит ит екеуіміз лақтырсам да қайтып оралады?
Dialogue: 0,0:12:26.27,0:12:28.31,Default,,0,0,0,,Сіз тартыласыз!!
Dialogue: 0,0:12:28.31,0:12:31.88,Default,,0,0,0,,≪★ қосу үшін нысанды түрту керек болуы мүмкін≫
Dialogue: 0,0:12:31.88,0:12:35.88,Default,,0,0,0,,≪Бірақ маған да, қоянға да Кирара тиген жоқ...≫
Dialogue: 0,0:12:35.88,0:12:39.35,Default,,0,0,0,,≪Тек нефрит итке ғана тиді. Басқаша айтқанда, Кирара-сан➡
Dialogue: 0,0:12:39.35,0:12:41.92,Default,,0,0,0,,Мен затқа емес, сиқырлы күшке ★ қойдым!! ≫
Dialogue: 0,0:12:41.92,0:12:44.56,Default,,0,0,0,,≪Есік және көлік➡ сияқты нәрселерге ★ қосу үшін
Dialogue: 0,0:12:44.56,0:12:46.59,Default,,0,0,0,,Біреудің сиқырлы күші алдын ала➡
Dialogue: 0,0:12:46.59,0:12:48.63,Default,,0,0,0,,Менің аузымды жабу керек шығар...≫
Dialogue: 0,0:12:48.63,0:12:52.70,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:52.70,0:12:54.97,Default,,0,0,0,,≪Күтілгендей!! ≫
Dialogue: 0,0:12:54.97,0:12:58.17,Default,,0,0,0,,≪Машинадан Кирарадан басқа сиқырлы күш қалды!! ≫
Dialogue: 0,0:12:58.17,0:13:02.68,Default,,0,0,0,,≪Техниканың ауқымы кең болмаса, басқа ★ қалдық...≫
Dialogue: 0,0:13:02.68,0:13:07.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:08.52,0:13:10.99,Default,,0,0,0,,Ах. мылтық!
Dialogue: 0,0:13:10.99,0:13:12.99,Default,,0,0,0,,Ол меннен қанша есе мықты. (Очако) Ах…
Dialogue: 0,0:13:14.39,0:13:17.53,Default,,0,0,0,,<<Болды!! Бесінші ★!! ≫
Dialogue: 0,0:13:17.53,0:13:20.93,Default,,0,0,0,,≪Мен енді үшеумізден басқа сүйек таба алмаймын.≫
Dialogue: 0,0:13:20.93,0:13:24.17,Default,,0,0,0,,≪Кира-сан өзінің сиқырлы күшіне➡ ★ қосып қойған
Dialogue: 0,0:13:24.17,0:13:27.20,Default,,0,0,0,,Заттарға мен сияқты Acrux жұлдызын қою үшін➡
Dialogue: 0,0:13:27.20,0:13:29.24,Default,,0,0,0,,Өйткені сіз өзіңіздің сиқырлы күшіңізді пайдалана алмайсыз➡
Dialogue: 0,0:13:29.24,0:13:33.31,Default,,0,0,0,,Бұрынғы көлік сияқты, мен заттарды ұша алмаймын!! ≫
Dialogue: 0,0:13:33.31,0:13:35.34,Default,,0,0,0,,Иә! ≪Егер сіз оны түртсеңіз➡
Dialogue: 0,0:13:35.34,0:13:38.38,Default,,0,0,0,,Кира-санға жақындаңыз≫
Dialogue: 0,0:13:41.75,0:13:46.82,Default,,0,0,0,,<Кираның «Жұлдыздар аралық ұшу» техникасы мотив ретінде Оңтүстік крестті пайдаланады➡
Dialogue: 0,0:13:46.82,0:13:51.63,Default,,0,0,0,,Нысананың қарғыс күшіне 5 жұлдызды бөлу＞
Dialogue: 0,0:13:51.63,0:13:54.36,Default,,0,0,0,,<★ басқа ★➡-ге жақындау үшін
Dialogue: 0,0:13:54.36,0:13:57.13,Default,,0,0,0,,Белгіленген тәртіпті сақтау керек➡
Dialogue: 0,0:13:57.13,0:14:01.80,Default,,0,0,0,,Бірдей ★ бір-біріне тартылады＞
Dialogue: 0,0:14:01.80,0:14:06.61,Default,,0,0,0,,Сіз кереметсіз. Шынымды айтсам, сіз менің техникамды білесіз.
Dialogue: 0,0:14:06.61,0:14:09.61,Default,,0,0,0,,Панда-сенпай! Ахх.
Dialogue: 0,0:14:09.61,0:14:11.71,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:13.51,0:14:16.32,Default,,0,0,0,,Ммм!
Dialogue: 0,0:14:16.32,0:14:20.39,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:14:20.39,0:14:22.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:25.96,0:14:28.00,Default,,0,0,0,,<Тегіс болып көрінетін шоқжұлдыздар үшін➡
Dialogue: 0,0:14:28.00,0:14:30.03,Default,,0,0,0,,Әрине тереңдік бар➡
Dialogue: 0,0:14:30.03,0:14:33.53,Default,,0,0,0,,Жерден қашықтығы әртүрлі＞
Dialogue: 0,0:14:33.53,0:14:35.57,Default,,0,0,0,,Бірақ сіз өте түсініктісіз➡
Dialogue: 0,0:14:35.57,0:14:38.64,Default,,0,0,0,,Сіз бұдан былай заттарды ұшып жібере алмайсыз деп шешкен жоқсыз ба?
Dialogue: 0,0:14:38.64,0:14:42.41,Default,,0,0,0,,Менің заклинамасыма тіркелді★ Гвинаны алып тастаңыз➡
Dialogue: 0,0:14:42.41,0:14:45.98,Default,,0,0,0,,Сізге тек өзіңіз сияқты Acrux жұлдызын қосу жеткілікті.
Dialogue: 0,0:14:45.98,0:14:52.12,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:14:52.12,0:14:55.26,Default,,0,0,0,,Не жақсы?
Dialogue: 0,0:14:55.26,0:14:59.79,Default,,0,0,0,,≪Неге? Қайдан? Жоқ, түсінемін!! Сол қыз➡
Dialogue: 0,0:14:59.79,0:15:03.40,Default,,0,0,0,,Мен шикигами итінің құлпын әлі ашпадым! ≫
Dialogue: 0,0:15:03.40,0:15:07.20,Default,,0,0,0,,≪Қайсысы бірдей ★ жұлдыздар⁉➡ арасында тартылатыны анық болды.
Dialogue: 0,0:15:07.20,0:15:09.80,Default,,0,0,0,,Шикигами екеуіңнің арасына қабырға салыңдар➡
Dialogue: 0,0:15:09.80,0:15:13.51,Default,,0,0,0,,Өзіңізді қызықтыратын шикигамиді қабырғаға іліңіз... ➡
Dialogue: 0,0:15:13.51,0:15:16.94,Default,,0,0,0,,Ал мен сапқа тұрсам, итті босатамын! ! ! ≫
Dialogue: 0,0:15:16.94,0:15:19.95,Default,,0,0,0,,≪Қарғыс атсын... Жұлдызаралық ұшу... құлпы ашылды!! ≫
Dialogue: 0,0:15:22.85,0:15:25.32,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:25.32,0:15:27.82,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:15:27.82,0:15:29.86,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:29.86,0:15:36.83,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:38.87,0:15:41.54,Default,,0,0,0,,Ертегіні тыңдаңыз.
Dialogue: 0,0:15:41.54,0:15:46.24,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:52.21,0:15:55.08,Default,,0,0,0,,Бум!!
Dialogue: 0,0:15:55.08,0:15:58.75,Default,,0,0,0,,Сіз шынымен де соны мақсат еттіңіз бе?
Dialogue: 0,0:15:58.75,0:16:01.36,Default,,0,0,0,,Кім саған көбірек тартады, ит?➡
Dialogue: 0,0:16:01.36,0:16:03.76,Default,,0,0,0,,Мен түсінбеймін. Бұл құмар ойын болды➡
Dialogue: 0,0:16:03.76,0:16:05.79,Default,,0,0,0,,Енді түсіндім➡
Dialogue: 0,0:16:05.79,0:16:09.16,Default,,0,0,0,,Сізді емле қуаты жоғары адамдар қызықтырады, солай ма?
Dialogue: 0,0:16:09.16,0:16:12.13,Default,,0,0,0,,Басында мені нефрит ит➡ тартты
Dialogue: 0,0:16:12.13,0:16:14.17,Default,,0,0,0,,Кира-санның шабуылынан қорғануға тырысу➡
Dialogue: 0,0:16:14.17,0:16:18.47,Default,,0,0,0,,Бұл жолы сиқырлы күшпен күшейтсем, нәтиже керісінше болды.
Dialogue: 0,0:16:18.47,0:16:23.18,Default,,0,0,0,,Сіз бірінші курс студентісіз бе? Шынымен сүйкімді... иә?
Dialogue: 0,0:16:27.15,0:16:31.65,Default,,0,0,0,,Өтінемін. уақыт жоқ. Өтінемін, мені тыңда.
Dialogue: 0,0:16:33.39,0:16:35.42,Default,,0,0,0,,Хмм... Түсіндім.
Dialogue: 0,0:16:35.42,0:16:38.33,Default,,0,0,0,,⚟Буха!! Гашан!
Dialogue: 0,0:16:38.33,0:16:41.33,Default,,0,0,0,,Ах.
Dialogue: 0,0:16:41.33,0:16:43.40,Default,,0,0,0,,Ха! (Кира) Иә?
Dialogue: 0,0:16:43.40,0:16:47.67,Default,,0,0,0,,Коджо⁉ Фушигуро Панда-сенпай.
Dialogue: 0,0:16:47.67,0:16:49.77,Default,,0,0,0,,Қозғалмаңыз.
Dialogue: 0,0:16:52.01,0:16:55.94,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:16:55.94,0:17:01.58,Default,,0,0,0,,Ух... ой... ой...
Dialogue: 0,0:17:01.58,0:17:04.69,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:17:04.69,0:17:06.99,Default,,0,0,0,,Ах! Моро...
Dialogue: 0,0:17:09.16,0:17:13.86,Default,,0,0,0,,≪Мына бала!! Біраз уақыттан бері... Одан қашқым келмейді...≫
Dialogue: 0,0:17:13.86,0:17:16.43,Default,,0,0,0,,Сен жындысың.
Dialogue: 0,0:17:16.43,0:17:19.50,Default,,0,0,0,,≪Бұл Шибуядағы шайқастан өзгеше...≫
Dialogue: 0,0:17:19.50,0:17:24.84,Default,,0,0,0,,≪Кей-сенпайдың мені тануы, былайша айтқанда, ырым.≫
Dialogue: 0,0:17:24.84,0:17:28.64,Default,,0,0,0,,≪Мен енді одан құтыла алмаймын. Мен тіпті қарсы тұра алмаймын...≫
Dialogue: 0,0:17:28.64,0:17:32.31,Default,,0,0,0,,Zu! ≪Осы кісі көнбейінше...≫
Dialogue: 0,0:17:32.31,0:17:35.68,Default,,0,0,0,,Қызықты. Мен сіздің әңгімеңізді тыңдаймын.
Dialogue: 0,0:17:35.68,0:17:38.79,Default,,0,0,0,,Сіз әлі тұрған кезде. (Кира) Кин Чан!! ➡
Dialogue: 0,0:17:38.79,0:17:41.62,Default,,0,0,0,,Бұл балалар Кин Чанның көмектескенін қалайды!! ➡
Dialogue: 0,0:17:41.62,0:17:43.86,Default,,0,0,0,,Мені тыңдаңдар!!
Dialogue: 0,0:17:43.86,0:17:46.49,Default,,0,0,0,,Енді тыңдайық. Буу!
Dialogue: 0,0:17:46.49,0:17:48.53,Default,,0,0,0,,Гаха!
Dialogue: 0,0:17:48.53,0:17:51.70,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:51.70,0:17:55.74,Default,,0,0,0,,Сәлем, Кожо. Неге мен? ➡
Dialogue: 0,0:17:55.74,0:17:58.61,Default,,0,0,0,,Бұл біздің бірінші кездесуіміз, солай ма? ➡
Dialogue: 0,0:17:58.61,0:18:01.51,Default,,0,0,0,,Маған неге сенесің?
Dialogue: 0,0:18:01.51,0:18:05.51,Default,,0,0,0,,Өйткені менің үлкендерім сені мықты деп айтты. Мен бұл
Dialogue: 0,0:18:06.91,0:18:09.42,Default,,0,0,0,,➡ деп ойладым
Dialogue: 0,0:18:09.42,0:18:11.89,Default,,0,0,0,,Сиқыршының сиқыршыға өтініші➡
Dialogue: 0,0:18:11.89,0:18:15.49,Default,,0,0,0,,«Өтінемін, бірге өміріңізді қатерге тігіңіз» - бұл алғышарт. ➡
Dialogue: 0,0:18:16.86,0:18:20.53,Default,,0,0,0,,Темеде өмірімді қатерге тігу үшін жеткілікті «жылу» бар➡
Dialogue: 0,0:18:20.53,0:18:25.43,Default,,0,0,0,,Қазір!! Мұнда!! Мен саған айтуым керек!!
Dialogue: 0,0:18:25.43,0:18:29.80,Default,,0,0,0,,Маған адамдар көптен бері солай айтып жүр!?
Dialogue: 0,0:18:29.80,0:18:33.87,Default,,0,0,0,,Түн көбелегі қарт не істеп жатыр? Мұндай бос сөзді жойыңыз!!
Dialogue: 0,0:18:33.87,0:18:37.58,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:18:37.58,0:18:40.72,Default,,0,0,0,,Менің қызуым жоқ. а?
Dialogue: 0,0:18:40.72,0:18:43.15,Default,,0,0,0,,Мен бір бөлігімін.
Dialogue: 0,0:18:43.15,0:18:48.19,Default,,0,0,0,,Сиқыршы қарғысты шығаруы үшін, одан ары қарай шығару үшін➡
Dialogue: 0,0:18:48.19,0:18:50.26,Default,,0,0,0,,Бөлшектер.
Dialogue: 0,0:18:50.26,0:18:53.56,Default,,0,0,0,,Ой ой ой, шындап айтсам, ау.
Dialogue: 0,0:18:53.56,0:18:56.80,Default,,0,0,0,,Бұл өте қызықсыз. ≪Қауіпті!! ≫
Dialogue: 0,0:18:56.80,0:19:00.37,Default,,0,0,0,,Жолбарыс таяқ!! Жетеді!!
Dialogue: 0,0:19:00.37,0:19:02.47,Default,,0,0,0,,Иә! Дого!
Dialogue: 0,0:19:02.47,0:19:05.37,Default,,0,0,0,,Уф! Буха!
Dialogue: 0,0:19:05.37,0:19:14.18,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:19:14.18,0:19:17.99,Default,,0,0,0,,Ауырды. Годжо-сан айтады➡
Dialogue: 0,0:19:17.99,0:19:21.79,Default,,0,0,0,,Менің сиқырлы күшім басқаларға қарағанда өрескел.
Dialogue: 0,0:19:24.66,0:19:26.66,Default,,0,0,0,,Өлді ме? ➡
Dialogue: 0,0:19:28.53,0:19:31.60,Default,,0,0,0,,Эй панда!! және теңіз кірпі басы. ➡
Dialogue: 0,0:19:31.60,0:19:34.07,Default,,0,0,0,,Тез, жолбарыстың таяқшасын алып, жоғалт. ➡
Dialogue: 0,0:19:34.07,0:19:37.10,Default,,0,0,0,,Енді ешқашан... ➡
Dialogue: 0,0:19:37.10,0:19:39.91,Default,,0,0,0,,Ах!?
Dialogue: 0,0:19:39.91,0:19:42.28,Default,,0,0,0,,≪Қақпасыз үш ату⁉➡
Dialogue: 0,0:19:42.28,0:19:44.61,Default,,0,0,0,,Бұған дейін мен сені көп ұрдым≫
Dialogue: 0,0:19:44.61,0:19:47.18,Default,,0,0,0,,Ол неден жасалған, сен?
Dialogue: 0,0:19:47.18,0:19:52.32,Default,,0,0,0,,Мен бір бөлігімін. Бөлшектердің рөлі бар.
Dialogue: 0,0:19:52.32,0:19:55.62,Default,,0,0,0,,Менің рөлім қарғысты ары қарай жалғастыру.
Dialogue: 0,0:19:55.62,0:19:58.83,Default,,0,0,0,,Ал шкала-сенпай керек болса➡
Dialogue: 0,0:19:58.83,0:20:01.93,Default,,0,0,0,,Сен басын изгенше мен сенің соңынан еремін.
Dialogue: 0,0:20:01.93,0:20:15.34,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:15.34,0:20:17.41,Default,,0,0,0,,Аға.
Dialogue: 0,0:20:17.41,0:20:20.11,Default,,0,0,0,,Сіздің рөліңіз қандай?
Dialogue: 0,0:20:20.11,0:20:22.55,Default,,0,0,0,,≪Бұл жігіт…. ➡
Dialogue: 0,0:20:22.55,0:20:25.15,Default,,0,0,0,,Бұл бөлшектердің «жылуы» ма...≫
Dialogue: 0,0:20:29.19,0:20:33.16,Default,,0,0,0,,Жақсы. Қанша оқ атса да... (Кира) Кин-чан. ➡
Dialogue: 0,0:20:33.16,0:20:35.56,Default,,0,0,0,,Күн ыстық емес пе?
Dialogue: 0,0:20:35.56,0:20:39.67,Default,,0,0,0,,Хмм... мм.
Dialogue: 0,0:20:39.67,0:20:42.47,Default,,0,0,0,,≪"Жылу" туралы өтірік айтуға болмайды!! ≫
Dialogue: 0,0:20:45.91,0:20:49.44,Default,,0,0,0,,Балалар, түсіңдер. тістері?
Dialogue: 0,0:20:49.44,0:20:51.45,Default,,0,0,0,,Бұл мәміле.
Dialogue: 0,0:20:52.95,0:20:55.75,Default,,0,0,0,,Не? Шешілді….
Dialogue: 0,0:20:55.75,0:20:58.72,Default,,0,0,0,,Келістің бе? (Кира) Иә.
Dialogue: 0,0:20:58.72,0:21:01.79,Default,,0,0,0,,Рахмет? (Кира) Жарайды. ➡
Dialogue: 0,0:21:01.79,0:21:04.33,Default,,0,0,0,,Маған жоғарғы жақтағылар ұнамайды➡
Dialogue: 0,0:21:04.33,0:21:07.90,Default,,0,0,0,,Не деген, Кин Чан техникалық колледжде адамдарға көмектесіп жүрді➡
Dialogue: 0,0:21:07.90,0:21:09.93,Default,,0,0,0,,Өйткені ол ең ыстық болды.
Dialogue: 0,0:21:09.93,0:21:11.97,Default,,0,0,0,,Хмф! Идет.
Dialogue: 0,0:21:11.97,0:21:14.00,Default,,0,0,0,,Өз орныңды біл.
Dialogue: 0,0:21:14.00,0:21:16.04,Default,,0,0,0,,Рингон Рингон…. Не?
Dialogue: 0,0:21:16.04,0:21:18.07,Default,,0,0,0,,Рингон Рингон Рингон!
Dialogue: 0,0:21:18.07,0:21:20.11,Default,,0,0,0,,Эх! (Панда Кирара) бұл!
Dialogue: 0,0:21:20.11,0:21:24.81,Default,,0,0,0,,Ережелерді жүзушілер өлім цикліне қосты!
Dialogue: 0,0:21:24.81,0:21:28.72,Default,,0,0,0,,Жалпы ережелер 9 Жүзушілерге басқа жүзушілерден ақпарат қажет ➡
Dialogue: 0,0:21:28.72,0:21:32.05,Default,,0,0,0,,«Аты» «Ұпай» «Қосылған ережелер саны» ➡
Dialogue: 0,0:21:32.05,0:21:35.46,Default,,0,0,0,,«Ұстау тосқауылына» сілтеме жасай аласыз.
Dialogue: 0,0:21:40.63,0:21:43.53,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:21:43.53,0:21:46.13,Default,,0,0,0,,((Жарайды. Мен оны өлтірдім))
Dialogue: 0,0:21:49.77,0:21:53.31,Default,,0,0,0,,((Бәрі тым кедей.➡
Dialogue: 0,0:21:53.31,0:21:56.58,Default,,0,0,0,,400 жыл бұрын жағдай біршама жақсырақ болды. ➡
Dialogue: 0,0:21:56.58,0:22:00.68,Default,,0,0,0,,Эй... қайдасың, Сукуна...))
Dialogue: 0,0:22:05.62,0:22:09.69,Default,,0,0,0,,((Ұпай 200-ден асты. 100 ұпай жұмсаңыз ➡)
Dialogue: 0,0:22:09.69,0:22:13.29,Default,,0,0,0,,Өлім цикліне ережелер қосқыңыз келе ме? ))
Dialogue: 0,0:22:13.29,0:22:16.60,Default,,0,0,0,,((мен түсінемін, ережелер….➡
Dialogue: 0,0:22:16.60,0:22:20.60,Default,,0,0,0,,Атау және... Күш стандарты ретінде балл...➡
Dialogue: 0,0:22:22.00,0:22:25.24,Default,,0,0,0,,Ах, егер мен көбірек ереже қоссам, ол азая ма? ➡
Dialogue: 0,0:22:25.24,0:22:28.64,Default,,0,0,0,,Сонда ережені неше рет қосуға болады? ➡
Dialogue: 0,0:22:28.64,0:22:32.35,Default,,0,0,0,,Сондай-ақ, сіз қандай кедергідесіз? ➡
Dialogue: 0,0:22:32.35,0:22:34.85,Default,,0,0,0,,Когане. Ережелер қосылды. ➡
Dialogue: 0,0:22:34.85,0:22:37.85,Default,,0,0,0,,Барлық жүзушілер туралы ақпаратты ашыңыз))
Dialogue: 0,0:22:43.22,0:22:50.03,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:50.03,0:22:53.80,Default,,0,0,0,,♬ Қараңғы күндерде жоқ көлеңке
Dialogue: 0,0:22:53.80,0:22:56.44,Default,,0,0,0,,♬ Мен ренжідім.
Dialogue: 0,0:22:56.44,0:22:59.74,Default,,0,0,0,,♬ Кешірім сұрау сияқты.
Dialogue: 0,0:22:59.74,0:23:03.04,Default,,0,0,0,,♬ Егілген тұқымдар аянышты
Dialogue: 0,0:23:03.04,0:23:06.21,Default,,0,0,0,,♬ гүлдей бастайды
Dialogue: 0,0:23:06.21,0:23:09.28,Default,,0,0,0,,♬ Барған сайын суып барасың
Dialogue: 0,0:23:09.28,0:23:12.62,Default,,0,0,0,,♬ Ұзарған алақан аспанды қиып тұр
Dialogue: 0,0:23:12.62,0:23:15.62,Default,,0,0,0,,♬ Жағдайлар қалпына келе ме?
Dialogue: 0,0:23:15.62,0:23:19.09,Default,,0,0,0,,♬ Толқындар жұтылады
Dialogue: 0,0:23:19.09,0:23:22.26,Default,,0,0,0,,♬ Болашақты жойып, жалғастырыңыз
Dialogue: 0,0:23:22.26,0:23:26.97,Default,,0,0,0,,♬ Ақырзаман келе ме?
Dialogue: 0,0:23:26.97,0:23:31.34,Default,,0,0,0,,♬ Үзіліп, үзіліп кетсем
Dialogue: 0,0:23:31.34,0:23:33.87,Default,,0,0,0,,♬ Байғұс шашылып кетсе де
Dialogue: 0,0:23:33.87,0:23:36.44,Default,,0,0,0,,♬ Мен ештеңеден қорықпаймын
Dialogue: 0,0:23:36.44,0:23:38.48,Default,,0,0,0,,♬ Өйткені қазірдің өзінде
Dialogue: 0,0:23:38.48,0:23:40.51,Default,,0,0,0,,♬ Өйткені ол әлдеқашан бос
Dialogue: 0,0:23:40.51,0:23:42.88,Default,,0,0,0,,♬ Ах, соңында
Dialogue: 0,0:23:42.88,0:23:46.15,Default,,0,0,0,,♬ Бұл шамды міндетті түрде өшіріңіз.
Dialogue: 0,0:23:46.15,0:23:49.62,Default,,0,0,0,,♬ Мен енді ештеңе қаламаймын
Dialogue: 0,0:23:49.62,0:23:52.63,Default,,0,0,0,,♬ Себебі мен оны қайтадан жоғалтып алудан қорқамын
Dialogue: 0,0:23:52.63,0:23:55.06,Default,,0,0,0,,♬ Таң атуға жақын болса да
Dialogue: 0,0:23:55.06,0:23:58.13,Default,,0,0,0,,♬ Тұман әлі сейілмейді
Dialogue: 0,0:23:58.13,0:24:01.07,Default,,0,0,0,,♬ Сол түсініксіз схема
Dialogue: 0,0:24:01.07,0:24:03.67,Default,,0,0,0,,♬ Оны міндетті түрде қадағалай отырып
Dialogue: 0,0:24:03.67,0:24:07.24,Default,,0,0,0,,♬ Мен келе жатырмын
Dialogue: 0,0:24:07.24,0:24:11.55,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:14.92,0:24:17.79,Default,,0,0,0,,Арман мен шындықтың арасы. Бұл қарғыс.
Dialogue: 0,0:24:17.79,0:24:20.49,Default,,0,0,0,,Менің атымды қайдан білесің? Мен Кожодан өзгешемін.
Dialogue: 0,0:24:20.49,0:24:23.26,Default,,0,0,0,,Бір рет кірсең, сен де жүзгішсің!
Dialogue: 0,0:24:23.26,0:24:26.56,Default,,0,0,0,,Цумикиге ілмектен өтуге болатын тесік жасап берсін!!
Dialogue: 0,0:24:28.06,0:24:33.06,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
