Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:35.60,0:00:38.30,Default,,0,0,0,,♬ МЕНІ СҮЙІП, ЖЕК КӨРЕДІ
Dialogue: 0,0:00:38.30,0:00:42.60,Default,,0,0,0,,♬ LUV ME ӨЛТІР
Dialogue: 0,0:00:44.87,0:00:47.44,Default,,0,0,0,,♬ Сүйіспеншілік, жек көру, сүйіспеншілік, жек көру
Dialogue: 0,0:00:47.44,0:00:49.95,Default,,0,0,0,,♬ Дай Токио Рюусо Ута
Dialogue: 0,0:00:49.95,0:00:52.35,Default,,0,0,0,,♬ Маваримавари дәуірінде
Dialogue: 0,0:00:52.35,0:00:55.02,Default,,0,0,0,,♬ Ұятқа малынған
Dialogue: 0,0:00:55.02,0:00:57.59,Default,,0,0,0,,♬ Сүйіспеншілік, жек көру, жақсы көру және жек көру
Dialogue: 0,0:00:57.59,0:00:59.92,Default,,0,0,0,,♬ Кеттік, үлкен әңгіме сияқты
Dialogue: 0,0:00:59.92,0:01:02.42,Default,,0,0,0,,♬ Екеуміз айырылысып қаламыз
Dialogue: 0,0:01:02.42,0:01:05.53,Default,,0,0,0,,♬ Олай болса тағы кездесейік.
Dialogue: 0,0:01:07.50,0:01:09.87,Default,,0,0,0,,♬ Драмаға батып кету
Dialogue: 0,0:01:09.87,0:01:12.33,Default,,0,0,0,,♬ Толық еместігімді мойында
Dialogue: 0,0:01:12.33,0:01:14.44,Default,,0,0,0,,♬ Босаңсытатын көркем әдебиет
Dialogue: 0,0:01:14.44,0:01:17.41,Default,,0,0,0,,♬ Өтірік пен шындық арасындағы диссонанс
Dialogue: 0,0:01:17.41,0:01:19.94,Default,,0,0,0,,♬ Махаббатым толық болмаса да кешірші
Dialogue: 0,0:01:19.94,0:01:22.31,Default,,0,0,0,,♬ Мәселе жоқ! Осы кезеңнен аман өтіңіз
Dialogue: 0,0:01:22.31,0:01:24.61,Default,,0,0,0,,♬ Тістеген ит жауынгер қалтырап
Dialogue: 0,0:01:24.61,0:01:27.85,Default,,0,0,0,,♬ Есейе берсең, ересек бола алмайсың
Dialogue: 0,0:01:27.85,0:01:30.25,Default,,0,0,0,,♬ LUV ME Тек әділдік
Dialogue: 0,0:01:30.25,0:01:32.89,Default,,0,0,0,,♬ ЖЕК КӨРСІЗ Бәрін алып кетіңіз
Dialogue: 0,0:01:32.89,0:01:35.39,Default,,0,0,0,,♬ LUV ME Махаббат пен жек көрушілікке толы
Dialogue: 0,0:01:35.39,0:01:40.26,Default,,0,0,0,,♬ ӨЛТІР мені бұл жерден алып кет
Dialogue: 0,0:01:40.26,0:01:42.90,Default,,0,0,0,,♬ Сүй, жек көр, сүй, жек көр, құшақтас
Dialogue: 0,0:01:42.90,0:01:45.27,Default,,0,0,0,,♬ Қай уақытта болса да шарықтау шегі
Dialogue: 0,0:01:45.27,0:01:47.80,Default,,0,0,0,,♬ Алдап-арбау да, алдау да дұрыс.
Dialogue: 0,0:01:47.80,0:01:50.71,Default,,0,0,0,,♬ Маған баға маңызды емес
Dialogue: 0,0:01:50.71,0:01:53.11,Default,,0,0,0,,♬ Ғашық, өшпенділік, сүйіспеншілік, жек көрушілікпен кезіп
Dialogue: 0,0:01:53.11,0:01:55.48,Default,,0,0,0,,♬ Дипломатиялық сүйкімділік себіңіз
Dialogue: 0,0:01:55.48,0:01:57.95,Default,,0,0,0,,♬ Бәрі сұрақ-жауапсыз аяқталады.
Dialogue: 0,0:01:57.95,0:02:01.45,Default,,0,0,0,,♬ Олай болса тағы кездесейік.
Dialogue: 0,0:02:04.95,0:02:08.39,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:02:08.39,0:02:14.26,Default,,0,0,0,,Жалпы ережелердегі «тұрақтылық» сияқты сылтау нақты жоспарды жабу болып табылады. ➡
Dialogue: 0,0:02:14.26,0:02:16.43,Default,,0,0,0,,Бұл сенімділік. ➡
Dialogue: 0,0:02:16.43,0:02:20.94,Default,,0,0,0,,Күштілер ғана қалатын сапарда Джинсаку бомба тастайды➡
Dialogue: 0,0:02:20.94,0:02:24.74,Default,,0,0,0,,Өлім сапары өз рөлін аяқтайды. ➡
Dialogue: 0,0:02:24.74,0:02:28.34,Default,,0,0,0,,Мен Хосаку қандай бомба тастағанын білмеймін. ➡
Dialogue: 0,0:02:28.34,0:02:31.91,Default,,0,0,0,,Оның үстіне ол жақын арада құлдырады➡
Dialogue: 0,0:02:31.91,0:02:34.58,Default,,0,0,0,,Қазір бұл уақыт болуы мүмкін. ➡
Dialogue: 0,0:02:34.58,0:02:38.32,Default,,0,0,0,,Сондықтан мен дайындалуда мықты одақтастар жинадым➡
Dialogue: 0,0:02:38.32,0:02:41.06,Default,,0,0,0,,Ұпайларды сақтау.
Dialogue: 0,0:02:41.06,0:02:43.79,Default,,0,0,0,,Мен сізге бірнеше сұрақ қойғым келеді.
Dialogue: 0,0:02:43.79,0:02:46.70,Default,,0,0,0,,Менің ойымша, бұл жігіт онша күшті емес.
Dialogue: 0,0:02:46.70,0:02:51.43,Default,,0,0,0,,Әлгі әйел алаяқ ретінде әрекет етіп, тиісті себептермен мұнда жүзушілерді шақыруда.
Dialogue: 0,0:02:51.43,0:02:55.10,Default,,0,0,0,,Әйелдердің үрейлену ықтималдығы аз.
Dialogue: 0,0:02:55.10,0:02:58.21,Default,,0,0,0,,Егер ол енді пайдалы болмаса, оны өлтіріп, ұпайға айналдырыңыз.
Dialogue: 0,0:02:58.21,0:03:00.28,Default,,0,0,0,,Ах.
Dialogue: 0,0:03:00.28,0:03:04.61,Default,,0,0,0,,Naniyitternunda. Соннаваке Найдару.
Dialogue: 0,0:03:04.61,0:03:07.92,Default,,0,0,0,,Реджи-сама - менің нағыз рыцарь.
Dialogue: 0,0:03:07.92,0:03:11.62,Default,,0,0,0,,Мен қолымнан келгенше, сен мені қорғайсың.
Dialogue: 0,0:03:11.62,0:03:13.79,Default,,0,0,0,,Қандай бақытты бас.
Dialogue: 0,0:03:13.79,0:03:16.12,Default,,0,0,0,,Егер сіз және сіздің достарыңыздың ұпайлары қосылса ➡
Dialogue: 0,0:03:16.12,0:03:18.16,Default,,0,0,0,,100 ұпай аласыз ба?
Dialogue: 0,0:03:18.16,0:03:20.73,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:03:20.73,0:03:23.43,Default,,0,0,0,,Ережелер жақын арада қосылады.
Dialogue: 0,0:03:23.43,0:03:27.74,Default,,0,0,0,,Жүзушілер арасындағы нүктелердің қозғалысына мүмкіндік береді.
Dialogue: 0,0:03:27.74,0:03:31.54,Default,,0,0,0,,Маған барлық ұпайларыңызды беріңіз.
Dialogue: 0,0:03:31.54,0:03:34.24,Default,,0,0,0,,Келіссөздер үзіледі.
Dialogue: 0,0:03:38.81,0:03:40.85,Default,,0,0,0,,≪Жоғал...≫
Dialogue: 0,0:03:40.85,0:03:42.88,Default,,0,0,0,,Ах⁉➡
Dialogue: 0,0:03:42.88,0:03:45.99,Default,,0,0,0,,Сәлем. Ну!!
Dialogue: 0,0:03:45.99,0:03:48.39,Default,,0,0,0,,Ой. Бум!
Dialogue: 0,0:03:48.39,0:03:51.63,Default,,0,0,0,,Сәлем. Маған енді ол жағын көрсетпе.
Dialogue: 0,0:03:51.63,0:03:54.96,Default,,0,0,0,,Эй... ⚟Гя! (Нфрит иттің қабығы)
Dialogue: 0,0:03:54.96,0:04:00.07,Default,,0,0,0,,Аа~ түсіндім. Мен түсінемін. ➡
Dialogue: 0,0:04:00.07,0:04:03.57,Default,,0,0,0,,Егер сіз оны жылы деп ойласаңыз, оны өлтіре алмайсыз ба? ➡
Dialogue: 0,0:04:03.57,0:04:06.68,Default,,0,0,0,,Біздің ұпайлар Біз мұны қалаймыз. ➡
Dialogue: 0,0:04:06.68,0:04:11.28,Default,,0,0,0,,Бірақ сен мені өлтіруге дайын болуың керек➡
Dialogue: 0,0:04:11.28,0:04:13.95,Default,,0,0,0,,Өлгеннен кейін өкінесің.
Dialogue: 0,0:04:13.95,0:04:19.69,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:19.69,0:04:21.79,Default,,0,0,0,,Га.
Dialogue: 0,0:04:38.51,0:04:42.44,Default,,0,0,0,,Сәлем!! Мен де бармын!!
Dialogue: 0,0:04:42.44,0:04:44.48,Default,,0,0,0,,Өлді ме?
Dialogue: 0,0:04:44.48,0:04:46.52,Default,,0,0,0,,Гехо Гехо.
Dialogue: 0,0:04:46.52,0:04:49.82,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:49.82,0:04:52.02,Default,,0,0,0,,Ия.
Dialogue: 0,0:04:52.02,0:04:54.02,Default,,0,0,0,,Бұл жақсы!!
Dialogue: 0,0:04:55.86,0:04:57.96,Default,,0,0,0,,Паша! ≪Бұл иіс...≫
Dialogue: 0,0:05:00.63,0:05:02.63,Default,,0,0,0,,Бум!!
Dialogue: 0,0:05:05.67,0:05:12.21,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:12.21,0:05:14.58,Default,,0,0,0,,Ол аяқталды ма?
Dialogue: 0,0:05:14.58,0:05:17.18,Default,,0,0,0,,Әлі жоқ. Реджи➡ сияқты
Dialogue: 0,0:05:17.18,0:05:20.65,Default,,0,0,0,,Жарылыс алдында мен бөлмеге жүгірдім.
Dialogue: 0,0:05:20.65,0:05:26.12,Default,,0,0,0,,Хмм, қолымнан келмейді... Бірақ, менің ойымша, біраз қырындым.
Dialogue: 0,0:05:26.12,0:05:29.76,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:29.76,0:05:33.76,Default,,0,0,0,,Хаха.
Dialogue: 0,0:05:33.76,0:05:36.36,Default,,0,0,0,,Енді түсіндің.
Dialogue: 0,0:05:36.36,0:05:38.40,Default,,0,0,0,,Олардың сізді қорғауға ниеті жоқ.
Dialogue: 0,0:05:38.40,0:05:41.57,Default,,0,0,0,,Ух... у...
Dialogue: 0,0:05:41.57,0:05:44.27,Default,,0,0,0,,Түсінсеңіз, ұмытыңыз.
Dialogue: 0,0:05:45.81,0:05:47.84,Default,,0,0,0,,Thud! (Шықылдаған дыбыс) Арх!
Dialogue: 0,0:05:47.84,0:05:52.28,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:05:52.28,0:05:54.92,Default,,0,0,0,,Тек орындаңыз.
Dialogue: 0,0:05:54.92,0:05:57.72,Default,,0,0,0,,Онда маған айт.
Dialogue: 0,0:05:59.09,0:06:01.79,Default,,0,0,0,,Реджи-сама маған осылай деді.
Dialogue: 0,0:06:01.79,0:06:03.83,Default,,0,0,0,,Мені қорға!!
Dialogue: 0,0:06:03.83,0:06:07.86,Default,,0,0,0,,Мені жақсы көр!! Айтыңызшы! ! !
Dialogue: 0,0:06:07.86,0:06:13.37,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:06:13.37,0:06:15.80,Default,,0,0,0,,Кейде.
Dialogue: 0,0:06:15.80,0:06:18.77,Default,,0,0,0,,Сіз сияқты әрекеттер емес➡
Dialogue: 0,0:06:18.77,0:06:21.88,Default,,0,0,0,,Әңгімелеп жүрген ақымақ.
Dialogue: 0,0:06:21.88,0:06:25.01,Default,,0,0,0,,⚟(Ине) Бұрын не болды? ➡
Dialogue: 0,0:06:25.01,0:06:27.62,Default,,0,0,0,,Ол қазірдің өзінде тоз-тоз болып қалды, солай емес пе? ➡
Dialogue: 0,0:06:27.62,0:06:30.05,Default,,0,0,0,,Бұл жерде жорғалап шығу оңай емес.
Dialogue: 0,0:06:30.05,0:06:32.59,Default,,0,0,0,,Баспалдақпен жүр, қарабайыр адам.
Dialogue: 0,0:06:32.59,0:06:35.86,Default,,0,0,0,,Рингон Рингон Рингон Рингон Рингон.
Dialogue: 0,0:06:35.86,0:06:41.56,Default,,0,0,0,,Ережені жүзушілер өлім цикліне қосты! ➡
Dialogue: 0,0:06:41.56,0:06:44.50,Default,,0,0,0,,Жалпы ережелер 10 Жүзушілер басқа жүзушілерге➡
Dialogue: 0,0:06:44.50,0:06:48.24,Default,,0,0,0,,Кез келген ұпайларды ауыстыруға болады.
Dialogue: 0,0:06:48.24,0:06:51.04,Default,,0,0,0,,Не? Бұл ереже...
Dialogue: 0,0:06:52.34,0:06:54.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:54.38,0:07:01.08,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:01.08,0:07:03.08,Default,,0,0,0,,Дока! қарақат!
Dialogue: 0,0:07:05.65,0:07:08.22,Default,,0,0,0,,Гекко
Dialogue: 0,0:07:08.22,0:07:10.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:11.63,0:07:13.66,Default,,0,0,0,,Ух!!
Dialogue: 0,0:07:13.66,0:07:17.67,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:17.67,0:07:19.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:21.70,0:07:23.91,Default,,0,0,0,,Ух!!
Dialogue: 0,0:07:23.91,0:07:26.14,Default,,0,0,0,,«Мансу»!! қарақат!
Dialogue: 0,0:07:26.14,0:07:28.18,Default,,0,0,0,,Барин! Паон! (Мансу жылайды)
Dialogue: 0,0:07:28.18,0:07:30.31,Default,,0,0,0,,Бұл жігіт тағы да...
Dialogue: 0,0:07:30.31,0:07:33.45,Default,,0,0,0,,Ки!
Dialogue: 0,0:07:33.45,0:07:35.62,Default,,0,0,0,,Гува!! ➡
Dialogue: 0,0:07:35.62,0:07:38.65,Default,,0,0,0,,Ух!! Арх!! Гашан!
Dialogue: 0,0:07:38.65,0:07:42.12,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:42.12,0:07:46.43,Default,,0,0,0,,Уф. Деме!! Жарайсың.
Dialogue: 0,0:07:46.43,0:07:48.53,Default,,0,0,0,,Дош! Уф!!
Dialogue: 0,0:07:52.03,0:07:55.84,Default,,0,0,0,,≪Не істеп жатырсың? Мен...≫
Dialogue: 0,0:07:55.84,0:07:58.47,Default,,0,0,0,,≪Бізге ұпайлар қажет болады≫
Dialogue: 0,0:07:58.47,0:08:02.64,Default,,0,0,0,,≪Бірақ Цумики енді бір-бірін өлтіруге мәжбүр болмайды≫
Dialogue: 0,0:08:02.64,0:08:05.45,Default,,0,0,0,,≪Асықпа, бәріне сену≫
Dialogue: 0,0:08:05.45,0:08:08.48,Default,,0,0,0,,≪Осы жігіттерде бар нәрсеге ілінбеңіз...➡
Dialogue: 0,0:08:08.48,0:08:13.69,Default,,0,0,0,,Маған бар күшіммен түсетін ұшқындарды өшіру керек≫
Dialogue: 0,0:08:13.69,0:08:16.79,Default,,0,0,0,,5 ұпай қосылды.
Dialogue: 0,0:08:16.79,0:08:20.06,Default,,0,0,0,,Әй, ұпайлар босқа кетті➡
Dialogue: 0,0:08:20.06,0:08:23.77,Default,,0,0,0,,Техника Мен оны қолдана алмай тұрып өлтіріп алсаңыз, мен сізге қамқорлық жасамаймын.
Dialogue: 0,0:08:25.80,0:08:29.84,Default,,0,0,0,,≪Рейми зейнеткерлікке шығып жатыр ма... Бұлай болса да, 2-ден 1-ге тең!! ≫
Dialogue: 0,0:08:29.84,0:08:33.04,Default,,0,0,0,,≪ Қарғыс атсын!! Бірінші бомбалау тиімді≫
Dialogue: 0,0:08:33.04,0:08:36.18,Default,,0,0,0,,≪Қашу мүмкін емес...≫
Dialogue: 0,0:08:36.18,0:08:39.65,Default,,0,0,0,,≪Аймақты пайдалану керек пе...≫
Dialogue: 0,0:08:39.65,0:08:42.08,Default,,0,0,0,,≪Бірақ менің патшалығым аяқталмаған➡
Dialogue: 0,0:08:42.08,0:08:46.39,Default,,0,0,0,,Барьерді жауып, қарсыласты ұстау мүмкін емес≫
Dialogue: 0,0:08:46.39,0:08:50.36,Default,,0,0,0,,≪Ең нашар үлгі - қашу, жеңілу және реванш өткізу≫
Dialogue: 0,0:08:50.36,0:08:53.26,Default,,0,0,0,,Пуф.
Dialogue: 0,0:08:53.26,0:08:57.00,Default,,0,0,0,,Ах! (Такаба) Бұл қауіпті!! ➡
Dialogue: 0,0:08:57.00,0:09:00.14,Default,,0,0,0,,Жоқ!! Жоқ!! ➡
Dialogue: 0,0:09:00.14,0:09:02.24,Default,,0,0,0,,Жоқ!!
Dialogue: 0,0:09:05.74,0:09:08.48,Default,,0,0,0,,2-1…➡
Dialogue: 0,0:09:08.48,0:09:12.28,Default,,0,0,0,,Балалар шынымен де әділ бөлдіңдер...➡
Dialogue: 0,0:09:12.28,0:09:15.12,Default,,0,0,0,,Осыны айтып тұрсыз ба?⁉➡
Dialogue: 0,0:09:15.12,0:09:19.55,Default,,0,0,0,,Сіздей адамдарды қалай атаймыз...➡
Dialogue: 0,0:09:19.55,0:09:25.53,Default,,0,0,0,,Иә!! Ол қорқақ...Қорқақтың шабуылы нәтиже бермейді... ➡
Dialogue: 0,0:09:25.53,0:09:28.40,Default,,0,0,0,,Қараңыз!! ➡
Dialogue: 0,0:09:28.40,0:09:32.10,Default,,0,0,0,,Зақым – 0!!
Dialogue: 0,0:09:34.50,0:09:38.31,Default,,0,0,0,,Ах... хмм...
Dialogue: 0,0:09:58.19,0:10:01.50,Default,,0,0,0,,Ммм...
Dialogue: 0,0:10:20.08,0:10:22.95,Default,,0,0,0,,Бала, көмектесейік. ➡
Dialogue: 0,0:10:22.95,0:10:25.49,Default,,0,0,0,,Сіз 35 жастасыз. Маған қарасаңыз➡
Dialogue: 0,0:10:25.49,0:10:28.39,Default,,0,0,0,,Мен білмеймін басқа адам жаман ба, жоқ па...
Dialogue: 0,0:10:30.73,0:10:33.13,Default,,0,0,0,,Не? (Такаба) Сен де➡
Dialogue: 0,0:10:33.13,0:10:36.73,Default,,0,0,0,,Жаман көрінесің! Уф...
Dialogue: 0,0:10:36.73,0:10:40.54,Default,,0,0,0,,Жарайды!! Бұл салыстырмалы бағалау !! Ыңғайлы және босаңсыған.
Dialogue: 0,0:10:40.54,0:10:43.04,Default,,0,0,0,,Жайлылық – абсолютті мән.
Dialogue: 0,0:10:43.04,0:10:47.88,Default,,0,0,0,,≪Ол мені қорғады. Әзірше маған сенуге болады...≫
Dialogue: 0,0:10:47.88,0:10:50.48,Default,,0,0,0,,Оны қалай көресіз? Сары емен.
Dialogue: 0,0:10:50.48,0:10:53.68,Default,,0,0,0,,Ол бейтаныс адам. Сұрасаңыз тезірек.
Dialogue: 0,0:10:53.68,0:10:57.19,Default,,0,0,0,,Сәлем!! Аға, бұл қайсысы?
Dialogue: 0,0:10:59.79,0:11:02.56,Default,,0,0,0,,Хмм... мм. ➡
Dialogue: 0,0:11:02.56,0:11:06.63,Default,,0,0,0,,Түсіндім... Бұл сұрақ ➡ дегенім
Dialogue: 0,0:11:06.63,0:11:10.16,Default,,0,0,0,,Қызық па, қызық емес пе...➡
Dialogue: 0,0:11:10.16,0:11:12.80,Default,,0,0,0,,Бұл дегеніміз⁉
Dialogue: 0,0:11:12.80,0:11:15.50,Default,,0,0,0,,Жоқ. Сіз қай дәуірденсіз?
Dialogue: 0,0:11:15.50,0:11:17.54,Default,,0,0,0,,Бұл костюм!! ➡
Dialogue: 0,0:11:17.54,0:11:20.98,Default,,0,0,0,,Ол маған алғаш рет күлуді үйретті➡
Dialogue: 0,0:11:20.98,0:11:23.24,Default,,0,0,0,,Бұл батырға еліктеу.
Dialogue: 0,0:11:23.24,0:11:27.78,Default,,0,0,0,,Мен бұл костюмнен бас тарта алмаймын!
Dialogue: 0,0:11:27.78,0:11:30.45,Default,,0,0,0,,Бұл мен бұрын ойлаған гаг.
Dialogue: 0,0:11:30.45,0:11:33.45,Default,,0,0,0,,Қызығушылық танытқан қыздың алдында оны көрсету жақсы.
Dialogue: 0,0:11:33.45,0:11:36.39,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:11:36.39,0:11:39.43,Default,,0,0,0,,Бірдеңе келе жатыр!! Қарғыс атсын!
Dialogue: 0,0:11:39.43,0:11:45.27,Default,,0,0,0,,Ммм➡
Dialogue: 0,0:11:45.27,0:11:48.57,Default,,0,0,0,,Қосымша Wi-Fi! ! !
Dialogue: 0,0:11:54.48,0:11:57.25,Default,,0,0,0,,А... (жел дыбысы)
Dialogue: 0,0:11:57.25,0:11:59.98,Default,,0,0,0,,Қарғыс атқыр тұтынушылар! ! ! ➡
Dialogue: 0,0:11:59.98,0:12:04.62,Default,,0,0,0,,Міне! Сендер сияқты құрсағымда күлуді ұмытсам да➡
Dialogue: 0,0:12:04.62,0:12:07.76,Default,,0,0,0,,Клиент театрдың алдыңғы қатарында отырған сияқты!!
Dialogue: 0,0:12:07.76,0:12:09.96,Default,,0,0,0,,Бұл сіздің мәселеңіз.
Dialogue: 0,0:12:09.96,0:12:12.56,Default,,0,0,0,,Бірақ мен!! ≪Оның иісі бірдей≫
Dialogue: 0,0:12:12.56,0:12:15.13,Default,,0,0,0,,Мен де сендерді олай тастамаймын!
Dialogue: 0,0:12:15.13,0:12:17.13,Default,,0,0,0,,Өйткені менмін!!
Dialogue: 0,0:12:19.43,0:12:21.60,Default,,0,0,0,,≪Мен әзілкешпін...≫
Dialogue: 0,0:12:21.60,0:12:23.71,Default,,0,0,0,,Ух!!
Dialogue: 0,0:12:25.14,0:12:27.81,Default,,0,0,0,,♬~
Dialogue: 0,0:12:27.81,0:12:30.55,Default,,0,0,0,,≪Жылдам!! Менің қарғыс күшім шарықтап кетті!! ≫
Dialogue: 0,0:12:30.55,0:12:32.88,Default,,0,0,0,,≪Шығыс ауытқуы жаман емес... ➡
Dialogue: 0,0:12:32.88,0:12:34.85,Default,,0,0,0,,Мына жігіт... күшті...≫
Dialogue: 0,0:12:34.85,0:12:38.15,Default,,0,0,0,,Абайлаңыз. Мен зорлық-зомбылықты жақтаймын➡
Dialogue: 0,0:12:38.15,0:12:42.16,Default,,0,0,0,,Ол ескі әзілқой, солай ма?
Dialogue: 0,0:12:42.16,0:12:45.16,Default,,0,0,0,,Енді не істеуіміз керек? бала!
Dialogue: 0,0:12:49.66,0:12:51.70,Default,,0,0,0,,Екеуі осылай бөлінеді. Иә.
Dialogue: 0,0:12:51.70,0:12:53.97,Default,,0,0,0,,Бұл техника болса керек. Иә иә.
Dialogue: 0,0:12:53.97,0:12:56.40,Default,,0,0,0,,Дене бөлігін бомбаға айналдыр. Иә иә.
Dialogue: 0,0:12:56.40,0:12:58.97,Default,,0,0,0,,Сонымен қатар, кері айналдыру әдісін қолданыңыз... Иә иә иә иә иә.
Dialogue: 0,0:12:58.97,0:13:01.01,Default,,0,0,0,,Өте жақын! ! ! Иә иә.
Dialogue: 0,0:13:01.01,0:13:03.31,Default,,0,0,0,,Когане!! махаббат!
Dialogue: 0,0:13:03.31,0:13:06.18,Default,,0,0,0,,Хироми Нисша туралы мәлімет беріңіз!!
Dialogue: 0,0:13:06.18,0:13:08.78,Default,,0,0,0,,≪Ережені қосқан адам Кожо...≫ болды
Dialogue: 0,0:13:10.45,0:13:14.06,Default,,0,0,0,,Мен енді бұл тосқауылдың пайдасы жоқ.
Dialogue: 0,0:13:14.06,0:13:17.06,Default,,0,0,0,,Егер шегінсең, сағынып қаласың.
Dialogue: 0,0:13:17.06,0:13:20.40,Default,,0,0,0,,күрсін!? Сіз қай позициядан айтып отырсыз?
Dialogue: 0,0:13:20.40,0:13:24.47,Default,,0,0,0,,Мен сіз өлтірген инелердің ұпайларын жинаймын.
Dialogue: 0,0:13:24.47,0:13:28.24,Default,,0,0,0,,Анта. (Такаба) Эй Такаба. Ммм.
Dialogue: 0,0:13:28.24,0:13:32.61,Default,,0,0,0,,Бомбаны өлтіргіңіз келсе, жасаңыз.
Dialogue: 0,0:13:32.61,0:13:35.01,Default,,0,0,0,,Бұған дейін ұпайларыңызды алып тастағаныңызды қалаймын.
Dialogue: 0,0:13:36.48,0:13:41.45,Default,,0,0,0,,Жарайсың бала. Мен сіздің өтінішіңізді қабылдадым.
Dialogue: 0,0:13:41.45,0:13:45.89,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:13:45.89,0:13:48.72,Default,,0,0,0,,Бірақ мен комедиямын.
Dialogue: 0,0:13:48.72,0:13:51.89,Default,,0,0,0,,Өмір бойы біреудің күлкісін кетіретін ештеңе жасама!!
Dialogue: 0,0:13:51.89,0:13:55.06,Default,,0,0,0,,Жеңіске жеткенше бәрі жақсы.
Dialogue: 0,0:13:55.06,0:13:57.17,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:59.70,0:14:01.70,Default,,0,0,0,,Ммм….
Dialogue: 0,0:14:04.11,0:14:09.44,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:14:09.44,0:14:12.35,Default,,0,0,0,,Бұл қорқынышты техника!! Хьюу таң!!
Dialogue: 0,0:14:12.35,0:14:14.38,Default,,0,0,0,,Тамая!! Бум!
Dialogue: 0,0:14:14.38,0:14:17.59,Default,,0,0,0,,Бірақ бірақ!! Әртүрлілікте !!
Dialogue: 0,0:14:17.59,0:14:21.52,Default,,0,0,0,,Бассейн! қарақат!
Dialogue: 0,0:14:21.52,0:14:23.73,Default,,0,0,0,,≪Ха! Жоқ...≫
Dialogue: 0,0:14:25.56,0:14:27.60,Default,,0,0,0,,Қызыл түске тыйым салынады.
Dialogue: 0,0:14:27.60,0:14:29.70,Default,,0,0,0,,Бұлз! (Сары емен) Гуааа!!
Dialogue: 0,0:14:31.63,0:14:33.90,Default,,0,0,0,,Ku!! Оны жалама.
Dialogue: 0,0:14:33.90,0:14:35.90,Default,,0,0,0,,Дока!
Dialogue: 0,0:14:40.64,0:14:43.48,Default,,0,0,0,,Такаха менің жауым емес екеніне қуаныштымын.
Dialogue: 0,0:14:43.48,0:14:46.58,Default,,0,0,0,,Осыны маған бір рет болса да айтқым келеді Сери ФУУУУ!!
Dialogue: 0,0:14:48.08,0:14:51.92,Default,,0,0,0,,Кездескенше балам. Өлме!
Dialogue: 0,0:14:51.92,0:14:55.46,Default,,0,0,0,,А, ол өлді. ➡
Dialogue: 0,0:14:55.46,0:14:59.13,Default,,0,0,0,,Егер сені сондай ақымақ қылса, Сары емен байсалды болар еді.
Dialogue: 0,0:14:59.13,0:15:01.16,Default,,0,0,0,,Теме үшін уайымдамаңыз.
Dialogue: 0,0:15:01.16,0:15:05.77,Default,,0,0,0,,Мен айттым ғой. Мен бұл тосқауылдағы мақсатыма жеттім.
Dialogue: 0,0:15:05.77,0:15:08.80,Default,,0,0,0,,Мен шындап күресе аламын. Ешқандай тартыну жоқ.
Dialogue: 0,0:15:08.80,0:15:10.97,Default,,0,0,0,,Хмм.
Dialogue: 0,0:15:10.97,0:15:13.57,Default,,0,0,0,,Бум! Кілт!
Dialogue: 0,0:15:13.57,0:15:17.71,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:17.71,0:15:19.91,Default,,0,0,0,,Ха ха ха ха ха….
Dialogue: 0,0:15:21.35,0:15:23.38,Default,,0,0,0,,Бакин!
Dialogue: 0,0:15:23.38,0:15:26.25,Default,,0,0,0,,Хаа ха ха ха ха.... Қарғыс атсын!
Dialogue: 0,0:15:26.25,0:15:29.46,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:29.46,0:15:31.49,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:31.49,0:15:35.36,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:35.36,0:15:37.40,Default,,0,0,0,,Гах.
Dialogue: 0,0:15:37.40,0:15:48.34,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:48.34,0:15:51.75,Default,,0,0,0,,Қарғыс атсын! Толық!!
Dialogue: 0,0:15:51.75,0:15:53.78,Default,,0,0,0,,Паон!
Dialogue: 0,0:15:53.78,0:15:57.08,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:15:57.08,0:15:59.42,Default,,0,0,0,,Ондай нәрсе бар ма?
Dialogue: 0,0:15:59.42,0:16:06.33,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:16:06.33,0:16:09.43,Default,,0,0,0,,Башар! Апыр-ай!!
Dialogue: 0,0:16:11.83,0:16:15.24,Default,,0,0,0,,Уау!!
Dialogue: 0,0:16:17.77,0:16:19.87,Default,,0,0,0,,Барин!
Dialogue: 0,0:16:22.18,0:16:24.21,Default,,0,0,0,,Гуфу!!
Dialogue: 0,0:16:24.21,0:16:34.72,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:16:36.76,0:16:40.46,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:16:40.46,0:16:44.20,Default,,0,0,0,,Арх! Ухохо!!
Dialogue: 0,0:16:44.20,0:16:48.27,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:16:48.27,0:16:50.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:50.71,0:16:52.74,Default,,0,0,0,,Хахахаха.
Dialogue: 0,0:16:52.74,0:16:57.31,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:16:57.31,0:16:59.35,Default,,0,0,0,,Жан! (фортепиано дыбысы)
Dialogue: 0,0:16:59.35,0:17:08.29,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:08.29,0:17:10.39,Default,,0,0,0,,О хо хо хо.
Dialogue: 0,0:17:13.46,0:17:15.66,Default,,0,0,0,,Доон!!
Dialogue: 0,0:17:24.64,0:17:28.14,Default,,0,0,0,,Сіз менің техникамды білесіз. ➡
Dialogue: 0,0:17:28.14,0:17:31.78,Default,,0,0,0,,Бұл суда жүзу оңай дегенді білдірмейді ме?
Dialogue: 0,0:17:31.78,0:17:36.75,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:36.75,0:17:42.12,Default,,0,0,0,,Түбіртек мазмұнының іске асуы... Дәлірек айтқанда, басқаша шығар.
Dialogue: 0,0:17:42.12,0:17:45.36,Default,,0,0,0,,Дұрыс. Оны білдіру қиын➡
Dialogue: 0,0:17:45.36,0:17:48.23,Default,,0,0,0,,«Келісімшартты қайта жаңғырту»... Менің айтайын дегенім осы. ➡
Dialogue: 0,0:17:48.23,0:17:51.17,Default,,0,0,0,,Басқаша айтқанда, сіз де осындай нәрсені жасай аласыз. ➡
Dialogue: 0,0:17:51.17,0:17:53.40,Default,,0,0,0,,«Келісімшартты қайта жасау».
Dialogue: 0,0:17:53.40,0:17:58.24,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:17:58.24,0:18:02.18,Default,,0,0,0,,Мен жаңа ғана 5 жұлдызды «Хошикутей» қонақ үйін пайдаландым ➡
Dialogue: 0,0:18:02.18,0:18:07.45,Default,,0,0,0,,2 түн және 3 күн май өңдеу кіреді. Бұл түбіртек.
Dialogue: 0,0:18:07.45,0:18:12.39,Default,,0,0,0,,Яғни, мен жай ғана ыстық бұлақта демалып, демалып жатырмын➡
Dialogue: 0,0:18:12.39,0:18:17.36,Default,,0,0,0,,Осылайша менің денем екі күн бойы толық демалды.
Dialogue: 0,0:18:17.36,0:18:19.89,Default,,0,0,0,,Онымен салыстырғанда сіз ше?
Dialogue: 0,0:18:19.89,0:18:24.50,Default,,0,0,0,,Алдыңғы шайқастағы жарақат Бірнеше шикигами комбинациясы➡
Dialogue: 0,0:18:24.50,0:18:27.03,Default,,0,0,0,,Бұл ақылсыз, солай емес пе?
Dialogue: 0,0:18:27.03,0:18:31.34,Default,,0,0,0,,≪Мен көп комбинацияларды жиі қолданамын. Мәселе ➡ ішінде
Dialogue: 0,0:18:31.34,0:18:35.78,Default,,0,0,0,,Ол бастапқыда жалғыз қолданылатын «мансуды» қамтиды≫
Dialogue: 0,0:18:35.78,0:18:39.58,Default,,0,0,0,,Шикигамиді тез шығарып, алып тастай аласыз, бірақ➡
Dialogue: 0,0:18:39.58,0:18:43.62,Default,,0,0,0,,Шикигами жарақат алған соң мұндай жағдай болмайды, солай ма? ➡
Dialogue: 0,0:18:43.62,0:18:47.22,Default,,0,0,0,,Мен дәл қазір жүгіру, шабуылдау және қорғаныс қабілеті бар итті шығара алмаймын. ➡
Dialogue: 0,0:18:47.22,0:18:52.33,Default,,0,0,0,,Осыған байланысты менде бір трюк шикигамиді бірге қолданудан басқа амалым жоқ. ➡
Dialogue: 0,0:18:52.33,0:18:56.86,Default,,0,0,0,,Бұл бірде-бір ойыншыда ешқандай күшті дағдылар болмаған тозуға қарсы күрес. ➡
Dialogue: 0,0:18:56.86,0:19:00.67,Default,,0,0,0,,Бұл енді мүмкін емес. Сіз мені өлтіре алмайсыз.
Dialogue: 0,0:19:02.84,0:19:05.71,Default,,0,0,0,,Дұрыс... онда қаш.
Dialogue: 0,0:19:05.71,0:19:07.74,Default,,0,0,0,,Ой.
Dialogue: 0,0:19:07.74,0:19:09.84,Default,,0,0,0,,Ки!
Dialogue: 0,0:19:15.95,0:19:18.05,Default,,0,0,0,,Бұл жұмыс істемейді.
Dialogue: 0,0:19:24.56,0:19:26.66,Default,,0,0,0,,♬ Хмф. Хмм (мылдау)
Dialogue: 0,0:19:26.66,0:19:29.43,Default,,0,0,0,,Бу... (дронның ұшып бара жатқан дыбысы)
Dialogue: 0,0:19:29.43,0:19:33.20,Default,,0,0,0,,≪Жалпы гимназия... Соған тап болдыңыз ба...➡
Dialogue: 0,0:19:33.20,0:19:36.97,Default,,0,0,0,,Сіз мені... шақырасыз ба? Отқа қуыруға болады, бірақ ➡
Dialogue: 0,0:19:36.97,0:19:40.47,Default,,0,0,0,,Бірін-бірі қайта қуу азап. ➡
Dialogue: 0,0:19:40.47,0:19:44.35,Default,,0,0,0,,Енді не істеу керек≫
Dialogue: 0,0:19:44.35,0:19:47.31,Default,,0,0,0,,≪Жарайды... Суреттегідей≫
Dialogue: 0,0:19:47.31,0:19:50.25,Default,,0,0,0,,≪Бұл дұрыс өлшем...≫
Dialogue: 0,0:19:50.25,0:19:55.66,Default,,0,0,0,,Маған қызық, сіз не жоспарлап отырсыз. Қарғыс атқыр бала.
Dialogue: 0,0:19:55.66,0:19:59.03,Default,,0,0,0,,Сіз бірдеңе орнатқан жоқсыз ба?
Dialogue: 0,0:19:59.03,0:20:01.13,Default,,0,0,0,,♬~
Dialogue: 0,0:20:03.60,0:20:06.70,Default,,0,0,0,,Сиқыршы өтірік айтады, солай емес пе?
Dialogue: 0,0:20:06.70,0:20:10.27,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:10.27,0:20:12.51,Default,,0,0,0,,Хаха.
Dialogue: 0,0:20:12.51,0:20:14.54,Default,,0,0,0,,Гу!!
Dialogue: 0,0:20:14.54,0:20:18.95,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:18.95,0:20:22.05,Default,,0,0,0,,Ух!!
Dialogue: 0,0:20:22.05,0:20:24.45,Default,,0,0,0,,Уф!!
Dialogue: 0,0:20:24.45,0:20:26.85,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:26.85,0:20:29.46,Default,,0,0,0,,Ух!! Гакин!
Dialogue: 0,0:20:29.46,0:20:31.49,Default,,0,0,0,,(Репортер) Оны бұрын бір жерде көргендеймін, бірақ мүмкін қате естіппін…
Dialogue: 0,0:20:31.49,0:20:35.60,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:35.60,0:20:38.43,Default,,0,0,0,,Уф... Хамф!
Dialogue: 0,0:20:38.43,0:20:43.64,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:43.64,0:20:45.67,Default,,0,0,0,,Гах!!
Dialogue: 0,0:20:45.67,0:20:50.18,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:20:50.18,0:20:53.05,Default,,0,0,0,,Ха!! Уф...
Dialogue: 0,0:20:53.05,0:21:02.89,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:21:02.89,0:21:06.49,Default,,0,0,0,,Менің қайта жасағаным шикигами сияқты➡
Dialogue: 0,0:21:06.49,0:21:09.76,Default,,0,0,0,,Егер бұл қарапайым команда болса, оны беруге болады. ➡
Dialogue: 0,0:21:09.76,0:21:13.60,Default,,0,0,0,,Тіпті ас үй пышақтары әдетте ұшпайды.
Dialogue: 0,0:21:13.60,0:21:17.74,Default,,0,0,0,,Сіздің жеке басыңызды ескеру мағынасыз деп ойлаймын, бірақ мен бәрібір тыңдаймын.
Dialogue: 0,0:21:17.74,0:21:22.01,Default,,0,0,0,,Маған ұпай берсең, мен сені оңай өлтіремін, жарай ма?
Dialogue: 0,0:21:22.01,0:21:25.21,Default,,0,0,0,,Кедергі техникасы қиын.
Dialogue: 0,0:21:26.51,0:21:29.38,Default,,0,0,0,,Мәңгілік нақты кеңістікте➡
Dialogue: 0,0:21:29.38,0:21:33.62,Default,,0,0,0,,Мен әртүрлі масштабтағы псевдокеңістіктердің қабаттасуын түсіне алмаймын.
Dialogue: 0,0:21:33.62,0:21:35.96,Default,,0,0,0,,Сонымен.
Dialogue: 0,0:21:35.96,0:21:38.56,Default,,0,0,0,,Қара тесік!
Dialogue: 0,0:21:38.56,0:21:42.00,Default,,0,0,0,,Осы гимназия кеңістігін сол күйінде қалдырыңыз➡
Dialogue: 0,0:21:42.00,0:21:44.83,Default,,0,0,0,,Оны менің доменім ретінде бұрыңыз.
Dialogue: 0,0:21:44.83,0:21:46.87,Default,,0,0,0,,≪Оны қолдануға бола ма...≫
Dialogue: 0,0:21:46.87,0:22:06.82,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:06.82,0:22:11.43,Default,,0,0,0,,Аймақты кеңейту. `` Жұптасу қараңғы бақ ''.
Dialogue: 0,0:22:11.43,0:22:13.46,Default,,0,0,0,,Докун... (жүрек соғысы)
Dialogue: 0,0:22:13.46,0:22:18.23,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:18.23,0:22:21.57,Default,,0,0,0,,>
Dialogue: 0,0:22:21.57,0:22:25.87,Default,,0,0,0,,Мен керемет әдістер жоқ деп айтпаймын.
Dialogue: 0,0:22:28.71,0:22:35.38,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:22:35.38,0:22:39.15,Default,,0,0,0,,♬ Қараңғы күндерде жоқ көлеңке
Dialogue: 0,0:22:39.15,0:22:41.79,Default,,0,0,0,,♬ Мен ренжідім.
Dialogue: 0,0:22:41.79,0:22:45.09,Default,,0,0,0,,♬ Кешірім сұрау сияқты.
Dialogue: 0,0:22:45.09,0:22:50.83,Default,,0,0,0,,♬ Өкінішті, егілген тұқымдар гүлдей бастайды
Dialogue: 0,0:22:50.83,0:22:54.67,Default,,0,0,0,,♬ Барған сайын суып барасың
Dialogue: 0,0:22:54.67,0:22:57.97,Default,,0,0,0,,♬ Ұзарған алақан аспанды қиып тұр
Dialogue: 0,0:22:57.97,0:23:00.98,Default,,0,0,0,,♬ Жағдайлар қалпына келе ме?
Dialogue: 0,0:23:00.98,0:23:04.45,Default,,0,0,0,,♬ Толқындар жұтылады
Dialogue: 0,0:23:04.45,0:23:07.62,Default,,0,0,0,,♬ Болашақты жойып, жалғастырыңыз
Dialogue: 0,0:23:07.62,0:23:12.32,Default,,0,0,0,,♬ Ақырзаман келе ме?
Dialogue: 0,0:23:12.32,0:23:16.69,Default,,0,0,0,,♬ Үзіліп, жарылып кетсем
Dialogue: 0,0:23:16.69,0:23:19.29,Default,,0,0,0,,♬ Байғұс шашылып кетсе де
Dialogue: 0,0:23:19.29,0:23:21.86,Default,,0,0,0,,♬ Мен ештеңеден қорықпаймын
Dialogue: 0,0:23:21.86,0:23:23.90,Default,,0,0,0,,♬ Өйткені қазірдің өзінде
Dialogue: 0,0:23:23.90,0:23:25.93,Default,,0,0,0,,♬ Өйткені ол әлдеқашан бос
Dialogue: 0,0:23:25.93,0:23:28.27,Default,,0,0,0,,♬ Ах, соңында
Dialogue: 0,0:23:28.27,0:23:31.57,Default,,0,0,0,,♬ Бұл шамды міндетті түрде өшіріңіз.
Dialogue: 0,0:23:31.57,0:23:34.98,Default,,0,0,0,,♬ Мен енді ештеңе қаламаймын
Dialogue: 0,0:23:34.98,0:23:38.05,Default,,0,0,0,,♬ Себебі мен оны қайтадан жоғалтып алудан қорқамын
Dialogue: 0,0:23:38.05,0:23:40.41,Default,,0,0,0,,♬ Таң атуға жақын болса да
Dialogue: 0,0:23:40.41,0:23:43.48,Default,,0,0,0,,♬ Тұман әлі сейілмейді
Dialogue: 0,0:23:43.48,0:23:46.42,Default,,0,0,0,,♬ Сол түсініксіз схема
Dialogue: 0,0:23:46.42,0:23:49.02,Default,,0,0,0,,♬ Бақылау кезінде
Dialogue: 0,0:23:49.02,0:23:52.59,Default,,0,0,0,,♬ Мен келе жатырмын
Dialogue: 0,0:23:52.59,0:23:56.90,Default,,0,0,0,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:24:00.27,0:24:03.64,Default,,0,0,0,,Аумағы аяқталмаған болса да аумақ болып табылады. «Арнайы»➡ шығарыңыз
Dialogue: 0,0:24:03.64,0:24:06.11,Default,,0,0,0,,Іске қосыңыз! ! ! Әзірше емес!! Тек ұстаңыз!!
Dialogue: 0,0:24:06.11,0:24:08.94,Default,,0,0,0,,Мен мойындаймын. Қайсысы бірінші құлайды?
Dialogue: 0,0:24:08.94,0:24:11.55,Default,,0,0,0,,Құлап қалмаңыз!
Dialogue: 0,0:24:13.05,0:24:18.05,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
