Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.60,0:00:26.44,Default,,0,0,0,,Бүгін 13:30-дан бастап
Dialogue: 0,0:00:26.52,0:00:28.31,Default,,0,0,0,,Нью-Йорктің Жоғарғы шығанағында жүзу
Dialogue: 0,0:00:28.40,0:00:30.11,Default,,0,0,0,,Эллис аралындағы арнайы орын
Dialogue: 0,0:00:30.19,0:00:32.40,Default,,0,0,0,,G7 саммиті өтеді
Dialogue: 0,0:00:32.90,0:00:35.45,Default,,0,0,0,,Дүние жүзіндегі елдер суицид туралы заңдармен шайқалуда
Dialogue: 0,0:00:35.53,0:00:39.33,Default,,0,0,0,,Біздің әлемді басқару жеті көшбасшыға тапсырылды.
Dialogue: 0,0:00:39.83,0:00:42.00,Default,,0,0,0,,Олар қандай таңдау жасайды?
Dialogue: 0,0:00:42.50,0:00:45.54,Default,,0,0,0,,Өз-өзіне қол жұмсау туралы заң мақұлданды ма немесе қабылданбады ма?
Dialogue: 0,0:00:46.04,0:00:50.92,Default,,0,0,0,,Үш ел әлі де өз ұстанымдарын ұстанбай отыр: АҚШ, Жапония және Германия.
Dialogue: 0,0:00:51.00,0:00:55.93,Default,,0,0,0,,Олардың ішінде дүниенің кілтін ұстаған АҚШ төраға ел болып табылады.
Dialogue: 0,0:00:56.01,0:00:58.93,Default,,0,0,0,,Және «ойшыл»
Dialogue: 0,0:00:59.47,0:01:01.06,Default,,0,0,0,,Сондай-ақ Нью-Йорк уақыты бойынша...
Dialogue: 0,0:01:01.14,0:01:04.52,Default,,0,0,0,,Жаңа аймақтағы суицид саммиті туралы
Dialogue: 0,0:01:04.60,0:01:05.35,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:01:05.94,0:01:07.31,Default,,0,0,0,,Мен осы шыңға дейін бардым.
Dialogue: 0,0:01:07.40,0:01:09.23,Default,,0,0,0,,Сенің мені ұрдың дегені
Dialogue: 0,0:01:09.73,0:01:12.03,Default,,0,0,0,,Сай әрқашан бірдеңеге ұмтылады.
Dialogue: 0,0:01:12.82,0:01:16.53,Default,,0,0,0,,Дегенмен, әйелдерді ең қауіпті деп санау керек...
Dialogue: 0,0:01:16.61,0:01:18.53,Default,,0,0,0,,Куйо Ай
Dialogue: 0,0:01:20.24,0:01:21.87,Default,,0,0,0,,«Жеті патша»
Dialogue: 0,0:01:21.95,0:01:24.45,Default,,0,0,0,,Біз қандай шешім қабылдаймыз?
Dialogue: 0,0:01:25.00,0:01:26.50,Default,,0,0,0,,♪～
Dialogue: 0,0:01:26.58,0:01:27.87,Default,,0,0,0,,Киелі кітап
Dialogue: 0,0:01:28.63,0:01:33.21,Default,,0,0,0,,Жоханның Аянында сипатталған жеті басты аң
Dialogue: 0,0:01:33.71,0:01:37.18,Default,,0,0,0,,Апокалипсистің бұл аңы «жеті патшаны» білдіреді
Dialogue: 0,0:01:37.26,0:01:39.97,Default,,0,0,0,,Оның арқасында әйел
Dialogue: 0,0:01:40.80,0:01:43.47,Default,,0,0,0,,Әйел киелілердің қанына мас.
Dialogue: 0,0:01:43.56,0:01:47.52,Default,,0,0,0,,Ақырында біз Құдайдың алдында күйіп, соттаймыз
Dialogue: 0,0:01:48.73,0:01:50.56,Default,,0,0,0,,Әйелдің аты кім?
Dialogue: 0,0:01:51.06,0:01:53.57,Default,,0,0,0,,Ұлы жезөкше Вавилон
Dialogue: 0,0:01:53.65,0:01:54.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:02.58,0:02:04.08,Default,,0,0,0,,Біріншіден, әрбір ел
Dialogue: 0,0:02:04.16,0:02:06.75,Default,,0,0,0,,Өз ұстанымыңызды білдіру туралы не айтасыз?
Dialogue: 0,0:02:07.46,0:02:10.21,Default,,0,0,0,,Суицид туралы заңдарды қолдау және мақұлдау
Dialogue: 0,0:02:10.29,0:02:11.25,Default,,0,0,0,,Алдымен...
Dialogue: 0,0:02:11.33,0:02:12.38,Default,,0,0,0,,Менен
Dialogue: 0,0:02:12.46,0:02:15.21,Default,,0,0,0,,Енді, премьер-министр Кэри, өтінемін.
Dialogue: 0,0:02:15.30,0:02:19.34,Default,,0,0,0,,Канадада суицид туралы заңнама рухы бар
Dialogue: 0,0:02:19.88,0:02:24.14,Default,,0,0,0,,Біздің ел гомосексуализмге қарсы саясат жүргізді.
Dialogue: 0,0:02:24.22,0:02:28.27,Default,,0,0,0,,Жыныстық қатынасты қабылдаудың өзгеруі – адамзаттың прогрессі.
Dialogue: 0,0:02:28.35,0:02:33.98,Default,,0,0,0,,Адамдар биологиялық шектеулерге ұшырамай-ақ өзінің жыныстық қатынасын таңдау еркіндігіне құқығы бар.
Dialogue: 0,0:02:34.07,0:02:36.40,Default,,0,0,0,,Хмм... Айтайын дегенім, сіз.
Dialogue: 0,0:02:36.48,0:02:39.99,Default,,0,0,0,,Өмір ұзақтығы да шектеу деп айтасыз ба?
Dialogue: 0,0:02:40.07,0:02:41.99,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:02:42.07,0:02:44.33,Default,,0,0,0,,Өлім уақытын таңдай білу
Dialogue: 0,0:02:44.41,0:02:47.50,Default,,0,0,0,,Өмір сүру ұзақтығының физикалық шектеулерінен шығу
Dialogue: 0,0:02:47.58,0:02:50.54,Default,,0,0,0,,Егер солай болса, онда бұл да мәндердің бірі.
Dialogue: 0,0:02:50.62,0:02:52.00,Default,,0,0,0,,Төзуге тиіс
Dialogue: 0,0:02:52.08,0:02:52.96,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:53.04,0:02:54.84,Default,,0,0,0,,Канада не ойлайды?
Dialogue: 0,0:02:54.92,0:02:58.92,Default,,0,0,0,,Өз-өзіне қол жұмсайтындар азшылық деген тұжырымға негізделген.
Dialogue: 0,0:02:59.42,0:03:02.97,Default,,0,0,0,,Олар көпшілік болатынын ойламайды.
Dialogue: 0,0:03:03.05,0:03:05.47,Default,,0,0,0,,Гомосексуализмнен айырмашылығы т.б.
Dialogue: 0,0:03:05.56,0:03:08.52,Default,,0,0,0,,Өз-өзіне қол жұмсау көбейсе, ел түбінде жойылады.
Dialogue: 0,0:03:09.02,0:03:11.48,Default,,0,0,0,,Өйткені халық саны азайып келеді.
Dialogue: 0,0:03:11.56,0:03:12.56,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:03:13.06,0:03:17.86,Default,,0,0,0,,Елдің басында тұрғандарға 50 жылдан 100 жылға дейін үкім керек.
Dialogue: 0,0:03:19.03,0:03:22.03,Default,,0,0,0,,Француздық ұстанымымды білдіру
Dialogue: 0,0:03:22.53,0:03:24.62,Default,,0,0,0,,Суицид заңы танылмайды
Dialogue: 0,0:03:24.70,0:03:28.54,Default,,0,0,0,,Қоғамға кері әсер ету мүмкіндігі болса
Dialogue: 0,0:03:28.62,0:03:29.87,Default,,0,0,0,,Алынып тасталсын
Dialogue: 0,0:03:29.95,0:03:31.46,Default,,0,0,0,,Мен көрдім бе?
Dialogue: 0,0:03:31.96,0:03:33.67,Default,,0,0,0,,Сәлеметсіз бе, Франция Президенті!
Dialogue: 0,0:03:33.75,0:03:37.46,Default,,0,0,0,,Саясат дегенді тек плюс пен минус деп есептейтін сияқтысыз.
Dialogue: 0,0:03:37.55,0:03:42.43,Default,,0,0,0,,Италияның суицид туралы заңы қанша тұрады? Тіл жалау ма?
Dialogue: 0,0:03:42.51,0:03:45.43,Default,,0,0,0,,Мен негізі бизнесменмін.
Dialogue: 0,0:03:45.51,0:03:48.68,Default,,0,0,0,,Менің және Италияның идеологиясы анық.
Dialogue: 0,0:03:49.43,0:03:53.77,Default,,0,0,0,,Өз-өзіне қол жұмсау туралы заңдарды мақұлдау немесе қабылдамау елдің еркінде емес.
Dialogue: 0,0:03:54.44,0:03:56.90,Default,,0,0,0,,Бұл оның бейтарап екенін білдіре ме?
Dialogue: 0,0:03:56.98,0:03:59.40,Default,,0,0,0,,Маған еркіндік берші
Dialogue: 0,0:03:59.48,0:04:03.66,Default,,0,0,0,,Жақсы болса дамиды; егер ол жаман болса, ол жоғалады.
Dialogue: 0,0:04:03.74,0:04:08.03,Default,,0,0,0,,Егер суицид туралы заң пайда әкелсе, бұл жақсы.
Dialogue: 0,0:04:08.62,0:04:10.87,Default,,0,0,0,,Либерализмге соқыр сенім
Dialogue: 0,0:04:10.95,0:04:14.12,Default,,0,0,0,,Менің ойымша, нәтиже демократиядан жақсырақ.
Dialogue: 0,0:04:14.21,0:04:19.42,Default,,0,0,0,,Осы тұрғыдан алғанда, қазіргі неміс құқығы мүлдем түсініксіз.
Dialogue: 0,0:04:19.50,0:04:23.63,Default,,0,0,0,,Иә, суицид заңсыз әрекет емес, бірақ
Dialogue: 0,0:04:23.72,0:04:27.10,Default,,0,0,0,,Жұмыс орнында өзін-өзі өлтіруге көмектесу жазасы... Бұл болды ма?
Dialogue: 0,0:04:27.60,0:04:30.10,Default,,0,0,0,,Бұл қос стандарт, солай ма?
Dialogue: 0,0:04:31.18,0:04:34.14,Default,,0,0,0,,Каннаваро айтқандай, біздің ел
Dialogue: 0,0:04:34.23,0:04:39.23,Default,,0,0,0,,Өлім құқығына қатысты нақты саясатты шеше алмау және суицидке көмектесу
Dialogue: 0,0:04:39.82,0:04:41.40,Default,,0,0,0,,Сіз оны қабылдайсыз ба?
Dialogue: 0,0:04:42.19,0:04:45.95,Default,,0,0,0,,Бірақ бүгін мен сізге жауап беремін.
Dialogue: 0,0:04:46.45,0:04:50.62,Default,,0,0,0,,Германия Федеративтік Республикасы өзін-өзі өлтіру құқығын мойындайды.
Dialogue: 0,0:04:50.70,0:04:52.33,Default,,0,0,0,,Канцлер Герригель!
Dialogue: 0,0:04:52.41,0:04:53.87,Default,,0,0,0,,Келесі, Наоми Минами ісіне қатысты:
Dialogue: 0,0:04:54.46,0:04:59.25,Default,,0,0,0,,Егер біз қазір өз-өзіне қол жұмсау туралы заңды жоққа шығарсақ, біз оны қарастыра алмаймыз.
Dialogue: 0,0:04:59.96,0:05:04.88,Default,,0,0,0,,Германияның өзін-өзі өлтіру туралы заңын қолдау үздіксіз тексеру үшін белсенді түрде тоқтатылады
Dialogue: 0,0:05:04.97,0:05:07.14,Default,,0,0,0,,Өкінішті...
Dialogue: 0,0:05:07.64,0:05:09.18,Default,,0,0,0,,Сіз шынымен солайсыз
Dialogue: 0,0:05:09.26,0:05:12.31,Default,,0,0,0,,Елдің биігінен көрінетін адамсың ба?
Dialogue: 0,0:05:12.39,0:05:16.73,Default,,0,0,0,,Билігі барлар әлеуметтік нормаларды белгілеуге міндетті.
Dialogue: 0,0:05:16.81,0:05:20.65,Default,,0,0,0,,Асылдың міндеттемесі Асылдың міндеті ме?
Dialogue: 0,0:05:22.28,0:05:28.16,Default,,0,0,0,,Азаматтар біздің мінез-құлқымызға қарап, дұрыс жолдың не екенін біледі.
Dialogue: 0,0:05:29.12,0:05:31.45,Default,,0,0,0,,Біз үйретуіміз керек
Dialogue: 0,0:05:31.53,0:05:34.54,Default,,0,0,0,,Адамдар ұмытпауы керек маңызды нәрселер
Dialogue: 0,0:05:34.62,0:05:36.41,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:36.50,0:05:39.00,Default,,0,0,0,,Өлім – жоқтау керек нәрсе.
Dialogue: 0,0:05:40.08,0:05:43.17,Default,,0,0,0,,Біріккен Корольдік Мәртебелі Королеваның атынан
Dialogue: 0,0:05:44.01,0:05:46.55,Default,,0,0,0,,Суицид туралы заңдарды мүлде құптамаңыз
Dialogue: 0,0:05:47.18,0:05:51.05,Default,,0,0,0,,Тіпті біз мұнда басқа елдермен серіктес болсақ та.
Dialogue: 0,0:05:51.14,0:05:52.81,Default,,0,0,0,,Оны құрту деген сөз болса да
Dialogue: 0,0:05:52.89,0:05:54.14,Default,,0,0,0,,Хо…
Dialogue: 0,0:05:54.22,0:05:59.31,Default,,0,0,0,,Сіз өз-өзіне қол жұмсау туралы заңдарды енгізген елмен Ұлыбритания соғысады деп айтасыз ба?
Dialogue: 0,0:05:59.40,0:06:00.23,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:06:01.11,0:06:03.98,Default,,0,0,0,,Жоқ... тынышталыңыз.
Dialogue: 0,0:06:04.48,0:06:08.61,Default,,0,0,0,,Суицид туралы заңдар елдер арасындағы достықты бұзады, т.б.
Dialogue: 0,0:06:08.70,0:06:09.82,Default,,0,0,0,,Болмауы керек
Dialogue: 0,0:06:10.32,0:06:11.66,Default,,0,0,0,,Соғысты айтпағанда...
Dialogue: 0,0:06:11.74,0:06:13.95,Default,,0,0,0,,Мен тынышпын
Dialogue: 0,0:06:14.45,0:06:17.83,Default,,0,0,0,,Соғыс сөзіне кім истерикалық реакция білдіреді?
Dialogue: 0,0:06:17.91,0:06:20.25,Default,,0,0,0,,Бұл сіз, премьер-министр Фукузава.
Dialogue: 0,0:06:20.33,0:06:23.09,Default,,0,0,0,,Әр соғысқа аллергияңыз бар ма?
Dialogue: 0,0:06:23.17,0:06:25.84,Default,,0,0,0,,Ол қай елде пайда болды?
Dialogue: 0,0:06:25.92,0:06:31.34,Default,,0,0,0,,Мұның бәрі еліміздегі жаңа жергілікті басқару аймақтарынан басталды.
Dialogue: 0,0:06:31.93,0:06:35.56,Default,,0,0,0,,Жапон үкіметі ретінде біз үлкен жауапкершілікті сезінеміз.
Dialogue: 0,0:06:35.64,0:06:38.06,Default,,0,0,0,,Ауызбен кез келген нәрсені айтуға болады.
Dialogue: 0,0:06:38.56,0:06:42.86,Default,,0,0,0,,Сонымен, жапон үкіметі суицид туралы заңды мойындай ма?
Dialogue: 0,0:06:42.94,0:06:44.36,Default,,0,0,0,,Сіз оны жоққа шығарасыз ба?
Dialogue: 0,0:06:46.07,0:06:50.78,Default,,0,0,0,,Жапон үкіметінің еркі өз-өзіне қол жұмсау туралы заңның орынды немесе дұрыс еместігін анықтамайды.
Dialogue: 0,0:06:52.24,0:06:56.91,Default,,0,0,0,,Жапония осы саммитте шешілген саясатты ұстанатын болады.
Dialogue: 0,0:06:56.99,0:06:59.87,Default,,0,0,0,,Толық орындауға уәде беремін
Dialogue: 0,0:06:59.96,0:07:02.17,Default,,0,0,0,,Ха, бұл толық лақтыру емес пе?
Dialogue: 0,0:07:02.25,0:07:04.50,Default,,0,0,0,,Сіздің жеке ойыңыз жоқ па?
Dialogue: 0,0:07:04.59,0:07:08.21,Default,,0,0,0,,Дегенмен, шарттар бар
Dialogue: 0,0:07:08.30,0:07:09.63,Default,,0,0,0,,Шарттары қандай?
Dialogue: 0,0:07:10.13,0:07:10.68,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:11.88,0:07:13.80,Default,,0,0,0,,Бірауыздан болуы керек
Dialogue: 0,0:07:13.89,0:07:14.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:16.01,0:07:21.52,Default,,0,0,0,,Осы саммитте айтылған пікірлер барлық қатысушы елдердің ортақ көзқарастары болып табылады.
Dialogue: 0,0:07:22.02,0:07:25.61,Default,,0,0,0,,Суицид туралы заң тек дау-дамайға айналады.
Dialogue: 0,0:07:25.69,0:07:27.28,Default,,0,0,0,,Олай болмауы керек.
Dialogue: 0,0:07:27.36,0:07:31.53,Default,,0,0,0,,Ха, соғысты жек көру осы жағдайға жеткенде ақылсыздық.
Dialogue: 0,0:07:31.61,0:07:32.70,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:33.20,0:07:36.78,Default,,0,0,0,,Нағыз ессіздік - соғыс рухы.
Dialogue: 0,0:07:46.00,0:07:48.67,Default,,0,0,0,,Мен мұны соңғы рет әдейі жасадым.
Dialogue: 0,0:07:48.75,0:07:50.88,Default,,0,0,0,,Сіз бұл туралы бұрыннан ойладыңыз, солай ма?
Dialogue: 0,0:07:51.38,0:07:54.22,Default,,0,0,0,,Ой, кешіріңіз, ол аяқталған жоқ.
Dialogue: 0,0:07:54.30,0:07:54.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:55.72,0:07:57.93,Default,,0,0,0,,Менің саясатым қандай?
Dialogue: 0,0:07:58.51,0:08:00.27,Default,,0,0,0,,Ал...
Dialogue: 0,0:08:00.81,0:08:05.65,Default,,0,0,0,,Бір күні шіркеуде мен пастордың Он өсиет туралы айтқанын естідім.
Dialogue: 0,0:08:05.73,0:08:07.94,Default,,0,0,0,,Бұл өте қызық.
Dialogue: 0,0:08:08.73,0:08:14.61,Default,,0,0,0,,Он өсиет екіге бөлінеді: «Құдайды сүй» және «Жақыныңды сүй».
Dialogue: 0,0:08:14.70,0:08:16.95,Default,,0,0,0,,Оны жеңілдетуге болады.
Dialogue: 0,0:08:17.03,0:08:19.16,Default,,0,0,0,,Ендеше, бұдан былай барлығына
Dialogue: 0,0:08:19.24,0:08:22.33,Default,,0,0,0,,Мен суицид туралы заңдардан басқа нәрсе туралы айтқым келеді.
Dialogue: 0,0:08:22.83,0:08:25.63,Default,,0,0,0,,Суицид туралы заңға жауап беру
Dialogue: 0,0:08:26.13,0:08:28.46,Default,,0,0,0,,Сіз не айтқыңыз келеді?
Dialogue: 0,0:08:28.54,0:08:31.42,Default,,0,0,0,,Сонымен, біз...
Dialogue: 0,0:08:31.92,0:08:36.18,Default,,0,0,0,,Біз қарапайым және негізгі нәрсе туралы айтуымыз керек.
Dialogue: 0,0:08:36.26,0:08:38.97,Default,,0,0,0,,Өз-өзіне қол жұмсау туралы заңдардың оң және теріс жақтарын бағалау үшін?
Dialogue: 0,0:08:39.06,0:08:40.14,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:08:40.93,0:08:46.40,Default,,0,0,0,,Мен өз-өзіне қол жұмсау туралы заңдар жақсы ма, әлде жаман ба деп ойладым.
Dialogue: 0,0:08:46.48,0:08:48.98,Default,,0,0,0,,Мен мүлдем жауап таба алмадым.
Dialogue: 0,0:08:49.07,0:08:51.61,Default,,0,0,0,,Бірақ мен кейін түсіндім
Dialogue: 0,0:08:53.49,0:08:57.91,Default,,0,0,0,,Мен ненің жақсы не жаман екенін анықтауға мүмкіндік болмады.
Dialogue: 0,0:08:57.99,0:09:02.41,Default,,0,0,0,,Өйткені мен жақсылық пен жамандықтың не екенін білмедім.
Dialogue: 0,0:09:04.50,0:09:08.67,Default,,0,0,0,,Сонымен, осы саммитте мен сіздермен сөйлескім келеді
Dialogue: 0,0:09:09.42,0:09:12.92,Default,,0,0,0,,«Жақсылық пен жамандық дегеніміз не?»
Dialogue: 0,0:09:13.01,0:09:16.55,Default,,0,0,0,,Алекс... сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:09:16.63,0:09:18.93,Default,,0,0,0,,Әлде сен шынымен ақымақсың ба?
Dialogue: 0,0:09:19.01,0:09:22.18,Default,,0,0,0,,Ненің дұрыс, ненің бұрыс екенін шешеміз бе?
Dialogue: 0,0:09:22.77,0:09:26.60,Default,,0,0,0,,Жақсылық пен жамандық онша оңай анықталмайды.
Dialogue: 0,0:09:26.69,0:09:27.73,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:29.15,0:09:31.23,Default,,0,0,0,,Біз ұлт өкілдеріміз.
Dialogue: 0,0:09:31.32,0:09:32.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:35.86,0:09:39.41,Default,,0,0,0,,Мүмкін тым алыс емес болашақта
Dialogue: 0,0:09:39.49,0:09:43.16,Default,,0,0,0,,Біздің әлем бір ұлтқа айналуы мүмкін
Dialogue: 0,0:09:44.04,0:09:48.92,Default,,0,0,0,,Сол күні біз әлем азаматтарын көндіре аламыз⸺
Dialogue: 0,0:09:49.00,0:09:52.04,Default,,0,0,0,,Біз әмбебап стандартты табуымыз керек
Dialogue: 0,0:09:52.75,0:09:53.71,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:54.21,0:09:56.76,Default,,0,0,0,,Дұрыс және бұрыс нормалар
Dialogue: 0,0:10:10.69,0:10:13.27,Default,,0,0,0,,Жарайды, сөйлесейік.
Dialogue: 0,0:10:13.36,0:10:14.94,Default,,0,0,0,,Сәлем Флора!
Dialogue: 0,0:10:15.03,0:10:19.74,Default,,0,0,0,,Егер мен бүгін, осы жерде және қазір жақсылық пен жамандықтың не екенін түсінетін болсам.
Dialogue: 0,0:10:19.82,0:10:22.20,Default,,0,0,0,,Ағымдағы жағдайға алаңдаушылықпен бір болу үшін
Dialogue: 0,0:10:22.28,0:10:23.83,Default,,0,0,0,,Әдеттегі саммиттен
Dialogue: 0,0:10:24.49,0:10:27.33,Default,,0,0,0,,Біз оны әлдеқайда тиімді деп санаймыз
Dialogue: 0,0:10:27.41,0:10:28.83,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:29.33,0:10:32.84,Default,,0,0,0,,Егер біз дұрыс пен бұрыстың жалпыға бірдей стандарттары туралы айтқымыз келсе.
Dialogue: 0,0:10:32.92,0:10:35.09,Default,,0,0,0,,Елдер бөлінбейді.
Dialogue: 0,0:10:36.01,0:10:37.47,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:10:37.55,0:10:41.09,Default,,0,0,0,,Жақсылық пен жамандық - суицидпен салыстырылатын шкала бойынша ұсыныстар.
Dialogue: 0,0:10:42.51,0:10:47.18,Default,,0,0,0,,Жауап: оның үлкен нарықтық құны бар.
Dialogue: 0,0:10:49.60,0:10:52.86,Default,,0,0,0,,Бұл жігітті кім болжайды?
Dialogue: 0,0:10:53.61,0:10:55.44,Default,,0,0,0,,Жақсы, мен саған айтамын.
Dialogue: 0,0:10:55.94,0:10:59.32,Default,,0,0,0,,Дұрыс-бұрысқа жауап жоқ.
Dialogue: 0,0:11:02.70,0:11:07.33,Default,,0,0,0,,Саммит шынымен де қызықты болды ма?
Dialogue: 0,0:11:08.41,0:11:10.71,Default,,0,0,0,,А... Бұл бірауыздан ма?
Dialogue: 0,0:11:12.71,0:11:13.58,Default,,0,0,0,,Иә
Dialogue: 0,0:11:14.21,0:11:18.26,Default,,0,0,0,,Бұл ұзаққа созылады.
Dialogue: 0,0:11:25.01,0:11:27.35,Default,,0,0,0,,Жақсылық пен жамандық қарама-қарсы ұғымдар
Dialogue: 0,0:11:27.97,0:11:31.19,Default,,0,0,0,,Менің ойымша, параллель ойлау қиын.
Dialogue: 0,0:11:31.77,0:11:33.19,Default,,0,0,0,,Менің ойымша, солай ма?
Dialogue: 0,0:11:33.27,0:11:38.40,Default,,0,0,0,,Осыған сену арқылы жақсылық пен жамандық параллель болуы мүмкін.
Dialogue: 0,0:11:38.98,0:11:41.28,Default,,0,0,0,,Заң ізгілікке негізделген
Dialogue: 0,0:11:41.36,0:11:43.49,Default,,0,0,0,,Жамандыққа негізделген заң жоқ.
Dialogue: 0,0:11:43.99,0:11:46.41,Default,,0,0,0,,Жақсылық тұрғысынан ойлау орынды болар еді.
Dialogue: 0,0:11:46.99,0:11:50.45,Default,,0,0,0,,Енді... не жақсы?
Dialogue: 0,0:11:50.54,0:11:55.58,Default,,0,0,0,,Сөздік анықтамасы бойынша моральдық тұрғыдан дұрыс.
Dialogue: 0,0:11:55.67,0:11:59.34,Default,,0,0,0,,Мораль әлеуметтік норма емес пе?
Dialogue: 0,0:11:59.42,0:12:03.05,Default,,0,0,0,,Қоғамда туатын нәрсені білдіреді ме?
Dialogue: 0,0:12:03.13,0:12:07.56,Default,,0,0,0,,Өзімнен басқа ешкім болмаса, жақсылық та, жамандық та жоқ.
Dialogue: 0,0:12:07.64,0:12:09.60,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:12:09.68,0:12:13.98,Default,,0,0,0,,Бұл дүниеде бір ғана адам болса да, жақсылық пен жамандықтың бар екені анық.
Dialogue: 0,0:12:14.56,0:12:17.94,Default,,0,0,0,,Мысалы, таза болу, өнегелі болу
Dialogue: 0,0:12:18.02,0:12:21.57,Default,,0,0,0,,Адам ретінде мақтаныш жақсы нәрсе ме?
Dialogue: 0,0:12:21.65,0:12:25.53,Default,,0,0,0,,Флора Ол да әлеуметтен пайда болды.
Dialogue: 0,0:12:26.03,0:12:28.03,Default,,0,0,0,,Құдайға көрсететін жақсылық
Dialogue: 0,0:12:28.12,0:12:30.04,Default,,0,0,0,,Шынында да, иә.
Dialogue: 0,0:12:30.54,0:12:33.21,Default,,0,0,0,,Біздің мінез-құлық кодексі мынаған негізделген
Dialogue: 0,0:12:33.29,0:12:37.21,Default,,0,0,0,,Құдай көріп тұр деген күшті сезім бар.
Dialogue: 0,0:12:37.29,0:12:41.13,Default,,0,0,0,,Жапонияда «жаза» деген сөз де бар.
Dialogue: 0,0:12:41.21,0:12:44.55,Default,,0,0,0,,Хмм, біріншіден, не жақсы?
Dialogue: 0,0:12:44.63,0:12:47.64,Default,,0,0,0,,Бұл тек адамдарда ғана бола ма?
Dialogue: 0,0:12:47.72,0:12:51.81,Default,,0,0,0,,Топ жақсылық пен жамандықты білдіретін факторға айналса
Dialogue: 0,0:12:51.89,0:12:55.19,Default,,0,0,0,,Пілдер мен маймылдар сияқты топтарда өмір сүретін жануарлар үшін,
Dialogue: 0,0:12:55.27,0:12:57.77,Default,,0,0,0,,Мүмкін бар...
Dialogue: 0,0:12:57.86,0:13:03.53,Default,,0,0,0,,Қалай ойлайсыңдар, пілдерде «жамандық» сезімі бар ма?
Dialogue: 0,0:13:03.61,0:13:08.32,Default,,0,0,0,,Сырттан қарағанда біз де солай сезінген шығармыз.
Dialogue: 0,0:13:08.41,0:13:10.95,Default,,0,0,0,,Иә! Міне, Лука
Dialogue: 0,0:13:11.04,0:13:12.08,Default,,0,0,0,,Не?
Dialogue: 0,0:13:12.16,0:13:14.71,Default,,0,0,0,,Басқаша айтқанда, жақсылық пен жамандық
Dialogue: 0,0:13:14.79,0:13:19.08,Default,,0,0,0,,Адамдар оны кейінірек атады.
Dialogue: 0,0:13:23.30,0:13:26.38,Default,,0,0,0,,Ең алдымен сіздерді осы күнмен құттықтағым келеді.
Dialogue: 0,0:13:26.47,0:13:27.84,Default,,0,0,0,,Мен ризашылығымды білдіргім келеді
Dialogue: 0,0:13:27.93,0:13:30.47,Default,,0,0,0,,Жаңа аймақтық директор ретінде
Dialogue: 0,0:13:30.55,0:13:34.10,Default,,0,0,0,,Осы жаңа аймаққа әлемнің түкпір-түкпірінен келген барлықтарыңызға рахмет.
Dialogue: 0,0:13:34.18,0:13:36.31,Default,,0,0,0,,Мен сізді шын жүректен қарсы алғым келеді.
Dialogue: 0,0:13:36.81,0:13:37.48,Default,,0,0,0,,Бүгін біз...
Dialogue: 0,0:13:37.56,0:13:39.61,Default,,0,0,0,,Ашылуы әбден қалыпты.
Dialogue: 0,0:13:40.11,0:13:42.32,Default,,0,0,0,,Бірақ сақ болыңыз.
Dialogue: 0,0:13:42.82,0:13:46.74,Default,,0,0,0,,Мен қай уақытта не келетінін білмеймін.
Dialogue: 0,0:13:46.82,0:13:47.82,Default,,0,0,0,,Хмм…
Dialogue: 0,0:13:47.91,0:13:49.74,Default,,0,0,0,,Бәріміз бірге алға жылжуымыз үшін.
Dialogue: 0,0:13:49.82,0:13:53.74,Default,,0,0,0,,Баршаңызға белгілі, екі ай бұрын осы жерде...
Dialogue: 0,0:13:55.29,0:13:59.96,Default,,0,0,0,,Әлемде сонша түрлі аймақтар, нәсілдер мен мәдениеттер бар.
Dialogue: 0,0:14:00.04,0:14:03.25,Default,,0,0,0,,Жақсы мен бұрыстың сансыз стандарттары бар.
Dialogue: 0,0:14:04.17,0:14:05.71,Default,,0,0,0,,Жақсылықты іздеу
Dialogue: 0,0:14:05.80,0:14:09.01,Default,,0,0,0,,Сонымен қатар оларға ортақ терминдерді іздеу.
Dialogue: 0,0:14:09.09,0:14:10.80,Default,,0,0,0,,Ум...
Dialogue: 0,0:14:11.30,0:14:16.52,Default,,0,0,0,,Мен сол ортақ бөлгіштің неліктен жасалу себебі туралы ойланғым келеді.
Dialogue: 0,0:14:17.02,0:14:18.64,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:14:19.31,0:14:21.15,Default,,0,0,0,,Менің ойымша, үшеуі бар
Dialogue: 0,0:14:25.61,0:14:27.74,Default,,0,0,0,,Бірі – табиғи мұра
Dialogue: 0,0:14:27.82,0:14:30.91,Default,,0,0,0,,Адамгершілік адамзаттың алғашқы қауымында дүниеге келген.
Dialogue: 0,0:14:30.99,0:14:34.62,Default,,0,0,0,,Адамзат тараған сайын тұқым қуалайды
Dialogue: 0,0:14:34.70,0:14:39.46,Default,,0,0,0,,Адамгершілік тұқым қуалау арқылы өзгереді.
Dialogue: 0,0:14:39.54,0:14:41.46,Default,,0,0,0,,Сонда да ортақ бөлгіштер қалады
Dialogue: 0,0:14:42.04,0:14:44.71,Default,,0,0,0,,Екіншісі – алмасу және нақтылау
Dialogue: 0,0:14:44.80,0:14:49.05,Default,,0,0,0,,Біз мәдени қоғамдар арасындағы алмасу арқылы ең жақсы нәрселерді таңдадық.
Dialogue: 0,0:14:49.13,0:14:51.84,Default,,0,0,0,,Процессте не қалады
Dialogue: 0,0:14:51.93,0:14:56.47,Default,,0,0,0,,Әртүрлі жерлерде ең жақсы таңдау ретінде қабылданып, ортақ белгіге айналады
Dialogue: 0,0:14:56.56,0:14:59.27,Default,,0,0,0,,Үшіншіден, әу бастан адамзат
Dialogue: 0,0:14:59.35,0:15:03.52,Default,,0,0,0,,Бұл жалпы адамгершілікке ие үлгі.
Dialogue: 0,0:15:04.27,0:15:08.40,Default,,0,0,0,,Жақсылық пен жамандықтың нормалары адамға тән.
Dialogue: 0,0:15:08.49,0:15:11.32,Default,,0,0,0,,Бұл бөліктің ортақ бөлгіш екенін білдіре ме?
Dialogue: 0,0:15:11.41,0:15:12.82,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:15:13.32,0:15:16.95,Default,,0,0,0,,Қалай ойлайсыңдар, сәбилер туғаннан дұрыс пен бұрысты біледі ме?
Dialogue: 0,0:15:17.04,0:15:19.75,Default,,0,0,0,,Биологиялық негізге негізделсе
Dialogue: 0,0:15:19.83,0:15:21.04,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:15:21.54,0:15:25.29,Default,,0,0,0,,Мысалы, көптеген мәдениеттерде зұлымдық болып саналатын кісі өлтіру.
Dialogue: 0,0:15:25.38,0:15:30.72,Default,,0,0,0,,Бұл бір түрді өлтіруге жол бермейтін генетикалық табиғатқа сәйкес келетін мораль.
Dialogue: 0,0:15:30.80,0:15:35.22,Default,,0,0,0,,Егер солай болса, онда жануардың инстинкті ретінде туа біткен не?
Dialogue: 0,0:15:35.30,0:15:38.47,Default,,0,0,0,,Оны мораль ретінде де көрсетуге болады.
Dialogue: 0,0:15:38.56,0:15:43.06,Default,,0,0,0,,«Адам жемейтін хайуан сияқты» деп бас тартатын әңгіме емес.
Dialogue: 0,0:15:43.15,0:15:46.23,Default,,0,0,0,,Мораль күрделірек.
Dialogue: 0,0:15:47.27,0:15:50.40,Default,,0,0,0,,Дүние жүзіне ортақ жақсылық...
Dialogue: 0,0:15:51.61,0:15:55.12,Default,,0,0,0,,Жалпыға бірдей жақсылық дегеніміз не?
Dialogue: 0,0:15:57.41,0:16:03.25,Default,,0,0,0,,Жоғарыда айтып өткенімдей, кісі өлтіру көп жағдайда зұлымдық болып саналады.
Dialogue: 0,0:16:03.75,0:16:05.71,Default,,0,0,0,,Сонда қарама-қарсы ұғым
Dialogue: 0,0:16:05.79,0:16:09.46,Default,,0,0,0,,Өзгеге көмектесу жақсылық емес пе?
Dialogue: 0,0:16:09.55,0:16:11.17,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:11.26,0:16:14.59,Default,,0,0,0,,Жаман мінез-құлықтың қарама-қарсылығын елестету оңайырақ.
Dialogue: 0,0:16:15.09,0:16:18.26,Default,,0,0,0,,Мысалы, өтірік айтпа, шыншыл бол
Dialogue: 0,0:16:18.35,0:16:20.77,Default,,0,0,0,,Әділ болу жақсы емес пе?
Dialogue: 0,0:16:21.27,0:16:25.69,Default,,0,0,0,,Байлар мен кедейлер арасындағы алшақтықты жоюдың құндылығы кейде жақсы нәрсе ретінде қарастырылатыны сияқты.
Dialogue: 0,0:16:25.77,0:16:29.73,Default,,0,0,0,,Әділдікке ұмтылу жалпыға бірдей болуы керек.
Dialogue: 0,0:16:29.82,0:16:34.28,Default,,0,0,0,,Бірақ адамдарда да жеңімпаз болғысы келетін сезім бар.
Dialogue: 0,0:16:34.78,0:16:37.28,Default,,0,0,0,,Мен өзімшілдік жаман емес деп ойлаймын.
Dialogue: 0,0:16:37.87,0:16:41.41,Default,,0,0,0,,Жеке бақытқа ұмтылу шын мәнінде жақсы нәрсе.
Dialogue: 0,0:16:41.91,0:16:45.62,Default,,0,0,0,,Біз оны адамның негізгі құқығы ретінде танимыз.
Dialogue: 0,0:16:46.75,0:16:49.25,Default,,0,0,0,,Алекс Ойыңыз бар ма?
Dialogue: 0,0:16:50.00,0:16:51.92,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:16:52.42,0:16:56.55,Default,,0,0,0,,Жақсылық әлеуметтен және топтардан туындайды?
Dialogue: 0,0:16:56.64,0:16:59.26,Default,,0,0,0,,Бұл қызықты гипотеза деп ойлаймын.
Dialogue: 0,0:16:59.85,0:17:01.01,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:17:02.14,0:17:03.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:04.56,0:17:10.82,Default,,0,0,0,,Жақсы айта алмаймын, бірақ жақсылықты жан-жақты дер едім.
Dialogue: 0,0:17:11.32,0:17:15.07,Default,,0,0,0,,Ол жеке адамдарға да, топтарға да бірдей әсер етеді.
Dialogue: 0,0:17:15.15,0:17:20.03,Default,,0,0,0,,Жеке игілігі мен ұжымдық игілігі бар, бірақ ол екеуіне де пайдалы.
Dialogue: 0,0:17:20.53,0:17:24.66,Default,,0,0,0,,Бұл өте пайдалы ұғым емес пе?
Dialogue: 0,0:17:25.16,0:17:27.17,Default,,0,0,0,,Ха, бұл ыңғайлы.
Dialogue: 0,0:17:27.25,0:17:29.71,Default,,0,0,0,,Егер мұндай нәрсе бар болса
Dialogue: 0,0:17:30.63,0:17:31.71,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:31.80,0:17:34.17,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:17:34.26,0:17:37.34,Default,,0,0,0,,Сіз «троллейбус мәселесі» туралы білесіз бе?
Dialogue: 0,0:17:39.30,0:17:43.39,Default,,0,0,0,,Сіз қазір жолды ауыстыру нүктесіндесіз.
Dialogue: 0,0:17:44.14,0:17:48.27,Default,,0,0,0,,Дәл осы кезде тежегіші бұзылған арба қатты жылдамдықпен бізге қарай келеді.
Dialogue: 0,0:17:48.77,0:17:53.28,Default,,0,0,0,,Осылай жалғаса берсе, жолдың соңында бес жұмысшы өледі.
Dialogue: 0,0:17:53.86,0:17:56.36,Default,,0,0,0,,Бірақ егер сіз нүктелерді ауыстырсаңыз
Dialogue: 0,0:17:56.45,0:18:00.37,Default,,0,0,0,,Екінші жолдағы бір жұмысшы қайтыс болды.
Dialogue: 0,0:18:02.58,0:18:05.50,Default,,0,0,0,,Нүктелерді ауыстыру керек пе, жоқ па?
Dialogue: 0,0:18:06.08,0:18:10.46,Default,,0,0,0,,Егер сіз жай ғана ойлансаңыз, сізге көбірек көмектесетінін таңдайсыз.
Dialogue: 0,0:18:10.54,0:18:15.80,Default,,0,0,0,,Сандардың ізгілік туралы пайымдауға әсер ететіні анық па?
Dialogue: 0,0:18:16.55,0:18:19.47,Default,,0,0,0,,Сонымен, «орган лотереясы» туралы не деуге болады?
Dialogue: 0,0:18:19.55,0:18:20.93,Default,,0,0,0,,Орган лотереясы?
Dialogue: 0,0:18:21.64,0:18:23.68,Default,,0,0,0,,Мұнда әділ лотерея өтті делік.
Dialogue: 0,0:18:24.39,0:18:27.14,Default,,0,0,0,,Дені сау азаматтардың ішінен бір адамды таңда
Dialogue: 0,0:18:27.64,0:18:33.73,Default,,0,0,0,,Біреуін өлтіріп, мүшелерін алып, трансплантацияны қажет ететін бес адамға тарат.
Dialogue: 0,0:18:34.23,0:18:37.57,Default,,0,0,0,,Бұл бір адам өліп, бес адам құтқарылады деген сөз.
Dialogue: 0,0:18:38.07,0:18:39.11,Default,,0,0,0,,Әрекет дегеніміз не?
Dialogue: 0,0:18:39.20,0:18:42.37,Default,,0,0,0,,Бұл шектен шыққан, бұл кісі өлтіру.
Dialogue: 0,0:18:42.99,0:18:46.70,Default,,0,0,0,,Бір және бес адамның өмірін таңдау тұрғысынан,
Dialogue: 0,0:18:46.79,0:18:48.83,Default,,0,0,0,,Троллейбус мәселесі сияқты...
Dialogue: 0,0:18:49.87,0:18:54.80,Default,,0,0,0,,Жазатайым оқиғаларға жауап беру кезінде тіпті бір адамның өлімі сөзсіз болып көрінеді.
Dialogue: 0,0:18:54.88,0:18:59.97,Default,,0,0,0,,Ашық ниетпен бір адамды таңдап алып өлтіру күнә.
Dialogue: 0,0:19:00.05,0:19:02.30,Default,,0,0,0,,Яғни, сан емес
Dialogue: 0,0:19:02.39,0:19:06.39,Default,,0,0,0,,Ерік пен құралдар біздің дұрыс пен бұрыс туралы пайымдауымызға әсер етеді
Dialogue: 0,0:19:06.47,0:19:10.23,Default,,0,0,0,,Иә... троллейбус мәселесі және орган лотереясы.
Dialogue: 0,0:19:10.31,0:19:12.15,Default,,0,0,0,,Біз бір нәрсе туралы айтып отырмыз.
Dialogue: 0,0:19:12.98,0:19:15.61,Default,,0,0,0,,Екеуі де адамдарды тірі қалдыруға тырысады
Dialogue: 0,0:19:16.28,0:19:18.78,Default,,0,0,0,,Өмір сүру, пайдалану
Dialogue: 0,0:19:19.28,0:19:22.78,Default,,0,0,0,,Басқаша айтқанда, түбірінде «тіршілік» болса
Dialogue: 0,0:19:22.87,0:19:26.87,Default,,0,0,0,,Өз-өзіне қол жұмсау туралы заңдарды жек көру сезімі ақталған.
Dialogue: 0,0:19:29.12,0:19:30.96,Default,,0,0,0,,Өз-өзіне қол жұмсау - адамның қайтыс болуы
Dialogue: 0,0:19:31.75,0:19:34.71,Default,,0,0,0,,Біз «өмір сүру» және «өлу» туралы жанжалдаймыз.
Dialogue: 0,0:19:36.34,0:19:40.17,Default,,0,0,0,,Аа, дерлік бар, у...
Dialogue: 0,0:19:40.88,0:19:43.93,Default,,0,0,0,,Біз қазір не туралы ойлануымыз керек
Dialogue: 0,0:19:44.01,0:19:46.76,Default,,0,0,0,,Жақсылық пен жамандықтың түбінде жатыр
Dialogue: 0,0:19:47.26,0:19:50.85,Default,,0,0,0,,Өмір сүру деген нені білдіреді?
Dialogue: 0,0:19:51.85,0:19:52.85,Default,,0,0,0,,Алекс!
Dialogue: 0,0:19:54.15,0:19:54.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:54.94,0:19:56.27,Default,,0,0,0,,Президент!
Dialogue: 0,0:20:00.57,0:20:01.86,Default,,0,0,0,,Нью-Йорк Жоғарғы шығанағы саммиті
Dialogue: 0,0:20:01.95,0:20:04.74,Default,,0,0,0,,Барлық қатысушы мемлекет басшыларына
Dialogue: 0,0:20:04.82,0:20:07.99,Default,,0,0,0,,Бұл Сай Кайка, аймақтың жаңа басшысы.
Dialogue: 0,0:20:08.91,0:20:10.95,Default,,0,0,0,,Бұл жолы осылай біржақты болды...
Dialogue: 0,0:20:11.04,0:20:13.62,Default,,0,0,0,,2 минут бұрын Бұл Сайдың қоңырауы.
Dialogue: 0,0:20:14.21,0:20:15.50,Default,,0,0,0,,Қоңырау шалу?
Dialogue: 0,0:20:15.58,0:20:17.29,Default,,0,0,0,,Осы саммитке қарай
Dialogue: 0,0:20:17.38,0:20:19.05,Default,,0,0,0,,Айтар сөзің болса
Dialogue: 0,0:20:19.13,0:20:21.76,Default,,0,0,0,,Реле – жалпы таралатын радиотолқындар
Dialogue: 0,0:20:21.84,0:20:24.13,Default,,0,0,0,,Дүние жүзіндегі БАҚ арқылы хабар тарату
Dialogue: 0,0:20:24.84,0:20:27.01,Default,,0,0,0,,Бүгін жаңа аумақта
Dialogue: 0,0:20:27.10,0:20:30.02,Default,,0,0,0,,1-ші суицид саммиті өтті.
Dialogue: 0,0:20:30.60,0:20:35.02,Default,,0,0,0,,Келіссөздер нәтижелі болды, бірақ одан да көп нәрсе болды.
Dialogue: 0,0:20:35.65,0:20:37.94,Default,,0,0,0,,Өтетін орны болып табылатын осы жаңа аймақтағы үкімет ғимаратында.
Dialogue: 0,0:20:38.02,0:20:41.07,Default,,0,0,0,,Азаматтар суицид туралы заңды қолдау үшін жиналды.
Dialogue: 0,0:20:41.65,0:20:43.24,Default,,0,0,0,,Қазіргі уақытта үкімет ғимаратының айналасында
Dialogue: 0,0:20:43.32,0:20:45.82,Default,,0,0,0,,100 000-нан астам адаммен толтырылған
Dialogue: 0,0:20:46.53,0:20:50.58,Default,,0,0,0,,Олардың кейбіреулері, әрине, өз-өзіне қол жұмсағысы келеді.
Dialogue: 0,0:20:50.66,0:20:53.33,Default,,0,0,0,,Жаппай өз-өзіне қол жұмсауды хабарлауды жоспарлап отырсыз ба?
Dialogue: 0,0:20:53.41,0:20:56.58,Default,,0,0,0,,Екі ай бұрынғы 60 адамнан өзгеше.
Dialogue: 0,0:20:57.25,0:20:59.59,Default,,0,0,0,,Және бір өтініш беруші
Dialogue: 0,0:20:59.67,0:21:04.09,Default,,0,0,0,,Мен өз-өзіне қол жұмсау таблеткасының орнына секіру әдісін алғым келді.
Dialogue: 0,0:21:04.17,0:21:08.10,Default,,0,0,0,,Жаңа аймақтағы үкімет ғимаратының төбесі осыны қалайтындар үшін ашық болады.
Dialogue: 0,0:21:08.18,0:21:11.35,Default,,0,0,0,,Үкімет ғимаратынан секіруге рұқсат етіледі
Dialogue: 0,0:21:12.27,0:21:15.31,Default,,0,0,0,,Дегенмен, бір мәселе бар.
Dialogue: 0,0:21:15.81,0:21:16.81,Default,,0,0,0,,Мәселе бар ма?
Dialogue: 0,0:21:17.31,0:21:19.69,Default,,0,0,0,,Ол абдырап қалған сияқты.
Dialogue: 0,0:21:19.77,0:21:21.98,Default,,0,0,0,,Өлуім керек пе, өмір сүруім керек пе?
Dialogue: 0,0:21:22.65,0:21:26.03,Default,,0,0,0,,Бұл жалғыз… және ең үлкен мәселе
Dialogue: 0,0:21:26.53,0:21:29.99,Default,,0,0,0,,Өлгісі келетіндерге өз-өзіне қол жұмсауға рұқсат беру керек.
Dialogue: 0,0:21:30.66,0:21:33.41,Default,,0,0,0,,Бірақ шынымен өлгіңіз келмесе ше?
Dialogue: 0,0:21:33.50,0:21:35.25,Default,,0,0,0,,Сіз ешқашан өлмеуіңіз керек
Dialogue: 0,0:21:35.33,0:21:37.00,Default,,0,0,0,,Өз-өзіне қол жұмсамау керек
Dialogue: 0,0:21:38.08,0:21:40.96,Default,,0,0,0,,Ол жаңа аймақтағы кеңесшімен де сөйлесті.
Dialogue: 0,0:21:41.04,0:21:43.51,Default,,0,0,0,,Шешім шығара алмадым
Dialogue: 0,0:21:44.80,0:21:46.76,Default,,0,0,0,,Менің ойымша, сіз күдіктенесіз.
Dialogue: 0,0:21:47.26,0:21:50.76,Default,,0,0,0,,Мен жаңа аймақтағы адамдар суицидке итермелеуі мүмкін деп қорқамын.
Dialogue: 0,0:21:51.35,0:21:54.31,Default,,0,0,0,,Сондықтан мен, жаңа ауданның басшысы айтсам да,
Dialogue: 0,0:21:54.39,0:21:55.35,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:21:57.56,0:21:58.35,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:58.98,0:22:02.94,Default,,0,0,0,,Енді ол не өлетінін, не өмір сүретінін шеше алмайды.
Dialogue: 0,0:22:03.03,0:22:05.32,Default,,0,0,0,,Үкімет ғимаратының төбесінде
Dialogue: 0,0:22:07.57,0:22:11.78,Default,,0,0,0,,Жаңа аймақтық директор ретінде мен ресми өтініш білдіргім келеді.
Dialogue: 0,0:22:12.28,0:22:16.20,Default,,0,0,0,,Америка Құрама Штаттарының Президенті Александр В. Вуд
Dialogue: 0,0:22:16.71,0:22:20.50,Default,,0,0,0,,Мен онымен сөйлескеніңізді қалаймын.
Dialogue: 0,0:22:30.89,0:22:32.89,Default,,0,0,0,,♪～
Dialogue: 0,0:23:58.06,0:24:00.06,Default,,0,0,0,,～♪
