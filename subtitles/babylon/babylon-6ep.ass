Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:26.35,0:00:28.57,Default,,0,0,0,,Ешқандай көзге көрінбейтін сияқты.
Dialogue: 0,0:00:28.65,0:00:29.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:00:30.82,0:00:34.36,Default,,0,0,0,,Ал бұл детектив Цуцуйдің қалтасында.
Dialogue: 0,0:00:44.08,0:00:45.33,Default,,0,0,0,,(жану дыбысы жеңілірек)
Dialogue: 0,0:00:49.92,0:00:52.92,Default,,0,0,0,,Күтілгендей, Масазаки мырзаның да көңіл-күйі жоқ.
Dialogue: 0,0:00:54.22,0:00:57.09,Default,,0,0,0,,Дәлел болмай, Цуцуй да жоғалып кетті.
Dialogue: 0,0:00:57.97,0:00:59.35,Default,,0,0,0,,Жауапкершілік менікі.
Dialogue: 0,0:01:00.14,0:01:01.31,Default,,0,0,0,,Кім жауапты?
Dialogue: 0,0:01:01.39,0:01:03.98,Default,,0,0,0,,Жоқтан жақсы.
Dialogue: 0,0:01:04.06,0:01:06.64,Default,,0,0,0,,Мазасыз нәрселер туралы ойлау керек, солай ма?
Dialogue: 0,0:01:07.15,0:01:09.86,Default,,0,0,0,,Аяқпен жұмыс істеу әлдеқайда жеңіл.
Dialogue: 0,0:01:10.69,0:01:13.23,Default,,0,0,0,,Бұл әурешілік емес, қажет.
Dialogue: 0,0:01:14.03,0:01:16.36,Default,,0,0,0,,Әсіресе мұндай қиын жағдайда.
Dialogue: 0,0:01:16.45,0:01:18.16,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:01:19.24,0:01:22.58,Default,,0,0,0,,Мүмкін бұл қиын деген елес шығар?
Dialogue: 0,0:01:23.08,0:01:25.58,Default,,0,0,0,,Менің және Масазаки мырзаның жұмысы да.
Dialogue: 0,0:01:25.66,0:01:29.96,Default,,0,0,0,,Менің ойымша, бұл әлемдегі ең қарапайым жұмыстардың бірі.
Dialogue: 0,0:01:32.55,0:01:34.51,Default,,0,0,0,,Жаман адамды ұстаңыз.
Dialogue: 0,0:01:37.01,0:01:40.51,Default,,0,0,0,,Сайды жаман адам деп ойлаймын.
Dialogue: 0,0:01:43.52,0:01:45.27,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:01:45.77,0:01:47.64,Default,,0,0,0,,Жарайды, мен оны қалай да ұстауым керек.
Dialogue: 0,0:01:48.90,0:01:50.90,Default,,0,0,0,,Егер бұлай болса, мен сенімен бірге шығамын.
Dialogue: 0,0:01:55.61,0:01:57.15,Default,,0,0,0,,Асума ұйықтап қалды ма?
Dialogue: 0,0:01:57.24,0:01:58.91,Default,,0,0,0,,Иә, дәл қазір
Dialogue: 0,0:01:59.41,0:02:00.24,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:02:00.82,0:02:01.57,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:01.66,0:02:04.04,Default,,0,0,0,,Білесің бе, ертеңгі жылқы.
Dialogue: 0,0:02:04.12,0:02:07.29,Default,,0,0,0,,Хайуанаттар бағына барғың келе ме? Түскі асыңызды әкеліңіз.
Dialogue: 0,0:02:07.37,0:02:10.00,Default,,0,0,0,,Ол тамақ жасауға да көмектесемін деді.
Dialogue: 0,0:02:10.08,0:02:10.92,Default,,0,0,0,,Хехе
Dialogue: 0,0:02:12.04,0:02:12.88,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:02:12.96,0:02:15.63,Default,,0,0,0,,Бірден болмаса да, жарайды.
Dialogue: 0,0:02:16.21,0:02:19.59,Default,,0,0,0,,Асума Зен-Чанның да бос емес екенін біледі.
Dialogue: 0,0:02:20.09,0:02:23.64,Default,,0,0,0,,Кез келген уақыт жақсы, тіпті келесі жылы немесе одан кейінгі жылы.
Dialogue: 0,0:02:29.14,0:02:29.89,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:02:30.81,0:02:34.27,Default,,0,0,0,,Дзен-чан...Мен суицидті ұнатпаймын.
Dialogue: 0,0:02:34.77,0:02:37.32,Default,,0,0,0,,О, бұл тамаша.
Dialogue: 0,0:02:39.86,0:02:42.28,Default,,0,0,0,,Тергеу жиналысы енді басталады.
Dialogue: 0,0:02:42.87,0:02:46.91,Default,,0,0,0,,Алдымен прокурор Масазаки тергеу саясаты туралы айтады.
Dialogue: 0,0:02:48.00,0:02:52.00,Default,,0,0,0,,Өкінішке орай, біздің тергеу тобы кешеге дейін тергеуде
Dialogue: 0,0:02:52.08,0:02:56.75,Default,,0,0,0,,Сай Кайхуаның өз-өзіне қол жұмсағанына ешқандай дәлел табылмады.
Dialogue: 0,0:02:56.84,0:02:58.92,Default,,0,0,0,,Тергеу барысын ескерсек те
Dialogue: 0,0:02:59.01,0:03:02.55,Default,,0,0,0,,Бүгінгі күні бір күнде дәлел келтіру қиын сияқты.
Dialogue: 0,0:03:03.14,0:03:05.72,Default,,0,0,0,,Сондықтан ертеңгі қоғамдық пікірталас
Dialogue: 0,0:03:05.81,0:03:08.56,Default,,0,0,0,,Сай Кайхуаны қамауға алу мүмкін емес деп есептей отырып
Dialogue: 0,0:03:12.48,0:03:14.52,Default,,0,0,0,,Ағымдағы уақыт бойынша бүгін
Dialogue: 0,0:03:14.61,0:03:17.48,Default,,0,0,0,,Арнайы тергеу штабын таратыңыз
Dialogue: 0,0:03:17.98,0:03:19.99,Default,,0,0,0,,♪～
Dialogue: 0,0:03:45.93,0:03:47.93,Default,,0,0,0,,～♪
Dialogue: 0,0:03:59.69,0:04:02.07,Default,,0,0,0,,Сіз бірдеңе құрып жатқан сияқтысыз.
Dialogue: 0,0:04:02.57,0:04:03.57,Default,,0,0,0,,Міне
Dialogue: 0,0:04:04.11,0:04:07.41,Default,,0,0,0,,Тоқтауға ерекше ниетім жоқ. Эфирден кейін?
Dialogue: 0,0:04:07.49,0:04:08.66,Default,,0,0,0,,Иә
Dialogue: 0,0:04:08.74,0:04:10.29,Default,,0,0,0,,Олай болса уақытты босқа өткізеді.
Dialogue: 0,0:04:10.79,0:04:14.25,Default,,0,0,0,,Бұл хабар аяқталғаннан кейін Сай өледі.
Dialogue: 0,0:04:14.75,0:04:17.54,Default,,0,0,0,,Оның кейін қамауға алынуы немесе сотқа тартылуы.
Dialogue: 0,0:04:17.63,0:04:19.63,Default,,0,0,0,,Көп адамдарға әсер етпейді
Dialogue: 0,0:04:20.21,0:04:24.26,Default,,0,0,0,,Бұл сенің ісің. Бұл жерде мағына бар.
Dialogue: 0,0:04:24.76,0:04:27.51,Default,,0,0,0,,Сондай-ақ, сәтсіздікке ұшырамайтыныңызға кепілдік жоқ.
Dialogue: 0,0:04:28.10,0:04:30.18,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:04:30.26,0:04:31.60,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:04:31.68,0:04:36.10,Default,,0,0,0,,Артыңызда сақтық көшірме болса, үлкен шайқасқа жан тыныштығымен қарсы тұра аласыз.
Dialogue: 0,0:04:36.85,0:04:38.61,Default,,0,0,0,,Бұл тас қатты ма...?
Dialogue: 0,0:04:41.53,0:04:46.45,Default,,0,0,0,,Ағартушы саясаткердің негізін өзіміз құрдық.
Dialogue: 0,0:04:47.41,0:04:51.54,Default,,0,0,0,,Осыны жоғалтқан Сай енді тек тәуелсіз жеке тұлға емес.
Dialogue: 0,0:04:52.29,0:04:55.12,Default,,0,0,0,,Саясат сандарды басқару туралы.
Dialogue: 0,0:04:55.62,0:04:57.63,Default,,0,0,0,,Сандары азы жеңіледі.
Dialogue: 0,0:04:57.71,0:05:03.21,Default,,0,0,0,,Мен саясаткер ретінде ол қамыттан ешқашан құтыла алмаймын.
Dialogue: 0,0:05:20.98,0:05:23.28,Default,,0,0,0,,Ағымдағы уақыт бойынша бүгін
Dialogue: 0,0:05:23.36,0:05:26.36,Default,,0,0,0,,Арнайы тергеу штабын таратыңыз
Dialogue: 0,0:05:26.45,0:05:28.20,Default,,0,0,0,,Жоқ... не дейсің!
Dialogue: 0,0:05:28.78,0:05:31.74,Default,,0,0,0,,Сізге айтқанымдай, тергеу жабық.
Dialogue: 0,0:05:31.83,0:05:33.83,Default,,0,0,0,,Осылай келген соң бас тартасың ба?
Dialogue: 0,0:05:33.91,0:05:37.50,Default,,0,0,0,,Қазіргі тергеу нәтижелері бойынша Сай Кайхуаны қамауға алу мүмкін емес.
Dialogue: 0,0:05:37.58,0:05:40.33,Default,,0,0,0,,Олай болса, Цуцуй мырза бекер өлді ме?
Dialogue: 0,0:05:43.25,0:05:43.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:45.92,0:05:48.51,Default,,0,0,0,,Тергеу штабы таратылғаннан бері
Dialogue: 0,0:05:48.59,0:05:51.47,Default,,0,0,0,,Мен де енді штабтың жауапты прокуроры емеспін.
Dialogue: 0,0:05:52.64,0:05:54.52,Default,,0,0,0,,Мен қазір аздап сөйлесейін.
Dialogue: 0,0:05:55.02,0:05:57.73,Default,,0,0,0,,Бұл менің жеке әңгімем.
Dialogue: 0,0:05:58.56,0:06:02.48,Default,,0,0,0,,Ертең NHC орталығында қоғамдық талқылау өтеді.
Dialogue: 0,0:06:02.57,0:06:04.23,Default,,0,0,0,,Сай Кайхуаны ұрлау
Dialogue: 0,0:06:07.95,0:06:11.24,Default,,0,0,0,,Прокурор Масазаки: Ұрлау қылмыс болып табылады.
Dialogue: 0,0:06:11.91,0:06:12.74,Default,,0,0,0,,Иә
Dialogue: 0,0:06:13.33,0:06:15.66,Default,,0,0,0,,Бірақ қазір осымен тоқтамасақ
Dialogue: 0,0:06:15.75,0:06:18.04,Default,,0,0,0,,Өз-өзіне қол жұмсау саны артып келеді
Dialogue: 0,0:06:18.58,0:06:21.17,Default,,0,0,0,,Олай болса, мен мұны істеуге өте құлықсызмын.
Dialogue: 0,0:06:21.25,0:06:23.75,Default,,0,0,0,,Ажыратпастан басқа амалым жоқ деп шештім.
Dialogue: 0,0:06:25.09,0:06:29.01,Default,,0,0,0,,Әрине, мен ұрлау жоспарын жаңа ғана аштым.
Dialogue: 0,0:06:30.47,0:06:33.85,Default,,0,0,0,,Мені мұнда бәрі ұстап алса, көмектесе алмайды деп ойлаймын.
Dialogue: 0,0:06:35.10,0:06:37.60,Default,,0,0,0,,Ең сорақысы, Масазаки-сан.
Dialogue: 0,0:06:38.48,0:06:40.98,Default,,0,0,0,,Бұл аздап жасырын емес пе?
Dialogue: 0,0:06:41.48,0:06:42.61,Default,,0,0,0,,Мен сені осы жерден ұстауым керек.
Dialogue: 0,0:06:43.44,0:06:46.19,Default,,0,0,0,,Олардың барлығы сыбайлас сияқты, солай ма?
Dialogue: 0,0:06:49.70,0:06:52.37,Default,,0,0,0,,Олай болса, бірінші кеш өтеді.
Dialogue: 0,0:07:02.63,0:07:04.59,Default,,0,0,0,,үшін кештен кейінгі кешке де шақырылады.
Dialogue: 0,0:07:06.13,0:07:07.05,Default,,0,0,0,,Сегуро
Dialogue: 0,0:07:07.13,0:07:07.88,Default,,0,0,0,,Иә
Dialogue: 0,0:07:08.38,0:07:10.80,Default,,0,0,0,,Мен вице-министр Сегуроның өтіп кеткенін қалаймын.
Dialogue: 0,0:07:10.88,0:07:13.68,Default,,0,0,0,,Мен заң істерінде олқылық дайындағым келеді.
Dialogue: 0,0:07:13.76,0:07:16.81,Default,,0,0,0,,Директор Моринага арқылы прокуратураға хабарласыңыз.
Dialogue: 0,0:07:17.39,0:07:18.31,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:18.39,0:07:21.64,Default,,0,0,0,,Содан бастап мен Касумигасекиді сұрайтын боламын.
Dialogue: 0,0:07:22.15,0:07:24.36,Default,,0,0,0,,Сегуро енді бұл жерге оралмауы керек.
Dialogue: 0,0:07:28.19,0:07:28.94,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:29.44,0:07:32.74,Default,,0,0,0,,Әділет вице-министрі және Арнайы тергеу департаментінің директоры Моринагамен байланыс
Dialogue: 0,0:07:32.82,0:07:34.49,Default,,0,0,0,,Осы жерден жеткілікті
Dialogue: 0,0:07:34.57,0:07:36.99,Default,,0,0,0,,Мен куәгермін
Dialogue: 0,0:07:37.08,0:07:39.75,Default,,0,0,0,,Прокурор Масазаки осында жұмыс істейтіндіктен
Dialogue: 0,0:07:39.83,0:07:41.83,Default,,0,0,0,,Мен бұл жерден кете алмаймын.
Dialogue: 0,0:07:42.92,0:07:43.88,Default,,0,0,0,,Және прокурор
Dialogue: 0,0:07:45.04,0:07:48.09,Default,,0,0,0,,Саған қоңырау шалу қиын болса, мені Хёума деп атауға болады.
Dialogue: 0,0:07:50.67,0:07:53.18,Default,,0,0,0,,Біздің ең үлкен артықшылығымыз
Dialogue: 0,0:07:53.26,0:07:56.51,Default,,0,0,0,,Ішінде қауіпсіздікпен ынтымақтасу үшін 23 адам бар.
Dialogue: 0,0:07:56.60,0:07:57.72,Default,,0,0,0,,Сыбайлас болу
Dialogue: 0,0:07:58.64,0:08:00.73,Default,,0,0,0,,Егер бәрі Сайдың жоспары бойынша жалғасатын болса,
Dialogue: 0,0:08:00.81,0:08:04.77,Default,,0,0,0,,Адамдар бірінен соң бірі өз-өзіне қол жұмсайтын ең жаман уақыт келеді.
Dialogue: 0,0:08:05.35,0:08:09.36,Default,,0,0,0,,Бірақ жаңашыл идеялар көшбасшыларын жоғалтса, олар ыдырап кетеді.
Dialogue: 0,0:08:10.28,0:08:11.44,Default,,0,0,0,,Біздің қолымызбен...
Dialogue: 0,0:08:11.94,0:08:13.86,Default,,0,0,0,,Суицид туралы заңдарды тоқтатыңыз!
Dialogue: 0,0:08:13.95,0:08:15.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:25.08,0:08:26.58,Default,,0,0,0,,Суицид заңы
Dialogue: 0,0:08:26.67,0:08:29.63,Default,,0,0,0,,Осыдан кейін таң қалдыратын жаңа заң жарияланды.
Dialogue: 0,0:08:29.71,0:08:32.30,Default,,0,0,0,,Бүгін екі апта өтті.
Dialogue: 0,0:08:32.80,0:08:33.97,Default,,0,0,0,,Алдымен
Dialogue: 0,0:08:34.05,0:08:36.34,Default,,0,0,0,,Сіз көргіңіз келетін деректер бар.
Dialogue: 0,0:08:36.43,0:08:40.43,Default,,0,0,0,,Бағдарлама суицид туралы заңдарға қатысты қоғамдық сауалнама жүргізді.
Dialogue: 0,0:08:40.93,0:08:44.64,Default,,0,0,0,,Жаңа суицид туралы заңға қатысты, адамдардың 88%
Dialogue: 0,0:08:44.73,0:08:46.81,Default,,0,0,0,,«Мен қолдамаймын» деп жауап берді
Dialogue: 0,0:08:47.36,0:08:49.94,Default,,0,0,0,,Сонымен бірге бізде де осындай деректер бар
Dialogue: 0,0:08:50.61,0:08:55.61,Default,,0,0,0,,Бұл өз-өзіне қол жұмсау туралы заң жарияланған күннен бастап бүгінгі күнге дейін елде өз-өзіне қол жұмсаған адамдардың саны.
Dialogue: 0,0:08:55.70,0:09:00.45,Default,,0,0,0,,Бұл қалыпты уақыттағы суицидтердің санынан 2,8 есе көп.
Dialogue: 0,0:09:00.95,0:09:04.12,Default,,0,0,0,,Ертең жаңа аймақ мүшелерін сайлайтын облыстық сайлау...
Dialogue: 0,0:09:04.21,0:09:06.67,Default,,0,0,0,,Барлық тергеушілер тағайындалды
Dialogue: 0,0:09:06.75,0:09:08.92,Default,,0,0,0,,Суицид туралы заң шешіледі
Dialogue: 0,0:09:09.59,0:09:13.42,Default,,0,0,0,,Енді бүгінгі қоғамдық талқылауға қатысушыларды таныстыруға рұқсат етіңіздер.
Dialogue: 0,0:09:13.51,0:09:16.63,Default,,0,0,0,,Біріншіден, суицид заңын жоққа шығаратындарға.
Dialogue: 0,0:09:17.13,0:09:20.76,Default,,0,0,0,,Жапонияның ортақ партиясының төрағасы Нобуо Ники
Dialogue: 0,0:09:22.18,0:09:25.27,Default,,0,0,0,,Әділет партиясының өкілі Акихиро Ивакуни
Dialogue: 0,0:09:26.10,0:09:31.11,Default,,0,0,0,,Демократиялық партия Жаңа аймақтық кеңес өкілінің орынбасары Харуоми Кашиваба
Dialogue: 0,0:09:32.15,0:09:37.36,Default,,0,0,0,,Джимей партиясының жаңа аймақтық ассамблеясының кандидаты, бұрынғы бас хатшы Рюичиро Номару
Dialogue: 0,0:09:38.49,0:09:41.45,Default,,0,0,0,,Келесі кезекте суицид туралы заңның жақтаушылары
Dialogue: 0,0:09:41.53,0:09:45.08,Default,,0,0,0,,Сай Кайка Жаңа аймақтың тәуелсіз директоры
Dialogue: 0,0:09:48.04,0:09:50.67,Default,,0,0,0,,Алдымен теріс позиция алынады⸺
Dialogue: 0,0:09:50.75,0:09:53.80,Default,,0,0,0,,Мен Ники мырзаның Japan Sharing Party ұйымынан пікірін алғым келеді.
Dialogue: 0,0:09:54.88,0:09:59.14,Default,,0,0,0,,Менің ойымша, бұл іс бойынша ең маңыздысы
Dialogue: 0,0:09:59.22,0:10:01.55,Default,,0,0,0,,Әлеуметтік-экономикалық аспектілері
Dialogue: 0,0:10:01.64,0:10:05.81,Default,,0,0,0,,Қазіргі уақытта Жапонияда жыл сайын 20 000-нан астам адам өз-өзіне қол жұмсайды.
Dialogue: 0,0:10:05.89,0:10:10.56,Default,,0,0,0,,ЖІӨ шығыны жылына 1 триллион иенден асады деген болжам бар.
Dialogue: 0,0:10:10.65,0:10:13.94,Default,,0,0,0,,Сондай-ақ, бір адамның өз-өзіне қол жұмсауы
Dialogue: 0,0:10:14.03,0:10:16.86,Default,,0,0,0,,Көптеген экономикалық әсерлер орын алады
Dialogue: 0,0:10:16.94,0:10:21.78,Default,,0,0,0,,Тұтыну шығындарының азаюы Тиімді сұраныстың төмендеуі және т.б.
Dialogue: 0,0:10:21.87,0:10:24.37,Default,,0,0,0,,Сіз санауды бастағаннан кейін олардың барлығын ешқашан тізіп бере алмайсыз.
Dialogue: 0,0:10:24.45,0:10:30.08,Default,,0,0,0,,Осы логикалық тұрғыдан алғанда, суицид туралы заңдар мүлдем қабылданбайды.
Dialogue: 0,0:10:30.67,0:10:34.09,Default,,0,0,0,,Келесі кезекте, Әділет партиясынан Ивакуни мырза.
Dialogue: 0,0:10:34.75,0:10:38.01,Default,,0,0,0,,Мен моральмын Моральдық тұрғыдан
Dialogue: 0,0:10:38.09,0:10:40.68,Default,,0,0,0,,Мен теріс пікір айтқым келеді.
Dialogue: 0,0:10:40.76,0:10:46.27,Default,,0,0,0,,Мораль – адамдар арасындағы өзара қарым-қатынасты реттейтін ережелер.
Dialogue: 0,0:10:46.35,0:10:51.69,Default,,0,0,0,,Егер кісі өлтіру қолайлы болса, қоғам толығымен күйреді.
Dialogue: 0,0:10:51.77,0:10:54.52,Default,,0,0,0,,Кісі өлтіру ережені анық бұзу болып табылады.
Dialogue: 0,0:10:54.61,0:10:58.69,Default,,0,0,0,,Ал өз-өзіне қол жұмсау да ережені анық бұзу болып табылады.
Dialogue: 0,0:10:58.78,0:11:04.16,Default,,0,0,0,,Өз-өзіне қол жұмсауға рұқсат етілген қоғамда адамдар кенеттен өледі немесе жоғалады.
Dialogue: 0,0:11:04.24,0:11:07.29,Default,,0,0,0,,Адамдар арасындағы сенімді қарым-қатынасқа негізделген заттар
Dialogue: 0,0:11:07.37,0:11:09.21,Default,,0,0,0,,үшін ыдырап кетеді
Dialogue: 0,0:11:09.29,0:11:13.21,Default,,0,0,0,,Міне, моральдық нормаларды бұзатын қоғамның тағдыры.
Dialogue: 0,0:11:13.29,0:11:18.34,Default,,0,0,0,,Қоғамды басқаратын саясаткерлер ретінде суицид туралы заңдарды қабылдауға болмайды.
Dialogue: 0,0:11:18.42,0:11:22.76,Default,,0,0,0,,Келесі, Демократиялық партиядан келген Кашиваба мырза, өтінемін.
Dialogue: 0,0:11:23.55,0:11:25.68,Default,,0,0,0,,Алдымен Сай мырзадан сұрағым келеді.
Dialogue: 0,0:11:25.76,0:11:29.23,Default,,0,0,0,,64 адам жаңа аумақта секіру арқылы өз-өзіне қол жұмсамақ болды
Dialogue: 0,0:11:29.31,0:11:32.65,Default,,0,0,0,,Сіз оны тоқтата алар едіңіз!
Dialogue: 0,0:11:32.73,0:11:35.36,Default,,0,0,0,,Тоқтату қажет емес әңгіме болса, жақсы.
Dialogue: 0,0:11:35.44,0:11:41.24,Default,,0,0,0,,Сіз 64 адамды өз-өзіне қол жұмсауға итермеледіңіз деп ойлау таңқаларлық емес!
Dialogue: 0,0:11:41.32,0:11:42.82,Default,,0,0,0,,Біздің заңда солай айтылған
Dialogue: 0,0:11:42.91,0:11:46.53,Default,,0,0,0,,Өз-өзіне қол жұмсауға тарту қылмысының нақты нормасы бар.
Dialogue: 0,0:11:46.62,0:11:48.62,Default,,0,0,0,,Сізде бұған күдік бар
Dialogue: 0,0:11:48.70,0:11:51.50,Default,,0,0,0,,Ал егер суицид заңы орындалса
Dialogue: 0,0:11:51.58,0:11:55.38,Default,,0,0,0,,Барлық азаматтар бірдей қылмыспен қылмыскер бола алады.
Dialogue: 0,0:11:55.46,0:11:59.26,Default,,0,0,0,,Өз-өзіне қол жұмсаудың өзі заңсыз болмаса да...
Dialogue: 0,0:11:59.34,0:12:00.59,Default,,0,0,0,,Мен мұнда шектен шыққан пікірмен келдім.
Dialogue: 0,0:12:01.09,0:12:05.01,Default,,0,0,0,,Сайдың қолдауына нұқсан келтіру үшін болжамның өзі жеткілікті.
Dialogue: 0,0:12:05.59,0:12:08.01,Default,,0,0,0,,Үш бағытта бөгеліп, ішке кірді
Dialogue: 0,0:12:08.10,0:12:10.77,Default,,0,0,0,,Соңғы жанасу - Номарудың өзі.
Dialogue: 0,0:12:10.85,0:12:13.39,Default,,0,0,0,,Бұл бізді қарсылық білдірушілердің соңғысына әкеледі.
Dialogue: 0,0:12:13.98,0:12:18.73,Default,,0,0,0,,Біз Джимей партиясының бұрынғы бас хатшысы Рюичиро Номарудың пікірін білгіміз келеді.
Dialogue: 0,0:12:19.23,0:12:21.74,Default,,0,0,0,,Адамдар өлімнен қашады
Dialogue: 0,0:12:21.82,0:12:26.41,Default,,0,0,0,,Әрбір адам бақытты өмір сүріп, өзінің табиғи өмірін орындағысы келеді.
Dialogue: 0,0:12:26.91,0:12:32.87,Default,,0,0,0,,Бұл жаңа салалармен ғана шектелмейді, бірақ бүкіл адамзат ұстанатын әмбебап идея.
Dialogue: 0,0:12:33.37,0:12:34.71,Default,,0,0,0,,Бірақ сонымен бірге
Dialogue: 0,0:12:34.79,0:12:40.17,Default,,0,0,0,,Қазіргі уақытта Жапонияда жыл сайын 20 000 адам өлімді таңдайтыны да рас.
Dialogue: 0,0:12:40.25,0:12:43.88,Default,,0,0,0,,Суицид туралы заң мұндай адамдарға көмектеседі.
Dialogue: 0,0:12:43.97,0:12:48.26,Default,,0,0,0,,Болашақта адамзат қоғамына пайда әкелетін мүмкіндігі бар
Dialogue: 0,0:12:48.76,0:12:52.68,Default,,0,0,0,,Бірақ ол дұрыс жұмыс істегенде ғана.
Dialogue: 0,0:12:53.52,0:12:56.98,Default,,0,0,0,,Адамдар өлімге сабыр сақтай алмайды.
Dialogue: 0,0:12:57.06,0:13:01.98,Default,,0,0,0,,Өзіңіздің де, басқалардың өлімін де ақылмен шешуге болмайды.
Dialogue: 0,0:13:02.49,0:13:07.41,Default,,0,0,0,,Суицид заңын тек эмоциясы жоқ адамдар ғана дұрыс пайдалана алады.
Dialogue: 0,0:13:07.49,0:13:08.49,Default,,0,0,0,,Бірақ адамдар
Dialogue: 0,0:13:08.57,0:13:11.95,Default,,0,0,0,,Біреудің өлімін жоқтауға мүмкіндік беретін эмоцияларға ие болыңыз
Dialogue: 0,0:13:12.95,0:13:16.58,Default,,0,0,0,,Өз-өзіне қол жұмсау туралы заңдар адамдардың қолынан келетін нәрсе емес.
Dialogue: 0,0:13:17.17,0:13:18.29,Default,,0,0,0,,Эмоция теориясы…
Dialogue: 0,0:13:18.38,0:13:19.17,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:19.25,0:13:23.55,Default,,0,0,0,,Адамдарда әрқашан эмоциялар болатыны абсолютті өзгермейтін эмоциялар теориясы.
Dialogue: 0,0:13:24.55,0:13:25.63,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:13:25.72,0:13:28.30,Default,,0,0,0,,Сай мұны да болжау керек еді.
Dialogue: 0,0:13:28.97,0:13:33.56,Default,,0,0,0,,Содан кейін, жалғыз оң, Кайхуа Жаңа Аймақ директоры
Dialogue: 0,0:13:33.64,0:13:36.31,Default,,0,0,0,,Қарсылық білдірушілерге теріске шығаруыңызды өтінеміз.
Dialogue: 0,0:13:36.89,0:13:40.44,Default,,0,0,0,,Алдымен мен әлеуметтік-экономикалық сұраққа жауап бергім келеді.
Dialogue: 0,0:13:40.52,0:13:42.53,Default,,0,0,0,,Суицид заңының әрекетінде
Dialogue: 0,0:13:42.61,0:13:45.95,Default,,0,0,0,,Экономикалық шығындар үлкен болады деген алаңдаушылық бар сияқты.
Dialogue: 0,0:13:46.03,0:13:50.45,Default,,0,0,0,,Біріншіден, өз-өзіне қол жұмсау туралы заң күшіне енгеннен кейін суицидтердің саны міндетті түрде өспейді.
Dialogue: 0,0:13:50.53,0:13:51.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:51.16,0:13:52.87,Default,,0,0,0,,Қазіргі қоғамда
Dialogue: 0,0:13:52.95,0:13:56.50,Default,,0,0,0,,Ол өзін-өзі өлтіруге әрекеттенеді.
Dialogue: 0,0:13:56.58,0:14:01.34,Default,,0,0,0,,Өз-өзіне қол жұмсау туралы заңды жүзеге асырғаннан кейін, сіз ашуланудың орнына таңдау ретінде өлімді таңдай аласыз.
Dialogue: 0,0:14:01.42,0:14:05.59,Default,,0,0,0,,Егер бұл орын алса, кездейсоқ суицидтер санының азаюына жақсы мүмкіндік бар.
Dialogue: 0,0:14:05.67,0:14:06.88,Default,,0,0,0,,Бұл софистика!
Dialogue: 0,0:14:06.97,0:14:09.13,Default,,0,0,0,,Рұқсат берілсе, көп адам жасайды!
Dialogue: 0,0:14:09.22,0:14:11.60,Default,,0,0,0,,Бұл табиғи нәрсе.
Dialogue: 0,0:14:11.68,0:14:15.18,Default,,0,0,0,,Мысалы, өткен жылы Канадада каннабис қылмыссыздандырылды.
Dialogue: 0,0:14:15.68,0:14:19.48,Default,,0,0,0,,Бұл тыйым салу заңдары арқылы оны басу кері нәтиже береді деген шешімге негізделген.
Dialogue: 0,0:14:19.56,0:14:22.65,Default,,0,0,0,,Шындығында, Нидерландыда ізашар деп айтуға болатын каннабисті пайдалану деңгейі
Dialogue: 0,0:14:22.73,0:14:25.90,Default,,0,0,0,,Тіпті тыйым салған Англия мен Франция сияқты елдермен салыстырғанда
Dialogue: 0,0:14:25.99,0:14:27.15,Default,,0,0,0,,Әлбетте төмен
Dialogue: 0,0:14:27.24,0:14:30.87,Default,,0,0,0,,Та...та... бір тыныста марихуана мен суицид туралы айту.
Dialogue: 0,0:14:30.95,0:14:32.53,Default,,0,0,0,,Одан әрі – адамгершілік.
Dialogue: 0,0:14:32.62,0:14:36.75,Default,,0,0,0,,Адамгершілік адамдар арасындағы заңдылық екені даусыз.
Dialogue: 0,0:14:36.83,0:14:38.54,Default,,0,0,0,,Ережелер өзгереді
Dialogue: 0,0:14:38.62,0:14:43.34,Default,,0,0,0,,Адамгершілік өзгермейді; ол уақыт пен қоғамға байланысты өзгереді.
Dialogue: 0,0:14:43.42,0:14:48.76,Default,,0,0,0,,Ежелгі уақытта азғындық деп саналған гомосексуализм қазір көптеген жерлерде қабылданады.
Dialogue: 0,0:14:48.84,0:14:52.55,Default,,0,0,0,,Керісінше, ерлер мен әйелдер арасындағы гендерлік кемсітушілік ешқашан проблема болған емес.
Dialogue: 0,0:14:52.64,0:14:55.06,Default,,0,0,0,,Қазір әдепсіз болып саналады
Dialogue: 0,0:14:55.14,0:14:57.93,Default,,0,0,0,,Бірақ өлтіру немесе ұрлық сияқты
Dialogue: 0,0:14:58.02,0:15:00.85,Default,,0,0,0,,Жалпы адамгершілікке жатпайтын нәрселер болуы керек.
Dialogue: 0,0:15:01.35,0:15:02.81,Default,,0,0,0,,Мен мұны мойындаймын
Dialogue: 0,0:15:03.61,0:15:05.90,Default,,0,0,0,,Сонымен суицид дегеніміз не?
Dialogue: 0,0:15:05.98,0:15:06.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:06.82,0:15:10.49,Default,,0,0,0,,Өз-өзіне қол жұмсау туралы заңдар адамдарды өз-өзіне қол жұмсауға мәжбүр етеді
Dialogue: 0,0:15:10.99,0:15:12.74,Default,,0,0,0,,Сол кезде азаматтарды суицид мәселесі алаңдатады.
Dialogue: 0,0:15:12.82,0:15:15.45,Default,,0,0,0,,Бұл сіз бұл туралы бірінші рет байыпты ойланасыз.
Dialogue: 0,0:15:15.95,0:15:19.37,Default,,0,0,0,,Бұл моральдық тұрғыдан өте дұрыс.
Dialogue: 0,0:15:20.00,0:15:21.46,Default,,0,0,0,,және заң
Dialogue: 0,0:15:21.54,0:15:24.34,Default,,0,0,0,,Мораль сияқты заңдар да өзгереді.
Dialogue: 0,0:15:24.42,0:15:27.05,Default,,0,0,0,,Құқық моральмен бірдей емес!
Dialogue: 0,0:15:27.13,0:15:30.67,Default,,0,0,0,,Гомосексуализм мен қылмыстық мінез-құлықтың мәдени тарихы
Dialogue: 0,0:15:30.76,0:15:33.05,Default,,0,0,0,,Бұл мүлдем басқа деңгейде!
Dialogue: 0,0:15:33.55,0:15:35.18,Default,,0,0,0,,Қазіргі уақытта Жапонияда
Dialogue: 0,0:15:35.89,0:15:37.68,Default,,0,0,0,,Өзін-өзі өлтіру қылмыс емес
Dialogue: 0,0:15:37.77,0:15:41.81,Default,,0,0,0,,Біз кісі өлтіруді ауыр қылмыс ретінде қарастырамыз,
Dialogue: 0,0:15:41.89,0:15:44.19,Default,,0,0,0,,Өз-өзіне қол жұмсауды қылмыс ретінде айыптауға болмайды
Dialogue: 0,0:15:44.86,0:15:47.15,Default,,0,0,0,,Енді мен сізге сұрақ қойғым келеді.
Dialogue: 0,0:15:47.65,0:15:52.36,Default,,0,0,0,,Өз-өзіне қол жұмсау мемлекет заңмен реттеуге тиісті нәрсе ме?
Dialogue: 0,0:15:52.45,0:15:54.24,Default,,0,0,0,,Бірде Ежелгі Римде
Dialogue: 0,0:15:54.32,0:15:59.12,Default,,0,0,0,,Дәлелді себеп болған жағдайда суицидке жол беретін жүйе болды.
Dialogue: 0,0:15:59.70,0:16:02.96,Default,,0,0,0,,Кейінірек христиан қоғамы құрылған кезде
Dialogue: 0,0:16:03.04,0:16:08.05,Default,,0,0,0,,Қазіргі заманға дейін заң өз-өзіне қол жұмсауды қылмыс деп санауды жалғастырды.
Dialogue: 0,0:16:08.13,0:16:10.80,Default,,0,0,0,,Азаматтар мемлекет пен дінге қарай бөлінеді.
Dialogue: 0,0:16:10.88,0:16:14.18,Default,,0,0,0,,Өз-өзіне қол жұмсау бостандығы мен жеке қадір-қасиеті алынып тасталды.
Dialogue: 0,0:16:14.26,0:16:17.14,Default,,0,0,0,,Бұл қиын кездесу! Мәселе жоқ!
Dialogue: 0,0:16:17.22,0:16:21.31,Default,,0,0,0,,Біз қазір маңызды қадам жасай алатын нүктеге жеттік.
Dialogue: 0,0:16:21.39,0:16:25.40,Default,,0,0,0,,Бұл суицидті үнсіз қабылдау кезеңінен кейін келеді⸺
Dialogue: 0,0:16:25.48,0:16:28.40,Default,,0,0,0,,Қазір суицидті көпшілік алдында мойындайтын уақыт.
Dialogue: 0,0:16:28.90,0:16:29.86,Default,,0,0,0,,Соңында...
Dialogue: 0,0:16:30.44,0:16:32.15,Default,,0,0,0,,деді Номару мырза
Dialogue: 0,0:16:32.24,0:16:34.86,Default,,0,0,0,,Адамдар өлімге сабыр сақтай алмайды
Dialogue: 0,0:16:34.95,0:16:38.99,Default,,0,0,0,,Сондықтан өз-өзіне қол жұмсау туралы заңдарды эмоциясы бар адамдар шеше алмайды.
Dialogue: 0,0:16:39.08,0:16:44.21,Default,,0,0,0,,Адамдар эмоцияның ықпалында болатын, кейде қателесетін жаратылыс.
Dialogue: 0,0:16:44.29,0:16:49.29,Default,,0,0,0,,Ал суицид туралы заң ешқашан қате болмауы керек заң.
Dialogue: 0,0:16:49.38,0:16:51.92,Default,,0,0,0,,Өлімді қателесіп таңдасаң
Dialogue: 0,0:16:52.55,0:16:55.68,Default,,0,0,0,,Өйткені артқа жол жоқ
Dialogue: 0,0:16:56.26,0:16:59.18,Default,,0,0,0,,Сіз бен біз бір нәрсені көруіміз керек
Dialogue: 0,0:16:59.26,0:17:01.06,Default,,0,0,0,,Суицид заңы қандай?
Dialogue: 0,0:17:01.14,0:17:04.18,Default,,0,0,0,,Бұл сондай-ақ «кездейсоқ суицидтің алдын алатын заң»
Dialogue: 0,0:17:04.81,0:17:06.94,Default,,0,0,0,,Көпшілік алдында адамдармен сөйлесу
Dialogue: 0,0:17:07.02,0:17:09.94,Default,,0,0,0,,Әрбір адам қолайлы жауап ретінде өлімді таңдайды.
Dialogue: 0,0:17:10.02,0:17:13.69,Default,,0,0,0,,Бұл суицид туралы заңдармен жасалған жаңа әлем.
Dialogue: 0,0:17:13.78,0:17:18.37,Default,,0,0,0,,Пікірталас эмоциялық аспектіден қашып құтыла алмайды.
Dialogue: 0,0:17:18.45,0:17:21.87,Default,,0,0,0,,Адамдар өлімді сабырмен таңдай алмайды.
Dialogue: 0,0:17:21.95,0:17:24.00,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:17:24.08,0:17:25.75,Default,,0,0,0,,Бұл су теориясы.
Dialogue: 0,0:17:25.83,0:17:29.17,Default,,0,0,0,,Бұл қағаз жүзінде жауап беретін нәрсе емес.
Dialogue: 0,0:17:29.67,0:17:33.71,Default,,0,0,0,,Демек, шындықтың не екенін көруден басқа амалымыз жоқ.
Dialogue: 0,0:17:33.80,0:17:36.09,Default,,0,0,0,,Суицид туралы заң нені берді?
Dialogue: 0,0:17:36.18,0:17:38.26,Default,,0,0,0,,Ал енді Сай мырзаға.
Dialogue: 0,0:17:38.34,0:17:41.76,Default,,0,0,0,,Барлық сайлаушылармен танысыңыз.
Dialogue: 0,0:17:41.85,0:17:42.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:43.10,0:17:45.60,Default,,0,0,0,,Мен мұнда қонақ шақырғым келеді.
Dialogue: 0,0:17:51.61,0:17:52.98,Default,,0,0,0,,Ах... (Масазаки) Не?
Dialogue: 0,0:17:55.07,0:17:56.53,Default,,0,0,0,,10 күн бұрын
Dialogue: 0,0:17:56.61,0:18:01.03,Default,,0,0,0,,Анонимді бала әкесінің өз-өзіне қол жұмсамақ болғанын айтады
Dialogue: 0,0:18:01.12,0:18:04.41,Default,,0,0,0,,Ғаламторда өте жан түршігерлік видео жарияланды.
Dialogue: 0,0:18:04.91,0:18:08.08,Default,,0,0,0,,Бала бүгін студияға келеді.
Dialogue: 0,0:18:08.58,0:18:13.38,Default,,0,0,0,,Өкінішке орай, мен оның әкесімен байланыса алмадым.
Dialogue: 0,0:18:13.88,0:18:17.01,Default,,0,0,0,,Сенің анаң бүгін бізбен бірге.
Dialogue: 0,0:18:17.59,0:18:21.68,Default,,0,0,0,,Әкесі өз өмірін қиғалы жатыр.
Dialogue: 0,0:18:21.76,0:18:24.52,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін.
Dialogue: 0,0:18:25.43,0:18:27.35,Default,,0,0,0,,Сондықтан мен қалаған нәрсені айта алмаймын
Dialogue: 0,0:18:27.85,0:18:29.02,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:18:29.10,0:18:32.86,Default,,0,0,0,,Мына бала-шағаңызды, әйел-балаңызды тастап, өз өміріңізге қол жұмсайтыныңызды естісем бе?
Dialogue: 0,0:18:32.94,0:18:34.78,Default,,0,0,0,,Тоқтаудан басқа амалым жоқ.
Dialogue: 0,0:18:35.53,0:18:38.90,Default,,0,0,0,,Әкенің шешімі қаншалықты орынды болса да,
Dialogue: 0,0:18:38.99,0:18:40.53,Default,,0,0,0,,Мен тоқтаймын
Dialogue: 0,0:18:40.61,0:18:43.03,Default,,0,0,0,,Эмоционалды және себепсіз тоқтатыңыз
Dialogue: 0,0:18:43.78,0:18:47.75,Default,,0,0,0,,Сондықтан мен өз-өзіне қол жұмсау туралы заңды пайдалана алмаймын.
Dialogue: 0,0:18:48.25,0:18:52.04,Default,,0,0,0,,Ал мен азаматтардың мен сияқты екеніне сенгім келеді.
Dialogue: 0,0:18:52.92,0:18:56.30,Default,,0,0,0,,Адамның өз-өзіне қол жұмсауын эмоциясына қарап тоқтататын адамдар бар.
Dialogue: 0,0:18:56.38,0:18:58.63,Default,,0,0,0,,Дүние толы
Dialogue: 0,0:19:00.18,0:19:04.35,Default,,0,0,0,,Азаматтарға айтары бар сияқты.
Dialogue: 0,0:19:06.93,0:19:09.31,Default,,0,0,0,,Мен дауыс беремін...
Dialogue: 0,0:19:12.81,0:19:15.48,Default,,0,0,0,,Аймақтық сайлауға кандидат туралы хабарлама
Dialogue: 0,0:19:15.57,0:19:16.98,Default,,0,0,0,,Бүгін түн ортасына дейін.
Dialogue: 0,0:19:17.07,0:19:18.90,Default,,0,0,0,,Мен бұл балаға
Dialogue: 0,0:19:18.99,0:19:21.66,Default,,0,0,0,,Мен облыстық кеңеске депутаттыққа түскім келеді.
Dialogue: 0,0:19:22.16,0:19:23.99,Default,,0,0,0,,Бұл... жақсы ма?
Dialogue: 0,0:19:24.49,0:19:28.00,Default,,0,0,0,,Өңірлік кеңес депутаты болып сайлану құқығына жас шектеуі жоқ.
Dialogue: 0,0:19:28.58,0:19:31.50,Default,,0,0,0,,Бұл бала да депутат бола алады.
Dialogue: 0,0:19:31.58,0:19:33.92,Default,,0,0,0,,Бірақ егер сіз жеңсеңіз
Dialogue: 0,0:19:34.00,0:19:36.30,Default,,0,0,0,,Сіз заң шығарушы ретінде өз міндеттеріңізді орындай аласыз ба?
Dialogue: 0,0:19:36.38,0:19:38.05,Default,,0,0,0,,Мен сізге көмектесемін.
Dialogue: 0,0:19:38.63,0:19:42.05,Default,,0,0,0,,Кандидатурамды алып тастасам, қарсы емеспін.
Dialogue: 0,0:19:42.55,0:19:45.05,Default,,0,0,0,,Ол екеуміздің амбициямыз бір!
Dialogue: 0,0:19:45.64,0:19:49.77,Default,,0,0,0,,Суицид туралы заңдарды жоққа шығару және әкесінің өзіне қол жұмсауын тоқтату
Dialogue: 0,0:19:49.85,0:19:54.56,Default,,0,0,0,,Егер бұған қол жеткізу мүмкін болса, кімнің парламент мүшесі екені маңызды емес.
Dialogue: 0,0:19:54.65,0:19:58.73,Default,,0,0,0,,Ертеңгі сайлауда дауыс жинайтынына сенемін.
Dialogue: 0,0:19:59.65,0:20:02.49,Default,,0,0,0,,Өтінемін, мені қолдарыңызбен қорғаңыз.
Dialogue: 0,0:20:03.07,0:20:05.78,Default,,0,0,0,,әкесі және өзі
Dialogue: 0,0:20:06.41,0:20:10.20,Default,,0,0,0,,Үш ата-ана мен бала бірге өмір сүретін болашақ
Dialogue: 0,0:20:14.79,0:20:20.80,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:20:24.38,0:20:26.22,Default,,0,0,0,,Ел мен халықты айла-шарғы жасау...
Dialogue: 0,0:20:27.14,0:20:28.72,Default,,0,0,0,,Бұл саясаткер ме?
Dialogue: 0,0:20:28.81,0:20:30.43,Default,,0,0,0,,Қабылдау кабинасында
Dialogue: 0,0:20:30.52,0:20:34.52,Default,,0,0,0,,Мен Номарудың шағымдарына түсіністікпен қарайтынын айтқан көрермендерден факс пен электрондық хат алдым.
Dialogue: 0,0:20:34.60,0:20:35.98,Default,,0,0,0,,Олар бірінен соң бірі келеді.
Dialogue: 0,0:20:36.06,0:20:39.98,Default,,0,0,0,,Сай мырза, жас бала және аты белгісіз бала.
Dialogue: 0,0:20:40.07,0:20:42.99,Default,,0,0,0,,Мен сайлауға түсетінімді жарияладым, бірақ...
Dialogue: 0,0:20:43.07,0:20:44.49,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:20:44.57,0:20:47.82,Default,,0,0,0,,Өздеріңіз білетіндей, жас шектеуі жоқ.
Dialogue: 0,0:20:47.91,0:20:51.54,Default,,0,0,0,,Дегенмен, бәрінен де ойы дұрыс.
Dialogue: 0,0:20:51.62,0:20:52.54,Default,,0,0,0,,Философия?
Dialogue: 0,0:20:52.62,0:20:54.83,Default,,0,0,0,,Әр адам өз пікірін айтады.
Dialogue: 0,0:20:54.92,0:20:56.88,Default,,0,0,0,,Дауыс беру арқылы шешіледі.
Dialogue: 0,0:20:57.71,0:21:02.13,Default,,0,0,0,,Қайсысы дұрыс деп санайтынын азаматтардың өз еркіне қалдырамын, ол немесе менікі.
Dialogue: 0,0:21:02.71,0:21:05.93,Default,,0,0,0,,Сайлау осындай болуы керек.
Dialogue: 0,0:21:06.01,0:21:08.89,Default,,0,0,0,,Тек өз пікіріңізде қателеспейтініңізге көз жеткізу үшін.
Dialogue: 0,0:21:08.97,0:21:12.52,Default,,0,0,0,,Менің ойымша, барлық сот үкімі материалдары жария болуы керек.
Dialogue: 0,0:21:13.27,0:21:15.81,Default,,0,0,0,,Бейнежазбаны өз еркімен жариялады
Dialogue: 0,0:21:16.31,0:21:17.73,Default,,0,0,0,,Кім істей алады
Dialogue: 0,0:21:17.81,0:21:21.48,Default,,0,0,0,,Өз бетінше шешім қабылдай алатын жеке тұлға
Dialogue: 0,0:21:25.03,0:21:27.95,Default,,0,0,0,,Мен өз қателігімді мойындаймын
Dialogue: 0,0:21:28.03,0:21:28.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:30.66,0:21:34.20,Default,,0,0,0,,Күн Маскаңызды алыңыз
Dialogue: 0,0:21:35.58,0:21:36.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:41.50,0:21:43.21,Default,,0,0,0,,Ол менің ұлым
Dialogue: 0,0:21:44.21,0:21:48.34,Default,,0,0,0,,Өз-өзіне қол жұмсағалы тұрған әке меннен басқа ешкім емес.
Dialogue: 0,0:21:48.43,0:21:49.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:55.93,0:21:57.94,Default,,0,0,0,,♪～
Dialogue: 0,0:23:22.73,0:23:24.73,Default,,0,0,0,,～♪
