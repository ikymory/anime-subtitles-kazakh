Dialogue: 0,0:02:09.93,0:02:15.42,JP-OP,,0000,0000,0000,,Алыс күндегі арман, қазір де
Dialogue: 0,0:02:16.13,0:02:19.80,JP-OP,,0000,0000,0000,,Шинобред Атсукимама
Dialogue: 0,0:02:22.51,0:02:27.89,JP-OP,,0000,0000,0000,,Ортақ ойларды іздеу кезінде
Dialogue: 0,0:02:28.22,0:02:32.91,JP-OP,,0000,0000,0000,,Барлығы жүре бастайды
Dialogue: 0,0:02:35.18,0:02:40.69,JP-OP,,0000,0000,0000,,Бір-бірінен бөлек және жақын
Dialogue: 0,0:02:41.51,0:02:48.07,JP-OP,,0000,0000,0000,,Бұрама жолда біз сол жұлдызды көрдік
Dialogue: 0,0:02:49.33,0:02:54.96,JP-OP,,0000,0000,0000,,Маңызды уәдені орындау
Dialogue: 0,0:02:55.69,0:03:01.36,JP-OP,,0000,0000,0000,,Кішкене болса да жақындағым келеді.
Dialogue: 0,0:03:02.00,0:03:07.40,JP-OP,,0000,0000,0000,,Бұл сезім өзгермейді
Dialogue: 0,0:03:08.27,0:03:14.91,JP-OP,,0000,0000,0000,,Біз келген күнге дейін
Dialogue: 0,0:21:26.25,0:21:30.09,JP-ED,,0000,0000,0000,,Алыста жүрсең де
Dialogue: 0,0:21:30.29,0:21:32.85,JP-ED,,0000,0000,0000,,Ұмытпа
Dialogue: 0,0:21:32.98,0:21:36.87,JP-ED,,0000,0000,0000,,Сол күні мен сезінген құштарлық
Dialogue: 0,0:21:36.93,0:21:40.69,JP-ED,,0000,0000,0000,,Бірге болған армандарымыз
Dialogue: 0,0:21:40.69,0:21:44.11,JP-ED,,0000,0000,0000,,Қызыл аспан
Dialogue: 0,0:21:44.29,0:21:47.00,JP-ED,,0000,0000,0000,,Бұлыңғыр күннің батуы
Dialogue: 0,0:21:47.00,0:21:53.20,JP-ED,,0000,0000,0000,,Жүргенде басымызды тік ұстайық
Dialogue: 0,0:22:08.25,0:22:12.09,JP-ED,,0000,0000,0000,,Алыста жүрсең де
Dialogue: 0,0:22:12.20,0:22:14.69,JP-ED,,0000,0000,0000,,Ұмытпа
Dialogue: 0,0:22:14.78,0:22:18.45,JP-ED,,0000,0000,0000,,Сол күні мен сезінген құштарлық
Dialogue: 0,0:22:18.45,0:22:22.53,JP-ED,,0000,0000,0000,,Бірге болған армандарымыз
Dialogue: 0,0:22:22.53,0:22:26.16,JP-ED,,0000,0000,0000,,Қып-қызыл аспан
Dialogue: 0,0:22:26.16,0:22:28.93,JP-ED,,0000,0000,0000,,Батып бара жатқан күн
Dialogue: 0,0:22:30.58,0:22:37.93,JP-ED,,0000,0000,0000,,Мен сияқты жүрейік
Dialogue: 0,0:22:44.26,0:22:50.18,CN-ED,,0000,0000,0000,,Камигами субтитрлер жұбы www.kamigami.org
Dialogue: 0,0:00:08.56,0:00:15.36,JP-SUB-uta,,0000,0000,0000,,Ағып тұрған ағаштың көлеңкесінде
Dialogue: 0,0:00:16.82,0:00:19.00,JP-SUB-uta,,0000,0000,0000,,Хана жоқ Ироха
Dialogue: 0,0:00:33.33,0:00:37.93,JP-SUB-uta,,0000,0000,0000,,Нагамесешимани
Dialogue: 0,0:00:38.87,0:00:45.05,JP-SUB-uta,,0000,0000,0000,,Чихаябуру Камиомокиказу Тацутагаха
Dialogue: 0,0:00:48.69,0:00:49.51,JP-SUB,,0000,0000,0000,,Ум...
Dialogue: 0,0:00:50.96,0:00:55.02,JP-SUB,,0000,0000,0000,,Ертең неге карута демонстрациясын тоқтатпасқа?
Dialogue: 0,0:00:55.02,0:00:56.27,JP-SUB,,0000,0000,0000,,Не? неге
Dialogue: 0,0:00:56.89,0:00:59.22,JP-SUB,,0000,0000,0000,,Бірінші курс студенттері міндетті түрде сурет салады
Dialogue: 0,0:00:59.91,0:01:01.13,JP-SUB,,0000,0000,0000,,Әрине
Dialogue: 0,0:01:01.13,0:01:02.56,JP-SUB,,0000,0000,0000,,Мүмкін Кана Чанның айтқаны дұрыс шығар.
Dialogue: 0,0:01:02.56,0:01:04.05,JP-SUB,,0000,0000,0000,,Бұл сүйреу.
Dialogue: 0,0:01:04.51,0:01:05.20,JP-SUB,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:01:05.51,0:01:06.38,JP-SUB,,0000,0000,0000,,Жарайды
Dialogue: 0,0:01:06.60,0:01:08.16,JP-SUB,,0000,0000,0000,,Маған қалдырыңыз
Dialogue: 0,0:01:08.71,0:01:09.33,JP-SUB,,0000,0000,0000,,Иә
Dialogue: 0,0:01:22.76,0:01:23.49,JP-SUB,,0000,0000,0000,,Тайчи
Dialogue: 0,0:01:25.49,0:01:27.49,JP-SUB,,0000,0000,0000,,Жаңа студент, келесің бе?
Dialogue: 0,0:01:28.11,0:01:29.49,JP-SUB,,0000,0000,0000,,Енді ше?
Dialogue: 0,0:01:31.62,0:01:34.29,JP-SUB,,0000,0000,0000,,Карута сізге ұнады деп үміттенемін
Dialogue: 0,0:01:38.11,0:01:38.82,JP-SUB,,0000,0000,0000,,That's right.
Dialogue: 0,0:01:45.91,0:01:47.56,JP-SUB,,0000,0000,0000,,Дәл біз сияқты
Dialogue: 0,0:03:15.80,0:03:17.13,JP-SUB,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:03:17.33,0:03:21.11,JP-SUB,,0000,0000,0000,,Модель Читосе Аясенің сіңлісі сізден бір жас үлкен екенін естідіңіз бе?
Dialogue: 0,0:03:21.11,0:03:22.49,JP-SUB,,0000,0000,0000,,Жоқ, мен жанкүйермін.
Dialogue: 0,0:03:22.49,0:03:23.51,JP-SUB,,0000,0000,0000,,Барып көрейік.
Dialogue: 0,0:03:27.85,0:03:28.76,JP-SUB,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:03:31.07,0:03:32.09,JP-SUB,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:03:33.40,0:03:35.11,JP-SUB,,0000,0000,0000,,Мен тастап кеткеніме сене алар емеспін
Dialogue: 0,0:03:39.67,0:03:41.25,JP-SUB,,0000,0000,0000,,Тез жігіт тауып ал
Dialogue: 0,0:03:41.49,0:03:43.29,JP-SUB,,0000,0000,0000,,Мектептегі ең керемет адам
Dialogue: 0,0:03:43.58,0:03:45.82,JP-SUB-T,,0000,0000,0000,,Мына бау сүйкімді
Dialogue: 0,0:03:45.91,0:03:47.82,JP-SUB-T,,0000,0000,0000,,Менің студенттік билетім қызғылт және сүйкімді, солай емес пе?
Dialogue: 0,0:03:44.40,0:03:45.80,JP-SUB,,0000,0000,0000,,Біздің теннис клубы
Dialogue: 0,0:03:45.89,0:03:48.38,JP-SUB,,0000,0000,0000,,Ұлттық чемпионатта жеңіске жету үшін топ болып жұмыс істеу...
Dialogue: 0,0:03:48.38,0:03:51.51,JP-SUB,,0000,0000,0000,,Біз сүйкімді заттарды жақсы көреміз
Dialogue: 0,0:03:51.78,0:03:53.71,JP-SUB,,0000,0000,0000,,Ал, бұл Ханано-сан, солай ма?
Dialogue: 0,0:03:54.05,0:03:56.33,JP-SUB,,0000,0000,0000,,Менің атым кім, Хинако?
Dialogue: 0,0:03:56.33,0:03:58.36,JP-SUB,,0000,0000,0000,,Мен сүйкімді өзімді жақсы көремін
Dialogue: 0,0:03:59.65,0:04:00.82,JP-SUB,,0000,0000,0000,,Сумире Ханано
Dialogue: 0,0:04:02.05,0:04:05.09,JP-SUB,,0000,0000,0000,,Мен сүйкімділігім үшін мені жақсы көретін адамды іздеймін
Dialogue: 0,0:04:06.16,0:04:07.67,JP-SUB,,0000,0000,0000,,Не...не істеп жатырсың?
Dialogue: 0,0:04:07.78,0:04:09.51,JP-SUB,,0000,0000,0000,,Сондықтан мен оны іздеп жүрмін.
Dialogue: 0,0:04:09.87,0:04:11.93,JP-SUB,,0000,0000,0000,,Әдемі адамдар тобы бар.
Dialogue: 0,0:04:12.67,0:04:16.96,JP-SUB,,0000,0000,0000,,Екеуміз орта мектепте оқитын болсақ та мені тастап кеткен жігітке қайта оралу үшін
Dialogue: 0,0:04:18.05,0:04:19.78,JP-SUB,,0000,0000,0000,,Ерекше жақсы адам
Dialogue: 0,0:04:12.73,0:04:17.33,JP-SUB-T,,0000,0000,0000,,Келесі кіріспе - Hyakunin Isshu жарысы Карута клубы.
Dialogue: 0,0:04:20.53,0:04:22.47,JP-SUB,,0000,0000,0000,,Бұл Тайчи Машима, менеджер.
Dialogue: 0,0:04:24.33,0:04:27.05,JP-SUB,,0000,0000,0000,,Менің атым капитан Чихая Аясе.
Dialogue: 0,0:04:27.20,0:04:28.09,JP-SUB,,0000,0000,0000,,Бұл анық
Dialogue: 0,0:04:28.09,0:04:29.11,JP-SUB,,0000,0000,0000,,Өте әдемі
Dialogue: 0,0:04:29.11,0:04:30.25,JP-SUB,,0000,0000,0000,,Кимоно Кимоно
Dialogue: 0,0:04:30.25,0:04:30.93,JP-SUB,,0000,0000,0000,,Сүйкімді
Dialogue: 0,0:04:30.93,0:04:32.09,JP-SUB,,0000,0000,0000,,Ұстау жақсы
Dialogue: 0,0:04:32.09,0:04:33.40,JP-SUB,,0000,0000,0000,,Карута клубы? Бұл не?
Dialogue: 0,0:04:33.40,0:04:34.13,JP-SUB,,0000,0000,0000,,Минор
Dialogue: 0,0:04:34.13,0:04:35.05,JP-SUB,,0000,0000,0000,,Қызық емес
Dialogue: 0,0:04:35.05,0:04:36.53,JP-SUB,,0000,0000,0000,,Сіз ойламас бұрын
Dialogue: 0,0:04:36.69,0:04:38.42,JP-SUB-T,,0000,0000,0000,,Біздің карута клубы не істейді
Dialogue: 0,0:04:38.49,0:04:42.80,JP-SUB-T,,0000,0000,0000,,Огура Хякунин Исшу арқылы жеке-жеке карута жарысы.
Dialogue: 0,0:04:37.69,0:04:41.67,JP-SUB,,0000,0000,0000,,Чихая-чан мен майор болып көрінетін менеджер хакамада пайда болады.
Dialogue: 0,0:04:42.13,0:04:44.33,JP-SUB,,0000,0000,0000,,Бірінші сынып оқушыларының жүрегін жаулап алады.
Dialogue: 0,0:04:44.71,0:04:47.93,JP-SUB-T,,0000,0000,0000,,Жарыс болғанымен, мәдени жағы да бар...
Dialogue: 0,0:04:44.78,0:04:48.05,JP-SUB,,0000,0000,0000,,Эй, Ханано-сан, бұл адам жақсы емес пе?
Dialogue: 0,0:04:48.27,0:04:48.78,JP-SUB,,0000,0000,0000,,Хана...
Dialogue: 0,0:04:51.62,0:04:52.22,JP-SUB,,0000,0000,0000,,Бүркіт?
Dialogue: 0,0:04:52.89,0:04:54.31,JP-SUB,,0000,0000,0000,,Егер сізді қызықтырса, өтінемін
Dialogue: 0,0:04:54.78,0:04:56.82,JP-SUB,,0000,0000,0000,,Енді капитанның соңғы сөзі.
Dialogue: 0,0:05:01.82,0:05:02.76,JP-SUB,,0000,0000,0000,,Жақсы
Dialogue: 0,0:05:03.58,0:05:04.36,JP-SUB,,0000,0000,0000,,Ум...
Dialogue: 0,0:05:05.60,0:05:10.22,JP-SUB,,0000,0000,0000,,Мен...мен...бірақ менің қарапайым достарым көп емес.
Dialogue: 0,0:05:10.65,0:05:14.02,JP-SUB,,0000,0000,0000,,Менің мақсатым 100 карутамен дос болу.
Dialogue: 0,0:05:14.40,0:05:17.42,JP-SUB,,0000,0000,0000,,Маған да 100 жас керек.
Dialogue: 0,0:05:19.18,0:05:20.29,JP-SUB,,0000,0000,0000,,Жүз адам?
Dialogue: 0,0:05:20.29,0:05:21.89,JP-SUB,,0000,0000,0000,,Сен тым сараңсың Карута клубы
Dialogue: 0,0:05:21.89,0:05:23.31,JP-SUB,,0000,0000,0000,,Карута менің досым
Dialogue: 0,0:05:23.31,0:05:24.69,JP-SUB,,0000,0000,0000,,Сүйкімді және табиғи?
Dialogue: 0,0:05:25.00,0:05:26.07,JP-SUB,,0000,0000,0000,,Өте тітіркендіргіш
Dialogue: 0,0:05:31.47,0:05:31.98,JP-SUB,,0000,0000,0000,,Тет
Dialogue: 0,0:05:32.45,0:05:33.73,JP-SUB,,0000,0000,0000,,Өте сүйкімді
Dialogue: 0,0:05:33.98,0:05:36.85,JP-SUB,,0000,0000,0000,,Бірақ мен таптым
Dialogue: 0,0:05:39.05,0:05:41.00,JP-SUB,,0000,0000,0000,,Ол келе ме? Ол келе ме? Жаңа мүше
Dialogue: 0,0:05:41.20,0:05:43.47,JP-SUB,,0000,0000,0000,,Келмесең, қиналып қаламын.
Dialogue: 0,0:05:43.85,0:05:45.53,JP-SUB,,0000,0000,0000,,Бұл жақсы жауап болды.
Dialogue: 0,0:05:45.91,0:05:46.60,JP-SUB,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:05:46.60,0:05:47.13,JP-SUB,,0000,0000,0000,,Иә
Dialogue: 0,0:05:47.36,0:05:49.07,JP-SUB,,0000,0000,0000,,Бірақ жиі келмеңіз.
Dialogue: 0,0:05:51.18,0:05:54.13,JP-SUB,,0000,0000,0000,,Жоқ, егер бірінші курс студенті келсе
Dialogue: 0,0:05:54.40,0:05:55.82,JP-SUB,,0000,0000,0000,,Біз дұрыс шешім қабылдауымыз керек.
Dialogue: 0,0:05:56.09,0:05:57.16,JP-SUB,,0000,0000,0000,,Білім беру қызметкерлері және т.б.
Dialogue: 0,0:05:59.51,0:06:00.27,JP-SUB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:06:00.27,0:06:05.18,JP-SUB-T,,0000,0000,0000,,Мен мұны істеймін, мен істеймін ...
Dialogue: 0,0:06:00.60,0:06:02.82,JP-SUB,,0000,0000,0000,,Неліктен сіз жақсы болмасаңыз, мұны істегіңіз келеді?
Dialogue: 0,0:06:02.82,0:06:04.93,JP-SUB,,0000,0000,0000,,Мен қалай жаттығуым керек?
Dialogue: 0,0:06:05.29,0:06:06.38,JP-SUB-T,,0000,0000,0000,,Орындаңыз
Dialogue: 0,0:06:10.11,0:06:12.67,JP-SUB,,0000,0000,0000,,Қызық, бірінші курстың қанша студенті келеді?
Dialogue: 0,0:06:18.38,0:06:21.47,JP-SUB,,0000,0000,0000,,Менде клуб шығындарының көбеюімен жаңа шоттарды сатып алдым.
Dialogue: 0,0:06:23.07,0:06:25.13,JP-SUB,,0000,0000,0000,,Сізге карута ұнайды деп үміттенемін.
Dialogue: 0,0:06:26.05,0:06:26.76,JP-SUB,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:06:33.56,0:06:35.05,JP-SUB,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:06:39.20,0:06:40.51,JP-SUB,,0000,0000,0000,,Не болды, Сенпай?
Dialogue: 0,0:06:40.51,0:06:41.47,JP-SUB,,0000,0000,0000,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:06:41.98,0:06:43.42,JP-SUB,,0000,0000,0000,,Жарайды...
Dialogue: 0,0:06:45.56,0:06:46.76,JP-SUB,,0000,0000,0000,,Бұл қабылдау туралы хабарлама.
Dialogue: 0,0:06:47.11,0:06:47.82,JP-SUB,,0000,0000,0000,,Мен де
Dialogue: 0,0:06:47.82,0:06:48.89,JP-SUB,,0000,0000,0000,,Алдын ала рахмет
Dialogue: 0,0:06:50.16,0:06:51.89,JP-SUB,,0000,0000,0000,,Жарайды ма? Барлығы жақсы ма?
Dialogue: 0,0:06:51.89,0:06:52.76,JP-SUB,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:06:52.76,0:06:54.87,JP-SUB,,0000,0000,0000,,Мақсатты тұлғаның қатысуы тиіс қоғамдық жиынға бару үшін
Dialogue: 0,0:06:56.96,0:06:58.11,JP-SUB,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:07:00.27,0:07:02.51,JP-SUB,,0000,0000,0000,,Чиве...? Нира-чан?
Dialogue: 0,0:07:02.62,0:07:04.65,JP-SUB,,0000,0000,0000,,Бұлай жасамаңыз.
Dialogue: 0,0:07:04.87,0:07:07.20,JP-SUB,,0000,0000,0000,,Идиот Чихая, бұл Сумире.
Dialogue: 0,0:07:07.20,0:07:08.49,JP-SUB,,0000,0000,0000,,Сумире-чан
Dialogue: 0,0:07:08.87,0:07:11.13,JP-SUB,,0000,0000,0000,,Бұл әйел ақыр соңында жау.
Dialogue: 0,0:07:11.67,0:07:14.85,JP-SUB,,0000,0000,0000,,Әдемі, табиғи және ақымақ - әйелдердің жауы
Dialogue: 0,0:07:17.22,0:07:19.98,JP-SUB,,0000,0000,0000,,Бірақ мен хакамамен нақты айта алмадым.
Dialogue: 0,0:07:20.69,0:07:22.02,JP-SUB,,0000,0000,0000,,Керемет стиль
Dialogue: 0,0:07:22.96,0:07:23.80,JP-SUB,,0000,0000,0000,,Бұл сізге сәйкес келеді...
Dialogue: 0,0:07:28.20,0:07:31.13,JP-SUB,,0000,0000,0000,,Ал, алдымен екінші курс студенттерімен таныстырып өтейін.
Dialogue: 0,0:07:31.69,0:07:32.36,JP-SUB,,0000,0000,0000,,Артқы жағынан...
Dialogue: 0,0:07:32.36,0:07:34.25,JP-SUB,,0000,0000,0000,,Кешіріңіз, мен сұрақ қоя аламын ба?
Dialogue: 0,0:07:34.82,0:07:37.02,JP-SUB,,0000,0000,0000,,Директор Машиманың қызы бар ма?
Dialogue: 0,0:07:38.31,0:07:39.33,JP-SUB,,0000,0000,0000,,Мен оны жақсы естідім.
Dialogue: 0,0:07:39.33,0:07:40.91,JP-SUB,,0000,0000,0000,,Ханано-сан керемет
Dialogue: 0,0:07:43.67,0:07:45.58,JP-SUB,,0000,0000,0000,,Жоғарғы сынып оқушылары сөйлесіп жатыр
Dialogue: 0,0:07:46.11,0:07:47.89,JP-SUB,,0000,0000,0000,,Сөйлеу кезегіңіз емес
Dialogue: 0,0:07:49.85,0:07:52.33,JP-SUB,,0000,0000,0000,,Лоли үлкен кеуде жау
Dialogue: 0,0:07:52.96,0:07:55.31,JP-SUB,,0000,0000,0000,,Мен теннис үйірмесіне баруым керек.
Dialogue: 0,0:07:55.42,0:07:56.87,JP-SUB,,0000,0000,0000,,Мен мұны сұрадым.
Dialogue: 0,0:07:58.71,0:08:02.27,JP-SUB,,0000,0000,0000,,Кім бәсекелес карута ойнады?
Dialogue: 0,0:08:04.58,0:08:06.53,JP-SUB,,0000,0000,0000,,Хякунин Исшуды 100 өлеңмен еске алатын адам.
Dialogue: 0,0:08:09.87,0:08:12.65,JP-SUB,,0000,0000,0000,,Ештеңе етпейді, бәрі бастапқыда бастаушы.
Dialogue: 0,0:08:13.25,0:08:16.93,JP-SUB,,0000,0000,0000,,Мен Хякунин Исшу стандартты кейіпкерлері мен әннің мағынасын басып шығардым.
Dialogue: 0,0:08:17.31,0:08:19.65,JP-SUB,,0000,0000,0000,,Барлығыңыз 100 өлең жаттаңыздар.
Dialogue: 0,0:08:20.09,0:08:21.56,JP-SUB,,0000,0000,0000,,Иә? Сенің есіңде ме?
Dialogue: 0,0:08:21.56,0:08:22.29,JP-SUB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:08:22.76,0:08:23.71,JP-SUB,,0000,0000,0000,,Бұл неше беттен тұрады?
Dialogue: 0,0:08:23.71,0:08:24.18,JP-SUB,,0000,0000,0000,,Бұл өте қиын.
Dialogue: 0,0:08:24.18,0:08:25.56,JP-SUB,,0000,0000,0000,,Жақсы, сәйкесінше.
Dialogue: 0,0:08:27.36,0:08:29.11,JP-SUB,,0000,0000,0000,,Бір аптадан кейін тест
Dialogue: 0,0:08:29.33,0:08:32.51,JP-SUB,,0000,0000,0000,,100 өлең жаттаудан басқа ештеңеге үлгермеу. Сонымен қатар толықтыру емтиханы өткізіледі.
Dialogue: 0,0:08:32.69,0:08:33.58,JP-SUB-T,,0000,0000,0000,,Иә? сынақ?
Dialogue: 0,0:08:33.65,0:08:35.07,JP-SUB-T,,0000,0000,0000,,Сіз оны дұрыс есте сақтайсыз ба?
Dialogue: 0,0:08:33.56,0:08:36.67,JP-SUB,,0000,0000,0000,,Кана-чан, бұлай бір апта болуы мүмкін емес.
Dialogue: 0,0:08:36.98,0:08:39.36,JP-SUB,,0000,0000,0000,,Біз бәріміз жоғары сынып оқушыларымыз, сондықтан мұны істей аламыз.
Dialogue: 0,0:08:39.71,0:08:40.27,JP-SUB,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:08:40.76,0:08:42.07,JP-SUB,,0000,0000,0000,,Мен бұған рұқсат беруім керек.
Dialogue: 0,0:08:43.51,0:08:45.76,JP-SUB,,0000,0000,0000,,Ендеше сол ережені түсіндірейін...
Dialogue: 0,0:08:45.76,0:08:46.38,JP-SUB,,0000,0000,0000,,Мен?
Dialogue: 0,0:08:47.78,0:08:49.20,JP-SUB,,0000,0000,0000,,Шайқас бір-бірден
Dialogue: 0,0:08:49.38,0:08:52.18,JP-SUB,,0000,0000,0000,,100 дана Хякунин Исшудан 50 дана алыңыз.
Dialogue: 0,0:08:52.33,0:08:53.87,JP-SUB,,0000,0000,0000,,Қалғанын қорапқа саламын.
Dialogue: 0,0:08:54.31,0:08:57.05,JP-SUB,,0000,0000,0000,,25 парақты 3 см қашықтықта орналастыр.
Dialogue: 0,0:08:57.27,0:08:58.91,JP-SUB,,0000,0000,0000,,3 сантиметр.
Dialogue: 0,0:08:59.58,0:09:01.05,JP-SUB,,0000,0000,0000,,Бұл негізгі форма
Dialogue: 0,0:09:01.22,0:09:05.56,JP-SUB,,0000,0000,0000,,Сонымен, Чен картасының 25-ін Cero-ға бірінші түрлендірген адам жеңеді.
Dialogue: 0,0:09:05.98,0:09:09.45,JP-SUB,,0000,0000,0000,,Алдымен, 15 минут ішінде 50 вексельдің орналасқан жерін біліңіз.
Dialogue: 0,0:09:10.93,0:09:12.91,JP-SUB,,0000,0000,0000,,Бүгін – үлгі, сондықтан оған 3 минуттай уақыт кетеді.
Dialogue: 0,0:09:13.11,0:09:14.22,JP-SUB,,0000,0000,0000,,1 минут жеткілікті
Dialogue: 0,0:09:15.22,0:09:17.93,JP-SUB,,0000,0000,0000,,Матч кезінде бірінші оқылатын ән прелюдия деп аталады.
Dialogue: 0,0:09:18.05,0:09:20.29,JP-SUB,,0000,0000,0000,,Бұл ән Хякунин Исшуға кірмеген.
Dialogue: 0,0:09:20.93,0:09:24.85,JP-SUB,,0000,0000,0000,,Хэйан дәуірінде Намбазу әнін білмейтін адам қалмаған деседі.
Dialogue: 0,0:09:24.85,0:09:26.25,JP-SUB,,0000,0000,0000,,Конкурсқа қатысу үшін таңдалды...
Dialogue: 0,0:09:26.25,0:09:26.85,JP-SUB,,0000,0000,0000,,Кана-чан
Dialogue: 0,0:09:28.67,0:09:35.45,JP-SUB-uta,,0000,0000,0000,,Има во Харубето Сакуяконохана
Dialogue: 0,0:09:37.65,0:09:44.38,JP-SUB-uta,,0000,0000,0000,,Има во Харубето Сакуяконохана
Dialogue: 0,0:09:45.49,0:09:47.45,JP-SUB-uta,,0000,0000,0000,,Микамори
Dialogue: 0,0:09:47.62,0:09:49.18,JP-SUB-uta,,0000,0000,0000,,Кохистеф
Dialogue: 0,0:09:49.29,0:09:50.85,JP-SUB,,0000,0000,0000,,ше? Не
Dialogue: 0,0:09:52.18,0:09:55.65,JP-SUB,,0000,0000,0000,,Бұл адамдар не істеп жатыр?
Dialogue: 0,0:10:00.51,0:10:01.96,JP-SUB,,0000,0000,0000,,Міне, солай
Dialogue: 0,0:10:02.51,0:10:05.07,JP-SUB,,0000,0000,0000,,100 өлеңді жаттау және тұрақты кейіпкерлерді жаттау
Dialogue: 0,0:10:05.47,0:10:08.49,JP-SUB,,0000,0000,0000,,Сіз өзіңіздің тұрақты позицияңызды шешкеннен кейін оны тез алуға болады.
Dialogue: 0,0:10:09.25,0:10:12.13,JP-SUB,,0000,0000,0000,,Республикалық турнирге қатысу үшін барлығымыз бар күшімізді салайық
Dialogue: 0,0:10:14.36,0:10:19.05,JP-SUB,,0000,0000,0000,,Мм, мұны түсінбегеніміз емес.
Dialogue: 0,0:10:19.27,0:10:21.60,JP-SUB,,0000,0000,0000,,Бұрыштағы қырылған басты төңкеріп қоюға болмайды.
Dialogue: 0,0:10:23.07,0:10:24.93,JP-SUB,,0000,0000,0000,,Ханано мырза тым шыншыл.
Dialogue: 0,0:10:24.93,0:10:25.49,JP-SUB,,0000,0000,0000,,Жақсы
Dialogue: 0,0:10:25.49,0:10:27.29,JP-SUB,,0000,0000,0000,,Бірақ бәрібір.
Dialogue: 0,0:10:27.29,0:10:28.96,JP-SUB,,0000,0000,0000,,Мен не істерімді де білмеймін
Dialogue: 0,0:10:28.96,0:10:31.69,JP-SUB,,0000,0000,0000,,Әзірше мен Хякунин Исшуды жаттау үшін бар күшімді саламын.
Dialogue: 0,0:10:31.69,0:10:33.42,JP-SUB,,0000,0000,0000,,Біз сізбен келесі аптада жұмыс істеуді асыға күтеміз.
Dialogue: 0,0:10:34.62,0:10:37.20,JP-SUB,,0000,0000,0000,,Ханано-сан керемет.
Dialogue: 0,0:10:41.69,0:10:44.36,JP-SUB,,0000,0000,0000,,Ал... басында осылай.
Dialogue: 0,0:10:45.67,0:10:48.45,JP-SUB,,0000,0000,0000,,Бірақ жиырма адам келді.
Dialogue: 0,0:10:48.76,0:10:51.09,JP-SUB,,0000,0000,0000,,Барлығына мүмкіндігінше түсінуге көмектесу
Dialogue: 0,0:10:51.56,0:10:52.13,JP-SUB,,0000,0000,0000,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:10:53.45,0:10:53.87,JP-SUB,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:57.80,0:10:58.69,JP-SUB,,0000,0000,0000,,Чихая
Dialogue: 0,0:11:02.22,0:11:06.18,JP-SUB,,0000,0000,0000,,Мұндай ынтасыз бірінші сынып оқушыларына сабақ беруге уақытың жоқ.
Dialogue: 0,0:11:07.36,0:11:09.42,JP-SUB,,0000,0000,0000,,Егер сіз Мэйдзин патшайымының шайқасына шындап ұмтылсаңыз
Dialogue: 0,0:11:09.73,0:11:13.38,JP-SUB,,0000,0000,0000,,Үйірме жұмыстарынан үзіліс жасап, Ширанами-кай жаттығуына барған дұрыс емес пе?
Dialogue: 0,0:11:13.67,0:11:15.29,JP-SUB,,0000,0000,0000,,Бұл не? Машима
Dialogue: 0,0:11:16.05,0:11:18.07,JP-SUB,,0000,0000,0000,,Оған дейін орта мектептің біріншілігі өтеді.
Dialogue: 0,0:11:18.33,0:11:20.29,JP-SUB,,0000,0000,0000,,Бұл бір жылдағы бірінші командалық жарыс.
Dialogue: 0,0:11:20.76,0:11:22.53,JP-SUB,,0000,0000,0000,,Жеке жарыс маңыздырақ па?
Dialogue: 0,0:11:23.13,0:11:26.76,JP-SUB,,0000,0000,0000,,Менің ойымша, сіз А сыныбына жете алмаймын деп уайымдайтын шығарсыз.
Dialogue: 0,0:11:26.76,0:11:27.69,JP-SUB,,0000,0000,0000,,Ет тоқаш
Dialogue: 0,0:11:36.02,0:11:37.91,JP-SUB,,0000,0000,0000,,Оқуға жауапты боламын.
Dialogue: 0,0:11:38.36,0:11:39.78,JP-SUB,,0000,0000,0000,,20 адамнан артық емес
Dialogue: 0,0:11:40.20,0:11:42.71,JP-SUB,,0000,0000,0000,,Мен қатал боламын және артымнан еретіндерді ғана қалдырамын.
Dialogue: 0,0:11:43.40,0:11:44.42,JP-SUB,,0000,0000,0000,,Кана-чан солай
Dialogue: 0,0:11:44.82,0:11:46.16,JP-SUB,,0000,0000,0000,,Менің ойымша, бұл жақсы.
Dialogue: 0,0:11:47.27,0:11:50.93,JP-SUB,,0000,0000,0000,,Орта мектеп чемпионатында бесеумізбен күресуге болады.
Dialogue: 0,0:11:51.16,0:11:52.80,JP-SUB,,0000,0000,0000,,Бірінші курс студенттері жақсы.
Dialogue: 0,0:11:53.27,0:11:55.02,JP-SUB,,0000,0000,0000,,Бұрышта басыңды аударсаң да
Dialogue: 0,0:11:56.71,0:11:58.13,JP-SUB,,0000,0000,0000,,Барлығы неге
Dialogue: 0,0:11:58.80,0:12:00.45,JP-SUB,,0000,0000,0000,,Жас жеткіншектерімізді дұрыс жаттықтырайық.
Dialogue: 0,0:12:00.96,0:12:02.38,JP-SUB,,0000,0000,0000,,Карута клубы жалғаспайды.
Dialogue: 0,0:12:05.85,0:12:09.29,JP-SUB,,0000,0000,0000,,Аясе: Бірінші курс студентінен не күтесіз?
Dialogue: 0,0:12:11.49,0:12:13.45,JP-SUB,,0000,0000,0000,,Біз жеңетін адамдармыз.
Dialogue: 0,0:12:22.05,0:12:24.42,JP-SUB,,0000,0000,0000,,Бірінші сынып оқушылары келгенше түсінбедім.
Dialogue: 0,0:12:26.09,0:12:30.27,JP-SUB,,0000,0000,0000,,Бұл басқаша. Әркім бағалайтын нәрсе
Dialogue: 0,0:12:40.85,0:12:42.18,JP-SUB,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:12:42.18,0:12:43.91,JP-SUB,,0000,0000,0000,,Басқа жігітке үміткер табылды
Dialogue: 0,0:12:44.13,0:12:46.98,JP-SUB,,0000,0000,0000,,Ол менен екі жас үлкен және ол өте әдемі және ұзын.
Dialogue: 0,0:12:54.29,0:12:55.96,JP-SUB,,0000,0000,0000,,...
Dialogue: 0,0:12:56.22,0:12:59.38,JP-SUB,,0000,0000,0000,,Ол мен сияқты әдеттегіден сәл сүйкімді.
Dialogue: 0,0:12:59.38,0:13:01.56,JP-SUB,,0000,0000,0000,,Қыздар мангасының басты кейіпкері қандай?
Dialogue: 0,0:13:02.00,0:13:04.98,JP-SUB,,0000,0000,0000,,Әдемі және күшті жауға ұқсайтын қарсылас кейіпкерді жеңіңіз.
Dialogue: 0,0:13:07.67,0:13:09.78,JP-SUB,,0000,0000,0000,,12-беттегі Рюноскэ Акутагаваның «Рашомонына» назар аударайық...
Dialogue: 0,0:13:09.91,0:13:11.80,JP-SUB,,0000,0000,0000,,Жеңіске жететін біздер.
Dialogue: 0,0:13:13.96,0:13:16.60,JP-SUB,,0000,0000,0000,,Рюноскэ Акутагава туралы айтсақ...
Dialogue: 0,0:13:20.22,0:13:22.13,JP-SUB,,0000,0000,0000,,Менің жақсы әңгімем бар...
Dialogue: 0,0:13:23.00,0:13:30.53,JP-SUB,,0000,0000,0000,,Бір күні кішкентай баласы ойнап жүргенде айтқан сөздері.
Dialogue: 0,0:13:31.69,0:13:34.29,JP-SUB,,0000,0000,0000,,Кітаптарды кесіп өтпеңіз
Dialogue: 0,0:13:34.29,0:13:36.09,JP-SUB,,0000,0000,0000,,Е! ? Міне бітті! ?
Dialogue: 0,0:13:36.96,0:13:39.76,JP-SUB,,0000,0000,0000,,Бұл басқаша
Dialogue: 0,0:13:40.82,0:13:43.53,JP-SUB,,0000,0000,0000,,Әр сабақтың алдында викторина болады.
Dialogue: 0,0:13:43.93,0:13:47.18,JP-SUB,,0000,0000,0000,,Екінші курс студенттері үшін қабылдау емтихандарын кері санау басталды.
Dialogue: 0,0:13:47.69,0:13:49.27,JP-SUB,,0000,0000,0000,,Өзіңіз қалаған мектепті анықтаңыз...
Dialogue: 0,0:13:49.27,0:13:50.78,JP-SUB,,0000,0000,0000,,Мен оқуға жауапты боламын.
Dialogue: 0,0:13:51.22,0:13:52.89,JP-SUB,,0000,0000,0000,,Ол түсінбейді.
Dialogue: 0,0:13:53.42,0:13:55.36,JP-SUB,,0000,0000,0000,,Қазір уақыт қаншалықты маңызды?
Dialogue: 0,0:13:56.42,0:13:58.45,JP-SUB,,0000,0000,0000,,Менің арманым патшайым болу болса да
Dialogue: 0,0:13:59.07,0:14:00.42,JP-SUB,,0000,0000,0000,,Жеңілгенде жылаймын
Dialogue: 0,0:14:02.85,0:14:05.11,JP-SUB,,0000,0000,0000,,Сіз бұл түскі үзіліс кездесуі деп айттыңыз.
Dialogue: 0,0:14:05.11,0:14:08.53,JP-SUB,,0000,0000,0000,,Өйткені мен тым жылдам сөйледім және қауын нан сатып алуым керек.
Dialogue: 0,0:14:08.78,0:14:09.98,JP-SUB,,0000,0000,0000,,Мен саған өзімнің жартысын беремін
Dialogue: 0,0:14:09.98,0:14:11.18,JP-SUB,,0000,0000,0000,,Тарине
Dialogue: 0,0:14:11.80,0:14:13.78,JP-SUB,,0000,0000,0000,,Эй Кана Чан, сен ерте келдің.
Dialogue: 0,0:14:14.69,0:14:17.20,JP-SUB,,0000,0000,0000,,5-сынып клуб бөлмесіне ең жақын.
Dialogue: 0,0:14:17.93,0:14:19.47,JP-SUB,,0000,0000,0000,,Әй, бәрі жиналды.
Dialogue: 0,0:14:19.69,0:14:21.25,JP-SUB,,0000,0000,0000,,Бір топ алыс.
Dialogue: 0,0:14:21.42,0:14:23.76,JP-SUB,,0000,0000,0000,,Бұл бірінші курс студенттері туралы.
Dialogue: 0,0:14:25.05,0:14:25.80,JP-SUB,,0000,0000,0000,,Иә
Dialogue: 0,0:14:26.65,0:14:27.62,JP-SUB,,0000,0000,0000,,Чихая
Dialogue: 0,0:14:28.38,0:14:30.56,JP-SUB,,0000,0000,0000,,Сіз үшін ең маңыздысы не?
Dialogue: 0,0:14:31.02,0:14:33.31,JP-SUB,,0000,0000,0000,,Синобу Вакамияны осылай жеңе аласың ба?
Dialogue: 0,0:14:33.56,0:14:36.18,JP-SUB,,0000,0000,0000,,Бірінші сынып оқушыларына сабақ беремін.
Dialogue: 0,0:14:36.53,0:14:37.89,JP-SUB,,0000,0000,0000,,Кейбір балалар бас тартса да
Dialogue: 0,0:14:38.09,0:14:39.76,JP-SUB,,0000,0000,0000,,Алдымен оны дұрыс үйрету керек.
Dialogue: 0,0:14:40.40,0:14:41.42,JP-SUB,,0000,0000,0000,,Бөлмеңізді қорғаңыз
Dialogue: 0,0:14:41.71,0:14:44.76,JP-SUB,,0000,0000,0000,,Менің ойымша, бірінші курс студенттері де көңілді болса жақсы болар еді.
Dialogue: 0,0:14:45.16,0:14:48.18,JP-SUB,,0000,0000,0000,,Жиырма адам жақын арада зейінін жинақтай алады ма?
Dialogue: 0,0:14:48.31,0:14:50.49,JP-SUB,,0000,0000,0000,,Орта мектеп чемпионатының алдын ала кезеңі маусым айында өтеді.
Dialogue: 0,0:14:52.80,0:14:53.65,JP-SUB,,0000,0000,0000,,Чихая
Dialogue: 0,0:14:59.60,0:15:01.53,JP-SUB,,0000,0000,0000,,Мен үшін қазір ең маңыздысы
Dialogue: 0,0:15:02.18,0:15:03.58,JP-SUB,,0000,0000,0000,,Тайчи А класына айналады
Dialogue: 0,0:15:06.33,0:15:08.18,JP-SUB,,0000,0000,0000,,Чихая...мен туралы...
Dialogue: 0,0:15:09.67,0:15:10.73,JP-SUB,,0000,0000,0000,,Сонымен мақсат
Dialogue: 0,0:15:11.56,0:15:14.73,JP-SUB,,0000,0000,0000,,Орта мектеп чемпионатының турнирінің жеңімпазы
Dialogue: 0,0:15:15.49,0:15:17.73,JP-SUB,,0000,0000,0000,,Жеке сайыс Әр сыныптағы жеңімпаздар
Dialogue: 0,0:15:18.80,0:15:21.00,JP-SUB,,0000,0000,0000,,Бірінші сынып оқушыларының тәрбиесіне тоқталу
Dialogue: 0,0:15:21.31,0:15:24.02,JP-SUB,,0000,0000,0000,,Бұл Хокуо Гакуэн сияқты күшті карута мектебі бола ма?
Dialogue: 0,0:15:27.33,0:15:28.73,JP-SUB,,0000,0000,0000,,Не болды?
Dialogue: 0,0:15:29.40,0:15:31.87,JP-SUB,,0000,0000,0000,,Ашкөздік
Dialogue: 0,0:15:32.71,0:15:35.58,JP-SUB,,0000,0000,0000,,Мен мұндай сараң адамды көрген емеспін.
Dialogue: 0,0:15:35.80,0:15:36.65,JP-SUB,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:15:37.09,0:15:38.31,JP-SUB,,0000,0000,0000,,Чихая
Dialogue: 0,0:15:39.51,0:15:40.78,JP-SUB,,0000,0000,0000,,Басқа Хамадашимо
Dialogue: 0,0:15:40.78,0:15:42.78,JP-SUB,,0000,0000,0000,,Күшті карута мектебі дегеніміз не?
Dialogue: 0,0:15:43.67,0:15:47.05,JP-SUB,,0000,0000,0000,,Кем дегенде, Китао сияқты лайықты көшбасшы жоқ.
Dialogue: 0,0:15:47.05,0:15:49.76,JP-SUB,,0000,0000,0000,,Егер менде кіші болса
Dialogue: 0,0:15:50.09,0:15:52.98,JP-SUB,,0000,0000,0000,,Оқуды бітіргеннен кейін де мен Карутаға сабақ беруге келемін.
Dialogue: 0,0:15:58.31,0:16:00.82,JP-SUB,,0000,0000,0000,,Мен мұндай сараңды көрген емеспін.
Dialogue: 0,0:16:02.53,0:16:04.51,JP-SUB,,0000,0000,0000,,Кейбіреулер Карутаны қатты жақсы көреді
Dialogue: 0,0:16:08.60,0:16:12.09,JP-SUB,,0000,0000,0000,,ше? Мен Машима-сенпайдың үйрететініне сенімдімін.
Dialogue: 0,0:16:12.91,0:16:16.53,JP-SUB,,0000,0000,0000,,Екінші курстың басқа студенттері маусым айында өтетін турнирге жаттығады.
Dialogue: 0,0:16:17.20,0:16:18.69,JP-SUB,,0000,0000,0000,,Барлығы негіздерді түсінгеннен кейін
Dialogue: 0,0:16:18.80,0:16:20.20,JP-SUB,,0000,0000,0000,,Өйткені біз бірге жаттығу жасай аламыз
Dialogue: 0,0:16:20.96,0:16:22.67,JP-SUB,,0000,0000,0000,,Аясе-сенпай жарай ма?
Dialogue: 0,0:16:23.18,0:16:25.27,JP-SUB,,0000,0000,0000,,Күшсіз болғандықтан жаттығуға жауаптысыз ба?
Dialogue: 0,0:16:25.27,0:16:26.31,JP-SUB,,0000,0000,0000,,Ауыстыру және т.б.
Dialogue: 0,0:16:26.73,0:16:27.80,JP-SUB,,0000,0000,0000,,Мен білмеймін
Dialogue: 0,0:16:30.69,0:16:34.67,JP-SUB,,0000,0000,0000,,Эйс Жакен
Dialogue: 0,0:16:35.13,0:16:36.45,JP-SUB,,0000,0000,0000,,Ал, бүгін біз таспаны қолданамыз.
Dialogue: 0,0:16:36.76,0:16:37.31,JP-SUB,,0000,0000,0000,,Иә
Dialogue: 0,0:16:38.16,0:16:39.16,JP-SUB,,0000,0000,0000,,Әлі бастайық па?
Dialogue: 0,0:16:39.40,0:16:39.85,JP-SUB,,0000,0000,0000,,Иә
Dialogue: 0,0:16:40.20,0:16:44.49,JP-SUB,,0000,0000,0000,,Ал, шайқас - мен және Кана-чан, Маджима және Никуман-кун.
Dialogue: 0,0:16:46.07,0:16:50.62,JP-SUB,,0000,0000,0000,,Ширанами-каймен жаттығуға бара аламын ба?
Dialogue: 0,0:16:51.56,0:16:52.89,JP-SUB,,0000,0000,0000,,Тіпті сейсенбі немесе бейсенбі
Dialogue: 0,0:16:54.73,0:16:57.51,JP-SUB,,0000,0000,0000,,Неге ұстап тұрсың? Кәне.
Dialogue: 0,0:16:57.51,0:17:00.45,JP-SUB,,0000,0000,0000,,Мұнда Харада мырза мен Цубогучи мырза да бар.
Dialogue: 0,0:17:03.91,0:17:07.51,JP-SUB,,0000,0000,0000,,Дәл қазір ең маңыздысы - Тайчидің А-сыныпқа айналуы.
Dialogue: 0,0:17:11.58,0:17:14.78,JP-SUB,,0000,0000,0000,,Мен Аясе аздап өзгерген сияқтымын.
Dialogue: 0,0:17:14.78,0:17:16.20,JP-SUB,,0000,0000,0000,,Ол өзгерді ме?
Dialogue: 0,0:17:17.09,0:17:18.62,JP-SUB,,0000,0000,0000,,Мен мұны жақсы айта алмаймын, бірақ
Dialogue: 0,0:17:19.29,0:17:21.80,JP-SUB,,0000,0000,0000,,Өйткені, білесіз бе, Аясе былай деді:
Dialogue: 0,0:17:22.11,0:17:25.40,JP-SUB,,0000,0000,0000,,Маджима ақыры өзі туралы ғана ойлай бастады.
Dialogue: 0,0:17:28.51,0:17:29.27,JP-SUB,,0000,0000,0000,,Су асты сүңгуіршілердің бәрі бір ауыздан келіседі:
Dialogue: 0,0:17:29.87,0:17:31.40,JP-SUB-T,,0000,0000,0000,,Сіз барлық әндерді жаттай аласыз, бірақ
Dialogue: 0,0:17:31.78,0:17:33.65,JP-SUB-T,,0000,0000,0000,,Сөзді сөз тіркестері арқылы есте сақтау тәсілі де бар.
Dialogue: 0,0:17:29.80,0:17:32.67,JP-SUB,,0000,0000,0000,,Есте сақтау классикалық сабақ сияқты.
Dialogue: 0,0:17:34.18,0:17:36.31,JP-SUB,,0000,0000,0000,,Онда бала болды ма?
Dialogue: 0,0:17:37.11,0:17:37.93,JP-SUB,,0000,0000,0000,,Жарайсың ба?
Dialogue: 0,0:17:42.07,0:17:45.36,JP-SUB,,0000,0000,0000,,«Укари керу» себебі төмендегі сөз тіркесі «Хагеши Каре ва»
Dialogue: 0,0:17:45.71,0:17:46.87,JP-SUB,,0000,0000,0000,,«Абайсыз таз»
Dialogue: 0,0:17:50.62,0:17:52.65,JP-SUB,,0000,0000,0000,,Сумире-сан, не болды?
Dialogue: 0,0:17:52.65,0:17:54.25,JP-SUB,,0000,0000,0000,,Онда бірдеңе болды ма? елес? жәндік?
Dialogue: 0,0:17:55.58,0:18:00.96,JP-SUB,,0000,0000,0000,,Мен ән шынымен де солай деп ойладым.
Dialogue: 0,0:18:07.49,0:18:13.09,JP-SUB,,0000,0000,0000,,Жастық пен сұлулық тез кетеді
Dialogue: 0,0:18:18.47,0:18:19.98,JP-SUB,,0000,0000,0000,,Сіз махаббатпен өмір сүргенде не істейсіз?
Dialogue: 0,0:18:20.69,0:18:22.56,JP-SUB,,0000,0000,0000,,Сенпай, мұңайып кеттім.
Dialogue: 0,0:18:23.00,0:18:24.53,JP-SUB,,0000,0000,0000,,Бүгін үйге баруға рұқсат етіңізші.
Dialogue: 0,0:18:28.67,0:18:30.33,JP-SUB,,0000,0000,0000,,Қандай нәзік
Dialogue: 0,0:18:42.22,0:18:43.16,JP-SUB,,0000,0000,0000,,Машима Сенпай
Dialogue: 0,0:18:44.71,0:18:46.07,JP-SUB,,0000,0000,0000,,Сіз...
Dialogue: 0,0:18:46.38,0:18:47.40,JP-SUB,,0000,0000,0000,,Апа, қандай әдепсіз!
Dialogue: 0,0:18:47.87,0:18:51.09,JP-SUB,,0000,0000,0000,,Менің басым ауырып тұр, сондықтан үйге ерте баруым керек.
Dialogue: 0,0:18:51.38,0:18:53.85,JP-SUB,,0000,0000,0000,,Бұл Сумире-чан ғой, солай ма?
Dialogue: 0,0:18:54.00,0:18:55.71,JP-SUB,,0000,0000,0000,,Кя Сумире-чан
Dialogue: 0,0:18:56.02,0:18:56.67,JP-SUB,,0000,0000,0000,,Сіздің тегіңіз кім?
Dialogue: 0,0:18:56.67,0:18:57.73,JP-SUB,,0000,0000,0000,,Бұл Ханано.
Dialogue: 0,0:18:58.51,0:19:00.82,JP-SUB,,0000,0000,0000,,Ханано мырза карута клубына қосылады деп ойлайсыз ба?
Dialogue: 0,0:19:00.82,0:19:01.78,JP-SUB,,0000,0000,0000,,Бірлесіп күресу
Dialogue: 0,0:19:02.58,0:19:03.91,JP-SUB,,0000,0000,0000,,Өлім төсегінде жатқан Командантан хат бар
Dialogue: 0,0:19:06.16,0:19:07.98,JP-SUB,,0000,0000,0000,,Тіпті Машима-сенпайдың даусы жақсы.
Dialogue: 0,0:19:08.22,0:19:10.87,JP-SUB,,0000,0000,0000,,Менің жолым болғаны сонша, мен мектепке сол маршрутпен барамын.
Dialogue: 0,0:19:13.18,0:19:14.87,JP-SUB,,0000,0000,0000,,Бұл дұрыс емес Бұл дұрыс емес
Dialogue: 0,0:19:15.11,0:19:17.07,JP-SUB,,0000,0000,0000,,Маған жел соқпайды
Dialogue: 0,0:19:17.67,0:19:19.51,JP-SUB,,0000,0000,0000,,Бос орындық бар, отырыңыз.
Dialogue: 0,0:19:19.62,0:19:22.11,JP-SUB,,0000,0000,0000,,Жоқ, менің үлкендерімді есептемегенде, солай.
Dialogue: 0,0:19:22.45,0:19:26.67,JP-SUB,,0000,0000,0000,,Оның үстіне мені бұдан да ауыр сезінетін адамдар болуы мүмкін.
Dialogue: 0,0:19:27.42,0:19:29.76,JP-SUB,,0000,0000,0000,,Бос болса да отырмауға тырысамын.
Dialogue: 0,0:19:31.49,0:19:34.80,JP-SUB,,0000,0000,0000,,Осылай сау қыз болсаң, барасың.
Dialogue: 0,0:19:36.29,0:19:39.91,JP-SUB,,0000,0000,0000,,Жарайды, Ханано-санның да жағдайы жақсы емес.
Dialogue: 0,0:19:44.29,0:19:45.25,JP-SUB,,0000,0000,0000,,Эй, ол адам.
Dialogue: 0,0:19:45.91,0:19:46.93,JP-SUB,,0000,0000,0000,,Керемет емес пе?
Dialogue: 0,0:19:59.65,0:20:01.78,JP-SUB,,0000,0000,0000,,Машима-сенпай танымал болар еді.
Dialogue: 0,0:20:03.87,0:20:05.09,JP-SUB,,0000,0000,0000,,Енді ше?
Dialogue: 0,0:20:05.09,0:20:06.40,JP-SUB,,0000,0000,0000,,Сіз міндетті түрде танымал боласыз
Dialogue: 0,0:20:06.67,0:20:08.82,JP-SUB,,0000,0000,0000,,Мойындаулар көп болатынына сенімдімін.
Dialogue: 0,0:20:09.38,0:20:10.89,JP-SUB,,0000,0000,0000,,Мен онымен еш қиналмаймын.
Dialogue: 0,0:20:11.87,0:20:15.49,JP-SUB,,0000,0000,0000,,Аа, мен қазір ондай нәрсені түсінбеймін.
Dialogue: 0,0:20:16.40,0:20:19.02,JP-SUB,,0000,0000,0000,,Еркек әйел таңдаса не істер еді деп ойлаймын.
Dialogue: 0,0:20:21.22,0:20:24.25,JP-SUB,,0000,0000,0000,,Мен таңдаймын және бар күшімді саламын.
Dialogue: 0,0:20:36.56,0:20:38.89,JP-SUB,,0000,0000,0000,,Бубайгавара Бубайгавара
Dialogue: 0,0:20:39.85,0:20:41.22,JP-SUB,,0000,0000,0000,,Өйткені Ханано-сан сүйкімді
Dialogue: 0,0:20:41.65,0:20:42.98,JP-SUB,,0000,0000,0000,,Сусынға таңдалмаңыз
Dialogue: 0,0:20:43.31,0:20:43.96,JP-SUB,,0000,0000,0000,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:20:51.51,0:20:53.33,JP-SUB,,0000,0000,0000,,Мен оны қатты сезініп тұрмын, бұл қорқынышты
Dialogue: 0,0:20:55.62,0:20:58.93,JP-SUB,,0000,0000,0000,,Машима-сенпай мені ешқашан таңдамайды
Dialogue: 0,0:21:03.29,0:21:04.00,JP-SUB,,0000,0000,0000,,Ал Вайолет ше?
Dialogue: 0,0:21:05.62,0:21:07.18,JP-SUB,,0000,0000,0000,,Мен де таңдағым келеді
Dialogue: 0,0:21:08.40,0:21:12.22,JP-SUB,,0000,0000,0000,,Өкініш жырын айтпаймын
Dialogue: 0,0:21:14.62,0:21:17.29,JP-SUB,,0000,0000,0000,,Махаббаттың сирек соққан желіне қарамастан
Dialogue: 0,0:21:19.73,0:21:23.36,JP-SUB,,0000,0000,0000,,Капитан Тен Генпей соғысында 100 тиын алды.
