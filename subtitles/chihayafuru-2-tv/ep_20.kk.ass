Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.00,0:00:10.92,Default,,0,0,0,,Ұлттық орта мектеп Кокура Хякунин Исшу Карута чемпионаты
Dialogue: 0,0:00:11.01,0:00:12.80,Default,,0,0,0,,Командалық жарыс чемпионаты
Dialogue: 0,0:00:12.88,0:00:15.80,Default,,0,0,0,,Токио Мизусава орта мектебі
Dialogue: 0,0:00:21.10,0:00:22.18,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:00:23.39,0:00:28.40,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:00:35.82,0:00:37.66,Default,,0,0,0,,Чихая-чан (Чихая) Ха...
Dialogue: 0,0:00:41.66,0:00:43.29,Default,,0,0,0,,Хехе
Dialogue: 0,0:00:50.46,0:00:52.71,Default,,0,0,0,,Ауыр, абай болыңыз
Dialogue: 0,0:00:53.97,0:00:55.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:56.38,0:00:59.89,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:00:59.97,0:01:01.22,Default,,0,0,0,,Сонымен мақсат
Dialogue: 0,0:01:01.31,0:01:04.73,Default,,0,0,0,,Орта мектеп чемпионатының турнирінің жеңімпазы
Dialogue: 0,0:01:05.48,0:01:06.77,Default,,0,0,0,,Ол ақыры келді
Dialogue: 0,0:01:06.85,0:01:08.98,Default,,0,0,0,,Екі адам да қалды.
Dialogue: 0,0:01:09.06,0:01:12.65,Default,,0,0,0,,Королева болғаннан жақсы, Жапониядағы ең жақсы қыз болғаннан жақсы
Dialogue: 0,0:01:12.73,0:01:15.15,Default,,0,0,0,,Жапонияда бірінші болу барлығына қиынырақ!
Dialogue: 0,0:01:15.24,0:01:17.16,Default,,0,0,0,,Юраното~
Dialogue: 0,0:01:20.33,0:01:21.33,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:01:21.41,0:01:24.20,Default,,0,0,0,,Фуфуфу (Сумире мен Канаденің жылауы)
Dialogue: 0,0:01:24.29,0:01:25.71,Default,,0,0,0,,(Сарайдағы айқай)
Dialogue: 0,0:01:25.79,0:01:30.79,Default,,0,0,0,,(Барлығы жылайды және күледі)
Dialogue: 0,0:01:33.17,0:01:39.30,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:01:39.39,0:01:40.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:46.02,0:01:50.56,Default,,0,0,0,,♪~
Dialogue: 0,0:02:50.92,0:02:55.92,Default,,0,0,0,,~♪
Dialogue: 0,0:02:57.13,0:02:59.59,Default,,0,0,0,,Ештеңені ұмытпағаныңызға сенімдісіз бе?
Dialogue: 0,0:02:59.67,0:03:00.72,Default,,0,0,0,,Жарайды
Dialogue: 0,0:03:00.80,0:03:01.63,Default,,0,0,0,,Трофейлер ше?
Dialogue: 0,0:03:01.72,0:03:04.35,Default,,0,0,0,,Мен олардың барлығын мектепке жіберемін, сондықтан барлығын осында қойыңыз.
Dialogue: 0,0:03:04.97,0:03:09.39,Default,,0,0,0,,Ааа, шот-фактура жазуым керек... Қызық, барлығы қанша болады?
Dialogue: 0,0:03:09.48,0:03:10.60,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:03:10.69,0:03:12.10,Default,,0,0,0,,Не? Аясе мырза
Dialogue: 0,0:03:12.85,0:03:13.94,Default,,0,0,0,,Ум...
Dialogue: 0,0:03:14.02,0:03:16.61,Default,,0,0,0,,Мен бара алатын ауруханалар бар ма?
Dialogue: 0,0:03:16.69,0:03:18.61,Default,,0,0,0,,Не? (Тайчи және басқалар) О?
Dialogue: 0,0:03:19.53,0:03:21.78,Default,,0,0,0,,О, ісіп кетті!
Dialogue: 0,0:03:22.45,0:03:24.28,Default,,0,0,0,,Неге ертерек айтпадың?
Dialogue: 0,0:03:25.20,0:03:27.62,Default,,0,0,0,,Жедел жәрдем ауруханасын білемін, былтыр да барғанмын.
Dialogue: 0,0:03:27.70,0:03:29.25,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:03:29.33,0:03:31.54,Default,,0,0,0,,Ое мырза да сенімді болу үшін барады ма?
Dialogue: 0,0:03:31.62,0:03:34.21,Default,,0,0,0,,Менің ісігім басылып қалды.
Dialogue: 0,0:03:34.29,0:03:35.50,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:35.59,0:03:38.30,Default,,0,0,0,,А, онда Машима-кун, қалғанын өзің шешіп алайын.
Dialogue: 0,0:03:38.38,0:03:39.84,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:03:42.59,0:03:45.09,Default,,0,0,0,,Чихая-чан, жақсысың ба?
Dialogue: 0,0:03:45.18,0:03:47.43,Default,,0,0,0,,Ертең жеке турнир де бар.
Dialogue: 0,0:03:47.51,0:03:49.77,Default,,0,0,0,,Әзірше қорапқа саламын.
Dialogue: 0,0:03:49.85,0:03:51.39,Default,,0,0,0,,Медальдарды да сол жерге салуым керек пе?
Dialogue: 0,0:03:51.48,0:03:52.52,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:52.60,0:03:55.23,Default,,0,0,0,,Маған жастық ретінде қолдануға болатын нәрсе қою керек.
Dialogue: 0,0:03:55.31,0:03:57.15,Default,,0,0,0,,Сүлгіні қолдануға болады ма?
Dialogue: 0,0:03:57.23,0:03:58.48,Default,,0,0,0,,Тайчи (Тайчи) Ах.
Dialogue: 0,0:03:58.57,0:04:00.90,Default,,0,0,0,,Мен бұл сувенирді ұмытып кетіппін.
Dialogue: 0,0:04:03.11,0:04:05.66,Default,,0,0,0,,Ах, Чихая, не болды?
Dialogue: 0,0:04:09.49,0:04:11.54,Default,,0,0,0,,Біз де вокзалға жаяу барамыз ба?
Dialogue: 0,0:04:11.62,0:04:15.29,Default,,0,0,0,,Жоқ, әулиенің кіре берісінен мені ағам алып кетеді.
Dialogue: 0,0:04:15.38,0:04:16.21,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:16.29,0:04:17.92,Default,,0,0,0,,Солтүстік Орталық! (Жаңа Тайчи) Ой?
Dialogue: 0,0:04:18.00,0:04:19.17,Default,,0,0,0,,Фай-о! Фай о!
Dialogue: 0,0:04:19.25,0:04:21.38,Default,,0,0,0,,Мен станцияға барынша тез жүгіремін.
Dialogue: 0,0:04:21.46,0:04:22.92,Default,,0,0,0,,Темера!
Dialogue: 0,0:04:23.01,0:04:25.01,Default,,0,0,0,,Фаио Файо!
Dialogue: 0,0:04:25.09,0:04:27.47,Default,,0,0,0,,Өйткені, ұлдар мектебі ақымақ.
Dialogue: 0,0:04:27.47,0:04:27.85,Default,,0,0,0,,Өйткені, ұлдар мектебі ақымақ. (Хаясака) Мен ерте шомылғым келеді.
Dialogue: 0,0:04:27.85,0:04:27.93,Default,,0,0,0,,Мен жақында ваннаға түскім келеді.
Dialogue: 0,0:04:27.93,0:04:29.10,Default,,0,0,0,,Мен тез шомылғым келеді. Мұғалім, сен маған такси шақыра аласың ба?
Dialogue: 0,0:04:29.10,0:04:29.18,Default,,0,0,0,,Мұғалім, маған такси шақыра аласыз ба?
Dialogue: 0,0:04:29.18,0:04:29.47,Default,,0,0,0,,Мұғалім, маған такси шақыра аласыз ба? (Нанасе) Мен күріш жегім келеді.
Dialogue: 0,0:04:29.47,0:04:29.56,Default,,0,0,0,,Мен күріш жегім келеді
Dialogue: 0,0:04:29.56,0:04:31.02,Default,,0,0,0,,Мен ертеңгі жеке жарысқа күріш жегім келеді.
Dialogue: 0,0:04:31.10,0:04:32.43,Default,,0,0,0,,Дене күшін сақтау және
Dialogue: 0,0:04:35.40,0:04:40.32,Default,,0,0,0,,Иә?! Ватая-сан, Машима-сенпай және Аясе-сенпай бала кезден достар ма?
Dialogue: 0,0:04:40.40,0:04:40.94,Default,,0,0,0,,(Күлгіннің ауыр тыныс алуы)
Dialogue: 0,0:04:40.94,0:04:42.57,Default,,0,0,0,,(Күлгіннің ауыр тыныс алуы)
Dialogue: 0,0:04:40.94,0:04:42.57,Default,,0,0,0,,Иә (Тайчи) Жақсы...
Dialogue: 0,0:04:42.65,0:04:43.32,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,0:04:43.32,0:04:43.99,Default,,0,0,0,,Бұл жағдайда
Dialogue: 0,0:04:43.32,0:04:43.99,Default,,0,0,0,,Жоқ... Бұл баланс дегеніміз не?
Dialogue: 0,0:04:43.99,0:04:44.07,Default,,0,0,0,,Жоқ... Бұл баланс дегеніміз не?
Dialogue: 0,0:04:44.07,0:04:45.32,Default,,0,0,0,,Жоқ... Бұл баланс дегеніміз не?
Dialogue: 0,0:04:44.07,0:04:45.32,Default,,0,0,0,,Мен және Китаодағы Хёро бала кезден доспыз...
Dialogue: 0,0:04:45.32,0:04:45.41,Default,,0,0,0,,Мен және Китаодағы Хёро бала кезден доспыз...
Dialogue: 0,0:04:45.41,0:04:46.45,Default,,0,0,0,,Мен және Китаодағы Хёро бала кезден доспыз...
Dialogue: 0,0:04:45.41,0:04:46.45,Default,,0,0,0,,Бұл махаббат үшбұрышы ма?
Dialogue: 0,0:04:46.45,0:04:46.53,Default,,0,0,0,,Бұл махаббат үшбұрышы ма?
Dialogue: 0,0:04:46.53,0:04:48.32,Default,,0,0,0,,Бұл махаббат үшбұрышы ма?
Dialogue: 0,0:04:46.53,0:04:48.32,Default,,0,0,0,,Мені тыңдама, мына жігіт.
Dialogue: 0,0:04:48.41,0:04:50.37,Default,,0,0,0,,Ватая мырзаның мектебі бірлескен білім беру ме?
Dialogue: 0,0:04:50.45,0:04:51.66,Default,,0,0,0,,Не? (Сумире) Сізге қандай қыз ұнайды?
Dialogue: 0,0:04:51.74,0:04:53.37,Default,,0,0,0,,Сіздің қызыңыз бар ма? (Жаңа) Иә?
Dialogue: 0,0:04:53.45,0:04:55.42,Default,,0,0,0,,Өйткені, бұл маңызды емес пе?
Dialogue: 0,0:04:55.50,0:04:57.00,Default,,0,0,0,,Бұл өте ашық.
Dialogue: 0,0:04:57.08,0:04:58.42,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:04:57.08,0:04:58.42,Default,,0,0,0,,Өйткені, өйткені, өйткені! (Дыбыс) Мен сенің сезіміңді түсінемін.
Dialogue: 0,0:04:58.42,0:04:58.50,Default,,0,0,0,,Өйткені, өйткені, өйткені! (Дыбыс) Мен сенің сезіміңді түсінемін.
Dialogue: 0,0:04:58.50,0:04:59.54,Default,,0,0,0,,Өйткені, өйткені, өйткені! (Дыбыс) Мен сенің сезіміңді түсінемін.
Dialogue: 0,0:04:58.50,0:04:59.54,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:04:59.63,0:05:01.25,Default,,0,0,0,,Түсіндім, бірақ... (Сумире) Білгім келеді. Мен білгім келеді.
Dialogue: 0,0:04:59.63,0:05:01.25,Default,,0,0,0,,Кешкі асқа не ішеміз?
Dialogue: 0,0:05:01.34,0:05:02.38,Default,,0,0,0,,Мен білгім келеді!
Dialogue: 0,0:05:02.46,0:05:05.97,Default,,0,0,0,,Бұл керемет, Тайчи. Ол бала да карута ойнайды.
Dialogue: 0,0:05:06.05,0:05:07.39,Default,,0,0,0,,Мен бастаушымын.
Dialogue: 0,0:05:08.01,0:05:10.81,Default,,0,0,0,,Чихая салу үшін барын салды.
Dialogue: 0,0:05:11.51,0:05:12.77,Default,,0,0,0,,Мен көремін (Тайчи) Хмм...
Dialogue: 0,0:05:15.64,0:05:16.56,Default,,0,0,0,,Команда…
Dialogue: 0,0:05:18.73,0:05:22.07,Default,,0,0,0,,Тайчи Мен үшін команда
Dialogue: 0,0:05:23.11,0:05:26.90,Default,,0,0,0,,Мұны тек Тайчи мен Чихая жасады.
Dialogue: 0,0:05:27.49,0:05:29.16,Default,,0,0,0,,А...
Dialogue: 0,0:05:36.16,0:05:40.79,Default,,0,0,0,,А-а... жексұрын, айға қарашы, әлде бірдеңе.
Dialogue: 0,0:05:41.38,0:05:45.55,Default,,0,0,0,,Жоқ, бәрі жақсы, бұл маңызды емес, бірақ мен...
Dialogue: 0,0:05:46.67,0:05:48.59,Default,,0,0,0,,Мен Токиоға университетке баруды ойлап жүрмін.
Dialogue: 0,0:05:48.68,0:05:52.14,Default,,0,0,0,,Иә? Бұл қай университет?
Dialogue: 0,0:05:52.22,0:05:53.43,Default,,0,0,0,,Ұсыныстарды қайдан алуға болады
Dialogue: 0,0:05:55.43,0:05:59.02,Default,,0,0,0,,Ертеңгі жеке жарыста жеңіске жетіп, Токиоға барыңыз
Dialogue: 0,0:06:02.82,0:06:04.28,Default,,0,0,0,,Токиоға?
Dialogue: 0,0:06:04.86,0:06:08.36,Default,,0,0,0,,Арата Токиода...
Dialogue: 0,0:06:08.45,0:06:09.95,Default,,0,0,0,,
Dialogue: 0,0:06:10.03,0:06:12.49,Default,,0,0,0,,Әй, бұл менің ағамның көлігі.
Dialogue: 0,0:06:12.58,0:06:14.49,Default,,0,0,0,,Ертең кездескенше Тайчи
Dialogue: 0,0:06:16.54,0:06:17.75,Default,,0,0,0,,Жаңа
Dialogue: 0,0:06:18.33,0:06:22.96,Default,,0,0,0,,Чихая бір күні Аратамен команда болғысы келеді.
Dialogue: 0,0:06:23.63,0:06:24.71,Default,,0,0,0,,Мен басқашамын.
Dialogue: 0,0:06:26.88,0:06:27.72,Default,,0,0,0,,Бұл жау.
Dialogue: 0,0:06:27.80,0:06:29.97,Default,,0,0,0,,Иә? Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:06:30.89,0:06:31.72,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:06:33.72,0:06:34.72,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:06:43.82,0:06:47.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:47.24,0:06:48.90,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:06:48.99,0:06:51.78,Default,,0,0,0,,Не? «Қызық» дегенді қалай түсінесіңдер? Мұғалім
Dialogue: 0,0:06:51.86,0:06:56.16,Default,,0,0,0,,Хм... Сүйегі жарылған сияқты емес.
Dialogue: 0,0:06:56.24,0:06:58.83,Default,,0,0,0,,Бұл аульсия сынығы ма?
Dialogue: 0,0:06:58.91,0:07:00.29,Default,,0,0,0,,Авульсияның сынуы!?
Dialogue: 0,0:07:00.37,0:07:04.96,Default,,0,0,0,,Иә, бірақ егер бұл сүйек сынса, ол ауырырақ.
Dialogue: 0,0:07:05.04,0:07:06.96,Default,,0,0,0,,Ісіну де жаман емес.
Dialogue: 0,0:07:07.05,0:07:10.43,Default,,0,0,0,,Мен сізге кіріспе хат жазамын, сондықтан үлкен ауруханаға қайта тексерілу үшін барыңыз.
Dialogue: 0,0:07:10.51,0:07:11.84,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:07:11.93,0:07:15.22,Default,,0,0,0,,Ертең менің баламда карутадан жарыс өтеді.
Dialogue: 0,0:07:15.30,0:07:16.18,Default,,0,0,0,,Сіз кете аласыз ба?
Dialogue: 0,0:07:16.85,0:07:18.47,Default,,0,0,0,,Карута?
Dialogue: 0,0:07:18.56,0:07:20.98,Default,,0,0,0,,Осылай болса, жарайды.
Dialogue: 0,0:07:21.06,0:07:22.94,Default,,0,0,0,,Кішкене қарқындырақ
Dialogue: 0,0:07:23.69,0:07:25.94,Default,,0,0,0,,Қарқынды деп айту мүмкін емес сияқты.
Dialogue: 0,0:07:26.57,0:07:29.53,Default,,0,0,0,,Сүйектерде әлсіз жерлер бар екені рас.
Dialogue: 0,0:07:29.61,0:07:33.07,Default,,0,0,0,,Соққанда ауырады, сондықтан бас тартудан басқа амал жоқ.
Dialogue: 0,0:07:36.91,0:07:38.08,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:07:38.16,0:07:39.95,Default,,0,0,0,,Ах, Чихая-чан
Dialogue: 0,0:07:40.04,0:07:42.12,Default,,0,0,0,,Аурухана қалай болды?
Dialogue: 0,0:07:42.21,0:07:43.75,Default,,0,0,0,,(Юки) Бірақ Хори, сен мықтысың ғой, иә? (Хидэ Иура) Һмм…
Dialogue: 0,0:07:43.83,0:07:44.67,Default,,0,0,0,,О
Dialogue: 0,0:07:44.75,0:07:47.17,Default,,0,0,0,,Балалар сендер шомылғыларың келе ме? (Суми) Иә
Dialogue: 0,0:07:47.25,0:07:48.88,Default,,0,0,0,,Олай болса жалғастырыңыз.
Dialogue: 0,0:07:48.96,0:07:50.84,Default,,0,0,0,,Аясе-сан туралы кейінірек.
Dialogue: 0,0:07:50.92,0:07:55.72,Default,,0,0,0,,Аа, профессор, қонақ үйдегілерге айтсаңыз, олар сізге тамақ береді.
Dialogue: 0,0:07:55.80,0:07:58.81,Default,,0,0,0,,Ал, мен сенен бір жақсылық сұрайын, рахмет.
Dialogue: 0,0:07:58.89,0:08:01.68,Default,,0,0,0,,Енді балалар, сендер де шомылыңдар.
Dialogue: 0,0:08:01.77,0:08:03.98,Default,,0,0,0,,Сенпай, кеттік.
Dialogue: 0,0:08:05.10,0:08:06.65,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:08:16.49,0:08:18.08,Default,,0,0,0,,Я...
Dialogue: 0,0:08:18.87,0:08:22.54,Default,,0,0,0,,(Тайчидің ұйқысы)
Dialogue: 0,0:08:22.62,0:08:24.83,Default,,0,0,0,,Ой, мен ұлдар бөлмесінде қателесіппін!
Dialogue: 0,0:08:24.92,0:08:26.79,Default,,0,0,0,,Хмм... у...
Dialogue: 0,0:08:26.88,0:08:30.55,Default,,0,0,0,,(Тайчидің ұйқысы)
Dialogue: 0,0:08:55.78,0:09:00.08,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:09:00.16,0:09:03.12,Default,,0,0,0,,Барлығын жеңіп, Жапонияда бірінші бол!
Dialogue: 0,0:09:04.08,0:09:05.62,Default,,0,0,0,,Мен оны пайдалана аламын...
Dialogue: 0,0:09:06.83,0:09:08.67,Default,,0,0,0,,Дереу бөліңіз...
Dialogue: 0,0:09:09.67,0:09:10.84,Default,,0,0,0,,Дыбыспен бір мезгілде?
Dialogue: 0,0:09:11.96,0:09:13.46,Default,,0,0,0,,Дыбысқа қарағанда жылдам...
Dialogue: 0,0:09:13.55,0:09:15.68,Default,,0,0,0,,Аваджишима~ (Чихая) Ах
Dialogue: 0,0:09:15.76,0:09:18.84,Default,,0,0,0,,1 дана 1 дана
Dialogue: 0,0:09:22.60,0:09:23.64,Default,,0,0,0,,Уф! (Нишида) Ах...
Dialogue: 0,0:09:23.72,0:09:26.77,Default,,0,0,0,,Жарайды, мен жеңдім! Акаши Даиичи әйелдер арасындағы 1 жеңіс!
Dialogue: 0,0:09:26.85,0:09:28.23,Default,,0,0,0,,Пизусава 1 жеңіс!
Dialogue: 0,0:09:28.31,0:09:31.07,Default,,0,0,0,,Оэ-сенпай жеңді! Керемет!
Dialogue: 0,0:09:31.15,0:09:32.02,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:32.11,0:09:33.48,Default,,0,0,0,,Мизусава 2 жеңді!
Dialogue: 0,0:09:49.63,0:09:51.29,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:09:53.13,0:09:57.30,Default,,0,0,0,,Қарсылас «Арима» және Комано «Нагеки» болатын тағдырлы шайқас.
Dialogue: 0,0:09:58.59,0:10:00.89,Default,,0,0,0,,Тағы 4 бос карта қалды
Dialogue: 0,0:10:00.97,0:10:03.64,Default,,0,0,0,,Маған көмектесетін нәрсе...
Dialogue: 0,0:10:04.47,0:10:06.39,Default,,0,0,0,,Аримаяяма~
Dialogue: 0,0:10:08.39,0:10:09.48,Default,,0,0,0,,Соқтығысайық!
Dialogue: 0,0:10:11.27,0:10:12.61,Default,,0,0,0,,Әй... (ойнау) Соны көрсеттім.
Dialogue: 0,0:10:12.69,0:10:14.57,Default,,0,0,0,,Чихая-чан емес екеніне қуаныштымын.
Dialogue: 0,0:10:14.65,0:10:15.69,Default,,0,0,0,,Кана-чан, сен не дедің...
Dialogue: 0,0:10:16.32,0:10:17.40,Default,,0,0,0,,Менің жолым болды
Dialogue: 0,0:10:18.03,0:10:20.28,Default,,0,0,0,,Жарақат алған Эйс Чихая емес.
Dialogue: 0,0:10:20.36,0:10:22.78,Default,,0,0,0,,Кейбір бірінші курс студенттері бастапқы құрамға кіреді.
Dialogue: 0,0:10:22.87,0:10:24.04,Default,,0,0,0,,Жағымды жел соғып тұр
Dialogue: 0,0:10:24.70,0:10:26.91,Default,,0,0,0,,Бұл Мизусава жеңетін сценарий.
Dialogue: 0,0:10:29.96,0:10:31.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:32.63,0:10:34.88,Default,,0,0,0,,О...моиваби~
Dialogue: 0,0:10:34.96,0:10:37.42,Default,,0,0,0,,Ал, өмір...
Dialogue: 0,0:10:37.51,0:10:39.97,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,0:10:40.55,0:10:45.51,Default,,0,0,0,,Жоқ. Бұл мүлдем басқа. Менде реакция... сезім...
Dialogue: 0,0:10:45.60,0:10:46.77,Default,,0,0,0,,Менің жүрегім... (Рион) Ах.
Dialogue: 0,0:10:48.60,0:10:49.64,Default,,0,0,0,,Мен саған рұқсат бермеймін!
Dialogue: 0,0:10:54.82,0:10:55.65,Default,,0,0,0,,Га
Dialogue: 0,0:10:56.48,0:10:58.90,Default,,0,0,0,,Мм (Тайчи) Аа... Аа.
Dialogue: 0,0:11:01.49,0:11:02.74,Default,,0,0,0,,Чихая?
Dialogue: 0,0:11:03.62,0:11:04.53,Default,,0,0,0,,Жарақат?
Dialogue: 0,0:11:05.45,0:11:07.24,Default,,0,0,0,,Мен білгім келеді
Dialogue: 0,0:11:09.96,0:11:11.75,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:11:12.63,0:11:17.51,Default,,0,0,0,,Аясе: сенің қасында отырған менен жасырып тұрғаныңды білемін.
Dialogue: 0,0:11:17.59,0:11:18.76,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:18.84,0:11:20.09,Default,,0,0,0,,Ах
Dialogue: 0,0:11:20.17,0:11:21.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:21.68,0:11:23.01,Default,,0,0,0,,А...
Dialogue: 0,0:11:26.10,0:11:28.02,Default,,0,0,0,,(Макотоның тыныс алу дыбысы)
Dialogue: 0,0:11:28.10,0:11:29.10,Default,,0,0,0,,Рионы жеңіңіз!
Dialogue: 0,0:11:29.18,0:11:30.14,Default,,0,0,0,,Ах
Dialogue: 0,0:11:30.23,0:11:32.77,Default,,0,0,0,,Хаха...
Dialogue: 0,0:11:33.65,0:11:34.52,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:11:34.52,0:11:35.36,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:11:34.52,0:11:35.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:36.36,0:11:37.36,Default,,0,0,0,,Цукуба-кун?
Dialogue: 0,0:11:39.99,0:11:41.11,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:11:41.20,0:11:43.36,Default,,0,0,0,,Рахмет... Сізге көп рахмет
Dialogue: 0,0:11:43.45,0:11:44.82,Default,,0,0,0,,Фудзисаки 2 жеңді!
Dialogue: 0,0:11:44.91,0:11:48.20,Default,,0,0,0,,Мизусава… (Комано) 0 жеңіс, 2 жеңіліс
Dialogue: 0,0:11:48.29,0:11:50.45,Default,,0,0,0,,Ол Фудзисакиде орналасқан.
Dialogue: 0,0:11:51.29,0:11:55.79,Default,,0,0,0,,Фудзисакидің 5-ші қатарынан жеңісі әлі де мықты.
Dialogue: 0,0:11:56.42,0:11:57.29,Default,,0,0,0,,3 жеңіс
Dialogue: 0,0:11:57.38,0:11:58.80,Default,,0,0,0,,Ха (Нишида) А?
Dialogue: 0,0:11:59.92,0:12:01.84,Default,,0,0,0,,Барлығымыз 3 жеңеміз.
Dialogue: 0,0:12:02.38,0:12:05.09,Default,,0,0,0,,Хаха...
Dialogue: 0,0:12:05.18,0:12:06.47,Default,,0,0,0,,(жүрек соғысы)
Dialogue: 0,0:12:21.69,0:12:23.36,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:12:27.20,0:12:29.33,Default,,0,0,0,,Ақыры тағдырлы шайқас
Dialogue: 0,0:12:29.41,0:12:31.62,Default,,0,0,0,,Сонымен қатар, бір уақытта екі топ
Dialogue: 0,0:12:33.46,0:12:34.79,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:35.46,0:12:39.17,Default,,0,0,0,,Өмір бойы тағдырлы шайқаста өз жағыңмен күресудің қажеті жоқ.
Dialogue: 0,0:12:40.84,0:12:41.67,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:12:43.38,0:12:46.68,Default,,0,0,0,,Бүгін... дәл бүгін...
Dialogue: 0,0:12:50.93,0:12:51.93,Default,,0,0,0,,Әзірше...
Dialogue: 0,0:12:53.27,0:12:55.77,Default,,0,0,0,,Юраното~
Dialogue: 0,0:13:02.53,0:13:03.74,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:13:03.82,0:13:06.74,Default,,0,0,0,,Сіз...
Dialogue: 0,0:13:06.82,0:13:09.99,Default,,0,0,0,,Татами іздері…
Dialogue: 0,0:13:10.08,0:13:15.08,Default,,0,0,0,,(Барлығы жылайды және күледі)
Dialogue: 0,0:13:18.79,0:13:20.13,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:22.96,0:13:24.26,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:25.76,0:13:27.26,Default,,0,0,0,,Мен бір нәрсені түсінбеймін.
Dialogue: 0,0:13:27.34,0:13:29.14,Default,,0,0,0,,Сізге қатысуға тыйым салынды ма?
Dialogue: 0,0:13:30.72,0:13:33.02,Default,,0,0,0,,Бұл жай ғана сұқ саусақ емес пе еді?
Dialogue: 0,0:13:33.10,0:13:36.02,Default,,0,0,0,,Кеше неге айтпадың?
Dialogue: 0,0:13:36.64,0:13:39.48,Default,,0,0,0,,Таңертең жақсы болады деп сенемін...
Dialogue: 0,0:13:39.56,0:13:40.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:40.73,0:13:42.44,Default,,0,0,0,,Бұл мүмкін емес, сәйкестік.
Dialogue: 0,0:13:42.53,0:13:43.57,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:13:43.65,0:13:45.69,Default,,0,0,0,,Сағынуым керек, Аясе-сенпай.
Dialogue: 0,0:13:45.78,0:13:48.16,Default,,0,0,0,,Мені қағып алсаң, одан бетер ауырады.
Dialogue: 0,0:13:48.86,0:13:49.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:50.70,0:13:51.66,Default,,0,0,0,,Аясе мырза
Dialogue: 0,0:13:52.79,0:13:55.29,Default,,0,0,0,,Сенің сезіміңді түсінемін, бірақ...
Dialogue: 0,0:13:56.41,0:13:58.67,Default,,0,0,0,,Командалық сайыста жеңіске жеттік.
Dialogue: 0,0:13:58.75,0:14:01.29,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін жасадыңыз.
Dialogue: 0,0:14:01.38,0:14:02.29,Default,,0,0,0,,Демалайық
Dialogue: 0,0:14:09.84,0:14:10.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:11.93,0:14:13.68,Default,,0,0,0,,Иә? Әпке
Dialogue: 0,0:14:16.02,0:14:17.35,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:17.43,0:14:19.69,Default,,0,0,0,,А... А?
Dialogue: 0,0:14:19.77,0:14:22.40,Default,,0,0,0,,Қазірдің өзінде... не?
Dialogue: 0,0:14:25.19,0:14:26.69,Default,,0,0,0,,Ах
Dialogue: 0,0:14:29.11,0:14:30.74,Default,,0,0,0,,Сонымен... Мен сыртқа шыққым келеді.
Dialogue: 0,0:14:30.82,0:14:32.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:32.95,0:14:35.91,Default,,0,0,0,,Мен мұны кигім келеді
Dialogue: 0,0:14:36.00,0:14:37.83,Default,,0,0,0,,Өте танымал (Чихая) Иә?
Dialogue: 0,0:14:38.58,0:14:40.54,Default,,0,0,0,,Кеше жарақат алдыңыз ба?
Dialogue: 0,0:14:40.62,0:14:43.42,Default,,0,0,0,,Жабайы аңдардың жараланғанда да баяу жүретіні жақсы.
Dialogue: 0,0:14:43.50,0:14:44.46,Default,,0,0,0,,Uppuppup…
Dialogue: 0,0:14:44.55,0:14:46.59,Default,,0,0,0,,Бірақ асығыс
Dialogue: 0,0:14:46.67,0:14:48.80,Default,,0,0,0,,Егер нәтиже сәл оғаш болса, сізге айтылады.
Dialogue: 0,0:14:49.97,0:14:54.81,Default,,0,0,0,,Командалық жарыс: Жеңіске жеткен мектептердің ойыншылары жеке жарыстарда жақсы өнер көрсетпейді.
Dialogue: 0,0:14:54.89,0:14:56.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:56.14,0:15:00.69,Default,,0,0,0,,Ухёхёххёк...
Dialogue: 0,0:15:01.31,0:15:04.11,Default,,0,0,0,,Мен ұмытқан жоқпын
Dialogue: 0,0:15:04.61,0:15:07.78,Default,,0,0,0,,Мақсат – жеке сайыста әр сыныпты жеңу.
Dialogue: 0,0:15:07.86,0:15:08.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:08.86,0:15:14.28,Default,,0,0,0,,Топтық сайыс Жеңімпаз мектеп ретінде біз бар күшімізді саламыз.
Dialogue: 0,0:15:17.75,0:15:18.79,Default,,0,0,0,,Мақсат...
Dialogue: 0,0:15:18.87,0:15:21.04,Default,,0,0,0,,Әр сынып бойынша жеке сайыс...
Dialogue: 0,0:15:21.12,0:15:23.17,Default,,0,0,0,,Біз де ше?
Dialogue: 0,0:15:26.50,0:15:27.71,Default,,0,0,0,,Жеңімпаз
Dialogue: 0,0:15:28.55,0:15:31.09,Default,,0,0,0,,Бүгін Фудзисакидің күшін көрсететін уақыт.
Dialogue: 0,0:15:31.18,0:15:32.59,Default,,0,0,0,,Жоғарғы қатарларды толтырыңыз
Dialogue: 0,0:15:32.68,0:15:33.93,Default,,0,0,0,,Иә (Рион) Иә!
Dialogue: 0,0:15:34.01,0:15:34.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:40.89,0:15:42.94,Default,,0,0,0,,Егер ұтылып қалсаңыз, оны Бива көліне тастаңыз
Dialogue: 0,0:15:43.02,0:15:45.31,Default,,0,0,0,,Ұнамаса ұтыңыз! (Хироши және басқалар) О!
Dialogue: 0,0:15:47.07,0:15:49.23,Default,,0,0,0,,Қорлау Мен үйге қайтамын, бәрің!
Dialogue: 0,0:15:49.32,0:15:50.49,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:51.90,0:15:53.16,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:53.24,0:15:57.37,Default,,0,0,0,,Командалық жарыста орта мектептің жаңадан шыққан чемпиондары да қызықты болды.
Dialogue: 0,0:15:57.45,0:16:01.37,Default,,0,0,0,,Бүкіл карута әлемі қалыңдай түсетін сияқты, Төраға.
Dialogue: 0,0:16:01.46,0:16:03.58,Default,,0,0,0,,Жоқ, командалық жарыстар
Dialogue: 0,0:16:03.67,0:16:06.75,Default,,0,0,0,,Мұны өз күшіңізге қалдырыңыз және есепшоттар үшін күресіңіз.
Dialogue: 0,0:16:06.84,0:16:09.25,Default,,0,0,0,,Көптеген жас және немқұрайлы сіріңкелер.
Dialogue: 0,0:16:09.34,0:16:10.71,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:16:10.80,0:16:12.51,Default,,0,0,0,,Бірақ жеке жарыстарда
Dialogue: 0,0:16:12.59,0:16:17.26,Default,,0,0,0,,Шеберлік тактикасы бар ойынды күтуге болады деп ойлаймын.
Dialogue: 0,0:16:19.10,0:16:20.14,Default,,0,0,0,,Уф
Dialogue: 0,0:16:20.22,0:16:22.02,Default,,0,0,0,,Уф... (Нишида) А...
Dialogue: 0,0:16:22.85,0:16:26.73,Default,,0,0,0,,Саған тисе, ауырады, солай ма? Ойынды қалай ойнаймыз?
Dialogue: 0,0:16:29.90,0:16:30.73,Default,,0,0,0,,Ах
Dialogue: 0,0:16:36.03,0:16:38.66,Default,,0,0,0,,H... Сол қолыңмен (Нишида) А?
Dialogue: 0,0:16:39.45,0:16:42.25,Default,,0,0,0,,Оны мүмкіндігінше сол қолыңызбен алыңыз
Dialogue: 0,0:16:42.33,0:16:43.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:45.17,0:16:47.58,Default,,0,0,0,,Барлығы жеңіске жетуді мақсат етеді
Dialogue: 0,0:16:48.13,0:16:51.63,Default,,0,0,0,,Жеке шайқас басталады.
Dialogue: 0,0:17:00.68,0:17:01.85,Default,,0,0,0,,Уф
Dialogue: 0,0:17:01.93,0:17:02.77,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:03.39,0:17:04.64,Default,,0,0,0,,Уф! (Нишида) Ах...
Dialogue: 0,0:17:06.73,0:17:08.02,Default,,0,0,0,,Мүмкін емес Мүмкін емес Мүмкін емес
Dialogue: 0,0:17:08.11,0:17:10.61,Default,,0,0,0,,Оң қолыңмен сынасаң да, ұшып кетесің. Сіз жай ғана шабуыл жасауға тырысасыз.
Dialogue: 0,0:17:10.69,0:17:12.32,Default,,0,0,0,,Сол қолыңызбен не істеп жатырсыз?
Dialogue: 0,0:17:12.40,0:17:14.40,Default,,0,0,0,,Бірақ, бірақ, бірақ...
Dialogue: 0,0:17:14.49,0:17:16.95,Default,,0,0,0,,Не, сол ханшайымды кіргізейік?
Dialogue: 0,0:17:17.03,0:17:18.53,Default,,0,0,0,,Бірінші айналым көп уақытты алады.
Dialogue: 0,0:17:18.62,0:17:21.62,Default,,0,0,0,,Бізге тұқым жақсы.
Dialogue: 0,0:17:21.70,0:17:23.29,Default,,0,0,0,,Менің айтайын дегенім, сен неге арықсың?
Dialogue: 0,0:17:23.95,0:17:27.42,Default,,0,0,0,,Қар Мару Дайфуку сатылымға шықпағандықтан емес пе?
Dialogue: 0,0:17:27.50,0:17:28.54,Default,,0,0,0,,Бұл өкінішті.
Dialogue: 0,0:17:29.88,0:17:30.88,Default,,0,0,0,,Ах
Dialogue: 0,0:17:32.59,0:17:33.67,Default,,0,0,0,,Чи…
Dialogue: 0,0:17:33.76,0:17:34.97,Default,,0,0,0,,Жаңа
Dialogue: 0,0:17:35.05,0:17:37.09,Default,,0,0,0,,Мен өз өмірімді сақтап қалдым.
Dialogue: 0,0:17:37.18,0:17:40.43,Default,,0,0,0,,Бірінші раундта Аратаны тағы да жеңгеніме өте қуаныштымын.
Dialogue: 0,0:17:41.39,0:17:45.81,Default,,0,0,0,,Мен соңғы бірнеше жылда өскен қабілетімдегі айырмашылықты көрсете алатын бірдеңе жасадым.
Dialogue: 0,0:17:45.89,0:17:47.81,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:48.69,0:17:49.86,Default,,0,0,0,,Менің тамырларым жарылып кетеді?
Dialogue: 0,0:17:54.82,0:17:57.11,Default,,0,0,0,,Тек жаңа
Dialogue: 0,0:17:58.28,0:17:59.57,Default,,0,0,0,,Барлығы
Dialogue: 0,0:18:00.82,0:18:04.33,Default,,0,0,0,,Бұл командалық жарыс тек көңіл көтеру үшін болғанын айтуыма себеп болды.
Dialogue: 0,0:18:05.87,0:18:08.21,Default,,0,0,0,,Мен олардың бәрін талқандаймын
Dialogue: 0,0:18:08.83,0:18:10.46,Default,,0,0,0,,Ақсақ патшайым.
Dialogue: 0,0:18:10.54,0:18:12.67,Default,,0,0,0,,Мойыныңызға салқын орамал тағып жүрсіз бе?
Dialogue: 0,0:18:12.75,0:18:14.46,Default,,0,0,0,,Ах Чихая
Dialogue: 0,0:18:14.55,0:18:17.59,Default,,0,0,0,,А-а-а... (Офицер) Барлық спортшылар, жарыс өтетін жерге баруларыңызды өтінемін.
Dialogue: 0,0:18:17.67,0:18:21.85,Default,,0,0,0,,1-тур басталады. А сыныбы 2-қабатта өтеді
Dialogue: 0,0:18:21.93,0:18:25.18,Default,,0,0,0,,Спортшылар жарыс өтетін жерге дереу кіруі керек.
Dialogue: 0,0:18:28.56,0:18:30.06,Default,,0,0,0,,Чихая, барасың ба?
Dialogue: 0,0:18:30.15,0:18:32.06,Default,,0,0,0,,А... кеттік.
Dialogue: 0,0:18:34.36,0:18:35.53,Default,,0,0,0,,Жаңа
Dialogue: 0,0:18:37.15,0:18:38.20,Default,,0,0,0,,Жаңа осында
Dialogue: 0,0:18:42.20,0:18:45.79,Default,,0,0,0,,Сол татамидегі жаңа
Dialogue: 0,0:18:50.12,0:18:51.38,Default,,0,0,0,,(Хиросидің сілекей жұтып жатқан дыбысы)
Dialogue: 0,0:18:51.46,0:18:53.63,Default,,0,0,0,,Бүгін – күн... Бүгін – күн
Dialogue: 0,0:18:53.71,0:18:56.26,Default,,0,0,0,,Бүгін - жеңетін және жеңетін күн
Dialogue: 0,0:18:56.34,0:18:58.51,Default,,0,0,0,,Hyoro аңыз!
Dialogue: 0,0:18:58.59,0:19:01.34,Default,,0,0,0,,Иә? Не... не болды? Маджима
Dialogue: 0,0:19:01.43,0:19:03.26,Default,,0,0,0,,Бүгін біздің басты ұрыс алаңымыз...
Dialogue: 0,0:19:03.35,0:19:04.35,Default,,0,0,0,,Хёро
Dialogue: 0,0:19:05.14,0:19:06.77,Default,,0,0,0,,Мен неге мұндамын?
Dialogue: 0,0:19:06.85,0:19:08.31,Default,,0,0,0,,Хмм?
Dialogue: 0,0:19:08.39,0:19:11.90,Default,,0,0,0,,Сонымен... Командалық жарыстардан шаршау ма?
Dialogue: 0,0:19:11.98,0:19:15.36,Default,,0,0,0,,Бұл олай емес сияқты! Бұлай емес сияқты...
Dialogue: 0,0:19:15.44,0:19:17.90,Default,,0,0,0,,Ең үлкен қарсылас Машима ойыннан шығып қалды!
Dialogue: 0,0:19:17.99,0:19:19.74,Default,,0,0,0,,Мен жеңімпазмын
Dialogue: 0,0:19:19.82,0:19:23.66,Default,,0,0,0,,Ухёхёхёхйййййййййййййййййй...
Dialogue: 0,0:19:26.08,0:19:29.87,Default,,0,0,0,,Ха ха ха фу...
Dialogue: 0,0:19:29.96,0:19:32.79,Default,,0,0,0,,Бірінші курстың D-сыныптың екі студенті бөлек жерде өтеді.
Dialogue: 0,0:19:32.88,0:19:35.50,Default,,0,0,0,,С сынып оқушылары Комано-кун мен Оэ-сан ғибадатхана кеңсесінде.
Dialogue: 0,0:19:35.59,0:19:39.21,Default,,0,0,0,,Машима-кун 1-қабатта өзінің бірінші В класындағы шайқасын өткізеді.
Dialogue: 0,0:19:40.51,0:19:43.59,Default,,0,0,0,,Екінші қабатта А сынып оқушылары Нишида-кун мен Аясе-сан.
Dialogue: 0,0:19:45.01,0:19:49.35,Default,,0,0,0,,Республикалық турнирден күткендей ата-аналар да құлшыныспен қолдау көрсетті.
Dialogue: 0,0:19:57.57,0:19:58.69,Default,,0,0,0,,Аясе мырза
Dialogue: 0,0:20:08.79,0:20:09.95,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:20:12.54,0:20:16.42,Default,,0,0,0,,Енді А сыныбының жекелей турнирінің бірінші кезеңін бастайық.
Dialogue: 0,0:20:16.50,0:20:18.42,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:20:18.50,0:20:20.34,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:20:21.67,0:20:23.34,Default,,0,0,0,,Нанивадуни~
Dialogue: 0,0:20:23.43,0:20:29.35,Default,,0,0,0,,Сакуяко но Хана~Фуюгомоори~
Dialogue: 0,0:20:32.18,0:20:34.35,Default,,0,0,0,,Енді ~Харубето~
Dialogue: 0,0:20:34.35,0:20:34.60,Default,,0,0,0,,Енді ~Харубето~
Dialogue: 0,0:20:34.35,0:20:34.60,Default,,0,0,0,,Өзіңді масқараласаң не, күлсе не болады?—
Dialogue: 0,0:20:34.60,0:20:34.69,Default,,0,0,0,,Өзіңді масқараласаң не, күлсе не болады?—
Dialogue: 0,0:20:34.69,0:20:35.48,Default,,0,0,0,,Өзіңді масқараласаң не, күлсе не болады?—
Dialogue: 0,0:20:34.69,0:20:35.48,Default,,0,0,0,,Сакуя Коно Хана
Dialogue: 0,0:20:35.48,0:20:40.98,Default,,0,0,0,,Сакуя Коно Хана
Dialogue: 0,0:20:42.57,0:20:45.86,Default,,0,0,0,,Енді ~Харубето~
Dialogue: 0,0:20:45.95,0:20:50.74,Default,,0,0,0,,Сакуя Коно Хана
Dialogue: 0,0:20:52.04,0:20:53.16,Default,,0,0,0,,Фукукарани~ (Юбе) Жарайды!
Dialogue: 0,0:20:56.58,0:20:57.46,Default,,0,0,0,,Мен жеңілмеймін
Dialogue: 0,0:20:58.54,0:21:00.21,Default,,0,0,0,,Мен Эмуге тигенше
Dialogue: 0,0:21:07.30,0:21:08.51,Default,,0,0,0,,Авадишима~ (Юбе) Уф
Dialogue: 0,0:21:12.72,0:21:14.02,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:21:15.23,0:21:16.60,Default,,0,0,0,,Мен естіп тұрсам да...
Dialogue: 0,0:21:18.23,0:21:23.69,Default,,0,0,0,,Дыбысты естісем де, денем... сол қолым...
Dialogue: 0,0:21:25.95,0:21:30.95,Default,,0,0,0,,♪~
Dialogue: 0,0:22:45.94,0:22:50.95,Default,,0,0,0,,~♪
Dialogue: 0,0:22:52.45,0:22:58.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory