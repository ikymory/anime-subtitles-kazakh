Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:06.29,Default,,0,0,0,,(Күлгіннің ауыр тыныс алуы)
Dialogue: 0,0:00:06.88,0:00:11.09,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:16.51,0:00:17.72,Default,,0,0,0,,Машима Сенпай
Dialogue: 0,0:00:21.52,0:00:23.73,Default,,0,0,0,,Не? бұл атмосфера
Dialogue: 0,0:00:29.19,0:00:32.03,Default,,0,0,0,,Мен жеңілмеймін... Жоғалмаймын...
Dialogue: 0,0:00:32.86,0:00:35.03,Default,,0,0,0,,Біз жеңеміз... Біз жеңеміз...
Dialogue: 0,0:00:36.57,0:00:37.53,Default,,0,0,0,,Маджиманы жеңу
Dialogue: 0,0:00:40.04,0:00:41.58,Default,,0,0,0,,А баға!
Dialogue: 0,0:00:44.04,0:00:48.59,Default,,0,0,0,,♪~
Dialogue: 0,0:01:48.94,0:01:53.94,Default,,0,0,0,,~♪
Dialogue: 0,0:02:02.87,0:02:04.49,Default,,0,0,0,,Хитомоши~
Dialogue: 0,0:02:06.70,0:02:09.58,Default,,0,0,0,,Мен... Мен өз қарқыныммен жүре алмаймын.
Dialogue: 0,0:02:10.17,0:02:13.55,Default,,0,0,0,,Эмуро-сенпай... (Хаяшида) Екінші жағынан...
Dialogue: 0,0:02:16.17,0:02:18.63,Default,,0,0,0,,Оэяма~
Dialogue: 0,0:02:20.59,0:02:23.14,Default,,0,0,0,,Бұл екі тұлға әр түрлі.
Dialogue: 0,0:02:23.85,0:02:25.77,Default,,0,0,0,,Тегті жылжыту
Dialogue: 0,0:02:27.77,0:02:28.77,Default,,0,0,0,,Хмм
Dialogue: 0,0:02:29.56,0:02:32.86,Default,,0,0,0,,Вексель қозғалса да оны ала алатыныңызға сенімділік
Dialogue: 0,0:02:32.94,0:02:35.90,Default,,0,0,0,,Карталарыңызды күшті қарсыластарға қарсы агрессивті түрде жылжытыңыз
Dialogue: 0,0:02:35.98,0:02:37.78,Default,,0,0,0,,Эмуроның оны ыңғайлы қабылдауына жол бермеңіз
Dialogue: 0,0:02:38.49,0:02:40.66,Default,,0,0,0,,Және қиын уақытта
Dialogue: 0,0:02:41.28,0:02:43.20,Default,,0,0,0,,Патшайым ше?
Dialogue: 0,0:02:43.28,0:02:45.70,Default,,0,0,0,,«Ол да шабыт па?» жылдамдығы.
Dialogue: 0,0:02:46.54,0:02:47.70,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:47.79,0:02:51.21,Default,,0,0,0,,Шинобу Вакамия вексельдермен бірегей ережелермен байланысты.
Dialogue: 0,0:02:53.17,0:02:54.21,Default,,0,0,0,,Қандай ережелер бар?
Dialogue: 0,0:02:56.96,0:02:59.51,Default,,0,0,0,,Хаяшида-сан, жазба жақсы жұмыс істейді, солай ма?
Dialogue: 0,0:02:59.59,0:03:01.22,Default,,0,0,0,,А... иә
Dialogue: 0,0:03:01.30,0:03:03.60,Default,,0,0,0,,Мачимура-кун, мен саған соңына дейін бар жақсылықты тілеймін.
Dialogue: 0,0:03:03.68,0:03:04.72,Default,,0,0,0,,Иә
Dialogue: 0,0:03:11.44,0:03:12.60,Default,,0,0,0,,Ах
Dialogue: 0,0:03:12.69,0:03:16.69,Default,,0,0,0,,Сакуразава мырза, А сыныбы аяқталады деп ойлайсыз ба?
Dialogue: 0,0:03:16.77,0:03:21.65,Default,,0,0,0,,Біздің капитан Фукуи Нагумо-кайдың Ватая-кунынан жеңілетін сияқты.
Dialogue: 0,0:03:21.74,0:03:24.49,Default,,0,0,0,,Оқыту бойынша бірнеше кеңестер білгім келеді.
Dialogue: 0,0:03:24.57,0:03:26.58,Default,,0,0,0,,Тағы да~
Dialogue: 0,0:03:26.66,0:03:29.66,Default,,0,0,0,,Мидори-чан да үздік бәсекелес болды.
Dialogue: 0,0:03:29.75,0:03:32.17,Default,,0,0,0,,Ол сонымен қатар жоғары санатты нұсқаушы.
Dialogue: 0,0:03:32.25,0:03:35.63,Default,,0,0,0,,Осы турнирде басқа атақты ойыншылар болды ма?
Dialogue: 0,0:03:36.84,0:03:38.38,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:03:42.55,0:03:44.89,Default,,0,0,0,,(Чихаяның қорылдауы)
Dialogue: 0,0:03:44.97,0:03:46.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:46.35,0:03:49.89,Default,,0,0,0,,(Чихаяның қорылдауы)
Dialogue: 0,0:03:51.14,0:03:53.73,Default,,0,0,0,,Ей, сен мұндай жерде ұйықтамайсың!
Dialogue: 0,0:03:53.81,0:03:55.77,Default,,0,0,0,,Ах! Не, аа...
Dialogue: 0,0:03:56.40,0:03:58.27,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:03:58.36,0:03:59.53,Default,,0,0,0,,Ах
Dialogue: 0,0:04:00.44,0:04:04.53,Default,,0,0,0,,Бұл жарақат Рион Ямашироға тиген кезде болды.
Dialogue: 0,0:04:04.61,0:04:07.74,Default,,0,0,0,,Амансың ба? Мен Ямаширомен кешірім сұрау үшін кейінірек қайтамын.
Dialogue: 0,0:04:07.83,0:04:10.75,Default,,0,0,0,,А, жоқ... Жоқ, Яма-чан...
Dialogue: 0,0:04:11.45,0:04:12.37,Default,,0,0,0,,Яма-чан?
Dialogue: 0,0:04:12.46,0:04:14.75,Default,,0,0,0,,Бұл туралы Яма-чанға айтпа.
Dialogue: 0,0:04:15.42,0:04:19.38,Default,,0,0,0,,Көбінесе жарақат алған адамның дұрыс әрекет етпеуінен болатыны айтылады.
Dialogue: 0,0:04:19.46,0:04:23.26,Default,,0,0,0,,Мұғалім көбірек жаттығамын деді.
Dialogue: 0,0:04:25.68,0:04:26.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:27.10,0:04:29.01,Default,,0,0,0,,Не? Күн батып кетті ме?
Dialogue: 0,0:04:30.06,0:04:31.52,Default,,0,0,0,,Қалғандары ше?
Dialogue: 0,0:04:31.60,0:04:32.52,Default,,0,0,0,,Ах
Dialogue: 0,0:04:38.48,0:04:41.23,Default,,0,0,0,,Ватая жеңді, 12 дана айырмашылығы (Курияма) Иә.
Dialogue: 0,0:04:41.32,0:04:44.07,Default,,0,0,0,,Вакамия 14 ұпай айырмашылығы (Курияма) Иә.
Dialogue: 0,0:04:46.66,0:04:49.95,Default,,0,0,0,,Өйткені, А сыныбының финалына арналған карта
Dialogue: 0,0:04:50.03,0:04:53.04,Default,,0,0,0,,Арата Ватая Шинобу Вакамияға қарсы
Dialogue: 0,0:04:53.12,0:04:58.21,Default,,0,0,0,,Өйткені, Арата екеуміз ғана қалдық.
Dialogue: 0,0:04:58.29,0:05:01.75,Default,,0,0,0,,Командалық жарыста барлығы шаршаған болуы керек.
Dialogue: 0,0:05:01.84,0:05:04.13,Default,,0,0,0,,Маған көп рет жеңіске жетуге рұқсат етіңіз
Dialogue: 0,0:05:04.22,0:05:06.93,Default,,0,0,0,,Хонма, бұл жақсы нәрсе.
Dialogue: 0,0:05:08.18,0:05:13.06,Default,,0,0,0,,Мен тағы бір нәрсені алғым келеді.
Dialogue: 0,0:05:13.14,0:05:14.85,Default,,0,0,0,,Ахаха
Dialogue: 0,0:05:14.93,0:05:16.02,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:16.10,0:05:17.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:18.10,0:05:18.35,Default,,0,0,0,,Не... неге? Жаңа Неліктен?
Dialogue: 0,0:05:18.35,0:05:19.48,Default,,0,0,0,,Не... неге? Жаңа Неліктен?
Dialogue: 0,0:05:18.35,0:05:19.48,Default,,0,0,0,,10 минуттан кейін?
Dialogue: 0,0:05:19.48,0:05:19.56,Default,,0,0,0,,Не... неге? Жаңа Неліктен?
Dialogue: 0,0:05:19.56,0:05:21.52,Default,,0,0,0,,Не... неге? Жаңа Неліктен?
Dialogue: 0,0:05:19.56,0:05:21.52,Default,,0,0,0,,О, күте тұрыңыз, басқа сынып ...
Dialogue: 0,0:05:22.32,0:05:26.28,Default,,0,0,0,,Патшайымға қараған кезде бұл бетті қалай жасауға болады? Неге...
Dialogue: 0,0:05:28.07,0:05:31.58,Default,,0,0,0,,Мен Арата мен Шинобу-чан арасындағы финалдық матчты көргім келеді!
Dialogue: 0,0:05:31.66,0:05:33.75,Default,,0,0,0,,Жарайды... Мен алдыңғы жақтан жақсы орын алуым керек.
Dialogue: 0,0:05:33.83,0:05:35.62,Default,,0,0,0,,Әй, Аясе! (Чихая) Ах
Dialogue: 0,0:05:35.71,0:05:36.54,Default,,0,0,0,,Чихая-чан
Dialogue: 0,0:05:37.17,0:05:38.62,Default,,0,0,0,,Барлығының ойыны қалай өтті?
Dialogue: 0,0:05:38.71,0:05:40.67,Default,,0,0,0,,Электрондық поштаңызды көрмедіңіз бе?
Dialogue: 0,0:05:40.75,0:05:43.46,Default,,0,0,0,,С класындағы жартылай финалда жеңілдім.
Dialogue: 0,0:05:43.55,0:05:44.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:44.46,0:05:47.38,Default,,0,0,0,,Бірақ Кей-кун С класының финалында болды.
Dialogue: 0,0:05:47.47,0:05:49.72,Default,,0,0,0,,Уау, бұл керемет! (ойнау) Сонымен...
Dialogue: 0,0:05:49.80,0:05:52.76,Default,,0,0,0,,Директор Машима да В сыныбының финалында.
Dialogue: 0,0:05:52.85,0:05:55.35,Default,,0,0,0,,Бірінші қабатта барлығын бірге жасаймыз. Барайық.
Dialogue: 0,0:05:55.43,0:05:56.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:58.52,0:06:01.86,Default,,0,0,0,,Бол... әр жерде...
Dialogue: 0,0:06:04.40,0:06:05.23,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:06.15,0:06:07.57,Default,,0,0,0,,Иә? Мүмкін-
Dialogue: 0,0:06:08.32,0:06:11.78,Default,,0,0,0,,А сыныбының финалы Арата Ватая мен Королева болады.
Dialogue: 0,0:06:11.87,0:06:13.33,Default,,0,0,0,,Уау, рас па?
Dialogue: 0,0:06:14.41,0:06:16.83,Default,,0,0,0,,Ах... хмм
Dialogue: 0,0:06:17.62,0:06:20.63,Default,,0,0,0,,Кешіріңіз, бірақ мен А сыныбының финалын көремін.
Dialogue: 0,0:06:20.71,0:06:22.63,Default,,0,0,0,,Иә!? (Нишида) Аясе де қарап тұрады, солай ма?
Dialogue: 0,0:06:22.71,0:06:25.71,Default,,0,0,0,,Бұл өте суық, Никуман-кун.
Dialogue: 0,0:06:25.80,0:06:27.59,Default,,0,0,0,,Менеджердің маңызды сәйкестігі
Dialogue: 0,0:06:27.67,0:06:28.97,Default,,0,0,0,,Өйткені ол жеңеді.
Dialogue: 0,0:06:29.05,0:06:31.55,Default,,0,0,0,,Қолдау болмаса да, мен міндетті түрде жеңемін!
Dialogue: 0,0:06:31.64,0:06:32.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:33.68,0:06:37.85,Default,,0,0,0,,Кику-кунды былай қойғанда, бүгінгі Маджима мүлде басқа.
Dialogue: 0,0:06:37.93,0:06:39.85,Default,,0,0,0,,Маған қолдау қажет емес
Dialogue: 0,0:06:40.52,0:06:41.98,Default,,0,0,0,,Бәрінен бұрын Аясеге
Dialogue: 0,0:06:42.06,0:06:45.36,Default,,0,0,0,,Ол маған «ханшайым шайқасы туралы ойланыңыз және жаттығыңыз» деп айтатын адам болды.
Dialogue: 0,0:06:46.32,0:06:48.36,Default,,0,0,0,,Мен саған келме деп айтамын.
Dialogue: 0,0:06:51.49,0:06:53.57,Default,,0,0,0,,Барлығы сол жерде сапқа тұрады
Dialogue: 0,0:06:53.66,0:06:57.08,Default,,0,0,0,,Солтүстік Орталықтың ойыншысы тек 8-дікке кіреді деген нені білдіреді?
Dialogue: 0,0:06:57.16,0:07:00.92,Default,,0,0,0,,Әрқайсысына 100 рет декопин жасаңыз хаха
Dialogue: 0,0:07:01.54,0:07:04.96,Default,,0,0,0,,Судо мырза, Хёро жақсы ма?
Dialogue: 0,0:07:05.55,0:07:08.26,Default,,0,0,0,,Оу... бұл жігіт жақсы.
Dialogue: 0,0:07:09.22,0:07:12.26,Default,,0,0,0,,Егер сіздің қарсыласыңыз деп ойлайтын адам сізге 18 тиын ұсынса.
Dialogue: 0,0:07:12.34,0:07:13.85,Default,,0,0,0,,Декопин қажет емес
Dialogue: 0,0:07:14.93,0:07:16.51,Default,,0,0,0,,Машима…
Dialogue: 0,0:07:17.10,0:07:20.85,Default,,0,0,0,,Мен оны бірінші рет көрдім. Бұл мүлдем басқаша болды
Dialogue: 0,0:07:20.94,0:07:23.23,Default,,0,0,0,,Маджима уайымдамайды...
Dialogue: 0,0:07:24.36,0:07:26.40,Default,,0,0,0,,Барлық ойыншылар қол жетімді ме?
Dialogue: 0,0:07:26.48,0:07:30.03,Default,,0,0,0,,Әр сыныптың финалы 5:20-да басталады.
Dialogue: 0,0:07:30.11,0:07:31.40,Default,,0,0,0,,Машима Сенпай
Dialogue: 0,0:07:32.36,0:07:34.95,Default,,0,0,0,,Өтінемін, қазір су ішіңіз.
Dialogue: 0,0:07:35.03,0:07:36.62,Default,,0,0,0,,Комано-сенпай да
Dialogue: 0,0:07:36.70,0:07:39.87,Default,,0,0,0,,Бірақ кеш болды, солай емес пе? Аясе-сенпай және т.б
Dialogue: 0,0:07:39.95,0:07:42.29,Default,,0,0,0,,Бастау уақыты жақындап қалды.
Dialogue: 0,0:07:42.37,0:07:44.75,Default,,0,0,0,,Тағы бір жерде ұйықтап жатыр ма деп ойлаймын.
Dialogue: 0,0:07:44.83,0:07:47.42,Default,,0,0,0,,Сіз Ватая мырзаның орнына бардым, келмеймін дедіңіз бе?
Dialogue: 0,0:07:47.50,0:07:49.34,Default,,0,0,0,,Ол келмейді (ойнады) Иә?
Dialogue: 0,0:07:50.76,0:07:54.47,Default,,0,0,0,,Мүмкін А сыныбының финалы Арата мен Королева арасында өтуі мүмкін.
Dialogue: 0,0:07:54.55,0:07:56.35,Default,,0,0,0,,Мұнда келме
Dialogue: 0,0:07:57.39,0:08:00.85,Default,,0,0,0,,Сонымен... Бірақ финалдағы қарсылас...
Dialogue: 0,0:08:03.77,0:08:07.61,Default,,0,0,0,,Тоқтай тұрыңыз, сіз Ямаширо мырзаға неге құмарсыз?
Dialogue: 0,0:08:07.69,0:08:09.90,Default,,0,0,0,,Сіз қатты толқуға болмайды, солай ма?
Dialogue: 0,0:08:09.98,0:08:13.07,Default,,0,0,0,,Командалық матчта да сол қыздың кесірінен жеңіліп қалдық.
Dialogue: 0,0:08:13.15,0:08:15.45,Default,,0,0,0,,''Мен міндетті түрде жеңемін'' сияқты сөз айтыңыз.
Dialogue: 0,0:08:15.53,0:08:18.33,Default,,0,0,0,,Сіз Рионды жек көресіз.
Dialogue: 0,0:08:18.41,0:08:20.20,Default,,0,0,0,,Себебі сен мені қорлайсың
Dialogue: 0,0:08:20.29,0:08:23.37,Default,,0,0,0,,Бірақ оған көмектесу мүмкін емес, жеңетін ешкім қалмады.
Dialogue: 0,0:08:23.46,0:08:24.79,Default,,0,0,0,,Уф
Dialogue: 0,0:08:24.87,0:08:27.46,Default,,0,0,0,,Биылғы жыл өте нашар болды, солай емес пе?
Dialogue: 0,0:08:27.54,0:08:28.42,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:28.50,0:08:30.67,Default,,0,0,0,,Мм... (оқушылар) Иә?
Dialogue: 0,0:08:30.76,0:08:33.17,Default,,0,0,0,,Мм... мм...
Dialogue: 0,0:08:35.09,0:08:37.93,Default,,0,0,0,,Мен В сыныбының финалында бар күшімді саламын!
Dialogue: 0,0:08:38.01,0:08:41.43,Default,,0,0,0,,Қолдауыңыз үшін рахмет!
Dialogue: 0,0:08:43.02,0:08:44.69,Default,,0,0,0,,Пуфуфу…
Dialogue: 0,0:08:47.98,0:08:50.69,Default,,0,0,0,,Фудзисакидің карута клубын соншалықты қызықты ететін не?
Dialogue: 0,0:08:50.78,0:08:54.36,Default,,0,0,0,,Себебі, біз осы уақытқа дейін жыл сайын нәтиже шығаруды жалғастырдық.
Dialogue: 0,0:08:54.99,0:08:57.03,Default,,0,0,0,,Үшінші курс студенттері кеткенде...
Dialogue: 0,0:08:57.66,0:08:59.33,Default,,0,0,0,,Ри… Рион!?
Dialogue: 0,0:08:59.41,0:09:01.16,Default,,0,0,0,,А класындағы ойыншылардың саны да күрт азаяды.
Dialogue: 0,0:09:02.62,0:09:03.62,Default,,0,0,0,,Жеңіс
Dialogue: 0,0:09:03.70,0:09:08.13,Default,,0,0,0,,Келесі жылды ешқашан жеңілмейтін жазға айналдыратын адамсың
Dialogue: 0,0:09:08.96,0:09:12.88,Default,,0,0,0,,5 ойынды ұтып, нәтижеге қол жеткіз, чемпионатты жең.
Dialogue: 0,0:09:16.09,0:09:20.14,Default,,0,0,0,,Енді әр сынып үшін финалды бастайтын кез келді.
Dialogue: 0,0:09:20.22,0:09:22.64,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:09:27.94,0:09:28.77,Default,,0,0,0,,Ах
Dialogue: 0,0:09:35.03,0:09:36.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:36.90,0:09:40.07,Default,,0,0,0,,Неліктен? Финал болса да
Dialogue: 0,0:09:41.12,0:09:44.04,Default,,0,0,0,,Мен неге мұндамын?
Dialogue: 0,0:09:46.04,0:09:48.29,Default,,0,0,0,,Бір сыныптағы адамды қатарынан бес рет ұру
Dialogue: 0,0:09:50.13,0:09:52.04,Default,,0,0,0,,Неліктен осы уақытқа дейін орындалмады?
Dialogue: 0,0:09:52.92,0:09:56.38,Default,,0,0,0,,Финал болса да, тыныш тыныс алып жатырсың!?
Dialogue: 0,0:10:01.68,0:10:03.51,Default,,0,0,0,,Бір сәт кешіріңіз
Dialogue: 0,0:10:03.51,0:10:04.35,Default,,0,0,0,,Бір сәт кешіріңіз
Dialogue: 0,0:10:03.51,0:10:04.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:04.43,0:10:05.64,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:05.73,0:10:06.60,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:10:06.68,0:10:09.23,Default,,0,0,0,,Мен сонда кіре аламын ба? (ойнау) Кешіріңіз.
Dialogue: 0,0:10:09.98,0:10:11.06,Default,,0,0,0,,Не!
Dialogue: 0,0:10:13.15,0:10:16.07,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:16.94,0:10:20.66,Default,,0,0,0,,А сыныбының финалы сөзсіз Арата мен Королева болады.
Dialogue: 0,0:10:20.74,0:10:23.08,Default,,0,0,0,,Екеуіңіз де ең маңыздысысыздар...
Dialogue: 0,0:10:24.99,0:10:28.25,Default,,0,0,0,,Мен үшін қазір ең маңыздысы
Dialogue: 0,0:10:28.33,0:10:30.12,Default,,0,0,0,,Тайчи А класына айналады
Dialogue: 0,0:10:30.92,0:10:32.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:34.71,0:10:38.63,Default,,0,0,0,,Тч... Мен Чихая туралы ешқашан ештеңе түсінбедім...
Dialogue: 0,0:10:39.51,0:10:40.63,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:40.72,0:10:43.35,Default,,0,0,0,,А... А, мен дем ала алмаймын...
Dialogue: 0,0:10:43.43,0:10:44.68,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:44.76,0:10:46.85,Default,,0,0,0,,Әлгі жігіт сондай ақымақ.
Dialogue: 0,0:10:50.23,0:10:52.90,Default,,0,0,0,,Бір минут немесе секунд болса да, мүмкіндігінше тез жеңіңіз
Dialogue: 0,0:10:52.98,0:10:58.36,Default,,0,0,0,,Үлкен есеппен жеңіп, Чихаяға Арата мен Королева арасындағы матчты көрсет!
Dialogue: 0,0:10:58.44,0:11:02.87,Default,,0,0,0,,Маджима қатты толқыды!
Dialogue: 0,0:11:05.70,0:11:07.24,Default,,0,0,0,,Иә? Толып кетті ме?
Dialogue: 0,0:11:07.33,0:11:09.91,Default,,0,0,0,,Оны тағы да толтырыңыз. (Әйел) Оны салуға болмайды ма?
Dialogue: 0,0:11:10.66,0:11:15.09,Default,,0,0,0,,Мен Ураясу кезінде А сыныбының финалына шыққаныма қуаныштымын.
Dialogue: 0,0:11:15.17,0:11:18.09,Default,,0,0,0,,В сыныбының финалында Фудзисакиге қолдау көп болады.
Dialogue: 0,0:11:19.47,0:11:23.09,Default,,0,0,0,,Бірақ сізге көп көңіл бөлініп жатыр, патшайым.
Dialogue: 0,0:11:24.80,0:11:28.22,Default,,0,0,0,,Бірақ басшылықтың назары...
Dialogue: 0,0:11:28.93,0:11:31.81,Default,,0,0,0,,Хаджиме Ватая Мәңгілік Ұстаз…
Dialogue: 0,0:11:31.89,0:11:34.23,Default,,0,0,0,,Мен де саған қарсы ойнадым.
Dialogue: 0,0:11:35.11,0:11:38.98,Default,,0,0,0,,Ол немересі патшайымға қарсы қандай карута ойнайды...
Dialogue: 0,0:11:39.74,0:11:42.36,Default,,0,0,0,,Ол Хисаши Суоны шеберлік орнынан түсіреді.
Dialogue: 0,0:11:42.45,0:11:44.49,Default,,0,0,0,,Ол талантты ма, жоқ па...
Dialogue: 0,0:11:47.03,0:11:48.49,Default,,0,0,0,,Сағыныш
Dialogue: 0,0:11:49.20,0:11:53.21,Default,,0,0,0,,Шинобу-чанның сәл ерекше орналасуы. Қалай жаттау керек
Dialogue: 0,0:11:54.63,0:11:57.96,Default,,0,0,0,,Менің ойымша, сен бұл Хякушюмен көптен бері ойнап жүрсің.
Dialogue: 0,0:11:58.05,0:11:58.96,Default,,0,0,0,,Жалғыз
Dialogue: 0,0:12:03.84,0:12:07.43,Default,,0,0,0,,А... ол жерде.
Dialogue: 0,0:12:08.26,0:12:10.02,Default,,0,0,0,,Мен сені алып кетейін.
Dialogue: 0,0:12:11.56,0:12:14.31,Default,,0,0,0,,Есте сақтау уақыты: 2 минут қалды
Dialogue: 0,0:12:14.40,0:12:15.23,Default,,0,0,0,,Жаңа
Dialogue: 0,0:12:17.06,0:12:19.44,Default,,0,0,0,,Соңында Карутада кім мықты?
Dialogue: 0,0:12:19.53,0:12:21.99,Default,,0,0,0,,Мен Картаниді жеке ойнадым.
Dialogue: 0,0:12:23.15,0:12:26.49,Default,,0,0,0,,Түсінікті болайық: біз бе, әлде сіз бе?
Dialogue: 0,0:12:27.62,0:12:30.41,Default,,0,0,0,,Қалай болғанда да, маған достар керек емес.
Dialogue: 0,0:12:30.49,0:12:31.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:31.41,0:12:32.54,Default,,0,0,0,,Ах
Dialogue: 0,0:12:35.50,0:12:38.84,Default,,0,0,0,,Аясе, сен мына матчты көрмеген ақымақсың.
Dialogue: 0,0:12:39.59,0:12:40.67,Default,,0,0,0,,Жұмысты бастау
Dialogue: 0,0:12:40.75,0:12:42.67,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:12:43.72,0:12:48.18,Default,,0,0,0,,Нанивадуни ~ Сакуяко но Хана...
Dialogue: 0,0:12:48.93,0:12:51.22,Default,,0,0,0,,Сіз қанша қашықтыққа бара аласыз? жаңа
Dialogue: 0,0:12:51.31,0:12:53.68,Default,,0,0,0,,Ең күшті ағымдағы ханшайымға қарсы
Dialogue: 0,0:12:55.77,0:12:58.61,Default,,0,0,0,,Карточкаларды тікелей көрінбейтін жерден алыңыз
Dialogue: 0,0:12:58.69,0:13:01.44,Default,,0,0,0,,Шинобу Вакамияның жылдамдығы мен дәлдігі
Dialogue: 0,0:13:01.53,0:13:04.45,Default,,0,0,0,,Енді Харубето
Dialogue: 0,0:13:04.53,0:13:11.24,Default,,0,0,0,,Сакуяко но Хана
Dialogue: 0,0:13:11.91,0:13:13.58,Default,,0,0,0,,Ширатсуюни~
Dialogue: 0,0:13:13.66,0:13:15.41,Default,,0,0,0,,Ах (аудитория) Қазір қайсысы?
Dialogue: 0,0:13:16.17,0:13:17.04,Default,,0,0,0,,Ханшайым
Dialogue: 0,0:13:17.12,0:13:18.42,Default,,0,0,0,,Коишо~
Dialogue: 0,0:13:19.00,0:13:20.79,Default,,0,0,0,,Сен қайсысын алдың? (Көрермендер) Тағы да патшайым
Dialogue: 0,0:13:20.88,0:13:22.30,Default,,0,0,0,,Өйткені, бұл Королеваның орны.
Dialogue: 0,0:13:28.26,0:13:32.43,Default,,0,0,0,,Үстемдік? Ақымақ болма. Екі карта да бірдей.
Dialogue: 0,0:13:34.85,0:13:35.68,Default,,0,0,0,,Иә
Dialogue: 0,0:13:35.77,0:13:37.19,Default,,0,0,0,,Хмм
Dialogue: 0,0:13:38.06,0:13:43.44,Default,,0,0,0,,Барлық бағыттағы жылдамдық Дәлдік өзгермейді
Dialogue: 0,0:13:43.53,0:13:46.49,Default,,0,0,0,,Бұл Шинобудың күші
Dialogue: 0,0:13:47.61,0:13:50.49,Default,,0,0,0,,Оны есте сақтаудың жаңа тәсілі.
Dialogue: 0,0:13:51.16,0:13:54.75,Default,,0,0,0,,Адамдар өздерінің күшті жақтарына байланысты бөлініп кетеді.
Dialogue: 0,0:13:55.58,0:13:57.33,Default,,0,0,0,,Урамиваби~
Dialogue: 0,0:13:57.41,0:13:58.50,Default,,0,0,0,,Ах
Dialogue: 0,0:13:58.58,0:13:59.67,Default,,0,0,0,,Соқтығысайық!
Dialogue: 0,0:14:00.25,0:14:01.34,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:14:01.42,0:14:03.30,Default,,0,0,0,,Не? Енді... (Көрермендер) Әдемі өткел
Dialogue: 0,0:14:04.17,0:14:07.42,Default,,0,0,0,,«Ука» және «Ура» бір кейіпкерді қабылдауға жеткілікті жылдам патшайымға қарсы қолданылуы мүмкін.
Dialogue: 0,0:14:07.51,0:14:09.55,Default,,0,0,0,,Мен оны бірінші кейіпкерге қарағанда тезірек секіру арқылы түсіндім!
Dialogue: 0,0:14:10.93,0:14:15.56,Default,,0,0,0,,Ватая Сенсейдің «Най Най Карутасын» еске түсіреді
Dialogue: 0,0:14:16.43,0:14:17.31,Default,,0,0,0,,Ханшайым…
Dialogue: 0,0:14:18.56,0:14:21.52,Default,,0,0,0,,Қарсыласым да солай басып алуға тырысты.
Dialogue: 0,0:14:21.61,0:14:24.69,Default,,0,0,0,,Менің сүйікті картамды өткелде ұрлап кетті
Dialogue: 0,0:14:24.78,0:14:28.32,Default,,0,0,0,,Боса алмайтын қарсылас... Тіпті патшайым да солай ойлайтын.
Dialogue: 0,0:14:29.32,0:14:32.12,Default,,0,0,0,,Жан-жақты қорғаныс қауіпті
Dialogue: 0,0:14:33.49,0:14:35.08,Default,,0,0,0,,Барлығын кешіріңіз
Dialogue: 0,0:14:35.70,0:14:40.08,Default,,0,0,0,,Бүгін біз тастайтын карталар мен алған карталарды ажыратуымыз керек.
Dialogue: 0,0:14:41.04,0:14:44.59,Default,,0,0,0,,Шинобу-чан, оны бөлшекте
Dialogue: 0,0:14:49.68,0:14:50.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:50.93,0:14:52.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:52.76,0:14:53.30,Default,,0,0,0,,Йомосугара~
Dialogue: 0,0:14:53.30,0:14:54.47,Default,,0,0,0,,Йомосугара~
Dialogue: 0,0:14:53.30,0:14:54.47,Default,,0,0,0,,Не... Сіз білесіз бе?
Dialogue: 0,0:14:54.56,0:14:55.39,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:14:55.39,0:14:56.31,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:14:55.39,0:14:56.31,Default,,0,0,0,,Қолдаңдар!
Dialogue: 0,0:14:56.39,0:14:58.73,Default,,0,0,0,,Жұмысты екі адам неше рет орындады?
Dialogue: 0,0:14:58.81,0:15:00.06,Default,,0,0,0,,Мета-мета.
Dialogue: 0,0:15:00.85,0:15:05.15,Default,,0,0,0,,Иә? Жартылай финалдағы Машима-сенпайдан мүлде бөлек.
Dialogue: 0,0:15:05.23,0:15:06.98,Default,,0,0,0,,Басқа адам сияқты
Dialogue: 0,0:15:07.07,0:15:10.07,Default,,0,0,0,,Дәлірек айтқанда, жағдай дұрыс болмаған кезде әдеттегідей.
Dialogue: 0,0:15:10.82,0:15:12.07,Default,,0,0,0,,Ұсыныс
Dialogue: 0,0:15:12.82,0:15:15.70,Default,,0,0,0,,Біз тез жеңіп, оны аяқтауымыз керек.
Dialogue: 0,0:15:15.78,0:15:19.08,Default,,0,0,0,,Чихаяға жаңа сәйкестік көрсету
Dialogue: 0,0:15:19.16,0:15:21.08,Default,,0,0,0,,Тайчи
Dialogue: 0,0:15:22.33,0:15:23.96,Default,,0,0,0,,Бақытымызға орай
Dialogue: 0,0:15:24.04,0:15:27.05,Default,,0,0,0,,Сіздің серіктесіңіз Ямаширо мырзаның да көңіл-күйі жоқ сияқты.
Dialogue: 0,0:15:27.13,0:15:28.21,Default,,0,0,0,,Иә
Dialogue: 0,0:15:29.34,0:15:33.51,Default,,0,0,0,,Сол оқырманның оқуы тұрақсыз екені рас.
Dialogue: 0,0:15:33.59,0:15:34.51,Default,,0,0,0,,Бірақ неге...
Dialogue: 0,0:15:35.93,0:15:37.60,Default,,0,0,0,,Ах!?
Dialogue: 0,0:15:37.68,0:15:40.77,Default,,0,0,0,,Үш тұрақты оқырман бар...
Dialogue: 0,0:15:40.85,0:15:44.36,Default,,0,0,0,,Мүмкін бұл оқырмандар үшін жоғарылату емтиханы ретінде де қызмет етеді...
Dialogue: 0,0:15:44.44,0:15:47.36,Default,,0,0,0,,Ханайори~Басқа~
Dialogue: 0,0:15:47.44,0:15:53.11,Default,,0,0,0,,Ширухито жоқ
Dialogue: 0,0:15:53.20,0:15:54.32,Default,,0,0,0,,
Dialogue: 0,0:15:54.41,0:15:55.82,Default,,0,0,0,,Ах
Dialogue: 0,0:15:55.91,0:15:57.91,Default,,0,0,0,,Кешіріңіз... (Әнші жылайды)
Dialogue: 0,0:15:57.99,0:15:59.83,Default,,0,0,0,,Ол міндетті түрде құлайды...
Dialogue: 0,0:16:04.00,0:16:06.79,Default,,0,0,0,,(Рион терең тыныс алады)
Dialogue: 0,0:16:08.50,0:16:09.84,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:16:09.92,0:16:11.59,Default,,0,0,0,,Жеңіс! (Макото және т.б.) Жең!
Dialogue: 0,0:16:11.67,0:16:15.05,Default,,0,0,0,,Сіздің жеңісіңіз – Фудзисакидің жеңісі!
Dialogue: 0,0:16:15.64,0:16:16.68,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:18.26,0:16:20.27,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:16:20.35,0:16:23.10,Default,,0,0,0,,Осы уақытқа дейін мен тек оқырмандарға қарап келдім.
Dialogue: 0,0:16:24.94,0:16:27.61,Default,,0,0,0,,Ханайори~Басқа~
Dialogue: 0,0:16:24.94,0:16:27.61,Default,,0,0,0,,Ритмді ала алмаймын Темп тұрақты емес
Dialogue: 0,0:16:27.61,0:16:27.69,Default,,0,0,0,,Ырғақты ала алмаймын Темп тұрақты емес
Dialogue: 0,0:16:27.69,0:16:28.73,Default,,0,0,0,,Ритмді табу мүмкін емес Темп тұрақсыз
Dialogue: 0,0:16:27.69,0:16:28.73,Default,,0,0,0,,Ширухито жоқ
Dialogue: 0,0:16:28.73,0:16:29.27,Default,,0,0,0,,Ширухито жоқ
Dialogue: 0,0:16:29.27,0:16:32.28,Default,,0,0,0,,Ширухито жоқ
Dialogue: 0,0:16:29.27,0:16:32.28,Default,,0,0,0,,Бірақ әрбір нота әдемі
Dialogue: 0,0:16:32.28,0:16:33.11,Default,,0,0,0,,Бірақ әрбір нота әдемі
Dialogue: 0,0:16:34.20,0:16:34.91,Default,,0,0,0,,Магпи ~
Dialogue: 0,0:16:34.91,0:16:36.07,Default,,0,0,0,,Магпи ~
Dialogue: 0,0:16:34.91,0:16:36.07,Default,,0,0,0,,На
Dialogue: 0,0:16:41.20,0:16:45.12,Default,,0,0,0,,Бұл... Тіпті Чихаяның қолынан әрең келді...
Dialogue: 0,0:16:45.79,0:16:47.46,Default,,0,0,0,,Ол Мэйджин Суоға ұқсайды.
Dialogue: 0,0:16:47.54,0:16:49.29,Default,,0,0,0,,Яма-чанның сезімі
Dialogue: 0,0:16:50.75,0:16:51.67,Default,,0,0,0,,Тайчи…
Dialogue: 0,0:16:51.76,0:16:53.30,Default,,0,0,0,,Фукукарани~ (Таичи)
Dialogue: 0,0:16:53.38,0:16:55.13,Default,,0,0,0,,Момошикия~ (Тайчи) Уф...
Dialogue: 0,0:16:56.97,0:17:00.39,Default,,0,0,0,,Не... Оны алу үшін не сұрауым керек?
Dialogue: 0,0:17:01.60,0:17:06.90,Default,,0,0,0,,Ғ және М дыбыстарын дыбысқа айналғанға дейін түсіре алатын адам.
Dialogue: 0,0:17:06.98,0:17:11.15,Default,,0,0,0,,Мен мұндай талантпен қалай бәсекелесемін...
Dialogue: 0,0:17:12.23,0:17:14.82,Default,,0,0,0,,Яма-чанды алып кетсең жақсы емес, Тайчи.
Dialogue: 0,0:17:14.90,0:17:16.66,Default,,0,0,0,,Қолдан шығу
Dialogue: 0,0:17:16.74,0:17:18.91,Default,,0,0,0,,Сіз қабылдауға болатын шоттарды ала алмайсыз.
Dialogue: 0,0:17:19.49,0:17:22.95,Default,,0,0,0,,Хмм... Мен не істеп жатырмын?
Dialogue: 0,0:17:23.75,0:17:28.63,Default,,0,0,0,,Тез жеңіске жетпесек, билет санына өзгеріс енгізбесек, А сыныбының финалы болады...
Dialogue: 0,0:17:30.13,0:17:34.67,Default,,0,0,0,,Мэйджин Суо сияқты талантты қалай алдыңыз...
Dialogue: 0,0:17:40.51,0:17:41.81,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:43.60,0:17:46.14,Default,,0,0,0,,Себебі ол Мэйджин Суоға ұқсайды деп ойлаймын.
Dialogue: 0,0:17:46.23,0:17:48.10,Default,,0,0,0,,Денем қатып қалады.
Dialogue: 0,0:17:50.06,0:17:51.57,Default,,0,0,0,,Чихаяға ұқсайды
Dialogue: 0,0:17:52.52,0:17:54.07,Default,,0,0,0,,Чихаяға ұқсайды
Dialogue: 0,0:17:57.11,0:17:59.03,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:17:59.91,0:18:02.33,Default,,0,0,0,,Вексельді жылжыту
Dialogue: 0,0:18:06.00,0:18:08.92,Default,,0,0,0,,А, мен досымның барлық шотын бөлдім.
Dialogue: 0,0:18:09.75,0:18:14.67,Default,,0,0,0,,Мен Чихаяны әлі тәжірибеде дұрыстап жеңген жоқпын.
Dialogue: 0,0:18:15.55,0:18:16.38,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:16.47,0:18:18.34,Default,,0,0,0,,Хитомоши~
Dialogue: 0,0:18:18.43,0:18:19.26,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:19.34,0:18:20.80,Default,,0,0,0,,Қазір~
Dialogue: 0,0:18:20.89,0:18:24.10,Default,,0,0,0,,Бөлінген дос жазбасы (Чихая) Үш әріптік ереже мен түсіндім!
Dialogue: 0,0:18:24.18,0:18:26.10,Default,,0,0,0,,алынды
Dialogue: 0,0:18:27.06,0:18:28.35,Default,,0,0,0,,Уф! (Әнші) Суминоэно~
Dialogue: 0,0:18:28.44,0:18:29.73,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:18:30.40,0:18:31.23,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:33.86,0:18:35.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:35.32,0:18:36.99,Default,,0,0,0,,Аймитено~
Dialogue: 0,0:18:37.07,0:18:38.70,Default,,0,0,0,,Акинотано~ (Тайчи) Ху
Dialogue: 0,0:18:38.78,0:18:41.03,Default,,0,0,0,,Өте қарапайым нәрсе
Dialogue: 0,0:18:41.11,0:18:43.70,Default,,0,0,0,,Бірақ мен жақсы "сезім" бар адамды іздеймін!
Dialogue: 0,0:18:43.78,0:18:48.16,Default,,0,0,0,,Жылдамдық ойынына кірмей-ақ жеңіске жету ықтималдығын арттыратын шабуыл әдістері
Dialogue: 0,0:18:48.25,0:18:51.63,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:18:52.25,0:18:54.09,Default,,0,0,0,,«Ва» және «ко» карталары алаңда.
Dialogue: 0,0:18:54.17,0:18:55.92,Default,,0,0,0,,Секіріңіз де, алыңыз.
Dialogue: 0,0:18:56.00,0:18:59.59,Default,,0,0,0,,Сіздің жағыңыздағы бес «А» картасы бөлек орналастырылған.
Dialogue: 0,0:18:59.68,0:19:02.18,Default,,0,0,0,,Сізге бір нотамен шабуыл жасалса, үрейленбеңіз
Dialogue: 0,0:19:02.26,0:19:04.05,Default,,0,0,0,,Жоғарғы сол жақ жолды пайдаланыңыз
Dialogue: 0,0:19:04.14,0:19:06.18,Default,,0,0,0,,Қарсыласыңызға осы жерден көздеуге мүмкіндік беріңіз
Dialogue: 0,0:19:06.27,0:19:08.60,Default,,0,0,0,,Қолдар төмен, төмен
Dialogue: 0,0:19:08.68,0:19:10.94,Default,,0,0,0,,Төменгі оң жақ бұрыштағы карталардың үлкен үйіндісін мықтап қоршап алсаңыз,
Dialogue: 0,0:19:11.02,0:19:12.73,Default,,0,0,0,,Ешқашан алынбаған
Dialogue: 0,0:19:12.81,0:19:15.15,Default,,0,0,0,,Қарсылас бөлу картасын басып алғанша жеткілікті.
Dialogue: 0,0:19:15.23,0:19:17.69,Default,,0,0,0,,Оны асыра алмаңыз және 50% қамтамасыз етіңіз
Dialogue: 0,0:19:17.78,0:19:19.28,Default,,0,0,0,,Жақсы жаттау
Dialogue: 0,0:19:19.36,0:19:22.66,Default,,0,0,0,,Әсіресе бастапқы орнынан жылжытылған вексельдерді екі рет тексеріңіз.
Dialogue: 0,0:19:23.20,0:19:25.45,Default,,0,0,0,,Тұрақты таңбалар өзгеріп отырады
Dialogue: 0,0:19:25.53,0:19:29.08,Default,,0,0,0,,Есте сақтауды жинақтау, тексеру және бекіту
Dialogue: 0,0:19:29.91,0:19:32.50,Default,,0,0,0,,Бір таңбадан тұратын барлық ережелерді алып тастаңыз
Dialogue: 0,0:19:32.58,0:19:34.59,Default,,0,0,0,,Көңілсіз болған дұрыс
Dialogue: 0,0:19:34.67,0:19:38.34,Default,,0,0,0,,Кірпік-кун Карутада маңыздысы – талант.
Dialogue: 0,0:19:38.42,0:19:39.51,Default,,0,0,0,,«Сезім»
Dialogue: 0,0:19:40.13,0:19:41.76,Default,,0,0,0,,Бірақ сонымен бірге Карута...
Dialogue: 0,0:19:43.43,0:19:45.26,Default,,0,0,0,,10 «алды»...
Dialogue: 0,0:19:46.72,0:19:49.14,Default,,0,0,0,,15 «алып кетті»!
Dialogue: 0,0:19:51.81,0:19:55.48,Default,,0,0,0,,Үлкен айырмашылық жеткілікті. Бір картаның айырмашылығы жеткілікті.
Dialogue: 0,0:19:56.40,0:19:57.48,Default,,0,0,0,,Бір ғана айырмашылық жақсы.
Dialogue: 0,0:19:59.53,0:20:02.74,Default,,0,0,0,,Мен Чихаяны бір күні жеңгім келеді
Dialogue: 0,0:20:03.28,0:20:04.91,Default,,0,0,0,,Чихаябуру~
Dialogue: 0,0:20:12.62,0:20:14.12,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:20:16.34,0:20:19.88,Default,,0,0,0,,Маған көп нәрсе жетіспейді
Dialogue: 0,0:20:20.67,0:20:23.26,Default,,0,0,0,,Рионның физикалық күші жеткіліксіз
Dialogue: 0,0:20:23.34,0:20:26.76,Default,,0,0,0,,Мен чемпиондық мақсат үшін ешқашан бес ойын өткізген емеспін.
Dialogue: 0,0:20:27.60,0:20:29.64,Default,,0,0,0,,Мизусаваның менеджері керемет.
Dialogue: 0,0:20:29.72,0:20:30.64,Default,,0,0,0,,(Тайчидің ауыр тыныс алуы)
Dialogue: 0,0:20:30.64,0:20:32.02,Default,,0,0,0,,(Тайчидің ауыр тыныс алуы)
Dialogue: 0,0:20:30.64,0:20:32.02,Default,,0,0,0,,Оқытылды
Dialogue: 0,0:20:32.02,0:20:32.85,Default,,0,0,0,,(Тайчидің ауыр тыныс алуы)
Dialogue: 0,0:20:32.85,0:20:34.73,Default,,0,0,0,,(Тайчидің ауыр тыныс алуы)
Dialogue: 0,0:20:32.85,0:20:34.73,Default,,0,0,0,,Дарындылықпен күресуге дайын болыңыз
Dialogue: 0,0:20:34.73,0:20:35.90,Default,,0,0,0,,Дарындылықпен күресуге дайын болыңыз
Dialogue: 0,0:20:38.32,0:20:39.90,Default,,0,0,0,,Машима 9 дана
Dialogue: 0,0:20:40.86,0:20:41.90,Default,,0,0,0,,9 парақ айырмашылығы
Dialogue: 0,0:20:46.28,0:20:47.66,Default,,0,0,0,,Уау (Тайчи) Ойдан тыс қалма!
Dialogue: 0,0:20:47.74,0:20:48.99,Default,,0,0,0,,Кеттік, 2-қабат
Dialogue: 0,0:20:49.08,0:20:50.83,Default,,0,0,0,,А деңгейіндегі финалдық ойындар әлі де ойналуда.
Dialogue: 0,0:20:50.91,0:20:53.96,Default,,0,0,0,,Бұл Королева мен Арата арасындағы матч. Қараңыз...
Dialogue: 0,0:20:54.04,0:20:55.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:56.38,0:21:00.84,Default,,0,0,0,,(Чихаяның жылағаны)
Dialogue: 0,0:21:01.88,0:21:03.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:03.17,0:21:08.35,Default,,0,0,0,,(Чихаяның жылағаны)
Dialogue: 0,0:21:11.68,0:21:13.93,Default,,0,0,0,,Бұл А класы, Тайчи.
Dialogue: 0,0:21:15.44,0:21:16.56,Default,,0,0,0,,Ах
Dialogue: 0,0:21:20.98,0:21:22.82,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:21:22.90,0:21:25.86,Default,,0,0,0,,(Чихая мен Тайчидің жылауы)
Dialogue: 0,0:21:25.95,0:21:30.95,Default,,0,0,0,,♪~
Dialogue: 0,0:22:42.52,0:22:47.53,Default,,0,0,0,,~♪
