Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.72,0:00:20.81,Default,,0,0,0,,(жартылай қоңырау дыбысы)
Dialogue: 0,0:00:20.89,0:00:24.44,Default,,0,0,0,,Әй, күзетші! 7-ші дивизия шабуыл жасады ма?
Dialogue: 0,0:00:24.52,0:00:26.02,Default,,0,0,0,,Бізді өлтіреміз!
Dialogue: 0,0:00:26.10,0:00:27.81,Default,,0,0,0,,Мына жерді ашыңыз!
Dialogue: 0,0:00:29.19,0:00:31.61,Default,,0,0,0,,Сугимото: Біз не істеуіміз керек?
Dialogue: 0,0:00:31.69,0:00:33.15,Default,,0,0,0,,Сенің қашудан басқа амалың жоқ!
Dialogue: 0,0:00:33.24,0:00:36.07,Default,,0,0,0,,Бұл жерден құтылудың жолын ойлаңыз! Корольден қашыңыз!
Dialogue: 0,0:00:36.16,0:00:37.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:37.91,0:00:38.83,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:00:38.91,0:00:40.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:44.25,0:00:47.58,Default,,0,0,0,,Мен сені әлі де осында аламын.
Dialogue: 0,0:00:51.05,0:00:56.05,Default,,0,0,0,,♪~
Dialogue: 0,0:02:15.92,0:02:20.93,Default,,0,0,0,,~♪
Dialogue: 0,0:02:21.01,0:02:22.89,Default,,0,0,0,,(жартылай қоңырау дыбысы)
Dialogue: 0,0:02:22.97,0:02:25.47,Default,,0,0,0,,Бүгінгі күнге дейін лейтенант Цурумимен бірге
Dialogue: 0,0:02:25.56,0:02:27.23,Default,,0,0,0,,Бұл сіз оны жасырғаныңызды білдіре ме?
Dialogue: 0,0:02:27.31,0:02:28.14,Default,,0,0,0,,Inkaㇻma
Dialogue: 0,0:02:29.19,0:02:32.11,Default,,0,0,0,,Сугимото мырза мен оның әріптестері сәтсіздікке ұшырады.
Dialogue: 0,0:02:32.19,0:02:33.40,Default,,0,0,0,,Енді бұл болды
Dialogue: 0,0:02:33.48,0:02:37.07,Default,,0,0,0,,Нопперабо мен Ашипа-чанды бұл жерден аман-есен шығарып алатын кім?
Dialogue: 0,0:02:37.15,0:02:39.57,Default,,0,0,0,,Тек лейтенант Цуруми
Dialogue: 0,0:02:39.65,0:02:43.91,Default,,0,0,0,,Содан кейін Айну алтыны 7-ші бөлімге түседі.
Dialogue: 0,0:02:43.99,0:02:45.66,Default,,0,0,0,,Сізге бұл жақсы ма?
Dialogue: 0,0:02:45.74,0:02:48.66,Default,,0,0,0,,Алтынды кім алса да
Dialogue: 0,0:02:48.75,0:02:52.92,Default,,0,0,0,,Мұның маған немесе Нипа Танигакиге еш қатысы жоқ, солай ма?
Dialogue: 0,0:02:53.00,0:02:54.63,Default,,0,0,0,,Ха...
Dialogue: 0,0:02:55.59,0:02:57.92,Default,,0,0,0,,Әйелдер қорқынышты...
Dialogue: 0,0:02:58.63,0:03:00.84,Default,,0,0,0,,Тренингке сәйкес орналастырыңыз
Dialogue: 0,0:03:00.93,0:03:04.35,Default,,0,0,0,,Максим пулеметтерін қақпаның екі қанатына орналастырыңыз.
Dialogue: 0,0:03:05.43,0:03:07.77,Default,,0,0,0,,Қақпаны бұзып кіріп келген жауынгерлерге.
Dialogue: 0,0:03:07.85,0:03:09.27,Default,,0,0,0,,Айқас атыс
Dialogue: 0,0:03:10.52,0:03:12.65,Default,,0,0,0,,Барлығын фаршқа айналдырамын.
Dialogue: 0,0:03:12.73,0:03:15.40,Default,,0,0,0,,Шошқаларды тамақтандыруға біраз уақыт алаңдамайсыз.
Dialogue: 0,0:03:17.98,0:03:21.86,Default,,0,0,0,,Ха! Туннельге қарай жүгірейік! Асығыңыз!
Dialogue: 0,0:03:40.30,0:03:42.09,Default,,0,0,0,,Ти! (Цуруми) Ах...
Dialogue: 0,0:03:51.31,0:03:53.10,Default,,0,0,0,,Ах! (Танигаки) Арх!
Dialogue: 0,0:03:57.98,0:03:59.44,Default,,0,0,0,,Мұндай жерде дүкен ашу—
Dialogue: 0,0:03:59.53,0:04:00.40,Default,,0,0,0,,Әй!
Dialogue: 0,0:04:00.49,0:04:04.41,Default,,0,0,0,,Уау... у...
Dialogue: 0,0:04:05.53,0:04:07.16,Default,,0,0,0,,Әкеңді көргің келмей ме?
Dialogue: 0,0:04:16.42,0:04:17.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:17.63,0:04:19.84,Default,,0,0,0,,Бұл қауіпті! Жүгір, жүгір!
Dialogue: 0,0:04:23.42,0:04:27.14,Default,,0,0,0,,Бұл Абашири өзеніне қарайтын қоршау. Мен алдандым!
Dialogue: 0,0:04:36.77,0:04:38.31,Default,,0,0,0,,Лейтенант Цуруми
Dialogue: 0,0:04:38.40,0:04:41.53,Default,,0,0,0,,Орталықтағы адамдарға қалай есеп беруді жоспарлайсыз?
Dialogue: 0,0:04:42.78,0:04:44.03,Default,,0,0,0,,Бұл шегіртке.
Dialogue: 0,0:04:44.65,0:04:45.70,Default,,0,0,0,,Шегіртке?
Dialogue: 0,0:04:46.61,0:04:50.70,Default,,0,0,0,,Мэйдзи 15-те Тонденхай залалды тоқтатуға тырысты.
Dialogue: 0,0:04:50.79,0:04:53.79,Default,,0,0,0,,Зеңбіректерді қолданудың прецеденті бар.
Dialogue: 0,0:04:53.87,0:04:55.46,Default,,0,0,0,,Сюжет мынадай
Dialogue: 0,0:04:55.54,0:05:00.30,Default,,0,0,0,,Шығыс Хоккайдо жағалауымен солтүстікке қарай жылжыған шегірткелердің үлкен армиясын жою.
Dialogue: 0,0:05:00.38,0:05:06.63,Default,,0,0,0,,Аоморидегі Оминато портының командирі генерал-майор Коитодан ынтымақтастық туралы сұрау
Dialogue: 0,0:05:06.72,0:05:07.80,Default,,0,0,0,,Сондай-ақ
Dialogue: 0,0:05:07.89,0:05:12.27,Default,,0,0,0,,Шариге қоңырау шалып жатқанда, Абашири түрмесінде бүлік шықты.
Dialogue: 0,0:05:12.35,0:05:15.69,Default,,0,0,0,,Біз ішке кіріп, жағдайды бақылауға алдық.
Dialogue: 0,0:05:17.31,0:05:20.86,Default,,0,0,0,,Зиянды және тәртіпсіздікті орталықтағы адам жасайды.
Dialogue: 0,0:05:20.94,0:05:24.69,Default,,0,0,0,,Адамдардың жердің шетіне келіп тексеруі екіталай.
Dialogue: 0,0:05:25.32,0:05:28.99,Default,,0,0,0,,Әрекеттен кейінгі есеп орталық үкімет үшін әрқашан жеткілікті.
Dialogue: 0,0:05:29.91,0:05:32.95,Default,,0,0,0,,Егер түрмедегі бір адам болса да куәлік берсе
Dialogue: 0,0:05:33.04,0:05:35.29,Default,,0,0,0,,Есеп тұрмайды.
Dialogue: 0,0:05:37.92,0:05:40.92,Default,,0,0,0,,Түрме куәгері?
Dialogue: 0,0:05:50.01,0:05:53.68,Default,,0,0,0,,Бұл Хокудзин бөлімі. Бізде жеңу мүмкін емес. Мен берілемін.
Dialogue: 0,0:05:53.77,0:05:55.85,Default,,0,0,0,,Бірақ оны өлтіреді деген қауесеттер бар.
Dialogue: 0,0:05:55.93,0:05:58.39,Default,,0,0,0,,Бұл сөзсіз өтірік! Инудо Денгоку
Dialogue: 0,0:05:58.48,0:06:00.94,Default,,0,0,0,,Бұл бізді қарсы тұруға мәжбүрлейтін жалған ақпарат!
Dialogue: 0,0:06:01.02,0:06:02.44,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:03.82,0:06:05.69,Default,,0,0,0,,Ах! (Күзетші) Әй, міне!
Dialogue: 0,0:06:09.78,0:06:12.20,Default,,0,0,0,,Уа, атпа! Берілу... Арх...
Dialogue: 0,0:06:13.28,0:06:14.45,Default,,0,0,0,,Әй, уау!
Dialogue: 0,0:06:17.41,0:06:19.87,Default,,0,0,0,,Камераға асығыңыз!
Dialogue: 0,0:06:27.72,0:06:29.88,Default,,0,0,0,,Олар бұл жерді өшіруге келді.
Dialogue: 0,0:06:29.97,0:06:34.64,Default,,0,0,0,,Егер сіз төбелеспесеңіз, сізді «Қасқыр Орақ» басып алады. Бұл сенің жалғыз тағдырың.
Dialogue: 0,0:06:38.77,0:06:40.52,Default,,0,0,0,,Inkaㇻmak!
Dialogue: 0,0:06:40.60,0:06:43.40,Default,,0,0,0,,Inkaㇻma! Бұл қайда!?
Dialogue: 0,0:06:43.48,0:06:44.77,Default,,0,0,0,,Танигаки НиㇱП...
Dialogue: 0,0:06:44.86,0:06:47.53,Default,,0,0,0,,Ха! Инкаㇻма!
Dialogue: 0,0:06:50.36,0:06:51.07,Default,,0,0,0,,Inkaㇻma! Ах...
Dialogue: 0,0:06:51.07,0:06:52.53,Default,,0,0,0,,Inkaㇻma! Ах...
Dialogue: 0,0:06:51.07,0:06:52.53,Default,,0,0,0,,(жығылған дыбыс)
Dialogue: 0,0:06:53.91,0:06:55.03,Default,,0,0,0,,Қашып кетіңізші...
Dialogue: 0,0:06:56.87,0:06:58.87,Default,,0,0,0,,Мен сені мұндай жерде өлуге жол бермеймін! Уф...
Dialogue: 0,0:06:59.58,0:07:02.33,Default,,0,0,0,,Ах... (Танигаки) Арх... Арх!
Dialogue: 0,0:07:02.42,0:07:04.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:04.17,0:07:05.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:05.59,0:07:09.72,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,0:07:12.64,0:07:13.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:13.68,0:07:18.72,Default,,0,0,0,,Ммм... Уау!
Dialogue: 0,0:07:18.81,0:07:20.35,Default,,0,0,0,,Шық! (Инкаㇻма) Ах!
Dialogue: 0,0:07:20.44,0:07:23.94,Default,,0,0,0,,Ах! (Инкаㇻма) Ха, ха...
Dialogue: 0,0:07:25.19,0:07:26.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:31.74,0:07:32.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:36.78,0:07:38.33,Default,,0,0,0,,Ах! (Танигаки) Ушияма!
Dialogue: 0,0:07:39.83,0:07:41.33,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:07:42.54,0:07:45.00,Default,,0,0,0,,Ушияма мырза, мұнда тезірек келуіңіз керек!
Dialogue: 0,0:07:45.08,0:07:46.09,Default,,0,0,0,,(жығылған дыбыс)
Dialogue: 0,0:07:46.17,0:07:49.84,Default,,0,0,0,,Балалар сендер бақытты боласыңдар.
Dialogue: 0,0:07:49.92,0:07:51.51,Default,,0,0,0,,Ха! (Инкаㇻма) Ха...
Dialogue: 0,0:07:51.59,0:07:53.38,Default,,0,0,0,,Міне... Ушияма мырза!
Dialogue: 0,0:07:57.85,0:07:59.39,Default,,0,0,0,,Қайдасың!
Dialogue: 0,0:08:02.98,0:08:05.61,Default,,0,0,0,,Менің костюмім лас.
Dialogue: 0,0:08:19.29,0:08:22.04,Default,,0,0,0,,Орыс-жапон соғысында қолданылған алау бомбасы.
Dialogue: 0,0:08:39.81,0:08:42.10,Default,,0,0,0,,Сержант Цукишима, істе.
Dialogue: 0,0:08:42.18,0:08:43.27,Default,,0,0,0,,Иә
Dialogue: 0,0:08:47.65,0:08:49.61,Default,,0,0,0,,Сіз бірдеңе лақтырдыңыз! (Күзетші) Ах!
Dialogue: 0,0:08:54.86,0:08:56.53,Default,,0,0,0,,Оларды алға жылжытыңыз және қуыңыз
Dialogue: 0,0:08:56.61,0:08:59.53,Default,,0,0,0,,Сен жау емес екеніңе қуаныштымын. Мен сені жеңе алмас едім.
Dialogue: 0,0:08:59.62,0:09:03.54,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:05.62,0:09:07.67,Default,,0,0,0,,Ширайши, сен не істеп жатырсың?
Dialogue: 0,0:09:07.75,0:09:10.25,Default,,0,0,0,,Әрбір ұяшықтың асты
Dialogue: 0,0:09:10.34,0:09:12.71,Default,,0,0,0,,Желдетуге арналған тар орын бар.
Dialogue: 0,0:09:12.80,0:09:14.22,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:09:14.30,0:09:15.93,Default,,0,0,0,,Қатты шу!
Dialogue: 0,0:09:16.01,0:09:18.22,Default,,0,0,0,,Тыныш болыңыз! сурет?
Dialogue: 0,0:09:18.30,0:09:20.43,Default,,0,0,0,,Ах! Ах~! Ах~!
Dialogue: 0,0:09:20.51,0:09:23.02,Default,,0,0,0,,Ах! Ах~! Ах~!
Dialogue: 0,0:09:24.23,0:09:27.23,Default,,0,0,0,,Оның жалған екенін білдіңіз бе?
Dialogue: 0,0:09:28.69,0:09:30.27,Default,,0,0,0,,Мүмкін директор Кадокура да шығар?
Dialogue: 0,0:09:31.07,0:09:33.15,Default,,0,0,0,,Біз түрмеден қашқаннан кейін
Dialogue: 0,0:09:33.23,0:09:37.74,Default,,0,0,0,,Нопперабо жасырын түрде Инудо Денгокумен ауыстырылды.
Dialogue: 0,0:09:37.82,0:09:42.08,Default,,0,0,0,,Менеджер Кадокура Нопперабоны жеті жыл бойы бақылап жүрді.
Dialogue: 0,0:09:42.16,0:09:45.12,Default,,0,0,0,,Мен ауыстырылғанымды байқамайтындай ақымақ емеспін.
Dialogue: 0,0:09:45.20,0:09:48.58,Default,,0,0,0,,Сіз Сугимото мен оның достарын сонда жібергеніңізді білесіз бе?
Dialogue: 0,0:09:48.67,0:09:49.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:50.63,0:09:53.25,Default,,0,0,0,,Менің артымнан тыныш жүріңіз.
Dialogue: 0,0:09:54.05,0:09:56.13,Default,,0,0,0,,Сіз өз мүмкіндігіңізді жіберіп аласыз
Dialogue: 0,0:10:01.43,0:10:02.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:02.85,0:10:04.27,Default,,0,0,0,,Ха! (Сугимото) Міне!
Dialogue: 0,0:10:04.35,0:10:06.10,Default,,0,0,0,,А, а... (Кадокура) Не істеп жатырсың? Тез қаш!
Dialogue: 0,0:10:06.27,0:10:07.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:12.98,0:10:14.53,Default,,0,0,0,,Нопперабо ше?
Dialogue: 0,0:10:16.07,0:10:18.86,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:10:18.95,0:10:19.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:21.95,0:10:23.87,Default,,0,0,0,,Усами!?
Dialogue: 0,0:10:27.12,0:10:28.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:34.30,0:10:36.96,Default,,0,0,0,,Өлмейтін Сугимото
Dialogue: 0,0:10:37.80,0:10:39.47,Default,,0,0,0,,Мен Сугимотоға көмектесуім керек
Dialogue: 0,0:10:39.55,0:10:42.72,Default,,0,0,0,,Сугимото қасымда болмаса, мен бармаймын.
Dialogue: 0,0:10:42.80,0:10:45.47,Default,,0,0,0,,Қызыңыздың сырт келбетін тексерсеңіз
Dialogue: 0,0:10:45.56,0:10:48.73,Default,,0,0,0,,Нопперабо алтынның қайда екенін көрсетуі керек.
Dialogue: 0,0:10:49.69,0:10:52.90,Default,,0,0,0,,Барлығы осыны күтумен келді.
Dialogue: 0,0:10:52.98,0:10:56.40,Default,,0,0,0,,Тіпті Сугимото өзінің қауіпсіздігіне көбірек алаңдайды.
Dialogue: 0,0:10:56.48,0:10:59.24,Default,,0,0,0,,Сіз мұны қалауыңыз керек.
Dialogue: 0,0:10:59.32,0:11:00.40,Default,,0,0,0,,Артқа шегін!
Dialogue: 0,0:11:00.49,0:11:03.99,Default,,0,0,0,,Айтайын дегенім бұл жігіттен алтынның қайда екенін әлі естіген жоқпын.
Dialogue: 0,0:11:10.54,0:11:12.21,Default,,0,0,0,,Ача қайда орналасқан?
Dialogue: 0,0:11:13.46,0:11:17.34,Default,,0,0,0,,Мен өзіммен бірге барлығы 63 бағынышты алып келдім.
Dialogue: 0,0:11:17.42,0:11:20.88,Default,,0,0,0,,Бізден осылай қашуды жоспарлап отырсың ба?
Dialogue: 0,0:11:20.97,0:11:23.18,Default,,0,0,0,,Көріп көрейік.
Dialogue: 0,0:11:23.26,0:11:24.97,Default,,0,0,0,,Барлығың, қаруларыңды қойып, осы жерден бастаңдар...
Dialogue: 0,0:11:25.05,0:11:25.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:25.97,0:11:28.64,Default,,0,0,0,,Никайдо! (Кохи) Кихихи...
Dialogue: 0,0:11:28.72,0:11:33.15,Default,,0,0,0,,Уф... жібер! Мен сені өлтіремін деп уәде беремін!
Dialogue: 0,0:11:34.23,0:11:35.73,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:11:35.82,0:11:37.94,Default,,0,0,0,,Нопперабоны ұрсаң не істейсің?
Dialogue: 0,0:11:38.03,0:11:39.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:39.74,0:11:41.40,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:11:41.49,0:11:45.37,Default,,0,0,0,,Арх! Барлығыңыз тезірек бұл ғимараттан кетіңіздер!
Dialogue: 0,0:11:45.45,0:11:48.66,Default,,0,0,0,,Мен Нопперабоның басын кесіп аламын! Жарайды ма?
Dialogue: 0,0:11:50.20,0:11:51.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:52.29,0:11:55.67,Default,,0,0,0,,Бастық Кадокура! (Кадокура) А...
Dialogue: 0,0:11:55.75,0:11:57.50,Default,,0,0,0,,Бұл не өзі…?>
Dialogue: 0,0:11:58.17,0:11:59.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:59.21,0:12:01.13,Default,,0,0,0,,Бұл қандай мең?
Dialogue: 0,0:12:01.22,0:12:02.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:04.97,0:12:08.89,Default,,0,0,0,,Директор Кадокура, кешіріңіз, мен сіздің мойныңызды көздеп едім.
Dialogue: 0,0:12:10.18,0:12:11.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:11.23,0:12:12.94,Default,,0,0,0,,Жаңадан келген
Dialogue: 0,0:12:13.44,0:12:17.15,Default,,0,0,0,,Сіз бұл құрылғы туралы әлі түсіндірмедіңіз бе?
Dialogue: 0,0:12:17.23,0:12:18.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:18.57,0:12:20.48,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:12:20.57,0:12:22.65,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:12:22.74,0:12:25.11,Default,,0,0,0,,Кабато түрмесінде ойлап табылған
Dialogue: 0,0:12:25.20,0:12:27.49,Default,,0,0,0,,Бұл бір уақытта ашылатын құрылғы.
Dialogue: 0,0:12:31.83,0:12:32.87,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:32.96,0:12:38.38,Default,,0,0,0,,Хаха... Сіз 700 қаскөймен күресуге дайынсыз ба?
Dialogue: 0,0:12:38.46,0:12:40.96,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:41.05,0:12:41.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:45.59,0:12:49.47,Default,,0,0,0,,(Тұтқындардың ұрыс айқайы)
Dialogue: 0,0:12:49.56,0:12:51.27,Default,,0,0,0,,Hiiiii...
Dialogue: 0,0:12:51.35,0:12:55.73,Default,,0,0,0,,(Тұтқындардың ұрыс айқайы)
Dialogue: 0,0:12:59.23,0:13:00.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:00.98,0:13:02.65,Default,,0,0,0,,Қылыш таққан!
Dialogue: 0,0:13:04.49,0:13:06.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:06.24,0:13:09.28,Default,,0,0,0,,Барлығын құрт!
Dialogue: 0,0:13:09.99,0:13:15.21,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:15.29,0:13:18.71,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:18.79,0:13:20.96,Default,,0,0,0,,Хаа… Хаа…
Dialogue: 0,0:13:24.63,0:13:26.22,Default,,0,0,0,,Сугимото! Эх...
Dialogue: 0,0:13:31.72,0:13:33.14,Default,,0,0,0,,Сугимото?
Dialogue: 0,0:13:36.89,0:13:39.40,Default,,0,0,0,,Хиджикатаның қарт адамы осының бәрін ұйымдастырса керек.
Dialogue: 0,0:13:39.48,0:13:41.57,Default,,0,0,0,,Тотанджи де гуру болса
Dialogue: 0,0:13:41.65,0:13:45.03,Default,,0,0,0,,Ашипа-чан қазір қарттың қасында болуы мүмкін.
Dialogue: 0,0:13:45.11,0:13:49.62,Default,,0,0,0,,Жалған Нопперабо орналасқан ұяшыққа еніп көрейік.
Dialogue: 0,0:13:49.70,0:13:52.95,Default,,0,0,0,,Егер сіз дүрбелең тудырсаңыз, Инудо мазасызданады.
Dialogue: 0,0:13:53.04,0:13:56.71,Default,,0,0,0,,Нағыз Нопперабоның жасырынған жеріне бағыт алу керек.
Dialogue: 0,0:13:56.79,0:14:00.54,Default,,0,0,0,,Хиджикатаның басынан бастап мақсаты да осы болатын.
Dialogue: 0,0:14:01.59,0:14:04.59,Default,,0,0,0,,Кадокура бізді камераға байлаған кезде.
Dialogue: 0,0:14:04.67,0:14:10.39,Default,,0,0,0,,Ашипа мырзаны әкесімен таныстырып, алтынның қайда екенін біліп, қашып кетіңіз.
Dialogue: 0,0:14:10.47,0:14:15.39,Default,,0,0,0,,Мен осы мүмкіндікті пайдаланып, мені Ашипа-саннан ажыратуды жоспарлап отырмын.
Dialogue: 0,0:14:15.47,0:14:18.39,Default,,0,0,0,,Мен бір күні кедергі болатыныма сенімдімін
Dialogue: 0,0:14:20.56,0:14:22.27,Default,,0,0,0,,Hmph...
Dialogue: 0,0:14:22.36,0:14:24.23,Default,,0,0,0,,Нууууууууууу...
Dialogue: 0,0:14:24.32,0:14:26.03,Default,,0,0,0,,Ммммм!
Dialogue: 0,0:14:27.15,0:14:30.03,Default,,0,0,0,,Жарайды, екі иықты алып тастаңыз, сонда шыға аласыз. Хехе!
Dialogue: 0,0:14:30.03,0:14:30.74,Default,,0,0,0,,Жарайды, екі иықты алып тастаңыз, сонда шыға аласыз. Хехе!
Dialogue: 0,0:14:30.03,0:14:30.74,Default,,0,0,0,,(түйінген буын дыбысы)
Dialogue: 0,0:14:30.74,0:14:30.82,Default,,0,0,0,,(түйінген буын дыбысы)
Dialogue: 0,0:14:30.82,0:14:31.41,Default,,0,0,0,,(түйінген буындардың дыбысы)
Dialogue: 0,0:14:30.82,0:14:31.41,Default,,0,0,0,,Сіз мұны істей аласыз ба!
Dialogue: 0,0:14:31.41,0:14:31.91,Default,,0,0,0,,Сіз мұны істей аласыз ба!
Dialogue: 0,0:14:31.99,0:14:34.95,Default,,0,0,0,,Қат! Бұл жерден кетудің жолы жоқ па?
Dialogue: 0,0:14:35.04,0:14:37.50,Default,,0,0,0,,Мен сындыратын нәрсені іздеймін.
Dialogue: 0,0:14:37.58,0:14:41.21,Default,,0,0,0,,Мен өзім бірдеңе істеймін, сондықтан Ашипа-санды тауып ал!
Dialogue: 0,0:14:41.29,0:14:45.21,Default,,0,0,0,,Егер сіз Ашипа-санды қорғай алсаңыз, негізгі қақпада күтіңіз.
Dialogue: 0,0:14:45.30,0:14:48.47,Default,,0,0,0,,Мен Ашипа-сан, Ширайшиден сұраймын.
Dialogue: 0,0:14:48.55,0:14:52.97,Default,,0,0,0,,«Сиркемен өзін-өзі өлтіру оқиғасы»
Dialogue: 0,0:15:02.56,0:15:05.73,Default,,0,0,0,,Міне! Бұл оқу залы болған соң...
Dialogue: 0,0:15:06.48,0:15:11.82,Default,,0,0,0,,Инудо күнделікті жаттығуға келіп-кетеді, сондықтан мен бұл жерді күдікті деп ойладым, бірақ...
Dialogue: 0,0:15:12.70,0:15:17.95,Default,,0,0,0,,Кадокура қанша тергесе де, Нопперабоның жасырын бөлмесін таба алмады.
Dialogue: 0,0:15:18.04,0:15:19.96,Default,,0,0,0,,Ача осында, солай ма?
Dialogue: 0,0:15:20.04,0:15:24.21,Default,,0,0,0,,Инудо Нопперабоны жылжытқан сәтті ұстаңыз
Dialogue: 0,0:15:24.29,0:15:27.59,Default,,0,0,0,,(атыс дыбысы)
Dialogue: 0,0:15:27.67,0:15:29.59,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:15:29.67,0:15:31.26,Default,,0,0,0,,Уф... Ха... (Хиджиката) Жақсысың ба?
Dialogue: 0,0:15:31.34,0:15:33.14,Default,,0,0,0,,Ғимаратқа тез кіріңіз
Dialogue: 0,0:15:33.22,0:15:35.10,Default,,0,0,0,,Құлағымның қалқаны ауырып тұр... (Хиджиката) Иә!?
Dialogue: 0,0:15:35.18,0:15:37.97,Default,,0,0,0,,Менде Ашипа (Тотан) жоқ па?
Dialogue: 0,0:15:39.06,0:15:42.02,Default,,0,0,0,,Сіз Сугимотоға оралдыңыз ба?
Dialogue: 0,0:15:42.10,0:15:46.57,Default,,0,0,0,,Мен Нопперабоның қайда екенін білген бойда ол жоғалып кетті.
Dialogue: 0,0:15:46.65,0:15:49.32,Default,,0,0,0,,Әй, неткен батыл қыз.
Dialogue: 0,0:15:49.40,0:15:50.53,Default,,0,0,0,,Мен сені қайтаруым керек пе?
Dialogue: 0,0:15:50.61,0:15:54.62,Default,,0,0,0,,Жоқ, мен қазір Инудоның қашып кетуіне жол бере алмаймын.
Dialogue: 0,0:15:54.70,0:15:58.66,Default,,0,0,0,,Сендірудің жалғыз жолы осы ма?
Dialogue: 0,0:16:00.12,0:16:02.04,Default,,0,0,0,,(Ашипаның ауыр тыныс алуы)
Dialogue: 0,0:16:03.37,0:16:04.54,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:04.63,0:16:05.88,Default,,0,0,0,,Тыныш!?
Dialogue: 0,0:16:05.96,0:16:07.80,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:16:07.88,0:16:09.55,Default,,0,0,0,,А... А...
Dialogue: 0,0:16:10.13,0:16:12.80,Default,,0,0,0,,Әй, Ширайши! (Ширайши) Әй, Ашипа-чан!
Dialogue: 0,0:16:12.88,0:16:13.84,Default,,0,0,0,,Сугимото ше?
Dialogue: 0,0:16:13.93,0:16:16.30,Default,,0,0,0,,Камера еденінің астында қалған
Dialogue: 0,0:16:16.39,0:16:18.85,Default,,0,0,0,,Желдету саңылауының тар болғаны сонша, тек мен ғана шыға алатынмын.
Dialogue: 0,0:16:18.93,0:16:21.31,Default,,0,0,0,,Ха! (Ширайши) Тоқта, күт, барма.
Dialogue: 0,0:16:21.39,0:16:22.89,Default,,0,0,0,,Солдаттар барлық жерде
Dialogue: 0,0:16:22.98,0:16:23.94,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:16:24.02,0:16:26.81,Default,,0,0,0,,Жарайды, мен Сугимотоға көмектесейін.
Dialogue: 0,0:16:27.86,0:16:30.61,Default,,0,0,0,,Сугимотоны соборға әкеліңіз.
Dialogue: 0,0:16:30.69,0:16:33.45,Default,,0,0,0,,Тосизо Хиджиката Нопперабоның сонда екенін айтады.
Dialogue: 0,0:16:33.53,0:16:35.78,Default,,0,0,0,,Онда да барма.
Dialogue: 0,0:16:35.86,0:16:39.16,Default,,0,0,0,,Сугимото Ашипа-чаннан басты қақпада күтуді өтінді.
Dialogue: 0,0:16:39.24,0:16:42.66,Default,,0,0,0,,Жоқ, мен сенімен кездесіп, бұл Ача екенін білуім керек.
Dialogue: 0,0:16:42.75,0:16:45.71,Default,,0,0,0,,Хиджикатаға қайтып оралуға болмайды.
Dialogue: 0,0:16:45.79,0:16:49.67,Default,,0,0,0,,Әлгі қарт Ашипа-чанды Сугимотодан ажыратпақ болды.
Dialogue: 0,0:16:49.75,0:16:52.17,Default,,0,0,0,,Ах... Сугимотодан?
Dialogue: 0,0:16:52.26,0:16:55.55,Default,,0,0,0,,Сугимотоға көмектескеннен кейін соборға барыңыз.
Dialogue: 0,0:16:55.63,0:16:58.10,Default,,0,0,0,,Әйтеуір Нопперабоны бас қақпаға әкел
Dialogue: 0,0:16:58.18,0:16:59.18,Default,,0,0,0,,Күте тұрыңыз! иә?
Dialogue: 0,0:17:00.10,0:17:01.68,Default,,0,0,0,,Мұны Сугимотоға беріңіз
Dialogue: 0,0:17:01.77,0:17:07.77,Default,,0,0,0,,(Барлық шайқастардың дауыстары)
Dialogue: 0,0:17:15.28,0:17:19.28,Default,,0,0,0,,Ngggggg... Иығымды қалай алып тастаймын!
Dialogue: 0,0:17:19.37,0:17:20.20,Default,,0,0,0,,Сугимото!
Dialogue: 0,0:17:20.28,0:17:21.79,Default,,0,0,0,,Кироранке!
Dialogue: 0,0:17:22.29,0:17:25.58,Default,,0,0,0,,Сен ақымақсың ба? Сіз шығуға мүмкіндік жоқ.
Dialogue: 0,0:17:25.66,0:17:26.71,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:17:27.37,0:17:30.21,Default,,0,0,0,,Қабырға мен топырақтың арасына гранатаны толтыру
Dialogue: 0,0:17:30.29,0:17:31.21,Default,,0,0,0,,Иә!?
Dialogue: 0,0:17:33.09,0:17:35.42,Default,,0,0,0,,Е! өзіңді бір жерге жасыр
Dialogue: 0,0:17:35.51,0:17:37.22,Default,,0,0,0,,Иә! Сәл күте тұрыңыз...
Dialogue: 0,0:17:38.30,0:17:39.72,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:40.35,0:17:42.60,Default,,0,0,0,,Не? осу?
Dialogue: 0,0:17:45.81,0:17:48.85,Default,,0,0,0,,Соборда?
Dialogue: 0,0:17:48.94,0:17:51.48,Default,,0,0,0,,Ашипа мұны Нопперабоға көрсетуімді өтінді.
Dialogue: 0,0:17:51.57,0:17:52.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:52.82,0:17:56.49,Default,,0,0,0,,Бұл Ашипаның Макирисі
Dialogue: 0,0:17:56.57,0:17:59.24,Default,,0,0,0,,Әкем жасаған макири...
Dialogue: 0,0:17:59.32,0:18:03.37,Default,,0,0,0,,Негізгі қақпада күтіңіз. Жалғыз Ширайши үшін уайымдаймын.
Dialogue: 0,0:18:03.87,0:18:05.62,Default,,0,0,0,,Мен Нопперабоны әкелемін.
Dialogue: 0,0:18:06.25,0:18:09.25,Default,,0,0,0,,Ашипа-санға айтыңыз, мен онымен міндетті түрде кездесемін.
Dialogue: 0,0:18:09.33,0:18:10.88,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:18:27.60,0:18:29.02,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:29.77,0:18:31.81,Default,,0,0,0,,Қарғыс атсын! Уф... (қылыштың шаншу дыбысы)
Dialogue: 0,0:18:32.94,0:18:36.82,Default,,0,0,0,,Кууууууу... (Кохеи) Ууууу!
Dialogue: 0,0:18:43.95,0:18:45.83,Default,,0,0,0,,Мен төменнен бірдеңені естіп тұрмын.
Dialogue: 0,0:18:46.62,0:18:49.08,Default,,0,0,0,,Жертөле болды ма?
Dialogue: 0,0:18:53.17,0:18:57.84,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:59.42,0:19:00.34,Default,,0,0,0,,Шығыңыз
Dialogue: 0,0:19:01.80,0:19:05.10,Default,,0,0,0,,Мен Инудоның көзін жұлып аламын.
Dialogue: 0,0:19:17.99,0:19:19.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:30.75,0:19:31.83,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:19:38.30,0:19:39.76,Default,,0,0,0,,Хамф!
Dialogue: 0,0:19:40.92,0:19:42.09,Default,,0,0,0,,Уф
Dialogue: 0,0:19:47.26,0:19:49.60,Default,,0,0,0,,Өлім бізді бөлгенше...
Dialogue: 0,0:19:54.44,0:19:56.11,Default,,0,0,0,,Яаааааа!
Dialogue: 0,0:19:56.86,0:19:57.86,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:19:59.69,0:20:00.86,Default,,0,0,0,,Кууу! (Кохи) Уау...
Dialogue: 0,0:20:00.94,0:20:02.11,Default,,0,0,0,,Иә! (Кохи) Арх...
Dialogue: 0,0:20:02.20,0:20:03.74,Default,,0,0,0,,Ахх...
Dialogue: 0,0:20:03.82,0:20:05.49,Default,,0,0,0,,Уф! Апыр-ай!
Dialogue: 0,0:20:09.58,0:20:10.50,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:10.58,0:20:12.12,Default,,0,0,0,,Мен білмейтін қыз…➡
Dialogue: 0,0:20:12.21,0:20:13.58,Default,,0,0,0,,Хамф!
Dialogue: 0,0:20:14.92,0:20:16.34,Default,,0,0,0,,Аһ!
Dialogue: 0,0:20:16.42,0:20:17.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:18.42,0:20:22.09,Default,,0,0,0,,Йохай! Сугимото сонда барады!
Dialogue: 0,0:20:22.17,0:20:23.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:24.76,0:20:26.43,Default,,0,0,0,,Сәлем! (Кохи) Ах...
Dialogue: 0,0:20:26.51,0:20:29.68,Default,,0,0,0,,(Кохеидің ыңырсыуы)
Dialogue: 0,0:20:29.77,0:20:30.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:31.43,0:20:34.06,Default,,0,0,0,,Әй, қарашы, біреу құлап қалыпты. (Солдат) Ах!
Dialogue: 0,0:20:34.14,0:20:37.56,Default,,0,0,0,,Бұл Никайдо. (Солдат) Сен тірісің бе?
Dialogue: 0,0:20:41.65,0:20:44.11,Default,,0,0,0,,Нопперабо…
Dialogue: 0,0:20:44.20,0:20:48.08,Default,,0,0,0,,Ашипа-санмен кездесуге рұқсат етіңізші! Ашипа-санға...
Dialogue: 0,0:20:48.16,0:20:49.83,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:50.33,0:20:52.08,Default,,0,0,0,,Тоқта, біреу келе жатыр (Ашипа) А...
Dialogue: 0,0:20:53.16,0:20:54.58,Default,,0,0,0,,Ушияма және басқалар
Dialogue: 0,0:20:57.96,0:20:59.88,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:59.96,0:21:01.09,Default,,0,0,0,,Киро-чан!
Dialogue: 0,0:21:01.67,0:21:02.59,Default,,0,0,0,,Сугимото ше?
Dialogue: 0,0:21:02.67,0:21:07.26,Default,,0,0,0,,Мен оны камерадан құтқардым, бірақ соборға жалғыз бардым.
Dialogue: 0,0:21:07.34,0:21:10.10,Default,,0,0,0,,Нопперабо Ашипамен кездескеніне көз жеткізіңіз.
Dialogue: 0,0:21:10.18,0:21:11.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:11.68,0:21:14.73,Default,,0,0,0,,Хиджиката мен Инудо да оқу залында болса керек.
Dialogue: 0,0:21:15.39,0:21:16.81,Default,,0,0,0,,Кеттік
Dialogue: 0,0:21:17.65,0:21:19.23,Default,,0,0,0,,Бармау керек.
Dialogue: 0,0:21:19.82,0:21:20.98,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:21.82,0:21:22.99,Default,,0,0,0,,Inkaㇻma
Dialogue: 0,0:21:24.03,0:21:27.07,Default,,0,0,0,,Сіз биік жерден көре аласыз
Dialogue: 0,0:21:33.83,0:21:37.75,Default,,0,0,0,,Уф... мм...
Dialogue: 0,0:21:37.83,0:21:41.25,Default,,0,0,0,,А... Ммм!
Dialogue: 0,0:21:41.34,0:21:44.76,Default,,0,0,0,,Ха... ха... Ах!
Dialogue: 0,0:21:48.34,0:21:50.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:56.85,0:21:58.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:59.40,0:22:00.98,Default,,0,0,0,,Көк көздер!
Dialogue: 0,0:22:03.11,0:22:08.11,Default,,0,0,0,,♪~
Dialogue: 0,0:23:27.32,0:23:32.95,Default,,0,0,0,,~♪
Dialogue: 0,0:23:34.45,0:23:40.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory