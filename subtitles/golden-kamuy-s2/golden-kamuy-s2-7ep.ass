Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.92,0:00:12.09,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:00:21.89,0:00:24.23,Default,,0,0,0,,Ол жақын жерде емес сияқты.
Dialogue: 0,0:00:24.89,0:00:26.94,Default,,0,0,0,,7-ші бөлімнің жігіттері де.
Dialogue: 0,0:00:27.02,0:00:29.69,Default,,0,0,0,,Біз күткендей ауа-райында жүре алмадық.
Dialogue: 0,0:00:29.77,0:00:33.03,Default,,0,0,0,,Мен үйге барамын деп ойламаймын.
Dialogue: 0,0:00:33.11,0:00:34.65,Default,,0,0,0,,Олар бізбіз.
Dialogue: 0,0:00:34.74,0:00:37.99,Default,,0,0,0,,Егер сіз таудан Абашириге қарай түссеңіз, оны оқи алуыңыз керек.
Dialogue: 0,0:00:38.07,0:00:40.58,Default,,0,0,0,,Мен таң қалдым да, Токачи бағытында таудан төмен түстім.
Dialogue: 0,0:00:40.66,0:00:42.04,Default,,0,0,0,,Қуғыншыларыңызды жабыңыз
Dialogue: 0,0:00:42.12,0:00:43.58,Default,,0,0,0,,Мұны істейік
Dialogue: 0,0:00:43.66,0:00:45.62,Default,,0,0,0,,Кироранке Нипа және басқалар үшін
Dialogue: 0,0:00:45.71,0:00:48.67,Default,,0,0,0,,Екеуміз ажырассақ, мен саған Абашириде кездесейік дедім.
Dialogue: 0,0:00:52.01,0:00:54.17,Default,,0,0,0,,Шекараның жағдайын сұрау
Dialogue: 0,0:00:54.26,0:00:57.39,Default,,0,0,0,,Мен Юбариден шыққанда Отаруға телеграмма жібердім.
Dialogue: 0,0:00:58.22,0:01:01.35,Default,,0,0,0,,Сіз осы пошта бөлімшесінен жауап алуыңыз керек еді.
Dialogue: 0,0:01:01.43,0:01:02.72,Default,,0,0,0,,Кімнен?
Dialogue: 0,0:01:03.73,0:01:05.02,Default,,0,0,0,,Ол Ашипаның ағасы.
Dialogue: 0,0:01:05.85,0:01:08.94,Default,,0,0,0,,Ол адам Казутомен жұмыс істеген.
Dialogue: 0,0:01:09.02,0:01:10.86,Default,,0,0,0,,Сауаттылығы шамалы
Dialogue: 0,0:01:12.19,0:01:13.94,Default,,0,0,0,,Онда не айтылған?
Dialogue: 0,0:01:14.03,0:01:17.61,Default,,0,0,0,,“  ”
Dialogue: 0,0:01:18.16,0:01:20.33,Default,,0,0,0,,Райкурсиюк дегеніміз не?
Dialogue: 0,0:01:20.87,0:01:23.62,Default,,0,0,0,,“Likeㇽshiyuㇰ” – өлім костюмі
Dialogue: 0,0:01:23.70,0:01:24.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:26.21,0:01:29.33,Default,,0,0,0,,Айну қарт өзінің өлімінің жақын екенін сезді.
Dialogue: 0,0:01:29.96,0:01:33.96,Default,,0,0,0,,Жанұясынан жасырынып, өлім киімін өзі дайындайды.
Dialogue: 0,0:01:35.72,0:01:37.80,Default,,0,0,0,,Неге олай дедің?
Dialogue: 0,0:01:38.93,0:01:42.43,Default,,0,0,0,,Мен жаңа ғана сәуегей болғанымды айттым.
Dialogue: 0,0:01:42.51,0:01:45.68,Default,,0,0,0,,Ашипа-санның айналасында сатқындар бар.
Dialogue: 0,0:01:47.94,0:01:50.06,Default,,0,0,0,,Шет сенің өлгеніңді қаламаймын
Dialogue: 0,0:01:50.86,0:01:53.78,Default,,0,0,0,,Фучи де маған тамақ берді.
Dialogue: 0,0:01:53.86,0:01:55.99,Default,,0,0,0,,Айну үшін балалар маңызды.
Dialogue: 0,0:01:56.69,0:02:00.16,Default,,0,0,0,,Балаң болмаса, ол дүниеге бара алмайсың.
Dialogue: 0,0:02:00.78,0:02:02.95,Default,,0,0,0,,Айну өлгенде
Dialogue: 0,0:02:03.03,0:02:05.70,Default,,0,0,0,,Артта қалғандарға жіберу рәсімі болмаса.
Dialogue: 0,0:02:05.79,0:02:08.37,Default,,0,0,0,,Сіз ақырет өміріне бара алмайсыз.
Dialogue: 0,0:02:10.75,0:02:14.21,Default,,0,0,0,,Сондықтан баламды өз балам болмаса да тәрбиелеуге бар күшімді саламын.
Dialogue: 0,0:02:17.76,0:02:20.59,Default,,0,0,0,,Cikapasi Уайымдамаңыз
Dialogue: 0,0:02:21.85,0:02:24.47,Default,,0,0,0,,Ашипаны үйге аман-есен жеткізіңіз.
Dialogue: 0,0:02:24.56,0:02:26.60,Default,,0,0,0,,Шеттерін жандандыру
Dialogue: 0,0:02:26.68,0:02:28.35,Default,,0,0,0,,Бұл менің рөлім.
Dialogue: 0,0:02:28.43,0:02:30.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:30.10,0:02:32.19,Default,,0,0,0,,Мен оны Фучиге де жедім.
Dialogue: 0,0:02:32.81,0:02:34.23,Default,,0,0,0,,Мен де шекаралық баламын.
Dialogue: 0,0:02:34.32,0:02:38.03,Default,,0,0,0,,Жоқ, жоқ, Танигаки Нипа сутенер.
Dialogue: 0,0:02:38.11,0:02:39.28,Default,,0,0,0,,Бұл жол.
Dialogue: 0,0:02:39.36,0:02:41.99,Default,,0,0,0,,(Чикапаши және басқалардың күлкісі)
Dialogue: 0,0:02:51.83,0:02:54.29,Default,,0,0,0,,Мен іздеген рөл...
Dialogue: 0,0:02:58.09,0:03:03.09,Default,,0,0,0,,♪~
Dialogue: 0,0:04:22.92,0:04:27.93,Default,,0,0,0,,~♪
Dialogue: 0,0:04:34.35,0:04:36.10,Default,,0,0,0,,Лейтенант Цуруми.
Dialogue: 0,0:04:36.19,0:04:38.73,Default,,0,0,0,,«Канемочи» деген не екенін білесіз бе?
Dialogue: 0,0:04:39.73,0:04:42.90,Default,,0,0,0,,Біз Ани Матагидің шұғыл тағамын қолдандық.
Dialogue: 0,0:04:42.99,0:04:47.07,Default,,0,0,0,,Дөңгелек бір және сопақша жасап, оларды жұптастыру.
Dialogue: 0,0:04:47.78,0:04:49.53,Default,,0,0,0,,Дөңгелек зат – күн
Dialogue: 0,0:04:49.62,0:04:52.20,Default,,0,0,0,,Сопақ айды білдіреді.
Dialogue: 0,0:04:52.29,0:04:56.33,Default,,0,0,0,,Канемочи? Мен мұны білмедім.
Dialogue: 0,0:04:56.42,0:04:58.96,Default,,0,0,0,,Оның дәмі қандай? Бұл қалыпты мочи ме?
Dialogue: 0,0:04:59.92,0:05:03.67,Default,,0,0,0,,Күріш ұнына су қосып, мисо немесе тұзбен араластырыңыз.
Dialogue: 0,0:05:03.76,0:05:05.76,Default,,0,0,0,,Жақсылап илеп, жапырақпен орап аламыз.
Dialogue: 0,0:05:05.84,0:05:08.51,Default,,0,0,0,,Көздің күлімен буланған нәрсе.
Dialogue: 0,0:05:09.05,0:05:13.27,Default,,0,0,0,,Айтпақшы, Тозава Матагиде канемочимен мисоға қатаң тыйым салынған.
Dialogue: 0,0:05:13.35,0:05:16.69,Default,,0,0,0,,Ауылға байланысты айырмашылықтар бар ма?
Dialogue: 0,0:05:18.69,0:05:21.02,Default,,0,0,0,,Өйткені әкем байсалды, шулы.
Dialogue: 0,0:05:21.11,0:05:23.82,Default,,0,0,0,,Ешкімге айтпадым, құпия ұстадым.
Dialogue: 0,0:05:23.90,0:05:29.95,Default,,0,0,0,,Шындығында, мен жейтін канемочиге қосымша күш қостым.
Dialogue: 0,0:05:30.03,0:05:34.00,Default,,0,0,0,,Бірақ бір күні менің Матеги достарымның бірі білді.
Dialogue: 0,0:05:34.08,0:05:36.79,Default,,0,0,0,,Хахахаха қалай?
Dialogue: 0,0:05:36.87,0:05:38.29,Default,,0,0,0,,Біз, Матаги,
Dialogue: 0,0:05:38.37,0:05:42.05,Default,,0,0,0,,Мен бөкенді қуып бара жатқанымда «Аошиши» деп атадым.
Dialogue: 0,0:05:43.30,0:05:46.55,Default,,0,0,0,,Бірнеше Матаги бар, олардың әрқайсысы рөлді шешеді.
Dialogue: 0,0:05:46.63,0:05:48.97,Default,,0,0,0,,Біз бірге маки аулаймыз
Dialogue: 0,0:05:50.34,0:05:51.39,Default,,0,0,0,,«Мұқайматте» деп аталады.
Dialogue: 0,0:05:51.47,0:05:54.02,Default,,0,0,0,,Жалпы нұсқаулар беретін күзетші
Dialogue: 0,0:05:54.56,0:05:57.14,Default,,0,0,0,,«Мацумай» атты екі атқыш
Dialogue: 0,0:05:57.23,0:06:00.19,Default,,0,0,0,,Мылтыққа әлі ие бола алмайтын екі «секо» бар.
Dialogue: 0,0:06:01.06,0:06:05.57,Default,,0,0,0,,Секоның рөлі - олжаны атыс алдында қатты дауыстап айдау.
Dialogue: 0,0:06:06.53,0:06:08.86,Default,,0,0,0,,Хорея! Бәйбіше!
Dialogue: 0,0:06:09.41,0:06:11.57,Default,,0,0,0,,Аю Матеги «Итазу» деп атайды
Dialogue: 0,0:06:11.66,0:06:14.29,Default,,0,0,0,,Өйткені олардың қашып, тауға шығу әдеті бар.
Dialogue: 0,0:06:14.37,0:06:17.04,Default,,0,0,0,,Секо шыңға жетеді, бірақ
Dialogue: 0,0:06:17.12,0:06:20.33,Default,,0,0,0,,Тау басынан қуылған көк ала маралда керісінше.
Dialogue: 0,0:06:20.42,0:06:25.76,Default,,0,0,0,,Мен Секо кезімде өзімнен бір жас үлкен Кенкичи Аояма деген адамды кездестірдім.
Dialogue: 0,0:06:25.84,0:06:29.59,Default,,0,0,0,,Біз шыңға жеткенде кенет ауа райы өзгерді.
Dialogue: 0,0:06:32.64,0:06:36.35,Default,,0,0,0,,Біз тасты үңгірді паналадық, бірақ қарлы боран жалғасты.
Dialogue: 0,0:06:36.43,0:06:39.10,Default,,0,0,0,,Бірнеше күн қозғала алмайды
Dialogue: 0,0:06:39.19,0:06:43.19,Default,,0,0,0,,Өзіммен бірге алып келген қуырылған бұршақ пен күріш тез таусылды.
Dialogue: 0,0:06:44.02,0:06:47.44,Default,,0,0,0,,Канемочи - мұндай уақытта жейтін соңғы тағам.
Dialogue: 0,0:06:48.28,0:06:52.12,Default,,0,0,0,,Қанша салқын болса да, ол қатып қалмайды және оңай сақталады.
Dialogue: 0,0:06:52.20,0:06:55.33,Default,,0,0,0,,Аз ғана тістеп алсаңыз да тәбетіңіз ашылады.
Dialogue: 0,0:06:59.50,0:07:00.79,Default,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:07:00.87,0:07:01.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:02.04,0:07:03.25,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:03.33,0:07:04.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:05.46,0:07:09.13,Default,,0,0,0,,Бұл менің соңғы тамағым болуы мүмкін деп ойладым.
Dialogue: 0,0:07:09.22,0:07:11.38,Default,,0,0,0,,Ха, сіз қалжыңдап тұрсыз.
Dialogue: 0,0:07:11.47,0:07:14.55,Default,,0,0,0,,Гендзироның етін жесең де, аман қалуың керек.
Dialogue: 0,0:07:18.22,0:07:19.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:19.43,0:07:22.77,Default,,0,0,0,,Эй, сен мына Канемочимен бірдеңе араластырдың ба?
Dialogue: 0,0:07:22.85,0:07:23.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:24.36,0:07:26.36,Default,,0,0,0,,Бұл не? бұл дәм
Dialogue: 0,0:07:26.44,0:07:29.40,Default,,0,0,0,,Күтіп отырмаңдар, мен болжаймын.
Dialogue: 0,0:07:29.49,0:07:31.90,Default,,0,0,0,,Хмм... бұл...
Dialogue: 0,0:07:33.99,0:07:38.37,Default,,0,0,0,,Түсіндім, бұл жаңғақ! Жаңғақпен араласқан ба? Гендзиро
Dialogue: 0,0:07:38.45,0:07:43.08,Default,,0,0,0,,Бірақ Кенкичи, өтінемін, үндемеңіз.
Dialogue: 0,0:07:43.17,0:07:46.38,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:07:47.88,0:07:49.71,Default,,0,0,0,,Сәлем, Гэндзиро
Dialogue: 0,0:07:49.80,0:07:51.05,Default,,0,0,0,,​​О?
Dialogue: 0,0:07:52.38,0:07:54.26,Default,,0,0,0,,Сіз тірі оралуыңыз керек.
Dialogue: 0,0:07:56.43,0:07:57.68,Default,,0,0,0,,Иә
Dialogue: 0,0:08:10.28,0:08:15.24,Default,,0,0,0,,Кенкичи содан кейін менің әпкем Фумиге үйленді.
Dialogue: 0,0:08:15.32,0:08:17.74,Default,,0,0,0,,Біз өгей ағайынды болдық
Dialogue: 0,0:08:17.83,0:08:19.12,Default,,0,0,0,,О
Dialogue: 0,0:08:20.29,0:08:21.62,Default,,0,0,0,,Фуми және Кенкичи
Dialogue: 0,0:08:21.70,0:08:25.67,Default,,0,0,0,,Ауылдан шалғайдағы таудың сәл жоғарырақ жерінде
Dialogue: 0,0:08:25.75,0:08:27.75,Default,,0,0,0,,Тыныш өмір сүрді
Dialogue: 0,0:08:31.71,0:08:35.93,Default,,0,0,0,,Сол күні де мен үйде канемочи пісіріп жүрдім.
Dialogue: 0,0:08:36.76,0:08:41.27,Default,,0,0,0,,Сырттан ағам бұрын көрмеген жүзбен оралды...
Dialogue: 0,0:08:41.35,0:08:42.56,Default,,0,0,0,,​​О?
Dialogue: 0,0:08:42.64,0:08:44.23,Default,,0,0,0,,Фуми!
Dialogue: 0,0:08:44.31,0:08:46.73,Default,,0,0,0,,Ағамды сырттай көру
Dialogue: 0,0:08:46.81,0:08:49.57,Default,,0,0,0,,Арқасынан мұзбен пышақталғандай болды.
Dialogue: 0,0:08:49.65,0:08:51.86,Default,,0,0,0,,(Танигакидің ауыр тыныс алуы)
Dialogue: 0,0:08:52.74,0:08:54.07,Default,,0,0,0,,Мен барған кезде
Dialogue: 0,0:08:54.70,0:08:58.03,Default,,0,0,0,,Фуми мен Кенкичи тұрған саятшылық бұрыннан...
Dialogue: 0,0:08:59.33,0:09:02.91,Default,,0,0,0,,(Танигакидің ауыр тыныс алуы)
Dialogue: 0,0:09:08.54,0:09:09.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:10.04,0:09:14.80,Default,,0,0,0,,Ішінде Фумидің денесі күйіп кеткен қара түсті.
Dialogue: 0,0:09:14.88,0:09:16.38,Default,,0,0,0,,Онсыз…
Dialogue: 0,0:09:17.72,0:09:19.72,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:19.80,0:09:22.52,Default,,0,0,0,,Не болды!? Фуми!
Dialogue: 0,0:09:23.47,0:09:24.31,Default,,0,0,0,,Ха...
Dialogue: 0,0:09:25.60,0:09:28.81,Default,,0,0,0,,Жүрек тұсында пышақ жарақаты бар.
Dialogue: 0,0:09:31.98,0:09:33.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:34.03,0:09:37.70,Default,,0,0,0,,Жақын жерде Кенкичидің «Масуке»
Dialogue: 0,0:09:38.20,0:09:42.83,Default,,0,0,0,,Біз Маске деп атайтын қысқа қылыш – Матағының жаны.
Dialogue: 0,0:09:43.45,0:09:47.46,Default,,0,0,0,,Кеңкіші еш жерде көрінбеді.
Dialogue: 0,0:09:50.08,0:09:51.59,Default,,0,0,0,,Кенкичи қайда!?
Dialogue: 0,0:09:51.67,0:09:53.84,Default,,0,0,0,,Мұнда бір рет болса да келме!
Dialogue: 0,0:09:53.92,0:09:54.96,Default,,0,0,0,,Маған үзіліс беріңіз!
Dialogue: 0,0:09:55.05,0:09:57.38,Default,,0,0,0,,Мені жасырма!?
Dialogue: 0,0:09:57.47,0:09:59.89,Default,,0,0,0,,(Кенкичидің анасының айқайы)
Dialogue: 0,0:10:00.72,0:10:05.22,Default,,0,0,0,,Мен оны қатты іздедім, бірақ таба алмадым.
Dialogue: 0,0:10:05.77,0:10:07.94,Default,,0,0,0,,Бірақ бір күні
Dialogue: 0,0:10:08.02,0:10:11.69,Default,,0,0,0,,Кенкичидің Хоккайдодағы 7-ші дивизияға қосылғаны айтылады.
Dialogue: 0,0:10:11.77,0:10:13.73,Default,,0,0,0,,Сыбыс келді.
Dialogue: 0,0:10:15.23,0:10:16.86,Default,,0,0,0,,Тоқта, Джендзиро.
Dialogue: 0,0:10:17.49,0:10:19.82,Default,,0,0,0,,Кек алу үшін Аниден бас тартпа
Dialogue: 0,0:10:19.91,0:10:23.08,Default,,0,0,0,,Өз өміріңізге қауіп төндірмеңіз
Dialogue: 0,0:10:25.87,0:10:27.25,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:28.37,0:10:30.46,Default,,0,0,0,,Әпкемді өлтіргеннен кейін жылап, ұйықтап қалмаймын!
Dialogue: 0,0:10:31.42,0:10:33.46,Default,,0,0,0,,Матеги, блять!
Dialogue: 0,0:10:33.54,0:10:35.13,Default,,0,0,0,,Ешқашан артқа оралмаңыз
Dialogue: 0,0:10:36.63,0:10:40.97,Default,,0,0,0,,Хоккайдода 37 Тонденхай ауылы болды.
Dialogue: 0,0:10:41.05,0:10:46.14,Default,,0,0,0,,Әскери дайындық пен ауылшаруашылық жұмыстарының арасында мен Кеңкішінің жатқан жерін іздедім.
Dialogue: 0,0:10:46.85,0:10:49.02,Default,,0,0,0,,Мен оны таба алмадым.
Dialogue: 0,0:10:51.40,0:10:56.07,Default,,0,0,0,,Мен соғысқа аттанар алдында ағам анамның қайтыс болғанын хабарлады.
Dialogue: 0,0:10:57.49,0:10:59.45,Default,,0,0,0,,Фумидің қатыгез өлімі
Dialogue: 0,0:10:59.53,0:11:02.87,Default,,0,0,0,,Туған жеріңді тастап, соғысқа аттану
Dialogue: 0,0:11:02.95,0:11:05.95,Default,,0,0,0,,Мен әр күнімді жылаумен, уайыммен өткіземін.
Dialogue: 0,0:11:06.04,0:11:09.04,Default,,0,0,0,,Денесі әлсіреп, оңай өлетін сияқты.
Dialogue: 0,0:11:11.75,0:11:16.96,Default,,0,0,0,,Бәріне Кеңкіші жауапты деп өшпенділігін арттырды.
Dialogue: 0,0:11:17.59,0:11:22.18,Default,,0,0,0,,Тонден сарбаздары жиналатын Лушунға барсаңыз, Кеңкіші табасыз.
Dialogue: 0,0:11:22.26,0:11:24.68,Default,,0,0,0,,Шайқастың қызған шағында тапсаң
Dialogue: 0,0:11:26.26,0:11:28.39,Default,,0,0,0,,Мен сені арқаңнан атып жіберемін
Dialogue: 0,0:11:29.02,0:11:31.19,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:11:31.27,0:11:35.69,Default,,0,0,0,,Сен оған тек құрал ғана болдың…
Dialogue: 0,0:11:40.99,0:11:42.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:42.82,0:11:43.91,Default,,0,0,0,,Я...
Dialogue: 0,0:11:44.53,0:11:45.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:46.53,0:11:50.58,Default,,0,0,0,,Құм салынған дорбаның бұрышында тыртық киген адам отырды.
Dialogue: 0,0:11:51.75,0:11:53.79,Default,,0,0,0,,Өз қаны немесе қайтарылған қан?
Dialogue: 0,0:11:53.87,0:11:57.38,Default,,0,0,0,,Оның қараңғылығы сонша, мен оның бетін де ажырата алмадым.
Dialogue: 0,0:11:57.46,0:11:59.42,Default,,0,0,0,,Широдасуки
Dialogue: 0,0:12:00.55,0:12:04.43,Default,,0,0,0,,Бұл адам кешегі жанкешті топтан аман қалған.
Dialogue: 0,0:12:05.14,0:12:06.64,Default,,0,0,0,,Жақсы өмір сүр...
Dialogue: 0,0:12:08.81,0:12:10.81,Default,,0,0,0,,Сізде жейтін нәрсе бар ма?
Dialogue: 0,0:12:10.89,0:12:11.93,Default,,0,0,0,,О...
Dialogue: 0,0:12:12.48,0:12:14.19,Default,,0,0,0,,Ах... ах
Dialogue: 0,0:12:14.90,0:12:15.81,Default,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:12:15.90,0:12:17.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:18.07,0:12:19.40,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:19.94,0:12:20.90,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:12:24.57,0:12:26.07,Default,,0,0,0,,Оның күшті денесі бар.
Dialogue: 0,0:12:26.16,0:12:29.99,Default,,0,0,0,,Бұл... мочи ме? Оның дәмі мисо сияқты
Dialogue: 0,0:12:30.08,0:12:31.83,Default,,0,0,0,,Бұл Акитаның жергілікті тағамдары ма?
Dialogue: 0,0:12:31.91,0:12:32.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:33.54,0:12:34.92,Default,,0,0,0,,Неліктен Акита?
Dialogue: 0,0:12:35.00,0:12:36.79,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:12:36.88,0:12:39.75,Default,,0,0,0,,Себебі сіз «ke» дедіңіз.
Dialogue: 0,0:12:39.84,0:12:41.51,Default,,0,0,0,,Бұл «жеу» дегенді білдіретін диалект сөз, солай ма?
Dialogue: 0,0:12:42.30,0:12:44.63,Default,,0,0,0,,Мен сияқты 1-дивизияның бір взводында.
Dialogue: 0,0:12:44.72,0:12:45.93,Default,,0,0,0,,Акитадағы Ани деген жерде дүниеге келген бірінші сыныпты бітіруші болған.
Dialogue: 0,0:12:45.93,0:12:47.34,Default,,0,0,0,,Акитадағы Ани деген жерде дүниеге келген бірінші сыныпты бітірген.
Dialogue: 0,0:12:45.93,0:12:47.34,Default,,0,0,0,,Ха...
Dialogue: 0,0:12:47.34,0:12:48.60,Default,,0,0,0,,Акитадағы Ани деген жерде дүниеге келген бірінші сыныпты бітіруші болған.
Dialogue: 0,0:12:48.68,0:12:50.72,Default,,0,0,0,,Ол кісі маған сабақ берді
Dialogue: 0,0:12:50.81,0:12:55.10,Default,,0,0,0,,Токиоға келгенге дейін жергілікті аңшы болып жұмыс істегеніңізді естідім.
Dialogue: 0,0:12:55.60,0:12:56.98,Default,,0,0,0,,Кенкичи
Dialogue: 0,0:12:58.44,0:13:01.23,Default,,0,0,0,,Ақыры апамның жауын таптым.
Dialogue: 0,0:13:03.11,0:13:07.82,Default,,0,0,0,,Кенкичи Хоккайдоға емес, Токиоға қашты.
Dialogue: 0,0:13:08.45,0:13:11.58,Default,,0,0,0,,203 таулы жерде кімдер шайқасты?
Dialogue: 0,0:13:11.66,0:13:16.46,Default,,0,0,0,,Хоккайдо 7-ші дивизион Шикоку 11-ші дивизион
Dialogue: 0,0:13:16.54,0:13:21.55,Default,,0,0,0,,Канадзава 9-шы дивизиясы және Токио 1-ші дивизиясы
Dialogue: 0,0:13:21.63,0:13:22.80,Default,,0,0,0,,Иә
Dialogue: 0,0:13:23.42,0:13:28.05,Default,,0,0,0,,Құдай маған әпкемнің кекін жоюға көмектесті.
Dialogue: 0,0:13:28.14,0:13:29.64,Default,,0,0,0,,Мен осылай сезіндім
Dialogue: 0,0:13:30.39,0:13:33.43,Default,,0,0,0,,Мен бірден барып тексергім келді.
Dialogue: 0,0:13:33.52,0:13:37.35,Default,,0,0,0,,Кеңкішінің түрін көргенде, жанымнан табылдым.
Dialogue: 0,0:13:38.15,0:13:42.36,Default,,0,0,0,,Ұрыс қызған кезде осы кек сапарымызды аяқтаймыз.
Dialogue: 0,0:13:42.44,0:13:44.61,Default,,0,0,0,,Тыныштық сақталды
Dialogue: 0,0:13:45.49,0:13:46.99,Default,,0,0,0,,Бірақ сол жер
Dialogue: 0,0:13:47.78,0:13:49.99,Default,,0,0,0,,Шын мәнінде емес
Dialogue: 0,0:13:50.66,0:13:55.20,Default,,0,0,0,,Кеңкішіні іздеуге мүмкіндігім жоқ еді.
Dialogue: 0,0:13:56.00,0:13:57.62,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:59.17,0:14:02.88,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:02.96,0:14:05.34,Default,,0,0,0,,Орыс солдаты граната лақтырса да
Dialogue: 0,0:14:06.01,0:14:07.88,Default,,0,0,0,,Бұл бірден кері қайтарылады
Dialogue: 0,0:14:07.97,0:14:08.93,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:14:10.47,0:14:11.72,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:11.72,0:14:13.85,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:11.72,0:14:13.85,Default,,0,0,0,,Орыс солдаттары ақырын бұрышқа тығылды.
Dialogue: 0,0:14:14.72,0:14:17.35,Default,,0,0,0,,Денеге байланған бірнеше граната
Dialogue: 0,0:14:17.43,0:14:20.06,Default,,0,0,0,,Біздің окопқа секірді
Dialogue: 0,0:14:20.15,0:14:22.77,Default,,0,0,0,,Мен бұған ғашық болдым.
Dialogue: 0,0:14:22.86,0:14:27.28,Default,,0,0,0,,Бір орыс солдаты 10-ға жуық адамды өлтірді.
Dialogue: 0,0:14:28.07,0:14:29.61,Default,,0,0,0,,Және тағы бір адам
Dialogue: 0,0:14:29.70,0:14:31.07,Default,,0,0,0,,Оны тоқтатыңыз!
Dialogue: 0,0:14:31.16,0:14:32.37,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:14:32.45,0:14:35.45,Default,,0,0,0,,Маған 30 жастағы екі-үш оқ тиіп кетсе де.
Dialogue: 0,0:14:35.54,0:14:36.79,Default,,0,0,0,,Бұл тоқтаған жоқ.
Dialogue: 0,0:14:36.87,0:14:38.91,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:14:39.00,0:14:42.17,Default,,0,0,0,,Сол кезде жақын маңдағы окоптан
Dialogue: 0,0:14:42.25,0:14:44.67,Default,,0,0,0,,Бір адам секіріп кетті.
Dialogue: 0,0:14:50.22,0:14:51.51,Default,,0,0,0,,Кенкичи!
Dialogue: 0,0:14:51.59,0:14:53.05,Default,,0,0,0,,Ууууууууууу!
Dialogue: 0,0:14:53.14,0:14:54.01,Default,,0,0,0,,Уф! (Орыс солдаты) Гах...
Dialogue: 0,0:14:54.10,0:14:55.47,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:15:01.40,0:15:05.52,Default,,0,0,0,,Кеңкіші әрең тірі еді.
Dialogue: 0,0:15:08.69,0:15:13.37,Default,,0,0,0,,Ақырында, сіз күткен сәт те келді.
Dialogue: 0,0:15:13.45,0:15:15.37,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:15:15.45,0:15:17.04,Default,,0,0,0,,Сәлем Кенкичи
Dialogue: 0,0:15:17.66,0:15:19.83,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:15:19.91,0:15:22.00,Default,,0,0,0,,Мен сенің жүрегіңді ойып аламын!
Dialogue: 0,0:15:22.08,0:15:24.75,Default,,0,0,0,,Сіз Фумиге жасағаныңыздай!
Dialogue: 0,0:15:26.38,0:15:28.76,Default,,0,0,0,,Танигаки! Бұл енді жақсы емес
Dialogue: 0,0:15:28.84,0:15:32.51,Default,,0,0,0,,Сіз мені ести алмайсыз. Мүмкін сіздің құлақ қалқаныңыз да зақымдалған шығар!
Dialogue: 0,0:15:32.59,0:15:35.97,Default,,0,0,0,,(Танигакидің ауыр тыныс алуы)
Dialogue: 0,0:15:36.06,0:15:38.06,Default,,0,0,0,,Ух... у... а...
Dialogue: 0,0:15:38.14,0:15:41.77,Default,,0,0,0,,(Танигакидің ауыр тыныс алуы)
Dialogue: 0,0:15:41.85,0:15:43.52,Default,,0,0,0,,Фуми... (Танигаки) Ах...
Dialogue: 0,0:15:44.06,0:15:45.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:54.37,0:15:59.16,Default,,0,0,0,,Бұл кезде шайқас тығырыққа тірелді.
Dialogue: 0,0:15:59.24,0:16:02.29,Default,,0,0,0,,Аймақ біртүрлі тыныштық орнады.
Dialogue: 0,0:16:04.17,0:16:05.54,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:06.96,0:16:09.34,Default,,0,0,0,,Ешқандай мен Фумиді өлтірген жоқпын! Кенкичи!
Dialogue: 0,0:16:09.42,0:16:13.51,Default,,0,0,0,,Сіз кімсіз? Сіз...
Dialogue: 0,0:16:13.59,0:16:14.89,Default,,0,0,0,,Ха...
Dialogue: 0,0:16:16.51,0:16:22.14,Default,,0,0,0,,Мен сіз туралы білмеймін, бірақ маған бір нәрсе айтқым келеді.
Dialogue: 0,0:16:22.23,0:16:24.44,Default,,0,0,0,,Ани, Акита қаласында тұрады
Dialogue: 0,0:16:24.52,0:16:27.40,Default,,0,0,0,,Танигаки есімді адамға
Dialogue: 0,0:16:27.48,0:16:28.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:29.69,0:16:34.49,Default,,0,0,0,,Мен Танигаки отбасынан бір қызды әйелім етіп алдым.
Dialogue: 0,0:16:35.74,0:16:40.54,Default,,0,0,0,,Әйелімнің сұлу болғаны сонша, мен үшін босқа кетті.
Dialogue: 0,0:16:41.45,0:16:45.83,Default,,0,0,0,,Тыныш өмір сүрдік, тек екеуміз, таудың тереңінде.
Dialogue: 0,0:16:46.54,0:16:48.00,Default,,0,0,0,,Бір күні әйелім
Dialogue: 0,0:16:48.96,0:16:50.59,Default,,0,0,0,,Мен шешекпен ауырдым
Dialogue: 0,0:16:50.67,0:16:52.09,Default,,0,0,0,,Ха...
Dialogue: 0,0:16:53.51,0:16:58.60,Default,,0,0,0,,Тыныштық пен үндеме.
Dialogue: 0,0:16:58.68,0:16:59.76,Default,,0,0,0,,Фуми…
Dialogue: 0,0:17:00.39,0:17:05.06,Default,,0,0,0,,Сөйлессең, мен уайымдап, міндетті түрде осында келемін.
Dialogue: 0,0:17:05.14,0:17:07.23,Default,,0,0,0,,Егер бұл Уцуши болса...
Dialogue: 0,0:17:07.31,0:17:09.02,Default,,0,0,0,,Фуми…
Dialogue: 0,0:17:09.57,0:17:12.90,Default,,0,0,0,,Сен де... Мұнда бара алмайсың.
Dialogue: 0,0:17:12.99,0:17:15.20,Default,,0,0,0,,Не... не айтып тұрсың?
Dialogue: 0,0:17:15.82,0:17:17.87,Default,,0,0,0,,Өлгенде бірге боламыз
Dialogue: 0,0:17:19.87,0:17:23.08,Default,,0,0,0,,Егер сіздің отбасыңыз тауда шешекпен ауырса.
Dialogue: 0,0:17:23.16,0:17:26.96,Default,,0,0,0,,Мен оны жұқтырудан қорқып сарайға қалдырамын.
Dialogue: 0,0:17:27.04,0:17:29.84,Default,,0,0,0,,Мен мұны өзім жасай алмадым
Dialogue: 0,0:17:30.88,0:17:34.26,Default,,0,0,0,,Тастанды үйге аң кіреді
Dialogue: 0,0:17:34.34,0:17:39.72,Default,,0,0,0,,Бірде науқас адам қарсы тұра алмай жеп қойған оқиғаны естідім.
Dialogue: 0,0:17:40.97,0:17:45.35,Default,,0,0,0,,Мен Фумидің жалғыз және жалғыз өлуіне жол бере алмаймын.
Dialogue: 0,0:17:45.43,0:17:48.19,Default,,0,0,0,,Бірақ Фуми мені кешірмеді.
Dialogue: 0,0:17:49.73,0:17:53.61,Default,,0,0,0,,Егер Танигаки тұқымдасының бір мүшесі шешекпен ауыратынын білсек.
Dialogue: 0,0:17:53.69,0:17:57.11,Default,,0,0,0,,Ауылда ешкім саған жақындамайды.
Dialogue: 0,0:17:57.20,0:18:03.16,Default,,0,0,0,,Қалған барлық Матегилер енді әкелерімен және ағаларымен аң ауламайды.
Dialogue: 0,0:18:03.91,0:18:06.25,Default,,0,0,0,,Барлығы осында келгенше
Dialogue: 0,0:18:06.33,0:18:10.75,Default,,0,0,0,,Оны өлтіріп, ауылдан кетуімді қалады.
Dialogue: 0,0:18:10.83,0:18:13.21,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:18:14.17,0:18:20.51,Default,,0,0,0,,Шешектен өзгерген бетін шүберекпен жасырып, маған былай дейді:
Dialogue: 0,0:18:20.59,0:18:23.72,Default,,0,0,0,,``Егер жұқтырмаған болса''
Dialogue: 0,0:18:24.26,0:18:25.89,Default,,0,0,0,,Өмір
Dialogue: 0,0:18:24.26,0:18:25.89,Default,,0,0,0,,«Сол өмір...»
Dialogue: 0,0:18:27.18,0:18:33.48,Default,,0,0,0,,Оны қалай пайдалану керек... Өз рөліңізді табыңыз...
Dialogue: 0,0:18:33.57,0:18:36.99,Default,,0,0,0,,Ах... Фуми
Dialogue: 0,0:18:39.24,0:18:43.45,Default,,0,0,0,,Ақырында мен Фумиді таптым...
Dialogue: 0,0:18:45.16,0:18:48.12,Default,,0,0,0,,Мүмкіндігінше азаптан аулақ болу
Dialogue: 0,0:18:48.21,0:18:50.50,Default,,0,0,0,,Бірге ойланған соң
Dialogue: 0,0:18:50.58,0:18:55.46,Default,,0,0,0,,Мен аңшымын, сондықтан өзім үйренген әдістерді қолдандым.
Dialogue: 0,0:19:01.18,0:19:05.51,Default,,0,0,0,,Фуми маған айтқандай, мен саятшылықты өртеп жібердім.
Dialogue: 0,0:19:05.60,0:19:09.64,Default,,0,0,0,,Фуми қайтыс болғанын отбасына айтпай-ақ
Dialogue: 0,0:19:09.73,0:19:12.23,Default,,0,0,0,,Мен ауылдан шықтым
Dialogue: 0,0:19:12.94,0:19:17.53,Default,,0,0,0,,Бүгінге дейін... Мен Фумиді өлтіргенім үшін кінәлімін.
Dialogue: 0,0:19:17.61,0:19:19.57,Default,,0,0,0,,Мен жұмсадым
Dialogue: 0,0:19:20.28,0:19:25.78,Default,,0,0,0,,Қарызымның кесірінен қайтыс болған отбасының ұзақ уақыт азап шегуіне себепкер болдым.
Dialogue: 0,0:19:26.95,0:19:30.25,Default,,0,0,0,,Аз да болса жарамды емдесем
Dialogue: 0,0:19:31.37,0:19:34.67,Default,,0,0,0,,Өтінемін... мына оқиғаны айтып беріңізші.
Dialogue: 0,0:19:34.75,0:19:38.30,Default,,0,0,0,,Акита, Ани қаласында тұратын Танигаки мырзаға...
Dialogue: 0,0:19:39.17,0:19:40.42,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:19:49.27,0:19:50.81,Default,,0,0,0,,Ха...
Dialogue: 0,0:19:53.35,0:19:56.61,Default,,0,0,0,,Грек жаңғағы қосылған канемочи...
Dialogue: 0,0:19:58.53,0:20:00.15,Default,,0,0,0,,Гендзиро?
Dialogue: 0,0:20:04.28,0:20:08.91,Default,,0,0,0,,Осыны айтып, Кеңкіші соңғы демін алды.
Dialogue: 0,0:20:13.04,0:20:14.08,Default,,0,0,0,,Кенкичи
Dialogue: 0,0:20:14.75,0:20:18.38,Default,,0,0,0,,Мен өз рөлімді тауып, өмірімді пайдаландым.
Dialogue: 0,0:20:18.92,0:20:23.84,Default,,0,0,0,,Мен ойнау үшін дүниеге келген рөлім туралы күнде ойлаймын.
Dialogue: 0,0:20:24.64,0:20:26.80,Default,,0,0,0,,Мен енді Аниге қайтып бара алмаймын.
Dialogue: 0,0:20:27.60,0:20:30.35,Default,,0,0,0,,Әкем мен ағама ұқсайтын түрім жоқ.
Dialogue: 0,0:20:31.93,0:20:33.48,Default,,0,0,0,,Танигаки
Dialogue: 0,0:20:34.02,0:20:36.40,Default,,0,0,0,,Маған сен керексің
Dialogue: 0,0:20:36.48,0:20:38.15,Default,,0,0,0,,Ха...
Dialogue: 0,0:20:40.11,0:20:43.28,Default,,0,0,0,,Мен үшін бірінші
Dialogue: 0,0:20:43.36,0:20:47.12,Default,,0,0,0,,Сіз маған жаңғақ қосылған канемочи жасай аласыз ба?
Dialogue: 0,0:20:51.87,0:20:53.79,Default,,0,0,0,,Бұл арзан.
Dialogue: 0,0:21:07.97,0:21:09.39,Default,,0,0,0,,Әй, мынаны қара!
Dialogue: 0,0:21:09.47,0:21:10.31,Default,,0,0,0,,Ах
Dialogue: 0,0:21:10.39,0:21:12.89,Default,,0,0,0,,Алыстан біреу билеп жатыр
Dialogue: 0,0:21:12.98,0:21:14.64,Default,,0,0,0,,Бұл Ашипа емес пе?
Dialogue: 0,0:21:14.73,0:21:16.06,Default,,0,0,0,,О...
Dialogue: 0,0:21:16.60,0:21:18.56,Default,,0,0,0,,♪ Фунтуори
Dialogue: 0,0:21:18.65,0:21:22.23,Default,,0,0,0,,♪ Хунчикахаа хооооо
Dialogue: 0,0:21:22.32,0:21:24.15,Default,,0,0,0,,♪ Хой Ху
Dialogue: 0,0:21:24.24,0:21:28.03,Default,,0,0,0,,Аа, Куширода қалған би осы ма?
Dialogue: 0,0:21:28.12,0:21:31.45,Default,,0,0,0,,«Цуру но Май» салоны көтерілуі
Dialogue: 0,0:21:31.54,0:21:32.87,Default,,0,0,0,,♪ Хант Охи
Dialogue: 0,0:21:32.95,0:21:36.79,Default,,0,0,0,,♪ Хунчикахаа хооооо
Dialogue: 0,0:21:36.87,0:21:38.71,Default,,0,0,0,,♪ Хой Ху
Dialogue: 0,0:21:38.79,0:21:40.63,Default,,0,0,0,,Хмм... біреу келе жатыр.
Dialogue: 0,0:21:40.71,0:21:41.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:42.46,0:21:44.01,Default,,0,0,0,,(Ашипаның тырнаның айғайына еліктеу)
Dialogue: 0,0:21:44.63,0:21:45.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:48.01,0:21:50.64,Default,,0,0,0,,Қараңызшы, бұл Ашипа ғой!
Dialogue: 0,0:21:51.85,0:21:55.98,Default,,0,0,0,,Цикапаси, Хироннуп және Танигаки.
Dialogue: 0,0:21:57.27,0:21:58.73,Default,,0,0,0,,Неге...
Dialogue: 0,0:22:02.98,0:22:08.36,Default,,0,0,0,,♪~
Dialogue: 0,0:23:27.86,0:23:32.95,Default,,0,0,0,,~♪
Dialogue: 0,0:23:34.45,0:23:40.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory