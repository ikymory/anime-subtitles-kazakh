Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:36.08,0:01:38.08,Default,,0,0,0,,Жою және құру
Dialogue: 0,0:01:40.04,0:01:43.03,Default,,0,0,0,,Адамдар неліктен қайталайды?
Dialogue: 0,0:01:44.07,0:01:47.01,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:01:52.01,0:01:55.05,Default,,0,0,0,,Адамдардың есте сақтау қабілеті нашар.
Dialogue: 0,0:01:56.00,0:01:58.03,Default,,0,0,0,,Ендеше көркейтіп, кеңейе бер
Dialogue: 0,0:01:59.00,0:02:03.03,Default,,0,0,0,,Ауырсынуды сағынышқа айналдырып, өткенді жеңуге тырысу
Dialogue: 0,0:02:04.06,0:02:07.00,Default,,0,0,0,,Мен анамды қайтаруға тырыстым
Dialogue: 0,0:02:07.05,0:02:09.01,Default,,0,0,0,,Естеліктерге байланысты ма?
Dialogue: 0,0:02:11.06,0:02:15.07,Default,,0,0,0,,Бұл қазіргі қиындықтарды жою.
Dialogue: 0,0:02:16.04,0:02:18.08,Default,,0,0,0,,Сіз жұлдыз тыртықтары туралы айтып отырсыз ба?
Dialogue: 0,0:02:19.05,0:02:22.03,Default,,0,0,0,,Бірақ басында бәрі сен кінәлі.
Dialogue: 0,0:02:24.04,0:02:25.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:26.05,0:02:30.06,Default,,0,0,0,,Сіз де есте сақтауда жақсы емессіз.
Dialogue: 0,0:02:32.01,0:02:34.06,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:02:35.04,0:02:37.09,Default,,0,0,0,,Нағыз ұмытшақ
Dialogue: 0,0:02:53.01,0:02:54.04,Default,,0,0,0,,Цен мырза!
Dialogue: 0,0:02:54.07,0:02:56.00,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:03:00.03,0:03:01.05,Default,,0,0,0,,Бұл хит.
Dialogue: 0,0:03:02.05,0:03:04.05,Default,,0,0,0,,...Бұл жиіркенішті.
Dialogue: 0,0:03:05.08,0:03:08.02,Default,,0,0,0,,Жарайды, асығыңыз.
Dialogue: 0,0:03:08.02,0:03:09.09,Default,,0,0,0,,Лено Таноми
Dialogue: 0,0:03:10.06,0:03:11.09,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:27.07,0:03:28.09,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:03:29.04,0:03:31.01,Default,,0,0,0,,Сенпай, тезірек!
Dialogue: 0,0:03:33.06,0:03:34.06,Default,,0,0,0,,Сенпай!
Dialogue: 0,0:03:35.01,0:03:36.07,Default,,0,0,0,,Бұл кім!?
Dialogue: 0,0:03:40.01,0:03:40.51,Default,,0,0,0,,Депрессия
Dialogue: 0,0:03:41.08,0:03:42.07,Default,,0,0,0,,Ирина!
Dialogue: 0,0:03:44.03,0:03:46.00,Default,,0,0,0,,Жүр!
Dialogue: 0,0:03:55.03,0:03:56.03,Default,,0,0,0,,Цен мырза!
Dialogue: 0,0:04:41.08,0:04:43.08,Default,,0,0,0,,Өмір ағыны
Dialogue: 0,0:04:44.06,0:04:48.04,Default,,0,0,0,,Бұл жұлдыздардың айналасындағы тіршілік ағымы
Dialogue: 0,0:04:48.07,0:04:53.05,Default,,0,0,0,,Бұл жұлдыздардың және оларда тіршілік ететін барлық тіршіліктің қайнар көзі.
Dialogue: 0,0:04:54.09,0:04:58.03,Default,,0,0,0,,Shinra Company Lifestream құрды.
Dialogue: 0,0:04:58.04,0:05:02.00,Default,,0,0,0,,Ресурс ретінде пайдаланудың жолын тапты
Dialogue: 0,0:05:02.03,0:05:05.08,Default,,0,0,0,,Соның арқасында біздің өміріміз
Dialogue: 0,0:05:06.00,0:05:08.02,Default,,0,0,0,,Мен өте бай болдым.
Dialogue: 0,0:05:08.08,0:05:13.00,Default,,0,0,0,,Бірақ бұл жұлдыздың өмірін қысқарту дегенді білдіреді.
Dialogue: 0,0:05:13.01,0:05:16.02,Default,,0,0,0,,Көп адамдар осылай ойлады.
Dialogue: 0,0:05:17.09,0:05:21.08,Default,,0,0,0,,Шинра оларға қарсы шыққандарды жояды.
Dialogue: 0,0:05:22.00,0:05:24.06,Default,,0,0,0,,Күшпен тежеуге тырысты
Dialogue: 0,0:05:25.06,0:05:30.09,Default,,0,0,0,,Шинраның солдат I деп аталатын арнайы сарбаздары болды.
Dialogue: 0,0:05:31.04,0:05:34.08,Default,,0,0,0,,Баяғыда аспаннан түскен
Dialogue: 0,0:05:34.09,0:05:37.08,Default,,0,0,0,,Бұл планетаны жоюға тырысқан апат
Dialogue: 0,0:05:38.03,0:05:41.08,Default,,0,0,0,,Бұл Йенова жасушалары имплантацияланған адамдар.
Dialogue: 0,0:05:42.08,0:05:45.08,Default,,0,0,0,,Олардың ішінде Сефирот бар.
Dialogue: 0,0:05:45.09,0:05:48.09,Default,,0,0,0,,Өте дарынды жауынгер болған.
Dialogue: 0,0:05:50.00,0:05:54.08,Default,,0,0,0,,Бірақ мен қорқынышты экспериментте туғанымды білдім.
Dialogue: 0,0:05:54.09,0:05:57.07,Default,,0,0,0,,Мен Шинраны жек көріп кеттім.
Dialogue: 0,0:05:58.01,0:06:03.01,Default,,0,0,0,,Ал мен мұны білмей тұрып, бәрін жек көре бастадым.
Dialogue: 0,0:06:04.08,0:06:08.08,Default,,0,0,0,,Шинра және оған қарсы шыққандар
Dialogue: 0,0:06:09.06,0:06:14.09,Default,,0,0,0,,Сефишу өшпенділіктен планетаны жоюға тырысады.
Dialogue: 0,0:06:15.06,0:06:18.02,Default,,0,0,0,,Сефиротты тоқтатуға тырысатын адамдар
Dialogue: 0,0:06:19.00,0:06:21.09,Default,,0,0,0,,Көптеген шайқастар болды
Dialogue: 0,0:06:23.02,0:06:27.00,Default,,0,0,0,,Қанша шайқас болса, сонша қайғы болды.
Dialogue: 0,0:06:27.09,0:06:33.04,Default,,0,0,0,,Мен сүйген адам да менің өмірімнің бір бөлігіне айналды.
Dialogue: 0,0:06:35.06,0:06:38.00,Default,,0,0,0,,Және сол күні
Dialogue: 0,0:06:38.04,0:06:39.08,Default,,0,0,0,,Тағдырлы күн
Dialogue: 0,0:06:40.03,0:06:45.04,Default,,0,0,0,,Барлық шайқастарды жұлдыздардың өз күшімен аяқтады.
Dialogue: 0,0:06:46.07,0:06:51.04,Default,,0,0,0,,Жұлдыз өмір ағынын қару ретінде пайдаланды.
Dialogue: 0,0:06:52.04,0:06:55.04,Default,,0,0,0,,Жерге ұшып кеткен күріш пен шоқ
Dialogue: 0,0:06:55.06,0:06:59.03,Default,,0,0,0,,Жанжал Амбиция Қайғылылық
Dialogue: 0,0:06:59.04,0:07:02.01,Default,,0,0,0,,Мен бәрін жұтып қойдым.
Dialogue: 0,0:07:06.00,0:07:10.01,Default,,0,0,0,,Қайғыға айырбас, бәрі бітті.
Dialogue: 0,0:07:10.02,0:07:13.05,Default,,0,0,0,,Бұл маған екі жыл бұрын айтылған болатын.
Dialogue: 0,0:08:11.04,0:08:12.08,Default,,0,0,0,,Ей, кеттік
Dialogue: 0,0:08:13.00,0:08:13.50,Default,,0,0,0,,Иә
Dialogue: 0,0:08:15.03,0:08:16.07,Default,,0,0,0,,Уау, бұл қауіпті.
Dialogue: 0,0:08:34.03,0:08:36.02,Default,,0,0,0,,Бірақ... жұлдыздар
Dialogue: 0,0:08:36.04,0:08:41.08,Default,,0,0,0,,Сіз біз ойлағаннан әлдеқайда ашуланған сияқтысыз.
Dialogue: 0,0:08:46.05,0:08:48.08,Default,,0,0,0,,Жұлдыздық тыртық синдромы
Dialogue: 0,0:08:52.08,0:08:54.05,Default,,0,0,0,,Сәлем, теңізші?
Dialogue: 0,0:08:54.08,0:08:56.01,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:08:59.06,0:09:01.01,Default,,0,0,0,,Жарайды, мен кеттім. Қош бол.
Dialogue: 0,0:09:01.02,0:09:04.08,Default,,0,0,0,,Дензелді қабылдамаңыз.
Dialogue: 0,0:09:12.02,0:09:15.06,Default,,0,0,0,,Тергеу комиссиясының бүгін таңертең жарияланған есебіне сәйкес.
Dialogue: 0,0:09:15.07,0:09:20.01,Default,,0,0,0,,Атмосферадағы тіршілік ағынының концентрациясы екі жыл бұрынғыдан шамамен 1/100 құрайды.
Dialogue: 0,0:09:20.02,0:09:24.00,Default,,0,0,0,,Деңгейі адам ағзасына әсер етпейтін деңгейге дейін төмендеді дейді.
Dialogue: 0,0:09:24.03,0:09:25.09,Default,,0,0,0,,Дегенмен, Shinra компаниясының бас кеңсесінің ғимараты
Dialogue: 0,0:09:26.00,0:09:28.05,Default,,0,0,0,,Ол енді мұнда емес.
Dialogue: 0,0:09:29.01,0:09:30.09,Default,,0,0,0,,...әлі де қауіпті деңгейде
Dialogue: 0,0:09:31.00,0:09:33.09,Default,,0,0,0,,Жұлдыз тыртықтарының пайда болуын болдырмау үшін нысанның айналасындағы аумақ болуы керек
Dialogue: 0,0:09:34.01,0:09:37.06,Default,,0,0,0,,Комитет сізге алыс болуды ескертеді.
Dialogue: 0,0:09:38.07,0:09:42.09,Default,,0,0,0,,Төменде Shinra компаниясына қарсы өтемақы талап етуіне қатысты жаңалықтар берілген.
Dialogue: 0,0:09:45.04,0:09:46.07,Default,,0,0,0,,Бұлт
Dialogue: 0,0:09:47.01,0:09:48.09,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:10:01.05,0:10:03.09,Default,,0,0,0,,Иә, бұл өмірді жеткізу қызметі.
Dialogue: 0,0:10:04.00,0:10:05.04,Default,,0,0,0,,Біздің компания кез келген нәрсені жасай алады.
Dialogue: 0,0:10:07.01,0:10:09.00,Default,,0,0,0,,...Сен қайсысысың?
Dialogue: 0,0:10:14.06,0:10:16.06,Default,,0,0,0,,есімде.
Dialogue: 0,0:10:37.09,0:10:40.02,Default,,0,0,0,,Маған Хириндегі Рено қоңырау шалды.
Dialogue: 0,0:10:40.04,0:10:42.01,Default,,0,0,0,,Тіпті жұмысқа сұраныс
Dialogue: 0,0:10:42.03,0:10:44.08,Default,,0,0,0,,Бұлт... қалдарың қалай?
Dialogue: 0,0:10:45.05,0:10:47.08,Default,,0,0,0,,Осының бәрі хабар үшін
Dialogue: 0,0:11:56.09,0:12:00.06,Default,,0,0,0,,Әй, бұл менің ағамның қаласы ма?
Dialogue: 0,0:12:01.07,0:12:02.06,Default,,0,0,0,,О
Dialogue: 0,0:12:03.02,0:12:05.07,Default,,0,0,0,,Олар сізді қарсы алады деп ойлайсыз ба?
Dialogue: 0,0:12:05.08,0:12:06.06,Default,,0,0,0,,Ақылға қонымсыз
Dialogue: 0,0:12:06.09,0:12:08.07,Default,,0,0,0,,Жылама, Язу
Dialogue: 0,0:12:09.05,0:12:11.08,Default,,0,0,0,,Сенің анаң да осында емес пе?
Dialogue: 0,0:12:13.02,0:12:14.08,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:12:15.05,0:12:16.09,Default,,0,0,0,,Жылама, Таяқтар
Dialogue: 0,0:12:23.04,0:12:25.04,Default,,0,0,0,,Қарашы, бұл менің ағам.
Dialogue: 0,0:13:05.01,0:13:06.09,Default,,0,0,0,,Менің анам қайда?
Dialogue: 0,0:13:11.05,0:13:13.03,Default,,0,0,0,,Сенің ағаң жасырып жатыр, солай ма?
Dialogue: 0,0:13:22.07,0:13:25.04,Default,,0,0,0,,Сіз мені алдаған шығарсыз?
Dialogue: 0,0:13:25.08,0:13:27.08,Default,,0,0,0,,Сенің анаң солай ғой, солай ма?
Dialogue: 0,0:13:29.01,0:13:30.07,Default,,0,0,0,,Айқайламаңыз
Dialogue: 0,0:13:32.07,0:13:34.08,Default,,0,0,0,,Мен сенімен сөйлескім келмейді
Dialogue: 0,0:13:36.03,0:13:38.00,Default,,0,0,0,,Президент атынан
Dialogue: 0,0:15:02.00,0:15:04.01,Default,,0,0,0,,Сіз қашып кетпедіңіз ғой?
Dialogue: 0,0:15:08.05,0:15:11.09,Default,,0,0,0,,Эй, бұл Баррет! Мен оны істедім! Жаңа мұнай кен орны!
Dialogue: 0,0:15:12.01,0:15:15.05,Default,,0,0,0,,Юден! Ол сондай үлкен!
Dialogue: 0,0:15:15.06,0:15:18.08,Default,,0,0,0,,Енді менде жоспар бар, мен жақында Маринді көремін!
Dialogue: 0,0:15:18.09,0:15:20.08,Default,,0,0,0,,Айтыңызшы.
Dialogue: 0,0:15:24.07,0:15:26.08,Default,,0,0,0,,Леноның тағы бір күн күркіреуі туралы әңгімесі.
Dialogue: 0,0:15:27.02,0:15:28.09,Default,,0,0,0,,Тезірек.
Dialogue: 0,0:15:29.05,0:15:33.02,Default,,0,0,0,,Оның бойында біртүрлі нәрсе болды... бірақ абай болыңыз.
Dialogue: 0,0:15:56.00,0:15:57.01,Default,,0,0,0,,Урия~~
Dialogue: 0,0:16:02.06,0:16:04.05,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:16:13.07,0:16:15.07,Default,,0,0,0,,Людо! керемет!
Dialogue: 0,0:16:24.01,0:16:27.03,Default,,0,0,0,,Өзін-өзі жариялаған бұрынғы жауынгер күткендей.
Dialogue: 0,0:16:35.08,0:16:38.00,Default,,0,0,0,,Сіздің қолыңыз түтіккен сияқты емес.
Dialogue: 0,0:16:45.00,0:16:46.07,Default,,0,0,0,,Бұл Руфусна ма?
Dialogue: 0,0:16:48.00,0:16:49.04,Default,,0,0,0,,Сіз де жазылмайсыз.
Dialogue: 0,0:16:54.09,0:16:55.08,Default,,0,0,0,,Сол күні I
Dialogue: 0,0:16:55.09,0:16:56.08,Default,,0,0,0,,Мен саған не үшін керекпін?
Dialogue: 0,0:16:56.09,0:16:57.07,Default,,0,0,0,,Ғимарат құламас бұрын...
Dialogue: 0,0:16:57.08,0:16:58.09,Default,,0,0,0,,Маған кім шабуыл жасады?
Dialogue: 0,0:16:59.00,0:17:00.05,Default,,0,0,0,,38-тарау: Алтын тәжірибе · Реквием Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,0:17:03.08,0:17:05.08,Default,,0,0,0,,...Маған сенің көмегің керек.
Dialogue: 0,0:17:06.00,0:17:11.05,Default,,0,0,0,,Мені қызықтырмайды. Біз, Шинра компаниясы, әлем алдында үлкен қарыздармыз.
Dialogue: 0,0:17:11.09,0:17:15.00,Default,,0,0,0,,Дүниені осы бейшара күйге жеткізген алым
Dialogue: 0,0:17:15.01,0:17:18.01,Default,,0,0,0,,Бізде бар деуден пайда жоқ.
Dialogue: 0,0:17:18.03,0:17:22.02,Default,,0,0,0,,Сондықтан бұл қарыз барлық шығындармен өтелуі керек.
Dialogue: 0,0:17:22.03,0:17:23.04,Default,,0,0,0,,Оны ашыңыз.
Dialogue: 0,0:17:23.06,0:17:25.04,Default,,0,0,0,,Бірінші қадам ретінде
Dialogue: 0,0:17:25.07,0:17:29.03,Default,,0,0,0,,Біз Сефишу қалдырған ықпалды зерттей бастадық.
Dialogue: 0,0:17:30.05,0:17:32.00,Default,,0,0,0,,Содан бері екі жыл өтті
Dialogue: 0,0:17:32.03,0:17:36.09,Default,,0,0,0,,Қалпына келу жолына түскен әлем үшін ең үлкен қауіп қандай?
Dialogue: 0,0:17:38.03,0:17:43.09,Default,,0,0,0,,Дұрыс, жиіркенішті жұлдыз тыртық синдромы.
Dialogue: 0,0:17:44.07,0:17:49.06,Default,,0,0,0,,Себебі Сефимандарда жатыр деп есептейміз.
Dialogue: 0,0:17:51.02,0:17:54.09,Default,,0,0,0,,Дүниеде сиқырлы қуық пеші және сиқырлы қуық энергиясы
Dialogue: 0,0:17:55.00,0:17:59.01,Default,,0,0,0,,Ал өмір кеңістігі жұлдыз тыртықтарының себебі деп есептеледі.
Dialogue: 0,0:17:59.05,0:18:02.02,Default,,0,0,0,,Бірақ шынымен солай ма?
Dialogue: 0,0:18:02.04,0:18:05.06,Default,,0,0,0,,Өмір ағымдары жұлдыздардың тууымен бірге болады.
Dialogue: 0,0:18:05.06,0:18:09.08,Default,,0,0,0,,Сиқырлы энергияның практикалық қолданысқа енгізілгеніне 40 жылдан астам уақыт өтті.
Dialogue: 0,0:18:10.00,0:18:11.07,Default,,0,0,0,,қарамастан
Dialogue: 0,0:18:11.08,0:18:15.01,Default,,0,0,0,,Жұлдыздық белгілер тарихта ешқашан пайда болмайды.
Dialogue: 0,0:18:15.09,0:18:16.09,Default,,0,0,0,,Сонымен
Dialogue: 0,0:18:17.03,0:18:21.00,Default,,0,0,0,,Біздің уақытта нақты не болды?
Dialogue: 0,0:18:21.04,0:18:23.07,Default,,0,0,0,,Бір ғана мүмкіндік бар
Dialogue: 0,0:18:24.05,0:18:26.01,Default,,0,0,0,,Сефирот пайда болады.
Dialogue: 0,0:18:26.03,0:18:27.04,Default,,0,0,0,,Сефирот өлді
Dialogue: 0,0:18:27.05,0:18:29.06,Default,,0,0,0,,Оның ақыл-ойы қалай?
Dialogue: 0,0:18:30.03,0:18:32.01,Default,,0,0,0,,Өмір ағымына балқу
Dialogue: 0,0:18:32.02,0:18:36.03,Default,,0,0,0,,Бірақ егер ол таралмай жұлдыздарды айналып жүрсе ше?
Dialogue: 0,0:18:38.02,0:18:42.01,Default,,0,0,0,,Әрине бұл менің қиялым ғана.
Dialogue: 0,0:18:42.03,0:18:45.03,Default,,0,0,0,,Бірақ бұл мүмкіндікті жоққа шығаруға болмайды
Dialogue: 0,0:18:45.08,0:18:49.04,Default,,0,0,0,,Шындықты білу жұлдызды тыртықтарды емдеуге әкеледі.
Dialogue: 0,0:18:50.03,0:18:52.03,Default,,0,0,0,,Сонымен, біз...
Dialogue: 0,0:18:52.04,0:18:55.05,Default,,0,0,0,,Сефироттың іздерін зерттеуді бастады.
Dialogue: 0,0:18:55.07,0:18:57.00,Default,,0,0,0,,Ең алдымен
Dialogue: 0,0:18:58.04,0:19:00.00,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:19:00.01,0:19:02.02,Default,,0,0,0,,Бұл солтүстіктегі үлкен үңгір.
Dialogue: 0,0:19:02.07,0:19:04.02,Default,,0,0,0,,Не болды деп ойлайсың?
Dialogue: 0,0:19:05.07,0:19:07.01,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:19:07.07,0:19:10.02,Default,,0,0,0,,Онда ештеңе болған жоқ.
Dialogue: 0,0:19:12.00,0:19:15.02,Default,,0,0,0,,Бірақ күтпеген жағдай болды.
Dialogue: 0,0:19:16.02,0:19:17.05,Default,,0,0,0,,Олар
Dialogue: 0,0:19:17.08,0:19:19.07,Default,,0,0,0,,Ол пайда болды.
Dialogue: 0,0:19:21.02,0:19:22.05,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:34.06,0:19:36.02,Default,,0,0,0,,Дәмі Кадайчиюге ұқсайды.
Dialogue: 0,0:19:37.07,0:19:39.00,Default,,0,0,0,,Кадайчижу
Dialogue: 0,0:19:39.02,0:19:41.07,Default,,0,0,0,,Ол да сенен кейін келеді.
Dialogue: 0,0:19:41.09,0:19:43.09,Default,,0,0,0,,Байланыс болған жоқ па?
Dialogue: 0,0:19:44.00,0:19:45.02,Default,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:19:45.03,0:19:47.05,Default,,0,0,0,,Мен оны міндетті түрде қайтарамын.
Dialogue: 0,0:19:47.07,0:19:48.07,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:49.02,0:19:53.07,Default,,0,0,0,,Сіз де біз сияқты Сефиенсумен тығыз байланыстасыз.
Dialogue: 0,0:19:54.04,0:19:59.05,Default,,0,0,0,,Кадайчиюдің мақсаты жақын арада болатын сәтке дайындалу болса.
Dialogue: 0,0:19:59.06,0:20:02.06,Default,,0,0,0,,Жолда бізден артық ешкім жоқ.
Dialogue: 0,0:20:03.00,0:20:04.02,Default,,0,0,0,,Дайындық?
Dialogue: 0,0:20:05.09,0:20:07.06,Default,,0,0,0,,Сефи энциклопедиясы
Dialogue: 0,0:20:09.04,0:20:10.04,Default,,0,0,0,,Қайта тірілу
Dialogue: 0,0:20:10.05,0:20:11.07,Default,,0,0,0,,Әңгіме аяқталды ма?
Dialogue: 0,0:20:11.08,0:20:13.09,Default,,0,0,0,,Енді негізгі тақырыпқа көшейік.
Dialogue: 0,0:20:14.05,0:20:19.02,Default,,0,0,0,,Кадажюймен және басқалармен күресу үшін бізге сіздің күшіңіз керек.
Dialogue: 0,0:20:19.09,0:20:24.06,Default,,0,0,0,,Қол ұстасайық па? Бұрынғы солдат бұлт
Dialogue: 0,0:20:26.05,0:20:27.09,Default,,0,0,0,,Өзін-өзі жариялады
Dialogue: 0,0:20:31.09,0:20:35.07,Default,,0,0,0,,Ана дегенді қалай түсінесіңдер?
Dialogue: 0,0:20:35.08,0:20:37.00,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:20:37.07,0:20:40.00,Default,,0,0,0,,Қуат бірдеңе деді ме?
Dialogue: 0,0:20:40.03,0:20:41.06,Default,,0,0,0,,Руфус
Dialogue: 0,0:20:42.04,0:20:44.01,Default,,0,0,0,,Не жасырып тұрсың?
Dialogue: 0,0:20:44.09,0:20:48.07,Default,,0,0,0,,Сізбен бірге соғысатын жолдастарыңыздан ештеңе жасырмаңыз.
Dialogue: 0,0:20:50.01,0:20:53.07,Default,,0,0,0,,Сізге де жұлдыз тыртықтары туралы ақпарат керек екеніне сенімдімін.
Dialogue: 0,0:20:54.01,0:20:56.09,Default,,0,0,0,,Бірге тұратын жетім балаларға
Dialogue: 0,0:20:59.01,0:21:02.09,Default,,0,0,0,,Балалардың жүзіне күлкі сыйлағың келмей ме?
Dialogue: 0,0:21:03.04,0:21:09.05,Default,,0,0,0,,Біздің түпкі мақсатымыз – бұлт әлемін қайта құру.
Dialogue: 0,0:21:18.04,0:21:19.00,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:21:19.01,0:21:23.09,Default,,0,0,0,,Өтінемін, Бұлт, Шинра компаниясын қайта құрыңыз.
Dialogue: 0,0:21:25.05,0:21:27.00,Default,,0,0,0,,Мені қызықтырмайды.
Dialogue: 0,0:21:27.08,0:21:28.08,Default,,0,0,0,,Лено!
Dialogue: 0,0:21:52.05,0:21:54.08,Default,,0,0,0,,Бұлт осында өмір сүре ме?
Dialogue: 0,0:21:55.05,0:21:56.08,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:22:05.05,0:22:06.05,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:22:26.00,0:22:29.05,Default,,0,0,0,,Дензел сияқты! Бұлт та ауырып қалды!?
Dialogue: 0,0:22:31.06,0:22:33.01,Default,,0,0,0,,Маған айтсаңызшы.
Dialogue: 0,0:22:33.02,0:22:35.07,Default,,0,0,0,,Сіз ауырып қалдыңыз ба?
Dialogue: 0,0:22:36.00,0:22:38.02,Default,,0,0,0,,Мен жалғыз күресуге дайынмын.
Dialogue: 0,0:22:38.03,0:22:39.01,Default,,0,0,0,,Ұрыс?
Dialogue: 0,0:22:39.02,0:22:40.00,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:22:43.01,0:22:44.09,Default,,0,0,0,,Менің ұрысуға ниетім жоқ.
Dialogue: 0,0:22:45.07,0:22:46.08,Default,,0,0,0,,Тифа?
Dialogue: 0,0:22:49.09,0:22:50.09,Default,,0,0,0,,Теңізші үйге қайтайық
Dialogue: 0,0:22:53.07,0:22:55.07,Default,,0,0,0,,Жоқ, мен Бұлтпен кездескім келеді.
Dialogue: 0,0:23:00.03,0:23:01.04,Default,,0,0,0,,...Дұрыс.
Dialogue: 0,0:23:05.01,0:23:06.02,Default,,0,0,0,,Мен сені көргім келеді.
Dialogue: 0,0:23:06.03,0:23:07.02,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:07.09,0:23:10.07,Default,,0,0,0,,Әй, кездессек не істейміз?
Dialogue: 0,0:23:11.00,0:23:12.06,Default,,0,0,0,,Үйге бірге барайық!
Dialogue: 0,0:23:13.01,0:23:16.05,Default,,0,0,0,,Оның алдында мен сендерге уағыз айтайын.
Dialogue: 0,0:23:16.08,0:23:18.02,Default,,0,0,0,,Келісемін!
Dialogue: 0,0:23:20.09,0:23:23.06,Default,,0,0,0,,Енді бастық пен Иринаны іздеу керек.
Dialogue: 0,0:23:26.04,0:23:28.03,Default,,0,0,0,,Басқа қызметкерлердің ақпараты туралы не деуге болады?
Dialogue: 0,0:23:28.04,0:23:29.09,Default,,0,0,0,,Әзірге
Dialogue: 0,0:23:35.03,0:23:39.04,Default,,0,0,0,,Бұрынғы қызметкерлер... Мен күткеннен де көп адам келеді.
Dialogue: 0,0:23:39.09,0:23:41.04,Default,,0,0,0,,Маған қатты әсер етті.
Dialogue: 0,0:23:41.06,0:23:44.01,Default,,0,0,0,,Мен мұны қайталай аламын.
Dialogue: 0,0:23:44.08,0:23:48.04,Default,,0,0,0,,Өтелу - аман қалғандардың міндеті.
Dialogue: 0,0:23:51.00,0:23:53.00,Default,,0,0,0,,Содан бері екі жыл өтті.
Dialogue: 0,0:23:53.07,0:23:54.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:55.00,0:23:57.06,Default,,0,0,0,,2 жыл бар ма?
Dialogue: 0,0:23:59.03,0:24:01.01,Default,,0,0,0,,Бұл қорқынышты түс болды
Dialogue: 0,0:24:01.06,0:24:04.00,Default,,0,0,0,,Дүние жойылып кете жаздады
Dialogue: 0,0:24:04.03,0:24:06.04,Default,,0,0,0,,Бұл біздің кінәміз, Шинра.
Dialogue: 0,0:24:09.03,0:24:10.06,Default,,0,0,0,,Маңызды әңгіме
Dialogue: 0,0:24:10.08,0:24:13.01,Default,,0,0,0,,Мен оған қанша төлеуім керек деп ойлаймын.
Dialogue: 0,0:24:14.06,0:24:17.05,Default,,0,0,0,,Маған бастықтың болуы керек.
Dialogue: 0,0:24:19.01,0:24:20.04,Default,,0,0,0,,Ирина да
Dialogue: 0,0:24:24.01,0:24:26.00,Default,,0,0,0,,Өтінемін аман бол
Dialogue: 0,0:24:26.02,0:24:27.04,Default,,0,0,0,,Жарайды
Dialogue: 0,0:24:28.01,0:24:30.02,Default,,0,0,0,,Цен мырза да президентпен бірдей.
Dialogue: 0,0:24:30.07,0:24:32.03,Default,,0,0,0,,Бір рет дерлік қайтыс болды
Dialogue: 0,0:24:33.00,0:24:34.05,Default,,0,0,0,,Сәтсіздік күшті
Dialogue: 0,0:24:34.09,0:24:36.03,Default,,0,0,0,,Міне!
Dialogue: 0,0:24:45.00,0:24:46.09,Default,,0,0,0,,Табылды/
Dialogue: 0,0:24:59.00,0:25:00.05,Default,,0,0,0,,Шіркеу дегеніміз не?
Dialogue: 0,0:25:03.01,0:25:05.02,Default,,0,0,0,,О, ана жерде ме?
Dialogue: 0,0:25:06.01,0:25:08.01,Default,,0,0,0,,Иә, мен күтемін.
Dialogue: 0,0:26:36.06,0:26:40.04,Default,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:26:41.07,0:26:45.05,Default,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:26:46.08,0:26:50.06,Default,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:26:51.09,0:26:55.08,Default,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:26:57.00,0:27:00.08,Default,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:27:36.00,0:27:36.50,Default,,0,0,0,,Бұлт
Dialogue: 0,0:27:37.00,0:27:39.03,Default,,0,0,0,,Маған телефон соғатындар сирек.
Dialogue: 0,0:27:39.07,0:27:41.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:27:44.01,0:27:45.01,Default,,0,0,0,,Бұлт?
Dialogue: 0,0:27:46.04,0:27:47.08,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:27:48.07,0:27:52.00,Default,,0,0,0,,Кім? Мұны Cloud телефонында жасай аласыз ба?
Dialogue: 0,0:27:52.06,0:27:54.00,Default,,0,0,0,,Тұр, мен өзі қандай ұлтпын? Хехехе
Dialogue: 0,0:27:54.07,0:27:55.09,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:27:57.05,0:27:58.09,Default,,0,0,0,,Тұр, мен өзі қандай ұлтпын? Хехехе
Dialogue: 0,0:27:59.02,0:28:03.04,Default,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,0:28:06.00,0:28:08.05,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:28:17.04,0:28:18.07,Default,,0,0,0,,Не болды? Сенімен бәрі жақсы ма?
Dialogue: 0,0:28:19.04,0:28:21.08,Default,,0,0,0,,Бұлт! Бұлт! Сен ондасың ба?
Dialogue: 0,0:28:29.09,0:28:30.09,Default,,0,0,0,,Нет... не істеп жатырсың...
Dialogue: 0,0:28:37.00,0:28:38.02,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:29:21.07,0:29:23.08,Default,,0,0,0,,Өтірікті жек көремін.
Dialogue: 0,0:29:24.00,0:29:27.03,Default,,0,0,0,,Бұл жаман болды. Мен бұл жолы шын боламын.
Dialogue: 0,0:29:27.05,0:29:29.05,Default,,0,0,0,,Ол сендерден қашып кетті.
Dialogue: 0,0:29:29.07,0:29:31.06,Default,,0,0,0,,Тікұшақтан құлаған сияқты
Dialogue: 0,0:29:32.01,0:29:34.00,Default,,0,0,0,,Бұл ақымақ әңгіме.
Dialogue: 0,0:29:35.00,0:29:37.00,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:29:37.05,0:29:38.09,Default,,0,0,0,,Ант етемін
Dialogue: 0,0:29:40.08,0:29:43.01,Default,,0,0,0,,Содан кейін бұл туралы ант етіңіз.
Dialogue: 0,0:29:50.03,0:29:51.06,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:29:51.08,0:29:54.06,Default,,0,0,0,,Маған анаңның күші керек.
Dialogue: 0,0:29:55.02,0:29:58.05,Default,,0,0,0,,Реюнионның басқа амалы жоқ
Dialogue: 0,0:29:59.04,0:30:00.05,Default,,0,0,0,,Кездесу
Dialogue: 0,0:30:01.01,0:30:04.05,Default,,0,0,0,,Анамның ұяшықтарын алған достар бір жерге жиналады.
Dialogue: 0,0:30:04.08,0:30:07.02,Default,,0,0,0,,Ал жұлдыздардан кек ал
Dialogue: 0,0:30:07.07,0:30:10.03,Default,,0,0,0,,Дайындық тұрақты түрде жүріп жатыр.
Dialogue: 0,0:30:11.01,0:30:15.08,Default,,0,0,0,,Қараңдаршы, анамды біреу жасырып қалды.
Dialogue: 0,0:30:15.09,0:30:17.00,Default,,0,0,0,,Дайындық?
Dialogue: 0,0:30:17.08,0:30:18.09,Default,,0,0,0,,Жұлдызды тыртық
Dialogue: 0,0:30:19.08,0:30:22.01,Default,,0,0,0,,Мұны президент те біледі.
Dialogue: 0,0:30:22.09,0:30:24.06,Default,,0,0,0,,Өмір ағымында
Dialogue: 0,0:30:24.07,0:30:27.03,Default,,0,0,0,,Мұның бәрі анамның тынымсыз еңбек еткен генетикалық ойларының арқасы.
Dialogue: 0,0:30:28.01,0:30:30.07,Default,,0,0,0,,Дегенмен біз
Dialogue: 0,0:30:31.02,0:30:33.02,Default,,0,0,0,,Мен анамның қайда екенін де білмеймін.
Dialogue: 0,0:30:35.01,0:30:38.05,Default,,0,0,0,,Бұл аянышты, бірақ мен оған көмектесе алмаймын.
Dialogue: 0,0:30:39.00,0:30:41.08,Default,,0,0,0,,Өйткені біз ойлау формаларымыз.
Dialogue: 0,0:30:41.09,0:30:45.00,Default,,0,0,0,,Мен анамды тауып, онымен ұяшықтарымды бөліскенше.
Dialogue: 0,0:30:45.01,0:30:46.09,Default,,0,0,0,,Қалыпты күйге оралу мүмкін емес
Dialogue: 0,0:30:47.08,0:30:50.07,Default,,0,0,0,,Тек ойлар мен жұлдызшалар жеткілікті.
Dialogue: 0,0:30:51.00,0:30:54.00,Default,,0,0,0,,Нағыз кездесуге.
Dialogue: 0,0:30:54.02,0:30:55.04,Default,,0,0,0,,...Не айтып тұрсың?
Dialogue: 0,0:30:57.05,0:31:01.09,Default,,0,0,0,,Президент... сіз бұл туралы білесіз бе?
Dialogue: 0,0:31:38.09,0:31:40.02,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:31:42.09,0:31:44.08,Default,,0,0,0,,Уау! Жұлдызды тыртықтар!
Dialogue: 0,0:31:50.08,0:31:52.03,Default,,0,0,0,,Үйден шықпаңыз!
Dialogue: 0,0:32:07.03,0:32:08.01,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:32:38.09,0:32:40.09,Default,,0,0,0,,Сен үшін өмір сүрейік
Dialogue: 0,0:32:42.09,0:32:45.00,Default,,0,0,0,,Мен осылай шештім...
Dialogue: 0,0:32:45.03,0:32:48.03,Default,,0,0,0,,Сіз солдат болғыңыз келе ме? Іске сәт!
Dialogue: 0,0:32:48.04,0:32:50.01,Default,,0,0,0,,Әй, көңіл-күйің қалай?
Dialogue: 0,0:32:50.02,0:32:53.06,Default,,0,0,0,,Эй Миг, Мидгарға жеткенде не істейсің?
Dialogue: 0,0:32:54.00,0:32:56.02,Default,,0,0,0,,Бұл Бокумодачи, солай ма?
Dialogue: 0,0:33:04.01,0:33:06.03,Default,,0,0,0,,Қария! Тастың артындағы бір жерде тоқтаңыз!
Dialogue: 0,0:33:06.06,0:33:08.05,Default,,0,0,0,,Бұлт Түсейік!
Dialogue: 0,0:33:11.09,0:33:13.07,Default,,0,0,0,,Менің мақтанышым мен армандарым
Dialogue: 0,0:33:16.01,0:33:17.05,Default,,0,0,0,,Барлығын орындаңыз
Dialogue: 0,0:33:18.04,0:33:19.08,Default,,0,0,0,,Сіз
Dialogue: 0,0:33:21.09,0:33:23.09,Default,,0,0,0,,Менің тірі дәлелім
Dialogue: 0,0:33:26.09,0:33:30.03,Default,,0,0,0,,Сол кезде мен ұмытпаймын деп ант еткенмін.
Dialogue: 0,0:33:31.05,0:33:32.05,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:33:33.04,0:33:34.05,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:33:41.09,0:33:44.01,Default,,0,0,0,,Көңілсіз болып көрінуді доғар.
Dialogue: 0,0:33:45.08,0:33:48.09,Default,,0,0,0,,Ашумен әрекет етудің қажеті жоқ
Dialogue: 0,0:33:50.04,0:33:53.00,Default,,0,0,0,,Өйткені бұлт
Dialogue: 0,0:33:54.00,0:33:55.03,Default,,0,0,0,,Сіз
Dialogue: 0,0:33:56.01,0:33:57.06,Default,,0,0,0,,Бұл қуыршақ.
Dialogue: 0,0:34:10.05,0:34:11.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:15.05,0:34:16.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:25.02,0:34:26.07,Default,,0,0,0,,Ойнайық па?
Dialogue: 0,0:34:30.04,0:34:32.01,Default,,0,0,0,,Иә немесе жоқ
Dialogue: 0,0:34:34.08,0:34:36.01,Default,,0,0,0,,Сенің анаң ше?
Dialogue: 0,0:34:37.06,0:34:38.03,Default,,0,0,0,,А?
Dialogue: 0,0:34:44.06,0:34:45.06,Default,,0,0,0,,Білсін
Dialogue: 0,0:34:47.08,0:34:49.03,Default,,0,0,0,,Әй, анаң ше?
Dialogue: 0,0:34:49.04,0:34:50.07,Default,,0,0,0,,Мұнда ешкім жоқ!
Dialogue: 0,0:34:52.04,0:34:55.00,Default,,0,0,0,,Олай болса ойнайық
Dialogue: 0,0:35:09.00,0:35:10.07,Default,,0,0,0,,Бұл қиын және қызықты.
Dialogue: 0,0:36:26.09,0:36:27.09,Default,,0,0,0,,Тихуа!
Dialogue: 0,0:36:56.07,0:36:58.07,Default,,0,0,0,,Мұнда емес
Dialogue: 0,0:37:00.04,0:37:01.07,Default,,0,0,0,,Жылама
Dialogue: 0,0:37:03.08,0:37:04.07,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:37:05.02,0:37:06.04,Default,,0,0,0,,Әкел
Dialogue: 0,0:37:11.07,0:37:12.05,Default,,0,0,0,,Жалғасы
Dialogue: 0,0:38:11.08,0:38:12.05,Default,,0,0,0,,Бұлт
Dialogue: 0,0:38:14.00,0:38:14.50,Default,,0,0,0,,Қаш!
Dialogue: 0,0:38:33.01,0:38:35.05,Default,,0,0,0,,Бұрынғы үшін кешіріңіз.
Dialogue: 0,0:38:37.07,0:38:38.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:38:43.00,0:38:44.00,Default,,0,0,0,,Иә
Dialogue: 0,0:38:47.02,0:38:48.03,Default,,0,0,0,,інісі
Dialogue: 0,0:38:50.08,0:38:52.04,Default,,0,0,0,,Ол кетті
Dialogue: 0,0:38:54.07,0:38:56.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:38:57.02,0:39:00.02,Default,,0,0,0,,Ей, сен де жұлдыздың тыртығысың, солай ма?
Dialogue: 0,0:39:01.04,0:39:03.01,Default,,0,0,0,,Сені емдейді дейді.
Dialogue: 0,0:39:56.01,0:39:56.51,Default,,0,0,0,,Тифа?
Dialogue: 0,0:39:59.07,0:40:00.07,Default,,0,0,0,,Тифа!!
Dialogue: 0,0:40:07.08,0:40:08.09,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:40:09.03,0:40:10.06,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:40:13.01,0:40:14.07,Default,,0,0,0,,Бейтаныс
Dialogue: 0,0:40:16.04,0:40:17.00,Default,,0,0,0,,Теңіз!?
Dialogue: 0,0:40:26.04,0:40:27.03,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:41:37.08,0:41:39.09,Default,,0,0,0,,Ауыр болды.
Dialogue: 0,0:41:40.05,0:41:43.09,Default,,0,0,0,,...Сіз балаларыңызбен бірге тұрдыңыз.
Dialogue: 0,0:41:44.03,0:41:45.09,Default,,0,0,0,,Ол бос
Dialogue: 0,0:41:50.02,0:41:51.04,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:41:55.00,0:41:55.50,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:42:06.09,0:42:08.04,Default,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,0:42:21.09,0:42:24.04,Default,,0,0,0,,Тифа сені алып келгенімді қалайды.
Dialogue: 0,0:42:27.01,0:42:28.01,Default,,0,0,0,,Ұстау
Dialogue: 0,0:43:03.06,0:43:05.06,Default,,0,0,0,,Мені кім емдейді?
Dialogue: 0,0:43:08.09,0:43:09.09,Default,,0,0,0,,Маған сән журналының түсірілімінде қолданылған осы киімді берді
Dialogue: 0,0:43:13.00,0:43:16.06,Default,,0,0,0,,Иә... Мен енді ешкімді ойламаймын.
Dialogue: 0,0:43:35.03,0:43:37.07,Default,,0,0,0,,Оны ағаң жасырды ма?
Dialogue: 0,0:43:40.01,0:43:43.01,Default,,0,0,0,,Өмір ағымынан туған қуат
Dialogue: 0,0:43:46.02,0:43:51.00,Default,,0,0,0,,Осы материал арқылы біз де жаңа күшке ие бола аламыз.
Dialogue: 0,0:43:53.09,0:43:57.03,Default,,0,0,0,,Анаң саған қалдырды, солай ма?
Dialogue: 0,0:43:57.05,0:43:59.05,Default,,0,0,0,,О, мен сенімдімін
Dialogue: 0,0:44:00.02,0:44:02.07,Default,,0,0,0,,Ағаң да анаңды жасырып жүр ме?
Dialogue: 0,0:44:03.02,0:44:05.06,Default,,0,0,0,,Жоқ, бұл президент.
Dialogue: 0,0:44:06.02,0:44:10.06,Default,,0,0,0,,Шинра компаниясы әрқашан аналарды жасырғанды ​​ұнататын.
Dialogue: 0,0:44:11.09,0:44:15.09,Default,,0,0,0,,Олай болса, сізге тек Шинраға қатысты барлық жерлерді іздеу керек.
Dialogue: 0,0:44:16.03,0:44:20.03,Default,,0,0,0,,Иә, жақында достарымыз көп болады.
Dialogue: 0,0:44:21.01,0:44:23.02,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:44:25.04,0:44:27.00,Default,,0,0,0,,Бұл қандай жаман иіс?
Dialogue: 0,0:44:28.00,0:44:30.04,Default,,0,0,0,,Мен ағама шағым айтуым керек.
Dialogue: 0,0:44:31.02,0:44:34.03,Default,,0,0,0,,Бұның бәрі сізге қатысы жоқ деп ойлаңыз
Dialogue: 0,0:44:35.02,0:44:37.09,Default,,0,0,0,,Мен шынымен жалғызбын
Dialogue: 0,0:44:39.04,0:44:40.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:40.05,0:44:41.05,Default,,0,0,0,,Кя!
Dialogue: 0,0:44:46.04,0:44:47.03,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:45:08.04,0:45:10.02,Default,,0,0,0,,Рено және басқалар іздейді
Dialogue: 0,0:45:15.07,0:45:19.05,Default,,0,0,0,,Жұлдызды тыртық синдромы... солай ма?
Dialogue: 0,0:45:21.00,0:45:24.02,Default,,0,0,0,,Мен осылай өлсем де болады...Қалай ойлайсың?
Dialogue: 0,0:45:29.03,0:45:30.06,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:45:31.06,0:45:33.03,Default,,0,0,0,,Емдеу жоқ
Dialogue: 0,0:45:33.08,0:45:36.06,Default,,0,0,0,,Бірақ Дензел барын салуда.
Dialogue: 0,0:45:37.03,0:45:39.04,Default,,0,0,0,,Қашпа, бірігіп ұрыспас па?
Dialogue: 0,0:45:39.06,0:45:42.02,Default,,0,0,0,,Бәріміз бір-бірімізге көмектесіп, бар күшімізді салайық
Dialogue: 0,0:45:46.00,0:45:49.01,Default,,0,0,0,,Бұл нағыз отбасы емес, сондықтан жақсы емес.
Dialogue: 0,0:45:49.03,0:45:50.04,Default,,0,0,0,,Маған
Dialogue: 0,0:45:52.01,0:45:54.04,Default,,0,0,0,,Маған ешкім көмектесе алмайды деп ойлаймын.
Dialogue: 0,0:45:55.06,0:45:58.08,Default,,0,0,0,,Отбасы болсын, достары болсын...
Dialogue: 0,0:45:59.04,0:46:00.06,Default,,0,0,0,,Ешкім
Dialogue: 0,0:46:03.08,0:46:05.06,Default,,0,0,0,,Шламды суспензия
Dialogue: 0,0:46:10.07,0:46:12.08,Default,,0,0,0,,Біле-шала, жалт-жұлт!
Dialogue: 0,0:46:13.06,0:46:16.03,Default,,0,0,0,,Сіз оны қанша уақытқа сүйреп жатырсыз?
Dialogue: 0,0:46:16.08,0:46:18.00,Default,,0,0,0,,Оны таба алмайсыз ба?
Dialogue: 0,0:46:18.07,0:46:23.07,Default,,0,0,0,,Оны алып кеткендерін айтқан куәгер болды.
Dialogue: 0,0:46:24.00,0:46:25.01,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:46:25.02,0:46:26.09,Default,,0,0,0,,Ұмытшақ қала
Dialogue: 0,0:46:28.03,0:46:29.01,Default,,0,0,0,,Аджи Боку
Dialogue: 0,0:46:43.00,0:46:47.07,Default,,0,0,0,,Мен анамнан ерекше қуат алдым.
Dialogue: 0,0:46:48.02,0:46:50.02,Default,,0,0,0,,Адамдарды азаптау
Dialogue: 0,0:46:51.05,0:46:53.05,Default,,0,0,0,,Бұл планетамен күресетін күш.
Dialogue: 0,0:46:57.00,0:47:00.07,Default,,0,0,0,,Негізінде бұл құдірет әркімде де бар.
Dialogue: 0,0:47:01.07,0:47:02.08,Default,,0,0,0,,Иә
Dialogue: 0,0:47:04.02,0:47:06.05,Default,,0,0,0,,Біз ағайындымыз
Dialogue: 0,0:47:07.06,0:47:09.01,Default,,0,0,0,,Өмір ағымына сіңген
Dialogue: 0,0:47:09.02,0:47:13.00,Default,,0,0,0,,Анасының генетикалық ой-пікірін мұра еткен таңдаулы ағалар
Dialogue: 0,0:47:15.01,0:47:15.51,Default,,0,0,0,,Бірақ
Dialogue: 0,0:47:18.00,0:47:20.05,Default,,0,0,0,,Жұлдыздар барлығын мазалайды.
Dialogue: 0,0:47:21.08,0:47:24.08,Default,,0,0,0,,Біздің өсуді тоқтатуға тырысу
Dialogue: 0,0:47:26.00,0:47:31.00,Default,,0,0,0,,Сол себепті денең ауырып, жүрегің бас тартқалы тұрғандай болады.
Dialogue: 0,0:47:33.09,0:47:35.07,Default,,0,0,0,,Мен сені емдеймін.
Dialogue: 0,0:47:36.07,0:47:39.02,Default,,0,0,0,,Ал анама барайық.
Dialogue: 0,0:47:39.06,0:47:44.00,Default,,0,0,0,,Жұлдыздардан кек алу үшін отбасы болып бірге жұмыс жасайық!
Dialogue: 0,0:47:48.09,0:47:50.06,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:48:37.08,0:48:39.00,Default,,0,0,0,,Дензел!
Dialogue: 0,0:48:43.04,0:48:44.04,Default,,0,0,0,,Дензел!
Dialogue: 0,0:48:56.07,0:48:58.00,Default,,0,0,0,,Анашым, қарашы.
Dialogue: 0,0:48:59.01,0:49:01.08,Default,,0,0,0,,Менің тағы қаншама бауырларым бар.
Dialogue: 0,0:49:03.04,0:49:05.08,Default,,0,0,0,,Енді мен анаммен кездескенше
Dialogue: 0,0:49:05.09,0:49:08.00,Default,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,0:49:47.03,0:49:48.05,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:49:51.00,0:49:54.01,Default,,0,0,0,,Өзімді бұзып кететін сияқты болсам да
Dialogue: 0,0:49:55.05,0:49:57.00,Default,,0,0,0,,Мен бұл жақсы нәрсе екеніне сенімдімін.
Dialogue: 0,0:49:59.00,0:50:00.03,Default,,0,0,0,,Question
Dialogue: 0,0:50:01.03,0:50:03.02,Default,,0,0,0,,Неге келдің?
Dialogue: 0,0:50:05.04,0:50:09.00,Default,,0,0,0,,Менің ойымша...Мені кешіргім келеді.
Dialogue: 0,0:50:10.04,0:50:13.03,Default,,0,0,0,,Иә, мені кешіргім келеді.
Dialogue: 0,0:50:14.08,0:50:16.00,Default,,0,0,0,,Кімге?
Dialogue: 0,0:51:06.00,0:51:07.03,Default,,0,0,0,,Сіз бәрібір келдіңіз.
Dialogue: 0,0:51:07.06,0:51:09.00,Default,,0,0,0,,Мен балаларды алуға келдім.
Dialogue: 0,0:51:09.02,0:51:12.06,Default,,0,0,0,,Бұл кісі біздің ағамыз.
Dialogue: 0,0:51:12.09,0:51:17.02,Default,,0,0,0,,Бірақ, өкінішке орай.
Dialogue: 0,0:51:19.04,0:51:21.05,Default,,0,0,0,,Сен сатқынсың.
Dialogue: 0,0:51:24.08,0:51:26.01,Default,,0,0,0,,Бұлт!
Dialogue: 0,0:53:45.07,0:53:48.02,Default,,0,0,0,,Шынымен... Мен ешкімге көмектесе алмаймын.
Dialogue: 0,0:53:49.05,0:53:52.02,Default,,0,0,0,,Винченцо... не болып жатыр?
Dialogue: 0,0:53:54.05,0:53:56.00,Default,,0,0,0,,Мен мұнда жиі келемін
Dialogue: 0,0:53:58.08,0:54:01.02,Default,,0,0,0,,Сондықтан мен Кадайчию мен басқаларды бақылап отырдым.
Dialogue: 0,0:54:03.01,0:54:04.04,Default,,0,0,0,,Жұлдыздың тыртықтары
Dialogue: 0,0:54:05.00,0:54:10.03,Default,,0,0,0,,Ағзада ұялаған бөгде заттарды кетіретін жүйенің шамадан тыс жұмыс істеуінен туындаған сияқты.
Dialogue: 0,0:54:12.08,0:54:16.01,Default,,0,0,0,,Дененің ішінде тіршілік ағымына ұқсас ағын бар.
Dialogue: 0,0:54:16.09,0:54:20.06,Default,,0,0,0,,Міне, біз ең жақын досымызға айналған зұлым заттармен күресеміз.
Dialogue: 0,0:54:22.05,0:54:24.04,Default,,0,0,0,,Зиянды заттар
Dialogue: 0,0:54:24.09,0:54:28.05,Default,,0,0,0,,Цефия факторы Дженованың генетикалық ойы
Dialogue: 0,0:54:29.02,0:54:30.03,Default,,0,0,0,,Қалағаныңызша атаңыз
Dialogue: 0,0:54:32.07,0:54:33.08,Default,,0,0,0,,Бұл егжей-тегжейлі.
Dialogue: 0,0:54:34.07,0:54:36.01,Default,,0,0,0,,Цен және Ирина
Dialogue: 0,0:54:36.08,0:54:39.08,Default,,0,0,0,,Оны мұнда өлуге жақын күйде әкелді.
Dialogue: 0,0:54:40.03,0:54:42.06,Default,,0,0,0,,Ол өте ұсқынсыз азаптауға ұшыраған сияқты.
Dialogue: 0,0:54:43.07,0:54:45.05,Default,,0,0,0,,Мен саған көмектестім, бірақ
Dialogue: 0,0:54:46.09,0:54:49.01,Default,,0,0,0,,Хмм, мен білмеймін.
Dialogue: 0,0:54:49.06,0:54:50.08,Default,,0,0,0,,Азаптау?
Dialogue: 0,0:54:51.03,0:54:52.08,Default,,0,0,0,,Өзін-өзі өлтіру
Dialogue: 0,0:54:53.00,0:54:55.01,Default,,0,0,0,,Ол Дженованың басын алған сияқты.
Dialogue: 0,0:54:56.01,0:54:59.00,Default,,0,0,0,,Рикида Ичиджу іздеп жүрген ана
Dialogue: 0,0:54:59.01,0:55:02.03,Default,,0,0,0,,Аспан жіберген жиіркенішті істер
Dialogue: 0,0:55:02.05,0:55:03.06,Default,,0,0,0,,Генуя
Dialogue: 0,0:55:03.09,0:55:07.02,Default,,0,0,0,,Егер сізге ұнаса, қайтадан Sefimansu жасауға болады.
Dialogue: 0,0:55:08.08,0:55:09.08,Default,,0,0,0,,Кадайчижу
Dialogue: 0,0:55:10.08,0:55:12.02,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:55:12.07,0:55:15.00,Default,,0,0,0,,Хмм, бұл туралы ойлағым да келмейді.
Dialogue: 0,0:55:26.09,0:55:27.07,Default,,0,0,0,,Теңіз!
Dialogue: 0,0:55:27.09,0:55:30.03,Default,,0,0,0,,Бұлт! Дензел! Дензел!
Dialogue: 0,0:55:30.05,0:55:31.07,Default,,0,0,0,,Тифа жақсы.
Dialogue: 0,0:55:32.00,0:55:33.05,Default,,0,0,0,,Мен Тифамен сөйлескім келеді!
Dialogue: 0,0:55:39.02,0:55:40.03,Default,,0,0,0,,Сізде бар ма?
Dialogue: 0,0:55:42.03,0:55:43.07,Default,,0,0,0,,Сенгісіз!
Dialogue: 0,0:55:46.01,0:55:49.00,Default,,0,0,0,,Винченцо Маринді дүкенге жібере аласыз ба?
Dialogue: 0,0:55:49.07,0:55:51.08,Default,,0,0,0,,Мен Шинра жігіттерін тыңдаймын.
Dialogue: 0,0:55:51.09,0:55:52.07,Default,,0,0,0,,Келіспеймін
Dialogue: 0,0:55:52.09,0:55:53.09,Default,,0,0,0,,Бірақ
Dialogue: 0,0:55:54.06,0:55:56.00,Default,,0,0,0,,Бұлт жеткілікті!
Dialogue: 0,0:55:56.01,0:55:59.02,Default,,0,0,0,,Неге бізді тыңдамайсың?
Dialogue: 0,0:56:03.00,0:56:04.00,Default,,0,0,0,,Теңіз
Dialogue: 0,0:56:04.07,0:56:06.04,Default,,0,0,0,,Тағы біраз күтіңіз.
Dialogue: 0,0:56:06.05,0:56:08.06,Default,,0,0,0,,Ұрыс қазір басталуы керек.
Dialogue: 0,0:56:08.07,0:56:10.09,Default,,0,0,0,,Бірақ тек күресу жеткіліксіз.
Dialogue: 0,0:56:11.00,0:56:13.02,Default,,0,0,0,,Түсінесіз бе? Мен түсінбеймін!
Dialogue: 0,0:56:13.04,0:56:16.09,Default,,0,0,0,,Бұлт... Бұл шайқас туралы ма?
Dialogue: 0,0:56:18.07,0:56:19.07,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:56:19.09,0:56:21.09,Default,,0,0,0,,Ұмытшақ қала
Dialogue: 0,0:56:22.09,0:56:24.01,Default,,0,0,0,,Аджи Боку
Dialogue: 0,0:56:27.08,0:56:28.09,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:56:35.07,0:56:37.02,Default,,0,0,0,,Мен Руфуспен сөйлесемін.
Dialogue: 0,0:56:37.03,0:56:38.04,Default,,0,0,0,,Қашпа!
Dialogue: 0,0:56:39.06,0:56:40.06,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:56:40.08,0:56:43.03,Default,,0,0,0,,Балаларды тапсақ та, қолымыздан ештеңе келмеуі мүмкін.
Dialogue: 0,0:56:43.05,0:56:46.00,Default,,0,0,0,,Мүмкін заттар қайтадан қайтымсыз болып қалатын шығар.
Dialogue: 0,0:56:46.01,0:56:47.03,Default,,0,0,0,,Бұл қорқынышты емес пе?
Dialogue: 0,0:56:47.04,0:56:50.02,Default,,0,0,0,,Бірақ қазіргі сәтті және әртүрлі нәрселерді қабылдаңыз.
Dialogue: 0,0:56:50.03,0:56:52.09,Default,,0,0,0,,Ауыр ма? Өйткені оған көмектесу мүмкін емес, ол ауыр.
Dialogue: 0,0:56:53.03,0:56:55.06,Default,,0,0,0,,Өз бетіңізше өмір сүре алмасаңыз, оған шыдау керек.
Dialogue: 0,0:56:56.00,0:56:57.04,Default,,0,0,0,,Жалғыз қалғым келмейді, солай ма?
Dialogue: 0,0:56:57.05,0:57:00.01,Default,,0,0,0,,Жауап бермесем де, телефонымды жібермеймін.
Dialogue: 0,0:57:03.09,0:57:06.09,Default,,0,0,0,,Бару керек.
Dialogue: 0,0:57:15.00,0:57:19.06,Default,,0,0,0,,Біз естеліктерімізді жоғалттық па?
Dialogue: 0,0:57:25.05,0:57:29.00,Default,,0,0,0,,Мен оны өлімге қалдырғаным үшін бе?
Dialogue: 0,0:57:30.01,0:57:32.02,Default,,0,0,0,,Шынында да діріл!
Dialogue: 0,0:57:33.00,0:57:33.50,Default,,0,0,0,,Эй
Dialogue: 0,0:57:34.02,0:57:36.01,Default,,0,0,0,,Мен сені кешірсем ше?
Dialogue: 0,0:57:39.05,0:57:42.00,Default,,0,0,0,,Күнәні кешіруге бола ма?
Dialogue: 0,0:57:43.00,0:57:44.03,Default,,0,0,0,,...Мен оны ешқашан сынап көрген емеспін.
Dialogue: 0,0:57:44.08,0:57:45.09,Default,,0,0,0,,Көріңіз бе?
Dialogue: 0,0:57:46.08,0:57:47.09,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:57:53.00,0:57:54.03,Default,,0,0,0,,Теңіз Мен үйге бара жатырмын
Dialogue: 0,0:57:58.09,0:58:00.03,Default,,0,0,0,,Мен жасап көремін
Dialogue: 0,0:58:01.00,0:58:02.07,Default,,0,0,0,,Нәтижелер туралы сізге хабарласамыз.
Dialogue: 0,0:58:22.06,0:58:26.09,Default,,0,0,0,,Мен Ривпін.» Сіздің жұмысыңыз қалай?
Dialogue: 0,0:58:27.06,0:58:31.00,Default,,0,0,0,,Мен флайерді көрдім, бірақ онымен бизнес жасауға бола ма?
Dialogue: 0,0:58:31.01,0:58:33.02,Default,,0,0,0,,Бұлт-сан сияқты.
Dialogue: 0,0:58:33.07,0:58:35.00,Default,,0,0,0,,Қаласаңыз, мен сізге көмектескім келеді.
Dialogue: 0,0:58:35.02,0:58:37.04,Default,,0,0,0,,Маған Хилиндегі Рено телефон соғып, жұмыс сұрады.
Dialogue: 0,0:58:37.05,0:58:39.00,Default,,0,0,0,,Көптен бері көрмегелі, бұл Юффи.
Dialogue: 0,0:58:39.02,0:58:41.07,Default,,0,0,0,,Білесің бе, балалар Учадайдан жоғалып кетті.
Dialogue: 0,0:58:41.09,0:58:43.02,Default,,0,0,0,,Сіз бірдеңе білесіз бе? Ақпарат, өтінемін!
Dialogue: 0,0:58:43.02,0:58:46.05,Default,,0,0,0,,Оның бойында біртүрлі нәрсе болды... Сақ болыңыз.
Dialogue: 0,0:58:51.09,0:58:55.08,Default,,0,0,0,,Мен бұған ешқашан ренжіген емеспін.
Dialogue: 0,0:58:56.05,0:59:00.03,Default,,0,0,0,,Сіз келдіңіз, солай ма? Бұл жеткілікті.
Dialogue: 0,0:59:40.01,0:59:41.04,Default,,0,0,0,,Сәлем! Сіз тыңдайсыз ба?
Dialogue: 0,0:59:41.06,0:59:42.09,Default,,0,0,0,,Неліктен бұған еліктейсің?
Dialogue: 0,1:00:32.04,1:00:33.04,Default,,0,0,0,,Дензел!
Dialogue: 0,1:00:38.08,1:00:39.07,Default,,0,0,0,,Дензел!
Dialogue: 0,1:00:40.02,1:00:41.03,Default,,0,0,0,,Дензел!
Dialogue: 0,1:01:02.03,1:01:03.06,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:01:12.04,1:01:15.04,Default,,0,0,0,,Сенің анаң осында емес пе?
Dialogue: 0,1:01:15.09,1:01:16.09,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:01:17.02,1:01:23.04,Default,,0,0,0,,Бұл не...? Ескерткіш? Шинра жасады.
Dialogue: 0,1:01:23.07,1:01:26.00,Default,,0,0,0,,Сондықтан да осында жасырдың ба?
Dialogue: 0,1:01:26.09,1:01:28.00,Default,,0,0,0,,Жоқ?
Dialogue: 0,1:01:28.04,1:01:29.05,Default,,0,0,0,,Саана
Dialogue: 0,1:01:29.05,1:01:32.00,Default,,0,0,0,,Біз де тыңдамадық.
Dialogue: 0,1:01:35.00,1:01:38.05,Default,,0,0,0,,Қараңызшы, ол бір жерде жасырылған.
Dialogue: 0,1:01:42.08,1:01:45.08,Default,,0,0,0,,Людо, бірдеңе айт!
Dialogue: 0,1:01:48.07,1:01:50.00,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:04.09,1:02:05.09,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,1:02:08.09,1:02:09.07,Default,,0,0,0,,Иә
Dialogue: 0,1:02:10.03,1:02:13.02,Default,,0,0,0,,Бірақ Дензел сияқты жақсы емес.
Dialogue: 0,1:02:14.04,1:02:15.06,Default,,0,0,0,,Оны емдеуге бола ма?
Dialogue: 0,1:02:17.04,1:02:18.07,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,1:02:20.03,1:02:25.01,Default,,0,0,0,,Мен Дензелге ем іздедім.
Dialogue: 0,1:02:26.05,1:02:27.08,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,1:02:28.03,1:02:32.01,Default,,0,0,0,,Бұлт Мен партаны тазаламаймын.
Dialogue: 0,1:02:33.03,1:02:34.06,Default,,0,0,0,,That's right.
Dialogue: 0,1:02:36.08,1:02:39.04,Default,,0,0,0,,Әй, бұлт!
Dialogue: 0,1:02:39.05,1:02:43.08,Default,,0,0,0,,Дензелдің жұлдызша белгілерін өшіре алмағандықтан үйден шықтыңыз ба?
Dialogue: 0,1:02:45.01,1:02:47.04,Default,,0,0,0,,Менде де жұлдыз тыртықтары бар болғандықтан ба?
Dialogue: 0,1:02:49.02,1:02:50.02,Default,,0,0,0,,Мен
Dialogue: 0,1:02:51.05,1:02:53.06,Default,,0,0,0,,Мен өзімді қорғай алмаймын
Dialogue: 0,1:02:54.05,1:02:56.05,Default,,0,0,0,,Мүмкін мен солай ойлағандықтан болар.
Dialogue: 0,1:02:57.08,1:03:01.09,Default,,0,0,0,,Өзін қорғай алмағандар отбасын қорғай алады!
Dialogue: 0,1:03:03.06,1:03:06.04,Default,,0,0,0,,Әкем осылай деді.
Dialogue: 0,1:03:07.05,1:03:10.01,Default,,0,0,0,,Бұлт Берілме
Dialogue: 0,1:03:14.00,1:03:16.00,Default,,0,0,0,,Марин, Дензел және Тифа
Dialogue: 0,1:03:16.05,1:03:18.07,Default,,0,0,0,,Сіз маған әрқашан көмектестіңіз
Dialogue: 0,1:03:19.09,1:03:22.02,Default,,0,0,0,,Мені әрқашан біреу қорғады.
Dialogue: 0,1:03:24.02,1:03:27.07,Default,,0,0,0,,Енді менің кезегім
Dialogue: 0,1:03:28.05,1:03:29.05,Default,,0,0,0,,Иә
Dialogue: 0,1:03:38.08,1:03:40.02,Default,,0,0,0,,Әй, қуат.
Dialogue: 0,1:03:40.08,1:03:42.06,Default,,0,0,0,,Маған бір нәрсе айтыңыз.
Dialogue: 0,1:03:43.02,1:03:45.06,Default,,0,0,0,,Бір ғана
Dialogue: 0,1:03:46.05,1:03:52.00,Default,,0,0,0,,Сіз Jenova жасушаларын алатыныңызды айттыңыз және бәрі қалыпты жағдайға оралады.
Dialogue: 0,1:03:52.02,1:03:54.02,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:03:55.04,1:03:59.08,Default,,0,0,0,,Ол... қайтып келеді.
Dialogue: 0,1:04:02.00,1:04:03.07,Default,,0,0,0,,...
Dialogue: 0,1:04:04.02,1:04:05.05,Default,,0,0,0,,Бұл қорқынышты түс
Dialogue: 0,1:04:05.06,1:04:06.09,Default,,0,0,0,,Шамасы
Dialogue: 0,1:04:07.01,1:04:08.02,Default,,0,0,0,,Шамасы?
Dialogue: 0,1:04:08.04,1:04:10.05,Default,,0,0,0,,Мен Сефиенсуды білмеймін
Dialogue: 0,1:04:11.01,1:04:14.07,Default,,0,0,0,,А, мен оны сезіп тұрмын.
Dialogue: 0,1:04:16.03,1:04:17.08,Default,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,1:04:18.00,1:04:21.03,Default,,0,0,0,,Сіз қайсысын таңдайсыз, анам ба әлде Сефи ме?
Dialogue: 0,1:04:21.09,1:04:23.07,Default,,0,0,0,,Патетикалық ой денесі
Dialogue: 0,1:04:24.04,1:04:28.02,Default,,0,0,0,,Қай жолмен жүрсең де, ақыры бір болмақ!
Dialogue: 0,1:04:28.06,1:04:32.04,Default,,0,0,0,,Л ана ұзақ жол жүріп, осы планетаға келді.
Dialogue: 0,1:04:32.07,1:04:36.04,Default,,0,0,0,,Ғаламды ақымақ адамдардан тазарту.
Dialogue: 0,1:04:37.00,1:04:40.02,Default,,0,0,0,,Бірақ сіз не білесіз?
Dialogue: 0,1:04:42.09,1:04:46.04,Default,,0,0,0,,Анам келгеннен бері мұнда ештеңе өзгерген жоқ.
Dialogue: 0,1:04:46.04,1:04:49.04,Default,,0,0,0,,Сондықтан мен анамды қуантамын
Dialogue: 0,1:04:49.04,1:04:54.09,Default,,0,0,0,,Анам не бұйырса, соны орындаймын.
Dialogue: 0,1:04:55.00,1:04:58.01,Default,,0,0,0,,Хмм, тағы да қорқынышты түс пе?
Dialogue: 0,1:04:59.01,1:05:04.06,Default,,0,0,0,,Балалар, сендер осында болғанша, сол жағдай қайталана береді.
Dialogue: 0,1:05:06.07,1:05:09.03,Default,,0,0,0,,...жұлдыздарды айналып өтетін өмір ағымына
Dialogue: 0,1:05:09.09,1:05:13.04,Default,,0,0,0,,Өмір мен өлім арасында алға-артқа жүру
Dialogue: 0,1:05:13.08,1:05:16.09,Default,,0,0,0,,Сол кері шегіну өмірдің шын мәні болса
Dialogue: 0,1:05:17.01,1:05:19.09,Default,,0,0,0,,Тарихтың қайта жазылуы сөзсіз
Dialogue: 0,1:05:20.07,1:05:23.07,Default,,0,0,0,,Дженова немесе Сефирот, мен білмеймін.
Dialogue: 0,1:05:23.08,1:05:26.04,Default,,0,0,0,,Істі өзіңіз қалағаныңызша қайталаңыз.
Dialogue: 0,1:05:27.01,1:05:30.00,Default,,0,0,0,,Біз өмір ережелерін сақтаймыз
Dialogue: 0,1:05:30.04,1:05:34.09,Default,,0,0,0,,Мен сені әр жолы тоқтатамын.
Dialogue: 0,1:05:36.03,1:05:41.06,Default,,0,0,0,,Президент... Анамды ұрлағаны үшін сылтау ма?
Dialogue: 0,1:05:42.01,1:05:44.05,Default,,0,0,0,,Сіз шынымен өкінбейсіз бе?
Dialogue: 0,1:05:44.06,1:05:50.01,Default,,0,0,0,,Өкінішті? Мен... Көңіл көтермей тұра алмаймын.
Dialogue: 0,1:05:56.05,1:06:01.08,Default,,0,0,0,,Тамаша, онда қазір аяқтаймыз.
Dialogue: 0,1:07:07.05,1:07:09.05,Default,,0,0,0,,Дензел, қаш!
Dialogue: 0,1:07:44.04,1:07:46.01,Default,,0,0,0,,Арх!
Dialogue: 0,1:07:56.09,1:07:58.00,Default,,0,0,0,,Коря
Dialogue: 0,1:07:58.01,1:07:59.01,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,1:08:31.08,1:08:32.05,Default,,0,0,0,,Келесің бе!?
Dialogue: 0,1:08:33.04,1:08:34.03,Default,,0,0,0,,Мен оны көргім келмейді
Dialogue: 0,1:09:12.03,1:09:14.09,Default,,0,0,0,,Бұл қызық, досым
Dialogue: 0,1:09:15.00,1:09:16.08,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,1:09:22.09,1:09:25.01,Default,,0,0,0,,Балалар сендер табандысыңдар.
Dialogue: 0,1:09:27.05,1:09:32.06,Default,,0,0,0,,Сонымен...егер анамды қайтарып берсең, іс бітеді.
Dialogue: 0,1:09:39.04,1:09:40.04,Default,,0,0,0,,Балалар
Dialogue: 0,1:09:40.08,1:09:43.09,Default,,0,0,0,,Дженованың басы Не істейсің?
Dialogue: 0,1:09:55.04,1:09:58.03,Default,,0,0,0,,Ли Юнион, сен жындысың ба?
Dialogue: 0,1:09:59.04,1:10:02.01,Default,,0,0,0,,Біз анамды жаңа ғана кездестірдік.
Dialogue: 0,1:10:06.06,1:10:11.04,Default,,0,0,0,,Менің болашағым туралы бәрін шешем шешеді.
Dialogue: 0,1:10:12.01,1:10:14.01,Default,,0,0,0,,Ал анаң ше?
Dialogue: 0,1:10:29.02,1:10:32.07,Default,,0,0,0,,Ана, ана... Женованың басы емес пе?
Dialogue: 0,1:10:32.09,1:10:33.06,Default,,0,0,0,,Эй!
Dialogue: 0,1:10:34.00,1:10:35.09,Default,,0,0,0,,Анаңды олай атама.
Dialogue: 0,1:10:36.00,1:10:37.04,Default,,0,0,0,,Сенің әкең Эден мектебінің түлегі ғой, иә?
Dialogue: 0,1:10:40.04,1:10:41.08,Default,,0,0,0,,...Жаман болды.
Dialogue: 0,1:10:42.08,1:10:46.01,Default,,0,0,0,,Дұрыс... неге кешірім сұрайсың!
Dialogue: 0,1:11:36.01,1:11:36.51,Default,,0,0,0,,Тифа?
Dialogue: 0,1:11:42.04,1:11:43.03,Default,,0,0,0,,Мұны істейік!
Dialogue: 0,1:11:57.02,1:11:58.08,Default,,0,0,0,,Анаңызды осында қорғаңыз.
Dialogue: 0,1:11:59.01,1:12:00.01,Default,,0,0,0,,Оқ!
Dialogue: 0,1:12:01.05,1:12:03.03,Default,,0,0,0,,Менің ойымша, Марин қауіпсіз!? иә?
Dialogue: 0,1:12:18.00,1:12:19.09,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,1:12:50.02,1:12:51.01,Default,,0,0,0,,Уцупу
Dialogue: 0,1:12:52.07,1:12:54.07,Default,,0,0,0,,Аташи материасын кім пайдаланады?
Dialogue: 0,1:12:54.09,1:12:56.02,Default,,0,0,0,,Әрине, жаман адам
Dialogue: 0,1:12:56.06,1:12:57.09,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,1:12:59.01,1:12:59.51,Default,,0,0,0,,Who?
Dialogue: 0,1:13:04.09,1:13:07.07,Default,,0,0,0,,Жаңа үлгі! Шикура-ғо
Dialogue: 0,1:13:08.07,1:13:11.00,Default,,0,0,0,,Мен сені кейін апарамын!
Dialogue: 0,1:13:12.01,1:13:13.01,Default,,0,0,0,,Телефон дүкені қай жерде?
Dialogue: 0,1:13:16.06,1:13:17.03,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,1:13:17.09,1:13:19.02,Default,,0,0,0,,Біз бәріміз доспыз
Dialogue: 0,1:13:22.03,1:13:24.03,Default,,0,0,0,,Дензел Дүкенге жүгіре аласыз ба?
Dialogue: 0,1:13:25.00,1:13:25.50,Default,,0,0,0,,Иә
Dialogue: 0,1:13:52.04,1:13:53.03,Default,,0,0,0,,Бағдарлама коды…
Dialogue: 0,1:13:57.00,1:13:58.00,Default,,0,0,0,,Тифа! !
Dialogue: 0,1:14:03.03,1:14:04.03,Default,,0,0,0,,Дензел!
Dialogue: 0,1:14:27.00,1:14:27.50,Default,,0,0,0,,Бұлт!
Dialogue: 0,1:14:38.06,1:14:40.05,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,1:14:40.06,1:14:42.08,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,1:14:49.08,1:14:50.05,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:14:50.06,1:14:51.04,Default,,0,0,0,,Иә
Dialogue: 0,1:14:54.01,1:14:56.09,Default,,0,0,0,,Теңізшілер қауіпсіз. Мен оны дүкенге қалдырдым.
Dialogue: 0,1:14:57.04,1:14:58.02,Default,,0,0,0,,Иә
Dialogue: 0,1:14:59.01,1:15:00.06,Default,,0,0,0,,Мен өзімді жеңіл сезінемін
Dialogue: 0,1:15:01.03,1:15:02.04,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:04.08,1:15:08.01,Default,,0,0,0,,Мен оны сүйреткенді ұнатқандықтан тоздырдым ба деп ойлаймын.
Dialogue: 0,1:15:13.02,1:15:15.05,Default,,0,0,0,,Мен өзім дүкенге қайтамын.
Dialogue: 0,1:15:16.01,1:15:17.03,Default,,0,0,0,,Маринмен бірге күту
Dialogue: 0,1:15:20.05,1:15:23.00,Default,,0,0,0,,Бұлт да қайтады, солай ма?
Dialogue: 0,1:15:25.00,1:15:25.50,Default,,0,0,0,,Иә
Dialogue: 0,1:16:04.08,1:16:06.00,Default,,0,0,0,,Мен жеңілуге ​​шыдай алмаймын!
Dialogue: 0,1:18:08.00,1:18:09.03,Default,,0,0,0,,Бұл Осеендо!
Dialogue: 0,1:19:14.06,1:19:18.06,Default,,0,0,0,,Қызық екен, президент мырза, ары қарай қалай атайсыз?
Dialogue: 0,1:19:28.00,1:19:29.00,Default,,0,0,0,,Ана?
Dialogue: 0,1:19:29.02,1:19:31.05,Default,,0,0,0,,Біліңіз, сіз бейтаныссыз.
Dialogue: 0,1:19:44.08,1:19:46.02,Default,,0,0,0,,Бұлтқа барыңыз!
Dialogue: 0,1:19:56.07,1:19:58.06,Default,,0,0,0,,Қараңдар!
Dialogue: 0,1:20:05.07,1:20:07.01,Default,,0,0,0,,Иә!
Dialogue: 0,1:20:08.09,1:20:10.00,Default,,0,0,0,,Nuo~
Dialogue: 0,1:20:22.00,1:20:23.00,Default,,0,0,0,,Тобибе!
Dialogue: 0,1:20:32.05,1:20:33.04,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,1:21:11.08,1:21:12.08,Default,,0,0,0,,Иә!
Dialogue: 0,1:22:04.07,1:22:05.06,Default,,0,0,0,,Анашым!
Dialogue: 0,1:22:13.03,1:22:14.03,Default,,0,0,0,,Президент!
Dialogue: 0,1:22:58.05,1:22:59.05,Default,,0,0,0,,Президент!
Dialogue: 0,1:24:38.05,1:24:40.04,Default,,0,0,0,,Басқа адам қателескен болуы керек.
Dialogue: 0,1:24:49.09,1:24:52.01,Default,,0,0,0,,Папин! Папапапан!
Dialogue: 0,1:25:33.03,1:25:34.01,Default,,0,0,0,,Людо!
Dialogue: 0,1:25:39.02,1:25:42.03,Default,,0,0,0,,A"~!?
Dialogue: 0,1:25:47.00,1:25:49.03,Default,,0,0,0,,Бұл қауіпті, бұл қауіпті, бұл қауіпті.
Dialogue: 0,1:25:50.07,1:25:54.00,Default,,0,0,0,,Ойчи Руидо, жақсы болдыңыз ба?
Dialogue: 0,1:25:54.04,1:25:57.00,Default,,0,0,0,,Жоқ... шынымен емес.
Dialogue: 0,1:26:27.06,1:26:29.03,Default,,0,0,0,,Сота: Мен сағындым…
Dialogue: 0,1:28:23.00,1:28:24.09,Default,,0,0,0,,Досым
Dialogue: 0,1:28:26.00,1:28:29.08,Default,,0,0,0,,Бұл күшті ме?
Dialogue: 0,1:28:31.00,1:28:33.04,Default,,0,0,0,,Шинраның технологиясын біріктіру
Dialogue: 0,1:28:33.05,1:28:35.03,Default,,0,0,0,,Сіз орындадыңыз ба?
Dialogue: 0,1:28:36.02,1:28:38.07,Default,,0,0,0,,Оның қуатына қарамастан, ол жарқыраған.
Dialogue: 0,1:28:38.09,1:28:40.03,Default,,0,0,0,,Ой
Dialogue: 0,1:28:41.03,1:28:43.03,Default,,0,0,0,,Мен саған ұнайсың ба, досым?
Dialogue: 0,1:28:44.04,1:28:46.08,Default,,0,0,0,,Бүгін артық жұмыс уақыты жоқ.
Dialogue: 0,1:30:01.00,1:30:01.50,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,1:30:15.07,1:30:16.08,Default,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,1:30:18.06,1:30:20.03,Default,,0,0,0,,Анашым!
Dialogue: 0,1:32:04.03,1:32:06.05,Default,,0,0,0,,Бұлтқа барайық
Dialogue: 0,1:32:36.01,1:32:39.01,Default,,0,0,0,,Ақыры анамды кездестірдім
Dialogue: 0,1:32:40.02,1:32:41.07,Default,,0,0,0,,Неден басталады?
Dialogue: 0,1:32:44.07,1:32:46.09,Default,,0,0,0,,Маған анам айтып береді.
Dialogue: 0,1:32:48.06,1:32:51.04,Default,,0,0,0,,...Ойланған денелер ештеңе білмейді ме?
Dialogue: 0,1:32:54.04,1:32:57.06,Default,,0,0,0,,Мен бәрібір қуыршақпын
Dialogue: 0,1:33:02.08,1:33:04.04,Default,,0,0,0,,Өткенде сіздермен бірге
Dialogue: 0,1:33:06.05,1:33:07.02,Default,,0,0,0,,Дәл солай!
Dialogue: 0,1:33:33.05,1:33:36.03,Default,,0,0,0,,Мен Cloud Materia әкелдім!
Dialogue: 0,1:33:37.04,1:33:38.04,Default,,0,0,0,,Оны шайқамаңыз!
Dialogue: 0,1:33:38.05,1:33:40.03,Default,,0,0,0,,Сәлем, Сид! Менен тез кет!
Dialogue: 0,1:33:40.04,1:33:42.06,Default,,0,0,0,,Шулы! Секір! Секір!
Dialogue: 0,1:33:43.05,1:33:44.09,Default,,0,0,0,,Маған жалғыз күресуге рұқсат етіңіз
Dialogue: 0,1:33:46.01,1:33:47.01,Default,,0,0,0,,Иә!?
Dialogue: 0,1:33:47.05,1:33:49.06,Default,,0,0,0,,Ол кісі Сефиенсудың ойлау формасы.
Dialogue: 0,1:33:50.07,1:33:52.07,Default,,0,0,0,,Бұл дернәсіл сияқты, былайша айтқанда.
Dialogue: 0,1:33:52.08,1:33:55.02,Default,,0,0,0,,Дернәсіл? Қате? Бұл қате ме?
Dialogue: 0,1:33:55.03,1:33:56.08,Default,,0,0,0,,Жас келіншек аузын жапқанда
Dialogue: 0,1:33:56.09,1:33:59.03,Default,,0,0,0,,Сіз бір күні Сефиман боласыз ба?
Dialogue: 0,1:33:59.05,1:34:03.03,Default,,0,0,0,,Әй, бұлт мұны біледі ме?
Dialogue: 0,1:34:04.08,1:34:05.07,Default,,0,0,0,,Мүмкін
Dialogue: 0,1:34:06.05,1:34:07.05,Default,,0,0,0,,Мен көрдім.
Dialogue: 0,1:34:09.02,1:34:10.06,Default,,0,0,0,,Мені жалғыз қалдырыңыз
Dialogue: 0,1:34:10.07,1:34:13.05,Default,,0,0,0,,Түсінбедім, түсіндіріңізші!
Dialogue: 0,1:34:13.06,1:34:14.09,Default,,0,0,0,,Бұл киска туралы.
Dialogue: 0,1:34:15.02,1:34:17.01,Default,,0,0,0,,Кемсітушілік! Сабетсу!
Dialogue: 0,1:34:17.02,1:34:19.01,Default,,0,0,0,,Кішкентай қыз, үндеме!
Dialogue: 0,1:34:19.02,1:34:21.03,Default,,0,0,0,,Ер адамдар да түсінбейді.
Dialogue: 0,1:34:21.03,1:34:22.04,Default,,0,0,0,,2 жыл бұрын
Dialogue: 0,1:34:24.01,1:34:27.08,Default,,0,0,0,,Соңғы шайқас кезінде болған күшті сезімдер.
Dialogue: 0,1:34:28.06,1:34:33.01,Default,,0,0,0,,Бар болғаны екі жыл болса да, сол сезімді білмей тұрып жоғалттым
Dialogue: 0,1:34:33.09,1:34:36.05,Default,,0,0,0,,Менің ойымша, бұлт оны қалпына келтірді.
Dialogue: 0,1:34:37.01,1:34:39.05,Default,,0,0,0,,Цк... 10 минут күтемін
Dialogue: 0,1:34:39.06,1:34:42.09,Default,,0,0,0,,Бұлт әлі секіреді.
Dialogue: 0,1:34:44.01,1:34:45.04,Default,,0,0,0,,Адал
Dialogue: 0,1:36:01.06,1:36:05.06,Default,,0,0,0,,Мен саған кәсіподағымды көрсетемін
Dialogue: 0,1:36:26.05,1:36:29.06,Default,,0,0,0,,Біраз болды, Бұлт.
Dialogue: 0,1:36:44.09,1:36:46.08,Default,,0,0,0,,Жұлдызды тыртықтарыңызды жоғалттыңыз ба?
Dialogue: 0,1:36:48.09,1:36:50.03,Default,,0,0,0,,Өкінішті
Dialogue: 0,1:36:50.04,1:36:53.03,Default,,0,0,0,,Сен нені қалайсың?
Dialogue: 0,1:36:53.07,1:36:56.06,Default,,0,0,0,,Жұлдызша таңбалы өлгендердің ойлары
Dialogue: 0,1:36:57.04,1:37:00.08,Default,,0,0,0,,Тіршілік циклімен жұлдыздарды айналып өтеді
Dialogue: 0,1:37:01.02,1:37:03.08,Default,,0,0,0,,Ол ақырында жұлдыздарды жояды.
Dialogue: 0,1:37:04.07,1:37:07.02,Default,,0,0,0,,Менің қалағаным, Бұлт
Dialogue: 0,1:37:08.03,1:37:12.02,Default,,0,0,0,,Бұл жұлдызды кеме ретінде пайдаланып, ғарыштың қараңғылығын аралау.
Dialogue: 0,1:37:13.07,1:37:16.07,Default,,0,0,0,,Бір кездегі анам сияқты.
Dialogue: 0,1:37:23.07,1:37:27.00,Default,,0,0,0,,Уақыт өте келе біз жаңа жұлдызды ашамыз
Dialogue: 0,1:37:27.02,1:37:30.00,Default,,0,0,0,,Ауданда жарқын болашақ құру
Dialogue: 0,1:37:30.05,1:37:32.01,Default,,0,0,0,,Бұл планетамен не болады?
Dialogue: 0,1:37:32.07,1:37:36.03,Default,,0,0,0,,Енді... бұл сізге байланысты.
Dialogue: 0,1:37:57.08,1:37:59.01,Default,,0,0,0,,Әпке?
Dialogue: 0,1:38:44.06,1:38:47.08,Default,,0,0,0,,Сізді не күшті етті?
Dialogue: 0,1:38:48.03,1:38:50.00,Default,,0,0,0,,Мен сізге айтқым келмейді
Dialogue: 0,1:39:25.04,1:39:28.03,Default,,0,0,0,,Мен саған сыйлық ойладым.
Dialogue: 0,1:39:35.00,1:39:36.08,Default,,0,0,0,,Үмітіңді түсірейін бе?
Dialogue: 0,1:39:47.03,1:39:51.00,Default,,0,0,0,,Маған қалай тізе бүгіп, кешірім сұрайтыныңды көрсет.
Dialogue: 0,1:41:42.05,1:41:46.03,Default,,0,0,0,,Сол кездегі ауыртпалық есіңізде ме? Бұлт
Dialogue: 0,1:41:47.08,1:41:52.03,Default,,0,0,0,,Енді ұмытылмас азапты тағы бір рет ойып алайық
Dialogue: 0,1:42:19.02,1:42:21.08,Default,,0,0,0,,Сіз үшін ең маңыздысы не?
Dialogue: 0,1:42:23.07,1:42:26.03,Default,,0,0,0,,Оны алып кетудің қуанышын маған сыйлайсың ба?
Dialogue: 0,1:42:33.02,1:42:35.05,Default,,0,0,0,,Мен болсам, мен әлі берілмес едім.
Dialogue: 0,1:42:35.08,1:42:38.03,Default,,0,0,0,,Тіпті үмітсіз жағдайда
Dialogue: 0,1:42:41.09,1:42:43.05,Default,,0,0,0,,Армандарыңызды қабылдаңыз
Dialogue: 0,1:42:43.09,1:42:47.09,Default,,0,0,0,,Солдаттың намысын ешқашан жіберме.
Dialogue: 0,1:42:48.06,1:42:53.05,Default,,0,0,0,,Жарайды, мен солдат болған жоқпын.
Dialogue: 0,1:42:54.07,1:42:56.01,Default,,0,0,0,,Za'x
Dialogue: 0,1:42:57.05,1:43:00.00,Default,,0,0,0,,Қолыңды созғанымды қалайсың ба?
Dialogue: 0,1:43:07.05,1:43:11.00,Default,,0,0,0,,Бұл мен бір рет жеңген қарсыласым. Бұл оңай жеңіс емес.
Dialogue: 0,1:43:12.00,1:43:13.00,Default,,0,0,0,,О
Dialogue: 0,1:43:15.08,1:43:18.09,Default,,0,0,0,,Ұмытпа...
Dialogue: 0,1:43:19.09,1:43:24.02,Default,,0,0,0,,Мен сенің тірі дәлеліңмін.
Dialogue: 0,1:43:32.02,1:43:35.07,Default,,0,0,0,,... Өкінішті, сен ештеңе түсінбейсің.
Dialogue: 0,1:43:37.04,1:43:39.05,Default,,0,0,0,,Маңызды емес ештеңе жоқ.
Dialogue: 0,1:44:16.02,1:44:20.00,Default,,0,0,0,,Менің естеліктерімде тыныш бол
Dialogue: 0,1:44:25.08,1:44:27.01,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,1:44:28.04,1:44:30.06,Default,,0,0,0,,Бұл естелік болмайды
Dialogue: 0,1:45:01.03,1:45:02.07,Default,,0,0,0,,Аға
Dialogue: 0,1:45:05.02,1:45:06.07,Default,,0,0,0,,Кадайчижу?
Dialogue: 0,1:45:08.07,1:45:09.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:45:21.00,1:45:24.02,Default,,0,0,0,,Мен сонша тырысуды доғарайын ба?
Dialogue: 0,1:45:29.07,1:45:32.02,Default,,0,0,0,,Ана...?
Dialogue: 0,1:45:33.05,1:45:36.03,Default,,0,0,0,,Барлығына қайта ораламыз ба?
Dialogue: 0,1:45:38.07,1:45:39.07,Default,,0,0,0,,Иә
Dialogue: 0,1:47:01.05,1:47:02.08,Default,,0,0,0,,Иә! Ол қандай?
Dialogue: 0,1:47:02.09,1:47:04.04,Default,,0,0,0,,Мен айтқанымдай!
Dialogue: 0,1:47:04.04,1:47:06.05,Default,,0,0,0,,Әй, Бұлт-сан адам ғой!
Dialogue: 0,1:47:06.06,1:47:08.07,Default,,0,0,0,,Егер сіз тырыссаңыз, бұлт мұны істей алады.
Dialogue: 0,1:47:08.08,1:47:10.08,Default,,0,0,0,,Балалар сендер дұрыс ұстадыңдар.
Dialogue: 0,1:47:20.00,1:47:23.08,Default,,0,0,0,,Сіз осында болдыңыз, солай емес пе?
Dialogue: 0,1:47:25.00,1:47:26.05,Default,,0,0,0,,Рахмет
Dialogue: 0,1:48:07.08,1:48:11.00,Default,,0,0,0,,Үйге бірге барайық
Dialogue: 0,1:48:15.08,1:48:19.00,Default,,0,0,0,,Ендеше бірге ойнайық
Dialogue: 0,1:48:44.08,1:48:45.09,Default,,0,0,0,,Бұлт!
Dialogue: 0,1:48:52.03,1:48:55.00,Default,,0,0,0,,...Бұлт да қайтады.
Dialogue: 0,1:49:18.03,1:49:19.01,Default,,0,0,0,,Кеттік
Dialogue: 0,1:49:19.02,1:49:20.01,Default,,0,0,0,,Иә
Dialogue: 0,1:50:44.04,1:50:45.05,Default,,0,0,0,,Ана...?
Dialogue: 0,1:50:47.02,1:50:48.02,Default,,0,0,0,,Тағы да!
Dialogue: 0,1:50:48.06,1:50:52.01,Default,,0,0,0,,Сіз мені қанша рет ана деп атадыңыз?
Dialogue: 0,1:50:54.02,1:50:56.06,Default,,0,0,0,,Таңдану жақсы.
Dialogue: 0,1:50:57.08,1:51:00.08,Default,,0,0,0,,Маған мұндай үлкен бала керек емес.
Dialogue: 0,1:51:02.01,1:51:07.00,Default,,0,0,0,,Кешіріңіз, сіздің орныңыз бұл жерде емес.
Dialogue: 0,1:52:04.08,1:52:06.00,Default,,0,0,0,,Менің әпкем
Dialogue: 0,1:52:06.04,1:52:08.04,Default,,0,0,0,,Өйткені бұлт осында келе жатыр
Dialogue: 0,1:52:10.08,1:52:12.03,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:52:23.00,1:52:24.01,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:52:27.09,1:52:30.05,Default,,0,0,0,,Жұлдызының ізі әлі кетпеген балалар бар.
Dialogue: 0,1:52:31.08,1:52:32.06,Default,,0,0,0,,О
Dialogue: 0,1:52:39.04,1:52:42.04,Default,,0,0,0,,Енді сені сауықтырайық.
Dialogue: 0,1:52:45.06,1:52:47.04,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,1:52:49.00,1:52:50.03,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,1:53:43.03,1:53:45.02,Default,,0,0,0,,Енді секіріңіз!
Dialogue: 0,1:53:45.03,1:53:46.05,Default,,0,0,0,,емделген емделген
Dialogue: 0,1:54:34.06,1:54:38.02,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,1:54:59.02,1:55:00.04,Default,,0,0,0,,Иә
Dialogue: 0,1:55:02.07,1:55:03.07,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,1:55:06.00,1:55:07.06,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,1:55:08.56,1:55:13.56,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
