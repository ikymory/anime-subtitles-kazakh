Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:37.77,0:01:39.77,Default,,0,0,0,,Жою және құру
Dialogue: 0,0:01:41.40,0:01:44.27,Default,,0,0,0,,Адамдар неліктен қайталайды?
Dialogue: 0,0:01:45.69,0:01:48.11,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:01:53.07,0:01:56.45,Default,,0,0,0,,Адамдардың есте сақтау қабілеті нашар.
Dialogue: 0,0:01:56.95,0:01:59.29,Default,,0,0,0,,Ендеше көркейтіп, кеңейе бер
Dialogue: 0,0:01:59.96,0:02:04.29,Default,,0,0,0,,Ауырсынуды сағынышқа айналдырып, өткенді жеңуге тырысу
Dialogue: 0,0:02:05.63,0:02:07.96,Default,,0,0,0,,Мен анамды қайтаруға тырыстым
Dialogue: 0,0:02:08.51,0:02:10.05,Default,,0,0,0,,Бұл естеліктерге байланысты ма?
Dialogue: 0,0:02:12.59,0:02:16.64,Default,,0,0,0,,Бұл қазіргі қиындықтарды жою.
Dialogue: 0,0:02:17.35,0:02:19.81,Default,,0,0,0,,Сіз жұлдыз тыртықтары туралы айтып отырсыз ба?
Dialogue: 0,0:02:20.44,0:02:23.31,Default,,0,0,0,,Бірақ басында бәрі сен кінәлі.
Dialogue: 0,0:02:25.36,0:02:26.73,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:27.48,0:02:31.61,Default,,0,0,0,,Сіз де есте сақтауда жақсы емессіз.
Dialogue: 0,0:02:33.11,0:02:35.62,Default,,0,0,0,,Жоқ, мен.
Dialogue: 0,0:02:36.37,0:02:38.91,Default,,0,0,0,,Нағыз ұмытшақ
Dialogue: 0,0:02:54.05,0:02:55.35,Default,,0,0,0,,Цен мырза!
Dialogue: 0,0:02:55.72,0:02:57.01,Default,,0,0,0,,бүгін өте ұзақ күн болды, мен қатты шаршадым…
Dialogue: 0,0:03:01.27,0:03:02.52,Default,,0,0,0,,Бұл хит.
Dialogue: 0,0:03:03.48,0:03:05.52,Default,,0,0,0,,...Бұл жиіркенішті.
Dialogue: 0,0:03:06.77,0:03:09.15,Default,,0,0,0,,Жарайды, асығыңыз.
Dialogue: 0,0:03:09.23,0:03:10.86,Default,,0,0,0,,Рено тануму
Dialogue: 0,0:03:11.61,0:03:12.86,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:28.71,0:03:29.88,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:03:30.38,0:03:32.05,Default,,0,0,0,,Сенпай, тезірек!
Dialogue: 0,0:03:34.55,0:03:35.55,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,0:03:36.05,0:03:37.72,Default,,0,0,0,,Бұл кім? ?
Dialogue: 0,0:03:41.06,0:03:41.89,Default,,0,0,0,,Депрессия
Dialogue: 0,0:03:42.77,0:03:43.73,Default,,0,0,0,,Ирина!
Dialogue: 0,0:03:45.31,0:03:46.98,Default,,0,0,0,,Жүр!
Dialogue: 0,0:03:56.28,0:03:57.24,Default,,0,0,0,,Цен мырза!
Dialogue: 0,0:04:42.83,0:04:44.79,Default,,0,0,0,,Өмір ағыны
Dialogue: 0,0:04:45.54,0:04:49.38,Default,,0,0,0,,Бұл жұлдыздардың айналасындағы тіршілік ағымы
Dialogue: 0,0:04:49.67,0:04:54.46,Default,,0,0,0,,Бұл жұлдыздардың және оларда тіршілік ететін барлық тіршіліктің қайнар көзі.
Dialogue: 0,0:04:55.88,0:04:59.30,Default,,0,0,0,,Shinra компаниясы Lifestream құрды.
Dialogue: 0,0:04:59.39,0:05:02.97,Default,,0,0,0,,Ресурс ретінде пайдаланудың жолын тапты
Dialogue: 0,0:05:03.31,0:05:06.81,Default,,0,0,0,,Соның арқасында біздің өміріміз
Dialogue: 0,0:05:06.94,0:05:09.23,Default,,0,0,0,,Мен өте бай болдым.
Dialogue: 0,0:05:09.81,0:05:13.98,Default,,0,0,0,,Бірақ бұл жұлдыздың өмірін қысқарту дегенді білдіреді.
Dialogue: 0,0:05:14.07,0:05:17.15,Default,,0,0,0,,Көп адамдар осылай ойлады.
Dialogue: 0,0:05:18.91,0:05:22.83,Default,,0,0,0,,Шинра оларға қарсы шыққандарды жояды.
Dialogue: 0,0:05:22.99,0:05:25.58,Default,,0,0,0,,Күшпен тежеуге тырысты
Dialogue: 0,0:05:26.62,0:05:31.84,Default,,0,0,0,,Шинраның Сарбаздар деп аталатын арнайы сарбаздары болды.
Dialogue: 0,0:05:32.42,0:05:35.76,Default,,0,0,0,,Баяғыда аспаннан түскен
Dialogue: 0,0:05:35.84,0:05:38.76,Default,,0,0,0,,Бұл планетаны жоюға тырысқан апат
Dialogue: 0,0:05:39.26,0:05:42.80,Default,,0,0,0,,Бұл генуездік жасушалар имплантацияланған адамдар.
Dialogue: 0,0:05:43.76,0:05:46.77,Default,,0,0,0,,Олардың ішінде Сефирот бар.
Dialogue: 0,0:05:46.85,0:05:49.85,Default,,0,0,0,,Өте дарынды жауынгер болған.
Dialogue: 0,0:05:50.98,0:05:55.82,Default,,0,0,0,,Бірақ мен қорқынышты экспериментте туылғанымды білдім.
Dialogue: 0,0:05:55.90,0:05:58.70,Default,,0,0,0,,Мен Шинраны жек көре бастадым.
Dialogue: 0,0:05:59.07,0:06:04.12,Default,,0,0,0,,Мен мұны білмей тұрып, бәрін жек көре бастадым.
Dialogue: 0,0:06:05.79,0:06:09.79,Default,,0,0,0,,Шинра және оған қарсы шыққандар
Dialogue: 0,0:06:10.58,0:06:15.88,Default,,0,0,0,,Сефирот жек көрушіліктен планетаны жоюға тырысады.
Dialogue: 0,0:06:16.55,0:06:19.17,Default,,0,0,0,,Сефиротты тоқтатуға тырысатын адамдар
Dialogue: 0,0:06:19.97,0:06:22.89,Default,,0,0,0,,Көптеген шайқастар болды
Dialogue: 0,0:06:24.22,0:06:28.02,Default,,0,0,0,,Қанша шайқас болса, сонша қайғы болды.
Dialogue: 0,0:06:28.85,0:06:34.40,Default,,0,0,0,,Сүйген адамым да өмір ағымына айналды.
Dialogue: 0,0:06:36.57,0:06:39.03,Default,,0,0,0,,Және сол күні
Dialogue: 0,0:06:39.36,0:06:40.82,Default,,0,0,0,,Тағдырлы күн
Dialogue: 0,0:06:41.28,0:06:46.41,Default,,0,0,0,,Барлық шайқастарды аяқтаған жұлдыздардың күші болды.
Dialogue: 0,0:06:47.70,0:06:52.37,Default,,0,0,0,,Жұлдыздар өмір ағынын қару ретінде пайдаланды.
Dialogue: 0,0:06:53.37,0:06:56.42,Default,,0,0,0,,Жерге ұшып кеткен күріш пен шоқ
Dialogue: 0,0:06:56.63,0:07:00.26,Default,,0,0,0,,Конфликт Амбиция Қайғылылық
Dialogue: 0,0:07:00.42,0:07:03.09,Default,,0,0,0,,Мен бәрін жұтып қойдым.
Dialogue: 0,0:07:07.01,0:07:11.10,Default,,0,0,0,,Қайғыға айырбас, бәрі бітті.
Dialogue: 0,0:07:11.23,0:07:14.52,Default,,0,0,0,,Бұл маған екі жыл бұрын айтылған.
Dialogue: 0,0:08:12.41,0:08:13.83,Default,,0,0,0,,Ей, кеттік
Dialogue: 0,0:08:14.00,0:08:14.66,Default,,0,0,0,,Иә
Dialogue: 0,0:08:16.25,0:08:17.67,Default,,0,0,0,,Уау, бұл қауіпті.
Dialogue: 0,0:08:35.31,0:08:37.19,Default,,0,0,0,,Бірақ... жұлдыздар
Dialogue: 0,0:08:37.35,0:08:42.82,Default,,0,0,0,,Сіз біз ойлағаннан әлдеқайда ашуланған сияқтысыз.
Dialogue: 0,0:08:47.45,0:08:49.78,Default,,0,0,0,,Жұлдыздық тыртық синдромы
Dialogue: 0,0:08:53.79,0:08:55.50,Default,,0,0,0,,Сәлем, Марин?
Dialogue: 0,0:08:55.75,0:08:57.04,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:09:00.63,0:09:02.05,Default,,0,0,0,,Жарайды, мен кеттім. Қош бол.
Dialogue: 0,0:09:02.17,0:09:05.80,Default,,0,0,0,,Дензелді өзіңізбен бірге алып кетпеңіз.
Dialogue: 0,0:09:13.18,0:09:16.56,Default,,0,0,0,,Тергеу комиссиясының бүгін таңертең жарияланған есебіне сәйкес.
Dialogue: 0,0:09:16.68,0:09:21.06,Default,,0,0,0,,Атмосферадағы тіршілік ағынының концентрациясы екі жыл бұрынғыдан шамамен 1/100 құрайды.
Dialogue: 0,0:09:21.23,0:09:25.03,Default,,0,0,0,,Деңгейі адам ағзасына әсер етпейтін деңгейге дейін төмендеді дейді.
Dialogue: 0,0:09:25.32,0:09:26.90,Default,,0,0,0,,Алайда, Шинра компаниясының бас кеңсесі...
Dialogue: 0,0:09:27.03,0:09:29.53,Default,,0,0,0,,Ол енді мұнда емес.
Dialogue: 0,0:09:30.11,0:09:31.91,Default,,0,0,0,,...әлі де қауіпті деңгейде
Dialogue: 0,0:09:32.03,0:09:34.91,Default,,0,0,0,,Жұлдыз тыртықтарының пайда болуын болдырмау үшін нысанның айналасындағы аумақ болуы керек
Dialogue: 0,0:09:35.08,0:09:38.58,Default,,0,0,0,,Комитет сізге алыс болуды ескертеді.
Dialogue: 0,0:09:39.71,0:09:43.92,Default,,0,0,0,,Келесі - Shinra компаниясына қарсы өтемақы талаптары туралы жаңалықтар.
Dialogue: 0,0:09:46.34,0:09:47.72,Default,,0,0,0,,Бұлт...
Dialogue: 0,0:09:48.09,0:09:49.84,Default,,0,0,0,,Қайдасың...
Dialogue: 0,0:10:02.44,0:10:04.86,Default,,0,0,0,,Иә Strife жеткізу қызметі
Dialogue: 0,0:10:05.02,0:10:06.40,Default,,0,0,0,,Біздің компания барлығын жасайды...
Dialogue: 0,0:10:08.11,0:10:09.95,Default,,0,0,0,,...Сен қайсысысың?
Dialogue: 0,0:10:15.62,0:10:17.62,Default,,0,0,0,,есімде.
Dialogue: 0,0:10:38.89,0:10:41.23,Default,,0,0,0,,Маған Хилиндегі Рено қоңырау шалды.
Dialogue: 0,0:10:41.35,0:10:43.06,Default,,0,0,0,,Тіпті жұмысқа сұраныс
Dialogue: 0,0:10:43.31,0:10:45.82,Default,,0,0,0,,Бұлт... Қалдарың қалай?
Dialogue: 0,0:10:46.48,0:10:48.82,Default,,0,0,0,,Бұл хабар үшін
Dialogue: 0,0:11:57.89,0:12:01.56,Default,,0,0,0,,Әй, Қадаж, бұл сенің ағаңның қаласы ма?
Dialogue: 0,0:12:02.73,0:12:03.56,Default,,0,0,0,,О
Dialogue: 0,0:12:04.14,0:12:06.65,Default,,0,0,0,,Олар сізді қарсы алады деп ойлайсыз ба?
Dialogue: 0,0:12:06.77,0:12:07.56,Default,,0,0,0,,Ақылға қонымсыз
Dialogue: 0,0:12:07.90,0:12:09.69,Default,,0,0,0,,Жылама, Язу
Dialogue: 0,0:12:10.48,0:12:12.82,Default,,0,0,0,,Анаң да сенің жаныңда, солай ма?
Dialogue: 0,0:12:14.20,0:12:15.82,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:12:16.49,0:12:17.87,Default,,0,0,0,,Жылама, Таяқтар
Dialogue: 0,0:12:24.41,0:12:26.42,Default,,0,0,0,,Қарашы, бұл менің ағам.
Dialogue: 0,0:13:06.12,0:13:07.87,Default,,0,0,0,,Менің анам қайда?
Dialogue: 0,0:13:12.46,0:13:14.26,Default,,0,0,0,,Сенің ағаң жасырып жатыр, солай ма?
Dialogue: 0,0:13:23.64,0:13:26.43,Default,,0,0,0,,Сіз мені алдаған шығарсыз?
Dialogue: 0,0:13:26.81,0:13:28.81,Default,,0,0,0,,Сенің анаң солай ғой, солай ма?
Dialogue: 0,0:13:30.06,0:13:31.65,Default,,0,0,0,,Айқайламаңыз
Dialogue: 0,0:13:33.69,0:13:35.82,Default,,0,0,0,,Мен сенімен сөйлескім келмейді
Dialogue: 0,0:13:37.24,0:13:38.95,Default,,0,0,0,,Президент атынан
Dialogue: 0,0:15:03.03,0:15:05.07,Default,,0,0,0,,Сіз қашып кеткен жоқсыз, солай ма?
Dialogue: 0,0:15:09.50,0:15:12.92,Default,,0,0,0,,Эй, бұл Баррет! Мен оны істедім! Бұл жаңа мұнай кен орны!
Dialogue: 0,0:15:13.08,0:15:16.50,Default,,0,0,0,,Юден! Ол шынымен үлкен.
Dialogue: 0,0:15:16.59,0:15:19.76,Default,,0,0,0,,Енді менде жоспар бар, мен жақында Маринді көретін боламын!
Dialogue: 0,0:15:19.92,0:15:21.76,Default,,0,0,0,,Айтыңызшы.
Dialogue: 0,0:15:25.72,0:15:27.76,Default,,0,0,0,,Леноның тағы бір күн күркіреуі.
Dialogue: 0,0:15:28.14,0:15:29.89,Default,,0,0,0,,Тезірек.
Dialogue: 0,0:15:30.47,0:15:34.23,Default,,0,0,0,,Ол біртүрлі көрінді...бірақ абай болыңыз.
Dialogue: 0,0:15:56.96,0:15:58.04,Default,,0,0,0,,Иә~
Dialogue: 0,0:16:03.59,0:16:05.47,Default,,0,0,0,,Күтілгендей.
Dialogue: 0,0:16:14.73,0:16:16.65,Default,,0,0,0,,Людо! керемет!
Dialogue: 0,0:16:25.11,0:16:28.28,Default,,0,0,0,,Өзін-өзі жариялаған бұрынғы сарбаз күткендей.
Dialogue: 0,0:16:36.75,0:16:38.96,Default,,0,0,0,,Сіздің қолыңыз түтіккен сияқты емес.
Dialogue: 0,0:16:45.97,0:16:47.68,Default,,0,0,0,,Бұл Руфус па?
Dialogue: 0,0:16:49.01,0:16:50.35,Default,,0,0,0,,Сіз де жазылмайсыз.
Dialogue: 0,0:16:55.85,0:16:56.81,Default,,0,0,0,,Сол күні мен...
Dialogue: 0,0:16:56.89,0:16:57.77,Default,,0,0,0,,Мен саған не үшін керекпін?
Dialogue: 0,0:16:57.90,0:16:58.69,Default,,0,0,0,,Ғимарат құламас бұрын...
Dialogue: 0,0:16:58.81,0:16:59.86,Default,,0,0,0,,Маған кім шабуыл жасады?
Dialogue: 0,0:16:59.98,0:17:00.48,Default,,0,0,0,,38-тарау: Алтын тәжірибе · Реквием
Dialogue: 0,0:17:00.48,0:17:01.52,Default,,0,0,0,,Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,0:17:04.82,0:17:06.82,Default,,0,0,0,,...Маған күш-қуатыңызды беріңізші.
Dialogue: 0,0:17:06.95,0:17:07.61,Default,,0,0,0,,Мені қызықтырмайды.
Dialogue: 0,0:17:07.70,0:17:12.49,Default,,0,0,0,,Біз, Шинра компаниясы, әлем алдында үлкен қарыздармыз.
Dialogue: 0,0:17:12.87,0:17:15.96,Default,,0,0,0,,Дүниені осындай аянышты күйге келтіруге кім жауапты?
Dialogue: 0,0:17:16.04,0:17:19.04,Default,,0,0,0,,Бізде бар деуден пайда жоқ.
Dialogue: 0,0:17:19.29,0:17:23.21,Default,,0,0,0,,Сондықтан бұл қарыз барлық шығындармен өтелуі керек.
Dialogue: 0,0:17:23.30,0:17:24.38,Default,,0,0,0,,Оны ашыңыз.
Dialogue: 0,0:17:24.55,0:17:26.38,Default,,0,0,0,,Бірінші қадам ретінде
Dialogue: 0,0:17:26.67,0:17:30.30,Default,,0,0,0,,Біз Сефирот қалдырған әсерді зерттей бастадық.
Dialogue: 0,0:17:31.47,0:17:32.97,Default,,0,0,0,,Содан бері екі жыл өтті
Dialogue: 0,0:17:33.26,0:17:37.89,Default,,0,0,0,,Қалпына келтіру жолына түскен әлем үшін ең үлкен қауіп қандай?
Dialogue: 0,0:17:39.31,0:17:44.90,Default,,0,0,0,,Дұрыс, жиіркенішті жұлдыз тыртық синдромы.
Dialogue: 0,0:17:45.73,0:17:50.57,Default,,0,0,0,,Сефирот себепкер деп есептейміз.
Dialogue: 0,0:17:52.20,0:17:55.87,Default,,0,0,0,,Мако реакторы және әлемдегі мако энергиясы
Dialogue: 0,0:17:55.95,0:18:00.08,Default,,0,0,0,,Ал өмір ағыны жұлдыздардың тыртықтарының себебі болып саналады.
Dialogue: 0,0:18:00.46,0:18:03.21,Default,,0,0,0,,Бірақ шынымен солай ма?
Dialogue: 0,0:18:03.42,0:18:06.55,Default,,0,0,0,,Өмір ағындары жұлдыздардың тууымен бірге болады.
Dialogue: 0,0:18:06.63,0:18:10.76,Default,,0,0,0,,Мако энергиясының практикалық қолданысқа енгізілгеніне 40 жылдан астам уақыт өтті.
Dialogue: 0,0:18:11.01,0:18:12.72,Default,,0,0,0,,қарамастан
Dialogue: 0,0:18:12.80,0:18:16.10,Default,,0,0,0,,Жұлдыздық белгілер тарихта ешқашан пайда болмайды.
Dialogue: 0,0:18:16.93,0:18:17.93,Default,,0,0,0,,Сонымен
Dialogue: 0,0:18:18.27,0:18:21.94,Default,,0,0,0,,Біздің уақытта нақты не болды?
Dialogue: 0,0:18:22.35,0:18:24.73,Default,,0,0,0,,Бір ғана мүмкіндік бар
Dialogue: 0,0:18:25.48,0:18:27.11,Default,,0,0,0,,Сефирот пайда болады
Dialogue: 0,0:18:27.28,0:18:28.40,Default,,0,0,0,,Сефирот өлді
Dialogue: 0,0:18:28.49,0:18:30.61,Default,,0,0,0,,Оның ақыл-ойы ше?
Dialogue: 0,0:18:31.32,0:18:33.12,Default,,0,0,0,,Өмір ағымына ерітіңіз
Dialogue: 0,0:18:33.20,0:18:37.29,Default,,0,0,0,,Бірақ ол таралмай жұлдыздарды айналып жүрсе ше?
Dialogue: 0,0:18:39.16,0:18:43.13,Default,,0,0,0,,Әрине бұл менің қиялым ғана.
Dialogue: 0,0:18:43.25,0:18:46.30,Default,,0,0,0,,Бірақ бұл мүмкіндікті жоққа шығаруға болмайды
Dialogue: 0,0:18:46.80,0:18:50.42,Default,,0,0,0,,Шындықты білу жұлдызды тыртықтарды емдеуге де әкеледі.
Dialogue: 0,0:18:51.30,0:18:53.30,Default,,0,0,0,,Сонымен, біз...
Dialogue: 0,0:18:53.43,0:18:56.47,Default,,0,0,0,,Сефироттың іздерін зерттеуді бастады.
Dialogue: 0,0:18:56.72,0:18:57.97,Default,,0,0,0,,Бірінші...
Dialogue: 0,0:18:59.39,0:19:00.98,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:19:01.06,0:19:03.23,Default,,0,0,0,,Бұл солтүстіктегі үлкен үңгір.
Dialogue: 0,0:19:03.65,0:19:05.23,Default,,0,0,0,,Не болды деп ойлайсың?
Dialogue: 0,0:19:06.65,0:19:08.11,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:19:08.65,0:19:11.15,Default,,0,0,0,,Онда ештеңе болған жоқ.
Dialogue: 0,0:19:12.99,0:19:16.16,Default,,0,0,0,,Бірақ күтпеген жағдай болды.
Dialogue: 0,0:19:17.20,0:19:18.49,Default,,0,0,0,,Олар...
Dialogue: 0,0:19:18.83,0:19:20.66,Default,,0,0,0,,Пайда болды
Dialogue: 0,0:19:22.21,0:19:23.50,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:35.59,0:19:37.18,Default,,0,0,0,,Кадаждың бандысы
Dialogue: 0,0:19:38.64,0:19:40.02,Default,,0,0,0,,Kadaj...
Dialogue: 0,0:19:40.14,0:19:42.69,Default,,0,0,0,,Ол да сенен кейін келеді.
Dialogue: 0,0:19:42.85,0:19:44.85,Default,,0,0,0,,Байланыс болған жоқ па?
Dialogue: 0,0:19:44.98,0:19:46.19,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:19:46.31,0:19:48.52,Default,,0,0,0,,Мен оны міндетті түрде қайтарамын.
Dialogue: 0,0:19:48.65,0:19:49.65,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:50.19,0:19:54.70,Default,,0,0,0,,Сіз де біз сияқты Сефиротпен тығыз байланыста болдыңыз.
Dialogue: 0,0:19:55.36,0:20:00.45,Default,,0,0,0,,Кадаждың мақсаты сол сәтке дайындалу болса...
Dialogue: 0,0:20:00.54,0:20:03.62,Default,,0,0,0,,Жолда бізден артық ешкім жоқ.
Dialogue: 0,0:20:03.96,0:20:05.21,Default,,0,0,0,,Дайындық?
Dialogue: 0,0:20:06.92,0:20:08.54,Default,,0,0,0,,Сефирот...
Dialogue: 0,0:20:10.38,0:20:11.38,Default,,0,0,0,,Қайта тірілу
Dialogue: 0,0:20:11.51,0:20:12.67,Default,,0,0,0,,Әңгіме аяқталды ма?
Dialogue: 0,0:20:12.76,0:20:14.84,Default,,0,0,0,,Енді негізгі тақырыпқа көшейік.
Dialogue: 0,0:20:15.47,0:20:20.22,Default,,0,0,0,,Қадажға және басқаларға қарсы күресу үшін бізге сіздің күшіңіз керек.
Dialogue: 0,0:20:20.85,0:20:25.56,Default,,0,0,0,,Қол ұстасайық па? Бұрынғы солдат бұлт
Dialogue: 0,0:20:27.52,0:20:28.86,Default,,0,0,0,,Өзін-өзі жариялады
Dialogue: 0,0:20:32.90,0:20:36.70,Default,,0,0,0,,Ана дегенді қалай түсінесіңдер?
Dialogue: 0,0:20:36.82,0:20:38.03,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:20:38.70,0:20:40.99,Default,,0,0,0,,Кадаж бірдеңе деді ме?
Dialogue: 0,0:20:41.24,0:20:42.58,Default,,0,0,0,,Руфус
Dialogue: 0,0:20:43.41,0:20:45.08,Default,,0,0,0,,Не жасырып тұрсың?
Dialogue: 0,0:20:45.87,0:20:49.71,Default,,0,0,0,,Қасымда соғысатын жолдастарымнан ештеңе жасырмаймын.
Dialogue: 0,0:20:51.13,0:20:54.67,Default,,0,0,0,,Сізге де жұлдыз тыртықтары туралы ақпарат керек екеніне сенімдімін.
Dialogue: 0,0:20:55.13,0:20:57.93,Default,,0,0,0,,Бірге тұратын жетім балаларға
Dialogue: 0,0:21:00.10,0:21:03.93,Default,,0,0,0,,Балалардың жүзіне күлкі сыйлағың келмей ме?
Dialogue: 0,0:21:04.39,0:21:10.52,Default,,0,0,0,,Біздің түпкі мақсатымыз – бұлт әлемін қайта құру.
Dialogue: 0,0:21:19.36,0:21:19.95,Default,,0,0,0,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:21:20.07,0:21:24.91,Default,,0,0,0,,Мен сенен өтінемін, Бұлт, Шинра компаниясын қайта құру.
Dialogue: 0,0:21:26.46,0:21:27.96,Default,,0,0,0,,Мені қызықтырмайды.
Dialogue: 0,0:21:28.79,0:21:29.79,Default,,0,0,0,,Лено!
Dialogue: 0,0:21:53.52,0:21:55.82,Default,,0,0,0,,Бұлт осында өмір сүре ме?
Dialogue: 0,0:21:56.49,0:21:57.82,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:22:06.50,0:22:07.45,Default,,0,0,0,,Не?
Dialogue: 0,0:22:26.97,0:22:30.52,Default,,0,0,0,,Дензел сияқты! Бұлт та ауырып жатыр! ?
Dialogue: 0,0:22:32.60,0:22:34.11,Default,,0,0,0,,Маған айтсаңызшы.
Dialogue: 0,0:22:34.19,0:22:36.69,Default,,0,0,0,,Сіз ауырып қалдыңыз ба?
Dialogue: 0,0:22:36.98,0:22:39.15,Default,,0,0,0,,Мен жалғыз күресуге дайынмын.
Dialogue: 0,0:22:39.24,0:22:40.11,Default,,0,0,0,,Ұрыс?
Dialogue: 0,0:22:40.20,0:22:41.03,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:22:44.12,0:22:45.87,Default,,0,0,0,,Менің ұрысуға ниетім жоқ.
Dialogue: 0,0:22:46.70,0:22:47.79,Default,,0,0,0,,Тифа?
Dialogue: 0,0:22:50.91,0:22:51.87,Default,,0,0,0,,Теңізші үйге қайтайық
Dialogue: 0,0:22:54.67,0:22:56.71,Default,,0,0,0,,Жоқ, мен Бұлтпен кездескім келеді.
Dialogue: 0,0:23:01.30,0:23:02.38,Default,,0,0,0,,...Дұрыс.
Dialogue: 0,0:23:06.05,0:23:07.18,Default,,0,0,0,,Мен сені көргім келеді.
Dialogue: 0,0:23:07.31,0:23:08.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:08.93,0:23:11.73,Default,,0,0,0,,Әй, кездессек не істеуіміз керек?
Dialogue: 0,0:23:11.98,0:23:13.56,Default,,0,0,0,,Үйге бірге барайық!
Dialogue: 0,0:23:14.06,0:23:17.48,Default,,0,0,0,,Осының алдында мен сізге уағыз айтайын.
Dialogue: 0,0:23:17.77,0:23:19.23,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:23:21.86,0:23:24.57,Default,,0,0,0,,Енді бастық пен Иринаны іздеу керек.
Dialogue: 0,0:23:27.41,0:23:29.24,Default,,0,0,0,,Басқа қызметкерлердің ақпараты туралы не деуге болады?
Dialogue: 0,0:23:29.37,0:23:30.87,Default,,0,0,0,,Әзірге
Dialogue: 0,0:23:36.25,0:23:40.42,Default,,0,0,0,,Бұрынғы қызметкерлер... Мен күткеннен де көп адам келеді.
Dialogue: 0,0:23:40.92,0:23:42.42,Default,,0,0,0,,Маған қатты әсер етті.
Dialogue: 0,0:23:42.55,0:23:45.09,Default,,0,0,0,,Мен мұны қайталай аламын.
Dialogue: 0,0:23:45.80,0:23:49.43,Default,,0,0,0,,Өтелу - аман қалғандардың міндеті.
Dialogue: 0,0:23:51.98,0:23:53.94,Default,,0,0,0,,Содан бері екі жыл өтті.
Dialogue: 0,0:23:54.69,0:23:55.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:56.02,0:23:58.57,Default,,0,0,0,,2 жыл бар ма?
Dialogue: 0,0:24:00.28,0:24:02.11,Default,,0,0,0,,Бұл қорқынышты түс болды
Dialogue: 0,0:24:02.57,0:24:05.03,Default,,0,0,0,,Дүние жойылып кете жаздады
Dialogue: 0,0:24:05.28,0:24:07.41,Default,,0,0,0,,Бұл біздің кінәміз, Шинра.
Dialogue: 0,0:24:10.29,0:24:11.62,Default,,0,0,0,,Маңызды әңгіме
Dialogue: 0,0:24:11.75,0:24:14.12,Default,,0,0,0,,Мен оған қанша төлеуім керек деп ойлаймын.
Dialogue: 0,0:24:15.58,0:24:18.46,Default,,0,0,0,,Өйткені, бастық осында болса ғой.
Dialogue: 0,0:24:20.13,0:24:21.38,Default,,0,0,0,,Ирина да
Dialogue: 0,0:24:25.13,0:24:26.97,Default,,0,0,0,,Өтінемін аман бол...
Dialogue: 0,0:24:27.14,0:24:28.43,Default,,0,0,0,,Жарайды
Dialogue: 0,0:24:29.05,0:24:31.14,Default,,0,0,0,,Цен мырза да президентпен бірдей.
Dialogue: 0,0:24:31.64,0:24:33.27,Default,,0,0,0,,Бір рет дерлік қайтыс болды
Dialogue: 0,0:24:33.98,0:24:35.48,Default,,0,0,0,,Сәтсіздік күшті
Dialogue: 0,0:24:35.85,0:24:37.27,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:24:45.99,0:24:47.91,Default,,0,0,0,,Табылды...
Dialogue: 0,0:25:00.00,0:25:01.46,Default,,0,0,0,,Шіркеу дегеніміз не?
Dialogue: 0,0:25:04.09,0:25:06.17,Default,,0,0,0,,О, ана жерде ме?
Dialogue: 0,0:25:07.09,0:25:09.09,Default,,0,0,0,,Иә, мен күтемін.
Dialogue: 0,0:26:37.60,0:26:41.35,Default,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:26:42.69,0:26:46.44,Default,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:26:47.78,0:26:51.61,Default,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:26:52.86,0:26:56.74,Default,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:26:57.99,0:27:01.79,Default,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:27:36.95,0:27:37.91,Default,,0,0,0,,Бұлт
Dialogue: 0,0:27:38.03,0:27:40.33,Default,,0,0,0,,Маған телефон соғатындар сирек.
Dialogue: 0,0:27:40.66,0:27:42.00,Default,,0,0,0,,Қызу!
Dialogue: 0,0:27:45.08,0:27:46.13,Default,,0,0,0,,Бұлт?
Dialogue: 0,0:27:47.34,0:27:48.75,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:27:49.71,0:27:53.01,Default,,0,0,0,,Кім? Бұл бұлтты телефон емес пе?
Dialogue: 0,0:27:53.63,0:27:55.01,Default,,0,0,0,,Тұр, мен өзі қандай ұлтпын? Хехехе
Dialogue: 0,0:27:55.68,0:27:56.93,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:27:58.47,0:27:59.85,Default,,0,0,0,,Тұр, мен өзі қандай ұлтпын? Хехехе
Dialogue: 0,0:28:00.18,0:28:04.35,Default,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,0:28:07.02,0:28:09.52,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:28:18.37,0:28:19.70,Default,,0,0,0,,Не болды?Сенімен бәрі жақсы ма?
Dialogue: 0,0:28:20.37,0:28:22.79,Default,,0,0,0,,Бұлт! Бұлт! сен ондасың ба?
Dialogue: 0,0:28:30.88,0:28:31.88,Default,,0,0,0,,Эй!
Dialogue: 0,0:28:38.01,0:28:39.14,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:29:22.68,0:29:24.77,Default,,0,0,0,,Өтірікті жек көремін.
Dialogue: 0,0:29:25.02,0:29:28.27,Default,,0,0,0,,Бұл жаман болды. Мен бұл жолы шын боламын.
Dialogue: 0,0:29:28.52,0:29:30.52,Default,,0,0,0,,Ол сендерден қашып кетті.
Dialogue: 0,0:29:30.65,0:29:32.57,Default,,0,0,0,,Тікұшақтан құлаған сияқты
Dialogue: 0,0:29:33.07,0:29:34.94,Default,,0,0,0,,Бұл ақымақ әңгіме.
Dialogue: 0,0:29:35.99,0:29:37.95,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:29:38.49,0:29:39.91,Default,,0,0,0,,Ант етемін
Dialogue: 0,0:29:41.83,0:29:44.12,Default,,0,0,0,,Содан кейін бұл туралы ант етіңіз.
Dialogue: 0,0:29:51.33,0:29:52.63,Default,,0,0,0,,Мақсаты... не?
Dialogue: 0,0:29:52.79,0:29:55.63,Default,,0,0,0,,Маған анаңның күші керек.
Dialogue: 0,0:29:56.21,0:29:59.47,Default,,0,0,0,,Кездесу сөзсіз
Dialogue: 0,0:30:00.34,0:30:01.47,Default,,0,0,0,,Кездесу...
Dialogue: 0,0:30:02.05,0:30:05.47,Default,,0,0,0,,Анамның ұяшықтарын алған достар бір жерге жиналады.
Dialogue: 0,0:30:05.77,0:30:08.14,Default,,0,0,0,,Ал жұлдыздардан кек ал
Dialogue: 0,0:30:08.73,0:30:11.31,Default,,0,0,0,,Дайындық тұрақты түрде жүріп жатыр.
Dialogue: 0,0:30:12.06,0:30:16.74,Default,,0,0,0,,Қараңдаршы, анамды біреу жасырып қалды.
Dialogue: 0,0:30:16.90,0:30:17.94,Default,,0,0,0,,Дайындық?
Dialogue: 0,0:30:18.78,0:30:19.90,Default,,0,0,0,,Жұлдызды тыртық
Dialogue: 0,0:30:20.74,0:30:23.07,Default,,0,0,0,,Мұны президент те біледі.
Dialogue: 0,0:30:23.91,0:30:25.58,Default,,0,0,0,,Өмір ағымында
Dialogue: 0,0:30:25.66,0:30:28.33,Default,,0,0,0,,Мұның бәрі анамның тынымсыз еңбек еткен генетикалық ойларының арқасында.
Dialogue: 0,0:30:29.08,0:30:31.67,Default,,0,0,0,,Ал біз
Dialogue: 0,0:30:32.17,0:30:34.17,Default,,0,0,0,,Мен анамның қайда екенін де білмеймін.
Dialogue: 0,0:30:36.13,0:30:39.47,Default,,0,0,0,,Бұл аянышты, бірақ мен оған көмектесе алмаймын.
Dialogue: 0,0:30:40.01,0:30:42.76,Default,,0,0,0,,Өйткені біз ойлау формаларымыз.
Dialogue: 0,0:30:42.89,0:30:45.97,Default,,0,0,0,,Мен анамды тауып, онымен ұяшықтарымды бөліскенше.
Dialogue: 0,0:30:46.06,0:30:47.93,Default,,0,0,0,,Қалыпты күйге оралу мүмкін емес
Dialogue: 0,0:30:48.77,0:30:51.69,Default,,0,0,0,,Ойлар мен жұлдызшалар жеткіліксіз
Dialogue: 0,0:30:52.02,0:30:55.02,Default,,0,0,0,,Нағыз кездесу үшін
Dialogue: 0,0:30:55.19,0:30:56.36,Default,,0,0,0,,...Не айтып тұрсың?
Dialogue: 0,0:30:58.53,0:31:02.86,Default,,0,0,0,,Президент... сіз мұны түсінесіз бе?
Dialogue: 0,0:31:39.86,0:31:41.15,Default,,0,0,0,,(Иура) Жарайды, жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:31:43.86,0:31:45.74,Default,,0,0,0,,Уау! Жұлдызды тыртықтар!
Dialogue: 0,0:31:51.75,0:31:53.25,Default,,0,0,0,,Үйден шықпаңыз!
Dialogue: 0,0:32:08.26,0:32:09.10,Default,,0,0,0,,Бұл...
Dialogue: 0,0:32:39.84,0:32:41.92,Default,,0,0,0,,Сен үшін өмір сүрейік
Dialogue: 0,0:32:43.84,0:32:45.97,Default,,0,0,0,,Мен осылай шештім...
Dialogue: 0,0:32:46.30,0:32:49.30,Default,,0,0,0,,Әскери болғың келе ме? Іске сәт!
Dialogue: 0,0:32:49.39,0:32:51.06,Default,,0,0,0,,Эй, көңіл-күйің қалай?
Dialogue: 0,0:32:51.14,0:32:54.56,Default,,0,0,0,,Эй, сен Мидгарға жеткенде не істейсің?
Dialogue: 0,0:32:54.98,0:32:57.23,Default,,0,0,0,,Достар, солай ма?
Dialogue: 0,0:33:05.11,0:33:07.32,Default,,0,0,0,,Қария! Бір тастың артына тоқтаңыз!
Dialogue: 0,0:33:07.61,0:33:09.45,Default,,0,0,0,,Бұлт Түсейік!
Dialogue: 0,0:33:12.87,0:33:14.66,Default,,0,0,0,,Менің мақтанышым мен армандарым
Dialogue: 0,0:33:17.04,0:33:18.50,Default,,0,0,0,,Барлығын орындаңыз
Dialogue: 0,0:33:19.42,0:33:20.75,Default,,0,0,0,,Сіз
Dialogue: 0,0:33:22.84,0:33:24.92,Default,,0,0,0,,Менің өмірімнің дәлелі
Dialogue: 0,0:33:27.93,0:33:31.30,Default,,0,0,0,,Сол кезде мен ұмытпаймын деп ант еткенмін.
Dialogue: 0,0:33:32.51,0:33:33.47,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:33:34.43,0:33:35.52,Default,,0,0,0,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:33:42.86,0:33:45.11,Default,,0,0,0,,Көңілсіз болып көрінуді доғар.
Dialogue: 0,0:33:46.74,0:33:49.86,Default,,0,0,0,,Ашумен әрекет етудің қажеті жоқ
Dialogue: 0,0:33:51.41,0:33:53.99,Default,,0,0,0,,Өйткені бұлт
Dialogue: 0,0:33:54.99,0:33:56.29,Default,,0,0,0,,Сіз
Dialogue: 0,0:33:57.04,0:33:58.62,Default,,0,0,0,,Бұл қуыршақ.
Dialogue: 0,0:34:11.51,0:34:12.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:16.47,0:34:17.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:26.15,0:34:27.65,Default,,0,0,0,,Ойнаймыз ба?
Dialogue: 0,0:34:31.41,0:34:33.07,Default,,0,0,0,,Иә немесе жоқ
Dialogue: 0,0:34:35.79,0:34:37.08,Default,,0,0,0,,Анаң ше?
Dialogue: 0,0:34:38.62,0:34:39.25,Default,,0,0,0,,Әй?
Dialogue: 0,0:34:45.63,0:34:46.59,Default,,0,0,0,,Кусае
Dialogue: 0,0:34:48.76,0:34:50.26,Default,,0,0,0,,Әй, анаң ше?
Dialogue: 0,0:34:50.34,0:34:51.72,Default,,0,0,0,,Мұнда ешкім жоқ!
Dialogue: 0,0:34:53.39,0:34:56.01,Default,,0,0,0,,Олай болса ойнайық
Dialogue: 0,0:35:09.94,0:35:11.70,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:36:27.86,0:36:28.86,Default,,0,0,0,,Тифа!
Dialogue: 0,0:36:57.64,0:36:59.64,Default,,0,0,0,,Мұнда емес
Dialogue: 0,0:37:01.39,0:37:02.72,Default,,0,0,0,,Жылама
Dialogue: 0,0:37:04.77,0:37:05.69,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:37:06.23,0:37:07.40,Default,,0,0,0,,Әкел
Dialogue: 0,0:37:12.73,0:37:13.48,Default,,0,0,0,,Жалғасы
Dialogue: 0,0:38:12.79,0:38:13.46,Default,,0,0,0,,Бұлт...
Dialogue: 0,0:38:15.00,0:38:15.63,Default,,0,0,0,,Телефон қоңырау шалуда! Телефон...
Dialogue: 0,0:38:34.07,0:38:36.48,Default,,0,0,0,,Бұрынғы үшін кешіріңіз.
Dialogue: 0,0:38:38.65,0:38:39.74,Default,,0,0,0,,Рахмет
Dialogue: 0,0:38:44.03,0:38:44.95,Default,,0,0,0,,Иә
Dialogue: 0,0:38:48.16,0:38:49.33,Default,,0,0,0,,Інісі...
Dialogue: 0,0:38:51.75,0:38:53.42,Default,,0,0,0,,Ол кетті
Dialogue: 0,0:38:55.71,0:38:57.00,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:38:58.21,0:39:01.18,Default,,0,0,0,,Әй, сен де жұлдыздың тыртығысың, солай ма?
Dialogue: 0,0:39:02.34,0:39:04.10,Default,,0,0,0,,Сені емдейді дейді.
Dialogue: 0,0:39:57.06,0:39:57.65,Default,,0,0,0,,Тифа?
Dialogue: 0,0:40:00.65,0:40:01.65,Default,,0,0,0,,Тифа! !
Dialogue: 0,0:40:08.78,0:40:09.91,Default,,0,0,0,,Кеш болды...
Dialogue: 0,0:40:10.24,0:40:11.58,Default,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:40:14.04,0:40:15.71,Default,,0,0,0,,Бейтаныс
Dialogue: 0,0:40:17.42,0:40:18.00,Default,,0,0,0,,Теңіз! ?
Dialogue: 0,0:40:27.43,0:40:28.26,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:41:38.79,0:41:40.84,Default,,0,0,0,,Ауыр болды.
Dialogue: 0,0:41:41.50,0:41:44.84,Default,,0,0,0,,...Сіз балаларыңызбен бірге тұрдыңыз.
Dialogue: 0,0:41:45.30,0:41:46.84,Default,,0,0,0,,Ол бос.
Dialogue: 0,0:41:51.14,0:41:52.35,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:41:55.98,0:41:56.85,Default,,0,0,0,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:42:07.86,0:42:09.36,Default,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,0:42:22.88,0:42:25.38,Default,,0,0,0,,Тифа сені алып келгенімді қалайды.
Dialogue: 0,0:42:28.05,0:42:29.05,Default,,0,0,0,,Ұстау
Dialogue: 0,0:43:04.63,0:43:06.55,Default,,0,0,0,,Мені кім емдейді?
Dialogue: 0,0:43:09.92,0:43:10.84,Default,,0,0,0,,Маған сән журналының түсірілімінде қолданылған осы киімді берді
Dialogue: 0,0:43:13.97,0:43:17.56,Default,,0,0,0,,Иә... Мен енді ешкімді ойламаймын.
Dialogue: 0,0:43:36.28,0:43:38.70,Default,,0,0,0,,Оны ағаң жасырды ма...
Dialogue: 0,0:43:41.08,0:43:44.13,Default,,0,0,0,,Өмір ағымынан туған қуат
Dialogue: 0,0:43:47.17,0:43:51.97,Default,,0,0,0,,Осы материал арқылы біз де жаңа күшке ие боламыз...
Dialogue: 0,0:43:54.84,0:43:58.31,Default,,0,0,0,,Анаң оны саған қалдырды, солай ма?
Dialogue: 0,0:43:58.47,0:44:00.47,Default,,0,0,0,,О, мен сенімдімін
Dialogue: 0,0:44:01.14,0:44:03.64,Default,,0,0,0,,Ағаң да анаңды жасырып жүр ме?
Dialogue: 0,0:44:04.15,0:44:06.61,Default,,0,0,0,,Жоқ, бұл президент.
Dialogue: 0,0:44:07.23,0:44:11.61,Default,,0,0,0,,Шинра компаниясы әрқашан аналарды жасырғанды ​​ұнататын.
Dialogue: 0,0:44:12.86,0:44:16.91,Default,,0,0,0,,Олай болса, сізге тек Шинраға қатысты барлық жерлерді іздеу керек.
Dialogue: 0,0:44:17.32,0:44:21.33,Default,,0,0,0,,Иә, жақында достарымыз көп болады.
Dialogue: 0,0:44:22.12,0:44:24.17,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:44:26.42,0:44:27.96,Default,,0,0,0,,Бұған дейін...
Dialogue: 0,0:44:29.00,0:44:31.34,Default,,0,0,0,,Мен ағама шағым айтуым керек.
Dialogue: 0,0:44:32.21,0:44:35.26,Default,,0,0,0,,Саған бәрібір сияқты әрекет ет...
Dialogue: 0,0:44:36.22,0:44:38.93,Default,,0,0,0,,Мен шынымен жалғызбын
Dialogue: 0,0:44:40.35,0:44:40.97,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:44:41.52,0:44:42.48,Default,,0,0,0,,Кя!
Dialogue: 0,0:44:47.35,0:44:48.31,Default,,0,0,0,,Эй?
Dialogue: 0,0:45:09.38,0:45:11.21,Default,,0,0,0,,Рено және басқалар іздейді
Dialogue: 0,0:45:16.72,0:45:20.47,Default,,0,0,0,,Жұлдызды тыртық синдромы... солай ма?
Dialogue: 0,0:45:21.97,0:45:25.14,Default,,0,0,0,,Мен осылай өліп кете аламын...қалай ойлайсың?
Dialogue: 0,0:45:30.31,0:45:31.57,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:45:32.57,0:45:34.24,Default,,0,0,0,,Емдеу жоқ
Dialogue: 0,0:45:34.78,0:45:37.57,Default,,0,0,0,,Бірақ Дензел барын салуда.
Dialogue: 0,0:45:38.24,0:45:40.41,Default,,0,0,0,,Қашпа, неге бірге соғыспаймыз?
Dialogue: 0,0:45:40.57,0:45:43.16,Default,,0,0,0,,Барлығымыз бір-бірімізге көмектесіп, бар күшімізді салайық
Dialogue: 0,0:45:47.00,0:45:50.08,Default,,0,0,0,,Бұл нағыз отбасы емес, сондықтан жақсы емес.
Dialogue: 0,0:45:50.25,0:45:51.42,Default,,0,0,0,,Маған
Dialogue: 0,0:45:53.13,0:45:55.42,Default,,0,0,0,,Маған ешкім көмектесе алмайды деп ойлаймын
Dialogue: 0,0:45:56.55,0:45:59.76,Default,,0,0,0,,Отбасы болсын, достары болсын...
Dialogue: 0,0:46:00.43,0:46:01.60,Default,,0,0,0,,Ешкім
Dialogue: 0,0:46:04.77,0:46:06.56,Default,,0,0,0,,Шламды суспензия
Dialogue: 0,0:46:11.65,0:46:13.77,Default,,0,0,0,,Біле-шала, жалт-жұлт!
Dialogue: 0,0:46:14.61,0:46:17.28,Default,,0,0,0,,Сіз оны қанша уақытқа дейін сүйреп жатырсыз?
Dialogue: 0,0:46:17.78,0:46:18.95,Default,,0,0,0,,Оны таба алмайсыз ба?
Dialogue: 0,0:46:19.70,0:46:24.70,Default,,0,0,0,,Оны алып кеткендерін айтқан куәгер болды.
Dialogue: 0,0:46:24.95,0:46:26.12,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:46:26.20,0:46:27.91,Default,,0,0,0,,Ұмытшақ қала
Dialogue: 0,0:46:29.29,0:46:30.12,Default,,0,0,0,,жасырыну
Dialogue: 0,0:46:44.01,0:46:48.64,Default,,0,0,0,,Мен анамнан ерекше өкілеттік алдым.
Dialogue: 0,0:46:49.14,0:46:51.15,Default,,0,0,0,,Адамдарды азаптау
Dialogue: 0,0:46:52.44,0:46:54.48,Default,,0,0,0,,Бұл планетамен күресетін күш.
Dialogue: 0,0:46:57.94,0:47:01.66,Default,,0,0,0,,Негізінде бұл құдірет әркімде де бар.
Dialogue: 0,0:47:02.66,0:47:03.74,Default,,0,0,0,,Иә
Dialogue: 0,0:47:05.16,0:47:07.49,Default,,0,0,0,,Біз ағайындымыз
Dialogue: 0,0:47:08.54,0:47:10.12,Default,,0,0,0,,Өмір ағымына сіңген
Dialogue: 0,0:47:10.21,0:47:13.96,Default,,0,0,0,,Анасының генетикалық ой-пікірлерін мұра еткен таңдаулы ағалар
Dialogue: 0,0:47:16.09,0:47:16.80,Default,,0,0,0,,Бірақ
Dialogue: 0,0:47:18.96,0:47:21.51,Default,,0,0,0,,Жұлдыздар әркімнің жолында
Dialogue: 0,0:47:22.76,0:47:25.80,Default,,0,0,0,,Біздің өсуді тоқтатуға тырысу
Dialogue: 0,0:47:27.01,0:47:32.02,Default,,0,0,0,,Сол себепті денең ауырып, жүрегің енді берілгелі тұрғандай болады.
Dialogue: 0,0:47:34.86,0:47:36.69,Default,,0,0,0,,Мен сені емдеймін.
Dialogue: 0,0:47:37.69,0:47:40.19,Default,,0,0,0,,Ал анама барайық.
Dialogue: 0,0:47:40.57,0:47:44.99,Default,,0,0,0,,Бір отбасы болып, жұлдыздардан кек алайық!
Dialogue: 0,0:47:49.91,0:47:51.54,Default,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:48:38.75,0:48:40.00,Default,,0,0,0,,Дензел!
Dialogue: 0,0:48:44.34,0:48:45.43,Default,,0,0,0,,Дензел! !
Dialogue: 0,0:48:57.65,0:48:58.94,Default,,0,0,0,,Мама, қарашы
Dialogue: 0,0:49:00.07,0:49:02.78,Default,,0,0,0,,Менің тағы қаншама бауырларым бар.
Dialogue: 0,0:49:04.40,0:49:06.78,Default,,0,0,0,,Енді мен анаммен кездескенше
Dialogue: 0,0:49:06.91,0:49:08.95,Default,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,0:49:48.24,0:49:49.45,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:49:52.03,0:49:55.08,Default,,0,0,0,,Мен бұзылатын сияқты болсам да
Dialogue: 0,0:49:56.46,0:49:58.00,Default,,0,0,0,,Бұл жақсы нәрсе екеніне сенімдімін.
Dialogue: 0,0:50:00.00,0:50:01.25,Default,,0,0,0,,Question
Dialogue: 0,0:50:02.25,0:50:04.17,Default,,0,0,0,,Неге келдің?
Dialogue: 0,0:50:06.42,0:50:10.01,Default,,0,0,0,,Менің ойымша... кешіргім келеді.
Dialogue: 0,0:50:11.35,0:50:14.31,Default,,0,0,0,,Иә, мені кешіргім келеді.
Dialogue: 0,0:50:15.77,0:50:17.02,Default,,0,0,0,,Кімге?
Dialogue: 0,0:51:07.03,0:51:08.24,Default,,0,0,0,,Сіз бәрібір келдіңіз.
Dialogue: 0,0:51:08.61,0:51:09.99,Default,,0,0,0,,Мен балаларды алуға келдім.
Dialogue: 0,0:51:10.20,0:51:13.57,Default,,0,0,0,,Бұл кісі біздің ағамыз.
Dialogue: 0,0:51:13.91,0:51:18.16,Default,,0,0,0,,Бірақ, өкінішке орай.
Dialogue: 0,0:51:20.41,0:51:22.50,Default,,0,0,0,,Сен сатқынсың.
Dialogue: 0,0:51:25.75,0:51:27.05,Default,,0,0,0,,Бұлт!
Dialogue: 0,0:53:46.64,0:53:49.23,Default,,0,0,0,,Шынымен... маған ешкім көмектесе алмайды.
Dialogue: 0,0:53:50.52,0:53:53.15,Default,,0,0,0,,Винсент... не болып жатыр?
Dialogue: 0,0:53:55.44,0:53:57.03,Default,,0,0,0,,Мен мұнда жиі келемін.
Dialogue: 0,0:53:59.74,0:54:02.20,Default,,0,0,0,,Сондықтан мен Кадажды және басқаларды бақылап отырдым.
Dialogue: 0,0:54:04.04,0:54:05.41,Default,,0,0,0,,Жұлдыздың тыртықтары
Dialogue: 0,0:54:06.00,0:54:11.33,Default,,0,0,0,,Ағзада ұялаған бөгде заттарды кетіретін жүйенің шамадан тыс жұмыс істеуінен туындаған сияқты.
Dialogue: 0,0:54:13.80,0:54:17.09,Default,,0,0,0,,Дене ішінде тіршілік ағымына ұқсас ағын бар.
Dialogue: 0,0:54:17.88,0:54:21.60,Default,,0,0,0,,Ең жақын досыңызға айналған зұлым затпен күресіңіз.
Dialogue: 0,0:54:23.47,0:54:25.43,Default,,0,0,0,,Зиянды заттар...
Dialogue: 0,0:54:25.85,0:54:29.44,Default,,0,0,0,,Сефирот факторы Дженованың генетикалық ойы
Dialogue: 0,0:54:30.19,0:54:31.27,Default,,0,0,0,,Қалағаныңызша атаңыз
Dialogue: 0,0:54:33.73,0:54:34.78,Default,,0,0,0,,Бұл егжей-тегжейлі.
Dialogue: 0,0:54:35.69,0:54:37.11,Default,,0,0,0,,Цэн мен Ирина
Dialogue: 0,0:54:37.82,0:54:40.78,Default,,0,0,0,,Оны өлі күйінде осында әкелді.
Dialogue: 0,0:54:41.28,0:54:43.58,Default,,0,0,0,,Ол өте ұсқынсыз азаптауларға ұшыраған сияқты.
Dialogue: 0,0:54:44.70,0:54:46.45,Default,,0,0,0,,Мен сізге көмектесуге тырыстым, бірақ...
Dialogue: 0,0:54:47.91,0:54:50.12,Default,,0,0,0,,Хмм, мен білмеймін.
Dialogue: 0,0:54:50.58,0:54:51.79,Default,,0,0,0,,Азаптау?
Dialogue: 0,0:54:52.33,0:54:53.75,Default,,0,0,0,,Өзін-өзі өлтіру
Dialogue: 0,0:54:53.96,0:54:56.13,Default,,0,0,0,,Ол Дженованың басын алған сияқты.
Dialogue: 0,0:54:57.05,0:54:59.97,Default,,0,0,0,,Қадаждың іздеп жүрген анасы...
Dialogue: 0,0:55:00.13,0:55:03.26,Default,,0,0,0,,Аспан жіберген жиіркенішті істер
Dialogue: 0,0:55:03.47,0:55:04.55,Default,,0,0,0,,Генуя
Dialogue: 0,0:55:04.85,0:55:08.23,Default,,0,0,0,,Егер сізге ұнаса, Сефиротты қайтадан жасауға болады.
Dialogue: 0,0:55:09.77,0:55:10.81,Default,,0,0,0,,Kadaj...
Dialogue: 0,0:55:11.81,0:55:13.15,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:55:13.73,0:55:15.98,Default,,0,0,0,,Хмм, бұл туралы ойлағым да келмейді.
Dialogue: 0,0:55:27.91,0:55:28.66,Default,,0,0,0,,Теңіз!
Dialogue: 0,0:55:28.87,0:55:31.33,Default,,0,0,0,,Бұлт! Дензел! Дензел!
Dialogue: 0,0:55:31.46,0:55:32.67,Default,,0,0,0,,Тифа жақсы.
Dialogue: 0,0:55:32.96,0:55:34.50,Default,,0,0,0,,Мен Тифамен сөйлескім келеді!
Dialogue: 0,0:55:40.17,0:55:41.26,Default,,0,0,0,,Сізде бар ма?
Dialogue: 0,0:55:43.30,0:55:44.68,Default,,0,0,0,,(Ватару) Жылама—барыңды салдын ғой, иә?—
Dialogue: 0,0:55:47.06,0:55:49.98,Default,,0,0,0,,Винсент Маринді дүкенге жібере аласыз ба?
Dialogue: 0,0:55:50.68,0:55:52.77,Default,,0,0,0,,Мен Шинра жігіттерін тыңдаймын.
Dialogue: 0,0:55:52.85,0:55:53.69,Default,,0,0,0,,Келіспеймін
Dialogue: 0,0:55:53.85,0:55:54.86,Default,,0,0,0,,Кешігіп қалғаным үшін кешірім сұраймын.
Dialogue: 0,0:55:55.61,0:55:56.94,Default,,0,0,0,,Бұлт жеткілікті!
Dialogue: 0,0:55:57.07,0:56:00.19,Default,,0,0,0,,Неге бізді тыңдамайсың?
Dialogue: 0,0:56:03.99,0:56:04.99,Default,,0,0,0,,Теңіз
Dialogue: 0,0:56:05.70,0:56:07.37,Default,,0,0,0,,Тағы біраз күтіңіз.
Dialogue: 0,0:56:07.49,0:56:09.54,Default,,0,0,0,,Шайқас қазір басталуы керек.
Dialogue: 0,0:56:09.70,0:56:11.87,Default,,0,0,0,,Бірақ тек күресу жеткіліксіз.
Dialogue: 0,0:56:12.00,0:56:12.71,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:56:12.83,0:56:14.21,Default,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:56:14.37,0:56:17.88,Default,,0,0,0,,Бұлт... Бұл шайқас туралы ма?
Dialogue: 0,0:56:19.71,0:56:20.71,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:56:20.88,0:56:22.84,Default,,0,0,0,,Ұмытшақ қала
Dialogue: 0,0:56:23.93,0:56:25.05,Default,,0,0,0,,жасырыну
Dialogue: 0,0:56:28.76,0:56:29.85,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:56:36.73,0:56:38.23,Default,,0,0,0,,Мен Руфуспен сөйлесемін.
Dialogue: 0,0:56:38.32,0:56:39.40,Default,,0,0,0,,Қашпа!
Dialogue: 0,0:56:40.61,0:56:41.57,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:56:41.74,0:56:44.24,Default,,0,0,0,,Балаларды тапсақ та, қолымыздан ештеңе келмеуі мүмкін.
Dialogue: 0,0:56:44.49,0:56:46.99,Default,,0,0,0,,Мүмкін заттар қайтадан қайтымсыз болып қалатын шығар.
Dialogue: 0,0:56:47.07,0:56:48.33,Default,,0,0,0,,Бұл қорқынышты емес пе?
Dialogue: 0,0:56:48.41,0:56:51.20,Default,,0,0,0,,Бірақ қазіргі сәтті және әртүрлі нәрселерді қабылдаңыз.
Dialogue: 0,0:56:51.29,0:56:53.91,Default,,0,0,0,,Ауыр ма? Себебі оған көмектесу мүмкін емес, ол ауыр
Dialogue: 0,0:56:54.33,0:56:56.58,Default,,0,0,0,,Өз бетіңізше өмір сүре алмасаңыз, оған шыдау керек.
Dialogue: 0,0:56:57.00,0:56:58.38,Default,,0,0,0,,Жалғыз қалғың келмейді, солай ма?
Dialogue: 0,0:56:58.46,0:57:01.09,Default,,0,0,0,,Жауап бермесем де, телефонымды жібермеймін.
Dialogue: 0,0:57:04.93,0:57:07.93,Default,,0,0,0,,Жасырынатын жер.
Dialogue: 0,0:57:15.98,0:57:20.61,Default,,0,0,0,,Біз естеліктерімізді жоғалтып алдық па?
Dialogue: 0,0:57:26.45,0:57:30.03,Default,,0,0,0,,Себебі сен мені жалғыз қалдырдың, солай ма?
Dialogue: 0,0:57:31.12,0:57:33.20,Default,,0,0,0,,Шынында да діріл!
Dialogue: 0,0:57:33.95,0:57:34.75,Default,,0,0,0,,Эй
Dialogue: 0,0:57:35.16,0:57:37.12,Default,,0,0,0,,Мен сені кешіруім керек пе?
Dialogue: 0,0:57:40.46,0:57:42.96,Default,,0,0,0,,Күнәні кешіруге бола ма?
Dialogue: 0,0:57:44.01,0:57:45.30,Default,,0,0,0,,...оны қолданып көрмедім
Dialogue: 0,0:57:45.80,0:57:46.88,Default,,0,0,0,,Көріңіз бе?
Dialogue: 0,0:57:47.80,0:57:48.89,Default,,0,0,0,,Байқап көріңіз...
Dialogue: 0,0:57:54.02,0:57:55.31,Default,,0,0,0,,Марин Мен үйге бара жатырмын
Dialogue: 0,0:57:59.90,0:58:01.31,Default,,0,0,0,,Мен жасап көремін
Dialogue: 0,0:58:01.98,0:58:03.65,Default,,0,0,0,,Нәтижелер туралы сізге хабарлаймыз.
Dialogue: 0,0:58:23.59,0:58:27.92,Default,,0,0,0,,Мен Ривпін. Жұмысыңыз қалай?
Dialogue: 0,0:58:28.55,0:58:32.01,Default,,0,0,0,,Мен флайерді көрдім, бірақ бұл бизнес бола ма?
Dialogue: 0,0:58:32.10,0:58:34.18,Default,,0,0,0,,Бұлт-сан сияқты.
Dialogue: 0,0:58:34.72,0:58:36.02,Default,,0,0,0,,Қаласаңыз, мен сізге көмектескім келеді...
Dialogue: 0,0:58:36.14,0:58:38.35,Default,,0,0,0,,Маған Хилиндегі Рено телефон соғып, жұмыс сұрады.
Dialogue: 0,0:58:38.44,0:58:40.02,Default,,0,0,0,,Көптен бері көрмегелі, бұл Юффи.
Dialogue: 0,0:58:40.19,0:58:42.69,Default,,0,0,0,,Көрдің бе, балалар Утайдан жоғалып кетті.
Dialogue: 0,0:58:42.86,0:58:44.15,Default,,0,0,0,,Сіз бірдеңе білесіз бе? Маған ақпарат беріңіз! Өтінемін
Dialogue: 0,0:58:44.23,0:58:47.53,Default,,0,0,0,,Оның бойында біртүрлі нәрсе болды... Сақ болыңыз.
Dialogue: 0,0:58:52.87,0:58:56.79,Default,,0,0,0,,Мен бұған ешқашан ренжіген емеспін.
Dialogue: 0,0:58:57.50,0:59:01.29,Default,,0,0,0,,Сіз келдіңіз, солай ма? Бұл жеткілікті
Dialogue: 0,0:59:41.04,0:59:42.42,Default,,0,0,0,,Сәлем! Сіз тыңдайсыз ба?
Dialogue: 0,0:59:42.54,0:59:43.92,Default,,0,0,0,,Неліктен бұған еліктейсің?
Dialogue: 0,1:00:33.34,1:00:34.38,Default,,0,0,0,,Дензел!
Dialogue: 0,1:00:39.81,1:00:40.64,Default,,0,0,0,,Дензел!
Dialogue: 0,1:00:41.18,1:00:42.27,Default,,0,0,0,,Дензел!
Dialogue: 0,1:01:03.29,1:01:04.62,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:01:13.42,1:01:16.43,Default,,0,0,0,,Сенің анаң осында емес пе?
Dialogue: 0,1:01:16.84,1:01:17.93,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:01:18.22,1:01:24.35,Default,,0,0,0,,Бұл не...? Ескерткіш? Оны Шинра жасаған.
Dialogue: 0,1:01:24.68,1:01:26.94,Default,,0,0,0,,Сен оны осында жасырдың ба?
Dialogue: 0,1:01:27.85,1:01:29.02,Default,,0,0,0,,Жоқ?
Dialogue: 0,1:01:29.36,1:01:30.44,Default,,0,0,0,,Саана
Dialogue: 0,1:01:30.52,1:01:33.03,Default,,0,0,0,,Біз де естіген жоқпыз.
Dialogue: 0,1:01:36.03,1:01:39.49,Default,,0,0,0,,Қараңызшы, ол бір жерде жасырылған.
Dialogue: 0,1:01:43.79,1:01:46.79,Default,,0,0,0,,Людо, бірдеңе айт!
Dialogue: 0,1:01:49.71,1:01:51.00,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:05.85,1:02:06.89,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,1:02:09.90,1:02:10.73,Default,,0,0,0,,Иә
Dialogue: 0,1:02:11.31,1:02:14.15,Default,,0,0,0,,Бірақ Дензел сияқты жақсы емес.
Dialogue: 0,1:02:15.40,1:02:16.57,Default,,0,0,0,,Оны емдеуге бола ма?
Dialogue: 0,1:02:18.36,1:02:19.70,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,1:02:21.24,1:02:26.08,Default,,0,0,0,,Мен Дензелге ем іздедім.
Dialogue: 0,1:02:27.50,1:02:28.83,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,1:02:29.29,1:02:33.04,Default,,0,0,0,,Бұлт Мен партаны тазаламаймын.
Dialogue: 0,1:02:34.30,1:02:35.59,Default,,0,0,0,,That's right.
Dialogue: 0,1:02:37.80,1:02:40.39,Default,,0,0,0,,Әй, бұлт!
Dialogue: 0,1:02:40.47,1:02:44.76,Default,,0,0,0,,Дензелдің жұлдызша белгілерін өшіре алмағандықтан үйден шықтыңыз ба?
Dialogue: 0,1:02:46.10,1:02:48.43,Default,,0,0,0,,Мен де жұлдызша алғандықтан ба?
Dialogue: 0,1:02:50.19,1:02:51.23,Default,,0,0,0,,Мен
Dialogue: 0,1:02:52.52,1:02:54.57,Default,,0,0,0,,Мен өзімді жалғыз қорғай алмаймын
Dialogue: 0,1:02:55.44,1:02:57.44,Default,,0,0,0,,Мүмкін мен солай ойлағандықтан болар.
Dialogue: 0,1:02:58.82,1:03:02.87,Default,,0,0,0,,Өзіңді қорғай алмасаң, отбасыңды қорғай аласың ба? !
Dialogue: 0,1:03:04.58,1:03:07.37,Default,,0,0,0,,...әкем осылай деді.
Dialogue: 0,1:03:08.45,1:03:11.08,Default,,0,0,0,,Бұлт Берілме
Dialogue: 0,1:03:14.96,1:03:16.96,Default,,0,0,0,,Марин, Дензел және Тифа
Dialogue: 0,1:03:17.46,1:03:19.72,Default,,0,0,0,,Сіз маған әрқашан көмектестіңіз
Dialogue: 0,1:03:20.84,1:03:23.14,Default,,0,0,0,,Мені әрқашан біреу қорғады
Dialogue: 0,1:03:25.18,1:03:28.64,Default,,0,0,0,,Енді менің кезегім
Dialogue: 0,1:03:29.48,1:03:30.44,Default,,0,0,0,,Иә
Dialogue: 0,1:03:39.74,1:03:41.15,Default,,0,0,0,,Сәлем Кадаж
Dialogue: 0,1:03:41.82,1:03:43.57,Default,,0,0,0,,Маған бір нәрсе айтыңыз.
Dialogue: 0,1:03:44.20,1:03:46.58,Default,,0,0,0,,Бір ғана
Dialogue: 0,1:03:47.49,1:03:53.00,Default,,0,0,0,,Сіз Jenova жасушаларын алатыныңызды айттыңыз және бәрі қалыпты жағдайға оралады ...
Dialogue: 0,1:03:53.17,1:03:55.17,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:03:56.34,1:04:00.76,Default,,0,0,0,,Ол... қайтып келеді.
Dialogue: 0,1:04:03.01,1:04:04.68,Default,,0,0,0,,...Сефирот
Dialogue: 0,1:04:05.18,1:04:06.51,Default,,0,0,0,,Бұл қорқынышты түс
Dialogue: 0,1:04:06.60,1:04:07.85,Default,,0,0,0,,Шамасы
Dialogue: 0,1:04:08.10,1:04:09.14,Default,,0,0,0,,Шамасы?
Dialogue: 0,1:04:09.39,1:04:11.52,Default,,0,0,0,,Мен Сефиротты білмеймін
Dialogue: 0,1:04:12.10,1:04:15.69,Default,,0,0,0,,А, мен оны сезіп тұрмын.
Dialogue: 0,1:04:17.27,1:04:18.78,Default,,0,0,0,,Бұл көңілсіз
Dialogue: 0,1:04:18.98,1:04:22.32,Default,,0,0,0,,Сізге кім ұнайды, мені немесе Сефиротты...
Dialogue: 0,1:04:22.90,1:04:24.70,Default,,0,0,0,,Қайғыны ойлайтын дене
Dialogue: 0,1:04:25.37,1:04:29.20,Default,,0,0,0,,Қайсысын таңдасаң да, ақыры бір болмақ!
Dialogue: 0,1:04:29.58,1:04:33.37,Default,,0,0,0,,Ана ұзақ сапардан кейін бұл планетаға келді.
Dialogue: 0,1:04:33.71,1:04:37.38,Default,,0,0,0,,Ғаламды ақымақ адамдардан тазарту.
Dialogue: 0,1:04:37.96,1:04:41.21,Default,,0,0,0,,Бірақ сіз не білесіз?
Dialogue: 0,1:04:43.93,1:04:47.35,Default,,0,0,0,,Анам келгеннен бері мұнда ештеңе өзгерген жоқ.
Dialogue: 0,1:04:47.43,1:04:50.35,Default,,0,0,0,,Сондықтан мен анамды қуантамын.
Dialogue: 0,1:04:50.43,1:04:55.85,Default,,0,0,0,,Анам не бұйырса, соны орындаймын.
Dialogue: 0,1:04:55.94,1:04:59.07,Default,,0,0,0,,Хмм, тағы да қорқынышты түс пе?
Dialogue: 0,1:05:00.07,1:05:05.57,Default,,0,0,0,,Балалар, сендер осында болғанша, сол жағдай қайталана береді.
Dialogue: 0,1:05:07.66,1:05:10.24,Default,,0,0,0,,...жұлдыздарды айналып өтетін өмір ағымына
Dialogue: 0,1:05:10.91,1:05:14.37,Default,,0,0,0,,Өмір мен өлім арасында алға-артқа жүру
Dialogue: 0,1:05:14.75,1:05:17.92,Default,,0,0,0,,Сол қайталау өмірдің шын мәні болса
Dialogue: 0,1:05:18.04,1:05:20.88,Default,,0,0,0,,Тарих қайталанатыны сөзсіз.
Dialogue: 0,1:05:21.71,1:05:24.67,Default,,0,0,0,,Дженова немесе Сефирот, мен білмеймін.
Dialogue: 0,1:05:24.76,1:05:27.39,Default,,0,0,0,,Істі өзіңіз қалағаныңызша қайталаңыз.
Dialogue: 0,1:05:28.09,1:05:31.01,Default,,0,0,0,,Біз өмір ережелерін сақтаймыз
Dialogue: 0,1:05:31.35,1:05:35.89,Default,,0,0,0,,Мен сені әр кезде тоқтатамын.
Dialogue: 0,1:05:37.27,1:05:42.61,Default,,0,0,0,,Президент... Анамды ұрлағаны үшін сылтау ма?
Dialogue: 0,1:05:43.11,1:05:45.45,Default,,0,0,0,,Сіз шынымен өкінбейсіз бе?
Dialogue: 0,1:05:45.61,1:05:51.08,Default,,0,0,0,,Өкінішті? Мен... көңіл көтермей тұра алмаймын
Dialogue: 0,1:05:57.46,1:06:02.80,Default,,0,0,0,,Керемет, онда аяқтаймыз.
Dialogue: 0,1:07:08.44,1:07:10.53,Default,,0,0,0,,Дензел, қаш!
Dialogue: 0,1:07:45.40,1:07:47.07,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:57.87,1:07:59.00,Default,,0,0,0,,Коля
Dialogue: 0,1:07:59.08,1:08:00.08,Default,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,1:08:32.78,1:08:33.53,Default,,0,0,0,,Келесің бе? ?
Dialogue: 0,1:08:34.36,1:08:35.28,Default,,0,0,0,,Мен оны көргім келмейді
Dialogue: 0,1:09:13.28,1:09:15.91,Default,,0,0,0,,Бұл қызық, досым
Dialogue: 0,1:09:16.03,1:09:17.82,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,1:09:23.91,1:09:26.08,Default,,0,0,0,,Балалар сендер табандысыңдар.
Dialogue: 0,1:09:28.50,1:09:33.63,Default,,0,0,0,,Сонымен... анамды қайтарып берсеңіз, бәрі бітер еді.
Dialogue: 0,1:09:40.35,1:09:41.35,Default,,0,0,0,,Балалар...
Dialogue: 0,1:09:41.76,1:09:44.93,Default,,0,0,0,,Дженованың басы Онымен не істейсің?
Dialogue: 0,1:09:56.36,1:09:59.32,Default,,0,0,0,,Бұл кездесу ме? Жындысың ба?
Dialogue: 0,1:10:00.37,1:10:03.04,Default,,0,0,0,,Біз анамды жаңа ғана кездестірдік.
Dialogue: 0,1:10:07.54,1:10:12.38,Default,,0,0,0,,Менің болашағым туралы бәрін шешем шешеді.
Dialogue: 0,1:10:13.13,1:10:15.05,Default,,0,0,0,,Ал анаң ше?
Dialogue: 0,1:10:30.15,1:10:33.73,Default,,0,0,0,,Ана, ана... Женованың басы емес пе?
Dialogue: 0,1:10:33.90,1:10:34.57,Default,,0,0,0,,Эй!
Dialogue: 0,1:10:34.98,1:10:36.90,Default,,0,0,0,,Анаңды олай атама.
Dialogue: 0,1:10:37.03,1:10:38.40,Default,,0,0,0,,Сенің әкең Эден мектебінің түлегі ғой, иә?
Dialogue: 0,1:10:41.41,1:10:42.74,Default,,0,0,0,,...Жаман болды.
Dialogue: 0,1:10:43.83,1:10:47.08,Default,,0,0,0,,Дұрыс...неге кешірім сұрайсың!
Dialogue: 0,1:11:37.05,1:11:37.92,Default,,0,0,0,,Тифа?
Dialogue: 0,1:11:43.34,1:11:44.26,Default,,0,0,0,,Мұны істейік!
Dialogue: 0,1:11:58.19,1:11:59.74,Default,,0,0,0,,Мұнда анаңды қорға.
Dialogue: 0,1:12:00.11,1:12:01.07,Default,,0,0,0,,Оқ!
Dialogue: 0,1:12:02.49,1:12:04.32,Default,,0,0,0,,Мен Марин қауіпсіз деп үміттенемін! ? иә?
Dialogue: 0,1:12:18.96,1:12:20.84,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,1:12:51.16,1:12:52.04,Default,,0,0,0,,Uppu
Dialogue: 0,1:12:53.71,1:12:55.71,Default,,0,0,0,,Менің материалымды кім пайдаланып жатыр?
Dialogue: 0,1:12:55.88,1:12:57.21,Default,,0,0,0,,Әрине, жаман адам
Dialogue: 0,1:12:57.59,1:12:58.88,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,1:13:00.05,1:13:00.88,Default,,0,0,0,,Who?
Dialogue: 0,1:13:05.89,1:13:08.72,Default,,0,0,0,,Бұл жаңа үлгі! Сьерра
Dialogue: 0,1:13:09.64,1:13:11.97,Default,,0,0,0,,Мен сені кейін апарамын!
Dialogue: 0,1:13:13.06,1:13:14.06,Default,,0,0,0,,Телефон дүкені қайда...
Dialogue: 0,1:13:17.61,1:13:18.31,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,1:13:18.86,1:13:20.23,Default,,0,0,0,,Біз бәріміз доспыз.
Dialogue: 0,1:13:23.24,1:13:25.24,Default,,0,0,0,,Дензел Дүкенге жүгіре аласыз ба?
Dialogue: 0,1:13:25.95,1:13:26.82,Default,,0,0,0,,Иә
Dialogue: 0,1:13:53.43,1:13:54.27,Default,,0,0,0,,Бағдарлама коды…
Dialogue: 0,1:13:57.94,1:13:58.94,Default,,0,0,0,,Тифа! !
Dialogue: 0,1:14:04.28,1:14:05.24,Default,,0,0,0,,Дензел!
Dialogue: 0,1:14:27.97,1:14:28.72,Default,,0,0,0,,Бұлт!
Dialogue: 0,1:14:39.60,1:14:41.48,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,1:14:41.61,1:14:43.77,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,1:14:50.82,1:14:51.49,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:14:51.57,1:14:52.41,Default,,0,0,0,,Иә
Dialogue: 0,1:14:55.12,1:14:57.91,Default,,0,0,0,,Теңіз қауіпсіз. Мен оны дүкенге қалдырдым.
Dialogue: 0,1:14:58.37,1:14:59.16,Default,,0,0,0,,Иә
Dialogue: 0,1:15:00.12,1:15:01.58,Default,,0,0,0,,Мен өзімді жеңіл сезінемін.
Dialogue: 0,1:15:02.33,1:15:03.34,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:05.80,1:15:09.09,Default,,0,0,0,,Қатты сүйреп, тоздырдым ба деп ойлаймын.
Dialogue: 0,1:15:14.18,1:15:16.52,Default,,0,0,0,,Мен дүкенге өзім қайтамын.
Dialogue: 0,1:15:17.06,1:15:18.27,Default,,0,0,0,,Маринмен бірге күту
Dialogue: 0,1:15:21.52,1:15:23.94,Default,,0,0,0,,Бұлт да қайтады, солай ма?
Dialogue: 0,1:15:25.94,1:15:26.82,Default,,0,0,0,,Иә
Dialogue: 0,1:16:05.77,1:16:06.98,Default,,0,0,0,,Мен жеңіліске жол бере алмаймын!
Dialogue: 0,1:18:08.94,1:18:10.31,Default,,0,0,0,,Бұл Oseen!
Dialogue: 0,1:19:15.55,1:19:19.55,Default,,0,0,0,,Бұл қызық, Президент, ары қарай қалай атаймыз?
Dialogue: 0,1:19:29.02,1:19:30.02,Default,,0,0,0,,Мен сені ұмытып кеттім.
Dialogue: 0,1:19:30.19,1:19:32.52,Default,,0,0,0,,Біліңдер, беймәлім адамдар
Dialogue: 0,1:19:45.74,1:19:47.20,Default,,0,0,0,,Go Cloud!
Dialogue: 0,1:19:57.71,1:19:59.63,Default,,0,0,0,,Егер Ваму сол затты бірінші қолға алса—
Dialogue: 0,1:20:06.68,1:20:08.10,Default,,0,0,0,,Иә!
Dialogue: 0,1:20:09.85,1:20:10.98,Default,,0,0,0,,Nuo~
Dialogue: 0,1:20:22.95,1:20:23.99,Default,,0,0,0,,Ұш!
Dialogue: 0,1:20:33.46,1:20:34.42,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,1:21:12.83,1:21:13.83,Default,,0,0,0,,Иә!
Dialogue: 0,1:22:05.67,1:22:06.55,Default,,0,0,0,,Анашым!
Dialogue: 0,1:22:14.27,1:22:15.27,Default,,0,0,0,,Президент!
Dialogue: 0,1:22:59.52,1:23:00.48,Default,,0,0,0,,Президент!
Dialogue: 0,1:24:39.45,1:24:41.41,Default,,0,0,0,,Басқа адам қателеспейді.
Dialogue: 0,1:24:50.92,1:24:53.09,Default,,0,0,0,,Папин! Папапапан!
Dialogue: 0,1:25:34.30,1:25:35.13,Default,,0,0,0,,Людо!
Dialogue: 0,1:25:40.22,1:25:43.27,Default,,0,0,0,,Ах~! ?
Dialogue: 0,1:25:48.02,1:25:50.27,Default,,0,0,0,,Бұл қауіпті, бұл қауіпті, бұл қауіпті.
Dialogue: 0,1:25:51.65,1:25:54.99,Default,,0,0,0,,О, Людо, жақсысың ба?
Dialogue: 0,1:25:55.40,1:25:57.99,Default,,0,0,0,,Жоқ... шынымен емес.
Dialogue: 0,1:26:28.60,1:26:30.27,Default,,0,0,0,,Сота: Мен сағындым…
Dialogue: 0,1:28:23.97,1:28:25.89,Default,,0,0,0,,Досым
Dialogue: 0,1:28:26.97,1:28:30.81,Default,,0,0,0,,Бұл күшті ме?
Dialogue: 0,1:28:31.98,1:28:34.40,Default,,0,0,0,,Шинраның технологиясын біріктіру
Dialogue: 0,1:28:34.48,1:28:36.31,Default,,0,0,0,,Сіз орындадыңыз ба...
Dialogue: 0,1:28:37.19,1:28:39.73,Default,,0,0,0,,Оның қуатына қарамастан, ол жарқыраған.
Dialogue: 0,1:28:39.86,1:28:41.32,Default,,0,0,0,,Ой
Dialogue: 0,1:28:42.28,1:28:44.28,Default,,0,0,0,,Мен саған ұнайсың ба, досым?
Dialogue: 0,1:28:45.37,1:28:47.74,Default,,0,0,0,,Бүгін артық жұмыс уақыты жоқ.
Dialogue: 0,1:30:01.94,1:30:02.65,Default,,0,0,0,,элиталық Зерттеу корпусының болмауынан болды.
Dialogue: 0,1:30:16.71,1:30:17.75,Default,,0,0,0,,элиталық Зерттеу корпусының болмауынан болды.
Dialogue: 0,1:30:19.54,1:30:21.25,Default,,0,0,0,,Анашым!
Dialogue: 0,1:32:05.32,1:32:07.48,Default,,0,0,0,,Бұлтқа барайық
Dialogue: 0,1:32:37.10,1:32:40.06,Default,,0,0,0,,Ақыры анамды кездестірдім
Dialogue: 0,1:32:41.23,1:32:42.73,Default,,0,0,0,,Неден басталады?
Dialogue: 0,1:32:45.69,1:32:47.90,Default,,0,0,0,,Маған анам айтып береді.
Dialogue: 0,1:32:49.57,1:32:52.40,Default,,0,0,0,,...Ойланған денелер ештеңе білмейді ме?
Dialogue: 0,1:32:55.41,1:32:58.58,Default,,0,0,0,,Мен бәрібір қуыршақпын...
Dialogue: 0,1:33:03.75,1:33:05.42,Default,,0,0,0,,Өткенде сіздермен бірге
Dialogue: 0,1:33:07.50,1:33:08.21,Default,,0,0,0,,Дәл солай!
Dialogue: 0,1:33:34.53,1:33:37.24,Default,,0,0,0,,Мен Cloud Materia әкелдім!
Dialogue: 0,1:33:38.37,1:33:39.41,Default,,0,0,0,,Оны шайқамаңыз!
Dialogue: 0,1:33:39.53,1:33:41.29,Default,,0,0,0,,Сәлем Сид! Тез түсіріңіз!
Dialogue: 0,1:33:41.37,1:33:43.62,Default,,0,0,0,,Шулы! Секір! Секір!
Dialogue: 0,1:33:44.46,1:33:45.87,Default,,0,0,0,,Маған жалғыз күресуге рұқсат етіңіз
Dialogue: 0,1:33:47.08,1:33:48.13,Default,,0,0,0,,Э…?—
Dialogue: 0,1:33:48.50,1:33:50.63,Default,,0,0,0,,Ол Сефироттың ойлау формасы...
Dialogue: 0,1:33:51.71,1:33:53.71,Default,,0,0,0,,Бұл дернәсіл сияқты, былайша айтқанда.
Dialogue: 0,1:33:53.80,1:33:56.22,Default,,0,0,0,,Дернәсіл? жәндік? Бұл жәндік пе?
Dialogue: 0,1:33:56.30,1:33:57.80,Default,,0,0,0,,Жас келіншек аузын жапқанда
Dialogue: 0,1:33:57.89,1:34:00.30,Default,,0,0,0,,Ол бір күні Сефирот болады ма?
Dialogue: 0,1:34:00.51,1:34:04.31,Default,,0,0,0,,Әй, бұлт мұны біледі ме?
Dialogue: 0,1:34:05.77,1:34:06.64,Default,,0,0,0,,Мүмкін
Dialogue: 0,1:34:07.52,1:34:08.48,Default,,0,0,0,,Мен көремін...
Dialogue: 0,1:34:10.19,1:34:11.57,Default,,0,0,0,,Мені жалғыз қалдырыңыз
Dialogue: 0,1:34:11.69,1:34:14.44,Default,,0,0,0,,Түсінбедім, түсіндіріңізші!
Dialogue: 0,1:34:14.57,1:34:15.90,Default,,0,0,0,,Бұл ер адамдар туралы.
Dialogue: 0,1:34:16.15,1:34:18.11,Default,,0,0,0,,Кемсітушілік! Сабетсу!
Dialogue: 0,1:34:18.20,1:34:20.12,Default,,0,0,0,,Кішкентай қыз, үндеме!
Dialogue: 0,1:34:20.20,1:34:22.24,Default,,0,0,0,,Тіпті ер адамдар да түсінбейді.
Dialogue: 0,1:34:22.33,1:34:23.41,Default,,0,0,0,,2 жыл бұрын...
Dialogue: 0,1:34:25.12,1:34:28.83,Default,,0,0,0,,Соңғы шайқас кезінде болған күшті сезімдер
Dialogue: 0,1:34:29.54,1:34:34.09,Default,,0,0,0,,Бар болғаны екі жыл болса да, сол сезімді білмей тұрып жоғалттым
Dialogue: 0,1:34:34.84,1:34:37.47,Default,,0,0,0,,Менің ойымша, бұлтты қайтарып алды.
Dialogue: 0,1:34:38.05,1:34:40.47,Default,,0,0,0,,Цк... 10 минут күтемін.
Dialogue: 0,1:34:40.55,1:34:43.85,Default,,0,0,0,,Бұлт бұрынғыдай қиын.
Dialogue: 0,1:34:45.10,1:34:46.35,Default,,0,0,0,,Адал
Dialogue: 0,1:36:02.59,1:36:06.56,Default,,0,0,0,,Мен саған кездесуімді көрсетемін
Dialogue: 0,1:36:27.45,1:36:30.62,Default,,0,0,0,,Біраз уақыт болды, Бұлт.
Dialogue: 0,1:36:45.85,1:36:47.76,Default,,0,0,0,,Жұлдызды тыртықтарыңызды жоғалттыңыз ба?
Dialogue: 0,1:36:49.85,1:36:51.31,Default,,0,0,0,,Өкінішті
Dialogue: 0,1:36:51.43,1:36:54.31,Default,,0,0,0,,Сен нені қалайсың?
Dialogue: 0,1:36:54.73,1:36:57.61,Default,,0,0,0,,Жұлдызша таңбалы өлгендердің ойлары
Dialogue: 0,1:36:58.40,1:37:01.74,Default,,0,0,0,,Өмір ағынымен жұлдыздарды айналып өтеді
Dialogue: 0,1:37:02.19,1:37:04.82,Default,,0,0,0,,Ақырында ол жұлдыздарды жояды...
Dialogue: 0,1:37:05.70,1:37:08.16,Default,,0,0,0,,Менің қалағаным, Бұлт
Dialogue: 0,1:37:09.24,1:37:13.16,Default,,0,0,0,,Бұл жұлдызды кеме ретінде пайдаланып, ғарыштың қараңғылығын аралау.
Dialogue: 0,1:37:14.67,1:37:17.67,Default,,0,0,0,,Бір кездегі анам сияқты.
Dialogue: 0,1:37:24.68,1:37:28.01,Default,,0,0,0,,Жақында біз жаңа жұлдызды ашамыз
Dialogue: 0,1:37:28.18,1:37:31.02,Default,,0,0,0,,Ауданда жарқын болашақ құру
Dialogue: 0,1:37:31.52,1:37:33.10,Default,,0,0,0,,Бұл планетамен не болады?
Dialogue: 0,1:37:33.64,1:37:37.27,Default,,0,0,0,,Енді... бұл сізге байланысты.
Dialogue: 0,1:37:58.79,1:38:00.04,Default,,0,0,0,,Әпке?
Dialogue: 0,1:38:45.59,1:38:48.76,Default,,0,0,0,,Сізді не күшті етті?
Dialogue: 0,1:38:49.26,1:38:51.01,Default,,0,0,0,,Мен сізге айтқым келмейді.
Dialogue: 0,1:39:26.42,1:39:29.30,Default,,0,0,0,,Мен саған сыйлық ойладым...
Dialogue: 0,1:39:35.97,1:39:37.81,Default,,0,0,0,,Үмітіңді түсірейін бе?
Dialogue: 0,1:39:48.24,1:39:51.95,Default,,0,0,0,,Маған қалай тізе бүгіп, кешірім сұрайтыныңды көрсет.
Dialogue: 0,1:41:43.52,1:41:47.27,Default,,0,0,0,,Сол кездегі ауыртпалық есіңізде ме? бұлт
Dialogue: 0,1:41:48.77,1:41:53.24,Default,,0,0,0,,Енді ұмытылмас азапты тағы бір рет ойып алайық
Dialogue: 0,1:42:20.22,1:42:22.81,Default,,0,0,0,,Сіз үшін ең маңыздысы не?
Dialogue: 0,1:42:24.64,1:42:27.31,Default,,0,0,0,,Оны алып кетудің қуанышын маған сыйлайсың ба?
Dialogue: 0,1:42:34.15,1:42:36.49,Default,,0,0,0,,Мен болсам, мен әлі берілмес едім.
Dialogue: 0,1:42:36.82,1:42:39.28,Default,,0,0,0,,Тіпті үмітсіз жағдайда
Dialogue: 0,1:42:42.87,1:42:44.50,Default,,0,0,0,,Армандарыңызды қабыл алыңыз
Dialogue: 0,1:42:44.87,1:42:48.92,Default,,0,0,0,,Қандай жағдай болмасын, солдаттық мақтанышыңызды ешқашан тастамаңыз.
Dialogue: 0,1:42:49.63,1:42:54.51,Default,,0,0,0,,Жарайды, мен солдат болған жоқпын, бірақ бұл жүректің ісі.
Dialogue: 0,1:42:55.71,1:42:57.09,Default,,0,0,0,,Зак...
Dialogue: 0,1:42:58.47,1:43:00.97,Default,,0,0,0,,Саған қол ұшын созғанымды қалайсың ба?
Dialogue: 0,1:43:08.44,1:43:11.94,Default,,0,0,0,,Бұл мен бір рет жеңген қарсыласым. Бұл оңай жеңіс емес.
Dialogue: 0,1:43:13.02,1:43:13.94,Default,,0,0,0,,Ах...
Dialogue: 0,1:43:16.74,1:43:19.86,Default,,0,0,0,,Ұмытпа...
Dialogue: 0,1:43:20.86,1:43:25.16,Default,,0,0,0,,Мен сенің тірі дәлеліңмін.
Dialogue: 0,1:43:33.21,1:43:36.71,Default,,0,0,0,,...Өкінішті, сен ештеңе түсінбейсің.
Dialogue: 0,1:43:38.38,1:43:40.51,Default,,0,0,0,,Ештеңе маңызды емес
Dialogue: 0,1:44:17.17,1:44:21.01,Default,,0,0,0,,Менің естеліктерімде тыныш бол
Dialogue: 0,1:44:26.76,1:44:28.10,Default,,0,0,0,,Пайдасы жоқ. Бәрі бітті.
Dialogue: 0,1:44:29.39,1:44:31.60,Default,,0,0,0,,Бұл естелік болмайды
Dialogue: 0,1:45:02.30,1:45:03.72,Default,,0,0,0,,Бауырым...
Dialogue: 0,1:45:06.14,1:45:07.64,Default,,0,0,0,,Kadaj?
Dialogue: 0,1:45:09.68,1:45:10.64,Default,,0,0,0,,Иә?
Dialogue: 0,1:45:21.94,1:45:25.16,Default,,0,0,0,,Мен сонша тырысуды тоқтатуым керек пе?
Dialogue: 0,1:45:30.70,1:45:33.16,Default,,0,0,0,,Ана...?
Dialogue: 0,1:45:34.50,1:45:37.25,Default,,0,0,0,,Барлығына үйге барамыз ба?
Dialogue: 0,1:45:39.67,1:45:40.67,Default,,0,0,0,,Иә
Dialogue: 0,1:47:02.50,1:47:03.75,Default,,0,0,0,,Иә! Бұл не?
Dialogue: 0,1:47:03.84,1:47:05.34,Default,,0,0,0,,Мен айтқанымдай!
Dialogue: 0,1:47:05.42,1:47:07.51,Default,,0,0,0,,Адам! Бұлт-сан - адам!
Dialogue: 0,1:47:07.59,1:47:09.68,Default,,0,0,0,,Егер сіз тырыссаңыз, бұлт мұны істей алады.
Dialogue: 0,1:47:09.76,1:47:11.76,Default,,0,0,0,,Балалар, мықтап ұстаңдар.
Dialogue: 0,1:47:20.98,1:47:24.78,Default,,0,0,0,,Сіз осында болдыңыз ғой, солай емес пе?
Dialogue: 0,1:47:26.03,1:47:27.53,Default,,0,0,0,,Рахмет
Dialogue: 0,1:48:08.74,1:48:11.95,Default,,0,0,0,,Үйге бірге барайық
Dialogue: 0,1:48:16.83,1:48:19.96,Default,,0,0,0,,Ендеше бірге ойнайық
Dialogue: 0,1:48:45.81,1:48:46.86,Default,,0,0,0,,Бұлт!
Dialogue: 0,1:48:53.32,1:48:56.03,Default,,0,0,0,,...Бұлт да қайтады.
Dialogue: 0,1:49:19.31,1:49:20.06,Default,,0,0,0,,Кеттік
Dialogue: 0,1:49:20.22,1:49:21.06,Default,,0,0,0,,Иә
Dialogue: 0,1:50:45.35,1:50:46.48,Default,,0,0,0,,Ана...?
Dialogue: 0,1:50:48.15,1:50:49.15,Default,,0,0,0,,(Киришима & Сейро) Хахаха… Шынымен бе? Шынымен бе? Бакуго!
Dialogue: 0,1:50:49.60,1:50:53.07,Default,,0,0,0,,Сіз мені қанша рет ана деп атадыңыз?
Dialogue: 0,1:50:55.19,1:50:57.61,Default,,0,0,0,,Таңдану жақсы емес пе?
Dialogue: 0,1:50:58.82,1:51:01.83,Default,,0,0,0,,Маған мұндай үлкен бала керек емес.
Dialogue: 0,1:51:03.12,1:51:08.00,Default,,0,0,0,,Өкінішке орай, сіздің орныңыз бұл жерде емес.
Dialogue: 0,1:52:05.76,1:52:07.02,Default,,0,0,0,,Менің әпкем
Dialogue: 0,1:52:07.35,1:52:09.35,Default,,0,0,0,,Өйткені бұлт осында келе жатыр
Dialogue: 0,1:52:11.81,1:52:13.31,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:52:23.95,1:52:25.08,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:52:28.91,1:52:31.50,Default,,0,0,0,,Жұлдызша таңбалары әлі өшпеген балалар бар.
Dialogue: 0,1:52:32.75,1:52:33.58,Default,,0,0,0,,О
Dialogue: 0,1:52:40.42,1:52:43.43,Default,,0,0,0,,Енді сізді сауықтырайық.
Dialogue: 0,1:52:46.60,1:52:48.43,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,1:52:50.02,1:52:51.27,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,1:53:44.24,1:53:46.16,Default,,0,0,0,,Енді секіріңіз!
Dialogue: 0,1:53:46.28,1:53:47.45,Default,,0,0,0,,емделген емделген
Dialogue: 0,1:54:35.54,1:54:39.21,Default,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,1:55:00.23,1:55:01.36,Default,,0,0,0,,Иә
Dialogue: 0,1:55:03.73,1:55:04.69,Default,,0,0,0,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,1:55:07.03,1:55:08.57,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,2:06:00.72,2:06:02.97,Default,,0,0,0,,Бұл біреудің моласы ма?
Dialogue: 0,2:06:04.55,2:06:06.43,Default,,0,0,0,,Жоқ
Dialogue: 0,2:06:06.60,2:06:10.85,Default,,0,0,0,,Батыр осы жерден кетті.
Dialogue: 0,2:06:12.35,2:06:17.35,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
