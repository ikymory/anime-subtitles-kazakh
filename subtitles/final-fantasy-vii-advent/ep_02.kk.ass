Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:36.83,0:01:38.83,,,0,0,0,,Жою және құру
Dialogue: 0,0:01:40.46,0:01:43.33,,,0,0,0,,Адамдар неліктен қайталайды?
Dialogue: 0,0:01:44.75,0:01:47.17,,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:01:52.13,0:01:55.51,,,0,0,0,,Адамдардың есте сақтау қабілеті нашар.
Dialogue: 0,0:01:56.01,0:01:58.35,,,0,0,0,,Ендеше көркейтіп,кеңейе бер
Dialogue: 0,0:01:59.02,0:02:03.35,,,0,0,0,,Ауырсынуды сағынышқа айналдырып,өткенді жеңуге тырысу
Dialogue: 0,0:02:04.69,0:02:07.02,,,0,0,0,,Мен анамды қайтаруға тырыстым
Dialogue: 0,0:02:07.57,0:02:09.11,,,0,0,0,,Естеліктерге байланысты ма?
Dialogue: 0,0:02:11.65,0:02:15.70,,,0,0,0,,Бұл қазіргі қиындықтарды жою.
Dialogue: 0,0:02:16.41,0:02:18.87,,,0,0,0,,Сіз жұлдыз тыртықтары туралы айтып отырсыз ба?
Dialogue: 0,0:02:19.50,0:02:22.37,,,0,0,0,,Бірақ басында бәрі сен кінәлі.
Dialogue: 0,0:02:24.42,0:02:25.79,,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:26.54,0:02:30.67,,,0,0,0,,Сіз де есте сақтауда жақсы емессіз.
Dialogue: 0,0:02:32.17,0:02:34.68,,,0,0,0,,Жоқ,мен...
Dialogue: 0,0:02:35.43,0:02:37.97,,,0,0,0,,Нағыз ұмытшақ
Dialogue: 0,0:02:53.11,0:02:54.41,,,0,0,0,,Цен мырза!
Dialogue: 0,0:02:54.78,0:02:56.07,,,0,0,0,,Қараңдар!
Dialogue: 0,0:03:00.33,0:03:01.58,,,0,0,0,,Бұл хит.
Dialogue: 0,0:03:02.54,0:03:04.58,,,0,0,0,,...Бұл жиіркенішті.
Dialogue: 0,0:03:05.83,0:03:08.21,,,0,0,0,,Жарайды,асығыңыз.
Dialogue: 0,0:03:08.29,0:03:09.92,,,0,0,0,,Лено Таноми
Dialogue: 0,0:03:10.67,0:03:11.92,,,0,0,0,,Иә.
Dialogue: 0,0:03:27.77,0:03:28.94,,,0,0,0,,Эй,эй!
Dialogue: 0,0:03:29.44,0:03:31.11,,,0,0,0,,Сенпай,тезірек!
Dialogue: 0,0:03:33.61,0:03:34.61,,,0,0,0,,Сенпай!
Dialogue: 0,0:03:35.11,0:03:36.78,,,0,0,0,,Бұл кім!?
Dialogue: 0,0:03:40.12,0:03:40.95,,,0,0,0,,Депрессия
Dialogue: 0,0:03:41.83,0:03:42.79,,,0,0,0,,Ирина!
Dialogue: 0,0:03:44.37,0:03:46.04,,,0,0,0,,Жүр!
Dialogue: 0,0:03:55.34,0:03:56.30,,,0,0,0,,Цен мырза!
Dialogue: 0,0:04:41.89,0:04:43.85,,,0,0,0,,Өмір ағыны
Dialogue: 0,0:04:44.60,0:04:48.44,,,0,0,0,,Бұл жұлдыздардың айналасындағы тіршілік ағымы
Dialogue: 0,0:04:48.73,0:04:53.52,,,0,0,0,,Бұл жұлдыздардың және оларда тіршілік ететін барлық тіршіліктің қайнар көзі.
Dialogue: 0,0:04:54.94,0:04:58.36,,,0,0,0,,Shinra Company Lifestream құрды.
Dialogue: 0,0:04:58.45,0:05:02.03,,,0,0,0,,Ресурс ретінде пайдаланудың жолын тапты
Dialogue: 0,0:05:02.37,0:05:05.87,,,0,0,0,,Соның арқасында біздің өміріміз
Dialogue: 0,0:05:06.00,0:05:08.29,,,0,0,0,,Мен өте бай болдым.
Dialogue: 0,0:05:08.87,0:05:13.04,,,0,0,0,,Бірақ бұл жұлдыздың өмірін қысқарту дегенді білдіреді.
Dialogue: 0,0:05:13.13,0:05:16.21,,,0,0,0,,Көп адамдар осылай ойлады.
Dialogue: 0,0:05:17.97,0:05:21.89,,,0,0,0,,Шинра оларға қарсы шыққандарды жояды.
Dialogue: 0,0:05:22.05,0:05:24.64,,,0,0,0,,Күшпен тежеуге тырысты
Dialogue: 0,0:05:25.68,0:05:30.90,,,0,0,0,,Шинраның солдат I деп аталатын арнайы сарбаздары болды.
Dialogue: 0,0:05:31.48,0:05:34.82,,,0,0,0,,Баяғыда аспаннан түскен
Dialogue: 0,0:05:34.90,0:05:37.82,,,0,0,0,,Бұл планетаны жоюға тырысқан апат
Dialogue: 0,0:05:38.32,0:05:41.86,,,0,0,0,,Бұл Йенова жасушалары имплантацияланған адамдар.
Dialogue: 0,0:05:42.82,0:05:45.83,,,0,0,0,,Олардың ішінде Сефирот бар.
Dialogue: 0,0:05:45.91,0:05:48.91,,,0,0,0,,Өте дарынды жауынгер болған.
Dialogue: 0,0:05:50.04,0:05:54.88,,,0,0,0,,Бірақ мен қорқынышты экспериментте туғанымды білдім.
Dialogue: 0,0:05:54.96,0:05:57.76,,,0,0,0,,Мен Шинраны жек көріп кеттім.
Dialogue: 0,0:05:58.13,0:06:03.18,,,0,0,0,,Ал мен мұны білмей тұрып,бәрін жек көре бастадым.
Dialogue: 0,0:06:04.85,0:06:08.85,,,0,0,0,,Шинра және оған қарсы шыққандар
Dialogue: 0,0:06:09.64,0:06:14.94,,,0,0,0,,Сефишу өшпенділіктен планетаны жоюға тырысады.
Dialogue: 0,0:06:15.61,0:06:18.23,,,0,0,0,,Сефиротты тоқтатуға тырысатын адамдар
Dialogue: 0,0:06:19.03,0:06:21.95,,,0,0,0,,Көптеген шайқастар болды
Dialogue: 0,0:06:23.28,0:06:27.08,,,0,0,0,,Қанша шайқас болса,сонша қайғы болды.
Dialogue: 0,0:06:27.91,0:06:33.46,,,0,0,0,,Мен сүйген адам да менің өмірімнің бір бөлігіне айналды.
Dialogue: 0,0:06:35.63,0:06:38.09,,,0,0,0,,Және сол күні
Dialogue: 0,0:06:38.42,0:06:39.88,,,0,0,0,,Тағдырлы күн
Dialogue: 0,0:06:40.34,0:06:45.47,,,0,0,0,,Барлық шайқастарды жұлдыздардың өз күшімен аяқтады.
Dialogue: 0,0:06:46.76,0:06:51.43,,,0,0,0,,Жұлдыз өмір ағынын қару ретінде пайдаланды.
Dialogue: 0,0:06:52.43,0:06:55.48,,,0,0,0,,Жерге ұшып кеткен күріш пен шоқ
Dialogue: 0,0:06:55.69,0:06:59.32,,,0,0,0,,Жанжал Амбиция Қайғылылық
Dialogue: 0,0:06:59.48,0:07:02.15,,,0,0,0,,Мен бәрін жұтып қойдым.
Dialogue: 0,0:07:06.07,0:07:10.16,,,0,0,0,,Қайғыға айырбас,бәрі бітті.
Dialogue: 0,0:07:10.29,0:07:13.58,,,0,0,0,,Бұл маған екі жыл бұрын айтылған болатын.
Dialogue: 0,0:08:11.47,0:08:12.89,,,0,0,0,,Ей,кеттік
Dialogue: 0,0:08:13.06,0:08:13.72,,,0,0,0,,Иә
Dialogue: 0,0:08:15.31,0:08:16.73,,,0,0,0,,Уау,бұл қауіпті.
Dialogue: 0,0:08:34.37,0:08:36.25,,,0,0,0,,Бірақ... жұлдыздар
Dialogue: 0,0:08:36.41,0:08:41.88,,,0,0,0,,Сіз біз ойлағаннан әлдеқайда ашуланған сияқтысыз.
Dialogue: 0,0:08:46.51,0:08:48.84,,,0,0,0,,Жұлдыздық тыртық синдромы
Dialogue: 0,0:08:52.85,0:08:54.56,,,0,0,0,,Сәлем,теңізші?
Dialogue: 0,0:08:54.81,0:08:56.10,,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:08:59.69,0:09:01.11,,,0,0,0,,Жарайды,мен кеттім. Қош бол.
Dialogue: 0,0:09:01.23,0:09:04.86,,,0,0,0,,Дензелді қабылдамаңыз.
Dialogue: 0,0:09:12.24,0:09:15.62,,,0,0,0,,Тергеу комиссиясының бүгін таңертең жарияланған есебіне сәйкес.
Dialogue: 0,0:09:15.74,0:09:20.12,,,0,0,0,,Атмосферадағы тіршілік ағынының концентрациясы екі жыл бұрынғыдан шамамен 1/100 құрайды.
Dialogue: 0,0:09:20.29,0:09:24.09,,,0,0,0,,Деңгейі адам ағзасына әсер етпейтін деңгейге дейін төмендеді дейді.
Dialogue: 0,0:09:24.38,0:09:25.96,,,0,0,0,,Дегенмен,Shinra компаниясының бас кеңсесінің ғимараты
Dialogue: 0,0:09:26.09,0:09:28.59,,,0,0,0,,Ол енді мұнда емес.
Dialogue: 0,0:09:29.17,0:09:30.97,,,0,0,0,,...әлі де қауіпті деңгейде
Dialogue: 0,0:09:31.09,0:09:33.97,,,0,0,0,,Жұлдыз тыртықтарының пайда болуын болдырмау үшін нысанның айналасындағы аумақ болуы керек
Dialogue: 0,0:09:34.14,0:09:37.64,,,0,0,0,,Комитет сізге алыс болуды ескертеді.
Dialogue: 0,0:09:38.77,0:09:42.98,,,0,0,0,,Төменде Shinra компаниясына қарсы өтемақы талап етуіне қатысты жаңалықтар берілген.
Dialogue: 0,0:09:45.40,0:09:46.78,,,0,0,0,,Бұлт
Dialogue: 0,0:09:47.15,0:09:48.90,,,0,0,0,,Қайдасың?
Dialogue: 0,0:10:01.50,0:10:03.92,,,0,0,0,,Иә,бұл өмірді жеткізу қызметі.
Dialogue: 0,0:10:04.08,0:10:05.46,,,0,0,0,,Біздің компания кез келген нәрсені жасай алады.
Dialogue: 0,0:10:07.17,0:10:09.01,,,0,0,0,,...Сен қайсысысың?
Dialogue: 0,0:10:14.68,0:10:16.68,,,0,0,0,,есімде.
Dialogue: 0,0:10:37.95,0:10:40.29,,,0,0,0,,Маған Хириндегі Рено қоңырау шалды.
Dialogue: 0,0:10:40.41,0:10:42.12,,,0,0,0,,Тіпті жұмысқа сұраныс
Dialogue: 0,0:10:42.37,0:10:44.88,,,0,0,0,,Бұлт... қалдарың қалай?
Dialogue: 0,0:10:45.54,0:10:47.88,,,0,0,0,,Осының бәрі хабар үшін
Dialogue: 0,0:11:56.95,0:12:00.62,,,0,0,0,,Әй,бұл менің ағамның қаласы ма?
Dialogue: 0,0:12:01.79,0:12:02.62,,,0,0,0,,О
Dialogue: 0,0:12:03.20,0:12:05.71,,,0,0,0,,Олар сізді қарсы алады деп ойлайсыз ба?
Dialogue: 0,0:12:05.83,0:12:06.62,,,0,0,0,,Ақылға қонымсыз
Dialogue: 0,0:12:06.96,0:12:08.75,,,0,0,0,,Жылама,Язу
Dialogue: 0,0:12:09.54,0:12:11.88,,,0,0,0,,Сенің анаң да осында емес пе?
Dialogue: 0,0:12:13.26,0:12:14.88,,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:12:15.55,0:12:16.93,,,0,0,0,,Жылама,Таяқтар
Dialogue: 0,0:12:23.47,0:12:25.48,,,0,0,0,,Қарашы,бұл менің ағам.
Dialogue: 0,0:13:05.18,0:13:06.93,,,0,0,0,,Менің анам қайда?
Dialogue: 0,0:13:11.52,0:13:13.32,,,0,0,0,,Сенің ағаң жасырып жатыр,солай ма?
Dialogue: 0,0:13:22.70,0:13:25.49,,,0,0,0,,Сіз мені алдаған шығарсыз?
Dialogue: 0,0:13:25.87,0:13:27.87,,,0,0,0,,Сенің анаң солай ғой,солай ма?
Dialogue: 0,0:13:29.12,0:13:30.71,,,0,0,0,,Айқайламаңыз
Dialogue: 0,0:13:32.75,0:13:34.88,,,0,0,0,,Мен сенімен сөйлескім келмейді
Dialogue: 0,0:13:36.30,0:13:38.01,,,0,0,0,,Президент атынан
Dialogue: 0,0:15:02.09,0:15:04.13,,,0,0,0,,Сіз қашып кетпедіңіз ғой?
Dialogue: 0,0:15:08.56,0:15:11.98,,,0,0,0,,Эй,бұл Баррет! Мен оны істедім! Жаңа мұнай кен орны!
Dialogue: 0,0:15:12.14,0:15:15.56,,,0,0,0,,Юден! Ол сондай үлкен!
Dialogue: 0,0:15:15.65,0:15:18.82,,,0,0,0,,Енді менде жоспар бар,мен жақында Маринді көремін!
Dialogue: 0,0:15:18.98,0:15:20.82,,,0,0,0,,Айтыңызшы.
Dialogue: 0,0:15:24.78,0:15:26.82,,,0,0,0,,Леноның тағы бір күн күркіреуі туралы әңгімесі.
Dialogue: 0,0:15:27.20,0:15:28.95,,,0,0,0,,Тезірек.
Dialogue: 0,0:15:29.53,0:15:33.29,,,0,0,0,,Оның бойында біртүрлі нәрсе болды... бірақ абай болыңыз.
Dialogue: 0,0:15:56.02,0:15:57.10,,,0,0,0,,Урия~~
Dialogue: 0,0:16:02.65,0:16:04.53,,,0,0,0,,Күтілгендей.
Dialogue: 0,0:16:13.79,0:16:15.71,,,0,0,0,,Людо! керемет!
Dialogue: 0,0:16:24.17,0:16:27.34,,,0,0,0,,Өзін-өзі жариялаған бұрынғы жауынгер күткендей.
Dialogue: 0,0:16:35.81,0:16:38.02,,,0,0,0,,Сіздің қолыңыз түтіккен сияқты емес.
Dialogue: 0,0:16:45.03,0:16:46.74,,,0,0,0,,Бұл Руфусна ма?
Dialogue: 0,0:16:48.07,0:16:49.41,,,0,0,0,,Сіз де жазылмайсыз.
Dialogue: 0,0:16:54.91,0:16:55.87,,,0,0,0,,Сол күні I
Dialogue: 0,0:16:55.95,0:16:56.83,,,0,0,0,,Мен саған не үшін керекпін?
Dialogue: 0,0:16:56.96,0:16:57.75,,,0,0,0,,Ғимарат құламас бұрын...
Dialogue: 0,0:16:57.87,0:16:58.92,,,0,0,0,,Маған кім шабуыл жасады?
Dialogue: 0,0:16:59.04,0:16:59.42,,,0,0,0,,38-тарау: Алтын тәжірибе · Реквием
Dialogue: 0,0:16:59.54,0:17:00.58,,,0,0,0,,Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,0:17:03.88,0:17:05.88,,,0,0,0,,...Маған сенің көмегің керек.
Dialogue: 0,0:17:06.01,0:17:06.67,,,0,0,0,,Мені қызықтырмайды.
Dialogue: 0,0:17:06.76,0:17:11.55,,,0,0,0,,Біз, Шинра компаниясы,әлем алдында үлкен қарыздармыз.
Dialogue: 0,0:17:11.93,0:17:15.02,,,0,0,0,,Дүниені осы бейшара күйге жеткізген алым
Dialogue: 0,0:17:15.10,0:17:18.10,,,0,0,0,,Бізде бар деуден пайда жоқ.
Dialogue: 0,0:17:18.35,0:17:22.27,,,0,0,0,,Сондықтан бұл қарыз барлық шығындармен өтелуі керек.
Dialogue: 0,0:17:22.36,0:17:23.44,,,0,0,0,,Оны ашыңыз.
Dialogue: 0,0:17:23.61,0:17:25.44,,,0,0,0,,Бірінші қадам ретінде
Dialogue: 0,0:17:25.73,0:17:29.36,,,0,0,0,,Біз Сефишу қалдырған ықпалды зерттей бастадық.
Dialogue: 0,0:17:30.53,0:17:32.03,,,0,0,0,,Содан бері екі жыл өтті
Dialogue: 0,0:17:32.32,0:17:36.95,,,0,0,0,,Қалпына келу жолына түскен әлем үшін ең үлкен қауіп қандай?
Dialogue: 0,0:17:38.37,0:17:43.96,,,0,0,0,,Дұрыс,жиіркенішті жұлдыз тыртық синдромы.
Dialogue: 0,0:17:44.79,0:17:49.63,,,0,0,0,,Себебі Сефимандарда жатыр деп есептейміз.
Dialogue: 0,0:17:51.26,0:17:54.93,,,0,0,0,,Дүниеде сиқырлы қуық пеші және сиқырлы қуық энергиясы
Dialogue: 0,0:17:55.01,0:17:59.14,,,0,0,0,,Ал өмір кеңістігі жұлдыз тыртықтарының себебі деп есептеледі.
Dialogue: 0,0:17:59.52,0:18:02.27,,,0,0,0,,Бірақ шынымен солай ма?
Dialogue: 0,0:18:02.48,0:18:05.61,,,0,0,0,,Өмір ағымдары жұлдыздардың тууымен бірге болады.
Dialogue: 0,0:18:05.69,0:18:09.82,,,0,0,0,,Сиқырлы энергияның практикалық қолданысқа енгізілгеніне 40 жылдан астам уақыт өтті.
Dialogue: 0,0:18:10.07,0:18:11.78,,,0,0,0,,қарамастан
Dialogue: 0,0:18:11.86,0:18:15.16,,,0,0,0,,Жұлдыздық белгілер тарихта ешқашан пайда болмайды.
Dialogue: 0,0:18:15.99,0:18:16.99,,,0,0,0,,Сонымен
Dialogue: 0,0:18:17.33,0:18:21.00,,,0,0,0,,Біздің уақытта нақты не болды?
Dialogue: 0,0:18:21.41,0:18:23.79,,,0,0,0,,Бір ғана мүмкіндік бар
Dialogue: 0,0:18:24.54,0:18:26.17,,,0,0,0,,Сефирот пайда болады.
Dialogue: 0,0:18:26.34,0:18:27.46,,,0,0,0,,Сефирот өлді
Dialogue: 0,0:18:27.55,0:18:29.67,,,0,0,0,,Оның ақыл-ойы қалай?
Dialogue: 0,0:18:30.38,0:18:32.18,,,0,0,0,,Өмір ағымына балқу
Dialogue: 0,0:18:32.26,0:18:36.35,,,0,0,0,,Бірақ егер ол таралмай жұлдыздарды айналып жүрсе ше?
Dialogue: 0,0:18:38.22,0:18:42.19,,,0,0,0,,Әрине бұл менің қиялым ғана.
Dialogue: 0,0:18:42.31,0:18:45.36,,,0,0,0,,Бірақ бұл мүмкіндікті жоққа шығаруға болмайды
Dialogue: 0,0:18:45.86,0:18:49.48,,,0,0,0,,Шындықты білу жұлдызды тыртықтарды емдеуге әкеледі.
Dialogue: 0,0:18:50.36,0:18:52.36,,,0,0,0,,Сонымен,біз...
Dialogue: 0,0:18:52.49,0:18:55.53,,,0,0,0,,Сефироттың іздерін зерттеуді бастады.
Dialogue: 0,0:18:55.78,0:18:57.03,,,0,0,0,,Ең алдымен
Dialogue: 0,0:18:58.45,0:19:00.04,,,0,0,0,,Есіңде ме?
Dialogue: 0,0:19:00.12,0:19:02.29,,,0,0,0,,Бұл солтүстіктегі үлкен үңгір.
Dialogue: 0,0:19:02.71,0:19:04.29,,,0,0,0,,Не болды деп ойлайсың?
Dialogue: 0,0:19:05.71,0:19:07.17,,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора,Лорд Широ.
Dialogue: 0,0:19:07.71,0:19:10.21,,,0,0,0,,Онда ештеңе болған жоқ.
Dialogue: 0,0:19:12.05,0:19:15.22,,,0,0,0,,Бірақ күтпеген жағдай болды.
Dialogue: 0,0:19:16.26,0:19:17.55,,,0,0,0,,Олар
Dialogue: 0,0:19:17.89,0:19:19.72,,,0,0,0,,Ол пайда болды.
Dialogue: 0,0:19:21.27,0:19:22.56,,,0,0,0,,Жүр!
Dialogue: 0,0:19:34.65,0:19:36.24,,,0,0,0,,Дәмі Кадайчиюге ұқсайды.
Dialogue: 0,0:19:37.70,0:19:39.08,,,0,0,0,,Кадайчижу
Dialogue: 0,0:19:39.20,0:19:41.75,,,0,0,0,,Ол да сенен кейін келеді.
Dialogue: 0,0:19:41.91,0:19:43.91,,,0,0,0,,Байланыс болған жоқ па?
Dialogue: 0,0:19:44.04,0:19:45.25,,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:19:45.37,0:19:47.58,,,0,0,0,,Мен оны міндетті түрде қайтарамын.
Dialogue: 0,0:19:47.71,0:19:48.71,,,0,0,0,,Жоқ
Dialogue: 0,0:19:49.25,0:19:53.76,,,0,0,0,,Сіз де біз сияқты Сефиенсумен тығыз байланыстасыз.
Dialogue: 0,0:19:54.42,0:19:59.51,,,0,0,0,,Кадайчиюдің мақсаты жақын арада болатын сәтке дайындалу болса.
Dialogue: 0,0:19:59.60,0:20:02.68,,,0,0,0,,Жолда бізден артық ешкім жоқ.
Dialogue: 0,0:20:03.02,0:20:04.27,,,0,0,0,,Дайындық?
Dialogue: 0,0:20:05.98,0:20:07.60,,,0,0,0,,Сефи энциклопедиясы
Dialogue: 0,0:20:09.44,0:20:10.44,,,0,0,0,,Қайта тірілу
Dialogue: 0,0:20:10.57,0:20:11.73,,,0,0,0,,Әңгіме аяқталды ма?
Dialogue: 0,0:20:11.82,0:20:13.90,,,0,0,0,,Енді негізгі тақырыпқа көшейік.
Dialogue: 0,0:20:14.53,0:20:19.28,,,0,0,0,,Кадажюймен және басқалармен күресу үшін бізге сіздің күшіңіз керек.
Dialogue: 0,0:20:19.91,0:20:24.62,,,0,0,0,,Қол ұстасайық па? Бұрынғы солдат бұлт
Dialogue: 0,0:20:26.58,0:20:27.92,,,0,0,0,,Өзін-өзі жариялады
Dialogue: 0,0:20:31.96,0:20:35.76,,,0,0,0,,Ана дегенді қалай түсінесіңдер?
Dialogue: 0,0:20:35.88,0:20:37.09,,,0,0,0,,Келіңіздер
Dialogue: 0,0:20:37.76,0:20:40.05,,,0,0,0,,Қуат бірдеңе деді ме?
Dialogue: 0,0:20:40.30,0:20:41.64,,,0,0,0,,Руфус
Dialogue: 0,0:20:42.47,0:20:44.14,,,0,0,0,,Не жасырып тұрсың?
Dialogue: 0,0:20:44.93,0:20:48.77,,,0,0,0,,Сізбен бірге соғысатын жолдастарыңыздан ештеңе жасырмаңыз.
Dialogue: 0,0:20:50.19,0:20:53.73,,,0,0,0,,Сізге де жұлдыз тыртықтары туралы ақпарат керек екеніне сенімдімін.
Dialogue: 0,0:20:54.19,0:20:56.99,,,0,0,0,,Бірге тұратын жетім балаларға
Dialogue: 0,0:20:59.16,0:21:02.99,,,0,0,0,,Балалардың жүзіне күлкі сыйлағың келмей ме?
Dialogue: 0,0:21:03.45,0:21:09.58,,,0,0,0,,Біздің түпкі мақсатымыз – бұлт әлемін қайта құру.
Dialogue: 0,0:21:18.42,0:21:19.01,,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:21:19.13,0:21:23.97,,,0,0,0,,Өтінемін, Бұлт,Шинра компаниясын қайта құрыңыз.
Dialogue: 0,0:21:25.52,0:21:27.02,,,0,0,0,,Мені қызықтырмайды.
Dialogue: 0,0:21:27.85,0:21:28.85,,,0,0,0,,Лено!
Dialogue: 0,0:21:52.58,0:21:54.88,,,0,0,0,,Бұлт осында өмір сүре ме?
Dialogue: 0,0:21:55.55,0:21:56.88,,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:22:05.56,0:22:06.51,,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:22:26.03,0:22:29.58,,,0,0,0,,Дензел сияқты! Бұлт та ауырып қалды!?
Dialogue: 0,0:22:31.66,0:22:33.17,,,0,0,0,,Маған айтсаңызшы.
Dialogue: 0,0:22:33.25,0:22:35.75,,,0,0,0,,Сіз ауырып қалдыңыз ба?
Dialogue: 0,0:22:36.04,0:22:38.21,,,0,0,0,,Мен жалғыз күресуге дайынмын.
Dialogue: 0,0:22:38.30,0:22:39.17,,,0,0,0,,Ұрыс?
Dialogue: 0,0:22:39.26,0:22:40.09,,,0,0,0,,Әртүрлі
Dialogue: 0,0:22:43.18,0:22:44.93,,,0,0,0,,Менің ұрысуға ниетім жоқ.
Dialogue: 0,0:22:45.76,0:22:46.85,,,0,0,0,,Тифа?
Dialogue: 0,0:22:49.97,0:22:50.93,,,0,0,0,,Теңізші үйге қайтайық
Dialogue: 0,0:22:53.73,0:22:55.77,,,0,0,0,,Жоқ,мен Бұлтпен кездескім келеді.
Dialogue: 0,0:23:00.36,0:23:01.44,,,0,0,0,,...Дұрыс.
Dialogue: 0,0:23:05.11,0:23:06.24,,,0,0,0,,Мен сені көргім келеді.
Dialogue: 0,0:23:06.37,0:23:07.24,,,0,0,0,,Иә!
Dialogue: 0,0:23:07.99,0:23:10.79,,,0,0,0,,Әй,кездессек не істейміз?
Dialogue: 0,0:23:11.04,0:23:12.62,,,0,0,0,,Үйге бірге барайық!
Dialogue: 0,0:23:13.12,0:23:16.54,,,0,0,0,,Оның алдында мен сендерге уағыз айтайын.
Dialogue: 0,0:23:16.83,0:23:18.29,,,0,0,0,,Келісемін!
Dialogue: 0,0:23:20.92,0:23:23.63,,,0,0,0,,Енді бастық пен Иринаны іздеу керек.
Dialogue: 0,0:23:26.47,0:23:28.30,,,0,0,0,,Басқа қызметкерлердің ақпараты туралы не деуге болады?
Dialogue: 0,0:23:28.43,0:23:29.93,,,0,0,0,,Әзірге
Dialogue: 0,0:23:35.31,0:23:39.48,,,0,0,0,,Бұрынғы қызметкерлер... Мен күткеннен де көп адам келеді.
Dialogue: 0,0:23:39.98,0:23:41.48,,,0,0,0,,Маған қатты әсер етті.
Dialogue: 0,0:23:41.61,0:23:44.15,,,0,0,0,,Мен мұны қайталай аламын.
Dialogue: 0,0:23:44.86,0:23:48.49,,,0,0,0,,Өтелу - аман қалғандардың міндеті.
Dialogue: 0,0:23:51.04,0:23:53.00,,,0,0,0,,Содан бері екі жыл өтті.
Dialogue: 0,0:23:53.75,0:23:54.62,,,0,0,0,,Иә?
Dialogue: 0,0:23:55.08,0:23:57.63,,,0,0,0,,2 жыл бар ма?
Dialogue: 0,0:23:59.34,0:24:01.17,,,0,0,0,,Бұл қорқынышты түс болды
Dialogue: 0,0:24:01.63,0:24:04.09,,,0,0,0,,Дүние жойылып кете жаздады
Dialogue: 0,0:24:04.34,0:24:06.47,,,0,0,0,,Бұл біздің кінәміз,Шинра.
Dialogue: 0,0:24:09.35,0:24:10.68,,,0,0,0,,Маңызды әңгіме
Dialogue: 0,0:24:10.81,0:24:13.18,,,0,0,0,,Мен оған қанша төлеуім керек деп ойлаймын.
Dialogue: 0,0:24:14.64,0:24:17.52,,,0,0,0,,Маған бастықтың болуы керек.
Dialogue: 0,0:24:19.19,0:24:20.44,,,0,0,0,,Ирина да
Dialogue: 0,0:24:24.19,0:24:26.03,,,0,0,0,,Өтінемін аман бол
Dialogue: 0,0:24:26.20,0:24:27.49,,,0,0,0,,Жарайды
Dialogue: 0,0:24:28.11,0:24:30.20,,,0,0,0,,Цен мырза да президентпен бірдей.
Dialogue: 0,0:24:30.70,0:24:32.33,,,0,0,0,,Бір рет дерлік қайтыс болды
Dialogue: 0,0:24:33.04,0:24:34.54,,,0,0,0,,Сәтсіздік күшті
Dialogue: 0,0:24:34.91,0:24:36.33,,,0,0,0,,Міне!
Dialogue: 0,0:24:45.05,0:24:46.97,,,0,0,0,,Табылды/
Dialogue: 0,0:24:59.06,0:25:00.52,,,0,0,0,,Шіркеу дегеніміз не?
Dialogue: 0,0:25:03.15,0:25:05.23,,,0,0,0,,О,ана жерде ме?
Dialogue: 0,0:25:06.15,0:25:08.15,,,0,0,0,,Иә,мен күтемін.
Dialogue: 0,0:26:36.66,0:26:40.41,,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:26:41.75,0:26:45.50,,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:26:46.84,0:26:50.67,,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:26:51.92,0:26:55.80,,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:26:57.05,0:27:00.85,,,0,0,0,,Жетінші авенюдегі барлық телефондар жұмыс істемейді.
Dialogue: 0,0:27:36.01,0:27:36.97,,,0,0,0,,Бұлт
Dialogue: 0,0:27:37.09,0:27:39.39,,,0,0,0,,Маған телефон соғатындар сирек.
Dialogue: 0,0:27:39.72,0:27:41.06,,,0,0,0,,Не болды?
Dialogue: 0,0:27:44.14,0:27:45.19,,,0,0,0,,Бұлт?
Dialogue: 0,0:27:46.40,0:27:47.81,,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:27:48.77,0:27:52.07,,,0,0,0,,Кім? Мұны Cloud телефонында жасай аласыз ба?
Dialogue: 0,0:27:52.69,0:27:54.07,,,0,0,0,,Тұр,мен өзі қандай ұлтпын? Хехехе
Dialogue: 0,0:27:54.74,0:27:55.99,,,0,0,0,,Бұл кім?
Dialogue: 0,0:27:57.53,0:27:58.91,,,0,0,0,,Тұр,мен өзі қандай ұлтпын? Хехехе
Dialogue: 0,0:27:59.24,0:28:03.41,,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,0:28:06.08,0:28:08.58,,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:28:17.43,0:28:18.76,,,0,0,0,,Не болды? Сенімен бәрі жақсы ма?
Dialogue: 0,0:28:19.43,0:28:21.85,,,0,0,0,,Бұлт! Бұлт! Сен ондасың ба?
Dialogue: 0,0:28:29.94,0:28:30.94,,,0,0,0,,Нет... не істеп жатырсың...
Dialogue: 0,0:28:37.07,0:28:38.20,,,0,0,0,,Амансың ба?
Dialogue: 0,0:29:21.74,0:29:23.83,,,0,0,0,,Өтірікті жек көремін.
Dialogue: 0,0:29:24.08,0:29:27.33,,,0,0,0,,Бұл жаман болды. Мен бұл жолы шын боламын.
Dialogue: 0,0:29:27.58,0:29:29.58,,,0,0,0,,Ол сендерден қашып кетті.
Dialogue: 0,0:29:29.71,0:29:31.63,,,0,0,0,,Тікұшақтан құлаған сияқты
Dialogue: 0,0:29:32.13,0:29:34.00,,,0,0,0,,Бұл ақымақ әңгіме.
Dialogue: 0,0:29:35.05,0:29:37.01,,,0,0,0,,Шынымен бе?
Dialogue: 0,0:29:37.55,0:29:38.97,,,0,0,0,,Ант етемін
Dialogue: 0,0:29:40.89,0:29:43.18,,,0,0,0,,Содан кейін бұл туралы ант етіңіз.
Dialogue: 0,0:29:50.39,0:29:51.69,,,0,0,0,,Мақсаты не?
Dialogue: 0,0:29:51.85,0:29:54.69,,,0,0,0,,Маған анаңның күші керек.
Dialogue: 0,0:29:55.27,0:29:58.53,,,0,0,0,,Реюнионның басқа амалы жоқ
Dialogue: 0,0:29:59.40,0:30:00.53,,,0,0,0,,Кездесу
Dialogue: 0,0:30:01.11,0:30:04.53,,,0,0,0,,Анамның ұяшықтарын алған достар бір жерге жиналады.
Dialogue: 0,0:30:04.83,0:30:07.20,,,0,0,0,,Ал жұлдыздардан кек ал
Dialogue: 0,0:30:07.79,0:30:10.37,,,0,0,0,,Дайындық тұрақты түрде жүріп жатыр.
Dialogue: 0,0:30:11.12,0:30:15.80,,,0,0,0,,Қараңдаршы,анамды біреу жасырып қалды.
Dialogue: 0,0:30:15.96,0:30:17.00,,,0,0,0,,Дайындық?
Dialogue: 0,0:30:17.84,0:30:18.96,,,0,0,0,,Жұлдызды тыртық
Dialogue: 0,0:30:19.80,0:30:22.13,,,0,0,0,,Мұны президент те біледі.
Dialogue: 0,0:30:22.97,0:30:24.64,,,0,0,0,,Өмір ағымында
Dialogue: 0,0:30:24.72,0:30:27.39,,,0,0,0,,Мұның бәрі анамның тынымсыз еңбек еткен генетикалық ойларының арқасы.
Dialogue: 0,0:30:28.14,0:30:30.73,,,0,0,0,,Дегенмен біз
Dialogue: 0,0:30:31.23,0:30:33.23,,,0,0,0,,Мен анамның қайда екенін де білмеймін.
Dialogue: 0,0:30:35.19,0:30:38.53,,,0,0,0,,Бұл аянышты,бірақ мен оған көмектесе алмаймын.
Dialogue: 0,0:30:39.07,0:30:41.82,,,0,0,0,,Өйткені біз ойлау формаларымыз.
Dialogue: 0,0:30:41.95,0:30:45.03,,,0,0,0,,Мен анамды тауып,онымен ұяшықтарымды бөліскенше.
Dialogue: 0,0:30:45.12,0:30:46.99,,,0,0,0,,Қалыпты күйге оралу мүмкін емес
Dialogue: 0,0:30:47.83,0:30:50.75,,,0,0,0,,Тек ойлар мен жұлдызшалар жеткілікті.
Dialogue: 0,0:30:51.08,0:30:54.08,,,0,0,0,,Нағыз кездесуге.
Dialogue: 0,0:30:54.25,0:30:55.42,,,0,0,0,,...Не айтып тұрсың?
Dialogue: 0,0:30:57.59,0:31:01.92,,,0,0,0,,Президент... сіз бұл туралы білесіз бе?
Dialogue: 0,0:31:38.92,0:31:40.21,,,0,0,0,,(Иура) Жарайды,жарайды. (Мотоко) Оны қолыңмен тиме.
Dialogue: 0,0:31:42.92,0:31:44.80,,,0,0,0,,Уау! Жұлдызды тыртықтар!
Dialogue: 0,0:31:50.81,0:31:52.31,,,0,0,0,,Үйден шықпаңыз!
Dialogue: 0,0:32:07.32,0:32:08.16,,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:32:38.90,0:32:40.98,,,0,0,0,,Сен үшін өмір сүрейік
Dialogue: 0,0:32:42.90,0:32:45.03,,,0,0,0,,Мен осылай шештім...
Dialogue: 0,0:32:45.36,0:32:48.36,,,0,0,0,,Сіз солдат болғыңыз келе ме? Іске сәт!
Dialogue: 0,0:32:48.45,0:32:50.12,,,0,0,0,,Әй,көңіл-күйің қалай?
Dialogue: 0,0:32:50.20,0:32:53.62,,,0,0,0,,Эй Миг,Мидгарға жеткенде не істейсің?
Dialogue: 0,0:32:54.04,0:32:56.29,,,0,0,0,,Бұл Бокумодачи,солай ма?
Dialogue: 0,0:33:04.17,0:33:06.38,,,0,0,0,,Қария! Тастың артындағы бір жерде тоқтаңыз!
Dialogue: 0,0:33:06.67,0:33:08.51,,,0,0,0,,Бұлт Түсейік!
Dialogue: 0,0:33:11.93,0:33:13.72,,,0,0,0,,Менің мақтанышым мен армандарым
Dialogue: 0,0:33:16.10,0:33:17.56,,,0,0,0,,Барлығын орындаңыз
Dialogue: 0,0:33:18.48,0:33:19.81,,,0,0,0,,Сіз
Dialogue: 0,0:33:21.90,0:33:23.98,,,0,0,0,,Менің тірі дәлелім
Dialogue: 0,0:33:26.99,0:33:30.36,,,0,0,0,,Сол кезде мен ұмытпаймын деп ант еткенмін.
Dialogue: 0,0:33:31.57,0:33:32.53,,,0,0,0,,Бірақ...
Dialogue: 0,0:33:33.49,0:33:34.58,,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:33:41.92,0:33:44.17,,,0,0,0,,Көңілсіз болып көрінуді доғар.
Dialogue: 0,0:33:45.80,0:33:48.92,,,0,0,0,,Ашумен әрекет етудің қажеті жоқ
Dialogue: 0,0:33:50.47,0:33:53.05,,,0,0,0,,Өйткені бұлт
Dialogue: 0,0:33:54.05,0:33:55.35,,,0,0,0,,Сіз
Dialogue: 0,0:33:56.10,0:33:57.68,,,0,0,0,,Бұл қуыршақ.
Dialogue: 0,0:34:10.57,0:34:11.28,,,0,0,0,,Ах!
Dialogue: 0,0:34:15.53,0:34:16.29,,,0,0,0,,Ах!
Dialogue: 0,0:34:25.21,0:34:26.71,,,0,0,0,,Ойнайық па?
Dialogue: 0,0:34:30.47,0:34:32.13,,,0,0,0,,Иә немесе жоқ
Dialogue: 0,0:34:34.85,0:34:36.14,,,0,0,0,,Сенің анаң ше?
Dialogue: 0,0:34:37.68,0:34:38.31,,,0,0,0,,А?
Dialogue: 0,0:34:44.69,0:34:45.65,,,0,0,0,,Білсін
Dialogue: 0,0:34:47.82,0:34:49.32,,,0,0,0,,Әй,анаң ше?
Dialogue: 0,0:34:49.40,0:34:50.78,,,0,0,0,,Мұнда ешкім жоқ!
Dialogue: 0,0:34:52.45,0:34:55.07,,,0,0,0,,Олай болса ойнайық
Dialogue: 0,0:35:09.00,0:35:10.76,,,0,0,0,,Бұл қиын және қызықты.
Dialogue: 0,0:36:26.92,0:36:27.92,,,0,0,0,,Тихуа!
Dialogue: 0,0:36:56.70,0:36:58.70,,,0,0,0,,Мұнда емес
Dialogue: 0,0:37:00.45,0:37:01.78,,,0,0,0,,Жылама
Dialogue: 0,0:37:03.83,0:37:04.75,,,0,0,0,,Сонымен қатар,сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:37:05.29,0:37:06.46,,,0,0,0,,Әкел
Dialogue: 0,0:37:11.79,0:37:12.54,,,0,0,0,,Жалғасы
Dialogue: 0,0:38:11.85,0:38:12.52,,,0,0,0,,Бұлт
Dialogue: 0,0:38:14.06,0:38:14.69,,,0,0,0,,Қаш!
Dialogue: 0,0:38:33.13,0:38:35.54,,,0,0,0,,Бұрынғы үшін кешіріңіз.
Dialogue: 0,0:38:37.71,0:38:38.80,,,0,0,0,,Рахмет
Dialogue: 0,0:38:43.09,0:38:44.01,,,0,0,0,,Иә
Dialogue: 0,0:38:47.22,0:38:48.39,,,0,0,0,,інісі
Dialogue: 0,0:38:50.81,0:38:52.48,,,0,0,0,,Ол кетті
Dialogue: 0,0:38:54.77,0:38:56.06,,,0,0,0,,Мен көремін.
Dialogue: 0,0:38:57.27,0:39:00.24,,,0,0,0,,Ей, сен де жұлдыздың тыртығысың,солай ма?
Dialogue: 0,0:39:01.40,0:39:03.16,,,0,0,0,,Сені емдейді дейді.
Dialogue: 0,0:39:56.12,0:39:56.71,,,0,0,0,,Тифа?
Dialogue: 0,0:39:59.71,0:40:00.71,,,0,0,0,,Тифа!!
Dialogue: 0,0:40:07.84,0:40:08.97,,,0,0,0,,Кеш болды.
Dialogue: 0,0:40:09.30,0:40:10.64,,,0,0,0,,Мұны кім жасады?
Dialogue: 0,0:40:13.10,0:40:14.77,,,0,0,0,,Бейтаныс
Dialogue: 0,0:40:16.48,0:40:17.06,,,0,0,0,,Теңіз!?
Dialogue: 0,0:40:26.49,0:40:27.32,,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:41:37.85,0:41:39.90,,,0,0,0,,Ауыр болды.
Dialogue: 0,0:41:40.56,0:41:43.90,,,0,0,0,,...Сіз балаларыңызбен бірге тұрдыңыз.
Dialogue: 0,0:41:44.36,0:41:45.90,,,0,0,0,,Ол бос
Dialogue: 0,0:41:50.20,0:41:51.41,,,0,0,0,,Жарайды ма?
Dialogue: 0,0:41:55.04,0:41:55.91,,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:42:06.92,0:42:08.42,,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,0:42:21.94,0:42:24.44,,,0,0,0,,Тифа сені алып келгенімді қалайды.
Dialogue: 0,0:42:27.11,0:42:28.11,,,0,0,0,,Ұстау
Dialogue: 0,0:43:03.69,0:43:05.61,,,0,0,0,,Мені кім емдейді?
Dialogue: 0,0:43:08.98,0:43:09.90,,,0,0,0,,Маған сән журналының түсірілімінде қолданылған осы киімді берді
Dialogue: 0,0:43:13.03,0:43:16.62,,,0,0,0,,Иә... Мен енді ешкімді ойламаймын.
Dialogue: 0,0:43:35.34,0:43:37.76,,,0,0,0,,Оны ағаң жасырды ма?
Dialogue: 0,0:43:40.14,0:43:43.19,,,0,0,0,,Өмір ағымынан туған қуат
Dialogue: 0,0:43:46.23,0:43:51.03,,,0,0,0,,Осы материал арқылы біз де жаңа күшке ие бола аламыз.
Dialogue: 0,0:43:53.90,0:43:57.37,,,0,0,0,,Анаң саған қалдырды,солай ма?
Dialogue: 0,0:43:57.53,0:43:59.53,,,0,0,0,,О,мен сенімдімін
Dialogue: 0,0:44:00.20,0:44:02.70,,,0,0,0,,Ағаң да анаңды жасырып жүр ме?
Dialogue: 0,0:44:03.21,0:44:05.67,,,0,0,0,,Жоқ,бұл президент.
Dialogue: 0,0:44:06.29,0:44:10.67,,,0,0,0,,Шинра компаниясы әрқашан аналарды жасырғанды ​​ұнататын.
Dialogue: 0,0:44:11.92,0:44:15.97,,,0,0,0,,Олай болса,сізге тек Шинраға қатысты барлық жерлерді іздеу керек.
Dialogue: 0,0:44:16.38,0:44:20.39,,,0,0,0,,Иә,жақында достарымыз көп болады.
Dialogue: 0,0:44:21.18,0:44:23.23,,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:44:25.48,0:44:27.02,,,0,0,0,,Бұл қандай жаман иіс?
Dialogue: 0,0:44:28.06,0:44:30.40,,,0,0,0,,Мен ағама шағым айтуым керек.
Dialogue: 0,0:44:31.27,0:44:34.32,,,0,0,0,,Бұның бәрі сізге қатысы жоқ деп ойлаңыз
Dialogue: 0,0:44:35.28,0:44:37.99,,,0,0,0,,Мен шынымен жалғызбын
Dialogue: 0,0:44:39.41,0:44:40.03,,,0,0,0,,Уау!
Dialogue: 0,0:44:40.58,0:44:41.54,,,0,0,0,,Кя!
Dialogue: 0,0:44:46.41,0:44:47.37,,,0,0,0,,Сәлем?
Dialogue: 0,0:45:08.44,0:45:10.27,,,0,0,0,,Рено және басқалар іздейді
Dialogue: 0,0:45:15.78,0:45:19.53,,,0,0,0,,Жұлдызды тыртық синдромы... солай ма?
Dialogue: 0,0:45:21.03,0:45:24.20,,,0,0,0,,Мен осылай өлсем де болады...Қалай ойлайсың?
Dialogue: 0,0:45:29.37,0:45:30.63,,,0,0,0,,Күтілгендей
Dialogue: 0,0:45:31.63,0:45:33.30,,,0,0,0,,Емдеу жоқ
Dialogue: 0,0:45:33.84,0:45:36.63,,,0,0,0,,Бірақ Дензел барын салуда.
Dialogue: 0,0:45:37.30,0:45:39.47,,,0,0,0,,Қашпа,бірігіп ұрыспас па?
Dialogue: 0,0:45:39.63,0:45:42.22,,,0,0,0,,Бәріміз бір-бірімізге көмектесіп,бар күшімізді салайық
Dialogue: 0,0:45:46.06,0:45:49.14,,,0,0,0,,Бұл нағыз отбасы емес,сондықтан жақсы емес.
Dialogue: 0,0:45:49.31,0:45:50.48,,,0,0,0,,Маған
Dialogue: 0,0:45:52.19,0:45:54.48,,,0,0,0,,Маған ешкім көмектесе алмайды деп ойлаймын.
Dialogue: 0,0:45:55.61,0:45:58.82,,,0,0,0,,Отбасы болсын,достары болсын...
Dialogue: 0,0:45:59.49,0:46:00.66,,,0,0,0,,Ешкім
Dialogue: 0,0:46:03.83,0:46:05.62,,,0,0,0,,Шламды суспензия
Dialogue: 0,0:46:10.71,0:46:12.83,,,0,0,0,,Біле-шала,жалт-жұлт!
Dialogue: 0,0:46:13.67,0:46:16.34,,,0,0,0,,Сіз оны қанша уақытқа сүйреп жатырсыз?
Dialogue: 0,0:46:16.84,0:46:18.01,,,0,0,0,,Оны таба алмайсыз ба?
Dialogue: 0,0:46:18.76,0:46:23.76,,,0,0,0,,Оны алып кеткендерін айтқан куәгер болды.
Dialogue: 0,0:46:24.01,0:46:25.18,,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:46:25.26,0:46:26.97,,,0,0,0,,Ұмытшақ қала
Dialogue: 0,0:46:28.35,0:46:29.18,,,0,0,0,,Аджи Боку
Dialogue: 0,0:46:43.07,0:46:47.70,,,0,0,0,,Мен анамнан ерекше қуат алдым.
Dialogue: 0,0:46:48.20,0:46:50.21,,,0,0,0,,Адамдарды азаптау
Dialogue: 0,0:46:51.50,0:46:53.54,,,0,0,0,,Бұл планетамен күресетін күш.
Dialogue: 0,0:46:57.00,0:47:00.72,,,0,0,0,,Негізінде бұл құдірет әркімде де бар.
Dialogue: 0,0:47:01.72,0:47:02.80,,,0,0,0,,Иә
Dialogue: 0,0:47:04.22,0:47:06.55,,,0,0,0,,Біз ағайындымыз
Dialogue: 0,0:47:07.60,0:47:09.18,,,0,0,0,,Өмір ағымына сіңген
Dialogue: 0,0:47:09.27,0:47:13.02,,,0,0,0,,Анасының генетикалық ой-пікірін мұра еткен таңдаулы ағалар
Dialogue: 0,0:47:15.15,0:47:15.86,,,0,0,0,,Бірақ
Dialogue: 0,0:47:18.02,0:47:20.57,,,0,0,0,,Жұлдыздар барлығын мазалайды.
Dialogue: 0,0:47:21.82,0:47:24.86,,,0,0,0,,Біздің өсуді тоқтатуға тырысу
Dialogue: 0,0:47:26.07,0:47:31.08,,,0,0,0,,Сол себепті денең ауырып,жүрегің бас тартқалы тұрғандай болады.
Dialogue: 0,0:47:33.92,0:47:35.75,,,0,0,0,,Мен сені емдеймін.
Dialogue: 0,0:47:36.75,0:47:39.25,,,0,0,0,,Ал анама барайық.
Dialogue: 0,0:47:39.63,0:47:44.05,,,0,0,0,,Жұлдыздардан кек алу үшін отбасы болып бірге жұмыс жасайық!
Dialogue: 0,0:47:48.97,0:47:50.60,,,0,0,0,,Менің артымнан жүр
Dialogue: 0,0:48:37.81,0:48:39.06,,,0,0,0,,Дензел!
Dialogue: 0,0:48:43.40,0:48:44.49,,,0,0,0,,Дензел!
Dialogue: 0,0:48:56.71,0:48:58.00,,,0,0,0,,Анашым,қарашы.
Dialogue: 0,0:48:59.13,0:49:01.84,,,0,0,0,,Менің тағы қаншама бауырларым бар.
Dialogue: 0,0:49:03.46,0:49:05.84,,,0,0,0,,Енді мен анаммен кездескенше
Dialogue: 0,0:49:05.97,0:49:08.01,,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,0:49:47.30,0:49:48.51,,,0,0,0,,Бұл осында.
Dialogue: 0,0:49:51.09,0:49:54.14,,,0,0,0,,Өзімді бұзып кететін сияқты болсам да
Dialogue: 0,0:49:55.52,0:49:57.06,,,0,0,0,,Мен бұл жақсы нәрсе екеніне сенімдімін.
Dialogue: 0,0:49:59.06,0:50:00.31,,,0,0,0,,Question
Dialogue: 0,0:50:01.31,0:50:03.23,,,0,0,0,,Неге келдің?
Dialogue: 0,0:50:05.48,0:50:09.07,,,0,0,0,,Менің ойымша...Мені кешіргім келеді.
Dialogue: 0,0:50:10.41,0:50:13.37,,,0,0,0,,Иә,мені кешіргім келеді.
Dialogue: 0,0:50:14.83,0:50:16.08,,,0,0,0,,Кімге?
Dialogue: 0,0:51:06.09,0:51:07.30,,,0,0,0,,Сіз бәрібір келдіңіз.
Dialogue: 0,0:51:07.67,0:51:09.05,,,0,0,0,,Мен балаларды алуға келдім.
Dialogue: 0,0:51:09.26,0:51:12.63,,,0,0,0,,Бұл кісі біздің ағамыз.
Dialogue: 0,0:51:12.97,0:51:17.22,,,0,0,0,,Бірақ,өкінішке орай.
Dialogue: 0,0:51:19.47,0:51:21.56,,,0,0,0,,Сен сатқынсың.
Dialogue: 0,0:51:24.81,0:51:26.11,,,0,0,0,,Бұлт!
Dialogue: 0,0:53:45.70,0:53:48.29,,,0,0,0,,Шынымен... Мен ешкімге көмектесе алмаймын.
Dialogue: 0,0:53:49.58,0:53:52.21,,,0,0,0,,Винченцо... не болып жатыр?
Dialogue: 0,0:53:54.50,0:53:56.09,,,0,0,0,,Мен мұнда жиі келемін
Dialogue: 0,0:53:58.80,0:54:01.26,,,0,0,0,,Сондықтан мен Кадайчию мен басқаларды бақылап отырдым.
Dialogue: 0,0:54:03.10,0:54:04.47,,,0,0,0,,Жұлдыздың тыртықтары
Dialogue: 0,0:54:05.06,0:54:10.39,,,0,0,0,,Ағзада ұялаған бөгде заттарды кетіретін жүйенің шамадан тыс жұмыс істеуінен туындаған сияқты.
Dialogue: 0,0:54:12.86,0:54:16.15,,,0,0,0,,Дененің ішінде тіршілік ағымына ұқсас ағын бар.
Dialogue: 0,0:54:16.94,0:54:20.66,,,0,0,0,,Міне,біз ең жақын досымызға айналған зұлым заттармен күресеміз.
Dialogue: 0,0:54:22.53,0:54:24.49,,,0,0,0,,Зиянды заттар
Dialogue: 0,0:54:24.91,0:54:28.50,,,0,0,0,,Цефия факторы Дженованың генетикалық ойы
Dialogue: 0,0:54:29.25,0:54:30.33,,,0,0,0,,Қалағаныңызша атаңыз
Dialogue: 0,0:54:32.79,0:54:33.84,,,0,0,0,,Бұл егжей-тегжейлі.
Dialogue: 0,0:54:34.75,0:54:36.17,,,0,0,0,,Цен және Ирина
Dialogue: 0,0:54:36.88,0:54:39.84,,,0,0,0,,Оны мұнда өлуге жақын күйде әкелді.
Dialogue: 0,0:54:40.34,0:54:42.64,,,0,0,0,,Ол өте ұсқынсыз азаптауға ұшыраған сияқты.
Dialogue: 0,0:54:43.76,0:54:45.51,,,0,0,0,,Мен саған көмектестім,бірақ
Dialogue: 0,0:54:46.97,0:54:49.18,,,0,0,0,,Хмм,мен білмеймін.
Dialogue: 0,0:54:49.64,0:54:50.85,,,0,0,0,,Азаптау?
Dialogue: 0,0:54:51.39,0:54:52.81,,,0,0,0,,Өзін-өзі өлтіру
Dialogue: 0,0:54:53.02,0:54:55.19,,,0,0,0,,Ол Дженованың басын алған сияқты.
Dialogue: 0,0:54:56.11,0:54:59.03,,,0,0,0,,Рикида Ичиджу іздеп жүрген ана
Dialogue: 0,0:54:59.19,0:55:02.32,,,0,0,0,,Аспан жіберген жиіркенішті істер
Dialogue: 0,0:55:02.53,0:55:03.61,,,0,0,0,,Генуя
Dialogue: 0,0:55:03.91,0:55:07.29,,,0,0,0,,Егер сізге ұнаса,қайтадан Sefimansu жасауға болады.
Dialogue: 0,0:55:08.83,0:55:09.87,,,0,0,0,,Кадайчижу
Dialogue: 0,0:55:10.87,0:55:12.21,,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:55:12.79,0:55:15.04,,,0,0,0,,Хмм,бұл туралы ойлағым да келмейді.
Dialogue: 0,0:55:26.97,0:55:27.72,,,0,0,0,,Теңіз!
Dialogue: 0,0:55:27.93,0:55:30.39,,,0,0,0,,Бұлт! Дензел! Дензел!
Dialogue: 0,0:55:30.52,0:55:31.73,,,0,0,0,,Тифа жақсы.
Dialogue: 0,0:55:32.02,0:55:33.56,,,0,0,0,,Мен Тифамен сөйлескім келеді!
Dialogue: 0,0:55:39.23,0:55:40.32,,,0,0,0,,Сізде бар ма?
Dialogue: 0,0:55:42.36,0:55:43.74,,,0,0,0,,Сенгісіз!
Dialogue: 0,0:55:46.12,0:55:49.04,,,0,0,0,,Винченцо Маринді дүкенге жібере аласыз ба?
Dialogue: 0,0:55:49.74,0:55:51.83,,,0,0,0,,Мен Шинра жігіттерін тыңдаймын.
Dialogue: 0,0:55:51.91,0:55:52.75,,,0,0,0,,Келіспеймін
Dialogue: 0,0:55:52.91,0:55:53.92,,,0,0,0,,Бірақ
Dialogue: 0,0:55:54.67,0:55:56.00,,,0,0,0,,Бұлт жеткілікті!
Dialogue: 0,0:55:56.13,0:55:59.25,,,0,0,0,,Неге бізді тыңдамайсың?
Dialogue: 0,0:56:03.05,0:56:04.05,,,0,0,0,,Теңіз
Dialogue: 0,0:56:04.76,0:56:06.43,,,0,0,0,,Тағы біраз күтіңіз.
Dialogue: 0,0:56:06.55,0:56:08.60,,,0,0,0,,Ұрыс қазір басталуы керек.
Dialogue: 0,0:56:08.76,0:56:10.93,,,0,0,0,,Бірақ тек күресу жеткіліксіз.
Dialogue: 0,0:56:11.06,0:56:11.77,,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:56:11.89,0:56:13.27,,,0,0,0,,Мен түсінбеймін!
Dialogue: 0,0:56:13.43,0:56:16.94,,,0,0,0,,Бұлт... Бұл шайқас туралы ма?
Dialogue: 0,0:56:18.77,0:56:19.77,,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:56:19.94,0:56:21.90,,,0,0,0,,Ұмытшақ қала
Dialogue: 0,0:56:22.99,0:56:24.11,,,0,0,0,,Аджи Боку
Dialogue: 0,0:56:27.82,0:56:28.91,,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:56:35.79,0:56:37.29,,,0,0,0,,Мен Руфуспен сөйлесемін.
Dialogue: 0,0:56:37.38,0:56:38.46,,,0,0,0,,Қашпа!
Dialogue: 0,0:56:39.67,0:56:40.63,,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:56:40.80,0:56:43.30,,,0,0,0,,Балаларды тапсақ та,қолымыздан ештеңе келмеуі мүмкін.
Dialogue: 0,0:56:43.55,0:56:46.05,,,0,0,0,,Мүмкін заттар қайтадан қайтымсыз болып қалатын шығар.
Dialogue: 0,0:56:46.13,0:56:47.39,,,0,0,0,,Бұл қорқынышты емес пе?
Dialogue: 0,0:56:47.47,0:56:50.26,,,0,0,0,,Бірақ қазіргі сәтті және әртүрлі нәрселерді қабылдаңыз.
Dialogue: 0,0:56:50.35,0:56:52.97,,,0,0,0,,Ауыр ма? Өйткені оған көмектесу мүмкін емес,ол ауыр.
Dialogue: 0,0:56:53.39,0:56:55.64,,,0,0,0,,Өз бетіңізше өмір сүре алмасаңыз,оған шыдау керек.
Dialogue: 0,0:56:56.06,0:56:57.44,,,0,0,0,,Жалғыз қалғым келмейді,солай ма?
Dialogue: 0,0:56:57.52,0:57:00.15,,,0,0,0,,Жауап бермесем де,телефонымды жібермеймін.
Dialogue: 0,0:57:03.99,0:57:06.99,,,0,0,0,,Бару керек.
Dialogue: 0,0:57:15.04,0:57:19.67,,,0,0,0,,Біз естеліктерімізді жоғалттық па?
Dialogue: 0,0:57:25.51,0:57:29.09,,,0,0,0,,Мен оны өлімге қалдырғаным үшін бе?
Dialogue: 0,0:57:30.18,0:57:32.26,,,0,0,0,,Шынында да діріл!
Dialogue: 0,0:57:33.01,0:57:33.81,,,0,0,0,,Эй
Dialogue: 0,0:57:34.22,0:57:36.18,,,0,0,0,,Мен сені кешірсем ше?
Dialogue: 0,0:57:39.52,0:57:42.02,,,0,0,0,,Күнәні кешіруге бола ма?
Dialogue: 0,0:57:43.07,0:57:44.36,,,0,0,0,,...Мен оны ешқашан сынап көрген емеспін.
Dialogue: 0,0:57:44.86,0:57:45.94,,,0,0,0,,Көріңіз бе?
Dialogue: 0,0:57:46.86,0:57:47.95,,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:57:53.08,0:57:54.37,,,0,0,0,,Теңіз Мен үйге бара жатырмын
Dialogue: 0,0:57:58.96,0:58:00.37,,,0,0,0,,Мен жасап көремін
Dialogue: 0,0:58:01.04,0:58:02.71,,,0,0,0,,Нәтижелер туралы сізге хабарласамыз.
Dialogue: 0,0:58:22.65,0:58:26.98,,,0,0,0,,Мен Ривпін.» Сіздің жұмысыңыз қалай?
Dialogue: 0,0:58:27.61,0:58:31.07,,,0,0,0,,Мен флайерді көрдім,бірақ онымен бизнес жасауға бола ма?
Dialogue: 0,0:58:31.16,0:58:33.24,,,0,0,0,,Бұлт-сан сияқты.
Dialogue: 0,0:58:33.78,0:58:35.08,,,0,0,0,,Қаласаңыз,мен сізге көмектескім келеді.
Dialogue: 0,0:58:35.20,0:58:37.41,,,0,0,0,,Маған Хилиндегі Рено телефон соғып,жұмыс сұрады.
Dialogue: 0,0:58:37.50,0:58:39.08,,,0,0,0,,Көптен бері көрмегелі,бұл Юффи.
Dialogue: 0,0:58:39.25,0:58:41.75,,,0,0,0,,Білесің бе,балалар Учадайдан жоғалып кетті.
Dialogue: 0,0:58:41.92,0:58:43.21,,,0,0,0,,Сіз бірдеңе білесіз бе? Ақпарат,өтінемін!
Dialogue: 0,0:58:43.29,0:58:46.59,,,0,0,0,,Оның бойында біртүрлі нәрсе болды... Сақ болыңыз.
Dialogue: 0,0:58:51.93,0:58:55.85,,,0,0,0,,Мен бұған ешқашан ренжіген емеспін.
Dialogue: 0,0:58:56.56,0:59:00.35,,,0,0,0,,Сіз келдіңіз,солай ма? Бұл жеткілікті.
Dialogue: 0,0:59:40.10,0:59:41.48,,,0,0,0,,Сәлем! Сіз тыңдайсыз ба?
Dialogue: 0,0:59:41.60,0:59:42.98,,,0,0,0,,Неліктен бұған еліктейсің?
Dialogue: 0,1:00:32.40,1:00:33.44,,,0,0,0,,Дензел!
Dialogue: 0,1:00:38.87,1:00:39.70,,,0,0,0,,Дензел!
Dialogue: 0,1:00:40.24,1:00:41.33,,,0,0,0,,Дензел!
Dialogue: 0,1:01:02.35,1:01:03.68,,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:01:12.48,1:01:15.49,,,0,0,0,,Сенің анаң осында емес пе?
Dialogue: 0,1:01:15.90,1:01:16.99,,,0,0,0,,Неліктен?
Dialogue: 0,1:01:17.28,1:01:23.41,,,0,0,0,,Бұл не...? Ескерткіш? Шинра жасады.
Dialogue: 0,1:01:23.74,1:01:26.00,,,0,0,0,,Сондықтан да осында жасырдың ба?
Dialogue: 0,1:01:26.91,1:01:28.08,,,0,0,0,,Жоқ?
Dialogue: 0,1:01:28.42,1:01:29.50,,,0,0,0,,Саана
Dialogue: 0,1:01:29.58,1:01:32.09,,,0,0,0,,Біз де тыңдамадық.
Dialogue: 0,1:01:35.09,1:01:38.55,,,0,0,0,,Қараңызшы,ол бір жерде жасырылған.
Dialogue: 0,1:01:42.85,1:01:45.85,,,0,0,0,,Людо,бірдеңе айт!
Dialogue: 0,1:01:48.77,1:01:50.06,,,0,0,0,,Уау!
Dialogue: 0,1:02:04.91,1:02:05.95,,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,1:02:08.96,1:02:09.79,,,0,0,0,,Иә
Dialogue: 0,1:02:10.37,1:02:13.21,,,0,0,0,,Бірақ Дензел сияқты жақсы емес.
Dialogue: 0,1:02:14.46,1:02:15.63,,,0,0,0,,Оны емдеуге бола ма?
Dialogue: 0,1:02:17.42,1:02:18.76,,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,1:02:20.30,1:02:25.14,,,0,0,0,,Мен Дензелге ем іздедім.
Dialogue: 0,1:02:26.56,1:02:27.89,,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,1:02:28.35,1:02:32.10,,,0,0,0,,Бұлт Мен партаны тазаламаймын.
Dialogue: 0,1:02:33.36,1:02:34.65,,,0,0,0,,That's right.
Dialogue: 0,1:02:36.86,1:02:39.45,,,0,0,0,,Әй,бұлт!
Dialogue: 0,1:02:39.53,1:02:43.82,,,0,0,0,,Дензелдің жұлдызша белгілерін өшіре алмағандықтан үйден шықтыңыз ба?
Dialogue: 0,1:02:45.16,1:02:47.49,,,0,0,0,,Менде де жұлдыз тыртықтары бар болғандықтан ба?
Dialogue: 0,1:02:49.25,1:02:50.29,,,0,0,0,,Мен
Dialogue: 0,1:02:51.58,1:02:53.63,,,0,0,0,,Мен өзімді қорғай алмаймын
Dialogue: 0,1:02:54.50,1:02:56.50,,,0,0,0,,Мүмкін мен солай ойлағандықтан болар.
Dialogue: 0,1:02:57.88,1:03:01.93,,,0,0,0,,Өзін қорғай алмағандар отбасын қорғай алады!
Dialogue: 0,1:03:03.64,1:03:06.43,,,0,0,0,,Әкем осылай деді.
Dialogue: 0,1:03:07.51,1:03:10.14,,,0,0,0,,Бұлт Берілме
Dialogue: 0,1:03:14.02,1:03:16.02,,,0,0,0,,Марин,Дензел және Тифа
Dialogue: 0,1:03:16.52,1:03:18.78,,,0,0,0,,Сіз маған әрқашан көмектестіңіз
Dialogue: 0,1:03:19.90,1:03:22.20,,,0,0,0,,Мені әрқашан біреу қорғады.
Dialogue: 0,1:03:24.24,1:03:27.70,,,0,0,0,,Енді менің кезегім
Dialogue: 0,1:03:28.54,1:03:29.50,,,0,0,0,,Иә
Dialogue: 0,1:03:38.80,1:03:40.21,,,0,0,0,,Әй,қуат.
Dialogue: 0,1:03:40.88,1:03:42.63,,,0,0,0,,Маған бір нәрсе айтыңыз.
Dialogue: 0,1:03:43.26,1:03:45.64,,,0,0,0,,Бір ғана
Dialogue: 0,1:03:46.55,1:03:52.06,,,0,0,0,,Сіз Jenova жасушаларын алатыныңызды айттыңыз және бәрі қалыпты жағдайға оралады.
Dialogue: 0,1:03:52.23,1:03:54.23,,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:03:55.40,1:03:59.82,,,0,0,0,,Ол... қайтып келеді.
Dialogue: 0,1:04:02.07,1:04:03.74,,,0,0,0,,...
Dialogue: 0,1:04:04.24,1:04:05.57,,,0,0,0,,Бұл қорқынышты түс
Dialogue: 0,1:04:05.66,1:04:06.91,,,0,0,0,,Шамасы
Dialogue: 0,1:04:07.16,1:04:08.20,,,0,0,0,,Шамасы?
Dialogue: 0,1:04:08.45,1:04:10.58,,,0,0,0,,Мен Сефиенсуды білмеймін
Dialogue: 0,1:04:11.16,1:04:14.75,,,0,0,0,,А,мен оны сезіп тұрмын.
Dialogue: 0,1:04:16.33,1:04:17.84,,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,1:04:18.04,1:04:21.38,,,0,0,0,,Сіз қайсысын таңдайсыз,анам ба әлде Сефи ме?
Dialogue: 0,1:04:21.96,1:04:23.76,,,0,0,0,,Патетикалық ой денесі
Dialogue: 0,1:04:24.43,1:04:28.26,,,0,0,0,,Қай жолмен жүрсең де,ақыры бір болмақ!
Dialogue: 0,1:04:28.64,1:04:32.43,,,0,0,0,,Л ана ұзақ жол жүріп,осы планетаға келді.
Dialogue: 0,1:04:32.77,1:04:36.44,,,0,0,0,,Ғаламды ақымақ адамдардан тазарту.
Dialogue: 0,1:04:37.02,1:04:40.27,,,0,0,0,,Бірақ сіз не білесіз?
Dialogue: 0,1:04:42.99,1:04:46.41,,,0,0,0,,Анам келгеннен бері мұнда ештеңе өзгерген жоқ.
Dialogue: 0,1:04:46.49,1:04:49.41,,,0,0,0,,Сондықтан мен анамды қуантамын
Dialogue: 0,1:04:49.49,1:04:54.91,,,0,0,0,,Анам не бұйырса,соны орындаймын.
Dialogue: 0,1:04:55.00,1:04:58.13,,,0,0,0,,Хмм,тағы да қорқынышты түс пе?
Dialogue: 0,1:04:59.13,1:05:04.63,,,0,0,0,,Балалар, сендер осында болғанша,сол жағдай қайталана береді.
Dialogue: 0,1:05:06.72,1:05:09.30,,,0,0,0,,...жұлдыздарды айналып өтетін өмір ағымына
Dialogue: 0,1:05:09.97,1:05:13.43,,,0,0,0,,Өмір мен өлім арасында алға-артқа жүру
Dialogue: 0,1:05:13.81,1:05:16.98,,,0,0,0,,Сол кері шегіну өмірдің шын мәні болса
Dialogue: 0,1:05:17.10,1:05:19.94,,,0,0,0,,Тарихтың қайта жазылуы сөзсіз
Dialogue: 0,1:05:20.77,1:05:23.73,,,0,0,0,,Дженова немесе Сефирот,мен білмеймін.
Dialogue: 0,1:05:23.82,1:05:26.45,,,0,0,0,,Істі өзіңіз қалағаныңызша қайталаңыз.
Dialogue: 0,1:05:27.15,1:05:30.07,,,0,0,0,,Біз өмір ережелерін сақтаймыз
Dialogue: 0,1:05:30.41,1:05:34.95,,,0,0,0,,Мен сені әр жолы тоқтатамын.
Dialogue: 0,1:05:36.33,1:05:41.67,,,0,0,0,,Президент... Анамды ұрлағаны үшін сылтау ма?
Dialogue: 0,1:05:42.17,1:05:44.51,,,0,0,0,,Сіз шынымен өкінбейсіз бе?
Dialogue: 0,1:05:44.67,1:05:50.14,,,0,0,0,,Өкінішті? Мен... Көңіл көтермей тұра алмаймын.
Dialogue: 0,1:05:56.52,1:06:01.86,,,0,0,0,,Тамаша,онда қазір аяқтаймыз.
Dialogue: 0,1:07:07.50,1:07:09.59,,,0,0,0,,Дензел,қаш!
Dialogue: 0,1:07:44.46,1:07:46.13,,,0,0,0,,Арх!
Dialogue: 0,1:07:56.93,1:07:58.06,,,0,0,0,,Коря
Dialogue: 0,1:07:58.14,1:07:59.14,,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,1:08:31.84,1:08:32.59,,,0,0,0,,Келесің бе!?
Dialogue: 0,1:08:33.42,1:08:34.34,,,0,0,0,,Мен оны көргім келмейді
Dialogue: 0,1:09:12.34,1:09:14.97,,,0,0,0,,Бұл қызық,досым
Dialogue: 0,1:09:15.09,1:09:16.88,,,0,0,0,,Мүлде жоқ.
Dialogue: 0,1:09:22.97,1:09:25.14,,,0,0,0,,Балалар сендер табандысыңдар.
Dialogue: 0,1:09:27.56,1:09:32.69,,,0,0,0,,Сонымен...егер анамды қайтарып берсең,іс бітеді.
Dialogue: 0,1:09:39.41,1:09:40.41,,,0,0,0,,Балалар
Dialogue: 0,1:09:40.82,1:09:43.99,,,0,0,0,,Дженованың басы Не істейсің?
Dialogue: 0,1:09:55.42,1:09:58.38,,,0,0,0,,Ли Юнион,сен жындысың ба?
Dialogue: 0,1:09:59.43,1:10:02.10,,,0,0,0,,Біз анамды жаңа ғана кездестірдік.
Dialogue: 0,1:10:06.60,1:10:11.44,,,0,0,0,,Менің болашағым туралы бәрін шешем шешеді.
Dialogue: 0,1:10:12.19,1:10:14.11,,,0,0,0,,Ал анаң ше?
Dialogue: 0,1:10:29.21,1:10:32.79,,,0,0,0,,Ана,ана... Женованың басы емес пе?
Dialogue: 0,1:10:32.96,1:10:33.63,,,0,0,0,,Эй!
Dialogue: 0,1:10:34.04,1:10:35.96,,,0,0,0,,Анаңды олай атама.
Dialogue: 0,1:10:36.09,1:10:37.46,,,0,0,0,,Сенің әкең Эден мектебінің түлегі ғой,иә?
Dialogue: 0,1:10:40.47,1:10:41.80,,,0,0,0,,...Жаман болды.
Dialogue: 0,1:10:42.89,1:10:46.14,,,0,0,0,,Дұрыс... неге кешірім сұрайсың!
Dialogue: 0,1:11:36.11,1:11:36.98,,,0,0,0,,Тифа?
Dialogue: 0,1:11:42.40,1:11:43.32,,,0,0,0,,Мұны істейік!
Dialogue: 0,1:11:57.25,1:11:58.80,,,0,0,0,,Анаңызды осында қорғаңыз.
Dialogue: 0,1:11:59.17,1:12:00.13,,,0,0,0,,Оқ!
Dialogue: 0,1:12:01.55,1:12:03.38,,,0,0,0,,Менің ойымша,Марин қауіпсіз!? иә?
Dialogue: 0,1:12:18.02,1:12:19.90,,,0,0,0,,Мен білмеймін.
Dialogue: 0,1:12:50.22,1:12:51.10,,,0,0,0,,Уцупу
Dialogue: 0,1:12:52.77,1:12:54.77,,,0,0,0,,Аташи материасын кім пайдаланады?
Dialogue: 0,1:12:54.94,1:12:56.27,,,0,0,0,,Әрине,жаман адам
Dialogue: 0,1:12:56.65,1:12:57.94,,,0,0,0,,Қарғыс атсын
Dialogue: 0,1:12:59.11,1:12:59.94,,,0,0,0,,Who?
Dialogue: 0,1:13:04.95,1:13:07.78,,,0,0,0,,Жаңа үлгі! Шикура-ғо
Dialogue: 0,1:13:08.70,1:13:11.03,,,0,0,0,,Мен сені кейін апарамын!
Dialogue: 0,1:13:12.12,1:13:13.12,,,0,0,0,,Телефон дүкені қай жерде?
Dialogue: 0,1:13:16.67,1:13:17.37,,,0,0,0,,Бұл адам кім?
Dialogue: 0,1:13:17.92,1:13:19.29,,,0,0,0,,Біз бәріміз доспыз
Dialogue: 0,1:13:22.30,1:13:24.30,,,0,0,0,,Дензел Дүкенге жүгіре аласыз ба?
Dialogue: 0,1:13:25.01,1:13:25.88,,,0,0,0,,Иә
Dialogue: 0,1:13:52.49,1:13:53.33,,,0,0,0,,Бағдарлама коды…
Dialogue: 0,1:13:57.00,1:13:58.00,,,0,0,0,,Тифа! !
Dialogue: 0,1:14:03.34,1:14:04.30,,,0,0,0,,Дензел!
Dialogue: 0,1:14:27.03,1:14:27.78,,,0,0,0,,Бұлт!
Dialogue: 0,1:14:38.66,1:14:40.54,,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,1:14:40.67,1:14:42.83,,,0,0,0,,Жоқ,бәрі жақсы.
Dialogue: 0,1:14:49.88,1:14:50.55,,,0,0,0,,Амансың ба?
Dialogue: 0,1:14:50.63,1:14:51.47,,,0,0,0,,Иә
Dialogue: 0,1:14:54.18,1:14:56.97,,,0,0,0,,Теңізшілер қауіпсіз. Мен оны дүкенге қалдырдым.
Dialogue: 0,1:14:57.43,1:14:58.22,,,0,0,0,,Иә
Dialogue: 0,1:14:59.18,1:15:00.64,,,0,0,0,,Мен өзімді жеңіл сезінемін
Dialogue: 0,1:15:01.39,1:15:02.40,,,0,0,0,,Иә?
Dialogue: 0,1:15:04.86,1:15:08.15,,,0,0,0,,Мен оны сүйреткенді ұнатқандықтан тоздырдым ба деп ойлаймын.
Dialogue: 0,1:15:13.24,1:15:15.58,,,0,0,0,,Мен өзім дүкенге қайтамын.
Dialogue: 0,1:15:16.12,1:15:17.33,,,0,0,0,,Маринмен бірге күту
Dialogue: 0,1:15:20.58,1:15:23.00,,,0,0,0,,Бұлт да қайтады,солай ма?
Dialogue: 0,1:15:25.00,1:15:25.88,,,0,0,0,,Иә
Dialogue: 0,1:16:04.83,1:16:06.04,,,0,0,0,,Мен жеңілуге ​​шыдай алмаймын!
Dialogue: 0,1:18:08.00,1:18:09.37,,,0,0,0,,Бұл Осеендо!
Dialogue: 0,1:19:14.61,1:19:18.61,,,0,0,0,,Қызық екен, президент мырза,ары қарай қалай атайсыз?
Dialogue: 0,1:19:28.08,1:19:29.08,,,0,0,0,,Ана?
Dialogue: 0,1:19:29.25,1:19:31.58,,,0,0,0,,Біліңіз,сіз бейтаныссыз.
Dialogue: 0,1:19:44.80,1:19:46.26,,,0,0,0,,Бұлтқа барыңыз!
Dialogue: 0,1:19:56.77,1:19:58.69,,,0,0,0,,Қараңдар!
Dialogue: 0,1:20:05.74,1:20:07.16,,,0,0,0,,Иә!
Dialogue: 0,1:20:08.91,1:20:10.04,,,0,0,0,,Nuo~
Dialogue: 0,1:20:22.01,1:20:23.05,,,0,0,0,,Тобибе!
Dialogue: 0,1:20:32.52,1:20:33.48,,,0,0,0,,Әлі жоқ!
Dialogue: 0,1:21:11.89,1:21:12.89,,,0,0,0,,Иә!
Dialogue: 0,1:22:04.73,1:22:05.61,,,0,0,0,,Анашым!
Dialogue: 0,1:22:13.33,1:22:14.33,,,0,0,0,,Президент!
Dialogue: 0,1:22:58.58,1:22:59.54,,,0,0,0,,Президент!
Dialogue: 0,1:24:38.51,1:24:40.47,,,0,0,0,,Басқа адам қателескен болуы керек.
Dialogue: 0,1:24:49.98,1:24:52.15,,,0,0,0,,Папин! Папапапан!
Dialogue: 0,1:25:33.36,1:25:34.19,,,0,0,0,,Людо!
Dialogue: 0,1:25:39.28,1:25:42.33,,,0,0,0,,A"~!?
Dialogue: 0,1:25:47.08,1:25:49.33,,,0,0,0,,Бұл қауіпті, бұл қауіпті,бұл қауіпті.
Dialogue: 0,1:25:50.71,1:25:54.05,,,0,0,0,,Ойчи Руидо,жақсы болдыңыз ба?
Dialogue: 0,1:25:54.46,1:25:57.05,,,0,0,0,,Жоқ... шынымен емес.
Dialogue: 0,1:26:27.66,1:26:29.33,,,0,0,0,,Сота: Мен сағындым…
Dialogue: 0,1:28:23.03,1:28:24.95,,,0,0,0,,Досым
Dialogue: 0,1:28:26.03,1:28:29.87,,,0,0,0,,Бұл күшті ме?
Dialogue: 0,1:28:31.04,1:28:33.46,,,0,0,0,,Шинраның технологиясын біріктіру
Dialogue: 0,1:28:33.54,1:28:35.37,,,0,0,0,,Сіз орындадыңыз ба?
Dialogue: 0,1:28:36.25,1:28:38.79,,,0,0,0,,Оның қуатына қарамастан,ол жарқыраған.
Dialogue: 0,1:28:38.92,1:28:40.38,,,0,0,0,,Ой
Dialogue: 0,1:28:41.34,1:28:43.34,,,0,0,0,,Мен саған ұнайсың ба,досым?
Dialogue: 0,1:28:44.43,1:28:46.80,,,0,0,0,,Бүгін артық жұмыс уақыты жоқ.
Dialogue: 0,1:30:01.00,1:30:01.71,,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,1:30:15.77,1:30:16.81,,,0,0,0,,Ә? (Кения) Сен➡
Dialogue: 0,1:30:18.60,1:30:20.31,,,0,0,0,,Анашым!
Dialogue: 0,1:32:04.38,1:32:06.54,,,0,0,0,,Бұлтқа барайық
Dialogue: 0,1:32:36.16,1:32:39.12,,,0,0,0,,Ақыры анамды кездестірдім
Dialogue: 0,1:32:40.29,1:32:41.79,,,0,0,0,,Неден басталады?
Dialogue: 0,1:32:44.75,1:32:46.96,,,0,0,0,,Маған анам айтып береді.
Dialogue: 0,1:32:48.63,1:32:51.46,,,0,0,0,,...Ойланған денелер ештеңе білмейді ме?
Dialogue: 0,1:32:54.47,1:32:57.64,,,0,0,0,,Мен бәрібір қуыршақпын
Dialogue: 0,1:33:02.81,1:33:04.48,,,0,0,0,,Өткенде сіздермен бірге
Dialogue: 0,1:33:06.56,1:33:07.27,,,0,0,0,,Дәл солай!
Dialogue: 0,1:33:33.59,1:33:36.30,,,0,0,0,,Мен Cloud Materia әкелдім!
Dialogue: 0,1:33:37.43,1:33:38.47,,,0,0,0,,Оны шайқамаңыз!
Dialogue: 0,1:33:38.59,1:33:40.35,,,0,0,0,,Сәлем,Сид! Менен тез кет!
Dialogue: 0,1:33:40.43,1:33:42.68,,,0,0,0,,Шулы! Секір! Секір!
Dialogue: 0,1:33:43.52,1:33:44.93,,,0,0,0,,Маған жалғыз күресуге рұқсат етіңіз
Dialogue: 0,1:33:46.14,1:33:47.19,,,0,0,0,,Иә!?
Dialogue: 0,1:33:47.56,1:33:49.69,,,0,0,0,,Ол кісі Сефиенсудың ойлау формасы.
Dialogue: 0,1:33:50.77,1:33:52.77,,,0,0,0,,Бұл дернәсіл сияқты,былайша айтқанда.
Dialogue: 0,1:33:52.86,1:33:55.28,,,0,0,0,,Дернәсіл? Қате? Бұл қате ме?
Dialogue: 0,1:33:55.36,1:33:56.86,,,0,0,0,,Жас келіншек аузын жапқанда
Dialogue: 0,1:33:56.95,1:33:59.36,,,0,0,0,,Сіз бір күні Сефиман боласыз ба?
Dialogue: 0,1:33:59.57,1:34:03.37,,,0,0,0,,Әй,бұлт мұны біледі ме?
Dialogue: 0,1:34:04.83,1:34:05.70,,,0,0,0,,Мүмкін
Dialogue: 0,1:34:06.58,1:34:07.54,,,0,0,0,,Мен көрдім.
Dialogue: 0,1:34:09.25,1:34:10.63,,,0,0,0,,Мені жалғыз қалдырыңыз
Dialogue: 0,1:34:10.75,1:34:13.50,,,0,0,0,,Түсінбедім,түсіндіріңізші!
Dialogue: 0,1:34:13.63,1:34:14.96,,,0,0,0,,Бұл киска туралы.
Dialogue: 0,1:34:15.21,1:34:17.17,,,0,0,0,,Кемсітушілік! Сабетсу!
Dialogue: 0,1:34:17.26,1:34:19.18,,,0,0,0,,Кішкентай қыз,үндеме!
Dialogue: 0,1:34:19.26,1:34:21.30,,,0,0,0,,Ер адамдар да түсінбейді.
Dialogue: 0,1:34:21.39,1:34:22.47,,,0,0,0,,2 жыл бұрын
Dialogue: 0,1:34:24.18,1:34:27.89,,,0,0,0,,Соңғы шайқас кезінде болған күшті сезімдер.
Dialogue: 0,1:34:28.60,1:34:33.15,,,0,0,0,,Бар болғаны екі жыл болса да,сол сезімді білмей тұрып жоғалттым
Dialogue: 0,1:34:33.90,1:34:36.53,,,0,0,0,,Менің ойымша,бұлт оны қалпына келтірді.
Dialogue: 0,1:34:37.11,1:34:39.53,,,0,0,0,,Цк... 10 минут күтемін
Dialogue: 0,1:34:39.61,1:34:42.91,,,0,0,0,,Бұлт әлі секіреді.
Dialogue: 0,1:34:44.16,1:34:45.41,,,0,0,0,,Адал
Dialogue: 0,1:36:01.65,1:36:05.62,,,0,0,0,,Мен саған кәсіподағымды көрсетемін
Dialogue: 0,1:36:26.51,1:36:29.68,,,0,0,0,,Біраз болды,Бұлт.
Dialogue: 0,1:36:44.91,1:36:46.82,,,0,0,0,,Жұлдызды тыртықтарыңызды жоғалттыңыз ба?
Dialogue: 0,1:36:48.91,1:36:50.37,,,0,0,0,,Өкінішті
Dialogue: 0,1:36:50.49,1:36:53.37,,,0,0,0,,Сен нені қалайсың?
Dialogue: 0,1:36:53.79,1:36:56.67,,,0,0,0,,Жұлдызша таңбалы өлгендердің ойлары
Dialogue: 0,1:36:57.46,1:37:00.80,,,0,0,0,,Тіршілік циклімен жұлдыздарды айналып өтеді
Dialogue: 0,1:37:01.25,1:37:03.88,,,0,0,0,,Ол ақырында жұлдыздарды жояды.
Dialogue: 0,1:37:04.76,1:37:07.22,,,0,0,0,,Менің қалағаным,Бұлт
Dialogue: 0,1:37:08.30,1:37:12.22,,,0,0,0,,Бұл жұлдызды кеме ретінде пайдаланып,ғарыштың қараңғылығын аралау.
Dialogue: 0,1:37:13.73,1:37:16.73,,,0,0,0,,Бір кездегі анам сияқты.
Dialogue: 0,1:37:23.74,1:37:27.07,,,0,0,0,,Уақыт өте келе біз жаңа жұлдызды ашамыз
Dialogue: 0,1:37:27.24,1:37:30.08,,,0,0,0,,Ауданда жарқын болашақ құру
Dialogue: 0,1:37:30.58,1:37:32.16,,,0,0,0,,Бұл планетамен не болады?
Dialogue: 0,1:37:32.70,1:37:36.33,,,0,0,0,,Енді... бұл сізге байланысты.
Dialogue: 0,1:37:57.85,1:37:59.10,,,0,0,0,,Әпке?
Dialogue: 0,1:38:44.65,1:38:47.82,,,0,0,0,,Сізді не күшті етті?
Dialogue: 0,1:38:48.32,1:38:50.07,,,0,0,0,,Мен сізге айтқым келмейді
Dialogue: 0,1:39:25.48,1:39:28.36,,,0,0,0,,Мен саған сыйлық ойладым.
Dialogue: 0,1:39:35.03,1:39:36.87,,,0,0,0,,Үмітіңді түсірейін бе?
Dialogue: 0,1:39:47.30,1:39:51.01,,,0,0,0,,Маған қалай тізе бүгіп,кешірім сұрайтыныңды көрсет.
Dialogue: 0,1:41:42.58,1:41:46.33,,,0,0,0,,Сол кездегі ауыртпалық есіңізде ме? Бұлт
Dialogue: 0,1:41:47.83,1:41:52.30,,,0,0,0,,Енді ұмытылмас азапты тағы бір рет ойып алайық
Dialogue: 0,1:42:19.28,1:42:21.87,,,0,0,0,,Сіз үшін ең маңыздысы не?
Dialogue: 0,1:42:23.70,1:42:26.37,,,0,0,0,,Оны алып кетудің қуанышын маған сыйлайсың ба?
Dialogue: 0,1:42:33.21,1:42:35.55,,,0,0,0,,Мен болсам,мен әлі берілмес едім.
Dialogue: 0,1:42:35.88,1:42:38.34,,,0,0,0,,Тіпті үмітсіз жағдайда
Dialogue: 0,1:42:41.93,1:42:43.56,,,0,0,0,,Армандарыңызды қабылдаңыз
Dialogue: 0,1:42:43.93,1:42:47.98,,,0,0,0,,Солдаттың намысын ешқашан жіберме.
Dialogue: 0,1:42:48.69,1:42:53.57,,,0,0,0,,Жарайды,мен солдат болған жоқпын.
Dialogue: 0,1:42:54.77,1:42:56.15,,,0,0,0,,Za'x
Dialogue: 0,1:42:57.53,1:43:00.03,,,0,0,0,,Қолыңды созғанымды қалайсың ба?
Dialogue: 0,1:43:07.50,1:43:11.00,,,0,0,0,,Бұл мен бір рет жеңген қарсыласым. Бұл оңай жеңіс емес.
Dialogue: 0,1:43:12.08,1:43:13.00,,,0,0,0,,О
Dialogue: 0,1:43:15.80,1:43:18.92,,,0,0,0,,Ұмытпа...
Dialogue: 0,1:43:19.92,1:43:24.22,,,0,0,0,,Мен сенің тірі дәлеліңмін.
Dialogue: 0,1:43:32.27,1:43:35.77,,,0,0,0,,... Өкінішті,сен ештеңе түсінбейсің.
Dialogue: 0,1:43:37.44,1:43:39.57,,,0,0,0,,Маңызды емес ештеңе жоқ.
Dialogue: 0,1:44:16.23,1:44:20.07,,,0,0,0,,Менің естеліктерімде тыныш бол
Dialogue: 0,1:44:25.82,1:44:27.16,,,0,0,0,,Ол сондай адам.
Dialogue: 0,1:44:28.45,1:44:30.66,,,0,0,0,,Бұл естелік болмайды
Dialogue: 0,1:45:01.36,1:45:02.78,,,0,0,0,,Аға
Dialogue: 0,1:45:05.20,1:45:06.70,,,0,0,0,,Кадайчижу?
Dialogue: 0,1:45:08.74,1:45:09.70,,,0,0,0,,Иә?
Dialogue: 0,1:45:21.00,1:45:24.22,,,0,0,0,,Мен сонша тырысуды доғарайын ба?
Dialogue: 0,1:45:29.76,1:45:32.22,,,0,0,0,,Ана...?
Dialogue: 0,1:45:33.56,1:45:36.31,,,0,0,0,,Барлығына қайта ораламыз ба?
Dialogue: 0,1:45:38.73,1:45:39.73,,,0,0,0,,Иә
Dialogue: 0,1:47:01.56,1:47:02.81,,,0,0,0,,Иә! Ол қандай?
Dialogue: 0,1:47:02.90,1:47:04.40,,,0,0,0,,Мен айтқанымдай!
Dialogue: 0,1:47:04.48,1:47:06.57,,,0,0,0,,Әй,Бұлт-сан адам ғой!
Dialogue: 0,1:47:06.65,1:47:08.74,,,0,0,0,,Егер сіз тырыссаңыз,бұлт мұны істей алады.
Dialogue: 0,1:47:08.82,1:47:10.82,,,0,0,0,,Балалар сендер дұрыс ұстадыңдар.
Dialogue: 0,1:47:20.04,1:47:23.84,,,0,0,0,,Сіз осында болдыңыз,солай емес пе?
Dialogue: 0,1:47:25.09,1:47:26.59,,,0,0,0,,Рахмет
Dialogue: 0,1:48:07.80,1:48:11.01,,,0,0,0,,Үйге бірге барайық
Dialogue: 0,1:48:15.89,1:48:19.02,,,0,0,0,,Ендеше бірге ойнайық
Dialogue: 0,1:48:44.87,1:48:45.92,,,0,0,0,,Бұлт!
Dialogue: 0,1:48:52.38,1:48:55.09,,,0,0,0,,...Бұлт да қайтады.
Dialogue: 0,1:49:18.37,1:49:19.12,,,0,0,0,,Кеттік
Dialogue: 0,1:49:19.28,1:49:20.12,,,0,0,0,,Иә
Dialogue: 0,1:50:44.41,1:50:45.54,,,0,0,0,,Ана...?
Dialogue: 0,1:50:47.21,1:50:48.21,,,0,0,0,,Тағы да!
Dialogue: 0,1:50:48.66,1:50:52.13,,,0,0,0,,Сіз мені қанша рет ана деп атадыңыз?
Dialogue: 0,1:50:54.25,1:50:56.67,,,0,0,0,,Таңдану жақсы.
Dialogue: 0,1:50:57.88,1:51:00.89,,,0,0,0,,Маған мұндай үлкен бала керек емес.
Dialogue: 0,1:51:02.18,1:51:07.06,,,0,0,0,,Кешіріңіз,сіздің орныңыз бұл жерде емес.
Dialogue: 0,1:52:04.82,1:52:06.08,,,0,0,0,,Менің әпкем
Dialogue: 0,1:52:06.41,1:52:08.41,,,0,0,0,,Өйткені бұлт осында келе жатыр
Dialogue: 0,1:52:10.87,1:52:12.37,,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:52:23.01,1:52:24.14,,,0,0,0,,Мен үйдемін
Dialogue: 0,1:52:27.97,1:52:30.56,,,0,0,0,,Жұлдызының ізі әлі кетпеген балалар бар.
Dialogue: 0,1:52:31.81,1:52:32.64,,,0,0,0,,О
Dialogue: 0,1:52:39.48,1:52:42.49,,,0,0,0,,Енді сені сауықтырайық.
Dialogue: 0,1:52:45.66,1:52:47.49,,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,1:52:49.08,1:52:50.33,,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,1:53:43.30,1:53:45.22,,,0,0,0,,Енді секіріңіз!
Dialogue: 0,1:53:45.34,1:53:46.51,,,0,0,0,,емделген емделген
Dialogue: 0,1:54:34.60,1:54:38.27,,,0,0,0,,Қазір бәрі жақсы.
Dialogue: 0,1:54:59.29,1:55:00.42,,,0,0,0,,Иә
Dialogue: 0,1:55:02.79,1:55:03.75,,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,1:55:06.09,1:55:07.63,,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,1:55:09.13,1:55:15.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
