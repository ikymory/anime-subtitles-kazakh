Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:49.92,0:00:54.05,Default,,0,0,0,,(Алисаның толқыған дауысы)
Dialogue: 0,0:00:59.35,0:01:00.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:03.14,0:01:04.60,Default,,0,0,0,,Робби, ал!
Dialogue: 0,0:01:05.31,0:01:07.85,Default,,0,0,0,,Сәлем-хи-о-сама
Dialogue: 0,0:01:15.28,0:01:16.11,Default,,0,0,0,,N?
Dialogue: 0,0:01:16.57,0:01:17.41,Default,,0,0,0,,Не?
Dialogue: 0,0:01:21.45,0:01:22.33,Default,,0,0,0,,Лобби!
Dialogue: 0,0:01:22.70,0:01:23.54,Default,,0,0,0,,Мисс О!
Dialogue: 0,0:01:23.83,0:01:27.21,Default,,0,0,0,,Х-01 типті жұмыс роботы
Dialogue: 0,0:01:27.83,0:01:32.88,Default,,0,0,0,,Мәртебелі өмірі жөнделген зауытқа апарылды.
Dialogue: 0,0:01:33.00,0:01:34.38,Default,,0,0,0,,Лобби! (Робби) Мисс О!
Dialogue: 0,0:01:34.46,0:01:35.34,Default,,0,0,0,,Лобби!
Dialogue: 0,0:01:35.51,0:01:37.26,Default,,0,0,0,,Ханым О!
Dialogue: 0,0:01:40.43,0:01:41.81,Default,,0,0,0,,Лобби!
Dialogue: 0,0:01:48.98,0:01:51.77,Default,,0,0,0,,Поко! Жалғыз болсаңыз да қашыңыз!
Dialogue: 0,0:01:51.90,0:01:53.73,Default,,0,0,0,,Мен анаммен бірге болуым керек!
Dialogue: 0,0:02:02.24,0:02:03.58,Default,,0,0,0,,Иә, мен қазір сонда барамын.
Dialogue: 0,0:02:04.79,0:02:05.54,Default,,0,0,0,,Анашым!
Dialogue: 0,0:02:06.58,0:02:08.62,Default,,0,0,0,,Маған қарамай қаш!
Dialogue: 0,0:02:08.75,0:02:09.87,Default,,0,0,0,,Анашым! Ах
Dialogue: 0,0:02:12.04,0:02:17.26,Default,,0,0,0,,E-01 02 (Нөл екі) Өзгертілген зауытқа жіберілді
Dialogue: 0,0:02:17.59,0:02:19.13,Default,,0,0,0,,Уау! Поко!
Dialogue: 0,0:02:19.47,0:02:20.39,Default,,0,0,0,,Уау! Уф
Dialogue: 0,0:02:20.89,0:02:22.35,Default,,0,0,0,,Поко! Жүгіріп кету!
Dialogue: 0,0:02:28.52,0:02:29.73,Default,,0,0,0,,Анашым!
Dialogue: 0,0:02:33.52,0:02:35.53,Default,,0,0,0,,(ит роботтары үреді)
Dialogue: 0,0:02:41.78,0:02:45.24,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:02:52.58,0:02:54.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:54.71,0:02:55.71,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:02.64,0:03:03.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:05.93,0:03:06.76,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:03:07.56,0:03:09.73,Default,,0,0,0,,E-02 Тоқтату ер
Dialogue: 0,0:03:10.18,0:03:12.19,Default,,0,0,0,,E-02 Тоқтату ер
Dialogue: 0,0:03:12.48,0:03:14.65,Default,,0,0,0,,Тоқта бие Тоқта бие
Dialogue: 0,0:03:16.57,0:03:18.15,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:03:18.65,0:03:21.57,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:03:22.20,0:03:25.16,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:03:31.75,0:03:37.75,Default,,0,0,0,,Ван Ван Ван Ван...
Dialogue: 0,0:03:38.88,0:03:42.05,Default,,0,0,0,,Отыру
Dialogue: 0,0:03:42.18,0:03:43.51,Default,,0,0,0,,Уау, иә!
Dialogue: 0,0:03:43.64,0:03:45.76,Default,,0,0,0,,Сіз қалай ойлайсыз? менің үй жануарларым роботым
Dialogue: 0,0:03:45.89,0:03:47.01,Default,,0,0,0,,Стейннен алған жарақаттарым әлі толық жазылмағандықтан—
Dialogue: 0,0:03:48.31,0:03:49.93,Default,,0,0,0,,Иә Қолдар
Dialogue: 0,0:03:50.81,0:03:52.60,Default,,0,0,0,,Қолдар, қолдар!
Dialogue: 0,0:03:52.73,0:03:54.56,Default,,0,0,0,,Бір (Сунео) Га! Бұл ауырады
Dialogue: 0,0:03:55.56,0:03:58.15,Default,,0,0,0,,Ауырып тұр!
Dialogue: 0,0:03:59.11,0:04:00.28,Default,,0,0,0,,Егер біз оларды тоқтатпасақ, олар сол темір кесекке сәбіз жегізуге тырысады.
Dialogue: 0,0:04:00.40,0:04:04.41,Default,,0,0,0,,Бұл менің әкемнің компаниясы сататын «Асобо» робот-иті.
Dialogue: 0,0:04:04.53,0:04:05.53,Default,,0,0,0,,Бір!
Dialogue: 0,0:04:06.03,0:04:07.95,Default,,0,0,0,,Жақсы, Сунео.
Dialogue: 0,0:04:08.08,0:04:09.83,Default,,0,0,0,,Шынында да, мен сәл қызғанамын.
Dialogue: 0,0:04:09.95,0:04:11.37,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:04:12.00,0:04:14.33,Default,,0,0,0,,Маған коала үй жануарларына арналған робот керек
Dialogue: 0,0:04:14.46,0:04:15.96,Default,,0,0,0,,Ухуху уһхухуху
Dialogue: 0,0:04:16.50,0:04:19.84,Default,,0,0,0,,Мен, әрине, арыстанның үй жануарларына арналған роботпын.
Dialogue: 0,0:04:19.96,0:04:22.59,Default,,0,0,0,,Гао!
Dialogue: 0,0:04:22.72,0:04:24.38,Default,,0,0,0,,...Маған ғажайыптар ұнайды.
Dialogue: 0,0:04:25.13,0:04:26.72,Default,,0,0,0,,Мен, мен...
Dialogue: 0,0:04:26.84,0:04:29.14,Default,,0,0,0,,Нобита бақа сияқты жақсы көрінеді
Dialogue: 0,0:04:30.10,0:04:31.81,Default,,0,0,0,,Бақа?
Dialogue: 0,0:04:31.93,0:04:32.85,Default,,0,0,0,,Құсу
Dialogue: 0,0:04:33.31,0:04:34.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:38.36,0:04:39.57,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:39.69,0:04:41.07,Default,,0,0,0,,Сонымен не жақсы?
Dialogue: 0,0:04:41.65,0:04:44.20,Default,,0,0,0,,Спорттық костюмім мен кроссовкаларым мінсіз күйде, бір жыртығы да жоқ.
Dialogue: 0,0:04:44.45,0:04:45.15,Default,,0,0,0,,Медузалар!
Dialogue: 0,0:04:45.53,0:04:48.99,Default,,0,0,0,,Иә? Пуф... хахахаха
Dialogue: 0,0:04:49.12,0:04:50.79,Default,,0,0,0,,Нобитаға ұқсайды
Dialogue: 0,0:04:50.91,0:04:54.54,Default,,0,0,0,,Сіз анаңыздан медуза роботын сатып алуды сұрайсыз.
Dialogue: 0,0:04:54.66,0:04:56.08,Default,,0,0,0,,Хм
Dialogue: 0,0:04:56.29,0:04:58.29,Default,,0,0,0,,Ван ван ван ван…
Dialogue: 0,0:04:59.13,0:05:00.75,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:05:01.30,0:05:03.38,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:05:03.80,0:05:06.01,Default,,0,0,0,,Сәлем анашым
Dialogue: 0,0:05:06.13,0:05:07.76,Default,,0,0,0,,Менің де үй жануарым бар...
Dialogue: 0,0:05:07.89,0:05:09.43,Default,,0,0,0,,Үй жануарларына рұқсат етілмейді
Dialogue: 0,0:05:09.97,0:05:12.06,Default,,0,0,0,,Жоқ, үй жануарларына арналған робот
Dialogue: 0,0:05:12.89,0:05:15.73,Default,,0,0,0,,Пластикалық бөтелке жоқ па?
Dialogue: 0,0:05:16.35,0:05:19.36,Default,,0,0,0,,Жоқ, бұл үй жануарларына арналған робот.
Dialogue: 0,0:05:19.77,0:05:20.98,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:21.11,0:05:22.94,Default,,0,0,0,,Сонымен қатар, үй тапсырмасын орындадың ба?
Dialogue: 0,0:05:23.19,0:05:25.40,Default,,0,0,0,,А... иә.
Dialogue: 0,0:05:26.40,0:05:28.61,Default,,0,0,0,,Ақыр соңында, Дораемон оны шығарып алсын.
Dialogue: 0,0:05:29.66,0:05:31.08,Default,,0,0,0,,Үй жануарларына арналған робот?
Dialogue: 0,0:05:32.33,0:05:35.41,Default,,0,0,0,,Мен деген мысық тәрізді робот болса да.
Dialogue: 0,0:05:36.21,0:05:38.88,Default,,0,0,0,,Дораемон өзін үй жануарлары сияқты сезінбейді.
Dialogue: 0,0:05:39.33,0:05:43.25,Default,,0,0,0,,Біріншіден, сіз менің айтқанымды мүлде тыңдамайсыз.
Dialogue: 0,0:05:43.38,0:05:45.84,Default,,0,0,0,,Аа, өте аянышты.
Dialogue: 0,0:05:46.67,0:05:49.93,Default,,0,0,0,,Мен Нобитаның жақсы ересек болғанын қалаймын.
Dialogue: 0,0:05:50.55,0:05:53.01,Default,,0,0,0,,Бұл 22 ғасырдан.
Dialogue: 0,0:05:53.14,0:05:55.89,Default,,0,0,0,,Кез келген нәрсе, иә, иә, егер мен сіздің айтқаныңызды тыңдасам...
Dialogue: 0,0:05:56.43,0:05:58.60,Default,,0,0,0,,Міне, тағы бір уағыз.
Dialogue: 0,0:05:59.15,0:06:02.07,Default,,0,0,0,,Бұл кез келген затты тарата алатын автомат емес!
Dialogue: 0,0:06:02.69,0:06:06.07,Default,,0,0,0,,Кет! Кет! Мен қазір бос емеспін.
Dialogue: 0,0:06:07.07,0:06:08.49,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:06:09.11,0:06:10.45,Default,,0,0,0,,Мьян
Dialogue: 0,0:06:10.57,0:06:13.95,Default,,0,0,0,,Кешіріңіз, Нобита-кунның өзімшілдігі.
Dialogue: 0,0:06:14.29,0:06:14.99,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:06:17.12,0:06:18.54,Default,,0,0,0,,Олай болса кеттік
Dialogue: 0,0:06:18.66,0:06:19.71,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:06:22.75,0:06:26.30,Default,,0,0,0,,Бос емес болсаңыз, Ми Чанмен кездеспедіңіз бе?
Dialogue: 0,0:06:26.42,0:06:28.47,Default,,0,0,0,,Иә? Бұл дұрыс!
Dialogue: 0,0:06:32.26,0:06:33.18,Default,,0,0,0,,Хаха
Dialogue: 0,0:06:33.30,0:06:35.85,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:06:35.97,0:06:37.48,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:06:37.81,0:06:38.94,Default,,0,0,0,,Қосалқы қалта!
Dialogue: 0,0:06:41.44,0:06:43.77,Default,,0,0,0,,О? мм, мм, мм...
Dialogue: 0,0:06:43.90,0:06:45.15,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:06:45.40,0:06:48.44,Default,,0,0,0,,Гухаха хахахахаха
Dialogue: 0,0:06:48.57,0:06:50.82,Default,,0,0,0,,Тоқта, қытықтайды, қытықтайды
Dialogue: 0,0:06:51.16,0:06:52.78,Default,,0,0,0,,Уа, тоқтат, гахаха
Dialogue: 0,0:06:52.91,0:06:57.75,Default,,0,0,0,,Нобита-кун хьяхахаха Менің қосалқы қалтам уахахаха
Dialogue: 0,0:06:57.87,0:07:00.04,Default,,0,0,0,,Ууу... хахаха
Dialogue: 0,0:07:00.16,0:07:04.42,Default,,0,0,0,,Аха аа~
Dialogue: 0,0:07:04.54,0:07:05.59,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:07:06.13,0:07:07.92,Default,,0,0,0,,Мияу...
Dialogue: 0,0:07:08.46,0:07:10.80,Default,,0,0,0,,Пүгю…
Dialogue: 0,0:07:12.43,0:07:14.51,Default,,0,0,0,,Міне, болды.
Dialogue: 0,0:07:14.64,0:07:15.76,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:16.26,0:07:18.72,Default,,0,0,0,,Болашақ әмбебап дүкеннің пошталық тапсырыс машинасы
Dialogue: 0,0:07:19.60,0:07:21.64,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:07:21.77,0:07:23.69,Default,,0,0,0,,Тапсырыс беріңіз
Dialogue: 0,0:07:24.31,0:07:27.19,Default,,0,0,0,,Ал, робот каталогы...
Dialogue: 0,0:07:29.40,0:07:30.24,Default,,0,0,0,,Аа, шықты.
Dialogue: 0,0:07:31.15,0:07:33.95,Default,,0,0,0,,Үй жануарларына арналған медузаның роботы бар ма?
Dialogue: 0,0:07:35.49,0:07:37.41,Default,,0,0,0,,О... Әй? Тотото... Мен тоқтай алмаймын
Dialogue: 0,0:07:38.08,0:07:39.75,Default,,0,0,0,,А, қазір не болып жатыр?
Dialogue: 0,0:07:39.87,0:07:42.00,Default,,0,0,0,,Тиісті түрде басыңыз
Dialogue: 0,0:07:42.37,0:07:43.67,Default,,0,0,0,,Чобон!
Dialogue: 0,0:07:44.04,0:07:46.21,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:07:46.34,0:07:48.46,Default,,0,0,0,,Әр жолы Аригато Гозаймасу...
Dialogue: 0,0:07:46.34,0:07:48.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:48.59,0:07:54.22,Default,,0,0,0,,Ариға сайын... Арига сайын... Арига сайын...
Dialogue: 0,0:08:11.49,0:08:13.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:16.66,0:08:18.08,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:08:18.20,0:08:22.91,Default,,0,0,0,,(роботтардың шуы)
Dialogue: 0,0:08:30.71,0:08:33.88,Default,,0,0,0,,Осы роботтар туралы бірдеңе жасаңыз!
Dialogue: 0,0:08:34.47,0:08:40.39,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:08:40.64,0:08:45.65,Default,,0,0,0,,♪〜
Dialogue: 0,0:09:48.58,0:09:53.59,Default,,0,0,0,,〜♪
Dialogue: 0,0:09:53.88,0:09:57.22,Default,,0,0,0,,(Роботтардың шуы)
Dialogue: 0,0:09:57.59,0:09:59.68,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:10:00.93,0:10:01.76,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:10:02.26,0:10:05.64,Default,,0,0,0,,Нобита! Бұл не?
Dialogue: 0,0:10:07.60,0:10:09.27,Default,,0,0,0,,...
Dialogue: 0,0:10:09.40,0:10:11.23,Default,,0,0,0,,Бірінші метеорит
Dialogue: 0,0:10:11.73,0:10:14.15,Default,,0,0,0,,Ора Имодиори Гонскеда
Dialogue: 0,0:10:14.28,0:10:15.74,Default,,0,0,0,,Омесама Имо Хорика?
Dialogue: 0,0:10:15.86,0:10:18.78,Default,,0,0,0,,Уф... барлығыңыз шығыңыздар!
Dialogue: 0,0:10:18.90,0:10:21.07,Default,,0,0,0,,Қорқынышты Рози!
Dialogue: 0,0:10:21.24,0:10:24.79,Default,,0,0,0,,(Роботтардың шуы)
Dialogue: 0,0:10:24.91,0:10:26.33,Default,,0,0,0,,үшін, күте тұрыңдар!
Dialogue: 0,0:10:26.45,0:10:28.96,Default,,0,0,0,,Нобита!
Dialogue: 0,0:10:31.50,0:10:34.25,Default,,0,0,0,,Мии Чан, мен бүгін кешірім сұраймын.
Dialogue: 0,0:10:34.38,0:10:35.42,Default,,0,0,0,,Мя
Dialogue: 0,0:10:35.88,0:10:37.26,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:10:37.38,0:10:38.80,Default,,0,0,0,,Мя
Dialogue: 0,0:10:39.68,0:10:40.64,Default,,0,0,0,,Конничиха
Dialogue: 0,0:10:40.76,0:10:42.89,Default,,0,0,0,,Сәлеметсіз бе... Иә?
Dialogue: 0,0:10:43.43,0:10:44.85,Default,,0,0,0,,Жоқ... не?
Dialogue: 0,0:10:45.01,0:10:47.02,Default,,0,0,0,,Бүгін ауа райы өте жақсы...
Dialogue: 0,0:10:47.14,0:10:48.85,Default,,0,0,0,,Уау... тат аа!
Dialogue: 0,0:10:49.06,0:10:51.40,Default,,0,0,0,,Бұрылыс автобус Бұл коробаши дүкені.
Dialogue: 0,0:10:51.81,0:10:54.11,Default,,0,0,0,,А, сен мұнда неге келдің?
Dialogue: 0,0:10:54.44,0:10:57.07,Default,,0,0,0,,(Роботтардың шуы)
Dialogue: 0,0:10:57.69,0:11:00.91,Default,,0,0,0,,Иә? Барлық қалада роботтар
Dialogue: 0,0:11:01.03,0:11:04.83,Default,,0,0,0,,О, бұл Нобита-кунның ісі болуы мүмкін бе?
Dialogue: 0,0:11:04.95,0:11:10.41,Default,,0,0,0,,1000 иен айыппұл өндіріледі!
Dialogue: 0,0:11:10.54,0:11:13.38,Default,,0,0,0,,Се... 1000 иен? Бұл не?
Dialogue: 0,0:11:13.50,0:11:16.71,Default,,0,0,0,,Уау, біреу оны тоқтатшы!
Dialogue: 0,0:11:16.80,0:11:20.67,Default,,0,0,0,,Тоқта! (Депозиттік жәшік) Жақсы, жақсы, жақсы...
Dialogue: 0,0:11:20.80,0:11:23.64,Default,,0,0,0,,Ах! Бұл ақша қорабы
Dialogue: 0,0:11:23.97,0:11:26.39,Default,,0,0,0,,Сугоку Эй Эй
Dialogue: 0,0:11:26.51,0:11:27.68,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:11:27.81,0:11:29.60,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,0:11:29.73,0:11:32.60,Default,,0,0,0,,(барабан орамы)
Dialogue: 0,0:11:32.69,0:11:36.94,Default,,0,0,0,,(Көңіл-күйді көтеретін оркестрдің орындауы)
Dialogue: 0,0:11:37.07,0:11:38.57,Default,,0,0,0,,Тоқтаңыз.
Dialogue: 0,0:11:39.07,0:11:41.70,Default,,0,0,0,,Нобита-кун, сен не істедің?
Dialogue: 0,0:11:41.82,0:11:45.28,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:11:41.82,0:11:45.28,Default,,0,0,0,,Имо-дигори Имо-дигори Эняко~ра
Dialogue: 0,0:11:45.28,0:11:46.03,Default,,0,0,0,,Имо-дигори Имо-дигори Эняко~ра
Dialogue: 0,0:11:46.12,0:11:49.95,Default,,0,0,0,,Картоп қазу Картоп қазу Эняко~ра
Dialogue: 0,0:11:50.08,0:11:51.79,Default,,0,0,0,,Әй, картоп қазатын робот!
Dialogue: 0,0:11:52.79,0:11:55.25,Default,,0,0,0,,Алема? Омеемо Имо Хорика?
Dialogue: 0,0:11:55.46,0:11:57.84,Default,,0,0,0,,Мен укол салғым келмейді!
Dialogue: 0,0:11:57.96,0:12:00.63,Default,,0,0,0,,Анашым! Ван ван
Dialogue: 0,0:12:00.76,0:12:03.72,Default,,0,0,0,,Чуша Чуша Чуша
Dialogue: 0,0:12:03.80,0:12:04.93,Default,,0,0,0,,Чуша
Dialogue: 0,0:12:05.64,0:12:07.43,Default,,0,0,0,,Ах! А… Асобо…
Dialogue: 0,0:12:07.56,0:12:09.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:09.89,0:12:11.43,Default,,0,0,0,,Амансың ба? Асобо
Dialogue: 0,0:12:12.64,0:12:14.65,Default,,0,0,0,,Мияу мияу
Dialogue: 0,0:12:14.85,0:12:15.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:15.81,0:12:21.11,Default,,0,0,0,,Ах! Менің асобом мысыққа айналды
Dialogue: 0,0:12:21.61,0:12:22.57,Default,,0,0,0,,Әй, Дораемон!
Dialogue: 0,0:12:23.61,0:12:26.20,Default,,0,0,0,,Нобита-кун, бұл нені білдіреді?
Dialogue: 0,0:12:26.32,0:12:27.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:27.95,0:12:28.99,Default,,0,0,0,,Эх!
Dialogue: 0,0:12:29.12,0:12:33.50,Default,,0,0,0,,Сонымен, сіз осы роботтардың барлығына болашақ әмбебап дүкеннен тапсырыс бердіңіз бе?
Dialogue: 0,0:12:33.58,0:12:35.58,Default,,0,0,0,,Иә, уау!
Dialogue: 0,0:12:35.71,0:12:38.63,Default,,0,0,0,,Мен қалтамдағы ақшамен шынымен төлей алмаймын.
Dialogue: 0,0:12:38.75,0:12:39.96,Default,,0,0,0,,Жоқ... не істеуім керек?
Dialogue: 0,0:12:40.88,0:12:42.42,Default,,0,0,0,,Мен оны тез арада қайтаруым керек.
Dialogue: 0,0:12:43.05,0:12:45.38,Default,,0,0,0,,Ториоза сөмкесі!
Dialogue: 0,0:12:48.51,0:12:50.89,Default,,0,0,0,,Қазір оралу
Dialogue: 0,0:12:51.72,0:12:53.64,Default,,0,0,0,,Картоп қазу ~ Ах...
Dialogue: 0,0:12:53.73,0:12:55.77,Default,,0,0,0,,Эй, қойшы (депозиттік жәшік) Жақсы, жақсы!
Dialogue: 0,0:12:55.90,0:12:56.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:57.69,0:12:58.98,Default,,0,0,0,,Әй?
Dialogue: 0,0:12:59.86,0:13:01.32,Default,,0,0,0,,Мияу... (Сунео) Ах!
Dialogue: 0,0:13:01.44,0:13:03.24,Default,,0,0,0,,Асобо~!
Dialogue: 0,0:13:04.95,0:13:07.20,Default,,0,0,0,,Вена Вена Вена…
Dialogue: 0,0:13:11.41,0:13:12.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:12.83,0:13:13.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:20.88,0:13:21.71,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:13:21.84,0:13:24.59,Default,,0,0,0,,Әрине, бұл Дораэмон құралдарының арқасында.
Dialogue: 0,0:13:24.72,0:13:25.97,Default,,0,0,0,,Мя
Dialogue: 0,0:13:26.93,0:13:28.26,Default,,0,0,0,,Қазірдің өзінде
Dialogue: 0,0:13:28.39,0:13:30.43,Default,,0,0,0,,Нобитаның арқасында мен қорқынышты жағдайдан өттім.
Dialogue: 0,0:13:30.85,0:13:32.89,Default,,0,0,0,,Мен шынымен таң қалдым.
Dialogue: 0,0:13:33.06,0:13:36.06,Default,,0,0,0,,Менің асобомды бұрынғы қалпына келтіріңізші!
Dialogue: 0,0:13:36.14,0:13:37.85,Default,,0,0,0,,Мияу мияу...
Dialogue: 0,0:13:38.27,0:13:41.32,Default,,0,0,0,,Кешіріңіз, мен жай ғана абайсызда болдым.
Dialogue: 0,0:13:41.86,0:13:43.23,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:44.15,0:13:45.82,Default,,0,0,0,,Қазірдің өзінде! Бұл ит болса да
Dialogue: 0,0:13:45.95,0:13:49.78,Default,,0,0,0,,Мияу Мияу Мияу, өте қатты!
Dialogue: 0,0:13:49.91,0:13:52.20,Default,,0,0,0,,Тоқта, Джан, аа...
Dialogue: 0,0:13:52.33,0:13:53.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:53.74,0:13:54.95,Default,,0,0,0,,Ах... Асобо
Dialogue: 0,0:13:55.66,0:13:56.91,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:57.21,0:13:57.96,Default,,0,0,0,,(Асобоның үруі)
Dialogue: 0,0:13:57.96,0:14:00.46,Default,,0,0,0,,(Асобоның үруі)
Dialogue: 0,0:13:57.96,0:14:00.46,Default,,0,0,0,,Уау! Ол аурады!
Dialogue: 0,0:14:00.58,0:14:01.54,Default,,0,0,0,,Джан!
Dialogue: 0,0:14:02.42,0:14:04.76,Default,,0,0,0,,Сунео! Бірдеңе істе!
Dialogue: 0,0:14:06.17,0:14:08.47,Default,,0,0,0,,Мен... Сіз мені тыңдамайсыз.
Dialogue: 0,0:14:08.93,0:14:12.43,Default,,0,0,0,,Уау! Әй... Эй, маған көмектес!
Dialogue: 0,0:14:13.14,0:14:14.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:22.31,0:14:24.07,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,0:14:27.86,0:14:29.66,Default,,0,0,0,,Маған тезірек бірдеңе беріңіз.
Dialogue: 0,0:14:29.78,0:14:32.03,Default,,0,0,0,,Бірдеңе бар ма? Бірдеңе... А, бұл да басқа.
Dialogue: 0,0:14:32.24,0:14:37.00,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:14:37.41,0:14:38.46,Default,,0,0,0,,Ха! Уф...
Dialogue: 0,0:14:42.29,0:14:44.92,Default,,0,0,0,,үшінң, балшықтан жасалған құбырға көтеріліңдер!
Dialogue: 0,0:14:47.59,0:14:49.97,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:14:50.43,0:14:52.43,Default,,0,0,0,,Асобо оны тоқтатыңыз
Dialogue: 0,0:14:53.05,0:14:53.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:54.01,0:14:54.85,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:14:55.26,0:14:56.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:57.98,0:14:58.64,Default,,0,0,0,,Ха...
Dialogue: 0,0:15:00.98,0:15:04.48,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:15:04.86,0:15:06.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:06.40,0:15:07.86,Default,,0,0,0,,♬ Бос соңғы бетте
Dialogue: 0,0:15:09.28,0:15:10.49,Default,,0,0,0,,Олар бәрі бәсекелестер, иә?
Dialogue: 0,0:15:10.61,0:15:12.03,Default,,0,0,0,,Ой...
Dialogue: 0,0:15:12.20,0:15:14.37,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:15:14.91,0:15:18.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:18.12,0:15:19.71,Default,,0,0,0,,Або... менің асобом
Dialogue: 0,0:15:19.83,0:15:21.00,Default,,0,0,0,,Тіпті олай емес.
Dialogue: 0,0:15:21.12,0:15:21.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:22.17,0:15:24.42,Default,,0,0,0,,Сіз! Уф...
Dialogue: 0,0:15:25.67,0:15:27.38,Default,,0,0,0,,Амансың ба? Мықты болыңыз
Dialogue: 0,0:15:30.05,0:15:31.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:32.01,0:15:34.01,Default,,0,0,0,,Бұл бала робот.
Dialogue: 0,0:15:34.93,0:15:38.18,Default,,0,0,0,,Бұл да Нобита жасаған робот па?
Dialogue: 0,0:15:38.31,0:15:39.48,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:15:40.23,0:15:41.69,Default,,0,0,0,,Бірақ бұл біртүрлі
Dialogue: 0,0:15:41.81,0:15:45.36,Default,,0,0,0,,Неліктен бұл роботты қайтару мүмкін болмады?
Dialogue: 0,0:15:45.48,0:15:46.44,Default,,0,0,0,,Анықтап көрейік
Dialogue: 0,0:15:46.86,0:15:48.86,Default,,0,0,0,,Қабырға қағазының құпия негізі!
Dialogue: 0,0:15:49.61,0:15:52.36,Default,,0,0,0,,Байқамау үшін осында
Dialogue: 0,0:15:52.99,0:15:54.20,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:16:02.21,0:16:04.71,Default,,0,0,0,,Мм, күткендей.
Dialogue: 0,0:16:04.83,0:16:06.79,Default,,0,0,0,,Мұның мәні неде?
Dialogue: 0,0:16:07.42,0:16:09.88,Default,,0,0,0,,Бұл бала Жерден келген робот емес.
Dialogue: 0,0:16:10.01,0:16:10.84,Default,,0,0,0,,Эх!
Dialogue: 0,0:16:11.38,0:16:14.30,Default,,0,0,0,,Сонымен, Дора-чан түзете алмай ма?
Dialogue: 0,0:16:14.97,0:16:18.47,Default,,0,0,0,,Бұл мен бұрын-соңды көрмеген бөлік, ал материалы бөлек.
Dialogue: 0,0:16:18.60,0:16:20.81,Default,,0,0,0,,Ол белгісіз планетада жасалған.
Dialogue: 0,0:16:21.39,0:16:23.10,Default,,0,0,0,,Неліктен ол Жерде?
Dialogue: 0,0:16:23.23,0:16:25.90,Default,,0,0,0,,Мен қателескеніме сенімдімін.
Dialogue: 0,0:16:26.02,0:16:27.27,Default,,0,0,0,,Мен араласып кеттім.
Dialogue: 0,0:16:27.98,0:16:30.15,Default,,0,0,0,,Иә! Бұл Нобитаның кінәсі
Dialogue: 0,0:16:30.94,0:16:32.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:32.99,0:16:34.15,Default,,0,0,0,,Сен, берік бол (ескерту дыбысы)
Dialogue: 0,0:16:34.28,0:16:34.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:35.78,0:16:37.91,Default,,0,0,0,,Жоқ, маған тез арада бірдеңе істеу керек.
Dialogue: 0,0:16:38.41,0:16:40.83,Default,,0,0,0,,Мм... бұл туралы бірдеңе істеуіңізді өтінемін.
Dialogue: 0,0:16:40.95,0:16:42.41,Default,,0,0,0,,Бір нәрсені істеу бағытында
Dialogue: 0,0:16:42.54,0:16:44.37,Default,,0,0,0,,Бір нәрсені істеу бағытында
Dialogue: 0,0:16:44.46,0:16:46.83,Default,,0,0,0,,Бір нәрсені қалай істеу керек... Жоқ, бір ғана жол бар.
Dialogue: 0,0:16:46.96,0:16:47.63,Default,,0,0,0,,Иә
Dialogue: 0,0:16:47.75,0:16:50.67,Default,,0,0,0,,Менің бұл бала жаралған дүниеге барудан басқа амалым жоқ.
Dialogue: 0,0:16:50.80,0:16:52.72,Default,,0,0,0,,Ей, кеттік.
Dialogue: 0,0:16:52.84,0:16:55.30,Default,,0,0,0,,Мен қайда екенін білмеймін алыстағы жұлдыз?
Dialogue: 0,0:16:56.01,0:16:57.76,Default,,0,0,0,,Егер бұл шытырман оқиға болса, оны маған қалдырыңыз.
Dialogue: 0,0:16:58.35,0:17:01.18,Default,,0,0,0,,Сізге үлкен қауіп төнуі мүмкін.
Dialogue: 0,0:17:01.31,0:17:04.23,Default,,0,0,0,,Жақсы, егер бұл баланы құтқаруға болады.
Dialogue: 0,0:17:04.77,0:17:07.56,Default,,0,0,0,,Кешікпей барайық, жарай ма? Сунео
Dialogue: 0,0:17:07.69,0:17:10.19,Default,,0,0,0,,Не? Мен... мен кішкентаймын...
Dialogue: 0,0:17:10.27,0:17:13.65,Default,,0,0,0,,Әй, бәрі сенің ақымақтың кесірінен.
Dialogue: 0,0:17:14.24,0:17:16.11,Default,,0,0,0,,Мен... Жарайды, түсіндім.
Dialogue: 0,0:17:16.66,0:17:18.95,Default,,0,0,0,,Жарайды, Дораемон шешілді
Dialogue: 0,0:17:19.07,0:17:22.58,Default,,0,0,0,,үшінмыз мына баланы туған жер планетасына апарайық.
Dialogue: 0,0:17:23.00,0:17:27.00,Default,,0,0,0,,Иә, иә, барлығы... рахмет
Dialogue: 0,0:17:27.12,0:17:29.54,Default,,0,0,0,,Әлемдегі роботтар атынан
Dialogue: 0,0:17:29.67,0:17:31.50,Default,,0,0,0,,Сізге алғыс айтқым келеді...
Dialogue: 0,0:17:31.63,0:17:32.92,Default,,0,0,0,,Олай болса кеттік!
Dialogue: 0,0:17:33.51,0:17:34.88,Default,,0,0,0,,Оу!
Dialogue: 0,0:17:35.34,0:17:37.76,Default,,0,0,0,,О...о
Dialogue: 0,0:17:46.44,0:17:48.06,Default,,0,0,0,,Уақыт кеңістігінде навигация
Dialogue: 0,0:17:48.19,0:17:51.77,Default,,0,0,0,,Осы баланың қай жолмен келгенін көрсетіңіз.
Dialogue: 0,0:17:51.90,0:17:53.53,Default,,0,0,0,,Мына жігіт жақсы ма?
Dialogue: 0,0:17:54.11,0:17:58.11,Default,,0,0,0,,Миномуши стиліндегі ұйықтайтын қапшықта болғандықтан қауіпсіз.
Dialogue: 0,0:17:58.91,0:18:00.62,Default,,0,0,0,,Көңіліңді көтер, Сунео
Dialogue: 0,0:18:00.74,0:18:02.16,Default,,0,0,0,,Егер ол роботтарға толы планета болса
Dialogue: 0,0:18:02.28,0:18:05.12,Default,,0,0,0,,Біреуін алуыңыз мүмкін.
Dialogue: 0,0:18:05.25,0:18:07.04,Default,,0,0,0,,Дұрыс... хахахаха...
Dialogue: 0,0:18:07.16,0:18:08.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:08.87,0:18:10.08,Default,,0,0,0,,Мен үшін алғаш рет!
Dialogue: 0,0:18:10.33,0:18:13.55,Default,,0,0,0,,Уақыт кеңістігінің лабиринтіне кіру
Dialogue: 0,0:18:14.05,0:18:15.17,Default,,0,0,0,,Не? Сол... сол
Dialogue: 0,0:18:15.30,0:18:17.76,Default,,0,0,0,,Біз кеңістік-уақыт лабиринтіне кіріп бара жатқан сияқтымыз.
Dialogue: 0,0:18:18.47,0:18:21.01,Default,,0,0,0,,үшінңыз, мықтап ұстаңыздар!
Dialogue: 0,0:18:21.39,0:18:23.26,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:23.81,0:18:26.77,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:18:31.36,0:18:34.82,Default,,0,0,0,,Менің басым айналып кетті Уау!
Dialogue: 0,0:18:38.99,0:18:44.99,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:18:49.33,0:18:50.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:50.58,0:18:54.42,Default,,0,0,0,,Күрсіну... Қандай да бір жағдай тұрақталған сияқты.
Dialogue: 0,0:18:54.55,0:18:56.63,Default,,0,0,0,,Сіз адасып қалдыңыз ба?
Dialogue: 0,0:18:56.76,0:18:59.42,Default,,0,0,0,,Навигация жалғасуда
Dialogue: 0,0:18:59.55,0:19:00.88,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:19:01.09,0:19:03.89,Default,,0,0,0,,Мына бала осы жерден өтті.
Dialogue: 0,0:19:09.77,0:19:11.81,Default,,0,0,0,,Өңделмеген роботты түсіру
Dialogue: 0,0:19:11.98,0:19:12.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:13.65,0:19:14.94,Default,,0,0,0,,Не болды? Дораемон
Dialogue: 0,0:19:15.07,0:19:18.32,Default,,0,0,0,,Дәл қазір мені біреу бақылап тұрғандай сезінемін.
Dialogue: 0,0:19:20.45,0:19:21.66,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:19:21.78,0:19:26.91,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:19:27.04,0:19:28.25,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:31.54,0:19:32.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:39.05,0:19:41.13,Default,,0,0,0,,Мен сенен кейін келе жатырмын! Ол кім?
Dialogue: 0,0:19:41.26,0:19:42.34,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:19:42.43,0:19:44.55,Default,,0,0,0,,Әйтеуір, қазір қаш! (машина жұмысының дыбысы)
Dialogue: 0,0:19:44.68,0:19:46.14,Default,,0,0,0,,Тіпті айтпай-ақ!
Dialogue: 0,0:19:47.26,0:19:49.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:56.15,0:19:58.44,Default,,0,0,0,,Кеңістік-уақыт қабырғасына соғылған жағдайда не болады?
Dialogue: 0,0:19:58.57,0:20:00.15,Default,,0,0,0,,Жарайды, ол құлады...
Dialogue: 0,0:20:01.70,0:20:02.95,Default,,0,0,0,,Бұл болады
Dialogue: 0,0:20:03.24,0:20:06.45,Default,,0,0,0,,Уау! Сондықтан мен оны ұнатпаймын дедім.
Dialogue: 0,0:20:06.83,0:20:10.79,Default,,0,0,0,,Бұл түсініксіз робот үшін.
Dialogue: 0,0:20:11.37,0:20:13.96,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:20:14.42,0:20:15.96,Default,,0,0,0,,Сунео! Сунео мырза!
Dialogue: 0,0:20:16.25,0:20:17.46,Default,,0,0,0,,О, балапан...
Dialogue: 0,0:20:18.00,0:20:21.47,Default,,0,0,0,,Сунео! Иётто
Dialogue: 0,0:20:22.88,0:20:23.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:24.68,0:20:26.43,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:20:26.97,0:20:28.93,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:20:29.56,0:20:31.89,Default,,0,0,0,,Автопилот сәтсіз аяқталды
Dialogue: 0,0:20:32.18,0:20:35.56,Default,,0,0,0,,Біреу басқару элементтерін ұстасын!
Dialogue: 0,0:20:35.69,0:20:38.86,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:20:39.15,0:20:42.82,Default,,0,0,0,,Ах... Уау Уау!
Dialogue: 0,0:20:43.07,0:20:45.82,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:20:46.32,0:20:48.03,Default,,0,0,0,,Дора-чан, қазір не істеп жатырсың?
Dialogue: 0,0:20:48.16,0:20:49.28,Default,,0,0,0,,Уақыт добы
Dialogue: 0,0:20:49.79,0:20:53.25,Default,,0,0,0,,Бұл кеңістікте және уақытта болған шағын тайфун сияқты.
Dialogue: 0,0:20:53.71,0:20:55.71,Default,,0,0,0,,Егер соны тигізсең, бітті.
Dialogue: 0,0:20:56.12,0:20:57.17,Default,,0,0,0,,Алда сақ болыңыз!
Dialogue: 0,0:20:57.25,0:20:58.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:58.25,0:21:01.17,Default,,0,0,0,,Басқаруды біреу қолға алсын!
Dialogue: 0,0:21:01.34,0:21:02.17,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:21:06.34,0:21:09.35,Default,,0,0,0,,Керемет жұмыс, мен келесіде келемін!
Dialogue: 0,0:21:09.47,0:21:13.10,Default,,0,0,0,,Жарайды... Мен де істеу керек болғанда істеймін!
Dialogue: 0,0:21:13.35,0:21:16.35,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:21:17.15,0:21:18.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:18.23,0:21:20.77,Default,,0,0,0,,бірдеңе бірдеңе...
Dialogue: 0,0:21:24.65,0:21:26.57,Default,,0,0,0,,Мұны маған қалдырыңыз
Dialogue: 0,0:21:26.82,0:21:28.99,Default,,0,0,0,,Сунео-кун оны ұшқышпен басқаруымды өтінді!
Dialogue: 0,0:21:29.49,0:21:31.95,Default,,0,0,0,,Дораемон! сурет?
Dialogue: 0,0:21:32.08,0:21:35.25,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:21:38.08,0:21:39.25,Default,,0,0,0,,(үшінның қорқынышты дауыстары)
Dialogue: 0,0:21:39.38,0:21:42.71,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:21:48.01,0:21:50.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:50.30,0:21:51.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:54.68,0:21:57.73,Default,,0,0,0,,Иә, біз межелі әлемге аман-есен жеттік.
Dialogue: 0,0:21:57.85,0:22:00.15,Default,,0,0,0,,Дауыстық нұсқау аяқталады
Dialogue: 0,0:22:00.27,0:22:03.44,Default,,0,0,0,,Ах... бұл мені құтқарды.
Dialogue: 0,0:22:03.65,0:22:07.15,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:22:07.74,0:22:10.12,Default,,0,0,0,,үшін тыныштықпен артта
Dialogue: 0,0:22:12.99,0:22:15.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:15.58,0:22:18.17,Default,,0,0,0,,Ху~ Бұл қауіпті болды.
Dialogue: 0,0:22:18.29,0:22:20.00,Default,,0,0,0,,Ха… Ха…
Dialogue: 0,0:22:20.13,0:22:21.42,Default,,0,0,0,,Хакушон!
Dialogue: 0,0:22:21.50,0:22:25.51,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:22:26.42,0:22:29.30,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:22:45.53,0:22:46.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:46.94,0:22:47.82,Default,,0,0,0,,(Масато) Денең болмауы біраз қиын ғой, иә?
Dialogue: 0,0:22:48.20,0:22:49.28,Default,,0,0,0,,Өте жаман. Ол жігіт шынымен ақылынан адасып бара жатыр.
Dialogue: 0,0:22:54.16,0:22:58.16,Default,,0,0,0,,(барлығы ыңылдап)
Dialogue: 0,0:22:59.58,0:23:03.13,Default,,0,0,0,,Әй... бәрі, жараланып қалдың ба?
Dialogue: 0,0:23:03.38,0:23:05.09,Default,,0,0,0,,На~и~ (құс тәрізді роботтың айқайы)
Dialogue: 0,0:23:05.71,0:23:07.05,Default,,0,0,0,,Бұл... Жарайды.
Dialogue: 0,0:23:07.17,0:23:08.05,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:23:08.47,0:23:11.01,Default,,0,0,0,,Әрқашан осылай.
Dialogue: 0,0:23:11.26,0:23:12.93,Default,,0,0,0,,Әй, анау қыз!
Dialogue: 0,0:23:13.05,0:23:14.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:17.60,0:23:19.06,Default,,0,0,0,,Мен қақпаны бұзып өттім дедің—дәл қазір де, қазір де, солай емес пе?
Dialogue: 0,0:23:20.64,0:23:23.23,Default,,0,0,0,,Қызық, бұл баланың дүниесі ме?
Dialogue: 0,0:23:23.36,0:23:24.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:35.66,0:23:37.95,Default,,0,0,0,,Бұл Жер емес еді.
Dialogue: 0,0:23:39.75,0:23:41.67,Default,,0,0,0,,Бұл ауырмайды. Күте тұрыңыз!
Dialogue: 0,0:23:42.62,0:23:44.67,Default,,0,0,0,,Күте тұрыңыз! сурет?
Dialogue: 0,0:23:44.79,0:23:46.67,Default,,0,0,0,,Әй, ол жоғалды.
Dialogue: 0,0:23:47.55,0:23:49.76,Default,,0,0,0,,О, үй!
Dialogue: 0,0:23:49.88,0:23:51.93,Default,,0,0,0,,Дораэмон Бізде үй бар!
Dialogue: 0,0:23:52.22,0:23:54.76,Default,,0,0,0,,Бұл кім? шулы
Dialogue: 0,0:23:55.47,0:23:56.72,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:23:56.85,0:24:01.27,Default,,0,0,0,,А-а, біз күдікті адамдар емеспіз... Ах.
Dialogue: 0,0:24:01.39,0:24:03.52,Default,,0,0,0,,Kurleen патч
Dialogue: 0,0:24:04.02,0:24:05.11,Default,,0,0,0,,Батырдың аты: Ол Майт
Dialogue: 0,0:24:05.23,0:24:08.19,Default,,0,0,0,,Иә, мен сізді күдікті деп ойламаймын, папа.
Dialogue: 0,0:24:08.36,0:24:10.15,Default,,0,0,0,,Хехе сүйкімді
Dialogue: 0,0:24:10.69,0:24:13.61,Default,,0,0,0,,Бұл Куруринпа роботының көмекшісі
Dialogue: 0,0:24:13.74,0:24:15.66,Default,,0,0,0,,Сәлем папа
Dialogue: 0,0:24:15.78,0:24:18.62,Default,,0,0,0,,О, неткен қиын тұтынушы.
Dialogue: 0,0:24:18.95,0:24:20.54,Default,,0,0,0,,Онабемен рахаттаныңыз
Dialogue: 0,0:24:20.66,0:24:24.08,Default,,0,0,0,,Менде роботтарға көмектесу үшін бірінші дәрежелі лицензия бар.
Dialogue: 0,0:24:24.21,0:24:26.17,Default,,0,0,0,,Хохохохо!
Dialogue: 0,0:24:26.46,0:24:28.00,Default,,0,0,0,,Мен... Мен Дораемон
Dialogue: 0,0:24:28.13,0:24:29.80,Default,,0,0,0,,Бұл 3-сыныпты робот.
Dialogue: 0,0:24:30.38,0:24:34.51,Default,,0,0,0,,Мен адам Capek және робот дәрігермін.
Dialogue: 0,0:24:34.72,0:24:35.72,Default,,0,0,0,,Не?!
Dialogue: 0,0:24:35.84,0:24:38.85,Default,,0,0,0,,Робот дәрігер? Бұл дұрыс болды
Dialogue: 0,0:24:38.97,0:24:39.97,Default,,0,0,0,,Рас
Dialogue: 0,0:24:40.39,0:24:43.64,Default,,0,0,0,,Мен Нобита Нобимін, мен адаммын.
Dialogue: 0,0:24:43.77,0:24:45.98,Default,,0,0,0,,Шындығында, біз...
Dialogue: 0,0:24:46.65,0:24:47.48,Default,,0,0,0,,Жер?
Dialogue: 0,0:24:48.82,0:24:52.90,Default,,0,0,0,,Мен ешқашан планета туралы естіген емеспін, бірақ ол сені сонда жіберді ме?
Dialogue: 0,0:24:53.95,0:24:55.45,Default,,0,0,0,,Менің экспериментім сияқты
Dialogue: 0,0:24:55.57,0:24:59.28,Default,,0,0,0,,Сіз күтпеген еркелік жасаған сияқтысыз.
Dialogue: 0,0:24:59.41,0:25:01.08,Default,,0,0,0,,Қандай эксперимент?
Dialogue: 0,0:25:01.20,0:25:02.37,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:25:02.70,0:25:04.75,Default,,0,0,0,,Ах! бұған тиме
Dialogue: 0,0:25:04.83,0:25:05.67,Default,,0,0,0,,Олар болашақта бізден тағы да көп нәрсені тартып алады.
Dialogue: 0,0:25:05.75,0:25:06.75,Default,,0,0,0,,Сунео!
Dialogue: 0,0:25:06.92,0:25:09.42,Default,,0,0,0,,А, мен мұны істедім.
Dialogue: 0,0:25:10.17,0:25:11.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:12.38,0:25:14.38,Default,,0,0,0,,Кики Кики... (Нобита) Бұрынғы құс!
Dialogue: 0,0:25:15.51,0:25:18.85,Default,,0,0,0,,Киккикки Кики Кики
Dialogue: 0,0:25:19.76,0:25:24.52,Default,,0,0,0,,Бұл телепортация құрылғысы баланы абайсызда гиперкеңістікке жіберді.
Dialogue: 0,0:25:24.64,0:25:27.81,Default,,0,0,0,,Осылайша ол сіздің құрылғыңызға қосылған.
Dialogue: 0,0:25:28.27,0:25:31.78,Default,,0,0,0,,Сіздің экспериментіңіздің пайдасы жоқ.
Dialogue: 0,0:25:32.23,0:25:34.40,Default,,0,0,0,,Ей, сен олай айта алмайсың.
Dialogue: 0,0:25:34.53,0:25:38.37,Default,,0,0,0,,Бұл планетада роботтар мен адамдар бірге өмір сүреді, солай ма?
Dialogue: 0,0:25:38.70,0:25:40.95,Default,,0,0,0,,А... міне, солай.
Dialogue: 0,0:25:41.28,0:25:45.21,Default,,0,0,0,,Бірақ неге бұл робот мені қуып жүрді?
Dialogue: 0,0:25:45.33,0:25:46.16,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:25:46.67,0:25:49.21,Default,,0,0,0,,Иә, тамақ дайын.
Dialogue: 0,0:25:49.33,0:25:50.29,Default,,0,0,0,,Уау, олар керемет көрінеді!
Dialogue: 0,0:25:50.63,0:25:53.17,Default,,0,0,0,,Мен аштан өлемін.
Dialogue: 0,0:25:53.30,0:25:55.30,Default,,0,0,0,,Сонда сіз әрқашан өлгіңіз келмейді ме?
Dialogue: 0,0:25:55.42,0:25:56.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:56.93,0:26:00.60,Default,,0,0,0,,Ұялма, Онабе темір аспаз.
Dialogue: 0,0:26:01.01,0:26:02.43,Default,,0,0,0,,Расында да, Онабе мырза...
Dialogue: 0,0:26:02.56,0:26:04.56,Default,,0,0,0,,Иә, бұл Темір адам.
Dialogue: 0,0:26:04.81,0:26:07.89,Default,,0,0,0,,Бұл жаман емес, хохохохо
Dialogue: 0,0:26:08.60,0:26:10.27,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:26:14.11,0:26:15.40,Default,,0,0,0,,Ал Батыста Весталис, оны тоқтатуға бел буған
Dialogue: 0,0:26:15.82,0:26:16.78,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:26:17.70,0:26:19.03,Default,,0,0,0,,Уми
Dialogue: 0,0:26:19.16,0:26:22.20,Default,,0,0,0,,Менің өмірімдегі ең жақсысы!
Dialogue: 0,0:26:22.33,0:26:23.99,Default,,0,0,0,,Сіз әдетте не жейсіз?
Dialogue: 0,0:26:24.12,0:26:25.75,Default,,0,0,0,,Не? (Сунео) Хаха... жоқ.
Dialogue: 0,0:26:26.12,0:26:27.41,Default,,0,0,0,,Егер сізге қатты ұнаса
Dialogue: 0,0:26:27.54,0:26:30.04,Default,,0,0,0,,Сақталған десертті әкелейін бе?
Dialogue: 0,0:26:30.63,0:26:32.59,Default,,0,0,0,,Не? Мен оны асыға күтемін
Dialogue: 0,0:26:32.71,0:26:33.55,Default,,0,0,0,,Иә
Dialogue: 0,0:26:33.63,0:26:36.51,Default,,0,0,0,,Иә! Ол сондай балғын
Dialogue: 0,0:26:37.30,0:26:38.93,Default,,0,0,0,,Ауыр болды
Dialogue: 0,0:26:39.05,0:26:39.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:50.31,0:26:53.23,Default,,0,0,0,,Бұл планета пионер жұлдызы.
Dialogue: 0,0:26:53.36,0:26:54.61,Default,,0,0,0,,Пионер жұлдызы?
Dialogue: 0,0:26:55.19,0:26:59.82,Default,,0,0,0,,Олар ешкім тұрмайтын ғаламшарды өңдеп, жаңа ел құрды.
Dialogue: 0,0:27:00.20,0:27:01.11,Default,,0,0,0,,Қош бол
Dialogue: 0,0:27:01.24,0:27:05.08,Default,,0,0,0,,Өзінің туған планетасын тастап, осы планетаның топырағын басқан кім?
Dialogue: 0,0:27:05.20,0:27:08.58,Default,,0,0,0,,Адамдарға қарағанда роботтар көп болды.
Dialogue: 0,0:27:30.10,0:27:35.19,Default,,0,0,0,,Адамдар роботтарды әңгімелесушілер мен достар ретінде пайдаланады.
Dialogue: 0,0:27:35.32,0:27:37.65,Default,,0,0,0,,емделе бастады
Dialogue: 0,0:27:38.03,0:27:43.03,Default,,0,0,0,,Нәтижесінде роботтардың жасанды интеллектісі тез дамитын болады.
Dialogue: 0,0:27:44.03,0:27:50.04,Default,,0,0,0,,Ақырында олардың ақыл-ойы мен сезімдері адамдармен бірдей бола бастады.
Dialogue: 0,0:27:50.91,0:27:55.17,Default,,0,0,0,,Бірақ патшайым Жанна роботты өзінің құлы ретінде пайдаланады.
Dialogue: 0,0:27:55.29,0:28:00.30,Default,,0,0,0,,Олар оны адамдарға адалдықпен жүру құралы ретінде қолдана бастады.
Dialogue: 0,0:28:00.42,0:28:01.26,Default,,0,0,0,,Эх!
Dialogue: 0,0:28:01.55,0:28:04.55,Default,,0,0,0,,Бұл роботты өзгерту тәртібі.
Dialogue: 0,0:28:05.01,0:28:07.06,Default,,0,0,0,,Роботты өзгерту тәртібі?
Dialogue: 0,0:28:07.18,0:28:08.14,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:28:08.26,0:28:09.56,Default,,0,0,0,,Бұл тым өзімшілдік
Dialogue: 0,0:28:09.68,0:28:11.89,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:28:31.29,0:28:34.67,Default,,0,0,0,,Командир Дестар Робот аң аулау дамып жатыр ма?
Dialogue: 0,0:28:34.83,0:28:38.17,Default,,0,0,0,,Уайымдама, Жанна.
Dialogue: 0,0:28:38.25,0:28:41.13,Default,,0,0,0,,Бәрін маған қалдыр.
Dialogue: 0,0:28:41.42,0:28:44.09,Default,,0,0,0,,Дроид сарбаздары менің қызметшілерім.
Dialogue: 0,0:28:44.18,0:28:47.05,Default,,0,0,0,,Нәтижелер тұрақты түрде жақсаруда
Dialogue: 0,0:28:47.39,0:28:48.43,Default,,0,0,0,,Хмм
Dialogue: 0,0:29:18.13,0:29:22.38,Default,,0,0,0,,Жанна-сама, сен неге Марияны өзгертпедің?
Dialogue: 0,0:29:22.80,0:29:25.84,Default,,0,0,0,,Бұл сіздің бала күтіміндегі роботыңыз болғандықтан ба?
Dialogue: 0,0:29:26.68,0:29:31.81,Default,,0,0,0,,Әкеңнің неліктен қайтыс болғанын ұмыттың деп үміттенемін.
Dialogue: 0,0:29:32.64,0:29:36.81,Default,,0,0,0,,Роботтар адамдармен бірдей болғандықтан...
Dialogue: 0,0:29:36.94,0:29:38.10,Default,,0,0,0,,Егер олар тым жылдам қозғалса (оу, вей, оу)
Dialogue: 0,0:29:41.48,0:29:45.53,Default,,0,0,0,,Роботтар адам үшін құрал ғана емес.
Dialogue: 0,0:29:47.66,0:29:48.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:29:49.12,0:29:50.91,Default,,0,0,0,,А...
Dialogue: 0,0:29:51.45,0:29:52.91,Default,,0,0,0,,Анашым
Dialogue: 0,0:29:57.08,0:29:59.67,Default,,0,0,0,,А, мен зейін қойдым.
Dialogue: 0,0:30:10.01,0:30:11.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:30:12.97,0:30:13.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:30:15.60,0:30:16.77,Default,,0,0,0,,Ах
Dialogue: 0,0:30:17.23,0:30:18.10,Default,,0,0,0,,Сен... сен!
Dialogue: 0,0:30:18.90,0:30:21.06,Default,,0,0,0,,Байқағаныңызға қуаныштымын.
Dialogue: 0,0:30:21.48,0:30:22.61,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:30:23.11,0:30:25.32,Default,,0,0,0,,Мен, Нобита Ноби, сен ше?
Dialogue: 0,0:30:25.78,0:30:28.36,Default,,0,0,0,,Поко... аа... уф!
Dialogue: 0,0:30:29.20,0:30:32.28,Default,,0,0,0,,Аа, сіз әлі қалпына келген жоқсыз.
Dialogue: 0,0:30:32.41,0:30:34.41,Default,,0,0,0,,Ана ше? Анама не болды?
Dialogue: 0,0:30:34.54,0:30:35.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:35.41,0:30:37.66,Default,,0,0,0,,Анамды дроид сарбаздары тұтқынға алды.
Dialogue: 0,0:30:38.04,0:30:39.92,Default,,0,0,0,,Мен саған көмектесуім керек (Нобита) Ой, сәл күте тұр!
Dialogue: 0,0:30:40.04,0:30:42.46,Default,,0,0,0,,Бұл мүмкін емес, Поко.
Dialogue: 0,0:30:43.04,0:30:44.84,Default,,0,0,0,,Жалғыз қолыңнан келмесе
Dialogue: 0,0:30:44.96,0:30:47.63,Default,,0,0,0,,Жібер! Жібер...
Dialogue: 0,0:30:47.76,0:30:51.05,Default,,0,0,0,,Ах! Капек мырза!
Dialogue: 0,0:30:53.10,0:30:56.18,Default,,0,0,0,,Өйткені әлі қалпына келмесем де өзімді итеріп жібердім.
Dialogue: 0,0:30:57.14,0:30:58.64,Default,,0,0,0,,Денемнің қатып қалатынына ешқандай белгі болмады…
Dialogue: 0,0:30:59.02,0:31:01.23,Default,,0,0,0,,Сонымен Поконың анасы туралы не деуге болады?
Dialogue: 0,0:31:01.35,0:31:02.98,Default,,0,0,0,,Ол өзгертілген болуы мүмкін.
Dialogue: 0,0:31:03.36,0:31:05.44,Default,,0,0,0,,Қорқынышты қорқынышты
Dialogue: 0,0:31:06.53,0:31:07.82,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:31:22.54,0:31:23.38,Default,,0,0,0,,Ашық
Dialogue: 0,0:31:27.13,0:31:28.21,Default,,0,0,0,,О, босс.
Dialogue: 0,0:31:28.67,0:31:32.26,Default,,0,0,0,,Құрметті Жанна, Поко... Покоға не болды?
Dialogue: 0,0:31:33.80,0:31:36.01,Default,,0,0,0,,Маған не болатыны маңызды емес.
Dialogue: 0,0:31:36.14,0:31:39.10,Default,,0,0,0,,Поконы сағынып жіберіңізші, өтінемін.
Dialogue: 0,0:31:39.64,0:31:40.77,Default,,0,0,0,,Шулы!
Dialogue: 0,0:31:40.89,0:31:44.27,Default,,0,0,0,,Құрметті Жанна, сіз қателесесіз.
Dialogue: 0,0:31:44.40,0:31:47.03,Default,,0,0,0,,Роботтарды қарапайым құралға айналдырайық...
Dialogue: 0,0:31:47.48,0:31:49.49,Default,,0,0,0,,Ояныңыз
Dialogue: 0,0:31:49.90,0:31:53.11,Default,,0,0,0,,Аузыңды жап. Сіз робот болсаңыз да, адамсыз...
Dialogue: 0,0:31:54.20,0:31:55.41,Default,,0,0,0,,Жанна!
Dialogue: 0,0:31:56.20,0:31:57.91,Default,,0,0,0,,Құрметті Жанна!
Dialogue: 0,0:31:59.20,0:32:01.37,Default,,0,0,0,,Бұл бөлмеге ешкімді кіргізбеңіз!
Dialogue: 0,0:32:06.79,0:32:09.09,Default,,0,0,0,,Мария мен Поко
Dialogue: 0,0:32:09.21,0:32:12.59,Default,,0,0,0,,Осы екеуіне қатысты бірдеңе істеуіміз керек.
Dialogue: 0,0:32:16.80,0:32:20.14,Default,,0,0,0,,Робби мама қайтып келді.
Dialogue: 0,0:32:20.52,0:32:22.10,Default,,0,0,0,,Лобби!
Dialogue: 0,0:32:23.10,0:32:24.23,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:32:24.35,0:32:26.56,Default,,0,0,0,,Сіз қайда болдыңыз? лобби
Dialogue: 0,0:32:27.48,0:32:31.40,Default,,0,0,0,,Мен робот X-01 типті жұмыс істеймін
Dialogue: 0,0:32:31.53,0:32:33.66,Default,,0,0,0,,Қандай Нарито, Шин Шицукекудасай
Dialogue: 0,0:32:34.53,0:32:38.99,Default,,0,0,0,,Доппен ойнайық. Барайық!
Dialogue: 0,0:32:39.12,0:32:40.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:41.70,0:32:43.16,Default,,0,0,0,,Лобби?
Dialogue: 0,0:32:44.08,0:32:47.88,Default,,0,0,0,,Мен робот X-01 типті өліммен жұмыс істеймін
Dialogue: 0,0:32:48.00,0:32:50.25,Default,,0,0,0,,Қандай Нарито, Шин Шицукекудасай
Dialogue: 0,0:32:51.38,0:32:56.68,Default,,0,0,0,,Робби ана... Мама!
Dialogue: 0,0:32:56.89,0:32:58.81,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:33:00.22,0:33:01.72,Default,,0,0,0,,Ол еш жерде жоқ.
Dialogue: 0,0:33:01.85,0:33:03.10,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,0:33:03.60,0:33:06.15,Default,,0,0,0,,Мен анамды іздедім.
Dialogue: 0,0:33:06.27,0:33:07.19,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:33:07.31,0:33:09.57,Default,,0,0,0,,Сарайға бет алған шығар.
Dialogue: 0,0:33:10.07,0:33:13.03,Default,,0,0,0,,Мен оны жалғыз қалдыра алмаймын, тіпті Poco да өзгертіледі.
Dialogue: 0,0:33:13.90,0:33:14.74,Default,,0,0,0,,Тезірек барайық
Dialogue: 0,0:33:14.86,0:33:16.86,Default,,0,0,0,,Куруринпа сізге жол көрсетсін
Dialogue: 0,0:33:16.99,0:33:18.24,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:33:20.37,0:33:22.20,Default,,0,0,0,,Аа, сәл күте тұрыңыз (5 адам) Иә?
Dialogue: 0,0:33:22.62,0:33:25.12,Default,,0,0,0,,Бұл киім мені күдіктендіреді.
Dialogue: 0,0:33:25.21,0:33:27.63,Default,,0,0,0,,Киім камерасы!
Dialogue: 0,0:33:27.92,0:33:29.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:30.63,0:33:31.55,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:33:32.46,0:33:33.46,Default,,0,0,0,,Уау (Сунео) Түсінді ме?
Dialogue: 0,0:33:35.38,0:33:38.47,Default,,0,0,0,,Болды, кеттік
Dialogue: 0,0:33:38.85,0:33:40.93,Default,,0,0,0,,Оу!
Dialogue: 0,0:34:11.92,0:34:13.55,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:34:14.09,0:34:18.55,Default,,0,0,0,,Мен F-01 типті үй қызметшісімін
Dialogue: 0,0:34:19.93,0:34:22.93,Default,,0,0,0,,(Ит роботының үруі)
Dialogue: 0,0:34:23.85,0:34:24.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:30.02,0:34:32.27,Default,,0,0,0,,Өңделмеген робот табылды
Dialogue: 0,0:34:35.19,0:34:38.03,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:34:44.66,0:34:45.75,Default,,0,0,0,,Ei
Dialogue: 0,0:34:53.84,0:34:54.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:02.18,0:35:03.26,Default,,0,0,0,,Уф!
Dialogue: 0,0:35:03.89,0:35:06.89,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:35:11.73,0:35:13.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:13.82,0:35:15.23,Default,,0,0,0,,Дораемон сол жерде
Dialogue: 0,0:35:15.36,0:35:16.03,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:35:18.36,0:35:19.78,Default,,0,0,0,,Кез келген қару бар ма?
Dialogue: 0,0:35:19.90,0:35:22.24,Default,,0,0,0,,Хмм, бәрі оны тастап кеткен сияқты...
Dialogue: 0,0:35:22.70,0:35:24.74,Default,,0,0,0,,Нобир Ханд!
Dialogue: 0,0:35:25.24,0:35:26.70,Default,,0,0,0,,Бәрің күтіңдер.
Dialogue: 0,0:35:27.20,0:35:28.16,Default,,0,0,0,,Поко!
Dialogue: 0,0:35:30.62,0:35:31.96,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:35:32.96,0:35:34.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:34.84,0:35:37.46,Default,,0,0,0,,Бұл жұмыс істеді, мықтап ұстаңыз
Dialogue: 0,0:35:37.59,0:35:38.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:35:38.55,0:35:39.38,Default,,0,0,0,,Әй, Дораемон!
Dialogue: 0,0:35:40.05,0:35:41.84,Default,,0,0,0,,Поко…
Dialogue: 0,0:35:41.97,0:35:43.51,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:35:44.80,0:35:46.22,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:35:46.35,0:35:48.06,Default,,0,0,0,,Осылай қалса жаман.
Dialogue: 0,0:35:49.02,0:35:50.56,Default,,0,0,0,,Жүгірмесең, бәрі өлтіріледі.
Dialogue: 0,0:35:50.69,0:35:52.69,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:35:52.81,0:35:57.69,Default,,0,0,0,,(Дораэмонның ыңырсыуы)
Dialogue: 0,0:36:12.00,0:36:14.42,Default,,0,0,0,,Жібер, жібер!
Dialogue: 0,0:36:14.54,0:36:15.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:15.54,0:36:20.09,Default,,0,0,0,,Мен мұндай нәрсе істегенім есімде жоқ. Мені жіберіңізші!
Dialogue: 0,0:36:20.63,0:36:22.13,Default,,0,0,0,,Вача вача жаңа...
Dialogue: 0,0:36:22.26,0:36:23.63,Default,,0,0,0,,Ухья Ухья Ухя…
Dialogue: 0,0:36:23.76,0:36:25.05,Default,,0,0,0,,Уау! Ара...
Dialogue: 0,0:36:26.18,0:36:28.81,Default,,0,0,0,,Енді не істейміз? Ауырмайды ма?
Dialogue: 0,0:36:28.93,0:36:30.31,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:36:31.27,0:36:33.27,Default,,0,0,0,,Бұл планетаның роботы емес.
Dialogue: 0,0:36:33.85,0:36:36.73,Default,,0,0,0,,Ракон тәрізді робот қайдан шықты?
Dialogue: 0,0:36:36.94,0:36:40.23,Default,,0,0,0,,Ракон ит емес! Мен мысық роботпын
Dialogue: 0,0:36:40.36,0:36:41.86,Default,,0,0,0,,Ju!
Dialogue: 0,0:36:41.99,0:36:44.16,Default,,0,0,0,,Маған жауап берме
Dialogue: 0,0:36:44.74,0:36:48.62,Default,,0,0,0,,Роботтар адамдардың адал қызметшілері болуы керек.
Dialogue: 0,0:36:49.58,0:36:51.33,Default,,0,0,0,,Мен Жерденмін
Dialogue: 0,0:36:51.45,0:36:54.08,Default,,0,0,0,,Мұндай ереже маңызды емес.
Dialogue: 0,0:36:54.42,0:36:57.00,Default,,0,0,0,,Жер туралы не деуге болады? Мен бұл туралы ешқашан естіген емеспін
Dialogue: 0,0:36:57.79,0:37:01.88,Default,,0,0,0,,Бұл галактиканың шетіндегі шаң немесе тұнба тәрізді жұлдыз шығар.
Dialogue: 0,0:37:02.05,0:37:06.59,Default,,0,0,0,,Бұл дұрыс емес. Бұл планетадан әлдеқайда әдемі.
Dialogue: 0,0:37:07.22,0:37:08.51,Default,,0,0,0,,Хмм... Дұрыс.
Dialogue: 0,0:37:08.93,0:37:14.14,Default,,0,0,0,,Жер роботтарының өнімділігін тексерейік.
Dialogue: 0,0:37:14.27,0:37:15.10,Default,,0,0,0,,Иә...
Dialogue: 0,0:37:15.65,0:37:17.52,Default,,0,0,0,,Ертеңгі күнді асыға күт
Dialogue: 0,0:37:18.19,0:37:20.36,Default,,0,0,0,,Оған дейін оны балауызда сақтаңыз.
Dialogue: 0,0:37:20.48,0:37:21.98,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:37:22.11,0:37:25.53,Default,,0,0,0,,Уау! Сен не істеп жатырсың? Жіберу!
Dialogue: 0,0:37:29.41,0:37:31.45,Default,,0,0,0,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:37:31.79,0:37:33.96,Default,,0,0,0,,Мен Жерденмін.
Dialogue: 0,0:37:34.08,0:37:35.37,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:37:37.92,0:37:39.17,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:37:39.29,0:37:41.09,Default,,0,0,0,,Мұқият ұстаңыз!
Dialogue: 0,0:37:41.71,0:37:42.55,Default,,0,0,0,,Мен тастап кеткен құралдар—
Dialogue: 0,0:37:43.38,0:37:45.01,Default,,0,0,0,,Уау, мен таң қалдым.
Dialogue: 0,0:37:46.01,0:37:47.26,Default,,0,0,0,,I Дораемон
Dialogue: 0,0:37:47.43,0:37:50.18,Default,,0,0,0,,Жерде туылған мысық тәрізді робот.
Dialogue: 0,0:37:50.30,0:37:52.60,Default,,0,0,0,,Бұл, әрине, енот ит емес.
Dialogue: 0,0:37:52.72,0:37:53.47,Default,,0,0,0,,Мен...
Dialogue: 0,0:37:54.14,0:37:56.06,Default,,0,0,0,,Мүмкін Поко шығар?
Dialogue: 0,0:37:56.60,0:37:59.11,Default,,0,0,0,,Поко! Сіз Покоды білесіз бе?
Dialogue: 0,0:37:59.23,0:38:00.06,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:38:00.48,0:38:02.53,Default,,0,0,0,,Бала жақсы ма?
Dialogue: 0,0:38:02.82,0:38:04.82,Default,,0,0,0,,бұл... Иә, қауіпсіз.
Dialogue: 0,0:38:06.03,0:38:07.57,Default,,0,0,0,,Жақсы
Dialogue: 0,0:38:07.70,0:38:09.16,Default,,0,0,0,,Уау, мен таң қалдым.
Dialogue: 0,0:38:12.62,0:38:13.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:14.29,0:38:16.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:47.19,0:38:48.36,Default,,0,0,0,,Әке
Dialogue: 0,0:38:57.33,0:39:02.13,Default,,0,0,0,,Жанна-саманың әкесі, алдыңғы патша Эйтом-сама,
Dialogue: 0,0:39:02.25,0:39:05.17,Default,,0,0,0,,Адамдар мен роботтардың бірге жұмыс істеуі
Dialogue: 0,0:39:05.42,0:39:09.05,Default,,0,0,0,,Бұл планетаны байыту идеясы болды.
Dialogue: 0,0:39:09.72,0:39:12.26,Default,,0,0,0,,Мен Жаннаның қамқоршысымын.
Dialogue: 0,0:39:12.39,0:39:13.22,Default,,0,0,0,,Иә
Dialogue: 0,0:39:13.35,0:39:16.39,Default,,0,0,0,,Жанна жас кезінде анасынан айырылды.
Dialogue: 0,0:39:16.52,0:39:20.27,Default,,0,0,0,,Мен Покомен бірге ойнадым.
Dialogue: 0,0:39:21.35,0:39:26.82,Default,,0,0,0,,Атом патша қаңырап бос жатқан шөлді аралап өтті.
Dialogue: 0,0:39:27.49,0:39:29.78,Default,,0,0,0,,Ол әзірлеуді өз қолына алды.
Dialogue: 0,0:39:48.17,0:39:49.26,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:39:49.59,0:39:51.72,Default,,0,0,0,,Мен күтпеген бақытсыздыққа ұшырадым.
Dialogue: 0,0:39:52.09,0:39:53.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:58.14,0:39:59.68,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:40:00.02,0:40:00.85,Default,,0,0,0,,Иә? (Атом патшасы) Ах!
Dialogue: 0,0:40:00.94,0:40:02.94,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,0:40:03.40,0:40:04.06,Default,,0,0,0,,Ах
Dialogue: 0,0:40:05.23,0:40:06.02,Default,,0,0,0,,Хе-хе-хе, дерлік. Мен екі күн бұрын ауруханадан шықтым.
Dialogue: 0,0:40:06.57,0:40:07.40,Default,,0,0,0,,Патша!
Dialogue: 0,0:40:07.94,0:40:08.61,Default,,0,0,0,,Әке!
Dialogue: 0,0:40:09.65,0:40:11.03,Default,,0,0,0,,Қаш!
Dialogue: 0,0:40:12.57,0:40:14.03,Default,,0,0,0,,Патша!
Dialogue: 0,0:40:14.32,0:40:19.41,Default,,0,0,0,,Король Король Король…
Dialogue: 0,0:40:23.37,0:40:24.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:25.29,0:40:29.88,Default,,0,0,0,,Марқұм әкесінің орнына патша болған Жаннаға.
Dialogue: 0,0:40:30.42,0:40:34.84,Default,,0,0,0,,Командир Дестар шайтанның сөзін айтты.
Dialogue: 0,0:40:35.18,0:40:37.72,Default,,0,0,0,,үшінна робот кінәлі
Dialogue: 0,0:40:37.85,0:40:40.39,Default,,0,0,0,,Өйткені біздің ақыл-ойымыз адамдармен бірдей
Dialogue: 0,0:40:40.52,0:40:43.35,Default,,0,0,0,,Патша оны тастап кете алмады.
Dialogue: 0,0:40:44.02,0:40:47.82,Default,,0,0,0,,Жанна-сама адам болып өзгергеніндей роботқа айналды...
Dialogue: 0,0:40:48.27,0:40:49.78,Default,,0,0,0,,Хмм.
Dialogue: 0,0:40:50.48,0:40:52.70,Default,,0,0,0,,Мұң ешқашан жазылмаса да
Dialogue: 0,0:40:52.82,0:40:56.24,Default,,0,0,0,,Жанна-сама өз қателігін түсінсе...
Dialogue: 0,0:40:56.74,0:40:58.24,Default,,0,0,0,,Хмм.
Dialogue: 0,0:41:05.21,0:41:07.92,Default,,0,0,0,,Қатты! Папа!
Dialogue: 0,0:41:08.04,0:41:12.59,Default,,0,0,0,,Ұлы әке Ұлы әке қиын!
Dialogue: 0,0:41:13.30,0:41:14.47,Default,,0,0,0,,Өте жылдам
Dialogue: 0,0:41:14.59,0:41:16.05,Default,,0,0,0,,Не болды? Куруринпа
Dialogue: 0,0:41:16.47,0:41:17.43,Default,,0,0,0,,Do... Дораэмон
Dialogue: 0,0:41:17.55,0:41:20.60,Default,,0,0,0,,Папа Болат шайқасына қатысып жатқан сияқты.
Dialogue: 0,0:41:21.27,0:41:22.85,Default,,0,0,0,,Болат шайқасы үшін бе?
Dialogue: 0,0:41:22.98,0:41:24.35,Default,,0,0,0,,Бұл не? ол
Dialogue: 0,0:41:24.48,0:41:26.56,Default,,0,0,0,,Роботтар бір-бірімен соғыссын
Dialogue: 0,0:41:26.77,0:41:28.15,Default,,0,0,0,,Не!
Dialogue: 0,0:41:28.27,0:41:29.52,Default,,0,0,0,,Джан, кеттік
Dialogue: 0,0:41:29.65,0:41:32.36,Default,,0,0,0,,О! Куруринпа, өтінемін, мені сонда бағыттаңыз.
Dialogue: 0,0:41:32.49,0:41:36.49,Default,,0,0,0,,(барабан орамы)
Dialogue: 0,0:41:54.59,0:41:57.59,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:42:02.01,0:42:05.56,Default,,0,0,0,,Ағымдағы матч - Фокс Форстың жеңісі.
Dialogue: 0,0:42:06.27,0:42:08.31,Default,,0,0,0,,Егер жоғалтсаңыз, оны тастаңыз
Dialogue: 0,0:42:08.44,0:42:09.61,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:42:09.73,0:42:11.44,Default,,0,0,0,,Шынымен, мен оны кешіре алмаймын.
Dialogue: 0,0:42:11.57,0:42:13.78,Default,,0,0,0,,Қараңызшы (4 адам) Иә?
Dialogue: 0,0:42:14.24,0:42:17.74,Default,,0,0,0,,Бұл Жанна, ал оның қасында Дестар.
Dialogue: 0,0:42:17.95,0:42:22.12,Default,,0,0,0,,Құрметті Жанна, келесі шайқас көретін нәрсе болады.
Dialogue: 0,0:42:22.24,0:42:22.91,Default,,0,0,0,,Иә
Dialogue: 0,0:42:23.29,0:42:26.87,Default,,0,0,0,,(Фанфар)
Dialogue: 0,0:42:29.00,0:42:30.83,Default,,0,0,0,,Бүгінгі басты оқиға
Dialogue: 0,0:42:31.25,0:42:34.42,Default,,0,0,0,,Ол алыс галактикадан келді.
Dialogue: 0,0:42:34.55,0:42:38.09,Default,,0,0,0,,Жердің өкілі робот! (Дораэмонның айқайлаған дауысы)
Dialogue: 0,0:42:38.22,0:42:40.22,Default,,0,0,0,,Жібер, жібер.
Dialogue: 0,0:42:40.30,0:42:41.60,Default,,0,0,0,,Дораемон! Жіберу!
Dialogue: 0,0:42:43.68,0:42:47.27,Default,,0,0,0,,Ой, не істеп жатырсың?
Dialogue: 0,0:42:47.39,0:42:48.69,Default,,0,0,0,,Ой, уау
Dialogue: 0,0:42:49.56,0:42:50.60,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:42:50.73,0:42:53.90,Default,,0,0,0,,Қазір келсем жаман болар еді. Мүмкіндікті күтіңіз.
Dialogue: 0,0:42:55.48,0:42:59.86,Default,,0,0,0,,Коната, 300 болат шайқастың жеңілмеген жауынгері
Dialogue: 0,0:43:00.61,0:43:04.49,Default,,0,0,0,,Конг жауынгері!
Dialogue: 0,0:43:08.41,0:43:09.54,Default,,0,0,0,,(Конг жауынгері айқайлайды)
Dialogue: 0,0:43:10.42,0:43:11.92,Default,,0,0,0,,Ол L-дің атын білген бойда мен тергеу штабын түгел жоямын.
Dialogue: 0,0:43:12.04,0:43:13.88,Default,,0,0,0,,Дора-чанның қаруы жоқ.
Dialogue: 0,0:43:14.00,0:43:14.67,Default,,0,0,0,,Дүрбелеңге түспеңіз
Dialogue: 0,0:43:15.75,0:43:17.13,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:43:17.84,0:43:20.26,Default,,0,0,0,,Сонымен... бұл өте үлкен.
Dialogue: 0,0:43:20.76,0:43:23.22,Default,,0,0,0,,Steel Battle матчы басталады!
Dialogue: 0,0:43:23.47,0:43:27.68,Default,,0,0,0,,(Фанфар және Гонг)
Dialogue: 0,0:43:27.93,0:43:30.14,Default,,0,0,0,,Уау! Ухо Ухо Ухо Ухо
Dialogue: 0,0:43:30.48,0:43:33.11,Default,,0,0,0,,Уау... Хмф!
Dialogue: 0,0:43:33.40,0:43:35.61,Default,,0,0,0,,Чанбара Яна
Dialogue: 0,0:43:36.73,0:43:39.82,Default,,0,0,0,,Соңында соққы алмасқан адамның сен болғаныңа қуаныштымын
Dialogue: 0,0:43:40.07,0:43:41.28,Default,,0,0,0,,Уау
Dialogue: 0,0:43:43.07,0:43:44.24,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:43:44.37,0:43:47.12,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:43:47.45,0:43:49.66,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,0:43:52.96,0:43:53.79,Default,,0,0,0,,Раббым!
Dialogue: 0,0:43:54.67,0:43:56.25,Default,,0,0,0,,Иә... гах
Dialogue: 0,0:43:56.88,0:43:58.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:43:58.84,0:44:00.38,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:44:00.47,0:44:02.89,Default,,0,0,0,,Ештеңе жоқ па? Ештеңе жоқ па? Ештеңе жоқ па?
Dialogue: 0,0:44:03.01,0:44:03.84,Default,,0,0,0,,Міне!
Dialogue: 0,0:44:04.43,0:44:06.76,Default,,0,0,0,,Уақыты белгіленген ақымақ оқ!
Dialogue: 0,0:44:07.31,0:44:09.64,Default,,0,0,0,,Уақытты белгілеңіз... Эй!
Dialogue: 0,0:44:09.85,0:44:10.98,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:44:11.27,0:44:13.94,Default,,0,0,0,,Ах... Уф! Ах
Dialogue: 0,0:44:20.28,0:44:22.11,Default,,0,0,0,,Сүйікті бар
Dialogue: 0,0:44:22.24,0:44:23.61,Default,,0,0,0,,Аспалы қалам
Dialogue: 0,0:44:24.45,0:44:27.08,Default,,0,0,0,,♪ Менің басым жылтыр...
Dialogue: 0,0:44:27.16,0:44:29.75,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:44:30.04,0:44:33.71,Default,,0,0,0,,Хмм, Kong Fighter-ді арандату...
Dialogue: 0,0:44:34.33,0:44:36.17,Default,,0,0,0,,Бұл уақытпен белгіленген ақымақ оқ.
Dialogue: 0,0:44:36.54,0:44:40.01,Default,,0,0,0,,Сен мені мазақ етіп тұрсың ба? Хмф!
Dialogue: 0,0:44:40.09,0:44:41.92,Default,,0,0,0,,♪ Дораемон...
Dialogue: 0,0:44:42.05,0:44:44.97,Default,,0,0,0,,Ха... уау!
Dialogue: 0,0:44:45.22,0:44:47.01,Default,,0,0,0,,Тоқта, ақымақ!
Dialogue: 0,0:44:47.14,0:44:48.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:48.68,0:44:50.47,Default,,0,0,0,,Бірдеңе бар ма? Бірдеңе бар ма?
Dialogue: 0,0:44:50.85,0:44:53.44,Default,,0,0,0,,Нағыз көшірме машинасы!
Dialogue: 0,0:44:53.56,0:44:55.69,Default,,0,0,0,,Ха ха ха... Соны көбейтіңіз.
Dialogue: 0,0:44:55.81,0:44:57.31,Default,,0,0,0,,Қараңызшы, мұнда да көбірек.
Dialogue: 0,0:44:57.44,0:44:59.32,Default,,0,0,0,,Көбейтуді және көшіруді жалғастырыңыз.
Dialogue: 0,0:44:59.44,0:45:00.61,Default,,0,0,0,,үшінмыз көшіріп алайық
Dialogue: 0,0:45:00.73,0:45:02.11,Default,,0,0,0,,Жоқ... не?!
Dialogue: 0,0:45:02.19,0:45:04.07,Default,,0,0,0,,Көбейту, көбейту, көбейту, а
Dialogue: 0,0:45:04.28,0:45:07.03,Default,,0,0,0,,Көбейту, көбейту, көбейту...
Dialogue: 0,0:45:07.53,0:45:08.49,Default,,0,0,0,,Не?
Dialogue: 0,0:45:08.74,0:45:11.16,Default,,0,0,0,,Егер бұл орын алса, бәрі бітеді!
Dialogue: 0,0:45:11.45,0:45:12.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:12.50,0:45:17.29,Default,,0,0,0,,Қараңдар! Уууу уау!
Dialogue: 0,0:45:17.42,0:45:19.67,Default,,0,0,0,,Уау Уау Уау
Dialogue: 0,0:45:19.80,0:45:23.88,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:45:24.01,0:45:25.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:25.18,0:45:29.76,Default,,0,0,0,,Урья! Ухо Ухо Дұрыс!
Dialogue: 0,0:45:29.89,0:45:31.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:31.85,0:45:34.44,Default,,0,0,0,,Хехехе, қалағаныңызша көбейте аласыз.
Dialogue: 0,0:45:34.64,0:45:36.35,Default,,0,0,0,,Бұл дәмді, Дораемон
Dialogue: 0,0:45:36.60,0:45:39.27,Default,,0,0,0,,Әтеш!
Dialogue: 0,0:45:39.65,0:45:42.86,Default,,0,0,0,,Қарғыс атсын! Мен оны бірден ұшырып жібердім.
Dialogue: 0,0:45:42.99,0:45:45.24,Default,,0,0,0,,Бірақ мен өз күнәларыммен осылай бетпе-бет келгенім…
Dialogue: 0,0:45:45.32,0:45:47.66,Default,,0,0,0,,Уау уау уау уау...
Dialogue: 0,0:45:47.99,0:45:49.99,Default,,0,0,0,,Уау, бұл ауырады!
Dialogue: 0,0:45:51.83,0:45:52.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:53.25,0:45:54.91,Default,,0,0,0,,Онда!
Dialogue: 0,0:45:55.25,0:45:56.37,Default,,0,0,0,,Уау
Dialogue: 0,0:45:56.46,0:46:00.38,Default,,0,0,0,,(Дораэмонның айқайы)
Dialogue: 0,0:46:00.50,0:46:02.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:46:02.96,0:46:05.17,Default,,0,0,0,,А, бірдеңе бар ма? Бірдеңе бар ма?
Dialogue: 0,0:46:06.55,0:46:08.30,Default,,0,0,0,,Қықылдаған бүрге!
Dialogue: 0,0:46:08.51,0:46:11.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:46:12.22,0:46:13.06,Default,,0,0,0,,Уф!
Dialogue: 0,0:46:13.68,0:46:16.10,Default,,0,0,0,,Мугю Уау...
Dialogue: 0,0:46:16.23,0:46:16.89,Default,,0,0,0,,Әй?
Dialogue: 0,0:46:17.52,0:46:21.27,Default,,0,0,0,,Сәлем! Уф!
Dialogue: 0,0:46:21.65,0:46:24.28,Default,,0,0,0,,Уау... Уууу
Dialogue: 0,0:46:24.49,0:46:28.36,Default,,0,0,0,,Ихи уһ уху хахахаха
Dialogue: 0,0:46:28.49,0:46:30.49,Default,,0,0,0,,Денемдегі қытықтай бүрге...
Dialogue: 0,0:46:30.62,0:46:34.54,Default,,0,0,0,,Кенет билеп, күліп, ақылсыз нәрсе істеп
Dialogue: 0,0:46:35.12,0:46:36.75,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:46:36.96,0:46:39.79,Default,,0,0,0,,Ахахаха хи хи хи
Dialogue: 0,0:46:39.92,0:46:41.71,Default,,0,0,0,,Не? Сіз мұны әлі де жасауға дайынсыз ба?
Dialogue: 0,0:46:42.09,0:46:44.17,Default,,0,0,0,,Хехехе
Dialogue: 0,0:46:46.05,0:46:47.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:46:47.59,0:46:49.72,Default,,0,0,0,,Нгон Нгонго…
Dialogue: 0,0:46:49.84,0:46:55.72,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:47:01.36,0:47:02.94,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:47:06.07,0:47:08.07,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:47:08.78,0:47:11.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:12.62,0:47:14.87,Default,,0,0,0,,Уау...
Dialogue: 0,0:47:15.33,0:47:16.58,Default,,0,0,0,,Угю…
Dialogue: 0,0:47:17.12,0:47:17.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:18.33,0:47:20.21,Default,,0,0,0,,Бұл жігіт керемет
Dialogue: 0,0:47:20.33,0:47:22.38,Default,,0,0,0,,Жеңімпаз - Жерде туылған робот...
Dialogue: 0,0:47:22.58,0:47:26.00,Default,,0,0,0,,Дораемон! Жоқ, жоқ, жоқ...
Dialogue: 0,0:47:27.46,0:47:29.01,Default,,0,0,0,,Дораемон жеңді!
Dialogue: 0,0:47:29.13,0:47:30.88,Default,,0,0,0,,Дораемон керемет.
Dialogue: 0,0:47:31.01,0:47:32.09,Default,,0,0,0,,Енді Полпо өлген соң, Буггарати әрекетке көшуі керек.
Dialogue: 0,0:47:35.01,0:47:36.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:47:36.35,0:47:39.81,Default,,0,0,0,,Кешіріңіз, Конг мырза, бірақ сіз шынымен күштірексіз.
Dialogue: 0,0:47:39.94,0:47:40.98,Default,,0,0,0,,Не?
Dialogue: 0,0:47:41.60,0:47:44.44,Default,,0,0,0,,Мен аздап айлакермін.
Dialogue: 0,0:47:45.07,0:47:47.48,Default,,0,0,0,,Жоқ, сен ақымақсың.
Dialogue: 0,0:47:47.61,0:47:48.90,Default,,0,0,0,,Иттің жоғалуы
Dialogue: 0,0:47:49.28,0:47:50.61,Default,,0,0,0,,Жалқау
Dialogue: 0,0:47:50.74,0:47:53.49,Default,,0,0,0,,Себебі менде қажетсіз эмоциялар пайда болды.
Dialogue: 0,0:47:53.62,0:47:56.83,Default,,0,0,0,,Жанна-сама, өзгертуге дереу тапсырыс беріңіз.
Dialogue: 0,0:47:56.95,0:48:00.46,Default,,0,0,0,,Жарайды, Конг истребителін модификация зауытына жіберіңіз.
Dialogue: 0,0:48:00.83,0:48:03.13,Default,,0,0,0,,Мүмкін ұлыңыз бар шығар?
Dialogue: 0,0:48:03.58,0:48:07.09,Default,,0,0,0,,Жанна-сама, бар болғаны... мені кешірші!
Dialogue: 0,0:48:07.59,0:48:09.46,Default,,0,0,0,,Нобита, қазір сенің мүмкіндігің.
Dialogue: 0,0:48:09.59,0:48:11.55,Default,,0,0,0,,Иә, солай!
Dialogue: 0,0:48:12.30,0:48:14.55,Default,,0,0,0,,Дораемон! Нобита-кун
Dialogue: 0,0:48:14.68,0:48:16.01,Default,,0,0,0,,Қазір қашайық (Нобита және басқалар) Иә.
Dialogue: 0,0:48:16.56,0:48:18.72,Default,,0,0,0,,Конгқа тез жетіңіз!
Dialogue: 0,0:48:19.89,0:48:21.31,Default,,0,0,0,,Бұл қорқынышты!
Dialogue: 0,0:48:21.44,0:48:22.19,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:48:22.64,0:48:24.10,Default,,0,0,0,,Не? Сіз
Dialogue: 0,0:48:24.23,0:48:25.31,Default,,0,0,0,,Тым өзімшіл
Dialogue: 0,0:48:25.44,0:48:28.15,Default,,0,0,0,,Роботтарды эмоциясыз ету үшін қалай өзгертуге болады?
Dialogue: 0,0:48:28.44,0:48:29.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:48:29.40,0:48:33.07,Default,,0,0,0,,Робот тек адамның соңынан еретін құрал болуы керек.
Dialogue: 0,0:48:33.57,0:48:36.03,Default,,0,0,0,,Жоқ! Дораэмон - бұл құрал емес
Dialogue: 0,0:48:36.66,0:48:37.99,Default,,0,0,0,,Достар!
Dialogue: 0,0:48:38.87,0:48:39.95,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:48:40.41,0:48:41.37,Default,,0,0,0,,Жанна!
Dialogue: 0,0:48:41.50,0:48:42.91,Default,,0,0,0,,Әй, Поко!
Dialogue: 0,0:48:43.50,0:48:46.13,Default,,0,0,0,,Роботтарды өзгертуді тоқтатыңыз!
Dialogue: 0,0:48:46.25,0:48:49.21,Default,,0,0,0,,Маған анамды қайтарыңыз! Өтінемін
Dialogue: 0,0:48:49.38,0:48:50.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:50.59,0:48:51.97,Default,,0,0,0,,Менің Poco
Dialogue: 0,0:48:52.09,0:48:55.14,Default,,0,0,0,,Күте тұрыңыз! Мен ол адамдарды ұстаймын.
Dialogue: 0,0:48:55.72,0:48:57.10,Default,,0,0,0,,Бәріміз қашайық
Dialogue: 0,0:48:57.76,0:48:59.56,Default,,0,0,0,,Сіз не істеп жатырсыз? Мені қу!
Dialogue: 0,0:49:02.43,0:49:03.10,Default,,0,0,0,,келді
Dialogue: 0,0:49:03.48,0:49:06.36,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Ж-жарай… бұл оның қарсы шыққаны ма?
Dialogue: 0,0:49:06.48,0:49:07.56,Default,,0,0,0,,(Ванिला Айс) Абдурды ұсақ-түйекке айналдырды.
Dialogue: 0,0:49:07.98,0:49:10.23,Default,,0,0,0,,Уф (Droid солдаты) Ах!
Dialogue: 0,0:49:10.61,0:49:12.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:49:12.40,0:49:14.45,Default,,0,0,0,,Мұны маған қалдырыңыз.
Dialogue: 0,0:49:14.57,0:49:15.61,Default,,0,0,0,,Рахмет
Dialogue: 0,0:49:15.74,0:49:16.99,Default,,0,0,0,,Хмф! Хмм
Dialogue: 0,0:49:21.08,0:49:22.33,Default,,0,0,0,,Poco…
Dialogue: 0,0:49:22.66,0:49:24.46,Default,,0,0,0,,Қай жерге жүгірсең де
Dialogue: 0,0:49:24.58,0:49:28.54,Default,,0,0,0,,Таратқыштан келетін радиотолқындарды орындаңыз
Dialogue: 0,0:49:28.67,0:49:30.34,Default,,0,0,0,,Окабе ше? Білмеймін. Мен өте бос болдым ғой.
Dialogue: 0,0:49:43.43,0:49:45.64,Default,,0,0,0,,Енді үйге қайтайық.
Dialogue: 0,0:49:46.02,0:49:48.15,Default,,0,0,0,,Поко қазір өзін жақсы сезінеді.
Dialogue: 0,0:49:48.27,0:49:50.61,Default,,0,0,0,,Поконың анасы не істейді?
Dialogue: 0,0:49:51.48,0:49:53.78,Default,,0,0,0,,Ол өзгертілген болуы мүмкін, солай ма?
Dialogue: 0,0:49:53.90,0:49:55.70,Default,,0,0,0,,Сунео-сан! (Сунео) А... аа
Dialogue: 0,0:49:57.24,0:49:58.91,Default,,0,0,0,,Өзгертілмеген
Dialogue: 0,0:49:59.12,0:50:00.03,Default,,0,0,0,,Уф… Ах…
Dialogue: 0,0:50:00.16,0:50:01.62,Default,,0,0,0,,Мен сені кездестірдім
Dialogue: 0,0:50:01.74,0:50:02.87,Default,,0,0,0,,Сіз анаңызды кездестірдіңіз бе?
Dialogue: 0,0:50:03.33,0:50:07.33,Default,,0,0,0,,Иә, мен қамауда болдым, бірақ мен сені уайымдадым.
Dialogue: 0,0:50:07.92,0:50:09.25,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:50:09.38,0:50:12.30,Default,,0,0,0,,Сунео, біз оны осылай қалдыра алмаймыз, солай ма?
Dialogue: 0,0:50:12.71,0:50:14.01,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,0:50:14.46,0:50:16.93,Default,,0,0,0,,үшінңызға рахмет
Dialogue: 0,0:50:19.01,0:50:21.89,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:50:22.39,0:50:25.14,Default,,0,0,0,,Жоқ, бұл дроид солдаты.
Dialogue: 0,0:50:26.02,0:50:28.35,Default,,0,0,0,,үшінна ерген сияқты.
Dialogue: 0,0:50:28.48,0:50:29.31,Default,,0,0,0,,Эх!
Dialogue: 0,0:50:30.02,0:50:31.98,Default,,0,0,0,,Тезірек бұл жерден кет!
Dialogue: 0,0:50:32.11,0:50:33.57,Default,,0,0,0,,Сен қайда қашасың?
Dialogue: 0,0:50:33.69,0:50:34.78,Default,,0,0,0,,Батысқа қарай жүріңіз
Dialogue: 0,0:50:35.44,0:50:38.24,Default,,0,0,0,,Шөл даланың арғы жағындағы адам жүзді жартасқа ұмтылыңыз.
Dialogue: 0,0:50:38.95,0:50:40.20,Default,,0,0,0,,Адамның беті жартас?
Dialogue: 0,0:50:40.49,0:50:41.32,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:50:41.45,0:50:42.66,Default,,0,0,0,,үшінмыз асығайық
Dialogue: 0,0:50:43.87,0:50:44.87,Default,,0,0,0,,Жарайды
Dialogue: 0,0:50:45.37,0:50:47.71,Default,,0,0,0,,Хмм, ол қозғала бастады.
Dialogue: 0,0:50:47.83,0:50:49.08,Default,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:50:49.96,0:50:51.29,Default,,0,0,0,,Құрметті Жанна
Dialogue: 0,0:50:51.42,0:50:55.05,Default,,0,0,0,,Поко мен бұл жігіттер батысқа қарай жабайы табиғатқа қарай бет алды.
Dialogue: 0,0:50:55.26,0:50:55.96,Default,,0,0,0,,Хмм
Dialogue: 0,0:50:56.09,0:50:59.93,Default,,0,0,0,,Енді әскерлеріңізді басқарып, Поконы басып алатын уақыт.
Dialogue: 0,0:51:00.05,0:51:00.72,Default,,0,0,0,,Ах
Dialogue: 0,0:51:00.97,0:51:04.43,Default,,0,0,0,,Асықпасаң, бәлеге қаласың.
Dialogue: 0,0:51:05.85,0:51:08.10,Default,,0,0,0,,Жарайды, мен кетемін.
Dialogue: 0,0:51:19.24,0:51:21.57,Default,,0,0,0,,Ах... Баспропеллер...
Dialogue: 0,0:51:22.07,0:51:23.12,Default,,0,0,0,,Менікі де
Dialogue: 0,0:51:23.24,0:51:25.04,Default,,0,0,0,,Амал жоқ, төмен түсейік.
Dialogue: 0,0:51:28.50,0:51:30.46,Default,,0,0,0,,Бұл жерден серуендеу
Dialogue: 0,0:51:30.58,0:51:33.04,Default,,0,0,0,,Аңғар түбінде жол таппайсың.
Dialogue: 0,0:51:33.34,0:51:35.25,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:51:35.38,0:51:39.22,Default,,0,0,0,,Батыс бұл... Куруринпат
Dialogue: 0,0:51:39.34,0:51:40.43,Default,,0,0,0,,Кочиппа
Dialogue: 0,0:51:40.55,0:51:43.47,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:51:48.27,0:51:51.14,Default,,0,0,0,,Батыста не болып жатыр?
Dialogue: 0,0:51:51.60,0:51:52.56,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:51:52.69,0:51:56.86,Default,,0,0,0,,Кемпірқосақ алқабы туралы анам айтып беретін бір әңгіме бар.
Dialogue: 0,0:51:57.53,0:51:59.61,Default,,0,0,0,,Кемпірқосақ аңғары туралы әңгіме?
Dialogue: 0,0:51:59.74,0:52:00.99,Default,,0,0,0,,Иә
Dialogue: 0,0:52:01.24,0:52:05.28,Default,,0,0,0,,Жұмыс істемейтін зымыран белгілі бір планетада шайып кетті.
Dialogue: 0,0:52:05.41,0:52:10.25,Default,,0,0,0,,Робот пен борттағы бала бірге батысқа қарай жүрді.
Dialogue: 0,0:52:11.12,0:52:14.13,Default,,0,0,0,,Басында бір-бірімізбен ұрысып қалатынбыз.
Dialogue: 0,0:52:14.25,0:52:18.88,Default,,0,0,0,,Бірте-бірте дос болдық, соңында күш біріктірдік.
Dialogue: 0,0:52:19.01,0:52:23.51,Default,,0,0,0,,Бұл роботтар мен адамдар арасындағы утопия құру туралы әңгіме.
Dialogue: 0,0:52:25.18,0:52:27.56,Default,,0,0,0,,Ол жер Кемпірқосақ алқабы деп аталады.
Dialogue: 0,0:52:27.68,0:52:30.31,Default,,0,0,0,,Иә, Радуга алқабы?
Dialogue: 0,0:52:30.43,0:52:32.60,Default,,0,0,0,,Бірақ бұл оқиға, солай емес пе?
Dialogue: 0,0:52:33.14,0:52:37.57,Default,,0,0,0,,Егер сіз мұндай жерге тамақсыз, сусыз саяхаттасаңыз, сіз өлесіз.
Dialogue: 0,0:52:39.69,0:52:40.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:52:49.16,0:52:51.54,Default,,0,0,0,,Бұл үлкен құмды дауылға айналды.
Dialogue: 0,0:52:51.66,0:52:53.87,Default,,0,0,0,,Сізде құралдар жоқ па?
Dialogue: 0,0:52:54.42,0:52:57.09,Default,,0,0,0,,Мен мұнымен алға жылжи алмаймын.
Dialogue: 0,0:52:57.21,0:52:58.84,Default,,0,0,0,,Бірдеңе істе!
Dialogue: 0,0:52:59.55,0:53:02.55,Default,,0,0,0,,үшінна сәттілік
Dialogue: 0,0:53:09.01,0:53:10.27,Default,,0,0,0,,Мен осында түстім.
Dialogue: 0,0:53:13.64,0:53:15.69,Default,,0,0,0,,Хмм, жақын.
Dialogue: 0,0:53:20.61,0:53:23.74,Default,,0,0,0,,Дораемон Мен бір қадам алға қарай алмаймын.
Dialogue: 0,0:53:23.86,0:53:26.11,Default,,0,0,0,,Сунео Джан
Dialogue: 0,0:53:26.32,0:53:28.20,Default,,0,0,0,,Артық емес
Dialogue: 0,0:53:28.33,0:53:31.37,Default,,0,0,0,,Бәрің бір-біріңді қалдырмай кетіңдер!
Dialogue: 0,0:53:31.49,0:53:32.33,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:53:32.45,0:53:36.46,Default,,0,0,0,,(үшін айғайлайды)
Dialogue: 0,0:53:40.71,0:53:41.71,Default,,0,0,0,,Я...
Dialogue: 0,0:53:42.80,0:53:44.13,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,0:53:44.26,0:53:45.68,Default,,0,0,0,,үшін жақсы ма?
Dialogue: 0,0:53:45.80,0:53:47.43,Default,,0,0,0,,Әйтеуір жақсы
Dialogue: 0,0:53:48.01,0:53:51.97,Default,,0,0,0,,Чапек айтқан адам жүзді жартасқа жету үшін барымызды салайық.
Dialogue: 0,0:53:52.10,0:53:53.89,Default,,0,0,0,,Куруринпа қай жаққа қарай батыс?
Dialogue: 0,0:53:54.14,0:53:55.52,Default,,0,0,0,,Курурин тақтасы
Dialogue: 0,0:53:55.64,0:53:56.85,Default,,0,0,0,,Кочиппа
Dialogue: 0,0:53:57.44,0:53:59.06,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:53:59.19,0:54:01.23,Default,,0,0,0,,Біраз қорқынышты, иә?
Dialogue: 0,0:54:07.41,0:54:09.74,Default,,0,0,0,,Жалғастырыңыз! Бұл түзу!
Dialogue: 0,0:54:14.79,0:54:15.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:54:18.50,0:54:21.00,Default,,0,0,0,,Жартас... бұл қауіпті болды.
Dialogue: 0,0:54:21.59,0:54:22.25,Default,,0,0,0,,Не!
Dialogue: 0,0:54:22.38,0:54:24.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:54:25.01,0:54:26.09,Default,,0,0,0,,Ах
Dialogue: 0,0:54:26.26,0:54:28.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:54:30.55,0:54:32.76,Default,,0,0,0,,Хехе...
Dialogue: 0,0:54:32.89,0:54:35.31,Default,,0,0,0,,Енді бұл планета менікі
Dialogue: 0,0:54:35.43,0:54:38.60,Default,,0,0,0,,үшінн командалар бойынша орындайтын роботты ұйымдастырыңыз.
Dialogue: 0,0:54:39.23,0:54:42.57,Default,,0,0,0,,Мен ең күшті роботтар патшалығын саламын.
Dialogue: 0,0:54:42.86,0:54:47.32,Default,,0,0,0,,Фухахаха...
Dialogue: 0,0:54:47.78,0:54:50.70,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:54:50.82,0:54:52.49,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,0:54:52.66,0:54:55.50,Default,,0,0,0,,Дораемон... Мен шөлдедім...
Dialogue: 0,0:54:56.00,0:54:58.46,Default,,0,0,0,,Енді жоқ, Нобита-кун, уау!
Dialogue: 0,0:54:59.12,0:55:00.42,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:55:02.50,0:55:05.26,Default,,0,0,0,,Оны еш жерде айта алмайсың ба?
Dialogue: 0,0:55:05.38,0:55:07.59,Default,,0,0,0,,Егер менде болса, мен оны әлдеқашан жіберер едім.
Dialogue: 0,0:55:07.76,0:55:10.09,Default,,0,0,0,,Бұл дұрыс, бірақ ...
Dialogue: 0,0:55:20.56,0:55:26.53,Default,,0,0,0,,(таратқыштың дыбысы)
Dialogue: 0,0:55:29.45,0:55:30.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:55:34.24,0:55:36.54,Default,,0,0,0,,Артық емес... енді жоқ
Dialogue: 0,0:55:36.66,0:55:39.25,Default,,0,0,0,,Мен де басқа қадам баса алмаймын.
Dialogue: 0,0:55:39.37,0:55:41.12,Default,,0,0,0,,Мен де
Dialogue: 0,0:55:41.25,0:55:43.63,Default,,0,0,0,,Мен енді мұны істей алмаймын ...
Dialogue: 0,0:55:43.75,0:55:45.38,Default,,0,0,0,,үшінң, берік болыңдар!
Dialogue: 0,0:55:45.96,0:55:48.38,Default,,0,0,0,,Куруринпа Батыс?
Dialogue: 0,0:55:48.51,0:55:49.34,Default,,0,0,0,,Кочиппа
Dialogue: 0,0:55:49.72,0:55:51.30,Default,,0,0,0,,Папа Папа Папа
Dialogue: 0,0:55:51.68,0:55:52.76,Default,,0,0,0,,Не болды?
Dialogue: 0,0:55:52.89,0:55:56.39,Default,,0,0,0,,Әй, адам жүзді жартас!
Dialogue: 0,0:55:58.31,0:55:59.98,Default,,0,0,0,,үшін оянады
Dialogue: 0,0:56:00.10,0:56:03.61,Default,,0,0,0,,Куруринпа Біз қозғала аламыз, барлығымызды көтеріп алайық
Dialogue: 0,0:56:03.73,0:56:07.73,Default,,0,0,0,,Иә, сол үңгірдің ішіне кір.
Dialogue: 0,0:56:08.86,0:56:12.24,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:56:12.36,0:56:14.20,Default,,0,0,0,,...
Dialogue: 0,0:56:16.95,0:56:19.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:21.83,0:56:25.00,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:56:29.30,0:56:31.59,Default,,0,0,0,,Бөлініп, су іздейік
Dialogue: 0,0:56:32.26,0:56:34.30,Default,,0,0,0,,Куруринпа үңгірдің артына барады.
Dialogue: 0,0:56:34.43,0:56:36.39,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:56:36.85,0:56:40.27,Default,,0,0,0,,Поко төменгі жағында, мен жоғарыдан қараймын.
Dialogue: 0,0:56:40.39,0:56:41.23,Default,,0,0,0,,Иә
Dialogue: 0,0:56:41.98,0:56:43.69,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:56:44.52,0:56:49.53,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:56:51.86,0:56:55.70,Default,,0,0,0,,(Fat Gum) Егер оны қатты күшейтсек—
Dialogue: 0,0:57:18.56,0:57:20.72,Default,,0,0,0,,(Су дыбысы)
Dialogue: 0,0:57:20.85,0:57:23.44,Default,,0,0,0,,А, мінеки!
Dialogue: 0,0:57:23.94,0:57:25.90,Default,,0,0,0,,Кәдімгі шайнек!
Dialogue: 0,0:57:26.27,0:57:30.65,Default,,0,0,0,,Бір жақсысы, сізде әлі де қалыпты құралдар бар.
Dialogue: 0,0:57:34.20,0:57:35.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:45.75,0:57:47.29,Default,,0,0,0,,Әй, Жанна!
Dialogue: 0,0:57:49.59,0:57:50.71,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:57:57.34,0:57:58.43,Default,,0,0,0,,Га
Dialogue: 0,0:57:58.55,0:57:59.39,Default,,0,0,0,,Иә су
Dialogue: 0,0:57:59.80,0:58:01.14,Default,,0,0,0,,Ах... Рахмет...
Dialogue: 0,0:58:02.64,0:58:04.14,Default,,0,0,0,,Мен өмірге қайта оралдым
Dialogue: 0,0:58:04.27,0:58:05.31,Default,,0,0,0,,Ах~
Dialogue: 0,0:58:06.02,0:58:06.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:58:06.98,0:58:10.27,Default,,0,0,0,,Иә? Дораэмон Poko ше?
Dialogue: 0,0:58:10.40,0:58:12.40,Default,,0,0,0,,Мен су іздеуге бардым...
Dialogue: 0,0:58:12.78,0:58:14.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:17.95,0:58:21.20,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:58:27.71,0:58:28.79,Default,,0,0,0,,Сәлем Жанна
Dialogue: 0,0:58:28.92,0:58:31.21,Default,,0,0,0,,Енді сенің арқаңа мінетін кезегім.
Dialogue: 0,0:58:31.34,0:58:32.34,Default,,0,0,0,,Сәлем анашым
Dialogue: 0,0:58:33.25,0:58:35.84,Default,,0,0,0,,Иә, Жанна, мен сенің кезегіңді аламын.
Dialogue: 0,0:58:35.97,0:58:38.30,Default,,0,0,0,,Маған ұнамайды! Мәңгі осылай қал
Dialogue: 0,0:58:42.85,0:58:44.97,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:58:49.90,0:58:50.77,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:58:51.02,0:58:52.73,Default,,0,0,0,,60 ұпай ма… солай ма?
Dialogue: 0,0:58:53.53,0:58:58.66,Default,,0,0,0,,(Поко ентігу)
Dialogue: 0,0:59:01.03,0:59:02.62,Default,,0,0,0,,Бұл нәрсені жай қалдырыңыз.
Dialogue: 0,0:59:03.24,0:59:04.08,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:59:04.66,0:59:06.04,Default,,0,0,0,,Бұл жұмыс істемейді.
Dialogue: 0,0:59:06.54,0:59:08.75,Default,,0,0,0,,Енді не істеуім керек?
Dialogue: 0,0:59:08.87,0:59:10.04,Default,,0,0,0,,Хмм.
Dialogue: 0,0:59:10.17,0:59:12.00,Default,,0,0,0,,Айтпақшы, Куруринпа ше?
Dialogue: 0,0:59:12.38,0:59:13.75,Default,,0,0,0,,Осы тереңдікке
Dialogue: 0,0:59:13.88,0:59:15.00,Default,,0,0,0,,үшінна! Ах...
Dialogue: 0,0:59:15.13,0:59:17.42,Default,,0,0,0,,Куруринпа Мына жердің артына кел.
Dialogue: 0,0:59:17.76,0:59:19.30,Default,,0,0,0,,Кеттік (Нобита) Кеттік!
Dialogue: 0,0:59:19.43,0:59:20.68,Default,,0,0,0,,Жоқ... не болды?
Dialogue: 0,0:59:23.22,0:59:24.93,Default,,0,0,0,,...
Dialogue: 0,0:59:25.85,0:59:28.52,Default,,0,0,0,,Жер бетінде не бар?
Dialogue: 0,0:59:28.77,0:59:31.19,Default,,0,0,0,,Папа папа
Dialogue: 0,0:59:31.48,0:59:34.15,Default,,0,0,0,,Папа! Апыр-ай!
Dialogue: 0,0:59:34.48,0:59:36.11,Default,,0,0,0,,Осындай жерде...
Dialogue: 0,0:59:36.23,0:59:37.07,Default,,0,0,0,,Уау
Dialogue: 0,0:59:37.19,0:59:38.40,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:59:38.53,0:59:39.61,Default,,0,0,0,,Бұл не? Мен қайдамын?
Dialogue: 0,0:59:40.66,0:59:43.66,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:59:53.04,0:59:57.13,Default,,0,0,0,,Менің ойымша, бұл доктор Капек айтып отырған.
Dialogue: 0,0:59:57.26,0:59:58.59,Default,,0,0,0,,Ах
Dialogue: 0,0:59:59.55,1:00:02.01,Default,,0,0,0,,Сәлем Сәлем Сәлем
Dialogue: 0,1:00:03.01,1:00:03.97,Default,,0,0,0,,Сәлем
Dialogue: 0,1:00:04.80,1:00:06.43,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,1:00:06.85,1:00:07.85,Default,,0,0,0,,Уф...
Dialogue: 0,1:00:07.97,1:00:13.27,Default,,0,0,0,,Жанна әке... Әке...
Dialogue: 0,1:00:15.02,1:00:16.69,Default,,0,0,0,,Поко! аа...
Dialogue: 0,1:00:18.65,1:00:20.36,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,1:00:20.49,1:00:22.57,Default,,0,0,0,,Уф! Роботтарға...
Dialogue: 0,1:00:22.70,1:00:23.78,Default,,0,0,0,,Жанна-сама, не?
Dialogue: 0,1:00:24.49,1:00:26.12,Default,,0,0,0,,Сіз жарақат алдыңыз.
Dialogue: 0,1:00:26.20,1:00:29.58,Default,,0,0,0,,Ой... шулы Балалар сендер кімсіңдер?
Dialogue: 0,1:00:30.29,1:00:34.25,Default,,0,0,0,,Біз сіздің роботты өзгерту тапсырысыңызға қарсымыз...
Dialogue: 0,1:00:34.38,1:00:37.30,Default,,0,0,0,,Мен мұнда роботтармен бірге тұрамын.
Dialogue: 0,1:00:37.71,1:00:39.46,Default,,0,0,0,,Не? Уф...
Dialogue: 0,1:00:39.59,1:00:40.42,Default,,0,0,0,,Жанна!
Dialogue: 0,1:00:40.55,1:00:43.76,Default,,0,0,0,,Жібер! B...робот сияқты...
Dialogue: 0,1:00:44.47,1:00:46.10,Default,,0,0,0,,Бұл робот, сонда ше?
Dialogue: 0,1:00:46.64,1:00:50.02,Default,,0,0,0,,Робот менің мұңымды түсіне ала ма?
Dialogue: 0,1:00:50.31,1:00:51.77,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,1:00:51.89,1:00:54.31,Default,,0,0,0,,Мен Поконың жылап жатқанын көрдім.
Dialogue: 0,1:00:54.44,1:00:58.07,Default,,0,0,0,,Адам көз жасы мен адам көз жасының айырмашылығы неде?
Dialogue: 0,1:00:58.19,1:01:01.28,Default,,0,0,0,,Сізді осында алып келген Поко болды.
Dialogue: 0,1:01:01.94,1:01:03.49,Default,,0,0,0,,Роботтар...
Dialogue: 0,1:01:03.61,1:01:07.62,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:01:12.58,1:01:14.00,Default,,0,0,0,,Уф...
Dialogue: 0,1:01:19.09,1:01:21.51,Default,,0,0,0,,Жанна жоғалып кетті.
Dialogue: 0,1:01:21.63,1:01:22.84,Default,,0,0,0,,(Вассалдардың айқайы)
Dialogue: 0,1:01:22.97,1:01:27.10,Default,,0,0,0,,Сондықтан Патшалықтың заңдарында қарастырылғандай.
Dialogue: 0,1:01:27.22,1:01:29.97,Default,,0,0,0,,Мен уақытша басшы боламын.
Dialogue: 0,1:01:30.81,1:01:33.64,Default,,0,0,0,,Біреу қарсылық білдіре ме?
Dialogue: 0,1:01:34.31,1:01:39.32,Default,,0,0,0,,♪〜
Dialogue: 0,1:03:07.20,1:03:11.32,Default,,0,0,0,,Кемпірқосақ алқабының оқиғасы шындыққа жанасады.
Dialogue: 0,1:03:13.28,1:03:15.24,Default,,0,0,0,,Поко иә?
Dialogue: 0,1:03:16.16,1:03:17.91,Default,,0,0,0,,Мен қателестім
Dialogue: 0,1:03:18.04,1:03:19.75,Default,,0,0,0,,Әкең не істемек болды
Dialogue: 0,1:03:20.50,1:03:21.96,Default,,0,0,0,,Бұл сіздің айтқыңыз келген нәрсе.
Dialogue: 0,1:03:22.08,1:03:22.92,Default,,0,0,0,,Иә
Dialogue: 0,1:03:23.80,1:03:24.88,Default,,0,0,0,,Марияға көмектесейік
Dialogue: 0,1:03:25.59,1:03:29.72,Default,,0,0,0,,Ал әкем мақсат еткен роботтар патшалығын құрайық.
Dialogue: 0,1:03:29.84,1:03:30.68,Default,,0,0,0,,Иә
Dialogue: 0,1:03:31.18,1:03:32.55,Default,,0,0,0,,Хехе
Dialogue: 0,1:03:37.64,1:03:42.65,Default,,0,0,0,,〜♪
Dialogue: 0,1:03:50.53,1:03:52.24,Default,,0,0,0,,Жанна қайтып келді ме?
Dialogue: 0,1:03:52.32,1:03:55.20,Default,,0,0,0,,Дошимасука? Нұсқау құдасайға барыңыз
Dialogue: 0,1:03:55.58,1:03:57.58,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,1:03:57.70,1:03:59.12,Default,,0,0,0,,Жанна қайтыс болды
Dialogue: 0,1:03:59.62,1:04:00.58,Default,,0,0,0,,Жүріңіз
Dialogue: 0,1:04:00.92,1:04:02.21,Default,,0,0,0,,Кашико Маримашита
Dialogue: 0,1:04:02.33,1:04:04.67,Default,,0,0,0,,Оқудан шығару туралы нұсқаулар
Dialogue: 0,1:04:13.64,1:04:15.64,Default,,0,0,0,,Бұл Жанна, қақпаны аш.
Dialogue: 0,1:04:16.26,1:04:18.39,Default,,0,0,0,,Король Дестар бұйрығы
Dialogue: 0,1:04:18.52,1:04:20.10,Default,,0,0,0,,Наочини Тачичире
Dialogue: 0,1:04:20.60,1:04:22.56,Default,,0,0,0,,Король Дестар?
Dialogue: 0,1:04:23.40,1:04:28.99,Default,,0,0,0,,Түсінемін, сіз мені осы елді басып алу үшін басынан бастап пайдаланғыңыз келді.
Dialogue: 0,1:04:30.11,1:04:33.82,Default,,0,0,0,,Соконо роботы Тачи өзгертілген зауытқа жеткізілді
Dialogue: 0,1:04:33.95,1:04:34.91,Default,,0,0,0,,Эх!
Dialogue: 0,1:04:36.16,1:04:39.41,Default,,0,0,0,,Күте тұрыңыз! Роботты өзгерту тәртібі аяқталды.
Dialogue: 0,1:04:40.25,1:04:41.29,Default,,0,0,0,,Дестармен танысу
Dialogue: 0,1:04:41.79,1:04:44.08,Default,,0,0,0,,Адамдар
Dialogue: 0,1:04:44.21,1:04:46.04,Default,,0,0,0,,Командир Дестар шығарыңыз!
Dialogue: 0,1:04:46.17,1:04:47.46,Default,,0,0,0,,Маған анаммен танысуға рұқсат етіңіз
Dialogue: 0,1:04:48.13,1:04:49.42,Default,,0,0,0,,Шығарыңыз Оны алыңыз
Dialogue: 0,1:04:49.88,1:04:51.84,Default,,0,0,0,,Адамдар
Dialogue: 0,1:04:53.13,1:04:55.30,Default,,0,0,0,,Атыра алсаң, мені ат.
Dialogue: 0,1:04:55.68,1:04:58.10,Default,,0,0,0,,Адам... Жаса...
Dialogue: 0,1:04:58.22,1:05:00.18,Default,,0,0,0,,Бұл жігіттер адамды ата алмайды.
Dialogue: 0,1:05:00.52,1:05:03.19,Default,,0,0,0,,Адамдар...
Dialogue: 0,1:05:03.77,1:05:05.65,Default,,0,0,0,,Адам... Адам баласы...
Dialogue: 0,1:05:05.81,1:05:09.36,Default,,0,0,0,,Адамдар... Дододо... Адамдар...
Dialogue: 0,1:05:10.07,1:05:11.32,Default,,0,0,0,,Пайдасыз
Dialogue: 0,1:05:12.24,1:05:13.32,Default,,0,0,0,,Хмф! Ах!
Dialogue: 0,1:05:14.61,1:05:15.28,Default,,0,0,0,,Га
Dialogue: 0,1:05:15.82,1:05:19.95,Default,,0,0,0,,Мария, өзгертуден бұрын мұқият қараңыз.
Dialogue: 0,1:05:20.08,1:05:20.75,Default,,0,0,0,,Ах
Dialogue: 0,1:05:21.70,1:05:22.71,Default,,0,0,0,,Жанна Поко!
Dialogue: 0,1:05:23.08,1:05:24.67,Default,,0,0,0,,Соңғы шара
Dialogue: 0,1:05:25.21,1:05:26.13,Default,,0,0,0,,Уф...
Dialogue: 0,1:05:41.56,1:05:44.56,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,1:05:45.98,1:05:47.73,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,1:05:58.24,1:06:00.53,Default,,0,0,0,,Оны тікелей тиіп, жарып жіберген сол сым емес еді
Dialogue: 0,1:06:00.62,1:06:04.00,Default,,0,0,0,,Маған қарсы шыққандардың барлығын талқандаймын.
Dialogue: 0,1:06:06.46,1:06:09.29,Default,,0,0,0,,Қамал – алып робот...
Dialogue: 0,1:06:09.42,1:06:11.30,Default,,0,0,0,,Дораэмон Кіші жарық туралы не деуге болады?
Dialogue: 0,1:06:11.42,1:06:13.88,Default,,0,0,0,,Мен оны үлкен жарықпен тастадым.
Dialogue: 0,1:06:14.01,1:06:14.92,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,1:06:17.89,1:06:20.35,Default,,0,0,0,,Бізде де алып робот болса ғой
Dialogue: 0,1:06:22.47,1:06:23.22,Default,,0,0,0,,Иә.
Dialogue: 0,1:06:23.85,1:06:26.39,Default,,0,0,0,,Дорэмонның соджу машинасы ше?
Dialogue: 0,1:06:26.52,1:06:27.69,Default,,0,0,0,,Мен… осындай күйде телефон шала алмаймын.
Dialogue: 0,1:06:28.27,1:06:29.15,Default,,0,0,0,,Кез келген нәрсе...
Dialogue: 0,1:06:29.61,1:06:31.40,Default,,0,0,0,,Тазалау машинасымен не істеу керек?
Dialogue: 0,1:06:31.52,1:06:34.15,Default,,0,0,0,,Шизука-чан, сізде Баспропеллер үшін батарея әлі бар, солай ма?
Dialogue: 0,1:06:34.28,1:06:35.11,Default,,0,0,0,,Иә
Dialogue: 0,1:06:36.61,1:06:37.57,Default,,0,0,0,,Мен оны қарызға аламын.
Dialogue: 0,1:06:38.07,1:06:39.07,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:06:39.20,1:06:41.12,Default,,0,0,0,,Нобита-кун, қайда бара жатырсың?
Dialogue: 0,1:06:42.20,1:06:43.70,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,1:06:55.84,1:06:56.51,Default,,0,0,0,,Міне, осы
Dialogue: 0,1:07:02.76,1:07:03.43,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,1:07:08.69,1:07:09.98,Default,,0,0,0,,Міне.
Dialogue: 0,1:07:14.61,1:07:16.19,Default,,0,0,0,,Кеттік, хмф!
Dialogue: 0,1:07:18.86,1:07:20.16,Default,,0,0,0,,Уф!
Dialogue: 0,1:07:26.50,1:07:29.17,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,1:07:30.00,1:07:31.79,Default,,0,0,0,,Уау! Сәлем Сунео!
Dialogue: 0,1:07:31.92,1:07:34.50,Default,,0,0,0,,Менің енді қолымнан келмейді, ха...
Dialogue: 0,1:07:34.63,1:07:36.17,Default,,0,0,0,,Мықты болыңыз! О?
Dialogue: 0,1:07:36.30,1:07:37.97,Default,,0,0,0,,Тастың артына тығылу
Dialogue: 0,1:07:40.55,1:07:42.05,Default,,0,0,0,,Жасырудың қажеті жоқ
Dialogue: 0,1:07:42.55,1:07:44.01,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:07:47.98,1:07:49.31,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:49.44,1:07:50.44,Default,,0,0,0,,Конняро!
Dialogue: 0,1:07:50.56,1:07:52.44,Default,,0,0,0,,Джан қауіпті!
Dialogue: 0,1:07:52.56,1:07:54.07,Default,,0,0,0,,Я... Джан!
Dialogue: 0,1:07:54.19,1:07:55.65,Default,,0,0,0,,Бірдеңе жасаңыз.
Dialogue: 0,1:07:55.78,1:07:57.65,Default,,0,0,0,,Оны маған қалдырыңыз, о
Dialogue: 0,1:07:57.78,1:07:58.94,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:59.07,1:08:00.32,Default,,0,0,0,,Нобита-кун! (Джан Сунео) Нобита!
Dialogue: 0,1:08:00.78,1:08:03.70,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:08:10.46,1:08:13.00,Default,,0,0,0,,Мен сенің қарсыласыңмын. Барайық!
Dialogue: 0,1:08:15.17,1:08:16.46,Default,,0,0,0,,Уау, уау... Гррр!
Dialogue: 0,1:08:16.75,1:08:18.84,Default,,0,0,0,,А-а, құладым.
Dialogue: 0,1:08:18.96,1:08:21.05,Default,,0,0,0,,Нобитаның бақылауы дұрыс па?
Dialogue: 0,1:08:24.93,1:08:26.22,Default,,0,0,0,,(Камо) Һм. (Фушигиро) Ұф.
Dialogue: 0,1:08:34.11,1:08:35.40,Default,,0,0,0,,Ах~
Dialogue: 0,1:08:35.52,1:08:37.61,Default,,0,0,0,,Мұндай жерде гимнастика жасамаңыз
Dialogue: 0,1:08:38.11,1:08:39.57,Default,,0,0,0,,Өзіңізді ақымақ қылыңыз
Dialogue: 0,1:08:44.20,1:08:45.03,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:51.08,1:08:53.21,Default,,0,0,0,,Егер сіз билеп жатсаңыз!
Dialogue: 0,1:08:56.25,1:08:58.63,Default,,0,0,0,,А, мен тоқтай алмаймын!
Dialogue: 0,1:08:59.00,1:09:01.30,Default,,0,0,0,,Не істеп жатырсың... (Сунео) Нобита...
Dialogue: 0,1:09:01.42,1:09:03.01,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:09:08.97,1:09:09.81,Default,,0,0,0,,Ах!
Dialogue: 0,1:09:12.48,1:09:13.56,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:14.31,1:09:16.06,Default,,0,0,0,,Нобита-кун Нобита!
Dialogue: 0,1:09:16.40,1:09:18.44,Default,,0,0,0,,Нобита-кун, жақсысың ба?
Dialogue: 0,1:09:18.57,1:09:19.90,Default,,0,0,0,,Әйтеуір... (соққы дыбысы)
Dialogue: 0,1:09:20.03,1:09:20.78,Default,,0,0,0,,Ах (барлығы) иә?
Dialogue: 0,1:09:20.90,1:09:22.49,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:09:26.91,1:09:28.91,Default,,0,0,0,,Әй, дроид сарайы!
Dialogue: 0,1:09:29.03,1:09:30.41,Default,,0,0,0,,Нобита мен жасадым!
Dialogue: 0,1:09:37.92,1:09:39.80,Default,,0,0,0,,Анашым! Поко күтіңіз
Dialogue: 0,1:09:40.84,1:09:42.26,Default,,0,0,0,,Келесі жолы мен барамын
Dialogue: 0,1:09:43.13,1:09:46.64,Default,,0,0,0,,Менің қаруым жоқ, бірақ... бәрі, күтіңдер.
Dialogue: 0,1:09:46.76,1:09:47.80,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:09:48.76,1:09:49.76,Default,,0,0,0,,Ei
Dialogue: 0,1:09:52.98,1:09:55.52,Default,,0,0,0,,Хмф! Жаңа!
Dialogue: 0,1:09:55.64,1:10:00.32,Default,,0,0,0,,Хаха Менде соңғы қару, тас басы әлі бар екеніне қуаныштымын.
Dialogue: 0,1:10:00.86,1:10:02.78,Default,,0,0,0,,Кеттік, Дестар.
Dialogue: 0,1:10:03.15,1:10:06.78,Default,,0,0,0,,Міне!
Dialogue: 0,1:10:09.91,1:10:12.49,Default,,0,0,0,,Қарғыс атқыр... бұлар несі?
Dialogue: 0,1:10:15.04,1:10:16.04,Default,,0,0,0,,Иә!
Dialogue: 0,1:10:16.17,1:10:18.25,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:19.29,1:10:20.59,Default,,0,0,0,,Гуааа…
Dialogue: 0,1:10:21.00,1:10:22.30,Default,,0,0,0,,Уф...
Dialogue: 0,1:10:23.13,1:10:23.96,Default,,0,0,0,,Дораемон-сан
Dialogue: 0,1:10:24.09,1:10:26.26,Default,,0,0,0,,А, Поконың анасы
Dialogue: 0,1:10:26.38,1:10:28.14,Default,,0,0,0,,Дестар қайда орналасқан?
Dialogue: 0,1:10:28.26,1:10:29.30,Default,,0,0,0,,Артқа
Dialogue: 0,1:10:29.43,1:10:31.18,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,1:10:31.31,1:10:33.14,Default,,0,0,0,,О, өсіп жатыр
Dialogue: 0,1:10:35.27,1:10:38.06,Default,,0,0,0,,А... не?
Dialogue: 0,1:10:48.49,1:10:50.12,Default,,0,0,0,,Уау...
Dialogue: 0,1:10:50.24,1:10:51.16,Default,,0,0,0,,Әй?
Dialogue: 0,1:10:51.70,1:10:52.70,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:10:52.83,1:10:53.62,Default,,0,0,0,,Анашым!
Dialogue: 0,1:10:53.70,1:10:56.41,Default,,0,0,0,,Ммм...
Dialogue: 0,1:10:56.54,1:10:59.12,Default,,0,0,0,,Жоқ, мен оны басқара алмаймын.
Dialogue: 0,1:10:59.25,1:11:01.59,Default,,0,0,0,,Бірдеңе бар ма? Бірдеңе бар ма? Бірдеңе...
Dialogue: 0,1:11:08.97,1:11:12.10,Default,,0,0,0,,Бұлай жалғаса берсе, зымыран планетаға тартылады.
Dialogue: 0,1:11:12.22,1:11:13.14,Default,,0,0,0,,Соқтығыс болады
Dialogue: 0,1:11:15.35,1:11:16.89,Default,,0,0,0,,Иә...
Dialogue: 0,1:11:17.02,1:11:18.56,Default,,0,0,0,,Оны тез арада тоқтатпасақ, қиыншылыққа тап боламыз.
Dialogue: 0,1:11:18.94,1:11:20.85,Default,,0,0,0,,Мұғалім, бірдеңе жасаңыз.
Dialogue: 0,1:11:20.98,1:11:21.65,Default,,0,0,0,,Анашым!
Dialogue: 0,1:11:22.73,1:11:24.11,Default,,0,0,0,,Суреттер енді қосылды.
Dialogue: 0,1:11:24.61,1:11:25.86,Default,,0,0,0,,Дораемон! Дора-чан!
Dialogue: 0,1:11:25.99,1:11:26.82,Default,,0,0,0,,Анашым!
Dialogue: 0,1:11:27.82,1:11:29.53,Default,,0,0,0,,Поко! үшін
Dialogue: 0,1:11:30.32,1:11:30.99,Default,,0,0,0,,Дестар ше?
Dialogue: 0,1:11:31.99,1:11:33.78,Default,,0,0,0,,Мен мұнда ес-түссіз жатырмын.
Dialogue: 0,1:11:33.91,1:11:37.37,Default,,0,0,0,,Тас басым мені құлатты хехехе...
Dialogue: 0,1:11:37.83,1:11:39.87,Default,,0,0,0,,Дораемон, бұл қиын.
Dialogue: 0,1:11:40.54,1:11:41.79,Default,,0,0,0,,Мен білемін
Dialogue: 0,1:11:41.92,1:11:44.71,Default,,0,0,0,,Зымыран соқтығысады, солай ма?
Dialogue: 0,1:11:45.34,1:11:47.42,Default,,0,0,0,,Құралдармен бірдеңе жасай алмайсыз ба?
Dialogue: 0,1:11:48.01,1:11:50.63,Default,,0,0,0,,Мен көп нәрсені қолданып көрдім, бірақ ол жұмыс істемейтін сияқты.
Dialogue: 0,1:11:50.93,1:11:52.93,Default,,0,0,0,,Маған бұл ұнамайды!
Dialogue: 0,1:11:53.05,1:11:54.97,Default,,0,0,0,,Дора-чан! (Сунео) Дораемон!
Dialogue: 0,1:11:55.39,1:11:56.18,Default,,0,0,0,,Анашым!
Dialogue: 0,1:11:56.85,1:11:59.14,Default,,0,0,0,,Поко, танысқаныма қуаныштымын.
Dialogue: 0,1:11:59.69,1:12:02.10,Default,,0,0,0,,Мария, кешіріңіз, мен...
Dialogue: 0,1:12:02.52,1:12:05.57,Default,,0,0,0,,Жанна, Мама саған сенді.
Dialogue: 0,1:12:06.36,1:12:07.03,Default,,0,0,0,,Анашым!
Dialogue: 0,1:12:07.78,1:12:09.74,Default,,0,0,0,,Сау бол, Поко.
Dialogue: 0,1:12:09.86,1:12:13.24,Default,,0,0,0,,Енді мен Жаннамен бірге аман қалу үшін бір-бірімізге көмектесемін.
Dialogue: 0,1:12:13.87,1:12:17.79,Default,,0,0,0,,Қандай жағдай болмасын, ана әрқашан сенің жаныңда болады.
Dialogue: 0,1:12:18.33,1:12:19.25,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,1:12:19.83,1:12:23.71,Default,,0,0,0,,Нобита-кун, үй тапсырмасын ұмытпа.
Dialogue: 0,1:12:24.59,1:12:26.63,Default,,0,0,0,,Ал кешікпе
Dialogue: 0,1:12:27.42,1:12:30.76,Default,,0,0,0,,Сонда мен Джан мен Сунеомен төбелессем де,
Dialogue: 0,1:12:30.88,1:12:32.38,Default,,0,0,0,,Жақсы араласыңыз.
Dialogue: 0,1:12:33.47,1:12:36.81,Default,,0,0,0,,Онда Шизука-чанмен бақытты бол
Dialogue: 0,1:12:37.26,1:12:39.27,Default,,0,0,0,,Не туралы айтып тұрсың, Дораемон?
Dialogue: 0,1:12:39.93,1:12:42.06,Default,,0,0,0,,Сосын анама...
Dialogue: 0,1:12:42.90,1:12:44.52,Default,,0,0,0,,Дораемон! Анашым!
Dialogue: 0,1:12:44.65,1:12:45.48,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:12:46.23,1:12:47.48,Default,,0,0,0,,Нобита-кун...
Dialogue: 0,1:12:47.73,1:12:50.44,Default,,0,0,0,,Менің өлгім келмейді!
Dialogue: 0,1:12:54.41,1:12:56.74,Default,,0,0,0,,Біз әлі соқтығысқан жоқпыз.
Dialogue: 0,1:12:57.70,1:13:00.45,Default,,0,0,0,,Мұғалім, электр беру құрылғысын қолданайық.
Dialogue: 0,1:13:00.58,1:13:01.25,Default,,0,0,0,,Иә.
Dialogue: 0,1:13:01.37,1:13:05.29,Default,,0,0,0,,Бірақ зымыран үлкен жылдамдықпен қозғалады.
Dialogue: 0,1:13:06.00,1:13:09.13,Default,,0,0,0,,Екі адамның қайда екенін білмесек, мүмкін емес.
Dialogue: 0,1:13:09.67,1:13:11.84,Default,,0,0,0,,Екеуіңді де бір уақытта тұншықтырып өлтіремін!
Dialogue: 0,1:13:11.97,1:13:16.10,Default,,0,0,0,,Поко... Поко Мама
Dialogue: 0,1:13:16.22,1:13:18.06,Default,,0,0,0,,Анашым! анам сөйлеп тұр
Dialogue: 0,1:13:18.68,1:13:22.27,Default,,0,0,0,,Мұғалім, мен анамның қайда екенін білемін.
Dialogue: 0,1:13:34.57,1:13:35.61,Default,,0,0,0,,(Айзава) Сондықтан мен қабылдау емтиханы логикаға жат дедім
Dialogue: 0,1:13:35.95,1:13:37.87,Default,,0,0,0,,Асығыңыз! соқтығысқан әке
Dialogue: 0,1:13:38.20,1:13:38.87,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,1:13:39.03,1:13:40.62,Default,,0,0,0,,Аудару!
Dialogue: 0,1:13:49.25,1:13:50.55,Default,,0,0,0,,Уф...
Dialogue: 0,1:13:51.13,1:13:53.76,Default,,0,0,0,,Дестар (Дестар) Ух...
Dialogue: 0,1:13:57.05,1:13:57.85,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:58.85,1:13:59.81,Default,,0,0,0,,үшінна!
Dialogue: 0,1:14:01.35,1:14:02.72,Default,,0,0,0,,(үшінның қуаныш дауысы)
Dialogue: 0,1:14:02.85,1:14:04.89,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:14:05.85,1:14:06.69,Default,,0,0,0,,Анашым!
Dialogue: 0,1:14:07.44,1:14:08.15,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,1:14:09.31,1:14:11.19,Default,,0,0,0,,Анашым!
Dialogue: 0,1:14:12.36,1:14:14.07,Default,,0,0,0,,Анашым! Поко
Dialogue: 0,1:14:14.95,1:14:16.03,Default,,0,0,0,,Уф...
Dialogue: 0,1:14:17.16,1:14:17.99,Default,,0,0,0,,Жанна
Dialogue: 0,1:14:19.37,1:14:22.16,Default,,0,0,0,,Анашым! Уф...
Dialogue: 0,1:14:23.29,1:14:26.75,Default,,0,0,0,,Жақсы. Ух... шынымен жақсы.
Dialogue: 0,1:14:39.34,1:14:41.81,Default,,0,0,0,,Троя, менімен Дестерді ал.
Dialogue: 0,1:14:41.93,1:14:42.64,Default,,0,0,0,,Иә
Dialogue: 0,1:14:42.76,1:14:44.73,Default,,0,0,0,,Тұр, Дестар.
Dialogue: 0,1:14:48.31,1:14:50.27,Default,,0,0,0,,Дестар, ойлан.
Dialogue: 0,1:14:50.81,1:14:53.19,Default,,0,0,0,,Дәл доктор Капекке ұқсайды
Dialogue: 0,1:14:53.32,1:14:54.23,Default,,0,0,0,,Бұл рас.
Dialogue: 0,1:14:54.78,1:14:58.07,Default,,0,0,0,,Иә, бұл менің інім.
Dialogue: 0,1:14:58.20,1:14:59.03,Default,,0,0,0,,Не?!
Dialogue: 0,1:14:59.28,1:15:04.24,Default,,0,0,0,,Ол мен сияқты ғалым болғанымен, теріс жолға түсті.
Dialogue: 0,1:15:11.67,1:15:13.88,Default,,0,0,0,,Кемпірқосаққа қараңдар!
Dialogue: 0,1:15:14.25,1:15:17.84,Default,,0,0,0,,Бұл рас, екеуі бір-біріне сәйкес келеді.
Dialogue: 0,1:15:26.73,1:15:31.61,Default,,0,0,0,,Әке, сіз осы жерде жаңа кемпірқосақ алқабын жасауды сұрап тұрсыз.
Dialogue: 0,1:15:31.77,1:15:34.11,Default,,0,0,0,,Уау...
Dialogue: 0,1:15:42.99,1:15:44.45,Default,,0,0,0,,Сіз шынымен қайтқыңыз келе ме?
Dialogue: 0,1:15:44.58,1:15:46.33,Default,,0,0,0,,Кішкене қалдырыңыз
Dialogue: 0,1:15:46.50,1:15:47.79,Default,,0,0,0,,Нобита және т.б
Dialogue: 0,1:15:47.91,1:15:50.96,Default,,0,0,0,,Бұл роботтар мен адамдардың жақсы тіл табыса алатынының мысалы.
Dialogue: 0,1:15:51.42,1:15:54.75,Default,,0,0,0,,Иә, бірақ біз де ұрысамыз.
Dialogue: 0,1:15:54.88,1:15:56.13,Default,,0,0,0,,Оған не болды?
Dialogue: 0,1:15:56.26,1:15:58.17,Default,,0,0,0,,Мен әрқашан Дораэмонға сенемін.
Dialogue: 0,1:15:58.63,1:16:00.30,Default,,0,0,0,,Және...
Dialogue: 0,1:16:00.43,1:16:01.13,Default,,0,0,0,,Және?
Dialogue: 0,1:16:01.51,1:16:04.51,Default,,0,0,0,,Неге екені белгісіз, мен Покоға және басқаларға қарап тұрғанымда, анам...
Dialogue: 0,1:16:04.64,1:16:06.60,Default,,0,0,0,,Мен де, анашым...
Dialogue: 0,1:16:06.72,1:16:08.60,Default,,0,0,0,,Мен де (Сунео) Мен де
Dialogue: 0,1:16:08.85,1:16:10.10,Default,,0,0,0,,Хехехе
Dialogue: 0,1:16:10.23,1:16:12.56,Default,,0,0,0,,Анамды бәрі көргісі келетін сияқты.
Dialogue: 0,1:16:12.77,1:16:14.27,Default,,0,0,0,,Мен кетемін
Dialogue: 0,1:16:14.40,1:16:17.57,Default,,0,0,0,,Асықпасаң, күн батады.
Dialogue: 0,1:16:17.94,1:16:19.53,Default,,0,0,0,,Иә, иә
Dialogue: 0,1:16:20.20,1:16:21.53,Default,,0,0,0,,Поко кездескенше
Dialogue: 0,1:16:21.66,1:16:23.20,Default,,0,0,0,,Иә, сау болыңыз
Dialogue: 0,1:16:24.49,1:16:26.16,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,1:16:38.46,1:16:39.34,Default,,0,0,0,,Анашым!
Dialogue: 0,1:16:40.01,1:16:41.80,Default,,0,0,0,,Не… не болды? Нобита
Dialogue: 0,1:16:42.34,1:16:44.05,Default,,0,0,0,,Анашым!
Dialogue: 0,1:16:44.60,1:16:45.72,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:16:46.64,1:16:50.73,Default,,0,0,0,,Жоқ, ештеңе емес, мен анамның қасында болғым келеді.
Dialogue: 0,1:16:50.85,1:16:52.23,Default,,0,0,0,,Қандай қызық қыз.
Dialogue: 0,1:16:52.81,1:16:55.65,Default,,0,0,0,,Жақсы, бәріңе, анам осында.
Dialogue: 0,1:16:55.77,1:16:59.32,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Дора-чан да менің балам.
Dialogue: 0,1:16:59.53,1:17:03.82,Default,,0,0,0,,Уф... Анашым!
Dialogue: 0,1:17:03.95,1:17:07.62,Default,,0,0,0,,Иә, екеуіңе не болды?
Dialogue: 0,1:17:07.74,1:17:09.41,Default,,0,0,0,,Ештеңе болмаса ше?
Dialogue: 0,1:17:09.54,1:17:10.50,Default,,0,0,0,,Эй?
Dialogue: 0,1:17:10.62,1:17:12.58,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,1:17:13.29,1:17:14.88,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,1:17:15.00,1:17:16.92,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,1:17:17.04,1:17:21.63,Default,,0,0,0,,Анашым!
Dialogue: 0,1:17:21.76,1:17:26.76,Default,,0,0,0,,♪〜
Dialogue: 0,1:20:25.44,1:20:30.45,Default,,0,0,0,,〜♪
