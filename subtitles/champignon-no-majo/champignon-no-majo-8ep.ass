Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.83,0:00:49.01,Default,,0,0,0,,♬～
Dialogue: 0,0:01:38.83,0:01:42.50,Default,,0,0,0,,<Таң келді. Мен жеуім керек>
Dialogue: 0,0:01:43.90,0:01:46.17,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:01:47.90,0:01:50.17,Default,,0,0,0,,Ол салмағын жоғалтты.
Dialogue: 0,0:01:50.17,0:01:53.94,Default,,0,0,0,,Ризе тамақты көп жемейді, солай ма?
Dialogue: 0,0:01:56.18,0:01:59.75,Default,,0,0,0,,Мен өткен күні тіпті ауырып қалдым.
Dialogue: 0,0:02:00.95,0:02:04.02,Default,,0,0,0,,Луна бірден білді.
Dialogue: 0,0:02:04.02,0:02:07.02,Default,,0,0,0,,Менің ойымша, Луна тамақты ұнатпайды.
Dialogue: 0,0:02:07.02,0:02:09.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:09.02,0:02:11.29,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:02:14.03,0:02:18.03,Default,,0,0,0,,Лиз: Сіз Лунаның тамағын ұнатпаймын дедіңіз бе?
Dialogue: 0,0:02:18.03,0:02:20.97,Default,,0,0,0,,Ол патша әулетінен шыққан.
Dialogue: 0,0:02:20.97,0:02:23.24,Default,,0,0,0,,Тілің семіз шығар.
Dialogue: 0,0:02:25.64,0:02:27.71,Default,,0,0,0,,Оны жеуге болмайтындай жаман ба?
Dialogue: 0,0:02:27.71,0:02:30.38,Default,,0,0,0,,Ұрыссаң да, жегіз.
Dialogue: 0,0:02:31.71,0:02:34.98,Default,,0,0,0,,Ал, біз, қара сиқыршылар,
Dialogue: 0,0:02:34.98,0:02:38.32,Default,,0,0,0,,Біріншіден, адам сияқты тамақтанудың қажеті жоқ.
Dialogue: 0,0:02:38.32,0:02:41.29,Default,,0,0,0,,Мен оның айналасындағы нәзіктіктерді түсінбеймін.
Dialogue: 0,0:02:45.33,0:02:48.20,Default,,0,0,0,,Мырза, өтінемін
Dialogue: 0,0:02:49.33,0:02:52.40,Default,,0,0,0,,🔊Иә, табиғи энергия жегіштер.
Dialogue: 0,0:02:52.40,0:02:55.84,Default,,0,0,0,,🔊Сіздің дәм сезуіңіз адамдікінен бөлек деп естідім.
Dialogue: 0,0:02:55.84,0:02:58.17,Default,,0,0,0,,🔊 (Мино Мелино) Иә? Солай ма?
Dialogue: 0,0:02:58.17,0:03:00.61,Default,,0,0,0,,<Табиғи энергия жегіш? ＞
Dialogue: 0,0:03:00.61,0:03:03.28,Default,,0,0,0,,🔊Табиғи энергия бізге жетеді.
Dialogue: 0,0:03:03.28,0:03:07.78,Default,,0,0,0,,🔊Оның адамдық ақ бақсылық қасиеті олай емес.
Dialogue: 0,0:03:07.78,0:03:12.85,Default,,0,0,0,,Тақсыр, табиғи энергияны жеу дегеніміз не?
Dialogue: 0,0:03:12.85,0:03:16.46,Default,,0,0,0,,Дұрыс, Луна мен қара ведьмдар➡
Dialogue: 0,0:03:16.46,0:03:20.13,Default,,0,0,0,,Өмір сүруге қажетті энергияны тамақтан емес, алыңыз➡
Dialogue: 0,0:03:20.13,0:03:25.97,Default,,0,0,0,,Табиғаттың тіршілік күші мен сиқырлы күшінен тікелей алуға болады➡
Dialogue: 0,0:03:25.97,0:03:28.47,Default,,0,0,0,,Сиқырлы күші күшті қара сиқыршы➡
Dialogue: 0,0:03:28.47,0:03:32.97,Default,,0,0,0,,Өйткені денеде үнемі таза энергия айналады➡
Dialogue: 0,0:03:32.97,0:03:36.48,Default,,0,0,0,,Физикалық қартаю механизмі адамнан өзгеше.
Dialogue: 0,0:03:36.48,0:03:39.15,Default,,0,0,0,,Адам жасаған тағам мәдениеті
Dialogue: 0,0:03:39.15,0:03:42.65,Default,,0,0,0,,Бұл оларға қажет емес.
Dialogue: 0,0:03:42.65,0:03:48.32,Default,,0,0,0,,Бірақ Луна адам мәдениеті мен іс-әрекетін жақсы көретін бала.
Dialogue: 0,0:03:48.32,0:03:52.39,Default,,0,0,0,,Меніңше, ол көргенін көріп тамақ әзірлеп жатқан шығар➡
Dialogue: 0,0:03:52.39,0:03:58.00,Default,,0,0,0,,Адамдар әлемінде мен қалыпты жағдайды аз да болса сезінгім келеді.
Dialogue: 0,0:03:58.00,0:04:01.94,Default,,0,0,0,,Бірақ, көрген-білгеннен, кітаптан алған білім жеткіліксіз сияқты.
Dialogue: 0,0:04:01.94,0:04:05.94,Default,,0,0,0,,Дәм сезіміне еліктей алмаған сияқтысың.
Dialogue: 0,0:04:05.94,0:04:08.28,Default,,0,0,0,,Ведьма...
Dialogue: 0,0:04:08.28,0:04:12.28,Default,,0,0,0,,Айтпақшы, торттың жақсы піскенін жоғарыда айттыңыз.
Dialogue: 0,0:04:12.28,0:04:15.45,Default,,0,0,0,,Сіз оны өзіңізге қамқорлық жасаған сиқыршыға жібердіңіз бе?
Dialogue: 0,0:04:16.62,0:04:20.46,Default,,0,0,0,,А~ мына торт! Бұл дәмді болды, солай емес пе?
Dialogue: 0,0:04:20.46,0:04:25.79,Default,,0,0,0,,Бір күні Тори-самаға торт жеткізіп бердім, есімде дұрыс болса, дәмін ойладым...
Dialogue: 0,0:04:25.79,0:04:30.30,Default,,0,0,0,,《(Құс сиқыршысы) Бұл... дәрінің жаңа түрі ме әлде басқасы ма? 》
Dialogue: 0,0:04:30.30,0:04:33.64,Default,,0,0,0,,А... а... мен білдім, сен.
Dialogue: 0,0:04:33.64,0:04:36.97,Default,,0,0,0,,Өзіңіз білетін адамнан тағамыңызды жасап көруін сұраңыз.
Dialogue: 0,0:04:36.97,0:04:39.74,Default,,0,0,0,,Мүмкін сізге кеңес алу керек шығар
Dialogue: 0,0:04:41.98,0:04:44.81,Default,,0,0,0,,Бұл... бәліш тәрізді дәрі ме?
Dialogue: 0,0:04:44.81,0:04:50.89,Default,,0,0,0,,Бірақ менің ойымша, кәдімгі сұйық немесе түйіршіктелген дәрілерді қабылдау оңайырақ.
Dialogue: 0,0:04:50.89,0:04:52.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:54.66,0:04:58.16,Default,,0,0,0,,А, тамақтың дәмі жоқ. Иә.
Dialogue: 0,0:04:58.16,0:05:00.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:00.16,0:05:03.33,Default,,0,0,0,,Бұл тіпті шошқа да жемейтін нәрсе.
Dialogue: 0,0:05:03.33,0:05:06.10,Default,,0,0,0,,Олай болса, бұл сиыр жемі ме?
Dialogue: 0,0:05:06.10,0:05:08.10,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:05:08.10,0:05:11.61,Default,,0,0,0,,Аа, ештеңе жемесең де, аураңнан білемін.
Dialogue: 0,0:05:11.61,0:05:14.68,Default,,0,0,0,,Айтпақшы, бұл ұсынылатын аспаздық кітап.
Dialogue: 0,0:05:14.68,0:05:16.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:16.68,0:05:21.28,Default,,0,0,0,,Көрдім, бақсы адамның баласын... алып, пісіріпті.
Dialogue: 0,0:05:21.28,0:05:23.95,Default,,0,0,0,,Сіз дұрыс материалдарды пайдаланасыз ба?
Dialogue: 0,0:05:23.95,0:05:27.96,Default,,0,0,0,,Қолжетімсіз нәрселерді өткізіп жіберіңіз немесе ауыстырыңыз...\NТіпті
Dialogue: 0,0:05:27.96,0:05:32.63,Default,,0,0,0,,болса да, мұның өзі оны осылай көрсетпейді.
Dialogue: 0,0:05:32.63,0:05:35.13,Default,,0,0,0,,Луна Донмай
Dialogue: 0,0:05:35.13,0:05:39.20,Default,,0,0,0,,Хмм... (Кітап дүкені) Ойыңызда басқа себептер бар ма?
Dialogue: 0,0:05:39.20,0:05:42.80,Default,,0,0,0,,Саңырауқұлақ уын қайтару сиқыры
Dialogue: 0,0:05:42.80,0:05:47.81,Default,,0,0,0,,Сосын мен сиқырды қолданып, оны солай етіп көрсеттім...
Dialogue: 0,0:05:47.81,0:05:49.81,Default,,0,0,0,,Зұлымдар Альянсы мен Шие Хачисай-кай арасында жақсы ынтымақтастық жоқ —
Dialogue: 0,0:05:55.32,0:05:57.65,Default,,0,0,0,,Ум... Эй, қош келдіңіз!
Dialogue: 0,0:05:57.65,0:05:59.65,Default,,0,0,0,,Бір кесек ірімшік...
Dialogue: 0,0:05:59.65,0:06:03.09,Default,,0,0,0,,Сәлем! Қаладағы қауесет улы саңырауқұлақ ведьмы! ➡
Dialogue: 0,0:06:03.09,0:06:05.09,Default,,0,0,0,,Кешіріңіз, өтінемін, сол жаққа барыңыз! ➡
Dialogue: 0,0:06:05.09,0:06:08.60,Default,,0,0,0,,Сатылатын маңызды заттарға улы саңырауқұлақтарды өсірмеңіз!
Dialogue: 0,0:06:08.60,0:06:11.27,Default,,0,0,0,,А... менің дүкеніме тоқтамаңыз!
Dialogue: 0,0:06:11.27,0:06:15.60,Default,,0,0,0,,Сенің кесіріңнен тауар бүлінсе, не істейсің?
Dialogue: 0,0:06:15.60,0:06:18.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:18.11,0:06:22.18,Default,,0,0,0,,⚟Мұнда келме! ⚟Қаладан тез шық!
Dialogue: 0,0:06:23.78,0:06:25.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:29.12,0:06:31.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:37.63,0:06:41.40,Default,,0,0,0,,Иә? Не? Менің көкөніс сатқым келеді ме?
Dialogue: 0,0:06:44.30,0:06:47.14,Default,,0,0,0,,Маған бұны сұрауға қарсы емес➡
Dialogue: 0,0:06:47.14,0:06:51.11,Default,,0,0,0,,Сіз Қара орманнан келген улы сиқырсыз ба?
Dialogue: 0,0:06:55.14,0:06:59.98,Default,,0,0,0,,Ана сүтін сатқанымды жұрт білсе, бізге де қиналмайды➡
Dialogue: 0,0:06:59.98,0:07:04.65,Default,,0,0,0,,Кешіріңіз, мен нарық бағасынан екі есе төлеуім керек.
Dialogue: 0,0:07:06.15,0:07:08.59,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:08.59,0:07:12.16,Default,,0,0,0,,Біз оны нарықтық бағадан үш есе қымбатқа сата аламыз.
Dialogue: 0,0:07:19.10,0:07:21.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:21.60,0:07:23.57,Default,,0,0,0,,Хун
Dialogue: 0,0:07:27.28,0:07:30.61,Default,,0,0,0,,Бала ұл…
Dialogue: 0,0:07:30.61,0:07:34.58,Default,,0,0,0,,Мұң тоқырап, толып жатыр
Dialogue: 0,0:07:35.62,0:07:40.96,Default,,0,0,0,,Осы сезімдерді күнделігіме жазуым керек пе?
Dialogue: 0,0:07:40.96,0:07:44.96,Default,,0,0,0,,Күнделігіме жазып, ештеңе болмағаны шықса ше?
Dialogue: 0,0:07:44.96,0:07:50.63,Default,,0,0,0,,Мен бақсының азапты сезімі туралы ештеңе білмейтін адамға қайта оралдым.
Dialogue: 0,0:07:50.63,0:07:56.71,Default,,0,0,0,,Тоқырауын туғызғаным баршаға үлкен қолайсыздық тудырса да,
Dialogue: 0,0:07:56.71,0:08:00.64,Default,,0,0,0,,Бұл азапты білмей өмір сүрген жақсы
Dialogue: 0,0:08:00.64,0:08:03.65,Default,,0,0,0,,I'm... scared
Dialogue: 0,0:08:03.65,0:08:08.08,Default,,0,0,0,,Мен бұл сезіммен қалай тұра аламын?
Dialogue: 0,0:08:08.08,0:08:11.92,Default,,0,0,0,,Мен үшін тоқырау болса да
Dialogue: 0,0:08:11.92,0:08:16.26,Default,,0,0,0,,Бұл орны толмас және маңызды азап.
Dialogue: 0,0:08:16.26,0:08:21.26,Default,,0,0,0,,Бұл сезім у деп аталса да...
Dialogue: 0,0:08:21.26,0:08:23.33,Default,,0,0,0,,Мен жібергім келмейді
Dialogue: 0,0:08:23.33,0:08:28.10,Default,,0,0,0,,Луна! Лиза қайтып келді
Dialogue: 0,0:08:28.10,0:08:30.11,Default,,0,0,0,,Қайтадан қош келдіңіз~
Dialogue: 0,0:08:30.11,0:08:33.17,Default,,0,0,0,,Сіз таңқурайды көп тердіңіз бе? (Мелино Минос) Хехехе...
Dialogue: 0,0:08:33.17,0:08:36.11,Default,,0,0,0,,Мүмкін мен көп жинамаған шығармын...
Dialogue: 0,0:08:36.11,0:08:38.78,Default,,0,0,0,,Жарайды, көмектесуге болмайды, Ризе.
Dialogue: 0,0:08:38.78,0:08:41.45,Default,,0,0,0,,Мен болмасам жақсылық болмас еді.
Dialogue: 0,0:08:41.45,0:08:43.45,Default,,0,0,0,,Келесі жолы мен сенімен барамын, мм...
Dialogue: 0,0:08:43.45,0:08:47.12,Default,,0,0,0,,Кешкі ас дайын, отырыңдар.
Dialogue: 0,0:08:53.53,0:08:55.53,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:08:55.53,0:08:58.47,Default,,0,0,0,,Иісі дәмді!
Dialogue: 0,0:08:58.47,0:09:01.97,Default,,0,0,0,,Шалқан сүтінен жасалған сорпа және нан
Dialogue: 0,0:09:01.97,0:09:04.47,Default,,0,0,0,,Сома аз, бірақ...
Dialogue: 0,0:09:04.47,0:09:06.44,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:09:07.48,0:09:10.15,Default,,0,0,0,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:09:12.55,0:09:14.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:15.98,0:09:17.95,Default,,0,0,0,,Дәмді
Dialogue: 0,0:09:20.66,0:09:24.99,Default,,0,0,0,,Лиза, мен сол сүтті сататын жер таптым.
Dialogue: 0,0:09:24.99,0:09:27.66,Default,,0,0,0,,Мен де нан пісірдім.
Dialogue: 0,0:09:27.66,0:09:31.00,Default,,0,0,0,,Бұл өтірік~ Иә, бұл өтірік!
Dialogue: 0,0:09:31.00,0:09:34.07,Default,,0,0,0,,《Балам, түсінігіңді тереңдете➡》
Dialogue: 0,0:09:34.07,0:09:37.67,Default,,0,0,0,,《Қабылдау жүрегіңізді өсіріңіз➡》
Dialogue: 0,0:09:37.67,0:09:41.68,Default,,0,0,0,,《Немесе тоқырауды жабу үшін жеткілікті➡》
Dialogue: 0,0:09:41.68,0:09:45.18,Default,,0,0,0,,《Көп қуаныш пен бақыт тап》
Dialogue: 0,0:09:45.18,0:09:47.18,Default,,0,0,0,,Иә
Dialogue: 0,0:09:47.18,0:09:52.02,Default,,0,0,0,,《Бақыт табу жүрегіңе байланысты➡》
Dialogue: 0,0:09:52.02,0:09:56.69,Default,,0,0,0,,《Ендеше, балам, бақытты бол➡》
Dialogue: 0,0:09:56.69,0:10:02.26,Default,,0,0,0,,《Олай істесең, тоқырау ақырында жалаңаяқ қашады.》
Dialogue: 0,0:10:06.47,0:10:10.47,Default,,0,0,0,,<Сол күні жүрегім мен ішім тоқ еді>
Dialogue: 0,0:10:10.47,0:10:13.31,Default,,0,0,0,,<Мен күнделік жазбадым>
Dialogue: 0,0:10:13.31,0:10:15.31,Default,,0,0,0,,<Келесі күні мен бармын>
Dialogue: 0,0:10:15.31,0:10:19.38,Default,,0,0,0,,<Мен бақсы мен қожайынмен өріс құру туралы сөйлестім>
Dialogue: 0,0:10:19.38,0:10:23.99,Default,,0,0,0,,<«Ризеге өсімдік өсіру қолайлы»> дейді
Dialogue: 0,0:10:23.99,0:10:29.82,Default,,0,0,0,,<Бақсы қалада маған егістіктерді қалай өңдеу керектігі туралы кітап іздеді.>
Dialogue: 0,0:10:29.82,0:10:35.33,Default,,0,0,0,,<Сиқырлы жаттығуларымды назардан тыс қалдырмағаным үшін, маған далада оқуға рұқсат берілді.>
Dialogue: 0,0:10:35.33,0:10:38.17,Default,,0,0,0,,<Мен сол кезді жақсы көремін>
Dialogue: 0,0:10:38.17,0:10:42.74,Default,,0,0,0,,<Оқсаң, кішкене жағымсыз нәрселер жойылады>
Dialogue: 0,0:10:43.84,0:10:47.91,Default,,0,0,0,,<Егісті өңдеуге болатын күн, алғашқы бүршіктер пайда болған күн>
Dialogue: 0,0:10:47.91,0:10:51.91,Default,,0,0,0,,<Күнге, жерге, жаңбырға шүкіршілік ететін күн>
Dialogue: 0,0:10:51.91,0:10:55.68,Default,,0,0,0,,<Өсетін күн, егін жинайтын күн...>
Dialogue: 0,0:10:55.68,0:10:58.19,Default,,0,0,0,,<Осы күнді ойласам, бір күні келеді>
Dialogue: 0,0:10:58.19,0:11:01.46,Default,,0,0,0,,<Жүрегім бақытқа толды>
Dialogue: 0,0:11:05.66,0:11:10.23,Default,,0,0,0,,Жарайды, тағы бір рет! Хмм...
Dialogue: 0,0:11:13.00,0:11:15.00,Default,,0,0,0,,Уф
Dialogue: 0,0:11:15.00,0:11:19.67,Default,,0,0,0,,Қарап тұра берме, ақымақ! Хмм... Кешіріңіз.
Dialogue: 0,0:11:19.67,0:11:24.95,Default,,0,0,0,,Жадыңыз нашар, мотивацияңыздың жоқтығы ұят.
Dialogue: 0,0:11:29.18,0:11:35.02,Default,,0,0,0,,<Байқадым, соңғы кездері мен үнемі бақсы туралы ойлайтынмын>
Dialogue: 0,0:11:35.02,0:11:39.86,Default,,0,0,0,,<Улы бақсы деген терминнен алыс сұлу адам туралы>
Dialogue: 0,0:11:39.86,0:11:44.87,Default,,0,0,0,,<Неге? Бұл шаштың ұшынан саусақтардың ұшына дейін сияқты.>
Dialogue: 0,0:11:44.87,0:11:48.54,Default,,0,0,0,,<Бар назарым бақсыға ауды...>
Dialogue: 0,0:11:49.94,0:11:51.94,Default,,0,0,0,,Сіз тыңдайсыз ба? О! Уф
Dialogue: 0,0:11:51.94,0:11:55.54,Default,,0,0,0,,<Мен өз жаттығуларыма назар аударуым керек, бұл жақсы емес...>
Dialogue: 0,0:11:55.54,0:11:57.55,Default,,0,0,0,,Кей! Каа! Уа! <Сонымен жаза ретінде>
Dialogue: 0,0:11:57.55,0:12:01.48,Default,,0,0,0,,<Бұл дүниеде менің көргім келетін ең соңғы нәрсе - бұл айналадағы қарғаның бет-әлпеті...>
Dialogue: 0,0:12:01.48,0:12:03.82,Default,,0,0,0,,<Мен көп тырысуым керек...> Киеее! Каа!
Dialogue: 0,0:12:03.82,0:12:08.32,Default,,0,0,0,,А-а-а... қарға Ризені бақылап отырмын деп тағы да қорқытады.
Dialogue: 0,0:12:08.32,0:12:10.33,Default,,0,0,0,,А... а...
Dialogue: 0,0:12:10.33,0:12:13.16,Default,,0,0,0,,Мені қорламаңыз, бұл жаттығу.
Dialogue: 0,0:12:13.16,0:12:18.23,Default,,0,0,0,,<Қайтару сиқыры, уақыт сиқыры, ғарыш сиқыры, түрлендіру магиясы...>
Dialogue: 0,0:12:18.23,0:12:21.24,Default,,0,0,0,,<Үйренуге болатын сиқырлар көп>
Dialogue: 0,0:12:21.24,0:12:24.01,Default,,0,0,0,,Келесі алма. Байқап көріңіз.
Dialogue: 0,0:12:24.01,0:12:27.84,Default,,0,0,0,,<Менің қазір істеп жатқаным - тарту сиқыры>
Dialogue: 0,0:12:27.84,0:12:30.85,Default,,0,0,0,,<Денеңіздің бір бөлігіне айырбастау>
Dialogue: 0,0:12:30.85,0:12:34.92,Default,,0,0,0,,<Бар заттарды тартатын сиқырмен...>
Dialogue: 0,0:12:34.92,0:12:36.92,Default,,0,0,0,,Күрсін... Сен...
Dialogue: 0,0:12:36.92,0:12:39.92,Default,,0,0,0,,Бір тал шаш, бір жапырақ тым жалықтырады.
Dialogue: 0,0:12:39.92,0:12:41.92,Default,,0,0,0,,Бүтін алманы тарту
Dialogue: 0,0:12:41.92,0:12:45.59,Default,,0,0,0,,Осылай жүре берсең, тайғақ болып кетесің!
Dialogue: 0,0:12:46.69,0:12:51.70,Default,,0,0,0,,<Қанша рет тырыссаңыз да, сіз жақсартатын жалғыз нәрсе - қарға тілін өшіру әдісі>
Dialogue: 0,0:12:51.70,0:12:55.47,Default,,0,0,0,,Эй Луна, маған мысалды қайта көрсет.
Dialogue: 0,0:12:56.54,0:12:58.51,Default,,0,0,0,,Иә
Dialogue: 0,0:13:00.54,0:13:06.15,Default,,0,0,0,,＜ １ １＞
Dialogue: 0,0:13:06.15,0:13:08.92,Default,,0,0,0,,<Болмайтын нәрсені жасауға болатын сияқты>
Dialogue: 0,0:13:09.98,0:13:13.76,Default,,0,0,0,,Луна мұндай сиқырды тез үйреніп алған сияқты.
Dialogue: 0,0:13:14.99,0:13:16.99,Default,,0,0,0,,<Мен сияқтымын>
Dialogue: 0,0:13:16.99,0:13:19.06,Default,,0,0,0,,<Сіз сабақты тастап кеткен сияқтысыз...> Ах!
Dialogue: 0,0:13:19.06,0:13:23.83,Default,,0,0,0,,Сонымен... Бірақ мен жасайтын алмалар нашар шығар.
Dialogue: 0,0:13:23.83,0:13:28.20,Default,,0,0,0,,<Рахмет, бірақ сіз жауаптарыңызға мән беретін жазылушысыз...>
Dialogue: 0,0:13:29.17,0:13:33.01,Default,,0,0,0,,Сыйлық... Жаман алма сыйладың ба?
Dialogue: 0,0:13:33.01,0:13:35.08,Default,,0,0,0,,Жарайды... бұл жаман... аа~➡
Dialogue: 0,0:13:35.08,0:13:37.08,Default,,0,0,0,,Жоқ, Луна.
Dialogue: 0,0:13:37.08,0:13:40.01,Default,,0,0,0,,Жарайды... жаман... мүмкін... хахаха
Dialogue: 0,0:13:40.01,0:13:42.85,Default,,0,0,0,,<Маған қандай тағдыр жазылды?>
Dialogue: 0,0:13:42.85,0:13:45.72,Default,,0,0,0,,<Түсінбейтін жерім көп...>
Dialogue: 0,0:13:46.69,0:13:49.02,Default,,0,0,0,,Иә! ⚟Уау, бұл керемет Лиза
Dialogue: 0,0:13:49.02,0:13:51.86,Default,,0,0,0,,<Мен бақсының үмітін ақтағым келеді>
Dialogue: 0,0:13:51.86,0:13:54.93,Default,,0,0,0,,<Себебі сол нұр менің жүрегімде>
Dialogue: 0,0:13:54.93,0:13:57.60,Default,,0,0,0,,<Қатты жаттығу - қиындық емес>
Dialogue: 0,0:13:58.70,0:14:00.87,Default,,0,0,0,,Еркінбеңіз
Dialogue: 0,0:14:00.87,0:14:02.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:04.47,0:14:07.48,Default,,0,0,0,,Сиқыршылар кеңесшісінің күтпеген сынақ уақыты келді
Dialogue: 0,0:14:07.48,0:14:10.14,Default,,0,0,0,,Қашан келгенің маңызды емес.
Dialogue: 0,0:14:11.48,0:14:14.32,Default,,0,0,0,,Ол қазір қандай сиқыр жасай алады?
Dialogue: 0,0:14:14.32,0:14:17.15,Default,,0,0,0,,Күнделікті өңдеу
Dialogue: 0,0:14:17.15,0:14:19.82,Default,,0,0,0,,Мұны санамаңыз.
Dialogue: 0,0:14:19.82,0:14:22.89,Default,,0,0,0,,Гравитация... Емдеу... Тарту сиқыры...
Dialogue: 0,0:14:22.89,0:14:25.36,Default,,0,0,0,,Екеуі де өте кішкентай.
Dialogue: 0,0:14:27.83,0:14:29.83,Default,,0,0,0,,Міне!
Dialogue: 0,0:14:29.83,0:14:35.17,Default,,0,0,0,,Шебер Ризенің қолында өсімдіктердің тез өсетінін айтты➡
Dialogue: 0,0:14:35.17,0:14:37.17,Default,,0,0,0,,Жасыл... сиыр екеніне сенімдімін
Dialogue: 0,0:14:37.17,0:14:39.14,Default,,0,0,0,,Бұл туралы айтпа
Dialogue: 0,0:14:42.01,0:14:46.01,Default,,0,0,0,,<Егін өсіре бастағаннан кейін жақында байқағаным...>
Dialogue: 0,0:14:46.01,0:14:51.09,Default,,0,0,0,,<Тұқым болмаса да, мен қалаған өсімдікті өсіретін сияқтымын.>
Dialogue: 0,0:14:51.09,0:14:55.09,Default,,0,0,0,,《Бұл әдетте оңай орындалатын нәрсе емес》
Dialogue: 0,0:14:55.09,0:14:57.69,Default,,0,0,0,,<Бақсы осылай деді>
Dialogue: 0,0:14:57.69,0:15:02.96,Default,,0,0,0,,<Менің бұл күшім қандай да бір себептермен барлығына күрделі болып көрінеді...>
Dialogue: 0,0:15:04.47,0:15:06.97,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:15:06.97,0:15:09.64,Default,,0,0,0,,Лиз, қолыңнан келгеннің бәрін істеп, көп тамақтан.
Dialogue: 0,0:15:09.64,0:15:12.14,Default,,0,0,0,,Өсеу~
Dialogue: 0,0:15:12.14,0:15:15.64,Default,,0,0,0,,Таңдаушы болсаң, ешқашан өспейсің.
Dialogue: 0,0:15:15.64,0:15:18.15,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:15:18.15,0:15:22.72,Default,,0,0,0,,А? Неге күңіреніп тұрсың? Эй, жүр!
Dialogue: 0,0:15:24.49,0:15:30.99,Default,,0,0,0,,<Неге... неге мен бақсыдан сонша кішкентаймын?>
Dialogue: 0,0:15:30.99,0:15:35.50,Default,,0,0,0,,<Үлкендер мен балалар мүлдем сәйкес келмейтін сияқты.>
Dialogue: 0,0:15:35.50,0:15:42.34,Default,,0,0,0,,<Әйтеуір, менде мұндай дене болмау керек еді.>
Dialogue: 0,0:15:42.34,0:15:47.41,Default,,0,0,0,,<Ол қорғалатын адамды емес, маңызды адамды қорғауы керек еді.>
Dialogue: 0,0:15:47.41,0:15:52.01,Default,,0,0,0,,<Мен қазір сиқырлы жаттығу туралы ойлауым керек>
Dialogue: 0,0:15:52.01,0:15:57.69,Default,,0,0,0,,<Бақыланбайтын мінез-құлыққа батып, негізсіз ойларға берілу>
Dialogue: 0,0:15:57.69,0:16:02.29,Default,,0,0,0,,<Мен күнделігіме бұл хаосты дұрыс түсіре алмаймын...>
Dialogue: 0,0:16:02.29,0:16:04.63,Default,,0,0,0,,<Мен оны қосқым келмейді>
Dialogue: 0,0:16:04.63,0:16:08.20,Default,,0,0,0,,<Мен оңай бөлшектенгім келмейді>
Dialogue: 0,0:16:13.30,0:16:16.14,Default,,0,0,0,,Ол жігіттен үміт жоқ.
Dialogue: 0,0:16:16.14,0:16:18.14,Default,,0,0,0,,А...
Dialogue: 0,0:16:18.14,0:16:21.14,Default,,0,0,0,,Дәл осылай, мен қара бақсы стилінде жаттығамын.
Dialogue: 0,0:16:21.14,0:16:24.41,Default,,0,0,0,,Қалыпты деңгейдің оннан бірі де емес шығар.
Dialogue: 0,0:16:25.65,0:16:29.65,Default,,0,0,0,,Солай... Сіз мұны бұрыннан білесіз, Луна.
Dialogue: 0,0:16:29.65,0:16:32.72,Default,,0,0,0,,Қалай қарасаң да, ол Ақ бақсы тұқымынан.
Dialogue: 0,0:16:34.49,0:16:39.56,Default,,0,0,0,,Шамасы, олардың өз күштерін ояту тәсілі бар.
Dialogue: 0,0:16:39.56,0:16:43.03,Default,,0,0,0,,Оны өзі табуы керек.
Dialogue: 0,0:16:44.17,0:16:48.94,Default,,0,0,0,,Қара ведьм жағындағыларымыз үшін мүмкіндігінше мұндай дамудан аулақ болғымыз келеді.
Dialogue: 0,0:16:51.01,0:16:53.01,Default,,0,0,0,,(рухтар күледі)
Dialogue: 0,0:16:53.01,0:16:55.51,Default,,0,0,0,,⚟Орынсыз жаттығу, еңбектеріңізге рахмет.
Dialogue: 0,0:16:55.51,0:17:01.52,Default,,0,0,0,,⚟Мен тоқтап қалсам ғой. Бұл менің әдемі шашымның босқа кетуі.
Dialogue: 0,0:17:01.52,0:17:05.69,Default,,0,0,0,,Кім? ⚟Бізді ести аласыз ба?
Dialogue: 0,0:17:05.69,0:17:08.12,Default,,0,0,0,,⚟Сиқырлы күшім артып бара жатқан сияқты.
Dialogue: 0,0:17:08.12,0:17:10.79,Default,,0,0,0,,⚟Біз келдік, төмен қараңдар.
Dialogue: 0,0:17:10.79,0:17:14.13,Default,,0,0,0,,⚟Жоқ, ол менің артымда...
Dialogue: 0,0:17:14.13,0:17:16.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:16.80,0:17:19.13,Default,,0,0,0,,(рухтар күледі)
Dialogue: 0,0:17:19.13,0:17:22.80,Default,,0,0,0,,Мен мұны ақыры түсіндім. Танысқаныма қуаныштымын, Ризе.
Dialogue: 0,0:17:22.80,0:17:26.31,Default,,0,0,0,,Рухтар әлеміне қош келдіңіздер
Dialogue: 0,0:17:26.31,0:17:29.38,Default,,0,0,0,,Рух? ⚟Оны көріп таң қалдым
Dialogue: 0,0:17:29.38,0:17:33.15,Default,,0,0,0,,⚟Сіз бізді мүлде байқамайсыз.
Dialogue: 0,0:17:33.15,0:17:35.82,Default,,0,0,0,,⚟Таңданған жүзіңіз де сүйкімді.
Dialogue: 0,0:17:35.82,0:17:39.89,Default,,0,0,0,,Сәлем Лиза, мен сіз жасаған бұршақ рухымын➡
Dialogue: 0,0:17:39.89,0:17:42.49,Default,,0,0,0,,Эй, мен саған айтамын.
Dialogue: 0,0:17:42.49,0:17:45.83,Default,,0,0,0,,Сол қара бақсылардың айтқанын істесең де
Dialogue: 0,0:17:45.83,0:17:48.66,Default,,0,0,0,,Мен ол сияқты бола алмаймын...
Dialogue: 0,0:17:48.66,0:17:50.67,Default,,0,0,0,,Мен ошаған рухпын
Dialogue: 0,0:17:50.67,0:17:54.17,Default,,0,0,0,,Ризе, маған әрқашан қамқорлық жасағаныңыз үшін рахмет➡
Dialogue: 0,0:17:54.17,0:17:56.50,Default,,0,0,0,,Сіздей ақ бақсы тегі➡
Dialogue: 0,0:17:56.50,0:17:59.57,Default,,0,0,0,,Қасиеттері қара бақсыдан айырмашылығы бар ма? Қасиеттер?
Dialogue: 0,0:17:59.57,0:18:03.01,Default,,0,0,0,,Бұл баланың жарамсыз сиқырлы тұқымдарынан.
Dialogue: 0,0:18:03.01,0:18:05.68,Default,,0,0,0,,Жасыл рухтар көп.
Dialogue: 0,0:18:05.68,0:18:09.75,Default,,0,0,0,,⚟Бұл не, су рухы? Мұндай тітіркендіргіш жолмен араласпаңыз.
Dialogue: 0,0:18:09.75,0:18:11.75,Default,,0,0,0,,<Не? Бұл...＞
Dialogue: 0,0:18:11.75,0:18:14.52,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:14.52,0:18:17.36,Default,,0,0,0,,Сәлем Лиза, мен жел рухымын.
Dialogue: 0,0:18:17.36,0:18:20.19,Default,,0,0,0,,Сіз ештеңе білмейсіз.
Dialogue: 0,0:18:20.19,0:18:22.26,Default,,0,0,0,,Біріншіден, Ақ бақсы - сүйкімділік
Dialogue: 0,0:18:22.26,0:18:26.03,Default,,0,0,0,,Басқаша айтқанда, жындар мен рухтардың күшін алу үшін сүйкімділікті пайдаланыңыз.
Dialogue: 0,0:18:26.03,0:18:28.04,Default,,0,0,0,,Шарм?
Dialogue: 0,0:18:28.04,0:18:31.87,Default,,0,0,0,,Сіздің сиқырлы күшіңіз бен өмір сүру ұзақтығыңыз негізінен сол жерден алынған.
Dialogue: 0,0:18:31.87,0:18:35.74,Default,,0,0,0,,⚟Ей, қара бақсылар мен ақ бақсылар мүлдем басқа.
Dialogue: 0,0:18:36.71,0:18:39.05,Default,,0,0,0,,Ақ бақсының күші шамалы болып көрінсе де➡
Dialogue: 0,0:18:39.05,0:18:41.55,Default,,0,0,0,,Күтпеген жерден бұл сүйкімділіктің күші қара бақсыға.
Dialogue: 0,0:18:41.55,0:18:44.39,Default,,0,0,0,,Бұл менің Ахиллес өкшесі шығар, иә...
Dialogue: 0,0:18:44.39,0:18:47.22,Default,,0,0,0,,Жоқ, Бақа ашулы➡
Dialogue: 0,0:18:47.22,0:18:49.56,Default,,0,0,0,,Мен тым көп сөйледім бе? Хехе
Dialogue: 0,0:18:49.56,0:18:51.56,Default,,0,0,0,,(Бақаның айқайы)
Dialogue: 0,0:18:51.56,0:18:54.63,Default,,0,0,0,,⚟Сондықтан Ризе, сіз өзіңіздің сүйкімділік күшіңізді шыңдауыңыз керек➡
Dialogue: 0,0:18:54.63,0:18:57.23,Default,,0,0,0,,Құдіретіңмен бізді қуант
Dialogue: 0,0:18:57.23,0:19:00.23,Default,,0,0,0,,Онда біз сізге көмектесеміз
Dialogue: 0,0:19:00.23,0:19:03.24,Default,,0,0,0,,Бұл Ақ бақсының құдіреті
Dialogue: 0,0:19:03.24,0:19:07.17,Default,,0,0,0,,Бұл мен... Оның қандай екенін де білмеймін.
Dialogue: 0,0:19:07.17,0:19:12.51,Default,,0,0,0,,О, сен оянып жатырсың. Ән айтып көр, Ризе.
Dialogue: 0,0:19:12.51,0:19:18.02,Default,,0,0,0,,Мен ешқашан ән айтқан емеспін. Мен ештеңе ойлай алмаймын ...
Dialogue: 0,0:19:18.02,0:19:24.09,Default,,0,0,0,,Сіз мұны істей аласыз. Ойыңызға келген әуенмен сезіміңізді білдірсеңіз болғаны.
Dialogue: 0,0:19:24.09,0:19:28.10,Default,,0,0,0,,⚟Бұл Ақ бақсының жаттығуы <Тренинг...>
Dialogue: 0,0:19:28.10,0:19:30.10,Default,,0,0,0,,⚟Жаса, Ризе
Dialogue: 0,0:19:30.10,0:19:32.10,Default,,0,0,0,,(тыныс алу)
Dialogue: 0,0:19:32.10,0:19:37.37,Default,,0,0,0,,(Лиз ән айтады)
Dialogue: 0,0:19:37.37,0:19:40.37,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:40.37,0:19:43.44,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:19:43.44,0:19:46.45,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:19:46.45,0:20:02.40,Default,,0,0,0,,(Лиз ән айтады)
Dialogue: 0,0:20:02.40,0:20:05.07,Default,,0,0,0,,Не? Бұл ән кім?
Dialogue: 0,0:20:06.17,0:20:09.67,Default,,0,0,0,,Бұл сөз – рух тілі.
Dialogue: 0,0:20:09.67,0:20:12.17,Default,,0,0,0,,Мырза
Dialogue: 0,0:20:12.17,0:20:17.01,Default,,0,0,0,,Бұл сөздер Ризенің жасушалық деңгейіне сіңген болуы керек.
Dialogue: 0,0:20:17.01,0:20:21.85,Default,,0,0,0,,Сіз не айтып тұрсыз? Луна мен Клод түсінеді ме?
Dialogue: 0,0:20:21.85,0:20:26.52,Default,,0,0,0,,Түсіндің бе? Жақсы, мен оны елестете аламын.
Dialogue: 0,0:20:26.52,0:20:28.59,Default,,0,0,0,,Иеміз түсінді ме?
Dialogue: 0,0:20:28.59,0:20:31.03,Default,,0,0,0,,О, мен түсіндім.
Dialogue: 0,0:20:31.03,0:20:34.10,Default,,0,0,0,,(Лиз ән айтады)
Dialogue: 0,0:20:34.10,0:20:38.70,Default,,0,0,0,,《(Ана) Лиза, егер мен бір күні ғашық болып қалсам》
Dialogue: 0,0:20:38.70,0:20:44.67,Default,,0,0,0,,《Ән сені емдейді, күш береді, жол көрсетеді.》
Dialogue: 0,0:20:45.77,0:20:48.78,Default,,0,0,0,,<Бұл кімнің дауысы? ＞
Dialogue: 0,0:20:48.78,0:20:50.78,Default,,0,0,0,,《(Ана) Махаббаттың күші➡》
Dialogue: 0,0:20:50.78,0:20:54.38,Default,,0,0,0,,《Ақ сиқырды ояту➡》
Dialogue: 0,0:20:54.38,0:20:57.05,Default,,0,0,0,,《Өйткені ол күшейтеді...》
Dialogue: 0,0:21:02.16,0:21:04.83,Default,,0,0,0,,Күрсін... (Рухтар) Уау~
Dialogue: 0,0:21:04.83,0:21:07.33,Default,,0,0,0,,Керемет Лиза Мен сені жақсы көремін
Dialogue: 0,0:21:07.33,0:21:09.83,Default,,0,0,0,,Өте сүйкімді! Мен оны өте ұсына аламын
Dialogue: 0,0:21:09.83,0:21:15.00,Default,,0,0,0,,Лиз Мен саған ағаштардың батасын беремін.
Dialogue: 0,0:21:19.34,0:21:23.41,Default,,0,0,0,,Біз суды қорғауды ұсынамыз.
Dialogue: 0,0:21:23.41,0:21:26.68,Default,,0,0,0,,Тілек дәнін өсіреміз
Dialogue: 0,0:21:29.35,0:21:32.02,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:32.02,0:21:35.02,Default,,0,0,0,,⚟Сіз түсіндіңіз бе?
Dialogue: 0,0:21:35.02,0:21:40.53,Default,,0,0,0,,Сүйіспеншіліктің күшімен сүйкімділіктерді жылтырату - Ақ бақсы сиқырлы жаттығуларының кілті.
Dialogue: 0,0:21:40.53,0:21:43.36,Default,,0,0,0,,Ақ бақсылардың да түрлері бар➡
Dialogue: 0,0:21:43.36,0:21:46.70,Default,,0,0,0,,Сіз ән айтуда ерекшесіз.
Dialogue: 0,0:21:46.70,0:21:49.54,Default,,0,0,0,,⚟Махаббат күші қара бақсыға улы➡
Dialogue: 0,0:21:49.54,0:21:53.54,Default,,0,0,0,,Ақ бақсы үшін бұл қуат көзі. <Не? У...? ＞
Dialogue: 0,0:21:53.54,0:21:55.61,Default,,0,0,0,,Ризе, дауыстап ән сал
Dialogue: 0,0:21:55.61,0:21:59.05,Default,,0,0,0,,Тіпті аспан да жарылқайды
Dialogue: 0,0:21:59.05,0:22:01.82,Default,,0,0,0,,Кемпірқосақ пайда болғаны сонша!
Dialogue: 0,0:22:01.82,0:22:03.82,Default,,0,0,0,,Иә
Dialogue: 0,0:22:03.82,0:22:08.16,Default,,0,0,0,,<Мен ол кезде ештеңе білмедім...>
Dialogue: 0,0:22:08.16,0:22:10.99,Default,,0,0,0,,Менің жаман болжамның орындалғанын көру өте жақсы.
Dialogue: 0,0:22:10.99,0:22:16.96,Default,,0,0,0,,Қаласаң да, қаламасаң да, мақсатыңа жете алсаң, мен құралдарға күмән келтірмеймін.
Dialogue: 0,0:22:18.07,0:22:21.34,Default,,0,0,0,,Егер сіз оған зиян келтірмесеңіз
Dialogue: 0,0:22:21.34,0:22:25.01,Default,,0,0,0,,<Бұл сезім менің сиқырлы күшімді оятты>
Dialogue: 0,0:22:25.01,0:22:27.47,Default,,0,0,0,,<Бұл өмірде бір рет болатын махаббат...>
Dialogue: 0,0:22:32.08,0:22:36.68,Default,,0,0,0,,<Луна, мен сені бұрышқа түсіретінімді білмей>
Dialogue: 0,0:22:36.68,0:22:39.15,Default,,0,0,0,,(Лиз ән айтады)
Dialogue: 0,0:22:42.36,0:23:30.84,Default,,0,0,0,,♬～
Dialogue: 0,0:23:32.34,0:23:38.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory