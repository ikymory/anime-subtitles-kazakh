Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.00,0:00:08.10,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:00:24.35,0:00:26.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:39.20,0:00:41.20,Default,,0,0,0,,Ei
Dialogue: 0,0:00:45.71,0:00:48.04,Default,,0,0,0,,Дайын!
Dialogue: 0,0:00:48.04,0:01:36.06,Default,,0,0,0,,♬～
Dialogue: 0,0:02:26.68,0:02:29.68,Default,,0,0,0,,Қарасам, «саңырауқұлақ» сөзі осылай жазылған.
Dialogue: 0,0:02:29.68,0:02:33.35,Default,,0,0,0,,<Сәлеметсіз бе, мен Лизельмін, шебер-оқушы>
Dialogue: 0,0:02:33.35,0:02:35.35,Default,,0,0,0,,Лизи!
Dialogue: 0,0:02:35.35,0:02:37.85,Default,,0,0,0,,Иә
Dialogue: 0,0:02:37.85,0:02:40.56,Default,,0,0,0,,<Ол басқа Ризе>
Dialogue: 0,0:02:41.69,0:02:44.53,Default,,0,0,0,,<Менің атым Ризе>
Dialogue: 0,0:02:44.53,0:02:47.03,Default,,0,0,0,,<Оның шын есімі Лисел>
Dialogue: 0,0:02:47.03,0:02:49.20,Default,,0,0,0,,<Бұл шын есім>
Dialogue: 0,0:02:49.20,0:02:53.04,Default,,0,0,0,,<Адамға шын есіміңді айту жақсы емес>
Dialogue: 0,0:02:53.04,0:02:55.87,Default,,0,0,0,,<Қазір сиқырды қолданғанда кілт ретінде пайдаланылады>
Dialogue: 0,0:02:55.87,0:02:59.04,Default,,0,0,0,,<Тек жүрегіңде ән айт>
Dialogue: 0,0:02:59.04,0:03:02.14,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:02.14,0:03:04.48,Default,,0,0,0,,Мына кастрюльді араластырыңыз.
Dialogue: 0,0:03:04.48,0:03:06.48,Default,,0,0,0,,Иә
Dialogue: 0,0:03:06.48,0:03:08.48,Default,,0,0,0,,(қайнаған дыбыс)
Dialogue: 0,0:03:08.48,0:03:10.65,Default,,0,0,0,,Оны сиқырмен орындау керек.
Dialogue: 0,0:03:10.65,0:03:12.65,Default,,0,0,0,,Иә
Dialogue: 0,0:03:12.65,0:03:16.16,Default,,0,0,0,,<Бұл адам менің қожайыным, қара сиқыршы Луна>
Dialogue: 0,0:03:16.16,0:03:20.36,Default,,0,0,0,,<Бақсы үнемі мені таңдайды>
Dialogue: 0,0:03:23.00,0:03:26.50,Default,,0,0,0,,Сен сонда не істеп жүрсің?
Dialogue: 0,0:03:26.50,0:03:28.67,Default,,0,0,0,,Мен күнделік жазып отырдым.
Dialogue: 0,0:03:28.67,0:03:31.67,Default,,0,0,0,,Бақсы күнделік жазуымды өтінді.
Dialogue: 0,0:03:31.67,0:03:34.01,Default,,0,0,0,,Өйткені мен сиқырлы сөзді түсінбеймін
Dialogue: 0,0:03:34.01,0:03:36.68,Default,,0,0,0,,Мен басында уайымдадым
Dialogue: 0,0:03:36.68,0:03:40.02,Default,,0,0,0,,Мен ойша суретке түсіру арқылы ойларымды жаза алған соң
Dialogue: 0,0:03:40.02,0:03:43.19,Default,,0,0,0,,Қай сөз қай әріп екенін тап
Dialogue: 0,0:03:43.19,0:03:47.19,Default,,0,0,0,,Барған сайын қызық болып, мен көп нәрсені үйреніп жатырмын.
Dialogue: 0,0:03:47.19,0:03:49.52,Default,,0,0,0,,Мен мұны істегеніме қуаныштымын...
Dialogue: 0,0:03:49.52,0:03:51.69,Default,,0,0,0,,(қайнаған дыбыс)
Dialogue: 0,0:03:51.69,0:03:53.70,Default,,0,0,0,,Уау! Ахх...!
Dialogue: 0,0:03:53.70,0:03:57.87,Default,,0,0,0,,<Бірақ, шамасы, сиқыршы>
Dialogue: 0,0:03:57.87,0:04:01.64,Default,,0,0,0,,Аа... <Себебі мен мазақтауға аздап нашармын.>
Dialogue: 0,0:04:01.64,0:04:03.64,Default,,0,0,0,,Е...
Dialogue: 0,0:04:03.64,0:04:05.64,Default,,0,0,0,,Ум...
Dialogue: 0,0:04:05.64,0:04:09.31,Default,,0,0,0,,Ештеңе етпейді, себебі сізге осы уақытқа дейін бару жеткіліксіз.
Dialogue: 0,0:04:09.31,0:04:12.81,Default,,0,0,0,,ше? Қызық, сіз нені меңзеп тұрсыз?
Dialogue: 0,0:04:14.65,0:04:20.49,Default,,0,0,0,,<Сондықтан мен шынымен түсінбеймін, бірақ бұл көп қиындық тудыратын сияқты.>
Dialogue: 0,0:04:20.49,0:04:23.33,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:04:23.33,0:04:27.13,Default,,0,0,0,,Жоқ, мен мұны істегім келді.
Dialogue: 0,0:04:31.67,0:04:35.50,Default,,0,0,0,,<Ризе есімі қызға ұқсауы мүмкін>
Dialogue: 0,0:04:35.50,0:04:38.51,Default,,0,0,0,,<Шын мәнінде, бұл маған ұнамайды>
Dialogue: 0,0:04:39.67,0:04:43.68,Default,,0,0,0,,<Себебі бақсы маған осылай атады>
Dialogue: 0,0:04:43.68,0:04:47.35,Default,,0,0,0,,<Мен үшін бәрінен де маңызды...>
Dialogue: 0,0:04:47.35,0:04:50.19,Default,,0,0,0,,Жаңа ғана бастапқы атаудан "ru" сөзін алдыңыз.
Dialogue: 0,0:04:50.19,0:04:53.86,Default,,0,0,0,,Маңызды болудан алыс, бұл орындылықтың биіктігі.
Dialogue: 0,0:04:53.86,0:04:55.86,Default,,0,0,0,,Сәлем
Dialogue: 0,0:04:55.86,0:04:57.86,Default,,0,0,0,,Хун
Dialogue: 0,0:04:57.86,0:05:00.13,Default,,0,0,0,,＜Бұл адам Клод, ойын дүкені＞
Dialogue: 0,0:05:00.13,0:05:02.13,Default,,0,0,0,,<Оны тіпті шақырмады>
Dialogue: 0,0:05:02.13,0:05:07.30,Default,,0,0,0,,<Мазасыз жәндіктер менің және бақсының өміріне еніп жатыр...>
Dialogue: 0,0:05:07.30,0:05:10.64,Default,,0,0,0,,<Жоқ, бұл қарға, сондықтан бұл құс.>
Dialogue: 0,0:05:10.64,0:05:14.14,Default,,0,0,0,,＜Алайда болмыс жағынан олар жәндіктерден басқа ештеңе емес＞
Dialogue: 0,0:05:14.14,0:05:16.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:16.14,0:05:18.15,Default,,0,0,0,,<Ақыр соңында, бұл жайсыз жәндік>
Dialogue: 0,0:05:18.15,0:05:20.15,Default,,0,0,0,,Мен сені өлтіремін, қарғыс атқыр бала!
Dialogue: 0,0:05:20.15,0:05:22.65,Default,,0,0,0,,Не болды? Клод
Dialogue: 0,0:05:22.65,0:05:24.82,Default,,0,0,0,,Жүрегіңді тыңда! Колла!
Dialogue: 0,0:05:24.82,0:05:29.99,Default,,0,0,0,,Claude... It's bad manners to look at someone's diary.
Dialogue: 0,0:05:29.99,0:05:33.50,Default,,0,0,0,,Қашанға дейін өзімнің қараңғы жағыммен бетпе-бет келмеймін?
Dialogue: 0,0:05:33.50,0:05:35.50,Default,,0,0,0,,Мен көмектесе алмаймын.
Dialogue: 0,0:05:35.50,0:05:40.17,Default,,0,0,0,,No matter how trashy things are, what I don't like or feel anxious about is what I do.
Dialogue: 0,0:05:40.17,0:05:44.67,Default,,0,0,0,,Жүрегім тоқырап қалмасын деп осы күнделікке жазып алғым келді.
Dialogue: 0,0:05:44.67,0:05:47.68,Default,,0,0,0,,Бақсы мені қатты шақырып жатыр.
Dialogue: 0,0:05:47.68,0:05:51.38,Default,,0,0,0,,Мен қоқыста тоқыраумын.
Dialogue: 0,0:05:53.52,0:05:58.35,Default,,0,0,0,,Луна! Wow, what kind of education are you giving this guy!
Dialogue: 0,0:05:58.35,0:06:01.12,Default,,0,0,0,,Өтінемін, бақсыға ашулануды доғар.
Dialogue: 0,0:06:01.12,0:06:04.29,Default,,0,0,0,,I also wrote in my diary and felt a little refreshed.
Dialogue: 0,0:06:04.29,0:06:07.80,Default,,0,0,0,,I don't feel as uncomfortable being with Claude as I did earlier.
Dialogue: 0,0:06:07.80,0:06:11.13,Default,,0,0,0,,Дөрекілігіңді біл!
Dialogue: 0,0:06:11.13,0:06:13.47,Default,,0,0,0,,Оған көмектесу мүмкін емес, Клод➡
Dialogue: 0,0:06:13.47,0:06:15.97,Default,,0,0,0,,Ризе қарғыс атқан бала.
Dialogue: 0,0:06:15.97,0:06:19.31,Default,,0,0,0,,Isn't it best to accumulate toxins in your mind?
Dialogue: 0,0:06:19.31,0:06:22.31,Default,,0,0,0,,Chiritsumo is a great enemy if you don't let your guard down.
Dialogue: 0,0:06:22.31,0:06:27.82,Default,,0,0,0,,I don't want Luna to grow that black mushroom again.
Dialogue: 0,0:06:31.65,0:06:35.66,Default,,0,0,0,,I know, I wonder if you really understand.
Dialogue: 0,0:06:35.66,0:06:39.33,Default,,0,0,0,,He's so angry and just letting out his anger~➡
Dialogue: 0,0:06:39.33,0:06:41.66,Default,,0,0,0,,Don't let Rize become the end of her life➡
Dialogue: 0,0:06:41.66,0:06:46.50,Default,,0,0,0,,We all have to guide Rize, who doesn't know anything.
Dialogue: 0,0:06:46.50,0:06:48.50,Default,,0,0,0,,Қарғыс атқан бала...
Dialogue: 0,0:06:48.50,0:06:52.67,Default,,0,0,0,,Someone who is destined to become the end of his life...
Dialogue: 0,0:06:52.67,0:06:56.08,Default,,0,0,0,,Маған көп қиындық түсті.
Dialogue: 0,0:06:57.01,0:06:59.51,Default,,0,0,0,,How much did you complicate the situation?
Dialogue: 0,0:06:59.51,0:07:01.52,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:07:02.62,0:07:05.79,Default,,0,0,0,,I have no idea what will happen to that kid.
Dialogue: 0,0:07:05.79,0:07:08.62,Default,,0,0,0,,Сен бәрін өзің шештің.
Dialogue: 0,0:07:08.62,0:07:11.63,Default,,0,0,0,,Бұл үшін жауапкершілікті алыңыз.
Dialogue: 0,0:07:11.63,0:07:17.13,Default,,0,0,0,,Sigh~ Claude really has a bad personality. Ол үшін бірдеңе істеу керек.
Dialogue: 0,0:07:17.13,0:07:20.64,Default,,0,0,0,,Мен болашаққа алаңдаймын.
Dialogue: 0,0:07:20.64,0:07:24.47,Default,,0,0,0,,Жақсы! Бүгінгі кешкі ас - қуырылған сиыр еті.
Dialogue: 0,0:07:24.47,0:07:27.48,Default,,0,0,0,,Маған қарға пирогы ұнайды~
Dialogue: 0,0:07:33.98,0:07:38.49,Default,,0,0,0,,<Сол күні мені сол адамдар алып кетті>
Dialogue: 0,0:07:38.49,0:07:41.99,Default,,0,0,0,,<Ол кез менің есімде жоқ>
Dialogue: 0,0:07:41.99,0:07:44.33,Default,,0,0,0,,<Мен кіммін?>
Dialogue: 0,0:07:44.33,0:07:46.10,Default,,0,0,0,,<Менің баратын жерім қандай?>
Dialogue: 0,0:07:46.10,0:07:52.67,Default,,0,0,0,,<Мен күнделік жазуға мәжбүрлеудің шын мәні туралы ештеңе білмеймін>
Dialogue: 0,0:07:52.67,0:07:55.34,Default,,0,0,0,,《Атың кім? 》
Dialogue: 0,0:07:55.34,0:07:57.64,Default,,0,0,0,,《Lisel》
Dialogue: 0,0:08:01.28,0:08:03.28,Default,,0,0,0,,《Аа...》 《Уф...》
Dialogue: 0,0:08:03.28,0:08:05.45,Default,,0,0,0,,《(Жапырақтардың дірілдеген дыбысы)》
Dialogue: 0,0:08:05.45,0:08:07.45,Default,,0,0,0,,《Не? Бұл》《Аа...! ? 》
Dialogue: 0,0:08:07.45,0:08:09.95,Default,,0,0,0,,《Дәл қазір, бұл жігіт өз атын айтқан сәтте》
Dialogue: 0,0:08:09.95,0:08:13.96,Default,,0,0,0,,《Осы жігіттің айналасында біртүрлі желдің қысымы болған жоқ па? 》
Dialogue: 0,0:08:17.63,0:08:19.63,Default,,0,0,0,,《А...》
Dialogue: 0,0:08:22.30,0:08:26.13,Default,,0,0,0,,《Ей, сен жаңа ғана сиқыр қолдандың ба? 》
Dialogue: 0,0:08:26.13,0:08:29.64,Default,,0,0,0,,《Мен... ештеңе...》
Dialogue: 0,0:08:29.64,0:08:33.31,Default,,0,0,0,,《Ол есімді енді қолданбаған дұрыс》
Dialogue: 0,0:08:33.31,0:08:35.31,Default,,0,0,0,,《Луна? 》
Dialogue: 0,0:08:35.31,0:08:37.65,Default,,0,0,0,,《Не болғанын білмеймін》
Dialogue: 0,0:08:37.65,0:08:43.15,Default,,0,0,0,,《Бірақ бұл баланың бұл есімді қолданбағаны жақсы》
Dialogue: 0,0:08:43.15,0:08:45.15,Default,,0,0,0,,《Шын есім? 》
Dialogue: 0,0:08:45.15,0:08:47.16,Default,,0,0,0,,《Мүмкін》
Dialogue: 0,0:08:47.16,0:08:53.33,Default,,0,0,0,,《Егер есімде дұрыс болса, қара бақсылардан айырмашылығы, ақ бақсылардың сиқырлы күші аз》
Dialogue: 0,0:08:53.33,0:08:57.67,Default,,0,0,0,,《Мен олардың келісімдер мен қарғыс күшіне сүйене отырып, сиқырды қолданатынын естідім》
Dialogue: 0,0:08:57.67,0:09:01.10,Default,,0,0,0,,《Бір уақытта қарғысқа байланғандар》
Dialogue: 0,0:09:01.10,0:09:04.27,Default,,0,0,0,,《Шын есім - сиқырды басқарудың кілті》
Dialogue: 0,0:09:04.27,0:09:07.28,Default,,0,0,0,,《Өзіңіздің атыңызды басқаларға ашу – маңызды мәселе》
Dialogue: 0,0:09:07.28,0:09:10.28,Default,,0,0,0,,《Ол қарғыс нысанасын әшкерелейтін әрекет...》
Dialogue: 0,0:09:10.28,0:09:14.28,Default,,0,0,0,,《＜Не? Бұл адамдар не туралы айтып жатыр?
Dialogue: 0,0:09:14.28,0:09:17.12,Default,,0,0,0,,《Оны білмей, бізге айту дегенді қалай түсінесіңдер?》
Dialogue: 0,0:09:17.12,0:09:20.62,Default,,0,0,0,,《Ол айтарлықтай шатасуда.》
Dialogue: 0,0:09:20.62,0:09:22.62,Default,,0,0,0,,《＜Мен ше? ＞》
Dialogue: 0,0:09:22.62,0:09:24.63,Default,,0,0,0,,《Мм...》
Dialogue: 0,0:09:24.63,0:09:27.96,Default,,0,0,0,,《(Патшайым) Сіз ешқашан туылмауыңыз керек еді》
Dialogue: 0,0:09:27.96,0:09:30.30,Default,,0,0,0,,《Аа...! 》
Dialogue: 0,0:09:30.30,0:09:33.30,Default,,0,0,0,,《Ха... ха...》
Dialogue: 0,0:09:34.80,0:09:38.31,Default,,0,0,0,,《Бұл қайда...? 》
Dialogue: 0,0:09:38.31,0:09:41.64,Default,,0,0,0,,《Сіз кімсіз? 》
Dialogue: 0,0:09:41.64,0:09:45.65,Default,,0,0,0,,《Мен неге мұндамын...》
Dialogue: 0,0:09:45.65,0:09:47.65,Default,,0,0,0,,《Неге...》
Dialogue: 0,0:09:48.65,0:09:50.65,Default,,0,0,0,,《Мен...》
Dialogue: 0,0:09:51.65,0:09:54.66,Default,,0,0,0,,《＜Бұл кім...＞》
Dialogue: 0,0:09:57.66,0:09:59.99,Default,,0,0,0,,《Мен...》
Dialogue: 0,0:09:59.99,0:10:03.50,Default,,0,0,0,,《Көмегің үшін көп рахмет》
Dialogue: 0,0:10:03.50,0:10:07.00,Default,,0,0,0,,《Мүмкін олар маған көмектескен шығар...》
Dialogue: 0,0:10:07.00,0:10:09.00,Default,,0,0,0,,《Рахмет》
Dialogue: 0,0:10:09.00,0:10:12.01,Default,,0,0,0,,《Мен барамын...》
Dialogue: 0,0:10:12.01,0:10:17.35,Default,,0,0,0,,《Сізге алғыс айтатын бірдеңе болса екен.》
Dialogue: 0,0:10:17.35,0:10:20.52,Default,,0,0,0,,《Аа...! Аа... ой...》
Dialogue: 0,0:10:20.52,0:10:24.02,Default,,0,0,0,,《Ей, ештеңе айтпа》
Dialogue: 0,0:10:24.02,0:10:26.02,Default,,0,0,0,,《Уф...》
Dialogue: 0,0:10:26.02,0:10:28.02,Default,,0,0,0,,《＜Жарақат! ? ＞》
Dialogue: 0,0:10:28.02,0:10:30.33,Default,,0,0,0,,《Аа... иә? 》
Dialogue: 0,0:10:32.69,0:10:36.20,Default,,0,0,0,,《＜Е, Кино... Ко? ＞》
Dialogue: 0,0:10:36.20,0:10:38.40,Default,,0,0,0,,《＜Қуыршақ? ＞》
Dialogue: 0,0:10:43.54,0:10:45.84,Default,,0,0,0,,《(Бақаның ыңылдауы)》
Dialogue: 0,0:10:46.88,0:10:49.04,Default,,0,0,0,,《Қуыршақ телепортациясы?》
Dialogue: 0,0:10:49.04,0:10:53.21,Default,,0,0,0,,《Жара... кетті》
Dialogue: 0,0:10:53.21,0:10:56.89,Default,,0,0,0,,《Жоқ, ол қозғалды! ? 》
Dialogue: 0,0:10:56.89,0:10:59.22,Default,,0,0,0,,《Бұл адам кім? 》
Dialogue: 0,0:10:59.22,0:11:01.82,Default,,0,0,0,,《Осы баланың алған жарасы жазылмайынша》
Dialogue: 0,0:11:01.82,0:11:06.16,Default,,0,0,0,,《Сіз адал ниетпен қарауыңыз керек》
Dialogue: 0,0:11:06.16,0:11:08.16,Default,,0,0,0,,《Е...》
Dialogue: 0,0:11:08.16,0:11:11.00,Default,,0,0,0,,《Бұл сіздің бірінші жауапкершілігіңіз》
Dialogue: 0,0:11:11.00,0:11:13.00,Default,,0,0,0,,《Қатаң бол》
Dialogue: 0,0:11:13.00,0:11:17.01,Default,,0,0,0,,《Оның сиқыршы болатынына көз жеткізу үшін...》
Dialogue: 0,0:11:17.01,0:11:20.01,Default,,0,0,0,,《Құбыжық болмас үшін...》
Dialogue: 0,0:11:20.01,0:11:22.01,Default,,0,0,0,,《Жеке сезімдерден бас тарту》
Dialogue: 0,0:11:22.01,0:11:24.35,Default,,0,0,0,,《Бұл Қара орман》
Dialogue: 0,0:11:24.35,0:11:26.35,Default,,0,0,0,,《Сіз таңдадыңыз》
Dialogue: 0,0:11:26.35,0:11:30.18,Default,,0,0,0,,《Бүгіннен бастап бұл үй сенің үйің болады》
Dialogue: 0,0:11:30.18,0:11:34.86,Default,,0,0,0,,《Қандай себеп болса да, мен сенің бұл жерден кетуіңе рұқсат бермеймін》
Dialogue: 0,0:11:34.86,0:11:37.69,Default,,0,0,0,,《Осы балаға жол көрсетуші шебер бол》
Dialogue: 0,0:11:37.69,0:11:40.86,Default,,0,0,0,,《Мен шампиньондық сиқыршы Лунамын》
Dialogue: 0,0:11:40.86,0:11:43.53,Default,,0,0,0,,《Сен менің шәкіртімсің》
Dialogue: 0,0:11:43.53,0:11:46.87,Default,,0,0,0,,《Ризе, сиқыршы шәкірт...》
Dialogue: 0,0:11:46.87,0:11:48.87,Default,,0,0,0,,《Аа...》
Dialogue: 0,0:11:48.87,0:11:51.21,Default,,0,0,0,,《Бұл сенің шын есімің! 》
Dialogue: 0,0:11:51.21,0:11:53.54,Default,,0,0,0,,《А... Ризе...》
Dialogue: 0,0:11:53.54,0:11:55.54,Default,,0,0,0,,《Лиз...Ра》
Dialogue: 0,0:11:55.54,0:11:57.71,Default,,0,0,0,,《Лиз... Ро》
Dialogue: 0,0:11:57.71,0:12:01.65,Default,,0,0,0,,《Лизетта》 《(Мелинё) Бұл қыздың аты емес пе? 》
Dialogue: 0,0:12:01.65,0:12:04.99,Default,,0,0,0,,《Ризотто》 《Тағам》
Dialogue: 0,0:12:04.99,0:12:07.49,Default,,0,0,0,,《Мм...》
Dialogue: 0,0:12:07.49,0:12:10.16,Default,,0,0,0,,《Ризе жақсы емес пе? 》 《Иә》
Dialogue: 0,0:12:10.16,0:12:12.99,Default,,0,0,0,,《Луна, қолыңнан келгеннің бәрін жаса》
Dialogue: 0,0:12:12.99,0:12:15.30,Default,,0,0,0,,《Мм...》
Dialogue: 0,0:12:16.50,0:12:19.67,Default,,0,0,0,,《Аа... сенің атың Ризе》
Dialogue: 0,0:12:19.67,0:12:23.37,Default,,0,0,0,,《Болды, болды! 》
Dialogue: 0,0:12:24.34,0:12:26.64,Default,,0,0,0,,《tsk》 《(есік ашылады)》
Dialogue: 0,0:12:29.01,0:12:31.01,Default,,0,0,0,,<Дұрыс>
Dialogue: 0,0:12:31.01,0:12:34.35,Default,,0,0,0,,＜Расында, бұл атау қарға айтқандай＞
Dialogue: 0,0:12:34.35,0:12:40.36,Default,,0,0,0,,<Ол үлкен қиындықпен жасалды және сөзсіз импровизацияланған сезімге ие болды.>
Dialogue: 0,0:12:40.36,0:12:42.86,Default,,0,0,0,,<Кейін күнделігіме жазғанымдай>
Dialogue: 0,0:12:42.86,0:12:46.36,Default,,0,0,0,,<Сол кездегі сезімімді мүлдем ұмытқанмен>
Dialogue: 0,0:12:46.36,0:12:51.20,Default,,0,0,0,,《Ескі атыңды қайталама》
Dialogue: 0,0:12:51.20,0:12:55.37,Default,,0,0,0,,《Сонымен қатар, бұл жерден қашқыңыз келмейді.》
Dialogue: 0,0:12:55.37,0:12:58.17,Default,,0,0,0,,《Егер қашсаң, мен сені өлтіремін》
Dialogue: 0,0:13:00.64,0:13:05.15,Default,,0,0,0,,《＜Мен сиқыршының шәкіртімін бе? ＞》
Dialogue: 0,0:13:05.15,0:13:07.65,Default,,0,0,0,,《＜Шампиньонның сиқыршысы…＞》
Dialogue: 0,0:13:07.65,0:13:10.99,Default,,0,0,0,,<Сиқыршының шәкіртінің 1-күні>
Dialogue: 0,0:13:10.99,0:13:15.29,Default,,0,0,0,,<Бұл түн көптеген жағынан алаңдаушылық пен шатасушылыққа толы болды.>
Dialogue: 0,0:13:18.66,0:13:20.66,Default,,0,0,0,,<Қара орман>
Dialogue: 0,0:13:20.66,0:13:27.07,Default,,0,0,0,,<Зұлым рухтар, күнәкарлар және улы құбыжықтар тұратын жиіркенішті жер>
Dialogue: 0,0:13:28.50,0:13:34.18,Default,,0,0,0,,<Қара сиқыршы: күшті сиқырлы күшке ие, сондықтан басқаларға ренжімейді>
Dialogue: 0,0:13:34.18,0:13:38.35,Default,,0,0,0,,<Удың көмегімен құбыжықтар жасау және манипуляциялау, т.б.>
Dialogue: 0,0:13:38.35,0:13:44.19,Default,,0,0,0,,<Өзінің жан түршігерлік қылықтарымен адамдардың, елдің жүрегін бұзатын сұмдық бақсы...>
Dialogue: 0,0:13:44.19,0:13:46.39,Default,,0,0,0,,Күрсін...!
Dialogue: 0,0:13:47.52,0:13:51.86,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:13:51.86,0:13:56.70,Default,,0,0,0,,Ах! Аа, мен ұйықтап қалдым ...
Dialogue: 0,0:13:56.70,0:13:58.70,Default,,0,0,0,,Мен Иносукэні құтқарамын
Dialogue: 0,0:13:58.70,0:14:02.47,Default,,0,0,0,,Мен таңғы асқа ингредиенттер алуға барамын, дайындал.
Dialogue: 0,0:14:02.47,0:14:04.81,Default,,0,0,0,,Иә
Dialogue: 0,0:14:04.81,0:14:11.31,Default,,0,0,0,,<Сізге тиесілі естеліктерден басқа, сіздің кім екеніңізді есте сақтасаңыз да>
Dialogue: 0,0:14:11.31,0:14:15.15,Default,,0,0,0,,<Толығымен жойылмаған сияқты...>
Dialogue: 0,0:14:15.15,0:14:20.36,Default,,0,0,0,,Иә? Мен... кешіріңіз... Хмм.
Dialogue: 0,0:14:22.99,0:14:27.16,Default,,0,0,0,,<Шампиньон ведьмы туралы менің ішімде қалған қауесеттер>
Dialogue: 0,0:14:27.16,0:14:31.67,Default,,0,0,0,,Аа, киімдерің жарасып тұрған сияқты.
Dialogue: 0,0:14:32.67,0:14:34.67,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:34.67,0:14:38.01,Default,,0,0,0,,(Үлкен мысықтың мияуы)
Dialogue: 0,0:14:38.01,0:14:44.68,Default,,0,0,0,,<Түрі де, санасы да қараңғы, ұсқынсыз, улы ауаға толы жағымсыз иіс шығарады.>
Dialogue: 0,0:14:44.68,0:14:49.68,Default,,0,0,0,,<Бүкіл қалада күшті улы саңырауқұлақтарды өсіріп, адамдарға қиындық тудыратын бақсы>
Dialogue: 0,0:14:49.68,0:14:53.02,Default,,0,0,0,,Не? Бұл да саңырауқұлақ па? Иә дұрыс
Dialogue: 0,0:14:53.02,0:14:56.12,Default,,0,0,0,,Сіз мұны да қабылдайсыз ба? әрине!
Dialogue: 0,0:14:58.03,0:15:00.29,Default,,0,0,0,,Саңырауқұлақтың қабығын аршыңыз.
Dialogue: 0,0:15:00.29,0:15:02.30,Default,,0,0,0,,Тиісті өлшемдерге кесіңіз
Dialogue: 0,0:15:02.30,0:15:04.47,Default,,0,0,0,,Оны аздап ұсақтаңыз.
Dialogue: 0,0:15:04.47,0:15:12.14,Default,,0,0,0,,<Таңертеңгілік шық, жас шөп және гүл иістерінің қоспасына ұқсайтын салқын, мөлдір иіс.>
Dialogue: 0,0:15:12.14,0:15:15.14,Default,,0,0,0,,<Өсек-аяң аз болуы мүмкін>
Dialogue: 0,0:15:17.15,0:15:19.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:21.48,0:15:23.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:23.48,0:15:27.49,Default,,0,0,0,,Уншо... аа...
Dialogue: 0,0:15:28.49,0:15:32.83,Default,,0,0,0,,Ха ха ха ха ха... Уау!
Dialogue: 0,0:15:32.83,0:15:35.33,Default,,0,0,0,,Ах...! Мен... Жоғарыда айтылған
Dialogue: 0,0:15:35.33,0:15:38.33,Default,,0,0,0,,Шұғыл түрде сиқырмен жасап көріңіз.
Dialogue: 0,0:15:38.33,0:15:40.33,Default,,0,0,0,,Бұл өзекті мәселе.
Dialogue: 0,0:15:40.33,0:15:42.34,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:15:42.34,0:15:45.84,Default,,0,0,0,,Сізге біраз уақыт пышақты ұстауға болмайды!
Dialogue: 0,0:15:45.84,0:15:48.34,Default,,0,0,0,,Өзіңізді сүртіңіз! Ах...
Dialogue: 0,0:15:48.34,0:15:50.34,Default,,0,0,0,,<Мен қиыншылықта қалдым...>
Dialogue: 0,0:15:50.34,0:15:54.02,Default,,0,0,0,,<Неге мен өзімді бұл денеге үйренбегендей сезінемін? ＞
Dialogue: 0,0:15:54.02,0:15:57.19,Default,,0,0,0,,Сол жастағы баланы пышақпен аршып алу
Dialogue: 0,0:15:57.19,0:16:00.62,Default,,0,0,0,,Менің ойымша, әлі ерте.
Dialogue: 0,0:16:00.62,0:16:03.46,Default,,0,0,0,,Ха...! Иә
Dialogue: 0,0:16:03.46,0:16:05.46,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:05.46,0:16:08.13,Default,,0,0,0,,<Ұят, бала сияқтысың>
Dialogue: 0,0:16:08.13,0:16:11.47,Default,,0,0,0,,<Мен сиқырды қалай қолдану керектігі туралы әлі ештеңе білмеймін>
Dialogue: 0,0:16:11.47,0:16:16.30,Default,,0,0,0,,<Неге мен сиқыршының шәкірті болуды шештім...>
Dialogue: 0,0:16:16.30,0:16:20.48,Default,,0,0,0,,А, бұл шаш.
Dialogue: 0,0:16:20.48,0:16:22.98,Default,,0,0,0,,Маска...
Dialogue: 0,0:16:22.98,0:16:26.48,Default,,0,0,0,,Оған қол тигізбеңіз! Ах...
Dialogue: 0,0:16:26.48,0:16:29.65,Default,,0,0,0,,Маған ешқашан тиіспе
Dialogue: 0,0:16:29.65,0:16:32.82,Default,,0,0,0,,А... иә
Dialogue: 0,0:16:32.82,0:16:34.99,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:16:34.99,0:16:38.79,Default,,0,0,0,,<Қашып кетсең сені өлтіретін сұмдық бақсы>
Dialogue: 0,0:16:42.33,0:16:44.33,Default,,0,0,0,,Мен күттім!
Dialogue: 0,0:16:44.33,0:16:48.17,Default,,0,0,0,,Уау! Дәмді көрінеді!
Dialogue: 0,0:16:48.17,0:16:50.17,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:16:59.85,0:17:04.35,Default,,0,0,0,,《Мм...》
Dialogue: 0,0:17:11.96,0:17:13.96,Default,,0,0,0,,《Хо! 》
Dialogue: 0,0:17:13.96,0:17:15.96,Default,,0,0,0,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:17:15.96,0:17:18.30,Default,,0,0,0,,(Лиздің іші дірілдеп жатыр)
Dialogue: 0,0:17:18.30,0:17:25.31,Default,,0,0,0,,<Енді ойлап қарасам, кеше оянғаннан бері ештеңе жеген жоқпын. Жаңа ғана есіме түсті.>
Dialogue: 0,0:17:25.31,0:17:27.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:27.31,0:17:31.98,Default,,0,0,0,,<Менің ойымша, мені біртүрлі қауесеттер қатты алаңдатты>
Dialogue: 0,0:17:31.98,0:17:34.82,Default,,0,0,0,,Күрсін, дәмді екен.
Dialogue: 0,0:17:34.82,0:17:37.15,Default,,0,0,0,,Иә
Dialogue: 0,0:17:37.15,0:17:39.15,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:39.15,0:17:42.16,Default,,0,0,0,,(Мелино мен Миностың тамақ ішкен дыбысы)
Dialogue: 0,0:17:43.16,0:17:45.16,Default,,0,0,0,,Керемет Луна!
Dialogue: 0,0:17:45.16,0:17:48.16,Default,,0,0,0,,Кітаптағы құймақ сияқты.
Dialogue: 0,0:17:48.16,0:17:54.57,Default,,0,0,0,,<Мысалы, мен сиыр немесе қой болсам, мен оны дәмді деп ойлауым мүмкін...>
Dialogue: 0,0:17:57.17,0:17:59.17,Default,,0,0,0,,<Дәмі солай болды>
Dialogue: 0,0:18:00.11,0:18:02.44,Default,,0,0,0,,Өте дәмді
Dialogue: 0,0:18:02.44,0:18:06.45,Default,,0,0,0,,<Тыныс алғандай өтірік айттым...>
Dialogue: 0,0:18:06.45,0:18:09.78,Default,,0,0,0,,<Бірақ оны мен үшін бақсы жасады>
Dialogue: 0,0:18:09.78,0:18:11.79,Default,,0,0,0,,＜Мен оны жеуге бар күшімді салуым керек＞
Dialogue: 0,0:18:11.79,0:18:14.12,Default,,0,0,0,,А... (есік ашылады)
Dialogue: 0,0:18:14.12,0:18:17.96,Default,,0,0,0,,Эй, сен нені айтып тұрсың? Луна
Dialogue: 0,0:18:17.96,0:18:23.30,Default,,0,0,0,,Сиқырды тезірек меңгеру үшін баланың жалпы күнделікті әрекеттері
Dialogue: 0,0:18:23.30,0:18:27.64,Default,,0,0,0,,Қанша қиын болса да, сіз оны сиқырмен жұмыс істеуге уәде бердіңіз, солай ма?
Dialogue: 0,0:18:27.64,0:18:30.47,Default,,0,0,0,,Иә? Не? Яғни
Dialogue: 0,0:18:30.47,0:18:32.47,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:18:32.47,0:18:34.98,Default,,0,0,0,,Сіз орындадыңыз ба?
Dialogue: 0,0:18:34.98,0:18:38.48,Default,,0,0,0,,Ах... Уф... Бірақ...
Dialogue: 0,0:18:38.48,0:18:41.82,Default,,0,0,0,,Тамақтың бәрін сиқырымен жасасын!
Dialogue: 0,0:18:41.82,0:18:44.32,Default,,0,0,0,,Сізге көмектесуге рұқсат жоқ.
Dialogue: 0,0:18:44.32,0:18:46.65,Default,,0,0,0,,Ризе үшін бұл мүмкін емес.
Dialogue: 0,0:18:46.65,0:18:50.49,Default,,0,0,0,,Мен әлі де сиқырды мүлдем қолдана алмаймын, сондықтан мен өмір сүре алмаймын.
Dialogue: 0,0:18:50.49,0:18:53.10,Default,,0,0,0,,Мақсат осы, сегізаяқ! Бұл қой
Dialogue: 0,0:18:53.10,0:18:58.00,Default,,0,0,0,,Кейбір өкілеттіктер бар, оларды тек бұрышта болғанда ғана көрсетуге болады.
Dialogue: 0,0:18:58.00,0:19:02.30,Default,,0,0,0,,Мен мұны күттім және осылай жүруге уәде бердім, солай ма? Луна
Dialogue: 0,0:19:04.61,0:19:07.11,Default,,0,0,0,,Бірақ бұл басынан бастап болды ма?
Dialogue: 0,0:19:07.11,0:19:09.81,Default,,0,0,0,,Мен болашаққа алаңдаймын.
Dialogue: 0,0:19:11.11,0:19:13.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:13.11,0:19:18.29,Default,,0,0,0,,Түсіндің бе? Бізге сенудің және тапсырманы сеніп тапсырудың маңыздылығы
Dialogue: 0,0:19:18.29,0:19:20.62,Default,,0,0,0,,<Бұл қара тұман...>
Dialogue: 0,0:19:20.62,0:19:23.62,Default,,0,0,0,,<Жануардан шыққан мына қара тұман>
Dialogue: 0,0:19:23.62,0:19:27.96,Default,,0,0,0,,<Мен бұл тұманды бұрын көргендей болдым...>
Dialogue: 0,0:19:27.96,0:19:34.30,Default,,0,0,0,,<Мазасыздық, қайғы, азап, ауру, қарғыс>
Dialogue: 0,0:19:34.30,0:19:39.81,Default,,0,0,0,,<Ашу, ессіздік, зұлымдық, күнә>
Dialogue: 0,0:19:39.81,0:19:44.81,Default,,0,0,0,,<Тірі заттар өндіретін және тұтынатын барлық токсиндер>
Dialogue: 0,0:19:44.81,0:19:47.15,Default,,0,0,0,,<Осында бірінші рет көрдім>
Dialogue: 0,0:19:47.15,0:19:49.15,Default,,0,0,0,,<Бұл әлі де әлсіз...>
Dialogue: 0,0:19:49.15,0:19:51.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:51.65,0:19:57.36,Default,,0,0,0,,<Осы тұман қалың айналатын жерлерде әрқашан жаман нәрселер болады.>
Dialogue: 0,0:20:00.83,0:20:03.83,Default,,0,0,0,,<Сосын мен...>
Dialogue: 0,0:20:08.67,0:20:12.01,Default,,0,0,0,,Иә? Енді не істедің?
Dialogue: 0,0:20:12.01,0:20:14.68,Default,,0,0,0,,Ғибадатхана қыз-қызметшісінің киімі оған жарасады.
Dialogue: 0,0:20:14.68,0:20:18.38,Default,,0,0,0,,Мен, қара тұман...
Dialogue: 0,0:20:22.02,0:20:24.85,Default,,0,0,0,,Күрсін...!
Dialogue: 0,0:20:24.85,0:20:26.85,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:26.85,0:20:31.03,Default,,0,0,0,,Мен туралы бірдеңе бар... дәл қазір...
Dialogue: 0,0:20:31.03,0:20:35.53,Default,,0,0,0,,Қара тұман дедіңіз бе? Сіз
Dialogue: 0,0:20:35.53,0:20:37.70,Default,,0,0,0,,Әрине сол қара тұман
Dialogue: 0,0:20:37.70,0:20:41.54,Default,,0,0,0,,Ешқашан маған... немесе Лунаға тиіспе.
Dialogue: 0,0:20:41.54,0:20:44.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:44.37,0:20:47.37,Default,,0,0,0,,<Мен кіммін? ＞
Dialogue: 0,0:20:47.37,0:20:49.71,Default,,0,0,0,,<Неге келдің? ＞
Dialogue: 0,0:20:49.71,0:20:52.71,Default,,0,0,0,,<Неге өзіңді білмейсің? ＞
Dialogue: 0,0:20:52.71,0:20:56.38,Default,,0,0,0,,<Менің басымда бұлыңғыр болып қалған нәрсе...>
Dialogue: 0,0:20:56.38,0:21:00.15,Default,,0,0,0,,《(Патшайым) Сіз ешқашан туылмауыңыз керек еді》
Dialogue: 0,0:21:00.15,0:21:03.32,Default,,0,0,0,,《(Ана) Есіміңді ұмытпа...》
Dialogue: 0,0:21:03.32,0:21:07.33,Default,,0,0,0,,<Бұл не деген дауыс... Бұрынғы қара тұман не? ＞
Dialogue: 0,0:21:07.33,0:21:10.16,Default,,0,0,0,,<Мен оны қайдан білемін? ＞
Dialogue: 0,0:21:10.16,0:21:12.50,Default,,0,0,0,,<Мен кіммін...>
Dialogue: 0,0:21:12.50,0:21:15.17,Default,,0,0,0,,Ең сорақысы сол жігіт...
Dialogue: 0,0:21:15.17,0:21:19.34,Default,,0,0,0,,Адамдар мен заттардан улы ауаны бейсаналы түрде жұтып қоюы мүмкін.
Dialogue: 0,0:21:19.34,0:21:22.01,Default,,0,0,0,,Оның уақыт шегі
Dialogue: 0,0:21:22.01,0:21:26.01,Default,,0,0,0,,Бұл жылдамдықпен ол біз ойлағаннан да жылдамырақ.
Dialogue: 0,0:21:26.01,0:21:29.32,Default,,0,0,0,,Бірақ бұл бала кінәлі...
Dialogue: 0,0:21:30.68,0:21:34.69,Default,,0,0,0,,Оның ағзасына сыйымдылығынан асатын у мөлшерінен жылдамырақ.
Dialogue: 0,0:21:34.69,0:21:38.53,Default,,0,0,0,,Егер сіз бұл туралы бірдеңе жасауға сиқырлы күшке ие болмасаңыз ...
Dialogue: 0,0:21:38.53,0:21:42.20,Default,,0,0,0,,<Не... айтып тұрсың? ＞
Dialogue: 0,0:21:42.20,0:21:44.87,Default,,0,0,0,,<Мен туралы...? ＞
Dialogue: 0,0:21:44.87,0:21:47.70,Default,,0,0,0,,Бұл бала улы құбыжық.
Dialogue: 0,0:21:47.70,0:21:53.37,Default,,0,0,0,,Үміт жоқ екені анықталғаннан кейін бірден өлтіру ғана қалады.
Dialogue: 0,0:21:53.37,0:21:56.54,Default,,0,0,0,,Ах... ха...
Dialogue: 0,0:21:56.54,0:21:58.88,Default,,0,0,0,,Бұл әлі де жақсы ма? Луна
Dialogue: 0,0:21:58.88,0:22:02.88,Default,,0,0,0,,Егер сіз өзіңіздің жылы көзқарасыңызды ұстансаңыз, бұл міндетті түрде болады.
Dialogue: 0,0:22:05.49,0:22:09.66,Default,,0,0,0,,Бірақ мен оның жинаған уды сору үшін саңырауқұлақтарды қолдансам,
Dialogue: 0,0:22:09.66,0:22:12.83,Default,,0,0,0,,Жауапты асығыс айтудың қажеті жоқ.
Dialogue: 0,0:22:12.83,0:22:15.16,Default,,0,0,0,,Осыған байланысты тәуекелдің ықтималдығы...
Dialogue: 0,0:22:15.16,0:22:17.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:19.17,0:22:22.50,Default,,0,0,0,,Ха ха ха ха ха ха...
Dialogue: 0,0:22:22.50,0:22:25.17,Default,,0,0,0,,Ах, Лиза, қайда бара жатырсың?
Dialogue: 0,0:22:25.17,0:22:27.58,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:22:29.51,0:22:32.68,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:22:32.68,0:22:37.18,Default,,0,0,0,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:22:37.18,0:22:42.02,Default,,0,0,0,,(Порнарефф) Не дедің!? Жынды! Аузыңды жап!
Dialogue: 0,0:22:42.02,0:23:30.04,Default,,0,0,0,,♬～
Dialogue: 0,0:23:31.54,0:23:37.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory