Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.83,0:00:48.71,Default,,0,0,0,,♬～
Dialogue: 0,0:01:41.70,0:01:44.53,Default,,0,0,0,,Сәлем➡
Dialogue: 0,0:01:44.53,0:01:46.60,Default,,0,0,0,,Бұл Луна.
Dialogue: 0,0:01:46.60,0:01:48.60,Default,,0,0,0,,Мырза
Dialogue: 0,0:01:48.60,0:01:51.21,Default,,0,0,0,,Осылайша біз танысып қалдық➡
Dialogue: 0,0:01:51.21,0:01:54.88,Default,,0,0,0,,Өмірінің ақыры болуды жазған адам...➡
Dialogue: 0,0:01:54.88,0:01:56.95,Default,,0,0,0,,Қарғыс атқан балаға
Dialogue: 0,0:01:56.95,0:01:59.21,Default,,0,0,0,,Қарғыс атқан бала...!
Dialogue: 0,0:01:59.21,0:02:01.22,Default,,0,0,0,,Кел, Луна
Dialogue: 0,0:02:01.22,0:02:04.69,Default,,0,0,0,,Толып жатқан уды осында қалдыр.
Dialogue: 0,0:02:05.82,0:02:07.82,Default,,0,0,0,,Тіпті сен де
Dialogue: 0,0:02:07.82,0:02:12.19,Default,,0,0,0,,Ақырзаманның уы денеге ауыр.
Dialogue: 0,0:02:14.90,0:02:19.84,Default,,0,0,0,,Бала өте әдемі болды.
Dialogue: 0,0:02:19.84,0:02:24.84,Default,,0,0,0,,<Мен сорған саңырауқұлақтар маған сол кезде жеткізген>
Dialogue: 0,0:02:24.84,0:02:27.91,Default,,0,0,0,,＜Жүрегің мөлдір болсын＞
Dialogue: 0,0:02:27.91,0:02:30.68,Default,,0,0,0,,Өйткені сіз осындай адамсыз➡
Dialogue: 0,0:02:30.68,0:02:34.65,Default,,0,0,0,,Бұл оқиғаның соңы болуы мүмкін.
Dialogue: 0,0:02:37.69,0:02:43.66,Default,,0,0,0,,Луна Сіз сияқты
Dialogue: 0,0:02:45.36,0:02:47.36,Default,,0,0,0,,У... Уа, түсінемін...
Dialogue: 0,0:02:47.36,0:02:50.03,Default,,0,0,0,,Луна бұрынғы қарғыс атқан бала...?
Dialogue: 0,0:02:52.87,0:02:58.54,Default,,0,0,0,,<Лунаның тағдыры осы баламен бірдей...>
Dialogue: 0,0:02:58.54,0:03:01.14,Default,,0,0,0,,<Бірақ Луна...>
Dialogue: 0,0:03:01.14,0:03:03.21,Default,,0,0,0,,<Бұл нені білдіреді...>
Dialogue: 0,0:03:03.21,0:03:07.22,Default,,0,0,0,,Қара сиқыршылар ластану, кек және оба.
Dialogue: 0,0:03:07.22,0:03:11.49,Default,,0,0,0,,Бұл дүниеде әртүрлі уларды жоюмен айналысу арқылы.
Dialogue: 0,0:03:11.49,0:03:14.82,Default,,0,0,0,,Қарапайым адамдар мен қарапайым сиқыршылардан айырмашылығы,
Dialogue: 0,0:03:14.82,0:03:18.69,Default,,0,0,0,,Уға өте төзімді (жәндіктердің шебері)
Dialogue: 0,0:03:23.33,0:03:25.33,Default,,0,0,0,,Уларды тазарту әрекеттері үшін➡
Dialogue: 0,0:03:25.33,0:03:30.41,Default,,0,0,0,,Осылайша көптеген адамдар улы тіршілік иелеріне таныс.
Dialogue: 0,0:03:30.41,0:03:36.41,Default,,0,0,0,,Сондықтан адамдар бізді сиқыршыларды уландырушы сиқыршылар деп атайды.
Dialogue: 0,0:03:36.41,0:03:42.02,Default,,0,0,0,,Бізде улы төзімділік ерекше.
Dialogue: 0,0:03:42.02,0:03:44.02,Default,,0,0,0,,Луна сияқты
Dialogue: 0,0:03:44.02,0:03:49.52,Default,,0,0,0,,Улы тыныс Тері улы және уды денесіне сіңіреді➡
Dialogue: 0,0:03:49.52,0:03:53.03,Default,,0,0,0,,Аматсуса тіпті улы тіршілік иелерінде де жоқ күш➡
Dialogue: 0,0:03:53.03,0:03:58.03,Default,,0,0,0,,Уларды ыдырататын және тазартатын конституциясы бар сиқыршы
Dialogue: 0,0:03:58.03,0:04:03.31,Default,,0,0,0,,Дүние кең болса да, Луна, бұл жалғыз.
Dialogue: 0,0:04:05.64,0:04:09.48,Default,,0,0,0,,Бұл кісі бастапқыда қарғыс атқан бала болған.
Dialogue: 0,0:04:09.48,0:04:13.55,Default,,0,0,0,,Бір кездері өмірінің соңы болуы керек болған адам ретінде.
Dialogue: 0,0:04:13.55,0:04:16.55,Default,,0,0,0,,Қалдықтардың бұған қатысы бар шығар.
Dialogue: 0,0:04:16.55,0:04:18.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:18.82,0:04:23.49,Default,,0,0,0,,<Соңы болуы керек нәрсенің қалдықтары...>
Dialogue: 0,0:04:23.49,0:04:27.83,Default,,0,0,0,,<Луна қарғыс атқан бала болса да>
Dialogue: 0,0:04:27.83,0:04:30.70,Default,,0,0,0,,<Сіз өміріңіздің соңы болудан құтылдыңыз ба? ＞
Dialogue: 0,0:04:33.17,0:04:37.17,Default,,0,0,0,,<Неге? Бірақ...＞
Dialogue: 0,0:04:37.17,0:04:41.01,Default,,0,0,0,,＜Сондықтан Луна бұл балаға осылай қарайды...＞
Dialogue: 0,0:04:41.01,0:04:44.08,Default,,0,0,0,,Тағдырынан бас тартқан қарғыс баласы
Dialogue: 0,0:04:44.08,0:04:47.65,Default,,0,0,0,,Біздің білуімізше➡
Dialogue: 0,0:04:47.65,0:04:50.55,Default,,0,0,0,,Бұл қыз жалғыз
Dialogue: 0,0:04:51.19,0:04:53.19,Default,,0,0,0,,<Бұл дүниеде тек екі адам>
Dialogue: 0,0:04:53.19,0:04:55.66,Default,,0,0,0,,<Қарғыс атқан мүшелер...>
Dialogue: 0,0:04:57.69,0:05:01.30,Default,,0,0,0,,Луна қарғыс атқан бала және бір мезгілде
Dialogue: 0,0:05:01.30,0:05:04.63,Default,,0,0,0,,Оның сиқырлы күштің күшті көзі болды.
Dialogue: 0,0:05:04.63,0:05:06.64,Default,,0,0,0,,《(Луна жылап жатыр)》
Dialogue: 0,0:05:06.64,0:05:08.64,Default,,0,0,0,,Саған ешкім айтпаса да➡
Dialogue: 0,0:05:08.64,0:05:11.71,Default,,0,0,0,,Денеде, жерде, атмосферада➡
Dialogue: 0,0:05:11.71,0:05:15.71,Default,,0,0,0,,Өйткені ол сиқырлы күштің барлық түрін бойына сіңіре алатын бала еді➡
Dialogue: 0,0:05:15.71,0:05:21.15,Default,,0,0,0,,Сиқырға ие болыңыз және уды тазартатын денеге ие болыңыз➡
Dialogue: 0,0:05:21.15,0:05:23.82,Default,,0,0,0,,Біздің барлық сынақтардан өту➡
Dialogue: 0,0:05:23.82,0:05:27.29,Default,,0,0,0,,Қарғыс атқан баланың тағдырын жеңді.
Dialogue: 0,0:05:42.17,0:05:46.84,Default,,0,0,0,,Луна – бұрын-соңды болмаған, ерекше, ғажайып бала.
Dialogue: 0,0:05:46.84,0:05:50.31,Default,,0,0,0,,<Луна тағдырды жеңді...>
Dialogue: 0,0:05:53.52,0:05:57.02,Default,,0,0,0,,Қарғамен тым көп сөйлестім.
Dialogue: 0,0:05:57.02,0:06:02.79,Default,,0,0,0,,Мәселе мынада: бұл қыз өмір сүрсін және оның улық сиқыршы ретіндегі мүмкіндігіне бәс тігесін.
Dialogue: 0,0:06:02.79,0:06:05.79,Default,,0,0,0,,Көзге көрінетін талант болды➡
Dialogue: 0,0:06:05.79,0:06:08.13,Default,,0,0,0,,Бірақ…➡
Dialogue: 0,0:06:08.13,0:06:10.63,Default,,0,0,0,,Бұл адам басқаша.
Dialogue: 0,0:06:10.63,0:06:14.14,Default,,0,0,0,,Бәрі біткенше күтуге тым кеш
Dialogue: 0,0:06:14.14,0:06:16.81,Default,,0,0,0,,Біз тұқымдарды өніп шықпай тұрып өлтіруіміз керек.
Dialogue: 0,0:06:16.81,0:06:20.31,Default,,0,0,0,,Қарғыс оянса, талай жанды алып кетеді.
Dialogue: 0,0:06:20.31,0:06:23.65,Default,,0,0,0,,Бұл дүниедегі улы залал үдей түсуде
Dialogue: 0,0:06:23.65,0:06:26.31,Default,,0,0,0,,Ол адамнан аулақ болыңыз!
Dialogue: 0,0:06:26.31,0:06:29.99,Default,,0,0,0,,Гомура (Гүл шебері) Эй, үй ішінде...
Dialogue: 0,0:06:32.82,0:06:34.99,Default,,0,0,0,,<Бұл не! ? ＞
Dialogue: 0,0:06:40.66,0:06:43.33,Default,,0,0,0,,Уау! (Меринос) Луна!
Dialogue: 0,0:06:43.33,0:06:45.40,Default,,0,0,0,,Ай!
Dialogue: 0,0:06:45.40,0:06:48.34,Default,,0,0,0,,Көпіршіктер... Көпіршіктер...
Dialogue: 0,0:06:48.34,0:06:51.34,Default,,0,0,0,,Ой, бұл грильде пісірілген саңырауқұлаққа ұқсайды➡
Dialogue: 0,0:06:51.34,0:06:55.34,Default,,0,0,0,,Жылу әлі де ең нашар
Dialogue: 0,0:06:55.34,0:06:57.85,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:06:57.85,0:07:00.52,Default,,0,0,0,,Клодты күтіңіз
Dialogue: 0,0:07:05.85,0:07:08.12,Default,,0,0,0,,Ух... а (Мелинё) а
Dialogue: 0,0:07:10.03,0:07:11.99,Default,,0,0,0,,Тесік пе?
Dialogue: 0,0:07:23.81,0:07:31.48,Default,,0,0,0,,(Лунаның қатты тыныс алуы)
Dialogue: 0,0:07:35.48,0:07:37.95,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:07:41.49,0:07:43.49,Default,,0,0,0,,Сіз не ойладыңыз!
Dialogue: 0,0:07:43.49,0:07:46.83,Default,,0,0,0,,Егер мен бір қателессем, күйіп кетер едім!
Dialogue: 0,0:07:46.83,0:07:49.50,Default,,0,0,0,,Сол баланы қорғап өлесің бе? ?
Dialogue: 0,0:07:49.50,0:07:52.17,Default,,0,0,0,,Айналаңыздағылардың айтқанын тыңдаңыз!
Dialogue: 0,0:07:52.17,0:07:54.17,Default,,0,0,0,,Бұл жолы бәрі жақсы болғанына қуаныштымын, бірақ... (Жалын сиқыршысы) Құс➡
Dialogue: 0,0:07:54.17,0:07:57.24,Default,,0,0,0,,Неге ол біздің орнымызға ашуланады?
Dialogue: 0,0:07:57.24,0:08:01.11,Default,,0,0,0,,Кел, ерке, сен маған ұнамайтын түрің шығар.
Dialogue: 0,0:08:01.11,0:08:04.11,Default,,0,0,0,,Күшік, жоқ
Dialogue: 0,0:08:04.11,0:08:06.08,Default,,0,0,0,,Ах
Dialogue: 0,0:08:07.12,0:08:10.79,Default,,0,0,0,,Не? Біртүрлі болса да?
Dialogue: 0,0:08:10.79,0:08:12.85,Default,,0,0,0,,(Сатсуитаке айқайлау)
Dialogue: 0,0:08:12.85,0:08:15.29,Default,,0,0,0,,Ах tsk!
Dialogue: 0,0:08:15.29,0:08:18.96,Default,,0,0,0,,Бұл Сатсуитаке! Луна: Сен оны қашан өсірдің?
Dialogue: 0,0:08:18.96,0:08:20.96,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:20.96,0:08:23.63,Default,,0,0,0,,А... а...
Dialogue: 0,0:08:24.80,0:08:27.14,Default,,0,0,0,,Уау~ Барған сайын үлкейіп барады➡
Dialogue: 0,0:08:27.14,0:08:29.47,Default,,0,0,0,,Қаншалықты кісі өлтіру ниеті!
Dialogue: 0,0:08:29.47,0:08:31.47,Default,,0,0,0,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:08:31.47,0:08:33.64,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:08:35.31,0:08:37.65,Default,,0,0,0,,Уау! Satuitake fire daruma➡
Dialogue: 0,0:08:37.65,0:08:40.62,Default,,0,0,0,,Төбеге соқты!
Dialogue: 0,0:08:48.66,0:08:51.99,Default,,0,0,0,,<Жай ғана ой болса да, ол қандай құдіретті...>
Dialogue: 0,0:08:51.99,0:08:54.00,Default,,0,0,0,,<Қорқыныш...>
Dialogue: 0,0:08:54.00,0:08:56.83,Default,,0,0,0,,Жалынды осы жерде ұстаңыз➡
Dialogue: 0,0:08:56.83,0:09:02.67,Default,,0,0,0,,Әзірге асығыс шешім қабылдаудан аулақ болып, барлығымен дұрыс пікірлесейік➡
Dialogue: 0,0:09:02.67,0:09:06.34,Default,,0,0,0,,Сондай-ақ, тәтті саңырауқұлақ өсірсеңіз, болды.
Dialogue: 0,0:09:06.34,0:09:08.34,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:09:08.34,0:09:12.01,Default,,0,0,0,,Мен де оның пікірін тыңдауым керек.
Dialogue: 0,0:09:14.85,0:09:18.92,Default,,0,0,0,,Мен бұл баладан сиқырдың көзін сезінемін.
Dialogue: 0,0:09:18.92,0:09:20.92,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:09:20.92,0:09:24.53,Default,,0,0,0,,Оның құдіреті ақ бақсының күші.
Dialogue: 0,0:09:24.53,0:09:26.69,Default,,0,0,0,,Бұл туралы айтудың қажеті жоқ.
Dialogue: 0,0:09:27.60,0:09:33.20,Default,,0,0,0,,Десе де, өлілерден құтылу мүмкін екені сөзсіз.
Dialogue: 0,0:09:33.20,0:09:35.27,Default,,0,0,0,,Бұл мұқият экскурсия.
Dialogue: 0,0:09:35.27,0:09:41.24,Default,,0,0,0,,Тәтті армандарыңа жабыспа, өйткені сен жалғыз адамның өмірін қиюға дайын емессің.
Dialogue: 0,0:09:42.71,0:09:46.21,Default,,0,0,0,,Мен бұл баланы өсіремін.
Dialogue: 0,0:09:46.21,0:09:52.05,Default,,0,0,0,,Мен бұл баланы міндетті түрде сиқыршы етемін.
Dialogue: 0,0:09:52.05,0:09:55.89,Default,,0,0,0,,Менде бар нәрсені мына балаға құй
Dialogue: 0,0:09:55.89,0:10:00.83,Default,,0,0,0,,Қарғыс атқан баланың тағдырын өзгерте алатын сиқыршы бол.
Dialogue: 0,0:10:00.83,0:10:02.80,Default,,0,0,0,,(Ватару) Ой, расымен бе? Мен ойлағаннан кіші екен.
Dialogue: 0,0:10:04.50,0:10:06.47,Default,,0,0,0,,Мен сенімдімін...!
Dialogue: 0,0:10:10.00,0:10:15.51,Default,,0,0,0,,Сондықтан... Қарғыс атқан баланың тағдырына қарсы шықтым.
Dialogue: 0,0:10:15.51,0:10:18.18,Default,,0,0,0,,Біз қазір осылай өмір сүріп жатырмыз
Dialogue: 0,0:10:18.18,0:10:21.45,Default,,0,0,0,,Менің ойымша, сондықтан ...
Dialogue: 0,0:10:24.69,0:10:28.76,Default,,0,0,0,,Бұл кездесу мені қара бақсы болып жүруге жетелейді.
Dialogue: 0,0:10:28.76,0:10:32.23,Default,,0,0,0,,Мен бұл менің келесі тағдырыма нұсқау болғандай сезінемін ...
Dialogue: 0,0:10:35.76,0:10:40.37,Default,,0,0,0,,Қарғыс атқан баланы құрдымға жібермей адам етіп өсіресің.
Dialogue: 0,0:10:40.37,0:10:43.74,Default,,0,0,0,,Сіз бізге жол көрсеткіңіз келе ме?
Dialogue: 0,0:10:44.71,0:10:49.21,Default,,0,0,0,,Мұны істеудің жалғыз жолы - денеңізге у салу➡
Dialogue: 0,0:10:49.21,0:10:52.05,Default,,0,0,0,,Сіз жарты өмірлік қара бақсысыз ба? ➡
Dialogue: 0,0:10:52.05,0:10:54.05,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:10:54.05,0:10:58.05,Default,,0,0,0,,Оның үстіне мен осы уақытқа дейін бірде-бір шәкірт алған емеспін➡
Dialogue: 0,0:10:58.05,0:11:00.02,Default,,0,0,0,,Супер коммуникацияның бұзылуы
Dialogue: 0,0:11:00.99,0:11:03.46,Default,,0,0,0,,Бұл жай ғана қиял
Dialogue: 0,0:11:05.06,0:11:07.33,Default,,0,0,0,,Бірақ ол дұрыс.
Dialogue: 0,0:11:07.33,0:11:14.17,Default,,0,0,0,,Болашақтың аяқталуына жол бермеу Өмірді өлтіру болашақты қорғаудың жалғыз жолы болып табылатын қазіргі жағдайдың даналығы қандай?
Dialogue: 0,0:11:14.17,0:11:18.17,Default,,0,0,0,,Менің ойымша, ешкім олай ойламайды.
Dialogue: 0,0:11:18.17,0:11:20.68,Default,,0,0,0,,Құс шебері
Dialogue: 0,0:11:20.68,0:11:23.24,Default,,0,0,0,,Сіз бұл жай қиял дейсіз, бірақ...
Dialogue: 0,0:11:26.01,0:11:30.52,Default,,0,0,0,,In the first place, her path up until now has been completely unusual.
Dialogue: 0,0:11:30.52,0:11:33.52,Default,,0,0,0,,Бұл жай ғана арман.
Dialogue: 0,0:11:33.52,0:11:35.52,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:35.52,0:11:39.19,Default,,0,0,0,,Оларды тез өлтіру арқылы мәселе шешілетіні рас.
Dialogue: 0,0:11:39.19,0:11:42.86,Default,,0,0,0,,Мен өзімді тұйыққа тірелгендей сезінемін. Иә.
Dialogue: 0,0:11:42.86,0:11:45.37,Default,,0,0,0,,Сиқыршы аң...
Dialogue: 0,0:11:45.37,0:11:50.04,Default,,0,0,0,,Болашақ үшін ақылды да, тәуекелді де аямаймыз дейді.
Dialogue: 0,0:11:50.04,0:11:52.04,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:52.04,0:11:54.71,Default,,0,0,0,,Иә иә tsk
Dialogue: 0,0:11:54.71,0:11:56.78,Default,,0,0,0,,Іс осылай жалғаса берсе, нәтиже анық болмайды.
Dialogue: 0,0:11:56.78,0:12:00.65,Default,,0,0,0,,Бұл жиналыс сияқты, үкім шығарайық.
Dialogue: 0,0:12:01.65,0:12:08.49,Default,,0,0,0,,Дауыс беру тақырыбы: ``Луна баланы сиқыршы ретінде оқытуға тағайындалу керек пе, жоқ па?''➡
Dialogue: 0,0:12:08.49,0:12:12.16,Default,,0,0,0,,Мақұлдау қабылданса да, бала тәрбиесіндегі сәтсіздік белгілері болса➡
Dialogue: 0,0:12:12.16,0:12:14.50,Default,,0,0,0,,Кәмелетке толмаған адам жазаға тартылады ➡
Dialogue: 0,0:12:14.50,0:12:18.17,Default,,0,0,0,,Егер жоқ болса, өткеннен кейін бірден орындалады
Dialogue: 0,0:12:18.17,0:12:22.17,Default,,0,0,0,,Сонымен қатар, бұл мәселеде оған зорлықпен қарсылық көрсетілді.
Dialogue: 0,0:12:22.17,0:12:26.01,Default,,0,0,0,,Шампиньондық сиқыршыға қарсы санкциялар
Dialogue: 0,0:12:26.01,0:12:28.01,Default,,0,0,0,,Бұл туралы кейінірек
Dialogue: 0,0:12:28.01,0:12:31.28,Default,,0,0,0,,Сіз қалай ойлайсыз? Барлығы Луна
Dialogue: 0,0:12:37.52,0:12:41.86,Default,,0,0,0,,Сіз қалай ойлайсыз? Барлығы Луна
Dialogue: 0,0:12:41.86,0:12:44.19,Default,,0,0,0,,Қарсылық жоқ Қарсылық жоқ
Dialogue: 0,0:12:44.19,0:12:46.66,Default,,0,0,0,,Қарсылық жоқ Қарсылық жоқ
Dialogue: 0,0:12:47.86,0:12:52.37,Default,,0,0,0,,Шартты түрде нені білдіреді?
Dialogue: 0,0:12:52.37,0:12:57.37,Default,,0,0,0,,Басқа кеңесші: Жел шебері жоқ
Dialogue: 0,0:12:57.37,0:12:59.71,Default,,0,0,0,,Әй, сол жалқау.
Dialogue: 0,0:12:59.71,0:13:03.48,Default,,0,0,0,,《(Жел шебері) Кешіріңіз, кешіріңіз, мен бәрін Хомура-кунға қалдырдым! 》
Dialogue: 0,0:13:04.48,0:13:06.48,Default,,0,0,0,,《Күте тұрыңыз! 》
Dialogue: 0,0:13:06.48,0:13:09.48,Default,,0,0,0,,《(Жел шебері) Футон мені шақырып жатыр~ Хахахаха...》
Dialogue: 0,0:13:09.48,0:13:15.16,Default,,0,0,0,,Оның жиналыстағы барлық шешімдері маған байланысты.
Dialogue: 0,0:13:15.16,0:13:17.83,Default,,0,0,0,,Бұл дененің жақсы болғанына шағым емес пе?
Dialogue: 0,0:13:17.83,0:13:19.83,Default,,0,0,0,,Мен айттым
Dialogue: 0,0:13:19.83,0:13:22.66,Default,,0,0,0,,Оның дауысы менімен бірдей.
Dialogue: 0,0:13:22.66,0:13:25.00,Default,,0,0,0,,Иә? Бұл не!
Dialogue: 0,0:13:25.00,0:13:27.00,Default,,0,0,0,,Жәндіктердің сиқыршылары ше?
Dialogue: 0,0:13:27.00,0:13:31.84,Default,,0,0,0,,Мен өз пікірімді қалдырып, хайуандық сиқыршы сияқты әрекет етуге дайынмын.
Dialogue: 0,0:13:31.84,0:13:35.91,Default,,0,0,0,,Егер ол жасырын түрде мойындалса, мәселе де жоқ.
Dialogue: 0,0:13:35.91,0:13:37.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:37.91,0:13:42.52,Default,,0,0,0,,Түсіндік, шешім қабылдап көрейік.
Dialogue: 0,0:13:42.52,0:13:44.49,Default,,0,0,0,,(тұз)
Dialogue: 0,0:13:50.86,0:13:53.73,Default,,0,0,0,,Оң жақтағы жақтаушылар
Dialogue: 0,0:13:55.20,0:14:01.20,Default,,0,0,0,,Құс, су, аң, жәндік немесе 4 адамнан жоғары
Dialogue: 0,0:14:01.20,0:14:04.67,Default,,0,0,0,,Олай болса, жоқ десең, солға қарай жүр.
Dialogue: 0,0:14:07.14,0:14:12.98,Default,,0,0,0,,Жалын гүлі Тас Дауысты жалынға тапсыру желі
Dialogue: 0,0:14:12.98,0:14:14.95,Default,,0,0,0,,4 адамнан көп
Dialogue: 0,0:14:17.49,0:14:22.49,Default,,0,0,0,,Әй, мен бұл туралы біраз болды, бірақ сіз тілді түсінбейсіз бе?
Dialogue: 0,0:14:22.49,0:14:26.83,Default,,0,0,0,,Міне, менде бұлыңғыр сезім болды.
Dialogue: 0,0:14:26.83,0:14:30.83,Default,,0,0,0,,Бірақ басқаша қалай айта аламын...
Dialogue: 0,0:14:30.83,0:14:35.34,Default,,0,0,0,,Мен телепатия арқылы жағдайды қалай да түсіне аламын деп ойлаймын.
Dialogue: 0,0:14:35.34,0:14:37.71,Default,,0,0,0,,Сіз бос слипті айтасыз ба?
Dialogue: 0,0:14:42.01,0:14:47.01,Default,,0,0,0,,Эй, мен біртүрлі жіптермен ойнай бастадым.
Dialogue: 0,0:14:47.01,0:14:54.02,Default,,0,0,0,,-да «Шығыс сиқыршысы» қалыс қалған деп есептелетініне қатысты дауыс тең болды, бірақ біз қайтадан дауыс беруіміз керек пе?
Dialogue: 0,0:14:54.02,0:14:57.09,Default,,0,0,0,,Олай болса, жел тайғақтарынан құтылу жақсы емес пе? ➡
Dialogue: 0,0:14:57.09,0:14:59.09,Default,,0,0,0,,Онда жоқ нәрсе жарамсыз.
Dialogue: 0,0:14:59.09,0:15:02.66,Default,,0,0,0,,Не? Мен қайттым...
Dialogue: 0,0:15:03.97,0:15:06.13,Default,,0,0,0,,Эй!
Dialogue: 0,0:15:12.47,0:15:14.54,Default,,0,0,0,,Не? (Құс шебері) Тоқтауға жол бермеу үшін бөгетпен➡
Dialogue: 0,0:15:14.54,0:15:19.11,Default,,0,0,0,,Бұл кездесуге бізден басқа ешкім кіре алмайды.
Dialogue: 0,0:15:22.98,0:15:24.95,Default,,0,0,0,,Күте тұрыңыз! Жалыннан!
Dialogue: 0,0:15:29.99,0:15:31.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:37.06,0:15:39.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:39.33,0:15:43.34,Default,,0,0,0,,Бұл... мысық сиқыршы ма?
Dialogue: 0,0:15:43.34,0:15:49.18,Default,,0,0,0,,Мен оның бақсылық аңшылықта өмірін жоғалтқанын естідім, бірақ оның жанын неге алып кетті?
Dialogue: 0,0:15:49.18,0:15:53.65,Default,,0,0,0,,Осы тосқауылдың ішінде өлген адам ретінде мен қалай...
Dialogue: 0,0:15:58.19,0:16:00.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:00.19,0:16:03.79,Default,,0,0,0,,Мен Лунаға сенемін
Dialogue: 0,0:16:03.79,0:16:09.13,Default,,0,0,0,,Мен Лунаға сенемін➡
Dialogue: 0,0:16:09.13,0:16:11.20,Default,,0,0,0,,Сену...
Dialogue: 0,0:16:16.64,0:16:21.48,Default,,0,0,0,,《⚟Бұл қара орман болғанға дейін ағаштар мен тіршілік иелері уланған➡》
Dialogue: 0,0:16:21.48,0:16:25.48,Default,,0,0,0,,《Бұл зиянкестер мен зұлым рухтардың үйі болғанымен➡》
Dialogue: 0,0:16:25.48,0:16:30.82,Default,,0,0,0,,《Сіз мұнда тұра бастағаннан бері қара орман емес, улы саңырауқұлақ орманы болды➡》
Dialogue: 0,0:16:30.82,0:16:33.99,Default,,0,0,0,,《Тіпті мысықтар да жан тыныштығымен ойнай алады》
Dialogue: 0,0:16:35.66,0:16:40.50,Default,,0,0,0,,《⚟Ей, менің лақап атым "Дороти-сан" сәл бейтаныс адамның мінез-құлқы сияқты➡》
Dialogue: 0,0:16:40.50,0:16:43.26,Default,,0,0,0,,《Сіз мені “Дороти апа” деп атай аласыз.》
Dialogue: 0,0:16:51.01,0:16:52.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:07.19,0:17:11.03,Default,,0,0,0,,Бұл қолдауды бір дауыспен алға қояды.
Dialogue: 0,0:17:11.03,0:17:14.03,Default,,0,0,0,,Не...! Ол тек кеңестің мүшесі емес,
Dialogue: 0,0:17:14.03,0:17:17.97,Default,,0,0,0,,Биліксіз кірген дөрекі рух.
Dialogue: 0,0:17:17.97,0:17:21.30,Default,,0,0,0,,Дауыстарға қосу мүмкін емес...
Dialogue: 0,0:17:21.30,0:17:27.98,Default,,0,0,0,,Достарыңыздың ренжіген жандары үшін сөздеріңіз тым дөрекі емес пе?
Dialogue: 0,0:17:27.98,0:17:29.94,Default,,0,0,0,,Тас...
Dialogue: 0,0:17:31.98,0:17:38.15,Default,,0,0,0,,Менің ойымша, ол бір нәрсені айтқысы келгені сонша, бұл дөрекі екенін білсе де, кірді.
Dialogue: 0,0:17:43.82,0:17:46.29,Default,,0,0,0,,《(Мысық сиқыршы) Мен Лунаға сенемін》
Dialogue: 0,0:17:50.90,0:17:52.87,Default,,0,0,0,,《(Мысық сиқыршы) Мен сенемін》
Dialogue: 0,0:17:57.67,0:17:59.67,Default,,0,0,0,,Жарамсыз!
Dialogue: 0,0:17:59.67,0:18:01.68,Default,,0,0,0,,Өлгендердің соңғы тілегі
Dialogue: 0,0:18:01.68,0:18:05.75,Default,,0,0,0,,Бейбіт өлу үшін өкінішіңді тепкілейсің бе?
Dialogue: 0,0:18:05.75,0:18:08.12,Default,,0,0,0,,Тақырыпты өзгертпеңіз!
Dialogue: 0,0:18:09.52,0:18:13.02,Default,,0,0,0,,Грильде пісірілген тәтті картоп Грильдегі ірімшік
Dialogue: 0,0:18:13.02,0:18:14.99,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:18:16.52,0:18:20.03,Default,,0,0,0,,Ол Лунаны салыстырмалы түрде жақын біледі.
Dialogue: 0,0:18:20.03,0:18:22.36,Default,,0,0,0,,Бұл сөздер мүлдем жеңіл емес.
Dialogue: 0,0:18:22.36,0:18:29.04,Default,,0,0,0,,Оның реквиемі үшін дұға етудің орнына, неге оның өтінішін ерекшелік ретінде қабылдамасқа?
Dialogue: 0,0:18:30.71,0:18:33.71,Default,,0,0,0,,Жақсы (Жалын шебері) Гүл
Dialogue: 0,0:18:33.71,0:18:37.78,Default,,0,0,0,,Мен мұны тез бітіргім келеді. Бұл сыйақы берілмейтін жиын.
Dialogue: 0,0:18:37.78,0:18:39.78,Default,,0,0,0,,Не? Бұл сөз
Dialogue: 0,0:18:39.78,0:18:42.05,Default,,0,0,0,,Уақытты қысқартайық
Dialogue: 0,0:18:42.05,0:18:47.05,Default,,0,0,0,,Ол баланың өмірі қашан аяқталатынын ешкім білмейді.
Dialogue: 0,0:18:47.05,0:18:52.73,Default,,0,0,0,,Бірақ Луна баладан уды шығарып алған уақыт
Dialogue: 0,0:18:52.73,0:18:55.73,Default,,0,0,0,,Қысқа мерзімде 3 жыл болуы мүмкін
Dialogue: 0,0:18:55.73,0:18:57.80,Default,,0,0,0,,Үш жылдың ішінде бала
Dialogue: 0,0:18:57.80,0:19:04.91,Default,,0,0,0,,Егер сізде тағдырды жеңе алатын сиқыршы болу біліктілігіңіз жоқ деп есептесек...
Dialogue: 0,0:19:04.91,0:19:07.17,Default,,0,0,0,,оны өлтіріңіз
Dialogue: 0,0:19:08.51,0:19:13.51,Default,,0,0,0,,Осы уақытқа дейін біз, Қара сиқыршылар кеңесінің мүшелері,
Dialogue: 0,0:19:13.51,0:19:17.59,Default,,0,0,0,,Әрқашан Луна мен баланы қадағалаңыз➡
Dialogue: 0,0:19:17.59,0:19:20.52,Default,,0,0,0,,Кезектеніп күтпеген патрульдік сапарларды жасаңыз➡
Dialogue: 0,0:19:20.52,0:19:23.52,Default,,0,0,0,,Сол уақытта берілген сынақтан өту
Dialogue: 0,0:19:23.52,0:19:26.36,Default,,0,0,0,,Иә, бұл ауыртпалық.
Dialogue: 0,0:19:26.36,0:19:30.33,Default,,0,0,0,,Мен гүлдер үшін сыйлық аламын ба? оның рөлі
Dialogue: 0,0:19:31.43,0:19:35.10,Default,,0,0,0,,Жалынды 3 жыл күте алмайсыз ба?
Dialogue: 0,0:19:37.04,0:19:40.11,Default,,0,0,0,,Баланың ниеті әлі белгісіз➡
Dialogue: 0,0:19:40.11,0:19:43.08,Default,,0,0,0,,Қашып кетсең не болады?
Dialogue: 0,0:19:44.55,0:19:48.22,Default,,0,0,0,,Ондай жағдайда бірдеңе істеу керек.
Dialogue: 0,0:19:48.22,0:19:52.05,Default,,0,0,0,,Қазірдің өзінде тексеру байланысы ретінде өзара әрекеттесті.
Dialogue: 0,0:19:52.05,0:19:54.72,Default,,0,0,0,,Менің таныс Клодқа
Dialogue: 0,0:19:54.72,0:19:57.79,Default,,0,0,0,,Сақтық үшін мен екеуіне күзетші боламын.
Dialogue: 0,0:19:57.79,0:20:00.33,Default,,0,0,0,,Біреуден әрқашан сіздің артыңыздан жүруін сұраңыз
Dialogue: 0,0:20:00.33,0:20:04.33,Default,,0,0,0,,Жарайсың ба? Клод Иә Тори-сама
Dialogue: 0,0:20:04.33,0:20:07.00,Default,,0,0,0,,Ұнады ма? Луна
Dialogue: 0,0:20:07.00,0:20:09.50,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:20:09.50,0:20:14.84,Default,,0,0,0,,Балаға бәрін айтып беруді сізге қалдырамын, қожайыным.
Dialogue: 0,0:20:14.84,0:20:18.31,Default,,0,0,0,,Үкім шығаруда қателесуден сақ болыңыз.
Dialogue: 0,0:20:19.68,0:20:24.75,Default,,0,0,0,,Егер ол бала кедергіден өтпесе, біз үш жылда сөндіреміз.
Dialogue: 0,0:20:24.75,0:20:29.76,Default,,0,0,0,,Немесе қашып кету, немесе өмірдің ақыры туралы ең аз болса да.
Dialogue: 0,0:20:29.76,0:20:34.36,Default,,0,0,0,,Үш жылдан кейін де мен оны өлтіремін➡
Dialogue: 0,0:20:34.36,0:20:36.73,Default,,0,0,0,,Осыны есте сақтаңыз
Dialogue: 0,0:20:39.87,0:20:41.84,Default,,0,0,0,,Иә
Dialogue: 0,0:20:42.94,0:20:47.41,Default,,0,0,0,,Содан кейін, Қара сиқыршылар кеңесі, сот қазір жабық.
Dialogue: 0,0:20:48.94,0:20:50.95,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:20:50.95,0:20:52.95,Default,,0,0,0,,Уф! Ахх...
Dialogue: 0,0:20:52.95,0:20:55.38,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:55.38,0:21:03.16,Default,,0,0,0,,Уау! Неге... жел шығару керек пе? Сіз мені қорлайсыз ба?
Dialogue: 0,0:21:03.16,0:21:08.23,Default,,0,0,0,,Күрсін... Бірақ бұл үлкен мәселе болып шықты.
Dialogue: 0,0:21:08.23,0:21:13.50,Default,,0,0,0,,Сіз мұны істейсіз бе? Луна, шашыңды алдырдың.
Dialogue: 0,0:21:13.50,0:21:17.57,Default,,0,0,0,,Луна... Әй, анау бала менің балам бола ма?
Dialogue: 0,0:21:17.57,0:21:22.34,Default,,0,0,0,,Бұл адам бірінші рет менің балам болды, Луна.
Dialogue: 0,0:21:22.34,0:21:25.01,Default,,0,0,0,,Луна? иә?
Dialogue: 0,0:21:25.01,0:21:27.68,Default,,0,0,0,,Луна ұйықтап жатыр
Dialogue: 0,0:21:29.85,0:21:31.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:33.69,0:21:35.69,Default,,0,0,0,,Күрсін! ?
Dialogue: 0,0:21:35.69,0:21:39.19,Default,,0,0,0,,Ақымақ болма! Мен бұл жағдайда жақсы ұйықтай алмаймын!
Dialogue: 0,0:21:39.19,0:21:43.26,Default,,0,0,0,,Мен... Мен шаршаған болуым керек, айналамда қорқынышты адамдар бар➡
Dialogue: 0,0:21:43.26,0:21:46.87,Default,,0,0,0,,Мен де үйді жөндеп, көп сиқыр жасадым!
Dialogue: 0,0:21:46.87,0:21:48.87,Default,,0,0,0,,Мен де шаршадым. Оян! Ах~! ➡
Dialogue: 0,0:21:48.87,0:21:52.21,Default,,0,0,0,,Тыныш болыңыз! Оян, бейбақ!
Dialogue: 0,0:21:52.21,0:21:55.28,Default,,0,0,0,,《(Мысық сиқыршы) Мен Лунаға сенемін➡》
Dialogue: 0,0:21:55.28,0:21:57.44,Default,,0,0,0,,《Мен сенемін》
Dialogue: 0,0:22:01.65,0:22:06.32,Default,,0,0,0,,<Сол күні бақсы түс көргенін айтты>
Dialogue: 0,0:22:06.32,0:22:11.79,Default,,0,0,0,,<Түстің жайын сұрай алмадым>
Dialogue: 0,0:22:12.83,0:22:16.90,Default,,0,0,0,,<Луна, сенің арманың>
Dialogue: 0,0:22:16.90,0:22:20.17,Default,,0,0,0,,<Мәңгілік бақытты болыңыз>
Dialogue: 0,0:22:20.17,0:22:24.24,Default,,0,0,0,,<Қазір де, бұрын да солай деп шын жүректен үміттенемін.>
Dialogue: 0,0:22:26.17,0:22:31.18,Default,,0,0,0,,<Осылай мен және Луна, адамдарға тиіспейтін бақсы>
Dialogue: 0,0:22:31.18,0:22:33.18,Default,,0,0,0,,<Қатты, бірақ тамаша>
Dialogue: 0,0:22:33.18,0:22:38.25,Default,,0,0,0,,<Сиқыр мен саңырауқұлаққа толы қоғамдық өмір басталды>
Dialogue: 0,0:22:42.52,0:23:30.50,Default,,0,0,0,,♬～
