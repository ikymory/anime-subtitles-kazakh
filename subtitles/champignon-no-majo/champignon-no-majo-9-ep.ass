Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.17,0:00:09.17,Default,,0,0,0,,♬~G – күнге кепкен жасыл сиқыршы
Dialogue: 0,0:00:09.17,0:00:14.24,Default,,0,0,0,,♬~W - су сиқыршысы От азаппен қайнап жатқан
Dialogue: 0,0:00:14.24,0:00:20.25,Default,,0,0,0,,♬~S - балғамен ұрып-соғып жатқан тас шебері
Dialogue: 0,0:00:20.25,0:00:25.69,Default,,0,0,0,,♬~E - шығыстан келген сиқыршы. Шұңқырда сау бол.
Dialogue: 0,0:00:25.69,0:00:31.53,Default,,0,0,0,,♬~В - хайуандық сиқыршы, өткір найзамен тосын
Dialogue: 0,0:00:31.53,0:00:35.60,Default,,0,0,0,,♬~C — саңырауқұлақ шебері. Тіпті у да оған әсер етпейді.
Dialogue: 0,0:00:35.60,0:00:40.04,Default,,0,0,0,,♬~Бұл жігіт айбатты және өмірінің соңын әкеледі.
Dialogue: 0,0:00:40.04,0:00:43.87,Default,,0,0,0,,♬~ Барлық жындарды қуып жібер!
Dialogue: 0,0:00:43.87,0:00:47.21,Default,,0,0,0,,⚟ Жарайсыңдар! Мен жеңемін! Ах...
Dialogue: 0,0:00:47.21,0:00:51.71,Default,,0,0,0,,Олар ауылдың балалары. Оларға ересектер тыйым салуы керек.
Dialogue: 0,0:00:51.71,0:00:57.22,Default,,0,0,0,,Кейде олар осылай орманның қасында ойнауға келеді.
Dialogue: 0,0:00:57.22,0:01:00.49,Default,,0,0,0,,Лиза, қазір барайық.
Dialogue: 0,0:01:02.16,0:01:04.23,Default,,0,0,0,,<Әңгіменің соңы...>
Dialogue: 0,0:01:04.23,0:01:07.20,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:01:11.67,0:01:59.65,Default,,0,0,0,,♬～
Dialogue: 0,0:02:49.83,0:02:53.50,Default,,0,0,0,,<Маған көп бақытты бол деді>
Dialogue: 0,0:02:53.50,0:02:59.17,Default,,0,0,0,,<Мені күнделігіме жаза да алмайтын қайғыға оранатын кездер болады.>
Dialogue: 0,0:03:01.44,0:03:03.78,Default,,0,0,0,,(тоқыма станогының дыбысы)
Dialogue: 0,0:03:03.78,0:03:07.12,Default,,0,0,0,,Егер сен бақсы болсаң не істер едің?
Dialogue: 0,0:03:07.12,0:03:11.39,Default,,0,0,0,,<Ылғалды және ұят, бірақ мен сұрауды жөн көрдім.>
Dialogue: 0,0:03:21.13,0:03:24.13,Default,,0,0,0,,Мен жинаған қайғылы нәрселерді есіме түсіру
Dialogue: 0,0:03:24.13,0:03:26.13,Default,,0,0,0,,Көз жасын төгу
Dialogue: 0,0:03:26.13,0:03:29.81,Default,,0,0,0,,Саңырауқұлақтарды өсіру үшін көз жасын саңырауқұлақ төсегі ретінде пайдаланыңыз
Dialogue: 0,0:03:29.81,0:03:36.81,Default,,0,0,0,,Сол саңырауқұлақпен шай қайнатып, ішіп, көз жасын төгіп, уытсыздандыру.
Dialogue: 0,0:03:36.81,0:03:39.48,Default,,0,0,0,,Сергектік пен тыныштық сезімі
Dialogue: 0,0:03:39.48,0:03:42.82,Default,,0,0,0,,Осы көз жасыммен мен жаңа саңырауқұлақ жасаймын...
Dialogue: 0,0:03:42.82,0:03:47.16,Default,,0,0,0,,<Диагональ бойынша жоғарыда қадамдық жауап қайтарылды>
Dialogue: 0,0:03:47.16,0:03:49.99,Default,,0,0,0,,Жарайды Кофеин жоқ
Dialogue: 0,0:03:49.99,0:03:52.49,Default,,0,0,0,,<Ондай нәрсе емес>
Dialogue: 0,0:03:52.49,0:03:55.16,Default,,0,0,0,,Шайдың қалай жасалатынын көргіңіз келе ме?
Dialogue: 0,0:03:55.16,0:03:58.83,Default,,0,0,0,,<Бақсыда нені өртеп жібердің?>
Dialogue: 0,0:03:58.83,0:04:02.70,Default,,0,0,0,,<Атмосфера әлдеқашан қайтпас сезімге толып кеткен>
Dialogue: 0,0:04:16.02,0:04:19.59,Default,,0,0,0,,<Уау, жақсы иіс>
Dialogue: 0,0:04:21.46,0:04:25.79,Default,,0,0,0,,<Мен бұрын иіскемеген жұмбақ иіс>
Dialogue: 0,0:04:25.79,0:04:27.86,Default,,0,0,0,,<хош иісті және мейірімді>
Dialogue: 0,0:04:27.86,0:04:32.63,Default,,0,0,0,,<Жылы мұхитта жатқандай тыныштық...>
Dialogue: 0,0:04:32.63,0:04:34.70,Default,,0,0,0,,Ах... мм...
Dialogue: 0,0:04:34.70,0:04:37.31,Default,,0,0,0,,Уларды кетірудің дұрыс жолы бар.
Dialogue: 0,0:04:37.31,0:04:40.31,Default,,0,0,0,,Өзіңізді жайсыз сезінсеңіз, өзіңізді итермеңіз.
Dialogue: 0,0:04:40.31,0:04:44.98,Default,,0,0,0,,<Бақсы біраз уақыттан бері уды кетіруге тырысады, біраз уайымдап тұр>
Dialogue: 0,0:04:44.98,0:04:47.48,Default,,0,0,0,,<Бірдеңе сүйкімді болды>
Dialogue: 0,0:04:47.48,0:04:50.32,Default,,0,0,0,,＜…Не? ＞
Dialogue: 0,0:04:50.32,0:04:52.99,Default,,0,0,0,,<Бұл саңырауқұлақтың бастапқы көз жасы қандай?>
Dialogue: 0,0:04:52.99,0:04:55.99,Default,,0,0,0,,<Бұл бақсы денесінің бір бөлігі...>
Dialogue: 0,0:04:55.99,0:04:58.49,Default,,0,0,0,,Неге сонша толқып тұрсың? Бұл жігіт
Dialogue: 0,0:04:58.49,0:05:01.43,Default,,0,0,0,,Сіз оғаш ештеңе ойламайсыз деп үміттенемін.
Dialogue: 0,0:05:01.43,0:05:03.77,Default,,0,0,0,,<Тоқта, Қарға>
Dialogue: 0,0:05:03.77,0:05:07.24,Default,,0,0,0,,Уау! Бұл дәмді көрінеді! Мен жеймін!
Dialogue: 0,0:05:14.78,0:05:16.75,Default,,0,0,0,,<Ах...>
Dialogue: 0,0:05:23.12,0:05:25.09,Default,,0,0,0,,<Ах...>
Dialogue: 0,0:05:27.12,0:05:30.09,Default,,0,0,0,,<Көп көз жас...>
Dialogue: 0,0:05:31.79,0:05:37.77,Default,,0,0,0,,<Бір кесе мұң мен азап ішімде>
Dialogue: 0,0:05:42.30,0:05:46.14,Default,,0,0,0,,<Қайғыға байланған естеліктерді жоғалтпай>
Dialogue: 0,0:05:46.14,0:05:49.81,Default,,0,0,0,,<Менің көз жасымнан туған Намидатаке>
Dialogue: 0,0:05:49.81,0:05:55.78,Default,,0,0,0,,<Изумруд араласқан көк көктей терең және өте әдемі түс>
Dialogue: 0,0:05:57.82,0:06:01.99,Default,,0,0,0,,<Бақсы бұны тіліп алды>
Dialogue: 0,0:06:01.99,0:06:04.43,Default,,0,0,0,,<Құрғақ>
Dialogue: 0,0:06:04.43,0:06:07.93,Default,,0,0,0,,<Барып, уды кетір>
Dialogue: 0,0:06:07.93,0:06:10.77,Default,,0,0,0,,<Жадты өткізіп жіберу>
Dialogue: 0,0:06:10.77,0:06:14.60,Default,,0,0,0,,＜Мен бамбук өсінділерімен өз шайымды дайындап болған кезде＞
Dialogue: 0,0:06:14.60,0:06:19.57,Default,,0,0,0,,<Өтірік дегендей жүрегім тұнық болды>
Dialogue: 0,0:06:23.28,0:06:27.12,Default,,0,0,0,,Өз пікіріңізді пайдаланыңыз және қалаған кезде ішіңіз.
Dialogue: 0,0:06:27.12,0:06:31.19,Default,,0,0,0,,Көз жасыңызды шыныаяққа сақтауды ұмытпаңыз
Dialogue: 0,0:06:32.79,0:06:36.46,Default,,0,0,0,,<Сатылай жылау рәсімі>
Dialogue: 0,0:06:36.46,0:06:39.46,Default,,0,0,0,,<Бақсы Намида шайы толтырылған банка>
Dialogue: 0,0:06:39.46,0:06:41.46,Default,,0,0,0,,<Онда қалай жетуге болады>
Dialogue: 0,0:06:41.46,0:06:46.30,Default,,0,0,0,,<Осындай түн мені осы шайды дайындағым келді>
Dialogue: 0,0:06:46.30,0:06:49.97,Default,,0,0,0,,<Қызық, бақсы неше қабат кигізді.>
Dialogue: 0,0:06:49.97,0:06:54.04,Default,,0,0,0,,＜Осылай, мұңмен үнсіз жатқан күндер＞
Dialogue: 0,0:06:54.04,0:06:57.05,Default,,0,0,0,,<Сіз онда қанша уақыт болдыңыз?>
Dialogue: 0,0:06:57.05,0:07:00.98,Default,,0,0,0,,Клодқа жақсы ұйықтау үшін шай беріңіз.
Dialogue: 0,0:07:00.98,0:07:02.95,Default,,0,0,0,,Лиз а
Dialogue: 0,0:07:03.99,0:07:06.59,Default,,0,0,0,,<Себебі бұл мені осылай сезінеді>
Dialogue: 0,0:07:06.59,0:07:11.09,Default,,0,0,0,,<Намидатакенің шай ішуі әрқашан аздап көңілсіз>
Dialogue: 0,0:07:11.09,0:07:13.36,Default,,0,0,0,,Уау~ Фуфуфу (Меринос) Уау~
Dialogue: 0,0:07:14.60,0:07:18.93,Default,,0,0,0,,Уф... Уф! Ах...
Dialogue: 0,0:07:18.93,0:07:21.94,Default,,0,0,0,,Мүмкін мен Луна мен Қарға туралы қателескен шығармын➡
Dialogue: 0,0:07:21.94,0:07:24.44,Default,,0,0,0,,Намида шайын іштіңіз бе?
Dialogue: 0,0:07:24.44,0:07:27.11,Default,,0,0,0,,<Білсе сені өлтіреді...! ＞ Уф...
Dialogue: 0,0:07:27.11,0:07:30.18,Default,,0,0,0,,<Көрген жоқпыз делік> Уф... Уф...
Dialogue: 0,0:07:30.18,0:07:33.78,Default,,0,0,0,,<Қарғаның денесінде жас шықты~>
Dialogue: 0,0:07:33.78,0:07:36.12,Default,,0,0,0,,(Клод жылап жатыр)
Dialogue: 0,0:07:36.12,0:07:38.12,Default,,0,0,0,,<Мен сезінемін...>
Dialogue: 0,0:07:38.12,0:07:41.09,Default,,0,0,0,,Каа… Каа!
Dialogue: 0,0:07:47.80,0:07:50.47,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:07:57.81,0:07:59.81,Default,,0,0,0,,Каа~ Аа...
Dialogue: 0,0:07:59.81,0:08:02.98,Default,,0,0,0,,Бақсы, сенен не сұрағым келеді
Dialogue: 0,0:08:02.98,0:08:06.98,Default,,0,0,0,,＜Иә, өйткені сіз оқуға құштарсыз＞
Dialogue: 0,0:08:06.98,0:08:12.82,Default,,0,0,0,,Бұл не? Бұл екеуі не істеп жатыр?
Dialogue: 0,0:08:12.82,0:08:14.99,Default,,0,0,0,,<Шын мәнінде емес>
Dialogue: 0,0:08:14.99,0:08:18.26,Default,,0,0,0,,Поцелу деп аталатын нәрсе жазылған.
Dialogue: 0,0:08:18.26,0:08:22.93,Default,,0,0,0,,Бұл адамдар неге бұлай істеп жатыр?
Dialogue: 0,0:08:22.93,0:08:24.93,Default,,0,0,0,,А... аа... Уау!
Dialogue: 0,0:08:24.93,0:08:27.77,Default,,0,0,0,,<Сіз байсалдысыз ба, бұл жігіт>
Dialogue: 0,0:08:27.77,0:08:33.61,Default,,0,0,0,,Күрсін... Күрсін... А... Мм, жақсысың ба? Ведьма
Dialogue: 0,0:08:33.61,0:08:37.28,Default,,0,0,0,,<Сен тым ренжідің, Луна>
Dialogue: 0,0:08:37.28,0:08:39.28,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,0:08:39.28,0:08:41.95,Default,,0,0,0,,<Бұл есте сақтау қабілетін жоғалтады ма? ＞
Dialogue: 0,0:08:41.95,0:08:45.29,Default,,0,0,0,,Kisses are between close people
Dialogue: 0,0:08:45.29,0:08:50.63,Default,,0,0,0,,Түрту немесе сәлемдесу?
Dialogue: 0,0:08:50.63,0:08:55.70,Default,,0,0,0,,Бақсы сені сүйді ме?
Dialogue: 0,0:08:55.70,0:08:58.30,Default,,0,0,0,,<Бұл жігітке шабуыл жасама...>
Dialogue: 0,0:08:58.30,0:09:00.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:00.37,0:09:04.14,Default,,0,0,0,,<Тоқтады...> <(Меринос) Мұздату...>
Dialogue: 0,0:09:04.14,0:09:06.47,Default,,0,0,0,,<Функцияның тоқтауы…>
Dialogue: 0,0:09:06.47,0:09:11.55,Default,,0,0,0,,Сүйісу қаншалықты жақын?
Dialogue: 0,0:09:11.55,0:09:16.48,Default,,0,0,0,,Мені және бақсы арасындағы қарым-қатынас «жақын» деп атала ма?
Dialogue: 0,0:09:16.48,0:09:20.32,Default,,0,0,0,,<Койцу! ＞
Dialogue: 0,0:09:20.32,0:09:25.83,Default,,0,0,0,,Немесе менімен бақсы арасындағы қарым-қатынасқа келетін болсақ.
Dialogue: 0,0:09:25.83,0:09:29.16,Default,,0,0,0,,Бұл «жақын» деген талапқа сай емес пе?
Dialogue: 0,0:09:29.16,0:09:31.67,Default,,0,0,0,,<Осы кезде қарға ойланып қалды>
Dialogue: 0,0:09:31.67,0:09:36.34,Default,,0,0,0,,<Осы дүниеде сүйіспеншілікті сұраудың мұндай жолы бар ма деп ойлаймын>
Dialogue: 0,0:09:36.34,0:09:40.41,Default,,0,0,0,,<Клод Қарғаның естеліктерінен үзінді>
Dialogue: 0,0:09:40.41,0:09:43.85,Default,,0,0,0,,Сонымен... бұл поцелудің анықтамасы
Dialogue: 0,0:09:43.85,0:09:47.52,Default,,0,0,0,,Because it applies to ordinary people.
Dialogue: 0,0:09:47.52,0:09:51.99,Default,,0,0,0,,Менің денем улы болғандықтан, бұл маған қатысты емес.
Dialogue: 0,0:09:53.35,0:09:56.42,Default,,0,0,0,,<Луна үшін сіз жақсы жауап бердіңіз>
Dialogue: 0,0:09:56.42,0:09:58.86,Default,,0,0,0,,Бұл мен...
Dialogue: 0,0:09:58.86,0:10:01.63,Default,,0,0,0,,Оны сиқырлы шүберек арқылы да қолдануға болады.
Dialogue: 0,0:10:01.63,0:10:05.70,Default,,0,0,0,,Мен сиқыршыны сүйгім келеді хаха!
Dialogue: 0,0:10:05.70,0:10:10.64,Default,,0,0,0,,<Иә? Берілме, бұл жігіт! ＞
Dialogue: 0,0:10:10.64,0:10:12.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:16.98,0:10:20.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:20.05,0:10:25.82,Default,,0,0,0,,Мм... Жақын болмасаң да сыпайылықтан қол алысуға болады деп естідім.
Dialogue: 0,0:10:25.82,0:10:29.49,Default,,0,0,0,,<Бер, бейбақ! ＞
Dialogue: 0,0:10:40.90,0:10:46.67,Default,,0,0,0,,Маған бір күні дұрыстап дәм татуға рұқсат етіңіз, бақсы.
Dialogue: 0,0:10:48.18,0:10:51.68,Default,,0,0,0,,Олай болса мен сиқырмен айналысамын!
Dialogue: 0,0:10:51.68,0:10:53.68,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:10:53.68,0:10:56.02,Default,,0,0,0,,А... Луна?
Dialogue: 0,0:10:56.02,0:11:01.79,Default,,0,0,0,,Оны дәл қазір сүйген кезде этикетке мұқият болды.
Dialogue: 0,0:11:01.79,0:11:06.13,Default,,0,0,0,,Ішің жақсы екен, анау ақ бақсы бала.
Dialogue: 0,0:11:06.13,0:11:09.13,Default,,0,0,0,,Сүйіспеншіліктің не екенін білмегендей бірдеңе айттыңыз.
Dialogue: 0,0:11:09.13,0:11:12.63,Default,,0,0,0,,Бұл әдейі болды!
Dialogue: 0,0:11:12.63,0:11:16.14,Default,,0,0,0,,<Бақсы сондай сүйкімді еді>
Dialogue: 0,0:11:16.14,0:11:20.14,Default,,0,0,0,,<Сиқырлы жаттығу кезінде орындалмайтын ең қиын сиқыр>
Dialogue: 0,0:11:20.14,0:11:23.48,Default,,0,0,0,,<Егер бұл бүгін болса...> Иә!
Dialogue: 0,0:11:23.48,0:11:27.45,Default,,0,0,0,,<Қолымнан бәрі келетін сияқты, Жүрегімнің қанаты өскендей! ＞
Dialogue: 0,0:11:30.72,0:11:33.49,Default,,0,0,0,,Ауылда сауда жасау? Мен бе?
Dialogue: 0,0:11:33.49,0:11:36.49,Default,,0,0,0,,Бұл жолы мен оны ұзақ уақыт пайдаландым, бірақ сонымен бірге
Dialogue: 0,0:11:36.49,0:11:41.33,Default,,0,0,0,,Бұл сиқырлы жақсарту деңгейіңізді анықтауға арналған алдын ала сынақ.
Dialogue: 0,0:11:41.33,0:11:44.00,Default,,0,0,0,,Бұл бақылаушы. Мен?
Dialogue: 0,0:11:44.00,0:11:48.50,Default,,0,0,0,,Сізді әрқашан Луна қорғайтынын түсінбейсіз бе?
Dialogue: 0,0:11:48.50,0:11:55.18,Default,,0,0,0,,Сиқырлы күшті меңгере алмайтын біліктілігі жоқ адамдарға құбыжықтар мен оны қалайтын улы тіршілік иелері оңай соғылады.
Dialogue: 0,0:11:55.18,0:11:57.51,Default,,0,0,0,,Егер сіз бұл орманды Луна қорғайтын етіп тастасаңыз
Dialogue: 0,0:11:57.51,0:12:00.45,Default,,0,0,0,,Сіз де осындай адамдарды кездестіретін шығарсыз.
Dialogue: 0,0:12:00.45,0:12:03.45,Default,,0,0,0,,Құбыжықтар мен улы тіршілік иелері...?
Dialogue: 0,0:12:03.45,0:12:05.45,Default,,0,0,0,,Осы уақытқа дейін үйренген сиқырмен
Dialogue: 0,0:12:05.45,0:12:08.96,Default,,0,0,0,,Өзіңізді және сиырыңызды қорғаңыз, өз үлесіңізді қосыңыз
Dialogue: 0,0:12:08.96,0:12:10.96,Default,,0,0,0,,Бұл деңгейді орындай алуы керек
Dialogue: 0,0:12:10.96,0:12:14.30,Default,,0,0,0,,Қалай болғанда да мен сенен бас тартамын.
Dialogue: 0,0:12:14.30,0:12:20.67,Default,,0,0,0,,Егер сіз қауіптен қорықсаңыз және Луна сізді қорғап тұрған шағын бақшада үй ойнағыңыз келсе, қалағаныңызды жасаңыз.
Dialogue: 0,0:12:21.80,0:12:25.81,Default,,0,0,0,,Мен сізге айтамын, бұл мүмкіндікті пайдаланып қашып кетпеңіз.
Dialogue: 0,0:12:25.81,0:12:29.88,Default,,0,0,0,,Қашып кетсең, мына жігіт сені бұқтырады.
Dialogue: 0,0:12:29.88,0:12:33.31,Default,,0,0,0,,Қарғалар бұқтықты жақсы көреді!
Dialogue: 0,0:12:33.31,0:12:36.48,Default,,0,0,0,,<Луна қорғайтын ойын үйі...>
Dialogue: 0,0:12:38.32,0:12:42.39,Default,,0,0,0,,Мен барамын! Мен қашпаймын
Dialogue: 0,0:12:42.39,0:12:44.99,Default,,0,0,0,,Өз тапсырмаңызды дұрыс және қауіпсіз орындаңыз
Dialogue: 0,0:12:44.99,0:12:47.50,Default,,0,0,0,,Мен бұл үйге қайтамын!
Dialogue: 0,0:12:47.50,0:12:49.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:49.50,0:12:54.67,Default,,0,0,0,,Бұл жай ғана тапсырма, солай ма? Мм... иә
Dialogue: 0,0:12:55.57,0:12:59.17,Default,,0,0,0,,Жарайды, мен сенімен біргемін➡
Dialogue: 0,0:12:59.17,0:13:01.94,Default,,0,0,0,,Екі төбеден өтсең, Машуру ауылына жетесің.
Dialogue: 0,0:13:01.94,0:13:03.95,Default,,0,0,0,,Иә (сықырлау)
Dialogue: 0,0:13:03.95,0:13:10.02,Default,,0,0,0,,Бірақ егер мен бұқтырылған тағамды жасайтын болсам, бұл әлемдегі ең дәмді тағам болар еді деп ойлаймын➡
Dialogue: 0,0:13:10.02,0:13:12.29,Default,,0,0,0,,Сіз де солай ойламайсыз ба?
Dialogue: 0,0:13:12.29,0:13:14.62,Default,,0,0,0,,Иә...
Dialogue: 0,0:13:14.62,0:13:19.69,Default,,0,0,0,,Бірақ мен жегім келмейді, сондықтан Ризе қашып кете алмайды.
Dialogue: 0,0:13:19.69,0:13:25.17,Default,,0,0,0,,Минос Түскі асты кейін ішеміз, енді серуендейміз.
Dialogue: 0,0:13:28.30,0:13:30.97,Default,,0,0,0,,🔊Ол жақта да көбірек шөп жегім келеді!
Dialogue: 0,0:13:30.97,0:13:32.97,Default,,0,0,0,,🔊Минолар!
Dialogue: 0,0:13:32.97,0:13:37.98,Default,,0,0,0,,Мен бүгін кешкі асқа сиыр етінен жасалған нашар бұқтырылған бұқтырманы таңдадым.
Dialogue: 0,0:13:37.98,0:13:41.45,Default,,0,0,0,,Минос, қайтып кел!
Dialogue: 0,0:13:42.48,0:13:44.99,Default,,0,0,0,,Ах...➡
Dialogue: 0,0:13:44.99,0:13:47.06,Default,,0,0,0,,Ризе, тезірек ауылға барыңыз➡
Dialogue: 0,0:13:47.06,0:13:50.99,Default,,0,0,0,,Мен алда жолдағы дәмді шөптің иісін сеземін. Ах...
Dialogue: 0,0:13:50.99,0:13:58.17,Default,,0,0,0,,А... ол жаңа ғана не істеді? Сіз бір сәт рух тілін қолдандыңыз ба?
Dialogue: 0,0:13:59.83,0:14:04.77,Default,,0,0,0,,Лиз Мен саған ағаштардың батасын беремін.
Dialogue: 0,0:14:04.77,0:14:07.14,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:13.11,0:14:15.62,Default,,0,0,0,,А, бұл ұлу.
Dialogue: 0,0:14:15.62,0:14:18.29,Default,,0,0,0,,Сақ болыңыз, өйткені бұл улы тіршілік иесі
Dialogue: 0,0:14:18.29,0:14:21.12,Default,,0,0,0,,Ризеге жақындамаңыз
Dialogue: 0,0:14:21.12,0:14:23.79,Default,,0,0,0,,Улы тіршілік иелері...
Dialogue: 0,0:14:23.79,0:14:26.13,Default,,0,0,0,,《... дегеніміз не? 》
Dialogue: 0,0:14:26.13,0:14:29.46,Default,,0,0,0,,《Мен бұл дүниенің уын денеме тым көп сіңірдім》
Dialogue: 0,0:14:29.46,0:14:33.97,Default,,0,0,0,,《Денесінің улы эволюциясы бар деформацияланған тіршілік иесі》
Dialogue: 0,0:14:33.97,0:14:37.64,Default,,0,0,0,,《Кейбір балаларға улы жәндіктер шабуыл жасайды》
Dialogue: 0,0:14:37.64,0:14:41.31,Default,,0,0,0,,《Бұл балалар құбыжық емес》
Dialogue: 0,0:14:41.31,0:14:43.38,Default,,0,0,0,,《Бірақ біліңіз》
Dialogue: 0,0:14:43.38,0:14:46.31,Default,,0,0,0,,《Сақ бол, Ризе》
Dialogue: 0,0:14:46.31,0:14:49.38,Default,,0,0,0,,Мүмкін бұл бала ештеңе істемейтін шығар.
Dialogue: 0,0:14:49.38,0:14:52.39,Default,,0,0,0,,Улы шламды баспаңыз➡
Dialogue: 0,0:14:52.39,0:14:55.32,Default,,0,0,0,,Бұл өте ауырған сияқты...➡
Dialogue: 0,0:14:55.32,0:15:01.33,Default,,0,0,0,,Егер Луна сол жерде болса, мен уды сорып, оның көңілін сәл жақсарта алар едім.
Dialogue: 0,0:15:01.33,0:15:06.50,Default,,0,0,0,,Бақсы улы жәндікке тап болса, уды сіңіре ме?
Dialogue: 0,0:15:06.50,0:15:09.10,Default,,0,0,0,,Бұл жай ғана жайлылық➡
Dialogue: 0,0:15:09.10,0:15:13.44,Default,,0,0,0,,Бұрын мен оларға саңырауқұлақтың улы спораларын шашатынмын➡
Dialogue: 0,0:15:13.44,0:15:18.45,Default,,0,0,0,,Саңырауқұлақтардың уы тым үлкен етіп өсіретін сияқты...бірақ ауыруы басылатын сияқты.
Dialogue: 0,0:15:18.45,0:15:20.45,Default,,0,0,0,,《Ававуа…》
Dialogue: 0,0:15:20.45,0:15:23.12,Default,,0,0,0,,Сондықтан мен соңғы кездері уды тартатын болдым.
Dialogue: 0,0:15:23.12,0:15:26.79,Default,,0,0,0,,Мен сені сыртқа миазма таратпайтын шүберекпен жабамын.
Dialogue: 0,0:15:26.79,0:15:29.29,Default,,0,0,0,,А, қарашы➡
Dialogue: 0,0:15:29.29,0:15:32.63,Default,,0,0,0,,Бұл балалар Луна матамен жабылған.
Dialogue: 0,0:15:32.63,0:15:34.70,Default,,0,0,0,,Не? не? (Улы тіршілік иелерінің айқайы)
Dialogue: 0,0:15:34.70,0:15:37.97,Default,,0,0,0,,Мына жерде мата алғысы келетін бала бар ма? ➡
Dialogue: 0,0:15:37.97,0:15:40.97,Default,,0,0,0,,Түсіндім, қиналып жатырсың...➡
Dialogue: 0,0:15:40.97,0:15:44.47,Default,,0,0,0,,Кешіріңіз, Луна бүгін жоқ.
Dialogue: 0,0:15:44.47,0:15:47.81,Default,,0,0,0,,Уф... Келесі жолы тағы келемін➡
Dialogue: 0,0:15:47.81,0:15:50.65,Default,,0,0,0,,Мата қандай сезімде болады?
Dialogue: 0,0:15:50.65,0:15:52.65,Default,,0,0,0,,<Ведмәр...>
Dialogue: 0,0:15:52.65,0:15:55.65,Default,,0,0,0,,Сәттілік пе? Иә, бұл жақсы болды! ➡
Dialogue: 0,0:15:55.65,0:15:58.12,Default,,0,0,0,,Мен де Лунаға айтамын.
Dialogue: 0,0:15:59.65,0:16:02.22,Default,,0,0,0,,《(тоқыма станогының дыбысы)》 《Аа...》
Dialogue: 0,0:16:03.83,0:16:06.99,Default,,0,0,0,,Лунаның бақытты болатынына сенімдімін.
Dialogue: 0,0:16:11.10,0:16:14.17,Default,,0,0,0,,Бақсы-сама – тамаша адам.
Dialogue: 0,0:16:14.17,0:16:19.44,Default,,0,0,0,,Дұрыс, бәріміз Лунаны жақсы көреміз➡
Dialogue: 0,0:16:19.44,0:16:22.78,Default,,0,0,0,,Луна - таңғажайып сиқыршы. Ах...
Dialogue: 0,0:16:22.78,0:16:26.61,Default,,0,0,0,,Иә, мен де бақсыларды жақсы көремін.
Dialogue: 0,0:16:26.61,0:16:28.62,Default,,0,0,0,,Сиқыршы сияқты...
Dialogue: 0,0:16:28.62,0:16:32.12,Default,,0,0,0,,🔊Мен керемет сиқыршы болғым келеді Ах...
Dialogue: 0,0:16:32.12,0:16:35.12,Default,,0,0,0,,🔊Иә, сенің қолыңнан келетініне сенімдімін.
Dialogue: 0,0:16:35.12,0:16:38.79,Default,,0,0,0,,Уау~ 🔊Ризе Лунаны жақсы көретініне қуаныштымын.
Dialogue: 0,0:16:38.79,0:16:41.46,Default,,0,0,0,,<Мен сол адамды қолдағым келеді>
Dialogue: 0,0:16:41.46,0:16:46.53,Default,,0,0,0,,<Мен сол адамның күші мен қуанышы болғым келеді>
Dialogue: 0,0:16:46.53,0:16:51.47,Default,,0,0,0,,<Мен бақыттың тым болмағанда жұлынғанын қалаймын>
Dialogue: 0,0:16:51.47,0:16:55.31,Default,,0,0,0,,Бар күшімізді салып, ешкіні үйге әкелейік.
Dialogue: 0,0:16:55.31,0:16:59.31,Default,,0,0,0,,＜Мен бұл мақсат үшін кез келген жерге бара аламын＞
Dialogue: 0,0:16:59.31,0:17:02.18,Default,,0,0,0,,Ризе Бұл ауыл!
Dialogue: 0,0:17:23.34,0:17:26.11,Default,,0,0,0,,Мен оны тез сатып алғаныма қуаныштымын~
Dialogue: 0,0:17:26.11,0:17:28.38,Default,,0,0,0,,Бұл керемет, Лиза
Dialogue: 0,0:17:29.78,0:17:33.28,Default,,0,0,0,,Барлығы Ризеге бірден ғашық болды➡
Dialogue: 0,0:17:33.28,0:17:37.12,Default,,0,0,0,,Біртүрлі шиеленіс болды➡
Dialogue: 0,0:17:37.12,0:17:43.12,Default,,0,0,0,,Бұл бірінші рет сатып алу оңай болды. Мен таң қалдым.
Dialogue: 0,0:17:43.12,0:17:45.79,Default,,0,0,0,,Енді үйге бару ғана қалды.
Dialogue: 0,0:17:45.79,0:17:50.16,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:17:51.87,0:17:53.87,Default,,0,0,0,,Жаңбыр жауып тұр
Dialogue: 0,0:17:53.87,0:17:56.87,Default,,0,0,0,,Ризе жаңбыры улы заттармен араласады.
Dialogue: 0,0:17:56.87,0:18:03.64,Default,,0,0,0,,Маған Луна айтқандай, капюшон киіп, теріңізді жауып, қолғап киіңіз➡
Dialogue: 0,0:18:03.64,0:18:08.15,Default,,0,0,0,,Алып келген сиқырлы шүберекпен ешкілерді жабыңыз.
Dialogue: 0,0:18:08.15,0:18:11.82,Default,,0,0,0,,Минос ше? Өйткені менде бәрі жақсы
Dialogue: 0,0:18:11.82,0:18:14.49,Default,,0,0,0,,Не? тез
Dialogue: 0,0:18:15.82,0:18:18.33,Default,,0,0,0,,Сол жерде отырма.
Dialogue: 0,0:18:18.33,0:18:21.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:21.66,0:18:26.17,Default,,0,0,0,,Бұл улы тіршілік иесі. Біз не істеуіміз керек? Ризе
Dialogue: 0,0:18:26.17,0:18:30.50,Default,,0,0,0,,Лиз Мен саған тілектердің үш дәнін беремін➡
Dialogue: 0,0:18:30.50,0:18:37.35,Default,,0,0,0,,Қолданғыңыз келетін күшіңіз болса немесе орындағыңыз келетін тілегіңіз болса, осыны жеп, күшті тілек жасаңыз➡
Dialogue: 0,0:18:37.35,0:18:43.42,Default,,0,0,0,,Мен сіздің сиқырлы күшіңізді арттырамын және тілектеріңізді мүмкіндігінше орындаймын➡
Dialogue: 0,0:18:43.42,0:18:45.59,Default,,0,0,0,,Шын есімді айту
Dialogue: 0,0:18:49.36,0:18:52.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:52.43,0:18:54.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:54.43,0:18:58.43,Default,,0,0,0,,<Не? Бұл күш...＞
Dialogue: 0,0:18:58.43,0:19:02.97,Default,,0,0,0,,Лиз: Бұл бала ауырып тұрған сияқты➡
Dialogue: 0,0:19:02.97,0:19:05.97,Default,,0,0,0,,Олай болса, ешкіге де қауіп төніп тұр (ешкінің дауысы)
Dialogue: 0,0:19:05.97,0:19:09.81,Default,,0,0,0,,Өтінемін, босатыңыз және мені түсіріңіз (Риздің ауыр тынысы)
Dialogue: 0,0:19:09.81,0:19:13.48,Default,,0,0,0,,<Маған бұл ұнамайды...! ＞
Dialogue: 0,0:19:14.65,0:19:16.62,Default,,0,0,0,,А... уф
Dialogue: 0,0:19:17.99,0:19:19.99,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:19:19.99,0:19:22.66,Default,,0,0,0,,Үлкен гүл
Dialogue: 0,0:19:22.66,0:19:26.73,Default,,0,0,0,,Ешкіні улы тырнақтар басып алды, бірақ ол қауіпсіз. Ризе➡
Dialogue: 0,0:19:26.73,0:19:30.73,Default,,0,0,0,,Бұл таңқаларлық, Лиза, сен мұны қалай істедің? Мұндай сиқыр
Dialogue: 0,0:19:30.73,0:19:32.73,Default,,0,0,0,,Сәлем, сәлем, танысқаныма қуаныштымын
Dialogue: 0,0:19:32.73,0:19:35.17,Default,,0,0,0,,⚟Не болды? Ризе➡
Dialogue: 0,0:19:35.17,0:19:40.51,Default,,0,0,0,,Неліктен біреуге тілегіңіздің дәнімен осылай көмектестіңіз?
Dialogue: 0,0:19:40.51,0:19:46.35,Default,,0,0,0,,⚟Мен олардың бізге зиян келтіретін улы құбыжықтарды жеңуін қаладым...
Dialogue: 0,0:19:46.35,0:19:48.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:48.35,0:19:51.35,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:19:51.35,0:19:55.86,Default,,0,0,0,,Мүмкін сіздің денеңіз уланып жатқан шығар?
Dialogue: 0,0:19:55.86,0:20:00.19,Default,,0,0,0,,Ешкі киген сиқырлы матаны алғыңыз келді ме?
Dialogue: 0,0:20:00.19,0:20:02.13,Default,,0,0,0,,(Улы құстың дыбысы)
Dialogue: 0,0:20:02.13,0:20:06.47,Default,,0,0,0,,Бірақ бұл балаға беретін шүберекім жетпейді.
Dialogue: 0,0:20:06.47,0:20:11.24,Default,,0,0,0,,Ешкі мата жарақат алған кезде алғашқы медициналық көмек көрсету үшін қажет...
Dialogue: 0,0:20:14.54,0:20:17.11,Default,,0,0,0,,⚟Лиз, сен не істейсің?
Dialogue: 0,0:20:23.48,0:20:25.49,Default,,0,0,0,,Ах...➡
Dialogue: 0,0:20:25.49,0:20:30.49,Default,,0,0,0,,Сиқырға тапсырыс беру керек пе? Сіз Лунаның сиқырлы матасына тапсырыс бердіңіз бе?
Dialogue: 0,0:20:30.49,0:20:34.33,Default,,0,0,0,,Бұл таңқаларлық, Лиза, енді сен мұны істей аласың.
Dialogue: 0,0:20:34.33,0:20:36.40,Default,,0,0,0,,Мен жүгері дорбаларын жүк көліктеріне тиеп, қоймаға апаратынмын.
Dialogue: 0,0:20:36.40,0:20:40.67,Default,,0,0,0,,(Улы құстың ыңылдауы)
Dialogue: 0,0:20:42.67,0:20:46.94,Default,,0,0,0,,Тамаша, тамаша, бұл сенің матаның.
Dialogue: 0,0:20:48.18,0:20:50.68,Default,,0,0,0,,⚟Сіз не ойлап отырсыз? Ризе
Dialogue: 0,0:20:50.68,0:20:56.02,Default,,0,0,0,,⚟Берілген күшімізбен осындай арамдыққа көмек қолын созар едік деп ойлау...
Dialogue: 0,0:20:56.02,0:21:01.49,Default,,0,0,0,,⚟Ризеден көңілім қалды! Мен сізбен біраз уақыт сөйлеспеймін, сондықтан бұл туралы ойланыңыз.
Dialogue: 0,0:21:02.79,0:21:05.63,Default,,0,0,0,,Өзіңіз сиқырмен көп жұмыс жасаңыз
Dialogue: 0,0:21:05.63,0:21:09.70,Default,,0,0,0,,Осы уақытқа дейін көрсеткен көмегіңіз үшін рахмет.
Dialogue: 0,0:21:09.70,0:21:12.97,Default,,0,0,0,,Жақсы, бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:21:12.97,0:21:19.81,Default,,0,0,0,,Біреудің матасын күштеп алып үйге тез қайтпа.
Dialogue: 0,0:21:19.81,0:21:22.28,Default,,0,0,0,,Мен де үйге барамын.
Dialogue: 0,0:21:23.48,0:21:25.81,Default,,0,0,0,,Ризе, жақсысың ба?
Dialogue: 0,0:21:25.81,0:21:28.65,Default,,0,0,0,,Минос, сен мына баланы көтересің бе?
Dialogue: 0,0:21:28.65,0:21:35.16,Default,,0,0,0,,Мен бақсыға бұл ешкінің уын тез көрсетуім керек (ешкінің айқайы)
Dialogue: 0,0:21:35.16,0:21:37.99,Default,,0,0,0,,Бізге асығу керек...
Dialogue: 0,0:21:37.99,0:21:41.50,Default,,0,0,0,,Ризе: Сіз жүре аласыз ба? Мені мінгізесің бе?
Dialogue: 0,0:21:41.50,0:21:45.83,Default,,0,0,0,,Жоқ, мен өз аяғыммен жүремін.
Dialogue: 0,0:21:45.83,0:21:49.30,Default,,0,0,0,,🔊Мен бақсыға қайта барғым келеді.
Dialogue: 0,0:21:52.67,0:21:54.68,Default,,0,0,0,,Сиқыршы...
Dialogue: 0,0:21:54.68,0:21:56.74,Default,,0,0,0,,🔊Күтетініме сенімдімін
Dialogue: 0,0:21:58.35,0:22:01.78,Default,,0,0,0,,<Қара ормандағылардың барлығы күтуде>
Dialogue: 0,0:22:01.78,0:22:05.29,Default,,0,0,0,,<Мен сол үйге қайтқым келеді>
Dialogue: 0,0:22:05.29,0:22:07.29,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:22:07.29,0:22:11.36,Default,,0,0,0,,<Ақыры өз үйімді таптым>
Dialogue: 0,0:22:11.36,0:22:13.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:15.36,0:22:18.30,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:22:18.30,0:22:20.27,Default,,0,0,0,,А...
Dialogue: 0,0:22:23.80,0:22:28.31,Default,,0,0,0,,Луна, мына ешкінің баласының улы саңырауқұлағын бірден сор.
Dialogue: 0,0:22:28.31,0:22:30.31,Default,,0,0,0,,Иә
Dialogue: 0,0:22:30.31,0:22:34.32,Default,,0,0,0,,Менің келгеніме қуаныштысың, солай емес пе? Иә
Dialogue: 0,0:22:34.32,0:22:39.39,Default,,0,0,0,,Енді... менсіз қиын болар еді.
Dialogue: 0,0:22:39.39,0:22:41.36,Default,,0,0,0,,Иә
Dialogue: 0,0:22:42.39,0:22:54.57,Default,,0,0,0,,♬～
Dialogue: 0,0:22:56.07,0:23:02.07,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory