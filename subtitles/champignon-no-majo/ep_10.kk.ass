Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.67,0:00:08.67,Default,,0,0,0,,Такизава! Мұнда өткізбе!
Dialogue: 0,0:00:08.67,0:00:12.74,Default,,0,0,0,,(Өмірдің ақыры ақырады)
Dialogue: 0,0:00:15.68,0:00:21.68,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:00:21.68,0:00:27.52,Default,,0,0,0,,Бұл үлкен мәселе, әрі қиын жұмыс.
Dialogue: 0,0:00:27.52,0:00:30.79,Default,,0,0,0,,Сіз оны бірден аяқтадыңыз.
Dialogue: 0,0:00:31.86,0:01:19.84,Default,,0,0,0,,♬～
Dialogue: 0,0:02:10.83,0:02:14.50,Default,,0,0,0,,<(Кітап дүкені) Бақсыға, көңілің қалай? ＞
Dialogue: 0,0:02:14.50,0:02:16.57,Default,,0,0,0,,<Бақсы келмей жатқанда>
Dialogue: 0,0:02:16.57,0:02:20.00,Default,,0,0,0,,<Қаланың ауасы мен суы толығымен ластанған>
Dialogue: 0,0:02:20.00,0:02:23.01,Default,,0,0,0,,<Денем ауырып, сыртқа шыға алмаймын>
Dialogue: 0,0:02:23.01,0:02:25.01,Default,,0,0,0,,<Әр күн көңілсіз>
Dialogue: 0,0:02:27.01,0:02:29.51,Default,,0,0,0,,Ах
Dialogue: 0,0:02:29.51,0:02:33.02,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:02:33.02,0:02:35.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:38.35,0:02:43.19,Default,,0,0,0,,<Сіздің келуіңізді асыға күтеміз>
Dialogue: 0,0:02:43.19,0:02:47.53,Default,,0,0,0,,<Кітап дүкенінің иесінен SOS тәрізді хат келді> (Бақаның айқайы)
Dialogue: 0,0:02:47.53,0:02:52.00,Default,,0,0,0,,<Бақсы біраз уақыттан кейін қалаға бірінші рет барады>
Dialogue: 0,0:02:54.87,0:02:56.84,Default,,0,0,0,,(Бақаның айқайы)
Dialogue: 0,0:02:58.37,0:03:01.38,Default,,0,0,0,,《(Клод) Қазір қалаға барма》
Dialogue: 0,0:03:01.38,0:03:04.98,Default,,0,0,0,,《Шекарадағы жақында болған індеттің салдары бойынша》
Dialogue: 0,0:03:04.98,0:03:09.82,Default,,0,0,0,,《Босқындар ағылып, жел қауіпті бағытта соғады.》
Dialogue: 0,0:03:09.82,0:03:12.82,Default,,0,0,0,,<Қарға мені тоқтатты, бірақ...>
Dialogue: 0,0:03:12.82,0:03:15.89,Default,,0,0,0,,Сонда да қауіптен өту деген сөз
Dialogue: 0,0:03:15.89,0:03:20.66,Default,,0,0,0,,Сіз сиқыршы ретінде бір нәрсе туралы ойлайсыз ба?
Dialogue: 0,0:03:21.83,0:03:25.17,Default,,0,0,0,,Хат алу мен үшін үлкен мәселе.
Dialogue: 0,0:03:25.17,0:03:28.67,Default,,0,0,0,,Сондай-ақ, менің денемнің ауырғаны жазылған.
Dialogue: 0,0:03:28.67,0:03:30.67,Default,,0,0,0,,Менің де дәрі-дәрмек жеткізгім келеді.
Dialogue: 0,0:03:30.67,0:03:33.01,Default,,0,0,0,,<Семья...>
Dialogue: 0,0:03:33.01,0:03:35.01,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:03:35.01,0:03:38.68,Default,,0,0,0,,Жоқ, бұл бәрі емес. (Лиз Луна) Иә?
Dialogue: 0,0:03:38.68,0:03:43.52,Default,,0,0,0,,Міне, сіз адамнан бірінші рет хат алып отырсыз.
Dialogue: 0,0:03:43.52,0:03:46.86,Default,,0,0,0,,Бұл мені қуантты және маған ұнады.
Dialogue: 0,0:03:46.86,0:03:48.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:48.86,0:03:51.69,Default,,0,0,0,,<Иә~ Солай ма? ＞
Dialogue: 0,0:03:51.69,0:03:54.53,Default,,0,0,0,,T… Айырмашылық…
Dialogue: 0,0:03:54.53,0:03:56.53,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:03:56.53,0:04:00.04,Default,,0,0,0,,Бір ғана әріппен заттар қозғала бастайды
Dialogue: 0,0:04:00.04,0:04:01.97,Default,,0,0,0,,Ол арзан әйел.
Dialogue: 0,0:04:01.97,0:04:06.24,Default,,0,0,0,,Кітап дүкеніне сен жай тазалаушысың.
Dialogue: 0,0:04:07.81,0:04:11.31,Default,,0,0,0,,<Түсіндім, Ведьма-сама>
Dialogue: 0,0:04:11.31,0:04:13.82,Default,,0,0,0,,<Қаламдас достарды аңсадың ба?>
Dialogue: 0,0:04:13.82,0:04:16.89,Default,,0,0,0,,Көремін, бұл сүйкімді…
Dialogue: 0,0:04:16.89,0:04:18.89,Default,,0,0,0,,Құрметті...!
Dialogue: 0,0:04:18.89,0:04:22.66,Default,,0,0,0,,＜Бірақ шынымды айтсам, мен де емес＞
Dialogue: 0,0:04:22.66,0:04:25.99,Default,,0,0,0,,<Мен бақсылардың қалаға барғанын шынымен қаламаймын>
Dialogue: 0,0:04:25.99,0:04:29.33,Default,,0,0,0,,⚟Жоқ, не? Қараңғы және қорқынышты саңырауқұлақтар тобы
Dialogue: 0,0:04:29.33,0:04:32.00,Default,,0,0,0,,⚟Бұл Шампиньонның сиқыршысы емес пе?
Dialogue: 0,0:04:32.00,0:04:35.50,Default,,0,0,0,,<Саңырауқұлақтар әдеттегіден үлкенірек өседі>
Dialogue: 0,0:04:35.50,0:04:37.51,Default,,0,0,0,,<Сіз нені айтасыз? ＞
Dialogue: 0,0:04:37.51,0:04:40.18,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:04:40.18,0:04:42.18,Default,,0,0,0,,Ах~! Мен сөйлестім!
Dialogue: 0,0:04:42.18,0:04:45.51,Default,,0,0,0,,Қашпа! Әлгі бақсының тынысы улы екен.
Dialogue: 0,0:04:45.51,0:04:47.85,Default,,0,0,0,,Wow, that’s scary!
Dialogue: 0,0:04:47.85,0:04:50.69,Default,,0,0,0,,Түсіндірейін десем де, болды.
Dialogue: 0,0:04:50.69,0:04:53.02,Default,,0,0,0,,If this is done in the village, the town will be considered.
Dialogue: 0,0:04:53.02,0:04:55.86,Default,,0,0,0,,I'm a little worried.
Dialogue: 0,0:04:55.86,0:04:59.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:59.36,0:05:01.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:05.80,0:05:08.14,Default,,0,0,0,,Сәлем балам
Dialogue: 0,0:05:08.14,0:05:10.14,Default,,0,0,0,,If you touch the witch,
Dialogue: 0,0:05:10.14,0:05:14.11,Default,,0,0,0,,Уды ұстасаң, өлесің. Ол мұнда келмейді.
Dialogue: 0,0:05:15.48,0:05:17.48,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:17.48,0:05:20.55,Default,,0,0,0,,Жарайды! Ах...
Dialogue: 0,0:05:20.55,0:05:25.15,Default,,0,0,0,,The witch is not as dangerous as the rumors say.
Dialogue: 0,0:05:25.15,0:05:27.66,Default,,0,0,0,,Қараңдар, мен дәлелмін.
Dialogue: 0,0:05:27.66,0:05:29.66,Default,,0,0,0,,Бұл саңырауқұлақ біраз уақыттан кейін өседі.
Dialogue: 0,0:05:29.66,0:05:31.73,Default,,0,0,0,,Weathering on its own
Dialogue: 0,0:05:31.73,0:05:34.16,Default,,0,0,0,,Толық түсіндірме осында
Dialogue: 0,0:05:34.16,0:05:37.50,Default,,0,0,0,,«Шындығында, Уэноға бір ғана пойызбен жетуге болады»
Dialogue: 0,0:05:37.50,0:05:40.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:40.17,0:05:45.67,Default,,0,0,0,,<Менің күшім: Бақсыға пайдалы болды ма? ＞
Dialogue: 0,0:05:45.67,0:05:48.18,Default,,0,0,0,,<Мен бақсыны қорғай алдым>
Dialogue: 0,0:05:48.18,0:05:50.75,Default,,0,0,0,,<Осындай кішкентай дененің өзінде>
Dialogue: 0,0:05:54.02,0:05:56.02,Default,,0,0,0,,<Бақыттымын>
Dialogue: 0,0:05:56.02,0:05:58.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:01.62,0:06:05.63,Default,,0,0,0,,Luna: Right hand and right foot are out at the same time.
Dialogue: 0,0:06:05.63,0:06:08.30,Default,,0,0,0,,⚟Сонымен, сіз қалада естіген өсек қандай болды? ➡
Dialogue: 0,0:06:08.30,0:06:13.37,Default,,0,0,0,,Rumor has it that the black witch summons a monster that is at the end of its life.
Dialogue: 0,0:06:13.37,0:06:15.37,Default,,0,0,0,,<Ah…>
Dialogue: 0,0:06:15.37,0:06:17.97,Default,,0,0,0,,Бұл ақымақтық па? ⚟Солай ма?
Dialogue: 0,0:06:17.97,0:06:19.98,Default,,0,0,0,,⚟Сіз білмейсіз бе?
Dialogue: 0,0:06:19.98,0:06:22.48,Default,,0,0,0,,<Иә? Бұл не? ＞
Dialogue: 0,0:06:22.48,0:06:25.98,Default,,0,0,0,,<Бұл сезім тағы да>
Dialogue: 0,0:06:25.98,0:06:29.99,Default,,0,0,0,,<The end of the story, every time I hear this name>
Dialogue: 0,0:06:29.99,0:06:35.66,Default,,0,0,0,,<Менің қуанышты көңіл-күйім жоғалып, жүрегім мазасызданды.>
Dialogue: 0,0:06:39.83,0:06:43.20,Default,,0,0,0,,А... жарайды.
Dialogue: 0,0:06:46.67,0:06:48.67,Default,,0,0,0,,<Сен мықты болуың керек>
Dialogue: 0,0:06:48.67,0:06:51.44,Default,,0,0,0,,<Мен сиқыршыны қорғаймын>
Dialogue: 0,0:07:01.62,0:07:07.62,Default,,0,0,0,,(Ауыл тұрғындары төбелесу)
Dialogue: 0,0:07:07.62,0:07:11.19,Default,,0,0,0,,⚟Кя! ⚟Бір минут күте тұрыңыз...
Dialogue: 0,0:07:12.69,0:07:16.70,Default,,0,0,0,,<Бұл қала...? ＞
Dialogue: 0,0:07:16.70,0:07:21.30,Default,,0,0,0,,Өмiрiңiздiң ақырына қол тигенде терiң қараланып, ерiп кетедi.
Dialogue: 0,0:07:21.30,0:07:23.37,Default,,0,0,0,,The air smells so rotten...
Dialogue: 0,0:07:23.37,0:07:30.31,Default,,0,0,0,,<Осы сөздегі адам ақыры зардап шеккен шекаралық қаладан келген босқын шығар...>
Dialogue: 0,0:07:30.31,0:07:35.38,Default,,0,0,0,,Имансыздық пен бидғат ақыретке апарады.
Dialogue: 0,0:07:35.38,0:07:37.65,Default,,0,0,0,,<Әңгіменің соңы...>
Dialogue: 0,0:07:37.65,0:07:41.16,Default,,0,0,0,,The pollution in the city is worse than I thought➡
Dialogue: 0,0:07:41.16,0:07:43.73,Default,,0,0,0,,Лунаға көмектес
Dialogue: 0,0:07:46.49,0:07:50.33,Default,,0,0,0,,Солай ма? The black witch who makes evil poisonous mushrooms
Dialogue: 0,0:07:50.33,0:07:52.40,Default,,0,0,0,,Мен одан құтылдым!
Dialogue: 0,0:07:52.40,0:07:56.40,Default,,0,0,0,,Кола! Сен не істеп жатырсың? Егер сізді жек көрсе не істейсіз? ?
Dialogue: 0,0:07:56.40,0:07:59.17,Default,,0,0,0,,Үстел үстіндегі адам бірдеңені ертерек айтты➡
Dialogue: 0,0:07:59.17,0:08:03.11,Default,,0,0,0,,Артында қалдым деген өшпенділік оны тастайды ➡
Dialogue: 0,0:08:03.11,0:08:05.45,Default,,0,0,0,,Жаман қара бақсы
Dialogue: 0,0:08:05.45,0:08:08.28,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:08:08.28,0:08:10.95,Default,,0,0,0,,Менің қызым да сол бақсының саңырауқұлақтарын жеді.
Dialogue: 0,0:08:10.95,0:08:13.46,Default,,0,0,0,,Мен бір айдан бері қиналып жүрмін.
Dialogue: 0,0:08:16.52,0:08:18.96,Default,,0,0,0,,Не, жоқ...!
Dialogue: 0,0:08:18.96,0:08:21.63,Default,,0,0,0,,Шығу, оба құдай!
Dialogue: 0,0:08:22.63,0:08:24.60,Default,,0,0,0,,Мүмкін тыныс алу әдістерін тым көп қолданғандықтан шығар…
Dialogue: 0,0:08:30.64,0:08:32.61,Default,,0,0,0,,А...
Dialogue: 0,0:08:37.65,0:08:41.98,Default,,0,0,0,,Жерден қол шықты! Өлген адамның қолдары!
Dialogue: 0,0:08:41.98,0:08:45.05,Default,,0,0,0,,Ah~ah~ Ah~ah~…
Dialogue: 0,0:08:45.05,0:08:48.32,Default,,0,0,0,,Сен қорқынышты некроманс!
Dialogue: 0,0:08:48.32,0:08:50.33,Default,,0,0,0,,(Тас лақтыру)
Dialogue: 0,0:08:50.33,0:08:52.29,Default,,0,0,0,,Ведьма!
Dialogue: 0,0:08:53.33,0:08:56.40,Default,,0,0,0,,Тоқта! Барлығы, бұл түсінбеушілік!
Dialogue: 0,0:08:56.40,0:08:58.67,Default,,0,0,0,,Ертегіні тыңдау...
Dialogue: 0,0:08:58.67,0:09:02.17,Default,,0,0,0,,<Өзімнің сүйкімділігімнің күшімен не істеуім керек>
Dialogue: 0,0:09:02.17,0:09:04.74,Default,,0,0,0,,<Мүлдем тиімді емес>
Dialogue: 0,0:09:06.01,0:09:08.08,Default,,0,0,0,,<Мүлдем...>
Dialogue: 0,0:09:08.08,0:09:16.02,Default,,0,0,0,,(мысқылдап ұшып барады)
Dialogue: 0,0:09:16.02,0:09:18.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:18.09,0:09:22.02,Default,,0,0,0,,Каар Луна, қашайық.
Dialogue: 0,0:09:22.02,0:09:24.86,Default,,0,0,0,,Бұл жерде енді саңырауқұлақ өсіру мүмкін емес.
Dialogue: 0,0:09:24.86,0:09:27.36,Default,,0,0,0,,Ризенің жүріс-тұрысы да біртүрлі.
Dialogue: 0,0:09:27.36,0:09:29.36,Default,,0,0,0,,Ах! Құдай-ай!
Dialogue: 0,0:09:29.36,0:09:33.37,Default,,0,0,0,,Осы жағдайға байланысты... біз бірдеңе істеуіміз керек
Dialogue: 0,0:09:33.37,0:09:35.37,Default,,0,0,0,,Егер біз оны қусақ, біз…
Dialogue: 0,0:09:35.37,0:09:40.44,Default,,0,0,0,,Мо, осындай қорқынышты нәрселерді жасайтын адамдар, алаңдайтын ештеңе жоқ.
Dialogue: 0,0:09:40.44,0:09:42.61,Default,,0,0,0,,Мені жалғыз қалдыр...
Dialogue: 0,0:09:44.21,0:09:46.18,Default,,0,0,0,,Ru…!
Dialogue: 0,0:09:48.28,0:09:50.89,Default,,0,0,0,,Ах… Ах…
Dialogue: 0,0:09:50.89,0:09:53.22,Default,,0,0,0,,Не? Мо...?
Dialogue: 0,0:09:53.22,0:09:56.29,Default,,0,0,0,,Ведьма, неге?
Dialogue: 0,0:09:56.29,0:09:59.76,Default,,0,0,0,,Бұл қауіпті! Өтінемін тоқта!
Dialogue: 0,0:10:01.66,0:10:04.50,Default,,0,0,0,,<Маған бұл ұнамайды>
Dialogue: 0,0:10:04.50,0:10:06.47,Default,,0,0,0,,<Маған ұнамайды>
Dialogue: 0,0:10:07.50,0:10:11.34,Default,,0,0,0,,Оны әлі де өсіре бересің бе, бейбақ?
Dialogue: 0,0:10:11.34,0:10:15.41,Default,,0,0,0,,<Мен сүйген адам дәл алдымда>
Dialogue: 0,0:10:15.41,0:10:18.18,Default,,0,0,0,,<Менімен болған жағдайға қарамастан>
Dialogue: 0,0:10:18.18,0:10:21.25,Default,,0,0,0,,<Қорғалмаған, бірақ қорғалған>
Dialogue: 0,0:10:21.25,0:10:24.25,Default,,0,0,0,,<Мен оның қалқаны да бола алмаймын>
Dialogue: 0,0:10:24.25,0:10:27.92,Default,,0,0,0,,<Менің күшім жетпейді...>
Dialogue: 0,0:10:29.26,0:10:33.23,Default,,0,0,0,,《(күлді)》
Dialogue: 0,0:10:40.87,0:10:43.54,Default,,0,0,0,,《Ахаха хаха! 》
Dialogue: 0,0:10:56.22,0:10:58.89,Default,,0,0,0,,Әй, бұл тым көп емес пе?
Dialogue: 0,0:10:58.89,0:11:00.89,Default,,0,0,0,,Қалай болғанда да улы саңырауқұлақтар
Dialogue: 0,0:11:00.89,0:11:04.83,Default,,0,0,0,,Оқиғаға қатысты түсініксіз нәрсе бар.
Dialogue: 0,0:11:04.83,0:11:09.33,Default,,0,0,0,,⚟Мен осы саңырауқұлақтың жанында болғанда, ауа тазарақ болады➡
Dialogue: 0,0:11:09.33,0:11:11.30,Default,,0,0,0,,Мен өзімді жақсы сезінемін...
Dialogue: 0,0:11:12.40,0:11:14.67,Default,,0,0,0,,⚟Үйге қайт! ⚟Кола!
Dialogue: 0,0:11:17.34,0:11:20.01,Default,,0,0,0,,Алыс...
Dialogue: 0,0:11:20.01,0:11:24.51,Default,,0,0,0,,Мен Лунамен баяғыда сөйлескенім есімде.
Dialogue: 0,0:11:24.51,0:11:26.85,Default,,0,0,0,,Мен Лунаға келгенге дейін
Dialogue: 0,0:11:26.85,0:11:31.52,Default,,0,0,0,,Оған дейін сен жалғыз болдың, Луна, сен жалғыз емессің бе? ➡
Dialogue: 0,0:11:31.52,0:11:34.52,Default,,0,0,0,,Ал мені бәрі жек көреді➡
Dialogue: 0,0:11:34.52,0:11:38.86,Default,,0,0,0,,Неліктен мұндай адамдар үшін тазартасың? ➡
Dialogue: 0,0:11:38.86,0:11:43.03,Default,,0,0,0,,Мен болсам, мұңайып өліп кетер едім.
Dialogue: 0,0:11:44.20,0:11:46.70,Default,,0,0,0,,Онда Луна бар...
Dialogue: 0,0:11:46.70,0:11:49.20,Default,,0,0,0,,《Мен жалғыз емес едім》
Dialogue: 0,0:11:49.20,0:11:52.27,Default,,0,0,0,,《Менің қасымда әрқашан орман болды》
Dialogue: 0,0:11:52.27,0:11:56.54,Default,,0,0,0,,《Орман жыл мезгілдеріне қарай сыртқы түрін өзгертеді және әрқашан жанды болады》
Dialogue: 0,0:11:56.54,0:12:00.05,Default,,0,0,0,,《Күнде бұлттар маған әртүрлі пішінде келеді》
Dialogue: 0,0:12:00.05,0:12:02.65,Default,,0,0,0,,《Кейде жаңбыр немесе қар жауады》
Dialogue: 0,0:12:02.65,0:12:06.15,Default,,0,0,0,,《Тіпті ай күн сайын пішінін өзгертеді》
Dialogue: 0,0:12:06.15,0:12:08.82,Default,,0,0,0,,《Қайда барсам да менің соңымнан жүреді》
Dialogue: 0,0:12:08.82,0:12:11.89,Default,,0,0,0,,《Және күн бақылайды》
Dialogue: 0,0:12:11.89,0:12:14.16,Default,,0,0,0,,《Осылайша мен рақымға ие болдым》
Dialogue: 0,0:12:14.16,0:12:17.67,Default,,0,0,0,,《Мұндай қайғылы батыл болуды доғар, Луна》
Dialogue: 0,0:12:17.67,0:12:20.74,Default,,0,0,0,,《Олардың ешқайсысы адам немесе тіпті жануар емес.》
Dialogue: 0,0:12:20.74,0:12:23.00,Default,,0,0,0,,《Мен мұңая бастадым》
Dialogue: 0,0:12:23.00,0:12:26.84,Default,,0,0,0,,《Цу... мен итермелемеймін》
Dialogue: 0,0:12:26.84,0:12:32.91,Default,,0,0,0,,《Мен өзімді ұмытып бара жатқандай сезінемін, бірақ мен жалғыз емеспін.》
Dialogue: 0,0:12:32.91,0:12:35.85,Default,,0,0,0,,《Кейде жүрегім олай сезінбейтін күндер болады》
Dialogue: 0,0:12:35.85,0:12:38.35,Default,,0,0,0,,《Бұл жай ғана бар》 《А...》
Dialogue: 0,0:12:38.35,0:12:41.69,Default,,0,0,0,,《Улы денесі бар қара сиқыршы》
Dialogue: 0,0:12:41.69,0:12:45.69,Default,,0,0,0,,《Бүкіл өміріңді ешкімге жақын өткізе алмайсың》
Dialogue: 0,0:12:45.69,0:12:50.37,Default,,0,0,0,,《Бірақ тек өзім үшін өмір сүруді жалғастыру》
Dialogue: 0,0:12:50.37,0:12:53.43,Default,,0,0,0,,《Тозғанын сезген жүрек》
Dialogue: 0,0:12:53.43,0:12:57.04,Default,,0,0,0,,《Себебі мен жалғыздықтан бағынып бара жатқандай сезінемін》
Dialogue: 0,0:12:57.04,0:12:59.71,Default,,0,0,0,,《Сондықтан, ең кішкентай сұрау да жасалады》
Dialogue: 0,0:12:59.71,0:13:01.71,Default,,0,0,0,,《Қосылғым келеді》
Dialogue: 0,0:13:01.71,0:13:06.65,Default,,0,0,0,,《Кішкентай болса да біреу үшін өмір сүру арқылы》
Dialogue: 0,0:13:06.65,0:13:09.15,Default,,0,0,0,,《Мен тірі қалғандықтан》
Dialogue: 0,0:13:09.15,0:13:12.22,Default,,0,0,0,,<Мен бұл адамды жалғыз қалдырғым келмейді>
Dialogue: 0,0:13:12.22,0:13:15.49,Default,,0,0,0,,<Бірақ менің әлсіздігім>
Dialogue: 0,0:13:15.49,0:13:20.33,Default,,0,0,0,,<Бақсы енді жалғыз жүр>
Dialogue: 0,0:13:20.33,0:13:22.83,Default,,0,0,0,,<Мен күштірек болғым келеді>
Dialogue: 0,0:13:22.83,0:13:28.17,Default,,0,0,0,,<Мен ол кісінің бұлай жалғыз жүруіне жол бермеуім керек>
Dialogue: 0,0:13:28.17,0:13:33.68,Default,,0,0,0,,<Сенің мейірімділігің жеткілікті, мен өзімді ренжітпеймін.>
Dialogue: 0,0:13:33.68,0:13:35.68,Default,,0,0,0,,<Мен қорғағым келеді>
Dialogue: 0,0:13:35.68,0:13:39.01,Default,,0,0,0,,<Енді менің қолымнан келетін жалғыз нәрсе - мұнда жылау>
Dialogue: 0,0:13:39.01,0:13:41.35,Default,,0,0,0,,<Бәрі жеткіліксіз>
Dialogue: 0,0:13:41.35,0:13:44.19,Default,,0,0,0,,<Сол адамның қалқаны болу үшін жеткілікті>
Dialogue: 0,0:13:44.19,0:13:49.26,Default,,0,0,0,,＜Сізді қалдырмай қасыңызда қалуға рұқсат етілгендей＞
Dialogue: 0,0:13:49.26,0:13:51.86,Default,,0,0,0,,<Не жоғалтсаңыз да>
Dialogue: 0,0:13:51.86,0:13:53.93,Default,,0,0,0,,<Осындай күшке ие болу>
Dialogue: 0,0:13:53.93,0:13:58.20,Default,,0,0,0,,<Мен күшті сиқыршы болғым келеді! ＞
Dialogue: 0,0:13:58.20,0:14:01.97,Default,,0,0,0,,Ей, қара бақсы➡
Dialogue: 0,0:14:01.97,0:14:07.64,Default,,0,0,0,,Сіз бе? Қоғамдық тәртіпті бұзатын саңырауқұлақ өсіретін улы бақсы➡
Dialogue: 0,0:14:07.64,0:14:11.48,Default,,0,0,0,,Уау, сондай зиянды бақсы➡
Dialogue: 0,0:14:11.48,0:14:17.49,Default,,0,0,0,,Осы уақытқа дейін бізді ақ бақсылар қара бақсы аулаудан аман алып келді.
Dialogue: 0,0:14:17.49,0:14:20.49,Default,,0,0,0,,<Ақ шебер? ＞
Dialogue: 0,0:14:28.16,0:14:30.50,Default,,0,0,0,,Ха...
Dialogue: 0,0:14:30.50,0:14:34.47,Default,,0,0,0,,Жүзім? Бұл күш...
Dialogue: 0,0:14:35.50,0:14:38.34,Default,,0,0,0,,Менің осыдан кейін шұғыл істеуім керек➡
Dialogue: 0,0:14:38.34,0:14:43.01,Default,,0,0,0,,Жауапкершілікті мойныңызға алып, мына жігітті №6 түрмеге тастаңыз.
Dialogue: 0,0:14:43.01,0:14:45.01,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:14:45.01,0:14:48.02,Default,,0,0,0,,Анриге тікелей тиіспе➡
Dialogue: 0,0:14:48.02,0:14:51.09,Default,,0,0,0,,Теріні шірітетін уы бар көрінеді.
Dialogue: 0,0:14:51.09,0:14:53.05,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:57.53,0:14:59.49,Default,,0,0,0,,Ха...
Dialogue: 0,0:15:09.50,0:15:11.97,Default,,0,0,0,,Анри…
Dialogue: 0,0:15:13.51,0:15:15.48,Default,,0,0,0,,《＜Луна＞》
Dialogue: 0,0:15:28.59,0:15:31.03,Default,,0,0,0,,Мұнда басыңыз
Dialogue: 0,0:15:31.03,0:15:33.69,Default,,0,0,0,,Қарсылық көрсетпеу
Dialogue: 0,0:15:34.86,0:15:38.20,Default,,0,0,0,,Қазір қашып кетсең, жұртты одан сайын арандатасың.
Dialogue: 0,0:15:38.20,0:15:41.27,Default,,0,0,0,,Бұл менің саған деген күдігімді арттыра түседі.
Dialogue: 0,0:15:41.27,0:15:43.27,Default,,0,0,0,,<Анри…>
Dialogue: 0,0:15:43.27,0:15:45.87,Default,,0,0,0,,Тас лақтырмаңыз
Dialogue: 0,0:15:45.87,0:15:48.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:52.21,0:15:54.18,Default,,0,0,0,,《＜Генри…＞》
Dialogue: 0,0:16:01.99,0:16:05.83,Default,,0,0,0,,Шампиньон сиқыршысы... солай ма? ➡
Dialogue: 0,0:16:05.83,0:16:07.90,Default,,0,0,0,,Осы уақытқа дейін жетсеңіз, жақсы.
Dialogue: 0,0:16:07.90,0:16:09.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:09.90,0:16:11.90,Default,,0,0,0,,Мен патша шенеунігімін.
Dialogue: 0,0:16:11.90,0:16:14.84,Default,,0,0,0,,Ақ бақсының қандас туысы болса да.
Dialogue: 0,0:16:14.84,0:16:17.84,Default,,0,0,0,,Өкінішке орай, мен сиқырды қолдана алмаймын➡
Dialogue: 0,0:16:17.84,0:16:22.84,Default,,0,0,0,,Бұл жүзімді тек оны жасаған адамның сиқырымен ашуға болады➡
Dialogue: 0,0:16:22.84,0:16:27.52,Default,,0,0,0,,Қара бақсы ретінде сіз бұл мәселені шеше аласыз ба?
Dialogue: 0,0:16:29.18,0:16:31.85,Default,,0,0,0,,А... мен сені таң қалдырдым ба?
Dialogue: 0,0:16:31.85,0:16:34.69,Default,,0,0,0,,Дұрыс, кешіріңіз➡
Dialogue: 0,0:16:34.69,0:16:40.70,Default,,0,0,0,,Жарайды. Осы уақытқа дейін сені ренжіткен адамдар артыңнан келмейді➡
Dialogue: 0,0:16:40.70,0:16:43.20,Default,,0,0,0,,Сіз жарақат алдыңыз.
Dialogue: 0,0:16:43.20,0:16:45.67,Default,,0,0,0,,Ауырған болуы керек
Dialogue: 0,0:16:49.54,0:16:53.21,Default,,0,0,0,,Уа, ау, ау! Бұл керемет...
Dialogue: 0,0:16:53.21,0:16:58.21,Default,,0,0,0,,Сол жүзімнің сиқырлы шебері де өте шебер.
Dialogue: 0,0:16:58.21,0:17:01.38,Default,,0,0,0,,Иә? Орамал қауіпсіз.
Dialogue: 0,0:17:01.38,0:17:04.15,Default,,0,0,0,,Қорқынышты улы сиқыршы...
Dialogue: 0,0:17:04.15,0:17:07.66,Default,,0,0,0,,Бірақ мені таң қалдырған жайттар көп.
Dialogue: 0,0:17:07.66,0:17:13.16,Default,,0,0,0,,Бұл қауесет сияқты жұмбақ күш, бірақ мен ойлағаннан басқаша➡
Dialogue: 0,0:17:13.16,0:17:15.23,Default,,0,0,0,,Тіпті біраз уақыт бұрын сені алғаш көргенімде➡
Dialogue: 0,0:17:15.23,0:17:18.23,Default,,0,0,0,,Мен көмектескім келеді.
Dialogue: 0,0:17:18.23,0:17:21.24,Default,,0,0,0,,Қазір де, қалай қарасаң да, сен
Dialogue: 0,0:17:21.24,0:17:25.01,Default,,0,0,0,,Ол кәдімгі сүйкімді қыз, жылауық➡
Dialogue: 0,0:17:25.01,0:17:27.84,Default,,0,0,0,,Сыбыс мүлдем сенімсіз.
Dialogue: 0,0:17:27.84,0:17:29.84,Default,,0,0,0,,<Анри…>
Dialogue: 0,0:17:29.84,0:17:31.85,Default,,0,0,0,,(шу)
Dialogue: 0,0:17:31.85,0:17:34.18,Default,,0,0,0,,Жоқ! Мен одан да көп асығуым керек
Dialogue: 0,0:17:34.18,0:17:37.69,Default,,0,0,0,,Сол шығудан қаш, сонда қашуға болады, солай ма?
Dialogue: 0,0:17:37.69,0:17:40.76,Default,,0,0,0,,Неліктен осы уақытқа дейін...
Dialogue: 0,0:17:40.76,0:17:44.36,Default,,0,0,0,,Мені есіңе түсіру мүмкін емес.
Dialogue: 0,0:17:44.36,0:17:46.69,Default,,0,0,0,,Егер мен сені тапсам...
Dialogue: 0,0:17:46.69,0:17:49.03,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:17:49.03,0:17:51.87,Default,,0,0,0,,Бұрынғы бастығым өте ұмытшақ болды.
Dialogue: 0,0:17:51.87,0:17:55.20,Default,,0,0,0,,Осы жерде қалып, ұмытқан тұтқын - тұтқын.
Dialogue: 0,0:17:55.20,0:17:57.87,Default,,0,0,0,,Мен кейде осылай жасаймын.
Dialogue: 0,0:17:57.87,0:17:59.87,Default,,0,0,0,,Өйткені мен сиқырды қолдана алмаймын
Dialogue: 0,0:17:59.87,0:18:04.38,Default,,0,0,0,,Біліксіздік пен непотизмді қалқан ретінде пайдаланып, қанша ақтау ойлап табуға болады.
Dialogue: 0,0:18:04.38,0:18:07.55,Default,,0,0,0,,Ендеше уайымдама, тез жүр...
Dialogue: 0,0:18:17.22,0:18:20.06,Default,,0,0,0,,Сіз біртүрлі нәрсе айтып тұрған сияқтысыз.
Dialogue: 0,0:18:20.06,0:18:22.06,Default,,0,0,0,,Мен сені бірінші рет көргендей емеспін.
Dialogue: 0,0:18:22.06,0:18:24.07,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:24.07,0:18:27.13,Default,,0,0,0,,Бұл арман ма? Бұрынғы өмірде кездестік пе деп ойлаймын➡
Dialogue: 0,0:18:27.13,0:18:32.07,Default,,0,0,0,,Немесе сенің күшті сиқырың мені адастырып жатқан шығар?
Dialogue: 0,0:18:32.07,0:18:35.08,Default,,0,0,0,,《＜Луна, менімен барайық＞》
Dialogue: 0,0:18:35.08,0:18:38.08,Default,,0,0,0,,《＜Үлкен болуы мүмкін бақыттан тыс＞》
Dialogue: 0,0:18:38.08,0:18:41.92,Default,,0,0,0,,《Сізбен кездесе алмаудан асқан бақытсыздық жоқ》
Dialogue: 0,0:18:41.92,0:18:43.92,Default,,0,0,0,,Әйелімен және балаларымен
Dialogue: 0,0:18:43.92,0:18:47.99,Default,,0,0,0,,Сен сияқты қызға не айтарымды білмеймін...
Dialogue: 0,0:18:47.99,0:18:50.76,Default,,0,0,0,,Жоқ, түсіндім...
Dialogue: 0,0:18:50.76,0:18:53.43,Default,,0,0,0,,Қара сиқыршылар қартаймайды, солай ма?
Dialogue: 0,0:18:53.43,0:18:57.30,Default,,0,0,0,,Иә? Жоқ, мәселе осы емес пе?
Dialogue: 0,0:19:00.10,0:19:03.04,Default,,0,0,0,,А... сақ болыңыз.
Dialogue: 0,0:19:03.04,0:19:06.54,Default,,0,0,0,,Ша... мм, сенің атың.
Dialogue: 0,0:19:06.54,0:19:08.51,Default,,0,0,0,,Аты...
Dialogue: 0,0:19:10.38,0:19:15.22,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:19:15.22,0:19:18.05,Default,,0,0,0,,Иә? Не? Бұл...➡
Dialogue: 0,0:19:18.05,0:19:20.39,Default,,0,0,0,,Не?
Dialogue: 0,0:19:20.39,0:19:23.72,Default,,0,0,0,,О! Бұл белгі қорқынышты➡
Dialogue: 0,0:19:23.72,0:19:26.56,Default,,0,0,0,,Әзірше маған бірдеңе істеу керек.
Dialogue: 0,0:19:26.56,0:19:28.56,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:28.56,0:19:31.23,Default,,0,0,0,,Иә? Шляпадан шықты
Dialogue: 0,0:19:31.23,0:19:33.90,Default,,0,0,0,,Дүрбелең басылмай тұрған сияқты.
Dialogue: 0,0:19:33.90,0:19:36.57,Default,,0,0,0,,Бұл Лунаның сиқырының тозғанын білдіре ме?
Dialogue: 0,0:19:36.57,0:19:39.07,Default,,0,0,0,,Ол қайтып келмеген сияқты...
Dialogue: 0,0:19:39.07,0:19:41.08,Default,,0,0,0,,Луна Қызық, не болды? ➡
Dialogue: 0,0:19:41.08,0:19:43.74,Default,,0,0,0,,Бірдеңе болды ма? Бақсы…
Dialogue: 0,0:19:43.74,0:19:46.75,Default,,0,0,0,,Каа Каа
Dialogue: 0,0:19:46.75,0:19:48.75,Default,,0,0,0,,Уф! Әй, Ризе!
Dialogue: 0,0:19:48.75,0:19:50.75,Default,,0,0,0,,Осы жігіттің жақтаушылары қайда және қаншасы жасырынып жатқанын кім білсін?
Dialogue: 0,0:19:50.75,0:19:54.59,Default,,0,0,0,,Ведьма! Ведьма... қайда?
Dialogue: 0,0:19:54.59,0:19:56.59,Default,,0,0,0,,⚟Кя! Ха!
Dialogue: 0,0:19:56.59,0:19:58.59,Default,,0,0,0,,⚟Күтіңіз... (еңіреді)
Dialogue: 0,0:19:58.59,0:20:00.76,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:20:00.76,0:20:07.13,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:20:09.20,0:20:11.21,Default,,0,0,0,,Ризе!
Dialogue: 0,0:20:11.21,0:20:13.21,Default,,0,0,0,,Ахх (жел дыбысы)
Dialogue: 0,0:20:13.21,0:20:15.18,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:19.21,0:20:22.72,Default,,0,0,0,,Не? Бұл...
Dialogue: 0,0:20:22.72,0:20:24.72,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:20:24.72,0:20:28.22,Default,,0,0,0,,Ризе, жақсысың ба? Сіз уланған жоқсыз ба?
Dialogue: 0,0:20:28.22,0:20:30.29,Default,,0,0,0,,Күтілгендей, ә!
Dialogue: 0,0:20:30.29,0:20:33.06,Default,,0,0,0,,Осы уақытқа дейін келдіңіз бе?
Dialogue: 0,0:20:33.06,0:20:36.40,Default,,0,0,0,,Өмірдің ақыры факторын жұқтырған қарғыс атқан бала➡
Dialogue: 0,0:20:36.40,0:20:38.47,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:38.47,0:20:41.90,Default,,0,0,0,,Шекарадағы қалада өлгендерді жою.
Dialogue: 0,0:20:41.90,0:20:46.24,Default,,0,0,0,,Осы жерде дүниеге келген өмірімнің соңы торнадомен шашырап кеткенін білсем ше?
Dialogue: 0,0:20:46.24,0:20:48.74,Default,,0,0,0,,Хомура-кун шынымен ашулы~
Dialogue: 0,0:20:48.74,0:20:51.41,Default,,0,0,0,,Әлгі жігіт қорқынышты...➡
Dialogue: 0,0:20:51.41,0:20:56.08,Default,,0,0,0,,А... Мен білуге болатын амал бар ма деп ойлаймын. Ең сорақысы осы...➡
Dialogue: 0,0:20:56.08,0:20:58.75,Default,,0,0,0,,Мұның соңы немен бітер екен...
Dialogue: 0,0:20:58.75,0:21:04.19,Default,,0,0,0,,Күрсін... Мен қара сиқыршыға немесе басқаларға ұқсамаймын.
Dialogue: 0,0:21:04.19,0:21:07.53,Default,,0,0,0,,Өңдеу әдістеріне неге соншалықты таңдайсың?
Dialogue: 0,0:21:07.53,0:21:11.87,Default,,0,0,0,,Иә, одан құтылсам не істер едім? Ах...
Dialogue: 0,0:21:11.87,0:21:14.94,Default,,0,0,0,,Мен енді мұны істегім келмейді... Мен мұны тоқтатқым келеді.
Dialogue: 0,0:21:14.94,0:21:18.54,Default,,0,0,0,,Не? Бұл жігіттің шағымданғанына біраз болды.
Dialogue: 0,0:21:18.54,0:21:20.88,Default,,0,0,0,,<Ұзақ монолог…>
Dialogue: 0,0:21:20.88,0:21:25.21,Default,,0,0,0,,<Бірақ бұл адам келгенде, қатты жел соқты>
Dialogue: 0,0:21:25.21,0:21:29.88,Default,,0,0,0,,<Жабысқан тоқырау желге ұшты>
Dialogue: 0,0:21:29.88,0:21:33.72,Default,,0,0,0,,<Жүрегім әлі сол желге тұншығып тұр...> Көбінесе Луна-сан
Dialogue: 0,0:21:33.72,0:21:36.06,Default,,0,0,0,,Бұл қалашыққа келеді деген хабар келді... <Оны су шайып кеткен сияқты>
Dialogue: 0,0:21:36.06,0:21:38.13,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:21:38.13,0:21:40.39,Default,,0,0,0,,Лунаның... танысы ма?
Dialogue: 0,0:21:40.39,0:21:43.73,Default,,0,0,0,,Не? не? Біз Лунамен таныспыз ба?
Dialogue: 0,0:21:43.73,0:21:47.57,Default,,0,0,0,,Иә! Уау, мен не дедім
Dialogue: 0,0:21:47.57,0:21:49.57,Default,,0,0,0,,Сіз кездейсоқсыз ба?
Dialogue: 0,0:21:49.57,0:21:53.64,Default,,0,0,0,,Қара сиқыршы кеңесшілерінің бірі болып табылатын жел шебері...
Dialogue: 0,0:21:53.64,0:21:56.64,Default,,0,0,0,,Е... күте тұрыңыз... не?
Dialogue: 0,0:21:56.64,0:21:59.58,Default,,0,0,0,,Сен қайдан білесің! ? Сен не істеп жатырсың?
Dialogue: 0,0:21:59.58,0:22:03.02,Default,,0,0,0,,Қорқынышты, өрескел! а?
Dialogue: 0,0:22:03.02,0:22:07.52,Default,,0,0,0,,Бұл дұрыс емес адам емес пе? Мүмкін бұл тым сәнді
Dialogue: 0,0:22:07.52,0:22:10.52,Default,,0,0,0,,<Қара сиқыршы... Кеңесші? ＞О~? Не, сиыр!
Dialogue: 0,0:22:10.52,0:22:13.19,Default,,0,0,0,,Қорқынышты <Жел шебері? ＞
Dialogue: 0,0:22:13.19,0:22:16.03,Default,,0,0,0,,Аа, мен сенімен енді сөйлесе алмаймын.
Dialogue: 0,0:22:16.03,0:22:18.03,Default,,0,0,0,,Луна-сан, сен қайдасың?
Dialogue: 0,0:22:18.03,0:22:20.53,Default,,0,0,0,,А, мен білемін.
Dialogue: 0,0:22:20.53,0:22:22.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:22.54,0:22:24.51,Default,,0,0,0,,Не? Ал...
Dialogue: 0,0:22:26.37,0:22:28.34,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:22:29.38,0:22:32.25,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:22:33.71,0:22:35.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:37.55,0:22:39.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:42.22,0:23:30.70,Default,,0,0,0,,♬～
Dialogue: 0,0:23:32.20,0:23:38.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory