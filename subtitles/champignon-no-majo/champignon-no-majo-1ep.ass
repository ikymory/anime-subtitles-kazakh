Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.00,0:00:12.27,Default,,0,0,0,,Нәтижесі алдын ала шешіліп қойған.
Dialogue: 0,0:00:15.68,0:00:23.75,Default,,0,0,0,,(Құстар ән салады)
Dialogue: 0,0:00:23.75,0:00:25.92,Default,,0,0,0,,<Қара орманның тереңінде>
Dialogue: 0,0:00:29.76,0:00:32.36,Default,,0,0,0,,<Улы саңырауқұлақтар үйінде жасырын>
Dialogue: 0,0:00:32.36,0:00:35.73,Default,,0,0,0,,<Ол жерде жас бақсы өмір сүрді>
Dialogue: 0,0:00:38.37,0:00:43.34,Default,,0,0,0,,<Жас болса да, келбеті бір адамдардан бірнеше есе ұзақ өмір сүрген...>
Dialogue: 0,0:00:45.71,0:00:49.21,Default,,0,0,0,,<Менің бойым қазіргіден жарты еседей болған кезден>
Dialogue: 0,0:00:49.21,0:00:51.98,Default,,0,0,0,,<Мен мұнда жалғыз тұрдым>
Dialogue: 0,0:00:58.29,0:01:02.26,Default,,0,0,0,,<Соңғы кезде дәрі жасау хоббиге айналғандай>
Dialogue: 0,0:01:03.56,0:01:06.73,Default,,0,0,0,,<Бумен жұмыс істеу конвейердегі жұмыс сезімін береді>
Dialogue: 0,0:01:06.73,0:01:09.73,Default,,0,0,0,,<Сіз кінәсіз бола алатын сияқтысыз.>
Dialogue: 0,0:01:09.73,0:01:15.17,Default,,0,0,0,,<Жасалған дәрі-дәрмектер барлық ауруларға қарсы тиімді және көшеде сатылуы мүмкін.>
Dialogue: 0,0:01:15.17,0:01:18.44,Default,,0,0,0,,<Маған оның практикалық пайда ретінде де қызмет еткені ұнайды>
Dialogue: 0,0:01:19.84,0:01:22.84,Default,,0,0,0,,Луна, сен қалаға барасың ба?
Dialogue: 0,0:01:22.84,0:01:25.01,Default,,0,0,0,,Иә
Dialogue: 0,0:01:28.18,0:01:30.15,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:38.86,0:01:41.86,Default,,0,0,0,,Луна да міне алады.
Dialogue: 0,0:01:41.86,0:01:43.87,Default,,0,0,0,,Үйге қайт
Dialogue: 0,0:01:43.87,0:01:46.87,Default,,0,0,0,,Жүк Бұл мүлдем ауыр емес, сондықтан бәрі жақсы, солай ма?
Dialogue: 0,0:01:46.87,0:01:49.20,Default,,0,0,0,,<Мицуки үшін бір рет> Кел!
Dialogue: 0,0:01:49.20,0:01:52.87,Default,,0,0,0,,<Дайын дәрімен қалаға бару>
Dialogue: 0,0:01:52.87,0:01:56.21,Default,,0,0,0,,Сіз дәрі-дәрмектен түскен ақшаға көбірек кітап алғыңыз келе ме?
Dialogue: 0,0:01:56.21,0:01:58.21,Default,,0,0,0,,Иә
Dialogue: 0,0:01:58.21,0:02:01.88,Default,,0,0,0,,Маған жылы қызыл жилет керек шығар.
Dialogue: 0,0:02:01.88,0:02:03.95,Default,,0,0,0,,Мен оны кеше саған тоқып бердім.
Dialogue: 0,0:02:03.95,0:02:08.82,Default,,0,0,0,,Мен оны кигенде, ол қатып, қышиды және жылағым келеді➡
Dialogue: 0,0:02:08.82,0:02:12.33,Default,,0,0,0,,Ешкі жүнінен жасалған барқыт кеудеше жұмсақ әрі үлпілдек➡
Dialogue: 0,0:02:12.33,0:02:14.66,Default,,0,0,0,,Ылғалды және жылы.
Dialogue: 0,0:02:14.66,0:02:18.50,Default,,0,0,0,,Мелиноның жүнін айналмалы түрде таратасың ба?
Dialogue: 0,0:02:18.50,0:02:21.57,Default,,0,0,0,,Бұл дұрыс емес, үйлесімділік бар ➡
Dialogue: 0,0:02:21.57,0:02:25.84,Default,,0,0,0,,Менің терісім барқыт ешкі түрі деп ойлаймын➡
Dialogue: 0,0:02:25.84,0:02:30.01,Default,,0,0,0,,Әй, біз қалаға жеткенде, жилет сататын дүкенге барсақ болады ма?
Dialogue: 0,0:02:41.92,0:02:47.53,Default,,0,0,0,,Мен сіздің меринос жүнінен жасалған кеудешеңізді барқыт ешкінің құрылымына ауыстырамын.
Dialogue: 0,0:02:47.53,0:02:51.60,Default,,0,0,0,,Бірақ Луна ешкінің барқыт жүніне қол тигізді ме? ➡
Dialogue: 0,0:02:51.60,0:02:56.87,Default,,0,0,0,,Текстураны дұрыс білмейінше, оны қайта шығаруға болмайды деп ойлаймын➡
Dialogue: 0,0:02:56.87,0:02:59.71,Default,,0,0,0,,Содан соң мен лифт дүкеніне бардым➡
Dialogue: 0,0:02:59.71,0:03:01.71,Default,,0,0,0,,Егер кеудешеге тиіспесеңіз...
Dialogue: 0,0:03:01.71,0:03:04.55,Default,,0,0,0,,<Бақсы тиген немесе жүрген жер>
Dialogue: 0,0:03:04.55,0:03:07.72,Default,,0,0,0,,<Бір себептермен улы саңырауқұлақтар жиі өседі>
Dialogue: 0,0:03:07.72,0:03:09.72,Default,,0,0,0,,＜Қала халқы оны құрметтейді＞
Dialogue: 0,0:03:09.72,0:03:14.16,Default,,0,0,0,,<“Шампиньондық сиқыршы” деп аталады>
Dialogue: 0,0:03:14.16,0:04:02.64,Default,,0,0,0,,♬～
Dialogue: 0,0:04:54.66,0:04:57.33,Default,,0,0,0,,Мен сіздің кеудешеңізді ұстай аламын ба?
Dialogue: 0,0:04:57.33,0:04:59.33,Default,,0,0,0,,Бұл мүмкін емес екеніне сенімдімін.
Dialogue: 0,0:04:59.33,0:05:02.30,Default,,0,0,0,,Саңырауқұлақтар өсіп кетуі мүмкін бе?
Dialogue: 0,0:05:03.33,0:05:05.27,Default,,0,0,0,,⚟Оны ұстамаңыз!
Dialogue: 0,0:05:05.27,0:05:07.94,Default,,0,0,0,,Қара бақсының улы саңырауқұлақтарына жақындама!
Dialogue: 0,0:05:07.94,0:05:12.44,Default,,0,0,0,,Кейбір адамдардың терісі саңырауқұлаққа қол тигізгенде ғана жараланып қалады.
Dialogue: 0,0:05:12.44,0:05:15.28,Default,,0,0,0,,⚟Біреулер білмей жеп өлді.
Dialogue: 0,0:05:15.28,0:05:19.11,Default,,0,0,0,,⚟Маған ұнамайды. Одан біртүрлі газ шығып жатыр. Бұл улы газ шығар!
Dialogue: 0,0:05:19.11,0:05:21.45,Default,,0,0,0,,⚟Жоқ, бұл спора.
Dialogue: 0,0:05:21.45,0:05:23.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:23.52,0:05:26.49,Default,,0,0,0,,Аа, бұл кеудеше дүкені.
Dialogue: 0,0:05:27.52,0:05:32.29,Default,,0,0,0,,<Бақсылар қалаларда онша жақсы емес>
Dialogue: 0,0:05:32.29,0:05:37.17,Default,,0,0,0,,Мен сіздің кеудешеңізді ыңғайлы ету үшін жақсартамын.
Dialogue: 0,0:05:42.37,0:05:47.14,Default,,0,0,0,,Өйткені қара бақсының тынысы мен терісінен улы газ шығады!
Dialogue: 0,0:05:47.14,0:05:50.65,Default,,0,0,0,,Қара бақсыға жақындасаң, өлесің! Апыр-ай!
Dialogue: 0,0:05:50.65,0:05:54.48,Default,,0,0,0,,<Қалалардан гөрі, адамдар көп жиналатын жерлерді ұнатпаймын>
Dialogue: 0,0:05:54.48,0:05:57.99,Default,,0,0,0,,<Мен есімде қалғаннан бері осылай болдым>
Dialogue: 0,0:05:57.99,0:06:00.99,Default,,0,0,0,,<Мен ешқашан қайғырған емеспін>
Dialogue: 0,0:06:00.99,0:06:04.26,Default,,0,0,0,,<Бұл денеде көмектесуге болмайды>
Dialogue: 0,0:06:06.93,0:06:09.43,Default,,0,0,0,,(есік ашылады)
Dialogue: 0,0:06:09.43,0:06:11.93,Default,,0,0,0,,Иә? Эй, қош келдіңіз
Dialogue: 0,0:06:11.93,0:06:16.27,Default,,0,0,0,,Шаш өсіретін дәрі-дәрмегім бітті, сен келіп мені құтқардың➡
Dialogue: 0,0:06:16.27,0:06:21.28,Default,,0,0,0,,Бұл тиімді деп айтылады. Келесі жолы маған көбірек әкеле аласыз ба?
Dialogue: 0,0:06:21.28,0:06:25.11,Default,,0,0,0,,Мен де бел ауруы үшін дәрі сұраймын.
Dialogue: 0,0:06:25.11,0:06:32.62,Default,,0,0,0,,<Қала тұрғындарының арасында дәріхана иесі сиқыршылармен салыстырмалы түрде мейірімді.>
Dialogue: 0,0:06:32.62,0:06:35.69,Default,,0,0,0,,<Бақсының дәрі жасау дағдыларын сатып алу>
Dialogue: 0,0:06:35.69,0:06:39.63,Default,,0,0,0,,<Себебі менің қара бақсылар туралы біраз білімім бар>
Dialogue: 0,0:06:39.63,0:06:45.30,Default,,0,0,0,,<Бірақ мен бақсымен жүргенде шөптен жасалған шүберекті ешқашан шешпеймін>
Dialogue: 0,0:06:45.30,0:06:49.47,Default,,0,0,0,,Әй, мына саңырауқұлақтарды да өзіңмен ала кет.
Dialogue: 0,0:06:51.31,0:06:53.78,Default,,0,0,0,,<Оған көмектесу мүмкін емес>
Dialogue: 0,0:06:55.31,0:06:57.31,Default,,0,0,0,,(есік ашылады)
Dialogue: 0,0:06:57.31,0:07:00.15,Default,,0,0,0,,<Ведялар кітап дүкендерін жақсы көреді>
Dialogue: 0,0:07:00.15,0:07:02.72,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:07:03.82,0:07:08.82,Default,,0,0,0,,<Бұл кітап дүкенін рухтар мен адамдардың ұрпақтары басқарады>
Dialogue: 0,0:07:08.82,0:07:12.59,Default,,0,0,0,,<Ол бақсыларды белгілі дәрежеде түсінеді>
Dialogue: 0,0:07:14.00,0:07:19.43,Default,,0,0,0,,Қаланың дүбірі шықты, сондықтан мен оның жақында болатынын білдім.
Dialogue: 0,0:07:19.43,0:07:23.77,Default,,0,0,0,,<Қала тұрғындары бөтен адамдарға және бөгде адамдарға сезімтал>
Dialogue: 0,0:07:23.77,0:07:26.74,Default,,0,0,0,,<Ол адам кейпінде өмір сүреді>
Dialogue: 0,0:07:27.78,0:07:29.78,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:07:29.78,0:07:34.45,Default,,0,0,0,,Әй, сен менің шын жүзіме тағы қарап тұрсың ба? Тоқтатыңыз➡
Dialogue: 0,0:07:34.45,0:07:37.12,Default,,0,0,0,,Маған ғашық болсаң, Қиын боламын.
Dialogue: 0,0:07:37.12,0:07:41.12,Default,,0,0,0,,Көптеген рухтардың осындай мінезі бар.
Dialogue: 0,0:07:41.12,0:07:43.39,Default,,0,0,0,,Келгеніңізге қуаныштымын.
Dialogue: 0,0:07:44.46,0:07:47.96,Default,,0,0,0,,Сіз соңғы рет келгеніңізге біраз уақыт өтті➡
Dialogue: 0,0:07:47.96,0:07:54.04,Default,,0,0,0,,Қала ауасының қатып қалғаны сонша, далаға шығудың көңілін қалдырды.
Dialogue: 0,0:07:54.04,0:07:59.31,Default,,0,0,0,,Бірақ бақсының арқасында мен ақыры шыға аламын деп ойлаймын➡
Dialogue: 0,0:07:59.31,0:08:02.31,Default,,0,0,0,,Бүгін тағы да қаладан уды сордыңыз, солай ма? ➡
Dialogue: 0,0:08:02.31,0:08:04.65,Default,,0,0,0,,Әдеттегідей рахмет➡
Dialogue: 0,0:08:04.65,0:08:08.48,Default,,0,0,0,,Солай болса да, ластануға жауап ретінде➡
Dialogue: 0,0:08:08.48,0:08:14.49,Default,,0,0,0,,Сізде уды ыдырататын саңырауқұлақтарды өсіру қабілетіңіз бар екені таңқаларлық➡
Dialogue: 0,0:08:14.49,0:08:19.16,Default,,0,0,0,,Бақсы мен саңырауқұлақтың өзі улы екені қиын сияқты.
Dialogue: 0,0:08:19.16,0:08:24.50,Default,,0,0,0,,Жу... Жол қиылысындағы алаңда саңырауқұлақтардың көп өскені сонша, мен қиналдым.
Dialogue: 0,0:08:24.50,0:08:27.50,Default,,0,0,0,,О, солай...➡
Dialogue: 0,0:08:27.50,0:08:31.47,Default,,0,0,0,,Өткен аптада сол жерде көпшілік алдында өлім жазасы болды.
Dialogue: 0,0:08:32.84,0:08:37.51,Default,,0,0,0,,Күнәкардың өкініші мен жеккөрініш оның бойына сіңген болуы керек➡
Dialogue: 0,0:08:37.51,0:08:42.68,Default,,0,0,0,,Қызық, сол кезде жиналған арам ойлар улы реакцияға айналды ма?
Dialogue: 0,0:08:43.85,0:08:47.19,Default,,0,0,0,,<Кітап дүкенінің иесі анық айтқан жоқ>
Dialogue: 0,0:08:47.19,0:08:51.96,Default,,0,0,0,,<Көпшілік алдында жазалау бақсы аңшылыққа байланысты шығар>
Dialogue: 0,0:08:53.26,0:08:56.53,Default,,0,0,0,,<Бақсыға таныс болуы мүмкін біреу>
Dialogue: 0,0:08:56.53,0:09:00.60,Default,,0,0,0,,<Ол жазықсыз қылмысы үшін өлтірілген болуы мүмкін>
Dialogue: 0,0:09:00.60,0:09:02.60,Default,,0,0,0,,<Бұл ел шағын болса да>
Dialogue: 0,0:09:02.60,0:09:07.88,Default,,0,0,0,,<Ол бүгінгі күнге дейін сиқыршылардың күші арқылы дамыды.>
Dialogue: 0,0:09:10.31,0:09:12.65,Default,,0,0,0,,<Корольдік отбасы өз билігін басып алу үшін>
Dialogue: 0,0:09:12.65,0:09:17.72,Default,,0,0,0,,<Ұрпақтар бойына күшті ақ сиқыршылар Кисакиде қарсы алынды.>
Dialogue: 0,0:09:17.72,0:09:23.66,Default,,0,0,0,,<Осылайша, патша отбасына қызмет ететіндер ақ сиқыршылар мен ақ сиқыршыларға айналады>
Dialogue: 0,0:09:23.66,0:09:30.13,Default,,0,0,0,,<Мен кездеспегендерді қара сиқыршы және қара сиқыршы ретінде пайдаланып, қара бақсыларды аулай бастадым.>
Dialogue: 0,0:09:32.50,0:09:35.34,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:35.34,0:09:38.21,Default,,0,0,0,,Мен кеше жақсы кітаптар сатып алдым.
Dialogue: 0,0:09:39.34,0:09:43.85,Default,,0,0,0,,Мен бақсыға ұнайтын нәрселерді қарап отырдым.
Dialogue: 0,0:09:43.85,0:09:46.85,Default,,0,0,0,,<Бақсылардың өмір сүруі қиын дүние>
Dialogue: 0,0:09:46.85,0:09:49.68,Default,,0,0,0,,<Олар маған осылай дәрі сатып алды>
Dialogue: 0,0:09:49.68,0:09:54.52,Default,,0,0,0,,<Сүйікті кітаптарын сататын адамдар әлемі>
Dialogue: 0,0:09:54.52,0:09:58.86,Default,,0,0,0,,<Бақсылар әлі де мүлде жаман емес>
Dialogue: 0,0:09:58.86,0:10:02.36,Default,,0,0,0,,Мен 6 Пигу төлеуге қарсы емеспін.
Dialogue: 0,0:10:02.36,0:10:04.53,Default,,0,0,0,,Ой, саңырауқұлақтар өсіп кетті.
Dialogue: 0,0:10:05.37,0:10:09.14,Default,,0,0,0,,Ақшада жағымсыз дірілдер бар.
Dialogue: 0,0:10:11.54,0:10:14.81,Default,,0,0,0,,Әй, бақсы, сенен бір жақсылығым бар.
Dialogue: 0,0:10:14.81,0:10:17.65,Default,,0,0,0,,Біртүрлі кітапты қабылдадым➡
Dialogue: 0,0:10:17.65,0:10:20.48,Default,,0,0,0,,Оған күшті қарғыс бар сияқты➡
Dialogue: 0,0:10:20.48,0:10:25.15,Default,,0,0,0,,Осы кітапты оқығаннан кейін көптеген адамдар жынды болып өлді деген қауесет бар➡
Dialogue: 0,0:10:25.15,0:10:28.12,Default,,0,0,0,,Маған қол тигізу тым қиын...
Dialogue: 0,0:10:35.23,0:10:37.50,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:10:37.50,0:10:39.77,Default,,0,0,0,,Әй, бақсы, бұл қауіпті!
Dialogue: 0,0:10:47.34,0:10:49.68,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:10:49.68,0:10:53.35,Default,,0,0,0,,А... аа... мм
Dialogue: 0,0:10:53.35,0:10:56.18,Default,,0,0,0,,Бітті.
Dialogue: 0,0:10:56.18,0:10:58.25,Default,,0,0,0,,Бұл кітап қазір жақсы.
Dialogue: 0,0:10:58.25,0:11:01.52,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:11:01.52,0:11:06.53,Default,,0,0,0,,Дәмі 150-дей адамды өлтірген қарғыс сияқты.
Dialogue: 0,0:11:06.53,0:11:10.47,Default,,0,0,0,,Өмір бойы білудің қажеті жоқ дәмдер...
Dialogue: 0,0:11:10.47,0:11:12.97,Default,,0,0,0,,Күткендей, бақсылар ғажап.
Dialogue: 0,0:11:12.97,0:11:15.64,Default,,0,0,0,,(Нацуки Субару) Ол қыз неге мұнда? Әлі күндізгі уақыт қой.
Dialogue: 0,0:11:15.64,0:11:18.31,Default,,0,0,0,,<Оны айтсам да...>
Dialogue: 0,0:11:18.31,0:11:21.64,Default,,0,0,0,,<Дүкенге кіргеннен бері шөп хош иісті заттарды жағамыз>
Dialogue: 0,0:11:21.64,0:11:25.31,Default,,0,0,0,,<I'm the owner of the bookstore who won't let go of the crystal>
Dialogue: 0,0:11:25.31,0:11:31.39,Default,,0,0,0,,Ah, as a thank you, if you read this book and find it interesting, I'll give it to the witch.
Dialogue: 0,0:11:31.39,0:11:33.39,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:11:33.39,0:11:35.36,Default,,0,0,0,,Иә, тағы кел.
Dialogue: 0,0:11:36.66,0:11:40.33,Default,,0,0,0,,<Бұрын, бақсы қайтқан соң>
Dialogue: 0,0:11:40.33,0:11:43.16,Default,,0,0,0,,<Look at the place the witch touched with a serious face>
Dialogue: 0,0:11:43.16,0:11:46.23,Default,,0,0,0,,<Оларды лаймен сүрткенін де білемін.>
Dialogue: 0,0:11:47.24,0:11:50.67,Default,,0,0,0,,<I appreciate that you don't do it in front of me>
Dialogue: 0,0:11:50.67,0:11:56.01,Default,,0,0,0,,<Маған бәрібір, өйткені мені қайтармаған Ұстазға ризамын>
Dialogue: 0,0:11:56.01,0:11:57.98,Default,,0,0,0,,<Менде бәрі жақсы>
Dialogue: 0,0:12:02.35,0:12:06.52,Default,,0,0,0,,(Әйелдердің жанды дауыстары)
Dialogue: 0,0:12:06.52,0:12:08.96,Default,,0,0,0,,Иә? Луна?
Dialogue: 0,0:12:08.96,0:12:12.46,Default,,0,0,0,,⚟I was waiting for this medicine to be resold.
Dialogue: 0,0:12:12.46,0:12:16.13,Default,,0,0,0,,Төсек тартып жатқан анам осылай емделді...
Dialogue: 0,0:12:16.13,0:12:20.80,Default,,0,0,0,,⚟Someday, I would like to thank the person who created this medicine.
Dialogue: 0,0:12:20.80,0:12:25.67,Default,,0,0,0,,⚟Thank you for making it affordable for common people...
Dialogue: 0,0:12:29.14,0:12:31.98,Default,,0,0,0,,<There are many things I don't like about the city>
Dialogue: 0,0:12:31.98,0:12:35.48,Default,,0,0,0,,<Қалада тек осылай ләззат алуға болады>
Dialogue: 0,0:12:35.48,0:12:38.49,Default,,0,0,0,,<You will also find something worth coming to.>
Dialogue: 0,0:12:38.49,0:12:42.56,Default,,0,0,0,,⚟Good, my child will definitely be fine with this medicine...
Dialogue: 0,0:12:42.56,0:12:45.33,Default,,0,0,0,,⚟Ол қандай адам?
Dialogue: 0,0:12:45.33,0:12:50.33,Default,,0,0,0,,<I'm sure you can't meet that if you stay alone in a house in the forest>
Dialogue: 0,0:12:50.33,0:12:56.30,Default,,0,0,0,,<A scene of reward for taking a step into the outside world with courage>
Dialogue: 0,0:12:58.17,0:13:04.51,Default,,0,0,0,,If they knew Luna made it, they probably wouldn't buy that drug.
Dialogue: 0,0:13:04.51,0:13:09.52,Default,,0,0,0,,But if Luna is happy with that, then that's fine with me too.
Dialogue: 0,0:13:09.52,0:13:14.96,Default,,0,0,0,,<The fatigue from today's day in the city was wiped away in an instant>
Dialogue: 0,0:13:14.96,0:13:19.03,Default,,0,0,0,,<For witches, it's more than magic, it's magical time.>
Dialogue: 0,0:13:19.03,0:13:23.00,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:40.82,0:13:44.65,Default,,0,0,0,,We can't handle medicine that will make you grow legs.
Dialogue: 0,0:13:44.65,0:13:47.32,Default,,0,0,0,,Егер сіз осындай сапасыз дәріні сатсаңыз➡
Dialogue: 0,0:13:47.32,0:13:50.16,Default,,0,0,0,,Әсіресе егер ол жұмыс істесе➡
Dialogue: 0,0:13:50.16,0:13:53.43,Default,,0,0,0,,Өйткені сен мені қадағалай аласың.
Dialogue: 0,0:13:54.50,0:13:58.17,Default,,0,0,0,,Біртүрлі дәрілерді көп жасамаңыз➡
Dialogue: 0,0:13:58.17,0:14:02.24,Default,,0,0,0,,Сіз жай ғана қара бақсысыз➡
Dialogue: 0,0:14:02.24,0:14:05.34,Default,,0,0,0,,Мм...
Dialogue: 0,0:14:05.34,0:14:08.34,Default,,0,0,0,,Иә? Жоқ, жақсы емес
Dialogue: 0,0:14:08.34,0:14:10.81,Default,,0,0,0,,Нашар араластыру әдісі?
Dialogue: 0,0:14:11.95,0:14:17.12,Default,,0,0,0,,It was a work of pride that I worked so hard to make.
Dialogue: 0,0:14:18.45,0:14:22.72,Default,,0,0,0,,Are you looking for the old man without a leg?
Dialogue: 0,0:14:25.53,0:14:28.80,Default,,0,0,0,,Even if I ask you where you are, it seems like you won't tell me.
Dialogue: 0,0:14:28.80,0:14:32.13,Default,,0,0,0,,Even if you are found, will you still receive medicine from us?
Dialogue: 0,0:14:32.13,0:14:34.20,Default,,0,0,0,,Мүмкін сен мені осылай жек көретін шығарсың
Dialogue: 0,0:14:34.20,0:14:36.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:38.81,0:14:40.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:41.81,0:14:43.88,Default,,0,0,0,,Сіз бәрібір іздеп жүрсіз бе?
Dialogue: 0,0:14:43.88,0:14:47.32,Default,,0,0,0,,Кітап дүкенінен немесе дәріханадан сұрауым керек пе? ➡
Dialogue: 0,0:14:47.32,0:14:49.65,Default,,0,0,0,,Мен мақта-кәмпит содасын ішкім келеді.
Dialogue: 0,0:14:49.65,0:14:51.65,Default,,0,0,0,,Эй, сен менімен кездескің келді ме?
Dialogue: 0,0:14:51.65,0:14:54.16,Default,,0,0,0,,Мен сені сағындым хехехе Мен де
Dialogue: 0,0:14:54.16,0:14:59.23,Default,,0,0,0,,<Осылай бір-біріне жабысқан адамдармен күлетін адам бақсы>
Dialogue: 0,0:14:59.23,0:15:01.70,Default,,0,0,0,,<Алғашында бұл өте біртүрлі болды>
Dialogue: 0,0:15:02.83,0:15:06.00,Default,,0,0,0,,<Егер сіз оның улы конституциясы бар сиқыршымен байланыста болсаңыз>
Dialogue: 0,0:15:06.00,0:15:08.97,Default,,0,0,0,,＜Себебі екінші тарап мұны тегін жасай алмайды＞
Dialogue: 0,0:15:10.44,0:15:12.44,Default,,0,0,0,,<Бақсыларға тартылатын адамдар>
Dialogue: 0,0:15:12.44,0:15:15.51,Default,,0,0,0,,<Себебі менің терім ауырып, тыныс алуым қиындап кетті>
Dialogue: 0,0:15:15.51,0:15:19.08,Default,,0,0,0,,<Енді ешкім бақсыға жақындауға тырыспайды>
Dialogue: 0,0:15:22.45,0:15:26.62,Default,,0,0,0,,<Бақсылар адамның жылуын түсіне алмайды>
Dialogue: 0,0:15:27.52,0:15:31.96,Default,,0,0,0,,Ей, әлгі қара бақсы маған біраздан бері қарап тұр.
Dialogue: 0,0:15:31.96,0:15:36.03,Default,,0,0,0,,Жарайды, сенің сұлулығыңа бәрі тамсанады.
Dialogue: 0,0:15:36.03,0:15:39.30,Default,,0,0,0,,⚟Анри қазірдің өзінде!
Dialogue: 0,0:15:39.30,0:15:43.14,Default,,0,0,0,,＜Қазір бұл махаббат деп аталады＞
Dialogue: 0,0:15:43.14,0:15:45.21,Default,,0,0,0,,<Мен кітаптан оқимын>
Dialogue: 0,0:15:47.14,0:15:51.21,Default,,0,0,0,,<Бақсылар адам жасай алмайтын көп нәрсені істей алады.>
Dialogue: 0,0:15:51.21,0:15:55.88,Default,,0,0,0,,<Адамдар кәдімгідей жасай алатын нәрселерді сиқыршылар жасай алмайды.>
Dialogue: 0,0:15:56.98,0:15:59.99,Default,,0,0,0,,<Махаббат солардың бірі шығар>
Dialogue: 0,0:15:59.99,0:16:04.99,Default,,0,0,0,,<Бірақ маған бәрібір, өйткені бәрі тегін>
Dialogue: 0,0:16:04.99,0:16:07.50,Default,,0,0,0,,<Менде бәрі жақсы>
Dialogue: 0,0:16:07.50,0:16:10.16,Default,,0,0,0,,Бір аяғы жоқ орта жастағы ер адам...
Dialogue: 0,0:16:10.16,0:16:13.84,Default,,0,0,0,,Жақында болған соғыста мұндайлар өте аз болды.
Dialogue: 0,0:16:13.84,0:16:16.00,Default,,0,0,0,,Мен оны қарастырамын.
Dialogue: 0,0:16:17.51,0:16:21.01,Default,,0,0,0,,Айтпақшы, не болды? Бұл
Dialogue: 0,0:16:21.01,0:16:23.01,Default,,0,0,0,,Пуха➡
Dialogue: 0,0:16:23.01,0:16:26.85,Default,,0,0,0,,Бір қарияны іздеп жүріп, ерлі-зайыптыларды көргенімде бірдеңе болды.
Dialogue: 0,0:16:26.85,0:16:28.92,Default,,0,0,0,,Сиырдың айтқанын түсінбеймін
Dialogue: 0,0:16:28.92,0:16:31.19,Default,,0,0,0,,Мо!
Dialogue: 0,0:16:31.19,0:16:36.16,Default,,0,0,0,,Аа, егер бұл танымал романтикалық роман болса, ол сол сөреде.
Dialogue: 0,0:16:39.03,0:16:42.30,Default,,0,0,0,,Луна! Минос!
Dialogue: 0,0:16:44.53,0:16:46.53,Default,,0,0,0,,Қайтадан қош келдіңіз~
Dialogue: 0,0:16:46.53,0:16:49.37,Default,,0,0,0,,Кәдесыйлар ше? ➡
Dialogue: 0,0:16:49.37,0:16:51.37,Default,,0,0,0,,Маған кәдесыйыңызды көрсетіңіз
Dialogue: 0,0:16:51.37,0:16:55.38,Default,,0,0,0,,Үйге келсем, тағы кітаптар шығар.
Dialogue: 0,0:16:55.38,0:16:57.88,Default,,0,0,0,,Тағы соғу керек пе?
Dialogue: 0,0:16:57.88,0:17:02.22,Default,,0,0,0,,Оған көмектесуге болмайды, қара бақсылардан бас тартатын дүкендер ғана бар.
Dialogue: 0,0:17:02.22,0:17:06.65,Default,,0,0,0,,Ах...Маған суреті бар кітаптар ұнайды.
Dialogue: 0,0:17:06.65,0:17:08.66,Default,,0,0,0,,Аузында көбік бар.
Dialogue: 0,0:17:08.66,0:17:11.99,Default,,0,0,0,,Қалаға барсам, артымнан ереді. (Мелинё) Солай ма?
Dialogue: 0,0:17:11.99,0:17:17.06,Default,,0,0,0,,<Кітап оқығанда, мен бар әлемнен қашамын>
Dialogue: 0,0:17:17.06,0:17:22.07,Default,,0,0,0,,<Кітап ішіндегі әлемде өз-өзіңнің басқа нұсқасына айнала алатындай>
Dialogue: 0,0:17:22.07,0:17:25.67,Default,,0,0,0,,<Бұл менің күйзеліске ұшырайтын мәселелерден арылуға болатын сәт>
Dialogue: 0,0:17:25.67,0:17:28.01,Default,,0,0,0,,<Мен бақсыларды жақсы көремін>
Dialogue: 0,0:17:28.01,0:17:32.35,Default,,0,0,0,,<Кітапта маған ұқсайтын адамдар бар>
Dialogue: 0,0:17:32.35,0:17:35.72,Default,,0,0,0,,<Сиқырсыз қауіпті шытырман оқиғаға бару>
Dialogue: 0,0:17:40.69,0:17:43.69,Default,,0,0,0,,<Presenting research results>
Dialogue: 0,0:17:43.69,0:17:46.03,Default,,0,0,0,,<Бақытсыз немесе бақытты>
Dialogue: 0,0:17:46.03,0:17:48.36,Default,,0,0,0,,Ах~ (Мелинё) Ах!
Dialogue: 0,0:17:48.36,0:17:51.87,Default,,0,0,0,,Were you reading a book there?
Dialogue: 0,0:17:51.87,0:17:56.87,Default,,0,0,0,,<Өйткені мен осындай кітаптар арқылы өмірдің әртүрлі қырларын біле алдым>
Dialogue: 0,0:17:56.87,0:17:58.94,Default,,0,0,0,,<Басқаларды орындай алмасаңыз да>
Dialogue: 0,0:17:58.94,0:18:02.11,Default,,0,0,0,,<The witch was not lonely at all>
Dialogue: 0,0:18:11.82,0:18:13.82,Default,,0,0,0,,Луна➡
Dialogue: 0,0:18:13.82,0:18:17.19,Default,,0,0,0,,Романтика туралы бірдеңе оқығың келмеді ме?
Dialogue: 0,0:18:18.49,0:18:22.96,Default,,0,0,0,,<Of course, love is one of them>
Dialogue: 0,0:18:26.50,0:18:31.17,Default,,0,0,0,,Әй, Луна, бұл қандай әңгіме?
Dialogue: 0,0:18:40.35,0:18:43.02,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:18:43.02,0:18:45.49,Default,,0,0,0,,So beautiful~ Ahaha
Dialogue: 0,0:18:56.70,0:18:59.47,Default,,0,0,0,,<The witch also likes to draw>
Dialogue: 0,0:19:00.53,0:19:04.61,Default,,0,0,0,,Luna, what are you drawing?
Dialogue: 0,0:19:04.61,0:19:06.97,Default,,0,0,0,,А, мен түсіндім! ➡
Dialogue: 0,0:19:06.97,0:19:10.64,Default,,0,0,0,,Бүгін көшеде көрген жұптың баласы!
Dialogue: 0,0:19:10.64,0:19:13.98,Default,,0,0,0,,Өте жақсы! Дәл~ сияқты
Dialogue: 0,0:19:13.98,0:19:18.49,Default,,0,0,0,,<Суреттегі ханзададан да сиқыршы>
Dialogue: 0,0:19:18.49,0:19:23.49,Default,,0,0,0,,<That boy I saw today looked prettier>
Dialogue: 0,0:19:23.49,0:19:26.16,Default,,0,0,0,,<Witches love beautiful things>
Dialogue: 0,0:19:26.16,0:19:30.83,Default,,0,0,0,,<Бірақ мен өзімнің уым сол сұлуды жоя ма деп қорқамын>
Dialogue: 0,0:19:30.83,0:19:35.50,Default,,0,0,0,,<Не ұнаса, оны көзіңізге, жүрегіңізге күйдіріп, суретке көшіріңіз>
Dialogue: 0,0:19:35.50,0:19:39.27,Default,,0,0,0,,<Мен оларды қағазға жинауды асыға күтемін>
Dialogue: 0,0:19:40.57,0:19:44.01,Default,,0,0,0,,<Мен оның сүйкімділігін шынайы түрде жаңғыртқым келеді> Керемет.
Dialogue: 0,0:19:44.01,0:19:47.18,Default,,0,0,0,,<Бақсының сурет салу шеберлігі ғажап...>
Dialogue: 0,0:19:48.35,0:19:52.02,Default,,0,0,0,,＜Қазір мен кейде оған барымды саламын＞
Dialogue: 0,0:19:52.02,0:19:54.52,Default,,0,0,0,,<Regardless of the witch's will>
Dialogue: 0,0:19:54.52,0:19:59.03,Default,,0,0,0,,<Рұқсатсыз жан суретте тұруы мүмкін>
Dialogue: 0,0:19:59.03,0:20:01.03,Default,,0,0,0,,<The witch is just a picture>
Dialogue: 0,0:20:01.03,0:20:05.80,Default,,0,0,0,,<Біреу маған бірінші рет осылай мейіріммен күлді...>
Dialogue: 0,0:20:11.21,0:20:14.88,Default,,0,0,0,,I'm inviting you to the dance, Luna!
Dialogue: 0,0:20:21.48,0:20:23.95,Default,,0,0,0,,Хмм... Сәлем!
Dialogue: 0,0:20:25.32,0:20:27.69,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:20:31.16,0:20:35.50,Default,,0,0,0,,<Суреттен шыққан жұқа, жылы қол>
Dialogue: 0,0:20:35.50,0:20:40.97,Default,,0,0,0,,<Дегенмен, бұл бақсы ұстаған алғашқы адам қолы>
Dialogue: 0,0:20:45.17,0:20:47.84,Default,,0,0,0,,Қош келдіңіз! <I feel like I could fly to the moon>
Dialogue: 0,0:20:47.84,0:20:50.68,Default,,0,0,0,,<Жүрегім ауада қалықтайды>
Dialogue: 0,0:20:50.68,0:20:53.01,Default,,0,0,0,,<Мен оны қалағанымша баса алмаймын>
Dialogue: 0,0:20:53.01,0:20:57.99,Default,,0,0,0,,<Мен армандаған би тек кітапта ғана болады>
Dialogue: 0,0:20:59.09,0:21:01.69,Default,,0,0,0,,<Күтпеген жерден болған түнгі аспандағы бұл серуен>
Dialogue: 0,0:21:01.69,0:21:05.63,Default,,0,0,0,,<Қанша махаббат хикаялары қосылса да, сәйкес келмейді>
Dialogue: 0,0:21:05.63,0:21:11.30,Default,,0,0,0,,<Басынан өткізуге болмайтын ғажайып уақыт>
Dialogue: 0,0:21:11.30,0:21:14.77,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:21:20.37,0:21:22.34,Default,,0,0,0,,Луна!
Dialogue: 0,0:21:37.16,0:21:39.73,Default,,0,0,0,,Луна, жақсысың ба?
Dialogue: 0,0:21:41.66,0:21:44.73,Default,,0,0,0,,Бұл қағазға қайта оралды.
Dialogue: 0,0:21:49.50,0:21:52.51,Default,,0,0,0,,<Осы айлы түн сияқты>
Dialogue: 0,0:21:52.51,0:21:57.78,Default,,0,0,0,,<Бұл бақсының бүкіл өмірінде жарқыраған ерекше уақыт болды.>
Dialogue: 0,0:22:05.29,0:22:09.36,Default,,0,0,0,,Сіз бүгін қағаз бен қарындаш сатып алғыңыз келе ме?
Dialogue: 0,0:22:09.36,0:22:13.63,Default,,0,0,0,,Мен ол баланы содан кейін көп салғанмын➡
Dialogue: 0,0:22:13.63,0:22:17.46,Default,,0,0,0,,Бірақ бұл жалғыз рет ол өздігінен қозғалды➡
Dialogue: 0,0:22:17.46,0:22:23.47,Default,,0,0,0,,Мүмкін мен ол баланың түрін ұмытып кеткен шығармын➡
Dialogue: 0,0:22:23.47,0:22:29.24,Default,,0,0,0,,Көлемді бетке қарап, дұрыстап салсам, қайта қозғала ма екен?
Dialogue: 0,0:22:30.48,0:22:34.45,Default,,0,0,0,,Қағаз мен қарындаш сатады деп үміттенемін.
Dialogue: 0,0:22:36.15,0:22:39.22,Default,,0,0,0,,Эй Луна, көп сатсаң➡
Dialogue: 0,0:22:39.22,0:22:41.66,Default,,0,0,0,,Менің де суретімді салыңыз➡
Dialogue: 0,0:22:41.66,0:22:47.16,Default,,0,0,0,,Өте керемет көрінеді. Маған мүйіздерінің 3 есе ұзағырақ болғаны ұнайды➡
Dialogue: 0,0:22:47.16,0:22:50.50,Default,,0,0,0,,Иә? Бұл қазірден бастап жұп➡
Dialogue: 0,0:22:50.50,0:22:53.57,Default,,0,0,0,,Бірақ бұл бұрынғыдан өзгеше, солай емес пе? ➡
Dialogue: 0,0:22:53.57,0:22:55.84,Default,,0,0,0,,Әсіресе ұлдар➡
Dialogue: 0,0:22:55.84,0:22:59.84,Default,,0,0,0,,Бірдеңе өзінің сүйкімділігін бойына сіңіріп, оны тұншықтай қалдырды.
Dialogue: 0,0:22:59.84,0:23:02.68,Default,,0,0,0,,⚟Тыңдаңыз!
Dialogue: 0,0:23:02.68,0:23:05.61,Default,,0,0,0,,Мен Анриді кездестіргенде, ол кенеттен жалықтыратын адамға айналды.
Dialogue: 0,0:23:05.61,0:23:07.62,Default,,0,0,0,,Е... Е...
Dialogue: 0,0:23:07.62,0:23:09.68,Default,,0,0,0,,⚟Маған енді ондай жігіт керек емес➡
Dialogue: 0,0:23:09.68,0:23:13.12,Default,,0,0,0,,Түс неге кенет өшіп қалды➡ деп ойлаймын
Dialogue: 0,0:23:13.12,0:23:18.13,Default,,0,0,0,,Мен сол қорқынышты қара ведьманы көргеннен бері.
Dialogue: 0,0:23:18.13,0:23:20.09,Default,,0,0,0,,Луна?
Dialogue: 0,0:23:23.63,0:23:26.20,Default,,0,0,0,,<Жарқыраған, жарқыраған...>
Dialogue: 0,0:23:28.14,0:23:32.97,Default,,0,0,0,,⚟Уау, мына жаққа қара! ⚟Тамаша~
Dialogue: 0,0:23:32.97,0:23:35.94,Default,,0,0,0,,⚟Қараңыз! Сондай сүйкімді~
Dialogue: 0,0:23:38.48,0:23:41.48,Default,,0,0,0,,Әй, сен!
Dialogue: 0,0:23:41.48,0:23:43.45,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:23:44.49,0:23:49.16,Default,,0,0,0,,Луна, мен сені шақырып жатырмын. Маған қағаз бен қарындаш сатып алу керек пе?
Dialogue: 0,0:23:49.16,0:23:51.83,Default,,0,0,0,,Жарайды, енді.
Dialogue: 0,0:23:51.83,0:23:54.66,Default,,0,0,0,,Мен сурет салмаймын.
Dialogue: 0,0:23:54.66,0:23:57.00,Default,,0,0,0,,Жоқ, Анриге не болды?
Dialogue: 0,0:23:57.00,0:23:59.27,Default,,0,0,0,,Сол қара сиқыршыны қуу
Dialogue: 0,0:24:00.50,0:24:02.57,Default,,0,0,0,,Ах... Неге... Қызық...
Dialogue: 0,0:24:02.57,0:24:06.51,Default,,0,0,0,,Ол кенеттен қара бақсыға айнала ма, жоқ па бәрібір➡
Dialogue: 0,0:24:06.51,0:24:10.28,Default,,0,0,0,,Мен оны сүйкімді және мейірімді қыз деп ойладым...
Dialogue: 0,0:24:11.45,0:24:13.78,Default,,0,0,0,,⚟Жоқ~ Не? ол
Dialogue: 0,0:24:13.78,0:24:17.85,Default,,0,0,0,,Неге... Мен онымен ешқашан сөйлескен емеспін➡
Dialogue: 0,0:24:17.85,0:24:22.32,Default,,0,0,0,,Келесі жолы сізді көргенде, мен сізге қайта қоңырау шалуға тырысамын.
Dialogue: 0,0:24:31.33,0:24:33.30,Default,,0,0,0,,Сәлем бақсы
Dialogue: 0,0:24:34.84,0:24:38.21,Default,,0,0,0,,Эй, сенің атың кім?
Dialogue: 0,0:24:41.68,0:24:43.74,Default,,0,0,0,,Иә, сіз
Dialogue: 0,0:24:43.74,0:24:46.68,Default,,0,0,0,,Бұл суреттегі бала.
Dialogue: 0,0:24:46.68,0:24:50.68,Default,,0,0,0,,<Бақсыға көшеде дұшпандықсыз адамдар келді>
Dialogue: 0,0:24:50.68,0:24:53.52,Default,,0,0,0,,<Бұл өте сирек>
Dialogue: 0,0:24:53.52,0:24:59.49,Default,,0,0,0,,<Мен кеше болған оқиғаға қатты өкінемін және өзімді кінәлі сезінемін...>
Dialogue: 0,0:25:00.59,0:25:03.20,Default,,0,0,0,,Менің атым Анри
Dialogue: 0,0:25:03.20,0:25:08.14,Default,,0,0,0,,Эй, сенің атың Луна шығар?
Dialogue: 0,0:25:08.14,0:25:12.14,Default,,0,0,0,,⚟Уау, қара бақсыларды жинау деген жоқ.
Dialogue: 0,0:25:12.14,0:25:14.14,Default,,0,0,0,,Анри жай ғана ешкім емес.
Dialogue: 0,0:25:14.14,0:25:17.14,Default,,0,0,0,,Әйелдер әлемінің қаһарманы
Dialogue: 0,0:25:17.14,0:25:20.11,Default,,0,0,0,,Біз бұрын кездескенбіз...
Dialogue: 0,0:25:21.15,0:25:23.48,Default,,0,0,0,,... дұрыс па?
Dialogue: 0,0:25:23.48,0:25:25.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:27.55,0:25:29.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:29.82,0:25:31.83,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:25:31.83,0:25:34.50,Default,,0,0,0,,Оның тербелуі де стандарттан тыс.
Dialogue: 0,0:25:34.50,0:25:38.67,Default,,0,0,0,,Тым~ Луна, күте тұрыңыз~
Dialogue: 0,0:25:44.84,0:25:47.17,Default,,0,0,0,,А, міне, келді➡
Dialogue: 0,0:25:47.17,0:25:49.51,Default,,0,0,0,,Уши-кун, мен сені алып кетуге келдім➡
Dialogue: 0,0:25:49.51,0:25:51.98,Default,,0,0,0,,Күтпеген саңырауқұлақтың ішінен
Dialogue: 0,0:25:53.51,0:25:58.52,Default,,0,0,0,,Сондай-ақ~ Лунаның ақымақ, мен оны сонда қалдырдым!
Dialogue: 0,0:25:58.52,0:26:00.85,Default,,0,0,0,,Уф... кешіріңіз де!
Dialogue: 0,0:26:00.85,0:26:02.86,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:26:02.86,0:26:07.29,Default,,0,0,0,,Мен сенің өте ұялшақ екеніңді Уши-куннан естідім.
Dialogue: 0,0:26:07.29,0:26:09.36,Default,,0,0,0,,Мені көбірек ұрыңыз!
Dialogue: 0,0:26:09.36,0:26:12.83,Default,,0,0,0,,Сізбен кенеттен сөйлескенім үшін кешіріңіз.
Dialogue: 0,0:26:14.30,0:26:19.64,Default,,0,0,0,,Мен... Қашып кеткен мен едім...
Dialogue: 0,0:26:19.64,0:26:25.48,Default,,0,0,0,,Ол басқаларға қиындық тудырды...
Dialogue: 0,0:26:25.48,0:26:28.32,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:26:28.32,0:26:30.32,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:26:30.32,0:26:35.39,Default,,0,0,0,,Бұл менің қиялым емес еді. Біз бұрын кездескенбіз, солай ма?
Dialogue: 0,0:26:35.39,0:26:38.83,Default,,0,0,0,,Айлы аспанда бірге биледік, солай ма?
Dialogue: 0,0:26:38.83,0:26:42.50,Default,,0,0,0,,Суретші болған кезім есімде...
Dialogue: 0,0:26:44.90,0:26:48.87,Default,,0,0,0,,Сол кездегі жүзіңді ұмыта алмаймын.
Dialogue: 0,0:26:49.90,0:26:53.17,Default,,0,0,0,,Ей, неге ол кезде...
Dialogue: 0,0:26:58.35,0:27:00.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:00.35,0:27:02.35,Default,,0,0,0,,Маған тиіспе
Dialogue: 0,0:27:02.35,0:27:05.02,Default,,0,0,0,,Өтінемін, маған жақындама
Dialogue: 0,0:27:05.02,0:27:09.46,Default,,0,0,0,,Себебі сен ол кезде шынайы емес едің...
Dialogue: 0,0:27:09.46,0:27:13.43,Default,,0,0,0,,Осылай болса да мен саған тиісе алдым
Dialogue: 0,0:27:14.53,0:27:20.97,Default,,0,0,0,,Нағыз мен – қазіргі өміріңізде сізге зиян келтіретін улы масса.
Dialogue: 0,0:27:20.97,0:27:25.64,Default,,0,0,0,,Сіздің суретіңізді рұқсатсыз салғаным үшін кешіріңіз...
Dialogue: 0,0:27:27.04,0:27:31.81,Default,,0,0,0,,Бұл керемет. Мен қауесеттерді естідім.
Dialogue: 0,0:27:31.81,0:27:33.88,Default,,0,0,0,,Шампиньон сиқыры
Dialogue: 0,0:27:33.88,0:27:38.32,Default,,0,0,0,,Шынында да, саңырауқұлақтар қол тигізген жерде өседі➡
Dialogue: 0,0:27:38.32,0:27:43.79,Default,,0,0,0,,Мен таң қалдым~ Сіз де, Киноко да мен ойлағаннан да сүйкімді екенсіз.
Dialogue: 0,0:27:45.16,0:27:50.66,Default,,0,0,0,,Ал мен сол кездегідей сезінгендей, бұл бәрі айтып жүрген қауесеттерден мүлде басқаша болды.
Dialogue: 0,0:27:50.66,0:27:55.50,Default,,0,0,0,,Өсетін саңырауқұлақтардың барлығы улы ма? Мен бұл балаға тиісе аламын ба? ➡
Dialogue: 0,0:27:55.50,0:27:57.57,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:27:57.57,0:27:59.57,Default,,0,0,0,,Ол ешқандай қосымша күш бола алмайды.
Dialogue: 0,0:27:59.57,0:28:01.54,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:28:03.51,0:28:05.68,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:28:05.68,0:28:07.95,Default,,0,0,0,,Кешірім сұрама➡
Dialogue: 0,0:28:07.95,0:28:13.62,Default,,0,0,0,,Лунаның ерекше мінезі бар, тіпті оның толқуы да.
Dialogue: 0,0:28:13.62,0:28:16.29,Default,,0,0,0,,Мен оны көруден жалықпаймын
Dialogue: 0,0:28:16.29,0:28:19.63,Default,,0,0,0,,Анри, сен де.
Dialogue: 0,0:28:19.63,0:28:24.30,Default,,0,0,0,,⚟Сұлу жігіт болғанымен, оның әйелдерге деген талғамы өте көңілсіз.
Dialogue: 0,0:28:24.30,0:28:27.77,Default,,0,0,0,,⚟Сол Амур конституциясы сені құртады.
Dialogue: 0,0:28:29.64,0:28:33.97,Default,,0,0,0,,⚟Бірақ оның достығы оның сүйкімділігі.
Dialogue: 0,0:28:33.97,0:28:37.98,Default,,0,0,0,,⚟Бірақ жақсы ма? Оның отбасы екеніне сенімдімін...➡
Dialogue: 0,0:28:37.98,0:28:41.95,Default,,0,0,0,,Қатаң ақ ведьм фракциясы, корольдік отбасының адал адамы.
Dialogue: 0,0:28:42.98,0:28:47.32,Default,,0,0,0,,⚟Ах, бірақ Анридің өзі...
Dialogue: 0,0:28:47.32,0:28:51.16,Default,,0,0,0,,⚟Жоқ, бұл жағдайды менің отбасым көрсе➡
Dialogue: 0,0:28:51.16,0:28:53.66,Default,,0,0,0,,Өте нашар, солай емес пе?
Dialogue: 0,0:28:53.66,0:28:56.73,Default,,0,0,0,,⚟Жарайды, ұрысып қалатын шығарсың...
Dialogue: 0,0:28:59.67,0:29:01.67,Default,,0,0,0,,(Қарға қарғалар)
Dialogue: 0,0:29:01.67,0:29:04.74,Default,,0,0,0,,⚟Анри да, бірақ анау қара бақсы➡
Dialogue: 0,0:29:04.74,0:29:07.61,Default,,0,0,0,,Егер сіз жақсы болмасаңыз, сіз бақсышылардың тізіміне түсесіз, солай ма?
Dialogue: 0,0:29:07.61,0:29:10.68,Default,,0,0,0,,⚟Аа... Мен ондай нәрсеге шебер емеспін.
Dialogue: 0,0:29:10.68,0:29:12.65,Default,,0,0,0,,(Қарға қарғалар)
Dialogue: 0,0:29:15.12,0:29:18.45,Default,,0,0,0,,Бұл ақымақ...
Dialogue: 0,0:29:18.45,0:29:21.12,Default,,0,0,0,,У… Хмм? Хмм?
Dialogue: 0,0:29:23.29,0:29:25.96,Default,,0,0,0,,Сурет үшін енді кешірім сұрамаңыз.
Dialogue: 0,0:29:25.96,0:29:29.30,Default,,0,0,0,,Менің жүзімді осылай ұнатқаныңа сене алар емеспін.
Dialogue: 0,0:29:29.30,0:29:31.97,Default,,0,0,0,,Мен өте қуаныштымын
Dialogue: 0,0:29:31.97,0:29:37.04,Default,,0,0,0,,Мүмкін менің жаным суреттер арқылы ойнауға кеткен шығар➡
Dialogue: 0,0:29:37.04,0:29:39.81,Default,,0,0,0,,Бұл тек Лунаның кінәсі деп ойламаймын.
Dialogue: 0,0:29:39.81,0:29:41.81,Default,,0,0,0,,А...
Dialogue: 0,0:29:41.81,0:29:44.65,Default,,0,0,0,,Бақсы немесе сиқыршы деңгейінде болмаса да ➡
Dialogue: 0,0:29:44.65,0:29:50.12,Default,,0,0,0,,Мүмкін, бұл менің отбасымнан шығар, бірақ менде де осындай нәрсеге себеп болатын үрдіс бар сияқты.
Dialogue: 0,0:29:52.99,0:29:55.49,Default,,0,0,0,,Менің отбасымның ақ бақсысы
Dialogue: 0,0:29:55.49,0:29:59.49,Default,,0,0,0,,Әркім не асыл, не арам.
Dialogue: 0,0:29:59.49,0:30:04.77,Default,,0,0,0,,Мен сенің бізге төмен қарайтыныңды түсіндім, бірақ сен туралы жақсы әсер қалдырмадым...
Dialogue: 0,0:30:06.27,0:30:10.60,Default,,0,0,0,,Луна мүлдем басқа, біртүрлі~
Dialogue: 0,0:30:10.60,0:30:15.61,Default,,0,0,0,,Улы дейтін Лунамен бірге болған жақсы➡
Dialogue: 0,0:30:15.61,0:30:20.88,Default,,0,0,0,,Айналадағы ауа мен жүрегім әдеттегіден де тазарақ сезіледі.
Dialogue: 0,0:30:21.95,0:30:25.29,Default,,0,0,0,,Луна мен саңырауқұлақтар менің айналамдағы тоқырауды тазартады
Dialogue: 0,0:30:25.29,0:30:28.36,Default,,0,0,0,,Таза ұстайды ма деп ойлаймын➡
Dialogue: 0,0:30:28.36,0:30:30.82,Default,,0,0,0,,Бұл да Лунаның сиқыры ма?
Dialogue: 0,0:30:37.30,0:30:39.80,Default,,0,0,0,,Мына жерде!
Dialogue: 0,0:30:39.80,0:30:41.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:30:46.31,0:30:48.64,Default,,0,0,0,,Луна?
Dialogue: 0,0:30:48.64,0:30:50.64,Default,,0,0,0,,Не болды? Лу…
Dialogue: 0,0:30:50.64,0:30:54.72,Default,,0,0,0,,Әй, бұрын болған қара бақсыға не болды?
Dialogue: 0,0:30:58.32,0:31:00.32,Default,,0,0,0,,Сіз қайдасыз?
Dialogue: 0,0:31:00.32,0:31:02.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:03.99,0:31:06.99,Default,,0,0,0,,Күте тұрыңыз! Қайта кездесе аламыз ба?
Dialogue: 0,0:31:06.99,0:31:11.43,Default,,0,0,0,,Мен сенімен танысқым келеді! Сіз де солай ойласаңыз➡
Dialogue: 0,0:31:11.43,0:31:13.93,Default,,0,0,0,,Мені тағы да сал! ➡
Dialogue: 0,0:31:13.93,0:31:16.27,Default,,0,0,0,,Ха... мен сені көруге барамын! ➡
Dialogue: 0,0:31:16.27,0:31:18.24,Default,,0,0,0,,Мен күтемін!
Dialogue: 0,0:31:19.34,0:31:22.34,Default,,0,0,0,,Хаха...
Dialogue: 0,0:31:22.34,0:31:25.81,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:31:30.35,0:31:32.95,Default,,0,0,0,,Сәлем! Тез оян
Dialogue: 0,0:31:32.95,0:31:35.02,Default,,0,0,0,,Клод…
Dialogue: 0,0:31:35.02,0:31:38.09,Default,,0,0,0,,Не, кенеттен не болды? Балалар сендер
Dialogue: 0,0:31:40.46,0:31:42.46,Default,,0,0,0,,(қарғалар)
Dialogue: 0,0:31:42.46,0:31:44.46,Default,,0,0,0,,Не? Бұрынғы
Dialogue: 0,0:31:44.46,0:31:48.30,Default,,0,0,0,,Ақ бақсы құзырындағы адамдармен ашық араласу.
Dialogue: 0,0:31:48.30,0:31:53.37,Default,,0,0,0,,Әскери полиция сізді осылай ұстаса, құтылмас едіңіз.
Dialogue: 0,0:31:53.37,0:31:57.38,Default,,0,0,0,,Сіз өз ұстанымыңызды түсінесіз бе? Пайдасыз сиқыршы!
Dialogue: 0,0:31:57.38,0:31:59.38,Default,,0,0,0,,Бір сәт…➡
Dialogue: 0,0:31:59.38,0:32:03.15,Default,,0,0,0,,Адамдар, өздерің келіп уағыз айтуды доғарыңдар➡
Dialogue: 0,0:32:03.15,0:32:05.72,Default,,0,0,0,,Тым болмаса мән-жайлар туралы сөйлесейік.
Dialogue: 0,0:32:06.92,0:32:10.92,Default,,0,0,0,,Басқаша айтқанда, бақсыға романтика келді ме?
Dialogue: 0,0:32:10.92,0:32:12.93,Default,,0,0,0,,Романтика дегеніміз не?
Dialogue: 0,0:32:12.93,0:32:14.93,Default,,0,0,0,,Ей, бұл жақсы, бақсы-сан.
Dialogue: 0,0:32:14.93,0:32:18.43,Default,,0,0,0,,Осы уақыт аралығындағы романтикалық романның нәтижесі? Мен жасаймын~
Dialogue: 0,0:32:18.43,0:32:20.93,Default,,0,0,0,,Хамф, бұл түкке тұрғысыз, оған тұрарлық емес.
Dialogue: 0,0:32:20.93,0:32:22.94,Default,,0,0,0,,Мұны жасама!
Dialogue: 0,0:32:22.94,0:32:25.27,Default,,0,0,0,,<Бұл қарға>
Dialogue: 0,0:32:25.27,0:32:31.78,Default,,0,0,0,,<Луна күнделікті қамқорлық жасайтын және ол құрметтейтін ұлы сиқыршының танысы>
Dialogue: 0,0:32:31.78,0:32:34.78,Default,,0,0,0,,<Бір себептермен Луна өзін қатты қорқытады>
Dialogue: 0,0:32:34.78,0:32:41.45,Default,,0,0,0,,＜Дегенмен, ол мен онша түсінбейтін қиын адам, маған осылай көмектескен.＞
Dialogue: 0,0:32:42.62,0:32:47.13,Default,,0,0,0,,Эй, оны кездестірме.
Dialogue: 0,0:32:47.13,0:32:50.20,Default,,0,0,0,,Мен білмеймін, сіз қандай қулық жасайсыз.
Dialogue: 0,0:32:50.20,0:32:53.13,Default,,0,0,0,,Мен онымен қайта араласқым келсе
Dialogue: 0,0:32:53.13,0:32:56.14,Default,,0,0,0,,Мен оны Мастерге хабарлаймын.
Dialogue: 0,0:32:56.14,0:32:58.14,Default,,0,0,0,,Бірдеңе болған кезде
Dialogue: 0,0:32:58.14,0:33:01.81,Default,,0,0,0,,Сіз жай ғана тазартылсаңыз, маңызды емес.
Dialogue: 0,0:33:01.81,0:33:06.58,Default,,0,0,0,,Бұл жалпы қара сиқыршылар мен қара сиқыршыларға қатысты мәселе.
Dialogue: 0,0:33:06.58,0:33:09.08,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:33:09.08,0:33:11.05,Default,,0,0,0,,Иә...
Dialogue: 0,0:33:21.09,0:33:25.43,Default,,0,0,0,,Луна, сен бүгін жақсы нәрсе көрдің бе? ➡
Dialogue: 0,0:33:25.43,0:33:30.40,Default,,0,0,0,,Бүгін қалада тапқан ең әдемі нәрсенің суретін сал.
Dialogue: 0,0:33:31.44,0:33:34.27,Default,,0,0,0,,Маған тамақ ұнайды➡
Dialogue: 0,0:33:34.27,0:33:37.14,Default,,0,0,0,,Ол қызыл және дәмді көрінеді.
Dialogue: 0,0:33:42.35,0:33:44.32,Default,,0,0,0,,《Мен сені қайтадан көргім келеді》
Dialogue: 0,0:33:52.13,0:33:55.90,Default,,0,0,0,,《Лунамен болғанда жүрегім тазарады》
Dialogue: 0,0:33:59.20,0:34:01.17,Default,,0,0,0,,《Күту》
Dialogue: 0,0:34:09.14,0:34:11.11,Default,,0,0,0,,Луна?
Dialogue: 0,0:34:15.48,0:34:22.16,Default,,0,0,0,,<Ойланбай тұрып, қолым өздігінен қозғалып кетті.>
Dialogue: 0,0:34:22.16,0:34:24.82,Default,,0,0,0,,Бұл кешегі бала~
Dialogue: 0,0:34:24.82,0:34:30.80,Default,,0,0,0,,<Мен оның сөздері мен фигурасын қадағалағым келді>
Dialogue: 0,0:34:56.76,0:34:58.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:58.76,0:35:01.03,Default,,0,0,0,,<Анри сөйлей алмайды сурет>
Dialogue: 0,0:35:10.70,0:35:14.21,Default,,0,0,0,,<Мені салғаныңызға рахмет>
Dialogue: 0,0:35:14.21,0:35:17.54,Default,,0,0,0,,<Мен сенімен танысқым келді, Луна>
Dialogue: 0,0:35:17.54,0:35:21.72,Default,,0,0,0,,<Бірақ менің сыртқы түрім бұрынғыдан да немқұрайлы емес пе? ＞
Dialogue: 0,0:35:24.38,0:35:27.45,Default,,0,0,0,,Мен сенімен қайта кездесуді жоспарлаған жоқпын...
Dialogue: 0,0:35:27.45,0:35:33.43,Default,,0,0,0,,Егер сіз оны суретке салсаңыз, ол сізге қиындық тудырады ...
Dialogue: 0,0:35:35.40,0:35:38.47,Default,,0,0,0,,Бірақ мен оны дұрыс салуым керек
Dialogue: 0,0:35:38.47,0:35:42.24,Default,,0,0,0,,Сіз шықпауыңыз мүмкін
Dialogue: 0,0:35:42.24,0:35:44.90,Default,,0,0,0,,Өзімді ақтап алдым
Dialogue: 0,0:35:44.90,0:35:50.24,Default,,0,0,0,,Қозғалмайтын сурет болса да, мен сенімен танысқым келеді.
Dialogue: 0,0:35:50.24,0:35:54.58,Default,,0,0,0,,Мен сені енді көрмеуім керек... Кешіріңіз.
Dialogue: 0,0:35:54.58,0:35:58.65,Default,,0,0,0,,Бірақ мен сені кездестіргеніме өте қуаныштымын.
Dialogue: 0,0:35:58.65,0:36:00.62,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,0:36:03.26,0:36:06.69,Default,,0,0,0,,<Луна жылама>
Dialogue: 0,0:36:06.69,0:36:09.70,Default,,0,0,0,,<Сенің көз жасың әдемі болса да>
Dialogue: 0,0:36:09.70,0:36:11.97,Default,,0,0,0,,<Мен сенің күлген жүзіңді көргім келеді>
Dialogue: 0,0:36:13.03,0:36:18.00,Default,,0,0,0,,<Мен тіпті сенің көз жасыңды да сүрте алмаймын>
Dialogue: 0,0:36:19.04,0:36:21.04,Default,,0,0,0,,<Бұл көңілсіз>
Dialogue: 0,0:36:21.04,0:36:24.04,Default,,0,0,0,,<Луна, тіпті сол кезде...>
Dialogue: 0,0:36:24.04,0:36:28.88,Default,,0,0,0,,<Айлы би кезінде де көзіңе жас келді>
Dialogue: 0,0:36:28.88,0:36:31.95,Default,,0,0,0,,<Көшеде сөйлескенде де>
Dialogue: 0,0:36:31.95,0:36:34.89,Default,,0,0,0,,<Мен бірдеңе істедім бе? ＞
Dialogue: 0,0:36:34.89,0:36:37.39,Default,,0,0,0,,<Мен сені мұңайттым ба? ＞
Dialogue: 0,0:36:37.39,0:36:39.39,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:36:39.39,0:36:41.90,Default,,0,0,0,,Қуаныштымын
Dialogue: 0,0:36:41.90,0:36:46.90,Default,,0,0,0,,Мен бірінші рет біреудің осылай жұмсақ қолын тигізуім еді.
Dialogue: 0,0:36:46.90,0:36:50.90,Default,,0,0,0,,Бұл мені бақытты әрі бақытты етеді...
Dialogue: 0,0:36:50.90,0:36:56.74,Default,,0,0,0,,Қуанғаным сонша, сонымен бірге бітті деп қынжыламын
Dialogue: 0,0:36:56.74,0:37:02.75,Default,,0,0,0,,Мен мұндай бақытты ешқашан білмедім.
Dialogue: 0,0:37:02.75,0:37:04.75,Default,,0,0,0,,Әлі де қорқамын
Dialogue: 0,0:37:04.75,0:37:09.52,Default,,0,0,0,,Мен бақытты бола алмадым, бірақ мен қатты қорқамын
Dialogue: 0,0:37:10.92,0:37:13.53,Default,,0,0,0,,Маған тағы не керек?
Dialogue: 0,0:37:13.53,0:37:20.00,Default,,0,0,0,,Біреудің... Мен сенің бақытыңды құртатын сияқтымын.
Dialogue: 0,0:37:22.20,0:37:24.87,Default,,0,0,0,,<Луна, бәрібір>
Dialogue: 0,0:37:24.87,0:37:28.37,Default,,0,0,0,,<Луна үшін бақытты уақыт жалғасады>
Dialogue: 0,0:37:28.37,0:37:30.38,Default,,0,0,0,,<Уәде>
Dialogue: 0,0:37:30.38,0:37:32.38,Default,,0,0,0,,<Менімен бірге барайық>
Dialogue: 0,0:37:32.38,0:37:35.15,Default,,0,0,0,,<Артық болмас бақыттан>
Dialogue: 0,0:37:36.38,0:37:40.22,Default,,0,0,0,,<Оңай жоғалмайтын бақыт табу>
Dialogue: 0,0:37:40.22,0:37:42.89,Default,,0,0,0,,<Осылай уақыт өткізуді жалғастырайық>
Dialogue: 0,0:37:44.06,0:37:47.73,Default,,0,0,0,,<Мен Луна үшін бәрін жасаймын>
Dialogue: 0,0:37:47.73,0:37:50.40,Default,,0,0,0,,<Мен сенімен мәңгі бірге болғым келеді>
Dialogue: 0,0:37:51.56,0:37:53.90,Default,,0,0,0,,<Мені сал, Луна>
Dialogue: 0,0:37:53.90,0:37:56.74,Default,,0,0,0,,<Мәңгілік және мәңгі>
Dialogue: 0,0:37:56.74,0:38:00.57,Default,,0,0,0,,<Жарайды, мен үшін уайымдама>
Dialogue: 0,0:38:00.57,0:38:02.58,Default,,0,0,0,,<Түсінікті Луна>
Dialogue: 0,0:38:02.58,0:38:07.75,Default,,0,0,0,,<Мен үшін қазірден бастап сізбен кездесе алмаудан артық бақыт жоқ.>
Dialogue: 0,0:39:16.02,0:39:18.85,Default,,0,0,0,,Сіз естідіңіз бе? Анри туралы
Dialogue: 0,0:39:18.85,0:39:21.86,Default,,0,0,0,,⚟Соңғы кездері төсек тартып жатырмын.
Dialogue: 0,0:39:21.86,0:39:27.86,Default,,0,0,0,,⚟Дәрігер маған ешнәрсе жоқ деді, бірақ себебі белгісіз, мен барған сайын арықтай бастадым.
Dialogue: 0,0:39:27.86,0:39:31.20,Default,,0,0,0,,Сен әлгі қара бақсымен кездескен күннен бері жынды болдың ғой, солай емес пе?
Dialogue: 0,0:39:31.20,0:39:35.37,Default,,0,0,0,,⚟Анридің отбасы Ақ сиқыршыға шағымданамыз дейді.
Dialogue: 0,0:39:37.04,0:39:39.01,Default,,0,0,0,,Цк
Dialogue: 0,0:39:43.54,0:39:45.88,Default,,0,0,0,,Луна
Dialogue: 0,0:39:45.88,0:39:48.55,Default,,0,0,0,,Бүгін Анридің суретін салмайсың ба?
Dialogue: 0,0:39:48.55,0:39:52.55,Default,,0,0,0,,Мен Анриге бұршақты өткізіп жібереміз деп уәде бердім.
Dialogue: 0,0:39:52.55,0:39:54.62,Default,,0,0,0,,Мен біраз уақытқа дейін сурет салмаймын.
Dialogue: 0,0:39:54.62,0:39:56.62,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:39:56.62,0:40:01.06,Default,,0,0,0,,Өткен күні мен шаршап бара жатқандай болдым.
Dialogue: 0,0:40:01.06,0:40:03.56,Default,,0,0,0,,Сызықтар да өте жұқа болды.
Dialogue: 0,0:40:03.56,0:40:05.73,Default,,0,0,0,,Луна да сенімен кездескісі келеді, солай ма?
Dialogue: 0,0:40:05.73,0:40:08.30,Default,,0,0,0,,Бірақ сызық жұқа болды...
Dialogue: 0,0:40:10.17,0:40:12.17,Default,,0,0,0,,(терезені ашу/жабу дыбысы)
Dialogue: 0,0:40:12.17,0:40:14.44,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:40:15.51,0:40:17.51,Default,,0,0,0,,Бұл…
Dialogue: 0,0:40:17.51,0:40:19.85,Default,,0,0,0,,Мен сені кездестірмейтін шығармын, ақымақ бақсы!
Dialogue: 0,0:40:19.85,0:40:22.32,Default,,0,0,0,,Қарға қорқынышты! Гах!
Dialogue: 0,0:40:24.18,0:40:26.69,Default,,0,0,0,,Мен үлкенмін!
Dialogue: 0,0:40:26.69,0:40:28.69,Default,,0,0,0,,Эй
Dialogue: 0,0:40:28.69,0:40:31.46,Default,,0,0,0,,Менің не істегенімді өзіңіз көріңіз.
Dialogue: 0,0:41:02.39,0:41:04.39,Default,,0,0,0,,Көресіңдер әлі
Dialogue: 0,0:41:04.39,0:41:07.83,Default,,0,0,0,,Сиқырлы күштер болса да, сіз жай ғана адамсыз.
Dialogue: 0,0:41:07.83,0:41:11.66,Default,,0,0,0,,Оған қаншалықты салмақ түсетінін білмеймін.
Dialogue: 0,0:41:11.66,0:41:13.67,Default,,0,0,0,,Анри…
Dialogue: 0,0:41:13.67,0:41:18.74,Default,,0,0,0,,Сендей күші бар бақсы мынандай әрекет жасаса...
Dialogue: 0,0:41:18.74,0:41:22.01,Default,,0,0,0,,Бұл адамдар мен Ақ бақсы айтқандай.
Dialogue: 0,0:41:22.01,0:41:25.18,Default,,0,0,0,,Қара бақсының алдауы да жетеді!
Dialogue: 0,0:41:26.51,0:41:28.51,Default,,0,0,0,,Анри…
Dialogue: 0,0:41:28.51,0:41:30.88,Default,,0,0,0,,Тамшылатқышты дұрыс кигеніңізге көз жеткізіңіз.
Dialogue: 0,0:41:42.60,0:41:46.37,Default,,0,0,0,,Бұл... Лунаның саңырауқұлақтары.
Dialogue: 0,0:41:47.53,0:41:50.60,Default,,0,0,0,,Сен мені көруге келдің бе? ➡
Dialogue: 0,0:41:50.60,0:41:52.57,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:42:29.24,0:42:33.75,Default,,0,0,0,,<Анридің жүрегінен уланумен бірге алынған>
Dialogue: 0,0:42:33.75,0:42:38.08,Default,,0,0,0,,<Лунаның сезімі мен естеліктерін бойына сіңірген саңырауқұлақ>
Dialogue: 0,0:42:38.08,0:42:41.42,Default,,0,0,0,,<Саңырауқұлақтар бұрын-соңды шығарған сиқыршылардан көп>
Dialogue: 0,0:42:41.42,0:42:46.43,Default,,0,0,0,,＜Әдемі және мәңгілік, гүл сияқты＞
Dialogue: 0,0:42:46.43,0:42:51.93,Default,,0,0,0,,<Осындай сұлу бақсыға деген сезімім жүрегімде гүлдеген сол нәрсе еді>
Dialogue: 0,0:42:51.93,0:42:54.70,Default,,0,0,0,,<Бақсылар бәрінен де бақытты>
Dialogue: 0,0:42:56.27,0:43:01.27,Default,,0,0,0,,《＜Луна бәрібір, менімен барайық＞》
Dialogue: 0,0:43:01.27,0:43:04.28,Default,,0,0,0,,《＜Үлкен болуы мүмкін бақыттан тыс＞》
Dialogue: 0,0:43:04.28,0:43:06.21,Default,,0,0,0,,<Анри маған берді>
Dialogue: 0,0:43:06.21,0:43:11.98,Default,,0,0,0,,<Бұдан былай не болса да, бұл ешқашан сөнбейтін бақыт ешқашан өшпейді...>
Dialogue: 0,0:43:14.89,0:43:20.39,Default,,0,0,0,,<Осы түнде бақсы жүрегімді өртеп жіберді>
Dialogue: 0,0:43:20.39,0:43:22.36,Default,,0,0,0,,<Анри…>
Dialogue: 0,0:43:26.90,0:43:28.87,Default,,0,0,0,,<Рахмет>
Dialogue: 0,0:43:35.58,0:43:38.74,Default,,0,0,0,,Сәлем! Анри!
Dialogue: 0,0:43:39.91,0:43:41.98,Default,,0,0,0,,Мен өзімді қазір әлдеқайда жақсы сезінемін.
Dialogue: 0,0:43:41.98,0:43:44.98,Default,,0,0,0,,Не істеп жатырсың, мені алаңдатып тұрсың ба?
Dialogue: 0,0:43:44.98,0:43:47.25,Default,,0,0,0,,Ахаха... кешіріңіз
Dialogue: 0,0:43:47.25,0:43:50.59,Default,,0,0,0,,⚟Себебі белгісіз қандай ауру болды?➡
Dialogue: 0,0:43:50.59,0:43:54.76,Default,,0,0,0,,Қара бақсының қарғысы туралы қауесет тарады, бірақ ол рас па?
Dialogue: 0,0:43:55.66,0:43:59.60,Default,,0,0,0,,Қара сиқыршы? Не айтқың келеді? ол
Dialogue: 0,0:43:59.60,0:44:03.27,Default,,0,0,0,,⚟Ой...жаман адам болып кет
Dialogue: 0,0:44:03.27,0:44:06.94,Default,,0,0,0,,Ахаха... Не дегеніңіз?
Dialogue: 0,0:44:14.71,0:44:16.68,Default,,0,0,0,,Жарайды
Dialogue: 0,0:44:22.05,0:44:25.02,Default,,0,0,0,,<Ал уақыт өтеді...>
Dialogue: 0,0:44:27.89,0:44:31.73,Default,,0,0,0,,<Қара бақсы тазартудың ізі бірте-бірте күшейе түседі>
Dialogue: 0,0:44:31.73,0:44:35.70,Default,,0,0,0,,<Бақсының аяғы қаладан бұрынғысынан да алыста...>
Dialogue: 0,0:44:38.57,0:44:40.64,Default,,0,0,0,,Қара, қара, Мелино
Dialogue: 0,0:44:40.64,0:44:44.24,Default,,0,0,0,,Лунаның аяғындағы суда саңырауқұлақтар өсіп тұр.
Dialogue: 0,0:44:44.24,0:44:46.71,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:44:52.59,0:44:54.55,Default,,0,0,0,,<Осындай уақытта...>
Dialogue: 0,0:45:02.09,0:45:04.46,Default,,0,0,0,,Луна қара!
Dialogue: 0,0:45:05.70,0:45:07.67,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:45:11.54,0:45:16.01,Default,,0,0,0,,<Мен және бақсы Луна осылай кездесті>
Dialogue: 0,0:45:17.54,0:45:30.02,Default,,0,0,0,,♬～
Dialogue: 0,0:45:31.52,0:45:37.52,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory