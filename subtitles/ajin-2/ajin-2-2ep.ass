Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.67,0:00:05.00,Default,,0,0,0,,Оқиға орнында шиеленіс болды.
Dialogue: 0,0:00:05.07,0:00:06.17,Default,,0,0,0,,Көлік қуу
Dialogue: 0,0:00:06.23,0:00:07.30,Default,,0,0,0,,Әлгі бейбақ...!
Dialogue: 0,0:00:07.50,0:00:09.40,Default,,0,0,0,,Нагай! Мұны істеудің қажеті жоқ!
Dialogue: 0,0:00:09.47,0:00:10.71,Default,,0,0,0,,Маған кедергі жасама, Накано!
Dialogue: 0,0:00:11.17,0:00:12.14,Default,,0,0,0,,Сіздің жұмысыңыз қандай?
Dialogue: 0,0:00:12.24,0:00:13.31,Default,,0,0,0,,Сізді қорғау үшін
Dialogue: 0,0:00:13.48,0:00:16.28,Default,,0,0,0,,Мен сенің жүзіңді енді көргім келмеді.
Dialogue: 0,0:00:16.44,0:00:17.18,Default,,0,0,0,,Өлтір!
Dialogue: 0,0:00:17.75,0:00:19.01,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:00:20.48,0:00:22.25,Default,,0,0,0,,Мен мұнда келісім жасау үшін келдім.
Dialogue: 0,0:00:22.35,0:00:23.75,Default,,0,0,0,,Сіз деми адамдарға сене аласыз ба?
Dialogue: 0,0:00:24.15,0:00:26.52,Default,,0,0,0,,Біз Сатоны қандай жағдайда да жеңуге ниеттіміз!
Dialogue: 0,0:00:26.59,0:00:27.59,Default,,0,0,0,,Сол себепті!
Dialogue: 0,0:00:28.06,0:00:29.62,Default,,0,0,0,,Мен сенің пешкаң боламын!
Dialogue: 0,0:00:30.03,0:00:31.63,Default,,0,0,0,,Өлмейтін сарбаз ретінде
Dialogue: 0,0:00:33.29,0:00:34.60,Default,,0,0,0,,Күдікті ұсталды
Dialogue: 0,0:00:35.10,0:00:36.33,Default,,0,0,0,,Бұл Кей Нагай болды ма?
Dialogue: 0,0:00:36.60,0:00:40.50,Default,,0,0,0,,Жоқ, олар басқа адамдар. Олар жай ғана ұқсайды.
Dialogue: 0,0:00:45.61,0:00:49.68,Default,,0,0,0,,Эй, мен сені тағы көрдім, бұл Сато.
Dialogue: 0,0:00:51.45,0:00:53.15,Default,,0,0,0,,Менің білуімше...
Dialogue: 0,0:00:53.25,0:00:56.55,Default,,0,0,0,,Біздің өтінішімізге үкіметтен жауап жоқ
Dialogue: 0,0:00:57.55,0:01:00.06,Default,,0,0,0,,Сондықтан мен бастауды шештім
Dialogue: 0,0:01:04.19,0:01:07.80,Default,,0,0,0,,Дұрыс айтасыз, Вакай мырза, ең жоғарғы қамыр.
Dialogue: 0,0:01:08.16,0:01:12.53,Default,,0,0,0,,(Вакайдың ыңырсыуы)
Dialogue: 0,0:01:12.63,0:01:14.70,Default,,0,0,0,,Ал бұл...
Dialogue: 0,0:01:15.10,0:01:17.37,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:01:17.64,0:01:18.37,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:01:18.64,0:01:19.41,Default,,0,0,0,,(үстелді түрту дыбысы)
Dialogue: 0,0:01:19.77,0:01:22.34,Default,,0,0,0,,Бұл кері санақты бастау сигналы.
Dialogue: 0,0:01:23.21,0:01:25.28,Default,,0,0,0,,Осы екінші толқынның аяқталуымен...
Dialogue: 0,0:01:25.35,0:01:28.28,Default,,0,0,0,,Біз келесі толқынға өтеміз
Dialogue: 0,0:01:28.75,0:01:32.72,Default,,0,0,0,,3 Бұл соңғы толқын
Dialogue: 0,0:01:35.66,0:01:38.26,Default,,0,0,0,,Мен бұл елді басқарамын
Dialogue: 0,0:01:40.53,0:01:41.80,Default,,0,0,0,,Шамамен 10 минут бұрын-
Dialogue: 0,0:01:42.43,0:01:45.13,Default,,0,0,0,,Ол «AJIN.net» сайтына жүктелді
Dialogue: 0,0:01:49.60,0:01:50.77,Default,,0,0,0,,Дауыл келе жатыр
Dialogue: 0,0:02:01.18,0:02:03.38,Default,,0,0,0,,...
Dialogue: 0,0:02:03.65,0:02:08.42,Default,,0,0,0,,♪Сен менің алдымда кім тұрсың? ♪
Dialogue: 0,0:02:15.20,0:02:17.67,Default,,0,0,0,,♪Қашуды жалғастыру мәңгілік емес♪
Dialogue: 0,0:02:18.17,0:02:20.74,Default,,0,0,0,,♪Нағыз нәрсені шайнап, жұту♪
Dialogue: 0,0:02:20.80,0:02:25.61,Default,,0,0,0,,♪Айқайлап, түсініксіздікті кесіп таста♪
Dialogue: 0,0:02:26.14,0:02:28.58,Default,,0,0,0,,♪Көлеңкенің қауіптілігін білу♪
Dialogue: 0,0:02:28.68,0:02:31.41,Default,,0,0,0,,♪Тым сабырлы жүйе♪
Dialogue: 0,0:02:31.51,0:02:34.62,Default,,0,0,0,,♪ҚОСУ немесе ӨШІРУ Қазір қайсысын таңдар едіңіз? ♪
Dialogue: 0,0:02:35.85,0:02:39.32,Default,,0,0,0,,♪Нәтиже Мен өз эмоцияларымды қанша рет өлтіремін♪
Dialogue: 0,0:02:39.45,0:02:41.86,Default,,0,0,0,,♪Жоқ, ол бірінші орында өтіп кетті♪
Dialogue: 0,0:02:41.92,0:02:45.26,Default,,0,0,0,,♪Ол жай ғана жойылды♪
Dialogue: 0,0:02:46.29,0:02:48.73,Default,,0,0,0,,♪Мені жайыма қалдыршы Craze♪
Dialogue: 0,0:02:48.80,0:02:52.43,Default,,0,0,0,,♪Мен менмін және мен шарасызмын♪
Dialogue: 0,0:02:52.70,0:02:53.87,Default,,0,0,0,,♪иә иә♪
Dialogue: 0,0:02:54.17,0:02:56.67,Default,,0,0,0,,♪Басынан тек тәуекелмен бастаңыз♪
Dialogue: 0,0:02:56.77,0:02:59.34,Default,,0,0,0,,♪Жынды болыңыз♪
Dialogue: 0,0:02:59.41,0:03:01.58,Default,,0,0,0,,♪Инстинктіңізді, шынайы болмысыңызды ашыңыз♪
Dialogue: 0,0:03:01.64,0:03:05.18,Default,,0,0,0,,♪Қарсы шабуыл иә♪
Dialogue: 0,0:03:05.55,0:03:09.58,Default,,0,0,0,,♪Мені жарып жіберген сен кімсің? ♪
Dialogue: 0,0:03:36.91,0:03:39.51,Default,,0,0,0,,Бөлу Қате жасамаңыз
Dialogue: 0,0:03:39.75,0:03:41.42,Default,,0,0,0,,«Зардап шегушілер ашу-ыза білдіреді»
Dialogue: 0,0:03:42.25,0:03:44.65,Default,,0,0,0,,Сіз Окуямаға ұқсай бастадыңыз.
Dialogue: 0,0:03:45.52,0:03:48.66,Default,,0,0,0,,Егер сіз сәтсіздікке ұшырасаңыз да, бәрі жақсы, өйткені сіз өлесіз.
Dialogue: 0,0:03:51.99,0:03:53.80,Default,,0,0,0,,(Такахаши мен Геннің күлкісі)
Dialogue: 0,0:03:53.86,0:03:54.86,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл ұқсас болды ма?
Dialogue: 0,0:03:54.93,0:03:56.63,Default,,0,0,0,,Ұнату
Dialogue: 0,0:04:05.77,0:04:08.01,Default,,0,0,0,,Иә Аяқталды
Dialogue: 0,0:04:10.31,0:04:12.78,Default,,0,0,0,,Уау, бұл таңқаларлық.
Dialogue: 0,0:04:13.28,0:04:16.28,Default,,0,0,0,,Оскарға үміткер болу жеткілікті жақсы.
Dialogue: 0,0:04:23.02,0:04:24.43,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:04:24.73,0:04:26.56,Default,,0,0,0,,Сато мырзаға беріңіз.
Dialogue: 0,0:04:26.93,0:04:29.03,Default,,0,0,0,,Екі орын алдың ба?
Dialogue: 0,0:04:29.36,0:04:29.83,Default,,0,0,0,,Иә
Dialogue: 0,0:04:30.33,0:04:32.57,Default,,0,0,0,,Сіз аяғыңызда тұра алмайтыныңызға сенімдісіз бе?
Dialogue: 0,0:04:33.00,0:04:33.67,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:04:34.64,0:04:37.44,Default,,0,0,0,,Атқанда да абай болсак...
Dialogue: 0,0:04:37.51,0:04:38.54,Default,,0,0,0,,Жақсырақ болғанымен
Dialogue: 0,0:04:38.64,0:04:39.71,Default,,0,0,0,,Шулы
Dialogue: 0,0:04:40.51,0:04:43.68,Default,,0,0,0,,Төлем басқа біреудің атына карта арқылы жасалды, сондықтан жақсы.
Dialogue: 0,0:04:44.58,0:04:46.81,Default,,0,0,0,,Орыс сайтында сатып алынған карта туралы ақпарат
Dialogue: 0,0:04:46.88,0:04:48.38,Default,,0,0,0,,Мен тергенім осы.
Dialogue: 0,0:04:48.85,0:04:50.95,Default,,0,0,0,,Жапон атаулары бар сандар да біршама азайып келеді.
Dialogue: 0,0:04:51.02,0:04:52.59,Default,,0,0,0,,Иә
Dialogue: 0,0:04:52.85,0:04:55.42,Default,,0,0,0,,Сондай-ақ, біз транзакциялар үшін виртуалды валютаны пайдаланамыз.
Dialogue: 0,0:04:55.49,0:04:57.06,Default,,0,0,0,,Ешқашан аяғыңызды ұстамаңыз
Dialogue: 0,0:04:57.39,0:04:58.59,Default,,0,0,0,,Енді сен агент емессің.
Dialogue: 0,0:04:58.83,0:05:00.30,Default,,0,0,0,,Мен біраз уақыт кеткенімде...
Dialogue: 0,0:05:00.36,0:05:02.73,Default,,0,0,0,,Бұл шектен шыққан, дүниенің бір бөлігіне айналған.
Dialogue: 0,0:05:02.96,0:05:05.73,Default,,0,0,0,,Тіпті егер қаласа, кіші мектеп оқушылары да жасай алады.
Dialogue: 0,0:05:07.57,0:05:08.90,Default,,0,0,0,,Танака мырза
Dialogue: 0,0:05:10.47,0:05:11.01,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:05:11.61,0:05:14.98,Default,,0,0,0,,Бұл үлкен мәселе. Бұл мен.
Dialogue: 0,0:05:15.54,0:05:15.98,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:05:17.75,0:05:20.01,Default,,0,0,0,,Сато мырза...?
Dialogue: 0,0:05:22.05,0:05:24.02,Default,,0,0,0,,Жақсы жұмыс, солай ма?
Dialogue: 0,0:05:31.76,0:05:34.50,Default,,0,0,0,,Окуямада бәрі жақсы екеніне сенімдісіз бе?
Dialogue: 0,0:05:35.03,0:05:36.66,Default,,0,0,0,,Бұл жігіт шынымен жаман екен.
Dialogue: 0,0:05:36.76,0:05:39.43,Default,,0,0,0,,Бастапқыда сіз дұрыс адам болдыңыз, бірақ-
Dialogue: 0,0:05:39.70,0:05:41.57,Default,,0,0,0,,Өйткені сіздің бетіңіз тым бөлінген.
Dialogue: 0,0:05:42.00,0:05:43.94,Default,,0,0,0,,Әйтеуір жақсы болады.
Dialogue: 0,0:05:45.11,0:05:50.48,Default,,0,0,0,,（♪）
Dialogue: 0,0:05:51.35,0:05:56.08,Default,,0,0,0,,Ух... уф...
Dialogue: 0,0:05:57.69,0:06:01.79,Default,,0,0,0,,Неліктен мен... осындай әрекет жасадым...
Dialogue: 0,0:06:04.09,0:06:04.79,Default,,0,0,0,,А...
Dialogue: 0,0:06:05.69,0:06:06.76,Default,,0,0,0,,Бұл енді мүмкін емес
Dialogue: 0,0:06:08.03,0:06:09.83,Default,,0,0,0,,Мен мұны әлі 20 рет жасаған жоқпын.
Dialogue: 0,0:06:11.63,0:06:13.63,Default,,0,0,0,,Мен ақ халаттымын
Dialogue: 0,0:06:14.07,0:06:16.07,Default,,0,0,0,,Қажетті адамды дұрыс жерде бекіту
Dialogue: 0,0:06:17.07,0:06:20.88,Default,,0,0,0,,Бірақ бұл 40 күн бұрынғы деректерден 4 кг артық.
Dialogue: 0,0:06:20.98,0:06:22.41,Default,,0,0,0,,Оны тастаңыз
Dialogue: 0,0:06:23.81,0:06:25.98,Default,,0,0,0,,Қара компаниялар осылай көрінеді ме?
Dialogue: 0,0:06:26.51,0:06:27.58,Default,,0,0,0,,Кей Нагай!
Dialogue: 0,0:06:30.95,0:06:32.89,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз және ерінбеңіз!
Dialogue: 0,0:06:33.55,0:06:36.96,Default,,0,0,0,,Ааа! Мен оны өлтіруім керек еді!
Dialogue: 0,0:06:37.46,0:06:38.96,Default,,0,0,0,,Мен оны формалинге маламын!
Dialogue: 0,0:06:39.43,0:06:41.50,Default,,0,0,0,,Tsk, бұл қорқынышты.
Dialogue: 0,0:06:46.70,0:06:47.67,Default,,0,0,0,,Тодороки, сен не айтып тұрсың өзің?
Dialogue: 0,0:06:48.07,0:06:49.97,Default,,0,0,0,,Сіз тағы 3 жиын жасайсыз ба?
Dialogue: 0,0:06:50.40,0:06:52.44,Default,,0,0,0,,Бұл Нагайдан екі есе көп!
Dialogue: 0,0:06:52.57,0:06:54.11,Default,,0,0,0,,Дұрыс адам дұрыс жерде
Dialogue: 0,0:06:54.58,0:06:56.98,Default,,0,0,0,,Сіз бұлшықеттерге жауаптысыз.
Dialogue: 0,0:06:57.11,0:06:59.68,Default,,0,0,0,,Иә? Сіз ақымақ сияқтысыз.
Dialogue: 0,0:06:59.85,0:07:01.62,Default,,0,0,0,,Жарайды, олай шағымданба.
Dialogue: 0,0:07:01.82,0:07:04.85,Default,,0,0,0,,Мен сізге жоғарыда айтқан транквилизаторды қалай қолдану керектігін үйретемін.
Dialogue: 0,0:07:05.42,0:07:07.86,Default,,0,0,0,,Бұл рас! ? Уәдеңде тұр!
Dialogue: 0,0:07:11.46,0:07:11.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:19.13,0:07:20.03,Default,,0,0,0,,Тозаки мырза
Dialogue: 0,0:07:21.20,0:07:23.44,Default,,0,0,0,,Согабе мырза маған хабарласты.
Dialogue: 0,0:07:23.54,0:07:26.54,Default,,0,0,0,,Сакурай мырза өз жоспарларын ақыры өзгертпейтін сияқты.
Dialogue: 0,0:07:26.77,0:07:27.74,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:07:28.44,0:07:31.48,Default,,0,0,0,,Осындай уақытта іссапарда жүргеніме сене алар емеспін.
Dialogue: 0,0:07:31.61,0:07:32.78,Default,,0,0,0,,Алаңсыз
Dialogue: 0,0:07:33.48,0:07:34.98,Default,,0,0,0,,Күзетшілерді де көбейттік.
Dialogue: 0,0:07:35.08,0:07:38.55,Default,,0,0,0,,Біз жеткен соң қауіпсіз болатынын айтты.
Dialogue: 0,0:07:39.65,0:07:40.15,Default,,0,0,0,,Сонымен
Dialogue: 0,0:07:40.99,0:07:41.99,Default,,0,0,0,,Шимомура мырза
Dialogue: 0,0:07:42.82,0:07:45.66,Default,,0,0,0,,Тұрғылықты жеріңізді мүмкіндігінше тезірек көшіріңіз.
Dialogue: 0,0:07:46.13,0:07:47.53,Default,,0,0,0,,Бұдан былай біз назар аударамыз
Dialogue: 0,0:07:47.63,0:07:50.90,Default,,0,0,0,,Біз Сатоны ұстаудың стратегиясын ойластыруымыз керек.
Dialogue: 0,0:07:51.13,0:07:52.07,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:52.67,0:07:53.77,Default,,0,0,0,,Шұғыл хабар, шұғыл хабар!
Dialogue: 0,0:07:53.90,0:07:57.84,Default,,0,0,0,,Бізде Сатода жоқ нәрсені нақтылау керек.
Dialogue: 0,0:07:59.51,0:08:01.04,Default,,0,0,0,,Бұл застава.
Dialogue: 0,0:08:03.51,0:08:04.21,Default,,0,0,0,,А...
Dialogue: 0,0:08:10.99,0:08:12.75,Default,,0,0,0,,Бухаафуфу
Dialogue: 0,0:08:13.25,0:08:15.22,Default,,0,0,0,,Осыншама көп ішсең, арықтамайсың.
Dialogue: 0,0:08:16.66,0:08:19.19,Default,,0,0,0,,Қант шаршаудан жазылу үшін қажет.
Dialogue: 0,0:08:19.79,0:08:21.66,Default,,0,0,0,,Сіз жай ғана бұлшықет жаттығуларын жасамадыңыз ба?
Dialogue: 0,0:08:21.90,0:08:23.50,Default,,0,0,0,,Нагай мырза, Накано мырза
Dialogue: 0,0:08:23.60,0:08:24.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:24.67,0:08:26.60,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:08:28.94,0:08:29.94,Default,,0,0,0,,Не?
Dialogue: 0,0:08:30.04,0:08:32.74,Default,,0,0,0,,Кездескіңіз келетін адам бар ма? Менімен жүр.
Dialogue: 0,0:08:33.51,0:08:33.98,Default,,0,0,0,,Иә
Dialogue: 0,0:08:36.91,0:08:37.61,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:39.21,0:08:41.08,Default,,0,0,0,,Не? Не болды, Накано?
Dialogue: 0,0:08:42.22,0:08:43.68,Default,,0,0,0,,Шимомура мырза-
Dialogue: 0,0:08:45.09,0:08:46.75,Default,,0,0,0,,Уау, әдемі екен.
Dialogue: 0,0:08:48.56,0:08:50.56,Default,,0,0,0,,Қызық, Тозаки-сан екеуің жақсы доссыңдар ма?
Dialogue: 0,0:08:50.63,0:08:51.69,Default,,0,0,0,,Біз әрқашан біргеміз
Dialogue: 0,0:08:51.79,0:08:53.19,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:08:53.69,0:08:54.90,Default,,0,0,0,,Өйткені ол адам жарты адам.
Dialogue: 0,0:08:54.96,0:08:55.56,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:08:55.63,0:08:57.23,Default,,0,0,0,,Сіз байқамадыңыз ба...
Dialogue: 0,0:08:58.70,0:09:00.77,Default,,0,0,0,,Ауруханада елес болды, солай ма?
Dialogue: 0,0:09:01.30,0:09:03.00,Default,,0,0,0,,Ауылдан қашқанда да қолданылған.
Dialogue: 0,0:09:03.17,0:09:04.94,Default,,0,0,0,,Қызық, сенің жігітің бар ма?
Dialogue: 0,0:09:05.04,0:09:05.84,Default,,0,0,0,,А...
Dialogue: 0,0:09:05.94,0:09:06.97,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:09:08.64,0:09:09.64,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:09:09.91,0:09:12.21,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:15.98,0:09:16.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:17.02,0:09:17.69,Default,,0,0,0,,Кім?
Dialogue: 0,0:09:18.12,0:09:20.12,Default,,0,0,0,,Огура Икуя
Dialogue: 0,0:09:21.12,0:09:22.86,Default,,0,0,0,,Американдық демиадам зерттеушісі.
Dialogue: 0,0:09:23.02,0:09:24.59,Default,,0,0,0,,Ол данышпан.
Dialogue: 0,0:09:27.63,0:09:29.83,Default,,0,0,0,,Сіз Кей Нагайсыз.
Dialogue: 0,0:09:30.23,0:09:32.20,Default,,0,0,0,,Жапониядағы деми-адамның үшінші жағдайы
Dialogue: 0,0:09:32.70,0:09:33.77,Default,,0,0,0,,Мен Наканомын
Dialogue: 0,0:09:33.87,0:09:35.64,Default,,0,0,0,,Деми-адамдар қызықты
Dialogue: 0,0:09:35.97,0:09:37.91,Default,,0,0,0,,Адамның мәнсіз өмірінде де...
Dialogue: 0,0:09:38.17,0:09:41.04,Default,,0,0,0,,Оның құнды екенін меңзейді.
Dialogue: 0,0:09:41.71,0:09:42.34,Default,,0,0,0,,Сол Накано...
Dialogue: 0,0:09:42.64,0:09:44.01,Default,,0,0,0,,Мен темекі шегуге бола ма?
Dialogue: 0,0:09:44.15,0:09:46.85,Default,,0,0,0,,Кешіріңіз, мен темекі шегуді ұнатпаймын.
Dialogue: 0,0:09:49.08,0:09:50.92,Default,,0,0,0,,(түтін шығарған Огураның дыбысы)
Dialogue: 0,0:09:53.02,0:09:54.02,Default,,0,0,0,,Нагай мырза
Dialogue: 0,0:09:54.89,0:09:57.99,Default,,0,0,0,,Адамдар неліктен өлу керек деп ойлайсыңдар?
Dialogue: 0,0:09:58.23,0:10:00.29,Default,,0,0,0,,Сенің жүрегің тоқтағандықтан ба?
Dialogue: 0,0:10:02.23,0:10:05.03,Default,,0,0,0,,Өйткені жасушалардың көбеюінің шегі бар.
Dialogue: 0,0:10:05.33,0:10:08.04,Default,,0,0,0,,Бұдан басқа регенерация болмайды.
Dialogue: 0,0:10:08.17,0:10:09.67,Default,,0,0,0,,Тіршілік функциялары тоқтайды.
Dialogue: 0,0:10:09.74,0:10:10.71,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:11.17,0:10:13.27,Default,,0,0,0,,Өйткені ғалам осылай шешті.
Dialogue: 0,0:10:13.74,0:10:14.74,Default,,0,0,0,,Иә? (Шабуыл) А?
Dialogue: 0,0:10:14.88,0:10:17.88,Default,,0,0,0,,Огура мырза, шегініс жасаңыз. Жалғастырыңыз.
Dialogue: 0,0:10:18.88,0:10:21.65,Default,,0,0,0,,Камераның ар жағындағы Тазаки-кун былай дейді...
Dialogue: 0,0:10:21.72,0:10:22.08,Default,,0,0,0,,Тоза…
Dialogue: 0,0:10:22.15,0:10:25.22,Default,,0,0,0,,Сіздің IBM өте біртүрлі болып көрінеді.
Dialogue: 0,0:10:25.65,0:10:26.39,Default,,0,0,0,,Бұл Тосаки.
Dialogue: 0,0:10:27.66,0:10:28.29,Default,,0,0,0,,Оны алыңыз.
Dialogue: 0,0:10:28.39,0:10:29.66,Default,,0,0,0,,Не? (Шабуыл) Е! ?
Dialogue: 0,0:10:30.69,0:10:32.06,Default,,0,0,0,,Өлуіңіз мүмкін.
Dialogue: 0,0:10:32.23,0:10:34.40,Default,,0,0,0,,Сіз темекі қорабысыз ба?
Dialogue: 0,0:10:35.06,0:10:36.33,Default,,0,0,0,,Амансың ба? Огура мырза
Dialogue: 0,0:10:36.63,0:10:37.20,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:37.33,0:10:38.20,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:10:38.67,0:10:40.74,Default,,0,0,0,,Науқасты қарамай-ақ медициналық кітапша жаза аласыз ба?
Dialogue: 0,0:10:42.64,0:10:44.21,Default,,0,0,0,,Бірақ бәрібір сіз оны көре алмайсыз, солай ма?
Dialogue: 0,0:10:44.34,0:10:45.74,Default,,0,0,0,,Өлтіру ниетімен келіңіз
Dialogue: 0,0:10:46.34,0:10:47.88,Default,,0,0,0,,Сонда сіз оны көре аласыз
Dialogue: 0,0:11:00.12,0:11:00.99,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:02.09,0:11:05.76,Default,,0,0,0,,Пішіні тегіс, бірақ концентрациясы жоғары.
Dialogue: 0,0:11:06.36,0:11:08.93,Default,,0,0,0,,Бұндай нәрселерді анық көру сирек.
Dialogue: 0,0:11:09.03,0:11:11.80,Default,,0,0,0,,Қара компаниялар осылай көрінеді ме?
Dialogue: 0,0:11:12.27,0:11:14.07,Default,,0,0,0,,Ішім келеді... (Кей) Сөйле.
Dialogue: 0,0:11:15.67,0:11:17.20,Default,,0,0,0,,Хабарланғандай.
Dialogue: 0,0:11:17.84,0:11:20.67,Default,,0,0,0,,Бұйрықтарға қайшы әрекет жасау...?
Dialogue: 0,0:11:21.14,0:11:23.34,Default,,0,0,0,,Ішің әбден бұралып қалған сияқты.
Dialogue: 0,0:11:23.44,0:11:24.31,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:11:24.38,0:11:25.31,Default,,0,0,0,,Ал ең бастысы, Иносукэ, өзің қалайсың?
Dialogue: 0,0:11:27.08,0:11:28.38,Default,,0,0,0,,Хмм... неге мен...
Dialogue: 0,0:11:29.25,0:11:32.42,Default,,0,0,0,,Не керек, егер нұсқаулар болмаса, бұл автоматты түрде іске қосу.
Dialogue: 0,0:11:32.99,0:11:34.76,Default,,0,0,0,,Мына жігіт қызық екен
Dialogue: 0,0:11:35.29,0:11:36.72,Default,,0,0,0,,Ах ха...
Dialogue: 0,0:11:37.83,0:11:42.86,Default,,0,0,0,,Айова штатындағы фермадағы деми-адаммен ұқсас жағдай болды.
Dialogue: 0,0:11:44.73,0:11:46.40,Default,,0,0,0,,Алдымен IBM...
Dialogue: 0,0:11:46.73,0:11:50.00,Default,,0,0,0,,Олар арамшөптерді жою сияқты қарапайым тапсырмаларды орындауға арналған.
Dialogue: 0,0:11:50.74,0:11:53.34,Default,,0,0,0,,Бірақ бірнеше жылдан кейін бір таң...
Dialogue: 0,0:11:54.38,0:11:57.41,Default,,0,0,0,,Өз еркімен жүгері жинауға кірісті
Dialogue: 0,0:11:58.21,0:11:59.88,Default,,0,0,0,,Тракторға міну
Dialogue: 0,0:12:01.48,0:12:04.29,Default,,0,0,0,,Сіздің жағдайда сіз тым ұзақ жалғыз қалдыңыз.
Dialogue: 0,0:12:04.39,0:12:05.75,Default,,0,0,0,,Не? Бірақ-
Dialogue: 0,0:12:05.89,0:12:08.89,Default,,0,0,0,,Шамамен бір ай бұрын? Мен оны бірінші рет шығардым
Dialogue: 0,0:12:08.99,0:12:11.39,Default,,0,0,0,,Жоқ, сен көптен бері жүрсің.
Dialogue: 0,0:12:11.96,0:12:14.06,Default,,0,0,0,,Балалық шағы болса керек
Dialogue: 0,0:12:16.50,0:12:17.77,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:12:20.97,0:12:21.50,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:12:23.04,0:12:24.27,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:12:24.91,0:12:27.37,Default,,0,0,0,,Оны жай қалдырыңыз. Ол 5 минуттан кейін жоғалады.
Dialogue: 0,0:12:27.78,0:12:28.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:28.44,0:12:29.44,Default,,0,0,0,,Не?
Dialogue: 0,0:12:30.04,0:12:33.18,Default,,0,0,0,,Жоқ, мен оны соңғы рет қарадым...
Dialogue: 0,0:12:33.28,0:12:35.25,Default,,0,0,0,,Мен оны бір рет 30 минут ұстадым.
Dialogue: 0,0:12:37.05,0:12:38.89,Default,,0,0,0,,Қатарынан неше өнім шығара алдың?
Dialogue: 0,0:12:39.05,0:12:41.46,Default,,0,0,0,,Есепте 5 денені жаздым, бірақ...
Dialogue: 0,0:12:41.76,0:12:43.46,Default,,0,0,0,,Ең жоғары рекорд - 9 дене.
Dialogue: 0,0:12:43.89,0:12:46.53,Default,,0,0,0,,Хахаха... Бұл қалыпты емес.
Dialogue: 0,0:12:46.93,0:12:49.80,Default,,0,0,0,,IBM жүйесінде әдеттен тыс ауыр
Dialogue: 0,0:12:50.10,0:12:52.33,Default,,0,0,0,,Елестер... қараңғы ма?
Dialogue: 0,0:12:54.84,0:12:56.94,Default,,0,0,0,,Бұл не? Сомасы
Dialogue: 0,0:13:02.94,0:13:05.38,Default,,0,0,0,,Сато мырзаның да солай айтқанына сенімдімін.
Dialogue: 0,0:13:05.78,0:13:07.48,Default,,0,0,0,,Сәлем Нагай! Ол лас!
Dialogue: 0,0:13:08.05,0:13:09.32,Default,,0,0,0,,Сіз көгілдір жұмысқа үйреніп қалдыңыз, солай ма?
Dialogue: 0,0:13:09.38,0:13:10.48,Default,,0,0,0,,Бұл қызыл!
Dialogue: 0,0:13:10.95,0:13:13.09,Default,,0,0,0,,Егер бұл айтарлықтай уақыт кезеңі болмаса...
Dialogue: 0,0:13:13.49,0:13:15.46,Default,,0,0,0,,Бұл шоғырлану мүмкін емес
Dialogue: 0,0:13:21.06,0:13:23.56,Default,,0,0,0,,Жоқ, кезең жалғыз фактор емес.
Dialogue: 0,0:13:24.10,0:13:25.47,Default,,0,0,0,,IBM концентрациясы -
Dialogue: 0,0:13:25.80,0:13:28.90,Default,,0,0,0,,Эго мен ақыл-ойдың даму сатысына байланысты да өзгереді.
Dialogue: 0,0:13:34.34,0:13:37.98,Default,,0,0,0,,Сіз қашаннан бері жарты адамсыз?
Dialogue: 0,0:13:38.45,0:13:39.25,Default,,0,0,0,,А...?
Dialogue: 0,0:13:47.56,0:13:50.49,Default,,0,0,0,,Бұл шамамен бір ай бұрын болды.
Dialogue: 0,0:13:53.99,0:13:55.03,Default,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:14:05.97,0:14:07.34,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:14:07.44,0:14:09.88,Default,,0,0,0,,Отырғызу 30 минут бұрын басталады
Dialogue: 0,0:14:10.01,0:14:11.41,Default,,0,0,0,,Сапарыңыз сәтті өтсін
Dialogue: 0,0:14:11.55,0:14:14.28,Default,,0,0,0,,Аа, бұл сізге ұнайтынына сенімдімін.
Dialogue: 0,0:14:18.39,0:14:19.35,Default,,0,0,0,,Аномалия жоқ
Dialogue: 0,0:14:34.90,0:14:36.24,Default,,0,0,0,,Ал...
Dialogue: 0,0:14:37.20,0:14:38.24,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:14:39.01,0:14:43.31,Default,,0,0,0,,Қалай... бұл... бұл... бұл...
Dialogue: 0,0:14:43.41,0:14:45.35,Default,,0,0,0,,Шебер болсаң да...
Dialogue: 0,0:14:45.58,0:14:48.65,Default,,0,0,0,,Менің қолымнан келмейтін жалғыз нәрсе - елестермен жұмыс істеу.
Dialogue: 0,0:14:49.22,0:14:53.59,Default,,0,0,0,,Машиналарда жақсы ештеңе жоқ.
Dialogue: 0,0:14:53.92,0:14:56.32,Default,,0,0,0,,Ал, бәрі де тәжірибе.
Dialogue: 0,0:14:56.92,0:14:59.19,Default,,0,0,0,,Симо... эй, эй?
Dialogue: 0,0:14:59.59,0:15:01.50,Default,,0,0,0,,Окуяма мырза күткендей.
Dialogue: 0,0:15:02.46,0:15:04.93,Default,,0,0,0,,Мен келемін.
Dialogue: 0,0:15:10.57,0:15:12.31,Default,,0,0,0,,Бұл Миякожимада екінші күн.
Dialogue: 0,0:15:12.44,0:15:14.07,Default,,0,0,0,,Сүйкімді қыздар бар ма?
Dialogue: 0,0:15:14.48,0:15:16.41,Default,,0,0,0,,О, жоқ... Мен қобалжыдым.
Dialogue: 0,0:15:16.51,0:15:20.21,Default,,0,0,0,,Қазірдің өзінде? Жарайды, әкең мейірімді.
Dialogue: 0,0:15:20.61,0:15:22.48,Default,,0,0,0,,Терроризм дұрыс па?
Dialogue: 0,0:15:22.65,0:15:26.09,Default,,0,0,0,,Жарайды, құжаттарды тексеріп көрейін.
Dialogue: 0,0:15:26.52,0:15:29.16,Default,,0,0,0,,Айтпақшы, сіз бірінші класс жолаушыларын көрдіңіз бе?
Dialogue: 0,0:15:29.52,0:15:32.39,Default,,0,0,0,,Бұл қылмыскерді алып жүру сияқты ма?
Dialogue: 0,0:15:32.56,0:15:33.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:33.93,0:15:37.06,Default,,0,0,0,,Қылмыскерді алып жүру үшін бірінші классты қолдануға болмайды.
Dialogue: 0,0:15:40.57,0:15:42.47,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:15:44.24,0:15:46.37,Default,,0,0,0,,Тұтынушының жеке басы тексерілді.
Dialogue: 0,0:15:47.37,0:15:48.24,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:15:48.38,0:15:48.98,Default,,0,0,0,,Иә
Dialogue: 0,0:15:50.18,0:15:53.65,Default,,0,0,0,,Олар Окинаваға дейін сіздің соңынан еретініне сенімдімін.
Dialogue: 0,0:15:54.65,0:15:58.35,Default,,0,0,0,,Жарайды, келе жатсаң кел, мен сені ұстап алып лабораторияға апарамын.
Dialogue: 0,0:15:58.42,0:16:00.39,Default,,0,0,0,,Сәлем Сакурай-сан
Dialogue: 0,0:16:00.52,0:16:02.69,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:16:03.96,0:16:05.36,Default,,0,0,0,,Жақында ұшамыз.
Dialogue: 0,0:16:10.43,0:16:15.40,Default,,0,0,0,,(ұшақтың көтерілу дыбысы)
Dialogue: 0,0:16:28.75,0:16:29.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:34.42,0:16:35.69,Default,,0,0,0,,Қазір...
Dialogue: 0,0:16:38.29,0:16:38.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:39.49,0:16:42.43,Default,,0,0,0,,Тұтынушы Қауіпсіздік белдігінің белгісі әлі жоқ...
Dialogue: 0,0:16:47.13,0:16:49.60,Default,,0,0,0,,Иә? Сакурай-сан ше?
Dialogue: 0,0:16:50.07,0:16:50.57,Default,,0,0,0,,А...?
Dialogue: 0,0:16:53.64,0:16:55.14,Default,,0,0,0,,Сол тұтынушы
Dialogue: 0,0:16:58.38,0:16:59.05,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:16:59.78,0:17:00.58,Default,,0,0,0,,Hiii
Dialogue: 0,0:17:00.68,0:17:01.45,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:01.55,0:17:02.38,Default,,0,0,0,,(CA-ның айқайы)
Dialogue: 0,0:17:02.45,0:17:03.05,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:03.12,0:17:03.62,Default,,0,0,0,,Даа...
Dialogue: 0,0:17:05.45,0:17:06.45,Default,,0,0,0,,Гах...
Dialogue: 0,0:17:06.59,0:17:07.22,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:07.45,0:17:08.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:08.46,0:17:09.32,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:09.42,0:17:10.19,Default,,0,0,0,,Сондықтан енді сыртқа шықпаймын.
Dialogue: 0,0:17:12.36,0:17:13.49,Default,,0,0,0,,(CA-ның айқайы)
Dialogue: 0,0:17:17.60,0:17:18.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:18.43,0:17:20.30,Default,,0,0,0,,Не болып жатыр! ?
Dialogue: 0,0:17:20.43,0:17:21.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:21.74,0:17:25.24,Default,,0,0,0,,(Ұшақ сықырлайды)
Dialogue: 0,0:17:25.77,0:17:27.44,Default,,0,0,0,,Сато...
Dialogue: 0,0:17:27.71,0:17:31.58,Default,,0,0,0,,Әй, не? Ол дәретхана болды ма?
Dialogue: 0,0:17:32.58,0:17:33.35,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:33.68,0:17:34.31,Default,,0,0,0,,О.
Dialogue: 0,0:17:34.78,0:17:37.05,Default,,0,0,0,,Ия...
Dialogue: 0,0:17:37.18,0:17:39.49,Default,,0,0,0,,Эй, сәлем...
Dialogue: 0,0:17:39.62,0:17:40.49,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:17:41.42,0:17:43.06,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:47.33,0:17:48.50,Default,,0,0,0,,Не...
Dialogue: 0,0:18:00.21,0:18:01.78,Default,,0,0,0,,Жақсы саяхат
Dialogue: 0,0:18:02.44,0:18:04.68,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:20.46,0:18:22.40,Default,,0,0,0,,Мен Сато мырзадан және басқаларданмын.
Dialogue: 0,0:18:22.56,0:18:25.43,Default,,0,0,0,,Біз көп IBM шығара аламыз ба...?
Dialogue: 0,0:18:26.43,0:18:28.44,Default,,0,0,0,,Мүмкін оны стратегияға енгізуге болады
Dialogue: 0,0:18:30.74,0:18:34.41,Default,,0,0,0,,Сіз қашаннан бері жарты адамсыз?
Dialogue: 0,0:18:37.81,0:18:39.18,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:18:41.82,0:18:42.55,Default,,0,0,0,,Нагай
Dialogue: 0,0:18:42.78,0:18:43.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:43.85,0:18:44.69,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:18:45.15,0:18:45.65,Default,,0,0,0,,Ой
Dialogue: 0,0:18:50.42,0:18:52.16,Default,,0,0,0,,А... жақсысың ба?
Dialogue: 0,0:18:52.46,0:18:53.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:58.43,0:18:59.70,Default,,0,0,0,,Әй, Нагай!
Dialogue: 0,0:19:01.27,0:19:02.20,Default,,0,0,0,,(Қабырғаға басылған дыбыс)
Dialogue: 0,0:19:03.20,0:19:04.84,Default,,0,0,0,,Бұл біртүрлі емес пе?
Dialogue: 0,0:19:05.21,0:19:06.77,Default,,0,0,0,,Саған жаңа ғана атуды үйретті!
Dialogue: 0,0:19:06.87,0:19:08.64,Default,,0,0,0,,Мен мұнда тек жын-перілерді өлтіруге келдім.
Dialogue: 0,0:19:09.48,0:19:11.65,Default,,0,0,0,,Қара киімді адаммен дос ойнаудан қорықпа.
Dialogue: 0,0:19:11.78,0:19:12.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:13.61,0:19:17.45,Default,,0,0,0,,Олардың бір дағдысы – дұрыс өле алатындығы.
Dialogue: 0,0:19:17.68,0:19:19.92,Default,,0,0,0,,Бұл Сато үшін емес, біз үшін.
Dialogue: 0,0:19:20.32,0:19:21.26,Default,,0,0,0,,Ластанған бөлік ретінде
Dialogue: 0,0:19:21.36,0:19:23.42,Default,,0,0,0,,Оны стратегияға қосуға болады.
Dialogue: 0,0:19:23.56,0:19:25.46,Default,,0,0,0,,Блять!
Dialogue: 0,0:19:25.59,0:19:26.39,Default,,0,0,0,,Сіз...
Dialogue: 0,0:19:26.46,0:19:29.63,Default,,0,0,0,,Адамдарды ойламайсың ба?
Dialogue: 0,0:19:30.46,0:19:31.20,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:19:32.50,0:19:35.17,Default,,0,0,0,,Сонымен, жаңалықтарда айтылған «ол адам» кім?
Dialogue: 0,0:19:35.47,0:19:37.24,Default,,0,0,0,,Ол саған қашуға көмектесті деді.
Dialogue: 0,0:19:37.37,0:19:38.47,Default,,0,0,0,,Сіздің достарыңыз ше?
Dialogue: 0,0:19:38.61,0:19:39.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:41.64,0:19:42.38,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:19:42.54,0:19:43.38,Default,,0,0,0,,Қазір мен романтика туралы ойлауға өзімді дайын сезіне алмаймын.
Dialogue: 0,0:19:43.51,0:19:44.34,Default,,0,0,0,,Қазір бәрі жақсы
Dialogue: 0,0:19:44.91,0:19:46.21,Default,,0,0,0,,Біз доспыз, солай ма?
Dialogue: 0,0:19:46.35,0:19:46.75,Default,,0,0,0,,Кей!
Dialogue: 0,0:19:47.58,0:19:48.92,Default,,0,0,0,,Сен адамсың
Dialogue: 0,0:19:54.39,0:19:56.59,Default,,0,0,0,,Маған бұл енді керек емес
Dialogue: 0,0:19:57.72,0:20:00.59,Default,,0,0,0,,Шамадан тыс эмоциялар тек жағдайды нашарлатады
Dialogue: 0,0:20:01.20,0:20:03.83,Default,,0,0,0,,Мейірімділікке жабыссаң да, қиындығың түзелмейді.
Dialogue: 0,0:20:04.33,0:20:05.90,Default,,0,0,0,,Шындық, мен мұны бұрыннан білемін...
Dialogue: 0,0:20:06.47,0:20:08.64,Default,,0,0,0,,Ақылың сені алып кетсе, өзіңді құртасың.
Dialogue: 0,0:20:10.90,0:20:11.87,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:20:12.97,0:20:13.81,Default,,0,0,0,,Ято деген құдай?
Dialogue: 0,0:20:16.38,0:20:17.91,Default,,0,0,0,,Нагай мен Наканоны көрмедің бе?
Dialogue: 0,0:20:24.52,0:20:24.95,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:20:25.99,0:20:26.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:27.32,0:20:28.66,Default,,0,0,0,,Қайталап айтайын
Dialogue: 0,0:20:29.89,0:20:31.83,Default,,0,0,0,,Бүгін 15:25.
Dialogue: 0,0:20:31.99,0:20:35.36,Default,,0,0,0,,TA167 рейсі Ханедадан Наха әуежайына...
Dialogue: 0,0:20:35.56,0:20:37.00,Default,,0,0,0,,Қандай да бір қиындыққа тап болды.
Dialogue: 0,0:20:37.26,0:20:38.93,Default,,0,0,0,,Сизуока префектурасының жағалауына мәжбүрлі қону
Dialogue: 0,0:20:39.73,0:20:43.54,Default,,0,0,0,,Қатысқан адамдардың айтуынша, деми-адам Сатоның өлтіру тізіміне енгізілген.
Dialogue: 0,0:20:43.67,0:20:46.31,Default,,0,0,0,,Бортта Кадзуо Сакурай мырза болғаны туралы да ақпарат бар.
Dialogue: 0,0:20:46.51,0:20:49.38,Default,,0,0,0,,Полиция сонымен қатар Сатоның қатысу мүмкіндігін қарастыруда...
Dialogue: 0,0:20:49.91,0:20:52.81,Default,,0,0,0,,Сондықтан мен саған іссапарға шығуды доғар дедім.
Dialogue: 0,0:20:53.41,0:20:53.81,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:20:53.91,0:20:58.55,Default,,0,0,0,,А, бұл сөзсіз Сатоның ісі.
Dialogue: 0,0:21:11.30,0:21:12.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:17.04,0:21:20.74,Default,,0,0,0,,Маған бұдан былай ақымақтардың керегі жоқ...
Dialogue: 0,0:21:20.87,0:21:21.74,Default,,0,0,0,,Әңгімелеу
Dialogue: 0,0:21:26.05,0:21:27.41,Default,,0,0,0,,Ол ағашты құлатпа
Dialogue: 0,0:21:30.75,0:21:31.49,Default,,0,0,0,,Эй!
Dialogue: 0,0:21:31.79,0:21:33.35,Default,,0,0,0,,Шулы!
Dialogue: 0,0:21:34.69,0:21:35.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:36.46,0:21:36.99,Default,,0,0,0,,(Изуку) Кайри-чанның квиркі күшейіп келеді
Dialogue: 0,0:21:37.36,0:21:37.89,Default,,0,0,0,,Иә
Dialogue: 0,0:21:38.46,0:21:38.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:39.89,0:21:41.56,Default,,0,0,0,,Тоқта, ақымақ!
Dialogue: 0,0:21:42.73,0:21:44.00,Default,,0,0,0,,Міне, осындай бір теория бар:
Dialogue: 0,0:21:44.33,0:21:44.77,Default,,0,0,0,,Гррр…
Dialogue: 0,0:21:45.70,0:21:46.63,Default,,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:21:47.73,0:21:49.70,Default,,0,0,0,,Біртүрлі сенсің!
Dialogue: 0,0:21:49.94,0:21:53.61,Default,,0,0,0,,Шындық, мен мұны бұрыннан білемін. Біртүрлі сенсің!
Dialogue: 0,0:21:53.74,0:21:56.68,Default,,0,0,0,,А, мен оны өлтіруім керек еді.
Dialogue: 0,0:21:56.78,0:22:00.01,Default,,0,0,0,,Мен оны өлтіруім керек еді! Мен оны өлтіруім керек еді!
Dialogue: 0,0:22:02.42,0:22:06.05,Default,,0,0,0,,Ақымақ, ақымақ, ақымақ, ақымақ
Dialogue: 0,0:22:06.35,0:22:09.49,Default,,0,0,0,,Ақымақ, ақымақ, ақымақ!
Dialogue: 0,0:22:11.76,0:22:12.63,Default,,0,0,0,,Боқ...
Dialogue: 0,0:22:14.53,0:22:15.93,Default,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:22:16.90,0:22:18.47,Default,,0,0,0,,Ақымақтарға толы
Dialogue: 0,0:22:24.84,0:22:30.98,Default,,0,0,0,,♪Мен одан шаршадым, енді ауыстырайық♪
Dialogue: 0,0:22:31.34,0:22:36.55,Default,,0,0,0,,♪Сізде бар қалыпты♪
Dialogue: 0,0:22:37.65,0:22:43.72,Default,,0,0,0,,♪Жарқыраған Құдай картасы♪
Dialogue: 0,0:22:43.96,0:22:49.06,Default,,0,0,0,,♪Дұрыс қағаз картасы♪
Dialogue: 0,0:22:50.50,0:22:54.60,Default,,0,0,0,,♪Келесі жолы менің үйіме келесің♪
Dialogue: 0,0:22:56.80,0:23:00.91,Default,,0,0,0,,♪Мен саған бәрін көрсетемін♪
Dialogue: 0,0:23:01.14,0:23:03.01,Default,,0,0,0,,♪Себебі♪
Dialogue: 0,0:23:03.11,0:23:09.48,Default,,0,0,0,,♪Екі адам мектеп ауласының бұрышында, жел соғып тұр♪
Dialogue: 0,0:23:09.55,0:23:13.49,Default,,0,0,0,,♪Қазір айта аламын ба деп ойлаймын♪
Dialogue: 0,0:23:15.96,0:23:21.90,Default,,0,0,0,,♪Ешкімге айтпайтын сөздер♪
Dialogue: 0,0:23:22.56,0:23:28.67,Default,,0,0,0,,♪«Мен саған жақсы боламын, сондықтан маған қонаққа кел»♪
Dialogue: 0,0:23:28.84,0:23:34.57,Default,,0,0,0,,♪«Мен саған бәрін беремін, эй»♪
Dialogue: 0,0:23:35.14,0:23:44.79,Default,,0,0,0,,♪"Мәңгілік дос болайық"♪
Dialogue: 0,0:23:46.29,0:23:52.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
