Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.00,0:00:11.64,Default,,0,0,0,,♪Осы баратын жерге көзіңізді оятыңыз♪
Dialogue: 0,0:00:12.07,0:00:15.04,Default,,0,0,0,,♪Егер қашып құтыла алмасаң♪
Dialogue: 0,0:00:15.18,0:00:20.78,Default,,0,0,0,,♪ Бәрін жұтып, дұрыс-бұрысты, ұрыс-керіс ♪
Dialogue: 0,0:00:27.62,0:00:33.60,Default,,0,0,0,,♪Жүректің қараңғылығын басқаратын қауіп шу шығарады♪
Dialogue: 0,0:00:33.80,0:00:39.70,Default,,0,0,0,,♪Ақылынан айырылғалы тұрған адамдар туралы шындық♪
Dialogue: 0,0:00:40.20,0:00:45.77,Default,,0,0,0,,♪Мен оның мағынасыздығын білемін♪
Dialogue: 0,0:00:46.31,0:00:52.41,Default,,0,0,0,,♪Тіпті жалған тыныштық бұзылса♪
Dialogue: 0,0:00:52.48,0:01:03.53,Default,,0,0,0,,♪ Қарсы болатын көлеңке түсіру ♪
Dialogue: 0,0:01:04.43,0:01:07.53,Default,,0,0,0,,♪Бұл қашып кетудің соңы♪
Dialogue: 0,0:01:07.66,0:01:10.67,Default,,0,0,0,,♪Себебі бұл жалғыз жол♪
Dialogue: 0,0:01:10.77,0:01:16.81,Default,,0,0,0,,♪ Мен көздеген кішкентай үмітке ♪ жет
Dialogue: 0,0:01:17.11,0:01:20.11,Default,,0,0,0,,♪Сол созылған қолдан♪
Dialogue: 0,0:01:20.24,0:01:23.28,Default,,0,0,0,,♪Төгілген әлсіздік♪
Dialogue: 0,0:01:23.38,0:01:29.72,Default,,0,0,0,,♪Дұрыс-бұрыс бәрін жұтып, жынды болдым♪
Dialogue: 0,0:01:39.33,0:01:46.13,Default,,0,0,0,,(ОМОН)
Dialogue: 0,0:01:49.54,0:01:50.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:51.17,0:01:53.21,Default,,0,0,0,,А, Азиямен байланыс ше?
Dialogue: 0,0:01:53.27,0:01:56.21,Default,,0,0,0,,Радионы және барлық жабдықты қалпына келтіру күтілмейді!
Dialogue: 0,0:01:56.28,0:01:58.55,Default,,0,0,0,,Хабаршыны іске қосыңыз және оны жоғарыдан түсіріңіз!
Dialogue: 0,0:01:58.61,0:02:01.75,Default,,0,0,0,,Жоқ! Мұндай күшпен тіпті хабаршы да аман қала алмайды!
Dialogue: 0,0:02:01.88,0:02:03.85,Default,,0,0,0,,Бірақ мен қосымша күштерді шақыруға тырыссам да...
Dialogue: 0,0:02:04.15,0:02:06.52,Default,,0,0,0,,Сіз елордалық полиция бөліміне 15 минутта жете аласыз!
Dialogue: 0,0:02:06.59,0:02:07.82,Default,,0,0,0,,Радио жұмыс істемесе, жүгіріңіз!
Dialogue: 0,0:02:07.89,0:02:09.32,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:02:11.16,0:02:12.46,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:02:12.73,0:02:15.90,Default,,0,0,0,,Бұл жағдайда менің ағам дайындаған сақтандыру...
Dialogue: 0,0:02:16.16,0:02:16.76,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:02:37.92,0:02:38.72,Default,,0,0,0,,Ген-кун
Dialogue: 0,0:02:38.79,0:02:39.55,Default,,0,0,0,,Әй?
Dialogue: 0,0:02:40.22,0:02:41.42,Default,,0,0,0,,Бір сәтке бола аламын ба?
Dialogue: 0,0:02:44.89,0:02:46.43,Default,,0,0,0,,Сақтығыңызды төмендетпеңіз
Dialogue: 0,0:02:46.69,0:02:49.36,Default,,0,0,0,,Қарсылас – жарты адамдарға қарсы күресуге маманданған бөлімше.
Dialogue: 0,0:02:49.46,0:02:51.73,Default,,0,0,0,,Бірақ сен адамсың ғой, солай ма?
Dialogue: 0,0:02:51.83,0:02:53.90,Default,,0,0,0,,Иә... солай ма?
Dialogue: 0,0:02:57.27,0:02:58.64,Default,,0,0,0,,Жаулардың саны 7.
Dialogue: 0,0:02:58.91,0:03:00.58,Default,,0,0,0,,Фонарларға да тыйым салынады.
Dialogue: 0,0:03:00.64,0:03:01.88,Default,,0,0,0,,Осы қарқынмен біз тіпті бір-бірімізге шабуыл жасай аламыз.
Dialogue: 0,0:03:01.94,0:03:04.21,Default,,0,0,0,,Көзіңізді шеткі көру қабілетіне жаттықтырыңыз
Dialogue: 0,0:03:04.68,0:03:06.88,Default,,0,0,0,,3-топтың жоғарғы қабатқа шығатын өз баспалдақтары бар
Dialogue: 0,0:03:06.95,0:03:09.22,Default,,0,0,0,,4-топ мәжіліс залында төрағаны қорғайды
Dialogue: 0,0:03:09.28,0:03:11.69,Default,,0,0,0,,Қалғандары осы жерде жақын шайқасқа дайындалады.
Dialogue: 0,0:03:12.42,0:03:15.32,Default,,0,0,0,,Нашар өлтірме, ұстап ал, бағындыр
Dialogue: 0,0:03:23.46,0:03:25.77,Default,,0,0,0,,Бұл жағдай, керісінше, мүмкіндік.
Dialogue: 0,0:03:26.43,0:03:28.84,Default,,0,0,0,,Сіз осы жерге барасыз ба?
Dialogue: 0,0:03:29.34,0:03:32.81,Default,,0,0,0,,Ұрысқысы келетін Сато мырза Таямен бетпе-бет келуі керек еді.
Dialogue: 0,0:03:33.27,0:03:36.51,Default,,0,0,0,,Баспалдақ ұрысқа қатысуы мүмкін.
Dialogue: 0,0:03:36.71,0:03:38.65,Default,,0,0,0,,Өйткені, мен дөңгелектермен күресу мүмкіндігін пайдаландым.
Dialogue: 0,0:03:38.71,0:03:39.98,Default,,0,0,0,,Сатоны жеңген дұрыс емес пе?
Dialogue: 0,0:03:40.55,0:03:43.99,Default,,0,0,0,,Қазіргі жағдайда жаудың нысанасы төраға...
Dialogue: 0,0:03:44.29,0:03:47.36,Default,,0,0,0,,Бұл стратегияның табысқа жету ықтималдығы жоғары.
Dialogue: 0,0:03:47.62,0:03:49.49,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:50.26,0:03:52.33,Default,,0,0,0,,Жалқаулыққа уақытымыз жоқ сияқты.
Dialogue: 0,0:03:52.39,0:03:58.40,Default,,0,0,0,,(Мылтық дыбысы)
Dialogue: 0,0:03:59.27,0:04:01.80,Default,,0,0,0,,Мылтық сәулесін көздеп, қаруды залалсыздандырыңыз.
Dialogue: 0,0:04:07.38,0:04:08.01,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:09.01,0:04:10.01,Default,,0,0,0,,Қалпына келтіру!
Dialogue: 0,0:04:10.31,0:04:12.38,Default,,0,0,0,,Менің қорқуға уақытым жоқ! Ат!
Dialogue: 0,0:04:18.92,0:04:19.85,Default,,0,0,0,,Артқа шегін!
Dialogue: 0,0:04:20.46,0:04:21.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:21.79,0:04:23.79,Default,,0,0,0,,Қарғыс атсын! Менің көзім зақымдалды!
Dialogue: 0,0:04:23.93,0:04:25.66,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:04:29.00,0:04:30.93,Default,,0,0,0,,Уф... Бұх...
Dialogue: 0,0:04:31.37,0:04:33.40,Default,,0,0,0,,Әрине, олар өлмейді.
Dialogue: 0,0:04:33.64,0:04:36.30,Default,,0,0,0,,Бірақ мен әуесқоймын.
Dialogue: 0,0:04:38.87,0:04:41.91,Default,,0,0,0,,Уф, уау...! (мылтық дыбысы)
Dialogue: 0,0:04:41.98,0:04:42.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:44.95,0:04:45.75,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:04:48.42,0:04:49.72,Default,,0,0,0,,Бұлай болса ше!
Dialogue: 0,0:04:52.59,0:04:53.32,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:55.46,0:04:57.36,Default,,0,0,0,,Бұл келе жатыр! IBM... Уау!
Dialogue: 0,0:04:57.59,0:04:58.86,Default,,0,0,0,,Бағананың алдында!
Dialogue: 0,0:05:00.90,0:05:02.06,Default,,0,0,0,,Сіз жеңесіз бе?
Dialogue: 0,0:05:02.36,0:05:03.00,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым…
Dialogue: 0,0:05:05.80,0:05:06.50,Default,,0,0,0,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,0:05:07.34,0:05:08.94,Default,,0,0,0,,Ол негізгі орган! Мақсат!
Dialogue: 0,0:05:09.04,0:05:10.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:14.71,0:05:17.58,Default,,0,0,0,,I... Сананың берілуі...
Dialogue: 0,0:05:18.05,0:05:18.95,Default,,0,0,0,,Боқ...
Dialogue: 0,0:05:19.85,0:05:21.02,Default,,0,0,0,,Қазірге дейін мен—
Dialogue: 0,0:05:25.35,0:05:25.92,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:05:28.39,0:05:29.02,Default,,0,0,0,,А...
Dialogue: 0,0:05:29.09,0:05:32.49,Default,,0,0,0,,Күтілгендей, анти-Ажинге қарсы арнайы топ
Dialogue: 0,0:05:33.76,0:05:35.36,Default,,0,0,0,,Аты жоғалған жоқ.
Dialogue: 0,0:05:36.10,0:05:37.00,Default,,0,0,0,,Міне...
Dialogue: 0,0:05:37.07,0:05:40.77,Default,,0,0,0,,Оны дереу бейтараптандырыңыз! Оған қайта тірілуге ​​мүмкіндік бермеңіз!
Dialogue: 0,0:05:41.10,0:05:41.90,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:05:43.54,0:05:45.51,Default,,0,0,0,,Кеш болды, иә?
Dialogue: 0,0:05:45.87,0:05:46.71,Default,,0,0,0,,Уау
Dialogue: 0,0:05:47.71,0:05:48.51,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:05:48.78,0:05:49.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:50.45,0:05:51.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:52.01,0:05:55.45,Default,,0,0,0,,Бұл мінез-құлық. Ол бұрынғы әскери адам ба?
Dialogue: 0,0:05:55.72,0:05:56.52,Default,,0,0,0,,Даа!
Dialogue: 0,0:05:58.59,0:06:02.66,Default,,0,0,0,,Керемет, бұл аңдар арасындағы төбелес.
Dialogue: 0,0:06:07.53,0:06:08.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:08.90,0:06:09.83,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:15.10,0:06:16.77,Default,,0,0,0,,Қазір! Оны қорғаңыз!
Dialogue: 0,0:06:17.00,0:06:21.38,Default,,0,0,0,,Өз кезегінде... Дұрыс, Сато мырза.
Dialogue: 0,0:06:21.58,0:06:22.11,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:06:30.12,0:06:31.92,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:06:32.02,0:06:34.92,Default,,0,0,0,,Енді тағы бір айналым.
Dialogue: 0,0:06:34.99,0:06:36.06,Default,,0,0,0,,(пышақ дыбысы)
Dialogue: 0,0:06:42.06,0:06:45.73,Default,,0,0,0,,(Мылтық дыбысы)
Dialogue: 0,0:06:50.04,0:06:52.14,Default,,0,0,0,,1 және 2-топтарды қолдау бөліміне өтіңіз! Мені деми-адам итермелеп жатыр!
Dialogue: 0,0:06:52.41,0:06:53.98,Default,,0,0,0,,Капитандармен не болып жатыр?
Dialogue: 0,0:06:55.71,0:06:56.68,Default,,0,0,0,,Хирасава мырза
Dialogue: 0,0:06:56.94,0:06:59.75,Default,,0,0,0,,А, Сатодан басқаның бәрін тоқтату керек.
Dialogue: 0,0:07:01.18,0:07:02.88,Default,,0,0,0,,Қария... (Манабе) Бұл Манабе.
Dialogue: 0,0:07:02.95,0:07:04.49,Default,,0,0,0,,Мұқият есте сақтаңыз
Dialogue: 0,0:07:04.75,0:07:05.75,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:07:06.15,0:07:06.85,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:15.63,0:07:17.87,Default,,0,0,0,,Не болып жатыр! (Азияға қарсы жасақ) Бізді итеріп жібереміз!
Dialogue: 0,0:07:17.93,0:07:19.63,Default,,0,0,0,,Уау... (Азияға қарсы жасақ) Уау!
Dialogue: 0,0:07:23.60,0:07:27.64,Default,,0,0,0,,Конференц-залдың ішінде ғана қалды. Жалғастырыңыз!
Dialogue: 0,0:07:31.98,0:07:33.01,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:34.05,0:07:34.85,Default,,0,0,0,,Не! ?
Dialogue: 0,0:07:34.92,0:07:36.52,Default,,0,0,0,,Сіз әлі осындасыз ба?
Dialogue: 0,0:07:36.85,0:07:38.22,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:07:39.69,0:07:42.09,Default,,0,0,0,,Ха, бұл сезім сондай сағыныш.
Dialogue: 0,0:07:42.16,0:07:43.96,Default,,0,0,0,,Мүлдем емес... Ммм.
Dialogue: 0,0:07:45.56,0:07:48.86,Default,,0,0,0,,Қарғыс атсын, мына жігіттерді тартпа!
Dialogue: 0,0:07:48.93,0:07:50.53,Default,,0,0,0,,Сато мырза, өтінемін!
Dialogue: 0,0:07:50.67,0:07:52.87,Default,,0,0,0,,Рахмет! Танака-кун!
Dialogue: 0,0:07:58.97,0:08:02.14,Default,,0,0,0,,Такахаши, әлсіреп жатқандарды қалпына келтір!
Dialogue: 0,0:08:02.21,0:08:04.05,Default,,0,0,0,,Біз де бос емеспіз!
Dialogue: 0,0:08:09.02,0:08:12.15,Default,,0,0,0,,Енді соңғы кезең.
Dialogue: 0,0:08:14.09,0:08:14.82,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:15.92,0:08:16.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:16.72,0:08:19.86,Default,,0,0,0,,(Хашигучидің ыңырануы)
Dialogue: 0,0:08:23.83,0:08:26.90,Default,,0,0,0,,Нағай-күн емес пе? Біраз уақыт өтті.
Dialogue: 0,0:08:27.54,0:08:29.64,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:08:29.74,0:08:30.97,Default,,0,0,0,,Ол қазірдің өзінде шешілді.
Dialogue: 0,0:08:31.87,0:08:34.88,Default,,0,0,0,,Сато мырза, мен сізді тоқтату үшін келдім.
Dialogue: 0,0:08:38.08,0:08:40.82,Default,,0,0,0,,(Хашигучидің ыңырануы)
Dialogue: 0,0:08:41.92,0:08:43.22,Default,,0,0,0,,Қаруыңызды тастаңыз
Dialogue: 0,0:08:44.02,0:08:46.89,Default,,0,0,0,,Немесе мен төрағаны өлтіремін.
Dialogue: 0,0:08:47.52,0:08:49.56,Default,,0,0,0,,А...
Dialogue: 0,0:08:49.89,0:08:52.93,Default,,0,0,0,,Ол ғылыми-зерттеу институтындағыдан басқа адам сияқты...
Dialogue: 0,0:08:53.16,0:08:56.16,Default,,0,0,0,,Қалай ойлайсың, мені ол кісінің өмірі қызықтырады ма?
Dialogue: 0,0:08:56.60,0:08:58.67,Default,,0,0,0,,Егер мен төрағаны өлтірсем...
Dialogue: 0,0:08:59.10,0:09:01.60,Default,,0,0,0,,Сато мырзаның ойыны сәтсіз болады
Dialogue: 0,0:09:02.17,0:09:04.67,Default,,0,0,0,,Менің көңіл көтеруімді көз алдымда алу үшін...
Dialogue: 0,0:09:05.01,0:09:06.81,Default,,0,0,0,,Сен шыдай алмайсың, солай ма?
Dialogue: 0,0:09:07.11,0:09:10.88,Default,,0,0,0,,Ахаха Сонда менің мінезім болжауға болатын шығар?
Dialogue: 0,0:09:11.61,0:09:12.98,Default,,0,0,0,,Сіз үшін-
Dialogue: 0,0:09:14.02,0:09:16.72,Default,,0,0,0,,Тыныштық өмірім – бейберекет
Dialogue: 0,0:09:18.25,0:09:20.72,Default,,0,0,0,,Тыныш өмір?
Dialogue: 0,0:09:21.59,0:09:25.93,Default,,0,0,0,,Ахаха түсіндім, тыныш өмір сүргің келді.
Dialogue: 0,0:09:26.23,0:09:29.93,Default,,0,0,0,,Бірақ қалыпты өмірге оралғанда не болады?
Dialogue: 0,0:09:30.16,0:09:33.07,Default,,0,0,0,,Тағы да айтамын: Қаруларыңды тастаңдар.
Dialogue: 0,0:09:33.17,0:09:36.00,Default,,0,0,0,,Бар болғаны қызықсыз өмір
Dialogue: 0,0:09:36.57,0:09:39.61,Default,,0,0,0,,Мені мұндай күнделікті өмір қызықтырмайды...
Dialogue: 0,0:09:39.67,0:09:41.91,Default,,0,0,0,,Маған әлі қызық болған жоқ.
Dialogue: 0,0:09:42.78,0:09:44.18,Default,,0,0,0,,Және-
Dialogue: 0,0:09:45.18,0:09:47.28,Default,,0,0,0,,Мен, Нагай-кун.
Dialogue: 0,0:09:48.28,0:09:53.69,Default,,0,0,0,,Менің ойыныма ешкімнің араласуына бәрінен артық шыдай алмаймын.
Dialogue: 0,0:09:54.62,0:09:58.79,Default,,0,0,0,,Сен менің өміріме араласатын адамсың!
Dialogue: 0,0:09:59.29,0:10:03.03,Default,,0,0,0,,(Хашигучидің ыңырануы)
Dialogue: 0,0:10:05.23,0:10:07.07,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:10:15.18,0:10:16.71,Default,,0,0,0,,Қарулардан аулақ болыңыз!
Dialogue: 0,0:10:18.95,0:10:19.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:20.98,0:10:23.72,Default,,0,0,0,,Сонымен не қалайсыз?
Dialogue: 0,0:10:23.78,0:10:27.92,Default,,0,0,0,,Мүмкін қолдау келгенше уақыт ұту керек пе? Немесе...
Dialogue: 0,0:10:29.16,0:10:31.93,Default,,0,0,0,,Мүмкін мені қалпына келтіруден сақтайтын шығар?
Dialogue: 0,0:10:32.63,0:10:35.26,Default,,0,0,0,,Қазір транквилизатор мылтығын ату үшін тамаша болар еді.
Dialogue: 0,0:10:35.33,0:10:37.23,Default,,0,0,0,,Қарғыс атқыр... Накано жасаңыз!
Dialogue: 0,0:10:37.77,0:10:38.87,Default,,0,0,0,,Сато!
Dialogue: 0,0:10:43.77,0:10:44.94,Default,,0,0,0,,Ах... (шабуыл) Қарғыс атсын...
Dialogue: 0,0:10:45.01,0:10:45.81,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:47.34,0:10:50.31,Default,,0,0,0,,Хахаха... Мен мұны білдім
Dialogue: 0,0:10:51.21,0:10:55.02,Default,,0,0,0,,Бұл жаман стратегия емес еді, бірақ маңыздысы...
Dialogue: 0,0:10:55.08,0:10:56.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:59.95,0:11:02.22,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:11:04.96,0:11:08.90,Default,,0,0,0,,Ойындар трюктермен келеді...
Dialogue: 0,0:11:17.10,0:11:17.84,Default,,0,0,0,,Эй, сен келгеннен бері бәрі осылай болып тұр, иә?
Dialogue: 0,0:11:19.67,0:11:20.71,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:21.18,0:11:22.38,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:11:23.08,0:11:24.71,Default,,0,0,0,,Сол Сато...!
Dialogue: 0,0:11:27.35,0:11:28.38,Default,,0,0,0,,Қазір...
Dialogue: 0,0:11:29.92,0:11:31.99,Default,,0,0,0,,Ах... менің бұрынғы өміріме оралу!
Dialogue: 0,0:11:32.05,0:11:35.26,Default,,0,0,0,,Хахаха Сен істедің, қарт өрт сөндіруші!
Dialogue: 0,0:11:35.36,0:11:39.16,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:11:39.23,0:11:39.96,Default,,0,0,0,,​​О?
Dialogue: 0,0:11:40.33,0:11:41.96,Default,,0,0,0,,Жоқ! (ату дыбысы)
Dialogue: 0,0:11:42.23,0:11:42.90,Default,,0,0,0,,Гах...
Dialogue: 0,0:11:42.96,0:11:46.10,Default,,0,0,0,,Жоқ... не дейсіз...
Dialogue: 0,0:11:46.27,0:11:49.14,Default,,0,0,0,,Ха... Мен ес-түссіз жатырмын...
Dialogue: 0,0:11:49.94,0:11:51.11,Default,,0,0,0,,Неліктен елестер бар...
Dialogue: 0,0:11:52.27,0:11:53.81,Default,,0,0,0,,Арх! Уф...
Dialogue: 0,0:11:54.04,0:11:54.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:57.31,0:11:58.11,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:11:58.25,0:11:59.15,Default,,0,0,0,,Уау...
Dialogue: 0,0:12:06.19,0:12:06.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:07.19,0:12:07.89,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:12:19.47,0:12:21.50,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:12:23.00,0:12:24.00,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:12:27.04,0:12:29.94,Default,,0,0,0,,Қалай... неге...
Dialogue: 0,0:12:30.38,0:12:32.38,Default,,0,0,0,,үшін тәжірибе.
Dialogue: 0,0:12:33.15,0:12:36.82,Default,,0,0,0,,Елестерді өздігінен қозғалта алатын жалғыз сен емессің.
Dialogue: 0,0:12:36.88,0:12:37.82,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:12:38.12,0:12:41.09,Default,,0,0,0,,Практикалық тәжірибе…
Dialogue: 0,0:12:41.76,0:12:43.89,Default,,0,0,0,,Менің өзімді сезінуім әлі толық дамымаған.
Dialogue: 0,0:12:43.96,0:12:46.13,Default,,0,0,0,,Бұйрықты осы жерден берген дұрыс.
Dialogue: 0,0:12:46.49,0:12:48.03,Default,,0,0,0,,Ю Ghost!
Dialogue: 0,0:12:53.00,0:12:56.04,Default,,0,0,0,,Мен аздап тәкәппар болған шығармын.
Dialogue: 0,0:12:56.24,0:12:58.27,Default,,0,0,0,,Не істеп жатырсың! Жылжыту!
Dialogue: 0,0:12:58.51,0:12:59.17,Default,,0,0,0,,Қане — бұл тіпті шамамен есеп те емес, жай ғана ойым
Dialogue: 0,0:13:03.28,0:13:06.18,Default,,0,0,0,,Эй... әлі жоқ! тағы бір рет
Dialogue: 0,0:13:08.95,0:13:10.95,Default,,0,0,0,,Шық! елес!
Dialogue: 0,0:13:11.89,0:13:14.92,Default,,0,0,0,,Шамасы, аруақтардың мінез-құлқы мен шығу тегі...
Dialogue: 0,0:13:14.99,0:13:18.43,Default,,0,0,0,,Деми-адамның психикалық жағдайына байланысты өзгеретін сияқты.
Dialogue: 0,0:13:21.10,0:13:23.23,Default,,0,0,0,,Демек, сен болған болашаққа қайта орала алмаймын дегің келе ме?
Dialogue: 0,0:13:24.17,0:13:25.17,Default,,0,0,0,,А, а...
Dialogue: 0,0:13:32.24,0:13:34.11,Default,,0,0,0,,Уф... (Манабе) Нагай!
Dialogue: 0,0:13:34.41,0:13:36.88,Default,,0,0,0,,Нагай! Неліктен?
Dialogue: 0,0:13:40.35,0:13:41.22,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:13:41.58,0:13:45.05,Default,,0,0,0,,Нагай-кунның да достары көп сияқты.
Dialogue: 0,0:13:45.25,0:13:46.35,Default,,0,0,0,,Бұл жігіттер...
Dialogue: 0,0:13:46.42,0:13:49.09,Default,,0,0,0,,Дұрыс, олар арнайы күштерге ұқсамайды.
Dialogue: 0,0:13:49.22,0:13:51.83,Default,,0,0,0,,Сіз біздің жолымызға түсіп жатырсыз!
Dialogue: 0,0:13:55.13,0:13:56.53,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:13:58.27,0:14:01.90,Default,,0,0,0,,Олардың бәрі ақымақ.
Dialogue: 0,0:14:02.10,0:14:03.97,Default,,0,0,0,,А? Не?
Dialogue: 0,0:14:06.41,0:14:08.34,Default,,0,0,0,,Неліктен білмейсің?
Dialogue: 0,0:14:09.94,0:14:12.41,Default,,0,0,0,,Сато мырза жай ғана ойнап тұр.
Dialogue: 0,0:14:13.15,0:14:16.42,Default,,0,0,0,,Мен деми-адамдардың болашағы туралы ойламаймын да!
Dialogue: 0,0:14:16.88,0:14:17.85,Default,,0,0,0,,Ах (Такахаши) Ах...
Dialogue: 0,0:14:24.06,0:14:26.09,Default,,0,0,0,,Қарғыс атқыр... Бұл IBM ме?
Dialogue: 0,0:14:26.96,0:14:28.56,Default,,0,0,0,,Соңғы кездері осы қонақүйдің сапасы сәл төмендеген сияқты…
Dialogue: 0,0:14:28.63,0:14:29.96,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:30.16,0:14:33.90,Default,,0,0,0,,Егер сіз елестерді көре алмасаңыз, сіздің досыңыз деми-адам емес шығар.
Dialogue: 0,0:14:35.30,0:14:37.17,Default,,0,0,0,,Уф, уау...
Dialogue: 0,0:14:37.50,0:14:38.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:38.61,0:14:39.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:45.58,0:14:46.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:46.41,0:14:47.41,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:14:48.38,0:14:51.12,Default,,0,0,0,,Сіз үшін басқа адамдардың өліп жатқанына қалай қарайсыз?
Dialogue: 0,0:14:51.19,0:14:54.29,Default,,0,0,0,,Тоқта... тоқта!
Dialogue: 0,0:14:54.59,0:14:56.09,Default,,0,0,0,,Мені сен сияқты жауапкершіліксіз бойдақтар қатарына қоспа.
Dialogue: 0,0:14:56.62,0:14:59.09,Default,,0,0,0,,Менің жолыма түскенің үшін бұл сенің жазаң.
Dialogue: 0,0:14:59.46,0:15:01.66,Default,,0,0,0,,Елес... Шық!
Dialogue: 0,0:15:02.13,0:15:03.33,Default,,0,0,0,,А... а...
Dialogue: 0,0:15:05.40,0:15:08.04,Default,,0,0,0,,Өтінемін... Өтінемін...!
Dialogue: 0,0:15:10.67,0:15:11.64,Default,,0,0,0,,Нагай…
Dialogue: 0,0:15:14.54,0:15:17.31,Default,,0,0,0,,Шық!
Dialogue: 0,0:15:21.22,0:15:22.22,Default,,0,0,0,,Нагай…
Dialogue: 0,0:15:23.58,0:15:25.25,Default,,0,0,0,,Жетті…
Dialogue: 0,0:15:27.02,0:15:27.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:33.36,0:15:34.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:36.10,0:15:36.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:39.43,0:15:40.50,Default,,0,0,0,,Нагай мырза…
Dialogue: 0,0:15:42.20,0:15:46.64,Default,,0,0,0,,Тыныш өмір сүргің келсе, тілегіңді орындайық.
Dialogue: 0,0:15:49.48,0:15:52.35,Default,,0,0,0,,Мәңгілік жалғасатын қараңғылықта
Dialogue: 0,0:15:52.98,0:15:54.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:04.46,0:16:06.09,Default,,0,0,0,,Деми-адамдар баспалдақта!
Dialogue: 0,0:16:06.16,0:16:07.66,Default,,0,0,0,,Мақсат қосымшасы! (Күшейту) Бақылауды қолға алыңыз!
Dialogue: 0,0:16:07.96,0:16:09.03,Default,,0,0,0,,Сато мырза!
Dialogue: 0,0:16:12.73,0:16:14.74,Default,,0,0,0,,Кофені қайта құй деп сұрауым керек еді.
Dialogue: 0,0:16:17.57,0:16:18.97,Default,,0,0,0,,Сато мырза!
Dialogue: 0,0:16:19.21,0:16:21.28,Default,,0,0,0,,О, не деген ұят.
Dialogue: 0,0:16:25.48,0:16:26.28,Default,,0,0,0,,Уау
Dialogue: 0,0:16:54.17,0:16:57.48,Default,,0,0,0,,Хахаха... бұл роликтер сияқты болды.
Dialogue: 0,0:16:57.71,0:17:01.05,Default,,0,0,0,,Жоқ, бұл еркін құлау дедіңіз бе?
Dialogue: 0,0:17:06.29,0:17:07.65,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:17:09.42,0:17:10.39,Default,,0,0,0,,Кимура
Dialogue: 0,0:17:10.62,0:17:14.53,Default,,0,0,0,,Қашу жолы қамтамасыз етілді. Ол жерден коммуналдық арыққа шығуға болады.
Dialogue: 0,0:17:16.43,0:17:19.30,Default,,0,0,0,,Сіз айтқандай, мен де осыны жинадым.
Dialogue: 0,0:17:20.03,0:17:22.50,Default,,0,0,0,,Осындай нәрсені жасау үшін...
Dialogue: 0,0:17:23.10,0:17:25.21,Default,,0,0,0,,Қанша рет өлтірілдің!
Dialogue: 0,0:17:25.37,0:17:26.27,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:32.15,0:17:33.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:34.72,0:17:37.65,Default,,0,0,0,,Мен тек ел үшін еңбек еттім.
Dialogue: 0,0:17:38.05,0:17:41.46,Default,,0,0,0,,Қару-жарақ жасау ел қорғанысы үшін қажет... (Танака) Ақымақ болма!
Dialogue: 0,0:17:43.19,0:17:45.19,Default,,0,0,0,,Менімен бірдей жағдайға тап болсаңыз да...
Dialogue: 0,0:17:45.46,0:17:48.23,Default,,0,0,0,,Сіз мұны айта аласыз ба? а?
Dialogue: 0,0:17:48.30,0:17:50.33,Default,,0,0,0,,Ал, Танака-кун, сабыр ет.
Dialogue: 0,0:17:50.73,0:17:53.30,Default,,0,0,0,,Оның әлі де маңызды рөлі бар.
Dialogue: 0,0:17:54.44,0:17:55.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:59.74,0:18:01.71,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:18:02.61,0:18:04.31,Default,,0,0,0,,Міне...
Dialogue: 0,0:18:04.48,0:18:07.55,Default,,0,0,0,,Мен электронды құлыпты EMP арқылы шығара алдым, бірақ...
Dialogue: 0,0:18:08.15,0:18:11.22,Default,,0,0,0,,Мен аналогтық кілтті ала алмаймын.
Dialogue: 0,0:18:13.19,0:18:14.66,Default,,0,0,0,,Бұл маңызды...
Dialogue: 0,0:18:15.09,0:18:17.46,Default,,0,0,0,,Сіз оны үнемі киесіз, солай ма?
Dialogue: 0,0:18:17.52,0:18:19.36,Default,,0,0,0,,Хи хи...
Dialogue: 0,0:18:23.86,0:18:25.27,Default,,0,0,0,,А, ана жерде, сонда, сонда.
Dialogue: 0,0:18:25.33,0:18:25.80,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:26.37,0:18:27.30,Default,,0,0,0,,Ах... (Такахаши) Ах...
Dialogue: 0,0:18:31.11,0:18:32.34,Default,,0,0,0,,Сато-сан!
Dialogue: 0,0:18:32.64,0:18:34.21,Default,,0,0,0,,Әлі айғақ жоқ...
Dialogue: 0,0:18:34.54,0:18:36.48,Default,,0,0,0,,Сондай-ақ демиадамдық азаматтық.
Dialogue: 0,0:18:36.54,0:18:37.71,Default,,0,0,0,,Танака мырза
Dialogue: 0,0:18:38.38,0:18:41.55,Default,,0,0,0,,Құқықтар біреуге берілген нәрсе емес.
Dialogue: 0,0:18:42.15,0:18:44.89,Default,,0,0,0,,Құқықтар – өз қолыңмен тапқан дүниелер.
Dialogue: 0,0:18:45.45,0:18:46.22,Default,,0,0,0,,Е...
Dialogue: 0,0:18:46.45,0:18:49.26,Default,,0,0,0,,Мен JFK осындай нәрсе айтқанына сенімдімін.
Dialogue: 0,0:18:49.76,0:18:52.59,Default,,0,0,0,,Жоқ, бұл Мартин Лютер Кинг болды деп ойлаймын.
Dialogue: 0,0:18:53.16,0:18:56.16,Default,,0,0,0,,Аа, менің ойымша, екеуі де басқаша. Жарайды.
Dialogue: 0,0:18:59.80,0:19:03.17,Default,,0,0,0,,Біздің күш-қуатымызды нақты көрсететін нәрсе...
Dialogue: 0,0:19:03.64,0:19:05.17,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:19:22.79,0:19:23.59,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:19:26.59,0:19:28.43,Default,,0,0,0,,Және… Тозаки мырза
Dialogue: 0,0:19:28.93,0:19:31.30,Default,,0,0,0,,Нагай! Ол қайда!
Dialogue: 0,0:19:37.44,0:19:38.27,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:39.61,0:19:41.74,Default,,0,0,0,,Мен Азияға қатысты іс үшін кешірім сұраймын.
Dialogue: 0,0:19:41.94,0:19:44.58,Default,,0,0,0,,Кей Нагай мен Осаму Накано тұтқынға алынды
Dialogue: 0,0:19:45.25,0:19:47.95,Default,,0,0,0,,Шамасы, ол Сатомен ынтымақтасады...
Dialogue: 0,0:19:48.52,0:19:51.29,Default,,0,0,0,,Бұл комитеттің құрметін сақтайды.
Dialogue: 0,0:19:53.19,0:19:54.76,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:19:55.19,0:19:55.96,Default,,0,0,0,,Ех (Сузумура) Е...
Dialogue: 0,0:19:56.39,0:19:58.29,Default,,0,0,0,,Біз қазір баспасөз мәслихатына дайындалып жатырмыз.
Dialogue: 0,0:19:58.63,0:20:00.46,Default,,0,0,0,,Үлкендеріңізге де көмектесіңіздер.
Dialogue: 0,0:20:01.33,0:20:02.83,Default,,0,0,0,,Мен комитеттің мүшесімін.
Dialogue: 0,0:20:02.90,0:20:04.23,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:20:05.70,0:20:07.33,Default,,0,0,0,,ше? (ату дыбысы)
Dialogue: 0,0:20:07.60,0:20:09.37,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:20:09.44,0:20:10.24,Default,,0,0,0,,Ой
Dialogue: 0,0:20:10.87,0:20:11.71,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:20:13.77,0:20:14.61,Default,,0,0,0,,Кеттік
Dialogue: 0,0:20:22.68,0:20:25.89,Default,,0,0,0,,Манабедегі сақалдылар ше?
Dialogue: 0,0:20:26.72,0:20:27.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:29.49,0:20:30.86,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:31.96,0:20:32.86,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:47.84,0:20:53.98,Default,,0,0,0,,♪Мен одан шаршадым, енді ауыстырайық♪
Dialogue: 0,0:20:54.38,0:20:59.52,Default,,0,0,0,,♪Сізде бар қалыпты♪
Dialogue: 0,0:21:00.69,0:21:06.76,Default,,0,0,0,,♪ Жарқыраған Құдай картасымен ♪
Dialogue: 0,0:21:06.99,0:21:12.03,Default,,0,0,0,,♪Дұрыс қағаз картасы♪
Dialogue: 0,0:21:13.53,0:21:17.57,Default,,0,0,0,,♪Келесі жолы менің үйіме келесің♪
Dialogue: 0,0:21:19.81,0:21:23.84,Default,,0,0,0,,♪Мен саған бәрін көрсетемін♪
Dialogue: 0,0:21:24.34,0:21:26.01,Default,,0,0,0,,♪Себебі♪
Dialogue: 0,0:21:26.31,0:21:32.52,Default,,0,0,0,,♪Екі адам мектеп ауласының бұрышында, жел соғып тұр♪
Dialogue: 0,0:21:32.62,0:21:36.46,Default,,0,0,0,,♪Қазір айта аламын ба деп ойлаймын♪
Dialogue: 0,0:21:39.06,0:21:44.87,Default,,0,0,0,,♪Ешкімге айтпайтын сөздер♪
Dialogue: 0,0:21:45.50,0:21:51.64,Default,,0,0,0,,♪«Мен саған жақсы боламын, сондықтан маған қонаққа кел»♪
Dialogue: 0,0:21:51.84,0:21:57.51,Default,,0,0,0,,♪«Мен саған бәрін беремін, эй»♪
Dialogue: 0,0:21:58.38,0:22:07.69,Default,,0,0,0,,♪"Мәңгілік дос болайық"♪
Dialogue: 0,0:22:09.19,0:22:15.19,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
