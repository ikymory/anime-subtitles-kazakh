Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.71,0:00:12.74,Default,,0,0,0,,♪Жақын шайқас, бөлшектену♪
Dialogue: 0,0:00:13.21,0:00:17.78,Default,,0,0,0,,♪ Менің алдымда кім тұрсың? ♪
Dialogue: 0,0:00:24.55,0:00:27.22,Default,,0,0,0,,♪Қашуды жалғастыру мәңгілік емес♪
Dialogue: 0,0:00:27.52,0:00:30.26,Default,,0,0,0,,♪ Оны шын өмірде шайнап, жұтып қой ♪
Dialogue: 0,0:00:30.33,0:00:35.20,Default,,0,0,0,,♪Айғайлап, екіұштылықтан бас тарт♪
Dialogue: 0,0:00:35.50,0:00:38.13,Default,,0,0,0,,♪Көлеңкенің қауіптілігін білу♪
Dialogue: 0,0:00:38.20,0:00:40.77,Default,,0,0,0,,♪Тым сабырлы жүйе♪
Dialogue: 0,0:00:41.04,0:00:44.21,Default,,0,0,0,,♪ ҚОСУ немесе ӨШІРУ Қазір қайсысын таңдар едіңіз? ♪
Dialogue: 0,0:00:45.44,0:00:48.71,Default,,0,0,0,,♪Нәтиже Мен өз эмоцияларымды қанша рет өлтіремін♪
Dialogue: 0,0:00:49.04,0:00:51.41,Default,,0,0,0,,♪Жоқ, ол бірінші орында өтіп кетті♪
Dialogue: 0,0:00:51.48,0:00:54.65,Default,,0,0,0,,♪Ол жай ғана жойылды♪
Dialogue: 0,0:00:55.62,0:00:58.29,Default,,0,0,0,,♪Мені жайыма қалдыршы Craze♪
Dialogue: 0,0:00:58.35,0:01:01.76,Default,,0,0,0,,♪Мен жай ғана менмін және мен шарасызмын♪
Dialogue: 0,0:01:02.16,0:01:03.39,Default,,0,0,0,,♪иә иә♪
Dialogue: 0,0:01:03.46,0:01:06.23,Default,,0,0,0,,♪Басынан тек тәуекелдерден баста♪
Dialogue: 0,0:01:06.33,0:01:08.70,Default,,0,0,0,,♪Жынды бол♪
Dialogue: 0,0:01:08.76,0:01:11.13,Default,,0,0,0,,♪Инстинктіңізді, шынайы болмысыңызды ашыңыз♪
Dialogue: 0,0:01:11.20,0:01:14.70,Default,,0,0,0,,♪Тексеру шабуылы иә♪
Dialogue: 0,0:01:15.10,0:01:18.74,Default,,0,0,0,,♪Мені жұлып алған сен кімсің? ♪
Dialogue: 0,0:01:40.43,0:01:42.60,Default,,0,0,0,,Резеңке оқтар...?
Dialogue: 0,0:01:42.73,0:01:46.13,Default,,0,0,0,,Бұл тәжірибелік сабақ болғанымен, біз тірі оқтарды пайдалана алмаймыз.
Dialogue: 0,0:01:46.23,0:01:48.44,Default,,0,0,0,,Біз өлгенде бітті.
Dialogue: 0,0:01:48.74,0:01:51.14,Default,,0,0,0,,Солай бола тұра, оны дұрыс қабылдауға әбден болады.
Dialogue: 0,0:01:51.27,0:01:53.14,Default,,0,0,0,,Мен ауырғанға үйрендім.
Dialogue: 0,0:01:56.61,0:01:58.45,Default,,0,0,0,,Әр команда 3 адамнан тұрады
Dialogue: 0,0:01:58.58,0:02:00.65,Default,,0,0,0,,Нагай - Альфа отрядының негізгі қызметкері.
Dialogue: 0,0:02:00.75,0:02:03.89,Default,,0,0,0,,Мен басқаратын екінші адаммын, ал Манабе – құйрық.
Dialogue: 0,0:02:04.22,0:02:05.15,Default,,0,0,0,,Накано...
Dialogue: 0,0:02:05.49,0:02:06.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:06.45,0:02:08.12,Default,,0,0,0,,Мен мұны қайталаймын
Dialogue: 0,0:02:08.29,0:02:11.13,Default,,0,0,0,,Бұған дейін Мацунами химия компаниясынан Риоичи Тадокоро мырзамен...
Dialogue: 0,0:02:11.19,0:02:13.16,Default,,0,0,0,,Косаку Эндо өлтірілді
Dialogue: 0,0:02:13.43,0:02:15.70,Default,,0,0,0,,Сізді әлі де басқа мақсаттар мазалайды ма?
Dialogue: 0,0:02:16.13,0:02:16.80,Default,,0,0,0,,Варикайо
Dialogue: 0,0:02:16.87,0:02:18.47,Default,,0,0,0,,Оны Сато мәжбүрлеген сияқты.
Dialogue: 0,0:02:18.63,0:02:20.30,Default,,0,0,0,,Полицияның бірқатар сәтсіздіктеріне байланысты...
Dialogue: 0,0:02:20.37,0:02:22.30,Default,,0,0,0,,Сондай-ақ қауіпсіздік жағдайын қайта қарауға шақыру бар.
Dialogue: 0,0:02:22.40,0:02:23.14,Default,,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:02:23.71,0:02:24.54,Default,,0,0,0,,(Кейдің күрсінуі)
Dialogue: 0,0:02:25.64,0:02:28.48,Default,,0,0,0,,Мен әділеттіліктің нашар сезімімен ұстай алмаймын.
Dialogue: 0,0:02:28.71,0:02:30.45,Default,,0,0,0,,Біз қабылдай алатын стратегия...
Dialogue: 0,0:02:30.55,0:02:34.68,Default,,0,0,0,,Тозаки мырза министрдің қимылдарын тексеріп, Сатоға тұтқиылдан шабуыл жасайды... солай ма?
Dialogue: 0,0:02:35.45,0:02:37.92,Default,,0,0,0,,Хмм, сіз дайын сияқтысыз.
Dialogue: 0,0:02:40.32,0:02:42.32,Default,,0,0,0,,Дәлірек айтсақ, Изуми-сан ше?
Dialogue: 0,0:02:42.79,0:02:45.29,Default,,0,0,0,,Мен жаттығу үшін сол команданы қалайтын едім.
Dialogue: 0,0:02:45.86,0:02:47.86,Default,,0,0,0,,Тозаки мырза және ғылыми-зерттеу институты.
Dialogue: 0,0:02:48.56,0:02:50.80,Default,,0,0,0,,Оны американдық шенеунік шақырған болса керек.
Dialogue: 0,0:02:51.73,0:02:53.94,Default,,0,0,0,,Сонымен, доктор Огура дегеніміз не?
Dialogue: 0,0:02:54.20,0:02:56.34,Default,,0,0,0,,Біз тек монитор бөлмесінде кездестік.
Dialogue: 0,0:02:56.87,0:03:00.21,Default,,0,0,0,,Кей Нагайдың қашып кеткенін біліп, бірден үйіне оралды.
Dialogue: 0,0:03:00.44,0:03:04.85,Default,,0,0,0,,Кейінірек дәрігер демигумандық шабуылдың ортасында болса да...
Dialogue: 0,0:03:04.95,0:03:06.38,Default,,0,0,0,,Қалқаның сыртында
Dialogue: 0,0:03:06.61,0:03:10.52,Default,,0,0,0,,Оны жер астында көлігіне қайтып келе жатқанда біреу өлтірді.
Dialogue: 0,0:03:10.69,0:03:13.45,Default,,0,0,0,,Мен де жағдайдың егжей-тегжейін білмеймін, бірақ...
Dialogue: 0,0:03:13.69,0:03:16.52,Default,,0,0,0,,Мен қылмыста IBM пайдаланылғанын естідім.
Dialogue: 0,0:03:16.66,0:03:18.83,Default,,0,0,0,,Мен есепті осылай қабылдадым.
Dialogue: 0,0:03:19.19,0:03:21.63,Default,,0,0,0,,Мәйіттің тістеріндегі емдеу белгілері де сәйкес келеді.
Dialogue: 0,0:03:21.93,0:03:22.73,Default,,0,0,0,,Жай... жай-
Dialogue: 0,0:03:22.93,0:03:25.50,Default,,0,0,0,,Менде біраз алаңдаушылық бар.
Dialogue: 0,0:03:25.83,0:03:26.63,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:03:26.90,0:03:27.87,Default,,0,0,0,,Мынау! Ырқ!
Dialogue: 0,0:03:28.54,0:03:32.37,Default,,0,0,0,,Кісі өлтіру кезіндегі бейнебақылау камерасының жазбасы неліктен өшіріледі?
Dialogue: 0,0:03:32.51,0:03:34.24,Default,,0,0,0,,Бұл, әрине, біртүрлі, бірақ...
Dialogue: 0,0:03:34.48,0:03:37.91,Default,,0,0,0,,Сато тудырған жарылыстың әсері себеп болуы мүмкін.
Dialogue: 0,0:03:43.95,0:03:46.39,Default,,0,0,0,,Дәрігер мен оның күзетшісінің денелері...
Dialogue: 0,0:03:46.72,0:03:49.99,Default,,0,0,0,,Оның басқа жерден табылуы да табиғи емес.
Dialogue: 0,0:03:50.46,0:03:53.23,Default,,0,0,0,,Қашып бара жатқанда үзіліп қалмады ма?
Dialogue: 0,0:03:53.43,0:03:54.33,Default,,0,0,0,,Күні -
Dialogue: 0,0:03:54.53,0:03:56.43,Default,,0,0,0,,Мекемеде болуы тиіс зерттеуші...
Dialogue: 0,0:03:56.50,0:03:59.00,Default,,0,0,0,,Оның із-түзсіз жоғалғаны туралы да мәліметтер бар.
Dialogue: 0,0:03:59.37,0:04:01.24,Default,,0,0,0,,Бұл туралы бірінші рет естіп тұрмын.
Dialogue: 0,0:04:01.64,0:04:05.77,Default,,0,0,0,,Мен қызметкерлер тізімі бұл фактіні растамайтынына сенімдімін.
Dialogue: 0,0:04:07.54,0:04:11.68,Default,,0,0,0,,Доктор Огура монитор бөлмесінен шыққан соң, сіз...
Dialogue: 0,0:04:12.28,0:04:14.55,Default,,0,0,0,,Сіз қоршаудан шықтыңыз ба?
Dialogue: 0,0:04:14.68,0:04:15.38,Default,,0,0,0,,Иә
Dialogue: 0,0:04:15.95,0:04:19.25,Default,,0,0,0,,Сіз маған шынымен күмәнданасыз ба?
Dialogue: 0,0:04:19.65,0:04:20.86,Default,,0,0,0,,Ал егер...
Dialogue: 0,0:04:21.69,0:04:25.73,Default,,0,0,0,,Егер қылмысты Сато емес, инсайдер жасаған болса...
Dialogue: 0,0:04:25.96,0:04:28.96,Default,,0,0,0,,Жағдайда дәрігерді өлтіру мүмкін...
Dialogue: 0,0:04:29.66,0:04:32.43,Default,,0,0,0,,Тозаки мырза, сіз жалғызсыз.
Dialogue: 0,0:04:32.53,0:04:35.84,Default,,0,0,0,,Неліктен мен мұны істеуім керек?
Dialogue: 0,0:04:38.04,0:04:39.74,Default,,0,0,0,,Менің білетінім –
Dialogue: 0,0:04:40.01,0:04:42.84,Default,,0,0,0,,Демигумандық шабуылдың ортасында болғанына қарамастан...
Dialogue: 0,0:04:43.44,0:04:47.45,Default,,0,0,0,,Сіз бір сағатқа жуық уақыт болдыңыз.
Dialogue: 0,0:04:48.88,0:04:50.95,Default,,0,0,0,,Неліктен мұндай қауіпті еліктеу керек?
Dialogue: 0,0:04:54.79,0:04:55.82,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:04:58.59,0:05:02.56,Default,,0,0,0,,Нағайдың қашып кеткенін бастығым білгенде телефон арқылы мені қатты сынға алды.
Dialogue: 0,0:05:03.36,0:05:05.47,Default,,0,0,0,,Мен бір орында тұра алмадым.
Dialogue: 0,0:05:06.93,0:05:10.64,Default,,0,0,0,,Мемлекеттік қызметкер болудың қиындығын бәріңіз білесіздер, солай емес пе?
Dialogue: 0,0:05:13.64,0:05:14.44,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:16.91,0:05:19.48,Default,,0,0,0,,Жанама дәлелдер өте нашар
Dialogue: 0,0:05:19.65,0:05:23.58,Default,,0,0,0,,Өйткені, ол кісінің дәрігерді өлтіруге еш қатысы жоқ емес пе?
Dialogue: 0,0:05:24.75,0:05:26.52,Default,,0,0,0,,Мен сіздің пікіріңізді естіген жоқпын.
Dialogue: 0,0:05:26.59,0:05:28.62,Default,,0,0,0,,Шектеу дегенді білмейсіңдер ғой…
Dialogue: 0,0:05:33.93,0:05:34.70,Default,,0,0,0,,Иә
Dialogue: 0,0:05:35.50,0:05:37.57,Default,,0,0,0,,Бұл уақыт босқа кетті.
Dialogue: 0,0:05:39.53,0:05:43.04,Default,,0,0,0,,Артында қалдырылған заттарды жинау және Жапонияға қайту туралы өтініш беріңіз.
Dialogue: 0,0:05:46.81,0:05:47.58,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:05:48.81,0:05:49.71,Default,,0,0,0,,Соңғы жаңалықтар
Dialogue: 0,0:05:50.34,0:05:51.61,Default,,0,0,0,,Бүгін түстен кейін -
Dialogue: 0,0:05:51.68,0:05:53.98,Default,,0,0,0,,Toyo Rayroad Sangyo бас жүйесінің жұмысында.
Dialogue: 0,0:05:54.05,0:05:55.78,Default,,0,0,0,,Жарылыс оқиғасы орын алды.
Dialogue: 0,0:05:55.85,0:05:58.72,Default,,0,0,0,,Бұл жағдайда компания төрағасы Ютани мырза...
Dialogue: 0,0:05:58.79,0:06:00.92,Default,,0,0,0,,Тағы үш адамның қайтыс болғаны расталды.
Dialogue: 0,0:06:00.99,0:06:01.96,Default,,0,0,0,,(маркер дыбысы)
Dialogue: 0,0:06:02.02,0:06:03.93,Default,,0,0,0,,Қайтыс болған төрт адам...
Dialogue: 0,0:06:04.03,0:06:07.06,Default,,0,0,0,,Өлтіру тізіміндегі Аджин Сатоның нысанасы.
Dialogue: 0,0:06:07.56,0:06:09.90,Default,,0,0,0,,Қатаң позиция ұстанған үкіметке қарсы -
Dialogue: 0,0:06:09.96,0:06:12.10,Default,,0,0,0,,Кейбіреулер бұл Сатоның жауабы деп айтады.
Dialogue: 0,0:06:12.83,0:06:14.70,Default,,0,0,0,,Сатоның қатыгездіктерін жалғастыру
Dialogue: 0,0:06:14.77,0:06:17.51,Default,,0,0,0,,Мемлекеттік мекемелердің жанында шерулер жалғасуда
Dialogue: 0,0:06:18.47,0:06:21.11,Default,,0,0,0,,Эй, сен деми-адамдар туралы жаңалықтарды көрдің бе?
Dialogue: 0,0:06:21.48,0:06:23.68,Default,,0,0,0,,Иә, қорқынышты.
Dialogue: 0,0:06:23.78,0:06:25.38,Default,,0,0,0,,Аурухана бөлмесіндегі бала
Dialogue: 0,0:06:25.75,0:06:28.42,Default,,0,0,0,,Сенің ағаң – Кей Нағай. (2 медбике) Бұл-
Dialogue: 0,0:06:28.58,0:06:30.59,Default,,0,0,0,,Бұл өткен күні айтылған деми-адам емес пе?
Dialogue: 0,0:06:30.79,0:06:34.52,Default,,0,0,0,,Ол біреуді шатырдан итеріп жіберіп, нысаннан қашып кетті.
Dialogue: 0,0:06:34.86,0:06:36.72,Default,,0,0,0,,Мен уайымдап тұрмын.
Dialogue: 0,0:06:43.10,0:06:46.43,Default,,0,0,0,,Дүние деми-адамдардың өмір сүруі қиын болды.
Dialogue: 0,0:06:47.07,0:06:48.74,Default,,0,0,0,,Темекі шегетін адам сияқты
Dialogue: 0,0:06:49.07,0:06:53.07,Default,,0,0,0,,Сато мырзаны тоқтатсаңыз, бұрынғы күнделікті өміріңізге қайта ораласыз.
Dialogue: 0,0:06:54.58,0:06:57.78,Default,,0,0,0,,Темекіге қарағанда деми-адамдардың басқаларға зияны жоқ.
Dialogue: 0,0:06:59.78,0:07:01.15,Default,,0,0,0,,Мен сені дәл қазір осы жерде атып тастасам да, жоғарыдағылар қарсы болмас еді, иә?
Dialogue: 0,0:07:16.83,0:07:18.53,Default,,0,0,0,,Құпия қару...
Dialogue: 0,0:07:19.07,0:07:21.70,Default,,0,0,0,,Мен осындай нәрсені жасап көргім келді.
Dialogue: 0,0:07:25.67,0:07:28.64,Default,,0,0,0,,Біз терроризмге көнбейміз...
Dialogue: 0,0:07:29.01,0:07:33.05,Default,,0,0,0,,Адамдардың қауіпсіздігіне қауіп төндіретін жартылай адам ұйымын жою.
Dialogue: 0,0:07:33.48,0:07:35.88,Default,,0,0,0,,Жаңа заң қабылданғаннан кейін
Dialogue: 0,0:07:36.82,0:07:39.55,Default,,0,0,0,,Таңғажайып нәрсе болды.
Dialogue: 0,0:07:39.92,0:07:43.52,Default,,0,0,0,,Бұл демиадамның жағдайын нашарлатады.
Dialogue: 0,0:07:45.59,0:07:46.76,Default,,0,0,0,,Сіз көңіліңізден шықпайсыз ба?
Dialogue: 0,0:07:46.89,0:07:48.16,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:07:48.56,0:07:51.63,Default,,0,0,0,,Бірақ менің ойымша, қазіргі әдіс дұрыс па?
Dialogue: 0,0:07:51.80,0:07:54.90,Default,,0,0,0,,Олай болса, тағы қандай әдістер бар?
Dialogue: 0,0:07:55.70,0:07:57.21,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:58.77,0:08:02.74,Default,,0,0,0,,Деми-адамдарға қарсы сынның күшейгені рас.
Dialogue: 0,0:08:03.64,0:08:05.78,Default,,0,0,0,,Бірақ мұның бәрі жаман емес, солай ма?
Dialogue: 0,0:08:07.72,0:08:11.65,Default,,0,0,0,,Қазір мұнда Жапонияның түкпір-түкпірінен деми-адамдар жиналып жатыр.
Dialogue: 0,0:08:12.02,0:08:14.12,Default,,0,0,0,,Денсаулық сақтау, еңбек және әл-ауқат министрлігіне бұрын...
Dialogue: 0,0:08:14.56,0:08:17.19,Default,,0,0,0,,Кейбір топтар сіздің қолдауыңызға сүйенді.
Dialogue: 0,0:08:17.69,0:08:20.19,Default,,0,0,0,,Ауызша сөзге полиция да тосқауыл бола алмайды.
Dialogue: 0,0:08:21.56,0:08:22.56,Default,,0,0,0,,Неге соншалықты алысқа бару керек…
Dialogue: 0,0:08:22.93,0:08:25.83,Default,,0,0,0,,Мен демиадамдардың болашағы үшін тұрдым.
Dialogue: 0,0:08:26.70,0:08:28.77,Default,,0,0,0,,Мен енді кері қайтара алмаймын.
Dialogue: 0,0:08:31.81,0:08:32.74,Default,,0,0,0,,Танака мырза
Dialogue: 0,0:08:33.24,0:08:36.71,Default,,0,0,0,,Әзірше барлығынан бомба жасауға көмектесулерін сұраймын.
Dialogue: 0,0:08:36.78,0:08:38.55,Default,,0,0,0,,О, Варина
Dialogue: 0,0:08:38.85,0:08:40.98,Default,,0,0,0,,Енді сізге тағы бір нәрсе істеу керек пе?
Dialogue: 0,0:08:41.68,0:08:43.85,Default,,0,0,0,,Хмм... тазалау?
Dialogue: 0,0:08:44.12,0:08:45.12,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:08:45.62,0:08:48.82,Default,,0,0,0,,Мен ұйымдастырушымын, егер сізде бірдеңе болса, маған хабарлаңыз.
Dialogue: 0,0:08:49.96,0:08:52.83,Default,,0,0,0,,Ха, шағын әскер сияқты.
Dialogue: 0,0:08:53.06,0:08:56.13,Default,,0,0,0,,Дәлірек айтсақ, оның аты кім?
Dialogue: 0,0:08:56.20,0:08:59.67,Default,,0,0,0,,Хехе, Танака мырза күткендей.
Dialogue: 0,0:08:59.73,0:09:02.54,Default,,0,0,0,,Иә? Не айтқың келеді?
Dialogue: 0,0:09:02.80,0:09:04.81,Default,,0,0,0,,Ең бастысы, Сато мырза ше?
Dialogue: 0,0:09:04.87,0:09:08.28,Default,,0,0,0,,А... Мен сені көптен бері көрмедім.
Dialogue: 0,0:09:08.71,0:09:11.25,Default,,0,0,0,,Бұл қазірдің өзінде шешілді.
Dialogue: 0,0:09:12.25,0:09:14.72,Default,,0,0,0,,Ә, қысқа үзіліс жасайық па?
Dialogue: 0,0:09:17.29,0:09:20.15,Default,,0,0,0,,Мейхан медициналық орталығының қызметкері Кашиваги мырза өлтірілді.
Dialogue: 0,0:09:20.62,0:09:23.16,Default,,0,0,0,,Қылмыс Шинкансен жүгіріп жүргенде болған сияқты.
Dialogue: 0,0:09:23.72,0:09:25.19,Default,,0,0,0,,(маркер дыбысы)
Dialogue: 0,0:09:28.06,0:09:30.20,Default,,0,0,0,,Сіздің кезегіңіз, Тозаки мырза.
Dialogue: 0,0:09:30.70,0:09:33.13,Default,,0,0,0,,Келесі мақсатты министр қазір-
Dialogue: 0,0:09:33.27,0:09:35.87,Default,,0,0,0,,Мен үкіметтің бірлескен ғимаратының дағдарысты басқару бөлмесінде тығылып жатырмын.
Dialogue: 0,0:09:36.64,0:09:39.31,Default,,0,0,0,,Алайда, байланысты компаниялар бірінен соң бірі шығынға ұшырады...
Dialogue: 0,0:09:39.61,0:09:41.34,Default,,0,0,0,,Жаңа заңнама да қабылданды
Dialogue: 0,0:09:41.88,0:09:44.28,Default,,0,0,0,,Министр де тиісті министрліктер мен ведомстволарға жауап берумен айналысады.
Dialogue: 0,0:09:44.61,0:09:47.35,Default,,0,0,0,,Ол министрлер кабинетінің вице-министрімен кездесіп, бір бетте жүрген сияқты.
Dialogue: 0,0:09:50.18,0:09:52.22,Default,,0,0,0,,Біз жасырын кездесудің орнын анықтадық.
Dialogue: 0,0:09:52.82,0:09:55.02,Default,,0,0,0,,Бұл әртүрлі елдердің маңызды адамдары пайдаланатын нысан.
Dialogue: 0,0:09:55.09,0:10:00.19,Default,,0,0,0,,Шабуылға Денсаулық сақтау, Еңбек және әл-ауқат министрлігі, сіздің үйіңіз немесе мейрамхана болуы керек емес пе?
Dialogue: 0,0:10:00.73,0:10:04.07,Default,,0,0,0,,Мен сіз бұл жай ғана болжам дедіңіз деп ойладым және...
Dialogue: 0,0:10:05.00,0:10:09.17,Default,,0,0,0,,Нагай Менің ойымша, сіз кейбір өзгерістерді шеше аласыз.
Dialogue: 0,0:10:09.24,0:10:10.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:12.34,0:10:16.74,Default,,0,0,0,,Ал, негізгі идея – үнемі стратегияларды қолдану.
Dialogue: 0,0:10:16.94,0:10:17.81,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:10:19.01,0:10:22.35,Default,,0,0,0,,Хирасава архитектуралық сызбаларды алып, кадр мәселесін қарастыруы керек.
Dialogue: 0,0:10:22.65,0:10:23.18,Default,,0,0,0,,Иә
Dialogue: 0,0:10:23.68,0:10:25.99,Default,,0,0,0,,Мен егжей-тегжейлі кесте аламын
Dialogue: 0,0:10:26.39,0:10:28.36,Default,,0,0,0,,Қалғандарыңыз жаттығуларыңыздың дәлдігін жақсартуыңыз керек.
Dialogue: 0,0:10:28.62,0:10:29.12,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:10:31.39,0:10:33.06,Default,,0,0,0,,Кеттік, Шимомура-кун.
Dialogue: 0,0:10:33.23,0:10:34.16,Default,,0,0,0,,Тозаки мырза
Dialogue: 0,0:10:36.40,0:10:39.93,Default,,0,0,0,,Бұдан былай әр минут пен секунд маңызды.
Dialogue: 0,0:10:40.90,0:10:42.27,Default,,0,0,0,,Сәтсіздік опция емес
Dialogue: 0,0:10:44.31,0:10:48.11,Default,,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,0:10:57.12,0:10:58.15,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:59.22,0:11:02.02,Default,,0,0,0,,Біз Сатоны ұстай алмаймыз, бірақ...
Dialogue: 0,0:11:02.12,0:11:04.33,Default,,0,0,0,,Демеуші жойылды
Dialogue: 0,0:11:05.19,0:11:08.83,Default,,0,0,0,,Барлық қателіктеріңізден кейін бетіңізді жақсы көрсете білдіңіз.
Dialogue: 0,0:11:09.00,0:11:10.23,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:10.73,0:11:13.17,Default,,0,0,0,,Бірақ министрге ештеңе болмайды деп үміттенемін...
Dialogue: 0,0:11:13.23,0:11:15.70,Default,,0,0,0,,Бұл жер ядролық пана іспетті.
Dialogue: 0,0:11:15.94,0:11:18.27,Default,,0,0,0,,Қанша жарты адам болсаң да, мен саған тиісе алмаймын.
Dialogue: 0,0:11:18.87,0:11:22.44,Default,,0,0,0,,Алайда, егер сіз сыртқа шықсаңыз, бұл басқа әңгіме.
Dialogue: 0,0:11:22.94,0:11:23.81,Default,,0,0,0,,Кез келген жағдайда кесте...
Dialogue: 0,0:11:23.88,0:11:25.38,Default,,0,0,0,,Мені күлдірме
Dialogue: 0,0:11:25.78,0:11:28.32,Default,,0,0,0,,Бірден шығарылатын қабілетсіз бағыныштыларға -
Dialogue: 0,0:11:28.45,0:11:30.12,Default,,0,0,0,,Мен нені талқылауым керек?
Dialogue: 0,0:11:30.25,0:11:31.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:32.15,0:11:35.99,Default,,0,0,0,,Оның үстіне, менің басқаларға алаңдауға уақытым жоқ.
Dialogue: 0,0:11:36.16,0:11:37.69,Default,,0,0,0,,Согабе бойынша-
Dialogue: 0,0:11:37.89,0:11:41.90,Default,,0,0,0,,Мен Пентагон жігіттері заттарды қарап жатқанын естідім.
Dialogue: 0,0:11:42.33,0:11:44.37,Default,,0,0,0,,Сот отырысы аяқталды...
Dialogue: 0,0:11:45.00,0:11:48.10,Default,,0,0,0,,Менен күдіктенетін ештеңе жоқ.
Dialogue: 0,0:11:50.91,0:11:54.01,Default,,0,0,0,,Доктор Огураның заттарын полиция тексерді...
Dialogue: 0,0:11:54.11,0:11:55.71,Default,,0,0,0,,Осы жерге көшірілді
Dialogue: 0,0:11:56.98,0:12:00.48,Default,,0,0,0,,Тасымалдау кезіндегі тексеру тізімі бұрын берілгендей.
Dialogue: 0,0:12:01.25,0:12:03.08,Default,,0,0,0,,Растау үшін уақыт бөліңіз.
Dialogue: 0,0:12:17.40,0:12:18.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:18.50,0:12:21.10,Default,,0,0,0,,Мәселе жоқ. Артында қалған барлық заттар сонда...
Dialogue: 0,0:12:21.17,0:12:24.17,Default,,0,0,0,,Әдеттегідей сіздің бақылау дағдыларыңыз нөлге тең.
Dialogue: 0,0:12:24.31,0:12:25.07,Default,,0,0,0,,Ха...
Dialogue: 0,0:12:31.11,0:12:32.25,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:12:32.88,0:12:36.25,Default,,0,0,0,,Бұл жерде болуы керек нәрсе әйтеуір жетіспейді.
Dialogue: 0,0:12:39.89,0:12:41.09,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:12:41.79,0:12:44.09,Default,,0,0,0,,Бұл жағдайда сіз қалай...
Dialogue: 0,0:12:44.19,0:12:45.33,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:12:46.09,0:12:50.33,Default,,0,0,0,,Министрден ала алмасаңыз, жақын адамыңыздың артынан барыңыз.
Dialogue: 0,0:12:50.83,0:12:53.23,Default,,0,0,0,,Кесте бұрын жіберілген.
Dialogue: 0,0:12:53.47,0:12:55.87,Default,,0,0,0,,Иә, бұл әлі Аджин ғылыми-зерттеу институты.
Dialogue: 0,0:12:56.14,0:12:57.17,Default,,0,0,0,,Материалдарды жинап болған соң...
Dialogue: 0,0:12:57.24,0:13:00.77,Default,,0,0,0,,Министрдің хатшысы қазір жаңа заң жобасының материалдарын зерттеп жатыр.
Dialogue: 0,0:13:01.81,0:13:03.88,Default,,0,0,0,,Мен де есеп беруім керек.
Dialogue: 0,0:13:07.28,0:13:09.95,Default,,0,0,0,,Сіздің кестеңізді ұрлау мүмкіндігін пайдалану
Dialogue: 0,0:13:10.08,0:13:10.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:11.52,0:13:13.32,Default,,0,0,0,,Бұл...? (Тозаки) Жадты тану және...
Dialogue: 0,0:13:13.39,0:13:16.16,Default,,0,0,0,,Деректер қозғалысын автоматты түрде орындау үшін шамамен 10 секунд
Dialogue: 0,0:13:16.96,0:13:18.79,Default,,0,0,0,,Тек осы уақыт ішінде сізге назар аударылады.
Dialogue: 0,0:13:18.93,0:13:19.86,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:13:20.03,0:13:22.83,Default,,0,0,0,,IBM сізге жұмысыңызды бере алады.
Dialogue: 0,0:13:29.80,0:13:31.37,Default,,0,0,0,,Кешіріңіз, бірақ кейінірек мені тастап кете аласыз ба?
Dialogue: 0,0:13:31.91,0:13:35.21,Default,,0,0,0,,Кешіріңіз, Тозаки мырза мені шұғыл тексеруді сұрады...
Dialogue: 0,0:13:35.84,0:13:41.18,Default,,0,0,0,,Күрсін... Деми-адамдардың кесірінен мен көп ақымақ жұмыс істеуім керек.
Dialogue: 0,0:13:43.05,0:13:45.29,Default,,0,0,0,,Tsk, маған деректерді беріңіз ...
Dialogue: 0,0:13:47.22,0:13:49.16,Default,,0,0,0,,Куро-чан өтінемін
Dialogue: 0,0:13:55.36,0:13:59.13,Default,,0,0,0,,Бұл жақсы емес пе? Мен министрге беремін.
Dialogue: 0,0:14:00.33,0:14:01.60,Default,,0,0,0,,(Исуми Миямура) Ишикава-кун, сенде абсурдтай көп зат бар, иә?
Dialogue: 0,0:14:02.37,0:14:03.27,Default,,0,0,0,,Не?
Dialogue: 0,0:14:03.60,0:14:06.14,Default,,0,0,0,,Э-э…
Dialogue: 0,0:14:11.25,0:14:15.52,Default,,0,0,0,,Бұл сағат жақсы. Саған жақсы жарасады.
Dialogue: 0,0:14:17.05,0:14:19.85,Default,,0,0,0,,О, түсіндің бе?
Dialogue: 0,0:14:20.05,0:14:23.02,Default,,0,0,0,,Шындығында, бұл бірегей антикварлық бұйым.
Dialogue: 0,0:14:23.49,0:14:25.09,Default,,0,0,0,,Ой, иә
Dialogue: 0,0:14:29.96,0:14:31.57,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:14:46.98,0:14:50.42,Default,,0,0,0,,Бұл костюм де минималды, бірақ бұл жоғары деңгейлі бренд.
Dialogue: 0,0:14:50.89,0:14:54.32,Default,,0,0,0,,Өкшесі жоғары сән және өте қымбат болды.
Dialogue: 0,0:14:55.06,0:14:56.99,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,0:14:59.23,0:15:01.16,Default,,0,0,0,,Қаласаңыз, мен сізге дүкен туралы айта аламын.
Dialogue: 0,0:15:01.63,0:15:06.27,Default,,0,0,0,,Ах, рахмет. Тағы бір мүмкіндігім болса...
Dialogue: 0,0:15:07.50,0:15:08.50,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:15:08.97,0:15:09.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:11.11,0:15:12.17,Default,,0,0,0,,Жоқ, мен қалағаным осы емес…
Dialogue: 0,0:15:12.97,0:15:14.61,Default,,0,0,0,,Сіз Тозаки мырзамен кездесесіз бе?
Dialogue: 0,0:15:14.98,0:15:15.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:15.61,0:15:17.44,Default,,0,0,0,,Біз әрқашан бірге боламыз...
Dialogue: 0,0:15:17.54,0:15:20.18,Default,,0,0,0,,Оның бұйырғанын тыңдайсың, солай ма?
Dialogue: 0,0:15:21.02,0:15:24.42,Default,,0,0,0,,Мен өз жұмысымды ғана істеймін... (хатшы) Шынымды айтсам...
Dialogue: 0,0:15:24.65,0:15:26.22,Default,,0,0,0,,Дәмі нашар ма?
Dialogue: 0,0:15:49.41,0:15:51.48,Default,,0,0,0,,Негізінде елесті қалқан ретінде пайдаланып, кері ату.
Dialogue: 0,0:15:55.58,0:15:57.18,Default,,0,0,0,,Ууу!
Dialogue: 0,0:15:59.99,0:16:02.22,Default,,0,0,0,,Сато мырзаны қорғау стратегияның басты басымдығы болып табылады.
Dialogue: 0,0:16:02.46,0:16:04.19,Default,,0,0,0,,Оны тапқан бойда бейтараптандыруды мақсат ет!
Dialogue: 0,0:16:04.26,0:16:05.23,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:16:06.13,0:16:07.46,Default,,0,0,0,,Менің спорттық жүйкемді кінәламаңыз!
Dialogue: 0,0:16:07.53,0:16:08.60,Default,,0,0,0,,Бұл әдейі.
Dialogue: 0,0:16:08.66,0:16:09.73,Default,,0,0,0,,Пайдасыз! Пайдасыз! Пайдасыз! Пайдасыз! Ах!
Dialogue: 0,0:16:11.60,0:16:13.33,Default,,0,0,0,,Хмм... неге мен...
Dialogue: 0,0:16:14.17,0:16:15.50,Default,,0,0,0,,Бұл Сато...
Dialogue: 0,0:16:18.21,0:16:19.37,Default,,0,0,0,,Жазба жаңартылды
Dialogue: 0,0:16:22.54,0:16:26.38,Default,,0,0,0,,Енді бізге Тозаки-санның хабарласуын күту керек.
Dialogue: 0,0:16:38.06,0:16:40.63,Default,,0,0,0,,Иа... бүгін түн...
Dialogue: 0,0:16:48.20,0:16:51.21,Default,,0,0,0,,Шимомура не істеп жатыр?
Dialogue: 0,0:16:53.17,0:16:54.11,Default,,0,0,0,,(терезені қағу)
Dialogue: 0,0:17:00.15,0:17:04.15,Default,,0,0,0,,Бұл не үшін? Тыңдау осы уақытқа дейін аяқталуы керек еді.
Dialogue: 0,0:17:04.62,0:17:07.72,Default,,0,0,0,,Шындығында, мені қызықтыратын соңғы бір нәрсе бар.
Dialogue: 0,0:17:08.52,0:17:10.42,Default,,0,0,0,,Доктор Огураның заттарында...
Dialogue: 0,0:17:10.49,0:17:13.59,Default,,0,0,0,,Мен қандай да бір себептермен ол жерде болуы керек нәрсені таба алмаймын.
Dialogue: 0,0:17:13.73,0:17:14.73,Default,,0,0,0,,Қалдықтар?
Dialogue: 0,0:17:15.03,0:17:19.33,Default,,0,0,0,,Мүмкін біреу оны жадтан шығарып алған шығар.
Dialogue: 0,0:17:19.73,0:17:23.20,Default,,0,0,0,,Оны доктор Огураның көлігінде қалдыру керек еді.
Dialogue: 0,0:17:23.64,0:17:24.61,Default,,0,0,0,,Бұл.
Dialogue: 0,0:17:25.11,0:17:25.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:26.11,0:17:28.41,Default,,0,0,0,,Эй, сен қалай ойлайсың?
Dialogue: 0,0:17:29.28,0:17:30.81,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбеймін...
Dialogue: 0,0:17:31.55,0:17:34.58,Default,,0,0,0,,Егер бұл жауап алу болса, мен олардың ресми процедураларды орындағанын қалаймын.
Dialogue: 0,0:17:34.82,0:17:35.58,Default,,0,0,0,,Хмм…
Dialogue: 0,0:17:36.55,0:17:39.62,Default,,0,0,0,,Иә, дұрыс айтасыз.
Dialogue: 0,0:17:40.42,0:17:43.22,Default,,0,0,0,,Мен де бос емеспін, міне...
Dialogue: 0,0:17:46.29,0:17:47.26,Default,,0,0,0,,(шприцтің шаншу дыбысы)
Dialogue: 0,0:17:47.33,0:17:48.06,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:51.50,0:17:55.10,Default,,0,0,0,,Мен жапондық стильдегі қиын процедуралардан шаршадым.
Dialogue: 0,0:17:55.34,0:17:57.47,Default,,0,0,0,,Мен тез ауызымды ашайын.
Dialogue: 0,0:17:58.37,0:17:59.44,Default,,0,0,0,,Көлікті бұрыңыз
Dialogue: 0,0:18:01.11,0:18:05.28,Default,,0,0,0,,Бұл шынымен жақсы ма? Жапондық мемлекеттік қызметшілер осылай істейді
Dialogue: 0,0:18:05.51,0:18:08.38,Default,,0,0,0,,Мен сіздің пікіріңізді сұрамадым деп айттым деп ойладым ба?
Dialogue: 0,0:18:10.25,0:18:12.59,Default,,0,0,0,,Төтенше жағдайда сіз апатқа ұшырауыңыз керек.
Dialogue: 0,0:18:12.82,0:18:16.32,Default,,0,0,0,,Бұл жер басқаның өліміне немқұрайлы қарайтын адамдарға толы.
Dialogue: 0,0:18:21.66,0:18:22.30,Default,,0,0,0,,Не!
Dialogue: 0,0:18:24.40,0:18:25.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:27.60,0:18:29.74,Default,,0,0,0,,Ол әйел әрқашан менің жанымда болды...
Dialogue: 0,0:18:29.80,0:18:31.74,Default,,0,0,0,,Оған көмектесу мүмкін емес, мені тый.
Dialogue: 0,0:18:34.37,0:18:35.28,Default,,0,0,0,,Мазасыз!
Dialogue: 0,0:18:37.74,0:18:38.88,Default,,0,0,0,,(Деми-адамды тоқтататын дыбыс)
Dialogue: 0,0:18:39.18,0:18:39.71,Default,,0,0,0,,Ех...! ?
Dialogue: 0,0:18:40.58,0:18:42.22,Default,,0,0,0,,Әйтеуір... (Майерс) Бұл әйел!
Dialogue: 0,0:18:43.12,0:18:44.45,Default,,0,0,0,,Бұл әйел жарты адам!
Dialogue: 0,0:18:54.83,0:18:56.80,Default,,0,0,0,,Себебі мен оны жаңа ғана шығардым...
Dialogue: 0,0:19:03.34,0:19:05.67,Default,,0,0,0,,Гррр… аа…
Dialogue: 0,0:19:13.18,0:19:16.65,Default,,0,0,0,,Оның ішкі мүшелерін бұзғаныма бірнеше минут қана болды.
Dialogue: 0,0:19:20.15,0:19:22.66,Default,,0,0,0,,Негізгі дене мен сана арасындағы байланыс үзілсе...
Dialogue: 0,0:19:22.79,0:19:25.23,Default,,0,0,0,,IBM - бұл тек қуыршақ
Dialogue: 0,0:19:25.83,0:19:28.36,Default,,0,0,0,,Бұл жағымсыз дәмнің объектісіне айналмайды.
Dialogue: 0,0:19:34.70,0:19:38.24,Default,,0,0,0,,Бұл жігіт деми-адамдарды да жасырын ұстады ма?
Dialogue: 0,0:19:38.61,0:19:40.84,Default,,0,0,0,,Менде жақсы тәжірибе материалдары көбірек.
Dialogue: 0,0:19:41.78,0:19:46.61,Default,,0,0,0,,Бұл ұят. Кәдімгідей өлсем, қуанар едім.
Dialogue: 0,0:19:47.18,0:19:51.35,Default,,0,0,0,,(Автомобиль стерео дыбысы)
Dialogue: 0,0:19:52.45,0:19:52.95,Default,,0,0,0,,(тілді шертеді)
Dialogue: 0,0:20:10.44,0:20:11.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:11.64,0:20:12.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:12.77,0:20:15.41,Default,,0,0,0,,Келіңіздер! Сізді көргенде қиын болар еді!
Dialogue: 0,0:20:25.52,0:20:26.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:32.86,0:20:34.93,Default,,0,0,0,,Алдымен мына жігітті қатайтыңыз.
Dialogue: 0,0:20:35.33,0:20:36.66,Default,,0,0,0,,Көліктен тез түсіңіз.
Dialogue: 0,0:20:43.64,0:20:47.01,Default,,0,0,0,,Ол әйелді уайымдама...
Dialogue: 0,0:20:48.54,0:20:50.41,Default,,0,0,0,,Мен оны кейінірек қолданамын.
Dialogue: 0,0:20:50.64,0:20:54.48,Default,,0,0,0,,Біз қателіктеріміз үшін толық жауапкершілікті өзімізге алуымыз керек.
Dialogue: 0,0:21:16.87,0:21:18.57,Default,,0,0,0,,Сіздің жұмысыңыз қандай?
Dialogue: 0,0:21:19.31,0:21:20.81,Default,,0,0,0,,Менің жұмысым...
Dialogue: 0,0:21:21.48,0:21:23.01,Default,,0,0,0,,Сізді қорғау үшін
Dialogue: 0,0:21:37.46,0:21:43.56,Default,,0,0,0,,♪Мен одан шаршадым, ауыстырайық♪
Dialogue: 0,0:21:43.76,0:21:48.94,Default,,0,0,0,,♪Сізде бар қалыпты♪
Dialogue: 0,0:21:50.07,0:21:56.38,Default,,0,0,0,,♪Жарқыраған Құдай картасы♪
Dialogue: 0,0:21:56.58,0:22:01.65,Default,,0,0,0,,♪Дұрыс қағаз картасы♪
Dialogue: 0,0:22:02.88,0:22:06.89,Default,,0,0,0,,♪Келесі жолы менің үйіме келесің♪
Dialogue: 0,0:22:09.42,0:22:13.46,Default,,0,0,0,,♪Мен саған бәрін көрсетемін♪
Dialogue: 0,0:22:13.79,0:22:15.60,Default,,0,0,0,,♪Себебі♪
Dialogue: 0,0:22:15.76,0:22:21.94,Default,,0,0,0,,♪Екі адам мектеп ауласының бұрышында, жел соғып тұр♪
Dialogue: 0,0:22:22.00,0:22:25.84,Default,,0,0,0,,♪Қазір айта алар ма екенмін♪
Dialogue: 0,0:22:28.61,0:22:34.45,Default,,0,0,0,,♪Ешкімге айтпайтын сөздер♪
Dialogue: 0,0:22:34.92,0:22:41.02,Default,,0,0,0,,♪«Мен саған жақсы боламын, сондықтан маған қонаққа кел»♪
Dialogue: 0,0:22:41.49,0:22:46.96,Default,,0,0,0,,♪«Мен саған бәрін беремін, эй»♪
Dialogue: 0,0:22:47.79,0:22:57.37,Default,,0,0,0,,♪"Мәңгілік дос болайық"♪
Dialogue: 0,0:22:58.87,0:23:04.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
