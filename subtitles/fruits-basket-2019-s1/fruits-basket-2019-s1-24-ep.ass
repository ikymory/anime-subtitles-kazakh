Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Бұл суицид болса керек.
Dialogue: 0,0:00:06.67,0:00:08.96,Default,,0,0,0,,Мысық босанған бала тумасам...
Dialogue: 0,0:00:09.09,0:00:10.21,Default,,0,0,0,,(Танжиро) Бұған дейін кірген жебелер мені бұрын-соңды болмағандай күшпен тартып жатыр.
Dialogue: 0,0:00:10.34,0:00:12.01,Default,,0,0,0,,Ол тіпті жыламайды.
Dialogue: 0,0:00:12.13,0:00:14.30,Default,,0,0,0,,Өзімді-өзім өлтіруге дейін барсам да
Dialogue: 0,0:00:14.43,0:00:15.89,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:00:16.01,0:00:19.72,Default,,0,0,0,,Бұл менің кінәм емес! Бұл менің кінәм емес!
Dialogue: 0,0:00:20.10,0:00:21.10,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:00:21.23,0:00:24.10,Default,,0,0,0,,Ах! (Ама) Түсіндім.
Dialogue: 0,0:00:25.56,0:00:29.61,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Эйма Сомамын
Dialogue: 0,0:00:31.19,0:00:33.95,Default,,0,0,0,,Бұл менің кінәм емес Бұл менің кінәм емес
Dialogue: 0,0:00:34.07,0:00:36.24,Default,,0,0,0,,Бұл менің кінәм... (Ама) Жарайды.
Dialogue: 0,0:00:37.74,0:00:39.95,Default,,0,0,0,,Жарайды, мен білемін.
Dialogue: 0,0:00:43.62,0:00:44.96,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:49.55,0:00:53.22,Default,,0,0,0,,Кио... Менімен бірге тұрғың келе ме?
Dialogue: 0,0:00:55.43,0:01:00.43,Default,,0,0,0,,♪~
Dialogue: 0,0:02:19.93,0:02:24.93,Default,,0,0,0,,~♪
Dialogue: 0,0:02:27.89,0:02:29.65,Default,,0,0,0,,Сіздің жақсы болғаныңызға қуаныштымын.
Dialogue: 0,0:02:29.77,0:02:31.11,Default,,0,0,0,,Эйшинден
Dialogue: 0,0:02:31.23,0:02:35.57,Default,,0,0,0,,Шиго-кунның да жұмыста жақсы екенін естігеніме қуаныштымын.
Dialogue: 0,0:02:35.69,0:02:38.36,Default,,0,0,0,,Хахаха... Мен қатты абдырап қалдым.
Dialogue: 0,0:02:38.74,0:02:40.57,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:02:40.70,0:02:41.74,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:02:42.62,0:02:43.91,Default,,0,0,0,,Бұл жақсырақ
Dialogue: 0,0:02:44.03,0:02:46.87,Default,,0,0,0,,Киокун менімен бұрын сөйлескен...
Dialogue: 0,0:02:47.00,0:02:48.25,Default,,0,0,0,,Мастер
Dialogue: 0,0:02:48.58,0:02:50.92,Default,,0,0,0,,Тағы да сәлем, біраз болды.
Dialogue: 0,0:02:51.04,0:02:53.88,Default,,0,0,0,,Аа, біраз уақыт болды, Ракура.
Dialogue: 0,0:02:54.00,0:02:55.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:55.38,0:02:57.97,Default,,0,0,0,,Көп уақыт өтті...
Dialogue: 0,0:02:58.55,0:02:59.88,Default,,0,0,0,,Мастер
Dialogue: 0,0:03:00.51,0:03:04.51,Default,,0,0,0,,Бойың өсті, аздап үлкейдің.
Dialogue: 0,0:03:04.81,0:03:05.93,Default,,0,0,0,,Юки
Dialogue: 0,0:03:07.56,0:03:08.81,Default,,0,0,0,,Тоору-кун
Dialogue: 0,0:03:09.06,0:03:11.81,Default,,0,0,0,,Бұл адам Сума Сеншин-доно.
Dialogue: 0,0:03:11.94,0:03:13.98,Default,,0,0,0,,Кио-кунның шеберімен бір уақытта
Dialogue: 0,0:03:14.11,0:03:16.15,Default,,0,0,0,,Юкиге, Ракураға, Ха-кунға және т.б.
Dialogue: 0,0:03:16.28,0:03:18.86,Default,,0,0,0,,Ол маған жекпе-жек өнерін үйреткен мұғалім.
Dialogue: 0,0:03:18.99,0:03:21.57,Default,,0,0,0,,А... Солай ма?
Dialogue: 0,0:03:21.95,0:03:25.03,Default,,0,0,0,,Мен сені Тору-сан десем болады ма?
Dialogue: 0,0:03:25.16,0:03:26.70,Default,,0,0,0,,Ах, ха... ха, иә!
Dialogue: 0,0:03:26.83,0:03:29.20,Default,,0,0,0,,Танысқаныма қуаныштымын. Мен Тоору Хондамын.
Dialogue: 0,0:03:29.91,0:03:31.87,Default,,0,0,0,,（）
Dialogue: 0,0:03:32.37,0:03:34.54,Default,,0,0,0,,Зодиак туралы да білетін шығарсыз.
Dialogue: 0,0:03:34.67,0:03:36.30,Default,,0,0,0,,Өрмектей өрілген тағдырлар
Dialogue: 0,0:03:37.13,0:03:38.46,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:38.92,0:03:40.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:40.17,0:03:41.18,Default,,0,0,0,,Кио-кун
Dialogue: 0,0:03:41.68,0:03:44.93,Default,,0,0,0,,Неге осылай тұра бермей, сәлем бермейсің?
Dialogue: 0,0:03:45.05,0:03:47.43,Default,,0,0,0,,Өткен жылы тауға барғаннан бері не істедің?
Dialogue: 0,0:03:47.85,0:03:50.31,Default,,0,0,0,,Сізді тағы көргеніме қуанышты емессіз бе?
Dialogue: 0,0:03:50.43,0:03:51.69,Default,,0,0,0,,Лейденшафтличтің солтүстік-шығысында—
Dialogue: 0,0:03:55.40,0:03:56.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:56.86,0:03:58.94,Default,,0,0,0,,А... Кио-кун?
Dialogue: 0,0:04:01.24,0:04:03.20,Default,,0,0,0,,Кионың жеке бөлмесі қайсы?
Dialogue: 0,0:04:03.32,0:04:04.41,Default,,0,0,0,,5 йен
Dialogue: 0,0:04:04.53,0:04:06.33,Default,,0,0,0,,Баспалдақпен көтеріліп, оң жақтағы бөлмеге...
Dialogue: 0,0:04:06.66,0:04:08.04,Default,,0,0,0,,Аа, маған жол көрсетіңізші...
Dialogue: 0,0:04:08.16,0:04:11.12,Default,,0,0,0,,Жоқ, сіз соншалықты көп білетін болсаңыз, бәрі жақсы.
Dialogue: 0,0:04:13.17,0:04:14.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:15.54,0:04:16.88,Default,,0,0,0,,(Ракура мен Шигоның күлкісі)
Dialogue: 0,0:04:17.34,0:04:19.59,Default,,0,0,0,,Солай сияқты (Ракура) Шынымен де
Dialogue: 0,0:04:19.71,0:04:21.67,Default,,0,0,0,,Қандай «көрінетін»?
Dialogue: 0,0:04:21.80,0:04:23.34,Default,,0,0,0,,Хехе, көрдіңіз бе.
Dialogue: 0,0:04:23.47,0:04:26.10,Default,,0,0,0,,Кио-кун, мен шынымен бақыттымын.
Dialogue: 0,0:04:26.22,0:04:29.14,Default,,0,0,0,,Сізді бұлай көргенімізді қаламайсыз.
Dialogue: 0,0:04:29.27,0:04:32.10,Default,,0,0,0,,Әсіресе Юн Чанның алдында.
Dialogue: 0,0:04:35.77,0:04:37.69,Default,,0,0,0,,Мен кіремін.
Dialogue: 0,0:04:37.82,0:04:39.07,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:04:39.19,0:04:41.19,Default,,0,0,0,,Ұстаз, кешіріңіз.
Dialogue: 0,0:04:41.78,0:04:43.32,Default,,0,0,0,,Жаман көзқарас
Dialogue: 0,0:04:43.70,0:04:46.66,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:04:52.33,0:04:53.71,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:04:54.46,0:04:57.00,Default,,0,0,0,,Қош келдіңіз, ұстаз! Хехе...
Dialogue: 0,0:04:58.25,0:04:59.55,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:05:03.42,0:05:05.13,Default,,0,0,0,,Сонымен, ұстаз?
Dialogue: 0,0:05:05.26,0:05:07.39,Default,,0,0,0,,Сіз зодиактардың бірі емессіз бе?
Dialogue: 0,0:05:07.51,0:05:08.51,Default,,0,0,0,,Иә
Dialogue: 0,0:05:09.22,0:05:11.39,Default,,0,0,0,,Бірақ ол бастапқы отбасынан.
Dialogue: 0,0:05:11.52,0:05:12.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:13.43,0:05:15.77,Default,,0,0,0,,Кио-кунға дейін мысықтың жыны бар адам болған.
Dialogue: 0,0:05:16.10,0:05:18.77,Default,,0,0,0,,Шебердің атасы болған.
Dialogue: 0,0:05:19.52,0:05:23.40,Default,,0,0,0,,Демек, Кио-кунның ұстанымын жақсы түсіне алатын адам
Dialogue: 0,0:05:23.53,0:05:25.15,Default,,0,0,0,,Шебер болуы мүмкін
Dialogue: 0,0:05:26.49,0:05:28.12,Default,,0,0,0,,Бірақ одан да көп
Dialogue: 0,0:05:28.24,0:05:32.58,Default,,0,0,0,,Мұғалім Киокунға қатты көңіл бөлгендей болды.
Dialogue: 0,0:05:34.04,0:05:36.54,Default,,0,0,0,,Менің нағыз әкем сияқты
Dialogue: 0,0:05:41.17,0:05:44.30,Default,,0,0,0,,Нағыз... Әке
Dialogue: 0,0:05:47.18,0:05:49.97,Default,,0,0,0,,Осымен магистратураның оқу сапары аяқталды.
Dialogue: 0,0:05:50.47,0:05:51.97,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:52.10,0:05:55.23,Default,,0,0,0,,Доджоны енді ашық қалдыра алмаймыз.
Dialogue: 0,0:05:55.35,0:05:58.60,Default,,0,0,0,,Сонымен... онда мен де дохжоға орала аламын, солай ма?
Dialogue: 0,0:05:59.02,0:06:00.98,Default,,0,0,0,,Мен осылай уәде бердім.
Dialogue: 0,0:06:01.77,0:06:02.78,Default,,0,0,0,,Сіз...
Dialogue: 0,0:06:03.57,0:06:05.65,Default,,0,0,0,,Мен осында тұрамын...
Dialogue: 0,0:06:05.94,0:06:09.03,Default,,0,0,0,,Не, сен уәдеңді бұзасың ба?
Dialogue: 0,0:06:09.16,0:06:11.03,Default,,0,0,0,,Қожа да Акитодан қорқа ма?
Dialogue: 0,0:06:11.16,0:06:12.16,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:06:13.12,0:06:17.41,Default,,0,0,0,,Бұл сіз үшін ең жақсы орта екенін анықтадық.
Dialogue: 0,0:06:18.29,0:06:22.46,Default,,0,0,0,,Кездейсоқтықтан ба, әлде қажеттіліктен бе, сол қызбен бірге тұрып қалдым.
Dialogue: 0,0:06:23.34,0:06:26.01,Default,,0,0,0,,Егер бұл сізге ем болса...
Dialogue: 0,0:06:26.13,0:06:27.13,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:06:28.34,0:06:30.51,Default,,0,0,0,,Маған бұл жер ұнамайды.
Dialogue: 0,0:06:31.26,0:06:34.97,Default,,0,0,0,,Жылы судай, дымқылданып бара жатқандай.
Dialogue: 0,0:06:35.56,0:06:38.27,Default,,0,0,0,,Кейде... кейде өте
Dialogue: 0,0:06:39.60,0:06:41.52,Default,,0,0,0,,Мен енді шыдай алмаймын
Dialogue: 0,0:06:43.19,0:06:46.82,Default,,0,0,0,,Менің емделгім келмейді.
Dialogue: 0,0:06:48.61,0:06:50.28,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:06:53.03,0:06:54.58,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:06:56.45,0:06:58.41,Default,,0,0,0,,Бұл маған ұнамайды...
Dialogue: 0,0:07:01.96,0:07:04.71,Default,,0,0,0,,Ұстаз, сіз бүгін түнде боласыз ба?
Dialogue: 0,0:07:05.05,0:07:06.88,Default,,0,0,0,,Мен де түнеп жатырмын.
Dialogue: 0,0:07:07.01,0:07:08.55,Default,,0,0,0,,Бұл не? Үйге бар.
Dialogue: 0,0:07:08.84,0:07:09.84,Default,,0,0,0,,Иә~
Dialogue: 0,0:07:09.97,0:07:13.05,Default,,0,0,0,,Мен қожайынның футонын қайда қоюым керек?
Dialogue: 0,0:07:13.18,0:07:15.06,Default,,0,0,0,,Бұл Шигуре мырзаның бөлмесі ме?
Dialogue: 0,0:07:16.18,0:07:17.77,Default,,0,0,0,,Бұлай етпе!
Dialogue: 0,0:07:17.89,0:07:18.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:19.23,0:07:22.15,Default,,0,0,0,,Кёкунның бөлмесі ең жақсысы емес пе?
Dialogue: 0,0:07:22.27,0:07:25.27,Default,,0,0,0,,Иә? Осы жерде ұйықтауға рұқсат етпесең... (Ракура) Мен сенен бірдеңе сұрайын.
Dialogue: 0,0:07:25.40,0:07:26.23,Default,,0,0,0,,Эй!
Dialogue: 0,0:07:26.73,0:07:29.45,Default,,0,0,0,,Кио-кунның да айтатын әңгімелері көп, солай ма?
Dialogue: 0,0:07:29.57,0:07:30.70,Default,,0,0,0,,Эй
Dialogue: 0,0:07:30.82,0:07:32.11,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:07:32.45,0:07:35.95,Default,,0,0,0,,Мүмкін болса, бір күні Кио-кун мен Мастер
Dialogue: 0,0:07:36.08,0:07:39.58,Default,,0,0,0,,Мен қолды туралау деп аталатын нәрсені көргім келеді.
Dialogue: 0,0:07:40.54,0:07:44.42,Default,,0,0,0,,Мұғалімнің футоны Мұғалімнің футоны
Dialogue: 0,0:07:44.54,0:07:45.84,Default,,0,0,0,,Бүгін түнде (Ракура) иә?
Dialogue: 0,0:07:46.34,0:07:49.67,Default,,0,0,0,,Оны алып тастасаңыз, ол қатты шу шығаруы мүмкін...
Dialogue: 0,0:07:50.42,0:07:52.68,Default,,0,0,0,,Ең алдымен кешірім сұраймын.
Dialogue: 0,0:07:52.80,0:07:54.34,Default,,0,0,0,,Бұл да...
Dialogue: 0,0:07:54.97,0:07:58.14,Default,,0,0,0,,Неліктен кенеттен мұндай шешім қабылдадыңыз?
Dialogue: 0,0:07:58.27,0:07:59.27,Default,,0,0,0,,Бүгін...
Dialogue: 0,0:08:00.85,0:08:02.94,Default,,0,0,0,,Сол баланың жүзіне қараңыз.
Dialogue: 0,0:08:03.65,0:08:06.82,Default,,0,0,0,,Мүмкін ол баланың жүрегін аша алар ма еді...
Dialogue: 0,0:08:07.77,0:08:11.03,Default,,0,0,0,,Мүмкін ол тағы да қабылдайтын шығар...
Dialogue: 0,0:08:12.45,0:08:17.12,Default,,0,0,0,,Білудің ең жақсы уақыты
Dialogue: 0,0:08:17.24,0:08:19.37,Default,,0,0,0,,Менің ойымша, бұл қазір немесе ешқашан.
Dialogue: 0,0:08:20.87,0:08:24.21,Default,,0,0,0,,Сен оған бәрін сеніп тапсырасың ба?
Dialogue: 0,0:08:24.33,0:08:25.75,Default,,0,0,0,,Сізге дейін...
Dialogue: 0,0:08:27.25,0:08:30.92,Default,,0,0,0,,Бірақ табысқа кепілдік жоқ, солай ма?
Dialogue: 0,0:08:31.05,0:08:33.18,Default,,0,0,0,,Тіпті ол қабылдаса да
Dialogue: 0,0:08:33.30,0:08:37.05,Default,,0,0,0,,Кионың бас тарту ықтималдығы жоғары.
Dialogue: 0,0:08:37.47,0:08:38.81,Default,,0,0,0,,Бұл алаңдатады.
Dialogue: 0,0:08:39.35,0:08:41.48,Default,,0,0,0,,Кионың сыну мүмкіндігі
Dialogue: 0,0:08:43.19,0:08:45.06,Default,,0,0,0,,Мен сені тіпті жек көремін
Dialogue: 0,0:08:45.19,0:08:48.11,Default,,0,0,0,,Мүмкін сен енді маған күлмейтін шығарсың
Dialogue: 0,0:08:49.44,0:08:53.45,Default,,0,0,0,,Сонда да бір мүмкіндікті пайдаланасыз ба?
Dialogue: 0,0:08:54.45,0:08:56.28,Default,,0,0,0,,Ой, бұл не?
Dialogue: 0,0:08:56.78,0:08:58.70,Default,,0,0,0,,Бұл қалай болуы мүмкін?
Dialogue: 0,0:08:58.83,0:09:01.37,Default,,0,0,0,,Шебер шынымен де мұндай нәрселерді жасай алмайды.
Dialogue: 0,0:09:01.83,0:09:02.91,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:03.04,0:09:06.17,Default,,0,0,0,,Менің әлі де дайындығым жоқ деген сөз.
Dialogue: 0,0:09:06.29,0:09:08.67,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:09:08.88,0:09:10.09,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:09:12.51,0:09:14.68,Default,,0,0,0,,Сонда да мен оны ставкаға алғым келеді.
Dialogue: 0,0:09:16.22,0:09:17.47,Default,,0,0,0,,Оған
Dialogue: 0,0:09:20.01,0:09:21.01,Default,,0,0,0,,Бүгін түнде...
Dialogue: 0,0:09:22.18,0:09:24.02,Default,,0,0,0,,Маған біраз уақыт бере аласыз ба?
Dialogue: 0,0:09:24.31,0:09:26.90,Default,,0,0,0,,Не? Иә...
Dialogue: 0,0:09:28.44,0:09:29.82,Default,,0,0,0,,Ұстаз, келіңіз...
Dialogue: 0,0:09:30.48,0:09:33.69,Default,,0,0,0,,Сыртта сөйлесудің қажеті жоқ, солай ма?
Dialogue: 0,0:09:33.82,0:09:37.07,Default,,0,0,0,,Мұндай күндердің әсіресе жаман екенін білсем де.
Dialogue: 0,0:09:37.49,0:09:39.91,Default,,0,0,0,,Менің атам да солай болған.
Dialogue: 0,0:09:40.03,0:09:43.54,Default,,0,0,0,,Жаңбырлы күндері жиі ауыратын сияқты.
Dialogue: 0,0:09:44.29,0:09:45.58,Default,,0,0,0,,Мысық иеленгендіктен бе?
Dialogue: 0,0:09:47.21,0:09:51.04,Default,,0,0,0,,Мононоке өзінің «түпнұсқа түрінде» Мүмкін ол жаңбырды жек көретіндіктен шығар...
Dialogue: 0,0:09:52.67,0:09:55.30,Default,,0,0,0,,Түпнұсқа пішін туралы айтатын кез келді.
Dialogue: 0,0:09:55.42,0:09:58.14,Default,,0,0,0,,Дұрыс қабылдасаң, алға жылжи алмайсың.
Dialogue: 0,0:09:58.26,0:09:59.39,Default,,0,0,0,,Мен оны қабылдаймын!
Dialogue: 0,0:10:04.77,0:10:06.14,Default,,0,0,0,,Менің өмірім...
Dialogue: 0,0:10:07.23,0:10:11.40,Default,,0,0,0,,«Мысық иесі болып туылған сәтте бәрі бітті» дейді.
Dialogue: 0,0:10:12.65,0:10:17.32,Default,,0,0,0,,Бұл тінтуірдің кесірінен...
Dialogue: 0,0:10:18.24,0:10:21.33,Default,,0,0,0,,Сол жігіт ең алдымен кінәлі.
Dialogue: 0,0:10:22.41,0:10:23.62,Default,,0,0,0,,Бұл оның кінәсі!
Dialogue: 0,0:10:23.91,0:10:27.87,Default,,0,0,0,,Бұл оның кінәсі. Оны өлтір, мен де өлемін!
Dialogue: 0,0:10:28.33,0:10:30.13,Default,,0,0,0,,Сонда сіз қанағаттанасыз!
Dialogue: 0,0:10:30.42,0:10:34.05,Default,,0,0,0,,Мен де өлсем, көңілің тояды!
Dialogue: 0,0:10:37.84,0:10:39.64,Default,,0,0,0,,Ештеңе өзгерген жоқ...
Dialogue: 0,0:10:40.51,0:10:44.22,Default,,0,0,0,,Сен осылай өмір сүре бересің бе?
Dialogue: 0,0:10:45.64,0:10:48.81,Default,,0,0,0,,Құлағыңызды жауып, көзіңізді жұмыңыз
Dialogue: 0,0:10:49.90,0:10:53.57,Default,,0,0,0,,Юкиді жек көру бәрін қамтиды...
Dialogue: 0,0:10:54.57,0:10:58.70,Default,,0,0,0,,Өзіңізді қорғаудың жалғыз жолы осы ма?
Dialogue: 0,0:10:59.57,0:11:03.53,Default,,0,0,0,,Ал... және өлесің бе?
Dialogue: 0,0:11:05.04,0:11:06.62,Default,,0,0,0,,Бір ғана адам...
Dialogue: 0,0:11:08.54,0:11:10.21,Default,,0,0,0,,Менің атам сияқты
Dialogue: 0,0:11:12.33,0:11:15.71,Default,,0,0,0,,Сіз бұл жерді ұнатпаймын дедіңіз.
Dialogue: 0,0:11:16.21,0:11:19.84,Default,,0,0,0,,Бірақ жоқ, сіз жай ғана қашуға тырысып жатырсыз.
Dialogue: 0,0:11:19.97,0:11:21.09,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:21.22,0:11:25.97,Default,,0,0,0,,Жылы су деп атайтын жылы су бізді емдейтінін сеземін.
Dialogue: 0,0:11:26.43,0:11:28.73,Default,,0,0,0,,Бірақ шындық...
Dialogue: 0,0:11:28.85,0:11:31.14,Default,,0,0,0,,Мен өзімнің шынайы келбетімнің белгілі болғанын қаламаймын
Dialogue: 0,0:11:31.77,0:11:33.77,Default,,0,0,0,,Танылып қалудан және оны жоғалтып алудан қорқамын.
Dialogue: 0,0:11:34.31,0:11:36.23,Default,,0,0,0,,Сол түсініксіз жағдайдан
Dialogue: 0,0:11:36.36,0:11:38.40,Default,,0,0,0,,Сіз жай ғана қашуға тырысып жатырсыз.
Dialogue: 0,0:11:38.53,0:11:39.53,Default,,0,0,0,,… （）
Dialogue: 0,0:11:40.61,0:11:43.62,Default,,0,0,0,,Олай болса мен қашудың қолын аламын.
Dialogue: 0,0:11:43.74,0:11:45.49,Default,,0,0,0,,Жоғалту немесе жоғалтпау?
Dialogue: 0,0:11:46.08,0:11:48.29,Default,,0,0,0,,Нәтижені шығарайық
Dialogue: 0,0:11:48.41,0:11:51.50,Default,,0,0,0,,…
Dialogue: 0,0:11:53.08,0:11:55.88,Default,,0,0,0,,Бұл дайын зат па?
Dialogue: 0,0:12:02.76,0:12:04.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:05.26,0:12:07.76,Default,,0,0,0,,Себебі мен сені жақсы көремін
Dialogue: 0,0:12:08.56,0:12:10.81,Default,,0,0,0,,Сондықтан мен оны ешкімге көрсетпеймін
Dialogue: 0,0:12:11.77,0:12:14.86,Default,,0,0,0,,Баламды ешкімге көрсетпе
Dialogue: 0,0:12:16.15,0:12:17.82,Default,,0,0,0,,Қарама
Dialogue: 0,0:12:18.40,0:12:20.11,Default,,0,0,0,,Қарама
Dialogue: 0,0:12:20.49,0:12:21.49,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:12:21.95,0:12:22.95,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:23.07,0:12:27.08,Default,,0,0,0,,Қарама!
Dialogue: 0,0:12:31.41,0:12:35.25,Default,,0,0,0,,Бұл Кионың шынайы түрі ме?
Dialogue: 0,0:12:36.08,0:12:39.30,Default,,0,0,0,,Уф Угаааа
Dialogue: 0,0:12:40.13,0:12:42.26,Default,,0,0,0,,Ааа...
Dialogue: 0,0:12:42.97,0:12:45.59,Default,,0,0,0,,Сіздің денеңіз ұсқынсыз, мыжылған ба?
Dialogue: 0,0:12:46.09,0:12:50.22,Default,,0,0,0,,Ух... аааа!
Dialogue: 0,0:12:46.51,0:12:50.22,Default,,0,0,0,,Ал не? Қандай қорқынышты иіс?
Dialogue: 0,0:12:51.02,0:12:53.39,Default,,0,0,0,,Шіріген нәрсенің иісі шығады.
Dialogue: 0,0:12:55.40,0:12:58.82,Default,,0,0,0,,Бұл мысық Мононоке...
Dialogue: 0,0:12:59.44,0:13:01.53,Default,,0,0,0,,Бастапқы пішін?
Dialogue: 0,0:13:08.41,0:13:11.20,Default,,0,0,0,,Кью...кун?
Dialogue: 0,0:13:13.04,0:13:14.25,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:13:14.37,0:13:15.12,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:24.59,0:13:25.63,Default,,0,0,0,,Көрінді...
Dialogue: 0,0:13:25.76,0:13:27.22,Default,,0,0,0,,Көрінген Көрген...
Dialogue: 0,0:13:28.14,0:13:30.43,Default,,0,0,0,,Бітті... Бәрі бітті
Dialogue: 0,0:13:31.89,0:13:33.02,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:13:34.43,0:13:35.60,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:13:38.40,0:13:39.69,Default,,0,0,0,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
Dialogue: 0,0:13:39.81,0:13:44.28,Default,,0,0,0,,Бұл мысық иеленген Кио жасырған тағы бір фигура.
Dialogue: 0,0:13:45.45,0:13:48.24,Default,,0,0,0,,Бұл қорқынышты... жаман болды ма?
Dialogue: 0,0:13:49.82,0:13:52.58,Default,,0,0,0,,Сізге қорқынышты болды ма?
Dialogue: 0,0:13:53.12,0:13:54.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:11.60,0:14:15.60,Default,,0,0,0,,Сіз мені емдей аласыз ба?
Dialogue: 0,0:14:17.98,0:14:20.69,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:14:20.81,0:14:22.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:27.57,0:14:30.95,Default,,0,0,0,,Хаха...
Dialogue: 0,0:14:31.07,0:14:33.16,Default,,0,0,0,,Уф! Иә...
Dialogue: 0,0:14:33.83,0:14:36.04,Default,,0,0,0,,А... ой...
Dialogue: 0,0:14:36.54,0:14:40.00,Default,,0,0,0,,Ух... ха ха...
Dialogue: 0,0:14:40.46,0:14:44.50,Default,,0,0,0,,Мен иіскемеген иіс, Көрмеген мүсін
Dialogue: 0,0:14:45.84,0:14:47.05,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:48.01,0:14:50.64,Default,,0,0,0,,Кио-кунның басқа түрі
Dialogue: 0,0:14:51.60,0:14:56.98,Default,,0,0,0,,(Торудың дауысы)
Dialogue: 0,0:14:57.35,0:14:59.85,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:14:59.98,0:15:01.48,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:15:02.31,0:15:06.23,Default,,0,0,0,,Мен шынымен не істеуім керек...білмеймін.
Dialogue: 0,0:15:07.57,0:15:08.70,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:09.36,0:15:10.57,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:15:24.67,0:15:25.75,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:26.84,0:15:28.76,Default,,0,0,0,,Тағы бірдеңе болды ма?
Dialogue: 0,0:15:30.51,0:15:31.51,Default,,0,0,0,,…
Dialogue: 0,0:15:31.89,0:15:34.76,Default,,0,0,0,,Акито бірдеңе деді ме?
Dialogue: 0,0:15:35.72,0:15:39.27,Default,,0,0,0,,Жарайды, мен сені...
Dialogue: 0,0:15:38.81,0:15:40.23,Default,,0,0,0,,Суда шын мәнінде өз мүмкіндігін көрсететін техникалар бар!
Dialogue: 0,0:15:39.81,0:15:41.14,Default,,0,0,0,,Себебі мен сені жақсы көремін
Dialogue: 0,0:15:41.39,0:15:43.40,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:15:52.03,0:15:54.70,Default,,0,0,0,,Бұл көп... қазірдің өзінде...
Dialogue: 0,0:15:56.70,0:15:57.70,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:02.21,0:16:03.33,Default,,0,0,0,,Kyou…kun
Dialogue: 0,0:16:03.46,0:16:04.38,Default,,0,0,0,,Жақын келме!
Dialogue: 0,0:16:05.34,0:16:08.51,Default,,0,0,0,,Не... не істеп жатырсың?
Dialogue: 0,0:16:08.63,0:16:11.13,Default,,0,0,0,,Менің артымнан жүр, не істеп жатырсың?
Dialogue: 0,0:16:11.68,0:16:13.97,Default,,0,0,0,,Кио-кун (Кё) тоқтайды!
Dialogue: 0,0:16:14.26,0:16:16.01,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:16:16.14,0:16:18.93,Default,,0,0,0,,Сіз көре аласыз ба? Сізде жақсы мұрын бар ма?
Dialogue: 0,0:16:19.06,0:16:22.39,Default,,0,0,0,,Бұл жеңіл сезінеді, солай емес пе? Бұл жақсы сезінеді.
Dialogue: 0,0:16:22.52,0:16:25.19,Default,,0,0,0,,Неге мені жалғыз қалдыра алмайсың?
Dialogue: 0,0:16:25.31,0:16:28.11,Default,,0,0,0,,Өкінішті емес, кешіріңіз.
Dialogue: 0,0:16:29.03,0:16:32.24,Default,,0,0,0,,Өтінемін... Өтінемін, енді жоқ...
Dialogue: 0,0:16:32.86,0:16:34.16,Default,,0,0,0,,Кио-кун
Dialogue: 0,0:16:34.49,0:16:36.49,Default,,0,0,0,,Бірақ, бірақ мен...
Dialogue: 0,0:16:37.16,0:16:38.49,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:38.62,0:16:41.29,Default,,0,0,0,,Қарғыс атсын! Оған тиме!
Dialogue: 0,0:16:44.08,0:16:45.21,Default,,0,0,0,,Жоғал
Dialogue: 0,0:16:51.92,0:16:53.26,Default,,0,0,0,,(Торудың жөтелі)
Dialogue: 0,0:16:53.38,0:16:55.72,Default,,0,0,0,,Жігерсіз, көзді ашады!
Dialogue: 0,0:16:56.59,0:16:59.14,Default,,0,0,0,,Келесі жолы мен бұл бетті кесіп тастаймын!
Dialogue: 0,0:16:59.64,0:17:01.06,Default,,0,0,0,,Жоғал
Dialogue: 0,0:17:18.16,0:17:20.20,Default,,0,0,0,,Егер мен оны жоғалтып алсам...
Dialogue: 0,0:17:22.54,0:17:27.33,Default,,0,0,0,,Мен сені ренжітіп, құрдымға жіберемін, енді қолыңнан келмейді.
Dialogue: 0,0:17:28.17,0:17:31.09,Default,,0,0,0,,Бұл жігіт енді ешқашан ауырмасын.
Dialogue: 0,0:17:31.88,0:17:36.30,Default,,0,0,0,,Мен оны жаман қыламын, тіпті бұрылып әуре болмайсың.
Dialogue: 0,0:17:38.01,0:17:39.30,Default,,0,0,0,,Маған енді ұнамайды
Dialogue: 0,0:17:39.97,0:17:43.18,Default,,0,0,0,,Жоғалту және аяушылық
Dialogue: 0,0:17:43.85,0:17:48.02,Default,,0,0,0,,Өзін бақытсыз сезіну және мәжбүрлеу...
Dialogue: 0,0:17:49.44,0:17:50.61,Default,,0,0,0,,№.
Dialogue: 0,0:17:51.11,0:17:53.74,Default,,0,0,0,,Сіз әдепті адамсыз.
Dialogue: 0,0:17:54.24,0:17:57.95,Default,,0,0,0,,Біраз уақыт жаман заклинание астында
Dialogue: 0,0:17:58.07,0:18:00.62,Default,,0,0,0,,Сіз тек осылай көрінесіз.
Dialogue: 0,0:18:01.08,0:18:03.54,Default,,0,0,0,,Дәлелдемелерді қараңыз.
Dialogue: 0,0:18:04.25,0:18:07.37,Default,,0,0,0,,Бастапқы күйіне тез оралатын нәрсе
Dialogue: 0,0:18:08.04,0:18:12.59,Default,,0,0,0,,Жарайды, мен мүлде қорықпаймын.
Dialogue: 0,0:18:13.09,0:18:14.13,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:15.17,0:18:17.51,Default,,0,0,0,,Сіз шынымен қорқып қалдыңыз, солай емес пе?
Dialogue: 0,0:18:19.18,0:18:20.89,Default,,0,0,0,,Осылайша күніне ондаған рет
Dialogue: 0,0:18:21.64,0:18:24.64,Default,,0,0,0,,Менің моншақтарым құлап кетпейтінін тексердіңіз бе?
Dialogue: 0,0:18:26.35,0:18:28.85,Default,,0,0,0,,Сен менің мақтан тұтар ұлымсың.
Dialogue: 0,0:18:28.98,0:18:30.15,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:18:30.52,0:18:33.90,Default,,0,0,0,,Онда неге мені шығаруға тырыспадың?
Dialogue: 0,0:18:34.40,0:18:37.07,Default,,0,0,0,,Мен оны ешкімге көрсетпеймін, өйткені ол сүйкімді
Dialogue: 0,0:18:37.45,0:18:39.07,Default,,0,0,0,,Ұялдың, солай емес пе?
Dialogue: 0,0:18:39.61,0:18:41.41,Default,,0,0,0,,Жоқ, мен сені жақсы көремін.
Dialogue: 0,0:18:43.03,0:18:46.62,Default,,0,0,0,,Мен сен үшін өлер едім, анашым.
Dialogue: 0,0:18:47.33,0:18:50.25,Default,,0,0,0,,Неге осылай айта бересің?
Dialogue: 0,0:18:50.38,0:18:52.38,Default,,0,0,0,,Шынайы мені де мойындама
Dialogue: 0,0:18:52.96,0:18:56.09,Default,,0,0,0,,Неліктен осы махаббатты көрсетесің?
Dialogue: 0,0:18:56.34,0:18:59.51,Default,,0,0,0,,Ана сені бәрінен де жақсы көретін.
Dialogue: 0,0:18:59.76,0:19:01.01,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:19:01.30,0:19:04.10,Default,,0,0,0,,Маған мұны мәжбүрлеме!
Dialogue: 0,0:19:04.22,0:19:05.27,Default,,0,0,0,,Маған бұл керек емес.
Dialogue: 0,0:19:06.47,0:19:08.10,Default,,0,0,0,,Маған керек емес...
Dialogue: 0,0:19:12.52,0:19:13.52,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:19.32,0:19:22.57,Default,,0,0,0,,Үйге қайтайық.
Dialogue: 0,0:19:22.70,0:19:23.74,Default,,0,0,0,,…
Dialogue: 0,0:19:24.66,0:19:25.95,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:26.79,0:19:29.33,Default,,0,0,0,,Әйтпесе... Кёкун сол үйде.
Dialogue: 0,0:19:29.46,0:19:32.21,Default,,0,0,0,,Қайтып келсем де бермейді деп ойлаймын.
Dialogue: 0,0:19:33.21,0:19:34.38,Default,,0,0,0,,Созылған жұдырық
Dialogue: 0,0:19:36.42,0:19:38.63,Default,,0,0,0,,Тоқта, жібер (Тору) Маған ұнамайды.
Dialogue: 0,0:19:38.76,0:19:41.05,Default,,0,0,0,,Бөлек (Тору) Түсінбедім!
Dialogue: 0,0:19:41.18,0:19:43.22,Default,,0,0,0,,（）…
Dialogue: 0,0:19:43.34,0:19:44.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:44.68,0:19:47.10,Default,,0,0,0,,Қарғыс атсын! Уф...
Dialogue: 0,0:19:47.22,0:19:48.47,Default,,0,0,0,,… （）
Dialogue: 0,0:19:49.73,0:19:51.56,Default,,0,0,0,,Кио-кун қазір...
Dialogue: 0,0:19:52.31,0:19:55.73,Default,,0,0,0,,Даусыңды естісем де, Киокун емес сияқты.
Dialogue: 0,0:19:56.44,0:20:00.70,Default,,0,0,0,,Мен сені бұрын көрген емеспін... қорқынышты.
Dialogue: 0,0:20:01.86,0:20:03.03,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:04.24,0:20:07.91,Default,,0,0,0,,Бірақ қазірден бастап мен оны дұрыс түсінгім келеді.
Dialogue: 0,0:20:08.29,0:20:09.79,Default,,0,0,0,,Бұдан былай...
Dialogue: 0,0:20:10.75,0:20:14.46,Default,,0,0,0,,Кёкун менің әлсіз дауысымды тыңдайды деп үміттенемін.
Dialogue: 0,0:20:15.54,0:20:18.67,Default,,0,0,0,,Маған да Киокунның әлсіз дауысын естуге рұқсат еткім келеді.
Dialogue: 0,0:20:19.55,0:20:21.30,Default,,0,0,0,,Кейде бұл қиын
Dialogue: 0,0:20:21.93,0:20:25.68,Default,,0,0,0,,Маған қорқынышты нәрселерді және әлсіз нәрселерді айтқым келеді.
Dialogue: 0,0:20:25.80,0:20:27.89,Default,,0,0,0,,Мен сенің қиналғаныңды қалаймын.
Dialogue: 0,0:20:29.06,0:20:30.48,Default,,0,0,0,,…
Dialogue: 0,0:20:31.68,0:20:33.94,Default,,0,0,0,,Себебі мен бірге өмір сүргім келеді
Dialogue: 0,0:20:34.69,0:20:39.86,Default,,0,0,0,,Тамақтану, оқу, уайымдау...
Dialogue: 0,0:20:40.90,0:20:44.32,Default,,0,0,0,,Дәл осылай біз бірге боламыз...
Dialogue: 0,0:20:44.99,0:20:47.33,Default,,0,0,0,,Мен сенімен уақыт өткізгім келеді!
Dialogue: 0,0:20:56.63,0:20:59.09,Default,,0,0,0,,Бәрі... (Тору) А...
Dialogue: 0,0:20:59.71,0:21:04.13,Default,,0,0,0,,Сен мені бәрібір жақсы көрмесең де...
Dialogue: 0,0:21:04.63,0:21:06.14,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:21:07.60,0:21:11.18,Default,,0,0,0,,Қорыққаныңыз дұрыс
Dialogue: 0,0:21:12.77,0:21:14.56,Default,,0,0,0,,Қорқынышты нәрсе...
Dialogue: 0,0:21:14.69,0:21:18.11,Default,,0,0,0,,Ұсқынсыз болсам да маған қарап тұрғаныңның дәлелі.
Dialogue: 0,0:21:20.44,0:21:22.03,Default,,0,0,0,,Бірақ анам...
Dialogue: 0,0:21:22.90,0:21:25.78,Default,,0,0,0,,Көргім келмеді, Махаббатпен жасырайын деп.
Dialogue: 0,0:21:26.49,0:21:28.62,Default,,0,0,0,,Мен бұл туралы ойлаған да жоқпын.
Dialogue: 0,0:21:30.24,0:21:35.58,Default,,0,0,0,,Менімен дұрыс ойланып, уайымдағаныңызды қалаймын.
Dialogue: 0,0:21:38.42,0:21:41.88,Default,,0,0,0,,Бірге өмір сүрейік...
Dialogue: 0,0:21:45.30,0:21:46.93,Default,,0,0,0,,Ақымаққа ұқсайды
Dialogue: 0,0:21:48.05,0:21:49.10,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:21:50.56,0:21:53.77,Default,,0,0,0,,Мұны ешкім жасамас еді...
Dialogue: 0,0:21:55.02,0:21:57.90,Default,,0,0,0,,Сен маған айтпайсың деп ойладым.
Dialogue: 0,0:21:59.65,0:22:03.07,Default,,0,0,0,,Мен ойладым... Мен сонда болдым.
Dialogue: 0,0:22:05.19,0:22:06.45,Default,,0,0,0,,Мөлдір…
Dialogue: 0,0:22:09.57,0:22:10.83,Default,,0,0,0,,Тоору!
Dialogue: 0,0:22:13.70,0:22:18.71,Default,,0,0,0,,♪~
Dialogue: 0,0:22:19.13,0:22:20.96,Default,,0,0,0,,Осылайша...
Dialogue: 0,0:22:23.21,0:22:25.51,Default,,0,0,0,,Сен солайсың
Dialogue: 0,0:22:26.59,0:22:29.30,Default,,0,0,0,,Ішімдегі шіркін сезімдер
Dialogue: 0,0:22:30.09,0:22:32.51,Default,,0,0,0,,Лайықты ойлар
Dialogue: 0,0:22:33.10,0:22:36.02,Default,,0,0,0,,Бірінен соң бірі еріп кетеді.
Dialogue: 0,0:22:38.56,0:22:41.06,Default,,0,0,0,,Неліктен жігіт сені ұнатады?
Dialogue: 0,0:22:41.98,0:22:44.48,Default,,0,0,0,,Менің жанымда қалатын шығарсың
Dialogue: 0,0:22:45.90,0:22:46.90,Default,,0,0,0,,Жылау...
Dialogue: 0,0:22:48.53,0:22:50.03,Default,,0,0,0,,Маған бересің бе?
Dialogue: 0,0:22:54.87,0:22:57.00,Default,,0,0,0,,Мен неге тілеуім керек?
Dialogue: 0,0:22:58.58,0:23:00.42,Default,,0,0,0,,Басқа біліктілік жоқ
Dialogue: 0,0:23:00.92,0:23:02.96,Default,,0,0,0,,Менде жоқ болса да
Dialogue: 0,0:23:05.00,0:23:07.38,Default,,0,0,0,,Тек қасыңызда болу
Dialogue: 0,0:23:07.97,0:23:09.68,Default,,0,0,0,,Бұл қате болса да...
Dialogue: 0,0:23:26.11,0:23:27.44,Default,,0,0,0,,Жұмыс істемей жатыр!
Dialogue: 0,0:23:28.53,0:23:31.45,Default,,0,0,0,,Осы уақытты бағалағым келеді
Dialogue: 0,0:23:32.78,0:23:35.12,Default,,0,0,0,,Мен кеткім келмейді...
Dialogue: 0,0:23:36.24,0:23:38.45,Default,,0,0,0,,Мен қалаймын деп ойлаймын
Dialogue: 0,0:23:39.96,0:23:44.96,Default,,0,0,0,,~♪
Dialogue: 0,0:23:46.46,0:23:51.46,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
