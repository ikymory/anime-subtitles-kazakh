Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.33,0:00:13.70,Default,,0,0,0,,Мен көмек сұрай алдым.
Dialogue: 0,0:00:14.12,0:00:15.95,Default,,0,0,0,,Сіздің арқаңызда Андж құтылып кетті.
Dialogue: 0,0:00:16.25,0:00:17.95,Default,,0,0,0,,Біз Виркистен айырылып қалдық
Dialogue: 0,0:00:19.20,0:00:21.20,Default,,0,0,0,,Сіз Либертасты аяқтадыңыз.
Dialogue: 0,0:00:21.62,0:00:23.62,Default,,0,0,0,,Сіз, Вилькис рыцары!
Dialogue: 0,0:00:23.70,0:00:25.12,Default,,0,0,0,,Анге сіздің құрал емес!
Dialogue: 0,0:00:25.25,0:00:25.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:26.29,0:00:27.04,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:00:27.50,0:00:28.08,Default,,0,0,0,,А...
Dialogue: 0,0:00:28.58,0:00:31.12,Default,,0,0,0,,Виркиссіз эмбрионды жеңу мүмкін емес.
Dialogue: 0,0:00:31.33,0:00:33.87,Default,,0,0,0,,Мұны саған әкең үйреткен!
Dialogue: 0,0:00:34.25,0:00:34.91,Default,,0,0,0,,Не?
Dialogue: 0,0:00:35.12,0:00:38.87,Default,,0,0,0,,Оны құрту үшін... Сіз өте перзенттік ұл болуыңыз керек!
Dialogue: 0,0:00:39.41,0:00:40.12,Default,,0,0,0,,Көкек...
Dialogue: 0,0:00:40.91,0:00:43.45,Default,,0,0,0,,Libertas Әлі біткен жоқ.
Dialogue: 0,0:00:43.54,0:00:44.04,Default,,0,0,0,,Әй?
Dialogue: 0,0:00:44.33,0:00:46.16,Default,,0,0,0,,Сен Анджге көмектесуің керек.
Dialogue: 0,0:00:46.83,0:00:49.25,Default,,0,0,0,,Қашып кетуге күшің жетеді ме?
Dialogue: 0,0:00:49.70,0:00:50.91,Default,,0,0,0,,Бұл...
Dialogue: 0,0:00:51.08,0:00:53.45,Default,,0,0,0,,Оның үстіне... оны құтқаруға тырысудың да мәні жоқ!
Dialogue: 0,0:00:53.58,0:00:54.16,Default,,0,0,0,,О
Dialogue: 0,0:00:54.58,0:00:57.29,Default,,0,0,0,,Ол енді менің бұйрықтарымды орындамайды.
Dialogue: 0,0:00:57.66,0:00:58.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:00.33,0:01:01.70,Default,,0,0,0,,Арзеналға баратын жол
Dialogue: 0,0:01:02.37,0:01:04.70,Default,,0,0,0,,Болашақ операциялар толықтырылғаннан кейін хабарланады
Dialogue: 0,0:01:05.16,0:01:05.87,Default,,0,0,0,,Осымен
Dialogue: 0,0:01:06.04,0:01:06.91,Default,,0,0,0,,Иә, анашым!
Dialogue: 0,0:01:11.62,0:01:16.37,Default,,0,0,0,,Кешіріңіз... Кешіріңіз... Эмбрион мырза...
Dialogue: 0,0:01:21.75,0:01:33.91,Default,,0,0,0,,Қараңғылық үшін дұға ет...
Dialogue: 0,0:01:36.29,0:01:41.70,Default,,0,0,0,,Бұл дүние елес
Dialogue: 0,0:01:41.83,0:01:47.41,Default,,0,0,0,,Білсең де, болашақты нұрландыр
Dialogue: 0,0:01:47.54,0:01:52.37,Default,,0,0,0,,Кейінгі кескіндер жоқ
Dialogue: 0,0:01:52.45,0:01:58.91,Default,,0,0,0,,Мен саған күш пен батылдық бергім келеді.
Dialogue: 0,0:01:59.04,0:02:02.12,Default,,0,0,0,,Күресу
Dialogue: 0,0:02:02.20,0:02:04.75,Default,,0,0,0,,Кек сақтама
Dialogue: 0,0:02:04.91,0:02:07.75,Default,,0,0,0,,Тағдырдан тыс
Dialogue: 0,0:02:07.87,0:02:09.70,Default,,0,0,0,,Тұр
Dialogue: 0,0:02:09.83,0:02:16.25,Default,,0,0,0,,Үмітсіздік сіздің арғы желіңіз болсын...
Dialogue: 0,0:02:17.41,0:02:23.29,Default,,0,0,0,,Оян, әлі ауырып тұр
Dialogue: 0,0:02:23.41,0:02:28.95,Default,,0,0,0,,Шынайы Аян
Dialogue: 0,0:02:29.08,0:02:36.62,Default,,0,0,0,,Басы Мәңгілік аяқталады
Dialogue: 0,0:02:36.75,0:02:46.95,Default,,0,0,0,,Мифтен де әдемі...
Dialogue: 0,0:02:49.83,0:02:51.95,Default,,0,0,0,,Гауһар раушан рыцарларына ашу?
Dialogue: 0,0:02:52.66,0:02:54.70,Default,,0,0,0,,Ол Ragna Mail пайдалана алады
Dialogue: 0,0:02:55.12,0:02:58.16,Default,,0,0,0,,Әлемді өзгертуге қажетті адам ресурстары
Dialogue: 0,0:02:58.41,0:02:59.12,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:02:59.29,0:03:00.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:00.33,0:03:03.37,Default,,0,0,0,,Андж Эмбриво-саманың айтқанын тыңдамайды!
Dialogue: 0,0:03:03.58,0:03:05.16,Default,,0,0,0,,Керісінше, мен сенімдімін...
Dialogue: 0,0:03:05.50,0:03:08.16,Default,,0,0,0,,Фуфу Якимочи гриль жасап жатырсыз ба?
Dialogue: 0,0:03:08.33,0:03:09.08,Default,,0,0,0,,Сен енді ғана сөйлеп тұрдың ғой, иә?
Dialogue: 0,0:03:09.25,0:03:11.83,Default,,0,0,0,,Ол тек құрал ретінде қажет.
Dialogue: 0,0:03:11.95,0:03:12.83,Default,,0,0,0,,Күте тұрыңыз…
Dialogue: 0,0:03:16.29,0:03:16.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:17.12,0:03:19.62,Default,,0,0,0,,Ең бастысы сенсің
Dialogue: 0,0:03:20.33,0:03:21.00,Default,,0,0,0,,Ах ха ха ха...
Dialogue: 0,0:03:27.70,0:03:30.87,Default,,0,0,0,,Эмбрион мырза... Мм!
Dialogue: 0,0:03:36.91,0:03:37.91,Default,,0,0,0,,Маған рұқсат бере аласыз ба?
Dialogue: 0,0:03:40.91,0:03:41.75,Default,,0,0,0,,...
Dialogue: 0,0:03:43.16,0:03:45.12,Default,,0,0,0,,Үйге қайт! Қазір!
Dialogue: 0,0:03:45.95,0:03:48.91,Default,,0,0,0,,Егер өзімшілдік жасасаң, қожайын саған ұрысады.
Dialogue: 0,0:03:49.37,0:03:52.75,Default,,0,0,0,,Егер солай болса, Эмбрио-сама не айтса да, «жоқ» деңіз.
Dialogue: 0,0:03:53.75,0:03:54.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:57.66,0:04:02.16,Default,,0,0,0,,Уайымдамаңыз, тіпті қателессеңіз де, сіз Daikon Knights қатарына қосылмайсыз.
Dialogue: 0,0:04:10.70,0:04:12.75,Default,,0,0,0,,Алмаз раушан рыцарлары...
Dialogue: 0,0:04:23.33,0:04:25.33,Default,,0,0,0,,Дарджилингтің екінші қызуы
Dialogue: 0,0:04:27.08,0:04:28.12,Default,,0,0,0,,Дәмді...
Dialogue: 0,0:04:28.62,0:04:30.25,Default,,0,0,0,,айтамын деп ойладыңыз ба?
Dialogue: 0,0:04:30.33,0:04:30.95,Default,,0,0,0,,Хмм?
Dialogue: 0,0:04:31.54,0:04:35.00,Default,,0,0,0,,Мен үшін қайнатылған Момока шайы жүздеген есе дәмді.
Dialogue: 0,0:04:35.33,0:04:36.20,Default,,0,0,0,,Хэхехе
Dialogue: 0,0:04:36.33,0:04:40.87,Default,,0,0,0,,Сонымен? Мен сені ақымақ шәйіммен мақтану үшін шақырған жоқпын, солай ма?
Dialogue: 0,0:04:41.79,0:04:46.54,Default,,0,0,0,,Жарайды, хехе, ашық айтайын.
Dialogue: 0,0:04:48.66,0:04:50.41,Default,,0,0,0,,Мен сені әйелім етіп алғым келеді
Dialogue: 0,0:04:50.83,0:04:51.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:52.08,0:04:53.12,Default,,0,0,0,,Ха! Ах...
Dialogue: 0,0:04:53.83,0:04:59.87,Default,,0,0,0,,Сіз мен бұрын-соңды кездестірген адамдардан күштірек, ақылдырақ және әдемірексіз.
Dialogue: 0,0:05:00.16,0:05:01.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:01.16,0:05:05.33,Default,,0,0,0,,- Жаңа дүниенің құдайы... Ол менің әйелім болуға лайық - Уф...
Dialogue: 0,0:05:06.50,0:05:10.79,Default,,0,0,0,,Мен... әйелімнің тілегін орындағым келеді.
Dialogue: 0,0:05:11.29,0:05:12.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:12.41,0:05:15.29,Default,,0,0,0,,А... мына дүниені құртайық
Dialogue: 0,0:05:15.83,0:05:16.45,Default,,0,0,0,,О, хаа...
Dialogue: 0,0:05:18.75,0:05:22.08,Default,,0,0,0,,Ескі дүниенің адамдары айуандық, жаугершілік...
Dialogue: 0,0:05:22.91,0:05:26.41,Default,,0,0,0,,Жетпесе күресеміз, жоқ болса ашуланамыз.
Dialogue: 0,0:05:26.95,0:05:28.41,Default,,0,0,0,,Бұл аң сияқты болды
Dialogue: 0,0:05:30.33,0:05:34.62,Default,,0,0,0,,Оларды жойылудан құтқарудың жалғыз жолы - адамдарды қайта жасау.
Dialogue: 0,0:05:35.79,0:05:38.04,Default,,0,0,0,,Бұл дүниені жаратты
Dialogue: 0,0:05:38.83,0:05:42.16,Default,,0,0,0,,Жетілдірілген ақпараттық желілер арқылы қосылған ақылды адамдармен
Dialogue: 0,0:05:42.75,0:05:45.87,Default,,0,0,0,,Жарық пен заттарға толы дүние...
Dialogue: 0,0:05:47.70,0:05:49.79,Default,,0,0,0,,Бірақ бұл жолы құлады
Dialogue: 0,0:05:50.75,0:05:52.25,Default,,0,0,0,,Берілгенге дағдыланыңыз
Dialogue: 0,0:05:52.79,0:05:55.50,Default,,0,0,0,,Мен өзімді ойлаудан бас тарттым...
Dialogue: 0,0:05:56.70,0:05:58.41,Default,,0,0,0,,Сіз де көрдіңіз бе?
Dialogue: 0,0:05:58.87,0:06:03.50,Default,,0,0,0,,Біреу бұйырса, адамдарды кемсіту, қыру оңай.
Dialogue: 0,0:06:04.08,0:06:06.04,Default,,0,0,0,,Олардың шірік табиғаты...
Dialogue: 0,0:06:07.50,0:06:09.70,Default,,0,0,0,,Адамдар үшін ештеңе өзгерген жоқ.
Dialogue: 0,0:06:10.20,0:06:13.16,Default,,0,0,0,,Әлі де зұлым және ақымақ...
Dialogue: 0,0:06:15.20,0:06:17.62,Default,,0,0,0,,Бірақ Андж, сенімен бірге...
Dialogue: 0,0:06:18.91,0:06:24.54,Default,,0,0,0,,Біз жарататын адам ұрпағы міндетті түрде әділ және жақсы болады.
Dialogue: 0,0:06:26.08,0:06:27.20,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,0:06:28.50,0:06:30.62,Default,,0,0,0,,Дүниені қалай бұзасың?
Dialogue: 0,0:06:31.20,0:06:32.16,Default,,0,0,0,,Ох…
Dialogue: 0,0:06:33.54,0:06:36.75,Default,,0,0,0,,Миллиардтаған және миллиондаған
Dialogue: 0,0:06:37.08,0:06:39.58,Default,,0,0,0,,-Өмір жалыны -Хаа «Мәңгілік сөз»...
Dialogue: 0,0:06:42.29,0:06:43.91,Default,,0,0,0,,«Бірыңғай теория»…
Dialogue: 0,0:06:44.16,0:06:48.25,Default,,0,0,0,,Бұл әуенге айналған ғаламды басқаратын заң.
Dialogue: 0,0:06:49.45,0:06:51.83,Default,,0,0,0,,Осы әуенді Ragnamail көмегімен күшейтіңіз
Dialogue: 0,0:06:52.25,0:06:56.62,Default,,0,0,0,,Аураны екі әлемді біріктіру үшін энергия ретінде пайдаланыңыз...
Dialogue: 0,0:07:00.70,0:07:03.12,Default,,0,0,0,,Бір жерге қайта жасау
Dialogue: 0,0:07:04.04,0:07:07.91,Default,,0,0,0,,Айдаһар жұлдызында көргеніңіз сол сынақ болды.
Dialogue: 0,0:07:11.33,0:07:14.62,Default,,0,0,0,,Қызық, Андж... Сіз маған көмектесе аласыз ба?
Dialogue: 0,0:07:15.37,0:07:18.04,Default,,0,0,0,,Я... жаңа дүние...
Dialogue: 0,0:07:18.16,0:07:18.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:19.58,0:07:20.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:22.54,0:07:23.33,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:23.70,0:07:25.95,Default,,0,0,0,,Уф! Ууууууууууууууууууууу...
Dialogue: 0,0:07:26.58,0:07:29.25,Default,,0,0,0,,Сіз бұл біртүрлі сиқырды енді пайдалана алмайсыз, солай ма?
Dialogue: 0,0:07:29.95,0:07:32.12,Default,,0,0,0,,Ах! Құрметті Анжелиза...
Dialogue: 0,0:07:34.33,0:07:35.08,Default,,0,0,0,,(Night Eye) Не істесең де, олар бізді сол жақта байқамай қалсын.
Dialogue: 0,0:07:35.70,0:07:36.45,Default,,0,0,0,,Не болды, қарт әже?
Dialogue: 0,0:07:36.62,0:07:38.45,Default,,0,0,0,,Бұл дүниеде өкініш жоқ.
Dialogue: 0,0:07:38.79,0:07:44.41,Default,,0,0,0,,Бірақ мен сенің әйелің болу үшін өлер едім! Тюнер
Dialogue: 0,0:07:44.54,0:07:44.79,Default,,0,0,0,,…баланың санасына ықпал ету үшін миына енгізілген
Dialogue: 0,0:07:45.04,0:07:46.95,Default,,0,0,0,,Өлесің!
Dialogue: 0,0:07:47.29,0:07:51.87,Default,,0,0,0,,Күте тұрыңыз! Уф! Ах...
Dialogue: 0,0:07:53.83,0:07:55.41,Default,,0,0,0,,Құрметті Ангелиза...
Dialogue: 0,0:07:59.45,0:08:02.70,Default,,0,0,0,,Хехехе... Бұл қанды нәрсе.
Dialogue: 0,0:08:02.79,0:08:03.58,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:03.75,0:08:07.41,Default,,0,0,0,,Бірақ әйелді иеленуге тұрарлық нәрсе де осы.
Dialogue: 0,0:08:07.58,0:08:08.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:09.33,0:08:10.33,Default,,0,0,0,,А... ә
Dialogue: 0,0:08:11.29,0:08:13.16,Default,,0,0,0,,Уф! аа!
Dialogue: 0,0:08:16.04,0:08:16.95,Default,,0,0,0,,Куууу…
Dialogue: 0,0:08:19.91,0:08:22.25,Default,,0,0,0,,Кяах!
Dialogue: 0,0:08:23.87,0:08:25.16,Default,,0,0,0,,Гуахахахах!
Dialogue: 0,0:08:25.37,0:08:26.95,Default,,0,0,0,,О, Ангелиза!
Dialogue: 0,0:08:27.37,0:08:31.62,Default,,0,0,0,,Сіз күткендей, сіз 50 есе ауыртпалыққа шыдай алмайсыз...
Dialogue: 0,0:08:32.70,0:08:34.79,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:08:36.79,0:08:39.37,Default,,0,0,0,,Уф, ха, а...
Dialogue: 0,0:08:39.70,0:08:41.45,Default,,0,0,0,,Ханшайым! Жарайды?
Dialogue: 0,0:08:41.58,0:08:43.50,Default,,0,0,0,,Уф... Оған тиме!
Dialogue: 0,0:08:43.87,0:08:45.66,Default,,0,0,0,,А, аа! Ханшайым?
Dialogue: 0,0:08:46.75,0:09:00.54,Default,,0,0,0,,Уф... аа... а... а...
Dialogue: 0,0:09:00.70,0:09:01.37,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:09:02.16,0:09:07.95,Default,,0,0,0,,Ааа! Уф... маған көбірек тигізіңіз...
Dialogue: 0,0:09:08.66,0:09:12.12,Default,,0,0,0,,Момока... толығырақ... күрсініп...
Dialogue: 0,0:09:12.25,0:09:14.95,Default,,0,0,0,,Барлық ауыру сезімдері ләззатқа айналды...
Dialogue: 0,0:09:15.95,0:09:19.66,Default,,0,0,0,,Андж, сені манипуляциялау оңай.
Dialogue: 0,0:09:19.79,0:09:21.70,Default,,0,0,0,,Ух... ха...
Dialogue: 0,0:09:21.79,0:09:26.70,Default,,0,0,0,,Егер сіз одан әрі қиналғыңыз келмесе, менің үйлену ұсынысымды қабыл алыңыз.
Dialogue: 0,0:09:28.33,0:09:31.25,Default,,0,0,0,,Ханшайымды қалпына келтіріңіз! Қазір!
Dialogue: 0,0:09:33.04,0:09:34.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:34.41,0:09:34.95,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:36.04,0:09:38.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:48.25,0:09:49.70,Default,,0,0,0,,Сәлем Розали
Dialogue: 0,0:09:49.91,0:09:52.91,Default,,0,0,0,,Жарайсың ба? Біраз уақыт өтті...
Dialogue: 0,0:09:53.66,0:09:56.50,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:09:59.66,0:10:02.66,Default,,0,0,0,,Кешіріңіз... Көңіл-күйім жоқ.
Dialogue: 0,0:10:04.87,0:10:06.04,Default,,0,0,0,,Сіз қайтадан кетуді жоспарлап отырсыз ба?
Dialogue: 0,0:10:06.54,0:10:07.37,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:09.20,0:10:10.45,Default,,0,0,0,,Мен Анджге көмектесуім керек...
Dialogue: 0,0:10:11.37,0:10:13.83,Default,,0,0,0,,Егер командир көмектеспесе, мен...
Dialogue: 0,0:10:14.66,0:10:15.54,Default,,0,0,0,,Хилда...
Dialogue: 0,0:10:16.41,0:10:21.29,Default,,0,0,0,,Мен Анджге... бұл дүниені бірге жоямыз деп уәде бердім.
Dialogue: 0,0:10:23.12,0:10:25.37,Default,,0,0,0,,Мен сені жақсы көремін... Андж.
Dialogue: 0,0:10:25.41,0:10:26.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:26.50,0:10:29.25,Default,,0,0,0,,Түсіндім, біз бұрыннан таныспыз.
Dialogue: 0,0:10:30.54,0:10:32.33,Default,,0,0,0,,Мен де сенімен біргемін.
Dialogue: 0,0:10:32.62,0:10:33.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:33.58,0:10:37.87,Default,,0,0,0,,Хехе, мен де Криссіз істей алмаймын деп ойлаймын...
Dialogue: 0,0:10:38.83,0:10:40.83,Default,,0,0,0,,Ол жігіт мені үнемі қорқытады.
Dialogue: 0,0:10:41.29,0:10:45.25,Default,,0,0,0,,Мен сені қорғауым керек еді... мен осылай ойладым...
Dialogue: 0,0:10:46.29,0:10:50.66,Default,,0,0,0,,Менсіз де сен мықтысың... сен мүлдем жақсысың...
Dialogue: 0,0:10:51.87,0:10:54.79,Default,,0,0,0,,Бірақ мен әлі де шұбармын...
Dialogue: 0,0:10:55.70,0:11:00.29,Default,,0,0,0,,Менің ойымша, мен Криссіз істей алмайтын едім...
Dialogue: 0,0:11:03.16,0:11:03.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:04.66,0:11:05.12,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:05.87,0:11:09.95,Default,,0,0,0,,Оны қайтарайық, Крис пен Андж!
Dialogue: 0,0:11:10.75,0:11:11.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:13.29,0:11:14.08,Default,,0,0,0,,Хилда...
Dialogue: 0,0:11:17.95,0:11:19.66,Default,,0,0,0,,Мұнда да ауытқу жоқ...
Dialogue: 0,0:11:20.00,0:11:23.45,Default,,0,0,0,,Иә? Иә, командир?
Dialogue: 0,0:11:37.91,0:11:38.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:38.41,0:11:41.00,Default,,0,0,0,,Ух... иә Уау... Уау!
Dialogue: 0,0:11:42.08,0:11:44.66,Default,,0,0,0,,Эй... мен оны шығарып жіберейін.
Dialogue: 0,0:11:44.87,0:11:46.12,Default,,0,0,0,,Не? Ngggggg...
Dialogue: 0,0:11:46.62,0:11:49.95,Default,,0,0,0,,Оның орнына... Маған бірдеңеде сенің көмегің керек.
Dialogue: 0,0:11:50.75,0:11:52.54,Default,,0,0,0,,Андж деген не?
Dialogue: 0,0:11:52.70,0:11:54.20,Default,,0,0,0,,Уф... аа! Уф...
Dialogue: 0,0:11:54.33,0:11:57.45,Default,,0,0,0,,Іс жақсы болса, мен саған рұқсат беремін.
Dialogue: 0,0:11:58.33,0:11:59.29,Default,,0,0,0,,Жарайды, міне, гострайтингі тапсырысы формасы.
Dialogue: 0,0:11:59.87,0:12:00.58,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:12:00.91,0:12:05.70,Default,,0,0,0,,О, мен Андждың серімін! Мен бірінші рет қызыммен баруды шештім...бірақ бұл дұрыс емес!
Dialogue: 0,0:12:05.91,0:12:06.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:06.79,0:12:10.41,Default,,0,0,0,,Жоқ, жоқ... Шайқас аяқталғанша Эросқа тыйым салынады...
Dialogue: 0,0:12:10.79,0:12:13.29,Default,,0,0,0,,Рыцарь ретінде мен түрлі-түсті қулыққа берілмеймін...
Dialogue: 0,0:12:13.83,0:12:17.16,Default,,0,0,0,,Мен сіздің бетіңізді Андждың беліне тығып алғаныңызды естідім.
Dialogue: 0,0:12:17.50,0:12:21.87,Default,,0,0,0,,Уф, бұл түсінбеушілік! Бұл апат болды және мен қателескен жоқпын!
Dialogue: 0,0:12:22.91,0:12:24.91,Default,,0,0,0,,Сонымен, сіз жай ғана сәтсіздікке ұшырайсыз ба?
Dialogue: 0,0:12:25.12,0:12:26.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:26.58,0:12:31.50,Default,,0,0,0,,-Пух ахахха... -Ух...
Dialogue: 0,0:12:33.12,0:12:38.33,Default,,0,0,0,,Ха, иә, Андждың рыцарь...
Dialogue: 0,0:12:39.50,0:12:41.50,Default,,0,0,0,,Маған тапсырмаларды орындауға көмектес
Dialogue: 0,0:12:41.83,0:12:43.41,Default,,0,0,0,,Мен Анджге көмектескім келеді.
Dialogue: 0,0:12:43.62,0:12:44.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:45.20,0:12:47.70,Default,,0,0,0,,Менің командирім... оған бірдеңе болды.
Dialogue: 0,0:12:48.29,0:12:50.29,Default,,0,0,0,,Мен бұған сене алар емеспін.
Dialogue: 0,0:12:50.87,0:12:51.79,Default,,0,0,0,,Алектра?
Dialogue: 0,0:12:53.20,0:12:54.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:56.54,0:12:57.83,Default,,0,0,0,,Мэй, не болды?
Dialogue: 0,0:12:57.91,0:13:01.37,Default,,0,0,0,,Мэгги, қалқа түсіп қалды, мен тұрғын үйден шыға алмаймын.
Dialogue: 0,0:13:08.16,0:13:10.37,Default,,0,0,0,,Әй, командир, шығасың ба?
Dialogue: 0,0:13:10.95,0:13:13.25,Default,,0,0,0,,Көңіліңіз көтеріліп, киініңіз...
Dialogue: 0,0:13:15.50,0:13:16.50,Default,,0,0,0,,Балалар...
Dialogue: 0,0:13:16.95,0:13:19.62,Default,,0,0,0,,Эмбрио-самаға баруды жоспарлап отырсыз ба?
Dialogue: 0,0:13:19.79,0:13:20.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:21.20,0:13:25.16,Default,,0,0,0,,Ұйқыда командирдің сөйлескенін естідің...
Dialogue: 0,0:13:25.91,0:13:28.16,Default,,0,0,0,,Эмбрион мырза...
Dialogue: 0,0:13:31.20,0:13:31.87,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:31.91,0:13:33.70,Default,,0,0,0,,Әй, не болып жатыр?
Dialogue: 0,0:13:33.75,0:13:34.95,Default,,0,0,0,,Бұл Бинго деп аталады!
Dialogue: 0,0:13:35.25,0:13:36.37,Default,,0,0,0,,Барлығына! Мен жасаймын!
Dialogue: 0,0:13:38.12,0:13:39.41,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:13:42.12,0:13:42.95,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:44.20,0:13:44.95,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:47.29,0:13:47.87,Default,,0,0,0,,Құмнан сезіп тұрған бұл сезім...
Dialogue: 0,0:13:48.16,0:13:49.33,Default,,0,0,0,,Қазір! Розали!
Dialogue: 0,0:13:50.41,0:13:51.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:51.33,0:13:52.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:53.91,0:13:54.95,Default,,0,0,0,,Жақсы! Ашылды!
Dialogue: 0,0:13:59.66,0:14:01.08,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:02.83,0:14:07.37,Default,,0,0,0,,Құрметті Ангелиза! Қайсысы, ханшайым?
Dialogue: 0,0:14:07.79,0:14:08.66,Default,,0,0,0,,Ах! сәйкес келеді!
Dialogue: 0,0:14:09.58,0:14:11.50,Default,,0,0,0,,Хмм, хмм, хмм, хмм…
Dialogue: 0,0:14:12.87,0:14:17.29,Default,,0,0,0,,Құлдың бойында болуы керек қаншама бүлікшіл мінездер бар... Осыны ойла!
Dialogue: 0,0:14:19.41,0:14:20.45,Default,,0,0,0,,Ханшайым?
Dialogue: 0,0:14:20.95,0:14:31.37,Default,,0,0,0,,Ааа... хаха... аааа...
Dialogue: 0,0:14:36.75,0:14:45.58,Default,,0,0,0,,Ук ку ку ку... ха... ха... неге?
Dialogue: 0,0:14:47.20,0:14:52.16,Default,,0,0,0,,Мен Анджелиз-саманы Хулио-самамен бірге төмендеткенімді ұмытқан жоқпын...
Dialogue: 0,0:14:53.62,0:14:56.75,Default,,0,0,0,,Сондықтан Анджелизден кешірім сұраңыз.
Dialogue: 0,0:14:57.62,0:15:00.04,Default,,0,0,0,,Оған дейін ешқашан өлмеу керек.
Dialogue: 0,0:15:03.62,0:15:04.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:06.58,0:15:10.58,Default,,0,0,0,,Императорлық отбасының эксклюзивті пайдалануына арналған Император сарайының батыс жағындағы жер асты баспанасы...
Dialogue: 0,0:15:11.41,0:15:13.41,Default,,0,0,0,,Ол міндетті түрде сонда...
Dialogue: 0,0:15:13.91,0:15:14.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:16.41,0:15:19.58,Default,,0,0,0,,Мен... Эмбрионның қуыршақ...
Dialogue: 0,0:15:20.37,0:15:23.95,Default,,0,0,0,,Ол менің жүрегімді басқарып, менің қолымнан бәрін ұрлады.
Dialogue: 0,0:15:25.12,0:15:27.75,Default,,0,0,0,,Тәкаппарлық, миссия және тазалық...
Dialogue: 0,0:15:29.12,0:15:30.12,Default,,0,0,0,,Бұл қорқынышты болды...
Dialogue: 0,0:15:30.79,0:15:34.12,Default,,0,0,0,,Либертастың Норманы босату миссиясы
Dialogue: 0,0:15:34.45,0:15:35.75,Default,,0,0,0,,Достармен қарым-қатынас
Dialogue: 0,0:15:36.83,0:15:42.41,Default,,0,0,0,,Мұның бәрі оған деген сүйіспеншілікке, тәуелділікке және ләззатқа ауыстырылды ...
Dialogue: 0,0:15:44.12,0:15:45.58,Default,,0,0,0,,Неге үндемедің?
Dialogue: 0,0:15:45.75,0:15:48.54,Default,,0,0,0,,Аа, мен не айтуым керек?
Dialogue: 0,0:15:49.08,0:15:50.75,Default,,0,0,0,,Мен Эмбрионды өлтіруге бардым, бірақ
Dialogue: 0,0:15:51.20,0:15:54.12,Default,,0,0,0,,Керісінше жаным мен тәнімді алып кетті...?
Dialogue: 0,0:15:55.33,0:15:56.95,Default,,0,0,0,,Бәріне менің кінәм...
Dialogue: 0,0:15:57.83,0:16:00.95,Default,,0,0,0,,Либертастың сәтсіздігі, достарының өлімі, бәрі...
Dialogue: 0,0:16:02.45,0:16:06.25,Default,,0,0,0,,Осындай лас әйелді құтқару үшін бәрі өлді...
Dialogue: 0,0:16:07.16,0:16:09.54,Default,,0,0,0,,Солай... Бұл өте рас!
Dialogue: 0,0:16:10.37,0:16:12.79,Default,,0,0,0,,Менің қолымнан келетін бір ғана жерлеу бар...
Dialogue: 0,0:16:13.62,0:16:16.25,Default,,0,0,0,,Эмбрионды өлтіріңіз! Болды...
Dialogue: 0,0:16:17.79,0:16:21.45,Default,,0,0,0,,Ол қазірге дейін жаңа ойыншықтарға әуестенген болуы керек.
Dialogue: 0,0:16:21.70,0:16:27.83,Default,,0,0,0,,Ах! Ой... аа...
Dialogue: 0,0:16:28.00,0:16:32.00,Default,,0,0,0,,Уф! Ах ха ха...
Dialogue: 0,0:16:32.08,0:16:34.20,Default,,0,0,0,,Егер сіз оны өлтіретін болсаңыз, бұл қазір немесе ешқашан.
Dialogue: 0,0:16:37.12,0:16:40.75,Default,,0,0,0,,-Уф -Уф... Ауырды!
Dialogue: 0,0:16:41.41,0:16:43.29,Default,,0,0,0,,Сол себепті жалғыз бармақ болдыңыз ба?
Dialogue: 0,0:16:43.66,0:16:45.87,Default,,0,0,0,,А... Мен тағы да сәтсіздікке ұшырадым.
Dialogue: 0,0:16:48.87,0:16:51.58,Default,,0,0,0,,Мен сенімен бірге келдім, өйткені мен сенмін.
Dialogue: 0,0:16:52.25,0:16:55.50,Default,,0,0,0,,Өйткені сен ниггасың... Осы уақыт бойы мен сені аңдыдым.
Dialogue: 0,0:16:56.54,0:16:59.45,Default,,0,0,0,,Бірақ олар енді ғана қолданылды.
Dialogue: 0,0:17:01.00,0:17:03.83,Default,,0,0,0,,Бірдеңе айт! Алектра! Эй!
Dialogue: 0,0:17:04.16,0:17:06.54,Default,,0,0,0,,Бұл туралы, Мэгги.
Dialogue: 0,0:17:07.50,0:17:08.08,Default,,0,0,0,,Тс!
Dialogue: 0,0:17:08.41,0:17:11.87,Default,,0,0,0,,Енді мен сені бастық ете алмайтынымды білдім...
Dialogue: 0,0:17:12.41,0:17:15.37,Default,,0,0,0,,Командалық құқықтарды алып тастаңыз Жақсы
Dialogue: 0,0:17:15.62,0:17:16.33,Default,,0,0,0,,О
Dialogue: 0,0:17:17.37,0:17:19.41,Default,,0,0,0,,Хилда, өз орныңа команданы ал.
Dialogue: 0,0:17:19.70,0:17:20.41,Default,,0,0,0,,Уау?
Dialogue: 0,0:17:20.91,0:17:23.83,Default,,0,0,0,,Сіз қателеспес едіңіз.
Dialogue: 0,0:17:25.54,0:17:26.70,Default,,0,0,0,,Иә апа!
Dialogue: 0,0:17:28.37,0:17:35.87,Default,,0,0,0,,Сұлулардың қиналғанын, қысым көргенін, үмітін үзгенін көру өте қызық.
Dialogue: 0,0:17:36.95,0:17:39.50,Default,,0,0,0,,Сіз адал болуға дайынсыз ба?
Dialogue: 0,0:17:39.79,0:17:43.08,Default,,0,0,0,,Иә... Эмбрион... Са...
Dialogue: 0,0:17:43.16,0:17:46.16,Default,,0,0,0,,Уф! Бітір! Ақымақ
Dialogue: 0,0:17:46.37,0:17:47.58,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:17:48.66,0:17:56.37,Default,,0,0,0,,Жоқ! Әй, ыстық! ыстық! Өтінемін, көмектесіңізші, тапсырма...
Dialogue: 0,0:17:56.45,0:18:03.45,Default,,0,0,0,,Маған көмектесші, аа... а... көмектесші... тапсырма... ку...
Dialogue: 0,0:18:14.08,0:18:15.54,Default,,0,0,0,,бастайық
Dialogue: 0,0:18:17.66,0:18:18.29,Default,,0,0,0,,Талия ше?
Dialogue: 0,0:18:18.91,0:18:19.79,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:18:20.33,0:18:21.91,Default,,0,0,0,,Хмм... Жарайды.
Dialogue: 0,0:18:28.54,0:18:29.50,Default,,0,0,0,,Қандай ұят...
Dialogue: 0,0:18:30.12,0:18:31.70,Default,,0,0,0,,Сари... А...
Dialogue: 0,0:18:32.08,0:18:35.66,Default,,0,0,0,,Мен Эмбриво-самаға қарсы шыққандықтан солай болады... Идиот!
Dialogue: 0,0:18:36.50,0:18:41.66,Default,,0,0,0,,Сен ақымақсың... осындай гейге ғашық болғаның үшін.
Dialogue: 0,0:18:42.79,0:18:46.00,Default,,0,0,0,,Менде енді жалғыз нәрсе - Эмбриво-сама.
Dialogue: 0,0:18:46.75,0:18:48.70,Default,,0,0,0,,Бірақ сіз басқасыз.
Dialogue: 0,0:18:49.29,0:18:53.79,Default,,0,0,0,,Менде бәрі бар, соның ішінде Вилкис, достарым және өз орным бар.
Dialogue: 0,0:18:54.66,0:18:57.45,Default,,0,0,0,,Трансформация болмаса да, сіз жеткілікті күштісіз.
Dialogue: 0,0:18:58.45,0:19:00.70,Default,,0,0,0,,Менен артық ештеңе алма
Dialogue: 0,0:19:04.33,0:19:07.87,Default,,0,0,0,,Эмбриво-сама қайтып келгенше шық.
Dialogue: 0,0:19:08.54,0:19:09.37,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:09.54,0:19:12.91,Default,,0,0,0,,Қарсылық таныта берсең, ақыры жүрегің жараланады.
Dialogue: 0,0:19:13.54,0:19:14.50,Default,,0,0,0,,Бұл әлі де жақсы ма?
Dialogue: 0,0:19:14.79,0:19:15.66,Default,,0,0,0,,Хаха...
Dialogue: 0,0:19:16.83,0:19:19.75,Default,,0,0,0,,Мен саған көмектесемін деген сияқты емес...
Dialogue: 0,0:19:20.04,0:19:20.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:21.04,0:19:23.70,Default,,0,0,0,,Мен сені соншалықты аянышты көргім келмейді...
Dialogue: 0,0:19:25.12,0:19:32.45,Default,,0,0,0,,Ән сал... Ән айт, екі тілегім енді
Dialogue: 0,0:19:32.58,0:19:41.66,Default,,0,0,0,,Қатты... Күшті, аспанның алтын түсімен жарқыраған
Dialogue: 0,0:19:41.87,0:19:46.79,Default,,0,0,0,,Мәңгілік туралы айтпа
Dialogue: 0,0:19:48.70,0:19:54.00,Default,,0,0,0,,Уф! Рахмет... Сария Бұл... маған көмектескеніңіз үшін рахмет.
Dialogue: 0,0:19:54.08,0:19:54.83,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:55.29,0:20:00.16,Default,,0,0,0,,Оның қашып кетуіне жол бергеннен гөрі қылмысы аз болар еді.
Dialogue: 0,0:20:00.54,0:20:07.00,Default,,0,0,0,,Ха, бұл қажет емес... Ха... Маған қамқор болыңызшы... Бұл... Бұлшықеттер... Ра...
Dialogue: 0,0:20:07.08,0:20:16.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:19.54,0:20:21.33,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:25.62,0:20:26.70,Default,,0,0,0,,Құрметті Ангелиза!
Dialogue: 0,0:20:31.70,0:20:33.37,Default,,0,0,0,,Дайын...
Dialogue: 0,0:20:33.95,0:20:38.66,Default,,0,0,0,,Барлық мүшелер Ragna Mail мініп, жоспар аяқталғанша Акацуки бағанасын қорғайды!
Dialogue: 0,0:20:39.29,0:20:40.37,Default,,0,0,0,,Иса Ұстаз!
Dialogue: 0,0:20:43.25,0:20:44.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:46.45,0:20:47.37,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:48.79,0:20:50.41,Default,,0,0,0,,Қайда бара жатырсың, Андж Чан?
Dialogue: 0,0:20:50.45,0:20:51.16,Default,,0,0,0,,Ах ха!
Dialogue: 0,0:20:52.66,0:20:54.16,Default,,0,0,0,,Эмбрион-сан сені іздеп жатыр.
Dialogue: 0,0:20:54.70,0:20:56.79,Default,,0,0,0,,Сіз жүгіре аласыз ба? Құрметті Ангелиза
Dialogue: 0,0:20:57.20,0:20:58.04,Default,,0,0,0,,Иә
Dialogue: 0,0:21:00.95,0:21:03.04,Default,,0,0,0,,О, менің... Қолымнан келмейді...
Dialogue: 0,0:21:04.16,0:21:07.87,Default,,0,0,0,,Хмм... ха-ха
Dialogue: 0,0:21:08.20,0:21:08.87,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:16.54,0:21:17.45,Default,,0,0,0,,Вилкис?
Dialogue: 0,0:21:18.41,0:21:19.66,Default,,0,0,0,,Момока, мін!
Dialogue: 0,0:21:19.95,0:21:20.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:27.33,0:21:28.04,Default,,0,0,0,,Крис!
Dialogue: 0,0:21:28.12,0:21:28.91,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:21:29.62,0:21:31.33,Default,,0,0,0,,Мен сенің қашып кетуіңе жол бермеймін, Андж!
Dialogue: 0,0:21:33.37,0:21:33.79,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:41.33,0:21:42.79,Default,,0,0,0,,Құрметті Ангелиза!
Dialogue: 0,0:21:42.95,0:21:43.33,Default,,0,0,0,,Куу...
Dialogue: 0,0:21:53.62,0:21:56.41,Default,,0,0,0,,Мен қарызымды өтеуге келдім, Андж.
Dialogue: 0,0:21:56.62,0:21:57.45,Default,,0,0,0,,Сарако?
Dialogue: 0,0:21:59.12,0:22:00.54,Default,,0,0,0,,Саламандин ханым...
Dialogue: 0,0:22:03.16,0:22:08.95,Default,,0,0,0,,Түннің сары шымылдығында адасқан
Dialogue: 0,0:22:09.12,0:22:14.58,Default,,0,0,0,,Мен ренжіп қалатын сияқтымын
Dialogue: 0,0:22:14.91,0:22:20.70,Default,,0,0,0,,Жүрексіздіктің қайта-қайта толқыны жұтылды
Dialogue: 0,0:22:20.87,0:22:26.20,Default,,0,0,0,,Қарама-қайшы бейбітшілікті іздеу
Dialogue: 0,0:22:26.33,0:22:31.95,Default,,0,0,0,,Дем ала алмайтындай мені қинайтын шындық
Dialogue: 0,0:22:32.04,0:22:38.04,Default,,0,0,0,,Шындық әрқашан қатып қалады
Dialogue: 0,0:22:38.12,0:22:43.87,Default,,0,0,0,,Жалындаған ғашықтықтай арман болт
Dialogue: 0,0:22:44.12,0:22:49.95,Default,,0,0,0,,Бұл денені күйдіріп, аспанды шуылдатыңыз
Dialogue: 0,0:22:50.04,0:22:53.00,Default,,0,0,0,,Ешкім білмейтін қараңғылықтың арғы жағында
Dialogue: 0,0:22:53.08,0:23:00.16,Default,,0,0,0,,Басын іздеп, Айқайлай берем
Dialogue: 0,0:23:00.29,0:23:01.29,Default,,0,0,0,,Ол келгенше...
Dialogue: 0,0:23:01.37,0:23:07.50,Default,,0,0,0,,Жұмбақ жарқыраған – аты жоқ жұлдыз
Dialogue: 0,0:23:07.58,0:23:13.66,Default,,0,0,0,,Even if I lose my place in the maze of time
Dialogue: 0,0:23:13.75,0:23:16.54,Default,,0,0,0,,Көңілсіз есте қалды
Dialogue: 0,0:23:16.62,0:23:23.58,Default,,0,0,0,,Сүйкімді күлкі сені мәңгілікке жетелейді
Dialogue: 0,0:23:23.66,0:23:32.58,Default,,0,0,0,,Жаңа әлемге
Dialogue: 0,0:23:34.12,0:23:36.25,Default,,0,0,0,,Менің келесі аптадағы табысым Ең жаманы!
Dialogue: 0,0:23:36.37,0:23:37.95,Default,,0,0,0,,Менің байлығым да үлкен хит.
Dialogue: 0,0:23:38.08,0:23:39.66,Default,,0,0,0,,Кез келген жағдайда келесі аптада біз боламыз ба?
Dialogue: 0,0:23:39.83,0:23:42.45,Default,,0,0,0,,Жарайды! Алдын ала қарау дұрыс болды, мен оны көрмеймін!
Dialogue: 0,0:23:42.58,0:23:44.79,Default,,0,0,0,,Күрсін... Мен бұл өлім туы деп ойладым!
Dialogue: 0,0:23:44.87,0:23:46.00,Default,,0,0,0,,Өлетініміз жоқ!
Dialogue: 0,0:23:47.50,0:23:53.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory