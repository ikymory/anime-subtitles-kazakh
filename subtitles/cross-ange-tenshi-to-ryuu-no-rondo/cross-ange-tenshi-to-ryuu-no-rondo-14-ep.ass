Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:18.70,0:00:22.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:22.79,0:00:24.04,Default,,0,0,0,,Біз...
Dialogue: 0,0:00:24.37,0:00:25.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:25.79,0:00:26.95,Default,,0,0,0,,Мен Мен!
Dialogue: 0,0:00:28.20,0:00:29.12,Default,,0,0,0,,Вивиан?
Dialogue: 0,0:00:29.62,0:00:32.41,Default,,0,0,0,,Иә! Гаон
Dialogue: 0,0:00:32.58,0:00:34.08,Default,,0,0,0,,Бұл тағы да болды...
Dialogue: 0,0:00:35.25,0:00:36.45,Default,,0,0,0,,Еш жері ауырмайды ма?
Dialogue: 0,0:00:36.75,0:00:37.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:39.41,0:00:41.50,Default,,0,0,0,,Тапсырма... Ха!
Dialogue: 0,0:00:42.50,0:00:47.25,Default,,0,0,0,,Біз теңізде болуымыз керек еді... Ах...
Dialogue: 0,0:00:53.41,0:00:54.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:59.66,0:01:01.79,Default,,0,0,0,,Мұнда... қайда?
Dialogue: 0,0:01:04.75,0:01:16.91,Default,,0,0,0,,Қараңғылық үшін дұға ет...
Dialogue: 0,0:01:19.29,0:01:24.75,Default,,0,0,0,,Бұл дүние елес
Dialogue: 0,0:01:24.87,0:01:30.45,Default,,0,0,0,,Білсең де, болашағыңды нұрландыр
Dialogue: 0,0:01:30.58,0:01:35.50,Default,,0,0,0,,Кейінгі кескіндер жоқ
Dialogue: 0,0:01:35.66,0:01:41.91,Default,,0,0,0,,Мен сізге күш пен батылдық бергім келеді
Dialogue: 0,0:01:42.08,0:01:45.12,Default,,0,0,0,,Күресу
Dialogue: 0,0:01:45.20,0:01:47.83,Default,,0,0,0,,Кек сақтама
Dialogue: 0,0:01:47.95,0:01:50.79,Default,,0,0,0,,Тағдырдан тыс
Dialogue: 0,0:01:50.91,0:01:52.79,Default,,0,0,0,,Тұр
Dialogue: 0,0:01:53.00,0:01:59.33,Default,,0,0,0,,Үмітсіздік сіздің арғы желіңіз болсын...
Dialogue: 0,0:02:00.50,0:02:06.37,Default,,0,0,0,,Оян, әлі ауырып тұр
Dialogue: 0,0:02:06.50,0:02:12.00,Default,,0,0,0,,Шынайы Аян
Dialogue: 0,0:02:12.08,0:02:19.62,Default,,0,0,0,,Мәңгілік басы мен соңы
Dialogue: 0,0:02:19.75,0:02:26.37,Default,,0,0,0,,Мифтен де әдемі...
Dialogue: 0,0:02:32.75,0:02:35.75,Default,,0,0,0,,Бұл Андж Арзенал, жауап беріңіз.
Dialogue: 0,0:02:36.12,0:02:38.83,Default,,0,0,0,,Арзенал... Тірі болса жауап беріңізші!
Dialogue: 0,0:02:38.87,0:02:39.91,Default,,0,0,0,,Цунцун…
Dialogue: 0,0:02:40.29,0:02:43.75,Default,,0,0,0,,Момока! Хилда! Кім болса да жауап беріңізші!
Dialogue: 0,0:02:47.45,0:02:49.29,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:02:49.54,0:02:53.54,Default,,0,0,0,,Менікі де жақсы емес. Барлық жиіліктерге жауап жоқ.
Dialogue: 0,0:02:54.00,0:02:56.33,Default,,0,0,0,,5км радиуста қозғалыс реакциясы жоқ
Dialogue: 0,0:02:57.12,0:02:58.83,Default,,0,0,0,,Позиция сенсоры да жұмыс істемейді
Dialogue: 0,0:02:59.75,0:03:04.50,Default,,0,0,0,,Менің білуімше, Арзеналға жақын жерде мұндай жер жоқ.
Dialogue: 0,0:03:04.91,0:03:06.95,Default,,0,0,0,,Бұл баяғыдан қалған қиранды емес пе?
Dialogue: 0,0:03:07.33,0:03:09.45,Default,,0,0,0,,Адамдар әлі соғысып жатқан кезде
Dialogue: 0,0:03:10.08,0:03:13.58,Default,,0,0,0,,Мен мұндай жер қалғанын естімеппін.
Dialogue: 0,0:03:14.58,0:03:19.08,Default,,0,0,0,,Сонымен, біз ешкім білмейтін белгісіз әлемге жіберілдік пе?
Dialogue: 0,0:03:22.79,0:03:24.87,Default,,0,0,0,,Бұл Виркис болса, мүмкін.
Dialogue: 0,0:03:25.20,0:03:26.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:26.62,0:03:28.91,Default,,0,0,0,,Сол кездегі оның шығарған сәулесі
Dialogue: 0,0:03:29.95,0:03:33.37,Default,,0,0,0,,Мүмкін Вилкис сізді сол жарықтан қорғау үшін бірдеңе жасаған шығар.
Dialogue: 0,0:03:35.16,0:03:36.83,Default,,0,0,0,,Vilquis – арнайы машина.
Dialogue: 0,0:03:37.79,0:03:39.54,Default,,0,0,0,,Не болғаны таңқаларлық емес
Dialogue: 0,0:03:39.91,0:03:44.70,Default,,0,0,0,,бұл... жарайды, бұл ерекше... дұрыс...
Dialogue: 0,0:03:45.12,0:03:45.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:46.41,0:03:48.50,Default,,0,0,0,,Сіз оны түзете аласыз ба?
Dialogue: 0,0:03:48.95,0:03:50.95,Default,,0,0,0,,Әйтеуір мен ұша аламын
Dialogue: 0,0:03:51.41,0:03:52.41,Default,,0,0,0,,Олай болса өтінемін
Dialogue: 0,0:03:53.08,0:03:53.62,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:03:54.41,0:03:57.33,Default,,0,0,0,,Барлау Жау әлі де болуы мүмкін.
Dialogue: 0,0:03:58.41,0:03:59.70,Default,,0,0,0,,Бізді жай ғана адастырды!
Dialogue: 0,0:04:02.41,0:04:03.16,Default,,0,0,0,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:04:04.08,0:04:04.75,Default,,0,0,0,,Иә
Dialogue: 0,0:04:05.33,0:04:06.83,Default,,0,0,0,,Анге Анге
Dialogue: 0,0:04:06.87,0:04:07.45,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:04:07.66,0:04:09.04,Default,,0,0,0,,Маған мін
Dialogue: 0,0:04:10.04,0:04:12.04,Default,,0,0,0,,Жүріңіз... айтасыз ба?
Dialogue: 0,0:04:12.25,0:04:13.20,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:13.70,0:04:16.45,Default,,0,0,0,,Мен сенің айдаһар екеніңді білмедім...
Dialogue: 0,0:04:16.83,0:04:18.16,Default,,0,0,0,,Маған айтпа
Dialogue: 0,0:04:31.58,0:04:32.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:35.12,0:04:36.91,Default,,0,0,0,,Бұл қай жерде...
Dialogue: 0,0:04:38.04,0:04:38.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:39.29,0:04:41.66,Default,,0,0,0,,Вивиан бар! Соған қарай жүр!
Dialogue: 0,0:04:41.95,0:04:43.00,Default,,0,0,0,,Алдым!
Dialogue: 0,0:04:45.83,0:04:46.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:47.33,0:04:50.37,Default,,0,0,0,,Өйткені, бұл Акацуки но Онбашира...
Dialogue: 0,0:04:51.37,0:04:54.12,Default,,0,0,0,,Мисуруги империясы? Мұнда?
Dialogue: 0,0:04:54.37,0:04:56.62,Default,,0,0,0,,Нг…гуг…
Dialogue: 0,0:04:56.70,0:04:59.75,Default,,0,0,0,,Сарай мен қала таза да, таза еді, бірақ...
Dialogue: 0,0:05:01.50,0:05:03.37,Default,,0,0,0,,Бұл Акацуки но Онбашира болды.
Dialogue: 0,0:05:03.58,0:05:05.12,Default,,0,0,0,,Мені қате түсінуге мүмкіндік жоқ.
Dialogue: 0,0:05:05.54,0:05:06.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:06.70,0:05:08.87,Default,,0,0,0,,Бірақ... біртүрлі екен.
Dialogue: 0,0:05:09.00,0:05:09.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:09.91,0:05:16.16,Default,,0,0,0,,Оңбашира да, қала да әлдеқашан қирағандай болды.
Dialogue: 0,0:05:16.45,0:05:17.29,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:05:17.87,0:05:23.50,Default,,0,0,0,,Біз ес-түссіз жатқанда жүздеген жылдар өтті ме? Амал жоқ
Dialogue: 0,0:05:23.95,0:05:26.00,Default,,0,0,0,,Мен қалжыңдамаймын!
Dialogue: 0,0:05:26.50,0:05:27.75,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:05:27.87,0:05:29.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:31.20,0:05:32.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:33.33,0:05:38.41,Default,,0,0,0,,Бұл Астананы қорғау ұйымы. Аман қалғандар бар ма?
Dialogue: 0,0:05:38.87,0:05:41.20,Default,,0,0,0,,Тірі қалғандар бар ма?
Dialogue: 0,0:05:41.45,0:05:44.29,Default,,0,0,0,,Капитал №3 Баспана әлі де жұмыс істейді
Dialogue: 0,0:05:44.54,0:05:47.08,Default,,0,0,0,,Біз тұрғын үйден көшірілгендерміз.
Dialogue: 0,0:05:47.62,0:05:50.95,Default,,0,0,0,,Аман қалғандар, Орталық саябаққа келіңіздер.
Dialogue: 0,0:05:51.04,0:05:52.16,Default,,0,0,0,,Тірі қалған?
Dialogue: 0,0:05:52.45,0:05:53.41,Default,,0,0,0,,Кеттік
Dialogue: 0,0:05:57.95,0:05:58.95,Default,,0,0,0,,Уолтер Эванс (59)
Dialogue: 0,0:05:59.62,0:06:03.08,Default,,0,0,0,,Ха ха ха ха ха ха ха...
Dialogue: 0,0:06:03.16,0:06:04.79,Default,,0,0,0,,Мұнда тірі қалғандар бар ма?
Dialogue: 0,0:06:05.20,0:06:07.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:07.70,0:06:11.00,Default,,0,0,0,,Биологиялық реакцияны растау Контейнер басталады
Dialogue: 0,0:06:12.83,0:06:13.54,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:06:16.50,0:06:18.83,Default,,0,0,0,,Астанадағы №3 баспанаға қош келдіңіз
Dialogue: 0,0:06:19.16,0:06:22.54,Default,,0,0,0,,Капитал қорғаныс ұйымы сізді қарсы алады.
Dialogue: 0,0:06:23.04,0:06:28.79,Default,,0,0,0,,Capital Shelter 3-ке қош келдіңіз. Капитал қорғаныс ұйымы сізді қарсы алады.
Dialogue: 0,0:06:31.29,0:06:36.08,Default,,0,0,0,,Қазіргі уақытта біздің баспанада 1,7% артық орын бар.
Dialogue: 0,0:06:36.58,0:06:38.54,Default,,0,0,0,,Таңдаулы аймақты таңдаңыз
Dialogue: 0,0:06:38.79,0:06:39.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:40.91,0:06:42.87,Default,,0,0,0,,Жайлы өмір сүріңіз.
Dialogue: 0,0:06:43.75,0:06:45.16,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:51.75,0:06:53.75,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:06:54.95,0:06:58.87,Default,,0,0,0,,Бұрын қайда болдың? Шығып, түсіндіріп беріңізші!
Dialogue: 0,0:06:59.54,0:07:03.58,Default,,0,0,0,,Бұл «Himawari» басқару компьютері Кез келген сұрақтарыңызды қойыңыз.
Dialogue: 0,0:07:03.91,0:07:06.08,Default,,0,0,0,,Компьютер... Бұл болды ма?
Dialogue: 0,0:07:06.12,0:07:09.70,Default,,0,0,0,,Бұл нені білдіреді? Тірі адам жоқ па?
Dialogue: 0,0:07:10.41,0:07:13.25,Default,,0,0,0,,Не болды? Не болды?
Dialogue: 0,0:07:13.79,0:07:17.70,Default,,0,0,0,,Сұрақ қабылданды. Жауап ретін енгізіңіз.
Dialogue: 0,0:07:23.58,0:07:24.37,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:07:26.95,0:07:29.16,Default,,0,0,0,,Бұл не... фильм?
Dialogue: 0,0:07:29.45,0:07:31.62,Default,,0,0,0,,Нақты жазылған бейне
Dialogue: 0,0:07:32.50,0:07:36.08,Default,,0,0,0,,Біріктірілген экономикалық одақ және жалпыконтиненттік альянс бойынша
Dialogue: 0,0:07:36.20,0:07:41.04,Default,,0,0,0,,Халықтар арасындағы кең ауқымды соғыс… «7-дүниежүзілік соғыс» «Рагнарек»
Dialogue: 0,0:07:41.33,0:07:43.79,Default,,0,0,0,,Осы соғысқа байланысты «Д.Соғыс» деп те аталады.
Dialogue: 0,0:07:44.08,0:07:47.58,Default,,0,0,0,,Жер халқының саны 11%-ға дейін азайды
Dialogue: 0,0:07:47.66,0:07:48.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:48.12,0:07:53.41,Default,,0,0,0,,Тығырықтан шығу үшін коалиция Ragnamail абсолютті қаруын орналастырады.
Dialogue: 0,0:07:53.62,0:07:54.41,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:57.62,0:07:59.58,Default,,0,0,0,,Қара... Вилкис!
Dialogue: 0,0:08:01.62,0:08:02.58,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,0:08:03.33,0:08:05.20,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:08:12.62,0:08:13.62,Default,,0,0,0,,Уф
Dialogue: 0,0:08:25.12,0:08:27.20,Default,,0,0,0,,Осылайша шайқас аяқталады
Dialogue: 0,0:08:27.70,0:08:27.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:28.08,0:08:31.50,Default,,0,0,0,,Дегенмен, Рагнамайлдың өлшемді резонанстық қаруына байланысты,
Dialogue: 0,0:08:31.75,0:08:35.25,Default,,0,0,0,,Жердегі барлық Dragonium реакторлары резонанспен жарылады.
Dialogue: 0,0:08:42.41,0:08:46.66,Default,,0,0,0,,Бүкіл жер шары ластанған ортаға айналды, онда өмір сүру қиын.
Dialogue: 0,0:08:46.70,0:08:48.95,Default,,0,0,0,,Барлық өркениеттер күйреді
Dialogue: 0,0:08:49.62,0:08:52.25,Default,,0,0,0,,Міне. Басқа сұрақтарыңыз бар ма?
Dialogue: 0,0:08:52.70,0:08:55.20,Default,,0,0,0,,Дүние жойылды...
Dialogue: 0,0:08:55.66,0:08:58.58,Default,,0,0,0,,Бұл не... бұл не деген әзіл...
Dialogue: 0,0:08:59.50,0:09:02.33,Default,,0,0,0,,Ақымақ сияқты! Сіз бұл туралы қашан айтасыз?
Dialogue: 0,0:09:02.70,0:09:04.54,Default,,0,0,0,,538 жыл бұрын
Dialogue: 0,0:09:04.79,0:09:05.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:06.08,0:09:09.66,Default,,0,0,0,,538 жыл 193 күн бұрын
Dialogue: 0,0:09:10.95,0:09:14.66,Default,,0,0,0,,Дүние жүзіндегі 20 976 баспанада
Dialogue: 0,0:09:14.87,0:09:17.87,Default,,0,0,0,,Жылу қозғалысы Тіршілік реакциясы жоқ
Dialogue: 0,0:09:18.58,0:09:23.45,Default,,0,0,0,,Қазіргі уақытта жер бетінде екі-ақ адам өмір сүреді... екеуің.
Dialogue: 0,0:09:25.54,0:09:28.66,Default,,0,0,0,,Хаха... 500 жыл...
Dialogue: 0,0:09:29.50,0:09:31.66,Default,,0,0,0,,500 жылдан кейін әріптер өзгере ме?
Dialogue: 0,0:09:32.83,0:09:34.83,Default,,0,0,0,,Сіз бұл суретті әңгімеге сенесіз бе?
Dialogue: 0,0:09:35.45,0:09:38.08,Default,,0,0,0,,Сол қаңқаларға қарасаңыз...
Dialogue: 0,0:09:38.62,0:09:40.70,Default,,0,0,0,,Мұның бәрі ойдан шығарылған шығар, солай ма?
Dialogue: 0,0:09:41.54,0:09:43.25,Default,,0,0,0,,Неге олай істедің...
Dialogue: 0,0:09:43.45,0:09:43.91,Default,,0,0,0,,Уф
Dialogue: 0,0:09:44.25,0:09:45.87,Default,,0,0,0,,Мен бұл туралы білмеймін!
Dialogue: 0,0:09:46.45,0:09:48.75,Default,,0,0,0,,Мен өз көзіммен көргеніме ғана сенемін!
Dialogue: 0,0:09:49.50,0:09:50.87,Default,,0,0,0,,Вивиан, мені айдап бер!
Dialogue: 0,0:09:51.16,0:09:52.04,Default,,0,0,0,,Хоикита!
Dialogue: 0,0:09:52.41,0:09:54.75,Default,,0,0,0,,Ооооо...
Dialogue: 0,0:09:56.83,0:09:57.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:10.41,0:10:15.33,Default,,0,0,0,,Бұл 500 жылдан кейінгі болашақ болуы мүмкін емес.
Dialogue: 0,0:10:16.70,0:10:18.58,Default,,0,0,0,,Сондай күлкілі оқиға...
Dialogue: 0,0:10:20.29,0:10:24.12,Default,,0,0,0,,Сәлем Вивиан? Мен әлі солтүстікке барған жоқпын.
Dialogue: 0,0:10:24.41,0:10:26.83,Default,,0,0,0,,Эй, оян! қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:10:26.95,0:10:28.37,Default,,0,0,0,,Кю…
Dialogue: 0,0:10:28.45,0:10:30.37,Default,,0,0,0,,Вивиан, оян!
Dialogue: 0,0:10:30.45,0:10:32.66,Default,,0,0,0,,Анге, өзіңізді күштемеңіз.
Dialogue: 0,0:10:32.91,0:10:33.75,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:34.33,0:10:35.87,Default,,0,0,0,,Оян, түкке тұрғысыз!
Dialogue: 0,0:10:36.08,0:10:36.66,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:37.20,0:10:38.16,Default,,0,0,0,,Кезек
Dialogue: 0,0:10:38.25,0:10:39.66,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:10:39.87,0:10:40.83,Default,,0,0,0,,Жібер!
Dialogue: 0,0:10:41.00,0:10:42.75,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:45.66,0:10:47.41,Default,,0,0,0,,Сәл демалу керек.
Dialogue: 0,0:10:47.79,0:10:49.12,Default,,0,0,0,,Үзіліс кезінде не болады?
Dialogue: 0,0:10:49.70,0:10:52.25,Default,,0,0,0,,Сіз мені осы бейтаныс жерде қалуымды сұрайсыз ба?
Dialogue: 0,0:10:53.00,0:10:56.12,Default,,0,0,0,,Мен көз жеткізгім келеді! Арзеналға не болды
Dialogue: 0,0:10:56.33,0:10:58.25,Default,,0,0,0,,Момока және барлығы қауіпсіз бе?
Dialogue: 0,0:10:58.87,0:11:00.79,Default,,0,0,0,,Ол шынымен өлді ме?
Dialogue: 0,0:11:01.83,0:11:02.66,Default,,0,0,0,,Анге…
Dialogue: 0,0:11:03.41,0:11:06.70,Default,,0,0,0,,Үйге ерте бармасаң, қиналып қаласың, солай ма?
Dialogue: 0,0:11:07.41,0:11:09.00,Default,,0,0,0,,Әлгі әйел күтіп тұр...
Dialogue: 0,0:11:09.95,0:11:12.08,Default,,0,0,0,,Дұрыс па? Виркис рыцарь?
Dialogue: 0,0:11:13.04,0:11:17.41,Default,,0,0,0,,Дұрыс, бұл менің өмірім үшін қымбат болса да, мен Вилькис екеуіңді қорғаймын.
Dialogue: 0,0:11:17.62,0:11:19.54,Default,,0,0,0,,-Либертас үшін -Ух...
Dialogue: 0,0:11:20.16,0:11:24.29,Default,,0,0,0,,Сариямен... Ол тек мені пайдалануды ойлайды.
Dialogue: 0,0:11:24.45,0:11:25.58,Default,,0,0,0,,Әлгі әйелдің иті
Dialogue: 0,0:11:25.83,0:11:28.41,Default,,0,0,0,,Жоқ! Мен сені шын сүйемін...
Dialogue: 0,0:11:29.04,0:11:32.29,Default,,0,0,0,,Үйге бара алмасаң... жақсы емес пе?
Dialogue: 0,0:11:32.66,0:11:33.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:33.45,0:11:38.91,Default,,0,0,0,,Өйткені бұл ең нашар, ең нашар қоқыс стратегиясы... бәрібір ол жұмыс істемейді.
Dialogue: 0,0:11:39.37,0:11:40.12,Default,,0,0,0,,Қоқыс…
Dialogue: 0,0:11:41.66,0:11:45.58,Default,,0,0,0,,Дұрыс па? Әлемді жойып, Норманы босатыңыз
Dialogue: 0,0:11:46.12,0:11:49.70,Default,,0,0,0,,Ол үшін қанша адамды құрбан еткеніңіз маңызды емес.
Dialogue: 0,0:11:50.50,0:11:54.50,Default,,0,0,0,,Одан не құтылуға болады деп ойлаймын...
Dialogue: 0,0:11:57.29,0:12:02.79,Default,,0,0,0,,Сонда менің әке-шешем де қоқыс жәшігіне қосылып, бекер өлді... Солай ма?
Dialogue: 0,0:12:03.08,0:12:04.54,Default,,0,0,0,,(Avdour) Не болды, Польнарефф? (Hol Horse) Уф!
Dialogue: 0,0:12:05.20,0:12:10.62,Default,,0,0,0,,Біз, «қарттар», әлемді Эмбрионнан азат ету үшін көптен бері күресіп келеміз...
Dialogue: 0,0:12:12.29,0:12:13.50,Default,,0,0,0,,Менің әкем мен анам...
Dialogue: 0,0:12:14.16,0:12:19.62,Default,,0,0,0,,Мананы пайдалана алмайтын Норма екеуіміз өмір сүре алатын әлем құру үшін күресу... өлді.
Dialogue: 0,0:12:19.83,0:12:20.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:20.70,0:12:26.54,Default,,0,0,0,,Қайтыс болған достарың да, ата-анаңның сезімі де қоқыс дейсің!
Dialogue: 0,0:12:27.83,0:12:29.20,Default,,0,0,0,,Яғни...
Dialogue: 0,0:12:30.37,0:12:30.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:31.83,0:12:32.41,Default,,0,0,0,,Ах... а
Dialogue: 0,0:12:43.00,0:12:43.66,Default,,0,0,0,,А... у...
Dialogue: 0,0:12:51.62,0:12:52.62,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:12:53.75,0:12:56.83,Default,,0,0,0,,Хмф, оны елемеу балалық...
Dialogue: 0,0:12:58.29,0:13:00.66,Default,,0,0,0,,Ол әрқашан менің...
Dialogue: 0,0:13:04.33,0:13:06.62,Default,,0,0,0,,Бұлай ашуланудың қажеті жоқ...
Dialogue: 0,0:13:08.54,0:13:09.29,Default,,0,0,0,,Ах
Dialogue: 0,0:13:12.08,0:13:16.37,Default,,0,0,0,,Уау, бұл өте сүйкімді! О...
Dialogue: 0,0:13:23.04,0:13:23.70,Default,,0,0,0,,Сәнді дизайнерлік аяқ киім алу үшін жинап жүрген 20 000 йенім...
Dialogue: 0,0:13:29.20,0:13:29.95,Default,,0,0,0,,Ах
Dialogue: 0,0:13:31.75,0:13:32.41,Default,,0,0,0,,Анге?\NМен бұл
Dialogue: 0,0:13:32.62,0:13:33.08,Default,,0,0,0,,Уау
Dialogue: 0,0:13:34.29,0:13:37.41,Default,,0,0,0,,сәйкес келе ме деп ойлаймын
Dialogue: 0,0:13:37.62,0:13:38.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:43.50,0:13:44.20,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:13:49.37,0:13:50.62,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:13:51.16,0:13:55.00,Default,,0,0,0,,Рахмет, шаршаған жоқсың ба? Түскі ас ішейік
Dialogue: 0,0:13:55.33,0:13:55.91,Default,,0,0,0,,Умм
Dialogue: 0,0:13:56.29,0:13:56.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:57.95,0:14:01.54,Default,,0,0,0,,Мм... Кешіріңіз...
Dialogue: 0,0:14:01.95,0:14:06.33,Default,,0,0,0,,Уф! Сіз… кешірім сұрай алдыңыз.
Dialogue: 0,0:14:06.50,0:14:08.20,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:10.95,0:14:11.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:11.70,0:14:14.50,Default,,0,0,0,,Бұл мен... Саған қатты сөйлегенім үшін кешір.
Dialogue: 0,0:14:14.95,0:14:15.75,Default,,0,0,0,,Уууу… Уф!
Dialogue: 0,0:14:15.87,0:14:17.20,Default,,0,0,0,,Әй, Вивиан!
Dialogue: 0,0:14:17.37,0:14:17.95,Default,,0,0,0,,Куу?
Dialogue: 0,0:14:18.29,0:14:21.58,Default,,0,0,0,,Сол кеш үшін кешіріңіз... Мен тым көп айттым.
Dialogue: 0,0:14:22.70,0:14:24.62,Default,,0,0,0,,Вивианға рахмет
Dialogue: 0,0:14:24.87,0:14:26.54,Default,,0,0,0,,Ууу...уууу?
Dialogue: 0,0:14:30.20,0:14:31.04,Default,,0,0,0,,Он алтылық...
Dialogue: 0,0:14:31.29,0:14:32.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:34.25,0:14:36.00,Default,,0,0,0,,Суық болғаны таңқаларлық емес... Ах!
Dialogue: 0,0:14:37.25,0:14:38.29,Default,,0,0,0,,Тапсырма~
Dialogue: 0,0:14:41.12,0:14:42.75,Default,,0,0,0,,Мен керемет нәрсе таптым!
Dialogue: 0,0:14:43.08,0:14:43.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:50.41,0:14:51.75,Default,,0,0,0,,Уау~
Dialogue: 0,0:14:52.08,0:14:55.75,Default,,0,0,0,,Төбесі де бар! Тіпті төсек бар! Монша да бар
Dialogue: 0,0:14:56.83,0:14:59.20,Default,,0,0,0,,Ол керемет түрде сақталған.
Dialogue: 0,0:14:59.58,0:15:02.75,Default,,0,0,0,,Бұл әйгілі дворянның сарайы болса керек!
Dialogue: 0,0:15:03.20,0:15:05.54,Default,,0,0,0,,Мен оны тапқаны үшін Вивианға алғыс айтуым керек.
Dialogue: 0,0:15:05.91,0:15:07.37,Default,,0,0,0,,Ууууу~
Dialogue: 0,0:15:07.58,0:15:11.12,Default,,0,0,0,,Мен шомыламын! Тапсырма Тазалаңыз!
Dialogue: 0,0:15:11.75,0:15:13.41,Default,,0,0,0,,Иә, иә... Ханшайым
Dialogue: 0,0:15:13.95,0:15:20.45,Default,,0,0,0,,Хехехехехехехехехехехе...
Dialogue: 0,0:15:27.29,0:15:29.58,Default,,0,0,0,,N… ku…
Dialogue: 0,0:15:32.79,0:15:34.75,Default,,0,0,0,,Рахмет тапсырма
Dialogue: 0,0:15:35.04,0:15:35.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:36.29,0:15:37.12,Default,,0,0,0,,Әртүрлі заттар
Dialogue: 0,0:15:38.37,0:15:41.83,Default,,0,0,0,,Ол көп нәрсені біледі, үнемі сабырлы.
Dialogue: 0,0:15:41.95,0:15:45.50,Default,,0,0,0,,Мейірімдісің... Мен саған сенемін.
Dialogue: 0,0:15:46.04,0:15:48.08,Default,,0,0,0,,Ах ха-хэ...
Dialogue: 0,0:15:49.16,0:15:50.66,Default,,0,0,0,,Мен алмаймын...
Dialogue: 0,0:15:51.08,0:15:56.04,Default,,0,0,0,,Оңай эмоционалды, қыңыр, дүрбелең
Dialogue: 0,0:15:56.62,0:16:01.04,Default,,0,0,0,,Оған көмектесу мүмкін емес... Мұндай жағдайда кез келген адам мұны жасайды.
Dialogue: 0,0:16:02.45,0:16:06.45,Default,,0,0,0,,Ханшайым Нормаға айналады және айдаһарлармен күресетін сарбазға айналады.
Dialogue: 0,0:16:07.04,0:16:11.33,Default,,0,0,0,,Мен күлкілі қарудың бортында жүргенімді түсінгенде, 500 жылдан кейін...
Dialogue: 0,0:16:12.29,0:16:16.41,Default,,0,0,0,,Дұрыс... тым көп нәрсе бар.
Dialogue: 0,0:16:17.79,0:16:20.50,Default,,0,0,0,,Бірақ бәрі де жаман болған жоқ.
Dialogue: 0,0:16:21.29,0:16:23.29,Default,,0,0,0,,Мен де Вивиан екеуіңмен кездесуім керек...
Dialogue: 0,0:16:24.04,0:16:25.75,Default,,0,0,0,,Мен көп нәрсені білдім
Dialogue: 0,0:16:26.95,0:16:30.33,Default,,0,0,0,,Бірін-бірі соңына дейін түсіне алмағандар да болды...
Dialogue: 0,0:16:33.04,0:16:34.25,Default,,0,0,0,,Сіздің ағаңыз...
Dialogue: 0,0:16:36.66,0:16:37.33,Default,,0,0,0,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:16:37.54,0:16:38.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:38.29,0:16:41.04,Default,,0,0,0,,Бұл эмбрион кім?
Dialogue: 0,0:16:41.91,0:16:44.20,Default,,0,0,0,,Барлық өркениетті көлеңкеден басқарыңыз.
Dialogue: 0,0:16:44.75,0:16:46.95,Default,,0,0,0,,Әлемді басқаратын жоғарғы көшбасшы...
Dialogue: 0,0:16:47.45,0:16:51.12,Default,,0,0,0,,Біз жеңуіміз керек ең күшті және ең үлкен жау... болды...
Dialogue: 0,0:16:51.45,0:16:52.20,Default,,0,0,0,,болды ма?
Dialogue: 0,0:16:52.87,0:16:54.62,Default,,0,0,0,,500 жыл бұрынғы оқиға
Dialogue: 0,0:16:55.25,0:16:56.75,Default,,0,0,0,,Аа... түсіндім...
Dialogue: 0,0:16:56.95,0:17:00.87,Default,,0,0,0,,Хехе... сіз біршама алысқа келдіңіз.
Dialogue: 0,0:17:01.58,0:17:02.83,Default,,0,0,0,,Бірақ мен тірімін
Dialogue: 0,0:17:03.00,0:17:03.75,Default,,0,0,0,,Ах
Dialogue: 0,0:17:03.83,0:17:06.91,Default,,0,0,0,,Тірі болсаң... жақсы боласың.
Dialogue: 0,0:17:09.66,0:17:11.87,Default,,0,0,0,,Ашу күшті.
Dialogue: 0,0:17:12.16,0:17:13.45,Default,,0,0,0,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,0:17:13.79,0:17:15.08,Default,,0,0,0,,Мен сені мақтаймын.
Dialogue: 0,0:17:15.50,0:17:16.70,Default,,0,0,0,,Аздап ұялшақ мектеп кеңесінің төрағасы мен екі жақын дос.
Dialogue: 0,0:17:17.37,0:17:18.62,Default,,0,0,0,,Қазір...
Dialogue: 0,0:17:18.87,0:17:21.87,Default,,0,0,0,,Төсекте жатқаныма көп болды. Қайырлы түн.
Dialogue: 0,0:17:22.33,0:17:23.16,Default,,0,0,0,,Тапсырма қандай?
Dialogue: 0,0:17:24.04,0:17:25.16,Default,,0,0,0,,Мен дәлізде ұйықтаймын
Dialogue: 0,0:17:25.79,0:17:29.37,Default,,0,0,0,,Мұнда бәрі жақсы, диван мен кереует бар.
Dialogue: 0,0:17:29.79,0:17:31.45,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:17:31.91,0:17:32.75,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:17:33.25,0:17:37.58,Default,,0,0,0,,Аа... Ендеше, сөзіңді ал...
Dialogue: 0,0:17:41.20,0:17:43.45,Default,,0,0,0,,Уау~
Dialogue: 0,0:17:43.54,0:17:44.25,Default,,0,0,0,,Куу?
Dialogue: 0,0:17:44.50,0:17:48.16,Default,,0,0,0,,Ахахахаха, не істеп жатырсың?
Dialogue: 0,0:17:48.29,0:17:50.08,Default,,0,0,0,,Ух... хахаха...
Dialogue: 0,0:17:50.25,0:17:51.41,Default,,0,0,0,,Уфуфуфу
Dialogue: 0,0:17:53.95,0:17:55.54,Default,,0,0,0,,Міне... келсең ше?
Dialogue: 0,0:17:56.33,0:17:58.83,Default,,0,0,0,,Күтілгендей, осы уақытқа дейін...
Dialogue: 0,0:18:01.95,0:18:04.08,Default,,0,0,0,,Қандай дыбыс?
Dialogue: 0,0:18:06.16,0:18:07.50,Default,,0,0,0,,Вау!
Dialogue: 0,0:18:09.75,0:18:11.87,Default,,0,0,0,,Бұл шынымен тыныш...
Dialogue: 0,0:18:12.16,0:18:12.95,Default,,0,0,0,,Иә
Dialogue: 0,0:18:13.91,0:18:16.87,Default,,0,0,0,,Дүниеде тек біз ғана...
Dialogue: 0,0:18:17.29,0:18:18.29,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:18:19.04,0:18:19.70,Default,,0,0,0,,Ах
Dialogue: 0,0:18:20.45,0:18:24.16,Default,,0,0,0,,Мен бұл тыныштықты сезінгеніме қанша уақыт болды деп ойлаймын.
Dialogue: 0,0:18:25.70,0:18:28.00,Default,,0,0,0,,Мүмкін ол бізге қашып кетуге мүмкіндік берді.
Dialogue: 0,0:18:28.12,0:18:28.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:29.29,0:18:34.04,Default,,0,0,0,,Вилкис... Соғыссыз әлемде...
Dialogue: 0,0:18:37.62,0:18:38.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:38.54,0:18:44.91,Default,,0,0,0,,Жалпы нәрселер Сіз оларды жай ғана қайталасаңыз да
Dialogue: 0,0:18:46.62,0:18:51.66,Default,,0,0,0,,Жүрегім қайтадан қызып кетті
Dialogue: 0,0:18:51.95,0:18:53.20,Default,,0,0,0,,Неліктен жоқ?
Dialogue: 0,0:18:53.66,0:18:54.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:56.70,0:19:00.25,Default,,0,0,0,,Жоқ, жоқ, жоқ! Мен Виркистің рыцарімін
Dialogue: 0,0:19:00.50,0:19:02.41,Default,,0,0,0,,Мен саған осылай қолымды қойдым!
Dialogue: 0,0:19:03.12,0:19:06.70,Default,,0,0,0,,Мені ұнатпайтын шығарсың...
Dialogue: 0,0:19:06.75,0:19:08.66,Default,,0,0,0,,Бұлай болуы мүмкін емес.
Dialogue: 0,0:19:09.00,0:19:09.66,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:19:09.75,0:19:15.29,Default,,0,0,0,,Сонымен, у... Мен қорқамын...
Dialogue: 0,0:19:16.12,0:19:16.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:17.50,0:19:22.91,Default,,0,0,0,,10 жыл бұрын... е.м, дәлірек айтсақ 548 жыл бұрын...
Dialogue: 0,0:19:24.04,0:19:25.58,Default,,0,0,0,,Либертас сәтсіз аяқталды
Dialogue: 0,0:19:26.66,0:19:30.91,Default,,0,0,0,,Оң қолынан айырылған Алектра енді ешқашан Виркистерге міне алмайды.
Dialogue: 0,0:19:31.50,0:19:33.91,Default,,0,0,0,,Менің ата-анам мен достарым қайтыс болды.
Dialogue: 0,0:19:34.95,0:19:38.04,Default,,0,0,0,,Маған Вилькис рыцарлары ретіндегі миссиям ғана қалды.
Dialogue: 0,0:19:39.29,0:19:41.45,Default,,0,0,0,,Бірақ мен қорықтым...
Dialogue: 0,0:19:42.04,0:19:45.08,Default,,0,0,0,,Көрмеген немесе көрмеген адам үшін күресіп, өл.
Dialogue: 0,0:19:45.54,0:19:46.75,Default,,0,0,0,,Миссия...
Dialogue: 0,0:19:47.79,0:19:50.20,Default,,0,0,0,,Мен... қашып кеттім.
Dialogue: 0,0:19:51.00,0:19:52.29,Default,,0,0,0,,Сол терең орманда
Dialogue: 0,0:19:53.12,0:19:57.45,Default,,0,0,0,,Ұрысуға да, өмір сүруге де себеп таба алмай, қашып кеттім...
Dialogue: 0,0:19:58.29,0:20:00.58,Default,,0,0,0,,Сол кезде... мен сені кездестірдім
Dialogue: 0,0:20:00.62,0:20:01.12,Default,,0,0,0,,Ах
Dialogue: 0,0:20:01.41,0:20:04.12,Default,,0,0,0,,Сіз ұрысып қалдыңыз
Dialogue: 0,0:20:04.58,0:20:07.45,Default,,0,0,0,,Мен кішкентай денеммен қарсы тұрдым
Dialogue: 0,0:20:08.95,0:20:13.00,Default,,0,0,0,,Мен ояндым... Мен... не істеп жатырмын деп ойлаймын
Dialogue: 0,0:20:14.37,0:20:17.87,Default,,0,0,0,,Сол кезде мен рыцарь болудың мағынасын таптым.
Dialogue: 0,0:20:19.20,0:20:20.70,Default,,0,0,0,,Мен жүре алдым
Dialogue: 0,0:20:21.37,0:20:24.62,Default,,0,0,0,,Бұл амалсыз тапсырма емес, бұл менің өз еркім.
Dialogue: 0,0:20:25.70,0:20:30.87,Default,,0,0,0,,Сондықтан мен... Мен сені қорғай алсам, жақсы...
Dialogue: 0,0:20:30.91,0:20:31.75,Default,,0,0,0,,Гетаре
Dialogue: 0,0:20:31.95,0:20:32.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:34.37,0:20:35.95,Default,,0,0,0,,Бірақ таза
Dialogue: 0,0:20:37.70,0:20:38.41,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:20:43.08,0:20:44.16,Default,,0,0,0,,Не... аа...
Dialogue: 0,0:20:46.20,0:20:48.87,Default,,0,0,0,,Мен қанға боядым...
Dialogue: 0,0:20:49.79,0:20:54.66,Default,,0,0,0,,Мен адамдарды өлтірдім, айдаһарды өлтірдім, тіпті ағамды да өлімге жібердім.
Dialogue: 0,0:20:55.83,0:20:59.66,Default,,0,0,0,,Мен қанға, күнәға және өлімге орандым...
Dialogue: 0,0:21:01.16,0:21:03.12,Default,,0,0,0,,Мені қорғау үшін сізде қандай талаптар бар?
Dialogue: 0,0:21:03.54,0:21:04.54,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:21:05.29,0:21:07.62,Default,,0,0,0,,Андж, сен әдемісің!
Dialogue: 0,0:21:08.54,0:21:08.95,Default,,0,0,0,,Ах
Dialogue: 0,0:21:09.75,0:21:14.04,Default,,0,0,0,,Қаншама қан кешсең де, Жаныңда боламын.
Dialogue: 0,0:21:15.20,0:21:19.54,Default,,0,0,0,,Зорлық-зомбылық, каприз және талғампаз, бірақ...
Dialogue: 0,0:21:20.25,0:21:21.33,Default,,0,0,0,,Әлі де?
Dialogue: 0,0:21:21.83,0:21:23.50,Default,,0,0,0,,А, әлі де
Dialogue: 0,0:21:25.54,0:21:26.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:31.20,0:21:32.91,Default,,0,0,0,,Кяаа~
Dialogue: 0,0:21:37.37,0:21:38.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:38.75,0:21:39.45,Default,,0,0,0,,Анге
Dialogue: 0,0:21:40.41,0:21:41.62,Default,,0,0,0,,Уау~
Dialogue: 0,0:21:41.79,0:21:43.54,Default,,0,0,0,,Эй Туск... сен тағы да...
Dialogue: 0,0:21:43.79,0:21:44.54,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:21:44.58,0:21:44.91,Default,,0,0,0,,Уау
Dialogue: 0,0:21:45.16,0:21:46.45,Default,,0,0,0,,Ә? Аймақ па?
Dialogue: 0,0:21:47.66,0:21:50.20,Default,,0,0,0,,Апат дабылын берген сіз болдыңыз ба?
Dialogue: 0,0:21:50.33,0:21:51.16,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:21:53.25,0:21:54.75,Default,,0,0,0,,Айдаһар жасаңыз…
Dialogue: 0,0:21:55.45,0:21:57.91,Default,,0,0,0,,Қош келдіңіздер, жалған адамдар
Dialogue: 0,0:21:59.04,0:22:02.16,Default,,0,0,0,,Біздің әлем, нағыз жер
Dialogue: 0,0:22:03.16,0:22:08.95,Default,,0,0,0,,Түннің сары шымылдығында адасқан
Dialogue: 0,0:22:09.12,0:22:14.58,Default,,0,0,0,,Мен ренжіп қалатын сияқтымын
Dialogue: 0,0:22:14.91,0:22:20.70,Default,,0,0,0,,Жүрексіздіктің қайталанатын толқындары жұтылды
Dialogue: 0,0:22:20.87,0:22:26.20,Default,,0,0,0,,Мен қайшылықты тыныштық іздедім.
Dialogue: 0,0:22:26.33,0:22:31.95,Default,,0,0,0,,Дем ала алмайтындай мені қинайтын шындық
Dialogue: 0,0:22:32.04,0:22:38.04,Default,,0,0,0,,Шындық әрқашан қатып қалады
Dialogue: 0,0:22:38.12,0:22:43.87,Default,,0,0,0,,Жалындаған ғашықтықтай арман болт
Dialogue: 0,0:22:44.12,0:22:49.95,Default,,0,0,0,,Бұл денені күйдіріп, аспанды шуылдатыңыз
Dialogue: 0,0:22:50.04,0:22:53.00,Default,,0,0,0,,Ешкім білмейтін қараңғылықтың арғы жағында
Dialogue: 0,0:22:53.08,0:23:00.16,Default,,0,0,0,,Басын іздеп, Айқайлай берем
Dialogue: 0,0:23:00.29,0:23:01.29,Default,,0,0,0,,Ол келгенше...
Dialogue: 0,0:23:01.37,0:23:07.50,Default,,0,0,0,,Жұмбақ жарқыраған – аты жоқ жұлдыз
Dialogue: 0,0:23:07.58,0:23:13.66,Default,,0,0,0,,Уақыт лабиринтіндегі орнымды жоғалтып алсам да
Dialogue: 0,0:23:13.75,0:23:16.54,Default,,0,0,0,,Көңілсіз есте қаларлық
Dialogue: 0,0:23:16.62,0:23:23.58,Default,,0,0,0,,Сүйкімді күлкі сені мәңгілікке жетелейді
Dialogue: 0,0:23:23.66,0:23:32.58,Default,,0,0,0,,Жаңа әлемге
Dialogue: 0,0:23:34.12,0:23:36.04,Default,,0,0,0,,Андж, біздің жалғыз уақыт бітті.
Dialogue: 0,0:23:36.20,0:23:37.54,Default,,0,0,0,,Мен тағы да сенімен біргемін бе?
Dialogue: 0,0:23:37.75,0:23:39.66,Default,,0,0,0,,Құрамы аз болғандықтан, бұрыштарды кесіп алмаңыз!
Dialogue: 0,0:23:39.75,0:23:41.70,Default,,0,0,0,,Иә? Келесі аптада әдемі әйелдер көп бола ма?
Dialogue: 0,0:23:41.87,0:23:43.25,Default,,0,0,0,,Мүмкін менің гаремім бар шығар~
Dialogue: 0,0:23:43.33,0:23:45.00,Default,,0,0,0,,Менде жоқ, сондықтан мен осы аптада өлемін!
Dialogue: 0,0:23:45.08,0:23:45.95,Default,,0,0,0,,Ах~
Dialogue: 0,0:23:47.45,0:23:53.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory