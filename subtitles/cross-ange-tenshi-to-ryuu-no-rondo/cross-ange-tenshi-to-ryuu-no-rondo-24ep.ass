Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.79,0:00:11.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:11.33,0:00:12.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:15.37,0:00:16.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:17.00,0:00:21.70,Default,,0,0,0,,Оны Эмбрион Рыцарьы деп атағандықтан, мен оның қаншалықты күшті болғанына таң қалдым.
Dialogue: 0,0:00:21.91,0:00:22.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:23.08,0:00:25.87,Default,,0,0,0,,Бұл көңілді қалдырды, Сария.
Dialogue: 0,0:00:29.00,0:00:29.70,Default,,0,0,0,,Джилл...?
Dialogue: 0,0:00:29.95,0:00:33.75,Default,,0,0,0,,Уф... Біраз уақыт өтті, Сария.
Dialogue: 0,0:00:34.58,0:00:36.62,Default,,0,0,0,,Мұнда қазір не үшін келдің?
Dialogue: 0,0:00:37.25,0:00:40.58,Default,,0,0,0,,Мен бір қарияны көруге келдім...
Dialogue: 0,0:00:40.70,0:00:41.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:41.70,0:00:47.87,Default,,0,0,0,,Сіз естіген жоқсыз ба? Әй... Мен Эмбрионның ханымы екенімді естідім.
Dialogue: 0,0:00:48.04,0:00:48.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:49.66,0:00:51.41,Default,,0,0,0,,Тезірек жібере аласыз ба?
Dialogue: 0,0:00:51.91,0:00:54.41,Default,,0,0,0,,Мен сенің сөздеріңе енді сенбеймін
Dialogue: 0,0:00:55.04,0:00:56.87,Default,,0,0,0,,Мен Эмбрио-саманың серімін
Dialogue: 0,0:00:57.41,0:01:00.54,Default,,0,0,0,,Сария, Алмаз раушан рыцарларының қолбасшысы!
Dialogue: 0,0:01:01.33,0:01:03.08,Default,,0,0,0,,Мен сені ол кісіге жібермеймін!
Dialogue: 0,0:01:03.95,0:01:05.95,Default,,0,0,0,,Дұрыс, Андж.
Dialogue: 0,0:01:06.12,0:01:06.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:07.25,0:01:09.75,Default,,0,0,0,,Мен Аураға бара алатын сияқтымын.
Dialogue: 0,0:01:10.04,0:01:12.75,Default,,0,0,0,,А... онда өзіңізді еркін ұстаңыз!
Dialogue: 0,0:01:15.70,0:01:17.37,Default,,0,0,0,,Күте тұр, Андж!
Dialogue: 0,0:01:18.08,0:01:20.29,Default,,0,0,0,,Сіз менің серіктесім боласыз, солай ма?
Dialogue: 0,0:01:20.62,0:01:22.83,Default,,0,0,0,,Жолыма бөгет болсаң, мен сені өлтіремін!
Dialogue: 0,0:01:22.95,0:01:25.08,Default,,0,0,0,,Әй, көріңіз!
Dialogue: 0,0:01:31.75,0:01:43.91,Default,,0,0,0,,Қараңғылық үшін дұға ет...
Dialogue: 0,0:01:46.29,0:01:51.70,Default,,0,0,0,,Бұл дүние елес
Dialogue: 0,0:01:51.83,0:01:57.45,Default,,0,0,0,,Білсең де, болашақты нұрландыр
Dialogue: 0,0:01:57.58,0:02:02.41,Default,,0,0,0,,Кейінгі кескіндер жоқ
Dialogue: 0,0:02:02.54,0:02:08.95,Default,,0,0,0,,Мен сізге күш пен батылдық бергім келеді.
Dialogue: 0,0:02:09.08,0:02:12.12,Default,,0,0,0,,Күресу
Dialogue: 0,0:02:12.20,0:02:14.75,Default,,0,0,0,,Кек сақтама
Dialogue: 0,0:02:14.87,0:02:17.87,Default,,0,0,0,,Тағдырдан тыс
Dialogue: 0,0:02:18.04,0:02:19.70,Default,,0,0,0,,Тұр
Dialogue: 0,0:02:19.83,0:02:26.25,Default,,0,0,0,,Үмітсіздік сіздің арғы желіңіз болсын...
Dialogue: 0,0:02:27.41,0:02:33.29,Default,,0,0,0,,Оян, әлі ауырып тұр
Dialogue: 0,0:02:33.41,0:02:38.95,Default,,0,0,0,,Шынайы Аян
Dialogue: 0,0:02:39.08,0:02:46.58,Default,,0,0,0,,Мәңгілік басы мен соңы
Dialogue: 0,0:02:46.70,0:02:56.95,Default,,0,0,0,,Мифтен де әдемі...
Dialogue: 0,0:03:00.45,0:03:03.50,Default,,0,0,0,,Кеңістік-уақыт синтезінің конвергенция жылдамдығы 83%
Dialogue: 0,0:03:04.12,0:03:06.04,Default,,0,0,0,,10 сағат бағыты № 12
Dialogue: 0,0:03:06.16,0:03:06.79,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:13.04,0:03:15.16,Default,,0,0,0,,Қоңыз отқа ұшады!
Dialogue: 0,0:03:15.79,0:03:19.41,Default,,0,0,0,,Гравитациялық толқын интерферометрінің қарқындылығы 30Тев-тен асады
Dialogue: 0,0:03:20.87,0:03:22.95,Default,,0,0,0,,Келесі, сағат 2-де №5 бағыт
Dialogue: 0,0:03:23.33,0:03:23.87,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:03:24.70,0:03:25.58,Default,,0,0,0,,Маған көмектес~! Гү…
Dialogue: 0,0:03:26.08,0:03:27.83,Default,,0,0,0,,Оң жақтан орда келе жатыр!
Dialogue: 0,0:03:28.08,0:03:28.75,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:34.20,0:03:36.91,Default,,0,0,0,,Тастасам да, бітпейді.
Dialogue: 0,0:03:37.16,0:03:38.83,Default,,0,0,0,,Менің айқайлауға уақытым жоқ.
Dialogue: 0,0:03:39.66,0:03:43.66,Default,,0,0,0,,Бұл кеме барлығын үйлеріне қайтарады, сондықтан оны жақсы қорғаңыз!
Dialogue: 0,0:03:43.95,0:03:44.95,Default,,0,0,0,,Иә, анашым!
Dialogue: 0,0:03:55.00,0:03:57.08,Default,,0,0,0,,Гяаа
Dialogue: 0,0:03:57.20,0:03:58.37,Default,,0,0,0,,перне
Dialogue: 0,0:03:59.75,0:04:00.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:02.79,0:04:05.04,Default,,0,0,0,,Мен оны сұрадым... Саламандин
Dialogue: 0,0:04:10.79,0:04:13.62,Default,,0,0,0,,Мүлдем... босқа қарсылық көрсету.
Dialogue: 0,0:04:14.37,0:04:17.12,Default,,0,0,0,,Дүниенің күйреуін тоқтату мүмкін емес дейді.
Dialogue: 0,0:04:17.95,0:04:18.87,Default,,0,0,0,,Тоқта және маған көрсет!
Dialogue: 0,0:04:20.04,0:04:23.70,Default,,0,0,0,,Себебі мен Анджге бұл дүниені қорғаймын деп уәде бергенмін!
Dialogue: 0,0:04:24.41,0:04:26.04,Default,,0,0,0,,Бейшара!
Dialogue: 0,0:04:29.08,0:04:32.41,Default,,0,0,0,,Анге! Менімен бірге жаңа әлемге кел!
Dialogue: 0,0:04:32.66,0:04:33.16,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:04:34.00,0:04:35.29,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:04:38.83,0:04:39.91,Default,,0,0,0,,Хааааааааааа!
Dialogue: 0,0:04:44.50,0:04:45.16,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:04:45.66,0:04:47.08,Default,,0,0,0,,Я, өте әлсіз!
Dialogue: 0,0:04:55.87,0:04:59.79,Default,,0,0,0,,Мені өлтіруге осы жеткілікті болса... күлдірме!
Dialogue: 0,0:04:59.95,0:05:04.04,Default,,0,0,0,,Марика шыдай алмайды! Мен сені өлтіруім керек!
Dialogue: 0,0:05:04.33,0:05:06.25,Default,,0,0,0,,Өлтіргеннен де жаман болар еді!
Dialogue: 0,0:05:06.41,0:05:07.16,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:07.37,0:05:10.45,Default,,0,0,0,,Мен әлсіз болғандықтан, мені езіп, пайдаланды...
Dialogue: 0,0:05:11.12,0:05:12.37,Default,,0,0,0,,Ақымаққа қара!
Dialogue: 0,0:05:15.75,0:05:19.37,Default,,0,0,0,,Сондықтан Эмбрио-кун мені күшті етті!
Dialogue: 0,0:05:21.54,0:05:22.16,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:25.45,0:05:27.70,Default,,0,0,0,,Laguna Mail және Рыцарь крест
Dialogue: 0,0:05:28.66,0:05:31.29,Default,,0,0,0,,Сіз өзіңізді күштірек болдым деп ойлайсыз ба? Талия?
Dialogue: 0,0:05:31.70,0:05:34.66,Default,,0,0,0,,Эмбрио-сама маған бәрін берді.
Dialogue: 0,0:05:35.08,0:05:38.12,Default,,0,0,0,,Күш, махаббат, бәрі!
Dialogue: 0,0:05:39.91,0:05:42.04,Default,,0,0,0,,Махаббат? Хмм...
Dialogue: 0,0:05:42.75,0:05:44.91,Default,,0,0,0,,Ол ешкімді жақсы көрмейді...
Dialogue: 0,0:05:45.54,0:05:49.00,Default,,0,0,0,,Оны пайдалану үшін жай ғана тамақтандырыңыз және оны сүйіңіз.
Dialogue: 0,0:05:49.33,0:05:50.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:50.41,0:05:54.20,Default,,0,0,0,,Мен де солай ойнап, бәрінен айырылдым...
Dialogue: 0,0:05:54.95,0:05:56.70,Default,,0,0,0,,Оян, Талия!
Dialogue: 0,0:05:57.12,0:06:00.83,Default,,0,0,0,,Айттым ғой... Бір сөзіңізге сенбеймін!
Dialogue: 0,0:06:04.91,0:06:07.62,Default,,0,0,0,,Мені пайдаланған сен болдың!
Dialogue: 0,0:06:08.37,0:06:11.16,Default,,0,0,0,,Ешқашан кір келмейтін сұлулық
Dialogue: 0,0:06:12.54,0:06:15.00,Default,,0,0,0,,Иілгіш аң сияқты тектілік...
Dialogue: 0,0:06:15.79,0:06:17.91,Default,,0,0,0,,Шынымен қолға алуға тұрарлық
Dialogue: 0,0:06:18.16,0:06:18.66,Default,,0,0,0,,Не!
Dialogue: 0,0:06:19.29,0:06:20.45,Default,,0,0,0,,Сіз білмейсіз...
Dialogue: 0,0:06:20.95,0:06:26.00,Default,,0,0,0,,Андждың дабыраған келбеті, туылғандағы келбеті.
Dialogue: 0,0:06:26.20,0:06:27.16,Default,,0,0,0,,Мені сүюге тиіс еді! Мені сүюге тиіс!
Dialogue: 0,0:06:27.41,0:06:28.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:28.62,0:06:31.75,Default,,0,0,0,,Энждің ішкі жамбасындағы меңдердің тіпті саны.
Dialogue: 0,0:06:32.20,0:06:32.75,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:34.50,0:06:37.70,Default,,0,0,0,,Сіз Андж туралы ештеңе білмейсіз...
Dialogue: 0,0:06:38.95,0:06:41.70,Default,,0,0,0,,Ашу - қатыгез және каприз
Dialogue: 0,0:06:42.50,0:06:46.04,Default,,0,0,0,,Жиі күліңіз, тез ашуланыңыз және мүмкіндігінше қатты жылаңыз
Dialogue: 0,0:06:46.58,0:06:48.41,Default,,0,0,0,,Ол ең сүйкімді қыз
Dialogue: 0,0:06:50.04,0:06:54.91,Default,,0,0,0,,Оны қолға үйрету керек пе? Қандай жалғыз адам! Сіз!
Dialogue: 0,0:06:57.70,0:07:00.79,Default,,0,0,0,,Хм... Бұрынғыдай емес сияқтысың.
Dialogue: 0,0:07:01.41,0:07:04.33,Default,,0,0,0,,Иә! Сен... сен Энджге не істедің?
Dialogue: 0,0:07:04.83,0:07:07.50,Default,,0,0,0,,Мен Анджмен соңына дейін қалдым!
Dialogue: 0,0:07:07.66,0:07:08.37,Default,,0,0,0,,Не!
Dialogue: 0,0:07:08.70,0:07:11.66,Default,,0,0,0,,Ол маған қолын тигізді, сүйді, құшақтады!
Dialogue: 0,0:07:12.45,0:07:13.37,Default,,0,0,0,,Үш күн, үш түн!
Dialogue: 0,0:07:18.50,0:07:21.70,Default,,0,0,0,,Менің әйелімді бос әңгімелермен мазақтайсың ба?
Dialogue: 0,0:07:22.25,0:07:27.00,Default,,0,0,0,,Шындық, Андж мен туралы бәрін қабылдады.
Dialogue: 0,0:07:27.75,0:07:32.04,Default,,0,0,0,,Жұмсақ және жылы... оның ең терең жерінде!
Dialogue: 0,0:07:32.25,0:07:33.45,Default,,0,0,0,,Уф!Уф
Dialogue: 0,0:07:36.25,0:07:38.70,Default,,0,0,0,,Мен енді ештеңеден қорықпаймын!
Dialogue: 0,0:07:39.87,0:07:42.20,Default,,0,0,0,,Қандай ұятсыз еліктеушілік.
Dialogue: 0,0:07:43.25,0:07:46.87,Default,,0,0,0,,Мені кешіріңіз... әйелімді қорлағаным үшін...
Dialogue: 0,0:07:48.29,0:07:52.62,Default,,0,0,0,,Сенің болмысың... бүкіл ғаламнан жойылады!
Dialogue: 0,0:08:01.41,0:08:03.75,Default,,0,0,0,,Аура... Бұл Аура!
Dialogue: 0,0:08:08.95,0:08:09.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:15.12,0:08:16.54,Default,,0,0,0,,Қарғыс атсын...! Ха!
Dialogue: 0,0:08:18.58,0:08:20.95,Default,,0,0,0,,Маған кедергі жасама!
Dialogue: 0,0:08:22.70,0:08:25.20,Default,,0,0,0,,Кванттық өріс 17%-ға дейін азайтылды
Dialogue: 0,0:08:29.70,0:08:32.04,Default,,0,0,0,,Өріс бұзылды!
Dialogue: 0,0:08:32.54,0:08:34.50,Default,,0,0,0,,Порт жағында тікелей соққы келеді!
Dialogue: 0,0:08:36.33,0:08:38.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:39.33,0:08:41.29,Default,,0,0,0,,Қарғыс атсын! Жағдай қандай?
Dialogue: 0,0:08:41.87,0:08:43.50,Default,,0,0,0,,Бірінші қозғалтқыш тоқтады!
Dialogue: 0,0:08:43.75,0:08:44.29,Default,,0,0,0,,Не!
Dialogue: 0,0:08:44.79,0:08:46.37,Default,,0,0,0,,Аврора биіктігінің төмендеуі!
Dialogue: 0,0:08:46.58,0:08:47.45,Default,,0,0,0,,Қайта құру!
Dialogue: 0,0:08:48.12,0:08:50.33,Default,,0,0,0,,Жоқ! Мен түсуді тоқтата алмаймын!
Dialogue: 0,0:08:51.25,0:08:53.37,Default,,0,0,0,,Барлығыңыз, соққыға дайындалыңыз!
Dialogue: 0,0:08:57.04,0:08:58.20,Default,,0,0,0,,Кяаа!
Dialogue: 0,0:08:59.08,0:08:59.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:00.33,0:09:01.37,Default,,0,0,0,,Зақымдану жағдайы қандай?
Dialogue: 0,0:09:02.50,0:09:06.66,Default,,0,0,0,,2, 3 және 7 блоктар суға қонған кездегі соққыдан зақымдалған.
Dialogue: 0,0:09:07.12,0:09:09.25,Default,,0,0,0,,Момока, маған ауруды басатын дәрі беріңізші!
Dialogue: 0,0:09:09.75,0:09:10.33,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:09:10.75,0:09:13.29,Default,,0,0,0,,Кванттық өріс жоғалып кетті!
Dialogue: 0,0:09:14.04,0:09:15.45,Default,,0,0,0,,Зениттік қарулар да үнсіз.
Dialogue: 0,0:09:15.66,0:09:17.91,Default,,0,0,0,,Қарғыс атсын! Сіз қарусыз дейсіз бе?
Dialogue: 0,0:09:20.20,0:09:22.45,Default,,0,0,0,,мамыр! Оны түзетуге бола ма?
Dialogue: 0,0:09:22.70,0:09:23.58,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:09:24.00,0:09:25.66,Default,,0,0,0,,20 минутта тазалаңыз!
Dialogue: 0,0:09:25.79,0:09:26.87,Default,,0,0,0,,Мен оны сұрадым!
Dialogue: 0,0:09:31.41,0:09:31.83,Default,,0,0,0,,Өтірікші...
Dialogue: 0,0:09:32.33,0:09:33.50,Default,,0,0,0,,Мэри 12 сағат!
Dialogue: 0,0:09:33.75,0:09:34.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:35.41,0:09:36.16,Default,,0,0,0,,Ахх!
Dialogue: 0,0:09:40.00,0:09:41.08,Default,,0,0,0,,Сіз оны уақытында орындадыңыз ба?
Dialogue: 0,0:09:41.58,0:09:42.79,Default,,0,0,0,,Иерусалим!
Dialogue: 0,0:09:54.50,0:09:56.95,Default,,0,0,0,,Неліктен бұл ойыншықпен көп қиналдың?
Dialogue: 0,0:09:58.37,0:10:00.00,Default,,0,0,0,,Сен кешігіп қалдың, Андж.
Dialogue: 0,0:10:00.54,0:10:01.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:01.20,0:10:03.08,Default,,0,0,0,,Мен оны ойыншық серіктеске қалдырдым.
Dialogue: 0,0:10:03.37,0:10:05.83,Default,,0,0,0,,Ах! аздап! Сіз мұны түсіресіз бе?
Dialogue: 0,0:10:06.45,0:10:09.08,Default,,0,0,0,,Бұл Аураға көмектесудің жалғыз жолы.
Dialogue: 0,0:10:09.70,0:10:11.29,Default,,0,0,0,,Неге бүкіл Аураны ұшырып жібермеске?
Dialogue: 0,0:10:11.75,0:10:14.58,Default,,0,0,0,,Уайымдамаңыз, біз сізді 30% жеңілдікпен түсіреміз.
Dialogue: 0,0:10:15.62,0:10:17.37,Default,,0,0,0,,Олай болса тез орындаңыз!
Dialogue: 0,0:10:18.37,0:10:27.95,Default,,0,0,0,,Желмен ұшқан, элрагна, Тағдырмен келісім жасау
Dialogue: 0,0:10:28.20,0:10:38.50,Default,,0,0,0,,Желге барыңыз Эльрагна гүрілдеген қанаттар
Dialogue: 0,0:10:43.75,0:10:45.62,Default,,0,0,0,,Ха! Бұл ән...
Dialogue: 0,0:10:46.08,0:10:47.33,Default,,0,0,0,,Саламандин мырза...
Dialogue: 0,0:10:48.33,0:10:50.20,Default,,0,0,0,,Менде ештеңе болған жоқ!
Dialogue: 0,0:10:53.37,0:10:57.95,Default,,0,0,0,,Мен ханшайым емеспін, әнді білмеймін, тіпті жүзігім де жоқ...
Dialogue: 0,0:10:58.16,0:11:00.62,Default,,0,0,0,,Қанша талпынсам да, таңдалмады!
Dialogue: 0,0:11:01.25,0:11:03.58,Default,,0,0,0,,Вилкис үшін және сіз үшін!
Dialogue: 0,0:11:05.12,0:11:05.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:06.33,0:11:09.87,Default,,0,0,0,,Эмбрио-сама мені осылай таңдады!
Dialogue: 0,0:11:11.45,0:11:14.75,Default,,0,0,0,,Алектра! Сен маған енді керек емессің!
Dialogue: 0,0:11:18.29,0:11:19.08,Default,,0,0,0,,Гррр…
Dialogue: 0,0:11:19.87,0:11:22.50,Default,,0,0,0,,Күшті болдың ғой... Сария?
Dialogue: 0,0:11:22.66,0:11:23.25,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:25.66,0:11:31.50,Default,,0,0,0,,Ах, мың рет реинкарнация сапары
Dialogue: 0,0:11:31.87,0:11:36.45,Default,,0,0,0,,Қосылған қолдарды іздеу
Dialogue: 0,0:11:36.75,0:11:38.95,Default,,0,0,0,,Жүрек алмасуы
Dialogue: 0,0:11:39.08,0:11:41.62,Default,,0,0,0,,Тыныс алатын жел
Dialogue: 0,0:11:41.91,0:11:45.50,Default,,0,0,0,,-Қарғыс атсын... Ах -Жаңа әлемге ұш
Dialogue: 0,0:11:45.54,0:11:47.08,Default,,0,0,0,,Ах! Бұл ән...?
Dialogue: 0,0:12:00.37,0:12:03.50,Default,,0,0,0,,Кеңістік-уақыт синтезінің конвергенция жылдамдығы 91%
Dialogue: 0,0:12:05.54,0:12:09.04,Default,,0,0,0,,Мэгги! Мен қоймадан таңғыш әкелдім!
Dialogue: 0,0:12:09.58,0:12:11.12,Default,,0,0,0,,Ааа!
Dialogue: 0,0:12:11.37,0:12:12.75,Default,,0,0,0,,Ах! Уф... уф...
Dialogue: 0,0:12:17.58,0:12:18.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:18.87,0:12:20.45,Default,,0,0,0,,Хаха...
Dialogue: 0,0:12:20.91,0:12:22.50,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:12:22.91,0:12:25.41,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:12:25.54,0:12:26.08,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:26.91,0:12:27.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:28.25,0:12:30.62,Default,,0,0,0,,Виви-чан, екеуіңді алып қаш!
Dialogue: 0,0:12:31.00,0:12:31.66,Default,,0,0,0,,Иерусалим!
Dialogue: 0,0:12:34.70,0:12:36.20,Default,,0,0,0,,Міне, дискілер!
Dialogue: 0,0:12:43.41,0:12:43.91,Default,,0,0,0,,Уф...!
Dialogue: 0,0:12:45.66,0:12:46.95,Default,,0,0,0,,Елшар!
Dialogue: 0,0:12:47.37,0:12:48.62,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:12:49.37,0:12:51.45,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:12:58.79,0:12:59.50,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:59.62,0:13:00.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:01.04,0:13:02.91,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:13:03.62,0:13:07.62,Default,,0,0,0,,Кеңістік-уақыттың бірігуіне байланысты болуы мүмкін, гравитациялық өріс әлсірейді.
Dialogue: 0,0:13:08.16,0:13:10.54,Default,,0,0,0,,Ерекшелік табиғи түрде шығарылған шығар.
Dialogue: 0,0:13:11.04,0:13:14.95,Default,,0,0,0,,Естідің бе, өтірік...жоқ, Норма халқы?
Dialogue: 0,0:13:16.12,0:13:16.45,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:16.75,0:13:19.83,Default,,0,0,0,,Мен Аураның ғибадатхана қызымын, Аура Мидгардия.
Dialogue: 0,0:13:20.45,0:13:21.58,Default,,0,0,0,,Бас діни қызметкер!
Dialogue: 0,0:13:22.16,0:13:25.37,Default,,0,0,0,,Аура халқы бұдан былай сіздің кемеңізге қолдау көрсетеді!
Dialogue: 0,0:13:28.16,0:13:29.75,Default,,0,0,0,,Керемет!
Dialogue: 0,0:13:41.50,0:13:43.75,Default,,0,0,0,,Уау! Керемет!
Dialogue: 0,0:13:50.04,0:13:52.70,Default,,0,0,0,,Қалыптастырудың кері өзгеруі қандай! Эмбрион!
Dialogue: 0,0:13:53.66,0:13:54.87,Default,,0,0,0,,Соған ұқсайды ма?
Dialogue: 0,0:14:00.37,0:14:02.41,Default,,0,0,0,,Эмбрион! Не...?
Dialogue: 0,0:14:05.66,0:14:06.45,Default,,0,0,0,,Крис!
Dialogue: 0,0:14:08.16,0:14:08.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:10.04,0:14:10.95,Default,,0,0,0,,​​О?
Dialogue: 0,0:14:11.08,0:14:12.20,Default,,0,0,0,,Гяаааа
Dialogue: 0,0:14:12.41,0:14:13.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:13.33,0:14:14.29,Default,,0,0,0,,Эмбрион мырза
Dialogue: 0,0:14:14.50,0:14:15.54,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:16.08,0:14:19.91,Default,,0,0,0,,Балалар, маған уақыт сатып алыңдар.
Dialogue: 0,0:14:20.08,0:14:21.62,Default,,0,0,0,,Ооооооо
Dialogue: 0,0:14:23.04,0:14:24.91,Default,,0,0,0,,Бақылаудан тыс!
Dialogue: 0,0:14:25.87,0:14:28.20,Default,,0,0,0,,Ууууууууууууууууууууууууууууу!
Dialogue: 0,0:14:29.08,0:14:29.66,Default,,0,0,0,,Таня!
Dialogue: 0,0:14:32.41,0:14:33.29,Default,,0,0,0,,Ирма!
Dialogue: 0,0:14:33.66,0:14:35.37,Default,,0,0,0,,Достарыңды алаяқ ретінде пайдаландың ба?
Dialogue: 0,0:14:36.16,0:14:42.79,Default,,0,0,0,,Мен қалыңдықты алуға баруым керек... Қалғанын мен шешемін, бәрің.
Dialogue: 0,0:14:45.95,0:14:47.16,Default,,0,0,0,,Құрметті Эмбрион!
Dialogue: 0,0:14:48.70,0:14:49.66,Default,,0,0,0,,Талия!
Dialogue: 0,0:14:52.04,0:14:52.91,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:54.79,0:14:59.04,Default,,0,0,0,,Бұл эмбрионның шынайы табиғаты. Оян, Сария...!
Dialogue: 0,0:15:00.00,0:15:03.29,Default,,0,0,0,,Мен сияқты... Бәрін жоғалтқанша
Dialogue: 0,0:15:05.62,0:15:06.87,Default,,0,0,0,,Алектра! Ах!
Dialogue: 0,0:15:14.41,0:15:17.87,Default,,0,0,0,,Өтірік... Бұл өтірік, Эмбрио-кун.
Dialogue: 0,0:15:19.50,0:15:25.66,Default,,0,0,0,,Тағы да тасталған... Тағы да сатқындық! Увааааааааааааааа!
Dialogue: 0,0:15:27.37,0:15:32.29,Default,,0,0,0,,Мен енді ештеңеге сенбеймін! Барлығы өледі!
Dialogue: 0,0:15:34.87,0:15:35.62,Default,,0,0,0,,Крис!
Dialogue: 0,0:15:35.87,0:15:39.12,Default,,0,0,0,,Өл! Өл! Барлығы өлуі керек!
Dialogue: 0,0:15:42.20,0:15:43.50,Default,,0,0,0,,Тоқта, Крис!
Dialogue: 0,0:15:44.12,0:15:45.33,Default,,0,0,0,,Келме! Өлме!
Dialogue: 0,0:15:48.83,0:15:55.50,Default,,0,0,0,,Бұл жақсы емес! Доспын деп жүрген адамдар шынымен дос бола алмайды!
Dialogue: 0,0:15:55.75,0:15:57.58,Default,,0,0,0,,Алданып қал, ақымақ!
Dialogue: 0,0:15:57.62,0:15:58.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:00.04,0:16:04.16,Default,,0,0,0,,Себебі сен... бәрің мені тастап кеттіңдер!
Dialogue: 0,0:16:04.41,0:16:06.62,Default,,0,0,0,,Мен сені тастап кеткен жоқпын!
Dialogue: 0,0:16:08.37,0:16:11.08,Default,,0,0,0,,Сен осылай айтқаның үшін мені ақымақ қылдың...
Dialogue: 0,0:16:12.50,0:16:18.41,Default,,0,0,0,,Мен қанша қиналып, қиналып жүргенімді неге түсінбейсің?
Dialogue: 0,0:16:20.66,0:16:25.33,Default,,0,0,0,,Сіз шағымданасыз! Ей, қара жүрек шіркін, уайымдама!
Dialogue: 0,0:16:26.37,0:16:26.83,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:27.00,0:16:29.37,Default,,0,0,0,,Дұрыс, мен айтпасам түсінбейсің!
Dialogue: 0,0:16:30.16,0:16:32.20,Default,,0,0,0,,Өйткені мен ақымақпын!
Dialogue: 0,0:16:33.33,0:16:34.70,Default,,0,0,0,,Бұл келе жатыр!
Dialogue: 0,0:16:36.08,0:16:36.75,Default,,0,0,0,,Розали!
Dialogue: 0,0:16:37.33,0:16:39.54,Default,,0,0,0,,Коннооооооо!
Dialogue: 0,0:16:39.58,0:16:40.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:41.37,0:16:42.12,Default,,0,0,0,,Крис!
Dialogue: 0,0:16:42.25,0:16:42.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:43.08,0:16:44.29,Default,,0,0,0,,Гү…
Dialogue: 0,0:16:45.95,0:16:48.83,Default,,0,0,0,,Жібер! О, құлап жатыр!
Dialogue: 0,0:16:49.20,0:16:51.45,Default,,0,0,0,,Жақсы, мен сенімен бірге өлемін.
Dialogue: 0,0:16:51.91,0:16:54.20,Default,,0,0,0,,Ах! Хмм
Dialogue: 0,0:16:55.20,0:16:58.37,Default,,0,0,0,,Маған сен керексің
Dialogue: 0,0:16:58.58,0:16:59.58,Default,,0,0,0,,Розали...?
Dialogue: 0,0:17:00.33,0:17:02.91,Default,,0,0,0,,Мен сені жақсы көремін, Крис.
Dialogue: 0,0:17:03.41,0:17:05.95,Default,,0,0,0,,Мен туралы... сен мені тастап кетсең де
Dialogue: 0,0:17:06.00,0:17:09.95,Default,,0,0,0,,Мені тастама! Маған сеніңіз, Крис...
Dialogue: 0,0:17:10.66,0:17:13.50,Default,,0,0,0,,Мен сені тастап кете алмаймын!
Dialogue: 0,0:17:13.87,0:17:14.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:14.91,0:17:16.54,Default,,0,0,0,,Бұл тек біз емес...
Dialogue: 0,0:17:17.08,0:17:19.91,Default,,0,0,0,,Кеуделеріңіздің көлемі және әлсіз тұстарыңыз.
Dialogue: 0,0:17:20.33,0:17:23.29,Default,,0,0,0,,Ол хесокуридің қайда жасырылғанын да біледі!
Dialogue: 0,0:17:23.83,0:17:25.25,Default,,0,0,0,,Роза... Қайта...
Dialogue: 0,0:17:25.83,0:17:27.62,Default,,0,0,0,,Маған тағы да сеніңіз...
Dialogue: 0,0:17:28.08,0:17:31.95,Default,,0,0,0,,Қайтадан менің досым болшы, Крис!
Dialogue: 0,0:17:32.20,0:17:33.25,Default,,0,0,0,,Ха...
Dialogue: 0,0:17:33.33,0:17:35.04,Default,,0,0,0,,Диееееееееееееееееееееееееееееее!
Dialogue: 0,0:17:42.58,0:17:45.20,Default,,0,0,0,,Кешіріңіз... Кешіріңіз Крис...
Dialogue: 0,0:17:46.16,0:17:50.20,Default,,0,0,0,,Мен сені кешірмеймін...сен маған жаңа шаш қыстырғыш сатып алғанша.
Dialogue: 0,0:17:50.58,0:17:52.79,Default,,0,0,0,,Мен сізге ең жақсысын сатып аламын!
Dialogue: 0,0:17:53.54,0:17:56.00,Default,,0,0,0,,Ойын ойнағанда алдайсыз ба?
Dialogue: 0,0:17:56.45,0:17:57.08,Default,,0,0,0,,(Тодороки) Оған өз қалауынша сол күшті босатуға жол беру қауіпті
Dialogue: 0,0:17:58.45,0:18:01.12,Default,,0,0,0,,Ваннадағы бірінші нәрсе... оны маған бере аласыз ба?
Dialogue: 0,0:18:01.62,0:18:02.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:03.29,0:18:07.16,Default,,0,0,0,,Бірақ мен... қайтару мүмкін емес нәрсе жасадым...
Dialogue: 0,0:18:08.16,0:18:11.70,Default,,0,0,0,,Мариканың бейітін сатып алып, оны өмір бойы есте сақтайық.
Dialogue: 0,0:18:12.45,0:18:13.62,Default,,0,0,0,,Бұл біз
Dialogue: 0,0:18:14.50,0:18:15.62,Default,,0,0,0,,Ақымақ сияқты...
Dialogue: 0,0:18:16.08,0:18:19.95,Default,,0,0,0,,Дүниенің ақыры жақындағанда біз не істеп жатырмыз?
Dialogue: 0,0:18:20.83,0:18:22.54,Default,,0,0,0,,Татуласу... дұрыс па?
Dialogue: 0,0:18:23.12,0:18:25.33,Default,,0,0,0,,А, бұл менің желісім!
Dialogue: 0,0:18:25.75,0:18:32.16,Default,,0,0,0,,Ух... вааааааааа...
Dialogue: 0,0:18:35.79,0:18:42.04,Default,,0,0,0,,Жаңа әлемге ұшыңыз
Dialogue: 0,0:18:46.83,0:18:48.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:59.75,0:19:03.87,Default,,0,0,0,,Пә! Енді маған мұны сұрама.
Dialogue: 0,0:19:04.16,0:19:06.04,Default,,0,0,0,,Ах! Аура!
Dialogue: 0,0:19:11.37,0:19:12.50,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:13.54,0:19:17.00,Default,,0,0,0,,Анамыздың нұры... Аура.
Dialogue: 0,0:19:20.87,0:19:21.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:23.16,0:19:23.91,Default,,0,0,0,,Анж!
Dialogue: 0,0:19:26.66,0:19:27.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:27.87,0:19:30.04,Default,,0,0,0,,Бұл сенің жоғалтуың, Эмбрион.
Dialogue: 0,0:19:30.95,0:19:31.91,Default,,0,0,0,,Алектра…
Dialogue: 0,0:19:33.20,0:19:38.87,Default,,0,0,0,,Сіз кетейін бе? Жеңіңіз немесе жеңіліңіз... бұл дүниені тастаңыз.
Dialogue: 0,0:19:41.70,0:19:44.16,Default,,0,0,0,,Мен де... мені өзіңмен бірге ала кет.
Dialogue: 0,0:19:44.91,0:19:45.87,Default,,0,0,0,,Не?
Dialogue: 0,0:19:48.08,0:19:50.25,Default,,0,0,0,,Айналада қандай жел соғып тұр?
Dialogue: 0,0:19:51.25,0:19:54.37,Default,,0,0,0,,Түсіндім, мен сені әлі де қалаймын...
Dialogue: 0,0:19:55.20,0:19:57.79,Default,,0,0,0,,Өкінішке орай, бұл мүмкін емес.
Dialogue: 0,0:19:58.33,0:19:59.25,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:59.58,0:20:01.45,Default,,0,0,0,,Сен мені қатты жақсы көрдің.
Dialogue: 0,0:20:02.66,0:20:06.45,Default,,0,0,0,,Мен... Мен сені жаңа ғана құтқардым.
Dialogue: 0,0:20:06.66,0:20:07.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:08.37,0:20:10.33,Default,,0,0,0,,Қарап тұра алмадым...
Dialogue: 0,0:20:11.29,0:20:14.04,Default,,0,0,0,,Кешірімсіз махаббатқа толысың.
Dialogue: 0,0:20:16.00,0:20:20.54,Default,,0,0,0,,Менен барлығын осылай тартып алған жоқсың.
Dialogue: 0,0:20:21.04,0:20:22.58,Default,,0,0,0,,Менің жүрегім және бәрі!
Dialogue: 0,0:20:23.87,0:20:27.83,Default,,0,0,0,,Сіз мені оң қолыңызбен өлтіруді жоспарлап отырсыз ба?
Dialogue: 0,0:20:29.37,0:20:33.75,Default,,0,0,0,,Жоқ, сен өлмейсің, солай ма?
Dialogue: 0,0:20:34.70,0:20:36.62,Default,,0,0,0,,Сондықтан... сенің істегенің осы!
Dialogue: 0,0:20:38.29,0:20:38.91,Default,,0,0,0,,Аһ!
Dialogue: 0,0:20:40.83,0:20:41.95,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:44.25,0:20:46.87,Default,,0,0,0,,Енді қашатын жер жоқ, солай ма?
Dialogue: 0,0:20:47.20,0:20:50.66,Default,,0,0,0,,Енді... бұл Алектра, біз Эмбрионды бекіттік.
Dialogue: 0,0:20:51.37,0:20:53.50,Default,,0,0,0,,Бұдан былай оның ұшағы... Ха!
Dialogue: 0,0:20:54.04,0:20:57.70,Default,,0,0,0,,Түсінемін, мен мұндай нәрсені ойлаймын деп ешқашан ойламадым.
Dialogue: 0,0:20:58.20,0:20:58.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:02.75,0:21:03.62,Default,,0,0,0,,Гррр…
Dialogue: 0,0:21:07.04,0:21:07.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:08.87,0:21:12.04,Default,,0,0,0,,Жоқ... сіздің негізгі денеңіз...
Dialogue: 0,0:21:12.75,0:21:14.58,Default,,0,0,0,,Қош бол Алектра...
Dialogue: 0,0:21:15.37,0:21:17.50,Default,,0,0,0,,Кемпірлерге пайда жоқ.
Dialogue: 0,0:21:18.70,0:21:22.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:22.95,0:21:26.95,Default,,0,0,0,,Капитан! Кеңістік-уақыт синтезінің конвергенция жылдамдығы 95%!
Dialogue: 0,0:21:27.16,0:21:28.29,Default,,0,0,0,,Әлі орындалуда!
Dialogue: 0,0:21:28.37,0:21:29.33,Default,,0,0,0,,Не?
Dialogue: 0,0:21:30.41,0:21:31.08,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:21:31.54,0:21:33.37,Default,,0,0,0,,Энергия жоғалып кетуі керек еді!
Dialogue: 0,0:21:33.75,0:21:35.58,Default,,0,0,0,,Мен мұны түсінбеймін...
Dialogue: 0,0:21:36.83,0:21:40.04,Default,,0,0,0,,Аура энергиясы кеңістік-уақыт синтезінің катализаторы болып табылады.
Dialogue: 0,0:21:41.16,0:21:46.45,Default,,0,0,0,,Осыдан кейін синтез шексіз ғаламның фазалық энергиясын пайдаланып автоматты түрде жүреді.
Dialogue: 0,0:21:46.83,0:21:47.70,Default,,0,0,0,,Эмбрион!
Dialogue: 0,0:21:48.37,0:21:49.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:50.87,0:21:51.66,Default,,0,0,0,,Әй?
Dialogue: 0,0:21:51.70,0:21:52.33,Default,,0,0,0,,Анж!
Dialogue: 0,0:21:58.58,0:22:01.79,Default,,0,0,0,,Кеңістік-уақыт синтезінің конвергенция жылдамдығы 97%!
Dialogue: 0,0:22:03.16,0:22:08.95,Default,,0,0,0,,Түннің сары шымылдығында адасқан
Dialogue: 0,0:22:09.12,0:22:14.58,Default,,0,0,0,,Мен ренжіп қалатын сияқтымын
Dialogue: 0,0:22:14.91,0:22:20.70,Default,,0,0,0,,Жүрексіздіктің қайта-қайта толқыны жұтылды
Dialogue: 0,0:22:20.87,0:22:26.20,Default,,0,0,0,,Мен қайшылықты тыныштық іздедім.
Dialogue: 0,0:22:26.33,0:22:31.95,Default,,0,0,0,,Дем ала алмайтындай мені қинайтын шындық
Dialogue: 0,0:22:32.04,0:22:38.04,Default,,0,0,0,,Шындық әрқашан қатып қалады
Dialogue: 0,0:22:38.12,0:22:43.87,Default,,0,0,0,,Жалындаған ғашықтықтай арман болт
Dialogue: 0,0:22:44.12,0:22:49.95,Default,,0,0,0,,Бұл денені күйдіріп, аспанды шуылдатыңыз
Dialogue: 0,0:22:50.04,0:22:53.00,Default,,0,0,0,,Ешкім білмейтін қараңғылықтың арғы жағында
Dialogue: 0,0:22:53.08,0:23:00.16,Default,,0,0,0,,Басын іздеп, Айқайлай берем
Dialogue: 0,0:23:00.29,0:23:01.29,Default,,0,0,0,,Ол келгенше...
Dialogue: 0,0:23:01.37,0:23:07.50,Default,,0,0,0,,Жұмбақ жарқыраған – аты жоқ жұлдыз
Dialogue: 0,0:23:07.58,0:23:13.66,Default,,0,0,0,,Уақыт лабиринтіндегі орнымды жоғалтсам да
Dialogue: 0,0:23:13.75,0:23:16.54,Default,,0,0,0,,Көңілсіз есте қалды
Dialogue: 0,0:23:16.62,0:23:23.58,Default,,0,0,0,,Сүйкімді күлкі сені мәңгілікке жетелейді
Dialogue: 0,0:23:23.66,0:23:32.58,Default,,0,0,0,,Жаңа әлемге
Dialogue: 0,0:23:34.12,0:23:36.00,Default,,0,0,0,,Соңғы эпизод! Барлығы дайын ба?
Dialogue: 0,0:23:36.29,0:23:38.25,Default,,0,0,0,,Бұл тағы бір эпизодта дұрыс аяқтала ма?
Dialogue: 0,0:23:38.33,0:23:40.83,Default,,0,0,0,,Фильм нұсқалары мен бейне бонустары үшін әртүрлі опциялар бар.
Dialogue: 0,0:23:40.91,0:23:43.83,Default,,0,0,0,,Ақыр соңында, Кросс-Андждегі «крест» нені білдіреді?
Dialogue: 0,0:23:43.91,0:23:45.83,Default,,0,0,0,,Бұл Андж қиын болады дегенді білдіреді, солай емес пе?
Dialogue: 0,0:23:46.04,0:23:47.04,Default,,0,0,0,,Пун?
Dialogue: 0,0:23:48.54,0:23:54.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory