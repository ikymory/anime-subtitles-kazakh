Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.62,0:00:17.20,Default,,0,0,0,,Бастау нұры Кирәлі…кірәлі
Dialogue: 0,0:00:17.79,0:00:25.50,Default,,0,0,0,,Ақырзаманның нұры Лүлала лила
Dialogue: 0,0:00:28.12,0:00:29.37,Default,,0,0,0,,Кеңістік-уақыт тербелісін растау
Dialogue: 0,0:00:29.45,0:00:30.79,Default,,0,0,0,,012-бағыт
Dialogue: 0,0:00:31.04,0:00:34.58,Default,,0,0,0,,-Құм сағаты -Арақашықтық 4500 келе жатыр
Dialogue: 0,0:00:35.12,0:00:38.66,Default,,0,0,0,,Уақыт тасып жатыр
Dialogue: 0,0:00:39.04,0:00:42.25,Default,,0,0,0,,Лулала лила
Dialogue: 0,0:00:43.16,0:00:50.29,Default,,0,0,0,,Өмірдің миллиардтаған жалыны
Dialogue: 0,0:00:51.70,0:00:53.08,Default,,0,0,0,,Ку… үлкен
Dialogue: 0,0:00:53.33,0:00:56.62,Default,,0,0,0,,Айдаһар пайда болды 1-сынып бригадасы 30-сынып
Dialogue: 0,0:00:56.91,0:00:59.66,Default,,0,0,0,,Брига класы? Бұл галлеон сыныбы емес пе?
Dialogue: 0,0:00:59.75,0:01:01.66,Default,,0,0,0,,Кішкентайлар өте көп.
Dialogue: 0,0:01:01.75,0:01:03.45,Default,,0,0,0,,Қара, қара, шағымданба.
Dialogue: 0,0:01:03.95,0:01:07.75,Default,,0,0,0,,Капитаннан әрбір ұшақ енді жою шабуылына көшеді.
Dialogue: 0,0:01:08.00,0:01:08.95,Default,,0,0,0,,Қауіпсіздік ашық
Dialogue: 0,0:01:09.08,0:01:10.04,Default,,0,0,0,,Иә, анашым!
Dialogue: 0,0:01:10.41,0:01:13.37,Default,,0,0,0,,Деректерді жаңартуды растау Мақсат түрі G
Dialogue: 0,0:01:13.62,0:01:14.29,Default,,0,0,0,,Не істейміз, Итерер?
Dialogue: 0,0:01:16.00,0:01:23.12,Default,,0,0,0,,Ән айт... ән, енді менің екі тілегім
Dialogue: 0,0:01:23.70,0:01:25.25,Default,,0,0,0,,8 шхунер сыныбы жойылды
Dialogue: 0,0:01:25.45,0:01:26.79,Default,,0,0,0,,Жолды бөгеңіз
Dialogue: 0,0:01:27.00,0:01:29.95,Default,,0,0,0,,Әрбір артқы күзет ұшағы 500 қашықтықта тосқауыл қояды.
Dialogue: 0,0:01:38.95,0:01:40.83,Default,,0,0,0,,Қазір! Авангард шабуылы!
Dialogue: 0,0:01:40.91,0:01:41.41,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:01:41.50,0:01:42.16,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:01:49.87,0:01:53.08,Default,,0,0,0,,Эль-Рагнаға жарқыратыңыз
Dialogue: 0,0:01:54.00,0:01:56.87,Default,,0,0,0,,Барлық қайғы
Dialogue: 0,0:01:57.41,0:01:59.33,Default,,0,0,0,,40 000 қолма-қол ақша беріңізші!
Dialogue: 0,0:02:01.20,0:02:02.91,Default,,0,0,0,,Ол қайтадан өз ісін істеп жатыр ма?
Dialogue: 0,0:02:03.04,0:02:05.33,Default,,0,0,0,,Сәлем! Құрылымды бұзбаңыз!
Dialogue: 0,0:02:05.91,0:02:08.37,Default,,0,0,0,,Шығарылу реакциясы расталды Барлық ұшақтар шашыраңқы
Dialogue: 0,0:02:19.58,0:02:20.70,Default,,0,0,0,,Розали мен Иеруша...
Dialogue: 0,0:02:20.95,0:02:22.95,Default,,0,0,0,,Анге, жауап бер! Андж
Dialogue: 0,0:02:24.00,0:02:25.41,Default,,0,0,0,,Кеттік, Вилкис.
Dialogue: 0,0:02:25.70,0:02:30.04,Default,,0,0,0,,Құдай көзді ашып-жұмғанша ғана
Dialogue: 0,0:02:30.29,0:02:35.12,Default,,0,0,0,,Жоғалып, қайтып оралмау
Dialogue: 0,0:02:37.12,0:02:44.45,Default,,0,0,0,,Дыбыс...Қазіргідей дыбыс
Dialogue: 0,0:02:44.54,0:02:53.45,Default,,0,0,0,,Бұрынғы дәстүр сияқты ақшыл... бозғылт.
Dialogue: 0,0:02:55.45,0:02:57.20,Default,,0,0,0,,Мен Анджмын
Dialogue: 0,0:03:08.37,0:03:10.04,Default,,0,0,0,,Мен тұрамын
Dialogue: 0,0:03:12.83,0:03:14.95,Default,,0,0,0,,Өлтіру... тірі
Dialogue: 0,0:03:33.04,0:03:38.16,Default,,0,0,0,,Басы негізсіз сүйкімді
Dialogue: 0,0:03:38.33,0:03:43.66,Default,,0,0,0,,Соңына қарсы тұрасың ба...?
Dialogue: 0,0:03:43.79,0:03:49.16,Default,,0,0,0,,Біз не үшін туып, өмір сүреміз?
Dialogue: 0,0:03:49.29,0:03:54.29,Default,,0,0,0,,Тек күресу арқылы ештеңеге қол жеткізу мүмкін емес.
Dialogue: 0,0:03:54.41,0:04:02.70,Default,,0,0,0,,Тағдыр қисынымен билеген армандай жұмақ
Dialogue: 0,0:04:02.83,0:04:07.62,Default,,0,0,0,,Мұның мағынасы бар ма?
Dialogue: 0,0:04:07.75,0:04:13.58,Default,,0,0,0,,Бұл өткінші, бірақ әдемі үмітсіздік әлемінде
Dialogue: 0,0:04:13.70,0:04:18.41,Default,,0,0,0,,Үзілген үміттер барар жерді іздейді
Dialogue: 0,0:04:18.54,0:04:24.58,Default,,0,0,0,,Қып-қызыл түске боялған естеліктердегі көз жасын ұмыт
Dialogue: 0,0:04:24.70,0:04:31.79,Default,,0,0,0,,Мәңгілік ән айтайық
Dialogue: 0,0:04:31.91,0:04:33.45,Default,,0,0,0,,Мен ұшқым келеді!（биік!） Ұшамын!（Биік!）
Dialogue: 0,0:04:33.54,0:04:37.16,Default,,0,0,0,,Жылы уақытты алып тастаңыз
Dialogue: 0,0:04:37.25,0:04:39.79,Default,,0,0,0,,Сіз соққыны сезінесіз! (төмен!) Beat! (Төмен!) дыбысы
Dialogue: 0,0:04:39.87,0:04:45.83,Default,,0,0,0,,Әуеде сөйлеп ұшқан жаман емес.
Dialogue: 0,0:04:50.33,0:04:54.70,Default,,0,0,0,,Аэрия чемпионаты, онда жас қан, тер және мананың жарығы соқтығысады
Dialogue: 0,0:04:55.25,0:04:59.54,Default,,0,0,0,,Розенблюм корольдігіндегі Флория академиясы үлкен чемпионат жалауын алады ма?
Dialogue: 0,0:05:00.16,0:05:03.20,Default,,0,0,0,,Әлде Мисуруги Империясы Феникс Холл ма?
Dialogue: 0,0:05:09.45,0:05:10.00,Default,,0,0,0,,Е!
Dialogue: 0,0:05:10.50,0:05:11.08,Default,,0,0,0,,Уф
Dialogue: 0,0:05:15.58,0:05:17.37,Default,,0,0,0,,Мүлдем кері
Dialogue: 0,0:05:18.16,0:05:19.16,Default,,0,0,0,,Әй
Dialogue: 0,0:05:21.00,0:05:23.37,Default,,0,0,0,,Маған... жалғастыра бер!
Dialogue: 0,0:05:26.37,0:05:27.70,Default,,0,0,0,,Мен бұл жерден өте алмаймын!
Dialogue: 0,0:05:31.12,0:05:31.50,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:33.45,0:05:34.37,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:34.58,0:05:35.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:35.41,0:05:36.45,Default,,0,0,0,,Бұл мені өлтірмейді, бірақ біраз уақыт дұрыс жүре алмайтын шығармын.
Dialogue: 0,0:05:37.70,0:05:38.12,Default,,0,0,0,,Момока!
Dialogue: 0,0:05:38.25,0:05:39.16,Default,,0,0,0,,Иә
Dialogue: 0,0:05:43.66,0:05:44.66,Default,,0,0,0,,Құт
Dialogue: 0,0:05:45.04,0:05:46.04,Default,,0,0,0,,Жарақаттар жоқ па?
Dialogue: 0,0:05:47.16,0:05:50.20,Default,,0,0,0,,Ах! А... Құрметті Ангелиза
Dialogue: 0,0:05:50.79,0:05:52.95,Default,,0,0,0,,Қайта ұшайық
Dialogue: 0,0:05:53.20,0:05:54.41,Default,,0,0,0,,Тек осы жолы ғана көз жұма қараймын.
Dialogue: 0,0:05:56.70,0:05:59.37,Default,,0,0,0,,Ой, ойын осымен аяқталады.
Dialogue: 0,0:05:59.54,0:06:03.16,Default,,0,0,0,,Биылғы Аэрия чемпионаты, қызу шайқаста бір ұпай айырмашылығымен жеңіске жетті
Dialogue: 0,0:06:03.33,0:06:06.79,Default,,0,0,0,,Жеңімпаз - Розенблюм патшалығының Флория академиясы.
Dialogue: 0,0:06:07.45,0:06:09.37,Default,,0,0,0,,Өкінішке орай, менің энергиям таусылды, Хууин.
Dialogue: 0,0:06:09.91,0:06:12.12,Default,,0,0,0,,Қызу шайқасқа түскен екі мектеп туралы
Dialogue: 0,0:06:12.54,0:06:17.12,Default,,0,0,0,,Ханзада Хулио мен ханшайым Сильвия да өздерінің жақсы жекпе-жегін мадақтау үшін қол соғуда.
Dialogue: 0,0:06:20.83,0:06:22.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:22.91,0:06:27.50,Default,,0,0,0,,Құрметті Анджелиза, егер біз сізді ұстап тұрмасақ, мен сенімдімін...
Dialogue: 0,0:06:29.04,0:06:31.87,Default,,0,0,0,,Сол күні... сіз уәде бергенсіз.
Dialogue: 0,0:06:32.33,0:06:35.87,Default,,0,0,0,,Жеңіске немесе жеңіліске қарағанда маңыздырақ нәрсені мақсат етейік.
Dialogue: 0,0:06:36.41,0:06:42.12,Default,,0,0,0,,Біз басқа командаларға қарағанда күшті байланыс арқылы жарқырай алдық.
Dialogue: 0,0:06:42.62,0:06:47.33,Default,,0,0,0,,Міне... бұл біздің жеңісіміз.
Dialogue: 0,0:06:48.00,0:06:50.12,Default,,0,0,0,,Құрметті Ангелиза...
Dialogue: 0,0:06:50.16,0:06:50.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:50.70,0:06:53.79,Default,,0,0,0,,Бұл керемет, Мәртебелі Ангелиза.
Dialogue: 0,0:06:54.50,0:06:59.62,Default,,0,0,0,,Маған барлығы жеңістен де әдемірек және қымбат нәрсені үйреткендей сезінемін.
Dialogue: 0,0:06:59.83,0:07:00.50,Default,,0,0,0,,(Кёко) Ш-шын ба…? Сенің мен Шиндô-кунның араларыңда солай ма…
Dialogue: 0,0:07:01.29,0:07:01.95,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:07:03.20,0:07:05.79,Default,,0,0,0,,Бүгінгі қарыз міндетті түрде күзгі турнирде болады.
Dialogue: 0,0:07:05.87,0:07:06.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:07.54,0:07:10.29,Default,,0,0,0,,Шомылдыру рәсімінен кейін қайтамын.
Dialogue: 0,0:07:11.08,0:07:13.95,Default,,0,0,0,,Сіздің қызметтік міндеттеріңіз қаншалықты бос болмасын... әрқашан!
Dialogue: 0,0:07:15.08,0:07:18.12,Default,,0,0,0,,Оған дейін бәріңіз! Айрия клубы, өтінемін.
Dialogue: 0,0:07:18.50,0:07:20.91,Default,,0,0,0,,бұл... Иә! капитан!
Dialogue: 0,0:07:22.33,0:07:23.45,Default,,0,0,0,,Бұл күлкілі.
Dialogue: 0,0:07:33.29,0:07:35.29,Default,,0,0,0,,Менің жүрегім әлі соғып тұр
Dialogue: 0,0:07:35.75,0:07:39.91,Default,,0,0,0,,Апаң көкке ұшқанда жүрегім тоқтап қалар деп ойладым.
Dialogue: 0,0:07:40.20,0:07:44.25,Default,,0,0,0,,Анджелиздің қасында болғаным мені алаңдатады, Момока.
Dialogue: 0,0:07:44.50,0:07:45.12,Default,,0,0,0,,Уху…
Dialogue: 0,0:07:45.20,0:07:46.00,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:07:46.08,0:07:46.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:46.87,0:07:49.66,Default,,0,0,0,,Достарыңызға көмектесіп, жеңіске жетіңіз
Dialogue: 0,0:07:49.95,0:07:52.83,Default,,0,0,0,,Ханшайым, әйтпесе...
Dialogue: 0,0:07:52.95,0:07:53.54,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:07:53.83,0:07:57.04,Default,,0,0,0,,О, Мәртебелі ханшайым өте сараң.
Dialogue: 0,0:08:11.25,0:08:13.20,Default,,0,0,0,,Кунинака Оние-сама Исшики...
Dialogue: 0,0:08:13.70,0:08:17.25,Default,,0,0,0,,Барлығы ертеңгі шомылдыру рәсімін күте алмайды.
Dialogue: 0,0:08:19.45,0:08:20.12,Default,,0,0,0,,Хехехе
Dialogue: 0,0:08:20.41,0:08:22.29,Default,,0,0,0,,Түсіндім, ағайын.
Dialogue: 0,0:08:22.66,0:08:27.00,Default,,0,0,0,,Мен бұл елдің болашағын манамның нұрымен нұрландырамын.
Dialogue: 0,0:08:27.08,0:08:27.66,Default,,0,0,0,,Уфу
Dialogue: 0,0:08:28.50,0:08:31.87,Default,,0,0,0,,Мен ертеңгі шомылдыру рәсімін асыға күтемін.
Dialogue: 0,0:08:32.75,0:08:33.33,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:37.37,0:08:39.12,Default,,0,0,0,,Күзетшілер! Қорғаныс шеңбері!
Dialogue: 0,0:08:39.33,0:08:40.70,Default,,0,0,0,,Мана нұры!
Dialogue: 0,0:08:40.79,0:08:41.87,Default,,0,0,0,,Тосқауыл!
Dialogue: 0,0:08:42.75,0:08:44.87,Default,,0,0,0,,Баршаңызға шыдамдылығыңызға рахмет.
Dialogue: 0,0:08:45.12,0:08:47.04,Default,,0,0,0,,Біз оны дереу өңдейміз.
Dialogue: 0,0:08:47.25,0:08:48.12,Default,,0,0,0,,Норма?
Dialogue: 0,0:08:48.25,0:08:49.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:49.66,0:08:51.50,Default,,0,0,0,,Жібер! Өтінемін, мені жіберіңізші!
Dialogue: 0,0:08:51.79,0:08:52.54,Default,,0,0,0,,Кедергі!
Dialogue: 0,0:08:52.62,0:08:53.66,Default,,0,0,0,,Жақсы
Dialogue: 0,0:08:54.08,0:08:54.70,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:08:55.41,0:08:56.29,Default,,0,0,0,,Жақсы
Dialogue: 0,0:08:56.45,0:08:57.16,Default,,0,0,0,,Уф
Dialogue: 0,0:08:57.41,0:08:58.04,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:08:58.91,0:09:01.08,Default,,0,0,0,,Иә, ә, ә!
Dialogue: 0,0:09:01.25,0:09:01.66,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:09:02.79,0:09:03.45,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:04.37,0:09:05.58,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:09:05.79,0:09:06.33,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:06.62,0:09:08.87,Default,,0,0,0,,Мананың нұры... жойылды.
Dialogue: 0,0:09:09.08,0:09:10.91,Default,,0,0,0,,Сіз оны бірінші рет көріп тұрсыз ба?
Dialogue: 0,0:09:12.00,0:09:13.95,Default,,0,0,0,,Бұл... Норма
Dialogue: 0,0:09:14.41,0:09:15.08,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:09:15.16,0:09:19.16,Default,,0,0,0,,Нормаларды басқару туралы заңның 1-бабының 3-тармағына сәйкес бұл тұлға 1203-76-бап деп аталады...
Dialogue: 0,0:09:19.91,0:09:21.20,Default,,0,0,0,,Сара...
Dialogue: 0,0:09:21.87,0:09:24.70,Default,,0,0,0,,Маған қызымды қайтар! иә!
Dialogue: 0,0:09:24.79,0:09:26.00,Default,,0,0,0,,Уа! сен не істемексің!
Dialogue: 0,0:09:26.08,0:09:26.87,Default,,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:09:27.12,0:09:28.83,Default,,0,0,0,,Мені кешіріңіз...
Dialogue: 0,0:09:29.20,0:09:32.50,Default,,0,0,0,,Бұл бала мананы қолдануда аздап нашар!
Dialogue: 0,0:09:33.08,0:09:33.87,Default,,0,0,0,,Уф, өтінемін...
Dialogue: 0,0:09:33.95,0:09:35.58,Default,,0,0,0,,Бұл Норманың дәлелі
Dialogue: 0,0:09:35.75,0:09:36.33,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:36.45,0:09:39.08,Default,,0,0,0,,Біз мұны назардан тыс қалдыра алмаймыз.
Dialogue: 0,0:09:39.25,0:09:40.54,Default,,0,0,0,,Құрметті Ангелиза...
Dialogue: 0,0:09:40.66,0:09:41.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:41.29,0:09:42.20,Default,,0,0,0,,Эмма мен басқалары – мен бұрын-соңды көрген де, сөйлескен де алғашқы адамдар еді.
Dialogue: 0,0:09:42.83,0:09:46.25,Default,,0,0,0,,Адамзат эволюцияның соңында алған мана нұры
Dialogue: 0,0:09:46.62,0:09:48.29,Default,,0,0,0,,Оны жоққа шығаратын норма
Dialogue: 0,0:09:48.37,0:09:52.54,Default,,0,0,0,,Инстинктпен өмір сүретін қатыгез және қоғамға қарсы құбыжық
Dialogue: 0,0:09:53.25,0:09:56.20,Default,,0,0,0,,Біз дәл қазір өзімізді бұл дүниеден оқшаулауымыз керек.
Dialogue: 0,0:09:56.45,0:09:57.75,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:59.12,0:10:01.20,Default,,0,0,0,,Өтінемін, Анджелиз ханым.
Dialogue: 0,0:10:01.50,0:10:03.37,Default,,0,0,0,,Мен сені дұрыс тәрбиелеймін!
Dialogue: 0,0:10:03.83,0:10:07.33,Default,,0,0,0,,Бұл мүмкін емес, өйткені Норма адам емес.
Dialogue: 0,0:10:07.50,0:10:08.04,Default,,0,0,0,,Ха...
Dialogue: 0,0:10:08.45,0:10:09.79,Default,,0,0,0,,(Кения) Бірақ білесің бе, біз оны Саторудың аурухана шығындарын жабуға көмектеседі деп ойладық➡
Dialogue: 0,0:10:11.20,0:10:12.58,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:10:12.66,0:10:14.83,Default,,0,0,0,,Тез... ұмыт.
Dialogue: 0,0:10:14.87,0:10:15.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:15.79,0:10:17.95,Default,,0,0,0,,Және тағы бір баланы дүниеге әкел.
Dialogue: 0,0:10:18.04,0:10:20.66,Default,,0,0,0,,Бұл жолы Норма емес, дұрыс бала.
Dialogue: 0,0:10:22.33,0:10:24.12,Default,,0,0,0,,Ой... Уау!
Dialogue: 0,0:10:24.25,0:10:24.91,Default,,0,0,0,,Тосқауыл!
Dialogue: 0,0:10:25.08,0:10:26.04,Default,,0,0,0,,Ооо...
Dialogue: 0,0:10:27.29,0:10:28.50,Default,,0,0,0,,Сен менің абыройымды осы лайға батырдың!
Dialogue: 0,0:10:29.12,0:10:30.58,Default,,0,0,0,,Ханшайым, ауырып қалдың ба?
Dialogue: 0,0:10:30.95,0:10:31.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:32.25,0:10:33.62,Default,,0,0,0,,Өйткені ол шектен тыс қорғаныс.
Dialogue: 0,0:10:33.75,0:10:35.04,Default,,0,0,0,,Апа, жақсысың ба?
Dialogue: 0,0:10:35.58,0:10:37.25,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:10:37.33,0:10:39.62,Default,,0,0,0,,Сара! Сера!
Dialogue: 0,0:10:40.29,0:10:44.08,Default,,0,0,0,,Өтінемін! Жіберу! Теңізші!
Dialogue: 0,0:10:44.70,0:10:50.95,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:10:53.04,0:10:59.12,Default,,0,0,0,,Әдемі ағып жатыр
Dialogue: 0,0:10:59.50,0:11:02.41,Default,,0,0,0,,Сондай-ақ өмір мен өлім туралы
Dialogue: 0,0:11:02.50,0:11:06.33,Default,,0,0,0,,Бесікте жұмсақ
Dialogue: 0,0:11:06.79,0:11:09.75,Default,,0,0,0,,көбіктену
Dialogue: 0,0:11:09.83,0:11:12.75,Default,,0,0,0,,Хмм... Кішкентай кезімнен өзгерген жоқ.
Dialogue: 0,0:11:13.25,0:11:16.54,Default,,0,0,0,,Бірдеңе бола қалса, сіз әрқашан осы әнді айтасыз.
Dialogue: 0,0:11:16.83,0:11:19.87,Default,,0,0,0,,Мен бәрін шайып кеткендей сезінемін.
Dialogue: 0,0:11:20.33,0:11:22.20,Default,,0,0,0,,Сіздің барлық күмәніңіз бен уайымыңыз
Dialogue: 0,0:11:22.66,0:11:23.87,Default,,0,0,0,,Мәңгілік сөйлеу…
Dialogue: 0,0:11:24.37,0:11:27.91,Default,,0,0,0,,Бұл император әулетінің тұмары бізге жүруіміз керек жолды көрсетеді.
Dialogue: 0,0:11:28.45,0:11:30.58,Default,,0,0,0,,Біз жүру керек жол...
Dialogue: 0,0:11:32.12,0:11:36.25,Default,,0,0,0,,Ана... Мен бұл дүниені жақсы көремін.
Dialogue: 0,0:11:37.16,0:11:38.95,Default,,0,0,0,,Мана нұрымен нұрланған
Dialogue: 0,0:11:39.16,0:11:43.70,Default,,0,0,0,,Соғыс, теңсіздік, жоқшылық, барлық қараңғылық жойылды.
Dialogue: 0,0:11:44.04,0:11:46.95,Default,,0,0,0,,Бейбіт, әдемі және мінсіз әлем...
Dialogue: 0,0:11:47.79,0:11:49.95,Default,,0,0,0,,Бірақ мен оны көптен бері іздеп жүрмін.
Dialogue: 0,0:11:50.37,0:11:53.79,Default,,0,0,0,,Мен басатын жол болуы керек...
Dialogue: 0,0:11:54.16,0:11:56.08,Default,,0,0,0,,Сіз оны таптыңыз ба?
Dialogue: 0,0:11:56.58,0:11:59.00,Default,,0,0,0,,Мен Норманы бүгін бірінші рет көрдім.
Dialogue: 0,0:11:59.33,0:12:00.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:00.33,0:12:02.50,Default,,0,0,0,,Мананы бұзатын мутациялар
Dialogue: 0,0:12:03.29,0:12:05.83,Default,,0,0,0,,Неліктен бұл дүниеде мұндай заттар бар?
Dialogue: 0,0:12:06.66,0:12:08.54,Default,,0,0,0,,Мен ештеңе білмеймін
Dialogue: 0,0:12:09.04,0:12:13.04,Default,,0,0,0,,Ол қалай пайда болады? Неге тек әйелдер?
Dialogue: 0,0:12:13.58,0:12:16.00,Default,,0,0,0,,Иә, мен ештеңе білмеймін.
Dialogue: 0,0:12:16.54,0:12:19.62,Default,,0,0,0,,Сондықтан мен сізге түсіндіруге тырысамын.
Dialogue: 0,0:12:19.75,0:12:20.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:20.58,0:12:25.87,Default,,0,0,0,,Норма бұл дүниеден жойылса, әлем көркейер еді.
Dialogue: 0,0:12:29.70,0:12:31.00,Default,,0,0,0,,Ангелиза…
Dialogue: 0,0:12:32.66,0:12:33.91,Default,,0,0,0,,Бұл сізге
Dialogue: 0,0:12:34.79,0:12:37.08,Default,,0,0,0,,Бұл... Икаруга императорлық отбасының...
Dialogue: 0,0:12:39.33,0:12:42.83,Default,,0,0,0,,Сізге нұр жаусын...
Dialogue: 0,0:12:43.25,0:12:44.66,Default,,0,0,0,,Ана…
Dialogue: 0,0:12:53.25,0:12:54.00,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:12:58.66,0:13:03.00,Default,,0,0,0,,Вааааааааааааааааааааааааа
Dialogue: 0,0:13:03.66,0:13:07.91,Default,,0,0,0,,Ангелисаны 16 жасқа толған туған күнімен құттықтау.
Dialogue: 0,0:13:08.16,0:13:10.91,Default,,0,0,0,,Көптеген азаматтар жол жиегінде жиналды.
Dialogue: 0,0:13:11.45,0:13:15.20,Default,,0,0,0,,Бұдан былай Анджелиз-сама император отбасы мүшелерімен бірге болады.
Dialogue: 0,0:13:15.45,0:13:17.91,Default,,0,0,0,,Акацуки но Онбашира алдындағы орынға кіріңіз.
Dialogue: 0,0:13:18.29,0:13:20.62,Default,,0,0,0,,Шомылдыру рәсімі ақырында өтеді.
Dialogue: 0,0:13:29.95,0:13:33.58,Default,,0,0,0,,Билеуші болған Ангелиза ханшайымның нұры,
Dialogue: 0,0:13:33.87,0:13:39.75,Default,,0,0,0,,Бұл Мисуруги империясына одан әрі бейбітшілік пен гүлдену әкеледі.
Dialogue: 0,0:13:40.20,0:13:41.87,Default,,0,0,0,,Ол мүлде көмектеспейді.
Dialogue: 0,0:14:10.37,0:14:11.58,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:14:12.08,0:14:13.54,Default,,0,0,0,,Не? Бұл дыбыс...
Dialogue: 0,0:14:13.87,0:14:16.08,Default,,0,0,0,,Норманың... ескерту дыбысы...
Dialogue: 0,0:14:16.20,0:14:17.00,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:19.79,0:14:22.33,Default,,0,0,0,,Ақымақ... Онбашира, әрине...
Dialogue: 0,0:14:22.45,0:14:25.33,Default,,0,0,0,,Егер бұл жалған болса... Мен оны жойдым.
Dialogue: 0,0:14:25.41,0:14:26.83,Default,,0,0,0,,А... неге? Хулио
Dialogue: 0,0:14:27.12,0:14:30.08,Default,,0,0,0,,Хэхе... хахахахаха
Dialogue: 0,0:14:30.58,0:14:33.54,Default,,0,0,0,,Бұл менің желісім, әке.
Dialogue: 0,0:14:34.25,0:14:35.04,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:35.25,0:14:39.50,Default,,0,0,0,,Құбыжықты император отбасының мүшесі ету үшін шомылдыру рәсімін басқару және т.б.
Dialogue: 0,0:14:39.66,0:14:40.79,Default,,0,0,0,,​​Есіңіз дұрыс па?
Dialogue: 0,0:14:40.95,0:14:42.50,Default,,0,0,0,,Әй, ағайын?
Dialogue: 0,0:14:42.70,0:14:44.50,Default,,0,0,0,,Сүйкімді Сильвия
Dialogue: 0,0:14:48.45,0:14:52.12,Default,,0,0,0,,Ал менің сүйікті император халқым
Dialogue: 0,0:14:52.41,0:14:54.83,Default,,0,0,0,,Енді шындықты ашайық
Dialogue: 0,0:14:56.00,0:14:56.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:57.25,0:14:58.66,Default,,0,0,0,,Ангелиза...
Dialogue: 0,0:14:58.79,0:15:00.54,Default,,0,0,0,,Қатты жақын қашықтықтағы шайқаста ол дерлік ешқандай осал тұс қалдырмайды—
Dialogue: 0,0:15:01.16,0:15:02.58,Default,,0,0,0,,Бұл Норма еді!
Dialogue: 0,0:15:02.79,0:15:03.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:03.37,0:15:04.08,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,0:15:04.79,0:15:08.08,Default,,0,0,0,,Шындықты жасырып, Норманы билеуші ретінде пайдалану, т.б.
Dialogue: 0,0:15:08.33,0:15:09.87,Default,,0,0,0,,Мемлекетті жекешелендіру
Dialogue: 0,0:15:10.04,0:15:12.12,Default,,0,0,0,,Бұл – халыққа жасалған ауыр сатқындық!
Dialogue: 0,0:15:12.62,0:15:13.37,Default,,0,0,0,,Құбыжық бол!
Dialogue: 0,0:15:13.83,0:15:16.83,Default,,0,0,0,,Сіз менің Мисуруги империямды бүлдіру үшін не істеп жатырсыз?
Dialogue: 0,0:15:17.16,0:15:17.91,Default,,0,0,0,,Қазір уақыт!
Dialogue: 0,0:15:18.25,0:15:21.37,Default,,0,0,0,,Барлық азаматтардың алдында шындықты ашыңыз
Dialogue: 0,0:15:21.54,0:15:24.33,Default,,0,0,0,,Бұл Анджелиздің шомылдыру рәсімінен өту рәсімі!
Dialogue: 0,0:15:26.66,0:15:28.00,Default,,0,0,0,,Қаш, асығыс!
Dialogue: 0,0:15:28.08,0:15:28.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:28.54,0:15:30.08,Default,,0,0,0,,Анашым, бұл не?
Dialogue: 0,0:15:30.66,0:15:31.16,Default,,0,0,0,,Егер солай болса, сол кезде айтамын.
Dialogue: 0,0:15:31.58,0:15:33.04,Default,,0,0,0,,Нағыз мылтықтарды қолданыңыз!
Dialogue: 0,0:15:33.29,0:15:33.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:34.25,0:15:35.12,Default,,0,0,0,,Құлыптау!
Dialogue: 0,0:15:39.12,0:15:42.33,Default,,0,0,0,,Күдікті салтанатты аймақтан Онбашираға қашып кеткен.
Dialogue: 0,0:15:42.95,0:15:43.87,Default,,0,0,0,,Құрметті Сильвия!
Dialogue: 0,0:15:45.33,0:15:45.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:45.75,0:15:46.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:46.37,0:15:47.08,Default,,0,0,0,,Мұнда келу қандай да бір қорқынышты іс сияқты…
Dialogue: 0,0:15:47.41,0:15:49.54,Default,,0,0,0,,Ха ха ха ха ха ха ха
Dialogue: 0,0:15:52.58,0:15:57.45,Default,,0,0,0,,Хаа ха ха ха ха ха
Dialogue: 0,0:15:57.58,0:15:58.12,Default,,0,0,0,,Ах
Dialogue: 0,0:16:00.45,0:16:01.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:02.25,0:16:04.12,Default,,0,0,0,,Құрметті Ангелиза, осы жерді басыңыз
Dialogue: 0,0:16:05.00,0:16:08.54,Default,,0,0,0,,Мәртебелі ханшайым Норма деп күдіктенеді.
Dialogue: 0,0:16:09.08,0:16:10.20,Default,,0,0,0,,Қарсылық көрсетпе...
Dialogue: 0,0:16:10.75,0:16:12.37,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:16:12.66,0:16:14.12,Default,,0,0,0,,Жоқ! Анжелиза!
Dialogue: 0,0:16:15.58,0:16:16.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:16.66,0:16:17.25,Default,,0,0,0,,Ооо...
Dialogue: 0,0:16:17.41,0:16:20.25,Default,,0,0,0,,Мана жарығы... жойылды.
Dialogue: 0,0:16:23.20,0:16:25.33,Default,,0,0,0,,Ханшайым бұл... Норма.
Dialogue: 0,0:16:25.83,0:16:27.00,Default,,0,0,0,,Бұл өтірік! Болды
Dialogue: 0,0:16:27.41,0:16:30.91,Default,,0,0,0,,Қаруларыңды тастап, беріліңдер... Қарсы шықсаңдар, мен сені атып тастаймын.
Dialogue: 0,0:16:31.58,0:16:36.50,Default,,0,0,0,,Сен маған... бірінші ханшайымға мылтық бағыттайсың ба?
Dialogue: 0,0:16:36.70,0:16:37.20,Default,,0,0,0,,(Мысықтың айғайсы)
Dialogue: 0,0:16:37.41,0:16:38.95,Default,,0,0,0,,Ангелиза!
Dialogue: 0,0:16:39.62,0:16:40.95,Default,,0,0,0,,Һм? Бұл не?
Dialogue: 0,0:16:41.25,0:16:43.16,Default,,0,0,0,,Жақсы істедің, Иносукэ!
Dialogue: 0,0:16:43.91,0:16:46.33,Default,,0,0,0,,А... о... Анашым!
Dialogue: 0,0:16:47.95,0:16:51.29,Default,,0,0,0,,Мен сені қорғағым келді...
Dialogue: 0,0:16:51.87,0:16:53.62,Default,,0,0,0,,Шындықтан…
Dialogue: 0,0:16:53.87,0:16:56.79,Default,,0,0,0,,-Аа... уф... -Мен өмір сүремін, Анжелиза.
Dialogue: 0,0:16:57.70,0:17:03.12,Default,,0,0,0,,Не болса да... сен... сен...
Dialogue: 0,0:17:03.95,0:17:05.41,Default,,0,0,0,,Әй, анашым!
Dialogue: 0,0:17:06.12,0:17:07.37,Default,,0,0,0,,Ах… Ух…
Dialogue: 0,0:17:07.95,0:17:10.83,Default,,0,0,0,,Норманы басқару туралы заңның 1-бабының 3-тармағына сәйкес
Dialogue: 0,0:17:11.45,0:17:15.04,Default,,0,0,0,,Мен сізді No1203-77 Норма деп танимын.
Dialogue: 0,0:17:15.66,0:17:16.45,Default,,0,0,0,,Мені алып кетіңіз
Dialogue: 0,0:17:16.62,0:17:17.29,Default,,0,0,0,,Га
Dialogue: 0,0:17:17.75,0:17:19.37,Default,,0,0,0,,Сіз бізді алдадың ба?
Dialogue: 0,0:17:19.50,0:17:19.95,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:17:20.25,0:17:22.75,Default,,0,0,0,,Не деген байлам... Өтірікші!
Dialogue: 0,0:17:22.91,0:17:23.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:24.83,0:17:26.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:27.04,0:17:27.95,Default,,0,0,0,,Ана…
Dialogue: 0,0:17:28.83,0:17:31.08,Default,,0,0,0,,Қараңызшы... Қараңызшы!
Dialogue: 0,0:17:31.45,0:17:35.33,Default,,0,0,0,,Ана... Анашым!
Dialogue: 0,0:17:37.79,0:17:39.58,Default,,0,0,0,,Дегенмен, Ол Майт—
Dialogue: 0,0:17:40.04,0:17:44.33,Default,,0,0,0,,Ана... Мәртебелі императрицаның мемлекеттік жерлеу рәсіміне дайындалыңыз.
Dialogue: 0,0:17:44.75,0:17:46.70,Default,,0,0,0,,Мәртебелі император ұстамды болуы керек.
Dialogue: 0,0:17:46.79,0:17:47.50,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:52.95,0:17:55.33,Default,,0,0,0,,Мен бос боламын, Сильвия.
Dialogue: 0,0:17:55.95,0:17:59.12,Default,,0,0,0,,Біз кірлеген императорлық отбасын қайта құруымыз керек.
Dialogue: 0,0:18:00.04,0:18:01.83,Default,,0,0,0,,Тек біз...
Dialogue: 0,0:18:03.20,0:18:03.95,Default,,0,0,0,,Лиза
Dialogue: 0,0:18:05.33,0:18:08.37,Default,,0,0,0,,Бұдан былай мен Мисуруги империясын басқарамын.
Dialogue: 0,0:18:09.00,0:18:11.75,Default,,0,0,0,,Қасиетті император Джулио I ретінде
Dialogue: 0,0:18:13.00,0:18:13.91,Default,,0,0,0,,Бакуго жеңіске жетті!
Dialogue: 0,0:18:25.62,0:18:28.25,Default,,0,0,0,,Міне 107 Мен қалдық әкелдім.
Dialogue: 0,0:18:28.75,0:18:30.29,Default,,0,0,0,,Қонуға рұқсат сұрау
Dialogue: 0,0:18:30.62,0:18:32.20,Default,,0,0,0,,Мұнда 107
Dialogue: 0,0:18:40.62,0:18:43.08,Default,,0,0,0,,No 1203-77 Норма
Dialogue: 0,0:18:43.16,0:18:45.12,Default,,0,0,0,,Анджелиз, Икаруга, Мисуруги
Dialogue: 0,0:18:45.75,0:18:48.45,Default,,0,0,0,,Туған жері: Мисуруги империясы, 16 жаста
Dialogue: 0,0:18:49.66,0:18:51.20,Default,,0,0,0,,16 жас...
Dialogue: 0,0:18:51.70,0:18:54.70,Default,,0,0,0,,Бүгіннен бастап сіз «Арзеналға» жазыласыз.
Dialogue: 0,0:18:54.95,0:18:57.70,Default,,0,0,0,,Солдат ретінде соғысу керек
Dialogue: 0,0:18:58.79,0:19:01.29,Default,,0,0,0,,Ол қайда? Міне
Dialogue: 0,0:19:02.37,0:19:05.75,Default,,0,0,0,,Маған не болып жатыр?
Dialogue: 0,0:19:05.95,0:19:08.58,Default,,0,0,0,,Егер сіз 16 жаста болсаңыз, оқу бағдарламасына ерекше жағдай ретінде тіркелдіңіз...
Dialogue: 0,0:19:08.66,0:19:11.95,Default,,0,0,0,,Анашым... Анама не болды?
Dialogue: 0,0:19:12.41,0:19:14.37,Default,,0,0,0,,Қазір танысуға рұқсат етіңіз!
Dialogue: 0,0:19:16.04,0:19:17.33,Default,,0,0,0,,Ой... не...
Dialogue: 0,0:19:17.79,0:19:19.58,Default,,0,0,0,,Затыңызды тәркілеу
Dialogue: 0,0:19:20.41,0:19:22.08,Default,,0,0,0,,Уф... тоқтат!
Dialogue: 0,0:19:22.58,0:19:23.87,Default,,0,0,0,,Сол сақина да!
Dialogue: 0,0:19:25.58,0:19:26.45,Default,,0,0,0,,Егер бұл Бірінші нөмірлі Батырға жақындауға көмектессе, мен бәрін жасауға дайынмын
Dialogue: 0,0:19:26.91,0:19:30.79,Default,,0,0,0,,Бұл біздің Мисуруги империясының Икаруга императорлық отбасынан алынған нәрсе.
Dialogue: 0,0:19:31.04,0:19:34.04,Default,,0,0,0,,Бұл сіз сияқты төменгі шенеуніктің қолына тиетін нәрсе емес.
Dialogue: 0,0:19:34.37,0:19:37.41,Default,,0,0,0,,Хмм... Нормамен бір уақытта!
Dialogue: 0,0:19:39.16,0:19:39.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:40.00,0:19:42.75,Default,,0,0,0,,Мен мұны істеймін Инспектор Эмма Бронсон
Dialogue: 0,0:19:43.29,0:19:46.16,Default,,0,0,0,,Норманың серіктесі Норма болуы керек.
Dialogue: 0,0:19:47.79,0:19:52.00,Default,,0,0,0,,Бұл Джил, командир Арзенал. Менің бейшара еліктеуім үшін кешірім сұраймын.
Dialogue: 0,0:19:54.16,0:19:58.62,Default,,0,0,0,,Мен қарапайым адам емеспін. Мұның бәрі қате.
Dialogue: 0,0:19:59.04,0:20:00.50,Default,,0,0,0,,Жақында Мисуруги империясынан...
Dialogue: 0,0:20:03.66,0:20:04.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:05.08,0:20:07.37,Default,,0,0,0,,Жоқ, жоқ, мен қорықтым.
Dialogue: 0,0:20:08.04,0:20:11.45,Default,,0,0,0,,16 жасқа дейін мананы қолданбай өмір сүремін деп ойлаған емеспін.
Dialogue: 0,0:20:11.91,0:20:13.70,Default,,0,0,0,,Не...
Dialogue: 0,0:20:13.79,0:20:17.04,Default,,0,0,0,,Сіз біртүрлі нәрсе таптыңыз ба? Ешқашан?
Dialogue: 0,0:20:17.29,0:20:18.95,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:20:19.12,0:20:21.95,Default,,0,0,0,,Мананы пайдаланатын жеке қызметші болған сияқты.
Dialogue: 0,0:20:22.37,0:20:26.20,Default,,0,0,0,,Қаншама... 16 жылдық еңбек босқа кетті.
Dialogue: 0,0:20:26.79,0:20:29.08,Default,,0,0,0,,Анаң да бекер өлді.
Dialogue: 0,0:20:30.25,0:20:31.50,Default,,0,0,0,,Өлді...?
Dialogue: 0,0:20:32.58,0:20:34.54,Default,,0,0,0,,Ха! Немесе... қайтарыңыз!
Dialogue: 0,0:20:34.75,0:20:35.29,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:36.20,0:20:39.45,Default,,0,0,0,,Неге оны қайтармасқа? Мана күшімен
Dialogue: 0,0:20:39.62,0:20:40.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:41.41,0:20:46.50,Default,,0,0,0,,Мананың нұры, Нұры... Мананың нұры!
Dialogue: 0,0:20:47.04,0:20:47.66,Default,,0,0,0,,Е...
Dialogue: 0,0:20:48.45,0:20:52.66,Default,,0,0,0,,Сенде енді ештеңе жоқ, тіпті ханшайымдай беделің де жоқ.
Dialogue: 0,0:20:53.08,0:20:53.54,Default,,0,0,0,,Га
Dialogue: 0,0:20:53.62,0:20:56.25,Default,,0,0,0,,Адам ретіндегі қадір-қасиет... ештеңе.
Dialogue: 0,0:20:57.16,0:20:58.87,Default,,0,0,0,,Тірі тозаққа қош келдіңіз
Dialogue: 0,0:20:59.00,0:20:59.58,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:21:03.95,0:21:05.12,Default,,0,0,0,,Күйеуім іссапармен кеткен, бір аптаға дейін келмейді
Dialogue: 0,0:21:05.54,0:21:06.20,Default,,0,0,0,,Уф
Dialogue: 0,0:21:06.83,0:21:07.33,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:21:07.62,0:21:08.37,Default,,0,0,0,,Га
Dialogue: 0,0:21:08.45,0:21:09.25,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:09.41,0:21:10.04,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:10.25,0:21:10.87,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:11.04,0:21:13.70,Default,,0,0,0,,Бас инспектор, маған көмектесе аласыз ба?
Dialogue: 0,0:21:14.25,0:21:15.50,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:21:15.91,0:21:19.29,Default,,0,0,0,,Сіз оны тез бітіргіңіз келеді, солай ма? Лас жұмыс деген жоқ
Dialogue: 0,0:21:20.08,0:21:21.04,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:21:22.16,0:21:23.50,Default,,0,0,0,,Уф, уф
Dialogue: 0,0:21:25.41,0:21:26.50,Default,,0,0,0,,Не...
Dialogue: 0,0:21:27.37,0:21:27.95,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:29.41,0:21:30.41,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:32.16,0:21:33.62,Default,,0,0,0,,Физикалық тексеру
Dialogue: 0,0:21:34.08,0:21:36.20,Default,,0,0,0,,Тоқта, тоқта!
Dialogue: 0,0:21:36.79,0:21:39.70,Default,,0,0,0,,Мен... Мисуруги империясының бірінші ханшайымымын
Dialogue: 0,0:21:40.12,0:21:43.04,Default,,0,0,0,,Анджелиз, Икаруга, Мисуруги Нарузо!
Dialogue: 0,0:21:43.62,0:21:46.04,Default,,0,0,0,,Жоқ, енді сіз...
Dialogue: 0,0:21:46.41,0:21:47.20,Default,,0,0,0,,Бұл Андж.
Dialogue: 0,0:21:47.45,0:21:47.95,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:50.41,0:21:55.08,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:56.83,0:22:04.91,Default,,0,0,0,,Толтырылған дүние = ойдан шығарылған дүние
Dialogue: 0,0:22:05.41,0:22:13.08,Default,,0,0,0,,Жоқтаудың қалақшасы, Еске салуға батылдық
Dialogue: 0,0:22:13.16,0:22:22.33,Default,,0,0,0,,Арман мен махаббатты тастап, тұру
Dialogue: 0,0:22:22.91,0:22:31.41,Default,,0,0,0,,Қараңғылықты нұрландырғанша асыл жалын
Dialogue: 0,0:22:31.50,0:22:35.41,Default,,0,0,0,,Қанша жерден алыс болса да
Dialogue: 0,0:22:35.79,0:22:40.00,Default,,0,0,0,,Мен енді жыламаймын, жеңілмеймін, қашпаймын, өйткені мен солай шештім.
Dialogue: 0,0:22:40.37,0:22:48.70,Default,,0,0,0,,Мен түрлі сезім толқындарына жұтылатындай сезінемін.
Dialogue: 0,0:22:48.91,0:22:52.95,Default,,0,0,0,,Сену, сену, сену, осы сезімге сену
Dialogue: 0,0:22:53.25,0:22:58.37,Default,,0,0,0,,Мен бұл «кездейсоқ» емес, «болмай қоймайтын» деп айта алатын күнге дейін
Dialogue: 0,0:22:58.45,0:23:02.16,Default,,0,0,0,,Шабыт беретін жүрек соғысы
Dialogue: 0,0:23:02.25,0:23:13.29,Default,,0,0,0,,Бұл басқа ешкім емес. Болашақты қолымызбен ашайық.
Dialogue: 0,0:23:13.37,0:23:21.08,Default,,0,0,0,,Шынайы дүние = көрінбейтін дүние
Dialogue: 0,0:23:21.87,0:23:31.08,Default,,0,0,0,,Жүрегіңде әрқашан сөнбес нұр
Dialogue: 0,0:23:33.66,0:23:35.33,Default,,0,0,0,,Сізге 1-бөлім қалай ұнады?
Dialogue: 0,0:23:35.41,0:23:37.58,Default,,0,0,0,,ең нашар! Осындай және осындай нәрселер
Dialogue: 0,0:23:37.83,0:23:40.50,Default,,0,0,0,,Атақты және жоғары дәрежелі ханшайым болу деген нені білдіреді? Бұл емдеу
Dialogue: 0,0:23:40.83,0:23:43.16,Default,,0,0,0,,Ақылға қонымсыз және лимузин, бір әріп айырмашылығы үлкен айырмашылықты тудырады!
Dialogue: 0,0:23:43.58,0:23:45.70,Default,,0,0,0,,Біріншіден, бұл әдемі қыз робот аниме, солай ма?
Dialogue: 0,0:23:45.79,0:23:47.83,Default,,0,0,0,,Әдемі қыздарды былай қойғанда, роботтар ше?
Dialogue: 0,0:23:49.33,0:23:55.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory