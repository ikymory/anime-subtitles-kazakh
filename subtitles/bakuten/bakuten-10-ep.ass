Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.21,0:00:08.50,Default,,0,0,0,,Бұл солай ма? Мисато
Dialogue: 0,0:00:08.63,0:00:11.76,Default,,0,0,0,,Сондай-ақ, саусақ сызықтары өрескел.
Dialogue: 0,0:00:11.88,0:00:13.76,Default,,0,0,0,,Мен бұл әдеттен арыла алмаймын, Ватари.
Dialogue: 0,0:00:13.88,0:00:14.93,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:15.68,0:00:18.47,Default,,0,0,0,,Осыған ұқсас...
Dialogue: 0,0:00:19.06,0:00:20.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:20.89,0:00:21.68,Default,,0,0,0,,Уф… Ой, жоқ!
Dialogue: 0,0:00:21.81,0:00:24.27,Default,,0,0,0,,Иә! Ия жақсарды
Dialogue: 0,0:00:24.39,0:00:26.81,Default,,0,0,0,,А... ау!
Dialogue: 0,0:00:27.44,0:00:28.77,Default,,0,0,0,,Мисатоға рахмет
Dialogue: 0,0:00:28.90,0:00:29.69,Default,,0,0,0,,Жоқ
Dialogue: 0,0:00:30.36,0:00:31.48,Default,,0,0,0,,Онагава
Dialogue: 0,0:00:31.61,0:00:35.49,Default,,0,0,0,,Созылу сальтосының әуе қалпы бұрынғыға қарағанда жақсырақ.
Dialogue: 0,0:00:35.61,0:00:38.45,Default,,0,0,0,,Жасырын оқудың нәтижесі тамаша болды.
Dialogue: 0,0:00:38.58,0:00:40.99,Default,,0,0,0,,Сіз кеше Мисатодан сұрадыңыз, солай ма?
Dialogue: 0,0:00:41.79,0:00:44.91,Default,,0,0,0,,Сен олай айтпауға уәде бересің, байыпты жапырақ.
Dialogue: 0,0:00:45.83,0:00:47.42,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:48.63,0:00:50.84,Default,,0,0,0,,Барлығы жақсы көрінеді
Dialogue: 0,0:00:50.96,0:00:51.84,Default,,0,0,0,,Иә
Dialogue: 0,0:00:53.05,0:00:58.01,Default,,0,0,0,,♪～
Dialogue: 0,0:02:17.92,0:02:22.89,Default,,0,0,0,,～♪
Dialogue: 0,0:02:23.51,0:02:25.47,Default,,0,0,0,,Ертеңгі күні аудандық турнир.
Dialogue: 0,0:02:25.60,0:02:28.39,Default,,0,0,0,,Бүгінгі күнге дейін барлығы қолынан келгенін жасады.
Dialogue: 0,0:02:28.52,0:02:30.56,Default,,0,0,0,,Ертеңгі жаттығу жабық.
Dialogue: 0,0:02:30.69,0:02:33.86,Default,,0,0,0,,Сіріңке үшін жеткілікті қуат бар екеніне көз жеткізіңіз.
Dialogue: 0,0:02:33.98,0:02:34.77,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:02:34.90,0:02:35.94,Default,,0,0,0,,Иә! (Ватари) Усу!
Dialogue: 0,0:02:36.07,0:02:38.61,Default,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:02:38.74,0:02:40.91,Default,,0,0,0,,Мен өзіңді сенімді түрде сынағаныңды қалаймын.
Dialogue: 0,0:02:41.45,0:02:42.78,Default,,0,0,0,,Аса-чан
Dialogue: 0,0:02:42.91,0:02:44.70,Default,,0,0,0,,Кестені тексеріңіз
Dialogue: 0,0:02:45.49,0:02:47.75,Default,,0,0,0,,Өтетін орны: Кесеннума жалпы гимназиясы
Dialogue: 0,0:02:48.45,0:02:51.25,Default,,0,0,0,,Ашылу салтанаты 9:30-дан басталады.
Dialogue: 0,0:02:51.37,0:02:53.75,Default,,0,0,0,,Сағат 9-да кіре берісте кездесу
Dialogue: 0,0:02:54.50,0:02:56.75,Default,,0,0,0,,Олай болса, барлығымыз қолымыздан келгенді жасайық.
Dialogue: 0,0:02:56.88,0:02:58.30,Default,,0,0,0,,Иә! (Ватари) Усу!
Dialogue: 0,0:02:58.92,0:03:00.76,Default,,0,0,0,,Айтпақшы... (Шичигахама және т.б.) Иә?
Dialogue: 0,0:03:01.38,0:03:02.97,Default,,0,0,0,,Мен облыстық турнирге қатысқан мектептердің түсірілімін алдым, бірақ...
Dialogue: 0,0:03:02.97,0:03:04.30,Default,,0,0,0,,Мен облыстық турнирге қатысқан мектептердің түсірілімін алдым, бірақ...
Dialogue: 0,0:03:02.97,0:03:04.30,Default,,0,0,0,,♪～
Dialogue: 0,0:03:04.30,0:03:04.43,Default,,0,0,0,,♪～
Dialogue: 0,0:03:04.43,0:03:05.76,Default,,0,0,0,,♪～
Dialogue: 0,0:03:04.43,0:03:05.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:07.14,0:03:10.89,Default,,0,0,0,,Ивате префектурасының өкілі Мориока Рё орта мектебі
Dialogue: 0,0:03:11.02,0:03:12.73,Default,,0,0,0,,Бұл сіздің мұнда бірінші рет келуіңіз.
Dialogue: 0,0:03:11.02,0:03:12.73,Default,,0,0,0,,～♪
Dialogue: 0,0:03:12.73,0:03:12.85,Default,,0,0,0,,～♪
Dialogue: 0,0:03:12.85,0:03:13.65,Default,,0,0,0,,～♪
Dialogue: 0,0:03:12.85,0:03:13.65,Default,,0,0,0,,Иә
Dialogue: 0,0:03:14.69,0:03:16.69,Default,,0,0,0,,Керемет кемелдік
Dialogue: 0,0:03:16.82,0:03:19.49,Default,,0,0,0,,Барлығы 12 мектеп қатысады.
Dialogue: 0,0:03:19.61,0:03:20.82,Default,,0,0,0,,Иә
Dialogue: 0,0:03:20.95,0:03:25.99,Default,,0,0,0,,Тохоку аймақтық турниріне алты Тохоку префектурасын көрсететін 12 мектеп қатысады.
Dialogue: 0,0:03:26.12,0:03:28.70,Default,,0,0,0,,Үздік екі мектеп орта мектепке қатыса алады.
Dialogue: 0,0:03:28.83,0:03:29.62,Default,,0,0,0,,♪～
Dialogue: 0,0:03:29.62,0:03:31.79,Default,,0,0,0,,♪～
Dialogue: 0,0:03:29.62,0:03:31.79,Default,,0,0,0,,Чемпионатқа үміткер, әрине, Широ орта мектебі.
Dialogue: 0,0:03:31.79,0:03:33.17,Default,,0,0,0,,Чемпионатқа үміткер, әрине, Широ орта мектебі.
Dialogue: 0,0:03:33.71,0:03:36.13,Default,,0,0,0,,Бұл префектуралық турнирден болды ма?
Dialogue: 0,0:03:36.25,0:03:37.05,Default,,0,0,0,,Иә
Dialogue: 0,0:03:37.17,0:03:39.21,Default,,0,0,0,,Өйткені, сен мұны істейсің.
Dialogue: 0,0:03:39.84,0:03:41.26,Default,,0,0,0,,Маширо-кун...
Dialogue: 0,0:03:41.93,0:03:44.14,Default,,0,0,0,,Inter-High бұлай емес.
Dialogue: 0,0:03:44.26,0:03:45.22,Default,,0,0,0,,Иә
Dialogue: 0,0:03:45.80,0:03:48.77,Default,,0,0,0,,～♪
Dialogue: 0,0:03:45.80,0:03:48.77,Default,,0,0,0,,Широ орта мектебінен басқа, елде бірнеше мықты мектептер бар.
Dialogue: 0,0:03:48.77,0:03:49.85,Default,,0,0,0,,Широ орта мектебінен басқа, елде тағы бірнеше мықты мектептер бар.
Dialogue: 0,0:03:50.77,0:03:55.31,Default,,0,0,0,,Сага префектурасындағы Мидоризава Кофу орта мектебі, ол грэпплингке мамандандырылған
Dialogue: 0,0:03:55.44,0:03:58.82,Default,,0,0,0,,Кагосима префектурасындағы Кагосима Шиен Гакуин бірегей қойылымдарымен
Dialogue: 0,0:04:00.11,0:04:03.53,Default,,0,0,0,,Жыл сайын Широ орта мектебімен чемпионат үшін қызу шайқас болады⸺
Dialogue: 0,0:04:03.66,0:04:06.20,Default,,0,0,0,,Токиодағы Куротеиин орта мектебі
Dialogue: 0,0:04:06.82,0:04:11.20,Default,,0,0,0,,Облыстық турнирден міндетті түрде өтіп, олармен бір сахнада тұру.
Dialogue: 0,0:04:11.33,0:04:12.12,Default,,0,0,0,,Иә
Dialogue: 0,0:04:15.21,0:04:16.63,Default,,0,0,0,,Мен барынша тырысуым керек
Dialogue: 0,0:04:19.25,0:04:21.17,Default,,0,0,0,,Бірақ ертең демалыс күні.
Dialogue: 0,0:04:21.80,0:04:23.80,Default,,0,0,0,,Денені демалу да маңызды
Dialogue: 0,0:04:23.93,0:04:24.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:25.84,0:04:26.84,Default,,0,0,0,,Я...
Dialogue: 0,0:04:26.97,0:04:29.10,Default,,0,0,0,,Мен білемін, менеджер.
Dialogue: 0,0:04:29.64,0:04:32.52,Default,,0,0,0,,Осы уақытқа дейін жеткен болсаң, әбігерге түсудің қажеті жоқ.
Dialogue: 0,0:04:33.10,0:04:35.19,Default,,0,0,0,,Ертең бәріміз жайбарақат алайық.
Dialogue: 0,0:04:35.31,0:04:36.73,Default,,0,0,0,,Уссу
Dialogue: 0,0:04:36.85,0:04:37.94,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:04:38.77,0:04:41.07,Default,,0,0,0,,Капитан ертең не істейді?
Dialogue: 0,0:04:41.19,0:04:42.53,Default,,0,0,0,,Ммм
Dialogue: 0,0:04:42.65,0:04:44.95,Default,,0,0,0,,Біраз уақыттан кейін бірінші рет дүкенге көмекке барайын ба?
Dialogue: 0,0:04:45.07,0:04:46.57,Default,,0,0,0,,Бұл дұрыс болды
Dialogue: 0,0:04:46.70,0:04:50.37,Default,,0,0,0,,Мен Tantan Girls шағын тікелей шоуынан бас тарттым.
Dialogue: 0,0:04:50.49,0:04:54.54,Default,,0,0,0,,Киноның «Адамзаттың Шурабасының» қайта басылған скринингі болады~
Dialogue: 0,0:04:55.75,0:04:58.84,Default,,0,0,0,,Біз... не істеуіміз керек?
Dialogue: 0,0:05:08.22,0:05:10.47,Default,,0,0,0,,Ах~
Dialogue: 0,0:05:10.60,0:05:11.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:14.98,0:05:18.15,Default,,0,0,0,,Иә? Үлкендеріңіз әлі де сонда ма?
Dialogue: 0,0:05:18.27,0:05:19.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:19.94,0:05:22.94,Default,,0,0,0,,Онагава-сенпай, мен жанды орындауға кешігіп қаламын.
Dialogue: 0,0:05:23.07,0:05:26.65,Default,,0,0,0,,А, м, жүр, бар, жүр.
Dialogue: 0,0:05:27.32,0:05:29.53,Default,,0,0,0,,Мұны ішкеннен кейін.
Dialogue: 0,0:05:29.66,0:05:31.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:32.99,0:05:35.66,Default,,0,0,0,,Жууға тағы бір нәрсе бар ма?
Dialogue: 0,0:05:38.71,0:05:41.92,Default,,0,0,0,,Капитан, сіз бүгін кір жууға жауапты болдыңыз ба?
Dialogue: 0,0:05:42.05,0:05:44.71,Default,,0,0,0,,Дәлірек айтқанда, мен сізге дүкенде көмектесе аламын ба?
Dialogue: 0,0:05:44.84,0:05:48.84,Default,,0,0,0,,А, ойланып қарасаңыз, бізде жұмыс күші жетерлік шығар.
Dialogue: 0,0:05:50.89,0:05:53.01,Default,,0,0,0,,Мен бармасам да...
Dialogue: 0,0:05:54.10,0:05:54.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:57.64,0:05:59.31,Default,,0,0,0,,Тантонтантон
Dialogue: 0,0:05:59.44,0:06:02.73,Default,,0,0,0,,Тан Тан Тан Тон Тан Тан Тан Тон
Dialogue: 0,0:06:02.86,0:06:04.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:04.32,0:06:07.57,Default,,0,0,0,,Сол ырғақ біздің орындаушылық әніміз!
Dialogue: 0,0:06:07.70,0:06:08.61,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:08.74,0:06:10.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:10.16,0:06:13.12,Default,,0,0,0,,Капитан! Менің ойымша, сіз жаттығуды қалайсыз ба?
Dialogue: 0,0:06:13.24,0:06:16.95,Default,,0,0,0,,Жоқ, жоқ, бұл...
Dialogue: 0,0:06:18.58,0:06:19.83,Default,,0,0,0,,Онагава!
Dialogue: 0,0:06:19.96,0:06:22.75,Default,,0,0,0,,Сіз кімсіз? Бұл саусақтардың ұштары қандай?
Dialogue: 0,0:06:22.88,0:06:25.05,Default,,0,0,0,,Істіктерді ұқыпты ретке келтіріңіз!
Dialogue: 0,0:06:25.84,0:06:26.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:28.05,0:06:30.09,Default,,0,0,0,,Мүмкін, осы жолы қатысады
Dialogue: 0,0:06:31.34,0:06:33.39,Default,,0,0,0,,Екеуің де тынышталыңдар.
Dialogue: 0,0:06:33.51,0:06:34.97,Default,,0,0,0,,Иә? Ах! (Онагава) Цукидате~!
Dialogue: 0,0:06:35.10,0:06:37.48,Default,,0,0,0,,Не? Сіз де (Онагава) айтасыз!
Dialogue: 0,0:06:37.60,0:06:39.14,Default,,0,0,0,,Не? иә? (Футаба/Мисато) А... иә?
Dialogue: 0,0:06:39.94,0:06:42.02,Default,,0,0,0,,Ах! Мен білмей тұрып!
Dialogue: 0,0:06:42.15,0:06:45.57,Default,,0,0,0,,Уф, у... орындаңыз.
Dialogue: 0,0:06:46.19,0:06:48.28,Default,,0,0,0,,Жаса!
Dialogue: 0,0:06:48.40,0:06:50.20,Default,,0,0,0,,Ах! (Мисато) Ватари-сенпай?
Dialogue: 0,0:06:50.32,0:06:51.74,Default,,0,0,0,,Секір!
Dialogue: 0,0:06:51.86,0:06:55.83,Default,,0,0,0,,Кері айналдырыңыз!
Dialogue: 0,0:06:56.37,0:06:57.62,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:57.75,0:07:00.04,Default,,0,0,0,,Не істеуіміз керек, Мисато-кун?
Dialogue: 0,0:07:00.67,0:07:02.88,Default,,0,0,0,,Менің денем де аздап қышиды.
Dialogue: 0,0:07:03.00,0:07:03.79,Default,,0,0,0,,Не!
Dialogue: 0,0:07:04.46,0:07:06.05,Default,,0,0,0,,Мықты бол, Шотаро.
Dialogue: 0,0:07:06.17,0:07:07.21,Default,,0,0,0,,Қарттар да!
Dialogue: 0,0:07:07.92,0:07:08.71,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:08.84,0:07:12.43,Default,,0,0,0,,Содан кейін өзіңізді басқа нәрсемен алаңдатып көріңіз.
Dialogue: 0,0:07:12.55,0:07:15.05,Default,,0,0,0,,Капитан, неге Сасакаманы жеп көрмейсің?
Dialogue: 0,0:07:15.18,0:07:17.93,Default,,0,0,0,,Мен жедім! Мен оны бұрыннан жегенмін!
Dialogue: 0,0:07:18.06,0:07:21.69,Default,,0,0,0,,Сасакаманың дәмін енді тата алмаймын!
Dialogue: 0,0:07:21.81,0:07:26.19,Default,,0,0,0,,Мачонның ән айтып жатқан даусын естімеймін.
Dialogue: 0,0:07:26.32,0:07:28.40,Default,,0,0,0,,Кешіріңіз, Фумия-нии!
Dialogue: 0,0:07:28.53,0:07:31.82,Default,,0,0,0,,Ағамның сөзі жүрегіме тимейді!
Dialogue: 0,0:07:31.95,0:07:35.83,Default,,0,0,0,,Жасыл... Жасыл менімен сөйлеспейді!
Dialogue: 0,0:07:35.95,0:07:39.25,Default,,0,0,0,,(4 адам айқайлайды)
Dialogue: 0,0:07:39.37,0:07:40.71,Default,,0,0,0,,Бұл ауыр...
Dialogue: 0,0:07:40.83,0:07:42.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:42.17,0:07:46.09,Default,,0,0,0,,Дұрыс сөздік Сөздік оқығыңыз келе ме?
Dialogue: 0,0:07:46.88,0:07:48.05,Default,,0,0,0,,Иә? сөздік?
Dialogue: 0,0:07:48.88,0:07:51.63,Default,,0,0,0,,Маған қатты ұнайды.
Dialogue: 0,0:07:52.22,0:07:53.55,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:08:03.94,0:08:05.90,Default,,0,0,0,,Шынында да, бұл...
Dialogue: 0,0:08:06.02,0:08:07.15,Default,,0,0,0,,Иә
Dialogue: 0,0:08:07.27,0:08:09.57,Default,,0,0,0,,Тыныштануы мүмкін
Dialogue: 0,0:08:09.69,0:08:11.82,Default,,0,0,0,,Канджи Какки!
Dialogue: 0,0:08:11.94,0:08:13.15,Default,,0,0,0,,Жақсы
Dialogue: 0,0:08:13.82,0:08:15.95,Default,,0,0,0,,Мен әдетте хаттарды оқымаймын.
Dialogue: 0,0:08:16.07,0:08:17.95,Default,,0,0,0,,Бұл тек капитан
Dialogue: 0,0:08:18.08,0:08:20.54,Default,,0,0,0,,Күрделі сөздерді оқығанда
Dialogue: 0,0:08:20.66,0:08:22.54,Default,,0,0,0,,Уау~
Dialogue: 0,0:08:22.66,0:08:25.08,Default,,0,0,0,,Мен ұйықтап жатырмын. Мүмкін бұл дұрыс шығар.
Dialogue: 0,0:08:25.21,0:08:26.79,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:27.59,0:08:29.17,Default,,0,0,0,,Неге ол бізді өзінен алыстатқысы келеді?
Dialogue: 0,0:09:14.30,0:09:17.59,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:09:17.72,0:09:19.18,Default,,0,0,0,,Жоқ! (Шичигахама) А-а...
Dialogue: 0,0:09:19.30,0:09:21.76,Default,,0,0,0,,Ааааааааааааа! (Оқушылар) Тшш!
Dialogue: 0,0:09:25.14,0:09:27.35,Default,,0,0,0,,Сөздік те жұмыс істемеді.
Dialogue: 0,0:09:27.90,0:09:30.82,Default,,0,0,0,,Ах~ Ақыр соңында жаттығу керек.
Dialogue: 0,0:09:30.94,0:09:33.11,Default,,0,0,0,,Денеңізді жылжытыңыз
Dialogue: 0,0:09:33.23,0:09:34.78,Default,,0,0,0,,Мен келісемін
Dialogue: 0,0:09:34.90,0:09:35.86,Default,,0,0,0,,Шыда...
Dialogue: 0,0:09:35.99,0:09:38.11,Default,,0,0,0,,Адам шыдайды...
Dialogue: 0,0:09:38.24,0:09:40.58,Default,,0,0,0,,Бірақ тек!
Dialogue: 0,0:09:41.20,0:09:43.29,Default,,0,0,0,,Біз не істеуіміз керек, Мисато?
Dialogue: 0,0:09:44.12,0:09:46.00,Default,,0,0,0,,Егер бұл орын алса, бұл жалғыз нұсқа
Dialogue: 0,0:09:46.12,0:09:47.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:48.87,0:09:50.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:50.17,0:09:51.34,Default,,0,0,0,,Иә
Dialogue: 0,0:09:52.34,0:09:53.30,Default,,0,0,0,,Тазалау
Dialogue: 0,0:09:54.13,0:09:55.38,Default,,0,0,0,,Тазалау?
Dialogue: 0,0:10:06.39,0:10:08.27,Default,,0,0,0,,Бұл таңқаларлық жақсы.
Dialogue: 0,0:10:08.39,0:10:10.81,Default,,0,0,0,,Иә, мен ойымды жинақтай аламын.
Dialogue: 0,0:10:15.48,0:10:16.94,Default,,0,0,0,,Өзіңізді жақсы сезінбейсіз бе?
Dialogue: 0,0:10:20.07,0:10:22.87,Default,,0,0,0,,Денеңізді қалыпты қозғалта алғаныңыз жақсы шығар.
Dialogue: 0,0:10:22.99,0:10:25.04,Default,,0,0,0,,Сұлулықты сүйетін эйс күткендей
Dialogue: 0,0:10:25.16,0:10:27.04,Default,,0,0,0,,Мен әдемі нәрселерді ұнататын Эйс емеспін.
Dialogue: 0,0:10:27.66,0:10:30.75,Default,,0,0,0,,Кіру аяқталды. Мен бірінші екінші қабатқа барамын.
Dialogue: 0,0:10:30.88,0:10:31.79,Default,,0,0,0,,О
Dialogue: 0,0:10:39.30,0:10:42.93,Default,,0,0,0,,Ойланып қарасам, мен бұл жерді бұрын ашқан емеспін.
Dialogue: 0,0:10:47.35,0:10:48.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:52.19,0:10:54.65,Default,,0,0,0,,Е-а-а-а-а!
Dialogue: 0,0:10:55.98,0:10:57.94,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:10:58.07,0:10:59.20,Default,,0,0,0,,Цу...
Dialogue: 0,0:11:01.32,0:11:02.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:08.58,0:11:08.87,Default,,0,0,0,,(баспалдақпен көтерілу дыбысы)
Dialogue: 0,0:11:08.87,0:11:10.50,Default,,0,0,0,,(баспалдақпен көтерілу дыбысы)
Dialogue: 0,0:11:08.87,0:11:10.50,Default,,0,0,0,,Шотаро, не болды? (Футаба) А?
Dialogue: 0,0:11:11.83,0:11:12.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:13.00,0:11:14.00,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:11:14.13,0:11:16.50,Default,,0,0,0,,Сіз бұл бөлмені аштыңыз ба?
Dialogue: 0,0:11:16.63,0:11:17.63,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:11:17.76,0:11:18.92,Default,,0,0,0,,Иә, олай емес.
Dialogue: 0,0:11:19.05,0:11:22.09,Default,,0,0,0,,Капитан Бұл бөлме...
Dialogue: 0,0:11:22.22,0:11:25.85,Default,,0,0,0,,Бұл жатақхана басқа клубтардың қоймасы болған кезден бері осында.
Dialogue: 0,0:11:25.97,0:11:27.68,Default,,0,0,0,,Жүгіңізді қараусыз қалдырмаңыз.
Dialogue: 0,0:11:27.81,0:11:30.81,Default,,0,0,0,,Сонымен... біз де әртүрлі нәрселерді зерттедік⸺
Dialogue: 0,0:11:30.94,0:11:33.73,Default,,0,0,0,,Мен мұның соншалықты нашар болғанын білмедім ...
Dialogue: 0,0:11:34.36,0:11:37.57,Default,,0,0,0,,Бұл жақсы мүмкіндік, сондықтан оны да тазалап көрейік.
Dialogue: 0,0:11:37.69,0:11:38.90,Default,,0,0,0,,Уссу
Dialogue: 0,0:11:39.53,0:11:41.65,Default,,0,0,0,,Иә? Мисато не болды?
Dialogue: 0,0:11:42.74,0:11:43.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:46.37,0:11:47.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:49.04,0:11:50.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:52.54,0:11:55.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:57.04,0:11:59.26,Default,,0,0,0,,Ммммм...
Dialogue: 0,0:11:59.38,0:12:00.88,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:12:04.01,0:12:05.80,Default,,0,0,0,,Мазасызсыз ба?
Dialogue: 0,0:12:05.93,0:12:07.18,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:07.76,0:12:09.77,Default,,0,0,0,,Мен жүгіруге барсам ше?
Dialogue: 0,0:12:10.31,0:12:12.14,Default,,0,0,0,,Хмм, бірақ
Dialogue: 0,0:12:12.27,0:12:15.02,Default,,0,0,0,,Мен барлығына демалыңдар~ дедім
Dialogue: 0,0:12:15.15,0:12:16.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:16.52,0:12:17.86,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:19.28,0:12:20.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:22.86,0:12:24.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:24.86,0:12:25.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:26.82,0:12:29.66,Default,,0,0,0,,Мм... Аса-чан да мазасыз сияқты.
Dialogue: 0,0:12:30.29,0:12:32.37,Default,,0,0,0,,Уа! ностальгиялық!
Dialogue: 0,0:12:32.50,0:12:34.75,Default,,0,0,0,,Ол осылай жасалған ба?
Dialogue: 0,0:12:34.87,0:12:38.42,Default,,0,0,0,,Бұл бірінші курста оқып жүргенде тіккен бірінші формамыз.
Dialogue: 0,0:12:38.54,0:12:39.55,Default,,0,0,0,,А...
Dialogue: 0,0:12:39.67,0:12:42.59,Default,,0,0,0,,Бұл да Күрикома-сенпайдың жобасы ма?
Dialogue: 0,0:12:42.72,0:12:45.84,Default,,0,0,0,,Жоқ, қазір бізде менеджер жоқ.
Dialogue: 0,0:12:45.97,0:12:49.81,Default,,0,0,0,,Оны режиссер құрастырған, ал әйелі жасаған.
Dialogue: 0,0:12:49.93,0:12:52.22,Default,,0,0,0,,Ал сіз оны ешқашан кездестірмедіңіз бе?
Dialogue: 0,0:12:52.35,0:12:56.60,Default,,0,0,0,,Енді ойлап қарасам, бұл туралы жақында ұмытып кетіппін, ал мысал параметрлері ше?
Dialogue: 0,0:12:56.73,0:12:57.86,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:12:57.98,0:13:02.19,Default,,0,0,0,,Әдетте олар бізді кездестіреді. Біз де солай ойладық.
Dialogue: 0,0:13:02.32,0:13:04.57,Default,,0,0,0,,Ол ешқашан ойынға мені қолдауға келген емес.
Dialogue: 0,0:13:04.70,0:13:06.57,Default,,0,0,0,,Сонымен... біз ойладық
Dialogue: 0,0:13:07.32,0:13:09.95,Default,,0,0,0,,Параметрлер дұрыс болмаған жағдайда
Dialogue: 0,0:13:10.70,0:13:13.83,Default,,0,0,0,,Шуу-чан, мені орта мектепке апарыңызшы.
Dialogue: 0,0:13:13.95,0:13:15.54,Default,,0,0,0,,Иә, директор оның әйелі.
Dialogue: 0,0:13:15.66,0:13:19.50,Default,,0,0,0,,Менің ойымша, сіз мені Интер-Хайға апаруға уәде бердіңіз.
Dialogue: 0,0:13:19.63,0:13:21.96,Default,,0,0,0,,Алдыңғы ойындар осылай болды
Dialogue: 0,0:13:22.09,0:13:24.17,Default,,0,0,0,,Бұл мен саған оны көруге келме деп жатырмын дегенді білдіре ме?
Dialogue: 0,0:13:24.30,0:13:28.18,Default,,0,0,0,,Сондықтан егер мен Интер-Хайға барсам, мен әпкемді кездестіре аламын.
Dialogue: 0,0:13:28.30,0:13:29.47,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:29.60,0:13:32.01,Default,,0,0,0,,Мен міндетті түрде Интер-Хайға баруым керек.
Dialogue: 0,0:13:32.64,0:13:35.39,Default,,0,0,0,,Директордың ерлі-зайыптылық келісімі үшін.
Dialogue: 0,0:13:35.52,0:13:36.52,Default,,0,0,0,,Шу-чан
Dialogue: 0,0:13:37.14,0:13:39.36,Default,,0,0,0,,Бұл мангадан шыққан нәрсеге ұқсайды.
Dialogue: 0,0:13:39.48,0:13:43.65,Default,,0,0,0,,Жоқ, бұл менің үлкендерімнің қиялы...
Dialogue: 0,0:13:44.86,0:13:45.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:46.28,0:13:48.03,Default,,0,0,0,,Бұл! Менің бірінші рет⸺
Dialogue: 0,0:13:48.16,0:13:50.03,Default,,0,0,0,,Мен үлкендерімнің өнерін көргенде...
Dialogue: 0,0:13:53.08,0:13:55.08,Default,,0,0,0,,Бұл менеджердің дизайны.
Dialogue: 0,0:13:55.70,0:14:00.67,Default,,0,0,0,,Ол бала кезінен ерлердің көркем гимнастикасын зерттеудің нәтижесі екенін айтты.
Dialogue: 0,0:14:00.79,0:14:03.71,Default,,0,0,0,,Биылғы жыл былтырғыдан да жақсарды.
Dialogue: 0,0:14:03.84,0:14:05.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:07.63,0:14:09.39,Default,,0,0,0,,Мен мұнда алғаш келгенде...
Dialogue: 0,0:14:10.51,0:14:13.06,Default,,0,0,0,,Ол шынымен де тозған.
Dialogue: 0,0:14:13.18,0:14:16.27,Default,,0,0,0,,Директор екеуміз оны тазаладық.
Dialogue: 0,0:14:16.39,0:14:19.06,Default,,0,0,0,,Ақшам жоқ болғандықтан, мердігерді шақыра алмаймын.
Dialogue: 0,0:14:19.19,0:14:22.06,Default,,0,0,0,,Барлық жөндеу жұмыстарын өзіміз жасадық.
Dialogue: 0,0:14:22.19,0:14:25.61,Default,,0,0,0,,Режиссер бізге дайындады, бәріміз дайындадық⸺
Dialogue: 0,0:14:26.24,0:14:27.95,Default,,0,0,0,,Бұл біздің жеріміз.
Dialogue: 0,0:14:29.49,0:14:31.45,Default,,0,0,0,,Біз кеткен кезде
Dialogue: 0,0:14:32.03,0:14:37.37,Default,,0,0,0,,Ватари Шотаро Мисато Мен осы жерді сұрадым.
Dialogue: 0,0:14:40.08,0:14:41.13,Default,,0,0,0,,Ол ешқашан да болмайды!
Dialogue: 0,0:14:44.50,0:14:48.30,Default,,0,0,0,,Көркем гимнастиканы ашқанша менде ештеңе болған жоқ.
Dialogue: 0,0:14:49.68,0:14:53.30,Default,,0,0,0,,Маған жапон фильмдері мен V-кинотеатр көрген ұнады.
Dialogue: 0,0:14:53.43,0:14:56.93,Default,,0,0,0,,Мен өз бетімше ештеңе істей алмаймын.
Dialogue: 0,0:14:57.06,0:14:58.56,Default,,0,0,0,,Жай жақшаны пайдаланыңыз
Dialogue: 0,0:14:59.81,0:15:00.81,Default,,0,0,0,,Тіпті орта мектепті бітіргеннен кейін⸺
Dialogue: 0,0:15:01.44,0:15:03.90,Default,,0,0,0,,Үйірме жұмыстарымен айналысқым келмеді.
Dialogue: 0,0:15:04.02,0:15:04.82,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:15:07.07,0:15:09.45,Default,,0,0,0,,Керемет! (Ер оқушы) Керемет!
Dialogue: 0,0:15:09.57,0:15:12.11,Default,,0,0,0,,Мен бұл өте керемет деп ойладым...
Dialogue: 0,0:15:13.24,0:15:14.74,Default,,0,0,0,,Сіз жаңа студентсіз бе?
Dialogue: 0,0:15:14.87,0:15:16.62,Default,,0,0,0,,Сіз оны қолданып көргіңіз келе ме?
Dialogue: 0,0:15:17.29,0:15:18.33,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:15:18.45,0:15:22.17,Default,,0,0,0,,Мен кері айналдыра алсам жақсы болар еді деп ойладым...
Dialogue: 0,0:15:22.71,0:15:26.00,Default,,0,0,0,,Жарайды, ендеше күшімізбен артқа секірейік.
Dialogue: 0,0:15:26.63,0:15:29.34,Default,,0,0,0,,Қарқын жет, Зуба! Бум! болып табылады!
Dialogue: 0,0:15:29.47,0:15:31.84,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:34.80,0:15:35.60,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:15:37.39,0:15:40.31,Default,,0,0,0,,Осы уақытқа дейін мен көрген табиғат айнала бастады⸺
Dialogue: 0,0:15:41.19,0:15:43.02,Default,,0,0,0,,Мен өзімді өзгергендей сезінемін...
Dialogue: 0,0:15:45.94,0:15:47.44,Default,,0,0,0,,Өмірімде бірінші рет
Dialogue: 0,0:15:47.57,0:15:51.36,Default,,0,0,0,,Мен тек жақшадан да көп нәрсені істегім келетінін сезіндім.
Dialogue: 0,0:15:51.99,0:15:52.78,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:15:54.28,0:15:58.29,Default,,0,0,0,,Мен Ао орта мектебінің ерлер көркем гимнастика үйірмесін міндетті түрде қорғаймын.
Dialogue: 0,0:15:58.41,0:16:00.54,Default,,0,0,0,,Оның үстіне мен секіргім келеді.
Dialogue: 0,0:16:01.54,0:16:04.67,Default,,0,0,0,,Мен өзімнің қарттармен мүмкіндігінше көп кездесуді жалғастырамын...
Dialogue: 0,0:16:05.29,0:16:06.34,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:08.17,0:16:09.13,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:10.88,0:16:11.84,Default,,0,0,0,,Сол себепті де⸺
Dialogue: 0,0:16:11.97,0:16:14.43,Default,,0,0,0,,Біріншіден, бұл аудандық турнир.
Dialogue: 0,0:16:14.55,0:16:15.80,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:16:15.93,0:16:16.72,Default,,0,0,0,,Уши
Dialogue: 0,0:16:16.85,0:16:21.23,Default,,0,0,0,,Мен тез тазалауды аяқтап, бүгін демаламын!
Dialogue: 0,0:16:21.35,0:16:22.52,Default,,0,0,0,,Иә! (Ватари) Уссу
Dialogue: 0,0:16:28.61,0:16:31.15,Default,,0,0,0,,Сіз де екінші көмекті қалайсыз ба?
Dialogue: 0,0:16:31.28,0:16:32.90,Default,,0,0,0,,Рахмет, өтінемін
Dialogue: 0,0:16:33.03,0:16:33.82,Default,,0,0,0,,Уссу
Dialogue: 0,0:16:33.95,0:16:36.49,Default,,0,0,0,,Шотаро, маған соя соусы әкел.
Dialogue: 0,0:16:36.62,0:16:37.70,Default,,0,0,0,,Иә
Dialogue: 0,0:16:40.70,0:16:41.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:42.96,0:16:43.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:43.87,0:16:46.33,Default,,0,0,0,,А-а, сен не істеп жатырсың?
Dialogue: 0,0:16:47.17,0:16:48.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:48.25,0:16:50.84,Default,,0,0,0,,А-а, кешіріңіз!
Dialogue: 0,0:16:51.55,0:16:53.80,Default,,0,0,0,,Ватари Тағы бір мата
Dialogue: 0,0:16:53.92,0:16:55.22,Default,,0,0,0,,Ах Усу
Dialogue: 0,0:16:56.09,0:16:56.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:57.01,0:16:59.26,Default,,0,0,0,,(ыстық судың дыбысы)
Dialogue: 0,0:16:59.39,0:17:03.02,Default,,0,0,0,,(Ватаридің ән айту дауысы)
Dialogue: 0,0:17:14.15,0:17:15.57,Default,,0,0,0,,Я...
Dialogue: 0,0:17:16.91,0:17:18.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:18.66,0:17:19.87,Default,,0,0,0,,Иә? (Ватари) Ой?
Dialogue: 0,0:18:01.78,0:18:02.58,Default,,0,0,0,,Я...
Dialogue: 0,0:18:03.20,0:18:04.33,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:04.95,0:18:07.46,Default,,0,0,0,,Ал, ұйықтайтын кез келді.
Dialogue: 0,0:18:07.58,0:18:08.79,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:08.92,0:18:10.71,Default,,0,0,0,,Уссу (Мисато/Футаба) Иә
Dialogue: 0,0:18:11.29,0:18:12.80,Default,,0,0,0,,Йоккора Шотто
Dialogue: 0,0:18:18.13,0:18:19.26,Default,,0,0,0,,Цукидат
Dialogue: 0,0:18:19.89,0:18:21.01,Default,,0,0,0,,Онагава
Dialogue: 0,0:18:21.76,0:18:22.68,Default,,0,0,0,,Ватари
Dialogue: 0,0:18:23.35,0:18:24.43,Default,,0,0,0,,Шотаро
Dialogue: 0,0:18:24.56,0:18:26.14,Default,,0,0,0,,Мисато
Dialogue: 0,0:18:26.98,0:18:29.19,Default,,0,0,0,,Әрине, әлі біткен жоқ
Dialogue: 0,0:18:29.77,0:18:31.15,Default,,0,0,0,,Облыстық турнирден өту⸺
Dialogue: 0,0:18:31.81,0:18:34.15,Default,,0,0,0,,Inter-High-ге міндетті түрде қатысыңыз!
Dialogue: 0,0:18:35.23,0:18:36.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:36.78,0:18:40.07,Default,,0,0,0,,Қарашы, мен ертең қолымнан келгенше секіремін!
Dialogue: 0,0:18:40.20,0:18:41.49,Default,,0,0,0,,Иә (Ватари) Уссу
Dialogue: 0,0:18:52.21,0:18:53.84,Default,,0,0,0,,Не болды? (Футаба) Әй!
Dialogue: 0,0:18:55.67,0:18:56.92,Default,,0,0,0,,Заттарыңды үйге әкетуді ұмытып қалғансың ғой…
Dialogue: 0,0:18:57.80,0:18:59.97,Default,,0,0,0,,Мен өзімді еркін сезінбеймін.
Dialogue: 0,0:19:00.68,0:19:01.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:02.43,0:19:07.06,Default,,0,0,0,,Мен бірінші курс студенті болсам, қобалжыған болар едім деп ойлаймын.
Dialogue: 0,0:19:08.10,0:19:10.14,Default,,0,0,0,,Сенің келгеніңе қуаныштымын, Мисато.
Dialogue: 0,0:19:10.77,0:19:14.65,Default,,0,0,0,,Шынымды айтсам, басында қиын деп ойладым.
Dialogue: 0,0:19:15.36,0:19:19.53,Default,,0,0,0,,Мен үйірмеге қосылған жаңа мүшем орта мектепте оқитын эйс болды.
Dialogue: 0,0:19:20.36,0:19:22.99,Default,,0,0,0,,Бірақ Мисато сол жерде болғандықтан
Dialogue: 0,0:19:23.12,0:19:26.12,Default,,0,0,0,,Мен Мисатоны қуып осынша келдім деп ойлаймын.
Dialogue: 0,0:19:27.62,0:19:28.75,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,0:19:28.87,0:19:30.21,Default,,0,0,0,,Суық тиіп қалдың ба? Жағдайың қалай?
Dialogue: 0,0:19:30.79,0:19:33.63,Default,,0,0,0,,Әзірге бұл аудандық турнир.
Dialogue: 0,0:19:34.25,0:19:36.88,Default,,0,0,0,,А... Түсіндім.
Dialogue: 0,0:19:37.75,0:19:38.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:38.92,0:19:40.09,Default,,0,0,0,,Биыл ғана дебют жасаған –
Dialogue: 0,0:19:40.67,0:19:41.80,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:44.80,0:19:46.39,Default,,0,0,0,,Ертеңгі күні барымызды салайық
Dialogue: 0,0:19:47.35,0:19:48.56,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:19:48.68,0:19:49.93,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:20:18.17,0:20:18.96,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:20.34,0:20:22.05,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:20:22.17,0:20:23.26,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:23.84,0:20:24.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:26.72,0:20:28.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:28.31,0:20:29.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:31.10,0:20:33.14,Default,,0,0,0,,Кууууууууууууууу...
Dialogue: 0,0:20:34.19,0:20:34.98,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:38.52,0:20:39.73,Default,,0,0,0,,Ах! Ха!
Dialogue: 0,0:20:42.49,0:20:43.57,Default,,0,0,0,,Не?
Dialogue: 0,0:20:49.16,0:20:50.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:51.75,0:20:53.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:53.12,0:20:56.42,Default,,0,0,0,,♬ Қазір, соңының хабаршысы
Dialogue: 0,0:21:01.13,0:21:02.38,Default,,0,0,0,,Шотаро
Dialogue: 0,0:21:02.51,0:21:03.72,Default,,0,0,0,,Шотаро!
Dialogue: 0,0:21:04.26,0:21:06.01,Default,,0,0,0,,Шотаро! (Футаба) Ха!
Dialogue: 0,0:21:06.97,0:21:11.35,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:21:11.47,0:21:13.56,Default,,0,0,0,,Мисато... сен...
Dialogue: 0,0:21:13.68,0:21:14.48,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:21:14.60,0:21:15.39,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:15.52,0:21:17.15,Default,,0,0,0,,Эй, Цукихико-сан.
Dialogue: 0,0:21:17.77,0:21:18.90,Default,,0,0,0,,Бұл…
Dialogue: 0,0:21:19.02,0:21:19.52,Default,,0,0,0,,(Футаба азаптарының дауысы)
Dialogue: 0,0:21:19.52,0:21:21.02,Default,,0,0,0,,(Футаба азаптарының дауысы)
Dialogue: 0,0:21:19.52,0:21:21.02,Default,,0,0,0,,Шотаро?
Dialogue: 0,0:21:21.02,0:21:21.15,Default,,0,0,0,,(Футаба азаптарының дауысы)
Dialogue: 0,0:21:21.15,0:21:22.23,Default,,0,0,0,,(Футаба азаптарының дауысы)
Dialogue: 0,0:21:21.15,0:21:22.23,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:21:22.23,0:21:22.36,Default,,0,0,0,,(Футаба азаптарының дауысы)
Dialogue: 0,0:21:22.36,0:21:24.40,Default,,0,0,0,,(Футаба азаптарының дауысы)
Dialogue: 0,0:21:22.36,0:21:24.40,Default,,0,0,0,,Сәлем Шотаро!
Dialogue: 0,0:21:24.40,0:21:24.95,Default,,0,0,0,,(Футаба азаптарының дауысы)
Dialogue: 0,0:21:24.95,0:21:25.90,Default,,0,0,0,,(Футаба азаптарының дауысы)
Dialogue: 0,0:21:24.95,0:21:25.90,Default,,0,0,0,,Шотаро!
Dialogue: 0,0:21:26.03,0:21:30.99,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.91,0:22:55.87,Default,,0,0,0,,～♪
