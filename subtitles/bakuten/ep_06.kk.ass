Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.50,0:00:08.42,Default,,0,0,0,,Биылғы форма дайын
Dialogue: 0,0:00:08.50,0:00:09.63,Default,,0,0,0,,Бірыңғай киім!
Dialogue: 0,0:00:10.59,0:00:12.38,Default,,0,0,0,,Өткен жылға қарағанда салқын емес пе?
Dialogue: 0,0:00:12.47,0:00:14.88,Default,,0,0,0,,Сіз дамып жатырсыз, менеджер.
Dialogue: 0,0:00:14.97,0:00:16.47,Default,,0,0,0,,Расында Панайессу
Dialogue: 0,0:00:16.55,0:00:17.64,Default,,0,0,0,,(Изуку) Қарсыластың өз күшін пайдаланып, дәл қорғанына сондай етіп сүңгу...
Dialogue: 0,0:00:18.22,0:00:19.56,Default,,0,0,0,,Менің формасым
Dialogue: 0,0:00:19.64,0:00:21.47,Default,,0,0,0,,Менеджер оны жобалайды.
Dialogue: 0,0:00:21.56,0:00:23.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:23.18,0:00:24.98,Default,,0,0,0,,Күрикома-сенпай керемет!
Dialogue: 0,0:00:25.06,0:00:26.90,Default,,0,0,0,,Олай болса, (Ватари) Аузыңды жап!
Dialogue: 0,0:00:26.98,0:00:28.73,Default,,0,0,0,,Бұл қызықты болып барады!
Dialogue: 0,0:00:28.82,0:00:29.94,Default,,0,0,0,,Не!
Dialogue: 0,0:00:30.03,0:00:33.15,Default,,0,0,0,,Қыздар да бар...
Dialogue: 0,0:00:33.24,0:00:34.65,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:34.74,0:00:35.91,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:00:35.99,0:00:36.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:37.53,0:00:40.37,Default,,0,0,0,,Уайымдамаңыз және жалғастырыңыз.
Dialogue: 0,0:00:40.45,0:00:42.45,Default,,0,0,0,,Сіз бұлай айтқанда...
Dialogue: 0,0:00:40.45,0:00:42.45,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:00:42.45,0:00:42.54,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:00:42.54,0:00:44.62,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:00:42.54,0:00:44.62,Default,,0,0,0,,Сізге көрсетудің қажеті жоқ...
Dialogue: 0,0:00:44.62,0:00:44.71,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:00:44.71,0:00:45.54,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:00:44.71,0:00:45.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:45.62,0:00:46.96,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:48.08,0:00:49.29,Default,,0,0,0,,Оқу-жаттығу жиыны аяқталды.
Dialogue: 0,0:00:49.38,0:00:51.67,Default,,0,0,0,,Префектуралық турнирге 5 күн қалды
Dialogue: 0,0:00:51.76,0:00:55.80,Default,,0,0,0,,Мен Ао орта мектебіндегі ұлдар көркем гимнастика үйірмесінің мүшесімін.
Dialogue: 0,0:00:55.88,0:00:56.97,Default,,0,0,0,,Матчқа қатысыңыз
Dialogue: 0,0:00:57.05,0:01:02.06,Default,,0,0,0,,♪～
Dialogue: 0,0:02:21.93,0:02:26.93,Default,,0,0,0,,～♪
Dialogue: 0,0:02:32.15,0:02:35.07,Default,,0,0,0,,Шичигахама Сенпай: Мен тізені қолдану тәсілін жақсарттым.
Dialogue: 0,0:02:35.15,0:02:35.98,Default,,0,0,0,,Иә
Dialogue: 0,0:02:36.07,0:02:40.49,Default,,0,0,0,,Цукидате-кун да көтергенде қолын соза бастады.
Dialogue: 0,0:02:41.20,0:02:42.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:50.50,0:02:52.54,Default,,0,0,0,,Тіл бар Цукидате-кун
Dialogue: 0,0:02:52.63,0:02:53.92,Default,,0,0,0,,Иә
Dialogue: 0,0:02:54.00,0:02:56.50,Default,,0,0,0,,Онагава-кун, бірінші тіліңді жапшы.
Dialogue: 0,0:02:56.59,0:02:57.55,Default,,0,0,0,,Иә
Dialogue: 0,0:02:57.63,0:03:00.05,Default,,0,0,0,,Ватари-кун, үстіңгі және астыңғы аяқ-қолдарыңды қыспа.
Dialogue: 0,0:03:00.13,0:03:01.51,Default,,0,0,0,,...
Dialogue: 0,0:03:01.59,0:03:03.30,Default,,0,0,0,,Футаба-кун (Футаба) Иә.
Dialogue: 0,0:03:04.80,0:03:06.22,Default,,0,0,0,,Тынышталайық.
Dialogue: 0,0:03:06.31,0:03:08.43,Default,,0,0,0,,Хмм... Иә!
Dialogue: 0,0:03:12.19,0:03:15.61,Default,,0,0,0,,♪～
Dialogue: 0,0:03:17.65,0:03:18.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:20.28,0:03:21.11,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:21.20,0:03:22.53,Default,,0,0,0,,U.A. Спорттық күні тез арада келіп жетті
Dialogue: 0,0:03:22.61,0:03:25.49,Default,,0,0,0,,Шотаро әрқашан қол ұстасуда сәтсіздікке ұшырайды
Dialogue: 0,0:03:26.12,0:03:28.41,Default,,0,0,0,,Мен тек қол ұстай аламын.
Dialogue: 0,0:03:28.49,0:03:31.58,Default,,0,0,0,,Сіз актерлік ағымға ілесе алмайтын сияқтысыз.
Dialogue: 0,0:03:28.49,0:03:31.58,Default,,0,0,0,,～♪
Dialogue: 0,0:03:32.67,0:03:33.50,Default,,0,0,0,,Шотаро
Dialogue: 0,0:03:33.58,0:03:35.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:35.92,0:03:38.17,Default,,0,0,0,,Тепе-теңдікті сақтауға тырысқанда аяғым тұрақсыз болады.
Dialogue: 0,0:03:38.76,0:03:40.17,Default,,0,0,0,,Еденді саусақтарыңызбен ұстаңыз
Dialogue: 0,0:03:41.30,0:03:43.93,Default,,0,0,0,,А... иә, рахмет
Dialogue: 0,0:03:44.55,0:03:46.01,Default,,0,0,0,,үшін бірге жиналады
Dialogue: 0,0:03:46.10,0:03:47.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:53.48,0:03:54.48,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:55.52,0:03:58.19,Default,,0,0,0,,♪～
Dialogue: 0,0:04:50.54,0:04:54.33,Default,,0,0,0,,～♪
Dialogue: 0,0:04:55.16,0:04:56.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:58.84,0:05:00.75,Default,,0,0,0,,Дегенмен, заттары көп екен.
Dialogue: 0,0:05:02.05,0:05:02.26,Default,,0,0,0,,(тырс еткен дыбыс)
Dialogue: 0,0:05:02.26,0:05:03.09,Default,,0,0,0,,(тырс еткен дыбыс)
Dialogue: 0,0:05:02.26,0:05:03.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:03.17,0:05:04.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:06.68,0:05:08.59,Default,,0,0,0,,Ертең префектуралық турнир
Dialogue: 0,0:05:08.68,0:05:11.72,Default,,0,0,0,,Сәл ерте, бірақ бүгінге осы.
Dialogue: 0,0:05:11.81,0:05:13.47,Default,,0,0,0,,Сіздің жеткілікті демалуыңызға көз жеткізіңіз
Dialogue: 0,0:05:13.56,0:05:15.94,Default,,0,0,0,,Иә! көп рахмет!
Dialogue: 0,0:05:16.02,0:05:17.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:18.52,0:05:21.07,Default,,0,0,0,,Сен де бүгін бірден үйге барасың ба?
Dialogue: 0,0:05:21.15,0:05:23.11,Default,,0,0,0,,Жылдам қайтарылатын эйс
Dialogue: 0,0:05:23.19,0:05:25.32,Default,,0,0,0,,Үйге тез оралу емес
Dialogue: 0,0:05:25.40,0:05:27.20,Default,,0,0,0,,Олай болса кездесейік.
Dialogue: 0,0:05:27.28,0:05:28.36,Default,,0,0,0,,Ол оған кім?
Dialogue: 0,0:05:28.45,0:05:29.74,Default,,0,0,0,,Хи хи
Dialogue: 0,0:05:29.82,0:05:31.37,Default,,0,0,0,,Кішкене ғана (Мисато) Иә?
Dialogue: 0,0:05:31.45,0:05:34.04,Default,,0,0,0,,Бұл аз, бірақ бұл сәл сәнді.
Dialogue: 0,0:05:31.45,0:05:34.04,Default,,0,0,0,,Хи хи хи хи...
Dialogue: 0,0:05:34.12,0:05:35.25,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:35.91,0:05:37.25,Default,,0,0,0,,Жая~!
Dialogue: 0,0:05:37.33,0:05:38.54,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:05:38.62,0:05:41.00,Default,,0,0,0,,Қариядан, Жеңіс дұғасы болып.
Dialogue: 0,0:05:41.09,0:05:42.17,Default,,0,0,0,,Бұл гиозалар туралы не деуге болады?
Dialogue: 0,0:05:42.25,0:05:44.26,Default,,0,0,0,,Бұл әкемнің сыйы еді.
Dialogue: 0,0:05:44.34,0:05:46.42,Default,,0,0,0,,Ватаридің гиозасы дәмді
Dialogue: 0,0:05:46.51,0:05:47.84,Default,,0,0,0,,Сондай-ақ бамбуктан жасалған себет бар.
Dialogue: 0,0:05:48.43,0:05:51.76,Default,,0,0,0,,Today's - жаңадан жасалған котлет сэндвич дәмінің прототипі!
Dialogue: 0,0:05:51.85,0:05:55.10,Default,,0,0,0,,Сасаначи мырза өнімді әзірлеуге ынталы.
Dialogue: 0,0:05:56.31,0:05:57.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:57.85,0:06:00.06,Default,,0,0,0,,Әкемнен қалған тұмар дорба
Dialogue: 0,0:06:00.15,0:06:02.27,Default,,0,0,0,,Оны таяқша сияқты қоймаңыз.
Dialogue: 0,0:06:02.90,0:06:05.82,Default,,0,0,0,,Қолдауыңыз үшін өте ризамын.
Dialogue: 0,0:06:05.90,0:06:07.45,Default,,0,0,0,,Ал, алайық.
Dialogue: 0,0:06:08.07,0:06:09.03,Default,,0,0,0,,Итадакимасу
Dialogue: 0,0:06:09.11,0:06:10.03,Default,,0,0,0,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:06:09.11,0:06:10.03,Default,,0,0,0,,(қолды біріктіру дыбысы)
Dialogue: 0,0:06:10.11,0:06:12.41,Default,,0,0,0,,Чили майы Чили майы ~
Dialogue: 0,0:06:13.24,0:06:14.62,Default,,0,0,0,,Құйрық басы бар Дәмді!
Dialogue: 0,0:06:14.70,0:06:15.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:16.66,0:06:18.25,Default,,0,0,0,,Ол үшін уайымдама, Шотаро.
Dialogue: 0,0:06:18.33,0:06:19.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:20.88,0:06:23.00,Default,,0,0,0,,Сіз қол ұстағышты айтасыз, солай ма?
Dialogue: 0,0:06:23.09,0:06:24.46,Default,,0,0,0,,Тіпті сәтсіз болса да...
Dialogue: 0,0:06:24.55,0:06:27.97,Default,,0,0,0,,Ешқандай қателік жасамасақ, проблема болмайды.
Dialogue: 0,0:06:28.05,0:06:29.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:29.26,0:06:32.72,Default,,0,0,0,,Онагава-сенпай да кейде қолмен ұстау кезінде тепе-теңдігін жоғалтады.
Dialogue: 0,0:06:32.80,0:06:33.68,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:33.76,0:06:35.10,Default,,0,0,0,,Олар білмейді деп ойладың ба?
Dialogue: 0,0:06:35.18,0:06:36.64,Default,,0,0,0,,үшін байқады.
Dialogue: 0,0:06:36.72,0:06:39.81,Default,,0,0,0,,Тоқташы~ Мен Шотароның көңілін көтеруге тырыстым~
Dialogue: 0,0:06:39.89,0:06:41.15,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:41.23,0:06:42.52,Default,,0,0,0,,Ешкім... (Футаба) А?
Dialogue: 0,0:06:42.61,0:06:45.36,Default,,0,0,0,,Жаңадан келген адам ретінде сенен еш үмітім жоқ.
Dialogue: 0,0:06:45.44,0:06:46.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:47.53,0:06:50.40,Default,,0,0,0,,Хаха... Сондықтан жай ғана демалыңыз...
Dialogue: 0,0:06:50.49,0:06:51.91,Default,,0,0,0,,Бұл дегеніміз? Мисато
Dialogue: 0,0:06:51.99,0:06:52.82,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:52.91,0:06:54.37,Default,,0,0,0,,Ақыр соңында, Эйс нашар сөйлейтін.
Dialogue: 0,0:06:54.45,0:06:56.74,Default,,0,0,0,,Мен сөйлейтін эйс емеспін.
Dialogue: 0,0:06:56.83,0:06:58.87,Default,,0,0,0,,Үшеуміз жұмыс істеген кезде...
Dialogue: 0,0:06:58.96,0:07:02.63,Default,,0,0,0,,Мен бірінші кезекте турнирге қатыса алмадым.
Dialogue: 0,0:07:03.21,0:07:07.13,Default,,0,0,0,,Өткен жылы 4 адам болды, 3 ұпай шартсыз алынып тасталды.
Dialogue: 0,0:07:07.21,0:07:08.05,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:08.13,0:07:10.51,Default,,0,0,0,,Бұл зат жойылса да, бәрі жақсы!
Dialogue: 0,0:07:10.59,0:07:11.93,Default,,0,0,0,,Жарайды! (Футаба) А?
Dialogue: 0,0:07:12.51,0:07:14.60,Default,,0,0,0,,Ертең мүмкіндігінше секір
Dialogue: 0,0:07:14.68,0:07:16.35,Default,,0,0,0,,Иә
Dialogue: 0,0:07:16.97,0:07:20.60,Default,,0,0,0,,Сіз ақыры осы уақытқа дейін жеттіңіз.
Dialogue: 0,0:07:21.94,0:07:23.10,Default,,0,0,0,,Фу…
Dialogue: 0,0:07:23.19,0:07:25.82,Default,,0,0,0,,Мен бұған үш жыл кетеді деп ойламадым.
Dialogue: 0,0:07:26.69,0:07:28.19,Default,,0,0,0,,Бірақ мен оны уақытында орындадым
Dialogue: 0,0:07:31.24,0:07:34.99,Default,,0,0,0,,Директор бізге берген уәдесін орындады.
Dialogue: 0,0:07:35.53,0:07:37.33,Default,,0,0,0,,Көркем гимнастика ерлер үйірмесі...
Dialogue: 0,0:07:38.08,0:07:40.91,Default,,0,0,0,,Бізге орын жасап беремін дейді.
Dialogue: 0,0:07:45.59,0:07:48.05,Default,,0,0,0,,Ендігі кезекте уәдемізді орындау.
Dialogue: 0,0:07:48.96,0:07:52.63,Default,,0,0,0,,Мен директорды орта мектепке міндетті түрде әкелемін!
Dialogue: 0,0:07:53.38,0:07:54.80,Default,,0,0,0,,Стейннен алған жарақаттарым әлі толық жазылмағандықтан—
Dialogue: 0,0:07:57.93,0:08:00.06,Default,,0,0,0,,А, мен түсіндім...
Dialogue: 0,0:08:00.81,0:08:01.64,Default,,0,0,0,,Капитан!
Dialogue: 0,0:08:01.73,0:08:04.48,Default,,0,0,0,,Әй... (Ватари) Цукидате-сенпай! Онагава-сенпай!
Dialogue: 0,0:08:04.56,0:08:05.86,Default,,0,0,0,,Бұл не, Ватари?
Dialogue: 0,0:08:05.94,0:08:08.32,Default,,0,0,0,,Лайықсыз Котаро Ватари!
Dialogue: 0,0:08:08.40,0:08:10.49,Default,,0,0,0,,Біз сізді Интер-Хайге дейін алып барамыз!
Dialogue: 0,0:08:10.57,0:08:12.28,Default,,0,0,0,,Соңына дейін
Dialogue: 0,0:08:12.36,0:08:13.99,Default,,0,0,0,,Бұл қару-жарақ-
Dialogue: 0,0:08:14.07,0:08:15.91,Default,,0,0,0,,Менің аяғым сынса да!
Dialogue: 0,0:08:15.99,0:08:17.12,Default,,0,0,0,,Уау! (Мисато) Ах!
Dialogue: 0,0:08:17.70,0:08:19.62,Default,,0,0,0,,Мен жалғыз емеспін!
Dialogue: 0,0:08:19.70,0:08:23.04,Default,,0,0,0,,Шотаро да, Мисато да...
Dialogue: 0,0:08:23.12,0:08:24.71,Default,,0,0,0,,Онда неге жылайсың?
Dialogue: 0,0:08:24.79,0:08:26.71,Default,,0,0,0,,Ватаридің түрі қорқынышты (Шичигахама)...
Dialogue: 0,0:08:26.79,0:08:29.13,Default,,0,0,0,,Не? жылау? Дәл қазір? Бұл өтірік емес пе?
Dialogue: 0,0:08:29.21,0:08:31.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:29.21,0:08:31.09,Default,,0,0,0,,Шотаро Мисато қолдан келгеннің бәрін жасайық~
Dialogue: 0,0:08:31.09,0:08:31.17,Default,,0,0,0,,Шотаро Мисато Қолымыздан келгеннің бәрін жасайық~
Dialogue: 0,0:08:31.17,0:08:33.13,Default,,0,0,0,,Шотаро Мисато, барымызды салайық~
Dialogue: 0,0:08:31.17,0:08:33.13,Default,,0,0,0,,Жылама
Dialogue: 0,0:08:36.72,0:08:39.26,Default,,0,0,0,,Хмм... Мен істеймін~
Dialogue: 0,0:08:39.35,0:08:40.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:45.02,0:08:47.44,Default,,0,0,0,,(Тинтин қыздарының музыкасы)
Dialogue: 0,0:08:55.49,0:08:57.45,Default,,0,0,0,,Цукидат (Цукидате) Иә?
Dialogue: 0,0:08:58.74,0:09:01.16,Default,,0,0,0,,Осы жерден бастап жасайық.
Dialogue: 0,0:09:02.66,0:09:04.83,Default,,0,0,0,,Ах Шичигахама
Dialogue: 0,0:09:49.71,0:09:51.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:54.21,0:09:57.22,Default,,0,0,0,,Кешіріңіз, мен бүгін көңіл көтеруге бара алмаймын.
Dialogue: 0,0:09:57.30,0:09:59.43,Default,,0,0,0,,Бұл жұмыс, менің амалым жоқ.
Dialogue: 0,0:10:00.60,0:10:01.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:01.51,0:10:04.81,Default,,0,0,0,,Сирек кездесетін Рё Чан — бойтұмар.
Dialogue: 0,0:10:08.35,0:10:10.94,Default,,0,0,0,,Өйткені мен міндетті түрде Интер-Хайге барғым келеді
Dialogue: 0,0:10:11.02,0:10:11.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:12.82,0:10:13.82,Default,,0,0,0,,Сәттілік тілеймін!
Dialogue: 0,0:10:13.90,0:10:14.94,Default,,0,0,0,,Иә
Dialogue: 0,0:10:22.74,0:10:25.37,Default,,0,0,0,,Директор Қайырлы таң!
Dialogue: 0,0:10:27.79,0:10:29.25,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:30.42,0:10:31.96,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:10:32.92,0:10:34.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:36.76,0:10:38.34,Default,,0,0,0,,Онда біраз нәрсе бар.
Dialogue: 0,0:10:38.42,0:10:41.55,Default,,0,0,0,,Бұл жолы алты мектеп қатысуда.
Dialogue: 0,0:10:41.64,0:10:44.89,Default,,0,0,0,,Ең жақсы екі мектеп Тохоку аймақтық турниріне өтеді...?
Dialogue: 0,0:10:44.97,0:10:47.10,Default,,0,0,0,,Шо-чан және басқалары қашан шығады?
Dialogue: 0,0:10:47.18,0:10:50.35,Default,,0,0,0,,Ao High - бұл... соңғы!
Dialogue: 0,0:10:50.44,0:10:53.11,Default,,0,0,0,,Соңғысы~ Мен қатты қобалжыдым~
Dialogue: 0,0:10:53.19,0:10:54.94,Default,,0,0,0,,Әкең көрінбейді ғой, солай ма?
Dialogue: 0,0:10:54.94,0:10:56.11,Default,,0,0,0,,Әкең келетін сияқты емес пе?
Dialogue: 0,0:10:54.94,0:10:56.11,Default,,0,0,0,,Ашылу салтанаты енді басталады.
Dialogue: 0,0:10:56.11,0:10:56.19,Default,,0,0,0,,Енді ашылу салтанаты басталады.
Dialogue: 0,0:10:56.19,0:10:57.15,Default,,0,0,0,,Енді ашылу салтанаты басталады.
Dialogue: 0,0:10:56.19,0:10:57.15,Default,,0,0,0,,О!
Dialogue: 0,0:10:57.15,0:10:57.23,Default,,0,0,0,,Енді ашылу салтанаты басталады.
Dialogue: 0,0:10:57.23,0:10:58.15,Default,,0,0,0,,Ашылу салтанаты енді басталады.
Dialogue: 0,0:10:57.23,0:10:58.15,Default,,0,0,0,,Ху... (Аюми) Хаха
Dialogue: 0,0:10:58.24,0:10:59.90,Default,,0,0,0,,Спортшының кіреберісі
Dialogue: 0,0:11:00.78,0:11:01.74,Default,,0,0,0,,Ант!
Dialogue: 0,0:11:01.82,0:11:06.37,Default,,0,0,0,,Біз барлық ойыншылар күнделікті жаттығуларымыздың нәтижелерін көрсетеміз.
Dialogue: 0,0:11:07.37,0:11:11.50,Default,,0,0,0,,Бар күшіңізбен жүгіріңіз, бар күшіңізбен секіріңіз, бар күшіңізбен әрекет етіңіз ...
Dialogue: 0,0:11:13.21,0:11:16.05,Default,,0,0,0,,Нақты спектакльден 15 минут бұрын осында кездесіңіз
Dialogue: 0,0:11:16.13,0:11:18.05,Default,,0,0,0,,Жеткілікті жылытуды ұмытпаңыз
Dialogue: 0,0:11:18.13,0:11:18.96,Default,,0,0,0,,Иә
Dialogue: 0,0:11:21.80,0:11:23.39,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:11:25.93,0:11:29.27,Default,,0,0,0,,14 ұпай жоғары ма? Төмен бе?
Dialogue: 0,0:11:29.35,0:11:32.40,Default,,0,0,0,,Ал... 20-дан жалпы ұпай.
Dialogue: 0,0:11:32.48,0:11:36.27,Default,,0,0,0,,№2 Мацусима Минами орта мектебі
Dialogue: 0,0:11:36.36,0:11:38.61,Default,,0,0,0,,(Онагава гуілдейді)
Dialogue: 0,0:11:42.95,0:11:44.24,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:11:46.16,0:11:47.37,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:11:50.16,0:11:52.33,Default,,0,0,0,,Ха ха ха ха…
Dialogue: 0,0:12:06.05,0:12:07.30,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:07.39,0:12:08.22,Default,,0,0,0,,Әй
Dialogue: 0,0:12:09.10,0:12:10.10,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:11.68,0:12:13.14,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:13.23,0:12:15.02,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:12:18.86,0:12:19.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:23.40,0:12:26.24,Default,,0,0,0,,Сіз қазір келіп тұрсыз ба? Сіз кешіктіңіз.
Dialogue: 0,0:12:26.99,0:12:29.58,Default,,0,0,0,,Сіздерден басқа көруге тұрарлық емес...
Dialogue: 0,0:12:29.66,0:12:31.75,Default,,0,0,0,,Мен мұны айтқым келеді
Dialogue: 0,0:12:31.83,0:12:35.67,Default,,0,0,0,,Сіз шынымен лайықсыз ба...
Dialogue: 0,0:12:35.75,0:12:38.34,Default,,0,0,0,,Олар префектуралық турнирден өтті.
Dialogue: 0,0:12:38.42,0:12:39.50,Default,,0,0,0,,«Алдау?» Оны алдау үшін не істемексің?
Dialogue: 0,0:12:39.59,0:12:42.59,Default,,0,0,0,,6 адам болған соң мен саған өз күшімізді көрсетемін.
Dialogue: 0,0:12:43.38,0:12:46.64,Default,,0,0,0,,Жануарлардың саны бірдей болғандықтан үлкен мәміле жасамаңыз.
Dialogue: 0,0:12:56.40,0:12:58.19,Default,,0,0,0,,Жағдайың жақсы сияқты (Мисато) Иә?
Dialogue: 0,0:12:58.94,0:13:00.57,Default,,0,0,0,,Ол кезде қызық болатын сияқты.
Dialogue: 0,0:13:01.32,0:13:05.15,Default,,0,0,0,,Ао-бидің басқа адамдары қандай екенін білмеймін.
Dialogue: 0,0:13:08.49,0:13:10.58,Default,,0,0,0,,Әйтеуір, мен оны асыға күтемін.
Dialogue: 0,0:13:10.66,0:13:13.45,Default,,0,0,0,,Маширо, иә? не?
Dialogue: 0,0:13:13.54,0:13:14.71,Default,,0,0,0,,Гимназия сол жерде
Dialogue: 0,0:13:14.79,0:13:15.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:15.92,0:13:17.12,Default,,0,0,0,,Машироха!
Dialogue: 0,0:13:17.21,0:13:19.38,Default,,0,0,0,,Мен сізбен біраз уақыттан бері хабарласа алмай жүрмін.
Dialogue: 0,0:13:19.46,0:13:20.29,Default,,0,0,0,,Сол бала менің одақтасым болады дегің келе ме?
Dialogue: 0,0:13:22.38,0:13:23.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:24.38,0:13:26.30,Default,,0,0,0,,Егер бұл менің кінәм болса...
Dialogue: 0,0:13:29.47,0:13:30.68,Default,,0,0,0,,Мен міндетті түрде жетістікке жетуім керек...
Dialogue: 0,0:13:36.48,0:13:40.90,Default,,0,0,0,,Қазір Мацусима Минами 16,950 ұпаймен бірінші орында
Dialogue: 0,0:13:40.98,0:13:44.28,Default,,0,0,0,,Сендай Токуоның қойылымы басталғалы жатыр
Dialogue: 0,0:13:44.36,0:13:49.28,Default,,0,0,0,,Сендай Токуо одан жоғары ұпай жинайтын шығар.
Dialogue: 0,0:13:49.37,0:13:53.41,Default,,0,0,0,,№5 Сендай Токуо орта мектебі
Dialogue: 0,0:13:49.37,0:13:53.41,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:13:54.12,0:13:56.37,Default,,0,0,0,,Шочанның мектебін алда не күтіп тұр?
Dialogue: 0,0:13:56.46,0:13:57.29,Default,,0,0,0,,Иә
Dialogue: 0,0:13:58.21,0:14:00.00,Default,,0,0,0,,Бұл 6 ойыншысы бар бірінші ойын.
Dialogue: 0,0:14:00.79,0:14:02.92,Default,,0,0,0,,Міне, осы жерден бастаймыз
Dialogue: 0,0:14:03.00,0:14:03.92,Default,,0,0,0,,Иә
Dialogue: 0,0:14:04.00,0:14:04.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:05.01,0:14:06.17,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:06.97,0:14:09.84,Default,,0,0,0,,үшін, бұл аспан! Аспанға секірейік!
Dialogue: 0,0:14:09.93,0:14:11.39,Default,,0,0,0,,О! (Футаба/Мисато) Иә!
Dialogue: 0,0:14:11.93,0:14:14.47,Default,,0,0,0,,♪～
Dialogue: 0,0:14:19.73,0:14:21.11,Default,,0,0,0,,Уау, бұл керемет!
Dialogue: 0,0:14:21.19,0:14:25.99,Default,,0,0,0,,Иә, тіпті үйренбеген көзге де бұл мен оқыған мектептен мүлдем басқаша.
Dialogue: 0,0:14:29.45,0:14:30.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:30.41,0:14:31.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:32.32,0:14:33.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:35.04,0:14:36.45,Default,,0,0,0,,Ммм...
Dialogue: 0,0:14:36.54,0:14:40.29,Default,,0,0,0,,Өткен жылғы жеңімпаз мектеп күткендей.
Dialogue: 0,0:14:40.37,0:14:41.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:41.75,0:14:45.13,Default,,0,0,0,,Екінші төңкеріске кіру уақытына назар аударыңыз.
Dialogue: 0,0:14:45.21,0:14:48.01,Default,,0,0,0,,Содан кейін оны әдеттегідей орындаңыз, сонда бәрі жақсы болады.
Dialogue: 0,0:14:48.84,0:14:50.34,Default,,0,0,0,,Ах! иә?
Dialogue: 0,0:14:50.43,0:14:52.51,Default,,0,0,0,,～♪
Dialogue: 0,0:14:54.14,0:14:55.39,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:14:55.47,0:14:57.35,Default,,0,0,0,,Ооооо!
Dialogue: 0,0:14:57.43,0:14:59.39,Default,,0,0,0,,(Қол шапалақтау)
Dialogue: 0,0:15:01.94,0:15:03.15,Default,,0,0,0,,1 орын?
Dialogue: 0,0:15:03.23,0:15:04.82,Default,,0,0,0,,Келесі! Бұл менің ағаларым!
Dialogue: 0,0:15:04.90,0:15:07.15,Default,,0,0,0,,2 орын – 16,950
Dialogue: 0,0:15:07.23,0:15:11.28,Default,,0,0,0,,Бұдан артық алмасам, аудандық турнирге бара алмаймын деген сөз бе?
Dialogue: 0,0:15:12.74,0:15:13.62,Default,,0,0,0,,Ұрыс
Dialogue: 0,0:15:13.70,0:15:14.62,Default,,0,0,0,,Көрінбейтін белгілері жоқ, біртіндеп өршіп бара жатқан ауру сияқты—
Dialogue: 0,0:15:14.70,0:15:15.91,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:15:16.87,0:15:17.70,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:15:17.79,0:15:19.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:21.92,0:15:23.75,Default,,0,0,0,,Ләззат алыңыз (Цукидате) Иә!
Dialogue: 0,0:15:23.83,0:15:24.67,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,0:15:24.75,0:15:26.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:26.71,0:15:28.55,Default,,0,0,0,,Барынша секір (Ватари) Хусс!
Dialogue: 0,0:15:28.63,0:15:30.38,Default,,0,0,0,,Ләззат алыңыз (Мисато) Иә
Dialogue: 0,0:15:31.05,0:15:31.88,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:47.73,0:15:51.90,Default,,0,0,0,,Сеніммен секіріңіз және өзіңізді қалай сезінесіз.
Dialogue: 0,0:15:52.74,0:15:53.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:53.82,0:15:55.24,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:56.24,0:15:59.12,Default,,0,0,0,,Себебі сенде талант бар.
Dialogue: 0,0:15:59.20,0:16:00.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:01.50,0:16:03.12,Default,,0,0,0,,Дарындылық?
Dialogue: 0,0:16:03.62,0:16:05.42,Default,,0,0,0,,Сіз байқамадыңыз ба?
Dialogue: 0,0:16:06.17,0:16:07.75,Default,,0,0,0,,Сіздің адалдығыңыз
Dialogue: 0,0:16:07.84,0:16:08.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:10.34,0:16:11.17,Default,,0,0,0,,Бұл қазірдің өзінде...
Dialogue: 0,0:16:12.38,0:16:14.51,Default,,0,0,0,,Бұл керемет талант.
Dialogue: 0,0:16:19.43,0:16:20.93,Default,,0,0,0,,Кернеуден рахат алыңыз
Dialogue: 0,0:16:23.02,0:16:24.69,Default,,0,0,0,,А... Иә!
Dialogue: 0,0:16:27.82,0:16:31.74,Default,,0,0,0,,No6 Сошуқан орта мектебі
Dialogue: 0,0:16:31.82,0:16:32.82,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:16:32.82,0:16:33.78,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:16:32.82,0:16:33.78,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:33.78,0:16:35.74,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:16:35.74,0:16:37.24,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:16:35.74,0:16:37.24,Default,,0,0,0,,(үшінның дем шығару дыбысы)
Dialogue: 0,0:16:48.09,0:16:51.13,Default,,0,0,0,,♪～
Dialogue: 0,0:17:40.43,0:17:43.68,Default,,0,0,0,,Көп ұзамай Шотаро-кун бұған жарамайды...
Dialogue: 0,0:17:43.77,0:17:44.60,Default,,0,0,0,,Иә
Dialogue: 0,0:17:50.48,0:17:52.15,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:17:55.57,0:17:56.40,Default,,0,0,0,,Осы рейдке қатысты—
Dialogue: 0,0:18:09.25,0:18:11.71,Default,,0,0,0,,Мисапон әлі де керемет
Dialogue: 0,0:18:11.79,0:18:12.88,Default,,0,0,0,,Хмм?
Dialogue: 0,0:18:19.01,0:18:20.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:33.61,0:18:34.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:41.51,0:19:46.51,Default,,0,0,0,,～♪
Dialogue: 0,0:19:49.85,0:19:52.52,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:19:52.60,0:19:55.27,Default,,0,0,0,,(үшін ауыр тыныс алады)
Dialogue: 0,0:20:03.91,0:20:05.07,Default,,0,0,0,,Футаба
Dialogue: 0,0:20:05.57,0:20:06.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:06.70,0:20:09.41,Default,,0,0,0,,Шотаро жақсы болды
Dialogue: 0,0:20:09.49,0:20:10.54,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:20:11.12,0:20:11.96,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:13.79,0:20:14.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:14.88,0:20:19.80,Default,,0,0,0,,(үшін ауыр тыныс алады)
Dialogue: 0,0:20:22.67,0:20:24.55,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:20:24.64,0:20:25.55,Default,,0,0,0,,Пи!
Dialogue: 0,0:20:25.64,0:20:26.93,Default,,0,0,0,,2 орын...
Dialogue: 0,0:20:27.01,0:20:28.10,Default,,0,0,0,,Екінші орын!
Dialogue: 0,0:20:28.18,0:20:29.72,Default,,0,0,0,,Префектуралық турнирден өту!
Dialogue: 0,0:20:29.81,0:20:31.73,Default,,0,0,0,,Облыстық турнирге қатысады! (Йошитака) Иә, иә
Dialogue: 0,0:20:32.43,0:20:33.98,Default,,0,0,0,,Демек, ойлағанымдай…
Dialogue: 0,0:20:34.06,0:20:37.36,Default,,0,0,0,,Егер Онагава-кунның қателігі болмаса, бірінші орынды жеңіп алуымыз мүмкін еді.
Dialogue: 0,0:20:38.40,0:20:40.57,Default,,0,0,0,,Сізде үлкен хит болды ма?
Dialogue: 0,0:20:40.65,0:20:42.61,Default,,0,0,0,,Шотаро...
Dialogue: 0,0:20:42.69,0:20:44.07,Default,,0,0,0,,Футаба...
Dialogue: 0,0:20:44.15,0:20:44.70,Default,,0,0,0,,(Шичигахама мен оның достарының қуанышты дауыстары)
Dialogue: 0,0:20:44.70,0:20:46.16,Default,,0,0,0,,(Шичихама мен оның достарының қуанышты дауыстары)
Dialogue: 0,0:20:44.70,0:20:46.16,Default,,0,0,0,,Шотаро
Dialogue: 0,0:20:46.24,0:20:47.07,Default,,0,0,0,,Жарайсыңдар
Dialogue: 0,0:20:47.16,0:20:48.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:50.99,0:20:51.83,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:20:51.91,0:20:53.71,Default,,0,0,0,,үшін жақсы болды.
Dialogue: 0,0:20:53.79,0:20:55.33,Default,,0,0,0,,Осылайша әлем бейбітшілік кейпін сақтайды
Dialogue: 0,0:20:55.42,0:20:57.92,Default,,0,0,0,,Иә, сен мені жылатып тұрсың ба (Курикома)?
Dialogue: 0,0:20:58.00,0:20:59.13,Default,,0,0,0,,Бұл сызық! (Онагава) Ух...
Dialogue: 0,0:20:59.21,0:21:00.71,Default,,0,0,0,,Егер сіз қателессеңіз не істейсіз?
Dialogue: 0,0:21:00.80,0:21:02.21,Default,,0,0,0,,Тәжірибе жеткіліксіз! Көбірек жаттығыңыз!
Dialogue: 0,0:21:02.30,0:21:03.47,Default,,0,0,0,,Зу... Зуминай!
Dialogue: 0,0:21:03.55,0:21:04.63,Default,,0,0,0,,Сол жалған жылы жүзді жігіт! Ол шынымен де мұны салқын жүзбен айтты!
Dialogue: 0,0:21:04.72,0:21:06.30,Default,,0,0,0,,Не? Тағы да жылайсың ба?
Dialogue: 0,0:21:06.39,0:21:08.60,Default,,0,0,0,,Эхехе... Иә?
Dialogue: 0,0:21:15.19,0:21:16.10,Default,,0,0,0,,Иә
Dialogue: 0,0:21:17.81,0:21:19.61,Default,,0,0,0,,Ах! Хехе...
Dialogue: 0,0:21:20.65,0:21:24.53,Default,,0,0,0,,Біз секіруді жалғастыра аламыз!
Dialogue: 0,0:21:26.11,0:21:31.12,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.99,0:22:55.99,Default,,0,0,0,,～♪
Dialogue: 0,0:22:57.49,0:23:03.49,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
