Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.34,0:00:10.46,Default,,0,0,0,,Менің бұрынғы қойылымым осылай болды
Dialogue: 0,0:00:14.22,0:00:16.51,Default,,0,0,0,,Жаңа актерлік ойын осылай
Dialogue: 0,0:00:18.01,0:00:21.14,Default,,0,0,0,,Бұл Шотаро мен оның тобының грэпплинг техникасы ғана емес.
Dialogue: 0,0:00:21.22,0:00:23.56,Default,,0,0,0,,1-ші ыдыстан 3-ші ыдысқа дейін
Dialogue: 0,0:00:23.64,0:00:25.23,Default,,0,0,0,,Кейбір техникалар өзгертілді
Dialogue: 0,0:00:25.31,0:00:28.61,Default,,0,0,0,,Жалпы қиындық деңгейі артты.
Dialogue: 0,0:00:28.69,0:00:31.11,Default,,0,0,0,,Грепплинг техникасы, әсіресе Мисато-кун...
Dialogue: 0,0:00:31.19,0:00:32.69,Default,,0,0,0,,Артқа секіру
Dialogue: 0,0:00:32.78,0:00:36.03,Default,,0,0,0,,Қазір біз іргетаспен синхронды болуымыз керек.
Dialogue: 0,0:00:36.11,0:00:39.74,Default,,0,0,0,,Өйткені бұл сенім мен жан тыныштығы
Dialogue: 0,0:00:44.08,0:00:44.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:46.50,0:00:48.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:48.38,0:00:49.79,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:00:51.05,0:00:51.96,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:54.01,0:00:55.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:56.26,0:00:59.22,Default,,0,0,0,,Иә~ Сіз мені елемейсіз бе~
Dialogue: 0,0:00:59.30,0:01:01.39,Default,,0,0,0,,Мисато мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:01:01.47,0:01:03.22,Default,,0,0,0,,Шикато жоқ
Dialogue: 0,0:01:03.31,0:01:04.06,Default,,0,0,0,,Мен бұл азап екенін білемін, бірақ менімен айналысыңыз.
Dialogue: 0,0:01:04.06,0:01:05.60,Default,,0,0,0,,Мен бұл азап екенін білемін, бірақ менімен айналысыңыз.
Dialogue: 0,0:01:04.06,0:01:05.60,Default,,0,0,0,,Бірақ~
Dialogue: 0,0:01:05.60,0:01:06.56,Default,,0,0,0,,Мен бұл азап екенін білемін, бірақ менімен айналысыңыз.
Dialogue: 0,0:01:06.64,0:01:07.90,Default,,0,0,0,,Мұны мен үшін жасаңыз
Dialogue: 0,0:01:07.98,0:01:09.81,Default,,0,0,0,,Не? Аа, кешіріңіз
Dialogue: 0,0:01:09.90,0:01:10.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:10.94,0:01:12.98,Default,,0,0,0,,Ал, енді бірден бастайық.
Dialogue: 0,0:01:13.07,0:01:14.28,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:01:15.99,0:01:20.99,Default,,0,0,0,,♪～
Dialogue: 0,0:02:40.95,0:02:45.95,Default,,0,0,0,,～♪
Dialogue: 0,0:02:46.83,0:02:49.33,Default,,0,0,0,,Енді грэпплинг жасап көрейік
Dialogue: 0,0:02:49.41,0:02:50.46,Default,,0,0,0,,Иә
Dialogue: 0,0:02:59.42,0:03:01.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:02.47,0:03:04.55,Default,,0,0,0,,(терең тыныс алу дыбысы)
Dialogue: 0,0:03:04.64,0:03:05.85,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:08.02,0:03:08.89,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:08.98,0:03:10.06,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:11.14,0:03:12.19,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:13.98,0:03:15.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:18.11,0:03:19.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:20.40,0:03:21.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:27.29,0:03:29.00,Default,,0,0,0,,Не болды, Мисато?
Dialogue: 0,0:03:29.62,0:03:32.83,Default,,0,0,0,,Кешіріңіз, уақыт дұрыс болмады.
Dialogue: 0,0:03:32.92,0:03:34.25,Default,,0,0,0,,Қайталап көріңіз.
Dialogue: 0,0:03:34.33,0:03:35.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:40.80,0:03:42.22,Default,,0,0,0,,А... (3 адам) А?
Dialogue: 0,0:03:53.10,0:03:54.69,Default,,0,0,0,,Иә! (3 адам) Әй!
Dialogue: 0,0:03:56.02,0:03:57.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:57.48,0:03:58.57,Default,,0,0,0,,Ах... (3 адам) А...
Dialogue: 0,0:03:58.65,0:04:00.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:04.49,0:04:06.16,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:06.24,0:04:08.83,Default,,0,0,0,,Не болды? Өзіңізді жақсы сезінбейсіз бе?
Dialogue: 0,0:04:08.91,0:04:11.66,Default,,0,0,0,,Жоқ, қайталап көріңіз.
Dialogue: 0,0:04:12.29,0:04:14.50,Default,,0,0,0,,Жоқ, сәл демалайық.
Dialogue: 0,0:04:14.58,0:04:16.58,Default,,0,0,0,,Маған қайталап көрейін
Dialogue: 0,0:04:17.13,0:04:20.42,Default,,0,0,0,,Әлі уақыт бар, асықпа.
Dialogue: 0,0:04:20.51,0:04:21.34,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:21.42,0:04:23.01,Default,,0,0,0,,Мен жарақат алсам не істеуім керек?
Dialogue: 0,0:04:23.09,0:04:24.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:26.01,0:04:27.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:28.85,0:04:29.97,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:31.39,0:04:32.31,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:32.31,0:04:33.31,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:32.31,0:04:33.31,Default,,0,0,0,,(ыстық судың дыбысы)
Dialogue: 0,0:04:35.60,0:04:36.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:36.81,0:04:38.69,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:04:38.77,0:04:40.65,Default,,0,0,0,,Менің эйсем
Dialogue: 0,0:04:40.73,0:04:43.15,Default,,0,0,0,,Сіз бір нәрседен қорқасыз.
Dialogue: 0,0:04:43.24,0:04:44.36,Default,,0,0,0,,Жалпы алғанда, сол хабар тарату мұнарасынан өткеннен кейін сигнал әдетте жақсы болады
Dialogue: 0,0:04:44.45,0:04:47.28,Default,,0,0,0,,Мен мұндайды ешқашан бастан өткерген емеспін.
Dialogue: 0,0:04:47.99,0:04:48.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:06.59,0:05:07.64,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:11.35,0:05:12.18,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:12.27,0:05:13.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:14.89,0:05:15.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:16.52,0:05:17.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:20.86,0:05:22.36,Default,,0,0,0,,Иә! (Мисато) Ух...
Dialogue: 0,0:05:24.15,0:05:25.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:25.40,0:05:26.99,Default,,0,0,0,,Иә? (Шичигахама) Хмм...
Dialogue: 0,0:05:27.07,0:05:28.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:30.78,0:05:31.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:33.75,0:05:34.75,Default,,0,0,0,,Я...
Dialogue: 0,0:05:39.04,0:05:39.88,Default,,0,0,0,,Мисато
Dialogue: 0,0:05:40.67,0:05:44.88,Default,,0,0,0,,Менің ойымша, сіз бізге, іргетасқа сенбейсіз.
Dialogue: 0,0:05:44.96,0:05:47.13,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:05:47.22,0:05:49.09,Default,,0,0,0,,Сәлем Ватари
Dialogue: 0,0:05:49.18,0:05:51.89,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:05:53.22,0:05:54.64,Default,,0,0,0,,Мұның бәрі таңғы жаттығуға арналған
Dialogue: 0,0:05:54.72,0:05:56.93,Default,,0,0,0,,Сабақтан кейін жалғастырайық.
Dialogue: 0,0:05:57.02,0:05:58.02,Default,,0,0,0,,Иә
Dialogue: 0,0:05:58.10,0:05:59.15,Default,,0,0,0,,Иә (Ватари) Уссу
Dialogue: 0,0:06:00.02,0:06:01.31,Default,,0,0,0,,Мисато-кун!
Dialogue: 0,0:06:03.48,0:06:04.57,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:04.65,0:06:05.94,Default,,0,0,0,,Мен көмектесе алмаймын
Dialogue: 0,0:06:06.57,0:06:07.95,Default,,0,0,0,,Өзіңді жақсы сезінбесе де... (Мисато) Жаман емес.
Dialogue: 0,0:06:08.03,0:06:09.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:19.25,0:06:20.58,Default,,0,0,0,,Мисато жоқ па?
Dialogue: 0,0:06:20.67,0:06:21.83,Default,,0,0,0,,Иә
Dialogue: 0,0:06:21.92,0:06:24.88,Default,,0,0,0,,Ол сыныпта немесе еш жерде емес.
Dialogue: 0,0:06:24.96,0:06:25.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:26.01,0:06:26.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:26.92,0:06:28.84,Default,,0,0,0,,А-а-а-а...
Dialogue: 0,0:06:29.76,0:06:30.59,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:06:30.68,0:06:32.10,Default,,0,0,0,,(раменнің шырылдаған дыбысы)
Dialogue: 0,0:06:33.43,0:06:34.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:35.77,0:06:38.68,Default,,0,0,0,,Рё Чан, не болды?
Dialogue: 0,0:06:42.69,0:06:43.69,Default,,0,0,0,,Мисато-кун
Dialogue: 0,0:06:45.02,0:06:47.32,Default,,0,0,0,,Ол бүгін сабаққа келмейтінін айтты.
Dialogue: 0,0:06:47.40,0:06:49.15,Default,,0,0,0,,Жақсы, аа, жақсы... (Цукидате) Хмм...
Dialogue: 0,0:06:49.24,0:06:51.49,Default,,0,0,0,,Мен кеше тым көп айттым ба?
Dialogue: 0,0:06:52.07,0:06:53.45,Default,,0,0,0,,Иә... (Онагава) Бірақ...
Dialogue: 0,0:06:53.53,0:06:57.12,Default,,0,0,0,,Сіз грэпплингпен айналыса алмағандықтан сабақты жібересіз бе?
Dialogue: 0,0:06:57.20,0:06:58.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:59.46,0:07:01.58,Default,,0,0,0,,Мен Мисатоның үйіне барамын.
Dialogue: 0,0:07:01.67,0:07:03.08,Default,,0,0,0,,Сосын мен де
Dialogue: 0,0:07:03.17,0:07:04.13,Default,,0,0,0,,Жоқ (Шичихама) Иә?
Dialogue: 0,0:07:05.13,0:07:07.13,Default,,0,0,0,,Футаба-кун, бірге барайық.
Dialogue: 0,0:07:07.21,0:07:08.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:09.09,0:07:12.01,Default,,0,0,0,,Мисато-кунмен сөйлескіңіз келмей ме?
Dialogue: 0,0:07:12.09,0:07:14.60,Default,,0,0,0,,А... иә!
Dialogue: 0,0:07:22.56,0:07:24.11,Default,,0,0,0,,Хирозе?
Dialogue: 0,0:07:26.69,0:07:28.15,Default,,0,0,0,,Мен алыстамын деп ойлаймын.
Dialogue: 0,0:07:28.23,0:07:29.53,Default,,0,0,0,,Ум... (Футаба/Шида) Иә?
Dialogue: 0,0:07:30.11,0:07:31.78,Default,,0,0,0,,Маған үйде бірдеңе керек...
Dialogue: 0,0:07:33.45,0:07:34.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:34.87,0:07:35.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:36.37,0:07:40.66,Default,,0,0,0,,Хмм, мен оны бір жерден көргендей болдым...
Dialogue: 0,0:07:41.25,0:07:42.75,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:07:42.83,0:07:44.42,Default,,0,0,0,,Мм... (Сакико) Иә?
Dialogue: 0,0:07:44.50,0:07:47.84,Default,,0,0,0,,Мен Ао орта мектебінің ерлер көркем гимнастика үйірмесінің жаттықтырушысымын...
Dialogue: 0,0:07:47.92,0:07:50.47,Default,,0,0,0,,Ах! Директор Шида!
Dialogue: 0,0:07:50.55,0:07:53.01,Default,,0,0,0,,Рё Чан маған үнемі қамқорлық жасайды.
Dialogue: 0,0:07:53.09,0:07:53.93,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:55.39,0:07:58.85,Default,,0,0,0,,Бұл менің тәтем Сакико Хиросе. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:08:00.10,0:08:01.73,Default,,0,0,0,,Апай?
Dialogue: 0,0:08:02.85,0:08:06.02,Default,,0,0,0,,Иә? Мен қай жерде деп ойлаймын
Dialogue: 0,0:08:06.11,0:08:07.98,Default,,0,0,0,,Сәл күтіңіз.
Dialogue: 0,0:08:09.03,0:08:10.49,Default,,0,0,0,,Шай…
Dialogue: 0,0:08:10.57,0:08:12.74,Default,,0,0,0,,Шай...
Dialogue: 0,0:08:12.82,0:08:14.41,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:08:15.49,0:08:16.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:16.41,0:08:19.58,Default,,0,0,0,,Үй жұмысын орындауда өте нашармын.
Dialogue: 0,0:08:19.66,0:08:20.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:21.04,0:08:24.25,Default,,0,0,0,,Ерлердің көркем гимнастикасында топтық жұмыстың маңызы зор.
Dialogue: 0,0:08:24.87,0:08:26.71,Default,,0,0,0,,Мен жатақханада тұрамын...
Dialogue: 0,0:08:27.29,0:08:29.92,Default,,0,0,0,,Мен түнде үйге баруым керек.
Dialogue: 0,0:08:30.92,0:08:31.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:31.84,0:08:32.67,Default,,0,0,0,,Кеше де...
Dialogue: 0,0:08:32.76,0:08:34.18,Default,,0,0,0,,Қайтып келген бойда
Dialogue: 0,0:08:34.26,0:08:37.64,Default,,0,0,0,,«Сен менсіз ештеңе істей алмайсың».
Dialogue: 0,0:08:37.72,0:08:38.85,Default,,0,0,0,,Бұл ұқсас емес пе?
Dialogue: 0,0:08:38.93,0:08:40.60,Default,,0,0,0,,А, мінеки!
Dialogue: 0,0:08:47.65,0:08:48.52,Default,,0,0,0,,Рё-чан
Dialogue: 0,0:08:48.61,0:08:51.28,Default,,0,0,0,,Клуб іс-шараларында бірдеңе болды ма?
Dialogue: 0,0:08:52.19,0:08:54.28,Default,,0,0,0,,Бұл үлкен мәселе емес, бірақ...
Dialogue: 0,0:08:55.82,0:08:57.53,Default,,0,0,0,,Грэпплинг техникасы... (Сакико) Иә?
Dialogue: 0,0:08:57.62,0:08:58.91,Default,,0,0,0,,А... қазір-
Dialogue: 0,0:08:58.99,0:09:02.45,Default,,0,0,0,,Ол менімен күресіп жатты.
Dialogue: 0,0:09:02.54,0:09:04.41,Default,,0,0,0,,Бұл орындалмады
Dialogue: 0,0:09:04.50,0:09:06.54,Default,,0,0,0,,Грамография…
Dialogue: 0,0:09:06.62,0:09:07.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:07.96,0:09:10.25,Default,,0,0,0,,Сіздің ойыңыз бар ма?
Dialogue: 0,0:09:10.75,0:09:14.13,Default,,0,0,0,,Кіші орта мектепте...Менің ойымша, бұл екінші курста болды.
Dialogue: 0,0:09:14.22,0:09:15.68,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:15.76,0:09:17.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:17.26,0:09:19.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:21.60,0:09:24.68,Default,,0,0,0,,Сонда сіз күресуге шебер емессіз бе?
Dialogue: 0,0:09:24.77,0:09:26.73,Default,,0,0,0,,Бірақ осы уақытқа дейін...
Dialogue: 0,0:09:26.81,0:09:28.90,Default,,0,0,0,,Бұл жолы өзгертілген әдістер
Dialogue: 0,0:09:28.98,0:09:32.19,Default,,0,0,0,,Мен секіру уақытын достарыма қалдырамын.
Dialogue: 0,0:09:32.28,0:09:33.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:34.74,0:09:36.24,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:36.32,0:09:38.45,Default,,0,0,0,,Әлі де солай.
Dialogue: 0,0:09:48.29,0:09:50.29,Default,,0,0,0,,Рё Чанның анасы
Dialogue: 0,0:09:50.38,0:09:53.00,Default,,0,0,0,,Ол менің әпкем.
Dialogue: 0,0:09:53.92,0:09:55.88,Default,,0,0,0,,Сол баланың ата-анасы...
Dialogue: 0,0:10:10.31,0:10:13.19,Default,,0,0,0,,Менің кіші мектептегі үйірме мұғалімім де осылай деді.
Dialogue: 0,0:10:13.27,0:10:15.78,Default,,0,0,0,,Еңбекқор, достарына қамқорлық жасайды.
Dialogue: 0,0:10:16.49,0:10:19.66,Default,,0,0,0,,Біз бен бәріміздің арамызда алшақтық бар
Dialogue: 0,0:10:19.74,0:10:20.99,Default,,0,0,0,,Қашықтық?
Dialogue: 0,0:10:21.07,0:10:22.16,Default,,0,0,0,,Иә
Dialogue: 0,0:10:22.24,0:10:25.83,Default,,0,0,0,,Кішкентай кезімнен өзіме қарау керек болды.
Dialogue: 0,0:10:25.91,0:10:28.21,Default,,0,0,0,,Менің бір бөлігім солай деп есептейді
Dialogue: 0,0:10:28.29,0:10:32.46,Default,,0,0,0,,Мені алаңдатпау керек екеніне сенімдімін.
Dialogue: 0,0:10:32.54,0:10:34.50,Default,,0,0,0,,Достарыңыз туралы
Dialogue: 0,0:10:34.59,0:10:37.13,Default,,0,0,0,,Мен бұған сенбеймін деген сөз емес.
Dialogue: 0,0:10:37.84,0:10:41.14,Default,,0,0,0,,Мен саған шын жүректен сене алмаймын...
Dialogue: 0,0:10:41.80,0:10:42.85,Default,,0,0,0,,Жалғыз -
Dialogue: 0,0:10:42.93,0:10:46.31,Default,,0,0,0,,Мен өзімді күшті болуым керек деп санайсыз ба?
Dialogue: 0,0:10:51.44,0:10:52.61,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:55.15,0:10:56.61,Default,,0,0,0,,Ақыр соңында, бір жерде... (Шида) А?
Dialogue: 0,0:10:57.65,0:10:58.65,Default,,0,0,0,,Ммм
Dialogue: 0,0:10:59.24,0:11:00.28,Default,,0,0,0,,Ах! (Футаба) А?
Dialogue: 0,0:11:00.36,0:11:01.61,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:11:02.87,0:11:04.49,Default,,0,0,0,,Алдымен, қазіргі жағдайды ескерсек—
Dialogue: 0,0:11:06.70,0:11:09.00,Default,,0,0,0,,Қорқынышты! Сен кімсің?
Dialogue: 0,0:11:09.08,0:11:11.42,Default,,0,0,0,,Оның көзі нашар көреді.
Dialogue: 0,0:11:11.50,0:11:15.13,Default,,0,0,0,,Бірақ мен оны бір жерден көргендей сезінемін...
Dialogue: 0,0:11:16.88,0:11:18.88,Default,,0,0,0,,Уф... бұл менмін.
Dialogue: 0,0:11:18.96,0:11:19.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:19.88,0:11:22.47,Default,,0,0,0,,Бұл мен жас кезімде... Ұялып тұрмын.
Dialogue: 0,0:11:22.55,0:11:24.43,Default,,0,0,0,,Иә! (Сакико) Күткендей!
Dialogue: 0,0:11:24.51,0:11:27.14,Default,,0,0,0,,Егер сіз біреуді әйтеуір танысаңыз
Dialogue: 0,0:11:27.22,0:11:31.06,Default,,0,0,0,,Бір кездері Рё Чанның көңілі түсіп кетті.
Dialogue: 0,0:11:31.64,0:11:34.73,Default,,0,0,0,,Бірақ мен ерлер көркем гимнастикасының видеосын таптым.
Dialogue: 0,0:11:34.81,0:11:36.40,Default,,0,0,0,,«Мен осы адам сияқты болғым келеді»
Dialogue: 0,0:11:36.48,0:11:39.94,Default,,0,0,0,,«Мен де салқын секіргім келеді» және бар күшімді саламын.
Dialogue: 0,0:11:43.57,0:11:47.66,Default,,0,0,0,,Сонымен, Мисато-кун Ао орта мектебіне келді ме?
Dialogue: 0,0:11:49.33,0:11:50.66,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:11:51.75,0:11:52.92,Default,,0,0,0,,Таңғажайып емес пе? Көз жеткен жердің бәрінде Ятоитерлер!
Dialogue: 0,0:11:53.54,0:11:55.17,Default,,0,0,0,,Мисато үйге келгенде
Dialogue: 0,0:11:55.25,0:11:57.34,Default,,0,0,0,,Иә, мен сізге жақын арада хабарласамын
Dialogue: 0,0:11:57.42,0:11:59.00,Default,,0,0,0,,Иә?Ах!
Dialogue: 0,0:11:59.59,0:12:00.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:01.84,0:12:04.09,Default,,0,0,0,,О, Рё Чан!
Dialogue: 0,0:12:04.59,0:12:06.47,Default,,0,0,0,,Директор Футаба...
Dialogue: 0,0:12:06.55,0:12:08.06,Default,,0,0,0,,Мисато-кун қош келдіңіз
Dialogue: 0,0:12:09.72,0:12:10.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:10.64,0:12:12.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:12.10,0:12:15.40,Default,,0,0,0,,Мен алдымен үйде боламын, сондықтан екеуің сөйлесіңдер.
Dialogue: 0,0:12:15.48,0:12:17.23,Default,,0,0,0,,А... иә!
Dialogue: 0,0:12:26.24,0:12:27.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:30.20,0:12:32.50,Default,,0,0,0,,Мисато-кун! (Мисато) Сен айтпасаң да түсінемін.
Dialogue: 0,0:12:32.58,0:12:33.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:34.08,0:12:35.58,Default,,0,0,0,,Менің кемшіліктерім
Dialogue: 0,0:12:37.21,0:12:39.34,Default,,0,0,0,,Әлеуметтену мүмкін емес
Dialogue: 0,0:12:39.84,0:12:43.05,Default,,0,0,0,,Бір-біріңе шын жүректен сенетіндей қарым-қатынас құра алмау
Dialogue: 0,0:12:46.51,0:12:47.89,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:47.97,0:12:49.68,Default,,0,0,0,,Мен кім екенімді сене алмаймын
Dialogue: 0,0:12:51.02,0:12:53.93,Default,,0,0,0,,Осыны жеңу үшін мен жатақханаға көштім.
Dialogue: 0,0:12:55.10,0:12:56.40,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:12:56.48,0:12:59.32,Default,,0,0,0,,Мен бүгін күні бойы осыны ойлап, шешім қабылдауға бел будым.
Dialogue: 0,0:13:00.19,0:13:01.03,Default,,0,0,0,,Футаба
Dialogue: 0,0:13:01.94,0:13:03.69,Default,,0,0,0,,Мен бәріне сенемін
Dialogue: 0,0:13:03.78,0:13:05.40,Default,,0,0,0,,Сену...
Dialogue: 0,0:13:05.49,0:13:08.16,Default,,0,0,0,,А, мен солай шештім.
Dialogue: 0,0:13:08.24,0:13:10.66,Default,,0,0,0,,Мен сізге және капитандарға көбірек сенемін.
Dialogue: 0,0:13:11.87,0:13:13.79,Default,,0,0,0,,Сондықтан енді уайымдамаңыз
Dialogue: 0,0:13:14.75,0:13:17.17,Default,,0,0,0,,Сонымен мен үйге бара жатырмын.
Dialogue: 0,0:13:19.50,0:13:22.05,Default,,0,0,0,,Ах! Менің ойымша, бұл басқа нәрсе!
Dialogue: 0,0:13:25.17,0:13:26.05,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:13:26.93,0:13:28.76,Default,,0,0,0,,Барлығына айт, мен саған сенемін
Dialogue: 0,0:13:28.84,0:13:32.47,Default,,0,0,0,,Өйткені, Мисато-кун, сен өз шешіміңді өзің қабылдайсың!
Dialogue: 0,0:13:33.85,0:13:38.10,Default,,0,0,0,,Бұл дұрыс емес, мен мүлде сенбеймін!
Dialogue: 0,0:13:38.19,0:13:39.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:41.61,0:13:42.65,Default,,0,0,0,,Я...
Dialogue: 0,0:13:43.86,0:13:46.45,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:13:46.53,0:13:49.95,Default,,0,0,0,,Не? Бұл...
Dialogue: 0,0:13:50.70,0:13:51.95,Default,,0,0,0,,Ммм
Dialogue: 0,0:13:52.62,0:13:53.62,Default,,0,0,0,,Фу…
Dialogue: 0,0:13:55.37,0:13:57.21,Default,,0,0,0,,А... мені бүлдірші?
Dialogue: 0,0:13:57.29,0:13:58.12,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:58.21,0:14:00.21,Default,,0,0,0,,Иә! Маған мейірімді бол!
Dialogue: 0,0:14:00.29,0:14:01.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:01.46,0:14:02.59,Default,,0,0,0,,Дос екенімізге сенімдімін
Dialogue: 0,0:14:02.67,0:14:05.80,Default,,0,0,0,,Бір-бірімізге көбірек сүйеніп, көмектесуіміз керек деп ойлаймын.
Dialogue: 0,0:14:05.88,0:14:07.84,Default,,0,0,0,,Ендеше қызық болайық!
Dialogue: 0,0:14:08.84,0:14:11.22,Default,,0,0,0,,Әй, еркелеу деген осындай...
Dialogue: 0,0:14:11.30,0:14:13.35,Default,,0,0,0,,Мен өзіме ғана сене алмайтын шығармын, бірақ
Dialogue: 0,0:14:13.43,0:14:16.35,Default,,0,0,0,,Менің үлкендерімнің де жетекшілері бар.
Dialogue: 0,0:14:17.10,0:14:19.52,Default,,0,0,0,,Жарайды, үйге барып еркелетейік!
Dialogue: 0,0:14:19.60,0:14:21.61,Default,,0,0,0,,Жоқ, бұзылайық.
Dialogue: 0,0:14:21.69,0:14:23.32,Default,,0,0,0,,Олай болса, тезірек үйге қайтайық!
Dialogue: 0,0:14:23.40,0:14:26.11,Default,,0,0,0,,Уау! Бір минут күте тұрыңыз, Футаба
Dialogue: 0,0:14:29.49,0:14:30.70,Default,,0,0,0,,Мазалағаныңызға рахмет.
Dialogue: 0,0:14:30.78,0:14:32.62,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:14:36.91,0:14:39.58,Default,,0,0,0,,Мен... Мен...
Dialogue: 0,0:14:39.67,0:14:42.21,Default,,0,0,0,,Ештеңе етпейді, сөйлесуге өзіңізді мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:14:43.29,0:14:46.71,Default,,0,0,0,,Әр адамның біреуге айта алатын бір-екі сөзі бар.
Dialogue: 0,0:14:46.80,0:14:48.55,Default,,0,0,0,,Мен капитан жоқ деп ойлаймын.
Dialogue: 0,0:14:48.63,0:14:49.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:49.55,0:14:51.55,Default,,0,0,0,,Адамдар Үзіліс алғың келетін кездер болады.
Dialogue: 0,0:14:51.64,0:14:52.47,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:52.55,0:14:55.43,Default,,0,0,0,,Кешіріңіз! Мен де көп айттым!
Dialogue: 0,0:14:56.14,0:14:58.60,Default,,0,0,0,,Жоқ, олай емес...
Dialogue: 0,0:14:58.68,0:15:01.52,Default,,0,0,0,,Әйтеуір, осы жерден қайта бастайық.
Dialogue: 0,0:15:01.60,0:15:02.69,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:15:06.57,0:15:08.49,Default,,0,0,0,,Иә (Футаба) Иә!
Dialogue: 0,0:15:09.19,0:15:10.03,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:15:12.28,0:15:14.16,Default,,0,0,0,,Еркелетіңіз!
Dialogue: 0,0:15:14.24,0:15:15.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:18.12,0:15:18.95,Default,,0,0,0,,Se...
Dialogue: 0,0:15:19.75,0:15:22.46,Default,,0,0,0,,Менің үлкендерге өтінішім бар.
Dialogue: 0,0:15:23.08,0:15:27.09,Default,,0,0,0,,Мен бұл техниканың сәтті болғанын қалаймын, сондықтан...
Dialogue: 0,0:15:28.21,0:15:29.21,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:15:29.97,0:15:32.72,Default,,0,0,0,,Оған дейін жаттығуды жалғастырыңыз!
Dialogue: 0,0:15:32.80,0:15:34.26,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:15:38.52,0:15:39.89,Default,,0,0,0,,Мисато
Dialogue: 0,0:15:39.98,0:15:42.35,Default,,0,0,0,,Эйстің өтініші және ол қайтып келгенде не болды.
Dialogue: 0,0:15:42.44,0:15:44.44,Default,,0,0,0,,Сұрамасқа амалым жоқ.
Dialogue: 0,0:15:44.52,0:15:46.36,Default,,0,0,0,,Қайтып келе жатқан эйс емес
Dialogue: 0,0:15:46.44,0:15:49.32,Default,,0,0,0,,Әй, соғып қалсаң, жаңғырық. Күшті.
Dialogue: 0,0:15:49.40,0:15:51.95,Default,,0,0,0,,Өз күшіңізбен секіруге тырыспаңыз.
Dialogue: 0,0:15:52.03,0:15:54.41,Default,,0,0,0,,Біз оның жақсы секіретініне көз жеткіземіз.
Dialogue: 0,0:15:54.49,0:15:56.87,Default,,0,0,0,,Дұрыс, топтық орындау.
Dialogue: 0,0:15:56.95,0:16:00.45,Default,,0,0,0,,Ақыр соңында, жүректен жүрекке командалық байланыс маңызды.
Dialogue: 0,0:16:00.54,0:16:02.54,Default,,0,0,0,,Әй, жақсы нәрсе айтасың.
Dialogue: 0,0:16:02.62,0:16:03.50,Default,,0,0,0,,Әрине
Dialogue: 0,0:16:03.58,0:16:05.63,Default,,0,0,0,,Сонымен! (Мисато/Футаба) Иә?
Dialogue: 0,0:16:06.54,0:16:07.38,Default,,0,0,0,,Тантан!
Dialogue: 0,0:16:07.92,0:16:08.80,Default,,0,0,0,,Сасакама!
Dialogue: 0,0:16:09.51,0:16:10.34,Default,,0,0,0,,Джинкио
Dialogue: 0,0:16:11.17,0:16:12.22,Default,,0,0,0,,Жасыл!
Dialogue: 0,0:16:15.05,0:16:16.39,Default,,0,0,0,,Тансасан Мидо
Dialogue: 0,0:16:16.47,0:16:19.22,Default,,0,0,0,,Тансасан Мидо Тансасан Мидо…
Dialogue: 0,0:16:20.35,0:16:22.06,Default,,0,0,0,,Мен білмей тұрып, мұндай техника...
Dialogue: 0,0:16:22.14,0:16:23.94,Default,,0,0,0,,Оның үстіне кемелдік дәрежесі таң қалдырады
Dialogue: 0,0:16:24.02,0:16:27.40,Default,,0,0,0,,Бұл Ао орта мектебінің ерлер көркем гимнастика үйірмесі!
Dialogue: 0,0:16:27.48,0:16:30.86,Default,,0,0,0,,Біздің де жүрегімізге кіріңіз!
Dialogue: 0,0:16:30.94,0:16:32.44,Default,,0,0,0,,Шотаро Мисато~!
Dialogue: 0,0:16:32.53,0:16:34.36,Default,,0,0,0,,Менің барғым келмейді.
Dialogue: 0,0:16:34.45,0:16:36.32,Default,,0,0,0,,Мында барайық, Мисато-кун.
Dialogue: 0,0:16:36.41,0:16:38.33,Default,,0,0,0,,Осындай кезде мейірімді болу керек.
Dialogue: 0,0:16:39.49,0:16:41.41,Default,,0,0,0,,Жоқ, бұл басқаша.
Dialogue: 0,0:16:41.50,0:16:44.46,Default,,0,0,0,,Негізі маған да ұнамайды.
Dialogue: 0,0:16:44.54,0:16:45.12,Default,,0,0,0,,Мен сізді естідім, Шотаро!
Dialogue: 0,0:16:45.12,0:16:45.96,Default,,0,0,0,,Мен сізді естідім, Шотаро!
Dialogue: 0,0:16:45.12,0:16:45.96,Default,,0,0,0,,(Онагаваның ән айту дауысы)
Dialogue: 0,0:16:45.96,0:16:46.04,Default,,0,0,0,,(Онагаваның ән айту дауысы)
Dialogue: 0,0:16:46.04,0:16:48.42,Default,,0,0,0,,(Онагаваның ән айту дауысы)
Dialogue: 0,0:16:46.04,0:16:48.42,Default,,0,0,0,,Сәлем! Не айтқың келеді! (Футаба) Ой, кешіріңіз!
Dialogue: 0,0:16:48.42,0:16:48.50,Default,,0,0,0,,(Онагаваның ән айту дауысы)
Dialogue: 0,0:16:48.50,0:16:50.63,Default,,0,0,0,,(Онагаваның ән айту дауысы)
Dialogue: 0,0:16:48.50,0:16:50.63,Default,,0,0,0,,Негізі мен де сондаймын...
Dialogue: 0,0:16:50.63,0:16:50.71,Default,,0,0,0,,(Онагаваның ән айту дауысы)
Dialogue: 0,0:16:50.71,0:16:52.09,Default,,0,0,0,,(Онагаваның ән айту дауысы)
Dialogue: 0,0:16:50.71,0:16:52.09,Default,,0,0,0,,Жоқ! Цукидате: Сен маған опасыздық жасадың!
Dialogue: 0,0:16:52.09,0:16:53.09,Default,,0,0,0,,Жоқ! Цукидате: Сен маған опасыздық жасадың!
Dialogue: 0,0:16:53.17,0:16:55.47,Default,,0,0,0,,(Шичигахама мен басқалар арасындағы жанжал)
Dialogue: 0,0:16:58.85,0:17:00.18,Default,,0,0,0,,Я...
Dialogue: 0,0:17:00.81,0:17:03.52,Default,,0,0,0,,Сергіту болды~
Dialogue: 0,0:17:19.20,0:17:20.20,Default,,0,0,0,,Шотаро
Dialogue: 0,0:17:20.28,0:17:21.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:22.41,0:17:23.54,Default,,0,0,0,,Не?
Dialogue: 0,0:17:24.96,0:17:28.29,Default,,0,0,0,,Мен мектепті бітірген соң жұмыс істеуді жоспарлап отырмын.
Dialogue: 0,0:17:28.38,0:17:29.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:29.50,0:17:30.34,Default,,0,0,0,,Менің тәтем
Dialogue: 0,0:17:30.42,0:17:33.38,Default,,0,0,0,,Ол алаңдайтын ештеңе жоқ дейді, бірақ...
Dialogue: 0,0:17:33.46,0:17:37.76,Default,,0,0,0,,Өйткені, университетке түсу қиыншылық тудыратын шығар...
Dialogue: 0,0:17:38.80,0:17:39.85,Default,,0,0,0,,Сонымен
Dialogue: 0,0:17:40.47,0:17:42.56,Default,,0,0,0,,Көркем гимнастикамен айналысамын
Dialogue: 0,0:17:42.64,0:17:45.02,Default,,0,0,0,,Үш жылдық мектепті бітірген соң бітті.
Dialogue: 0,0:17:45.68,0:17:48.10,Default,,0,0,0,,Менде осы үш жыл ғана бар.
Dialogue: 0,0:17:48.73,0:17:51.90,Default,,0,0,0,,Сондықтан мен басқа күнді өткізгім келмейді...
Dialogue: 0,0:17:51.98,0:17:56.53,Default,,0,0,0,,Мен бір сағатты да, минутты да, секундты да босқа өткізгім келмейді.
Dialogue: 0,0:17:56.61,0:17:58.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:59.07,0:18:00.91,Default,,0,0,0,,Иә, мен де.
Dialogue: 0,0:18:00.99,0:18:02.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:03.24,0:18:06.96,Default,,0,0,0,,Мисатомен үш жыл бойы секіруді жалғастыру
Dialogue: 0,0:18:07.04,0:18:08.50,Default,,0,0,0,,Ең алдымен, Интерхай
Dialogue: 0,0:18:08.58,0:18:11.09,Default,,0,0,0,,Міндетті түрде бірге барайық!
Dialogue: 0,0:18:11.79,0:18:12.80,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:14.59,0:18:15.46,Default,,0,0,0,,О
Dialogue: 0,0:18:21.72,0:18:25.56,Default,,0,0,0,,Шотароны Мисатоның үйіне не үшін әкелдің?
Dialogue: 0,0:18:26.14,0:18:27.64,Default,,0,0,0,,Шичигахама жігіттері-
Dialogue: 0,0:18:28.23,0:18:30.77,Default,,0,0,0,,Биылғы турнир аяқталғаннан кейін мен зейнетке шығамын.
Dialogue: 0,0:18:31.27,0:18:32.56,Default,,0,0,0,,Ватари-кун мен Аса-чан да-
Dialogue: 0,0:18:32.65,0:18:34.98,Default,,0,0,0,,Келесі жылы жойылады
Dialogue: 0,0:18:35.61,0:18:36.57,Default,,0,0,0,,Бұл кезде-
Dialogue: 0,0:18:37.36,0:18:40.53,Default,,0,0,0,,Ао орта мектебінің ұлдарының көркем гимнастика клубын құру
Dialogue: 0,0:18:40.61,0:18:43.08,Default,,0,0,0,,Бұл Футаба-кун мен Мисато-кун.
Dialogue: 0,0:18:57.13,0:18:58.09,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:01.72,0:19:02.68,Default,,0,0,0,,Иә! (3 адам) Әй!
Dialogue: 0,0:19:03.93,0:19:04.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:06.47,0:19:07.31,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:19:07.39,0:19:09.56,Default,,0,0,0,,Ах... Эй, қазір...
Dialogue: 0,0:19:09.64,0:19:11.44,Default,,0,0,0,,Мисато дауысын көтерді ме?
Dialogue: 0,0:19:11.52,0:19:13.69,Default,,0,0,0,,Тағы да рахмет!
Dialogue: 0,0:19:15.23,0:19:19.03,Default,,0,0,0,,Мисато бірінші рет осыншама эмоция көрсетті.
Dialogue: 0,0:19:20.49,0:19:21.36,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:22.66,0:19:23.49,Default,,0,0,0,,Я...
Dialogue: 0,0:19:23.57,0:19:25.45,Default,,0,0,0,,Мисато-кун (Мисато) Иә?
Dialogue: 0,0:19:26.03,0:19:28.83,Default,,0,0,0,,Бұрын мен жалғыз секіретінмін.
Dialogue: 0,0:19:28.91,0:19:30.62,Default,,0,0,0,,Топ болса да...
Dialogue: 0,0:19:31.25,0:19:33.83,Default,,0,0,0,,Ешкімге сенбе, жалғыз секір...
Dialogue: 0,0:19:34.59,0:19:35.96,Default,,0,0,0,,Нәтиже-
Dialogue: 0,0:19:36.04,0:19:38.96,Default,,0,0,0,,Мен өзімді және командамды жойдым.
Dialogue: 0,0:19:40.34,0:19:42.59,Default,,0,0,0,,Бірақ сіз басқасыз.
Dialogue: 0,0:19:43.55,0:19:45.72,Default,,0,0,0,,Барлығымыз секіруді таңдадық.
Dialogue: 0,0:19:45.80,0:19:48.35,Default,,0,0,0,,Әркім сенімен бірге секіруді таңдайды.
Dialogue: 0,0:19:49.06,0:19:52.60,Default,,0,0,0,,Мұндағылардың барлығы секіргісі келеді.
Dialogue: 0,0:19:57.98,0:20:00.57,Default,,0,0,0,,Менен асып кеттің.
Dialogue: 0,0:20:01.20,0:20:02.49,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:02.57,0:20:03.86,Default,,0,0,0,,Сенің қолыңнан келетініне сенімдімін
Dialogue: 0,0:20:05.12,0:20:06.24,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:06.33,0:20:08.87,Default,,0,0,0,,(терең тыныс алу дыбысы)
Dialogue: 0,0:20:24.76,0:20:25.59,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:35.85,0:20:37.02,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:38.44,0:20:39.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:48.91,0:20:49.99,Default,,0,0,0,,Жарайсыңдар! (Цукидате) Жарайды!
Dialogue: 0,0:20:50.08,0:20:51.25,Default,,0,0,0,,Мисато-кун!
Dialogue: 0,0:20:51.33,0:20:52.66,Default,,0,0,0,,Өйткені, сен мұны істейсің.
Dialogue: 0,0:20:52.75,0:20:55.58,Default,,0,0,0,,«Жаңғыруға адал жапырақ» Эйс
Dialogue: 0,0:20:59.63,0:21:01.09,Default,,0,0,0,,Қадағалау! (Шида) Ах!
Dialogue: 0,0:21:02.92,0:21:04.63,Default,,0,0,0,,Сонда да мен...
Dialogue: 0,0:21:06.01,0:21:09.35,Default,,0,0,0,,Режиссердің кері қимылын жақсы көремін!
Dialogue: 0,0:21:10.01,0:21:10.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:12.10,0:21:13.73,Default,,0,0,0,,А... хаха...
Dialogue: 0,0:21:14.52,0:21:17.73,Default,,0,0,0,,Мисато мен сенің ағаларың бірге болса...
Dialogue: 0,0:21:18.69,0:21:20.27,Default,,0,0,0,,Секіруге болатынына сенімдімін
Dialogue: 0,0:21:20.94,0:21:22.94,Default,,0,0,0,,Жоғары!
Dialogue: 0,0:21:26.07,0:21:31.08,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.95,0:22:55.95,Default,,0,0,0,,～♪
