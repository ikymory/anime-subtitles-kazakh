Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:06.96,Default,,0,0,0,,Бар күшіммен (Шичигахама) Иә!
Dialogue: 0,0:00:06.96,0:00:07.75,Default,,0,0,0,,Бар күшіммен (Шичигахама) Иә!
Dialogue: 0,0:00:07.88,0:00:08.38,Default,,0,0,0,,Бар күшіммен (Цукидате) Иә!
Dialogue: 0,0:00:08.38,0:00:09.17,Default,,0,0,0,,Бар күшіммен (Цукидате) Иә!
Dialogue: 0,0:00:09.30,0:00:09.71,Default,,0,0,0,,Толығымен (Онагава) Иә!
Dialogue: 0,0:00:09.71,0:00:10.51,Default,,0,0,0,,Толығымен (Онагава) Иә!
Dialogue: 0,0:00:10.63,0:00:11.17,Default,,0,0,0,,Барынша қатты (Ватари) Уссу!
Dialogue: 0,0:00:11.17,0:00:11.97,Default,,0,0,0,,Қолымнан келгенше (Ватари) Усу!
Dialogue: 0,0:00:12.09,0:00:12.67,Default,,0,0,0,,Қолымнан келгенше (Мисато) Иә!
Dialogue: 0,0:00:12.67,0:00:13.55,Default,,0,0,0,,Қолымнан келгенше (Мисато) Иә!
Dialogue: 0,0:00:13.68,0:00:16.01,Default,,0,0,0,,Қолыңнан келгеннің бәрін жасап, одан толық ләззат ал (Футаба) Иә!
Dialogue: 0,0:00:19.31,0:00:23.18,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:00:25.35,0:00:27.77,Default,,0,0,0,,♪～
Dialogue: 0,0:01:09.31,0:01:10.48,Default,,0,0,0,,Жақсы бір мезгілде.
Dialogue: 0,0:01:10.61,0:01:12.19,Default,,0,0,0,,Секіру де жоғары.
Dialogue: 0,0:01:12.32,0:01:14.69,Default,,0,0,0,,Құрылымның өзгеру жылдамдығы да бар.
Dialogue: 0,0:01:39.39,0:01:41.76,Default,,0,0,0,,～♪
Dialogue: 0,0:01:44.31,0:01:47.31,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:01:47.44,0:01:50.44,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:01:50.56,0:01:53.57,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:01:53.69,0:01:56.69,Default,,0,0,0,,Хаха...
Dialogue: 0,0:01:56.82,0:01:59.82,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:01:59.95,0:02:03.20,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:02:03.33,0:02:09.71,Default,,0,0,0,,(6 адам ауыр тыныс алады)
Dialogue: 0,0:02:11.75,0:02:12.71,Default,,0,0,0,,Ооо!
Dialogue: 0,0:02:12.71,0:02:13.96,Default,,0,0,0,,Ооо!
Dialogue: 0,0:02:12.71,0:02:13.96,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:02:18.09,0:02:20.18,Default,,0,0,0,,Уау! (Сакико) 2 орын!
Dialogue: 0,0:02:20.93,0:02:21.76,Default,,0,0,0,,Әкем әдеттегідей драмалық болып жатыр—
Dialogue: 0,0:02:21.89,0:02:23.76,Default,,0,0,0,,Барлығы керемет болды (Аюми) Иә!
Dialogue: 0,0:02:23.89,0:02:25.93,Default,,0,0,0,,Екінші орын! әке ана
Dialogue: 0,0:02:26.06,0:02:26.85,Default,,0,0,0,,Сіз мұны істедіңіз!
Dialogue: 0,0:02:26.98,0:02:29.39,Default,,0,0,0,,Жоқ, жоқ, тағы 5 команда қалды.
Dialogue: 0,0:02:29.52,0:02:30.81,Default,,0,0,0,,Хайато
Dialogue: 0,0:02:30.94,0:02:31.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:31.90,0:02:33.65,Default,,0,0,0,,Жақсы, жақсы (Ватари) Біз!
Dialogue: 0,0:02:33.77,0:02:34.61,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:02:34.73,0:02:36.19,Default,,0,0,0,,Бұл жақсы қойылым болды (Мисато) Иә.
Dialogue: 0,0:02:36.32,0:02:37.11,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:02:37.24,0:02:38.70,Default,,0,0,0,,Ха ха ха... (Шида) Ах!
Dialogue: 0,0:02:38.82,0:02:41.61,Default,,0,0,0,,Хаха...
Dialogue: 0,0:02:42.66,0:02:43.70,Default,,0,0,0,,Ах... (Шида) Ах!
Dialogue: 0,0:02:47.87,0:02:48.71,Default,,0,0,0,,Біраз өсіп алғанша күтсеңші.
Dialogue: 0,0:02:48.83,0:02:50.71,Default,,0,0,0,,Шотаро! (Онагава) Жақсысың ба?
Dialogue: 0,0:02:50.83,0:02:51.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:51.92,0:02:54.92,Default,,0,0,0,,Мен қайтадан №1 бола алмадым...
Dialogue: 0,0:02:55.04,0:02:56.59,Default,,0,0,0,,Егер сіз бірдеңені айтып жатсаңыз
Dialogue: 0,0:02:56.71,0:02:57.59,Default,,0,0,0,,Дереу ауруханаға барыңыз!
Dialogue: 0,0:02:57.71,0:02:58.92,Default,,0,0,0,,Такси күтіп тұр.
Dialogue: 0,0:02:59.05,0:03:01.43,Default,,0,0,0,,Мен сені апарамын, кеттік.
Dialogue: 0,0:03:01.55,0:03:02.39,Default,,0,0,0,,Иә
Dialogue: 0,0:03:02.51,0:03:03.85,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:03:05.97,0:03:10.94,Default,,0,0,0,,♪～
Dialogue: 0,0:04:30.89,0:04:35.85,Default,,0,0,0,,～♪
Dialogue: 0,0:04:38.61,0:04:42.15,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:50.66,0:04:51.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:51.83,0:04:53.66,Default,,0,0,0,,Футаба-кун ауруханада?
Dialogue: 0,0:04:53.79,0:04:54.62,Default,,0,0,0,,О
Dialogue: 0,0:04:54.75,0:04:57.33,Default,,0,0,0,,Ол жарақат алғаннан кейін сынақтан өткен сияқты.
Dialogue: 0,0:04:58.08,0:05:00.13,Default,,0,0,0,,Ол соншалықты қатты жарақат алмаған сияқты.
Dialogue: 0,0:05:00.25,0:05:01.17,Default,,0,0,0,,Мен оны көре алмадым...
Dialogue: 0,0:05:12.02,0:05:15.06,Default,,0,0,0,,Шотаро өз бетімен кеткісі келетінін айтты, солай ма?
Dialogue: 0,0:05:16.98,0:05:19.48,Default,,0,0,0,,Мен орта мектепке барғанда біз бұл туралы сөйлестік.
Dialogue: 0,0:05:20.90,0:05:23.32,Default,,0,0,0,,Барғыңыз келетін жерге барыңыз
Dialogue: 0,0:05:23.44,0:05:25.70,Default,,0,0,0,,Не істегіңіз келсе, соны істегеніңіз дұрыс.
Dialogue: 0,0:05:26.95,0:05:27.95,Default,,0,0,0,,Сіз оны таптыңыз.
Dialogue: 0,0:05:28.66,0:05:29.87,Default,,0,0,0,,Шотаро
Dialogue: 0,0:05:31.16,0:05:34.33,Default,,0,0,0,,Жүрегіңді не нәрсеге құя аласың
Dialogue: 0,0:05:44.59,0:05:47.88,Default,,0,0,0,,Барлық жарыстардың аяқталатын уақыты таяп қалды.
Dialogue: 0,0:05:48.68,0:05:50.68,Default,,0,0,0,,Рейтинг Не болды?
Dialogue: 0,0:05:51.60,0:05:54.43,Default,,0,0,0,,Сабыр етіңіз, сізге хабарласады.
Dialogue: 0,0:05:54.56,0:05:55.60,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:05:56.52,0:05:59.35,Default,,0,0,0,,Футаба-сан Футаба Шотаро-сан
Dialogue: 0,0:05:59.48,0:06:00.48,Default,,0,0,0,,Иә
Dialogue: 0,0:06:01.52,0:06:03.94,Default,,0,0,0,,Бүгінгі қолдауыңыз үшін рахмет.
Dialogue: 0,0:06:04.07,0:06:06.82,Default,,0,0,0,,Шотароға көп рахмет.
Dialogue: 0,0:06:07.49,0:06:09.74,Default,,0,0,0,,Барлығы өте керемет болды!
Dialogue: 0,0:06:09.86,0:06:12.62,Default,,0,0,0,,Жұмысыңды жалғастыра бер, мен саған тамыр жаямын.
Dialogue: 0,0:06:12.74,0:06:14.12,Default,,0,0,0,,Иә! (Ватари) Усу!
Dialogue: 0,0:06:14.95,0:06:16.41,Default,,0,0,0,,Футаба ше?
Dialogue: 0,0:06:16.54,0:06:17.66,Default,,0,0,0,,Мен әлі білмеймін
Dialogue: 0,0:06:21.54,0:06:22.79,Default,,0,0,0,,Сіз ашуланбайсыз ба?
Dialogue: 0,0:06:22.92,0:06:23.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:24.50,0:06:27.59,Default,,0,0,0,,Жарақат алған ойыншыға матчта ойнауға рұқсат беру
Dialogue: 0,0:06:29.43,0:06:32.10,Default,,0,0,0,,Мен оны тоқтата алмадым
Dialogue: 0,0:06:35.77,0:06:39.35,Default,,0,0,0,,Сіз Футаба үшін ең жақсы деп ойлаған жолды таңдадыңыз, солай ма?
Dialogue: 0,0:06:39.48,0:06:42.90,Default,,0,0,0,,Онда бұл менің кінәм емес.
Dialogue: 0,0:06:43.02,0:06:45.11,Default,,0,0,0,,Футаба сіздің оқушыңыз.
Dialogue: 0,0:06:45.94,0:06:49.07,Default,,0,0,0,,Бұл шынымен дұрыс болды ма...
Dialogue: 0,0:06:49.20,0:06:51.36,Default,,0,0,0,,Мен де үнемі абдырап жүремін (Шида) Бірақ!
Dialogue: 0,0:06:51.49,0:06:52.37,Default,,0,0,0,,Дегенмен⸺
Dialogue: 0,0:06:53.07,0:06:55.83,Default,,0,0,0,,Жауап беретін мен емес, сіз емес.
Dialogue: 0,0:06:55.95,0:06:57.62,Default,,0,0,0,,Әр ойыншы жеке.
Dialogue: 0,0:06:57.75,0:07:01.21,Default,,0,0,0,,Сіз мұны жақсы білмейсіз бе?
Dialogue: 0,0:07:03.88,0:07:06.09,Default,,0,0,0,,Әлі де қиын, солай емес пе?
Dialogue: 0,0:07:06.80,0:07:08.63,Default,,0,0,0,,Дамушы адамдар
Dialogue: 0,0:07:08.76,0:07:10.72,Default,,0,0,0,,Сіз түсіндіңіз бе?
Dialogue: 0,0:07:10.84,0:07:13.26,Default,,0,0,0,,Сіз де аздап өсіп жатқан сияқтысыз.
Dialogue: 0,0:07:13.39,0:07:15.18,Default,,0,0,0,,Хаха... Солай деп үміттенемін.
Dialogue: 0,0:07:15.30,0:07:17.89,Default,,0,0,0,,Хахаха... Мен аздап жеңілдеп қалдым.
Dialogue: 0,0:07:27.94,0:07:29.11,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:07:29.24,0:07:30.03,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,0:07:30.15,0:07:32.78,Default,,0,0,0,,Ешқашан өзіңізді бұлай мәжбүрлеуге тырыспаңыз.
Dialogue: 0,0:07:32.91,0:07:35.32,Default,,0,0,0,,Иә! кешіріңіз
Dialogue: 0,0:07:35.45,0:07:36.91,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:37.70,0:07:39.12,Default,,0,0,0,,Шотаро
Dialogue: 0,0:07:42.58,0:07:43.67,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:07:43.79,0:07:44.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:51.59,0:07:53.38,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:07:54.72,0:07:56.35,Default,,0,0,0,,Мисато-кун, сөмке үшін рахмет.
Dialogue: 0,0:07:56.47,0:07:57.26,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:57.89,0:07:59.81,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:07:59.93,0:08:02.10,Default,,0,0,0,,Жоқ! (Футаба) А? Мисато-кун?
Dialogue: 0,0:08:02.23,0:08:03.77,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:08:04.35,0:08:05.23,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:08:05.35,0:08:06.31,Default,,0,0,0,,Не болды? (Мисато) Әй!
Dialogue: 0,0:08:06.44,0:08:08.61,Default,,0,0,0,,Ах! Үлкендеріңізден естідіңіз бе?
Dialogue: 0,0:08:08.73,0:08:09.98,Default,,0,0,0,,Рейтинг Не болды...
Dialogue: 0,0:08:10.11,0:08:13.45,Default,,0,0,0,,Иә! басқа! Менің ағам емес! Мүлдем жоқ!
Dialogue: 0,0:08:14.07,0:08:16.87,Default,,0,0,0,,Мен рейтингті білмеймін! Сіз ешқашан білмейсіз!
Dialogue: 0,0:08:17.62,0:08:18.87,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:08:18.99,0:08:21.91,Default,,0,0,0,,Ал... Әйтеуір, өтетін орынға қайтайық.
Dialogue: 0,0:08:22.46,0:08:23.33,Default,,0,0,0,,Иә
Dialogue: 0,0:08:29.59,0:08:31.84,Default,,0,0,0,,Неге мен сенен хабар алған жоқпын?
Dialogue: 0,0:08:31.96,0:08:34.38,Default,,0,0,0,,Эй Мисато-кун (Мисато) Иә? аа
Dialogue: 0,0:08:35.26,0:08:37.85,Default,,0,0,0,,Турнир жаңа ғана аяқталды, сондықтан сіз бос емессіз.
Dialogue: 0,0:08:37.97,0:08:39.26,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:08:39.39,0:08:41.97,Default,,0,0,0,,Бұл сіз айта алмаған рейтинг болды ма?
Dialogue: 0,0:08:42.10,0:08:44.52,Default,,0,0,0,,Ақыр соңында, мен үлкендермен хабарласуым керек...
Dialogue: 0,0:08:44.64,0:08:46.77,Default,,0,0,0,,Тоқта! (Футаба) Тамае?
Dialogue: 0,0:08:46.90,0:08:49.11,Default,,0,0,0,,Ах! Ааа~
Dialogue: 0,0:08:49.23,0:08:53.03,Default,,0,0,0,,Сенпай, сенің қолың бос емес екеніне сенімдімін. Иә.
Dialogue: 0,0:08:53.15,0:08:54.74,Default,,0,0,0,,Хмм, бірақ...
Dialogue: 0,0:08:54.86,0:08:56.24,Default,,0,0,0,,Жоқ! (Футаба) Бірақ...
Dialogue: 0,0:08:56.36,0:09:00.37,Default,,0,0,0,,Егер ол жұмыс істемесе, ол жұмыс істемейді! хабарласыңыз! Тыйым салынған!
Dialogue: 0,0:09:02.75,0:09:04.12,Default,,0,0,0,,(көлік есігінің ашылған дыбысы)
Dialogue: 0,0:09:05.25,0:09:07.96,Default,,0,0,0,,Рахмет (Мисато) Рахмет
Dialogue: 0,0:09:08.08,0:09:09.59,Default,,0,0,0,,Мисато-кун, тезірек барайық!
Dialogue: 0,0:09:09.71,0:09:11.34,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:09:14.22,0:09:17.01,Default,,0,0,0,,Ах! Шотаро! Мисато!
Dialogue: 0,0:09:18.34,0:09:19.26,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:09:19.39,0:09:22.77,Default,,0,0,0,,Мен оған матчқа қатысқанымды айтсам, ол қатты ашуланды.
Dialogue: 0,0:09:22.89,0:09:24.77,Default,,0,0,0,,! Сіздің білегіңіз ше?
Dialogue: 0,0:09:24.89,0:09:28.27,Default,,0,0,0,,Жарайды. Сүйектерде ештеңе жоқ.
Dialogue: 0,0:09:28.40,0:09:30.86,Default,,0,0,0,,Мен біраз уақыт жаттығу жасай алмаймын.
Dialogue: 0,0:09:30.98,0:09:32.86,Default,,0,0,0,,көремін. (Курикома) Мен жеңілдеп қалдым.
Dialogue: 0,0:09:32.98,0:09:34.53,Default,,0,0,0,,Әзірге қауіпсіз.
Dialogue: 0,0:09:34.65,0:09:36.74,Default,,0,0,0,,Облыстық конференция туралы не айтасыз?
Dialogue: 0,0:09:36.86,0:09:38.45,Default,,0,0,0,,Рейтингке не болды? (Шичигахама/Цукидате) Ах...
Dialogue: 0,0:09:38.57,0:09:40.24,Default,,0,0,0,,Хмм... (Шичигахама) Хмм...
Dialogue: 0,0:09:45.00,0:09:46.12,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:09:46.75,0:09:48.75,Default,,0,0,0,,Сіз басқа топтан өтіп кеттіңіз бе?
Dialogue: 0,0:09:52.92,0:09:57.76,Default,,0,0,0,,Сонымен... бұл соңы ма?
Dialogue: 0,0:09:59.14,0:10:00.34,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:01.51,0:10:03.14,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:10:03.26,0:10:05.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:09.06,0:10:10.27,Default,,0,0,0,,Рух толқындарын қолдануды да ұмытып кеткенмін
Dialogue: 0,0:10:10.40,0:10:12.82,Default,,0,0,0,,Уайымдама, сен 2-орындасың. 2 орын.
Dialogue: 0,0:10:12.94,0:10:14.61,Default,,0,0,0,,Осыдан кейін, соңында⸺
Dialogue: 0,0:10:14.73,0:10:16.99,Default,,0,0,0,,Менен ешбір команда өткен жоқ.
Dialogue: 0,0:10:17.11,0:10:19.70,Default,,0,0,0,,Тохоку аймағынан кімдер орта мектепке қатысады?
Dialogue: 0,0:10:19.82,0:10:22.70,Default,,0,0,0,,Бірінші орын Широ орта мектебі және екінші орын Ао орта мектебі!
Dialogue: 0,0:10:22.83,0:10:27.46,Default,,0,0,0,,Бізден кейінгі Ивате өкілі өте жақсы жұмыс жасады.
Dialogue: 0,0:10:27.58,0:10:29.33,Default,,0,0,0,,Шынымды айтсам, қорықтым.
Dialogue: 0,0:10:29.46,0:10:32.04,Default,,0,0,0,,Бұл қорқынышты болды. 0,1 ұпай айырмашылығы.
Dialogue: 0,0:10:32.17,0:10:33.09,Default,,0,0,0,,Әрең
Dialogue: 0,0:10:33.21,0:10:35.80,Default,,0,0,0,,Шотароның білегі жақсы сияқты.
Dialogue: 0,0:10:35.92,0:10:37.55,Default,,0,0,0,,Мисато маған хабарласты.
Dialogue: 0,0:10:37.67,0:10:41.84,Default,,0,0,0,,Мен оларға рейтингімді айтайын десем, Онагава-сенпай: «Бір минут күте тұрыңыз» деді.
Dialogue: 0,0:10:41.97,0:10:44.06,Default,,0,0,0,,Біз оны жандандыруымыз керек, солай ма?
Dialogue: 0,0:10:44.18,0:10:46.85,Default,,0,0,0,,Жоқ, бұл жаман дедім.
Dialogue: 0,0:10:46.97,0:10:48.35,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:48.48,0:10:50.39,Default,,0,0,0,,Ах... жаман Ашулысың ба?
Dialogue: 0,0:10:50.52,0:10:52.27,Default,,0,0,0,,Сондықтан тоқтатыңыз.
Dialogue: 0,0:10:52.40,0:10:54.11,Default,,0,0,0,,Капитанның да көңіл-күйі жақсы болды.
Dialogue: 0,0:10:54.23,0:10:55.44,Default,,0,0,0,,Мен крекер сатып алдым.
Dialogue: 0,0:10:55.57,0:10:57.07,Default,,0,0,0,,Ух... Айтайын дегенім.
Dialogue: 0,0:10:57.19,0:10:59.20,Default,,0,0,0,,Егер сіз мұны істегіңіз келсе, оны толық орындауыңыз керек ...
Dialogue: 0,0:10:59.32,0:11:00.28,Default,,0,0,0,,Өйткені, көңіл-күйім көтеріңкі
Dialogue: 0,0:11:00.91,0:11:03.66,Default,,0,0,0,,А... А? Шотаро?
Dialogue: 0,0:11:04.58,0:11:07.66,Default,,0,0,0,,(Футабаның жылағаны)
Dialogue: 0,0:11:07.79,0:11:08.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:09.00,0:11:11.96,Default,,0,0,0,,Жақсы... Жақсы...
Dialogue: 0,0:11:12.54,0:11:14.79,Default,,0,0,0,,Мен... Мен үшін...
Dialogue: 0,0:11:14.92,0:11:18.17,Default,,0,0,0,,Inter-High... Бара алмасам да...
Dialogue: 0,0:11:18.30,0:11:21.38,Default,,0,0,0,,Ал егер… Ал егер…
Dialogue: 0,0:11:22.18,0:11:24.14,Default,,0,0,0,,Менің үлкендерге... Уф...
Dialogue: 0,0:11:24.26,0:11:25.22,Default,,0,0,0,,Мен...
Dialogue: 0,0:11:25.35,0:11:27.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:28.43,0:11:29.56,Default,,0,0,0,,Шотаро...
Dialogue: 0,0:11:36.69,0:11:38.86,Default,,0,0,0,,Бәріміз қайтадан секіре аламыз
Dialogue: 0,0:11:38.98,0:11:40.82,Default,,0,0,0,,Еңбегіңізге рахмет.
Dialogue: 0,0:11:45.57,0:11:46.83,Default,,0,0,0,,Капитан…
Dialogue: 0,0:11:46.95,0:11:48.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:55.54,0:11:56.71,Default,,0,0,0,,Футаба-кун!
Dialogue: 0,0:11:56.84,0:11:59.00,Default,,0,0,0,,Хаха...
Dialogue: 0,0:11:59.13,0:12:00.09,Default,,0,0,0,,Білегіңіз қалай?
Dialogue: 0,0:12:00.97,0:12:03.09,Default,,0,0,0,,Әзірге бәрібір.
Dialogue: 0,0:12:09.22,0:12:11.18,Default,,0,0,0,,Олай болса үйге қайтайық.
Dialogue: 0,0:12:11.31,0:12:12.10,Default,,0,0,0,,Иә! (Ватари) Усу!
Dialogue: 0,0:12:12.73,0:12:14.48,Default,,0,0,0,,Жоғары деңгейдегі қатысуды еске алу
Dialogue: 0,0:12:14.60,0:12:15.90,Default,,0,0,0,,Бүгін мен сендерге той беремін.
Dialogue: 0,0:12:16.02,0:12:16.98,Default,,0,0,0,,Сіз байсалдысыз ба? (Онагава) Директор: Үлкен жүректі ~
Dialogue: 0,0:12:17.11,0:12:18.57,Default,,0,0,0,,Иә! (Цукидате) Рахмет.
Dialogue: 0,0:12:18.69,0:12:21.86,Default,,0,0,0,,Yahoo~! (Цукидате және т.б.) Хахахаха...
Dialogue: 0,0:12:26.16,0:12:27.95,Default,,0,0,0,,Иә! 8 тартылған ет котлеттері
Dialogue: 0,0:12:28.62,0:12:29.91,Default,,0,0,0,,Әдеттегідей рахмет!
Dialogue: 0,0:12:30.04,0:12:30.83,Default,,0,0,0,,...
Dialogue: 0,0:12:30.95,0:12:33.33,Default,,0,0,0,,Иә Омачидоосама (Шичигахама) Азассу!
Dialogue: 0,0:12:33.46,0:12:35.37,Default,,0,0,0,,Inter-High-ке қатысу?
Dialogue: 0,0:12:35.50,0:12:37.13,Default,,0,0,0,,Мұғалімнің де мұрны үлкен.
Dialogue: 0,0:12:37.25,0:12:38.96,Default,,0,0,0,,Ойыншыларға рахмет
Dialogue: 0,0:12:39.09,0:12:40.71,Default,,0,0,0,,Келесі жолы мен жеңемін!
Dialogue: 0,0:12:42.09,0:12:43.13,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:12:43.26,0:12:44.72,Default,,0,0,0,,Мен фарш котлет сатып алдым~
Dialogue: 0,0:12:44.84,0:12:46.64,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:47.76,0:12:49.43,Default,,0,0,0,,Бұл бәрібір.
Dialogue: 0,0:12:50.35,0:12:52.31,Default,,0,0,0,,Бес және алты мүше суға малынған.
Dialogue: 0,0:12:52.43,0:12:53.43,Default,,0,0,0,,Міне!
Dialogue: 0,0:12:53.56,0:12:57.31,Default,,0,0,0,,Мисато-кун, сен Маширо Цукиюкидің байланыс ақпаратын білесің бе?
Dialogue: 0,0:12:57.44,0:12:58.86,Default,,0,0,0,,Иә? Иә
Dialogue: 0,0:12:58.98,0:13:00.94,Default,,0,0,0,,Олай болса, маған хабарласыңыз.
Dialogue: 0,0:13:01.07,0:13:03.11,Default,,0,0,0,,Шотаро үшін уайымдап тұрған сияқтысыз.
Dialogue: 0,0:13:03.24,0:13:04.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:04.86,0:13:06.66,Default,,0,0,0,,Әрине, Интер-Хайда
Dialogue: 0,0:13:06.78,0:13:09.45,Default,,0,0,0,,Менің ойымша, ол қазіргіден гөрі көбірек күш көрсетеді.
Dialogue: 0,0:13:09.58,0:13:12.45,Default,,0,0,0,,Әрине, тағынан бас тартамын деген ойым жоқ.
Dialogue: 0,0:13:13.12,0:13:14.54,Default,,0,0,0,,Футабаның жарақаты жазылды
Dialogue: 0,0:13:14.66,0:13:18.00,Default,,0,0,0,,Мен Ао Жоғары 100% болуын сұраймын.
Dialogue: 0,0:13:18.13,0:13:19.13,Default,,0,0,0,,Такасе…
Dialogue: 0,0:13:19.25,0:13:20.84,Default,,0,0,0,,Муцу-кун…
Dialogue: 0,0:13:23.46,0:13:24.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:24.01,0:13:24.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:24.01,0:13:24.55,Default,,0,0,0,,Мисапон, әрине⸺
Dialogue: 0,0:13:24.55,0:13:25.51,Default,,0,0,0,,Мисапон, әрине⸺
Dialogue: 0,0:13:26.13,0:13:29.05,Default,,0,0,0,,Бүгінгі шотаро тамаша болды
Dialogue: 0,0:13:29.60,0:13:32.14,Default,,0,0,0,,Қарап отырып, басымнан тайды.
Dialogue: 0,0:13:32.26,0:13:34.18,Default,,0,0,0,,Өйткені мен ешқашан жеңілмеймін
Dialogue: 0,0:13:34.31,0:13:36.56,Default,,0,0,0,,Мен сізді Inter-High⸺-де міндетті түрде кездестіремін
Dialogue: 0,0:13:37.14,0:13:39.02,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:13:40.23,0:13:42.57,Default,,0,0,0,,Маширо осындай нәрсе жасады ма?
Dialogue: 0,0:13:43.48,0:13:45.82,Default,,0,0,0,,Сіздің білегіңіз ше?
Dialogue: 0,0:13:45.95,0:13:47.28,Default,,0,0,0,,Жаттығуға қашан оралуға болады?
Dialogue: 0,0:13:48.28,0:13:49.53,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:13:50.16,0:13:53.49,Default,,0,0,0,,Толық қалпына келтіру 2 аптадан 1 айға дейін ұзартылды.
Dialogue: 0,0:13:53.62,0:13:54.83,Default,,0,0,0,,Бір ай?
Dialogue: 0,0:13:54.95,0:13:57.04,Default,,0,0,0,,Интер-Хайға дейін аз ғана уақыт емес пе?
Dialogue: 0,0:13:57.16,0:14:00.42,Default,,0,0,0,,Бұл менің осы уақыт ішінде жаттығу жасай алмайтынымды білдіре ме?
Dialogue: 0,0:14:00.54,0:14:02.04,Default,,0,0,0,,Қолымыздан келгенін жасаймыз!
Dialogue: 0,0:14:02.17,0:14:05.01,Default,,0,0,0,,Иә, мұның бәрі сіздің қолыңыздан келеді.
Dialogue: 0,0:14:05.13,0:14:07.68,Default,,0,0,0,,Қолмен жаттығуға біраз уақытқа тыйым салынады.
Dialogue: 0,0:14:07.80,0:14:08.59,Default,,0,0,0,,Бірақ содан кейін
Dialogue: 0,0:14:08.72,0:14:11.05,Default,,0,0,0,,Сіз Inter-Highде дұрыс өнер көрсете алмайсыз...
Dialogue: 0,0:14:11.68,0:14:14.47,Default,,0,0,0,,Бүгін менің жолым болды.
Dialogue: 0,0:14:14.60,0:14:18.56,Default,,0,0,0,,Көркем гимнастикамен енді ешқашан айналыса алмауымның нақты мүмкіндігі болды.
Dialogue: 0,0:14:19.65,0:14:21.56,Default,,0,0,0,,Мучаға енді рұқсат етілмейді
Dialogue: 0,0:14:21.69,0:14:23.32,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:14:23.44,0:14:26.82,Default,,0,0,0,,Шотароның жарақаты одан да ауыр болса ше?
Dialogue: 0,0:14:26.94,0:14:29.41,Default,,0,0,0,,Бұл үлкен мәселеге айналуы мүмкін.
Dialogue: 0,0:14:29.53,0:14:30.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:31.07,0:14:33.41,Default,,0,0,0,,Қадағалау жауапкершілігі мәселелері
Dialogue: 0,0:14:33.53,0:14:37.20,Default,,0,0,0,,Егер жақсы жұмыс жасамасақ, клубтың қызметі тоқтатылады... не болса да.
Dialogue: 0,0:14:37.33,0:14:38.83,Default,,0,0,0,,Бұл кезде
Dialogue: 0,0:14:38.96,0:14:41.46,Default,,0,0,0,,Жауапкершілікті өз мойныңызға алғыңыз келді ме?
Dialogue: 0,0:14:41.58,0:14:43.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:45.71,0:14:47.13,Default,,0,0,0,,Мен саған айттым.
Dialogue: 0,0:14:47.26,0:14:49.38,Default,,0,0,0,,Ешкім жауапкершілікті ала алмайды.
Dialogue: 0,0:14:50.13,0:14:52.39,Default,,0,0,0,,Тек жазаланыңыз.
Dialogue: 0,0:14:53.30,0:14:54.60,Default,,0,0,0,,Қадағалау…
Dialogue: 0,0:14:56.14,0:14:59.48,Default,,0,0,0,,Мен келесі айда міндетті түрде қолымды қолдануға жаттығу жасамаймын!
Dialogue: 0,0:14:59.60,0:15:02.40,Default,,0,0,0,,Және ол мүмкіндігінше тез жазылады!
Dialogue: 0,0:15:02.94,0:15:04.19,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:15:05.57,0:15:06.36,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:06.48,0:15:09.32,Default,,0,0,0,,Сіз осылай шешім қабылдадыңыз ба?
Dialogue: 0,0:15:10.28,0:15:12.49,Default,,0,0,0,,Бұл тым асыра айтылған емес, бірақ...
Dialogue: 0,0:15:13.24,0:15:18.50,Default,,0,0,0,,Мен жас кезімде ойнауға мәжбүр болдым және ойыншы ретінде мансабымды аяқтадым.
Dialogue: 0,0:15:18.62,0:15:22.17,Default,,0,0,0,,Бірақ мен өкінбеймін.
Dialogue: 0,0:15:22.29,0:15:25.59,Default,,0,0,0,,Мен ары қарай не болғанын ойламай өз өсиетімді орындадым.
Dialogue: 0,0:15:25.71,0:15:29.26,Default,,0,0,0,,Менің ойымша, сондықтан мен басқа жолға түсе алдым.
Dialogue: 0,0:15:30.13,0:15:31.97,Default,,0,0,0,,Біраз уақыт қажет болды.
Dialogue: 0,0:15:33.14,0:15:35.14,Default,,0,0,0,,Болашақ маңызды екені сөзсіз.
Dialogue: 0,0:15:35.26,0:15:38.47,Default,,0,0,0,,Болашағыңнан айыратын ешнәрсе жасама.
Dialogue: 0,0:15:38.60,0:15:43.02,Default,,0,0,0,,Кейде қате болашаққа көшпеу үшін түзетулер енгізу қажет болуы мүмкін.
Dialogue: 0,0:15:45.15,0:15:46.48,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:46.61,0:15:50.03,Default,,0,0,0,,Тіпті өз ойларыңызды елемеу және болашақты өзіңізге мәжбүрлеу⸺
Dialogue: 0,0:15:50.15,0:15:52.40,Default,,0,0,0,,Мен бірдеңе дұрыс емес деп ойладым.
Dialogue: 0,0:15:52.91,0:15:55.78,Default,,0,0,0,,Бұл дұрыс болашақ болса да.
Dialogue: 0,0:15:56.87,0:15:58.99,Default,,0,0,0,,Мен сенің өзің таңдағаныңды қаладым.
Dialogue: 0,0:16:01.12,0:16:03.92,Default,,0,0,0,,Егер мен теріс жолға түссем
Dialogue: 0,0:16:04.04,0:16:06.84,Default,,0,0,0,,Ондай жағдайда мен сізге көмектесуге бар күшімді саламын.
Dialogue: 0,0:16:07.34,0:16:09.80,Default,,0,0,0,,Қайта-қайта
Dialogue: 0,0:16:10.42,0:16:14.51,Default,,0,0,0,,Бірақ тәрбиеші ретінде мен тоқтауым керек еді.
Dialogue: 0,0:16:14.64,0:16:17.81,Default,,0,0,0,,Көшбасшы боламын дегендей.
Dialogue: 0,0:16:17.93,0:16:19.77,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:20.39,0:16:23.52,Default,,0,0,0,,Себебі режиссер Шотароны матчқа жіберді.
Dialogue: 0,0:16:23.64,0:16:26.27,Default,,0,0,0,,Бұдан былай алты адам секіре алады.
Dialogue: 0,0:16:26.40,0:16:29.11,Default,,0,0,0,,Шида мырзамен... директормен кездесу
Dialogue: 0,0:16:29.23,0:16:30.73,Default,,0,0,0,,Біз осы уақытқа дейін келе алдық.
Dialogue: 0,0:16:33.90,0:16:35.41,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:16:35.53,0:16:36.74,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:16:41.20,0:16:42.12,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:43.87,0:16:47.54,Default,,0,0,0,,Мен сізге алғыс айтуым керек.
Dialogue: 0,0:16:47.67,0:16:51.59,Default,,0,0,0,,Сен мені орта мектепке апарамын деген уәдеңді орындадың.
Dialogue: 0,0:16:51.71,0:16:52.51,Default,,0,0,0,,және⸺
Dialogue: 0,0:16:52.63,0:16:55.51,Default,,0,0,0,,Сіз матч көріп отырғанда, бұл⸺
Dialogue: 0,0:16:55.63,0:16:57.55,Default,,0,0,0,,Мен де секіргендей болдым.
Dialogue: 0,0:16:58.76,0:16:59.56,Default,,0,0,0,,Сол кезде⸺
Dialogue: 0,0:17:00.18,0:17:02.64,Default,,0,0,0,,Мен де сенімен бірге секірдім
Dialogue: 0,0:17:03.27,0:17:06.81,Default,,0,0,0,,Балалар сендерге рахмет, мен қайтадан секірдім.
Dialogue: 0,0:17:08.40,0:17:10.15,Default,,0,0,0,,Мен шынымен бақытты болдым.
Dialogue: 0,0:17:14.40,0:17:15.57,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:19.66,0:17:20.87,Default,,0,0,0,,Менен де!
Dialogue: 0,0:17:20.99,0:17:26.17,Default,,0,0,0,,Цукидате, Онагава, Ватари, Шотаро, Мисато және Курикомаға рахмет!
Dialogue: 0,0:17:26.29,0:17:27.29,Default,,0,0,0,,Бұл капитан
Dialogue: 0,0:17:27.42,0:17:28.38,Default,,0,0,0,,Куууу!
Dialogue: 0,0:17:28.50,0:17:31.42,Default,,0,0,0,,Мен Ао орта мектебіне келіп, ерлер көркем гимнастикасымен таныстым.
Dialogue: 0,0:17:31.55,0:17:33.01,Default,,0,0,0,,Бұл өте жақсы болды!
Dialogue: 0,0:17:33.13,0:17:34.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:34.47,0:17:36.51,Default,,0,0,0,,Хехе, ол үшін уайымдама.
Dialogue: 0,0:17:36.63,0:17:37.97,Default,,0,0,0,,Капитан да солай деді.
Dialogue: 0,0:17:38.09,0:17:40.60,Default,,0,0,0,,Сізге рахмет, мен Интер-Хайға бара аламын.
Dialogue: 0,0:17:40.72,0:17:42.26,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:17:42.39,0:17:44.56,Default,,0,0,0,,Иә? Мұны кім айтты?
Dialogue: 0,0:17:44.68,0:17:45.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:45.60,0:17:48.48,Default,,0,0,0,,Біздің ұпайымыз есіңізде, солай ма?
Dialogue: 0,0:17:48.60,0:17:51.23,Default,,0,0,0,,Ах! 17,800!
Dialogue: 0,0:17:52.15,0:17:54.23,Default,,0,0,0,,Мен жартылай алдыңғы флипте қате жібердім.
Dialogue: 0,0:17:54.36,0:17:57.95,Default,,0,0,0,,Мен денемді созып, бір рет айналдырсам, мен кіршімін.
Dialogue: 0,0:17:58.07,0:18:00.70,Default,,0,0,0,,Кешіріңіз! Оны қолыңызда ұстаңыз және бір рет бұраңыз
Dialogue: 0,0:18:00.82,0:18:02.83,Default,,0,0,0,,Төңкеріліп тұрғанда басымды әлсіретіп жібердім.
Dialogue: 0,0:18:02.95,0:18:05.58,Default,,0,0,0,,Мен грэпплинг әдістерімен әдемірек секіруім керек еді.
Dialogue: 0,0:18:05.70,0:18:07.25,Default,,0,0,0,,Иә... мен де
Dialogue: 0,0:18:07.87,0:18:10.21,Default,,0,0,0,,Сіз әлі де жоғары мақсат қоя аласыз
Dialogue: 0,0:18:10.33,0:18:13.25,Default,,0,0,0,,Тамаша 100% өнімділікті аяқтаңыз
Dialogue: 0,0:18:13.38,0:18:15.38,Default,,0,0,0,,Келесі жолы біз жеңеміз!
Dialogue: 0,0:18:16.09,0:18:18.80,Default,,0,0,0,,Шотаро бір ай жаттыға алмаса да.
Dialogue: 0,0:18:18.93,0:18:21.85,Default,,0,0,0,,Егер сіз басынан бастап жеңілемін деп ойласаңыз, қызық болмас еді, солай ма?
Dialogue: 0,0:18:21.97,0:18:22.89,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:23.01,0:18:24.47,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:18:24.60,0:18:26.14,Default,,0,0,0,,Келесі жолы Широ орта мектебін жеңеміз
Dialogue: 0,0:18:26.27,0:18:27.89,Default,,0,0,0,,Капитанға ұқсайды.
Dialogue: 0,0:18:28.02,0:18:29.56,Default,,0,0,0,,Мен өзімді жанып тұрғандай сезінемін~
Dialogue: 0,0:18:29.69,0:18:31.56,Default,,0,0,0,,Жоғарыны алып, орындайық!
Dialogue: 0,0:18:31.69,0:18:35.73,Default,,0,0,0,,Барлығы оптимистік, әлде менмен айту керек пе.
Dialogue: 0,0:18:35.86,0:18:37.49,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:18:37.61,0:18:38.49,Default,,0,0,0,,Бұл…
Dialogue: 0,0:18:38.61,0:18:41.49,Default,,0,0,0,,Бүгінгі деректер де тамаша түсірілген.
Dialogue: 0,0:18:41.62,0:18:42.95,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:18:43.08,0:18:44.79,Default,,0,0,0,,Сіз байсалдысыз ба? (Онагава) Керемет менеджер!
Dialogue: 0,0:18:44.91,0:18:46.29,Default,,0,0,0,,Мен қобалжыдым (Цукидате) Мен уайымдап тұрмын...
Dialogue: 0,0:18:46.41,0:18:48.37,Default,,0,0,0,,Бұл бастама!
Dialogue: 0,0:18:48.50,0:18:51.17,Default,,0,0,0,,Интер-Бийге секірейік!
Dialogue: 0,0:18:51.29,0:18:52.58,Default,,0,0,0,,О!
Dialogue: 0,0:19:01.84,0:19:02.64,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:19:03.64,0:19:04.60,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:19:04.72,0:19:08.14,Default,,0,0,0,,А... Бөлмеге кірген бойда көңілім жеңілдеп қалды.
Dialogue: 0,0:19:11.77,0:19:15.32,Default,,0,0,0,,Мен шынымен де дәл қазір өзімді осы жерде сезінемін.
Dialogue: 0,0:19:16.82,0:19:18.28,Default,,0,0,0,,Бұл біздің жеріміз.
Dialogue: 0,0:19:20.15,0:19:21.03,Default,,0,0,0,,Иә
Dialogue: 0,0:19:23.16,0:19:24.45,Default,,0,0,0,,Ертең де секірейік
Dialogue: 0,0:19:25.28,0:19:26.66,Default,,0,0,0,,О
Dialogue: 0,0:19:27.58,0:19:29.54,Default,,0,0,0,,Иә? Бір минут күтіңіз
Dialogue: 0,0:19:29.66,0:19:31.67,Default,,0,0,0,,Шотаро, секіре алмайсың.
Dialogue: 0,0:19:31.79,0:19:33.67,Default,,0,0,0,,Не? Ах!
Dialogue: 0,0:19:33.79,0:19:34.88,Default,,0,0,0,,Ахх!
Dialogue: 0,0:19:35.00,0:19:36.25,Default,,0,0,0,,Не болып жатыр? Не болды?
Dialogue: 0,0:19:36.38,0:19:38.09,Default,,0,0,0,,Амансың ба, Шотаро?
Dialogue: 0,0:19:38.21,0:19:39.38,Default,,0,0,0,,Өзіңізді тағы да ренжіттіңіз бе?
Dialogue: 0,0:19:39.51,0:19:41.34,Default,,0,0,0,,Каккакка качикоми~!
Dialogue: 0,0:19:42.72,0:19:45.55,Default,,0,0,0,,Онагава-сенпай, оның кері айналу жылдамдығы артып келеді.
Dialogue: 0,0:19:45.68,0:19:46.47,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:19:46.60,0:19:48.97,Default,,0,0,0,,Капитан Тау (Шичигахама) О, алға.
Dialogue: 0,0:20:07.45,0:20:08.54,Default,,0,0,0,,Сәлем! (Футаба) Әй!
Dialogue: 0,0:20:08.66,0:20:10.54,Default,,0,0,0,,Қозғалмай қалды, Шотаро!
Dialogue: 0,0:20:10.66,0:20:12.12,Default,,0,0,0,,Концентрация концентрациясы!
Dialogue: 0,0:20:12.25,0:20:13.54,Default,,0,0,0,,Ах ха... иә!
Dialogue: 0,0:20:14.25,0:20:16.46,Default,,0,0,0,,Жоқ (Курикома) Сабырлы болыңыз.
Dialogue: 0,0:20:17.29,0:20:18.46,Default,,0,0,0,,Иә~
Dialogue: 0,0:20:18.59,0:20:21.88,Default,,0,0,0,,Дұрыс, Inter-High бір айдан кейін өтеді.
Dialogue: 0,0:20:22.01,0:20:24.64,Default,,0,0,0,,Айтпақшы, бұл жағдайда мен Эйспін.
Dialogue: 0,0:20:24.76,0:20:27.18,Default,,0,0,0,,Ең болмаса, менің орнымды жылы ұстаңыз.
Dialogue: 0,0:20:27.30,0:20:28.47,Default,,0,0,0,,Эйс орнына қой
Dialogue: 0,0:20:28.60,0:20:30.27,Default,,0,0,0,,Ауыспалы эйс емес
Dialogue: 0,0:20:30.39,0:20:35.15,Default,,0,0,0,,Егер мен оны Interhigh түзете алмасам, олар түсінетініне сенімдімін, иә?
Dialogue: 0,0:20:35.27,0:20:37.52,Default,,0,0,0,,Бәріміз бірге тағы секірейік, солай ма?
Dialogue: 0,0:20:38.73,0:20:40.03,Default,,0,0,0,,Иә! (Ватари) Хехе...
Dialogue: 0,0:20:40.15,0:20:41.03,Default,,0,0,0,,Уа!
Dialogue: 0,0:20:41.15,0:20:43.82,Default,,0,0,0,,Сіз сауығып кеткен соң, мен сізді тез арада маған қосамын.
Dialogue: 0,0:20:43.95,0:20:45.78,Default,,0,0,0,,Осы уақытқа дейін қолыңнан келгенін істе.
Dialogue: 0,0:20:45.91,0:20:46.78,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:50.45,0:20:53.66,Default,,0,0,0,,Иә, мен әлі де секіре аламын.
Dialogue: 0,0:20:53.79,0:20:56.42,Default,,0,0,0,,Мисатомен және менің ағаларыммен
Dialogue: 0,0:20:57.58,0:20:59.84,Default,,0,0,0,,Мен алғаш рет кері айналдыру мүмкіндігін алған күннен бастап⸺
Dialogue: 0,0:21:00.84,0:21:03.26,Default,,0,0,0,,Менің әлемім барған сайын кеңейіп келеді⸺
Dialogue: 0,0:21:03.38,0:21:05.76,Default,,0,0,0,,Мен бұрын білмеген өзімді таптым
Dialogue: 0,0:21:06.72,0:21:08.10,Default,,0,0,0,,Орны жетпес орын құрылды
Dialogue: 0,0:21:09.51,0:21:10.72,Default,,0,0,0,,Мен маңызды адамдарды кездестірдім
Dialogue: 0,0:21:12.31,0:21:14.85,Default,,0,0,0,,Өзім таңдадым, өзім шештім.
Dialogue: 0,0:21:16.65,0:21:19.61,Default,,0,0,0,,Мен не істегім келеді Мен қайда барғым келеді
Dialogue: 0,0:21:20.27,0:21:22.44,Default,,0,0,0,,Мен жалғастырамын...
Dialogue: 0,0:21:23.07,0:21:25.45,Default,,0,0,0,,Бәріміз секіргіміз келеді!
Dialogue: 0,0:21:25.99,0:21:30.95,Default,,0,0,0,,♪～
Dialogue: 0,0:22:50.95,0:22:55.91,Default,,0,0,0,,～♪
