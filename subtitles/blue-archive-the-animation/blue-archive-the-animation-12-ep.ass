Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.44,0:00:10.47,Default,,0,0,0,,Расталған.
Dialogue: 0,0:00:10.47,0:00:13.14,Default,,0,0,0,,Бұл мұғалімнің ақпаратымен де сәйкес келеді➡
Dialogue: 0,0:00:13.14,0:00:15.78,Default,,0,0,0,,Бұл нысан, әрине, сол сияқты.
Dialogue: 0,0:00:15.78,0:00:17.78,Default,,0,0,0,,Рахмет Аяна.
Dialogue: 0,0:00:17.78,0:00:20.28,Default,,0,0,0,,Хошино-сенпай ана жерде...
Dialogue: 0,0:00:20.28,0:00:22.45,Default,,0,0,0,,Барлығың дайынсыңдар ма?
Dialogue: 0,0:00:22.45,0:00:24.65,Default,,0,0,0,,Иә.
Dialogue: 0,0:00:29.12,0:00:32.10,Default,,0,0,0,,《Широко: Сол кезде маған Хошино-сенпай айтты➡
Dialogue: 0,0:00:32.10,0:00:35.56,Default,,0,0,0,,Ол маған қолын созды.
Dialogue: 0,0:00:35.56,0:00:38.23,Default,,0,0,0,,Енді мен...》
Dialogue: 0,0:00:42.77,0:00:45.77,Default,,0,0,0,,《Күт, Хошино-сенпай》
Dialogue: 0,0:01:05.43,0:01:07.60,Default,,0,0,0,,Бұл ыңғайсыздық!
Dialogue: 0,0:01:07.60,0:01:10.60,Default,,0,0,0,,Шық! (Кайзер ПМК сарбаздары) Арх!
Dialogue: 0,0:01:10.60,0:01:12.60,Default,,0,0,0,,Қарғыс атсын! Не болып жатыр! ?
Dialogue: 0,0:01:12.60,0:01:16.61,Default,,0,0,0,,Балалар! Сіз бұл қай жерде екенін білесіз бе?
Dialogue: 0,0:01:16.61,0:01:18.61,Default,,0,0,0,,Аһ!
Dialogue: 0,0:01:18.61,0:01:20.61,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:01:20.61,0:01:22.71,Default,,0,0,0,,Әрине.
Dialogue: 0,0:01:25.78,0:01:28.68,Default,,0,0,0,,Өйткені, алдыңғы қақпадан басқа жерден кіруге тыйым салынады➡
Dialogue: 0,0:01:28.68,0:01:30.92,Default,,0,0,0,,Бұл мүмкін емес сияқты. Бірақ➡
Dialogue: 0,0:01:30.92,0:01:33.42,Default,,0,0,0,,Егер бәрі осылай жалғаса берсе, түсініксіз болады.
Dialogue: 0,0:01:33.42,0:01:35.46,Default,,0,0,0,,Арх! Апыр-ай!
Dialogue: 0,0:01:35.46,0:01:37.93,Default,,0,0,0,,Гаа! Широко-сенпай!
Dialogue: 0,0:01:37.93,0:01:39.93,Default,,0,0,0,,Ой! Маған қашуға рұқсат етіңіз!
Dialogue: 0,0:01:45.27,0:01:47.97,Default,,0,0,0,,Керемет! Нономи-сенпай! үй!
Dialogue: 0,0:01:50.61,0:01:53.41,Default,,0,0,0,,⚟Ұстаушы күштің жартысы жоғалып кетті!
Dialogue: 0,0:01:53.41,0:01:56.78,Default,,0,0,0,,Оқиға орнынан қосымша күштерді сұрау! Менің таңдауым жоқ.
Dialogue: 0,0:01:56.78,0:01:59.28,Default,,0,0,0,,Қосымша күштерді жіберіңіз! Қандай болса да➡
Dialogue: 0,0:01:59.28,0:02:01.85,Default,,0,0,0,,Оларды тоқтат!
Dialogue: 0,0:02:01.85,0:02:05.22,Default,,0,0,0,,Қақпа ашық! Бірақ жаудың күштері...
Dialogue: 0,0:02:08.09,0:02:10.46,Default,,0,0,0,,Жолымызды күштеп өткізейік. Эх! ?
Dialogue: 0,0:02:10.46,0:02:14.26,Default,,0,0,0,,Осылай жүрсек те жағдай өзгермейтіні рас...
Dialogue: 0,0:02:14.26,0:02:17.60,Default,,0,0,0,,Тым қауіпті! Уайымдаудың қажеті жоқ➡
Dialogue: 0,0:02:17.60,0:02:19.90,Default,,0,0,0,,Барлығы көмектеседі.
Dialogue: 0,0:02:19.90,0:02:22.60,Default,,0,0,0,,Дұрыс, Широко.
Dialogue: 0,0:02:22.60,0:02:25.44,Default,,0,0,0,,Хмм. Уф...
Dialogue: 0,0:02:25.44,0:02:28.98,Default,,0,0,0,,Аа... Шынымен де Широко-сенпай➡
Dialogue: 0,0:02:28.98,0:02:32.55,Default,,0,0,0,,Сіз сондай дөрекі боласыз!
Dialogue: 0,0:02:32.55,0:02:35.75,Default,,0,0,0,,Тыныш. Сіз шегіндіңіз бе?
Dialogue: 0,0:02:35.75,0:02:39.15,Default,,0,0,0,,Жоқ, мұны елестету қиын...
Dialogue: 0,0:02:39.15,0:02:42.26,Default,,0,0,0,,Сәлем! (Кайзер ПМК сарбаздары) Арх!
Dialogue: 0,0:02:42.26,0:02:44.26,Default,,0,0,0,,Жүр! Хмм.
Dialogue: 0,0:02:44.26,0:02:46.26,Default,,0,0,0,,Оны тоқтатыңыз!
Dialogue: 0,0:02:51.33,0:02:53.37,Default,,0,0,0,,Нашар! Қақпаны жабыңыз!
Dialogue: 0,0:02:53.37,0:02:55.54,Default,,0,0,0,,Мен саған рұқсат бермеймін!
Dialogue: 0,0:02:58.44,0:03:01.44,Default,,0,0,0,,Не! ? Гуаааа!
Dialogue: 0,0:03:03.98,0:03:05.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:09.42,0:03:11.79,Default,,0,0,0,,Қарғыс атсын... Жауап бер!
Dialogue: 0,0:03:11.79,0:03:14.59,Default,,0,0,0,,Бұл төтенше жағдай! Базаға шабуыл жасалды!
Dialogue: 0,0:03:14.59,0:03:16.96,Default,,0,0,0,,📱Қайталаңыз! Апаттық жағдай!
Dialogue: 0,0:03:16.96,0:03:19.59,Default,,0,0,0,,📱Базаға шабуыл жасалды! Ол бұзылды! ?
Dialogue: 0,0:03:19.59,0:03:22.26,Default,,0,0,0,,Директорлар қазір қайда? ?
Dialogue: 0,0:03:22.26,0:03:25.27,Default,,0,0,0,,Жағдай қандай? ? Ха, иә!
Dialogue: 0,0:03:25.27,0:03:27.60,Default,,0,0,0,,Зиянкестер алдыңғы қақпаны бұзып өтеді.
Dialogue: 0,0:03:27.60,0:03:30.24,Default,,0,0,0,,Қазіргі уақытта базаның ішінде ілгерілеуде.
Dialogue: 0,0:03:30.24,0:03:32.74,Default,,0,0,0,,Цк, сол Абыдос орта мектебінің жігіттері.
Dialogue: 0,0:03:32.74,0:03:35.44,Default,,0,0,0,,Енді қалдықтардың уақыты келді...
Dialogue: 0,0:03:35.44,0:03:38.11,Default,,0,0,0,,Біз не істеуіміз керек? Бірден қолдануға болатын күш - ➡
Dialogue: 0,0:03:38.11,0:03:40.45,Default,,0,0,0,,Қанша? Ха! Үшінші блоктан➡
Dialogue: 0,0:03:40.45,0:03:43.09,Default,,0,0,0,,Бесінші бірлік болса... Қалғандарына не болды? ?
Dialogue: 0,0:03:43.09,0:03:45.42,Default,,0,0,0,,Бұрынғы шайқаста жарақат алғандықтан...
Dialogue: 0,0:03:45.42,0:03:48.26,Default,,0,0,0,,Қарғыс атсын сендерге пайдасыз бейбақтар.
Dialogue: 0,0:03:48.26,0:03:50.59,Default,,0,0,0,,Тек сенімді болу үшін қайта тексеріңіз.
Dialogue: 0,0:03:50.59,0:03:52.96,Default,,0,0,0,,Мен өзімді сол машинаның прототипін жіберуге мәжбүр еттім➡
Dialogue: 0,0:03:52.96,0:03:55.26,Default,,0,0,0,,Мен жеңілсем де... Сөзсіз➡
Dialogue: 0,0:03:55.26,0:03:58.93,Default,,0,0,0,,Сіз адамдар туралы көп айта аласыз. Ей, ақымақ, сенен сұралады!
Dialogue: 0,0:03:58.93,0:04:03.44,Default,,0,0,0,,Қат! Бірақ қазір солтүстік әскерлерді шығару мүмкін емес...
Dialogue: 0,0:04:03.44,0:04:05.81,Default,,0,0,0,,Штабпен кеңесуді қалайсыз ба? Қажет емес!
Dialogue: 0,0:04:05.81,0:04:08.94,Default,,0,0,0,,Мен бұл туралы бірдеңе істеймін! Иә, түсінемін.
Dialogue: 0,0:04:08.94,0:04:11.78,Default,,0,0,0,,Расталған. Жағдай бұрынғыша➡
Dialogue: 0,0:04:11.78,0:04:14.25,Default,,0,0,0,,Мысалдағы жаппай өндірілген машина жұмыс істейтін деп аталады.
Dialogue: 0,0:04:14.25,0:04:17.12,Default,,0,0,0,,Иә, тез жөнелтейік!
Dialogue: 0,0:04:17.12,0:04:19.92,Default,,0,0,0,,Үшіншіден бесінші бірлікке дейін! Бұл нысанның қорғанысы ➡ болып табылады
Dialogue: 0,0:04:19.92,0:04:22.09,Default,,0,0,0,,Мен сәл қысқа боламын, бірақ бұл дұрыс па?
Dialogue: 0,0:04:22.09,0:04:25.59,Default,,0,0,0,,Маған бәрібір! Тек оларды тоқтатыңыз!
Dialogue: 0,0:04:28.26,0:04:30.67,Default,,0,0,0,,Хошино-сенпай жердің қай жерінде...?
Dialogue: 0,0:04:32.60,0:04:36.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:36.24,0:04:38.94,Default,,0,0,0,,Бұл үшінші бірлік. Дронды орналастырыңыз!
Dialogue: 0,0:04:38.94,0:04:42.41,Default,,0,0,0,,Оны әлі шығару мүмкін емес! ? 📱Қазір соңғы түзетулерден өтуде!
Dialogue: 0,0:04:42.41,0:04:45.91,Default,,0,0,0,,Асығыңыз! Бұл ұзаққа созылмайды!
Dialogue: 0,0:04:45.91,0:04:47.95,Default,,0,0,0,,Эй~!
Dialogue: 0,0:04:47.95,0:04:49.92,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:53.49,0:04:56.12,Default,,0,0,0,,Қарғыс атсын! Реттеу әлі аяқталған жоқ па? ?
Dialogue: 0,0:04:56.12,0:04:58.69,Default,,0,0,0,,📱Бұл командалар бөлмесі! Орналастыруға рұқсат!
Dialogue: 0,0:05:07.44,0:05:09.44,Default,,0,0,0,,Мен оны бұрын жеңдім...
Dialogue: 0,0:05:09.44,0:05:11.77,Default,,0,0,0,,Және өте көп...
Dialogue: 0,0:05:11.77,0:05:13.81,Default,,0,0,0,,Тек сонша адам➡
Dialogue: 0,0:05:13.81,0:05:15.98,Default,,0,0,0,,Қызық, ол қанша уақытқа созылады! ?
Dialogue: 0,0:05:19.41,0:05:22.08,Default,,0,0,0,,Жоқ... Қазіргі...
Dialogue: 0,0:05:22.08,0:05:25.59,Default,,0,0,0,,А, а... а, бұл менмін.
Dialogue: 0,0:05:25.59,0:05:27.99,Default,,0,0,0,,Ах, хехе... Жоқ! иә?
Dialogue: 0,0:05:27.99,0:05:30.03,Default,,0,0,0,,Мен Хифуми емеспін➡
Dialogue: 0,0:05:30.03,0:05:33.93,Default,,0,0,0,,Бұл Фауст!
Dialogue: 0,0:05:33.93,0:05:37.43,Default,,0,0,0,,Бәрібір басқаша! Мен Хифуми емеспін➡
Dialogue: 0,0:05:37.43,0:05:39.87,Default,,0,0,0,,Мен дәл осы жерден өтіп бара жатырмын.
Dialogue: 0,0:05:39.87,0:05:42.10,Default,,0,0,0,,Бұл Trinity академиясының граната мылтығы емес➡
Dialogue: 0,0:05:42.10,0:05:44.27,Default,,0,0,0,,Жоқ, қазір кім түсіргенін білмеймін➡
Dialogue: 0,0:05:44.27,0:05:46.74,Default,,0,0,0,,Мен де білмеймін, мұнда сіз де білмейсіз➡
Dialogue: 0,0:05:46.74,0:05:49.44,Default,,0,0,0,,Бұл бір-біріне мүлдем қатысы жоқ адамдар!
Dialogue: 0,0:05:49.44,0:05:52.31,Default,,0,0,0,,Дұрыс. Рахмет➡
Dialogue: 0,0:05:52.31,0:05:55.32,Default,,0,0,0,,Кішкентай Фауст! Ха, иә!
Dialogue: 0,0:05:55.32,0:05:59.42,Default,,0,0,0,,Олай болса, бәріңе!
Dialogue: 0,0:05:59.42,0:06:01.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:01.76,0:06:05.59,Default,,0,0,0,,Жарайсың... Әйтеуір, тез алға...
Dialogue: 0,0:06:05.59,0:06:09.26,Default,,0,0,0,,Егер сіз оны қысқартсаңыз, жеңе аласыз деп ойлайсыз ба? Ха! ?
Dialogue: 0,0:06:09.26,0:06:11.70,Default,,0,0,0,,Жәһанна тұрғындары! ?
Dialogue: 0,0:06:11.70,0:06:15.60,Default,,0,0,0,,О, құдайым. Бұл жай ғана сан.
Dialogue: 0,0:06:15.60,0:06:19.61,Default,,0,0,0,,Күткеніңізге рахмет. Қоғамдық мораль комитетіндегілердің бәрі...
Dialogue: 0,0:06:19.61,0:06:21.61,Default,,0,0,0,,Қарғыс атсын! Командалық бөлме Күшейтуді сұраңыз!
Dialogue: 0,0:06:21.61,0:06:23.61,Default,,0,0,0,,Қайталау. Күшейтуді сұраңыз! Директор, сіз не істейсіз?
Dialogue: 0,0:06:23.61,0:06:27.12,Default,,0,0,0,,Қарғыс атсын! Егер бұл орын алса➡
Dialogue: 0,0:06:27.12,0:06:29.78,Default,,0,0,0,,Қарудың барлық түрлерін жұмылдырыңыз!
Dialogue: 0,0:06:29.78,0:06:33.15,Default,,0,0,0,,Оларды бар күшіңізбен талқандаңыз➡
Dialogue: 0,0:06:33.15,0:06:37.26,Default,,0,0,0,,Бізге қарсы соғысқаныңыз үшін сізді өкіндіреміз!
Dialogue: 0,0:06:37.26,0:06:40.10,Default,,0,0,0,,Iori 2 сағат бағыты Дрон қондырғысы.
Dialogue: 0,0:06:40.10,0:06:42.06,Default,,0,0,0,,Жарайсың Ако-чан!
Dialogue: 0,0:06:42.06,0:06:44.60,Default,,0,0,0,,Сіз оны уақытында орындаған сияқтысыз.
Dialogue: 0,0:06:44.60,0:06:47.27,Default,,0,0,0,,Сен... Жау сөзсіз➡
Dialogue: 0,0:06:47.27,0:06:49.44,Default,,0,0,0,,Біз осында барамыз!
Dialogue: 0,0:06:49.44,0:06:51.77,Default,,0,0,0,,Хмф! Қанекей мынаны істейік!
Dialogue: 0,0:06:51.77,0:06:53.78,Default,,0,0,0,,Жарайсыңдар, кеттік!
Dialogue: 0,0:06:53.78,0:06:55.84,Default,,0,0,0,,Иә! иә! Түсінікті!
Dialogue: 0,0:06:55.84,0:06:58.95,Default,,0,0,0,,Жолыңызды ашыңыз!
Dialogue: 0,0:06:58.95,0:07:02.48,Default,,0,0,0,,Ой~!
Dialogue: 0,0:07:02.48,0:07:05.95,Default,,0,0,0,,Арх! Өтінемін, біраз ұйықтаңыз.
Dialogue: 0,0:07:08.79,0:07:12.96,Default,,0,0,0,,Қарғыс атсын... Мен де ұтыла алмаймын!
Dialogue: 0,0:07:12.96,0:07:14.93,Default,,0,0,0,,Тек жоғарыда болыңыз! иә!
Dialogue: 0,0:07:19.33,0:07:21.54,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:23.61,0:07:25.71,Default,,0,0,0,,Ха! иә!
Dialogue: 0,0:07:27.98,0:07:30.28,Default,,0,0,0,,Маған қалдырыңыз! Ах!
Dialogue: 0,0:07:30.28,0:07:32.81,Default,,0,0,0,,Түсіруге дайын! Барайық!
Dialogue: 0,0:07:32.81,0:07:45.59,Default,,0,0,0,,♬～
Dialogue: 0,0:07:45.59,0:07:47.60,Default,,0,0,0,,Оның пайдасы жоқ.
Dialogue: 0,0:07:49.80,0:07:52.13,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:07:52.13,0:07:54.40,Default,,0,0,0,,Ой~!
Dialogue: 0,0:07:56.94,0:07:58.94,Default,,0,0,0,,Мен сенің арқаңды қорғаймын.
Dialogue: 0,0:07:58.94,0:08:02.31,Default,,0,0,0,,Сіз Хошино Коториюге көмектесесіз бе?
Dialogue: 0,0:08:02.31,0:08:04.38,Default,,0,0,0,,Иә. Ах!
Dialogue: 0,0:08:04.38,0:08:06.95,Default,,0,0,0,,Қалған күш 50% төмендеді!
Dialogue: 0,0:08:06.95,0:08:08.95,Default,,0,0,0,,Мен мұнымен не істеу керек екенін білмеймін ...
Dialogue: 0,0:08:08.95,0:08:11.29,Default,,0,0,0,,Бұл енді мүмкін емес. Тек қалған күш➡
Dialogue: 0,0:08:11.29,0:08:13.29,Default,,0,0,0,,Мен көмектесе алмаймын... Гррх...
Dialogue: 0,0:08:13.29,0:08:15.26,Default,,0,0,0,,☎
Dialogue: 0,0:08:15.26,0:08:17.93,Default,,0,0,0,,Ха! иә. Директор: Мен штабтан хабарлама алдым...
Dialogue: 0,0:08:17.93,0:08:20.46,Default,,0,0,0,,Хмм, мені елеме! Қосылу қажет емес!
Dialogue: 0,0:08:20.46,0:08:23.33,Default,,0,0,0,,Сонда мен не айтуым керек? Қайтадан алаңнан директор➡
Dialogue: 0,0:08:23.33,0:08:27.10,Default,,0,0,0,,Күшейтуді сұрау! не! ? 3-ші блок 5 жойылды!
Dialogue: 0,0:08:27.10,0:08:29.97,Default,,0,0,0,,Уф! Қалған күш 30%!
Dialogue: 0,0:08:29.97,0:08:32.31,Default,,0,0,0,,⚟Не істейсіз, директор? ? ⚟Уақыт! ⚟Әлі жоқ! ?
Dialogue: 0,0:08:32.31,0:08:34.31,Default,,0,0,0,,⚟Асығыңыз! ⚟Не болып жатыр! ?
Dialogue: 0,0:08:34.31,0:08:36.78,Default,,0,0,0,,⚟Тез шешім қабылдаңыз! ⚟Бізге нұсқаулар беріңізші! ⚟Осы қарқынмен!
Dialogue: 0,0:08:36.78,0:08:39.45,Default,,0,0,0,,⚟Күшейту! ⚟Асығыңыздар! Аа….
Dialogue: 0,0:08:39.45,0:08:41.82,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:41.82,0:08:43.82,Default,,0,0,0,,Умм, жауап...
Dialogue: 0,0:08:43.82,0:08:46.86,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:08:46.86,0:08:48.76,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:48.76,0:08:53.29,Default,,0,0,0,,Менің өз қолыммен сендер ғана жеңесіңдер.
Dialogue: 0,0:08:53.29,0:08:55.66,Default,,0,0,0,,Мен кетемін!
Dialogue: 0,0:08:55.66,0:08:58.13,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:09:02.27,0:09:04.31,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:09:04.31,0:09:06.84,Default,,0,0,0,,Бұл тақта, солай ма?
Dialogue: 0,0:09:06.84,0:09:09.38,Default,,0,0,0,,Уф. Оның үстіне➡
Dialogue: 0,0:09:09.38,0:09:12.78,Default,,0,0,0,,Біраз ғана таныс нәрселер бар сияқты...
Dialogue: 0,0:09:12.78,0:09:14.95,Default,,0,0,0,,Мектеп... солай ма?
Dialogue: 0,0:09:14.95,0:09:17.25,Default,,0,0,0,,Осындай шөл даланың ортасында?
Dialogue: 0,0:09:20.32,0:09:22.96,Default,,0,0,0,,А, бұл болуы мүмкін...
Dialogue: 0,0:09:22.96,0:09:25.63,Default,,0,0,0,,Ах. Сіз оны болжадыңыз.
Dialogue: 0,0:09:25.63,0:09:29.33,Default,,0,0,0,,Бұл бұрынғы Абыдос орта мектебі➡
Dialogue: 0,0:09:29.33,0:09:31.27,Default,,0,0,0,,Бұл басты ғимарат.
Dialogue: 0,0:09:31.27,0:09:35.77,Default,,0,0,0,,Сіз... Соңына дейін табандысыз➡
Dialogue: 0,0:09:35.77,0:09:38.21,Default,,0,0,0,,Abydos жұмыс тобы.
Dialogue: 0,0:09:38.21,0:09:40.78,Default,,0,0,0,,Мен Хошино-сенпайды қайтару үшін келдім!
Dialogue: 0,0:09:40.78,0:09:43.45,Default,,0,0,0,,Ей, көңіліңді көтеру үшін мен сені қанша мазалауым керек?
Dialogue: 0,0:09:43.45,0:09:45.81,Default,,0,0,0,,Кетіңіз! Әйтпесе...
Dialogue: 0,0:09:45.81,0:09:51.59,Default,,0,0,0,,Жұмыс тобы... Балалар, сендер әрқашан көздің жауын аларсыңдар.
Dialogue: 0,0:09:51.59,0:09:55.76,Default,,0,0,0,,Осы уақытқа дейін біз барлық мүмкіндікті қолданып көрдік...
Dialogue: 0,0:09:55.76,0:09:58.43,Default,,0,0,0,,Хмм…. Сонда да, балалар➡
Dialogue: 0,0:09:58.43,0:10:01.40,Default,,0,0,0,,Өліп бара жатқан мектепте соңына дейін қалу➡
Dialogue: 0,0:10:01.40,0:10:05.60,Default,,0,0,0,,Қайта-қайта қарызды өтей алмай қиналады...
Dialogue: 0,0:10:05.60,0:10:07.94,Default,,0,0,0,,Мен сені сонша жазаласам да...
Dialogue: 0,0:10:07.94,0:10:10.61,Default,,0,0,0,,Мен сені қатты қинадым!
Dialogue: 0,0:10:10.61,0:10:13.51,Default,,0,0,0,,Әр күніңіз көңілді өтсін!
Dialogue: 0,0:10:13.51,0:10:16.08,Default,,0,0,0,,Жоспардың бәрі сіздің арқаңызда!
Dialogue: 0,0:10:16.08,0:10:18.95,Default,,0,0,0,,Менің жоспарым~!
Dialogue: 0,0:10:18.95,0:10:21.42,Default,,0,0,0,,Мұндай сұмдық, таяз ойлар➡
Dialogue: 0,0:10:21.42,0:10:23.59,Default,,0,0,0,,Біздің жүрегіміз бағынбайды!
Dialogue: 0,0:10:23.59,0:10:26.12,Default,,0,0,0,,Хошино-сенпай қайтып оралсын.
Dialogue: 0,0:10:26.12,0:10:28.09,Default,,0,0,0,,Мен жеңілмеймін. Сіз сияқты➡
Dialogue: 0,0:10:28.09,0:10:31.53,Default,,0,0,0,,Әлбетте аянышты ересектер үшін емес!
Dialogue: 0,0:10:31.53,0:10:34.26,Default,,0,0,0,,Бұл сізді одан әрі мазалайды ма?
Dialogue: 0,0:10:34.26,0:10:38.10,Default,,0,0,0,,Мен бұл затты тез табуым керек!
Dialogue: 0,0:10:38.10,0:10:41.44,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды білмеймін, бірақ мен сені ол жерден алып кетемін!
Dialogue: 0,0:10:41.44,0:10:44.61,Default,,0,0,0,,Хехехе…. Қолыңыздан келсе➡
Dialogue: 0,0:10:44.61,0:10:47.24,Default,,0,0,0,,Байқап көріңіз!
Dialogue: 0,0:10:47.24,0:10:50.78,Default,,0,0,0,,Уа! Сондай-ақ! ?
Dialogue: 0,0:10:50.78,0:10:53.11,Default,,0,0,0,,Сіз қиындыққа тап болған сияқтысыз!
Dialogue: 0,0:10:53.11,0:10:56.68,Default,,0,0,0,,Хмм….
Dialogue: 0,0:10:56.68,0:10:58.59,Default,,0,0,0,,Yaho! Эй, кешіріңіз.
Dialogue: 0,0:10:58.59,0:11:02.42,Default,,0,0,0,,Ұстаушы 68! ?
Dialogue: 0,0:11:02.42,0:11:05.26,Default,,0,0,0,,Осындай шымшуда тез көріну маңызды➡
Dialogue: 0,0:11:05.26,0:11:07.26,Default,,0,0,0,,Бірінші дәрежелі заңсыздық.
Dialogue: 0,0:11:07.26,0:11:10.93,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:11:10.93,0:11:13.10,Default,,0,0,0,,Кешіріңіз, бұл құлап жатыр.
Dialogue: 0,0:11:13.10,0:11:16.94,Default,,0,0,0,,Аа... Не... Бұл не?
Dialogue: 0,0:11:16.94,0:11:18.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:24.75,0:11:29.08,Default,,0,0,0,,Ал... Балалар...
Dialogue: 0,0:11:29.08,0:11:32.25,Default,,0,0,0,,Сіз әлі... Ах.
Dialogue: 0,0:11:32.25,0:11:36.42,Default,,0,0,0,,Жұмысымыз көп болса да, осында келуге қиналдың ба?
Dialogue: 0,0:11:36.42,0:11:38.93,Default,,0,0,0,,Салқын болуға тырысып, бір рет бас тартсам да.
Dialogue: 0,0:11:38.93,0:11:40.93,Default,,0,0,0,,Олай айтпа!
Dialogue: 0,0:11:40.93,0:11:44.43,Default,,0,0,0,,Хуфуфуфу. Аль-Чан өте мейірімді.
Dialogue: 0,0:11:44.43,0:11:47.94,Default,,0,0,0,,Уф... Әйтеуір➡
Dialogue: 0,0:11:47.94,0:11:51.27,Default,,0,0,0,,Мұны бізге қалдырыңыз да, алдымен барыңыз!
Dialogue: 0,0:11:51.27,0:11:54.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:54.61,0:11:56.61,Default,,0,0,0,,《Мен айттым~! 》
Dialogue: 0,0:11:56.61,0:11:59.95,Default,,0,0,0,,Уау, мағынасы бар, Аль-чан.
Dialogue: 0,0:11:59.95,0:12:03.75,Default,,0,0,0,,Күтілгендей! Мен сенің соңынан еремін, Аль мырза!
Dialogue: 0,0:12:03.75,0:12:06.32,Default,,0,0,0,,Га. барайық.
Dialogue: 0,0:12:06.32,0:12:10.76,Default,,0,0,0,,Иә. О, мен саған рахмет айтпаймын!
Dialogue: 0,0:12:10.76,0:12:15.63,Default,,0,0,0,,Бірақ бәрі біткен соң, бірге рамен жейміз!
Dialogue: 0,0:12:15.63,0:12:18.70,Default,,0,0,0,,Бұл жақсылық міндетті түрде бағаланады! көп рахмет!
Dialogue: 0,0:12:23.27,0:12:25.24,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:12:28.11,0:12:30.58,Default,,0,0,0,,Нуаа!
Dialogue: 0,0:12:30.58,0:12:34.98,Default,,0,0,0,,Сәлем! А... Бұлай болса, көмектесе алмаймын деп ойлаймын.
Dialogue: 0,0:12:34.98,0:12:37.09,Default,,0,0,0,,О, неткен кездейсоқтық.
Dialogue: 0,0:12:37.09,0:12:40.59,Default,,0,0,0,,нені білдіреді, Кайоко? Бұл қандай өрнек?
Dialogue: 0,0:12:40.59,0:12:43.42,Default,,0,0,0,,Бөлек. Мен көмектесуге келдім.
Dialogue: 0,0:12:43.42,0:12:47.76,Default,,0,0,0,,Ешкім зардап шеккен жоқ, солай ма? Мен мұны жеңуім керек пе?
Dialogue: 0,0:12:47.76,0:12:50.10,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:12:50.10,0:12:52.60,Default,,0,0,0,,Уау, мен де саған көмектесемін!
Dialogue: 0,0:12:52.60,0:12:57.27,Default,,0,0,0,,Қат! Бәрің, жолдан кетіңдер!
Dialogue: 0,0:12:57.27,0:13:00.27,Default,,0,0,0,,Ахахха... қызық болып барады➡
Dialogue: 0,0:13:00.27,0:13:04.71,Default,,0,0,0,,Аль-чан! Ал, бастайық!
Dialogue: 0,0:13:04.71,0:13:07.78,Default,,0,0,0,,Иә. Сіздің қарсыласыңыз...
Dialogue: 0,0:13:10.95,0:13:13.12,Default,,0,0,0,,Бұл біз!
Dialogue: 0,0:13:20.19,0:13:23.93,Default,,0,0,0,,《Хошино: Қазір бәрінің жағдайы қалай екен.
Dialogue: 0,0:13:23.93,0:13:27.30,Default,,0,0,0,,Ешқандай кеңессіз жоғалып кеттім➡
Dialogue: 0,0:13:27.30,0:13:30.10,Default,,0,0,0,,Менде кек бар ма екен...
Dialogue: 0,0:13:30.10,0:13:35.28,Default,,0,0,0,,Соңында Kaiser Corporation-мен қол қойған келісімшарт елеусіз қалды➡
Dialogue: 0,0:13:35.28,0:13:38.08,Default,,0,0,0,,Абыдосқа шабуыл жасалды.
Dialogue: 0,0:13:38.08,0:13:41.58,Default,,0,0,0,,Менің барлық шешімдерім бекер болды.
Dialogue: 0,0:13:46.92,0:13:50.79,Default,,0,0,0,,《Мүмкін, басқа жолы бар шығар.
Dialogue: 0,0:13:50.79,0:13:54.93,Default,,0,0,0,,Соңында қате таңдау жасадым➡
Dialogue: 0,0:13:54.93,0:13:57.60,Default,,0,0,0,,Қала және мектеп...》
Dialogue: 0,0:14:00.60,0:14:05.97,Default,,0,0,0,,《Нономи-чан, сен әлі күліп жүрсің бе деп ойлаймын.
Dialogue: 0,0:14:05.97,0:14:10.61,Default,,0,0,0,,Сіз мені қайта-қайта дүкенге шақырдыңыз...
Dialogue: 0,0:14:10.61,0:14:12.95,Default,,0,0,0,,Қанша бас тартсам да, берілме➡
Dialogue: 0,0:14:12.95,0:14:16.92,Default,,0,0,0,,Бітелген қолымды тартып алдың.
Dialogue: 0,0:14:16.92,0:14:20.92,Default,,0,0,0,,Сол кезде бұл мені бәрінен де бақытты етті.
Dialogue: 0,0:14:23.59,0:14:28.10,Default,,0,0,0,,《Селика-чан... Ол әдетте салмақты және қатал➡
Dialogue: 0,0:14:28.10,0:14:32.43,Default,,0,0,0,,Мен мектепте ұйықтасам, сен мені оятуға келдің.
Dialogue: 0,0:14:32.43,0:14:35.10,Default,,0,0,0,,Толық емес жұмыс күндерімде оянамын ➡
Dialogue: 0,0:14:35.10,0:14:38.47,Default,,0,0,0,,Сіз мені күттіңіз бе?
Dialogue: 0,0:14:38.47,0:14:43.14,Default,,0,0,0,,Мені сондай ебедейсіз мейірімділік қолдады.
Dialogue: 0,0:14:45.25,0:14:48.12,Default,,0,0,0,,《Аяне-чан. Жақсы емес менің орнымда➡
Dialogue: 0,0:14:48.12,0:14:50.65,Default,,0,0,0,,Барлығын біріктіргені үшін➡
Dialogue: 0,0:14:50.65,0:14:54.42,Default,,0,0,0,,Ол қарыз мәселесіне де мән берді.
Dialogue: 0,0:14:54.42,0:14:56.92,Default,,0,0,0,,Ағымдағы жұмыс тобы ➡
Dialogue: 0,0:14:56.92,0:14:58.89,Default,,0,0,0,,Соның арқасында деп ойлаймын.
Dialogue: 0,0:15:00.93,0:15:03.77,Default,,0,0,0,,《Және Широко-чан.
Dialogue: 0,0:15:03.77,0:15:08.67,Default,,0,0,0,,Есте сақтау қабілетінен айырылып, оңды-солды білмейтін Широко-чан туралы ➡
Dialogue: 0,0:15:08.67,0:15:11.57,Default,,0,0,0,,Мен бұл туралы көптен бері ойлап жүрдім, бірақ➡
Dialogue: 0,0:15:11.57,0:15:14.94,Default,,0,0,0,,Мен білмей тұрып, керісінше болды ма деп ойлаймын.
Dialogue: 0,0:15:14.94,0:15:17.11,Default,,0,0,0,,Аквариумдағы сол сөз➡
Dialogue: 0,0:15:17.11,0:15:20.48,Default,,0,0,0,,Мен шынымен бақытты болдым.
Dialogue: 0,0:15:20.48,0:15:25.92,Default,,0,0,0,,Барлығы сонда болғандықтан, мен мектептегі өмірімді тыныштықпен өткізе алдым➡
Dialogue: 0,0:15:25.92,0:15:29.59,Default,,0,0,0,,Әйтеуір алға ұмтыла бердім.
Dialogue: 0,0:15:29.59,0:15:34.46,Default,,0,0,0,,Барлығына рахмет, мен күліп жүре алдым.
Dialogue: 0,0:15:34.46,0:15:39.27,Default,,0,0,0,,Сол жерде Юме-сенпай мені тастап кетті...》
Dialogue: 0,0:15:39.27,0:15:43.14,Default,,0,0,0,,Бірақ бұл да міндетті түрде жойылады.
Dialogue: 0,0:15:43.14,0:15:46.91,Default,,0,0,0,,Мен қате таңдау жасадым...
Dialogue: 0,0:15:46.91,0:15:51.45,Default,,0,0,0,,Мен онымен дұрыс бетпе-бет келгенде бәрі өзгерер ме еді деп ойлаймын.
Dialogue: 0,0:15:51.45,0:15:55.85,Default,,0,0,0,,Үлкен кісіге алданбай тұрып басқа әдісті ойласам ғой➡
Dialogue: 0,0:15:55.85,0:16:00.25,Default,,0,0,0,,Абыдостың басынан мұндай оқиға болған жоқ па деп ойлаймын.
Dialogue: 0,0:16:00.25,0:16:04.63,Default,,0,0,0,,Менің қабілетім жетпейді, жақсы жол таба алмаймын...
Dialogue: 0,0:16:04.63,0:16:08.93,Default,,0,0,0,,Ақырында мен ештеңе шешкен жоқпын.
Dialogue: 0,0:16:08.93,0:16:12.80,Default,,0,0,0,,Мен жақсырақ таңдау жасасам...
Dialogue: 0,0:16:12.80,0:16:17.61,Default,,0,0,0,,Сонда мен саған зиян тигізбейтініне сенімдімін.
Dialogue: 0,0:16:17.61,0:16:21.28,Default,,0,0,0,,Мектеп және барлығы➡
Dialogue: 0,0:16:21.28,0:16:24.45,Default,,0,0,0,,Юме-сенпай да...
Dialogue: 0,0:16:24.45,0:16:28.42,Default,,0,0,0,,Бәріне менің кінәм...
Dialogue: 0,0:16:28.42,0:16:31.09,Default,,0,0,0,,Мен неге қателестім деп ойлаймын.
Dialogue: 0,0:16:31.09,0:16:34.09,Default,,0,0,0,,Мен неге оған адал сене алмадым деп ойлаймын.
Dialogue: 0,0:16:34.09,0:16:37.26,Default,,0,0,0,,Сіз соншалықты қамқорлық жасасаңыз да...
Dialogue: 0,0:16:37.26,0:16:39.66,Default,,0,0,0,,Кешіріңіз, Широко-чан.
Dialogue: 0,0:16:43.76,0:16:47.20,Default,,0,0,0,,Нана... Нана... Бұл не? ?
Dialogue: 0,0:16:47.20,0:16:50.10,Default,,0,0,0,,Фухахаха... Егер бұл орын алса➡
Dialogue: 0,0:16:50.10,0:16:52.11,Default,,0,0,0,,Бірге тірідей жерленген... Бір сәт➡
Dialogue: 0,0:16:52.11,0:16:56.11,Default,,0,0,0,,Мен үшін не істей аласың! Жарайды ма?
Dialogue: 0,0:16:56.11,0:16:58.61,Default,,0,0,0,,Цк, шын айтасың ба? барлығы….
Dialogue: 0,0:17:00.75,0:17:05.15,Default,,0,0,0,,《Хина: асығыңыз, жұмыс тобы》
Dialogue: 0,0:17:05.15,0:17:07.76,Default,,0,0,0,,Ток шайқауы қандай?
Dialogue: 0,0:17:07.76,0:17:09.96,Default,,0,0,0,,Одан гөрі қазір асығуымыз керек!
Dialogue: 0,0:17:09.96,0:17:11.93,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:16.60,0:17:20.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:20.27,0:17:22.44,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:17:22.44,0:17:24.44,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:17:24.44,0:17:26.44,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:17:32.65,0:17:34.72,Default,,0,0,0,,Барлығы….
Dialogue: 0,0:17:40.25,0:17:42.76,Default,,0,0,0,,｟Юме: Эй, Хошино-чан.
Dialogue: 0,0:17:42.76,0:17:46.29,Default,,0,0,0,,Мен, Хошино-чанмен➡ алғаш танысқан кезде
Dialogue: 0,0:17:46.29,0:17:49.10,Default,,0,0,0,,Мен бұл арман шығар деп ойладым➡
Dialogue: 0,0:17:49.10,0:17:51.77,Default,,0,0,0,,Бетіңізден талай рет шымшып алдым.
Dialogue: 0,0:17:51.77,0:17:54.77,Default,,0,0,0,,Хошино-чан сияқты сүйкімді және күшті➡
Dialogue: 0,0:17:54.77,0:17:57.27,Default,,0,0,0,,Жаныңда сенімді кішінің болуы➡
Dialogue: 0,0:17:57.27,0:18:00.78,Default,,0,0,0,,Түс сияқты болғанына шын қуанамын...
Dialogue: 0,0:18:00.78,0:18:03.28,Default,,0,0,0,,Иә? Хмм➡
Dialogue: 0,0:18:03.28,0:18:06.58,Default,,0,0,0,,Мен оны жақсы түсіндірмеген шығармын, бірақ...
Dialogue: 0,0:18:06.58,0:18:10.08,Default,,0,0,0,,Хошино-чанмен осылай бола алу➡
Dialogue: 0,0:18:10.08,0:18:14.02,Default,,0,0,0,,Бұл мен үшін ғажайып сияқты.
Dialogue: 0,0:18:14.02,0:18:18.09,Default,,0,0,0,,Біз күнде осылай біргеміз, солай емес пе?
Dialogue: 0,0:18:18.09,0:18:20.63,Default,,0,0,0,,Кеше, бүгін және ертең.
Dialogue: 0,0:18:20.63,0:18:23.93,Default,,0,0,0,,Мұндай айқын нәрсенің әсірелеуі қандай?
Dialogue: 0,0:18:23.93,0:18:26.43,Default,,0,0,0,,Аа... өйткені...
Dialogue: 0,0:18:26.43,0:18:28.90,Default,,0,0,0,,Ғажайыптар одан да керемет➡
Dialogue: 0,0:18:28.90,0:18:31.44,Default,,0,0,0,,Бұл сирек кездесетін нәрсе туралы.
Dialogue: 0,0:18:31.44,0:18:33.74,Default,,0,0,0,,Жоқ, Хошино-чан.
Dialogue: 0,0:18:33.74,0:18:36.24,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:18:36.24,0:18:40.28,Default,,0,0,0,,Бұл не? Кенеттен. Сәлем Хошино-чан➡
Dialogue: 0,0:18:40.28,0:18:43.92,Default,,0,0,0,,Егер Хошино-чанның бір күні сүйкімді кіші қызы болса➡
Dialogue: 0,0:18:43.92,0:18:46.12,Default,,0,0,0,,Бұл жағдайда...｠
Dialogue: 0,0:18:48.92,0:18:51.43,Default,,0,0,0,,《Юме-сенпай...
Dialogue: 0,0:18:51.43,0:18:53.93,Default,,0,0,0,,Өйткені мен ақымақпын➡
Dialogue: 0,0:18:53.93,0:18:58.60,Default,,0,0,0,,Осы оқиғадан кейін мен оның нені білдіретінін түсіндім.
Dialogue: 0,0:18:58.60,0:19:01.67,Default,,0,0,0,,Мен енді ешқашан қателеспеймін.
Dialogue: 0,0:19:04.11,0:19:08.41,Default,,0,0,0,,《Мен қателікті қайта жасағым келмейді.
Dialogue: 0,0:19:08.41,0:19:11.25,Default,,0,0,0,,Мен үшін керемет...》
Dialogue: 0,0:19:11.25,0:19:15.08,Default,,0,0,0,,Жұмыс тобының барлық мүшелері!
Dialogue: 0,0:19:15.08,0:19:17.08,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:19:24.59,0:19:28.43,Default,,0,0,0,,《Нономи-чан Селика-чан….
Dialogue: 0,0:19:28.43,0:19:33.10,Default,,0,0,0,,Аяне-чан Широко-чан….
Dialogue: 0,0:19:33.10,0:19:35.10,Default,,0,0,0,,I...》
Dialogue: 0,0:19:43.11,0:19:45.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:45.78,0:19:47.75,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:19:52.19,0:19:55.62,Default,,0,0,0,,Ах! Бұл...
Dialogue: 0,0:19:55.62,0:20:18.95,Default,,0,0,0,,♬～
Dialogue: 0,0:20:18.95,0:20:21.12,Default,,0,0,0,,Широко-чан…. иә….
Dialogue: 0,0:20:25.92,0:20:28.92,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:20:28.92,0:20:31.49,Default,,0,0,0,,Иә? Қалай….
Dialogue: 0,0:20:31.49,0:20:33.56,Default,,0,0,0,,Өйткені мен...
Dialogue: 0,0:20:33.56,0:20:35.83,Default,,0,0,0,,Бұл соңғы минут болды. иә?
Dialogue: 0,0:20:41.77,0:20:45.17,Default,,0,0,0,,көремін. Барлығы...
Dialogue: 0,0:20:45.17,0:20:48.21,Default,,0,0,0,,Мұғалім, ересек...
Dialogue: 0,0:20:48.21,0:20:51.11,Default,,0,0,0,,Барлығының уайымдағанына сене алар емеспін➡
Dialogue: 0,0:20:51.11,0:20:53.61,Default,,0,0,0,,Мен ойлаймын. Ухехе….
Dialogue: 0,0:20:53.61,0:20:55.98,Default,,0,0,0,,Кешіріңіз. Ой ➡
Dialogue: 0,0:20:55.98,0:20:58.25,Default,,0,0,0,,Қайтадан қош келдіңіз! Хошино-сенпай!
Dialogue: 0,0:20:58.25,0:21:00.92,Default,,0,0,0,,Ах! Бұл алдау, Селика-чан!
Dialogue: 0,0:21:00.92,0:21:03.26,Default,,0,0,0,,Мен саған айтпаймын дедім, себебі бұл ұят болды!
Dialogue: 0,0:21:03.26,0:21:06.89,Default,,0,0,0,,Уф, бұл шу! Жақсы!
Dialogue: 0,0:21:06.89,0:21:09.23,Default,,0,0,0,,Хошино.
Dialogue: 0,0:21:09.23,0:21:12.60,Default,,0,0,0,,Қайтадан қош келдіңіз. Хошино-сенпай, қайта қош келдіңіз!
Dialogue: 0,0:21:12.60,0:21:15.24,Default,,0,0,0,,Қайтадан қош келдіңіз!
Dialogue: 0,0:21:15.24,0:21:17.64,Default,,0,0,0,,Қош келдіңіз, Хошино-сенпай.
Dialogue: 0,0:21:20.74,0:21:23.41,Default,,0,0,0,,Аха….
Dialogue: 0,0:21:23.41,0:21:27.31,Default,,0,0,0,,《Ойлап қарасам, осындай жылы сөздер еді➡
Dialogue: 0,0:21:27.31,0:21:29.48,Default,,0,0,0,,Юме Сенпай》
Dialogue: 0,0:21:34.42,0:21:37.73,Default,,0,0,0,,Неге екені белгісіз, әркімнің сөз саптауы күтуге толы еді...
Dialogue: 0,0:21:37.73,0:21:40.23,Default,,0,0,0,,Іздегеніңіз осы ма?
Dialogue: 0,0:21:40.23,0:21:43.76,Default,,0,0,0,,О, қазірдің өзінде! Білсең мені мазақтама!
Dialogue: 0,0:21:43.76,0:21:46.73,Default,,0,0,0,,Дұрыс. Бұл Хошино-сенпайдың аузынан➡
Dialogue: 0,0:21:46.73,0:21:49.67,Default,,0,0,0,,Мен оны есту үшін осынша жолмен келдім.
Dialogue: 0,0:21:49.67,0:21:51.61,Default,,0,0,0,,Nihe….
Dialogue: 0,0:21:51.61,0:21:55.48,Default,,0,0,0,,Менің сүйкімді жасөспірімдерімнен өтініш➡
Dialogue: 0,0:21:55.48,0:21:57.68,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:22:00.41,0:22:03.75,Default,,0,0,0,,Мен үйдемін.
Dialogue: 0,0:22:03.75,0:22:05.92,Default,,0,0,0,,Хошино-сенпай! Апыр-ай!
Dialogue: 0,0:22:05.92,0:22:09.82,Default,,0,0,0,,Хаха... Олай болса, үйге қайтайық.
Dialogue: 0,0:22:09.82,0:22:13.23,Default,,0,0,0,,Иә. біздің мектепке.
Dialogue: 0,0:22:14.73,0:22:20.73,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
