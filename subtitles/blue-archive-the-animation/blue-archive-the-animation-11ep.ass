Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.13,0:00:04.13,Default,,0,0,0,,Бұл Хошиноның смартфоны ма?
Dialogue: 0,0:00:04.13,0:00:07.00,Default,,0,0,0,,Иә. Хошиноның қай жерде екенін анықтауыңызды қалаймын.
Dialogue: 0,0:00:07.00,0:00:10.51,Default,,0,0,0,,Уау, түсіндім! сәл күте тұрыңыз.
Dialogue: 0,0:00:18.48,0:00:20.82,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:00:20.82,0:00:22.82,Default,,0,0,0,,№.
Dialogue: 0,0:00:22.82,0:00:26.62,Default,,0,0,0,,Мен Федералдық студенттік кеңестің орталық желісіне кіруге тырыстым➡
Dialogue: 0,0:00:26.62,0:00:29.29,Default,,0,0,0,,Ағымдағы орынды анықтау мүмкін емес.
Dialogue: 0,0:00:29.29,0:00:34.30,Default,,0,0,0,,Мен көремін. Мен бір анықтама таба аламын деп үміттенемін ...
Dialogue: 0,0:00:34.30,0:00:37.97,Default,,0,0,0,,Ал...
Dialogue: 0,0:00:37.97,0:00:40.80,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:00:43.14,0:00:46.64,Default,,0,0,0,,Кім? Мүмкін Хошино! ?
Dialogue: 0,0:00:49.14,0:00:51.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:56.32,0:00:59.32,Default,,0,0,0,,Мм... Ах.
Dialogue: 0,0:00:59.32,0:01:01.29,Default,,0,0,0,,Не?
Dialogue: 0,0:01:04.23,0:01:06.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:59.14,0:03:01.14,Default,,0,0,0,,Мұнда?
Dialogue: 0,0:03:42.82,0:03:45.69,Default,,0,0,0,,Бұл қабатта жақсы болуы керек.
Dialogue: 0,0:03:47.79,0:03:50.29,Default,,0,0,0,,Біз сізді күттік, сэр.
Dialogue: 0,0:03:50.29,0:03:53.76,Default,,0,0,0,,Уф! Мен сені бір рет осылай кездестірдім➡
Dialogue: 0,0:03:53.76,0:03:57.13,Default,,0,0,0,,Мен сенімен бетпе-бет сөйлескім келді.
Dialogue: 0,0:03:57.13,0:04:00.64,Default,,0,0,0,,Федерация Студенттер кеңесінің президенті шақырған жұмбақ оқиға.
Dialogue: 0,0:04:00.64,0:04:04.61,Default,,0,0,0,,Федералдық тергеу бюросы Петри табақшасының мұғалімі.
Dialogue: 0,0:04:04.61,0:04:07.31,Default,,0,0,0,,Кук-кук….
Dialogue: 0,0:04:07.31,0:04:10.45,Default,,0,0,0,,Уайымдамаңыз. біз сенімен біргеміз➡
Dialogue: 0,0:04:10.45,0:04:12.78,Default,,0,0,0,,Менің дұшпандық ниетім жоқ.
Dialogue: 0,0:04:12.78,0:04:14.95,Default,,0,0,0,,Мен ынтымақтастықты қалаймын.
Dialogue: 0,0:04:14.95,0:04:18.35,Default,,0,0,0,,Біз үшін Абыдос шағын мектеп➡
Dialogue: 0,0:04:18.35,0:04:21.09,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:04:21.09,0:04:24.76,Default,,0,0,0,,Бірақ, сэр, сіз басқасыз.
Dialogue: 0,0:04:24.76,0:04:28.63,Default,,0,0,0,,Мен саған өте сақпын.
Dialogue: 0,0:04:28.63,0:04:31.43,Default,,0,0,0,,Сен кімсің? Ой➡
Dialogue: 0,0:04:31.43,0:04:35.44,Default,,0,0,0,,Айтпақшы, өзіңізді таныстырған жоқсыз ба?
Dialogue: 0,0:04:35.44,0:04:37.81,Default,,0,0,0,,Ал, мен туралы➡
Dialogue: 0,0:04:37.81,0:04:40.61,Default,,0,0,0,,«Қара киім» деп те аталады.
Dialogue: 0,0:04:40.61,0:04:42.58,Default,,0,0,0,,Маған бұл есім ұнайды.
Dialogue: 0,0:04:45.08,0:04:48.12,Default,,0,0,0,,Біз де сен сияқтымыз.
Dialogue: 0,0:04:48.12,0:04:51.02,Default,,0,0,0,,Дәл солай ма? Иә, дәл солай.
Dialogue: 0,0:04:51.02,0:04:53.29,Default,,0,0,0,,Кивотос сыртындағылар.
Dialogue: 0,0:04:53.29,0:04:58.63,Default,,0,0,0,,Дегенмен, мен сізден басқа саладамын.
Dialogue: 0,0:04:58.63,0:05:03.27,Default,,0,0,0,,«Гематрия»… оны осылай атаңыз.
Dialogue: 0,0:05:03.27,0:05:06.27,Default,,0,0,0,,Өз сөзіңізбен түсіндіргіңіз келсе➡
Dialogue: 0,0:05:06.27,0:05:10.61,Default,,0,0,0,,«Мен тиесілі ұйым» сияқты нәрсе ме?
Dialogue: 0,0:05:10.61,0:05:16.61,Default,,0,0,0,,Гематрия бақылайды, зерттейді, зерттейді.
Dialogue: 0,0:05:16.61,0:05:18.95,Default,,0,0,0,,Осы тұрғыдан қарасаңыз, сізбен бірдей➡
Dialogue: 0,0:05:18.95,0:05:23.45,Default,,0,0,0,,Оны түсініксіз болмыс ретінде қарастыруға болады.
Dialogue: 0,0:05:23.45,0:05:26.59,Default,,0,0,0,,Айтпақшы, сізден бірнәрсе сұрайын➡
Dialogue: 0,0:05:26.59,0:05:29.42,Default,,0,0,0,,Бізбен ынтымақтасқыңыз келмей ме?
Dialogue: 0,0:05:29.42,0:05:32.76,Default,,0,0,0,,Бас тарту. заң.
Dialogue: 0,0:05:32.76,0:05:36.77,Default,,0,0,0,,Сіз бұл ұсыныстан бас тартсаңыз да, шындық пен құпияны ала аласыз➡
Dialogue: 0,0:05:36.77,0:05:40.77,Default,,0,0,0,,Кивотоспен не істегіңіз келеді?
Dialogue: 0,0:05:40.77,0:05:44.44,Default,,0,0,0,,Мен жаңа ғана Хошиноны қайтаруға келдім.
Dialogue: 0,0:05:44.44,0:05:48.11,Default,,0,0,0,,Куккуккук…. Енді қандай құқықтарыңыз бар?
Dialogue: 0,0:05:48.11,0:05:50.91,Default,,0,0,0,,Сіз осындай өтініш жасайсыз ба?
Dialogue: 0,0:05:50.91,0:05:54.28,Default,,0,0,0,,Хошино мырза енді Абыдоста студент емес.
Dialogue: 0,0:05:54.28,0:05:57.12,Default,,0,0,0,,Жоқ. Оқушылардан хабарландырулар➡
Dialogue: 0,0:05:57.12,0:06:00.69,Default,,0,0,0,,Расталмаған ба? Мен көрдім.
Dialogue: 0,0:06:00.69,0:06:03.26,Default,,0,0,0,,Хошиноның артта қалғаны туралы хабарлама.\NЕгер бұл
Dialogue: 0,0:06:03.26,0:06:07.76,Default,,0,0,0,,болса, сіз түсінесіз, солай емес пе? Ұстаз, сіздің қолыңыздан келетін нәрсе➡
Dialogue: 0,0:06:07.76,0:06:11.33,Default,,0,0,0,,Ештеңе қалмады. Жоқ, бұл дұрыс емес.
Dialogue: 0,0:06:11.33,0:06:13.77,Default,,0,0,0,,Иә? Өйткені➡
Dialogue: 0,0:06:13.77,0:06:17.61,Default,,0,0,0,,Мен оған әлі қол қойған жоқпын.
Dialogue: 0,0:06:17.61,0:06:20.94,Default,,0,0,0,,Сондықтан Хошино әлі де жұмыс тобының мүшесі➡
Dialogue: 0,0:06:20.94,0:06:23.41,Default,,0,0,0,,Абыдос орта мектебінің студенттер кеңесінің вице-президенті➡
Dialogue: 0,0:06:23.41,0:06:26.85,Default,,0,0,0,,Ол әлі менің шәкіртім.
Dialogue: 0,0:06:26.85,0:06:30.25,Default,,0,0,0,,Мен көремін. Сіз мұғалім болғандықтан➡
Dialogue: 0,0:06:30.25,0:06:34.76,Default,,0,0,0,,Жауапты студенттің кетуі үшін сіздің қолыңыз қажет...
Dialogue: 0,0:06:34.76,0:06:37.76,Default,,0,0,0,,Хмм, бұл өте қиын ұғым.
Dialogue: 0,0:06:37.76,0:06:41.76,Default,,0,0,0,,Сен... Хошино мен барлығын алдадың➡
Dialogue: 0,0:06:41.76,0:06:45.57,Default,,0,0,0,,Жүректі таптап, оның азабын пайдаланды.
Dialogue: 0,0:06:45.57,0:06:48.27,Default,,0,0,0,,Иә, дәл сіз айтқандай.
Dialogue: 0,0:06:48.27,0:06:51.77,Default,,0,0,0,,Біздің іс-әрекетіміз жақсы ма, әлде жаман ма деп сұрағанда➡
Dialogue: 0,0:06:51.77,0:06:55.78,Default,,0,0,0,,Бұл зұлымдық болуы керек. Бірақ бұл ережеде.
Dialogue: 0,0:06:55.78,0:06:58.91,Default,,0,0,0,,Бұл туралы мені қате түсінбеуіңізді өтінемін.
Dialogue: 0,0:06:58.91,0:07:01.58,Default,,0,0,0,,Ал Абыдостың басына түскен апат➡
Dialogue: 0,0:07:01.58,0:07:04.42,Default,,0,0,0,,Бұл біздің кінәміз емес.
Dialogue: 0,0:07:04.42,0:07:09.26,Default,,0,0,0,,Абыдоста болған құмды дауыл өте сирек болғанымен➡
Dialogue: 0,0:07:09.26,0:07:13.26,Default,,0,0,0,,Белгілі бір ықтималдықпен болуы мүмкін табиғат құбылысы.
Dialogue: 0,0:07:13.26,0:07:17.23,Default,,0,0,0,,Нәтиже Адамдар шөлдеуден зардап шегеді.
Dialogue: 0,0:07:17.23,0:07:20.77,Default,,0,0,0,,Бұлай болса, әрине, су сататындар болады.
Dialogue: 0,0:07:20.77,0:07:23.94,Default,,0,0,0,,Бұл да табиғи прогрессия.
Dialogue: 0,0:07:23.94,0:07:26.27,Default,,0,0,0,,Ол су күлкілі қымбат болса да➡
Dialogue: 0,0:07:26.27,0:07:29.44,Default,,0,0,0,,Не болды? Кук-кук.
Dialogue: 0,0:07:29.44,0:07:34.42,Default,,0,0,0,,Бұл соншалықты сирек емес, бұл әлемде жиі кездесетін оқиға.
Dialogue: 0,0:07:34.42,0:07:38.25,Default,,0,0,0,,Бар адамдар жоқтарды пайдаланады.
Dialogue: 0,0:07:38.25,0:07:42.26,Default,,0,0,0,,Әлсіздердің өз болашағын таңдауға құқығы жоқ.
Dialogue: 0,0:07:42.26,0:07:45.93,Default,,0,0,0,,Хошино мырза бас тартса➡
Dialogue: 0,0:07:45.93,0:07:49.93,Default,,0,0,0,,Абыдос орта мектебіне келсек, мен оны қорғаймын.
Dialogue: 0,0:07:49.93,0:07:52.90,Default,,0,0,0,,Біз оны қайтара аламыз, сондықтан оқушылар сенімді бола алады➡
Dialogue: 0,0:07:52.90,0:07:55.44,Default,,0,0,0,,Мектепке баратындай өмір сүр.
Dialogue: 0,0:07:55.44,0:07:58.41,Default,,0,0,0,,Хошино мырзаның да соны қалайтынына сенімдімін.
Dialogue: 0,0:07:58.41,0:08:01.24,Default,,0,0,0,,Егер солай болса да, нәтиже болар еді➡
Dialogue: 0,0:08:01.24,0:08:04.15,Default,,0,0,0,,Бұл балалар мұны қаламайды.
Dialogue: 0,0:08:04.15,0:08:08.78,Default,,0,0,0,,Еш нәрсеге қарамастан бізге қарсы шыққыңыз келе ме?
Dialogue: 0,0:08:08.78,0:08:12.82,Default,,0,0,0,,Сіз күшсізсіз. Күресуге мүмкіндік болмас еді.
Dialogue: 0,0:08:12.82,0:08:15.79,Default,,0,0,0,,Солай болса да, көмекке мұқтаж адам болса➡
Dialogue: 0,0:08:15.79,0:08:19.96,Default,,0,0,0,,Біз күресуіміз керек. Қарсыласыңыз қаншалықты күшті болса да.
Dialogue: 0,0:08:19.96,0:08:23.43,Default,,0,0,0,,Даусыңды көтере берсең, міндетті түрде біреуге жетесің➡
Dialogue: 0,0:08:23.43,0:08:26.40,Default,,0,0,0,,Мен оны дәлелдеуім керек!
Dialogue: 0,0:08:26.40,0:08:28.80,Default,,0,0,0,,Қандай ақымақ нәрсе.
Dialogue: 0,0:08:28.80,0:08:32.97,Default,,0,0,0,,Сонда неге олар әлі жалғыз?
Dialogue: 0,0:08:32.97,0:08:36.61,Default,,0,0,0,,Ең болмағанда мен естідім.
Dialogue: 0,0:08:36.61,0:08:38.61,Default,,0,0,0,,Олардың дауыстары.
Dialogue: 0,0:08:38.61,0:08:41.52,Default,,0,0,0,,Оны жай қалдырған дұрыс емес пе?
Dialogue: 0,0:08:41.52,0:08:43.55,Default,,0,0,0,,Басынан бастап білуіңізше➡
Dialogue: 0,0:08:43.55,0:08:45.82,Default,,0,0,0,,Өйткені жоқ. бас тарту.
Dialogue: 0,0:08:48.12,0:08:52.43,Default,,0,0,0,,Неліктен? неге? неге? неге? неге? неге?
Dialogue: 0,0:08:52.43,0:08:55.96,Default,,0,0,0,,Неліктен? неге? неге? неге! ?
Dialogue: 0,0:08:55.96,0:08:59.37,Default,,0,0,0,,Мен түсінбеймін. Неге жоқ дейсің?
Dialogue: 0,0:08:59.37,0:09:01.60,Default,,0,0,0,,Сол балалардың қиналғаны үшін➡
Dialogue: 0,0:09:01.60,0:09:04.31,Default,,0,0,0,,Жауапкершілікті алатын ересек адам болмады.
Dialogue: 0,0:09:04.31,0:09:06.94,Default,,0,0,0,,Сонда сіз жауапкершілікті өз мойныңызға аласыз ба?
Dialogue: 0,0:09:06.94,0:09:10.95,Default,,0,0,0,,Сіз тіпті олардың отбасы емессіз.
Dialogue: 0,0:09:10.95,0:09:14.95,Default,,0,0,0,,Әрине, отбасы немесе ештеңе емес.
Dialogue: 0,0:09:14.95,0:09:19.29,Default,,0,0,0,,Мені Абыдосқа кездейсоқ шақырды, сол балалармен кездейсоқ кездесіп қалдым.
Dialogue: 0,0:09:19.29,0:09:22.46,Default,,0,0,0,,Мұның бәрі бар.
Dialogue: 0,0:09:22.46,0:09:24.79,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:24.79,0:09:28.33,Default,,0,0,0,,Себеп? Бала көмек сұрады.
Dialogue: 0,0:09:28.33,0:09:30.47,Default,,0,0,0,,Жетеді! Болды➡
Dialogue: 0,0:09:30.47,0:09:34.14,Default,,0,0,0,,Сіз «жауапкершілікті мойнына алатын ересек»сіз бе?
Dialogue: 0,0:09:34.14,0:09:37.81,Default,,0,0,0,,Иә. Балаңыз күлсе, солармен бірге күліңіз➡
Dialogue: 0,0:09:37.81,0:09:40.18,Default,,0,0,0,,Мұңайсаң жанымда тұр➡
Dialogue: 0,0:09:40.18,0:09:42.71,Default,,0,0,0,,Егер уайымдасаңыз, хабарласыңыз.
Dialogue: 0,0:09:42.71,0:09:47.82,Default,,0,0,0,,Бұл ересек адам болар еді! ? Жоқ, бұл үлкен қателік.
Dialogue: 0,0:09:47.82,0:09:51.12,Default,,0,0,0,,Ересек деген не: Қоғамды өз қалауыңызша өзгерту➡
Dialogue: 0,0:09:51.12,0:09:54.29,Default,,0,0,0,,Ережелерді шешіп, ненің ақылға қонымды, ненің ақылға қонымсыз екенін шешіңіз➡
Dialogue: 0,0:09:54.29,0:09:57.46,Default,,0,0,0,,Ол кәдімгі мен ерекшенің арасында шешім қабылдайды.
Dialogue: 0,0:09:57.46,0:10:00.13,Default,,0,0,0,,Билігі жоқтардың күшімен➡
Dialogue: 0,0:10:00.13,0:10:02.30,Default,,0,0,0,,Біліммен, надандар➡
Dialogue: 0,0:10:02.30,0:10:05.30,Default,,0,0,0,,Күшпен, күшсізді биле.
Dialogue: 0,0:10:05.30,0:10:07.80,Default,,0,0,0,,Бұл ересек адам.
Dialogue: 0,0:10:07.80,0:10:10.97,Default,,0,0,0,,Мен түсінбеймін. Сіз бұл Кивотоссыз➡
Dialogue: 0,0:10:10.97,0:10:13.64,Default,,0,0,0,,Сызғыш болуы да мүмкін.
Dialogue: 0,0:10:13.64,0:10:16.98,Default,,0,0,0,,Бұл академия қаласындағы зор күш пен бедел.
Dialogue: 0,0:10:16.98,0:10:21.78,Default,,0,0,0,,Бұл академиялық қалада бар жұмбақ.
Dialogue: 0,0:10:21.78,0:10:28.16,Default,,0,0,0,,Мұның бәрі уақытша болса да, сіздің қолыңызда болды.
Dialogue: 0,0:10:28.16,0:10:31.26,Default,,0,0,0,,Бірақ мен оны еш ойланбастан жібердім.
Dialogue: 0,0:10:31.26,0:10:35.30,Default,,0,0,0,,Ақиқат пен құпия күш Ақша күші….
Dialogue: 0,0:10:35.30,0:10:39.47,Default,,0,0,0,,Осының бәрін лақтырып тастау үшін неге мағынасыз таңдау жасайсыз?
Dialogue: 0,0:10:41.44,0:10:44.24,Default,,0,0,0,,Айтсам да, түсінбейтініңізге сенімдімін.
Dialogue: 0,0:10:46.61,0:10:49.61,Default,,0,0,0,,Хмм... Жарайды.
Dialogue: 0,0:10:49.61,0:10:52.61,Default,,0,0,0,,Келіссөздер үзілді, сэр.
Dialogue: 0,0:10:52.61,0:10:55.62,Default,,0,0,0,,Сен маған ұнадың, бірақ...
Dialogue: 0,0:10:55.62,0:10:58.62,Default,,0,0,0,,Біздің таңдауымыз жоқ.
Dialogue: 0,0:10:58.62,0:11:02.69,Default,,0,0,0,,Хошино мырза Абидос шөліндегі Кайзер ПМК базасында➡
Dialogue: 0,0:11:02.69,0:11:07.30,Default,,0,0,0,,Мен зертханадамын. Сахна артында Mimesis➡ арқылы байқалған жұмбақ
Dialogue: 0,0:11:07.30,0:11:10.13,Default,,0,0,0,,Яғни, қорқыныш. Оны өмір сүріп жатқан студенттерге➡
Dialogue: 0,0:11:10.13,0:11:13.13,Default,,0,0,0,,Қолдануға бола ма➡
Dialogue: 0,0:11:13.13,0:11:17.14,Default,,0,0,0,,Мен оны білу үшін сынақ субъектісі ретінде пайдаланғым келді.
Dialogue: 0,0:11:17.14,0:11:19.27,Default,,0,0,0,,«Мен көз жеткізгім келді»?
Dialogue: 0,0:11:19.27,0:11:24.65,Default,,0,0,0,,Сіз келіссөз жүргізуге дайын болмағандықтан, мен ештеңе істей алмаймын.
Dialogue: 0,0:11:24.65,0:11:27.72,Default,,0,0,0,,Мен құлықсызмын, бірақ кері кетуден басқа амалым жоқ.
Dialogue: 0,0:11:27.72,0:11:30.79,Default,,0,0,0,,Сосын Хошино... Қалағаныңды істе.
Dialogue: 0,0:11:30.79,0:11:34.46,Default,,0,0,0,,Мені үйге апарсаң, қарсы емеспін.
Dialogue: 0,0:11:34.46,0:11:37.33,Default,,0,0,0,,Ал, балалар, базаға кіре беріңдер➡
Dialogue: 0,0:11:37.33,0:11:42.46,Default,,0,0,0,,Егер сол директор рұқсат берсе.
Dialogue: 0,0:11:42.46,0:11:45.13,Default,,0,0,0,,Сізбен сөйлескенім жақсы болды.
Dialogue: 0,0:11:45.13,0:11:47.74,Default,,0,0,0,,Бір күні, бір жерде.
Dialogue: 0,0:11:50.04,0:11:53.21,Default,,0,0,0,,Сізге сәттілік тілеймін.
Dialogue: 0,0:11:58.11,0:12:00.95,Default,,0,0,0,,Kaiser PMC базалық зертханасы...
Dialogue: 0,0:12:00.95,0:12:05.09,Default,,0,0,0,,Аа, сөзсіз. Хошино сонда!
Dialogue: 0,0:12:05.09,0:12:07.59,Default,,0,0,0,,Осындай жерде тұрып қалғаныма сене алар емеспін...
Dialogue: 0,0:12:07.59,0:12:09.76,Default,,0,0,0,,Онда мен күте алмаймын!
Dialogue: 0,0:12:09.76,0:12:12.93,Default,,0,0,0,,Көмектесейік. Мен келісемін.
Dialogue: 0,0:12:12.93,0:12:15.60,Default,,0,0,0,,Бірақ сәл күте тұрыңыз. айтпақшы…. иә?
Dialogue: 0,0:12:15.60,0:12:19.10,Default,,0,0,0,,Хошино-сенпаймен кездескенде оған не айтуым керек?
Dialogue: 0,0:12:19.10,0:12:22.10,Default,,0,0,0,,Жоқ, одан да көп... Мен саған ұрсуым керек.
Dialogue: 0,0:12:22.10,0:12:24.11,Default,,0,0,0,,Не? Өзім айтқаным➡
Dialogue: 0,0:12:24.11,0:12:27.78,Default,,0,0,0,,Өзіңді қорғамағандықтан, бұл сенің жазаң!
Dialogue: 0,0:12:27.78,0:12:31.28,Default,,0,0,0,,Мен саған дұрыс ұрыс айтуым керек.
Dialogue: 0,0:12:37.09,0:12:40.59,Default,,0,0,0,,''Үйге қош келдіңіз'' деп айтыңыз және оларға ''Мен үйдемін'' деңіз.
Dialogue: 0,0:12:40.59,0:12:44.49,Default,,0,0,0,,Иә! ? Қандай ұят! Жастық!
Dialogue: 0,0:12:44.49,0:12:47.26,Default,,0,0,0,,Бұл мөлдір мектеп өмірі сияқты.
Dialogue: 0,0:12:47.26,0:12:49.26,Default,,0,0,0,,Бұл біз сияқты емес!
Dialogue: 0,0:12:49.26,0:12:51.43,Default,,0,0,0,,айтамын. Ха!
Dialogue: 0,0:12:51.43,0:12:54.90,Default,,0,0,0,,Селика-чан айтпаса да. Ә?
Dialogue: 0,0:12:54.90,0:12:58.31,Default,,0,0,0,,Уау, мен де. Бұл аздап ұят болса да...
Dialogue: 0,0:12:58.31,0:13:00.88,Default,,0,0,0,,Қалағаныңды істе! Мен мүлдем➡
Dialogue: 0,0:13:00.88,0:13:04.05,Default,,0,0,0,,Мен мұндай ұят нәрсе айтпаймын! Уууу.
Dialogue: 0,0:13:04.05,0:13:07.05,Default,,0,0,0,,Мм... Бірақ бұлай біз ғана қалдық...
Dialogue: 0,0:13:07.05,0:13:11.09,Default,,0,0,0,,Бірақ біз өз күшімізбен жеңе алмаймыз.
Dialogue: 0,0:13:11.09,0:13:14.39,Default,,0,0,0,,Олай болса, біреу көмектесіңізші... Ұсташы ше?
Dialogue: 0,0:13:14.39,0:13:18.16,Default,,0,0,0,,Ол бізге көмектесті, бірақ...
Dialogue: 0,0:13:20.26,0:13:23.40,Default,,0,0,0,,Гохон….
Dialogue: 0,0:13:23.40,0:13:25.37,Default,,0,0,0,,Бұл туралы ...
Dialogue: 0,0:13:28.70,0:13:31.24,Default,,0,0,0,,Біраз уақыт болды, бәріңіз!
Dialogue: 0,0:13:31.24,0:13:33.61,Default,,0,0,0,,Жағдайың жақсы сияқты, Хифуми-сан.
Dialogue: 0,0:13:33.61,0:13:36.74,Default,,0,0,0,,Иә. Мұның бәрі бәріңіздің арқаңызда.
Dialogue: 0,0:13:36.74,0:13:41.45,Default,,0,0,0,,Кешіріңіз, бірақ мен сізден бірдеңе сұрайын деп едім...
Dialogue: 0,0:13:41.45,0:13:46.09,Default,,0,0,0,,Иә? Айтпақшы, Хошино ше?
Dialogue: 0,0:13:46.09,0:13:49.12,Default,,0,0,0,,Іс жүзінде...
Dialogue: 0,0:13:49.12,0:13:53.10,Default,,0,0,0,,Солай болды ма? Содан бері мұндай жағдайлар болып жатыр.
Dialogue: 0,0:13:53.10,0:13:57.27,Default,,0,0,0,,Иә. Хошино-сенпайдың не көтеріп жүргенін түсіндім➡
Dialogue: 0,0:13:57.27,0:14:00.13,Default,,0,0,0,,Тоқтатар едім➡
Dialogue: 0,0:14:00.13,0:14:03.50,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз...
Dialogue: 0,0:14:03.50,0:14:05.94,Default,,0,0,0,,Сонымен, сіз бүгін келген боларсыз?
Dialogue: 0,0:14:05.94,0:14:10.58,Default,,0,0,0,,Сіз Хошино мырзамен туыссыз ба? Аа, солай...
Dialogue: 0,0:14:10.58,0:14:14.08,Default,,0,0,0,,Мен Троица Хошиноны құтқаруға көмектескенін қалаймын.
Dialogue: 0,0:14:17.59,0:14:19.85,Default,,0,0,0,,Мен шай кешімен сөйлесемін.
Dialogue: 0,0:14:21.89,0:14:25.73,Default,,0,0,0,,Хмм, не істеуіміз керек...?
Dialogue: 0,0:14:25.73,0:14:28.76,Default,,0,0,0,,Қалай ойлайсың, Нағиса-сама?
Dialogue: 0,0:14:28.76,0:14:31.90,Default,,0,0,0,,Қайсысын алуым керек?
Dialogue: 0,0:14:31.90,0:14:34.57,Default,,0,0,0,,Жаңа піскен кілегейі мол шорт ➡
Dialogue: 0,0:14:34.57,0:14:37.54,Default,,0,0,0,,Сергітетін шаймен тамаша үйлеседі.
Dialogue: 0,0:14:37.54,0:14:40.27,Default,,0,0,0,,Алайда бұл Монбланды лақтыру да қиын...
Dialogue: 0,0:14:40.27,0:14:43.95,Default,,0,0,0,,Сол Нағиса-сама. Мен Абыдостағылардың барлығына➡
Dialogue: 0,0:14:43.95,0:14:46.55,Default,,0,0,0,,Көмегің үшін рахмет. Сонымен...
Dialogue: 0,0:14:46.55,0:14:48.88,Default,,0,0,0,,Хехе.
Dialogue: 0,0:14:48.88,0:14:52.42,Default,,0,0,0,,Kaiser PMC➡ деп аталатын компанияның болуы
Dialogue: 0,0:14:52.42,0:14:54.72,Default,,0,0,0,,Оқушыларымызға жағымсыз әсер ету➡
Dialogue: 0,0:14:54.72,0:14:57.39,Default,,0,0,0,,Оның әсері болуы мүмкін.
Dialogue: 0,0:14:57.39,0:15:00.76,Default,,0,0,0,,Ах, ынтымақтастығыңызға рахмет... дегенмен….
Dialogue: 0,0:15:00.76,0:15:05.27,Default,,0,0,0,,Ах…. Дәл осындай келісім-шарт жақын арада➡
Dialogue: 0,0:15:05.27,0:15:08.40,Default,,0,0,0,,Мен қазір дұрыс емес ештеңе жасай алмаймын.
Dialogue: 0,0:15:08.40,0:15:11.07,Default,,0,0,0,,Хмм….
Dialogue: 0,0:15:11.07,0:15:14.58,Default,,0,0,0,,Маған біраз уақыт бере аласыз ба?
Dialogue: 0,0:15:14.58,0:15:16.98,Default,,0,0,0,,Мен оны кейінге қалдырамын деп ойлаймын.
Dialogue: 0,0:15:16.98,0:15:19.58,Default,,0,0,0,,Бұл ұсынысты жасағаныңыз үшін кешіріңіз.
Dialogue: 0,0:15:19.58,0:15:21.72,Default,,0,0,0,,Бұл оңай болған жоқ.
Dialogue: 0,0:15:21.72,0:15:25.42,Default,,0,0,0,,Бұл шынымен қиын емес пе? Мен сіздердің ынтымақтастықтарыңызды сұраймын.
Dialogue: 0,0:15:25.42,0:15:28.89,Default,,0,0,0,,Бас тарту жақсы емес. Дұрыс, бірақ➡
Dialogue: 0,0:15:28.89,0:15:32.73,Default,,0,0,0,,Сіз маған келесі бөлімде көмектесе алмайсыз деп ойлаймын.
Dialogue: 0,0:15:32.73,0:15:35.73,Default,,0,0,0,,Сонда да бас тарту жақсы емес. иә….
Dialogue: 0,0:15:37.73,0:15:39.73,Default,,0,0,0,,Бәрі жақсы болатынына сенімдімін.
Dialogue: 0,0:15:46.21,0:15:49.78,Default,,0,0,0,,Кешіріңіз, мен сізді жалғыз шешуім керек.
Dialogue: 0,0:15:49.78,0:15:52.28,Default,,0,0,0,,Жоқ, мүлде емес. Чинацу да➡
Dialogue: 0,0:15:52.28,0:15:54.32,Default,,0,0,0,,Мен болсам жақсы болар еді...
Dialogue: 0,0:15:54.32,0:15:58.09,Default,,0,0,0,,Бұл қоғамдық моральда аздап проблемасы бар мектеп болды.
Dialogue: 0,0:15:58.09,0:16:01.09,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:16:01.09,0:16:04.73,Default,,0,0,0,,Еңбегіңіз үшін рахмет, Чинацу-сан. Кеш батты...
Dialogue: 0,0:16:04.73,0:16:08.06,Default,,0,0,0,,О... ә! ? Ха ха ха ха….
Dialogue: 0,0:16:08.06,0:16:12.10,Default,,0,0,0,,Сусын? иә? Аа, көп рахмет.
Dialogue: 0,0:16:12.10,0:16:16.57,Default,,0,0,0,,Иә. Жоқ, бұл менікі...
Dialogue: 0,0:16:16.57,0:16:20.41,Default,,0,0,0,,Уф... Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:16:20.41,0:16:24.05,Default,,0,0,0,,Мен мұны ақыры түсіндім... Кешіріңіз!
Dialogue: 0,0:16:24.05,0:16:27.75,Default,,0,0,0,,Үзілісте Кешіріңіз! Бұл жолы асханада қиындық туды!
Dialogue: 0,0:16:27.75,0:16:31.59,Default,,0,0,0,,Түсінікті! Бұл үшін сізге көп рахмет.
Dialogue: 0,0:16:31.59,0:16:34.56,Default,,0,0,0,,Шатасып кеткенім үшін кешіріңіз! Уақытыңызды бөліңіз!
Dialogue: 0,0:16:36.62,0:16:39.06,Default,,0,0,0,,Әрқашан осылай бола ма?
Dialogue: 0,0:16:39.06,0:16:41.40,Default,,0,0,0,,Мен әлі де жақсымын.
Dialogue: 0,0:16:41.40,0:16:44.40,Default,,0,0,0,,Аа….
Dialogue: 0,0:16:44.40,0:16:49.74,Default,,0,0,0,,Айтпақшы, талқылау қалай өтіп жатыр?
Dialogue: 0,0:16:49.74,0:16:52.57,Default,,0,0,0,,Тәртіптік комитет төрағасы қазір бос емес.
Dialogue: 0,0:16:52.57,0:16:55.74,Default,,0,0,0,,Бірден кездесу қиын. Болды...
Dialogue: 0,0:16:55.74,0:16:59.15,Default,,0,0,0,,Иә, дұрыс. Содан кейін жерге отырыңыз➡
Dialogue: 0,0:16:59.15,0:17:02.38,Default,,0,0,0,,Аяғымды жалайтын болсаң... Ой!
Dialogue: 0,0:17:02.38,0:17:05.89,Default,,0,0,0,,Әй, сен не істеп жатырсың! О, ересек адам ретінде мақтаныш➡
Dialogue: 0,0:17:05.89,0:17:08.56,Default,,0,0,0,,Адам ретінде сізде күмән жоқ па? ?
Dialogue: 0,0:17:08.56,0:17:11.39,Default,,0,0,0,,Бұл төтенше жағдай! Уф...
Dialogue: 0,0:17:11.39,0:17:14.43,Default,,0,0,0,,《Қандай тік көз...》
Dialogue: 0,0:17:14.43,0:17:16.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:16.46,0:17:18.37,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:17:18.37,0:17:21.40,Default,,0,0,0,,Көңілді сияқты. Ах!
Dialogue: 0,0:17:21.40,0:17:26.07,Default,,0,0,0,,Сәлеметсіз бе... Төраға Хина! Басыңызды қатты иіңіз...
Dialogue: 0,0:17:26.07,0:17:28.71,Default,,0,0,0,,Өте маңызды нәрсе болып жатыр.
Dialogue: 0,0:17:28.71,0:17:31.21,Default,,0,0,0,,Жоқ, төраға...
Dialogue: 0,0:17:31.21,0:17:33.68,Default,,0,0,0,,Мұғалім тізерлеп отырмайды➡
Dialogue: 0,0:17:33.68,0:17:36.42,Default,,0,0,0,,Бұл…. иә? Аяғымды жалап...
Dialogue: 0,0:17:36.42,0:17:39.95,Default,,0,0,0,,Ах... Хина!
Dialogue: 0,0:17:39.95,0:17:42.92,Default,,0,0,0,,А... аа....
Dialogue: 0,0:17:45.09,0:17:48.96,Default,,0,0,0,,Ха, тәртіптік комиссия да өз қорытындысын шығаруды тоқтатып отыр.
Dialogue: 0,0:17:48.96,0:17:52.10,Default,,0,0,0,,Жарайды. Мен қолымнан келгенін жасадым.
Dialogue: 0,0:17:52.10,0:17:55.40,Default,,0,0,0,,Соңғысы, бірақ кем дегенде, шебер 68.
Dialogue: 0,0:17:55.40,0:17:58.77,Default,,0,0,0,,Бірақ сіз оны қабылдауға дайынсыз ба?
Dialogue: 0,0:17:58.77,0:18:00.94,Default,,0,0,0,,Жарайды, келесі жолы.
Dialogue: 0,0:18:03.51,0:18:06.11,Default,,0,0,0,,Эй, бұл нені білдіреді?
Dialogue: 0,0:18:06.11,0:18:09.25,Default,,0,0,0,,Бұл біртүрлі. Сіз маған берген мекенжай➡
Dialogue: 0,0:18:09.25,0:18:11.59,Default,,0,0,0,,Бұл жер... екені рас.
Dialogue: 0,0:18:11.59,0:18:15.42,Default,,0,0,0,,Сонымен не? Сіз бұл жұмысшының кеңсесі дейсіз бе?
Dialogue: 0,0:18:15.42,0:18:17.79,Default,,0,0,0,,Қандай да бір қате бар ма?
Dialogue: 0,0:18:17.79,0:18:19.83,Default,,0,0,0,,Енді барлық шеберлер➡
Dialogue: 0,0:18:19.83,0:18:22.93,Default,,0,0,0,,Мен сенің енді қайда екеніңді білмеймін.
Dialogue: 0,0:18:22.93,0:18:29.10,Default,,0,0,0,,Менің ойымша, бұл уақыт босқа кетті. үшін үйлеріне қайт.
Dialogue: 0,0:18:29.10,0:18:31.27,Default,,0,0,0,,Әй, сен қайдасың?➡
Dialogue: 0,0:18:31.27,0:18:33.24,Default,,0,0,0,,Сол жігіттер...
Dialogue: 0,0:18:37.45,0:18:41.62,Default,,0,0,0,,Көптен бері көрмедім, генерал. иә? О, қош келдіңіз.
Dialogue: 0,0:18:41.62,0:18:43.99,Default,,0,0,0,,Бұл жақсы дүңгіршек. Әйтеуір өте➡
Dialogue: 0,0:18:43.99,0:18:47.25,Default,,0,0,0,,Сағыныш сезімін тудырады. Солай ма?
Dialogue: 0,0:18:47.25,0:18:50.76,Default,,0,0,0,,Бастапқыда Шибасеки Рамен азық-түлік дүкені ретінде басталды.
Dialogue: 0,0:18:50.76,0:18:53.63,Default,,0,0,0,,Не айтайын, жасарғандай болдым.
Dialogue: 0,0:18:53.63,0:18:55.66,Default,,0,0,0,,Сіздің жақсы екеніңізді көріп, көңілім босап қалды.
Dialogue: 0,0:18:55.66,0:18:58.93,Default,,0,0,0,,Енді генералдың раменін қайтадан жеуге болады.
Dialogue: 0,0:18:58.93,0:19:03.10,Default,,0,0,0,,Жоқ, менде бұл ақша болмағанда не болар еді...
Dialogue: 0,0:19:03.10,0:19:05.11,Default,,0,0,0,,Сіз бәрібір жүре бермедіңіз бе?
Dialogue: 0,0:19:05.11,0:19:08.11,Default,,0,0,0,,Жарайды, мен жай тастай алмаймын.
Dialogue: 0,0:19:08.11,0:19:11.01,Default,,0,0,0,,Біреу менің раменімді жегісі келеді➡
Dialogue: 0,0:19:11.01,0:19:13.28,Default,,0,0,0,,Тағы да бар.
Dialogue: 0,0:19:13.28,0:19:16.25,Default,,0,0,0,,Дәл қазір сүйкімді тұтынушы келді.
Dialogue: 0,0:19:16.25,0:19:20.25,Default,,0,0,0,,Бұл менің шаршаған денемді жақсы сезінді, ол сондай жақсы жеді.
Dialogue: 0,0:19:20.25,0:19:23.19,Default,,0,0,0,,Сізге көп рахмет. Эй!
Dialogue: 0,0:19:23.19,0:19:26.76,Default,,0,0,0,,Бұл туралы не деуге болады? Бұл өте...
Dialogue: 0,0:19:26.76,0:19:29.93,Default,,0,0,0,,Мен көп адамдардан көмек сұраймын...
Dialogue: 0,0:19:29.93,0:19:32.83,Default,,0,0,0,,Қайда кеткенін білмейтіндер де бар➡
Dialogue: 0,0:19:32.83,0:19:35.94,Default,,0,0,0,,1 жұп. Егер таба алмасаңыз➡
Dialogue: 0,0:19:35.94,0:19:38.24,Default,,0,0,0,,Менің бас тартудан басқа амалым жоқ сияқты.
Dialogue: 0,0:19:38.24,0:19:42.94,Default,,0,0,0,,Мм. Генерал, мен есепшотты төлей аламын ба?
Dialogue: 0,0:19:42.94,0:19:45.91,Default,,0,0,0,,Иә? Міне болды!
Dialogue: 0,0:19:45.91,0:19:48.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:48.95,0:19:53.59,Default,,0,0,0,,Қайзер ПМК-мен ешқандай марапатсыз күресу...
Dialogue: 0,0:19:53.59,0:19:57.26,Default,,0,0,0,,Оның бізге пайдасы жоқ деп ойлаймын.
Dialogue: 0,0:19:57.26,0:20:01.26,Default,,0,0,0,,Аа, мен бұған қатты өкінемін.
Dialogue: 0,0:20:01.26,0:20:03.70,Default,,0,0,0,,Кайоко-чан, жақсылап қара.
Dialogue: 0,0:20:03.70,0:20:07.27,Default,,0,0,0,,Не? «Өтінім ақысы осы раменнің дәмін тату үшін ғана болды➡
Dialogue: 0,0:20:07.27,0:20:10.77,Default,,0,0,0,,«Болды!» дейтін сияқтысың.
Dialogue: 0,0:20:10.77,0:20:14.11,Default,,0,0,0,,Түсіндім! Әлден күткендей!
Dialogue: 0,0:20:14.11,0:20:18.75,Default,,0,0,0,,Көп сөзге келмей, бір тостаған раменмен тозаққа бару бейнесі➡
Dialogue: 0,0:20:18.75,0:20:22.25,Default,,0,0,0,,Бұл шынымен қатты қайнатылған!
Dialogue: 0,0:20:22.25,0:20:25.75,Default,,0,0,0,,Аа... Хуфуфуфу. Кешіріңіз бірақ➡
Dialogue: 0,0:20:25.75,0:20:27.76,Default,,0,0,0,,Мен бұл туралы ойлай аламын ба?
Dialogue: 0,0:20:27.76,0:20:29.76,Default,,0,0,0,,Ех! ? Құрметті Әл! ?
Dialogue: 0,0:20:29.76,0:20:31.76,Default,,0,0,0,,Президент, сіз бұған шындап айтасыз ба?
Dialogue: 0,0:20:31.76,0:20:35.10,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:20:35.10,0:20:39.97,Default,,0,0,0,,үшінмыз кеттік. Сәл күте тұрыңыз, Аль-Чан!
Dialogue: 0,0:20:39.97,0:20:42.27,Default,,0,0,0,,Әй, ұстаз, кейде осындай жағдайлар болады...
Dialogue: 0,0:20:42.27,0:20:44.27,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:44.27,0:20:47.24,Default,,0,0,0,,Сол балалардың келетініне сенімдімін.
Dialogue: 0,0:20:52.45,0:20:56.08,Default,,0,0,0,,《Сенесің бе...?
Dialogue: 0,0:20:56.08,0:21:01.46,Default,,0,0,0,,Шынында да, біз өз тұтынушыларымызға сенетін болсақ, біздің дүкендер ешқашан жоғалмайды.
Dialogue: 0,0:21:01.46,0:21:05.06,Default,,0,0,0,,Міне, солай. Жаман болып кетсе➡
Dialogue: 0,0:21:05.06,0:21:07.93,Default,,0,0,0,,Қайталап көріңіз.
Dialogue: 0,0:21:07.93,0:21:12.10,Default,,0,0,0,,Сенгенше жол жалғаса береді.
Dialogue: 0,0:21:12.10,0:21:16.77,Default,,0,0,0,,Бар, жұмыс тобы. Және ➡
Dialogue: 0,0:21:16.77,0:21:19.74,Default,,0,0,0,,Дәмді раменге оралыңыз! 》
Dialogue: 0,0:21:22.74,0:21:25.15,Default,,0,0,0,,үшін, дайынсыңдар ма?
Dialogue: 0,0:21:25.15,0:21:27.58,Default,,0,0,0,,Хмм… Кез келген уақытта бара аласыз.
Dialogue: 0,0:21:27.58,0:21:30.25,Default,,0,0,0,,Біз де оқ-дәрілердің жеткілікті болуын қамтамасыз еттік!
Dialogue: 0,0:21:30.25,0:21:34.22,Default,,0,0,0,,Мен көп ұйықтадым, сондықтан мен бұл Kaiser PMC➡ деп ойладым
Dialogue: 0,0:21:34.22,0:21:37.26,Default,,0,0,0,,Менің қарсыласым емес!
Dialogue: 0,0:21:37.26,0:21:40.09,Default,,0,0,0,,Мұғалімнің маған берген ақпараты➡
Dialogue: 0,0:21:40.09,0:21:44.97,Default,,0,0,0,,Хошино-сенпай Кайзер ПМК базасының 51-ші ауданында болуы керек.
Dialogue: 0,0:21:44.97,0:21:48.04,Default,,0,0,0,,Иә. Олай болса, кеттік!
Dialogue: 0,0:21:48.04,0:21:51.01,Default,,0,0,0,,Енді Хошино-сенпайдың құтқару миссиясы...
Dialogue: 0,0:21:52.91,0:21:55.08,Default,,0,0,0,,Бастау.
Dialogue: 0,0:21:56.58,0:22:02.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
