Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:25.44,0:00:28.86,Default,,0,0,0,,Аман болсын!
Dialogue: 0,0:00:28.94,0:00:32.57,Default,,0,0,0,,Аман болсын!
Dialogue: 0,0:00:32.65,0:00:34.99,Default,,0,0,0,,Аман болсын!
Dialogue: 0,0:00:52.30,0:00:57.30,Default,,0,0,0,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:01:02.06,0:01:05.98,Default,,0,0,0,,Цзиюгаока Цзиюгаока
Dialogue: 0,0:01:06.06,0:01:07.48,Default,,0,0,0,,Бұл 5 сен.
Dialogue: 0,0:01:13.07,0:01:16.53,Default,,0,0,0,,Иә, рақмет.
Dialogue: 0,0:01:16.61,0:01:18.11,Default,,0,0,0,,- (Әйел) Ммм... - (Станция қызметкері) Иә?
Dialogue: 0,0:01:18.87,0:01:20.45,Default,,0,0,0,,Келесі адам өтінемін
Dialogue: 0,0:01:20.53,0:01:22.16,Default,,0,0,0,,Ум...
Dialogue: 0,0:01:22.79,0:01:23.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:24.54,0:01:26.00,Default,,0,0,0,,Маған билетті беріңіз!
Dialogue: 0,0:01:26.08,0:01:28.50,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:01:28.58,0:01:31.38,Default,,0,0,0,,Бұл билетті алмауым керек пе?
Dialogue: 0,0:01:32.00,0:01:34.01,Default,,0,0,0,,-Ах! -(Станция қызметкерлері) Жоқ, жоқ.
Dialogue: 0,0:01:34.09,0:01:37.01,Default,,0,0,0,,Мұның бәрі сенің ағаңдікі ме?
Dialogue: 0,0:01:37.59,0:01:40.51,Default,,0,0,0,,Жоқ, бұл вокзалда.
Dialogue: 0,0:01:40.60,0:01:42.35,Default,,0,0,0,,Я~
Dialogue: 0,0:01:42.43,0:01:47.02,Default,,0,0,0,,Мен өскенде билет сатушы болғым келеді.
Dialogue: 0,0:01:47.10,0:01:48.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:49.19,0:01:52.94,Default,,0,0,0,,Әй, менің монахым да станцияда жұмыс істейтінін айтады.
Dialogue: 0,0:01:53.02,0:01:54.53,Default,,0,0,0,,Бірге орындаған дұрыс.
Dialogue: 0,0:01:55.65,0:01:57.74,Default,,0,0,0,,Хмм.
Dialogue: 0,0:02:01.78,0:02:03.95,Default,,0,0,0,,Ойлан!
Dialogue: 0,0:02:04.04,0:02:09.08,Default,,0,0,0,,Мен жаңа мектепке барамын, сондықтан мен бос емеспін.
Dialogue: 0,0:02:09.17,0:02:10.83,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:02:10.92,0:02:11.92,Default,,0,0,0,,Тотто-чан
Dialogue: 0,0:02:12.00,0:02:14.21,Default,,0,0,0,,Иә
Dialogue: 0,0:02:22.76,0:02:24.01,Default,,0,0,0,,Шешім
Dialogue: 0,0:02:24.10,0:02:27.68,Default,,0,0,0,,Өскенде билет сатушы бол
Dialogue: 0,0:02:27.77,0:02:30.35,Default,,0,0,0,,Шпион болу үшін не істеу керек?
Dialogue: 0,0:02:30.44,0:02:32.27,Default,,0,0,0,,Хмм.
Dialogue: 0,0:02:32.36,0:02:36.36,Default,,0,0,0,,Ол шын мәнінде тыңшы, бірақ билет сатушы болу ше?
Dialogue: 0,0:02:41.95,0:02:45.87,Default,,0,0,0,,Үйде жас келіншектің болуы мектепке кедергі келтіреді.
Dialogue: 0,0:02:45.95,0:02:49.50,Default,,0,0,0,,Өтінемін, мені басқа мектепке апарыңыз.
Dialogue: 0,0:02:49.58,0:02:52.00,Default,,0,0,0,,А... басқа мектеп?
Dialogue: 0,0:02:52.08,0:02:56.88,Default,,0,0,0,,Сайта Сайта Сакурага Сайта
Dialogue: 0,0:02:56.96,0:03:01.01,Default,,0,0,0,,Жақсы, содан кейін келесі бөлімге өтіңіз.
Dialogue: 0,0:03:02.55,0:03:05.39,Default,,0,0,0,,Ұсыныс
Dialogue: 0,0:03:06.18,0:03:09.31,Default,,0,0,0,,Ұсыныс
Dialogue: 0,0:03:10.18,0:03:13.02,Default,,0,0,0,,Сәлем Тайланд…
Dialogue: 0,0:03:13.10,0:03:15.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:15.23,0:03:17.07,Default,,0,0,0,,- (Оқушы) А? -(Оқушы) Қандай дыбыс?
Dialogue: 0,0:03:21.24,0:03:24.66,Default,,0,0,0,,Куроянаги мырза, сіз не істеп жатырсыз?
Dialogue: 0,0:03:25.37,0:03:27.58,Default,,0,0,0,,Бұл үстел керемет
Dialogue: 0,0:03:27.66,0:03:29.62,Default,,0,0,0,,Қоқыс жәшігінің қақпағы сияқты
Dialogue: 0,0:03:29.70,0:03:31.16,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:03:31.25,0:03:33.54,Default,,0,0,0,,Мүмкін мен де байқап көрермін.
Dialogue: 0,0:03:33.63,0:03:36.67,Default,,0,0,0,,Ісіңіз болмаса, есікті ашпаңыз немесе жаппаңыз.
Dialogue: 0,0:03:36.75,0:03:38.30,Default,,0,0,0,,Жақсы естіледі ме?
Dialogue: 0,0:03:38.38,0:03:40.67,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:40.76,0:03:42.76,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:42.84,0:03:44.47,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:03:45.18,0:03:47.10,Default,,0,0,0,,Сәлем, тай
Dialogue: 0,0:03:47.18,0:03:49.31,Default,,0,0,0,,Сусу...! (үстелдің қақпағы жабылған дыбыс)
Dialogue: 0,0:03:49.93,0:03:52.81,Default,,0,0,0,,Куроянаги мырза! Менің шаруам жоқ кезде...
Dialogue: 0,0:03:54.90,0:03:56.56,Default,,0,0,0,,Менің бір ісім бар...
Dialogue: 0,0:03:58.40,0:04:00.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:00.40,0:04:02.65,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:04:02.74,0:04:05.37,Default,,0,0,0,,Мен «болма» деп айта алмаймын, бірақ...
Dialogue: 0,0:04:05.45,0:04:07.95,Default,,0,0,0,,-Мен абай боламын.-(Үй мұғалімі) Фу...
Dialogue: 0,0:04:08.58,0:04:11.45,Default,,0,0,0,,Хм... Егер сізге осы ғана керек болса, жақсы!
Dialogue: 0,0:04:18.21,0:04:21.21,Default,,0,0,0,,Иә? Ха...
Dialogue: 0,0:04:22.38,0:04:27.39,Default,,0,0,0,,(Чиндонияның орындауы)
Dialogue: 0,0:04:33.81,0:04:35.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:37.48,0:04:38.73,Default,,0,0,0,,Ах
Dialogue: 0,0:04:39.86,0:04:41.73,Default,,0,0,0,,- (Үй мұғалімі) Сіз сурет сала алдыңыз ба? -Жарайды...
Dialogue: 0,0:04:41.82,0:04:43.74,Default,,0,0,0,,Қайырлы таң... (Барлығы күңкілдейді)
Dialogue: 0,0:04:44.70,0:04:46.11,Default,,0,0,0,,О...
Dialogue: 0,0:04:47.12,0:04:49.74,Default,,0,0,0,,Чиндонья-сан!
Dialogue: 0,0:04:49.83,0:04:51.83,Default,,0,0,0,,Чиндонья-сан!
Dialogue: 0,0:04:51.91,0:04:52.75,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:53.58,0:04:55.62,Default,,0,0,0,,Чиндон дүкені осында!
Dialogue: 0,0:04:55.71,0:04:57.25,Default,,0,0,0,,Уау, олар керемет көрінеді!
Dialogue: 0,0:05:00.55,0:05:02.26,Default,,0,0,0,,Біз сабақтамыз!
Dialogue: 0,0:05:02.34,0:05:04.30,Default,,0,0,0,,Сәлем
Dialogue: 0,0:05:07.09,0:05:09.26,Default,,0,0,0,,Бұл кім? Қоңырау шалған
Dialogue: 0,0:05:09.35,0:05:12.06,Default,,0,0,0,,Иә, бұл менмін.
Dialogue: 0,0:05:12.14,0:05:14.77,Default,,0,0,0,,Эй, бірдеңе жасап көр.
Dialogue: 0,0:05:14.85,0:05:18.60,Default,,0,0,0,,Мен жас ханымның өтінішінен бас тарта алмаймын.Жарайды!
Dialogue: 0,0:05:18.69,0:05:22.40,Default,,0,0,0,,(Гонг пен барабан дыбысы)
Dialogue: 0,0:05:22.48,0:05:25.53,Default,,0,0,0,,Экономикаға пайдалы іспен айналысайық.
Dialogue: 0,0:05:25.61,0:05:27.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:27.61,0:05:28.87,Default,,0,0,0,,Орындарыңызға отырыңыз! Мұнда! Ах...
Dialogue: 0,0:05:28.87,0:05:31.03,Default,,0,0,0,,Орындарыңызға отырыңыз! Мұнда! Ах...
Dialogue: 0,0:05:28.87,0:05:31.03,Default,,0,0,0,,Экономика жақсы жұмыс істейді деп үміттенемін.
Dialogue: 0,0:05:31.12,0:05:35.04,Default,,0,0,0,,Ngggg... Маған енді ұнамайды!
Dialogue: 0,0:05:35.12,0:05:37.04,Default,,0,0,0,,- (Барабан ұстаған ер) Хии - (Үй мұғалімі) Фу
Dialogue: 0,0:05:37.12,0:05:39.04,Default,,0,0,0,,- (Оқушылар) Мии - (Барлығы) Ю
Dialogue: 0,0:05:39.13,0:05:44.13,Default,,0,0,0,,(Чиндония спектаклі)
Dialogue: 0,0:05:54.47,0:05:56.06,Default,,0,0,0,,Тотто-чан!
Dialogue: 0,0:05:57.14,0:05:58.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:04.65,0:06:06.90,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:06:06.99,0:06:08.20,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:09.95,0:06:13.08,Default,,0,0,0,,Аа, қақпа жерден өсіп жатыр.
Dialogue: 0,0:06:13.95,0:06:19.08,Default,,0,0,0,,Барған сайын үлкейіп барады, енді телефон бағанынан да биік.
Dialogue: 0,0:06:21.21,0:06:24.05,Default,,0,0,0,,Хмм?
Dialogue: 0,0:06:24.13,0:06:27.51,Default,,0,0,0,,Томое?
Dialogue: 0,0:06:29.88,0:06:31.72,Default,,0,0,0,,Томое академиясы
Dialogue: 0,0:06:31.80,0:06:34.35,Default,,0,0,0,,Бұл жаңа мектеп
Dialogue: 0,0:06:34.43,0:06:35.85,Default,,0,0,0,,Томое дегеніміз не?
Dialogue: 0,0:06:36.56,0:06:37.39,Default,,0,0,0,,Ах
Dialogue: 0,0:06:39.56,0:06:40.65,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:06:43.23,0:06:45.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:45.23,0:06:47.19,Default,,0,0,0,,Бұл нағыз пойыз ба?
Dialogue: 0,0:06:47.28,0:06:49.61,Default,,0,0,0,,Иә, бұл...
Dialogue: 0,0:06:49.70,0:06:50.86,Default,,0,0,0,,- Иә! -Ах!
Dialogue: 0,0:06:50.95,0:06:53.66,Default,,0,0,0,,Мен мінгім келеді, мінгім келеді, мен оны мінгім келеді!
Dialogue: 0,0:06:53.74,0:06:56.20,Default,,0,0,0,,Тотто-чан аааааа...
Dialogue: 0,0:06:56.29,0:06:57.87,Default,,0,0,0,,Ал... күте тұрыңыз!
Dialogue: 0,0:06:57.95,0:07:00.46,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:07:00.54,0:07:01.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:01.46,0:07:05.71,Default,,0,0,0,,Ммм... ммм... ммм
Dialogue: 0,0:07:05.80,0:07:06.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:06.71,0:07:08.63,Default,,0,0,0,,Ммм~
Dialogue: 0,0:07:08.71,0:07:10.09,Default,,0,0,0,,Ах
Dialogue: 0,0:07:10.17,0:07:12.09,Default,,0,0,0,,Хахаха... Ах!
Dialogue: 0,0:07:12.18,0:07:13.59,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:07:15.56,0:07:17.35,Default,,0,0,0,,- Уф! -(Ясуаки) А...
Dialogue: 0,0:07:17.43,0:07:19.98,Default,,0,0,0,,Жол жүру ~
Dialogue: 0,0:07:20.06,0:07:21.35,Default,,0,0,0,,№
Dialogue: 0,0:07:22.31,0:07:25.65,Default,,0,0,0,,Мынау мектептегі сынып.
Dialogue: 0,0:07:25.73,0:07:27.48,Default,,0,0,0,,Мен өз бетімше міне алмаймын.
Dialogue: 0,0:07:27.57,0:07:29.57,Default,,0,0,0,,Мен қалай жүре аламын?
Dialogue: 0,0:07:29.65,0:07:32.86,Default,,0,0,0,,Ол үшін мұнда студент болу керек.
Dialogue: 0,0:07:33.61,0:07:36.12,Default,,0,0,0,,Нару Абсолюттік Нару!
Dialogue: 0,0:07:36.20,0:07:40.12,Default,,0,0,0,,Алдымен директормен дұрыс сөйлесіңіз.
Dialogue: 0,0:07:40.20,0:07:41.62,Default,,0,0,0,,Уа!
Dialogue: 0,0:07:46.46,0:07:48.13,Default,,0,0,0,,
Dialogue: 0,0:07:48.21,0:07:49.55,Default,,0,0,0,,Иә
Dialogue: 0,0:07:49.63,0:07:51.42,Default,,0,0,0,,Бұл Куроянаги
Dialogue: 0,0:07:51.51,0:07:52.93,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:55.14,0:07:57.01,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:57.10,0:07:58.31,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:07:59.14,0:08:00.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:05.81,0:08:07.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:11.24,0:08:13.65,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:08:13.74,0:08:16.99,Default,,0,0,0,,Қайырлы таң, міне.
Dialogue: 0,0:08:17.07,0:08:18.41,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:08:18.49,0:08:22.16,Default,,0,0,0,,Қайсысы, директор немесе станциядағы адам?
Dialogue: 0,0:08:22.25,0:08:23.66,Default,,0,0,0,,- (Кобаяши) Иә? -Ах!
Dialogue: 0,0:08:23.75,0:08:24.75,Default,,0,0,0,,Жолдан кет! Эй!
Dialogue: 0,0:08:24.83,0:08:27.67,Default,,0,0,0,,Бұл баланың айтып тұрғаны...
Dialogue: 0,0:08:28.38,0:08:30.55,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:08:30.63,0:08:33.09,Default,,0,0,0,,Бұл негізгі.
Dialogue: 0,0:08:33.17,0:08:36.01,Default,,0,0,0,,Директор Кобаяши
Dialogue: 0,0:08:36.09,0:08:37.30,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:08:37.93,0:08:39.47,Default,,0,0,0,,Сәлем, Тотто-чан
Dialogue: 0,0:08:39.56,0:08:42.06,Default,,0,0,0,,Бұл шын мәнінде Тецуко
Dialogue: 0,0:08:42.14,0:08:45.19,Default,,0,0,0,,Әкем мені Тотто-суке деп атайды, сондықтан мен Тотто-чанмын.
Dialogue: 0,0:08:45.27,0:08:47.73,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:08:47.81,0:08:50.11,Default,,0,0,0,,Танысқаныма қуаныштымын, Тотто-чан
Dialogue: 0,0:08:50.19,0:08:53.28,Default,,0,0,0,,Мен осы мектепке түскім келеді
Dialogue: 0,0:08:53.36,0:08:55.70,Default,,0,0,0,,Олай болса пойызға отыруға болады, солай ма?
Dialogue: 0,0:08:55.78,0:08:57.45,Default,,0,0,0,,Ах... Тотто-чан
Dialogue: 0,0:08:57.53,0:09:01.20,Default,,0,0,0,,Хахахаха! Сіз оны мінсеңіз де
Dialogue: 0,0:09:01.29,0:09:06.17,Default,,0,0,0,,Бірақ бұған дейін мұғаліммен біраз сөйлесейік.
Dialogue: 0,0:09:06.25,0:09:08.46,Default,,0,0,0,,Сіз сөйлескенді жек көресіз бе?
Dialogue: 0,0:09:08.54,0:09:10.59,Default,,0,0,0,,Мен сені қатты жақсы көремін!
Dialogue: 0,0:09:15.59,0:09:16.88,Default,,0,0,0,,Осы жерге отырыңыз
Dialogue: 0,0:09:16.97,0:09:18.59,Default,,0,0,0,,- Иә! -О...
Dialogue: 0,0:09:18.68,0:09:21.81,Default,,0,0,0,,Анаң үйге қайтсын.
Dialogue: 0,0:09:21.89,0:09:23.35,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:09:24.14,0:09:25.85,Default,,0,0,0,,(Идзуми) Уау! Бұл өте қызықты естіледі.
Dialogue: 0,0:09:26.48,0:09:29.61,Default,,0,0,0,,Солай ма? Содан кейін...
Dialogue: 0,0:09:29.69,0:09:31.86,Default,,0,0,0,,Бес бос дәптер парағы
Dialogue: 0,0:09:35.40,0:09:37.03,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:39.62,0:09:41.20,Default,,0,0,0,,Бұл бөлме үшбұрышты!
Dialogue: 0,0:09:41.28,0:09:42.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:42.91,0:09:44.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:46.12,0:09:47.12,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:52.71,0:09:55.59,Default,,0,0,0,,Жүр, маған бірдеңе айт.
Dialogue: 0,0:09:55.67,0:09:57.72,Default,,0,0,0,,Сіз айтқыңыз келетін барлық нәрсе
Dialogue: 0,0:09:57.80,0:09:59.14,Default,,0,0,0,,- Барлығы? -(Кобаяши) Иә.
Dialogue: 0,0:09:59.22,0:10:02.10,Default,,0,0,0,,Білесіз бе, бұл өте жылдам болды.
Dialogue: 0,0:10:02.18,0:10:05.43,Default,,0,0,0,,Пейзаж артқа қарай ұшады.
Dialogue: 0,0:10:05.52,0:10:07.73,Default,,0,0,0,,Билеттер өте көп.
Dialogue: 0,0:10:07.81,0:10:10.40,Default,,0,0,0,,Саған берші деп өтіндім, бермедің.
Dialogue: 0,0:10:10.48,0:10:13.02,Default,,0,0,0,,Сіз Оймачи желісімен келдіңіз бе?
Dialogue: 0,0:10:13.11,0:10:13.94,Default,,0,0,0,,Иә
Dialogue: 0,0:10:14.03,0:10:17.78,Default,,0,0,0,,Мен бұрынғы мектебімдегі мұғалімімді жақсы көремін, өйткені оның жүзі әдемі.
Dialogue: 0,0:10:17.86,0:10:20.16,Default,,0,0,0,,Төбеде қарлығаштың ұясы бар.
Dialogue: 0,0:10:20.24,0:10:24.04,Default,,0,0,0,,«Сәлеметсіз бе, Қарлығаш мырза, қалыңыз қалай?»
Dialogue: 0,0:10:24.99,0:10:28.71,Default,,0,0,0,,«Дыбыс, менде бәрі жақсы».
Dialogue: 0,0:10:28.79,0:10:30.29,Default,,0,0,0,,Мен жауап бердім.
Dialogue: 0,0:10:30.37,0:10:31.92,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:10:32.00,0:10:35.55,Default,,0,0,0,,Рокки «Рахмет» және «Кешіріңіз» дейді
Dialogue: 0,0:10:35.63,0:10:37.76,Default,,0,0,0,,Сіз «қанағаттанған, қанағаттанған» бола аласыз
Dialogue: 0,0:10:37.84,0:10:40.68,Default,,0,0,0,,Құлағының іші сасық, бірақ иісі жақсы.
Dialogue: 0,0:10:40.76,0:10:43.18,Default,,0,0,0,,Балабақшада қайшы ойнап жүрген кезім
Dialogue: 0,0:10:43.26,0:10:46.47,Default,,0,0,0,,Олар маған айғайлап, тілімді кесемін дейді.
Dialogue: 0,0:10:46.56,0:10:48.43,Default,,0,0,0,,Мен мұны көп рет жасадым.
Dialogue: 0,0:10:48.52,0:10:50.39,Default,,0,0,0,,Мұрыннан су ағу кезінде
Dialogue: 0,0:10:50.48,0:10:53.19,Default,,0,0,0,,Жалқау болсам, мамам ұрсады.
Dialogue: 0,0:10:53.27,0:10:55.44,Default,,0,0,0,,Тезірек шайнаған дұрыс.
Dialogue: 0,0:10:56.23,0:10:57.69,Default,,0,0,0,,Сонда?
Dialogue: 0,0:10:58.32,0:11:00.24,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:11:01.28,0:11:02.91,Default,,0,0,0,,Уақытыңызды бөліңіз.
Dialogue: 0,0:11:08.29,0:11:09.41,Default,,0,0,0,,Я...
Dialogue: 0,0:11:10.54,0:11:12.42,Default,,0,0,0,,онда
Dialogue: 0,0:11:12.50,0:11:15.38,Default,,0,0,0,,Анам киім тігуге шебер.
Dialogue: 0,0:11:15.46,0:11:17.34,Default,,0,0,0,,Шүберекпен жабыңыз
Dialogue: 0,0:11:17.42,0:11:20.72,Default,,0,0,0,,Бұл сиқыр сияқты.
Dialogue: 0,0:11:20.80,0:11:23.93,Default,,0,0,0,,Ол киімді анаң да тіккен бе?
Dialogue: 0,0:11:24.76,0:11:26.97,Default,,0,0,0,,Жоқ, мен сатып алдым.
Dialogue: 0,0:11:27.06,0:11:30.73,Default,,0,0,0,,Негізі мен анам жасаған киімді киюім керек еді.
Dialogue: 0,0:11:30.81,0:11:33.94,Default,,0,0,0,,Бүгін сатып алған киімім жыртылып қалыпты.
Dialogue: 0,0:11:34.02,0:11:36.94,Default,,0,0,0,,Мына жағадағы кесте, мама, маған ұнамайды.
Dialogue: 0,0:11:37.02,0:11:40.28,Default,,0,0,0,,Менің әкем скрипкашы және концертмейстер.
Dialogue: 0,0:11:40.36,0:11:43.95,Default,,0,0,0,,Ол теңізде жақсы жүзеді, тіпті суға да түседі.
Dialogue: 0,0:11:44.03,0:11:46.78,Default,,0,0,0,,(Пластинкадан ойналатын музыка)
Dialogue: 0,0:11:46.87,0:11:49.20,Default,,0,0,0,,Хмм…
Dialogue: 0,0:11:49.87,0:11:51.46,Default,,0,0,0,,- Баяу! -(Сатушы) Уау!
Dialogue: 0,0:11:51.54,0:11:54.96,Default,,0,0,0,,Сонымен, сіз білесіз бе...
Dialogue: 0,0:11:55.54,0:11:57.71,Default,,0,0,0,,Енді жоқ па?
Dialogue: 0,0:11:57.80,0:11:59.63,Default,,0,0,0,,Хмм.
Dialogue: 0,0:12:02.68,0:12:07.43,Default,,0,0,0,,Неге мені бәрі қиналған бала дейді?
Dialogue: 0,0:12:07.51,0:12:10.47,Default,,0,0,0,,Мен Тотто-чан болсам да...
Dialogue: 0,0:12:17.36,0:12:18.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:23.11,0:12:28.49,Default,,0,0,0,,Сен шынымен жақсы қызсың.
Dialogue: 0,0:12:30.75,0:12:32.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:33.83,0:12:35.58,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,0:12:35.67,0:12:36.75,Default,,0,0,0,,Ах
Dialogue: 0,0:12:40.17,0:12:42.76,Default,,0,0,0,,Ei Ei Ei
Dialogue: 0,0:12:42.84,0:12:45.01,Default,,0,0,0,,Тотто-чан!
Dialogue: 0,0:12:45.09,0:12:46.51,Default,,0,0,0,,Ах
Dialogue: 0,0:12:52.73,0:12:55.77,Default,,0,0,0,,Бұл қалай болды?
Dialogue: 0,0:12:55.85,0:12:59.15,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:12:59.23,0:13:01.78,Default,,0,0,0,,Бүгіннен бастап сіз осы мектептің оқушысы боласыз!
Dialogue: 0,0:13:01.86,0:13:03.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:08.45,0:13:12.37,Default,,0,0,0,,Иә, жасағаныңызға қуаныштымын.
Dialogue: 0,0:13:12.45,0:13:13.37,Default,,0,0,0,,Иә
Dialogue: 0,0:13:13.45,0:13:16.21,Default,,0,0,0,,Маған бұл мектеп ұнады.
Dialogue: 0,0:13:16.29,0:13:17.83,Default,,0,0,0,,Директор
Dialogue: 0,0:13:17.92,0:13:19.34,Default,,0,0,0,,Анам да
Dialogue: 0,0:13:20.59,0:13:21.80,Default,,0,0,0,,Иә
Dialogue: 0,0:13:21.88,0:13:23.80,Default,,0,0,0,,Карамель!
Dialogue: 0,0:13:23.88,0:13:26.09,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:13:30.43,0:13:31.85,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:13:34.48,0:13:36.81,Default,,0,0,0,,Ах! Хмм!
Dialogue: 0,0:13:38.19,0:13:41.36,Default,,0,0,0,,Мектеп директорымен не туралы сөйлестіңіз?
Dialogue: 0,0:13:41.44,0:13:42.65,Default,,0,0,0,,Ол әйтеуір бас тарта ма еді?
Dialogue: 0,0:13:42.73,0:13:44.57,Default,,0,0,0,,Барлығы?
Dialogue: 0,0:13:44.65,0:13:47.49,Default,,0,0,0,,Бұл ұзақ болуы керек.
Dialogue: 0,0:13:51.20,0:13:52.41,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:13:52.49,0:13:53.54,Default,,0,0,0,,Сәлем
Dialogue: 0,0:13:53.62,0:13:55.04,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:14:01.75,0:14:02.96,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:14:03.05,0:14:04.59,Default,,0,0,0,,-Мен үйдемін -Ах
Dialogue: 0,0:14:05.38,0:14:07.01,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:14:10.26,0:14:12.30,Default,,0,0,0,,Томе қалай болды?
Dialogue: 0,0:14:12.39,0:14:14.10,Default,,0,0,0,,-Хехехе -Ой...
Dialogue: 0,0:14:15.06,0:14:18.44,Default,,0,0,0,,Ертеңнен бастап мектепке келуге қарсы емеспін дейді.
Dialogue: 0,0:14:19.19,0:14:20.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:20.65,0:14:24.28,Default,,0,0,0,,Жарайды, біріншіден, бұл жеңілдік.
Dialogue: 0,0:14:24.36,0:14:25.65,Default,,0,0,0,,Иә
Dialogue: 0,0:14:25.73,0:14:28.28,Default,,0,0,0,,Келесі жолы үйреніп кете аламын деп үміттенемін.
Dialogue: 0,0:14:33.12,0:14:35.29,Default,,0,0,0,,Кун
Dialogue: 0,0:15:01.19,0:15:02.40,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:15:24.67,0:15:26.67,Default,,0,0,0,,(Сыртқы шу)
Dialogue: 0,0:15:28.42,0:15:29.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:41.35,0:15:43.48,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:15:43.56,0:15:45.02,Default,,0,0,0,,(баспалдақтан құлаған дыбыс)
Dialogue: 0,0:15:46.44,0:15:47.94,Default,,0,0,0,,Тотто-чан...
Dialogue: 0,0:15:48.03,0:15:49.61,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:15:49.69,0:15:50.53,Default,,0,0,0,,Бір!
Dialogue: 0,0:15:56.62,0:15:58.29,Default,,0,0,0,,Түскі ас қорабы Түскі ас қорабы
Dialogue: 0,0:15:58.37,0:16:01.37,Default,,0,0,0,,Тотто-чан, сен маған екі жұмыртқа бере аласың ба?
Dialogue: 0,0:16:01.46,0:16:03.08,Default,,0,0,0,,Yes
Dialogue: 0,0:16:06.21,0:16:07.21,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:07.29,0:16:10.63,Default,,0,0,0,,Мама, мұз еріп жатыр.
Dialogue: 0,0:16:10.71,0:16:14.39,Default,,0,0,0,,Уайымдама, түске дейін келемін.
Dialogue: 0,0:16:17.39,0:16:18.22,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:22.81,0:16:24.90,Default,,0,0,0,,- Керемет! -хехе
Dialogue: 0,0:16:24.98,0:16:26.90,Default,,0,0,0,,Анам сізге түскі асыңызды жинап береді.
Dialogue: 0,0:16:26.98,0:16:28.57,Default,,0,0,0,,Маған нан әкеліңізші.
Dialogue: 0,0:16:28.65,0:16:29.65,Default,,0,0,0,,Yes
Dialogue: 0,0:16:29.73,0:16:31.49,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:16:32.53,0:16:34.03,Default,,0,0,0,,
Dialogue: 0,0:16:34.11,0:16:35.74,Default,,0,0,0,,Бұл жеткізу.
Dialogue: 0,0:16:35.82,0:16:38.20,Default,,0,0,0,,О, күшті адам
Dialogue: 0,0:16:38.28,0:16:40.83,Default,,0,0,0,,Тоцуке, бүгін ауа-райы қандай?
Dialogue: 0,0:16:40.91,0:16:42.00,Default,,0,0,0,,Yes
Dialogue: 0,0:16:42.08,0:16:45.71,Default,,0,0,0,,Келесіде мен Токио аймағына арналған ауа райы болжамын беремін.
Dialogue: 0,0:16:45.79,0:16:49.29,Default,,0,0,0,,Бүгін күн ашық болады.
Dialogue: 0,0:16:49.38,0:16:52.26,Default,,0,0,0,,Иә! Күн ашық
Dialogue: 0,0:16:53.30,0:16:54.76,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:16:54.84,0:16:56.34,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:16:56.43,0:16:57.85,Default,,0,0,0,,（）
Dialogue: 0,0:17:09.06,0:17:10.07,Default,,0,0,0,,Ах
Dialogue: 0,0:17:10.15,0:17:13.82,Default,,0,0,0,,Сіз мектептен қашпайсыз, сондықтан асықпай тамақтаныңыз.
Dialogue: 0,0:17:13.90,0:17:15.11,Default,,0,0,0,,Yes
Dialogue: 0,0:17:19.70,0:17:22.08,Default,,0,0,0,,Мама тез
Dialogue: 0,0:17:22.16,0:17:23.54,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:17:23.62,0:17:25.16,Default,,0,0,0,,Бір!
Dialogue: 0,0:17:26.37,0:17:30.09,Default,,0,0,0,,Иә, билеттің орнына жол жүру билеті.
Dialogue: 0,0:17:30.17,0:17:31.55,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:17:31.63,0:17:33.96,Default,,0,0,0,,Оны мойныңыздан түсірмеңіз
Dialogue: 0,0:17:34.05,0:17:35.34,Default,,0,0,0,,Жақсы қыз бол
Dialogue: 0,0:17:35.42,0:17:36.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:40.51,0:17:42.39,Default,,0,0,0,,Мен кетемін
Dialogue: 0,0:17:43.14,0:17:44.98,Default,,0,0,0,,Рокки
Dialogue: 0,0:17:45.06,0:17:47.06,Default,,0,0,0,,One one one one!
Dialogue: 0,0:17:47.64,0:17:49.65,Default,,0,0,0,,One one one one!
Dialogue: 0,0:17:50.19,0:17:51.40,Default,,0,0,0,,Иә
Dialogue: 0,0:17:52.90,0:17:54.86,Default,,0,0,0,,Жоқ, Рокки
Dialogue: 0,0:17:54.94,0:17:56.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:58.32,0:17:59.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:59.41,0:18:04.33,Default,,0,0,0,,Бұл менің пойызым, сондықтан Рокки пойызбен жүре алмайды.
Dialogue: 0,0:18:04.41,0:18:06.08,Default,,0,0,0,,Кун
Dialogue: 0,0:18:06.16,0:18:07.33,Default,,0,0,0,,-Иә! -Ах!
Dialogue: 0,0:18:07.41,0:18:10.42,Default,,0,0,0,,Рокки регулярларын да жасауға болады.
Dialogue: 0,0:18:10.50,0:18:12.09,Default,,0,0,0,,Мен мұны келесі жолы сұраймын.
Dialogue: 0,0:18:12.17,0:18:14.76,Default,,0,0,0,,Маған біраз қайтаруыңызды өтінемін.
Dialogue: 0,0:18:22.85,0:18:26.85,Default,,0,0,0,,Императорлық штаб-пәтер Әскери-теңіз бөлімінің хабарландыруы
Dialogue: 0,0:18:26.93,0:18:31.56,Default,,0,0,0,,Императорлық теңіз флотының Қытайдағы операциялық күштері өткен жылдан бері жалғасты.
Dialogue: 0,0:18:31.65,0:18:34.86,Default,,0,0,0,,Барлық филиалдар бойынша көптеген операциялар жүргізілді...
Dialogue: 0,0:18:39.45,0:18:40.86,Default,,0,0,0,,Хехехе
Dialogue: 0,0:18:41.78,0:18:42.62,Default,,0,0,0,,Ах
Dialogue: 0,0:18:48.79,0:18:51.63,Default,,0,0,0,,Ммм!
Dialogue: 0,0:18:52.50,0:18:54.13,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:18:58.22,0:19:00.34,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:19:00.43,0:19:01.72,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:19:01.80,0:19:03.18,Default,,0,0,0,,-Уау! -(Станция қызметкері) Уау!
Dialogue: 0,0:19:03.26,0:19:07.31,Default,,0,0,0,,Мама мұны маған жасады, сондықтан маған енді билет керек емес.
Dialogue: 0,0:19:07.39,0:19:12.02,Default,,0,0,0,,Пойыздағы сыныптар да қозғалмайды, сондықтан билет керек емес деп ойлаймын.
Dialogue: 0,0:19:12.10,0:19:15.23,Default,,0,0,0,,Қайырлы күн.
Dialogue: 0,0:19:18.36,0:19:20.49,Default,,0,0,0,,Біз ең әлсіз болғандықтан, сол күшті түсінетіндер бар.
Dialogue: 0,0:19:37.50,0:19:39.42,Default,,0,0,0,,Ммм... Ах.
Dialogue: 0,0:19:40.55,0:19:41.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:44.93,0:19:46.35,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:19:59.48,0:20:01.32,Default,,0,0,0,,Уау...
Dialogue: 0,0:20:20.13,0:20:21.34,Default,,0,0,0,,Ах
Dialogue: 0,0:20:23.68,0:20:24.97,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:20:25.05,0:20:30.10,Default,,0,0,0,,♪ Мен өте қуаныштымын.
Dialogue: 0,0:20:30.18,0:20:31.27,Default,,0,0,0,,♪ Неліктен?
Dialogue: 0,0:20:31.27,0:20:33.27,Default,,0,0,0,,♪ Неліктен?
Dialogue: 0,0:20:31.27,0:20:33.27,Default,,0,0,0,,(поезд мүйізі)
Dialogue: 0,0:20:33.35,0:20:35.02,Default,,0,0,0,,Иә? Ха!
Dialogue: 0,0:20:39.15,0:20:41.57,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:20:49.66,0:20:52.37,Default,,0,0,0,,Ах! Хехехе
Dialogue: 0,0:20:53.08,0:20:54.83,Default,,0,0,0,,(Жануарлар айқайлайды)
Dialogue: 0,0:20:56.21,0:20:57.33,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:20:59.92,0:21:02.34,Default,,0,0,0,,(Пілдің айқайы)
Dialogue: 0,0:21:29.28,0:21:31.28,Default,,0,0,0,,(Арыстанның ақыруы)
Dialogue: 0,0:21:34.62,0:21:35.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:36.42,0:21:39.13,Default,,0,0,0,,Ах... Ахахха!
Dialogue: 0,0:21:42.84,0:21:48.14,Default,,0,0,0,,(Дельфин дыбысы)
Dialogue: 0,0:21:53.72,0:21:55.31,Default,,0,0,0,,Уау...
Dialogue: 0,0:21:55.39,0:21:56.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:58.10,0:22:00.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:00.94,0:22:02.73,Default,,0,0,0,,Аму! Ах!
Dialogue: 0,0:22:02.82,0:22:04.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:04.23,0:22:06.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:07.07,0:22:07.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:09.61,0:22:11.41,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:22:11.49,0:22:14.87,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:22:14.95,0:22:15.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:20.21,0:22:22.04,Default,,0,0,0,,- (Мигита) Қайырлы таң - А?
Dialogue: 0,0:22:22.13,0:22:23.55,Default,,0,0,0,,Хмм, иә!
Dialogue: 0,0:22:24.38,0:22:25.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:26.21,0:22:28.43,Default,,0,0,0,,Ah~ сәтсіздік
Dialogue: 0,0:22:29.30,0:22:31.05,Default,,0,0,0,,- (Мигита) Хэхе - А?
Dialogue: 0,0:22:32.97,0:22:33.97,Default,,0,0,0,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:22:34.06,0:22:35.27,Default,,0,0,0,,(мектеп сөмкесінің салынған дыбысы)
Dialogue: 0,0:22:35.35,0:22:36.98,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:22:39.14,0:22:40.35,Default,,0,0,0,,Хехехе
Dialogue: 0,0:22:41.98,0:22:44.23,Default,,0,0,0,,-Мм? -(Мигита) Мен күткендей сәтсіздікке ұшырадым!
Dialogue: 0,0:22:54.99,0:22:57.12,Default,,0,0,0,,Хехехе
Dialogue: 0,0:22:57.20,0:22:58.62,Default,,0,0,0,,Уау
Dialogue: 0,0:23:00.71,0:23:01.71,Default,,0,0,0,,Бұл кеше келген қыз емес пе?
Dialogue: 0,0:23:01.71,0:23:02.75,Default,,0,0,0,,Бұл кеше келген қыз емес пе?
Dialogue: 0,0:23:01.71,0:23:02.75,Default,,0,0,0,,Барлығы, бүгіннен бастап Томенің жаңа достары болады.
Dialogue: 0,0:23:02.75,0:23:02.83,Default,,0,0,0,,Барлығы, бүгіннен бастап Томенің жаңа достары болады.
Dialogue: 0,0:23:02.83,0:23:04.04,Default,,0,0,0,,Барлығы, бүгіннен бастап Томенің жаңа достары болады.
Dialogue: 0,0:23:02.83,0:23:04.04,Default,,0,0,0,,Үлкен лента
Dialogue: 0,0:23:04.04,0:23:04.13,Default,,0,0,0,,Барлығы, Томоның бүгіннен бастап жаңа достары болады.
Dialogue: 0,0:23:04.13,0:23:05.88,Default,,0,0,0,,Барлығы, бүгіннен бастап Томенің жаңа достары болады.
Dialogue: 0,0:23:04.13,0:23:05.88,Default,,0,0,0,,Сіз қайдансыз?
Dialogue: 0,0:23:05.88,0:23:06.80,Default,,0,0,0,,Барлығы, бүгіннен бастап Томенің жаңа достары болады.
Dialogue: 0,0:23:06.80,0:23:07.26,Default,,0,0,0,,Барлығы, бүгіннен бастап Томенің жаңа достары болады.
Dialogue: 0,0:23:06.80,0:23:07.26,Default,,0,0,0,,Бір адамның көбеюі болады.
Dialogue: 0,0:23:07.26,0:23:07.92,Default,,0,0,0,,Бір адамның өсуі болады.
Dialogue: 0,0:23:07.92,0:23:08.30,Default,,0,0,0,,Бір адамның көбеюі болады.
Dialogue: 0,0:23:07.92,0:23:08.30,Default,,0,0,0,,Сәлем беруге болады ма?
Dialogue: 0,0:23:08.30,0:23:08.38,Default,,0,0,0,,Сәлем беруге болады ма?
Dialogue: 0,0:23:08.38,0:23:09.38,Default,,0,0,0,,Сәлем беруге болады ма?
Dialogue: 0,0:23:08.38,0:23:09.38,Default,,0,0,0,,Ол қандай бала?
Dialogue: 0,0:23:09.38,0:23:09.47,Default,,0,0,0,,Сәлем беруге бола ма?
Dialogue: 0,0:23:09.47,0:23:09.93,Default,,0,0,0,,Сәлем беруге болады ма?
Dialogue: 0,0:23:09.47,0:23:09.93,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:23:09.93,0:23:10.01,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:23:10.01,0:23:11.39,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:23:10.01,0:23:11.39,Default,,0,0,0,,Иә
Dialogue: 0,0:23:11.47,0:23:14.85,Default,,0,0,0,,Тецуко Куроянаги
Dialogue: 0,0:23:14.93,0:23:17.89,Default,,0,0,0,,Бұл Тецуко, бірақ бұл Тотто-чан.
Dialogue: 0,0:23:17.97,0:23:20.64,Default,,0,0,0,,- (Такахаши) Тот? -(Мигита) Бұл біртүрлі!
Dialogue: 0,0:23:20.73,0:23:23.86,Default,,0,0,0,,Сіз қалаған жерде отыра аласыз.
Dialogue: 0,0:23:23.94,0:23:26.69,Default,,0,0,0,,Мен терезенің жанында
Dialogue: 0,0:23:28.24,0:23:30.70,Default,,0,0,0,,Біз бәріміз біргеміз
Dialogue: 0,0:23:30.78,0:23:33.99,Default,,0,0,0,,Біз барлығын бірге жасаймыз.
Dialogue: 0,0:23:34.07,0:23:35.41,Default,,0,0,0,,Уа!
Dialogue: 0,0:23:36.12,0:23:39.41,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:23:41.62,0:23:45.17,Default,,0,0,0,,Иә, өзіңізге ұнайтын нәрседен бастаңыз.
Dialogue: 0,0:23:45.25,0:23:47.42,Default,,0,0,0,,-Иә - (Мигита) Түрлі түсті қарындаш
Dialogue: 0,0:23:47.50,0:23:49.34,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:23:49.42,0:23:50.42,Default,,0,0,0,,Иә
Dialogue: 0,0:23:50.51,0:23:55.43,Default,,0,0,0,,♪ Ит үреді
Dialogue: 0,0:23:55.51,0:23:57.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:55.51,0:23:57.35,Default,,0,0,0,,♪ Почи жылап жатыр
Dialogue: 0,0:23:57.35,0:23:58.01,Default,,0,0,0,,♪ Почи жылап жатыр
Dialogue: 0,0:23:58.01,0:23:59.89,Default,,0,0,0,,♪ Почи жылап жатыр
Dialogue: 0,0:23:58.01,0:23:59.89,Default,,0,0,0,,Хмм.
Dialogue: 0,0:23:59.89,0:23:59.98,Default,,0,0,0,,♪ Почи жылап жатыр
Dialogue: 0,0:23:59.98,0:24:01.18,Default,,0,0,0,,♪ Почи жылап жатыр
Dialogue: 0,0:23:59.98,0:24:01.18,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:24:01.18,0:24:02.35,Default,,0,0,0,,Ах... Уау!
Dialogue: 0,0:24:04.15,0:24:05.94,Default,,0,0,0,,Хехехе
Dialogue: 0,0:24:06.02,0:24:07.94,Default,,0,0,0,,Ой... ой
Dialogue: 0,0:24:06.02,0:24:07.94,Default,,0,0,0,,♪ Хохокекё Хохокекё
Dialogue: 0,0:24:07.94,0:24:10.44,Default,,0,0,0,,♪ Хохокекё Хохокекё
Dialogue: 0,0:24:10.53,0:24:13.03,Default,,0,0,0,,♪ Кекио Кекио Кекио Кекио Хохо Кекио
Dialogue: 0,0:24:13.03,0:24:15.45,Default,,0,0,0,,♪ Кекио Кекио Кекио Кекио Хохо Кекио
Dialogue: 0,0:24:13.03,0:24:15.45,Default,,0,0,0,,Хо хо хо хо
Dialogue: 0,0:24:16.91,0:24:22.54,Default,,0,0,0,,(аралас аяқ дыбысы)
Dialogue: 0,0:24:22.62,0:24:23.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:23.54,0:24:26.54,Default,,0,0,0,,(аралас аяқ дыбысы)
Dialogue: 0,0:24:30.51,0:24:32.47,Default,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,0:24:32.55,0:24:35.01,Default,,0,0,0,,Қайталап көріңіз.
Dialogue: 0,0:24:35.09,0:24:36.30,Default,,0,0,0,,Иә
Dialogue: 0,0:24:39.64,0:24:40.47,Default,,0,0,0,,Ах
Dialogue: 0,0:24:44.56,0:24:45.98,Default,,0,0,0,,Хехехе
Dialogue: 0,0:24:47.06,0:24:48.48,Default,,0,0,0,,Хехе
Dialogue: 0,0:24:56.57,0:24:58.99,Default,,0,0,0,,Неге олай жүресің?
Dialogue: 0,0:24:59.08,0:25:00.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:00.87,0:25:04.00,Default,,0,0,0,,Менде полиомиелит бар
Dialogue: 0,0:25:04.08,0:25:06.50,Default,,0,0,0,,Шиони параличі?
Dialogue: 0,0:25:12.09,0:25:13.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:15.55,0:25:18.51,Default,,0,0,0,,Бұл тек аяғың емес, қолың да.
Dialogue: 0,0:25:20.14,0:25:21.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:26.48,0:25:28.15,Default,,0,0,0,,Салқын.
Dialogue: 0,0:25:31.02,0:25:33.15,Default,,0,0,0,,Емделмеген бе?
Dialogue: 0,0:25:33.78,0:25:34.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:25:38.24,0:25:39.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:42.70,0:25:45.75,Default,,0,0,0,,Мен Ясуаки Ямамотомын
Dialogue: 0,0:25:45.83,0:25:47.17,Default,,0,0,0,,Сен…
Dialogue: 0,0:25:47.25,0:25:48.79,Default,,0,0,0,,Ахаха
Dialogue: 0,0:25:48.88,0:25:50.50,Default,,0,0,0,,Сәлем Тотто-чан
Dialogue: 0,0:25:53.00,0:25:54.42,Default,,0,0,0,,Түс болды. Түс болды.
Dialogue: 0,0:25:54.51,0:25:56.17,Default,,0,0,0,,Түскі ас!
Dialogue: 0,0:25:58.55,0:26:00.18,Default,,0,0,0,,Онда тағы бір адамды кіргізейік.
Dialogue: 0,0:26:00.26,0:26:03.93,Default,,0,0,0,,А... басқа балалар қайда?
Dialogue: 0,0:26:04.02,0:26:05.48,Default,,0,0,0,,Барлығы солай.
Dialogue: 0,0:26:05.56,0:26:07.31,Default,,0,0,0,,Барлығы?
Dialogue: 0,0:26:07.39,0:26:10.19,Default,,0,0,0,,Менің бұрынғы мектебімнен әлдеқайда аз
Dialogue: 0,0:26:11.11,0:26:12.40,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:26:12.48,0:26:16.19,Default,,0,0,0,,Теңізден, таудан бірдеңе әкелдің бе?
Dialogue: 0,0:26:16.28,0:26:18.20,Default,,0,0,0,,(Оқушылардың жауаптары)
Dialogue: 0,0:26:18.28,0:26:22.45,Default,,0,0,0,,Албырт – теңізден, Кинпира – таудан.
Dialogue: 0,0:26:22.53,0:26:26.20,Default,,0,0,0,,Теңізге, Такуанга тауына ұмтылу
Dialogue: 0,0:26:26.29,0:26:29.71,Default,,0,0,0,,Ет тау, конняку теңіз
Dialogue: 0,0:26:30.33,0:26:32.63,Default,,0,0,0,,Конняку жүзе ала ма?
Dialogue: 0,0:26:32.71,0:26:35.05,Default,,0,0,0,,Иә? Жүзу мүмкін емес пе?
Dialogue: 0,0:26:35.13,0:26:39.84,Default,,0,0,0,,Конняку картоптан жасалған, сондықтан ол таудан келеді.
Dialogue: 0,0:26:39.93,0:26:42.22,Default,,0,0,0,,Әй, теңіз!
Dialogue: 0,0:26:42.30,0:26:44.22,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:26:46.81,0:26:49.23,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:26:50.69,0:26:53.48,Default,,0,0,0,,Уау... (Жұтынған дыбыс)
Dialogue: 0,0:26:54.23,0:26:56.99,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:26:57.94,0:26:59.61,Default,,0,0,0,,Хмм?
Dialogue: 0,0:26:59.70,0:27:00.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:27:07.25,0:27:08.46,Default,,0,0,0,,Ах
Dialogue: 0,0:27:11.96,0:27:14.38,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:27:14.46,0:27:18.38,Default,,0,0,0,,Әдемі, гүл бақшасындай.
Dialogue: 0,0:27:18.47,0:27:20.09,Default,,0,0,0,,Хехехе
Dialogue: 0,0:27:20.18,0:27:22.39,Default,,0,0,0,,Анам гарнир жасауды жақсы біледі.
Dialogue: 0,0:27:23.05,0:27:25.76,Default,,0,0,0,,Денбу теңіз ме? Тау?
Dialogue: 0,0:27:25.85,0:27:29.39,Default,,0,0,0,,Жарайды, тау сияқты...
Dialogue: 0,0:27:30.14,0:27:31.60,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:27:31.69,0:27:33.40,Default,,0,0,0,,Хмм
Dialogue: 0,0:27:33.48,0:27:38.40,Default,,0,0,0,,Барлығы, Денбу теңіз бе, тау ба?
Dialogue: 0,0:27:38.49,0:27:43.91,Default,,0,0,0,,- (ауызша) Теңіз теңізі! -(Музыка) Тау, тау!
Dialogue: 0,0:27:44.91,0:27:46.95,Default,,0,0,0,,Жауабы теңіз
Dialogue: 0,0:27:47.04,0:27:51.50,Default,,0,0,0,,Денбу балықтың етін қопсытып, қуыру арқылы жасалады.
Dialogue: 0,0:27:51.58,0:27:53.42,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:27:53.50,0:27:56.42,Default,,0,0,0,,Мұғалім, қарап шығуға болады ма?
Dialogue: 0,0:27:56.50,0:27:58.51,Default,,0,0,0,,- (Такахаши) Мен де! -(Аоки) Қарап көрейік.
Dialogue: 0,0:27:58.59,0:28:00.30,Default,,0,0,0,,- (Дэй) Қайсысы? -(Мигита) Көрсет, көрсет.
Dialogue: 0,0:28:00.38,0:28:01.80,Default,,0,0,0,,Уф!
Dialogue: 0,0:28:01.88,0:28:04.80,Default,,0,0,0,,Уау, иә!
Dialogue: 0,0:28:05.43,0:28:08.81,Default,,0,0,0,,Олай болса, кеттік, бүгін де көңілді ән айтайық.
Dialogue: 0,0:28:08.89,0:28:11.81,Default,,0,0,0,,Ендеше менің қалпына келу қабілетім…
Dialogue: 0,0:28:12.48,0:28:16.82,Default,,0,0,0,,(фортепиано прелюдиясы)
Dialogue: 0,0:28:18.07,0:28:23.32,Default,,0,0,0,,♪ Тамағыңызды жақсылап жеңіз.
Dialogue: 0,0:28:23.41,0:28:29.08,Default,,0,0,0,,♪ Тасбақа, тасбақа, тасбақа, тасбақа, тағам
Dialogue: 0,0:28:29.16,0:28:34.75,Default,,0,0,0,,♪ Тамағыңызды жақсылап жеңіз.
Dialogue: 0,0:28:34.83,0:28:40.09,Default,,0,0,0,,♪ Тасбақа, тасбақа, тасбақа, тасбақа, тағам
Dialogue: 0,0:28:40.80,0:28:43.09,Default,,0,0,0,,Itadadakimasu!
Dialogue: 0,0:28:52.18,0:28:58.61,Default,,0,0,0,,♪ Зорлау гүлдеріне көбелек қонады
Dialogue: 0,0:28:58.69,0:29:03.53,Default,,0,0,0,,♪ Күріш алқабындағы бәйшешек сары.
Dialogue: 0,0:29:03.61,0:29:08.20,Default,,0,0,0,,♪ Күріш алқабындағы лотос қызыл түсті.
Dialogue: 0,0:29:08.28,0:29:09.12,Default,,0,0,0,,Хахаха
Dialogue: 0,0:29:09.20,0:29:10.74,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:29:10.83,0:29:12.16,Default,,0,0,0,,Ағай!
Dialogue: 0,0:29:12.25,0:29:14.08,Default,,0,0,0,,Түстен кейін оқу туралы не айтасыз?
Dialogue: 0,0:29:14.16,0:29:16.62,Default,,0,0,0,,Мен ерте бітірдім, сондықтан серуендеуге барамын.
Dialogue: 0,0:29:16.71,0:29:18.75,Default,,0,0,0,,- (Miyo Sax Office) Rock Paper Scissors Pon! -(Такахаши) Сенсей!
Dialogue: 0,0:29:18.84,0:29:20.63,Default,,0,0,0,,Мен сол жаққа барып қарап көрсем бола ма?
Dialogue: 0,0:29:20.71,0:29:22.63,Default,,0,0,0,,Жақсы, бірақ сақ болыңыз.
Dialogue: 0,0:29:22.71,0:29:24.26,Default,,0,0,0,,Уа, ау, ау
Dialogue: 0,0:29:24.34,0:29:25.88,Default,,0,0,0,,-(Салық басқармасы) Уууу Уау~ -Ахаха!
Dialogue: 0,0:29:25.97,0:29:28.89,Default,,0,0,0,,Уф~ Ахха!
Dialogue: 0,0:29:30.97,0:29:32.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:32.31,0:29:37.15,Default,,0,0,0,,(Мигитаның күлкісі)
Dialogue: 0,0:29:38.52,0:29:39.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:29:42.23,0:29:44.65,Default,,0,0,0,,Ууууууууу...
Dialogue: 0,0:29:45.61,0:29:48.45,Default,,0,0,0,,Бұл жерде аққан жұлдыз түсті дейді.
Dialogue: 0,0:29:48.53,0:29:50.78,Default,,0,0,0,,А... аққан жұлдыз?
Dialogue: 0,0:30:01.88,0:30:03.88,Default,,0,0,0,,Сіз оны көре аласыз ба?
Dialogue: 0,0:30:03.96,0:30:05.59,Default,,0,0,0,,Мырза, ол сіз бе едіңіз?
Dialogue: 0,0:30:05.67,0:30:08.84,Default,,0,0,0,,Жұлдыз, ұйықтап жатқан жоқсың ба?
Dialogue: 0,0:30:08.93,0:30:12.68,Default,,0,0,0,,Жұлдыздар... ұйықтай ма?
Dialogue: 0,0:30:13.60,0:30:17.52,Default,,0,0,0,,♪ Кіріңіз, жас ханым.
Dialogue: 0,0:30:17.60,0:30:19.31,Default,,0,0,0,,♪ Рахмет
Dialogue: 0,0:30:19.40,0:30:21.15,Default,,0,0,0,,Жанкенпон
Dialogue: 0,0:30:22.07,0:30:23.61,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:30:23.69,0:30:24.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:30:29.16,0:30:33.20,Default,,0,0,0,,Ясуаки-чан серуендеуге бармай ма?
Dialogue: 0,0:30:33.28,0:30:34.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:30:36.00,0:30:39.75,Default,,0,0,0,,Өйткені мен баяу жүремін
Dialogue: 0,0:30:42.59,0:30:48.01,Default,,0,0,0,,Барлығы бірге жүреді деп ойлаймын.
Dialogue: 0,0:30:50.05,0:30:53.43,Default,,0,0,0,,Мен кітап оқығанды ​​ұнатамын.
Dialogue: 0,0:30:53.51,0:30:57.60,Default,,0,0,0,,Бірақ сіз сыныпта барлық кітаптарды оқисыз, солай ма?
Dialogue: 0,0:30:58.18,0:30:59.52,Default,,0,0,0,,Иә...
Dialogue: 0,0:30:59.60,0:31:02.48,Default,,0,0,0,,Үйіңізде бар кітапты әкелемін.
Dialogue: 0,0:31:17.08,0:31:18.79,Default,,0,0,0,,Демек, жұлдыздар
Dialogue: 0,0:31:18.87,0:31:22.58,Default,,0,0,0,,Күндіз ұйықтамай, түнде тұрмайсың ба? Мен осылай дедім
Dialogue: 0,0:31:22.67,0:31:24.79,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:31:24.88,0:31:26.80,Default,,0,0,0,,Мен сенімдімін.
Dialogue: 0,0:31:26.88,0:31:30.80,Default,,0,0,0,,Сізге Totsuke Tomoe Academy ұнай ма?
Dialogue: 0,0:31:30.88,0:31:32.14,Default,,0,0,0,,Иә
Dialogue: 0,0:31:32.22,0:31:35.31,Default,,0,0,0,,Ешқашан демалмаңыз, жалғастырыңыз
Dialogue: 0,0:31:37.89,0:31:41.10,Default,,0,0,0,,Жарайды, жоғарыға шығайық.
Dialogue: 0,0:31:44.02,0:31:45.06,Default,,0,0,0,,-Ио -Ммм
Dialogue: 0,0:31:45.15,0:31:47.40,Default,,0,0,0,,-♪ сурет -♪ Сәбіз
Dialogue: 0,0:31:47.48,0:31:49.65,Default,,0,0,0,,-♪ Саншони -♪ Шиитаке саңырауқұлағы
Dialogue: 0,0:31:49.74,0:31:51.74,Default,,0,0,0,,-♪ Репуск -♪ Мукаго
Dialogue: 0,0:31:51.82,0:31:54.03,Default,,0,0,0,,-♪ Нанакуса -♪ Йегони
Dialogue: 0,0:31:54.12,0:31:56.37,Default,,0,0,0,,-♪ Куваете -♪ Тойо
Dialogue: 0,0:32:04.83,0:32:07.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:07.80,0:32:10.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:11.42,0:32:14.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:32:15.01,0:32:16.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:17.85,0:32:20.68,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:32:23.31,0:32:24.73,Default,,0,0,0,,Я...
Dialogue: 0,0:32:25.90,0:32:27.11,Default,,0,0,0,,Ах
Dialogue: 0,0:32:29.69,0:32:32.32,Default,,0,0,0,,Зенитсу! Иносуке!
Dialogue: 0,0:32:32.40,0:32:34.36,Default,,0,0,0,,Хмм… Қалай?
Dialogue: 0,0:32:35.82,0:32:37.91,Default,,0,0,0,,Тоған сияқты
Dialogue: 0,0:32:40.08,0:32:41.12,Default,,0,0,0,,Уф!
Dialogue: 0,0:32:41.20,0:32:44.87,Default,,0,0,0,,Куу~ Шашып кетеді~
Dialogue: 0,0:32:44.96,0:32:47.88,Default,,0,0,0,,(сырылып жатқан нәжістің дыбысы)
Dialogue: 0,0:32:51.71,0:32:53.55,Default,,0,0,0,,Уф...
Dialogue: 0,0:32:54.18,0:32:56.01,Default,,0,0,0,,Ммм
Dialogue: 0,0:32:57.51,0:32:58.60,Default,,0,0,0,,Хмм?
Dialogue: 0,0:32:58.68,0:33:02.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:02.23,0:33:04.14,Default,,0,0,0,,Хмм.
Dialogue: 0,0:33:18.70,0:33:21.04,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:33:21.12,0:33:24.16,Default,,0,0,0,,Мен әмиянымды әжетханаға тастадым.
Dialogue: 0,0:33:24.25,0:33:25.67,Default,,0,0,0,,Хмм.
Dialogue: 0,0:33:27.13,0:33:28.54,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:33:30.34,0:33:32.84,Default,,0,0,0,,♪ Тасбақа, тасбақа, тасбақа, тасбақа
Dialogue: 0,0:33:32.92,0:33:35.26,Default,,0,0,0,,♪ тағам
Dialogue: 0,0:33:43.31,0:33:45.27,Default,,0,0,0,,- (Кобаяши) Жылы ма? -Аа...
Dialogue: 0,0:33:45.35,0:33:48.02,Default,,0,0,0,,Әмияныңыз жылы ма?
Dialogue: 0,0:33:48.98,0:33:50.19,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:33:51.94,0:33:52.78,Default,,0,0,0,,Хмф!
Dialogue: 0,0:33:58.24,0:34:01.28,Default,,0,0,0,,Жұмысты аяқтағаннан кейін барлығын орнына қойыңыз.
Dialogue: 0,0:34:04.04,0:34:05.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:05.91,0:34:08.96,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,0:34:09.04,0:34:11.25,Default,,0,0,0,,Қайтару…
Dialogue: 0,0:34:13.55,0:34:15.76,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:34:18.80,0:34:20.47,Default,,0,0,0,,
Dialogue: 0,0:34:20.55,0:34:23.68,Default,,0,0,0,,Өтінемін (есіктің ашылған дыбысы)
Dialogue: 0,0:34:25.56,0:34:27.89,Default,,0,0,0,,Сіз оны таптыңыз ба?
Dialogue: 0,0:34:27.98,0:34:29.48,Default,,0,0,0,,Жоқ
Dialogue: 0,0:34:31.19,0:34:33.02,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:34:33.11,0:34:35.49,Default,,0,0,0,,Себебі мен көп іздедім
Dialogue: 0,0:34:43.28,0:34:45.12,Default,,0,0,0,,Рахмет
Dialogue: 0,0:34:47.54,0:34:49.50,Default,,0,0,0,,- (Рокки) Бір, бір, бір! -иә?
Dialogue: 0,0:34:49.58,0:34:50.83,Default,,0,0,0,,- (Вокзал қызметкерлері) Өтінемін - Мм...
Dialogue: 0,0:34:50.92,0:34:51.75,Default,,0,0,0,,Бір!
Dialogue: 0,0:34:52.84,0:34:54.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:34:54.59,0:34:56.59,Default,,0,0,0,,Мама!
Dialogue: 0,0:34:58.88,0:35:03.81,Default,,0,0,0,,Директор барлығын қайтару керектігін айтты.
Dialogue: 0,0:35:03.89,0:35:05.56,Default,,0,0,0,,Тағы бірдеңе бар ма?
Dialogue: 0,0:35:05.64,0:35:07.48,Default,,0,0,0,,Сізге ұрысып қалған жоқсыз ба?
Dialogue: 0,0:35:07.56,0:35:09.27,Default,,0,0,0,,Жоқ
Dialogue: 0,0:35:10.65,0:35:12.65,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:35:12.73,0:35:14.57,Default,,0,0,0,,Содан кейін ваннаны қабылдаңыз
Dialogue: 0,0:35:14.65,0:35:17.11,Default,,0,0,0,,Миё-чан маған киімін қарызға берді.
Dialogue: 0,0:35:20.36,0:35:22.37,Default,,0,0,0,,Бір!
Dialogue: 0,0:35:37.88,0:35:39.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:35:39.92,0:35:41.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:41.88,0:35:43.30,Default,,0,0,0,,Ах
Dialogue: 0,0:35:44.51,0:35:46.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:35:51.69,0:35:53.27,Default,,0,0,0,,Ясуаки-чан
Dialogue: 0,0:35:53.35,0:35:56.27,Default,,0,0,0,,Мен сені Тотто-чанның ағашына шақырамын.
Dialogue: 0,0:35:56.36,0:35:57.82,Default,,0,0,0,,Рахмет
Dialogue: 0,0:35:57.90,0:36:01.28,Default,,0,0,0,,Бірақ мен ағашқа шыға алмаймын.
Dialogue: 0,0:36:01.36,0:36:02.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:03.66,0:36:05.45,Default,,0,0,0,,Хмм.
Dialogue: 0,0:36:06.70,0:36:07.95,Default,,0,0,0,,Иә
Dialogue: 0,0:36:09.08,0:36:10.96,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:36:11.96,0:36:13.96,Default,,0,0,0,,♬~
Dialogue: 0,0:36:14.04,0:36:17.55,Default,,0,0,0,,Сіз тырыспайынша білмейсіз
Dialogue: 0,0:36:17.63,0:36:19.96,Default,,0,0,0,,Ол L-дің атын білген бойда мен тергеу штабын түгел жоямын.
Dialogue: 0,0:36:21.88,0:36:23.51,Default,,0,0,0,,- (Ясуаки) Ах! -Апыр-ай!
Dialogue: 0,0:36:26.14,0:36:28.47,Default,,0,0,0,,(Ясумейдің жөтелі)
Dialogue: 0,0:36:28.56,0:36:30.43,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:36:31.27,0:36:33.48,Default,,0,0,0,,Өте қиын!
Dialogue: 0,0:36:33.56,0:36:35.86,Default,,0,0,0,,- (Дэй) Не? -не болды?
Dialogue: 0,0:36:35.94,0:36:39.73,Default,,0,0,0,,Бүгін кешке мектепке жаңа пойыз келеді.
Dialogue: 0,0:36:39.82,0:36:40.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:36:41.74,0:36:44.20,Default,,0,0,0,,Біз мұнда қалай жетеміз?
Dialogue: 0,0:36:44.28,0:36:46.53,Default,,0,0,0,,Оймачи сызығында жүгіру
Dialogue: 0,0:36:46.62,0:36:48.99,Default,,0,0,0,,Темір жол өткелінен келе жатқан жоқ па?
Dialogue: 0,0:36:49.08,0:36:51.12,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:36:51.20,0:36:52.50,Default,,0,0,0,,Хехехе
Dialogue: 0,0:36:52.58,0:36:54.79,Default,,0,0,0,,Оны арбамен тасымалдау
Dialogue: 0,0:36:54.87,0:36:57.50,Default,,0,0,0,,Мен көтере алмаймын, тым үлкен.
Dialogue: 0,0:36:57.59,0:37:00.38,Default,,0,0,0,,Піл оны тарта алады
Dialogue: 0,0:37:00.46,0:37:02.76,Default,,0,0,0,,Пілді қалай тасымалдайсың?
Dialogue: 0,0:37:02.84,0:37:05.13,Default,,0,0,0,,Хмм.
Dialogue: 0,0:37:05.22,0:37:07.26,Default,,0,0,0,,- Түсіндім! -(Барлығы) иә?
Dialogue: 0,0:37:07.35,0:37:09.39,Default,,0,0,0,,Жолдар
Dialogue: 0,0:37:09.47,0:37:13.77,Default,,0,0,0,,Сіз оны мектепке дейін төсемейсіз бе?
Dialogue: 0,0:37:14.35,0:37:15.56,Default,,0,0,0,,Моги мырза шынымен де әсерлі адам, білесің бе
Dialogue: 0,0:37:15.65,0:37:16.69,Default,,0,0,0,,Ах
Dialogue: 0,0:37:16.77,0:37:19.82,Default,,0,0,0,,Қайдан...
Dialogue: 0,0:37:19.90,0:37:21.28,Default,,0,0,0,,Моги мырза шынымен де әсерлі адам, білесің бе
Dialogue: 0,0:37:21.36,0:37:23.99,Default,,0,0,0,,Я...
Dialogue: 0,0:37:24.57,0:37:25.82,Default,,0,0,0,,Тек
Dialogue: 0,0:37:25.91,0:37:29.83,Default,,0,0,0,,Үйге барма, пойыз қай жерде келе жатқанын көрейік.
Dialogue: 0,0:37:29.91,0:37:32.29,Default,,0,0,0,,Мен әкемнен сұраймын.
Dialogue: 0,0:37:35.00,0:37:36.79,Default,,0,0,0,,-Йоишо-(Дэйи) Иә?
Dialogue: 0,0:37:36.87,0:37:39.38,Default,,0,0,0,,- (Дэй) Баспа - мен оны баспаймын.
Dialogue: 0,0:37:39.46,0:37:41.05,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:37:41.13,0:37:42.34,Default,,0,0,0,,Уау
Dialogue: 0,0:37:44.47,0:37:45.68,Default,,0,0,0,,Ах
Dialogue: 0,0:37:49.55,0:37:51.31,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:37:51.89,0:37:56.31,Default,,0,0,0,,Пойыз түнде өте кеш келеді.
Dialogue: 0,0:37:56.39,0:37:58.31,Default,,0,0,0,,Иә...
Dialogue: 0,0:37:58.40,0:38:00.69,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:38:00.77,0:38:04.32,Default,,0,0,0,,Іш киім мен түнгі көйлегіңді әкел де, мектепке кел!
Dialogue: 0,0:38:04.40,0:38:05.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:05.65,0:38:08.07,Default,,0,0,0,,Уау, олар керемет көрінеді!
Dialogue: 0,0:38:31.26,0:38:32.85,Default,,0,0,0,,Ясуаки-сан
Dialogue: 0,0:38:32.93,0:38:36.23,Default,,0,0,0,,Мен саған ауыстыратын киім қалдырамын.
Dialogue: 0,0:38:36.31,0:38:37.52,Default,,0,0,0,,Иә
Dialogue: 0,0:38:47.15,0:38:48.78,Default,,0,0,0,,Фу…
Dialogue: 0,0:38:54.83,0:38:57.29,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:38:57.37,0:38:58.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:00.21,0:39:02.38,Default,,0,0,0,,Бүгін түнде...
Dialogue: 0,0:39:04.80,0:39:05.88,Default,,0,0,0,,Маған келесі сұраққа жауап бер.
Dialogue: 0,0:39:09.30,0:39:11.39,Default,,0,0,0,,Тіпті толық ай
Dialogue: 0,0:39:13.39,0:39:14.81,Default,,0,0,0,,Иә
Dialogue: 0,0:39:22.44,0:39:24.61,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:39:24.69,0:39:27.53,Default,,0,0,0,,Пойыз келді!
Dialogue: 0,0:39:27.61,0:39:30.82,Default,,0,0,0,,( Төсектен жүгіріп шыққан дыбыс)
Dialogue: 0,0:39:30.91,0:39:33.99,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:39:34.08,0:39:34.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:41.33,0:39:42.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:47.96,0:39:49.17,Default,,0,0,0,,Мұнда
Dialogue: 0,0:40:05.61,0:40:07.53,Default,,0,0,0,,Уау...
Dialogue: 0,0:40:13.03,0:40:16.12,Default,,0,0,0,,Жарайды
Dialogue: 0,0:40:16.20,0:40:18.54,Default,,0,0,0,,Жарайды
Dialogue: 0,0:40:30.63,0:40:34.55,Default,,0,0,0,,Жақсы! Жақсы!
Dialogue: 0,0:40:35.18,0:40:38.10,Default,,0,0,0,,Мұғалім, бұл не?
Dialogue: 0,0:40:38.18,0:40:39.68,Default,,0,0,0,,Ол Коро деп аталады.
Dialogue: 0,0:40:39.77,0:40:44.56,Default,,0,0,0,,Пойызды жылжыту үшін домалау бөренелерінің күші қолданылады.
Dialogue: 0,0:40:45.52,0:40:48.57,Default,,0,0,0,,Кабинет неше сыныпқа арналған?
Dialogue: 0,0:40:48.65,0:40:50.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:50.11,0:40:53.32,Default,,0,0,0,,Хехе, сен қалай ойлайсың?
Dialogue: 0,0:40:53.40,0:40:55.28,Default,,0,0,0,,-Айтшы - (Тай) Айтшы.
Dialogue: 0,0:40:55.36,0:40:58.24,Default,,0,0,0,,-Ей, айтшы. -(Ясу) Сенсэй, айтшы.
Dialogue: 0,0:40:59.41,0:41:02.33,Default,,0,0,0,,Польнарефф, рөл артында бәрі жақсы ма?
Dialogue: 0,0:41:02.41,0:41:04.33,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:41:13.42,0:41:15.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:15.72,0:41:16.84,Default,,0,0,0,,Ах
Dialogue: 0,0:41:16.93,0:41:19.10,Default,,0,0,0,,Ах
Dialogue: 0,0:41:19.18,0:41:20.72,Default,,0,0,0,,Ясуаки-чан!
Dialogue: 0,0:41:20.81,0:41:22.68,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:41:24.19,0:41:26.15,Default,,0,0,0,,Тез, тез
Dialogue: 0,0:41:26.85,0:41:28.61,Default,,0,0,0,,Хмм… Қалай?
Dialogue: 0,0:41:32.69,0:41:34.11,Default,,0,0,0,,Уау...
Dialogue: 0,0:41:34.20,0:41:37.99,Default,,0,0,0,,Жаңа пойыз кітапхана болды!
Dialogue: 0,0:41:38.07,0:41:39.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:41:41.12,0:41:42.62,Default,,0,0,0,,Өте жақсы, солай ма?
Dialogue: 0,0:41:43.29,0:41:45.12,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:41:46.00,0:41:49.21,Default,,0,0,0,,Бәріңе сәлем, өтінемін бе?
Dialogue: 0,0:41:49.29,0:41:53.30,Default,,0,0,0,,Күн ыстық болды, сондықтан мен бассейнге су толтыруды ойлап отырмын.
Dialogue: 0,0:41:53.38,0:41:56.13,Default,,0,0,0,,(қуаныш дыбыстары)
Dialogue: 0,0:42:00.30,0:42:04.06,Default,,0,0,0,,Директор! Менде купальник жоқ
Dialogue: 0,0:42:04.14,0:42:06.60,Default,,0,0,0,,Қорықпа
Dialogue: 0,0:42:06.69,0:42:10.15,Default,,0,0,0,,Түсте аудиторияға барыңыз.
Dialogue: 0,0:42:23.12,0:42:24.54,Default,,0,0,0,,Міне, осында!
Dialogue: 0,0:42:24.62,0:42:26.16,Default,,0,0,0,,Алда!
Dialogue: 0,0:42:26.25,0:42:28.00,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:42:28.08,0:42:29.79,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:42:29.88,0:42:32.17,Default,,0,0,0,,Иә? Эй, жоқ!
Dialogue: 0,0:42:32.25,0:42:34.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:42:36.80,0:42:39.26,Default,,0,0,0,,Ясуаки-чан қосылмай ма?
Dialogue: 0,0:42:39.34,0:42:42.18,Default,,0,0,0,,Жарайды, мен кітап оқып жатырмын.
Dialogue: 0,0:42:47.39,0:42:48.23,Default,,0,0,0,,Әй!
Dialogue: 0,0:42:54.48,0:42:56.90,Default,,0,0,0,,Ұят болатын ештеңе жоқ!
Dialogue: 0,0:42:57.78,0:42:59.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:59.32,0:43:00.32,Default,,0,0,0,,Хмм
Dialogue: 0,0:43:01.78,0:43:04.41,Default,,0,0,0,,Барлығы бірдей, солай емес пе?
Dialogue: 0,0:43:09.75,0:43:10.83,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:43:10.92,0:43:12.75,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:43:15.09,0:43:17.17,Default,,0,0,0,,О, сен жақсысың.
Dialogue: 0,0:43:18.76,0:43:20.43,Default,,0,0,0,,Мұнда келіңіз
Dialogue: 0,0:43:20.51,0:43:22.76,Default,,0,0,0,,Жарайды, күте тұрыңыз!
Dialogue: 0,0:43:22.85,0:43:25.06,Default,,0,0,0,,Сіз маған еркелік ойнайсыз ба?
Dialogue: 0,0:43:25.72,0:43:27.68,Default,,0,0,0,,Мен оған аяғымды қоямын.
Dialogue: 0,0:43:35.77,0:43:36.78,Default,,0,0,0,,Әй!
Dialogue: 0,0:43:42.61,0:43:43.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:43:44.33,0:43:49.46,Default,,0,0,0,,(күрескен дауыс)
Dialogue: 0,0:43:49.54,0:43:51.54,Default,,0,0,0,,Пуха! Ха...
Dialogue: 0,0:43:51.62,0:43:53.04,Default,,0,0,0,,Ясуаки-чан
Dialogue: 0,0:43:53.13,0:43:55.96,Default,,0,0,0,,Менің денем... жеңіл.
Dialogue: 0,0:43:56.71,0:43:58.21,Default,,0,0,0,,Уф!
Dialogue: 0,0:43:58.30,0:43:59.59,Default,,0,0,0,,Хехехе
Dialogue: 0,0:43:59.67,0:44:02.72,Default,,0,0,0,,-Ах Гао~! -(Сакко Миё) Кя~!
Dialogue: 0,0:44:02.80,0:44:05.51,Default,,0,0,0,,-Тоқта, күте тұр~ -(Сакко Миё) Кешіріңіз.
Dialogue: 0,0:44:05.60,0:44:07.01,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:45:47.45,0:45:49.83,Default,,0,0,0,,Иә? Ха...
Dialogue: 0,0:45:49.91,0:45:51.91,Default,,0,0,0,,- (Рокки) Бір, бір, бір! -Ах
Dialogue: 0,0:45:52.75,0:45:55.00,Default,,0,0,0,,Рокки
Dialogue: 0,0:45:55.08,0:45:57.17,Default,,0,0,0,,-Қайда бара жатырсың? -Ха!
Dialogue: 0,0:45:57.25,0:45:59.88,Default,,0,0,0,,Жазғы демалыс бүгін басталады, солай ма?
Dialogue: 0,0:45:59.96,0:46:01.46,Default,,0,0,0,,Ммм!
Dialogue: 0,0:46:01.55,0:46:02.88,Default,,0,0,0,,Бір!
Dialogue: 0,0:46:02.96,0:46:06.93,Default,,0,0,0,,Сонымен... Ясуаки-чанның Дененчофудағы үйі
Dialogue: 0,0:46:07.84,0:46:08.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:09.01,0:46:11.43,Default,,0,0,0,,Ах! Ах... хмм
Dialogue: 0,0:46:11.51,0:46:13.14,Default,,0,0,0,,Кун
Dialogue: 0,0:46:15.64,0:46:18.15,Default,,0,0,0,,Мен кешкі асқа дейін үйде боламын.
Dialogue: 0,0:46:18.69,0:46:19.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:19.77,0:46:21.32,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:46:21.40,0:46:22.82,Default,,0,0,0,,(Қақпа жабылған дыбыс)
Dialogue: 0,0:46:29.24,0:46:30.74,Default,,0,0,0,,Тотто-чан!
Dialogue: 0,0:46:30.82,0:46:32.20,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:46:38.42,0:46:39.63,Default,,0,0,0,,Хехе
Dialogue: 0,0:46:40.29,0:46:41.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:46:45.59,0:46:46.59,Default,,0,0,0,,- (Ясуаки) Ах! -Апыр-ай!
Dialogue: 0,0:46:47.55,0:46:49.84,Default,,0,0,0,,-Ихихихи - (Таймей) Ихихихи
Dialogue: 0,0:46:49.93,0:46:52.30,Default,,0,0,0,,U.A. Спорттық күні тез арада келіп жетті
Dialogue: 0,0:46:56.77,0:46:58.85,Default,,0,0,0,,Жақсы, өрмелеп көріңіз.
Dialogue: 0,0:46:58.94,0:47:02.06,Default,,0,0,0,,Хмм... Иә...
Dialogue: 0,0:47:08.70,0:47:13.49,Default,,0,0,0,,Ммммммммм!
Dialogue: 0,0:47:13.58,0:47:14.79,Default,,0,0,0,,Ах
Dialogue: 0,0:47:16.66,0:47:17.75,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:47:21.12,0:47:22.54,Default,,0,0,0,,Бұл адам мені священник деп қате түсінген
Dialogue: 0,0:47:24.84,0:47:27.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:47:29.01,0:47:30.01,Default,,0,0,0,,Ах
Dialogue: 0,0:47:31.59,0:47:35.01,Default,,0,0,0,,- Ммм - (Ясуаки) Уф... А-а!
Dialogue: 0,0:47:35.10,0:47:36.52,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:47:40.85,0:47:42.81,Default,,0,0,0,,А...
Dialogue: 0,0:47:42.90,0:47:44.11,Default,,0,0,0,,Хмм
Dialogue: 0,0:47:45.02,0:47:46.28,Default,,0,0,0,,Ах
Dialogue: 0,0:47:50.74,0:47:52.28,Default,,0,0,0,,-Хмф - (Таймэй) Иә?
Dialogue: 0,0:47:53.24,0:47:54.28,Default,,0,0,0,,Ком-Омбодағы адам да шынайы емес пе еді?
Dialogue: 0,0:47:55.24,0:47:58.79,Default,,0,0,0,,- (Ясуаки) Пуууу Ахахха! -Муи~
Dialogue: 0,0:47:58.87,0:48:01.54,Default,,0,0,0,,Күте тұрыңыз, менде бір ой бар.
Dialogue: 0,0:48:01.62,0:48:02.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:08.80,0:48:11.05,Default,,0,0,0,,Хмм.
Dialogue: 0,0:48:11.72,0:48:13.84,Default,,0,0,0,,...
Dialogue: 0,0:48:13.93,0:48:14.97,Default,,0,0,0,,Хмм?
Dialogue: 0,0:48:15.05,0:48:17.60,Default,,0,0,0,,Хо хо хо хо хо...
Dialogue: 0,0:48:17.68,0:48:19.47,Default,,0,0,0,,Хехе ахаха
Dialogue: 0,0:48:25.31,0:48:29.11,Default,,0,0,0,,Ммммммммммммм
Dialogue: 0,0:48:29.19,0:48:32.15,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:48:32.24,0:48:33.86,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:48:36.45,0:48:39.45,Default,,0,0,0,,Жарайсың ба? Бұл қорқынышты емес.
Dialogue: 0,0:48:39.54,0:48:42.37,Default,,0,0,0,,Қараңызшы, ол енді шайқалмайды.
Dialogue: 0,0:48:45.46,0:48:46.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:48.88,0:48:49.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:48:52.88,0:48:54.09,Default,,0,0,0,,Ахаха
Dialogue: 0,0:48:59.97,0:49:02.39,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:49:02.48,0:49:04.90,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:49:07.98,0:49:10.40,Default,,0,0,0,,Сондай-ақ сиқыр сенің ерніңе де әсер етсін…
Dialogue: 0,0:49:10.48,0:49:11.90,Default,,0,0,0,,Уф
Dialogue: 0,0:49:11.99,0:49:14.20,Default,,0,0,0,,Ммм.
Dialogue: 0,0:49:14.28,0:49:16.91,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:49:19.49,0:49:22.87,Default,,0,0,0,,Сәлем! Ура!
Dialogue: 0,0:49:22.96,0:49:25.87,Default,,0,0,0,,Ясуаки-чан, ура!
Dialogue: 0,0:49:25.96,0:49:26.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:29.04,0:49:30.92,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:49:31.00,0:49:32.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:46.52,0:49:48.44,Default,,0,0,0,,Хмм!
Dialogue: 0,0:49:48.52,0:49:50.98,Default,,0,0,0,,♬~
Dialogue: 0,0:49:51.07,0:49:52.69,Default,,0,0,0,,Хаха...
Dialogue: 0,0:49:52.78,0:49:54.44,Default,,0,0,0,,♬~
Dialogue: 0,0:49:57.53,0:50:00.95,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:50:06.25,0:50:07.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:50:12.46,0:50:13.46,Default,,0,0,0,,Хмм
Dialogue: 0,0:50:13.55,0:50:16.47,Default,,0,0,0,,Ұйықтау үшін киініп көріңіз!
Dialogue: 0,0:50:16.55,0:50:18.97,Default,,0,0,0,,Ха... иә
Dialogue: 0,0:50:27.27,0:50:29.98,Default,,0,0,0,,Хмм!
Dialogue: 0,0:50:30.06,0:50:32.98,Default,,0,0,0,,Хмм!
Dialogue: 0,0:50:34.48,0:50:35.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:50:39.41,0:50:40.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:50:57.09,0:50:59.30,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:51:02.10,0:51:04.31,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:51:12.31,0:51:16.32,Default,,0,0,0,,Ағашқа өрмелеу деген осы ма?
Dialogue: 0,0:51:17.99,0:51:19.32,Default,,0,0,0,,Хехе
Dialogue: 0,0:51:20.99,0:51:22.32,Default,,0,0,0,,Теледидар?
Dialogue: 0,0:51:23.33,0:51:27.41,Default,,0,0,0,,Мен мұны АҚШ-та шетелде оқып жүрген апаңыздан естідім.
Dialogue: 0,0:51:27.50,0:51:31.33,Default,,0,0,0,,Дүниені тыныш ететін сиқырлы сандық.
Dialogue: 0,0:51:33.17,0:51:36.96,Default,,0,0,0,,Тотто-чан да теледидардан көрінуі мүмкін.
Dialogue: 0,0:51:37.05,0:51:41.05,Default,,0,0,0,,Мен қорапқа кіргенді ұнатпаймын.
Dialogue: 0,0:51:48.10,0:51:49.81,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:51:52.98,0:51:54.90,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:51:54.98,0:51:58.15,Default,,0,0,0,,Мен киімімді кірлеп алдым.
Dialogue: 0,0:52:01.70,0:52:05.78,Default,,0,0,0,,Әй, расында, бұл өте лас...
Dialogue: 0,0:52:08.16,0:52:14.38,Default,,0,0,0,,Кір жуу... қиын....
Dialogue: 0,0:52:15.17,0:52:20.38,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:52:25.47,0:52:29.39,Default,,0,0,0,,(Мерекелік музыка)
Dialogue: 0,0:52:32.19,0:52:33.40,Default,,0,0,0,,- (Бала) Уау! -(Бала) А?
Dialogue: 0,0:52:36.57,0:52:39.19,Default,,0,0,0,,Уау~
Dialogue: 0,0:52:39.28,0:52:40.49,Default,,0,0,0,,Уау~
Dialogue: 0,0:52:40.57,0:52:44.49,Default,,0,0,0,,Тоцуке, мен саған ұнайтын нәрсені сатып аламын.
Dialogue: 0,0:52:44.57,0:52:47.53,Default,,0,0,0,,Шынымен бе? иә?
Dialogue: 0,0:52:47.62,0:52:49.49,Default,,0,0,0,,Тек бүгін ерекше
Dialogue: 0,0:52:50.20,0:52:53.00,Default,,0,0,0,,Аха, иә!
Dialogue: 0,0:52:54.17,0:52:55.00,Default,,0,0,0,,О!
Dialogue: 0,0:52:55.08,0:52:57.00,Default,,0,0,0,,- (Тотто бала) Мен жеңдім! -(Бала) Уау!
Dialogue: 0,0:52:57.79,0:52:59.00,Default,,0,0,0,,Уау...
Dialogue: 0,0:52:59.92,0:53:01.01,Default,,0,0,0,,О...
Dialogue: 0,0:53:01.09,0:53:02.80,Default,,0,0,0,,-(Қыз) Уау -(Қыз) Кішкентай.
Dialogue: 0,0:53:02.88,0:53:04.01,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:53:04.09,0:53:05.43,Default,,0,0,0,,Хмм.
Dialogue: 0,0:53:05.51,0:53:08.85,Default,,0,0,0,,Жоқ, мен оны жаңа ғана сатып алдым.
Dialogue: 0,0:53:08.93,0:53:11.02,Default,,0,0,0,,- Міне! -Ой, сәл күте тұрыңыз.
Dialogue: 0,0:53:12.89,0:53:14.60,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:53:14.69,0:53:15.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:18.61,0:53:21.48,Default,,0,0,0,,Өте сүйкімді~ хехехе
Dialogue: 0,0:53:24.61,0:53:26.62,Default,,0,0,0,,(Балапан жылауы)
Dialogue: 0,0:53:29.62,0:53:31.12,Default,,0,0,0,,Хмм.
Dialogue: 0,0:53:31.20,0:53:32.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:53:33.16,0:53:34.75,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:53:34.83,0:53:36.83,Default,,0,0,0,,Ғибадатхана қыз-қызметшісінің киімі оған жарасады.
Dialogue: 0,0:53:38.13,0:53:39.75,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:53:39.84,0:53:42.51,Default,,0,0,0,,Сіз маған не қаласаңыз да сатып аламын дедіңіз.
Dialogue: 0,0:53:42.59,0:53:45.05,Default,,0,0,0,,Мм... Мен балапан алғым келеді!
Dialogue: 0,0:53:47.47,0:53:51.10,Default,,0,0,0,,Анау балапан әлсіз, уайымдама.
Dialogue: 0,0:53:51.18,0:53:54.81,Default,,0,0,0,,Ештеңе етпейді, мен оны реттеймін.
Dialogue: 0,0:53:54.89,0:53:56.06,Default,,0,0,0,,Әкелер
Dialogue: 0,0:53:56.14,0:53:59.44,Default,,0,0,0,,Мен мұны Тоцуке жылайтындықтан айтып отырмын.
Dialogue: 0,0:53:59.52,0:54:00.52,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:54:00.61,0:54:03.07,Default,,0,0,0,,Қараңдар, тасбақа кәмпиттері бар.
Dialogue: 0,0:54:03.86,0:54:06.66,Default,,0,0,0,,Маған балапан ұнайды!
Dialogue: 0,0:54:06.74,0:54:08.82,Default,,0,0,0,,Жақсылық жақсы емес
Dialogue: 0,0:54:13.41,0:54:16.08,Default,,0,0,0,,Бентен-самаға дұға етейік
Dialogue: 0,0:54:24.17,0:54:26.01,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:54:26.09,0:54:27.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:28.68,0:54:31.10,Default,,0,0,0,,Өмір бойы сұрау
Dialogue: 0,0:54:31.85,0:54:35.60,Default,,0,0,0,,Мен өлгенше сенен маған ештеңе сатып алуды сұрамаймын.
Dialogue: 0,0:54:35.68,0:54:41.61,Default,,0,0,0,,Балапан... мені сатып ал... өтінемін.
Dialogue: 0,0:54:42.32,0:54:45.61,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:54:45.69,0:54:49.57,Default,,0,0,0,,(Балапан жылауы)
Dialogue: 0,0:54:50.28,0:54:51.12,Default,,0,0,0,,(айқай)
Dialogue: 0,0:54:51.20,0:54:52.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:54:52.53,0:54:55.79,Default,,0,0,0,,Уфуфу қытық
Dialogue: 0,0:54:55.87,0:54:58.12,Default,,0,0,0,,Ахаха ахахха!
Dialogue: 0,0:54:58.21,0:55:01.21,Default,,0,0,0,,Тотто-чан, қазір дайындал.
Dialogue: 0,0:55:01.29,0:55:02.92,Default,,0,0,0,,Yes
Dialogue: 0,0:55:09.84,0:55:12.10,Default,,0,0,0,,Жақсы қыз болып, үйде отыр.
Dialogue: 0,0:55:12.18,0:55:15.43,Default,,0,0,0,,Рокки, оны жеме.
Dialogue: 0,0:55:15.52,0:55:17.02,Default,,0,0,0,,Кун
Dialogue: 0,0:55:17.68,0:55:20.02,Default,,0,0,0,,Ырғақты?
Dialogue: 0,0:55:20.10,0:55:23.15,Default,,0,0,0,,Алдымен жалаң аяқ жүруге тырысыңыз.
Dialogue: 0,0:55:23.23,0:55:25.15,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:55:25.23,0:55:27.61,Default,,0,0,0,,Денені пайдалану
Dialogue: 0,0:55:27.69,0:55:30.99,Default,,0,0,0,,Фортепиано сияқты ырғақты көрсетіңіз
Dialogue: 0,0:55:31.07,0:55:35.54,Default,,0,0,0,,Сіз пианинода ойнаған кезде қолғап кимейсіз, солай ма?
Dialogue: 0,0:55:37.33,0:55:40.04,Default,,0,0,0,,Мен пианиношы боламын!
Dialogue: 0,0:55:41.67,0:55:46.05,Default,,0,0,0,,(фортепианода төрт соққылы орындау)
Dialogue: 0,0:55:49.67,0:55:52.05,Default,,0,0,0,,Ырғақ өзгереді!
Dialogue: 0,0:55:52.14,0:55:58.06,Default,,0,0,0,,(фортепианода 8 рет орындау)
Dialogue: 0,0:56:01.69,0:56:04.06,Default,,0,0,0,,Ой... Ой!
Dialogue: 0,0:56:04.15,0:56:06.57,Default,,0,0,0,,(фортепианолық прелюдия)
Dialogue: 0,0:56:06.65,0:56:11.57,Default,,0,0,0,,♪ Айналдыру және айнала айналдыру
Dialogue: 0,0:56:11.65,0:56:16.58,Default,,0,0,0,,♪ Айнал, айнала, айнала және айнала.
Dialogue: 0,0:56:16.66,0:56:19.08,Default,,0,0,0,,Бәріміз үлкен шың болайық
Dialogue: 0,0:56:19.16,0:56:24.08,Default,,0,0,0,,♪ Айналдыру және айнала айналдыру
Dialogue: 0,0:56:24.17,0:56:26.59,Default,,0,0,0,,♪ Айнал, бұрыл
Dialogue: 0,0:56:26.67,0:56:29.09,Default,,0,0,0,,♪ Курукуру Курукуру
Dialogue: 0,0:56:29.17,0:56:32.34,Default,,0,0,0,,♪ Айналаңыз және айналаңыз
Dialogue: 0,0:56:32.43,0:56:34.14,Default,,0,0,0,,Менің көзім айналады~
Dialogue: 0,0:56:34.22,0:56:35.60,Default,,0,0,0,,Ерте~
Dialogue: 0,0:56:40.39,0:56:43.60,Default,,0,0,0,,Кіріспе ырғақ
Dialogue: 0,0:56:44.35,0:56:47.61,Default,,0,0,0,,Ырғақты ақыл мен дене әдемі
Dialogue: 0,0:56:47.69,0:56:49.61,Default,,0,0,0,,Табиғат заңдылықтарын сақта
Dialogue: 0,0:56:51.07,0:56:54.57,Default,,0,0,0,,Бақаның тоғанға секіргенін көрген
Dialogue: 0,0:56:54.66,0:56:57.62,Default,,0,0,0,,Башо жалғыз болмаған шығар.
Dialogue: 0,0:56:58.58,0:57:00.58,Default,,0,0,0,,Дүниеде не қорқынышты?
Dialogue: 0,0:57:00.66,0:57:03.12,Default,,0,0,0,,Менің көзім бар, бірақ сұлулықты білмеймін.
Dialogue: 0,0:57:03.21,0:57:06.84,Default,,0,0,0,,Құлағым болса да, музыка тыңдамаймын.
Dialogue: 0,0:57:07.46,0:57:12.55,Default,,0,0,0,,Қозғалмаса, қозғалмайды.
Dialogue: 0,0:57:27.52,0:57:30.11,Default,,0,0,0,,Бұл Тотто-чанның кінәсі емес.
Dialogue: 0,0:57:31.19,0:57:35.16,Default,,0,0,0,,Хиоко-сан да барын салды...
Dialogue: 0,0:57:40.41,0:57:42.37,Default,,0,0,0,,Пипипи…
Dialogue: 0,0:57:43.12,0:57:46.17,Default,,0,0,0,,Дыбыс... Дыбыс...
Dialogue: 0,0:57:46.25,0:57:49.96,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:57:50.04,0:57:53.13,Default,,0,0,0,,Саған қабір жасап берейік.
Dialogue: 0,0:57:59.60,0:58:02.06,Default,,0,0,0,,Ол көп ұзамай қайтыс болды...
Dialogue: 0,0:58:02.89,0:58:05.52,Default,,0,0,0,,Бейшара балапан
Dialogue: 0,0:58:07.31,0:58:10.27,Default,,0,0,0,,Менің ойымша, Хиёко көңілді болды.
Dialogue: 0,0:58:10.36,0:58:11.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:58:11.86,0:58:16.11,Default,,0,0,0,,Мен Тотто-чанмен кездестім және мен өмірімді барынша жақсы өткіздім.
Dialogue: 0,0:58:19.16,0:58:23.20,Default,,0,0,0,,Оның көкке кеткеніне сенімдімін.
Dialogue: 0,0:58:23.87,0:58:27.21,Default,,0,0,0,,Аспан қандай жер?
Dialogue: 0,0:58:28.12,0:58:32.17,Default,,0,0,0,,Әр адам көкте періште бола алады дейді.
Dialogue: 0,0:58:32.71,0:58:37.72,Default,,0,0,0,,Балапандар да аспанда емін-еркін ұшады деп ойлаймын.
Dialogue: 0,0:58:42.60,0:58:44.22,Default,,0,0,0,,- Ммм - (Ясуаки) А...
Dialogue: 0,0:58:45.77,0:58:47.69,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:58:47.77,0:58:50.23,Default,,0,0,0,,Ммммммммм…
Dialogue: 0,0:58:50.31,0:58:54.19,Default,,0,0,0,,Әй, сен неге қазір әкеңнің практикасына бармайсың?
Dialogue: 0,0:58:54.28,0:58:55.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:03.91,0:59:05.16,Default,,0,0,0,,Сәлем
Dialogue: 0,0:59:05.25,0:59:06.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:06.83,0:59:08.46,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:59:09.62,0:59:14.21,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:59:14.92,0:59:16.71,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:59:16.80,0:59:20.22,Default,,0,0,0,,Дай... Жо... Бу
Dialogue: 0,0:59:20.30,0:59:25.22,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:59:28.35,0:59:30.56,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:59:32.23,0:59:34.73,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:59:35.73,0:59:37.15,Default,,0,0,0,,Ай!
Dialogue: 0,0:59:37.24,0:59:38.65,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:59:39.82,0:59:44.83,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:59:46.12,0:59:53.00,Default,,0,0,0,,Оны осы әлемге байлап қою үшін—
Dialogue: 0,0:59:53.08,0:59:55.88,Default,,0,0,0,,Розенсток деген адам дирижер болды.
Dialogue: 0,0:59:55.96,0:59:57.55,Default,,0,0,0,,Сіз өте мейірімдісіз.
Dialogue: 0,0:59:57.63,0:59:59.22,Default,,0,0,0,,Я~
Dialogue: 0,0:59:59.30,1:00:01.18,Default,,0,0,0,,Ах
Dialogue: 0,1:00:01.26,1:00:03.89,Default,,0,0,0,,<Түсінгенше неше рет айту керек?>
Dialogue: 0,1:00:03.97,1:00:05.51,Default,,0,0,0,,<Ансамбль тәртіпсіз>
Dialogue: 0,1:00:05.60,1:00:08.18,Default,,0,0,0,,Ой... Жарайсыңдар!
Dialogue: 0,1:00:08.27,1:00:10.18,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,1:00:10.27,1:00:11.27,Default,,0,0,0,,〈Жастарың нешеде? 〉
Dialogue: 0,1:00:11.27,1:00:12.40,Default,,0,0,0,,〈Балалар, сендер нешедесіңдер? 〉
Dialogue: 0,1:00:11.27,1:00:12.40,Default,,0,0,0,,Сіз шынымен мейірімдісіз бе?
Dialogue: 0,1:00:12.40,1:00:12.48,Default,,0,0,0,,Сіз шынымен мейірімдісіз бе?
Dialogue: 0,1:00:12.48,1:00:13.56,Default,,0,0,0,,Сіз шынымен мейірімдісіз бе?
Dialogue: 0,1:00:12.48,1:00:13.56,Default,,0,0,0,,<Бұл баланың ойыны емес>
Dialogue: 0,1:00:13.56,1:00:13.65,Default,,0,0,0,,<Бұл баланың ойыны емес>
Dialogue: 0,1:00:13.65,1:00:15.19,Default,,0,0,0,,<Бұл баланың ойыны емес>
Dialogue: 0,1:00:13.65,1:00:15.19,Default,,0,0,0,,Хмм... мм.
Dialogue: 0,1:00:18.07,1:00:21.20,Default,,0,0,0,,Мұғалім Розенсток мырза
Dialogue: 0,1:00:21.28,1:00:23.07,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:00:23.16,1:00:25.12,Default,,0,0,0,,〈Мұның бәрін істеп жүрсем де〉
Dialogue: 0,1:00:25.20,1:00:28.33,Default,,0,0,0,,<Оркестріңіз жауап бермейді>
Dialogue: 0,1:00:28.41,1:00:31.08,Default,,0,0,0,,Барлығы аянбай еңбек етуде
Dialogue: 0,1:00:31.16,1:00:33.79,Default,,0,0,0,,Технология ілесе алмайды.
Dialogue: 0,1:00:33.88,1:00:38.67,Default,,0,0,0,,(неміс аудармашысы)
Dialogue: 0,1:00:38.76,1:00:39.63,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,1:00:39.71,1:00:41.72,Default,,0,0,0,,- Әке! -иә?
Dialogue: 0,1:00:42.68,1:00:44.22,Default,,0,0,0,,Тоцуке!
Dialogue: 0,1:00:44.30,1:00:47.47,Default,,0,0,0,,О, Тоттосан!
Dialogue: 0,1:00:48.81,1:00:51.23,Default,,0,0,0,,Гутентүрк!
Dialogue: 0,1:00:51.31,1:00:53.39,Default,,0,0,0,,А... Гөкиген Иқаға?
Dialogue: 0,1:00:53.48,1:00:55.23,Default,,0,0,0,,Өте жақсы
Dialogue: 0,1:00:55.86,1:00:57.57,Default,,0,0,0,,Сәлем
Dialogue: 0,1:00:57.65,1:01:00.23,Default,,0,0,0,,Эй, сені осында көргеніме қуаныштымын.
Dialogue: 0,1:01:00.32,1:01:03.24,Default,,0,0,0,,Әй, жақсы жаңалық жақсы жаңалық
Dialogue: 0,1:01:03.32,1:01:06.24,Default,,0,0,0,,- (музыкант) Ақыры... - (музыкант) Ақыры?
Dialogue: 0,1:01:06.32,1:01:08.91,Default,,0,0,0,,Германия болса, бізде жүз адам бар.
Dialogue: 0,1:01:08.99,1:01:11.54,Default,,0,0,0,,Осымен Америка тыныш болады.
Dialogue: 0,1:01:11.62,1:01:13.58,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:01:13.67,1:01:14.87,Default,,0,0,0,,Эй!
Dialogue: 0,1:01:20.34,1:01:22.17,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:24.55,1:01:27.30,Default,,0,0,0,,<Уайымдайтын ештеңе жоқ>
Dialogue: 0,1:01:27.39,1:01:30.85,Default,,0,0,0,,<Мен енді Германия азаматы емеспін>
Dialogue: 0,1:01:33.35,1:01:36.02,Default,,0,0,0,,<Қандай жағдай болса да>
Dialogue: 0,1:01:36.10,1:01:39.77,Default,,0,0,0,,<Мен музыкант ретіндегі миссиямды орындаймын>
Dialogue: 0,1:01:42.36,1:01:45.91,Default,,0,0,0,,<Енді жаттығуды жалғастырайық>
Dialogue: 0,1:01:45.99,1:01:49.28,Default,,0,0,0,,〈Сізді сүйкімді тұтынушы күтеді〉
Dialogue: 0,1:01:50.08,1:01:51.79,Default,,0,0,0,,Уау...
Dialogue: 0,1:01:51.87,1:01:56.87,Default,,0,0,0,,Оны осы әлемге байлап қою үшін—
Dialogue: 0,1:02:30.24,1:02:31.99,Default,,0,0,0,,Тоттемо керемет!
Dialogue: 0,1:02:32.08,1:02:35.79,Default,,0,0,0,,(музыканттардың күлкісі)
Dialogue: 0,1:02:35.87,1:02:38.79,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,1:02:38.88,1:02:41.79,Default,,0,0,0,,Жетеді!
Dialogue: 0,1:02:42.55,1:02:45.30,Default,,0,0,0,,-Сіз сонда болдыңыз ба? -Жоқ
Dialogue: 0,1:02:47.63,1:02:48.89,Default,,0,0,0,,Ах
Dialogue: 0,1:02:48.97,1:02:50.89,Default,,0,0,0,,Тотто-чан, қара!
Dialogue: 0,1:02:50.97,1:02:52.31,Default,,0,0,0,,Ах!
Dialogue: 0,1:02:52.39,1:02:53.56,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:02:53.64,1:02:56.31,Default,,0,0,0,,Мен байланып қалдым...
Dialogue: 0,1:02:56.39,1:02:59.81,Default,,0,0,0,,Доккойшо!
Dialogue: 0,1:02:59.90,1:03:03.27,Default,,0,0,0,,Доккойшо!
Dialogue: 0,1:03:03.36,1:03:06.82,Default,,0,0,0,,Доккойшо!
Dialogue: 0,1:03:06.90,1:03:10.32,Default,,0,0,0,,Доккойшо!
Dialogue: 0,1:03:10.41,1:03:11.82,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:03:13.16,1:03:16.79,Default,,0,0,0,,Онда жасырынуға тыйым салайық.
Dialogue: 0,1:03:16.87,1:03:19.08,Default,,0,0,0,,- (Мигита) Қарным ашты - Ахаха!
Dialogue: 0,1:03:19.17,1:03:21.83,Default,,0,0,0,,Мен Кабумын!
Dialogue: 0,1:03:22.96,1:03:24.05,Default,,0,0,0,,Неге?
Dialogue: 0,1:03:24.13,1:03:26.67,Default,,0,0,0,,Мен құйрығым бар деп айттым ба?
Dialogue: 0,1:03:26.76,1:03:27.59,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:28.76,1:03:31.47,Default,,0,0,0,,Бұл соншалықты терең емес...
Dialogue: 0,1:03:31.55,1:03:35.06,Default,,0,0,0,,Себебі Такахаши-кун менің көзіме түсті...
Dialogue: 0,1:03:35.68,1:03:38.77,Default,,0,0,0,,Сізге кішкентай болса да
Dialogue: 0,1:03:38.85,1:03:43.11,Default,,0,0,0,,Такахаши-кун үшін терең мағына бар.
Dialogue: 0,1:03:43.90,1:03:49.07,Default,,0,0,0,,Сіз оның өзін төмен сезінбеуі үшін қаншалықты қамқорлық жасайсыз?
Dialogue: 0,1:03:49.74,1:03:52.62,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,1:03:52.70,1:03:53.78,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:53.87,1:03:55.28,Default,,0,0,0,,Қазір де солай
Dialogue: 0,1:03:55.37,1:03:58.62,Default,,0,0,0,,Құйрық сүйегі қалады.
Dialogue: 0,1:03:59.29,1:04:00.92,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,1:04:01.58,1:04:05.13,Default,,0,0,0,,Адамдардың да құйрығы болған.
Dialogue: 0,1:04:05.21,1:04:07.05,Default,,0,0,0,,Иә!
Dialogue: 0,1:04:07.13,1:04:09.13,Default,,0,0,0,,(дыбысты дауыс)
Dialogue: 0,1:04:09.88,1:04:13.30,Default,,0,0,0,,Құйрығы бар адамдар әлі қалды ма?
Dialogue: 0,1:04:14.35,1:04:17.14,Default,,0,0,0,,Такахаши-кун сонда емес пе?
Dialogue: 0,1:04:17.22,1:04:18.98,Default,,0,0,0,,Не!
Dialogue: 0,1:04:19.06,1:04:21.19,Default,,0,0,0,,Гух!!
Dialogue: 0,1:04:21.27,1:04:24.15,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:04:24.73,1:04:28.57,Default,,0,0,0,,Мен Такахаши-кунның өзін қалай сезінетініне таңғаламын...
Dialogue: 0,1:04:28.65,1:04:31.90,Default,,0,0,0,,Сіз бұл туралы ойлап көрдіңіз бе?
Dialogue: 0,1:04:32.99,1:04:37.66,Default,,0,0,0,,Мен... шынымен қателесіппін.
Dialogue: 0,1:04:54.76,1:04:59.77,Default,,0,0,0,,(Жазба: «Радецкий маршы»)
Dialogue: 0,1:05:08.07,1:05:09.57,Default,,0,0,0,,Тоцуке!
Dialogue: 0,1:05:09.65,1:05:10.86,Default,,0,0,0,,Ах!
Dialogue: 0,1:05:12.61,1:05:14.86,Default,,0,0,0,,Әке! Анашым!
Dialogue: 0,1:05:14.95,1:05:15.78,Default,,0,0,0,,Ах
Dialogue: 0,1:05:15.87,1:05:19.04,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:05:20.04,1:05:26.17,Default,,0,0,0,,Келесі - бірінші сынып оқушыларының екі адамдық саяхаты.
Dialogue: 0,1:05:30.88,1:05:34.93,Default,,0,0,0,,Жарайсың ба? Алдымен байланған ұшын алыңыз.
Dialogue: 0,1:05:35.01,1:05:36.05,Default,,0,0,0,,Иә
Dialogue: 0,1:05:37.01,1:05:38.64,Default,,0,0,0,,Орналасуға қатысты
Dialogue: 0,1:05:41.64,1:05:43.06,Default,,0,0,0,,Дайындау…
Dialogue: 0,1:05:44.64,1:05:45.56,Default,,0,0,0,,(сигнал тапаншасының дыбысы)
Dialogue: 0,1:05:46.77,1:05:51.61,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,1:05:51.69,1:05:52.69,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,1:05:52.78,1:05:54.20,Default,,0,0,0,,Ах!
Dialogue: 0,1:06:03.33,1:06:04.83,Default,,0,0,0,,Тот!
Dialogue: 0,1:06:04.91,1:06:06.25,Default,,0,0,0,,Ясуаки-сан!
Dialogue: 0,1:06:12.84,1:06:16.84,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:06:16.93,1:06:18.93,Default,,0,0,0,,-Кя~! - (Ясуакидің анасы) Жарайды.
Dialogue: 0,1:06:19.85,1:06:22.52,Default,,0,0,0,,Ясуаки-чан таң қалдырады.
Dialogue: 0,1:06:22.60,1:06:24.60,Default,,0,0,0,,Тецукоға рахмет
Dialogue: 0,1:06:24.68,1:06:27.31,Default,,0,0,0,,Келесі сайыс...
Dialogue: 0,1:06:32.32,1:06:34.61,Default,,0,0,0,,Карп стримерлер сайысы
Dialogue: 0,1:06:35.57,1:06:37.86,Default,,0,0,0,,Дайындық... (сигнал тапаншасының дыбысы)
Dialogue: 0,1:06:37.95,1:06:39.12,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,1:06:39.20,1:06:41.28,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:06:44.20,1:06:46.62,Default,,0,0,0,,(Цубаки) Косей! Уф!
Dialogue: 0,1:06:49.71,1:06:51.25,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:06:52.71,1:06:54.38,Default,,0,0,0,,О!
Dialogue: 0,1:06:54.46,1:06:56.13,Default,,0,0,0,,Сазан жүзеді
Dialogue: 0,1:07:00.64,1:07:02.60,Default,,0,0,0,,Керемет Такахаши-кун, бұл тез!
Dialogue: 0,1:07:02.68,1:07:04.56,Default,,0,0,0,,-Такахаши-кун! -(Ясу) Такахаши-кун!
Dialogue: 0,1:07:04.64,1:07:06.56,Default,,0,0,0,,1 орын!
Dialogue: 0,1:07:08.98,1:07:12.06,Default,,0,0,0,,Бірінші жүлдені жеңіп алуыңызбен құттықтаймыз
Dialogue: 0,1:07:12.15,1:07:14.11,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,1:07:14.65,1:07:15.65,Default,,0,0,0,,Ах
Dialogue: 0,1:07:17.70,1:07:21.70,Default,,0,0,0,,Үйге келгенде анамнан тамақ жасап беруін өтінемін.
Dialogue: 0,1:07:25.45,1:07:27.37,Default,,0,0,0,,Менің не жасағанымды қалайсың?
Dialogue: 0,1:07:27.46,1:07:29.29,Default,,0,0,0,,Шалғам мисо сорпасы
Dialogue: 0,1:07:29.37,1:07:31.71,Default,,0,0,0,,Менің де жегім келеді, мұғалім.
Dialogue: 0,1:07:31.79,1:07:34.71,Default,,0,0,0,,- (Такахаши) Иә! -(Ойши) Жақсы емес пе?
Dialogue: 0,1:07:40.30,1:07:45.31,Default,,0,0,0,,Ватару!
Dialogue: 0,1:07:52.27,1:07:55.23,Default,,0,0,0,,Тоцуке, бүгін ауа райы қандай?
Dialogue: 0,1:07:56.11,1:07:57.61,Default,,0,0,0,,Yes
Dialogue: 0,1:08:00.32,1:08:03.20,Default,,0,0,0,,(Екінші қолдың дыбысы)
Dialogue: 0,1:08:03.28,1:08:05.83,Default,,0,0,0,,Пешкаға
Dialogue: 0,1:08:07.16,1:08:11.17,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:12.04,1:08:15.34,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,1:08:16.34,1:08:18.17,Default,,0,0,0,,Соңғы жаңалықтар
Dialogue: 0,1:08:18.26,1:08:20.13,Default,,0,0,0,,Соңғы жаңалықтар
Dialogue: 0,1:08:20.22,1:08:24.76,Default,,0,0,0,,Императорлық штабтың Армия және Әскери-теңіз күштері департаменті 8 желтоқсан, 6:00 хабарландыру
Dialogue: 0,1:08:24.85,1:08:27.89,Default,,0,0,0,,Ауа райы болжамы орындалмайды
Dialogue: 0,1:08:24.85,1:08:27.89,Default,,0,0,0,,Императорлық армия мен теңіз флоты 8-ші күннің басында болды.
Dialogue: 0,1:08:27.97,1:08:29.64,Default,,0,0,0,,Батыс Тынық мұхитында
Dialogue: 0,1:08:29.73,1:08:30.81,Default,,0,0,0,,Америка британдық күштермен шайқасқа кіреді
Dialogue: 0,1:08:30.81,1:08:32.27,Default,,0,0,0,,Америка британ әскерлерімен шайқасқа кіреді
Dialogue: 0,1:08:30.81,1:08:32.27,Default,,0,0,0,,Қайсы (радио дыбыс деңгейін арттыру)
Dialogue: 0,1:08:32.35,1:08:35.77,Default,,0,0,0,,Императорлық армия мен теңіз флоты
Dialogue: 0,1:08:35.86,1:08:37.44,Default,,0,0,0,,Батыс Тынық мұхитында
Dialogue: 0,1:08:37.53,1:08:39.78,Default,,0,0,0,,Америка британдық күштермен шайқасқа кіреді
Dialogue: 0,1:08:39.86,1:08:41.28,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:42.15,1:08:43.57,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:46.24,1:08:50.87,Default,,0,0,0,,Америка Ұлыбританиямен соғысады ма?
Dialogue: 0,1:08:52.75,1:08:53.96,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:11.73,1:09:13.81,Default,,0,0,0,,Тыңда, Тоцуке
Dialogue: 0,1:09:13.89,1:09:19.69,Default,,0,0,0,,Бүгіннен бастап әке-шешеңді әке-шеше деп атаңдар.
Dialogue: 0,1:09:20.48,1:09:22.24,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:09:23.82,1:09:25.66,Default,,0,0,0,,«Әкем ана» ағылшын тілі, солай ма?
Dialogue: 0,1:09:25.74,1:09:27.32,Default,,0,0,0,,Иә
Dialogue: 0,1:09:27.41,1:09:29.83,Default,,0,0,0,,Егер біреу Тотто-чанды тыңшы деп ойласа ше?
Dialogue: 0,1:09:29.91,1:09:31.12,Default,,0,0,0,,Бұл қиын, солай емес пе?
Dialogue: 0,1:09:31.20,1:09:33.71,Default,,0,0,0,,Не, тыңшы?
Dialogue: 0,1:09:34.87,1:09:36.71,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,1:09:36.79,1:09:38.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:09:38.75,1:09:40.34,Default,,0,0,0,,Иә, анашым
Dialogue: 0,1:09:40.42,1:09:42.21,Default,,0,0,0,,Ха! Уф…
Dialogue: 0,1:09:49.76,1:09:53.93,Default,,0,0,0,,Егер сіз қателесіп қоңырау шалсаңыз, осы жерге 1 сен қойыңыз.
Dialogue: 0,1:09:54.02,1:09:56.40,Default,,0,0,0,,Тотто-чан кіреді
Dialogue: 0,1:09:57.81,1:09:59.02,Default,,0,0,0,,Хмм
Dialogue: 0,1:10:07.62,1:10:08.95,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:09.03,1:10:12.29,Default,,0,0,0,,- (Ер адам) Аман болсын! - (Барлығы) Аман болсын!
Dialogue: 0,1:10:12.37,1:10:15.66,Default,,0,0,0,,- (Ер адам) Аман болсын! - (Барлығы) Аман болсын!
Dialogue: 0,1:10:15.75,1:10:17.83,Default,,0,0,0,,Ағай
Dialogue: 0,1:10:17.92,1:10:19.96,Default,,0,0,0,,Ах, қайырлы таң, Тотто-чан.
Dialogue: 0,1:10:20.04,1:10:23.42,Default,,0,0,0,,Мен бүгіннен бастап үшінші курс студентімін.
Dialogue: 0,1:10:23.51,1:10:25.55,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,1:10:25.63,1:10:27.18,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,1:10:27.26,1:10:30.72,Default,,0,0,0,,Тотто-чан да үлкен апа.
Dialogue: 0,1:10:30.80,1:10:33.89,Default,,0,0,0,,Иә! Мен сенің әпкеңмін
Dialogue: 0,1:10:47.15,1:10:48.86,Default,,0,0,0,,-Хмф! -(Ясу) Уф!
Dialogue: 0,1:10:48.95,1:10:52.58,Default,,0,0,0,,Ух... а...
Dialogue: 0,1:10:52.66,1:10:54.50,Default,,0,0,0,,Тотто теңізінің жеңісі~
Dialogue: 0,1:10:54.58,1:10:56.62,Default,,0,0,0,,Йокозуна тағы да жеңіске жетті!
Dialogue: 0,1:10:56.71,1:10:58.75,Default,,0,0,0,,Бұл қатарынан 3 жеңіс!
Dialogue: 0,1:10:58.83,1:11:01.59,Default,,0,0,0,,Шалғай бала
Dialogue: 0,1:11:01.67,1:11:05.59,Default,,0,0,0,,Мүмкін емес Тіпті Футабаяма да мүмкін емес
Dialogue: 0,1:11:05.67,1:11:08.34,Default,,0,0,0,,О не~
Dialogue: 0,1:11:08.43,1:11:11.30,Default,,0,0,0,,Хо хо хо хо
Dialogue: 0,1:11:11.39,1:11:12.76,Default,,0,0,0,,Тотто-чан
Dialogue: 0,1:11:12.85,1:11:17.35,Default,,0,0,0,,Қанша сұрасаң да, сені әйел қылмаймын.
Dialogue: 0,1:11:17.43,1:11:19.35,Default,,0,0,0,,Иә!
Dialogue: 0,1:11:19.44,1:11:21.15,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:11:21.23,1:11:25.03,Default,,0,0,0,,Мен Тай Чанның әйелі болғым келеді!
Dialogue: 0,1:11:25.11,1:11:27.86,Default,,0,0,0,,Ол шпион болуы керек емес пе еді?
Dialogue: 0,1:11:28.49,1:11:31.16,Default,,0,0,0,,Менің әйелім барлаушы!
Dialogue: 0,1:11:31.24,1:11:33.03,Default,,0,0,0,,Әңгімешіл бала тыңшы бола алмайды.
Dialogue: 0,1:11:33.12,1:11:34.49,Default,,0,0,0,,Ха!
Dialogue: 0,1:11:34.58,1:11:35.87,Default,,0,0,0,,Уф...
Dialogue: 0,1:11:37.66,1:11:40.08,Default,,0,0,0,,- (Дэй) Көңіліңді түсірме - (Мигита) Қуатты бол
Dialogue: 0,1:11:40.17,1:11:43.67,Default,,0,0,0,,Менен күшті ешкім жоқ па? Хмф
Dialogue: 0,1:11:45.05,1:11:45.88,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:48.47,1:11:51.05,Default,,0,0,0,,-Жақсысың ба? -Шынымен бе?
Dialogue: 0,1:11:51.14,1:11:54.89,Default,,0,0,0,,- (Мигита) Сені лақтырып жібереді - (Дэй) Сені лақтырып жібереді.
Dialogue: 0,1:11:54.97,1:11:57.81,Default,,0,0,0,,Ясуаки-кун, жақсы көрінеді.
Dialogue: 0,1:11:57.89,1:11:59.39,Default,,0,0,0,,Тым қауіпті
Dialogue: 0,1:11:59.48,1:12:00.73,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:02.60,1:12:03.90,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:12:05.94,1:12:07.69,Default,,0,0,0,,- (Кобаяши) Жақсы! -иә?
Dialogue: 0,1:12:08.49,1:12:11.41,Default,,0,0,0,,Сақинаны ауыстырайық
Dialogue: 0,1:12:14.49,1:12:16.91,Default,,0,0,0,,Орналастырылған, реттелген
Dialogue: 0,1:12:16.99,1:12:20.21,Default,,0,0,0,,Хаккейой Нокотта!
Dialogue: 0,1:12:20.29,1:12:24.42,Default,,0,0,0,,Артында қалды! (қолдау)
Dialogue: 0,1:12:24.50,1:12:27.42,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, барыңды істе!
Dialogue: 0,1:12:27.50,1:12:28.96,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, барын істе!
Dialogue: 0,1:12:29.05,1:12:30.42,Default,,0,0,0,,- (Мигита) артта қалды! -(Такахаши) Жоғалтпа!
Dialogue: 0,1:12:30.51,1:12:32.43,Default,,0,0,0,,Уф...
Dialogue: 0,1:12:32.51,1:12:34.43,Default,,0,0,0,,Демек, ойлағанымдай…
Dialogue: 0,1:12:34.51,1:12:35.72,Default,,0,0,0,,Ха!
Dialogue: 0,1:12:40.93,1:12:41.94,Default,,0,0,0,,Ах
Dialogue: 0,1:12:42.02,1:12:43.19,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:43.27,1:12:45.02,Default,,0,0,0,,Мен тапсырамын.
Dialogue: 0,1:12:45.11,1:12:49.07,Default,,0,0,0,,Ямамотояма Ямамотояма жеңді~
Dialogue: 0,1:12:49.94,1:12:51.20,Default,,0,0,0,,Әй!
Dialogue: 0,1:12:51.99,1:12:54.70,Default,,0,0,0,,Алдамаңыз!
Dialogue: 0,1:12:54.78,1:12:55.99,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:00.33,1:13:02.71,Default,,0,0,0,,Мен алдамаймын!
Dialogue: 0,1:13:27.31,1:13:33.57,Default,,0,0,0,,♪ Күн батты, үйге қайтайық.
Dialogue: 0,1:13:33.65,1:13:34.74,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:34.82,1:13:41.08,Default,,0,0,0,,♪ Жұлдыздар пайда болды, үйге қайтайық
Dialogue: 0,1:13:41.16,1:13:47.75,Default,,0,0,0,,♪ Күн батты, үйге қайтайық.
Dialogue: 0,1:13:47.84,1:13:54.01,Default,,0,0,0,,♪ Жұлдыздар пайда болды, үйге қайтайық
Dialogue: 0,1:14:06.02,1:14:09.77,Default,,0,0,0,,♪ Tomoe Academy Boro мектебі
Dialogue: 0,1:14:09.86,1:14:13.78,Default,,0,0,0,,♪ Ішіне кірсең де, тозығы жеткен мектеп.
Dialogue: 0,1:14:13.86,1:14:16.86,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:14:16.95,1:14:18.66,Default,,0,0,0,,Бұл кім? Ол кім?
Dialogue: 0,1:14:19.66,1:14:20.78,Default,,0,0,0,,Не болды?
Dialogue: 0,1:14:23.08,1:14:25.66,Default,,0,0,0,,Арызыңыз болса, неге анық айтпайсыз?
Dialogue: 0,1:14:25.75,1:14:27.79,Default,,0,0,0,,Мен мұғалімге айтамын
Dialogue: 0,1:14:27.88,1:14:30.92,Default,,0,0,0,,Әкем солай деді.
Dialogue: 0,1:14:31.00,1:14:34.76,Default,,0,0,0,,Томое маған әр түрлі оғаш нәрселерді үйретеді.
Dialogue: 0,1:14:34.84,1:14:37.30,Default,,0,0,0,,Көптеген студенттер оқудан шығып жатыр.
Dialogue: 0,1:14:44.77,1:14:46.44,Default,,0,0,0,,Хехехе
Dialogue: 0,1:14:46.52,1:14:49.94,Default,,0,0,0,,Томое – біртүрлі мектеп.
Dialogue: 0,1:14:50.02,1:14:52.82,Default,,0,0,0,,Ондай денемен қалай күресуге болады?
Dialogue: 0,1:14:52.90,1:14:55.82,Default,,0,0,0,,Солдат бола алмаған уатқыш
Dialogue: 0,1:14:55.90,1:14:58.91,Default,,0,0,0,,(ДжоДжо) Х… Ол менің киімімді жыртып, тікелей теріме еніп барады.
Dialogue: 0,1:15:00.45,1:15:01.95,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,1:15:02.03,1:15:05.33,Default,,0,0,0,,Ясуаки-чан биік ағаштарға өрмелей алады.
Dialogue: 0,1:15:05.41,1:15:07.16,Default,,0,0,0,,Томбала, үндеме!
Dialogue: 0,1:15:07.25,1:15:09.37,Default,,0,0,0,,- (Барлығы) Ах! -(Ясуаки) Уф!
Dialogue: 0,1:15:10.13,1:15:12.29,Default,,0,0,0,,- (Ясуаки) Уф... - Ясуаки-чан!
Dialogue: 0,1:15:12.38,1:15:13.38,Default,,0,0,0,,Уф...
Dialogue: 0,1:15:13.46,1:15:15.96,Default,,0,0,0,,Бұл солтүстік-батырдағы қала ма?
Dialogue: 0,1:15:16.05,1:15:17.67,Default,,0,0,0,,Ұрысуға болмайды!
Dialogue: 0,1:15:17.76,1:15:20.22,Default,,0,0,0,,Директор осылай деді, солай ма?
Dialogue: 0,1:15:20.30,1:15:21.39,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:15:21.47,1:15:25.10,Default,,0,0,0,,♪ Tomoe Academy Boro мектебі
Dialogue: 0,1:15:25.18,1:15:28.39,Default,,0,0,0,,♪ Кіргеннен кейін де тозығы жеткен мектеп.
Dialogue: 0,1:15:28.48,1:15:31.65,Default,,0,0,0,,(ДжоДжо) Х… Ол менің киімімді жыртып, тікелей теріме еніп барады.
Dialogue: 0,1:15:31.73,1:15:36.40,Default,,0,0,0,,♪ Tomoe Academy Жақсы мектебі
Dialogue: 0,1:15:36.49,1:15:40.41,Default,,0,0,0,,♪ Бұл оқуға жақсы мектеп
Dialogue: 0,1:15:42.12,1:15:46.37,Default,,0,0,0,,♪ Tomoe Academy Жақсы мектебі
Dialogue: 0,1:15:46.45,1:15:49.92,Default,,0,0,0,,♪ Қосылу үшін жақсы мектеп
Dialogue: 0,1:15:50.00,1:15:52.42,Default,,0,0,0,,Иносукэ… Иносукэ, өзіңді жина! Иносукэ!
Dialogue: 0,1:16:00.76,1:16:04.76,Default,,0,0,0,,♪ Томое Гакуен Жақсы мектеп
Dialogue: 0,1:16:04.85,1:16:08.68,Default,,0,0,0,,♪ Байқауға болатын жақсы мектеп
Dialogue: 0,1:16:11.77,1:16:15.69,Default,,0,0,0,,♪ Томое Гакуен Жақсы мектеп
Dialogue: 0,1:16:15.77,1:16:19.70,Default,,0,0,0,,♪ Бұл оқуға жақсы мектеп
Dialogue: 0,1:16:19.78,1:16:22.32,Default,,0,0,0,,Не... бұл не?
Dialogue: 0,1:16:19.78,1:16:22.32,Default,,0,0,0,,♪ Tomoe Academy Жақсы мектебі
Dialogue: 0,1:16:22.32,1:16:22.41,Default,,0,0,0,,♪ Томое Гакуен Жақсы мектеп
Dialogue: 0,1:16:22.41,1:16:23.53,Default,,0,0,0,,♪ Tomoe Academy Жақсы мектеп
Dialogue: 0,1:16:22.41,1:16:23.53,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:23.62,1:16:24.74,Default,,0,0,0,,♪ Бұл оқуға жақсы мектеп
Dialogue: 0,1:16:24.74,1:16:25.70,Default,,0,0,0,,♪ Бұл оқуға жақсы мектеп
Dialogue: 0,1:16:24.74,1:16:25.70,Default,,0,0,0,,Ах!
Dialogue: 0,1:16:25.70,1:16:25.78,Default,,0,0,0,,♪ Байқауға болатын жақсы мектеп
Dialogue: 0,1:16:25.78,1:16:27.58,Default,,0,0,0,,♪ Бұл оқуға жақсы мектеп
Dialogue: 0,1:16:25.78,1:16:27.58,Default,,0,0,0,,Ал... күте тұрыңыз
Dialogue: 0,1:16:27.66,1:16:29.29,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:16:27.66,1:16:29.29,Default,,0,0,0,,♪ Tomoe Academy Жақсы мектебі
Dialogue: 0,1:16:29.29,1:16:30.25,Default,,0,0,0,,♪ Томое Гакуен Жақсы мектеп
Dialogue: 0,1:16:30.25,1:16:31.58,Default,,0,0,0,,♪ Tomoe Academy Жақсы мектеп
Dialogue: 0,1:16:30.25,1:16:31.58,Default,,0,0,0,,Уау!
Dialogue: 0,1:16:31.67,1:16:32.71,Default,,0,0,0,,Мен саған ешқашан осы туралы сұрастырамын деп айтқан жоқпын
Dialogue: 0,1:16:31.67,1:16:32.71,Default,,0,0,0,,♪ Бұл оқуға жақсы мектеп
Dialogue: 0,1:16:32.71,1:16:35.59,Default,,0,0,0,,♪ Қосылу үшін жақсы мектеп
Dialogue: 0,1:16:35.67,1:16:39.72,Default,,0,0,0,,♪ Томое Гакуен Жақсы мектеп
Dialogue: 0,1:16:39.80,1:16:43.72,Default,,0,0,0,,♪ Бұл оқуға жақсы мектеп
Dialogue: 0,1:16:43.80,1:16:46.01,Default,,0,0,0,,♪ Tomoe Academy...
Dialogue: 0,1:17:08.54,1:17:10.00,Default,,0,0,0,,Ах
Dialogue: 0,1:17:10.08,1:17:11.25,Default,,0,0,0,,Иә?
Dialogue: 0,1:17:14.12,1:17:15.25,Default,,0,0,0,,Уау
Dialogue: 0,1:17:17.84,1:17:19.25,Default,,0,0,0,,Шисейдо салонында
Dialogue: 0,1:17:19.34,1:17:22.13,Default,,0,0,0,,Балмұздақ жеу кезінде қарау
Dialogue: 0,1:17:24.26,1:17:26.22,Default,,0,0,0,,Анаңа көрсете аласың ба?
Dialogue: 0,1:17:26.30,1:17:27.14,Default,,0,0,0,,Хехе
Dialogue: 0,1:17:27.22,1:17:28.76,Default,,0,0,0,,-(Офицер) Ханым -Ой...
Dialogue: 0,1:17:28.85,1:17:31.77,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,1:17:31.85,1:17:34.77,Default,,0,0,0,,Уау, офицер!
Dialogue: 0,1:17:34.85,1:17:36.27,Default,,0,0,0,,Хмм?
Dialogue: 0,1:17:36.36,1:17:38.27,Default,,0,0,0,,Уф! Уау...
Dialogue: 0,1:17:41.36,1:17:46.28,Default,,0,0,0,,Маусымдық тенденцияларға байланысты адамдар сәнді киім киюден бас тартса, бұл мәселе болады.
Dialogue: 0,1:17:46.37,1:17:49.03,Default,,0,0,0,,Үнемділік – мылтық міндеті.
Dialogue: 0,1:17:49.12,1:17:51.29,Default,,0,0,0,,Электр шаштарын киюден аулақ болыңыз.
Dialogue: 0,1:17:52.25,1:17:54.21,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:17:55.37,1:17:57.29,Default,,0,0,0,,Кешірім сұраудың қажеті жоқ
Dialogue: 0,1:17:57.38,1:17:59.96,Default,,0,0,0,,Не? Сіз
Dialogue: 0,1:18:00.05,1:18:01.55,Default,,0,0,0,,Күйеуі
Dialogue: 0,1:18:01.63,1:18:05.05,Default,,0,0,0,,Электр шаш пен киімге тыйым салатын саясат болса да.
Dialogue: 0,1:18:05.13,1:18:07.09,Default,,0,0,0,,Заң болуы керек емес пе?
Dialogue: 0,1:18:07.18,1:18:08.30,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,1:18:08.39,1:18:12.31,Default,,0,0,0,,Өтінемін, басқалардың әйелдеріне қарауды доғар.
Dialogue: 0,1:18:12.39,1:18:14.31,Default,,0,0,0,,Не!
Dialogue: 0,1:18:16.19,1:18:17.31,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:18.61,1:18:20.82,Default,,0,0,0,,Тозай Тозай!
Dialogue: 0,1:18:20.90,1:18:24.24,Default,,0,0,0,,Біз оны сізге ашқымыз келеді.
Dialogue: 0,1:18:24.32,1:18:28.57,Default,,0,0,0,,Жұмбақ қарау механизмі!
Dialogue: 0,1:18:28.66,1:18:31.45,Default,,0,0,0,,Оны кез келген адам көре алады.
Dialogue: 0,1:18:31.54,1:18:32.99,Default,,0,0,0,,Nozo?
Dialogue: 0,1:18:33.08,1:18:35.91,Default,,0,0,0,,Тесікке қарап, сильфонды кеңейтіңіз.
Dialogue: 0,1:18:36.00,1:18:37.37,Default,,0,0,0,,Сонымен... Джабара?
Dialogue: 0,1:18:37.46,1:18:39.38,Default,,0,0,0,,Иә?иә?
Dialogue: 0,1:18:39.46,1:18:40.84,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:43.00,1:18:44.51,Default,,0,0,0,,О!
Dialogue: 0,1:18:44.59,1:18:46.63,Default,,0,0,0,,Айқын ғой, иә! Ақымақ!
Dialogue: 0,1:18:46.72,1:18:49.51,Default,,0,0,0,,О, бұл керемет
Dialogue: 0,1:18:49.59,1:18:51.85,Default,,0,0,0,,Жарайсың хаха
Dialogue: 0,1:18:53.64,1:18:54.89,Default,,0,0,0,,Әй?
Dialogue: 0,1:18:55.56,1:18:56.89,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:56.98,1:18:58.23,Default,,0,0,0,,(адамдар күледі)
Dialogue: 0,1:18:58.31,1:19:00.36,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,1:19:01.57,1:19:02.90,Default,,0,0,0,,Фу…
Dialogue: 0,1:19:02.98,1:19:06.07,Default,,0,0,0,,Өтінемін, өзіңізді қатты итермеңіз.
Dialogue: 0,1:19:06.15,1:19:08.41,Default,,0,0,0,,Кешіріңіз, Тоцуке
Dialogue: 0,1:19:08.49,1:19:10.82,Default,,0,0,0,,Мен оны келесі жолы қайта сатып аламын.
Dialogue: 0,1:19:10.91,1:19:13.45,Default,,0,0,0,,Иә, бұл одан да керемет.
Dialogue: 0,1:19:13.54,1:19:15.37,Default,,0,0,0,,Ах
Dialogue: 0,1:19:15.45,1:19:18.58,Default,,0,0,0,,Сәнді киім киюден аулақ болу
Dialogue: 0,1:19:18.67,1:19:22.25,Default,,0,0,0,,Сәнді киім киюден бас тарту
Dialogue: 0,1:19:22.34,1:19:25.59,Default,,0,0,0,,Осы уақытта сақиналарды толығымен жойайық.
Dialogue: 0,1:19:25.67,1:19:29.38,Default,,0,0,0,,Осы уақытта сақиналарды толығымен жойайық.
Dialogue: 0,1:19:29.47,1:19:31.47,Default,,0,0,0,,(Сағат мұнарасының уақыт сигналы)
Dialogue: 0,1:19:39.98,1:19:42.81,Default,,0,0,0,,Желім теңізден келеді...
Dialogue: 0,1:19:42.90,1:19:46.40,Default,,0,0,0,,Умебоши таудан келеді...
Dialogue: 0,1:19:46.49,1:19:49.20,Default,,0,0,0,,Бұл жеткіліксіз
Dialogue: 0,1:19:49.28,1:19:50.91,Default,,0,0,0,,Манжу…
Dialogue: 0,1:19:51.87,1:19:53.70,Default,,0,0,0,,Сіз өзімшілсіз
Dialogue: 0,1:19:53.78,1:19:55.45,Default,,0,0,0,,Шыдасақ
Dialogue: 0,1:19:55.54,1:19:58.16,Default,,0,0,0,,Сарбаздар дәмді тағамды жей алады.
Dialogue: 0,1:19:58.25,1:20:00.75,Default,,0,0,0,,Содан кейін солдат бол.
Dialogue: 0,1:20:00.83,1:20:02.54,Default,,0,0,0,,Bang Bang Bang!
Dialogue: 0,1:20:02.63,1:20:04.09,Default,,0,0,0,,- (Дэй) Уа... ау! -(Мигита) Хмф!
Dialogue: 0,1:20:04.17,1:20:05.17,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:05.25,1:20:08.67,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:20:16.64,1:20:19.02,Default,,0,0,0,,Ах
Dialogue: 0,1:20:19.10,1:20:21.94,Default,,0,0,0,,Хмм? Хмм...
Dialogue: 0,1:20:26.57,1:20:28.19,Default,,0,0,0,,Ах
Dialogue: 0,1:20:30.86,1:20:33.20,Default,,0,0,0,,- (Әйел станция қызметкерлері) Өтінемін - А...
Dialogue: 0,1:20:33.28,1:20:34.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:35.53,1:20:38.95,Default,,0,0,0,,Бұл жол жүру билеті. Онда бара аласыз.
Dialogue: 0,1:21:12.03,1:21:15.20,Default,,0,0,0,,Бүгін әкең де жоқ па?
Dialogue: 0,1:21:15.28,1:21:16.66,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:21:16.74,1:21:17.99,Default,,0,0,0,,Иә
Dialogue: 0,1:21:18.08,1:21:19.29,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:24.62,1:21:26.50,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:26.59,1:21:29.42,Default,,0,0,0,,Бұл бүгінгі түскі ас қорабы
Dialogue: 0,1:21:29.50,1:21:30.71,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:33.01,1:21:35.89,Default,,0,0,0,,Бірнеше күннен кейін рацион болады.
Dialogue: 0,1:21:35.97,1:21:38.51,Default,,0,0,0,,Осы уақытқа дейін ұстаңыз.
Dialogue: 0,1:21:38.60,1:21:42.52,Default,,0,0,0,,Жақсылап шайнаңыз және су ішіңіз.
Dialogue: 0,1:21:51.53,1:21:53.19,Default,,0,0,0,,Сіз не оқып жатырсыз?
Dialogue: 0,1:21:53.28,1:21:55.70,Default,,0,0,0,,Польнарефф, мен сені жеңе алмаймын.
Dialogue: 0,1:21:57.20,1:21:58.03,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:58.12,1:22:01.20,Default,,0,0,0,,«Том ағайдың Кевині»
Dialogue: 0,1:22:01.29,1:22:04.04,Default,,0,0,0,,Қара құлдар туралы әңгіме.
Dialogue: 0,1:22:04.71,1:22:06.75,Default,,0,0,0,,Қара құлдар?
Dialogue: 0,1:22:07.54,1:22:13.01,Default,,0,0,0,,Бұл Африкадан әкелінген қара тері адамдарға қатысты.
Dialogue: 0,1:22:13.72,1:22:18.89,Default,,0,0,0,,Олар ақ терісі бар адамдар үшін жұмыс істеуге мәжбүр.
Dialogue: 0,1:22:19.68,1:22:23.10,Default,,0,0,0,,Иә, бейшара.
Dialogue: 0,1:22:23.64,1:22:26.56,Default,,0,0,0,,Бірақ Том күшті.
Dialogue: 0,1:22:27.19,1:22:31.73,Default,,0,0,0,,Кемсітушілік қаншалықты жаман болса да, мен ешқашан бас тартпаймын.
Dialogue: 0,1:22:32.65,1:22:34.99,Default,,0,0,0,,Хмм.
Dialogue: 0,1:22:35.74,1:22:38.07,Default,,0,0,0,,Тотто-чан оқу дегеніміз не?
Dialogue: 0,1:22:38.16,1:22:39.82,Default,,0,0,0,,Иә? Жақсы!
Dialogue: 0,1:22:41.66,1:22:45.08,Default,,0,0,0,,бұл... қалыңдықтың әңгімесі
Dialogue: 0,1:22:48.75,1:22:52.17,Default,,0,0,0,,Ауа райы болжамы жоқ, сондықтан мен бара алмаймын.
Dialogue: 0,1:22:52.25,1:22:55.84,Default,,0,0,0,,Сізге саладағы мұғалім сабақ бере алар еді.
Dialogue: 0,1:23:00.47,1:23:04.47,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,1:23:05.18,1:23:07.44,Default,,0,0,0,,Сіз қарныңыз ашты.
Dialogue: 0,1:23:07.52,1:23:08.35,Default,,0,0,0,,Иә
Dialogue: 0,1:23:09.35,1:23:16.36,Default,,0,0,0,,♪ Тамағыңызды жақсылап жеңіз.
Dialogue: 0,1:23:17.32,1:23:20.45,Default,,0,0,0,,♪ Тасбақа, тасбақа, тасбақа, тасбақа
Dialogue: 0,1:23:20.53,1:23:23.37,Default,,0,0,0,,♪ тағам
Dialogue: 0,1:23:23.45,1:23:29.50,Default,,0,0,0,,♪ Тамағыңызды жақсылап жеңіз
Dialogue: 0,1:23:29.58,1:23:35.01,Default,,0,0,0,,♪ Тасбақа, тасбақа, тасбақа, тасбақа, тамақ
Dialogue: 0,1:23:35.09,1:23:36.38,Default,,0,0,0,,- (Ер адам) Эй! - (Тотто Ясуаки) Ах.
Dialogue: 0,1:23:47.27,1:23:50.65,Default,,0,0,0,,Әдепсіз әндерді айтпа
Dialogue: 0,1:23:51.40,1:23:56.40,Default,,0,0,0,,Балалар, сендер де мылтықтарды қорғайтын кішкентай азаматтарсыңдар, солай ма?
Dialogue: 0,1:23:57.19,1:23:58.40,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:09.00,1:24:10.42,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,1:24:10.50,1:24:12.38,Default,,0,0,0,,Өйткені...
Dialogue: 0,1:24:13.54,1:24:15.38,Default,,0,0,0,,Өйткені...
Dialogue: 0,1:24:16.34,1:24:20.51,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,1:24:20.59,1:24:25.60,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:24:32.73,1:24:35.69,Default,,0,0,0,,Хмм...
Dialogue: 0,1:24:35.77,1:24:38.44,Default,,0,0,0,,Хмм... Ммм...
Dialogue: 0,1:24:44.87,1:24:46.28,Default,,0,0,0,,Я...
Dialogue: 0,1:24:47.41,1:24:48.45,Default,,0,0,0,,Я...
Dialogue: 0,1:24:50.37,1:24:51.79,Default,,0,0,0,,Я...
Dialogue: 0,1:24:56.46,1:24:58.09,Default,,0,0,0,,(судың шашырауының дыбысы)
Dialogue: 0,1:24:58.17,1:24:59.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:59.55,1:25:00.97,Default,,0,0,0,,Иә?
Dialogue: 0,1:25:05.43,1:25:06.85,Default,,0,0,0,,Я...
Dialogue: 0,1:25:12.64,1:25:18.48,Default,,0,0,0,,(судың шашырауының дыбысы)
Dialogue: 0,1:25:19.61,1:25:25.49,Default,,0,0,0,,(судың шашырауының дыбысы)
Dialogue: 0,1:25:27.37,1:25:28.99,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:29.08,1:25:33.50,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:25:33.58,1:25:39.50,Default,,0,0,0,,(ритмикалық серпіліс дыбысы)
Dialogue: 0,1:25:40.51,1:25:41.51,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:25:42.42,1:25:48.51,Default,,0,0,0,,(«Сәттілік» әнінің ырғағы)
Dialogue: 0,1:25:48.60,1:25:51.35,Default,,0,0,0,,Хаха...
Dialogue: 0,1:25:51.43,1:25:52.93,Default,,0,0,0,,Ихихи
Dialogue: 0,1:25:54.94,1:25:56.52,Default,,0,0,0,,Су толқындары, олар кеткен жерге шабуыл жасаңдар
Dialogue: 0,1:25:57.65,1:26:01.03,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:26:01.11,1:26:06.11,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,1:26:49.03,1:26:50.66,Default,,0,0,0,,Мұны оқуым керек пе?
Dialogue: 0,1:26:50.74,1:26:51.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:52.33,1:26:56.33,Default,,0,0,0,,Бұл сәл ұзақ, бірақ сізге ұнайды деп ойлаймын.
Dialogue: 0,1:26:56.41,1:26:58.00,Default,,0,0,0,,Рахмет
Dialogue: 0,1:26:58.08,1:27:00.59,Default,,0,0,0,,Мектеп басталғанда қайтарамын.
Dialogue: 0,1:27:03.67,1:27:05.51,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:05.59,1:27:08.59,Default,,0,0,0,,А, дұрыстап оқы.
Dialogue: 0,1:27:08.68,1:27:10.09,Default,,0,0,0,,Сен сияқты — олардың әрқайсысы.
Dialogue: 0,1:27:14.56,1:27:17.10,Default,,0,0,0,,Иә, уәде беремін
Dialogue: 0,1:27:23.11,1:27:24.23,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,1:27:24.23,1:27:27.32,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,1:27:24.23,1:27:27.32,Default,,0,0,0,,А, а, а...
Dialogue: 0,1:27:27.40,1:27:29.41,Default,,0,0,0,,О, кездескенше!
Dialogue: 0,1:27:30.99,1:27:33.20,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,1:27:33.28,1:27:34.12,Default,,0,0,0,,Уф!
Dialogue: 0,1:27:34.20,1:27:37.62,Default,,0,0,0,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,1:27:37.71,1:27:39.46,Default,,0,0,0,,Тотто-чан
Dialogue: 0,1:27:39.54,1:27:44.55,Default,,0,0,0,,(Пойыздың дыбысынан батып кетті)
Dialogue: 0,1:27:49.09,1:27:53.43,Default,,0,0,0,,Цзиюгаока Цзиюгаока
Dialogue: 0,1:27:57.43,1:27:59.44,Default,,0,0,0,,Оқ-дәрі шығаратын зауыт сияқты.
Dialogue: 0,1:27:59.52,1:28:02.36,Default,,0,0,0,,Әкем менің әскери ән орындауымды қалады.
Dialogue: 0,1:28:02.44,1:28:03.56,Default,,0,0,0,,Хмм?
Dialogue: 0,1:28:03.65,1:28:06.86,Default,,0,0,0,,Сізге алғыс ретінде тамақ алуға болады.
Dialogue: 0,1:28:06.94,1:28:08.57,Default,,0,0,0,,Карамель де?
Dialogue: 0,1:28:08.65,1:28:12.91,Default,,0,0,0,,Өтінемін, мен сенің әкеңнен сұрауым керек.
Dialogue: 0,1:28:14.91,1:28:16.41,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,1:28:16.49,1:28:17.91,Default,,0,0,0,,Иә?
Dialogue: 0,1:28:18.87,1:28:20.71,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,1:28:20.79,1:28:22.42,Default,,0,0,0,,Курису Макисе… өліп қалады.
Dialogue: 0,1:28:25.71,1:28:27.13,Default,,0,0,0,,Иә...
Dialogue: 0,1:28:28.26,1:28:29.92,Default,,0,0,0,,That's right.
Dialogue: 0,1:28:30.01,1:28:31.22,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:28:31.30,1:28:32.93,Default,,0,0,0,,-Хехехе -Ахаха
Dialogue: 0,1:28:33.01,1:28:36.93,Default,,0,0,0,,Иә! карамель карамель
Dialogue: 0,1:28:37.02,1:28:41.48,Default,,0,0,0,,«Жоқ, жоқ, жоқ»
Dialogue: 0,1:28:41.56,1:28:45.86,Default,,0,0,0,,«Менің жаным күйеуімдікі емес».
Dialogue: 0,1:28:45.94,1:28:48.57,Default,,0,0,0,,«Ештеңе сатып алмаңыз».
Dialogue: 0,1:28:48.65,1:28:51.95,Default,,0,0,0,,«Мен оны сатып ала алмаймын».
Dialogue: 0,1:28:56.08,1:28:59.58,Default,,0,0,0,,Жанды сатып ала алмайсың
Dialogue: 0,1:29:47.67,1:29:50.00,Default,,0,0,0,,Ясуаки-чан, ұш!
Dialogue: 0,1:29:50.76,1:29:51.96,Default,,0,0,0,,Уф!
Dialogue: 0,1:29:55.89,1:29:57.30,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,1:30:01.39,1:30:02.73,Default,,0,0,0,,Міне!
Dialogue: 0,1:30:15.82,1:30:16.82,Default,,0,0,0,,Ах
Dialogue: 0,1:30:16.91,1:30:19.91,Default,,0,0,0,,Ясуаки-чан!
Dialogue: 0,1:30:20.83,1:30:22.04,Default,,0,0,0,,Ха…
Dialogue: 0,1:30:23.91,1:30:25.54,Default,,0,0,0,,Фу…
Dialogue: 0,1:30:28.84,1:30:33.84,Default,,0,0,0,,Косэй тағы да күйреуге ұшырайды.
Dialogue: 0,1:31:59.30,1:32:04.35,Default,,0,0,0,,Мен скрипкада әскери әндерді ойнағым келмейді
Dialogue: 0,1:32:10.65,1:32:13.36,Default,,0,0,0,,Иә, неге тоқтамайсың?
Dialogue: 0,1:32:13.44,1:32:15.65,Default,,0,0,0,,Тіпті тамақ...
Dialogue: 0,1:32:16.98,1:32:18.86,Default,,0,0,0,,Бұл қалай да болады.
Dialogue: 0,1:32:23.16,1:32:25.95,Default,,0,0,0,,Кешіріңіз, Тоцуке
Dialogue: 0,1:32:27.25,1:32:28.25,Default,,0,0,0,,Ах...
Dialogue: 0,1:32:28.33,1:32:29.96,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,1:32:30.58,1:32:34.25,Default,,0,0,0,,Әкемнің скрипкасы, мен оны жақсы көремін
Dialogue: 0,1:32:37.84,1:32:39.38,Default,,0,0,0,,-Жарайды -Уау!
Dialogue: 0,1:32:39.47,1:32:41.51,Default,,0,0,0,,Онда!
Dialogue: 0,1:32:41.59,1:32:43.76,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,1:32:43.84,1:32:47.77,Default,,0,0,0,,(Күлкі мен Роккидің айқайы)
Dialogue: 0,1:32:48.68,1:32:51.77,Default,,0,0,0,,Барлығы өз орындарына отыр
Dialogue: 0,1:32:51.85,1:32:53.48,Default,,0,0,0,,(шу)
Dialogue: 0,1:32:53.56,1:32:54.40,Default,,0,0,0,,Ах...
Dialogue: 0,1:32:54.48,1:32:55.90,Default,,0,0,0,,Дұрыстап тазалаңыз, жарай ма?
Dialogue: 0,1:32:55.98,1:32:58.61,Default,,0,0,0,,- (Дэй) Бае! -(Ясу) Аа, директор...
Dialogue: 0,1:33:03.74,1:33:06.53,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:14.29,1:33:17.30,Default,,0,0,0,,Ясуаки-чан қайтыс болды.
Dialogue: 0,1:33:17.38,1:33:18.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:33:28.35,1:33:32.64,Default,,0,0,0,,Ясуаки-чан барлығының досы болды.
Dialogue: 0,1:33:33.94,1:33:36.44,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,1:33:40.23,1:33:42.03,Default,,0,0,0,,Мұғалім де...
Dialogue: 0,1:33:43.78,1:33:47.24,Default,,0,0,0,,Мен өте қайғылы сезінемін
Dialogue: 0,1:33:51.91,1:33:56.92,Default,,0,0,0,,(құбыр органының өнімділігі)
Dialogue: 0,1:34:55.02,1:34:59.69,Default,,0,0,0,,Том аға, мен сізді қайтара алмаймын.
Dialogue: 0,1:35:03.03,1:35:07.20,Default,,0,0,0,,Бір күні мен өскенде
Dialogue: 0,1:35:07.28,1:35:09.95,Default,,0,0,0,,Бір жерде тағы кездесеміз, солай ма?
Dialogue: 0,1:35:13.87,1:35:17.79,Default,,0,0,0,,Осы уақытқа дейін жазылып кетеді деп үміттенемін.
Dialogue: 0,1:35:53.66,1:35:55.29,Default,,0,0,0,,Тотто-чан
Dialogue: 0,1:35:57.33,1:36:00.75,Default,,0,0,0,,Көп нәрсе қызық болды.
Dialogue: 0,1:36:01.58,1:36:05.21,Default,,0,0,0,,Мен сені ұмытпаймын
Dialogue: 0,1:36:09.38,1:36:13.85,Default,,0,0,0,,Мен де ұмытпаймын
Dialogue: 0,1:36:18.35,1:36:19.35,Default,,0,0,0,,О, о...
Dialogue: 0,1:36:23.27,1:36:24.48,Default,,0,0,0,,Тотто-чан!
Dialogue: 0,1:37:59.41,1:38:04.42,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:38:25.10,1:38:28.02,Default,,0,0,0,,Аман болсын! Ура!
Dialogue: 0,1:38:28.11,1:38:31.03,Default,,0,0,0,,Аман болсын! Ура!
Dialogue: 0,1:39:37.05,1:39:40.97,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:39:43.14,1:39:44.97,Default,,0,0,0,,Ах!
Dialogue: 0,1:39:58.07,1:40:02.53,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:40:02.62,1:40:04.87,Default,,0,0,0,,Уф...
Dialogue: 0,1:40:06.58,1:40:08.79,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:40:08.87,1:40:10.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:14.09,1:40:17.30,Default,,0,0,0,,Хаха...
Dialogue: 0,1:40:18.72,1:40:22.51,Default,,0,0,0,,Бұл маңызды нәрсе емес пе?
Dialogue: 0,1:40:22.59,1:40:24.01,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:28.60,1:40:33.61,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:40:50.62,1:40:55.04,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,1:40:56.84,1:40:59.05,Default,,0,0,0,,Иә иә иә иә
Dialogue: 0,1:41:00.13,1:41:02.01,Default,,0,0,0,,Тецуко-сан, бұл...
Dialogue: 0,1:41:02.09,1:41:03.51,Default,,0,0,0,,Жарайды
Dialogue: 0,1:41:05.01,1:41:07.06,Default,,0,0,0,,Мен оны дұрыс ұстадым.
Dialogue: 0,1:41:07.89,1:41:09.39,Default,,0,0,0,,И-иә… дұрыс
Dialogue: 0,1:41:09.48,1:41:11.64,Default,,0,0,0,,Мама, күте тұрыңыз.
Dialogue: 0,1:41:11.73,1:41:12.56,Default,,0,0,0,,Иә?
Dialogue: 0,1:41:14.61,1:41:15.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:17.90,1:41:19.11,Default,,0,0,0,,Қалай болғанда да, ең алдымен мен Мими-уэге жақындауым керек, бірақ
Dialogue: 0,1:41:19.19,1:41:20.57,Default,,0,0,0,,Мен кетемін
Dialogue: 0,1:41:20.65,1:41:24.78,Default,,0,0,0,,Сәлемдесу (есіктің ашылу және жабылу дыбысы)
Dialogue: 0,1:41:28.33,1:41:32.08,Default,,0,0,0,,Ертеңнен бастап біраз уақыт қоштасамыз.
Dialogue: 0,1:41:32.16,1:41:35.58,Default,,0,0,0,,Осы жерде міндетті түрде тағы кездесейік.
Dialogue: 0,1:41:36.63,1:41:40.96,Default,,0,0,0,,Келесі жолы мен ауылдан жерлеуге арналған тоқаш әкелемін!
Dialogue: 0,1:41:41.05,1:41:43.09,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:41:43.76,1:41:48.72,Default,,0,0,0,,Доктор Ойши, құлаған кезде мені таңғаны үшін.
Dialogue: 0,1:41:48.81,1:41:51.10,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:41:51.81,1:41:55.19,Default,,0,0,0,,Мен Жапониядағы ең жақсы бағбан боламын.
Dialogue: 0,1:41:55.27,1:41:57.40,Default,,0,0,0,,Я, Жапониядағы нөмірі бірінші!
Dialogue: 0,1:41:57.48,1:41:58.61,Default,,0,0,0,,Хехехе
Dialogue: 0,1:41:59.44,1:42:04.61,Default,,0,0,0,,Егер сіз жарақат алған жануарды көрсеңіз, оны маған әкеліңіз.
Dialogue: 0,1:42:05.28,1:42:08.45,Default,,0,0,0,,Негізі мен ағылшын тілінде қоштасқым келеді.
Dialogue: 0,1:42:08.53,1:42:11.12,Default,,0,0,0,,Соғыс біткенше шыдаймын.
Dialogue: 0,1:42:11.20,1:42:14.46,Default,,0,0,0,,Мен физиканы оқыдым.
Dialogue: 0,1:42:14.54,1:42:17.13,Default,,0,0,0,,Мен керемет дәрігер болғым келеді
Dialogue: 0,1:42:17.71,1:42:21.63,Default,,0,0,0,,Барлығы үшін рахмет!
Dialogue: 0,1:42:21.71,1:42:25.09,Default,,0,0,0,,Барлығыңыз хат жазыңыз.
Dialogue: 0,1:42:25.18,1:42:26.64,Default,,0,0,0,,Мен сенімдімін
Dialogue: 0,1:42:26.72,1:42:28.14,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,1:42:31.93,1:42:33.93,Default,,0,0,0,,Уф...
Dialogue: 0,1:42:39.23,1:42:40.65,Default,,0,0,0,,Аоки мырза...
Dialogue: 0,1:42:46.53,1:42:49.91,Default,,0,0,0,,Кейконың тауығы аспанда ұшады!
Dialogue: 0,1:42:49.99,1:42:51.99,Default,,0,0,0,,Кокекоккоккокко
Dialogue: 0,1:42:52.08,1:42:53.54,Default,,0,0,0,,Кокекоккоккокко
Dialogue: 0,1:42:53.62,1:42:55.66,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:42:55.75,1:42:58.67,Default,,0,0,0,,Кокекоккокко (күлді)
Dialogue: 0,1:42:58.75,1:43:01.67,Default,,0,0,0,,Қанша жерден жүрсең де
Dialogue: 0,1:43:02.75,1:43:05.67,Default,,0,0,0,,Сіз міндетті түрде қайтасыз, солай ма?
Dialogue: 0,1:43:09.01,1:43:10.18,Default,,0,0,0,,Хехехе
Dialogue: 0,1:43:10.26,1:43:13.68,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:43:13.77,1:43:18.77,Default,,0,0,0,,(Фортепиано орындауы: «Сәттілік» әні)
Dialogue: 0,1:43:53.22,1:43:54.22,Default,,0,0,0,,Ах!
Dialogue: 0,1:43:54.31,1:43:57.31,Default,,0,0,0,,(диаграмманы жырту дыбысы)
Dialogue: 0,1:43:59.31,1:44:03.32,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:44:05.78,1:44:07.53,Default,,0,0,0,,Негізгі
Dialogue: 0,1:44:10.36,1:44:12.24,Default,,0,0,0,,Әңгіме
Dialogue: 0,1:44:17.37,1:44:20.25,Default,,0,0,0,,Бұл не? Менімен сөйлес
Dialogue: 0,1:44:25.88,1:44:27.09,Default,,0,0,0,,Хехе
Dialogue: 0,1:44:28.59,1:44:32.01,Default,,0,0,0,,Мен өскенде
Dialogue: 0,1:44:32.09,1:44:35.26,Default,,0,0,0,,Мен сенің осы мектепте мұғалім боламын.
Dialogue: 0,1:44:42.35,1:44:44.19,Default,,0,0,0,,Сіз уәде бересіз бе?
Dialogue: 0,1:44:46.23,1:44:48.78,Default,,0,0,0,,Иә, уәде беремін
Dialogue: 0,1:45:00.83,1:45:01.67,Default,,0,0,0,,Ах...
Dialogue: 0,1:45:03.25,1:45:04.67,Default,,0,0,0,,Сен…
Dialogue: 0,1:45:05.54,1:45:09.97,Default,,0,0,0,,Ол шынымен жақсы бала.
Dialogue: 0,1:45:12.22,1:45:13.97,Default,,0,0,0,,Сау болыңыз
Dialogue: 0,1:45:25.31,1:45:27.69,Default,,0,0,0,,Әуе шабуылдары күшейе түседі
Dialogue: 0,1:45:27.77,1:45:31.45,Default,,0,0,0,,Біз де Аомориге эвакуациялауды шештік.
Dialogue: 0,1:45:32.20,1:45:33.53,Default,,0,0,0,,Жақсы!
Dialogue: 0,1:45:33.61,1:45:37.53,Default,,0,0,0,,Темір жол бойындағы қызыл шатырлы үй
Dialogue: 0,1:45:33.61,1:45:37.53,Default,,0,0,0,,Жақсы! Жақсы!
Dialogue: 0,1:45:37.62,1:45:40.45,Default,,0,0,0,,Ол ғимаратты эвакуациялау кезінде бұзылған.
Dialogue: 0,1:45:40.54,1:45:44.08,Default,,0,0,0,,Жақсы! Жақсы!
Dialogue: 0,1:45:51.55,1:45:55.30,Default,,0,0,0,,Томое академиясы да...
Dialogue: 0,1:45:51.55,1:45:55.30,Default,,0,0,0,,(Әуе шабуылы туралы ескерту)
Dialogue: 0,1:45:55.30,1:45:56.55,Default,,0,0,0,,(Әуе шабуылы туралы ескерту)
Dialogue: 0,1:46:41.81,1:46:44.52,Default,,0,0,0,,Мектептің жанып жатқанын көру
Dialogue: 0,1:46:44.60,1:46:48.11,Default,,0,0,0,,деді Кобаяши мырза
Dialogue: 0,1:46:48.19,1:46:49.40,Default,,0,0,0,,Эй
Dialogue: 0,1:46:51.15,1:46:56.57,Default,,0,0,0,,Бұл жолы қандай мектеп салуымыз керек?
Dialogue: 0,1:46:56.66,1:47:00.91,Default,,0,0,0,,Мұғалімнің балаға деген махаббаты
Dialogue: 0,1:47:00.99,1:47:05.46,Default,,0,0,0,,Бұл мектепті шарпыған жалыннан да үлкен болды.
Dialogue: 0,1:47:16.43,1:47:21.43,Default,,0,0,0,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,1:47:23.64,1:47:28.44,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,1:47:28.52,1:47:31.57,Default,,0,0,0,,(Баланың қатты жылауы)
Dialogue: 0,1:47:31.65,1:47:33.07,Default,,0,0,0,,(Ер адамның жөтелі)
Dialogue: 0,1:47:36.11,1:47:37.70,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:47:37.78,1:47:39.32,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,1:47:39.41,1:47:44.41,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,1:47:52.17,1:47:55.92,Default,,0,0,0,,Жарайды, жарайды, жылама.
Dialogue: 0,1:48:00.84,1:48:01.85,Default,,0,0,0,,Ах...
Dialogue: 0,1:48:06.93,1:48:08.56,Default,,0,0,0,,Ах...
Dialogue: 0,1:48:08.64,1:48:10.85,Default,,0,0,0,,Иә?
Dialogue: 0,1:48:10.94,1:48:14.86,Default,,0,0,0,,(Чиндония спектаклі)
Dialogue: 0,1:48:14.94,1:48:16.36,Default,,0,0,0,,Ах!
Dialogue: 0,1:48:19.95,1:48:21.16,Default,,0,0,0,,Уф!
Dialogue: 0,1:48:21.95,1:48:27.87,Default,,0,0,0,,(Чиндон-я спектаклі)
Dialogue: 0,1:48:27.95,1:48:29.29,Default,,0,0,0,,Чиндон…
Dialogue: 0,1:48:29.37,1:48:30.79,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,1:48:52.06,1:48:54.06,Default,,0,0,0,,Жақсы қыз.
Dialogue: 0,1:48:54.15,1:48:58.65,Default,,0,0,0,,Сен өте жақсы қызсың
Dialogue: 0,1:48:58.74,1:49:00.74,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,1:49:07.58,1:49:12.58,Default,,0,0,0,,♪~
Dialogue: 0,1:53:39.85,1:53:44.85,Default,,0,0,0,,~♪
