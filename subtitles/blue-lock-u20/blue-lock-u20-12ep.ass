Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.51,0:00:19.85,Default,,0,0,0,,♪~
Dialogue: 0,0:01:38.93,0:01:44.93,Default,,0,0,0,,~♪
Dialogue: 0,0:01:50.02,0:01:51.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:51.48,0:01:52.98,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:01:53.07,0:01:56.90,Default,,0,0,0,,Тіпті мен басында шабуылшы болғым келді.
Dialogue: 0,0:02:00.07,0:02:01.78,Default,,0,0,0,,Керемет көмек!
Dialogue: 0,0:02:02.62,0:02:06.16,Default,,0,0,0,,«Біреу үшін, ұжым үшін»
Dialogue: 0,0:02:06.70,0:02:08.75,Default,,0,0,0,,Үлкендер осылай айтатын.
Dialogue: 0,0:02:09.54,0:02:12.17,Default,,0,0,0,,Сіз ойыннан кейінгі ойынға назар аударуыңыз керек.
Dialogue: 0,0:02:12.63,0:02:14.75,Default,,0,0,0,,Егер сіз осында болсаңыз, шабуылшы жұмыс істейді.
Dialogue: 0,0:02:15.38,0:02:17.17,Default,,0,0,0,,Бірақ директор
Dialogue: 0,0:02:17.26,0:02:20.43,Default,,0,0,0,,Мен әлемнің үздік шабуылшысы болғым келеді.
Dialogue: 0,0:02:20.51,0:02:22.10,Default,,0,0,0,,Көмекші емес
Dialogue: 0,0:02:24.81,0:02:27.18,Default,,0,0,0,,Мен гол соғу үшін қалай көбірек күресу керек...
Dialogue: 0,0:02:29.64,0:02:32.52,Default,,0,0,0,,Маған ойнағым келетін футбол ойнауға рұқсат етіңізші.
Dialogue: 0,0:02:35.23,0:02:36.28,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:02:37.44,0:02:40.57,Default,,0,0,0,,Футбол – командалар жеңіске жететін спорт түрі.
Dialogue: 0,0:02:41.16,0:02:44.16,Default,,0,0,0,,Тәртіпті сақтау керек болса, матчқа қатысуға рұқсат етілмейді.
Dialogue: 0,0:02:46.20,0:02:47.25,Default,,0,0,0,,(кесу дыбысы)
Dialogue: 0,0:02:48.66,0:02:50.21,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:02:52.13,0:02:53.38,Default,,0,0,0,,A~iai
Dialogue: 0,0:02:55.34,0:02:56.92,Default,,0,0,0,,Барлық ересектер...
Dialogue: 0,0:03:00.13,0:03:02.22,Default,,0,0,0,,Тек гүлдегіңіз келетін бүршіктер үшін...
Dialogue: 0,0:03:02.84,0:03:04.60,Default,,0,0,0,,Су бермеңіз
Dialogue: 0,0:03:06.39,0:03:10.64,Default,,0,0,0,,Есептеуге болатын гүлдерден басқа гүлдердің гүлденуіне жол берілмейді.
Dialogue: 0,0:03:12.35,0:03:15.48,Default,,0,0,0,,Мен түсінгенде...
Dialogue: 0,0:03:16.23,0:03:18.69,Default,,0,0,0,,Олардың барлығының гүлі бір
Dialogue: 0,0:03:20.45,0:03:21.70,Default,,0,0,0,,Керемет көмек!
Dialogue: 0,0:03:21.78,0:03:24.07,Default,,0,0,0,,Мен сенің жаныңда болсам, мен ең күшті болар едім!
Dialogue: 0,0:03:24.16,0:03:26.20,Default,,0,0,0,,Біз ең жақсы командамыз!
Dialogue: 0,0:03:27.95,0:03:29.45,Default,,0,0,0,,Мен мұны білмей тұрып, мен де...
Dialogue: 0,0:03:31.25,0:03:33.50,Default,,0,0,0,,Гүлденуді ұмытып қалдым
Dialogue: 0,0:03:37.59,0:03:40.01,Default,,0,0,0,,Директор Жақында мен...
Dialogue: 0,0:03:40.47,0:03:42.68,Default,,0,0,0,,Футбол қызық емес
Dialogue: 0,0:03:42.76,0:03:46.89,Default,,0,0,0,,Ей, сен кәсіпқой болу жай ғана арман емес.
Dialogue: 0,0:03:47.89,0:03:49.81,Default,,0,0,0,,Кәсіби...
Dialogue: 0,0:03:51.73,0:03:53.98,Default,,0,0,0,,Біраз ақша табыңыз
Dialogue: 0,0:03:54.06,0:03:56.69,Default,,0,0,0,,Менің сүйкімді әпкемге үйлен
Dialogue: 0,0:03:56.77,0:03:58.73,Default,,0,0,0,,Мен бақыттымын...
Dialogue: 0,0:04:00.19,0:04:01.24,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:02.11,0:04:04.82,Default,,0,0,0,,Сіз әлемнің ең үздік шабуылшысы бола аласыз ба?
Dialogue: 0,0:04:05.82,0:04:08.12,Default,,0,0,0,,Хаха... Менің қолымнан келеді.
Dialogue: 0,0:04:08.20,0:04:09.91,Default,,0,0,0,,…қандай зат болмасын, бәрін бомбаға айналдырады.
Dialogue: 0,0:04:11.20,0:04:13.12,Default,,0,0,0,,Мен бір бола алмаймын деп ойлаймын.
Dialogue: 0,0:04:14.33,0:04:18.84,Default,,0,0,0,,Мен бір бола алатыныма сендім, бірақ оны білмей тұрып, мен өлдім.
Dialogue: 0,0:04:21.21,0:04:24.05,Default,,0,0,0,,Мен үлкендерді кінәлағым келмейді.
Dialogue: 0,0:04:24.13,0:04:27.14,Default,,0,0,0,,Өйткені мен оның ішіне кіре алмаған едім.
Dialogue: 0,0:04:28.26,0:04:31.72,Default,,0,0,0,,Осы жерде шабуылшы болып өмірімді аяқтайық.
Dialogue: 0,0:04:33.60,0:04:35.77,Default,,0,0,0,,Директор I...
Dialogue: 0,0:04:36.85,0:04:39.40,Default,,0,0,0,,Мен әлемдегі ең жақсы қорғаушы болғым келеді
Dialogue: 0,0:04:39.98,0:04:41.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:41.73,0:04:45.86,Default,,0,0,0,,Сіз жалықтыратын шабуылшыларды жаппай шығарып жатырсыз...
Dialogue: 0,0:04:48.62,0:04:51.79,Default,,0,0,0,,Қорғаушы ретінде мен оны жойғым келеді!
Dialogue: 0,0:04:52.79,0:04:55.33,Default,,0,0,0,,Мен енді ешкім үшін футбол ойнамаймын
Dialogue: 0,0:04:57.58,0:04:58.84,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:59.79,0:05:02.42,Default,,0,0,0,,Мына гүлді маған гүлдендір!
Dialogue: 0,0:05:03.38,0:05:06.38,Default,,0,0,0,,Ах! Олива Айсора Өте анық!
Dialogue: 0,0:05:06.47,0:05:07.34,Default,,0,0,0,,Екінші доп!
Dialogue: 0,0:05:11.93,0:05:13.60,Default,,0,0,0,,Рахмет сендерге балалар
Dialogue: 0,0:05:13.68,0:05:16.02,Default,,0,0,0,,Мұнда кернеу артып келеді.
Dialogue: 0,0:05:16.64,0:05:18.15,Default,,0,0,0,,Жаулар мен одақтастарды орналастыру
Dialogue: 0,0:05:18.23,0:05:19.86,Default,,0,0,0,,Келесі әрекет
Dialogue: 0,0:05:20.31,0:05:22.19,Default,,0,0,0,,Сезімталдық жоғарылайды!
Dialogue: 0,0:05:22.94,0:05:24.90,Default,,0,0,0,,Оны бүкіл денеңмен түсінуге болады!
Dialogue: 0,0:05:24.99,0:05:28.61,Default,,0,0,0,,Мен жинаған барлық қабілеттер
Dialogue: 0,0:05:29.49,0:05:31.78,Default,,0,0,0,,Дүниені мұнда жеткенде ғана көре аласыз
Dialogue: 0,0:05:32.41,0:05:33.83,Default,,0,0,0,,Бұл сезім...
Dialogue: 0,0:05:34.29,0:05:35.33,Default,,0,0,0,,Жеңілмейтін!
Dialogue: 0,0:05:36.96,0:05:38.46,Default,,0,0,0,,Уф... ирексіз!?
Dialogue: 0,0:05:39.04,0:05:40.46,Default,,0,0,0,,Осылай ма?
Dialogue: 0,0:05:40.54,0:05:42.30,Default,,0,0,0,,Мен сол қимылды жемеймін
Dialogue: 0,0:05:42.80,0:05:44.67,Default,,0,0,0,,Оны тепкілеген сәт емес...
Dialogue: 0,0:05:46.47,0:05:50.89,Default,,0,0,0,,Қабілеттерді пайдалану үшін қажетті уақыт пен кеңістіктегі уақытша алшақтық
Dialogue: 0,0:05:50.97,0:05:52.85,Default,,0,0,0,,Міне аң аулайтын уақыт!
Dialogue: 0,0:05:52.93,0:05:53.81,Default,,0,0,0,,Рин!
Dialogue: 0,0:05:55.14,0:05:56.52,Default,,0,0,0,,Тағы да сол жігіт
Dialogue: 0,0:05:56.60,0:05:59.73,Default,,0,0,0,,Әр адам өз мүддесі үшін қозғалады.
Dialogue: 0,0:05:59.81,0:06:02.11,Default,,0,0,0,,Олардың жақсы жұп болғаны сонша, тітіркендіреді.
Dialogue: 0,0:06:03.40,0:06:05.99,Default,,0,0,0,,Көк рок жобасы
Dialogue: 0,0:06:06.07,0:06:07.78,Default,,0,0,0,,Егер ол үш жыл бұрын басталған болса —
Dialogue: 0,0:06:08.65,0:06:09.70,Default,,0,0,0,,Мен де сол жақтамын...
Dialogue: 0,0:06:09.78,0:06:12.49,Default,,0,0,0,,Менің ойымша, ол әлі де шабуылшы болуды мақсат еткен.
Dialogue: 0,0:06:14.04,0:06:15.24,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:15.33,0:06:18.66,Default,,0,0,0,,Балалар, сендер мен таңдай алмаған тағы бір әңгімесіңдер ме?
Dialogue: 0,0:06:18.75,0:06:19.79,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:06:21.29,0:06:23.34,Default,,0,0,0,,Менің ойымша, бұл бұзылмайды!
Dialogue: 0,0:06:23.42,0:06:25.42,Default,,0,0,0,,Рин жеңілді!?
Dialogue: 0,0:06:25.51,0:06:27.80,Default,,0,0,0,,Оқу мен реакция деңгейі жоғарылады...
Dialogue: 0,0:06:28.80,0:06:30.05,Default,,0,0,0,,Ағын…
Dialogue: 0,0:06:30.59,0:06:32.30,Default,,0,0,0,,Сізді қиратыңыз...
Dialogue: 0,0:06:37.18,0:06:38.77,Default,,0,0,0,,Мен гүлдеймін!
Dialogue: 0,0:06:39.56,0:06:41.94,Default,,0,0,0,,U(Under)-20 капитан Оливер Айсора!
Dialogue: 0,0:06:42.02,0:06:44.86,Default,,0,0,0,,Мен Көк жартастың шабуылын өз бетіммен жеңе алдым!
Dialogue: 0,0:06:44.94,0:06:48.57,Default,,0,0,0,,Бұл жігіт!? Ол барлық бағытта әрекет ете ме?
Dialogue: 0,0:06:49.32,0:06:51.11,Default,,0,0,0,,Айзора Өте өткір екенсіз!
Dialogue: 0,0:06:51.20,0:06:52.45,Default,,0,0,0,,Ояну!
Dialogue: 0,0:06:52.53,0:06:54.20,Default,,0,0,0,,Егер сіз тырыссаңыз, мұны істей аласыз, солай ма?
Dialogue: 0,0:06:55.37,0:06:57.16,Default,,0,0,0,,Өзімшіл капитан
Dialogue: 0,0:06:58.50,0:07:00.62,Default,,0,0,0,,Соңғы кредиттерге дайындалу
Dialogue: 0,0:07:00.71,0:07:03.58,Default,,0,0,0,,Жасай бер, данышпан-чан
Dialogue: 0,0:07:04.38,0:07:06.84,Default,,0,0,0,,Біз де кеттік!
Dialogue: 0,0:07:06.92,0:07:08.80,Default,,0,0,0,,Сіз мұны істей аласыз! Осы жерден!
Dialogue: 0,0:07:08.88,0:07:11.76,Default,,0,0,0,,U-20-ның мамандығы - жылдам есептегіш!
Dialogue: 0,0:07:12.47,0:07:14.60,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз, Сей Итоши
Dialogue: 0,0:07:15.14,0:07:17.43,Default,,0,0,0,,Келесі Егер шешілсе, ол аяқталуға жақын
Dialogue: 0,0:07:17.52,0:07:20.06,Default,,0,0,0,,Уақытты табыңыз! Құрылымыңызды дайындаңыз!
Dialogue: 0,0:07:21.60,0:07:23.48,Default,,0,0,0,,Еде қарға
Dialogue: 0,0:07:23.56,0:07:26.98,Default,,0,0,0,,Сіз тоқтағаннан кейін бірнеше секундта қауіпті жол курсын оқи аласыз!
Dialogue: 0,0:07:27.07,0:07:28.94,Default,,0,0,0,,Керемет Хёори!
Dialogue: 0,0:07:29.03,0:07:30.70,Default,,0,0,0,,Қауіпті маған қалдыр
Dialogue: 0,0:07:31.99,0:07:33.28,Default,,0,0,0,,Мен түлкімін!
Dialogue: 0,0:07:33.36,0:07:35.99,Default,,0,0,0,,Хачираку жағына қамқорлық жасалды.
Dialogue: 0,0:07:36.08,0:07:37.12,Default,,0,0,0,,«Мен»…
Dialogue: 0,0:07:38.16,0:07:41.08,Default,,0,0,0,,Осы жігітпен қақпа алдындағы әуе шайқасына назар аударыңыз!
Dialogue: 0,0:07:41.58,0:07:43.92,Default,,0,0,0,,Жарайды, есептегішті ұстадым!
Dialogue: 0,0:07:44.00,0:07:45.04,Default,,0,0,0,,Қалғаны мен...
Dialogue: 0,0:07:46.63,0:07:48.50,Default,,0,0,0,,Мына шайтанды тоқтат!
Dialogue: 0,0:07:49.42,0:07:51.22,Default,,0,0,0,,Аумин
Dialogue: 0,0:07:53.84,0:07:55.22,Default,,0,0,0,,Тез қадам бас!
Dialogue: 0,0:07:55.30,0:07:59.02,Default,,0,0,0,,Бұл жігіт қарапайым физикалық қабілетпен жарысты!
Dialogue: 0,0:07:59.68,0:08:00.81,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:08:01.27,0:08:04.40,Default,,0,0,0,,Бұл қамқорлық пен Sae уақытын бір уақытта көшіру мүмкін емес.
Dialogue: 0,0:08:04.90,0:08:07.61,Default,,0,0,0,,Жоқ, мен сені енді тоқтата алмаймын.
Dialogue: 0,0:08:08.90,0:08:10.03,Default,,0,0,0,,Кихи...
Dialogue: 0,0:08:10.11,0:08:11.32,Default,,0,0,0,,Ха... келе жатыр!
Dialogue: 0,0:08:11.78,0:08:12.90,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:13.70,0:08:15.62,Default,,0,0,0,,Жылдамдық та, уақыт та ең жақсы!
Dialogue: 0,0:08:15.70,0:08:16.95,Default,,0,0,0,,Бірақ бұл қашықтық
Dialogue: 0,0:08:17.41,0:08:19.16,Default,,0,0,0,,Артқы жағынан көрінбейтін траектория
Dialogue: 0,0:08:19.62,0:08:21.87,Default,,0,0,0,,Әдетте ату мүмкін емес еді
Dialogue: 0,0:08:21.95,0:08:23.71,Default,,0,0,0,,...Ойланып қарасаң, соғыласың!
Dialogue: 0,0:08:23.79,0:08:25.12,Default,,0,0,0,,Қарсылас - Шидо!
Dialogue: 0,0:08:25.88,0:08:27.08,Default,,0,0,0,,Жақсы Рейу
Dialogue: 0,0:08:27.17,0:08:30.05,Default,,0,0,0,,Сіздің жауабыңыз менің нұсқаларымды қысқартты.
Dialogue: 0,0:08:30.13,0:08:32.01,Default,,0,0,0,,Осы позициядан сіз мыналарды мақсат ете аласыз:
Dialogue: 0,0:08:32.51,0:08:34.72,Default,,0,0,0,,Бұл жағы жоғарғы немесе төменгі
Dialogue: 0,0:08:36.43,0:08:37.47,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:08:38.35,0:08:39.72,Default,,0,0,0,,Құмар ойындар!
Dialogue: 0,0:08:39.81,0:08:40.85,Default,,0,0,0,,Қазірдің өзінде болжам!
Dialogue: 0,0:08:41.52,0:08:42.77,Default,,0,0,0,,Төменгі! Кәне!
Dialogue: 0,0:08:44.73,0:08:47.19,Default,,0,0,0,,А... Әй, сен жоғарыдасың ба?
Dialogue: 0,0:08:47.27,0:08:48.90,Default,,0,0,0,,Dokkaan!
Dialogue: 0,0:08:49.61,0:08:50.82,Default,,0,0,0,,Әлі де мүмкіндік!
Dialogue: 0,0:08:51.86,0:08:53.69,Default,,0,0,0,,Шачихоко!
Dialogue: 0,0:08:53.78,0:08:55.40,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:55.99,0:08:57.99,Default,,0,0,0,,- (Терутомо) Мен оны тоқтаттым! -(Нацуки) Жоқ, ол әлі ойында!
Dialogue: 0,0:08:58.74,0:09:00.08,Default,,0,0,0,,Мен оны тоқтатамын!
Dialogue: 0,0:09:00.16,0:09:01.33,Default,,0,0,0,,Егер түртсеңіз...
Dialogue: 0,0:09:01.41,0:09:02.33,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:09:02.41,0:09:03.54,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:09:04.54,0:09:06.50,Default,,0,0,0,,Бұрышқа жүгір!
Dialogue: 0,0:09:07.50,0:09:08.54,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:09:10.00,0:09:11.92,Default,,0,0,0,,Сіз қаншалықты көрдім деп ойлайсыз?
Dialogue: 0,0:09:14.05,0:09:15.47,Default,,0,0,0,,Жылдам сіңіру
Dialogue: 0,0:09:15.55,0:09:16.59,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:17.68,0:09:19.55,Default,,0,0,0,,Түртіп көтеру...
Dialogue: 0,0:09:20.05,0:09:22.27,Default,,0,0,0,,О... бұл...
Dialogue: 0,0:09:24.35,0:09:26.27,Default,,0,0,0,,Секіру кезегі!
Dialogue: 0,0:09:26.35,0:09:30.23,Default,,0,0,0,,Мен Сейширо Нагиді басқалардан жақсы білемін...
Dialogue: 0,0:09:32.40,0:09:33.61,Default,,0,0,0,,Көшіру!
Dialogue: 0,0:09:34.28,0:09:35.40,Default,,0,0,0,,Ннн…
Dialogue: 0,0:09:35.49,0:09:36.86,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:09:36.95,0:09:39.82,Default,,0,0,0,,Ал мөлдір доп алдыңғыға шығады!
Dialogue: 0,0:09:39.91,0:09:41.28,Default,,0,0,0,,Жақсы хамелеон
Dialogue: 0,0:09:42.62,0:09:44.45,Default,,0,0,0,,Итадаки сол жерде
Dialogue: 0,0:09:49.25,0:09:51.21,Default,,0,0,0,,Қарсы қайтару!
Dialogue: 0,0:09:51.29,0:09:53.96,Default,,0,0,0,,Көк рокқа барыңыз!
Dialogue: 0,0:09:55.76,0:09:58.97,Default,,0,0,0,,Көк рокқа барыңыз!
Dialogue: 0,0:09:59.43,0:10:01.22,Default,,0,0,0,,Сіз өте жақсы аман қалдыңыз!
Dialogue: 0,0:10:01.30,0:10:02.68,Default,,0,0,0,,Осы жерден шешіңіз
Dialogue: 0,0:10:03.72,0:10:04.89,Default,,0,0,0,,Қарсы мүмкіндік!
Dialogue: 0,0:10:06.85,0:10:08.60,Default,,0,0,0,,Сандық жағынан аздап тиімсіз
Dialogue: 0,0:10:08.69,0:10:12.32,Default,,0,0,0,,Бірақ шабуыл мен қорғанысты кері қайтаратын есептегіштер олқылықтарды тудырады.
Dialogue: 0,0:10:14.28,0:10:17.78,Default,,0,0,0,,Бұл жағдайда менің «оқудағы» күшім басым.
Dialogue: 0,0:10:18.61,0:10:22.24,Default,,0,0,0,,Енді мақсаттың алдына шығу үшін рефлекстеріңізді қолдансаңыз, жеңіске жетуге болады.
Dialogue: 0,0:10:22.95,0:10:24.95,Default,,0,0,0,,Мақсат! Табыңыз!
Dialogue: 0,0:10:25.45,0:10:28.04,Default,,0,0,0,,Өз голымды соға алатын ұпайлар
Dialogue: 0,0:10:29.96,0:10:31.00,Default,,0,0,0,,Жылқы қасқыр!?
Dialogue: 0,0:10:31.83,0:10:34.25,Default,,0,0,0,,Мына жігіт менің допты көздеп тұр!
Dialogue: 0,0:10:35.17,0:10:37.51,Default,,0,0,0,,Сіз не ойлап отырсыз? Осындай мүмкіндік үшін
Dialogue: 0,0:10:37.59,0:10:43.47,Default,,0,0,0,,Ұтымдылықтың үзіндісі болмаса, сіз 11 санына әуестеніп ойнайсыз.
Dialogue: 0,0:10:44.10,0:10:46.56,Default,,0,0,0,,Бір қарағанда бұл тым мағынасыз болып көрінгендіктен, мені кейінге қалдырды.
Dialogue: 0,0:10:46.64,0:10:49.94,Default,,0,0,0,,Бұл енді жұмыс істемейді, Джокер
Dialogue: 0,0:10:50.02,0:10:51.06,Default,,0,0,0,,Чи…
Dialogue: 0,0:10:51.60,0:10:54.23,Default,,0,0,0,,Сіз оны бір әрекетте жөндедіңіз бе?
Dialogue: 0,0:10:54.32,0:10:56.03,Default,,0,0,0,,Енді Полпо өлген соң, Буггарати әрекетке көшуі керек.
Dialogue: 0,0:10:56.48,0:10:58.99,Default,,0,0,0,,Бұл жігіт мені жақсы бағалады.
Dialogue: 0,0:10:59.07,0:11:00.15,Default,,0,0,0,,Соңғы жолда —
Dialogue: 0,0:11:00.24,0:11:04.49,Default,,0,0,0,,Айзора жалт қарады да, шешуші пастың алдын алады.
Dialogue: 0,0:11:04.99,0:11:06.95,Default,,0,0,0,,Менің маршрутым өлтірілді
Dialogue: 0,0:11:08.00,0:11:08.83,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:08.91,0:11:10.29,Default,,0,0,0,,Тапсырманы ауыстырыңыз!
Dialogue: 0,0:11:10.96,0:11:16.13,Default,,0,0,0,,Киёши жасаған жарықты мен ғана көре алатын қараңғылықты іздеу үшін пайдаланыңыз
Dialogue: 0,0:11:16.59,0:11:21.38,Default,,0,0,0,,Мені ағынға итер, өз қараңғылығым!
Dialogue: 0,0:11:21.47,0:11:23.64,Default,,0,0,0,,Жүр, Көк жартас, қақпаның алдыңғы жағын басып ал!
Dialogue: 0,0:11:23.72,0:11:25.10,Default,,0,0,0,,Бұл келе жатыр! Бұл келе жатыр!
Dialogue: 0,0:11:25.18,0:11:26.85,Default,,0,0,0,,Келе жатқан ескерту!
Dialogue: 0,0:11:26.93,0:11:29.06,Default,,0,0,0,,Көп уақыт өтті! Маған қалдырыңыз!
Dialogue: 0,0:11:30.27,0:11:32.73,Default,,0,0,0,,Әлі жоқ. Бұл жерде жоқ
Dialogue: 0,0:11:32.81,0:11:37.32,Default,,0,0,0,,Мен қазір тырыссам да, менің қозғалысым жау қорғаушысының қорғаныс шегінде болады.
Dialogue: 0,0:11:37.40,0:11:39.65,Default,,0,0,0,,Мақсатқа үш шарт қажет.
Dialogue: 0,0:11:41.78,0:11:45.03,Default,,0,0,0,,Менің қаруым: Тікелей ату арқылы гол соға алатын орын
Dialogue: 0,0:11:48.04,0:11:49.91,Default,,0,0,0,,Жол келетін жерде бір-біріне қосылу
Dialogue: 0,0:11:52.33,0:11:55.46,Default,,0,0,0,,Айзораға сіздің қозғалыстарыңызды оқуға рұқсат бермеңіз.
Dialogue: 0,0:11:58.50,0:12:01.34,Default,,0,0,0,,Осы үш нәрсенің қабаттасатын сәтін ұстаныңыз
Dialogue: 0,0:12:01.42,0:12:02.97,Default,,0,0,0,,Менің көзіммен және миыммен!
Dialogue: 0,0:12:04.97,0:12:06.85,Default,,0,0,0,,Мақсат дерлік осында
Dialogue: 0,0:12:06.93,0:12:09.18,Default,,0,0,0,,Оны табудың жалғыз жолы осы ағында.
Dialogue: 0,0:12:09.27,0:12:10.98,Default,,0,0,0,,Ойынның аясы!
Dialogue: 0,0:12:11.64,0:12:13.27,Default,,0,0,0,,Хан... Мені пайдалан!
Dialogue: 0,0:12:16.02,0:12:19.40,Default,,0,0,0,,Адамдар жеткіліксіз, солай ма? Қарапайым адамдар
Dialogue: 0,0:12:20.03,0:12:22.70,Default,,0,0,0,,Қарға! Керемет уақыт!
Dialogue: 0,0:12:23.36,0:12:24.41,Default,,0,0,0,,Бұл не? Мен байланғанмын.
Dialogue: 0,0:12:27.53,0:12:28.58,Default,,0,0,0,,Көбірек бөліктер!
Dialogue: 0,0:12:30.04,0:12:31.41,Default,,0,0,0,,Міне...
Dialogue: 0,0:12:32.33,0:12:33.37,Default,,0,0,0,,Киёши!
Dialogue: 0,0:12:34.12,0:12:35.83,Default,,0,0,0,,Шар ағынының өзгеруі
Dialogue: 0,0:12:35.92,0:12:37.04,Default,,0,0,0,,Коммутатор...
Dialogue: 0,0:12:37.42,0:12:38.46,Default,,0,0,0,,Міне, уақыты!
Dialogue: 0,0:12:39.50,0:12:42.67,Default,,0,0,0,,Жоқ, өте тітіркендіргіш немере ағасы.
Dialogue: 0,0:12:42.76,0:12:43.76,Default,,0,0,0,,Тек Наги үшін
Dialogue: 0,0:12:43.84,0:12:46.51,Default,,0,0,0,,Қақпа алдында бақыланбайтын лобби пас
Dialogue: 0,0:12:48.05,0:12:50.97,Default,,0,0,0,,Жаудың бұған сақ болудан басқа амалы жоқ.
Dialogue: 0,0:12:51.72,0:12:53.43,Default,,0,0,0,,Мақсат – арқа
Dialogue: 0,0:12:53.93,0:12:55.02,Default,,0,0,0,,Бұл алдау.
Dialogue: 0,0:12:56.23,0:12:57.73,Default,,0,0,0,,Шабуылшы!
Dialogue: 0,0:12:59.02,0:13:01.57,Default,,0,0,0,,Өзіңіз жасаған ой аялдамасына көлеңке қойыңыз
Dialogue: 0,0:13:03.36,0:13:06.82,Default,,0,0,0,,Менің эго туралы ойланыңыз!
Dialogue: 0,0:13:06.91,0:13:08.20,Default,,0,0,0,,Иса Босс
Dialogue: 0,0:13:09.12,0:13:10.91,Default,,0,0,0,,Міне! Ол кетті!
Dialogue: 0,0:13:10.99,0:13:12.50,Default,,0,0,0,,Мен дәл осылай оқыдым!
Dialogue: 0,0:13:13.33,0:13:15.33,Default,,0,0,0,,Айзораның өзі жете алмайтын жерге жүгірді!
Dialogue: 0,0:13:16.42,0:13:18.33,Default,,0,0,0,,Барлық бөлшектер орнында!
Dialogue: 0,0:13:18.42,0:13:19.92,Default,,0,0,0,,Күтпеген жерден...
Dialogue: 0,0:13:20.38,0:13:21.21,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:21.30,0:13:25.51,Default,,0,0,0,,Көк жартастың жүрегі сен бе, 11 саны?
Dialogue: 0,0:13:26.59,0:13:29.09,Default,,0,0,0,,Сіздің миыңыз жақсы, солай емес пе?
Dialogue: 0,0:13:29.97,0:13:31.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:31.39,0:13:34.18,Default,,0,0,0,,Huh!? Сае Итоши?
Dialogue: 0,0:13:34.27,0:13:36.89,Default,,0,0,0,,Менің есептерімде сіз есептемейсіз.
Dialogue: 0,0:13:37.98,0:13:40.31,Default,,0,0,0,,Ол менің көз алдымнан жоғалып кетті...
Dialogue: 0,0:13:40.40,0:13:44.07,Default,,0,0,0,,Мен ең қысқа қашықтықта ең қауіпті нүктені жоюға келдім.
Dialogue: 0,0:13:45.65,0:13:46.70,Default,,0,0,0,,Тоқта
Dialogue: 0,0:13:47.24,0:13:51.53,Default,,0,0,0,,Мен ойлап тапқан ең жақсы пьеса... шарықтау шегі...
Dialogue: 0,0:13:51.95,0:13:53.79,Default,,0,0,0,,Осындай сәтте...
Dialogue: 0,0:13:58.08,0:14:01.67,Default,,0,0,0,,Шабуылшы дегеніміз не?
Dialogue: 0,0:14:01.75,0:14:04.84,Default,,0,0,0,,Соңғы секундқа дейін күресетін адам.
Dialogue: 0,0:14:06.01,0:14:07.05,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:07.51,0:14:08.55,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:14:11.26,0:14:13.26,Default,,0,0,0,,Бұл сәт біткен жоқ!
Dialogue: 0,0:14:15.85,0:14:17.69,Default,,0,0,0,,Барлығы оқылса да—
Dialogue: 0,0:14:17.77,0:14:20.69,Default,,0,0,0,,Мақсат алдындағы осы сәт әлі де қалады
Dialogue: 0,0:14:21.36,0:14:22.40,Default,,0,0,0,,Керемет!
Dialogue: 0,0:14:22.86,0:14:24.73,Default,,0,0,0,,Допқа бірінші тиіп кеткенше...
Dialogue: 0,0:14:25.90,0:14:29.20,Default,,0,0,0,,Аяғыңызды созсаңыз, мақсатқа жетесіз!
Dialogue: 0,0:14:29.74,0:14:32.91,Default,,0,0,0,,Жеткізу! Сіз тіпті саусақтарыңызды пайдалана аласыз!
Dialogue: 0,0:14:35.62,0:14:37.00,Default,,0,0,0,,Сіз сонша жау жинап алатыныңыз шын мәнінде ауыртпалық.
Dialogue: 0,0:14:38.21,0:14:39.71,Default,,0,0,0,,Соңғы қадам!
Dialogue: 0,0:14:40.25,0:14:41.29,Default,,0,0,0,,(Тақылдау дыбысы)
Dialogue: 0,0:14:42.46,0:14:43.84,Default,,0,0,0,,Уф…
Dialogue: 0,0:14:44.75,0:14:47.01,Default,,0,0,0,,Иә? Баланс...
Dialogue: 0,0:14:47.51,0:14:49.47,Default,,0,0,0,,Сіз тым ертесіз №11
Dialogue: 0,0:14:49.97,0:14:53.18,Default,,0,0,0,,Егер ось шайқаса, тікелей түсіру өледі.
Dialogue: 0,0:14:53.26,0:14:54.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:54.85,0:14:57.64,Default,,0,0,0,,Осындай жеңіл-желпі шайқау арқылы бұзылған
Dialogue: 0,0:14:59.27,0:15:00.85,Default,,0,0,0,,Мақсат дәл алдымда тұрса да...
Dialogue: 0,0:15:02.15,0:15:05.32,Default,,0,0,0,,Мына жігіттің алдында менің қаруым...
Dialogue: 0,0:15:05.40,0:15:06.65,Default,,0,0,0,,Киёши!
Dialogue: 0,0:15:07.07,0:15:08.11,Default,,0,0,0,,Маған қара!
Dialogue: 0,0:15:09.49,0:15:10.53,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:11.32,0:15:12.36,Default,,0,0,0,,Рин!
Dialogue: 0,0:15:14.41,0:15:15.74,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:15:15.83,0:15:19.66,Default,,0,0,0,,Менің ең жақсы пьесамды оқып, сеніп, онымен бірге жүгірген...
Dialogue: 0,0:15:20.58,0:15:22.37,Default,,0,0,0,,Тек Itoshisae емес!
Dialogue: 0,0:15:25.42,0:15:27.50,Default,,0,0,0,,Бұзық болыңдар, жақсы достар
Dialogue: 0,0:15:27.59,0:15:28.63,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:28.71,0:15:32.01,Default,,0,0,0,,Сіз бұл деңгейде менен асып түсе алмайсыз деп ойлаймын!
Dialogue: 0,0:15:32.09,0:15:33.22,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:15:35.14,0:15:37.77,Default,,0,0,0,,Жеткізу! Соқ, Рин!
Dialogue: 0,0:15:38.43,0:15:40.10,Default,,0,0,0,,Соңғы қадам...
Dialogue: 0,0:15:41.19,0:15:42.52,Default,,0,0,0,,Сіз!
Dialogue: 0,0:15:50.74,0:15:52.70,Default,,0,0,0,,Не... тақырып...
Dialogue: 0,0:15:52.78,0:15:54.57,Default,,0,0,0,,Неге мұндасың!?
Dialogue: 0,0:15:54.66,0:15:57.53,Default,,0,0,0,,Сол 11 саны ғана жейді емес пе?
Dialogue: 0,0:15:58.83,0:16:01.00,Default,,0,0,0,,Киёшиді жеу
Dialogue: 0,0:16:01.08,0:16:02.96,Default,,0,0,0,,Сіздің жарығыңыз...
Dialogue: 0,0:16:03.37,0:16:06.67,Default,,0,0,0,,Бұл менікі!
Dialogue: 0,0:16:16.97,0:16:18.01,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:18.10,0:16:21.64,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:16:21.73,0:16:24.94,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:25.02,0:16:28.07,Default,,0,0,0,,Теруэй Мару өзінің аса сырғанау соққысымен секіріп кетті.
Dialogue: 0,0:16:28.15,0:16:30.23,Default,,0,0,0,,Уау! №13!
Dialogue: 0,0:16:30.32,0:16:31.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:32.03,0:16:33.82,Default,,0,0,0,,Көк рок галстук!
Dialogue: 0,0:16:33.90,0:16:36.91,Default,,0,0,0,,Жақсы сезінемін! Бұл жақсы сезінеді!
Dialogue: 0,0:16:36.99,0:16:38.41,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:38.99,0:16:40.37,Default,,0,0,0,,Уау...
Dialogue: 0,0:16:40.45,0:16:41.50,Default,,0,0,0,,Жылқы қасқыр!
Dialogue: 0,0:16:41.58,0:16:43.91,Default,,0,0,0,,Иә! Сіз қалай шештіңіз? ток
Dialogue: 0,0:16:44.00,0:16:45.04,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:45.92,0:16:47.42,Default,,0,0,0,,Өте ыстық!
Dialogue: 0,0:16:47.88,0:16:50.25,Default,,0,0,0,,Не істейтініңіз маңызды емес.
Dialogue: 0,0:16:50.34,0:16:53.88,Default,,0,0,0,,Мен сені аңдып, басынан аяғына дейін жалмаймын.
Dialogue: 0,0:16:53.97,0:16:55.63,Default,,0,0,0,,Бұл менің ең жоғары ұсынысым.
Dialogue: 0,0:16:55.72,0:16:58.89,Default,,0,0,0,,Жоқ, бірақ ол өте жақсы жоғалып кетті.
Dialogue: 0,0:16:58.97,0:17:00.51,Default,,0,0,0,,Сіз қалай мақсат қойдыңыз?
Dialogue: 0,0:17:00.60,0:17:02.47,Default,,0,0,0,,Ол жоғалып кеткен болуы керек.
Dialogue: 0,0:17:02.98,0:17:04.85,Default,,0,0,0,,Ол өшірілді.
Dialogue: 0,0:17:05.77,0:17:10.52,Default,,0,0,0,,Менің саған жабысу стиліме сол жігіттер бірден қарсы шықты.
Dialogue: 0,0:17:11.32,0:17:12.36,Default,,0,0,0,,Алғашында неге екенін түсінбесем де, менде жеккөру сезімі пайда болды—
Dialogue: 0,0:17:13.53,0:17:17.49,Default,,0,0,0,,Мен даму барысында сіз жасайтын пьесаны іздеуді шештім.
Dialogue: 0,0:17:17.57,0:17:20.12,Default,,0,0,0,,Иә? Бірақ сіз мұны оқи аласыз ...
Dialogue: 0,0:17:20.20,0:17:24.08,Default,,0,0,0,,Оған сілтеме жасай алатын бір ғана адам бар.
Dialogue: 0,0:17:24.16,0:17:26.25,Default,,0,0,0,,Бұл Рин Итоши.
Dialogue: 0,0:17:26.33,0:17:29.96,Default,,0,0,0,,Ол сіздің эволюцияңызға міндетті түрде жауап береді.
Dialogue: 0,0:17:30.67,0:17:34.42,Default,,0,0,0,,Мен сенен Ринге соңғы жол жүруді қалаймын.
Dialogue: 0,0:17:34.51,0:17:37.38,Default,,0,0,0,,Қараңғыда көздедім
Dialogue: 0,0:17:37.47,0:17:38.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:38.80,0:17:43.27,Default,,0,0,0,,Бірақ сенің маған соншалықты қатты қадалғаныңды қалай елестете аламын?
Dialogue: 0,0:17:43.35,0:17:45.60,Default,,0,0,0,,Риннің қимылдары мен орналасуы
Dialogue: 0,0:17:45.68,0:17:48.02,Default,,0,0,0,,О? Сен не туралы айтып тұрсың? Сен сондай жамансың.
Dialogue: 0,0:17:48.69,0:17:53.19,Default,,0,0,0,,Рин екеуің синхрондалғансыңдар, олар бір жан сияқты.
Dialogue: 0,0:17:53.28,0:17:54.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:55.03,0:17:57.03,Default,,0,0,0,,Жарайды, міне.
Dialogue: 0,0:17:57.11,0:17:58.57,Default,,0,0,0,,Мен үшін...
Dialogue: 0,0:17:58.66,0:18:01.58,Default,,0,0,0,,Рин де таза болуы керек.
Dialogue: 0,0:18:01.66,0:18:03.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:03.29,0:18:05.75,Default,,0,0,0,,Бұл мен ойлағаннан да ақылсыз.
Dialogue: 0,0:18:05.83,0:18:08.71,Default,,0,0,0,,Бұл құмарлықпен жасалған пейзаж ма?
Dialogue: 0,0:18:08.79,0:18:12.50,Default,,0,0,0,,Хан... сен мені түсіне аласың ба?
Dialogue: 0,0:18:13.46,0:18:14.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:14.59,0:18:15.96,Default,,0,0,0,,
Dialogue: 0,0:18:16.05,0:18:18.76,Default,,0,0,0,,Форманы шешіп алған бейшара әрекеті үшін —
Dialogue: 0,0:18:18.84,0:18:19.72,Default,,0,0,0,,Сары карта
Dialogue: 0,0:18:19.80,0:18:21.35,Default,,0,0,0,,-(Мару) Ах... -(Наги) Ах...
Dialogue: 0,0:18:21.43,0:18:24.64,Default,,0,0,0,,А, бұл жерде Маруға сары қағаз берілді.
Dialogue: 0,0:18:24.72,0:18:26.02,Default,,0,0,0,,Ол киімін шешіп жатыр.
Dialogue: 0,0:18:26.10,0:18:28.94,Default,,0,0,0,,Түсінбейтініне сенімдімін, ақымақ.
Dialogue: 0,0:18:29.02,0:18:31.56,Default,,0,0,0,,Киіміңді енді шешпе, Шешуші патша
Dialogue: 0,0:18:32.61,0:18:36.19,Default,,0,0,0,,Шынында да, қазіргі мақсат Марудың табандылығынан туған.
Dialogue: 0,0:18:36.28,0:18:38.99,Default,,0,0,0,,Бұл оның ғана қолынан келетін супер мақсат.
Dialogue: 0,0:18:39.07,0:18:42.03,Default,,0,0,0,,Бірақ бұл жалғыз мақсат емес.
Dialogue: 0,0:18:43.24,0:18:45.29,Default,,0,0,0,,Мен шыққан пьеса
Dialogue: 0,0:18:45.99,0:18:48.46,Default,,0,0,0,,Бұған жауап берген Ринге өтіңіз.
Dialogue: 0,0:18:49.00,0:18:51.58,Default,,0,0,0,,Марудың өкше қозғалысы шоуды ұрлады
Dialogue: 0,0:18:53.29,0:18:55.30,Default,,0,0,0,,Жоқ, қарғалар да...
Dialogue: 0,0:18:55.75,0:18:57.17,Default,,0,0,0,,Наги де солай.
Dialogue: 0,0:18:57.80,0:19:00.43,Default,,0,0,0,,Осы серияға қатысқан барлық адамдар...
Dialogue: 0,0:19:02.05,0:19:04.60,Default,,0,0,0,,Мен өз қиындықтарыма қарсы тұруды жалғастырдым.
Dialogue: 0,0:19:04.97,0:19:06.64,Default,,0,0,0,,Бұл ғашықтықтың тізбегі!
Dialogue: 0,0:19:08.18,0:19:09.73,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:19:09.81,0:19:12.48,Default,,0,0,0,,«Біреудің құмарлығына сену»
Dialogue: 0,0:19:13.56,0:19:18.11,Default,,0,0,0,,Бұл U-20 командасын жеңген соңғы ойын!
Dialogue: 0,0:19:21.11,0:19:22.36,Default,,0,0,0,,Я...
Dialogue: 0,0:19:22.99,0:19:25.37,Default,,0,0,0,,Біз не істеуіміз керек? Мен ұсталдым!
Dialogue: 0,0:19:25.45,0:19:27.20,Default,,0,0,0,,Ойыншыны ауыстыруды қолдану керек пе?
Dialogue: 0,0:19:27.29,0:19:29.91,Default,,0,0,0,,Жеребе болса да қауіпсіз бе?
Dialogue: 0,0:19:30.00,0:19:30.83,Default,,0,0,0,,Көру…
Dialogue: 0,0:19:31.42,0:19:32.96,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:19:33.04,0:19:34.38,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:34.46,0:19:36.55,Default,,0,0,0,,Сәлем, қуыршақ режиссері
Dialogue: 0,0:19:36.63,0:19:38.21,Default,,0,0,0,,Жоспар бар ма?
Dialogue: 0,0:19:38.30,0:19:39.46,Default,,0,0,0,,Әй...
Dialogue: 0,0:19:39.55,0:19:41.22,Default,,0,0,0,,Ең алдымен оны мұқият қорғаңыз
Dialogue: 0,0:19:41.30,0:19:44.68,Default,,0,0,0,,Біздің арнайы есептегішпен соңғы мүмкіндік үшін күресіңіз...
Dialogue: 0,0:19:44.76,0:19:45.89,Default,,0,0,0,,Бұл туралы тіпті шөгінділер де ойлай алады.
Dialogue: 0,0:19:45.97,0:19:48.72,Default,,0,0,0,,Бұл өзіндік ізі жоқ ақымақ жоспар.
Dialogue: 0,0:19:48.81,0:19:49.85,Default,,0,0,0,,Уф…
Dialogue: 0,0:19:49.93,0:19:53.81,Default,,0,0,0,,Кух... Менеджердің шешімі бір ғана ойыншы болды...
Dialogue: 0,0:19:54.90,0:19:57.23,Default,,0,0,0,,Олар әлі де күресе алады
Dialogue: 0,0:19:58.61,0:20:01.53,Default,,0,0,0,,Жай ойыншы ретінде мынаны айтайын...
Dialogue: 0,0:20:01.61,0:20:03.86,Default,,0,0,0,,Өзгерістің суып кетуіне жол бермеңіз.
Dialogue: 0,0:20:03.95,0:20:04.99,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:05.07,0:20:06.33,Default,,0,0,0,,Егер директор—
Dialogue: 0,0:20:06.91,0:20:11.41,Default,,0,0,0,,Осы сәтте ұжымның қызуын сезін.
Dialogue: 0,0:20:12.87,0:20:15.04,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:20:15.13,0:20:16.79,Default,,0,0,0,,Көңіліңізден шықты ма? Сендо
Dialogue: 0,0:20:18.13,0:20:19.50,Default,,0,0,0,,Ха-ха-ха-ха! Бұл дәл сен сияқты, Лабраба.
Dialogue: 0,0:20:19.59,0:20:21.97,Default,,0,0,0,,Ғажайып көк жартас
Dialogue: 0,0:20:22.05,0:20:25.43,Default,,0,0,0,,Боқ... бұл әлі галстук.
Dialogue: 0,0:20:26.55,0:20:30.27,Default,,0,0,0,,А, жау неғұрлым күшті болса, соғұрлым көп...
Dialogue: 0,0:20:30.35,0:20:34.14,Default,,0,0,0,,Эйс шабыттанып, әлемді өзіне қарсы шығарады.
Dialogue: 0,0:20:35.10,0:20:37.90,Default,,0,0,0,,Сіз осы команданың ойыншысысыз.
Dialogue: 0,0:20:37.98,0:20:40.23,Default,,0,0,0,,Сіз әлі де бара аласыз, солай ма? Сендо
Dialogue: 0,0:20:40.32,0:20:42.86,Default,,0,0,0,,О... бұл бұрын.
Dialogue: 0,0:20:45.95,0:20:48.78,Default,,0,0,0,,Мен енді ешкім үшін футбол ойнамаймын
Dialogue: 0,0:20:49.33,0:20:51.91,Default,,0,0,0,,Мен өзім үшін гүлдерді гүлдеймін
Dialogue: 0,0:20:52.41,0:20:54.92,Default,,0,0,0,,Бірде мен осылай ант еткенмін.
Dialogue: 0,0:20:55.00,0:20:56.04,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:20:57.00,0:20:58.54,Default,,0,0,0,,Бір күні, егер—
Dialogue: 0,0:20:58.63,0:21:03.51,Default,,0,0,0,,Нағыз шабуылшы шықса, бұл елде гүлдену үшін күресіп...
Dialogue: 0,0:21:04.26,0:21:06.97,Default,,0,0,0,,Мен сол бүршікке қол созамын
Dialogue: 0,0:21:07.59,0:21:10.14,Default,,0,0,0,,Мен «гүлдеймін» деп айта алатын адам болғым келеді.
Dialogue: 0,0:21:11.47,0:21:12.81,Default,,0,0,0,,Бірақ әлі жоқ
Dialogue: 0,0:21:13.31,0:21:17.65,Default,,0,0,0,,Мен жапон футболының қайта туылуына соңғы кедергімін.
Dialogue: 0,0:21:18.65,0:21:20.19,Default,,0,0,0,,Блум
Dialogue: 0,0:21:20.27,0:21:23.03,Default,,0,0,0,,Көк жартастан асып кетіңіз!
Dialogue: 0,0:21:24.74,0:21:29.99,Default,,0,0,0,,♪~
Dialogue: 0,0:22:48.78,0:22:52.62,Default,,0,0,0,,~♪
Dialogue: 0,0:22:55.20,0:22:57.00,Default,,0,0,0,,Бұл матчтың соңғы кезеңі!
Dialogue: 0,0:22:57.08,0:23:01.75,Default,,0,0,0,,U-20 Жапония құрамасы тағы бір рет орала ала ма?
Dialogue: 0,0:23:01.83,0:23:04.04,Default,,0,0,0,,Ей, жамансың, жарқырай бер.
Dialogue: 0,0:23:04.13,0:23:04.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:05.63,0:23:07.55,Default,,0,0,0,,Динамикалық болыңыз
Dialogue: 0,0:23:07.63,0:23:11.43,Default,,0,0,0,,Мен сені жеп, осы матчтың жұлдызы боламын.
Dialogue: 0,0:23:11.51,0:23:15.26,Default,,0,0,0,,Хан... Байқап көріңіз, көмекші кейіпкер Кинг.
Dialogue: 0,0:23:15.35,0:23:18.23,Default,,0,0,0,,Мен шешемін. Тағы бір нүкте.
Dialogue: 0,0:23:18.31,0:23:19.94,Default,,0,0,0,,Кеттік, кері
Dialogue: 0,0:23:20.02,0:23:22.65,Default,,0,0,0,,Климакс
Dialogue: 0,0:23:23.94,0:23:25.61,Default,,0,0,0,,Бля саған
Dialogue: 0,0:23:26.73,0:23:28.86,Default,,0,0,0,,Бұл осылай аяқталмайды
Dialogue: 0,0:23:29.95,0:23:31.95,Default,,0,0,0,,Мен шешемін
Dialogue: 0,0:23:32.03,0:23:34.12,Default,,0,0,0,,Бұл менің ойыным
Dialogue: 0,0:23:35.20,0:23:36.87,Default,,0,0,0,,Оны жеңіңіз
Dialogue: 0,0:23:37.49,0:23:40.37,Default,,0,0,0,,Менің атымды әлемге ойып ал
Dialogue: 0,0:23:42.75,0:23:43.92,Default,,0,0,0,,Бұл...
Dialogue: 0,0:23:45.13,0:23:46.96,Default,,0,0,0,,Бұл менің оқиғам!
Dialogue: 0,0:23:52.38,0:23:55.39,Default,,0,0,0,,Күтуден шаршадым, ұстаз!
Dialogue: 0,0:23:55.47,0:23:57.97,Default,,0,0,0,,Баробарокюн!
Dialogue: 0,0:23:58.47,0:24:00.39,Default,,0,0,0,,Иә! Жоқ!
Dialogue: 0,0:24:00.48,0:24:01.73,Default,,0,0,0,,Баробаро…
Dialogue: 0,0:24:01.81,0:24:03.02,Default,,0,0,0,,Кюн... Кюн
Dialogue: 0,0:24:03.10,0:24:05.19,Default,,0,0,0,,Иә, бұл дұрыс емес! Ештене етпейді!
Dialogue: 0,0:24:05.27,0:24:06.86,Default,,0,0,0,,Кешіріңіз, менеджер!
Dialogue: 0,0:24:06.94,0:24:09.73,Default,,0,0,0,,Байғұс! «Барбаро Кюн» жақсы емес!
Dialogue: 0,0:24:09.82,0:24:13.24,Default,,0,0,0,,Жарайсың ба? Қызметші ретінде бірінші кезекте тұтынушы келеді.
Dialogue: 0,0:24:13.32,0:24:15.66,Default,,0,0,0,,Ең алдымен, қонақжайлылықпен!
Dialogue: 0,0:24:15.74,0:24:19.49,Default,,0,0,0,,Қашан және қандай тұтынушы келсе де, сол «Барбаро Кюн» болыңыз!
Dialogue: 0,0:24:19.58,0:24:22.00,Default,,0,0,0,,«Кюн» қайталануы! Қайта шығару мүмкіндігі!
Dialogue: 0,0:24:22.08,0:24:23.75,Default,,0,0,0,,Иә, жоқ!
Dialogue: 0,0:24:23.83,0:24:25.63,Default,,0,0,0,,Баробарокюн!
Dialogue: 0,0:24:25.71,0:24:26.96,Default,,0,0,0,,Иә, Моккай!
Dialogue: 0,0:24:27.04,0:24:28.67,Default,,0,0,0,,Баробарокюн!
Dialogue: 0,0:24:28.75,0:24:30.01,Default,,0,0,0,,Махаббатпен!
Dialogue: 0,0:24:30.09,0:24:31.84,Default,,0,0,0,,Баробарокюн!
Dialogue: 0,0:24:31.92,0:24:33.05,Default,,0,0,0,,Қараңызшы, көбірек!
Dialogue: 0,0:24:33.13,0:24:34.22,Default,,0,0,0,,Баробаро…
Dialogue: 0,0:24:34.30,0:24:36.09,Default,,0,0,0,,Мүмкін солай болатын шығар.
Dialogue: 0,0:24:36.18,0:24:38.01,Default,,0,0,0,,Не, не істеп жатырсың?
Dialogue: 0,0:24:38.10,0:24:40.39,Default,,0,0,0,,Мару кафесінің қызметшісінің симуляциясы
Dialogue: 0,0:24:40.47,0:24:43.02,Default,,0,0,0,,Не? Сіз жұмыс істейтін адамсыз ба?
Dialogue: 0,0:24:43.10,0:24:47.36,Default,,0,0,0,,Сонымен қызметші кафе дегеніміз не?
Dialogue: 0,0:24:47.44,0:24:50.98,Default,,0,0,0,,Кәдімгі чатта сөйлескіңіз келе ме, әлде алаңдаушылықтарыңызды тыңдағыңыз келе ме?
Dialogue: 0,0:24:51.07,0:24:53.03,Default,,0,0,0,,Мен мұны істей аламын ба? жылқы қасқырға
Dialogue: 0,0:24:53.11,0:24:55.99,Default,,0,0,0,,Мен өзіме сенімді емеспін...
Dialogue: 0,0:24:56.07,0:24:57.99,Default,,0,0,0,,Жарайды, ұстаз.
Dialogue: 0,0:24:58.07,0:25:01.83,Default,,0,0,0,,Сенімділікке ие болу үшін алдымен өзіңізді бағалауды арттырыңыз.
Dialogue: 0,0:25:01.91,0:25:03.50,Default,,0,0,0,,Өзін-өзі растау?
Dialogue: 0,0:25:03.58,0:25:05.62,Default,,0,0,0,,Ең алдымен күн сайын өзіңізді мақтаңыз
Dialogue: 0,0:25:05.71,0:25:06.96,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:25:07.04,0:25:08.08,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:25:08.17,0:25:09.17,Default,,0,0,0,,Бұл керемет, мен!
Dialogue: 0,0:25:09.25,0:25:11.09,Default,,0,0,0,,Ал ерте ұйықтап, ерте тұр
Dialogue: 0,0:25:11.17,0:25:14.84,Default,,0,0,0,,Сізді бақытты ететін көп нәрсені жасаңыз!
Dialogue: 0,0:25:14.93,0:25:19.01,Default,,0,0,0,,Ал күннің басында және соңында бүкіл өмірге деген сүйіспеншілікпен ...
Dialogue: 0,0:25:19.10,0:25:21.60,Default,,0,0,0,,Баробарокюн!
Dialogue: 0,0:25:21.68,0:25:22.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:25:22.60,0:25:25.52,Default,,0,0,0,,- (Токимицу, Наги, Киёши) Баробарокюн! - (Мару) Иә!
Dialogue: 0,0:25:25.60,0:25:27.85,Default,,0,0,0,,Баробарокюн!
Dialogue: 0,0:25:27.94,0:25:28.90,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:25:28.98,0:25:31.69,Default,,0,0,0,,Баробарокун!
Dialogue: 0,0:25:31.78,0:25:32.61,Default,,0,0,0,,Айт!
Dialogue: 0,0:25:32.69,0:25:35.82,Default,,0,0,0,,Баробарокюн!
Dialogue: 0,0:25:35.90,0:25:37.32,Default,,0,0,0,,О~ Әлем тыныштығы
Dialogue: 0,0:25:37.41,0:25:38.62,Default,,0,0,0,,Иә
Dialogue: 0,0:25:38.70,0:25:40.28,Default,,0,0,0,,- (Мару) Балалар, бір секундқа осында келіңдер - (Киёши/Наги) Хикуп...
Dialogue: 0,0:25:40.37,0:25:41.95,Default,,0,0,0,,Баро және бейбітшілік!
Dialogue: 0,0:25:43.45,0:25:49.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory