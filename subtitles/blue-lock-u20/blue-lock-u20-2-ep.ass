Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.39,0:00:17.43,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:00:17.51,0:00:19.89,Default,,0,0,0,,Берілген топтарды хабарлаймыз.
Dialogue: 0,0:00:21.14,0:00:23.35,Default,,0,0,0,,Мен А тобын таңдадым.
Dialogue: 0,0:00:23.85,0:00:26.86,Default,,0,0,0,,Ал қарсылас В тобы
Dialogue: 0,0:00:27.98,0:00:30.98,Default,,0,0,0,,Сіз кіммен бірігіп, кіммен күресесіз?
Dialogue: 0,0:00:31.48,0:00:33.70,Default,,0,0,0,,Бір ғана сәйкестік
Dialogue: 0,0:00:34.32,0:00:37.12,Default,,0,0,0,,Біз әлі ешкім емеспіз, бірақ біздің соңғы билетіміз...
Dialogue: 0,0:00:37.87,0:00:38.91,Default,,0,0,0,,(JoJo) Бұл әйел… (Holly) Ааах
Dialogue: 0,0:00:41.04,0:00:45.37,Default,,0,0,0,,♪~
Dialogue: 0,0:02:04.91,0:02:10.92,Default,,0,0,0,,~♪
Dialogue: 0,0:02:16.97,0:02:19.68,Default,,0,0,0,,Сәйкестік комбинациялары барлығы 5 сәйкестіктен тұрады.
Dialogue: 0,0:02:20.30,0:02:21.39,Default,,0,0,0,,Әрбір сәйкестік үшін—
Dialogue: 0,0:02:21.47,0:02:24.22,Default,,0,0,0,,6 сағаттық интервалмен
Dialogue: 0,0:02:24.31,0:02:26.64,Default,,0,0,0,,Әділ болу үшін,
Dialogue: 0,0:02:26.72,0:02:28.35,Default,,0,0,0,,Басқа ойындарды көру...
Dialogue: 0,0:02:28.43,0:02:29.77,Default,,0,0,0,,Рұқсат етілмейді
Dialogue: 0,0:02:30.35,0:02:33.48,Default,,0,0,0,,Содан кейін бірінші ойын А мен В
Dialogue: 0,0:02:33.57,0:02:36.90,Default,,0,0,0,,Біріншіден, біз кездейсоқ үш мүшені бір уақытта жариялаймыз.
Dialogue: 0,0:02:36.99,0:02:38.53,Default,,0,0,0,,Команда 1-адам
Dialogue: 0,0:02:39.36,0:02:40.82,Default,,0,0,0,,Нанасе Нидзиро
Dialogue: 0,0:02:40.91,0:02:42.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:42.45,0:02:44.37,Default,,0,0,0,,Содан кейін екінші адам
Dialogue: 0,0:02:45.20,0:02:46.58,Default,,0,0,0,,Мұз тоқушы қойлар
Dialogue: 0,0:02:46.66,0:02:47.95,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:02:48.04,0:02:49.96,Default,,0,0,0,,Ал үшінші адам...
Dialogue: 0,0:02:51.29,0:02:52.79,Default,,0,0,0,,О...
Dialogue: 0,0:02:53.63,0:02:54.92,Default,,0,0,0,,Киёшиичи
Dialogue: 0,0:02:55.00,0:02:56.59,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:02:57.09,0:02:58.97,Default,,0,0,0,,Мен шошып кеттім.
Dialogue: 0,0:02:59.05,0:03:00.93,Default,,0,0,0,,…
Dialogue: 0,0:03:01.01,0:03:04.47,Default,,0,0,0,,Кенет бұл мен! Бұл бірінші ойын ба?
Dialogue: 0,0:03:04.55,0:03:05.76,Default,,0,0,0,,Жалғасы—
Dialogue: 0,0:03:05.85,0:03:08.93,Default,,0,0,0,,Б қарсылас командасының мүшелерін хабарлау.
Dialogue: 0,0:03:09.52,0:03:12.15,Default,,0,0,0,,Бұл кім? Сіз кіммен күресіп жатырсыз?
Dialogue: 0,0:03:12.81,0:03:15.98,Default,,0,0,0,,1-адам: Кёхэй Шигума
Dialogue: 0,0:03:16.07,0:03:18.69,Default,,0,0,0,,2-адам: Рю Сарамадара
Dialogue: 0,0:03:18.78,0:03:21.53,Default,,0,0,0,,Әй, мұнда өте жақсы жігіттер бар.
Dialogue: 0,0:03:21.61,0:03:23.70,Default,,0,0,0,,Голем және жыртқыш
Dialogue: 0,0:03:23.78,0:03:25.87,Default,,0,0,0,,Соңында, үшінші тұлға
Dialogue: 0,0:03:29.20,0:03:30.83,Default,,0,0,0,,Ұсақталған қабылан жылқы (Чигири Хьюма)
Dialogue: 0,0:03:31.75,0:03:33.12,Default,,0,0,0,,Оссу
Dialogue: 0,0:03:33.21,0:03:34.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:34.13,0:03:36.63,Default,,0,0,0,,Оны жолақтарға кесу керек пе? Мұны істеу қиын.
Dialogue: 0,0:03:36.71,0:03:39.51,Default,,0,0,0,,Бір-бірімізді жаңа ғана білгендіктен бе?
Dialogue: 0,0:03:40.63,0:03:44.93,Default,,0,0,0,,Енді екі команда да көкірекшелерін киіп, кіре беріс қақпаға қарай бет алады.
Dialogue: 0,0:03:52.48,0:03:53.98,Default,,0,0,0,,Бұл командада—
Dialogue: 0,0:03:54.06,0:03:57.23,Default,,0,0,0,,Өз өміріңізді насихаттауға көңіл бөліңіз.
Dialogue: 0,0:04:01.57,0:04:03.32,Default,,0,0,0,,Бұл сынақта—
Dialogue: 0,0:04:03.40,0:04:06.28,Default,,0,0,0,,Тіпті әріптестеріңіз де сізге қарсылас болады!
Dialogue: 0,0:04:07.16,0:04:08.66,Default,,0,0,0,,Я...
Dialogue: 0,0:04:08.74,0:04:10.58,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:04:10.66,0:04:11.91,Default,,0,0,0,,Джоваджова?
Dialogue: 0,0:04:12.00,0:04:15.96,Default,,0,0,0,,Мен мұнда жақсы нәтиже көрсетсем, мен U-20 құрамасында боламын.
Dialogue: 0,0:04:16.04,0:04:18.54,Default,,0,0,0,,Ақыры осында келген сияқты.
Dialogue: 0,0:04:18.63,0:04:20.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:20.09,0:04:23.01,Default,,0,0,0,,Ах, кешіріңіз! «Джоважуа» дегеніміз -
Dialogue: 0,0:04:23.09,0:04:26.47,Default,,0,0,0,,Мен тұратын ауданда «докидоки» дегенді білдіреді!
Dialogue: 0,0:04:26.55,0:04:28.68,Default,,0,0,0,,Жеті жұлдыз Ссу Жоғары 1-ші Ссу
Dialogue: 0,0:04:28.76,0:04:32.68,Default,,0,0,0,,Ах, мен Киёшимін. Сізбен танысқаныма қуаныштымын. Мен орта мектептің екінші курс студентімін.
Dialogue: 0,0:04:32.77,0:04:35.44,Default,,0,0,0,,Ал, Киёши-сан менің ағам!
Dialogue: 0,0:04:35.52,0:04:37.90,Default,,0,0,0,,Кеудеңді қарызға алғандай, барымды саламын!
Dialogue: 0,0:04:37.98,0:04:39.52,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:04:39.61,0:04:41.03,Default,,0,0,0,,Мен де орта мектептің екінші курс студентімін.
Dialogue: 0,0:04:41.44,0:04:44.40,Default,,0,0,0,,Менің атым Хьюори.
Dialogue: 0,0:04:44.95,0:04:46.70,Default,,0,0,0,,Мм... Қансай диалектісі!
Dialogue: 0,0:04:46.78,0:04:48.16,Default,,0,0,0,,Иә, Киото адамы
Dialogue: 0,0:04:48.24,0:04:50.24,Default,,0,0,0,,Ах, егер бұл Киото болса, солай.
Dialogue: 0,0:04:50.33,0:04:51.70,Default,,0,0,0,,Жұмсақ!
Dialogue: 0,0:04:53.12,0:04:54.50,Default,,0,0,0,,Бұл «ханнари» емес пе?
Dialogue: 0,0:04:54.58,0:04:57.67,Default,,0,0,0,,Пхуха... Бұл менің басымнан өтті.
Dialogue: 0,0:04:57.75,0:05:00.04,Default,,0,0,0,,Няхахаха! Мен қателік жасадым
Dialogue: 0,0:05:00.13,0:05:01.55,Default,,0,0,0,,Хэхе... қазірдің өзінде
Dialogue: 0,0:05:01.63,0:05:05.05,Default,,0,0,0,,Иә? Не? Бұл бірлік сезімі
Dialogue: 0,0:05:05.13,0:05:07.59,Default,,0,0,0,,Жаңа нәрсе
Dialogue: 0,0:05:07.68,0:05:09.05,Default,,0,0,0,,Құлыптау
Dialogue: 0,0:05:09.14,0:05:10.18,Default,,0,0,0,,Жаман
Dialogue: 0,0:05:10.26,0:05:11.56,Default,,0,0,0,,өлтіру
Dialogue: 0,0:05:11.64,0:05:15.27,Default,,0,0,0,,Бұл барлық уақытта қатыгез болды.
Dialogue: 0,0:05:16.23,0:05:18.23,Default,,0,0,0,,Бұл мүше өзін тыныш сезінеді.
Dialogue: 0,0:05:18.31,0:05:21.57,Default,,0,0,0,,Бұл дұрыс. Үй сияқты сезінеді.
Dialogue: 0,0:05:21.94,0:05:25.61,Default,,0,0,0,,Жарайды, бұдан былай кек сақтама!
Dialogue: 0,0:05:25.70,0:05:27.03,Default,,0,0,0,,Сеяне
Dialogue: 0,0:05:27.11,0:05:30.07,Default,,0,0,0,,Осы бір ойында менің бүкіл өмірім қауіп төніп тұрған сияқты.
Dialogue: 0,0:05:30.45,0:05:33.62,Default,,0,0,0,,Наритебе Жапония өкілі
Dialogue: 0,0:05:33.70,0:05:34.54,Default,,0,0,0,,Иә
Dialogue: 0,0:05:35.87,0:05:37.00,Default,,0,0,0,,Бір-бірімізді ұрайық
Dialogue: 0,0:05:37.08,0:05:39.42,Default,,0,0,0,,Сол екеу ме?
Dialogue: 0,0:05:39.50,0:05:42.17,Default,,0,0,0,,Осы уақытқа дейін жинағанымыз...
Dialogue: 0,0:05:42.75,0:05:43.80,Default,,0,0,0,,Ол әйтеуір бас тарта ма еді?
Dialogue: 0,0:05:48.51,0:05:52.97,Default,,0,0,0,,Ей, міне келдік, кішкентай интерндер.
Dialogue: 0,0:05:53.68,0:05:55.31,Default,,0,0,0,,Сіз кінәсізсіз бе?
Dialogue: 0,0:05:55.39,0:05:57.48,Default,,0,0,0,,Иә? Сіз бір-біріңізді танисыз ба?
Dialogue: 0,0:05:57.56,0:05:59.98,Default,,0,0,0,,Иә, бұрынғы командалас.
Dialogue: 0,0:06:00.06,0:06:01.27,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:06:01.77,0:06:02.61,Default,,0,0,0,,Хмм…
Dialogue: 0,0:06:02.69,0:06:03.52,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:03.61,0:06:06.57,Default,,0,0,0,,Алаңдамаңыз, ол сондай жігіт.
Dialogue: 0,0:06:07.49,0:06:08.53,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:06:10.87,0:06:12.03,Default,,0,0,0,,В тобы
Dialogue: 0,0:06:13.37,0:06:15.87,Default,,0,0,0,,Балалар, мені қорғаңдар.
Dialogue: 0,0:06:16.54,0:06:19.08,Default,,0,0,0,,Шынымды айтсам, бұл шешім.
Dialogue: 0,0:06:20.50,0:06:22.42,Default,,0,0,0,,Бұл «ағынға» байланысты.
Dialogue: 0,0:06:23.59,0:06:24.80,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:06:25.84,0:06:27.76,Default,,0,0,0,,Сынақты жоюдың кілті:
Dialogue: 0,0:06:28.17,0:06:30.89,Default,,0,0,0,,“Assertion” and “coexistence” for the top six
Dialogue: 0,0:06:32.47,0:06:35.26,Default,,0,0,0,,Мен осы бір матчта барымды бере аламын.
Dialogue: 0,0:06:35.35,0:06:37.02,Default,,0,0,0,,абсолютті шартқа айналады
Dialogue: 0,0:06:38.39,0:06:41.60,Default,,0,0,0,,Алдымен 5 ұпай жинап көріңіз, 5 матчқа 5 ұпай
Dialogue: 0,0:06:41.69,0:06:45.73,Default,,0,0,0,,Бірінші ойын: А командасы мен В командасы басталады.
Dialogue: 0,0:06:46.28,0:06:47.82,Default,,0,0,0,,Енді жарылыс келді
Dialogue: 0,0:06:47.90,0:06:49.78,Default,,0,0,0,,Шулы антенна қызғылт
Dialogue: 0,0:06:49.86,0:06:50.70,Default,,0,0,0,,
Dialogue: 0,0:06:50.78,0:06:52.03,Default,,0,0,0,,Үніңді жап, артымнан ер
Dialogue: 0,0:06:56.79,0:06:58.70,Default,,0,0,0,,Сізге бірінші кезекте апелляция қажет
Dialogue: 0,0:06:59.21,0:07:03.46,Default,,0,0,0,,Rin: Starts by “adapting” to Shido’s attack style
Dialogue: 0,0:07:03.54,0:07:05.59,Default,,0,0,0,,Мені тоқтатпаңыз!
Dialogue: 0,0:07:05.67,0:07:07.67,Default,,0,0,0,,Коносамент
Dialogue: 0,0:07:07.76,0:07:08.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:08.97,0:07:10.13,Default,,0,0,0,,Эй, тезірек.
Dialogue: 0,0:07:10.22,0:07:11.34,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:07:11.43,0:07:14.68,Default,,0,0,0,,Speed to react to Shido's forceful dribbling
Dialogue: 0,0:07:15.47,0:07:16.56,Default,,0,0,0,,Күтім жылдам!
Dialogue: 0,0:07:16.64,0:07:18.64,Default,,0,0,0,,As expected of the selection breakthrough team!
Dialogue: 0,0:07:18.72,0:07:21.81,Default,,0,0,0,,If that's the case, I'll be the first to support you!
Dialogue: 0,0:07:21.89,0:07:22.90,Default,,0,0,0,,Шығар, Шидо!
Dialogue: 0,0:07:22.98,0:07:25.61,Default,,0,0,0,,Уа, сен зейінді жаңа студентсің.
Dialogue: 0,0:07:27.65,0:07:30.99,Default,,0,0,0,,Бұл жақсы. Матчқа қалай кіруге болатынын дұрыс түсінбеңіз.
Dialogue: 0,0:07:31.07,0:07:32.95,Default,,0,0,0,,Мен өз көзіммен не істей аламын...
Dialogue: 0,0:07:33.03,0:07:35.16,Default,,0,0,0,,Енді жай ғана білдір!
Dialogue: 0,0:07:35.58,0:07:36.62,Default,,0,0,0,,Кеттік, Рин!
Dialogue: 0,0:07:37.45,0:07:41.29,Default,,0,0,0,,Өз қабілеттеріңізді ашыңыз және мені талап етіңіз!
Dialogue: 0,0:07:43.54,0:07:45.88,Default,,0,0,0,,Рин қалаған қашықтық уақыты
Dialogue: 0,0:07:46.42,0:07:48.21,Default,,0,0,0,,Егер сіз екеуміз бірге өмір сүрсек...
Dialogue: 0,0:07:49.88,0:07:52.22,Default,,0,0,0,,It would be impossible to stop at first sight!
Dialogue: 0,0:07:53.22,0:07:54.93,Default,,0,0,0,,Міне! соңғы сызық
Dialogue: 0,0:07:55.01,0:07:58.31,Default,,0,0,0,,Сізге сыртта соңғы билет!
Dialogue: 0,0:07:58.39,0:07:59.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:59.97,0:08:02.98,Default,,0,0,0,,Ойлары анық, ақымақ!
Dialogue: 0,0:08:03.06,0:08:04.40,Default,,0,0,0,,Ұсақталған!?
Dialogue: 0,0:08:04.48,0:08:06.94,Default,,0,0,0,,After all, they won't let you break through easily.
Dialogue: 0,0:08:07.61,0:08:08.65,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:08:08.73,0:08:10.28,Default,,0,0,0,,«Ағын» кесіндісі
Dialogue: 0,0:08:13.11,0:08:14.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:15.11,0:08:16.16,Default,,0,0,0,,Майбо
Dialogue: 0,0:08:16.70,0:08:19.87,Default,,0,0,0,,Шидо!? Ол дәл қазір өз лагерінде болды.
Dialogue: 0,0:08:20.62,0:08:23.08,Default,,0,0,0,,Бірақ бұл жағдайда...
Dialogue: 0,0:08:23.16,0:08:25.42,Default,,0,0,0,,Менің доп болсам да қоршалған
Dialogue: 0,0:08:25.50,0:08:27.08,Default,,0,0,0,,Сіз бұл жағдайды оқи аласыз!
Dialogue: 0,0:08:27.50,0:08:28.54,Default,,0,0,0,,Болашақ!
Dialogue: 0,0:08:29.13,0:08:31.09,Default,,0,0,0,,Шидоның қимылдарына сілтеме
Dialogue: 0,0:08:31.71,0:08:35.72,Default,,0,0,0,,If you sneak around to Shido who keeps the ball and receive a pass...
Dialogue: 0,0:08:35.80,0:08:37.18,Default,,0,0,0,,Міне!?
Dialogue: 0,0:08:41.18,0:08:42.39,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:43.64,0:08:44.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:45.23,0:08:46.56,Default,,0,0,0,,
Dialogue: 0,0:08:46.65,0:08:48.48,Default,,0,0,0,,Қарау жоқ пақыр!?
Dialogue: 0,0:08:49.32,0:08:52.82,Default,,0,0,0,,Шынымен!? Сіз қандай позициядан шешім қабылдадыңыз?
Dialogue: 0,0:08:53.49,0:08:59.28,Default,,0,0,0,,Менің барлық жасушаларым гол соғу үшін бөлінеді
Dialogue: 0,0:08:59.99,0:09:03.12,Default,,0,0,0,,Бұл мүмкін емес физикалық қабілет...
Dialogue: 0,0:09:03.20,0:09:05.87,Default,,0,0,0,,Ұлттық тәңірді тұншықтырған күш
Dialogue: 0,0:09:05.96,0:09:07.92,Default,,0,0,0,,Жарайсың! Бокобокобоко!
Dialogue: 0,0:09:08.00,0:09:09.29,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:09:09.38,0:09:13.88,Default,,0,0,0,,Бұл №2 Рюсей Шидоның футболы!
Dialogue: 0,0:09:14.51,0:09:17.55,Default,,0,0,0,,His defense and game making are second-rate, but...
Dialogue: 0,0:09:17.64,0:09:21.06,Default,,0,0,0,,Ұпай жинау үшін барын салған дене.
Dialogue: 0,0:09:21.14,0:09:23.52,Default,,0,0,0,,Иә Иә Орнату
Dialogue: 0,0:09:23.60,0:09:26.14,Default,,0,0,0,,Мен оның мәнін түсіндім. Сол антенналар.
Dialogue: 0,0:09:27.14,0:09:30.23,Default,,0,0,0,,Hona Output және Ikoka
Dialogue: 0,0:09:32.40,0:09:33.78,Default,,0,0,0,,
Dialogue: 0,0:09:36.57,0:09:38.78,Default,,0,0,0,,Менің шағымым әлі толық емес.
Dialogue: 0,0:09:38.86,0:09:40.70,Default,,0,0,0,,Маған допты ұрлап, қайталап көру керек.
Dialogue: 0,0:09:41.99,0:09:44.00,Default,,0,0,0,,Сіз билет іздеп жүрсіз бе?
Dialogue: 0,0:09:44.54,0:09:47.33,Default,,0,0,0,,Сіз аласыз! Сіздің денеңіз бен допыңыз бір-бірінен тым алыс!
Dialogue: 0,0:09:49.38,0:09:51.84,Default,,0,0,0,,Қарғыс атқыр... шақырдың ба?
Dialogue: 0,0:09:51.92,0:09:53.34,Default,,0,0,0,,Бұл бір кездері болған оқиға
Dialogue: 0,0:09:53.42,0:09:58.13,Default,,0,0,0,,Sorry, but I'm a believer in only winning games.
Dialogue: 0,0:09:58.22,0:10:00.39,Default,,0,0,0,,Жақсы... дене күші
Dialogue: 0,0:10:00.47,0:10:03.22,Default,,0,0,0,,Aiming at the opponent's weaknesses rather than their strengths
Dialogue: 0,0:10:03.31,0:10:05.93,Default,,0,0,0,,Бұл сіздің ұтыс ставкаңызды арттырады.
Dialogue: 0,0:10:06.02,0:10:10.19,Default,,0,0,0,,That is the obvious golden rule in the world of competition.
Dialogue: 0,0:10:10.86,0:10:14.90,Default,,0,0,0,,Kiyoshiichi, you are the hole in the A team.
Dialogue: 0,0:10:14.98,0:10:15.82,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:16.44,0:10:18.95,Default,,0,0,0,,Айналаңызда ерекше достарыңыз болса...
Dialogue: 0,0:10:19.03,0:10:20.95,Default,,0,0,0,,The level increases due to synergy, but...
Dialogue: 0,0:10:21.03,0:10:23.78,Default,,0,0,0,,Individually, the overall value is mediocre.
Dialogue: 0,0:10:24.20,0:10:27.41,Default,,0,0,0,,Мен сенің орныңнан команданы жойдым.
Dialogue: 0,0:10:27.50,0:10:29.87,Default,,0,0,0,,Сіз қандай қызық туралы айтып отырсыз!
Dialogue: 0,0:10:29.96,0:10:31.00,Default,,0,0,0,,Оны араластырыңыз
Dialogue: 0,0:10:31.08,0:10:33.84,Default,,0,0,0,,Эй, енді тоқтат. Жара жайылып жатыр ма?
Dialogue: 0,0:10:33.92,0:10:36.63,Default,,0,0,0,,Қат! If you put it between two people, you can get it...
Dialogue: 0,0:10:42.09,0:10:43.89,Default,,0,0,0,,Ухё! Супер дәмді!
Dialogue: 0,0:10:44.51,0:10:47.22,Default,,0,0,0,,A maneuver that constantly shifts the center of gravity...
Dialogue: 0,0:10:47.31,0:10:49.56,Default,,0,0,0,,Жеңіл финт техникасы
Dialogue: 0,0:10:49.64,0:10:53.15,Default,,0,0,0,,Бұл №3 Қарасу Табитоның футболы!
Dialogue: 0,0:10:54.82,0:10:56.82,Default,,0,0,0,,
Dialogue: 0,0:11:00.32,0:11:05.33,Default,,0,0,0,,I'm going to mess with your sore spot to a lethal dose, you idiot.
Dialogue: 0,0:11:06.45,0:11:09.16,Default,,0,0,0,,Бұл жігіт ән жазушы!
Dialogue: 0,0:11:11.00,0:11:14.25,Default,,0,0,0,,Каа! Жақсы Қарасу-чан
Dialogue: 0,0:11:15.42,0:11:17.34,Default,,0,0,0,,«Кісі өлтіруші» Қарасу Табито
Dialogue: 0,0:11:17.42,0:11:18.59,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:19.22,0:11:22.55,Default,,0,0,0,,Сіз өзіңіздің өткір аналитикалық қабілеттеріңізбен қарсыласыңыздың әлсіз жақтарын анықтағаннан кейін...
Dialogue: 0,0:11:22.64,0:11:26.18,Default,,0,0,0,,Ойыншыны соңына дейін түбегейлі жойып жіберетін стиль.
Dialogue: 0,0:11:26.97,0:11:29.39,Default,,0,0,0,,Сізді нысанаға алды, Киёши-кун.
Dialogue: 0,0:11:29.48,0:11:32.10,Default,,0,0,0,,Не? Сен көп нәрсені білесің, Хёри.
Dialogue: 0,0:11:32.19,0:11:33.02,Default,,0,0,0,,Иә
Dialogue: 0,0:11:33.56,0:11:34.61,Default,,0,0,0,,Ол жігіт ше...
Dialogue: 0,0:11:35.31,0:11:37.69,Default,,0,0,0,,Қансайдағы сол жастар командасынан
Dialogue: 0,0:11:38.23,0:11:41.45,Default,,0,0,0,,Жақсы, мен сізге бір нәрсе айта аламын.
Dialogue: 0,0:11:41.53,0:11:43.95,Default,,0,0,0,,Өзіңіздің әлсіз тұстарыңыз үшін нысанаға алынудан бас тартыңыз.
Dialogue: 0,0:11:44.03,0:11:47.33,Default,,0,0,0,,Өзіңіздің күшті тұстарыңыз бойынша жарысыңыз.
Dialogue: 0,0:11:48.08,0:11:52.58,Default,,0,0,0,,Бұл матчта осал тұстарыңды жеңе алмайтының рас.
Dialogue: 0,0:11:52.67,0:11:54.04,Default,,0,0,0,,Менің күшті тұсым...
Dialogue: 0,0:11:55.50,0:11:57.13,Default,,0,0,0,,Кеңістіктік сана
Dialogue: 0,0:11:58.00,0:11:59.17,Default,,0,0,0,,Доптан шығу
Dialogue: 0,0:11:59.88,0:12:01.51,Default,,0,0,0,,Тікелей түсіру
Dialogue: 0,0:12:02.93,0:12:05.26,Default,,0,0,0,,Бізде осы үш нәрсе арқылы күресуден басқа амал жоқ
Dialogue: 0,0:12:06.39,0:12:08.14,Default,,0,0,0,,Қазір қызық болып барады.
Dialogue: 0,0:12:08.22,0:12:09.06,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:12:09.14,0:12:10.35,Default,,0,0,0,,Хан!
Dialogue: 0,0:12:10.43,0:12:11.27,Default,,0,0,0,,
Dialogue: 0,0:12:13.81,0:12:17.23,Default,,0,0,0,,Сол үлгімен жүрейік, Киёши-чан!
Dialogue: 0,0:12:17.86,0:12:22.03,Default,,0,0,0,,Сен оны менімен және Риннің рұқсат қағазымен бөліп, өзің шешкің келеді, Шидо!
Dialogue: 0,0:12:22.82,0:12:24.95,Default,,0,0,0,,Қарға келе жатыр!
Dialogue: 0,0:12:25.03,0:12:26.91,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:12:26.99,0:12:29.79,Default,,0,0,0,,Олар Ринге апаратын жолды өшіре отырып, бір-біріне параллель жүреді!
Dialogue: 0,0:12:30.33,0:12:32.96,Default,,0,0,0,,Ондай жағдайда мен күштеп Ринге жол жасайтын едім...
Dialogue: 0,0:12:33.04,0:12:33.87,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:33.96,0:12:35.08,Default,,0,0,0,,Уф…
Dialogue: 0,0:12:35.17,0:12:38.38,Default,,0,0,0,,Жоқ! Егер менің денем осы уақытта бұралып кетсе ...
Dialogue: 0,0:12:38.46,0:12:40.05,Default,,0,0,0,,Сондықтан айтып отырмын.
Dialogue: 0,0:12:40.13,0:12:44.43,Default,,0,0,0,,Жеке жарыстарға келсек, қалағаныңызды жасаңыз.
Dialogue: 0,0:12:44.51,0:12:47.26,Default,,0,0,0,,Міне, содан бері солай болды.
Dialogue: 0,0:12:48.14,0:12:50.10,Default,,0,0,0,,Сіз бен басқа адам арасындағы қашықтықты өлшеу
Dialogue: 0,0:12:50.18,0:12:52.02,Default,,0,0,0,,Қозғалыстың алдын алу
Dialogue: 0,0:12:52.10,0:12:57.06,Default,,0,0,0,,Қарасудың барлық пьесаларының кілті - қашықтықты басқаратын қолмен жұмыс!
Dialogue: 0,0:12:57.15,0:13:00.27,Default,,0,0,0,,Сен мені ұстап тұрсың, Киёшичи.
Dialogue: 0,0:13:01.23,0:13:02.11,Default,,0,0,0,,Мұқаба кіреді!
Dialogue: 0,0:13:02.19,0:13:04.36,Default,,0,0,0,,Қарғаларды 3-тен 1-ге дейін жойыңыз!
Dialogue: 0,0:13:05.32,0:13:06.45,Default,,0,0,0,,бірақ соғыс бишісі Вараби-химе маған берген бұл белдемше
Dialogue: 0,0:13:06.53,0:13:08.41,Default,,0,0,0,,Оны ұсақтап, қайтарып алыңыз!
Dialogue: 0,0:13:08.95,0:13:11.79,Default,,0,0,0,,Қосымша аяқ Аяқ қосу…
Dialogue: 0,0:13:12.24,0:13:13.62,Default,,0,0,0,,Жасырындық
Dialogue: 0,0:13:16.62,0:13:17.92,Default,,0,0,0,,Жоқ, міне!
Dialogue: 0,0:13:19.29,0:13:20.34,Default,,0,0,0,,Рин-кун!
Dialogue: 0,0:13:20.42,0:13:24.47,Default,,0,0,0,,Ха... Мен білмей тұрғанда бұл жігіт артымда...
Dialogue: 0,0:13:26.63,0:13:27.84,Default,,0,0,0,,Бакун
Dialogue: 0,0:13:28.39,0:13:29.22,Default,,0,0,0,,Чи…
Dialogue: 0,0:13:29.80,0:13:31.06,Default,,0,0,0,,Рин артта қалды!?
Dialogue: 0,0:13:31.14,0:13:32.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:33.10,0:13:37.48,Default,,0,0,0,,Қарғаны ұстау күшімен тартып, артына гол соғу.
Dialogue: 0,0:13:37.56,0:13:39.10,Default,,0,0,0,,«Көлеңке шабуылшысы»
Dialogue: 0,0:13:39.98,0:13:45.03,Default,,0,0,0,,«Ниндзя» лақап аты Бұл №4 Отоя футболы
Dialogue: 0,0:13:46.65,0:13:49.53,Default,,0,0,0,,Ал шындап айтсақ, ниндзялардың ұрпақтары
Dialogue: 0,0:13:49.62,0:13:52.28,Default,,0,0,0,,Жоқ! Қызықты сипаттамалар!
Dialogue: 0,0:13:52.79,0:13:54.54,Default,,0,0,0,,1 секунд тым кеш.
Dialogue: 0,0:13:54.62,0:13:57.92,Default,,0,0,0,,Урухи, менің қадамыма қосыл.
Dialogue: 0,0:13:59.42,0:14:02.71,Default,,0,0,0,,Бұл екі төбенің жойқын күші қатал!
Dialogue: 0,0:14:03.25,0:14:06.42,Default,,0,0,0,,Өйткені бұл комбинация оны іріктеудің екінші кезеңіне шығарды.
Dialogue: 0,0:14:06.51,0:14:09.43,Default,,0,0,0,,Менің ойымша, кемелдік деңгейі тіпті Blue Rock-та да жоғары деңгейде.
Dialogue: 0,0:14:10.09,0:14:13.14,Default,,0,0,0,,Хмф... шырышты кішкентай шабақ.
Dialogue: 0,0:14:13.22,0:14:15.10,Default,,0,0,0,,
Dialogue: 0,0:14:15.18,0:14:16.43,Default,,0,0,0,,Кеттік, Рин!
Dialogue: 0,0:14:16.52,0:14:18.14,Default,,0,0,0,,- (Қарға) Байқап көріңіз - (Киёши) Ах!
Dialogue: 0,0:14:19.69,0:14:20.98,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:14:21.06,0:14:23.98,Default,,0,0,0,,Ха... Менің маршрутымда қарға бар...
Dialogue: 0,0:14:24.07,0:14:26.32,Default,,0,0,0,,Оны опциялардан шығарыңыз!?
Dialogue: 0,0:14:27.07,0:14:27.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:27.99,0:14:29.03,Default,,0,0,0,,Маған реттеңіз
Dialogue: 0,0:14:29.11,0:14:30.66,Default,,0,0,0,,Иә, жылжытып көріңіз.
Dialogue: 0,0:14:31.53,0:14:34.37,Default,,0,0,0,,Ха... мен жасаған бір-екі қимыл...
Dialogue: 0,0:14:35.16,0:14:37.04,Default,,0,0,0,,Бір кадрдағы із!?
Dialogue: 0,0:14:37.58,0:14:41.08,Default,,0,0,0,,Hyouori… Passwork Өте дәмді!
Dialogue: 0,0:14:41.92,0:14:45.13,Default,,0,0,0,,Бұзыңыз, данышпан аға.
Dialogue: 0,0:14:46.46,0:14:47.59,Default,,0,0,0,,Кешіктіріңіз
Dialogue: 0,0:14:47.67,0:14:49.68,Default,,0,0,0,,...Тынш! Келіңіз, №1!
Dialogue: 0,0:14:49.76,0:14:53.26,Default,,0,0,0,,Тартыңыз, антенналар! Мен сені тоқтатамын!
Dialogue: 0,0:14:56.85,0:15:02.02,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:15:02.10,0:15:06.86,Default,,0,0,0,,Бұл тегін кофе купондары қанша уақытқа дейін жарамды?
Dialogue: 0,0:15:11.66,0:15:13.32,Default,,0,0,0,,-(Шинкири) Не... -(Шидо) Ой?
Dialogue: 0,0:15:13.41,0:15:14.78,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:15.70,0:15:18.00,Default,,0,0,0,,Шидоның қимылдарын қолдану
Dialogue: 0,0:15:18.08,0:15:20.54,Default,,0,0,0,,Қорғаушы сіздің қозғалысыңызды көре алмайтын сәтке бағыттаңыз.
Dialogue: 0,0:15:21.42,0:15:23.13,Default,,0,0,0,,Соқыр ату!
Dialogue: 0,0:15:25.50,0:15:26.67,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:15:26.75,0:15:31.34,Default,,0,0,0,,Хан... Ол әрине ерекше Рин Итоши
Dialogue: 0,0:15:32.09,0:15:36.89,Default,,0,0,0,,Жоқ, мен оны мүлде ойынға қоспадым.
Dialogue: 0,0:15:36.97,0:15:39.52,Default,,0,0,0,,Жалғыз қалсам, Қарғалар езеді.
Dialogue: 0,0:15:39.60,0:15:43.10,Default,,0,0,0,,Менсіз де Рин Шидо гол соғады.
Dialogue: 0,0:15:43.52,0:15:46.94,Default,,0,0,0,,Осылай жүре берсек, ештеңе істей алмай қаламыз.
Dialogue: 0,0:15:47.61,0:15:49.53,Default,,0,0,0,,Қарға белгісін болдырмау
Dialogue: 0,0:15:49.61,0:15:52.28,Default,,0,0,0,,Олардың шабуылының бір бөлігі болу үшін...
Dialogue: 0,0:15:53.28,0:15:54.41,Default,,0,0,0,,Ннн…
Dialogue: 0,0:15:55.12,0:15:59.50,Default,,0,0,0,,Осы матчқа қатысуымды қалай дәлелдей аламын?
Dialogue: 0,0:16:00.75,0:16:04.75,Default,,0,0,0,,...Киёшидің де солай ойлайтынына сенімдімін.
Dialogue: 0,0:16:04.83,0:16:07.88,Default,,0,0,0,,Негізі, ең жақсы 6 адамнан басқа...
Dialogue: 0,0:16:07.96,0:16:11.55,Default,,0,0,0,,Қазіргі жағдай мынада, ешкім, соның ішінде мен де ештеңені «талап» ете алмайды.
Dialogue: 0,0:16:11.63,0:16:13.09,Default,,0,0,0,,Үздік 6 үшін—
Dialogue: 0,0:16:13.18,0:16:16.72,Default,,0,0,0,,Біз жай ғана ауыстырылатын, елеусіз пешкалармыз.
Dialogue: 0,0:16:16.80,0:16:19.18,Default,,0,0,0,,Сіз өзіңізді «талап қоюға» мәжбүрлегеніңіз үшін—
Dialogue: 0,0:16:19.26,0:16:21.68,Default,,0,0,0,,Жай айналып, алаяқ ретінде пайдаланылады
Dialogue: 0,0:16:22.27,0:16:24.31,Default,,0,0,0,,1 санымен жарыспау
Dialogue: 0,0:16:24.40,0:16:26.65,Default,,0,0,0,,Ой, менің еркіндігім
Dialogue: 0,0:16:26.73,0:16:28.44,Default,,0,0,0,,Онда сен қазір өте аласың, ақымақ.
Dialogue: 0,0:16:28.52,0:16:30.40,Default,,0,0,0,,Менен сұрама
Dialogue: 0,0:16:30.99,0:16:33.86,Default,,0,0,0,,Дәл қазір жағдайға алаңдамаңыз.
Dialogue: 0,0:16:34.41,0:16:36.82,Default,,0,0,0,,Мен не істей алатыныма назар аударыңыз
Dialogue: 0,0:16:37.49,0:16:39.12,Default,,0,0,0,,
Dialogue: 0,0:16:39.83,0:16:41.70,Default,,0,0,0,,2 санын алыңыз
Dialogue: 0,0:16:41.79,0:16:44.16,Default,,0,0,0,,Мен бұл жігіттерге кіруге тырыссам да...
Dialogue: 0,0:16:44.25,0:16:47.42,Default,,0,0,0,,Егер сізде Отояға қарағанда епті қозғалыстар болмаса, сіз рұқсат ала алмайсыз.
Dialogue: 0,0:16:47.96,0:16:49.75,Default,,0,0,0,,Сонда мен қайда тұрамын?
Dialogue: 0,0:16:49.84,0:16:53.34,Default,,0,0,0,,Алаңның ортасында емес, адам көп жиналатын жерде өтуді күту—
Dialogue: 0,0:16:53.97,0:16:55.97,Default,,0,0,0,,Оң жақ!
Dialogue: 0,0:16:59.01,0:17:00.89,Default,,0,0,0,,Менің аяғым ызылдап жатыр...
Dialogue: 0,0:17:00.97,0:17:04.10,Default,,0,0,0,,Ең жоғары жылдамдықпен жүгіру үшін кең кеңістік!
Dialogue: 0,0:17:04.18,0:17:07.56,Default,,0,0,0,,Олардың шабуылдарына сәйкес келудің қажеті жоқ!
Dialogue: 0,0:17:07.65,0:17:08.69,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:09.61,0:17:12.74,Default,,0,0,0,,Менің қаруыммен алаңды жарып жібер!
Dialogue: 0,0:17:12.82,0:17:15.86,Default,,0,0,0,,Мен сені атып тастаймын! жеделдету!
Dialogue: 0,0:17:16.41,0:17:17.70,Default,,0,0,0,,Мен сені итеріп жіберсем де...
Dialogue: 0,0:17:18.16,0:17:20.41,Default,,0,0,0,,Маған қарашы, қарға!
Dialogue: 0,0:17:20.49,0:17:21.95,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:24.58,0:17:27.67,Default,,0,0,0,,Мына аяқтарды қаламайсың ба?
Dialogue: 0,0:17:28.08,0:17:31.46,Default,,0,0,0,,Мм... Жарайды, қызыл.
Dialogue: 0,0:17:31.55,0:17:33.30,Default,,0,0,0,,Мен мүмкіндік аламын!
Dialogue: 0,0:17:33.38,0:17:34.42,Default,,0,0,0,,Қарға?
Dialogue: 0,0:17:35.34,0:17:36.18,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:17:36.26,0:17:37.84,Default,,0,0,0,,Қашып кеткіңіз келе ме? Қызыл шаш
Dialogue: 0,0:17:39.43,0:17:41.56,Default,,0,0,0,,Керемет, ниндзя жігіті.
Dialogue: 0,0:17:43.27,0:17:45.93,Default,,0,0,0,,Бұл қазір жалғыз орын!
Dialogue: 0,0:17:46.73,0:17:48.15,Default,,0,0,0,,Жылдамдық...
Dialogue: 0,0:17:48.98,0:17:49.81,Default,,0,0,0,,Агаруза
Dialogue: 0,0:17:49.90,0:17:52.11,Default,,0,0,0,,
Dialogue: 0,0:17:52.19,0:17:54.11,Default,,0,0,0,,...Тынш!
Dialogue: 0,0:17:56.32,0:17:57.95,Default,,0,0,0,,Ұсақталған…
Dialogue: 0,0:17:58.03,0:18:00.16,Default,,0,0,0,,Олардың шабуылының пішіні...
Dialogue: 0,0:18:00.24,0:18:05.04,Default,,0,0,0,,Маған жаңа нұсқаны көрсетті және менің бар екендігімді мойындады!
Dialogue: 0,0:18:05.12,0:18:06.71,Default,,0,0,0,,Найбо Кунойчи
Dialogue: 0,0:18:06.79,0:18:08.29,Default,,0,0,0,,Бұл ер адам.
Dialogue: 0,0:18:08.37,0:18:10.29,Default,,0,0,0,,Бұл жігітті қолдануға болады.
Dialogue: 0,0:18:10.38,0:18:11.88,Default,,0,0,0,,Ннн…
Dialogue: 0,0:18:11.96,0:18:14.21,Default,,0,0,0,,Бұл «талап» және «бірге өмір сүру»
Dialogue: 0,0:18:14.30,0:18:18.59,Default,,0,0,0,,Бізден басқалардың, ең үздік алтылықтың аман қалуының жалғыз жолы!
Dialogue: 0,0:18:19.80,0:18:20.93,Default,,0,0,0,,
Dialogue: 0,0:18:25.39,0:18:28.64,Default,,0,0,0,,...қарғыс атсын! Мені пайдаланғың да келмейді!
Dialogue: 0,0:18:30.23,0:18:31.52,Default,,0,0,0,,Hyori…
Dialogue: 0,0:18:32.27,0:18:34.86,Default,,0,0,0,,Жалпы жағдайды үнемі тексере отырып—
Dialogue: 0,0:18:34.94,0:18:37.53,Default,,0,0,0,,Ринмен құпия сөзді сабырмен құрастыру
Dialogue: 0,0:18:38.28,0:18:41.91,Default,,0,0,0,,Қолынан келетінін жасау арқылы
Dialogue: 0,0:18:41.99,0:18:44.28,Default,,0,0,0,,Мен ойынға қатысуға тырысамын.
Dialogue: 0,0:18:44.70,0:18:47.08,Default,,0,0,0,,Енді мен не істей аламын?
Dialogue: 0,0:18:47.16,0:18:49.87,Default,,0,0,0,,Тікелей атуға арналған ұпайлар...
Dialogue: 0,0:18:49.96,0:18:52.50,Default,,0,0,0,,Мақсат алдында мүмкіндігіңізді күтіңіз!
Dialogue: 0,0:18:52.58,0:18:54.46,Default,,0,0,0,,Кеттік
Dialogue: 0,0:18:54.55,0:18:55.80,Default,,0,0,0,,Қарға!?
Dialogue: 0,0:18:55.88,0:18:58.34,Default,,0,0,0,,Осы жігіттің соқыр жерін пайдалану үшін допты өшіріңіз
Dialogue: 0,0:18:58.84,0:19:00.34,Default,,0,0,0,,Мен оны көріп тұрмын
Dialogue: 0,0:19:00.43,0:19:02.55,Default,,0,0,0,,Қат! Әзірше емес!
Dialogue: 0,0:19:02.64,0:19:04.30,Default,,0,0,0,,Мақсаттың алдында, дәл сол жерде.
Dialogue: 0,0:19:05.51,0:19:07.43,Default,,0,0,0,,Міне тамаша траектория келеді!
Dialogue: 0,0:19:07.52,0:19:10.14,Default,,0,0,0,,Ха... Жоқ. Ринге тағы бір жолдама!?
Dialogue: 0,0:19:11.48,0:19:13.90,Default,,0,0,0,,Жоқ, бұл менмін.
Dialogue: 0,0:19:13.98,0:19:15.36,Default,,0,0,0,,Ха... тем...
Dialogue: 0,0:19:16.82,0:19:18.57,Default,,0,0,0,,Шидо!?
Dialogue: 0,0:19:18.65,0:19:19.90,Default,,0,0,0,,Не істеп жатырсың!?
Dialogue: 0,0:19:19.99,0:19:22.82,Default,,0,0,0,,Итадаки! Жылдам шабуыл! Отояға қарсы!
Dialogue: 0,0:19:22.91,0:19:24.16,Default,,0,0,0,,Қарға қысқа уақытта
Dialogue: 0,0:19:24.24,0:19:26.87,Default,,0,0,0,,Бұл комбинация қос бұлыңғыр.
Dialogue: 0,0:19:27.70,0:19:29.71,Default,,0,0,0,,Қаптауды маған қалдырыңыз.
Dialogue: 0,0:19:29.79,0:19:31.04,Default,,0,0,0,,
Dialogue: 0,0:19:35.29,0:19:38.01,Default,,0,0,0,,Жоқ, арғы жағында қол жететін жер бар.
Dialogue: 0,0:19:38.09,0:19:39.97,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:40.05,0:19:42.59,Default,,0,0,0,,Олар неліктен соқтығысты?
Dialogue: 0,0:19:43.14,0:19:46.56,Default,,0,0,0,,Рин барлық өрісті оқып, оңтайлы мәнді шығарады.
Dialogue: 0,0:19:46.64,0:19:49.64,Default,,0,0,0,,Өйткені Шидо өзінің сезім мүшелері арқылы жақсыны іздеуде қозғалады.
Dialogue: 0,0:19:49.73,0:19:54.61,Default,,0,0,0,,Жауап бірдей болса да, процестер әртүрлі, сондықтан олар бірге жұмыс істемейді!?
Dialogue: 0,0:19:54.69,0:19:56.23,Default,,0,0,0,,Бұл енді менікі!
Dialogue: 0,0:19:56.32,0:19:57.36,Default,,0,0,0,,Қашқын антенна!
Dialogue: 0,0:19:57.44,0:19:59.19,Default,,0,0,0,,Төменгі кірпіктерді жолға түсіріңіз!
Dialogue: 0,0:19:59.82,0:20:03.78,Default,,0,0,0,,Бұл екі топ ең нашар сәйкестік пе?
Dialogue: 0,0:20:04.57,0:20:06.20,Default,,0,0,0,,Қателіктеріңе көп тоқталудың орнына,
Dialogue: 0,0:20:11.66,0:20:13.17,Default,,0,0,0,,Бұл менікі...
Dialogue: 0,0:20:14.08,0:20:15.96,Default,,0,0,0,,Тіркеуге арналған бөлік!
Dialogue: 0,0:20:22.72,0:20:27.97,Default,,0,0,0,,♪~
Dialogue: 0,0:21:46.76,0:21:50.60,Default,,0,0,0,,~♪
Dialogue: 0,0:21:57.27,0:21:58.90,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:21:58.98,0:22:00.86,Default,,0,0,0,,Сусындар ғана қалды.
Dialogue: 0,0:22:01.52,0:22:03.44,Default,,0,0,0,,Су немесе шай?
Dialogue: 0,0:22:03.53,0:22:07.40,Default,,0,0,0,,Айтпақшы, мен Нанасей мен Хиориге де әкелемін.
Dialogue: 0,0:22:09.61,0:22:10.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:11.20,0:22:12.24,Default,,0,0,0,,Ня
Dialogue: 0,0:22:12.33,0:22:13.45,Default,,0,0,0,,О.
Dialogue: 0,0:22:13.54,0:22:15.66,Default,,0,0,0,,Барлығы бірдей ойлады ма?
Dialogue: 0,0:22:15.75,0:22:16.83,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:22:16.91,0:22:18.46,Default,,0,0,0,,Оны да орындаңыз
Dialogue: 0,0:22:18.54,0:22:21.46,Default,,0,0,0,,Міне, бұл нәзік дүние сызығы!
Dialogue: 0,0:22:23.55,0:22:27.88,Default,,0,0,0,,Бұл тек бір ойынға арналған қарым-қатынас болуы мүмкін, бірақ рахмет.
Dialogue: 0,0:22:28.76,0:22:31.97,Default,,0,0,0,,Ойын дегеніміз не? Ағынмен жүретіндер жеңеді.
Dialogue: 0,0:22:32.05,0:22:33.22,Default,,0,0,0,,Мен серфермін
Dialogue: 0,0:22:33.31,0:22:35.72,Default,,0,0,0,,Мен толқындарды оқу қабілетіммен осы уақытқа дейін келдім.
Dialogue: 0,0:22:35.81,0:22:39.90,Default,,0,0,0,,Ей, сен бірдеңе дедің, Жыртқыш басы.
Dialogue: 0,0:22:40.48,0:22:42.31,Default,,0,0,0,,Бұл голем-кун...
Dialogue: 0,0:22:42.40,0:22:43.44,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:22:43.52,0:22:45.82,Default,,0,0,0,,Күдікті адамдармен сөйлеспеңіз
Dialogue: 0,0:22:45.90,0:22:47.61,Default,,0,0,0,,Әжем осылай үйретті
Dialogue: 0,0:22:47.69,0:22:49.95,Default,,0,0,0,,Жай ғана дөрекі кемпір!
Dialogue: 0,0:22:50.41,0:22:52.03,Default,,0,0,0,,Мен үлкен толқынға айналамын
Dialogue: 0,0:22:52.12,0:22:53.99,Default,,0,0,0,,Бұл жігіттер мүмкін емес шығар.
Dialogue: 0,0:22:54.49,0:22:57.37,Default,,0,0,0,,Қараңдаршы, бұл дүние сызығы сәйкес келмейтін!
Dialogue: 0,0:22:57.45,0:22:59.87,Default,,0,0,0,,Химия «менімен» Оша өтеді—
Dialogue: 0,0:22:59.96,0:23:01.58,Default,,0,0,0,,А командасы Рин Итошимен
Dialogue: 0,0:23:01.67,0:23:04.09,Default,,0,0,0,,Бұл ең сәнді таңдау
Dialogue: 0,0:23:04.17,0:23:05.00,Default,,0,0,0,,Және…
Dialogue: 0,0:23:05.55,0:23:08.26,Default,,0,0,0,,«Менден» басқа екі адам сәнді болса—
Dialogue: 0,0:23:08.34,0:23:09.84,Default,,0,0,0,,Өте сәнді корпус -
Dialogue: 0,0:23:09.93,0:23:13.47,Default,,0,0,0,,«Мен» үндеуі де ең жарқын болады.
Dialogue: 0,0:23:13.55,0:23:16.01,Default,,0,0,0,,Уф... бұл қатысу...
Dialogue: 0,0:23:16.56,0:23:17.64,Default,,0,0,0,,Шинген Танака
Dialogue: 0,0:23:17.72,0:23:19.31,Default,,0,0,0,,Пис, жүр!
Dialogue: 0,0:23:19.39,0:23:21.31,Default,,0,0,0,,Тым дөрекі сәнді емес
Dialogue: 0,0:23:21.40,0:23:23.02,Default,,0,0,0,,Джуничи Ванима
Dialogue: 0,0:23:23.31,0:23:24.52,Default,,0,0,0,,Күтім аяқталды
Dialogue: 0,0:23:24.61,0:23:26.82,Default,,0,0,0,,Эстетикалық сезім сәнді емес
Dialogue: 0,0:23:26.90,0:23:28.44,Default,,0,0,0,,Куриму Игараши
Dialogue: 0,0:23:28.53,0:23:30.20,Default,,0,0,0,,Намузо футболы!
Dialogue: 0,0:23:30.28,0:23:32.91,Default,,0,0,0,,Тірі зат ретінде Оша емес
Dialogue: 0,0:23:33.28,0:23:34.66,Default,,0,0,0,,Құдайды өтінемін
Dialogue: 0,0:23:34.74,0:23:38.41,Default,,0,0,0,,Бірде-бір сәні жоқ үшеумен бір командаға түспеймін деп үміттенемін.
Dialogue: 0,0:23:38.95,0:23:41.29,Default,,0,0,0,,Міне! Бұл үлкен мұрындық
Dialogue: 0,0:23:41.37,0:23:42.87,Default,,0,0,0,,Сонымен... бұл өте үлкен!
Dialogue: 0,0:23:42.96,0:23:46.00,Default,,0,0,0,,Сау! Наму Амитабха Будда Аап
Dialogue: 0,0:23:47.50,0:23:53.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory