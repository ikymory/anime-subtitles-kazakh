Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:17.35,0:00:19.64,Default,,0,0,0,,Цк...осылай әбігер.
Dialogue: 0,0:00:20.93,0:00:24.60,Default,,0,0,0,,Бұл антенна шықты ма?
Dialogue: 0,0:00:27.44,0:00:29.27,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:00:29.90,0:00:33.49,Default,,0,0,0,,Жабайы әрекет жасайсың, кірпігі төмен ағайын.
Dialogue: 0,0:00:33.57,0:00:36.24,Default,,0,0,0,,Бірақ сіздің жарылысыңыз осы жерде аяқталады.
Dialogue: 0,0:00:37.07,0:00:41.20,Default,,0,0,0,,Қайсысы бірінші екенін анықтайық, Рин Чан.
Dialogue: 0,0:00:41.29,0:00:42.20,Default,,0,0,0,,Чуу!
Dialogue: 0,0:00:42.29,0:00:44.91,Default,,0,0,0,,Сәлем! Тоқта, Шидо.
Dialogue: 0,0:00:45.33,0:00:48.08,Default,,0,0,0,,А, бұл дұрыс болды.
Dialogue: 0,0:00:48.46,0:00:52.51,Default,,0,0,0,,Ойыныма түс қосатын иттің рөлін сомдағанын қаладым.
Dialogue: 0,0:00:52.59,0:00:54.63,Default,,0,0,0,,Аққұба зиянкес жігіт
Dialogue: 0,0:00:55.01,0:00:57.05,Default,,0,0,0,,Төмендегідей!
Dialogue: 0,0:00:57.14,0:00:59.60,Default,,0,0,0,,Үлкен аға інісін жақсы көреді
Dialogue: 0,0:01:01.10,0:01:03.39,Default,,0,0,0,,Екінші таймнан Вакацукимен ауыстырылды.
Dialogue: 0,0:01:03.48,0:01:08.02,Default,,0,0,0,,Бұл ойыншы - Рюсей Шидо, бірақ менде ол туралы мәлімет жоқ.
Dialogue: 0,0:01:08.10,0:01:10.48,Default,,0,0,0,,Маған қандай ойын көрсетесіңдер?
Dialogue: 0,0:01:10.90,0:01:12.28,Default,,0,0,0,,Оны асыға күтеміз!
Dialogue: 0,0:01:14.19,0:01:18.16,Default,,0,0,0,,Шидоның шығуымен алаңда жағдай міндетті түрде өзгереді.
Dialogue: 0,0:01:19.16,0:01:23.16,Default,,0,0,0,,Кім бұл өзгерісті ұстап алып, жылдам қозғалса, сол...
Dialogue: 0,0:01:23.24,0:01:24.70,Default,,0,0,0,,Батыр бол
Dialogue: 0,0:01:26.50,0:01:28.79,Default,,0,0,0,,Рефлексия… Ағын…
Dialogue: 0,0:01:29.33,0:01:31.71,Default,,0,0,0,,Менің мақсатымсыз бітпейді
Dialogue: 0,0:01:32.09,0:01:34.84,Default,,0,0,0,,Енді екінші жартысы басталып жатыр!
Dialogue: 0,0:01:35.55,0:01:37.18,Default,,0,0,0,,Бұл сәйкестік...
Dialogue: 0,0:01:37.26,0:01:38.64,Default,,0,0,0,,Бұл менікі!
Dialogue: 0,0:01:40.01,0:01:44.35,Default,,0,0,0,,♪~
Dialogue: 0,0:03:03.97,0:03:09.98,Default,,0,0,0,,~♪
Dialogue: 0,0:03:15.40,0:03:16.44,Default,,0,0,0,,
Dialogue: 0,0:03:21.53,0:03:25.74,Default,,0,0,0,,Шидо-кунның қаруы – оның қақпа алдында гол соға алатын керемет қабілеті.
Dialogue: 0,0:03:25.83,0:03:28.24,Default,,0,0,0,,Оны сіздің көзіңізден шығармаңыз
Dialogue: 0,0:03:30.37,0:03:33.12,Default,,0,0,0,,Матч – допты қақпа алдында қабылдау сәті.
Dialogue: 0,0:03:33.63,0:03:36.54,Default,,0,0,0,,Мен соңғы сызықта аң аулаймын!
Dialogue: 0,0:03:36.63,0:03:38.63,Default,,0,0,0,,Жүрек соғысы! Динамикалық!
Dialogue: 0,0:03:39.67,0:03:41.34,Default,,0,0,0,,Мен жүгіріп жатырмын!
Dialogue: 0,0:03:41.42,0:03:42.55,Default,,0,0,0,,Қашқын ба?
Dialogue: 0,0:03:42.63,0:03:44.64,Default,,0,0,0,,Ха... не? қозғалыс
Dialogue: 0,0:03:44.72,0:03:46.51,Default,,0,0,0,,Жау мен одақтас құрамалар еленбейді.
Dialogue: 0,0:03:46.93,0:03:47.97,Default,,0,0,0,,Хихаха...
Dialogue: 0,0:03:48.06,0:03:49.47,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:03:51.52,0:03:53.27,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:03:53.35,0:03:55.65,Default,,0,0,0,,Тіпті өз командаңызды бұзатын қозғалыс.
Dialogue: 0,0:03:56.44,0:03:58.98,Default,,0,0,0,,Бұл адам үшін 11-ден 11-ге дейін емес...
Dialogue: 0,0:03:59.82,0:04:01.95,Default,,0,0,0,,1-ден 21-ге дейін!
Dialogue: 0,0:04:04.61,0:04:06.03,Default,,0,0,0,,Не... Осы
Dialogue: 0,0:04:06.12,0:04:08.74,Default,,0,0,0,,Мұндай тар жерден өте алмау қалыпты жағдай!
Dialogue: 0,0:04:09.12,0:04:10.45,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:10.91,0:04:12.41,Default,,0,0,0,,Жоқ, ол келеді!
Dialogue: 0,0:04:14.00,0:04:16.17,Default,,0,0,0,,Бұл жылдам және ыңғайлы.
Dialogue: 0,0:04:16.25,0:04:17.09,Default,,0,0,0,,Шидо!
Dialogue: 0,0:04:17.17,0:04:19.80,Default,,0,0,0,,Ха... Сендо!?
Dialogue: 0,0:04:19.88,0:04:22.01,Default,,0,0,0,,Сіз оны білесіз! Кішкентай акула!
Dialogue: 0,0:04:22.09,0:04:23.38,Default,,0,0,0,,Ой!
Dialogue: 0,0:04:23.47,0:04:26.34,Default,,0,0,0,,Мен жай ғана Сай Итоши айтқанын істеп жатырмын!
Dialogue: 0,0:04:26.76,0:04:29.56,Default,,0,0,0,,Ол жігіт бірінші жартыға ұқсамайды.
Dialogue: 0,0:04:29.64,0:04:32.60,Default,,0,0,0,,Бұл Шидоны қолдайтын алдау ма?
Dialogue: 0,0:04:33.02,0:04:36.77,Default,,0,0,0,,Басқаша айтқанда, оның рөлі Киёшиден Ринге ұқсайды?
Dialogue: 0,0:04:37.48,0:04:38.77,Default,,0,0,0,,Қап!
Dialogue: 0,0:04:38.86,0:04:41.90,Default,,0,0,0,,Мұндай комбинацияны күтпеңіз!
Dialogue: 0,0:04:41.99,0:04:44.61,Default,,0,0,0,,Бұл жеңу. Мен айтқанымдай...
Dialogue: 0,0:04:45.20,0:04:46.32,Default,,0,0,0,,Сен тышқанды өзің реттей бер.
Dialogue: 0,0:04:46.41,0:04:48.03,Default,,0,0,0,,Бүйірлік өту осында!?
Dialogue: 0,0:04:48.57,0:04:49.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:50.08,0:04:53.20,Default,,0,0,0,,Жоқ! Айып алаңының алдында...
Dialogue: 0,0:04:53.79,0:04:54.91,Default,,0,0,0,,Сае Итоши!
Dialogue: 0,0:04:57.25,0:04:58.63,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:05:01.88,0:05:03.13,Default,,0,0,0,,Уақыт жоқ!?
Dialogue: 0,0:05:03.21,0:05:05.51,Default,,0,0,0,,Мен оны рефлекспен ұрамын деп ешқашан ойламадым...
Dialogue: 0,0:05:10.31,0:05:11.68,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:05:13.14,0:05:14.93,Default,,0,0,0,,Айналдыру крестімен...
Dialogue: 0,0:05:15.02,0:05:16.77,Default,,0,0,0,,Нақты өту!?
Dialogue: 0,0:05:16.85,0:05:18.81,Default,,0,0,0,,Қарашы, шайтан-күн
Dialogue: 0,0:05:18.90,0:05:20.90,Default,,0,0,0,,Мен жұмыртқаны жақсы көремін~
Dialogue: 0,0:05:21.36,0:05:24.99,Default,,0,0,0,,Енді Шидо қосылды, шабуыл күрт белсендірілді!
Dialogue: 0,0:05:27.49,0:05:28.70,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:05:28.78,0:05:32.74,Default,,0,0,0,,U (төмен)-20 Жапония өкілі оянады!
Dialogue: 0,0:05:32.83,0:05:34.54,Default,,0,0,0,,Жоқ, ол әлі менікі...
Dialogue: 0,0:05:35.37,0:05:37.12,Default,,0,0,0,,Қауіпсіздік аймағы!
Dialogue: 0,0:05:37.21,0:05:38.25,Default,,0,0,0,,Екі бала!?
Dialogue: 0,0:05:38.33,0:05:39.79,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:05:40.50,0:05:41.75,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:41.84,0:05:43.46,Default,,0,0,0,,Футакоға рахмет!
Dialogue: 0,0:05:43.55,0:05:44.59,Default,,0,0,0,,
Dialogue: 0,0:05:45.01,0:05:47.76,Default,,0,0,0,,Ах! Бұл аяққа қауіпті соққы!
Dialogue: 0,0:05:47.84,0:05:51.10,Default,,0,0,0,,«Blue Rock» 11 ойыншысы Казуки Футакоға сары қағаз
Dialogue: 0,0:05:51.18,0:05:53.68,Default,,0,0,0,,Уау, бұл керемет!
Dialogue: 0,0:05:53.77,0:05:56.18,Default,,0,0,0,,Бұл Шидо саны 13 ме?
Dialogue: 0,0:05:56.27,0:05:59.23,Default,,0,0,0,,Бұл Сае Итошимен байланысты.
Dialogue: 0,0:05:59.98,0:06:03.69,Default,,0,0,0,,Көзі байланған Чибисуке! Теми
Dialogue: 0,0:06:04.07,0:06:06.78,Default,,0,0,0,,Сізге басқаным үшін кешіріңіз, Пест мырза.
Dialogue: 0,0:06:07.61,0:06:08.86,Default,,0,0,0,,Иә, өлтір!
Dialogue: 0,0:06:08.95,0:06:10.91,Default,,0,0,0,,Тоқта, ақымақ.
Dialogue: 0,0:06:10.99,0:06:12.03,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:12.49,0:06:15.41,Default,,0,0,0,,Сіз кетіп, өміріңізді құртуды жоспарлап отырсыз ба?
Dialogue: 0,0:06:15.50,0:06:18.16,Default,,0,0,0,,Мақсатпен болмыстың дәлелін көрсетіңіз
Dialogue: 0,0:06:18.25,0:06:21.13,Default,,0,0,0,,Енді менің көңілімді қалдырмаңыз.
Dialogue: 0,0:06:21.21,0:06:24.84,Default,,0,0,0,,Хан… Мейірімділігіңіз үшін рахмет.
Dialogue: 0,0:06:26.76,0:06:28.59,Default,,0,0,0,,Егіздер жақсы жетті
Dialogue: 0,0:06:28.67,0:06:30.09,Default,,0,0,0,,Жақсы қорғаныс
Dialogue: 0,0:06:30.72,0:06:33.64,Default,,0,0,0,,Бірақ оны фол ғана тоқтата алды.
Dialogue: 0,0:06:33.72,0:06:34.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:35.35,0:06:38.64,Default,,0,0,0,,Сае Итошидің қозғалысы және Шидо-кунның доптан тыс жүруі
Dialogue: 0,0:06:38.73,0:06:40.73,Default,,0,0,0,,Екі адамның қимылын түсіну—
Dialogue: 0,0:06:40.81,0:06:43.52,Default,,0,0,0,,Ең қауіпті жерлерді белгіле
Dialogue: 0,0:06:43.61,0:06:46.40,Default,,0,0,0,,Мен оны тамаша көрсем де...
Dialogue: 0,0:06:46.86,0:06:47.99,Default,,0,0,0,,Сіз...
Dialogue: 0,0:06:48.65,0:06:50.99,Default,,0,0,0,,Бірақ Сендо-кун артық болды.
Dialogue: 0,0:06:51.53,0:06:53.87,Default,,0,0,0,,Шидо-кунның қимылдарын толықтыру үшін—
Dialogue: 0,0:06:53.95,0:06:58.16,Default,,0,0,0,,Ол бізге ұнамайтын жерлерді кесіп тастағандықтан, біздің пікіріміз бір сәтке кейінге қалдырылады.
Dialogue: 0,0:06:58.25,0:07:00.33,Default,,0,0,0,,Ол сарыға қосылды.
Dialogue: 0,0:07:01.62,0:07:05.38,Default,,0,0,0,,Сендо-кунның стилі Шидо-кунның енуімен өзгерді
Dialogue: 0,0:07:05.46,0:07:11.13,Default,,0,0,0,,Бұл байсалды, бірақ оның болуы қазір бізге шу.
Dialogue: 0,0:07:11.76,0:07:14.51,Default,,0,0,0,,Мына жігіт соншалықты көре ала ма...
Dialogue: 0,0:07:15.72,0:07:17.06,Default,,0,0,0,,Уф! Керемет...
Dialogue: 0,0:07:17.14,0:07:20.52,Default,,0,0,0,,Амансың ба!? Сіз бұрын ойнаған кезде аяғыңызды ауыртып алдыңыз ...
Dialogue: 0,0:07:20.60,0:07:23.35,Default,,0,0,0,,Мені қалдырыңыз, мен мұны істей аламын.
Dialogue: 0,0:07:23.44,0:07:24.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:24.86,0:07:26.23,Default,,0,0,0,,Мен мұны істегім келеді.
Dialogue: 0,0:07:26.32,0:07:27.82,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:07:28.32,0:07:31.65,Default,,0,0,0,,Шабуылшы ретінде таңдалмағаныма көңілім қалды, бірақ...
Dialogue: 0,0:07:31.74,0:07:36.03,Default,,0,0,0,,Жаңа ғана ойнаған пьесадан өз көзіммен біраз түсіндім.
Dialogue: 0,0:07:37.12,0:07:39.08,Default,,0,0,0,,Алға қарай бұру—
Dialogue: 0,0:07:39.16,0:07:41.25,Default,,0,0,0,,Қорғаушының қызығы
Dialogue: 0,0:07:42.58,0:07:43.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:45.13,0:07:46.42,Default,,0,0,0,,Киёши-кун
Dialogue: 0,0:07:47.75,0:07:52.38,Default,,0,0,0,,Мен сені кездестіргеннен бері өзімді өзгертуден қорықпаймын.
Dialogue: 0,0:07:54.59,0:07:57.26,Default,,0,0,0,,Мен бұл матчта міндетті түрде жеңемін
Dialogue: 0,0:07:58.01,0:07:59.06,Default,,0,0,0,,О!
Dialogue: 0,0:08:01.18,0:08:03.35,Default,,0,0,0,,Жапония!Жапония!
Dialogue: 0,0:08:03.44,0:08:07.06,Default,,0,0,0,,Кел, кел! Айып соққысы Сае-кунды соғады!
Dialogue: 0,0:08:09.78,0:08:12.20,Default,,0,0,0,,Бұл кім? Бұл 13 саны
Dialogue: 0,0:08:12.28,0:08:14.53,Default,,0,0,0,,Сае Итоши міндетті түрде осында болады!
Dialogue: 0,0:08:16.07,0:08:18.91,Default,,0,0,0,,Тоқта, Көк жартас
Dialogue: 0,0:08:21.62,0:08:24.25,Default,,0,0,0,,Мен сені тепкілеймін, Са Чан.
Dialogue: 0,0:08:24.33,0:08:29.25,Default,,0,0,0,,Қиындық танытатын інің сенің тепкің келетін жолға кедергі келтіруде.
Dialogue: 0,0:08:30.71,0:08:32.34,Default,,0,0,0,,Жақын және олар көп.
Dialogue: 0,0:08:33.93,0:08:35.76,Default,,0,0,0,,Сіз де тебу курсындасыз, солай ма?
Dialogue: 0,0:08:35.84,0:08:37.18,Default,,0,0,0,,Сен оны бірнеше күн бұрын ертіп келгенде маған айтсаң ғой.
Dialogue: 0,0:08:37.26,0:08:39.68,Default,,0,0,0,,Бұл мен айып добын орындадым.
Dialogue: 0,0:08:39.76,0:08:41.14,Default,,0,0,0,,Мен оны теуіп жіберемін
Dialogue: 0,0:08:42.73,0:08:44.48,Default,,0,0,0,,Бұл ең жақсы қадам ба?
Dialogue: 0,0:08:44.56,0:08:45.60,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:46.52,0:08:51.07,Default,,0,0,0,,Мен бұл сіз көре алатын жалғыз нұсқа ма деп сұраймын.
Dialogue: 0,0:08:51.48,0:08:52.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:53.44,0:08:58.24,Default,,0,0,0,,Шынайы мүмкін пьесалар және идеалды қалаған пьесалар
Dialogue: 0,0:08:58.91,0:09:02.20,Default,,0,0,0,,Екеуінің қиылысатын ең шетіне бағыттаңыз.
Dialogue: 0,0:09:02.29,0:09:04.00,Default,,0,0,0,,Шабыт алуды тоқтатпаңыз
Dialogue: 0,0:09:05.33,0:09:10.29,Default,,0,0,0,,Осы сәтте ең үлкен мақсатыңызды елестетіңіз.
Dialogue: 0,0:09:11.30,0:09:12.55,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:09:12.92,0:09:15.97,Default,,0,0,0,,Мені қобалжытатын ештеңе айтпа, Са Чан
Dialogue: 0,0:09:16.05,0:09:19.26,Default,,0,0,0,,Жарайды, мен ерекше қимыл ойлап таптым.
Dialogue: 0,0:09:19.80,0:09:23.35,Default,,0,0,0,,Бірақ бұл супер Ultra C, солай ма?
Dialogue: 0,0:09:23.43,0:09:25.14,Default,,0,0,0,,Сіз менің артымнан келе жатырсыз ба?
Dialogue: 0,0:09:25.52,0:09:28.23,Default,,0,0,0,,Хан... сен мені кім деп ойлайсың?
Dialogue: 0,0:09:28.98,0:09:30.73,Default,,0,0,0,,Арман, шайтан
Dialogue: 0,0:09:31.23,0:09:33.73,Default,,0,0,0,,Мен саған сиқырлаймын
Dialogue: 0,0:09:34.36,0:09:37.61,Default,,0,0,0,,Әй, маған Золушка сияқты қарайды ма?
Dialogue: 0,0:09:38.74,0:09:40.20,Default,,0,0,0,,Мен өте қуаныштымын!
Dialogue: 0,0:09:40.28,0:09:41.41,Default,,0,0,0,,
Dialogue: 0,0:09:42.83,0:09:44.25,Default,,0,0,0,,Жылжыды! кел!
Dialogue: 0,0:09:44.91,0:09:46.25,Default,,0,0,0,,Соққы...
Dialogue: 0,0:09:46.33,0:09:47.42,Default,,0,0,0,,Шидо!
Dialogue: 0,0:09:49.21,0:09:50.04,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:50.50,0:09:52.25,Default,,0,0,0,,Өтіңіз де, түз жүріңіз!?
Dialogue: 0,0:09:52.34,0:09:53.96,Default,,0,0,0,,Финтті ату!?
Dialogue: 0,0:09:54.05,0:09:55.09,Default,,0,0,0,,Менің сүйіктім...
Dialogue: 0,0:09:56.63,0:09:58.09,Default,,0,0,0,,Сае Итоши!
Dialogue: 0,0:09:58.88,0:10:00.51,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:10:00.60,0:10:04.22,Default,,0,0,0,,Шатырлар бос болуы мүмкін асуды күтеді!
Dialogue: 0,0:10:04.68,0:10:06.68,Default,,0,0,0,,Сіз жоғары жылдамдықпен жеңіле алмайсыз!
Dialogue: 0,0:10:06.77,0:10:08.69,Default,,0,0,0,,Мен оны тоқтатамын!
Dialogue: 0,0:10:16.86,0:10:17.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:18.07,0:10:20.36,Default,,0,0,0,,Оқыдым, бір-біріңе қосыласыңдар!
Dialogue: 0,0:10:21.20,0:10:23.08,Default,,0,0,0,,Сүңгуір басы тамаша!
Dialogue: 0,0:10:24.95,0:10:26.00,Default,,0,0,0,,Кімге…
Dialogue: 0,0:10:29.08,0:10:30.17,Default,,0,0,0,,Жоқ!?
Dialogue: 0,0:10:30.25,0:10:31.75,Default,,0,0,0,,Бұл өтірік!?
Dialogue: 0,0:10:31.83,0:10:36.51,Default,,0,0,0,,Менің Top Gear жету нүктесінен бірнеше сантиметр алға ұмтылыңыз...
Dialogue: 0,0:10:37.88,0:10:39.97,Default,,0,0,0,,О! Бекітілген!
Dialogue: 0,0:10:42.85,0:10:46.02,Default,,0,0,0,,Тобузды тұтас жасуша…
Dialogue: 0,0:10:47.85,0:10:50.69,Default,,0,0,0,,Dragon Drive!
Dialogue: 0,0:10:50.77,0:10:53.11,Default,,0,0,0,,Ха... жоқ, құбыжық
Dialogue: 0,0:10:53.61,0:10:54.65,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:10:55.32,0:10:56.36,Default,,0,0,0,,Бұл –
Dialogue: 0,0:10:56.44,0:10:59.36,Default,,0,0,0,,Сае Итоши Шидо Рюсей…
Dialogue: 0,0:11:00.78,0:11:02.57,Default,,0,0,0,,
Dialogue: 0,0:11:03.53,0:11:06.12,Default,,0,0,0,,Данышпан мен шайтанның мерекесі!
Dialogue: 0,0:11:06.20,0:11:07.54,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:07.62,0:11:10.00,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:11:10.08,0:11:11.96,Default,,0,0,0,,Уау! Сіз оны көрдіңіз бе?
Dialogue: 0,0:11:12.04,0:11:14.92,Default,,0,0,0,,Бұл не... ғажап!
Dialogue: 0,0:11:15.00,0:11:16.80,Default,,0,0,0,,Керемет! Не!? Бұл?
Dialogue: 0,0:11:16.88,0:11:17.71,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:11:18.21,0:11:21.22,Default,,0,0,0,,Сол сынған зиянкес...
Dialogue: 0,0:11:26.06,0:11:31.31,Default,,0,0,0,,Ой! U-20 №13 Шидо Рюсей…
Dialogue: 0,0:11:31.39,0:11:33.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:33.19,0:11:34.02,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:11:34.11,0:11:37.07,Default,,0,0,0,,Таң қалдыратын гол!
Dialogue: 0,0:11:37.15,0:11:38.98,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:11:40.82,0:11:43.49,Default,,0,0,0,,Екеуің жарасып тұрсыңдар.
Dialogue: 0,0:11:43.99,0:11:46.12,Default,,0,0,0,,Сізге ұнайды! Ми шырыны!
Dialogue: 0,0:11:46.20,0:11:49.33,Default,,0,0,0,,А, мен камминг, мен камминг!
Dialogue: 0,0:11:49.41,0:11:52.96,Default,,0,0,0,,Есеп әлі де байлаулы, мезгілсіз босанған шайтан.
Dialogue: 0,0:11:53.04,0:11:56.42,Default,,0,0,0,,Ууу~ Бұл қазір мүмкін емес.
Dialogue: 0,0:11:56.50,0:12:00.05,Default,,0,0,0,,Бұл Сае Итоши мен Рюусей Шидо арасындағы химиялық реакция.
Dialogue: 0,0:12:01.26,0:12:04.51,Default,,0,0,0,,Менің ойымша, қазіргі жинақ тым қатал.
Dialogue: 0,0:12:05.22,0:12:10.22,Default,,0,0,0,,Шидо бар күшін салып, соққысы келетін жерге дейін барса керек.
Dialogue: 0,0:12:10.81,0:12:13.23,Default,,0,0,0,,Бұны оқығаннан кейін Чигири қиюға барады.
Dialogue: 0,0:12:13.94,0:12:15.35,Default,,0,0,0,,Бірақ Сае Итоши...
Dialogue: 0,0:12:15.86,0:12:17.06,Default,,0,0,0,,Кесу жылдамдығы...
Dialogue: 0,0:12:17.15,0:12:19.73,Default,,0,0,0,,Шидо қалаған ату нүктесі...
Dialogue: 0,0:12:19.82,0:12:22.61,Default,,0,0,0,,Ал доптың жылдамдығы мен сапасы
Dialogue: 0,0:12:23.03,0:12:26.12,Default,,0,0,0,,Барлық осы шарттарды бір сәтте бағалау
Dialogue: 0,0:12:26.20,0:12:28.58,Default,,0,0,0,,Мен иненің көзінен өтіп кеттім!
Dialogue: 0,0:12:29.54,0:12:30.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:31.66,0:12:34.46,Default,,0,0,0,,«Барлық шарттар бірден»
Dialogue: 0,0:12:34.54,0:12:36.75,Default,,0,0,0,,Менің іздегенім осы...
Dialogue: 0,0:12:37.38,0:12:38.92,Default,,0,0,0,,Рефлекстік ойын!?
Dialogue: 0,0:12:39.50,0:12:42.72,Default,,0,0,0,,Ал Шидоның секіру волейкасы...
Dialogue: 0,0:12:43.51,0:12:47.60,Default,,0,0,0,,Ондай нәрсені ми мен денемен рефлексия жасамай соғуға болмайды.
Dialogue: 0,0:12:47.68,0:12:49.56,Default,,0,0,0,,Рефлексия x рефлексия!
Dialogue: 0,0:12:50.18,0:12:54.19,Default,,0,0,0,,Сае Итоши мен Рюусей Шидоның адамнан тыс пьесалары бір-біріне сәйкес келеді
Dialogue: 0,0:12:54.27,0:12:56.15,Default,,0,0,0,,Қазіргі мақсат дүниеге келді!
Dialogue: 0,0:12:56.85,0:13:00.44,Default,,0,0,0,,Көк жартасқа төтеп бере алмаған Шидоның бейнесі
Dialogue: 0,0:13:00.52,0:13:04.11,Default,,0,0,0,,Оны қарап шығыңыз және бір рет жауап алыңыз!
Dialogue: 0,0:13:04.74,0:13:07.03,Default,,0,0,0,,Оның үстіне бұл екеуі үшін...
Dialogue: 0,0:13:07.57,0:13:09.24,Default,,0,0,0,,Бұл бастамасы ғана
Dialogue: 0,0:13:09.33,0:13:12.70,Default,,0,0,0,,Лайк, кірпігің төмен ағайын! Маған ұнады!
Dialogue: 0,0:13:12.79,0:13:14.46,Default,,0,0,0,,Есептік жазбаңызды кейінірек айтыңыз!
Dialogue: 0,0:13:14.54,0:13:17.92,Default,,0,0,0,,О? Егер мен хет-трик жасасам, бұл туралы ойланамын.
Dialogue: 0,0:13:18.00,0:13:20.25,Default,,0,0,0,,Мен бұл туралы айттым ба? уәде бер!
Dialogue: 0,0:13:21.00,0:13:22.38,Default,,0,0,0,,Біз оны тоқтатуымыз керек.
Dialogue: 0,0:13:22.46,0:13:25.80,Default,,0,0,0,,Ол бірден кері қайтарылады және әр сіріңкені жұтып қояды.
Dialogue: 0,0:13:26.30,0:13:28.18,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:13:28.26,0:13:29.35,Default,,0,0,0,,Ұсақталған!
Dialogue: 0,0:13:29.43,0:13:30.64,Default,,0,0,0,,Уууу…
Dialogue: 0,0:13:31.18,0:13:32.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:33.97,0:13:35.56,Default,,0,0,0,,Амансың ба!? Эй
Dialogue: 0,0:13:35.64,0:13:38.56,Default,,0,0,0,,А... Жаңа ғана аяғым қысылып қалды.
Dialogue: 0,0:13:39.36,0:13:43.11,Default,,0,0,0,,Уф... әлі алыс...
Dialogue: 0,0:13:43.57,0:13:44.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:45.40,0:13:46.78,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:13:46.86,0:13:47.70,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:48.45,0:13:50.95,Default,,0,0,0,,Жақын шақыру арқылы сары түске ие болыңыз
Dialogue: 0,0:13:51.03,0:13:53.29,Default,,0,0,0,,Аяқ жарақаты бар орталық қорғаушы және...
Dialogue: 0,0:13:53.87,0:13:58.04,Default,,0,0,0,,Ең көп спринт жасаған жылдам қорғаушының шыдамы таусылады
Dialogue: 0,0:13:58.58,0:14:04.09,Default,,0,0,0,,Ал U-20-ны Сае Итоши мен Рюсей Шидо қайта туды.
Dialogue: 0,0:14:06.09,0:14:08.38,Default,,0,0,0,,Ауыстыру ұяшығын пайдалану уақыты келді.
Dialogue: 0,0:14:09.09,0:14:12.35,Default,,0,0,0,,Жарайды, кімді кіргізгің келеді?
Dialogue: 0,0:14:12.43,0:14:14.56,Default,,0,0,0,,Тепе-теңдік бұзылды.
Dialogue: 0,0:14:14.64,0:14:17.73,Default,,0,0,0,,Бізге ойынды жабатын рөл керек.
Dialogue: 0,0:14:18.44,0:14:20.44,Default,,0,0,0,,Басқаша айтқанда, кесілетін карталар...
Dialogue: 0,0:14:22.23,0:14:23.90,Default,,0,0,0,,Сіздің тізеңіз жақсы ма?
Dialogue: 0,0:14:23.98,0:14:25.32,Default,,0,0,0,,О
Dialogue: 0,0:14:25.40,0:14:28.86,Default,,0,0,0,,Кешіріңіз, екінші жартысы енді ғана басталды.
Dialogue: 0,0:14:29.45,0:14:32.53,Default,,0,0,0,,Жаттығудың осы көлемімен сіздің шыдамыңыз таусылуы мүмкін...
Dialogue: 0,0:14:32.62,0:14:34.37,Default,,0,0,0,,Бұл бос.
Dialogue: 0,0:14:34.91,0:14:38.08,Default,,0,0,0,,«Футболдан бас тарту» сияқты нәрсені айту—
Dialogue: 0,0:14:38.16,0:14:40.08,Default,,0,0,0,,Қашу әрекетінің құны...
Dialogue: 0,0:14:41.71,0:14:44.80,Default,,0,0,0,,Сіз осындай маңызды уақытта келдіңіз.
Dialogue: 0,0:14:45.25,0:14:46.71,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:14:48.47,0:14:52.89,Default,,0,0,0,,Дұрысырақ...
Dialogue: 0,0:14:52.97,0:14:54.93,Default,,0,0,0,,Егер мен жүгіре берсем...
Dialogue: 0,0:14:55.85,0:14:56.89,Default,,0,0,0,,Ұсақталған
Dialogue: 0,0:14:57.73,0:14:59.06,Default,,0,0,0,,Жақсы орындадың.
Dialogue: 0,0:14:59.14,0:15:00.23,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:01.19,0:15:02.23,Default,,0,0,0,,Қап!
Dialogue: 0,0:15:03.40,0:15:07.28,Default,,0,0,0,,Қызық бола бастағанымен...
Dialogue: 0,0:15:08.19,0:15:09.32,Default,,0,0,0,,Ах, дәл осы жерде...
Dialogue: 0,0:15:09.40,0:15:11.99,Default,,0,0,0,,«Көк рок» Он бір ойыншыны ауыстыру
Dialogue: 0,0:15:12.07,0:15:13.16,Default,,0,0,0,,Мен бірден екі бөлікті ауыстырамын.
Dialogue: 0,0:15:13.24,0:15:14.07,Default,,0,0,0,,Иә
Dialogue: 0,0:15:14.16,0:15:18.66,Default,,0,0,0,,Төменгі № 4 Джикири Хьюма және № 3 Казуки Футаго.
Dialogue: 0,0:15:19.20,0:15:24.38,Default,,0,0,0,,№ 14 Рео Микадж және № 16 Йо Хиори енгізіледі.
Dialogue: 0,0:15:30.30,0:15:31.51,Default,,0,0,0,,Жақсы жұмыс Футако
Dialogue: 0,0:15:31.97,0:15:33.22,Default,,0,0,0,,Қалғаны өзіңізге байланысты.
Dialogue: 0,0:15:34.72,0:15:37.22,Default,,0,0,0,,Жақсы жүгірдің, Чигири-кун
Dialogue: 0,0:15:37.85,0:15:39.14,Default,,0,0,0,,Демалу уақыты
Dialogue: 0,0:15:41.77,0:15:43.90,Default,,0,0,0,,Керемет спринт нөмірі 4!
Dialogue: 0,0:15:43.98,0:15:47.11,Default,,0,0,0,,- (Ер адам) Бұл тез болды! -(Тораюки) Хёома Сіз керемет жұмыс жасадыңыз!
Dialogue: 0,0:15:47.19,0:15:51.45,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:15:52.53,0:15:54.82,Default,,0,0,0,,Әй, не? Бұл дұрыс
Dialogue: 0,0:15:56.74,0:16:01.00,Default,,0,0,0,,Сіз бұл өзгеріске шағымданасыз ба? ұсақталған барыс жылқы
Dialogue: 0,0:16:02.04,0:16:03.08,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:03.79,0:16:04.96,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:06.25,0:16:07.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:08.21,0:16:10.05,Default,,0,0,0,,Егер сіз жылағыңыз келсе -
Dialogue: 0,0:16:10.13,0:16:14.39,Default,,0,0,0,,Аяғына дейін жүгіретін денемен далада тұр, ақымақ
Dialogue: 0,0:16:15.55,0:16:17.43,Default,,0,0,0,,Бұл өкініш...
Dialogue: 0,0:16:18.31,0:16:20.18,Default,,0,0,0,,Бұл сіздің ағымдағы орналасқан жеріңіз.
Dialogue: 0,0:16:20.27,0:16:22.77,Default,,0,0,0,,Нннннн… Ннннннн…
Dialogue: 0,0:16:23.77,0:16:25.81,Default,,0,0,0,,Енді екі Көк тасты ауыстырайық.
Dialogue: 0,0:16:26.27,0:16:28.15,Default,,0,0,0,,Сіз позицияңызды өзгертетін сияқтысыз.
Dialogue: 0,0:16:28.23,0:16:29.48,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:16:29.57,0:16:33.28,Default,,0,0,0,,Дәл қазір U-20 Жапония құрамасы ағынды бақылауда.
Dialogue: 0,0:16:33.36,0:16:34.86,Default,,0,0,0,,Екінші тайм 10 минут!
Dialogue: 0,0:16:34.95,0:16:37.83,Default,,0,0,0,,Бұл өзгеріс қалай түзетіледі?
Dialogue: 0,0:16:37.91,0:16:40.16,Default,,0,0,0,,Қалай күресетініңізге назар аударыңыз!
Dialogue: 0,0:16:40.74,0:16:44.33,Default,,0,0,0,,Отоя-кун, сен қорғаушы бола алмайсың.
Dialogue: 0,0:16:44.42,0:16:45.79,Default,,0,0,0,,Uiiiii
Dialogue: 0,0:16:46.88,0:16:48.38,Default,,0,0,0,,Мен қайтып келдім...
Dialogue: 0,0:16:49.55,0:16:52.13,Default,,0,0,0,,Ол тұрған осы жерде
Dialogue: 0,0:16:53.67,0:16:54.72,Default,,0,0,0,,Мүмкін тыныс алу әдістерін тым көп қолданғандықтан шығар…
Dialogue: 0,0:16:56.47,0:16:57.51,Default,,0,0,0,,Мен сені күттім бе?
Dialogue: 0,0:17:05.48,0:17:08.02,Default,,0,0,0,,Жоқ, мүлде келеді деп ойламадым.
Dialogue: 0,0:17:09.36,0:17:10.73,Default,,0,0,0,,Хан…
Dialogue: 0,0:17:11.23,0:17:12.86,Default,,0,0,0,,Мақсатты шешіңіз
Dialogue: 0,0:17:13.36,0:17:15.32,Default,,0,0,0,,Сен ондай емессің ғой?
Dialogue: 0,0:17:15.40,0:17:17.45,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:17:18.12,0:17:20.12,Default,,0,0,0,,Жеңіске жетпесек, бәрі бітті.
Dialogue: 0,0:17:20.87,0:17:24.66,Default,,0,0,0,,Бұл жерде аяқтауға әлі ерте.
Dialogue: 0,0:17:25.12,0:17:27.58,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:17:29.46,0:17:31.04,Default,,0,0,0,,Әлі де байланысты
Dialogue: 0,0:17:31.59,0:17:34.38,Default,,0,0,0,,Келесі ұпай матчты шешеді
Dialogue: 0,0:17:35.63,0:17:36.68,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:17:36.76,0:17:37.59,Default,,0,0,0,,
Dialogue: 0,0:17:39.14,0:17:41.05,Default,,0,0,0,,Шайқастағы бетбұрыс!
Dialogue: 0,0:17:43.47,0:17:47.10,Default,,0,0,0,,Hyori алдыңғы шепке орналастырылған кездегі тактикалық өзгеріс
Dialogue: 0,0:17:47.19,0:17:51.27,Default,,0,0,0,,Бұл мен тәжірибе арқылы жинаған Blue Rock шабуылының нұсқалары.
Dialogue: 0,0:17:52.23,0:17:55.65,Default,,0,0,0,,Осы уақытқа дейін барлығы жүгіріп жүрді, Рин ортасында.
Dialogue: 0,0:17:55.74,0:17:59.24,Default,,0,0,0,,Әр адам өзінің жеке қабілеттерін тоқтаусыз үздіксіз көрсетеді.
Dialogue: 0,0:17:59.32,0:18:00.57,Default,,0,0,0,,«Динамикалық» стиль!
Dialogue: 0,0:18:01.33,0:18:05.20,Default,,0,0,0,,Бірақ Хёридің күшті жақтары - оның байсалды көзқарасы және допқа тиюі.
Dialogue: 0,0:18:06.41,0:18:09.75,Default,,0,0,0,,Алдыңғы қатарда байлық жасайтын «тыныш» техник!
Dialogue: 0,0:18:09.83,0:18:12.46,Default,,0,0,0,,Жіберме, ашық көк бала
Dialogue: 0,0:18:14.34,0:18:17.17,Default,,0,0,0,,Мен татуировкаға мән бермеймін.
Dialogue: 0,0:18:17.26,0:18:19.55,Default,,0,0,0,,Мен ниндзя немесе жылдам емеспін...
Dialogue: 0,0:18:20.18,0:18:21.72,Default,,0,0,0,,Басқа жерде жарысыңыз
Dialogue: 0,0:18:25.56,0:18:29.35,Default,,0,0,0,,Хёриден талап етілетін нәрсе - бір-бірден жалтару емес.
Dialogue: 0,0:18:29.44,0:18:33.48,Default,,0,0,0,,Біздің қозғалыстарымызға шабыт беретін пас!
Dialogue: 0,0:18:34.32,0:18:36.15,Default,,0,0,0,,Тек...
Dialogue: 0,0:18:38.03,0:18:39.36,Default,,0,0,0,,Эгоист болмаңыз
Dialogue: 0,0:18:41.70,0:18:43.37,Default,,0,0,0,,Иә! Сыртта!?
Dialogue: 0,0:18:43.45,0:18:44.37,Default,,0,0,0,,Жабу!
Dialogue: 0,0:18:44.83,0:18:48.21,Default,,0,0,0,,Бұл эротикалық, соншалықты қызусың!
Dialogue: 0,0:18:48.83,0:18:50.92,Default,,0,0,0,,Ол бұрынғыдай тепкілейді.
Dialogue: 0,0:18:51.00,0:18:52.29,Default,,0,0,0,,«Тек» немесе жоқ
Dialogue: 0,0:18:52.38,0:18:53.75,Default,,0,0,0,,Хона, көрсетші.
Dialogue: 0,0:18:53.84,0:18:54.92,Default,,0,0,0,,Сіздің ерекше
Dialogue: 0,0:18:56.76,0:18:59.38,Default,,0,0,0,,Қандай шулы қарға
Dialogue: 0,0:19:00.51,0:19:01.97,Default,,0,0,0,,Жақын қашықтық сезімін беретін қосқышпен
Dialogue: 0,0:19:02.05,0:19:03.10,Default,,0,0,0,,Жаудың жалғандығын пайдаландым!
Dialogue: 0,0:19:03.89,0:19:06.18,Default,,0,0,0,,Бұл тегін жинақталатын сәт
Dialogue: 0,0:19:06.27,0:19:08.56,Default,,0,0,0,,Хёоридің салқын және дәл сол аяғы...
Dialogue: 0,0:19:09.14,0:19:10.19,Default,,0,0,0,,Рефлексия!
Dialogue: 0,0:19:11.90,0:19:13.98,Default,,0,0,0,,Хона Икока
Dialogue: 0,0:19:19.74,0:19:21.99,Default,,0,0,0,,Сае Итоши сияқты өткір қисық траектория!
Dialogue: 0,0:19:22.07,0:19:23.99,Default,,0,0,0,,Мақсат - Рин Итоши!
Dialogue: 0,0:19:24.58,0:19:25.99,Default,,0,0,0,,Ішінде ме...!?
Dialogue: 0,0:19:27.16,0:19:29.00,Default,,0,0,0,,Готцуан Мұз Ори
Dialogue: 0,0:19:29.08,0:19:30.21,Default,,0,0,0,,Стейннен алған жарақаттарым әлі толық жазылмағандықтан—
Dialogue: 0,0:19:30.29,0:19:32.92,Default,,0,0,0,,Мені жеген соң «Тамақ үшін рахмет» деп айт!
Dialogue: 0,0:19:33.00,0:19:35.04,Default,,0,0,0,,Мотивациясыз тұзақ бала!
Dialogue: 0,0:19:35.13,0:19:36.34,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:36.42,0:19:38.63,Default,,0,0,0,,Doberman супер джеммер
Dialogue: 0,0:19:38.71,0:19:41.22,Default,,0,0,0,,Мен Ринді алаяқ ретінде пайдалансам да, жасырын түрде өтіп кеттім.
Dialogue: 0,0:19:41.76,0:19:44.18,Default,,0,0,0,,А, доп жақында келеді.
Dialogue: 0,0:19:44.26,0:19:46.35,Default,,0,0,0,,Жоқ...не істеуім керек?
Dialogue: 0,0:19:46.43,0:19:47.47,Default,,0,0,0,,Торима секіру!
Dialogue: 0,0:19:48.56,0:19:51.52,Default,,0,0,0,,Бұл жалғыз бос жер!
Dialogue: 0,0:19:52.02,0:19:54.56,Default,,0,0,0,,Сіз оны сезе аласыз.
Dialogue: 0,0:19:56.02,0:19:57.23,Default,,0,0,0,,Шабуылшы!
Dialogue: 0,0:19:58.11,0:20:01.61,Default,,0,0,0,,Міне! Мен әрқашан көздеген Риннің құпиясы!
Dialogue: 0,0:20:02.53,0:20:03.57,Default,,0,0,0,,Еш ойланбаңыз
Dialogue: 0,0:20:04.74,0:20:05.78,Default,,0,0,0,,Тікелей Ш…
Dialogue: 0,0:20:05.87,0:20:07.45,Default,,0,0,0,,Құлақ балшық қыз
Dialogue: 0,0:20:07.53,0:20:08.58,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:20:10.83,0:20:13.21,Default,,0,0,0,,Жағаңды киюге келдім.
Dialogue: 0,0:20:13.29,0:20:14.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:14.21,0:20:17.59,Default,,0,0,0,,Айсора! Неге мұндасың!?
Dialogue: 0,0:20:18.30,0:20:20.46,Default,,0,0,0,,Біз жаңа ғана өзгерткен формация және—
Dialogue: 0,0:20:20.55,0:20:23.43,Default,,0,0,0,,Бұл Нагидің импровизацияға арналған құпия рұқсаты!
Dialogue: 0,0:20:24.38,0:20:27.43,Default,,0,0,0,,Мен бірінші болып әрекет етпей тұрып келді.
Dialogue: 0,0:20:28.43,0:20:32.73,Default,,0,0,0,,Бұл жігіт мені бақылап тұрған аумақта менің қабілетім өледі.
Dialogue: 0,0:20:33.19,0:20:34.44,Default,,0,0,0,,Қап!
Dialogue: 0,0:20:34.52,0:20:35.65,Default,,0,0,0,,Қарсы ескерту!
Dialogue: 0,0:20:35.73,0:20:37.23,Default,,0,0,0,,Сәлем, кап!
Dialogue: 0,0:20:37.90,0:20:39.19,Default,,0,0,0,,Өтінемін, данышпан!
Dialogue: 0,0:20:40.53,0:20:43.20,Default,,0,0,0,,Бұл келе жатыр! Шидоға қамқорлық жасаңыз!
Dialogue: 0,0:20:43.74,0:20:45.07,Default,,0,0,0,,Осы жерден тоқтаңыз
Dialogue: 0,0:20:45.78,0:20:47.53,Default,,0,0,0,,Кеттік, Рей патша.
Dialogue: 0,0:20:47.62,0:20:48.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:48.95,0:20:50.74,Default,,0,0,0,,Жарайсың ба? Рей Микадж
Dialogue: 0,0:20:51.75,0:20:54.21,Default,,0,0,0,,Сізді кіргізу үшін бір ғана себеп бар.
Dialogue: 0,0:20:54.67,0:20:57.63,Default,,0,0,0,,Оның рөлі – «Шидоны тоқтату»
Dialogue: 0,0:20:58.21,0:20:59.25,Default,,0,0,0,,Иә
Dialogue: 0,0:20:59.34,0:21:02.17,Default,,0,0,0,,Жаттығу жиынына қорғаушы ретінде де қатыстым.
Dialogue: 0,0:21:02.26,0:21:05.01,Default,,0,0,0,,Жоғарыда айтқанымдай, мен матчты түгел тамашаладым...
Dialogue: 0,0:21:05.97,0:21:08.55,Default,,0,0,0,,Жау қорғаушыларының қабілеті
Dialogue: 0,0:21:10.47,0:21:12.06,Default,,0,0,0,,Шидо және Итоши Сае
Dialogue: 0,0:21:13.10,0:21:16.02,Default,,0,0,0,,Әрқашан өз көзқарасыңызда екі адамның ұстанымын сақтаңыз
Dialogue: 0,0:21:17.06,0:21:18.27,Default,,0,0,0,,Дриблинг
Dialogue: 0,0:21:19.44,0:21:21.07,Default,,0,0,0,,Әлі қозғалмайды
Dialogue: 0,0:21:22.07,0:21:23.40,Default,,0,0,0,,Жарайды, операцияны басынан бастауға тура келеді.
Dialogue: 0,0:21:24.57,0:21:25.78,Default,,0,0,0,,Бір-біріне қосылу…
Dialogue: 0,0:21:26.24,0:21:27.41,Default,,0,0,0,,Келе жатыр!
Dialogue: 0,0:21:36.33,0:21:40.04,Default,,0,0,0,,(жыланның қорқынышты дауысы)
Dialogue: 0,0:21:40.13,0:21:42.25,Default,,0,0,0,,Ха... иә?
Dialogue: 0,0:21:42.96,0:21:44.01,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:44.42,0:21:45.76,Default,,0,0,0,,Менің қимылдарым!?
Dialogue: 0,0:21:46.76,0:21:49.76,Default,,0,0,0,,99% көшіру сәттілігі
Dialogue: 0,0:21:51.22,0:21:54.60,Default,,0,0,0,,Бұл матчтағы менің рөлім.
Dialogue: 0,0:21:56.73,0:21:58.81,Default,,0,0,0,,Хамелеон қорғанысы!
Dialogue: 0,0:21:59.94,0:22:02.61,Default,,0,0,0,,Okay Reio cool~
Dialogue: 0,0:22:04.23,0:22:06.11,Default,,0,0,0,,Осы күшпен...
Dialogue: 0,0:22:07.24,0:22:09.20,Default,,0,0,0,,Kill Shido!
Dialogue: 0,0:22:11.95,0:22:17.21,Default,,0,0,0,,♪~
Dialogue: 0,0:23:35.99,0:23:39.83,Default,,0,0,0,,~♪
Dialogue: 0,0:23:45.59,0:23:46.63,Default,,0,0,0,,Киёши жиі
Dialogue: 0,0:23:46.71,0:23:48.71,Default,,0,0,0,,Сіз футбол көруге келесіз бе?
Dialogue: 0,0:23:48.80,0:23:50.34,Default,,0,0,0,,Жоқ, мүлде емес!
Dialogue: 0,0:23:50.42,0:23:54.30,Default,,0,0,0,,Маған Сейчи ұнайды, бірақ менің ата-анам да футбол туралы ештеңе білмейді.
Dialogue: 0,0:23:54.39,0:23:55.72,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:23:55.80,0:23:59.43,Default,,0,0,0,,Мен де офсайдта жүрмін бе? Мен ережелерді түсінбеймін ...
Dialogue: 0,0:23:59.52,0:24:02.85,Default,,0,0,0,,Бұл рас! Бұл мәңгілік жұмбақ, солай емес пе? Оффсайд.
Dialogue: 0,0:24:02.94,0:24:05.31,Default,,0,0,0,,Дұрыс, хаха...
Dialogue: 0,0:24:05.40,0:24:06.61,Default,,0,0,0,,Бірақ тағы да —
Dialogue: 0,0:24:06.69,0:24:10.07,Default,,0,0,0,,Маваримен дос болғаныңыз үшін рахмет.
Dialogue: 0,0:24:10.15,0:24:11.82,Default,,0,0,0,,Ол қыздың достары көп емес.
Dialogue: 0,0:24:11.90,0:24:16.24,Default,,0,0,0,,Жоқ, жоқ, менің Сейичиім ұқсас.
Dialogue: 0,0:24:16.32,0:24:19.12,Default,,0,0,0,,Сәлем! Сіз қандай баласыз? Сейчи-кун
Dialogue: 0,0:24:19.20,0:24:22.58,Default,,0,0,0,,Хм... Бір сөзбен айтқанда, мен қатты қорқамын.
Dialogue: 0,0:24:22.66,0:24:24.25,Default,,0,0,0,,Иә? Бұл не!
Dialogue: 0,0:24:24.33,0:24:26.13,Default,,0,0,0,,Саябақта ойнау кезінде
Dialogue: 0,0:24:26.21,0:24:28.92,Default,,0,0,0,,Мен кенет басымды ұстап жылай бастадым...
Dialogue: 0,0:24:29.00,0:24:32.42,Default,,0,0,0,,Әлі жаумаған жаңбырды елестетіп, қорқыңыз.
Dialogue: 0,0:24:32.51,0:24:35.68,Default,,0,0,0,,Қалай болғанда да, ол өте ұялшақ және сезімтал...
Dialogue: 0,0:24:35.76,0:24:36.80,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:24:36.89,0:24:39.35,Default,,0,0,0,,Мұны сезіну өте керемет!
Dialogue: 0,0:24:39.43,0:24:41.31,Default,,0,0,0,,Сен данышпансың, Сейчи-кун
Dialogue: 0,0:24:41.39,0:24:43.27,Default,,0,0,0,,Біз мүлдем керісіншеміз.
Dialogue: 0,0:24:43.35,0:24:46.35,Default,,0,0,0,,Күнді қызыл немесе сары түспен салған бала болса...
Dialogue: 0,0:24:46.44,0:24:48.73,Default,,0,0,0,,"Бұл біртүрлі! Күн аппақ."
Dialogue: 0,0:24:48.82,0:24:51.99,Default,,0,0,0,,«Міне, бұл ақ!» Олар бірден ұрысып қалады.
Dialogue: 0,0:24:52.07,0:24:53.70,Default,,0,0,0,,Ал мен жақында мүлдем жалаңаш боламын.
Dialogue: 0,0:24:53.78,0:24:56.99,Default,,0,0,0,,Не!? Біз де мүлдем жалаңаш болдық!
Dialogue: 0,0:24:57.07,0:24:59.62,Default,,0,0,0,,Терімнің үйкелуін және ыңғайсыздық сезінетінін жиі естимін.
Dialogue: 0,0:24:59.70,0:25:01.83,Default,,0,0,0,,Оны шешу қиын болды.
Dialogue: 0,0:25:01.91,0:25:02.95,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:25:03.04,0:25:06.17,Default,,0,0,0,,Ендеше менің ұлдарым жалаңаш дос!
Dialogue: 0,0:25:06.25,0:25:07.08,Default,,0,0,0,,...Дұрыс!
Dialogue: 0,0:25:07.17,0:25:08.25,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:25:08.34,0:25:10.46,Default,,0,0,0,,Бірақ мен футбол болғанына қуаныштымын.
Dialogue: 0,0:25:10.55,0:25:14.30,Default,,0,0,0,,Міне осылай достастым, біз де таныстық.
Dialogue: 0,0:25:14.38,0:25:18.09,Default,,0,0,0,,Иә! Алдағы уақытта да қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:25:18.18,0:25:19.76,Default,,0,0,0,,Сәлем, итата!
Dialogue: 0,0:25:19.85,0:25:22.10,Default,,0,0,0,,Екінші жартысы басталғалы тұр, екеуің!
Dialogue: 0,0:25:22.18,0:25:23.85,Default,,0,0,0,,Мен орныма оралуым керек...
Dialogue: 0,0:25:23.93,0:25:25.60,Default,,0,0,0,,- (Исей) Ах! - (Ю Исэ) А...
Dialogue: 0,0:25:25.69,0:25:28.61,Default,,0,0,0,,I…ta…to…
Dialogue: 0,0:25:28.69,0:25:30.27,Default,,0,0,0,,Да… мен…
Dialogue: 0,0:25:30.36,0:25:31.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:25:31.78,0:25:35.11,Default,,0,0,0,,Жоқ... тамаша комбинация!
Dialogue: 0,0:25:36.61,0:25:42.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory