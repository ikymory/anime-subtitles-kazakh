Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.00,0:00:12.17,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:00:17.55,0:00:18.68,Default,,0,0,0,,Эй!
Dialogue: 0,0:00:18.76,0:00:21.68,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:00:25.94,0:00:31.19,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:41.79,0:00:46.29,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:00:53.76,0:00:55.84,Default,,0,0,0,,Кумир Мики-чан сияқты
Dialogue: 0,0:00:57.39,0:00:59.64,Default,,0,0,0,,Егер сіз стильде сәттілікке жетсеңіз
Dialogue: 0,0:01:00.85,0:01:04.43,Default,,0,0,0,,Мен жаңа мектептемін
Dialogue: 0,0:01:08.90,0:01:11.69,Default,,0,0,0,,Достар көп
Dialogue: 0,0:01:11.78,0:01:13.53,Default,,0,0,0,,Өте көп!
Dialogue: 0,0:01:18.28,0:01:19.32,Default,,0,0,0,,Мұны жасауға болады!
Dialogue: 0,0:01:21.45,0:01:23.45,Default,,0,0,0,,Иә! Дайын!
Dialogue: 0,0:01:28.63,0:01:29.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:30.13,0:01:31.25,Default,,0,0,0,,Салқын.
Dialogue: 0,0:01:31.34,0:01:33.76,Default,,0,0,0,,Кім құлады деп ойласаң
Dialogue: 0,0:01:34.26,0:01:34.88,Default,,0,0,0,,Ах
Dialogue: 0,0:01:34.96,0:01:36.80,Default,,0,0,0,,Сәлем Тайра-сан!
Dialogue: 0,0:01:36.88,0:01:38.01,Default,,0,0,0,,Бұл кішкентай көше ме?
Dialogue: 0,0:01:38.09,0:01:43.22,Default,,0,0,0,,А, бұл... киіммен жүзу жаттығуы...
Dialogue: 0,0:01:43.31,0:01:43.93,Default,,0,0,0,,Хахаха
Dialogue: 0,0:01:44.02,0:01:47.31,Default,,0,0,0,,Мен сені үйге апарамын, жүк көлігіне отырма.
Dialogue: 0,0:01:50.27,0:01:52.57,Default,,0,0,0,,Мен Коджи орта мектепке қабылдау емтиханын тапсырды деп естідім.
Dialogue: 0,0:01:52.65,0:01:54.53,Default,,0,0,0,,Иә, Ваумей академиясы
Dialogue: 0,0:01:54.61,0:01:56.57,Default,,0,0,0,,Бұл жеке мектеп.
Dialogue: 0,0:01:56.65,0:01:58.53,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:01:58.61,0:02:00.37,Default,,0,0,0,,Бұл сіздің анаңыздың оқу орны, солай ма?
Dialogue: 0,0:02:00.45,0:02:01.41,Default,,0,0,0,,Иә
Dialogue: 0,0:02:01.49,0:02:03.95,Default,,0,0,0,,Сондықтан мені қабылдағаныма өте қуаныштымын.
Dialogue: 0,0:02:04.04,0:02:05.45,Default,,0,0,0,,Техникамды қолдансам да кесіп өте алмаймын.
Dialogue: 0,0:02:05.95,0:02:09.25,Default,,0,0,0,,Бір сыныпта 10-нан астам оқушы бар.
Dialogue: 0,0:02:09.33,0:02:11.42,Default,,0,0,0,,Мен оны мүлде елестете алмаймын.
Dialogue: 0,0:02:11.92,0:02:16.09,Default,,0,0,0,,Коджи Футаба бастауыш мектебінде әрқашан жалғыз болды.
Dialogue: 0,0:02:16.59,0:02:18.01,Default,,0,0,0,,Жақсы, онда
Dialogue: 0,0:02:20.01,0:02:20.97,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:27.52,0:02:29.52,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:02:35.53,0:02:37.94,Default,,0,0,0,,(Ханао ызылдаған)
Dialogue: 0,0:02:38.03,0:02:39.86,Default,,0,0,0,,Та... Мен үйдемін.
Dialogue: 0,0:02:39.95,0:02:40.66,Default,,0,0,0,,Ах
Dialogue: 0,0:02:40.74,0:02:43.32,Default,,0,0,0,,Анасы мен әпкесі қайтып келді.
Dialogue: 0,0:02:44.99,0:02:45.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:46.74,0:02:49.21,Default,,0,0,0,,Бұл күдікті қадамдар.
Dialogue: 0,0:02:49.29,0:02:50.92,Default,,0,0,0,,Ханао мен сені көремін!
Dialogue: 0,0:02:53.50,0:02:55.50,Default,,0,0,0,,Мен шынымен де томбоймын (Кодзи) Ахах...
Dialogue: 0,0:02:56.00,0:02:58.46,Default,,0,0,0,,Сіз кімге ұқсайсыз? (Кодзи) Эххехе
Dialogue: 0,0:02:58.55,0:03:02.09,Default,,0,0,0,,Иә, мен әкемнен құттықтау хатын алдым.
Dialogue: 0,0:03:02.18,0:03:02.93,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:03:06.85,0:03:07.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:07.52,0:03:10.56,Default,,0,0,0,,Әке, көрмегеніңді қайдан білесің?
Dialogue: 0,0:03:10.64,0:03:13.90,Default,,0,0,0,,Уау, өткенге оралыңызшы.
Dialogue: 0,0:03:15.36,0:03:16.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:17.15,0:03:17.94,Default,,0,0,0,,Не!
Dialogue: 0,0:03:18.74,0:03:19.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:20.78,0:03:22.32,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:22.41,0:03:24.95,Default,,0,0,0,,Ата-анасы қызын жасырын түсіріп жатыр!
Dialogue: 0,0:03:25.03,0:03:26.66,Default,,0,0,0,,Иә! (Кодзи) А...
Dialogue: 0,0:03:27.24,0:03:29.33,Default,,0,0,0,,Мен енді ешкімге сене алмаймын
Dialogue: 0,0:03:29.41,0:03:30.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:34.04,0:03:35.75,Default,,0,0,0,,Сәлеметсіз бе, әке?
Dialogue: 0,0:03:36.29,0:03:38.71,Default,,0,0,0,,Иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:03:40.42,0:03:41.63,Default,,0,0,0,,Бірақ~
Dialogue: 0,0:03:42.43,0:03:45.14,Default,,0,0,0,,Айтпақшы, мен жай ұйықтап жатқан жоқпын.
Dialogue: 0,0:03:45.22,0:03:45.89,Default,,0,0,0,,Осылайша?
Dialogue: 0,0:03:45.97,0:03:48.39,Default,,0,0,0,,Мен дұрыс оқыдым.
Dialogue: 0,0:03:49.02,0:03:52.94,Default,,0,0,0,,Келесі жолы мен одан да сүйкімді суретке түстім. Маған оны сақтауың керек.
Dialogue: 0,0:03:53.56,0:03:55.90,Default,,0,0,0,,Ммм... Ах.
Dialogue: 0,0:03:56.56,0:03:59.90,Default,,0,0,0,,Менде бір идея бар еді, бірақ... менде әлі жоқ.
Dialogue: 0,0:04:00.49,0:04:03.32,Default,,0,0,0,,Иә, иә... түсіндім.
Dialogue: 0,0:04:03.82,0:04:04.99,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:04:06.24,0:04:07.49,Default,,0,0,0,,Не?
Dialogue: 0,0:04:07.58,0:04:10.87,Default,,0,0,0,,Мен келесі айда үйге бару үшін жұмыста бар күшімді саламын.
Dialogue: 0,0:04:11.50,0:04:13.41,Default,,0,0,0,,Иә! (Кодзи) Ахаха
Dialogue: 0,0:04:13.50,0:04:14.54,Default,,0,0,0,,(Ханаоның күлкісі)
Dialogue: 0,0:04:14.62,0:04:18.13,Default,,0,0,0,,Енді көптен күткен ісіңді орындайық.
Dialogue: 0,0:04:18.71,0:04:19.63,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:21.09,0:04:24.13,Default,,0,0,0,,Менің арманымдағы матрос костюмін кию үшін
Dialogue: 0,0:04:24.22,0:04:26.55,Default,,0,0,0,,Мен Ваккай академиясына тапсырдым!
Dialogue: 0,0:04:28.55,0:04:31.68,Default,,0,0,0,,Емтиханға да, сұхбатқа да қатты қобалжыдым.
Dialogue: 0,0:04:33.60,0:04:36.31,Default,,0,0,0,,Мен де оны кие аламын!
Dialogue: 0,0:04:38.56,0:04:42.24,Default,,0,0,0,,Мен сияқты қызға жараса ма?
Dialogue: 0,0:04:42.78,0:04:44.86,Default,,0,0,0,,Эхехе... эхехехе
Dialogue: 0,0:04:44.95,0:04:46.95,Default,,0,0,0,,Аузыңды жап! Мен оны өлшей алмаймын
Dialogue: 0,0:04:47.03,0:04:49.24,Default,,0,0,0,,А... сіз қалай ойлайсыз?
Dialogue: 0,0:04:49.33,0:04:50.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:50.79,0:04:52.29,Default,,0,0,0,,Коджи Сіз салмақ қостыңыз.
Dialogue: 0,0:04:52.37,0:04:53.45,Default,,0,0,0,,Не!
Dialogue: 0,0:04:53.54,0:04:56.37,Default,,0,0,0,,Мен ұзақ отырдым, оқыдым.
Dialogue: 0,0:04:56.46,0:04:58.50,Default,,0,0,0,,Жоқ, жоқ, сіз міндетті түрде арықтаасыз!
Dialogue: 0,0:04:58.58,0:05:00.96,Default,,0,0,0,,Мен тез киімімді ауыстырып, кетемін~
Dialogue: 0,0:05:01.05,0:05:01.96,Default,,0,0,0,,Кеттік~
Dialogue: 0,0:05:02.05,0:05:04.92,Default,,0,0,0,,Кейінірек өлшеңіз!
Dialogue: 0,0:05:07.01,0:05:10.18,Default,,0,0,0,,Сен үшін анаң жасап берген ғой.
Dialogue: 0,0:05:10.26,0:05:12.18,Default,,0,0,0,,Мен бұза алмаймын
Dialogue: 0,0:05:12.27,0:05:15.73,Default,,0,0,0,,Әпке, ұйықтап жатса да матрос киімін айта берді.
Dialogue: 0,0:05:15.81,0:05:16.48,Default,,0,0,0,,Ханао!
Dialogue: 0,0:05:16.56,0:05:18.19,Default,,0,0,0,,Шудың болғаны сонша, ұйықтай алмадым.
Dialogue: 0,0:05:18.27,0:05:19.61,Default,,0,0,0,,Ух...хехехе
Dialogue: 0,0:05:20.40,0:05:23.32,Default,,0,0,0,,Матрос костюмі - Коджидің арманы.
Dialogue: 0,0:05:24.49,0:05:25.36,Default,,0,0,0,,Иә
Dialogue: 0,0:05:25.45,0:05:28.11,Default,,0,0,0,,Онда мен де бар күшімді салуым керек.
Dialogue: 0,0:05:28.91,0:05:32.66,Default,,0,0,0,,Сіздің анаңыз болған кезде Вабай академиясында қандай балалар болды?
Dialogue: 0,0:05:32.74,0:05:34.79,Default,,0,0,0,,Қызықты балалар көп болды.
Dialogue: 0,0:05:34.87,0:05:38.25,Default,,0,0,0,,Сонымен қатар, көптеген бай және сыныпты балалар болды.
Dialogue: 0,0:05:38.33,0:05:42.17,Default,,0,0,0,,Маған мүлдем қарама-қайшы! Біз дұрыс сөйлесе аламыз ба?
Dialogue: 0,0:05:42.25,0:05:46.42,Default,,0,0,0,,«Гекокуджо!» Күнде ұрыспақ ниетпен баратынмын.
Dialogue: 0,0:05:50.35,0:05:53.43,Default,,0,0,0,,Мен анам сияқты күшті емеспін.
Dialogue: 0,0:05:53.51,0:05:56.14,Default,,0,0,0,,А... аллея жақсы.
Dialogue: 0,0:05:56.23,0:05:59.23,Default,,0,0,0,,Жүрегіңді биік ұстап, күлгенше
Dialogue: 0,0:06:00.31,0:06:03.57,Default,,0,0,0,,Уау! Енді мен мата іздеймін.
Dialogue: 0,0:06:05.07,0:06:07.40,Default,,0,0,0,,Көптеген мата шиыршықтары!
Dialogue: 0,0:06:12.45,0:06:14.04,Default,,0,0,0,,Бұл менің...
Dialogue: 0,0:06:14.12,0:06:15.41,Default,,0,0,0,,Міне (Коджи) Ах...
Dialogue: 0,0:06:15.50,0:06:16.62,Default,,0,0,0,,Тез!
Dialogue: 0,0:06:16.70,0:06:18.41,Default,,0,0,0,,Бұл серж деп аталатын мата.
Dialogue: 0,0:06:18.50,0:06:22.17,Default,,0,0,0,,Теңізшінің жағасы немесе юбка манжеттері
Dialogue: 0,0:06:23.50,0:06:25.92,Default,,0,0,0,,Бұл менің формасым болады
Dialogue: 0,0:06:26.01,0:06:28.17,Default,,0,0,0,,Хехе... Ахаха
Dialogue: 0,0:06:28.26,0:06:32.10,Default,,0,0,0,,Бұл шанақ пен жеңге қолданылатын габардин деп аталатын мата.
Dialogue: 0,0:06:32.60,0:06:36.81,Default,,0,0,0,,Ақ түсте де түсте шамалы айырмашылық бар, маған бұл ұнады деп ойлаймын.
Dialogue: 0,0:06:36.89,0:06:39.56,Default,,0,0,0,,Мен сол жақтағы түсінікті болғанын қалаймын.
Dialogue: 0,0:06:41.52,0:06:43.94,Default,,0,0,0,,Ол жарқыраған және тегіс~
Dialogue: 0,0:06:44.02,0:06:46.44,Default,,0,0,0,,Ана: Маталарды таңдау қызық!
Dialogue: 0,0:06:46.53,0:06:47.65,Default,,0,0,0,,Жай...
Dialogue: 0,0:06:47.74,0:06:50.24,Default,,0,0,0,,Таспаны сәл үлкейту керек пе?
Dialogue: 0,0:06:50.32,0:06:51.07,Default,,0,0,0,,Өте сүйкімді
Dialogue: 0,0:06:51.16,0:06:51.99,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:06:52.07,0:06:53.70,Default,,0,0,0,,Әпке, маған көмектесесіз бе?
Dialogue: 0,0:06:53.78,0:06:55.79,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:06:55.87,0:06:57.79,Default,,0,0,0,,Сызық - матрос костюмінің беті.
Dialogue: 0,0:06:57.87,0:06:59.66,Default,,0,0,0,,Уау, күте тұр, күт!
Dialogue: 0,0:07:00.67,0:07:03.17,Default,,0,0,0,,Әй, анашым, бұл жақсы!
Dialogue: 0,0:07:04.25,0:07:07.17,Default,,0,0,0,,(Аллеяда ызылдау)
Dialogue: 0,0:07:07.26,0:07:08.59,Default,,0,0,0,,Таңертеңнен бері солай.
Dialogue: 0,0:07:08.67,0:07:09.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:09.51,0:07:13.18,Default,,0,0,0,,Көңіл көтеруге болмайды, бірақ Ханаоның сезімін де ескеріңіз.
Dialogue: 0,0:07:13.68,0:07:15.18,Default,,0,0,0,,Жақсы... бұл дұрыс.
Dialogue: 0,0:07:16.43,0:07:19.98,Default,,0,0,0,,Емтихан кезінде мені ұзақ ұстауға мәжбүр еттіңіз. Сақ болыңыз.
Dialogue: 0,0:07:21.69,0:07:22.60,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:07:22.69,0:07:26.15,Default,,0,0,0,,Ханаомен бірге мектепке бара алмай, жалғыздықты сезінбейсіз бе?
Dialogue: 0,0:07:26.23,0:07:27.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:29.19,0:07:30.99,Default,,0,0,0,,(ваннаға малынған дыбыс)
Dialogue: 0,0:07:33.70,0:07:36.20,Default,,0,0,0,,Жалғыз баруды асыға күтетінімді айтпадың ба?
Dialogue: 0,0:07:36.70,0:07:37.95,Default,,0,0,0,,(Сора) Ах, бірақ… (Стефани) О!
Dialogue: 0,0:07:38.04,0:07:39.20,Default,,0,0,0,,Мен айттым...
Dialogue: 0,0:07:39.29,0:07:41.12,Default,,0,0,0,,Хехе… Ой!
Dialogue: 0,0:07:41.87,0:07:44.88,Default,,0,0,0,,Ханао сәл жалғызсырады
Dialogue: 0,0:07:49.13,0:07:51.80,Default,,0,0,0,,Ханао да үшінші курс студенті.
Dialogue: 0,0:07:52.30,0:07:55.14,Default,,0,0,0,,Әпкең қайтадан бірінші курста.
Dialogue: 0,0:07:55.22,0:07:56.89,Default,,0,0,0,,Онда крем қосылған торттарды да жей алмайды ғой, иә?
Dialogue: 0,0:07:57.97,0:08:01.68,Default,,0,0,0,,Негізі мен қаншалықты бақытты болсам, мен де уайымдаймын.
Dialogue: 0,0:08:02.19,0:08:04.60,Default,,0,0,0,,Қызық, мен дұрыс достастай аламын ба?
Dialogue: 0,0:08:05.40,0:08:07.40,Default,,0,0,0,,Қаладан келетін балалар да көп.
Dialogue: 0,0:08:07.48,0:08:11.28,Default,,0,0,0,,Мен осындай жағдайда жақсы жұмыс істей аламын ба деп ойлаймын...
Dialogue: 0,0:08:11.36,0:08:13.36,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:14.32,0:08:14.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:14.91,0:08:17.24,Default,,0,0,0,,Өйткені, әпке, сіз өте кереметсіз!
Dialogue: 0,0:08:17.33,0:08:19.20,Default,,0,0,0,,Ахаха рахмет
Dialogue: 0,0:08:19.29,0:08:22.21,Default,,0,0,0,,Аа, сен қазір мүлде сенбейсің.
Dialogue: 0,0:08:23.00,0:08:24.21,Default,,0,0,0,,Мектепке қабылдау сыйы ретінде маған берілген тау велосипеді
Dialogue: 0,0:08:27.38,0:08:29.38,Default,,0,0,0,,Иә, мен сенемін
Dialogue: 0,0:08:31.01,0:08:33.34,Default,,0,0,0,,Екеуміз де жалғызбыз, ендеше барымызды салайық.
Dialogue: 0,0:08:33.42,0:08:34.22,Default,,0,0,0,,Иә
Dialogue: 0,0:08:34.30,0:08:35.72,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:08:36.59,0:08:37.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:38.39,0:08:39.72,Default,,0,0,0,,Коджи (Кодзи) иә?
Dialogue: 0,0:08:40.64,0:08:41.72,Default,,0,0,0,,Қарсы боласыз ба?
Dialogue: 0,0:08:42.81,0:08:44.23,Default,,0,0,0,,Әлі бітірдіңіз бе?
Dialogue: 0,0:08:44.31,0:08:45.56,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:08:45.65,0:08:50.65,Default,,0,0,0,,Бұл тігу деп аталады және нақты тігіс алдында бөлшектер басқа шүберекпен реттеледі.
Dialogue: 0,0:08:51.36,0:08:53.90,Default,,0,0,0,,Форма тігу қиын...
Dialogue: 0,0:09:03.20,0:09:04.37,Default,,0,0,0,,Қолжазбалар бөлімінің қызметкерлері ғана жеткілікті болар еді, бірақ
Dialogue: 0,0:09:04.87,0:09:06.54,Default,,0,0,0,,Кір жуу аяқталды.
Dialogue: 0,0:09:06.62,0:09:08.88,Default,,0,0,0,,Мен де тазалауды жасаймын!
Dialogue: 0,0:09:10.25,0:09:12.21,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:09:13.05,0:09:14.88,Default,,0,0,0,,Мама, мен кір жуамын.
Dialogue: 0,0:09:15.55,0:09:16.88,Default,,0,0,0,,Мама, енді бітті.
Dialogue: 0,0:09:17.55,0:09:19.30,Default,,0,0,0,,Анашым!
Dialogue: 0,0:09:19.39,0:09:21.81,Default,,0,0,0,,Ахаха ахахха...
Dialogue: 0,0:09:22.52,0:09:24.35,Default,,0,0,0,,Үлкен апа, сіз суды көп ішіп отырсыз!
Dialogue: 0,0:09:24.43,0:09:25.73,Default,,0,0,0,,Сол Косаку Каваджири, иіліп-жығылып, жалтақтайды.
Dialogue: 0,0:09:36.95,0:09:38.11,Default,,0,0,0,,Коджи (Кодзи) Ах...
Dialogue: 0,0:09:38.20,0:09:39.95,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:09:45.75,0:09:46.71,Default,,0,0,0,,Уау...
Dialogue: 0,0:09:50.59,0:09:51.13,Default,,0,0,0,,Фу…
Dialogue: 0,0:09:51.88,0:09:53.67,Default,,0,0,0,,Енді...
Dialogue: 0,0:09:54.21,0:09:55.51,Default,,0,0,0,,Дайын!
Dialogue: 0,0:09:57.51,0:09:58.72,Default,,0,0,0,,Қараңыз, киіңіз.
Dialogue: 0,0:10:02.01,0:10:04.72,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:10:07.69,0:10:09.15,Default,,0,0,0,,Мен төменде күтемін.
Dialogue: 0,0:10:37.92,0:10:38.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:42.89,0:10:44.18,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:49.77,0:10:51.06,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:20.63,0:11:21.72,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:22.55,0:11:24.68,Default,,0,0,0,,Эй, Ханао, бұл жақсы.
Dialogue: 0,0:11:24.76,0:11:26.93,Default,,0,0,0,,Хехе, менің ойымша, ол тым ескірген.
Dialogue: 0,0:11:27.01,0:11:28.47,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:11:29.35,0:11:29.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:30.85,0:11:33.48,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:11:35.27,0:11:37.53,Default,,0,0,0,,Үлкен әпке керемет!
Dialogue: 0,0:11:38.03,0:11:39.94,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:11:41.70,0:11:43.41,Default,,0,0,0,,Кожи Қиын жері жоқ па?
Dialogue: 0,0:11:44.99,0:11:45.83,Default,,0,0,0,,Иә
Dialogue: 0,0:11:49.75,0:11:50.66,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:53.67,0:11:54.96,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:03.84,0:12:06.64,Default,,0,0,0,,Бұл сәл басқаша, бірақ бұл сағыныш.
Dialogue: 0,0:12:06.72,0:12:10.35,Default,,0,0,0,,А... Мен қатты қобалжыдым~
Dialogue: 0,0:12:10.43,0:12:13.19,Default,,0,0,0,,А, мүмкін жаңа студент шығар?
Dialogue: 0,0:12:13.27,0:12:16.02,Default,,0,0,0,,Не?
Dialogue: 0,0:12:17.44,0:12:18.77,Default,,0,0,0,,Блэйзер?
Dialogue: 0,0:12:19.44,0:12:23.36,Default,,0,0,0,,Кожи: Бүгін тағы бір оқиға болды ма?
Dialogue: 0,0:12:23.45,0:12:25.36,Default,,0,0,0,,Эй-эй, эй-эй
Dialogue: 0,0:12:27.12,0:12:30.29,Default,,0,0,0,,Барлығыңызды қабылдауыңызбен құттықтаймыз.
Dialogue: 0,0:12:30.87,0:12:34.29,Default,,0,0,0,,Бүгіннен бастап барлығыңыз Waume академиясының студенті болдыңыздар.
Dialogue: 0,0:12:34.37,0:12:36.29,Default,,0,0,0,,Комичи~!
Dialogue: 0,0:12:36.38,0:12:39.30,Default,,0,0,0,,Анашым!
Dialogue: 0,0:12:41.88,0:12:43.67,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:43.76,0:12:45.30,Default,,0,0,0,,Мен үйдемін (Ханао) Ах...
Dialogue: 0,0:12:45.38,0:12:46.89,Default,,0,0,0,,Қайта оралуыңмен!
Dialogue: 0,0:12:47.39,0:12:49.81,Default,,0,0,0,,Сіздің әпкеңіз қалай болды?
Dialogue: 0,0:12:49.89,0:12:52.06,Default,,0,0,0,,Эй... Кешіріңіз (Ханао) Иә?
Dialogue: 0,0:12:52.64,0:12:54.35,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:54.85,0:12:58.06,Default,,0,0,0,,Дұрыс тексермегенім үшін кешірім сұраймын.
Dialogue: 0,0:12:58.15,0:13:01.28,Default,,0,0,0,,Юва-санның кезінде ол матрос костюмін киген.
Dialogue: 0,0:13:01.36,0:13:02.57,Default,,0,0,0,,Таңқаларлық емес.
Dialogue: 0,0:13:02.65,0:13:06.53,Default,,0,0,0,,Сондай-ақ, Коджи-сан матростардың киіміне таңданады.
Dialogue: 0,0:13:06.61,0:13:09.45,Default,,0,0,0,,Сұхбаттан бері сұрап жүрмін.
Dialogue: 0,0:13:09.53,0:13:13.91,Default,,0,0,0,,Сол кезде айта алмағанымыз өзіміз кінәлі.
Dialogue: 0,0:13:16.08,0:13:18.79,Default,,0,0,0,,Юва-сан мен үшін жасады.
Dialogue: 0,0:13:18.88,0:13:22.96,Default,,0,0,0,,Иә! Матаны бірге таңдайық, сосын...
Dialogue: 0,0:13:23.88,0:13:24.80,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:13:25.51,0:13:28.34,Default,,0,0,0,,Мені де анам жасады.
Dialogue: 0,0:13:28.43,0:13:31.64,Default,,0,0,0,,Бұл мені қуантады... хехе
Dialogue: 0,0:13:32.81,0:13:38.85,Default,,0,0,0,,Жағдайды ескере отырып, мектеп Кожи мырзаға матрос формасын киюге рұқсат береді.
Dialogue: 0,0:13:38.94,0:13:40.31,Default,,0,0,0,,Директор?
Dialogue: 0,0:13:40.40,0:13:44.19,Default,,0,0,0,,Бұл баяғыда, бірақ бұл классикалық форма.
Dialogue: 0,0:13:44.28,0:13:46.11,Default,,0,0,0,,Оған тыйым салуға ешқандай себеп жоқ.
Dialogue: 0,0:13:46.61,0:13:51.95,Default,,0,0,0,,Дегенмен соңғы шешімді отбасы мен Кожи мырзаға қалдырамын.
Dialogue: 0,0:13:54.50,0:13:58.00,Default,,0,0,0,,Жалғыз өзім екеніме сене алар емеспін...
Dialogue: 0,0:14:08.30,0:14:10.89,Default,,0,0,0,,Мерекелік ас дайын.
Dialogue: 0,0:14:12.05,0:14:13.76,Default,,0,0,0,,Екі сары, солай ма?
Dialogue: 0,0:14:14.52,0:14:16.35,Default,,0,0,0,,Ханао, сен оқиғаны естідің бе?
Dialogue: 0,0:14:16.43,0:14:17.27,Default,,0,0,0,,Иә
Dialogue: 0,0:14:17.85,0:14:20.23,Default,,0,0,0,,Блэйзерлер де сүйкімді, солай емес пе?
Dialogue: 0,0:14:21.06,0:14:22.82,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:24.48,0:14:24.98,Default,,0,0,0,,Хмф!
Dialogue: 0,0:14:25.07,0:14:25.99,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:14:26.07,0:14:27.82,Default,,0,0,0,,Не?
Dialogue: 0,0:14:29.53,0:14:32.07,Default,,0,0,0,,Саған анаң тіккен матрос костюмі ұнамай ма?
Dialogue: 0,0:14:32.16,0:14:33.74,Default,,0,0,0,,Менің айтып отырғаным бұл емес!
Dialogue: 0,0:14:33.83,0:14:35.33,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:35.41,0:14:37.25,Default,,0,0,0,,Үлкен апа өте керемет!
Dialogue: 0,0:14:37.33,0:14:39.08,Default,,0,0,0,,Ақымақ апа!
Dialogue: 0,0:14:44.09,0:14:47.67,Default,,0,0,0,,А, бұл дұрыс емес!
Dialogue: 0,0:14:51.18,0:14:53.72,Default,,0,0,0,,Мен оны жек көрмеймін, жақсы көремін
Dialogue: 0,0:14:54.35,0:14:57.02,Default,,0,0,0,,Бірақ мені біртүрлі деп ойлағаныңды қаламаймын.
Dialogue: 0,0:14:57.73,0:15:00.02,Default,,0,0,0,,Өйткені, әпке, сіз өте кереметсіз!
Dialogue: 0,0:15:03.44,0:15:05.02,Default,,0,0,0,,Мен салқын болғым келеді
Dialogue: 0,0:15:05.65,0:15:09.65,Default,,0,0,0,,Мен көп достар тапқым келеді.
Dialogue: 0,0:15:10.61,0:15:14.53,Default,,0,0,0,,Мен матрос костюмін киген жалғыз адаммын, сондықтан көзге түсетініме сенімдімін.
Dialogue: 0,0:15:15.12,0:15:17.20,Default,,0,0,0,,Бұл мүмкіндік емес пе?
Dialogue: 0,0:15:37.14,0:15:40.64,Default,,0,0,0,,Әпке, сіз әлі барасыз ба?
Dialogue: 0,0:15:41.81,0:15:42.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:43.69,0:15:44.31,Default,,0,0,0,,Ах
Dialogue: 0,0:15:51.90,0:15:53.41,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:54.78,0:15:56.95,Default,,0,0,0,,Коджи, жақсысың ба?
Dialogue: 0,0:15:57.95,0:16:00.83,Default,,0,0,0,,«Жүрегіңізді шығарып, күліңіз» солай ма?
Dialogue: 0,0:16:02.62,0:16:03.83,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:16:05.96,0:16:07.25,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:16:19.68,0:16:21.60,Default,,0,0,0,,Йотто!
Dialogue: 0,0:16:21.68,0:16:24.60,Default,,0,0,0,,Ой... Бұл қауіпті болды.
Dialogue: 0,0:16:25.35,0:16:26.31,Default,,0,0,0,,Хаа…
Dialogue: 0,0:16:38.28,0:16:41.00,Default,,0,0,0,,Хмм, мен шынымен түсінбеймін.
Dialogue: 0,0:16:41.08,0:16:44.42,Default,,0,0,0,,Бірақ мен өзімді біршама қатал сезінемін.
Dialogue: 0,0:16:45.92,0:16:49.13,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:16:49.21,0:16:52.26,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:16:53.80,0:16:54.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:55.22,0:16:56.97,Default,,0,0,0,,Шие гүлдері!
Dialogue: 0,0:17:13.65,0:17:16.86,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:17:17.66,0:17:19.91,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:17:20.49,0:17:24.91,Default,,0,0,0,,Мен аздап толқып кеттім... Шамасы, мен қатты толқып кеттім.
Dialogue: 0,0:17:25.54,0:17:26.42,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:28.08,0:17:31.71,Default,,0,0,0,,Үлкен... Қамал сияқты.
Dialogue: 0,0:17:42.14,0:17:43.39,Default,,0,0,0,,Сіз біріншісіз бе?
Dialogue: 0,0:17:45.68,0:17:48.65,Default,,0,0,0,,Мен қатысқан нөмір 1.
Dialogue: 0,0:17:49.27,0:17:50.44,Default,,0,0,0,,3 жиын...
Dialogue: 0,0:17:56.15,0:17:56.65,Default,,0,0,0,,Ах
Dialogue: 0,0:17:58.03,0:17:59.20,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:18:00.49,0:18:01.53,Default,,0,0,0,,(шу)
Dialogue: 0,0:18:01.62,0:18:03.45,Default,,0,0,0,,Адамдар қазірдің өзінде осында!
Dialogue: 0,0:18:03.54,0:18:06.79,Default,,0,0,0,,Адам қорқынышты болса, мен не істеуім керек...
Dialogue: 0,0:18:07.37,0:18:09.29,Default,,0,0,0,,Ой, бұл күлкілі.
Dialogue: 0,0:18:09.37,0:18:11.79,Default,,0,0,0,,Ой, біртүрлі нәрсе...
Dialogue: 0,0:18:12.75,0:18:14.21,Default,,0,0,0,,Тату болайық!
Dialogue: 0,0:18:14.84,0:18:15.76,Default,,0,0,0,,(Камо) Инумаки, оны ұстап тұр; біз шабуыл жасап, ара қашықтықты сақтаймыз.
Dialogue: 0,0:18:16.55,0:18:19.47,Default,,0,0,0,,Мені ұрып-соғып не істейсің?
Dialogue: 0,0:18:22.51,0:18:23.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:26.56,0:18:27.56,Default,,0,0,0,,(тырнақтарды кесу дыбысы)
Dialogue: 0,0:18:40.28,0:18:42.57,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:18:43.70,0:18:44.49,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:18:47.00,0:18:48.00,Default,,0,0,0,,Мм... (Эрика) Эй!
Dialogue: 0,0:18:48.08,0:18:50.00,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:18:50.67,0:18:53.50,Default,,0,0,0,,Қайырлы таң... Қайырлы таң.
Dialogue: 0,0:18:54.00,0:18:55.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:55.09,0:18:55.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:56.00,0:18:57.01,Default,,0,0,0,,(тұру дыбысы)
Dialogue: 0,0:18:57.09,0:18:59.26,Default,,0,0,0,,Оны көрмедім деп елестетіңіз
Dialogue: 0,0:18:59.34,0:19:00.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:02.14,0:19:04.01,Default,,0,0,0,,Сонымен... сіз оны көрдіңіз.
Dialogue: 0,0:19:04.10,0:19:07.27,Default,,0,0,0,,Тырнақ қайшымен аяқтың иісін тексеру
Dialogue: 0,0:19:07.35,0:19:09.39,Default,,0,0,0,,Мен осылай істеп жүрдім
Dialogue: 0,0:19:09.89,0:19:11.77,Default,,0,0,0,,Иә, мен ешкімге айтпаймын.
Dialogue: 0,0:19:12.44,0:19:14.77,Default,,0,0,0,,Бірақ сіздің аяғыңыздың иісі соншама?
Dialogue: 0,0:19:14.86,0:19:16.28,Default,,0,0,0,,Е... ойпаңдар!
Dialogue: 0,0:19:16.36,0:19:18.03,Default,,0,0,0,,Өйткені бұл ұят
Dialogue: 0,0:19:18.11,0:19:20.53,Default,,0,0,0,,Мені де қызықтыруы мүмкін (Эрика) иә?
Dialogue: 0,0:19:20.61,0:19:21.82,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:19:21.91,0:19:22.78,Default,,0,0,0,,Эй!
Dialogue: 0,0:19:23.99,0:19:26.79,Default,,0,0,0,,Мен жүгіргендіктен аздап терлеген шығармын.
Dialogue: 0,0:19:26.87,0:19:29.96,Default,,0,0,0,,Хехехе Бірақ бұл, әрине, тәуелділік хехехе
Dialogue: 0,0:19:30.04,0:19:31.71,Default,,0,0,0,,Хэхехехе...
Dialogue: 0,0:19:31.79,0:19:32.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:32.37,0:19:34.50,Default,,0,0,0,,Сіз қызықсыз.
Dialogue: 0,0:19:35.00,0:19:36.84,Default,,0,0,0,,Өтірік! Мен Ханао жасадым
Dialogue: 0,0:19:36.92,0:19:39.80,Default,,0,0,0,,Әпкем қызық болды деді!
Dialogue: 0,0:19:40.42,0:19:43.80,Default,,0,0,0,,Эй, сен менімен ұзағырақ сөйлесе аласың ба?
Dialogue: 0,0:19:43.89,0:19:45.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:46.76,0:19:47.89,Default,,0,0,0,,Я~
Dialogue: 0,0:19:47.97,0:19:51.73,Default,,0,0,0,,Олай болса, ертең мырза, сіз бұдан былай мектепке матрос костюмін киесіз.
Dialogue: 0,0:19:51.81,0:19:53.15,Default,,0,0,0,,Менде батылдық бар
Dialogue: 0,0:19:53.23,0:19:54.06,Default,,0,0,0,,Эххе
Dialogue: 0,0:19:54.65,0:19:58.11,Default,,0,0,0,,Эрика Кизаки... Токиодан келді.
Dialogue: 0,0:19:58.19,0:19:59.44,Default,,0,0,0,,Сонымен... бұл таңқаларлық.
Dialogue: 0,0:19:59.53,0:20:01.07,Default,,0,0,0,,Сіз жазып отырсыз ба?
Dialogue: 0,0:20:01.15,0:20:03.07,Default,,0,0,0,,Ертең, кешіріңіз.
Dialogue: 0,0:20:03.16,0:20:04.41,Default,,0,0,0,,Эххе
Dialogue: 0,0:20:07.24,0:20:11.66,Default,,0,0,0,,Цу… Тырнақ қайшы өте сүйкімді. Сіз оларды әрқашан өзіңізбен бірге алып жүресіз бе?
Dialogue: 0,0:20:11.75,0:20:13.29,Default,,0,0,0,,Жоқ, бұл бірінші рет.
Dialogue: 0,0:20:13.79,0:20:17.09,Default,,0,0,0,,Бөлмеде отырғанда алаңдаушылық немесе қобалжу болса
Dialogue: 0,0:20:17.17,0:20:19.59,Default,,0,0,0,,Мен тырнақтарымды кесемін.
Dialogue: 0,0:20:19.67,0:20:20.67,Default,,0,0,0,,(тырнақтарды кесу дыбысы)
Dialogue: 0,0:20:21.42,0:20:24.09,Default,,0,0,0,,Мен бұл сықырлаған дыбысты естігенде
Dialogue: 0,0:20:24.18,0:20:26.09,Default,,0,0,0,,Бұл тыныштандыратындай.
Dialogue: 0,0:20:26.18,0:20:27.35,Default,,0,0,0,,(тырнақтарды кесу дыбысы)
Dialogue: 0,0:20:27.43,0:20:28.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:30.22,0:20:32.27,Default,,0,0,0,,Сіз әлі де алаңдайсыз ба?
Dialogue: 0,0:20:32.35,0:20:33.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:35.56,0:20:36.36,Default,,0,0,0,,Иә...
Dialogue: 0,0:20:36.94,0:20:40.36,Default,,0,0,0,,Бүгінгі күн алғашқыларға толы, мен ұйықтай алмаймын.
Dialogue: 0,0:20:40.44,0:20:41.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:41.19,0:20:42.61,Default,,0,0,0,,Қалсам да тұра алмаймын
Dialogue: 0,0:20:42.69,0:20:44.74,Default,,0,0,0,,Мектепке ерте барсам да,
Dialogue: 0,0:20:44.82,0:20:46.66,Default,,0,0,0,,Мен одан сайын қобалжыдым...
Dialogue: 0,0:20:48.95,0:20:50.12,Default,,0,0,0,,Хе хехе...
Dialogue: 0,0:20:50.20,0:20:52.83,Default,,0,0,0,,(Аллеядағы күлкі)
Dialogue: 0,0:20:52.91,0:20:54.12,Default,,0,0,0,,Бұл шынымен де қызықты ма?
Dialogue: 0,0:20:54.21,0:20:56.75,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:20:56.83,0:21:00.75,Default,,0,0,0,,Кизаки-сандай сұлудың өзі де осылай уайымдайды.
Dialogue: 0,0:21:00.84,0:21:02.63,Default,,0,0,0,,А... әрине!
Dialogue: 0,0:21:02.71,0:21:04.63,Default,,0,0,0,,Ал сыртқы түрдің оған еш қатысы жоқ.
Dialogue: 0,0:21:04.72,0:21:06.64,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:21:07.22,0:21:09.35,Default,,0,0,0,,Бірақ мен қорықтым
Dialogue: 0,0:21:09.43,0:21:12.68,Default,,0,0,0,,Осы уақытқа дейін жасымдағы қызбен сөйлескен емеспін.
Dialogue: 0,0:21:13.23,0:21:17.40,Default,,0,0,0,,Егер менің ойым басқалардан өзгеше болса, не істеуім керек?
Dialogue: 0,0:21:17.48,0:21:20.90,Default,,0,0,0,,Сондықтан мен бақыттымын. Мен де солаймын!
Dialogue: 0,0:21:21.73,0:21:22.90,Default,,0,0,0,,Хехе...
Dialogue: 0,0:21:23.99,0:21:26.70,Default,,0,0,0,,А-а, бәрі жақында келеді деп ойлаймын.
Dialogue: 0,0:21:26.78,0:21:29.45,Default,,0,0,0,,Мен кездейсоқ орындыққа отырдым...
Dialogue: 0,0:21:31.33,0:21:32.54,Default,,0,0,0,,№ 1
Dialogue: 0,0:21:33.04,0:21:34.54,Default,,0,0,0,,Бұл орындық.
Dialogue: 0,0:21:35.54,0:21:38.71,Default,,0,0,0,,Сәлемдесу үшін ең жақын жер...
Dialogue: 0,0:21:38.79,0:21:40.04,Default,,0,0,0,,Мен 5-ші нөмірмін
Dialogue: 0,0:21:40.54,0:21:42.42,Default,,0,0,0,,Ах... уфххх
Dialogue: 0,0:21:48.55,0:21:49.72,Default,,0,0,0,,(тырнақтарды кесу дыбысы)
Dialogue: 0,0:21:49.80,0:21:52.72,Default,,0,0,0,,Мен де аздап тынышталғандай болдым.
Dialogue: 0,0:21:55.93,0:21:58.02,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:22:02.82,0:22:04.99,Default,,0,0,0,,Мен де істей аламын ба?
Dialogue: 0,0:22:05.74,0:22:06.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:08.07,0:22:09.24,Default,,0,0,0,,Түрлі оқиғаларға араласып жүріп—
Dialogue: 0,0:22:11.53,0:22:13.54,Default,,0,0,0,,♪~
Dialogue: 0,0:23:38.54,0:23:40.54,Default,,0,0,0,,~♪
