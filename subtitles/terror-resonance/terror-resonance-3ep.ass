Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:07.05,0:02:11.06,Default,,0,0,0,,Сіз сыбайлассыз, бірақ... →
Dialogue: 0,0:02:11.06,0:02:13.06,Default,,0,0,0,,Дос емес. Ах...
Dialogue: 0,0:02:13.06,0:02:15.06,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:02:15.06,0:02:18.06,Default,,0,0,0,,Егер сен дірілдеп қалсаң, мен сені өлтіремін.
Dialogue: 0,0:02:22.07,0:02:24.07,Default,,0,0,0,,Бұл жігіттер→
Dialogue: 0,0:02:24.07,0:02:27.07,Default,,0,0,0,,Ол бұл елді соғысқа шындап шақырғысы келетін сияқты.
Dialogue: 0,0:02:27.07,0:02:30.07,Default,,0,0,0,,Қайтып кел, Шибасаки!
Dialogue: 0,0:02:33.08,0:02:37.08,Default,,0,0,0,,Тез шық.
Dialogue: 0,0:02:37.08,0:02:47.08,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:45.30,0:05:47.30,Default,,0,0,0,,Бұл дегеніміз…
Dialogue: 0,0:05:47.30,0:05:49.31,Default,,0,0,0,,Құжаттама бөліміндегі қария неге бұлай айтты?→
Dialogue: 0,0:05:49.31,0:05:51.31,Default,,0,0,0,,Сіз бастық боласыз ба? ? Бұл біртүрлі болуы керек!
Dialogue: 0,0:05:51.31,0:05:54.31,Default,,0,0,0,,Иә? Сіз білмедіңіз бе?
Dialogue: 0,0:05:54.31,0:05:57.31,Default,,0,0,0,,Шибасаки мырза - бірінші тергеу бөлімінің бұрынғы детективі.
Dialogue: 0,0:05:57.31,0:05:59.32,Default,,0,0,0,,Иә? (Киношита) Дұрыс.
Dialogue: 0,0:05:59.32,0:06:01.32,Default,,0,0,0,,Оны Разор Шибасаки деп атаған.
Dialogue: 0,0:06:01.32,0:06:03.32,Default,,0,0,0,,Бұл жақсы. Мен оған таңданамын. →
Dialogue: 0,0:06:03.32,0:06:05.32,Default,,0,0,0,,Сондай ақсақ атақ.
Dialogue: 0,0:06:05.32,0:06:08.33,Default,,0,0,0,,Бұл өткен күн емес пе?
Dialogue: 0,0:06:08.33,0:06:11.33,Default,,0,0,0,,Енді сізді құжат бөліміне терезеден жіберіп жатырсыз, солай ма?
Dialogue: 0,0:06:11.33,0:06:14.33,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:06:14.33,0:06:17.33,Default,,0,0,0,,Сәлеметсіз бе. (Окано) А, еңбегіңіз үшін рахмет.
Dialogue: 0,0:06:17.33,0:06:19.34,Default,,0,0,0,,Шибасаки мырза! →
Dialogue: 0,0:06:19.34,0:06:22.34,Default,,0,0,0,,Сізге жылжытуға көмектесетін деректердің қажеті жоқ, солай ма?
Dialogue: 0,0:06:22.34,0:06:24.34,Default,,0,0,0,,Менің үстелім қайда?
Dialogue: 0,0:06:24.34,0:06:27.34,Default,,0,0,0,,Міне, міне. Эй.
Dialogue: 0,0:06:27.34,0:06:29.35,Default,,0,0,0,,Маған кейінірек бірдеңе сатып алуыңызды өтінемін.
Dialogue: 0,0:06:29.35,0:06:31.35,Default,,0,0,0,,Рамен немесе басқа нәрсе алғыңыз келе ме?
Dialogue: 0,0:06:31.35,0:06:33.35,Default,,0,0,0,,Сондықтан! →
Dialogue: 0,0:06:33.35,0:06:38.36,Default,,0,0,0,,Көмірсулар семіз адамдар үшін қажет деп ойламаңыз.
Dialogue: 0,0:06:38.36,0:06:40.36,Default,,0,0,0,,Сәлем Хамура.
Dialogue: 0,0:06:47.30,0:06:49.30,Default,,0,0,0,,Сәлем, тоғыз.
Dialogue: 0,0:06:49.30,0:06:51.30,Default,,0,0,0,,Жұмбақ Тым қиын болған жоқ па?
Dialogue: 0,0:06:51.30,0:06:53.30,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:06:53.30,0:06:58.31,Default,,0,0,0,,Бірақ бұл басқа жұмбақ болса және оны ешкім шеше алмаса ше?
Dialogue: 0,0:06:58.31,0:07:02.31,Default,,0,0,0,,Өткен күнгі Роппонги жарылысынан кейін→
Dialogue: 0,0:07:02.31,0:07:07.32,Default,,0,0,0,,NBC лаңкестікке қарсы әрекет ету бөлімінің қарсы құралы шықты, солай ма?
Dialogue: 0,0:07:07.32,0:07:09.32,Default,,0,0,0,,Мүмкін →
Dialogue: 0,0:07:09.32,0:07:13.32,Default,,0,0,0,,Мүмкін біреу бізде бар нәрсені байқаған шығар.
Dialogue: 0,0:07:13.32,0:07:16.32,Default,,0,0,0,,Келесісі түсінікті болады.
Dialogue: 0,0:07:26.34,0:07:31.34,Default,,0,0,0,,[Майк] (Окано) Қылмыскер полицияға осылайша сенімді түрде кіріп кетті→
Dialogue: 0,0:07:31.34,0:07:33.34,Default,,0,0,0,,Бақылау камераларына да алаңдамаңыз→
Dialogue: 0,0:07:33.34,0:07:37.35,Default,,0,0,0,,Мен пластикалық бомбасы бар Окамочидің артына сабырмен қалдым. →
Dialogue: 0,0:07:37.35,0:07:41.35,Default,,0,0,0,,Бұл қазірдің өзінде бізге, полицияға сын болып отыр→
Dialogue: 0,0:07:41.35,0:07:45.29,Default,,0,0,0,,деп болжауға болады.
Dialogue: 0,0:07:45.29,0:07:47.29,Default,,0,0,0,,[Майк] (Шимада) Мен мұны істеп жатқанда →
Dialogue: 0,0:07:47.29,0:07:51.29,Default,,0,0,0,,Бұл олардың келесі бомбаны қоюы мүмкін дегенді білдіре ме?
Dialogue: 0,0:07:56.30,0:07:59.30,Default,,0,0,0,,Аоморидегі ядролық отынды қайта өңдеу зауытынан→
Dialogue: 0,0:07:59.30,0:08:02.31,Default,,0,0,0,,Плутонийді ұрлаған қарақшылардың бірі →
Dialogue: 0,0:08:02.31,0:08:07.31,Default,,0,0,0,,Ол компанияға бірнеше ай бұрын жұмыс істеген мекеме қызметкері болды.
Dialogue: 0,0:08:07.31,0:08:09.31,Default,,0,0,0,,Оның аты - Юдзо Миядзима.
Dialogue: 0,0:08:09.31,0:08:13.32,Default,,0,0,0,,Алайда ол жоқ адам болды.
Dialogue: 0,0:08:13.32,0:08:15.32,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:15.32,0:08:19.32,Default,,0,0,0,,Мемлекеттік дерекқорға Резидентті тіркеу тізілімі желісінен кірген болуы мүмкін→
Dialogue: 0,0:08:19.32,0:08:24.33,Default,,0,0,0,,Ол ойдан шығарылған адамды жасаған деген болжам бар. →
Dialogue: 0,0:08:24.33,0:08:29.33,Default,,0,0,0,,Жергілікті халықты жұмысқа қабылдағанда жергілікті халық тиімдірек.
Dialogue: 0,0:08:29.33,0:08:31.34,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:08:31.34,0:08:34.34,Default,,0,0,0,,Бұл сурет Миядзиманың беті.
Dialogue: 0,0:08:36.34,0:08:38.34,Default,,0,0,0,,Фотосуреттер жоқ па?
Dialogue: 0,0:08:38.34,0:08:41.35,Default,,0,0,0,,Миядзиманың нысан басқаратын бет суреті →
Dialogue: 0,0:08:41.35,0:08:45.28,Default,,0,0,0,,Оны біреу жойған. →
Dialogue: 0,0:08:45.28,0:08:47.28,Default,,0,0,0,,Төтенше жағдай орнатылды→
Dialogue: 0,0:08:47.28,0:08:52.29,Default,,0,0,0,,Миядзима басқа қылмыскермен бірге жоғалып кетті.
Dialogue: 0,0:08:52.29,0:08:55.29,Default,,0,0,0,,Сіз жәй ғана бәйбішеге ұқсайсыз. (Курахаши) Ах.
Dialogue: 0,0:08:57.29,0:08:59.30,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:59.30,0:09:03.30,Default,,0,0,0,,Бала кезімде тұрған қала →
Dialogue: 0,0:09:03.30,0:09:06.30,Default,,0,0,0,,Онда тек қарттар ғана болды.
Dialogue: 0,0:09:06.30,0:09:09.31,Default,,0,0,0,,Хиросима екеніне сенімдімін.
Dialogue: 0,0:09:09.31,0:09:13.61,Default,,0,0,0,,Мен оны жек көрдім. Жаз.
Dialogue: 0,0:09:20.32,0:09:23.32,Default,,0,0,0,,Жазда қалада қорқынышты тыныштық орнайды.
Dialogue: 0,0:09:25.32,0:09:27.32,Default,,0,0,0,,Қарттар мен әйелдер →
Dialogue: 0,0:09:27.32,0:09:29.32,Default,,0,0,0,,Өйткені олар сирек шығады.
Dialogue: 0,0:09:32.33,0:09:36.33,Default,,0,0,0,,Жазда өзін жақсы сезінбейтінін айтады. →
Dialogue: 0,0:09:36.33,0:09:38.33,Default,,0,0,0,,Өйткені мен әжемнің қызы едім.
Dialogue: 0,0:09:40.34,0:09:43.36,Default,,0,0,0,,Әжемді жаз алып кеткендей →
Dialogue: 0,0:09:43.36,0:09:45.28,Default,,0,0,0,,Мен солай сезінемін...
Dialogue: 0,0:09:45.28,0:09:50.28,Default,,0,0,0,,Иә, мен жазды жек көретінмін.
Dialogue: 0,0:09:50.28,0:09:54.28,Default,,0,0,0,,Екінші буын атом бомбасынан аман қалған адам ретінде сіз бұл ақпаратты сол жерден алдыңыз ба? →
Dialogue: 0,0:09:54.28,0:09:58.29,Default,,0,0,0,,Ядролық қаруды ойыншық ретінде қолданатын қылмыскерлерді кешіре алмаймыз.
Dialogue: 0,0:09:58.29,0:10:00.29,Default,,0,0,0,,Жоқ…. →
Dialogue: 0,0:10:00.29,0:10:02.29,Default,,0,0,0,,Бұл нені білдіреді деп ойлаймын. →
Dialogue: 0,0:10:02.29,0:10:07.29,Default,,0,0,0,,Бірақ мені бір нәрсе мазалайды.
Dialogue: 0,0:10:09.30,0:10:35.32,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:46.27,0:10:49.27,Default,,0,0,0,,Кавай-сан, сендей ардагер→
Dialogue: 0,0:10:49.27,0:10:52.28,Default,,0,0,0,,Неліктен кранды басқаруда мұндай қателік жібердіңіз?
Dialogue: 0,0:10:52.28,0:10:56.28,Default,,0,0,0,,Сондықтан мен артық жұмыс істеуден шаршадым.
Dialogue: 0,0:10:56.28,0:10:59.28,Default,,0,0,0,,Біздің компания қара компания.
Dialogue: 0,0:10:59.28,0:11:02.29,Default,,0,0,0,,Детектив, тергеуге қосыла аласыз ба?
Dialogue: 0,0:11:02.29,0:11:05.29,Default,,0,0,0,,Сіз! ≪(есіктің ашылған дыбысы)
Dialogue: 0,0:11:05.29,0:11:08.29,Default,,0,0,0,,Шибасаки мырза. (Шибазаки) Өте өкінішті. Сіз маған орындық бере аласыз ба?
Dialogue: 0,0:11:08.29,0:11:11.29,Default,,0,0,0,,Менің арқам нашар. (Окано) Иә.
Dialogue: 0,0:11:13.30,0:11:16.30,Default,,0,0,0,,Кавай мырза, сіздің хоббиіңіз құмар ойыны ма?
Dialogue: 0,0:11:16.30,0:11:18.30,Default,,0,0,0,,Иә? О, жақсы.
Dialogue: 0,0:11:18.30,0:11:21.31,Default,,0,0,0,,Жылқы? велосипед? Әлде қайық?
Dialogue: 0,0:11:21.31,0:11:23.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:23.31,0:11:25.31,Default,,0,0,0,,Ал, сенің үйіңде→
Dialogue: 0,0:11:25.31,0:11:27.31,Default,,0,0,0,,Сізге қонаққа қорқынышты аға келе жатыр ма?
Dialogue: 0,0:11:27.31,0:11:31.32,Default,,0,0,0,,А, жоқ, соңғы кезде... (Шибазаки) Әрине →
Dialogue: 0,0:11:31.32,0:11:34.32,Default,,0,0,0,,Соңғы кездері мұнда келмейтін сияқты.
Dialogue: 0,0:11:36.32,0:11:38.32,Default,,0,0,0,,≪
Dialogue: 0,0:11:38.32,0:11:40.32,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:40.32,0:11:43.34,Default,,0,0,0,,Өндірісшілер де осында келді ме?
Dialogue: 0,0:11:43.34,0:11:45.26,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:45.26,0:11:47.26,Default,,0,0,0,,Мен оны саған әкелдім.
Dialogue: 0,0:11:49.27,0:11:52.27,Default,,0,0,0,,Сіздің компьютеріңізден ерікті түрде жіберілген→
Dialogue: 0,0:11:52.27,0:11:56.27,Default,,0,0,0,,Мен жылжымайтын дәлелдемелерді қалпына келтірдім.
Dialogue: 0,0:12:00.28,0:12:02.28,Default,,0,0,0,,Кавай мойындады. →
Dialogue: 0,0:12:02.28,0:12:06.28,Default,,0,0,0,,Егер сіз жалған апат жасап, ескі Эдогава электр желісін өшірсеңіз→
Dialogue: 0,0:12:06.28,0:12:09.29,Default,,0,0,0,,Ол 2 миллион иен төлейтіні туралы электрондық хат алғанын айтты.
Dialogue: 0,0:12:09.29,0:12:12.29,Default,,0,0,0,,Шын мәнінде ақша айырбастау болды ма?
Dialogue: 0,0:12:12.29,0:12:16.29,Default,,0,0,0,,Иә. Кавай маған электрондық хат жіберіп, мұны істей алатынын айтты →
Dialogue: 0,0:12:16.29,0:12:20.30,Default,,0,0,0,,Банк шоты туралы ақпаратты айтпасам да, маған 1 миллион иен аударылды.
Dialogue: 0,0:12:20.30,0:12:22.30,Default,,0,0,0,,Банк шотын және аударым уақытын тексеріңіз.
Dialogue: 0,0:12:22.30,0:12:26.30,Default,,0,0,0,,Әрине, ақша жалған есепшоттан аударылған.
Dialogue: 0,0:12:26.30,0:12:31.31,Default,,0,0,0,,Ең үлкен мәселе, егер кінәлі ескі Эдогава электр желісін үзіп тастаса→
Dialogue: 0,0:12:31.31,0:12:33.31,Default,,0,0,0,,Токиода электр қуаты үзілді→
Dialogue: 0,0:12:33.31,0:12:37.31,Default,,0,0,0,,Ол Токио митрополиттік үкіметінің ғимаратына электр қуатының тоқтатылатынын білді. →
Dialogue: 0,0:12:37.31,0:12:41.32,Default,,0,0,0,,Алайда қылмыскер соншалықты жақсы дайындалған→
Dialogue: 0,0:12:41.32,0:12:45.26,Default,,0,0,0,,Неліктен осындай әсерлі электрондық поштаны қалдырдыңыз?
Dialogue: 0,0:12:45.26,0:12:47.26,Default,,0,0,0,,Тіпті бұл Роппонги полиция бекетінің бейнебақылау камерасының бейнелері болса да →
Dialogue: 0,0:12:47.26,0:12:51.26,Default,,0,0,0,,Олар дәлелді әдейі қалдырып кеткендей...
Dialogue: 0,0:12:53.26,0:12:55.26,Default,,0,0,0,,Не болды? (Като) Мен мұндамын! Бұл Spinx!
Dialogue: 0,0:12:57.27,0:13:00.27,Default,,0,0,0,,[ДК] Барлығыңызға, күткеніңізге рахмет.
Dialogue: 0,0:13:00.27,0:13:03.27,Default,,0,0,0,,[ДК] Бұл "Сіз Спинкс жұмбағын шеше аласыз ба?" бұрыш.
Dialogue: 0,0:13:03.27,0:13:05.28,Default,,0,0,0,,[ДК] Бұл Spinx №1.
Dialogue: 0,0:13:05.28,0:13:07.28,Default,,0,0,0,,[Дербес компьютер] No2.
Dialogue: 0,0:13:07.28,0:13:09.28,Default,,0,0,0,,[ДК]-дегі бүгінгі мәселе.
Dialogue: 0,0:13:09.28,0:13:14.28,Default,,0,0,0,,[ДК] Мен жұмбақ шешкен Құдай үйінің жанындағы қандай ғимарат?
Dialogue: 0,0:13:14.28,0:13:18.29,Default,,0,0,0,,[ДК] Егер сіз оны түсінбесеңіз, сіз қайтадан жарылып кетесіз.
Dialogue: 0,0:13:18.29,0:13:21.29,Default,,0,0,0,,[ДК] Уақыт шектеуі ертең сағат 10.00.
Dialogue: 0,0:13:21.29,0:13:24.29,Default,,0,0,0,,[ДК] Кәне, бәріміз! Аяғыңызды таяқша ретінде пайдаланыңыз →
Dialogue: 0,0:13:24.29,0:13:26.29,Default,,0,0,0,,Оны соңына дейін сүйреп апарсаңыз да табыңыз!
Dialogue: 0,0:13:28.30,0:13:31.30,Default,,0,0,0,,Келіңіздер. (Шимада) Иә.
Dialogue: 0,0:13:31.30,0:13:35.31,Default,,0,0,0,,Ағымдағы кескінді қалпына келтіре аламын ба? (Киношита) А, иә.
Dialogue: 0,0:13:35.31,0:13:37.31,Default,,0,0,0,,Міне.
Dialogue: 0,0:13:37.31,0:13:39.31,Default,,0,0,0,,[ДК] Ертең сағат 10.00-де. [ДК] Келіңіздер, бәріңіз!
Dialogue: 0,0:13:39.31,0:13:42.31,Default,,0,0,0,,№2 спинкс қозғалыс жасап жатыр.
Dialogue: 0,0:13:42.31,0:13:45.25,Default,,0,0,0,,Құдайдың үйі қандай да бір ғибадатхана болуы керек.
Dialogue: 0,0:13:45.25,0:13:48.25,Default,,0,0,0,,Жұмбақ шешкен құдай...
Dialogue: 0,0:13:48.25,0:13:50.25,Default,,0,0,0,,Спинкс жұмбағын кім шешті?
Dialogue: 0,0:13:50.25,0:13:52.26,Default,,0,0,0,,Әй, Эдип!
Dialogue: 0,0:13:52.26,0:13:57.26,Default,,0,0,0,,Сіз Эдипті Құдайдың жапондық нұсқасымен салыстыруға тырысасыз ба?
Dialogue: 0,0:13:57.26,0:14:01.26,Default,,0,0,0,,Иә, бұл жақсы идея болуы мүмкін.
Dialogue: 0,0:14:01.26,0:14:04.27,Default,,0,0,0,,«Аяғыңды таяқтың үстіне қою» деген бар ма?
Dialogue: 0,0:14:04.27,0:14:09.27,Default,,0,0,0,,Ах. Эдип есімі «ісінген аяқ» дегенді білдіреді
Dialogue: 0,0:14:09.27,0:14:11.27,Default,,0,0,0,,Аяқ ісінді ме?
Dialogue: 0,0:14:11.27,0:14:14.28,Default,,0,0,0,,Биологиялық әкесі Лайос оны орманға тастап кеткенде→
Dialogue: 0,0:14:14.28,0:14:19.28,Default,,0,0,0,,Айуаннан қашып кетпес үшін өкшесіне қалың шеге қадады.
Dialogue: 0,0:14:19.28,0:14:21.28,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:14:21.28,0:14:23.29,Default,,0,0,0,,Оны қойшы алып кетті→
Dialogue: 0,0:14:23.29,0:14:26.29,Default,,0,0,0,,Коринф деген елдің патшасы қабылдаған. →
Dialogue: 0,0:14:26.29,0:14:30.29,Default,,0,0,0,,Патша оның аяғын көріп, ісінген аяғын Эдип деп атайды.
Dialogue: 0,0:14:30.29,0:14:32.30,Default,,0,0,0,,Мен көргендей.
Dialogue: 0,0:14:32.30,0:14:37.30,Default,,0,0,0,,Бір теория Эдиптің өмір бойы ақсақ болғаны.
Dialogue: 0,0:14:37.30,0:14:40.30,Default,,0,0,0,,Бірақ…. (Киношита) Менің уақытым жоқ. →
Dialogue: 0,0:14:40.30,0:14:43.32,Default,,0,0,0,,Бұл жоспарланған уақытты бірінші рет көрсетуім.
Dialogue: 0,0:14:43.32,0:14:46.24,Default,,0,0,0,,Ең алдымен Токиодағы барлық қасиетті орындарды тексеріңіз.
Dialogue: 0,0:14:46.24,0:14:48.24,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:14:53.25,0:14:55.25,Default,,0,0,0,,Лиза! →
Dialogue: 0,0:14:55.25,0:14:57.25,Default,,0,0,0,,Лиза! Лиза! →
Dialogue: 0,0:14:57.25,0:14:59.26,Default,,0,0,0,,Лиза! Лиза!
Dialogue: 0,0:14:59.26,0:15:22.28,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:19.26,0:17:25.27,Default,,0,0,0,,[TEL] (ойын аудиосы)
Dialogue: 0,0:17:25.27,0:17:28.27,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:17:28.27,0:17:32.28,Default,,0,0,0,,Шибасаки мырза, мен жатып ойнағым келеді.
Dialogue: 0,0:17:32.28,0:17:36.28,Default,,0,0,0,,Мұндағы диван заттар туралы ойлауға ыңғайлы.
Dialogue: 0,0:17:36.28,0:17:38.28,Default,,0,0,0,,Е.
Dialogue: 0,0:17:38.28,0:17:41.28,Default,,0,0,0,,Ойын ойнап жатқан сен болсаң, үйге барып ойнау керек.
Dialogue: 0,0:17:41.28,0:17:44.29,Default,,0,0,0,,Менің ойымша, ол Шибасаки мырзамен кездесіп жүр. →
Dialogue: 0,0:17:44.29,0:17:47.29,Default,,0,0,0,,Мен сені жалғызбын деп ойладым. (Шибазаки) Рахмет.
Dialogue: 0,0:17:47.29,0:17:51.29,Default,,0,0,0,,Спинкс те жалғыз емес пе?
Dialogue: 0,0:17:51.29,0:17:53.30,Default,,0,0,0,,Саған бәрібір емес пе?
Dialogue: 0,0:17:53.30,0:17:55.30,Default,,0,0,0,,Сіз баласыз, солай ма?
Dialogue: 0,0:17:55.30,0:17:58.30,Default,,0,0,0,,Жалғыз болғандықтан, барлық жерде жарылып кетсем →
Dialogue: 0,0:17:58.30,0:18:00.30,Default,,0,0,0,,Бұл мен жинаған нәрсе емес.
Dialogue: 0,0:18:00.30,0:18:03.31,Default,,0,0,0,,[TEL] (Ойын аудиосы) (Муккаса) Ах! Қарғыс атсын.
Dialogue: 0,0:18:03.31,0:18:05.31,Default,,0,0,0,,[TEL] (ойын аудиосы)
Dialogue: 0,0:18:05.31,0:18:07.31,Default,,0,0,0,,Бұл онлайн ойын ма?
Dialogue: 0,0:18:07.31,0:18:10.31,Default,,0,0,0,,Иә. Құбыжықтарды жеңу үшін бірге жұмыс істейік. →
Dialogue: 0,0:18:10.31,0:18:14.25,Default,,0,0,0,,Бұл өте қызықты. (Шибазаки) Хмм...
Dialogue: 0,0:18:14.25,0:18:18.25,Default,,0,0,0,,Қазіргі жастар өз қабығына жабыла ма деп ойлаймын→
Dialogue: 0,0:18:18.25,0:18:21.26,Default,,0,0,0,,Сіз әрқашан адамдармен байланыс іздейсіз.
Dialogue: 0,0:18:21.26,0:18:25.26,Default,,0,0,0,,Жоқ, жоқ. Жастарға шағым айта бастадым →
Dialogue: 0,0:18:25.26,0:18:27.26,Default,,0,0,0,,Бұл қарттың дәлелі.
Dialogue: 0,0:18:27.26,0:18:29.27,Default,,0,0,0,,[TEL] (Ойын аудиосы) (Муккаса) Уа! Мен оны істедім. →
Dialogue: 0,0:18:29.27,0:18:31.27,Default,,0,0,0,,Жасыл айдаһар жеңілді! →
Dialogue: 0,0:18:31.27,0:18:34.27,Default,,0,0,0,,Бұл жігіттің деңгейі өте жоғары!
Dialogue: 0,0:18:34.27,0:18:37.27,Default,,0,0,0,,Эй, айдаһар...
Dialogue: 0,0:18:37.27,0:18:42.28,Default,,0,0,0,,Нағыз Эдиптің анасының арғы атасы...
Dialogue: 0,0:18:42.28,0:18:45.28,Default,,0,0,0,,Түсіндім! Дұрыс, Рокукаса! (Рокукаса) Иә?
Dialogue: 0,0:18:59.30,0:19:07.30,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:07.30,0:19:18.30,Default,,0,0,0,,《Сейрек шапалақ》
Dialogue: 0,0:19:25.26,0:19:27.26,Default,,0,0,0,,Ах.
Dialogue: 0,0:19:27.26,0:19:29.26,Default,,0,0,0,,≪Анасы кім? Ах.
Dialogue: 0,0:19:29.26,0:19:32.26,Default,,0,0,0,,Лиза? Бұл Лиза! ?
Dialogue: 0,0:19:42.27,0:19:45.27,Default,,0,0,0,,Шибасаки мырза, есі дұрыс па! ? (Шибазаки) Иә.
Dialogue: 0,0:19:48.28,0:19:51.28,Default,,0,0,0,,Сіз қылмыскерді арандатуға тырысасыз ба?
Dialogue: 0,0:19:51.28,0:19:54.28,Default,,0,0,0,,Бірдеңе болып қалса, жауапкершілікті өз мойныма аламын.
Dialogue: 0,0:19:54.28,0:19:56.29,Default,,0,0,0,,Шибасаки….
Dialogue: 0,0:19:56.29,0:19:59.29,Default,,0,0,0,,Мен сіздің орныңызда не істей аламын? ?
Dialogue: 0,0:19:59.29,0:20:03.29,Default,,0,0,0,,Ақаулық орын алса, жоғарыдағы адам жауапты болады...
Dialogue: 0,0:20:03.29,0:20:05.30,Default,,0,0,0,,Енді, Курахаши мырза. →
Dialogue: 0,0:20:05.30,0:20:07.53,Default,,0,0,0,,Бірдеңе болса, жауапкершілікті өз мойныңызға алыңыз.
Dialogue: 0,0:20:07.53,0:20:09.53,Default,,0,0,0,,Э…?—
Dialogue: 0,0:20:21.48,0:20:34.26,Default,,0,0,0,,♪♪~
Dialogue: 0,0:20:34.26,0:20:38.26,Default,,0,0,0,,《Есім – шын мәнінде махаббат сыйы》→
Dialogue: 0,0:20:38.26,0:20:42.27,Default,,0,0,0,,《Бірақ тастап кеткен есімдеріңде махаббат жоқ》→
Dialogue: 0,0:20:42.27,0:20:48.27,Default,,0,0,0,,《Мұндай жалған белгілерді алып тастау керек》
Dialogue: 0,0:20:48.27,0:20:53.28,Default,,0,0,0,,《Бұдан былай мен саған жаңа есім беремін》
Dialogue: 0,0:20:53.28,0:21:03.29,Default,,0,0,0,,(Шыңырау)
Dialogue: 0,0:21:03.29,0:21:05.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:05.29,0:21:12.31,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:21:12.31,0:21:17.23,Default,,0,0,0,,Амансың ба? Құлағыңызда тағы шырылдады ма?
Dialogue: 0,0:21:17.23,0:21:21.24,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:21:21.24,0:21:24.24,Default,,0,0,0,,Өйткені өтірік жоқ.
Dialogue: 0,0:21:24.24,0:21:27.24,Default,,0,0,0,,Сонда бұл жерде де өтірік жоқ.
Dialogue: 0,0:21:27.24,0:21:29.25,Default,,0,0,0,,Сіз Лиза Мишимамен кездестіңіз, солай ма?
Dialogue: 0,0:21:29.25,0:21:31.25,Default,,0,0,0,,Хехе. Сіз білдіңіз бе?
Dialogue: 0,0:21:31.25,0:21:35.25,Default,,0,0,0,,Мен білемін. Мен тереңдетпеймін.
Dialogue: 0,0:21:35.25,0:21:37.25,Default,,0,0,0,,Егер тереңге барсаңыз...
Dialogue: 0,0:21:37.25,0:21:39.25,Default,,0,0,0,,Бұл кейінірек ауырады.
Dialogue: 0,0:21:46.26,0:21:49.27,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:21:49.27,0:21:52.27,Default,,0,0,0,,[ДК] (Шибазаки) Сіз мені естисіз бе? Спинкс No1 және No2.
Dialogue: 0,0:21:52.27,0:21:54.27,Default,,0,0,0,,[PC] Бұл елордалық полиция департаментінен Шибасаки.
Dialogue: 0,0:21:54.27,0:21:56.27,Default,,0,0,0,,Әй, не?
Dialogue: 0,0:21:56.27,0:21:59.27,Default,,0,0,0,,[ДК] Жұмбақтарыңызға жауап берейін.
Dialogue: 0,0:22:01.28,0:22:06.28,Default,,0,0,0,,«Жұмбақты шешкен құдайдың резиденциясының жанындағы қандай ғимарат?»
Dialogue: 0,0:22:06.28,0:22:09.29,Default,,0,0,0,,Спинкс жұмбағын шешкен Эдип болды.
Dialogue: 0,0:22:09.29,0:22:11.29,Default,,0,0,0,,[Дербес компьютер] (Шибазаки) Құдайдың баласы болмаса да→
Dialogue: 0,0:22:11.29,0:22:13.22,Default,,0,0,0,,Менің анам мен әйелім Жокастаның ата-бабалары... (Еркек) Иә?
Dialogue: 0,0:22:13.22,0:22:15.23,Default,,0,0,0,,[ДК] (Шибазаки) Айдаһардың инкарнациясы. →
Dialogue: 0,0:22:15.23,0:22:20.23,Default,,0,0,0,,Бір теория: Эдип өмір бойы ақсақ болған.
Dialogue: 0,0:22:22.23,0:22:25.24,Default,,0,0,0,,Бұл ақсақ айдаһар Арахабаки.
Dialogue: 0,0:22:25.24,0:22:27.24,Default,,0,0,0,,Ой!
Dialogue: 0,0:22:27.24,0:22:31.24,Default,,0,0,0,,Арахабаки – Канто және Тохоку аймақтарында тараған жұмбақ құдай.
Dialogue: 0,0:22:31.24,0:22:36.25,Default,,0,0,0,,Соғыс құдайы, темір жасау құдайы, аяқ құдайы деп те аталады. →
Dialogue: 0,0:22:36.25,0:22:41.25,Default,,0,0,0,,Бір кезде құдай деген орнымнан айырылып, жан-жақтан тентіреп кеттім→
Dialogue: 0,0:22:41.25,0:22:44.25,Default,,0,0,0,,Шаршап, ақсау.
Dialogue: 0,0:22:47.26,0:22:49.26,Default,,0,0,0,,[Теледидар] Төтенше хабар келді.
Dialogue: 0,0:22:49.26,0:22:51.26,Default,,0,0,0,,[ТД] Дәл қазір елордалық полиция департаменті → бейне сайтын пайдалануда
Dialogue: 0,0:22:51.26,0:22:54.26,Default,,0,0,0,,Бомбардировкашы туралы жұмбақтың жауабы.
Dialogue: 0,0:22:57.27,0:23:00.27,Default,,0,0,0,,[Телевизия] (Шибазаки) Ал Арахабакидің «Хабаки» бұл →
Dialogue: 0,0:23:00.27,0:23:05.28,Default,,0,0,0,,Сөздің шығу тегі «айдаһар ағашы» және ол айдаһар құдайымен тығыз байланысты. →
Dialogue: 0,0:23:05.28,0:23:08.28,Default,,0,0,0,,Арахабаки храмы Мияги префектурасындағы Тагажомен әйгілі→
Dialogue: 0,0:23:08.28,0:23:12.30,Default,,0,0,0,,Токиода құлшылық ететін орындар...
Dialogue: 0,0:23:12.30,0:23:14.30,Default,,0,0,0,,Міне.
Dialogue: 0,0:23:16.22,0:23:19.22,Default,,0,0,0,,Кацушика ауданындағы Ширахиге храмы.
Dialogue: 0,0:23:22.23,0:23:25.23,Default,,0,0,0,,Оның жанындағы ғимарат.
Dialogue: 0,0:23:25.23,0:23:40.24,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:40.24,0:23:43.25,Default,,0,0,0,,[TEL] (Като) Бомбаны залалсыздандыру енді аяқталды.
Dialogue: 0,0:23:43.25,0:23:45.25,Default,,0,0,0,,Сәттілік.
Dialogue: 0,0:23:51.25,0:23:54.26,Default,,0,0,0,,[ДК] Бұл жұмбақтың жауабы.
Dialogue: 0,0:23:54.26,0:23:56.26,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:24:03.27,0:24:06.27,Default,,0,0,0,,[ТД] Бомба аман-есен табылған сияқты.
Dialogue: 0,0:24:11.27,0:24:15.21,Default,,0,0,0,,[ДК] (Шибазаки) Бұл қалай? Жауапты болжау қандай сезімде?
Dialogue: 0,0:24:15.21,0:24:18.21,Default,,0,0,0,,Бәрібір ауырмайды, қышымайды, солай ма? →
Dialogue: 0,0:24:18.21,0:24:21.22,Default,,0,0,0,,Ойын ба, қалжың ба, білмеймін →
Dialogue: 0,0:24:21.22,0:24:24.22,Default,,0,0,0,,Браттармен де ойнаңыз.
Dialogue: 0,0:24:24.22,0:24:27.22,Default,,0,0,0,,[ДК] Балалар сендер мазақ етіп отырған әзілкеш →
Dialogue: 0,0:24:27.22,0:24:29.23,Default,,0,0,0,,Бұл ойыншық емес. →
Dialogue: 0,0:24:29.23,0:24:31.23,Default,,0,0,0,,Соны пайдаланатын болсаңыз... (Курахаши) Тез кесіңіз.
Dialogue: 0,0:24:31.23,0:24:34.23,Default,,0,0,0,,А, иә. [ДК] (Шибазаки) Мен сендерді ешқашан кешірмеймін!
Dialogue: 0,0:24:39.24,0:24:42.24,Default,,0,0,0,,Шибасаки мырза! Жаман.
Dialogue: 0,0:24:42.24,0:24:45.24,Default,,0,0,0,,Бұл ашуды тудыратын сөздерді айту тәсілі.
Dialogue: 0,0:24:45.24,0:24:50.25,Default,,0,0,0,,Мен директор Курахашиден осыны жалғастыруды өтіндім.
Dialogue: 0,0:24:50.25,0:24:52.25,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,0:24:52.25,0:24:55.25,Default,,0,0,0,,Көрдіңіз бе? әрине.
Dialogue: 0,0:24:55.25,0:25:00.26,Default,,0,0,0,,Радиациядан қорғайтын костюмдер бомбадан қорғайтын костюмдермен араласқан.
Dialogue: 0,0:25:00.26,0:25:02.26,Default,,0,0,0,,Қысқасы...
Dialogue: 0,0:25:02.26,0:25:04.26,Default,,0,0,0,,Әрине, полиция...
Dialogue: 0,0:25:04.26,0:25:09.26,Default,,0,0,0,,Ол бізді плутоний ұрлығымен байланыстырды.
Dialogue: 0,0:25:11.27,0:25:13.20,Default,,0,0,0,,[Теледидар] (диктор) Кацушика округіндегі Ширахиге храмының жанындағы ғимараттан →
Dialogue: 0,0:25:13.20,0:25:15.20,Default,,0,0,0,,Бомба жойылды. →
Dialogue: 0,0:25:15.20,0:25:19.21,Default,,0,0,0,,Елордалық полиция департаменті бейне сайтта қылмыскер сұраған жұмбаққа жауап береді→
Dialogue: 0,0:25:19.21,0:25:21.44,Default,,0,0,0,,Бомба аман-есен табылды...
Dialogue: 0,0:25:21.44,0:25:24.21,Default,,0,0,0,,А, у... Директор Курахаши.
Dialogue: 0,0:25:24.21,0:25:27.22,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:25:27.22,0:25:30.22,Default,,0,0,0,,Шибасаки мырза кім?
Dialogue: 0,0:25:30.22,0:25:33.22,Default,,0,0,0,,Мен сізді бірінші дивизияның эйсі болғаныңызды естідім... →
Dialogue: 0,0:25:33.22,0:25:35.22,Default,,0,0,0,,Не болды?
Dialogue: 0,0:25:35.22,0:25:37.23,Default,,0,0,0,,Иә. →
Dialogue: 0,0:25:37.23,0:25:42.23,Default,,0,0,0,,15 жыл бұрын жазда билеуші партияның парламенттік хатшысы қонақүй бөлмесінен құлап қайтыс болды.
Dialogue: 0,0:25:42.23,0:25:44.23,Default,,0,0,0,,Хатшы?
Dialogue: 0,0:25:48.24,0:25:51.24,Default,,0,0,0,,Жоғарыда суицид немесе жазатайым оқиға екені анықталды→
Dialogue: 0,0:25:51.24,0:25:54.24,Default,,0,0,0,,Шибасаки бұған сенбеді. →
Dialogue: 0,0:25:54.24,0:25:58.25,Default,,0,0,0,,Қандай да бір қастандыққа қатысы болуы мүмкін деп мәлімдеу→
Dialogue: 0,0:25:58.25,0:26:01.25,Default,,0,0,0,,Тіпті қайтыс болған парламент хатшысының фракция жетекшісі→
Dialogue: 0,0:26:01.25,0:26:03.25,Default,,0,0,0,,Кеңейтілген тергеу.
Dialogue: 0,0:26:03.25,0:26:07.26,Default,,0,0,0,,А... бұл жақсы емес.
Dialogue: 0,0:26:07.26,0:26:10.26,Default,,0,0,0,,Көшбасшы Ұлттық полиция агенттігінен болды.
Dialogue: 0,0:26:10.26,0:26:13.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:13.20,0:26:15.20,Default,,0,0,0,,Сондықтан Шибасаки мырза құжат бөлімінде...
Dialogue: 0,0:26:15.20,0:26:20.20,Default,,0,0,0,,Шибасакидің отбасы болды. Өмір болды. →
Dialogue: 0,0:26:20.20,0:26:24.21,Default,,0,0,0,,Жоғарыдан келген шешімді қабылдаудан басқа амалымыз қалмады. →
Dialogue: 0,0:26:24.21,0:26:26.21,Default,,0,0,0,,Бірақ…. →
Dialogue: 0,0:26:26.21,0:26:31.21,Default,,0,0,0,,Ол ұмытқан жоқ. Мен бас тартқан жоқпын. →
Dialogue: 0,0:26:31.21,0:26:33.21,Default,,0,0,0,,Сол жаз.
Dialogue: 0,0:26:37.22,0:26:39.22,Default,,0,0,0,,Бүгін тағы да ыстық.
Dialogue: 0,0:26:46.23,0:26:56.23,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:57.73,0:27:02.73,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
